# Pristine extraction -- regenerable from archives/ via scripts/extract.sh,
# not worth doubling storage in git.
libs/*/raw/

# Runtime logs (debug.log etc) -- recreated by the driver on every boot.
libs/*/log/
libs/*/work/log/
libs/*/work/**/log

# Runtime save/game-state churned by every boot+play cycle during QA testing
# (leaderboards, NPC boss respawn state, user-id counters, registration
# queues) -- not meaningful "shipped content", just noise from running the
# driver. Extend this list if a new lib's testing dirties a similar path.
libs/*/work/data/topten/
libs/*/work/topten/
libs/*/work/data/npc/boss/
libs/*/work/data/rzr/
libs/*/work/adm/daemons/iduser
libs/*/work/adm/daemons/users
libs/*/work/adm/daemons/UserNumber
libs/*/work/adm/daemons/record_times
libs/*/work/queue/
libs/*/work/www/mudlist.html
libs/*/work/data/mud/MUDVISITOR
libs/*/work/data/named.o
libs/*/work/data/storyd.o
libs/*/work/data/skillsd.o
libs/*/work/data/date
libs/*/work/data/player
libs/*/work/adm/etc/players
libs/*/work/adm/etc/reg_players
libs/*/work/adm/etc/visitor.cnt
# NOTE: banned_name was here but removed -- it's NOT universally
# runtime-generated. In at least yueyingqiyuan it's real static shipped
# content (a pre-populated Chinese-name blocklist, never written to at
# runtime), and the untrack sweep deleted it, breaking every Chinese-name
# registration attempt. Check content/raw/ before assuming this file is
# safe to ignore for any given lib.
libs/*/work/data/toptend.o
libs/*/work/data/lst_rich
libs/*/work/data/lst_riddle
libs/*/work/data/lst_top
libs/*/work/user_count
libs/*/work/d/dongtian/dongtian.o
libs/*/work/data/daemon/nosave.o
libs/*/work/data/npc/d/menpai/**/*.o
libs/*.h.t

# Scratch / driver build directories (not part of this repo).

# Per-run lpcc sweep output (regenerate via scripts/lpcc_check.sh)
libs/*/lpcc_fail.log
libs/*/lpcc_batch_raw.log
libs/*/work/trace_lpcc.json
