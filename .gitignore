# Original archive files -- kept locally for provenance/re-extraction,
# never published (copyrighted third-party content; the GitHub history
# was filtered to exclude them). scripts/lib_numbering.json records the
# number<->slug<->archive-filename mapping.
archives/

# Pristine extraction -- regenerable from archives/ via scripts/extract.sh,
# not worth doubling storage in git.
libs/*/raw/

# Lib similarity/lineage analysis data -- regenerable via
# scripts/lib_fingerprint.py + lib_fingerprint_core.py +
# lib_similarity_cluster.py. lib_fingerprints.json in particular is
# huge (full content-hash sets per lib, tens of MB) and goes stale the
# moment any lib is re-converted, so it's not worth committing.
scripts/lib_fingerprints.json
scripts/lib_core_fingerprints.json
scripts/lib_similarity_report.json
scripts/lib_content_fingerprints.json

# Runtime logs (debug.log etc) -- recreated by the driver on every boot.
libs/*/log/
libs/*/work/log/
libs/*/work/**/log
libs/*/boot.log
libs/*/driver.pid
libs/*/convert.log

# Runtime save/game-state churned by every boot+play cycle during QA testing
# (leaderboards, NPC boss respawn state, user-id counters, registration
# queues) -- not meaningful "shipped content", just noise from running the
# driver. Extend this list if a new lib's testing dirties a similar path.
libs/*/work/data/topten/
libs/*/work/topten/
libs/*/work/data/npc/boss/
libs/*/work/data/rzr/
libs/*/work/adm/daemons/iduser
libs/*/work/adm/daemons/users
libs/*/work/adm/daemons/UserNumber
libs/*/work/adm/daemons/record_times
libs/*/work/queue/
libs/*/work/www/mudlist.html
libs/*/work/data/mud/MUDVISITOR
libs/*/work/data/named.o
libs/*/work/data/storyd.o
libs/*/work/data/skillsd.o
libs/*/work/data/date
libs/*/work/data/player
libs/*/work/adm/etc/players
libs/*/work/adm/etc/reg_players
libs/*/work/adm/etc/visitor.cnt
# NOTE: banned_name was here but removed -- it's NOT universally
# runtime-generated. In at least yueyingqiyuan it's real static shipped
# content (a pre-populated Chinese-name blocklist, never written to at
# runtime), and the untrack sweep deleted it, breaking every Chinese-name
# registration attempt. Check content/raw/ before assuming this file is
# safe to ignore for any given lib.
libs/*/work/data/toptend.o
libs/*/work/data/lst_rich
libs/*/work/data/lst_riddle
libs/*/work/data/lst_top
libs/*/work/user_count
libs/*/work/d/dongtian/dongtian.o
libs/*/work/data/daemon/nosave.o
libs/*/work/data/npc/d/menpai/**/*.o
libs/*.h.t

# Scratch / driver build directories (not part of this repo).

# Per-run lpcc sweep output (regenerate via scripts/lpcc_check.sh)
libs/*/lpcc_fail.log
libs/*/lpcc_batch_raw.log
libs/*/work/trace_lpcc.json
scripts/__pycache__/

# Lib-specific runtime save/game-state noise found during the WASM
# boot-log sweep -- deliberately lib-scoped, not a libs/*/ glob (see the
# banned_name counterexample above: a repo-wide pattern for one lib's
# runtime state has broken another lib's real shipped content before).
# nitan170911's bbased.o/dbased.o are large (~165MB/~23MB) economy/data
# saves regenerated by the driver at boot; excluded for repo size rather
# than committed, even though similar-looking raw/ content exists.
libs/nitan170911/work/data/bbased.o
libs/nitan170911/work/data/dbased.o
libs/nitan6/work/data/bunchd.o
libs/nitan6/work/data/leagued.o
libs/nitan6/work/temp/
libs/nitan_ceshi/work/data/bunchd.o
libs/nitan_ceshi/work/data/business/
libs/nitan_ceshi/work/data/dbased.o
libs/nitan_ceshi/work/data/familyd.o
libs/nitan_ceshi/work/data/newsd.o
libs/nitan_ceshi/work/data/shop/
