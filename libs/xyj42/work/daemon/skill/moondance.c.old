//【冷月凝香舞】 moondance.c
// cglaem...12/07/96.

inherit SKILL;

string *dodge_msg = ({
	"但是$n一摆腰肢，从$N身边轻轻飘过。\n",
            "只见$n一个转身，忽然回眸一笑。$N一楞之下，哪里还有人在。\n",
            "$n长袖飞起，轻轻一带，$N这一招顿时失了准头。\n",
            "可是$n噗嗤一笑，不退反进，身形径向$N飘来。\n$N只觉一股甜香入鼻，这一招竟无着力之处。\n",
            "$n身法轻灵，腰肢几拧，居然幻出斑驳月影。$N眼一花，哪里分得出是人，是影。\n",
            "只见$n身形后仰，一只纤足飞出，几乎到了$N鼻孔底下。$N急退不迭。\n",
            "可是不知怎的和$n错身而过。忽觉脑后温香袭人，$N不由一晕，\n突然想起命在旦夕，只得就地一滚，急窜而出。\n",
});

int valid_enable(string usage) { return (usage=="dodge"); }

int valid_learn(object me)
{
	if( (string)me->query("gender") != "女性" )
		return notify_fail("冷月凝香舞只有女性才能练。\n");
	if( (int)me->query("spi") < 10 )
		return notify_fail("你的灵性不够，没有办法练冷月凝香舞。\n");

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("sen") < 30 )
		return notify_fail("你的精神太差了，不能练冷月凝香舞。\n");
	me->receive_damage("sen", 30);
	return 1;
}
