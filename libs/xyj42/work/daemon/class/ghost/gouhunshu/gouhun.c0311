//
inherit SSERVER;

int cast(object me, object target)
{
        if( !target ) target = offensive_target(me);
	
	if(!me->is_fighting() )
		return notify_fail("你要勾自己的魂吗？\n");

        if( (int)me->query("mana") < 400 )
                return notify_fail("你的法力不够了！\n");

        if( (int)me->query("sen") < 300 )
                return notify_fail("你的精神无法集中！\n");

        message_vision("$N口中念道：阎王叫你三更死，不敢留你到五更．\n", me);

	if(me->is_fighting() ) {
		if(random((int)me->query("max_mana")) >
(int)target->query("max_mana")/2) {

message_vision("$N对$n阴笑道：去吧，去吧．．．\n", me, target);
me->receive_damage("sen", 200);
target->apply_condition("mihun_poison", 10);
	}
	else
message_vision("$n神情专注，连$N理都不理．\n", me, target);
me->receive_damage("sen", 150);
	}
        me->start_busy(3);
        return 1;
}

