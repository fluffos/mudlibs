// thunder.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        string msg;
        int ap, dp, con;     
        int gin, kee, sen;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展天魔锤？\n");

	if((int)me->query_skill("tianmo", 1)<150)
	   return notify_fail("你现在还不会施展天魔锤。\n");

	 if(!me->is_fighting())
	 return notify_fail("只有在战争中才能用天魔锤。\n");
        
	if((int)me->query("mana") < 800 )
                return notify_fail("你的法力不够！\n");

        if((int)me->query("sen") < 50 )
                return notify_fail("你无法集中精力！\n");

        me->add("mana", -800);
        me->receive_damage("sen", 30);

	message_vision(HIW "$N口中念咒，突然空中飞来一把金锤，向$n当头砸去！\n" NOR, me, target);	
	
        ap = me->query_skill("spells");
        ap = ap+me->query_kar();
        dp = target->query_skill("spells");
         con=target->query_con();
	gin=target->query("gin");
	kee=target->query("kee");
	sen=target->query("sen");
        if( random(ap) > random(dp) ) 
{               
	message_vision( HIB "结果「锵」地一声，砸中$N，$N顿时翻地晕倒！\n" NOR, target, target);

		target->unconcious();
		target->set("gin", gin);
		target->set("kee", kee);
		target->set("sen", sen);
                       call_out("revive", random(55-con), target);
                        me->improve_skill("tianmo", 1, 1);
                }
    else {

                        message_vision(CYN "但$N口念咒语，右手一指，定住了空中的金锤。\n" NOR, target);
		me->start_busy(5);
		
	    }
       


        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else
target->kill_ob(me);
                }
                me->kill_ob(target);
        }
        return 1;
}


void revive(object target)
{
	target->revive();
}








