// thunder.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        string msg;
        int ap, dp, con;     
        int am, vm;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me) 
                return notify_fail("你要对谁施展天魔咒？\n");

	if((int)me->query_skill("tianmo", 1)<100)
	   return notify_fail("你现在还不会施展天魔咒。\n");

	if (!interactive(target))
	   return notify_fail("天魔咒只能用在其他玩家上。\n");
	        
	if((int)me->query("mana") < (int)me->query("max_mana")/2 ||
	(int)me->query("mana")<100)
                return notify_fail("你的法力不够！\n");

        if((int)me->query("sen") < 100 )
                return notify_fail("你无法集中精力！\n");

        me->add("mana", -100);
        me->receive_damage("sen", 100);

	message_vision(RED "$N口中念咒，口中吐出一道红光向$n的首级扑去！\n" NOR, me, target);	
	
        ap = me->query_skill("spells");
        ap = ap+me->query_kar();
        dp = target->query_skill("spells");
         con=target->query_con();
	am=me->query("max_mana");
	vm=target->query("max_mana");
        if( random(ap) > random(dp) &&
	am<vm*2) 
{               
	message_vision(RED  "$N顿时被红光照住，随着脑后升起一股神气，
缓缓地向$n口中飘去！\n" NOR, target, me);

		target->set("max_mana", vm/10*9);
		me->set("max_mana", am+vm/12);
   
		target->start_busy(random(20-con/4));
		me->start_busy(random(15));
                }
    else {

                        message_vision(CYN "但$N一闪身，躲过了射来的红光。\n" NOR, target);
		
	    }
       


        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else
target->kill_ob(me);
                }
                me->kill_ob(target);
        }
        return 1;
}





