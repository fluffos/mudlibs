// thunder.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        string msg;
        int ap, dp;     
  

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展天魔解？\n");

	if((int)me->query_skill("tianmo", 1)<50)
	   return notify_fail("你现在还不会施展天魔解。\n");

	 if(!me->is_fighting())
	 return notify_fail("只有在战争中才能用天魔解。\n");
        
	if((int)me->query("mana") < 500 ||
	(int)me->query("mana")<(int)me->query("max_mana")*3/4)
                return notify_fail("你的法力不够！\n");

        if((int)me->query("sen") < 50 )
                return notify_fail("你无法集中精力！\n");

        me->add("mana", -500);
        me->receive_damage("sen", 30);

	message_vision(HIW "$N头发披散，口中念咒，向空中指了三指，形像十分可怕！\n" NOR, me);	
	
        ap = me->query_skill("spells");
        ap = ap+me->query_kar();
        dp = target->query_skill("spells");
         
        if( random(ap) >4* random(dp/4) ) 
{               
	message_vision( HIB "陡然，天边飞来一片火云，把$N和$n紧紧裹在中央\n" NOR, me, target);
		  me->add("combat_exp", -(int)me->query("combat_exp") / 40);
               me->set("potential", (int)me->query("learned_points"));
	 me->skill_death_penalty();
               me->die();
	   me->save();
	    target->add("combat_exp", -(int)me->query("combat_exp") / 40);
               target->set("potential", (int)me->query("learned_points"));
	 target->skill_death_penalty();
               target->die();
	   target->save();
	     CHANNEL_D->do_channel(this_object(), "rumor",
	  sprintf("%s和%s同归于尽了！  \n",target->name(1), me->name(1)));   	
	 return 1;
                }
    else {
	message_vision(RED "陡然，天边飞来一片火云，把$N紧紧裹在中央\n" NOR, me);
		  me->add("combat_exp", -(int)me->query("combat_exp") / 40);
               me->set("potential", (int)me->query("learned_points"));
	 me->skill_death_penalty();
               me->die();
	   me->save();
	     CHANNEL_D->do_channel(this_object(), "rumor",
		  sprintf("%s引火自焚了！  \n", me->name(1)));   
		return 1;
	  
                    	    }
       
}

      





