#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{

	me->apply_condition("no_pk_time", duration - 1);
//	write("PK:"+duration+":"+me->query_condition("no_pk_time")+"\n");

	if( duration < 1 ) return 0;

	return CND_CONTINUE;
}
