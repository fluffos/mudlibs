// moon_poison.c

#include <ansi.h>

int update_condition(object me, int duration)
{
	me->receive_wound("sen", 10*duration);
	me->receive_damage("sen", 10*duration);
	me->receive_damage("kee", 10*duration);
	me->receive_wound("kee", 10*duration);
	me->set_temp("death_msg","精力耗尽而死。\n");
	me->apply_condition("moon_poison", duration * 2 );
	tell_object(me, HIG "你感觉身体一点点虚弱下去！\n" NOR );
	if( duration < 1 ) return 0;
	return 1;
}
