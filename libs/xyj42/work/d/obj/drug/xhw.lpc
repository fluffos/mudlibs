// meirong.c 美容丹

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIW "消化丸" NOR, ({"xiaohua wan", "wan"}));
        set_weight(20);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "粒");
                set("long", "一粒白白的丹药，据说帮助消化之用。\n");
                set("value", 100);
        }
        setup();
}

int do_eat(string arg)
{
        object victim = this_player();

        if (!id(arg))
                return notify_fail("你要吃什么？\n");
        message_vision(HIY "\n$N吃下一粒消化丸，突然肚子咕噜一阵响，不好，要上厕所！\n\n" NOR, victim);
	victim->set_temp("xhw_eated",1);
        destruct(this_object());
        return 1;
}

