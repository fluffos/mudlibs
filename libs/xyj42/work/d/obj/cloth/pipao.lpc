#include <armor.h>
inherit CLOTH;

void create() {
  set_name("皮袍", ({ "pi pao", "pao" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件暖暖和和的皮袍。\n");
    set("unit", "件");
    set("value", 4000);
    set("material", "leather");
    set("armor_prop/armor", 2);
    set("armor_prop/dodge", 0);
  }
  setup();
}
