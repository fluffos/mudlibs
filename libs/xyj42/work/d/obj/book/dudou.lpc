// literate.c

inherit F_UNIQUE;
inherit ITEM;

void create() {
  int order;
  string *skill = ({ "unarmed", "spells", "force", "dodge", "parry" });
  int *sk = ({ 90, 80, 70, 60, 50 });

  set_name("破烂肚兜", ({ "dudou", "xueshu" }));
  set_weight(500);
  order = random(5);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "paper");
    set("value", 0);
    set("long", "一件血迹斑斑的婴儿肚兜，仔细看隐约能看见一些血字。");
    set("skill", ([
      "name": skill[order],
      "exp_required": 20000,
      "sen_cost": 25,
      "difficulty": 30,
      "max_skill": sk[order],
    ]));
  }
}
