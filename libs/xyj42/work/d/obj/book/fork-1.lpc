// fork-1.c Sjmao  03/12/98

inherit ITEM;

void create()
{
        set_name("〖叉法简介〗", ({"book","fork book","shu"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
	set("long",
    "一本关于叉法的小册子。上面画着些水族生物，手里都拿着各样的叉子。\n");
        set("material", "paper");
        set("value", 1000);
        set("skill", ([
                        "name": "fork",
                        "exp_required": 1000,
                        "sen_cost": 30,
                        "difficulty": 30,
                        "max_skill": 60,
]) );
        }
}

