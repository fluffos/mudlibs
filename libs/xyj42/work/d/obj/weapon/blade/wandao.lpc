// blade.c

#include <weapon.h>

inherit BLADE;

void create() {
  int n;
  string *cname = ({ "长弯刀", "短弯刀", "月牙弯刀" });
  string *ename = ({ "chang ", "duan ", "yueya " });
  n = random(3);
  set_name((cname[n]), ({ ename[n] + "wan dao", ename[n] + "blade" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一把弯弯的战刀．\n");
    set("unit", "把");
    set("value", 1400);
    set("material", "metal");
  }
  init_blade(25);
  setup();
}
