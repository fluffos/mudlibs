#include <ansi.h>

inherit ITEM;

void create()
{
	string *pname = ({"圆", "方", "大","小","白漆", "青漆", "紫漆", "黑" });
	string *mname = ({"木", "镶玉", "仙", "兽脚" });
	string *lname = ({"桌", "案" });
	string name;
	
	name = sprintf("%s%s%s",pname[random(8)],mname[random(4)],lname[random(2)]);
        set_name( name, ({ "table" }));
        set_weight(50000);
	set("long", "这是一张桌子。\n" );
	set("no_sell", "这样东西不能随便买卖");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("material", "wood");
		set("value", 2000);
//		set("amount",30);
        }
        setup();
}

