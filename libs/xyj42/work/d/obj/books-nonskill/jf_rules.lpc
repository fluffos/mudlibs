
#include "book.h";
inherit ITEM;
inherit BOOK;

int do_read(string arg);
void create()
{
        set_name("金风细雨楼章程", ({"jf_rules",}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "卷");
                set("long", "一个古老发黄的羊皮卷，上面写满了字，用read来读。\n");
                set("material", "paper");
                set("value", 0);   
        }
}

void init()
{
    add_action("do_read","read");
}

int do_read(string arg)
{
    if (!this_object()->id(arg))
      return notify_fail("你要读什么？\n");
    read_book(this_player(), this_object()->query("id"));
    return 1;
}
