inherit NPC;
#include <ansi.h>
int time_period(int timep, object me);
string chinese_daoxing(int gain);
string sysmsg;
void create()
{
    set_name(HIY "魏征" NOR, ({ "wei zheng", "wei","zheng","wz" }) );
	set("gender", "男性");
	set("age", 60);
	set("long",
		"魏征辅佐唐太宗打下江山，功劳赫赫，现任宰相一职，经常接见外国使节。\n");
	set("attitude", "peaceful");
        set("skill_public",1);
	set("str", 26000);
	set("per", 30);

	set("cor", 30);
	set("int", 24);
	set("cps", 30);
	set("title","当朝宰相");

	set("force", 40000);
	set("max_force", 80000);

	set("mana", 400);
	set("max_mana", 400);
	set("force_factor", 1000);
	set("combat_exp", 1000000);
	set("score", 200000);
	
	//here, make the wei zheng become a super man, can destroy something
	//add by andy lau, 14-01-98
	set("is_god",1);
	
	set("inquiry", ([
		"name"  : "我就是当朝宰相——魏征！",
		"here"  : "这里就是吾皇接见各国使节的国宾馆了。",
		"quest" : "直接quest就行了！",
		"任务"  : "直接quest就行了！",
	]) );
	
	set_skill("unarmed", 200);
	set_skill("force", 150);
	set_skill("ghost-steps", 150);
	set_skill("jinghun-zhang", 30);
	setup();
}

int accept_fight(object me)
{
        command("say 何方妖邪，敢在大唐国界撒野？！");
        return 0;
}

void init()
{
        add_action("give_quest", "quest");
}


int give_quest(string arg)
{
	mapping quest ;
	object me;
	int fft=2, j, combatexp, timep, r_kar;
	string tag = "40000000";
	string *levels = ({
                        "0",
                        "4000",
                        "8000",
                        "16000",
                        "32000",
                        "64000",
                        "128000",
                        "256000",
                        "512000",
                        "1024000",
                        "1536000",
                        "2304000",
                        "3456000",
                        "5184000",
                        "7776000",
                        "11664000",
                        "17496000",
                        "26244000",
			"40000000"
        });
        if( !arg ) fft=2;
        if( arg == "-h") fft=4;
        if( arg == "-hh" ) fft =8;
        if( arg == "-hhh" ) fft = 16;
        if( arg == "-hhhh" ) fft = 32;
        if( arg == "-x" ) fft = 500;
        if( arg == "-xx" ) fft = 1000; 
        if( arg == "-xxx" ) fft = 2000;
        if( arg == "-l" ) fft = 1;
	me = this_player();

// Let's see if this player is a ghost
	if((int) me->is_ghost())
	{
		write("等你转世投胎以后再来报效国家吧。\n");
		return 1;
	}

// let's see if this player 道行是不是>100年,土土加，嘻嘻
/*        if( ((int) me->query("combat_exp")) < 2000 )
        { 
                message_vision("魏征拍拍$N的头，说道：
没学会游水就想撑船？先练练基本功夫吧！\n",me);
                return 1;
        }
*/
        if( ((int) me->query("combat_exp")) > 256000 )
        { 
                message_vision("魏征对$N一拱手，说道：
这位" + RANK_D->query_respect(me) + " ，咱这么点鸡毛蒜皮的事何需您操心呢？\n",me);
                return 1;
        }

// Let's see if this player still carries an un-expired task
        if((quest =  me->query("quest")))
	{
	if( ((int) me->query("task_time")) >  time() )
		return 0;
	else
	{
		message_vision("魏征拿起象牙板“嘣”地一声敲在$N的头上，“真没用！
不过看在你还回来见老夫的份上，就再给你一次机会。\n", me);
		me->set("kee", me->query("kee")/2+1);
	}
	}
	combatexp = (int) me->query("combat_exp");
// palyer say quest too hard!
	combatexp = combatexp * 2 / 3 ;
// player can get harder or easier quests;
	combatexp = combatexp * fft / 2;
	r_kar = random((int) me->query("kar"));
        for(j= sizeof(levels) - 1 ; j>=0; j--)
        {
                if( atoi(levels[j])  <= combatexp )
                        {
                                tag = levels[j];
				if ( r_kar > 28 && j > 0) tag = levels[j-1];
/*
                if ( r_kar < 3 && j < (sizeof(levels) -1)) tag = levels[j+1];
*/
                                break;
                        }
        }

	quest = QUEST_D(tag)->query_quest();
	timep = quest["time"];	
// A factor here to make time random
	timep = timep / (random(2)+1);
	time_period(timep, me);
	if (quest["quest_type"] == "寻")
	{
        tell_object(me,"找回『"+quest["quest"]+"』给吾皇。\n" NOR);
	sysmsg +="找回『"+quest["quest"]+"』。";
	}
	        if (quest["quest_type"] == "杀")
        {
        tell_object(me,"替朝廷杀了『"+quest["quest"]+"』。\n" NOR);
	sysmsg +="杀了『"+quest["quest"]+"』。";
        }
 	me->set("quest", quest);
	me->set("task_time", (int) time()+(int) timep);
//	CHANNEL_D->do_channel(this_object(), "qst", sprintf("%s(%s)：%s", 
//	me->query("name"),me->query("id"),sysmsg));

return 1;
}

int time_period(int timep, object me)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        if(d) time = chinese_number(d) + "天";
        else time = "";

        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";

        tell_object(me,HIW "魏征沉思了一会儿，说道：\n请在" + time + "内");
	sysmsg = "在" + time + "内";
        return 1;
}
int accept_object(object who, object ob)
{
        int bonus, exp, pot, score, val;
	string test;
	mapping quest;
	val = ob->value();
	if (val)
	{
            if( val < 200000+10000*random(10)) {
			tell_object(who,"魏征在你耳边悄悄说道：这么少就想买通朝廷命官？\n");
          call_out("destroy_object",1,ob);
}
		else
		{
			if ((quest = who->query("quest"))) {
				who->set("quest", 0 );
		       	 	tell_object(who,"魏征说道：好吧，这个任务就算了吧．．下不为例哦！\n");
          call_out("destroy_object",1,ob);
		       	} 
		       	else 
				tell_object(who,"魏征用力拍着你说：哈哈，难得你有心为朝廷出力，老夫一定保举你！\n");	
          call_out("destroy_object",1,ob);
		}
		return 1;
	}
        if(!(quest =  who->query("quest")))
	{
        tell_object(who,"魏征说道：这是什么？我不要。\n");
	return 0;
	}
        if( ob->name() != quest["quest"])
        {
        tell_object(who,"魏征说道：这是什么？我不要。\n");
        return 0;
        }
	if( ob->is_character())
        {
        tell_object(who,"魏征说道：这不是我想要的。\n");
        return 0;
        }
        if ((int) who->query("task_time") < time() )
        {
        tell_object(who,"魏征摇了摇头叹道：等你等到我心痛啊！可惜了。\n");
          call_out("destroy_object",1,ob);
                        return 1;
        }
        else
        {
          call_out("destroy_object",1,ob);
//        tell_object(who,"魏征说道：恭喜你！你又完成了一项任务！\n");
        tell_object(who,"魏征拍着你的头说道：好..好..今儿个真高兴！\n");
	exp = quest["exp_bonus"]/2 + random(quest["exp_bonus"]/2)+1;
	pot = quest["pot_bonus"]/4 + random(quest["pot_bonus"]/4)+1;
//	due to weekly quest, each quet worth 20
//	score = quest["score"]/2 + random(quest["score"]/2);
	score = 20;
        bonus = (int) who->query("combat_exp");
        bonus += exp;
        who->set("combat_exp", bonus);
	bonus = (int) who->query("potential");
	bonus = bonus - (int) who->query("learned_points");
        bonus = bonus + pot;
//	if( bonus > 100) bonus = 100;
	bonus += (int) who->query("learned_points");
        who->set("potential", bonus );
	bonus = (int) who->query("score");
	bonus += score;
        who->set("score", bonus);
        tell_object(who,HIW"你被奖励了：\n" +
	chinese_daoxing(exp) + "道行\n"+
	chinese_number(pot) + "点潜能\n" +
	chinese_number(score)+"点名望\n"NOR);
	who->set("quest", 0 );
                        return 1;
        }
                return 1;
}

string chinese_daoxing(int gain)
{            int year,day,hour;
             string str;

             year=gain/1000;
             day=(gain-year*1000)/4;
             hour=(gain-year*1000-day*4)*3;
             str="";
             if(year) str=str+chinese_number(year)+"年";
             if(day) str=str+chinese_number(day)+"天";
             if(hour) str=str+chinese_number(hour)+"时辰";

             return str;
}
