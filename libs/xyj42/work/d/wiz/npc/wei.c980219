int accept_fight(object me, object ob)
{
	ob = this_player();
        message_vision("一阵狂风吹起，只见$N被风卷起飞了出去！\n", ob);
        ob->move("/d/4world/center");
        return 0;
}

int accept_kill(object me, object ob)
{
     ob = this_player();
         message_vision("石像左手抓住$N的脖子，右手一掌打在$P的胸口，$N象稻草一样飞了出去！\n", ob);
         ob->move("/d/city/xuanwu-n3");
         return 0;
}

void init()
{
//        add_action("give_quest", "quest");
        add_action("give_quest", "mobai");
        add_action("do_bian", "bian");
        add_action("tell_quest", "help");
        add_action("do_steal", "steal");
        add_action("reply_ask", "ask");
}

int tell_quest(object who)
{
	who = this_player();
	tell_object(who,HIB "一个时远时近的声音在你附近响起：……诚……心……\n" NOR);
	return 1;
}

int give_quest(object me)
{
	mapping quest ;
	int fft=2, j, combatexp, timep, r_kar;
	string tag = "40000000";
	string *levels = ({
                        "0",
                        "4000",
                        "8000",
                        "16000",
                        "32000",
                        "64000",
                        "128000",
                        "256000",
                        "512000",
                        "1024000",
                        "1536000",
                        "2304000",
                        "3456000",
                        "5184000",
                        "7776000",
                        "11664000",
                        "17496000",
                        "26244000",
			"40000000"
        });

	me = this_player();

// Let's see if this player is a ghost
	if((int) me->is_ghost())
	{
//		write("等你转世投胎以后再来报效国家吧。\n");
		tell_object(me,"你先去转世投胎吧。\n" NOR);
		message_vision("一阵阴风吹起，只见$N被风裹住不见了。\n", me);
		me->move("/d/death/gate");
		return 1;
	}

// set extra_bonus
	if ( ((int) me->query("extra_bonus")) == 0 )
	{
	me->set("extra_bonus", 1);
	}
// default extra_bonus is 1. xman

// 做任务的限制暂时改成1024年 xman 98-1-31 9:17下午
        if( ((int) me->query("combat_exp")) > 2303999 )
        { 
		tell_object(me,"石像好象对着你摇了摇头。\n" NOR);
		return 1;
        }

// Let's see if this player still carries an un-expired task
        if((quest =  me->query("quest")))
	{
	if( ((int) me->query("task_time")) >  time() )
	        {
	        tell_object(me,"石像对你不理不睬。\n" NOR);
		return 1;
		}
	else
	{
// 超过时间没能完成任务，降气血
		message_vision("只见一阵黑色的烟雾笼罩住$N，好久才散。\n", me);
		tell_object(me,"你感到肚内一阵绞痛，浑身无力。\n" NOR);
		me->set("kee", me->query("kee")/2+1);
// If last quest never done
                me->set("extra_bonus",1);
// clear extra_bonus.  xman
	}
	}
	combatexp = (int) me->query("combat_exp");
	r_kar = random((int) me->query("kar"));
        for(j= sizeof(levels) - 1 ; j>=0; j--)
        {
                if( atoi(levels[j])  <= combatexp )
                        {
                                tag = levels[j];
				if ( r_kar > 28 && j > 0) tag = levels[j-1];
/*
                if ( r_kar < 3 && j < (sizeof(levels) -1)) tag = levels[j+1];
*/
                                break;
                        }
        }

	quest = QUEST_D(tag)->query_quest();
	timep = quest["time"];	
// A factor here to make time random
	timep = timep / (random(2)+1);
	time_period(timep, me);
	if (quest["quest_type"] == "寻")
	{
        tell_object(me,"找回『"+quest["quest"]+"』给我。\n" NOR);
	sysmsg +="找回『"+quest["quest"]+"』。";
	}
	        if (quest["quest_type"] == "杀")
        {
        tell_object(me,"杀了『"+quest["quest"]+"』。\n" NOR);
	sysmsg +="杀了『"+quest["quest"]+"』。";
        }
 	me->set("quest", quest);
	me->set("task_time", (int) time()+(int) timep);
//	CHANNEL_D->do_channel(this_object(), "qst", sprintf("%s(%s)：%s", 
//	me->query("name"),me->query("id"),sysmsg));
	return 1;
}

int time_period(int timep, object me)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        if(d) time = chinese_number(d) + "天";
        else time = "";

        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";
	tell_object(me,HIB "石像似乎睁开了眼睛！一团烟雾把你罩住……\n朦胧中出现了魏徵的鬼魂……\n" NOR);
        tell_object(me,HIB "塑像的象牙板上出现了一些字，你凝神细看，发现上面写着：\n" NOR);
        tell_object(me,HIW "请在" + time + "内");
	sysmsg = "在" + time + "内";
        return 1;
}

int accept_object(object who, object ob)
{
        int bonus, exp, pot, score, val, xbonus;
	string test;
	mapping quest;
	val = ob->value();
	if (val)
	{
		if( val < 30000+1000*random(10)) {
			call_out("destroy_object",1,ob);
			tell_object(who,"一个人在你耳边呻吟：…不…够…\n");
			}
		else
		{
		if ((quest = who->query("quest"))){
			who->set("quest", 0 );
			// when player cancel quest
			who->set("extra_bonus",1);
			// clear extra_bonus. xman
	       	 	tell_object(who,HIY "鬼魂拍着你的肩膀哈哈大笑：好！你有前途！\n" NOR);
			call_out("destroy_object",1,ob);
			return 1;
			}
		else 
			tell_object(who,"石像似乎睁开了眼睛！但很快又闭上了。\n");    
			call_out("destroy_object",1,ob);
		}
		return 1;
	}
        if(!(quest =  who->query("quest")))
	{
        tell_object(who,"石像没有反应。\n");
	return 0;
	}
        if( ob->name() != quest["quest"])
        {
        tell_object(who,"石像似乎左右摇晃了几下，眼睛只张开一条缝。\n");
        return 0;
        }
	if( ob->is_character())
        {
        tell_object(who,"石像向后缩了回去，你手里的东西挣扎着想逃。\n");
        return 0;
        }
        if ((int) who->query("task_time") < time() )
        {
        tell_object(who,"象牙板上留着一张字条：天亮了，我必须走了。\n");
        // If quest timeout
        who->set("extra_bonus",1);
        // clear extra_bonus. xman 98-2-1 11:06上午
        call_out("destroy_object",1,ob);
        return 1;
        }
        else
        {
//        tell_object(who,"魏徵说道：恭喜你！你又完成了一项任务！\n");
        tell_object(who,"魏徵的鬼魂拍着你的头说道：好..好..大唐有希望了！\n");
// increase extra_bonus to count 累计任务数
        who->add("extra_bonus", 1);
        xbonus = (int) who->query("extra_bonus");
// add extra_bonus. xman 98-2-1 11:09上午
	exp = quest["exp_bonus"]/4 + random(quest["exp_bonus"]/4)+1;
	pot = quest["pot_bonus"]/3 + random(quest["pot_bonus"]/3)+1;
// increase exp bonus and potential bonus
        exp = exp + (int)(exp * (xbonus/10));
        pot = pot + (int)(pot * (xbonus/10));
// by xman 98-2-1 11:22上午

//	due to weekly quest, each quet worth 20
//	score = quest["score"]/2 + random(quest["score"]/2);
	score = 20;
        bonus = (int) who->query("combat_exp");
        bonus += exp;
        who->set("combat_exp", bonus);
	bonus = (int) who->query("potential");
	bonus = bonus - (int) who->query("learned_points");
        bonus = bonus + pot;
	bonus += (int) who->query("learned_points");
        who->set("potential", bonus );
	bonus = (int) who->query("score");
	bonus += score;
        who->set("score", bonus);
        tell_object(who,HIW"你得到了：\n" +
	chinese_daoxing(exp) + "道行\n"+
	chinese_number(pot) + "点潜能\n" +
	chinese_number(score)+"点名望\n"NOR);
	who->set("quest", 0 );
	call_out("destroy_object",1,ob);
	return 1;
        }
                return 1;
}

string chinese_daoxing(int gain)
{            int year,day,hour;
             string str;

             year=gain/1000;
             day=(gain-year*1000)/4;
             hour=(gain-year*1000-day*4)*3;
             str="";
             if(year) str=str+chinese_number(year)+"年";
             if(day) str=str+chinese_number(day)+"天";
             if(hour) str=str+chinese_number(hour)+"时辰";

             return str;
}

int do_bian(string arg)
{
	object who = this_player();
	object me = this_object();
	message_vision (HIB "只见石像守护天神飞起一脚对着$n踢过去！\n$n疼得蹲下去捂着屁股直哼哼。\n" NOR,me,who);
	return 1;
}

int do_steal(string arg)
{
	object who = this_player();
	object me = this_object();
	message_vision (HIB "石像守护天神一巴掌打在$n的脸上，\n$n的整副牙齿也随之飞到了天上。\n" NOR,me,who);
	return 1;
}

int reply_ask(string arg)
{
	object who = this_player();
//	object me = this_object();
	message_vision(GRN "这位$R连这都不知道？\n" NOR, who);
	return 1;
}