// Room: /d/wiz/wizroom.c

inherit ROOM;

int block_cmd();

void create() {
  set("short", "死牢");
  set("long", @LONG

这里是黑带的私牢，除了头顶有个小孔(hole)之外，
这里什么也没有，什么都看不见。
LONG);
  set("item_desc", ([ /* sizeof() == 1 */
    "hole": "想出去，没门，只有洞。\n",
  ]));

  set("exits", ([ /* sizeof() == 1 */
    "up": __DIR__ "wizroom",
  ]));

  set("valid_startroom", 1);
  setup();
}

void init() {
  if (!wizardp(this_player()))
    add_action("block_cmd", "", 1);
}

int block_cmd() {
  object who = this_player();
  object where = this_object();
  string verb = query_verb();

  tell_object(who, "欢迎您进入黑暗世界！\n");
  who->set("startroom", "/d/wiz/jail");
  if (verb == "say") return 0;  //allow say
  if (verb == "look") return 0;
  if (verb == "save") return 0;
  return 1;
}
