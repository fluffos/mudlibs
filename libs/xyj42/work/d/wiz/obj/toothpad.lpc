// robe.c
//

#include <armor.h>
#include <ansi.h>

inherit HANDS;

void create() {
  set_name(HIW "象牙板" NOR, ({ "toothpad", "pad" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("material", "hands");
    set("armor_prop/armor", 1);
  }
  setup();
}
