// hongbao.c
//

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIR "黑带的红包" NOR, ({ "hongbao" }));
  set_weight(3000000);
  set("long", "一个沉甸甸的红包，上面写着一个金色的“寿”字。\n");
  set("max_items", 10);
  set_max_encumbrance(5000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("material", "cloth");
  }
  setup();
}
