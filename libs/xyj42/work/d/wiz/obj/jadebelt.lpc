// jadebelt.c
//

#include <armor.h>
#include <ansi.h>

inherit WAIST;

void create()
{
	set_name(HIW "玉带" NOR, ({ "jadebelt","belt","jade" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("material", "waist");
		set("armor_prop/armor", 1);
	}
	setup();
}
