}

void reset_me (object me)
{
  int i;
  object *inv;
  mapping skill_status, map_status;
  string *skillnames, *mapnames;
    
  reset_eval_cost();
  if ( mapp(map_status = query_skill_map()) )
  {
	mapnames = keys(map_status);
	for(i=0; i<sizeof(mapnames); i++)  {
	   map_skill( mapnames[i] ); 
	}
  }

  if ( mapp(skill_status = query_skills()) )
  {
    skillnames = keys(skill_status);
	for(i=0; i<sizeof(skillnames); ++i)  {
      delete_skill(skillnames[i]);
	}
  }

  inv = all_inventory(me);
  for(i=0; i<sizeof(inv); ++i)
    destruct (inv[i]);

  reset_action();

  set_name(get_honor_str(), ({ "tian shen", "shen", "tian" }) );
  set("title", get_respect_str());
  set("gender", "男性" );
  set("long",get_respect_str()+"。\n");
  set("short",query("name")+"("+capitalize(query("id"))+")");
  set("attitude", "heroism");
  set("current_player","none of us");

  set("str", 30);
  set("per", 30);
  set("int", 30);
  set("age", 100);

  set("weapon", 0);
  set("armor", 0);

  set_skill("force",  100); 
  set_skill("spells", 100); 
  set_skill("unarmed",100);
  set_skill("sword",  100);
  set_skill("dodge",  100);
  set_skill("parry",  100);

  set("max_gin", 1000);
  set("eff_gin", 1000);
  set("gin", 1000);
  set("max_kee", 1000);
  set("eff_kee", 1000);
  set("kee", 1000);
  set("max_sen", 1000);
  set("eff_sen", 1000);
  set("sen", 1000);
  set("force", 2000);
  set("max_force", 1000);
  set("mana", 1000);
  set("max_mana", 1000);
  set("force_factor", 50);

  //set("no_clean_up",1);
  set("no_unconcious",1);
  set("combat_exp", 200000);

  setup();
  reset_eval_cost();

}

int save_record(object me, object ob)
{
  object *inv;
  mapping hp_status, skill_status, map_status;
  string *skillnames, *mapnames;
  int i, weapon_cnt, armor_cnt;

  reset_eval_cost();
  hp_status = ob->query_entire_dbase();

  set("str", hp_status["str"]);
  set("per", hp_status["per"]);
  set("int", hp_status["int"]);
  set("age", hp_status["age"]);

  set("max_gin",     hp_status["max_gin"]);
  set("eff_gin",     hp_status["eff_gin"]);
  set("gin",         hp_status["gin"]);
  set("max_kee",     hp_status["max_kee"]);
  set("eff_kee",     hp_status["eff_kee"]);
  set("kee",         hp_status["kee"]);
  set("max_sen",     hp_status["max_sen"]);
  set("eff_sen",     hp_status["eff_sen"]);
  set("sen",         hp_status["sen"]);
  set("max_force",   hp_status["max_force"]);
  set("max_mana",    hp_status["max_mana"]);
  //set("force_factor",hp_status["force_factor"]);
  set("gender",      hp_status["gender"]);
  set("combat_exp",  hp_status["combat_exp"]);

  set("eff_gin", query("max_gin"));
  set("gin",     query("max_gin"));
  set("eff_kee", query("max_kee"));
  set("kee",     query("max_kee"));
  set("eff_sen", query("max_sen"));
  set("sen",     query("max_sen"));

  set("force",   query("max_force")*2);
  set("mana",    query("max_mana")*2);

  skill_status = query_skills();
  if ( mapp(skill_status) )
  {
    skillnames  = keys(skill_status);

    for(i=0; i<sizeof(skillnames); i++) {
      delete_skill(skillnames[i]);
    }
  }

  skill_status = ob->query_skills();
  if ( mapp(skill_status) )
  {
    skillnames  = keys(skill_status);

    for(i=0; i<sizeof(skillnames); i++) {
       set_skill(skillnames[i], skill_status[skillnames[i]]);
    }
  }
  
  // increase npc's enforce by 50%, as players have more options, e.g.
  // powerup, etc.
  set("force_factor",query_skill("force")*3/4);

  reset_eval_cost();
  if (! query("new_player"))
  {
    save();
    reset_eval_cost();
    return 1;
  }

  set("new_player",0);

  if ( mapp(map_status = query_skill_map()) ) {
    mapnames = keys(map_status);

    for(i=0; i<sizeof(mapnames); i++) {
      map_skill(mapnames[i]);
    }
  }

  map_status = ob->query_skill_map();
  if ( mapp(map_status) ) 
  {
    mapnames  = keys(map_status);

    for(i=0; i<sizeof(mapnames); i++) {
      map_skill(mapnames[i], map_status[mapnames[i]]);
    }
  }
  
  inv = all_inventory(me);
  for(i=0; i<sizeof(inv); i++)  { 
	destruct( inv[i] );
  }

  // save once here, an external bug might stop the following
  setup();
  save();

  inv = all_inventory(ob);
  weapon_cnt = 0;
  armor_cnt = 0;
  for(i=0; i<sizeof(inv); i++) {
    if ( !inv[i]->unique() && inv[i]->query("skill_type") &&
        inv[i]->query("equipped") && !weapon_cnt  ) {
      object obj = new(base_name(inv[i]));
      if (obj)
      {
        if(obj->move(me)) // mon 8/13/97
        obj->wield();
      }
      set("weapon", base_name(inv[i]));
	  weapon_cnt = 1;
    }
    else if ( !inv[i]->unique() && !inv[i]->query("skill_type") && 
        inv[i]->query("equipped") && !armor_cnt ) {
      object obj = new(base_name(inv[i]));
      if (obj)
      {
        if(obj->move(me))
        obj->wear();   //mon 8/13/97
      }
      set("armor", base_name(inv[i]));
	  armor_cnt = 1;
    }
	else if( armor_cnt && weapon_cnt )
	   break;
  }

  setup();
  save();
  reset_eval_cost();

  return 1;
}

int convert_identity (object me, object ob)
{
  reset_eval_cost();
  reset_me(me);
  if (ob->query("id") == "tian shen")
  {
    string current_player = ob->query("current_player");

    set("current_player",current_player);
    if (! current_player ||
        current_player == "none of us")
    {
      //set("short",get_honor_str()+"("+capitalize(query("id"))+")");
      save();
      return 1;
    }
    else
    {
      set("name", ob->query("name") );
      set("gender", ob->query("gender") );
      set("short",get_honor_str()+" "+
              query("name")+"("+capitalize(query("id"))+")");
    }
  }
  else
  {
    set("name", ob->query("name") );
    set("gender", ob->query("gender") );
    set("current_player",ob->query("id"));
    set("short",get_honor_str()+" "+
        query("name")+"("+capitalize(query("id"))+")");

    //ob->delete_temp("apply/short");
    //ob->set_temp("apply/short", ({get_honor_str()+" "+
    //             ob->query("name")+"("+capitalize(ob->query("id"))+")"}));
    //ob->set_temp("apply/name", ({get_honor_str()+ob->query("name")}));
    //ob->set_temp("apply/title",({get_respect_str()+" "+ob->query("title")}));
    ob->set_temp("apply/short", ({ob->query("title")+get_respect_str()+
                 " "+ob->query("name")+"("+capitalize(ob->query("id"))+")"}));
  }

  save_record(me, ob);

  return 1;
}

int do_save()
{
  return save();
}

object find_and_restore (string name)
{
  object me = find_object(name);

  if (! me ||
      ! restore())
    me = new (name);
  setup();
  return me;
}

object find_in_room (int i)
{
  string name = DIRNAME+"palace"+sprintf("%d",i);
  object room;

  call_other(name, "???");
  room = find_object(name);
  if (room)
    return present ("tian shen",room);
  else
  {
    name = DIRNAME+"npc/tian"+sprintf("%d",i);
    return find_and_restore (name);
  }
}

int check_player_position (object who)
{
  int i;

  for (i = 1; i < get_position_int(); i++)
  {
    //string npc = __DIR__"tian"+sprintf("%d",i);
    //object ob = find_and_restore(npc);
    object ob = find_in_room(i);
    reset_eval_cost();
    if (ob->query("current_player") == who->query("id"))
      return 0;
  }
  return 1;
}

void log_positions ()
{
  int i;
  string file_name = "pantaohui.results";

  log_file (file_name,"\n "+ctime(time())+":\n");
  for (i = 1; i <= MAXPOSITION; i++)
  {
    //string npc = __DIR__"tian"+sprintf("%d",i);
    //object ob = find_and_restore(npc);
    object ob = find_in_room(i);
    string name = ob->query("name");
    string id = ob->query("id");
    log_file (file_name,sprintf("  %d. %s %s\n",i,name,id));
  }
}

int remove_previous_position (object who, int position)
{
  int i;

  for (i = position+1; i <= MAXPOSITION; i++)
  {
    //string npc = __DIR__"tian"+sprintf("%d",i);
    //object ob = find_and_restore(npc);
    object ob = find_in_room(i);
    reset_eval_cost();
    if (ob->query("current_player") == who->query("id"))
    {
      ob->reset_me(ob);
      ob->save();
      ob->restore();
      return i;
    }
  }
  return MAXPOSITION;
}

int push_other_positions (object me, int position, int previous_position)
{
  int i;
  string src, dst;
  object who;
  object ob;

  for (i = previous_position-1; i >= position; i--)
  {
    reset_eval_cost();
    //src = __DIR__"tian"+sprintf("%d",i);
    //dst = __DIR__"tian"+sprintf("%d",i+1);
    //who = find_and_restore (src);
    //ob = find_and_restore (dst);
    who = find_in_room(i);
    ob = find_in_room(i+1);
    ob->set("new_player",1);
    convert_identity(ob,who);
  }
  return 1;
}

int fully_recover (object me)
{
  object *inv;
  object ob;
  string player_name;
  object current_player;
  int  i;

  reset_eval_cost();
  set("eff_gin", query("max_gin"));
  set("gin",     query("max_gin"));
  set("eff_kee", query("max_kee"));
  set("kee",     query("max_kee"));
  set("eff_sen", query("max_sen"));
  set("sen",     query("max_sen"));
  set("force",   query("max_force")*2);
  set("mana",    query("max_mana")*2);

  player_name = query("current_player");
  if (! player_name ||
      player_name == "none of us")
    return 1;
  if (current_player = LOGIN_D->find_body(player_name))
  {
    save_record (me, current_player);
  }
  else
  {
    seteuid(player_name);
    current_player = new(USER_OB);
    current_player->set("id", player_name);
    if (!current_player->restore()){
      destruct(current_player);
      return 1;
    }
    export_uid(current_player);
    seteuid(getuid());
    current_player->setup();
    save_record (me, current_player);
    destruct (current_player);
  }

  inv = all_inventory(me);
  for(i=0; i<sizeof(inv); i++)
  {
    destruct (inv[i]);
  }

  if (query("weapon"))
  {
    ob = new(query("weapon"));
    if(ob->move(me))
      ob->wield();   //mon 8/13/97
//    carry_object(base_name(ob))->wield();
  }

  if (query("armor"))
  {
    ob = new(query("armor"));
    if(ob->move(me))
      ob->wear();   //mon 8/13/97
//    carry_object(base_name(ob))->wear();
  }

  reset_eval_cost();
  return 1;
}

int accept_fight(object ob)
{
  object me = this_object();
  object who = this_player();
  object taibai = present("tai bai",environment(me));

  if (! taibai)
  {
    command ("say 太白金星不在，怎可妄动！\n");
    return notify_fail("还是请太白金星来吧。\n");
  }
  if (check_player_position (ob) == 0)
  {
    command ("say 不敢不敢！\n");
    return notify_fail("你的封神榜次已经比这天神高了。\n");
  }
  if (query("current_player") == ob->query("id")) 
  {
    command ("say 本天神怎可与自己较量！\n");
    return notify_fail("你已经是这个封榜天神了。\n");
  }
  if (is_fighting())
  {
    command ("say 请稍候！\n");
    return notify_fail("天神正在忙着，无法顾及你。\n");
  }
  if (! taibai->execute_approve_fight(who,me))
  {
    return notify_fail("看来太白金星不让你与天神较量。\n");
  }

  fully_recover (me);

  remove_call_out("check_result");
  call_out("check_result", 1, me, ob);
  
  return 1;
}

void taibai_execute_fight_result (object taibai, object me, object ob, int i)
{
  taibai->execute_fight_result(me, ob, i);
}

int check_result(object me, object ob)
{
  object taibai = present("tai bai",environment(me));
  int my_max_kee, his_max_kee;

  my_max_kee  = query("max_kee");
  his_max_kee = ob->query("max_kee");

  if (is_fighting())
  {
    call_out("check_result",1, me, ob);
    return 1;
  }

  if (taibai == 0)
    taibai == find_living ("tai bai");
  if (!present(ob, environment()))
  {
    remove_call_out ("taibai_execute_fight_result");
    call_out("taibai_execute_fight_result",1,taibai,me,ob,0);
    return 1; 
  }

  if (((int)query("kee")*100/(1+my_max_kee)) <= 50 )
  {
    int previous_position;
    message_vision ("$N翻身下拜，连声佩服！\n",me);
    previous_position = remove_previous_position (ob,get_position_int());
    push_other_positions (me,get_position_int(),previous_position);
    set("new_player",1);
    taibai_execute_fight_result (taibai,me,ob,1);
    convert_identity (me, ob);
    call_out("log_positions",1);
    return 1;
  }

  if (( (int)ob->query("kee")*100/his_max_kee)<=50)
  {
    message_vision ("$N将$n扶起。\n",me,ob);
  }

  call_out("taibai_execute_fight_result",1,taibai,me,ob,0);
  return 1;  
}

string query_save_file()
{
  return DATA_DIR+"pantao/tian"+sprintf("%d",get_position_int());
}

int do_bandage(string arg)
{
  object who = this_player();
  object me = present("tian shen",environment(who));

  if (! arg || me != present(arg, environment(me)))
    return 0;

  message_vision ("$N过份殷勤地要给$n包扎伤口。\n",who,me);
  call_out("no_bandage",2,who,me);
  return 1;
}

void no_bandage(object who, object me)
{
  message_vision ("$N向$n摇了摇头。\n",me,who);
}

int do_cast(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg == "transfer")
    return 0;

  message_vision ("$N张开嘴，结结吧吧地念了几声咒语。\n",who);
  call_out("no_cast",2,who,me);
  return 1;
}

void no_cast(object who, object me)
{
  message_vision ("$N向$n摇了摇头。\n",me,who);
}

int do_exert(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg != "sheqi tian shen" &&
      arg != "sheqi tian" &&
      arg != "sheqi shen")
    return 0;

  message_vision ("$N鬼鬼祟祟地一运气。\n",who);
  call_out("no_exert",2,who,me);
  return 1;
}

void no_exert(object who, object me)
{
  message_vision ("$N向$n摇了摇头。\n",me,who);
}

int do_steal(string arg)
{
  object who = this_player();
