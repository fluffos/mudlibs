// chicken.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("烤鸡", ({ "chicken", "ji", "kaoji", "kao ji" }));
  set_weight(160);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一只香喷喷的烤鸡。\n");
    set("unit", "只");
    set("value", 400);
    set("food_remaining", 10);
    set("food_supply", 40);
  }
}
