//碧藕


#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIW "碧藕" NOR, ({ "bi ou", "ou" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("long", "一枚采自海中仙山，浑然如玉的碧藕。\n");
    set("value", 5000);
  }

  setup();
}

int do_eat(string arg) {
  object me = this_player();
  int force_add, howold;
  howold = (int)me->query("mud_age") + (int)me->query("age_modify");
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  me->set("food", (int)me->max_food_capacity());
  me->set("water", (int)me->max_water_capacity());
  force_add = 5 + (int)me->query_kar() / 10;
  me->add("eat_biou", 1);
  if ((int)me->query("eat_biou") > 10) {
    if ((int)me->query("max_force") > 100) {
      me->add("max_force", -(int)me->query_kar());
    }
    me->delete("eat_biou");
    message_vision(HIG "$N吃下一枚碧藕，脸色突然转绿，「哇哇」几口又吐了出来！\n" NOR, me);
    tell_object(me, BLK "你口中又苦又涩，原来是枚坏藕！\n" NOR);
  } else if ((int)me->query("max_force") < 10 * (int)me->query_skill("force")) {
    me->add("max_force", force_add);
    message_vision(HIG "$N吃下一枚碧藕，脸色变的如同良玉一般雪白！\n" NOR, me);
  } else message_vision(HIG "$N吃下一枚碧藕，脸色突然发青，过了许久才转为平常！\n" NOR, me);

  if (howold > 1382400) {
    me->add("age_modify", -1200);
    me->add("age_modify_time", 1);
  }


  destruct(this_object());
  return 1;
}
