// golden_armor.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("天兵战甲", ({ "heaven armor", "armor" }) );
	set_weight(40000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "gold");
		set("value", 9000);
		set("armor_prop/armor", 50);
		set("armor_prop/dodge", -15);
	}
	setup();
}
