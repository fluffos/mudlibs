//changan city

inherit ROOM;

int valid_push(object);
void create() {
  set("short", "状元府");
  set("long", @LONG

转过背阴巷，就看到了一座豪宅。两个硕大的石狮子镇在大门前，摇
曳在风中的大灯笼上写着“刘府”两个红字。正眼望去，门匾上提着
龙飞凤舞的“状元及第”，旁边隐约能看见“世民”的御款。你不由
得纳闷：怎么状元府立在这等偏僻之地？
LONG);
  set("item_desc", ([ "lion": "    这石狮子立得方方正正，但如果用力的话还是可以推动的。\n",
    "shizi": "    这石狮子立得方方正正，但如果用力的话还是可以推动的。\n",
    "石狮": "    这石狮子立得方方正正，但如果用力的话还是可以推动的。\n"
  ]));

  set("exits",
    ([  //sizeof() == 2
    "south": __DIR__ "liuhall",
      "north": __DIR__ "beiyin1",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/yayi": 2,
    ]));

  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_push", "push");
}

int do_push(string arg) {
  object me;

  if (!arg || arg == "") {
    write("什么？\n");
    return 1;
  }
  if (arg == "lion" || arg == "石狮子" || arg == "石狮" || arg == "stone") {
    me = this_player();
    if (valid_push(me))
      message_vision("$N使出吃奶的劲，把门前的石狮子挪开了一点！\n", me);
    else return 1;
    if (!query("exits/down")) {
      set("exits/down", __DIR__ "midao");
      call_out("close_path", 1);
    }
    return 1;
  } else {
    write("你推不开" + arg + "。\n");
    return 1;
  }
}

void close_path() {
  if (!query("exits/down")) return;
  message("vision",
    "石狮子自动恢复了原位。\n",
    this_object());
  delete("exits/down");
}

int valid_leave(object me, string dir) {
  if (dir == "south") {
    if (objectp(present("yayi", environment(me)))) {
      if (!present("dudou", me))
        return notify_fail("衙役喝道：状元府岂是这等闲人乱闯的？滚蛋！\n");
    }
    return ::valid_leave(me, dir);
  }
  return 1;
}

int valid_push(object me) {
  if (objectp(present("yayi", environment(me)))) {
    message_vision("衙役对$N喝道：什么人，竟敢在官府门前撒野！\n", me);
    return 0;
  } else return 1;
}
