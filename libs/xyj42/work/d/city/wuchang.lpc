// Room: /d/huashan/wuchang.c

#include <ansi.h>

inherit ROOM;

string look_notice();

void create() {
  set("short", "比武场");
  set("long", @LONG
这里是华山绝顶上的一个大广场，是历来武林人士比武的场所。
武林中一年一度的华山论剑也就是在这里举行的，在论剑中取得第一
的剑客就是武林盟主。比武场的两边各放着一排武器架 (shelf)，上
面摆满了各种练武用的兵器。广场正前方的山岩上是一年一度的英雄
排行榜(notice)，上面记载了历届华山论剑的结果。由于为了公平比
武的需要，比武场备有不少灵药，可以让你的伤立刻恢复(recover)。
在广场的一旁该有华山论剑规则(rules)。
LONG
  );

  set("item_desc", ([
    "notice": (: look_notice :),
    "rules":
    @TEXT
比武规则：
    当人到齐后，选出一名玩家敲击巨鼓(knock drum)，然后将自动
进行分组赛，玩家依次轮流进行比武。在比武过程中如果真气受损，
可以用recover 命令恢复正常状态，如果比武过程被意外中断，由击
鼓者(即发起人)发next命令跳过目前正在进行的一场比武，进入下一
个回合。决赛结束后，将自动对整个比武过程进行名次排定，前四名
将记入本次论剑的史册。
TEXT,
    "shelf":
    @TEXT
兵器架上摆着有下面这些武器：
    竹剑      sword
    木刀      blade
    木棍      stick
    木杖      staff
    皮鞭      whip
TEXT,
  ]));
  set("exits", ([
    "down": __DIR__ "guangc",
  ]));
  /*
	set("objects", ([
		"/obj/drum" : 1,
		"/obj/npc/meng-zhu" : 1,
]));
*/
  set("valid_fight", 1);

  set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_recover", "recover");
  add_action("do_get", "get");
  add_action(
    "disable_cmds",
    ({ "kill", "hit", "sleep", "steal", "study", "learn", "exercise", "meditate", "respirate" })
  );
}

int do_get(string arg) {
  string name;
  object ob;

  if (!arg) return 0;
  if (sscanf(arg, "%s from shelf", name) != 1) return 0;

  switch (name) {
    case "sword": ob = new("/d/snow/obj/bamboo_sword"); break;
    case "blade": ob = new("/obj/weapon/woodblade"); break;
    case "stick": ob = new("/obj/weapon/stick"); break;
    case "staff": ob = new("/obj/weapon/staff"); break;
    case "whip": ob = new("/obj/weapon/whip"); break;
    default: return 0;
  }
  if (!ob) return 0;
  ob->move(this_player());
  message_vision("$N从兵器架上取下一" + ob->query("unit") + ob->query("name") + "。\n",
    this_player());
  return 1;
}

int disable_cmds(string arg) {
  tell_object(this_player(), "这里禁止使用这个命令！\n");
  return 1;
}

string look_notice() {
  object who;
  string *name_list, file;
  int i, j = 0, k;

  who = this_player();

  file = read_file("/log/lunjian");

  if (!file)
    return "目前没有任何比武记录。\n";

  name_list = explode(file, "\n");

  for (i = 0; i < sizeof(name_list); i++) {
    if (name_list[i] == "seperator") {
      j++;
      k = 0;
      printf("\n第" + chinese_number(j) + "届华山论剑结果：\n");
      continue;
    }
    k++;
    printf(GRN "第" + chinese_number(k) + "名：%-50s\n" NOR, name_list[i]);
  }

  return "\n";
}

int do_recover(string arg) {
  object me;

  me = this_player();
  if (me->is_fighting())
    return notify_fail("你正在战斗中，无法恢复体力。\n");
  if (query("exits/down"))
    return notify_fail("你要恢复体力，还是去找平大夫吧。\n");

  me->set("eff_gin", me->query("max_gin"));
  me->set("gin", me->query("eff_gin"));
  me->set("eff_kee", me->query("max_kee"));
  me->set("kee", me->query("eff_kee"));
  me->set("eff_sen", me->query("max_sen"));
  me->set("sen", me->query("eff_sen"));
  me->set("force", me->query("max_force"));
  me->set("mana", me->query("max_mana"));
  me->set("atman", me->query("max_atman"));

  tell_object(me, "OK!\n");
  return 1;
}
