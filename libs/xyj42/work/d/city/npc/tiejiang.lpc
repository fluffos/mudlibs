// waiter.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("周铁匠", ({ "zhou tiejiang", "zhou", "tiejiang", "smith"
  }));
  set("gender", "男性");
  set("age", 42);
  set("long",
    "周铁匠四十多岁，长得虎背熊腰。。\n");
  set("combat_exp", 10000);
  set("attitude", "peaceful");

  set_skill("dodge", 40);
  set_skill("unarmed", 40);
  set_skill("literate", 40);

  set("max_kee", 600);
  set("max_sen", 600);


  set("vendor_goods", ([
    "dagger": "/d/obj/weapon/dagger/dagger.lpc",
    "axe": "/d/obj/weapon/axe/tiefu.lpc",
    "hammer": "/d/obj/weapon/hammer/hammer",
    "tielian": "/d/obj/weapon/whip/tielian",
    "sword": "/d/obj/weapon/sword/changjian",
    "blade": "/d/obj/weapon/blade/blade",
    "fork": "/d/obj/weapon/fork/fork",
    "tiegun": "/d/obj/weapon/stick/bintiegun",
    "qiang": "/d/obj/weapon/spear/tieqiang",
  ]));
  setup();

  carry_object("/d/obj/cloth/linen")->wear();
  carry_object("/d/obj/weapon/hammer/hammer")->wield();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say("周铁匠说道：这位" +
        RANK_D->query_respect(ob)
        + "，进来随便看看吧。\n");
      break;
    case 1:
      say("周铁匠用脖子上的毛巾抹了抹手，说道：这位" +
        RANK_D->query_respect(ob)
        + "，请进请进。\n");
      break;
    case 2:
      say("周铁匠说道：这位" +
        RANK_D->query_respect(ob)
        + "，进来挑一件称手的兵器吧。\n");
      break;
  }
}
