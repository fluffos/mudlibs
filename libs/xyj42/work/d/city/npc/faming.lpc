#include <ansi.h>
inherit NPC;

int give_cloth();

void create() {
  set_name("法明长老", ({ "faming zhanglao", "monk", "faming", "zhanglao" }));
  set("long",
    "法明长老是化生寺的主持，神色庄重，举止间自有一番威仪。
听说他有一身武艺，也能呼风唤雨，却不传授于寺里的和尚。\n");
  set("title", "主持");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");
  set("chat_chance", 10);
  set("chat_msg", ({
    "法明长老向外望去，好象有什么心事。\n",
    "法明长老低声诵道：“南无阿弥陀佛”。\n",
    "法明长老叹了口气：“我不入地狱谁入地狱？”。\n"
  }));
  set("inquiry", ([
    "here": "这里就是长安城的化金寺！",
    "血衣": (: give_cloth :),
    "身世": (: give_cloth :)
  ]));



  set("age", 55);
  set("per", 23);
  set("max_kee", 900);
  set("max_sen", 600);
  set("force", 500);
  set("max_force", 500);
  set("force_factor", 40);
  set("max_mana", 500);
  set("mana", 900);
  set("mana_factor", 30);
  set("combat_exp", 200000);
  set("shen_type", 1);

  set("eff_dx", 90000);
  set("nkgain", 300);


  set_skill("force", 90);
  set_skill("unarmed", 90);
  set_skill("dodge", 90);
  set_skill("jienan-zhi", 90);
  set_skill("parry", 90);
  set_skill("spells", 90);
  set_skill("buddhism", 90);
  map_skill("unarmed", "jienan-zhi");
  map_skill("spells", "buddhism");
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: cast_spell, "bighammer" :),
  }));

  setup();
  carry_object("/d/obj/cloth/monkcloth")->wear();
  //	carry_object("/d/obj/book/dudou");

  setup();
}

int give_cloth() {
  object me, cloth;

  me = this_player();
  me->add_temp("asked", 1);
  if ((int)me->query_temp("asked") == 1)
    say("法明长老的眼光似乎闪了一闪，但立即恢复了平静。\n");
  else if ((int)me->query_temp("asked") == 2)
    say("法明长老摇摇头叹了口气，说：“你的能力还不够...”\n");
  else {
    me->delete_temp("asked");
    say("法明长老的眼中放出一道精光：“苍天有眼，老朽终于等到今日了！”\n");
    cloth = find_object("/d/obj/book/dudou.lpc");
    if (!cloth) {
      cloth = new("/d/obj/book/dudou");
      cloth->move(me);
      message_vision(HIY "$N从怀里掏出样裹得极严的布包递给了$n，说道：“你一定要把他救出来！”。\n" NOR, this_object(), me);
    }
  }
  return 1;
}
