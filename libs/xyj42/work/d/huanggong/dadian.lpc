// Lau Apr 03 1998

inherit ROOM;

void create ()
{
	set("short", "大殿");
	set("long", @LONG

皇宫大殿里金光闪烁瑞霭如云紫气环绕，殿中是雕龙绘凤祥云朵
朵，殿心有一白玉台阶，正中是金银宝座，唐太宗怡然高坐。两
边文武官弁肃然伫立，神态庄严。

LONG);

	set("no_fight",1);
	set("no_magic",1); 
	set("exits", ([
		"east"  : __DIR__"dongdian",
		"north" : __DIR__"Houdian",
		"south" : __DIR__"baiyujie",
		"west"  : __DIR__"xidian",
	]));
	set("objects", ([
		__DIR__"npc/dachen4" : 1,
		__DIR__"npc/dachen1" : 1,
		__DIR__"npc/emperor" : 1,
		__DIR__"npc/dachen2" : 1,
		__DIR__"npc/dachen3" : 1,
		__DIR__"npc/dachen5" : 1,
	]));
	set("no_clean_up",0);
	setup();
}

int valid_leave(object me, string dir)
{
	object ob;
        if( dir != "south" && (int)me->query_temp("gained")==0 )
        {
		return notify_fail("你将头往殿里一探，里面几个威武武弁将你架出。\n");
	}
	else if ( dir == "south" ) me->delete_temp("gained");
	return 1;
}

