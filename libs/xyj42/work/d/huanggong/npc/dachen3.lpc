inherit NPC;

void create()
{
        set_name("徐茂功", ({ "xu maogong", "xu", "maogong" }) );
        set("gender", "男性");
        set("age", 60);
        set("combat_exp", 350000);
	set("title", "大臣");
        set("attitude", "friendly");
	set("per", 30);
        set("str", 35);
        set("max_kee", 3000);
        set("max_gin", 3000);
	set("max_mana", 1000);
	set("mana", 1000);
        set("force", 1000);
        set("max_force", 1000);
        set("force_factor", 80);
        set_skill("unarmed", 80);
        set_skill("parry", 80);
        set_skill("dodge", 80);
	set_skill("spells", 80);
        setup();

        carry_object("/d/obj/cloth/jinpao")->wear();
}
