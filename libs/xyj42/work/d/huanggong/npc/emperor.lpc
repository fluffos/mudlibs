// by snowcat 

inherit NPC;

#include <ansi.h>
#include "/d/kaifeng/npc/quest.h"
#include "/d/kaifeng/npc/reporting.h"

string chinese_daoxing(int gain);

void create() {
  set_name("唐太宗", ({ "tang taizong" }));
  set("long", "大唐国当朝真龙天子。\n");
  set("title", "天朝皇帝");
  set("gender", "男性");
  set("age", 80);
  set("per", 30);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 220000);
  set_skill("unarmed", 88);
  set_skill("dodge", 88);
  set_skill("parry", 88);
  set_skill("force", 88);
  set_skill("spells", 88);
  set("max_gin", 700);
  set("max_kee", 700);
  set("max_sen", 700);
  set("max_force", 800);
  set("max_mana", 800);
  set("force_factor", 50);
  set("rank_info", ([ /* sizeof() == 1 */
    "respect": "陛下",
  ]));

  setup();
  carry_object("/d/obj/cloth/mangpao")->wear();
}

void rewarding(object who);

void init() {
  call_out("check_player", 1, this_player());
}

void check_player(object who) {
  string name, *skls, skill;
  object gift;
  object me = this_object();
  int dot;

  if (!visible(who))
    return;

  if (!who || environment(who) != environment(me))
    return;

  if (who->query("quest/reward") > 0) {
    message_vision("一进大殿，$N身上涌起淡淡的祥云。\n", who);
    message_vision(
      "$N对$n惊叹道：" + RANK_D->query_respect(who) + "祥云缭绕，面生瑞气，朕果然有赏御赐与你！\n",
      me,
      who,
      who
    );
    message_vision("\n$N走上前，赶紧在$n的殿前俯身跪下。\n", who, me);

    switch (random(10)) {
      case 9:
        name = "段志贤";
        dot = (int)who->query("quest/reward") * 5;
        gift = new("/obj/money/silver");
        gift->set_amount(dot);
        gift->move(who);
        who->add("quest/gain/silver", dot);
        tell_object(who, "\n旁边闪过大臣" + name + "低声向唐太宗说了几句，唐太宗点了点头。\n");
        message_vision(name + "对$N一拜：陛下有旨，赐" + RANK_D->query_respect(who)
          + "白银" + chinese_number(dot) + "两!\n", who);
        MONITORD->report_system_msg(who->query("name") + "(" + who->query("id") + ")"
          +who->query("quest/reason") + "得到白银" + chinese_number(dot) + "两。\n");
        break;
      case 7:
      case 8:
        name = "张士衡";
        skls = keys(who->query_skills());
        dot = (int)who->query("quest/reward");
        skill = skls[random(sizeof(skls))];
        who->improve_skill(skill, dot);
        who->add("quest/gain/" + to_chinese(skill), dot);
        tell_object(who, "\n旁边闪过大臣" + name + "低声向唐太宗说了几句，唐太宗点了点头。\n");
        message_vision(name + "对$N一拜：陛下有旨，赐" + RANK_D->query_respect(who) + "技能"
          +to_chinese(skill) + chinese_number(dot) + "点!\n", who);
        MONITORD->report_system_msg(who->query("name") + "(" + who->query("id") + ")"
          +who->query("quest/reason") + "得到" + to_chinese(skill) + chinese_number(dot) + "点。\n");
        break;
      case 6:
      case 5:
      case 4:
      case 3:
        name = "徐茂功";
        dot = (int)who->query("quest/reward") * 4;
        who->add("combat_exp", dot);
        who->add("quest/gain/combat_exp", dot);
        tell_object(who, "\n旁边闪过大臣" + name + "低声向唐太宗说了几句，唐太宗点了点头。\n");
        message_vision(name + "对$N一拜：陛下有旨，赐" + RANK_D->query_respect(who)
          +chinese_daoxing(dot) + "道行!\n", who);
        MONITORD->report_system_msg(who->query("name") + "(" + who->query("id") + ")" + who->query("quest/reason") + "得到道行"
          +chinese_daoxing(dot) + "。\n");
        break;
      case 2:
      case 1:
      case 0:
        name = "杜如晦";
        dot = (int)who->query("quest/reward");
        who->add("potential", dot);
        who->add("quest/gain/potential", dot);
        tell_object(who, "\n旁边闪过大臣" + name + "低声向唐太宗说了几句，唐太宗点了点头。\n");
        message_vision(name + "对$N一拜：陛下有旨，赐" + RANK_D->query_respect(who)
          +chinese_number(dot) + "潜能!\n", who);
        MONITORD->report_system_msg(who->query("name") + "(" + who->query("id") + ")" + who->query("quest/reason") + "得到潜能"
          +chinese_number(dot) + "点。\n");
        break;
    }
    who->delete("quest/reward");
  }
  return;
}

string chinese_daoxing(int gain) {
  int year, day, hour;
  string str;

  year = gain / 1000;
  day = (gain - year * 1000) / 4;
  hour = (gain - year * 1000 - day * 4) * 3;
  str = "";
  if (year) str = str + chinese_number(year) + "年";
  if (day) str = str + chinese_number(day) + "天";
  if (hour) str = str + chinese_number(hour) + "时辰";

  return str;
}
