// create by snowcat.c 2/8/1997

inherit ROOM;
inherit __DIR__"ground3";

#include "ground.h"

void create ()
{
  set ("short", "赛场");
  set ("long", @LONG

赛场四周是高高的贵宾观礼台，十丈见方的场地上整整齐齐地
铺着一圈彩色玛瑙石，架着香烟袅绕的四个巨大金银铜铁鼎，
场地中间是软松的皮绒织锦毯。

LONG);

  set("exits", ([
        "westup"  : __DIR__"west",
        "eastup"  : __DIR__"east",
        "northup"  : __DIR__"north",
        "southup"  : __DIR__"south",
      ]));
  set("objects", ([
        __DIR__"npc/wei"  : 1,
      ]));
  set("broadcast",1);
  set("alternative_die",1);
  setup();
}

void init ()
{
  object who = this_player();

  if (wizardp(who))
  {
    init0();
    init1();
    init2();
    init3();
    call_out ("hinting",1,who);
  }
}

void hinting (object who)
{
  tell_object (who, "\n");
  tell_object (who, "◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇\n");
  tell_object (who, "◇大会分筹备、比赛、结束等阶段，不同阶段有不同命令。◇\n");
  tell_object (who, "◇使用命令时请注意是否有其他巫师也在此设置比赛数据。◇\n");
  tell_object (who, "◇　　　　　　　　　　　　　　　　　　　　　　　　　◇\n");
  tell_object (who, "◇请您随时使用 ? 或 what 来查询您可以使用的命令。 　◇\n");
  tell_object (who, "◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇\n");
  tell_object (who, "\n");
}
