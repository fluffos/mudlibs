#include <room.h>
inherit ROOM;
 
void create()
{
        set("short", "东门厅");
        set("long", @LONG
现在整修中。
LONG
        );
 
        set("exits", ([
                "east" : __DIR__"dongtian",
        ]));
 
        create_door("east", "东天门", "west", DOOR_CLOSED);
 
        set("objects", ([
                __DIR__"npc/tong-nan" : 2,
        ]));
 
        setup();
}
