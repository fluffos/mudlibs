#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "休息室");
  set("long", @LONG

屋内散发着一股淡淡的幽香。靠墙是几张干干净净的床铺(bed)。
这是月宫弟子休息的地方。
LONG);

  set("item_desc", ([ "bed": "睡觉用的床铺(gosleep,gobed,bed)。 \n", ]));
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "xiaoyuan",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  setup();
}

void init() {
  add_action("do_bed", "gosleep");
  add_action("do_bed", "gobed",);
  add_action("do_bed", "bed");
}

int do_bed() {
  object me;
  me = this_player();
  message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
  me->move("/d/moon/bed_moon");
  message_vision(HIY "\n纱帐轻轻一动，$N钻了进来。\n" NOR, me);
  return 1;
}
