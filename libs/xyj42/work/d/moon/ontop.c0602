inherit ROOM;

void create ()
{
  set ("short", "玉女峰顶");
  set ("long", @LONG

祥云光满，瑞霭香浮。在这冰天雪地里居然还有如此仙境。这
里正是独立云海，傲越千山的昆仑极顶。靠南似乎有一条下山
的小路。靠北则有一圈篱笆，围着几间精致的小屋，入口处有
一株桂树。往东可望见一片杏林。
LONG);

  set("objects", ([ /* sizeof() == 3 */
  __DIR__"npc/wugang" : 1,
  __DIR__"obj/guishuzhi" : 1,
  __DIR__"npc/girl" : 1,
]));
  set("outdoors", 2);
  set("exits", ([ /* sizeof() == 3 */
  "north" : __DIR__"xiaoyuan",
  "east" : __DIR__"yltw",
  "southdown" : __DIR__"neartop",
]));

  setup();
}


int valid_leave(object me, string dir)
{
    if (me->query("gender") == "男性" && dir == "north" ) {
        if(objectp(present("wu gang", environment(me))))
            return notify_fail("桂花树后转出吴刚，伸出一把大板斧拦住你道：\n慢着...院子里住的全是女人，你跑进去想干什么？\n");
    }
    return ::valid_leave(me, dir);
}



