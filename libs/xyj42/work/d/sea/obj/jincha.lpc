#include <weapon.h>
#include <ansi.h>

inherit FORK;

void create() {
  set_name(YEL "金叉" NOR, ({ "golden fork", "jin cha", "cha", "fork" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 6000);
    set("material", "gold");
    set("rigidity", 70);
    set("long", "一柄黄灿灿的纯金铸成的兵器，是大海中的珍宝。\n");
    set("wield_msg", "$N操起一柄$n，脸上露出自信的微笑。\n");
  }
  init_fork(65);
  setup();
}
