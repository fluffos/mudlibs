#include <weapon.h>
#include <ansi.h>

inherit FORK;

void create()
{
        set_name(CYN "银叉" NOR, ({ "yin cha", "cha", "fork" }) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 4000);
                set("material", "silver");
                set("rigidity", 40);
                set("long", "一柄亮晶晶的银叉。\n");
                set("wield_msg", "$N操起一柄$n，脸上露出自信的微笑。\n");
        }
        init_fork(50);
        setup();
}

