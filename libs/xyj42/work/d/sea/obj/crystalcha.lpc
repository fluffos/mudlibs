// crystalcha.c Sjmao 03-09-98
#include <ansi.h>
#include <weapon.h>

inherit F_UNIQUE;


inherit FORK;

void create()
{
        set_name(BBLU CYN"水晶叉"NOR, ({ "crystal fork","fork","cha" }));
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("no_sell", 0);
                set("no_drop", 1);
                set("no_put", 1);
                set("value", 20000);
                set("rigidity", 100);
                set("replace_file", "/d/sea/obj/yincha");
                set("long", "一柄样式别致的紫色水晶短叉，锋利无比。\n");
                set("material", "crystal");
                set("wield_msg","$N微微一笑，手中已经多了一柄精致的水晶短叉。\n");
                set("unwield_msg", "$N将手中的$n系到背后．\n");
        }
        init_fork(80);
        set("is_monitored",1);
        setup();
}

