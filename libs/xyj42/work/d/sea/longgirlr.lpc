// Room: /city/erlou.c

#include <ansi.h>
inherit ROOM;

void create()
{
  set ("short", HIC"卧房"NOR);
        set("long", @LONG

紫云公主的一间睡房，房间里放着一张白玉做成的床．
整个屋子干干净净，鲜艳的珊瑚更为之添色！

LONG
        );
  set("item_desc",(["bed":"一张白玉床。 \n", ]));


        set("exits", ([
                "east" : "/d/sea/girl2",
        ]));

        setup();
}
void init()
{
        add_action("do_bed", "gosleep");
        add_action("do_bed", "gobed", );
        add_action("do_bed", "bed");
}

int do_bed()
{       object me;
        me=this_player();
        message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
        me->move(__DIR__"bed");
            message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
                return 1;
}


