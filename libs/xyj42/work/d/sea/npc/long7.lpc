// long7.c
// created 6-6-97 pickle

#include <skill.h>

inherit NPC;
//inherit F_MASTER;
string test_me(object me);


void create()
{
  set_name("蚣蝮",({"gong fu","gong","fu","long","gongfu","dragon"}));
  set("long","龙生九子不成龙，各有所好：蚣蝮乃第七子，平生好水。\n");
  set("gender", "男性");
  set("age", 41);
  set("title", "龙王九子之");
  set("class","dragon");
  set("attitude", "peaceful");
  set("max_kee", 800);
  set("max_sen", 400);
  set("force", 600);
  set("max_force", 600);
  set("max_mana", 500);
  set("mana", 500);
  set("combat_exp", 900000+random(100000));
  set_skill("unarmed", 80);
  set_skill("dodge", 100);
  set_skill("force", 150);
  set_skill("parry", 100);
  set_skill("spear", 100);
  set_skill("spells", 130);
  set_skill("seashentong", 130);
  set_skill("dragonfight", 100);
  set_skill("dragonforce", 150);
  set_skill("bawang-qiang", 100);
  set_skill("dragonstep", 80);
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("spear", "bawang-qiang");
  map_skill("parry", "bawang-qiang");
  map_skill("dodge", "dragonstep");

        set("inquiry", ([
               "叉法简介": (: test_me :),
               "book": (: test_me :),
               "shu": (: test_me :),
               "书": (: test_me :), ]) );
  setup();  

  carry_object("/d/obj/armor/yinjia")->wear();
  carry_object("/d/obj/weapon/spear/tieqiang")->wield();
}

int accept_fight(object me)
{
  command("say 陆上我说不定打不过你，水里就是我的天下了！");
  command("enable unarmed none");
  command("enable spear none");
  command("unwield spear");
  command("enable parry none");
  command("enable dodge none");
  return 1;
}

void die()
{
  if( environment() ) 
    {
      message("sound", this_object()->query("name")+ "眼看不敌，借水遁逃走了。\n", environment());
    } 
  destruct(this_object());
}






string test_me(object me)
{
  object shu;
  me=this_player();
  if((string)me->query("family/family_name")=="龙宫")
    {
      if ((int)me->query_temp("lbook2_got")!=1)
      {
       shu = new("/d/obj/book/fork-1");
       shu->move(me);
       command(":D " + me->query("id"));
       message_vision("蚣蝮给$N一本〖叉法简介〗。\n",me);
       me->set_temp("lbook2_got",1);
       return ("即是龙宫弟子，就是自家人了！这书你拿去吧，放在我这里也没有用！\n");
      }
      else
      {
       command("kick "+me->query("id"));
       return ("小王八蛋，不是已经给过你书了嘛？？\n");
      }
    } 
  return ("我凭什么给你？我又不是开书店的！");
}

