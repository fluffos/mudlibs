inherit NPC;

string test_me(object me);

void create()
{
       set_name("龟八斗", ({"gui badou", "gui"}));

set("long","海底的大才子，以才智过人著称．\n");
       set("gender", "男性");
       set("age", 56);
        set("title", "军师");
        set("per", 10);
        set("max_kee", 800);
        set("kee",1000);
       set("attitude", "peaceful");
       set_skill("unarmed",80);
       set_skill("dodge",80);
	set_skill("parry", 80);
       set_skill("literate",80);
        set("combat_exp", 126000);
        set("inquiry", ([
               "女儿经": (: test_me :),
               "book": (: test_me :),
               "shu": (: test_me :),
               "书": (: test_me :),
               "文学书": (: test_me :), ]) );
        setup();
        add_money("gold", 1);
       carry_object("/d/gao/obj/magua")->wear();

}

string test_me(object me)
{
  object shu;
  me=this_player();
  if((string)me->query("family/family_name")=="龙宫") 
    { 
      if ((int)me->query_temp("lbook_got")!=1)
      {
       shu = new("/d/obj/book/girlbook");
       shu->move(me);
       command("hi " + me->query("id"));
       message_vision("龟八斗给$N一本〖女儿经〗。\n",me);
       me->set_temp("lbook_got",1);
       return ("我就喜欢勤学好问的人，这本书你就拿去吧！。\n");
      }
      else
      {
       command("kick "+me->query("id"));
       me->add("score",-20);
       return ("小王八蛋，不是已经给过你书了嘛？？\n");
      }
    }
      message_vision("龟八斗面有难色道：我不是不想给你，实在是陛下他不准呀。\n",me);
    return ("你还是去别处想想办法吧。\n");
   
}

