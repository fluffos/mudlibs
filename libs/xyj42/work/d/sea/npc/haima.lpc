inherit NPC;

void create()
{
        set_name("大海马", ({"haima"}));
        set("race", "野兽");
        set("age", 5);
        set("long", "一只大海马，是龙少爷的坐骑．\n");
        set("attitude", "friendly");

        set("str", 26);
        set("cor", 30);

        set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
        set("verbs", ({ "bite", "claw" }) );

        set("combat_exp", 10000);

        set_temp("apply/damage", 5);
        set_temp("apply/armor", 20);

        setup();
}

