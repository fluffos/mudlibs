
/************************************************************/

#include <ansi.h>
inherit NPC;
string try_me();
int total=random(20);
mapping count=([]);
/************************************************************/

void create()
{
       set_name("龙表弟", ({"long biaodi", "long", "biaodi"}));

set("long","龙少爷的表弟和死党．\n");
       set("gender", "男性");
       set("age", 26);
        set("per", 30);
       set("attitude", "peaceful");
       set("shen_type", 1);
        set_skill("unarmed", 60);
        set_skill("dragonfight", 60);
        set_skill("dodge", 60);
        set_skill("parry", 60);
        set_skill("dragonstep", 60);
        map_skill("dodge", "dragonstep");
        map_skill("unarmed", "dragonfight");
        set("force", 400);
        set("max_force", 400);
        set("force_factor", 5);
        set("combat_exp", 126000);
        setup();
        add_money("gold", 1);
        carry_object("/d/ourhome/obj/choupao")->wear();


  setup();
  set("inquiry", ([
		   "兵器": (: try_me :),
		   "衣甲": (: try_me :)
]) );
  
}

void init()
{
  add_action("do_yao", "yao");
}

int do_yao(string arg)
{
  object me=this_player(), npc=this_object(), obj;
  
  if((string)me->query("family/family_name")!="龙宫")
    return notify_fail(CYN"龙表弟没精打采地道：非亲非故凭什么找我要衣甲兵器！\n"NOR);
  if( !arg ||
     (arg != "blade"
   && arg != "sword"
   && arg != "axe"
   && arg != "gangcha"
   && arg != "mucha"
   && arg != "hammer"
   && arg != "spear"
   && arg != "stick"
   && arg != "tengjia"
   && arg != "skirt"))
    return notify_fail(CYN"龙表弟满脸狐疑地道：你要什么东西？\n"NOR);
    if(count[arg]>=total)
    return notify_fail(CYN"龙表弟气哼哼地道：都来要，哪那么多？没有了！\n"NOR); 
    if (arg == "tengjia" || arg == "skirt")
    {
    if (me->query_temp("mark/sea_armor") >= 3)
        return notify_fail(CYN"龙表弟气哼哼地道：你要了这么多还不够？！\n"NOR);
    me->add_temp("mark/sea_armor", 1);
    }
    else
    {
    if (me->query_temp("mark/sea_weapon") >= 2)
        return notify_fail(CYN"龙表弟气哼哼地道：你要了这么兵器，还不够？！\n"NOR);
    me->add_temp("mark/sea_weapon", 1);
    }
    count[arg]+=1;
    obj=new(__DIR__"obj/"+arg);
    obj->set("no_sell", 1);
    obj->set("no_drop", 1);
    command("say 给你的"+obj->query("name")+"别随便扔。");
    message_vision("龙表弟很不情愿地给$N一"+obj->query("unit")+obj->query("name")+ "。\n", me);
    obj->move(me);
    return 1;
}

string try_me()
{
  command("say 龙宫有钱没处扔，准备了一些兵器和衣甲。你想要找我。\n");
  return ("只要是龙宫弟子就可以拿一套去用。");
}
