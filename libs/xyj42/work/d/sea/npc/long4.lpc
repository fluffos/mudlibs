#include <skill.h>

inherit NPC;
//inherit F_MASTER;

void create()
{
  set_name("霸下",({"ba xia","ba","xia","long","baxia","dragon"}));
  set("long","龙生九子不成龙，各有所好：蒲霸下第四子，平生好负重。\n");
  set("gender", "男性");
  set("age", 34);
  set("title", "龙王九子之");
  set("class","dragon");
  set("attitude", "peaceful");
  set("max_kee", 800);
  set("max_sen", 400);
  set("force", 600);
  set("max_force", 600);
  set("force_factor", 15);
  set("max_mana", 500);
  set("mana", 500);
  set("combat_exp", 900000+random(100000));
  set_skill("unarmed", 80);
  set_skill("dodge", 50);
  set_skill("force", 150);
  set_skill("parry", 100);
  set_skill("spear", 80);
  set_skill("spells", 150);
  set_skill("seashentong", 100);
  set_skill("dragonfight", 80);
  set_skill("dragonforce", 150);
  set_skill("bawang-qiang", 80);
  set_skill("dragonstep", 50);
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("spear", "bawang-qiang");
  map_skill("parry", "bawang-qiang");
  map_skill("dodge", "dragonstep");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: cast_spell, "hufa" :),
    "霸下求饶道：别打了！别打了！我投降！\n",
    (: command, "surrender" :),

  }) );

  setup();  

  carry_object("/d/obj/armor/yinjia")->wear();
  carry_object("/d/obj/weapon/spear/tieqiang")->wield();
}

int accept_fight(object me)
{
  command("fear");
  command("say 我生平最怕打架，"+RANK_D->query_respect(this_player())+"还是放我一马吧．．．");
  return 0;
}

void die()
{
  if( environment() ) 
    {
      message("sound", "激战间只见一团黑影腾空而起，原来是" + this_object()->query("name")+ "抛下背上重物逃跑了。\n", environment());
    } 
  destruct(this_object());
}







