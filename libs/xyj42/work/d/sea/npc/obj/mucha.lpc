// gangcha.c

#include <weapon.h>

inherit FORK;

void create()
{
        set_name("木叉", ({ "mu cha", "cha","fork" }) );
        set_weight(400);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("material", "wood");
                set("long", "一柄小巧的木叉，是龙宫弟子入门的兵器。\n");
                set("wield_msg", "$N拿起一柄$n，轻轻地挥了两下。\n");
        }
        init_fork(5);
        setup();
}

