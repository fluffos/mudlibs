#include <skill.h>

inherit NPC;
//inherit F_MASTER;

void create()
{
  set_name("螭吻",({"chi wen","chi","wen","long","chiwen","dragon"}));
  set("long","龙生九子不成龙，各有所好：螭吻乃第五子，平生好望。\n");
  set("gender", "男性");
  set("age", 32);
  set("title", "龙王九子之");
  set("class","dragon");
  set("attitude", "peaceful");
  set("max_kee", 800);
  set("max_sen", 400);
  set("force", 600);
  set("max_force", 600);
  set("max_mana", 500);
  set("mana", 500);
  set("combat_exp", 900000+random(100000));
  set_skill("unarmed", 80);
  set_skill("dodge", 150);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("spear", 110);
  set_skill("spells", 120);
  set_skill("seashentong", 100);
  set_skill("dragonfight", 100);
  set_skill("dragonforce", 100);
  set_skill("bawang-qiang", 100);
  set_skill("dragonstep", 150);
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("spear", "bawang-qiang");
  map_skill("parry", "bawang-qiang");
  map_skill("dodge", "dragonstep");

  setup();  

  carry_object("/d/obj/armor/yinjia")->wear();
  carry_object("/d/obj/weapon/spear/tieqiang")->wield();
}

int accept_fight(object me)
{
  command("ok");
  command("say 那就玩玩吧！");
  command("enable unarmed none");
  command("enable spear none");
  command("unwield spear");
  command("enable dodge none");
  command("enable parry none");
  return 1;
}

void die()
{
  if( environment() ) 
    {
      message("sound", this_object()->query("name")+ "躬身作揖，道：俺到别处玩去了，恕不奉陪！\n", environment());
    } 
  destruct(this_object());
}







