// long1.c
// created 6-6-97 pickle

#include <skill.h>

inherit NPC;
//inherit F_MASTER;

void create() {
  set_name("椒图", ({ "shu tu", "shu", "tu", "long", "shutu", "dragon" }));
  set("long", "龙生九子不成龙，各有所好：椒图乃第九子，平生好闭。\n");
  set("gender", "男性");
  set("age", 41);
  set("title", "龙王九子之");
  set("class", "dragon");
  set("attitude", "peaceful");
  set("combat_exp", 1260000);
  set("max_kee", 800);
  set("max_sen", 400);
  set("force", 600);
  set("max_force", 600);
  set("max_mana", 500);
  set("mana", 500);
  set("combat_exp", 900000 + random(100000));
  set_skill("unarmed", 80);
  set_skill("dodge", 100);
  set_skill("force", 150);
  set_skill("parry", 100);
  set_skill("spear", 110);
  set_skill("spells", 120);
  set_skill("seashentong", 100);
  set_skill("dragonfight", 100);
  set_skill("dragonforce", 150);
  set_skill("bawang-qiang", 100);
  set_skill("dragonstep", 80);
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("spear", "bawang-qiang");
  map_skill("parry", "bawang-qiang");
  map_skill("dodge", "dragonstep");

  setup();

  carry_object("/d/obj/armor/yinjia")->wear();
  carry_object("/d/obj/weapon/spear/tieqiang")->wield();
}

int accept_fight(object me) {
  command("fear");
  command("say 俺就喜欢在屋里躲着，从来不喜欢打架。");
  command("say 不过既然" + RANK_D->query_respect(me) + "想比划两招，俺也只好奉陪了。");
  command("enable unarmed none");
  command("enable spear none");
  command("unwield spear");
  command("enable dodge none");
  command("enable parry none");
  return 1;
}

void die() {
  if (environment()) {
    message("sound", this_object()->query("name") + "道：打架实在无味，不如把自己锁屋里了。\n", environment());
  }
  destruct(this_object());
}
