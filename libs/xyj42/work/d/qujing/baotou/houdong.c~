void init()
{
	add_action("do_climb","climb");
}

int do_climb(string arg)
{
        object me,ob;
	string loc;
	
	me = this_player();
	if(!arg || arg=="" || arg != "up")
        {
                write("什么？\n");
                return 1;
	}
	if (me->is_busy()) return notify_fail("你忙着呢！\n");
	if (me->query_temp("no_move")) return notify_fail("你被定住了，什么也干不了。\n");
	
	message_vision("$N攀住岩壁，向上爬去。\n",me);
	if( ob = present("yao guai", this_object()) ) return notify_fail("你从岩壁上滑了下来！\n");

	loc = "/d/qujing/baotou/midong" + ( '1' + random(4) ) +".c";

	me->set_temp("force_sleep",1);
	me->move(loc);
}