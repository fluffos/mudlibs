// Room: /d/qujing/baotou/midong1.c
inherit ROOM;

void create ()
{
  set ("short", "密洞");
  set ("long", @LONG
    
这里光线极为微弱，你勉强地看见洞里隐隐约约的一些东西，
却又看得不是十分清楚。你不禁伸出手来扶着洞壁，小心地摸
索着行动。

LONG);

	set("exits", ([ /* sizeof() == 1 */
		"down" : __DIR__"houdong",
	]));

        set("objects", 
        ([ //sizeof() == 1
                __DIR__"obj/bang" : 1,
//		__DIR__"npc/yaowang" : 1,
        ]));

//        set("outdoors", "baotou");
        set("no_clean_up", 0);

	setup();
}

void init()
{
	object where = this_object();
	object who = this_player();
	call_out("check_player", 1, where, who );
}

void check_player(object where, object who)
{
	tell_room (where, "秘洞里散发着一股刺鼻的腥气，你顿时昏昏然。\n");
	if (who && environment(who) == where) {
		if( who->query_temp("force_sleep") )	{
			write("你勉强眨了眨惺忪的眼睛，打了个哈欠。\n你就地一躺，开始睡觉。\n不一会儿，你就进入了梦乡。\n");
			who->stop_busy();
			"/cmds/wiz/wsleep"->main( who );
			this_player()->delete_temp("force_sleep");
		}
	}
}