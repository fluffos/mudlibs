// Room: /d/qujing/yuhua/ting.c
inherit ROOM;

void create() {
  set("short", "前洞");
  set("long", @LONG
    
前洞里有天然石桥石亭，溪水从石桥下流过，两边石壁上挂下
来无数藤蔓。石亭边长着一些矮小的花草灌木，南边有路通向
洞外，东北边有一通道。

LONG);

  set("exits", ([ /* sizeof() == 1 */
    "northeast": __DIR__ "houdong",
    "south": __DIR__ "hukou",
  ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/yao": 3,
      __DIR__ "npc/yaowang": 1,
    ]));

  //        set("outdoors", "baotou");
  set("no_clean_up", 0);

  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "northeast") {
    if (present("yao wang", environment(me)))
      return notify_fail("妖王喝道：哪里走！\n");
    return ::valid_leave(me, dir);
  }
  return 1;
}
