#include <armor.h>

inherit CLOTH;

void create() {
  string *cname = ({ "卷毛狮", "金狮", "黑虎", "白虎", "花豹", "山猫" });
  string *ename = ({ "juanmao", "jinshi", "heihu", "baihu", "huabao", "shanmao" });
  int i = random(6);
  set_name(cname[i] + "皮", ({ ename[i] + " pi", "pi" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一条兽皮衣。\n");
    set("material", "leather");
    set("unit", "条");
    set("value", 300);
    set("armor_prop/armor", 15);
  }
  setup();
}
