#include <weapon.h>

inherit STICK;

void create()
{
        set_name("小金箍棒", ({ "xiao jingu bang", "bang" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "此棒以银为箍，中间乃一段乌铁。上铸小字：“小金箍棒”。\n");
                set("unit", "根");
                set("value", 3000);
		set("material", "iron");
		set("no_drop", 1);
		set("no_sell", "这样东西不能买卖。\n");
		set("wield_msg", "$N拿起$n，迎风一晃。\n");
		set("unwield_msg", "$N收起$n，$n顿时一闪不见了。\n");		
        }
	init_stick(65);
	setup();
}