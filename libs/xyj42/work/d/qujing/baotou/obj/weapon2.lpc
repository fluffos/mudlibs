#include <weapon.h>

inherit AXE;

void create()
{
        set_name("鹰嘴斧", ({ "yingzui fu", "fu" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
//                set("long", "这是一柄长长的四明铲，粗粗的杖头有一铲。\n");
                set("unit", "柄");
                set("value", 100);
		set("material", "iron");
//		set("no_drop", 1);
//		set("no_sell", "这样东西不能买卖。\n");
        }
	init_axe(28);
	set("wield_msg", "$N操起$n握在手里。\n");
//	set("unwield_msg", "$N收起$n，$n顿时一闪不见了。\n");		

	setup();
}