#include <weapon.h>

inherit STAFF;

void create()
{
        set_name("四明铲", ({ "siming chan", "chan" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "这是一柄长长的四明铲，粗粗的杖头有一铲。\n");
                set("unit", "柄");
                set("value", 3000);
		set("material", "iron");
//		set("no_drop", 1);
//		set("no_sell", "这样东西不能买卖。\n");
		set("wield_msg", "$N举起一柄长长的四明铲，顶端的铲头闪闪发亮。\n");
//		set("unwield_msg", "$N收起$n，$n顿时一闪不见了。\n");		
        }
	init_staff(65);
	setup();
}