#include <weapon.h>

inherit STAFF;

void create() {
  set_name("小降妖杖", ({ "xiao xiangyao zhang", "zhang" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一杆乌铁降妖杖，两头为银铸成。\n");
    set("unit", "杆");
    set("value", 3000);
    set("material", "iron");
    set("no_drop", 1);
    set("no_sell", "这样东西不能买卖。\n");
    set("wield_msg", "$N反手抽出一杆$n，在手中锵地一抡。\n");
  }
  init_staff(65);
  setup();
}
