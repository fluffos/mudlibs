#include <weapon.h>

inherit BLADE;

void create() {
  set_name("太乙竹刀", ({ "taiyi zhu dao", "dao" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一柄细竹刀，上有护道神符。\n");
    set("unit", "柄");
    set("value", 3000);
    set("material", "bamboo");
    set("no_drop", 1);
    set("no_sell", "这样东西不能买卖。\n");
    set("wield_msg", "$N抽出一柄细细的$n握在手中，霓光闪烁。\n");
    //		set("unwield_msg", "$N收起$n，$n顿时一闪不见了。\n");		
  }
  init_blade(65);
  setup();
}
