#include <weapon.h>

inherit RAKE;

void create()
{
        set_name("小九齿钯", ({ "xiao jiuchi pa", "pa" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一柄九齿钯，佩有银纹长把。\n");
                set("unit", "柄");
                set("value", 3000);
		set("material", "iron");
		set("no_drop", 1);
		set("no_sell", "这样东西不能买卖。\n");
		set("wield_msg", "$N抄起一柄$n，往空中顺手一筑。\n");
        }
	init_rake(65);
	setup();
}