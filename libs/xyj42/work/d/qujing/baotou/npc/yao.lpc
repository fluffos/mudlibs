  set("gender", "男性");
  set("attitude", "aggressive");
  set("age", 100);
  set("max_kee", 700);
  set("max_sen", 700);
  set("force", 800);
  set("max_force", 800);
  set("force_factor", 70);
  set("combat_exp", 140000);
  /*	set("inquiry", ([
		"here"   : "这儿是豹头山，上面是虎口洞也。",
		"豹头山" : "豹头山，上面便是虎口洞。",
		"name"   : "刁钻古怪",
		"dong"   : (: move_player :),
		"虎口洞" : (: move_player :),
	]) );
*/
  set_skill("unarmed", 70);
  set_skill("dodge", 70);
  set_skill("parry", 70);
  set_skill("axe", 70);
  set_skill("hammer", 70);
  set_skill("whip", 70);
  set_skill("fork", 70);
  set_skill("blade", 70);
  set_skill("stick", 70);
  set_skill("sword", 70);
  set_skill("spear", 70);
  set_skill("staff", 70);
  set_skill("rake", 70);
  set_skill("mace", 70);
  //	set("chat_chance_combat", 80);
  //	set("chat_msg_combat", ({
  //		(: cast_spell, "thunder" :),
  //	}) );

  setup();

  carry_object("/d/qujing/baotou/obj/weapon3")->wield();
  carry_object("/d/qujing/baotou/obj/cloth1")->wear();
}
