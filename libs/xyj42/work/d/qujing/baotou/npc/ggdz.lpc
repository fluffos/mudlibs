// By Lau Mar. 31, 1998

inherit NPC;

int move_player();

void create() {
  set_name("古怪刁钻", ({ "guguai diaozuan", "guguai", "diaozuan", "zuan" }));
  set("long", @LONG
一个小妖怪。
LONG);
  set("gender", "男性");
  set("age", 20);
  set("max_kee", 600);
  set("max_sen", 600);
  set("force", 800);
  set("max_force", 800);
  set("force_factor", 25);
  set("combat_exp", 150000);
  set("inquiry", ([
    "here": "这儿是豹头山，上面是虎口洞也。",
    "豹头山": "豹头山，上面便是虎口洞。",
    "name": "刁钻古怪",
    "dong": (: move_player :),
    "虎口洞": (: move_player :),
  ]));

  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_skill("parry", 60);
  //	set("chat_chance_combat", 80);
  //	set("chat_msg_combat", ({
  //		(: cast_spell, "thunder" :),
  //	}) );

  setup();

  carry_object("/d/qujing/baotou/obj/weapon1")->wield();
  carry_object("/d/qujing/baotou/obj/cloth1")->wear();
}

int move_player() {
  object me;
  me = this_player();

  if (me->name() == "刁钻古怪") {
    write("古怪刁钻看了你一眼。\n");
    write("古怪刁钻说：你今天糊涂了也，兄弟我一脚就把你踢进洞里。\n");
    write("说着古怪刁钻飞起一脚，你顺势往上一跃。\n");
    me->set("mana", 0);
    me->move("/d/qujing/baotou/dongwai");
    write("洞口一阵腥风吹来，你感到一阵突如其来的头晕。\n");
  } else message_vision("古怪刁钻看了$N一眼。\n古怪刁钻摇摇头：不认得你，不认得你。\n", me);

  return 1;
}
