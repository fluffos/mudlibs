/// food

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("辣味牛汤", ({"lawei niutang", "niutang" }));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一碗红呼呼的辣味牛肉汤。\n");
                set("unit", "碗");
                set("value", 160);
                set("food_remaining", 4);
                set("food_supply", 50);
        }
}

