inherit NPC;

void create() {
  set_name("索哈娜", ({ "suo hana", "suo" }));
  set("gender", "女性");
  set("age", 30);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin", 300 + random(100));
  set("max_kee", 300 + random(100));
  set("max_sen", 300 + random(100));
  set("combat_exp", 4000);
  set_skill("unarmed", 30);
  set_skill("dodge", 60);
  //  set_skill("parry", 30);
  setup();
  carry_object("d/obj/cloth/p_cloth")->wear();
}
