inherit NPC;

inherit F_VENDOR;

void create() {
  set_name("坎都力", ({ "kan duli", "kan" }));
  set("gender", "男性");
  set("age", 30);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin", 400 + random(100));
  set("max_kee", 400 + random(100));
  set("max_sen", 400 + random(100));
  set("combat_exp", 5000);
  set_skill("unarmed", 50);
  //  set_skill("dodge", 30);
  //  set_skill("parry", 30);
  set("vendor_goods", ([
    "zhengya": "/d/qujing/biqiu/obj/zhengya",
    "baijiu": "/d/obj/food/baijiu",
    "shaoe": "/d/qujing/biqiu/obj/shaoe",
  ]));
  setup();
  carry_object("/d/obj/cloth/choupao")->wear();
}
void init() { add_action("do_vendor_list", "list"); }
