inherit NPC;

inherit F_VENDOR;

void create()
{
       set_name("库司库司", ({"kusi kusi", "kusi"}));
       set("gender", "男性");
       set("age", 30);
       set("attitude", "friendly");
     set("shen_type", 1);
  set("people", "people");
  set("max_gin",450+random(100));
  set("max_kee",450+random(100));
  set("max_sen",450+random(100));
  set("combat_exp",5000);
  set_skill("unarmed", 30);
//  set_skill("dodge", 30);
//  set_skill("parry", 30);
  set("vendor_goods", ([
  "tangmian" : "/d/qujing/biqiu/obj/tangmian",
  "niutang" : "/d/qujing/biqiu/obj/niutang",
]));
  setup();
  carry_object("d/obj/cloth/choupao")->wear();
}
void init() { add_action("do_vendor_list", "list"); }

