inherit NPC;

inherit F_VENDOR;

void create()
{
       set_name("碧奴慕伊", ({"binu muyi", "muyi"}));
       set("gender", "女性");
       set("age", 30);
       set("attitude", "friendly");
     set("shen_type", 1);
  set("people", "people");
  set("max_gin",450+random(100));
  set("max_kee",450+random(100));
  set("max_sen",450+random(100));
  set("combat_exp",5000);
  set_skill("unarmed", 30);
//  set_skill("dodge", 30);
//  set_skill("parry", 30);
  set("vendor_goods", ([
 "hualan" : "/d/qujing/biqiu/obj/hualan",
 "huaping" : "/d/qujing/biqiu/obj/vase",
]));
  setup();
  carry_object("d/obj/cloth/nichang")->wear();
}
void init() { add_action("do_vendor_list", "list"); }

