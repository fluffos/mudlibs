inherit NPC;

inherit F_VENDOR;

void create() {
  set_name("拉苏律司", ({ "lasu lusi", "lusi" }));
  set("gender", "男性");
  set("age", 40);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin", 250 + random(100));
  set("max_kee", 350 + random(100));
  set("max_sen", 250 + random(100));
  set("combat_exp", 5000);
  set_skill("unarmed", 60);
  //  set_skill("dodge", 30);
  //  set_skill("parry", 30);
  set("vendor_goods", ([
    "wanlian": "/d/qujing/biqiu/obj/wrists",
    "jiezhi": "/d/qujing/biqiu/obj/ring",
    "xiangquan": "/d/qujing/biqiu/obj/neck",
  ]));
  setup();
  carry_object("/d/obj/cloth/choupao")->wear();
}
void init() { add_action("do_vendor_list", "list"); }
