/// food

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("牛肉汤面", ({ "niurou tangmian", "tangmian" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一碗鲜美的牛肉汤面。\n");
    set("unit", "碗");
    set("value", 280);
    set("food_remaining", 4);
    set("food_supply", 50);
  }
}
