#include <armor.h>

inherit WRISTS;

void create() {
  set_name("鎏金腕链", ({ "liujin wanlian", "wanlian", "wrists" }));
  set("weight", 400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 5000);
    set("material", "gold");
    set("armor_prop/armor", 1);
  }
  setup();
}
