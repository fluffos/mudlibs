inherit NPC;

string *names = ({
  "狐狸精",
  "野鸡精",
  "香麝精",
  "花獐精",
  "彩蝶精",
});

void create()
{
  int i = random(4)+1;
  set_name(names[random(sizeof(names))], ({"yao jing", "yao", "jing"}));
  set("gender", "女性");
  set("age", 18);
  set("combat_exp", 30000*i);
  set("per", 10);
  set_skill("parry", 30*i);
  set_skill("unarmed", 30*i);
  set_skill("dodge", 30*i);
  set("max_sen",200*i);
  set("max_gee",200*i);
  set("max_gin",200*i);
  set("force",200*i);
  set("max_force",200*i);
  set("max_mana",200*i);
  set("force_factor",20*i);
  setup();
  carry_object("/d/obj/cloth/shoupiqun")->wear();
}
