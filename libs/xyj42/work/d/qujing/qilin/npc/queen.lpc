inherit NPC;
string chinese_daoxing(int gain);

void create()
{
  string dir;
  set_name("金圣宫", ({"jinsheng gong", "gong", "queen"}));
  set("title", "朱紫国");
  set("gender", "女性");
  set("age", 28);
  set("per", 26);
  set("rank_info/respect", "娘娘");
  set("combat_exp", 100000);
  set_skill("snowsword", 30);
  set_skill("sword", 30);
  set_skill("dragonfight", 30);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set_skill("spells", 30);
  set_skill("dragonstep", 30);
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "dragonfight");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  set("max_gin", 500);
  set("max_kee", 500);
  set("max_sen", 500);
  set("force", 500);
  set("max_force", 500);
  set("mana", 500);
  set("max_mana", 500);
  set("force_factor", 10);

  setup();
  carry_object("/d/obj/cloth/shoupiqun")->wear();
}

void test_player (object who);

void init()
{
  test_player (this_player());
  ::init();
}

void test_player (object who)
{
  int i;

  if (who->query("combat_exp") < 10000)
    return;
  if (who->query("obstacle/zhuzi") == "done")
    return;
  if (! who->query_temp("obstacle/zhuzi_cured"))
    return;
  if (! who->query_temp("obstacle/zhuzi_killed"))
    return;
  i = random(3000);
  i = i + 30000;
  who->add("obstacle/number",1);
  who->set("obstacle/zhuzi","done");
  who->add("combat_exp",i);
  command("chat "+who->name()+"朱紫国施神力治愈万岁，解救金圣宫于三年久祸！");
  command("chat "+who->name()+"顺利闯过西行又一关！");
  tell_object(who,"你赢得了"+chinese_daoxing(i)+"的道行！");
  who->save();
  command ("thank");
  call_out ("leaving",2);
}

void leaving ()
{
  object me = this_object();

  command("bow");
  command("southeast");
  destruct (me);
}
string chinese_daoxing(int gain)
{            int year,day,hour;
             string str;
             year=gain/1000;
             day=(gain-year*1000)/4;
             hour=(gain-year*1000-day*4)*3;
             str="";
             if(year) str=str+chinese_number(year)+"年";
             if(day) str=str+chinese_number(day)+"天";
             if(hour) str=str+chinese_number(hour)+"时辰";
             return str;
}
