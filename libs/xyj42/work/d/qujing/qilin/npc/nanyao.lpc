inherit NPC;

string *names = ({
  "虎将",
  "熊师",
  "豹头",
  "彪帅",
  "羊头怪",
  "獭象怪",
  "鹿头怪",
  "苍狼怪",
  "乖獐怪",
  "狡兔怪",
  "长蛇怪",
  "狒狒怪",
  "蟒蛇怪",
});

void create() {
  int i = random(9) + 1;
  set_name(names[random(sizeof(names))], ({ "yao guai", "yao", "guai" }));
  set("gender", "男性");
  set("age", 30 * i);
  set("combat_exp", 30000 * i);
  set("per", 10);
  set_skill("parry", 30 * i);
  set_skill("unarmed", 30 * i);
  set_skill("dodge", 30 * i);
  set("max_sen", 200 * i);
  set("max_gee", 200 * i);
  set("max_gin", 200 * i);
  set("force", 200 * i);
  set("max_force", 200 * i);
  set("max_mana", 200 * i);
  set("force_factor", 20 * i);
  setup();
  set("chat_chance", 5);
  set("chat_msg", ({ (: random_move :) }));
  carry_object("/d/obj/cloth/shoupiqun")->wear();
}
