#include <weapon.h>

inherit EQUIP;
inherit F_BLADE;
inherit F_BLADE;
inherit F_FORK;
inherit F_MACE;
inherit F_SPEAR;
inherit F_SWORD;
inherit F_WHIP;
inherit F_AXE;
inherit F_HAMMER;
inherit F_RAKE;
inherit F_STAFF;
inherit F_STICK;
inherit F_DAGGER;

void create()
{
  switch (random(12))
  {
    case 0:
    {
      set_name("石铲刀", ({ "shichan dao", "dao", "blade" }) );
      init_blade(15);
      set("unit", "把");
      break;
    } 
    case 1:
    {
      set_name("鹿角叉", ({ "lujiao cha", "cha", "fork" }) );
      init_fork(15);
      set("unit", "把");
      break;
    } 
    case 2:
    {
      set_name("刺槐锏", ({ "cihuai jian", "jian", "mace" }) );
      init_mace(15);
      set("unit", "把");
      break;
    } 
    case 3:
    {
      set_name("红缨枪", ({ "hongying qiang", "qiang", "spear" }) );
      init_spear(15);
      set("unit", "把");
      break;
    } 
    case 4:
    {
      set_name("花竺剑", ({ "huazhu jian", "jian", "sword" }) );
      init_sword(15);
      set("unit", "把");
      break;
    } 
    case 5:
    {
      set_name("剥皮鞭", ({ "bopi bian", "bian", "whip" }) );
      init_whip(15);
      set("unit", "根");
      break;
    } 
    case 6:
    {
      set_name("开山斧", ({ "kaishan fu", "fu", "axe" }) );
      init_axe(15);
      set("unit", "把");
      break;
    } 
    case 7:
    {
      set_name("青石锤", ({ "qingsho chui", "chui", "hammer" }) );
      init_hammer(15);
      set("unit", "把");
      break;
    } 
    case 8:
    {
      set_name("筑山耙", ({ "zhushan pa", "pa", "rake" }) );
      init_rake(15);
      set("unit", "把");
      break;
    } 
    case 9:
    {
      set_name("浑铁杖", ({ "huntie zhang", "zhang", "staff" }) );
      init_staff(15);
      set("unit", "把");
      break;
    } 
    case 10:
    {
      set_name("打狗棍", ({ "daguo gun", "gun", "stick" }) );
      init_staff(15);
      set("unit", "把");
      break;
    } 
    case 11:
    {
      set_name("牛角刃", ({ "niujiao ren", "ren", "dagger" }) );
      init_dagger(15);
      set("unit", "把");
      break;
    } 
  }
  set_weight(1000);
  if( clonep() )
     set_default_object(__FILE__);
  else {
    set("value", 100);
    set("material", "iron");
  }
  setup();
}

