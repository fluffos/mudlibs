inherit NPC;

void create()
{
  int i = random(9)+1;
  set_name("小妖", ({"xiao yao","yao"}));
  set("gender", "男性");
  set("age", 20);
  set("combat_exp", 20000*i);
  set("attitude","aggressive");
  set("per", 15);
  set_skill("parry", 20*i);
  set_skill("unarmed", 20*i);
  set_skill("dodge", 20*i);
  set("max_sen",200*i);
  set("max_gee",200*i);
  set("max_gin",200*i);
  set("force",200*i);
  set("max_force",200*i);
  set("max_mana",200*i);
  set("force_factor",20*i);
  setup();
  carry_object("/d/obj/cloth/shoupiqun")->wear();
  carry_object("/d/qujing/pingding/obj/weapon")->wield();
}
