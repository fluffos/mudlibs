inherit NPC;
inherit F_VENDOR;

void create()
{
  string dir;
  set_name("老婆婆", ({"old woman", "woman"}));
  set("gender", "女性" );
  set("age", 65);
  set("long", "一位白发苍苍，满面风霜的老婆婆。\n");
  set("combat_exp", 100);
  set("attitude", "peaceful");
  set("per", 15);
/*
  dir = __DIR__;
  dir[strlen(dir)-4] = 0;
*/
  dir = "/d/qujing/nuerguo/";
  set("vendor_goods", ([
        "doufu"    : dir+"obj/qiongyao",
        "hulu"     : "/d/obj/food/hulu",
        "huasheng" : "/d/obj/food/huasheng",
      ]));
  setup();
  add_money ("silver", 2);  
}

void init()
{
  ::init();
  add_action("do_vendor_list", "list");
}

