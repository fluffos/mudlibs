// Room: /d/qujing/nuerguo/npool.c
inherit ROOM;

void create ()
{
  set ("short", "池塘边");
  set ("long", @LONG

池塘风景秀丽，塘边的空地上还长着几丛洁白的牡丹。



LONG);

  set("exits", ([ /* sizeof() == 1 */
  "north" : __DIR__"townc1",
]));

  set("outdoors", __DIR__"");

  setup();
}

void init()
{
  add_action("do_washface","makeup");
  add_action("do_washface","xilian");
  add_action("do_washface","huazhuang");
  add_action("do_washface","beauty");
}

int do_washface(string arg)
{
  object me=this_player();
  if (arg)
    return notify_fail("什么？\n");
  if (me->query("gender") == "男性")
    return notify_fail("你一个大男人在这涂脂抹粉也不脸红？\n");
  if ((int)me->query_skill("beauty", 1) > 200)
    return notify_fail("你这么漂亮还要化装呀？\n");
  else
  {
     if(me->query("sen") < (int)(me->query("max_sen")/3)){
          me->receive_damage("sen",(int)me->query("max_sen")*20/100);
          return notify_fail("你哪里还有精神化装？还是先休息一会儿吧！\n");
     }
     else {
          message_vision("$N捧起清澈的池水洗了洗脸，脸色顿时红润多了。\n", me);
          me->improve_skill("beauty", random(40));
          tell_object(me, "你领悟出一些有关驻颜术的窍门。\n");
     }
  }
  me->receive_damage("sen", (int)me->query("max_sen")*10/100);
  return 1;
}
