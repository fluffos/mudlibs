inherit ITEM;

void create() {
  set_name("黄金匣子", ({ "xiazi" }));
  set_weight(500);
  set_max_encumbrance(800);
  if (clonep()) {
    object ob;
    if (random(3) == 1) {
      seteuid(getuid());
      if (ob = new("/d/qujing/bibotan/obj/tooth"))
        ob->move(this_object());
    }
    set_default_object(__FILE__);
  } else {
    set("unit", "个");
    set("no_sell", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("long", "一个金光灿然的黄金匣子。\n");
    set("value", 50000);
  }
}

int is_container() { return 1; }
