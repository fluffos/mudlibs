inherit NPC;
inherit F_CLEAN_UP;

int random_walk();
void create() {
  int n;
  string *cname = ({ "官人", "艺人", "车夫", "路人", "市民", "和尚", "道士" });
  string *ename = ({ "guan ren", "yi ren", "che fu", "lu ren", "shi min", "he shang", "dao shi" });
  n = random(7);
  set_name(cname[n], ({ ename[n] }));
  //	set("long", @LONG
  //专卖劣质酒的酒保。
  //LONG);
  set("gender", "男性");
  set("age", random(25) + 15);
  set("attitude", "friendly");
  set("max_kee", 200);
  set("max_sen", 200);
  set("force", 100);
  set("max_force", 100);
  set("force_factor", 4);
  set("chat_chance", 5);
  set("chat_msg", ({
    (: random_walk :),
  }));

  set("combat_exp", 1000 + random(1000));

  set_skill("unarmed", 30);
  set_skill("dodge", 60);
  set_skill("parry", 10);
  //	set_skill("blade", 10);
  //	set("chat_chance_combat", 80);
  //	set("chat_msg_combat", ({
  //		(: cast_spell, "thunder" :),
  //	}) );

  setup();

  carry_object("/obj/money/silver");
  carry_object("/d/obj/cloth/linen")->wear();
}

int random_walk() {
  mapping exits;
  string *dirs;
  string thisdir;
  if (!mapp(exits = environment()->query("exits"))) {
    destruct(this_object());
    return 0;
  }
  dirs = keys(exits);
  thisdir = dirs[random(sizeof(dirs))];
  this_object()->set("last_dir", thisdir);
  command("go " + thisdir);
}
