// chicken.c
 
inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("烤乳猪", ({ "kao ruzhu", "ruzhu" }) );
        set_weight(150);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一只烤得金黄的脆皮小乳猪。\n");
                set("unit", "只");
                set("value", 6000);
                set("food_remaining", 5);
                set("food_supply", 100);
        }
}

