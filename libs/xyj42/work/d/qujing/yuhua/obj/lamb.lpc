// chicken.c
 
inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("烤全羊", ({ "kao quanyang", "quanyang" }) );
        set_weight(140);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一只烤得香透了的小羊咩。\n");
                set("unit", "只");
                set("value", 6000);
                set("food_remaining", 5);
                set("food_supply", 90);
        }
}

