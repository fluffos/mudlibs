// tianzhu/dalu1.c

#include <ansi.h>
#include <room.h>

inherit ROOM;

void init()
{
  add_action("do_enter","enter");
}

void create ()
{
  set ("short", "山坡");
  set ("long", @LONG
    
山坡上长着古树青藤，路上枯枝落叶遍地，坡边高高低低长着
灌木蒿草，夹杂着一些大大小小的岩石。坡下幽幽深深，不时
可见沟渠洞穴。

LONG);

  set("exits", ([ /* sizeof() == 2 */
  "northwest" : __DIR__"shanpo8",
  "southwest" : __DIR__"shanpo12",
]));
  set("outdoors",__DIR__);

  setup();
}

int do_enter(string arg)
{ 
 object me=this_player();
 int i = random(3);
 string *lus=({"tuxue1", "tuxue2", "tuxue3"});  
 message_vision("$N在蒿草石缝中扒开一个洞，钻了进去。\n",me);
 me->move("/d/qujing/maoying/"+lus[i]);
 return 1;
}

