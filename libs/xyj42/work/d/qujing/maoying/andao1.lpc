// tianzhu/dalu1.c
#include <ansi.h>
#include <room.h>

inherit ROOM;

void init() {
  add_action("do_go", "go");
}

void create() {
  set("short", "暗道");
  set("long", @LONG
  
……你似乎什么也看不清楚，只觉得暗道里湿气飕飕，但难以
探到前方的出路……

LONG);

  setup();
}

int do_go(string arg) {
  object me = this_player();
  int i = random(8);
  if (!arg) {
    message_vision("你要往哪个方向走？\n", me);
    return 1;
  }
  if (arg != "west") {
    if (arg != "east") {
      if (arg != "south") {
        if (arg != "north") {
          message_vision("这个方向没有出路！\n", me);
          return 1;
        }
      }
    }
  }
  if (i != 3) {
    message_vision("$N在黑暗中摸索，结果梆地撞到了石墙上。\n", me);
    return 1;
  }
  message_vision("$N在黑暗中找到一出口，挤了出去。\n", me);
  me->move("/d/qujing/maoying/shanpo3");
  return 1;
}
