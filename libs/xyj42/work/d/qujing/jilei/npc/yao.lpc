inherit NPC;

string *names = ({
  "骡怪",
  "犊怪",
  "獾怪",
  "狐怪",
  "猪怪",
  "獐怪",
  "羊怪",
  "鹿怪",
  "虎怪",
  "糜怪",
  "熊怪",
  "牛怪",
  "狼怪",
  "狈怪",
});

void create() {
  int i = random(9) + 1;
  set_name(names[random(sizeof(names))], ({ "yao guai", "yao", "guai" }));
  set("gender", "男性");
  set("age", 20);
  set("combat_exp", 30000 * i);
  set("per", 10);
  set_skill("parry", 30 * i);
  set_skill("unarmed", 60 * i);
  set_skill("dodge", 60 * i);
  set("max_sen", 200 * i);
  set("max_gee", 200 * i);
  set("max_gin", 200 * i);
  set("force", 200 * i);
  set("max_force", 200 * i);
  set("max_mana", 200 * i);
  set("force_factor", 20 * i);
  setup();
  carry_object("/d/obj/cloth/shoupiqun")->wear();
}
