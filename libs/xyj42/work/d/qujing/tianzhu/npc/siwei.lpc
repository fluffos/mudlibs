inherit NPC;

string *weapons = ({
  "/d/obj/weapon/fork/gangcha",
  "/d/obj/weapon/sword/changjian",
  "/d/obj/weapon/rake/gangpa",
  "/d/obj/weapon/spear/changqiang",
});
void create() {
  int i = random(sizeof(weapons));
  set_name("皇宫伺卫", ({ "si wei", "wei" }));
  set("gender", "男性");
  set("combat_exp", 140000 + random(80000));
  set("age", 40 + random(20));
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin", 700 + random(200));
  set("max_kee", 700 + random(200));
  set("max_sen", 1000 + random(700));
  set("max_force", 1200 + random(800));
  set("force", 1200 + random(800));
  set("max_mana", 1200 + random(800));
  set("force_factor", 150);
  set_skill("unarmed", 140 + random(40));
  set_skill("dodge", 140 + random(40));
  set_skill("parry", 140 + random(40));
  set_skill("blade", 140 + random(40));
  set_skill("sword", 140 + random(40));
  setup();
  carry_object(weapons[i])->wield();
  carry_object("/d/obj/armor/tiejia")->wear();
}
