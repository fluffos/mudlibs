inherit NPC;
#include <ansi.h>

void reset_balance(object me);

void create() {
  set_name("司徒晋宝", ({ "situ jinbao", "situ" }));
  set("gender", "男性");
  set("age", 48);
  set("attitude", "heroism");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin", 200 + random(100));
  set("max_kee", 200 + random(100));
  set("max_sen", 300 + random(100));
  set("combat_exp", 90000);
  set("max_force", 200);
  set("force", 200);
  set("force_factor", 15);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set_skill("blade", 30);
  setup();
  carry_object("/d/qujing/tianzhu/obj/baijie")->wear();
  carry_object("/d/qujing/tianzhu/obj/baipao")->wear();
}

void reset_balance(object me) {
  int myexp = me->query("combat_exp") / 1000;
  int allowed;
  string myid = me->query("id");
  string NPCNAME = this_object()->name();

  if (myexp < 1) myexp = 1;
  if (myexp > 100) myexp = 100;
  allowed = myexp * 10000000;  //each year can have 1000 gold, range 100-10000. 
  if (me->query("balance") > allowed) {
    me->set("balance_old", me->query("balance"));
    me->set("balance", allowed);
    tell_object(me, GRN + NPCNAME + "在你的耳边悄声说道：" + RANK_D->query_respect(me) +
      "，这、这真不知怎么说是好．．．\n" NOR);
    tell_object(me, GRN + NPCNAME + "在你的耳边悄声说道：" +
      "昨日有强人来打劫这里，你老的黄金给抢了不少！\n" NOR);
    tell_object(me, GRN + NPCNAME + "在你的耳边悄声说道：" +
      "若不是在下帮你老私藏了不少，你老的钱就全都泡汤了．．．\n" NOR);
  }
  return;
}

void accept_kill(object me) {
  object ob;
  if (is_fighting()) return;
  if (query("called")) return;

  command("help!");

  ob = present("xunluo guanbing");
  if (!ob) {
    seteuid(getuid());
    ob = new("/d/qujing/tianzhu/npc/siwei");
    ob->move(environment());
  }
  message_vision("\n忽然从门外冲进来个皇宫伺卫，对$N大喊一声“干什么？跑天竺来撒野！\n\n", me);
  ob->kill_ob(me);
  ob->set_leader(me);
  me->fight_ob(ob);
  set("called", 1);
  call_out("regenerate", 300);
}
int regenerate() {
  set("called", 0);
  return 1;
}
