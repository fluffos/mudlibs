inherit NPC;

inherit F_VENDOR;

void create() {
  set_name("魏大嫂", ({ "wei dasao", "wei" }));
  set("gender", "女性");
  set("age", 30);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin", 500);
  set("max_kee", 500);
  set("max_sen", 500);
  set("combat_exp", 5000);
  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_skill("parry", 20);
  set("vendor_goods", ([ /* sizeof() == 6 */
    "muer": "/d/qujing/tianzhu/obj/muer",
    "huacai": "/d/qujing/tianzhu/obj/huacai",
    "mogu": "/d/qujing/tianzhu/obj/mogu",
    "xiancai": "/d/qujing/tianzhu/obj/xiancai",
    "shansun": "/d/qujing/tianzhu/obj/shansun",
    "douya": "/d/qujing/tianzhu/obj/douya",
  ]));
  setup();
  carry_object("/d/obj/cloth/linen")->wear();
}
void init() { add_action("do_vendor_list", "list"); }
void accept_kill(object me) {
  object ob;
  if (is_fighting()) return;
  if (query("called")) return;

  command("help!");

  ob = present("xunluo guanbing");
  if (!ob) {
    seteuid(getuid());
    ob = new("/d/qujing/tianzhu/npc/siwei");
    ob->move(environment());
  }
  message_vision("\n忽然从门外冲进来个皇宫伺卫，对$N大喊一声“干什么？跑天竺来撒野！\n\n", me);
  ob->kill_ob(me);
  ob->set_leader(me);
  me->fight_ob(ob);
  set("called", 1);
  call_out("regenerate", 300);
}
int regenerate() {
  set("called", 0);
  return 1;
}
