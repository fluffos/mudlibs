inherit NPC;

inherit F_VENDOR;

void create()
{
       set_name("郭三娘", ({"guo sanniang", "guo"}));
       set("gender", "女性");
       set("age", 40);
       set("attitude", "friendly");
     set("shen_type", 1);
  set("people", "people");
  set("max_gin",200+random(100));
  set("max_kee",400+random(100));
  set("max_sen",200+random(100));
  set("combat_exp",2000);
  set_skill("unarmed", 30);
  set("vendor_goods",([ /* sizeof() == 6 */
  "toujin" : "/d/qujing/tianzhu/obj/toujin",
  "baibu" : "/d/qujing/tianzhu/obj/baibu",
  "pitan" : "/d/qujing/tianzhu/obj/pitan",
  "huabu" : "/d/qujing/tianzhu/obj/huabu",
])); 
  setup();
  carry_object("/d/qujing/tianzhu/obj/yinjie")->wear();
  carry_object("/d/obj/cloth/skirt")->wear();
}
void init() { add_action("do_vendor_list", "list"); }
void accept_kill(object me)
{       object ob;
        if(is_fighting()) return;
        if( query("called") ) return;

        command("help!");

        ob=present("xunluo guanbing");
        if( !ob) {
                seteuid(getuid());
                ob=new("/d/qujing/tianzhu/npc/siwei");
                ob->move(environment());
        }
        message_vision("\n忽然从门外冲进来个皇宫伺卫，对$N大喊一声“干什么？跑天竺来撒野！\n\n",me);        
        ob->kill_ob(me);
        ob->set_leader(me);
        me->fight_ob(ob);
        set("called", 1);
        call_out("regenerate", 300);
}
int regenerate()
{
        set("called", 0);
        return 1;
}
