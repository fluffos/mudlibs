inherit NPC;

inherit F_VENDOR;

void create()
{
       set_name("张妈", ({"zhang ma", "zhang"}));
       set("gender", "女性");
       set("age", 40);
       set("attitude", "friendly");
     set("shen_type", 1);
  set("people", "people");
  set("max_gin",200);
  set("max_kee",500);
  set("max_sen",200);
  set("combat_exp",4000);
  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_skill("parry", 20);
  set("vendor_goods",([ /* sizeof() == 6 */
  "youzi" : "/d/qujing/tianzhu/obj/youzi",
  "juzi" : "/d/qujing/tianzhu/obj/juzi",
  "fanmugua" : "/d/qujing/tianzhu/obj/fanmugua",
  "bailangua" : "/d/qujing/tianzhu/obj/bailangua",
  "ganzi" : "/d/qujing/tianzhu/obj/ganzi",
  "mugua" : "/d/qujing/tianzhu/obj/mugua",
])); 
  setup();
  carry_object("/d/qujing/tianzhu/obj/baojie")->wear();
  carry_object("/d/obj/cloth/skirt")->wear();
}
void init() { add_action("do_vendor_list", "list"); }
void accept_kill(object me)
{       object ob;
        if(is_fighting()) return;
        if( query("called") ) return;

        command("help!");

        ob=present("xunluo guanbing");
        if( !ob) {
                seteuid(getuid());
                ob=new("/d/qujing/tianzhu/npc/siwei");
                ob->move(environment());
        }
        message_vision("\n忽然从门外冲进来个皇宫伺卫，对$N大喊一声“干什么？跑天竺来撒野！\n\n",me);        
        ob->kill_ob(me);
        ob->set_leader(me);
        me->fight_ob(ob);
        set("called", 1);
        call_out("regenerate", 300);
}
int regenerate()
{
        set("called", 0);
        return 1;
}
