inherit NPC;

string *names = ({
  "诵经僧人",
  "修禅僧人",
  "出勤僧人",
  "传法僧人",
  "俗家僧人",
});

string *ids = ({
  "he shang",
  "he shang",
  "he shang",
  "he shang",
  "he shang",
});

void create() {
  int i = random(sizeof(names));
  set_name(names[i], ({ ids[i] }));
  set("gender", "男性");
  set("combat_exp", 30000 + random(10000));
  set("age", 40 + random(20));
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("force_factor", 2);
  set("max_gin", 300);
  set("max_kee", 300);
  set("max_sen", 300);
  set("max_force", 400);
  set("max_mana", 400);
  set_skill("unarmed", 10 + random(90));
  set_skill("dodge", 10 + random(90));
  set_skill("parry", 10 + random(90));
  setup();
  carry_object("/d/obj/cloth/sengyi")->wear();
}
