inherit NPC;

void create()
{
       set_name("公主", ({"gong zhu", "princess"}));
//       set("long",@LONG
// 一个凶相毕露的山妖。
// LONG);
       set("gender", "女性");
       set("age", 20);
       set("attitude", "peaceful");
     set("shen_type", 1);
  set("people", "race");
  set("max_gin",1200);
  set("max_kee",1200);
  set("max_sen",1200);
  set("force_factor",120);
  set("mana_factor",120);
  set("max_force",1200);
  set("force",1200);
  set("max_mana",1200);
  set("mana",1200);
  set("combat_exp",900000);
  set_skill("baihua-zhang", 100);
  set_skill("parry", 200);
  set_skill("force", 100);
  set_skill("dodge", 200);
  set_skill("staff", 100);
  set_skill("spells", 100);
  set_skill("unarmed", 100);
  set_skill("moondance", 150);
  set_skill("moonforce", 100);
  set_skill("moonshentong",100);
  map_skill("force","moonforce");
  map_skill("unarmed","baihua-zhang");
  map_skill("spells","moonshentong");
  map_skill("dodge","moondance");
  setup();
  carry_object("/d/obj/cloth/gongpao")->wear();
  carry_object("/d/qujing/tianzhu/obj/zuanjie")->wear();
  carry_object("/d/qujing/tianzhu/obj/pixie")->wear();
}
void unconcious ()
{
 object me = this_object();
 object who = this_player();
 me->set("kee", (int)me->query("max_kee")/2 );
 me->set("eff_kee", (int)me->query("max_kee"));
 me->set("sen", (int)me->query("max_sen")/2 );
 me->set("eff_sen", (int)me->query("max_sen"));
 message_vision("公主往旁边一跳，一转眼已无踪无影！\n",me);
 switch (random(3))
  {
    case 0:
      { if ((string)(environment(who))!="/d/qujing/maoying/tuxue1") 
         me->move("/d/qujing/maoying/tuxue1"); 
        else
         me->move("/d/qujing/maoying/tuxue2");
        break; }
    case 1:
      { if ((string)(environment(who))!="/d/qujing/maoying/tuxue2") 
         me->move("/d/qujing/maoying/tuxue2"); 
        else
         me->move("/d/qujing/maoying/tuxue3");
        break; }
    case 2:
      { if ((string)(environment(who))!="/d/qujing/maoying/tuxue3") 
         me->move("/d/qujing/maoying/tuxue3"); 
        else
         me->move("/d/qujing/maoying/tuxue1");
        break; }
  }
}   
void die ()
{
  object me = this_object();
  object who = query_temp("my_killer");
  message_vision("公主现了原形，竟是一只玉兔。\n",me);
  message_vision("只听远远地传来太阴星君的怒斥：“玉兔儿！”\n\n",me);
  message_vision("玉兔闻声乖乖地向外跳去。\n",me);
  who->set_temp("obstacle/tianzhu_killed",1);
  destruct(me); 
}
int accept_fight(object ob)
{
 ob->apply_condition("killer", 100);
 kill_ob(ob);
 return 1;
}

void kill_ob (object ob)
{
  object me = this_object();
  set_temp("my_killer",ob);
  call_out ("checking",1,me,ob);  
  ::kill_ob(ob);
}


void checking (object me, object ob)
{
  if (me->is_fighting())
  {
   if ((int)me->query("kee") < 700 )
   {
    message_vision("公主往旁边一跳，一转眼已无踪无影！\n",me);
    switch (random(3))
    {
    case 0:
      { if ((string)(environment(ob))!="/d/qujing/maoying/tuxue1") 
         me->move("/d/qujing/maoying/tuxue1"); 
        else
         me->move("/d/qujing/maoying/tuxue2");
        break; }
    case 1:
      { if ((string)(environment(ob))!="/d/qujing/maoying/tuxue2") 
         me->move("/d/qujing/maoying/tuxue2"); 
        else
         me->move("/d/qujing/maoying/tuxue3");
        break; }
    case 2:
      { if ((string)(environment(ob))!="/d/qujing/maoying/tuxue3") 
         me->move("/d/qujing/maoying/tuxue3"); 
        else
         me->move("/d/qujing/maoying/tuxue1");
        break; }
    }
   }   
   remove_call_out ("checking");  
   call_out ("checking",1,me,ob);  
  }
}
