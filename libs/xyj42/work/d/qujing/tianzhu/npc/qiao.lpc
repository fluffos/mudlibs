inherit NPC;

inherit F_VENDOR;

void create()
{
       set_name("乔老板", ({"qiao laoban", "qiao"}));
       set("gender", "男性");
       set("age", 40);
       set("attitude", "heroism");
     set("shen_type", 1);
  set("people", "people");
  set("max_gin",500);
  set("max_kee",500);
  set("max_sen",500);
  set("combat_exp",10000);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_skill("parry", 40);
  set_skill("blade", 40);
  set("chat_chance", 6);
  set("chat_msg", ({ (: random_move :) }));
  setup();
  carry_object("/d/obj/cloth/linen")->wear();
  carry_object("/d/obj/weapon/blade/caidao")->wield();
}
void init() { add_action("do_vendor_list", "list"); }
