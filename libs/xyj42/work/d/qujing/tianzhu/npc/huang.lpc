inherit NPC;

inherit F_VENDOR;

void create() {
  set_name("黄汤", ({ "huang tang", "huang" }));
  set("gender", "男性");
  set("age", 38);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin", 450 + random(100));
  set("max_kee", 450 + random(100));
  set("max_sen", 450 + random(100));
  set("combat_exp", 90000);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_skill("parry", 40);
  set("vendor_goods", ([ /* sizeof() == 6 */
    "jiuzhong": "/d/qujing/tianzhu/obj/jiuzhong",
    "jiuguan": "/d/qujing/tianzhu/obj/jiuguan",
    "jiuhu": "/d/qujing/tianzhu/obj/jiuhu",
  ]));
  setup();
  carry_object("/d/qujing/tianzhu/obj/baipao")->wear();
}
void init() { add_action("do_vendor_list", "list"); }

void accept_kill(object me) {
  object ob;
  if (is_fighting()) return;
  if (query("called")) return;

  command("help!");

  ob = present("xunluo guanbing");
  if (!ob) {
    seteuid(getuid());
    ob = new("/d/qujing/tianzhu/npc/siwei");
    ob->move(environment());
  }
  message_vision("\n忽然从门外冲进来个皇宫伺卫，对$N大喊一声“干什么？跑天竺来撒野！\n\n", me);
  ob->kill_ob(me);
  ob->set_leader(me);
  me->fight_ob(ob);
  set("called", 1);
  call_out("regenerate", 300);
}
int regenerate() {
  set("called", 0);
  return 1;
}
