inherit NPC;

void create()
{
       set_name("乐老板", ({"le laoban", "le"}));
       set("gender", "男性");
       set("age", 48);
       set("attitude", "heroism");
     set("shen_type", 1);
  set("people", "people");
  set("max_gin",200+random(100));
  set("max_kee",200+random(100));
  set("max_sen",200+random(100));
  set("combat_exp",90000);
  set("max_force",200);
  set("force",200);
  set("force_factor",15);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set_skill("blade", 30);
  setup();
  carry_object("/d/qujing/tianzhu/obj/longguan")->wear();
  carry_object("/d/qujing/tianzhu/obj/huapao")->wear();
}

void accept_kill(object me)
{       object ob;
        if(is_fighting()) return;
        if( query("called") ) return;

        command("help!");

        ob=present("xunluo guanbing");
        if( !ob) {
                seteuid(getuid());
                ob=new("/d/qujing/tianzhu/npc/siwei");
                ob->move(environment());
        }
        message_vision("\n忽然从门外冲进来个皇宫伺卫，对$N大喊一声“干什么？跑天竺来撒野！\n\n",me);        
        ob->kill_ob(me);
        ob->set_leader(me);
        me->fight_ob(ob);
        set("called", 1);
        call_out("regenerate", 300);
}
int regenerate()
{
        set("called", 0);
        return 1;
}
