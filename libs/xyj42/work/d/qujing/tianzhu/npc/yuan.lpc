inherit NPC;

void create()
{
       set_name("元先生", ({"yuan xiansheng", "yuan"}));
       set("gender", "男性");
       set("age", 30);
       set("attitude", "heroism");
     set("shen_type", 1);
  set("people", "people");
  set("max_gin",200+random(100));
  set("max_kee",200+random(100));
  set("max_sen",200+random(100));
  set("combat_exp",10000);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_skill("parry", 40);
  set_skill("blade", 40);
  setup();
  carry_object("/d/obj/cloth/changpao")->wear();
}
