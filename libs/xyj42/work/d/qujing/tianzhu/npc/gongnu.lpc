  setup();
  carry_object("/d/qujing/tianzhu/obj/hongqun")->wear();
  carry_object("/d/qujing/tianzhu/obj/jinjie")->wear();
  carry_object("/d/qujing/tianzhu/obj/fengguan")->wear();
