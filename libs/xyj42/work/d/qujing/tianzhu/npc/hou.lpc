inherit NPC;

inherit F_VENDOR;

void create() {
  set_name("候郎中", ({ "hou langzhong", "hou" }));
  set("gender", "男性");
  set("age", 48);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin", 350 + random(100));
  set("max_kee", 350 + random(100));
  set("max_sen", 350 + random(100));
  set("combat_exp", 50000);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set("vendor_goods", ([
    "dan": "/d/qujing/tianzhu/obj/dan",
    "wan": "/d/qujing/tianzhu/obj/wan",
    "fen": "/d/qujing/tianzhu/obj/fen",
  ]));
  setup();
  carry_object("/d/qujing/tianzhu/obj/simao")->wear();
  carry_object("/d/qujing/tianzhu/obj/baipao")->wear();
}
void init() { add_action("do_vendor_list", "list"); }

void accept_kill(object me) {
  object ob;
  if (is_fighting()) return;
  if (query("called")) return;

  command("help!");

  ob = present("xunluo guanbing");
  if (!ob) {
    seteuid(getuid());
    ob = new("/d/qujing/tianzhu/npc/siwei");
    ob->move(environment());
  }
  message_vision("\n忽然从门外冲进来个皇宫伺卫，对$N大喊一声“干什么？跑天竺来撒野！\n\n", me);
  ob->kill_ob(me);
  ob->set_leader(me);
  me->fight_ob(ob);
  set("called", 1);
  call_out("regenerate", 300);
}
int regenerate() {
  set("called", 0);
  return 1;
}
