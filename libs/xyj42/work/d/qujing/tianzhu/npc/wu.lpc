inherit NPC;

inherit F_VENDOR;

void create() {
  set_name("吴老板", ({ "wu lanban", "wu" }));
  set("gender", "男性");
  set("age", 40);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin", 200);
  set("max_kee", 200);
  set("max_sen", 500);
  set("max_force", 200);
  set("force", 200);
  set("force_factor", 15);
  set("combat_exp", 10000);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set_skill("blade", 30);
  set("vendor_goods", ([ /* sizeof() == 6 */
    "baijie": "/d/qujing/tianzhu/obj/baijie",
    "zuanjie": "/d/qujing/tianzhu/obj/zuanjie",
    "yinjie": "/d/qujing/tianzhu/obj/yinjie",
    "baojie": "/d/qujing/tianzhu/obj/baojie",
    "jinjie": "/d/qujing/tianzhu/obj/jinjie",
  ]));
  setup();
  carry_object("/d/qujing/tianzhu/obj/pixue")->wear();
  carry_object("/d/qujing/tianzhu/obj/piyi")->wear();
  carry_object("/d/qujing/tianzhu/obj/longguan")->wear();
}
void init() { add_action("do_vendor_list", "list"); }
void accept_kill(object me) {
  object ob;
  if (is_fighting()) return;
  if (query("called")) return;

  command("help!");

  ob = present("xunluo guanbing");
  if (!ob) {
    seteuid(getuid());
    ob = new("/d/qujing/tianzhu/npc/siwei");
    ob->move(environment());
  }
  message_vision("\n忽然从门外冲进来个皇宫伺卫，对$N大喊一声“干什么？跑天竺来撒野！\n\n", me);
  ob->kill_ob(me);
  ob->set_leader(me);
  me->fight_ob(ob);
  set("called", 1);
  call_out("regenerate", 300);
}
int regenerate() {
  set("called", 0);
  return 1;
}
