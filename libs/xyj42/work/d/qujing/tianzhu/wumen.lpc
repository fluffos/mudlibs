// tianzhu/jiedao.c

inherit ROOM;

void create() {
  set("short", "午门");
  set("long", @LONG

一道长长的琉璃瓦檐石墙将王宫围起，里面可以看见雄伟的宫
殿楼阁。宫门为一巨大的铁钉嵌铜木门，高大的门楼上有两个
烫金大字：午门。

LONG);

  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "zhaoyang",
    "south": __DIR__ "jiedao45",
  ]));
  set("objects", ([ /* sizeof() == 4 */
    __DIR__ "npc/siwei": 2,
    __DIR__ "npc/bing": 2,
  ]));
  setup();
}
int valid_leave(object me, string dir) {
  if (dir == "north" && !interactive(me))
    return notify_fail("伺卫一把推开了你。说道：皇家重地，闲人免进！\n");
  if ((dir == "north") && ((int)me->query_temp("obstacle/tianzhu_thrown") != 1))
    return notify_fail("皇宫伺卫将枪一横，威严地喝了一声：禁行！\n");
  return ::valid_leave(me, dir);
}
