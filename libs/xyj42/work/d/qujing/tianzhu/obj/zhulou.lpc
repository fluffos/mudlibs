inherit EQUIP;

void create()
{
  set_name("细条竹篓", ({ "zhu lou","zhulou","lou"}) );
  set_weight(500);
  set_max_encumbrance(8000);
  set("max_items",12);
  set("unit", "只");
  set("long", "这是一只漂亮的细条竹篓。\n");
  set("value", 2000);
  set("material", "wood");
}

int is_container() { return 1; }
int query_autoload() { return 1; }
