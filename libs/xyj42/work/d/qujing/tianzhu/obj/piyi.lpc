#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("犀牛皮衣", ({"xiniu piyi","pi yi"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
//                set("long", "一块布披毯，可以披在身上。\n");
                set("material", "leather");
                set("value", 50000);
                set("armor_prop/armor", 1);
        }
        setup();
}
