#include <armor.h>

inherit HEAD;

void create() {
  set_name("白布", ({ "bai bu", "bu" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "一块大白布。\n");
    set("material", "cloth");
    set("value", 40);
    set("armor_prop/armor", 0);
  }
  setup();
}
