#include <armor.h>

inherit HEAD;

void create() {
  set_name("牛皮帽", ({ "niu pimao", "pimao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    //                set("long", "一块布披毯，可以披在身上。\n");
    set("material", "leather");
    set("value", 2000);
    set("armor_prop/armor", 2);
  }
  setup();
}
