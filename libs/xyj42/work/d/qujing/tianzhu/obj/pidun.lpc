#include <armor.h>

inherit SHIELD;

void create() {
  set_name("厚牛皮盾", ({ "houniu pidun", "pidun" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    //                set("long", "一块布披毯，可以披在身上。\n");
    set("material", "leather");
    set("value", 20000);
    set("armor_prop/armor", 5);
  }
  setup();
}
