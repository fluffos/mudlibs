#include <armor.h>

inherit HEAD;

void create()
{
        set_name("铁盔", ({"tie kui","kui"}));
        set_weight(6000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顶");
                set("long", "一顶结实的硬木盔，上面绘着云纹。\n");
                set("material", "wood");
                set("value", 6000);
                set("armor_prop/armor", 10);
        }
        setup();
}
