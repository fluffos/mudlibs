#include <armor.h>

inherit HEAD;

void create()
{
        set_name("黑丝帽", ({"si mao","mao"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顶");
                set("long", "一顶轻便的黑色丝帽。\n");
                set("material", "cloth");
                set("value", 100);
                set("armor_prop/armor", 1);
        }
        setup();
}
