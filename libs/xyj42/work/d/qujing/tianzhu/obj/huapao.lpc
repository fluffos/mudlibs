#include <armor.h>
inherit CLOTH;

void create() {
  set_name("大花袍", ({ "hua pao", "pao" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件印着大花的棉丝袍，宽大舒适。\n");
    set("unit", "件");
    set("value", 4000);
    set("material", "cloth");
    set("armor_prop/armor", 2);
    set("armor_prop/dodge", 0);
  }
  setup();
}
