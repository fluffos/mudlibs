//丹药
#include <ansi.h>
inherit ITEM;

int do_eat(string);
void init();

void init()
{                                            
        add_action("do_eat", "eat");
}

void create()
{
        set_name("发霉的养身丹" , ({"yangshen dan", "dan"}));
        set_weight(20);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "一颗长霉的养身丹，上面全是绿毛。\n");
                set("value", 0);
        }
        setup();
}

int do_eat(string arg)
{
        object me = this_player();

        if (!id(arg))
                return notify_fail("你要吃什么？\n");
        message_vision("发霉的丹药也吃嘛？\n" NOR, me);
        return 1;
}

