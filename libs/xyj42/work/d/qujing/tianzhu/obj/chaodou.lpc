//bailangua

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("五香炒豆", ({"chao dou", "dou"}));
        set_weight(40);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一包喷香的炒豆子。\n");
                set("unit", "包");
                set("value", 110);
                set("food_remaining", 2);
                set("food_supply", 10);
        }
}
