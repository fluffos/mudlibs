//丹药
inherit ITEM;

int do_eat(string);
void init();

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("筋骨粉", ({ "jingu fen", "fen" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "包");
    set("long", "一包灰土色的药粉。\n");
    set("value", 3000);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if ((int)me->query("eff_kee") == (int)me->query("max_kee"))
    return notify_fail("你现在不需要用筋骨粉。\n");
  if ((int)me->query("eff_kee") + (int)me->query("max_kee") / 100 > (int)me->query("max_kee")) {
    me->set("eff_kee", (int)me->query("max_kee"));
  } else {
    me->add("eff_kee", (int)me->query("max_kee") / 100);
  }
  message_vision("$N咽下一包筋骨粉，顿时出了一身热汗。\n", me);
  destruct(this_object());
  return 1;
}
