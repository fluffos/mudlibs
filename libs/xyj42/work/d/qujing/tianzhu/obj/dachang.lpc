#include <armor.h>
inherit CLOTH;

void create()
{
  set_name("虎皮大氅", ({ "hupi dachang", "dachang" }) );
  set_weight(2700);
  if( clonep() )
    set_default_object(__FILE__);
  else {
//    set("long", "一件白色的棉丝袍，宽大舒适。\n");
    set("unit", "件");
    set("value",16000);
    set("material", "cloth");
    set("armor_prop/armor", 2);
    set("armor_prop/dodge", 0);
  }
  setup();
}

