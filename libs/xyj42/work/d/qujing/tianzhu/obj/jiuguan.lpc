inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("水酒罐", ({ "jiu guan", "guan" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个装水酒的大酒罐。\n");
    set("unit", "个");
    set("value", 160);
    set("max_liquid", 10);
  }

  // because a container can contain different liquid
  // we set it to contain water at the beginning
  set("liquid", ([
    "type": "alcohol",
    "name": "水酒",
    "remaining": 10,
    "drunk_supply": 5,
  ]));
}
