// xbc.c 小白菜

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("豆芽", ({"dou ya"}));
        set_weight(40);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一把刚发出的豆芽。\n");
                set("unit", "把");
                set("value", 70);
                set("food_remaining", 4);
                set("food_supply", 10);
        }
}

