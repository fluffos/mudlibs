#include <armor.h>
inherit CLOTH;

void create()
{
  set_name("官袍", ({ "guan pao", "pao" }) );
  set_weight(2700);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("long", "一件绣着花纹的棉丝官袍。\n");
    set("unit", "件");
    set("value", 1000);
    set("material", "cloth");
    set("armor_prop/armor", 7);
    set("armor_prop/dodge", 5);
  }
  setup();
}

