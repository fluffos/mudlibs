inherit EQUIP;

void create() {
  set_name("烫花竹篮", ({ "zhu lan", "zhulan", "lan" }));
  set_weight(500);
  set_max_encumbrance(8000);
  set("max_items", 12);
  set("unit", "只");
  set("long", "这是一只漂亮的烫花竹篮。\n");
  set("value", 2000);
  set("material", "wood");
}

int is_container() { return 1; }
int query_autoload() { return 1; }
