#include <armor.h>

inherit HEAD;

void create() {
  set_name("披毯", ({ "pi tan", "tan" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "一块布披毯，可以披在身上。\n");
    set("material", "cloth");
    set("value", 130);
    set("armor_prop/armor", 0);
  }
  setup();
}
