#include <armor.h>

inherit FINGER;

void create() {
  set_name("银戒指", ({ "yin jie", "jie", "ring" }));
  set("weight", 40);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 2000);
    set("material", "silver");
    set("armor_prop/armor", 1);
  }
  setup();
}
