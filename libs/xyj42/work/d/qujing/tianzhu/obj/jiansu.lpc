//bailangua

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("小煎酥", ({"jian su", "su"}));
        set_weight(40);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一盘香脆的小煎酥。\n");
                set("unit", "盘");
                set("value", 140);
                set("food_remaining", 5);
                set("food_supply", 5);
        }
}
