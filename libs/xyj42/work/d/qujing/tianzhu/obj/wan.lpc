//丹药
inherit ITEM;

int do_eat(string);
void init();

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("济神丸", ({ "jishen wan", "wan" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗清凉略苦的药丸．\n");
    set("value", 3000);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if ((int)me->query("eff_sen") == (int)me->query("max_sen"))
    return notify_fail("你现在不需要用济神丸。\n");
  if ((int)me->query("eff_sen") + (int)me->query("max_sen") / 100 > (int)me->query("max_sen")) {
    me->set("eff_sen", (int)me->query("max_sen"));
  } else {
    me->add("eff_sen", (int)me->query("max_sen") / 100);
  }
  message_vision("$N咽下一颗济神丸，精神焕发。\n", me);
  destruct(this_object());
  return 1;
}
