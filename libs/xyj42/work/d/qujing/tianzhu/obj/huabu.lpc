#include <armor.h>

inherit HEAD;

void create()
{
        set_name("花布", ({"hua bu","bu"}));
        set_weight(6000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long", "一块大花布。\n");
                set("material", "cloth");
                set("value", 50);
                set("armor_prop/armor", 0);
        }
        setup();
}
