inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("瓷酒盅", ({ "jiu zhong", "zhong" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个盛热酒的瓷酒盅。\n");
    set("unit", "个");
    set("value", 70);
    set("max_liquid", 10);
  }

  // because a container can contain different liquid
  // we set it to contain water at the beginning
  set("liquid", ([
    "type": "alcohol",
    "name": "热酒",
    "remaining": 8,
    "drunk_supply": 5,
  ]));
}
