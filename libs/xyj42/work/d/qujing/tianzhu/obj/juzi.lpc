//bailangua

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("桔子", ({"ju zi", "ju"}));
        set_weight(40);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一包黄橙橙的桔子。\n");
                set("unit", "包");
                set("value", 100);
                set("food_remaining", 4);
                set("food_supply", 10);
        }
}
