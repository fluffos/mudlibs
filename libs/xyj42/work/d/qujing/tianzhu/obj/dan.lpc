//丹药
#include <ansi.h>
inherit ITEM;

int do_eat(string);
void init();

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("养身丹", ({ "yangshen dan", "dan" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗黑油油的养身丹。\n");
    set("value", 1000);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  me->set("food", 1000 + random(300));
  me->set("water", 1000 + random(200));
  message_vision(HIG "\n$N捏起一颗养身丹送进嘴里吞下。\n" NOR, me);
  message_vision("顿时$N觉得腹中生热，飘飘欲仙！\n", me);
  destruct(this_object());
  return 1;
}
