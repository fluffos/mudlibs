#include <armor.h>

inherit BOOTS;

void create()
{
        set_name("水牛皮靴", ({"shuiniu pixue","pixue"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
//                set("long", "一块布披毯，可以披在身上。\n");
                set("material", "leather");
                set("value", 650);
                set("armor_prop/armor", 1);
        }
        setup();
}
