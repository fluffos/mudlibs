#include <armor.h>

inherit HEAD;

void create()
{
        set_name("布头巾", ({"tou jin","jin"}));
        set_weight(6000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顶");
                set("long", "一块大的布头巾。\n");
                set("material", "cloth");
                set("value", 50);
                set("armor_prop/armor", 1);
        }
        setup();
}
