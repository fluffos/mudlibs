#include <weapon.h>

inherit EQUIP;

void create() {
  set_name("青石花瓶", ({ "hua ping", "huaping", "ping", "vase" }));
  set_weight(500);
  set_max_encumbrance(8000);
  set("max_items", 12);
  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("unit", "只");
    set("long", "这是一只绘着粉红小花的青石花瓶。\n");
    set("value", 20000);
  }
  setup();
}

int is_container() { return 1; }
int query_autoload() { return 1; }
