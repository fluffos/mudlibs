#include <weapon.h>

void create() {
  set_name("白瓷花盆", ({ "hua pen", "huapen", "pen" }));
  set_weight(500);
  set_max_encumbrance(8000);
  set("max_items", 4);
  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("unit", "只");
    set("long", "这是一只白底蓝花的瓷花盆。\n");
    set("value", 5000);
  }
  setup();
}

int is_container() { return 1; }
int query_autoload() { return 1; }
