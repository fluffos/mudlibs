// xbc.c 小白菜

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("苋菜", ({ "xiancai", "xian cai", "cai" }));
  set_weight(40);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一把极为新鲜的红苋菜。\n");
    set("unit", "把");
    set("value", 80);
    set("food_remaining", 2);
    set("food_supply", 10);
  }
}
