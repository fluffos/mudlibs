#include <armor.h>

inherit BOOTS;

void create()
{
        set_name("云靴", ({"yun xue","xue"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
                set("long", "一双高腰厚底的云靴。\n");
                set("material", "cloth");
                set("value", 120);
                set("armor_prop/dodge", 1);
        }
        setup();
}
