#include <weapon.h>

inherit WHIP;

void create()
{
        set_name("竹鞭", ({"zhu bian", "bian", "rake"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("value", 1000);
                set("material", "wood");
                set("long", "这是一条长长的竹鞭，是练武时用的．\n");
                set("wield_msg", "$N抽出一柄$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n插入腰后．\n");
        }
        init_whip(15);
        setup();
}
