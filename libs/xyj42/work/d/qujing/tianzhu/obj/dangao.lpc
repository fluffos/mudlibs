//bailangua

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("小蛋糕", ({"dan gao", "gao"}));
        set_weight(40);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一小盘切好的的蛋糕。\n");
                set("unit", "小盘");
                set("value", 90);
                set("food_remaining", 2);
                set("food_supply", 10);
        }
}
