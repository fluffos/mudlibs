#include <armor.h>
inherit CLOTH;

void create()
{
  set_name("翡红裙", ({ "hong qun", "qun" }) );
  set_weight(2700);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("long", "一条翡红色长裙，配着小金穗。\n");
    set("unit", "件");
    set("value", 20000);
    set("material", "cloth");
    set("armor_prop/armor", 5);
    set("armor_prop/dodge", 5);
  }
  setup();
}

