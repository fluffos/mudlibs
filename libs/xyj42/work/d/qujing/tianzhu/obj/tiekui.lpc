#include <armor.h>

inherit HEAD;

void create() {
  set_name("铁盔", ({ "tie kui", "kui" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    set("long", "一顶沉重的大铁盔，顶上有一尖柄.\n");
    set("material", "steel");
    set("value", 10000);
    set("armor_prop/armor", 15);
  }
  setup();
}
