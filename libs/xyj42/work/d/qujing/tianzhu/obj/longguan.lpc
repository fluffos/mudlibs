#include <armor.h>
inherit HEAD;

void create() {
  set_name("金龙冠", ({ "jin longguan", "longguan" }));
  set_weight(2700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一顶丝质的金色软冠，上面绣着金龙。\n");
    set("unit", "件");
    set("value", 8000);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/dodge", 0);
  }
  setup();
}
