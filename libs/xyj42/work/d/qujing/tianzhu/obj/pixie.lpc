#include <armor.h>

inherit BOOTS;

void create() {
  set_name("鹿皮鞋", ({ "lupi xie", "pi xie" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", "一双软身硬底的鹿皮鞋。\n");
    set("material", "leather");
    set("value", 4000);
    set("armor_prop/armor", 2);
  }
  setup();
}
