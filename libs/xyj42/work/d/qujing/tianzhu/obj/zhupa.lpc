#include <weapon.h>

inherit RAKE;

void create()
{
        set_name("竹耙", ({"zhu pa", "pa", "rake"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 1000);
                set("material", "wood");
                set("long", "这是一柄长长的竹耙，是练武时用的．\n");
                set("wield_msg", "$N抽出一柄$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n插入腰后．\n");
        }
        init_rake(15);
        setup();
}
