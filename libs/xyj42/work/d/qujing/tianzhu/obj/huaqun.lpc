#include <armor.h>
inherit CLOTH;

void create()
{
  set_name("水印花裙", ({ "hua qun", "qun" }) );
  set_weight(300);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("long", "一条淡色水印花裙。\n");
    set("unit", "条");
    set("value", 5000);
    set("material", "cloth");
    set("armor_prop/armor", 0);
  }
  setup();
}

