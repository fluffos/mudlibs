// rewritten by tutu on 04.16.1998

inherit NPC;
string chinese_daoxing(int gain);
string give_fajian(object me);

void create()
{
  set_name("白髯土地", ({"tu di", "tudi"}));
  set("gender", "男性");
  set("age", 100);
  set("attitude", "friendly");
  set("combat_exp", 250000);
  set("per", 25);
  set_skill("dodge", 80);
  set_skill("force", 80);
  set_skill("parry", 80);
  set_skill("spells",80);
  set_skill("stick", 80);
  set("max_sen",600);
  set("max_gee",600);
  set("max_gin",600);
  set("force",800);
  set("max_force",800);
  set("max_mana",800);
  set("mana",800);
  set("force_factor",25);
  set("inquiry", ([ /* sizeof() == 7 */
  "宝" : "老夫有一法简，乃一锦一禅师所赠。\n",
  "here" : "这儿是隐雾山，亦有连环洞在此。\n",
  "name" : "隐雾山土地也，老夫别无他物，只有一宝。\n",
  "法简" : (: give_fajian :),
  "连环洞" : "连环洞在隐雾山下连环相衔，有两个入口也。\n",
  "fajian" : (: give_fajian :),
  "隐雾山" : "隐雾山乃有连环洞之去处，多加小心为是。\n",
]));
  setup();
  carry_object("/d/obj/cloth/choupao")->wear();

}

void announce_success (object who)
{
  int i=random(2000);
  if (who->query("combat_exp") < 100000)
    return;
  if (who->query("obstacle/yinwu") == "done")
    return;
  if (! who->query_temp("obstacle/yinwu_fajian"))
    return;
  if (! who->query_temp("obstacle/yinwu_yaowang"))
    return;
  i = i + 30000;
  if ((int)who->query("obstacle")==0)
  who->set("obstacle/number",1);
  else
  who->add("obstacle/number",1);
  who->set("obstacle/yinwu","done");
  who->add("combat_exp",i);
  who->delete_temp("obstacle/yinwu_fajian");
  who->delete_temp("obstacle/yinwu_yaowang");
  command("chat "+who->query("name")+"隐雾山显神通，连环洞杀豹子精！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,"你赢得了"+chinese_daoxing(i)+"的道行！\n");
  who->save();
}

string chinese_daoxing(int gain)
{            int year,day,hour;
             string str;
             year=gain/1000;
             day=(gain-year*1000)/4;
             hour=(gain-year*1000-day*4)*3;
             str="";
             if(year) str=str+chinese_number(year)+"年";
             if(day) str=str+chinese_number(day)+"天";
             if(hour) str=str+chinese_number(hour)+"时辰";
             return str;
}
string give_fajian(object me)
{
     object ob;
     int i = random(3);
     me=this_player();
     if (me->query("obstacle/yinwu") == "done")
     return "白髯土地「嗯」的一声，一副欲言又止的样子。\n";
     if ((int)me->query_temp("obstacle/yinwu_fajian") == 1 )
     return "白髯土地「嗯」的一声，一副欲言又止的样子。\n";
     if (i!= 2)
     return "白髯土地「嗯」的一声，一副欲言又止的样子。\n";
     ob = new("/d/qujing/yinwu/obj/fajian");
     ob->move(me);
     me->set_temp("obstacle/yinwu_fajian",1);
     message_vision ("白髯土地给$N一个法简。\n",me);
     return "法宝只有一个，好自为之!\n";
}
void greeting(object ob)
{
 if( !ob || environment(ob) != environment() ) return;
 command ("hi");
}

int accept_fight(object me)
{
        command("say 打架？我老头那是您的对手！\n");
        return 0;
}
