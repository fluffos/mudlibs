inherit NPC;

void create()
{
        set_name("妖王", ({"yao wang", "wang"}));
        set("title","连环洞");
	set("gender", "男性");
        set("age", 40);
        set("attitude", "peaceful");
	set("shen_type", 1);
	set("people", "race");
	set("max_gin",1600);
	set("max_kee",1600);
	set("max_sen",1600);
	set("force_factor",160);
	set("max_force",1600);
	set("force",1600);
	set("max_mana",1600);
        set("mana",1600);
	set("combat_exp",600000);
	set_skill("unarmed", 110);
	set_skill("parry", 110);
	set_skill("dodge", 110);
	set_skill("spells", 110);
	set_skill("force", 110);
	set_skill("tonsillit", 110);
	set_skill("ghost-steps", 110);
	set_skill("gouhunshu", 110);
	set_skill("jienan-zhi", 110);
	set_skill("lunhui-zhang", 110);
        map_skill("force","tonsillit");
        map_skill("unarmed","jienan-zhi");
        map_skill("spells","gouhunshu");
	set("chat_chance_combat", 40);
	set("chat_msg_combat", ({
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
                (: cast_spell, "gouhun" :)
	}) );
	setup();
	carry_object("/d/obj/cloth/shoupiqun")->wear();
}

void unconcious ()
{
  die ();

}

void die ()
{
  object cop;
  object me = this_object();
  object ob = query_temp("my_killer");

  if (ob)
  {
    ob->set_temp("obstacle/yinwu_yaowang",1);
    call_out ("tudi_appearing",1,ob);
  }
  message_vision ("\n妖王瘫痪在地，竟是一只艾叶花皮豹子。\n\n",me);
  message_vision ("\n艾叶花皮豹子死了。\n\n",me);

  message_vision (" 白髯土地向你抱了一抱拳。\n",me);
  message_vision (" 白髯土地往地下一钻便消失了。\n",me);

  cop = CHAR_D->make_corpse(me,ob);
  cop->move(environment(me));
  me->move("/obj/void");
  call_out ("destruct_me",3,me);
}

void destruct_me (object me)
{
  destruct (me);
}

void tudi_appearing(object who)
{
	object tudi = new ("/d/qujing/yinwu/npc/tudi");
	tudi->announce_success (who);
	destruct( tudi );
}

int accept_fight(object ob)
{
  ob->apply_condition("killer", 100);
  kill_ob(ob);
  return 1;
}

void kill_ob (object ob)
{
  object me = this_object();

  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

