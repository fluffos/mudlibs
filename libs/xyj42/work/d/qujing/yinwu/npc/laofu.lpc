inherit NPC;

void create() {
  set_name("老妇", ({ "lao fu", "laofu" }));
  set("gender", "女性");
  set("age", 60);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin", 100);
  set("max_kee", 300 + random(100));
  set("max_sen", 100);
  set("force_factor", 5);
  set("max_force", 100);
  set("force", 100);
  set("max_mana", 100);
  set("combat_exp", 1000);
  set_skill("unarmed", 30);
  set_skill("parry", 20);
  set_skill("dodge", 20);
  setup();
  carry_object("/d/obj/cloth/linen")->wear();
}
