// by tutu 98/4/17

inherit ITEM;

int do_apply(string arg);

void create() {
  set_name("法简", ({ "fa jian", "fajian" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_give", "法简乃法宝不可赠人也。");
    set("unit", "根");
    set("value", 0);
    set("long", "一细长的法简，上刻有一些蝇头佛文。\n");
  }
  set("is_monitored", 1);
  setup();
}

void init() {
  add_action("do_apply", "apply");
  add_action("do_apply", "zhi");
  add_action("do_apply", "point");
}

int do_apply(string arg) {
  object me = this_object();
  object who = this_player();
  object ob;
  string argname;
  if (!arg)
    return notify_fail("什么？\n");
  ob = present(arg, environment(who));
  argname = ob->name();
  message_vision("$N拿起法简，口中念念有辞地对" + argname + "一晃。\n", who);
  if ((argname == "小妖") && (ob->query_temp("disabled") == 1)) {
    message_vision(" 小妖浑身一软，一下子显了原形。\n", who);

    switch (random(5)) {
      case 0:
        { ob->set("name", "短腿狗"); break; }
      case 1:
        { ob->set("name", "飞蚂蚁"); break; }
      case 2:
        { ob->set("name", "水老鼠"); break; }
      case 3:
        { ob->set("name", "断臂猴"); break; }
      case 4:
        { ob->set("name", "葫芦蛇"); break; }
    }
    return 1;
  }
  return notify_fail("什么奇迹都没发生。\n");
}
