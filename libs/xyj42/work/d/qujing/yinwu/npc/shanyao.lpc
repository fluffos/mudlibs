inherit NPC;

int check_num();
void destruct_me(object me);

void create() {
  set_name("山妖", ({ "shan yao", "yao" }));
  set("long", "一个凶相毕露的山妖。\n");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "aggressive");
  set("shen_type", 1);
  set("people", "race");
  set("max_gin", 400);
  set("max_kee", 400 + random(100));
  set("max_sen", 400);
  set("force_factor", 5);
  set("max_force", 400);
  set("force", 400);
  set("max_mana", 400);
  set("combat_exp", 500000);
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("dagger", 80);
  set_skill("fork", 80);
  set_skill("sword", 80);
  set_skill("blade", 80);
  set_skill("rake", 80);
  set_skill("whip", 80);
  set_skill("stick", 80);
  set_skill("staff", 80);
  set_skill("mace", 80);
  set_skill("axe", 80);
  set_skill("hammer", 80);
  set_skill("spear", 80);

  setup();
  carry_object("/d/qujing/yinwu/obj/cloth")->wear();
}

void unconcious() {
  die();
}

void die() {
  object ob, gu;
  object me = this_object();

  if (check_num() < 4) {
    message_vision("\n突然，山岩上又蹦下来一个呲牙咧嘴的山妖！\n", me);
    ob = new("/d/qujing/yinwu/npc/shanyao");
    ob->move(environment(me));
    //		call_out( "destruct_me",1, me );
    destruct(me);
    return;
  }
  message_vision("山妖倒了下去，化为一堆兽骨。\n", me);
  //	destruct( me );
  gu = new("/d/obj/misc/bone");
  gu->move(environment(me));
  //	call_out("destruct_me",1 ,me);
  destruct(me);
}

void destruct_me(object me) {
  destruct(me);
}

int check_num() {
  int num = 0;
  int i;

  object *inv = all_inventory(environment(this_object()));
  for (i = 0; i < sizeof(inv); i++)
    if (inv[i]->name() == "山妖") num++;
  //		else if (inv[i]->query_temp("apply/name")=="山妖") num++; 

  return num;
}
