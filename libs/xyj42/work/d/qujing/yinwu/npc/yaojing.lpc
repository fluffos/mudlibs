inherit NPC;

void create() {
  set_name("妖精", ({ "yao jing", "yao" }));
  set("long", "一个守洞的妖精。\n");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("people", "race");
  set("max_gin", 600);
  set("max_kee", 500 + random(100));
  set("max_sen", 600);
  set("force_factor", 60);
  set("max_force", 600);
  set("force", 600);
  set("max_mana", 600);
  set("combat_exp", 60000);
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("dagger", 80);
  set_skill("fork", 80);
  set_skill("sword", 80);
  set_skill("blade", 80);
  set_skill("rake", 80);
  set_skill("whip", 80);
  set_skill("stick", 80);
  set_skill("staff", 80);
  set_skill("mace", 80);
  set_skill("axe", 80);
  set_skill("hammer", 80);
  set_skill("spear", 80);
  setup();
  switch (random(5)) {
    case 0:
      { carry_object("/d/qujing/yinwu/obj/weapon1")->wield(); break; }
    case 1:
      { carry_object("/d/qujing/yinwu/obj/weapon2")->wield(); break; }
    case 2:
      { carry_object("/d/qujing/yinwu/obj/weapon3")->wield(); break; }
    case 3:
      { carry_object("/d/qujing/yinwu/obj/weapon4")->wield(); break; }
    case 4:
      { carry_object("/d/qujing/yinwu/obj/weapon5")->wield(); break; }
    case 5:
      { carry_object("/d/qujing/yinwu/obj/weapon0")->wield(); break; }
  }
  carry_object("/d/qujing/yinwu/obj/cloth")->wear();
}

void unconcious() {
  die();
}

void die() {
  object ob, gu;
  object me = this_object();
  message_vision("妖精倒了下去，化为一堆兽骨。\n", me);
  gu = new("/d/obj/misc/bone");
  gu->move(environment(me));
  message_vision("\n紧接着从亭柱后又闪出一位守亭的妖精！\n", me);
  ob = new("/d/qujing/yinwu/npc/yaojing");
  ob->move(environment(me));
  destruct(me);
}
