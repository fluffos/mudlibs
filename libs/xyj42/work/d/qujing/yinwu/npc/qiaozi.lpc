inherit NPC;

void create()
{
       set_name("樵子", ({"qiao zi", "zi"}));
       set("gender", "男性");
       set("age", 30);
       set("attitude", "friendly");
     set("shen_type", 1);
  set("people", "people");
  set("max_gin",500+random(100));
  set("max_kee",500+random(100));
  set("max_sen",500);
  set("force_factor",30);
  set("max_force",400);
  set("force",400);
  set("max_mana",400);
  set("combat_exp",10000);
  set_skill("unarmed", 50);
  set_skill("parry", 40);
  set_skill("dodge", 40);
  setup();
  carry_object("/d/obj/cloth/linen")->wear();
  carry_object("/d/obj/weapon/axe/tiefu")->wield();
}
