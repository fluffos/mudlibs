// qinwu/lukou.c

inherit ROOM;

int do_dive();

void create ()
{
  set ("short", "涧口");
  set ("long", @LONG

山石高耸之处，有斜坡自两岸缓缓而下，底下是潺潺流水之声
不断，涧水冲击着流水中的大小石块，发出一阵阵震耳欲聋的
轰鸣浪声，近处有几条暗沟。

LONG);

  set("exits", ([ /* sizeof() == 2 */
  "northup" : __DIR__"xuanya7",
]));
  set("outdoors",__DIR__);
  setup();
}

void init()
{
    add_action("do_dive", "dive");
}


int do_dive()
{       object me;
        me=this_player();
       if ((string)me->name()!="水老鼠")
         return notify_fail("$N一个猛子扎到水里...\n\n但没多会儿就被憋得半死，只好赶紧爬上岸来。\n");
       message_vision("$N往水里一扎潜了下去……\n", me);
       me->move("/d/qujing/yinwu/tianjing");
       return 1;
}
