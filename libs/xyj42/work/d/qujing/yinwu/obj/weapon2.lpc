#include <weapon.h>

inherit SPEAR;

void create()
{
        set_name("荜萝枪", ({"biluo qiang", "qiang" }));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "枝");
                set("value", 1000);
                set("material", "metal");
        }
        init_spear(15);
        setup();
}
