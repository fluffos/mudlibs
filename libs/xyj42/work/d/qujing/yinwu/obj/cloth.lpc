#include <armor.h>
inherit CLOTH;
string *names = ({
  "虎皮裙",
  "牛皮衣",
  "熊皮短袍",
  "犀皮背心",
  "狼皮裤",
});

string *ids = ({
  "hupi qun",
  "niupi yi",
  "xiongpi duanpao",
  "xipi beixin",
  "langpi ku",
});

void create() {
  int i = random(sizeof(names));
  set_name(names[i], ({ ids[i] }));
  set_weight(2700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 300);
    set("material", "leather");
    set("armor_prop/armor", 4);
    set("armor_prop/dodge", 0);
  }
  setup();
}
