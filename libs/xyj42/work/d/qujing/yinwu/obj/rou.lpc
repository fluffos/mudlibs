
inherit ITEM;
inherit F_FOOD;

string *name1 = ({
  "野驴肉",
  "黑狐肉",
  "树鸦肉",
  "花蛇肉",
  "野马肉",
  "山鼠肉",
  "猩猩肉",
  "羚羊肉",
  "野马肉",
  "灰兔肉",
  "猩猩肉",
  "土狍肉",
  "山鸡肉",
  "野鹿肉",
});

string *name2 = ({
  "板",
  "饼",
  "条",
  "干",
  "巴",
});

void create()
{
  string name_1 = name1[random(sizeof(name1))];
  string name_2 = name2[random(sizeof(name2))];
  set_name(name_1+name_2, ({"rou", "meat"}));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一大块晒干的兽肉。\n");
    set("unit", "大块");
    set("value", 0);
    set("food_remaining", 6);
    set("food_supply", 35);
  }
}
