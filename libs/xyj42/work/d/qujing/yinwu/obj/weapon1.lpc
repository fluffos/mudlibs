#include <weapon.h>

inherit STAFF;

void create()
{
        set_name("枯松杖", ({"kusong zhang", "zhang" }));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "枝");
                set("value", 1000);
                set("material", "metal");
        }
        init_staff(15);
        setup();
}
