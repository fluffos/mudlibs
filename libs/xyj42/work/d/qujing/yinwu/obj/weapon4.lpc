#include <weapon.h>

inherit BLADE;

void create()
{
        set_name("柳叶刀", ({"liuye dao", "dao" }));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 1000);
                set("material", "metal");
        }
        init_blade(15);
        setup();
}
