#include <weapon.h>

inherit SWORD;

void create()
{
        set_name("雉尾剑", ({"zhiwei jian", "jian" }));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 1000);
                set("material", "metal");
                set("wield_msg", "$N操出一柄$n握在手里。\n");
        }
        init_sword(15);
        setup();
}
