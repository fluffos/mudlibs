// qinwu/lukou.c

inherit ROOM;

void create ()
{
  set ("short", "路口");
  set ("long", @LONG

这里险象众生，路势奇恶，上通两岸犬牙一般巨石悬崖，下连
三路阴森森草坡。路口边一圈摆开大小岩石，尤如天然的石桌
石椅一般。

LONG);

  set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"caopo1",
  "southeast" : __DIR__"caopo2",
  "northwest" : __DIR__"xuanya5",
  "southwest" : __DIR__"caopo3",
  "northeast" : __DIR__"xuanya3",
]));
  set("objects",([ /* sizeof() == 3*/
           __DIR__"npc/shanyao.lpc" : 3,
]));
  set("outdoors",__DIR__);
  setup();
}

int valid_leave(object me, string dir)
{
  int i,j=1;
  object *inv = all_inventory( environment(me) );
  for(i=0; i<sizeof(inv); i++) 
  if (inv[i]->query("id") =="shan yao") 
  if ((int)inv[i]->query_temp("no_move") != 1)
  j = 0;
        if (dir == "northwest") {

        if ((objectp(present("shan yao", environment(me)))) && (j==0))
               {
return notify_fail("山妖呲牙咧嘴地死活不让你过！\n");
                }
        return ::valid_leave(me, dir);
        }
        if (dir == "northeast") {

        if ((objectp(present("shan yao", environment(me)))) && (j==0))
               {
return notify_fail("山妖呲牙咧嘴地死活不让你过！\n");
                }
        return ::valid_leave(me, dir);
        }

        return 1;
}
