// qinwu/lukou.c

inherit ROOM;
int do_climb();

void create ()
{
  set ("short", "悬崖");
  set ("long", @LONG

苍山峻岭，峰势崔巍，只见顶上白云飘飘，崖前树影寒寒，林
内松柏千千，峦头翠竹几干。四处怪石嶙嶙，使人心感不安，
难以擅自举步。

LONG);

  set("exits", ([ /* sizeof() == 2 */
  "northup" : __DIR__"xuanya6",
]));
//  set("objects",([ /* sizeof() == 3*/
//           __DIR__"npc/shanyao.lpc" : 3,
// ]));
  set("outdoors",__DIR__);
  setup();
}

void init()
{
    add_action("do_climb", "climb");
}


int do_climb()
{    
   int i= random(5);
   object me;
   me=this_player();
  if (i!= 3)
  {
    message_vision("$N手脚并用奋不顾身地向上爬去。\n",me);
    message_vision("……哗哗一声，$N失手滑了下来。\n",me);
    me->unconcious();
    return 1;
  }
  else
  {
    message_vision("$N手脚并用奋不顾身地向上爬去。\n",me);
    me->move(__DIR__"shanmen");
    return 1;
  }
}
