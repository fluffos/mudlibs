// qinwu/lukou.c

inherit ROOM;
int do_break(string arg);

void create ()
{
  set ("short", "山门");
  set ("long", @LONG

山巅之处有一背风低坳，古树连天，岩壁上有一石门。只见那
石门紧闭，门上有一个横石板，石板上书有“隐雾山折岳连环
洞”几个大字。

LONG);

set("exits", ([ /* sizeof() == 4 */
]));
// set("objects",([ /* sizeof() == 3*/
//           __DIR__"npc/yaowang" : 1,
// ]));
  set("outdoors",__DIR__);
  setup();
}

void init()
{
    add_action("do_break", "break");
}


int do_break(string arg)
{    
   int i= random(3);
   object tudi, me=this_player();
   int num = 1;
   int j;
   object *inv = all_inventory( environment(me));
   for(j=0; j<sizeof(inv); j++) 
   if (inv[j]->name() =="白髯土地") num=0;
   
  if (!arg || arg != "door")
  return notify_fail("你要打烂什么？\n");
  if (i!= 2)
  {
    message_vision("$N憋红了脸大喝一声向门砸去！\n\n",me);
    message_vision("一阵乱石轰响，砸在$N的头上！\n",me);
    me->unconcious();
    return 1;
  }
  else
  {
    message_vision("$N憋红了脸大喝一声向门砸去！\n\n",me);
    message_vision("一阵乱石轰响，砸在$N的头上！\n",me);
   if (num==1)
   {
    tudi = new(__DIR__"npc/tudi");
    tudi->move(__DIR__"shanmen");
//    message_vison("白髯土地双手抱拳，作了个揖道：各位仙长请了！\n",me);
    tudi->greeting(me);
   }
   return 1;
  }
}