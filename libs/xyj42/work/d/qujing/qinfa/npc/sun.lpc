inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("孙小二", ({ "sun xiaoer", "sun", "xiaoer" }));
  set("gender", "男性");
  set("combat_exp", 500);
  set("age", 30);
  set("per", 34);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 100);
  set("vendor_goods", ([
    "pipao": "/d/obj/cloth/pipao",
    "beixin": "/d/obj/cloth/beixin",
    "boots": "/d/obj/cloth/bullboots",
  ]));

  setup();
  carry_object("/d/qujing/qinfa/npc/obj/choupao")->wear();
  add_money("silver", 10);
}
void init() {
  add_action("do_vendor_list", "list");
}
