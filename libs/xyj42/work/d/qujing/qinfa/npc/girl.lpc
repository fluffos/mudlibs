inherit NPC;

void create()
{
  set_name("宫妃", ({"gong fei","girl","fei"}));
  set("gender", "女性");
  set("combat_exp", 500);
  set("age", 15);
  set("per", 34);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 100);

  setup();
  carry_object("/d/qujing/chechi/obj/gongpao")->wear();
  add_money("silver", 10);
}
