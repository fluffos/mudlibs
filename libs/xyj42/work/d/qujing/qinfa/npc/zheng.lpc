inherit NPC;
inherit F_VENDOR;

void create()
{
  set_name("郑寡妇", ({"zheng guafu","zhen","guafu"}));
  set("gender", "女性");
  set("combat_exp", 500);
  set("age", 30);
  set("per", 34);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 100);
  set("vendor_goods", ([
        "sword": "/d/qujing/qinfa/npc/obj/sword",
      ]) );

  setup();
  carry_object("/d/qujing/qinfa/npc/obj/choupao")->wear();
  add_money("silver", 10);
}
void init()
{
  add_action("do_vendor_list", "list");
}
