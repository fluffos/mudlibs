// sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("长剑", ({ "sword" }) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("value", 500);
		set("material", "iron");
		set("long", "这是一柄长长的精钢剑，剑口锋利。\n");
		set("wield_msg", "$N「唰」的一声抽出一柄长剑握在手中。\n");
		set("unequip_msg", "$N将手中的长剑插回剑鞘。\n");
	}
	init_sword(25);
	setup();
}
