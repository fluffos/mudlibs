// zhanpao.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("战袍", ({ "zhan pao", "pao" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "cloth");
    set("unit", "件");
    set("value", 30);
    set("armor_prop/armor", 30);
  }
  setup();
}
