inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("李寡妇", ({ "li guafu", "li", "guafu" }));
  set("gender", "女性");
  set("combat_exp", 500);
  set("age", 30);
  set("per", 34);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 100);
  set("vendor_goods", ([
    "choupao": "/d/obj/cloth/choupao",
    "ziyi": "/d/obj/cloth/ziyi",
    "hat": "/d/obj/cloth/hat",
    "buxie": "/d/obj/cloth/buxie",
    "magua": "/d/obj/cloth/magua",
  ]));

  setup();
  carry_object("/obj/loginload/linen")->wear();
  add_money("silver", 10);
}
void init() {
  add_action("do_vendor_list", "list");
}
