inherit NPC;

void create() {
  set_name("赵寡妇", ({ "zhao guafu", "zhao", "guafu" }));
  set("gender", "女性");
  set("combat_exp", 500);
  set("age", 30);
  set("per", 34);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 100);

  setup();
  carry_object("/d/qujing/qinfa/npc/obj/choupao")->wear();
  add_money("silver", 10);
}
