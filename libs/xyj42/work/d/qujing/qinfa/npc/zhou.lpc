inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("周小二", ({ "zhou xiaoer", "zhou", "xiaoer" }));
  set("gender", "男性");
  set("combat_exp", 500);
  set("age", 30);
  set("per", 34);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 100);
  set("vendor_goods", ([
    "mijiu": "/d/obj/food/mijiu",
    "egg": "/d/obj/food/egg",
    "jiudai": "/d/obj/food/niupi-jiudai",
    "kaoji": "/d/obj/food/kaoji",
    "jiunang": "/d/obj/food/jiunang",
  ]));

  setup();
  carry_object("/d/qujing/qinfa/npc/obj/choupao")->wear();
  add_money("silver", 10);
}
void init() {
  add_action("do_vendor_list", "list");
}
