inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("钱寡妇", ({ "qian guafu", "qian", "guafu" }));
  set("gender", "女性");
  set("combat_exp", 500);
  set("age", 30);
  set("per", 34);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 100);
  set("vendor_goods", ([
    "kuang": "/d/obj/misc/kuang",
    "bag": "/d/obj/misc/bag",
    "shaozhou": "/d/obj/misc/shaoba",
  ]));

  setup();
  carry_object("/d/qujing/qinfa/npc/obj/choupao")->wear();
  add_money("silver", 10);
}
void init() {
  add_action("do_vendor_list", "list");
}
