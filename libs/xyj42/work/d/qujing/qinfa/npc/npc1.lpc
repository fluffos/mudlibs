// npc1.c


inherit NPC;

void create() {
  switch (random(8)) {
    case 0:
    case 1:
      {
        set_name("市民", ({ "shi min" }));
        set("gender", "男性");
        break;
      }
    case 2:
      {
        set_name("路人", ({ "lu ren" }));
        set("gender", "男性");
        break;
      }
    case 3:
      {
        set_name("艺人", ({ "yi ren" }));
        set("gender", "男性");
        break;
      }
    case 4:
      {
        set_name("道人", ({ "dao ren" }));
        set("gender", "男性");
        break;
      }
    case 5:
      {
        set_name("官人", ({ "guan ren" }));
        set("gender", "男性");
        break;
      }
    case 6:
      {
        set_name("男仆", ({ "nan pu" }));
        set("gender", "男性");
        break;
      }
    case 7:
      {
        set_name("女仆", ({ "nu pu" }));
        set("gender", "女性");
        break;
      }
  }
  set("attitude", "friendly");
  set("age", random(20) + 20);
  set("shen_type", 1);
  set_skill("dodge", 10 + random(90));
  set_skill("unarmed", 10 + random(90));
  set_skill("parry", 10 + random(90));

  set("combat_exp", 1000 + random(1000));

  set("chat_chance", 25);
  set("chat_msg", ({ (: random_move :) }));


  setup();
  carry_object("/d/qujing/qinfa/npc/obj/linen")->wear();
}
int recognize_apprentice(object ob) {
  if ((int)ob->query("per") > 30) return 1;
  command("say 对不起，这位" + RANK_D->query_respect(ob) +
    "，请教我可不敢担了。");
  return notify_fail("人家似乎不愿意教你。\n");
}
