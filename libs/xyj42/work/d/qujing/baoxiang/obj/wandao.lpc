// blade.c

#include <weapon.h>

inherit BLADE;

string *names = ({
  "长弯刀",
  "短弯刀",
  "月芽弯刀",
});

void create() {
  set_name(names[random(sizeof(names))], ({ "wan dao", "blade" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一把弯弯的战刀．\n");
    set("unit", "把");
    set("value", 1400);
    set("material", "metal");
  }
  init_blade(25);
  setup();
}
