inherit NPC;

string *names = ({
  "羊怪",
  "獭怪",
  "鹿怪",
  "兔怪",
  "狗怪",
  "猪怪",
  "猴怪",
  "狒怪",
  "蟒怪",
});

void create()
{
  int i = random(9)+1;
  set_name(names[random(sizeof(names))], ({"yao guai", "yao", "guai"}));
  set("gender", "男性");
  set("age", 30*i);
  set("attitude", "aggressive");
  set("combat_exp", 30000*i);
  set("per", 10);
  set_skill("parry", 30*i);
  set_skill("unarmed", 30*i);
  set_skill("dodge", 30*i);
  set("max_sen",200*i);
  set("max_gee",200*i);
  set("max_gin",200*i);
  set("force",200*i);
  set("max_force",200*i);
  set("max_mana",200*i);
  set("force_factor",20*i);
  setup();
  carry_object("/d/obj/cloth/shoupiqun")->wear();
}

