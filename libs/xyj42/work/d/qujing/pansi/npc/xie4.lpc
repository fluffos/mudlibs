#include <ansi.h>

inherit NPC;

void create() {
  set_name("道士", ({ "dao shi", "shi" }));
  set("title", "百脚蝎公");
  set("gender", "男性");
  set("age", 80);
  set("attitude", "aggressive");
  set("combat_exp", 850000);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("force", 100);
  set_skill("spells", 100);
  set_skill("unarmed", 100);
  set_skill("gouhunshu", 100);
  set_skill("tonsillit", 100);
  set_skill("ghost-steps", 100);
  set_skill("jienan-zhi", 100);
  set("con", 10);
  set("cor", 10);
  set("int", 10);
  set("per", 10);
  set("spi", 10);
  set("cps", 10);
  map_skill("unarmed", "jienan-zhi");
  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");
  set("eff_dx", -100000);
  set("nkgain", 110);

  set("max_gin", 1000);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("force", 1000);
  set("max_force", 1000);
  set("mana", 1000);
  set("max_mana", 1000);
  set("force_factor", 80);
  set("mana_factor", 80);
  setup();
  carry_object("/d/obj/cloth/shoupiqun")->wear();
}

void unconcious() {
  object shell = new("/d/obj/misc/shell");

  shell->move(environment(this_object()));
  message_vision("\n$N浑身一软瘫在地上，化做一堆空空的虫壳。\n",
    this_object());
  destruct(this_object());
}

void die() {
  object shell = new("/d/obj/misc/shell");

  shell->move(environment(this_object()));
  message_vision("\n$N浑身一软瘫在地上，化做一堆空空的虫壳。\n",
    this_object());
  destruct(this_object());
}
