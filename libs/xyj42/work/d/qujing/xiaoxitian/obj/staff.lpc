#include <weapon.h>
inherit STAFF;

void create()
{
  set_name("青铜禅杖", ({ "qingtong chanzhang", "chanzhang", "zhang" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是一根以青铜为料制造的重禅杖。\n");
    set("value", 500);
    set("material", "bronze");
    set("wield_msg", "$N吸一口气，举起$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n放下。\n");
  }
  init_staff(55);
  setup();
}

