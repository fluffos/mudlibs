inherit NPC;

void create() {
  set_name("小童", ({ "xiao tong" }));
  set("gender", "男性");
  set("age", 13);
  set("combat_exp", 30000);
  set("per", 10);
  set_skill("parry", 30);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set("max_sen", 200);
  set("max_gee", 200);
  set("max_gin", 200);
  set("force", 200);
  set("max_force", 200);
  set("max_mana", 200);
  set("force_factor", 20);
  setup();
  carry_object("/d/obj/cloth/sengyi")->wear();
}
