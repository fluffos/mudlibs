inherit NPC;

string *names = ({
  "鲤鱼精",
  "鲫鱼精",
  "鳖精",
  "鲇鱼精",
  "水螺精",
  "蚌壳精",
  "鳌精",
  "水鲑精",
  "河鳗精",
  "鲞精",
});

void create() {
  int i = random(3) + 1;
  set_name(names[random(sizeof(names))], ({ "yao jing", "jing", "jing" }));
  set("gender", "男性");
  set("age", 10 * i);
  set("attitude", "aggressive");
  set("combat_exp", 30000 * i);
  set("per", 10);
  set_skill("parry", 30 * i);
  set_skill("unarmed", 60 * i);
  set_skill("dodge", 60 * i);
  set("max_sen", 200 * i);
  set("max_gee", 200 * i);
  set("max_gin", 200 * i);
  set("force", 200 * i);
  set("max_force", 200 * i);
  set("max_mana", 200 * i);
  set("force_factor", 20 * i);
  setup();
  carry_object("/d/obj/armor/tiejia")->wear();
}
