// servant.c

inherit NPC;
inherit F_MASTER;

#include <ansi.h>

int join_in();
void create() {
  set_name(HIR "楼主" NOR, ({ "master" }));
  set("title", "金风细雨楼");
  set("nickname", HIY "扬善除恶" NOR);
  set("gender", "男性");
  set("age", 80);
  set("long", "一个白须鹤发的一个老者，看起来有些年月的经验了。\n");
  set("attitude", "peaceful");
  set("combat_exp", 3000000);

  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("cps", 30);
  set("con", 30);
  set("per", 30);

  set("force", 4000);
  set("max_force", 2200);
  set("force_factor", 30);

  set("inquiry", ([
    "here": "这里是我楼处理内部事务的地方。\n",
    "name": "我就是金风细雨楼的楼主。\n",
    "参加": (: join_in() :),
    "入楼": (: join_in() :),
  ]));

  create_family("金风细雨楼", 15, "弟子");
  set("guilds\id", "jfl");
  set("guilds\name", "金风细雨楼");

  assign_apprentice("弟子", 0);

  set_skill("force", 100);
  set_skill("unarmed", 100);
  set_skill("sword", 150);
  set_skill("blade", 120);
  set_skill("parry", 100);
  set_skill("dodge", 150);

  setup();

  carry_object("/d/obj/cloth/baipao")->wear();
}

void init() {
  add_action("do_swear", "swear");
}

int join_in() {
  object book;
  object me = this_player();
  if (me->query("guilds/id") == "jfl") {
    message_vision("开什么玩笑，$N已经是我楼会员了！\n", me);
    return 1;
  }
  if (me->query_temp("pending/celestial_swear")) {
    command("say 多说无益，若不发誓恪守门规，便是跪著求我也没用。");
    return 1;
  } else {
    command("say 我楼有正式规章，这个你先拿去看看，" + RANK_D->query_respect(me)
      + "如果真的有心，且发个誓(swear)来。\n");
    message_vision("$N给$n一个羊皮卷。\n", this_object(), this_player());
    book = new("/d/obj/books-nonskill/jf_rules");
    book->move(me);
    me->set_temp("pending/celestial_swear", 1);
    return 1;
  }
}

int do_swear(string arg) {
  if (this_player()->query("guilds/id") == "jfl") {
    message_vision("开什么玩笑，$N已经是我楼会员了！\n", this_player());
    return 1;
  }
  if (!this_player()->query_temp("pending/celestial_swear"))
    return 0;
  if (!arg) return notify_fail("你要发什麽誓？\n");
  this_player()->set_temp("pending/celestial_swear", 0);
  message_vision("$N发誓道：" + arg + "\n", this_player());
  //	if( strsrch(arg, "守") >=0 && strsrch(arg, "门规") >=0 ) {
  if (arg == "守章程") {
    command("smile");
    command("say 这就是了，欢迎加入" + HIR "金风细雨楼" NOR + "。\n");
    //		command("recruit " + this_player()->query("id"));
    this_player()->set("guilds/id", "jfl");
    this_player()->set("guilds/name", "金风细雨楼");
    this_player()->set("nickname", HIR "金风细雨楼" NOR);
  } else {
    command("say 你既不是真心入门，还是去吧！");
  }
  return 1;
}
