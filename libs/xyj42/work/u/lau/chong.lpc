// keshui chong     Lau, 980408

inherit ITEM;

#include <ansi.h>

void create() {
  set_name("瞌睡虫", ({ "keshui chong", "chong" }));
  set_weight(50);
  set("long", "一只小小的瞌睡虫。\n");
  set("unit", "只");
  setup();
}

void init() {
  add_action("let_sleep", "fang");
  add_action("let_sleep", "apply");
}

int let_sleep(string arg) {
  object me, who;

  me = this_player();

  if (!arg) return 0;

  if (!objectp(who = present(arg, environment(me))) || !living(who))
    return notify_fail("这里没有这个人。\n");
  if (wiz_level(me) < wiz_level(who)) return notify_fail("嘿嘿，找死吗？\n");
  tell_object(me, "你偷偷地拿出一只瞌睡虫，朝" + who->query("name") + "一放。\n");
  if (me->query("mana") < who->query("mana") && !who->query_temp("sleepy")) {
    //法力小需两只虫以上
    message_vision("$N仰天打了个哈欠，看来要好好睡睡了。\n", who);
    who->add_temp("sleepy", 1);
    call_out("dest_obj", 1, this_object());
    return 1;
  } else   // sleep leh  :)
  {
    message_vision("$N仰天打了个哈欠，揉了揉眼立刻倒在地上睡着了。\n", who);
    "/cmds/wiz/wsleep"->main(who);
    if (who->query_temp("sleepy")) who->delete_temp("sleepy");
    call_out("dest_obj", 1, this_object());
  }
  return 1;
}

void dest_obj(object me) {
  destruct(me);
}
