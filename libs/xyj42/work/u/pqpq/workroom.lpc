#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
        set("short", BCYN RED"公共厕所"NOR);

	set("long", @LONG
这是一件五星级的厕所，装修豪华，配有音像、桑拿、按摩、美容等各种设备。
     使您一进来精神就会为之一爽，并冒出一个疑问。这是厕所嘛？
LONG
	);
	set("valid_startroom",1);
	set("sleep_room",1);
	set("if_bed",1);

	set("exits", ([
    "down" : "/d/city/kezhan",
	]));
	set("no_clean_up", 0);
      
	setup();     

}
