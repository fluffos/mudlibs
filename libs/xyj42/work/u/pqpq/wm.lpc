#include <ansi.h>
#include <room.h>
inherit ROOM;
int no_book = 0;

int do_stand(string temp2);
int do_sit(string temp3);
int do_search(object ob);

void create()
{
        set("short", BBLU RED"土土的家"NOR);

	set("long", @LONG
这是土土的家，墙上挂着一个女孩的照片，照片有些旧了。但却用玫瑰色的
像框装着。屋里有个特大的书架，架子上摆满了各种各样的书。细看一下好象
很多竟然是西游记里的武学典集。另外有张设计独特的大半圆型桌子，桌子的
内弯里摆着一张舒适的席梦思双人床，床上软绵绵的被子和香喷喷的枕头使人
有种昏昏欲睡的感觉。桌子上左边有一套组合音响，包括最HOT、最HIT款
的金嗓子功放和KENWOOD音柱等等，喇叭里正放着RICHARD MARX的老歌：
             <<I will be right here waiting for you>>
桌子的右边放着一台SILICON GRAPHIC。SERVER 和一台IBM PENTIUM PRO 最新款的
原装机，21寸的大屏幕上正运作着土土最喜欢的西游记MUD游戏，坐在床边就可以
操作啦！
LONG
	);

	set("valid_startroom",1);
	set("sleep_room",1);
	set("if_bed",1);

	set("exits", ([
    "east" : "/d/city/kezhan",
    "south" : "/d/death/cuiyun",
    "north" : "/d/wiz/wizroom",
    "west" : "/d/pantao/yaob",
	]));

  set("objects", ([ 
//               "/d/obj/drug/huanyang" : 1,
               "/d/ourhome/obj/table" : 1,
               "/d/ourhome/obj/seat" : 2,
        ]));
                                              
	set("no_clean_up", 0);
      
	setup();     
}

void init()
{
	add_action("do_stand", "stand");
	add_action("do_sit", "sit");
}

int do_sit(string arg)
{     
      object me;

      me=this_player();

	if ( !arg || ((arg != "seat")&&(arg != "table") ))
		return notify_fail("你要坐在什么上面？\n");	
	
	if (this_player()->query_temp("marks/sit"))
		return notify_fail("你已经坐下了。\n");	
      
      if ( arg != "seat")	
	      return notify_fail("坐桌子上？太不雅观了吧。\n");
        	
	this_player()->set_temp("marks/sit", 1);
	message_vision("$N舒舒服服地在石凳上坐下来，翘起了二郎腿。\n",me);
      return 1;	
}

int do_stand(string arg)
{
      object me;

      me=this_player();

      if (!this_player()->query_temp("marks/sit"))
          return notify_fail("你本来就站着。\n");

      this_player()->set_temp("marks/sit", 0);
      message_vision("$N伸了个懒腰，站了起来。\n", me);
      return 1;
}

