// xiaoxman.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name("小黑带", ({ "xiao xman", "xxman" }));
  set("long",
    "这是黑带的儿子，虽然和许\多武林人物比起来，他\n"
    "们的武功\实在稀松平常，但是他是黑带的爱子，谁也不\n"
    "轻易地招惹他。\n");

  set("attitude", "heroism");
  set("age", 4);
  set("vendetta_mark", "authority");
  set("pursuer", 1);

  set("str", 27);
  set("cor", 26);
  set("cps", 25);

  set("combat_exp", 100000);

  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :),
  }));

  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "小黑带喝道：还不快放下武器？\n",
    "小黑带喝道：你知道我是谁吗？反了！反了！\n"
  }));

  set_skill("unarmed", 70);
  set_skill("sword", 70);
  set_skill("parry", 70);
  set_skill("dodge", 70);
  set_skill("move", 100);

  set_temp("apply/attack", 70);
  set_temp("apply/defense", 70);
  set_temp("apply/damage", 30);
  set_temp("apply/armor", 70);
  set_temp("apply/move", 100);

  setup();
  add_money("silver", 100);

}
