// xuelian.c 雪莲
#include <ansi.h>
inherit ITEM;

void init();
void eat();

void create()
{
    set_name(BCYN RED"结婚庆典礼品"NOR, ({"li pin", "gift"}));
	set_weight(20);
	if (clonep())
		set_default_object(__FILE__);
	else {
        set("long",
BLU"一个装饰精美的礼品盒，上面印有＂送给米雪儿、天涯孤客，恭贺新婚！＂几个烫金字。\n"NOR);
        set("unit", "个");
		set("value", 300);
   	 }
	
	setup();
}

void init()
{
    add_action("do_chi", "open");
}


