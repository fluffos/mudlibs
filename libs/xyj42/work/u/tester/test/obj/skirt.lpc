// pink_cloth.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
    set_name(BRED GRN"西装套裙" NOR, ({ "skirt", "cloth" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        set("long", "一条色彩鲜艳的红色西装套裙，裁剪得非常合身。\n");
		set("unit", "条");
		set("value", 0);
		set("material", "cloth");
        set("armor_prop/armor", 50);
        set("armor_prop/personality", 20);
		set("female_only", 1);
        set("wear_msg", BLU"$N拿起衣架上的"NOR + this_object()->name() + 
		BLU"轻轻穿在身上，又对着镜子照了照。\n"NOR);
        set("unequip_msg", BLU"$N脱下身上的"NOR + this_object()->name() +
        BLU"，整理了一下，然后挂在衣架上。\n"NOR);
        set("no_get","这样东西拿不起来！\n");
//        set("no_give","这样东西不能给别人！\n");
        set("no_drop","这样东西不能丢弃！\n");
        set("no_sell","这样东西不能买卖！\n");
	}
	setup();
}

init ()
{
  add_action ("do_sleep", "mysleep");
}

int do_sleep (string arg)
{
  object me = this_player();
  object skirt = this_object();
    object where = environment(me);
  string *msgs = ({
    HIR"一丝痛苦的表情浮上$N的脸，大颗的泪珠从$N美丽的脸庞滑落．．．n"
    "$N无比难过地低下头去，娇弱的身体不住地颤抖着。\n"NOR,
  });

    if( !where->query("sleep_room") &&
        !me->query_temp("force_sleep") )
        return notify_fail("这里不是睡觉的地方。\n");

    if (me->is_busy())
        return notify_fail("你正忙着呢！\n");

    if( me->is_fighting() )
        return notify_fail("战斗中不能睡觉！\n");
        
    if ((time()-me->query("last_sleep"))<90)
        return notify_fail("你刚睡过一觉, 先活动活动吧。 \n");
  if (arg)
  {
      if (arg==(string)me->query("id"))
      {
          "/cmds/std/sleep"->main(me);
          return 1;
      }
      message_vision (msgs[0],me);
      return 1;
  }
  else
  {
    "/cmds/std/sleep"->main(me);
  return 1;
  }
}

int query_autoload() { return 1; }

