// Sjmao 1/12/1998
#include <ansi.h>
#include <dbase.h>
#include <weapon.h>

inherit HAMMER;

void create() {
  set_name(BRED GRN "小提琴" NOR, ({ "ti qin", "qin", "violin" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", BCYN HIR "一把样式古朴的意大利克雷莫那小提琴，" NOR
      "\n" BCYN HIR "上面刻有帕格尼尼的名字。" NOR "\n");
    set("unit", "把");
    set("base_value", 10000);
    set("no_get", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("wield_msg", MAG "$N左手缓慢地拿起$n" MAG "，放在颈间，\n"
      "举着弓的右手停在空中，象雕塑一样凝住不动。\n" NOR);
    set("unwield_msg", MAG "$N将手中的$n" MAG "轻轻放下，深深地吸了一口气。" NOR "\n");
  }
  init_hammer(10);
  setup();
}

init() {
  add_action("do_play", "play");
}

int do_play(string arg) {
  object me = this_player();
  object qin = this_object();
  string *msgs = ({
    BLU "$N轻轻地举起右手的弓，" + qin->name() + BLU "的琴声徐缓地传来．．．n"
    "$N平静的脸上露出一丝微笑，象是在与远方的朋友互相问安。\n" NOR,
    BLU "$N左手轻轻地揉动着琴弦，" + qin->name() + BLU "闪烁着暗红色的光华。\n"
    "如泣如诉的琴声让人感觉好象回到了过去一样．．．\n" NOR,
    GRN "琴声变得高亢明快，$N拿着弓的右手微微颤动\n"
    +qin->name() + GRN "在$N的肩头竟似有千万斤重。\n" NOR,
    GRN "低沉的琴声带着$N的无限情思，缓慢地在空气中流动．．．\n"
    "$N的眼神似乎正凝视着当年那狱中的一代大师帕格尼尼。\n" NOR,
    HIC "无限缠绵的琴声自$N项上的" + qin->name() + HIC "中发出。\n"
    "再看$N竟已完全沉浸在回忆之中．．．\n" NOR,
    HIC "一声轻轻的叹息传来，此刻的$N脸色更加凝重。\n"
    "周围的世界似乎已经不再存在一样。\n" NOR,
  });

  if (me->query("id") != "chu" && me->query("id") != "sjmao") {
    tell_object(me, "这把" + qin->name() + "你演奏不了！\n");
    return 1;
  }

  if (arg != "ti qin" && arg != "qin" && arg != "violin") {
    tell_object(me, "想演奏什么呢？\n");
    return 1;
  }

  message_vision(msgs[random(sizeof(msgs))], me);
  return 1;
}
//int query_autoload() { return 1; }
