// pk.c, for the purpose of testing NPCs skills.
// sjmao   12/26/97

#include <ansi.h>

inherit F_CLEAN_UP;
void create() { seteuid(getuid()); }
void do_pk(object, object);
int main(object me, string arg) {
  object obj1, obj2;
  string target, pker;
  string *killer, callname;

  if (!wizardp(me))
    return notify_fail("什么？\n");

  if (sscanf(arg, "%s with %s", target, pker) == 2);
  else return notify_fail("谁跟谁对杀？\n");

  if (!objectp(obj1 = present(target, environment(me)))
    || !objectp(obj2 = present(pker, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (!living(obj1) || !living(obj2))
    return notify_fail("看清楚一点，那并不是活物。\n");
  write("你打算让" + obj2->name() + "去杀" + obj1->name() + "！\n");

  if (obj1 == me || obj2 == me)
    return notify_fail("用 suicide 指令会比较快:P。\n");


  callname = RANK_D->query_rude(obj1);

  message_vision("\n$N对着$n喝道：「"
    +callname + "！今日不是你死就是我活！」\n\n", obj2, obj1);

  do_pk(obj2, obj1);

  return 1;
}
void do_pk(object obj2, object obj1) {
  obj2->kill_ob(obj1);
}
int help(object me) {
  write(@HELP
指令格式 : pk <人物甲> with <人物乙>
 

其他相关指令: fight, kill

HELP
  );
  return 1;
}
