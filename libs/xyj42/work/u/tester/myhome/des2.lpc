#include <ansi.h>

inherit ROOM;

void create ()
{
  set ("short",BYEL BLU "荒原古道" NOR);
  set ("long", @LONG

荒漠之中的一条古道。两旁远处稀稀落落分布着几个孤零零
的农舍。这里由于远离城镇而显得单调。看起来在半日之内
你没有可能到达一个象样的村镇。


LONG);

  set("exits", ([
        "south" : __DIR__"des3",
        "north" : __DIR__"des1",
      ]));

  setup();
}

