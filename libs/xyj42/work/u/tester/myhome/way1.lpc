#include <ansi.h>

inherit ROOM;

void create ()
{
  set ("short",BCYN RED "林荫大道" NOR);
  set ("long", @LONG

一条寂静的青石大道。两旁长着高大的白杨，秋天的阳光从
树叶间透射过来，更增添了一分宁静。微风吹过，树叶轻微
的沙沙声让你仿佛置身于一个梦幻的世界。南方可以看到不
远处的十里长亭。你不禁想起那首歌：人生难得是欢聚，唯
有离别多．．．


LONG);

  set("exits", ([
        "south" : __DIR__"changting",
        "north" : __DIR__"way2",
      ]));

  set("objects", ([
        __DIR__"npc/bird1" : 2,
]));

