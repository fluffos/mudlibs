#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HBBLU RED "寂寞画廊" NOR);
  set("long", @LONG

寂寞山庄正殿。高大的大理石柱子顶着穹形的天花板。
从下面仰望绘着图案的天花板，你会觉得那么遥远！而
正前方是二楼突出来的一圈回廊。回廊的下方挂着一个
样子特别的家族图案。左右两边各有一座楼梯斜着通向
二楼。从这里你可以看见楼上墙壁上挂着的许多画幅。
周围的墙上也挂着很多幅画。传说寂寞山庄主人当年曾
经画过很多画像，但很多没有完成，还有一些已经失落
在动荡中。目前挂在这里的这些画多是庄主夫人如茵娘
子的画像。还有一些是风景和花鸟树木。


LONG);
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "dian2",
    "eastup": __DIR__ "lang1",
    "westup": __DIR__ "lang3",

  ]));
  set("objects", ([
    __DIR__ "obj/zhuzi": 2,
    __DIR__ "obj/bilu": 1 ]));

  set("no_clean_up", 0);
  set("outdoors", 0);
  set("no_fight", 1);
  set("no_magic", 1);
  setup();
}
void init() {
  add_action("block_cmd", "", 1);

  return;
}

int block_cmd(string args) {
  string verb;

  verb = query_verb();
  if (verb == "xiudao") return 1;
  if (verb == "exert") return 1;
  return 0;
}
