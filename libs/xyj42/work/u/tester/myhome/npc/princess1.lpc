inherit NPC;
#include <ansi.h>

void create()
{
      set_name(HIC"虹索"NOR, ({"princess","girl","tina"}));

      set("long","一个打伴端庄的姑娘，是寂寞庄主的表妹。\n"
                 +"每当庄主南行时多随行陪伴在表哥身边。\n"
                 +"传说中这姑娘身怀盖世神功，虽然只有二十岁。\n\n");
       set("title", BLU"寂寞公主"NOR);
       set("gender", "女性");
       set("age", 20);
        set("per", 30);
       set("attitude", "peaceful");
       set("shen_type", 1);
        set("combat_exp", 2000000);
       set("class", "xian");
       set("rank_info/respect", "公主");
        set("int", 30);
        set("cor", 30);
        set("con", 30);
       set("max_kee", 6000);
       set("max_gin", 6000);
       set("max_sen", 6000);
       set("force", 6000);
       set("max_force", 3000);
       set("force_factor", 150);
       set("max_mana", 3000);
       set("mana", 6000);
       set("mana_factor", 150);
       set_skill("literate", 200);
       set_skill("unarmed", 200);
       set_skill("dodge", 200);
       set_skill("force", 200);
       set_skill("parry", 200);
       set_skill("sword", 200);
       set_skill("spells", 200);
        set_skill("moonshentong", 200);
        set_skill("baihua-zhang", 200);
        set_skill("moonforce", 200);
        set_skill("snowsword", 200);
        set_skill("moondance", 200);
        map_skill("spells", "moonshentong");
        map_skill("unarmed", "baihua-zhang");
        map_skill("force", "moonforce");
        map_skill("sword", "snowsword");
        map_skill("parry", "snowsword");
        map_skill("dodge", "moondance");


        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: cast_spell, "arrow" :),
        }) );

        setup();
        carry_object("/u/sjmao/myhome/obj/skirt")->wear();
        carry_object("/u/sjmao/myhome/obj/shoes")->wear();
        carry_object("/u/sjmao/myhome/obj/sword")->wield();

}
void init()
{
  object who;
  ::init();
  if (interactive(who = this_player()))
  {
     if (who->query("id") == "sjmao")
        call_out("following", 2, who);
  }
}

void following(object who)
{
  object me;
  me = this_object();

  if (! who || environment(who) != environment())
    return;

  if (me->query_temp ("follow_player") != "active")
  {
      message_vision ("寂寞公主轻声说道：表哥，让$N陪伴表哥南行吧！说着向$n飘然一拜。\n",
                  me,who);
      command("follow " + who->query("id"));
      me->set_temp ("follow_player","active");
  }
  return;
}
void kill_ob(object ob)
{
  object zhuren = present("sjmao",environment(this_object()));

  if (zhuren)
    zhuren->kill_ob(ob);
  ::kill_ob(ob);
}

void die()
{

        if( environment() ) {
        message("sound", "\n\n寂寞公主叹道：表哥，我已为你鞠躬尽瘁！\n\n",environment());
        message("sound", "\n寂寞公主向天空挥手，顿时彩练当空，花香缭绕。。。\n\n", environment());
        message("sound", "\n你再看时，寂寞公主已经消失在天际。\n\n",environment());
        }
 
        destruct(this_object());
}

void unconcious()
{

        if( environment() ) {
        message("sound", "\n\n寂寞公主叹道：表哥，我已为你鞠躬尽瘁！\n\n",environment());
        message("sound", "\n寂寞公主向天空挥手，顿时彩练当空，花香缭绕。。。\n\n", environment());
        message("sound", "\n你再看时，寂寞公主已经消失在天际。\n\n",environment());
        }
 
        destruct(this_object());
}

