// bird1.c

inherit NPC;

void create() {
  set_name("麻雀", ({ "sparrow", "ma que" }));
  set("race", "野兽");
  set("age", 3);
  set("long", "一只可爱的小麻雀，正扑打着翅膀飞着。\n");

  set("str", 24);
  set("cor", 26);

  set("limbs", ({ "头部", "身体", "翅膀", "尾巴" }));
  set("verbs", ({ "bite", "claw", "poke" }));

  set("chat_chance", 6);
  set("chat_msg", ({
    (: this_object(), "random_move" :),
    "麻雀落在你面前，歪着美丽的小脑袋看着你。\n",
    "小麻雀在天空飞了一圈，一边还喳喳地叫着。\n",
    "麻雀见你看它，吓得飞向天空。\n",
    "小麻雀冲着你喳喳地叫，似乎在向你讨吃的。\n" }));

  set_temp("apply/attack", 10);
  set_temp("apply/armor", 3);

  setup();
}

int accept_object(object who, object ob) {
  if (ob->id("huasheng")) {
    set_leader(who);
    message("vision", name() + "高兴地喳喳叫了起来。\n", environment());
    return 1;
  }
}
