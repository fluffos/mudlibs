#include <ansi.h>

inherit ROOM;

void create ()
{
  set ("short",BCYN RED "林荫大道" NOR);
  set ("long", @LONG

一条寂静的青石大道。两旁长着高大的白杨，秋天的阳光从
树叶间透射过来，更增添了一分宁静。微风吹过，树叶轻微
的沙沙声让你仿佛置身于一个梦幻的世界。身边与你同乘马
车的山庄主人此刻一句话也不说。风吹着马儿颈下的铃铛叮
当作响。一片静寂伴着你前行。


LONG);

  set("exits", ([
        "south" : __DIR__"way3",
        "north" : __DIR__"way5",
      ]));

  setup();
}

