#include <ansi.h>

inherit ROOM;

void create ()
{
  set ("short",BCYN RED "林荫大道" NOR);
  set ("long", @LONG

一条寂静的青石大道。两旁长着高大的白杨，秋天的阳光从
树叶间透射过来，更增添了一分宁静。微风吹过，树叶轻微
的沙沙声让你仿佛置身于一个梦幻的世界。无边的思绪涌上
你的心头，这一刻你好象再也不愿往前挪动一步。


LONG);

  set("exits", ([
