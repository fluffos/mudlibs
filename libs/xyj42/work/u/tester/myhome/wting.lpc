#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", BCYN HIR "月华亭" NOR);
  set("long", @LONG

这是寂寞山庄主人经常与客人一起赏月的小亭，里面
挂着一只灯笼。

LONG);

  set("exits", ([
    "east": __DIR__ "sgate",
  ]));

  set("objects", ([
    __DIR__ "obj/denglong": 1,
    __DIR__ "obj/table": 1,
    __DIR__ "obj/seat": 2,
  ]));

  set("outdoors", 0);
  set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_stand", "stand");
  add_action("do_sit", "sit");
}

int do_sit(string arg) {
  object me;

  me = this_player();

  if (!arg || ((arg != "seat") && (arg != "table")))
    return notify_fail("你要坐在什么上面？\n");

  if (this_player()->query_temp("marks/sit"))
    return notify_fail("你已经坐下了。\n");

  if (arg != "seat")
    return notify_fail("坐桌子上？太不雅观了吧。\n");

  this_player()->set_temp("marks/sit", 1);
  message_vision("$N舒舒服服地在石凳上坐下来，翘起了二郎腿。\n", me);
  return 1;
}

int do_stand(string arg) {
  object me;

  me = this_player();

  if (!this_player()->query_temp("marks/sit"))
    return notify_fail("你本来就站着。\n");

  this_player()->set_temp("marks/sit", 0);
  message_vision("$N伸了个懒腰，站了起来。\n", me);
  return 1;
}



int valid_leave(object me, string dir) {
  me = this_player();

  if (me->query_temp("marks/sit")) {
    message_vision("$N伸了个懒腰，站了起来。\n", me);
    me->set_temp("marks/sit", 0);
  }

  return 1;
}
