#include <ansi.h>

inherit ROOM;
        
void create ()
{     
  set ("short",BCYN RED "十里长亭" NOR);
  set ("long", @LONG

一座小亭，孤零零地守候在大道上。向南是万里之外的长安，
向北隐隐约约可以望见寂寞山庄的楼宇。亭上有一小匾写道：

　　　　　　　　　　十里长亭
        
两边的柱子上有这样两行字：红颜为谁住，芳香伴君还。
      
在这里寂寞山庄的主人曾多少次与他的好友依依惜别。南去
的马车啊，你载走了他多少的梦啊．．．


LONG);

  set("exits", ([
        "southdown" : __DIR__"des1",
        "north" : __DIR__"way1",
      ]));

  setup();
  call_out ("dingdong",30);
}

void dingdong()
{
  object where = this_object();
  string *msgs = ({
    HIC"微风吹过，亭角上的"NOR+HIB"风铃"NOR+HIC"发出一串叮当声。。。\n"NOR,
    HIC"叮当～～叮当～～，"NOR+HIB"风铃"NOR+HIC"发出清脆的声音。\n"NOR,
  });
  tell_room (where,msgs[random(sizeof(msgs))]);
  remove_call_out ("dingdong");
  call_out ("dingdong",random(100)+1);
}
 
 
