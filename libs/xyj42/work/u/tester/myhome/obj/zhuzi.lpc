#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIW "大理石柱子" NOR, ({ "zhu zi" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一根方形的大理石柱子，表面光洁照人。\n");
    set("unit", "根");
    set("value", 0);
    set("material", "stone");
    set("no_get", "这样东西拿不起来！\n");
    set("no_sell", "这样东西不能买卖！\n");
  }
  setup();
}
