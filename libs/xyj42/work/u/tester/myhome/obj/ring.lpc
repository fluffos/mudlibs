#include <dbase.h>
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{

  set_name(HIW"白金戒指" NOR, ({ "jie zhi", "ring"}));
  set_weight(100);
  set("long","一个做工精美的白金戒指，上面刻有三脚猫的名字。\n");
  set("unit", "只");
  set("material", "gold");
  set("wield_msg", HIC"$N翘起修长的无名指，将"+this_object()->name()+HIC"戴在上面。\n"
                  +"然后将手掌来回转着反复看了又看。\n"NOR);
  set("unwield_msg", HIC"$N将"+this_object()->name()+HIC"轻轻地摘下来，收藏好。\n"NOR);
  set("no_sell", 1);
  set("no_get", 1);
  set("no_drop", 1);
  set("weapon_prop/int", 2);
  init_sword(20);
  setup();
}
