#include <dbase.h>
#include <ansi.h>
#include <armor.h>
#include "message.h"

inherit NECK;

void create() {
  seteuid(getuid());

  set_name(BBLU MAG "钻石项链" NOR, ({ "xiang lian", "necklace" }));
  set_weight(100);
  set("long", "一条光华四射的钻石项链，在灯光下发出美丽的光辉。\n");
  set("unit", "条");
  set("armor_prop/armor", 1);
  set("armor_prop/personality", 10);
  set("wear_msg", HIC "$N微微仰起头来，轻轻地将" + this_object()->name() + HIC "绕过自己的颈项。\n"
    + "然后略微低头，将项链后面的搭扣扣好，又对镜照了照。\n" NOR);
  set("unequip_msg", HIC "$N将" + this_object()->name() + HIC "轻轻地摘下来，捧在手中低头吻了一下，再收藏好。\n" NOR);
  set("no_sell", 1);
  set("no_get", 1);
  set("no_drop", 1);
  setup();
}
