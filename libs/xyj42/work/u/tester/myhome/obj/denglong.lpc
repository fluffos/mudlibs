#include <ansi.h>

inherit ITEM;

void create() {
  set_name(BRED GRN "灯笼" NOR, ({ "deng long" }));
  set_weight(20000);
  set("long", "这是一只可以挂起的大灯笼，上面蒙着一层红色绸布。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("material", "cloth");
    set("value", 2000);
    set("no_get", 1);
    set("amount", 30);
  }
  setup();
}
