// 白杨树  tree1.c

#include <ansi.h>

inherit ITEM;

void create()
{
    set_name(GRN"白杨树" NOR, ({ "tree" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("long", "一株高大挺拔的白杨树，正在风中发出哗啦啦的树叶声。\n");
                set("unit", "颗");
                set("value", 0);
                set("material", "wood");
        set("no_get","这样东西拿不起来！\n");
        set("no_sell","这样东西不能买卖！\n");
        }
        setup();
}

init ()
{
  add_action ("do_climb", "climb");
  add_action ("do_climb", "pa");
}

int do_climb (string arg)
{
  object me = this_player();
  object tree = this_object();
    object where = environment(me);
  string *msgs = ({
    HIB"$N灵巧地爬上白杨树，消失在浓密的树叶间．．．n"NOR,
  });


    if (me->is_busy())
        return notify_fail("你正忙着呢！\n");

    if( me->is_fighting() )
        return notify_fail("战斗中不能爬树！\n");
        
  if (arg)
  {
      if (arg!="tree")
        return notify_fail("你要爬什么？\n");

      message_vision (msgs[0],me);
      me->move("/u/tester/myhome/insidetree2");
      return 1;
  }
  else
      return notify_fail("你要爬什么？\n");
}

