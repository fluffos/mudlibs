// shoes.c

#include <armor.h>
#include <ansi.h>

inherit BOOTS;


void create()
{
    set_name(HIC"水晶小鞋"NOR, ({ "shoes" }) );
	set_weight(900);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "一双晶莹剔透的水晶小鞋。\n");
		set("material", "cloth");
		set("unit", "双");
//		set("value", 300);
		set("armor_prop/armor", 1 );
		set("female_only", 1);
        set("no_get","这样东西拿不起来！\n");
//        set("no_give","这样东西不能给别人！\n");
        set("no_drop","这样东西不能丢弃！\n");
        set("no_sell","这样东西不能买卖！\n");
	}
	setup();
}
int query_autoload() { return 1; }
//int query_autoload() { return 1; }
