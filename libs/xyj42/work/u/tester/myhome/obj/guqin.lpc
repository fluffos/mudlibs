#include <ansi.h>
#include <dbase.h>

inherit ITEM;

void create()
{
  set_name(BRED GRN "古琴" NOR, ({ "gu qin","qin"})); 
  set_weight(1000);
  if( clonep() )
     set_default_object(__FILE__);
  else {
     set("long",BCYN HIR"一只雕刻着花纹的古琴"NOR "\n");
     set("unit", "只");
     set("base_value", 10000 );
     set("no_get", 1 );
     set("no_drop", 1 );
     set("no_sell", 1 );
  }
  setup();
}

init ()
{
  add_action ("do_play", "play");
}

int do_play (string arg)
{
  object me = this_player();
  object qin = this_object();
  string *msgs = ({
    BLU"$N轻轻地举起双手搭在琴弦上，十指过处送来徐缓的琴声。\n"
"$N平静的脸上露出一丝微笑，安详的神态仿佛是在回忆昔日与友人共度的时光。\n"NOR,
    BLU"$N双手轻轻地抚动着琴弦，"+qin->name()+BLU"闪烁着暗红色的光华。\n"
    "如泣如诉的琴声让人感觉好象回到了过去一样．．．\n"NOR,
    BLU"琴声变得高亢明快，$N的双手微微颤动。\n"
    +qin->name()+BLU"的声音已经遮盖住了周围的一切声响。\n"NOR,
    BLU"低沉的琴声带着$N的无限情思，缓慢地在空气中流动．．．\n"
    "$N的眼中似乎有着无限的思念与依恋。\n"NOR,
    BLU"无限缠绵的琴声自$N的十指间发出。\n"
    "再看$N竟已完全沉浸在回忆之中．．．\n"NOR,
    BLU"一声轻轻的叹息传来，此刻的$N脸色更加凝重。\n"
    "周围的世界似乎已经不再存在。\n"NOR,
    BLU"一缕伤感的情调慢慢升腾，开始浸润着你的心灵。\n"
    "你看到$N的眼中闪过一丝不易觉察的泪光。\n"NOR,
  });

  if (arg != "gu qin" && arg != "qin")
  {
    tell_object (me,"想演奏什么呢？\n");
    return 1;
  }

  message_vision (msgs[random(sizeof(msgs))],me);
  return 1;
}

