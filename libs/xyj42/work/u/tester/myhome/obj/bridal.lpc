#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(CYN "七彩华纱长裙" NOR, ({ "skirt", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一条色彩鲜艳的七彩华纱长裙，样式轻盈华丽。\n");
    set("unit", "条");
    set("value", 0);
    set("material", "cloth");
    set("armor_prop/armor", 90);
    set("armor_prop/spells", 50);
    set("armor_prop/dodge", 20);
    set("armor_prop/personality", 20);
    set("female_only", 1);
    set("wear_msg", BLU "$N拿起衣架上的" NOR + this_object()->name() +
      BLU "轻轻穿在身上，又对着镜子照了照。\n" NOR);
    set("unequip_msg", BLU "$N脱下身上的" NOR + this_object()->name() +
      BLU "，整理了一下，然后挂在衣架上。\n" NOR);
    set("no_get", "这样东西拿不起来！\n");
    set("no_drop", "这样东西不能丢弃！\n");
    set("no_sell", "这样东西不能买卖！\n");
  }
  setup();
}
