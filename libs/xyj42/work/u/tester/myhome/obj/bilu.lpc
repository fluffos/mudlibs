#include <ansi.h>

inherit ITEM;

void create()
{
    set_name(HIW"壁炉" NOR, ({ "bi lu" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("long", "一个欧洲风格的大壁炉，上面雕刻着花鸟树木图案。\n");
                set("unit", "个");
                set("value", 0);
                set("material", "stone");
        set("no_get","这样东西拿不起来！\n");
        set("no_sell","这样东西不能买卖！\n");
        }
        setup();
}

