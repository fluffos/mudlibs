#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(BMAG GRN"琴凳"NOR, ({ "seat" }));
        set_weight(20000);
        set("long", "这是一只木质雕花琴凳。\n" );
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("material", "wood");
                set("value", 2000);
                set("no_get", 1);
                set("amount",30);
        }
        setup();
}

