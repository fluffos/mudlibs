// Sjmao 1/12/1998   
#include <ansi.h>
#include <dbase.h>
#include <weapon.h>

inherit HAMMER;

void create() {
  set_name(BRED GRN "圣音琵琶" NOR, ({ "pi pa", "qin", "pipa" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", BCYN HIR "一把样式古朴表面雕刻着精美花纹的琵琶，" NOR
      "\n" BCYN HIR "镶嵌着宝石的表面用篆文刻着虹索的名字。" NOR
      "\n" BCYN HIR "据传说关于这把琵琶还有着一个极为动人的" NOR
      "\n" BCYN HIR "故事(story qin)。" NOR "\n");
    set("unit", "把");
    set("base_value", 10000);
    set("no_get", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("wield_msg", MAG "$N左手轻轻地拿起$n" MAG "抱在怀中，\n"
      "右手在弦上滑过，清纯的脸上泛起一丝甜美的微笑。\n" NOR);
    set("unwield_msg",
      MAG "$N将怀中的$n" MAG "轻轻放下，美丽的大眼睛闪动着快乐的光。" NOR "\n");
  }
  init_hammer(200);
  setup();
  call_out("destructqin", 100);
}

init() {
  add_action("do_calltina", "calltina");
  add_action("do_desttina", "desttina");
  add_action("do_play", "play");
  add_action("do_jiqin", "jiqin");
  add_action("do_story", "story");
  add_action("jifight", "jifight");
  add_action("jikill", "jikill");
}

int do_play(string arg) {
  object me = this_player();
  object qin = this_object();
  string *msgs1 = ({
    BLU "$N轻轻地举起右手的弓，" + qin->name() +
    BLU "的琴声徐缓地传来．．．n"
    "$N平静的脸上露出一丝微笑，象是在与远方的朋友互相问安。\n" NOR,
    BLU "$N左手轻轻地揉动着琴弦，" + qin->name() + BLU "闪烁着暗红色的光华。\n"
    "如泣如诉的琴声让人感觉好象回到了过去一样．．．\n" NOR,
    GRN "琴声变得高亢明快，$N拿着弓的右手微微颤动\n"
    +qin->name() + GRN "在$N的肩头竟似有千万斤重。\n" NOR,
    GRN "低沉的琴声带着$N的无限情思，缓慢地在空气中流动．．．\n"
    "$N的眼神似乎正凝视着当年那狱中的一代大师帕格尼尼。\n" NOR,
    HIC "无限缠绵的琴声自$N项上的" + qin->name() + HIC "中发出。\n"
    "再看$N竟已完全沉浸在回忆之中．．．\n" NOR,
    HIC "一声轻轻的叹息传来，此刻的$N脸色更加凝重。\n"
    "周围的世界似乎已经不再存在一样。\n" NOR,
  });

  string *msgs2 = ({
    BLU "$N正沉醉在琴声里。\n"
    BLU "周围的世界似乎已经不再存在一样。\n" NOR,
    HIC "无限缠绵的琴声自$N项上的" + qin->name() + HIC "中发出。\n"
    "再看$N竟已完全沉浸在回忆之中．．．\n" NOR,
  });

  string *msgs3 = ({
    BLU "$N似乎在思念亲人。\n"
    BLU "周围的世界似乎已经不再存在一样。\n" NOR,
    HIC "无限缠绵的琴声自$N项上的" + qin->name() + HIC "中发出。\n"
    "再看$N竟已完全沉浸在回忆之中．．．\n" NOR,
  });


  if (arg != "pi pa" && arg != "qin" && arg != "pipa") {
    tell_object(me, "你想弹奏什么呢？\n");
    return 1;
  }

  if (me->query("id") != "tina" &&
    me->query("id") != "sjmao") {
    tell_object(me, "这把" + qin->name() + "你弹奏不了！\n");
    return 1;
  }

  if (!this_player()->query_temp("donejiqin")) {
    tell_object(me, "你必须先祭这把" + qin->name() + "(jiqin pipa)！\n");
    if (me->query("id") == "enn" || me->query("id") == "sjmao") {
      tell_object(me, "你也可以用＂jifight <对象名字>＂打晕对方，\n");
      tell_object(me, "或者用＂jikill <对象名字>＂杀死对方．\n");
    }
    return 1;
  }


  if ((int)this_player()->query("max_atman") > 0)
    message_vision(msgs1[random(sizeof(msgs1))], me);
  else {
    if (this_player()->query("gender") == "男性")
      message_vision(msgs2[random(sizeof(msgs2))], me);
    else
      message_vision(msgs3[random(sizeof(msgs3))], me);
  };

  return 1;
}

int do_jiqin(string arg) {
  string *done_before;
  int keedecr, keerand;

  if (!this_object()->id(arg)) return 0;
  if (this_player()->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");

  if (!arg) return notify_fail("什么？\n");
  if (arg != "pipa") return notify_fail("你要祭什么？\n");

  if (this_player()->query_temp("donejiqin"))
    return 1;
  if ((int)this_player()->query("max_atman") > 0) {
    message_vision(RED "$N把手指用刀划破，然后将鲜血滴在琴弦上．\n"
      + "血滴碰到琴弦，化作一串晶莹的珠光飞向天际．\n"
      + "你看到$N的脸上忽然掠过一丝哀伤，似乎有点不对了．．．\n" NOR,
      this_player());
  } else {
    if (this_player()->query("gender") == "男性")

      message_vision(GRN "$N拿起桌上的短剑把手指划破，然后将鲜血滴向琴弦．\n"
        + "血滴碰到琴弦，化作一串晶莹的珠光环绕着$N的头．\n"
        + "$N英俊的脸上露出灿烂的笑容．\n" NOR,
        this_player());
    else
      message_vision(GRN "$N拿起怀中的短剑刺向自己的胸口，让鲜血一滴一滴流到琴弦上．\n"
        + "血滴碰到琴弦，顿时化作美丽的花环，环绕在$N的头上．\n"
        + "$N美丽的脸庞生起一缕红晕，倍增娇艳。\n" NOR,
        this_player());
  }

  done_before = this_player()->query_temp("donejiqin");
  if (done_before) {
    return 1;
  } else {
    done_before = ({ "done_before" });
  }
  this_player()->set_temp("donejiqin", done_before);
  keedecr = (int)this_player()->query("kee");
  keerand = random(keedecr / 2);
  this_player()->set("kee", keedecr - keerand);
  this_player()->set("eff_kee", keedecr - keerand + 1);

  return 1;
}
int do_story(string arg) {
  object qin = this_object();
  string *msg = ({
    HIC "你手中的这把" + qin->name() + HIC "相传是当年天宫里的大将\n"
    "三脚猫专门为他的伴侣月宫仙子虹索所制。三脚\n"
    "猫在游览月宫花园的时候遇见虹索，为她的美丽\n"
    "和清纯所倾倒。后来两人兄妹相称，一起潜心修\n"
    "炼。因为多年生活在广寒深宫，虹索的脸色洁白\n"
    "并常常透着冷峻。平常的日子难得见到她，只有\n"
    "偶尔看见虹索与她的三脚猫哥哥在花园中散步。\n"
    "即使这样的时刻你也仍然会看到虹索身上佩带着\n"
    "一把宝剑！如果足够幸运你会听见虹索的琴声。\n"
    "不过据说这琴曾经浸润了魔力，听琴时邪恶的心\n"
    "思会让人受到惩罚！\n"
    "当年三脚猫访遍千山万水才找到一棵合适的树。\n"
    "又用了十年时间学习制作方法。曾得蒙很多仙贤\n"
    "指点。这把" + qin->name() + HIC "可不是平凡乐器。。。\n"
    "\n" NOR,
  });

  if (arg != "qin") {
    tell_object(this_player(), "你要看什么？呢？\n");
    return 1;
  }

  tell_object(this_player(), msg[0]);

  return 1;
}



int query_autoload() { return 1; }


void destructqin() {
  object qin = this_object();
  object where = this_player();
  if (!where)
    where = environment(qin);

  if (where && where->query("id") != "tina" &&
    where->query("id") != "sjmao") {
    message_vision(HIC "只见" + qin->name() + HIC "化作一道冰雪般的光华飞向天际．．．\n" NOR, where);
    destruct(qin);
  }
}
int jikill(string arg) {
  object target, me;
  object env;

  me = this_player();
  if (me->query("id") != "tina" &&
    me->query("id") != "sjmao")
    return notify_fail("你别开玩笑了，这是乐器，不是武器！\n");
  if (!objectp(target = present(arg, environment(me))))
    return notify_fail("什么？\n");

  if (!(target->is_character()))
    return notify_fail("什么？\n");
  if (!living(target))
    return notify_fail("看清楚一点，那并不是活物。\n");
  message_vision("\n$N对着$n喝道：「"
    +RANK_D->query_rude(target) + "！今日不是你死就是我活！」\n\n", me, target);
  me->kill_ob(target);
  target->kill_ob(me);
  target->unconcious();
  return 1;
}

int jifight(string arg) {
  object target, me;
  object env;

  me = this_player();
  if (me->query("id") != "tina" &&
    me->query("id") != "sjmao")
    return notify_fail("你别开玩笑了，这是乐器，不是武器！\n");
  if (!objectp(target = present(arg, environment(me))))
    return notify_fail("什么？\n");

  if (!(target->is_character()))
    return notify_fail("什么？\n");
  if (!living(target))
    return notify_fail("看清楚一点，那并不是活物。\n");
  message_vision("\n$N对着$n说道："
    +RANK_D->query_self(me)
    +me->name() + "，领教"
    +RANK_D->query_respect(target) + "的高招！\n\n", me, target);

  me->fight_ob(target);
  target->unconcious();
  return 1;
}
int do_calltina(string arg) {
  object me = this_player();
  object tina;
  if (me->query("id") != "sjmao")
    return notify_fail("你无权宣招寂寞公主！\n");
  if (!arg)
    return notify_fail("你宣招谁？\n");
  if (objectp(tina = present(arg, environment(me))))
    return notify_fail("寂寞公主已经在这里了！\n");
  message_vision(HIC "\n$N五指轻轻抚动琵琶，仰面向天叹了口气．．．\n"
    + "一时间琴声大作，漫天花雨伴着一道彩虹飞过。\n"
    + "只听得空中有一个女子娇声道：表哥叫我呀～～\n"
    + "你再看时发现寂寞公主手持宝剑从天而降。\n\n" NOR, me);
  tina = new("/u/tester/myhome/npc/princess");
  tina->move(environment(me));
  return 1;
}

int do_desttina(string arg) {
  object me = this_player();
  object tina;
  if (me->query("id") != "sjmao")
    return notify_fail("你为什么要为寂寞公主送行？\n");
  if (!arg)
    return notify_fail("你为谁送行？\n");
  if (!objectp(tina = present(arg, environment(me))))
    return notify_fail("寂寞公主不在这里！\n");
  message_vision(HIC "\n$N轻声对寂寞公主说道：表妹早点休息吧，天已很晚。\n"
    + "只见寂寞公主略一迟疑，回过头来亲了$N一下。\n"
    + "琴声响起，彩虹当空，寂寞公主已经随着歌声而去。。。\n\n" NOR, me);
  destruct(tina);
  return 1;
}
