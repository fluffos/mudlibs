#include <ansi.h>

inherit NPC;

void create() {
  set_name(HIY "金鲤鱼" NOR, ({ "jin li", "li", "fish" }));
  set("race", "野兽");
  set("long", "一条金翅鲤鱼，正在水中游来游去。\n");
  set("combat_exp", 1000);
  set("per", 29);
  set("str", 25);
  set("age", 10);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("chat_chance", 10);
  set("chat_msg", ({
    query("name") + "在你身边游来游去，一点都不怕你。\n",
    query("name") + "优雅地打了个水花，从你身边游开了。\n",
    (: random_move :)
  }));
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite", "poke", "slap" }));

  setup();
}
