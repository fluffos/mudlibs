// Longweishi.c
// Sjmao...09-13-97
#include <ansi.h>

inherit NPC;

void create() {
  set_name("龙宫卫士", ({ "longwei shi", "wei shi", "shi", "guard" }));
  set("gender", "男性");
  set("age", 30);
  set("long",

    "这是位守护南海龙宫的卫士，身披亮银甲，手执长枪。
他双目精光炯炯，警惕地巡视着台阶四周的情形。\n");
  set("combat_exp", 130000);
  set("attitude", "heroism");
  set("str", 25);
  set("max_kee", 750);
  set("max_sen", 600);
  set("force", 400);
  set("max_force", 400);
  set("force_factor", 15);
  set_skill("spear", 80);
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("force", 50);
  setup();

  carry_object("/d/obj/weapon/spear/changqiang")->wield();
  carry_object("/d/obj/armor/yinjia")->wear();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) &&
    (int)ob->query_condition("killer")) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
  }
}

int accept_fight(object me) {
  message_vision("龙宫卫士对$N大喝一声：你活得不耐烦了？龙宫前也敢胡闹！\n", me);
  me->apply_condition("killer", 100);
  kill_ob(me);
  return 1;
}
