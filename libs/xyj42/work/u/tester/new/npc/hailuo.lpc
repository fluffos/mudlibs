inherit NPC;

void create() {
  set_name("扇贝", ({ "shan bei", "bei", "fish" }));
  set("race", "野兽");
  set("long", "一只大扇贝，正在海底慢慢地爬行。\n");
  set("combat_exp", 1100);
  set("per", 19);
  set("str", 19);
  set("age", 8);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("chat_chance", 10);
  set("chat_msg", ({
    "大扇贝悄悄地爬到了你的脚边，把你吓了一跳！\n",

    (: random_move :)
  }));
  set("limbs", ({ "头部", "贝壳", "身体" }));
  set("verbs", ({ "bite" }));

  setup();
}
