#include <skill.h>

inherit NPC;


void create() {
  set_name("敖钦", ({ "ao qin", "ao", "qin", "longwang", "wang" }));

  set("long", "南海的龙王，掌管着南海，是四海龙王中的老二．\n");
  set("gender", "男性");
  set("age", 60);
  set("title", "南海龙王");
  set("class", "dragon");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 1120000);
  set("rank_info/respect", "陛下");
  set("per", 20);
  set("str", 30);
  set("max_kee", 3000);
  set("max_gin", 400);
  set("max_sen", 800);
  set("force", 3000);
  set("max_force", 1500);
  set("force_factor", 120);
  set("max_mana", 800);
  set("mana", 1600);
  set("mana_factor", 40);
  set("chat_msg", ({
    "南海龙王闷闷不乐地说道：很久不见大哥了，不知该拿那顶帽子怎么办。\n",
    "南海龙王面露畏惧，悄悄的说道：若是那猴子扛着那个破棒子来，我可怎么挡得住他？\n",
    "南海龙王长叹一声：总在我这放着也不是办法呀！\n",
  }));
  set("chat_chance", 1);
  set_skill("literate", 120);
  set_skill("unarmed", 200);
  set_skill("dodge", 120);
  set_skill("force", 180);
  set_skill("parry", 180);
  set_skill("spear", 150);
  set_skill("spells", 120);
  set_skill("seashentong", 150);
  set_skill("dragonfight", 200);
  set_skill("dragonforce", 150);
  set_skill("bawang-qiang", 180);
  set_skill("dragonstep", 150);
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("spear", "bawang-qiang");
  map_skill("parry", "bawang-qiang");
  map_skill("dodge", "dragonstep");

  setup();

  carry_object("/d/sea/obj/longpao")->wear();
}
void init() {
  ::init();
}
