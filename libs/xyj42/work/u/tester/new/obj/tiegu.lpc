// sjmao 12/21/97
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(BLU"铁鼓"NOR, ({"tie gu","gu","drum"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "面");
                set("value", 200000);
                set("long", "一面大铁鼓，上面长满了铁锈。\n");
                set("material", "iron");
                set("no_get",1);

        }
        setup();
}

int init()
{
  add_action ("do_drum","qiao");
  return 1;
}
int do_drum (string arg)
{
  object me = this_player();
  int pot_to_add;
  string *msgs;
  if (arg != "tie gu")
  {
    tell_object (me,"你想敲什么？\n");
    return 1;
  }

  msgs = ({
    "只见$N举起大锤，用力向" +this_object()->name(1)+ "敲去。。。\n",
  });
  message_vision (msgs[random(sizeof(msgs))],me);
  if (me->query("combat_exp") < 300000)
  {
 me->add("kee",-me->query("kee")*4/10-random(10));
  me->add("sen",-me->query("sen")*4/10-random(10));
  me->save();
  msgs = ({
     this_object()->name(1)+ "发出「咚」的一声巨响，$N倒退了好几步才站稳。\n",
  });
  message_vision (msgs[random(sizeof(msgs))],me);
  }
  else
  {
  pot_to_add = random(10);
  if ( (me->query("potential") - 36683) == 100)
  {
  msgs = ({
   this_object()->name(1)+ "发出清脆的「咚咚」声。\n",
  });
  message_vision (msgs[random(sizeof(msgs))],me);
  }
  else
  {
  if ( (pot_to_add + me->query("potential") - 36683) < 100)
    me->add("potential",pot_to_add);
  else
     me->add("potential",100 + 36683 - me->query("potential"));
  msgs = ({
     this_object()->name(1)+ "发出清脆的「咚咚」声。\n",
    "$N的潜能增加了！\n",
  });
  message_vision (msgs[random(sizeof(msgs))],me);
  me->add("kee",-me->query("kee")*5/10-4*random(10));
  me->add("sen",-me->query("sen")*5/10-4*random(10));
  me->save();
  }
  }
  return 1;
}

