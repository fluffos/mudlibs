// sjmao 12/20/97
#include <ansi.h>
#include <armor.h>
inherit EQUIP;

void create() {
  set_name(HIY "锁子黄金甲" NOR, ({ "suozi jia", "armor", "jia" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "副");
    set("value", 200000);
    set("long", "一副金线织成的锁子黄金甲。\n");
    set("material", "cloth");
    set("armor_type", "cloth");
    set("armor_prop/spells", 20);
    set("armor_prop/armor", 80);

  }
  setup();
}

void init() {
  if (!wizardp(this_player())) {
    set("no_drop", "这么好的宝物，扔了多可惜呀！\n");
    set("no_give", "这么好的宝物，留着自己用吧！\n");
    set("no_sell", 1);
  }
}
