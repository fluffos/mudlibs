// Sjmao.. 09-21-97
inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("八宝夜光杯", ({ "yeguang bei", "bei", "glass" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "杯体散发出柔和的光辉，晶莹剔透．\n");
    set("unit", "个");
    set("value", 120);
    set("max_liquid", 100);
    set("liquid_supply", 80);
  }

  set("liquid", ([
    "type": "wine",
    "name": "七色葡萄酒",
    "remaining": 90,
  ]));
  setup();
}
