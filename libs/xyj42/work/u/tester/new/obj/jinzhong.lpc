// sjmao 12/20/97
#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "金钟" NOR, ({ "jin zhong", "zhong", "bell" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "口");
    set("value", 200000);
    set("long", "一口巨大的金钟。\n");
    set("material", "gold");
    set("no_get", 1);

  }
  setup();
}

int init() {
  add_action("do_zhuang", "zhuang");
  return 1;
}
int do_zhuang(string arg) {
  object me = this_player();
  string *msgs;
  if (arg != "jin zhong") {
    tell_object(me, "你想撞击什么？\n");
    return 1;
  }

  msgs = ({
    "只见$N拉过大木桩，用力向" + this_object()->name(1) + "撞去。。。\n",
  });
  message_vision(msgs[random(sizeof(msgs))], me);
  if (me->query("combat_exp") < 300000) {
    me->add("kee", -me->query("kee") * 3 / 10 - random(10));
    me->add("sen", -me->query("sen") * 3 / 10 - random(10));
    me->save();
    msgs = ({
      this_object()->name(1) + "发出震耳欲聋的嗡嗡声，$N顿时头晕目眩。\n",
    });
    message_vision(msgs[random(sizeof(msgs))], me);
  } else {

    me->add("combat_exp", random(10));
    me->add("kee", -me->query("kee") * 4 / 10 - 3 * random(10));
    me->add("sen", -me->query("sen") * 4 / 10 - 3 * random(10));
    me->save();
    msgs = ({
      this_object()->name(1) + "发出悦耳的声响。\n",
      "$N的道行增加了！\n",
    });
    message_vision(msgs[random(sizeof(msgs))], me);
  }
  return 1;
}
