// sjmao 12/20/97
#include <ansi.h>
#include <armor.h>
inherit EQUIP;

void create()
{
        set_name(BLU"凤翅紫金冠"NOR, ({"zijin guan","guan","armor"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顶");
                set("value", 200000);
                set("long", "一顶紫金铸成的头盔。\n");
                set("material", "gold");
                set("armor_type", "gold");
                set("armor_prop/spells", 20);
                set("armor_prop/armor", 80);
                set("wear_msg", "淡蓝色的光辉一闪，再定睛看时，$N头上已经多了一顶$n！\n");

        }
        setup();
}

void init()
{
  if (!wizardp(this_player()))
  {
      set("no_drop","这么好的宝物，扔了多可惜呀！\n");
      set("no_give","这么好的宝物，留着自己用吧！\n");
      set("no_sell", 1);
  }
}

