// Room of nanhai, 敖钦's room.
// sjmao, 09-13-97
#include <room.h>

inherit ROOM;

int valid_leave(object me, string dir);

void create() {
  set("short", "南海龙宫正殿");
  set("long", @LONG

南海龙宫正殿是敖钦住所。殿中悬挂着许多奇珍异宝。东西
两边各有一座偏殿。从面向北方的殿门可以看到一条笔直的
大道，两旁都有护卫的虾兵蟹将执枪站岗。殿的南面好象有
一扇门，不知道里边是什么。
LONG);

  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/aoqin.lpc": 1,
  ]));
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "piandian3",
    "west": __DIR__ "piandian1",
    "east": __DIR__ "piandian2",
    "north": __DIR__ "menting",
  ]));

  create_door("south", "白玉门", "north", DOOR_CLOSED);
  set("outdoors", 0);
  set("no_clean_up", 0);
  set("valid_startroom", 1);
  setup();
}
int valid_leave(object me, string dir) {
  if (dir == "south") {
    if (objectp(present("ao qin", environment(me))))
      if (!objectp(present("jingu bang", me)))
        return notify_fail("龙王敖钦拦住你说：后殿乃小王的寝宫，" + RANK_D->query_respect(me) + "还是不要进去为好！\n");
  }
  return ::valid_leave(me, dir);
}
