

#include <ansi.h>
#include <room.h>
inherit ROOM;

int do_stand(string temp2);
int do_sit(string temp3);
int do_out(object ob);

void create()
{
        set("short", BBLU RED"寂寞画廊"NOR);

	set("long", @LONG

昔日曾经闻名一时的画廊，现在已经人去楼空．满眼看到的
都是干了的画笔和丢得到处都是的画布．两张工作台上还放
着剩下的颜料．地板上有一片破旧的毛毯．四下里到处都积
满了灰尘．房子正中的画架上有一幅尚未完成的画．看得出
主人的心志已经不再能够继续完成，给人留下的是一个略带
缺憾的想象的天空．．．


LONG
	);

	set("valid_startroom",1);


	set("exits", ([
    "north" : "/d/city/kezhan",
    "south" : "/d/moon/xiaoyuan",
	]));

  set("objects", ([ 
               "/d/ourhome/obj/table" : 1,
               "/d/ourhome/obj/seat" : 2,
        ]));
                                              
	set("no_clean_up", 0);
      
        set("sleep_room",1);
        set("if_bed",1);
	setup();     
}

void init()
{
	add_action("do_stand", "stand");
	add_action("do_sit", "sit");
    add_action("do_receive_mail", "mailbox");
}

int do_sit(string arg)
{     
      object me;

      me=this_player();

	if ( !arg || ((arg != "seat")&&(arg != "table") ))
		return notify_fail("你要坐在什么上面？\n");	
	
	if (this_player()->query_temp("marks/sit"))
		return notify_fail("你已经坐下了。\n");	
      
      if ( arg != "seat")	
	      return notify_fail("坐桌子上？太不雅观了吧。\n");
        	
	this_player()->set_temp("marks/sit", 1);
	message_vision("$N舒舒服服地在石凳上坐下来，翘起了二郎腿。\n",me);
      return 1;	
}

int do_stand(string arg)
{
      object me;

      me=this_player();

      if (!this_player()->query_temp("marks/sit"))
          return notify_fail("你本来就站着。\n");

      this_player()->set_temp("marks/sit", 0);
      message_vision("$N伸了个懒腰，站了起来。\n", me);
      return 1;
}



void do_receive_mail()
{
        object mbox;

        if( this_player()->query_temp("mbox_ob") )
		return notify_fail("你的信箱还在吧？你所有的信都在里面。\n");
        seteuid(getuid());
        mbox = new(MAILBOX_OB);
        mbox->move(this_player());
        return notify_fail("你得到了你的信箱。\n");
}


int valid_leave(object me, string dir)
{
	object mbox;

	if( mbox = me->query_temp("mbox_ob") ) {
		tell_object(me, "你将信箱交回给邮差。\n");
		destruct(mbox);
	}
	return 1;
}

