#include <armor.h>
#include <ansi.h>
inherit FINGER;

void create() {
  set_name(RED "大红宝石戒指" NOR, ({ "jie zhi", "jie", "ring" }));
  set("weight", 400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("value", 120000000);
    set("material", "gold");
    set("armor_prop/armor", 1);
    set("armor_prop/armor", 1);
    set("long", "这是一枚名贵的大红宝石戒指。\n");
    set("wear_msg", "$N将" RED "大红宝石戒指" NOR "轻轻的戴在指上。\n");
    set("unequip_msg", "$N将" RED "大红宝石戒指" NOR "从指上摘了下来。\n");
  }
  setup();
}
int is_container() { return 1; }
int query_autoload() { return 1; }
