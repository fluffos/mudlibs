#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create()
{
    set_name( HIY "纯丝金边绸袍" NOR, ({"jin pao", "pao", "cloth" }));
        set("weight", 400);
        if (clonep())
                set_default_object(__FILE__);
else {
     set("unit", "件");
                set("value", 120000000);
                set("material", "cloth");
                set("armor_prop/armor", 1);
                set("armor_prop/armor", 1);
    set("long", "这是一件上等的纯丝金边绸袍。\n");
}
setup();
}

int is_container() { return 1; }
int query_autoload() { return 1; }
