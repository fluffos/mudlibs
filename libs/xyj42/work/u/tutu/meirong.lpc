// meirong.c 美容丹

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_get", "嘿嘿，做梦吧! \n");
    set("no_drop", "这么宝贵的美容丹，哪能乱扔! \n");
  }

  add_action("do_eat", "eat");
}

void create() {
  set_name(HIG "美容丹" NOR, ({ "meirong dan", "dan" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "粒");
    set("long", "一粒美容丹，据说是月宫之主嫦娥美容之珍藏。\n");
    set("value", 100000);
  }

  set("is_monitored", 1);
  setup();
}

int do_eat(string arg) {
  object victim = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  victim->add("per", 1);
  message_vision(HIG "\n$N吃下一粒美容丹，感觉突然漂亮了好多\n\n" NOR, victim);
  destruct(this_object());
  return 1;
}
