  if(ob->query_temp("onhorse"))
  {
  message_vision("\n$N身行一转，跃下车来，姿态十分优美。\n" , ob );
  delete("rider");
   ob->delete_temp("apply/msg_mout");
   ob->delete_temp("apply/msg_min");
  ob->delete_temp("onhorse");
	ob->delete_temp("apply/short");
	ob->delete_temp("apply/long");
	this_object()->move(environment(ob));
 set_weight(30000000);
  }
  else 
  switch(random(3))
  {
   case 0: 
   message_vision("\n$N一把把车上的人拉下来，想自己跳上去。\n" , ob );
