#include <ansi.h>

inherit ITEM;
void create()
{
	set_name(HIC "激光１０００Ｃ" NOR, ({ "moto"}));
	set("long", "这是一辆ＢＭＷ出产的激光１０００Ｃ电单车。\n"+
		"玩家可以骑上它去任何地方(ride/down)。\n");
        set_weight(30000000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "辆");
//		set("value", 50000000000);
              set("no_drop", "你如果要下车可以用(down).\n");
              set("no_get", 1);
        }

	setup();
}

void init()
{
 add_action("do_ride", "ride");
 add_action("do_go", "go");
 add_action("do_down", "down");
 add_action("do_up", "up");
 add_action("do_enter", "enter");
}


int do_ride ( )
{
    string dir,dir2;
    object ob = this_player () ;
    if(ob->query("force")< 10000 )
    {
      message_vision("$N一跃身跨上了一辆"HIC"激光１０００Ｃ"NOR"电单车，突然猛然一颠...\n"
                     HIR "把$N狠狠摔在了地上,结果$N受了点轻伤。\n" NOR,ob);
      ob -> receive_damage ("kee",50) ;
      ob -> receive_wound  ("kee",50) ;
      remove_call_out("kill_ob");
      call_out("kill_ob", 1, ob);
      return 1;
    }
   if( objectp(query("rider"))) 
  {
   return notify_fail("现在车上已经有人了！\n" ) ;
  }
   else
   ob->set_temp("apply/msg_mout","一呼油，"HIC"激光１０００Ｃ"NOR"向前急驰而去。" );
   ob->set_temp("apply/msg_min","骑着"HIC"激光１０００Ｃ"NOR"急奔而来。" );
   ob->set_temp("onhorse",1);
   this_object()->set("rider",this_player());
   message_vision("$N一跃身跨上了"HIC"激光１０００Ｃ"NOR"。\n" , ob );
   this_object()->set_leader(this_player());
   set_weight(1);	
	ob->set_temp("apply/short", ({(string)ob->query("title")+" "+(string)ob->query("name")+"骑在一部"HIC"激光１０００Ｃ"NOR"上面 ("+(string)ob->query("id")+")"}));
	ob->set_temp("apply/long", ({(string)ob->query("name")+"骑在一部"HIC"激光１０００Ｃ"NOR"上面，说不出的有型潇洒。\n"}));
      this_object()->move(ob);
    
   write("请输入要去的地名, 示例(go changan):\n"+
   "changan: 长安\n"+
   "guobin:国宾观\n"
   );
   return 1; 
  	
}

int do_down()
{
  object ob;
  ob = this_player () ;
  if(!objectp(query("rider"))) return notify_fail("车上没人。\n");
  if(ob->query_temp("onhorse"))
  {
  message_vision("\n$N身行一转，跃下车来，姿态十分优美。\n" , ob );
 delete("rider");
  ob->delete_temp("onhorse");
   ob->delete_temp("apply/msg_mout");
   ob->delete_temp("apply/msg_min");
	ob->delete_temp("apply/short");
	ob->delete_temp("apply/long");
	this_object()->move(environment(ob));
 set_weight(30000000);
  }
  else 
  switch(random(3))
  {
   case 0: 
   message_vision("\n$N一把把车上的人拉下来，想自己跳上去。\n" , ob );
   command("follow none");
   query("rider")->delete_temp("onhorse");
   delete("rider");
   ob->set_temp("onhorse");
   break;
   case 1: 
   case 2:
   message_vision("\n$N想把车上的人拉下车来,但没有成功。\n" , ob );
   }	  
  return 1;
 }
