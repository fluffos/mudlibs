// kokojia.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
set("short", "口口花店");
set("long", @LONG
这里是口口开的一间小花店，虽然店铺小，但生意却异常兴旺。你一进门一阵淡淡的清香渗入你的心扉，店铺四处摆满了各式各样的鲜花，自从青鸟嫁于口口后，小两口 恩恩爱爱，齐心打理着这间小花店，生意越做越旺。门边放着一块牌子（sign）。
LONG
);
set("valid_startroom", 1);
set("item_desc", ([
"sign": (: look_sign :),
]) );
set("exits", ([
"down"    : "/d/city/kezhan",
]) );
setup();
}
string look_sign(object me)
{
if( wizardp(me) )
return "招牌写著：口口花店。现诚征卖花服务生数名，有意者可(join)，警告（名号将会改变)\n";
else
return "招牌写著：口口花店。现诚征卖花服务生数名，有意者可(join)，警告（名号将会改变)\n";
}
void init()
{
add_action("do_join", "join");
}
int do_join(string arg)
{
object me;
me = this_player();
me->set("title", "口口花店服务生");
write("\n口口说道：从今以后可要努力干哦，以后每月工资50 gold，到时记住问我拿，我怕到时忘了！\n\n");
return 1;
}
//q
