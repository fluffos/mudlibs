#include <ansi.h>
inherit ITEM;
void create()
{
set_name(HIC "激光１０００Ｃ" NOR, ({ "moto"}));
set("long", "这是一辆ＢＭＷ出产的激光１０００Ｃ电单车。\n"+
"玩家可以骑上它去任何地方(qi/xia)。\n");
        set_weight(30000000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "辆");
              set("no_drop", "你如果要下车可以用(xia).\n");
              set("no_get", 1);
        }
setup();
}
void init()
{
 add_action("do_ride", "ride");
 add_action("do_xia", "xia);
 add_action("do_go", "go");
 add_action("do_qi", "qi");
}
int do_qi ( )
{
    string dir,dir2;
    object ob = this_player () ;
   if( objectp(query("qi"))) 
  {
   return notify_fail("现在车上已经有人了！\n" ) ;
  }
   else
   ob->set_temp("moto",1);;
   this_object()->set("rider",this_player());
   message_vision("$N一跃身跨上了"HIC"激光１０００Ｃ"NOR"。\n" , ob );
   this_object()->set_leader(this_player());
   set_weight(1);
	ob->set_temp("apply/short", ({(string)ob->query("title")+" "+(string)ob->q
uery("name")+"骑在一部"HIC"激光１０００Ｃ"NOR"上面 ("+(string)ob->query("id")+")
"}));
	ob->set_temp("apply/long", ({(string)ob->query("name")+"骑在一部"HIC"激光
１０００Ｃ"NOR"上面，说不出的有型潇洒。\n"}));
      this_object()->move(ob);
   write("你要去哪？\n");
   return 1; 
}
int do_xia()
{
  object ob;
  ob = this_player () ;
  if(!objectp(query("rider"))) return notify_fail("车上没人。\n");
  {
  message_vision("\n$N身行一转，跃下车来，姿态十分优美。\n" , ob );
 delete("rider");
ob->delete_temp("apply/short");
ob->delete_temp("apply/long");
this_object()->move(environment(ob));
 set_weight(30000000);
  }
  return 1;
 }
