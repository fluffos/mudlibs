// mantou.c 白面馒头
#include <ansi.h>

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name(HIW "白面馒头" NOR, ({ "man tou", "man", "mantou" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个白花花、香喷喷的白面馒头!\n");
    set("unit", "个");
    set("value", 50);
    set("food_remaining", 3);
    set("food_supply", 60);
  }
}
