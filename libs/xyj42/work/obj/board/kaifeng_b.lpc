// kaifeng_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("铁塔留言壁", ({ "board" }) );
	set("location", "/d/kaifeng/tieta");
        set("board_id", "kaifeng_b");
        set("long","铁塔下一块留言壁，上面写满了字。\n" );
        setup();
        set("capacity", 80);
        replace_program(BULLETIN_BOARD);
}

