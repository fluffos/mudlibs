// /clone/board/bonze_b.c

#include "ansi.h"

inherit BBS_BOARD;

void create()
{
	set_name("害虫俱乐部"+HIG+" BBS "+NOR+"新闻试用板", ({ "board" }) );
	set("location", "/d/snow/temple");
	set("board_id", "bbs_b");
	set("long", "这是一个供害虫俱乐部各位害虫们交流讨论的"+HIG+" BBS "+NOR+"板。\n" );
	setup();
	set("capacity", 30);
	replace_program(BBS_BOARD);
}
