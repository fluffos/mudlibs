#include <ansi.h>

inherit BULLETIN_BOARD;

void create()
{
        set_name(BBLU RED"紫水晶"NOR, ({ "crystal","board" }) );
    set("location", "/d/sea/inside3");
        set("board_id", "longgong_b");
        set("long","一块紫色的水晶石，是龙宫弟子留言用的。\n" );
        setup();
        set("capacity", 80);
        replace_program(BULLETIN_BOARD);
}

