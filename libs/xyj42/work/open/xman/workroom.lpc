// Room: /open/xman/wookroom.c
#include <ansi.h>

inherit ROOM;

void init()
{
        add_action("do_ti", "ti");
}

void create()
{
	set("short", "跆拳道联盟总道场");
	set("long", @LONG
这是黑带练功和授课的地方，每星期一到上课的时候，总有五六十人在这里练功。
地上是和大体育馆一样的木地板，擦得照得见人影，墙角放着一些鸡腿形手靶(jitui)、头盔、
护甲、枕形靶等东西，是在练习时拿来做目标的。墙(wall)上挂着各位教练的段位证书和照片。
LONG
	);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 3 */
  "down" : "/d/wiz/entrance",
  "north" : "/d/wiz/wizroom",
  "east" : "/d/city/kezhan",
]));

set("item_desc" , ([ /* sizeof() == 4 */
"north": "房子里云雾缭绕，什么也看不清楚。\n",
"jitui":"这是一个鸡腿形手靶，你可以让师兄弟帮你拿着来练习(ti)头部横扫腿。\n",
"wall":"墙上挂着黑带的师傅，太师傅，师弟和他自己的练功照片(photo)，当然还有奖状。\n",
"photo":"黑带正以一个凌空侧踢的姿势飞过五个人组成的人墙，满脸得意的表情。\n",
]));
    set("no_fight", 1);
    set("no_magic", 1);
    set("sleep_room",1);
    set("if_bed",1);
	setup();
}
int valid_leave(object me, string dir)
{
     if( dir=="north" && !wizardp(me) )
           return notify_fail("那里只有巫师才能进去。\n");
     if( dir=="down" && !wizardp(me) )
           return notify_fail("你的仙术不够高，跳下去会摔死的。\n");
       return ::valid_leave(me, dir);
}
int do_ti(string arg)
{
        object me;
        me=this_player();

        if ( !arg || ((arg != "jitui") ))
                return notify_fail("你想踢谁？\n");

        message_vision("$N右脚退后，双手握拳，拧腰旋身，“呼”的一脚踢向对手头部位置的鸡腿！\n",me);
        if((int)me->query_skill("unarmed",1) < 50) {
                me->improve_skill("unarmed", 20);
                me->receive_damage("kee", 10);
                message_vision("只听“啪”的一声，踢中了鸡腿的边缘，$N感觉腰部有点酸软！\n", me);
        }
        else {
                message_vision("$N一脚正中鸡腿，拿靶的师兄一个手软，鸡腿飞出去老远！众师弟鼓掌喝彩！\n", me);
                message_vision("$N的腿法已经练成了！\n", me);
        }
   return 1;
}
