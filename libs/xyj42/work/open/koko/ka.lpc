#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIC "改名卡" NOR, ({ "ka"}));
   set("long", "这是一张改名卡。\n");
        set_weight(3);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
        }

  setup();
}

void init()
{
 add_action("do_go", "gai");
}

int do_go ( string arg )
{
   object ob ;
   ob = this_player () ;
   if( !arg || arg=="" )  return notify_fail("你要改什么？\n");
  else
   ob->set("name",arg);

   return 1;
}
