// workroom.c.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
set("short", "口口花店");
set("long", @LONG
这里是口口开的一间小花店，虽然店铺小，但生意却异常兴旺。你一进
门，一阵淡淡的清香渗入你的心扉，店铺四处摆满了各式各样的鲜花，自从青
鸟嫁于口口后，小两口 恩恩爱爱，齐心打理着这间小花店，生意越做越旺。
门边放着一块牌子（sign）。
LONG
);
set("item_desc", ([
"sign": (: look_sign :),
]) );
set("exits", ([
"down"    : "/d/city/kezhan",
]) );
        set("objects", ([ /* sizeof() == 2 */
  "/open/koko/waiter.lpc" : 2,
]));

  set("no_fight", 1);
 set("no_magic", 1);
setup();
}
string look_sign(object me)
{
if( wizardp(me) )
return "招牌写著：口口花店。现诚征卖花服务生数名，有意者可(join)\n";
else
return "招牌写著：口口花店。现诚征卖花服务生数名，有意者可(join)\n";
}
void init()
{
add_action("do_join", "join");
add_action("do_work", "work");
}
int do_join(string arg)
{
object me;
me = this_player();
write("\n口口说道：从今以后可要努力干哦，工作(work)一次一两金的哦！\n\n");
me->set("job", "口口花店");
return 1;
}
int do_work(string arg)
{
object me , ob;
me = this_player();
ob = new("/obj/money/gold.lpc");
       if(me->is_busy())
       return notify_fail("你正在做着呢，急什么？！\n");
if((int)me->query("sen")<20)
return notify_fail("你快累死了，休息一下吧。 \n");
if((int)me->query("kee")<20)
     return notify_fail("你快累死了，休息一下吧。 \n");
        if ((time()-me->query("last_work"))<90)
return notify_fail("你刚工作完，还是休息一下吧，这样做法很容易出人命的。 \n");
else
if((string)me->query("job")=="口口花店")
{
        me->disable_player("<工作中>");
     message_vision("$N穿上工作服站在柜台前面发起呆来！\n",me);
me->start_busy(30+random(5));
me -> receive_damage ("sen", 20);
me -> receive_damage ("kee", 20);
ob->move(me);
                me->set("last_work",time());
ob->move(me);
ob->move(me);
ob->move(me);
}
return 1;
}
