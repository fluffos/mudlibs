inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("女服务生", ({ "fuwu sheng", "sheng", "waiter" }));
  set("title", "口口花店服务生");
  set("gender", "女性");
  set("combat_exp", 500);
  set("age", 16);
  set("per", 35);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 100);
  set("vendor_goods", ([
    "hualan": "/open/koko/hualan.lpc",
  ]));
  set("inquiry", ([
    "here": "你不识字的吗？门上不是写着口口花店嘛？嘻嘻。。。\n",
    "name": "你真坏，一来就问人家名字，我才不告诉你呢。嘻嘻。。\n",
    "rumors": "近来我们花店招人耶，加入我们花店吧。\n",
    "koko": "他是我们的老板耶，长的高大英俊，是我的偶像耶！！ \n",
    "口口": "他是我们的老板耶，长的高大英俊，是我的偶像耶！！ \n",
    "qing": "她是我们的老板娘，也长的很美的，我们可没法和她比！！ \n",
    "青鸟": "她是我们的老板娘，也长的很美的，我们可没法和她比！！ \n",
    "flower": "想买花吗？一两金两朵，还附送一个花篮呢！！\n",
    "花": "想买花吗？一两金两朵，还附送一个花篮呢！！\n",
    "鲜花": "想买花吗？一两金两朵，还附送一个花篮呢！！\n",
    "买花": "想买花吗？一两金两朵，还附送一个花篮呢！！\n",
    "卖花": "近来我们花店招人耶，加入我们花店吧。\n",
    "打工": "近来我们花店招人耶，加入我们花店吧。\n",
    "赚钱": "近来我们花店招人耶，加入我们花店吧。\n",
    "钱": "近来我们花店招人耶，加入我们花店吧。\n",
  ]));
  set("chat_chance", 9);
  set("chat_msg", ({
    "女服务生望了望你，嘻嘻的笑了几声。\n",
    "女服务生对你微笑的说道：买花吗？\n",
    "女服务生说道：加入我们店吧，人工高，福利好，而且我们的老板口口和老板娘青鸟很好人的哦。\n",
  }));
  setup();
  carry_object("/d/qujing/qinfa/npc/obj/choupao")->wear();
  add_money("silver", 10);
}
void init() {
  add_action("do_vendor_list", "list");
}
