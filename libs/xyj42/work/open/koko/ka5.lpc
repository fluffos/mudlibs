#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIC "专职服务生卡" NOR, ({ "ka" }));
  set_weight(3);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
  }

  setup();
}

void init() {
  add_action("do_go", "gai");
}

int do_go() {
  object ob;
  ob = this_player();
  ob->set("title", "口口花店服务生");
  return 1;
}
