#include <ansi.h>
inherit ITEM;
void create()
{
 set_name(HIC "口口专用改法力卡" NOR, ({"ka"}));
 set_name(HIC "口口专用改法力卡" NOR, ({"ka"}));
        set_weight(3);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
        }

  setup();
}

void init()
{
 add_action("do_go", "gai");
}

int do_go ()
{
   object ob ;
   ob = this_player () ;
ob->set("max_mana", 100000);
ob->set("mana", 100000);
   return 1;
}
