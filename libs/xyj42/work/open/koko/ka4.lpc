#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIC "改门派卡" NOR, ({ "ka" }));
  set("long", "一张改门派的卡。\n");
  set_weight(3);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
  }

  setup();
}

void init() {
  add_action("do_go", "gai");
}

int do_go(string arg) {
  object ob;
  ob = this_player();
  if (!arg || arg == "") return notify_fail("你要改什么？\n");
  else
    ob->set("family/family_name", arg);
  ob->set("family/generation", 1);
  ob->set("family/title", "大老板");
  ob->set("rank_info/respect", "大老板");

  return 1;
}
