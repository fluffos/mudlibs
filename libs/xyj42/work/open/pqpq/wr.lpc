#include <ansi.h>
#include <room.h>
inherit ROOM;

void init()
{
        add_action("do_shang", "shang");
}

void create()
{
        set("short", BCYN RED"公共厕所"NOR);

	set("long", @LONG

这是一件五星级的单人厕所，装修豪华，配有音像、桑拿、按摩、美容
等各种设备。使您一进来精神就会为之一爽，并冒出一个疑问。这是厕
所吗？
LONG
	);
	set("sleep_room",1);
	set("if_bed",1);

	set("exits", ([
    "down" : "/d/city/kezhan",
	]));
	set("no_clean_up", 0);
      
	setup();     

}

int do_shang(string arg)
{
        object me = this_player();
       if (!arg || arg != "cesuo")
       {
        message_vision ("你要上什么? \n",me);
        return 1;
       }
       if ( me->is_busy())
       {
        message_vision ("    哈哈，$N，你急了才来上厕所? \n",me);
        return 1;
       }
	me->start_busy( 8 + random(2) );
       if((int) me->query_temp("xhw_eated"))
       {
        me->set("food",0);
	me->set("water",0);
        me->delete_temp("xhw_eated");
       }
       message_vision(HIW "\n$N拉开一道门，急冲冲的走了进去！\n\n" NOR, me);
       message_vision(HIW "\n过了一会儿，只听哗啦啦一阵水响，$N拉开门，精神抖擞的走了出来！\n\n" NOR, me);
	if ( random(3) != 2 ) {
	        me->set("sen", (int)me->query("max_sen"));
		me->set("kee", (int)me->query("max_kee"));
//       me->set("gin", (int)me->query("max_gin"));
	}
	else {
	        me->add("kee", -(int)me->query("kee")/2 );
	        me->add("sen", -(int)me->query("sen")/2 );
	        message_vision(HIW "只听一声怪响，$N暗叫“不好”回头就跑。\n" NOR, me);
	}
       return 1;
}
int valid_leave(object me, string dir)
{
     if((dir=="down") && ((int)me->query("force") < 4000) )
           return notify_fail("你的仙术不够高，乖乖在这里帮我守一会厕所吧！\n");
       return ::valid_leave(me, dir);
}
