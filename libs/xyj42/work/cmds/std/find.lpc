// find.c
// cglaem...01/25/97.

#include <skill.h>
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string target) {
  object ob, where;
  string msg;
  int mana_cost;

  if (!target) return notify_fail("你想用天眼通查谁？\n");

  if ((int)me->query("combat_exp") < 5000)
    return notify_fail("你的道行不够，用不了天眼通。\n");

  if ((int)me->query("mana") < 60) return notify_fail("你的法力不够，用不了天眼通。\n");

  if ((int)me->query("sen") < 100 || (int)me->query("sen") * 100 / (int)me->query("max_sen") < 50)
    return notify_fail("你现在头晕脑胀，恐怕连自己在哪里都不清楚！\n");

  mana_cost = -(100 - (int)me->query_skill("spells")) / 4 - 40;
  mana_cost = mana_cost + 10;
  if (mana_cost > 0) mana_cost = 0;
  me->add("mana", mana_cost);

  message_vision(
    HIY "$N口中念了几句咒文，眼中突然精光一闪，大喝一声“千里眼何在！”\n只听嘿嘿几声奸笑，不知从哪里钻出来一个尖嘴猴腮的家伙，在$N耳边低声说了几句话。\n" NOR,
    me
  );

  ob = find_player(target);
  if (!ob) ob = find_living(target);

  if (!ob || ob->query("env/invisibility")) return notify_fail("千里眼告诉你：奇怪，找不到这个人...\n");
  where = environment(ob);
  if (!where) return notify_fail("千里眼告诉你：奇怪，找不到这个人...\n");

  if (present("jingu bang", ob))
    return notify_fail("千里眼告诉你：人是找到了，但是说不得，不能说...\n那家伙带着猴子给他的金箍棒。\n");
  //added by weiqi, need better solution later...

  printf("千里眼告诉你：%s(%s)在%s。\n",
    (string)ob->name(),
    (string)ob->query("id"),
    undefinedp(where->query("short")) ?
    where->short() :
    where->query("short"));

  message_vision("$N“啊～～秋～～”一声打了个喷嚏，不由皱了皱眉。\n",
    ob);
  msg = "你急忙掐指算去，";
  if (ob->query("combat_exp") > me->query("combat_exp") / 5)
    msg += "似乎" + me->name() + "(" + me->query("id") + ")" +
      "正在探听你的行踪。\n";
  else
    msg += "心中却只是一片茫然。\n";
  tell_object(ob, msg);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : find <某人>

天眼通：用来发现别人所在地。
HELP
  );
  return 1;
}
