#include <ansi.h>

int fly_living(object me, string arg);

int main(object me, string arg)
{
	string loc;
        int mana_cost;

        seteuid(getuid());

        if( me->is_fighting() )
                return notify_fail("你正在战斗，飞不开。\n");
        if( me->is_busy() || me->query_temp("pending/exercising"))
                return notify_fail("你正忙着呢，没工夫腾云驾雾。\n");
	if( !wizardp(me) && !environment(me)->query("outdoors") )
		return notify_fail("周围没有一片云，没办法腾云驾雾。\n");
	if( me->is_ghost() )
		return notify_fail("做了鬼了，就老实点吧！\n");
        if( !arg )
                return notify_fail("你要飞到哪里去？\n");
	if( me->query_temp("no_move") )
		return notify_fail("你被定住了，哪里飞得起来！\n");

        if( (int)me->query("combat_exp") < 10000 ){
                message_vision(HIY
"$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n"
NOR, me);
                return notify_fail("可能是你道行还不够。\n");
        }

        if( (int)me->query("mana") < 200 ){
                message_vision(HIY
"$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n"
NOR, me);
                return notify_fail("可能是你法力还不够。\n");
        }

        if( (int)me->query("sen") * 100 / (int)me->query("max_sen") < 50 )
                return
notify_fail("你现在头脑不太清醒，当心掉下来摔死。\n");

        if( (int)me->query("kee") * 100 / (int)me->query("max_kee") < 50 )
                return
notify_fail("你想飞起来，可是体力似乎有点不支。\n");

        mana_cost=-(100-(int)me->query_skill("spells"))/4-40;
        if(mana_cost > 0) mana_cost=0;

        message_vision(HIY
"$N手一指，召来一朵云彩，高高兴兴地坐了上去，\n再吹一声口哨，随之往上冉冉地升起...\n\n"
NOR, me);

        me->add("mana", mana_cost);

        if(arg=="stone") me->move("/d/4world/entrance");
        else if(arg=="moon") me->move("/d/moon/xiaoyuan");
        else if(arg=="lingtai") me->move("/d/lingtai/gate");
        else if(arg=="putuo") me->move("/d/nanhai/gate");
        else if(arg=="changan") me->move("/d/city/center");
        else if(arg=="sky") me->move("/d/sky/nantian");
	else if(arg=="penglai") {
		if(!present("eastsea map", me) && !wizardp(me)) {
			write("你在天上转了半天也不知该往那边飞。。。\n");
			message_vision("\n$N失望地从云上跳了下来！\n", me);
			return 1;
			}
		write("你驾着祥云向东边海中飞去。。。\n\n");
		me->move("/d/penglai/penglai");
	}
	else if(arg=="xueshan") {
		if(!present("xueshan map", me) && !wizardp(me)) {
			write("你在天上转了半天也不知该往那边飞。。。\n");
			message_vision("\n$N失望地从云上跳了下来！\n", me);
			return 1;
			}
		write("你驾着祥云向大雪山飞去。。。\n\n");
		me->move("/d/xueshan/binggu");
	}
	else if(arg=="baoxiang"){
		loc = "/d/qujing/baoxiang/bei1.lpc";
		loc[strlen(loc)-3] = '1'+random(4);
		me->move(loc);
	}else if(arg=="pingding"){
		loc = "/d/qujing/pingding/ping1.lpc";
		loc[strlen(loc)-3] = '1'+random(4);
		me->move(loc);
    }else if(arg=="longgong") {
        if(!present("bishui zhou", me) && !wizardp(me)
           && me->query("family/family_name") != "龙宫") {
            write("你在天上转了半天也不知该往那边飞。。。\n");
            message_vision("\n$N失望地从云上跳了下来！\n", me);
            return 1;
            }
        write("你驾着祥云向东海龙宫飞去。。。\n\n");
        me->move("/d/sea/inside3");
    }else if(arg=="yalong"){
		loc = "/d/qujing/pingding/yalong1.lpc";
		loc[strlen(loc)-3] = '1'+random(3);
		me->move(loc);
	}else if(arg=="wuji"){
		loc = "/d/qujing/wuji/square.lpc";
		//loc[strlen(loc)-3] = '1'+random(9);
		me->move(loc);
	}else if(arg=="chechi"){
		loc = "/d/qujing/chechi/jieshi1.lpc";
		loc[strlen(loc)-3] = '1'+random(9);
		me->move(loc);
	}else if(arg=="tongtian"){
		loc = "/d/qujing/tongtian/hedong1.lpc";
		loc[strlen(loc)-3] = '1'+random(6);
		me->move(loc);
	}else if(arg=="jindou"){
		loc = "/d/qujing/jindou/jindou1.lpc";
		loc[strlen(loc)-3] = '1'+random(4);
		me->move(loc);
	}else if(arg=="nuerguo"){
		loc = "/d/qujing/nuerguo/towna1.lpc";
		/*
		if (me->query("obstacle/nuerguo")!="done" && !wizardp(me)){
			write("\n一阵风把你东倒西歪地吹了回来！\n");
			write("看样子飞不过去。\n");
			return 1;
			}
		*/
		loc[strlen(loc)-4] = 'a'+random(3);
		loc[strlen(loc)-3] = '1'+random(3);
		me->move(loc);
	}else if(arg=="dudi"){
		loc = "/d/qujing/dudi/dudi1.lpc";
		loc[strlen(loc)-3] = '1'+random(4);
		me->move(loc);
        }else if(arg=="firemount"){
         	loc = "/d/qujing/firemount/cuiyun1.lpc";
		loc[strlen(loc)-3] = '1'+random(5);
                me->move(loc);
	}else if(arg=="jilei"){
		loc = "/d/qujing/jilei/jilei1.lpc";
		loc[strlen(loc)-3] = '1'+random(3);
		me->move(loc);
	}else if(arg=="jisaiguo"){
		loc = "/d/qujing/jisaiguo/east1.lpc";
		loc[strlen(loc)-3] = '1'+random(4);
		me->move(loc);
	}else if(arg=="xiaoxitian"){
		loc = "/d/qujing/xiaoxitian/simen.lpc";
		me->move(loc);
        }else if(arg=="zhuzi"){
         	loc = "/d/qujing/zhuzi/zhuzi1.lpc";
		loc[strlen(loc)-3] = '1'+random(5);
                me->move(loc);
        }else if(arg=="qilin"){
         	loc = "/d/qujing/qilin/yutai.lpc";
                me->move(loc);
        }else if(arg=="pansi"){
         	loc = "/d/qujing/pansi/ling1.lpc";
		loc[strlen(loc)-3] = '1'+random(6);
                me->move(loc);
        }else if(arg=="biqiu"){
         	loc = "/d/qujing/biqiu/jie1.lpc";
		loc[strlen(loc)-3] = '1'+random(9);
                me->move(loc);
        }else if(arg=="qinghua"){
         	loc = "/d/qujing/biqiu/zhuang.lpc";
                me->move(loc);
	}else if(arg=="wudidong"){
		loc = "/d/qujing/wudidong/firemount-wudidong3.lpc";
		loc[strlen(loc)-3] = '1'+random(3);
		me->move(loc);
        }else if(arg=="qinfa"){
         	loc = "/d/qujing/qinfa/jiedao1.lpc";
		loc[strlen(loc)-3] = '1'+random(8);
                me->move(loc);
        }else if(arg=="yinwu"){
         	loc = "/d/qujing/yinwu/huangye1.lpc";
                me->move(loc);
        }else if(arg=="fengxian"){
         	loc = "/d/qujing/fengxian/jiedao1.lpc";
		loc[strlen(loc)-3] = '1'+random(9);
                me->move(loc);
        }else if(arg=="yuhua"){
         	loc = "/d/qujing/yuhua/xiaojie1.lpc";
		loc[strlen(loc)-3] = '1'+random(9);
                me->move(loc);
        }else if(arg=="baotou"){
         	loc = "/d/qujing/baotou/shanlu1.lpc";
		loc[strlen(loc)-3] = '1'+random(9);
                me->move(loc);
        }else if(arg=="zhujie"){
         	loc = "/d/qujing/zhujie/shanlu11.lpc";
		loc[strlen(loc)-3] = '1'+random(8);
                me->move(loc);
        }else if(arg=="jinping"){
         	loc = "/d/qujing/jinping/xiaojie1.lpc";
		loc[strlen(loc)-3] = '1'+random(7);
                me->move(loc);
        }else if(arg=="qinglong"){
         	loc = "/d/qujing/qinglong/shanjian.lpc";
                me->move(loc);
        }else if(arg=="tianzhu"){
         	loc = "/d/qujing/tianzhu/jiedao11.lpc";
		loc[strlen(loc)-3] = '1'+random(8);
                me->move(loc);
        }else if(arg=="maoying"){
         	loc = "/d/qujing/maoying/shanpo1.lpc";
		loc[strlen(loc)-3] = '1'+random(9);
                me->move(loc);
        }else if(arg=="lingshan"){
         	loc = "/d/qujing/lingshan/dalu1.lpc";
		loc[strlen(loc)-3] = '1'+random(3);
                me->move(loc);
        }else if(arg=="kaifeng"){
         	loc = "/d/kaifeng/tieta.lpc";
                me->move(loc);
        }else if (! fly_living(me,arg) ) {
                write("\n\n到了！你按下云头跳了下来。\n");
                write("咦？...怎么还在原来的地方？\n");
                return 1;
        }

        write("\n\n到了！你按下云头跳了下来。\n");
        message_vision(HIY
"\n只见半空中降下一朵云彩，$N从里面走了出来。\n" NOR, me);

        return 1;
}

int fly_living(object me, string arg)
{	
	object ob;
	ob = find_player(arg);
	if( me->query("mana") <500 ) return 0;
	if( me->query("combat_exp") < 100000 ) return 0;
	if( !ob || !me->visible(ob) || wizardp(ob) )
		ob = find_living(arg);
	if( !ob || !me->visible(ob) || wizardp(ob) )
		return 0;
	if( random(ob->query("max_mana")) > (int)me->query("mana") / 3 )
		return 0;
	if( random(me->query_skill("seplls")) < (int)ob->query("mana") / 80 ) 
		return 0;
	me->move(environment(ob));
	return 1;
}


int help(object me)
{
        write(@HELP
指令格式 : fly|fei [目的地]

当你的道行和法力高强时，你可以腾云驾雾。

目前你可以飞到的地方：
stone           ->仙石			 moon      	->月宫小院
lingtai         ->灵台方寸山山门	 putuo     	->南海普陀山山门
changan         ->长安南城客栈		 sky		->南天门
penglai		->蓬莱仙岛		 xueshan	->大雪山寒冰谷

baoxiang	->宝象国		 pingding  	->平顶山
yalong    	->压龙山 		 wuji           ->乌鸡国
