// quests.c

#include <ansi.h>

inherit F_CLEAN_UP;
int time_period(int timep, object me);
int main(object ob, string arg) {
  int nowtime = time();
  object me;
  mapping quest, quest1;
  if (!wizardp(ob) || arg == "") me = ob;
  else {
    if (arg) {
      me = present(arg, environment(ob));
      if (!me) me = find_player(arg);
      if (!me) return notify_fail("你要察看谁的任务？\n");
    } else
      me = ob;
  }
  quest = me->query("quest/pending");
  quest1 = me->query("quest/wei");
  if (!quest && !quest1)
    return notify_fail(HIR "你现在没有拿到任何谜题或任务！\n" NOR);
  if (quest1) {
    write("你现在的任务是" + quest1["quest_type"] +
      "『" + quest1["quest"] + "』。\n");
    nowtime = (int)me->query("task_time") - time();
    if (nowtime > 0)
      time_period(nowtime, me);
    else
      write("    但是你已经没有足够的时间来完成它了。\n");
  } else write(HIR "你现在没有任务在身。\n" NOR);

  if (!quest) return notify_fail(HIR "你现在没有要解的迷题。\n" NOR);
  write("你现在要解的谜题是：\n");
  if (me->query("quest/pending/give"))
    write("殷温娇：  送" + me->query("quest/pending/give/objectname") + "给"
      +me->query("quest/pending/give/name") + "\n");

  if (me->query("quest/pending/ask"))
    write("陈光蕊：  问" + me->query("quest/pending/ask/name") + "关于"
      +me->query("quest/pending/ask/topic") + "\n");

  if (me->query("quest/pending/kill"))
    write("胡敬德：  杀" + me->query("quest/pending/kill/name") + "\n");

  if (me->query("quest/pending/food"))
    write("猪八戒：  " + me->query("quest/pending/food/name") + "\n");

  if (me->query("quest/pending/weapon"))
    write("相  公：  " + me->query("quest/pending/weapon/name") + "\n");

  if (me->query("quest/pending/armor"))
    write("相  婆：  " + me->query("quest/pending/armor/name") + "\n");

  if (me->query("quest/pending/cloth"))
    write("香  兰：  " + me->query("quest/pending/cloth/name") + "\n");

  if (me->query("quest/pending/wearing"))
    write("玉  兰：  " + me->query("quest/pending/wearing/name") + "\n");

  if (me->query("quest/pending/furniture"))
    write("翠  兰：  " + me->query("quest/pending/furniture/name") + "\n");

  return 1;
}

int time_period(int timep, object me) {
  int t, d, h, m, s;
  string time;
  t = timep;
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d) time = chinese_number(d) + "天";
  else time = "";

  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";
  tell_object(me, "你还有" + time + "去完成它。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : quests
 
这个指令可以显示出你当前要解的谜题。
HELP
  );
  return 1;
}
