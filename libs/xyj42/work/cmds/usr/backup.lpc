// backup.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object link_ob;
  string file;

  seteuid(getuid());

  if (!objectp(link_ob = me->query_temp("link_ob")))
    return notify_fail("你不是经由正常连线进入，不能储存。\n");

  if ((int)link_ob->save() && (int)me->save() && (int)me->backup()) {
    write("档案储存完毕。\n");
    write("备分完毕。\n");
    return 1;
  } else {
    write("储存失败。\n");
    write("备分失败。\n");
    return 0;
  }
}

int help(object me) {
  write(@HELP
指令格式：backup

在你的档案遭受漠名其妙的伤害后，可要求巫师 restore 。
HELP
  );
  return 1;
}
