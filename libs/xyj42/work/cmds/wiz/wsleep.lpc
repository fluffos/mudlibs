#include <ansi.h>
#include <command.h>
inherit F_DBASE;

int main(object me)
{
	seteuid(getuid());
	me->set_temp("block_msg/all",1);
	me->disable_player("<睡梦中>");
        call_out("wakeup",random(50 - me->query("con")) + 10, me);
	return 1;
}

void wakeup(object me)
{
        if(!me) return;
        me->enable_player();

        while( environment(me)->is_character() )
                me->move(environment(environment(me)));

        if(random(5)==1 && interactive(me)){
                me->set("dream_place",(string)environment(me));
                me->set_temp("block_msg/all", 0);
                me->move("/d/ourhome/honglou/kat");
        }

        else{
	        message_vision(HIY "$N睁开双眼，懒懒地抬了一下手。\n" NOR,me);
	        me->set_temp("block_msg/all", 0);
	        write("你一觉醒来，百思不得其解：“我怎么在这里睡着了？”\n");
        }
}
	
int help(object me)
{
  write(@HELP
 
瞌睡虫专用睡觉命令。
HELP
    );
    return 1;
}


