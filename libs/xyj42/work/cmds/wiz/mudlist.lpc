// mudlist.c

#include <ansi.h>
#include <net/daemons.h>
#include <net/macros.h>

inherit F_CLEAN_UP;

#define SYNTAX  "指令格式：mudlist <MudName>\n"

int main(object me, string arg)
{
        mapping mud_list;
        mapping mud_svc;
        mixed *muds;
        string output;
        int loop, size, count=0;

        if( !find_object(DNS_MASTER) )
                return notify_fail("网路精灵并没有被载入，请先将网路精灵载入。\n");

        mud_list = (mapping)DNS_MASTER->query_muds();

        mud_svc = DNS_MASTER->query_svc() + ([ Mud_name() : 0 ]);

        if(!mud_list)
                return notify_fail( MUD_NAME + "目前并没有跟网路上其他 Mud 取得联系。\n");

        muds = keys( mud_list ) - ({ "DEFAULT" });

        muds = sort_array(muds, 1);

        if(arg && arg != "") {
                arg = htonn(arg);

                if(!mapp( mud_list[arg] )) {
                        write(MUD_NAME + "并没有和这个 Mud 取得联系。\n");
                        return 1;
                }
                if( wizardp(me) ) {
                        printf("有关 %s 的资讯：\n%O\n", arg, mud_list[arg]);
                        return 1;
                }
        }

        output = 
"Mud 名称               国际网路位址     埠号  人数  当地时间\n"+
"──────────────────────────────────────\n";
        for(loop = 0, size = sizeof(muds); loop<size; loop++) {
                if( arg && upper_case(arg) != upper_case(muds[loop]) ) {
                        continue;
                }
                count = loop;
                if( upper_case(muds[loop]) == upper_case(INTERMUD_MUD_NAME))
                        output +=  BRED+YEL;
                else
                        output +=NOR;
                output +=  sprintf("%-21s  %-15s  %4s", 
                        undefinedp(mud_list[muds[loop]]["MUDNAME"])?
                        upper_case(muds[loop]):
                        mud_list[muds[loop]]["MUDNAME"] +
                        "("+upper_case(muds[loop])+")", 
                        mud_list[muds[loop]]["HOSTADDRESS"],
                        mud_list[muds[loop]]["PORT"]);
                if(!undefinedp(mud_list[muds[loop]]["USERS"]))
                                output+=sprintf("  %-4s  ", mud_list[muds[loop]]["USERS"] );
                else
                                output+=sprintf("  ----  ", mud_list[muds[loop]]["USERS"] );

                if(!undefinedp(mud_list[muds[loop]]["TIME"]))
                        output+= mud_list[muds[loop]]["TIME"];

                output +=NOR"\n";
        }
output += "──────────────────────────────────────\n";
        if( arg && arg!="")
                output += sprintf("Mud %s(%s)的信息显示完毕。\n",mud_list[muds[count]]["MUDNAME"],upper_case(arg));
        else
                output += sprintf("共有 %d 个 Mud 与【西游记】连线。\n",loop-1);
        this_player()->start_more( output );

        return 1;
}

int help()
{
        write( SYNTAX + "\n"
                "这个指令让你列出目前跟这个 Mud 取得联系中的其他 Mud\n"
                "或 <MudName> 的信息。\n"
        );
        return 1;
}
