#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object obj1, obj2;
  string objname, npcname;
  if (!wizardp(me)) return notify_fail("什么？\n");
  if (sscanf(arg, "%s from %s", objname, npcname) == 2);
  else return notify_fail("你想取谁的什么东西？\n");
  obj2 = find_player(npcname);
  if (!obj2) obj2 = find_living(npcname);
  if (!obj2 || obj2->query("env/invisibility")) return notify_fail("找不到这个人...\n");
  obj1 = present(objname, obj2);
  if (!obj1) return notify_fail("找不到这样东西！\n");

  obj1->move(me);
  message_vision("$N从" + npcname + "身上取下" + objname + "！\n", me);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : rget <某物> from <某人>
          
从不在视野范围内的人物身上取得某物。 
HELP
  );
  return 1;
}
