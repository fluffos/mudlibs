// by snowcat - adjust title
if (user->query("zhangmen")) {
  object zhangmen = new(user->query("zhangmen/base_name"));

  if (zhangmen) {
    zhangmen->set_save_file(user->query("zhangmen/data_name"));
    zhangmen->restore();

    if (zhangmen->query("family/family_name") != user->query("family/family_name")) {
      // already betrayed
      if (user->query("title") == user->query("zhangmen/title") ||
        user->query("title") == user->query("zhangmen/title_old")) {
        if (user->query("family/family_name"))
          user->set("title",
            sprintf("%s第%s代%s",
              user->query("family/family_name"),
              chinese_number(user->query("family/generation")),
              user->query("family/title")));
      }
      if (zhangmen->query("current_player") == user->query("id")) {
        zhangmen->reset_me(zhangmen);
        zhangmen->save();
      }
      user->delete("zhangmen");
    } else if (zhangmen->query("current_player") == user->query("id")) {
      user->set("title", user->query("zhangmen/title"));
    } else {
      /*
	      user->set("title",
	                sprintf("%s第%s代%s",
	                        user->query("family/family_name"),
	                        chinese_number(user->query("family/generation")),
	                        user->query("family/title")));
	       */
      user->set("title", user->query("zhangmen/title_old"));
    }
    user->save();
  }
}

// by snowcat
// the following is used to update user's data in case
// of system change
{
  int tmpint;
  string tmpstr;

  if (tmpint = user->query("obstacle/level")) {
    if (!user->query("obstacle/number"))
      user->set("obstacle/number", tmpint);
  }
  if (tmpstr = user->query("obstacle/1")) {
    if (user->query("obstacle/nuerguo")) {
      // already there
    } else if (tmpstr == "marriage" ||
      tmpstr == "company" ||
      tmpstr == "stomachache")
      user->set("obstacle/nuerguo", tmpstr);
    else
      user->set("obstacle/nuerguo", "done");
  }
  if (tmpstr = user->query("obstacle/2")) {
    if (user->query("obstacle/firemount")) {
      // already there
    } else if (tmpstr != "done")
      user->set("obstacle/firemount", tmpstr);
    else
      user->set("obstacle/firemount", "done");
  }
  if (tmpint = user->query("obstacle/2_bone"))
    user->set("obstacle/firemount_bone", tmpint);
  if (tmpstr = user->query("obstacle/3")) {
    if (user->query("obstacle/wudidong")) {
      // already there
    } else
      user->set("obstacle/wudidong", tmpstr);
  }
  user->delete("obstacle/level");
  user->delete("obstacle/1");
  user->delete("obstacle/2");
  user->delete("obstacle/2_bone");
  user->delete("obstacle/3");
}

// by snowcat
// the following is a filter for 东海龙宫
{
  string tmpstr;

  tmpstr = user->query("family/family_name");
  if (tmpstr == "东海龙宫")
    user->set("family/family_name", "龙宫");

  tmpstr = user->query("title");
  if (tmpstr == "东海龙宫二代弟子")
    user->set("title", "龙宫二代弟子");
  tmpstr = user->query("title");
  if (tmpstr == "东海龙宫三代弟子")
    user->set("title", "龙宫三代弟子");
}
