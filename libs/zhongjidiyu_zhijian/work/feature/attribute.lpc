// attribute.c
// From ES2
// Modified by Xiang for XKX (12/15/95)
#include <ansi.h> 
#include <command.h>
#include <dbase.h>
#include <skill.h>

int query_str()
{
        mapping sk;
        int str;
        int improve = 0;
        int lx = 0;
        int num=0;
        str = query("str");
        if (! mapp(sk = query_skills()))
                return str;

        improve += (int)sk["unarmed"] /30;
        improve += (int)sk["cuff"] /30;
        improve += (int)sk["finger"] /30;
        improve += (int)sk["strike"] /30;
        improve += (int)sk["hand"] /30;
        improve += (int)sk["claw"] /30;
        improve += (int)query_temp("suit_skill/unarmed") /30;
        improve += (int)query_temp("suit_skill/cuff") /30;
        improve += (int)query_temp("suit_skill/finger") /30;
        improve += (int)query_temp("suit_skill/strike") /30;
        improve += (int)query_temp("suit_skill/hand") /30;
        improve += (int)query_temp("suit_skill/claw") /30;
        lx = (int)sk["longxiang"] / 30;
        if (lx >= 13) lx = 15;

          return str + improve + lx +query_temp("suit_eff/strength") + query_temp("apply/str");
        
}

int query_int()
{
        mapping sk;
        int str;
        int improve = 0;
        int num=0;
        
        str = query("int");
        if (! mapp(sk = query_skills()))
        return str;
        improve = (int)sk["literate"]+(int)query_temp("suit_skill/literate");
       
            
              return str + (improve / 10) + query_temp("apply/int")+query_temp("suit_eff/intelligence");   
}

int query_con()
{
        mapping sk;
        int str;
        int improve = 0;
        int num=0;

        str = query("con");
        if (! mapp(sk = query_skills()))
                return str;

        improve = (int)sk["force"]+(int)query_temp("suit_skill/force");
     
           
              return str + (improve / 10) + query_temp("apply/con")+query_temp("suit_eff/constitution");
}

int query_dex()
{
        mapping sk;
        int str;
        int improve = 0;
        int num=0;

        str = query("dex");
        if (! mapp(sk = query_skills()))
                return str;

        improve = (int)sk["dodge"]+(int)query_temp("suit_skill/dodge");
      
            
             return str + (improve / 10) + query_temp("apply/dex")+ query_temp("suit_eff/spirituality");     
}

// NOTE (new finding, not previously cataloged): declared with a required
// `string arg` that is never actually used in the body, and EVERY call
// site in the whole lib (6/6, including this file's own girl.lpc caller)
// omits it -- call_other call sites (ob->query_per()) tolerate the arity
// mismatch, but the one DIRECT call (girl.lpc's bare query_per()) hit this
// driver's strict same-object argument-count check and failed to compile
// (same "direct call enforces declared signature strictly" shape as
// AGENTS.md §15b's is_killing precedent, just missing-arg instead of
// wrong-type). Added `varargs` to match the calling convention actually
// used everywhere, rather than patch the one direct call site.
varargs int query_per(string arg)
{
        int per;
        int age;
        int ac;
        int num=0;
        per = (int)query("per") + query_temp("apply/per");
        if (query("special_skill/youth"))
                return per;

        age = query("age");

        ac = query_skill("art-cognize", 1);
        if (ac < 100)
        {
                if (age > 70) per -= 6; else
                if (age > 60) per -= 5; else
                if (age > 50) per -= 4; else
                if (age > 40) per -= 3; else
                if (age > 30) per -= 2;
        }
         per += ac / 20 ;
     
             
              return per;  
}
