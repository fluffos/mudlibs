#include <ansi.h>
inherit F_CLEAN_UP;
mapping lists = ([
  "(elder)": HIC "★荣誉玩家" NOR " (eld) :",
  "(immortal)": HIM "★客座巫师" NOR " (imm) :",
  "(apprentice)": HIG "★管理巫师" NOR " (app) :",
  "(wizard)": HIB "★维护巫师" NOR " (wiz) :",
  "(arch)": HIG "★开发巫师" NOR " (arc) :",
  "(admin)": HIW "★总管巫师" NOR " (adm) :",
  /*  "elder": HIC "★荣誉玩家" NOR " (eld)  ",
"immortal" : HIM "★客座巫师" NOR " (imm)  ",
"apprentice" : HIG "★巫师学徒" NOR " (app)  ",
"wizard" : HIB "★维护巫师" NOR " (wiz)  ",
"arch" : HIG "★开发巫师" NOR " (arc)  ",
"admin" : HIW "★总管巫师" NOR " (adm)   ",  */
]);

int level(mixed, mixed);

int main(object me, string arg) {
  string *list, hood = "", str;
  int j = 0;

  list = sort_array(SECURITY_D->query_wizlist(), (: level :));
  str = HIM "〖三界神话〗" HIY "·" HIG "宝鸡总站" NOR "巫师组成员\n";
  for (int i = 0; i < sizeof(list); i++, j++) {
    if (hood != wizhood(list[i])) {
      hood = wizhood(list[i]);
      if (j % 7) str += "\n";
      str += lists[hood];
      j = 0;
    }
    if (list[i] != "pkl" && list[i] != "flydance" && list[i] != "wosshipg" && list[i] != "stey") str += sprintf("%s%s", capitalize(list[i]),
      (j % 7 == 6) ? "\n" : (i < sizeof(list) - 1 && hood == wizhood(list[i + 1])) ? "  " : "");
  }
  me->start_more(str);
  return 1;
}

int level(mixed ob1, mixed ob2) {
  if (wiz_level(ob1) != wiz_level(ob2))
    return wiz_level(ob2) - wiz_level(ob1);
  return ob1 < ob2 ? -1 : 1;
}


int help(object me) {
  write(@HELP

  指令格式 : wizlist

用途 : 列出目前所有的巫师名单。
HELP);
  return 1;
}
