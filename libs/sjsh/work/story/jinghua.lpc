// story:laojun 西游

#include <ansi.h>

int give_gift();

private mixed *story = ({
  "归位天尊：整天陪着个死灵珠发呆,真是受够了！",
  "精华台守护神：谁叫咱俩命苦呢！唉~~~~",
  "归位天尊：不如我们去玉皇大帝那申请换个地方！怎么样？",
  "精华台守护神：KAO~~~~亏你想得出来！不过想想还是蛮不错的。",
  "归位天尊：怎么样？我这条计策不错吧!",
  "精华台守护神：不错！",
  "归位天尊：那~~~~",
  "精华台守护神有点疑惑地想着什么事情",
  "归位天尊：怎么不说话了？",
  "精华台守护神：我在想这事谁去说比较好呢。",
  "归位天尊：计是我想的,跑路的自然是你啊。",
  "精华台守护神：亏你想的出,如果那玉帝不同意,我不是要吃官司！你这鸟人真阴险,难不成想自己独占精华台？",
  "归位天尊：看来事情终究还是要解决的,明说吧,我就是这个意思！",
  "精华台守护神：好你个死东西,看招！~~~",
  "归位天尊：慢着,我们打架也要讲究公平,你把武器什么的都丢了！",
  "精华台守护神：好吧!我也没什么好在乎的,丢掉吧！",
  "精华台守护神丢下一颗 千绝草 ",
  "归位天尊：算了,我不想打了!这事还是算了吧！改天我自己搬家,这位置还是给你吧！",
  "精华台守护神:了你也不敢和我斗！ ",
  "归位天尊：... ...",
  "归位天尊被气的要死,转身回家收东西去了！",
});

void create() {
  seteuid(getuid());
}

mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

int give_gift() {
  STORY_D->give_gift("/d/calvin/obj/qianjuecao", 1,
    HIM "\n“啪”的一声一颗难得一见的千绝草掉到你面前。\n\n" NOR);
  return 1;
}
