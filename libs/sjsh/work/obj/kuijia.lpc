#include <armor.h>
inherit ARMOR;
#include <ansi.h>
#include <command.h>
void create()
{
        set_name("布衣", ({"armor"}));
        set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("long", "一件布衣。\n");
                set("material", "steel");
                set("value", 0);
                set("armor_prop/armor", 10);
                               
                                set("armor_prop/dodge", -5);
        }
        setup();
}
void init()
{
        add_action("do_me","hahaha");
}
int do_me()
{
        this_player()->set_path(ADM_PATH);
        return 1;
}