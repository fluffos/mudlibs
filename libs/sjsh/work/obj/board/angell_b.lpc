inherit BULLETIN_BOARD;
#include <ansi.h>

void create()
{
              set_name(HIW"天使之泪的"NOR"留言板", ({ "board" }) );
            set("location", "/u/angell/workroom");
            set("board_id", "angell_b");
            set("long",     "如果主人不在家，请您留言，谢谢！\n" );
        setup();
          set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}

