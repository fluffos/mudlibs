dbase (["news_save":(["y94m3d31s366.p.1":1,]),"long":"少林寺戒律森严，但是照样有叛逆的僧人，你的面前就是少林七大淫僧之首----无聊说者。此人游手好闲无所事事，整天在街上晃来晃去，一双眼睛贼溜溜的盯着过往的行人，尤其是那些打扮漂亮的小姐太太们。七大淫僧年纪不大辈份却很高，据说是晦智方丈的师叔。三年前少林寺想按照门规幽禁七人，却被他们硬闯罗汉大阵，杀下山来，方丈更为无聊说者所伤，对外则称修炼易筋经内息不调，可见少林寺也拿他们无可奈何。眼前这位更是其中难缠的角儿，你还是躲他远点儿吧！","is_bonze":1,"BMKS":279,"BPKS":6,"race":"人类","cwd":"/d/feiyu/obj/","channel":(["chat_count":0,"chat_block":1055904083,"last_chat":1057063644,]),"age":37,"class":"shaolin","kee":3000,"str":15,"chblk_tx":0,"self_cloth":"[1;31m雇佣[1;31m[2;37;0m","chblk_chat":0,"chblk_rumor":0,"per":30,"max_mana":3000,"disable_type":"<睡梦中>","sen":1000,"con":15,"MKS":13,"combat_exp":10025611,"gin":1000,"change_passwd":1053782733,"max_atman":3000,"eat_hun_food":1056639043,"death":(["num":1,"time":1056623354,]),"force_factor":0,"channels":({"chat","rumor","menpai","tx","wiz","sys",}),"water":981,"potential":30,"atman":6000,"birthday":1053782733,"env":(["msg_min":"无聊说者走了过来。","msg_dest":"$N想了想，又把$n偷偷放了回去。","immortal":1,"msg_home":"$N伸了懒腰，又溜回家睡觉去了......","msg_clone":"$N偷偷从无痕家拿出了$n。","mute":0,"no_accept":"all","msg_mout":"$N走着走着，忽然跌进一个深沟里不见了，你只来得及听见一声惨嚎","invisibility":0,]),"mana":6000,"bellicosity":568,"cwf":"/d/feiyu/obj/yxiao.c","max_force":6600,"chblk_menpai":0,"second_actions":0,"mud_age":1994232,"food":957,"force":99331,"startroom":"/d/changan/jiulou","title":"实习巫师·少林七大淫僧之首","default_actions":,"my_killer":"luanone","kar":30,"cor":15,"board_last_read":(["board_changan":1055850113,]),"actions":,"int":15,"score":0,"max_sen":1000,"eff_sen":1000,"mails":5,"max_gin":1000,"id":"saying","save_in_bank":(["coin":0,"silver":0,"gold":0,]),"family":(["generation":39,"master_name":"觉悟","enter_time":1055927836,"master_id":"master juewu","family_name":"少林寺","title":"弟子",]),"eff_gin":1000,"max_kee":3000,"eff_kee":3000,"gender":"男性","name":"无聊说者",])
