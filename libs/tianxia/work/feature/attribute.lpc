// attribute.c

#include <dbase.h>

int query_str()  // 臂力
{
  return (int)query("str") + (int)query("force_factor") + query_temp("apply/strength");
}

int query_cor()  // 胆识
{
  return (int)query("cor") + (int)query("bellicosity") / 50 + query_temp("apply/courage");
}

int query_int()  // 悟性
{
  return (int)query("int") + query_temp("apply/intelligence");
}

int query_per()  // 容貌
{
  return (int)query("per") + query_temp("apply/personality");
}

int query_con()  // 根骨
{
  return (int)query("con") + query_temp("apply/constitution");
}

int query_kar()  // 福缘
{
  return (int)query("kar") + query_temp("apply/karma");
}
