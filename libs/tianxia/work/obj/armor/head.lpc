// head.c

#include <armor.h>

inherit HEAD;

void create() {
  set_name("头盔", ({ "head armor", "head" }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "副");
    set("material", "copper");
    set("value", 800);
    set("armor_prop/armor", 5);
    set("armor_prop/dodge", -2);
  }
  setup();
}
