// jiaofu.c

inherit NPC;

int is_marry_ob() { return 1; }

void create()
{
	set_name("轿夫", ({ "jiao fu" }));
	set("long", "这位男子膀大腰圆，满脸笑容。\n");
	set("gender","男性");

	set("age",35);
	set("con",20);
	set("str",20);
	set(NO_KILL, 1);

	set("combat_exp",1500);

	setup();
	carry_object(ARMOR_DIR"cloth")->wear();
}
