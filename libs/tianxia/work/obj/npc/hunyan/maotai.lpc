// maotai.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("茅台", ({ "mao tai" }) );
	set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "瓶");
		set("value", 1);
		set("material","glass");
		set("max_liquid", 15);
	}

	set("liquid", ([
		"type": "alcohol",
		"name": "茅台酒",
		"remaining": 6,
		"drunk_apply": 10,
	]) );
}
