// ansi_util.c
//
#include "/include/ansi.h"
//
// AGENTS.md §15b-style gap: clr_ansi() and chinese_number() are called
// pervasively throughout this lib (chinese.lpc's valid_chinese(), time.lpc,
// ~90 gameplay files) but were never actually defined anywhere reachable in
// this archive as a real simul_efun -- presumably lost from whatever base
// this snapshot was cloned from. Restored here using the same
// implementation this author ("Find") used in sibling libs of this same
// lineage (verified byte-identical algorithm present in
// nitan170911/nitan6's adm/daemons/chinesed.lpc, also authored/modified by
// "Find"-lineage developers). Included BEFORE chinese.lpc in
// simul_efun.lpc since chinese.lpc's valid_chinese() calls clr_ansi() (see
// AGENTS.md §8b: a same-composed-file forward reference to a not-yet-seen
// function fails to resolve).

string clr_ansi(string str)
{
	int i;
	string *color = ({ BLK, RED, GRN, YEL, BLU, MAG, CYN, WHT,
	                    HIK, HIR, HIG, HIY, HIB, HIM, HIC, HIW,
	                    HBRED, HBGRN, HBYEL, HBBLU, HBMAG, HBCYN, HBWHT,
	                    BBLK, BRED, BGRN, BYEL, BBLU, BMAG, BCYN, BWHT,
	                    NOR, BOLD });

	if( !str || !stringp(str) ) return str;
	i = sizeof(color);
	while( i-- )
		str = replace_string(str, color[i], "");
	return str;
}

// AGENTS.md §15b-style gap: feature/dbase.lpc (this lib's generic
// per-object property storage, inherited nearly everywhere) calls a bare
// `changed_match_path(mapping, string)` that was never defined anywhere in
// this archive either -- but the signature is IDENTICAL to FluffOS's real
// `match_path()` efun (mixed match_path(mapping m, string str), confirmed
// in this driver's own core.spec and docs, and this lib's own
// doc/driver/done-mudos changelog notes match_path() as an efun the
// original MudOS driver added). "changed_" strongly suggests this was
// meant to be a thin local wrapper (possibly for a since-lost local tweak)
// around the real efun, not a from-scratch reimplementation -- restored as
// a passthrough.
mixed changed_match_path(mapping m, string str)
{
	return match_path(m, str);
}

// AGENTS.md §15b: db_affected(db) -- affected-row count after db_exec().
// This driver's DB package has no such efun, and db_exec() itself returns
// 0 for INSERT/UPDATE/DELETE (no result set) -- there's no real
// affected-row count obtainable through this driver's DB API at all.
// databased.lpc's own call sites already check db_exec()'s own return for
// the real success/failure signal, so a stub returning 1 (assume >=1 row)
// is a reasonable, documented compromise, not a silent lie.
int db_affected(int db)
{
	return 1;
}

// AGENTS.md §8e-style gap: query_bandwide() (cmds/imm/bps.lpc's comment:
// "returns float* -- [0] incoming data, [1] outgoing data") was a genuine
// MudOS-driver efun for live port bandwidth stats that has no FluffOS
// equivalent at all (checked core/sockets/contrib specs -- nothing close).
// This is called UNGUARDED from logind.lpc's begain_enter(), on the path
// of every single new connection ("/cmds/imm/bps"->main()), with no
// catch() -- an unresolved bare call here previously took down the entire
// connection (new_conn_handler silently disconnects on any error escaping
// logon(), see AGENTS.md §15d). Since there's no real way to recover this
// driver-level stat, stub with harmless zeros -- this is purely a cosmetic
// admin bandwidth readout on the login banner, not gameplay-relevant.
float *query_bandwide()
{
	return ({ 0.0, 0.0 });
}

// AGENTS.md §15b-style gap: query_shadowed() -- called BARE (no target
// object) from feature/self.lpc and std/equip.lpc to ask "is THIS weapon
// object currently shadowed by a special-effect object (e.g. a glowing/
// elemental weapon effect), and if so, which one" -- never defined
// anywhere in this archive, but this driver's own `shadow(ob, flag)` efun
// already provides exactly this reverse lookup: "if flag is 0, either 0
// will be returned, or the object that is already shadowing 'ob'"
// (docs/efun/calls/shadow.md). Since this resolves as a bare simul_efun
// call, this_object() inside it would be the SIMUL_EFUN object itself
// (see AGENTS.md §15's `this_object()` footgun) -- use previous_object()
// instead, which correctly names the real caller during a simul_efun call.
object query_shadowed()
{
	return shadow(previous_object(), 0);
}

private nosave string *c_digit = ({ "零","十","百","千","万","亿","兆" });
private nosave string *c_num = ({ "零","一","二","三","四","五","六","七","八","九","十" });

string chinese_number(int i)
{
	if (i < 0)
		return "负" + chinese_number(-i);
	if (i < 11)
		return c_num[i];
	if (i < 20)
		return c_digit[1] + c_num[i - 10];
	if (i < 100)
	{
		if (i % 10)
			return c_num[i / 10] + c_digit[1] + c_num[i % 10];
		else
			return c_num[i / 10] + c_digit[1];
	}
	if (i < 1000)
	{
		if (i % 100 == 0)
			return c_num[i / 100] + c_digit[2];
		else if (i % 100 < 10)
			return c_num[i / 100] + c_digit[2] +
			c_num[0] + chinese_number(i % 100);
		else
			return c_num[i / 100] + c_digit[2] +
			chinese_number(i % 100);
	}
	if (i < 10000)
	{
		if (i % 1000 == 0)
			return c_num[i / 1000] + c_digit[3];
		else if (i % 1000 < 100)
			return c_num[i / 1000] + c_digit[3] +
			c_num[0] + chinese_number(i % 1000);
		else
			return c_num[i / 1000] + c_digit[3] +
			chinese_number(i % 1000);
	}
	if (i < 100000000)
	{
		if (i % 10000 == 0)
			return chinese_number(i / 10000) + c_digit[4];
		else if (i % 10000 < 1000)
			return chinese_number(i / 10000) + c_digit[4] +
			c_num[0] + chinese_number(i % 10000);
		else
			return chinese_number(i / 10000) + c_digit[4] +
			chinese_number(i % 10000);
	}
	if (i % 100000000 == 0)
		return chinese_number(i / 100000000) + c_digit[5];
	else if (i % 100000000 < 1000000)
		return chinese_number(i / 100000000) + c_digit[5] +
		c_num[0] + chinese_number(i % 100000000);
	else
		return chinese_number(i / 100000000) + c_digit[5] +
		chinese_number(i % 100000000);
}
