// user.c
// by Find.

// WASM: the 'db' package (db_connect/db_exec/...) doesn't exist there,
// so databased.lpc fails to COMPILE (not just "fails to connect") --
// every DATABASE_D->... call below then throws "No program in object",
// uncaught, which (via count_reg_user() on the login path) killed every
// connection at logon(). catch() around each call degrades a broken/
// absent database daemon to a safe default instead of crashing the
// caller (AGENTS.md §1.3c).

// 中文名能否使用
int permit_add_cname(string name) {
  mixed err, ret;

  if (!previous_object()
    || (geteuid(previous_object()) != ROOT_UID))
    return 0;

  if (!stringp(name) || (name == ""))
    return 0;

  err = catch(ret = DATABASE_D->db_permit_add_cname(name));
  return err ? 0 : ret;
}

// 电子邮件能否注册
int permit_reg_email(string email) {
  mixed err, ret;

  if (!previous_object()
    || (geteuid(previous_object()) != ROOT_UID))
    return 0;

  if (!stringp(email) || (email == ""))
    return 0;

  err = catch(ret = DATABASE_D->db_permit_reg_email(email));
  return err ? 0 : ret;
}

// 超时未能注册或者未能连线确认的玩家
string *query_exceed_reg_time() {
  mixed err, ret;

  if (!previous_object()
    || (geteuid(previous_object()) != ROOT_UID))
    return 0;

  err = catch(ret = DATABASE_D->db_query_exceed_reg_time());
  return err ? 0 : ret;
}

/**********************
 * flag 0 未知状态    *
 * flag 1 已注册玩家  *
 * flag 2 未注册玩家  *
 **********************/
varargs void del_user_data(string id, int flag) {
  if (!previous_object()
    || (geteuid(previous_object()) != ROOT_UID))
    return;

  if (!stringp(id) || (id == ""))
    return;

  switch (flag) {
    case 1:
      catch(DATABASE_D->db_del_reg_user(id));
      catch(DATABASE_D->del_user_all_pob(id));
      return;
    case 2:
      catch(DATABASE_D->db_del_temp_user(id));
      return;
    default:
      catch(DATABASE_D->db_del_unknow_user(id));
      catch(DATABASE_D->del_user_all_pob(id));
  }
}

int change_cname(string id, string name) {
  mixed err, ret;

  if (!previous_object()
    || (geteuid(previous_object()) != "Object"))
    return 0;

  if (!stringp(id) || (id == "")
    || !stringp(name) || (name == ""))
    return 0;

  err = catch(ret = DATABASE_D->db_change_chinese_name(id, name));
  return err ? 0 : ret;
}

// 计算所有的正式注册玩家数量
int count_reg_user() {
  mixed err, ret;

  if (!previous_object()
    || (geteuid(previous_object()) != ROOT_UID))
    return 0;

  err = catch(ret = DATABASE_D->db_count_reg_user());
  return err ? 0 : ret;
}

