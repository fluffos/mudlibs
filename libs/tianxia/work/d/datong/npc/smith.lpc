// smith.c

inherit SMITH;

void create()
{
	set_name("刘铁", ({ "liu tie" }) );
        set("gender", "男性" );
        set("age", 38);
	set("str",88);
        set("long", "铁器作坊老板刘铁。\n");
        set("combat_exp", 2000);
        set("attitude", "friendly");
        set_skill("dodge", 60);
        set_skill("unarmed", 60);

	set_weapon_ability(({"blade", "axe"}));
	set_ability_level(10);

        setup();

	carry_object(ARMOR_DIR+"cloth")->wear();
}