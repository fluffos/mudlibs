// hundun_seller.c

inherit F_DEALER;

void create()
{
	set_name("卖馄饨小贩", ({ "huntun seller","seller" }) );
	set("gender", "男性" );
        set("age", 37);
        set("long","这是一位卖馄饨的小贩，一边煮馄饨一边
起劲的吆喝着。\n");
        set("combat_exp", 50);
        set("attitude", "friendly");
	set("sell_all_day",1);

	set("vendor_goods", ([
		__DIR__"obj/huntun":20,
	]) );

        setup();
	carry_object(ARMOR_DIR"cloth")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = previous_object()) && !is_fighting() )
	{
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
	if( !ob
	|| (environment(ob) != environment())
	|| file_name(environment()) != this_object()->query("startroom"))
		return;

	say(sprintf("%s吆喝道：“这位%s歇歇脚来碗馄饨吧。”\n",name(),RANK_D->query_respect(ob)));
}