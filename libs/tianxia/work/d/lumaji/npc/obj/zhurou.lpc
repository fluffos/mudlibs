// zhurou.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("野猪肉", ({ "zhu rou", "rou" }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一块烤熟的野猪肉。\n");
    set("unit", "块");
    set("value", 100);
    set("food_remaining", 4);
    set("food_supply", 20);
  }
  setup();
}
