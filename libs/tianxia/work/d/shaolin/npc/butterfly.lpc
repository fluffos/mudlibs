// butterfly.c

inherit NPC;

void create() {
  set_name("蝴蝶", ({ "hu die", "butterfly" }));
  set("race", "野兽");
  set("age", 3);
  set("max_kee", 300);
  set("long", "一只翩翩飞舞的蝴蝶。\n");

  set("limbs", ({ "头部", "身体", "翅膀", "尾巴" }));
  set("verbs", ({ "bite" }));

  set("combat_exp", 300);

  setup();
}
