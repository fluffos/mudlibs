inherit F_FOOD;
inherit ITEM;

void create()
{
        set_name("红烧鲤鱼", ({ "hongshao liyu"}) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一盘红烧鲤鱼。\n");
                set("unit", "盘");
                set("value", 3000);
                set("food_remaining", 5);
                set("food_supply", 3);
                set("material", "food");
        }
        setup();
}
