inherit F_FOOD;
inherit ITEM;

void create()
{
        set_name("烤牛肉", ({ "kao niurou", "niurou" , "meat" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一盘香喷喷的烤牛肉。\n");
                set("unit", "盘");
                set("value", 300);
                set("food_remaining", 4);
                set("food_supply", 30);
                set("material", "food");
        }
        setup();
}
