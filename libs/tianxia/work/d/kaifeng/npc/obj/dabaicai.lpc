inherit F_FOOD;
inherit ITEM;

void create()
{
        set_name("大白菜", ({ "da baicai" , "baicai"}) );
        set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一棵绿油油的大白菜.\n");
                set("unit", "棵");
                set("value", 100);
                set("food_remaining", 10);
                set("food_supply", 1);
                set("material", "food");
        }
        setup();
}
