inherit ITEM;
#include <ansi.h>
void create()
{
        set_name(MAG"香粉" NOR, ({ "xiang fen"}) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "盒");
                set("long", "一盒香喷喷的粉.\n");
                set("value", 1000);
        }
}

