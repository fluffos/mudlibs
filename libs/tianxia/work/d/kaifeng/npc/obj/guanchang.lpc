inherit F_FOOD;
inherit ITEM;

void create() {
  set_name("灌肠", ({ "guan chang" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盘刚烧好的灌肠。\n");
    set("unit", "盘");
    set("value", 100);
    set("food_remaining", 6);
    set("food_supply", 3);
    set("material", "food");
  }
  setup();
}
