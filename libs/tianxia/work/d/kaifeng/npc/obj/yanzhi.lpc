inherit ITEM;
#include <ansi.h>
void create()
{
        set_name(RED"胭脂" NOR, ({ "yan zhi"}) );
        set_weight(30);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "盒");
                set("long", "一盒上等胭脂.\n");
                set("value", 50000);
        }
}

