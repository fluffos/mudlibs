inherit F_FOOD;
inherit ITEM;

void create()
{
        set_name("臭豆腐", ({ "chou doufu" , "doufu"}) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一盘又香又臭的臭豆腐。\n");
                set("unit", "盘");
                set("value", 100);
                set("food_remaining", 4);
                set("food_supply", 10);
                set("material", "food");
        }
        setup();
}
