// smith.c

inherit SMITH;

void create()
{
	set_name("刘秃子", ({ "liu tu zi" }) );
	set("gender", "男性" );
	set("title","铁匠");
	set("age", 48);
	set("str",88);
	set("long", "开封铁器铺老板。\n");
	set("combat_exp", 300);
	set("attitude", "friendly");
	set_skill("dodge", 60);
	set_skill("unarmed", 60);

	set_weapon_ability(({"stick", "blade", "whip","staff"}));
	set_ability_level(10);

	setup();

	carry_object(ARMOR_DIR+"cloth")->wear();
}
