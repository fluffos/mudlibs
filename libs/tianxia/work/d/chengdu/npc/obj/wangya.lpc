// wangya.c

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("王胖鸭", ({ "wangpang ya" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一盘王胖鸭。\n");
                set("unit", "盘");
                set("value", 500);
                set("food_remaining", 6);
                set("food_supply", 12);
        }
}

