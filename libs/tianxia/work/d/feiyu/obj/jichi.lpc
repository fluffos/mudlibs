inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("鸡翅", ({ "ji chi" }) );
        set_weight(1000);
        if( clonep() )  
                set_default_object(__FILE__);
        else {
                set("long", "一块香喷喷鸡翅膀。\n");
                set("unit", "块");
                set("food_remaining", 3);
                set("food_supply", 15);
        }
}

