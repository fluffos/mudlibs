// smith.c

inherit SMITH;

void create() {
  set_name("周铁匠", ({ "smith zhou", "zhou", "smith" }));
  set("gender", "男性");
  set("age", 38);
  set("str", 88);
  set("long", "铁匠铺老板张铁匠。\n");
  set("combat_exp", 300);
  set("attitude", "friendly");
  set_skill("dodge", 60);
  set_skill("unarmed", 60);
  setup();

  carry_object(ARMOR_DIR + "cloth")->wear();
}
