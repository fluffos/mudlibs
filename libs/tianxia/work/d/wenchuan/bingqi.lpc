// bingqi.c  兵器铺

#include <ansi.h>

inherit ROOM;
void create() {
  set("short", "李记兵器铺");
  set("long", @LONG
李记兵器铺是汶川字号最老的兵器铺了，墙上挂满了各式各
样的兵器兵器铺的李老板正在柜台后面看书，一见你进来，马
上放下书，笑眯眯的迎了上来。
LONG
  );

  set("night_long", @LONG
李记兵器铺是汶川字号最老的兵器铺了，墙上挂满了各式各
样的兵器不过这里已经打烊了，兵器铺的李老板正在柜台后面
拿着帐本算帐。
LONG
  );

  set("exits", ([
    "west": __DIR__ "shilu",
  ]));

  set("no_sleep_room", 1);

  set("objects", ([
    //	__DIR__"npc/xxxx" : 1,
  ]));

  setup();
}

