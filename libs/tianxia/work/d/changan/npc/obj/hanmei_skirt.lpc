// hanmei_skirt.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("寒梅素底裙", ({ "hanmei skirt", "skirt" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "白绸的底料上绣着几枝傲雪盛开的寒梅。\n");
    set("unit", "件");
    set("value", 500);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/personality", 3);
    set("female_only", 1);
  }
  setup();
}
