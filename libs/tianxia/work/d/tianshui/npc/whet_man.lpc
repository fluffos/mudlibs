// whet_man.c

inherit NPC;

void create() {
  set_name("磨刀人", ({ "whet man", "man" }));
  set("long", @TEXT
以帮人磨菜刀为生。
TEXT
  );
  set("gender", "男性");
  set("age", 37);
  set("con", 30);
  set("str", 20);
  set("combat_exp", 1300);
  set("attitude", "peaceful");
  set("chat_chance", 5);
  set("chat_msg", ({
    "磨刀人喊着：“磨菜刀喽！磨剪子磨刀喽！”\n",
    (: random_move :),
  }));
  setup();
  carry_object(ARMOR_DIR "cloth")->wear();
  carry_object(__DIR__ "obj/m_stone");
}
