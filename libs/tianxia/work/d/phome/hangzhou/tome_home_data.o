dbase (["exits":(["south":"/d/hangzhou/changanw4","north":"/d/phome/hangzhou/tome_home2",]),"Safe_Environment":1,"master_id":"tome","short":"[1;33m【陈枫家的大院[1;33m】[2;37;0m","master_name":"陈枫","item_desc":(["south":,]),"built_time":1017039785,"outdoors":"playerhome","long":"这是陈枫家的大院，一条碎石铺成的小路在院子里延伸,西面是一个小小的荷塘，荷塘的面积不大，但荷花却开的分外茂盛，低头看看水面，锦鲤摆尾溅起的涟漪在渐渐的散开，荷叶上的露水虽着荷叶的摇摆，轻轻的落入水中,小路的东面是一片一片幽静的竹林，远离市集的喧嚣，只有偶尔经过的翠鸟才会打破这沁人的静寂。",])
