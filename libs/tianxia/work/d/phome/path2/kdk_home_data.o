dbase (["long":"这里是华山派大侠孙申的家，这里鸟语花香，树木郁郁葱葱客厅里摆放了许多孙申的照片和图画当你走进这里的时候，就有一种回家的感觉卧室里放着书桌和床，饱读诗书的孙申家里果然有一种不同凡响的书香感觉最后，欢迎我本流浪汗，草湘湘等各界人士参观访问","objects":(["/obj/furniture/chuang":1,"/obj/furniture/shuzhuangtai":1,]),"Safe_Environment":1,"item_desc":(["west":,]),"exits":(["west":"/d/path2/da_hou1",]),"built_time":1017806023,"master_id":"kdk","valid_startroom":1,"short":"[1;33m【孙申的瓦房[1;33m】[2;37;0m","master_name":"孙申",])
