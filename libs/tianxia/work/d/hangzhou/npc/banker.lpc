// banker.c

inherit NPC;

void create()
{
	set_name("佟愁乡", ({ "tong shouxiang","tong"}) );
	set("title", "钱庄掌柜");
	set("gender", "男性" );
	set("age", 50);

	set("long",
"佟愁乡是杭州钱庄的大掌柜，白白胖胖的大脸上
永远挂着憨厚的微笑。\n");

	set("combat_exp", 50000);
	set("attitude", "friendly");

	set_skill("unarmed",100);
	set_skill("parry", 100);
	set_skill("dodge", 100);
	setup();

	carry_object(WEAPON_DIR"sword")->wield();
	carry_object(ARMOR_DIR"cloth")->wear();
}
