// smith.c

inherit SMITH;

void create()
{
	set_name("黄铁匠", ({ "smith huang" }) );
        set("gender", "男性" );
        set("age", 48);
	set("str",80);
        set("long", "他就是杭州铁匠铺的黄铁匠。\n");
        set("combat_exp", 2000);
        set("attitude", "friendly");
        set_skill("dodge", 60);
        set_skill("unarmed", 60);
        setup();

	carry_object(ARMOR_DIR+"cloth")->wear();
}