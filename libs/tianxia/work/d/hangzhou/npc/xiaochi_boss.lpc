// xiaochi_boss.c

inherit F_DEALER;

void create() {
  set_name("胖掌柜", ({ "zhang gui" }));
  set("title", "小吃店");
  set("gender", "男性");
  set("age", 46);
  set("sell_all_day", 1);
  set("long", "这是杭州小吃店的掌柜。\n");
  set("combat_exp", 50);
  set("attitude", "friendly");
  set("vendor_goods", ([
    __DIR__ "obj/doujiang": 20,
  ]));
  setup();
  carry_object(ARMOR_DIR "cloth")->wear();
}
