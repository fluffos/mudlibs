//cassock.c  袈裟。
#include <armor.h>
inherit CLOTH;
void create() {
  set_name("紫红袈裟", ({ "purple cassock", "cassock", }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 2);
  }
  setup();
}
