//zang－xue.c 藏靴。
#include <armor.h>
inherit BOOTS;

void create() {
  set_name("藏靴", ({ "zang xue", "shoes", "zx" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "cloth");
    set("unit", "双");
    set("value", 1000);
    set("armor_prop/armor", 1);
  }
  setup();
}
