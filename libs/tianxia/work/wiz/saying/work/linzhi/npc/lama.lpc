//lama.c 藏族喇嘛。
inherit NPC;
void create()
{
        set_name("喇嘛", ({ "lama" }) );
        set("age", 33);
        set("long", "德木寺的喇嘛。\n");
        
        set("str",25);
        set("per",10);
        set("inquiry",([
        "德木寺":"小僧就是德木寺的喇嘛。",
]));        
        setup();
        carry_object(__DIR__"obj/cassock")->wear();
}
