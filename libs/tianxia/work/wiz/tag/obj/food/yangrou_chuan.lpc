//yangrou_chuan.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("羊肉串", ({ "yangrou chuan " }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一串香喷喷的羊肉串，撒上了孜然和辣椒末。\n");
    set("unit", "串");
    set("value", 20);
    set("food_remaining", 2);
    set("food_supply", 20);
  }
  setup();
}
