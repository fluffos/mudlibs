string chinese_number(int i)
{
  return CHINESE_D->chinese_number(i);
}
string to_chinese(string str)
{
  return CHINESE_D->chinese(str);
}
int is_chinese(string str)
{
    int i;
    if (!stringp(str) || str == "")
        return 0;
    // plain-LPC equivalent of pcre_match(str, "^\\p{Han}+$") -- the WASM
    // driver build ships without the pcre package and a pcre efun inside
    // simul_efun would block the whole boot (AGENTS.md §1.3d).
    for (i = 0; i < strlen(str); i++) {
        if ((str[i] >= 0x4e00 && str[i] <= 0x9fff)      // CJK Unified
            || (str[i] >= 0x3400 && str[i] <= 0x4dbf)   // Ext A
            || (str[i] >= 0xf900 && str[i] <= 0xfaff))  // Compat Ideographs
            continue;
        return 0;
    }
    return 1;
}