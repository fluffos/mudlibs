#include <ansi.h>
inherit NPC;
int get_short(string rep, string arg, string *householder);
int get_long(string arg, string *householder,string short,string rep);
int save_file(string short, string llong, string *householder);
void create()
{
  set_name("老头", ({"officer","oldman"}));
  set("gender", "男性");
  set("age", 100);
  set("long",
"泾水河边的居民逐渐增多，因此特别在此设立房管所，临时由一个不知名的老头负责。?\n");
  set("attitude", "friendly");
  set("combat_exp", 250000);
  set("per", 25);
  set_skill("dodge", 60);
  set("max_sen",600);
  set("max_gee",600);
  set("max_gin",600);
  set("force",800);
  set("max_force",800);
  set("max_mana",800);
  set("force_factor",25);
  set_skill("spells",60);
  set_skill("stick",60);
  setup();
  carry_object("/obj/cloth/choupao")->wear();
  add_money("coin", 100);
}

void init()
{
  ::init();
  add_action("do_apply", "apply");
}

int do_apply(string arg)
{
  object me,spouse,room, where, officer;
  string str, partner;
  seteuid(geteuid());
  me = this_player();
  if (!playerp(me) || !living(me))
    return 0;
  where = environment(this_object());
  if (!objectp(where))
    return 0;

  officer = this_object();

  if (!objectp(officer) || !living(officer))
    return 0;

  if(!arg)
    return notify_fail("你要申请什么？\n");
  if(arg != "house" )
    return notify_fail("你要申请什么？\n");
  if((string)where->query("short") != HIB"房管所"NOR)
    return notify_fail(sprintf("%s乐呵呵地说：%s若有什么需要帮忙的，"
             "请到敝室去。\n",name(),RANK_D->query_respect(me)));

  if(!(me->query("couple/id")))
  {
    message_vision("$N叹了叹道：$n既是独身一人，"
                   "自然逍遥自在。何苦自求束缚？\n",officer,me);
    return 3;
  }

  if(file_size("/data/playerhomes/h_"+me->query("id")+".o") != -1)
  {
    message_vision("$N瞟了$n一眼，说道：你不是已经有了房子吗？\n",officer,me);
    return 1;
  }

  if((me->query("gender")) == "男性")
    str = "妻子";
  else
    str = "丈夫";
  partner = me->query("couple/id");
  if(file_size("/data/playerhomes/h_"+partner+".o") != -1)
  {
    message_vision("$N瞟了$n一眼，说道：你的另一半不是已经有了房子吗？\n",officer,me);
    return 1;
  }

  if(!(spouse = present(partner, environment(me))))
  {
    message_vision("$N对着$n摇了摇头道：领房这么大的事，"
                   "你还是和你的另一半一起来的好！\n", officer, me);
    return 1;
  }

  if(!me->query_temp("rental_paid") && !spouse->query_temp("rental_paid"))
    return notify_fail("世上只怕没有便宜的房子哦。\n");
  message_vision("$N笑眯眯地对$n道：娶妻、领房、生子，人生三大事耶！\n", officer, me);
  me->set_temp("is_applying_house",1);
  room=new("/obj/home.lpc");
  room->set("file_name","h_"+me->query("id"));
  room->set("home_host",({me->query("id")})+({partner}));
  room->save();
  message_vision("$N说道：房子已经建好了，您这就去装修吧！\n",officer);
  return 1;
}

int accept_object(object who, object ob)
{
  if (!objectp(ob))
    return 0;

  if(!ob->query("money_id"))
    return 0;
  if (ob->value()< 1000000)
  {
    if(who->query_temp("is_applying_house"))
    {
      command(sprintf("say %s出手这么大方？你不是办过手续了吗？\n",who->name()));
      return 0;
    }

    else
    {
      command(sprintf("say %s这么小气，这点钱就可以买房了？\n",who->name()));
      return 0;
    }

  }

  else
  {
    if(who->query_temp("is_applying_house"))
    {
      command(sprintf("say %s出手这么大方。你不是办过手续了吗？\n",who->name()));
      return 0;
    }

    else
    {
      command("say "+RANK_D->query_respect(who) +"若是想申请房子，尽管说。\n");
      who->set_temp("rental_paid", 1);
    }

  }

  return 1;
}