#include <ansi.h>
inherit NPC;
#define S_DIR "/daemon/class/"
int do_choose(string arg);
void create()
{
  set_name(CYN"测试使者"NOR,({"test shizhe","shizhe", "giftman"}));
  set("gender", "男性" );
  set("age",1000 + random(1000));
  set("long","这是天神为了帮助新玩家熟悉本游戏而设置的测试人员。\n");

  set_skill("force",600+random(100));
  set_skill("spells",600+random(100));
  set_skill("dodge",600 + random(100));
  set_skill("unarmed",600+random(100));
  set_skill("parry",600+random(100));
  set_skill("whip",600+random(100));

  set_skill("tonsillit",600+random(100));
  set_skill("gouhunshu",600+random(100));
  set_skill("ghost-steps",600 + random(100));
  set_skill("jinghun-zhang",600+random(100));
  set_skill("sanqing-fuchen",600+random(100));

  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");
  map_skill("whip","sanqing-fuchen");
  map_skill("parry","sanqing-fuchen");
  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/armor/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/whip/fuchen")->wield();
}

void init()
{
  if (!playerp(this_player()))
    return;
  add_action("do_choose",({"choose","xuanze"}));
  tell_object(this_player(),"请先选择(choose)一个门派，然后。。。呵呵！\n");
}

string query_skill_enable(string msk)
{
  int i;
  string *valid_type = ({
    "archery",
    "axe",
    "blade",
    "dagger",
    "dodge",
    "force",
    "hammer",
    "mace",
    "spear",
    "spells",
    "staff",
    "stick",
    "sword",
    "throwing",
    "unarmed",
    "whip",
  });
  for (i = 0; i < sizeof(valid_type); i++)
    if (SKILL_D(msk)->valid_enable(valid_type[i]))
      break;
  if (i >= sizeof(valid_type))
    return 0;
  return valid_type[i];
}

int do_choose(string arg)
{
  string msg,tmp,cname,hname,skill_dir,sk,msk;
  mixed *file;
  string *ks, *km;
  int i;
  object who = this_player();
  mapping myfam, family, skills;
  mapping menpai = ([
    "putuo" : (["family_name" : "南海普陀山",
                "family_id"   : "putuo",
                "family_class" : "bonze",
                "family_master" : "观音菩萨",
                "family_master_id" : "guanyin pusa",
               ]),
    "sea" : (["family_name" : "东海龙宫",
              "family_id" : "longgong",
              "family_class" : "dragon",
              "family_master" : "敖广",
              "family_master_id" : "ao guang",
            ]),
    "jjf" : (["family_name" : "将军府",
              "family_id" : "jjf",
              "family_class" : "fighter",
              "family_master" : "白发老人",
              "family_master_id" : "lao ren",
            ]),
    "hell" : (["family_name" : "阎罗地府",
              "family_id" : "hell",
              "family_class" : "ghost",
              "family_master" : "地藏王菩萨",
              "family_master_id" : "dizang pusa",
            ]),
    "hyd" : (["family_name" : "火云洞",
              "family_id" : "huoyun",
              "family_class" : "kusong",
              "family_master" : "火魔神君",
              "family_master_id" : "huomo shenjun",
            ]),
    "moon" : (["family_name" : "月宫",
              "family_id" : "moon",
              "family_class" : "moon",
              "family_master" : "西王母",
              "family_master_id" : "xi wangmu",
            ]),
    "fc" : (["family_name" : "方寸山三星洞",
              "family_id" : "fangcun",
              "family_class" : "puti",
              "family_master" : "菩提祖师",
              "family_master_id" : "master puti",
            ]),
    "wdd" : (["family_name" : "陷空山无底洞",
              "family_id" : "wudidong",
              "family_class" : "wudidong",
              "family_master" : "玉鼠精",
              "family_master_id" : "yu shu",
            ]),
    "xueshan" : (["family_name" : "大雪山",
              "family_id" : "xueshan",
              "family_class" : "xueshan",
              "family_master" : "孔雀明王",
              "family_master_id" : "kongque mingwang",
            ]),
    "zhenyuan" : (["family_name" : "五庄观",
              "family_id" : "wzg",
              "family_class" : "zhenyuan",
              "family_master" : "镇元大仙",
              "family_master_id" : "zhenyuan daxian",
            ]),
  ]);

  if (who->is_busy())
    return notify_fail("你现在很忙，不要着急！\n");

  km = keys(menpai);
  if (!arg || member_array(arg,km) == -1)
  {
    msg = HIW"本泥巴共有如下10个门派，请选择其中一个(字母简称代号)：\n"NOR;
    msg += HIY"字母简称代号        | 门派中文名称        | 帮助名称\n"NOR;
    msg += HIB"------------------------------------------------\n"NOR;

    foreach (tmp in km)
    {
      cname = menpai[tmp]["family_name"];
      hname = HIY + menpai[tmp]["family_id"] + NOR;
      msg += sprintf("%s%-12s%s        | %s%-12s%s        | help %s\n",
                 HIY + BBLU,tmp,NOR,HIW,cname,NOR,hname);
    }

    msg += HIB"------------------------------------------------\n"NOR;
    msg += HIR"\n选择之前请仔细查看该门派的帮助，了解相应的perform或者cast，请用chaxun命令。\n"NOR;
    msg += "请help chaxun了解chaxun命令的用法\n\n";
    msg += "===请选择===\n";
    write(msg);
    who->start_busy(1);
    return 1;
  }

  if (arg == "moon" && (string)who->query("gender") != "女性")
    return notify_fail("注意：只有女性才可以选择月宫！\n");

  family = who->query("family");
  if (mapp(family) && sizeof(family) > 0)
  {
    if (!who->query_temp("re_choose_family"))
    {
      tell_object(who,"你现在是" + family["family_name"] + "的弟子！\n");
      tell_object(who, "如果你想换个门派测试，请再次选择(choose)门派！\n");
      who->set_temp("re_choose_family",1);
      return 1;
    }

    who->delete_temp("re_choose_family");
    tell_object(who,"你决定换一个门派进行测试！原来的门派信息被清除！\n");
    who->delete("family");
    write("原有门派删除完毕。。。\n");
    write("原有技能删除");
    skills = who->query_skills();
    if (mapp(skills) && sizeof(skills) > 0)
    {
      ks = keys(skills);
      foreach (tmp in ks)
      {
        who->delete_skill(tmp);
        write("。");
      }

    }

    write("\n原有技能删除完毕！\n");
  }

  write("设置武学：500万。。。");
  who->set("combat_exp",5000000);
  write("设置道行：5000年。。。\n");
  who->set("daoxing",5000000);
  write("设置基本招架。。。");
  who->set_skill("parry",300);
  write("设置基本轻功。。。");
  who->set_skill("dodge",300);
  who->set_skill("feiyan-zoubi",300);
  write("设置读书识字。。。\n");
  who->set_skill("literate",300);
  write(sprintf("设置门派(%s)信息和技能300级别：\n",arg));
  myfam = menpai[arg];
  family = ([]);
  family["family_name"] = myfam["family_name"];
  family["master_name"] = myfam["family_master"];
  family["master_id"] = myfam["family_master_id"];
  family["generation"] = 2;
  family["family_faith"] = 20000;
  who->set("balance",10000000);
  if (myfam["family_class"] == "xueshan" ||
      myfam["family_class"] == "wudidong" ||
      myfam["family_class"] == "kusong")
    who->set("class","yaomo");
  else if (myfam["family_class"] == "zhenyuan")
    who->set("class","xian");
  else if (myfam["family_class"] == "puti")
    who->set("class","taoist");
  else
    who->set("class",myfam["family_class"]);
  who->set("family",family);
  skill_dir = S_DIR + myfam["family_class"] + "/";
  if (file_size(skill_dir) != -2)
  {
    log_file("test_err",sprintf("%s not found!\n",skill_dir));
    write("没有找到相应的技能，请向ｗｉｚ反应，谢谢！\n");
    return 1;
  }

  file = get_dir(skill_dir,-1);
  if (!sizeof(file))
  {
    log_file("test_err",sprintf("%s is empty!\n",skill_dir));
    write("没有找到相应的技能，请向ｗｉｚ反应，谢谢！\n");
    return 1;
  }

  i = sizeof(file);
  while (i--)
  {
    reset_eval_cost();
    msk = 0;
    sk = 0;
    if (file[i][1] == -2)
    {
      msk = file[i][0];
      sk = query_skill_enable(msk);
    }

    if (stringp(sk))
    {
      write(sprintf("设置%s。。。",sk));
      who->set_skill(sk,300);
    }

    if (stringp(msk))
    {
      write(sprintf("设置%s。。。\n",msk));
      who->set_skill(msk,300);
    }

    if (stringp(sk) && stringp(msk))
      who->map_skill(sk,msk);
  }

  if (myfam["family_class"] == "moon" ||
      myfam["family_class"] == "fighter")
    who->set_skill("archery",300);
  if (myfam["family_class"] == "moon")
    who->set_skill("jiutian-arrow",300);
  if (myfam["family_class"] == "fighter")
    who->set_skill("chuanyang-arrow",300);
  if (myfam["family_class"] == "xueshan")
  {
    who->set_skill("poison",300);
    who->set_skill("xueshan-dushu",300);
  }

  who->set("common/can_exert/recover",1);
  who->set("common/can_exert/refresh",1);
  who->set("common/can_exert/heal",1);
  who->set("common/can_exert/dispel",1);
  who->set("common/can_exert/lifeheal",1);
  who->set("common/can_exert/inspire",1);
  who->set("common/can_exert/powerup",1);
  who->set("common/can_cast/chuqiao",1);
  who->set("common/can_cast/transfer",1);
  who->set("common/can_cast/tuoqiao",1);
  write("设置最大内力4500。。。");
  who->set("max_force",4500);
  who->set("maximum_force",4500);
  write("设置最大法力4500。。。");
  who->set("max_mana",4500);
  who->set("maximum_mana",4500);
  write("\n设置完毕！下次login将产生最佳效果！\n");
  who->start_busy(2);
  return 1;
}

