void create()
{
  seteuid(getuid());
  restore();
  set_heart_beat(1440);
  if (!mapp(all_city_info) || sizeof(all_city_info) < 1)
  {
    all_city_info = ([]);
    init_all_city_info();
  }

  if (!mapp(city_sell) || sizeof(city_sell) < 1)
  {
    city_sell = ([]);
    init_city_sell();
  }

  if (!mapp(invote) || sizeof(invote) < 1)
  {
    invote = ([]);
    add_a_new_invote();
  }

  if (!mapp(event))
    event = ([]);
  if (!mapp(workshop))
    workshop = ([]);
}

