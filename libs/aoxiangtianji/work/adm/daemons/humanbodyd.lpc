inherit F_CLEAN_UP;
mapping part_name = ([
  "head" : "头部",
  "neck" : "颈部",
  "arm"  : ({"左臂","右臂"}),
  "hand" : ({"左手","右手"}),
  "leg"  : ({"左腿","右腿"}),
  "foot" : ({"左脚","右脚"}),
  "body" : ({"身体", "胸口", "后心", "左肩", "右肩","腰间", "小腹"}),
]);
void create() {seteuid(getuid());}

string query_ename(string part)
{
  mixed cname;
  string *kp;
  int i;

  kp = keys(part_name);
  for (i=0;i<sizeof(kp);i++)
  {
    cname = part_name[kp[i]];
    if (stringp(cname))
    {
      if (cname == part)
        break;
    }

    else if (arrayp(cname))
    {
      if (member_array(part,cname) != -1)
        break;
    }

  }

  if (i < sizeof(kp))
    return kp[i];
  return "body";
}

mixed query_cname(string part)
{
  return part_name[part];
}

mapping query_parts_armor_map(object me, string part)
{
  string ename, *limbs;
  mapping part_m;
  if (!objectp(me))
    return ([]);
  limbs = me->query("limbs");
  if (!arrayp(limbs) || sizeof(limbs) < 1)
  {
    limbs = ({ "身体" });
    me->set("limbs", limbs);
  }

  if (member_array(part,limbs) == -1)
    return ([]);
  ename = query_ename(part);
  if (!stringp(ename))
    return ([]);
  part_m = me->query_temp("armor_parts/" + ename);
  if (!mapp(part_m))
    return ([]);
  return part_m;
}

int query_parts_armor_value(object me, string part)
{
  int armor;

  mapping part_m = query_parts_armor_map(me,part);
  if (!mapp(part_m) || sizeof(part_m) < 1)
    return 0;
  armor =  part_m["armor"];
  if (armor > 150)
    armor = 150 + (armor - 150)/2;
  return armor;
}

object* query_parts_armor_obj(object me, string part)
{
  object *obs;
  mapping part_m;

  part_m = query_parts_armor_map(me,part);
  obs = ({});
  if (!mapp(part_m) || sizeof(part_m) < 1)
    return obs;
  obs = part_m["item"];
  return obs;
}

mapping query_parts_armor_info(object me, string part)
{
  object ob, *obs;
  mapping result;

  result = ([]);
  obs = query_parts_armor_obj(me,part);
  if (!arrayp(obs) || sizeof(obs) < 1)
    return result;
  foreach (ob in obs)
    result += ([
                ob->query("name") : ob->query("armor_prop/armor")
              ]);
  return result;
}

