#include <ansi.h>
void startup();
// 任务对象创建
void create()
{
  seteuid(getuid());
  if (! clonep() && find_object(TEAMJOB_D))
    startup();
}
void start_quest()
{
  object qob, *obs;
  obs = children("/clone/quest/teamjob/teamwar");
  if (arrayp(obs) && sizeof(obs) > 0)
    foreach (qob in obs)
      if (qob->name() == "未名任务" && qob->query("live_time") < 1)
        destruct(qob);

  if (sizeof(children("/clone/quest/teamjob/teamwar")) > 0)
    return;
  qob = new("/clone/quest/teamjob/teamwar");
  TEAMJOB_D->set_teamjob_name(qob);
  qob->init_quest();
  CHANNEL_D->do_channel(find_object(TEAMJOB_D),
                        "sys", "进程(teamwar)"
                        HIR "创建了一个任务。");
}
private void heart_beat()
{
  if (! find_object(TEAMJOB_D))
    return;
// 如果可以，每次心跳产生一个QUEST
  start_quest();
}
// 任务守护进程唤醒这个进程
void startup()
{
// 启动
  if (! find_object(TEAMJOB_D))
  {
    CHANNEL_D->do_channel(this_object(), "sys", sprintf("%s not found!\n",TEAMJOB_D));
    return;
  }

  if (!query_heart_beat())
  {
    CHANNEL_D->do_channel(find_object(TEAMJOB_D),
                          "sys", "进程(TEAMWAR)启动了。");
  }
  // 平均每30min产生一个任务
   set_heart_beat(2400+random(200));
}
// 停止这个任务进程
void stop()
{
  set_heart_beat(0);
}
