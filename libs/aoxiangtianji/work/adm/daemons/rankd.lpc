string describe_touch(int value)
{
  int lvl, grade, n;
  lvl=value/20;
  for(grade=0;grade<sizeof(tough_level_desc);grade++)
  {
    n=(grade+1)*(grade+1)*(grade+1);
    if(lvl<n) break;
  }

  if(grade>=sizeof(tough_level_desc))
    grade=sizeof(tough_level_desc)-1;
  return tough_level_desc[grade];
}

string describe_dx(int value)
{
  int grade, two_year, n;

  two_year = value/2000;
  for(grade=0; grade<sizeof(dx_level_desc); grade++)
  {
    n = (grade+1)*(grade+1)*(grade+1);
    if( two_year<n )
      break;
  }

  if( grade>=sizeof(dx_level_desc) )
    grade=sizeof(dx_level_desc)-1;
  return dx_level_desc[grade];
}

int grade_dx(string desc)
{
  int grade, n;
  for(grade=0; grade<sizeof(dx_level_desc); grade++)
  {
    n = grade;
    if ( dx_level_desc[grade] == desc )
      return n;
  }

  return 0;
}

string describe_exp(int value)
{
  int grade, lvl , n;

  lvl = (value*2)/1100;
  for(grade=0; grade<sizeof(exp_level_desc); grade++)
  {
    n = (grade+1)*(grade+1)*(grade+1);
    if( lvl<n )
      break;
  }

  if( grade>=sizeof(exp_level_desc) )
    grade=sizeof(exp_level_desc)-1;
  return exp_level_desc[grade];
}

int grade_exp(string desc)
{
  int grade, n;
  for(grade=0; grade<sizeof(exp_level_desc); grade++)
  {
    n = grade;
    if ( exp_level_desc[grade] == desc )
      return n;
  }

  return 0;
}

string describe_neili(int value)
{
  int year, sixty, left;
  string line;

  year = value/100;
  sixty = year/60;
  left = year - sixty*60;
  if( year <= 0 )
  {
    line = HIB "不到一年" NOR;
    return line;
  }

  if(sixty > 0 )
  {
    if ( left != 0 )
    {
      line = HIW + chinese_number(sixty) + "甲子" + NOR + "又"
          +  HIR + chinese_number(left) + "年" + NOR;
    }

    else
    {
      line = HIW + chinese_number(sixty) + "甲子"  + NOR;
    }

  }

  else
    line = HIR + chinese_number(year)+"年" + NOR;
  return line;
}

string describe_fali(int value)
{
  int grade, lvl, n;
//in unit of 40, increase by n^2.
  lvl=value/40;
  for(grade=0; grade<sizeof(fali_level_desc); grade++)
  {
    n=(grade+1)*(grade+1);
    if( lvl<n )
      break;
  }

  if( grade>=sizeof(fali_level_desc) )
    grade=sizeof(fali_level_desc)-1;
  return fali_level_desc[grade];
}

int grade_fali(string desc)
{
  int grade;
  for(grade=0; grade<sizeof(fali_level_desc); grade++)
  {
    if ( (string)fali_level_desc[grade] == desc )
      return grade;
  }

  return 0;
}

string query_description(int type)
{
  int i;
  string *level_desc;
  string line = "";

  if(type==0)
    level_desc = dx_level_desc;
  else if(type==1)
    level_desc = exp_level_desc;
  else
    level_desc = fali_level_desc;

  for(i=0; i<sizeof(level_desc); i++)
  {
    line += level_desc[i] + "    ";
    if( (i%4)==3 )
      line += "\n";
  }

  return line;
}

string _query_rank(object ob);
string query_rank(object ob)
{
  string rank=_query_rank(ob);
  string s1,s2,s3;
  int len, len1, len2;

  if(sscanf(rank,"%s【%s】%s",s1,s2,s3)!=3)
    return rank;
  len=14-sizeof(s2);
  if(len<1)
    return rank;
  len1=len/2;
  len2=len-len1;
  if(len1)
    s2=repeat_string(" ",len1)+s2;
  if(len2)
    s2+=repeat_string(" ",len2);
  return s1+"【"+s2+"】"+s3;
}

string _query_rank(object ob)
{
  string at;
  int dx, exp, avg, age;
  if(strlen(ob->query("added_title"))<1)
    ob->set("added_title", "无名");
  at = ob->query("added_title");
  dx = (int)ob->query("daoxing");
  exp = (int)ob->query("combat_exp");
  avg = dx*2/3 + exp/3;
  age = ob->query("age");
  if( ob->is_ghost() )
    return HIB "【 鬼  魂 】" NOR;
  switch(ob->query("gender"))
  {
    case "女性":
      switch(wizhood(ob))
      {
        case "(admin)":
          return GRN "【 巫  女 】" NOR;
        case "(arch)":
          return GRN "【 巫  女 】" NOR;
        case "(wizard)":
          return GRN "【 巫  女 】" NOR;
        case "(apprentice)":
          return GRN "【见习巫女】" NOR;
        case "(immortal)":
          return GRN "【客座巫女】" NOR;
        case "(elder)":
          return GRN "【荣誉巫师】" NOR;
        default:
          switch(ob->query("class"))
          {
            case "xian":
            case "moon" :
              if(avg<1000000)
                return GRN "【 玉  女 】" NOR;
	      else if(avg<2500000)
                return GRN "【 小仙姑 】" NOR;
	      else if(avg<8000000)
                return GRN "【 仙  女 】" NOR;
              else if(avg<15000000)
                return GRN "【"+at+"仙子】" NOR;
              else if(avg<30000000)
                return GRN "【"+at+"娘娘】" NOR;
              else
                return GRN "【"+at+"月仙】" NOR;
              break;

            case "yaomo":
              if(avg<1000000)
                return GRN "【 小妖女 】" NOR;
              else if(avg<2500000)
                return GRN "【 妖  女 】" NOR;
              else if(avg<8000000)
                return GRN "【 妖  精 】" NOR;
              else if(avg<15000000)
                return GRN "【"+at+"妖仙】" NOR;
              else if(avg<30000000)
                return GRN "【"+at+"女魔】" NOR;
              else
                return GRN "【"+at+"魔女】" NOR;
              break;

            case "bonze":
              if(avg<1000000)
                return GRN "【 小尼姑 】" NOR;
              else if(avg<2500000)
                return GRN "【 小师太 】" NOR;
              else if(avg<8000000)
                return GRN "【 贤  尼 】" NOR;
              else if(avg<15000000)
                return GRN "【"+at+"德尼】" NOR;
              else if(avg<30000000)
                return GRN "【"+at+"圣尼】" NOR;
              else
                return GRN "【"+at+"神尼】" NOR;
              break;

            case "taoist":
              if(avg<1000000)
                return GRN "【 女道童 】" NOR;
              else if(avg<2500000)
                return GRN "【 小道姑 】" NOR;
              else if(avg<8000000)
                return GRN "【 玄  女 】" NOR;
              else if(avg<15000000)
                return GRN "【"+at+"仙女】" NOR;
              else if(avg<30000000)
		return GRN "【"+at+"圣女】" NOR;
              else
                return GRN "【"+at+"圣母】" NOR;
              break;

            case "dragon":
              if(avg<1000000)
                return GRN "【 小宫娥 】" NOR;
              else if(avg<2500000)
		return GRN "【 宫  娥 】" NOR;
              else if(avg<8000000)
                return GRN "【 宫  女 】" NOR;
              else if(avg<15000000)
                return GRN "【"+at+"小龙女】" NOR;
              else if(avg<30000000)
                return GRN "【"+at+"龙女】" NOR;
              else
                return GRN "【"+at+"公主】" NOR;
              break;

            case "scholar":
              if( (string)at=="未设" )
              {
		if((int)ob->query_skill("literate", 1)<40)
                  return GRN "【 女学童 】" NOR;
                else if((int)ob->query_skill("literate", 1)<200)
                  return GRN "【 才  女 】" NOR;
                else
                  return GRN "【 女学士 】" NOR;
              }

              else
              {
                if((int)ob->query_skill("literate", 1)<40)
                  return GRN "【 女学童 】" NOR;
                else if((int)ob->query_skill("literate", 1)<200)
                  return GRN "【"+at+"秀才】" NOR;
                else
                  return GRN "【"+at+"学士】" NOR;
              }

              break;
            case "fighter":
              if(exp<1000000)
                return GRN "【 女  兵 】" NOR;
              else if(exp<2500000)
                return GRN "【 女参将 】" NOR;
              else if(exp<8000000)
                return GRN "【 女军师 】" NOR;
              else if(exp<15000000)
                return GRN "【"+at+"女将军】" NOR;
              else if(exp<30000000)
                return GRN "【"+at+"大将军】" NOR;
              else
                return GRN "【"+at+"大元帅】" NOR;
              break;
            case "tianpeng":
              if(avg<1000000)
                return GRN "【 女  侠 】" NOR;
              else if(avg<2500000)
                return GRN "【 女少侠 】" NOR;
              else if(avg<8000000)
                return GRN "【 女大侠 】" NOR;
              else if(avg<15000000)
                return GRN "【"+at+"女奇侠】" NOR;
              else if(avg<30000000)
                return GRN "【"+at+"女长老】" NOR;
              else
                return GRN "【"+at+"女元帅】" NOR;
              break;

            case "youling":
              if(avg<1000000)
                return GRN "【 阴曹小鬼 】" NOR;
              else if(avg<2500000)
                return GRN "【 迷魂女鬼 】" NOR;
              else if(avg<8000000)
                return GRN "【 幽冥女使 】" NOR;
              else if(avg<15000000)
                return GRN "【"+at+"无常】" NOR;
              else if(avg<30000000)
                return GRN "【"+at+"女主】" NOR;
              else
                return GRN "【"+at+"女王】" NOR;
              break;

            case "dancer":
              return GRN "【 舞  妓 】" NOR;
              break;

            default:
              if (age <= 18)
                return MAG"【 少  女 】"NOR;
              else
                return  MAG"【 民  妇 】" NOR;
          }

       }

//begin 男性：
    default:
      switch(wizhood(ob))
      {
        case "(admin)":
          return HIW "【 巫  师 】" NOR;
        case "(arch)":
          return HIW "【 巫  师 】" NOR;
        case "(wizard)":
          return HIW "【 巫  师 】" NOR;
        case "(apprentice)":
          return HIW "【见习巫师】" NOR;
        case "(immortal)":
          return HIW "【客座巫师】" NOR;
        case "(elder)":
          return HIW "【荣誉巫师】" NOR;
        default:
          switch(ob->query("class"))
          {
            case "xian":
              if(avg<1000000)
                return RED "【 仙  童 】" NOR;
              else if(avg<2500000)
                return RED "【 散  仙 】" NOR;
              else if(avg<8000000)
                return RED "【 大  仙 】" NOR;
              else if(avg<15000000)
                return RED "【"+at+"大仙】" NOR;
              else if(avg<30000000)
                return RED "【"+at+"大仙】" NOR;
              else
                return RED "【"+at+"天尊】" NOR;
              break;

            case "yaomo":
              if(avg<1000000)
                return RED "【 小  妖 】" NOR;
              else if(avg<2500000)
                return RED "【 妖  怪 】" NOR;
              else if(avg<8000000)
                return RED "【 妖  仙 】" NOR;
              else if(avg<15000000)
                return RED "【 "+at+"怪 】" NOR;
              else if(avg<30000000)
                return RED "【"+at+"老魔】" NOR;
              else
                return RED "【"+at+"魔王】" NOR;
              break;

            case "bonze":
              if(avg<1000000)
                return RED "【 小和尚 】" NOR;
              else if(avg<2500000)
                return RED "【 和  尚 】" NOR;
              else if(avg<8000000)
                return RED "【 圣  僧 】" NOR;
              else if(avg<15000000)
                return RED "【"+at+"尊者】" NOR;
              else if(avg<30000000)
                return RED "【"+at+"罗汉】" NOR;
              else
                return RED "【"+at+"菩萨】" NOR;
              break;

            case "taoist":
              if(avg<1000000)
                return RED "【 小道士 】" NOR;
              else if(avg<2500000)
                return RED "【 道  士 】" NOR;
              else if(avg<8000000)
                return RED "【 道  长 】" NOR;
              else if(avg<15000000)
                return RED "【"+at+"天师】" NOR;
              else if(avg<30000000)
                return RED "【"+at+"真人】" NOR;
              else
                return RED "【"+at+"天尊】" NOR;
              break;

            case "dragon":
              if(avg<1000000)
                return RED "【 虾  兵 】" NOR;
              else if(avg<2500000)
                return RED "【 蟹  将 】" NOR;
              else if(avg<8000000)
                return RED "【 巡海夜叉 】" NOR;
              else if(avg<15000000)
                return RED "【"+at+"夜叉】" NOR;
              else if(avg<30000000)
                return RED "【"+at+"真龙】" NOR;
              else
                return RED "【"+at+"龙王】" NOR;
              break;

            case "scholar":
              if( (string)at=="无名" )
              {
                if((int)ob->query_skill("literate", 1)<40)
                  return RED "【 童  生 】" NOR;
                else if((int)ob->query_skill("literate", 1)<200)
                  return RED "【 秀  才 】" NOR;
                else
                  return RED "【 大学士 】" NOR;
              }

              else
              {
                if((int)ob->query_skill("literate", 1)<40)
                  return RED "【 童  生 】" NOR;
                else if((int)ob->query_skill("literate", 1)<200)
                  return RED "【"+at+"秀才】" NOR;
                else
                  return RED "【"+at+"学士】" NOR;
              }

              break;

            case "fighter":
              if(exp<1000000)
                return RED "【 小  兵 】" NOR;
              else if(exp<2500000)
                return RED "【 小  校 】" NOR;
              else if(exp<8000000)
                return RED "【 参  将 】" NOR;
              else if(exp<15000000)
                return RED "【"+at+"将军】" NOR;
              else if(exp<30000000)
                return RED "【"+at+"大将军】" NOR;
              else
                return RED "【"+at+"大元帅】" NOR;
              break;

            case "tianpeng":
              if(avg<1000000)
                return RED "【 小  侠 】" NOR;
              else if(avg<2500000)
                return RED "【 少  侠 】" NOR;
              else if(avg<8000000)
                return RED "【 大  侠 】" NOR;
              else if(avg<15000000)
                return RED "【"+at+"奇侠】" NOR;
              else if(avg<30000000)
                return RED "【"+at+"长老】" NOR;
              else
                return RED "【"+at+"元帅】" NOR;
              break;

            case "youling":
              if(avg<1000000)
                return RED "【 阴曹小鬼 】" NOR;
              else if(avg<2500000)
                return RED "【 勾魂使者 】" NOR;
              else if(avg<8000000)
                return RED "【 幽冥判官 】" NOR;
              else if(avg<15000000)
                return RED "【"+at+"无常】" NOR;
              else if(avg<30000000)
                return RED "【"+at+"鬼王】" NOR;
              else
                return RED "【"+at+"大王】" NOR;
              break;
            default:
              if (age <= 18)
                return CYN"【 少   年 】"NOR;
              else
                return CYN"【 平   民 】"NOR;
          }

      }

  }

}

string query_respect(object ob)
{
  int age;
  string str;
  if( stringp(str = ob->query("rank_info/respect")) )
    return str;
  age = ob->query("fake_age");
  if (age == 0)
    age = ob->query("age");
  switch(ob->query("gender"))
  {
      case "女性":
        switch(ob->query("class"))
        {
          case "bonze":
	    if( age < 18 )
	      return "小师太";
	    else
	      return "师太";
	    break;
          case "taoist":
	    if( age < 18 )
	      return "小仙姑";
	    else
	      return "仙姑";
	    break;
          case "xian":
	    if( age < 18 )
	      return "小仙姑";
	    else
	      return "仙姑";
            break;
          default:
            if( age < 18 )
              return "小姑娘";
            else if( age < 50 )
              return "姑娘";
            else
              return "婆婆";
            break;
        }

      case "男性":
      default:
        switch(ob->query("class"))
        {
          case "xian":
            if( age < 18 )
              return "小神仙";
            else if( age < 50 )
              return "仙兄";
            else
              return "老神仙";
            break;
          case "bonze":
            if( age < 18 )
              return "小师父";
            else if( age < 50 )
              return "大师";
            else
              return "长老";
            break;
          case "taoist":
            if( age < 18 )
              return "小道爷";
            else if( age < 50 )
              return "道兄";
            else
              return "道长";
            break;
          case "fighter":
            if( age < 18 )
              return "小将军";
            else if( age < 50 )
              return "大将军";
            else
              return "老将军";
            break;
          case "scholar":
            if( age < 18 )
              return "小相公";
            else if( age < 50 )
              return "相公";
            else
              return "老先生";
            break;
          case "swordsman":
            if( age < 18 )
              return "小老弟";
            else if( age < 50 )
              return "壮士";
            else
              return "老前辈";
            break;
          default:
            if( age < 18 )
              return "小兄弟";
            else if( age < 50 )
              return "壮士";
            else
              return "老爷子";
            break;
        }

  }

}

