public int query_total_exp(object ob)
{
  return (int)ob->query("combat_exp")/3 + (int)ob->query("daoxing")/3*2 ;
}

public int query_level(object ob)
{
  int i, exp, *exp_list;
  int old_lvl = ob->query("level");
  exp = query_total_exp(ob);
  exp_list = keys(level);
  exp_list = sort_array(exp_list,0);
  for (i = 0; i < sizeof(exp_list); i++)
  {
   if (exp <= exp_list[i])
     break;
  }

  if ((i + 1) > old_lvl)
  {
    tell_object(ob,"你的战斗等级升级了！\n");
    ob->set("level",i+1);
    if ((i == 30) && !ob->query("gift/level/first"))
    {
      tell_object(ob,BLINK + HIR"你获得了三点可自由分配的先天天赋！\n"NOR);
      ob->set("gift/level/num",3);
      ob->set("gift/level/first",1);
      ob->save();
    }

    else if ((i == 45) && !ob->query("gift/level/two"))
    {
      tell_object(ob,BLINK + HIR"你获得了四点可自由分配的先天天赋！\n"NOR);
      ob->add("gift/level/num",4);
      ob->set("gift/level/two",1);
      ob->save();
    }

    else if ((i == 60) && !ob->query("gift/level/three"))
    {
      tell_object(ob,BLINK + HIR"你获得了五点可自由分配的先天天赋！\n"NOR);
      ob->add("gift/level/num",5);
      ob->set("gift/level/three",1);
      ob->save();
    }

  }

  return i+1;
}

public string query_upexp(object ob)
{
  return sprintf("%2d",(int)ob->query("level"));
}

public int query_next_exp(object ob)
{
  int *exp_list;
  int lvl = ob->query("level");

  exp_list = keys(level);
  exp_list = sort_array(exp_list,0);

  return exp_list[lvl] - query_total_exp(ob);
}

string query_occupation(object ob)
{
  int i, max_skill ;
  string my_skill, *ks;
  mapping valid_types = ([
   "unarmed": "拳脚",
   "sword":   "剑法",
   "blade":   "刀法",
   "stick":   "棍法",
   "staff":   "杖法",
   "throwing":"暗器",
   "force":   "内功",
   "spells":  "法术",
   "magic":   "魔法",
   "whip" :   "鞭法",
   "spear":   "枪法",
   "axe":     "斧法",
   "mace":    "锏法",
   "fork":    "叉法",
   "archery": "弓箭",
   "hammer":  "锤法",
   "literate" :  "读书识字",
   "cooking"  :  "厨艺",
   "medical"  :  "医术" ,
   "dagger"   :  "短兵刃",
  ]);

  max_skill = 0 ;
  my_skill = 0;

  ks = keys(valid_types);
  for (i = 0; i < sizeof(ks); i++)
  {
    if ((int)ob->query_skill(ks[i]) > max_skill)
    {
      max_skill = (int)ob->query_skill(ks[i]);
      my_skill = ks[i];
    }

  }

  if (!my_skill || max_skill < 100)
  {
    ob->delete("occupation");
    return HIW"没有"NOR;
  }

  switch(my_skill)
  {
    case "force" :
      ob->set("occupation","炼气士");
      return CYN"炼气士"NOR;
    case "magic" :
    case "spells":
      ob->set("occupation","术士");
      return HIG"术士"NOR;
    case "literate" :
      ob->set("occupation","学士");
      return HIY"学士"NOR;
    case "archery" :
      ob->set("occupation","游侠");
      return HIC"游侠"NOR;
    case "throwing" :
      ob->set("occupation","暗器名家");
      return HIC"暗器名家"NOR;
    case "medical" :
      ob->set("occupation","医师");
      return HIW"医师"NOR;
    case "cooking" :
      ob->set("occupation","厨师");
      return MAG"厨师"NOR;
    case "dagger" :
      ob->set("occupation","刺客");
      return HIB"刺客"NOR;
    default :
      ob->set("occupation","勇士");
      return HIR"勇士"NOR;
  }

  return HIR"勇士"NOR;
}

