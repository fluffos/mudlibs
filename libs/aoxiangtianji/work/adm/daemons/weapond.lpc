		"damage_type":	"射伤",
		"damage":		10,
		"post_action":	(: call_other, __FILE__, "throw_weapon" :),
		]),
       "arrow": ([
             "action":         	"$N将$w瞄准$n的$l射了过去",
             "damage_type":  "射伤",
		"damage":		10,
             "post_action":  (: call_other, __FILE__, "throw_weapon" :),
             ]),
]);
int query_cz(int cz)
{
  if(material[cz])
    return material[cz];
  return 5;
}

varargs mapping query_action()
{
  string verb, *verbs;
  object me;

  me=this_player();
  verbs = previous_object()->query("verbs");
  if( !pointerp(verbs) )
    return weapon_actions["hit"];
  else
  {
    verb = element_of(verbs);
    if(verb && me->query_temp("weapon"))
    {
      me->set_temp("kill_weapon",me->query_temp("weapon"));
      me->set_temp("kill_msg",verb);
    }

    if( !undefinedp(weapon_actions[verb]) )
      return weapon_actions[verb];
    else
      return weapon_actions["hit"];
  }

}

varargs mapping query_apply_action()
{
  string verb, *verbs;
  verbs = previous_object()->query("apply/verbs");
  if( !pointerp(verbs) )
    return weapon_actions["hit"];
  else
  {
    verb = element_of(verbs);
    if( !undefinedp(weapon_actions[verb]) )
      return weapon_actions[verb];
    else
      return weapon_actions["hit"];
  }

}

void throw_weapon(object me, object victim, object weapon, int damage)
{
  if( objectp(weapon) )
  {
    if( (int)weapon->query_amount()==1 )
    {
      weapon->unequip();
      tell_object(me, "\n你的" + weapon->query("name") + "用完了！\n\n");
    }

    weapon->add_amount(-1);
  }

}

void breaken_weapon(object me, object weapon)
{
  if (!objectp(me) || !objectp(weapon) || !objectp(environment(me)))
    return;

  message_vision(HIW "只听见「啪」地一声，$N" HIW "手中的"
               + weapon->name() + HIW "已经断为两截！\n" NOR,me );
  weapon->unequip();
  weapon->move(environment(me));
  weapon->set("name", "断掉的" + weapon->query("name"));
  weapon->set("value", 0);
  weapon->set("weapon_prop", 0);
  me->reset_action();
  call_out("remove_broken", random(20)+10,weapon);
}

void fly_weapon(object me, object weapon)
{
  if (!objectp(me) || !objectp(weapon) || !objectp(environment(me)))
    return;
  message_vision(HIW "$N" HIW "只觉得手中" + weapon->name() +
                 HIW "把持不定，脱手飞出！\n" NOR, me);
  weapon->unequip();
  weapon->move(environment(me));
  me->reset_action();
}

void damage_weapon(object me, object weapon, int num)
{
  if (!objectp(me) || !objectp(weapon) || !objectp(environment(me)))
    return;

  weapon->add("weapon_prop/damage",-num);
  me->add_temp("apply/damage",-num);
  if (me->query_temp("apply/damage") <= 0)
    me->set_temp("apply/damage",0);
  if((int)weapon->query("weapon_prop/damage") <= 0 )
  {
    weapon->set("weapon_prop/damage",0);
    if (!weapon->is_item_make())
      breaken_weapon(me, weapon);
    else
      fly_weapon(me,weapon);
  }

}

void wear_off(object me, object victim, object weapon, int damage)
{
  object ob;
  int wap, wdp;
  int rigid_a,rigid_v;
  ob = victim->query_temp("weapon");
  weapon = me->query_temp("weapon");

  if (!objectp(weapon) || !objectp(ob) || damage != RESULT_PARRY)
    return;
  rigid_a = (int)weapon->query("rigidity");
  if (!rigid_a)
  {
    rigid_a = query_cz(weapon->query("material"));
    if (!rigid_a)
      rigid_a = 1;
  }

  rigid_v = (int)ob->query("rigidity");
  if (!rigid_v)
  {
    rigid_v = query_cz(ob->query("material"));
    if (!rigid_v)
      rigid_v = 1;
  }

  wap = (int)weapon->weight()/500 + rigid_a + (int)me->query_str();
  wdp = (int)ob->weight() / 500 + rigid_v + (int)victim->query_str();
  if (random(wap) > wdp*2)
  {
    if (!ob->query("no_break"))
    {
        if(!ob->is_item_make())
          breaken_weapon(victim, ob);
        else
          damage_weapon(victim,ob,2);
    }

    else
      fly_weapon(victim,ob);
  }

  else if (random(wap) > wdp*5/4)
  {
    if (!ob->query("no_break"))
      damage_weapon(victim,ob,1);
    else
      fly_weapon(victim,ob);
  }

  else if( wap*100/(wap+wdp) > random(100))
  {
    message_vision(HIY "$N" HIY "的" + weapon->name() + HIY
                   "和$n" HIY "的" + ob->name() + HIY "相击"
                   "，冒出点点的火星。\n" NOR, me, victim);
    if (random(rigid_a/8*10) > random(rigid_v))
    {
      if(!ob->query("no_break") )
        damage_weapon(victim,ob,1);
    }

    else if (random(rigid_a) > random(rigid_v))
    {
      if (weapon->query("no_break"))
        damage_weapon(me,weapon,1);
    }

  }

  else if (wap/2*5 < random(wdp))
  {
    if (!weapon->query("no_break"))
    {
      if(!weapon->is_item_make())
        breaken_weapon(me, weapon);
      else
        damage_weapon(me,weapon,2);
    }

    else
      fly_weapon(me,weapon);
  }

  else if (wap*3/2 < random(wdp))
  {
    if (!weapon->query("no_break"))
      damage_weapon(me,weapon,1);
    else
      fly_weapon(me,weapon);
  }
}

void remove_broken(object ob)
{
  if(ob && environment(ob))
  {
    tell_object(environment(ob),"一阵微风吹过，"+ob->name()+"化为片片尘土，消失不见了。\n");
    destruct(ob);
  }

}