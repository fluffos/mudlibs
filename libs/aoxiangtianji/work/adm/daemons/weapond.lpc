	"crimsonsteel"  : 150,   /*丹金*/
	"blacksteel"    : 120,   /*玄铁*/
	"gem"           : 100,   /*宝石*/
	"gold"          : 90,   /*金*/
	"silver"        : 80,    /*银*/
	"steel"         : 70,    /*钢*/
	"brass"         : 60,    /*黄铜*/
	"copper"        : 50,    /*铜*/
	"iron"          : 40,    /*铁*/
	"stone"         : 30,    /*石*/
	"wood"          : 25,    /*木*/
	"bone"          : 25,    /*骨*/
	"bamboo"        : 20,    /*竹子*/
	"leather"       : 15,    /*皮革*/
	"fur"           : 15,    /*毛皮*/
	"fiber"         : 12,    /*麻*/
	"silk"          : 12,    /*丝绸*/
	"cloth"         : 10,    /*布*/
	"flower"        : 5,     /*花*/
]);
mapping weapon_actions = ([
        "hit": ([
           "damage_type":    "撞伤",
           "action":         "$N挥动$w，撞向$n的$l",
           "parry" :         20,
           "post_action":    (: call_other, __FILE__, "wear_off" :),
                ]),
	"slash": ([
           "damage_type":     "割伤",
		"action":		"$N挥动$w，斩向$n的$l",
		"parry":		20,
		"post_action":	(: call_other, __FILE__, "wear_off" :),
		]),
	"slice": ([
		"damage_type":	"劈伤",
		"action":		"$N用$w往$n的$l砍去",
		"dodge":		20,
		"post_action":	(: call_other, __FILE__, "wear_off" :),
		]),
	"chop": ([
		"damage_type":	"劈伤",
		"action":		"$N的$w朝著$n的$l劈将过去",
		"parry":		-20,
		"post_action":	(: call_other, __FILE__, "wear_off" :),
		]),
	"hack": ([
		"action":		"$N挥舞$w，对准$n的$l一阵乱砍",
		"damage_type":	"劈伤",
		"dodge":		30,
		"post_action":	(: call_other, __FILE__, "wear_off" :),
		]),
	"thrust": ([
		"damage_type":	"刺伤",
		"action":		"$N用$w往$n的$l刺去",
		"dodge":		15,
		"parry":		-15,
		"post_action":	(: call_other, __FILE__, "wear_off" :),
		]),
	"pierce": ([
		"action":		"$N的$w往$n的$l狠狠地一捅",
		"damage_type":	"刺伤",
		"dodge":		-30,
		"parry":		-30,
		"post_action":	(: call_other, __FILE__, "wear_off" :),
		]),
	"wave": ([
		"action":		"$N一扬$w，朝$n的$l一挥",
		"damage_type":	"鞭伤",
		"dodge":		-20,
		"parry":		30,
		"post_action":	(: call_other, __FILE__, "wear_off" :),
		]),
	"whip": ([
		"action":		"$N将$w一扬，往$n的$l抽去",
		"damage_type":	"鞭伤",
		"dodge":		-20,
		"parry":		30,
		"post_action":	(: call_other, __FILE__, "wear_off" :),
		]),
	"impale": ([
		"action":		"$N用$w往$n的$l直戳过去",
		"damage_type":	"刺伤",
		"dodge":		-10,
		"parry":		-10,
