        message("channel:rumor",
          WHT"ㄖ夏日雷雨ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "SummerA-Wind":
        message("channel:rumor",
          WHT"ㄖ夏日之风ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "SummerB-Wind":
        message("channel:rumor",
          WHT"ㄖ盛夏之风ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "SummerC-Wind":
        message("channel:rumor",
          WHT"ㄖ夏末季风ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "AutumnA-Sun":  // 初秋(九月)
        message("channel:rumor",
          WHT"ㄖ初秋时光ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "AutumnB-Sun":  // 中秋(十月)
        message("channel:rumor",
          WHT"ㄖ秋高气爽ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "AutumnC-Sun":  // 深秋(十一月)
        message("channel:rumor",
          WHT"ㄖ草色深秋ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "AutumnA-Rain":
      case "AutumnB-Rain":
        message("channel:rumor",
          WHT"ㄖ秋雨绵绵ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "AutumnC-Rain":
        message("channel:rumor",
          WHT"ㄖ萧瑟秋雨ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "AutumnA-Wind":
      case "AutumnB-Wind":
        message("channel:rumor",
          WHT"ㄖ秋风送爽ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "AutumnC-Wind":
        message("channel:rumor",
          WHT"ㄖ秋风瑟瑟ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "WinterA-Sun":  // 初冬(十二月)
      case "WinterC-Sun":  // 冬末(二月)
        message("channel:rumor",
          WHT"ㄖ冬日暖阳ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "WinterB-Sun":  // 隆冬(一月)
        message("channel:rumor",
          WHT"ㄖ隆冬时光ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "WinterA-Snow":
      case "WinterC-Snow":
        message("channel:rumor",
          WHT"ㄖ冬之雪雨ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "WinterB-Snow":
        message("channel:rumor",
          WHT"ㄖ瑞雪丰年ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "WinterB-Wind":
        message("channel:rumor",
          WHT"ㄖ凛冽寒风ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "WinterA-Wind":
      case "WinterC-Wind":
        message("channel:rumor",
          WHT"ㄖ冬日冷风ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "Default-Sun":
        message("channel:rumor",
          WHT"ㄖ四季变迁ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      default:
        message("channel:rumor",
          WHT"ㄖ四季变迁ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
    }

  if( !undefinedp(day_phase[current_day_phase]["event_fun"]) )
    call_other(this_object(), day_phase[current_day_phase]["event_fun"]);
}

/**************************************************************************************************/
// 每天的清晨,黎明.
// 事件：横财的收放，收回尚存在的纳凉人
// 秋霜及晨曦雨的分布
int place_ok(string filename)
{
  object p;

  if (!filename)
    return 0;

  if (strlen(filename) < 2)
    return 0;
  if( filename[<2..] != ".lpc")
    return 0;

  p = find_object(filename);
  if (!objectp(p))
    p = load_object(filename);
  if (!objectp(p))
  {
    log_file("nature_err",sprintf("%s don't find!\n",filename));
    return 0;
  }

  return 1;
}

/*
  num = 0 : 凌晨
  num = 1 : 早晨
  num = 2 : 上午
  num = 3 : 正午
  num = 4 : 下午
  num = 5 : 傍晚
  num = 6 : 晚上
  num = 7 : 深夜
*/
void place_earth_gift(int num)
{
  object ob;
  string dir, filename, msg, csf, season,weather;
  int m;

  csf = check_seasonF();
  if(sscanf(csf, "%s-%s", season, weather)!=2 )
    return;
  if (random(2))
    return;

  if( season == "SpringA" ||
      season == "SpringB")
  {
    if (num > 3)  //凌晨，早上，上午
      return;
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    ob = new(NATURE_OBJ"spring-earth");
    if (objectp(ob) && ob->move(filename))
    {
      CHANNEL_D->do_channel( this_object(), "sys",
         sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"), filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]泥带鲜香，吐露春的生机！！！\n" NOR;
      message("system", WHT"〖春之鲜泥〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"spring-earth") );
  }

  if((season == "WinterA" ||
     season == "WinterB") &&
     (weather == "Snow" ||
      weather == "Sun" ||
      weather == "Wind"))
  {
    if (num > 2 && num < 6)
      return;
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    ob = new(NATURE_OBJ"winter-earth");
    if (objectp(ob) && ob->move(filename))
    {
      CHANNEL_D->do_channel( this_object(), "sys",
         sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"), filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]非常寒冷，泥土冻结，似乎也冻结了希望！！！\n" NOR;
      message("system", WHT"〖冬之冻土〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"winter-earth") );
  }

  if( weather == "Wind")
  {
    if (num > 1 && num < 6)
      return;
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    if (random(2))
      ob = new(NATURE_OBJ"branch");
    else
      ob = new(NATURE_OBJ"windleaf");
    if (objectp(ob) && ob->move(filename) )
    {
      CHANNEL_D->do_channel( this_object(), "sys",
            sprintf("%s "HIG"落于 [%s]"NOR,
            ob->query("name"), filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]遭飓风袭击，枯枝落叶遍地！！！\n" NOR;
      message("system", WHT"〖秋季飓风〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s or %s\n",
         NATURE_OBJ"branch",NATURE_OBJ"windleaf"));
  }

}

void place_wind_gift(int num)
{
  object ob;
  string dir, filename, msg, csf, season,weather;
  int m;

  csf = check_seasonF();

  if(sscanf(csf, "%s-%s", season, weather)!=2 )
    return;
  if (weather != "Wind")
    return;
  if (random(2))
    return;
//春之暖风
  if (season == "SpringA" ||
      season == "SpringB" ||
      season == "SpringC")
  {
    if (num < 2 || num > 5)
      return;
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    ob = new(NATURE_OBJ"spring-wind");
    if (objectp(ob) && ob->move(filename))
    {
      CHANNEL_D->do_channel( this_object(),
         "sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"),filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]春风潜入，带来的春的信息！！！\n" NOR;
      message("system", WHT"〖春之暖风〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"spring-wind"));
  }

//夏之炎风
  if (season == "SummerA" ||
      season == "SummerB" ||
      season == "SummerC") //盛夏
  {
    if (num < 2 || num > 5)
      return;
    m = random( sizeof(path) );
    dir = path[m];
