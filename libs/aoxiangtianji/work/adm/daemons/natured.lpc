           "sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"), filename ) );
        msg = "听说["+ nameW[m] +NOR WHT "]普降瑞雪！！！\n" NOR;
        message("system", WHT"〖瑞雪丰年〗 "+ msg + NOR, users() );
      }

      else if (objectp(ob))
        destruct(ob);
      else
        log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"winter-snow"));
    }

  }

  reset_eval_cost();
}

/**************************************************************************************************/
// 每天的傍晚.
// 事件：帮会地盘灾害及收入
void event_evening()
{
  int i;
  object *users;
// 在Login及客栈NPC身上取消财神，减少call_out
// 在这里做简单的控制也未尝不可
  users=users();
  if(arrayp(users))
  {
    for(i=0;i<sizeof(users);i++)
    {
      if((int)users[i]->query("balance")>100000000)
      {
         if( !wizardp(users[i]) )
         {// 排除WIZ是必须的，省得那么麻烦
           users[i]->set("balance",100000000);
           tell_object(users[i],HIR"你在钱庄的钱已达到一万两黄金，快点花吧！\n"NOR);
         }

      }

    }

  }

  nature_gift(5);
}

/**************************************************************************************************/
// 每天的夜晚.
// 事件：天降奇缘，连绵夜雨的分布
//      事件NPC分布
void event_night()
{
  string msg;
  if( random( 8 ) == 0)
  {
    if( check_season()== "Summer-Rain"
     || check_season()== "Spring-Rain"
     || check_season()== "Autumn-Rain" )   // 雨季的连绵夜雨
    {
      new(NATURE_OBJ"night-rain")->move(element_of(random_p));
      new(NATURE_OBJ"night-rain")->move(element_of(random_p));
      new(NATURE_OBJ"night-rain")->move(element_of(random_p));
      new(NATURE_OBJ"night-rain")->move(element_of(random_p));
      new(NATURE_OBJ"night-rain")->move(element_of(random_p));
      msg = "听说大唐长安城连绵夜雨不断！！！\n" NOR;
      message("system", WHT"〖风霜雨雪〗 "+ msg + NOR, users() );
    }

  }

  if( random( 8 ) == 0)
  {
    if( check_season()== "Summer-Sun"
     || check_season()== "Spring-Sun"
     || check_season()== "Autumn-Sun"
     || check_season()== "Winter-Sun" ) //月华的出现
    {
      new(NATURE_OBJ"moon")->move(element_of(random_p));
      new(NATURE_OBJ"moon")->move(element_of(random_p));
      new(NATURE_OBJ"moon")->move(element_of(random_p));
      new(NATURE_OBJ"moon")->move(element_of(random_p));
      new(NATURE_OBJ"moon")->move(element_of(random_p));
      msg = HIY"月上了柳稍头，人约黄昏后！听说今夜长安城月光似水，惹人留恋！！\n" NOR;
      message("system", WHT"〖风霜雨雪〗 "+ msg + NOR, users() );
    }

  }

  if( random( 4 ) == 0)
  {
    if( check_seasonF() == "SummerB-Sun" )   // 只在盛夏夜晚出现的纳凉人
    {
      new(NATURE_NPC"summerman")->move(element_of(random_p));
      new(NATURE_NPC"summerman")->move(element_of(random_p));
      new(NATURE_NPC"summerman")->move(element_of(random_p));
      new(NATURE_NPC"summerman")->move(element_of(random_p));
      msg = CYN"长安街头，出现了纳凉人！习习夜风中，一把蒲扇，闲话古今！！\n"NOR;
      message("system", WHT"〖炎炎夏夜〗 "+ msg + NOR, users() );
    }

  }

  nature_gift(6);
}

// 每天的深夜.
// 事件：事件NPC的出现，
//       连绵夜雨的分布
//       雨季的闪电及季节的更新
void event_midnight()
{
  string get_month, get_day, msg;
  get_month = CHINESE_D->chinese_number(query_month());
  get_day = CHINESE_D->chinese_number(query_days());
  festival = "";
  reset_eval_cost();
  switch(get_month)
  {
    case "三":           // 初春(springA-？)
      if(get_day=="十九")  // 农历的谷雨
      {
        msg = HIG "农历的谷雨时节到了，经过了漫长的冬季，万物开始复苏。春天的喜雨开始滋润大地！\n" NOR;
        message("system", HIY"〖"HIR"四季交替"HIY"〗"+ msg + NOR, users() );
        day_phase = read_table(N_S"springA_rain");
        festival = "谷雨";
        break;
      }

      else
        switch(random(3))
        {
          case 0:
            day_phase = read_table(N_S"springA_rain");
            message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
            call_out ("kill_badman", 3);
            break;
          case 1:
            day_phase = read_table(N_S"springA_sun");
            break;
          case 2:
            day_phase = read_table(N_S"springA_wind");
            break;
        }

      break;
    case "四":    // 春季(spring-？)
      if(get_day=="十九")   // 农历的立夏
      {
         msg = HIG "农历的立夏时节到了，虽然夏天还远，但天气慢慢的变的热了起来！\n" NOR;
         message("system", HIY"〖"HIR"四季交替"HIY"〗"+ msg + NOR, users() );
         day_phase = read_table(N_S"spring_wind");
         festival = "立夏";
         break;
      }

      else
        switch(random(3))
        {
          case 0:
            day_phase = read_table(N_S"spring_rain");  // Added by waiwai@2003/01/16 雨季的闪电
            message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
            call_out ("kill_badman", 3);
            break;
          case 1:
            day_phase = read_table(N_S"spring_sun");
            break;
          case 2:
            day_phase = read_table(N_S"spring_wind");
            break;
        }

      break;
    case "五":    // 春末(springC-？)
      if(get_day=="五")   // 农历的端午
      {
         msg = HIR"西游记的端午节到了，唐皇御赐各家百姓金字端午粽子！！！\n" NOR;
         message("system", HIR"〖"HIY"端午佳节"HIR"〗"+ msg + NOR, users() );
         day_phase = read_table(N_S"springC_sun");
         festival = "端午";
         break;
      }

      else
        switch(random(3))
        {
          case 0:
            day_phase = read_table(N_S"springC_rain");  // Added by waiwai@2003/01/16 雨季的闪电
            message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
            call_out ("kill_badman", 3);
            break;
          case 1:
            day_phase = read_table(N_S"springC_sun");
            break;
          case 2:
            day_phase = read_table(N_S"springC_wind");
            break;
        }

      break;
    case "六":   // 初夏(summerA-？)
      if(get_day=="二十二")   // 农历的夏至(应该是5/23这里做阳历算吧)
      {
        msg = HIR "夏天来临了，天气越来越热，所有的生物都异常活跃。西游记也呈现出一片繁荣的景象！\n" NOR;
        message("system", HIY"〖"HIR"四季交替"HIY"〗"+ msg + NOR, users() );
        day_phase = read_table(N_S"summerA_wind");
        festival = "夏至";
        break;
      }

      else
        switch(random(3))
        {
          case 0:
            day_phase = read_table(N_S"summerA_rain");  // Added by waiwai@2003/01/16 雨季的闪电
            message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
            call_out ("kill_badman", 3);
            break;
          case 1:
            day_phase = read_table(N_S"summerA_sun");
            break;
          case 2:
            day_phase = read_table(N_S"summerA_wind");
            break;
        }

      break;
    case "七":    // 盛夏(summer-？)
      if(get_day=="七")
      {
        msg = HIR"今天是西游记牛郎织女每年相会的日子。凄美的故事总是让人难以忘怀！！！\n" NOR;
        message("system", HIR"〖"HIY"牛郎织女"HIR"〗"+ msg + NOR, users() );
        day_phase = read_table(N_S"summer_sun");
        festival = "七夕";
        break;
      }

      else
        switch(random(3))
        {
          case 0:
            day_phase = read_table(N_S"summer_rain"); // Added by waiwai@2003/01/16 雨季的闪电
            message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
            call_out ("kill_badman", 3);
            break;
          case 1:
            day_phase = read_table(N_S"summer_sun");
            break;
          case 2:
            day_phase = read_table(N_S"summer_wind");
            break;
        }

      break;
    case "八":    // 夏末(summerC-？)
      if(get_day=="十五")   // 农历的仲秋
      {
         msg = HIR"西游记的又一个仲秋佳节来临了，在那月色美丽的夜晚，你是否也同样怀有一颗驿动的心？\n" NOR;
         message("system", HIR"〖"HIY"仲秋佳节"HIR"〗"+ msg + NOR, users() );
         message("system", HIY"〖丹桂飘香〗农家小院的丹桂树的桂花随风飘落，清香随风飘散弥漫了整个长安城。。。\n" NOR,
                  users() );
         day_phase = read_table(N_S"summerC_wind");
         festival = "仲秋";
         break;
      }

      else
        switch(random(3))
        {
           case 0:
             day_phase = read_table(N_S"summerC_rain");  // Added by waiwai@2003/01/16 雨季的闪电
             message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
             call_out ("kill_badman", 3);
             break;
           case 1:
             day_phase = read_table(N_S"summerC_sun");
             break;
           case 2:
             day_phase = read_table(N_S"summerC_wind");
             break;
        }

      break;
    case "九":     // 初秋(autumnA-？)
      if(get_day=="九")   // 农历的重阳
      {
        msg = HIR"西游记的重阳节到了，这是一个缅怀思念兄弟的日子！！！\n" NOR;
        message("system", HIR"〖"HIY"重阳佳节"HIR"〗"+ msg + NOR, users() );
        day_phase = read_table(N_S"autumnA_wind");
        festival = "重阳";
        break;
      }

      else
        switch(random(3))
        {
          case 0:
            day_phase = read_table(N_S"autumnA_rain");  // Added by waiwai@2003/01/16 雨季的闪电
            message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
            call_out ("kill_badman", 3);
            break;
          case 1:
            day_phase = read_table(N_S"autumnA_sun");
            break;
          case 2:
            day_phase = read_table(N_S"autumnA_wind");
            break;
        }

      break;
    case "十":    // 秋季(autumn-？)
      switch(random(3))
      {
         case 0:
           day_phase = read_table(N_S"autumn_rain");  // Added by waiwai@2003/01/16 雨季的闪电
           message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
           call_out ("kill_badman", 3);
           break;
         case 1:
           day_phase = read_table(N_S"autumn_sun");
           break;
         case 2:
           day_phase = read_table(N_S"autumn_wind");
           break;
      }

      break;
    case "十一":    // 深秋(autumnC-？)
      if(get_day=="二十九")   // 农历的冬至
      {
        msg = HIW "冬至到了，秋天即将远去，又一个寒冷的冬天来临了！\n" NOR;
        message("system", HIY"〖"HIR"四季交替"HIY"〗"+ msg + NOR, users() );
        day_phase = read_table(N_S"autumnC_rain");
        festival = "冬至";
        break;
      }

      else
        switch(random(3))
        {
          case 0:
            day_phase = read_table(N_S"autumnC_rain");  // Added by waiwai@2003/01/16 雨季的闪电
            message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
            call_out ("kill_badman", 3);
            break;
          case 1:
            day_phase = read_table(N_S"autumnC_sun");
            break;
          case 2:
            day_phase = read_table(N_S"autumnC_wind");
            break;
        }

      break;
    case "零":     // 初冬(winterA-？)
    case "十二":
      if(get_day=="二十二")
      {
         msg = HIW "来自北方的寒流扫过大地，万物又开始了寂静的休眠。而西游记世界的冬天却是温情的！\n" NOR;
         message("system", HIY"〖"HIR"四季交替"HIY"〗"+ msg + NOR, users() );
         day_phase = read_table(N_S"winterA_sun");
         festival = "初冬";
         break;
      }

      else
        switch(random(3))
        {
          case 0:
            day_phase = read_table(N_S"winterA_snow");
            break;
          case 1:
            day_phase = read_table(N_S"winterA_sun");
            break;
          case 2:
            day_phase = read_table(N_S"winterA_wind");
            break;
        }

      break;
    case "一":  // 隆冬(winter-？)
      if(get_day=="一")   // 春节
      {
        msg = HIR"西游记的元旦佳节来临了。快到年关了，春天也不远了！！！\n" NOR;
        message("system", HIR"〖"HIY"元旦佳节"HIR"〗"+ msg + NOR, users() );
        msg = BLINK + HIY"到了领取俸禄的日子了！各位大人请到皇宫领取俸禄！\n"NOR;
        message("system", HIY"〖"HIY"新年通告"HIR"〗"+ msg + NOR, users() );
        day_phase = read_table(N_S"spring");
        festival = "春节";
        break;
      }

      else
        switch(random(3))
        {
          case 0:
            day_phase = read_table(N_S"winter_snow");
            break;
          case 1:
            day_phase = read_table(N_S"winter_sun");
            break;
          case 2:
            day_phase = read_table(N_S"winter_wind");
            break;
        }

      break;
    case "二":    // 冬末(winterC-？)
      if(get_day=="二")   // 农历的龙抬头
      {
        msg = HIR"西游记的龙头节日来临了，这是一个展望未来，寓意吉祥的日子！！！\n" NOR;
        message("system", HIR"〖"HIY"龙头佳节"HIR"〗"+ msg + NOR, users() );
        day_phase = read_table(N_S"winterC_sun");
        festival = "龙头";
        break;
      }

      else
        switch(random(3))
        {
          case 0:
            day_phase = read_table(N_S"winterC_snow");
            break;
          case 1:
            day_phase = read_table(N_S"winterC_sun");
            break;
          case 2:
            day_phase = read_table(N_S"winterC_wind");
            break;
        }

      break;

    default:
      day_phase = read_table(N_S"day_phase");
  }

  if( random( 8 ) == 0 )
  {
    if( check_season()== "Summer-Rain"
     || check_season()== "Spring-Rain"
     || check_season()== "Autumn-Rain" )   // 雨季的连绵夜雨
    {
       new(NATURE_OBJ"night-rain")->move(element_of(random_p));
       new(NATURE_OBJ"night-rain")->move(element_of(random_p));
       new(NATURE_OBJ"night-rain")->move(element_of(random_p));
       msg = "听说大唐长安城连绵夜雨不断！！！\n" NOR;
       message("system", WHT"〖风霜雨雪〗 "+ msg + NOR, users() );
    }

  }

  if( random( 4 ) == 0 )
  {
    if( check_season()== "Summer-Sun"
     || check_season()== "Spring-Sun"
     || check_season()== "Autumn-Sun"
     || check_season()== "Winter-Sun" )
    {
       new(NATURE_OBJ"moon")->move(element_of(random_p));
       new(NATURE_OBJ"moon")->move(element_of(random_p));
       new(NATURE_OBJ"moon")->move(element_of(random_p));
       msg = "听说大唐长安城月色如水！！！\n" NOR;
       message("system", WHT"〖风霜雨雪〗 "+ msg + NOR, users() );
    }

  }

  nature_gift(7);
}

/**************************************************************************************************/
// Added by waiwai@2003/01/06
// 雨天闪电的结果
void kill_badman()
{
  object bad, *ob;
  int i, b, m, l, r, kee, sen;
  object obj;
  string dir, filename;
  int M;
  m = 0;
// 打雷出现的机率
  r = random(3);
  ob = users();
  if (r == 0)
  {
    for(i=0; i<sizeof(ob); i++)
    {
      if( !environment(ob[i]) )
        continue;
      if( !environment(ob[i])->query("outdoors") )
        continue; // 去除室内
      if( userp(ob[i]) && wizardp(ob[i]) )
        continue;
      b = ob[i]->query("bellicosity");
      if (b > m)
      {
        m = b;
        bad = ob[i];
      }

    }

    if (m != 0 && bad)
    {
// 避雷效果，配合雨伞避雷做用
// 从 0% - 100 %
       m = bad->query_temp("thunder");
       r = bad->query("kee");
       if (m < 0)
         m = 0;
       if (m > 100)
         m = 100;
       if( b > 500 && random(3)==0 )
       {
         if( !bad->is_fighting() && !bad->is_killing() )
         {
            message("system", "\n\t\t霹雳的一声，跟着传来一道惊人的呼救声，看来是有人被雷击中了……\n\n", users());
            tell_object (bad,HIR"一道闪电从不远的天上直直的命中你，你身上到处都是闪电过后留下的焦痕。\n"NOR);
            log_file( "thunder", sprintf(HIR "[%s]: 闪电击中 %s\n" NOR, log_time(), log_id(bad)  ));
            CHANNEL_D->do_channel( this_object(),
                "sys", sprintf(HIG"闪电击中 %s"NOR, log_id(bad)) );
            bad->set("bellicosity", bad->query("bellicosity")*5/10);
            kee = bad->query("max_kee") * (100-m)/200;
            bad->receive_damage("kee", kee);
            sen = bad->query("max_kee") * (100-m)/100;
            bad->receive_damage("sen", sen);
         }

       }

    }

  }

  if( random( 2 ) == 0 )
  {
    M = random( sizeof(path) );
    dir = path[M];

    filename = MISC_D->random_place(dir);
    if (filename == "")
      return;

    l = strlen(filename);
    if( filename[<2..] == ".lpc"  )
    {// 闪电过后分布的被雷击的NPC
       obj = new(NATURE_NPC"thunder");
       if (objectp(obj) && obj -> move(filename))
       {
         CHANNEL_D->do_channel( this_object(),
               "sys", sprintf("%s "HIG"目前在 [%s]"NOR, obj->query("name"), filename ) );
         message("system", WHT"〖"HIR"小道消息"NOR WHT"〗听说：在["
               + name[M] +NOR WHT"]有一路人不幸被闪电击中！ \n" NOR, users() );
       }

       else if (objectp(obj))
       {
         log_file("move_err", sprintf("Failure : %s move to %s",
                 obj->name(),filename) );
         destruct(obj);
       }

       else
         log_file("file_err", sprintf("File not found : %s",NATURE_NPC"thunder"));
    }

  }

  else
    message("system", "\n\t\t\t\t轰隆隆的雷声似乎渐渐远去……\n\n", users());
  remove_call_out ("kill_badman");
}

