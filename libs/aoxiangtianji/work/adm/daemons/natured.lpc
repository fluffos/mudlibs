int query_current_day_phase()
{
// current_day_phase :
// 0 : 凌晨
// 1 : 清晨
// 2 : 上午
// 3 : 正午
// 4 : 下午
// 5 : 傍晚
// 6 : 夜晚
// 7 : 深夜
  return current_day_phase;
}

int query_year()
{
  return year;
}

int query_month()
{
  return current_month;
}

int query_days()
{
  return current_days;
}

int query_current_time()
{
  int i, total_long;

  total_long = 0;
  for (i=0;i<=current_day_phase;i++)
    total_long += day_phase[i]["length"];

  return total_long - find_call_out("update_day_phase");
}

mapping *read_table(string file);
void init_day_phase();
#include <nature.h>
mixed query(string arg)
{
  if( arg && arg == "channel_id" )
    return  WHT"季节精灵";
  return 0;
}

mixed *query_localtime(int t)
{
  mixed *lt;
  t = GAME_TIME(t);
  if (t < 1)
    t = 1;
  lt = localtime((t % 86400) * 365);
  lt[LT_MON] = t % 12;
  lt[LT_YEAR] = t/86400;
  return lt;
}

protected void read_day_phase_file()
{
  string get_month = CHINESE_D->chinese_number(current_month);
  string get_day = CHINESE_D->chinese_number(current_days);

  switch(get_month)
  {
// Spring season(初春)
    case "三":
      switch(random(3))
      {
        case 0:
          day_phase = read_table(N_S"springA_rain");
          break;
        case 1:
          day_phase = read_table(N_S"springA_sun");
          break;
        case 2:
          day_phase = read_table(N_S"springA_wind");
          break;
      }

      break;
// Spring season(春季)
    case "四":
      switch(random(3))
      {
        case 0:
          day_phase = read_table(N_S"spring_rain");
            break;
        case 1:
          day_phase = read_table(N_S"spring_sun");
          break;
        case 2:
          day_phase = read_table(N_S"spring_wind");
          break;
      }

      break;
// Spring season(春末)
    case "五":
      switch(random(3))
      {
          case 0:
            day_phase = read_table(N_S"springC_rain");
            break;
          case 1:
            day_phase = read_table(N_S"springC_sun");
            break;
          case 2:
            day_phase = read_table(N_S"springC_wind");
            break;
      }

      break;
// Summer season(初夏)
    case "六":
      switch(random(3))
      {
          case 0:
            day_phase = read_table(N_S"summerA_rain");
            break;
          case 1:
            day_phase = read_table(N_S"summerA_sun");
            break;
          case 2:
            day_phase = read_table(N_S"summerA_wind");
            break;
      }

      break;
// Summer season(盛夏)
    case "七":
      switch(random(3))
      {
          case 0:
            day_phase = read_table(N_S"summer_rain");
            break;
          case 1:
            day_phase = read_table(N_S"summer_sun");
            break;
          case 2:
            day_phase = read_table(N_S"summer_wind");
            break;
      }

      break;
// Summer season(夏末)
    case "八":
      switch(random(3))
      {
          case 0:
            day_phase = read_table(N_S"summerC_rain");
            break;
          case 1:
            day_phase = read_table(N_S"summerC_sun");
            break;
          case 2:
            day_phase = read_table(N_S"summerC_wind");
            break;
      }

      break;
// Autumn season(初秋)
    case "九":
      switch(random(3))
      {
          case 0:
            day_phase = read_table(N_S"autumnA_rain");
            break;
          case 1:
            day_phase = read_table(N_S"autumnA_sun");
            break;
          case 2:
            day_phase = read_table(N_S"autumnA_wind");
            break;
      }

      break;
// Autumn season(秋季)
    case "十":
      switch(random(3))
      {
          case 0:
            day_phase = read_table(N_S"autumn_rain");
            break;
          case 1:
            day_phase = read_table(N_S"autumn_sun");
            break;
          case 2:
            day_phase = read_table(N_S"autumn_wind");
            break;
      }

      break;
// Autumn season(深秋)
    case "十一":
      switch(random(3))
      {
          case 0:
            day_phase = read_table(N_S"autumnC_rain");
            break;
          case 1:
            day_phase = read_table(N_S"autumnC_sun");
            break;
          case 2:
            day_phase = read_table(N_S"autumnC_wind");
            break;
      }

      break;
// Winter season(初冬)
    case "零":
    case "十二":
      switch(random(3))
      {
          case 0:
            day_phase = read_table(N_S"winterA_snow");
            break;
          case 1:
            day_phase = read_table(N_S"winterA_sun");
            break;
          case 2:
            day_phase = read_table(N_S"winterA_wind");
            break;
      }

      break;
// Winter season(隆冬)
    case "一":
      if(get_day=="一")
      {
        day_phase = read_table(N_S"spring");
        break;
      }

      else switch(random(3))
      {
          case 0:
            day_phase = read_table(N_S"winter_snow");
            break;
          case 1:
            day_phase = read_table(N_S"winter_sun");
            break;
          case 2:
            day_phase = read_table(N_S"winter_wind");
            break;
      }

      break;
// Winter season(冬末)
    case "二":
      switch(random(3))
      {
          case 0:
            day_phase = read_table(N_S"winterC_snow");
            break;
          case 1:
            day_phase = read_table(N_S"winterC_sun");
            break;
          case 2:
            day_phase = read_table(N_S"winterC_wind");
            break;
      }

      break;
    default:
      day_phase = read_table(N_S"day_phase");
  }

}

void create()
{
  mixed *local;
  string *file_line;
  int last_month = 0;
  int last_day = 0;
  int i;

  local = localtime(MUD_TIME_TICK);
  if( file_size(DAY_FILE) != -1 )
  {
    file_line = explode(read_file(DAY_FILE), "\n");
      for(i=0; i<sizeof(file_line); i++)
      {
        if( file_line[i]=="" || file_line[i][0]=='#' )
          continue;
        if( sscanf(file_line[i],"year %d:month %d:day %d",year,last_month,last_day) == 3)
           break;
      }

  }

  if(!last_month)
    current_month = local[4];
  else
    current_month = last_month;

  if(!last_day)
    current_days = local[3];
  else
    current_days = last_day;
  read_day_phase_file();
  init_day_phase();
}

/**************************************************************************************************/
// 时间校正
void init_day_phase()
{
  mixed *local;
  string *file_line;
  int i, t;
  int last_month = 0;
  int last_day = 0;
  local = localtime(MUD_TIME_TICK);
  t = MUD_TIME_TICK%1440;
  for( i=0; i < sizeof(day_phase); i++)
    if( t >= day_phase[i]["length"] )
      t -= (int)day_phase[i]["length"];
    else
      break;
  current_day_phase = (i==0 ? sizeof(day_phase)-1 : i - 1);

  if( file_size(DAY_FILE) != -1 )
  {
    file_line = explode(read_file(DAY_FILE), "\n");
      for(i=0; i<sizeof(file_line); i++)
      {
        if( file_line[i]=="" || file_line[i][0]=='#' )
          continue;
        if( sscanf(file_line[i],"year %d:month %d:day %d",year,last_month,last_day) == 3)
           break;
      }

  }

  if(!last_month)
    current_month = local[4];
  else
    current_month = last_month;
  if (current_month == 0)
    current_month = 12;

  if(!last_day)
    current_days = local[3];
  else
    current_days = last_day;
/*
  current_month = local[4];
*/
  remove_call_out("init_day_phase");
  call_out("init_day_phase", 3600);
  remove_call_out("update_day_phase");
  call_out("update_day_phase",(int)day_phase[(current_day_phase+1) % sizeof(day_phase)]["length"] - t);
}

// 天气(season)[模糊方式]
string check_season()
{
  return day_phase[current_day_phase]["season_msg"];
}

// 天气(seasonF)[精确方式] 用于模糊方式之外更加准确的调用之处
string check_seasonF()
{
  return day_phase[current_day_phase]["seasonF_msg"];
}

string outdoor_room_event()
{
  return day_phase[current_day_phase]["event_fun"];
}

// 游戏中的时辰
string game_time()
{
  mixed *local = localtime(MUD_TIME_TICK);
  string *sym_tian = ({ "甲","乙","丙","丁","戊","己","庚","辛","壬","癸" });
  string *sym_di = ({ "子","丑","寅","卯","辰","巳","午","未","申","酉","戌","亥" });
  return sprintf("西游记%s%s年%s月%s日%s时%s刻",
      sym_tian[query_year() % 10], sym_di[query_year() % 12],
      chinese_number(query_month())=="零"?"十二":chinese_number(query_month()),
      chinese_number(query_days() + (local[LT_HOUR] > 23 ? 1 : 0)),
      sym_di[((local[LT_HOUR] + 1) % 24) / 2],
      chinese_number((local[LT_MIN]+1) % 2 * 2 +
      local[LT_MIN] / 30 + 1) );
}

string day_or_night()
{
  switch( current_day_phase )
  {
    case 0:
      return "night "+find_call_out("update_day_phase");
      break;
    case 1:
      return "day "+(find_call_out("update_day_phase")+720);
      break;
    case 2:
      return "day "+(find_call_out("update_day_phase")+540);
      break;
    case 3:
      return "day "+(find_call_out("update_day_phase")+360);
      break;
    case 4:
      return "day "+(find_call_out("update_day_phase")+180);
      break;
    case 5:
      return "day "+find_call_out("update_day_phase");
      break;
    case 6:
      return "night "+(find_call_out("update_day_phase")+480);
      break;
    case 7:
      return "night "+(find_call_out("update_day_phase")+240);
      break;
  }

  return 0;
}

int is_day()
{
  string day_night;
  int time;
  sscanf( day_or_night(),"%s %d",day_night,time);
  return (day_night == "day");
}

int is_light(object env)
{
  object *inv;
  object ob, fire;

  if (is_day())
    return 1;
  if (!objectp(env))
    return 0;
  inv = all_inventory(env);
  if (sizeof(inv) < 1)
    return 0;
  foreach(ob in inv)
  {
    if (ob->query_lighting())
      return 1;
    if (ob->is_character())
    {
      fire = ob->query_temp("handing");
      if (objectp(fire) && fire->query_lighting())
        return 1;
    }

  }

  return 0;
}

protected void update_day_phase()
{
  int tmpmonth;
  remove_call_out("update_day_phase");
  current_day_phase = (++current_day_phase) % sizeof(day_phase);
  call_out("update_day_phase", day_phase[current_day_phase]["length"]);

  reset_eval_cost();

  tmpmonth = current_month;
  if(current_day_phase==0)
  {
    current_days += 1;
    if (tmpmonth == 1 ||
        tmpmonth == 3 ||
        tmpmonth == 5 ||
        tmpmonth == 7 ||
        tmpmonth == 8 ||
        tmpmonth == 10 ||
        tmpmonth == 12 ||
        tmpmonth == 0)
    {
      if (current_days > 31)
      {
        current_days = 1;
        current_month += 1;
      }

    }

    else if (tmpmonth == 2)
    {
      if (current_days > 28)
      {
        current_days = 1;
        current_month += 1;
      }

    }

    else
    {
      if (current_days > 30)
      {
        current_days = 1;
        current_month += 1;
      }

    }

    if (current_month > 12)
    {
      year += 1;
      current_month = 1;
    }

    write_file(DAY_FILE,sprintf("year %d:month %d:day %d\n",year,current_month,current_days),1);
  }

  read_day_phase_file();
  if( outdoor_room_event()== "event_midnight" || outdoor_room_event()== "event_night" )
  {
    switch (day_phase[current_day_phase]["seasonF_msg"])
    {
      case "SpringA-Sun": // 初春(三月)
        message("channel:rumor",
          WHT"ㄖ早春夜色ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "SpringB-Sun":  // 春季(四月)
      case "SpringC-Sun":  // 春末(五月)
        message("channel:rumor",
          WHT"ㄖ春日晴夜ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "SpringA-Rain":
      case "SpringB-Rain":
      case "SpringC-Rain":
        message("channel:rumor",
          WHT"ㄖ春雨夜色ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "SpringA-Wind":
      case "SpringB-Wind":
      case "SpringC-Wind":
        message("channel:rumor",
          WHT"ㄖ春风夜色ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "SummerA-Sun":   // 初夏(六月)
        message("channel:rumor",
          WHT"ㄖ初夏夜色ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "SummerB-Sun":  // 盛夏(七月)
        message("channel:rumor",
          WHT"ㄖ盛夏之夜ㄖ"+filter_color(day_phase[current_day_phase]["time_msg"])+"\n"NOR, users());
        break;
      case "SummerC-Sun":  // 夏末(八月)
