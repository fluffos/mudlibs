/**************************************************************************************************/
// 每天的正午.
// 事件：生病的产生，风霜雨雪的分布
void event_noon()
{
  object *ob;
  int i, skill, magic_skill,con, con1, con2, con3;
  string get_month, ill;
  object obj;
  string dir, filename, msg;
  int m;

  get_month = CHINESE_D->chinese_number(query_month());
  switch(get_month)
  {
     case "三":
     case "四":
     case "五":
       ill = "ill_kesou";
       msg = HIG"忽然喉头一阵痕痒，你感觉似乎要咳嗽了。\n"NOR;
       break;
     case "六":
     case "七":
     case "八":
       ill = "ill_zhongshu";
       msg = HIG"突然你胸臆之间一阵翻腾，你中暑了。\n"NOR;
       break;
     case "九":
     case "十":
     case "十一":
       ill = "ill_shanghan";
       msg = HIG"陡的你打了个冷战，头昏沉沉的，你得伤寒病了。\n"NOR;
       break;
     case "十二":
     case "零":
     case "一":
     case "二":
       ill = "ill_dongshang";
       msg = HIG"你肢体末端一阵僵直，看来你被冻伤了。\n"NOR;
       break;
  }

  if(random(5))
  {
    ill = "ill_fashao";
    msg = HIG"你偶感风寒，竟而发起烧来。\n"NOR;
  }

  ob = filter_array(users(),(:
                          userp($1) && !wizardp($1) && objectp(environment($1))
                       && environment($1)->query("outdoors")
                       && $1->query("age") > 18
                       && $1->query("mana") > 0
                            :));

  for(i=0; i<sizeof(ob); i++)
  {
    skill = ob[i]->query_skill("spells", 1);
    magic_skill = ob[i]->query_skill("magic", 1);
    if( (skill == 0) && (magic_skill == 0) )
    {
      tell_object(ob[i], WHT"你觉得一阵晕眩，好像有一股能量从身上被人吸走了。\n"NOR);
      ob[i]->set("mana", 0);
      ob[i]->receive_damage("sen", 0);
    }

    else if( (skill < 25) && (magic_skill < 25) )
    {
      tell_object(ob[i], WHT"随着太阳升到天空的正中央，你觉得你的法力开始消失了。\n"NOR);
      ob[i]->set("mana", (int)ob[i]->query("mana") * skill / 25 );
    }

    con1 = ob[i]->query("kee");
    con2 = ob[i]->query("max_kee");
    (int)con = con1/con2*50; // 形成第一个生病判断条件
    con3 = ob[i]->query("force");
    con2 = ob[i]->query("max_force");
    if( con2 == 0)
      con2 = 1;
    (int)con1 = con3/con2*50; // 形成第二个生病判断条件

    if(random(con)+random(5)+random(con1)<25)
    {
      ob[i]->apply_condition(ill, 10);
      tell_object(ob[i], msg);
    }

  }

  nature_gift(3);
  if (random(3) == 1)
  {
    if( check_seasonF()== "WinterB-Snow" )   // 隆冬的雪花
    {
      m = random( sizeof(path) );
      dir = path[m];
      filename = MISC_D->random_place(dir);
      if (!place_ok(filename))
        return;
      obj = new(NATURE_OBJ"winter-snow");
      if (objectp(obj) && obj->move(filename) )
      {
        CHANNEL_D->do_channel( this_object(),
           "sys", sprintf("%s "HIG"落于 [%s]"NOR, obj->query("name"),filename ) );
        msg = "听说["+ nameW[m] +NOR WHT "]普降瑞雪！！！\n" NOR;
        message("system", WHT"〖瑞雪丰年〗 "+ msg + NOR, users() );
      }

      else if (objectp(obj))
        destruct(obj);
      else
        log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"winter-snow"));
    }

  }

  reset_eval_cost();
}

// 每天的下午.
