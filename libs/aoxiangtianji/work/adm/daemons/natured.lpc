      message("system", WHT"〖夏之骄阳〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"summer-sun"));
  }

//秋之余阳
  if (season == "AutumnB" ||
      season == "AutumnC") // 中秋和深秋
  {
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    ob = new(NATURE_OBJ"autumn-sun");
    if (objectp(ob) && ob->move(filename))
    {
      CHANNEL_D->do_channel( this_object(),
         "sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"),filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]秋阳徘徊，不忍离去！！！\n" NOR;
      message("system", WHT"〖秋之余阳〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"autumn-sun"));
  }

//冬之暖阳
  if (season == "WinterA" ||
      season == "WinterC") // 初冬和冬末
  {
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    ob = new(NATURE_OBJ"winter-sun");
    if (objectp(ob) && ob->move(filename))
    {
      CHANNEL_D->do_channel( this_object(),
         "sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"),filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]冬阳残照，送人温暖！！！\n" NOR;
      message("system", WHT"〖冬之暖阳〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"winter-sun"));
  }

}

void place_water_gift(int num)
{
  object ob;
  string dir, filename, msg, csf, season,weather;
  int m;

  csf = check_seasonF();

  if(sscanf(csf, "%s-%s", season, weather)!=2 )
    return;
  if (weather != "Rain")
    if (csf != "WinterA-Snow" && csf != "WinterC-Snow")
      return;
//春之喜雨
  if (season == "SpringA" ||
      season == "SpringB") // 初春和中春
  {
    if (num == 0 ||
        num == 3 ||
        num == 5)  //排除凌晨，正午，傍晚
      return;
    if (random(3) == 0)
      return;
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    ob = new(NATURE_OBJ"spring-rain");
    if (objectp(ob) && ob->move(filename))
    {
      CHANNEL_D->do_channel( this_object(),
         "sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"),filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]普降春雨！！！\n" NOR;
      message("system", WHT"〖春之喜雨〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"spring-rain"));
  }

//夏之暴雨
  if (season == "SummerB" ||
      season == "SummerC") // 盛夏和夏末
  {
    if (num == 0 ||
        num == 2 ||
        num == 3) //排除凌晨，上午，正午
      return;
    if (random(3) == 0)
      return;
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    ob = new(NATURE_OBJ"summer-rain");
    if (objectp(ob) && ob->move(filename))
    {
      CHANNEL_D->do_channel( this_object(),
         "sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"),filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]暴雨滂沱！！！\n" NOR;
      message("system", WHT"〖夏之暴雨〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"summer-rain"));
  }

//秋之瑟雨
  if (season == "AutumnC") // 深秋
  {
    if (num == 0 ||
        num == 7) //排除凌晨，深夜
      return;
    if (random(3) == 0)
      return;
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    ob = new(NATURE_OBJ"autumn-rain");
    if (objectp(ob) && ob->move(filename))
    {
      CHANNEL_D->do_channel( this_object(),
         "sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"),filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]秋雨萧瑟！！！\n" NOR;
      message("system", WHT"〖秋之瑟雨〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"autumn-rain"));
  }

//冬之雪雨
  if (csf == "WinterC-Snow" ||
      csf == "WinterA-Snow") // 初冬和冬末
  {
    if (num == 0 ||
        num == 1 ||
        num == 3 ||
        num == 7) //排除凌晨，上午，正午
      return;
    if (random(2))
      return;
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    ob = new(NATURE_OBJ"winter-rain");
    if (objectp(ob) && ob->move(filename))
    {
      CHANNEL_D->do_channel( this_object(),
         "sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"),filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]普降雪雨！！！\n" NOR;
      message("system", WHT"〖冬之雪雨〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"winter-rain"));
  }

  return;
}

void place_light_gift(int num)
{
  object ob;
  string dir, filename, msg, csf, season,weather;
  int m;

  csf = check_seasonF();
  if(sscanf(csf, "%s-%s", season, weather)!=2 )
    return;
  if (weather != "Rain")
    return;

  if (random(3))
    return;

  m = random( sizeof(path) );
  dir = path[m];
  filename = MISC_D->random_place(dir);
  if (!place_ok(filename))
    return;
  if (random(2))
    ob = new(NATURE_OBJ"thunder");
  else
    ob = new(NATURE_OBJ"light");
  if (objectp(ob) && ob->move(filename))
  {
    CHANNEL_D->do_channel( this_object(), "sys",
       sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"), filename ) );
    msg = "听说["+ nameW[m] +NOR WHT "]雷声隆隆，电闪如裂！！！\n" NOR;
    message("system", WHT"〖雷电交加〗 "+ msg + NOR, users() );
  }

  else if (objectp(ob))
    destruct(ob);
  else
    log_file("file_err", sprintf("File not found : %s or %s\n",
             NATURE_OBJ"thunder",NATURE_OBJ"light") );
}

void nature_gift(int num)
{
  reset_eval_cost();
  place_wind_gift(num);
  place_fire_gift(num);
  place_water_gift(num);
  place_earth_gift(num);
  place_light_gift(num);
  return;
}

void event_dawn()
{
  object ob;
  string dir, filename, msg;
  int m,i;
  object *ob_list;
  nature_gift(0);
  if (random(2))
  {
    if( check_seasonF()== "SpringC-Rain" ) // 雨季的晨曦细雨(只在春末的凌晨出现)
    {
      m = random( sizeof(path) );
      dir = path[m];
      filename = MISC_D->random_place(dir);
      if (!place_ok(filename))
        return;
      ob = new(NATURE_OBJ"morning-rain");
      if (objectp(ob) && ob->move(filename))
      {
        CHANNEL_D->do_channel( this_object(), "sys",
           sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"), filename ) );
        msg = "听说["+ nameW[m] +NOR WHT "]普降细雨！！！\n" NOR;
        message("system", WHT"〖晨曦细雨〗 "+ msg + NOR, users() );
      }

      else if (objectp(ob))
        destruct(ob);
      else
        log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"morning-rain") );
    }

  }

  if (random(2))
  {
    if( check_seasonF()== "AutumnC-Sun" ) // 深秋的霜华(只在深秋晴朗的凌晨出现)
    {
      m = random( sizeof(path) );
      dir = path[m];
      filename = MISC_D->random_place(dir);
      if (!place_ok(filename))
        return;
      ob = new(NATURE_OBJ"autumn-frost");
      if (objectp(ob) && ob->move(filename))
      {
        CHANNEL_D->do_channel( this_object(),
             "sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"), filename ) );
        msg = "听说["+ nameW[m] +NOR WHT "]普降秋霜！！！\n" NOR;
        message("system", WHT"〖秋之霜华〗 "+ msg + NOR, users() );
      }

      else if (objectp(ob))
        destruct(ob);
      else
        log_file("file_err", sprintf("File not found : %s\n",
          NATURE_OBJ"autumn-frost"));
    }

  }

// 收回夜晚的夏日乘凉人
  ob_list = children(NATURE_NPC"summerman");
  for( i=0; i<sizeof(ob_list); i++)
    if(environment(ob_list[i]))
    {
      message_vision(WHT"$N"NOR"说道：天亮了，该回家睡觉罗～～～\n"NOR,ob_list[i]);
      CHANNEL_D->do_channel( this_object(),
         "sys", sprintf("%d 个纳凉人被系统清除"NOR, sizeof(filter_array(ob_list,(:clonep:)))  ));
      destruct(ob_list[i]);
    }

  if( !random(16+random(8)) )
  {
    if (file_size ("/log/dig/money") <= 0)
      MONEY_D->move_money(random(30));
  }

  else if (file_size ("/log/dig/money") > 0)
  {
    rm("/log/dig/money");
    message("system",WHT"〖天外横财〗财神爷突然降临人间，把地上的黄金全收走了……\n"NOR,users());
  }

  reset_eval_cost();
}

