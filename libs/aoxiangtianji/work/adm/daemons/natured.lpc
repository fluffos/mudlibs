         "sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"),filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]炎风吹火，热浪迫人！！！\n" NOR;
      message("system", WHT"〖夏之炎风〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"summer-wind"));
  }

//秋之萧风
  if (season == "AutumnA" ||
      season == "AutumnB" ||
      season == "AutumnC")
  {
    if (num < 3 || num > 6)
      return;
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    ob = new(NATURE_OBJ"autumn-wind");
    if (objectp(ob) && ob->move(filename))
    {
      CHANNEL_D->do_channel( this_object(),
         "sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"),filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]秋风萧瑟，黄了青草坡，红了枫林叶！！！\n" NOR;
      message("system", WHT"〖秋之瑟风〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"autumn-wind"));
  }

//冬之寒风
  if (season == "WinterA" ||
      season == "WinterB" ||
      season == "WinterC")
  {
    if (num > 1 && num < 6)
      return;
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    ob = new(NATURE_OBJ"winter-wind");
    if (objectp(ob) && ob->move(filename))
    {
      CHANNEL_D->do_channel( this_object(),
         "sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"),filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]寒风凛冽，刺骨生寒！！！\n" NOR;
      message("system", WHT"〖冬之寒风〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"winter-wind"));
  }

}

void place_fire_gift(int num)
{
  object ob;
  string dir, filename, msg, csf, season,weather;
  int m;

  csf = check_seasonF();

  if(sscanf(csf, "%s-%s", season, weather)!=2 )
    return;
  if (weather != "Sun")
    return;
  if (num == 0 ||
      num == 1 ||
      num == 5 ||
      num == 6 ||
      num == 7)  //排除凌晨，早上，傍晚，晚上，深夜
    return;
  if (random(3) == 0)
    return;
//春之艳阳
  if (season == "SpringB" ||
      season == "SpringC") // 中春和春末
  {
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    ob = new(NATURE_OBJ"spring-sun");
    if (objectp(ob) && ob->move(filename))
    {
      CHANNEL_D->do_channel( this_object(),
         "sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"),filename ) );
      msg = "听说["+ nameW[m] +NOR WHT "]艳阳高照，生机勃勃！！！\n" NOR;
      message("system", WHT"〖春之艳阳〗 "+ msg + NOR, users() );
    }

    else if (objectp(ob))
      destruct(ob);
    else
      log_file("file_err", sprintf("File not found : %s\n",NATURE_OBJ"spring-sun"));
  }

//夏之骄阳
  if (season == "SummerB" ||
      season == "SummerC") // 盛夏和夏末
  {
    m = random( sizeof(path) );
    dir = path[m];
    filename = MISC_D->random_place(dir);
    if (!place_ok(filename))
      return;
    ob = new(NATURE_OBJ"summer-sun");
    if (objectp(ob) && ob->move(filename))
