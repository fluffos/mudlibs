  return day_phase[current_day_phase]["weather_msg"];
}

/**************************************************************************************************/
mapping *read_table(string file)
{
  string *line, *field, *format;
  mapping *data;
  int i, rn, fn;
  line = explode(read_file(file), "\n");
  data = ({});
  for(i=0; i<sizeof(line); i++)
  {
    if( line[i]=="" || line[i][0]=='#' )
      continue;
    if( !pointerp(field) )
    {
      field = explode( line[i], ":" );
      continue;
    }

    if( !pointerp(format) )
    {
      format = explode( line[i], ":" );
      continue;
    }

    break;
  }

  for( rn = 0, fn = 0; i<sizeof(line); i++)
  {
    if( line[i]=="" || line[i][0]=='#' )
      continue;
    if( fn == 0 )
      data += ({ allocate_mapping(sizeof(field)) });
    sscanf( line[i], format[fn], data[rn][field[fn]] );
    fn = (++fn) % sizeof(field);
    if( !fn )
      ++rn;
  }

  return data;
}

mapping *query_day_phase()
{
   return day_phase;
}

string query_festival()
{
  return festival ;
}

string query_season()
{
  string get_month;
  string season;

  get_month = CHINESE_D->chinese_number(query_month());

  season = "";
  switch (get_month)
  {
    case "三" :
    case "四" :
    case "五" :
      season = "spring";
      break;
    case "六" :
    case "七" :
    case "八" :
      season = "summer";
      break;
    case "九" :
    case "十" :
    case "十一" :
      season = "autumn";
      break;
    case "零":
    case "十二":
    case "一":
    case "二":
      season = "winter";
      break;
    default :
      season = "";
  }

  return season;
}

string query_weather()
{
  string file_str;
  string season;
  string weather;

  file_str = check_season();
  if(sscanf(file_str, "%s-%s", season, weather)!=2 )
    return "";
  return lower_case(weather);
}

int query_fenglu_day()
{
  string get_month, get_day;
  get_month = CHINESE_D->chinese_number(query_month());
  get_day = CHINESE_D->chinese_number(query_days());
  if ((get_month == "一") && (get_day == "一"))
    return 1;
  return 0;
}

int is_special_day()
{
  string e_time, week, month, year;
  int day, hour, minute, second;

  e_time = ctime(time());
  sscanf(e_time,"%s %s %d %d:%d:%d %s", week, month, day, hour, minute, second, year);
  if (month == "Jan" && day == 1)  //元旦
    return 2;

  if (month == "May" && day > 0 && day < 8)  //劳动节
    return 2;

  if (month == "Oct" && day > 0 && day < 8) //国庆节
    return 2;

  if(week=="Sat" || week=="Sun")
    return 1;
  return 0;
}