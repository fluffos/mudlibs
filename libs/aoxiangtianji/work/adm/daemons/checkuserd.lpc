#include <user.h>
inherit F_DBASE;
protected void heart_beat();
void create()
{
  seteuid(getuid());
  set("name", "玩家状态检查精灵");
  set("channel_id", "玩家状态精灵");
  CHANNEL_D->do_channel( this_object(), "sys", "玩家状态检查已经启动。");
  set_heart_beat(50);
}

protected void heart_beat()
{
  object ob,*obs;
  int t = time();

  obs = filter_array(users(),(: !interactive($1) && !stringp($1->query("doing")) :));
  if (sizeof(obs) < 1)
    return;
  foreach(ob in obs)
  {
    if (ob->is_net_dead())
    {
      if (t-(int)ob->query_temp("netdead") > NET_DEAD_TIMEOUT+15)
        ob->user_dump(DUMP_NET_DEAD);
    }

    else
    {
      CHANNEL_D->do_channel( this_object(), "sys", sprintf("%s真的断线了。\n",ob->query("id")));
      ob->do_net_dead();
    }

  }

}