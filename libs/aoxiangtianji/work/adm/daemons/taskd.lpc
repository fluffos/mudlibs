void create()
{
  string file,dir,name;
  string buf_line, *buf1;
  int size;
  seteuid(getuid());
  set("channel_id", "任务精灵");

  maps=([]);
  file = read_file("/adm/daemons/find.map");
  buf1 = explode(file,"\n");
  size = sizeof(buf1);
  if(!size)
    return;

  foreach (buf_line in buf1)
  {
    if(sscanf(buf_line,"%s %s",dir,name)==2)
    {
      name = replace_string(name," ","");
      if(strlen(dir)>2 && strlen(name)>2)
        maps+=([dir:name]);
     }

  }

  CRON_D->set_last_hard_dis();
}

int sort_place(string file)
{
  if ( !sscanf(file, "%*s.lpc") )
    return 0;
  if (sscanf(file, "%*s.c.bak") )
    return 0;
  return 1;
}

string get_a_place()
{
  string *file;
  string dir;
  int i;
  dir = element_of(dirs);
  file = get_dir(dir);
  if (sizeof(file) <= 0)
    return "";
  file  = filter_array(file, (: sort_place :) );
  i = sizeof(file);
  if (i < 1)
    return "";
  return dir + file[random(i)];
}

int quest_reward(object me, object who,object quest_item)
{
  int exp,dx,pot,job_count;
  if (!quest_item->is_dynamic_item())
    return 0;

  if (userp(who))
    return 0;

  if(who->query("name") != quest_item->query("owner_name"))
    return 0;
  if(who->query("id") != quest_item->query("owner_id"))
    return 0;

  job_count = me->query_temp("dynamic_find");
  dx = 200 + job_count;
  pot = dx/3;
  job_count++;
  if (job_count >= 500)
    me->delete_temp("dynamic_find");
  else
    me->set_temp("dynamic_find",job_count);
  if ((job_count%20) == 0)
  {
    dx += 1000;
    pot += 500;
    tell_object(me,HIR"你真行啊，获得了额外的一些奖励！\n"NOR);
  }

  if (quest_item->query("super_baowu"))
  {
    dx *= 8;
    pot *= 8;
    exp = dx/5 + random(dx/5);
    me->add("work/dynamic_find",4);
    me->add("balance",4000);
    CHANNEL_D->do_channel(this_object(), "rumor",
            sprintf("据说%s找到了%s！\n",me->name(),quest_item->query("name")));
  }

  me->add("work/dynamic_find",1);
  me->add("balance",1000);
  GIFT_D->delay_bonus(me, ([ "prompt" : "通过这次寻宝" + quest_item->name() +
                                        HIG "的经历",
                             "exp"    : exp,
                             "pot"    : pot,
                             "daoxing" : dx,
                             "score"  : 1+random(3),]),"task");
  return 1;
}

int find_really_spread(string arg)
{
  object ob, *obs = children(quests[arg]);
  if (arrayp(obs) && sizeof(obs) > 0)
  {
    foreach (ob in obs)
    {
      if (environment(ob))
      {
        return 0;
      }

      else
        destruct(ob);
    }

  }

  return 1;
}

varargs void init_dynamic_quest(int hard)
{
  int total;
  object ob, *obs;
  string quest, *ks;
  if (hard)
  {
    ks = filter_array(keys(quests), (: !find_really_spread($1) :));
    foreach (quest in ks)
    {
      obs = children(quests[quest]);
      foreach (ob in obs)
        destruct(ob);
    }

    ks = keys(quests);
  }

  else
    ks = filter_array(keys(quests), (: find_really_spread($1) :));

  if (!sizeof(ks))
  {
    message("system",HIB"\n\t\t所有使命已分配在系统中。。。\n"NOR, users());
    return;
  }

  message("system",HIR "\n\t\t系统重新分布使命......\n"NOR,users());
  total = 0;
  foreach (quest in ks)
  {
    reset_eval_cost();
    spread_quest(quests[quest]);
    total++;
  }

  message("system",sprintf(HIB"\n\t......使命分布完毕！共有%d件物品被分派！\n"NOR,total), users());
  big_task();
}

void spread_quest(string quest)
{
  object obj0;
  object cur_obj;
  object tar;
  object *inv;
  int i;
  string location;
  location = get_a_place();

  if (!stringp(location) || strlen(location) < 2)
    return;
  for (i=0;i<5;i++)
  {
    obj0=find_object(location);
    if (!objectp(obj0))
      obj0=load_object(location);
    if(!objectp(obj0))
      continue;
    if (obj0->is_safty() ||
      obj0->query("no_fight"))
      continue;
    if (!mapp(obj0->query("exits")) || sizeof(obj0->query("exits")) < 1)
      continue;
    break;
  }

  if (i >= 5)
    return;

  cur_obj =obj0;
  if(cur_obj)
  {
    inv = all_inventory(cur_obj);
    inv = filter_array(inv,(:
                              ($1->is_character() &&
                              !userp($1)) ||
                              $1->is_container()
                           :));
    if (sizeof(inv) > 0)
      cur_obj = element_of(inv);
  }

  if(cur_obj)
  {
    tar = new(quest);
    if (objectp(tar))
      tar->move(cur_obj);
  }

  return;
}

string dyn_quest_list()
{
  string output, quest, *ks;
  object item, *obs;

  output="";

  ks = filter_array(keys(quests), (: !find_really_spread($1) :));
  if (!arrayp(ks) || sizeof(ks) < 1)
    return "目前系统中没有任何宝物备分派！\n";

  foreach(quest in ks)
  {
    obs = children(quests[quest]);
    foreach (item in obs)
    {
      if (objectp(item) && environment(item))
      {
        output += sprintf(HIG"%10s"HIB" → "HIW"%10s"NOR"（%s）     \n",
                        item->query("owner_name"),
                        item->query("name"),
                        item->query("id"));
      }

    }

  }

  return output;
}

object find_env(object ob)
{
  mapping exits;

  reset_eval_cost();
  while(objectp(ob))
  {
    exits = ob->query("exits");
    if(mapp(exits) && sizeof(exits) > 0)
      break;
    else
      ob=environment(ob);
  }

  return ob;
}

int locate_quest(object me, string arg)
{
  object loc, baowu, *obs;
  string qloc,msg,*ks;
  string* exlst;
  mapping exits;
  int i;

  if(!arg)
  {
    tell_object(me,"locate/zhao <物品id>\n");
    return 0;
  }

  if(present(arg,me))
  {
    tell_object(me,"它不正在你的身上吗？\n");
    return 0;
  }

  ks = filter_array(keys(quests), (: !find_really_spread($1) :));
  if (!arrayp(ks) || sizeof(ks) < 1)
  {
    tell_object(me,HIW"藏宝图"NOR"一点反应也没有。\n");
    return 1;
  }

  if (member_array(arg,ks) == -1)
  {
    if (quests[arg])
      tell_object(me,HIW"藏宝图"NOR"一点反应也没有，仿佛它根本不存在这个世界上。\n");
    else
      tell_object(me,"探宝图中没有这样东西！\n");
    return 1;
  }

  obs = children(quests[arg]);
  if (!arrayp(obs) || sizeof(obs) < 1)
  {
    tell_object(me,HIW"藏宝图"NOR"一点反应也没有。\n");
    return 1;
  }

  foreach (baowu in obs)
  {
    if(objectp(baowu) && objectp(loc=find_env(baowu)))
    {
      qloc = query_city(loc);
      exits = loc->query("exits");
      if (loc->is_safty() || !mapp(exits) || sizeof(exits) < 1)
      {
        destruct(baowu);
        tell_object(me,HIW"藏宝图"NOR"一点反应也没有。\n");
        return 1;
      }

      exlst = keys(exits);
      msg = HIW + baowu->query("name") + NOR"仿佛在"HIG + qloc + NOR"一处有";
      for(i=0;i<sizeof(exlst)-1;i++)
        msg+=exlst[i]+"、";
      msg += exlst[sizeof(exlst)-1] + "出口的地方。\n";
      tell_object(me,HIW"藏宝图"NOR"显示：\n" + msg);
      return 1;
    }

  }

  tell_object(me,HIW"藏宝图"NOR"一点反应也没有。\n");
  return 1;
}

string query_city(object loc)
{
  string filename,filename1;
  int len;

  filename=file_name(loc);
  len=strlen(filename);
  if(len<2)
    return "???";
  len--;
  while(filename[len]!='/' && len>0)
  {
    len--;
  }

  if(len<2)
    return "???";
  filename1=filename[1..(len-1)];
  return maps[filename1];
}

void big_task()
{
  string *kb, *sub_baowu, *total_baowu;
  string tmp_str;
  int i,j;
  total_baowu = ({});
  kb = filter_array(keys(quests), (: !find_really_spread($1) :));

  foreach (tmp_str in kb)
    total_baowu += ({quests[tmp_str]});

  group = ([]);
  for (i=1;i<=MAX_GROUP;i++)
  {
    if (sizeof(total_baowu) < 4)
      break;
    sub_baowu = ({});
    for (j=1;j<=MAX_NUM_PER_GROUP;j++)
    {
      if (sizeof(total_baowu) < 1)
        break;
      tmp_str = element_of(total_baowu);
      sub_baowu += ({tmp_str});
      total_baowu -= ({tmp_str});
      total_baowu -= ({0});
    }

    group += ([sprintf("%d",i) : sub_baowu]);
  }

}

mixed query_group()
{
  return group;
}

string *query_baowu_group(string baowu)
{
  string *sub_baowu = ({});
  int i, max_group;

  max_group = sizeof(group);
  if (max_group < 1)
    return 0;

  for (i=0;i<max_group;i++)
  {
    sub_baowu = group[sprintf("%d",i)];
    if (!arrayp(sub_baowu) || sizeof(sub_baowu) < 1)
      continue;
    if (member_array(baowu,sub_baowu) != -1)
      break;
  }

  return sub_baowu;
}

string query_baowu_long(string baowu)
{
  string *baowu_group, tmp_str, origin_long;
  object *obs, ob;

  baowu_group = query_baowu_group(baowu);
  if (!arrayp(baowu_group) || sizeof(baowu_group) < 1)
    return 0;

  obs = children(baowu);
  if (!arrayp(obs) || sizeof(obs) < 1)
    return 0;

  foreach (ob in obs)
  {
    if (!objectp(ob) || !objectp(environment(ob)))
      continue;
    origin_long = ob->query("long");
    origin_long += "\n";
    origin_long += HIR"仔细观看,在不显眼的地方,刻有一行小字：\n"NOR;
    origin_long += HIB"收集如下物品可以合成(mix)>>>\n"NOR;
  }

  foreach (tmp_str in baowu_group)
  {
    obs = children(tmp_str);
    if (!arrayp(obs) || sizeof(obs) < 1)
      continue;
    foreach (ob in obs)
    {
      if (!objectp(ob) || !objectp(environment(ob)))
      {
        continue;
      }

      origin_long += HIY + ob->query("name") + "(" + ob->query("id") + ")\n" + NOR;
    }

  }

  origin_long += "\n";
  return origin_long;
}

int do_mix(object me, string baowu)
{
  string *sub_baowu, tmp_str;
  object *obs , *obs1, ob ;
  string o_name, msg;

  if (!objectp(me) || !playerp(me))
    return 0;

  sub_baowu = query_baowu_group(baowu);
  if (!arrayp(sub_baowu) || sizeof(sub_baowu) < 1)
    return 0;

  msg = "$N把";
  obs1 = ({});
  foreach (tmp_str in sub_baowu)
  {
    obs = children(tmp_str);
    obs = filter_array(obs, (: objectp($1) &&
                               objectp(environment($1)) :));
    if (!arrayp(obs) ||
        sizeof(obs) < 1 ||
        environment(obs[0]) != me)
    {
      tell_object(me,"你还没有备齐所需的物品！\n");
      return 1;
    }

    obs1 += ({obs[0]});
  }

  if (sizeof(obs1) < 4)
  {
    tell_object(me,sprintf("好象还缺少%d样东西！\n",4-sizeof(obs1)));
    return 1;
  }

  foreach (ob in obs1)
  {
    msg += ob->query("name") + " ";
    if (ob != obs1[0])
      destruct(ob);
    else if (!ob->query("super_baowu"))
    {
      o_name = ob->query("name");
      o_name = "超级 " + o_name;
      ob->set_name(o_name,ob->query_my_id());
      ob->set("super_baowu",1);
      ob->setup();
    }

  }

  msg += "合在了一起，口中念念有词，不一会儿，脸上露出了满意的笑容！\n";
  message_vision(msg,me);
  tell_object(me,"你成功的得到了一件新的宝物！\n");
  return 1;
}

