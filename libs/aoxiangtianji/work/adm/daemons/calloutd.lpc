#pragma optimize

inherit F_DBASE;
protected void heart_beat();
protected void sys_info(string msg);
private int state;
#define CNOK     0
#define COK      1
int callout_is_ok() { return state == COK; }

void create()
{
  seteuid(getuid());
  set("name", "系统精灵");
  set("channel_id", "调用检察精灵");
  CHANNEL_D->do_channel( this_object(), "sys", "callout检察已经启动。");
  state = COK;
  set_heart_beat(300);
}

string callouts()
{
  mixed *info;
  int i;
  string output;
  info = call_out_info();
  output = sprintf("%-30s %-20s %5s %s\n", "物件", "函数", "延迟时间", "参数");
  for(i=0; i<sizeof(info); i++)
  {
    if ( sizeof(info[i]) == 4)
      output += sprintf("%-30O %-20s %5d %O\n",
        info[i][0], info[i][1], info[i][2], info[i][3] );
    else
      output += sprintf("%-30O %-20s %5d\n",
        info[i][0], info[i][1], info[i][2] );
  }

  return output;
}

protected void heart_beat()
{
  mixed *info;
  int i;
  string output;
  info = call_out_info();
  for(i=0; i<sizeof(info); i++)
  {
    reset_eval_cost();
    if (info[i][2] < 0)
    {
      state = CNOK;
      sys_info("callout发现异常情况！");
      output = sprintf("%-30s %-20s %5s %s\n", "物件", "函数", "延迟时间", "参数");
      if ( sizeof(info[i]) == 4)
        output += sprintf("%-30O %-20s %5d %O\n",
          info[i][0], info[i][1], info[i][2], info[i][3] );
      else
        output += sprintf("%-30O %-20s %5d\n",
          info[i][0], info[i][1], info[i][2] );
      log_file("callout",output);
      log_file("callout",callouts());
      set_heart_beat(0);
      "/cmds/arch/reboot"->main(this_object(),"after 5 called by calloutd");
      break;
    }

  }

}

protected void sys_info(string msg)
{
  CHANNEL_D->do_channel(this_object(), "sys", msg + "\n");
  log_file("callout", ctime(time()) + ": " + msg + "\n");
}