//weapontopd.c
#include <ansi.h>
#include <mudlib.h>
#define TOPTEN_SWORD      "/topten/sword.txt"
#define TOPTEN_BLADE      "/topten/blade.txt"
#define TOPTEN_AXE        "/topten/axe.txt"
#define TOPTEN_FORK       "/topten/fork.txt"
#define TOPTEN_HAMMER     "/topten/hammer.txt"
#define TOPTEN_MACE       "/topten/mace.txt"
#define TOPTEN_NEEDLE     "/topten/needle.txt"
#define TOPTEN_UNARMED    "/topten/unarmed.txt"
#define TOPTEN_RAKE       "/topten/rake.txt"
#define TOPTEN_SPEAR      "/topten/spear.txt"
#define TOPTEN_STAFF      "/topten/staff.txt"
#define TOPTEN_STICK      "/topten/stick.txt"
#define TOPTEN_WHIP       "/topten/whip.txt"
#define TOPTEN_THROW      "/topten/throw.txt"
#define SWORD_B	    HIW"西游记 "HIC"十大 "NOR WHT"剑法高手（SWORD）"NOR
#define BLADE_B	    HIW"西游记 "HIC"十大 "NOR WHT"刀法高手（BLADE）"NOR
#define AXE_B       HIW"西游记 "HIC"十大 "NOR WHT"斧法高手（AXE）"NOR
#define FORK_B	    HIW"西游记 "HIC"十大 "NOR WHT"叉法高手（FORK）"NOR
#define HAMMER_B    HIW"西游记 "HIC"十大 "NOR WHT"锤法高手（HAMMER）"NOR
#define MACE_B	    HIW"西游记 "HIC"十大 "NOR WHT"锏法高手（MACE）"NOR
#define NEEDLE_B    HIW"西游记 "HIC"十大 "NOR WHT"针法高手（NEEDLE）"NOR
#define UNARMED_B   HIW"西游记 "HIC"十大 "NOR WHT"手法高手（UNARMED）"NOR
#define RAKE_B	    HIW"西游记 "HIC"十大 "NOR WHT"钯法高手（RAKE）"NOR
#define SPEAR_B	    HIW"西游记 "HIC"十大 "NOR WHT"枪法高手（SPEAR）"NOR
#define STAFF_B	    HIW"西游记 "HIC"十大 "NOR WHT"杖法高手（STAFF）"NOR
#define STICK_B	    HIW"西游记 "HIC"十大 "NOR WHT"棍法高手（STICK）"NOR
#define WHIP_B	    HIW"西游记 "HIC"十大 "NOR WHT"鞭法高手（WHIP）"NOR
#define THROW_B	    HIW"西游记 "HIC"十大 "NOR WHT"暗器高手（THROW）"NOR
void topten_checkplayer(object);
int get_all_data(object,string);
int topten_del(string,string);
int topten_add(object,string);
int topten_save(string,string,string);
string topten_query(string);
string query_type();
void topten_checkplayer(object player)
{
  topten_add(player,"sword");
  topten_add(player,"blade");
  topten_add(player,"axe");
  topten_add(player,"fork");
  topten_add(player,"hammer");
  topten_add(player,"mace");
  topten_add(player,"needle");
  topten_add(player,"unarmed");
  topten_add(player,"rake");
  topten_add(player,"spear");
  topten_add(player,"staff");
  topten_add(player,"stick");
  topten_add(player,"whip");
  topten_add(player,"throw");
  return;
}

string query_type()
{
  return HIW+MUD_NAME+HIY" 现在有以下武功类型的排行榜：\n"+
         HIB"━━━━━━━━━━━━━━━━━━━━━━\n"+
         HIR"一：\t"NOR+SWORD_B+"\n"+
         HIR"二：\t"NOR+BLADE_B+"\n"+
         HIR"三：\t"NOR+AXE_B+"\n"+
         HIR"四：\t"NOR+FORK_B+"\n"+
         HIR"五：\t"NOR+HAMMER_B+"\n"+
         HIR"六：\t"NOR+MACE_B+"\n"+
         HIR"七：\t"NOR+NEEDLE_B+"\n"+
         HIR"八：\t"NOR+UNARMED_B+"\n"+
         HIR"九：\t"NOR+RAKE_B+"\n"+
         HIR"十：\t"NOR+SPEAR_B+"\n"+
         HIR"十一：\t"NOR+STAFF_B+"\n"+
         HIR"十二：\t"NOR+STICK_B+"\n"+
         HIR"十三：\t"NOR+WHIP_B+"\n"+
         HIR"十四：\t"NOR+THROW_B+"\n"+
         HIB"━━━━━━━━━━━━━━━━━━━━━━\n"NOR;
}

int topten_save(string f_name,string b_name,string str)
{
  string *astr;
  int i;
  astr=explode(str,"\n");
  str="";
  for(i=0;i<sizeof(astr)&&i<10;i++)
    str+=astr[i]+"\n";
  if(!write_file(f_name,str,1))
    return notify_fail("无法写文件"+f_name+"，权限不够!不能更新"+b_name+"!\n");
  return 1;
}

string topten_query(string type)
{
  string b_name,f_name,str,*astr,*bstr,name,id;
  int i,j,data;
  switch(type)
  {
    case "sword":
      b_name=SWORD_B;
      f_name=TOPTEN_SWORD;
      break;
    case "blade":
      b_name=BLADE_B;
      f_name=TOPTEN_BLADE;
      break;
    case "axe":
      b_name=AXE_B;
      f_name=TOPTEN_AXE;
      break;
    case "fork":
      b_name=FORK_B;
      f_name=TOPTEN_FORK;
      break;
    case "hammer":
      b_name=HAMMER_B;
      f_name=TOPTEN_HAMMER;
      break;
    case "mace":
      b_name=MACE_B;
      f_name=TOPTEN_MACE;
      break;
    case "needle":
      b_name=NEEDLE_B;
      f_name=TOPTEN_NEEDLE;
      break;
    case "unarmed":
      b_name=UNARMED_B;
      f_name=TOPTEN_UNARMED;
      break;
    case "rake":
      b_name=RAKE_B;
      f_name=TOPTEN_RAKE;
       break;
     case "spear":
       b_name=SPEAR_B;
       f_name=TOPTEN_SPEAR;
       break;
     case "staff":
       b_name=STAFF_B;
       f_name=TOPTEN_STAFF;
       break;
     case "stick":
       b_name=STICK_B;
       f_name=TOPTEN_STICK;
       break;
     case "whip":
       b_name=WHIP_B;
       f_name=TOPTEN_WHIP;
       break;
     case "throw":
       b_name=THROW_B;
       f_name=TOPTEN_THROW;
       break;
     default:
       return query_type();
  }

  if(file_size(f_name)==-1)
    return b_name+HIR"的数据文件还没有创建！\n"NOR;
  astr=explode(read_file(f_name),"\n");
  str=HIR+MUD_NAME+"：\n"NOR+HIC+b_name+"\n";
  for(i=0;i<sizeof(astr);i++)
  {
    bstr=explode(astr[i],";");
    str+=NOR CYN"排行第"HIR+chinese_number(i+1)+NOR"：";
    for(j=0;j<sizeof(bstr);j++)
    {
      if(sscanf(bstr[j],"%s(%s)%d",name,id,data)!=3)
        return "数据错误!文件："+f_name+"第"+i+"行第"+j+"项！\n"+
               "该行数据："+bstr[j]+"\n";
      str+=name+"("+id+")\t";
    }

    str+="\n"NOR;
  }

  return str;
}

int get_all_data(object player,string type)
{
  int total;
  switch(type)
  {
    case "sword":
      total=(int)player->query_skill("sword");
      break;
    case "blade":
      total=(int)player->query_skill("blade");
      break;
    case "axe":
      total=(int)player->query_skill("axe");
      break;
    case "fork":
      total=(int)player->query_skill("fork");
      break;
    case "hammer":
      total=(int)player->query_skill("hammer");
      break;
    case "mace":
      total=(int)player->query_skill("mace");
      break;
    case "needle":
      total=(int)player->query_skill("needle");
      break;
    case "unarmed":
      total=(int)player->query_skill("unarmed");
      break;
    case "rake":
      total=(int)player->query_skill("rake");
      break;
    case "spear":
      total=(int)player->query_skill("spear");
      break;
    case "staff":
      total=(int)player->query_skill("staff");
      break;
    case "stick":
      total=(int)player->query_skill("stick");
      break;
    case "whip":
      total=(int)player->query_skill("whip");
      break;
    case "throw":
      total=(int)player->query_skill("throwing");
      break;
    default:
      total=-1;
  }

  return total;
}

int topten_del(string pid,string type)
{
  string str,*astr,*bstr,b_name,f_name;
  int i,j,k;
  switch(type)
  {
    case "sword":
      b_name=SWORD_B;
      f_name=TOPTEN_SWORD;
      break;
    case "blade":
      b_name=BLADE_B;
      f_name=TOPTEN_BLADE;
      break;
    case "axe":
      b_name=AXE_B;
      f_name=TOPTEN_AXE;
      break;
    case "fork":
      b_name=FORK_B;
      f_name=TOPTEN_FORK;
      break;
    case "hammer":
      b_name=HAMMER_B;
      f_name=TOPTEN_HAMMER;
      break;
    case "mace":
      b_name=MACE_B;
      f_name=TOPTEN_MACE;
      break;
    case "needle":
      b_name=NEEDLE_B;
      f_name=TOPTEN_NEEDLE;
      break;
    case "unarmed":
      b_name=UNARMED_B;
      f_name=TOPTEN_UNARMED;
      break;
    case "rake":
      b_name=RAKE_B;
      f_name=TOPTEN_RAKE;
      break;
    case "spear":
      b_name=SPEAR_B;
      f_name=TOPTEN_SPEAR;
      break;
    case "staff":
      b_name=STAFF_B;
      f_name=TOPTEN_STAFF;
      break;
    case "stick":
      b_name=STICK_B;
      f_name=TOPTEN_STICK;
      break;
    case "whip":
      b_name=WHIP_B;
      f_name=TOPTEN_WHIP;
      break;
    case "throw":
      b_name=THROW_B;
      f_name=TOPTEN_THROW;
      break;
    default:
      return notify_fail(HIC"没有"HIR+type+HIC"这种排行榜！\n"NOR);
  }

  if(file_size(f_name)==-1)
    return notify_fail(b_name+HIR"还没有创建！\n"NOR);
  str=read_file(f_name);
  astr=explode(str,"\n");
  for(i=0;i<sizeof(astr);i++)
  {
    if(strsrch(astr[i],pid)!=-1)
    {
      if(strsrch(astr[i],";")==-1)
      {
        str="";
        for(j=0;j<sizeof(astr);j++)
          if(j!=i)
            str+=astr[j]+"\n";
        return topten_save(f_name,b_name,str);
      }

      else
      {
        bstr=explode(astr[i],";");
        for(j=0;j<sizeof(bstr);j++)
          if(strsrch(bstr[j],pid)!=-1)
          {
            astr[i]="";
            for(k=0;k<sizeof(bstr);k++)
              if(k!=j)
	      {
                if((k+1)!=sizeof(bstr) && !((j+1)==sizeof(bstr) && j==(k+1)))
                  astr[i]+=bstr[k]+";";
                else
                  astr[i]+=bstr[k];
              }

          }

        str=implode(astr,"\n");
        return topten_save(f_name,b_name,str);
      }

    }

  }

  return 1;
}

int topten_add(object player,string type)
{
  string str,name,id,b_name,f_name;
  string *astr;
  int i,j,data;
  if(wizardp(player))
    return 0;

  switch(type)
  {
    case "sword":
      b_name=SWORD_B;
      f_name=TOPTEN_SWORD;
      break;
    case "blade":
      b_name=BLADE_B;
      f_name=TOPTEN_BLADE;
      break;
    case "axe":
      b_name=AXE_B;
      f_name=TOPTEN_AXE;
      break;
    case "fork":
      b_name=FORK_B;
      f_name=TOPTEN_FORK;
      break;
    case "hammer":
      b_name=HAMMER_B;
      f_name=TOPTEN_HAMMER;
      break;
    case "mace":
      b_name=MACE_B;
      f_name=TOPTEN_MACE;
      break;
    case "needle":
      b_name=NEEDLE_B;
      f_name=TOPTEN_NEEDLE;
      break;
    case "unarmed":
      b_name=UNARMED_B;
      f_name=TOPTEN_UNARMED;
      break;
    case "rake":
      b_name=RAKE_B;
      f_name=TOPTEN_RAKE;
      break;
    case "spear":
      b_name=SPEAR_B;
      f_name=TOPTEN_SPEAR;
      break;
    case "staff":
      b_name=STAFF_B;
      f_name=TOPTEN_STAFF;
      break;
    case "stick":
      b_name=STICK_B;
      f_name=TOPTEN_STICK;
      break;
    case "whip":
      b_name=WHIP_B;
      f_name=TOPTEN_WHIP;
      break;
    case "throw":
      b_name=THROW_B;
      f_name=TOPTEN_THROW;
      break;
    default:
      return notify_fail(HIC"没有"HIR+type+HIC"这种排行榜！\n"NOR);
  }

  if(!objectp(player)||!userp(player))
    return 0;
  if(file_size(f_name)==-1)
  {
    str=player->short()+"("+player->query("id")+")"+get_all_data(player,type);
    return topten_save(f_name,b_name,str);
  }

  if(get_all_data(player,type)==-1)
    return notify_fail(HIR"数据查询错误，可能是查询类型错误！\n"NOR);
  topten_del(player->query("id"),type);
  str=read_file(f_name);
  astr=explode(str,"\n");
  i=0;
  while(i<sizeof(astr))
  {
    if(sscanf(astr[i],"%s(%s)%d",name,id,data)!=3)
      if(sscanf(astr,"%s(%s)%d;%*s",name,id,data)!=3)
        return notify_fail(b_name+HIW"文件数据错误！请向巫师反应或直接post状况到留言板！\n"NOR);
    str="";
    if(data<(int)get_all_data(player,type))
    {
      for(j=0;j<sizeof(astr);j++)
      {
        if(j==i)
          str+=player->query("name")+"("+player->query("id")+")"+get_all_data(player,type)+"\n";
        str+=astr[j]+"\n";
      }

      return topten_save(f_name,b_name,str);
    }

    else if(data==(int)get_all_data(player,type))
    {
      for(j=0;j<sizeof(astr);j++)
      {
        str+=astr[j]+"\n";
      }

      return topten_save(f_name,b_name,str);
    }

    i++;
  }

  if(sizeof(astr)<10)
  {
    str=implode(astr,"\n")+"\n"+player->query("name")+"("+player->query("id")
                    +")"+get_all_data(player,type);
    return topten_save(f_name,b_name,str);
  }

  return 0;
}

