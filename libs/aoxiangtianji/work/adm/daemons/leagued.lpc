public int query_league_relation_league2(string lfrom, string lto)
{
  mapping lrinfo = query_league_relation(lfrom);
  string  *ll = query_league_list();
  if (member_array(lfrom,ll) == -1 ||
      member_array(lto,ll) == -1)
    return 0;

  if (!mapp(lrinfo) ||
      sizeof(lrinfo) < 1 ||
      (int)lrinfo[lto] <= 0)
    return 50;
  return (int)lrinfo[lto];
}

public mapping query_league_want_kill(string league_id)
{
  mapping league_info = query_league_info(league_id);
  return mapp(league_info["want_kill"]) ? league_info["want_kill"] : ([]);
}

public int is_league_want_kill(object ob1, object ob2)
{
  string lg1, lg2;
  mapping kwk1,kwk2;
  if (!playerp(ob1) || !playerp(ob2))
    return 0;

  lg1 = query_player_league_id(ob1);
  lg2 = query_player_league_id(ob2);

  kwk1 = query_league_want_kill(lg1);
  kwk2 = query_league_want_kill(lg2);

  if (mapp(kwk1) &&
      sizeof(kwk1) > 1 &&
      member_array(ob2->query("id"),keys(kwk1)) != 1)
    return 1;
  if (mapp(kwk2) &&
      sizeof(kwk2) > 1 &&
      member_array(ob1->query("id"),keys(kwk2)) != 1)
    return 1;
  return 0;
}

