//***************************************************
//set or add league data :
//***************************************************
private int set_gold(string league_id, int value)
{
  if (!is_league_id(league_id))
    return 0;
  league_total[league_id]["gold"] = value;
  save();
  return value;
}

public int add_gold(string league_id, int value)
{
  int old;

  old = query_league_gold(league_id);
  old += value;
  if (old > MAX_GOLD)
    old = MAX_GOLD;
  return set_gold(league_id, old);
}

private int set_fame(string league_id, int value)
{
  if (!is_league_id(league_id))
    return 0;
  league_total[league_id]["fame"] = value;
  save();
  return value;
}

private int add_fame(string league_id, int value)
{
  int old;

  old = query_league_fame(league_id);
  old += value;
  if (old > MAX_FAME)
    old = MAX_FAME;
  return set_fame(league_id, old);
}

private int set_member(string league_id, string *mem)
{
  if (!is_league_id(league_id) ||
      !arrayp(mem))
    return 0;
  league_total[league_id]["member"] = mem;
  save();
  return 1;
}

private int add_member(string league_id,string id)
{
  string *old = query_league_member(league_id);
  if (!arrayp(old))
    old = ({});
  if (member_array(id,old) != -1)
    return 0;
  old += ({id});
  set_member(league_id,old);
  return 1;
}

private int remove_a_member(string league_id,string id)
{
  string *old = query_league_member(league_id);
  if (!arrayp(old) || sizeof(old) < 1)
    return 0;
  if (member_array(id,old) == -1)
    return 0;
  old -= ({id});
  set_member(league_id,old);
  return 1;
}

private int set_member_level(string league_id, string *mem, int lvl)
{
  int *limit = ({MAX_L1_MEMBER,
                 MAX_L2_MEMBER,
                 MAX_L3_MEMBER,
                 MAX_L4_MEMBER});

  if (!is_league_id(league_id) ||
      !arrayp(mem) ||
      lvl < 1 || lvl > 4 ||
      sizeof(mem) > limit[lvl-1])
    return 0;
  league_total[league_id]["level" + sprintf("%d",lvl)] = mem;
  save();
  return 1;
}

