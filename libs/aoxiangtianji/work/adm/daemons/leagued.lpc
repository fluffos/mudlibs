public int check_legal_league_id(object who, string id)
{
  int i;
  string *banned_id;
  if (!playerp(who))
    return 0;

  i = strlen(id);
  banned_id=explode(read_file("/adm/etc/banned_id"),"\n");

  if( (strlen(id) < 3) || (strlen(id) > 8 ) )
  {
    tell_object(who,"对不起，联盟英文名字必须是 3 到 8 个英文字母。\n");
    return 0;
  }

  while(i--)
    if( id[i]<'a' || id[i]>'z' )
    {
      tell_object(who,"对不起，联盟英文名字只能用小写英文字母。\n");
      return 0;
    }

  for(i=0; i<sizeof(banned_id); i++)
  {
    if(banned_id[i][0..0]=="*")
    {
      if(strsrch(id, banned_id[i][1..])!=-1)
      {
        tell_object(who,"对不起，这种名字会造成其他人的困扰。\n");
        return 0;
      }

    }

    else
    {
      if( id == banned_id[i] )
      {
        tell_object(who,"对不起，这种名字会造成其他人的困扰。\n");
        return 0;
      }

    }

  }

  if (is_league_id(id))
  {
    tell_object(who,"已经有联盟使用这个id了！\n");
    return 0;
  }

  return valid_id(id);
}

public int check_legal_league_name(object who, string name)
{
  int i;
  if (!playerp(who))
    return 0;
  i = strlen(name);

  if( (strlen(name) < 2) || (strlen(name) > 5 ) )
  {
    tell_object(who,"中文名字必须是二到五个中文字。\n");
    return 0;
  }

  while(i--)
  {
    if( name[i]<=' ' )
    {
      tell_object(who,"中文名字不能用控制字符。\n");
      return 0;
    }

    if(!is_chinese(name[i..i]) )
    {
      tell_object(who,"请您用「中文」取名字。\n");
      return 0;
    }

  }

  if (is_league_name(name))
  {
    tell_object(who,"这个名字已经被其他的联盟用掉了！\n");
    return 0;
  }

  return valid_name(name);
}

public int create_league(string league_id, string cname, object *obs)
{
  mapping league;
  string *channels, *m_id;
  object ob, leader;
  int weiwang;
  if (!arrayp(obs) || sizeof(obs) < 1)
    return 0;

// 获取同盟首领id
  m_id = ({});
  weiwang = 0;
  leader = 0;
  foreach (ob in obs)
  {
    m_id += ({ob->query("id")});
    weiwang += ob->query("weiwang")/10000;
    if (ob->is_team_leader())
      leader = ob;
  }

  if (!objectp(leader) || !playerp(leader))
    return 0;

  if (!check_legal_league_id(leader,league_id))
  {
    tell_object(leader,"请换个联盟的id！\n");
    return 0;
  }

  if (!check_legal_league_name(leader,cname))
  {
    tell_object(leader,"请换个联盟的中文名字！\n");
    return 0;
  }

  if (weiwang > 10000)
    weiwang = 10000;

  if (!mapp(league_total))
    league_total = ([]);
  league_total += ([ league_id : ([
         "cname"     : cname,
         "member"    : m_id,
         "leader_id" : leader->query("id"),
         "leader_name" : leader->query("name"),
         "level1"    : ({}),
         "level2"    : ({}),
         "level3"    : ({}),
         "level4"    : ({}),
         "fame"      :  weiwang,
         "gold"      :  0,
         "rate"      :  10,
         "borrower"  : ([]),
         "city"      : ([]),
         "alley"     : ({}),
         "enemy"     : ({}),
         "relation" :  ([]),
         "want_kill" : ([]),
         "status"    : "normal",
       ])
      ]);

  save();
  foreach (ob in obs)
  {
    league = ([ "time"        : time(),
                "league_name" : cname,
                "league_id" : league_id,
                "leader_name" : leader->query("name"),
                "leader_id"   : leader->query("id") ]);
    ob->set("league", league);
    channels = ob->query("channels");
    if (! arrayp(channels) || ! sizeof(channels))
      channels = ({ "inter" });
    else if (member_array("inter", channels) == -1)
      channels += ({ "inter" });
    ob->set("channels", channels);
    ob->save();
  }

  return 1;
}

public void dismiss_league(string league_id)
{
  string *ids, *channels, *r;
  string id, cname,s;
  object ob;
  if (!is_league_id(league_id))
    return;
  cname = query_league_cname(league_id);
  if (!stringp(cname))
    return;

  map_delete(league_total, league_id);
  save();

// 清除同盟中的所有玩家的相关信息
  ids = query_league_member(league_id);
  if (!arrayp(ids) || sizeof(ids) < 1)
    return;

  r = query_league_alley(league_id);
  if (arrayp(r) && sizeof(r) > 0)
  {
    foreach (s in r)
      remove_a_alley(s, league_id);
  }

  r = query_league_enemy(league_id);
  if (arrayp(r) && sizeof(r) > 0)
  {
    foreach (s in r)
      remove_a_enemy(s, league_id);
  }

  foreach (id in ids)
  {   // 处理中
    reset_eval_cost();
    ob = 0;
    ob = find_player(id);
    if (!objectp(ob))
      ob = UPDATE_D->global_find_player(id);
    if (objectp(ob))
    {
      ob->delete("league");
      channels = ob->query("channels");
      if (arrayp(channels) &&
          sizeof(channels) > 1 &&
          member_array("inter", channels) != -1)
        channels -= ({"inter"});
      ob->set("channels", channels);
      UPDATE_D->global_destruct_player(ob, 1);
    }

  }

  CHANNEL_D->do_channel(this_object(), "rumor",
    "听说 「"HIG + cname + HIM"」 人才凋零，昔日好友尽皆散去，从此江湖再无此字号了。");
  return;
}

varargs string remove_member_from_league(mixed ob, object me,int force)
{
  int weiwang,mylvl,tolvl;
  string league_id;
  object who;
  string mid,pname,*old,*channels;

  if (!playerp(me))
    return "";
  league_id = query_player_league_id(me);
  if (!stringp(league_id))
    return "你先自己加入一个联盟再说吧！\n";
  if (stringp(ob))
  {
    mid = ob;
    who = find_player(ob);
    if (!objectp(who) && force)
      who = UPDATE_D->global_find_player(ob);
  }

  else if (objectp(ob))
  {
    mid = ob->query("id");
    who = ob;
  }

  else
    return "你想开除谁？！\n";
  if (!objectp(who) || !stringp(mid))
    return "没有你想要开除的玩家！\n";
  if (me == who)
    return "把自己开除？\n";

  if (!is_league_member(mid,league_id))
    return "有这个联盟成员吗？！\n";

  mylvl = query_member_level(me);
  tolvl = query_member_level(ob);

  if (!mylvl ||
      mylvl >= tolvl)
    return sprintf("你没有权利开除%s！\n",who->query("name"));

  if (tolvl > 0)
  {
    old = query_league_member_level(league_id, tolvl);
    old -= ({mid});
    set_member_level(league_id,old,tolvl);
  }

  if (!remove_a_member(league_id,mid))
    return "没有发现联盟有这个成员。\n";

  pname = who->query("name");
  who->delete("league");
  weiwang = who->query("weiwang");
  if (weiwang < 1000)
    who->delete("weiwang");
  else
    who->add("weiwang",-1000);
  channels = who->query("channels");
  if (arrayp(channels) &&
      sizeof(channels) > 1 &&
      member_array("inter", channels) != -1)
    channels -= ({ "inter" });
  who->set("channels", channels);
  who->save();
  UPDATE_D->global_destruct_player(who, 1);
  add_fame(league_id, -weiwang/8000);
  message_league(league_id,sprintf("%s把%s开除了，今后%s不再是本联盟的成员。\n",
                                   HIY + me->query("name") + NOR,
                                   HIR + pname + NOR,
                                   HIR + pname + NOR));
  message_league_public(sprintf("听说%s被「%s」的%s开除了。\n",
                                HIY + pname + NOR,
                                HIG + query_league_cname(league_id)+NOR,
                                HIY + me->query("name") + NOR));
  return sprintf("你把%s开除出了联盟。\n",pname);
}

public string leave_league(object me)
{
  int weiwang;
  string league_id;
  string id;
  int mylvl;
  string *old,*channels;
  if (!playerp(me))
    return "";
  id = me->query("id");
  league_id = query_player_league_id(me);
  if (!stringp(league_id))
    return "你先自己加入一个联盟再说吧！\n";
  if (query_league_leader(league_id) == id)
  {
    dismiss_league(league_id);
    return "解散了联盟。\n";
  }

  mylvl = query_member_level(me);
  if (mylvl > 0)
  {
    old = query_league_member_level(league_id, mylvl);
    old -= ({id});
    set_member_level(league_id,old,mylvl);
  }

  if (!remove_a_member(league_id,id))
    return "你是联盟的成员吗？。\n";
  me->delete("league");
  weiwang = me->query("weiwang");
  if (weiwang < 1000)
    me->delete("weiwang");
  else
    me->add("weiwang",-1000);
  channels = me->query("channels");
  if (arrayp(channels) &&
      sizeof(channels) > 1 &&
      member_array("inter", channels) != -1)
    channels -= ({ "inter" });
  me->set("channels", channels);
  me->save();
  add_fame(league_id, -weiwang/8000);
  message_league(league_id,sprintf("%s决定离开联盟，今后%s不再是本联盟的成员。\n",
                                   HIY + me->query("name") + NOR,
                                   HIY + me->query("name") + NOR));
  message_league_public(sprintf("听说%s离开了联盟%s。\n",
                                HIY + me->query("name") + NOR,
                                HIG + (string)query_league_cname(league_id)+NOR));
  return "你把决定脱离联盟。\n";
}

public int add_member_into_league(object ob, object me)
{
  int weiwang,mylvl;
  string league_id;
  string id;
  mapping myleague;
  string *channels;

  if (!playerp(me) || !playerp(ob))
    return 0;

  league_id = query_player_league_id(me);
  if (!stringp(league_id))
    return 0;

  mylvl = query_member_level(me);

  if (!mylvl)
    return 0;

  id = ob->query("id");
  weiwang = (int)ob->query("weiwang");
  myleague = ob->query("league");
  if (mapp(myleague) && sizeof(myleague) > 1)
    return 0;

  if (stringp(query_player_league_id(ob)))
    return 0;
  if (!add_member(league_id,id))
    return 0;

  add_fame(league_id, weiwang/10000);
  ob->set("league/league_id",league_id);
  ob->set("league/league_name",(string)query_league_cname(league_id));
  ob->set("league/time",time());
  ob->set("league/leader_id",(string)query_league_leader(league_id));
  ob->set("league/leader_name",(string)query_league_leader_name(league_id));
  channels = ob->query("channels");
  if (! arrayp(channels) || ! sizeof(channels))
    channels = ({ "inter" });
  else if (member_array("inter", channels) == -1)
    channels += ({ "inter" });
  ob->set("channels", channels);
  ob->save();
  message_league(league_id,sprintf("欢迎%s加入联盟。\n",ob->query("name")));
  message_league_public(sprintf("听说%s加入联盟%s。\n",
                                ob->query("name"),
                                (string)query_league_cname(league_id)));

  return 1;
}

public string league_info(object ob, string arg)
{
  int i;
  string league_id, type,msg;
  string *kll;
  string cname,build;
  if (!playerp(ob))
    return 0;
  if (!arg)
  {
    if (!wizardp(ob))
    {
      league_id = query_player_league_id(ob);
      if (!stringp(league_id))
        return "你现在不属于任何联盟。\n";
    }

    else
    {
      league_id = "all";
      type = "all";
    }

  }

  else if (!wizardp(ob))
  {
    league_id = query_player_league_id(ob);
    if (!stringp(league_id))
      return "你只能查看自己所在联盟的信息。\n";
    type = arg;
  }

  else
  {
    if (sscanf(arg,"%s %s",league_id, type) != 2)
      return "league info [联盟id] [查看数据类型]\n";
  }

  msg = "";
  if (league_id == "all")
  {
    kll = query_league_list();
    if (sizeof(kll) < 1)
      return "江湖中没有任何联盟。\n";
    msg = "◎翱翔天际之江湖联盟◎\n";
    msg += "┏━━━━┓━━━━━┓━━━━┓━━━━━┓━━━━┓━━┓━━┓\n";
    msg += "┃联盟    ┃联盟名    ┃声望    ┃持有金    ┃盟主    ┃成员┃自建┃\n";
    msg += "┗━━━━┛━━━━━┛━━━━┛━━━━━┛━━━━┛━━┛━━┛\n";
    foreach (league_id in kll)
    {
      cname = (string)query_league_cname(league_id);
      if (stringp(query_league_directory(league_id)))
        build = "Y";
      else
        build = "N";
      msg += sprintf("┃%-8s┃%-"+(10+color_len(cname))+"s┃%-8d┃%-10d┃%-8s┃%-4d┃%-4s┃\n",
                     league_id,
                     cname,
                     query_league_fame(league_id),
                     query_league_gold(league_id),
                     query_league_leader(league_id),
                     sizeof(query_league_member(league_id)),
                     build);
    }

    msg += "┗━━━━┛━━━━━┛━━━━┛━━━━━┛━━━━┛━━┛━━┛\n";
    return msg;
  }

  if (!is_league_id(league_id))
    return "江湖中并没有这个联盟。\n";
  cname = (string)query_league_cname(league_id);
  if (stringp(query_league_directory(league_id)))
    build = "Y";
  else
    build = "N";
  msg = "◎翱翔天际之江湖联盟 → " + cname + "：" + league_id + "\n";
  if (type == "all")
  {
    if (stringp(query_league_directory(league_id)))
      build = "Y";
    else
      build = "N";
    msg += "┏━━━━┓━━━━┓━━━━━┓━━━━┓━━━━┓━━┓━━┓━━┓\n";
    msg += "┃盟主    ┃声望    ┃持有金    ┃借款利率┃占有城市┃同盟┃敌对┃自建┃\n";
    msg += "┗━━━━┛━━━━┛━━━━━┛━━━━┛━━━━┛━━┛━━┛━━┛\n";
    msg += sprintf("┃%-8s┃%-8d┃%-10d┃%-8d┃%-8d┃%-4d┃%-4d┃%-4s┃\n",
                  query_league_leader(league_id),
                  query_league_fame(league_id),
                  query_league_gold(league_id),
                  query_league_rate(league_id),
                  sizeof(query_league_city(league_id)),
                  sizeof(query_league_alley(league_id)),
                  sizeof(query_league_enemy(league_id)),
                  build);
    msg += "┗━━━━┛━━━━┛━━━━━┛━━━━┛━━━━┛━━┛━━┛━━┛\n";
    return msg;
  }

  if (type != "borrower" &&
      type != "city" &&
      type != "alley" &&
      type != "enemy" &&
      type != "relaion" &&
      type != "wantkill")
    return "你可以查看的资料类型有：\n" +
           "\tborrower 借款人信息。\n" +
           "\tcity     联盟占有城市信息。\n" +
           "\talley    联盟结盟信息。\n" +
           "\tenemy    联盟敌对信息。\n" +
           "\trelation 联盟和其他联盟的关系详细信息。\n" +
           "\twantkill 联盟追杀名单。";

  if (type == "borrower" &&
      (query_member_level(ob) == 0 ||
       query_member_level(ob) > 2))
  {
    string gold,b_t,b_limit;
    gold = sprintf("%d",query_league_borrow_gold(ob));
    b_t = query_league_borrow_time(ob);
    b_limit = query_league_borrow_limit(ob);
    if (!stringp(gold) || !stringp(b_t) || !stringp(b_limit))
      return "你当前没有借款纪录。\n";
    msg = "你的借款情况如下：\n";
    msg += "借款金额：" + gold + "\n";
    msg += "借款时间：" + b_t + "\n";
    msg += "借款年限：" + b_limit + "\n";
    return msg;
  }

  if (type == "borrower")
  {
    mapping borrow;
    string *kb;
    borrow = query_league_borrower(league_id);
    if (!mapp(borrow) || sizeof(borrow) < 1)
      return "联盟没有任何借款信息。\n";
    kb = keys(borrow);
    msg = "◎翱翔天际之江湖联盟 → " + cname + "借款信息：\n";
    msg += "┏━━━━┓━━━━┓━━━━━━━━━━━━━━┓━━━━┓\n";
    msg += "┃借款人  ┃借款金额┃借款时间                    ┃借款月限┃\n";
    msg += "┗━━━━┛━━━━┛━━━━━━━━━━━━━━┛━━━━┛\n";
    for (i=0;i<sizeof(kb);i++)
    {
      msg += sprintf("┃%-8s┃-8d┃%-28s┃%-8s┃\n",
                     kb[i],
                     borrow[kb[i]]["money"],
                     query_league_borrow_time(kb[i]),
                     query_league_borrow_limit(kb[i]));
    }

    msg += "┗━━━━┛━━━━┛━━━━━━━━━━━━━━┛━━━━┛\n";
    return msg;
  }

  if (type == "city")
  {
    mapping city;
    string *kc;
    city = query_league_city(league_id);
    if (!mapp(city) || sizeof(city) < 1)
      return "目前你所在的联盟没有在任何城市拥有占有率。\n";
    msg = "◎翱翔天际之江湖联盟 → " + cname + "城市占有情况：\n";
    msg += "┏━━━━┓━━━━━┓━━━━┓━━━┓\n";
    msg += "┃城市名  ┃城市代号  ┃城市地区┃占有率┃\n";
    msg += "┗━━━━┛━━━━━┛━━━━┛━━━┛\n";
    kc = keys(city);
    for (i=0;i<sizeof(kc);i++)
    {
      msg += sprintf("┃%-8s┃%-10s┃%-8s┃%-6d┃\n",
                     to_chinese(kc[i]),
                     kc[i],
                     GOODS_D->query_city_zone_c(kc[i]),
                     city[kc[i]]);
    }

    msg += "┗━━━━┛━━━━━┛━━━━┛━━━┛\n";
    return msg;
  }

  if (type == "alley")
  {
    string a_name, *alley;
    alley = query_league_alley(league_id);
    if (!mapp(alley) || sizeof(alley) < 1)
      return "你所在的联盟没有任何盟友。\n";
    msg = "◎翱翔天际之江湖联盟 → " + cname + "结盟情况：\n";
    msg += "┏━━━━┓━━━━━┓━━━━┓━━━━┓━━━┓\n";
    msg += "┃联盟    ┃联盟名    ┃盟主    ┃声望    ┃友好度┃\n";
    msg += "┗━━━━┛━━━━━┛━━━━┛━━━━┛━━━┛\n";
    for (i=0;i<sizeof(alley);i++)
    {
      a_name = (string)query_league_cname(alley[i]);
      msg += sprintf("┃%-8s┃%-"+(10+color_len(a_name))+"s┃%-8s┃%-8d┃%-6d┃\n",
                     alley[i],
                     a_name,
                     query_league_leader(alley[i]),
                     query_league_fame(alley[i]),
                     query_league_relation_league2(league_id,alley[i]));
    }

    msg += "┗━━━━┛━━━━━┛━━━━┛━━━━┛━━━┛\n";
    return msg;
  }

  if (type == "enemy")
  {
    string e_name, *enemy;
    enemy = query_league_enemy(league_id);
    if (!mapp(enemy) || sizeof(enemy) < 1)
      return "你所在的联盟没有任何敌对联盟。\n";
    msg = "◎翱翔天际之江湖联盟 → " + cname + "敌对联盟情况：\n";
    msg += "┏━━━━┓━━━━━┓━━━━┓━━━━┓━━━┓\n";
    msg += "┃联盟    ┃联盟名    ┃盟主    ┃声望    ┃友好度┃\n";
    msg += "┗━━━━┛━━━━━┛━━━━┛━━━━┛━━━┛\n";
    for (i=0;i<sizeof(enemy);i++)
    {
      e_name = (string)query_league_cname(enemy[i]);
      msg += sprintf("┃%-8s┃%-"+(10+color_len(e_name))+"s┃%-8s┃%-8d┃%-6d┃\n",
                     enemy[i],
                     e_name,
                     query_league_leader(enemy[i]),
                     query_league_fame(enemy[i]),
                     query_league_relation_league2(league_id,enemy[i]));
    }

    msg += "┗━━━━┛━━━━━┛━━━━┛━━━━┛━━━┛\n";
    return msg;
  }

  if (type == "relation")
  {
    mapping r_leag;
    string r_name,*kr;
    r_leag = query_league_relation(league_id);
    if (!mapp(r_leag) || sizeof(r_leag) < 1)
      return "你所在的联盟和其他联盟处于一般关系状态。\n";
    msg = "◎翱翔天际之江湖联盟 → " + cname + " 和其他联盟关系情况：\n";
    msg += "┏━━━━┓━━━━━┓━━━━┓━━━━┓━━━┓\n";
    msg += "┃联盟    ┃联盟名    ┃盟主    ┃声望    ┃友好度┃\n";
    msg += "┗━━━━┛━━━━━┛━━━━┛━━━━┛━━━┛\n";
    kr = keys(r_leag);
    for (i=0;i<sizeof(kr);i++)
    {
      r_name = (string)query_league_cname(kr[i]);
      msg += sprintf("┃%-8s┃%-"+(10+color_len(r_name))+"s┃%-8s┃%-8d┃%-6d┃\n",
                     kr[i],
                     r_name,
                     query_league_leader(kr[i]),
                     query_league_fame(kr[i]),
                     query_league_relation_league2(league_id,kr[i]));
    }

    msg += "┗━━━━┛━━━━━┛━━━━┛━━━━┛━━━┛\n";
    return msg;
  }

  if (type == "wantkill")
  {
    mapping wantkill;
    string *kwk;
    wantkill = query_league_want_kill(league_id);
    if (!mapp(wantkill) || sizeof(wantkill) < 1)
      return "目前没有任何人被列入追杀名单。\n";
    msg = "◎翱翔天际之江湖联盟 → " + cname + "追杀名单：\n";
    kwk = keys(wantkill);
    for (i=0;i<sizeof(kwk);i++)
    {
      msg += kwk[i] + "\t";
      if (i>0 && i%3==0)
        msg += "\n";
    }

    msg += "\n";
    return msg;
  }

  return msg;
}

public string league_member(object ob, string arg)
{
  int i,j;
  string league_id, msg;
  string *member, *member_lvl;
  string leader;
  object user;

  if (!playerp(ob))
    return 0;

  if (!wizardp(ob))
  {
    league_id = query_player_league_id(ob);
    if (!stringp(league_id))
      return "你现在不属于任何联盟。\n";
  }

  else if (!arg)
    return "你要查看哪个联盟的信息。\n";
  else
    league_id = arg;
  if (!is_league_id(league_id))
    return "江湖中没有 " + league_id + " 这个联盟。\n";

  leader = query_league_leader(league_id);
  member = query_league_member(league_id);
  if (!arrayp(member) || sizeof(member) < 1 || !stringp(leader))
    return "江湖中这个联盟不存在了。\n";

  user = UPDATE_D->global_find_player(leader);
  if (! objectp(user))
    return "江湖中这个联盟的盟主不在了，联盟因此解散。\n";

  msg = sprintf("◎翱翔天际之江湖联盟◎ → %s(%s)\n",
                query_league_cname(league_id),
                league_id);
  msg += "====\n";
  msg += sprintf("盟主：\n\t%s(%s)\n",user->short(1),leader);
  msg += "====\n";
  UPDATE_D->global_destruct_player(user);
  member -= ({leader});
  for (i=1;i<=4;i++)
  {
    msg += sprintf("等级%s成员：\n",chinese_number(i));
    member_lvl = query_league_member_level(league_id,i);
    if (!arrayp(member_lvl) || sizeof(member_lvl) < 1)
    {
      msg += "\t空缺。\n";
      msg += "====\n";
      continue;
    }

    for (j=0;j<sizeof(member_lvl);j++)
    {
      member -= ({member_lvl[j]});
      user = UPDATE_D->global_find_player(member_lvl[j]);
      if (! objectp(user))
        continue;
      msg += sprintf("\t%-8s:%-6d\n",
                     member_lvl[j],
                     (int)user->query("league/league_faith"));
      UPDATE_D->global_destruct_player(user);
    }

    msg += "====\n";
  }

  if (sizeof(member) < 1)
    return msg;
  msg += "普通成员：\n";
  for (i=0;i<sizeof(member);i++)
  {
    user = UPDATE_D->global_find_player(member[i]);
    if (! objectp(user))
      continue;
    msg += sprintf("\t%-8s:%-6d\n",
                   member[i],
                   (int)user->query("league/league_faith"));
    UPDATE_D->global_destruct_player(user);
  }

  msg += "====\n";
  return msg;
}

public string accept_gold(object who,string arg)
{
  string league_id;
  int value,balance,faith;
  string help_msg = "league donate [all]  捐献全部的存款给联盟。\n"
                    "league donate [half] 捐献全部的存款的一半给联盟。\n"
                    "league donate [数目] 捐献指定数目的存款给联盟。\n"
                    "注意：捐献的最小单位是金子。\n";
  if (!playerp(who))
    return "";

  if (!arg)
    return help_msg;
  value = to_int(arg);
  if (!value && arg != "all" && arg != "half")
    return help_msg;

  league_id = query_player_league_id(who);
  if (!stringp(league_id))
    return "你现在不属于任何联盟。\n";
  balance = (int)who->query("balance");
  if (balance < 100000)
    return "你的存款不足10GOLD，也想捐钱？\n";

  if (arg == "all")
    value = balance/10000;
  else if (arg == "half")
    value = balance/20000;
  if (value < 10 || value > 10000)
    return "请检查自己的存款。捐献的金子必须是10-10000GOLD。\n";
  if (balance < value*10000)
    return "你没有那么多存款。\n";
  add_gold(league_id, value*98/100);
  who->add("balance",-value*10000);
  who->add("league/league_donation",value);
  faith = value/100;
  if (faith > 0)
    who->add("league/league_faith",faith);
  who->save();
  message_league(league_id,sprintf("听说%s捐献给了联盟%d两金子。\n",who->query("name"),value));
  log_file("league_donate",sprintf("%s donate %d for %s at %s!\n",
                                    who->query("id"),
                                    value,
                                    league_id,
                                    ctime(time())));
  return sprintf("%s捐献给了联盟%d金子。联盟贡献增加：%d点。\n",
                  who->query("name"),
                  value,
                  faith);
}

public string give_member_gold(object who,string arg)
{
  string id,league_id;
  int lvl,value,max_value,faith;
  object ob;
  string help_msg = "league reward [成员id] [数目] 联盟给成员指定的金子数目。\n";

  if (!playerp(who))
    return "";

  if (!arg || sscanf(arg,"%s %d",id,value) != 2)
    return help_msg;

  league_id = query_player_league_id(who);
  if (!stringp(league_id))
    return "你现在不属于任何联盟。\n";
  lvl = query_member_level(who);
  if (!lvl)
    return "你没有权利处理联盟的金子。\n";
  if (!stringp(id) || !is_league_member(id,league_id))
    return "联盟没有这个成员。\n";
  if (value < 1)
    return "不要开玩笑。\n";
  if (lvl == -1)
    max_value = 1000;
  else if (lvl > 0 && lvl < 5)
    max_value = 1000/(2*lvl);
  if (value > max_value)
    return sprintf("你当前能够给出的金子数目是：%d\n",max_value);
  ob = find_player(id);
  if (!objectp(ob))
    return "很遗憾，这个玩家不在线。\n";
  faith = (int)ob->query("league/league_faith");
  if (value > 10*faith)
    return sprintf("%s只能从联盟获得%d两金子的帮助。能够获得的最大帮助是联盟贡献的10倍。\n",
                  ob->query("name"),
                  10*faith);
  add_gold(league_id, -value);
  ob->add("balance",value*9500);
  ob->add("league/league_accept",value);
  ob->save();
  message_league(league_id,sprintf("听说%s以联盟的名义，给了%s%d两金子的帮助。\n",
                                    who->query("name"),
                                    ob->query("name"),
                                    value));
  return sprintf("你给了联盟成员%s%d两金子予以帮助。\n",ob->query("name"),value);
}

public string grant_member(mixed ob, object master, int lvl)
{
  string mid, *old1, *old2;
  string league_id;
  object who;
  int old_lvl, master_lvl;
  int *limit = ({MAX_L1_MEMBER,
                 MAX_L2_MEMBER,
                 MAX_L3_MEMBER,
                 MAX_L4_MEMBER});

  if (!playerp(master))
    return "";

  if (lvl < 0 || lvl > 4)
    return "等级从1到4，数字越高等级越低。\n"
           "注意：0表示普通联盟成员。\n";

  league_id = query_player_league_id(master);
  if (!stringp(league_id))
    return "你不是任何联盟的成员。\n";
  if (!is_league_member(ob,league_id))
    return "你的联盟没有这个成员。\n";
  master_lvl = (int)query_member_level(master);
  if (!master_lvl || master_lvl > 3)
    return "你好象没有权利改变任何联盟成员的等级。\n";

  if (stringp(ob))
  {
    mid = ob;
    who = find_player(ob);
  }

  else if (objectp(ob))
  {
    mid = ob->query("id");
    who = ob;
  }

  else
    return 0;
  if (!playerp(who) || !stringp(mid))
    return "有这个玩家吗？或者这个玩家目前不在线。\n";

  old_lvl = (int)query_member_level(who);

  if (old_lvl && master_lvl >= old_lvl)
    return sprintf("%s的联盟等级不比你低，你无法改变他的等级状况。\n",who->query("name"));

  if (lvl && master_lvl >= lvl)
    return sprintf("你目前的联盟等级，不足以改变别人的等级到等级%s。\n",chinese_number(lvl));
  if (!lvl && master_lvl > 2)
    return "你当前的联盟等级，不足以剥夺其他成员的等级权利。\n";

  if (old_lvl>0)
    old1 = query_league_member_level(league_id, old_lvl);
  else
    old1 = ({});
  if (lvl > 0)
    old2 = query_league_member_level(league_id, lvl);
  else
    old2 = ({});

  if (lvl>0 &&
      sizeof(old2) >= limit[lvl-1])
    return sprintf("联盟等级%s的成员满了。本次操作失败了。\n",chinese_number(lvl));
  if (member_array(mid,old2) != -1)
    return sprintf("%s已经是等级%s的成员了。\n",who->query("name"),chinese_number(lvl));
  old2 += ({mid});
  if (!set_member_level(league_id,old2,lvl))
    return "本次操作失败了。\n";
  if (old_lvl > 0)
  {
    old1 -= ({mid});
    set_member_level(league_id,old1,old_lvl);
  }

  message_league(league_id,sprintf("%s改变了%s的联盟等级，当前%s的联盟等级为：%s。\n",
                                   master->query("name"),
                                   who->query("name"),
                                   who->query("name"),
                                   (lvl>0) ? chinese_number(lvl) : "普通成员"));
  return sprintf("你成功的改变了%s的联盟等级。\n",who->query("name"));
}

public int add_new_alley(string league_id,string alley)
{
  string *old1, *old2;

  if (!is_league_id(league_id) ||
      !is_league_id(alley))
    return 0;
  if (is_alley(league_id,alley))
    return 0;
  if (is_enemy(league_id,alley))
    return 0;
  if (query_league_relation_league2(league_id, alley) < 80 ||
      query_league_relation_league2(alley,league_id) < 80)
    return 0;

  old1 = query_league_alley(league_id);
  old2 = query_league_alley(alley);
  if (!arrayp(old1))
    old1 = ({});
  if (!arrayp(old2))
    old2 = ({});
  old1 += ({alley});
  old2 += ({league_id});
  set_alley(league_id,old1);
  set_alley(alley,old2);
  add_relation_number(league_id,alley,5);
  add_relation_number(alley,league_id,5);
  message_league(league_id,sprintf("从现在起，和联盟 %s 成为同盟关系。\n",
                 (string)query_league_cname(alley)));
  message_league(alley,sprintf("从现在起，和联盟 %s 成为同盟关系。\n",
                 (string)query_league_cname(league_id)));
  message_league_public(sprintf("听说%s和%s结盟了。\n",
                       (string)query_league_cname(league_id),
                       (string)query_league_cname(alley)));
  return 1;
}

public string remove_a_alley(string league_id, string alley)
{
  string *old1, *old2;

  if (!is_league_id(league_id) ||
      !is_league_id(alley))
    return "没有这个联盟。\n";
  if (!is_alley(league_id,alley))
    return "双方并不是盟友！\n";
  old1 = query_league_alley(league_id);
  old2 = query_league_alley(alley);
  if (!arrayp(old1) || sizeof(old1) < 1 ||
      !arrayp(old2) || sizeof(old2) < 1)
    return "双方没有结盟关系！\n";
  if (member_array(alley,old1) == -1 ||
     member_array(league_id,old2) == -1)
    return "双方还没有结盟呢！\n";
  old1 -= ({alley});
  old2 -= ({league_id});
  set_alley(league_id,old1);
  set_alley(alley,old2);
  add_relation_number(league_id,alley,-10);
  add_relation_number(alley,league_id,-10);
  message_league(league_id,sprintf("从现在起，和联盟 %s 的同盟关系终止，不再和他们是盟友。\n",
                 (string)query_league_cname(alley)));
  message_league(alley,sprintf("联盟 %s 撕毁了结盟协议，和他们的同盟关系终止，不再和他们是盟友。\n",
                 (string)query_league_cname(league_id)));
  message_league_public(sprintf("听说%s和%s双方的盟约关系被%s解除了。\n",
                       (string)query_league_cname(league_id),
                       (string)query_league_cname(alley),
                       (string)query_league_cname(league_id)));
  return "双方的盟约解除了。\n";
}

public string add_new_enemy(string league_id,string enemy)
{
  string *old1, *old2;

  if (!is_league_id(league_id) ||
      !is_league_id(enemy))
    return "没有这个联盟。\n";
  if (is_enemy(league_id,enemy))
    return "双方已经是敌对关系了！\n";
  if (is_alley(league_id,enemy))
    return "双方目前是结盟关系了，请先解除双方结盟关系！\n";
  old1 = query_league_enemy(league_id);
  old2 = query_league_enemy(enemy);
  if (!arrayp(old1))
    old1 = ({});
  if (!arrayp(old2))
    old2 = ({});
  old1 += ({enemy});
  old2 += ({league_id});
  set_alley(league_id,old1);
  set_alley(enemy,old2);
  add_relation_number(league_id,enemy,-30);
  add_relation_number(enemy,league_id,-30);
  message_league(league_id,sprintf("从现在起，和联盟 %s 的关系改变为敌对。\n",
                 (string)query_league_cname(enemy)));
  message_league(enemy,sprintf("从现在起，和联盟 %s 的关系改变为敌对。\n",
                 (string)query_league_cname(league_id)));
  message_league_public(sprintf("听说%s和%s双方的互为敌对了。\n",
                       (string)query_league_cname(league_id),
                       (string)query_league_cname(enemy)));
  return "从现在起，双方是敌对关系了。\n";
}

public int remove_a_enemy(string league_id, string enemy)
{
  string *old1, *old2;

  if (!is_league_id(league_id) ||
      !is_league_id(enemy))
    return 0;
  if (!is_enemy(league_id,enemy))
    return 0;
  old1 = query_league_enemy(league_id);
  old2 = query_league_enemy(enemy);
  if (!arrayp(old1) || sizeof(old1) < 1 ||
      !arrayp(old2) || sizeof(old2) < 1)
    return 0;
  if (member_array(enemy,old1) == -1 ||
     member_array(league_id,old2) == -1)
    return 0;
  old1 -= ({enemy});
  old2 -= ({league_id});
  set_alley(league_id,old1);
  set_alley(enemy,old2);
  add_relation_number(league_id,enemy,5);
  add_relation_number(enemy,league_id,5);
  message_league(league_id,sprintf("从现在起，和联盟 %s 的敌对关系结束了。\n",
                 (string)query_league_cname(enemy)));
  message_league(enemy,sprintf("从现在起，和联盟 %s 的敌对关系结束了。\n",
                 (string)query_league_cname(league_id)));
  message_league_public(sprintf("听说%s和%s双方的敌对关系结束了。\n",
                       (string)query_league_cname(league_id),
                       (string)query_league_cname(enemy)));
  return 1;
}

public string add_new_want_kill(string league_id,mixed ob)
{
  string mid, lid;
  object who;
  mapping old;
  string *kwk;

  if (!is_league_id(league_id))
    return "只有联盟成员才能发出追杀命令。\n";
  if (stringp(ob))
  {
    mid = ob ;
    who = find_player(ob);
  }

  else if (objectp(ob))
  {
    mid = ob->query("id");
    who = ob;
  }

  else
    return "要对谁发出追杀令？\n";
  if (!objectp(who) || !stringp(mid))
    return "要对谁发出追杀令？\n";

  lid = query_player_league_id(who);
  if (lid == league_id)
    return who->query("name") + "是本联盟的成员。\n";
  if (is_alley(league_id,lid))
    return who->query("name") + "是盟友" + lid + "的成员，无法直接追杀！\n";

  old = query_league_want_kill(league_id);
  if (!mapp(old))
    old = ([]);
  kwk = keys(old);
  if (member_array(mid,kwk) != -1)
    return who->query("name") + "已经被联盟追杀了！\n";
  old += ([mid : time()]);
  set_want_kill(league_id,old);
  message_league(league_id,sprintf("联盟颁发了对%s的追杀命令。\n",
                 who->query("name")));
  message_league_public(sprintf("听说联盟%s颁发了对%s的追杀命令。看来江湖不再平静了。\n",
                       (string)query_league_cname(league_id),
                       who->query("name")));
  return "联盟从现在起，追杀" + who->query("name") + "。\n";
}

public string remove_a_want_kill(string league_id, mixed ob)
{
  string mid, *kwk;
  object who;
  mapping old;

  if (!is_league_id(league_id))
    return "只有联盟成员才可以取消追杀令。\n";
  if (stringp(ob))
  {
    mid = ob ;
    who = find_player(ob);
  }

  else if (objectp(ob))
  {
    mid = ob->query("id");
    who = ob;
  }

  else
    return "要取消对谁的追杀？\n";
  if (!objectp(who) || !stringp(mid))
    return "要取消对谁的追杀？\n";

  old = query_league_want_kill(league_id);
  if (!mapp(old) || sizeof(old) < 1)
    return "当前联盟没有发出任何追杀令。\n";
  kwk = keys(old) - ({0});
  if (member_array(mid,kwk) == -1)
    return who->query("name") + "并没有被联盟追杀了！\n";
  map_delete(old,mid);
  set_want_kill(league_id,old);
  message_league(league_id,sprintf("联盟取消了对%s的追杀命令。\n",
                 who->query("name")));
  message_league_public(sprintf("听说联盟%s取消了对%s的追杀命令。\n",
                       (string)query_league_cname(league_id),
                       who->query("name")));
  return "联盟从现在起，不再追杀" + who->query("name") + "。\n";
}

public int get_help(object me)
{
  string msg;

  if (!playerp(me))
    return 0;
  msg = "联盟命令帮助如下：\n";
  msg += "命令格式：league [命令] [参数]\n";
  msg += "命令列表已经命令说明如下：\n";
  msg += "info 查看联盟信息。\n";
  msg += "member 查看联盟成员。\n";
  msg += "add 联盟增加一个成员。只有联盟盟主或者等级成员才可以接受新成员。\n";
  msg += "expell 开除一个联盟成员。只能开除等级在自己之下的成员。\n";
  msg += "leave 离开联盟。盟主无法离开联盟。\n";
  msg += "grant 改变某个成员在联盟中的等级。联盟中有个四个等级成员。\n";
  msg += "      等级一成员拥有的权利仅仅比盟主小。每个联盟只能有两名等级一成员。\n";
  msg += "      每个联盟只能有四名等级二成员。\n";
  msg += "      每个联盟只能有八名等级三成员。\n";
  msg += "      每个联盟只能有十六名等级四成员。\n";
  msg += "donate 联盟成员把自己的存款捐献给联盟。捐献的金额最小为10金子。\n";
  msg += "       捐献的成员获的一定的联盟忠诚度。系统抽取2%作为手续费用。\n";
  msg += "reward 联盟给成员一笔金子作为奖励或者帮助。\n";
  msg += "       盟主可以一次性支配的金子额度：1000，其他等级成员依次减少。\n";
  msg += "       接受金子的成员，根据联盟贡献度，可以接受的额度不同。一点忠诚度，可以接受10金子。\n";
  msg += "       系统抽取5%的金子作为手续费用。\n";
  msg += "alley 和其他联盟结成盟友关系。只有盟主可以操作。\n";
  msg += "alley -abolish 终止和其他联盟的盟友关系。只有盟主可以操作。\n";
  msg += "enemy 和其他联盟处于敌对关系。只有盟主可以操作。\n";
  msg += "enemy -end 终止和其他联盟的敌对关系。只有盟主可以操作。\n";
  msg += "wantkill 发出联盟追杀命令，追杀某个玩家。只有盟主可以操作。\n";
  msg += "wantkill -cancel 撤销对某个玩家发出的联盟追杀令。只有盟主可以操作。\n";
  me->start_more(msg);
  return 1;
}

