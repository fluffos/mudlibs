public int is_alley(string lid1, string lid2)
{
  string *alley1 = query_league_alley(lid1);
  string *alley2 = query_league_alley(lid2);

  return ((member_array(lid2,alley1) != -1) &&
         (member_array(lid1,alley2) != -1));
}

