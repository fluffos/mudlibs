//         "cname"     : 中文名称,
//         "member"    : ({成员id}),
//         "leader_id" : 盟主id,
//         "level1"    : ({等级一成员}),
//         "level2"    : ({等级二成员}),
//         "level3"    : ({等级三成员}),
//         "level4"    : ({等级四成员}),
//         "fame"      :  联盟威望,
//         "gold"      :  联盟金额,
//         "rate"      :  联盟借款利率,
//         "borrower"  :
//                  (["借款人id" : ([
//                        "money" : 借款金额,
//                        "time" : 借款时间,
//                        "limit" : 借款年限,
//                    ]),
//                  ]),
//         "city"      :
//               ([地盘id :  占有率,
//               ]),
//         "alley"     :  ({同盟}),
//         "enemy"     :  ({敌对同盟}),
//         "relation" :
//               ([联盟id : 关系度]),
//         "want_kill" :  ([id : time]),
//         "status"    :  "normal" or "alarm" or "war",
//         "directory" : "/d/league/" + 联盟id + "/",  联盟自有地盘目录
//         "home_tax"  : 自有地盘税率
//         "home_develop" : 自有地盘开发度
//         "home_defend"  : 联盟自有地盘防御度
//         "home_invote"  : 联盟自有地盘投资额度
//         "home_people"  : 联盟自有地盘人口总数
//         "home_merchant_rate" : 联盟自有地盘人口中商人比例
//         "home_miner_rate"    : 联盟自有地盘人口中采矿比例
//         "home_lumber_rate"   : 联盟自有地盘人口中伐木工人比例
//         "home_quarrier_rate" : 联盟自有地盘人口中采石工人比例
//         "home_mine"    : 联盟自有地盘矿石持有量
//         "home_wood"    : 联盟自有地盘木材持有量
//         "home_stone"   : 联盟自有地盘石料持有量
//         "home_want_mine" : 联盟自有地盘当前需要的矿石量
//         "home_want_wood" : 联盟自有地盘当前需要的木材量
//         "home_want_stone" : 联盟自有地盘当前需要的石头量
//         "home_first_specialty" : 联盟自有地盘特产
//         "home_second_specialty" : 联盟自有地盘特产
//      ]);
