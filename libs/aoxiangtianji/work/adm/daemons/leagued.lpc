}

public mapping query_league_city(string league_id)
{
  mapping league_info = query_league_info(league_id);
  return mapp(league_info["city"]) ? league_info["city"] : ([]);
}

public mapping query_city_occupy(string city)
{
  mapping lc = ([]);
  mapping lcinfo;
  int i;
  string *kl, *ll = query_league_list();

  for (i=0;i<sizeof(ll);i++)
  {
    lcinfo = query_league_city(ll[i]);
    if (!mapp(lcinfo) || sizeof(lcinfo) < 1)
      continue;
    kl = keys(lcinfo) - ({0});
    if (member_array(city,kl) != -1)
    {
      lc += ([
              ll[i] : lcinfo[city]
            ]);
    }

  }

  return lc;
}

public int query_league_occupy_city(string league_id,string city)
{
  mapping lcinfo = query_league_city(league_id);

  if (!mapp(lcinfo))
    return 0;
  return (int)lcinfo[city];
}

