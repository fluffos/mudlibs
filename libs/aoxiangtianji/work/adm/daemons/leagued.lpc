public mapping query_player_league_loan(mixed ob)
{
  mapping my_league = query_player_league_info(ob);
  if (!mapp(my_league) ||
      sizeof(my_league) < 1 ||
      !mapp(my_league["borrower"]) ||
      sizeof(my_league["borrower"]) < 1)
    return ([]);
  if (stringp(ob))
  {
    if (!mapp(my_league["borrower"][ob]))
      return ([]);
    return my_league["borrower"][ob];
  }

  if (!mapp(my_league["borrower"][ob->query("id")]))
    return ([]);
  return mapp(my_league["borrower"][ob->query("id")]) ?
         my_league["borrower"][ob->query("id")] : ([]);
}

