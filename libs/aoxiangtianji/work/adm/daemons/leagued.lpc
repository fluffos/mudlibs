void create()
{
  seteuid(getuid());
  restore();
  if (! mapp(league_total) || sizeof(league_total) < 1)
    league_total = ([ ]);
}

void remove()
{
  save();
}

public void mud_shutdown()
{
  save();
}

public string query_save_file()
{
  return DATA_DIR "leagued";
}

public void message_league_public(string msg)
{
  message("league", HIY"【联盟传闻】："NOR + msg + HIY"\n"NOR, users());
}

public void message_league(string league_id,string msg)
{
  string m_id, *mem;
  object ob, *member = ({});
  if (!is_league_id(league_id))
    return;
  mem = query_league_member(league_id);
  if (!arrayp(mem) || sizeof(mem) < 1)
    return;
  foreach (m_id in mem)
  {
    ob = find_player(m_id);
    if (playerp(ob))
      member += ({ob});
  }

  message("league", HIY"【联盟信息】："NOR + msg + HIY"\n"NOR, member);
}

// the first part ->
//league query : get league info by other application
//***************************************************
public string *query_league_list()
{
  if (!mapp(league_total) || sizeof(league_total) < 1)
    return ({});
  return keys(league_total) - ({0});
}

public int is_league_id(string league_id)
{
  string *kl = query_league_list();
  if (!arrayp(kl) || sizeof(kl) < 1)
    return 0;
  return (member_array(league_id,kl) != -1);
}

public int is_league_name(string cname)
{
  int i;
  string *kl = query_league_list();

  if (!stringp(cname) || !arrayp(kl) || sizeof(kl) < 1)
    return 0;
  for (i=0;i<sizeof(kl);i++)
  {
    if (league_total[kl[i]]["cname"] == cname)
      break;
  }

  return i < sizeof(kl);
}

public string query_player_league_id(mixed ob)
{
  object who;

  if (stringp(ob))
    who = find_player(ob);
  else if (objectp(ob))
    who = ob;
  else
    return 0;
  if (!objectp(who))
    return 0;
  return who->query("league/league_id");
}

public mapping query_league_info(string league_id)
{
  string *league_list = query_league_list();

  if (!stringp(league_id))
    return ([]);

  if (!arrayp(league_list) ||
      sizeof(league_list) < 1 ||
      member_array(league_id,league_list) == -1)
    return ([]);
  return mapp(league_total[league_id]) ? league_total[league_id] : ([]);
}

public mapping query_player_league_info(mixed ob)
{
  string lid = query_player_league_id(ob);
  return stringp(lid) ? query_league_info(lid) : ([]);
}

public string query_league_cname(string league_id)
{
  mapping league_info = query_league_info(league_id);
  return (string)league_info["cname"];
}

public string *query_league_member(string league_id)
{
  mapping league_info = query_league_info(league_id);
  return arrayp(league_info["member"]) ? league_info["member"] : ({});
}

public int is_league_member(mixed ob, string league_id)
{
  string id;
  string *member = query_league_member(league_id);

  if (objectp(ob))
    id = ob->query("id");
  else if (stringp(ob))
    id = ob;
  else
    return 0;

  if (!arrayp(member) || sizeof(member) < 1)
    return 0;
  return (member_array(id,member) != -1);
}

public string query_league_leader(string league_id)
{
  mapping league_info = query_league_info(league_id);
  return (string)league_info["leader_id"];
}

public string query_league_leader_name(string league_id)
{
  mapping league_info = query_league_info(league_id);
  return (string)league_info["leader_name"];
}

public string* query_league_member_level(string league_id, int lvl)
{
  mapping league_info = query_league_info(league_id);
  return arrayp(league_info["level" + sprintf("%d",lvl)]) ?
         league_info["level" + sprintf("%d",lvl)] : ({});
}

public int query_member_level(mixed ob)
{
  object who;
  string league_id, *lvl_member;
  int i;

  if (stringp(ob))
    who = find_player(ob);
  else if (objectp(ob))
    who = ob;
  else
    return 0;
  if (!playerp(who))
    return 0;

  league_id = query_player_league_id(who);
  if (!stringp(league_id))
    return 0;

  if (query_league_leader(league_id) == who->query("id"))
    return -1;
  for (i=1;i<=4;i++)
  {
    lvl_member = query_league_member_level(league_id,i);
    if (member_array(who->query("id"),lvl_member) != -1)
      break;
  }

  if (i>4)
    i=0;
  return i;
}

