  return value;
}

private int set_city(string league_id,mapping city)
{
  if (!is_league_id(league_id) ||
      !arrayp(city) ||
      sizeof(city) < 1)
    return 0;
  league_total[league_id]["city"] = city;
  save();
  return 1;
}

private int add_new_city(string league_id,string city, int val)
{
  mapping owner_city;

  if (!is_league_id(league_id))
    return 0;
  if (val < 0 || val > 100)
    return 0;
  owner_city = query_league_city(league_id);
  if (!mapp(owner_city))
    owner_city = ([]);
  owner_city += ([city : val]);
  return set_city(league_id,owner_city);
}

private int remove_a_city(string league_id, string city)
{
  mapping owner_city;
  string *kc;

  if (!is_league_id(league_id))
    return 0;
  owner_city = query_league_city(league_id);
  if (!mapp(owner_city))
    owner_city = ([]);
  kc = keys(owner_city) - ({});
  if (!arrayp(kc) || sizeof(kc) < 1 || member_array(city,kc) == -1)
    return 0;
  map_delete(owner_city,city);
  return set_city(league_id,owner_city);
}

public int add_a_city_rate(string league_id, string city,int val)
{
  mapping owner_city;
  string *kc;

  if (!is_league_id(league_id))
    return 0;
  owner_city = query_league_city(league_id);
  if (!mapp(owner_city))
    owner_city = ([]);
  kc = keys(owner_city) - ({0});
  if (!arrayp(kc) || sizeof(kc) < 1 || member_array(city,kc) == -1)
  {
    add_new_city(league_id,city,val);
    return 1;
  }

  owner_city[city] += val;
  if (owner_city[city] > 100)
    owner_city[city] = 100;
  if (owner_city[city] <= 0)
    map_delete(owner_city,city);
  set_city(league_id,owner_city);
  return 1;
}

private int set_relation(string league_id,mapping relation)
{
  if (!is_league_id(league_id) ||
      !mapp(relation) ||
      sizeof(relation) < 1)
    return 0;
  league_total[league_id]["relation"] = relation;
  save();
  return 1;
}

public int add_relation_number(string from,string to,int val)
{
  mapping lrinfo;
  int current_relation;
  if (!is_league_id(from) ||
      !is_league_id(to))
    return 0;
  lrinfo = query_league_relation(from);
  current_relation = query_league_relation_league2(from, to);
  if (current_relation <= 0)
    return 0;
  current_relation += val;
  if (current_relation > 100)
    current_relation = 100;
  if (current_relation < 1)
    current_relation = 1;
  lrinfo[to] = current_relation;
  set_relation(from,lrinfo);
  return 1;
}

