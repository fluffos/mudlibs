// combatd.c
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_DBASE;
inherit F_CLEAN_UP;
// 关于玩家数据(/combat/)的说明
// PKS：杀害的玩家数目
// MKS；杀死的NPC数目(动物不计算)
// WPK：主动杀死玩家的次数
// DPS：主动打晕玩家的次数
// dietimes：   死亡的次数
// combat/today纪录(mapping)
// which_day: 日期(实际时间中日期)
// id       : n, 主动打晕某个ID的次数
#define MAX_KILL_TIMES_PERMAN           2
#define MAX_KILL_TIMES_PERDAY           4
// 经验底线(random(my_exp) > EXP_LIMIT，则不加经验)
#define	EXP_LIMIT	200000
int victim_lose(object killer,object victim,string killerid);
int nk_gain(object killer, object victim);
string chinese_daoxing(int gain);
void victim_penalty(object victim);

string *guard_msg = ({
        append_color(CYN "$N注视著$n的行动，企图寻找机会出手。\n" NOR, CYN),
        append_color(CYN "$N正盯著$n的一举一动，随时准备发动攻势。\n" NOR, CYN),
        append_color(CYN "$N缓缓地移动脚步，想要找出$n的破绽。\n" NOR, CYN),
        append_color(CYN "$N目不转睛地盯著$n的动作，寻找进攻的最佳时机。\n" NOR, CYN),
        append_color(CYN "$N慢慢地移动著脚步，伺机出手。\n" NOR, CYN),
});
string *catch_hunt_msg = ({
        append_color(HIW "$N和$n仇人相见分外眼红，立刻打了起来！\n" NOR, HIW),
        append_color(HIW "$N对著$n一声大喝，蓦地直冲过来！\n" NOR, HIW),
        append_color(HIW "$N和$n一碰面，二话不说就打了起来！\n" NOR, HIW),
        append_color(HIW "$N一眼瞥见$n，「哼」的一声冲了过来！\n" NOR, HIW) });
string *winner_msg = ({
        append_color(CYN "\n$N哈哈大笑，说道：承让了！\n\n" NOR, CYN),
        append_color(CYN "\n$N双手一拱，笑著说道：承让！\n\n" NOR, CYN),
        append_color(CYN "\n$N胜了这招，向后跃开三尺，笑道：承让！\n\n" NOR, CYN),
        append_color(CYN "\n$N双手一拱，笑著说道：知道我的利害了吧！\n\n" NOR, CYN),
        append_color(CYN "\n$n向后退了几步，说道：这场比试算我输了，下回看我怎么收拾你！\n\n" NOR, CYN),
        append_color(CYN "\n$n向后一纵，恨恨地说道：君子报仇，十年不晚！\n\n" NOR, CYN),
        append_color(CYN "\n$n脸色一寒，说道：算了算了，就当是我让你吧！\n\n" NOR, CYN),
        append_color(CYN "\n$n纵声而笑，叫道：“你运气好！你运气好！”一面身子向后跳开。\n\n" NOR, CYN),
        append_color(CYN "\n$n脸色微变，说道：佩服，佩服！\n\n" NOR, CYN),
        append_color(CYN "\n$n向后退了几步，说道：这场比试算我输了，佩服，佩服！\n\n" NOR, CYN),
        append_color(CYN "\n$n向后一纵，躬身做揖说道：阁下武艺不凡，果然高明！\n\n" NOR, CYN),
});
void create()
{
  seteuid(getuid());
  set("channel_id", "战斗精灵");
}

// message after damage info
nosave string foo_before_hit = 0;
nosave string foo_after_hit = 0;
void set_bhinfo(string msg)
{
  if (! foo_before_hit)
  {
    foo_before_hit = msg;
    return;
  }

  foo_before_hit += msg;
}

void set_ahinfo(string msg)
{
  if (! foo_after_hit)
  {
    foo_after_hit = msg;
    return;
  }

  foo_after_hit += msg;
}

string query_bhinfo() { return foo_before_hit; }

string query_ahinfo() { return foo_after_hit; }

void clear_bhinfo() { foo_before_hit = 0; }

void clear_ahinfo() { foo_after_hit = 0; }

string damage_msg(int damage, string type, int kee)
{
  string str;
  if (damage < 1)
    return "结果没有造成任何伤害。\n";
  if (kee < 1)
    kee = 1;

  switch (type)
  {
    case "擦伤":
    case "抓伤":
    case "割伤":
      if (damage < kee/30)  return "结果只是轻轻地划破$p$l的皮肉。\n";
      else if (damage < kee/15)  return "结果在$p$l划出一道细长的血痕。\n";
      else if (damage < kee/10) return "结果「嗤」地一声，$w已在$p$l划出一道伤口！\n";
      else if (damage < kee/5) return "结果「嗤」地一声，$w已在$p$l划出一道血淋淋的伤口！\n";
      else if (damage < kee/2) return "结果「嗤」地一声，$w已在$p$l划出一道又长又深的伤口，溅得$N满脸鲜血！\n";
      else
        return "结果只听见$n一声惨嚎，$w已在$p$l划出一道深及见骨的可怕伤口！\n";
      break;
    case "砍伤":
    case "劈伤":
           if( damage < kee/30 ) return "结果只是在$n$l的皮肉上碰了碰，跟蚊子叮差不多。\n";
           else if( damage < kee/15 ) return "结果在$n的$l砍出一道细长的血痕。\n";
           else if( damage < kee/10 ) return "结果"CYN"「噗」"NOR"一声，在$p$l劈出一道"HIR"血淋淋"NOR"的伤口！\n";
           else if( damage < kee/5 ) return "结果只听"CYN"「噗」"NOR"地一声，$n的$l被劈得血如泉涌，痛得$p咬牙切齿！\n";
           else if( damage < kee/2 ) return "结果"CYN"「噗」"NOR"地一声，在$n的$l砍出一道又长又深的伤口，溅得$N满脸"HIR"鲜血！\n"NOR;
           else
             return WHT"结果只听见$n一声惨嚎，$p的$l被劈开一道深及见骨的可怕伤口！\n"NOR;
           break;
    case "刺伤":
      if (damage < kee/30)  return "结果只是轻轻地刺破$p$l的皮肉。\n";
      else if (damage < kee/15)  return "结果在$p$l刺出一个创口。\n";
      else if (damage < kee/10) return "结果「噗」地一声，$w已刺入了$n$l寸许！\n";
      else if (damage < kee/5) return "结果「噗」地一声，$w已刺进$n的$l，使$p不由自主地退了几步！\n";
      else if (damage < kee/2) return "结果「噗嗤」地一声，$w已在$p$l刺出一个血肉□糊的血窟窿！\n";
      else
        return "结果只听见$n一声惨嚎，$w已在$p的$l对穿而出，鲜血溅得满地！\n";
      break;
   case "筑伤":
           if( damage < kee/30 ) return "结果只是轻轻地一触，在$n$l的皮肤上留下一点白痕。\n";
           else if( damage < kee/20 ) return "结果在$p的$l留下几道血痕。\n";
           else if( damage < kee/15 ) return "结果一下子筑中，$n的$l顿时出现几个血孔！\n";
           else if( damage < kee/10 ) return "结果一下子筑中，$n的$l立刻血流如注！\n";
           else if( damage < kee/5 ) return "结果"MAG"「哧」"NOR"地一声，$n的$l顿时鲜血飞溅！\n";
           else if( damage < kee/2 ) return "结果这一下"MAG"「哧」"NOR"地一声，$n的$l被筑个正着，$p顿时浑身是血！\n";
           else return "结果"MAG"「哧」"NOR"重重地砸中$n的$l，$p被筑得千疮白孔，血肉四处横飞！\n";
           break;
    case "瘀伤":
    case "震伤":
      if (damage < kee/30)  return "结果只是轻轻地碰到$n的$l，比拍苍蝇稍微重了点。\n";
      else if (damage < kee/20)  return "结果在$p的$l造成一处瘀青。\n";
      else if (damage < kee/15) return "结果一击命中，$n的$l登时肿了一块老高！\n";
      else if (damage < kee/10) return "结果一击命中$n的$l，$p闷哼了一声显然吃了不小的亏！\n";
      else if (damage < kee/5) return "结果「砰」地一声，正中$n的$l，$p退了两步！\n";
      else if (damage < kee/2) return "结果这一下「砰」地一声打中$n的$l，$p连退了好几步，差一点摔倒！\n";
      else if (damage < kee*3/4) return "结果重重地击中$n的$l，$p「哇」地一声吐出一口鲜血！\n";
      else
        return "结果只听见「砰」地一声巨响，正中$n的$l，$p像一捆稻草般飞了出去！\n";
      break;
    case "内伤":
      if (damage < kee/30)  return "结果击中了$n的$l，只是把$p打得退了半步，毫发无损。\n";
      else if (damage < kee/20)  return "结果$n痛哼一声，在$p的$l造成一处瘀伤。\n";
      else if (damage < kee/15) return "结果一击命中$n的$l，把$p打得痛得弯下腰去！\n";
      else if (damage < kee/10) return "结果一击命中$n的$l，$p闷哼了一声，脸上一阵青一阵白，显然受了点内伤！\n";
      else if (damage < kee/5) return "结果一下子击中$n的$l,$p脸色一下变得惨白，昏昏沉沉接连退了好几步！\n";
      else if (damage < kee/2) return "结果重重地击中$n的$l，$p「哇」地一声吐出一口鲜血！\n";
      else if (damage < kee*3/4) return "结果「轰」地一声击中$n的$l，$p全身气血倒流，口中鲜血狂喷而出！\n";
      else
        return "结果击中$n的$l，只听见几声喀喀轻响，$p一声惨叫，像滩软泥般塌了下去！\n";
      break;
    case "点穴":
      if (damage < kee/30)  return "结果只是轻轻的碰到$n的$l，根本没有点到穴道。\n";
      else if (damage < kee/15)  return "结果$n痛哼一声，在$p的$l造成一处淤青。\n";
      else if (damage < kee/10) return "结果一击命中，$N点中了$n$l上的穴道，$n只觉一阵麻木！\n";
      else if (damage < kee/5) return "结果$n闷哼了一声，脸上一阵青一阵白，登时觉得$l麻木！\n";
      else if (damage < kee/2) return "结果$n脸色一下变得惨白，被$N点中$l的穴道,一阵疼痛遍布整个$l！\n";
      else if (damage < kee*3/4) return "结果$n一声大叫，$l的穴道被点中,疼痛直入心肺！\n";
      else
        return "结果只听见$n一声惨叫，$p$l被点中，一阵剧痛夹杂着麻痒游遍全身，跟着直挺挺的倒了下去！\n";
      break;
    case "鞭伤":
    case "抽伤":
      if (damage < kee/30)  return "结果只是在$n的$l皮肉上碰了碰，好象只蹭破点皮。\n";
      else if (damage < kee/20)  return "结果在$n的$l抽出一道轻微的紫痕。\n";
      else if (damage < kee/10) return "结果「啪」地一声在$n的$l抽出一道长长的血痕！\n";
      else if (damage < kee/5) return "结果只听「啪」地一声，$n的$l被抽得皮开肉绽，痛得$p咬牙切齿！\n";
      else if (damage < kee/2) return "结果「啪」地一声，$n的$l被抽得皮开肉绽，鲜血甭溅！\n";
      else if (damage < kee*3/4) return "结果「啪」地一声爆响！这一下好厉害，只抽得$n的$l皮开肉绽，血花飞溅！\n";
      else
        return "结果只听见$n一声惨嚎，$w重重地抽上了$p的$l，$n顿时血肉横飞，十命断了九条！\n";
      break;
    case "反震伤":
      if (damage < kee/25)  return "结果$N受到$n的内力反震，闷哼一声。\n";
      else if (damage < kee/20)  return "结果$N被$n的反震得气血翻腾，大惊失色。\n";
      else if (damage < kee/15) return "结果$N被$n的反震得站立不稳，摇摇晃晃。\n";
      else if (damage < kee/10) return "结果$N被$n以内力反震，「嘿」地一声退了两步。\n";
      else if (damage < kee/5) return "结果$N被$n的震得反弹回来的力量震得半身发麻。\n";
      else if (damage < kee/3) return "结果$N被$n的内力反震，胸口有如受到一记重击，连退了五六步！\n";
      else if (damage < kee/2) return "结果$N被$n内力反震，眼前一黑，身子向後飞出丈许！\n";
      else
        return "结果$N被$n内力反震，眼前一黑，狂吐鲜血，身子象断了线的风筝向後飞去！\n";
      break;
    case "撞伤":
    case "砸伤":
      if (damage < kee/30)  return "结果只是轻轻地碰到$n的$l，像是给$p搔了一下痒。\n";
      else if (damage < kee/20)  return "结果在$n的$l砸出一个小臌包。\n";
      else if (damage < kee/15) return "结果$N这一下砸个正着，$n的$l登时肿了一块老高！\n";
      else if (damage < kee/10) return "结果$N这一下正砸着$n的$l，$p闷哼一声显然吃了不小的亏！\n";
      else if (damage < kee/5) return "结果只听「砰」地一声正中$n的$l，$p疼得连腰都弯了下来！\n";
      else if (damage < kee/2) return "结果这一下「轰」地一声砸中$n$l，$p眼冒金星，差一点摔倒！\n";
      else if (damage < kee*3/4) return "结果重重地砸中$n$l，$p眼前一黑，「哇」地一声吐出一口鲜血！\n";
      else
        return "结果只听见「轰」地一声巨响，正好砸在$n的$l，$p被砸得血肉模糊，惨不忍睹！\n";
    default:
      if (! type) type = "伤害";
      if (damage < kee/30)  str = "结果正中$n$l，只是勉强造成一处轻微";
      else if (damage < kee/20)  str = "结果正中$n$l，造成轻微的";
      else if (damage < kee/10) str = "结果正中$n$l，造成一处";
      else if (damage < kee/8) str = "造成$n的$l严重";
      else if (damage < kee/5) str = "结果造成$n$l颇为严重的";
      else if (damage < kee/3) str = "结果造成$n$l相当严重的";
      else if (damage < kee/2) str = "结果造成$n$l十分严重的";
      else if (damage < kee*3/4) str = "结果造成$n$l极其严重的";
      else
        str = "结果造成$n$l非常可怕的严重";
      return str + type + "！\n";
  }

}

string eff_status_msg(int ratio)
{
  if (ratio==100) return HIG "看起来气血充盈，并没有受伤。" NOR;
  if (ratio > 95) return HIG "似乎受了点轻伤，不过光从外表看不大出来。" NOR;
  if (ratio > 90) return HIY "看起来可能受了点轻伤。" NOR;
  if (ratio > 80) return HIY "受了几处伤，不过似乎并不碍事。" NOR;
  if (ratio > 60) return HIY "受伤不轻，看起来状况并不太好。" NOR;
  if (ratio > 40) return HIR "气息粗重，动作开始散乱，看来所受的伤著实不轻。" NOR;
  if (ratio > 30) return HIR "已经伤痕累累，正在勉力支撑著不倒下去。" NOR;
  if (ratio > 20) return HIR "受了相当重的伤，只怕会有生命危险。" NOR;
  if (ratio > 10) return RED "伤重之下已经难以支撑，眼看就要倒在地上。" NOR;
  if (ratio > 5 ) return RED "受伤过重，已经奄奄一息，命在旦夕了。" NOR;
  return RED "受伤过重，已经有如风中残烛，随时都可能断气。" NOR;
}

string status_msg(int ratio)
{
  if (ratio==100) return HIG "看起来充满活力，一点也不累。" NOR;
  if (ratio > 95) return HIG "似乎有些疲惫，但是仍然十分有活力。" NOR;
  if (ratio > 90) return HIY "看起来可能有些累了。" NOR;
  if (ratio > 80) return HIY "动作似乎有点不太灵光，但仍然有条不紊。" NOR;
  if (ratio > 60) return HIY "气喘嘘嘘，看起来状况并不太好。" NOR;
  if (ratio > 40) return HIR "似乎十分疲惫，看来需要好好休息了。" NOR;
  if (ratio > 30) return HIR "招架已然散乱，正勉力支撑著不倒下去。" NOR;
  if (ratio > 20) return HIR "看起来已经力不从心了。" NOR;
  if (ratio > 10) return RED "歪歪斜斜地站都站立不稳，眼看就要倒地。" NOR;
  return RED "已经陷入半昏迷状态，随时都可能摔倒晕去。" NOR;
}

string sen_status_msg(int ratio)
{
   if( ratio==100 ) return HIG "看起来头脑清醒，一点也不迷糊。" NOR;
   if( ratio > 90 ) return HIG "拍了拍自己的脑袋，似乎有点不太得劲。" NOR;
   if( ratio > 80 ) return HIY "看起来有些迷糊了。" NOR;
   if( ratio > 60 ) return HIY "的确有点迷糊了，但还辨得出东西南北。" NOR;
   if( ratio > 40 ) return HIR "两眼发直，口角流涎，神智开始混乱。" NOR;
   if( ratio > 20 ) return HIR "迷迷糊糊，摇摇晃晃，已经辨不出东西南北了。" NOR;
   if( ratio > 10 ) return RED "神智已经处在极度混乱中。" NOR;
   return RED "心智已经完全迷失，随时都有可能背过气去。" NOR;
}

varargs void report_status(object ob, int effective)
{
  if( effective )
    message_vision( "( $N" + eff_status_msg(
           (int)ob->query("eff_kee") * 100 /(1+(int)ob->query("max_kee")) )
           + " )\n", ob);
  else
    message_vision( "( $N" + status_msg(
          (int)ob->query("kee") * 100/(1+(int)ob->query("max_kee")) )
          + " )\n", ob);
}

varargs void report_sen_status(object ob, int effective)
{
  message_vision( "( $N" + sen_status_msg(
      (int)ob->query("sen") * 100 /(1+(int)ob->query("max_sen")) )
      + " )\n", ob);
}

protected mapping decide_action(object me)
{
  mapping act ;
  if (!objectp(me))
    return 0;
  me->reset_action();
  act = me->query_action();
  if (!mapp(act))
  {  // reconfirm
    if (!objectp(me))
      return 0;
    me->reset_action();
    act = me->query_action();
    if (! mapp(act))
    {
      CHANNEL_D->do_channel( this_object(), "sys",
               sprintf("%s(%s): bad action = %O",
               me->query("name"), me->query("id"),
               me->query_action(1)));
      return 0;
    }

  }

  return act;
}

protected void get_dodge_reward(object me,object victim,int ap,int dp)
{
  int valve;
  if(!me || !victim)
    return;
  if(!living(me) || !living(victim))
    return;   // 有任一方处于昏迷状态，没有任何奖励。
  if(userp(me) && userp(victim)) // user 对打。
    return;
  if(me->query("no_exp_gain"))	// 不允许的经验的 npc
    return;
  if( dp >= 2000 &&
      (ap <= dp/2
       || ap >= dp*2))
    return;
// 领悟力的阀值。
  valve = 12 + victim->query("age") - 16;
  if(valve < 12)
    valve = 12;
  if(valve > 32 )
    valve = 32;
  if(random(victim->query_int()) >= valve)
  {
    victim->add("combat_exp",1);
    victim->improve_skill("dodge", 1);
    if(random(100) < 50)
      me->add("potential",1);
  }

}

protected void get_parry_reward(object me,object victim,int ap, int pp)
{
  int valve;

  if(!me || !victim)
    return;
  if(!living(me) || !living(victim))
    return;  // 有任一方处于昏迷状态，没有任何奖励。
  if(userp(me) && userp(victim)) // user 对打。
    return;
  if(me->query("no_exp_gain"))	// 不允许的经验的 npc
    return;
  if( pp >= 2000 &&
     (ap <= pp/2
      || ap >= pp*2))
    return;
// 领悟力的阀值。
  valve = 12 + victim->query("age") - 16;
  if(valve < 12)
    valve = 12;
  if(valve > 32 )
    valve = 32;
  if(random(victim->query_int()) >= valve)
  {
    victim->add("combat_exp",1);
    victim->improve_skill("parry", 1);
    if(random(100) < 50)
      me->add("potential",1);
  }

}

protected void get_attack_reward(object me,object victim,string attack_skill,int ap,int dp)
{
  if(!me || !victim)
    return;
  if(!living(me) || !living(victim))
    return; // 有任一方处于昏迷状态，没有任何奖励。
  if(userp(me) && userp(victim)) // user 对打。
    return;
  if(victim->query("no_exp_gain")) // 不允许的经验的 npc
    return;
  if(ap != 0 && dp <= ap/2)
    return;
  me->add("combat_exp",1);
  me->improve_skill(attack_skill, 1);
  if(random(100) < 80)
    me->add("potential",1);
}

int compare_success(int a, int b)
{
  if (a < 1)
    return 0;

  if (b < 1)
    return 1;

  if (a > 100000)
  {
    a /= 100;
    b /= 100;
  }

  return (a*120/(a+b) > random(100));
}

varargs int perform_success(object me, object victim, mixed a, mixed b,int adjust)
{
  int i,mydata, yourdata;

  if (environment(me) != environment(victim) ||
      environment(me)->is_safty() ||
      environment(me)->query("no_fight") ||
      environment(me)->query_temp("no_fight"))
    return 0;

  mydata = (int)me->query_skill("martial-cognize",1);
  yourdata = (int)victim->query_skill("martial-cognize",1);

  if (intp(a))
  {
    if (a > 10000)
      mydata += a/1500*mydata;
    else
      mydata += a*mydata/1500;
  }

  else if (stringp(a))
    mydata += (int)me->query_skill(a);
  else if (arrayp(a) && sizeof(a) > 0)
  {
    for (i=0;i<sizeof(a);i++)
    {
      if (intp(a[i]))
        mydata += a[i];
      else if (stringp(a[i]))
        mydata += (int)me->query_skill(a[i]);
    }

  }

  if (intp(b))
  {
    if (b > 10000)
      yourdata += b/1500*yourdata;
    else
      yourdata += b*mydata/1500;
  }

  else if (stringp(b))
    yourdata += (int)victim->query_skill(b);
  else if (arrayp(b) && sizeof(b) > 0)
  {
    for (i=0;i<sizeof(b);i++)
    {
      if (intp(b[i]))
        yourdata += b[i];
      else if (stringp(b[i]))
        yourdata += (int)victim->query_skill(b[i]);
    }

  }

  if (adjust && adjust > 0)
  {
    if (mydata > 10000)
      mydata += mydata/100*adjust;
    else
      mydata += mydata*adjust/100;
  }

  if (me->query_temp("no_move"))
    mydata -= mydata/2 ;
  if (victim->query_temp("no_move"))
    yourdata -= yourdata/2;
  return compare_success(mydata, yourdata);
}

// do_attack()
//
// Perform an attack action. This function is called by fight() or as an
// interface for some special utilize in quests.
//
varargs int do_attack(object me, object victim, object weapon, int attack_type)
{
  mapping my, your, idamage;
  mapping my_temp, your_temp;
  mapping action,victim_action;
  string limb, *limbs;
  string attack_skill, force_skill, martial_skill, dodge_skill, parry_skill;
  string parry_msg;
  mixed foo, fail_hit_msg;
  int ap, dp, pp;
  int damage, damage_bonus;
  int wounded;
  object weapon2;	// weapon of victim
  object cloth, *obs;         // armor of victim
  string result;
  string damage_info;
  int ratio;
  string vid;
  if (environment(me)->is_safty() ||
      environment(me)->query("no_fight") ||
      environment(me)->query_temp("no_fight"))
  {
    message_vision(HIW "$N" HIW "和$n" HIW "各自退了一步，收住了招。\n" NOR, me, victim);
    me->remove_enemy(victim);
    victim->remove_enemy(me);
    return 0;
  }

  if (environment(me) != environment(victim))
  {
    me->remove_enemy(victim);
    victim->remove_enemy(me);
    return 0;
  }

//防止昏迷中的玩家attack
  if (!living(me))
     return 0;

  if( !me->visible(victim)
   && (random(130 + (int)me->query_skill("count",1) +
        (int)me->query_skill("perception",1)) < 100) )
  {
    message_vision(WHT"$N盲目的乱攻一气,结果连$n的衣角都没有碰到！\n"NOR,me, victim);
    return 0;
  }

  if (!me->query_temp("ignore_dis"))  //某些特殊情况下，忽略距离的影响
  {
    vid = victim->query("id");
    vid = replace_string(vid, " ", "_");
    ratio = (int)me->query_temp("from_dis/"+vid);
    if (me->attack_total_distance(victim) > 1
        && victim->attack_total_distance(me) > 1 )
    {
      if (ratio > me->attack_total_distance(victim))
      {
        switch(random(5))
        {
          case 0 :
            message_vision(HIW"$N身形闪动，意图靠近$n！\n"NOR, me, victim);
            break;
          case 1 :
            message_vision(HIW"$N几个起伏，向$n直扑了过来！\n"NOR, me, victim);
            break;
          case 2 :
            message_vision(HIW"$N双手舞动，防御及其严密，慢慢的向$n靠近！\n"NOR, me, victim);
            break;
          case 3 :
            message_vision(HIW"$N心中愤怒，不顾一切的向$n冲了过去！\n"NOR, me, victim);
            break;
          default :
            message_vision(HIW"$N看看无法有效施展，只得向$n靠近过去！\n"NOR, me, victim);
        }

        ratio -= me->can_move_distance();
        if (ratio < 1)
          ratio = 1;
        me->set_temp("from_dis/"+vid,ratio);
        return 0;
      }

    }

  }

  my = me->query_entire_dbase();
  your = victim->query_entire_dbase();
  if (! (my_temp = me->query_entire_temp_dbase()))
    my_temp = allocate_mapping(5);
  if (! (your_temp = victim->query_entire_temp_dbase()))
    your_temp = allocate_mapping(5);
//
// (1) Find out what action the offenser will take.
//
  action = decide_action(me);
  if (! action)
    return 0;

//取得me使用何种武功的数据
  if( objectp(weapon) )
    attack_skill = weapon->query("skill_type");
  else
    attack_skill = "unarmed";
  if (me->query_temp("action_flag") == 0)
    result = "\n" + action["action"] + "！\n" NOR;
  else
    result = "\n" NOR + HIW "紧跟着" NOR + action["action"] + "！\n" NOR;
  limbs = victim->query("limbs");
  if (! arrayp(limbs))
  {
    limbs = ({ "身体" });
    victim->set("limbs", limbs);
  }

  limb = element_of(limbs);
//
// (2) Prepare AP, DP for checking if hit.
//
  ap = COMBACC_D->math_ap(me,attack_skill);
  if (objectp(weapon))
    ap += ap*(100 - weapon->query_attack_distance())/100;
  else
    ap += ap*random(50)/100;
  dodge_skill = victim->query_skill_mapped("dodge");

  if (stringp(dodge_skill))
    victim_action = SKILL_D(dodge_skill)->query_action(victim);

  if (!victim_action)
    victim_action = ([ ]);

  dp = COMBACC_D->math_dp(me,
                          victim,
                          (int)action["dodge"],
                          (int)victim_action["dodge_power"],
                          dodge_skill);
  if (limb == "头部" || limb == "颈部")
    dp += dp/3;

//
// (3) Fight!
//     Give us a chance of AP/(AP+DP) to "hit" our opponent. Since both
//     AP and DP are greater than zero, so we always have chance to hit
//     or be hit.
//
  damage = 0;
  wounded = 0;
  damage_info = "";
  martial_skill = me->query_skill_mapped(attack_skill);
  fail_hit_msg = 0 ;

  if (!compare_success(ap, dp))
  {  // Does the victim dodge this hit?
#if INSTALL_COMBAT_TEST
    if (wizardp(me) && me->query("env/combat_test"))
      tell_object(me, HIY "【测试精灵】：己方 AP：" + ap + "，DP：" + dp + "。\n" NOR);
    if (wizardp(victim) && victim->query("env/combat_test"))
      tell_object(victim, HIC "【测试精灵】：对方 AP：" + ap + "，DP：" + dp + "。\n" NOR);
#endif
    if( !dodge_skill )
    {
      dodge_skill = "dodge";
      result += SKILL_D(dodge_skill)->query_dodge_msg(victim);
    }

    else
    {
      if (stringp(martial_skill))
      	fail_hit_msg = SKILL_D(martial_skill)->fail_hit(me, victim);
      if (stringp(fail_hit_msg))
        result += fail_hit_msg ;
      else if( mapp(victim_action) && sizeof(victim_action) && stringp(victim_action["dodge_action"]))
        result += victim_action["dodge_action"];
      else
        result += SKILL_D(dodge_skill)->query_dodge_msg(victim);
    }

    get_dodge_reward(me,victim,ap,dp);
    damage = RESULT_DODGE;
  }

  else
  {
//
//      (4) Check if the victim can parry this attack.
//
    parry_skill = victim->query_skill_mapped("parry");
    pp = COMBACC_D->math_pp(me,victim,(int)action["parry"],parry_skill);

    if (!compare_success(ap, pp))
    {
#if INSTALL_COMBAT_TEST
      if (wizardp(me) && me->query("env/combat_test"))
        tell_object(me, HIY "【测试精灵】：己方 AP：" + ap + "，PP：" + pp + "。\n" NOR);
      if (wizardp(victim) && victim->query("env/combat_test"))
        tell_object(victim, HIC "【测试精灵】：对方 AP：" + ap + "，PP：" + pp + "。\n" NOR);
#endif
      if (! parry_skill)
        parry_skill = "parry";
// change to SKILL_D(parry_skill) after added parry msg to those
// martial arts that can parry.
      parry_msg = SKILL_D(parry_skill)->query_parry_msg(weapon2);
      if (! stringp(parry_msg))
        parry_msg = SKILL_D("parry")->query_parry_msg(weapon2);
      if (stringp(martial_skill))
      	fail_hit_msg = SKILL_D(martial_skill)->fail_hit(me, victim);
      if (stringp(fail_hit_msg))
        result += fail_hit_msg ;
      else if (stringp(parry_msg))
        result += parry_msg;
      get_parry_reward(me,victim,ap,pp);
      damage = RESULT_PARRY;
    }

    else
    {
//
// (5) We hit the victim and the victim failed to parry
//
      get_attack_reward(me,victim,attack_skill,ap,dp);
#if INSTALL_COMBAT_TEST
      if (wizardp(me) && me->query("env/combat_test"))
        tell_object(me, HIY "【测试精灵】：己方act damage："
               + (int)action["damage"] + "，act force：" + (int)action["force"]
               + "。\n" NOR);
      if (wizardp(victim) && victim->query("env/combat_test"))
        tell_object(victim, HIC "【测试精灵】：对方 act damage："
               + (int)action["damage"] + "，act force：" + (int)action["force"]
               + "。\n" NOR);
#endif
      idamage = COMBACC_D->math_damage(me,
                                       victim,
                                       (int)action["damage"],
                                       (int)action["force"]);
      damage = idamage["damage"];
      damage_bonus = idamage["bonus"];
#if INSTALL_COMBAT_TEST
    if (wizardp(me) && me->query("env/combat_test"))
      tell_object(me, HIY "【测试精灵】：math damage：" + damage
                     + "，damage_bonus：" + damage_bonus + "。\n" NOR);
    if (wizardp(victim) && victim->query("env/combat_test"))
      tell_object(victim, HIC "【测试精灵】：对方 math damage：" + damage +
                              "，damage_bonus：" + damage_bonus + "。\n" NOR);
#endif
      if (my["force_factor"] > 0 && my["force"] >= my["force_factor"])
        my["force"] -= my["force_factor"];
      else
        my["force_factor"] = 0;
// Clear the special message info after damage info
      foo_before_hit = 0;
      foo_after_hit = 0;
// Let force skill take effect.
      if (my["force_factor"] && (my["force"] > my["force_factor"]))
      {
        if (force_skill = me->query_skill_mapped("force"))
        {
          foo = SKILL_D(force_skill)->hit_ob(me, victim, damage_bonus, my["force_factor"]);
          if (stringp(foo))
            damage_info += foo;
          else if (intp(foo))
            damage_bonus += foo;
          else if (mapp(foo))
          {
            damage_info += foo["msg"];
            damage_bonus += foo["damage"];
          }

        }

      }

// calculate the damage
      if (damage_bonus > 0)
        damage += (damage_bonus + random(2*damage_bonus)) / 4;
// Let's attack & parry skill, force, weapon & armor do effect
      while (damage > 0)
      {
        if(!living(me) || !living(victim))
          break;
        if(damage<1)
          break;
// Let parry skill take its special effort.
        if (stringp(dodge_skill = victim->query_skill_mapped("dodge")))
        {
          foo = SKILL_D(dodge_skill)->valid_damage(me, victim, damage, weapon);
          if (stringp(foo))
            damage_info += foo;
          else if (intp(foo))
            damage += foo;
          else if (mapp(foo))
          {
            damage_info += foo["msg"];
            damage += foo["damage"];
          }

          if (damage < 1)
            break;
        }

        if (stringp(parry_skill = victim->query_skill_mapped("parry")))
        {
          foo = SKILL_D(parry_skill)->valid_damage(me, victim, damage, weapon);
          if (stringp(foo))
             damage_info += foo;
          else if (intp(foo))
             damage += foo;
          else if (mapp(foo))
          {
             damage_info += foo["msg"];
             damage += foo["damage"];
          }

          if (damage < 1)
            break;
        }

        if (stringp(force_skill = victim->query_skill_mapped("force")))
        {
          foo = SKILL_D(force_skill)->valid_damage(me, victim, damage);
          if (stringp(foo))
             damage_info += foo;
          else if (intp(foo))
             damage += foo;
          else if (mapp(foo))
          {
             damage_info += foo["msg"];
             damage += foo["damage"];
          }

          if (damage < 1)
            break;
        }

// Let armor/cloth take its special effort
        obs = "/adm/daemons/humanbodyd"->query_parts_armor_obj(victim, limb);
        if (mapp(your_temp["armor"]) && arrayp(obs) && sizeof(obs) > 0)
        {
          foreach (cloth in obs)
          {
            if (cloth->is_item_make() &&
                cloth->item_owner() != victim->query("id"))
              continue;
            foo = cloth->valid_damage(me, victim, damage, weapon);
            if (stringp(foo))
              damage_info += foo;
            else if (intp(foo))
              damage += foo;
            else if (mapp(foo))
            {
              damage_info += foo["msg"];
              damage += foo["damage"];
            }

          }

          damage_info += sprintf(HIG"\n$n的%s装备削减了部分的伤害！\n"NOR,limb);
        }

        if (damage < 1)
          break;
// Let attack skill take its special effort.
        if (martial_skill = me->query_skill_mapped(attack_skill))
        {
          foo = SKILL_D(martial_skill)->hit_ob(me, victim, damage);
          if (stringp(foo))
            damage_info += foo;
          else if (intp(foo))
            damage += foo;
          else if (mapp(foo))
          {
            damage_info += foo["msg"];
            damage += foo["damage"];
          }

          if (damage < 1)
            break;
        }

// Let weapon or living have their special damage.
        if (objectp(weapon))
        {
          foo = weapon->hit_ob(me, victim, damage);
          if (stringp(foo))
            damage_info += foo;
          else if (intp(foo))
            damage += foo;
          else if (mapp(foo))
          {
            damage_info += foo["msg"];
            damage += foo["damage"];
          }

        }

        else
        {
          foo = me->hit_ob(me, victim, damage);
          if (stringp(foo))
            damage_info += foo;
          else if (intp(foo))
            damage += foo;
          else if (mapp(foo))
          {
            damage_info += foo["msg"];
            damage += foo["damage"];
          }

        }

// finish
        break;
      }

//
// (6) Inflict the damage.
//
      if ((int)victim->query_temp("free_hit") > 0)
      {
        victim->add_temp("free_hit",-1);
        damage = 0;
        damage_info += HIG"\n突然一道绿色光华笼罩住了$n"
                       HIG"了全身，$N"
                       HIG"不由得吃了一惊，这一击竟然没有任何效果了！\n\n"NOR;
      }

      if (damage > 0)
      {
        switch (limb)
        {
          case "头部" :
            damage += damage/3;
            if (damage > your["kee"]/2)
            {
              damage_info += HIW"\n$n头部遭受重创，顿时耳边“嗡嗡”作响，一时有些发晕了！\n"NOR;
              if (!victim->is_busy())
                victim->start_busy(1);
            }

            break;
          case "颈部" :
            damage += damage/3;
            break;
          case "左脚" :
          case "右脚" :
          case "左手" :
          case "右手" :
            damage -= damage/3;
            break;
        }

      }

      if (damage < 0)
        damage = 0;

      if (damage > 0)
      {
        if (me->query_temp("tick/shixue"))
          damage += damage/3;

        foo = COMBACC_D->apply_damage(me,victim,damage,action["damage_type"],limb,0);
        if (stringp(foo))
          damage_info += foo;
        if (playerp(victim))
          damage_info += "/cmds/usr/hpkee"->get_str(victim);

// add message before hit in victim
        if (foo_before_hit)
          result += foo_before_hit;
        result += damage_msg(damage, action["damage_type"],your["kee"]);
        damage_info += "( $n" + status_msg(victim->query("kee")*100/(victim->query("max_kee")+1))+")\n";
      }

      if (foo_after_hit)
        damage_info += foo_after_hit;
    }

  }

  result = replace_string(result, "$l", limb);
  if (objectp(weapon))
    result = replace_string(result, "$w", weapon->name());
  else if (objectp(weapon = me->query_temp("weapon")))
    result = replace_string(result, "$w", weapon->name());
  else if (stringp(action["weapon"]))
    result = replace_string(result, "$w", action["weapon"]);
  else if (attack_skill == "finger" || attack_skill == "hand")
    result = replace_string(result, "$w", "手指" );
  else if (attack_skill == "strike" || attack_skill == "claw")
    result = replace_string(result, "$w", "手掌" );
  else
    result = replace_string(result, "$w", "拳头" );
  if( objectp(victim->query_temp("weapon")) )
    result = replace_string( result, "$v", victim->query_temp("weapon")->name());
  message_combatd(result, me, victim, damage_info);
  if (damage > 0)
  {
    if (victim->is_busy())
    {
      if (your["character"] == "狡黠多变")
        victim->interrupt_me(victim,2);
      else
        victim->interrupt_me(victim,1);
    }

    if ((! me->is_killing(your["id"])) &&
        (! victim->is_killing(my["id"])) &&
         your["kee"] * 2 <= your["max_kee"])
    {
      me->remove_enemy(victim);
      victim->remove_enemy(me);
      message_vision(element_of(winner_msg), me, victim);
      if (me == victim->query_competitor())
      {
        me->win();
        victim->lost();
      }

    }

    if( (string)victim->query("env/attack")
       && !victim->is_busy()
       && !victim->query_temp("attack_flag")
       && victim->is_fighting(me))
    {
      me->set_temp("attack_flag",1);
      do_attack(victim, me, victim->query_temp("weapon"), TYPE_QUICK);
      me->set_temp("attack_flag",0);
    }

  }

  if (functionp(action["post_action"]))
    evaluate(action["post_action"], me, victim, weapon, damage);
// See if the victim can make a riposte.
  if (attack_type == TYPE_REGULAR &&
      damage < 1 &&
      your_temp["guarding"] &&
      victim->is_fighting(me))
  {
    your_temp["guarding"] = 0;
    if (random(my["dex"] + my["cps"]) < 12)
    {
      message_combatd(HIC "$N" HIC "一击不中，露出了破绽！\n" NOR, me, 0, "");
      do_attack(victim, me, your_temp["weapon"], TYPE_QUICK);
    }

    else
    {
      message_combatd(HIC "$N" HIC "见$n" HIC "攻击失误，趁机发动攻击！\n" NOR, victim, me, "");
      do_attack(victim, me, your_temp["weapon"], TYPE_RIPOSTE);
    }

  }

  return damage;
}

// do damage when perform
// I will consider the damage of the weapon
// what is final: final may be a function with result type string,
// or a single string.
// The syntax of the final string is info:damage_type@limb or info only,
// If the limb if ?, the system will auto select limb of
// target, if the final is a single string, the system will
// treat as damage infomation.
varargs string do_damage(object me, object target, mixed type,
                         int damage, int percent, mixed final)
{
  mapping my;
  object weapon;
  object cloth, *obs;
  int apply;
  int jiali;
  mixed foo;
  string msg;
  string skill;
  string *limbs;
  string limb;
  string damage_type;
  string result;
  int damage_bonus;
// Am I use weapon
  apply = 0;
  if (type == WEAPON_ATTACK)
  {
    weapon = me->query_temp("weapon");
    if (objectp(weapon))
      apply  = (int)weapon->query("weapon_prop/damage");
  }

  else if (type == UNARMED_ATTACK)
  {
    apply  = me->query_temp("apply/unarmed_damage");
    weapon = 0;
  }

  else
  {
    apply  = 0;
    weapon = 0;
  }

  if (apply > 220)
    apply = 220 + random(apply-220);
  damage += apply;

  msg = "";
  foo_after_hit = 0;
  limbs = target->query("limbs");
  if (! arrayp(limbs))
  {
    limbs = ({ "身体" });
    target->set("limbs", limbs);
  }

  limb = element_of(limbs);
  result = "";
  if (functionp(final))
    final = evaluate(final);
  if (stringp(final))
  {
    if (sscanf(final, "%s@%s", final, limb) == 2)
    {
      if (sscanf(final, "%s:%s", result, damage_type) != 2)
      {
        result = HIR "这招正中了$n的" + limb + "！";
        damage_type = final;
      }

    }

    final = replace_string(damage_msg(damage, damage_type,target->query("kee")), "$l", limb);
    final = replace_string(final, "$n", "$n" HIR);
    final = replace_string(final, "$N", "$N" HIR);
    final = replace_string(final, "$p", "$p" HIR);
    final = replace_string(final, "$P", "$P" HIR);
    if (weapon)
      final = replace_string(final, "$w", weapon->name() + HIR);
    final = result + HIR + final + NOR;
  }

  while (type == UNARMED_ATTACK || type == WEAPON_ATTACK)
  {
// Let parry skill take its special effort
    if (skill = target->query_skill_mapped("parry"))
    {
      foo = SKILL_D(skill)->valid_damage(me, target, damage, weapon);
      if (stringp(foo))
        msg += foo;
      else if (intp(foo))
        damage += foo;
      else if (mapp(foo))
      {
        msg += foo["msg"];
        damage += foo["damage"];
      }

    }

    if (damage < 1)
      break;
// Let cloth & armor take its special effort
    obs = "/adm/daemons/humanbodyd"->query_parts_armor_obj(target, limb);
    if (arrayp(obs) && sizeof(obs) > 0)
    {
      foreach (cloth in obs)
      {
        foo = cloth->valid_damage(me, target, damage, weapon);
        if (stringp(foo))
          msg += foo;
        else if (intp(foo))
          damage += foo;
        else if (mapp(foo))
        {
          msg += foo["msg"];
          damage += foo["damage"];
        }

      }

    }

// Finish
    break;
  }

  while (damage > 0)
  {
    if (target->is_busy())
    {
      if ((string)target->query("character") == "狡黠多变")
        target->interrupt_me(target, 4 + random(4));
      else
        target->interrupt_me(target, 2 + random(2));
    }

// Let weapon/unarmed attack take its special effort
    if (type == WEAPON_ATTACK)  // weapon attack
      foo = weapon->hit_ob(me, target, damage);
    else if (type == UNARMED_ATTACK)  // unarmed attack
      foo = me->hit_ob(me, target, damage);
    else if (objectp(type))  // special item attack
      foo = type->hit_ob(me, target, damage);
    if (stringp(foo))
      msg += foo;
    else if (intp(foo))
      damage += foo;
    else if (mapp(foo))
    {
      msg += foo["msg"];
      damage += foo["damage"];
    }

// do enforce effect
    my = me->query_entire_dbase();
    if ((jiali = my["force_factor"]) > 0 && my["force"] >= jiali)
    { // eforced
      my["force"] -= jiali;
      if (type == REMOTE_ATTACK)
      {
        damage_bonus = jiali*3/2;
      }

      else
      {
      	if (type == UNARMED_ATTACK)
          damage_bonus = jiali*4/3;
        else
          damage_bonus = jiali;
// check special force effort
        skill = target->query_skill_mapped("force");
        if (stringp(skill))
        {
          foo = SKILL_D(skill)->valid_damage(me, target, damage_bonus);
          if (stringp(foo))
            msg += foo;
          else if (intp(foo))
            damage_bonus += foo;
          else if (mapp(foo))
          {
            msg += foo["msg"];
            damage_bonus += foo["damage"];
          }

        }

        damage += damage_bonus;
      }

    }

    if ((int)target->query_temp("free_hit") > 0)
    {
      target->add_temp("free_hit",-1);
      damage = 0;
      msg += HIG"\n突然一道绿色光华笼罩住了$n"
                       HIG"了全身，$N"
                       HIG"不由得吃了一惊，这一击竟然没有任何效果了！\n\n"NOR;
      break;
    }

    if (damage < 1)
      break;
// do damage
    if (me->query_temp("tick/shixue"))
      damage += damage/3;
    foo = COMBACC_D->apply_damage(me,target,damage,0,limb,percent);

    if (stringp(final))
    {
      msg += final;
      msg += "( $n" + status_msg(target->query("kee") * 100 / target->query("max_kee")) + ")\n";
      if (stringp(foo))
        msg += foo;
      if (playerp(target))
        msg += "/cmds/usr/hpkee"->get_str(target);
    }

    break;
  }

  if (foo_after_hit)
    msg += foo_after_hit;
  return msg;
}

//      fight()
//
//      This is called in the attack() defined in F_ATTACK, which handles fighting
//      in the heart_beat() of all livings. Be sure to optimize it carefully.
//
void fight(object me, object victim)
{
  object weapon;

  if( !living(me) )
    return;
  if( me->query_temp("netdead") )
    return;
  if( victim->query_temp("netdead") )
  {
    if( member_array( me, victim->query_netdead_enemy() ) == -1 )
      return;     // can't start fight if the victim is already netdead
  }

  if( !me->visible(victim)
   && (random(150 + (int)me->query_skill("perception")) < 100) )
    return;
  weapon = me->query_temp("weapon");
// If victim is busy or unconcious, always take the chance to make an attack.
  if (victim->is_busy() || victim->query_temp("no_move") || ! living(victim))
  {
    me->set_temp("guarding", 0);
    if (! victim->is_fighting(me))
      victim->fight_ob(me);
    do_attack(me, victim, weapon, TYPE_QUICK);
  }

  else if( random( (int)victim->query_dex() + (int)victim->query_cps() ) <
           random( (int)me->query_dex() + (int)victim->query_cor() ))
  {
    me->set_temp("guarding", 0);
    if (! victim->is_fighting(me))
      victim->fight_ob(me);
    do_attack(me, victim, weapon, TYPE_REGULAR);
// Else, we just start guarding.
  }

  else if (! me->query_temp("guarding"))
  {
    me->set_temp("guarding", 1);
    message_combatd( element_of(guard_msg), me, victim, "");
    return;
  }

  else
    return;
}

//      auto_fight()
//
//      This function is to start an automatically fight. Currently this is
//      used in "aggressive", "vendetta", "hatred", "berserk" fight.
//
void auto_fight(object me, object obj, string type)
{
// Don't let NPC autofight NPC.
  if (!userp(me) && ! userp(obj))
    return;
  if (me->query_temp("owner") == obj ||
      obj->quety_temp("owner") == me)
    return;
// Because most of the cases that we cannot start a fight cannot be checked
// before we really call the kill_ob(), so we just make sure we have no
// aggressive callout wating here.
  if (me->query_temp("looking_for_trouble"))
    return;
  me->set_temp("looking_for_trouble", 1);
// This call_out gives victim a chance to slip trough the fierce guys.
  call_out("start_" + type, 0, me, obj);
}

void start_berserk(object me, object obj)
{
  int bellicosity;
  if( !me )
    return;// Are we still exist( not becoming a corpse )?
  me->set_temp("looking_for_trouble", 0);
  if( !obj )
    return;
  if( wizardp(obj) )
    return;
  if( (int)obj->query("age") <= 18 )
    return;
  if( me->is_fighting(obj)                   // Are we busy fighting?
   || !living(me)                            // Are we capable for a fight?
   || environment(me)!=environment(obj)      // Are we still in the same room?
   || environment(me)->is_safty()
   || environment(me)->query("no_fight")     // Are we in a peace room?
   )
    return;

  if (me->query_temp("owner") == obj->query("id") ||
      obj->query_temp("owner") == me->query("id"))
    return;
  bellicosity = (int)me->query("bellicosity");
  message_vision("$N用一种异样的眼神扫视着在场的每一个人。\n", me);
  if( (int)me->query("force") > (random(bellicosity) + bellicosity)/2 )
    return;
  if( bellicosity > (int)me->query("score")
   &&      !wizardp(obj) )
  {// auto kill, mark my_killer_list. -- mon 9/23/98
    if(userp(me) && userp(obj))
    {
      me->want_kill(obj);
    }

    message_vision("$N对着$n喝道：" + RANK_D->query_self_rude(me)
           + "看你实在很不顺眼，去死吧。\n", me, obj);
    me->kill_ob(obj);
  }

  else
  {
    message_vision("$N对着$n喝道：喂！" + RANK_D->query_rude(obj)
      + "，" + RANK_D->query_self_rude(me) + "正想找人打架，陪我玩两手吧！\n",
       me, obj);
    me->fight_ob(obj);
  }

}

void start_hatred(object me, object obj)
{
  if (! me || ! obj || ! living(me))
    return;
  me->set_temp("looking_for_trouble", 0);
  if (me->is_fighting(obj) ||
      environment(me) != environment(obj) ||
      environment(me)->is_safty() ||
      environment(me)->query("no_fight"))
    return;
  if (me->query_temp("owner") == obj->query("id") ||
      obj->query_temp("owner") == me->query("id"))
    return;
// We found our hatred! Charge!
  message_vision(element_of(catch_hunt_msg), me, obj);
  me->want_kill(obj);
  me->kill_ob(obj);
  if (! playerp(me) && me->is_busy() && ! intp(me->query_busy()))
    me->interrupt_me(me);
}

void start_vendetta(object me, object obj)
{
  if (! me || ! obj || ! living(me))
    return;
  me->set_temp("looking_for_trouble", 0);
  if (me->is_fighting(obj) ||
      environment(me) != environment(obj) ||
      environment(me)->is_safty() ||
      environment(me)->query("no_fight"))
    return;
// We found our vendetta opponent! Charge!
  me->want_kill(obj);
  me->kill_ob(obj);
}

void start_aggressive(object me, object obj)
{
  if (! me || ! obj || ! living(me))
    return;
  me->set_temp("looking_for_trouble", 0);
  if (me->is_fighting(obj) ||
      environment(me) != environment(obj) ||
      environment(me)->is_safty() ||
      environment(me)->query("no_fight"))
    return;
// We got a nice victim! Kill him/her/it!!!
  me->want_kill(obj);
  me->kill_ob(obj);
}

int player_escape(object killer, object ob)
{
  string msg, k_name;
  mapping quest_rulai ;
  if (! objectp(ob))
    return 0;
// 是玩家么？
  if (! playerp(ob))
    return 0;
  quest_rulai = ob->query("quest_xyj/rulai");
  if (!mapp(quest_rulai) || sizeof(quest_rulai) < 1)
    return 0;

  if (!killer ||
      killer->query("quester") != ob->query("id") ||
      quest_rulai["npc_id"] != killer->query("id"))
    return 0;
  ob->remove_all_killer();
  all_inventory(environment(ob))->remove_killer(ob);
  ob->dismiss_team();
  ob->set("kee",(int)ob->query("max_kee")/3);
  ob->set("eff_kee",(int)ob->query("max_kee")/2);
  ob->set("sen",(int)ob->query("max_sen")/3);
  ob->set("eff_sen",(int)ob->query("max_sen")/2);
  ob->set("force",(int)ob->query("max_force")/2);
  ob->set("mana",(int)ob->query("max_mana")/2);
  ob->receive_damage("kee",1);
  ob->receive_damage("sen",1);
  if (quest_rulai["level"] < 2)
    ob->add("combat_exp",-500);
  else if (quest_rulai["level"] < 3)
    ob->add("combat_exp",-300);
  else if (quest_rulai["level"] < 4)
    ob->add("combat_exp",-200);
  if (objectp(killer))
    k_name = killer->name();
  else
    k_name = "来历不明妖怪";
  msg = ob->name()+ HIW"被" + HIY + k_name +
        HIW"杀死了，幸好如来佛及时出手相救，才捡回一命。\n"NOR;;
  message("channel:rumor",HIM"【小道消息】"NOR + "某人：" + msg,users());
  log_file("rulai_die",sprintf("[%s] %s is task killed by %s.\n",
                               ctime(time()),
                               ob->query("id"),
                               k_name));
  ob->move("/d/qujing/lingshan/daxiong");
  message_vision(HIY"如来佛一伸左手把$N" HIY"的魂魄从地府里拉了回来。\n"
                    "再一伸右手不知道从哪里把$N" HIY"的尸体抓了回来。\n"
                    "接着两手一合，硬生生地把$N" HIY"魂魄逼回身体。\n"NOR,ob);
  return 1;
}

// This function is to announce the special events of the combat.
// This should be moved to another daemon in the future.
void announce(object ob, string event)
{
  switch (event)
  {
    case "dead":
      message_vision(NOR "\n$N扑在地上挣扎了几下，腿一伸，口中喷出几口"
                     HIR "鲜血" NOR "，死了！\n\n" NOR, ob);
      break;
    case "unconcious":
      message_vision("\n$N脚下一个不稳，跌在地上一动也不动了。\n\n", ob);
      break;
    case "revive":
      message_vision(HIC "\n$N" HIC "慢慢睁开眼睛，清醒了过来。\n\n" NOR, ob);
      break;
/*
    case "death_rumor":
      CHANNEL_D->do_channel(this_object(),"rumor",msg);
      break;
*/
  }

}

// called when winner hit the victim to unconcious
void winner_reward(object winner, object victim)
{
  object owner;
  int temp;
  int td;
  mapping today;
  owner = winner->query_temp("owner");
  if (objectp(owner))
    winner = owner;
  winner->defeated_enemy(victim);
  if (!playerp(winner))
    return;
  if (!playerp(victim))
    return;

// only if I want kill ob, I will record it.
  if (! winner->is_want_kill(victim->query("id")))
    return;
  winner->add("combat/DPS", 1);
  if (victim->query_condition("killer"))
    return;
  if (victim->query("combat_exp") < 150)
    return;
  log_file("static/killrecord",
           sprintf("%s %s defeat %s\n",
           log_time(), log_id(winner), log_id(victim)));
  td = time() / 86400;
  today = winner->query("combat/today");
  if (! mapp(today) || today["which_day"] != td)
  {
    today = ([ "which_day" : td,
               "total_count" : 1,
                victim->query("id") : 1, ]);
  }

  else
  {  // count how many times that winner hit the victim to unconcious
    temp = ++today[victim->query("id")];
    if (temp == MAX_KILL_TIMES_PERMAN)
    {     // reach limit
      tell_object(winner, BLINK HIR "\n今天你已经打晕" +
                  victim->name() + chinese_number(temp) +
                  "次了，手下留"
                  "情吧，否则麻烦可要找上门了。\n" NOR);
    }

    else if (temp > MAX_KILL_TIMES_PERMAN)  // too many times
    {
      winner->set("combat/need_punish", "这厮逼人太甚，真是岂有此理！");
      winner->add("combat/need_punish_num", 3);
    }

// count how many users that winner hit to unconcious
    temp = ++today["total_count"];
    if (temp == MAX_KILL_TIMES_PERDAY)
    {     // reach limit
      tell_object(winner, BLINK HIR "\n今天你已经打晕" +
                  chinese_number(temp) + "次玩家了，手下留"
                  "情吧，否则麻烦可要找上门了。\n" NOR);
    }

    else if (temp > MAX_KILL_TIMES_PERDAY)    // too many users
    {
      winner->set("combat/need_punish", "丧尽天良，大肆屠戮，罪无可恕！");
      winner->add("combat/need_punish_num", 3);
    }

  }

  winner->set("combat/today", today);
}

void pk_record(object winner, object victim)
{
  object owner;
  mapping killer_info,killed_info;
  int i;
  string *killer_list;
  string *killed_list ;
  string vid,kid ;
  string killer_str,killed_str;
  int last_time;
  if( !objectp(winner))
    return;
  owner = winner->query_temp("owner");
  if (objectp(owner))
    winner = owner;
  if (! playerp(winner))
    return;
  if (! playerp(victim))
    return ;

  if (! winner->is_want_kill(victim->query("id")))
    return;

  if (victim->query_condition("killer"))
    return;

  vid = victim->query("id");
  kid = winner->query("id");
  killer_info = winner->query("pk/killer");
  killed_info = victim->query("pk/killed");
  if (!mapp(killer_info))
  {
    killer_info = ([ vid :
                     ([
                         "number" : 1 ,  // 次数
                         "base_number" : 1,  //纪录次数的起始值
                         "last_time" : time(),  //最新时间
                         "1" : time(),          //时间
                     ])
                  ]);
  }

  else
  {
    killer_list = keys(killer_info);
    if(member_array(vid,killer_list)==-1)
    {
      // 最多10个被害者纪录
      if (sizeof(killer_list) > 9)
      {
        last_time = time();
        for (i=0;i<sizeof(killer_list);i++)
        {
          killer_str = killer_list[i];
          if (last_time > killer_info[killer_str]["last_time"] )
            last_time = killer_info[killer_str]["last_time"];
        }

        for (i=0;i<sizeof(killer_list);i++)
        {
          killer_str = killer_list[i];
          if (last_time == killer_info[killer_str]["last_time"] )
          {
            map_delete(killer_info,killer_str);
            break;
          }

        }

      }

      killer_info += ([ vid :
                        ([
                          "number" : 1 ,
                          "base_number" : 1,
                          "last_time" : time(),
                          "1"      : time(),
                        ]),
                      ]);
    }

    else
    {
      if (killer_info[vid]["number"] > 9)  //number纪录总次数，但只是纪录最近10次的时间
      {
        map_delete(killer_info[vid],sprintf("%d",killer_info[vid]["base_number"]));
        killer_info[vid]["base_number"] ++ ;
      }

      killer_info[vid]["number"] ++ ;
      killer_info[vid]["last_time"] = time();
      killer_info[vid] +=
            ([ sprintf("%d",killer_info[vid]["number"]) : time(), ]);

    }

  }

  if (!mapp(killed_info))
  {
    killed_info = ([ kid :
                     ([
                         "number" : 1 ,
                         "base_number" : 1,  //纪录次数的起始值
                         "last_time" : time(),  //最新时间
                         "1" : time(),
                     ])
                  ]);
  }

  else
  {
    killed_list = keys(killed_info);
    if(member_array(kid,killed_list)==-1)
    {
      //最多10个凶手纪录
      if (sizeof(killed_list) > 9)
      {
        last_time = time();
        for (i=0;i<sizeof(killed_list);i++)
        {
          killed_str = killed_list[i];
          if (last_time > killed_info[killed_str]["last_time"] )
            last_time = killed_info[killed_str]["last_time"];
        }

        for (i=0;i<sizeof(killed_list);i++)
        {
          killed_str = killed_list[i];
          if (last_time == killed_info[killed_str]["last_time"] )
          {
            map_delete(killed_info,killed_str);
            break;
          }

        }

      }

      killed_info += ([ kid :
                        ([
                          "number" : 1 ,
                          "base_number" : 1,  //纪录次数的起始值
                          "last_time" : time(),  //最新时间
                          "1"      : time(),
                        ])
                     ]);
    }

    else
    {
      if (killed_info[kid]["number"] > 9)  //number纪录总次数，但只是纪录最近10次的时间
      {
        map_delete(killed_info[kid],sprintf("%d",killed_info[kid]["base_number"]));
        killed_info[kid]["base_number"] ++ ;
      }

      killed_info[kid]["number"] ++ ;
      killed_info[kid] +=
            ([ sprintf("%d",killed_info[kid]["number"]) : time(), ]);

    }

  }

  winner->set("pk/killer",killer_info);
  winner->save();
  victim->set("pk/killed",killed_info);
  victim->save();
}

void killer_reward(object killer, object victim)
{
  object owner;
  string vmark;
  string msg = "莫名其妙地死了";
  string follow_msg = 0;
  object weapon;
  mapping actions;
  mapping ks, vs, kcombat;
  int gain, lose, reward;
  string str, killerid;
  if (! objectp(victim))
    return;

  if (objectp(killer))
  {
    owner = killer->query_temp("owner");
    if (objectp(owner))
      killer = owner;
  }

// This while is only to enable "break"
  vs = victim->query_entire_dbase();
  while (1)
  {
    if (objectp(killer))   // call the killer's override function
      killer->killed_enemy(victim);
    if (! objectp(killer) || ! playerp(killer))
      break;
// assure the killer's dbase
    ks = killer->query_entire_dbase();
    if (! mapp(kcombat = ks["combat"]))
    {
      kcombat = ([ ]);
      ks["combat"] = kcombat;
    }

// weapon get the bonus
    if (weapon = killer->query_temp("weapon") ||
        weapon = killer->query_temp("armor/hands"))
      weapon->killer_reward(killer, victim);
// record the user's killing
    if (playerp(victim))
    {
      if (! intp(kcombat["PKS"]))
        kcombat["PKS"] = 1;
      else
        kcombat["PKS"]++;

// do family action
      FAMILY_D->family_kill(killer, victim);
// do league action
      LEAGUE_D->league_kill(killer, victim);
      killerid = killer->query("id");
      lose = victim_lose(killer,victim,killerid);
      gain=lose*8/10;
      if(gain<0)
        gain=0;

      killer->add("bellicosity",10);
      killer->add("combat/pkgain",gain);
      killer->add("daoxing",gain);
      killer->set("combat/kill_id",victim->query("id"));
      killer->set("combat/kill_name",victim->name(1));
      killer->set("combat/killtime", time());
      victim->add("killed/dietimes",1);
      victim->set("killed/last_killer",killerid);
      victim->set("killed/last_killername",killer->query("name"));
      victim->set("killed/killtime",time());

      if (victim->query_condition("killer"))
      {
        follow_msg = "听说杀人凶手"WHT + victim->name() + HIM
                     "在" HIW+ MISC_D->find_place(environment(killer))+ HIM"被"
                      HIG + killer->name() + HIM "就地正法了。\n"NOR;
        break;
      }

      if (! killer->is_want_kill(victim->query("id")) )
        break;
      if (! intp(kcombat["WPK"]))
        kcombat["WPK"] = 1;
      else
        kcombat["WPK"]++;
      if (! killer->query_condition("killer"))
      {
         follow_msg = "听说官府发下海捕文书，缉拿杀人凶手" +
                       killer->name(1) + "。";
         killer->delete_temp("nopoison");
         killer->apply_condition("killer", 500);
      }

      else
      {
        follow_msg = "听说官府加紧捉拿累犯重案的暴徒" +
                     killer->name(1) + "。";
        killer->delete_temp("nopoison");
        killer->apply_condition("killer", 800 +
            (int)killer->query_condition("killer"));
      }

      break;
    }

    else
    {
      killer->add("bellicosity",1);
      reward = (int)victim->nk_reward(killer);
      if (reward <= 0 )
        reward=nk_gain(killer, victim);

      if(reward>0)
      {
        killer->add("combat/nkgain",reward);
        killer->add("daoxing",reward);
        str=chinese_daoxing(reward);
        tell_object(killer,"\n你得到了"+str+"道行。\n");
        msg=sprintf("%s(%d)杀死了%s(%d)，得到%d点道行。",
             killer->query("id"),
             (killer->query("daoxing")+killer->query("combat_exp"))/2,
             victim->query("id"),
             (victim->query("daoxing")+ victim->query("combat_exp"))/2,reward);
        log_file("npc_kill","["+ctime(time())+"] "+msg+"\n");
        CHANNEL_D->do_channel(this_object(), "sys",msg);
      }

      if (vs["can_speak"])
      {
        if (! intp(kcombat["MKS"]))
          kcombat["MKS"] = 1;
        else
          kcombat["MKS"]++;
      }

    }

    break;
  }

  if( userp(victim) )
  {
    if (objectp(killer) && !playerp(killer))
      victim->add("combat/dietimes",1);
    victim_penalty(victim);
    victim->clear_condition();
    if (objectp(killer) && killer->is_character())
    {
      msg = "被" + filter_color(killer->name(1));
      actions = killer->query_action();
      switch (mapp(actions) ? actions["damage_type"] : "杀伤")
      {
        case "擦伤":
        case "割伤":
          msg += "砍死了";
          break;
        case "刺伤":
          msg+="刺死了";
          break;
        case "震伤":
        case "瘀伤":
          msg+="击死了";
          break;
        case "内伤":
          msg+="震死了";
          break;
        default:
          msg+="杀死了";
      }

    }

    if (stringp(victim->query_temp("die_reason")))
      msg = filter_color(victim->query_temp("die_reason"));
    victim->delete_temp("die_reason");
    CHANNEL_D->do_channel(this_object(), "rumor",
           sprintf("听说%s" HIM + msg + "。", victim->name(1)));
// show the follow msg after victim die
    if (follow_msg)
      CHANNEL_D->do_channel(this_object(), "rumor", follow_msg);
    victim->set("combat/last_die", filter_color(msg));
    if (objectp(killer) && playerp(killer) && playerp(victim))
    {
      string cname;
      object couple;
      log_file("static/killrecord",
               sprintf("%s %s killed %s\n",
                       log_time(),
                       log_id(killer),
                       log_id(victim)));
      killer->remove_killer(victim);
// check sadly
      cname = victim->query("couple/id");
      if (stringp(cname) && victim->query("gender") == "女性" &&
          victim->query("combat_exp") >= 1000000 &&
          objectp(couple = find_player(cname)) &&
          couple != killer)
      {
        couple->add("static/sadly", 1);
        tell_object(couple, "你的妻子死在了" + killer->name(1) + "的手下" +
                            "，你感到了一阵深深的哀伤。\n");
      }

    }

  }

  if (stringp(vmark = victim->query("vendetta_mark")) && objectp(killer))
    killer->add("vendetta/" + vmark, 1);

  if(objectp(killer) && userp(killer))
    killer->save();
  if(objectp(victim) && userp(victim))
    victim->save();
}

// me hit victim with poison in ob
void hit_with_poison(object me, object victim, object ob)
{
  mapping p, ap;
  string msg;
  string poison_type;
  if (! mapp(p = ob->query_temp("daub/poison")))
    return;
  if (! stringp(poison_type = ob->query_temp("daub/poison_type")))
    return;
  if (! p["remain"])
    return;
// affect parameter
  ap = allocate_mapping(4);
  if (ob == me)
    ap["level"] = p["level"] * 9 / 10 + 1;
  else
    ap["level"] = p["level"] * 8 / 10 + 1;

  ap["id"]       = p["id"];
  ap["name"]     = p["name"];
  ap["duration"] = 1;
  if (p["remain"] > p["level"])
  {
// decrase the remain poison
    p["remain"] -= p["level"];
  }

  else
  {
// the poison has run out
     ob->delete_temp("daub");
  }

  msg = HIB "突然$n" HIB "觉得受伤的地方有一些麻痒";
  if (p["id"] == victim->query("id"))
  {
    if (! victim->query_temp("has_announce/defense1"))
    {
      victim->set_temp("has_announce/defense1", 1);
      victim->start_call_out(bind((: call_other,
               __FILE__, "clear_announce", victim :), victim), 15);
      msg += "。\n" NOR HIC "$n" HIC "默一运功，冷笑两声：“好个" +
             RANK_D->query_rude(me) + "，居然在我面前卖弄" +
             RANK_D->query_self_rude(victim) +
             "毒药？”\n" NOR;
    }

    else
      msg += "，不过$n并没有在意。\n" NOR;
    set_ahinfo(msg);
    return;
  }

  if (p["level"] < victim->query_skill("poison", 1))
  {
    if (! victim->query_temp("has_announce/defense2"))
    {
      victim->set_temp("has_announce/defense2", 1);
      victim->start_call_out(bind((: call_other,
             __FILE__, "clear_announce", victim :), victim), 15);
      msg += "。\n" NOR HIC "$n" HIC "呼吸数次，嘿然冷笑道："
             "米粒之珠，也放光华？\n" NOR;
    }

    else
      msg += "，不过$n显然并没有把它放在心上。\n" NOR;
    set_ahinfo(msg);
    return;
  }

  if (p["level"] < victim->query_skill("force") / 2)
  {
    if (! victim->query_temp("has_announce/defense3"))
    {
      victim->set_temp("has_announce/defense3", 1);
      victim->start_call_out(bind((: call_other,
                  __FILE__, "clear_announce", victim :), victim), 15);
      msg += "。\n" NOR HIC "$n" HIC "长笑道：好家伙，居然" +
             (ob == me ? "在身上淬毒" : "使用淬毒兵器") +
             "，这些下三滥的手段也敢到我面前卖弄？\n" NOR;
    }

    else
      msg += "，不过$n看起来似乎并无大碍。\n" NOR;
    set_ahinfo(msg);
    return;
  }

  ap["id"]       = me->query("id");
  ap["name"]     = me->query("name");
  victim->affect_by(poison_type, ap);
  msg += "，大概是中毒了。\n" NOR;
  if (p["level"] < victim->query_skill("force"))
  {
     msg += HIB "$n" HIB "深深吸一了口气，面目凝重，手中的攻势陡然一紧。\n" NOR;
     set_ahinfo(msg);
     return;
  }

  msg += HIR "$n" HIR "闷哼一声，攻势顿缓，神情甚是痛苦。\n" NOR;
  victim->start_busy(1 + random(2));
  set_ahinfo(msg);
  return;
}

// me hit victim, but poison by victim in ob
void hit_poison(object me, object victim, object ob)
{
  mapping p, ap;
  string msg;
  string poison_type;
  if (! mapp(p = ob->query_temp("daub/poison")))
    return;
  if (! stringp(poison_type = ob->query_temp("daub/poison_type")))
    return;
  if (! p["remain"])
    return;
  if (me->query_temp("armor/hands"))
    return;
// affect parameter
  ap = allocate_mapping(4);
  ap["level"]    = p["level"] * 7 / 10 + 1;

  ap["id"]       = p["id"];
  ap["name"]     = p["name"];
  ap["duration"] = 1;
  if (p["remain"] > p["level"])
  {
// decrase the remain poison
    p["remain"] -= p["level"];
  }

  else
  {
// the poison has run out
    ob->delete_temp("daub");
  }

  msg = HIB "突然$N" HIB "觉得浑身有些麻痒";
  if (p["id"] == me->query("id"))
  {
    if (! me->query_temp("has_announce/defense1"))
    {
      me->set_temp("has_announce/defense1", 1);
      me->start_call_out(bind((: call_other,
        __FILE__, "clear_announce", me :), me), 15);
      msg += "。\n" NOR HIC "$N" HIC "默一运功，冷笑两声：好个" +
           RANK_D->query_rude(victim) + "，居然在我面前卖弄" +
           RANK_D->query_self_rude(victim) +
           "的毒药！把你衣服上的毒药都还给我！\n" NOR;
    }

    else
      msg += "，不过$N并没有在意。\n" NOR;
    set_ahinfo(msg);
    return;
  }

  if (p["level"] < me->query_skill("poison", 1))
  {
    if (! me->query_temp("has_announce/defense2"))
    {
      me->set_temp("has_announce/defense2", 1);
      me->start_call_out(bind((: call_other,
             __FILE__, "clear_announce", me :), me), 15);
      msg += "。\n" NOR HIC "$N" HIC "冷笑道：米粒之珠也放"
             "光华？你在衣衫上淬毒我就怕你了？\n" NOR;
    }

    else
      msg += "，不过$N显然并没有把它放在心上。\n" NOR;
    set_ahinfo(msg);
    return;
  }

  if (p["level"] < me->query_skill("force") / 2)
  {
    if (! me->query_temp("has_announce/defense3"))
    {
      me->set_temp("has_announce/defense3", 1);
      me->start_call_out(bind((: call_other,
               __FILE__, "clear_announce", me :), me), 15);
      msg += "。\n" NOR HIC "$N" HIC "长笑道：居然在衣衫上"
             "淬毒，这些下三滥的手段也敢到我面前卖弄？\n" NOR;
    }

    else
      msg += "，不过$N看起来似乎并无大碍。\n" NOR;
    set_ahinfo(msg);
    return;
  }

  ap["id"]       = victim->query("id");
  ap["name"]     = victim->query("name");
  me->affect_by(poison_type, ap);
  msg += "，看来有些不妙。\n" NOR;
  if (p["level"] < me->query_skill("force"))
  {
    msg += HIB "$N" HIB "深深吸一了口气，面目凝重，手中的攻势陡然一紧。\n" NOR;
    set_ahinfo(msg);
    return;
  }

  msg += HIR "$N" HIR "脚步一个跄踉，攻势顿缓，神色难看之极。\n" NOR;
  me->start_busy(1 + random(2));
  set_ahinfo(msg);
  return;
}

void clear_announce(object me)
{
  if (! objectp(me))
    return;
  me->delete_temp("has_announce");
}

//被杀害的玩家参数设定
void victim_penalty(object victim)
{
  int qn;

  int combat_exp_loss = (int)victim->query("combat_exp") / 90;
  int dx_loss = (int)victim->query("daoxing") / 90;
  victim->set("bellicosity", 0);

  victim->set("death/mud_age",victim->query("mud_age"));

  victim->set("death/last_exp_loss",combat_exp_loss);
  victim->add("death/exp_loss",combat_exp_loss);
  victim->add("combat_exp", -combat_exp_loss);

  victim->set("death/last_dx_loss",dx_loss);
  victim->add("death/dx_loss",dx_loss);
  victim->add("daoxing", -dx_loss);

  log_file("death",victim->query("id")+
      " lost "+combat_exp_loss+" exp points and "
      + dx_loss+ " dx points.\n");
  qn = (int)victim->query("potential")-(int)victim->query("learned_points");
  victim->add("potential",-qn/2);
  victim->add("death/qn_loss",qn/2);
  victim->set("death/last_qn_loss",qn/2);

  victim->delete("vendetta");
  if( victim->query("thief") )
    victim->set("thief", (int)victim->query("thief") / 2);
  if(random(80) > (int)victim->query_kar() && random(3) == 0)
  {
    victim->set("death/skill_loss",1);
    victim->skill_death_penalty();
  }

  else
    victim->set("death/skill_loss",0);
  victim->save();
}

int nk_gain(object killer, object victim)
{
  string fam, fam1;
  int eff_dx, v_dx, my_dx, nkgain;
// some NPC has no rewards.
// mon 3/9/99
  if(victim->query("no_nk_reward")) return 0;
//can't kill NPCs which were fainted by
//other players to get daoxing.
  if(victim->query_temp("last_fainted_from")
    && victim->query_temp("last_fainted_from")!= killer->query("id"))
    return 0;
  fam=killer->query("family/family_name");
  if(stringp(fam))
  {//player must have a family.
     eff_dx = victim->query("eff_dx");
     nkgain = victim->query("nkgain");
//can't kill NPCs of the same menpai as the player
//to get daoxing.
     fam1=victim->query("family/family_name");
     if(stringp(fam1) && (fam==fam1))
       return 0;
     if (victim->query("no_nkgain"))
       return 0;

     if(eff_dx >= 0)
       return eff_dx;

     if (nkgain >= 0)
       return nkgain;
     v_dx = victim->query("daoxing")/4*3 + victim->query("combat_exp")/4;
     my_dx = killer->query("daoxing")/4*3 + killer->query("combat_exp")/4;

     eff_dx = (v_dx - my_dx)*3/40;

     if (eff_dx > 100000)
       eff_dx = 50000 + random((eff_dx - 100000)/2 + 1);
     else if (eff_dx > 10000)
       eff_dx = 10000 + random((eff_dx -10000)/2 + 1);

     if (eff_dx < 10)
       eff_dx = 0;

     return eff_dx ;
  }

  return 0;
}

int victim_lose(object killer,object victim,string killerid)
{
  int lose,exp_k,exp_v;
  int lose1;
  if( wizardp(victim) || wizardp(killer))
    return 0;
  exp_k=killer->query("daoxing");
  exp_v=victim->query("daoxing");
  if (exp_k>exp_v)
  {
    lose=10*exp_v/(exp_k+1)*(4000+exp_v)/500;
// a exp_v/exp_k pre-factor.
    if(exp_k>exp_v*4)
      lose=0;
  }

  else
  {
    lose=(4000+exp_v)/50;  // about 2% lose for victim.
  }

  if(lose<0)
    lose=0;
  if(lose>exp_v)
    lose=exp_v;

// this is the maximum lose.
  lose1=(int)victim->query("daoxing") / 40;
  if(lose>lose1)
    lose=lose1;
  return lose;
}

string chinese_daoxing(int gain)
{
  int year,day,hour;
  string str;
  year=gain/1000;
  day=(gain-year*1000)/4;
  hour=(gain-year*1000-day*4)*3;
  str="";
  if(year)
    str=str+chinese_number(year)+"年";
  if(day)
    str=str+chinese_number(day)+"天";
  if(hour)
    str=str+chinese_number(hour)+"时辰";
  return str;
}

