// pkd.c
#include <ansi.h>
#include <localtime.h>
inherit F_DBASE;
#define ENTRY_ROOM      "/d/yaomo/entry"
#define READY_ROOM      "/d/yaomo/ready"
//#define PK_ROOM         "/d/pk/turen"
// the state of daemon
nosave int state;
#define SLEEPING        0
#define GET_READY       1
#define STARTING        2
#define GET_READY_TIME  300
nosave object *total = ({ });
nosave int ready_time = 0;
// 四次比赛列表
nosave mapping *tlist = ({
  ([
    "name" : "新手赛",
    "time" : ({ 1400, 1415, }),
    "level"  : ({ 15, 25 }),
    "last_day" : 0,
  ]),
  ([
    "name" : "进阶赛",
    "time" : ({ 1000, 1015, }),
    "level"  : ({ 15, 40 }),
    "last_day" : 0,
  ]),
  ([
    "name" : "高手赛",
    "time" : ({ 1800, 1815, }),
    "level"  : ({ 15, 50 }),
    "last_day" : 0,
  ]),
  ([
    "name" : "无差别赛",
    "time" : ({ 2000, 2015 }),
    "level"  : ({ 15, 80 }),
    "last_day" : 0,
  ])
});
nosave int selected;
string MAZE_FILE = "/d/qujing/baihuling/maze_generator";
object maze_g = 0;
mixed rooms;
string milin_file = "/d/yaomo/milin.lpc";
int max_i = 4;
int max_j = 4;
void dest();
private void change_state(int new_state);
private void init_player(object me);
private int  start_competition();
private void message_competition(string msg);
private void auto_check();
private void give_bouns(object me);
private void kickout_players();
private void restore_status(object me);
private void send_invite_message();
// 外部可调用的函数
int check_out(object me);
// return the time of prompt
int is_pking() { return state == STARTING; }

int is_ready() { return state == GET_READY; }

void create()
{
  seteuid(ROOT_UID);
  set("channel_id", "妖魔大会");
  //write("妖魔大会已经启动。\n");
  state = SLEEPING;
  set_heart_beat(30);
}

int clean_up()
{
  return 1;
}

int maxi()
{
  return max_i;
}

int maxj()
{
  return max_j;
}

int adjusted (int n, int max)
{
  if (n < 0)
    n += max;
  if (n >= max)
    n -= max;

  return n;
}

object search_for_room(int i, int j)
{
  i = adjusted (i, maxi());
  j = adjusted (j, maxj());
  return rooms[0][i][j];
}

object random_room ()
{
  return search_for_room(random(maxi()), random(maxj()));
}

void setup_rooms()
{
  maze_g = load_object(MAZE_FILE);
  maze_g->do_setup("1 "+max_i+" "+max_j);
  rooms=maze_g->generate_room(milin_file);
}

int yaomo_start(object *obs)
{
  object ob, yaomo;
  int i = sizeof(obs);
  int j;
  if (!i)
    return 0;

// mon 9/26/98 set up maze size. maximum 7x7 matrix.
  for(j=3;j<=6;j++)
  {
    if(j*j/2>=i)
      break;
  }

  max_i=j;
  max_j=j;
  dest();
  reset_eval_cost();
  setup_rooms();
  foreach (ob in obs)
  {
    yaomo = new("/d/yaomo/npc/yaomo");
    yaomo->set_npc_family(ob, 0, 0, 0);
    yaomo->move(random_room());
    NPC_D->set_from_me(yaomo,ob,90 + random(10));
    yaomo = new("/d/yaomo/npc/yaomo");
    yaomo->set_npc_family(ob, 0, 0, 0);
    yaomo->move(random_room());
    NPC_D->set_from_me(yaomo,ob,90 + random(10));
    if (random(2))
    {
      yaomo = new("/d/yaomo/npc/yaomo");
      yaomo->set_npc_family(ob, 0, 0, 0);
      yaomo->move(random_room());
      NPC_D->set_from_me(yaomo,ob,100 + random(10));
    }

  }

  return 1;
}

void dest()
{
  mapping my;
  object* child=children(milin_file);
  int i = sizeof(child), j;
  object *inv;

  while(i--)
    if(clonep(child[i]))
    {
      inv=all_inventory(child[i]);
      j=sizeof(inv);
      while(j--)
      {
        if(userp(inv[j]))
        {
          my = inv[j]->query_entire_dbase();
          my["eff_kee"] = my["max_kee"];
          my["eff_sen"] = my["max_sen"];
          my["kee"] = 1;
          my["sen"] = 1;
          tell_object(inv[j], "\n你晕晕乎乎地来到了一个新的地方．．．\n\n");
          restore_status(inv[j]);
          inv[j]->move(ENTRY_ROOM,1);
          message("vision", "只见" + inv[j]->name() + "被赶了出来。\n",
                             environment(inv[j]), ({ inv[j] }));
          if (! living(inv[j]))
            inv[j]->revive(1);

        }

      }

      destruct(child[i]);
    }

  rooms=0;
}

void events ()
{
  int i;

  if (!rooms || !sizeof(rooms))
    return;

  remove_call_out ("events");
  call_out ("events",2+random(10));
  i = maxi()*maxj()/8;
  while (i--)
  {
    if (random(10))
      random_room()->switch_on_off();
    else
      random_room()->trapped();
  }

}

// join in competition
int join_competition(object ob)
{
  if (state != SLEEPING)
    return notify_fail("现在妖魔大会正在进行，你还是等等再说吧。\n");
  if (ob->query("level") < 15
     && ! ob->query_temp("team_fight"))
    return notify_fail("你这点本事就别进去啦。\n");
  if (ob->query_condition())
    return notify_fail("你现在状态不佳，还是别进去了。\n");
  if (! arrayp(total))
    total = ({ ob });
  else if (member_array(ob, total) == -1)
    total += ({ ob });
  message_competition((ultrap(ob) ? "大宗师" : "") + ob->name(1) + "参加妖魔大会。");
  init_player(ob);
  set_heart_beat(1);
  return 1;
}

// scan
private void heart_beat()
{
  mixed lt;
  int ti;
  int i;
  int last_day;
  int left_time, left_min;
  seteuid(ROOT_UID);
  lt = localtime(time());
  ti = lt[LT_HOUR] * 100 + lt[LT_MIN];
  switch (state)
  {
    case SLEEPING:
      last_day = time() / 86400;
      for (i = 0; i < sizeof(tlist); i++)
      {
        if (ti < tlist[i]["time"][0] || ti > tlist[i]["time"][1])  // not change state
          continue;
        if (last_day == tlist[i]["last_day"])  // this day has do it
          break;
        tlist[i]["last_day"] = last_day;
        selected = i;
// chanage state to "GET_READY";
        change_state(GET_READY);
        break;
      }

      break;
    case GET_READY:
      left_time = ready_time + GET_READY_TIME - time();
      if (left_time > 0)
      {
        left_min = left_time % 60;
        left_time /= 60;
        if (left_time && left_min == 1)
        {
          message_competition("听说 " + tlist[selected]["name"] + " 在大约"
                          + chinese_number(left_time) + "分钟后就要正式开始了！\n");
        }

        else if (left_min == 1)
        {
          message_competition("听说 " + tlist[selected]["name"] + " 马上就要正式开始了！\n");
        }

        break;
      }

// change state to "GET_READY_2";
      change_state(STARTING);
      break;
    case STARTING:
      break;
  }

  if (sizeof(total))
    auto_check();
}

// the daemon change to a new state
private void change_state(int new_state)
{
  mixed lt;
  int n;
  lt = localtime(time());
  switch (new_state)
  {
    case GET_READY:  // kickout the player now in competition
      kickout_players();
      ready_time = time();
      message_competition("听说一年一度的妖魔大会 " + tlist[selected]["name"] + " 马上就要"
                          "举行了，不知道今年的冠军是谁？");
      set_heart_beat(1);
      send_invite_message();
      break;
    case STARTING:
      if (! (n = start_competition()))
      {
        message_competition("听说今年的妖魔大会 " + tlist[selected]["name"] + " 因故"
                            "取消了，真是没劲。");
        new_state = SLEEPING;
      }

      else
      {
        message_competition("听说今年的妖魔大会 " + tlist[selected]["name"] +
                            " 吸引了" + chinese_number(n) +
                            "名高手！走...看看热闹去。");
        set_heart_beat(1);
      }

      break;
    default:
      total = ({ });
      break;
  }

// change to new state
  state = new_state;
  if (state == SLEEPING)
    set_heart_beat(30);
  return;
}

// set player's override functions
private void init_player(object me)
{
  tell_object(me, HIY "你眼前忽然一花……\n" NOR);
  me->set_override("unconcious", (: call_other, __FILE__, "check_out" :));
  me->set_override("die", (: call_other, __FILE__, "check_out" :));
  me->set_override("quit", (: call_other, __FILE__, "check_quit" :));
  me->set_temp("backup/killer", me->query_killer());
  me->set_temp("backup/want", me->query_want());
  me->set_leader(0);
  me->move(random_room(),1);
//  me->move(sprintf(PK_ROOM "%d", random(12) + 1));
  tell_object(me, HIY "你定神一看，这才发现自己已经到了" +
                  environment(me)->short() + HIY "。\n");
  me->set("backup/condition", me->query_condition());
  me->clear_condition();
}

// kickout the players in competition when formal competition
// get ready
private void kickout_players()
{
  object ob;
  mapping my;
  if (! arrayp(total))
    return;
  foreach (ob in total)
  {
    if (! objectp(ob) || ob->is_ghost())
      continue;
    if (!environment(ob) || !environment(ob)->is_ymdh_field())
      continue;
    my = ob->query_entire_dbase();
    my["eff_kee"] = my["max_kee"];
    my["eff_sen"] = my["max_sen"];
    my["kee"] = 1;
    my["sen"] = 1;
    tell_object(ob, HIC "\n一个禹王小卒走了过来，嚷嚷道：“清场了！清场了，都快走吧！”\n" NOR);
    restore_status(ob);
    ob->move(ENTRY_ROOM);
    message("vision", "只见" + ob->name() + "悻悻的走了出来。\n",
                      environment(ob), ({ ob }));
    if (! living(ob))
      ob->revive(1);
  }

}

// start competition, overide all the player's unconcios/die
// function
private int start_competition()
{
  object env;
  object *obs;
  int i;
  env = find_object(READY_ROOM);
  if (! objectp(env))
    return 0;
  obs = filter_array(all_inventory(env), (: userp($1) && ! wizardp($1) :));
  if (sizeof(obs) < 2)
    return 0;
  if (sizeof(obs) == 2)
  {
    if (obs[0]->query("couple/id") == obs[1]->query("id"))
    {
      message_vision("禹王说道：“就你们夫妻"
                     "俩个参加？还是算了吧。”\n", obs[0]);
      return 0;
    }

  }

  yaomo_start(obs);
  message("vision", "一个黑影走了过来，打开"
                    "了门，冷冷道：“都进去吧！”\n", env);
  for (i = 0; i < sizeof(obs); i++)
  {
    reset_eval_cost();
    init_player(obs[i]);
  }

  set_heart_beat(1);
  message("vision", HIG "妖魔大会开始了，快动手吧！\n", obs);
  return sizeof(total = obs);
}

// send message out
private void message_competition(string msg)
{
  CHANNEL_D->do_channel(this_object(), "rumor", msg);
}

// check all the players who join the competition
private void auto_check()
{
  object ob;
  string msg;
  object *lost;
  int i;
  lost = ({ });
  for (i = 0; i < sizeof(total); i++)
  {
    if (! objectp(total[i]))
      continue;
    if (!total[i]->query_temp("ymdh/joiner") ||
        !environment(total[i]) ||
        !environment(total[i])->is_ymdh_field())
    {  // not in ymdh room
      restore_status(total[i]);
      total[i] = 0;
    }

    if (total[i]->query("kee") < 1 || total[i]->query("sen") < 1)
      lost += ({ total[i] });
  }

// kickout the players who lost competition
  foreach (ob in lost)
    check_out(ob);
  total -= ({ 0 });
  if (state == SLEEPING)
  {
    if (sizeof(total) < 1)
// end of competition. call the change_state
// function to restore the normal heart beat.
      change_state(SLEEPING);
    return;
  }

  if (state != STARTING)
    return;
  if (sizeof(total) < 1)
  {
    msg = "听说妖魔大会参与者死的死，逃的逃，现在一个人都没有啦！";
  }

  else if (sizeof(total) == 1)
  {   // change the daemon's state
    msg = "听说本次妖魔大会圆满结束，" +
          total[0]->name(1) + "成为本次大会冠军！";
    give_bouns(total[0]);
  }

  else if (sizeof(total) == 2 && total[0]->query("couple/id") == total[1]->query("id"))
  {
    msg = "听说本次妖魔大会圆满结束，" +
          total[0]->name(1) + "和" + total[1]->name(1) +
          "夫妻双双获胜。";
    give_bouns(total[0]);
    give_bouns(total[1]);
  }

  else
  {
    if (random(5) == 0)
      events ();
    return;
  }

  message_competition(msg);
  change_state(SLEEPING);
}

private void give_bouns(object me)
{
  int bonus_point;
  int exp, dx;
  int pot;
  string msg;
// lead me out
  restore_status(me);
  tell_object(me, "这次真是爽呆了……\n");
  me->move(ENTRY_ROOM);
  message("vision", me->name() + "慢慢的走了过来，一脸奸笑。\n", environment(me), ({ me }));
// bouns
  bonus_point = me->query_temp("ymdh/bonus_point");
  exp = bonus_point*40 + 2000;
  dx = exp/2 + random(exp);
  pot = exp/3;
  msg = HIG "通过这次妖魔大会，你获得了 " + chinese_number(exp) + " 点经验、";
  msg += XYJTIME_D->check_daoxing(dx) + "道行";
  msg += "和 " + chinese_number(pot) + " 点潜能。\n" NOR;
  me->improve_potential(pot);
  me->add("combat_exp", exp);
  me->add("daoxing",dx);
  log_file("ymdh",sprintf("%s(%s) gain ymdh bonus : %d exp %d dx %d pot\n time = %s \n",
                           me->name(),
                           me->query("id"),
                           exp,
                           dx,
                           pot,
                           ctime(time())));
  tell_object(me, msg);
}

// remove overide function
// restore condition
private void restore_status(object me)
{
  mapping cnd;
  string *ks;
  int i;
  me->delete_override("unconcious");
  me->delete_override("die");
  me->delete_override("quit");
  me->remove_all_enemy(1);
  me->remove_all_killer();
  me->clear_condition();
  me->receive_damage("kee", 0);
  me->apply_killer(me->query_temp("backup/killer"));
  me->apply_want(me->query_temp("backup/want"));

  me->delete_temp("ymdh/joiner");

  cnd = me->query("backup/condition");
  me->delete("backup/condition");
  me->delete_temp("block_msg/all");
  if (! mapp(cnd))
    return;
  ks = keys(cnd);
  for (i = 0; i < sizeof(ks); i++)
    me->apply_condition(ks[i], cnd[ks[i]]);
}

// send invite message
private void send_invite_message()
{
  object *obs;
  int exp_ul, exp_dl;
  exp_dl = tlist[selected]["level"][0];
  exp_ul = tlist[selected]["level"][1];
  obs = filter_array(all_interactive(),
                      (: ! wizardp($1) &&
                         $1->query("level") >= $(exp_dl) &&
                         $1->query("level") <= $(exp_ul) :));
  if (! sizeof(obs))
    return;
  message("vision", HIR "你收到了禹王爷发下的邀请信，邀请你参加这次妖魔大会 " +
                    tlist[selected]["name"] + " ，有没有兴趣去显显身手？\n" NOR, obs);
}

int start_by_others(int n)
{
  if (state == STARTING)
    return notify_fail("现在比赛正在进行中。\n");
  if (state == GET_READY)
    return notify_fail("现在比赛正在报名中。\n");
  if (n < 0 || n >= sizeof(tlist))
    return notify_fail("没有这个等级的比赛(0-" +
                       (sizeof(tlist) - 1) + ")。\n");
  selected = n;
  change_state(GET_READY);
  return 1;
}

object *query_all_competitor()
{
  return total;
}

// overide function of quit
int check_quit(object me)
{
  int i;
  object *inv;

  message_competition("听说" + me->name(1) +
                      "临阵脱逃，溜走了。");
  inv = all_inventory(me);
  i = sizeof(inv);
  while (i--)
    if (inv[i]->is_yaomodahui_gun())
      destruct(inv[i]);
  restore_status(me);
  if (arrayp(total))
    total -= ({ me });
  tell_object(me, "你逃出了妖魔大会。\n");
// continue run quit function
  me->move(ENTRY_ROOM,1);
  message("vision", "只见" + me->name() + "慌里慌张的跑了出来。\n",
          environment(me), ({ me }));
  return 1;
}

// overide function of lost(die/unconcious)
int check_out(object me)
{
  object ob;
  object *inv;
  mapping my;
  string msg;
  int i,mylvl, yourlvl;
  if (!me)
    return 0;
  if (!environment(me) || !environment(me)->is_ymdh_field())
  {
// not in pk room
    total -= ({ me });
    me->delete_temp("ymdh/joiner");
    return 0;
  }

  inv = all_inventory(me);
  i = sizeof(inv);
  while (i--)
    if (inv[i]->is_yaomodahui_gun())
      destruct(inv[i]);

  my = me->query_entire_dbase();
  my["eff_kee"] = my["max_kee"];
  my["eff_sen"] = my["max_sen"];
  my["kee"] = 1;
  my["sen"] = 1;
  mylvl = me->query("level");
  tell_object(me, HIR "\n你觉得眼前一阵模糊……这下完了！\n" NOR);
  ob = me->query_last_damage_from();
  if (objectp(ob) && playerp(ob))
  {
    msg = "听说" + me->name(1) + "惨遭" + ob->name(1) + "的毒手，被无情淘汰。";
    yourlvl = ob->query("level");
    if (yourlvl < mylvl + 3)
      ob->add_temp("ymdh/bonus_point",mylvl + 3);
  }

  else
  {
    msg = "听说" + me->name(1) + "运气不佳，本领有限、已经惨遭淘汰。";
  }

  message_competition(msg);
  restore_status(me);
  total -= ({ me });
  me->move(ENTRY_ROOM,1);
  message("vision", "一个黑影倏的窜了出来，随即就是“啪”的"
          "一声，就见" + me->name() +"摔倒了地上，一副半死不"
          "活的样子。\n", environment(me), ({ me }));
  tell_object(me, "半昏半迷中，你觉得被人拎了起来，又"
                  "重重的摔倒了地上。\n");
  if (! living(me))
    me->revive(1);
  return 1;
}

// reject_join?
string reject_join(object me)
{
  object *obs, env;
  int exp;
  if (state == STARTING)
    return "现在" + tlist[selected]["name"] + "正在举行，"
           "你还是下次再来吧。";
  if (state != GET_READY)
    return "现在没要举行比赛啊？你跑来干什么？";
  exp = me->query("level");
  if (exp < tlist[selected]["level"][0])
    return "你还是算了吧，你这点本事就别进去现眼了。";
  if (exp > tlist[selected]["level"][1])
    return "哦…您武功如此高强，这次还是别和小辈们争了。";
  if (me->query("age") < 18)
    return "你年纪也太小了吧！！\n";
  env = find_object(READY_ROOM);
  if (! objectp(env))
    return 0;
  obs = filter_array(all_inventory(env), (: userp($1) && ! wizardp($1) :));

  if (sizeof(obs) > 20)
    return "本次比赛参与的人数实在是太多了,只好请您下次参与了！\n";

  if (sizeof(obs) < 1)
    return 0;

  obs = filter_array(obs,
              (: playerp($1) &&
                 $1->query_temp("ymdh/joiner") &&
                 query_ip_number($1) == query_ip_number($(me)) :));

  if (sizeof(obs) > 1)
    return "本次妖魔大会，你这个ip上来的人也太多了吧？\n";

  return 0;
}