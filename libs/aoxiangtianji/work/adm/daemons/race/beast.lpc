#include <race/beast.h>
mapping combat_action =
([
	"angel":([
    "action":  "$N用犄角恶狠狠地向$n一顶",
    "damage":  50,
    "damage_type":  "瘀伤",
  ]),
	"hoof": ([
		"action":		"$N用后腿往$n的$l用力一蹬",
		"damage":		100,
		"damage_type":	"瘀伤",
	]),
	"sting": ([
		"action":		"$N反转身用尾巴尖对准$n的$l一刺",
		"damage":		20,
		"damage_type":	"咬伤",
	]),
	"bite": ([
		"action":		"$N扑上来张嘴往$n的$l狠狠地一咬",
		"damage":		20,
		"damage_type":	"咬伤",
	]),
	"claw": ([
		"action":		"$N用爪子往$n的$l一抓",
		"damage_type":	"抓伤",
	]),
	"poke": ([
		"action":		"$N用嘴往$n的$l一啄",
		"damage":		30,
		"damage_type":	"刺伤",
	]),
	"rope": ([
      "action":  "$N用身体缠住了$n用力一勒",
      "damage":  40,
      "damage_type":  "勒伤",
    ]),
    "snap": ([
      "action":  "$N展开四爪，飞身往$n猛里一扑",
      "damage":  40,
      "damage_type":  "勒伤",
    ]),
    "snoot":([
      "action":  "$N用长鼻子恶狠狠地向$n卷去",
      "damage":  30,
      "damage_type":  "瘀伤",
    ]),
	"knock": ([
		"action":		"$N抬起蹄子往$n的$l一踹",
		"damage":		100,
		"damage_type":	"瘀伤",
	]),
  "tail": ([
    "action":  "$N倒竖尾巴，对准$n的$l狠狠一抽",
    "damage":  20,
    "damage_type":  "瘀伤",
  ]),
  "wind": ([
    "action":  "$N张开翅膀往$n的$l奋力一扇",
    "damage":  40,
    "damage_type":  "瘀伤",
  ]),
]);
void create()
{
  seteuid(getuid());
}

void setup_beast(object ob)
{
  mapping my;
  my = ob->query_entire_dbase();
  my["unit"] = "只";
  if (pointerp(my["verbs"]))
    ob->set_default_action(__FILE__, "query_action");
  else
    ob->set_default_action(([ "action" : "$N攻击$n的%l\n" ]));

  if( undefinedp(my["gender"]) ) my["gender"] = (random(2))?"雌性":"雄性";

  if( undefinedp(my["age"]) )
    my["age"] = random(20) + 5;
  if( undefinedp(my["str"]) )
    my["str"] = random(51) + 5;

  if( undefinedp(my["int"]) )
    my["int"] = random(11) + 5;

  if( undefinedp(my["con"]) )
    my["con"] = random(21) + 5;

  if( undefinedp(my["spi"]) )
    my["spi"] = random(11) + 5;

  if( undefinedp(my["dex"]) )
    my["dex"] = random(21) + 5;

  if( undefinedp(my["cps"]) )
    my["cps"] = random(11) + 5;

  if( undefinedp(my["cor"]) )
    my["cor"] = random(21) + 5;

  if( undefinedp(my["per"]) )
    my["per"] = random(21) + 5;

  if( undefinedp(my["kar"]) )
    my["kar"] = random(21) + 5;

  if( undefinedp(my["max_douzhi"]) )
    my["max_douzhi"] = 200;
  if( undefinedp(my["eff_douzhi"]) )
    my["eff_douzhi"] = my["max_douzhi"];
  if( undefinedp(my["douzhi"]) )
    my["douzhi"] = my["max_douzhi"];

  if( undefinedp(my["max_gin"]) )
  {
    if( my["age"] <= 3 )
      my["max_gin"] = 50;
    else if( my["age"] <= 10 )
      my["max_gin"] = 50 + (my["age"] - 3) * 20;
    else if( my["age"] <= 30 )
      my["max_gin"] = 190 + (my["age"] - 10) * 5;
    else
      my["max_gin"] = my["max_gin"] = 290 + (my["age"] - 30);
  }

  if( undefinedp(my["max_kee"]) )
  {
    if( my["age"] <= 5 )
      my["max_kee"] = 50;
    else if( my["age"] <= 20 )
      my["max_kee"] = 50 + (my["age"] - 5) * 25;
    else
      my["max_kee"] = 425 + (my["age"] - 20) * 5;
  }

  if( undefinedp(my["max_sen"]) )
  {
    if( my["age"] <= 5 )
      my["max_sen"] = 45;
    else if( my["age"] <= 20 )
      my["max_sen"] = 45 + (my["age"] - 5) * 20;
    else
      my["max_sen"] = 400 + (my["age"] - 20) * 5;
  }

  if( undefinedp(my["limbs"]))
    my["limbs"]=({
    "头部", "胸口", "后背", "小腹"
    }) ;
  if( !ob->query_weight() )
    ob->set_weight(BASE_WEIGHT + (my["str"] - 10)* 2000);
}

mapping query_action(object me)
{
  string *act;
  act = me->query("verbs");
  return combat_action[element_of(act)];
}

