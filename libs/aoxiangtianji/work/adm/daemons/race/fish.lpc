// fish.c 游鱼
#ifndef __FISH__
#define __FISH__
// A normal fish is at least 20 g weight
#define BASE_WEIGHT 20
#endif
inherit F_DBASE;
mapping *combat_action = ({
([
  "action":    "$N游上来来张嘴往$n的$l狠狠地一咬",
  "damage":    20,
  "damage_type":  "咬伤",
]),
([
  "action":    "$N摆动尾巴往$n的$l猛地一拍",
  "damage":    20,
  "damage_type":  "淤伤",
]),
});
void create()
{
  seteuid(getuid());
  set("attitude", "peaceful");
  set("limbs", ({
    "头部",  "腮部",  "背部",  "腹部",
    "前鳍",  "后鳍", "尾巴"
  }) );
  set("dead_message",       "\n$N摆动了几下，白白的肚子往上翻了起来。\n\n"    );
  set("unconcious_message", "\n$N摆动了几下，红红的腮帮往外翻了出来。\n\n"    );
  set("revive_message",     "\n$N摆了几下，又在水中游了开去。\n\n"      );
  set("leave_msg",    "打了个水漂游了出去"        );
  set("arrive_msg",   "游了过来，在水中灵活地打了个转儿"      );
  set("fleeout_message",    "打了个水漂游了出去"        );
  set("fleein_message",     "摇头摆尾地游了过来，白白的肚子往上翻着"      );
}

void setup_fish(object ob)
{
  mapping my;
  my = ob->query_entire_dbase();
  my["unit"] = "条";
  ob->set_default_action(__FILE__, "query_action");
  ob->set("default_actions", (: call_other, __FILE__, "query_action" :));

  if( undefinedp(my["gender"]) ) my["gender"] = (random(2))?"雌性":"雄性";
  if( undefinedp(my["age"]) ) my["age"] = random(5) + 5;
  if( undefinedp(my["str"]) ) my["str"] = random(10) + 5;
  if( undefinedp(my["int"]) ) my["int"] = random(10) + 5;
  if( undefinedp(my["con"]) ) my["con"] = random(10) + 5;
  if( undefinedp(my["spi"]) ) my["spi"] = random(10) + 5;
  if( undefinedp(my["dex"]) ) my["dex"] = random(20) + 5;
  if( undefinedp(my["cps"]) ) my["cps"] = random(10) + 5;
  if( undefinedp(my["cor"]) ) my["cor"] = random(5) + 5;
  if( undefinedp(my["per"]) ) my["per"] = random(20) + 5;
  if( undefinedp(my["kar"]) ) my["kar"] = random(10) + 5;

  if( undefinedp(my["max_douzhi"]) )
    my["max_douzhi"] = 200;
  if( undefinedp(my["eff_douzhi"]) )
    my["eff_douzhi"] = my["max_douzhi"];
  if( undefinedp(my["douzhi"]) )
    my["douzhi"] = my["max_douzhi"];

  if( undefinedp(my["max_gin"]) )
  {
    if( my["age"] <= 3 )
      my["max_gin"] = 50;
    else if( my["age"] <= 10 )
      my["max_gin"] = 50 + (my["age"] - 3) * 20;
    else if( my["age"] <= 30 )
      my["max_gin"] = 190 + (my["age"] - 10) * 5;
    else
      my["max_gin"] = my["max_gin"] = 290 + (my["age"] - 30);
  }

  if( undefinedp(my["max_kee"]) )
  {
    if( my["age"] <= 5 )
      my["max_kee"] = 50;
    else if( my["age"] <= 20 )
      my["max_kee"] = 50 + (my["age"] - 5) * 25;
    else
      my["max_kee"] = 425 + (my["age"] - 20) * 5;
  }

  if( undefinedp(my["max_sen"]) )
  {
    if( my["age"] <= 5 )
      my["max_sen"] = 45;
    else if( my["age"] <= 20 )
      my["max_sen"] = 45 + (my["age"] - 5) * 20;
    else
      my["max_sen"] = 400 + (my["age"] - 20) * 5;
  }

	ob->set_default_object(__FILE__);

  if( !ob->query_weight() )
    ob->set_weight(BASE_WEIGHT + (my["str"] - 5)* 500);
}

mapping query_action(object me)
{
  return element_of(combat_action);
}

