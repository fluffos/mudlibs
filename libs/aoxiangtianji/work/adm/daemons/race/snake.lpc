// snake.c 蛇类
#ifndef __SNAKE__
#define __SNAKE__
// A normal beast is at least 100 g weight
#define BASE_WEIGHT 100
#endif
inherit F_DBASE;
mapping *combat_action = ({
([
  "action":    "$N爬上来张嘴往$n的$l狠狠地一咬",
  "damage":    30,
  "damage_type":  "咬伤",
]),
([
  "action":    "$N支起身猛地往$n的$l卷了上来",
  "damage":    30,
  "damage_type":  "瘀伤",
]),
});
void create()
{
  seteuid(getuid());
  set("attitude", "agressive");
  set("limbs", ({
    "头部", "身体", "七寸", "尾巴"
  }) );
  set("dead_message",       "\n$N痛苦地扭动了几下，全身软软地散了开来。\n\n"  );
  set("unconcious_message", "\n$N痛苦地扭了几下，不动了。\n\n"    );
  set("revive_message",     "\n$N身躯一弹一滚，又在地上到处游走开来。\n\n"    );
  set("leave_msg",    "嗖地一声钻了出去"          );
  set("arrive_msg",   "蜿蜒地游了过来"            );
  set("fleeout_message",    "嗖地一声钻了出去"          );
  set("fleein_message",     "缓缓地游了过来，软耷耷地在地上趴着"    );
}

void setup_snake(object ob)
{
    mapping my;
    my = ob->query_entire_dbase();
    ob->set_default_action(__FILE__, "query_action");
	ob->set("default_actions", (: call_other, __FILE__, "query_action" :));

    my["unit"] = "只";
    if( undefinedp(my["gender"]) ) my["gender"] = (random(2))?"雌性":"雄性";
    if( undefinedp(my["age"]) ) my["age"] = random( 15) + 5;
  if( undefinedp(my["str"]) )
    my["str"] = random(10) + 5;

  if( undefinedp(my["int"]) )
    my["int"] = random(10) + 5;

  if( undefinedp(my["con"]) )
    my["con"] = random(10) + 5;

  if( undefinedp(my["spi"]) )
    my["spi"] = random(10) + 5;

  if( undefinedp(my["dex"]) )
    my["dex"] = random(10) + 5;

  if( undefinedp(my["cps"]) )
    my["cps"] = random(10) + 5;

  if( undefinedp(my["cor"]) )
    my["cor"] = random(10) + 5;

  if( undefinedp(my["per"]) )
    my["per"] = random(10) + 5;

  if( undefinedp(my["kar"]) )
    my["kar"] = random(10) + 5;

  if( undefinedp(my["max_douzhi"]) )
    my["max_douzhi"] = 200;
  if( undefinedp(my["eff_douzhi"]) )
    my["eff_douzhi"] = my["max_douzhi"];
  if( undefinedp(my["douzhi"]) )
    my["douzhi"] = my["max_douzhi"];

  if( undefinedp(my["max_gin"]) )
  {
    if( my["age"] <= 3 )
      my["max_gin"] = 50;
    else if( my["age"] <= 10 )
      my["max_gin"] = 50 + (my["age"] - 3) * 20;
    else if( my["age"] <= 30 )
      my["max_gin"] = 190 + (my["age"] - 10) * 5;
    else
      my["max_gin"] = my["max_gin"] = 290 + (my["age"] - 30);
  }

  if( undefinedp(my["max_kee"]) )
  {
    if( my["age"] <= 5 )
      my["max_kee"] = 50;
    else if( my["age"] <= 20 )
      my["max_kee"] = 50 + (my["age"] - 5) * 25;
    else
      my["max_kee"] = 425 + (my["age"] - 20) * 5;
  }

  if( undefinedp(my["max_sen"]) )
  {
    if( my["age"] <= 5 )
      my["max_sen"] = 45;
    else if( my["age"] <= 20 )
      my["max_sen"] = 45 + (my["age"] - 5) * 20;
    else
      my["max_sen"] = 400 + (my["age"] - 20) * 5;
  }

 ob->set_default_object(__FILE__);
  if( !ob->query_weight() ) ob->set_weight(BASE_WEIGHT + (my["str"] - 10)* 2000);
}

mapping query_action(object me)
{
  return element_of(combat_action);
}

