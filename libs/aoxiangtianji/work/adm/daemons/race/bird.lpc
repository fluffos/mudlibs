// bird.c 飞禽
#ifndef __BIRD__
#define __BIRD__
// A normal bird is at least 50 g weight
#define BASE_WEIGHT 50
#endif
inherit F_DBASE;
mapping *combat_action = ({
([
  "action":    "$N用爪子往$n的$l猛地一抓",
  "damage":    10,
  "damage_type":  "抓伤",
]),
([
  "action":    "$N飞过来往$n的$l狠狠地一啄",
  "damage":    30,
  "damage_type":  "刺伤",
]),
([
  "action":    "$N用翅膀向$n的$l拍了过去",
  "damage":    30,
  "damage_type":  "刺伤",
])
});
void create()
{
  seteuid(getuid());
  set("attitude", "peaceful");
  set("limbs", ({
    "头部",  "颈部",  "后背",  "腹部",  "脚爪",  "翅膀"
  }) );
  set("dead_message",       "\n$N发出一声凄厉的鸣叫，从半空中跌了下来。\n\n"    );
  set("unconcious_message", "\n$N从半空中砰地跌下来，晕了过去。\n\n"      );
  set("revive_message",     "\n$N醒过来动弹了一下，双翅一振，又飞了起来。\n\n"  );
  set("leave_msg",    "疾飞而去"              );
  set("arrive_msg",   "飞了过来"              );
  set("fleeout_message",    "凄鸣着疾飞而去"      );
  set("fleein_message",     "缓缓地飞了过来，沉重地在半空中打着旋儿"  );
}

void setup_bird(object ob)
{
  mapping my;
  my = ob->query_entire_dbase();
  my["unit"] = "只";
    ob->set_default_action(__FILE__, "query_action");
	ob->set("default_actions", (: call_other, __FILE__, "query_action" :));

  if( undefinedp(my["gender"]) ) my["gender"] = (random(2))?"雌性":"雄性";

  if( undefinedp(my["age"]) )  my["age"] = random(20) + 5;
  if( undefinedp(my["str"]) ) my["str"] = random(10) + 5;
  if( undefinedp(my["int"]) ) my["int"] = random(10) + 5;

  if( undefinedp(my["con"]) ) my["con"] = random(21) + 5;

  if( undefinedp(my["spi"]) ) my["spi"] = random(21) + 5;

  if( undefinedp(my["dex"]) ) my["dex"] = random(41) + 5;

  if( undefinedp(my["cps"]) ) my["cps"] = random(11) + 5;

  if( undefinedp(my["cor"]) ) my["cor"] = random(11) + 5;

  if( undefinedp(my["per"]) ) my["per"] = random(20) + 5;

  if( undefinedp(my["kar"]) ) my["kar"] = random(21) + 5;

  if( undefinedp(my["max_douzhi"]) )
    my["max_douzhi"] = 200;
  if( undefinedp(my["eff_douzhi"]) )
    my["eff_douzhi"] = my["max_douzhi"];
  if( undefinedp(my["douzhi"]) )
    my["douzhi"] = my["max_douzhi"];

  if( undefinedp(my["max_gin"]) )
  {
    if( my["age"] <= 3 )
      my["max_gin"] = 50;
    else if( my["age"] <= 10 )
      my["max_gin"] = 50 + (my["age"] - 3) * 20;
    else if( my["age"] <= 30 )
      my["max_gin"] = 190 + (my["age"] - 10) * 5;
    else
      my["max_gin"] = my["max_gin"] = 290 + (my["age"] - 30);
  }

  if( undefinedp(my["max_kee"]) )
  {
    if( my["age"] <= 5 )
      my["max_kee"] = 50;
    else if( my["age"] <= 20 )
      my["max_kee"] = 50 + (my["age"] - 5) * 25;
    else
      my["max_kee"] = 425 + (my["age"] - 20) * 5;
  }

  if( undefinedp(my["max_sen"]) )
  {
    if( my["age"] <= 5 )
      my["max_sen"] = 45;
    else if( my["age"] <= 20 )
      my["max_sen"] = 45 + (my["age"] - 5) * 20;
    else
      my["max_sen"] = 400 + (my["age"] - 20) * 5;
  }

       ob->set_default_object(__FILE__);
  if( !ob->query_weight() ) ob->set_weight(BASE_WEIGHT + (my["str"] - 5)* 1000);
  if( ob->query("subrace") == "走禽"){
    set("dead_message",       "\n$N发出一声凄厉的鸣叫，栽倒在地上死了。\n\n"      );
    set("unconcious_message", "\n$N凄鸣一声栽倒在地，晕了过去。\n\n"        );
    set("revive_message",     "\n$N醒过来动弹了一下，双翅扑腾了几下站了起来。\n\n");
    set("comeout_message",    "往$d疾奔而去。\n"              );
    set("comein_message",     "跑了过来。\n"              );
    set("fleeout_message",    "一声凄鸣，往$d疾奔而去。\n"      );
    set("fleein_message",     "摇摇摆摆的跑了过来。\n"          );
  }

}

mapping query_action(object me)
{
  return element_of(combat_action);
}

