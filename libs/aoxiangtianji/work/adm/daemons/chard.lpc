// chard.c
#include <race.h>
#include <skill.h>
void create() { seteuid(getuid()); }

void setup_char(object ob)
{
  string race;
  mapping my;
  if( !stringp(race = ob->query("race")) )
  {
    race = "人类";
    ob->set("race", "人类");
  }

  switch(race)
  {
    case "人类":
      HUMAN_RACE->setup_human(ob);
      break;
    case "妖魔":
      MONSTER_RACE->setup_monster(ob);
      break;
    case "野兽":
      BEAST_RACE->setup_beast(ob);
      break;
    default:
      error("Chard: undefined race " + race + ".\n");
  }

  my = ob->query_entire_dbase();
  if( undefinedp(my["kee"]) || my["kee"] > my["max_kee"])
    my["kee"] = my["max_kee"];
  if( undefinedp(my["sen"]) || my["sen"] > my["max_sen"])
    my["sen"] = my["max_sen"];
  if( undefinedp(my["eff_kee"]) || my["eff_kee"] > my["max_kee"])
    my["eff_kee"] = my["max_kee"];
  if( undefinedp(my["eff_sen"]) || my["eff_sen"] > my["max_sen"])
    my["eff_sen"] = my["max_sen"];
  if( undefinedp(my["douzhi"]) )
    my["douzhi"] = my["max_douzhi"];
  if( undefinedp(my["eff_douzhi"]) )
    my["eff_douzhi"] = my["max_douzhi"];
  if( !ob->query_max_encumbrance() )
    ob->set_max_encumbrance( my["str"]*5000 +
         (int)ob->query_skill("unarmed",1)*200);
  ob->reset_action();
}

varargs object make_corpse(object victim, object killer)
{
  int i;
  object corpse, *inv;
  if (victim->is_ghost())
  {
    inv = all_inventory(victim);
//    inv->owner_is_killed(killer);
    inv -= ({ 0 });
    i = sizeof(inv);
    while(i--)
      inv[i]->owner_is_killed(killer);
    return 0;
  }

  corpse = new(CORPSE_OB);
  corpse->make_corpse(victim, killer);
  return corpse;
}

