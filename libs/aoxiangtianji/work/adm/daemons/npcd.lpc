mapping levels = ([
//      combat_exp   skill_level
//      保证五十万以前任务容易完成，八十万之前简单完成。
        50000      : 20,                // level 1
        100000     : 30,                // level 2
        200000     : 40,                // level 3
        400000     : 50,                // level 4
        500000     : 120,               // level 5
        800000     : 150,               // level 6
        1200000    : 175,               // level 7
        1600000    : 200,               // level 8
        2000000    : 225,               // level 9
        2500000    : 250,               // level 10
        3000000    : 275,               // level 11
        4000000    : 300,               // level 12
        5500000    : 350,               // level 13
        7500000    : 400,               // level 14
        9000000    : 450,               // level 15
        15000000   : 500,               // level 16
        25000000   : 550,               // level 17
]);
int check_level(object ob)
{
  int *exp;
  int i;
  int myexp;
  myexp = (int)ob->query("combat_exp")/3 + (int)ob->query("daoxing")/3*2;
  exp = keys(levels);
  exp = sort_array(exp,0);
  for (i = 0; i < sizeof(exp); i++)
  {
   if (myexp <= exp[i])
     break;
  }

  return i;
}

void init_npc_skill(object ob, int lvl)
{
  int sk_lvl;
  string *ks;
  int i, max_kee;
  int *exp, to_exp;
  mapping ob_sk;
  if (lvl < 1)
    lvl = 1;
  if (lvl > sizeof(levels))
    lvl = sizeof(levels);
  exp = keys(levels);
  exp = sort_array(exp,0);
  to_exp = exp[lvl - 1];
  ob->set("combat_exp", to_exp);
  ob->set("daoxing",to_exp);
  sk_lvl = levels[to_exp];
  ob->set("max_force",sk_lvl*15);
  ob->set("max_mana",sk_lvl*15);
  ob->set("max_force",sk_lvl*30);
  ob->set("max_mana",sk_lvl*30);
  ob->set("force_factor",sk_lvl*15/30);
  ob->set("mana_factor",sk_lvl*15/20);
  max_kee = sk_lvl*10;
  if (max_kee < 1200)
    max_kee = 1200;
  ob->set("max_kee",max_kee);
  ob->set("eff_kee",max_kee);
  ob->set("kee",max_kee);
  ob->set("max_sen",max_kee);
  ob->set("eff_sen",max_kee);
  ob->set("sen",max_kee);
  ob_sk = ob->query_skills();
  if (!mapp(ob_sk) || sizeof(ob_sk) < 1)
  {
    ob->set_skill("force",sk_lvl + random(sk_lvl/2));
    ob->set_skill("spells",sk_lvl + random(sk_lvl/2));
    ob->set_skill("dodge",sk_lvl + random(sk_lvl/2));
    ob->set_skill("unarmed",sk_lvl + random(sk_lvl/2));
    ob->set_skill("parry",sk_lvl + random(sk_lvl/2));
    return;
  }

  ks = keys(ob->query_skills());
  for (i = 0; i < sizeof(ks); i++)
    ob->set_skill(ks[i], sk_lvl + random(sk_lvl/2));
  return;
}

// generate a npc with nation & skill level
object create_npc(string nation, int lvl)
{
  object ob;
  switch (nation)
  {
    case "日本":
      ob = new("/obj/questnpc/japanese");
      NPC_D->generate_jp_name(ob);
      break;
    case "天竺":
      ob = new("/obj/questnpc/indian");
      NPC_D->generate_in_name(ob);
      break;
    case "花剌子模":
    case "龟慈":
    case "东突厥":
    case "西突厥":
    case "楼兰":
    case "匈奴":
      ob = new("/obj/questnpc/maisa");
      NPC_D->generate_ma_name(ob);
      break;
    case "英吉利" :
    case "法兰西" :
    case "西班牙" :
    case "葡萄牙" :
    case "比利时" :
    case "荷兰"   :
      ob = new("/obj/questnpc/european");
      NPC_D->generate_e_name(ob);
      break;
    default :
      return 0;
  }

  ob->set("nation", nation);
  init_npc_skill(ob, lvl);
  return ob;
}

// generate challenger
object create_challenger()
{
  string *n;
  object *ob;
  int max_level;
  int i;
  int lvl;
  ob = all_interactive();
  max_level = 0;
  for (i = 0; i < sizeof(ob); i++)
  {
    if (! wizardp(ob[i]))
      lvl = check_level(ob[i]);
    if ( max_level < lvl )
      max_level = lvl;
  }

  max_level++;
  lvl = 1 + random(max_level);
  if (lvl < 3)
    lvl = max_level;
  n = ({ "日本", "日本", "日本","日本", "日本", "日本", "日本", "日本",
         "天竺", "天竺", "天竺","天竺", "天竺",
         "花剌子模", "东突厥","西突厥","楼兰","匈奴","龟慈",
         "英吉利", "法兰西", "西班牙", "葡萄牙", "比利时", "荷兰", });
  return create_npc(element_of(n), lvl);
}

void set_npc_skill(object ob, int lvl)
{
  string *ks;
  int i;
  if (lvl < 1)
    lvl = 1;

  if (! ob->query_skills())
    return;
  ks = keys(ob->query_skills());
  for (i = 0; i < sizeof(ks); i++)
  {
    if (ks[i] == "magic-cognize" ||
        ks[i] == "martial-cognize")
      continue;
    ob->set_skill(ks[i], lvl);
  }

  return;
}

// set the basic parameter from me
void set_from_me(object tob, object fob, int scale)
{
  mapping my, hp_status;
  mapping skill;
  int i,max_level, max_exp,slvl;
  int *level;
  hp_status = fob->query_entire_dbase();
  my = tob->query_entire_dbase();
  if (! scale)
  {
    if (undefinedp(my["scale"]))
      my["scale"] = 100;
    scale = my["scale"];
  }

  if (scale < 80)
    scale = 80;

  if (scale > 100)
  {
    my["str"] = hp_status["str"] * scale / 100;
    my["int"] = hp_status["int"] * scale / 100;
    my["con"] = hp_status["con"] * scale / 100;
    my["dex"] = hp_status["dex"] * scale / 100;
    my["spi"] = hp_status["spi"] * scale / 100;
  }

  else
  {
    my["str"] = hp_status["str"];
    my["int"] = hp_status["int"];
    my["con"] = hp_status["con"];
    my["dex"] = hp_status["dex"];
    my["spi"] = hp_status["spi"];
  }

  max_exp = (hp_status["max_kee"] + hp_status["max_sen"])/2;

  if (max_exp < hp_status["max_kee"])
    my["max_kee"] = hp_status["max_kee"] * scale / 100;
  else
    my["max_kee"] = max_exp * scale / 100;
  my["eff_kee"] = my["max_kee"];
  my["kee"] = my["max_kee"];

  if (max_exp < hp_status["max_sen"])
    my["max_sen"] = hp_status["max_sen"] * scale / 100;
  else
    my["max_sen"] = max_exp * scale / 100;
  my["eff_sen"] = my["max_sen"];
  my["sen"] = my["max_sen"];
  max_exp = (hp_status["max_force"] + hp_status["max_mana"])/2;

  if (max_exp < hp_status["max_force"])
    my["max_force"] = hp_status["max_force"]* scale / 100;
  else
    my["max_force"] = max_exp* scale / 100;
  my["force_factor"] = my["max_force"] / 30;
  my["force"] = my["max_force"] * 2;
  if (max_exp < hp_status["max_mana"])
    my["max_mana"] = hp_status["max_mana"]* scale / 100;
  else
    my["max_mana"] = max_exp* scale / 100;
  my["mana_factor"] = my["max_mana"] / 20;
  my["mana"] = my["max_mana"] * 2;
  max_exp = (hp_status["combat_exp"] + hp_status["daoxing"])/2;

  if (max_exp < hp_status["combat_exp"])
    my["combat_exp"] = hp_status["combat_exp"]* scale / 100;
  else
    my["combat_exp"] = max_exp* scale / 100;
  if (max_exp < hp_status["daoxing"])
    my["daoxing"] = hp_status["daoxing"]* scale / 100;
  else
    my["daoxing"] = max_exp* scale / 100;
  skill = fob->query_skills();
  i=sizeof(skill);
  if(i>0)
  {
    level=values(skill);
    max_level=level[0];
    while(i--)
    {
      if(level[i]>max_level)
        max_level=level[i];
    }

    max_level = max_level*scale/100;
  }

  else
    max_level=1;
  slvl = fob->query_skill("magic-cognize",1);
  if (max_level > 120 && slvl < max_level/2)
    slvl = max_level/2;
  if (slvl)
    tob->set_skill("magic-cognize",slvl);

  slvl = fob->query_skill("martial-cognize",1);
  if (max_level > 120 && slvl < max_level/2)
    slvl = max_level/2;
  if (slvl)
    tob->set_skill("martial-cognize",slvl);
  set_npc_skill(tob, max_level);
}

// select a random
string random_place(int level)
{
  string *kp;
  kp = keys(place1);
  if (level > 1)
    kp += keys(place2);
  if (level > 2)
    kp += keys(place3);
  return element_of(kp);
}

// place npc
void place_npc(object ob, int level)
{
  string *kp;
  string p;
  string startroom;
// select the place
  kp = keys(place1);
  if (level > 1)
    kp += keys(place2);
  if (level > 2)
    kp += keys(place3);
  kp -= ({0});
// select the exact position
  p = element_of(kp);
  if (member_array(p,keys(place1)) != -1)
    startroom = element_of(place1[p]);
  else if (member_array(p,keys(place2)) != -1)
    startroom = element_of(place2[p]);
  else if (member_array(p,keys(place3)) != -1)
    startroom = element_of(place3[p]);
  else
  {
    kp = keys(place1);
    p = element_of(kp);
    startroom = element_of(place1[p]);
  }

  if (!objectp(load_object(startroom)))
  {
    log_file("quest_xyj/error",sprintf("%s don't find out! maybe the room is not exist!\n",startroom));
    kp = keys(place1);
    p = element_of(kp);
    startroom = element_of(place1[p]);
  }

  if (ob->move(startroom,1))
  {
    ob->set("place", p);
    ob->set("startroom", startroom);
    ob->set_temp("moved", ({ }));
    message_vision("$N走了过来。\n", ob);
    return;
  }

  else
  {
    log_file("quest_xyj/error",sprintf("npc move to %s err! pls check it!\n",startroom));
    return;
  }

}

// get all ultra master
object *query_ultra_master()
{
  return ({ get_object(SUN_WUKONG),
            get_object(BAIFA_LAOREN),
            get_object(HUO_MO),
            get_object(MING_WANG) });
}

object create_quest_npc(object me,object ob,string type,int level)
{
  object quest_npc;
  string place, info;
  int prefix, ratio, mylvl, next_lvl;
//  seteuid(geteuid());
  if (type == "itask" && (string)me->query("quest_xyj/itask/type") == "letter")
    quest_npc = new("/obj/job/quest/npc/receiver");
  else
    quest_npc = new("/obj/questnpc/" + type);

  if (!objectp(quest_npc))
  {
    log_file("quest_xyj/"+type, sprintf("unable to create new quest_npc : %s",
             "/obj/questnpc/" + type));
    tell_object(me,"没有能够成功创建任务所需要的NPC，系统已经自动纪录，也请及时和WIZ联系！\n");
    return 0;
  }

  prefix = 0;

  if (type == "yuan" || type == "menpai" || type == "xue")
    prefix = 1;

  quest_npc->set_npc_family(me, 0, prefix, type);

  place_npc(quest_npc,level);

  mylvl = (int)me->query("level");
  ratio = 0;
  switch (type)
  {
    case "xue" :
      if (mylvl <= 30)
      {
        quest_npc->set("chat_chance_combat", 5);
        quest_npc->set("chat_chance",5);
        ratio = 95;
      }

      else if (mylvl <= 35)
      {
        quest_npc->set("chat_chance_combat", 10);
        quest_npc->set("chat_chance",5);
        ratio = 100;
      }

      else if (mylvl <= 40)
      {
        ratio = 110 + random(10);
        quest_npc->set("chat_chance",10);
      }

      else
        ratio = 110 + random(20);
      set_from_me(quest_npc, me, ratio);
      break;
    case "menpai" :
      if (mylvl <= 30)
      {
        ratio = 95;
        quest_npc->set("chat_chance",5);
        quest_npc->set("chat_chance_combat", 10);
      }

      else if (mylvl <= 40)
      {
        ratio = 100;
        quest_npc->set("chat_chance",10);
        quest_npc->set("chat_chance_combat", 20);
      }

      else if (mylvl <= 50)
        ratio = 105 + random(10);
      else
        ratio = 105 + random(20);
      set_from_me(quest_npc, me, ratio);
      break;
    case "yuan" :
      next_lvl = me->query_temp("yuan/next_lv");
      if (quest_npc->query("extra_diff"))
        if (next_lvl < 9)
          next_lvl++;
      if (mylvl <= 30)
      {
        quest_npc->set("chat_chance_combat", 5);
        quest_npc->set("chat_chance",5);
        ratio = 80 + next_lvl*3;
      }

      else if (mylvl <= 35)
      {
        quest_npc->set("chat_chance_combat", 10);
        quest_npc->set("chat_chance",10);
        ratio = 90 + next_lvl*3;
      }

      else if (mylvl <= 40)
        ratio = 90 + next_lvl*5;
      else
        ratio = 100 + next_lvl*5;
      set_from_me(quest_npc, me, ratio);
      break;
    case "lijing" :
      next_lvl = me->query_temp("lijing/next_lv");
      if (quest_npc->query("extra_diff"))
        if (next_lvl < 11)
          next_lvl++;
      if (mylvl <= 35)
      {
        ratio = 80 + next_lvl*4;
        if (next_lvl < 11)
        {
          quest_npc->set("chat_chance",5);
          quest_npc->set("chat_chance_combat", 10);
        }

      }

      else if (mylvl <= 45)
      {
        ratio = 85 + next_lvl*5;
        if (next_lvl < 11)
        {
          quest_npc->set("chat_chance",10);
          quest_npc->set("chat_chance_combat", 20);
        }

      }

      else if (mylvl <= 55)
        ratio = 90 + next_lvl*5;
      else
        ratio = 100 + next_lvl*5;
      if (next_lvl > 10)
        ratio += random(10);
      set_from_me(quest_npc, me, ratio);
      break;
    case "itask" :
      next_lvl = me->query_temp("itask/next_lv");
      if (mylvl < 30)
        ratio = 90 + next_lvl*5;
      else if (mylvl < 45)
        ratio = 95 + next_lvl*8;
      else
        ratio = 105 + next_lvl*10;
      set_from_me(quest_npc, me, ratio);
      quest_npc->add_temp("apply/attack", next_lvl*25);
      quest_npc->add_temp("apply/dodge", next_lvl*25);
      quest_npc->add_temp("apply/damage", 5 + next_lvl*15);
      quest_npc->add_temp("apply/unarmed_damage", 5 + next_lvl*7);
      quest_npc->add_temp("apply/armor", 20 + next_lvl*15);
      break;
    case "pantu" :
      ratio = 90 + random(10);
      set_from_me(quest_npc, me, ratio);
      quest_npc->add_temp("apply/attack", 50);
      quest_npc->add_temp("apply/dodge", 50);
      quest_npc->add_temp("apply/damage", 8);
      quest_npc->add_temp("apply/unarmed_damage", 10);
      quest_npc->add_temp("apply/armor", 15);
      break;
    case "rulai" :
      ratio = 95 + random(10);
      next_lvl = (int)me->query("quest_xyj/rulai/level");
      if (next_lvl < 1)
        next_lvl = 1;
      if (next_lvl > 5)
        next_lvl = 5;
      set_from_me(quest_npc, me, ratio + next_lvl*10);
      quest_npc->add_temp("apply/attack", 15*next_lvl);
      quest_npc->add_temp("apply/dodge", 15*next_lvl);
      quest_npc->add_temp("apply/damage", 8*next_lvl);
      quest_npc->add_temp("apply/unarmed_damage", 10*next_lvl);
      quest_npc->add_temp("apply/armor", 8*next_lvl);
      break;
  }

  quest_npc->set("quester",me->query("id"));
  quest_npc->set("quest_type",type);

  place = quest_npc->query("place");
  info = "quest_xyj/" + type + "/";
  me->set(info+"npc_id",quest_npc->query("id"));
  me->set(info+"npc_name",quest_npc->name());
  me->set(info+"npc_place",place);
  me->set(info+"master_id", ob->query("id"));
  me->set(info+"family_name",(string)me->query("family/family_name"));
  me->set(info+"s_time",time());
  me->set(info+"f_time",time()+ 600);
  return quest_npc;
}

