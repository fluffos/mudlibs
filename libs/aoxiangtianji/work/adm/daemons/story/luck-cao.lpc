#include <ansi.h>
string give_gift();
inherit F_CLEAN_UP;
nosave mixed *story = ({
    "太白金星：你说为什么有人运气好，有人就差了呢？",
    "福星：嘿嘿，老夫照顾了谁，谁的运气就好点。",
    "太白金星：那赤脚大仙是不是给了你什么好处，运气比我好多了。",
    "福星：嗯...什么？",
    "太白金星：我炼了两颗丹，我吃了肚子剧痛，那老小子怎么就精神焕发？",
    "福星：嘿嘿，有些事情，看开点。",
    "太白金星偷偷的拿出了一颗丹，悄悄的塞给了福星",
    "福星：哇，这.。。",
    "太白金星：帮帮忙嘛，。。。",
    "。。。",
    "福星四周瞧瞧，给了太白金星一棵草",
    "太白金星：啊，一颗烂草啊，呸。。。",
    "太白金星把草给扔了，一转身回家了。",
    (: give_gift :),
});
void create()
{
  seteuid(getuid());
}

mixed query_story_message(int step)
{
  return step < sizeof(story) ? story[step] : 0;
}

string give_gift()
{
  STORY_D->give_gift("/d/obj/gift/kar1", 1,
                HIM "\n“啪”的一声一颗仙草掉到你面前。\n\n" NOR);
  return "福星：那是我的草啊。。。\n";
}