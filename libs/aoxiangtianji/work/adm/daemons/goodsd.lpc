public int is_goods(string goods)
{
  string *kb;

  kb = keys(b_goods) - ({0});
  return (member_array(goods,kb) != -1);
}

public string* query_type_goods(string type)
{
  if (!stringp(type) || undefinedp(b_type[type]))
    return ({});
  return arrayp(b_type[type]) ? b_type[type] : 0;
}

public string *query_all_goods()
{
  return keys(b_goods) - ({0});
}

public string *query_all_zone()
{
  return keys(b_place) - ({0});
}

public string* query_zone_citys(string zone)
{
  if (!stringp(zone) || undefinedp(b_place[zone]))
    return ({});
  return arrayp(b_place[zone]) ? b_place[zone] : 0;
}

public int is_valid_business_city(string city)
{
  int i;
  string *kz = keys(b_place);

  for (i=0;i<sizeof(kz);i++)
  {
    if (member_array(city,query_zone_citys(kz[i])) != -1)
      break;
  }

  return i<sizeof(kz);
}

public string query_goods_type(string goods)
{
  string *kb = keys(b_type);
  int i;
  if (!is_goods(goods))
    return 0;
  for (i=0;i<sizeof(kb);i++)
    if (member_array(goods,b_type[kb[i]]) != -1)
      break;
  if (i >= sizeof(kb))
    return 0;
  return kb[i];
}

public string query_goods_type_c(string goods)
{
  string tmp = query_goods_type(goods);
  if (!stringp(tmp) || !b_race[tmp])
    return 0;
  return b_race[tmp];
}

public string query_city_zone(string city)
{
  string *kz = keys(b_place);
  int i;

  if (!stringp(city))
    return 0;
  for(i=0;i<sizeof(kz);i++)
    if (member_array(city,b_place[kz[i]]) != -1)
      break;
  if (i >= sizeof(kz))
    return 0;
  return kz[i];
}

public string query_zone_cname(string zone)
{
  if (!stringp(zone) || !b_zone_name[zone])
    return 0;
  return b_zone_name[zone];
}

public string query_city_zone_c(string city)
{
  string tmp = query_city_zone(city);
  return query_zone_cname(tmp);
}

public mapping query_goods_class_info(string goods)
{
  mixed *cg;

  if (!is_goods(goods))
    return 0;
  cg = b_goods[goods];
  if (!arrayp(cg) || sizeof(cg) < 1)
    return 0;
  return mapp(cg[REQUIRE]) ? cg[REQUIRE] : 0;
}

public int query_goods_class_base_price(string goods,int lvl)
{
  mapping class_p = query_goods_class_info(goods);
  if (!mapp(class_p) || sizeof(class_p) < 1 || lvl < 1 || lvl > 5)
    return 0;
  return class_p[sprintf("%d",lvl)]["base_price"];
}

public int query_goods_class_month_add(string goods,int lvl)
{
  mapping class_p = query_goods_class_info(goods);
  if (!mapp(class_p) || sizeof(class_p) < 1)
    return 0;
  return class_p[sprintf("%d",lvl)]["month_add"];
}

public string* query_goods_city(string goods)
{
  string *result;
  mixed *cg;

  if (!is_goods(goods))
    return ({});
  cg = b_goods[goods];
  if (!arrayp(cg) || sizeof(cg) < 1)
    return ({});
  result = ({});
  if (stringp(cg[FIRST_PLACE]))
    result += ({cg[FIRST_PLACE]});
  if (stringp(cg[SECOND_PLACE]))
    result += ({cg[SECOND_PLACE]});
  if (stringp(cg[THIRD_PLACE]))
    result += ({cg[THIRD_PLACE]});
  return result;
}

public string *query_city_goods(string city)
{
  string tmp, *result,*kb;
  mixed *cg;

  kb = keys(b_goods) - ({0});
  result = ({});
  foreach (tmp in kb)
  {
    reset_eval_cost();
    cg = b_goods[tmp];
    if ((!stringp(cg[FIRST_PLACE]) || cg[FIRST_PLACE] != city) &&
        (!stringp(cg[SECOND_PLACE]) || cg[SECOND_PLACE] != city) &&
        (!stringp(cg[THIRD_PLACE]) || cg[THIRD_PLACE] != city))
      continue;
    result += ({tmp});
  }

  return result - ({0});
}

public string *query_zone_goods(string zone)
{
  int i;
  string city,*result,*zone_citys;
  string *city_goods;

  zone_citys = query_zone_citys(zone);
  result = ({});
  foreach (city in zone_citys)
  {
    reset_eval_cost();
    city_goods = query_city_goods(city);
    for (i=0;i<sizeof(city_goods);i++)
      if (member_array(city_goods[i],result) == -1)
        result += ({city_goods[i]});
  }

  return result - ({0});
}

public string* query_city_trade(string city)
{
  int i,dev, cul, sci;
  string tmp, *result,*kb;
  mixed *cg;

  dev = BUSINESS_D->query_city_info(city,"develop");
  cul = BUSINESS_D->query_city_info(city,"culture");
  sci = BUSINESS_D->query_city_info(city,"science");

  if (!dev || !cul || !sci)
    return ({});
  kb = keys(b_goods) - ({0});
  result = ({});
  foreach (tmp in kb)
  {
    reset_eval_cost();
    cg = b_goods[tmp];
    if ((!stringp(cg[FIRST_PLACE]) || cg[FIRST_PLACE] != city) &&
        (!stringp(cg[SECOND_PLACE]) || cg[SECOND_PLACE] != city) &&
        (!stringp(cg[THIRD_PLACE]) || cg[THIRD_PLACE] != city))
      continue;
    for (i=5;i>0;i--)
    {
      if (cg[REQUIRE][sprintf("%d",i)]["develop"] <= dev &&
          cg[REQUIRE][sprintf("%d",i)]["culture"] <= cul &&
          cg[REQUIRE][sprintf("%d",i)]["science"] <= sci)
        break;
    }

    if (i > 0)
      result += ({sprintf("%s#%d",tmp,i)});
  }

  return result;
}

public int query_goods_next_class_dev(string goods,int lvl)
{
  mixed *cg;
  if (!is_goods(goods))
    return 0;
  cg = b_goods[goods];
  if (!mapp(cg[REQUIRE]) || sizeof(cg[REQUIRE]) < 1)
    return 0;
  return mapp(cg[REQUIRE][sprintf("%d",lvl+1)]) ? cg[REQUIRE][sprintf("%d",lvl+1)]["develop"] : 0;
}

public int query_goods_next_class_cul(string goods,int lvl)
{
  mixed *cg;
  if (!is_goods(goods))
    return 0;
  cg = b_goods[goods];
  if (!mapp(cg[REQUIRE]) || sizeof(cg[REQUIRE]) < 1)
    return 0;
  return mapp(cg[REQUIRE][sprintf("%d",lvl+1)]) ? cg[REQUIRE][sprintf("%d",lvl+1)]["culture"] : 0;
}

public int query_goods_next_class_sci(string goods,int lvl)
{
  mixed *cg;
  if (!is_goods(goods))
    return 0;
  cg = b_goods[goods];
  if (!mapp(cg[REQUIRE]) || sizeof(cg[REQUIRE]) < 1)
    return 0;
  return mapp(cg[REQUIRE][sprintf("%d",lvl+1)]) ? cg[REQUIRE][sprintf("%d",lvl+1)]["science"] : 0;
}

public int query_zone_diff(string zone1, string zone2)
{
  return zone_diff[zone1][zone2];
}

void create()
{
  seteuid(getuid());
}