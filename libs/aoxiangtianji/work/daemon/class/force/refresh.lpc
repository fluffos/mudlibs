// refresh.c
//inherit SSERVER;
int valid_exert(object me, object target)
{
  string force_skill;
  int heal;

  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if (target != me)
    return notify_fail("你只能用内功恢复自己的精力。\n");

  force_skill = me->query_skill_mapped("force");
  if (!stringp(force_skill) || ((int)me->query_skill(force_skill,1)==0))
    return notify_fail("先激发你的特殊内功。\n");

  heal = (int)me->query("eff_sen") - (int)me->query("sen");
  if (heal < 10)
    return notify_fail("你现在精气旺盛。\n");

  return 1;
}

int exert(object me, object target)
{
  int force_cost;
  int lvl;
  int heal;
  string force_skill;
  int skill_eff;

  notify_fail("你失败了！\n");
  if (!valid_exert(me,target))
    return 0;

  force_skill = me->query_skill_mapped("force");

  heal = (int)me->query("eff_sen") - (int)me->query("sen");
  lvl = me->query_skill("force");
  if (lvl <= 0)
    lvl = 1;
  force_cost = heal * 60 / lvl;
  if (me->query("breakup"))
    force_cost = force_cost * 7 / 10;
  if (force_cost < 20) force_cost = 20;
  if (force_cost > me->query("force"))
  {
    force_cost = me->query("force");
    heal = force_cost * lvl / 60;
  }

  if (force_cost < 20) force_cost = 20;
  if ((int)me->query("force") < force_cost)
  {
    write("你的内力不够。\n");
    return 0;
  }

  skill_eff = SKILL_D(force_skill)->query_power_effect(me);
  if (intp(skill_eff) && skill_eff >= 100)
  {
    heal = heal*skill_eff/100 ;
    force_cost= force_cost*100/skill_eff;
  }

  me->add("force", -force_cost);
  me->receive_heal("sen", heal);

  message_vision("$N深深吸了几口气，精神看起来好多了。\n", me);
//  if (me->is_fighting())
//    me->start_busy(1);

  return 1;
}

