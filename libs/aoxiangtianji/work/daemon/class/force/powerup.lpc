#include <ansi.h>
inherit F_CLEAN_UP;
#define P_FILE "/daemon/class/force/powerup"
#define CAUSED "powerup"
int valid_exert(object me, object target)
{
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if( (int)me->query("force") < 200 )
    return notify_fail("你的内力不够。\n");
  if(me->query_temp(CAUSED))
    return notify_fail("你已经在运功中了。\n");

  return 1;
}

int exert(object me, object target)
{
  int skill;
  int ratio, extra;
  string force_skill;

  force_skill = me->query_skill_mapped("force");

  if (!stringp(force_skill))
    return notify_fail("你必须选择一种内功，才可以使用这个功能！\n");

  if(objectp(target) && target != me )
    return notify_fail(sprintf("你只能用%s提高自己的战斗力。\n",to_chinese(force_skill)));
  skill = me->query_skill(force_skill,1);
  if (skill < 100)
    return notify_fail(sprintf("你的%s级别不够，无法运用这个功能！\n",to_chinese(force_skill)));

  ratio = SKILL_D(force_skill)->query_power_effect(me);
  if (ratio < 100)
    ratio = 100;

  me->add("force", -100);
  me->receive_damage("kee", 0);

  message_combatd(sprintf(HIR"$N微一凝神，运起%s，顿时感觉力量十足。\n"NOR,to_chinese(force_skill)), me);
  if (skill > 300)
    skill = 300;

  extra = skill/5;
  extra = extra*ratio/100;

  me->set_bless_changed(P_FILE,CAUSED,"attack",skill*ratio/200,extra);
  me->set_bless_changed(P_FILE,CAUSED,"defense",skill*ratio/200,extra);
  if(userp(me) && me->is_fighting() )
    me->start_busy(3);
  return 1;
}

void remove_effect(object me)
{
  if (objectp(me) && me->query_temp(CAUSED))
    tell_object(me,"你的内力运行一周天完毕，缓缓收回丹田。\n");
}

