// recover.c
int valid_exert(object me, object target)
{
  string force_skill;
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me != target)
    return notify_fail("你只能用内功调匀自己的气息。\n");

  force_skill = me->query_skill_mapped("force");
  if (!stringp(force_skill) || ((int)me->query_skill(force_skill,1)==0))
    return notify_fail("先激发你的特殊内功。\n");

  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够。\n");

  return 1;
}

int exert(object me, object target)
{
  int n, q, skill_eff;
  string force_skill;
  if (!valid_exert(me,target))
    return 1;

  force_skill = me->query_skill_mapped("force");
  q = (int)me->query("eff_kee") - (int)me->query("kee");
  if (q < 10)
  {
    write("你现在气力充沛。\n");
    return 0;
  }

  n = 100 * q / me->query_skill("force");
  if (me->query("breakup"))
    n = n * 7 / 10;
  if (n < 20)
    n = 20;
  if ((int)me->query("force") < n)
  {
    q = q * (int)me->query("force") / n;
    n = (int)me->query("force");
  }

  skill_eff = SKILL_D(force_skill)->query_power_effect(me);
  if (intp(skill_eff) && skill_eff >= 100)
  {
    q = q*skill_eff/100 ;
    n= n*100/skill_eff;
  }

  me->add("force", -n);
  me->receive_heal("kee", q);
  message_vision("$N深深吸了几口气，脸色看起来好多了。\n", me);
//  if (me->is_fighting())
//    me->start_busy(1);
  return 1;
}

