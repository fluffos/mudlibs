#include <ansi.h>
inherit SSERVER;
int valid_exert(object me, object target)
{
  if (me != target)
    return notify_fail("你只能对自己使用。\n");

  if (me->is_fighting() || me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if (me->query("daoxing")<500000)
    return notify_fail("你的道行不够。\n");

  return 1;
}

int exert(object me, object target)
{
  int age,gain,mana,makeuplev;
  if (!valid_exert(me,target))
    return 1;

  makeuplev=me->query_skill("makeup",1);

  if (makeuplev<100)
    return notify_fail("你的养颜术还没有学到家。\n");

  mana=me->query("sen");
  if(mana<50)
    return notify_fail("你的精力不够了。\n");

  me->add("sen", -50);
  me->start_busy(2);
  age=me->query("age");

  write(HIG"你闭目凝神，觉得似乎年轻了些。\n"NOR);

  gain=(makeuplev-99)*8;
  if (age>50) gain*=10;
  if (age<16) gain/=10;
  me->add_temp("age_modify",-gain);
  me->improve_skill("makeup",1,0);
  me->update_age();
  return 1;
}

