#include <ansi.h>
#include <combat.h>
#define BIBO "「" HIB "碧波浪涌" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "东海龙宫")
    return notify_fail(BIBO"是东海龙宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("dingbo-fork", 1) < 120)
    return notify_fail("你的定波叉修为不够，难以施展" BIBO "。\n");
  if (me->query_skill("dragonforce", 1) < 120)
    return notify_fail("你的龙神心法修为不够，难以施展" BIBO "。\n");
  if (me->query_skill_mapped("fork") != "dingbo-fork")
    return notify_fail("你没有激发定波叉，难以施展" BIBO "。\n");
  if (me->query("force") < 120)
    return notify_fail("你的真气不够，难以施展" BIBO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "fork")
    return notify_fail("你使用的武器不对，难以施展" BIBO "。\n");
  msg = HIC "$N" HIC"作龙吟之声，踏碧波而来，$n只看到$N化做数团身影，"NOR +
        HIC"漫天叉影席卷而来，$n奋力一架，但叉分数路，着实难以招架！\n"NOR;
  message_combatd(msg, me, target);
  for (i=1;i<=3;i++)
  {
    if (!living(target) || (environment(me) != environment(target)))
      break;
    COMBAT_D->do_attack(me, target, weapon);
    me->add("force",-20);
  }

  me->start_busy(1+random(3));
  return 1;
}