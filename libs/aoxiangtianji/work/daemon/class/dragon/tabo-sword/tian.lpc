#include <ansi.h>
#include <combat.h>
#define TIAN "「" HIC "天外清音" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "东海龙宫")
    return notify_fail(TIAN"是东海龙宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("tabo-sword", 1) < 120)
    return notify_fail("你的踏波奏萧剑修为不够，难以施展" TIAN "。\n");
  if (me->query_skill("dragonforce", 1) < 120)
    return notify_fail("你的龙神心法修为不够，难以施展" TIAN "。\n");
  if (me->query_skill_mapped("sword") != "tabo-sword")
    return notify_fail("你没有激发定波叉，难以施展" TIAN "。\n");
  if (me->query("force") < 400)
    return notify_fail("你的真气不够，难以施展" TIAN "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int  i, j;
  int damage;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对，难以施展" TIAN "。\n");
  msg = HIC "$N" HIC "一声清啸，手中" + weapon->name() +
        HIC "剑发琴音，闪动不止，剑影如夜幕般扑向$n" HIC "。\n" NOR;
  if (COMBAT_D->perform_success(me, target,
                                ({"sword","force"}),
                                ({"dodge","parry"}),
                                120))
  {
     me->add("force", -100);
     damage = (int)me->query_skill("sword") +
               random((int)me->query_skill("force") + 1);
     damage = damage/3 + random(damage);
     msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                                 HIR "$n" HIR "顿时觉得眼前金光乱闪动，双耳嗡嗡"
                                     "内鸣，全身便如针扎一般！\n" NOR);
  }

  else
  {
    me->add("force", -50);
    msg += CYN "可是$n" CYN "宁心静气，随手挥洒，将$N"
           CYN "的招数撇在一边。\n"NOR;
  }

  message_combatd(msg, me, target);
  if (me->query_skill("tabo-sword",1) > 200 &&
      me->query("force") > 200 &&
      living(target) &&
      me->is_fighting(target))
  {
    message_vision(HIW"$N" HIW"强提真气，手中" + weapon->name() +
                   HIW"在那剑幕之中闪电连击！\n\n"NOR,me);
    j = me->query_temp("apply/attack");
    for (i = 1;i <= 3; i++)
    {
      me->add_temp("apply/attack", i*40);
      if (!target->is_busy() && (random(3)==1))
        target->start_busy(2);
      COMBAT_D->do_attack(me, target, weapon);
      me->add("force",-30);
    }

    me->set_temp("apply/attack", j);
  }

  me->start_busy(2+random(2));
  return 1;
}