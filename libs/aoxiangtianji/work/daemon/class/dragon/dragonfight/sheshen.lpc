#include <ansi.h>
#include <combat.h>
#define SHE "「" HIR "舍身技" NOR "」"
inherit F_SSERVER;
int is_not_attack() { return 0; }

int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "东海龙宫")
    return notify_fail(SHE "是东海龙宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("dragonfight", 1) < 120)
    return notify_fail("你的龙神搏击修为不够，难以施展" SHE "。\n");
  if (me->query_skill("dragonforce", 1) < 120)
    return notify_fail("你的龙神心法修为不够，难以施展" SHE "。\n");
  if (me->query_skill_mapped("unarmed") != "dragonfight")
    return notify_fail("你没有激发龙神搏击，难以施展" SHE "。\n");
  if (me->query("force") < 500)
    return notify_fail("你的真气不够，难以施展" SHE "。\n");
  return 1;
}

int perform(object me, object target)
{
  string msg, str;
  int ap, dp;
  int damage;
  object weapon;

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail(SHE "只能空手施展。\n");

  weapon = target->query_temp("weapon");

  msg = CYN "$N" CYN"右掌挥出，斩向" CYN"$n" CYN"的左肩，\n"NOR;
  if (objectp(weapon))
    str = CYN"手中的"NOR + weapon->name();
  else
    str = CYN"右手"NOR;
  msg += CYN"$n" CYN"想用"NOR + str + CYN"挡开，不料却被" CYN"$N" CYN"一把抓住。\n"NOR;
  msg += CYN"$N" CYN"顺势上步，使出了"NOR + SHE + CYN"！\n\n" NOR;
  msg += CYN "$N" CYN"左脚铲向" CYN"$n" CYN"右腿膝盖。"NOR;

  if (COMBAT_D->perform_success(me, target,({"unarmed","dodge"}),({"parry","dodge"}),110))
  {
    damage = me->query_skill("unarmed");
    damage += me->query_skill("force")/3;
    damage = damage/2 + random(damage);
    damage -= target->query_cps();
    msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 20,
                       HIR"结果正铲在" HIR"$n" HIR"的小腿上。\n" NOR);
    me->add("force", -50);
  }

  else
  {
    msg += HIW"结果被" HIW"$n" HIW"提腿挡开了。\n" NOR;
    me->add("force", -30);
  }

  message_combatd(msg, me, target);

  if (!target->is_fighting(me))
  {
    me->start_busy(1+random(3));
    return 1;
  }

  msg = CYN "\n紧跟着" CYN"$N" CYN"收左脚，提左膝撞向" CYN"$n" CYN"的软肋，\n"NOR;
  msg += CYN"同时右手曲肘撞向" CYN"$n" CYN"的面门。";

  damage = me->query_skill("unarmed");
  damage = random(damage/10 + 1);
  if (damage > 50)
    damage = 50;

  ap = COMBACC_D->math_ap(me,"unarmed");
  dp = COMBACC_D->math_pp(me,target,-damage,0);

  if (COMBAT_D->perform_success(me, target,ap,dp,105))
  {
    damage = me->query_skill("force");
    damage += random(me->query_skill("dragonfight",1)+1);
    damage = damage/2 + random(damage);
    msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 30,
                       HIR"结果一击正中" HIR"$n" HIR"。\n" NOR);
    me->add("force", -50);
  }

  else
  {
    msg += HIW"结果被" HIW"$n" HIW"挡开了。\n" NOR;
    me->add("force", -30);
  }

  message_combatd(msg, me, target);
  if (!target->is_fighting(me))
  {
    me->start_busy(1+random(3));
    return 1;
  }

  msg = CYN "$N" CYN"接着顺势用右手抓住" CYN"$n" CYN"右臂，半转身将" CYN"$n" CYN"摔了出去。"NOR;
  damage = me->query_skill("unarmed");
  damage = random(damage/10 + 1);
  if (damage > 50)
    damage = 50;

  ap = COMBACC_D->math_ap(me,"unarmed");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);

  if (COMBAT_D->perform_success(me, target,ap,dp,105))
  {
    damage = me->query_skill("force");
    damage += random(me->query_skill("unarmed",1)+1);
    damage = damage/2 + random(damage);
    msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 40,
                       HIR"结果" HIR"$n" HIR"一个跟头摔倒在了地上。\n" NOR);
    me->add("force", -100);
  }

  else
  {
    msg += HIW"结果被" HIW"$n" HIW"一个踉跄，却没摔倒。\n"NOR;
    me->add("force", -50);
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}