#include <ansi.h>
#include <combat.h>
#define SHE "「" HIR "龙翔天下" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "东海龙宫")
    return notify_fail(SHE "是东海龙宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("dragonfight", 1) < 180)
    return notify_fail("你的龙神搏击修为不够，难以施展" SHE "。\n");
  if (me->query_skill("dragonforce", 1) < 180)
    return notify_fail("你的龙神心法修为不够，难以施展" SHE "。\n");
  if (me->query_skill_mapped("unarmed") != "dragonfight")
    return notify_fail("你没有激发龙神搏击，难以施展" SHE "。\n");
  if (me->query("force") < 800)
    return notify_fail("你的真气不够，难以施展" SHE "。\n");
  return 1;
}

int perform(object me, object target)
{
  int damage;
  string msg;
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail(SHE "只能空手使用。\n");
  message_sort(HIW "\n忽然间$N" HIW "身形激进，左手一划，右手呼的一掌，便"
               "向$n" HIW "击去，正是龙神搏击「" NOR + SHE + HIW "」一招，"
               "\n力自掌生之际说到便到，以排山倒海之势向$n" HIW"狂涌而去，当真石"
               "破天惊，威力无比。\n" NOR, me, target);
  if (COMBAT_D->perform_success(me, target,
                                ({(int)me->query_skill("unarmed"),me->query("str") * 10}),
                                ({(int)target->query_skill("dodge"),target->query("dex") * 8}),
                                130))
  {
    damage = (int)me->query_skill("unarmed") + me->query("str") * 8;
    damage = damage/2 + random(damage);
    msg = COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 30,
                  HIR "$p" HIR "一楞，只见$P" HIR "身形"
                      "一闪，已晃至自己跟前，躲闪不及，被击"
                      "个正中。\n:内伤@?");
    me->add("force", -50 - random(50));
    message_vision(msg, me, target);
  }

  else
  {
     msg = HIC "$p" HIC "气贯双臂，凝神应对，游刃有余，$P"
           HIC "掌力如泥牛入海，尽数卸去。\n" NOR;
     me->add("force", -30 - random(30));
     message_vision(msg, me, target);
  }

  if (!living(target) || !target->is_fighting(me))
  {
    me->start_busy(1+random(3));
    return 1;
  }

  message_sort(HIW "\n$N" HIW "一掌既出，身子已然抢到离$n" HIW "三四丈之外"
               "，后掌推前掌，两股掌力道合并，又是一招" NOR + SHE + HIW "攻出，"
               "\n掌力犹如怒潮狂涌，势不可当。霎时$n" HIW"便觉气息窒滞，立足不稳。\n"NOR,
               me, target);
  if (COMBAT_D->perform_success(me, target,
                                ({(int)me->query_skill("unarmed"),me->query("cor") * 10}),
                                ({(int)target->query_skill("parry"),target->query("cps") * 8}),
                                115))
  {
    damage = me->query_skill("unarmed") + me->query("cor")*10;
    damage = damage*2/3 + random(damage);
    msg = COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 40,
               HIR "只听$p" HIR "一声惨嚎，被$P" HIR
               "一掌击中胸前，“喀嚓喀嚓”断了几根肋"
               "骨。\n:内伤@?");
    me->add("force", -60 - random(60));
    message_vision(msg, me, target);
  }

  else
  {
    msg = HIC "$p" HIC "气贯双臂，凝神应对，游刃有余，$P"
          HIC "掌力如泥牛入海，尽数卸去。\n" NOR;
    me->add("force", -30 - random(30));
    message_vision(msg, me, target);
  }

  if (!living(target) || !target->is_fighting(me))
  {
    me->start_busy(1+random(3));
    return 1;
  }

  message_sort(HIW "\n紧跟着$N" HIW "一声暴喝，右掌斜斜挥出，前招掌力未消"
               "，此招掌力又到，竟然又攻出一招" NOR + SHE + HIW "，\n掌夹风"
               "势，势如破竹，便如一堵无形气墙，向前疾冲而去。$n" HIW "只觉"
               "气血翻涌，气息沉浊。\n" NOR, me, target);
  if (COMBAT_D->perform_success(me, target,
                                ({(int)me->query_skill("unarmed"),me->query("cor")*5,me->query("str")*5}),
                                ({(int)target->query_skill("force"),target->query("cps")*4,target->query("con")*5}),
                                105))
  {
    damage = me->query_skill("unarmed") + me->query("str")*5 + me->query("cor")*5;
    damage = damage + random(damage);
    msg = COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 50,
               HIR "结果$p" HIR "躲闪不及，$P" HIR
               "的掌劲顿时穿胸而过，“哇”的喷出一大"
               "口鲜血。\n:内伤@?");
    message_vision(msg, me, target);
    me->start_busy(2 + random(2));
    me->add("force", -100 - random(100));
    return 1;
  }

  else
  {
    msg = HIC "$p" HIC "见这招来势凶猛，身形疾退，瞬间飘出三"
          "丈，脱出$P" HIC "掌力之外。\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(2 + random(2));
    me->add("force", -70 - random(70));
    return 1;
  }

  return 1;
}