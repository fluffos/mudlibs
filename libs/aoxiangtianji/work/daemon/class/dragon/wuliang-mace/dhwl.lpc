#include <ansi.h>
#include <combat.h>
#define BIBO "「" HIB "大海无量" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "东海龙宫")
    return notify_fail(BIBO"是东海龙宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("wuliang-mace", 1) < 120)
    return notify_fail("你的无量锏修为不够，难以施展" BIBO "。\n");
  if (me->query_skill("dragonforce", 1) < 120)
    return notify_fail("你的龙神心法修为不够，难以施展" BIBO "。\n");
  if (me->query_skill_mapped("mace") != "wuliang-mace")
    return notify_fail("你没有激发无量锏，难以施展" BIBO "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" BIBO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i,j;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "mace")
    return notify_fail("你使用的武器不对，难以施展" BIBO "。\n");
  msg = HIC "$N" HIC"手中双锏忽快忽慢，招招式式出人意料。" HIC"$n"
        HIC"正觉吃力时，这双锏骤愈暴雨般的劈头盖脸的砸了过来！\n"NOR;
  message_combatd(msg, me, target);
  j = me->query_temp("apply/attack");
  for (i=1;i<=4;i++)
  {
    if (!living(target) || (environment(me) != environment(target)))
      break;
    me->add_temp("apply/attack", i*40);
    if ((random(3) == 0) && !target->is_busy())
      target->start_busy(2);
    COMBAT_D->do_attack(me, target, weapon);
    me->add("force",-20);
  }

  me->set_temp("apply/attack", j);
  me->start_busy(1+random(3));
  return 1;
}