#include <ansi.h>
#include <combat.h>
#define FU "「" HIR "龙神" NOR "」"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "东海龙宫")
    return notify_fail(sprintf("%s是东海龙宫不传之密！\n",FU));
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("seashentong", 1) < 100)
    return notify_fail(sprintf("你的碧海神通修为不够，难以施展%s。\n",FU));

  if( (int)me->query("max_mana") < 800 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",FU));

  if( (int)me->query("force") < 100 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 120+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 100 )
    return notify_fail("你无法集中精力！\n");

  return 1;
}

int cast_attack(object me, object target)
{
  int success_adj;
  int damage;
  string msg_init,msg_success,msg_fail,msg_backfire_init,msg_backfire_success;

  success_adj = SKILL_D("seashentong")->query_power_effect(me);
  success_adj += random(10);

  if( !target )
    target = offensive_target(me);
  if( !target
   || !target->is_character()
   || target->is_corpse()
   || target==me)
    return notify_fail("你要龙神袭击谁？\n");
  me->add("mana", -50-2*(int)me->query("mana_factor"));
  me->receive_damage("sen", 50);
  if( random(me->query("max_mana")) < 100 )
  {
    write("你一着急竟然忘了咒语。\n");
    return 1;
  }

  msg_init = HIM"$N" HIM"后退几步，口中念了几句咒文，大叫一声：“神龙何在？"
             "“半空中呼地现出两条气势威猛的银角背苍龙，纵身一吐，两股奇寒无比"
             "的水柱喷向$n" HIM"。\n"NOR;
  msg_success = HIR"结果$n" HIR"躲避不及，被水柱激个正着！\n"NOR;
  msg_fail = HIW"但是" HIW"$n" HIW"躲开了。\n" NOR;
  msg_backfire_init = HIM"但水势被$n" HIM"以法力反激，反向$N" HIM"射去！\n" NOR;
  msg_backfire_success = HIR"结果$n" HIR"躲避不及，被水柱激个正着！\n"NOR;

  damage = SPELL_D->attacking_cast(
       me,             //attacker
       target,         //target
       success_adj,    //success adjustment
       BACKFIRE,       //backfire or not
       "kee",         //damage type: "both", "kee"/"qi", "sen"/"shen"
       msg_init,
       msg_success,
       msg_fail,
       msg_backfire_init,
       msg_backfire_success);
  me->start_busy(1+random(3));
  return 1;
}

