#include <ansi.h>
#include <combat.h>
#define BIBO "「" HIB "混沌天地" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "东海龙宫")
    return notify_fail(BIBO"是东海龙宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("huntian-hammer", 1) < 120)
    return notify_fail("你的混天锤修为不够，难以施展" BIBO "。\n");
  if (me->query_skill("dragonforce", 1) < 120)
    return notify_fail("你的龙神心法修为不够，难以施展" BIBO "。\n");
  if (me->query_skill_mapped("hammer") != "huntian-hammer")
    return notify_fail("你没有激发混天锤，难以施展" BIBO "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" BIBO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap,dp,damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "hammer")
    return notify_fail("你使用的武器不对，难以施展" BIBO "。\n");
  msg = HIC "$N" HIC"仰天一声龙吟，裂石碎金，如惊涛拍岸，似浊浪滔天。\n手中"NOR
       + weapon->name() + HIC + "上下飞舞，似要搅混那无量的大海，虽不快捷，却"
       "迸发出骇人的力道，直击$n。\n\n"NOR;
  message_combatd(msg, me, target);

  damage = (int)me->query_skill("hammer");
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"hammer");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp,105))
  {
    damage = (int)me->query_skill("hammer");
    damage += random((int)me->query_skill("force")+1);
    damage = damage/2 + random(damage);
    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 50,
          HIR "只听$n" HIR "一声惨叫，抵抗不了这骇人的力量，一口鲜血"
          "喷到空中！\n"NOR);
  }

  else
  {
    msg = HIY"$n平静内心的惊骇，任他风狂浪急，也自管自己脚踏实地！\n"NOR;
  }

  if (damage > 0)
    target->start_busy(1);
  message_combatd(msg, me, target);

  msg = HIC"$N倾力一击过后，力道依然十足。手中大锤挂着风声，劈头"
        "盖脸的只管乱咂下去！\n"NOR;
  if (!living(target) || (environment(me) != environment(target)))
  {
    msg += HIB"然而$n已经倒地不起，人事不知了！\n"NOR;
    message_combatd(msg, me, target);
    me->start_busy(1+random(3));
    return 1;
  }

  message_combatd(msg, me, target);
  COMBAT_D->do_attack(me, target, weapon);
  COMBAT_D->do_attack(me, target, weapon);
  me->start_busy(2+random(3));
  return 1;
}

