#include <ansi.h>
#include <combat.h>
#define BIBO "「" HIB "碧波浪涌" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "东海龙宫")
    return notify_fail(BIBO"是东海龙宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("fengbo-fork", 1) < 150)
    return notify_fail("你的风波十二叉修为不够，难以施展" BIBO "。\n");
  if (me->query_skill("dragonforce", 1) < 150)
    return notify_fail("你的龙神心法修为不够，难以施展" BIBO "。\n");
  if (me->query_skill_mapped("fork") != "fengbo-fork")
    return notify_fail("你没有激发风波十二叉，难以施展" BIBO "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" BIBO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i,j,k;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "fork")
    return notify_fail("你使用的武器不对，难以施展" BIBO "。\n");
  msg = HIC "$N" HIC"作龙吟之声，踏碧波而来，$n只看到$N化做数团身影，"NOR +
        HIC"漫天叉影席卷而来，$n奋力一架，但叉分数路，着实难以招架！\n"NOR;
  message_combatd(msg, me, target);
  if(me->query_skill_mapped("unarmed")=="dragonfight" &&
     me->query_skill("dragonfight",1) > 280 &&
     me->query_skill("fengbo-fork",1) > 280)
    k = 4;
  else if(me->query_skill_mapped("unarmed")=="dragonfight" &&
          me->query_skill("dragonfight",1) > 220 &&
          me->query_skill("fengbo-fork",1) > 220)
    k = 2;
  else if(me->query_skill_mapped("unarmed")=="dragonfight" &&
          me->query_skill("dragonfight",1) > 180 &&
          me->query_skill("fengbo-fork",1) > 180)
    k = 1;

  j = me->query_temp("apply/attack");
  for (i=1;i<=4;i++)
  {
    if (!living(target) || (environment(me) != environment(target)))
      break;
    if (random(2) && !target->is_busy())
      target->start_busy(1);
//出fork
    me->add_temp("apply/attack", i*30);
    COMBAT_D->do_attack(me, target, weapon);
    me->add("force",-20);
//出掌
    if (i <= k)
    {
      if (!target->is_busy())
        target->start_busy(1);
      me->delete_temp("weapon");
      me->reset_action();
      me->set_temp("ignore_dis",1);
      COMBAT_D->do_attack(me, target, 0);
      me->delete_temp("ignore_dis");
      me->set_temp("weapon",weapon);
      me->reset_action();
      me->add("force",-20);
    }

  }

  me->set_temp("apply/attack", j);
  me->start_busy(1+random(3));
  return 1;
}

