#include <ansi.h>
#include <combat.h>
#define BIBO "「" HIC "无尽风波" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "东海龙宫")
    return notify_fail(BIBO"是东海龙宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("fengbo-fork", 1) < 150)
    return notify_fail("你的风波十二叉修为不够，难以施展" BIBO "。\n");
  if (me->query_skill("dragonforce", 1) < 150)
    return notify_fail("你的龙神心法修为不够，难以施展" BIBO "。\n");
  if (me->query_skill_mapped("fork") != "fengbo-fork")
    return notify_fail("你没有激发风波十二叉，难以施展" BIBO "。\n");
  if (me->query("force") < 1000)
    return notify_fail("你的真气不够，难以施展" BIBO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "fork")
    return notify_fail("你使用的武器不对，难以施展" BIBO "。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");
  msg = HIC"$N" HIC"手中"NOR + weapon->name() + HIC"挥展开来，左一叉，右一"
        "叉，幻出无数大小光环向$n绕去。虽看起来柔弱无力，却宛若秋波般连绵不"
        "绝，实是暗藏杀机！\n\n"NOR;
  me->add("force", -50);
  if (COMBAT_D->perform_success(me, target,
                                ({"unarmed","fork","force"}),
                                ({"dodge","parry","force"}),
                                105))
  {
    i = me->query_skill("fengbo-fork",1)/20;
    if (i > 12)
      i = 12;
    msg += HIR "结果$p" HIR "被$P" HIR "闹个手忙脚乱，"
               "惊慌失措，呆在当场，不知如何应对！\n" NOR;
    target->start_busy(i);
    me->start_busy(1 + random(2));
  }

  else
  {
    msg += CYN "可是$p" CYN "看破了$P" CYN "的企图，镇"
               "定逾恒，全神应对自如。\n" NOR;
    me->start_busy(2+random(3));
  }

  message_combatd(msg, me, target);
  return 1;
}