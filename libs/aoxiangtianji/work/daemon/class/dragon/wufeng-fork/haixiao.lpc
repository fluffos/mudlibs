#include <ansi.h>
#include <combat.h>
#define BIBO "「" HIB "无风海啸" NOR "」"
inherit F_SSERVER;
int is_not_attack() { return 0;	}

int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "东海龙宫")
    return notify_fail(BIBO"是东海龙宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("wufeng-fork", 1) < 80)
    return notify_fail("你的无风叉修为不够，难以施展" BIBO "。\n");
  if (me->query_skill("dragonforce", 1) < 80)
    return notify_fail("你的龙神心法修为不够，难以施展" BIBO "。\n");
  if (me->query_skill_mapped("fork") != "wufeng-fork")
    return notify_fail("你没有激发定波叉，难以施展" BIBO "。\n");
  if (me->query("force") < 150)
    return notify_fail("你的真气不够，难以施展" BIBO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap, dp;
  int damage;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "fork")
    return notify_fail("你使用的武器不对，难以施展" BIBO "。\n");
  msg = HIR "$N" HIR "龙吟长啸，手中" + weapon->name() +
        HIR "在龙神心法鼓动之下，如波涛澎湃，似海啸奔涌，"
            "一浪接一浪直击$n" HIR "而去！\n" NOR;
  damage = me->query_skill("wufeng-fork",1);
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"fork");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp,105))
  {
    damage = me->query_skill("fork");
    damage += random(me->query_skill("force"));
    damage = damage/3 +random(damage);
    me->add("force", -80);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                               HIR "只听$n" HIR "一声惨叫，$N" HIR +
                               weapon->name() + HIR "好似惊涛骇浪般击"
                               "中$p全身。\n"NOR);
  }

  else
  {
    me->add("force", -50);
    msg += CYN "$n" CYN "见$P" CYN "来势汹涌，不敢轻易抵"
               "挡，连忙飞身腾挪，躲闪开来。\n" NOR;
  }

  me->start_busy(1+random(3));
  message_combatd(msg, me, target);
  return 1;
}