#include <ansi.h>
#include <combat.h>
#define FU "「" HIG "诅咒" NOR "」"
#define WEAK "/daemon/class/spells/curse"
#define CAUSED "curse"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
  int t = time();

  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if (me->query_skill("spells", 1) < 150)
    return notify_fail(sprintf("你的法术修为不够，难以施展%s。\n",FU));

  if( (int)me->query("max_mana") < 1200 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",FU));

  if( (int)me->query("force") < 200 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 150+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 300 )
    return notify_fail("你无法集中精力！\n");

  if ((t - (int)me->query_temp("last_curse")) < 30)
    return notify_fail("你刚刚施展过了，等会才可以继续用！\n");
  if (me->query_condition("killer"))
    return notify_fail("你身上杀气正浓，无法使用法术！\n");
  return 1;
}

int cast_attack(object me, object target)
{
  int success_adj, result, time, extra;
  string msg, s_sk;

  s_sk = me->query_skill_mapped("spells");
  if (!stringp(s_sk))
    return notify_fail("你必须先选择你的特殊法术，才可以施展！\n");

  success_adj = SKILL_D(s_sk)->query_power_effect(me);
  if( !target )
    target = offensive_target(me);
  if( !target
   || !target->is_character()
   || target->is_corpse()
   || target==me)
    return notify_fail(sprintf("你要对谁施%s？\n",FU));
  if(target->query_temp(CAUSED))
    return notify_fail(sprintf("%s已经被人施展了这个法术了！\n",target->name()));
  me->add("mana", -50-2*(int)me->query("mana_factor"));
  me->receive_damage("sen", 50);
  if( random(me->query("max_mana")) < 200 )
  {
    write("你法力忽然不济了，看来这次施法失败了！\n");
    me->set_temp("last_curse",time());
    return 1;
  }

  msg = HIM"$N" HIM"念了句咒文，双目迷朦的看着$n" HIM"，“我以神的名义诅咒你”！\n"NOR;
  message_vision(msg,me,target);

  result = SPELL_D->attacking_cast_success(me,target,success_adj);

  if (result <=0)
  {
    msg = HIW "$n" HIW"根本不理$N的胡言乱语！\n" NOR;
    message_vision(msg,me,target);
    me->start_busy(2+random(3));
    me->set_temp("last_curse",time());
    return 1;
  }

  msg = HIW"$n" HIW"显然受了$N" HIW"的影响，不由得有点心虚。\n"NOR;
  message_vision(msg,me,target);
  time = me->query_skill(s_sk,1);
  time = time/5 ;
  extra = time/2 + random(time);
  if (extra > 50)
    extra = 50;
  if (time > 60)
    time = 60;
  target->add("douzhi",-target->query("douzhi")/5);
  target->set_curse_changed(WEAK,CAUSED,"karma",time,extra/2);
  target->set_curse_changed(WEAK,CAUSED,"dodge",time,extra);
  me->set_temp("last_curse",time());
  return 1;
}

void remove_effect(object me)
{
  if (objectp(me) && me->query_temp(CAUSED))
    tell_object(me,sprintf("你终于摆脱了%s的困扰了。\n",FU));
}

