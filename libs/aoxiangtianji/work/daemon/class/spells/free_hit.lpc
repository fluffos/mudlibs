#include <ansi.h>
#include <combat.h>
#define FU "「" HIR "伤害免除" NOR "」"
#define Y_FILE "/daemon/class/spells/free_hit"
#define CAUSED "free_hit"
inherit SSERVER;
int is_not_attack()
{
  return 1;
}

int valid_cast(object me, object target)
{
  int t = time();
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if (!me->is_fighting())
    return notify_fail(sprintf("%s只能在战斗中使用！\n",FU));
  if (me->query_skill("spells", 1) < 150)
    return notify_fail(sprintf("你的法术修为不够，难以施展%s。\n",FU));

  if( (int)me->query("max_mana") < 1500 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",FU));

  if( (int)me->query("force") < 300 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 300+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 100 )
    return notify_fail("你无法集中精力！\n");
  if (me->query_temp("tick/"+CAUSED))
    return notify_fail(sprintf("你已经处于使用%s的状态了！\n",FU));

  if ((t- me->query_temp("last_free-hit")) < 30)
    return notify_fail(sprintf("你刚刚使用过%s，需要等会才能继续使用！\n",FU));

  if (me->query_condition("killer"))
    return notify_fail("你身上杀气正浓，无法使用法术！\n");
  return 1;
}

int cast(object me, object target)
{
  int skill,t;
  string s_sk;
  if( objectp(target) && target != me )
    return notify_fail(sprintf("你只能对自己施展%s。\n",FU));
  s_sk = me->query_skill_mapped("spells");
  if (!stringp(s_sk))
    return notify_fail("你必须先选择你的特殊法术，才可以施展！\n");
  skill = me->query_skill("spells",1);
  if( random(me->query("max_mana")) < 200 )
  {
    me->add("mana",-skill);
    me->receive_damage("sen",10);
    message_vision(HIY"$N" HIY"张口念动咒语！可惜这次没有什么作用！\n"NOR, me);
    me->set_temp("last_free-hit", time());
    return 1;
  }

  me->add("mana", -2*skill);

  if (skill > 500)
    skill = 500;
  t = 15 + random((skill - 100)/2);
  message_vision(HIY"$N" HIY"念动咒语，慢慢把法力笼罩全身。\n\n"NOR, me);
  me->set_temp("free_hit",skill/150);
  me->set_pfm_tick(Y_FILE, CAUSED,skill, target);
  me->set_temp("last_free-hit",time());
  me->start_busy(1);
  return 1;
}

int check(object me, object target)
{
  if (!living(me))
  {
    me->delete_temp("free_hit");
    return 0;
  }

  if (!me->is_fighting())
  {
    tell_object(me,sprintf("你不处于战斗状态了，没有必要保持%s的状态了！\n",FU));
    me->delete_temp("free_hit");
    return 0;
  }

  if ( (int)me->query("mana") < 400  )
  {
    tell_object(me, sprintf("你的法力后继不足，无法继续保持%s状态了。\n",FU));
    me->delete_temp("free_hit");
    return 0;
  }

  return 1;
}

void remove_effect(object me, object target)
{
  message_vision(HIW"$N" HIW"收回了法力。\n\n"NOR, me);
  me->set_temp("last_free-hit",time());
  return;
}