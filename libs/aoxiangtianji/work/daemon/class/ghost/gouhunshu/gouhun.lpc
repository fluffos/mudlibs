#include <ansi.h>
#include <combat.h>
#define HUN "「" HIR "勾魂" NOR "」"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "阎罗地府")
    return notify_fail(sprintf("%s是阎罗地府不传之密！\n",HUN));
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("gouhunshu", 1) < 100)
    return notify_fail(sprintf("你的勾魂术修为不够，难以施展%s。\n",HUN));

  if( (int)me->query("max_mana") < 500 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",HUN));

  if( (int)me->query("force") < 300 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 150+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 200 )
    return notify_fail("你无法集中精力！\n");

  return 1;
}

int cast_attack(object me, object target)
{
  int success_adj;
  string msg_init,msg_success,msg_fail,msg_backfire_init,msg_backfire_success;
  if( !target ) target = offensive_target(me);
  if( !target
    || !target->is_character()
    || target->is_corpse()
    || target==me)
     return notify_fail("你要勾自己的魂？\n");
  me->add("mana", -25-2*(int)me->query("mana_factor"));
  me->receive_damage("sen", 50);
  if( random(me->query("max_mana")) < 100 )
  {
    write("这次是鬼见鬼了！\n");
    return 1;
  }

  success_adj = SKILL_D("gouhunshu")->query_power_effect(me);

  msg_init = HIB"$N" HIB"对" HIB"$n" HIB"阴阴地笑着：阎王叫你三更死，"
             "不敢留你到五更。。。\n" NOR;
  msg_success = HIC"$n" HIC"受到" HIC"$N" HIC"影响，显然有点魂不守舍了！\n" NOR;
  msg_fail = HIC"但是" HIC"$n" HIC"神情专注，对" HIC"$N" HIC"理都不理。\n" NOR,
  msg_backfire_init = HIC"但是" HIC"$n" HIC"眼一瞪：光天化日之下，岂由恶鬼横行！\n"NOR;
  msg_backfire_success = HIC"结果" HIC"$n" HIC"反而有点魂不守舍了！\n"NOR;

  SPELL_D->attacking_cast(
       me,
       target,
       success_adj,
       BACKFIRE,
       "sen",
       msg_init,
       msg_success,
       msg_fail,
       msg_backfire_init,
       msg_backfire_success);
  me->start_busy(1+random(3));
  return 3+random(5);
}

