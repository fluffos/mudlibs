#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
#define DUO "「" HIG "神·人·鬼" NOR "」"
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "阎罗地府")
    return notify_fail(DUO"是阎罗地府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if (me->query_skill("force", 1) < 180)
    return notify_fail("你的内功火候不够，使不了" DUO "。\n");
  if (me->query_skill("hellfire-whip", 1) < 180)
    return notify_fail("你的烈火鞭功力太浅，使不了" DUO "。\n");
  if (me->query_skill("kusang-stick", 1) < 180)
    return notify_fail("你的哭丧棒功力太浅，使不了" DUO "。\n");
  if (me->query_skill("zhuihun-sword", 1) < 180)
    return notify_fail("你的追魂剑功力太浅，使不了" DUO "。\n");
  if (me->query("force") < 800)
    return notify_fail("你的真气不够，无法使用" DUO "。\n");
  if((int)me->query("kee") < 300 )
    return notify_fail("你的气血不足，没法子施用外功！\n");
  if((int)me->query("sen") < 300 )
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if (me->query_skill_mapped("whip") != "hellfire-whip")
    return notify_fail("你没有激发烈火鞭，使不了" DUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  int damage;
  string msg, wn;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      weapon->query("skill_type") != "whip")
    return notify_fail("你使用的武器不对。\n");

  wn = weapon->name();
  msg = HIG"$N双手划一大圆，猛然托天而举，"NOR + wn +
        HIG"抖得笔直，转瞬鞭稍游动，\n整个"NOR + wn +
        HIG"渐渐盘旋灵动，如蛟龙飞舞，如灵蛇吐信。\n\n"NOR;

  msg += HIY"$N踏着四周点点磷光，身形飘浮做鬼魅，手中"NOR + wn +
         HIY"历啸一声直奔$n前胸！\n"NOR;

  if (COMBAT_D->perform_success(me, target,
                                ({"whip","force"}),
                                ({"parry","dodge"}),120))
  {
    damage = (int)me->query_skill("whip") + (int)me->query_skill("force")/2;
    damage = damage/3 + random(damage);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 35,
                                MAG "结果这从天而落的一鞭，正抽中$n前胸！"
                                "就听见$n一声惨叫，身体直直的倒飞了出去！\n" NOR);
    me->add("force", -100);
  }

  else
  {
    me->add("force", -50);
    msg += HIW"$n见势不妙，急忙闪身躲避，虽然狼狈不堪，去也勉强躲开了这矫若"
              "游龙的致命一击！\n"NOR;
  }

  message_combatd(msg, me, target);

  if (!living(target) || (environment(me) != environment(target)))
  {
    msg = HIC"$N见$n倒地不起，趁势收拢了"NOR + wn + HIC"！\n"NOR;
    message_combatd(msg, me, target);
    me->start_busy(1+random(2));
    return 1;
  }

  msg = HIW"$N眼见$n为气势所惊，如影随形跟了上去，手中"NOR + wn +
         HIW"抖得笔直如同铁棍一般，直击$n！\n"NOR;

  if (COMBAT_D->perform_success(me, target,
                                ({"stick","whip","force"}),
                                ({"parry","dodge","force"}),110))
  {
    damage = ((int)me->query_skill("stick") + (int)me->query_skill("whip"))/2 +
              (int)me->query_skill("force")/2;
    damage = damage/3 + random(damage);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                          MAG "结果$n无从躲避，这一如铁棍般的鞭子正咂中了头部！"
                              "就听见$n一声闷叫，如同软泥般的倒了下去！\n" NOR);
    me->add("force", -100);
  }

  else
  {
    me->add("force",-50);
    msg += HIY"$n虽然惊魂未定，见这锐风袭来，身体直直的躺了下去，堪堪避开了"
              "这势如疯虎的一击！\n"NOR;
  }

  message_combatd(msg, me, target);
  if (!living(target) ||
      environment(me) != environment(target) ||
      !me->is_fighting(target))
  {
    msg = HIC"$N见$n倒地不起，趁势收拢了"NOR + wn + HIC"！\n"NOR;
    message_combatd(msg, me, target);
    me->start_busy(1+random(2));
    return 1;
  }

  msg = HIY"$N毫不停顿，手中的"NOR + wn + HIY"使得剑意盎然，鞭稍吐出一团剑芒，"
            "如漫天的风雨，席卷$n而来！\n"NOR;

  if (COMBAT_D->perform_success(me, target,
                                ({"sword","whip","force"}),
                                ({"parry","dodge","force"})))
  {
    damage = ((int)me->query_skill("sword") + (int)me->query_skill("whip"))/2 +
              (int)me->query_skill("force")/2;
    damage = damage/2 + random(damage);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 60,
                       MAG "结果$n愣立当场，这剑雨风暴转瞬把$p裹在当中！"
                           "这风暴裹住$p，又抛起了$p。微弱的呻吟后，可怜"
                           "$n几乎体无完肤的躺倒在地上！\n" NOR);
    me->add("force", -100);
  }

  else
  {
    msg += HIC"$n情急之下，不顾一切的就地打滚，一口气滚出了数十米，惊魂未定"
              "的躲开了这漫天暴雨般的一击！\n"NOR;
    me->add("force",-50);
  }

  me->start_busy(2+random(3));
  message_combatd(msg, me, target);
  return 1;
}