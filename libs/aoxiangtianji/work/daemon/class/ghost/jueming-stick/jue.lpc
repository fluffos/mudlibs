#include <ansi.h>
#include <combat.h>
#define DUO "「" HIR "阴魂绝" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "阎罗地府")
    return notify_fail(DUO"是阎罗地府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if ((int)me->query_skill("jueming-stick", 1) < 100)
    return notify_fail("你绝命棒不够娴熟，难以施展" DUO "。\n");
  if (me->query_skill_mapped("stick") != "jueming-stick")
    return notify_fail("你没有激发绝命棒，难以施展" DUO "。\n");
  if ((int)me->query_skill("force",1) < 100 )
    return notify_fail("你的内功火候不够，难以施展" DUO "。\n");

  if ((int)me->query("force") < 150)
    return notify_fail("你现在的真气不够，难以施展" DUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  string msg, wn;
  object weapon;

  if (! objectp(weapon = me->query_temp("weapon"))
     || (string)weapon->query("skill_type") != "stick")
    return notify_fail("你所使用的武器不对，难以施展" DUO "。\n");
  wn = weapon->name();

  msg = HIY "\n$N" HIY "一声阴阴怪叫，脸上显出一股青气，手中" + wn +
        HIY "突然显得难以琢磨，招招出乎意料的攻往$n！\n"NOR;
  message_sort(msg, me, target);
  me->set_temp("JMS_perform",1+random(2));

  if ((random(3) == 0) && (!target->is_busy()))
    target->start_busy(2);
  COMBAT_D->do_attack(me, target, weapon,1);

  if (living(target))
  {
    if ((random(3) == 0) && (!target->is_busy()))
      target->start_busy(2);
    me->set_temp("JMS_perform",3+random(2));
    COMBAT_D->do_attack(me, target, weapon);
  }

  me->delete_temp("JMS_perform");
  me->add("force",-50);
  me->start_busy(1+random(3));
  return 1;
}