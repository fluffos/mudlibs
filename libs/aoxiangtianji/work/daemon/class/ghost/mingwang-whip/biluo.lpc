#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
#define DUO "「" HIG "碧落黄泉" NOR "」"
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "阎罗地府")
    return notify_fail(DUO"是阎罗地府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if (me->query_skill("force", 1) < 100)
    return notify_fail("你的内功火候不够，使不了" DUO "。\n");
  if (me->query_skill("mingwang-whip", 1) < 100)
    return notify_fail("你的冥王鞭功力太浅，使不了" DUO "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，无法使用" DUO "。\n");
  if (me->query_skill_mapped("whip") != "mingwang-whip")
    return notify_fail("你没有激发冥王鞭，使不了" DUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap, dp;
  int damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      weapon->query("skill_type") != "whip")
    return notify_fail("你使用的武器不对。\n");
  msg = MAG "$N一声哭号，突的一口鲜血喷在手中"
        + weapon->name() + "上。受这鲜血一激，"
        + weapon->name() +"啸声大作，夹着阵阵鬼哭闪"
        "电般飞袭$n的胸口七处大穴！\n" NOR;
  damage = me->query_skill("whip");
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"whip");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
     damage = me->query_skill("whip");
     damage += random(me->query_skill("force")+1);
     damage = damage/3 + random(damage*2/3);
     me->add("force", -100);
     msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 55,
                                MAG "结果长鞭在$n胸口三进三出，带出一地鲜血！\n" NOR);
  }

  else
  {
    me->add("force", -50);
    msg += MAG "但是$n一声轻笑，身形摇晃，避了开去。\n" NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}