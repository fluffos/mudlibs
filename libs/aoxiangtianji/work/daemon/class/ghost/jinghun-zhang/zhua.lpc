#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
#define DUO "「" HIG "无常抓" NOR "」"
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "阎罗地府")
    return notify_fail(DUO"是阎罗地府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if (me->query_skill("force", 1) < 100)
    return notify_fail("你的内功火候不够，使不了" DUO "。\n");
  if (me->query_skill("jinghun-zhang", 1) < 100)
    return notify_fail("你的惊魂掌功力太浅，使不了" DUO "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，无法使用" DUO "。\n");
  if (me->query_skill_mapped("unarmed") != "jinghun-zhang")
    return notify_fail("你没有激发惊魂掌，使不了" DUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  string msg;
  int damage, hit_busy;

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail(DUO "只能空手施展。\n");
  msg = HIB"$N" HIB"口中默念几声：世事无常，死生无常……偏偏今天你撞到我喜怒无常，你任命吧！\n"NOR;
  msg += HIB"一爪抓向" HIB"$n" HIB"\n"NOR;

  hit_busy = 0;
  if (COMBAT_D->perform_success(me, target,
                                "unarmed",
                                "parry"))
    hit_busy = 1;

  if (COMBAT_D->perform_success(me, target,
                                ({"unarmed","force"}),
                                ({"dodge","force"}),
                                110))
  {
     damage = me->query_skill("unarmed");
     damage += me->query_skill("force")/2;
     damage = damage/3 + random(damage);
     msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 35,
                          HIG"$n" HIG"身子一晃，背上留下了一个惨绿色的爪痕！\n"NOR);
     me->add("force", -100);
    if (hit_busy && !target->is_busy())
      target->start_busy(3+random(2));
  }

  else
  {
    me->add("force", -50);
    msg += MAG "但是" MAG"$n" MAG"避了开去。\n" NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

