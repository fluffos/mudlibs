#include <ansi.h>
#include <combat.h>
#define DUO "「" HIR "青面獠牙" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && me->query("family/family_name") != "阎罗地府")
    return notify_fail(DUO"是阎罗地府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if ((int)me->query_skill("kusang-stick", 1) < 120)
    return notify_fail("你哭丧棒不够娴熟，难以施展" DUO "。\n");
  if (me->query_skill_mapped("stick") != "kusang-stick")
    return notify_fail("你没有激发哭丧棒，难以施展" DUO "。\n");
  if ((int)me->query_skill("force",1) < 120 )
    return notify_fail("你的内功火候不够，难以施展" DUO "。\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你现在的真气不够，难以施展" DUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  int damage;
  string msg, wn;
  object weapon;

  if (! objectp(weapon = me->query_temp("weapon"))
     || (string)weapon->query("skill_type") != "stick")
    return notify_fail("你所使用的武器不对，难以施展" DUO "。\n");
  wn = weapon->name();

  msg = HIY "\n$N" HIY "摄气诀运转之下，脸上显出一股青气，手中" + wn +
        HIY "突然显得异常诡异，身形缥缈，圈圈绕绕的飘荡在$n四周！\n"NOR;

  if (COMBAT_D->perform_success(me, target,"stick","dodge",110))
  {
    damage = (int)me->query_skill("stick");
    damage = damage*2/3 + random(damage);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 60,
                           MAG "$n正茫然间，$N突的一棒正中腰肋！"
                           "就听见$n一声哭号，身体软软的倒了下去！\n" NOR);
    me->add("force", -80);
    if (living(target) && !target->is_busy())
      target->start_busy(2);
  }

  else
  {
    me->add("force",-50);
    msg += HIW"$n暗叫“当心”，采取全力以赴的防御姿态。$N眼见不能得逞了！\n"NOR;
  }

  if (!living(target) || (environment(me) != environment(target)))
  {
    message_combatd(msg, me, target);
    me->start_busy(2);
    return 1;
  }

  message_combatd(msg, me, target);

  msg = HIB"$N身形突然站住，手中"NOR + wn +
         HIB"挥舞，身形跃起，接连两棒连续攻往$n！\n"NOR;
  me->set_temp("HELLK_perform",3+random(2));

  COMBAT_D->do_attack(me, target, weapon,1);

  if (!living(target) || (environment(me) != environment(target)))
  {
    if ((random(2)) && (!target->is_busy()))
      target->start_busy(2);
    me->set_temp("HELLK_perform",5+random(2));
    COMBAT_D->do_attack(me, target, weapon);
  }

  me->delete_temp("HELLK_perform");
  me->add("force",-50);
  me->start_busy(1+random(3));
  return 1;
}

