#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
#define DUO "「" HIC "夺魂势" NOR "」"
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "阎罗地府")
    return notify_fail(DUO"是阎罗地府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if (me->query_skill("force", 1) < 80)
    return notify_fail("你的内功火候不够，使不了" DUO "。\n");
  if (me->query_skill("lunhui-whip", 1) < 80)
    return notify_fail("你的轮回鞭功力太浅，使不了" DUO "。\n");
  if (me->query("force") < 150)
    return notify_fail("你的真气不够，无法使用" DUO "。\n");
  if (me->query_skill_mapped("whip") != "lunhui-whip")
    return notify_fail("你没有激发轮回鞭，使不了" DUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      weapon->query("skill_type") != "whip")
    return notify_fail("你使用的武器不对。\n");
  msg = HIY "$N" HIY "诡异的一笑，手中" + weapon->name() + HIY "抖得笔直，劈向$n"
        HIY "手腕，可是待到中途却又停滞，转往$n胸口挥去！\n" NOR;
  if (COMBAT_D->perform_success(me, target,
                                ({"whip","force"}),
                                ({"parry","dodge"})))
  {
     damage = (int)me->query_skill("whip") + (int)me->query_skill("force")/2;
     damage = damage/3 + random(damage*2/3);
     me->add("force", -100);
     msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                                HIR "结果$n" HIR "一声惨叫，未能看破$N"
                                HIR "的企图，被这一鞭硬击在胸口，鲜血飞"
                                    "溅，皮肉绽开！\n" NOR);
  }

  else
  {
    me->add("force", -30);
    msg += CYN "可是$n飞身一跃而起，躲避开了$N的攻击！\n" NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}