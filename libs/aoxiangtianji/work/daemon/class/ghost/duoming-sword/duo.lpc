#include <ansi.h>
#include <combat.h>
#define DUO "「" HIR "夺命一击" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "阎罗地府")
    return notify_fail(DUO"是阎罗地府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if ((int)me->query_skill("duoming-sword", 1) < 80)
    return notify_fail("你夺命剑法不够娴熟，难以施展" DUO "。\n");
  if (me->query_skill_mapped("sword") != "duoming-sword")
    return notify_fail("你没有激发夺命剑法，难以施展" DUO "。\n");
  if ((int)me->query_skill("force",1) < 80 )
    return notify_fail("你的内功火候不够，难以施展" DUO "。\n");

  if ((int)me->query("force") < 100)
    return notify_fail("你现在的真气不够，难以施展" DUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  int damage;
  string msg, wn;
  object weapon;

  if (! objectp(weapon = me->query_temp("weapon"))
     || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你所使用的武器不对，难以施展" DUO "。\n");
  wn = weapon->name();
  msg = HIY "\n$N" HIY "一声怪叫，一股勇悍之气涌了出来，手中" + wn +
        HIY "迅猛无比地刺出，风声嗖嗖，完全不理会$n" HIY "的攻势，"
            "将自己的生死置之度外，这正是夺命剑法精髓"DUO"。" NOR;
  message_sort(msg, me, target);

  if (COMBAT_D->perform_success(me, target,"sword","dodge",105))
  {
    damage = me->query_skill("sword");
    damage = damage*2/3 + random(damage);
    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 25,
                       HIR "$n" HIR "见$N" HIR "此招剑势迅"
                           "猛，心中一惊，早已中剑。\n" NOR);
    me->add("force", -50);
  }

  else
  {
    msg = CYN "眼见" + wn + CYN "已至，但$n身法迅速无比，提气向后一纵，$N"
              "扑了个空。\n" NOR;
    me->add("force", -30);
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

