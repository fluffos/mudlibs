#include <ansi.h>
#include <combat.h>
#define XUE "「" HIR "血浪滔天" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "陷空山无底洞")
    return notify_fail(XUE"是陷空山无底洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("shixue-blade", 1) < 120)
    return notify_fail("你的嗜血刀修为不够，难以施展" XUE "。\n");
  if (me->query_skill("huntian-qigong", 1) < 120)
    return notify_fail("你的混天气功修为不够，难以施展" XUE "。\n");
  if (me->query_skill_mapped("blade") != "shixue-blade")
    return notify_fail("你没有激发嗜血刀，难以施展" XUE "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" XUE "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int damage;
  if (! objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你所使用的武器不对，难以施展" XUE "。\n");
  msg = HIR "$N" HIR "杀气大盛，手中" + weapon->name() +
        HIR "一振，顿时一道血光从刀锋闪过，将$n"
        HIR "团团裹住。\n" NOR;
  if (COMBAT_D->perform_success(me, target,
                                ({"blade","force"}),
                                ({"parry","dodge"})))
  {
    damage = me->query_skill("blade") + random(me->query_skill("force")/2 + 1);
    damage = damage/3 + random(damage);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 35,
                         HIR "只听$n" HIR "一声惨嚎，嗤啦一声，"
                         "一股血柱自" HIR "血色刀影中激射而出。"
                         "\n" NOR);
    me->add("force", -100);
  }

  else
  {
     msg += CYN "可是$n" CYN "眼明手快，奋力招架，将$N"
            CYN "的招式全部挡开。\n" NOR;
     me->add("force", -50);
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

