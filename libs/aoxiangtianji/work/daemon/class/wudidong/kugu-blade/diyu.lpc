#include <ansi.h>
#include <combat.h>
#define XUE "「" HIR "无边地狱" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "陷空山无底洞")
    return notify_fail(XUE"是陷空山无底洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("kugu-blade", 1) < 180)
    return notify_fail("你的枯骨刀法修为不够，难以施展" XUE "。\n");
  if (me->query_skill("huntian-qigong", 1) < 180)
    return notify_fail("你的混天气功修为不够，难以施展" XUE "。\n");
  if (me->query_skill_mapped("blade") != "kugu-blade")
    return notify_fail("你没有激发枯骨刀法，难以施展" XUE "。\n");
  if (me->query("force") < 500)
    return notify_fail("你的真气不够，难以施展" XUE "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i,j;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对，难以施展" XUE "。\n");

  msg = HIR"$N" HIR"使出［枯骨刀法］的无边地狱，手中的"NOR + weapon->name()
      + HIR"斜斜劈出，$n顿觉呼吸一窒！\n\n" NOR;

  msg +=  HIW "$N刀光连闪，$n周围鬼哭神号，恰似无边地狱！\n" NOR;

  message_combatd(msg, me, target);

  j = me->query_temp("apply/attack");
  for(i=1;i<=4;i++)
  {
    if (!living(target) || (environment(me) != environment(target)))
      break;
    me->add_temp("apply/attack", i*25);
    if ((random(3) == 0) && (!target->is_busy()))
      target->start_busy(1);
    COMBAT_D->do_attack(me,target, weapon, 3);
    me->add("force", -30);
  }

  me->set_temp("apply/attack", j);
  me->start_busy(2+random(2));
  return 1;
}

