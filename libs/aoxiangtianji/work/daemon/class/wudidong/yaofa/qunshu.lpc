#include <ansi.h>
#include <combat.h>
#define CHAO "「" HIR "嗜血群鼠" NOR "」"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "陷空山无底洞")
    return notify_fail(CHAO "是陷空山无底洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("yaofa", 1) < 120)
    return notify_fail("你的妖法修为不够，难以施展" CHAO "。\n");

  if( (int)me->query("force") < 300 )
    return notify_fail("你的真气不够。\n");
  if( (int)me->query("mana") < 300 )
    return notify_fail("你的法力不够。\n");
  if((int)me->query("sen") < 100 )
    return notify_fail("你无法集中精力！\n");

  return 1;
}

int cast_attack(object me, object target)
{
  int success_adj;
  int damage;
  string msg_init,msg_success,msg_fail,msg_backfire_init,msg_backfire_success;

  success_adj = SKILL_D("yaofa")->query_power_effect(me);
  if( !target )
    target = offensive_target(me);
  if( !target
   || !target->is_character()
   || target->is_corpse()
   || target==me)
    return notify_fail("你要攻击谁？\n");
  me->add("mana", -50-2*(int)me->query("mana_factor"));
  me->receive_damage("sen", 50);
  if( random(me->query("max_mana")) < 100 )
  {
    write("你一着急竟然忘了咒语。\n");
    return 1;
  }

  msg_init = HIC"$N" HIC"口中念念有词，忽见地下钻出千百只" HIR"嗜血老鼠 "
             HIC"疯狂地扑向$n" HIC"！\n" NOR;
  msg_success = HIR"结果$n" HIR"被噬咬的体无完肤！！！\n" NOR;
  msg_fail = HIC "结果$n" HIC"轻轻一纵，竟然躲了过去，鼠群顿时失去了方向，四散而去 !\n" NOR;
  msg_backfire_init = HIG "但是群鼠被$n" HIG"以法力逼回，竟然反向$N" HIG"扑去！\n" NOR;
  msg_backfire_success = HIR"结果$n" HIR"被噬咬的体无完肤,自食其果！！！\n" NOR;

  damage = SPELL_D->attacking_cast(
       me,             //attacker
       target,         //target
       success_adj,    //success adjustment
       BACKFIRE,       //backfire or not
       "kee",          //damage type: "both", "kee"/"qi", "sen"/"shen"
       msg_init,
       msg_success,
       msg_fail,
       msg_backfire_init,
       msg_backfire_success);
  me->start_busy(1+random(3));
  return 3+random(5);
}