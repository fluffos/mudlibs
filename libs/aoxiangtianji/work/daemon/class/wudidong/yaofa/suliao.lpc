#include <ansi.h>
#include <combat.h>
#define CHAO "「" HIR "速疗" NOR "」"
inherit F_CLEAN_UP;
int is_not_attack()
{
  return 1;
}

int valid_cast(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "陷空山无底洞")
    return notify_fail(CHAO "是陷空山无底洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("yaofa", 1) < 80)
    return notify_fail("你的妖法修为不够，难以施展" CHAO "。\n");

  if( (int)me->query("force") < 100 )
    return notify_fail("你的真气不够。\n");
  if( (int)me->query("mana") < 100 )
    return notify_fail("你的法力不够。\n");

  if (me->query("eff_kee") >= me->query("max_kee")
    && me->query("eff_sen") >= me->query("max_sen") )
    return notify_fail("你并没有受伤，不需要治疗！\n");
  return 1;
}

int cast(object me, object target)
{
  int mymana, myforce,cost, cure;
  string msg;
  if(me->is_busy())
    return notify_fail("你正忙着呢，过会儿再念咒吧！\n");
  mymana = me->query("mana");
  myforce = me->query("force");
  cure = me->query_skill("spells")/5;
  cure = random(cure);

  cost = 10 + random(cure + 1);

  if( mymana < 200 + cost*3 )
    return notify_fail("你的法力不够。\n");
  if( myforce < 100 + cost*2 )
    return notify_fail("你的法力不够。\n");
  if(!me->is_fighting())
  {
    msg = HIY"$N" HIY"双手举在胸前，做个火焰状，念了几句咒。\n"NOR,
    msg += HIY"随即，$N" HIY"将双手在全身上下擦了一遍，双手到处，伤口居然好了大半！\n"NOR;
    me->start_busy(random(1+random(3)));
  }

  else
  {
    cure *= 2 ;
    cost *= 3 ;
    msg = HIY"百忙之中，$N" HIY"突然越出战圈，掐指念了段咒。\n"NOR;
    msg += HIY"一瞬间，$N" HIY"面部黄气大盛。待黄气下去时，$N" HIY"身上大半伤口居然已经收口了！\n"NOR;
    me->start_busy(2+random(3));
  }

  me->receive_curing("kee", 10 + cure );
  me->receive_curing("sen", 10 + cure );

  me->add("mana", -(10+cost));
  me->add("force", -(10+cost)/2);
  me->set("force_factor", 0);
  me->set("mana_factor", 0);
  message_vision(msg, me);
  return 1;
}

