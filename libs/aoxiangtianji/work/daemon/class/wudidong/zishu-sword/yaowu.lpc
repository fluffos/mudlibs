#include <ansi.h>
#include <combat.h>
#define XUE "「" HIR "妖雾冲天" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "陷空山无底洞")
    return notify_fail(XUE"是陷空山无底洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("zishu-sword", 1) < 120)
    return notify_fail("你的子鼠剑法修为不够，难以施展" XUE "。\n");
  if (me->query_skill("huntian-qigong", 1) < 120)
    return notify_fail("你的混天气功修为不够，难以施展" XUE "。\n");
  if (me->query_skill_mapped("sword") != "zishu-sword")
    return notify_fail("你没有激发子鼠剑法，难以施展" XUE "。\n");
  if (me->query("force") < 120)
    return notify_fail("你的真气不够，难以施展" XUE "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int damage;
  if (! objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你所使用的武器不对，难以施展" XUE "。\n");
  msg = MAG"$N" MAG"阴阴一笑,手中的"NOR + weapon->name() +
        MAG "轻轻一挥,登时飞沙走石,妖雾直冲天际!!\n"NOR;
  if (COMBAT_D->perform_success(me, target,
                                ({"sword","force"}),
                                ({"parry","dodge"})))
  {
    damage = me->query_skill("sword") + me->query_skill("force")/2;
    damage = damage/2 + random(damage);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                         HIR "只听$n" HIR "一声惨嚎，躲避不及，妖雾中"
                         "迷迷糊糊被一剑刺个正着。\n" NOR);
    me->add("force", -50);
  }

  else
  {
     msg += CYN "可是$n" CYN "眼明手快，奋力招架，将$N"
            CYN "的招式全部挡开。\n" NOR;
     me->add("force", -30);
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

