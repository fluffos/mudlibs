#include <ansi.h>
#include <combat.h>
#define LUO "「" HIW "无痕一刀斩" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "陷空山无底洞")
    return notify_fail(LUO"是陷空山无底洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("kuangfeng-blade", 1) < 80)
    return notify_fail("你的狂风刀法修为不够，难以施展" LUO "。\n");
  if (me->query_skill("huntian-qigong", 1) < 80)
    return notify_fail("你的混天气功修为不够，难以施展" LUO "。\n");
  if (me->query_skill_mapped("blade") != "kuangfeng-blade")
    return notify_fail("你没有激发狂风刀法，难以施展" LUO "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" LUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  int damage;
  string msg, wn;
  object weapon;

  if (! objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你所使用的武器不对，难以施展" LUO "。\n");
  wn = weapon->name();

  msg = HIW "\n$N" HIW "将" + wn + HIW "斜指长空，猛地飞身跃起，"
        + wn + HIW "长响一声，寒光闪闪，\n犹如一道闪电劈空而下，一招"
        "「" HIG "狂风落叶" HIW "」已使出，以千军不可挡之势袭向$n" HIW
        "。\n" NOR;
  message_vision(msg, me, target);
  if (COMBAT_D->perform_success(me, target,
                                "blade",
                                "parry"))
  {
    damage = me->query_skill("blade");
    damage += me->query_skill("force")/2;
    damage = damage/3 + random(damage);
    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                         HIR "$n" HIR "只见一道电光从半空袭来，"
                         "心中惊骇不已，但鲜血已从$n胸口喷出。\n"
                         NOR);
    me->add("force", -100);
  }

  else
  {
    msg = CYN "然而$n" CYN "眼明手快，侧身一跳"
              "躲过$N" CYN "这一刀。\n" NOR;
    me->add("force", -50);
  }

  message_combatd(msg, me, target);
  me->start_busy(1 + random(3));
  return 1;
}

