#include <ansi.h>
#include <combat.h>
#define KAI "「" HIW "裂云矛" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && me->query("family/family_name") != "大雪山")
    return notify_fail(KAI"是大雪山不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
	
  if (me->query_skill("fenghuang-spear", 1) < 100)
    return notify_fail("你的凤凰枪法修为不够，难以施展" KAI "。\n");
  if (me->query_skill("ningxue-force", 1) < 100)
    return notify_fail("你的冰谷凝血功修为不够，难以施展" KAI "。\n");
  if (me->query_skill_mapped("spear") != "fenghuang-spear")
    return notify_fail("你没有激发凤凰枪法，难以施展" KAI "。\n");
  if (me->query_skill_mapped("force") != "ningxue-force")
    return notify_fail("你没有激发冰谷凝血功，难以施展" KAI "。\n");
  if ((int)me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" KAI "。\n");
  return 1;
}
int perform(object me, object target)
{
  object weapon;
  int damage;
  string msg;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "spear")
    return notify_fail("你使用的武器不对，难以施展" KAI "。\n");
  msg = HIW "$N" HIW "大喝一声，响遏行云。手中的"NOR + weapon->name() +
        HIW "借助这一喝的气势，枪锋带出一道罡气直刺$n ！\n" NOR;
  if (COMBAT_D->perform_success(me, target,
                                ({"spear","force"}),
                                ({"parry","dodge"})))
  {
    damage = me->query_skill("spear");
    damage += me->query_skill("force")/2;
    damage = ap/2 + random(ap);
    me->add("force", -60);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 45,
                           HIR "$n" HIR "招架不及，顿时被$N" HIR
                           "刺中要害，鲜血迸了一地！\n" NOR);
  }
  else
  {
    msg += CYN "可是$p" CYN "凝神聚气，护住门户，$P"
           CYN "攻势虽然凌厉，始终奈何不得。\n" NOR;
    me->add("force", -30);
  }
  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}
