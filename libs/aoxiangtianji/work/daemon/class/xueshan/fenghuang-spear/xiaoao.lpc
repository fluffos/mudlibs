#include <ansi.h>
#include <combat.h>
#define HUO "「" HIR "傲啸云尘" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "大雪山")
    return notify_fail(HUO"是大雪山不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("fenghuang-spear", 1) < 150)
    return notify_fail("你的凤凰枪修为不够，难以施展" HUO "。\n");
  if (me->query_skill("ningxue-force", 1) < 150)
    return notify_fail("你的火魔心法修为不够，难以施展" HUO "。\n");
  if (me->query_skill_mapped("spear") != "fenghuang-spear")
    return notify_fail("你没有激发凤凰枪，难以施展" HUO "。\n");
  if (me->query_skill_mapped("force")!="ningxue-force")
    return notify_fail(HUO"必须配合火魔心法才能使用。\n");
  if (me->query("force") < 500)
    return notify_fail("你的真气不够，难以施展" HUO "。\n");
  if ((int)me->query("max_force") < 2000)
    return notify_fail("你的内力修为不够，难以施展" HUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  string msg;
  object weapon;
  int i,j;

  if (!objectp(weapon = me->query_temp("weapon"))
  || (string)weapon->query("skill_type") != "spear")
    return notify_fail("你使用的武器不对。\n");

  msg = HIY"$N" HIY"手中" + weapon->name() + HIY"展开如凤凰展开双翅，十分杀气，十分傲气！\n"
           "$P双眼冷冷，纵身跃起，攻势如雪山的冷风，在尖历的啸声中发动了！\n"NOR;
  message_combatd(msg, me, target);
  j = me->query_temp("apply/attack");
  for (i = 5;i<=8;i++)
  {
    if (!me->is_fighting(target))
      break;
    me->add_temp("apply/attack", i*20);
    if (random(2) && !target->is_busy())
      target->start_busy(1);
    me->set_temp("FHS_perform",i);
    me->add("force",-30);
    COMBAT_D->do_attack(me,target, weapon);
  }

  me->delete_temp("FHS_perform");
  me->set_temp("apply/attack", j);
  me->start_busy(2+random(3));
  return 1;
}

