#include <ansi.h>
#include <combat.h>
#define KAI "「" HIW "凤凰展翅" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && !wizardp(me) && me->query("family/family_name") != "大雪山")
    return notify_fail(KAI"是大雪山不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("fenghuang-spear", 1) < 200)
    return notify_fail("你的凤凰枪法修为不够，难以施展" KAI "。\n");
  if (me->query_skill("ningxue-force", 1) < 200)
    return notify_fail("你的冰谷凝血功修为不够，难以施展" KAI "。\n");
  if (me->query_skill_mapped("spear") != "fenghuang-spear")
    return notify_fail("你没有激发凤凰枪法，难以施展" KAI "。\n");
  if (me->query_skill_mapped("force") != "ningxue-force")
    return notify_fail("你没有激发冰谷凝血功，难以施展" KAI "。\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你的真气不够，难以施展" KAI "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  int damage;
  string msg;
  int ap, dp;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "spear")
    return notify_fail("你使用的武器不对，难以施展" KAI "。\n");
  msg = HIW"$N双手一展,突然临空腾起,四周百鸟齐鸣，一只凤凰傲然展羽,携百鸟凌空扑向$n。\n"NOR;
  damage = me->query_skill("spear");
  damage = random(damage/10) + 1;
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"spear");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
    damage = me->query_skill("spear");
    damage += random(me->query_skill("dodge") + 1);
    damage = damage/2 + random(damage);
    me->add("force", -60);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
            HIR "$n" HIR "眼见鸟羽纷飞，无从躲避，顿时被$N" HIR"刺中要害！\n" NOR);
  }

  else
  {
    msg += HIC"可是却被$p"HIC"伏地一滚躲开了。\n"NOR;
    me->add("force", -30);
  }

  message_combatd(msg, me, target);

  if ((int)me->query_skill("fenghuang-spear",1) > 220)
  {
    if (!target->is_busy())
      target->start_busy(1);
    call_out("perform2", 1, me, target);
  }

  else
  {
    if (!me->is_busy())
      me->start_busy(1+random(3));
  }

  return 1;
}

int perform2(object me, object target)
{
  object weapon;
  int damage;
  string msg;
  int ap, dp;
  if (!objectp(me) || !living(me))
    return 0;

  if (!objectp(target)
    || !environment(target)
    || !living(target)
    || environment(me)!=environment(target))
  {
    message_vision("$N缓缓收拢羽翼，傲然而立！\n",me);
    return 0;
  }

  if (!me->is_fighting(target))
  {
    tell_object(me,sprintf("你不再和%s战斗，慢慢收回了攻势！\n",target->name()));
    message_vision("$N缓缓收拢羽翼，攻势随之瓦解了！\n",me);
    me->start_busy(2);
    return 0;
  }

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "spear")
  {
    tell_object(me,"你换了兵器，无法继续攻击敌人了！\n");
    message_vision("$N缓缓收拢羽翼，攻势随之瓦解了！\n",me);
    me->start_busy(2);
    return 0;
  }

  if (me->query_skill_mapped("spear") != "fenghuang-spear")
  {
    tell_object(me,"你不再使用凤凰枪了，无法继续攻击敌人！\n");
    message_vision("$N缓缓收拢羽翼，攻势随之瓦解了！\n",me);
    me->start_busy(2);
    return 0;
  }

  if (me->query_skill_mapped("force") != "ningxue-force")
  {
    tell_object(me,"你不再使用了冰谷凝血功，无法继续攻击敌人！\n");
    message_vision("$N缓缓收拢羽翼，攻势随之瓦解了！\n",me);
    me->start_busy(2);
    return 0;
  }

  if ((int)me->query("force") < 500)
  {
    tell_object(me,"你内力不足，无法继续攻击敌人！\n");
    message_vision("$N缓缓收拢羽翼，攻势随之瓦解了！\n",me);
    me->start_busy(2);
    return 0;
  }

  msg = HIW"只见$N突然一振翅翼,手中"NOR + weapon->name() +
        HIW"电光闪射，直击$n。 \n" NOR;
  damage = me->query_skill("fenghuang-spear",1);
  damage = random(damage/10) + 1;
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"spear");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
    damage = me->query_skill("spear");
    damage += random(me->query_skill("dodge") + 1);
    damage = damage/2 + random(damage);
    me->add("force", -60);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
            HIR "$n" HIR "眼见枪来如电，躲避不及，顿时被$N" HIR"刺中要害！\n" NOR);
  }

  else
  {
    msg += HIC"却被$p"HIC"躲开了。\n"NOR;
    me->add("force", -30);
  }

  message_combatd(msg, me, target);
  if ((int)me->query_skill("fenghuang-spear",1) > 250)
  {
    if (!target->is_busy())
      target->start_busy(1);
    call_out("perform3", 1, me, target);
  }

  else
  {
    if (!me->is_busy())
      me->start_busy(1+random(3));
  }

  return 1;
}

int perform3(object me, object target)
{
  object weapon;
  string msg;
  int i,j;
  if (!objectp(me) || !living(me))
    return 0;

  if (!objectp(target)
    || !environment(target)
    || !living(target)
    || environment(me)!=environment(target))
  {
    message_vision("$N缓缓收拢羽翼，傲然而立！\n",me);
    return 0;
  }

  if (!me->is_fighting(target))
  {
    tell_object(me,sprintf("你不再和%s战斗，慢慢收回了攻势！\n",target->name()));
    message_vision("$N缓缓收拢羽翼，攻势随之瓦解了！\n",me);
    me->start_busy(2);
    return 0;
  }

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "spear")
  {
    tell_object(me,"你换了兵器，无法继续攻击敌人了！\n");
    message_vision("$N缓缓收拢羽翼，攻势随之瓦解了！\n",me);
    me->start_busy(2);
    return 0;
  }

  if (me->query_skill_mapped("spear") != "fenghuang-spear")
  {
    tell_object(me,"你不再使用凤凰枪了，无法继续攻击敌人！\n");
    message_vision("$N缓缓收拢羽翼，攻势随之瓦解了！\n",me);
    me->start_busy(2);
    return 0;
  }

  if (me->query_skill_mapped("force") != "ningxue-force")
  {
    tell_object(me,"你不再使用了冰谷凝血功，无法继续攻击敌人！\n");
    message_vision("$N缓缓收拢羽翼，攻势随之瓦解了！\n",me);
    me->start_busy(2);
    return 0;
  }

  if ((int)me->query("force") < 500)
  {
    tell_object(me,"你内力不足，无法继续攻击敌人！\n");
    message_vision("$N缓缓收拢羽翼，攻势随之瓦解了！\n",me);
    me->start_busy(2);
    return 0;
  }

  msg = HIY"$N" HIY"双展翅翼,啸起漫天黄沙,一声吠唳。。。瞬间已然站在" HIY"$n"
        HIY"面前。。。\n只见百鸟分飞,绕住$n" HIY"全身。$N" HIY"狂风暴雨般地向"
        HIY"$n"HIY"连下杀式！\n"NOR;

  message_combatd(msg, me, target);
  j = me->query_temp("apply/attack");
  for (i=1;i<=3;i++)
  {
    if (!me->is_fighting(target))
      break;
    if (!target->is_busy() && (random(2)==1))
      target->start_busy(1);
    me->add_temp("apply/attack", i*30);
    COMBAT_D->do_attack(me, target, weapon,3);
    me->add("force",-30);
  }

  me->set_temp("apply/attack", j);
  me->start_busy(2+random(3));
  return 1;
}