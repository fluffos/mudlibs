#include <ansi.h>
#include <combat.h>
#define XUESHAN "「" HIR "魔兽吞天" NOR "」"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "大雪山")
    return notify_fail(sprintf("%s是大雪山不传之密！\n",XUESHAN));
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("dengxian-dafa", 1) < 150)
    return notify_fail(sprintf("你的登仙大法修为不够，难以施展%s。\n",XUESHAN));

  if( (int)me->query("max_mana") < 500 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",XUESHAN));

  if( (int)me->query("force") < 500 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 200+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 500 )
    return notify_fail("你无法集中精力！\n");

  return 1;
}

int cast_attack(object me, object target)
{
  int success_adj;
  int damage;
  string msg_init,msg_success,msg_fail,msg_backfire_init,msg_backfire_success;

  success_adj = SKILL_D("dengxian-dafa")->query_power_effect(me);
  if( !target )
    target = offensive_target(me);
  if( !target
   || !target->is_character()
   || target->is_corpse()
   || target==me)
    return notify_fail(sprintf("你要对谁施%s？\n",XUESHAN));
  me->add("mana", -100-2*(int)me->query("mana_factor"));
  me->receive_damage("sen", 80);
  if( random(me->query("max_mana")) < 200 )
  {
    write("你一着急竟然忘了咒语。\n");
    return 1;
  }

  msg_init = HIC "$N" HIC"口中念了句咒文，半空闪出一只青面獠牙的狮子，张开血盆大口向$n"
             HIC"咬去！\n" NOR;
  msg_success = HIR "结果$n" HIR"被咬了个正着！\n" NOR;
  msg_fail = HIC "$n" HIC"连忙一侧身闪在一旁。\n" NOR;
  msg_backfire_init = HIC "只见$n" HIC"一声怒吼，青面狮子吓得辨不青方向，反而咬中了$N"
                      HIC"！\n" NOR;
  msg_backfire_success = HIC "结果$n" HIC"被咬了个正着！\n" NOR;

  success_adj += random(20);

  damage = SPELL_D->attacking_cast(
       me,             //attacker
       target,         //target
       success_adj,    //success adjustment
       BACKFIRE,       //backfire or not
       "kee",          //damage type: "both", "kee"/"qi", "sen"/"shen"
       msg_init,
       msg_success,
       msg_fail,
       msg_backfire_init,
       msg_backfire_success);
  me->start_busy(2+random(2));
  return 1;
}