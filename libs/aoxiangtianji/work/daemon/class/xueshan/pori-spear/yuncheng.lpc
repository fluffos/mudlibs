#include <ansi.h>
#include <combat.h>
#define KAI "「" HIW "云程万里" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && me->query("family/family_name") != "大雪山")
    return notify_fail(KAI"是大雪山不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("pori-spear", 1) < 100)
    return notify_fail("你的破日枪法修为不够，难以施展" KAI "。\n");
  if (me->query_skill("ningxue-force", 1) < 100)
    return notify_fail("你的冰谷凝血功修为不够，难以施展" KAI "。\n");
  if (me->query_skill_mapped("spear") != "pori-spear")
    return notify_fail("你没有激发破日枪法，难以施展" KAI "。\n");
  if (me->query_skill_mapped("force") != "ningxue-force")
    return notify_fail("你没有激发冰谷凝血功，难以施展" KAI "。\n");
  if ((int)me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" KAI "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  int damage;
  string msg;
  int ap, dp;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "spear")
    return notify_fail("你使用的武器不对，难以施展" KAI "。\n");
  msg = HIW "$N" HIW "一个纵身，快愈闪电，手中的" + weapon->name() +  HIW "向下疾刺，"
            "枪锋破风而来，幻出虚影重重，攻势凌厉的杀向$n" HIW "\n" NOR;
  damage = me->query_skill("spear");
  damage = random(damage/10) + 1;
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"spear");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
    damage = me->query_skill("spear");
    damage += random(me->query_skill("dodge") + 1);
    damage = damage/2 + random(damage);
    me->add("force", -60);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                           HIR "$n" HIR "招架不及，顿时被$N" HIR
                           "刺中要害！\n" NOR);
  }

  else
  {
    msg += CYN "可是$p" CYN "凝神聚气，护住门户，$P"
           CYN "攻势虽猛，却始终奈何不得。\n" NOR;
    me->add("force", -30);
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

