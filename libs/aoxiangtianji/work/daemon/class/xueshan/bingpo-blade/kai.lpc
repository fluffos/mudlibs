#include <ansi.h>
#include <combat.h>
#define KAI "「" HIW "冰河开封" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && me->query("family/family_name") != "大雪山")
    return notify_fail(KAI"是大雪山不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("bingpo-blade", 1) < 100)
    return notify_fail("你的冰魄刀法修为不够，难以施展" KAI "。\n");
  if (me->query_skill("ningxue-force", 1) < 100)
    return notify_fail("你的冰谷凝血功修为不够，难以施展" KAI "。\n");
  if (me->query_skill_mapped("blade") != "bingpo-blade")
    return notify_fail("你没有激发冰魄刀法，难以施展" KAI "。\n");
  if (me->query_skill_mapped("force") != "ningxue-force")
    return notify_fail("你没有激发冰谷凝血功，难以施展" KAI "。\n");
  if ((int)me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" KAI "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  int damage;
  string msg;
  int i,j;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对，难以施展" KAI "。\n");
  message_vision("$N淡淡一笑，手中" + weapon->name() + "迎风泼斩，眨眼就是迅猛三刀！\n\n",me);
  j = me->query_temp("apply/attack");
  for (i = 1;i<=3;i++)
  {
    if (!me->is_fighting(target))
      break;
    me->add_temp("apply/attack", i*25);
    if (random(2) && !target->is_busy())
      target->start_busy(1);
    me->add("force",-30);
    COMBAT_D->do_attack(me,target, weapon);
  }

  me->set_temp("apply/attack", j);
  msg = HIW "只见$N" HIW "手中的"NOR + weapon->name() +  HIW "稍做停顿，突的豪光绽放，嗡"
            "嗡作响，刀锋顿时迸出一道寒芒向$n" HIW "砍落！\n" NOR;
  if (COMBAT_D->perform_success(me, target,
                                ({"blade","force"}),
                                ({"parry","dodge"})))
  {
    damage = me->query_skill("blade") + me->query_skill("force")/2;
    damage = damage/3 + random(damage);
    me->add("force", -60);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 35,
                           HIR "$n" HIR "招架不及，顿时被$N" HIR
                           "凌厉的刀芒划中要害，鲜血狂溅而出！\n" NOR);
  }

  else
  {
    msg += CYN "可是$p" CYN "凝神聚气，护住门户，$P"
           CYN "刀芒虽然凌厉，始终奈何不得。\n" NOR;
    me->add("force", -30);
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

