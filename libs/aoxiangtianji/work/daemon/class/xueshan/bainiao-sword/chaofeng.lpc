#include <ansi.h>
#include <combat.h>
#define KAI "「" HIW "百鸟朝凤" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && !wizardp(me) && me->query("family/family_name") != "大雪山")
    return notify_fail(KAI"是大雪山不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("bainiao-sword", 1) < 180)
    return notify_fail("你的百鸟剑法修为不够，难以施展" KAI "。\n");
  if (me->query_skill("ningxue-force", 1) < 180)
    return notify_fail("你的冰谷凝血功修为不够，难以施展" KAI "。\n");
  if (me->query_skill("throwing", 1) < 120)
    return notify_fail("你的暗器修为不够，难以施展" KAI "。\n");
  if (me->query_skill_mapped("sword") != "bainiao-sword")
    return notify_fail("你没有激发百鸟剑法，难以施展" KAI "。\n");
  if (me->query_skill_mapped("force") != "ningxue-force")
    return notify_fail("你没有激发冰谷凝血功，难以施展" KAI "。\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你的真气不够，难以施展" KAI "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  int damage;
  string msg;
  int i,anqi, percp, ap, dp;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对，难以施展" KAI "。\n");
  anqi = me->query_skill("throwing",1);
  msg = HIW"只见" HIY"$N" HIY"手中"NOR + weapon->name() + HIW"急颤，幻出满天剑芒，"NOR;
  if (anqi > 300)
    msg += HIW"无数锐啸声加着剑气"NOR;
  else if (anqi > 200)
    msg += HIW"数十道锐啸声加着剑气"NOR;
  else if (anqi > 120)
    msg += HIW"数道锐啸声加着剑气"NOR;
  msg += HIW"有如百鸟投林般向$n扑来！\n" NOR;
  percp = (int)me->query_skill("perception",1) + (int)me->query_skill("count",1);

  ap = me->query_skill("sword");
  i = anqi/80;
  if (i > 1)
    i = 1 + random(i);
  if (i > 5)
    i = 5;
  ap += ap*i;

  dp = me->query_skill("dodge");
  i = percp/50 ;
  if (i > 1)
    i = 1 + random(i);
  if (i > 5)
    i = 5;
  dp += dp*i;
  if (me->query_temp("no_move"))
    ap -= ap/3 ;
  if (target->query_temp("no_move"))
    dp -= dp/3;

  if (ap*100/(ap+dp) > random(100))
  {
    damage = ap/2 + random(ap/2);
    me->add("force", -100);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                           HIR "$n" HIR "闪躲不及，惨叫声中，满身的鲜血" HIR
                           "迸溅！\n" NOR);
    me->start_busy(2);
  }

  else
  {
    msg += CYN "可是$n" CYN "身形疾快，$N"
           CYN "攻势未到，$p已经轻巧的躲开。\n" NOR;
    me->add("force", -50);
    me->start_busy(2+random(3));
  }

  message_combatd(msg, me, target);
  return 1;
}

