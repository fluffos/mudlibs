#include <ansi.h>
#include <combat.h>
#define SHA "「" HIW "瑞雪纷飞" NOR "」"
int is_not_attack(object me) { return 0;}

int valid_pfm(object me, object target)
{
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if ((int)me->query_skill("lihua-spear", 1) < 120)
    return notify_fail("你的梨花枪法修为不够，难以施展" SHA "。\n");
  if ((string)me->query_skill_mapped("spear") != "lihua-spear")
    return notify_fail("你没有激发梨花枪，难以施展" SHA "。\n");
  if (me->query("force") < 100)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");

  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap, dp;
  int damage;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "spear")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = HIR "$N枪势一转，" HIR "手中" + weapon->name() +
        HIR "舞动如瑞雪纷飞。这枪法突然有了很大的改变，"
            "朵朵雪花直奔$n" HIR "戮去！\n" NOR;
  damage = me->query_skill("spear");
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"spear");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
    damage = me->query_skill("spear");
    damage += me->query_skill("force")/3;
    damage = damage/3 + random(damage);
    me->add("force", -60);
    me->start_busy(1+random(2));
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 20,
                        HIR "$n" HIR "眼见万朵雪花扑面而来，真个无处"
                        "可躲。\n" HIR"$N" HIR + weapon->name() + HIR "突从"
                        "这万朵雪花之中，破闪而出，眨眼带出一溜血光。\n"
                         NOR);
  }

  else
  {
    me->add("force", -30);
    me->start_busy(1+random(3));
    msg += CYN "$n并不慌乱，见招拆招，奋力把这万朵雪花挡了出去！\n"NOR;
  }

  message_combatd(msg, me, target);
  return 1;
}

