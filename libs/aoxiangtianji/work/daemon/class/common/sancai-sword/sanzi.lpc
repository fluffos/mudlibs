#include <ansi.h>
#include <combat.h>
#define SHA "「" HIR "三字诀" NOR "」"
int is_not_attack(object me) { return 0;}

int valid_pfm(object me, object target)
{
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if ((int)me->query_skill("sancai-sword", 1) < 120)
    return notify_fail("你的三才剑法修为不够，难以施展" SHA "。\n");
  if ((string)me->query_skill_mapped("sword") != "sancai-sword")
    return notify_fail("你没有激发三才剑，难以施展" SHA "。\n");
  if (me->query("force") < 100)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");

  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap, dp;
  int damage;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = HIR "$N" HIR "默运内力，手中" + weapon->name() +
        HIR "突然变得灵动异常，从上中下三路"
            "直奔$n" HIR "而去！\n" NOR;
  damage = me->query_skill("sancai-sword");
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"sword");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp,110))
  {
    damage = me->query_skill("sword");
    damage += me->query_skill("force")/3;
    damage = damage/2 +random(damage);
    me->add("force", -50);
    me->start_busy(1+random(2));
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                               HIR "只见$n" HIR "躲避不及，$N" HIR +
                               weapon->name() + HIR "连闪光芒，"
                               "溅起一片血光。\n"
                               NOR);
  }

  else
  {
    me->add("force", -100);
    me->start_busy(1+random(3));
    msg += CYN "$n" CYN "见$P" CYN "施展绝技，不敢掉以轻心"
               "，连忙飞身腾挪，躲闪开来。\n" NOR;
  }

  message_combatd(msg, me, target);
  return 1;
}