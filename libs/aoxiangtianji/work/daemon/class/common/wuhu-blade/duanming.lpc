#include <ansi.h>
#include <combat.h>
#define SHA "「" HIM "断命一刀" NOR "」"
int is_not_attack(object me) { return 0;}

int valid_pfm(object me, object target)
{
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if ((int)me->query_skill("wuhu-blade", 1) < 120)
    return notify_fail("你的五虎断门刀修为不够，难以施展" SHA "。\n");
  if ((string)me->query_skill_mapped("blade") != "wuhu-blade")
    return notify_fail("你没有激发五虎断门刀，难以施展" SHA "。\n");
  if (me->query("force") < 100)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");

  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap, dp;
  int damage;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = HIR "$N大喝一声，双眉直立了起来。手中" + weapon->name() +
        HIR "从半空直劈而下，这刀芒如电，直袭$n" HIR "而去！\n" NOR;
  damage = me->query_skill("blade");
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"blade");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp,110))
  {
    damage = (int)me->query_skill("blade");
    damage += (int)me->query_skill("force")/3;
    damage = damage/2 +random(damage);
    me->add("force", -80);
    me->start_busy(1+random(2));
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                               HIR "$n只觉眼前一花，哪里可能闪开，"
                               "$N" HIR + weapon->name() + HIR "直没而入，"
                               "惨叫声中，鲜血飘洒了一地。\n"
                               NOR);
  }

  else
  {
    me->add("force", -50);
    me->start_busy(1+random(3));
    msg += CYN "$n大吃一惊，急忙一个后仰地滚，这道光芒仿佛直没入地中！\n"NOR;
  }

  message_combatd(msg, me, target);
  return 1;
}