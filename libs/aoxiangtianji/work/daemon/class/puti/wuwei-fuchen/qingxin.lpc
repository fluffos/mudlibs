#include <ansi.h>
#include <combat.h>
#define QINGXIN "「" HIY "清心除邪" NOR "」"
inherit F_SSERVER;
string final(object me, object target, int damage);
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail(QINGXIN"是方寸山三星洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("wuwei-fuchen", 1) < 120)
    return notify_fail("你的无为拂尘修为不够，难以施展" QINGXIN "。\n");
  if (me->query_skill_mapped("whip") != "wuwei-fuchen")
    return notify_fail("你没有激发无为拂尘，难以施展" QINGXIN "。\n");
  if (me->query("force") < 300)
    return notify_fail("你的真气不够，难以施展" QINGXIN "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;

  int damage;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "whip")
    return notify_fail("你使用的武器不对，难以施展" QINGXIN "。\n");
  msg = HIY "$N" HIY "清神朗目，身形飘逸，随手挥鞭，横扫$n" HIY "而去，毫"
            "无半点花巧可言。\n" NOR;
  me->add("force", -50);
  if (COMBAT_D->perform_success(me, target,
                                ({"whip","force"}),
                                ({"dodge","parry"}),
                                105))
  {
    damage = (int)me->query_skill("whip") + (int)me->query_skill("force")/2;
    damage = damage/3 + random(damage);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                              (: final, me, target, damage :));
  }

  else
  {
    msg += HIC "可是$n" HIC "看透$P" HIC "招后更有杀着，镇"
               "定逾恒，全神应对自如。\n" NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

string final(object me, object target, int damage)
{
  target->receive_damage("sen", damage/3, me);
  target->receive_wound("sen", damage/6, me);
  if (!target->is_busy() && living(target))
    target->start_busy(2+random(3));
  return  HIY "结果$n" HIY "却丝毫未把这招放在眼里，随手应了一招，却见$N"
          HIY "招式\n忽然一变，气象万千，变幻无穷，鞭影重重，避无可避！\n" NOR +
          HIR "$n" HIR "顿时惊慌失措，被$P" HIR "这一鞭抽中要害，鲜血崩流"
              "，惨不忍睹！\n" NOR;
}