#include <ansi.h>
#include <combat.h>
#define SHA "「" HIR "谈笑退天兵" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && me->query("family/family_name") != "方寸山三星洞")
    return notify_fail(SHA"是方寸山三星洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("qitian-stick", 1) < 150)
    return notify_fail("你的齐天棍修为不够，难以施展" SHA "。\n");
  if (me->query_skill("wuxiangforce", 1) < 150)
    return notify_fail("你的小无相功修为不够，难以施展" SHA "。\n");
  if (me->query_skill_mapped("stick") != "qitian-stick")
    return notify_fail("你没有激发齐天棍，难以施展" SHA "。\n");
  if (me->query("force") < 500)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap,dp,damage;

  string *hitone = ({
    HIY"$n急忙用手中的兵器格挡，但是$N的招式太突然了，$n哼了一声,左肩上已重重的吃了一棍。\n"NOR,
    HIY"$n就没有想到这一招竟然有如此巨大的威力。$N一棒重重的打在$n的右臂。\n"NOR,
    HIY"$n略一迟疑，棒影如疾风而至，$N这一棒正中$n的右肩。\n"NOR,
  });
  string *missone = ({
    BLU"$n轻轻一闪，棒影带着一阵劲风从身边砸下，但没伤到$n分毫。\n"NOR,
    BLU "$n早有防备，待到$N打来之时，侧身退步，这一招被$n尽数化解。\n"NOR,
    BLU "$n哈哈大笑：雕虫小技，也来这里卖弄，看我怎么收拾你！\n"NOR,
  });
  string *hittwo = ({
    HIW"$n没想道$N攻势如此之快，急忙低头闪避，但无法躲开，这一棒正好砸中$n的后背！\n"NOR,
    HIW "$n毫无还手之力，眼睁睁的看着被$N当头一棒，$n顿时血流满面,形状极其可怕！\n"NOR,
    HIW "$n知道不妙，急忙将兵器架于头顶之上，$N眼明手快，将腕一抖，一棒横打在$n的腰间。\n"NOR,
  });
  string *misstwo = ({
    HIB"$n脑袋微微一侧，避过了$N的攻势。\n"NOR,
    HIC"$n似乎早已料到这一招，避了开去。\n"NOR,
    HIG"眼看这招要把砸中$n脑袋，突然间$n一个侧翻，$N这招落了个空。\n"NOR,
  });
  string *hitthree = ({
    HIR"$n似乎已被吓破了胆，再也无力躲避这凌厉一击。\n"NOR,
    HIR "$n大喊一声：不好！好字还没有说出口，被$N一棒打在背上，“哇”的一声喷出一口鲜血。\n"NOR,
    HIR "$N大喊一声：送你上西天！将手中的棒子舞做一团彩雾，劈头盖脸的打了过来。\n"
        "$n看不出破绽，吃了重重的一棒!\n"NOR,
  });
  string *missthree = ({
    HIC"$n似乎早已熟知此招来路，棒未到，人已先轻飘飘地避开了。\n"NOR,
    HIB"$n眼见躲不过来招，急忙在地上一滚。虽然避得狼狈，但丝毫没有受伤。\n"NOR,
    HIG"$n不顾自身危险，中宫直进，向$N攻去，果然将来招化解了。\n"NOR,
  });
  string *hit = ({
    HIW "$N道：那里来的毛神，在我面前卖弄？\n"NOR,
    HIW "这一招着实厉害，$n连反应都没有来得急就被$N重击一棒，手臂乌黑，伤势严重！"NOR,
    HIW"$N狂笑道：就凭你这点本事，也来跟我斗？\n"NOR,
  });
  string *miss = ({
    BLU"$n哈哈大笑道：听说这齐天棍有多少威力，现在一看，也不过如此嘛！\n"NOR,
    BLU"$n长笑一声，对$N不屑地说道：就这点本事，我还没放在眼里！\n"NOR,
    BLU"$n仰天大笑道：还有什么本事，尽管拿出来吧！\n"NOR,
  });
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "stick")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = CYN "$N默运小无相内力，身形滴溜乱转，如同三头六臂一般！\n\n手中" +
        weapon->name() + CYN"如车轮般翻滚飞舞，满天的棒影重重叠叠直砸$n！\n" NOR;
  if (COMBAT_D->perform_success(me, target,
                                ({"stick","force"}),
                                ({"dodge","parry"}),
                                110))
  {
    damage = me->query_skill("stick");
    damage += me->query_skill("force")/2;
    damage = damage/2 + random(damage);
    me->add("force", -80);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                               element_of(hitone));
  }

  else
  {
    me->add("force", -30);
    msg += element_of(missone);
  }

  if (!living(target) || environment(me) != environment(target))
  {
    msg += element_of(hit);
    message_combatd(msg, me, target);
    me->start_busy(1+random(3));
    return 1;
  }

  message_combatd(msg, me, target);

  damage = me->query_skill("stick");
  damage = random(damage/10) + 1;
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"stick");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
    damage = me->query_str();
    damage += me->query_skill("stick");
    damage = damage/2 + random(damage);
    me->add("force", -80);
    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                               element_of(hittwo));
  }

  else
  {
    me->add("force", -30);
    msg = element_of(misstwo);
  }

  if (!living(target) || environment(me) != environment(target))
  {
    msg += element_of(hit);
    message_combatd(msg, me, target);
    me->start_busy(1+random(3));
    return 1;
  }

  message_combatd(msg, me, target);
  damage = me->query_skill("stick");
  damage = random(damage/10) + 1;
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"stick");
  dp = COMBACC_D->math_pp(me,target,-damage,0);
  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
    damage = me->query_str();
    damage += me->query_skill("stick");
    damage = damage/2 + random(damage);
    me->add("force", -80);
    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                               element_of(hitthree));
  }

  else
  {
    me->add("force", -30);
    msg = element_of(missthree);
  }

  if (!living(target) || environment(me) != environment(target))
    msg += element_of(hit);
  if (!damage)
    msg += element_of(miss);

  message_combatd(msg, me, target);
  me->start_busy(2+random(3));
  return 1;
}

