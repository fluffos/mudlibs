#include <ansi.h>
#include <combat.h>
#define PILI "「" HIR "神猴狂舞" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail(PILI"是方寸山三星洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("qianjun-stick", 1) < 220)
    return notify_fail("你的千均棒修为不够，难以施展" PILI "。\n");
  if (me->query_skill_mapped("stick") != "qianjun-stick")
    return notify_fail("你没有激发千均棒，难以施展" PILI "。\n");
  if (me->query("force") < 1000)
    return notify_fail("你的真气不够，难以施展" PILI "。\n");
  return 1;
}

int perform2(object me, object target);
int perform3(object me, object target);
int perform(object me, object target)
{
  object weapon;
  string msg;
  int damage;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "stick")
    return notify_fail("你使用的武器不对，难以施展" PILI "。\n");

  msg = HIY "$N使出方寸山绝技「神猴狂舞」，身法陡然加快！\n" NOR;
  msg += HIC "但见$n大喝一声，愈以内力克制。\n" NOR;

  if (COMBAT_D->perform_success(me, target,
                                ({"stick","force"}),
                                ({"force","dodge"}),
                                120))
  {
    damage = me->query_skill("stick") + me->query_skill("force")/2;
    me->add("force",-100);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                               HIC"结果$n只挡住开始两招，就再也无法抵挡$N澎湃的袭击了。"
                               "\n$n只觉得一股劲气象闪电一般，穿体而过！“哇”的一声，$p喷出"
                               "一大口鲜血！\n\n"NOR);
  }

  else
  {
    me->add("force", -30);
    msg += HIC"$n忙运功向抗，深厚的内力将$N的攻势都激散了。\n\n"NOR;
  }

  message_combatd(msg, me, target);
  if (!target->is_busy())
    target->start_busy(1);
  call_out("perform2",1,me,target);
  return 1;
}

int perform2(object me, object target)
{
  object weapon;
  string msg, wn;
  int ap, dp;
  int damage;

  if (!objectp(me) || !objectp(target))
    return 0;

  if (!living(me))
    return 0;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "stick")
  {
    tell_object(me,sprintf("你换了兵器，%s的攻势瓦解了！\n",PILI));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",PILI),me);
    return 0;
  }

  if ((int)me->query("force") < 500)
  {
    tell_object(me,sprintf("你的内力不足，%s的攻势瓦解了！\n",PILI));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",PILI),me);
    return 0;
  }

  if (me->query_skill_mapped("stick") != "qianjun-stick")
  {
    tell_object(me,sprintf("你改用了别的锏法，%s的攻势瓦解了！\n",PILI));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",PILI),me);
    return 0;
  }

  if (me->query_skill_mapped("force")!="wuxiangforce")
  {
    tell_object(me,sprintf("你改用了别的内功，%s的攻势瓦解了！\n",PILI));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",PILI),me);
    return 0;
  }

  wn = weapon->name();
  if (!living(target) || (environment(me) != environment(target)))
  {
    message_vision("$N眼见$n已经倒地不起，缓缓收回了攻势！\n",me,target);
    me->start_busy(1+random(2));
    return 1;
  }

  msg = HIC "初时似乎出手不重，但其波浪状的棍影后浪击前浪，一浪高过一浪，连绵不尽！\n\n"NOR;

  if (random(5)>2)
    msg += HIC"但见$N倒拖兵器,突然一个仰身,大喝一声,募的绕身回劈,$n眼前一黑!!\n"NOR;
  else
    msg += HIG"但见$N倒拖兵器,突然狂啸一声,抡棍横扫,声势刚烈,$n早已吓慌了手脚!!\n"NOR;
  damage = me->query_skill("stick");
  damage = random(damage/10) + 1;
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"stick");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);

  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
    damage = me->query_skill("stick");
    damage += random(me->query_skill("force") + 1);
    damage = damage/2 + random(damage);
    me->add("force", -120);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                          CYN "$n惊骇之下顿时破绽百出，$n根本无从招架！\n" NOR);
  }

  else
  {
    me->add("force",-80);
    msg += WHT"可是$p料敌之先,抢攻几招，反逼$N连连后退。\n"NOR;
  }

  message_combatd(msg, me, target);
  if (!target->is_busy())
    target->start_busy(1);
  call_out("perform3",1,me,target);
  return 1;
}

int perform3(object me, object target)
{
  object weapon;
  string msg, wn;
  int ap, dp;
  int damage;

  if (!objectp(me) || !objectp(target))
    return 0;

  if (!living(me))
    return 0;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "stick")
  {
    tell_object(me,sprintf("你换了兵器，%s的攻势瓦解了！\n",PILI));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",PILI),me);
    return 0;
  }

  if ((int)me->query("force") < 200)
  {
    tell_object(me,sprintf("你的内力不足，%s的攻势瓦解了！\n",PILI));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",PILI),me);
    return 0;
  }

  if (me->query_skill_mapped("stick") != "qianjun-stick")
  {
    tell_object(me,sprintf("你改用了别的锏法，%s的攻势瓦解了！\n",PILI));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",PILI),me);
    return 0;
  }

  if (me->query_skill_mapped("force")!="wuxiangforce")
  {
    tell_object(me,sprintf("你改用了别的内功，%s的攻势瓦解了！\n",PILI));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",PILI),me);
    return 0;
  }

  wn = weapon->name();
  if (!living(target) || (environment(me) != environment(target)))
  {
    message_vision("$N眼见$n已经倒地不起，缓缓收回了攻势！\n",me,target);
    me->start_busy(1+random(2));
    return 0;
  }

  if (random(5)>2)
  {
    msg = HIC"$N一声咆哮，兵器竟然脱手飞出，如游龙般翱翔青宇，破空射向$n的左肩！\n"NOR;
    msg += HIC "$n大吃一惊，但见$N空手猱身而上，双手擒拿点拍，攻势凌厉之极!\n" NOR;
  }

  else
    msg = HIG"$N长啸一声，一式「天地鹤翔」，腾空飞起，全身迸出无数道棍影，弥漫天际！\n"NOR;

  damage = me->query_skill("stick");
  damage = random(damage/10) + 1;
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"stick");
  dp = COMBACC_D->math_pp(me,target,-damage,0);

  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
    damage = me->query_skill("stick");
    damage += random(me->query_skill("force")+1);
    damage = damage/2 + random(damage);
    me->add("force", -150);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 50,
                          CYN "$n来不及运力抵抗，眼睁睁看着$N这猝不及防的一棒重重的砸"
                              "在头顶！\n" NOR);
  }

  else
  {
    me->add("force", -50);
    msg += HIC"可是$n一个反身,轻轻躲过$N凌厉的进攻。\n"NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(2+random(2));
  return 1;
}