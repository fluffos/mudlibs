#include <ansi.h>
#include <combat.h>
#define PILI "「" HIR "霹雳流星" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail(PILI"是方寸山三星洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("qianjun-stick", 1) < 100)
    return notify_fail("你的千均棒修为不够，难以施展" PILI "。\n");
  if (me->query_skill_mapped("stick") != "qianjun-stick")
    return notify_fail("你没有激发千均棒，难以施展" PILI "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" PILI "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i,j;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "stick")
    return notify_fail("你使用的武器不对，难以施展" PILI "。\n");
  msg = HIY "$N"HIY"一个高跳跃至半空，手中" + weapon->name()
          + "霹雳间连攻数招，正是方寸山绝技" + PILI + HIY"，棒影重重砸往$n！\n" NOR;

  message_combatd(msg, me, target);
  j = me->query_temp("apply/attack");
  for (i = 3; i<=7;i++)
  {
    if (!living(target) || (environment(me) != environment(target)))
      break;
    me->set_temp("QJS_perform",i);
    me->add_temp("apply/attack", i*20);
    if (!target->is_busy() && (random(3)==1))
      target->start_busy(1);
    if (i%2)
      COMBAT_D->do_attack(me, target, weapon,3);
    else
      COMBAT_D->do_attack(me, target, weapon);
    me->add("force",-30);
  }

  me->set_temp("apply/attack", j);
  me->start_busy(1+random(3));
  me->delete_temp("QJS_perform");
  return 1;
}

