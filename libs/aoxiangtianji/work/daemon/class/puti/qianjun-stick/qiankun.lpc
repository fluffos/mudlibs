#include <ansi.h>
#include <combat.h>
#define PILI "「" HIR "乾坤一棒" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail(PILI"是方寸山三星洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("qianjun-stick", 1) < 150)
    return notify_fail("你的千均棒修为不够，难以施展" PILI "。\n");
  if (me->query_skill_mapped("stick") != "qianjun-stick")
    return notify_fail("你没有激发千均棒，难以施展" PILI "。\n");
  if (me->query("force") < 800)
    return notify_fail("你的真气不够，难以施展" PILI "。\n");
  if((int)me->query("sen") < 500 )
    return notify_fail("你的精神不足，没法子施用外功！\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  int i,j,damage;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "stick")
    return notify_fail("你使用的武器不对，难以施展" PILI "。\n");

  message_vision(HIC"$N运足精神，虎跳而起，使出了「乾坤一棒」的绝技！\n"NOR,me);
  me->set_temp("QJS_qiankun", 1);
  i = (int)me->query_temp("apply/attack");
  j = (int)me->query_temp("apply/damage");
  message_vision(HIC"这一棒，从下往上，撼天动地！\n"
                    "$N气势十足，真不负我[美猴王]一身本领！\n"NOR,me);
  if (random(2) && !target->is_busy())
    target->start_busy(1);
  damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  if ((int)me->query("dntg/number") == 10)
  {
    message_vision(HIC"这一棒，抡平横扫，绝天灭地！\n"
                      "$N霸气横生，打破这天上地下的枷锁，五湖四海任我逍遥！\n"NOR,me);
    if (!damage)
    {
      me->add_temp("apply/attack",50);
      me->add_temp("apply/damage",80);
    }

    if (random(2) && !target->is_busy())
      target->start_busy(1 + random(2));
    damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"),3);
  }

  if ((int)me->query("obstacle/number") == 34)
  {
    message_vision(HIC"这一棒，从上往下，锐不可挡！\n"
                      "$N纵横天地，神魔鬼怪挡我者亡！\n"NOR,me);
    if (random(2) && !target->is_busy())
      target->start_busy(1 + random(2));
    if (!damage)
    {
      me->add_temp("apply/attack",50);
      me->add_temp("apply/damage",80);
    }

    COMBAT_D->do_attack(me, target, me->query_temp("weapon"),3);
  }

  me->delete_temp("QJS_qiankun");
  me->set_temp("apply/attack",i);
  me->set_temp("apply/damage",j);
  me->add("force", -200);
  me->start_busy(2+random(2));
  return 1;
}