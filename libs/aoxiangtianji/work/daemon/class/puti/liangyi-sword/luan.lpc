#include <ansi.h>
#include <combat.h>
#define LUAN "「" HIM "乱气剑" NOR "」"
inherit F_SSERVER;
string final(object me, object target, int damage);
int valid_pfm(object me, object target)
{
  if(userp(me) && me->query("family/family_name") != "方寸山三星洞")
    return notify_fail(LUAN"是方寸山三星洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("liangyi-sword", 1) < 150)
    return notify_fail("你的两仪剑修为不够，难以施展" LUAN "。\n");
  if (me->query_skill_mapped("sword") != "liangyi-sword")
    return notify_fail("你没有激发两仪剑，难以施展" LUAN "。\n");
  if ((int)me->query("max_force") < 2000)
    return notify_fail("你的内力不够深厚，无法施展"LUAN"。\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的真气不够，难以施展" LUAN "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int damage;
  if (! objectp(weapon = me->query_temp("weapon")) ||
       (string)weapon->query("skill_type") != "sword")
    return notify_fail("你所使用的武器不对，难以施展" LUAN "。\n");
  msg = HIM "$N" HIM "回转剑锋，手中" + weapon->name() +
        HIM "紫光荡漾，如作龙吟，无形剑气笼罩$n"
        HIM "全身。\n" NOR;
  if (COMBAT_D->perform_success(me, target,
                                ({"sword","force"}),
                                ({"force","parry"}),
                                110))
  {
    damage = (int)me->query_skill("sword") + (int)me->query_skill("force")/2;
    damage = damage/3 + random(damage);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                           (: final, me, target, damage :));
    me->add("force", -120);
  }

  else
  {
    msg += CYN "可是$n内力深厚，使得$P"
           CYN "这一招没有起到任何作用。\n" NOR;
    me->add("force", -80);
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

string final(object me, object target, int damage)
{
  int lvl = me->query_skill("liangyi-sword", 1);
  target->affect_by("liangyi_luan",
          ([ "level"    : lvl/2 + random(lvl),
             "id"       : me->query("id"),
             "duration" : lvl / 50 + random(lvl / 50) ]));
  return  HIR "霎时$n" HIR "心头一阵迷惑，体内的真气登时"
              "不听使唤，四处游走。\n" NOR;
}

