#include <ansi.h>
#include <combat.h>
#define FU "「" HIR "苍灵箭" NOR "」"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail(sprintf("%s是方寸山三星洞不传之密！\n",FU));
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("dao", 1) < 100)
    return notify_fail(sprintf("你的道修为不够，难以施展%s。\n",FU));

  if( (int)me->query("max_mana") < 500 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",FU));

  if( (int)me->query("force") < 100 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 100+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 100 )
    return notify_fail("你无法集中精力！\n");

  return 1;
}

int cast_attack(object me, object target)
{
  int success_adj;
  int damage;
  string msg_init,msg_success,msg_fail,msg_backfire_init,msg_backfire_success;

  success_adj = SKILL_D("dao")->query_power_effect(me);
  if( !target )
    target = offensive_target(me);
  if( !target
   || !target->is_character()
   || target->is_corpse()
   || target==me)
    return notify_fail(sprintf("你要对谁施展%s？\n",FU));
  me->add("mana", -25-2*(int)me->query("mana_factor"));
  me->receive_damage("sen", 50);
  if( random(me->query("max_mana")) < 100 )
  {
    write("你一着急竟然忘了咒语。\n");
    return 1;
  }

  msg_init = HIC "$N" HIC"口中念了句咒文，半空走出一位容貌秀雅的电母，"
             "双手各持一枚铜镜。铜镜相转，忽的闪出一道金光射向" HIC"$n" HIC"！\n" NOR;
  msg_success = HIR "结果「嗤」地一声，金光从" HIR"$n" HIR"身上透体而过，\n"
                "拖出一条长长的血箭，直射到两三丈外的地下！\n" NOR;
  msg_fail = HIC "结果嗤！地一声" HIC"$n" HIC"闻到了一股焦味。还好只烧掉了几根头发。\n" NOR;
  msg_backfire_init = HIC "但是金光被" HIC"$n" HIC"以法力反激，反向" HIC"$N" HIC"射去！\n" NOR;
  msg_backfire_success = HIR "结果金光从" HIR"$n" HIR"身上透体而过，拖出一条长长"
                         "的血箭，直射到两三丈外的地下！\n" NOR;

  damage = SPELL_D->attacking_cast(
       me,             //attacker
       target,         //target
       success_adj,    //success adjustment
       BACKFIRE,       //backfire or not
       "kee",          //damage type: "both", "kee"/"qi", "sen"/"shen"
       msg_init,
       msg_success,
       msg_fail,
       msg_backfire_init,
       msg_backfire_success);
  me->start_busy(1+random(2));
  return 1;
}