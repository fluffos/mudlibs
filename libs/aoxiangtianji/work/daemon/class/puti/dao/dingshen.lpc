#include <ansi.h>
#include <combat.h>
#define FU "「" HIG "定身法" NOR "」"
#define DINGSHEN CLASS_D("puti") + "/dao/dingshen"
#define CAUSED "no_move"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
  int t = time();

  if(userp(me) && (string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail(sprintf("%s是方寸山三星洞不传之密！\n",FU));
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("dao", 1) < 120)
    return notify_fail(sprintf("你的道法修为不够，难以施展%s。\n",FU));

  if( (int)me->query("max_mana") < 1200 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",FU));

  if( (int)me->query("force") < 100 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 120+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 300 )
    return notify_fail("你无法集中精力！\n");

  if ((t - (int)me->query_temp("last_dingshen")) < 5)
    return notify_fail("你刚刚施展过了，等会才可以继续用！\n");
  return 1;
}

int cast_attack(object me, object target)
{
  int success_adj, result, time, extra;
  int your_cps;
  string msg;

  success_adj = SKILL_D("dao")->query_power_effect(me);
  if( !target )
    target = offensive_target(me);
  if( !target
   || !target->is_character()
   || target->is_corpse()
   || target==me)
    return notify_fail(sprintf("你要对谁施%s？\n",FU));
  if(target->query_temp(CAUSED))
    return notify_fail(sprintf("%s已经呆若木鸡，无法迈步了！\n",target->name()));
  if(target->query_temp("in_qingwang"))
    return notify_fail(sprintf("%s已经无法自拔了！\n",target->name()));
  me->add("mana", -50-2*(int)me->query("mana_factor"));
  me->receive_damage("sen", 50);
  if( random(me->query("max_mana")) < 100 )
  {
    write("你法力忽然不济了，只怕要定住自己了！\n");
    return 1;
  }

  msg = HIC"$N" HIC"口中念了句咒文，朝" HIC"$n" HIC"一指，大喝一声：定！\n"NOR;
  message_vision(msg,me,target);

  your_cps = target->query_cps();

  success_adj -= random(your_cps/4);

  if (success_adj < 70)
    success_adj = 70;

  result = SPELL_D->attacking_cast_success(me,target,success_adj);
  if (result <=0)
  {
    msg =  HIW "结果" HIR"$n" HIW"被吓了一跳！\n" NOR;
    message_vision(msg,me,target);
    me->start_busy(2+random(3));
    return 1;
  }

  msg =  HIR"结果" HIR"$n" HIR"手足僵硬，果然动弹不得！\n" NOR;
  message_vision(msg,me,target);
  time = me->query_skill("dao",1);
  time = time/5 ;
  extra = random(time/2);
  if (extra > 20)
    extra = 20;
  if (time > 60)
    time = 60;
  target->set_curse_changed(DINGSHEN,CAUSED,"dexerity",time,extra);
  me->set_temp("last_dingshen",time());
  return 1;
}

void remove_effect(object me)
{
  if (objectp(me) && me->query_temp(CAUSED))
    tell_object(me,sprintf("你终于摆脱了%s的困扰了。\n",FU));
}