#include <ansi.h>
#include <combat.h>
#define FU "「" HIR "五雷咒" NOR "」"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail(sprintf("%s是方寸山三星洞不传之密！\n",FU));
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("dao", 1) < 120)
    return notify_fail(sprintf("你的道修为不够，难以施展%s。\n",FU));

  if( (int)me->query("max_mana") < 800 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",FU));

  if( (int)me->query("force") < 300 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 150+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 200 )
    return notify_fail("你无法集中精力！\n");

  return 1;
}

int cast_attack(object me, object target)
{
  int success_adj;
  int damage;
  string msg_init,msg_success,msg_fail,msg_backfire_init,msg_backfire_success;

  success_adj = SKILL_D("dao")->query_power_effect(me);
  success_adj += random(20);

  if( !target )
    target = offensive_target(me);
  if( !target
   || !target->is_character()
   || target->is_corpse()
   || target==me)
    return notify_fail(sprintf("你要对谁施展%s？\n",FU));
  me->add("mana", -50-2*(int)me->query("mana_factor"));
  me->receive_damage("sen", 50);
  if( random(me->query("max_mana")) < 100 )
  {
    write("你一着急竟然忘了咒语。\n");
    return 1;
  }

  msg_init = HIC "$N" HIC"口中念了句咒文，半空走出位尖头鹰鼻的雷公，左手执斧，"
             "右手提锥。斧锥相击，在" HIC"$n" HIC"的头顶炸起一片响雷！\n" NOR;
  msg_success = HIR "结果" HIR"$n" HIR"被雷声震得眼冒金星，心神不定，差点跌倒在地！\n" NOR ;
  msg_fail = HIC "谁知" HIC"$n" HIC"毫无反应，就象聋子似的。\n" NOR;
  msg_backfire_init = HIC "但是雷公被" HIC"$n" HIC"以法力一激，一个失神之下响雷都炸在了"
                      HIC"$N" HIC"的头顶！\n" NOR;
  msg_backfire_success = HIC "结果" HIC"$n" HIC"被雷声震得眼冒金星，心神不定，差点跌倒在地！\n" NOR;

  damage = SPELL_D->attacking_cast(
       me,             //attacker
       target,         //target
       success_adj,    //success adjustment
       BACKFIRE,       //backfire or not
       "kee",          //damage type: "both", "kee"/"qi", "sen"/"shen"
       msg_init,
       msg_success,
       msg_fail,
       msg_backfire_init,
       msg_backfire_success);
  me->start_busy(1+random(2));
  return 1;
}

