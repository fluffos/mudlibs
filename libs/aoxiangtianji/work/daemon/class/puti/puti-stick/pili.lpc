#include <ansi.h>
#include <combat.h>
#define PILI "「" HIR "霹雳三打" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail(PILI"是方寸山三星洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("puti-stick", 1) < 80)
    return notify_fail("你的菩提杖修为不够，难以施展" PILI "。\n");
  if (me->query_skill_mapped("stick") != "puti-stick")
    return notify_fail("你没有激发菩提杖，难以施展" PILI "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" PILI "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "stick")
    return notify_fail("你使用的武器不对，难以施展" PILI "。\n");
  msg = HIY "$N"HIY"一个高跳跃至半空，手中" + weapon->name()
          + "霹雳间连攻三招，正是方寸山绝技" + PILI + HIY"，棒影重重砸往$n！\n" NOR;

  message_combatd(msg, me, target);
  me->set_temp("PTS_perform",4);
  COMBAT_D->do_attack(me, target, weapon,3);
  me->add("force",-30);
  me->set_temp("PTS_perform",6);
  if (!target->is_busy() && (random(3)==0))
    target->start_busy(1);
  COMBAT_D->do_attack(me, target, weapon,3);
  me->add("force",-30);
  me->set_temp("PTS_perform",7);
  if (!target->is_busy() && (random(3)==0))
    target->start_busy(1);
  COMBAT_D->do_attack(me, target, weapon,3);
  me->add("force",-30);
  me->delete_temp("PTS_perform");
  me->start_busy(1+random(2));
  return 1;
}