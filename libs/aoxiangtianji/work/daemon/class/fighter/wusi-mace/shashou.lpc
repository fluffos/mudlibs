#include <ansi.h>
#include <combat.h>
#define SHA "「" HIR "撒手锏" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "将军府")
    return notify_fail(SHA"是将军府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("wusi-mace", 1) < 80)
    return notify_fail("你的无私锏修为不够，难以施展" SHA "。\n");
  if (me->query_skill_mapped("mace") != "wusi-mace")
    return notify_fail("你没有激发夺无私锏，难以施展" SHA "。\n");
  if (me->query("force") < 120)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap, dp;
  int damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "mace")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = HIR "$N" HIR "运内力于双锏，左手中" + weapon->name() +
        HIR "需晃了两晃，右手的" + weapon->name() +
            "突的化为一道罡气，穿透那片锏影，直贯$n" HIR "而去！\n" NOR;
  damage = me->query_skill("wusi-mace",1);
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"mace");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);

  if (COMBAT_D->perform_success(me, target,ap,dp,105))
  {
    damage = me->query_skill("mace");
    damage += random(me->query_skill("force")+1);
    damage = damage/2 + random(damage);
    me->add("force", -50);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 50,
                               HIR "只听$n" HIR "一声闷叫，$N" HIR +
                               weapon->name() + HIR "正撞在$n前胸" HIR
                               "。$n哪里还能坚持，“哇”的吐出了一大口鲜血！\n"
                               NOR);
  }

  else
  {
    me->add("force", -30);
    msg += CYN "$n" CYN "见势不妙，不敢轻易抵"
               "挡，连忙一个“铁板桥”后仰，躲闪开来。\n" NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}