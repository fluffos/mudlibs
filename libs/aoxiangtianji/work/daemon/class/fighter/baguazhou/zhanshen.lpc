#include <ansi.h>
#include <combat.h>
#define FU "「" HIR "战神一笑" NOR "」"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
//  if(userp(me) && (string)me->query("family/family_name") != "将军府")
//    return notify_fail(sprintf("%s是将军府不传之密！\n",FU));
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("baguazhou", 1) < 120)
    return notify_fail(sprintf("你的八卦咒修为不够，难以施展%s。\n",FU));

  if( (int)me->query("max_mana") < 800 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",FU));

  if( (int)me->query("force") < 100 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 125+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 100 )
    return notify_fail("你无法集中精力！\n");

  return 1;
}

int cast_attack(object me, object target)
{
   string msg;
   int result;
   int damage,num;
   if( !target ) target = offensive_target(me);
   if( !target
   ||   !target->is_character()
   ||   target->is_corpse()
   ||   target==me)
     return notify_fail("你要对谁施「剑神」？\n");
   me->add("mana", -125-(int)me->query("mana_factor"));
   me->add("force", -100);
   me->receive_damage("sen", 10);
   if( random(me->query("max_mana")) < 50 )
   {
     write("这一次好象不灵。\n");
     return 1;
   }

   msg = HIC"$N" HIC"长啸一身，“战神助我！”，远处隐隐传来号角之声！\n眨眼间，"
            "成千上万的箭孥如狂风席卷而来，直奔$n！\n" NOR;

   message_vision(msg, me, target);
   result = SPELL_D->attacking_cast_success(me,target,100);

   if (result < 0)
   {
     msg = HIY"$n" HIY"冷冷一笑，咬破舌尖，向空中喷出点点鲜血，"
              "右手空中一点，喝声“疾”！\n\n"NOR;
     msg += HIY"天地间宁静了，原来不过是$N设置的虚幻而已！\n"NOR;
     message_vision(msg,me,target);
     me->start_busy(2 + random(3));
     return 1+random(5);
   }
   else if (result == 0)
     num = 80;
   else
     num = 110;

   msg = HIR"$n" HIR"无从躲避，结果身中数箭，被攒射得象个刺猬一般！\n"NOR;
   damage = SPELL_D->apply_damage(
            me,
            target,
            "kee",
            msg,
            num,
            NO_BACKFIRE);

   me->start_busy(1+random(3));
   return 1+random(5);
}

