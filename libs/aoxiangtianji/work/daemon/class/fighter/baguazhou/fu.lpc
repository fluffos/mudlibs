#include <ansi.h>
#include <combat.h>
#define FU "「" HIR "天师符法" NOR "」"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "将军府")
    return notify_fail(sprintf("%s是将军府不传之密！\n",FU));
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("baguazhou", 1) < 100)
    return notify_fail(sprintf("你的八卦咒修为不够，难以施展%s。\n",FU));

  if( (int)me->query("max_mana") < 500 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",FU));

  if( (int)me->query("force") < 100 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 100+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 100 )
    return notify_fail("你无法集中精力！\n");

  return 1;
}

int cast_attack(object me, object target)
{
  int success_adj;
  int damage;
  string msg_init,msg_success,msg_fail,msg_backfire_init,msg_backfire_success;

  success_adj = SKILL_D("baguazhou")->query_power_effect(me);
  if( !target )
    target = offensive_target(me);
  if( !target
   || !target->is_character()
   || target->is_corpse()
   || target==me)
    return notify_fail("你要对谁施天师符法？\n");
  me->add("mana", -25-2*(int)me->query("mana_factor"));
  me->receive_damage("sen", 50);
  if( random(me->query("max_mana")) < 50 )
  {
    write("你一着急竟然忘了咒语。\n");
    return 1;
  }

  msg_init = HIC "$N" HIC"一脸肃杀之气，抬手仍出一张天师符「呼」地一下"
             "飞到半空，射向$n！\n" NOR;
  msg_success = HIR "$n" HIR"被光影罩住，波的喷出一口鲜血！\n" NOR;
  msg_fail = YEL"结果" YEL"$n" YEL"灵机一动躲了过去。\n" NOR;
  msg_backfire_init = HIC"但是" HIC"$n" HIC"伸指一弹，红光一暗，天师符反向"
                      HIC"$N" HIC"贴去！\n" NOR;
  msg_backfire_success = HIR "结果$n措手不及，波的喷了口鲜血！\n" NOR;

  damage = SPELL_D->attacking_cast(
       me,             //attacker
       target,         //target
       success_adj,    //success adjustment
       BACKFIRE,       //backfire or not
       "kee",          //damage type: "both", "kee"/"qi", "sen"/"shen"
       msg_init,
       msg_success,
       msg_fail,
       msg_backfire_init,
       msg_backfire_success);
  me->start_busy(1+random(2));
  return 3+random(5);
}