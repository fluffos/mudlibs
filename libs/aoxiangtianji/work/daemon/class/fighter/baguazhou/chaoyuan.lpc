#include <ansi.h>
#include <combat.h>
#define CHAO "「" HIR "五气朝元" NOR "」"
inherit F_CLEAN_UP;
int is_not_attack()
{ return 1;}

int valid_cast(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "将军府")
    return notify_fail(CHAO "是将军府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("baguazhou", 1) < 80)
    return notify_fail("你的八卦咒修为不够，难以施展" CHAO "。\n");

  if( (int)me->query("force") < 100 )
    return notify_fail("你的真气不够。\n");
  if( (int)me->query("mana") < 100 )
    return notify_fail("你的法力不够。\n");

  if (me->query("eff_kee") >= me->query("max_kee")
    && me->query("eff_sen") >= me->query("max_sen") )
    return notify_fail("你并没有受伤，不需要治疗！\n");
  return 1;
}

int cast(object me, object target)
{
  int mymana, myforce, cure, cost;

  message_vision(HIG"$N" HIG"化五行之气为己用，精气神立刻为之一振。\n" NOR,me);
  mymana = (int)me->query("mana");
  myforce = (int)me->query("force");

  cure = (int)me->query_skill("spells")/5;
  cure = random(cure);
  cost = 10 + random(cure + 1);

  if (mymana < 100 + cost*3)
  {
    write("你的法力不够。\n");
    return 1;
  }

  if (myforce < 100 + cost*2)
  {
    write("你的内力不够。\n");
    return 1;
  }

  if (me->is_fighting())
  {
    cure *= 2 ;
    cost *= 3 ;
    me->start_busy(1+random(3));
  }

  else
    me->start_busy(1+random(2));
  me->receive_curing("kee", 10 + cure );
  me->receive_curing("sen", 10 + cure );
  me->add("force", -(cost+10)/2);
  me->add("mana", -(cost+10));
  me->set("force_factor", 0);
  me->set("mana_factor", 0);
  return 1;
}

