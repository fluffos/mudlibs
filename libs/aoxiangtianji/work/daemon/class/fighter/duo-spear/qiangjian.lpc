#include <ansi.h>
#include <combat.h>
#define SHA "「" HIR "枪中夹锏" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "将军府")
    return notify_fail(SHA"是将军府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够！\n");
  if((int)me->query("force") < 300 )
    return notify_fail("你的内力不足！\n");
  if((int)me->query("sen") < 100)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if((int)me->query_skill("duo-spear",1) < 100)
    return notify_fail("你的夺命枪级别还不够，使用这一招会有困难!\n");
  if((int)me->query_skill("wusi-mace",1) < 100)
    return notify_fail("你的无私锏级别还不够，使用这一招会有困难!\n");
  return 1;
}

int perform(object me, object target)
{
  int extra,damage;
  object weapon1, weapon2;
  string msg;
  weapon1 = me->query_temp("weapon");
  weapon2 = present("mace", me);

  if (! objectp(weapon1) ||
      (string)weapon1->query("skill_type") != "spear")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");

  if(!objectp(weapon2))
    return notify_fail("没锏怎么枪里加锏?\n");
  msg = HIC"\n$N手中"+HIR+weapon1->name()+NOR+HIC"“扑楞扑楞”抖了几抖，突的单交右手，挂着破空之声直刺$n！\n"NOR;
  message_combatd(msg, me, target);

  extra = me->query_skill("force")/8;
  me->add_temp("apply/attack",extra);

  damage = COMBAT_D->do_attack(me, target, weapon1);
  if (damage < 1)
    damage = COMBAT_D->do_attack(me, target, weapon1,1);
  else
    COMBAT_D->do_attack(me, target, weapon1);
  if (damage > 5)
    msg = HIR"$N一枪中的，趁势抽出随身的"+HIY+weapon2->name()+NOR+HIR"，左手扬锏直砸而下！\n"NOR;
  else
    msg = HIC"\n趁着$n正忙于躲避招架，$N抽出"+weapon2->query("name")+"，左手扬锏直砸而下！"NOR;
  message_combatd(msg, me, target);
  me->delete_temp("weapon");
  me->set_temp("weapon",weapon2);
  me->reset_action();

  if (living(target) && !target->is_busy())
    target->start_busy(2);
  me->set_temp("ignore_dis",1);

  damage = 0;
  damage = COMBAT_D->do_attack(me, target, weapon2);
  if (damage < 1)
    damage = COMBAT_D->do_attack(me, target, weapon2);
  else
    COMBAT_D->do_attack(me, target, weapon2,1);

  me->delete_temp("weapon");
  me->set_temp("weapon",weapon1);
  me->reset_action();
  me->delete_temp("ignore_dis");

  me->add_temp("apply/attack",-extra);
  me->receive_damage("sen", 50);
  me->add("force", -80);
  me->start_busy(1+random(3));
  return 1;
}