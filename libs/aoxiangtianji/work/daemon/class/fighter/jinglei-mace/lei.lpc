#include <ansi.h>
#include <combat.h>
#define SHA "「" HIR "雷殛怒火" NOR "」"
inherit F_SSERVER;
int perform2(object me, object target);
int perform3(object me, object target);
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "将军府")
    return notify_fail(SHA"是将军府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if (me->query_skill("jinglei-mace", 1) < 180)
    return notify_fail("你的惊雷鞭修为不够，难以施展" SHA "。\n");
  if (me->query_skill_mapped("mace") != "jinglei-mace")
    return notify_fail("你没有激发夺惊雷鞭，难以施展" SHA "。\n");
  if (me->query("force") < 1200)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "mace")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = HIC"$N招式一缓，手中"+weapon->name()+HIC"仿佛挽了千斤似的，使出了惊雷鞭法"
           "的绝学："+SHA+HIC"！\n\n" NOR;

  msg += CYN"$N气运丹田，平平砸出一锏，慢，却嘶嘶作风雷之声。\n"NOR;
  msg += CYN"这一招『雷霆博击』挟着内力，却象密云乍现，惊雷含劲欲发！\n\n"NOR;

  if (COMBAT_D->perform_success(me, target,"force","force",120))
  {
    damage = (int)me->query_skill("force");
    damage += (int)me->query("max_force")/20;
    damage = damage/2 + random(damage);
    me->add("force", -50);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 50,
                               HIC"$n只觉得一股劲气象闪电一般，穿体而过！"
                               "“哇”的一声，$p喷出一大口鲜血！\n\n"
                               NOR);
  }

  else
  {
    me->add("force", -30);
    msg += HIC"$n忙运功向抗，深厚的内力将$N的攻势都激散了。\n\n"NOR;
  }

  message_combatd(msg, me, target);
  if (!target->is_busy())
    target->start_busy(1);
  call_out("perform2",1,me,target);
  return 1;
}

int perform2(object me, object target)
{
  object weapon;
  string msg, wn;
  int ap, dp;
  int damage;

  if (!objectp(me) || !objectp(target))
    return 0;

  if (!living(me))
    return 0;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "mace")
  {
    tell_object(me,sprintf("你换了兵器，%s的攻势瓦解了！\n",SHA));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",SHA),me);
    return 0;
  }

  if ((int)me->query("force") < 200)
  {
    tell_object(me,sprintf("你的内力不足，%s的攻势瓦解了！\n",SHA));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",SHA),me);
    return 0;
  }

  if (me->query_skill_mapped("mace") != "jinglei-mace")
  {
    tell_object(me,sprintf("你改用了别的锏法，%s的攻势瓦解了！\n",SHA));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",SHA),me);
    return 0;
  }

  if (me->query_skill_mapped("force")!="lengquan-force")
  {
    tell_object(me,sprintf("你改用了别的内功，%s的攻势瓦解了！\n",SHA));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",SHA),me);
    return 0;
  }

  wn = weapon->name();
  if (!living(target) || (environment(me) != environment(target)))
  {
    message_vision("$N眼见$n已经倒地不起，缓缓收回了攻势！\n",me,target);
    me->start_busy(1+random(2));
    return 0;
  }

  msg = CYN"$N由静转动，一动便急如风，脚踏奇门，锏走奇招，锏锏从$n意想不到的方位无声"
           "无息地砸出！\n" NOR;
  msg += CYN"这一招『天雷荡邪』好似天公作怒，要把天下妖孽尽数劈死，使得个痛快淋漓\n\n" NOR;
  damage = (int)me->query_skill("mace");
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"mace");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp,110))
  {
    damage = (int)me->query_skill("mace");
    damage += random((int)me->query_skill("force",1) + 1);
    damage = damage/2 + random(damage);
    me->add("force", -80);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 60,
                      HIC"$n马上手忙脚乱，不知该如何去招架这静若水、快如电的锏法！"
                     "\n果不然，$N的"+weapon->name()+HIC"招招命中，$n浑身上下被"
                     "砸的遍体鳞伤！\n\n"NOR);
  }

  else
  {
    me->add("force", -30);
    msg += HIC"$n却心静如水，丝毫不显慌乱，见招拆招，瓦解了$N这无声的攻势。\n\n"NOR;
  }
  message_combatd(msg, me, target);

  if (!target->is_busy())
    target->start_busy(1);
  call_out("perform3",1,me,target);
  return 1;
}

int perform3(object me, object target)
{
  object weapon;
  string msg, wn;
  int ap, dp;
  int damage;

  if (!objectp(me)
     || !environment(me)
     || !objectp(target)
     || !environment(target))
    return 0;

  if (!living(me))
    return 0;
  if (!living(target) || (environment(me) != environment(target)))
  {
    message_vision("$N眼见$n已经倒地不起，缓缓收回了攻势！\n",me,target);
    me->start_busy(1+random(2));
    return 0;
  }

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "mace")
  {
    tell_object(me,sprintf("你换了兵器，%s的攻势瓦解了！\n",SHA));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",SHA),me);
    return 0;
  }

  if ((int)me->query("force") < 200)
  {
    tell_object(me,sprintf("你的内力不足，%s的攻势瓦解了！\n",SHA));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",SHA),me);
    return 0;
  }

  if (me->query_skill_mapped("mace") != "jinglei-mace")
  {
    tell_object(me,sprintf("你改用了别的锏法，%s的攻势瓦解了！\n",SHA));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",SHA),me);
    return 0;
  }

  if (me->query_skill_mapped("force")!="lengquan-force")
  {
    tell_object(me,sprintf("你改用了别的内功，%s的攻势瓦解了！\n",SHA));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n",SHA),me);
    return 0;
  }

  wn = weapon->name();
  msg = CYN"$N突然收住身形，回步而立，撤锏于背后，无招胜有招，无形胜有形。\n"NOR;
  msg += CYN"这一招『雷殛怒火』把惊雷鞭法的精髓要旨发挥地酣畅爽快！\n\n"NOR;
  message_combatd(msg, me, target);
  damage = (int)me->query_skill("jinglei-mace",1);
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"mace");
  dp = COMBACC_D->math_pp(me,target,-damage,0);
  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
    damage = (int)me->query_skill("mace");
    damage = random((int)me->query_skill("force",1)+1);
    damage = damage/2 + random(damage);
    me->add("force", -100);
    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 70,
                        HIC"$n果然上当，以为$N露出破绽，大喜之下，急忙上前想抢攻。"
                        "\n$N微微一笑，待$n靠近，长袖一抖，袖尽锏出，直探$n的胸口。"
                        "\n$n连锏影还没看到，就差点儿被穿的透心凉！\n\n"NOR);
  }

  else
  {
    me->add("force", -30);
    msg = HIC"$n看破了这招的虚实，将计就计，假装冲上前，却在$N出锏的一瞬间腾空跃开！\n\n"NOR;
    return 1;
  }

  message_combatd(msg, me, target);
  me->start_busy(2+random(2));
  return 1;
}