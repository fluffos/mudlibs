#include <ansi.h>
#include <combat.h>
#define ZHAN "「" HIW "双手翅展" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "将军府")
    return notify_fail(ZHAN "是将军府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("changquan", 1) < 100)
    return notify_fail("你的长拳修为不够，难以施展" ZHAN "。\n");
  if (me->query_skill_mapped("unarmed") != "changquan")
    return notify_fail("你没有激发长拳，难以施展" ZHAN "。\n");
  if (me->query("force") < 300)
    return notify_fail("你的真气不够，难以施展" ZHAN "。\n");
  return 1;
}

int perform(object me, object target)
{
  int damage;
  string msg;
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail(ZHAN "只能空手施展。\n");
  msg = HIW "$N" HIW "双臂舒张，掌缘微微颤动，身形一展，已移至$n"
        HIW "跟前，双掌交叉奋力劈下，正是\n长拳「双手翅展」"
       "绝技，空气中顿时爆响出一阵尖锐的破空声。\n" NOR;
  me->add("force", -50);
  if (COMBAT_D->perform_success(me, target,
                                ({"unarmed","force"}),
                                ({"force","parry"}),
                                110))
  {
    damage = me->query_skill("unarmed");
    damage += me->query_skill("force")/2;
    damage = damage/2 + random(damage);
    me->add("force", -50);
    msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 30,
                       HIR "$n" HIR "躲闪不得，只能硬挡下双掌"
                       "，顿时被$P" HIR "双掌砍中双肩两侧，吐"
                       "血不止！\n" NOR);
  }

  else
  {
    msg += CYN "可是$p" CYN "奋力招架，终于将$P"
           CYN "这双掌架开，没有受到任何伤害。\n"NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

