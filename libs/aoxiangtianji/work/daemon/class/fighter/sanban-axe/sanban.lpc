#include <ansi.h>
#include <combat.h>
#define SHA "「" HIR "无敌三板斧" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "将军府")
    return notify_fail(SHA"是将军府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("sanban-axe", 1) < 150)
    return notify_fail("你的三板斧修为不够，难以施展" SHA "。\n");
  if (me->query_skill_mapped("axe") != "sanban-axe")
    return notify_fail("你没有激发三板斧，难以施展" SHA "。\n");
  if (me->query("force") < 300)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap,dp,damage;

  string *hitone = ({
    HIM"$n试图侧身避开，但为时已晚。大斧劈在肩上，留下一道深可见骨的伤口！\n"NOR,
    HIR"$n高举手中兵刃试图架开，但挡不住$N的来势，被震得吐出一口鲜血！\n"NOR,
    RED"$n以攻为守，但去势不够凌厉。虽逼得$N回斧自护，但还是在$n肩膀带出一道伤口。\n"NOR,
  });
  string *missone = ({
    HIC"$n轻轻一闪，大斧带着一阵劲风从身边斩下，但没伤到$n分毫。\n"NOR,
    HIB"$n高举手中兵刃奋力一架，只听「当」的一声巨响，$N巨斧已被弹开！\n"NOR,
    HIG"$n不顾大斧来势，反而向$N疾攻，逼得$N不得不回斧自保，这一势「开瓜」就此落空。\n"NOR,
  });
  string *hittwo = ({
    HIR"$n似乎没有觉出危险，顺手一挡。待到发觉来势之疾，为时已晚。脸上已多了一条数寸长的伤口！\n"NOR,
    HIR"$n没想道$N攻势如此之快，急忙低头闪避，但无法躲开，被刀刃划得皮开肉绽！\n"NOR,
    RED"$n攻势已然发出，来不及回防，脸上被割掉一片皮，显然伤得不轻！\n"NOR,
  });
  string *misstwo = ({
    HIB"$n脑袋微微一侧，避过了$N的攻势。\n"NOR,
    HIC"$n似乎早已料到这一招，顺势在斧杆上一推，避了开去。\n"NOR,
    HIG"眼看这招要把$n脑袋戳个对穿，突然间$n使个铁板桥，护手刀落了个空。\n"NOR,
  });
  string *hitthree = ({
    HIR"$n似乎已被这三斧连环的威势吓破了胆，懒懒散散地一歪，被大斧横劈在肩头。\n"NOR,
    HIM"$n看准来势，以手中兵器架去，但已力不从心，被斧头震得虎口出血，显然内伤不轻！\n"NOR,
    RED"$n眼见来势凌厉，企图低头避过，但不料大斧随着下劈，从$n背上割下一大片皮肉！\n"NOR,
  });
  string *missthree = ({
    HIC"$n似乎早已熟知大斧来路，斧未到，人已先轻飘飘地避开了。\n"NOR,
    HIB"$n眼见躲不过来招，急忙在地上一滚。虽然避得狼狈，但丝毫没有受伤。\n"NOR,
    HIG"$n不顾自身危险，中宫直进，向$N攻去，果然将来招化解了。\n"NOR,
  });
  string *hit = ({
    HIY"$N道：也叫你尝尝这无敌三板斧的厉害！\n"NOR,
    HIW"这无敌三板斧一气呵成，$n被攻了个措手不及，伤势甚为可怕！\n"NOR,
    HIM"$N狂笑道：就凭你这点本事，也来跟我斗？\n"NOR,
  });
  string *miss = ({
    BLU"$n哈哈大笑道：我听说这无敌三板斧有多少威力，现在一看，也不过如此嘛！\n"NOR,
    BLU"$n长笑一声，对$N不屑地说道：就这点本事，我还没放在眼里！\n"NOR,
    BLU"$n仰天大笑道：还有什么本事，尽管拿出来吧！\n"NOR,
  });
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "axe")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = CYN "$N一声暴喝：开瓜！剔牙！掏耳朵！三招一气呵成！\n\n只见一道青影"
            "划过，大斧直劈$n顶门！\n" NOR;
  damage = me->query_skill("axe");
  damage = random(damage/10) + 1;
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"axe");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);

  damage = 0;
  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
    damage = me->query_str();
    damage += me->query_skill("axe");
    damage = damage/2 + random(damage);
    me->add("force", -80);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                               element_of(hitone));
  }

  else
  {
    me->add("force", -30);
    msg += element_of(missone);
  }

  if (!living(target) || (environment(me) != environment(target)))
  {
    msg += element_of(hit);
    message_combatd(msg, me, target);
    me->start_busy(1+random(3));
    return 1;
  }

  message_combatd(msg, me, target);

  damage = me->query_skill("axe");
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"axe");
  dp = COMBACC_D->math_pp(me,target,-damage,0);
  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
    damage = me->query_str();
    damage += me->query_skill("axe");
    damage = damage/2 + random(damage);
    me->add("force", -80);
    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                               element_of(hittwo));
  }

  else
  {
    me->add("force", -30);
    msg = element_of(misstwo);
  }

  if (!living(target) || (environment(me) != environment(target)))
  {
    msg += element_of(hit);
    message_combatd(msg, me, target);
    me->start_busy(1+random(3));
    return 1;
  }

  message_combatd(msg, me, target);
  damage = me->query_skill("axe");
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"axe");
  dp = COMBACC_D->math_pp(me,target,-damage,0);
  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
    damage = me->query_str();
    damage += me->query_skill("axe");
    damage = damage/2 + random(damage);
    me->add("force", -80);
    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 50,
                               element_of(hitthree));
  }

  else
  {
    me->add("force", -30);
    msg = element_of(missthree);
  }

  if (!living(target) || (environment(me) != environment(target)))
    msg += element_of(hit);
  if (!damage)
    msg += element_of(miss);

  message_combatd(msg, me, target);
  me->start_busy(2+random(3));
  return 1;
}