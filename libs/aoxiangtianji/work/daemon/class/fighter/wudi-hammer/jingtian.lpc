#include <ansi.h>
#include <combat.h>
#define SHA "「" HIR "惊天一锤" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && !wizardp(me) && (string)me->query("family/family_name") != "将军府")
    return notify_fail(SHA"是将军府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("wudi-hammer", 1) < 180)
    return notify_fail("你的无敌锤修为不够，难以施展" SHA "。\n");
  if (me->query_skill_mapped("hammer") != "wudi-hammer")
    return notify_fail("你没有激发无敌锤，难以施展" SHA "。\n");
  if (me->query("force") < 800)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap,dp,damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "hammer")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = HIY"$N" HIY"双足一蹬，跃至半空，身形突然倒转而下，有如流星下坠，"
        "其快绝伦，掌中"NOR + weapon->name() + HIY + ",乌光黝黝，直击$n。\n"NOR;
  msg += HIR"又有如天庭雷神，自天飞击，其威力之猛，来势之强，当真不愧有"
         "[惊天]之名!\n\n"NOR;
  message_combatd(msg, me, target);

  damage = (int)me->query_skill("hammer");
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"hammer");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  damage = 0;
  if (COMBAT_D->perform_success(me, target,ap,dp,120))
  {
    damage = (int)me->query_skill("hammer");
    damage += (int)me->query_skill("force")/2;
    damage = damage/2 + random(damage);
    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 80,
          HIR "只听$n" HIR "一声惨叫，如同断线风筝般的飞了出去，一口鲜血喷到空中！\n"
          "$N" HIR + weapon->name() + HIR "未至其威势已经把$n砸如烂泥一般了。\n"NOR);
  }

  else
  {
     msg = HIY"那知$n不等$N身子落下，也已飞身而起！\n\n";
     msg += "刹那间但见一条身影冲天直上，一道乌光，直击而下。\n";
     msg += "两人凌空拆了一招，身形一聚突分，有如两片落叶般，飘飘落了下来!"NOR;
  }

  message_combatd(msg, me, target);

  if (damage > 0)
  {
    msg = HIW"$N“嘿嘿”冷笑，身形跃起跟进，手中大锤毫不客气的借势横扫，"
             "攻势之快，威势之猛，\n如狂飙，似风暴，卷起落叶，带动黄沙！\n"NOR;
  }

  else
    msg = HIC"$N竟然一击不中，$n却也为其气势所惊！$N并不停顿，手中大锤顺势横"
             "扫直砸，一副拼命的模样！\n"NOR;

  if (!living(target) || (environment(me) != environment(target)))
  {
    msg += HIB"然而$n已经倒地不起，人事不知了！$N也乘机收住如轮的攻势，慢慢调匀内息！\n"NOR;
    message_combatd(msg, me, target);
    me->start_busy(1+random(3));
    return 1;
  }

  message_combatd(msg, me, target);
  target->start_busy(1+random(2));
  me->set_temp("WDH_perform",4);
  ap = (int)me->query_skill("wudi-hammer",1);
  ap = ap/10 + random(ap/10);
  me->add_temp("apply/attack",ap);
  COMBAT_D->do_attack(me, target, weapon);
  COMBAT_D->do_attack(me, target, weapon);
  if (damage > 0 && living(target))
  {
    me->set_temp("WDH_perform",5);
    if ((random(3) == 0) && (!target->is_busy()))
      target->start_busy(1+random(2));
    COMBAT_D->do_attack(me, target, weapon);
  }

  me->add_temp("apply/attack",-ap);
  me->delete_temp("WDH_perform");
  me->start_busy(1+random(3));
  return 1;
}