#include <ansi.h>
#include <combat.h>
#define SHA "「" HIR "铁骑铮铮" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "将军府")
    return notify_fail(SHA"是将军府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("bawang-spear", 1) < 180)
    return notify_fail("你的霸王枪法修为不够，难以施展" SHA "。\n");
  if (me->query_skill_mapped("spear") != "bawang-spear")
    return notify_fail("你没有激发霸王枪法，难以施展" SHA "。\n");
  if (me->query("force") < 300)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");

  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i,j,k,skill,damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "spear")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = HIR "$N" HIR "满面杀气，手中" + weapon->name() + HIR"一下子完全摆了开来，"
       + "迅如闪电，枪势如万马奔腾，这蹄声如雷，震动大地，卷起黄沙如云！\n" NOR;
  message_combatd(msg, me, target);

  j = me->query_temp("apply/attack");
  k = me->query_temp("apply/damage");
  damage = 0;
  skill = me->query_skill("bawang-spear",1)/5;
  for (i=1;i<=6;i++)
  {
    if (!living(target) || (environment(me) != environment(target)))
      break;
    me->set_temp("BWS_perform",i);
    me->add_temp("apply/attack", i*30);
    if ((random(2)) && (!target->is_busy()))
      target->start_busy(2);
    damage = COMBAT_D->do_attack(me, target, weapon);
    if (!damage)
      me->add_temp("apply/damage",skill);
    me->add("force", -10);
  }

  me->set_temp("apply/attack", j);
  me->set_temp("apply/damage", k);
  me->delete_temp("BWS_perform");
  if (i >= 4)
  {
    msg = HIY"$N缓缓收枪，大地宁静了很多！\n";
    if (living(target))
      msg += HIW"$n奋力挡住了$N的这轮攻势，顿时觉得压力减小了很多，乘机发动反击！\n"NOR;
  }

  else
  {
    msg = HIY"$N一枪挑了$n，收住 " + weapon->name() + "，不禁呵呵冷笑！\n"NOR;
    msg += HIW"天地间那万马奔腾的铮铮之声，渐远渐去，宁静了许多！\n"NOR;
  }
  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  me->set_temp("last_pfm_tieji",time());
  return 1;
}