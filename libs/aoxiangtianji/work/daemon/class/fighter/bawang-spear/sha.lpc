#include <ansi.h>
#include <combat.h>
#define SHA "「" HIR "破阵杀" NOR "」"
inherit F_SSERVER;
int is_not_attack() { return 0;	}

int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "将军府")
    return notify_fail(SHA"是将军府不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("bawang-spear", 1) < 150)
    return notify_fail("你的霸王枪法修为不够，难以施展" SHA "。\n");
  if (me->query_skill_mapped("spear") != "bawang-spear")
    return notify_fail("你没有激发霸王枪法，难以施展" SHA "。\n");
  if (me->query("force") < 300)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap, dp;
  int damage;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "spear")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = HIR "$N" HIR "仰天长啸，手中" + weapon->name() +
        HIR "舞动入出海的矫龙，整个枪身顿时腾起凛冽无比的"
            "杀气，直贯$n" HIR "而去！\n" NOR;

  damage = (int)me->query_skill("spear");
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  if (damage < 10)
    damage = 10;
  ap = COMBACC_D->math_ap(me,"spear");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp,120))
  {
    damage = me->query_skill("spear");
    damage = random(me->query_skill("force",1) + 1);
    damage = damage/2 +random(damage);
    me->add("force", -100);
    me->start_busy(1+random(3));
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 50,
                               HIR "只听$n" HIR "一声惨叫，$N" HIR +
                               weapon->name() + HIR "枪尖一闪，竟已嵌"
                               "入$p" HIR "体内尺许，带出一蓬血雨。\n"
                               NOR);
  }

  else
  {
    me->add("force", -100);
    me->start_busy(1+random(3));
    msg += CYN "$n" CYN "见$P" CYN "来势汹涌，不敢轻易抵"
               "挡，连忙飞身腾挪，躲闪开来。\n" NOR;
  }

  message_combatd(msg, me, target);
  return 1;
}