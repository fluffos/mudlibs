#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
#define HUO "「" HIR "佛光普照" NOR "」"
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "南海普陀山")
    return notify_fail(HUO"是南海普陀山不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("pudu-staff", 1) < 80)
    return notify_fail("你的普渡杖法修为不够，难以施展" HUO "。\n");
  if (me->query_skill("lotusforce", 1) < 80)
    return notify_fail("你的莲花心法修为不够，难以施展" HUO "。\n");
  if (me->query_skill_mapped("staff") != "pudu-staff")
    return notify_fail("你没有激发普渡杖法，难以施展" HUO "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" HUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "staff")
    return notify_fail("你使用的武器不对。\n");
  msg = HIY "$N" HIY "纵声长笑，挥动手中的" + weapon->name() +
        HIY "，如泰山一般压向$n" + HIY "，令人叹为观止！\n" NOR;
  if (COMBAT_D->perform_success(me, target,
                                ({(int)me->query_skill("staff"),(int)me->query("max_mana")/10}),
                                ({(int)target->query_skill("force"),(int)target->query("max_mana")/15})))
  {
    damage = me->query_skill("staff");
    damage += random(me->query_skill("spells") + 1);
    damage = damage/3 + random(damage/2);
    me->add("force", -120);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                    HIR "只见$p" HIR "闷哼一声，连叫都叫"
                        "不出来，身子飞跌出去，重重的摔倒在地上！\n" NOR);
  }

  else
  {
    me->add("force", -50);
    msg += CYN "可是$p" CYN "运足内力，奋力挡住了"
           CYN "$P" CYN "这惊天动地的一击！\n"NOR;
  }

  me->start_busy(1+random(3));
  message_combatd(msg, me, target);
  return 1;
}