#include <ansi.h>
#include <combat.h>
#define HUO "「" HIR "刀影指" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "南海普陀山")
    return notify_fail(HUO"是南海普陀山不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("cibei-blade", 1) < 120)
    return notify_fail("你的慈悲刀法修为不够，难以施展" HUO "。\n");
  if (me->query_skill("jienan-zhi", 1) < 120)
    return notify_fail("你的劫难指修为不够，难以施展" HUO "。\n");
  if (me->query_skill("lotusforce", 1) < 100)
    return notify_fail("你的莲花心法修为不够，难以施展" HUO "。\n");
  if (me->query_skill_mapped("blade") != "cibei-blade")
    return notify_fail("你没有激发慈悲刀法，难以施展" HUO "。\n");
  if (me->query_skill_mapped("unarmed") != "jienan-zhi")
    return notify_fail("你没有激发劫难指，难以施展" HUO "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" HUO "。\n");
  if ((int)me->query("max_force") < 800)
    return notify_fail("你的内力修为不够，难以施展" HUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对，难以施展" HUO "。\n");
  msg = HIR"\n$N大吼一声使出“刀影指”，指随刀走，刀光中夹杂着阵阵指风一起奔向$n！\n"NOR;
  message_combatd(msg, me, target);
  me->add("force", -60);
  for (i = 1; i <=4 ; i++)
  {
    if (!living(target) || !me->is_fighting(target))
      break;
    if (random(2) && !target->is_busy())
      target->start_busy(2);
    COMBAT_D->do_attack(me, target, weapon, 0);
  }

  me->start_busy(1 + random(3));
  return 1;
}