#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
#define HUO "「" HIG "普渡众生" NOR "」"
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "南海普陀山")
    return notify_fail(HUO"是南海普陀山不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("lunhui-staff", 1) < 180)
    return notify_fail("你的轮回杖法修为不够，难以施展" HUO "。\n");
  if (me->query_skill("lotusforce", 1) < 180)
    return notify_fail("你的莲花心法修为不够，难以施展" HUO "。\n");
  if (me->query_skill_mapped("staff") != "lunhui-staff")
    return notify_fail("你没有激发轮回杖法，难以施展" HUO "。\n");
  if (me->query("force") < 1000)
    return notify_fail("你的真气不够，难以施展" HUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "staff")
    return notify_fail("你使用的武器不对，难以施展" HUO "。\n");
  msg = HIY"$N气沉丹田，犹如金刚浑身发金光，招转佛门正宗绝招「普渡众生」，"
        "向$n连续发动进攻！\n"NOR;
  message_combatd(msg, me, target);
  me->add("force", -100);
  for (i = 6; i <=9 ; i++)
  {
    if (!living(target) || !me->is_fighting(target))
      break;
    me->set_temp("LHS_perform",i);
    if (random(2) && !target->is_busy())
      target->start_busy(2);
    COMBAT_D->do_attack(me, target, weapon,0);
  }

  me->delete_temp("LHS_perform");
  me->start_busy(1 + random(3));
  return 1;
}