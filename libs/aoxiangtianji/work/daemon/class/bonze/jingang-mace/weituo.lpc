#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
#define HUO "「" HIR "韦坨一怒" NOR "」"
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "南海普陀山")
    return notify_fail(HUO"是南海普陀山不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("jingang-mace", 1) < 150)
    return notify_fail("你的金刚锏法修为不够，难以施展" HUO "。\n");
  if (me->query_skill("buddhism", 1) < 150)
    return notify_fail("你的大乘佛法修为不够，难以施展" HUO "。\n");
  if (me->query_skill_mapped("mace") != "jingang-mace")
    return notify_fail("你没有激发金刚锏法，难以施展" HUO "。\n");
  if (me->query("force") < 800)
    return notify_fail("你的真气不够，难以施展" HUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "mace")
    return notify_fail("你使用的武器不对。\n");
  msg = HIY "$N" HIY "喃喃的念动咒语，手中的" + weapon->name() +
        HIY "愈舞愈慢，却招招式式力道十足，层层压往$n" + HIY "！\n" NOR;
  if (COMBAT_D->perform_success(me, target,
                                ({(int)me->query_skill("mace"),(int)me->query("max_mana")/10}),
                                ({(int)target->query_skill("parry"),(int)target->query("max_mana")/15})))
  {
    damage = me->query_skill("mace");
    damage += random(me->query_skill("spells") + 1);
    damage = damage/3 + random(damage*4/5);
    me->add("force", -80);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                    HIR "只见$n" HIR "惊慌失措，根本无力招架。惨叫了一声，"
                        "身子飞跌出去，重重的摔倒在地上！\n" NOR);
  }

  else
  {
    me->add("force", -50);
    msg += CYN "可是$p" CYN "运足内力，身形灵巧转动，避开了"
           CYN "$P" CYN "这惊天动地的一击！\n"NOR;
  }

  message_combatd(msg, me, target);

  if (me->query_skill("mace") < 250 || !living(target) || !me->is_fighting(target))
  {
    me->start_busy(1+random(3));
    return 1;
  }

  msg = HIY "$N" HIY"一招击出后，后续杀招接连而来！手中铜锏挂着风声，连续往$n砸了过去！\n"NOR;
  message_combatd(msg, me, target);
  me->add("force",-50);
  me->set_temp("JGM_perform",4);
  COMBAT_D->do_attack(me, target, weapon,1);
  me->set_temp("JGM_perform",5);
  COMBAT_D->do_attack(me, target, weapon,1);
  me->delete_temp("JGM_perform");
  me->start_busy(1+random(3));
  return 1;
}

