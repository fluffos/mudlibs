#include <ansi.h>
#include <combat.h>
#define FIRE "「" HIY "金箍咒" NOR "」"
#define JGZ CLASS_D("bonze") + "/buddhism/jinguzhou"
#define CAUSED "jinguzhou"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
  int t = time();
  if(userp(me) && (string)me->query("family/family_name") != "南海普陀山")
    return notify_fail(sprintf("%s是南海普陀山不传之密！\n",FIRE));
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("buddhism", 1) < 200)
    return notify_fail(sprintf("你的大乘佛法修为不够，难以施展%s。\n",FIRE));

  if (me->query_skill_mapped("spells") != "buddhism")
    return notify_fail("你没有激发大乘佛法，念不了" FIRE "。\n");
  if( (int)me->query("max_mana") < 2500 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",FIRE));

  if( (int)me->query("force") < 1000 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 1000+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 100 )
    return notify_fail("你无法集中精力！\n");
  if (me->query_temp("tick/"+CAUSED))
    return notify_fail(sprintf("你正在使用%s。\n",FIRE));

  if ((t - me->query_temp("last_jgz")) < 5 )
    return notify_fail(sprintf("你刚刚念过了%s。\n",FIRE));
  return 1;
}

int cast_attack(object me, object target)
{
  int time;
  int result;
  if( !target ) target = offensive_target(me);
  if( !target
  ||      !target->is_character()
  ||      target->is_corpse()
  ||      target==me)
    return notify_fail(sprintf("你要对谁念%s？\n",FIRE));
  if( random(me->query("max_mana")) < 500 )
  {
     write("这次好象不大灵。\n");
     return 1;
  }

  time = (int)me->query_skill("buddhism",1) / 10;
  if ( time > 60 ) time = 60 ;

  message_vision(HIW"$N" HIW"口中念念有词，伸出右手手指指定" HIW"$n" HIW"，喝声，“疾”！\n"NOR,me,target);
  result = SPELL_D->attacking_cast_success(me,target,SKILL_D("buddhism")->query_power_effect(me));
  if (result <= 0)
  {
    message_vision(HIC"但是$N守定心神，不受影响！\n",target);
    me->start_busy(2+random(2));
    return 1;
  }

  message_vision(HIR"只见一道白光从" HIR"$N" HIR"手指射出，盘旋在" HIR"$n"
                 HIR"的头顶，慢慢的凝集成了一个光圈！\n这光圈受" HIR"$N"
                 HIR"驱使，竟直接套到了" HIR"$n" HIR"的头顶上！\n"NOR,me,target);
  me->set_pfm_tick(JGZ, CAUSED,time, target);
  me->set_temp("busy_for_cast",FIRE);
  return 1;
}

int check(object me, object target)
{
  int i, success_adj, damage;
  string msg_init, msg_success, msg_fail ;

  if (!living(me) || !environment(me))
  {
    me->delete_temp("busy_for_cast");
    return 0;
  }

  if( !objectp(target)
    || !environment(target)
    || !living(target)
    || environment(me) != environment(target))
  {
    me->delete_temp("busy_for_cast");
    return 0;
  }

  if (!me->is_fighting(target))
  {
    me->delete_temp("busy_for_cast");
    return 0;
  }

  if ( (string)me->query_skill_mapped("spells") != "buddhism" )
  {
    me->delete_temp("busy_for_cast");
    return 0;
  }

  if (me->query("mana") < 500)
  {
    me->delete_temp("busy_for_cast");
    return 0;
  }

  i = me->query_tick_use(CAUSED);
  if (!me->query_temp("busy_for_cast"))
    me->set_temp("busy_for_cast",FIRE);

  if (i%4 == 0)
  {
    success_adj = SKILL_D("buddhism")->query_power_effect(me);
    if (success_adj > 100)
      success_adj = 100 + random((success_adj - 100)/2 + 1);
    msg_init = HIB"$N" HIB"默默的念了几遍"NOR + FIRE + HIB"！\n"NOR;
    msg_success = HIR "把个" HIR"$n" HIR"痛得竖蜻蜓，翻筋斗，耳红面赤，眼胀身麻，不由得抓破了自己的头！\n" NOR;
    msg_fail = HIC"$n" HIB"不去理会" HIB"$N" HIB"的讥讥歪歪！\n"NOR;

    damage = SPELL_D->attacking_cast(
        me,
        target,
        success_adj,
        NO_BACKFIRE,
        "both",
        msg_init,
        msg_success,
        msg_fail,
        msg_init,
        msg_init);
    if (damage > 100)
    {
      if (!target->is_busy())
        target->start_busy(1+random(2));
      me->add("mana", -100);
    }

  }

  return 1;
}

void remove_effect(object me, object target)
{
  message_vision(HIW"$N收回法力，一道白光飞回手中！\n" NOR, me);
  me->set_temp("last_jgz",time());
  me->delete_temp("busy_for_cast");
  return;
}

