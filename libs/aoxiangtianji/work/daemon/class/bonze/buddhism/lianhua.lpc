#include <ansi.h>
#include <combat.h>
#define FU "「" HIR "莲花护体" NOR "」"
#define P_FILE "/daemon/class/bonze/buddhism/lianhua"
#define CAUSED "lianhua"
inherit F_SSERVER;
int is_not_attack()
{
  return 1;
}

int valid_cast(object me, object target)
{
  int t = time();
  if(userp(me) && (string)me->query("family/family_name") != "南海普陀山")
    return notify_fail(sprintf("%s是南海普陀山不传之密！\n",FU));
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("buddhism", 1) < 120)
    return notify_fail(sprintf("你的大乘佛法修为不够，难以施展%s。\n",FU));

  if( (int)me->query("max_mana") < 1100 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",FU));

  if( (int)me->query("force") < 300 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 150+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 100 )
    return notify_fail("你无法集中精力！\n");
  if(me->query_temp(CAUSED))
    return notify_fail("你已经在运功中了。\n");
  if ((t- me->query_temp("last_lianhua")) < 5)
    return notify_fail("你刚刚结束莲花护体的运用，需要等会才能继续使用！\n");
  if (me->query_condition("killer"))
    return notify_fail("你身上杀气正浓，无法使用佛法！\n");
  return 1;
}

int cast(object me, object target)
{
  int skill;
  int ratio;
  skill = me->query_skill("buddhism",1);

  if(objectp(target) && target != me )
    return notify_fail(sprintf("你只能用%s保护自己。\n",FU));
  me->add("mana", -150);

  message_vision(HIC"$N" HIC"微一凝神，背后幻出一朵白莲，五色毫光闪现。\n" NOR, me);
  ratio = SKILL_D("buddhism")->query_power_effect(me);
  if (ratio < 100)
    ratio = 100;
  if (skill > 400)
    skill = 400;
  skill = skill/2 + random(skill);
  me->set_bless_changed(P_FILE,CAUSED,"spell_apply",skill*ratio/200,skill*ratio/100);
  if( me->is_fighting() )
    me->start_busy(3);
  return 1;
}

void remove_effect(object me)
{
  if (objectp(me) && me->query_temp(CAUSED))
  {
    me->set_temp("last_lianhua", time() );
    tell_object(me, "你身后的白莲渐渐隐去了。\n");
  }

}