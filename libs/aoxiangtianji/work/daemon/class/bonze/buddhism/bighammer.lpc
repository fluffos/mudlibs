#include <ansi.h>
#include <combat.h>
#define FU "「" HIR "大力降魔杵" NOR "」"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "南海普陀山")
    return notify_fail(sprintf("%s是南海普陀山不传之密！\n",FU));
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("buddhism", 1) < 100)
    return notify_fail(sprintf("你的大乘佛法修为不够，难以施展%s。\n",FU));

  if( (int)me->query("max_mana") < 800 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",FU));

  if( (int)me->query("force") < 100 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 150+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 100 )
    return notify_fail("你无法集中精力！\n");

  return 1;
}

int cast_attack(object me, object target)
{
  int success_adj;
  int damage;
  string msg_init,msg_success,msg_fail,msg_backfire_init,msg_backfire_success;

  success_adj = SKILL_D("buddhism")->query_power_effect(me);

  if( !target )
    target = offensive_target(me);
  if( !target
   || !target->is_character()
   || target->is_corpse()
   || target==me)
    return notify_fail(sprintf("你要对谁施%s？\n",FU));
  me->add("mana", -50-2*(int)me->query("mana_factor"));
  me->receive_damage("sen", 50);
  if( random(me->query("max_mana")) < 200 )
  {
    write("你一着急竟然忘了咒语。\n");
    return 1;
  }

  if (me->query_condition("killer"))
    success_adj -= success_adj/3;

  msg_init = HIC "$N" HIC"口中念了几句咒文，半空中现出阿傩，迦叶二尊者，各人手执\n"
             "一根巨大无比的降魔杵，呼！地一声向" HIC"$n" HIC"当头砸下！\n" NOR;
  msg_success = HIR "结果砸个正着，差点没把" HIR"$n" HIR"砸扁！\n" NOR;
  msg_fail = HIW"但是" HIW"$n" HIW"在千钧一发之际躲了开来。\n" NOR;
  msg_backfire_init = HIC "但是降魔杵被" HIC"$n" HIC"以法力一引，反而砸到了$N的顶门！\n" NOR;
  msg_backfire_success = HIR "结果砸个正着，差点没把" HIR"$n" HIR"砸扁！\n" NOR;

  damage = SPELL_D->attacking_cast(
       me,             //attacker
       target,         //target
       success_adj,    //success adjustment
       BACKFIRE,       //backfire or not
       "both",         //damage type: "both", "kee"/"qi", "sen"/"shen"
       msg_init,
       msg_success,
       msg_fail,
       msg_backfire_init,
       msg_backfire_success);
  me->start_busy(1+random(3));
  return 1;
}