#include <ansi.h>
#include <combat.h>
#define HUO "「" HIR "佛祖捻花" NOR "」"

inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "南海普陀山")
    return notify_fail(HUO"是南海普陀山不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("jienan-zhi", 1) < 100)
    return notify_fail("你的劫难指修为不够，难以施展" HUO "。\n");
  if (me->query_skill("lotusforce", 1) < 100)
    return notify_fail("你的莲花心法修为不够，难以施展" HUO "。\n");
  if (me->query_skill("buddhism", 1) < 100)
    return notify_fail("你的大乘佛法修为不够，难以施展" HUO "。\n");
  if (me->query_skill_mapped("unarmed") != "jienan-zhi")
    return notify_fail("你没有激发劫难指，难以施展" HUO "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" HUO "。\n");
  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力修为不够，难以施展" HUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  string msg;
  int damage;
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail(HUO "只能空手使用。\n");

  msg = HIY "$N" HIY "面带微笑，双手在胸前打了个印结，突的飞身扑至$n"
        HIY "面前，\n随即伸手抓向$p" HIY "的要害！\n" NOR;
  if (COMBAT_D->perform_success(me, target, ({"force","unarmed"}), ({"parry","dodge"})))
  {
    me->add("force", -180);
    damage = (int)me->query_skill("force")/2 + (int)me->query_skill("unarmed");
    damage = damage / 3 + random(damage);
    msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 45,
                               HIR "$p" HIR "见来势凶猛，难以躲避，只好"
                               "勉强化解，\n谁知$P" HIR "的手好像长了眼睛"
                               "一般，扑哧一下正抓中$p" HIR "的要害，登"
                               "时鲜血飞溅！\n" NOR);
    me->start_busy(1+random(2));
  }

  else
  {
    msg += CYN "可是$p" CYN "的看破了$P" CYN
               "的招式，连消带打，全然化解了$P"
           CYN "的攻势。\n" NOR;
    me->add("force",-60);
    me->start_busy(1+random(3));
  }

  message_combatd(msg, me, target);
  return 1;
}

