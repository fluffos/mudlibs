#include <ansi.h>
#include <combat.h>
#define FEI "「" HIG "灵幻剑芒" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && me->query("family/family_name") != "五庄观")
    return notify_fail(FEI "是五庄观不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("xiaofeng-sword", 1) < 180)
    return notify_fail("你的晓风残月剑法修为不够，难以施展" FEI "。\n");
  if (me->query_skill("zhenyuan-force", 1) < 180)
    return notify_fail("你的镇元神功修为不够，难以施展" FEI "。\n");
  if (me->query_skill_mapped("sword") != "xiaofeng-sword")
    return notify_fail("你没有激发晓风残月剑法，难以施展" FEI "。\n");
  if (me->query_skill_mapped("force") != "zhenyuan-force")
    return notify_fail("你没有激发镇元神功，难以施展" FEI "。\n");
  if( (int)me->query("max_force") < 1800)
    return notify_fail("你的内力太弱,不能吐出剑芒!!\n");
  if ((int)me->query("force") < 800)
    return notify_fail("你的真气不够，难以施展" FEI "。\n");
  return 1;
}

int perform(object me, object target)
{
  string msg;
  int ap, dp, damage, extra;
  object weapon;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对，难以施展" FEI "。\n");

  msg = HIC"$N" HIC"一声朗笑,手中长剑斜指向天,剑尖吐出一团尺余的银芒,似有灵性般吞缩不定!\n"
           "$n" HIC"正诧异间,那团剑芒却猛得暴涨,朝着$n" HIC"的面门直射而来!!\n\n" NOR;

  message_combatd(msg, me, target);
  damage = me->query_skill("sword");
  damage = random(damage/10) + 1;
  if (damage > 50)
    damage = 50;

  ap = COMBACC_D->math_ap(me,"sword");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);

  if (COMBAT_D->perform_success(me, target,ap,dp,105))
  {
    damage = me->query_skill("sword");
    damage += random(me->query_skill("force") + 1);
    damage = damage/2 + random(damage);

    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
             HIR"只听$n" HIR"一声惨嚎,剑芒从$n"
             HIR"的额头掠过,带出一缕血光!!\n" NOR);
    if (!target->is_busy())
      target->start_busy(1+random(2));
    msg += HIW"剑芒长虹经天般自天际处转得一转，又飞回$N" HIW"的身边。\n" NOR;
    message_combatd(msg, me, target);
    extra = me->query_skill("xiaofeng-sword",1);
    extra = random(extra/10);
    me->add_temp("apply/attack", extra);
    me->add_temp("apply/damage", extra);
    COMBAT_D->do_attack(me, target,weapon);
    COMBAT_D->do_attack(me, target, weapon);
    me->add_temp("apply/attack", -extra);
    me->add_temp("apply/damage", -extra);
    me->add("force", -200);
    me->start_busy(2+random(3));
    return 1;
  }

  else
  {
    msg = HIY"\n$n却识得那团剑芒的厉害,早已远远避在一边.\n" NOR;
    message_combatd(msg, me, target);
    me->start_busy(2+random(3));
  }

  me->add("force",-100);
  return 1;
}

