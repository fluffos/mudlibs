#include <ansi.h>
#include <combat.h>
#define FEI "「" HIG "飞花随流" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && me->query("family/family_name") != "五庄观")
    return notify_fail(FEI "是五庄观不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("xiaofeng-sword", 1) < 150)
    return notify_fail("你的晓风残月剑法修为不够，难以施展" FEI "。\n");
  if (me->query_skill("zhenyuan-force", 1) < 150)
    return notify_fail("你的镇元神功修为不够，难以施展" FEI "。\n");
  if (me->query_skill_mapped("sword") != "xiaofeng-sword")
    return notify_fail("你没有激发晓风残月剑法，难以施展" FEI "。\n");
  if (me->query_skill_mapped("force") != "zhenyuan-force")
    return notify_fail("你没有激发镇元神功，难以施展" FEI "。\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的真气不够，难以施展" FEI "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i,j;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对，难以施展" FEI "。\n");
  msg = HIY "$N"HIY"如痴似狂，手中"NOR + weapon->name() + HIY"瞬间好象失去了章"
        "法，却迅疾异常。电闪间连攻三剑，剑剑不离" HIY"$n" HIY"的要害！\n" NOR;

  message_combatd(msg, me, target);
  j = me->query_temp("apply/attack");
  for (i=1;i<=4;i++)
  {
    if (!me->is_fighting(target))
      break;
    me->add("force",-20);
    me->add_temp("apply/attack", i*20);
    if (random(2) && !target->is_busy())
      target->start_busy(2);
    COMBAT_D->do_attack(me, target, weapon,3);
  }

  me->set_temp("apply/attack", j);
  me->start_busy(1+random(3));
  return 1;
}