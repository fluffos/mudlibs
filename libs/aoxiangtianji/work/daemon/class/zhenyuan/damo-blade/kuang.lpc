#include <ansi.h>
#include <combat.h>
#define KAI "「" HIW "狂风飞沙" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && me->query("family/family_name") != "五庄观")
    return notify_fail(KAI"是五庄观不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("damo-blade", 1) < 120)
    return notify_fail("你的大漠刀法修为不够，难以施展" KAI "。\n");
  if (me->query_skill("zhenyuan-force", 1) < 120)
    return notify_fail("你的镇元神功修为不够，难以施展" KAI "。\n");
  if (me->query_skill_mapped("blade") != "damo-blade")
    return notify_fail("你没有激发大漠刀法，难以施展" KAI "。\n");
  if (me->query_skill_mapped("force") != "zhenyuan-force")
    return notify_fail("你没有激发镇元神功，难以施展" KAI "。\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的真气不够，难以施展" KAI "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  int damage;
  string msg;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对，难以施展" KAI "。\n");
  me->add("force", -60);
  msg = HIC "$N" HIC "淡然一笑，本就快捷绝伦的刀法骤然变"
            "得更加凌厉！就在这一瞬之间，$N" HIC "已劈出刀影"
            "无数！\n刀夹杂着风，风里含着刀影！$n"
        HIC "只觉得心跳都停止了！\n" NOR;
  if (COMBAT_D->perform_success(me, target,
                                "blade",
                                "parry"))
  {
    damage = me->query_skill("blade") + me->query_skill("force")/4;
    damage = damage/2 + random(damage);
    me->add("force", -50);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                  HIR "只见$n" HIR "已被$N" HIR
                  "切得体无完肤，血如箭般由全身喷射而出！\n" NOR);
  }

  else
  {
    me->add("force", -30);
    msg += HIC "可是$p" HIC "急忙抽身躲开，使$P"
           HIC "这招没有得逞。\n" NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

