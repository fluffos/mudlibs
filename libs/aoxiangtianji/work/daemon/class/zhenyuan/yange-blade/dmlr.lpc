#include <ansi.h>
#include <combat.h>
#define FEI "「" HIR "大漠落日" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && me->query("family/family_name") != "五庄观")
    return notify_fail(FEI "是五庄观不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("yange-blade", 1) < 180)
    return notify_fail("你的雁歌刀法修为不够，难以施展" FEI "。\n");
  if (me->query_skill("zhenyuan-force", 1) < 180)
    return notify_fail("你的镇元神功修为不够，难以施展" FEI "。\n");
  if (me->query_skill_mapped("blade") != "yange-blade")
    return notify_fail("你没有激发雁歌刀法，难以施展" FEI "。\n");
  if (me->query_skill_mapped("force") != "zhenyuan-force")
    return notify_fail("你没有激发镇元神功，难以施展" FEI "。\n");
  if ((int)me->query("force") < 800)
    return notify_fail("你的真气不够，难以施展" FEI "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i, extra, damage;
  string *lr = ({
  	HIY"\t\t斜阳落日！\n"NOR,
  	HIY"\t\t\t黄沙万里！\n"NOR,
  	HIY"\t\t\t\t大漠悲歌！\n"NOR,
  });

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对，难以施展" FEI "。\n");
  msg = HIW"$N" HIW"神气贯通，将"NOR + BLINK + FEI + HIW"三式一气呵成！\n"NOR;

  message_combatd(msg, me, target);

  extra = me->query_skill("blade");
  extra = random(extra/5);
  if (extra > 120)
    extra = 120;

   me->add_temp("apply/damage",extra);
   me->add_temp("apply/attack",extra);

  for (i=1;i<=3;i++)
  {
    if (!me->is_fighting(target))
      break;
    me->add("force",-50);
    message( "vision", lr[i-1], environment(me), ({me}) );
    damage = COMBAT_D->do_attack(me, target, weapon,3);
    if (!target->is_busy())
      target->start_busy(2);
    if (random(2) && damage < 1)
    {
      message_vision("$N刀势不绝，刀锋划过，不等$n身形变化，诡异一刀竟然凌空杀来。。。\n",me);
      COMBAT_D->do_attack(me, target, weapon,3);
    }

  }

  me->add_temp("apply/damage",-extra);
  me->add_temp("apply/attack",-extra);
  me->start_busy(2+random(3));
  return 1;
}