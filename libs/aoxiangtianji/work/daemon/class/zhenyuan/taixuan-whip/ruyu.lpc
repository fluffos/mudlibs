#include <ansi.h>
#include <combat.h>
#define SHA "「" HIR "如风似雨" NOR "」"
inherit F_SSERVER;
int is_not_attack() { return 0;	}

int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "五庄观")
    return notify_fail(SHA "是五庄观不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够！\n");
  if((int)me->query("force") < 300 )
    return notify_fail("你的内力不足！\n");
  if((int)me->query("sen") < 100)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if((int)me->query_skill("taixuan-whip",1) < 100)
    return notify_fail("你的太玄鞭级别还不够，使用这一招会有困难!\n");
  if((int)me->query_skill("wuxing-quan",1) < 100)
    return notify_fail("你的五行拳级别还不够，使用这一招会有困难!\n");
  return 1;
}

int perform(object me, object target)
{
  int extra;
  object weapon;
  string msg;
  weapon = me->query_temp("weapon");

  if (! objectp(weapon) ||
      (string)weapon->query("skill_type") != "whip")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");

  msg = HIC"\n$N把手中"+HIR+weapon->name()+NOR+HIC"舞得密如风雨，纷飞之间一鞭抽向$n"
        HIC"！\n"NOR;

  message_combatd(msg, me, target);
  extra = me->query_skill("force")/10;
  if (extra > 50)
    extra = 50 ;
  me->add_temp("apply/attack",extra);

  COMBAT_D->do_attack(me, target, weapon,3);

  me->delete_temp("weapon");
  me->reset_action();
  COMBAT_D->do_attack(me, target, 0, 3);
  COMBAT_D->do_attack(me, target, 0, 3);
  me->set_temp("weapon",weapon);
  me->reset_action();

  me->add_temp("apply/attack",-extra);
  me->receive_damage("sen", 50);
  me->add("force", -80);
  me->start_busy(1+random(3));
  return 1;
}