#include <ansi.h>
#include <combat.h>
#define FUHU "「" HIG "降龙伏虎" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && me->query("family/family_name") != "五庄观")
    return notify_fail(FUHU "是五庄观不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("fumo-staff", 1) < 120)
    return notify_fail("你的伏魔杖法修为不够，难以施展" FUHU "。\n");
  if (me->query_skill("zhenyuan-force", 1) < 120)
    return notify_fail("你的镇元神功修为不够，难以施展" FUHU "。\n");
  if (me->query_skill_mapped("staff") != "fumo-staff")
    return notify_fail("你没有激发伏魔杖法，难以施展" FUHU "。\n");
  if (me->query_skill_mapped("force") != "zhenyuan-force")
    return notify_fail("你没有激发镇元神功，难以施展" FUHU "。\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你的真气不够，难以施展" FUHU "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i,j;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "staff")
    return notify_fail("你使用的武器不对，难以施展" FUHU "。\n");
  msg = HIY"$N" HIY"身型闪动，地面随之起伏一降狂风，手中"+ weapon->name()+
        HIY"也有如狂风暴雨般地向$n" HIY"卷来！\n" NOR;

  message_combatd(msg, me, target);
  j = me->query_temp("apply/attack");
  for (i=1;i<=3;i++)
  {
    if (!me->is_fighting(target))
      break;
    me->add("force",-40);
    me->add_temp("apply/attack", i*30);
    if ((random(3) == 0) && !target->is_busy())
      target->start_busy(1);
    COMBAT_D->do_attack(me, target, weapon);
  }

  me->set_temp("apply/attack", j);
  me->start_busy(1+random(3));
  return 1;
}

