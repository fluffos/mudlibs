#include <ansi.h>
#include <combat.h>
#define TAIYI "「" HIR "太乙真火" NOR "」"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "五庄观")
    return notify_fail(sprintf("%s是五庄观不传之密！\n",TAIYI));
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("taiyi", 1) < 100)
    return notify_fail(sprintf("你的太乙仙法修为不够，难以施展%s。\n",TAIYI));

  if( (int)me->query("max_mana") < 500 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",TAIYI));

  if( (int)me->query("force") < 200 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 125+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 200 )
    return notify_fail("你无法集中精力！\n");

  return 1;
}

int cast_attack(object me, object target)
{
  int success_adj;
  int damage;
  string msg_init,msg_success,msg_fail,msg_backfire_init,msg_backfire_success;

  success_adj = SKILL_D("taiyi")->query_power_effect(me);
  if( !target )
    target = offensive_target(me);
  if( !target
   || !target->is_character()
   || target->is_corpse()
   || target==me)
    return notify_fail(sprintf("你要对谁施%s？\n",TAIYI));
  me->add("mana", -100-2*(int)me->query("mana_factor"));
  me->receive_damage("sen", 80);
  if( random(me->query("max_mana")) < 100 )
  {
    write("你一着急竟然忘了咒语。\n");
    return 1;
  }

  msg_init = HIC"$N" HIC"几个指头迅速捻动，突然张嘴一喷！红橙黄三道火焰“呼”"
             "地一声向$n" HIC"卷去！\n" NOR;
  msg_success = HIR"结果$n" HIR"被烧得焦头烂额！\n" NOR;
  msg_fail = HIC "$n" HIC"轻轻一跳就躲开了。\n" NOR;
  msg_backfire_init = HIC "但是火焰被$n" HIC"以法力一逼，反向$N" HIC"回卷而去！\n" NOR;
  msg_backfire_success = HIC"结果太乙真火反噬，$n" HIC"被烧得焦头烂额！\n"NOR;

  damage = SPELL_D->attacking_cast(
       me,             //attacker
       target,         //target
       success_adj,    //success adjustment
       BACKFIRE,       //backfire or not
       "both",          //damage type: "both", "kee"/"qi", "sen"/"shen"
       msg_init,
       msg_success,
       msg_fail,
       msg_backfire_init,
       msg_backfire_success);
  me->start_busy(2+random(2));
  return 1;
}

