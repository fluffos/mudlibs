#include <ansi.h>
#include <combat.h>
#define XING "「" HIY "群星璀璨" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && me->query("family/family_name") != "五庄观")
    return notify_fail(XING "是五庄观不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("qixing-sword", 1) < 80)
    return notify_fail("你的七星剑法修为不够，难以施展" XING "。\n");
  if (me->query_skill("zhenyuan-force", 1) < 80)
    return notify_fail("你的镇元神功修为不够，难以施展" XING "。\n");
  if (me->query_skill_mapped("sword") != "qixing-sword")
    return notify_fail("你没有激发落七星法，难以施展" XING "。\n");
  if (me->query_skill_mapped("force") != "zhenyuan-force")
    return notify_fail("你没有激发镇元神功，难以施展" XING "。\n");
  if ((int)me->query("force") < 120)
    return notify_fail("你的真气不够，难以施展" XING "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;

  int damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对，难以施展" XING "。\n");
  msg = HIY "$N" HIY "手中" + weapon->name() + HIY "一振，电光火石间"
            "连刺数剑，剑尖闪烁，化作点点繁星罩向$n" HIY "。\n" NOR;
  if (COMBAT_D->perform_success(me, target,
                                ({"sword","dodge"}),
                                ({"parry","dodge"})))
  {
    damage = me->query_skill("sword") + me->query_skill("dodge")/2;
    damage = damage/2 + random(damage);
    me->add("force", -40);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 25,
                         HIR "$n" HIR "顿时大吃一惊，格挡不及，"
                             "登被$N" HIR "剑尖刺中，鲜血四溅！\n" NOR);
  }

  else
  {
    me->add("force", -20);
    msg += CYN "可是$p" CYN "并不慌乱，轻轻格挡开了$P"
           CYN "的剑招。\n"NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}