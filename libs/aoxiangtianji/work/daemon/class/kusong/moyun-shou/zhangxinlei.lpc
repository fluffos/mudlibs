#include <ansi.h>
#include <combat.h>
#define HUO "「" HIY "掌心雷" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && !wizardp(me) && (string)me->query("family/family_name") != "火云洞")
    return notify_fail(HUO "是火云洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("moyun-shou", 1) < 180)
    return notify_fail("你的摩云手修为不够，难以施展" HUO "。\n");
  if (me->query_skill("huomoforce", 1) < 180)
    return notify_fail("你的火魔心法修为不够，难以施展" HUO "。\n");
  if (me->query_skill_mapped("unarmed") != "moyun-shou")
    return notify_fail("你没有激发摩云手，难以施展" HUO "。\n");
  if (me->query_skill_mapped("force")!="huomoforce")
    return notify_fail(HUO"必须配合火魔心法才能使用。\n");
  if (me->query("force") < 1000)
    return notify_fail("你的真气不够，难以施展" HUO "。\n");
  if ((int)me->query("max_force") < 2000)
    return notify_fail("你的内力修为不够，难以施展" HUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  string msg;
  int i,j,damage;

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail(HUO "只能空手施展。\n");
  message_vision("\n$N大喝一声“掌心雷”！\n", me);
  message_sort(HIW "\n大喝声中$N" HIW "身形突然快若闪电，脚下步伐去沉稳如山，拳劲裹着内劲，便"
               "向$n" HIW "猛烈击去。\n" NOR, me, target);
  if (COMBAT_D->perform_success(me, target,
                                ({"unarmed","force"}),
                                ({"dodge","parry"}),
                                110))
  {
    damage = me->query_skill("unarmed") + me->query("str") * 5;
    damage = damage/2 + random(damage);
    msg = COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 20,
                  HIR "$p" HIR "只见$P" HIR "身形"
                      "闪动，那拳风刹那间就到了面前，躲闪不及，被击"
                      "个正中。\n:内伤@?");
    message_vision(msg, me, target);
  }

  else
  {
     msg = HIC "$p" HIC "并慌张，只管见拳拆招，$P"
           HIC "掌力掌力虽猛，却也一时奈何不得。\n" NOR;
     message_vision(msg, me, target);
  }

  message_sort(HIW "\n$N" HIW "一拳击出后，身形借势展开，后续拳头如雨点般"
               "向$n" HIW "扫荡而来。\n" NOR, me, target);
  j = me->query_temp("apply/attack");
  for (i = 3; i<=5; i++)
  {
    if (!me->is_fighting(target))
      break;
    me->add_temp("apply/attack", i*10);
    me->set_temp("MYS_perform", i);
    me->add("force", -50);
    if (random(2) && !target->is_busy())
      target->start_busy(1);
    COMBAT_D->do_attack(me, target, 0);
  }

  me->set_temp("apply/attack", j);
  me->start_busy(2+random(3));
  me->delete_temp("MYS_perform");
  return 1;
}

