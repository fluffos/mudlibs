#include <ansi.h>
#include <combat.h>
#define HUO "「" HIY "修罗焰" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "火云洞")
    return notify_fail(HUO "是火云洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("moyun-shou", 1) < 100)
    return notify_fail("你的摩云手修为不够，难以施展" HUO "。\n");
  if (me->query_skill("huomoforce", 1) < 100)
    return notify_fail("你的火魔心法修为不够，难以施展" HUO "。\n");
  if (me->query_skill_mapped("unarmed") != "moyun-shou")
    return notify_fail("你没有激发摩云手，难以施展" HUO "。\n");
  if (me->query_skill_mapped("force")!="huomoforce")
    return notify_fail(HUO"必须配合火魔心法才能使用。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" HUO "。\n");
  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力修为不够，难以施展" HUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  string msg;

  int damage;

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail(HUO "只能空手施展。\n");
  me->add("force", -100);
  msg = HIR"\n突然" HIR"$N" HIR"双掌搓了几搓，只听得嗤嗤声响，「火焰刀」在$P极"
        "强内劲的斗然冲击之下威势大盛，\n激射而出的无形刀气组成了一片刀网，宛如修"
        "罗降世，向着" HIR"$n" HIR"直劈而下！\n"NOR;

  if (COMBAT_D->perform_success(me, target,
                                ({"unarmed","force"}),
                                ({"dodge","parry"}),
                                120))
  {
    damage = me->query_skill("unarmed");
    damage += me->query_skill("force")/2;
    damage = damage/2 + random(damage);
    msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 30,
                          HIG"$n" HIG"不及躲避，顿时被击个正着！\n"NOR);
  }

  else
  {
    msg += MAG "但是" MAG"$n" MAG"避了开去。\n" NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}