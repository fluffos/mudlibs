#include <ansi.h>
#include <combat.h>
#define HUO "「" HIR "离火三重" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "火云洞")
    return notify_fail(HUO"是火云洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("huoyun-spear", 1) < 150)
    return notify_fail("你的火云枪修为不够，难以施展" HUO "。\n");
  if (me->query_skill("huomoforce", 1) < 150)
    return notify_fail("你的火魔心法修为不够，难以施展" HUO "。\n");
  if (me->query_skill_mapped("spear") != "huoyun-spear")
    return notify_fail("你没有激发火云枪，难以施展" HUO "。\n");
  if (me->query_skill_mapped("force")!="huomoforce")
    return notify_fail(HUO"必须配合火魔心法才能使用。\n");
  if (me->query("force") < 500)
    return notify_fail("你的真气不够，难以施展" HUO "。\n");
  if ((int)me->query("max_force") < 2000)
    return notify_fail("你的内力修为不够，难以施展" HUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  string msg;
  object weapon;
  int i;

  if (!objectp(weapon = me->query_temp("weapon"))
  || (string)weapon->query("skill_type") != "spear")
    return notify_fail("你使用的武器不对。\n");

  msg = HIR"$N" HIR"手中前指的枪尖突然像着火一般，“砰”地炸出一团紫红色的火焰，绕着"
        "通红透亮的枪身燃烧起来！！\n“刷”地拉出一道火红中映着紫焰的流光，哗啦啦地就是"
        "一片遮天的火舌，往$n的头上盖去！"NOR;

  message_combatd(msg, me, target);
  for (i = 3;i<=5;i++)
  {
    if (!me->is_fighting(target))
      break;
    if ((random(3) == 0) && !target->is_busy())
      target->start_busy(1);
    me->set_temp("HYS_perform",i);
    me->add("force",-30);
    COMBAT_D->do_attack(me,target, weapon);
  }

  me->start_busy(1+random(3));
  return 1;
}