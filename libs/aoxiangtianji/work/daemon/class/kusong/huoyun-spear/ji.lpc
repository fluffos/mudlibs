#include <ansi.h>
#include <combat.h>
#define HUO "「" HIR "祭枪" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "火云洞")
    return notify_fail(HUO"是火云洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("huoyun-spear", 1) < 120)
    return notify_fail("你的火云枪修为不够，难以施展" HUO "。\n");
  if (me->query_skill("huomoforce", 1) < 120)
    return notify_fail("你的火魔心法修为不够，难以施展" HUO "。\n");
  if (me->query_skill_mapped("spear") != "huoyun-spear")
    return notify_fail("你没有激发火云枪，难以施展" HUO "。\n");
  if (me->query_skill_mapped("force")!="huomoforce")
    return notify_fail(HUO"必须配合火魔心法才能使用。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" HUO "。\n");
  if ((int)me->query("max_force") < 1200)
    return notify_fail("你的内力修为不够，难以施展" HUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg, wn;
  int ap,dp,damage;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "spear")
    return notify_fail("你使用的武器不对，难以施展" HUO "。\n");

  wn = weapon->name();
  msg = HIR"$N" HIR"向"NOR + wn + HIR"上吐了口鲜血,大喝一声:祭枪！"
        "刹那间烈焰飞腾，这"NOR + wn +HIR"如矫龙游戏于火海，穿透火光，"
        "劈面杀向$n！\n"NOR;
  ap = COMBACC_D->math_ap(me,"spear");
  dp = COMBACC_D->math_dp(me,target,0,0,0);
  dp -= dp/(3+random(5));

  if (COMBAT_D->perform_success(me, target,ap,dp))
  {
    damage = me->query_skill("spear");
    damage += random(me->query_skill("force",1) + 1);
    damage = damage/2 + random(damage/2);
    me->add("force", -100);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 60,
               HIR"$n被这扑面而来的热浪吹的有点头晕，正不知所措间，$N"NOR +
               wn + HIR"迎面杀来，哪里还能躲避？\n一声惨叫后，$n胸前一片血肉模"
               "糊，烧焦的衣襟还冒着火星！\n"NOR);
  }

  else
  {
    me->add("force", -50);
    msg += HIW"$n一声冷笑，并不惊慌，轻轻一闪，就避开了$N这全力一击！\n"NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

