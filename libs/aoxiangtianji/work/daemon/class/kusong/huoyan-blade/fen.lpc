#include <ansi.h>
#include <combat.h>
#define HUO "「" HIR "焚身" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "火云洞")
    return notify_fail(HUO"是火云洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("huoyan-blade", 1) < 150)
    return notify_fail("你的火焰刀法修为不够，难以施展" HUO "。\n");
  if (me->query_skill("huomoforce", 1) < 150)
    return notify_fail("你的火魔心法修为不够，难以施展" HUO "。\n");
  if (me->query_skill_mapped("blade") != "huoyan-blade")
    return notify_fail("你没有激发火焰刀法，难以施展" HUO "。\n");
  if (me->query("force") < 500)
    return notify_fail("你的真气不够，难以施展" HUO "。\n");
  if ((int)me->query("max_force") < 2000)
    return notify_fail("你的内力修为不够，难以施展" HUO "。\n");
  return 1;
}

int perform(object me,object target)
{
  string msg;
  object weapon;
  int damage;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对，难以施展" HUO "。\n");
  msg = HIR "$N" HIR "运火魔心法聚集内力，手中"NOR + weapon->name()
      + HIR"赤焰飞涨，使出一招「焚身」，刀焰夹着内力向$n" HIR "的胸口劈去。\n"NOR;
  if (COMBAT_D->perform_success(me, target,
                                ({"blade","force"}),
                                ({"dodge","force"}),
                                120))
  {
    me->add("force", -150);
    damage = me->query_skill("blade");
    damage += me->query_skill("force")/2;
    damage = damage*2/3 + random(damage*3/2 + 1);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 60,
                   HIR "$p" HIR "强运内力试图抵抗，然而无法掌握$P"
                   HIR "内力的变化，结果被$P"
                   HIR "的刀焰重创在胸口！\n" NOR);
  }

  else
  {
    msg += HIC "却见$p" HIC "不慌不忙，轻轻一闪，躲过了$P"
           HIC "的必杀一击！\n" NOR;
    me->add("force", -60);
  }

  me->start_busy(1+random(3));
  message_combatd(msg, me, target);
  return 1;
}