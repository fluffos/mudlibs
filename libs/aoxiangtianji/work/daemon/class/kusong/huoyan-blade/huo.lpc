#include <ansi.h>
#include <combat.h>
#define HUO "「" HIR "流星火雨" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "火云洞")
    return notify_fail(HUO"是火云洞不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("huoyan-blade", 1) < 100)
    return notify_fail("你的火焰刀法修为不够，难以施展" HUO "。\n");
  if (me->query_skill("huomoforce", 1) < 100)
    return notify_fail("你的火魔心法修为不够，难以施展" HUO "。\n");
  if (me->query_skill_mapped("blade") != "huoyan-blade")
    return notify_fail("你没有激发火焰刀法，难以施展" HUO "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" HUO "。\n");
  if ((int)me->query("max_force") < 800)
    return notify_fail("你的内力修为不够，难以施展" HUO "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i,j,k,damage;
  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对，难以施展" HUO "。\n");
  msg = HIR "$N" HIR "施出火焰刀法绝技，手中" + weapon->name() +
        HIR "运转如飞，激起层层热浪席卷$n" HIR "周身！\n" NOR;
  message_combatd(msg, me, target);
  me->add("force", -60);

  j = me->query_temp("apply/attack");
  k = me->query_temp("apply/damage");
  damage = 0;
  for (i = 1; i <=3 ; i++)
  {
    if (!living(target) || !me->is_fighting(target))
      break;
    if (random(2) && !target->is_busy())
      target->start_busy(2);
    me->add_temp("apply/attack",i*20);
    damage = COMBAT_D->do_attack(me, target, weapon, 0);
    if (damage < 1)
      me->add_temp("apply/damage",80);
  }

  me->set_temp("apply/attack",j);
  me->set_temp("apply/damage",k);
  me->start_busy(1 + random(3));
  return 1;
}