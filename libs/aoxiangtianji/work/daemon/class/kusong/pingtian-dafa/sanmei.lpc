#include <ansi.h>
#include <combat.h>
#define HUO "「" HIR "三味真火" NOR "」"
inherit F_SSERVER;
int valid_cast(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "火云洞")
    return notify_fail(sprintf("%s是火云洞不传之密！\n",HUO));
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("pingtian-dafa", 1) < 100)
    return notify_fail(sprintf("你的平天大法修为不够，难以施展%s。\n",HUO));

  if( (int)me->query("max_mana") < 500 )
    return notify_fail(sprintf("你的法力修为不够，难以施展%s。\n",HUO));

  if( (int)me->query("force") < 300 )
    return notify_fail("你的真气不够。\n");
  if((int)me->query("mana") < 150+2*(int)me->query("mana_factor") )
    return notify_fail("你的法力不够！\n");
  if((int)me->query("sen") < 200 )
    return notify_fail("你无法集中精力！\n");

  return 1;
}

int cast_attack(object me, object target)
{
  int success_adj;
  string msg_init,msg_success,msg_fail,msg_backfire_init,msg_backfire_success;
  if( !target ) target = offensive_target(me);
  if( !target
    || !target->is_character()
    || target->is_corpse()
    || target==me)
     return notify_fail("你要攻击谁？\n");
  me->add("mana", -30-2*(int)me->query("mana_factor"));
  me->receive_damage("sen", 50);
  if( random(me->query("max_mana")) < 100 )
  {
    write("这次不灵了！\n");
    return 1;
  }

  success_adj = SKILL_D("pingtian-dafa")->query_power_effect(me);

  msg_init = HIC "$N" HIC"伸手在鼻子上砸了两，顿时鲜血直冒，突然红橙黄三道火焰“呼”地"
             "一声向" HIC"$n" HIC"卷去！\n" NOR;
  msg_success = HIC "结果" HIC"$n" HIC"被烧得焦头烂额！\n" NOR;
  msg_fail = HIC"\n结果被" HIC"$n" HIC"躲开了。\n"NOR;
  msg_backfire_init = HIC "结果火焰被" HIC"$n" HIC"以法力一逼，反向$N回卷而去！\n" NOR;
  msg_backfire_success = HIR"\n结果" HIC"$n" HIC"躲避不及，被烧得焦头烂额！\n" NOR;

  SPELL_D->attacking_cast(
       me,
       target,
       success_adj,
       BACKFIRE,
       "sen",
       msg_init,
       msg_success,
       msg_fail,
       msg_backfire_init,
       msg_backfire_success);
  me->start_busy(1+random(3));
  return 1;
}