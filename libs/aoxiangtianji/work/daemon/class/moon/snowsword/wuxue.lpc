#include <ansi.h>
#include <combat.h>
#define SHA "「" HIW "寒风舞雪" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "月宫")
    return notify_fail(SHA"是月宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("snowsword", 1) < 120)
    return notify_fail("你的风回雪舞剑法修为不够，难以施展" SHA "。\n");
  if (me->query_skill_mapped("sword") != "snowsword")
    return notify_fail("你没有激发风回雪舞剑法，难以施展" SHA "。\n");
  if (me->query("force") < 150)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap, dp;
  int damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = HIW"$N"HIW"清姿曼舞，手中" + weapon->name() + HIW"随着那美妙的舞蹈，"
        "不时闪现，如和鼓点。\n随着$N身形的越来越快，这剑尖闪现的寒芒，渐渐飘洒如满"
        "天飞舞的雪花。\n"NOR;
  message_vision(msg,me,target);

  damage = me->query_skill("snowsword",1);
  damage = random(damage/10);
  if (damage > 40)
    damage = 40;
  ap = COMBACC_D->math_ap(me,"sword");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp,120))
  {
    damage = me->query_skill("sword");
    damage += random(me->query_skill("dodge")+1);
    damage = damage/2 +random(damage);
    me->add("force", -60);
    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                  HIR "$n暗叫“不好”，急切间却无从躲避，眼睁睁看着这漫天的雪花" NOR +
                  HIR "朵朵袭来，转瞬遍体鳞伤了。\n"NOR);
  }

  else
  {
    me->add("force", -30);
    msg = CYN "$n" CYN "暗叫“不好”，集中精神，眼睛眨也不眨，只盯着那一点剑尖。"
          CYN "$N" CYN "眼看无法得逞，也只得罢了。\n" NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

