#include <ansi.h>
#include <combat.h>
#define SHA "「" HIG "回风拂柳" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "月宫")
    return notify_fail(SHA"是月宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("snowsword", 1) < 100)
    return notify_fail("你的风回雪舞剑法修为不够，难以施展" SHA "。\n");
  if (me->query_skill_mapped("sword") != "snowsword")
    return notify_fail("你没有激发风回雪舞剑法，难以施展" SHA "。\n");
  if (me->query("force") < 150)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap, dp;
  int damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = HIY "$N" HIY "一声娇喝，身形一跃而起，衣裙飘飘，如仙子凌波。"
        "\n半空中一个翻转，倒挂而飞来，如春风吹拂的柳条，柔韧而洒脱。\n掌中" +
        weapon->name() + HIY"寒芒闪现，直向$n穿心刺来！\n"NOR;

  message_vision(msg,me,target);

  damage = me->query_skill("snowsword",1);
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;

  ap = COMBACC_D->math_ap(me,"sword");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp,120))
  {
    damage = me->query_skill("sword");
    damage += me->query_skill("force")/2;
    damage = damage/2 +random(damage);
    me->add("force", -60);
    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                  HIR "$n突觉寒风扑面，急忙侧身躲避，哪里还来得及，$N" HIR +
                  weapon->name() + HIR "正中$n，穿出了满地的鲜血。\n"NOR);
  }

  else
  {
    me->add("force", -30);
    msg = CYN "$n" CYN "连忙飞身躲闪开来，这扑面而来的，正是不觉寒的杨柳风。\n" NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

