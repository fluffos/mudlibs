#include <ansi.h>
#include <combat.h>
#define SHA "「" HIW "漫天飞雪" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "月宫")
    return notify_fail(SHA"是月宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("snowsword", 1) < 150)
    return notify_fail("你的风回雪舞剑法修为不够，难以施展" SHA "。\n");
  if (me->query_skill("moondance", 1) < 150)
    return notify_fail("你的冷月凝香舞修为不够，难以施展" SHA "。\n");
  if (me->query_skill_mapped("sword") != "snowsword")
    return notify_fail("你没有激发风回雪舞剑法，难以施展" SHA "。\n");
  if (me->query("force") < 400)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");
  return 1;
}

int perform(object me, object target)
{
   object weapon;
   int i,damage, ap, dp;
   string msg;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");

   message_vision(HIW"$N轻叱一声，脚尖一点，身体急速上旋，在半空中一个折腰。"
                  "同时手腕轻抖，剑光闪动幻作漫天飞雪卷向$n。\n"NOR,me,target);
   message_vision(HIC"$N同时使出风回雪舞剑的前三招，在半空中压向$n。\n"NOR,me,target);
   damage = 0;

   for (i=4;i<=6;i++)
   {
     if (!me->is_fighting(target))
       break;
     me->set_temp("WX_perform", i);
     damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
     me->add("force",-20);
     if ((damage > 0) && (random(2)) && !target->is_busy())
       target->start_busy(1);
   }

   me->delete_temp("WX_perform");

   if (!living(target) || (environment(me) != environment(target)))
   {
     me->start_busy(1+random(3));
     return 1;
   }

   if ((int)me->query_skill("snowsword",1) > 200 &&
       (int)me->query_skill("moondance",1) > 200 )
   {
     msg = HIC"$N身体斜斜向上飘出，也不回头，反手就刺，连下杀招攻往$n。\n"NOR;
     ap = me->query_skill("sword");
     ap += me->query_skill("dodge");

     dp = target->query_skill("dodge");
     dp += target->query_skill("parry");
     if (target->is_busy() || target->query_temp("no_move"))
       dp = dp/2 ;
     else
       dp -= dp/10;

     if (COMBAT_D->perform_success(me, target,
                                ({"sword","dodge"}),
                                ({"dodge","parry"}),
                                110))
     {
       damage = (me->query_skill("sword") + me->query_skill("dodge"))/2;
       damage += me->query_skill("force")/2;
       damage = damage/3 + random(damage);
       me->add("force",-60);
       msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                  HIR "$n被攻得晕头转向，急切间无力躲闪，被这" NOR + weapon->name()
                + HIR "一剑刺中，顿时鲜血淋漓。\n"NOR);
     }

     else
     {
       me->add("force",-30);
       msg += HIY"$n见势不妙，在剑风袭来之前就急忙飞身躲开！\n"NOR;
     }

     message_combatd(msg, me, target);
     if (!living(target) || (environment(me) != environment(target)))
     {
       me->start_busy(1+random(3));
       return 1;
     }

     if ((int)me->query_skill("snowsword",1) > 300 &&
         (int)me->query_skill("moondance",1) > 300 )
     {
       msg = HIC"$N斜斜一再个翻身，长剑幻作千百支冰箭，夹着一股寒风扑向$n。\n"NOR;
       damage = me->query_skill("sword");
       damage = random(damage/10) + 1;
       if (damage > 50)
         damage = 50;
       ap = COMBACC_D->math_ap(me,"sword");
       dp = COMBACC_D->math_dp(me,target,-damage,0,0);

       if (COMBAT_D->perform_success(me, target,ap,dp))
       {
       	 damage = me->query_skill("sword");
       	 damage += me->query_skill("force")/2;
         damage = damage/2 + random(damage);
       	 me->add("force",-60);
         msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40,
                   HIR "$n哪里可能躲开这闪电般的攻击，被这" NOR + weapon->name()
                 + HIR "转瞬划了数剑，顿时鲜血淋漓。\n"NOR);
       }

       else
       {
       	 me->add("force",-20);
       	 msg += HIY"$n万分危急之时，一个后仰翻滚，恰恰避开了这致命的一击！\n"NOR;
       }

       message_combatd(msg, me, target);
     }
   }
   me->start_busy(2+random(3));
   return 1;
}

