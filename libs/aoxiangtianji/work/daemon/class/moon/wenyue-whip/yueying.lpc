#include <ansi.h>
#include <combat.h>
#define SHA "「" HIR "月影徘徊" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "月宫")
    return notify_fail(SHA"是月宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("wenyue-whip", 1) < 100)
    return notify_fail("你的问月鞭法修为不够，难以施展" SHA "。\n");
  if (me->query_skill_mapped("whip") != "wenyue-whip")
    return notify_fail("你没有激发问月鞭法，难以施展" SHA "。\n");
  if (me->query("force") < 150)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;

  int damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "whip")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = HIB "$N" HIB"轻挥手中的"NOR + weapon->name() + HIB"，身形曼妙如舞蹈。"
        "\n手中长鞭挥绕一个一个的圆圈，如同十五的圆月，映衬着淡淡的鞭影。\n这鞭影若有若无，"
        "似有意，似无情，盘着$n不停的旋绕。\n"NOR;
  message_vision(msg,me,target);

  if (COMBAT_D->perform_success(me, target,
                                ({"whip","dodge"}),
                                ({"dodge","parry"})))
  {
    damage = (me->query_skill("whip") + me->query_skill("dodge"))/2;
    damage += me->query_skill("force")/2;
    damage = damage/3 + random(damage);
    me->add("force", -60);
    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                  HIR "$n只能被动的跟着那一个一个的圆圈绕，正狼狈时，$N" HIR +
                  weapon->name() + HIR "重重的抽在了$p的背部。\n"NOR);
  }

  else
  {
    me->add("force", -30);
    msg = CYN "$n" CYN "见势不妙，不顾一切的飞身窜出了道道鞭影。\n" NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}