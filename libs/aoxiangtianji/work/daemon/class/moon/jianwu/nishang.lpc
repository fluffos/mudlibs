#include <ansi.h>
#include <combat.h>
#define NISHANG "「" HIR "霓裳舞" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && !wizardp(me) && (string)me->query("family/family_name") != "月宫")
    return notify_fail(NISHANG"是月宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("jianwu", 1) < 120)
    return notify_fail("你的剑舞修为不够，难以施展" NISHANG "。\n");
  if (me->query_skill_mapped("dagger") != "jianwu")
    return notify_fail("你没有激发剑舞，难以施展" NISHANG "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" NISHANG "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int i,j,num;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "dagger")
    return notify_fail("你使用的武器不对，难以施展" NISHANG "。\n");
  msg = HIG "$N"HIG"嫣然一笑，手中" + weapon->name()
          + "带动飘荡的舞绸，正是月宫绝技" + NISHANG +
          HIG"，幽香含着剑影，舞绸飘荡开来，把$n裹在当中！\n" NOR;

  message_combatd(msg, me, target);
  if (me->query_skill("jianwu", 1) > 300)
    num = 5;
  else if (me->query_skill("jianwu", 1) > 250)
    num = 4;
  else if (me->query_skill("jianwu", 1) > 200)
    num = 3;
  else
    num = 2;

  j = me->query_temp("apply/attack");
  for (i = 1; i<=1+num;i++)
  {
    if (!living(target) || (environment(me) != environment(target)))
      break;
    me->set_temp("JWD_perform",i);
    me->add_temp("apply/attack", i*20);
    if (!target->is_busy() && random(2))
      target->start_busy(1);
    COMBAT_D->do_attack(me, target, weapon);
    me->add("force",-15);
  }

  me->set_temp("apply/attack", j);
  me->start_busy(2+random(3));
  me->delete_temp("JWD_perform");
  return 1;
}