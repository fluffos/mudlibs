#include <ansi.h>
#include <combat.h>
#define HUA "「" HIG "四季飞花" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "月宫")
    return notify_fail(HUA"是月宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("baihua-zhang", 1) < 100)
    return notify_fail("你的百花掌法修为不够，难以施展" HUA "。\n");
  if (me->query_skill_mapped("force")!="moonforce")
    return notify_fail(HUA"必须配合圆月心法才能使用。\n");
  if (me->query_skill_mapped("unarmed") != "baihua-zhang")
    return notify_fail("你没有激发百花掌法，难以施展" HUA "。\n");
  if (me->query("force") < 300)
    return notify_fail("你的真气不够，难以施展" HUA "。\n");
  return 1;
}

int perform(object me, object target)
{
  int sk,damage;
  string msg;

  if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
    return notify_fail("［四季飞花］必须空出双手才能使用。\n");
  sk = me->query_skill("baihua-zhang",1);
  msg = HIR"$N" HIR"微微一笑，娇叱一声，忽地凌空而起，双掌幻化成漫天花雨，一时花香缭绕！\n"NOR;
  message_vision(msg,me);

  msg = HIG  "\n\t~~~ 百花迎春 ~~~~ ！\n" NOR;
  msg += HIG"$N" HIG"双掌翻飞, 宛如片片花瓣,夹杂着绵绵的劲力,层层拍向$n" HIG"！\n" NOR;
  msg += HIG"伴随着片片飞花,$n" HIG"的眼前出现了翠绿的春季景色...\n" NOR;

  if (COMBAT_D->perform_success(me, target,
                                "force",
                                "parry",
                                130))
  {
    me->add("force",-60);
    damage = me->query_skill("force");
    damage = damage/2 + random(damage);
    msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 20,
                  HIB"$n" HIB"被掌法产生的幻象所迷惑,显得目光呆滞。。。\n" NOR);
  }

  else
  {
    me->add("force",30);
    msg += HIB"\n$n" HIB"似乎看透了这一切,闭目调息,不为情形所迷惑...\n"NOR;
  }

  message_combatd(msg, me, target);

  if (!living(target) ||
      !target->is_fighting(me) ||
      sk <= 120)
  {
    me->start_busy(1+random(3));
    return 1;
  }

  msg = HIC"\n\t~~~ 仲夏晚风 ~~~~ ！\n"NOR;
  msg += HIC"$N" HIC"变探出一掌, 划出一道美丽的弧线, 恰似柔柔微风, 击向$n" HIC"！\n" NOR;
  msg += HIG"伴随着柔柔的微风,$n" HIG"的眼前出现了斑斓的夏季景色...\n" NOR;

  if (COMBAT_D->perform_success(me, target,
                                "unarmed",
                                "dodge",
                                120))
  {
    me->add("force",-60);
    damage = me->query_skill("unarmed");
    damage = damage/2 + random(damage);
    msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 30,
                  HIR"$n" HIR"被掌法产生的幻象所迷惑,显得两眼迷茫...\n" NOR);
  }

  else
  {
    me->add("force",-30);
    msg += HIB "\n$n" HIB"似乎看透了这一切,转过脸去,不为情形所迷惑...\n" NOR;
  }

  message_combatd(msg, me, target);

  if (!living(target) ||
      !target->is_fighting(me) ||
      sk <= 150 ||
      me->query("force") < 200)
  {
    me->start_busy(1+random(3));
    return 1;
  }

  msg = HIY  "\n~~~ 深秋雾幻 ~~~~ ！\n" NOR;
  msg += HIY "$N腾空跃起, 身形变幻不定，双掌飘忽无踪 , 犹如一团轻烟罩住$n！\n" NOR;
  msg += HIG "伴随着不定的雾岚，$n仿佛看到了金秋絮舞，百花凋敝...\n" NOR;

  if (COMBAT_D->perform_success(me, target,
                                "unarmed",
                                "parry",
                                110))
  {
    me->add("force",-60);
    damage = me->query_skill("unarmed");
    damage = damage/2 + random(damage);
    msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 30,
                  HIC"$n" HIC"被掌法产生的幻象所迷惑,显得无限伤感....\n" NOR);
  }

  else
  {
    me->add("force",-30);
    msg += HIB "\n$n" HIB"似乎看透了这一切,屏气凝神,不为情形所迷惑...\n" NOR;
  }

  message_combatd(msg, me, target);

  if (!living(target) ||
      !target->is_fighting(me) ||
      sk <= 180 ||
      me->query("force") < 200)
  {
    me->start_busy(1+random(3));
    return 1;
  }

  msg = HIW  "\n\t~~~ 寒梅傲冬 ~~~~ ！\n" NOR;
  msg += HIW "$N" HIW"功行奇经八脉, 配合玄阴之躯，双掌缓缓推出,化做片片飞雪,将$n" HIW"罩在无垠白雪之中！\n" NOR;
  msg += HIG "伴随着纷飞的雪花,$n" HIG"的眼前出现了苍茫的一片白影...\n" NOR;
  if (COMBAT_D->perform_success(me, target,
                                "unarmed",
                                "parry"))
  {
    me->add("force",-60);
    damage = me->query_skill("unarmed");
    damage += random(me->query_skill("force") + 1);
    damage = damage/2 + random(damage);
    msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 40,
                  MAG"$n" MAG"被掌法产生的幻象所迷惑,显得有点迷茫...\n" NOR);
  }

  else
  {
    me->add("force",-30);
    msg += HIB "\n$n" HIB"似乎看透了这一切,驻念于心,不为情形所迷惑...\n" NOR;
  }

  message_combatd(msg, me, target);
  me->start_busy(2+random(3));
  return 1;
}

