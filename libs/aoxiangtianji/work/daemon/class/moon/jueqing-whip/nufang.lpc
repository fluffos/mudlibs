#include <ansi.h>
#include <combat.h>
#define SHA "「" HIR "怒放寒梅" NOR "」"
inherit F_SSERVER;
int valid_pfm(object me, object target)
{
  if(userp(me) && (string)me->query("family/family_name") != "月宫")
    return notify_fail(SHA"是月宫不传之密！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query_skill("jueqing-whip", 1) < 120)
    return notify_fail("你的绝情鞭法修为不够，难以施展" SHA "。\n");
  if (me->query_skill("moonforce", 1) < 120)
    return notify_fail("你的圆月心法修为不够，难以施展" SHA "。\n");
  if (me->query_skill_mapped("whip") != "jueqing-whip")
    return notify_fail("你没有激发绝情鞭法，难以施展" SHA "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，难以施展" SHA "。\n");
  return 1;
}

int perform(object me, object target)
{
  object weapon;
  string msg;
  int ap, dp;
  int damage;

  if (! objectp(weapon = me->query_temp("weapon")) ||
      (string)weapon->query("skill_type") != "whip")
    return notify_fail("你使用的武器不对，难以施展" SHA "。\n");
  msg = HIR "$N" HIR "微微抬头，眼神缥缈中带着丝丝伤感，弥漫着这冷，"
        "这寒。\n天地间，仿佛雪花在飘舞，瞬间茫茫了！突如其来的一个转折，"NOR
        + weapon->name() + HIR "“啪”的微响，\n如同刺破雪原的寒梅，寒冷中微微"
        "震颤，挟着猛烈的罡风，扑面直奔$n" HIR "而来！\n" NOR;

  message_vision(msg,me,target);

  damage = me->query_skill("whip");
  damage = random(damage/10);
  if (damage > 50)
    damage = 50;
  ap = COMBACC_D->math_ap(me,"whip");
  dp = COMBACC_D->math_dp(me,target,-damage,0,0);
  if (COMBAT_D->perform_success(me, target,ap,dp,120))
  {
    damage = me->query_skill("whip");
    damage = random(me->query_skill("force",1)+1);
    damage = damage/2 + random(damage);
    me->add("force", -60);
    msg = COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                  HIR "$n仿佛被这离奇的异象吸引了，正呆愣间，$N" HIR +
                  weapon->name() + HIR "带着寒风重重的抽在了$p的左臂。\n"NOR);
  }

  else
  {
    me->add("force", -30);
    msg = CYN "$n" CYN "见势不妙，稳定心神，连忙飞身躲闪开来。\n" NOR;
  }

  message_sort(msg, me, target);
  me->start_busy(1+random(3));
  return 1;
}

