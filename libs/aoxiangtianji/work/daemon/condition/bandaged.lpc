// bandaged.c
#include <ansi.h>
#include <condition.h>
inherit ILLNESS;
int update_condition(object me, int duration)
{
  if( (int)me->query("eff_kee") < (int)me->query("max_kee") )
    me->receive_curing("kee", 3);

  me->apply_condition("bandaged", duration - 1);
  if( !duration ) return 0;
  return CND_CONTINUE;
}

