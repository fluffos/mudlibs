// fire_poison.c
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
inherit POISON;
string name() { return "fire_poison"; }

string chinese_name() { return "火毒"; }

string update_msg_others()
{
       return HIR "$N觉得伤处火辣辣的一片疼痛。\n" NOR;
}

string update_msg_self()
{
  return HIB "你觉得伤口处就象是火在烧，看来是火毒发作了！\n" NOR;
}

