// moon_poison.c
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
inherit POISON;
string name() { return "moon_poison"; }

string chinese_name() { return "月蚀"; }

string update_msg_others()
{
	return HIR "$N忽然脸色变得异常的苍白。\n" NOR;
}

string update_msg_self()
{
	return HIG "你感觉身体一点点虚弱下去！\n" NOR;
}

