#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
inherit POISON;
string name() { return "liangyi_luan"; }

string chinese_name() { return "乱气之扰"; }

string update_msg_others()
{
  return HIM "$N" HIM "惨哼两声，整个人摇摇晃晃，便似"
             "醉酒一般。\n" NOR;
}

string update_msg_self()
{
  return HIR "忽然觉得一阵难受，心虚气短，看来是受到"
             "两仪乱气的干扰。\n" NOR;
}