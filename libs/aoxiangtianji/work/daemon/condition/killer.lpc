int dispel() { return 0; }

int update_condition(object me, int duration)
{
  object env;
  int max_kee, max_sen;

  if (!objectp(me) || !playerp(me))
    return 0;

  if (duration < 1)
  {
    tell_object(me, "官府不再通缉你了！\n");
    CHANNEL_D->do_channel(this_object(), "rumor",
                  "因为" + me->name(1) + "一直没能被" +
                  "缉拿归案，听说官府已经取消了通缉令。");
    return 0;
  }

  env = environment(me);
  if (!objectp(env) || env->is_safty() || env->query("no_fight"))
  {
    if (objectp(env))
      message_vision("$N疑神疑鬼的四周张望，额头上冷汗不断的冒了出来！\n",me);
    max_kee = me->query("max_kee")/5;
    max_sen = me->query("max_sen")/5;
    me->receive_damage("sen",max_sen);
    me->receive_damage("kee",max_kee);
  }

  me->apply_condition("killer", duration - 1);
  return 1;
}

