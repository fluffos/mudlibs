   ]),
   (["name"  : HIC"旁敲侧击"NOR,
     "action": "$N横持$w，暗运真气，忽然间只见杖头一跳，灵蛇般钻向$n的$l",
     "dodge" : -5,
     "parry" : 0,
     "damage": 60,
