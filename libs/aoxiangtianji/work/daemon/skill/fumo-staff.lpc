  (["name"  : HIW"当头棒喝"NOR,
    "action": "$N运足力气将$w抡了几个大圆，呼！地一声向$n当头砸下",
    "dodge" : 15,
    "parry" : -5,
    "damage": 20,
    "force" : 10,
    "lvl"   : 0,
    "damage_type":   "砸伤"
  ]),
  (["name"  : HIW"智缚凶顽"NOR,
    "action": "只听$N一声高叫：还不缚手就擒！手中的$w一绞，扫向$n$l",
    "dodge" : 0,
    "parry" : -5,
    "damage": 30,
    "force" : 10,
    "lvl"   : 50,
    "damage_type":   "砸伤"
   ]),
   (["name"  : HIY"「群魔伏首」"NOR,
     "action": "$N使出一招「群魔伏首」，手中的$w带出飞沙走石般的杖风压向$n的$l",
     "dodge" : 5,
     "parry" : -5,
     "damage": 40,
     "force" : 10,
     "lvl"   : 100,
     "damage_type":   "砸伤"
   ]),
   (["name"  : HIY"勇往直前"NOR,
     "action": "只见$N略略一退，旋即一个跨步，$w划出一道弧光刺向$n$l",
     "dodge" : 5,
     "parry" : 0,
     "damage": 50,
