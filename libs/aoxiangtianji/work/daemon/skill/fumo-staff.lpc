int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "五庄观")
    return notify_fail("伏魔杖是五庄观不传之密！\n");
  if( (int)me->query("max_force") < 200 )
    return notify_fail("你的内力不够，没有办法学伏魔杖。\n");
  if( !(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "staff" )
    return notify_fail("你必须先找一条禅杖才能学伏魔杖。\n");

  if ((int)me->query_skill("staff",1) < (int)me->query_skill("fumo-staff",1))
    return notify_fail("你的基本杖法不够，无法练习伏魔杖！\n");
  return 1;
}

int valid_enable(string usage)
{
  return (usage=="staff")||(usage=="parry");
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;
  pfm_num = me->query_temp("FMZ_perform");
  level = query_skill_lvl(me,"fumo-staff",action);

  if (pfm_num && (pfm_num < (sizeof(action))))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 1200 || (int)me->query("force") < 100 )
     return notify_fail("你现在太累了，强练无益。\n");

  me->receive_damage("kee", 30);
  me->add("force", -30);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("fumo-staff",1);
  if (level > action[i]["lvl"])
    return WHT"降龙伏虎，杀妖除魔。\n"NOR;

  level = query_skill_lvl(me,"fumo-staff",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习伏魔杖！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("zhenyuan") + "/fumo-staff/" + func;
}

int expell_delete()
{
  return 1;
}

int query_effect_parry(object me, object victim)
{
  return 105;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 10  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("fumo-staff",1);
  level = query_skill_lvl(me,"fumo-staff",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了伏魔杖的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

