#include <ansi.h>
inherit FORCE;
int valid_enable(string usage) { return usage=="force"; }

int valid_learn(object me)
{
  if((string)me->query("family/family_name")!="月宫")
    return notify_fail("不是月宫的弟子，怎么可以学习圆月心法？\n");
  if( (int)me->query_skill("force", 1) < 10
   || (int)me->query_skill("force", 1) <= (int)me->query_skill("moonforce", 1) )
    return notify_fail("你的内功底子太差了，无法学习圆月心法。\n");

  return 1;
}

int practice_skill(object me)
{
  return notify_fail("圆月心法只能向师父学，或是从运用(exert)中增加熟练度。\n");
}

mixed valid_damage(object ob,object me,int damage)
{
  object weapon;
  int skill_lev,myforce,yourforce ;
  int dam, eff_dam ;
  string msg;
  if(me->query("family/family_name") != "月宫")
    return 0;

  msg = "";
  eff_dam = 0;
  weapon = me->query_temp("weapon");
  if (objectp(weapon) &&
      (string)weapon->query("skill_type") == "whip" &&
      me->query_temp("JQW_perform"))
  {
    msg += HIW"$n" HIW"把手中的"+ weapon->name() +
           HIW"舞得密不透风，把伤害消减了很多！\n"NOR;
    eff_dam = -damage/3;
  }

  myforce = (int)me->query("force");
  yourforce = (int)ob->query("force");
  skill_lev = (int)me->query_skill("moonforce",1);
  if (skill_lev > 150 )
  {
    if (random(2))
    {
      if (random(myforce + yourforce) > (yourforce*3)/2)
      {
        msg += HIY"$n低眉念动圆月心法，一股力道直向$N反击了回来！\n"NOR;
        if (random(4))
        {
          msg += HIY"$N只觉得脚步飘浮，身形晃了几晃。看来是受了点内伤了！\n"NOR;
          dam = (int)me->query("force_factor");
          if (dam > 0)
            ob->receive_wound("kee", dam,me);
        }

        dam = damage/4 + random(damage/2) + random(skill_lev);
        return (["msg" : msg,
                 "damage" : eff_dam-dam,
               ]);
      }

      else if (random(myforce + yourforce) > yourforce)
      {
        msg += HIY"$n运起圆月心法，消解了部分的伤害！\n"NOR;
        if (random(3) == 0)
          return (["msg" : msg,
                   "damage" : eff_dam - damage*2/3 - random(skill_lev),
                 ]);
        else
          return (["msg" : msg,
                   "damage" : eff_dam - damage/3 - random(skill_lev),
                 ]);
      }

      else if (random(2))
      {
        msg += HIY"$n运起圆月心法，消解了些许的伤害！\n"NOR;
        return (["msg" : msg,
                 "damage" : eff_dam - damage/4 - random(skill_lev),
               ]);
      }

    }

  }

  return eff_dam;
}

int query_power_effect(object me)
{
  int force_skill ;

  force_skill = (int)me->query_skill("moonforce",1);
  if (force_skill < 150)
    return 110;
  else if (force_skill < 300)
    return 120;
  return 130;
}

string exert_function_file(string func)
{
  return CLASS_D("moon") + "/moonforce/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 102;
}

int learn_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 10  ,
         ]);
}

