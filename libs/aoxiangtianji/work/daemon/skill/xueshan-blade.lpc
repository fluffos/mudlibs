  (["name"  : HIW"「风回雪舞」"NOR,
    "action": "$N手中$w斜指，一招「风回雪舞」，反身一顿，一刀向$n的$l撩去",
    "damage": 20,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 0,
    "damage_type" : "割伤"
  ]),
  (["name"  : HIW"「大雪纷飞」"NOR,
    "action": "$N一招「大雪纷飞」，左右腿虚点，$w一提一收，平刃挥向$n的颈部",
    "damage": 25,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 50,
    "damage_type" : "割伤"
  ]),
  (["name"  : HIG"「飞雪飘零」"NOR,
    "action": "$N展身虚步，提腰跃落，一招「飞雪飘零」，刀锋一卷，拦腰斩向$n",
    "damage": 30,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 100,
    "damage_type" : "割伤"
  ]),
  (["name"  : HIM"「梅雪争春」"NOR,
    "action": "$N一招「梅雪争春」，$w大开大阖，自上而下划出一个大弧，笔直劈向$n",
    "damage": 40,
    "dodge" : 0,
    "parry" : 0,
    "lvl"   : 120,
    "damage_type" : "割伤"
  ]),
  (["name"  : HIM"「阴风怒号」"NOR,
    "action": "$N手中$w一沉，一招「阴风怒号」，双手持刃拦腰反切，砍向$n的胸口",
    "damage": 45,
    "dodge" : -5,
    "parry" : -5,
    "lvl"   : 150,
    "damage_type" : "割伤"
  ]),
  (["name"  : HIC"「雪海茫茫」"NOR,
    "action": "$N挥舞$w，使出一招「雪海茫茫」，上劈下撩，左挡右开，齐齐罩向$n",
    "damage": 50,
    "dodge" : -10,
    "parry" : -10,
    "lvl"   : 180,
    "damage_type" : "割伤"
  ]),
});
int valid_enable(string usage)
{
  return usage == "blade" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "大雪山")
    return notify_fail("雪山刀法是大雪山不传之密！\n");

  if( (int)me->query("max_force") < 50 )
    return notify_fail("你的内力修为不够深，雪山刀学了也没用。\n");
  if (!(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "blade" )
    return notify_fail("你必须先找一柄刀才能练习刀法。\n");
  if ((int)me->query_skill("blade",1) < (int)me->query_skill("xueshan-blade",1))
    return notify_fail("你的基本刀法不够，学不了雪山刀了！\n");

  if (me->query_skill("bingpo-blade",1))
    return notify_fail("你已经学会了冰魄寒刀，无需继续练习雪山刀法了！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  level = query_skill_lvl(me,"xueshan-blade",action);
  pfm_num = me->query_temp("XSB_perform");
  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if ((int)me->query("kee") < 50)
    return notify_fail("你气力不支，强练雪山刀有害无益。\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你内力不足，强练雪山刀有走火入魔的危险。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("xueshan-blade",1);
  if (level > action[i]["lvl"])
    return HIW"刀起千堆雪，刀落鬼神惊。\n"NOR;

  level = query_skill_lvl(me,"xueshan-blade",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习雪山刀！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
   return CLASS_D("xueshan") + "/xueshan-blade/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 20  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("xueshan-blade",1);
  level = query_skill_lvl(me,"xueshan-blade",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了雪山刀的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}