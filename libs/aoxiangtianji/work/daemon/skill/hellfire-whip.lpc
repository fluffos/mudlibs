   HIY"\n$N口中唱道：天界道，神仙道，金碧琉璃谁人造? "NOR,
   HIG"\n$N口中唱道：人界道，好了道，爱欲痴情谁忘了？"NOR,
   HIM"\n$N口中唱道：冥界道，负债道，辜罪刑罚谁还掉？"NOR,
   HIR"\n$N口中唱道：修罗道，杀戮道，斗战征伐谁最骁？"NOR,
   HIB"\n$N口中唱道：饿鬼道，无常道，卤肴羹炙谁吃到？"NOR,
   YEL"\n$N口中唱道：牲畜道，断欲道，猪狗牛马谁说好？"NOR
});

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习烈火鞭！\n");
  if( (int)me->query("max_force") < 1000 )
    return notify_fail("你的内力不够，没有办法学习烈火鞭。\n");

  if( !(ob = me->query_temp("weapon"))
     || (string)ob->query("skill_type") != "whip" )
    return notify_fail("你必须先找一根鞭子才能学习烈火鞭。\n");

  if ((int)me->query_skill("whip",1) < (int)me->query_skill("hellfire-whip",1))
    return notify_fail("你的基础鞭术太低了，无法学习轮回鞭！\n");
  if ((int)me->query_skill("hellfire-whip",1) < 10)
    return notify_fail("你还没有完成烈火鞭的演练(yanlian)，无法体会烈火鞭的精髓！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="whip" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int i, j, lunhui,level, pfm_num;
  mapping* m_actions;
  mapping temp_act;
  temp_act = allocate_mapping(6);
  temp_act["action"] = "";
  temp_act["damage"] = 0;
  temp_act["force"] = 0;
  temp_act["parry"] = 0;
  temp_act["dodge"] = 0;
  temp_act["damage_type"] = "刺伤";

  level = query_skill_lvl(me,"hellfire-whip",action);
  j = random(level+1);
  pfm_num = (int)me->query_temp("HELLB_perform");
  lunhui = (int)me->query_temp("HELL_lunhui");

  if(lunhui && (lunhui <= 6))
  {
    i = sizeof(action) - 6 ;
    i += random(6);
    temp_act["action"] = (string)liudao[lunhui - 1];
    temp_act["damage"] = (int)action[i]["damage"]*5/3;
    temp_act["force"] = (int)action[i]["force"]*5/3;
    temp_act["dodge"] = (int)action[i]["dodge"]-20;
    temp_act["parry"] = (int)action[i]["parry"]-20;
    temp_act["damage_type"] = (string)action[i]["damage_type"];
    return temp_act ;
  }

  if (pfm_num && (pfm_num < sizeof(action)))  //for perform, the first action will be avoided
  {
    temp_act["action"] = (string)action[pfm_num]["action"];
    temp_act["damage"] = (int)action[pfm_num]["damage"]*6/5;
    temp_act["force"] = (int)action[pfm_num]["force"]*6/5;
    temp_act["dodge"] = (int)action[pfm_num]["dodge"];
    temp_act["parry"] = (int)action[pfm_num]["parry"];
    temp_act["damage_type"] = (string)action[pfm_num]["damage_type"];
    return temp_act;
  }

  if(!me->query("skill_hellfire-whip") || random(4))
  {
    temp_act["action"] = (string)action[j]["action"];
    temp_act["damage"] = (int)action[j]["damage"];
    temp_act["force"] = (int)action[j]["force"];
    temp_act["dodge"] = (int)action[j]["dodge"];
    temp_act["parry"] = (int)action[j]["parry"];
    temp_act["damage_type"] = (string)action[j]["damage_type"];
    return temp_act;
  }

  else
  {
    m_actions=me->query("skill_hellfire-whip");
    return element_of(m_actions);
  }

  return action[0];
}

int practice_skill(object me)
{
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习烈火鞭！\n");

  if( (int)me->query("kee") < 150
   || (int)me->query("force") < 150 )
    return notify_fail("你的内力或气不够，没有办法练习烈火鞭。\n");
  me->receive_damage("kee", 80);
  me->add("force", -40);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("hellfire-whip",1);
  if (level > action[i]["lvl"])
    return RED"熊熊烈火，焚尔残躯。\n"NOR;

  level = query_skill_lvl(me,"hellfire-whip",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习烈火鞭！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("ghost") + "/hellfire-whip/" + func;
}

mixed hit_ob(object me, object victim, int damage)
{
  mapping foo;

  int lunhui, sk_spells;

  if (damage < 100)
    return 0;

  lunhui = (int)me->query_temp("HELL_lunhui");
  if (!lunhui)
    return 0;

  sk_spells = (int)me->query_skill("spells");
  if (sk_spells <= 100)
    return 0;

  if (!foo)
    foo = ([ ]);

  sk_spells = (sk_spells + random(sk_spells))/2;
  foo["damage"] = random(sk_spells);

  switch (lunhui)
  {
    case 1 :
      if (!victim->is_busy())
        victim->start_busy(2+random(3));
      foo["msg"] = HIY"\n天界美奂美仑，霞举虹飞入目，轻舞罗香侍鼻，丝竹声不绝于耳，$n陶醉于中而不知返。\n"NOR ;
      break;
    case 2:
      victim->receive_damage("sen",random(sk_spells*2)+1, me);
      foo["msg"] = HIG"\n$n想起人世间的殇情冷暖，悲欢离合，不觉黯然。\n"NOR;
      break;
    case 3:
      victim->add("mana",-random(sk_spells*2));
      if (victim->query("mana")<0)
        victim->set("mana",0);
      foo["msg"] = HIM"\n$n被阵阵撕心裂肺的叫喊声包围，吓得浑身直冒冷汗。\n"NOR;
      break;
    case 4:
      victim->add("force",-random(sk_spells*2));
      if (victim->query("force")<0)
        victim->set("force",0);
      foo["msg"] = HIR"\n$n被从四方赶至的修罗追杀，失措逃亡，精疲力竭。\n"NOR;
      break;
    case 5:
      victim->add("food",-random(sk_spells));
      victim->add("water",-random(sk_spells));
      if (victim->query("food")<0)
        victim->set("food",0);
      if (victim->query("water")<0)
        victim->set("water",0);
      foo["msg"] = HIB"\n$n看到饿鬼的样子感觉自己的喉咙也被勒成只有一条细缝不能进食。\n"NOR;
      break;
    default :
      if (!victim->is_busy())
        victim->start_busy(1+random(3));
      foo["msg"] = YEL"$n感叹牲畜的愚昧无知和可怜，不知不觉就耽误了行程。\n"NOR;
  }

  return foo;
}

mixed fail_hit(object me, object victim)
{
  int lunhui;

  lunhui = (int)me->query_temp("HELL_lunhui");
  if (!lunhui)
    return 0;

  switch (lunhui)
  {
    case 1:
      return HIC"$n不为欲仙欲圣的美景所惑，收紧心神，弹指间便离天界道而去。\n"NOR;
    case 2:
      return HIC"$n硬起心肠，无视身旁的是是非非，快步离开人界道。\n"NOR;
    case 3:
      return HIC"$n对惨号声不屑于顾，游弋之中胜似闲庭信步。\n"NOR;
    case 4:
      return HIC"$n对付修罗游刃有余，很快就杀出一条血路离开了。\n"NOR;
    case 5:
      return HIC"$n看到一大群饿鬼就远远的躲了开去。\n"NOR;
    case 6:
      return HIC"$n看中了一匹白马，跳上马背星夜兼程离开了牲畜界。\n"NOR;
  }

}

