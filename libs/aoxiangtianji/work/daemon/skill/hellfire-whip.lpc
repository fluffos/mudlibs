int get_ready(object me)
{
  return 1;
}

int get_finish(object me)
{
  if (me->query_spi() < 40)
  {
    tell_object(me, "你演练完毕，始终觉得身法不够灵动。\n");
    return 0;
  }

  if (me->query_con() < 35)
  {
    tell_object(me, "你演练完毕，感觉头脑发木，似乎灵性不够。\n");
    return 0;
  }

  if ((int)me->query_skill("force", 1) < 180)
  {
    tell_object(me, "你演练完毕，几乎虚脱，自己的内功水平看来还有待提高。\n");
    return 0;
  }

  if ((int)me->query_skill("kusang-stick", 1) < 180)
  {
    tell_object(me, "你演练完毕，发现自己的哭丧棒等级不够，无法有所突破。\n");
    return 0;
  }

  if ((int)me->query_skill("zhuihun-sword", 1) < 180)
  {
    tell_object(me, "你演练完毕，发现自己的追魂剑等级不够，无法有所突破。\n");
    return 0;
  }

  if ((int)me->query("max_force") < 2000)
  {
    tell_object(me, "你演练完毕，丹田提不起半点力来，看来应该继续锻炼内力。\n");
    return 0;
  }

  if (random(10) < 8)
  {
    tell_object(me, "你似乎有所领悟，或许再演练一次就能够大有收获。\n");
    return 0;
  }

  tell_object(me, HIY "你一气呵成，将烈火鞭演练了一遍，心中顿悟，通晓了烈火鞭"
                      "的奥妙精髓。\n" NOR);
  me->set("family/can_learn/hellfire",1);
  return 1;
}

mapping query_sub_skills()
{
  return sub_skills;
}

int query_finish_skill()
{
  return 10;
}

