int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "大雪山")
    return notify_fail("百鸟剑法是大雪山不传之密！\n");

  if( (int)me->query("max_force") < 500 )
    return notify_fail("你的内力修为不够深，百鸟剑法学了也没用。\n");
  if (!(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "sword" )
    return notify_fail("你必须先找一把剑才能练习剑法。\n");
  if ((int)me->query_skill("sword",1) < (int)me->query_skill("bainiao-sword",1))
    return notify_fail("你的基本剑法不够，学不了百鸟剑！\n");
  if ((int)me->query_skill("xiaoyaoyou",1) < 120 ||
      (int)me->query_skill("ningxue-force",1) < 120)
    return notify_fail("你的逍遥游或者冰谷凝血功的等级不够，练不了百鸟剑法！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;
  level = query_skill_lvl(me,"bainiao-sword",action);
  pfm_num = me->query_temp("BNS_perform");
  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 100
   || (int)me->query("force") < 100 )
    return notify_fail("你的内力或气不够，没有办法练习百鸟剑。\n");
  me->receive_damage("kee", 30);
  me->add("force", -15);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("bainiao-sword",1);
  if (level > action[i]["lvl"])
    return HIW"凤翔天地间，百鸟伴翱翔。\n"NOR;

  level = query_skill_lvl(me,"bainiao-sword",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习百鸟剑！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file( string action)
{
   return CLASS_D("xueshan") + "/bainiao-sword/" + action;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 10;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 15  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("bainiao-sword",1);
  level = query_skill_lvl(me,"bainiao-sword",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了百鸟剑的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

