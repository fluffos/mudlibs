int valid_enable(string usage)
{
  return (usage == "whip") || (usage == "parry");
}

int valid_learn(object me)
{
  object ob;
  if( (int)me->query("max_force") < 1000 )
    return notify_fail("你的内力不够，没有办法练无为拂尘，多练些内力再来吧。\n");
  if((string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("无为拂尘是方寸山三星洞不传之密！\n");
  if( !(ob = me->query_temp("weapon"))
  || (string)ob->query("skill_type") != "whip" )
    return notify_fail("你必须先找一根鞭子才能练无为拂尘。\n");
  if ((int)me->query_skill("whip",1) < (int)me->query_skill("wuwei-fuchen",1))
    return notify_fail("你的基础鞭术太低了，无法练习无为拂尘！\n");

  if ((int)me->query_skill("wuxiangforce",1) < 100)
    return notify_fail("你的小无象太低了，没有办法练习无为拂尘！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  level = (int)query_skill_lvl(me,"wuwei-fuchen",action);
  pfm_num = (int)me->query_temp("WWF_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
  {
    if ((int)me->query("max_force") < 1500 ||
        me->query_skill("wuwei-fuchen",1) < 150 ||
        random(2))
      return action[pfm_num];
    return element_of(pfm_action);
  }
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 50
    || (int)me->query("force") < 50 )
    return notify_fail("你的内力或气不够，没有办法练习无为拂尘。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string perform_action_file(string func)
{
  return CLASS_D("puti") + "/wuwei-fuchen/" + func;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("wuwei-fuchen",1);
  if (level > action[i]["lvl"])
    return HIY"有所为，有所不为。\n"NOR;

  level = query_skill_lvl(me,"wuwei-fuchen",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习无为拂尘！对%s这招有了进一步的了解！\n",sk_name);
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 102;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 5;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 12  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("wuwei-fuchen",1);
  level = query_skill_lvl(me,"wuwei-fuchen",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了无为拂尘的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

