int valid_learn(object me)
{
  if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
    return notify_fail("练菩提指必须空手。\n");
  if((string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("菩提指是方寸山三星洞不传之密！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
   int pfm_num, level;

   level = query_skill_lvl(me,"puti-zhi",action);
   pfm_num = me->query_temp("PTZ_perform");

   if (pfm_num && (pfm_num < sizeof(action)))
     return action[pfm_num];

  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if((string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("菩提指是方寸山三星洞不传之密！\n");
  if( (int)me->query("sen") < 30)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if( (int)me->query("kee") < 30 )
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if( (int)me->query("force") < 10 )
    return notify_fail("你的内力不够了。\n");
  me->receive_damage("sen", 20);
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("puti-zhi",1);
  if (level > action[i]["lvl"])
    return HIW"动掌由心，弹指惊魔。\n"NOR;

  level = query_skill_lvl(me,"puti-zhi",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习菩提指！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("puti") + "/puti-zhi/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 5;
}

mapping black_white_ness()
{
  return (["skill_level" : 190 ,
           "effect"      : 12  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("puti-zhi",1);
  level = query_skill_lvl(me,"puti-zhi",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了菩提指的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

