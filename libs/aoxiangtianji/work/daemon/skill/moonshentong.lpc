// moonshentong.c 【晚月神通】
inherit SKILL;
int valid_enable(string usage) { return usage=="spells"; }

int valid_learn(object me)
{
  if( (int)me->query_skill("spells", 1) < 10
   || (int)me->query_skill("spells", 1) <= (int)me->query_skill("moonshentong", 1) )
    return notify_fail("你的法术修为还不够高深，无法学习晚月神通。\n");

  if((string)me->query("family/family_name") != "月宫")
    return notify_fail("晚月神通是月宫不传之密！\n");
  return 1;
}

string cast_spell_file(string spell)
{
  return CLASS_D("moon") + "/moonshentong/" + spell;
}

string query_shuxing() {return "shui";}

int query_power_effect(object me)
{
  int force_skill ;
  int base_num, day_phase;
  object where;
  string weather, terrain;

  base_num = 100;
  day_phase = NATURE_D->query_current_day_phase();
  where = environment(me);
  if (objectp(where))
  {
    terrain = where->query_terrain();
    if (!terrain)
      terrain = where->query("terrain");
    if (!terrain)
      terrain = "land";
  }

  if ((day_phase == 0) || (day_phase > 4))
    base_num += 10;
  else
    base_num -= 5;

  weather = NATURE_D->query_weather();
  if (stringp(terrain) && terrain == "wood")
    base_num += 10;
  else if (stringp(terrain) && terrain == "snow")
    base_num += 8;
  else if (stringp(terrain) && terrain == "hill")
    base_num += 5;
  else if (stringp(terrain) && terrain == "muddy")
    base_num -= 10;
  else if (stringp(terrain) && terrain == "water")
    base_num -= 8;
  else if (stringp(terrain) && terrain == "sand")
    base_num -= 5;
  if (stringp(weather) && weather == "sun")
    base_num -= 8 ;
  else if (stringp(weather) && weather == "rain")
    base_num -= 3 ;
  else if (stringp(weather) && weather == "wind")
    base_num += 8;

  force_skill = (int)me->query_skill("moonshentong",1);
  if (force_skill < 150)
    return base_num;
  else if (force_skill < 250)
    return base_num + 5 ;
  return base_num + 10;
}

string type() { return "magic"; }

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int learn_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 15  ,
         ]);
}

