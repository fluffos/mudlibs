#include <ansi.h>
inherit SKILL;
mapping *action = ({
  (["name"  : HIM"「停车问路」"NOR,
    "action": "$N把手中$w抖开成千丝万缕，一招「停车问路」，反身一顿，向$n的$l抽去",
    "dodge" : 15,
    "parry" : 15,
    "damage": 20,
    "lvl"   : 0,
    "damage_type" : "抽伤"
  ]),
  (["name"  : HIY"「童子挂画」"NOR,
    "action": "$N一招「童子挂画」，左右腿虚点，$w一提一收，挥向$n的颈部",
    "dodge" : 10,
    "parry" : 10,
    "damage": 20,
    "lvl"   : 50,
    "damage_type" : "抽伤"
  ]),
  (["name"  : HIW"「推窗望月」"NOR,
    "action": "$N展身虚步，提腰跃落，一招「推窗望月」，手中$w先是一卷，然后拦腰横扫$n",
    "dodge" : 0,
    "parry" : 0,
    "damage": 20,
    "lvl"   : 100,
    "damage_type" : "抽伤"
  ]),
  (["name"  : HIB"「临溪观鱼」"NOR,
    "action": "$N手中$w往回一收，随即一招「临溪观鱼」，鞭稍刺向$n的胸口",
    "dodge" : -5,
    "parry" : -5,
    "damage": 30,
    "lvl"   : 120,
    "damage_type" : "刺伤"
  ]),
  (["name"  : HIY"「风送轻舟」"NOR,
    "action": "$N一招「风送轻舟」，左脚跃步落地，$w顺势往前，锐声击向$n的$l",
    "dodge" : -10,
    "parry" : -10,
    "damage": 40,
    "lvl"   : 150,
    "damage_type" : "割伤"
  ]),
  (["name"  : HIG"「川流不息」"NOR,
    "action": "$N盘身驻地，一招「川流不息」，挥出一片纷纷扬扬鞭影，向$n的全身笼罩去",
    "dodge" : -15,
    "parry" : -15,
    "damage": 50,
    "lvl"   : 180,
    "damage_type" : "割伤"
  ]),
});
string main_skill() { return "sanqing-fuchen"; }

int valid_enable(string usage)
{
  return usage == "whip" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "五庄观")
    return notify_fail("太玄鞭是五庄观不传之密！\n");
  if( (int)me->query("max_force") < 200 )
    return notify_fail("你的内力不够，没有办法练太玄鞭。\n");
  if( !(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "whip" )
    return notify_fail("你必须先找一把鞭子才能练鞭法。\n");
  if (me->query_skill("whip",1) < me->query_skill("taixuan-whip",1))
    return notify_fail("你的基础鞭术不够高，练不了太玄鞭！\n");

  if (me->query_skill("sanqing-wuchen",1))
    return notify_fail("你已经学会了三清拂尘，没有必要再单独练习太玄鞭！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;
  level = query_skill_lvl(me,"taixuan-whip",action);
  pfm_num = me->query_temp("TXW_perform");
  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 80
   || (int)me->query("force") < 80 )
    return notify_fail("你的内力或气不够，没有办法练习太玄鞭。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("taixuan-whip",1);
  if (level > action[i]["lvl"])
    return HIW"白首太玄，化刚为柔。\n"NOR;

  level = query_skill_lvl(me,"taixuan-whip",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习太玄鞭！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file( string action)
{
   return CLASS_D("zhenyuan") + "/taixuan-whip/" + action;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 15;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 20  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("taixuan-whip",1);
  level = query_skill_lvl(me,"taixuan-whip",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了太玄鞭的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}