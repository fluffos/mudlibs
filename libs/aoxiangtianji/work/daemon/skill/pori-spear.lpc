    "damage_type" : "刺伤"
  ]),
});
int valid_enable(string usage)
{
  return usage == "spear" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "大雪山")
    return notify_fail("破日枪是大雪山不传之密！\n");

  if( (int)me->query("max_force") < 50 )
    return notify_fail("你的内力修为不够深，破日枪学了也没用。\n");
  if (!(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "spear" )
    return notify_fail("你必须先找一把长枪才能练习枪法。\n");
  if ((int)me->query_skill("spear",1) < (int)me->query_skill("pori-spear",1))
    return notify_fail("你的基本枪法不够，学不了破日枪！\n");

  if (me->query_skill("fenghuang-spear",1))
    return notify_fail("你已经学会了凤凰枪，无需继续练习破日枪法了！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  level = query_skill_lvl(me,"pori-spear",action);
  pfm_num = me->query_temp("PRS_perform");
  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if ((int)me->query("kee") < 50)
    return notify_fail("你气力不支，强练破日枪有害无益。\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你内力不足，强练破日枪有走火入魔的危险。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("pori-spear",1);
  if (level > action[i]["lvl"])
    return HIW"虚空破日，抖展凤凰。\n"NOR;

  level = query_skill_lvl(me,"pori-spear",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习破日枪！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
   return CLASS_D("xueshan") + "/pori-spear/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 6;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("pori-spear",1);
  level = query_skill_lvl(me,"pori-spear",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了破日枪的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

