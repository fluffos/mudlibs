    "damage_type" : "刺伤"
  ]),
  (["name"  : HIW"「岁月轮转」"NOR,
    "action": "$N手中$w略一回撤，用了一招「岁月轮转」，直刺$n$l",
    "damage": 20,
    "dodge" : 5,
    "parry" : 10,
    "lvl"   : 50,
    "damage_type" : "刺伤"
  ]),
  (["name"  : HIG"「如梭似电」"NOR,
    "action": "$N收枪入怀，身形突的一弹，手中$w迎着$n抖展而开，这招称为「如梭似电」，飞电般直刺$n$l",
    "damage": 30,
    "dodge" : 0,
