int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习追魂剑！\n");
  if( (int)me->query("max_force") < 1500 )
    return notify_fail("你的内力不够，没有办法练追魂剑。\n");
  if( !(ob = me->query_temp("weapon"))
  ||      (string)ob->query("skill_type") != "sword" )
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  if (me->query_skill("duoming-sword",1) < 120)
    return notify_fail("你的夺命剑法太差了，学不了追魂剑法！\n");

  if ((int)me->query_skill("sword", 1) < (int)me->query_skill("zhuihun-sword",1))
    return notify_fail("你的基本剑法太差了，学不了追魂剑法！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num , level, i;
  string *msg1,*msg2;
  mapping temp_act;

  msg1 =
  ({
     HIB"$N手中$w"+HIB"连连挥舞，声东击西，虚虚实实，幻人耳目，变化古怪之极，$n不禁心下骇然！"NOR,
     HIB"$N手中$w"+HIB"越使越快，" + HIB"有如云卷雾涌，$n不由得目为之眩！"NOR,
     HIB"只见$N手上$w"+HIB"剑招变幻，犹如鬼魅，五花八门，层出不穷，$n觉眼前尽是一片剑光飞舞来去！"NOR,
  });

  msg2 =
  ({
     HIR"但见一点点鲜血从$w"+HIR"下溅了出来，$n腾挪闪跃，竭力招架，始终脱不出$N的剑光笼罩，\n鲜血渐渐在身周溅成了一个红圈，$N又已刺出一剑！"NOR,
     HIR"$N一剑既占先机，後着绵绵而至，一柄$w"+HIW"犹如灵蛇，颤动不绝，在$n的攻势中穿来插去，只逼得$n连连倒退！"NOR,
     HIR"$n中了一剑，大骇之下，急向後退，$N手中$w"+HIW"已如狂风骤雨般连攻，当真是兔起鹘落，变化快极！"NOR,
  });
  temp_act = allocate_mapping(6);
  temp_act["action"] = "";
  temp_act["damage"] = 0;
  temp_act["force"] = 0;
  temp_act["parry"] = 0;
  temp_act["dodge"] = 0;
  temp_act["damage_type"] = "刺伤";

  pfm_num = (int)me->query_temp("HELLJ_perform");
  level = (int)query_skill_lvl(me,"zhuihun-sword",action);
  i = random(level+1);

  if ((pfm_num>0) && (pfm_num < sizeof(action)))
  {
    if (me->query_temp("HELLJ_hit"))
    {
      temp_act["action"] = element_of(msg2);
      temp_act["damage"] = (int)action[pfm_num]["damage"]*4/3;
      temp_act["force"] = (int)action[pfm_num]["force"]*4/3;
      temp_act["dodge"] = (int)action[pfm_num]["dodge"]-15;
      temp_act["parry"] = (int)action[pfm_num]["parry"]-15;
      temp_act["damage_type"] = (string)action[pfm_num]["damage_type"];
      me->delete_temp("HELLJ_hit");
    }

    else
    {
      temp_act["action"] = element_of(msg1);
      temp_act["damage"] = (int)action[pfm_num]["damage"]*6/5;
      temp_act["force"] = (int)action[pfm_num]["force"]*6/5;
      temp_act["dodge"] = (int)action[pfm_num]["dodge"]-5;
      temp_act["parry"] = (int)action[pfm_num]["parry"]-5;
      temp_act["damage_type"] = (string)action[pfm_num]["damage_type"];
    }

    return temp_act;
  }

  temp_act["action"] = (string)action[i]["action"];
  temp_act["damage"] = (int)action[i]["damage"];
  temp_act["force"] = (int)action[i]["force"];
  temp_act["dodge"] = (int)action[i]["dodge"];
  temp_act["parry"] = (int)action[i]["parry"];
  temp_act["damage_type"] = (string)action[i]["damage_type"];
  return temp_act;
}

int practice_skill(object me)
{
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习追魂剑！\n");

   if( (int)me->query("kee") < 50
     || (int)me->query("force") < 50 )
     return notify_fail("你的内力或气不够，没有办法练习追魂剑。\n");

   me->receive_damage("kee", 30);
   me->add("force", -15);
   return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("zhuihun-sword",1);
  if (level > action[i]["lvl"])
    return RED"追魂夺命，夜夜惊魂。\n"NOR;

  level = query_skill_lvl(me,"zhuihun-sword",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习追魂剑！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("ghost") + "/zhuihun-sword/" + func;
}

mixed hit_ob(object me, object victim, int damage)
{
  if (damage < 100)
    return 0;

  if (me->query_temp("HELLJ_hit"))
  {
    victim->add("douzhi",-10);
    if (!victim->is_busy())
      victim->start_busy(2);
    me->delete_temp("HELLJ_hit");
    return HIR"\n$n" HIR"遭受重创，不由得肝胆俱裂，看着$N"
           HIR"疯狂而闪烁幽冷的双眼，一股寒意从心底冒了出来。\n\n"NOR;
  }

  if (me->query_temp("HELLJ_perform"))
    me->set_temp("HELLJ_hit",1);

  return 0;
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
  int dam;
  string msg;

  if (damage < 100)
    return 0;
  if (!me->query_temp("tick/yanluo"))
    return 0;
  if (random(3) == 1)
    return 0;
  if (!me->query_temp("HELLJ_perform"))
    return 0;
  msg = HIW"$N" HIW"猛然见$n狰狞凶恶，心底突得一颤，竟然有些畏惧了。\n"NOR;
  dam = me->query_skill("force")/3;
  dam += me->query_skill("sword")/2;;
  return (["msg" : msg,
           "damage" : -damage/2-random(damage),
         ]);
}

int expell_delete()
{
  return 1;
}

int query_effect_parry(object me, object victim)
{
  return 105;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 5;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 15  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("zhuihun-sword",1);
  level = query_skill_lvl(me,"zhuihun-sword",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了追魂剑的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

