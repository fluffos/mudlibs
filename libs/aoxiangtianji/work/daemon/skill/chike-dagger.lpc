int valid_enable(string usage)
{
  return usage == "dagger" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("「刺客匕」是无底洞不传之密！\n");
  if( (int)me->query("max_force") < 500 )
    return notify_fail("你的内力不够，没有办法练「刺客匕」。\n");
  if( !(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "dagger" )
    return notify_fail("你必须先找一把短兵器才能练「刺客匕」。\n");
  if (me->query_skill("dagger",1) < me->query_skill("chike-dagger",1))
    return notify_fail("你的短兵器运用不够熟练，练不了「刺客匕」！\n");
  if (me->query_skill("dodge",1) < me->query_skill("chike-dagger",1))
    return notify_fail("你的身法不够灵便，练不了「刺客匕」！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level, i;
  mapping temp_act;
  temp_act = allocate_mapping(6);
  temp_act["action"] = "";
  temp_act["damage"] = 0;
  temp_act["force"] = 0;
  temp_act["parry"] = 0;
  temp_act["dodge"] = 0;
  temp_act["damage_type"] = "刺伤";

  level = query_skill_lvl(me,"chike-dagger",action);
  pfm_num = me->query_temp("CKD_perform");
  if (pfm_num && pfm_num < sizeof(action))
  {
    temp_act["action"] = (string)action[pfm_num]["action"];
    if ((int)action[pfm_num]["damage"] < 0)
      action[pfm_num]["damage"] = 30;
    temp_act["damage"] = (int)action[pfm_num]["damage"]*4/3;
    if ((int)action[pfm_num]["force"] < 0)
      action[pfm_num]["force"] = 10;
    temp_act["force"] = (int)action[pfm_num]["force"]*6/5;
    temp_act["dodge"] = (int)action[pfm_num]["dodge"]-10;
    temp_act["parry"] = (int)action[pfm_num]["parry"]-10;
    temp_act["damage_type"] = (string)action[pfm_num]["damage_type"];
    return temp_act;
  }

  i = random(level+1);
  temp_act["action"] = (string)action[i]["action"];
  if ((int)action[i]["damage"] < 0)
    action[i]["damage"] = 30;
  temp_act["damage"] = (int)action[i]["damage"];
  if ((int)action[i]["force"] < 0)
    action[i]["force"] = 10;
  temp_act["force"] = (int)action[i]["force"];
  temp_act["dodge"] = (int)action[i]["dodge"];
  temp_act["parry"] = (int)action[i]["parry"];
  temp_act["damage_type"] = (string)action[i]["damage_type"];
  return temp_act;
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 200
   || (int)me->query("force") < 200 )
    return notify_fail("你的内力或气不够，没有办法练习「刺客匕」。\n");
  me->receive_damage("kee", 50);
  me->add("force", -50);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("jianwu",1);
  if (level > action[i]["lvl"])
    return HIW"潇潇易水，白虹贯日。\n"NOR;

  level = query_skill_lvl(me,"chike-dagger",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习「刺客匕」！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file( string action)
{
   return CLASS_D("wudidong") + "/chike-dagger/" + action;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 20  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("chike-dagger",1);
  level = query_skill_lvl(me,"chike-dagger",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了「刺客匕」的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }

}

mixed hit_ob(object me, object victim, int damage)
{
  int cps, cor, ap;

  if (damage < 100)
    return 0;

  cps = me->query_cps();
  cor = me->query_cor();

  ap = random(cps + cor);
  if (ap < 100)
    return 0;

  victim->receive_damage("kee",ap,me);
  victim->receive_wound("kee",ap,me);

  if (random(3) == 0)
  {
    if (!victim->is_busy())
      victim->start_busy(2);
    return HIY"$n" HIY"陡然被刺中，顿时呆立当场！\n"NOR;
  }

  return 0;
}

