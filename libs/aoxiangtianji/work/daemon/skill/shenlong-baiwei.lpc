#include <ansi.h>
inherit SKILL;
mapping action =
  (["name"   : HIM"「神龙摆尾」"NOR,
    "action" : "$N左掌护胸，右掌使一招「神龙摆尾」晃动着击向$n的$l",
    "dodge"  : 15,
    "parry"  : 20,
    "force"  : 110,
    "damage_type": "震伤"
  ]);
string main_skill()
{
  return "dragonfight";
}

int valid_enable(string usage)
{
  return usage == "unarmed";
}

int valid_learn(object me)
{
   if(me->query("family/family_name") != "东海龙宫")
     return notify_fail("非龙宫弟子不能用神龙摆尾！\n");
  if( (int)me->query_skill("unarmed",1) < (int)me->query_skill("shenlong-baiwei",1))
    return notify_fail("你的基本拳脚还不够精湛，无法领会更深层的神龙摆尾！\n");

  if( (int)me->query_skill("dragonforce",1) < (int)me->query_skill("shenlong-baiwei",1)/2)
    return notify_fail("你的龙神心法还不够精湛，无法领会更深层的神龙摆尾！\n");
  if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
    return notify_fail("练神龙摆尾必须空手。\n");
  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内力不够，无法练习拳法！\n");
  if (!me->query("family/can_learn/dragonfight4"))
    return notify_fail("没有师傅的允许，似乎没有办法学习或者练习这门技艺！\n");

  if (me->query_skill("dragonfight",1))
    return notify_fail("你已经学会了龙神搏击，无需再学习神龙摆尾！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  if (playerp(me))
    return action;
  return
  (["name"   : HIY"「神龙摆尾」"NOR,
    "action" : "$N左掌护胸，右掌使一招「神龙摆尾」晃动着击向$n的$l",
    "dodge"  : -10,
    "parry"  : -10,
    "force"  : 210,
    "damage_type": "震伤"
  ]);
}

int practice_skill(object me)
{
  if( (int)me->query("sen") < 200)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if( (int)me->query("kee") < 200 )
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if( (int)me->query("force") < 200 )
    return notify_fail("你的内力不够了。\n");
  me->receive_damage("kee", 60);
  me->receive_damage("sen", 60);
  me->add("force", -30);
  return 1;
}

string query_practice_msg(object me)
{
  return HIY"你依照所学练习神龙摆尾！\n"NOR;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
  if (userp(me) || damage_bonus < 150)
    return 0;
  victim->receive_wound("kee", (damage_bonus - 80) / 2, me);
  return random(2) ? HIR "只听$n" HIR "前胸「咔嚓」一声脆响，竟像是"
                         "肋骨断折的声音。\n" NOR:
                     HIR "$n" HIR "一声惨叫，胸前「咔嚓咔嚓」几声脆"
                         "响，口中鲜血狂喷。\n" NOR;
}

string perform_action_file(string func)
{
  return CLASS_D("dragon") + "/shenlong-baiwei/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 100 ,
           "effect"      : 20  ,
         ]);
}

