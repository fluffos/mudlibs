inherit SKILL;

mapping *action = ({
  (["action" : "$n轻轻一纵，使个「出淤泥而不染」，毫不费力地躲开了$N这一招。\n",
    "dodge_power"  : 5
  ]),
  (["action" : "$n几个错步，使出「映日荷花」，$N只觉得眼一花，顿失$n的踪影。\n",
    "dodge_power"  : 8
  ]),
  (["action" : "$n一招「重重叠叠」，$N眼前出现了无数个$n，$N显然有点有力无处使。\n",
    "dodge_power"  : 10
  ]),
  (["action" : "$n双足一顿，一招「亭亭玉立」身体向上笔直地拔起，避了开去。\n",
    "dodge_power"  : 15
  ]),
  (["action" : "但是$n使一招「雨露滚莲」，身子向后飘开丈余，轻轻着地。\n",
    "dodge_power"  : 20
  ]),
  (["action" : "只见$n一式「无尽碧莲」拔地而起，在半空中转了数转，$N的攻势尽告落空。\n",
    "dodge_power"  : 25
  ])
});

mapping query_action(object me)
{
  int zhaoshu, level;

  zhaoshu = sizeof(action);
  level   = (int) me->query_skill("lotusmove",1);

  if (level < 180 )
    zhaoshu--;

  if (level < 150 )
    zhaoshu--;

  if (level < 120 )
    zhaoshu--;

  if (level < 80 )
    zhaoshu--;
  return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
  return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
  if((string)me->query("family/family_name") != "南海普陀山")
    return notify_fail("不是普陀山弟子，怎么可以学习莲花步呢？\n");
  if ((int)me->query_skill("dodge",1) < (int)me->query_skill("lotusmove",1))
    return notify_fail("你的基本轻功太低了！\n");

  return 1;
}

string query_dodge_msg(object me)
{
  mapping action;
  action = query_action(me);
  return action["action"];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 40 )
    return notify_fail("你的体力太差了，不能练莲花步。\n");
  me->receive_damage("kee", 30);
  return 1;
}

int query_effect_dodge(object me,object ob)
{
  string dodge_skill ;

  dodge_skill = ob->query_skill_mapped("dodge");
  if (!stringp(dodge_skill))
    return 130;

  switch (dodge_skill)
  {
    case "moshenbu" :
    case "xiaoyaoyou"  :
      return 120 ;
    case "dragonstep" :
    case "lingfu-steps" :
      return 80;
    default :
      return 100 ;
  }

  return 100;
}

int query_terrain(string terrain)
{
  switch (terrain)
  {
    case "hill" :
      return 3 ;
    case "wood" :
      return 1;
    case "snow" :
    case "sand" :
      return -1;
    case "water" :
      return -3 ;
    default :
      return 0 ;
  }

  return 0;
}

string perform_action_file(string func)
{
  return CLASS_D("bonze") + "/lotusmove/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int learn_bonus()
{
  return 10;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 10  ,
         ]);
}

