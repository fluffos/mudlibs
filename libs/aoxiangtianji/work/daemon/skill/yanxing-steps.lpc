inherit SKILL;

mapping *action = ({
 ([	"action" : "$n一招「鸿雁双飞」，身影微动，避了开去。\n",
 	"dodge_power"  : 5,
 ]),
 ([	"action" : "$n左足一点，一招「边秋飞雁」腾空而起，避了开去。\n",
 	"dodge_power"  : 8,
 ]),
 ([	"action" : "只见$n身影一晃，一式「雁抹金河」，身子轻轻的从$N头顶飞过。\n",
 	"dodge_power"  : 10,
 ]),
 ([	"action" : "$n身影微动，已经藉一招「雁下芦洲」轻轻闪过。\n",
 	"dodge_power"  : 15,
 ]),
 ([	"action" : "只听$n长鸣一声，一招「胡雁哀鸣」，趁$N一发呆，身子轻轻飘了开去。\n",
 	"dodge_power"  : 20,
 ]),
 ([	"action" : "$n一招「暮雁南飞」，身子向后纵出数尺，闪了开去。\n",
 	"dodge_power"  : 25,
 ])
});

mapping query_action(object me)
{
  int zhaoshu, level;

  zhaoshu = sizeof(action);
  level   = (int)me->query_skill("yanxing-steps",1);

  if (level < 150 )
    zhaoshu--;

  if (level < 120 )
    zhaoshu--;

  if (level < 80 )
    zhaoshu--;

  return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
   return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
  if(me->query("family/family_name") != "将军府")
    return notify_fail("你不是将军府的弟子，学习雁行步法有什么用呢？\n");;

  if ((int)me->query_skill("dodge",1) < (int)me->query_skill("yanxing-steps",1))
    return notify_fail("你的基本轻功太低了！\n");
  return 1;
}

string query_dodge_msg(object me)
{
   mapping action;
   action = query_action(me);
   return action["action"];
}

int practice_skill(object me)
{
   if( (int)me->query("kee") < 40 )
     return notify_fail("你的体力太差了，不能练雁行步法。\n");
   me->receive_damage("kee", 30);
   return 1;
}

int query_effect_dodge(object me,object ob)
{
  string dodge_skill ;

  dodge_skill = ob->query_skill_mapped("dodge");
  if (!dodge_skill)
    return 130;
  switch (dodge_skill)
  {
    case "moondance" :
    case "lotusmove" :
      return 120;
    case "moshenbu" :
    case "xiaoyaoyou" :
      return 80;
    default :
      return 100;
  }

  return 100;
}

int query_terrain(string terrain)
{
  switch (terrain)
  {
    case "snow" :
      return -1 ;
    case "muddy" :
      return -2 ;
    case "wood" :
      return 1 ;
    case "water" :
      return -1 ;
    case "hill" :
      return -1 ;
    case "land" :
    case "sand" :
      return 2;
    default :
      return 0 ;
  }

  return 0;
}
string perform_action_file(string func)
{
  return CLASS_D("fighter") + "/yanxing-steps/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 10  ,
         ]);
}

