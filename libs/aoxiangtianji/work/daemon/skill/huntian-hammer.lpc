int valid_learn(object me)
{
  object ob;
  if( (string)me->query("family/family_name")!="东海龙宫")
    return notify_fail("你非龙宫门人，怎么可以学习混天锤？\n");
  if (me->query("class") != "dragon")
    return notify_fail("你非龙族，怎么可以学习混天锤？\n");
  if( (int)me->query("max_force") < 500 )
    return notify_fail("你的内力不够，没有办法练混天锤。\n");
  if( !(ob = me->query_temp("weapon"))
  ||      (string)ob->query("skill_type") != "hammer" )
    return notify_fail("你必须先找一柄大锤才能练混天锤。\n");
  if ((int)me->query_skill("hammer",1) < (int)me->query_skill("huntian-hammer",1))
    return notify_fail("你的基本锤法太差了，无法练习混天锤！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="hammer" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;

  level = query_skill_lvl(me,"huntian-hammer",action);
  pfm_num = me->query_temp("HTH_perform");
  if(pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];

  return action[random(level+1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 150
  ||      (int)me->query("force") < 150 )
    return notify_fail("你的内力或气不够，没有办法练习混天锤。\n");
  me->receive_damage("kee", 30);
  me->add("force", -30);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("huntian-hammer",1);
  if (level > action[i]["lvl"])
    return HIC"\n锤惊鬼神，混沌天地！\n"NOR;

  level = query_skill_lvl(me,"huntian-hammer",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习混天锤！对%s有了进一步的了解！\n",sk_name);
}

string perform_action_file(string action)
{
  return CLASS_D("dragon") + "/huntian-hammer/" + action;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 20  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("huntian-hammer",1);
  level = query_skill_lvl(me,"huntian-hammer",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了混天锤的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

