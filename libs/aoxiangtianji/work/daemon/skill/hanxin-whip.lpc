#include <ansi.h>
inherit SKILL;
mapping *action = ({
  (["name"   : HIW"「含泪问梅」"NOR,
    "action" : "$N纵身跃起手中$w轻挥，一招「含泪问梅」，扫向$n后颈",
    "damage" : 20,
    "parry"  : 10,
    "dodge"  : 10,
    "lvl"    : 0,
    "damage_type" : "鞭伤"
  ]),
  (["name"   : HIW"「梅香无语」"NOR,
    "action" : "$N手中$w连抖三个弧形，一招「梅香无语」，向$n$l直抽过去",
    "damage" : 30,
    "parry"  : 5,
    "dodge"  : 5,
    "lvl"    : 50,
    "damage_type" : "刺伤"
  ]),
  (["name"   : HIY"「月影踟蹰」"NOR,
    "action" : "$N轻吁一声，飞身一跃而起，一招「月影踟蹰」，连续向$n洒出数鞭",
    "damage" : 40,
    "parry"  : -5,
    "dodge"  : -5,
    "lvl"    : 100,
    "damage_type" : "刺伤"
  ]),
  (["name"   : HIR"「情丝难断」"NOR,
    "action" : "$N仰天一声清啸，斜行向前，一招「情丝难断」，$w挥出无数圆圈，绕向$n",
    "damage" : 50,
    "parry"  : -10,
    "dodge"  : -10,
    "lvl"    : 150,
    "damage_type" : "割伤"
  ]),
});
string main_skill() { return "jueqing-whip"; }

int valid_enable(string usage)
{
  return usage == "whip" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "月宫")
    return notify_fail("寒心鞭乃月宫不传之密！\n");

  if( (string)me->query("gender") !="女性")
    return notify_fail("寒心鞭只有女子才能学习!!\n");

  if( (int)me->query("max_force") < 50 )
    return notify_fail("你的内力不够，没有办法练寒心鞭。\n");
  if( (string)me->query_skill_mapped("force")!= "moonforce")
    return notify_fail("寒心鞭必须配合昆仑山玉女峰的圆月心法才能练。\n");
  if( !(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "whip" )
    return notify_fail("你必须先找一根鞭子才能练鞭法。\n");
  if ((int)me->query_skill("whip",1) < (int)me->query_skill("hanxin-whip",1))
    return notify_fail("你的基本鞭法太差了，无法练习寒心鞭！\n");
  if ((int)me->query_skill("jueqingbian",1))
    return notify_fail("你已经学会了绝情鞭法，没有必要再学习寒心鞭了！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;
  level = query_skill_lvl(me,"hanxin-whip",action);
  pfm_num = (int)me->query_temp("HXW_perform");
  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if(me->query("family/family_name") != "月宫")
    return notify_fail("寒心鞭乃月宫不传之密！\n");

  if( (int)me->query("kee") < 50
   || (int)me->query("force") < 50 )
    return notify_fail("你的内力或气不够，没有办法练习寒心鞭。\n");

  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("hanxin-whip",1);
  if (level > action[i]["lvl"])
    return HIW"独孤问花花无语，月下影徘徊。\n"NOR;

  level = query_skill_lvl(me,"hanxin-whip",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习寒心鞭！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("moon") + "/hanxin-whip/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("hanxin-whip",1);
  level = query_skill_lvl(me,"hanxin-whip",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了寒心鞭的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}