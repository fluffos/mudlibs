int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习大力棒！\n");
  if( (int)me->query("max_force") < 800 )
    return notify_fail("你的内力不够，没有办法练大力棒。\n");
  if( !(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "stick" )
    return notify_fail("你必须先找一根棒子才能练大力棒。\n");
  if ((int)me->query_skill("huomoforce",1) < 120)
    return notify_fail("你的火魔心法等级不够，无法自如运用大力棒！\n");
  if( (string)me->query_skill_mapped("force")!= "huomoforce")
    return notify_fail("大力棒必须配合火魔心法才能练。\n");
  if ((int)me->query_skill("stick",1) < (int)me->query_skill("dali-stick",1))
    return notify_fail("你的基本棍法太低了，无法练习大力棒！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="stick" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level,i;
  mapping temp_act;

  temp_act = allocate_mapping(6);
  temp_act["action"] = "";
  temp_act["damage"] = 0;
  temp_act["force"] = 0;
  temp_act["parry"] = 0;
  temp_act["dodge"] = 0;
  temp_act["damage_type"] = "砸伤";

  level = query_skill_lvl(me,"dali-stick",action);
  pfm_num = me->query_temp("DLS_perform");
  i = random(level+1);

  if (pfm_num && (pfm_num < sizeof(action)))
  {
    temp_act["action"] = (string)action[pfm_num]["action"];
    temp_act["damage"] = (int)action[pfm_num]["damage"]*6/5;
    temp_act["force"] = (int)action[pfm_num]["force"]*6/5;
    temp_act["dodge"] = (int)action[pfm_num]["dodge"];
    temp_act["parry"] = (int)action[pfm_num]["parry"];
    temp_act["damage_type"] = (string)action[pfm_num]["damage_type"];
    return temp_act;
  }

  temp_act["action"] = (string)action[i]["action"];
  temp_act["damage"] = (int)action[i]["damage"];
  temp_act["force"] = (int)action[i]["force"];
  temp_act["dodge"] = (int)action[i]["dodge"];
  temp_act["parry"] = (int)action[i]["parry"];
  temp_act["damage_type"] = (string)action[i]["damage_type"];
  return temp_act;
}

int practice_skill(object me)
{
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习大力棒！\n");

  if( (int)me->query("kee") < 100
   || (int)me->query("force") < 100 )
    return notify_fail("你的内力或气不够，没有办法练习大力棒。\n");

  me->receive_damage("kee", 40);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("dali-stick",1);
  if (level > action[i]["lvl"])
    return RED"力敌天地，神佛奈何。\n"NOR;

  level = query_skill_lvl(me,"dali-stick",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习大力棒！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("kusong") + "/dali-stick/"+func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int learn_bonus()
{
  return 6;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 8  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("dali-stick",1);
  level = query_skill_lvl(me,"dali-stick",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了大力棒的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

