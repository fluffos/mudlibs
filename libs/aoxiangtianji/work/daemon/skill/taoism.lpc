inherit SKILL;
string type() { return "magic"; }

int valid_enable(string usage) { return usage=="spells"; }

int valid_learn(object me)
{
  if( (int)me->query_skill("spells", 1) < 20
    || (int)me->query_skill("spells") <= (int)me->query_skill("taoism") )
    return notify_fail("你的基本法术等级不够，无法继续学习天师道术！\n");
  return 1;
}

string query_shuxing() {return "mu";}

int query_power_effect(object me)
{
  return 100;
}

int learn_bonus()
{
  return 10;
}

mapping black_white_ness()
{
  return (["skill_level" : 120 ,
           "effect"      : 20  ,
         ]);
}

