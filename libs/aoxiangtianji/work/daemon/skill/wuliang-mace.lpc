int valid_learn(object me)
{
  object ob;

  if(me->query("family/family_name")!="东海龙宫")
    return notify_fail("你不是东海龙宫的弟子，没有办法理解无量锏。\n");
  if( (int)me->query("max_force") < 500 )
    return notify_fail("你的内力不够，没有办法练无量锏。\n");
  if( !(ob = me->query_temp("weapon"))
  ||      (string)ob->query("skill_type") != "mace" )
    return notify_fail("你必须先找一柄锏才能练无量锏。\n");
  if ((int)me->query_skill("mace",1) < (int)me->query_skill("wuliang-mace",1))
    return notify_fail("你的基本锏法太低了，无法练习无量锏！\n");

  if ((int)me->query_skill("dragonforce",1) < 100)
    return notify_fail("你的龙神心法太低了！这样去学无量锏是没有什么用的！\n");

  return 1;
}

int valid_enable(string usage)
{
  return usage=="mace" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;

  level = query_skill_lvl(me,"wuliang-mace",action);
  pfm_num = me->query_temp("WLM_perform");
  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 100
    || (int)me->query("force") < 100 )
    return notify_fail("你的内力或气不够，没有办法练习无量锏。\n");

  me->receive_damage("kee", 40);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("wuliang-mace",1);
  if (level > action[i]["lvl"])
    return WHT"大海无量，海底风波。\n"NOR;

  level = query_skill_lvl(me,"wuliang-mace",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习无量锏！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("dragon") + "/wuliang-mace/" + func;
}

int expell_delete()
{
  return 1;
}

int query_effect_parry(object me, object victim)
{
  return 105;
}

int learn_bonus()
{
  return 10;
}

int practice_bonus()
{
  return 6;
}

mapping black_white_ness()
{
  return (["skill_level" : 160 ,
           "effect"      : 20  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("wuliang-mace",1);
  level = query_skill_lvl(me,"wuliang-mace",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了无量锏的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

