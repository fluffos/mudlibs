string main_skill() { return "fencheng-spear"; }

mapping sub_skills = ([
        "huoyun-spear"   : 180,        // 1
        "lieyan-spear"   : 180,        // 2
]);
int get_ready(object me)
{
  return 1;
}

int get_finish(object me)
{
  if (me->query_con() < 40)
  {
    tell_object(me, "你演练完毕，始终觉得内力运转不够灵活。\n");
    return 0;
  }

  if (me->query_str() < 35)
  {
    tell_object(me, "你演练完毕，感觉似乎力道不够。\n");
    return 0;
  }

  if ((int)me->query_skill("force", 1) < 180)
  {
    tell_object(me, "你演练完毕，几乎虚脱，自己的内功水平看来还有待提高。\n");
    return 0;
  }

  if ((int)me->query("max_force") < 2000)
  {
    tell_object(me, "你演练完毕，丹田提不起半点力来，看来应该继续锻炼内力。\n");
    return 0;
  }

  if (random(10) < 8)
  {
    tell_object(me, "你似乎有所领悟，或许再演练一次就能够大有收获。\n");
    return 0;
  }

  tell_object(me, HIY "你一气呵成，将焚城枪演练了一遍，心中顿悟，通晓了焚城枪"
                      "的奥妙精髓。\n" NOR);
  me->set("family/can_learn/fencheng-spear",1);
  return 1;
}

mapping query_sub_skills()
{
  return sub_skills;
}

int query_finish_skill()
{
  return 10;
}

int valid_learn(object me)
{
  object ob;

  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习焚城枪！\n");

  if( (int)me->query("max_force") < 2200 )
    return notify_fail("你的内力不够，没有办法练焚城枪。\n");

  if( !(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "spear" )
    return notify_fail("你必须先找一柄枪才能练枪法。\n");

  if ((int)me->query_skill("spear",1) < (int)me->query("fencheng-spear",1))
    return notify_fail("你的基本枪法太差了，无法练习焚城枪！\n");
  if (!me->query("family/can_learn/fencheng-spear"))
    return notify_fail("你还没有演练(yanlian)焚城枪法，无法学习或者练习！\n");
  return 1;
}

int valid_enable(string usage)
{
  return (usage=="spear") || (usage=="parry");
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level,i;
  mapping temp_act;
  mapping* m_actions;

  temp_act = allocate_mapping(6);
  temp_act["action"] = "";
  temp_act["damage"] = 0;
  temp_act["force"] = 0;
  temp_act["parry"] = 0;
  temp_act["dodge"] = 0;
  temp_act["damage_type"] = "刺伤";

  level = query_skill_lvl(me,"fencheng-spear",action);
  pfm_num = me->query_temp("FCS_perform");
  i = random(level+1);

  if (pfm_num && (pfm_num < sizeof(action)))
  {
    temp_act["action"] = (string)action[pfm_num]["action"];
    temp_act["damage"] = (int)action[pfm_num]["damage"]*6/5;
    temp_act["force"] = (int)action[pfm_num]["force"]*6/5;
    temp_act["dodge"] = (int)action[pfm_num]["dodge"]-10;
    temp_act["parry"] = (int)action[pfm_num]["parry"]-10;
    temp_act["damage_type"] = (string)action[pfm_num]["damage_type"];
    return temp_act;
  }

  if(!me->query("skill_fencheng-spear") || random(4))
  {
    temp_act["action"] = (string)action[i]["action"];
    temp_act["damage"] = (int)action[i]["damage"];
    temp_act["force"] = (int)action[i]["force"];
    temp_act["dodge"] = (int)action[i]["dodge"];
    temp_act["parry"] = (int)action[i]["parry"];
    temp_act["damage_type"] = (string)action[i]["damage_type"];
    return temp_act;
  }

  else
  {
    m_actions=me->query("skill_fencheng-spear");
    return element_of(m_actions);
  }

  return action[0];
}

int practice_skill(object me)
{
  object weapon;
  if( (string)me->query_skill_mapped("force")!= "huomoforce")
    return notify_fail("五岳神枪必须配合火魔心法才能练。\n");
  if( !objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "spear" )
    return notify_fail("你必须先找一柄长枪或者是类似的武器，才能练枪法。\n");
  if( (int)me->query("kee") < 200
   || (int)me->query("force") < 200  )
    return notify_fail("你的体力不够练这门枪法，还是先休息休息吧。\n");
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习焚城枪！\n");
  me->receive_damage("kee", 50);
  me->add("force", -25);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("fencheng-spear",1);
  if (level > action[i]["lvl"])
    return RED"烈焰飞腾，烧他个干干净净。\n"NOR;

  level = query_skill_lvl(me,"fencheng-spear",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习焚城枪！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("kusong") + "/fencheng-spear/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 110;
}

int effective_parry_level()
{
  return 110;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 10  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("fencheng-spear",1);
  level = query_skill_lvl(me,"fencheng-spear",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了焚城枪的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
  if(m_skill>action[i]["lvl"] && m_skill%10==0)
  {
    tell_object(me,HIW"你对焚城枪的领悟加深了，你的焚城枪进入了一个新的境界！\n"NOR);
    if(me->query("zichuang/times")>7)
    {
      tell_object(me,HIW"然而你的功夫已经练至顶峰，不能再创出新招了。\n"NOR);
      return;
    }

    if(random(me->query("kar"))<20)
    {
      tell_object(me,HIW"然而你的心中居然产生了一种失落感！\n"NOR);
      return;
    }

    if((random(me->query("int")/2)+(int)me->query_skill("literate")/50)<10)
    {
      tell_object(me,HIW"然而你的心中升起一种惆怅的感觉，仿佛有一丝重要的东西没有抓住。\n"NOR);
      return;
    }

    tell_object(me,HIW"你突然福至心灵，对焚城枪领悟出了一招新的用法！\n"NOR);
    tell_object(me,"请为这招取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
  }

  return;
}

void name_skill(object me, string arg)
{
  mapping* m_actions;
  mapping m_act=([]);
  int content, i=strlen(arg);
  string msg;
  int name_count;
  name_count = (int)me->query_temp("skill_name_count");
  m_actions=me->query("skill_fencheng-spear");
  if(!pointerp(m_actions))
    m_actions=({});
  content=me->query("str")+2*me->query_skill("unarmed",1)/10;
  m_act+=(["damage":content]);
  content=-me->query("spi");
  m_act+=(["dodge" :content]);
  content=-me->query("cps");
  m_act+=(["parry" :content]);
  content=me->query("con")+me->query_skill("force",1)/10;
  m_act+=(["force" :content]);
  m_act+=(["damage_type":"刺伤"]);
  if (!arg || arg=="")
  {
    tell_object(me,"请为你的新招式取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
    return;
  }

  else while(i--)
  {
    if( arg[i]<=' ' )
    {
      tell_object(me,"招式名字不能使用控制字元，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
        me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

    if(strsrch(arg, "  ") >= 0)
    {
      tell_object(me,"招式名字不能有空格，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
        tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
        me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

    if(  !is_chinese(arg[i..i]) )
    {
      tell_object(me,"请您用「中文」为你的新招式取名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

  }

  if (!valid_name(arg))
  {
    tell_object(me,"对不起，这种名字会造成其他人的困扰。请重新设定一个名字：");
      name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  if( (strlen(arg) < 4) || (strlen(arg) > 8 ) )
  {
    tell_object(me,"对不起，招式名字必须是 ４ 到 ８ 个中文字：");
    name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  m_act+=(["name":arg]);
  msg= element_of(skill_head)+BLINK+HIC"「"+arg+"」"NOR
                +element_of(skill_tail);
  m_act+=(["action":msg]);
  m_actions+=({m_act});
  me->set("skill_fencheng-spear",m_actions);
  me->add("zichuang/times",1);
  me->delete_temp("skill_name_count");
}

