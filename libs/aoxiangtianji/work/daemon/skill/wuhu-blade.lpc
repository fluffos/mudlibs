    (["name"  : "“饿虎扑食”",
      "action": "$N纵身跃在空中，有如饿虎扑食一般，手中$w借着下落之势，向$n当头劈下",
      "dodge" :	10,
      "parry" :	10,
      "damage":	20,
      "lvl"   : 0,
      "damage_type" : "劈伤"
    ]),
    (["name" : "“三人成虎”",
      "action":
"$N展开轻功在$n周围飞奔，疾跑中向$n砍去数刀。\n"
"$n只见三个人影，从三个不同的方向砍来，不由惊慌失措",
      "dodge" :	10,
      "parry" :	0,
      "damage":	30,
      "lvl"   : 50,
      "damage_type":  "砍伤"
    ]),
    (["name"   : "“狐假虎威”",
      "action" :
"$N一声巨吼，震得$n耳中回声不止。趁此机会，$N一刀削向$n的$l。\n"
"原来是五虎断门刀中的杀手「狐假虎威」",
      "dodge"  : 0,
      "parry"  : 0,
      "damage" : 40,
      "lvl"    : 100,
      "damage_type":  "割伤"
    ]),
    (["name"   : "“虎落平阳”",
      "action" :
"$N左掌护身，滚倒在地上，右手$w连连向$n的双脚削去",
      "dodge"  : -5,
      "parry"  : -5,
      "damage" : 40,
      "lvl"    : 150,
      "damage_type":  "劈伤"
    ]),
    (["name"   : "“骑虎难下”",
      "action" :
"$N站稳马步，运起浑身之力，逼入$w中，向$n发出雷霆一击！\n"
"这招「骑虎难下」名字虽然难听，招数果然有效",
      "dodge"  : 0,
      "parry"  : 0,
      "damage" : 50,
      "lvl"    : 200,
      "damage_type":  "劈伤"
    ]),
});

int valid_learn(object me)
{
  object ob;
  if( (int)me->query("max_force") < 150 )
    return notify_fail("你的内力不够，不能学五虎断门刀， 多练些内力再来吧。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "blade" )
   return notify_fail("你必须先找一把刀才能练刀法。\n");
  if ((int)me->query_skill("blade", 1) < (int)me->query_skill("wuhu-blade", 1))
    return notify_fail("你的基本刀法水平有限，无法领会更高深的五虎断门刀。\n");

  return 1;
}

int practice_skill(object me)
{
  if ((int)me->query("kee") < 30)
    return notify_fail("你的气太低，再练下去会有危险的！\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够，无法练习五虎断门刀。\n");
  me->receive_damage("kee", 15);
  me->add("force", -5);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("wuhu-blade",1);
  if (level > action[i]["lvl"])
    return RED"五虎断门，刀断五虎。\n"NOR;

  level = query_skill_lvl(me,"wuhu-blade",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习五虎断门刀！对%s这招有了进一步的了解！\n",sk_name);
}

int valid_enable(string usage)
{
  return usage=="blade"||usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  pfm_num = me->query_temp("WHB_perform");
  level = query_skill_lvl(me,"wuhu-blade",action);

  if(pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

string perform_action_file(string func)
{
  return CLASS_D("common") + "/wuhu-blade/" + func;
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("wuhu-blade",1);
  level = query_skill_lvl(me,"wuhu-blade",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了五虎断门刀的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
  if (m_skill > 120)
    if (!me->query("common/can_pfm/duanming"))
      me->set("common/can_pfm/duanming",1);
}

int learn_bonus()
{
  return 15;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

