#include <ansi.h>
inherit FORCE;
int valid_enable(string usage)
{
  return usage=="force";
}

int valid_learn(object me)
{
  if( (int)me->query_skill("force", 1) < 10
   || (int)me->query_skill("force", 1) <= (int)me->query_skill("huomoforce", 1) )
    return notify_fail("你的内功底子太差了，无法学习火魔心法．\n");

  if(me->query("family/family_name") != "火云洞")
    return notify_fail("[火魔心法]是的火云洞不传之密！\n");
  return 1;
}

int practice_skill(object me)
{
  return notify_fail("火魔心法只能用学的，或是从运用(exert)中增加熟练度。\n");
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
  if( damage_bonus < 100 )
    return 0;

  if( ((int)me->query_skill("huomoforce") > 120) && ((int)me->query("force") > 1500)
      && random(10)>8 )
  {
    victim->receive_wound("kee", damage_bonus,me);
    return HIR"$N" HIR"的火魔神功突的一转，$n" HIR"如受火炙！\n"NOR;
  }

  return 1;
}

mixed valid_damage(object ob,object me,int damage)
{
  int myforce,yourforce ;
  int skill_lev ;

  myforce = (int)me->query("force");
  yourforce = (int)ob->query("force");
  skill_lev = (int)me->query_skill("huomoforce");

  if (skill_lev > 150 )
  {
    if (random(3) == 1)
    {
      if (random(myforce + yourforce) > yourforce)
      {
        return (["msg" : HIY"$n" HIY"运起火魔心法，消解了部分的伤害！\n"NOR,
                 "damage" : -damage/3 - random(skill_lev),
               ]);
      }

      else if (random(myforce + yourforce) > yourforce*2/3)
      {
        return (["msg" : HIY"$n" HIY"运起火魔心法，消解了部分的伤害！\n"NOR,
                 "damage" : -damage/4 - random(skill_lev),
               ]);
      }

      else if (!random(2))
      {
        return (["msg" : HIY"$n" HIY"运起火魔心法，消解了部分的伤害！\n"NOR,
                 "damage" : -damage/5 - random(skill_lev),
               ]);
      }

    }

  }

  return 0;
}

int query_power_effect(object me)
{
  int force_skill ;

  force_skill = (int)me->query_skill("huomoforce",1);
  if (force_skill < 100)
    return 100;
  else if (force_skill < 200)
    return 110 ;
  else if (force_skill < 300)
    return 120;
  return 130;
}

string exert_function_file(string func)
{
  return CLASS_D("kusong") + "/huomoforce/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 108;
}

int learn_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 12  ,
         ]);
}

