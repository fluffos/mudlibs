string main_skill() { return "fenghuang-spear"; }

mapping sub_skills = ([
        "pori-spear"     : 180,        // 1
        "zhuiyun-spear"  : 180,        // 2
]);
int get_ready(object me)
{
  return 1;
}

int get_finish(object me)
{
  if (me->query_con() < 40)
  {
    tell_object(me, "你演练完毕，始终觉得在内力运转方面有点问题。\n");
    return 0;
  }

  if (me->query_spi() < 35)
  {
    tell_object(me, "你演练完毕，感觉头脑发木，似乎灵性不够。\n");
    return 0;
  }

  if ((int)me->query_skill("force", 1) < 180)
  {
    tell_object(me, "你演练完毕，几乎虚脱，自己的内功水平看来还有待提高。\n");
    return 0;
  }

  if ((int)me->query_skill("xiaoyaoyou", 1) < 180)
  {
    tell_object(me, "你演练完毕，感觉轻功方面有所欠缺。\n");
    return 0;
  }

  if ((int)me->query("max_force") < 2200)
  {
    tell_object(me, "你演练完毕，丹田提不起半点力来，看来应该继续锻炼内力。\n");
    return 0;
  }

  if (random(10) < 8)
  {
    tell_object(me, "你似乎有所领悟，或许再演练一次就能够大有收获。\n");
    return 0;
  }

  tell_object(me, HIY "你一气呵成，将凤凰枪演练了一遍，心中顿悟，通晓了凤凰枪"
                      "的奥妙精髓。\n" NOR);
  me->set("family/can_learn/fenghuang-spear",1);
  return 1;
}

mapping query_sub_skills()
{
  return sub_skills;
}

int query_finish_skill()
{
  return 10;
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name")!="大雪山")
    return notify_fail("你不是大雪山的弟子,没有办法练凤凰枪法.\n");

  if( (int)me->query("max_force") < 1500 )
    return notify_fail("你的内力不够,没有办法练凤凰枪法.\n");
  if( (string)me->query_skill_mapped("force") != "ningxue-force")
     return notify_fail("凤凰枪法必须配合冰谷凝血功才能练.\n");
  if( !(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "spear" )
    return notify_fail("你必须先找一把枪才能练枪法。\n");
  if (me->query_skill("spear",1) < me->query_skill("fenghuang-spear",1))
    return notify_fail("你的基础枪法太低了，无法练习凤凰枪！\n");
  if (!me->query("family/can_learn/fenghuang-spear"))
    return notify_fail("你还没有演练(yanlian)凤凰枪，无法练习。\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="spear" || usage=="parry" ;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;
  mapping* m_actions;

  level = query_skill_lvl(me,"fenghuang-spear",action);
  pfm_num = me->query_temp("FHS_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
  {
    return action[pfm_num];
  }

  if(me->query("skill_fenghuang-spear")==0 )
    return action[random(level + 1)];
  else if( random(4))
    return action[random(level + 1)];
  else
  {
    m_actions=me->query("skill_fenghuang-spear");
    return element_of(m_actions);
  }

  return action[0];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 150
   || (int)me->query("force") < 150 )
    return notify_fail("你的内力或气不够,没有办法练习凤凰枪法.\n");
  me->receive_damage("kee", 80);
  me->add("force", -40);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("fenghuang-spear",1);
  if (level > action[i]["lvl"])
    return HIC"你化身为凤凰，遨游于九霄。\n"NOR;

  level = query_skill_lvl(me,"fenghuang-spear",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习凤凰枪法！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string action)
{
  return CLASS_D("xueshan") + "/fenghuang-spear/" + action;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 10  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("fenghuang-spear",1);
  level = query_skill_lvl(me,"fenghuang-spear",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了凤凰枪法的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }

  if(m_skill>action[i]["lvl"] && m_skill%10==0)
  {
    tell_object(me,HIW"你对凤凰枪法的领悟加深了，你的凤凰枪法进入了一个新的境界！\n"NOR);
    if(me->query("zichuang/times")>7)
    {
      tell_object(me,HIW"然而你的功夫已经练至顶峰，不能再创出新招了。\n"NOR);
      return;
    }

    if(random(me->query("kar"))<20)
    {
      tell_object(me,HIW"然而你的心中居然产生了一种失落感！\n"NOR);
      return;
    }

    if((random(me->query("int")/2)+(int)me->query_skill("literate")/50)<10)
    {
      tell_object(me,HIW"然而你的心中升起一种惆怅的感觉，仿佛有一丝重要的东西没有抓住。\n"NOR);
      return;
    }

    tell_object(me,HIW"你突然福至心灵，对凤凰枪法领悟出了一招新的用法！\n"NOR);
    tell_object(me,"请为这招取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
  }

  return;
}

void name_skill(object me, string arg)
{
  mapping* m_actions;
  mapping m_act=([]);
  int content, i=strlen(arg);
  string msg;
  int name_count;

  name_count = me->query_temp("skill_name_count");
  m_actions=me->query("skill_fenghuang-spear");
  if(!pointerp(m_actions)) m_actions=({});
  content=me->query("str")+2*me->query_skill("unarmed",1)/10;
  m_act+=(["damage":content]);
  content=-me->query("spi");
  m_act+=(["dodge" :content]);
  content=-me->query("cps");
  m_act+=(["parry" :content]);
  content=me->query("con")+2*me->query_skill("force",1)/10;
  m_act+=(["force" :content]);
  m_act+=(["damage_type":"刺伤"]);
  if (!arg || arg=="")
  {
    tell_object(me,"请为你的新招式取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
    return;
  }

  else while(i--)
  {
    if( arg[i]<=' ' )
    {
      tell_object(me,"招式名字不能使用控制字元，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

    if(strsrch(arg, "  ") >= 0)
    {
      tell_object(me,"招式名字不能有空格，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

    if(  !is_chinese(arg[i..i]) )
    {
      tell_object(me,"请您用「中文」为你的新招式取名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

  }

  if (!valid_name(arg))
  {
    tell_object(me,"对不起，这种名字会造成其他人的困扰。请重新设定一个名字：");
      name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  if( (strlen(arg) < 4) || (strlen(arg) > 8 ) )
  {
    tell_object(me,"对不起，招式名字必须是 ４ 到 ８ 个中文字：");
    name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  m_act+=(["name":arg]);
  msg= element_of(skill_head)+BLINK+HIR"「"+arg+"」"NOR
                  +element_of(skill_tail);
  m_act+=(["action":msg]);
  m_actions+=({m_act});
  me->set("skill_fenghuang-spear",m_actions);
  me->add("zichuang/times",1);
  me->delete_temp("skill_name_count");
}

