int valid_enable(string usage)
{
  return usage == "sword" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习夺命剑！\n");
  if( (int)me->query("max_force") < 100 )
    return notify_fail("你的内力不够，没有办法练夺命剑。\n");
  if( !(ob = me->query_temp("weapon"))
  ||      (string)ob->query("skill_type") != "sword" )
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  if ((int)me->query_skill("sword", 1) < (int)me->query_skill("duoming-sword",1))
    return notify_fail("你的基本剑法太差了，学不了夺命剑法！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num , level;
  pfm_num = me->query_temp("DMS_perform");
  level = query_skill_lvl(me,"duoming-sword",action);

  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习夺命剑！\n");

  if( (int)me->query("kee") < 50
    || (int)me->query("force") < 50 )
    return notify_fail("你的内力或气不够，没有办法练习夺命剑。\n");

   me->receive_damage("kee", 15);
   me->add("force", -5);
   return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("duoming-sword",1);
  if (level > action[i]["lvl"])
    return RED"夺命穿心，死神一笑。\n"NOR;

  level = query_skill_lvl(me,"duoming-sword",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习夺命剑！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("ghost") + "/duoming-sword/" + func;
}

int expell_delete()
{
  return 1;
}

int query_effect_parry(object me, object victim)
{
  return 105;
}

int learn_bonus()
{
  return 15;
}

int practice_bonus()
{
  return 10;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 15  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("duoming-sword",1);
  level = query_skill_lvl(me,"duoming-sword",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了夺命剑的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

