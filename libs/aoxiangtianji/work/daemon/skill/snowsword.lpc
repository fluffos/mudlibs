string main_skill() { return "snowsword-sword"; }

mapping sub_skills = ([
        "huifeng-sword"  : 180,        // 1
        "wuxue-sword"    : 180,        // 2
        "zhemei-shou"    : 180,        // 3
]);
int get_ready(object me)
{
  return 1;
}

int get_finish(object me)
{
  if (me->query_dex() < 40)
  {
    tell_object(me, "你演练完毕，始终觉得身法不够灵动。\n");
    return 0;
  }

  if (me->query_spi() < 35)
  {
    tell_object(me, "你演练完毕，感觉头脑发木，似乎灵性不够。\n");
    return 0;
  }

  if ((int)me->query_skill("force", 1) < 180)
  {
    tell_object(me, "你演练完毕，几乎虚脱，自己的内功水平看来还有待提高。\n");
    return 0;
  }

  if ((int)me->query("max_force") < 2000)
  {
    tell_object(me, "你演练完毕，丹田提不起半点力来，看来应该继续锻炼内力。\n");
    return 0;
  }

  if (random(10) < 8)
  {
    tell_object(me, "你似乎有所领悟，或许再演练一次就能够大有收获。\n");
    return 0;
  }

  tell_object(me, HIY "你一气呵成，将风回雪舞剑演练了一遍，心中顿悟，通晓了风回雪舞"
                      "剑的奥妙精髓。\n" NOR);
  me->set("family/can_learn/snowsword",1);
  return 1;
}

mapping query_sub_skills()
{
  return sub_skills;
}

int query_finish_skill()
{
  return 10;
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "月宫")
    return notify_fail("风回雪舞剑乃月宫不传之密！\n");

  if( (string)me->query("gender") !="女性")
    return notify_fail("风回雪舞剑只有女子才能学习!!\n");

  if (!me->query("family/can_learn/snowsword"))
    return notify_fail("你还没有完成风回雪舞剑法的演练(yanlian)，无法学习或者练习这种剑法！\n");

  if( (int)me->query("max_force") < 2000 )
    return notify_fail("你的内力不够，没有办法练风回雪舞剑法。\n");
  if( (string)me->query_skill_mapped("force")!= "moonforce")
    return notify_fail("风回雪舞剑法必须配合昆仑山玉女峰的圆月心法才能练。\n");
  if( !(ob = me->query_temp("weapon"))
  ||      (string)ob->query("skill_type") != "sword" )
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  if (me->query_skill("sword",1) < me->query_skill("snowsword",1))
    return notify_fail("你的基本剑法太差了，无法联系风回雪舞剑法！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level,i;
  mapping temp_act;
  mapping* m_actions;

  temp_act = allocate_mapping(6);
  temp_act["action"] = "";
  temp_act["damage"] = 0;
  temp_act["force"] = 0;
  temp_act["parry"] = 0;
  temp_act["dodge"] = 0;
  temp_act["damage_type"] = "刺伤";

  level = query_skill_lvl(me,"snowsword",action);
  i = random(level+1);
  pfm_num = (int)me->query_temp("WX_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
  {
    temp_act["action"] = (string)action[pfm_num]["action"];
    temp_act["damage"] = (int)action[pfm_num]["damage"]*5/4;
    temp_act["force"] = (int)action[pfm_num]["force"]*5/4;
    temp_act["dodge"] = (int)action[pfm_num]["dodge"]-10;
    temp_act["parry"] = (int)action[pfm_num]["parry"]-10;
    temp_act["damage_type"] = (string)action[pfm_num]["damage_type"];
    return temp_act;
  }

  if(!me->query("skill_snowsword") || random(4))
  {
    temp_act["action"] = (string)action[i]["action"];
    temp_act["damage"] = (int)action[i]["damage"];
    temp_act["force"] = (int)action[i]["force"];
    temp_act["dodge"] = (int)action[i]["dodge"];
    temp_act["parry"] = (int)action[i]["parry"];
    temp_act["damage_type"] = (string)action[i]["damage_type"];
    return temp_act;
  }

  else
  {
    m_actions=me->query("skill_snowsword");
    return element_of(m_actions);
  }

  return action[0];
}

int practice_skill(object me)
{
  if(me->query("family/family_name") != "月宫")
    return notify_fail("风回雪舞剑乃月宫不传之密！\n");

  if( (int)me->query("kee") < 150
   || (int)me->query("force") < 150 )
    return notify_fail("你的内力或气不够，没有办法练习风回雪舞剑法。\n");

  me->receive_damage("kee", 40);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("snowsword",1);
  if (level > action[i]["lvl"])
    return HIW"风花雪月，暗香飘浮。\n"NOR;

  level = query_skill_lvl(me,"snowsword",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习风回雪舞剑法！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("moon") + "/snowsword/" + func;
}

