// buddhism.c
#include <ansi.h>
inherit SKILL;
int valid_enable(string usage)
{
  return usage=="spells";
}

int valid_learn(object me)
{
  if((string)me->query("family/family_name") != "南海普陀山")
    return notify_fail("大乘佛法是南海普陀山不传之密！\n");

  if((string)me->query("class") != "bonze")
    return notify_fail("大乘佛法只有出家之人才可以修习！\n");

  if ((int)me->query_skill("spells") < 50)
    return notify_fail("你的法术修为还不够高深，无法学习大乘佛法。\n");

  if( (int)me->query_skill("spells") <= (int)me->query_skill("buddhism") )
    return notify_fail("你的法术修为还不够高深，无法学习大乘佛法。\n");

  if( (int)me->query("bellicosity") > 100 )
    return notify_fail("你的杀气太重，无法修炼大乘佛法。\n");

  return 1;
}

string cast_spell_file(string spell)
{
  return CLASS_D("bonze") + "/buddhism/" + spell;
}

string query_shuxing() {return "mu";}

int query_power_effect(object me)
{
  int force_skill ;
  int base_num, day_phase;
  object where;
  string weather, terrain;

  base_num = 110;
  day_phase = (int)NATURE_D->query_current_day_phase();
  where = environment(me);
  if (objectp(where))
  {
    if (where->is_temple())
      base_num = base_num + 10;
    else if (where->is_ghost())
      base_num = base_num - 10;
    terrain = (string)where->query_terrain();
    if (!terrain)
      terrain = (string)where->query("terrain");
    if (!terrain)
      terrain = "land";
  }

  if ((day_phase == 0) || (day_phase > 4))
    base_num = base_num - 10;
  else
    base_num = base_num + 5;

  weather = (string)NATURE_D->query_weather();

  if (terrain == "wood")
    base_num = base_num + 10;
  else if (terrain == "water")
    base_num = base_num + 5;
  else if (terrain == "muddy")
    base_num = base_num - 10;
  else if (terrain == "sand")
    base_num = base_num - 5;
  if (weather == "sun")
    base_num = base_num + 10 ;
  else if (weather == "rain")
    base_num = base_num - 10 ;

  force_skill = (int)me->query_skill("buddhism",1);
  if (force_skill < 150)
    return base_num;
  else if (force_skill < 200)
    return base_num + 5 ;
  else if (force_skill < 300)
    return base_num + 8 ;
  return base_num + 10;
}

string type() { return "magic";}

mixed valid_damage(object ob,object me,int damage)
{
  int dam;

  if (damage < 100)
    return 0;
  if (me->query_temp("lianhua"))
  {
    dam = (int)me->query_temp("spell_apply");
    dam += random(100) + 1;
    if (damage > dam)
    {
      return (["msg" : HIW"$N" HIW"身后闪现朵朵白莲，消解了" HIW"$n" HIW"的部分伤害！\n"NOR,
               "damage" : -dam,
             ]);
    }

    else
    {
      return (["msg" : HIW"$N" HIW"身后闪现朵朵白莲，完全化解了" HIW"$n" HIW"的攻势！\n"NOR,
               "damage" : -damage,
             ]);
    }

  }

  return 0;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 120;
}

int learn_bonus()
{
  return 5;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 20  ,
         ]);
}

