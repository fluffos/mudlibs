int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "将军府")
    return notify_fail("夺命枪法乃将军府不传之密！\n");
  if( (int)me->query("max_force") < 1200 )
    return notify_fail("你的内力不够，没有办法练夺命枪法。\n");
  if ((int)me->query_skill("lengquan-force",1) < 120)
    return notify_fail("你的冷泉神功等级不够，无法自如运用夺命枪法！\n");
  if( !(ob = me->query_temp("weapon"))
     ||(string)ob->query("skill_type") != "spear" )
    return notify_fail("你必须先找一柄枪才能练枪法。\n");
  if ((int)me->query_skill("spear", 1) < (int)me->query_skill("duo-spear", 1))
    return notify_fail("你的基本枪法水平有限，无法领会更高深的夺命枪。\n");
  return 1;
}

int valid_enable(string usage)
{
  return (usage=="spear") || (usage=="parry");
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  pfm_num = (int)me->query_temp("DMQ_perform");
  level = query_skill_lvl(me,"duo-spear",action);

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  object weapon;
  if( !objectp(weapon = me->query_temp("weapon"))
     ||(string)weapon->query("skill_type") != "spear" )
    return notify_fail("你必须先找一柄长枪或者是类似的武器，才能练枪法。\n");
  if( (int)me->query("kee") < 50
    ||(int)me->query("force") < 50  )
    return notify_fail("你的体力不够练这门枪法，还是先休息休息吧。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("duo-spear",1);
  if (level > action[i]["lvl"])
    return RED"夺命枪，夺人魂。\n"NOR;

  level = query_skill_lvl(me,"duo-spear",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习夺命枪法！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("fighter") + "/duo-spear/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int query_effect_parry(object me, object victim)
{
  return 110;
}

int learn_bonus()
{
  return 10;
}

int practice_bonus()
{
  return 6;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 15  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("duo-spear",1);
  level = query_skill_lvl(me,"duo-spear",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了夺命枪的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

