string main_skill()
{
  return "kugu-blade";
}

int valid_enable(string usage)
{
  return usage == "blade" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("你不习惯血腥，学不了狂风刀！\n");

  if( (int)me->query("max_force") < 50 )
    return notify_fail("你的内力不够，不能学狂风刀，多练些内力再来吧。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "blade" )
    return notify_fail("你必须先找一把刀才能练刀法。\n");

  if ((int)me->query_skill("blade",1) < (int)me->query_skill("kuangfeng-blade",1))
    return notify_fail("你的基础刀法太差了，无法练习狂风刀法！\n");
  if ((int)me->query_skill("kugu-blade",1))
    return notify_fail("你已经学会了枯骨刀法，没有必要在单独练习狂风刀法了！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;
  level = query_skill_lvl(me,"kuangfeng-blade",action);
  pfm_num = me->query_temp("KFB_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
   return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if (me->query("kee") < 50)
    return notify_fail("你的体力不足，无法练狂风刀。\n");
  if (me->query("force") < 50)
    return notify_fail("你的内力太低，无法在纵跃的同时舞刀。\n");
  me->add("kee", -20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("kuangfeng-blade",1);
  if (level > action[i]["lvl"])
    return RED"狂风吹尽现枯骨。\n"NOR;

  level = query_skill_lvl(me,"kuangfeng-blade",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习狂风刀法！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("wudidong") + "/kuangfeng-blade/"+func;
}

int expell_delete()
{
  return 1;
}

int query_effect_parry(object me, object victim)
{
  return 105;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("kuangfeng-blade",1);
  level = query_skill_lvl(me,"kuangfeng-blade",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了狂风刀的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}