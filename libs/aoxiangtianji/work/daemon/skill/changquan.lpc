int valid_learn(object me)
{
  if(me->query("family/family_name") != "将军府")
    return notify_fail("长拳乃将军府不传之密！\n");
  if( me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练长拳必须空手。\n");
  if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("changquan", 1))
    return notify_fail("你的基本拳脚水平有限，无法领会更高深的长拳。\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  pfm_num = (int)me->query_temp("CQ_perform");
  level = query_skill_lvl(me,"changquan",action);

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("sen") < 30)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if( (int)me->query("kee") < 30 )
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if( (int)me->query("force") < 10 )
    return notify_fail("你的内力不够了。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("changquan",1);
  if (level > action[i]["lvl"])
    return RED"手是两扇门，全凭脚打人。\n"NOR;

  level = query_skill_lvl(me,"changquan",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习长拳！对%s有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
 return CLASS_D("fighter") + "/changquan/"+func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 6;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 15  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("changquan",1);
  level = query_skill_lvl(me,"changquan",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了长拳的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

