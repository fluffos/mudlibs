string main_skill() { return "hellfire-whip"; }

int valid_enable(string usage)
{
  return usage == "unarmed";
}

int valid_learn(object me)
{
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习幽冥指！\n");
  if ((int)me->query_skill("hellfire-whip",1))
    return notify_fail("你已将这种指法融入烈火鞭，不必再分开练习了。\n");
  if( me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练幽冥指必须空手。\n");
  if( (int)me->query("max_force") < 150 )
    return notify_fail("你的内力太弱，无法练幽冥指。\n");
  if (me->query_skill("unarmed",1) < me->query_skill("youming-zhi",1))
    return notify_fail("你的基本拳脚功夫太低了，没有办法练习幽冥指！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num,level;

  pfm_num = me->query_temp("YMZ_perform");
  level = query_skill_lvl(me,"youming-zhi",action);

  if(pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习幽冥指！\n");
  if ((int)me->query_skill("hellfire-whip",1))
    return notify_fail("你已将这种指法融入烈火鞭，不必再分开练习了。\n");
  if( (int)me->query("sen") < 40)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if( (int)me->query("kee") < 40 )
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if( (int)me->query("force") < 10 )
    return notify_fail("你的内力不够了。\n");

  me->receive_damage("kee", 40);
  me->receive_damage("sen", 40);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("youming-zhi",1);
  if (level > action[i]["lvl"])
    return HIW"幽冥指，指幽冥。\n"NOR;

  level = query_skill_lvl(me,"youming-zhi",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习幽冥指！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("ghost") + "/jinghun-zhang/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 6;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("youming-zhi",1);
  level = query_skill_lvl(me,"youming-zhi",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了幽冥指的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

