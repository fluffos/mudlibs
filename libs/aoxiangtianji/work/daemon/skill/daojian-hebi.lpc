string main_skill() { return "daojian-hebi"; }

mapping sub_skills = ([
        "qixiu-sword" : 250,
        "kugu-blade"  : 250,
]);
int get_ready(object me)
{
  return 1;
}

int get_finish(object me)
{
  object ob;
  if(me->query("family/family_name") != "陷空山无底洞")
  {
    tell_object(me,"你不习惯血腥，无法理解刀剑合壁的奥秘！\n");
    return 0;
  }

  if( ! (ob = me->query_temp("weapon"))
     || (string)ob->query("skill_type") != "sword"
      && (string)ob->query("skill_type") != "blade" )
  {
    tell_object(me, "你空手舞了半天，发现不拿把刀或是剑实在难以演练。\n");
    return 0;
  }

  if (me->query_int() < 45)
  {
    tell_object(me, "你演练完毕，只感剑法和刀法毫无牵连，看"
                    "来依你的悟性，无法将其合一。\n");
    return 0;
  }

  if (me->query_dex() < 40)
  {
    tell_object(me, "你演练完毕，只觉依自己的身法灵动性，根"
                    "本无法将二者合一。\n");
    return 0;
  }

  if ((int)me->query("max_force") < 4000)
  {
    tell_object(me, "你觉得自己真气不继，无法将七修剑法和枯骨刀法二者合一。\n");
    return 0;
  }

  if (random(30) < 25)
  {
    tell_object(me, "你觉得有所感悟，或许再演练一次就能融会"
                    "贯通，将二者合一。\n");
    return 0;
  }

  tell_object(me, HIY "\n霎那间，七修剑法和枯骨刀法交替着不断在你脑海里"
                      "闪现，终于融会贯通，合二为一。\n你终于通晓了刀剑"
                      "合壁的诀窍。\n" NOR);
  me->set("family/can_learn/daojian-hebi",1);
  return 1;
}

mapping query_sub_skills()
{
  return sub_skills;
}

int query_finish_skill()
{
  return 250;
}

int valid_enable(string usage)
{
  return usage == "sword" || usage == "blade" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("你不习惯血腥，无法理解刀剑合壁！\n");

  if( (int)me->query("max_force") < 4000 )
    return notify_fail("你的内力不够，不能学刀剑合壁，多练些内力再来吧。\n");
  if (!(ob = me->query_temp("weapon"))
    || ((string)ob->query("skill_type") != "blade" &&
       (string)ob->query("skill_type") != "sword") )
    return notify_fail("你必须先找一把刀或者剑才能练刀剑合壁。\n");

  if ((int)me->query_skill("blade",1) < (int)me->query_skill("daojian-hebi",1))
    return notify_fail("你的基础刀法太差了，无法练习刀剑合壁！\n");
  if ((int)me->query_skill("sword",1) < (int)me->query_skill("daojian-hebi",1))
    return notify_fail("你的基础剑法太差了，无法练习刀剑合壁！\n");
  if (!me->query("family/can_learn/daojian-hebi",1))
    return notify_fail("你还没有演练(yanlian)出刀剑合壁呢！\n");

  return 1;
}

int practice_skill(object me)
{
  if (me->query("kee") < 250)
    return notify_fail("你的体力不足，无法练枯骨刀。\n");
  if (me->query("sen") < 250)
    return notify_fail("你的精神不足，无法练枯骨刀。\n");
  if (me->query("force") < 250)
    return notify_fail("你的内力太低，无法在纵跃的同时舞刀。\n");
  me->add("kee", -100);
  me->add("sen", -100);
  me->add("force", -100);
  return 1;
}

mapping query_action(object me, object weapon)
{
  return element_of(action);
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
  if (damage_bonus < 250)
    return 0;
  if (damage_bonus / 3 < victim->query_dex())
    return 0;

  if (random(2) && me->query_temp("daojian-perform"))
  {
    victim->receive_wound("kee", (damage_bonus - 80) / 2, me);
    return random(2) ? HIR "只听「噗嗤」一声，一股鲜血至$n"
                       HIR "胸前射出。\n" NOR:
                       HIR "霎时只见寒光一闪，一柱鲜血至$n"
                       HIR "胸前射出。\n" NOR;
  }

  return 0;
}

string perform_action_file(string action)
{
  return CLASS_D("wudidong") + "/daojian-hebi/"+action;
}

int effective_level()
{
  return 105;
}

int effective_parry_level()
{
  return 110;
}

int query_effect_parry(object me, object victim)
{
  return 105;
}

int practice_bonus()
{
  return 2;
}

mapping black_white_ness()
{
  return (["skill_level" : 300 ,
           "effect"      : 8  ,
         ]);
}

