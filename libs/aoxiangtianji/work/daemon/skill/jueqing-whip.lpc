string main_skill() { return "jueqing-whip"; }

mapping sub_skills = ([
        "hanxin-whip"  : 150,        // 1
        "wenyue-whip"  : 150,        // 2
]);
int get_ready(object me)
{
  return 1;
}

int get_finish(object me)
{
  if (me->query_dex() < 40)
  {
    tell_object(me, "你演练完毕，始终觉得身法不够灵动。\n");
    return 0;
  }

  if (me->query_con() < 35)
  {
    tell_object(me, "你演练完毕，感觉内力运转似乎不够流畅。\n");
    return 0;
  }

  if ((int)me->query_skill("force", 1) < 150)
  {
    tell_object(me, "你演练完毕，几乎虚脱，自己的内功水平看来还有待提高。\n");
    return 0;
  }

  if ((int)me->query_skill("moondance", 1) < 150)
  {
    tell_object(me, "你演练完毕，总觉得身法不够灵便，自己的冷月凝香舞水平看来还有待提高。\n");
    return 0;
  }

  if ((int)me->query("max_force") < 2000)
  {
    tell_object(me, "你演练完毕，丹田提不起半点力来，看来应该继续锻炼内力。\n");
    return 0;
  }

  if (random(10) < 8)
  {
    tell_object(me, "你似乎有所领悟，或许再演练一次就能够大有收获。\n");
    return 0;
  }

  tell_object(me, HIY "你一气呵成，将绝情鞭演练了一遍，心中顿悟，通晓了绝情鞭"
                      "的奥妙精髓。\n" NOR);
  me->set("family/can_learn/jueqing-whip",1);
  return 1;
}

mapping query_sub_skills()
{
  return sub_skills;
}

int query_finish_skill()
{
  return 10;
}

int valid_enable(string usage)
{
  return usage == "whip" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;

  if(me->query("family/family_name") != "月宫")
    return notify_fail("绝情鞭乃月宫不传之密！\n");
  if( (string)me->query("gender") !="女性")
    return notify_fail("绝情鞭只有女子才能学习!!\n");
  if( !(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "whip" )
    return notify_fail("你必须先找一根鞭子才能练鞭法。\n");
  if ((int)me->query_skill("whip",1) < (int)me->query_skill("jueqing-whip",1))
    return notify_fail("你的基本鞭法太差了，无法练习绝情鞭！\n");
  if (!me->query("family/can_learn/jueqing-whip"))
    return notify_fail("绝情鞭法需要演练(yanlian)成功后才可以练习！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level,i;
  mapping temp_act;

  temp_act = allocate_mapping(6);
  temp_act["action"] = "";
  temp_act["damage"] = 0;
  temp_act["force"] = 0;
  temp_act["parry"] = 0;
  temp_act["dodge"] = 0;
  temp_act["damage_type"] = "刺伤";
  level = query_skill_lvl(me,"jueqing-whip",action);
  i = random(level+1);
  pfm_num = me->query_temp("JQW_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
  {
    temp_act["action"] = (string)action[pfm_num]["action"];
    temp_act["damage"] = (int)action[pfm_num]["damage"]*6/5;
    temp_act["force"] = (int)action[pfm_num]["force"]*6/5;
    temp_act["dodge"] = (int)action[pfm_num]["dodge"]-10;
    temp_act["parry"] = (int)action[pfm_num]["parry"]-10;
    temp_act["damage_type"] = (string)action[pfm_num]["damage_type"];
    return temp_act;
  }

  temp_act["action"] = (string)action[i]["action"];
  temp_act["damage"] = (int)action[i]["damage"];
  temp_act["force"] = (int)action[i]["force"];
  temp_act["dodge"] = (int)action[i]["dodge"];
  temp_act["parry"] = (int)action[i]["parry"];
  temp_act["damage_type"] = (string)action[i]["damage_type"];
  return temp_act;
}

int practice_skill(object me)
{
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon")) ||
      (string)(weapon->query("skill_type")) != "whip")
    return notify_fail("你这才想起手里没鞭子，怎么练绝情鞭啊？ :)\n");
  if ((int)(me->query("kee")) < 150)
    return notify_fail("你已经精疲力竭，没法儿练下去啦！\n");
  if ((int)(me->query("force")) < 150)
    return notify_fail("你的内力不够了，没法儿练下去啦！\n");

  me->receive_damage("kee", 50);
  me->add("force", -30);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("jueqing-whip",1);
  if (level > action[i]["lvl"])
    return HIB"你不禁一声长叹，“问世间，情为何物？直教人生死相许！”\n"NOR;

  level = query_skill_lvl(me,"jueqing-whip",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习绝情鞭！对%s这招有了进一步的了解！\n",sk_name);
}

mixed hit_ob(object me, object victim, int damage)
{
  if (damage < 100)
    return 0;

  if (me->query_temp("JQW_perform"))
  {
    victim->receive_damage("sen",damage/2,me);
    victim->receive_wound("sen",random(damage/2)+1,me);
    return HIG"\n阵阵透心的伤痛只钻$n" HIG"的心底，让$n"
           HIG"不由得有些神伤了！\n\n"NOR;
  }

  return 0;
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
  int dam;
  string msg;

  if (damage < 100)
    return 0;
  if (!me->query_temp("tick/jueqing"))
    return 0;
  if (random(3) == 1)
    return 0;
  if (!me->query_temp("JQW_perform"))
    return 0;
  msg = HIW"$N" HIW"但见$n眉目间神色凄苦，不知怎的，竟然无法忍心全力而为了。\n"NOR;
  dam = me->query_skill("force")/3;
  dam += me->query_skill("whip")/2;;
  return (["msg" : msg,
           "damage" : -damage/2-random(damage),
         ]);
}

string perform_action_file(string action)
{
  return CLASS_D("moon") + "/jueqing-whip/" + action;
}

int expell_delete()
{
  return 1;
}

int query_effect_parry(object me, object victim)
{
  return 105;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 10  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("jueqing-whip",1);
  level = query_skill_lvl(me,"jueqing-whip",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了绝情鞭的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

