inherit SKILL;

mapping *action = ({
 (["action" : "$n侧身一退，踏入左面的乾门，恰巧躲过了$N这一招。\n",
   "dodge_power"  : 5
 ]),
 (["action" : "可是$n身形一晃，突然之间转到了坤门，出现在$N的身后。\n",
   "dodge_power"  : 8
 ]),
 (["action" : "只见$n连着几个旋身，自坎而离，过兑门入震门，脚下一点立在了艮门。$N之攻势顿时化为乌有。\n",
   "dodge_power"  : 10
 ]),
 (["action" : "说时迟那时快，$n在千钧一发之际不退反进，扑入巽门之中，逃过了$N这一招。\n",
   "dodge_power"  : 12
 ]),
 (["action" : "$n就势一转，退入右侧坎门之中，远远地躲了开来。\n",
   "dodge_power"  : 28
 ]),
 (["action" : "$n哈哈大笑几声，一个跟头翻入兑门，轻轻将来势尽数化解。\n",
   "dodge_power"  : 20
 ]),
 (["action" : "但是$n轻轻一纵，顿时没了踪影。$N定睛一看，原来$n早躲到了离门之中。\n",
   "dodge_power"  : 25
 ]),
 (["action" : "$n身形斜飞，落入震门之中，毫不费力地化解了$N这一招。\n",
   "dodge_power"  : 30
 ])
});

mapping query_action(object me)
{
  int zhaoshu, level;

   zhaoshu = sizeof(action);
   level = (int) me->query_skill("baguazhen",1);

   if (level < 200 )
     zhaoshu--;

   if (level < 180 )
     zhaoshu--;

   if (level < 150 )
     zhaoshu--;
   if (level < 100 )
     zhaoshu--;
   if (level < 50 )
     zhaoshu--;
   return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
  return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
  if(me->query("family/family_name") != "五庄观")
    return notify_fail("八卦阵是五庄观不传之密！\n");
  if ((int)me->query_skill("dodge",1) < (int)me->query_skill("baguazhen",1))
    return notify_fail("你的基本轻功太低了！\n");

  return 1;
}

string query_dodge_msg(object me)
{
  mapping action;
  action = query_action(me);
  return action["action"];
}

int practice_skill(object me)
{
  if(me->query("family/family_name") != "五庄观")
    return notify_fail("八卦阵只有五庄观弟子才可以通过练习提高！\n");

  if( (int)me->query("kee") < 100 )
     return notify_fail("你的体力太差了，不能练八卦阵法。\n");
  me->receive_damage("kee", 40);
  return 1;
}

int query_effect_dodge(object me,object ob)
{
  string dodge_skill ;

  dodge_skill = ob->query_skill_mapped("dodge");
  if (!stringp(dodge_skill))
    return 130 ;
  switch (dodge_skill)
  {
    case "yanxing-steps" :
    case "jindouyun" :
      return 120 ;
    case "moondance" :
    case "lotusmove" :
      return 80;
    default :
      return 100 ;
  }

  return 100;
}

int query_terrain(string terrain)
{
  switch (terrain)
  {
    case "water" :
      return -4 ;
    case "hill" :
      return -2 ;
    case "snow" :
      return -1 ;
    case "sand" :
      return 1 ;
    case "muddy" :
      return 1;
    case "wood" :
      return 3 ;
    default :
      return 0 ;
  }

  return 0;
}
string perform_action_file(string func)
{
  return CLASS_D("zhenyuan") + "/baguazhen/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 10  ,
         ]);
}

 