string main_skill() { return "fencheng-spear"; }

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习火云枪！\n");
  if( (int)me->query("max_force") < 100 )
    return notify_fail("你的内力不够，没有办法练火云枪。\n");
  if( !(ob = me->query_temp("weapon"))
   ||  (string)ob->query("skill_type") != "spear" )
    return notify_fail("你必须先找一柄枪才能练枪法。\n");
  if ((int)me->query_skill("spear",1) < (int)me->query("huoyun-spear",1))
    return notify_fail("你的基本枪法太差了，无法练习火云枪！\n");
  if ((int)me->query_skill("fencheng-spear",1))
    return notify_fail("你已经学会了焚城枪法，没有必要单独练习火云枪了！\n");
  return 1;
}

int valid_enable(string usage)
{
  return (usage=="spear") || (usage=="parry");
}

mapping query_action(object me, object weapon)
{
  int pfm_num , level;

  level = query_skill_lvl(me,"huoyun-spear",action);
  pfm_num = me->query_temp("HYS_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  object weapon;
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习火云枪！\n");
  if( !objectp(weapon = me->query_temp("weapon"))
  ||      (string)weapon->query("skill_type") != "spear" )
    return notify_fail("你必须先找一柄长枪或者是类似的武器，才能练枪法。\n");
  if( (int)me->query("kee") < 50
  ||    (int)me->query("force") < 50  )
    return notify_fail("你的体力不够练这门枪法，还是先休息休息吧。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("huoyun-spear",1);
  if (level > action[i]["lvl"])
    return RED"吐雾遮三界,喷云照四方,一天杀气凶声吼,日月星辰不见光。\n"NOR;

  level = query_skill_lvl(me,"huoyun-spear",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习火云枪！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("kusong") + "/huoyun-spear/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 20  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("huoyun-spear",1);
  level = query_skill_lvl(me,"huoyun-spear",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了火云枪的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

