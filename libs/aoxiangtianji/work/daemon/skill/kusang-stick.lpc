int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习哭丧棒！\n");
  if( (int)me->query("max_force") < 1200 )
    return notify_fail("你的内力不够，没有办法练哭丧棒。\n");
  if( !(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "stick" )
    return notify_fail("你必须先找一根棒子才能练哭丧棒。\n");
  if ((int)me->query_skill("jueming-stick", 1) < 120)
    return notify_fail("你的绝命棒法太低了，练不了哭丧棒法！\n");

  if ((int)me->query_skill("stick",1) < (int)me->query_skill("kusang-stick",1))
    return notify_fail("你的基础棒法太差了，练不了哭丧棒法！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="stick" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level,i;
  mapping temp_act;

  temp_act = allocate_mapping(6);
  temp_act["action"] = "";
  temp_act["damage"] = 0;
  temp_act["force"] = 0;
  temp_act["parry"] = 0;
  temp_act["dodge"] = 0;
  temp_act["damage_type"] = "刺伤";
  level = query_skill_lvl(me,"kusang-stick",action);
  i = random(level+1);
  pfm_num = me->query_temp("HELLK_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
  {
    temp_act["action"] = (string)action[pfm_num]["action"];
    temp_act["damage"] = (int)action[pfm_num]["damage"]*6/5;
    temp_act["force"] = (int)action[pfm_num]["force"]*6/5;
    temp_act["dodge"] = (int)action[pfm_num]["dodge"]-10;
    temp_act["parry"] = (int)action[pfm_num]["parry"]-10;
    temp_act["damage_type"] = (string)action[pfm_num]["damage_type"];
    return temp_act;
  }

  temp_act["action"] = (string)action[i]["action"];
  temp_act["damage"] = (int)action[i]["damage"];
  temp_act["force"] = (int)action[i]["force"];
  temp_act["dodge"] = (int)action[i]["dodge"];
  temp_act["parry"] = (int)action[i]["parry"];
  temp_act["damage_type"] = (string)action[i]["damage_type"];
  return temp_act;
}

int practice_skill(object me)
{
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习哭丧棒！\n");

  if( (int)me->query("kee") < 100
    || (int)me->query("force") < 100 )
    return notify_fail("你的内力或气不够，没有办法练习哭丧棒。\n");
  me->receive_damage("kee", 30);
  me->add("force", -15);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("kusang-stick",1);
  if (level > action[i]["lvl"])
    return RED"棒打无情，命敲丧钟。\n"NOR;

  level = query_skill_lvl(me,"kusang-stick",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习哭丧棒！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("ghost") + "/kusang-stick/" + func;
}

int expell_delete()
{
  return 1;
}

int query_effect_parry(object me, object victim)
{
  return 110;
}

int learn_bonus()
{
  return 6;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 8  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("kusang-stick",1);
  level = query_skill_lvl(me,"kusang-stick",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了哭丧棒的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

