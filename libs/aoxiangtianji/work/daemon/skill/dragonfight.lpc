string main_skill() { return "dragonfight"; }

mapping sub_skills = ([
        "feilong-zaitian"  : 120,        // 1
        "qianlong-wuyong"  : 120,        // 2
        "shuanglong-qushui": 120,        // 3
        "longzhan-yuye"    : 120,        // 4
        "shenlong-baiwei"  : 120,        // 5
]);
int get_ready(object me)
{
  if (!me->query("family/can_learn/dragonfight1")
   || !me->query("family/can_learn/dragonfight2")
   || !me->query("family/can_learn/dragonfight3")
   || !me->query("family/can_learn/dragonfight4")
   || !me->query("family/can_learn/dragonfight5"))
    return 0;
  return 1;
}

int get_finish(object me)
{
  if (me->query_con() < 35)
  {
    tell_object(me, "你演练完毕，始终觉得内力的运转不是很理想。\n");
    return 0;
  }

  if (me->query_str() < 120)
  {
    tell_object(me, "你演练完毕，感觉力量似乎有所不够。\n");
    return 0;
  }

  if ((int)me->query_skill("force", 1) < 120)
  {
    tell_object(me, "你演练完毕，几乎虚脱，自己的内功水平看来还有待提高。\n");
    return 0;
  }

  if ((int)me->query("max_force") < 1600)
  {
    tell_object(me, "你演练完毕，丹田提不起半点力来，看来应该继续锻炼内力。\n");
    return 0;
  }

  if (random(10) < 8)
  {
    tell_object(me, "你似乎有所领悟，或许再演练一次就能够大有收获。\n");
    return 0;
  }

  tell_object(me, HIY "你一气呵成，将龙神搏击演练了一遍，心中顿悟，通晓了龙神搏击"
                      "的奥妙精髓。\n" NOR);
  me->set("family/can_learn/dragonfight",1);
  me->delete("family/can_learn/dragonfight1");
  me->delete("family/can_learn/dragonfight2");
  me->delete("family/can_learn/dragonfight3");
  me->delete("family/can_learn/dragonfight4");
  me->delete("family/can_learn/dragonfight5");
  return 1;
}

mapping query_sub_skills()
{
  return sub_skills;
}

int query_finish_skill()
{
  return 10;
}

int valid_learn(object me)
{
   if(me->query("family/family_name")!="东海龙宫")
     return notify_fail("非龙宫弟子不能用龙形搏击！\n");
  if( (int)me->query_skill("unarmed",1) < (int)me->query_skill("dragonfight",1))
    return notify_fail("你的基本拳脚还不够精湛，无法领会更深层的龙形搏击！\n");

  if( (int)me->query_skill("dragonforce",1) < (int)me->query_skill("dragonfight",1)/2)
    return notify_fail("你的龙神心法还不够精湛，无法领会更深层的龙形搏击！\n");
  if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
    return notify_fail("练龙形博击必须空手。\n");
  if (!me->query("family/can_learn/dragonfight"))
    return notify_fail("你必须先演练(yanlian)成功后，才可以学习或练习龙神搏击！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="unarmed";
}

int practice_skill(object me)
{
   if(me->query("family/family_name")!="东海龙宫")
     return notify_fail("非龙宫弟子不能用龙形搏击！\n");
  if( (int)me->query_skill("unarmed",1) < (int)me->query_skill("dragonfight",1))
    return notify_fail("你的基本拳脚还不够精湛，无法领会更深层的龙形搏击！\n");

  if( (int)me->query_skill("dragonforce",1) < (int)me->query_skill("dragonfight",1)/2)
    return notify_fail("你的龙神心法还不够精湛，无法领会更深层的龙形搏击！\n");
  if( (int)me->query("sen") < 200)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if( (int)me->query("kee") < 200 )
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if( (int)me->query("force") < 200 )
    return notify_fail("你的内力不够了。\n");
  me->receive_damage("kee", 50);
  me->add("force", -30);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("dragonfight",1);
  if (level > action[i]["lvl"])
    return HIY"\n你化身为龙，在云端间开始演练龙形搏击！\n"NOR;

  level = query_skill_lvl(me,"dragonfight",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习龙形搏击！对%s有了进一步的了解！\n",sk_name);
}

mapping query_action(object me, object weapon)
{
  int pfm_num,level;
  mapping* m_actions;

  level = query_skill_lvl(me,"dragonfight",action);
  pfm_num = me->query_temp("LBJ_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];

  if(me->query("skill_dragonfight")==0)
    return action[random(level + 1)];
  else if(random(4))
    return action[random(level + 1)];
  else
  {
    m_actions=me->query("skill_dragonfight");
    return element_of(m_actions);
  }

  return action[0];
}

string perform_action_file(string func)
{
  return CLASS_D("dragon") + "/dragonfight/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
  if( damage_bonus < 100 ) return 0;
  if( random(damage_bonus/2) > victim->query_str()/5)
  {
    if (random(3) == 0)
    {
      victim->receive_wound("kee", damage_bonus / 2 );
      switch(random(3))
      {
         case 0: return HIB"你听到「喀啦」一声轻响，竟似是骨碎的声音！\n"NOR;
         case 1: return HIB"$N劲力一吐，$n的胸骨发出「喀」地一声爆响！\n"NOR;
         case 2: return HIB"只听见$n的双臂「喀」地一声 ...\n"NOR;
      }

    }

  }

}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 120;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 15  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("dragonfight",1);
  level = query_skill_lvl(me,"dragonfight",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了龙形搏击的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
  if(m_skill>action[i]["lvl"] && m_skill%10==0)
  {
    tell_object(me,HIW"你对龙形搏击的领悟加深了，你的龙形搏击进入了一个新的境界！\n"NOR);
    if(me->query("zichuang/times")>7)
    {
      tell_object(me,HIW"然而你的功夫已经练至顶峰，不能再创出新招了。\n"NOR);
      return;
    }

    if(random(me->query("kar"))<20)
    {
      tell_object(me,HIW"然而你的心中居然产生了一种失落感！\n"NOR);
      return;
    }

    if((random(me->query("int")/2)+(int)me->query_skill("literate")/50)<10)
    {
      tell_object(me,HIW"然而你的心中升起一种惆怅的感觉，仿佛有一丝重要的东西没有抓住。\n"NOR);
      return;
    }

    tell_object(me,HIW"你突然福至心灵，对龙形搏击领悟出了一招新的用法！\n"NOR);
    tell_object(me,"请为这招取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
  }

  return;
}

void name_skill(object me, string arg)
{
  mapping* m_actions;
  mapping m_act=([]);
  int content, i=strlen(arg);
  string msg;
  int name_count;

  name_count = me->query_temp("skill_name_count");
  m_actions=me->query("skill_dragonfight");
  if(!pointerp(m_actions)) m_actions=({});
  content=me->query("str")+me->query_skill("unarmed",1)/5;
  m_act+=(["damage":content]);
  content=-me->query("spi");
  m_act+=(["dodge" :content]);
  content=-me->query("cps");
  m_act+=(["parry" :content]);
  content=me->query("con")+me->query_skill("force",1)/2;
  m_act+=(["force" :content]);
  m_act+=(["damage_type":"瘀伤"]);
  if (!arg || arg=="")
  {
    tell_object(me,"请为你的新招式取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
    return;
  }

  else while(i--)
  {
    if( arg[i]<=' ' )
    {
      tell_object(me,"招式名字不能使用控制字元，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

    if(strsrch(arg, "  ") >= 0)
    {
      tell_object(me,"招式名字不能有空格，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

    if(  !is_chinese(arg[i..i]) )
    {
      tell_object(me,"请您用「中文」为你的新招式取名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

  }

  if (!valid_name(arg))
  {
    tell_object(me,"对不起，这种名字会造成其他人的困扰。请重新设定一个名字：");
      name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  if( (strlen(arg) < 4) || (strlen(arg) > 8 ) )
  {
    tell_object(me,"对不起，招式名字必须是 ４ 到 ８ 个中文字：");
    name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  m_act+=(["name":arg]);
  msg= element_of(skill_head)+BLINK+HIC"「"+arg+"」"NOR+element_of(skill_tail);
  m_act+=(["action":msg]);
  m_actions+=({m_act});
  me->set("skill_dragonfight",m_actions);
  me->add("zichuang/times",1);
  me->delete_temp("skill_name_count");
}

