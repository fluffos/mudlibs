int valid_learn(object me)
{
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习惊魂掌！\n");
  if( me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练惊魂掌必须空手。\n");
  if( (int)me->query("max_force") < 50 )
    return notify_fail("你的内力太弱，无法练惊魂掌。\n");
  if (me->query_skill("unarmed",1) < me->query_skill("jinghun-zhang",1))
    return notify_fail("你的基本拳脚功夫太低了，没有办法练习惊魂掌！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
  int pfm_num,level;

  pfm_num = me->query_temp("HELLZ_perform");
  level = query_skill_lvl(me,"jinghun-zhang",action);

  if(pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习惊魂掌！\n");

  if( (int)me->query("sen") < 40)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if( (int)me->query("kee") < 40 )
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if( (int)me->query("force") < 10 )
    return notify_fail("你的内力不够了。\n");

  me->receive_damage("kee", 10);
  me->receive_damage("sen", 10);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("jinghun-zhang",1);
  if (level > action[i]["lvl"])
    return RED"恶鬼讨债，小鬼惊魂。\n"NOR;

  level = query_skill_lvl(me,"jinghun-zhang",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习惊魂掌！对%s这招有了进一步的了解！\n",sk_name);
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
  if( damage_bonus < 100 ) return 0;
  if( random(damage_bonus/2) > victim->query_str() )
  {
    victim->receive_wound("kee", random(damage_bonus)+1, me);
    switch(random(3))
    {
       case 0: return "你听到「喀啦」一声轻响，竟似是骨碎的声音！\n";
       case 1: return "$N劲力一吐，$n的胸骨发出「喀」地一声爆响！\n";
       case 2: return "只听见$n的双臂「喀」地一声 ...\n";
    }

  }

}

string perform_action_file(string func)
{
  return CLASS_D("ghost") + "/jinghun-zhang/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 10  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("jinghun-zhang",1);
  level = query_skill_lvl(me,"jinghun-zhang",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了惊魂掌的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

