inherit SKILL;

mapping *action = ({
  (["action" : "$n身形一缩，一招「夜遇苍鹰」，身形朝暗处遁去。\n",
    "dodge_power"  : 5
  ]),
  (["action" : "$N正要击中$n之时，忽然只见$n以极快的身法向后退去，\n",
    "dodge_power"  : 5
  ]),
  (["action" : "霎时间已经不见踪影。原来是救命绝招「蝠去无踪」。\n",
    "dodge_power"  : 8
  ]),
  (["action" : "但是$n似乎早已觉出不对，在$N发招之前就已以「笨鸟先飞」高跃避之。\n",
    "dodge_power"  : 10
  ]),
  (["action" : "$N的凌厉攻势似乎以把$n逼入一个死角。$n一咬牙，不退反进，\n",
    "dodge_power"  : 15
  ]),
  (["action" : "一招「灵蝠出洞」，果然奏效，挡开了$N。\n",
    "dodge_power"  : 20
  ]),
  (["action" : "$n身形一闪，似欲向右避去。$N正待追击，只见$n已经向左跃开。\n",
    "dodge_power"  : 25
  ]),
  (["action" : "好一招「良禽择木」！把$N闹的狼狈不堪。\n",
    "dodge_power"  : 30
  ])
});

mapping query_action(object me)
{
  int zhaoshu, level;

  zhaoshu = sizeof(action);
  level   = (int) me->query_skill("lingfu-steps",1);

  if (level < 250 )
    zhaoshu--;

  if (level < 200 )
    zhaoshu--;

  if (level < 150 )
    zhaoshu--;
  if (level < 100 )
    zhaoshu--;
  if (level < 50 )
    zhaoshu--;
  return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
  return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
  if(me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("灵蝠五式只有陷空山无底洞弟子才可以学习！\n");

  if ((int)me->query_skill("dodge",1) < (int)me->query_skill("lingfu-steps",1))
    return notify_fail("你的基本轻功太低了！\n");

  return 1;
}

string query_dodge_msg(object me)
{
  mapping action;
  action = query_action(me);
  return action["action"];
}

int practice_skill(object me)
{
  if(me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("灵蝠五式只有陷空山无底洞弟子才可以通过练习提高！\n");

  if( (int)me->query("kee") < 40 )
    return notify_fail("你的体力太差了，不能练灵蝠五式。\n");
  me->receive_damage("kee", 30);
  return 1;
}

int query_effect_dodge(object me,object ob)
{
  string dodge_skill ;

  dodge_skill = ob->query_skill_mapped("dodge");
  if (!stringp(dodge_skill))
    return 130;

  switch (dodge_skill)
  {
    case "baguazhen" :
    case "lingfu-steps" :
      return 120 ;
    case "jindouyun" :
    case "yanxing-steps" :
      return 80;
    default :
      return 100 ;
  }

  return 100;
}

int query_terrain(string terrain)
{
  switch (terrain)
  {
    case "muddy":
      return 4;
    case "sand":
      return 2;
    case "wood":
      return 1;
    case "water":
      return -1;
    case "hill":
      return -2;
    case "snow":
      return -3;
    default :
      return 0;
  }

  return 0;
}

string perform_action_file(string func)
{
  return CLASS_D("wudidong") + "/lingfu-steps/"+func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 10  ,
         ]);
}

 