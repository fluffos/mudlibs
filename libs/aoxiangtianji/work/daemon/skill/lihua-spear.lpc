  (["name"  : HIG"「梨花开」"NOR,
    "action":
"$N抖起$w，一招"+HIG"「梨花开」"NOR"刺向$n$l",
    "damage": 15,
    "dodge" : 15,
    "parry" : 15,
    "lvl"   : 0,
    "damage_type":  "刺伤"
  ]),
  (["name"  : MAG"「梨花落」"NOR,
    "action":
"$N使个"+MAG"「梨花落」"NOR"，从侧面突出一枪，径刺$n$l",
    "damage": 20,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 50,
    "damage_type":  "刺伤"
  ]),
  (["name"  : HIB"「梨花若雪」"NOR,
    "action":
"$N手中$w舞了两夺枪花，虚实变换中刺向$n的$l。\n这一招"+HIB"「梨花若雪」"NOR"确实难防。",
    "force" : 10,
    "damage": 20,
    "dodge" : 5,
    "parry" : 5,
    "lvl"   : 100,
    "damage_type":  "刺伤"
