  (["name"  : HIC"「梨花纷扬」"NOR,
    "action":
"$N借助身形的转动，使一招"+HIC"「梨花纷扬」"NOR"，手中$w如漫天飞扬的杨花，刺向$n的$l",
    "force" : 10,
    "damage": 30,
