  ]),
  (["name"  : HIR"「花开花落」"NOR,
    "action":
"只见$N一个跳跃，使个"+HIR"「花开花落」"NOR"，手中$w由上而下疾刺$n$l",
    "force" : 20,
    "damage": 40,
    "dodge" :  -10,
    "parry" :  -10,
    "lvl"   :  200,
