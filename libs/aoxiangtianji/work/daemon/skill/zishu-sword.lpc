int valid_learn(object me)
{
  object ob;

  if (me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("你还未习惯血腥，无法学子鼠剑。\n");
  if ((int)me->query("max_force") < 50)
    return notify_fail("你的真气不足，难以领悟剑法的精妙之处。\n");

  if (!(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "sword" )
     return notify_fail("你必须先找一把剑才能练剑法。\n");

  if ((int)me->query_skill("sword",1) < (int)me->query_skill("zishu-sword",1))
    return notify_fail("你的基础剑术太低了，无法练习子鼠剑法！\n");

//  if ((int)me->query_skill("qixiu-sword",1))
//    return notify_fail("你已经学会了七修剑法，没有必要在去练习子鼠剑法了！\n")
  return 1;
}

int valid_enable(string usage)
{
  return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;
  pfm_num = (int)me->query_temp("ZSS_perform");
  level = query_skill_lvl(me,"zishu-sword",action);

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];

  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if (me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("你还未习惯血腥，无法练子鼠剑。\n");

  if ((int)me->query("kee") < 50)
    return notify_fail("你的气太低，再练下去会有危险的！\n");

  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够，没有办法运用子鼠剑。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("zishu-sword",1);
  if (level > action[i]["lvl"])
    return RED"穿墙打洞，子鼠为尊。\n"NOR;

  level = query_skill_lvl(me,"zishu-sword",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习子鼠剑法！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string action)
{
  return CLASS_D("wudidong") + "/zishu-sword/" + action;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 15;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 20  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("zishu-sword",1);
  level = query_skill_lvl(me,"zishu-sword",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了子鼠剑的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

