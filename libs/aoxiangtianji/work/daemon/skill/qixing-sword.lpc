string main_skill() { return "sanqing-fuchen"; }

int valid_enable(string usage)
{
  return usage == "sword" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "五庄观")
    return notify_fail("七星剑法是五庄观不传之密！\n");
  if( (int)me->query("max_force") < 100 )
    return notify_fail("你的内力不够，没有办法练七星剑法。\n");
  if( !(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "sword" )
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  if (me->query_skill("sword",1) < me->query_skill("qixing-sword",1))
    return notify_fail("你的基础剑术不够高，练不了七星剑法！\n");

  if (me->query_skill("sanqing-wuchen",1))
    return notify_fail("你已经学会了三清拂尘，没有必要再单独练习七星剑法！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;
  level = query_skill_lvl(me,"qixing-sword",action);
  pfm_num = me->query_temp("QXS_perform");
  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 80
   || (int)me->query("force") < 80 )
    return notify_fail("你的内力或气不够，没有办法练习七星剑法。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("qixing-sword",1);
  if (level > action[i]["lvl"])
    return HIW"剑转七星，气化三清。\n"NOR;

  level = query_skill_lvl(me,"qixing-sword",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习七星剑法！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file( string action)
{
   return CLASS_D("zhenyuan") + "/qixing-sword/" + action;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 15;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 20  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("qixing-sword",1);
  level = query_skill_lvl(me,"qixing-sword",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了七星剑法的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}