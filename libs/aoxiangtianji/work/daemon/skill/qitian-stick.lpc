int valid_learn(object me)
{
  object ob;
  if( (int)me->query("max_force") < 1500 )
    return notify_fail("你的内力不够，没有办法练齐天棍法，多练些内力再来吧。\n");
  if((string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("齐天棍法是方寸山三星洞不传之密！\n");
  if( !(ob = me->query_temp("weapon"))
  || (string)ob->query("skill_type") != "stick" )
    return notify_fail("你必须先找一根棒子才能练棒法。\n");
  if ((int)me->query_skill("stick",1) < (int)me->query_skill("qitian-stick",1))
    return notify_fail("你的基础棒法太差了，无法练习齐天棍！\n");
  if ((int)me->query("dntg/number") < 10)
    return notify_fail("你必须先过了大闹天宫，才可以学习这种棒法！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="stick"||usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  level = query_skill_lvl(me,"qitian-stick",action);
  pfm_num = me->query_temp("QTS_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];

  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 80
  ||  (int)me->query("force") < 80 )
    return notify_fail("你的内力或气不够，没有办法练习齐天棍法。\n");
  me->receive_damage("kee", 25);
  me->add("force", -15);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("qitian-stick",1);
  if (level > action[i]["lvl"])
    return HIY"任意逍遥，我与天齐。\n"NOR;

  level = query_skill_lvl(me,"qitian-stick",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习齐天棍法！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("puti") + "/qitian-stick/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int query_effect_parry(object me, object victim)
{
  return 105;
}

int learn_bonus()
{
  return 10;
}

int practice_bonus()
{
  return 5;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 10  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("qitian-stick",1);
  level = query_skill_lvl(me,"qitian-stick",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了齐天棍的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

