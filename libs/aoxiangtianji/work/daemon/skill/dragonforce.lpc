#include <ansi.h>
inherit FORCE;
int valid_enable(string usage) { return usage=="force"; }

int valid_learn(object me)
{
  if( (string)me->query("family/family_name")!="东海龙宫")
    return notify_fail("你非龙族，无法学习龙神心法。\n");
  if( (int)me->query_skill("force", 1) < 10
   || (int)me->query_skill("force", 1) <= (int)me->query_skill("dragonforce", 1) )
    return notify_fail("你的内功底子太差了，无法学习龙神心法。\n");
   return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
  if( (string)me->query("family/family_name")!="东海龙宫")
    return 0;

  if( damage_bonus < 100 )
    return 0;

  if( (me->query_skill("dragonforce") > 120) && (me->query("force") > 1500)
  && random(11)>8)
  {
    if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
    {
      victim->receive_wound("kee", random(damage_bonus)+1, me);
      return HIY"$N龙神心法借势袭来，$n如受重击，眼前就是一黑！\n"NOR;
    }

    else
    {
      victim->receive_wound("kee", damage_bonus, me);
      return HIY"$N龙神心法勃发而喷涌，$n如受重击，眼前就是一黑！\n"NOR;
    }

  }

  return 0;
}

mixed valid_damage(object ob,object me,int damage)
{
  int myforce,yourforce ;
  int skill_lev;
  if( (string)me->query("family/family_name")!="东海龙宫")
    return 0;

  myforce = (int)me->query("force");
  yourforce = (int)ob->query("force");
  skill_lev = (int)me->query_skill("dragonforce",1);

  if (skill_lev > 150 )
  {
    if (random(3) == 0)
    {
      if (random(myforce + yourforce) > yourforce)
      {
        return (["msg" : HIY"$n运起龙神心法，消解了部分的伤害！\n"NOR,
                 "damage" : -damage/3 - random(skill_lev),
               ]);
      }

      else if (random(myforce + yourforce) > yourforce*2/3)
      {
        return (["msg" : HIY"$n运起龙神心法，消解了部分的伤害！\n"NOR,
                 "damage" : -damage/4 - random(skill_lev),
               ]);
      }

      else if (random(2))
      {
        return (["msg" : HIY"$n运起龙神心法，消解了部分的伤害！\n"NOR,
                 "damage" : -damage/5 - random(skill_lev),
               ]);
      }

    }

  }

  return 0;
}

int query_power_effect(object me)
{
  int force_skill ;

  force_skill = (int)me->query_skill("dragonforce",1);
  if (force_skill < 100)
    return 100;
  else if (force_skill < 200)
    return 110 ;
  else if (force_skill < 300)
    return 120;
  return 130;
}

string exert_function_file(string func)
{
  return CLASS_D("dragon") + "/dragonforce/" + func;
}

int practice_skill(object me)
{
  if( (string)me->query("family/family_name")!="东海龙宫")
    return notify_fail("你非龙族，再练有害无益。\n");
  if( !environment(me)->query("dragonforce_practice") )
    return notify_fail("龙神心法只能在特殊的法台上才可练。\n");
  if( (int)me->query_temp("dragonforce_practice") < 1 )
    return notify_fail("你试着练功，可毫无进展，需要驯服更多的海兽以增进龙神心法。\n");
  if( (int)me->query("kee") < 30 )
    return notify_fail("你的气不够。\n");
  if( (int)me->query("kee") < 30 )
    return notify_fail("你的神不够。\n");
  if( (int)me->query("force") < 10 )
    return notify_fail("你的内力不够");
  me->receive_damage("kee", 30);
  me->receive_damage("sen", 30);
  me->add("force", -10);
  me->add_temp("dragonforce_practice",-1);
  return 1;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int learn_bonus()
{
  return 5;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 10  ,
         ]);
}

