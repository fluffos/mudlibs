//updated by yekai
inherit SKILL;

mapping *action = ({
 ([	"action" : "$n低头细数裙褶，情思困困，步法回旋之际似乎娇柔无力，却将$N攻势一一化于无形。\n",
 	"dodge_power"  : 30
 ]),
 ([	"action" : "只见$n一个转身，忽然回眸一笑。$N一楞之下，哪里还有人在。\n",
 	"dodge_power"  : 35
 ]),
 ([	"action" : "可是$n婉尔一笑，不退反进，身形径向$N飘来。\n$N只觉一股甜香入鼻，这一招竟无着力之处。\n",
 	"dodge_power"  : 40
 ]),
 ([	"action" : "$n身法轻灵，腰肢几拧，居然幻出斑驳月影。$N眼一花，哪里分得出是人，是影。\n",
 	"dodge_power"  : 45
 ]),
 ([	"action" : "$n裙裾飘飘，白衣姗姗，已然从$N头顶飞过，这般女神端丽之姿，仙子缥缈之形，$N不由得看呆了！\n",
 	"dodge_power"  : 50
 ]),
 ([	"action" : "$n脚步轻盈，风姿嫣然，身子便如在水面上飘浮一般掠过，不等$N劲风袭到，已悄然隐去。\n",
 	"dodge_power"  : 60
 ]),
 ([	"action" : "$n纤腰微颤，带飞如虹，轻轻将$N的劲力拨在一旁，尽数化解。\n",
 	"dodge_power"  : 80
 ])
});
mapping query_action(object me)
{
  int zhaoshu, level;

  zhaoshu = sizeof(action);
  level   = (int) me->query_skill("moondance",1);

  if (level < 300 )
    zhaoshu--;

  if (level < 250 )
    zhaoshu--;

  if (level < 180 )
    zhaoshu--;

  if (level < 150 )
    zhaoshu--;

  if (level < 120 )
    zhaoshu--;

  if (level < 80 )
    zhaoshu--;
  return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
  return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
  if(me->query("family/family_name") != "月宫")
    return notify_fail("冷月凝香舞是月宫不传之密！\n");
  if ((int)me->query_skill("dodge",1) < (int)me->query_skill("moondance",1))
    return notify_fail("你的基本轻功太低了！\n");
  return 1;
}

string query_dodge_msg(object me)
{
  mapping action;
  action = query_action(me);
  return action["action"];
}

int practice_skill(object me)
{
  if(me->query("family/family_name") != "月宫")
    return notify_fail("冷月凝香舞是月宫不传之密！\n");

  if ((int)me->query_skill("dodge",1) < 100)
    return notify_fail("你的基本技能太差了，不能练冷月凝香舞。\n");

  if( (int)me->query("kee") < 40 )
    return notify_fail("你的体力太差了，不能练冷月凝香舞。\n");

  me->receive_damage("kee", 30);
  return 1;
}

int query_effect_dodge(object me,object ob)
{
  string dodge_skill;

  dodge_skill = ob->query_skill_mapped("dodge");
  if (!stringp(dodge_skill))
    return 130;

  switch (dodge_skill)
  {
    case "moshenbu" :
    case "xiaoyaoyou"  :
      return 120 ;
    case "dragonstep" :
    case "lingfu-steps" :
      return 80;
    default :
      return 100 ;
  }

  return 100;
}

int query_terrain(string terrain)
{
  switch (terrain)
  {
    case "snow" :
    case "hill" :
      return 3 ;
    case "wood" :
      return 1 ;
    case "muddy" :
      return -3 ;
    case "water" :
      return -2 ;
    case "sand" :
      return -1;
    default :
      return 0 ;
  }

  return 0;
}

string perform_action_file(string func)
{
  return CLASS_D("moon") + "/moondance/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 120;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 2;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 15  ,
         ]);
}

