string main_skill()
{
  return "fengbo-fork";
}

int valid_learn(object me)
{
  object ob;
  if( (string)me->query("family/family_name")!="东海龙宫")
    return notify_fail("你非龙宫门人，怎么可以学习无风叉？\n");
  if (me->query("class") != "dragon")
    return notify_fail("你非龙族，怎能习惯这水中出没的叉法？\n");

  if( (int)me->query("max_force") < 50 )
    return notify_fail("你的内力不够，无法领会无风叉的精妙之处。\n");
  if (me->query_skill("dragonforce", 1) < me->query_skill("wufeng-fork", 1)/2)
    return notify_fail("你的龙神心法修为太低。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "fork" )
    return notify_fail("你必须先找一柄叉来才能学叉法。\n");
  if ((int)me->query_skill("fork",1) < (int)me->query_skill("wufeng-fork",1))
    return notify_fail("你的基本叉法太低了，无法练习无风叉！\n");

  if (me->query_skill("fengbo-fork",1))
    return notify_fail("你已经学会了风波十二叉，继续练习无风叉没有什么意义了！\n");
  return 1;
}

int practice_skill(object me)
{
  if (me->query("class") != "dragon")
    return notify_fail("你非龙族，怎能习惯这水中出没的叉法？\n");

  if(me->query_skill_mapped("force") !="dragonforce")
    return notify_fail("无风叉必须配合龙神心法才能发挥威力。\n");

  if(me->query("kee") < 50)
    return notify_fail("你的体力太弱，先休息一会儿吧。\n");

  if(me->query("sen") < 50)
    return notify_fail("你的神智不清，就算练了也什么都学不到的。\n");

  if(me->query("force") < 20)
    return notify_fail("你的内力不足，无法照路数舞叉。\n");
  me->add("kee", -20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("wufeng-fork",1);
  if (level > action[i]["lvl"])
    return HIC"\n无风无浪，定海一叉！\n"NOR;

  level = query_skill_lvl(me,"wufeng-fork",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习无风叉！对%s有了进一步的了解！\n",sk_name);
}

int valid_enable(string usage)
{
  return usage=="fork" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;

  level = query_skill_lvl(me,"wufeng-fork",action);
  pfm_num = me->query_temp("WFF_perform");

  if(pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];

  return action[random(level+1)];
}

string perform_action_file(string func)
{
  return CLASS_D("dragon") + "/wufeng-fork/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("wufeng-fork",1);
  level = query_skill_lvl(me,"wufeng-fork",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了无风叉的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

