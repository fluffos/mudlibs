int valid_learn(object me)
{
  object ob;
  if( (int)me->query("max_force") < 2000 )
    return notify_fail("你的内力不够，没有办法练千钧棒法，多练些内力再来吧。\n");
  if((string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("千钧棒法是方寸山三星洞不传之密！\n");
  if( !(ob = me->query_temp("weapon"))
  || (string)ob->query("skill_type") != "stick" )
    return notify_fail("你必须先找一根棒子才能练棒法。\n");
  if ((int)me->query_skill("stick",1) < (int)me->query_skill("qianjun-stick",1))
    return notify_fail("你的基础棒法太差了，无法练习千均棒！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="stick"||usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level, i;
  mapping* m_actions;
  mapping temp_act ;

  mapping pfm_qiankun = ([
         "name"  : "乾坤一棒",
         "action":
"$N将手中$w迎风一挥，幻出万千虚影，蓄力劲发，高举过顶，$w对准$n的脑门就砸了下去。"
"这一下要是打中，恐怕连大罗金仙也难逃一命",
         "parry":   -40,
         "dodge":   -40,
         "damage":  150,
         "force":   120,
         "damage_type":  "砸伤"
  ]) ;

  if (me->query_temp("QJB_qiankun"))
    return pfm_qiankun ;
  temp_act = allocate_mapping(6);
  temp_act["action"] = "";
  temp_act["damage"] = 0;
  temp_act["force"] = 0;
  temp_act["parry"] = 0;
  temp_act["dodge"] = 0;
  temp_act["damage_type"] = "砸伤";

  level = query_skill_lvl(me,"qianjun-stick",action);
  i = random(level+1);
  pfm_num = me->query_temp("QJS_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
  {
    temp_act["action"] = (string)action[pfm_num]["action"];
    temp_act["damage"] = (int)action[pfm_num]["damage"]*6/5;
    temp_act["force"] = (int)action[pfm_num]["force"]*6/5;
    temp_act["dodge"] = (int)action[pfm_num]["dodge"]-10;
    temp_act["parry"] = (int)action[pfm_num]["parry"]-10;
    temp_act["damage_type"] = (string)action[pfm_num]["damage_type"];
    return temp_act;
  }

  if(!me->query("skill_qianjun-stick") || random(4))
  {
    temp_act["action"] = (string)action[i]["action"];
    temp_act["damage"] = (int)action[i]["damage"];
    temp_act["force"] = (int)action[i]["force"];
    temp_act["dodge"] = (int)action[i]["dodge"];
    temp_act["parry"] = (int)action[i]["parry"];
    temp_act["damage_type"] = (string)action[i]["damage_type"];
    return temp_act;
  }

  else
  {
    m_actions=me->query("skill_qianjun-stick");
    return element_of(m_actions);
  }

  return action[0];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 150
  ||      (int)me->query("force") < 150 )
    return notify_fail("你的内力或气不够，没有办法练习千钧棒法。\n");
  me->receive_damage("kee", 40);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("qianjun-stick",1);
  if (level > action[i]["lvl"])
    return HIY"金猴奋起千钧棒，玉宇澄清万里埃。\n"NOR;

  level = query_skill_lvl(me,"qianjun-stick",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习千钧棒法！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("puti") + "/qianjun-stick/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 110;
}

int effective_parry_level()
{
  return 105;
}

int query_effect_parry(object me, object victim)
{
  return 110;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 2;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 10  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("qianjun-stick",1);
  level = query_skill_lvl(me,"qianjun-stick",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了千钧棒法的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
  if(m_skill>action[i]["lvl"] && m_skill%10==0)
  {
    tell_object(me,HIW"你对千钧棒的领悟加深了，你的千钧棒进入了一个新的境界！\n"NOR);
    if(me->query("zichuang/times")>7)
    {
      tell_object(me,HIW"然而你的功夫已经练至顶峰，不能再创出新招了。\n"NOR);
      return;
    }

    if(random(me->query("kar"))<20)
    {
      tell_object(me,HIW"然而你的心中居然产生了一种失落感！\n"NOR);
      return;
    }

    if((random(me->query("int")/2)+(int)me->query_skill("literate")/50)<10)
    {
      tell_object(me,HIW"然而你的心中升起一种惆怅的感觉，仿佛有一丝重要的东西没有抓住。\n"NOR);
      return;
    }

    tell_object(me,HIW"你突然福至心灵，对千钧棒领悟出了一招新的用法！\n"NOR);
    tell_object(me,"请为这招取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
  }

  return;
}

void name_skill(object me, string arg)
{
  mapping* m_actions;
  mapping m_act=([]);
  int content, i=strlen(arg);
  string msg;
  int name_count;
  name_count = (int)me->query_temp("skill_name_count");
  m_actions=me->query("skill_qianjun-stick");
  if(!pointerp(m_actions))
    m_actions=({});

  content=me->query("str")+2*me->query_skill("unarmed",1)/10;
  m_act+=(["damage":content]);
  content=-me->query("spi");
  m_act+=(["dodge" :content]);
  content=-me->query("cps");
  m_act+=(["parry" :content]);
  content=me->query("con")+2*me->query_skill("force",1)/10;
  m_act+=(["force" :content]);
  m_act+=(["damage_type":"砸伤"]);
  if (!arg || arg=="")
  {
    tell_object(me,"请为你的新招式取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
    return;
  }

  else while(i--)
  {
    if( arg[i]<=' ' )
    {
      tell_object(me,"招式名字不能使用控制字元，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
        me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

    if(strsrch(arg, "  ") >= 0)
    {
      tell_object(me,"招式名字不能有空格，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
        tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
        me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

    if(  !is_chinese(arg[i..i]) )
    {
      tell_object(me,"请您用「中文」为你的新招式取名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

  }

  if (!valid_name(arg))
  {
    tell_object(me,"对不起，这种名字会造成其他人的困扰。请重新设定一个名字：");
      name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  if( (strlen(arg) < 4) || (strlen(arg) > 8 ) )
  {
    tell_object(me,"对不起，招式名字必须是 ４ 到 ８ 个中文字：");
    name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  m_act+=(["name":arg]);
  msg= element_of(skill_head)+BLINK+HIG"「"+arg+"」"NOR
                  +element_of(skill_tail);
  m_act+=(["action":msg]);
  m_actions+=({m_act});
  me->set("skill_qianjun-stick",m_actions);
  me->add("zichuang/times",1);
  me->delete_temp("skill_name_count");
}

