int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name")!="大雪山")
    return notify_fail("你不是大雪山的弟子，没有办法练冰魄寒刀。\n");

  if( (int)me->query("max_force") < 1500 )
    return notify_fail("你的内力不够，没有办法练冰魄寒刀。\n");
  if( (string)me->query_skill_mapped("force")!= "ningxue-force")
     return notify_fail("冰魄寒刀必须配合冰谷凝血功才能练。\n");
  if( !(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "blade" )
    return notify_fail("你必须先找一把冰做的刀才能练冰魄寒刀。\n");

  if ((int)me->query_skill("blade",1) < (int)me->query_skill("bingpo-blade",1))
    return notify_fail("你的基础刀法太低了，没有办法练习冰魄寒刀！\n");

  if (me->query_skill("xueshan-blade",1) < 180)
    return notify_fail("你的雪山刀法太低了，无法学习冰魄刀法！\n");
  if (me->query_skill("ningxue-zhang",1) < 180)
    return notify_fail("你的凝血掌太低了，无法学习冰魄刀法！\n");
  return 1;
}

int valid_enable(string usage)
{
   return usage=="blade" || usage == "parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level,i;
  mapping temp_act;

  temp_act = allocate_mapping(6);
  temp_act["action"] = "";
  temp_act["damage"] = 0;
  temp_act["force"] = 0;
  temp_act["parry"] = 0;
  temp_act["dodge"] = 0;
  temp_act["damage_type"] = "劈伤";

  level = query_skill_lvl(me,"bingpo-blade",action);
  i = random(level+1);
  pfm_num = me->query_temp("BPD_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
  {
    temp_act["action"] = (string)action[pfm_num]["action"];
    temp_act["damage"] = (int)action[pfm_num]["damage"]*5/4;
    temp_act["force"] = (int)action[pfm_num]["force"]*5/4;
    temp_act["dodge"] = (int)action[pfm_num]["dodge"]-10;
    temp_act["parry"] = (int)action[pfm_num]["parry"]-10;
    temp_act["damage_type"] = (string)action[pfm_num]["damage_type"];
    return temp_act;
  }

  temp_act["action"] = (string)action[i]["action"];
  temp_act["damage"] = (int)action[i]["damage"];
  temp_act["force"] = (int)action[i]["force"];
  temp_act["dodge"] = (int)action[i]["dodge"];
  temp_act["parry"] = (int)action[i]["parry"];
  temp_act["damage_type"] = (string)action[i]["damage_type"];
  return temp_act;
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 100
   || (int)me->query("sen") < 100
   || (int)me->query("force") < 100 )
    return notify_fail("你太累了，没有办法练习冰魄寒刀。\n");

  me->receive_damage("kee", 40);
  me->receive_damage("sen", 40);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("bingpo-blade",1);
  if (level > action[i]["lvl"])
    return HIC"万里冰封，闪烁万古寒冰的刀光。\n"NOR;

  level = query_skill_lvl(me,"bingpo-blade",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习冰魄寒刀！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string action)
{
  return CLASS_D("xueshan")+"/bingpo-blade/"+action;
}

int expell_delete()
{
  return 1;
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("bingpo-blade",1);
  level = query_skill_lvl(me,"bingpo-blade",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了冰魄寒刀的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }

}

mixed hit_ob(object me, object victim, int damage_bonus)
{
  int dam;
  int lvl;
  int flvl;
  object weapon;
  string msg;
  lvl  = me->query_skill("bingpo-blade", 1) + me->query_skill("poison")/2;
  flvl = me->query("force_factor");
  weapon = me->query_temp("weapon");

  if(damage_bonus < 100 )
    return 0;
  if(me->query("force") < 1200)
    return 0;
  if (userp(me) && (string)me->query("family/family_name") != "大雪山" )
    return 0;

  if (flvl + random(lvl) > victim->query_skill("force") &&
            victim->affect_by("ningxue_force",
                              ([ "level" : flvl/3 + random(flvl/2),
                                 "id"    : me->query("id"),
                                 "duration" : lvl / 100 + random(lvl / 50) ])))
  {
    dam = damage_bonus/3 + random(lvl/2);
    victim->receive_wound("kee", random(dam) ,me);
    msg = HIR "只听$n" HIR "一声惨嚎，看来受到了$N的凝血神功的干扰！\n" NOR;
    return msg;
  };
  return 0;
}

int learn_bonus()
{
  return 6;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 8  ,
         ]);
}

