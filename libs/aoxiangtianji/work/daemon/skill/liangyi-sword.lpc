int valid_learn(object me)
{
  object ob;
  if( (int)me->query("max_force") < 500 )
    return notify_fail("你的内力不够，没有办法练两仪剑法。\n");
  if( (string)me->query_skill_mapped("force")!= "wuxiangforce")
    return notify_fail("两仪剑法必须配合方寸山的小无相功才能练。\n");
  if((string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("两仪剑法是方寸山三星洞不传之密！\n");
  if( !(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword" )
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  if ((int)me->query_skill("sword",1) < (int)me->query_skill("liangyi-sword",1))
    return notify_fail("你的基础剑术太低了，无法练习两仪剑法！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int level;

  level = query_skill_lvl(me,"liangyi-sword",action);
  return action[random(level + 1)];
}

string perform_action_file(string func)
{
  return CLASS_D("puti") + "/liangyi-sword/" + func;
}

int practice_skill(object me)
{
  int flvl=(int)me->query_skill("force");
  int slvl=(int)me->query_skill("sword");
  if( (int)me->query("kee") < 100
    || (int)me->query("force") < 100 )
    return notify_fail("你的内力或气不够，没有办法练习两仪剑法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -15);
  if(me->query("family/family_name") != "方寸山三星洞")
  {
    return 1;
  }

  else
  {
    if(random(slvl)>flvl)
      if (random(2))
        me->improve_skill("force", 1);
    return 1;
  }

}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("liangyi-sword",1);
  if (level > action[i]["lvl"])
    return HIW"两仪生四象。\n"NOR;

  level = query_skill_lvl(me,"liangyi-sword",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习两仪剑法！对%s这招有了进一步的了解！\n",sk_name);
}

int expell_delete()
{
  return 1;
}

int query_effect_parry(object me, object victim)
{
  return 110;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 6;
}

mapping black_white_ness()
{
  return (["skill_level" : 220 ,
           "effect"      : 15  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("liangyi-sword",1);
  level = query_skill_lvl(me,"liangyi-sword",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了两仪剑法的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

