#include <ansi.h>
inherit SKILL;
mapping *action = ({
  (["name"   : MAG"「自在飞花轻似梦」"+NOR,
    "action" : "$N浅浅一笑，一招"+MAG"「自在飞花轻似梦」"+NOR"若有若无地拍向$n的$l",
    "dodge"  :	-10,
    "parry"  :  -10,
    "force"  :  60,
    "lvl"    :  0,
    "damage_type" : "瘀伤",
  ]),
  (["name"   : HIR"「一枝红杏出墙来」"+NOR,
    "action" : "$N身形一顿，似有退意。$n正待反攻，\n忽见$N纤纤五指，直拂$n双目。正是“百花掌”之杀手"+HIR"「一枝红杏出墙来」"+NOR,
    "dodge"  : -10,
    "parry"  : -10,
    "force"  : 70,
    "lvl"    : 100,
    "damage_type" : "刺伤",
    "weapon" : HIW"右手指"NOR,
  ]),
  (["name"   : HIM"「人面桃花相映红」"+NOR,
    "action" : "只见$N嫣然一笑，双掌翻飞，一招"+HIM"「人面桃花相映红」"+NOR"当真是妙到毫巅",
    "dodge"  : -10,
    "parry"  : -5,
    "force"  : 80,
    "lvl"    : 150,
    "weapon" : HIY"左掌"NOR,
    "damage_type" : "瘀伤",
  ]),
  (["name"   : HIY"「黄菊枝头生晓寒」"+NOR,
    "action" : "$N纤腰一摆，陡然滑出数尺，右手顺势一招"+HIY"「黄菊枝头生晓寒」"+NOR"往$n的$l拍去",
    "dodge"  : -15,
    "parry"  : 5,
    "force"  : 100,
    "lvl"    : 180,
    "weapon" : HIW"右掌"NOR,
    "damage_type" : "瘀伤",
  ]),
  (["name"   : HIW"「此花开尽更无花」"+NOR,
    "action" : "只见$N双唇紧闭，面色凝重，一招"+HIW"「此花开尽更无花」"+NOR"全力击向$n的$l",
    "dodge"  : -10,
    "parry"  : -10,
    "force"  : 120,
    "lvl"    : 200,
    "weapon" : HIW"右掌"NOR,
    "damage_type" : "瘀伤",
  ]),
});
int valid_learn(object me)
{
  if(me->query("family/family_name") != "月宫")
    return notify_fail("百花掌乃月宫不传之密！\n");
  if( (string)me->query("gender") != "女性" )
    return notify_fail("百花掌是只有女子才能练的武功。\n");
  if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
    return notify_fail("练百花掌必须空手。\n");
  if ((int)me->query_skill("unarmed",1) < (int)me->query_skill("baihua-zhang",1))
    return notify_fail("你的基本拳脚太差劲了，没有办法练习百花掌！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  level = query_skill_lvl(me,"baihua-zhang",action);
  pfm_num = (int)me->query_temp("BHZ_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if(me->query("family/family_name") != "月宫")
    return notify_fail("百花掌乃月宫不传之密！\n");
  if( (int)me->query("sen") < 30)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if( (int)me->query("kee") < 30 )
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if( (int)me->query("force") < 10 )
    return notify_fail("你的内力不够了。\n");
  if ((int)me->query_skill("unarmed",1) < 100)
    return notify_fail("你的基本功夫太差了。\n");
  me->receive_damage("sen", 30);
  me->add("force", -15);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("baihua-zhang",1);
  if (level > action[i]["lvl"])
    return HIW"梅兰不惧雪，竹菊更傲霜。\n"NOR;

  level = query_skill_lvl(me,"baihua-zhang",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习百花掌！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("moon") + "/baihua-zhang/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 15  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("baihua-zhang",1);
  level = query_skill_lvl(me,"baihua-zhang",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了百花掌的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

