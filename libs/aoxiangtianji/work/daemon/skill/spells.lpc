// spells.c
#include <ansi.h>
inherit SKILL;
string cast_spell_file(string spell)
{
  return "/daemon/class/spells/" + spell;
}

string type() { return "magic"; }

void skill_improved(object me)
{
  int spell_skill = me->query_skill("spells",1);

  if (spell_skill > 80)
    if (!me->query("common/can_cast/chuqiao"))
      me->set("common/can_cast/chuqiao",1);
  if (spell_skill > 100)
    if (!me->query("common/can_cast/transfer"))
      me->set("common/can_cast/transfer",1);

  if (spell_skill > 120)
    if (!me->query("common/can_cast/tuoqiao"))
      me->set("common/can_cast/tuoqiao",1);
}