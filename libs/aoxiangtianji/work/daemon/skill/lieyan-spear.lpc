inherit SKILL;
#include <ansi.h>
mapping *action = ({
  (["name"  : HIR"「烈焰烧天」"NOR,
    "action":
"$N一招「烈焰烧天」，手中$w直奔$n$l",
    "damage":  20,
    "dodge" :  15,
    "parry" :  15,
    "lvl"   :  0,
    "damage_type":  "刺伤"
  ]),
  (["name"  : HIR"「火中取栗」"NOR,
    "action":
"$N一招「火中取栗」，虚晃了晃手中的$w，只见寒芒一闪，$w己闪电般射向$n",
    "damage":  20,
    "dodge" :  5,
    "parry" :  5,
    "lvl"   :  50,
    "damage_type":  "刺伤"
  ]),
  (["name"  : HIR"「借风助火」"NOR,
    "action":
"$N使出「借风助火」，手中$w带着风声，化为一道寒光刺向$n",
    "damage":  30,
    "dodge" :  0,
    "parry" :  0,
    "lvl"   :  100,
    "damage_type":  "刺伤"
  ]),
  (["name"  : HIR"「野火燎原」"NOR,
    "action":
"$N使出「野火燎原」，只见枪尖寒光闪了又闪，将$n笼罩入一片枪影之中",
    "damage":  40,
    "dodge" :  -10,
    "parry" :  0,
    "lvl"   :  150,
    "damage_type":  "刺伤"
  ]),
  (["name"  : HIR"「火烧连营」"NOR,
    "action":
"$N$w一抖，向$n脚下磋来，搅起一片尘土，这招"+HIR"「火烧连营」"NOR"逼得$n连连后退，无处落脚",
    "damage":  50,
    "dodge" :  -10,
    "parry" :  -10,
    "lvl"   :  180,
    "damage_type":  "刺伤"
  ]),
});
string main_skill() { return "fencheng-spear"; }

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习烈焰枪！\n");
  if( (int)me->query("max_force") < 200 )
    return notify_fail("你的内力不够，没有办法练烈焰枪。\n");
  if( !(ob = me->query_temp("weapon"))
   ||  (string)ob->query("skill_type") != "spear" )
    return notify_fail("你必须先找一柄枪才能练枪法。\n");
  if ((int)me->query_skill("spear",1) < (int)me->query("lieyan-spear",1))
    return notify_fail("你的基本枪法太差了，无法练习烈焰枪！\n");
  if ((int)me->query_skill("fencheng-spear",1))
    return notify_fail("你已经学会了焚城枪法，没有必要单独练习烈焰枪了！\n");
  return 1;
}

int valid_enable(string usage)
{
  return (usage=="spear") || (usage=="parry");
}

mapping query_action(object me, object weapon)
{
  int pfm_num , level;

  level = query_skill_lvl(me,"lieyan-spear",action);
  pfm_num = me->query_temp("LYS_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  object weapon;
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习烈焰枪！\n");
  if( !objectp(weapon = me->query_temp("weapon"))
  ||      (string)weapon->query("skill_type") != "spear" )
    return notify_fail("你必须先找一柄长枪或者是类似的武器，才能练枪法。\n");
  if( (int)me->query("kee") < 50
  ||    (int)me->query("force") < 50  )
    return notify_fail("你的体力不够练这门枪法，还是先休息休息吧。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("lieyan-spear",1);
  if (level > action[i]["lvl"])
    return HIR"烈焰腾空，心似火焚。\n"NOR;

  level = query_skill_lvl(me,"lieyan-spear",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习烈焰枪！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("kusong") + "/lieyan-spear/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 16;
}

int practice_bonus()
{
  return 12;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("lieyan-spear",1);
  level = query_skill_lvl(me,"lieyan-spear",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了烈焰枪的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

