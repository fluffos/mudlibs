string main_skill() { return "daojian-hebi"; }

int main_to_keep() {return 1;}

int valid_learn(object me)
{
  object ob;

  if (me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("你还未习惯血腥，无法学七修剑。\n");
  if ((int)me->query("max_force") < 1500)
    return notify_fail("你的真气不足，难以领悟剑法的精妙之处。\n");

  if (!(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "sword" )
     return notify_fail("你必须先找一把剑才能练剑法。\n");

  if ((int)me->query_skill("sword",1) < (int)me->query_skill("qixiu-sword",1))
    return notify_fail("你的基础剑术太低了，无法练习七修剑法！\n");

  if ((int)me->query_skill("zishu-sword",1) < 150)
    return notify_fail("你的子鼠剑法太低了，无法学习七修剑法！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level, i;
  mapping temp_act;
  temp_act = allocate_mapping(6);
  temp_act["action"] = "";
  temp_act["damage"] = 0;
  temp_act["force"] = 0;
  temp_act["parry"] = 0;
  temp_act["dodge"] = 0;
  temp_act["damage_type"] = "砸伤";
  pfm_num = (int)me->query_temp("QXS_perform");
  level = (int)query_skill_lvl(me,"qixiu-sword",action);
  i = random(level+1);

  if (pfm_num && (pfm_num < sizeof(action)))
  {
    temp_act["action"] = (string)action[pfm_num]["action"];
    if (me->query_temp("tick/zxzx"))
    {
      temp_act["damage"] = (int)action[pfm_num]["damage"]*4/3;
      temp_act["force"] = (int)action[pfm_num]["force"]*3/2;
    }

    else
    {
      temp_act["damage"] = (int)action[pfm_num]["damage"]*6/5;
      temp_act["force"] = (int)action[pfm_num]["force"]*6/5;
    }

    temp_act["dodge"] = (int)action[pfm_num]["dodge"]-10;
    temp_act["parry"] = (int)action[pfm_num]["parry"]-10;
    temp_act["damage_type"] = (string)action[pfm_num]["damage_type"];
    return temp_act;
  }

  temp_act["action"] = (string)action[i]["action"];
  temp_act["damage"] = (int)action[i]["damage"];
  temp_act["force"] = (int)action[i]["force"];
  temp_act["dodge"] = (int)action[i]["dodge"];
  temp_act["parry"] = (int)action[i]["parry"];
  temp_act["damage_type"] = (string)action[i]["damage_type"];
  return temp_act;
}

int practice_skill(object me)
{
  if (me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("你还未习惯血腥，无法练七修剑。\n");

  if ((int)me->query("kee") < 100)
    return notify_fail("你的气太低，再练下去会有危险的！\n");

  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够，没有办法运用七修剑。\n");
  me->receive_damage("kee", 40);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("qixiu-sword",1);
  if (level > action[i]["lvl"])
    return RED"追腥逐血，七命全修。\n"NOR;

  level = query_skill_lvl(me,"qixiu-sword",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习七修剑法！对%s这招有了进一步的了解！\n",sk_name);
}

mixed hit_ob(object me, object victim, int damage)
{
  string msg ;

  if (damage < 100)
    return 0;

  msg = "";
  if (me->query_temp("tick/zxzx"))
  {
    switch (random(4))
    {
      case 0 :
        msg += HIR"$N" HIR"一剑中敌，不由得双眼发红，更加疯狂的缠住$n拼命搏杀！\n"NOR;
        break;
      case 1 :
        msg += HIR"$N" HIR"一剑刺中$n" HIR"，看着流淌的鲜血，兴奋得口中乱叫，面色更加凶猛可怖！\n"NOR;
        break;
      case 2 :
        msg += HIR"$N" HIR"看到鲜血迸了出来，更加疯狂的直扑往$n。\n"NOR;
      default :
        msg += HIR"$N" HIR"看到鲜血流了一地，一股杀气涌了上来，不顾一切的围住$n" HIR"乱砍乱杀！\n"NOR;
    }

    if (random(3) == 0)
    {
      if (!victim->is_busy())
        victim->start_busy(1);
      me->add_temp("apply/attack",50);
      COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));
      me->add_temp("apply/attack",-50);
    }

    else if (random(3)==0)
      if (!victim->is_busy())
        victim->start_busy(1);
    return msg;
  }

  return 0;
}

string perform_action_file(string action)
{
  return CLASS_D("wudidong") + "/qixiu-sword/" + action;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 110;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 8  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("qixiu-sword",1);
  level = query_skill_lvl(me,"qixiu-sword",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了七修剑的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

