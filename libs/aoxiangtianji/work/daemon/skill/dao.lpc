// dao
inherit SKILL;
int valid_enable(string usage) { return usage=="spells"; }

int valid_learn(object me)
{
  if( (int)me->query_skill("spells",1) < 20 )
    return notify_fail("你的法术修为还不够高深，无法学习道家仙法。\n");
  if((string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("道家仙法是方寸山三星洞不传之密！\n");
  return 1;
}

string cast_spell_file(string spell)
{
  return CLASS_D("puti") + "/dao/" + spell;
}

string query_shuxing() {return "mu";}

int query_power_effect(object me)
{
  int force_skill ;
  int base_num, day_phase;
  object where;
  string weather, terrain;

  base_num = 100;
  day_phase = NATURE_D->query_current_day_phase();
  where = environment(me);
  if (objectp(where))
  {
    if (where->is_taoist())
      base_num += 10;
    else if (where->is_temple())
      base_num -= 10;
    terrain = where->query_terrain();
    if (!terrain)
      terrain = where->query("terrain");
    if (!terrain)
      terrain = "land";
  }

  if ((day_phase == 0) || (day_phase > 4))
    base_num -= 10;
  else if (day_phase == 3)
    base_num += 10;
  else
    base_num += 5;

  weather = NATURE_D->query_weather();

  if (stringp(terrain) && terrain == "hill")
    base_num += 10;
  else if (stringp(terrain) && terrain == "sand")
    base_num += 5;
  else if (stringp(terrain) && terrain == "wood")
    base_num += 3;
  else if (stringp(terrain) && terrain == "water")
    base_num -= 10;
  else if (stringp(terrain) && terrain == "muddy")
    base_num -= 5;
  else if (stringp(terrain) && terrain == "snow")
    base_num -= 3;
  if (stringp(weather) && weather == "sun")
    base_num += 10 ;
  else if (stringp(weather) && weather == "rain")
    base_num -= 10 ;

  force_skill = (int)me->query_skill("dao",1);
  if (force_skill < 150)
    return base_num;
  else if (force_skill < 250)
    return base_num + 5 ;
  return base_num + 10;
}

string type() { return "magic";}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int learn_bonus()
{
  return 5;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 10  ,
         ]);
}

