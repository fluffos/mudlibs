string main_skill() { return "snowsword-sword"; }

int valid_enable(string usage)
{
  return usage=="unarmed";
}

int valid_learn(object me)
{
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练逍遥折梅手必须空手。\n");
  if(me->query("family/family_name") != "月宫")
    return notify_fail("逍遥折梅手乃月宫不传之密！\n");

  if( (int)me->query("max_force") < 120 )
    return notify_fail("你的内力不够，没有办法练逍遥折梅手。\n");
  if( (string)me->query_skill_mapped("force")!= "moonforce")
    return notify_fail("逍遥折梅手必须配合昆仑山玉女峰的圆月心法才能练。\n");
  if (me->query_skill("unarmed",1) < me->query_skill("zhemei-shou",1))
    return notify_fail("你的基本拳脚太差了，无法练习逍遥折梅手！\n");
  if ((int)me->query_skill("snowsword",1))
    return notify_fail("你已经学会了风回雪舞剑法，没有必要再学习逍遥折梅手了！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;
  level = query_skill_lvl(me,"zhemei-shou",action);
  pfm_num = (int)me->query_temp("ZMS_perform");
  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if(me->query("family/family_name") != "月宫")
    return notify_fail("逍遥折梅手乃月宫不传之密！\n");

  if( (int)me->query("kee") < 80
   || (int)me->query("force") < 80 )
    return notify_fail("你的内力或气不够，没有办法练习逍遥折梅手。\n");

  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("zhemei-shou",1);
  if (level > action[i]["lvl"])
    return HIW"踏雪折梅，逍遥留香。\n"NOR;

  level = query_skill_lvl(me,"zhemei-shou",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习逍遥折梅手！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("moon") + "/zhemei-shou/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 18;
}

int practice_bonus()
{
  return 12;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("zhemei-shou",1);
  level = query_skill_lvl(me,"zhemei-shou",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了逍遥折梅手的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}