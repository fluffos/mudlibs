// xueshan-dushu.c
inherit SKILL;
string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "poison"; }

int valid_learn(object me)
{
  if(me->query("family/family_name")!="大雪山")
    return notify_fail("你不是大雪山的弟子，没有办法理解雪山毒术。\n");
  if ((int)me->query_skill("poison", 1) < 50)
    return notify_fail("你的基本毒技造诣太浅，无"
                       "法领会深奥的雪山毒术。\n");
  if ((int)me->query_skill("poison", 1) < (int)me->query_skill("xueshan-dushu", 1))
    return notify_fail("你的基本毒技水平有限，无法掌握更深奥的雪山毒术。\n");
  return 1;
}

