string main_skill() { return "daojian-hebi"; }

int main_to_keep() {return 1;}

mapping sub_skills = ([
        "kuangfeng-blade"  : 180,        // 1
        "shixue-blade"     : 180,        // 2
]);
int get_ready(object me)
{
  return 1;
}

int get_finish(object me)
{
  if (me->query_con() < 40)
  {
    tell_object(me, "你演练完毕，始终觉得内力的运转不是很理想。\n");
    return 0;
  }

  if (me->query_cor() < 30)
  {
    tell_object(me, "你演练完毕，感觉胆量似乎有所不够。\n");
    return 0;
  }

  if ((int)me->query_skill("force", 1) < 180)
  {
    tell_object(me, "你演练完毕，几乎虚脱，自己的内功水平看来还有待提高。\n");
    return 0;
  }

  if ((int)me->query("max_force") < 2000)
  {
    tell_object(me, "你演练完毕，丹田提不起半点力来，看来应该继续锻炼内力。\n");
    return 0;
  }

  if (random(10) < 8)
  {
    tell_object(me, "你似乎有所领悟，或许再演练一次就能够大有收获。\n");
    return 0;
  }

  tell_object(me, HIY "你一气呵成，将枯骨刀演练了一遍，心中顿悟，通晓了枯骨"
                      "刀的奥妙精髓。\n" NOR);
  me->set("family/can_learn/kugu-blade",1);
  return 1;
}

mapping query_sub_skills()
{
  return sub_skills;
}

int query_finish_skill()
{
  return 10;
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("你不习惯血腥，学不了枯骨刀！\n");

  if( (int)me->query("max_force") < 350 )
    return notify_fail("你的内力不够，不能学枯骨刀法，多练些内力再来吧。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "blade" )
    return notify_fail("你必须先找一把刀才能练刀法。\n");

  if ((int)me->query_skill("blade",1) < (int)me->query_skill("kugu-blade",1))
    return notify_fail("你的基础刀法太差了，无法练习枯骨刀法！\n");
  if (!me->query("family/can_learn/kugu-blade"))
    return notify_fail("你还没有演练(yanlian)枯骨刀法！\n");

  return 1;
}

int practice_skill(object me)
{
  if (me->query("kee") < 250)
    return notify_fail("你的体力不足，无法练枯骨刀。\n");
  if (me->query("force") < 250)
    return notify_fail("你的内力太低，无法在纵跃的同时舞刀。\n");
  me->add("kee", -50);
  me->add("force", -50);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("kugu-blade",1);
  if (level > action[i]["lvl"])
    return RED"你往地上一躺，刀光闪动，开始演练枯骨刀法。\n"NOR;

  level = query_skill_lvl(me,"kugu-blade",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习枯骨刀法！对%s这招有了进一步的了解！\n",sk_name);
}

int valid_enable(string usage)
{
  return usage=="blade"||usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;
  mapping *m_actions;

  level = query_skill_lvl(me,"kugu-blade",action);
  pfm_num = me->query_temp("KGD_perform");
  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];

  if(me->query("skill_kugu-blade")==0)
    return action[random(level + 1)];
  else if(random(4))
    return action[random(level + 1)];
  else
  {
    m_actions=me->query("skill_kugu-blade");
    return element_of(m_actions);
  }

  return action[0];
}

string query_parry_msg(object weapon)
{
  return element_of(action)["parry_msg"];
}

string perform_action_file(string func)
{
  return CLASS_D("wudidong") + "/kugu-blade/"+func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int effective_parry_level()
{
  return 110;
}

int query_effect_parry(object me, object victim)
{
  return 105;
}

int learn_bonus()
{
  return 4;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 8  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("kugu-blade",1);
  level = query_skill_lvl(me,"kugu-blade",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了枯骨刀的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
  if(m_skill>action[i]["lvl"] && m_skill%10==0)
  {
    tell_object(me,HIW"你对枯骨刀法的领悟加深了，你的枯骨刀法进入了一个新的境界！\n"NOR);
    if(me->query("zichuang/times")>7)
    {
       tell_object(me,HIW"然而你的功夫已经练至顶峰，不能再创出新招了。\n"NOR);
       return;
    }

    if(random(me->query("kar"))<20)
    {
       tell_object(me,HIW"然而你的心中居然产生了一种失落感！\n"NOR);
       return;
    }

    if((random(me->query("int")/2)+(int)me->query_skill("literate")/50)<10)
    {
      tell_object(me,HIW"然而你的心中升起一种惆怅的感觉，仿佛有一丝重要的东西没有抓住。\n"NOR);
      return;
    }

    tell_object(me,HIW"你突然福至心灵，对枯骨刀法领悟出了一招新的用法！\n"NOR);
    tell_object(me,"请为这招取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
  }

  return;
}

void name_skill(object me, string arg)
{
  mapping* m_actions;
  mapping m_act=([]);
  int content, i=strlen(arg);
  string msg;
  int name_count;

  name_count = me->query_temp("skill_name_count");
  m_actions=me->query("skill_kugu-blade");
  if(!pointerp(m_actions)) m_actions=({});
  content=me->query("str")+2*me->query_skill("unarmed",1)/10;
  m_act+=(["damage":content]);
  content=-me->query("spi");
  m_act+=(["dodge" :content]);
  content=-me->query("cps");
  m_act+=(["parry" :content]);
  content=me->query("con")+2*me->query_skill("force",1)/10;
  m_act+=(["force" :content]);
  m_act+=(["damage_type":"砍伤"]);
  if (!arg || arg=="")
  {
    tell_object(me,"请为你的新招式取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
    return;
  }

  else while(i--)
  {
    if( arg[i]<=' ' )
    {
      tell_object(me,"招式名字不能使用控制字元，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

    if(strsrch(arg, "  ") >= 0)
    {
      tell_object(me,"招式名字不能有空格，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

    if(  !is_chinese(arg[i..i]) )
    {
      tell_object(me,"请您用「中文」为你的新招式取名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

  }

  if (!valid_name(arg))
  {
    tell_object(me,"对不起，这种名字会造成其他人的困扰。请重新设定一个名字：");
      name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  if( (strlen(arg) < 4) || (strlen(arg) > 8 ) )
  {
    tell_object(me,"对不起，招式名字必须是 ４ 到 ８ 个中文字：");
    name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  m_act+=(["name":arg]);
  msg= element_of(skill_head)+BLINK+MAG"「"+arg+"」"NOR
                  +element_of(skill_tail);
  m_act+=(["action":msg]);
  m_actions+=({m_act});
  me->set("skill_kugu-blade",m_actions);
  me->add("zichuang/times",1);
  me->delete_temp("skill_name_count");
}