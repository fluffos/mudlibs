#include <ansi.h>
inherit SKILL;
mapping *action = ({
  (["name"   : HIW"「月挂长空独影」"NOR,
    "action" : "$N手中$w一转，回身一鞭，扫向$n$l，正是一招「月挂长空独影」",
    "dodge"  : 10,
    "parry"  : 10,
    "damage" : 20,
    "lvl"    : 0,
    "damage_type" : "瘀伤",
  ]),
  (["name"   : HIB"「月下山头难忘」"NOR,
    "action" : "$N腾空而起，一招「月下山头难忘」来势又准又快，手中$w已到$n$l",
    "dodge"  : 5,
    "parry"  : 5,
    "damage" : 30,
    "lvl"    : 50,
    "damage_type" : "瘀伤",
  ]),
  (["name"   : HIG"「月华如水意断」"NOR,
    "action" : "$N鞭影忽转，圈圈重影中，一鞭从上而下，竖直地向$n$l抽来，内劲十足，正是一招「穿月无限」",
    "damage" : 40,
    "dodge"  : 0,
    "parry"  : 0,
    "lvl"    : 100,
    "damage_type" : "瘀伤",
  ]),
  (["name"   : HIM"「皓月穿空神伤」"NOR,
    "action" : "$N手中$w猛然回撤，紧接着一鞭，气势磅礴，鞭影纵横，正是「皓月穿空」",
    "damage" : 50,
    "dodge"  : -10,
    "parry"  : -10,
    "lvl"    : 150,
    "damage_type" : "瘀伤",
  ]),
});
string main_skill() { return "jueqing-whip"; }

int valid_enable(string usage)
{
  return usage == "whip" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "月宫")
    return notify_fail("问月鞭乃月宫不传之密！\n");

  if( (string)me->query("gender") !="女性")
    return notify_fail("问月鞭只有女子才能学习!!\n");

  if( (int)me->query("max_force") < 150 )
    return notify_fail("你的内力不够，没有办法练问月鞭。\n");
  if( (string)me->query_skill_mapped("force")!= "moonforce")
    return notify_fail("问月鞭必须配合昆仑山玉女峰的圆月心法才能练。\n");
  if( !(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "whip" )
    return notify_fail("你必须先找一根鞭子才能练鞭法。\n");
  if ((int)me->query_skill("whip",1) < (int)me->query_skill("wenyue-whip",1))
    return notify_fail("你的基本鞭法太差了，无法练习问月鞭！\n");
  if ((int)me->query_skill("jueqingbian",1))
    return notify_fail("你已经学会了绝情鞭法，没有必要再学习问月鞭了！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;
  level = query_skill_lvl(me,"wenyue-whip",action);
  pfm_num = (int)me->query_temp("WYW_perform");
  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if(me->query("family/family_name") != "月宫")
    return notify_fail("问月鞭乃月宫不传之密！\n");

  if( (int)me->query("kee") < 50
   || (int)me->query("force") < 50 )
    return notify_fail("你的内力或气不够，没有办法练习问月鞭。\n");

  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("wenyue-whip",1);
  if (level > action[i]["lvl"])
    return HIW"明月意难断，空留心与神。\n"NOR;

  level = query_skill_lvl(me,"wenyue-whip",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习问月鞭！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("moon") + "/wenyue-whip/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 15;
}

int practice_bonus()
{
  return 10;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("wenyue-whip",1);
  level = query_skill_lvl(me,"wenyue-whip",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了问月鞭的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}