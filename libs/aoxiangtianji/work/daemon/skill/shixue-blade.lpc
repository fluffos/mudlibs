#include <ansi.h>
inherit SKILL;
mapping *action = ({
  (["name"   : HIB"「磨牙吮血」"NOR,
    "action" : "$N高举手中$w,使出一招「磨牙吮血」，一刀斜劈$n的$l",
    "damage" : 20,
    "dodge"  : 10,
    "parry"  : 10,
    "lvl"    : 0,
    "damage_type" : "割伤",
  ]),
  (["name"   : HIM"「刺血满地」"NOR,
    "action" : "$N就地一滚，使一招「刺血满地」，手中$w卷向$n的大腿",
    "damage" : 20,
    "dodge"  : 5,
    "parry"  : 5,
    "lvl"    : 50,
    "damage_type" : "割伤",
  ]),
  (["name"   : HIY"「血海茫茫」"NOR,
    "action" : "$N足尖一点，使出「血海茫茫」，刀锋自上而下直插$n的$l",
    "damage" : 30,
    "dodge"  : 0,
    "parry"  : 0,
    "lvl"    : 100,
    "damage_type" : "割伤",
  ]),
  (["name"   : HIW"「血迹斑斑」"NOR,
    "action" : "$N使出「血迹斑斑」，飞身斜刺，忽然反手一刀横斩$n的腰部",
    "damage" : 40,
    "dodge"  : -5,
    "parry"  : -5,
    "lvl"    : 120,
    "damage_type" : "割伤",
  ]),
  (["name"   : HIG"「以血还血」"NOR,
    "action" : "$N使一式「以血还血」，挥刀直指$n的胸口",
    "damage" : 50,
    "dodge"  : -10,
    "parry"  : -10,
    "lvl"    : 150,
    "damage_type" : "割伤",
  ]),
  (["name"   : HIR"「血流满面」"NOR,
    "action" : "$N刀锋虚点，使出一招「血流满面」，转身举$w横劈$n的面门",
    "damage" : 60,
    "dodge"  : -10,
    "parry"  : -10,
    "lvl"    : 180,
    "damage_type" : "割伤",
  ]),
});
string main_skill()
{
  return "kugu-blade";
}

int valid_enable(string usage)
{
  return usage == "blade" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("你不习惯血腥，学不了嗜血刀！\n");

  if( (int)me->query("max_force") < 50 )
    return notify_fail("你的内力不够，不能学嗜血刀，多练些内力再来吧。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "blade" )
    return notify_fail("你必须先找一把刀才能练刀法。\n");

  if ((int)me->query_skill("blade",1) < (int)me->query_skill("shixue-blade",1))
    return notify_fail("你的基础刀法太差了，无法练习嗜血刀！\n");
  if ((int)me->query_skill("kugu-blade",1))
    return notify_fail("你已经学会了枯骨刀法，没有必要在单独练习嗜血刀了！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;
  level = query_skill_lvl(me,"shixue-blade",action);
  pfm_num = me->query_temp("SXB_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
   return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if (me->query("kee") < 50)
    return notify_fail("你的体力不足，无法练嗜血刀。\n");
  if (me->query("force") < 50)
    return notify_fail("你的内力太低，无法在纵跃的同时舞刀。\n");
  me->add("kee", -20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("shixue-blade",1);
  if (level > action[i]["lvl"])
    return RED"狂魔嗜血，看尽枯骨。\n"NOR;

  level = query_skill_lvl(me,"shixue-blade",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习嗜血刀法！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("wudidong") + "/shixue-blade/"+func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 14;
}

int practice_bonus()
{
  return 10;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("shixue-blade",1);
  level = query_skill_lvl(me,"shixue-blade",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了嗜血刀的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}