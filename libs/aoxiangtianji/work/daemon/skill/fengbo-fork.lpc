string main_skill() { return "fengbo-fork"; }

mapping sub_skills = ([
        "wufeng-fork"  : 180,        // 1
        "dingbo-fork"  : 180,        // 2
]);
int get_ready(object me)
{
  return 1;
}

int get_finish(object me)
{
  if (me->query_con() < 40)
  {
    tell_object(me, "你演练完毕，始终觉得内力的运转不是很理想。\n");
    return 0;
  }

  if (me->query_str() < 80)
  {
    tell_object(me, "你演练完毕，感觉力量似乎有所不够。\n");
    return 0;
  }

  if ((int)me->query_skill("force", 1) < 150)
  {
    tell_object(me, "你演练完毕，几乎虚脱，自己的内功水平看来还有待提高。\n");
    return 0;
  }

  if ((int)me->query("max_force") < 2000)
  {
    tell_object(me, "你演练完毕，丹田提不起半点力来，看来应该继续锻炼内力。\n");
    return 0;
  }

  if (random(10) < 8)
  {
    tell_object(me, "你似乎有所领悟，或许再演练一次就能够大有收获。\n");
    return 0;
  }

  tell_object(me, HIY "你一气呵成，将风波十二叉演练了一遍，心中顿悟，通晓了风波十二"
                      "叉的奥妙精髓。\n" NOR);
  me->set("family/can_learn/fengbo-fork",1);
  return 1;
}

mapping query_sub_skills()
{
  return sub_skills;
}

int query_finish_skill()
{
  return 10;
}

int valid_learn(object me)
{
  object ob;
  if( (string)me->query("family/family_name")!="东海龙宫")
    return notify_fail("你非龙宫门人，怎么可以学习风波十二叉？\n");
  if (me->query("class") != "dragon")
    return notify_fail("你非龙族，怎能习惯这水中出没的叉法？\n");

  if( (int)me->query("max_force") < 200 )
    return notify_fail("你的内力不够，无法领会风波十二叉的精妙之处。\n");
  if (me->query_skill("dragonforce", 1) < me->query_skill("fengbo-fork", 1)/2)
    return notify_fail("你的龙神心法修为太低。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "fork" )
    return notify_fail("你必须先找一柄叉来才能学叉法。\n");
  if ((int)me->query_skill("fork",1) < (int)me->query_skill("fengbo-fork",1))
    return notify_fail("你的基本叉法太低了，无法练习风波十二叉！\n");

  if (!me->query("family/can_learn/fengbo-fork"))
    return notify_fail("你还没有演练(yanlian)风波十二叉，无法学习或者练习！\n");
  return 1;
}

int practice_skill(object me)
{
  if (me->query("class") != "dragon")
    return notify_fail("你非龙族，怎能习惯这水中出没的叉法？\n");

  if(me->query_skill_mapped("force") !="dragonforce")
    return notify_fail("风波十二叉必须配合龙神心法才能发挥威力。\n");

  if(me->query("kee") < 150)
    return notify_fail("你的体力太弱，先休息一会儿吧。\n");

  if(me->query("sen") < 150)
    return notify_fail("你的神智不清，就算练了也什么都学不到的。\n");

  if(me->query("force") < 120)
    return notify_fail("你的内力不足，无法照路数舞叉。\n");
  me->add("kee", -60);
  me->add("force", -30);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("fengbo-fork",1);
  if (level > action[i]["lvl"])
    return HIC"\n无尽风波处，神龙戏水时！\n"NOR;

  level = query_skill_lvl(me,"fengbo-fork",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习风波十二叉！对%s有了进一步的了解！\n",sk_name);
}

int valid_enable(string usage)
{
  return usage=="fork" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;

  level = query_skill_lvl(me,"fengbo-fork",action);
  pfm_num = me->query_temp("FBF_perform");

  if(pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];

  return action[random(level+1)];
}

string query_parry_msg(object weapon)
{
  return element_of(action)["parry_msg"];
}

string perform_action_file(string func)
{
  return CLASS_D("dragon") + "/fengbo-fork/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_parry_level()
{
  return 105;
}

int query_effect_parry(object me, object victim)
{
  return 110;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 8  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("fengbo-fork",1);
  level = query_skill_lvl(me,"fengbo-fork",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了风波十二叉的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

