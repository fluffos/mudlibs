#include <ansi.h>
inherit FORCE;
int valid_enable(string usage)
{
  return usage=="force";
}

int valid_learn(object me)
{
  if(me->query("family/family_name") != "五庄观")
    return notify_fail("镇元神功是五庄观不传之密！\n");

  if( (int)me->query_skill("force", 1) < 10
   || (int)me->query_skill("force", 1) <= (int)me->query_skill("zhenyuan-force", 1) )
    return notify_fail("你的内功修为还不够高深，无法学习镇元神功。\n");
  return 1;
}

int practice_skill(object me)
{
  return notify_fail("镇元神功只能向师父学，或是从运用(exert)中增加熟练度。\n");
}

mixed valid_damage(object ob,object me,int damage)
{
  object weapon;
  int myforce,yourforce, skill_lev , dam;
  string msg;

  if(me->query("family/family_name") != "五庄观")
    return 0;
  msg = "";
  weapon = me->query_temp("weapon");
  dam = 0;
  if (objectp(weapon) &&
      ((string)weapon->query("skill_type") == "whip" ||
       (string)weapon->query("skill_type") == "sword") &&
      (me->query_temp("SQW_perform")  ||
       me->query_temp("XFS_juejian1") ||
       me->query_temp("XFS_juejian2")))
  {
    msg += HIY"$n" HIY"剑气鼓胀而出，消解了部分的伤害！\n\n"NOR;
    dam = -damage/2;
  }

  myforce = (int)me->query("force");
  yourforce = (int)ob->query("force");
  skill_lev = (int)me->query_skill("zhenyuan-force",1);

  if (skill_lev > 150 )
  {
    if (random(3)==0)
    {
      if (random(myforce + yourforce) > yourforce)
      {
        msg += HIY"$n" HIY"运起镇元神功，消解了部分伤害！\n"NOR;
        return (["msg" : msg,
                 "damage" : dam - damage/3 - random(skill_lev),
               ]);
      }

      else if (random(2))
      {
        msg += HIY"$n" HIY"运起镇元神功，消解了些许伤害！\n"NOR;
        return (["msg" : msg,
                 "damage" : dam - damage/4 - random(skill_lev),
               ]);
      }

    }

  }

  return 0;
}

int query_power_effect(object me)
{
  int force_skill ;

  force_skill = (int)me->query_skill("zhenyuan-force",1);
  if (force_skill < 150)
    return 100;
  return 110 ;
}

string exert_function_file(string func)
{
  return CLASS_D("zhenyuan") + "/zhenyuan-force/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 10;
}

mapping black_white_ness()
{
  return (["skill_level" : 210 ,
           "effect"      : 10  ,
         ]);
}

