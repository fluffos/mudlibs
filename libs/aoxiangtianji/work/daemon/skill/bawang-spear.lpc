int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "将军府")
    return notify_fail("霸王枪法乃将军府不传之密！\n");
  if( (int)me->query("max_force") < 2000 )
    return notify_fail("你的内力不够，没有办法练霸王枪法。\n");
  if( !(ob = me->query_temp("weapon"))
     ||(string)ob->query("skill_type") != "spear" )
    return notify_fail("你必须先找一柄枪才能练枪法。\n");
  if ((int)me->query_skill("duo-spear",1) < 180)
    return notify_fail("你的夺命枪法不够高，学不了霸王枪法！\n");
  if ((int)me->query_skill("spear", 1) < (int)me->query_skill("bawang-spear", 1))
    return notify_fail("你的基本枪法水平有限，无法领会更高深的霸王枪。\n");
  return 1;
}

int valid_enable(string usage)
{
  return (usage=="spear") || (usage=="parry");
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;
  mapping *m_actions;
  pfm_num = (int)me->query_temp("BWQ_perform");
  level = query_skill_lvl(me,"bawang-spear",action);

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  if(me->query("skill_bawang-spear")==0)
    return action[random(level + 1)];
  else if(random(4))
    return action[random(level + 1)];
  else
  {
    m_actions=me->query("skill_bawang-spear");
    return element_of(m_actions);
  }

  return action[0];
}

int practice_skill(object me)
{
  object weapon;
  if( !objectp(weapon = me->query_temp("weapon"))
     ||(string)weapon->query("skill_type") != "spear" )
    return notify_fail("你必须先找一柄长枪或者是类似的武器，才能练枪法。\n");
  if( (int)me->query("kee") < 30
    ||(int)me->query("force") < 5  )
    return notify_fail("你的体力不够练这门枪法，还是先休息休息吧。\n");
  me->receive_damage("kee", 80);
  me->add("force", -40);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("bawang-spear",1);
  if (level > action[i]["lvl"])
    return RED"十步杀一人，千里不留行。\n"NOR;

  level = query_skill_lvl(me,"bawang-spear",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习霸王枪法！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("fighter") + "/bawang-spear/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 110;
}

int effective_parry_level()
{
  return 120;
}

int query_effect_parry(object me, object victim)
{
  return 110;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 10  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("bawang-spear",1);
  level = query_skill_lvl(me,"bawang-spear",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了霸王枪的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
  if(m_skill>action[i]["lvl"] && m_skill%10==0)
  {
    tell_object(me,HIW"你对霸王枪法的领悟加深了，你的霸王枪法进入了一个新的境界！\n"NOR);
    if(me->query("zichuang/times")>7)
    {
       tell_object(me,HIW"然而你的功夫已经练至顶峰，不能再创出新招了。\n"NOR);
       return;
    }

    if(random(me->query("kar"))<20)
    {
       tell_object(me,HIW"然而你的心中居然产生了一种失落感！\n"NOR);
       return;
    }

    if((random(me->query("int")/2)+(int)me->query_skill("literate")/50)<10)
    {
      tell_object(me,HIW"然而你的心中升起一种惆怅的感觉，仿佛有一丝重要的东西没有抓住。\n"NOR);
      return;
    }

    tell_object(me,HIW"你突然福至心灵，对霸王枪法领悟出了一招新的用法！\n"NOR);
    tell_object(me,"请为这招取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
  }

  return;
}

void name_skill(object me, string arg)
{
  mapping* m_actions;
  mapping m_act=([]);
  int content, i=strlen(arg);
  string msg;
  int name_count;

  name_count = me->query_temp("skill_name_count");
  m_actions=me->query("skill_bawang-spear");
  if(!pointerp(m_actions)) m_actions=({});
  content=me->query("str")+2*me->query_skill("unarmed",1)/10;
  m_act+=(["damage":content]);
  content=-me->query("spi");
  m_act+=(["dodge" :content]);
  content=-me->query("cps");
  m_act+=(["parry" :content]);
  content=me->query("con")+2*me->query_skill("force",1)/10;
  m_act+=(["force" :content]);
  m_act+=(["damage_type":"刺伤"]);
  if (!arg || arg=="")
  {
    tell_object(me,"请为你的新招式取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
    return;
  }

  else while(i--)
  {
    if( arg[i]<=' ' )
    {
      tell_object(me,"招式名字不能使用控制字元，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

    if(strsrch(arg, "  ") >= 0)
    {
      tell_object(me,"招式名字不能有空格，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

    if(  !is_chinese(arg[i..i]) )//i%2==0 &&
    {
      tell_object(me,"请您用「中文」为你的新招式取名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

  }

  if (!valid_name(arg))
  {
    tell_object(me,"对不起，这种名字会造成其他人的困扰。请重新设定一个名字：");
      name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  if( (strlen(arg) < 4) || (strlen(arg) > 8 ) )
  {
    tell_object(me,"对不起，招式名字必须是 ４ 到 ８ 个中文字：");
    name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  m_act+=(["name":arg]);
  msg= element_of(skill_head)+BLINK+MAG"「"+arg+"」"NOR
                  +element_of(skill_tail);
  m_act+=(["action":msg]);
  m_actions+=({m_act});
  me->set("skill_bawang-spear",m_actions);
  me->add("zichuang/times",1);
  me->delete_temp("skill_name_count");
}