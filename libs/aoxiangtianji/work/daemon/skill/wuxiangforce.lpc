#include <ansi.h>
inherit FORCE;
int valid_enable(string usage) { return usage=="force"; }

int valid_learn(object me)
{
  if(me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("[小无相]是方寸山三星洞不传之密！\n");
  if( (int)me->query_skill("force", 1) < 10
   || (int)me->query_skill("force", 1) <= (int)me->query_skill("wuxiangforce", 1) )
    return notify_fail("你的内功底子太差了，无法学习小无相功。\n");

   return 1;
}

int practice_skill(object me)
{
  return notify_fail("小无相功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
  if(me->query("family/family_name") != "方寸山三星洞")
    return 0;

  if( damage_bonus < 100 )
    return 0;

  if( (me->query_skill("wuxiangforce") > 120) && (me->query("force") > 1500)
      && random(10)>8 )
  {
    victim->receive_wound("kee", damage_bonus,me);
    if (!victim->is_busy())
      victim->start_busy(1);
    return HIY"$N" HIY"小无相劲力周转，$n" HIY"身不由己被带动，猛得觉得内息一滞！\n"NOR;
  }

  return 0;
}

mixed valid_damage(object ob,object me,int damage)
{
  object weapon;
  int skill_lev,myforce,yourforce ;
  int my_skill, your_skill;
  int dam ;
  string msg;
  if(me->query("family/family_name") != "方寸山三星洞")
    return 0;

  myforce = (int)me->query("force");
  yourforce = (int)ob->query("force");
  skill_lev = (int)me->query_skill("wuxiangforce",1);
  dam = 0;
  msg = "";

  if (random(3)==1 && me->query_temp("jldl"))
  {
    dam = (int)me->query_temp("apply/force_apply");
    dam += (int)me->query("force_factor")/3;
    dam += random(skill_lev);
    weapon = ob->query_temp("weapon");
    if (objectp(weapon))
      msg = HIG"$n" HIG"轻轻一拨，" HIG"$N" HIG"顿时觉得内力逆转，" + weapon->name()
          + HIG"向着自己的身体直撞过去！\n"NOR;
    else
      msg = HIG"$n" HIG"轻轻一拨，" HIG"$N" HIG"顿时觉得内力逆转，拳头向着自己的身体直撞过去！\n"NOR;
    my_skill = me->query_skill("force");
    your_skill = ob->query_skill("force");
    if (my_skill*100/(my_skill+2*your_skill) > random(100))
    {
      if (random(2))
      {
        if (random(2))
          msg += HIW"$N" HIW"急忙一个懒驴打滚，灰头土脸的躲开了。\n"NOR;
        else
          msg += HIW"$N" HIW"见势不妙，急忙收力，把这反戈的一击消除了。\n"NOR;
        return (["msg" : msg,
                 "damage" : -damage,
               ]);
      }

      else
      {
        if (random(2))
          msg += HIR"$N" HIR"猝不及防，结果被这翻转一击打个正着。\n"NOR;
        else
          msg += HIM"$N" HIM"没有料到" HIM"$n有如此强的内力反击，顿时被这翻转一击打得晕头转向了！\n"NOR;
        ob->receive_damage("kee",1+dam,me);
        ob->receive_wound("kee",1+random(dam+1),me);
        return (["msg" : msg,
                 "damage" : -damage,
               ]);
      }

    }

    else
    {
      if (random(myforce + yourforce) > yourforce/4*5)
      {
        if (random(2))
          msg += HIY"$N" HIY"强运内力，企图击破" HIY"$n" HIY"借力打力的效用。\n"
                    "无奈内力略显不足，只得勉强削弱攻击，略微躲闪，先消解了反击！\n"NOR;
        else
          msg += HIY"$N" HIY"内力强行运转一周，想用内力压回" HIY"$n"
                 HIY"的借力打力。\n可惜内力的运转并不是很理想，也只能先闪在一边，"
                 "躲过反戈一击。\n"NOR;
        return (["msg" : msg,
                 "damage" : -damage/3*2,
               ]);
      }

      else
      {
         msg += HIW"$N" HIW"强运内力运转，用内力压制了" HIW"$n" HIW"的借力打力作用！\n"NOR;
        return (["msg" : msg,
                 "damage" : -damage/3,
               ]);
      }

    }

  }

  if (skill_lev > 150 )
  {
    if (random(3)==1)
    {
      if (random(myforce + yourforce) > (yourforce*3)/2)
      {
        msg =  HIY"$n小无相流转间，$N直觉得一股力道反击了回来！\n"NOR;
        if (random(4))
        {
          msg += HIY"内力反震，$N只觉得双臂发麻，体内翻江倒海。看来是受了点内伤了！\n"NOR;
          dam = (int)me->query("force_factor");
          if (dam > 0)
            ob->receive_wound("kee", dam,me);
        }

        dam = damage/3 + random(damage/2) + random(skill_lev);
        return (["msg" : msg,
                 "damage" : -dam,
               ]);
      }

      else if (random(myforce + yourforce) > yourforce)
      {
        msg = HIY"$n运起小无相，消解了部分的伤害！\n"NOR;
        if (random(4) == 0)
          dam = damage/3 + random(skill_lev) ;
        else
          dam = damage/4 + random(skill_lev);
        return (["msg" : msg,
                 "damage" : -dam,
               ]);
      }

      else if (random(3))
      {
        msg = HIY"$n运起小无相，消解了些许的伤害！\n"NOR;
        dam = damage/5 + random(skill_lev);
        return (["msg" : msg,
                 "damage" : -dam,
               ]);
      }

    }

  }

  return 0;
}

int query_power_effect(object me)
{
  int force_skill ;

  force_skill = (int)me->query_skill("wuxiangforce",1);
  if (force_skill < 100)
    return 100;
  else if (force_skill < 200)
    return 110 ;
  else if (force_skill < 300)
    return 120;
  return 130;
}

string exert_function_file(string func)
{
  return CLASS_D("puti") + "/wuxiangforce/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 12  ,
         ]);
}

