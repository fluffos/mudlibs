inherit SKILL;
int valid_enable(string usage)
{
  return usage=="spells";
}

int valid_learn(object me)
{
  return 0;
}

string scribe_spell_file(string spell)
{
  return CLASS_D("common") + "/xiyang-spells/" + spell;
}

string type()
{
  return "magic";
}

string query_shuxing() {return "jin";}

int query_power_effect(object me)
{
  return 100;
}