// xiyang-boji.c 中亚轻身术
inherit SKILL;
string *dodge_msg = ({
  "$n步子斜跨，恰好躲过了$N这一招。\n",
  "可是$n突然飞身后退，敏捷的躲过了$N这一招。\n",
  "$n突然横移，闪开了$N的追击。\n",
  "$n身形转动，忽快忽慢，让$N无法捕捉到$n的踪影。\n",
  "$n大喝一声，身形突的拔高，$N眼一花，招数全然落空。\n",
});
int valid_enable(string usage) { return usage == "dodge"; }

int valid_learn(object me) { return 0; }

string query_dodge_msg(string limb)
{
  return element_of(dodge_msg);
}