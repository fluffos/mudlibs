  ]),
});
int valid_enable(string usage)
{
  return usage == "blade" || usage == "parry";
}

int valid_learn(object me)
{
  return 0;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  pfm_num = me->query_temp("YYB_perform");
  level = query_skill_lvl(me,"yuanyue-blade",action);

  if(pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

string perform_action_file(string action)
{
  return "/daemon/class/common/yuanyue-blade/"+action;
}