    "damage" : 20,
    "dodge"  : -10,
    "parry"  : 10,
    "lvl"    : 0,
    "damage_type" : "割伤",
  ]),
  (["action" : "$N刀锋自下而上划了个半弧，$w一提一收，平刃挥向$n的颈部",
    "force"  : 10,
    "damage" : 30,
    "dodge"  : -5,
    "parry"  : -5,
    "lvl"    : 30,
    "damage_type" : "割伤",
  ]),
