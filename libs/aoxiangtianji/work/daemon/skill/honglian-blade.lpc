int valid_enable(string usage)
{
  return usage == "blade" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习红莲刀！\n");
  if( (int)me->query("max_force") < 50 )
    return notify_fail("你的内力不够，没有办法练红莲刀。\n");
  if( !(ob = me->query_temp("weapon"))
   ||  (string)ob->query("skill_type") != "blade" )
    return notify_fail("你必须先找一把刀才能练刀法。\n");
  if ((int)me->query_skill("blade",1) < (int)me->query("honglian-blade",1))
    return notify_fail("你的基本刀法太差了，无法练习红莲刀！\n");
//  if ((int)me->query_skill("huoyan-blade",1))
//    return notify_fail("你已经学会了火焰刀法，没有必要练习红莲刀了！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num , level;

  level = query_skill_lvl(me,"honglian-blade",action);
  pfm_num = me->query_temp("HLB_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  object weapon;
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习红莲刀！\n");
  if( !objectp(weapon = me->query_temp("weapon"))
  ||      (string)weapon->query("skill_type") != "blade" )
    return notify_fail("你必须先找一把刀或者是类似的武器，才能练刀法。\n");
  if( (int)me->query("kee") < 50
  ||    (int)me->query("force") < 50  )
    return notify_fail("你的体力不够练这门刀法，还是先休息休息吧。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("honglian-blade",1);
  if (level > action[i]["lvl"])
    return HIR"烈焰红如血，莲花白更洁。\n"NOR;

  level = query_skill_lvl(me,"honglian-blade",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习红莲刀！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("kusong") + "/honglian-blade/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 15;
}

int practice_bonus()
{
  return 10;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("honglian-blade",1);
  level = query_skill_lvl(me,"honglian-blade",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了红莲刀的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

