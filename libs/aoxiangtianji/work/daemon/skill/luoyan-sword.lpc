#include <ansi.h>
inherit SKILL;
mapping *action = ({
  (["name"  : HIW"「回剑式」"NOR,
    "action" :
"$N手中$w一转，回身一剑，刺向$n$l，正是一招「回剑式」",
    "damage" : 15,
    "dodge"  : 20,
    "parry"  : 20,
    "lvl"    : 0,
    "damage_type" : "刺伤",
  ]),
  (["name"   : HIW"「拂风式」"NOR,
    "action" :  "只见$N身法陡然加快，施展出「拂风式」，剑风荡漾，$w瞬间已至$n$l",
    "damage" : 20,
    "dodge"  : 15,
    "parry"  : 15,
    "lvl"    : 50,
    "damage_type" : "刺伤",
  ]),
  (["name"   : HIW"「落剑式」"NOR,
    "action" : "$N纵身跃起，使出一招「落剑式」，陡见$w从半空直指$N$l",
    "damage" : 30,
    "dodge"  : 10,
    "parry"  : 10,
    "lvl"    : 100,
   "damage_type" : "刺伤",
  ]),
  (["name"   : HIW"「雁翔式」"NOR,
    "action" : "$N腾空而起，一招「雁翔式」来势又准又快，手中$w已到$n$l",
    "damage" : 40,
    "dodge"  : 5,
    "parry"  : 5,
    "lvl"    : 120,
    "damage_type" : "刺伤",
  ]),
  (["name"   : HIW"「平剑式」"NOR,
    "action" : "$N剑峰忽转，一剑笔直地向$n$l刺来，内劲十足，正是一招「平剑式」",
    "damage" : 50,
    "dodge"  : 0,
    "parry"  : 0,
    "lvl"    : 150,
    "damage_type" : "刺伤",
  ]),
  (["name"   : HIW"「凝剑式」"NOR,
    "action" : "$N手中$w猛然回撤，紧接着一剑，气势磅礴，剑气纵横，正是「凝剑式」",
    "damage" : 60,
    "dodge"  : -10,
    "parry"  : -10,
    "lvl"    : 180,
    "damage_type" : "刺伤",
  ]),
});
string main_skill() { return "xiaofeng-sword"; }

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "五庄观")
    return notify_fail("落雁剑是五庄观不传之密！\n");
  if( (int)me->query("max_force") < 100 )
    return notify_fail("你的内力不够，没有办法练落雁剑。\n");
  if( !(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "sword" )
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  if (me->query_skill("sword",1) < me->query_skill("luoyan-sword",1))
    return notify_fail("你的基础剑术不够高，练不了落雁剑！\n");

  if (me->query_skill("xiaofeng-sword",1))
    return notify_fail("你已经学会了晓风残月剑法，没有必要再单独练习落雁剑！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;
  level = query_skill_lvl(me,"luoyan-sword",action);
  pfm_num = me->query_temp("LYS_perform");
  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 80
   || (int)me->query("force") < 80 )
    return notify_fail("你的内力或气不够，没有办法练习落雁剑。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("luoyan-sword",1);
  if (level > action[i]["lvl"])
    return HIW"一剑落雁，快疾如风。\n"NOR;

  level = query_skill_lvl(me,"luoyan-sword",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习落雁剑！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file( string action)
{
   return CLASS_D("zhenyuan") + "/luoyan-sword/" + action;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 15;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 20  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("luoyan-sword",1);
  level = query_skill_lvl(me,"luoyan-sword",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了落雁剑的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}