// force.c
#include <ansi.h>
inherit SKILL;
int valid_learn(object me) {return 1;}

string exert_function_file(string func)
{
  return "/daemon/class/force/" + func;
}

void skill_improved(object me)
{
  int force_skill = me->query_skill("force",1);

  if (force_skill > 30)
  {
    if (!me->query("common/can_exert/recover"))
      me->set("common/can_exert/recover",1);
    if (!me->query("common/can_exert/refresh"))
      me->set("common/can_exert/refresh",1);
  }

  if (force_skill > 50)
    if (!me->query("common/can_exert/heal"))
      me->set("common/can_exert/heal",1);

  if (force_skill > 80)
    if (!me->query("common/can_exert/dispel"))
      me->set("common/can_exert/dispel",1);
  if (force_skill > 100)
  {
    if (!me->query("common/can_exert/lifeheal"))
      me->set("common/can_exert/lifeheal",1);
    if (!me->query("common/can_exert/inspire"))
      me->set("common/can_exert/inspire",1);
    if (!me->query("common/can_exert/powerup"))
      me->set("common/can_exert/powerup",1);
    if ((int)me->query_skill("makeup",1) > 100 )
    {
      if (!me->query("common/can_exert/younger"))
        me->set("common/can_exert/younger",1);
      if (!me->query("common/can_exert/older"))
        me->set("common/can_exert/older",1);
    }

  }

}

