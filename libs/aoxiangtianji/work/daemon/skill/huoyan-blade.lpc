    "damage_type" : "震伤",
  ]),
  (["name"  : HIR"「刀山火海」"NOR,
    "action": "$N使出一招「刀山火海」，手中$w急晃劈出，顿时万千刀光从四面八方攻向$n",
    "damage": 40,
    "force" : 30,
    "dodge" : -5,
    "parry" : -5,
    "lvl"   : 200,
    "damage_type" : "劈伤",
  ]),
  (["name"  : HIR"「火内莲花」"NOR,
    "action": "$N使出一招「火内莲花」，左手内收，右手$w随着身行的转动，化做一道刀光砍向$n",
    "damage": 50,
    "force" : 30,
    "dodge" : -5,
    "parry" : 10,
    "lvl"   : 250,
    "damage_type" : "砍伤",
  ]),
});
int valid_enable(string usage)
{
  return usage == "blade" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习火焰刀！\n");
  if( (int)me->query("max_force") < 1000 )
    return notify_fail("你的内力不够，没有办法练火焰刀。\n");
  if( !(ob = me->query_temp("weapon"))
   ||  (string)ob->query("skill_type") != "blade" )
    return notify_fail("你必须先找一把刀才能练刀法。\n");
  if ((int)me->query_skill("blade",1) < (int)me->query("huoyan-blade",1))
    return notify_fail("你的基本刀法太差了，无法练习火焰刀！\n");
  if ((int)me->query_skill("honglian-blade",1) < 150)
    return notify_fail("你的红莲刀法太差了，没有办法学习火焰刀！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num , level;

  level = query_skill_lvl(me,"huoyan-blade",action);
  pfm_num = me->query_temp("HYB_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  object weapon;
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习火焰刀刀！\n");
  if( !objectp(weapon = me->query_temp("weapon"))
  ||      (string)weapon->query("skill_type") != "blade" )
    return notify_fail("你必须先找一把刀或者是类似的武器，才能练刀法。\n");
  if( (int)me->query("kee") < 100
  ||    (int)me->query("force") < 100  )
    return notify_fail("你的体力不够练这门刀法，还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("huoyan-blade",1);
  if (level > action[i]["lvl"])
    return HIR"刀似火焰火如刀。\n"NOR;

  level = query_skill_lvl(me,"huoyan-blade",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习火焰刀！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("kusong") + "/huoyan-blade/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 15  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("huoyan-blade",1);
  level = query_skill_lvl(me,"huoyan-blade",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了火焰刀的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

