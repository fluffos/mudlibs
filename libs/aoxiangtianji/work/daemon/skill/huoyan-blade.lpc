  (["name"  : HIM"「钻木取火」"NOR,
    "action": "$N使出一招「钻木取火」，飞身急转，手中$w斜劈$n",
    "damage": 20,
    "force" : 10,
    "dodge" : 15,
    "parry" : 15,
    "lvl"   : 0,
    "damage_type" : "劈伤",
  ]),
  (["name"  : HIM"「祝融怀焰」"NOR,
    "action": "$N使出一招「祝融怀焰」，身形飞起，手中$w力劈$n的$l",
    "damage": 20,
    "force" : 20,
    "dodge" : 10,
    "parry" : 20,
    "lvl"   : 50,
    "damage_type" : "劈伤",
  ]),
  (["name"  : HIW"「风火无边」"NOR,
    "action": "$N使出一招「风火无边」，右手刀虚晃，左手掌突的拍出，一道内力自掌中攻向$n的$l",
    "damage": 20,
    "force" : 20,
    "dodge" : 5,
    "parry" : 5,
    "lvl"   : 100,
    "damage_type" : "震伤",
  ]),
  (["name"  : HIW"「双龙吐焰」"NOR,
    "action": "$N使出一招「双龙吐焰」，手中$w交叉劈错，带动两道内力交叉攻向$n的$l",
    "damage": 30,
    "force" : 20,
    "dodge" : 0,
    "parry" : 0,
