string main_skill() { return "hellfire-whip"; }

int valid_enable(string usage)
{
  return usage == "whip" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习冥王鞭！\n");
  if ((int)me->query_skill("hellfire-whip",1))
    return notify_fail("你已将这种鞭法融入烈火鞭，不必再分开练习了。\n");

  if( (int)me->query("max_force") < 500 )
    return notify_fail("你的内力不够，没有办法学习冥王鞭。\n");

  if( !(ob = me->query_temp("weapon"))
     || (string)ob->query("skill_type") != "whip" )
    return notify_fail("你必须先找一根鞭子才能学习冥王鞭。\n");

  if ((int)me->query_skill("whip",1) < (int)me->query_skill("mingwang-whip",1))
    return notify_fail("你的基础鞭术太低了，无法学习冥王鞭！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;
  level = query_skill_lvl(me,"mingwang-whip",action);
  pfm_num = (int)me->query_temp("MWW_perform");

  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习冥王鞭！\n");
  if ((int)me->query_skill("hellfire-whip",1))
    return notify_fail("你已将这种鞭法融入烈火鞭，不必再分开练习了。\n");
  if( (int)me->query("kee") < 50
   || (int)me->query("force") < 50 )
    return notify_fail("你的内力或气不够，没有办法练习冥王鞭。\n");
  me->receive_damage("kee", 30);
  me->add("force", -15);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("mingwang-whip",1);
  if (level > action[i]["lvl"])
    return HIY"冥王不动，动转若飞。\n"NOR;

  level = query_skill_lvl(me,"mingwang-whip",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习冥王鞭！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("ghost") + "/mingwang-whip/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("mingwang-whip",1);
  level = query_skill_lvl(me,"mingwang-whip",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了冥王鞭的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}