#include <ansi.h>
inherit SKILL;
mapping *action = ({
  (["name"   : HIB"「万里乌云」"NOR,
    "action" :  "$N手中$w平平一刀，一式「万里乌云」，挥向$n$l",
    "damage" :  20,
    "dodge"  :  10,
    "parry"  :  10,
    "lvl"    :  0,
    "damage_type":  "刺伤",
  ]),
  (["name"   : HIB"「云深雾锁」"NOR,
    "action" :  "$N手中$w自空而下，一式「云深雾锁」，劈向$n$l",
    "damage" :  30,
    "dodge"  :  5,
    "parry"  :  5,
    "lvl"    :  50,
    "damage_type":  "砍伤",
  ]),
  (["name"  : HIM"「五雷轰顶」"NOR,
    "action" :  "刀光闪烁间，$N腾空而起，半空直下，一式「五雷轰顶」"
                "，手中$w已经到$n$l",
    "damage" :  40,
    "dodge"  :  0,
    "parry"  :  0,
    "lvl"    :  100,
    "damage_type":  "刺伤",
  ]),
  (["name"  : HIM"「风声萧萧」"NOR,
    "action" :  "$N不慌不忙，一式「风声萧萧」，手中$w反转不定，猛地"
                "一刀砍向$n$l",
    "damage" :  50,
    "dodge"  :  -5,
    "parry"  :  -5,
    "lvl"    :  150,
    "damage_type":  "刺伤",
  ]),
  (["parry"  : HIG"「力劈群山」"NOR,
    "action" : "$N双手握刀，一式「力劈群山」，手中$w自上而下，如长龙"
               "般而下，砍向$n$l",
    "damage" :  60,
    "dodge"  :  -10,
    "parry"  :  -10,
    "lvl"    :  180,
    "damage_type":  "刺伤",
  ]),
});
string main_skill() { return "yange-blade"; }

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "五庄观")
    return notify_fail("落日刀是五庄观不传之密！\n");

  if( (int)me->query("max_force") < 100 )
    return notify_fail("你的内力修为不够深，落日刀学了也没用。\n");
  if (!(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "blade" )
    return notify_fail("你必须先找一柄刀才能练习刀法。\n");
  if (me->query_skill("blade",1) < me->query_skill("luori-blade",1))
    return notify_fail("你的基本刀法不够，学不了落日刀了！\n");

  if (me->query_skill("yange-blade",1))
    return notify_fail("你已经学会了雁歌刀法，再学落日导刀没有什么用了！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage == "blade" || usage == "parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;
  level = query_skill_lvl(me,"luori-blade",action);
  pfm_num = me->query_temp("LRB_perform");
  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 120
   || (int)me->query("force") < 120 )
    return notify_fail("你的内力或气不够，没有办法练习落日刀。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("luori-blade",1);
  if (level > action[i]["lvl"])
    return HIW"落日余晖总有意，却那堪大漠黄沙吹。\n"NOR;

  level = query_skill_lvl(me,"luori-blade",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习落日刀！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file( string action)
{
   return CLASS_D("zhenyuan") + "/luori-blade/" + action;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 16;
}

int practice_bonus()
{
  return 10;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 20  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("luori-blade",1);
  level = query_skill_lvl(me,"luori-blade",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了落日刀的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}