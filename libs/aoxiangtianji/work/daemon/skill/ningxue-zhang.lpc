int valid_enable(string usage) { return usage == "unarmed"; }

int valid_learn(object me)
{
  if(me->query("family/family_name")!="大雪山")
    return notify_fail("凝血掌必须是大雪山弟子才能练。\n");
  if( (string)me->query_skill_mapped("force")!= "ningxue-force")
    return notify_fail("凝血掌必须配合冰谷凝血功才能练。\n");
  if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
    return notify_fail("练凝血掌必须空手。\n");
  if ((int)me->query_skill("unarmed",1) < (int)me->query_skill("ningxue-zhang",1))
    return notify_fail("你的拳脚功夫太低了，无法练习凝血掌");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  level = query_skill_lvl(me,"ningxue-zhang",action);
  pfm_num = me->query_temp("NXZ_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("sen") < 60)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if( (int)me->query("kee") < 60 )
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if( (int)me->query("force") < 60 )
    return notify_fail("你的内力不够了。\n");
  me->receive_damage("kee", 20);
  me->receive_damage("sen", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("ningxue-zhang",1);
  if (level > action[i]["lvl"])
    return HIW"凝血劲发，无坚不摧。\n"NOR;

  level = query_skill_lvl(me,"ningxue-zhang",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习凝血掌！对%s这招有了进一步的了解！\n",sk_name);
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
  int lvl;
  int flvl;
  if (userp(me) && (string)me->query("family/family_name") != "大雪山" )
    return 0;

  lvl  = me->query_skill("ningxue-zhang", 1) + me->query_skill("poison");
  lvl /= 2;
  flvl = me->query("force_factor");
  if (lvl < 80 || flvl < 40 || !damage_bonus)
    return 0;
  if (random(3))
    return 0;

  if (flvl * 2 + random(lvl) > victim->query_skill("force") &&
            victim->affect_by("ningxue_force",
                              ([ "level" : flvl/2 + random(flvl),
                                 "id"    : me->query("id"),
                                 "duration" : lvl / 100 + random(lvl / 50) ])))
  {
    return HIR "只听$n" HIR "一声惨嚎，看来受到了凝血毒劲的干扰！\n" NOR;
  }

}

string perform_action_file(string func)
{
  return CLASS_D("xueshan") + "/ningxue-zhang/"+func;
}

int expell_delete()
{
  return 1;
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("ningxue-zhang",1);
  level = query_skill_lvl(me,"ningxue-zhang",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了凝血掌的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }

}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 190 ,
           "effect"      : 10  ,
         ]);
}

