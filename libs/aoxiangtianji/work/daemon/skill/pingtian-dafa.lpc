inherit SKILL;
int valid_enable(string usage)
{
  return usage=="spells";
}

int valid_learn(object me)
{
  if( (int)me->query_skill("spells", 1) < 10
   || (int)me->query_skill("spells", 1) <= (int)me->query_skill("pingtian-dafa", 1) )
    return notify_fail("你的法术修为还不够高深，无法学习平天术．\n");

  if(me->query("family/family_name")!="火云洞")
    return notify_fail("你不是火云弟子，不能学习平天术！\n");
  return 1;
}

string cast_spell_file(string spell)
{
  return CLASS_D("kusong") + "/pingtian-dafa/" + spell;
}

string type() { return "magic"; }

string query_shuxing() {return "huo";}

int query_power_effect(object me)
{
  int force_skill ;
  int base_num, day_phase;
  object where;
  string weather, terrain;

  base_num = 100;
  day_phase = NATURE_D->query_current_day_phase();
  where = environment(me);
  if (objectp(where))
  {
    terrain = where->query_terrain();
    if (!terrain)
      terrain = where->query("terrain");
    if (!terrain)
      terrain = "land";
  }

  if ((day_phase == 0) || (day_phase > 4))
    base_num -= 10;
  else if (day_phase != 1)
    base_num += 10;

  weather = NATURE_D->query_weather();

  if (stringp(terrain) && terrain == "sand")
    base_num += 10;
  else if (stringp(terrain) && terrain == "hill")
    base_num += 8;
  else if (stringp(terrain) && terrain == "water")
    base_num -= 10;
  else if (stringp(terrain) && terrain == "muddy")
    base_num -= 8;
  if (stringp(weather) && weather == "sun")
    base_num += 10 ;
  if (stringp(weather) && weather == "wind")
    base_num += 5 ;
  else if (stringp(weather) && weather == "rain")
    base_num -= 12;

  force_skill = (int)me->query_skill("pingtian-dafa",1);
  if (force_skill < 150)
    return base_num;
  else if (force_skill < 220)
    return base_num + 5 ;
  return base_num + 10;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 12  ,
         ]);
}

