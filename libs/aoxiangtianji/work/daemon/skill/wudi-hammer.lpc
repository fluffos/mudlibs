int valid_learn(object me)
{
  object ob;

  if(me->query("family/family_name")!="将军府")
    return notify_fail("你不是将军府的弟子，没有办法理解无敌锤。\n");
  if( (int)me->query("max_force") < 2000 )
    return notify_fail("你的内力不够，没有办法练无敌锤。\n");
  if( !(ob = me->query_temp("weapon"))
  ||      (string)ob->query("skill_type") != "hammer" )
    return notify_fail("你必须先找一柄大锤才能练无敌锤。\n");
  if ((int)me->query_skill("lengquan-force",1) < 200)
    return notify_fail("你的冷泉神功等级不够，无法自如运用无敌锤！\n");
  if( (string)me->query_skill_mapped("force")!= "lengquan-force")
    return notify_fail("无敌锤必须配合将军府的冷泉神功才能练。\n");
  if ((int)me->query_skill("hammer", 1) < (int)me->query_skill("wudi-hammer", 1))
    return notify_fail("你的基本锤法水平有限，无法领会更高深的无敌锤。\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="hammer" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;

  level = query_skill_lvl(me,"wudi-hammer",action);
  pfm_num = me->query_temp("WDH_perform");
  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if(me->query("family/family_name")!="将军府")
    return notify_fail("你不是将军府的弟子，没有办法理解无敌锤。\n");

  if( (int)me->query("kee") < 200
    || (int)me->query("force") < 200 )
    return notify_fail("你的内力或气不够，没有办法练习无敌锤。\n");

  me->receive_damage("kee", 80);
  me->add("force", -50);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("wudi-hammer",1);
  if (level > action[i]["lvl"])
    return WHT"雷神一怒无人敌。\n"NOR;

  level = query_skill_lvl(me,"wudi-hammer",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习无敌锤！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("fighter") + "/wudi-hammer/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 120;
}

int effective_parry_level()
{
  return 105;
}

int query_effect_parry(object me, object victim)
{
  return 105;
}

int learn_bonus()
{
  return 4;
}

int practice_bonus()
{
  return 2;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("wudi-hammer",1);
  level = query_skill_lvl(me,"wudi-hammer",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了无敌锤的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

