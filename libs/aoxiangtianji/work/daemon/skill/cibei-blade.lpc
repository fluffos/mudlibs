  ]),
});
int valid_enable(string usage)
{
  return usage == "blade" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if((string)me->query("family/family_name") != "南海普陀山")
    return notify_fail("不是普陀山弟子，怎么可以学习慈悲刀呢？\n");
  if( (int)me->query("max_force") < 1000 )
    return notify_fail("你的内力不够，没有办法学慈悲刀，等内力提高了再来吧。\n");
  if( !(ob = me->query_temp("weapon"))
  ||      (string)ob->query("skill_type") != "blade" )
    return notify_fail("你必须先找一把刀才能学慈悲刀。\n");
  if ((int)me->query_skill("blade",1) < (int)me->query_skill("cibei-blade",1))
    return notify_fail("你的基本杖法太低了，无法学习慈悲刀！\n");

  if ((int)me->query_skill("buddhism",1) < 100)
    return notify_fail("你的佛法太低了！这样去学慈悲刀是没有什么用的！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  level = query_skill_lvl(me,"cibei-blade",action);
  pfm_num = me->query_temp("CBB_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 50
    || (int)me->query("force") < 50 )
    return notify_fail("你的内力或气不够，没有办法练习慈悲刀。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("cibei-blade",1);
  if (level > action[i]["lvl"])
    return WHT"慈悲刀下渡慈悲。\n"NOR;

  level = query_skill_lvl(me,"cibei-blade",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习慈悲刀！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("bonze") + "/cibei-blade/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("cibei-blade",1);
  level = query_skill_lvl(me,"cibei-blade",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了慈悲刀的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}