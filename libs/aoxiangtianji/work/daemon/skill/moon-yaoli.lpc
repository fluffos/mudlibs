// moon-yaoli.c
inherit SKILL;
string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "medical"; }

int valid_learn(object me)
{
  if(me->query("family/family_name")!="月宫")
    return notify_fail("你不是月宫的弟子，没有办法理解圆月药理。\n");

  if ((int)me->query_skill("medical", 1) < 100)
    return notify_fail("你的基本医术造诣太浅，无"
                       "法领会深奥的圆月药理。\n");
  if ((int)me->query_skill("medical", 1) < (int)me->query_skill("moon-yaoli", 1))
    return notify_fail("你的基本医术水平有限，无"
                       "法掌握更深奥的圆月药理。\n");
  return 1;
}

void skill_improved(object me)
{
  if (me->query_skill("moon-yaoli",1) > 80)
    me->set("can_make/lengyue",80);
}

