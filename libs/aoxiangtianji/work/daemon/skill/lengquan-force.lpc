#include <ansi.h>
inherit FORCE;
int valid_enable(string usage) { return usage=="force"; }

int valid_learn(object me)
{
  if(me->query("family/family_name") != "将军府")
    return notify_fail("[冷泉神功]是将军府的不传之密！\n");
  if( (int)me->query_skill("force", 1) < 10
   || (int)me->query_skill("force", 1) <= (int)me->query_skill("lengquan-force", 1) )
    return notify_fail("你的内功底子太差了，无法学习冷泉神功。\n");

   return 1;
}

int practice_skill(object me)
{
  return notify_fail("冷泉神功只能向师父学，或是从运用(exert)中增加熟练度。\n");
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
  if(me->query("family/family_name") != "将军府")
    return 0;

  if( damage_bonus < 100 )
    return 0;

  if( (me->query_skill("lengquan-force") > 120) && (me->query("force") > 1500)
      && random(10)>8)
  {
    victim->receive_wound("kee", damage_bonus/3*2,me);
    return HIY"$N冷泉神功迸发，$n顿觉气息不畅！\n"NOR;
  }

  return 0;
}

mixed valid_damage(object ob,object me,int damage)
{
  int myforce,yourforce ;
  int skill_lev;
  if(me->query("family/family_name") != "将军府")
    return 0;

  myforce = (int)me->query("force");
  yourforce = (int)ob->query("force");
  skill_lev = (int)me->query_skill("lengquan-force",1);

  if (skill_lev > 150 )
  {
    if (random(3) == 0)
    {
      if (random(myforce + yourforce) > yourforce)
      {
        return (["msg" : HIY"$n运起冷泉神功，消解了部分的伤害！\n"NOR,
                 "damage" : -damage/3 - random(skill_lev),
               ]);
      }

      else if (random(myforce + yourforce) > yourforce/3*2)
      {
        return (["msg" : HIY"$n运起冷泉神功，消解了些许伤害！\n"NOR,
                 "damage" : -damage/4 - random(skill_lev),
               ]);
      }

      else if (random(2))
      {
        return (["msg" : HIY"$n运起冷泉神功，消解了部分的伤害！\n"NOR,
                 "damage" : -damage/6 - random(skill_lev),
               ]);
      }

    }

  }

  return 0;
}

int query_power_effect(object me)
{
  int force_skill ;

  force_skill = (int)me->query_skill("lengquan-force",1);
  if (force_skill < 100)
    return 100;
  else if (force_skill < 200)
    return 110 ;
  else if (force_skill < 300)
    return 120;
  else
    return 130;
}

string exert_function_file(string func)
{
  return CLASS_D("fighter") + "/lengquan-force/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 110;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 12  ,
         ]);
}

