  (["name"   : HIY"「黄沙万里」"NOR,
    "action" :  "$N手中$w劈面一刀，一式「黄沙万里」，斩向$n$l",
    "damage" :  20,
    "dodge"  :  20,
    "parry"  :  20,
    "lvl"    :  0,
    "damage_type":  "劈伤",
  ]),
  (["name"   : HIY"「风吹黄沙」"NOR,
    "action" :  "$N手中$w疾如狂风，带着几分狂野，一式「风吹黄沙」，劈向$n$l",
    "damage" :  30,
    "dodge"  :  15,
    "parry"  :  15,
    "lvl"    :  50,
    "damage_type":  "砍伤",
  ]),
  (["name"  : HIM"「大漠狼烟」"NOR,
    "action" :  "$N腾空而起，半空中，手中的$w直劈而下，一式「大漠狼烟」"
                "，这分强悍真让$n有些胆寒",
    "damage" :  40,
    "dodge"  :  10,
    "parry"  :  10,
    "lvl"    :  100,
    "damage_type":  "劈伤",
  ]),
  (["name"  : HIM"「风沙破面」"NOR,
    "action" :  "$N一式「风沙破面」，手中$w刮起阵阵罡风，猛地"
                "一刀砍向$n$l",
    "damage" :  50,
    "dodge"  :  5,
    "parry"  :  5,
    "lvl"    :  150,
    "damage_type":  "劈伤",
  ]),
  (["parry"  : HIY"「笑傲沙野」"NOR,
    "action" : "$N一式「笑傲沙野」，手中$w带着狂笑，如风"
               "般扑向$n",
    "damage" :  60,
    "dodge"  :  0,
    "parry"  :  0,
    "lvl"    :  180,
    "damage_type":  "砍伤",
  ]),
});
string main_skill() { return "yange-blade"; }

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "五庄观")
    return notify_fail("大漠刀是五庄观不传之密！\n");

  if( (int)me->query("max_force") < 200 )
    return notify_fail("你的内力修为不够深，大漠刀学了也没用。\n");
  if (!(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "blade" )
    return notify_fail("你必须先找一柄刀才能练习刀法。\n");
  if (me->query_skill("blade",1) < me->query_skill("damo-blade",1))
    return notify_fail("你的基本刀法不够，学不了大漠刀了！\n");

  if (me->query_skill("yange-blade",1))
    return notify_fail("你已经学会了雁歌刀法，再学大漠刀没有什么用了！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage == "blade" || usage == "parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;
  level = query_skill_lvl(me,"damo-blade",action);
  pfm_num = me->query_temp("DMB_perform");
  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 120
   || (int)me->query("force") < 120 )
    return notify_fail("你的内力或气不够，没有办法练习大漠刀。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("damo-blade",1);
  if (level > action[i]["lvl"])
    return HIW"大漠黄沙万里，常伴豪情壮志。\n"NOR;

  level = query_skill_lvl(me,"damo-blade",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习大漠刀！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file( string action)
{
   return CLASS_D("zhenyuan") + "/damo-blade/" + action;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 22  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("damo-blade",1);
  level = query_skill_lvl(me,"damo-blade",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了大漠刀的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}