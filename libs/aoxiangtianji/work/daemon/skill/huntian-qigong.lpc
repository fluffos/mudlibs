#include <ansi.h>
inherit FORCE;
int valid_enable(string usage)
{
  return usage=="force";
}

int valid_learn(object me)
{
  if((string)me->query("family/family_name")!="陷空山无底洞")
    return notify_fail("不是无底洞的弟子，怎么可以学习混天气功？\n");
  if( (int)me->query_skill("force", 1) < 10
   || (int)me->query_skill("force", 1) <= (int)me->query_skill("huntian-qigong", 1) )
    return notify_fail("你的内功底子太差了，无法学习混天气功。\n");

  return 1;
}

int practice_skill(object me)
{
   return notify_fail("混天气功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
  if(me->query("family/family_name") != "陷空山无底洞")
    return 0;
  if((string)me->query("class") != "yaomo")
    return 0;

  if( damage_bonus < 100 )
    return 0;

  if( ((int)me->query_skill("huntian-qigong",1) > 120)
      && ((int)me->query("force") > 1500)
      && random(10)>8 )
  {
    victim->receive_wound("kee", random(damage_bonus/2) + 1,me);
    return HIY"$N运动混天气功，内力直击$n！\n"NOR;
  }

  return 0;
}

int query_power_effect(object me)
{
  int force_skill ;

  force_skill = (int)me->query_skill("huntian-qigong",1);
  if (force_skill < 150)
    return 100;
  return 110 ;
}

string exert_function_file(string func)
{
  return CLASS_D("wudidong") + "/huntian-qigong/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 10;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 10  ,
         ]);
}

