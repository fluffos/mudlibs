int valid_learn(object me)
{
  if(me->query("family/family_name")!="五庄观")
    return notify_fail("你不是五庄观门人，无法领会五行拳。\n");

  if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
    return notify_fail("练五行拳必须空手。\n");

  if ((int)me->query_skill("unarmed",1) < (int)me->query_skill("wuxing-quan",1))
    return notify_fail("你的基本拳脚太低了，不能练习五行拳！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  pfm_num = me->query_temp("WXQ_perform");
  level = query_skill_lvl(me,"wuxing-quan",action);

  if (pfm_num && (pfm_num < (sizeof(action))))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("sen") < 100)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if( (int)me->query("kee") < 100 )
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if( (int)me->query("force") < 100 )
    return notify_fail("你的内力不够了。\n");
  me->receive_damage("kee", 30);
  me->receive_damage("sen", 30);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("wuxing-quan",1);
  if (level > action[i]["lvl"])
    return WHT"五行俱备，掌裂金石。\n"NOR;

  level = query_skill_lvl(me,"wuxing-quan",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习五行拳！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("zhenyuan") + "/wuxing-quan/" + func;
}

int expell_delete()
{
  return 1;
}

int query_effect_parry(object me, object victim)
{
  return 110;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 2;
}

mapping black_white_ness()
{
  return (["skill_level" : 160 ,
           "effect"      : 15  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("wuxing-quan",1);
  level = query_skill_lvl(me,"wuxing-quan",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了五行拳的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

