// xiyang-jian 西洋剑术
#include <ansi.h>
inherit SKILL;
mapping *action = ({
  (["action" : "$N双目怒睁，手中$w猛然刺出，疾若闪电",
    "force" : 20,
    "damage": 20,
    "dodge" : 10,
    "parry" : 5,
    "lvl"   : 0,
    "damage_type" : "刺伤"
  ]),
  (["action": "$N手中的$w不住的晃动，压向$n，忽然又横挑向$n的$l",
    "force" : 20,
    "damage": 30,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 10,
    "damage_type" : "刺伤"
  ]),
  (["action": "$N手中的$w连续变换几个方向，最后突然直刺$n的$l",
    "force" : 20,
    "lvl"   : 40,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 30,
    "damage_type" : "刺伤"
  ]),
  (["action": "$N手中的$w猛然缩回，随即刺向$n，去势异常凶猛",
    "force" : 30,
    "damage": 50,
    "dodge" : 10,
    "parry" : 0,
    "lvl"   : 50,
    "damage_type" : "刺伤"
  ]),
  (["action": "$N手中$w一沉，斜斜的挑向$n的$l",
    "force" : 30,
    "damage": 60,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 80,
    "damage_type" : "刺伤"
  ]),
  (["action": "$N大喝一声，手中的$w如闪电般刺出，化作满天剑影刺向$n",
    "force" : 40,
    "damage": 70,
    "dodge" : -5,
    "parry" : 10,
    "lvl"   : 100,
    "damage_type" : "刺伤"
  ]),
  (["action": "$N跨前几步，$w奋力前刺，义无反顾的攻向$n",
    "force" : 40,
    "damage": 80,
    "dodge" : 10,
    "parry" : 5,
    "lvl"   : 120,
    "damage_type" : "刺伤"
  ]),
  (["action": "$N猛然弯腰，手中$w忽然一亮，人剑合一飞刺向$n",
    "force" : 40,
    "damage": 90,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 150,
    "damage_type" : "刺伤"
  ]),
});
int valid_enable(string usage)
{
  return usage == "sword" || usage == "parry";
}

int valid_learn(object me)
{
  return 0;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  pfm_num = me->query_temp("XYW_perform");
  level = query_skill_lvl(me,"xiyang-sword",action);

  if(pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

string perform_action_file(string func)
{
  return "/daemon/class/common/xiyang-sword/"+func;
}

