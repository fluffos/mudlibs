int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习月牙铲！\n");
  if( (int)me->query("max_force") < 1500 )
    return notify_fail("你的内力不够，没有办法学月牙铲，等内力提高了再来吧。\n");
  if(  !(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "fork" )
    return notify_fail("你必须先找一条钢叉才能学月牙铲。\n");
  if ((int)me->query_skill("huomoforce",1) < 120)
    return notify_fail("你的火魔心法等级不够，无法自如运用月牙铲！\n");
  if( (string)me->query_skill_mapped("force")!= "huomoforce")
    return notify_fail("月牙铲必须配合火魔心法才能练。\n");
  if ((int)me->query_skill("fork",1) < (int)me->query_skill("yueya-fork",1))
    return notify_fail("你的基本叉法太低了，不能练习月牙铲！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="parry"||usage=="fork";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level ;
  level = query_skill_lvl(me,"yueya-fork",action);
  pfm_num = me->query_temp("YYC_preform");

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 150
  ||      (int)me->query("force") < 150 )
    return notify_fail("你的内力或气不够，没有办法练习月牙铲。\n");

  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习月牙铲！\n");
  me->receive_damage("kee", 40);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("yueya-fork",1);
  if (level > action[i]["lvl"])
    return RED"来如恶狼，去似飞鹰。\n"NOR;

  level = query_skill_lvl(me,"yueya-fork",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习月牙铲！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("kusong") + "/yueya-fork/" + func;
}

int expell_delete()
{
  return 1;
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("yueya-fork",1);
  level = query_skill_lvl(me,"yueya-fork",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了月牙铲的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

int effective_level()
{
  return 110;
}

int learn_bonus()
{
  return 10;
}

int practice_bonus()
{
  return 6;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 10  ,
         ]);
}

