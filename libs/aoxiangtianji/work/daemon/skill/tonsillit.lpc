#include <ansi.h>
inherit FORCE;
int valid_enable(string usage)
{
  return usage=="force";
}

int valid_learn(object me)
{
  if( (int)me->query_skill("force", 1) < 10
   || (int)me->query_skill("force", 1) <= (int)me->query_skill("tonsillit", 1) )
    return notify_fail("你的内功底子太差了，无法学习摄气诀．\n");
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习摄气诀！\n");
  return 1;
}

int practice_skill(object me)
{
  return notify_fail("摄气诀只能用学习或应用中提高！\n");
}

mixed valid_damage(object ob,object me,int damage)
{
  int myforce,yourforce ;
  int skill_lev ;
  if(me->query("family/family_name")!="阎罗地府")
    return 0;

  myforce = (int)me->query("force");
  yourforce = (int)ob->query("force");
  skill_lev = (int)me->query_skill("tonsillit");

  if (skill_lev > 150 )
  {
    if (random(3) == 0)
    {
      if (random(myforce + yourforce) > yourforce)
      {
        return (["msg" : HIY"$n默念摄气诀心法，消解了部分的伤害！\n"NOR,
                 "damage" : -damage/2 - random(skill_lev),
               ]);
      }

      else if (random(myforce + yourforce) > yourforce*2/3)
      {
        return (["msg" : HIY"$n默念摄气诀心法，消解了些许的伤害！\n"NOR,
                 "damage" : -damage/3 - random(skill_lev),
               ]);
      }

      else if (random(3) == 0)
      {
        return (["msg" : HIY"$n默念摄气诀心法，消解了点伤害！\n"NOR,
                 "damage" : -damage/5 - random(skill_lev),
               ]);
      }

    }

  }

  return 0;
}

int query_power_effect(object me)
{
  int force_skill ;

  force_skill = (int)me->query_skill("tonsillit",1);
  if (force_skill < 100)
    return 100;
  else if (force_skill < 200)
    return 110 ;
  else if (force_skill < 300)
    return 120;
  return 140;
}

string exert_function_file(string func)
{
  return CLASS_D("ghost") + "/tonsillit/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 5;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 10  ,
         ]);
}

