inherit SKILL;

mapping *action = ({
  (["action" : "但是$n身形一晃，从$N身边轻轻滑过。\n",
    "dodge_power"  : 10
  ]),
  (["action" : "只见$n往后一退，隐入一团白雾中，$N这一招顿时没了目标。\n",
    "dodge_power"  : 15
  ]),
  (["action" : "$n一转身，一团白雾冒起，隔断了$N的攻势。\n",
    "dodge_power"  : 20
  ]),
  (["action" : "$n左脚轻轻在地上一点，如五爪金龙般腾在半空，避开了$N的攻势。\n",
    "dodge_power"  : 25
  ]),
  (["action" : "$n似乎有点躲闪不及，眼看就要中招。但是$N眼前金光一闪，不知怎的就扑空了。\n",
    "dodge_power"  : 40
  ])
});

mapping query_action(object me)
{
  int zhaoshu, level;

  zhaoshu = sizeof(action);
  level   = (int) me->query_skill("dragonstep",1);

  if (level < 250 )
     zhaoshu--;

  if (level < 180 )
     zhaoshu--;

  if (level < 100 )
     zhaoshu--;
  return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
  return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
  if( (string)me->query("family/family_name")!="东海龙宫")
    return notify_fail("你非龙族，怎么可以学习龙神身法？\n");

  if ((int)me->query_skill("dodge",1) < (int)me->query_skill("dragonstep",1))
    return notify_fail("你的基本轻功太低了！\n");
  return 1;
}

string query_dodge_msg(object me)
{
  mapping action;
  action = query_action(me);
  return action["action"];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 40 )
    return notify_fail("你的体力太差了，不能练龙神身法。\n");
  me->receive_damage("kee", 30);
    return 1;
}

int query_effect_dodge(object me,object ob)
{
  string dodge_skill ;
  dodge_skill = ob->query_skill_mapped("dodge");
  if (!stringp(dodge_skill))
    return 130;

  switch (dodge_skill)
  {
    case "baguazhen" :
    case "lingfu-steps" :
      return 120;
    case "yanxing-steps"   :
    case "jindouyun"  :
      return 80 ;
    default :
      return 100 ;
  }

  return 100;
}

int query_terrain(string terrain)
{
  switch (terrain)
  {
    case "sand" :
      return -4 ;
    case "hill" :
      return -3 ;
    case "wood" :
      return -1 ;
    case "muddy" :
      return 1 ;
    case "snow" :
      return 2 ;
    case "water" :
      return 4;
    default :
      return 0 ;
  }

  return 0;
}
string perform_action_file(string func)
{
  return CLASS_D("dragon") + "/dragonstep/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 2;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 15  ,
         ]);
}

 