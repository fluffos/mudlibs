int valid_learn(object me)
{
  object ob;
  if( (int)me->query("max_force") < 40 )
    return notify_fail("你的内力不够，没有办法练天河钯法。\n");
  if( !(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "rake" )
    return notify_fail("你必须先找一根钯才能练钯法。\n");
  if ((int)me->query_skill("rake",1) < (int)me->query_skill("skyriver-rake",1))
    return notify_fail("你的基本钯法不够，学不了天河钯法！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="rake" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  level = query_skill_lvl(me,"skyriver-rake",action);
  pfm_num = me->query_temp("SRR_perform");
  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 30
    || (int)me->query("force") < 3 )
    return notify_fail("你的内力或气不够，没有办法练习天河钯法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("sky-rake",1);
  if (level > action[i]["lvl"])
    return HIW"戏耍嫦娥，天河逞威。\n"NOR;

  level = query_skill_lvl(me,"pori-spear",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习天河钯法！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("common") + "/skyriver-rake/" + func;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("skyriver-rake",1);
  level = query_skill_lvl(me,"skyriver-rake",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了天河钯法的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}