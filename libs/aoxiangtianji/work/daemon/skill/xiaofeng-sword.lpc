string main_skill() { return "xiaofeng-sword"; }

mapping sub_skills = ([
        "feihua-sword"  : 150,        // 1
        "luoyan-sword"  : 150,        // 2
]);
int get_ready(object me)
{
  return 1;
}

int get_finish(object me)
{
  if (me->query_int() < 40)
  {
    tell_object(me, "你演练完毕，始终觉得在内力运转方面有点问题。\n");
    return 0;
  }

  if (me->query_spi() < 35)
  {
    tell_object(me, "你演练完毕，感觉头脑发木，似乎灵性不够。\n");
    return 0;
  }

  if ((int)me->query_skill("force", 1) < 150)
  {
    tell_object(me, "你演练完毕，几乎虚脱，自己的内功水平看来还有待提高。\n");
    return 0;
  }

  if ((int)me->query("max_force") < 2000)
  {
    tell_object(me, "你演练完毕，丹田提不起半点力来，看来应该继续锻炼内力。\n");
    return 0;
  }

  if (random(10) < 8)
  {
    tell_object(me, "你似乎有所领悟，或许再演练一次就能够大有收获。\n");
    return 0;
  }

  tell_object(me, HIY "你一气呵成，将晓风残月剑法演练了一遍，心中顿悟。\n你通晓了晓风残月剑法"
                      "的奥妙精髓。\n" NOR);
  me->set("family/can_learn/xiaofeng-sword",1);
  return 1;
}

mapping query_sub_skills()
{
  return sub_skills;
}

int query_finish_skill()
{
  return 10;
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "五庄观")
    return notify_fail("晓风残月剑是五庄观不传之密！\n");

  if( (int)me->query("max_force") < 1000 )
    return notify_fail("你的内力修为不够深，晓风残月剑学了也没用。\n");
  if (!(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "sword" )
    return notify_fail("你必须先找一柄剑才能练习剑法。\n");
  if (me->query_skill("sword",1) < me->query_skill("xiaofeng-sword",1))
    return notify_fail("你的基础剑术不够高，练不了晓风残月剑法！\n");
  if (!me->query("family/can_learn/xiaofeng-sword"))
    return notify_fail("没有演练(yanlian)成功之前，是无法学习或练习晓风残月剑法的！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="sword" || usage=="parry";
}

int practice_skill(object me)
{
  int dod=(int)me->query_skill("dodge",1);
  int swo=(int)me->query_skill("xiaofeng-sword",1);

  if (dod < swo)
     return notify_fail("你的身法跟不上剑法，练下去很可能会伤到自己。\n");
  if ((int)me->query("kee") < 100)
    return notify_fail("你体质欠佳，强练晓风残月剑有害无益。\n");
  if ((int)me->query("force") < 100)
    return notify_fail("你内力不足，强练晓风残月剑有走火入魔的危险。\n");
  me->receive_damage("kee", 50);
  me->add("force", -25);
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  string *jj = ({
    "$N身形婉如流水，手中$w从天而降，斩向$n的$l",
    "$N手中剑轻轻一晃，$w化为一道电光，刺向$n的$l",
    "$N手中的$w画了一道圆弧，突的从一个意想不到的角度向$n的$l刺来",
  });

  string *jj1 = ({
    "$N剑尖剑芒暴长，手中$w自左下大开大阖，一剑从右上力劈$n的$l",
    "$N剑芒吞吐，幻若灵蛇，力道十足，右手$w劈向$n的$l",
    "$N屈腕云剑，剑光如彩碟纷飞，幻出点点星光，手中$w跃跃洒洒飘向$n的$l",
  });
  string *jj2 = ({
    "$N手中$w似缓实快，变幻之中，一剑带着风雷之声，力劈$n的$l",
    "$N手中$w剑芒炽烈，剑尖幻出层层薄雾，突的带出一道光芒闪射$n的$l",
    "$N脚踏八卦，沉稳而力道十足。手中$w不在变换多端，却带着强烈的内力，"
    "显得势不可挡，中路直劈$n的$l",
  });
  mapping juejian =
    ([
     "action": element_of(jj),
     "dodge" : -20,
     "parry" : -20,
     "damage": 80,
     "force" : 50,
     "damage_type": "刺伤"
    ]);

  mapping juejian1 =
    ([
     "action": element_of(jj1),
     "dodge" : -20,
     "parry" : -20,
     "damage": 100,
     "force" : 70,
     "damage_type": "劈伤"
    ]);
  mapping juejian2 =
    ([
     "action": element_of(jj2),
     "dodge" : -20,
     "parry" : -20,
     "damage": 120,
     "force" : 90,
     "damage_type": "劈伤"
    ]);
  level = query_skill_lvl(me,"xiaofeng-sword",action);
  pfm_num = me->query_temp("XFS_perform");
  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];

  if (me->query_temp("XFS_juejian"))
    return juejian;
  if (me->query_temp("XFS_juejian1"))
    return juejian1;
  if (me->query_temp("XFS_juejian2"))
    return juejian2;
  return action[random(level + 1)];
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("xiaofeng-sword",1);
  if (level > action[i]["lvl"])
    return HIB"晓风残月，对酒当歌。\n"NOR;

  level = query_skill_lvl(me,"xiaofeng-sword",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习晓风残月剑！对%s这招有了进一步的了解！\n",sk_name);
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
  int dam;
  string msg;

  if (damage < 100)
    return 0;
  if (!me->query_temp("tick/juejian"))
    return 0;
  if (random(3) == 1)
    return 0;
  if (!me->query_temp("XFS_juejian1") && !me->query_temp("XFS_juejian2"))
    return 0;
  msg = HIW"$n" HIW"身子摇摇欲坠，行动不便，知道这一招无可躲避，"
                 "当即挺剑刺出，后发先至，噗的一声刺向$N" HIW"的咽喉。\n"NOR;
  msg += HIR"$N" HIR"大吃一惊，想收招招架已经来不及了！\n"NOR;
  dam = me->query_skill("sword");
  dam += me->query("force_factor");
  ob->receive_damage("kee",dam,me);
  ob->receive_wound("kee",random(dam)+1,me);
  if (!ob->is_busy())
    ob->start_busy(1);
  return (["msg" : msg,
           "damage" : -damage/2-random(damage),
         ]);
}

string perform_action_file(string func)
{
   return CLASS_D("zhenyuan") + "/xiaofeng-sword/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_parry_level()
{
  return 110;
}

int query_effect_parry(object me, object victim)
{
  return 105;
}

int learn_bonus()
{
  return 6;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 10  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("xiaofeng-sword",1);
  level = query_skill_lvl(me,"xiaofeng-sword",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了晓风残月剑的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

