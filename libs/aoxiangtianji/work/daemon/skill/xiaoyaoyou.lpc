inherit SKILL;

mapping *action = ({
  (["action" : "$n不进不退，身形只是稍稍一转，宛若一道轻风般从$N身边掠过。\n",
    "dodge_power" : 10,
  ]),
  (["action" : "可是$N眼前一花，居然连$n的影子都找不着了。\n忽然从头顶落下一串母鸡下蛋般的笑声，\n原来$n正如一头大鸟般往数丈开外滑翔过去。\n",
    "dodge_power" : 20,
  ]),
  (["action" : "$n右脚踏了个虚步，双臂一振，顿时乘风而起，居然从$N头顶越了过去。\n",
    "dodge_power" : 30,
  ]),
  (["action" : "$n左足一点，身形扶摇直上，却在半空中一个转折，轻飘飘地落在了$N身后。\n",
    "dodge_power" : 40,
  ]),
  (["action" : "但是$n不慌不忙，身子如行云流水般往后一飘...再一飘，早避到了五尺开外。\n",
    "dodge_power" : 50,
  ]),
  (["action" : "可是$n腰身微耸，顺势一掌按在有力无力之处，\n便如沾在$N这招上的一团轻絮，悠闲自得地将其化解。\n",
    "dodge_power" : 60,
  ]),
  (["action" : "$n突然大喝一声：且慢！便在$N一楞之间，笑得合不拢嘴地退了开来。\n",
    "dodge_power" : 70,
  ])
});

mapping query_action(object me)
{
  int zhaoshu, level;

  zhaoshu = sizeof(action);
  level   = (int) me->query_skill("xiaoyaoyou");

  if (level < 200 )
    zhaoshu--;

  if (level < 180 )
    zhaoshu--;

  if (level < 150 )
    zhaoshu--;

  if (level < 120 )
     zhaoshu--;

  if (level < 80 )
    zhaoshu--;
  return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
  return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
  if(me->query("family/family_name")!="大雪山")
    return notify_fail("逍遥游只有雪山弟子才可以学！\n");
  if ((int)me->query_skill("dodge",1) < (int)me->query_skill("xiaoyaoyou",1))
    return notify_fail("你的基本轻功太低了！\n");
  return 1;
}

string query_dodge_msg(object me)
{
  mapping action;
  action = query_action(me);
  return action["action"];
}

int practice_skill(object me)
{
  if(me->query("family/family_name")!="大雪山")
    return notify_fail("逍遥游只有雪山弟子才可以通过练习提高！\n");
  if( (int)me->query("kee") < 40 )
    return notify_fail("你的体力太差了，不能练逍遥游。\n");
  if ((int)me->query_skill("dodge",1) < 100)
    return notify_fail("你的基本技能太差了，不能练逍遥游。\n");
  me->receive_damage("kee", 30);
  return 1;
}

int query_effect_dodge(object me,object ob)
{
  string dodge_skill;

  dodge_skill = ob->query_skill_mapped("dodge");
  if (!stringp(dodge_skill))
    return 130;
  switch (dodge_skill)
  {
    case "dragonstep" :
    case "lingfu-steps" :
      return 120 ;
    case "baguazhen" :
    case "ghost-steps" :
      return 80;
    default :
      return 100 ;
  }

  return 100;
}

int query_terrain(string terrain)
{
  switch (terrain)
  {
    case "snow" :
      return 5 ;
    case "hill" :
      return 3 ;
    case "muddy" :
      return -3 ;
    case "water" :
      return -2 ;
    case "sand" :
      return -1;
    default :
      return 0 ;
  }

  return 0;
}

string perform_action_file(string func)
{
  return CLASS_D("xueshan") + "/xiaoyaoyou/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 110;
}

int learn_bonus()
{
  return 7;
}

int practice_bonus()
{
  return 2;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 15  ,
         ]);
}

 