int valid_learn(object me)
{
  object ob;
  if((string)me->query("family/family_name") != "南海普陀山")
    return notify_fail("不是普陀山弟子，怎么可以学习轮回杖呢？\n");
  if((string)me->query("class") != "bonze")
    return notify_fail("轮回杖只有出家之人才可以修习！\n");
  if( (int)me->query("max_force") < 2000 )
    return notify_fail("你的内力不够，没有办法学轮回杖，等内力提高了再来吧。\n");
  if( !(ob = me->query_temp("weapon"))
  ||      (string)ob->query("skill_type") != "staff" )
    return notify_fail("你必须先找一条禅杖才能学轮回杖。\n");
  if ((int)me->query_skill("staff",1) < (int)me->query_skill("lunhui-staff",1))
    return notify_fail("你的基本杖法太低了，无法学习轮回杖！\n");

  if ((int)me->query_skill("pudu-staff",1) < 180 ||
      (int)me->query_skill("buddhism",1) < 180)
    return notify_fail("你的佛法或者普渡杖法太低了，无法学习轮回杖法！\n");
  return 1;
}

int valid_enable(string usage)
{
  return (usage=="staff") || (usage=="parry");
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;
  mapping* m_actions;

  level = query_skill_lvl(me,"lunhui-staff",action);
  pfm_num = me->query_temp("LHS_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];

  if(me->query("skill_lunhui-staff")==0 )
    return action[random(level + 1)];
  else if( random(4) )
    return action[random(level + 1)];
  else
  {
    m_actions=me->query("skill_lunhui-staff");
    return element_of(m_actions);
  }

  return action[0];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 200
    || (int)me->query("force") < 200 )
    return notify_fail("你的内力或气不够，没有办法练习轮回杖。\n");
  me->receive_damage("kee", 50);
  me->add("force", -30);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("lunhui-staff",1);
  if (level > action[i]["lvl"])
    return WHT"慈光闪现，普渡劫难。\n"NOR;

  level = query_skill_lvl(me,"lunhui-staff",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习轮回杖！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("bonze") + "/lunhui-staff/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_parry_level()
{
  return 105;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 190 ,
           "effect"      : 10  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("lunhui-staff",1);
  level = query_skill_lvl(me,"lunhui-staff",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了轮回杖的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
  if(m_skill>action[i]["lvl"] && m_skill%10==0)
  {
    tell_object(me,HIW"你对轮回杖的领悟加深了，你的轮回杖进入了一个新的境界！\n"NOR);
    if(me->query("zichuang/times")>7)
    {
      tell_object(me,HIW"然而你的轮回杖已经练至顶峰，不能再创出新招了。\n"NOR);
      return;
    }

    if(random(me->query("kar"))<20)
    {
      tell_object(me,HIW"然而你的心中居然产生了一种失落感！\n"NOR);
      return;
    }

    if((random(me->query("int")/2)+(int)me->query_skill("literate")/50)<10)
    {
      tell_object(me,HIW"然而你的心中升起一种惆怅的感觉，仿佛有一丝重要的东西没有抓住。\n"NOR);
      return;
    }

    tell_object(me,HIW"你突然福至心灵，对轮回杖领悟出了一招新的用法！\n"NOR);
    tell_object(me,"请为这招取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
  }

  return;
}

void name_skill(object me, string arg)
{
  mapping* m_actions;
  mapping m_act=([]);
  int content, i=strlen(arg);
  string msg;
  int name_count;
  name_count = (int)me->query_temp("skill_name_count");
  m_actions=me->query("skill_lunhui-staff");
  if(!pointerp(m_actions))
    m_actions=({});
  content=me->query("str")+2*me->query_skill("unarmed",1)/10;
  m_act+=(["damage":content]);
  content=-me->query("spi");
  m_act+=(["dodge" :content]);
  content=-me->query("cps");
  m_act+=(["parry" :content]);
  content=me->query("con")+2*me->query_skill("force",1)/10;
  m_act+=(["force" :content]);
  m_act+=(["damage_type":"砸伤"]);
  if (!arg || arg=="")
  {
    tell_object(me,"请为你的新招式取一个名字：");
    input_to( (: call_other, __FILE__, "name_skill", me:));
    return;
  }

  else while(i--)
  {
    if( arg[i]<=' ' )
    {
      tell_object(me,"招式名字不能使用控制字元，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
        me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me :));
        return;
      }

    }

    if(strsrch(arg, "  ") >= 0)
    {
      tell_object(me,"招式名字不能有空格，请重新设定一个名字：");
      name_count++ ;
      if (name_count > 3)
      {
        tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
        me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

    if(  !is_chinese(arg[i..i]) )
    {
      tell_object(me,"请您用「中文」为你的新招式取名字：");
      name_count++ ;
      if (name_count > 3)
      {
      	tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
        return;
      }

      else
      {
      	me->set_temp("skill_name_count",name_count);
        input_to( (: call_other, __FILE__, "name_skill", me:));
        return;
      }

    }

  }

  if (!valid_name(arg))
  {
    tell_object(me,"对不起，这种名字会造成其他人的困扰。请重新设定一个名字：");
      name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  if( (strlen(arg) < 4) || (strlen(arg) > 8 ) )
  {
    tell_object(me,"对不起，招式名字必须是 ４ 到 ８ 个中文字：");
    name_count++ ;
    if (name_count > 3)
    {
      tell_object(me,"看来你无法取一个好听的名字，本次机会只好放弃了！\n");
      return;
    }

    else
    {
      me->set_temp("skill_name_count",name_count);
      input_to( (: call_other, __FILE__, "name_skill", me:));
      return;
    }

  }

  m_act+=(["name":arg]);
  msg= element_of(skill_head)+BLINK+HIY"「"+arg+"」"NOR
                  +element_of(skill_tail);
  m_act+=(["action":msg]);
  m_actions+=({m_act});
  me->set("skill_lunhui-staff",m_actions);
  me->add("zichuang/times",1);
  me->delete_temp("skill_name_count");
}

