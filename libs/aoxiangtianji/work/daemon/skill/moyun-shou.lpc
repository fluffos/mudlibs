int valid_learn(object me)
{
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习摩云手！\n");

  if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
    return notify_fail("练摩云手必须空手。\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  pfm_num = me->query_temp("MYS_perform");
  level = query_skill_lvl(me,"moyun-shou",action);
  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 80
    || (int)me->query("force") < 80 )
    return notify_fail("你的内力或气不够，没有办法练习摩云手。\n");
  if(me->query("family/family_name") != "火云洞")
    return notify_fail("你不是火云洞弟子，不能学习摩云手！\n");

  if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
    return notify_fail("练摩云手必须空手。\n");

  me->receive_damage("kee", 40);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("moyun-shou",1);
  if (level > action[i]["lvl"])
    return RED"双手摩云，气概九天。\n"NOR;

  level = query_skill_lvl(me,"moyun-shou",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习摩云手！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
return CLASS_D("kusong") + "/moyun-shou/" + func;
}

int expell_delete()
{
  return 1;
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("moyun-shou",1);
  level = query_skill_lvl(me,"moyun-shou",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了摩云手的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

int effective_level()
{
  return 105;
}

int query_effect_parry(object me, object victim)
{
  return 110;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 10  ,
         ]);
}

