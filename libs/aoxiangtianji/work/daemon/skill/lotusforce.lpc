#include <ansi.h>
inherit FORCE;
int valid_enable(string usage)
{
  return usage=="force";
}

int valid_learn(object me)
{
  if((string)me->query("family/family_name") != "南海普陀山")
    return notify_fail("莲花心法是南海普陀山不传之密！\n");

  if((string)me->query("class") != "bonze")
    return notify_fail("莲花心法只有出家之人才可以修习！\n");

  if ((int)me->query_skill("force") < 10)
    return notify_fail("你的基础内功修为还不够高深，无法学习莲花心法。\n");

  if( (int)me->query_skill("force") <= (int)me->query_skill("lotusforce") )
    return notify_fail("你的基础内功修为还不够高深，无法学习莲花心法。\n");

  if( (int)me->query("bellicosity") > 100 )
    return notify_fail("你的杀气太重，无法修炼莲花心法。\n");

  return 1;
}

int practice_skill(object me)
{
  return notify_fail("莲花心法只能用学的，或是从运用(exert)中增加熟练度。\n");
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
  if(me->query("family/family_name") != "南海普陀山")
    return 0;
  if((string)me->query("class") != "bonze")
    return 0;

  if( damage_bonus < 100 )
    return 0;

  if( (me->query_skill("lotusforce") > 120) && (me->query("force") > 1500)
      && random(10) > 8 )
  {
    victim->receive_wound("kee", damage_bonus,me);
    return HIY"$n仿佛看到朵朵莲花在眼前闪耀，内息一时停滞！\n"NOR;
  }

  return 0;
}

mixed valid_damage(object ob,object me,int damage)
{
  int skill_lev,myforce,yourforce ;
  int dam ;
  string msg;
  if(me->query("family/family_name") != "南海普陀山")
    return 0;
  if((string)me->query("class") != "bonze")
    return 0;

  myforce = (int)me->query("force");
  yourforce = (int)ob->query("force");
  skill_lev = (int)me->query_skill("lotusforce",1);
  msg = "";
  dam = 0;
  if (skill_lev > 150 )
  {
    if (random(3) == 1)
    {
      if (random(myforce + yourforce) > (yourforce*3)/2)
      {
        msg += HIY"$n" HIY"运转莲花心法，把这股力道直向$N" HIY"反击了过来！\n"NOR;
        if (random(4))
        {
          msg += HIY"$N" HIY"突受反震，只觉得双耳轰鸣，体内翻江倒海。看来是受了点内伤了！\n"NOR;
          dam = (int)me->query("force_factor");
          if (dam > 0)
            ob->receive_wound("kee", dam*3/2,me);
        }

        dam = damage/3 + random(damage/2) + random(skill_lev);
        return (["msg" : msg,
                 "damage" : -dam,
               ]);
      }

      else if (random(myforce + yourforce) > yourforce)
      {
        msg += HIY"$n" HIY"运起莲花心法，消解了部分的伤害！\n"NOR;
        if (random(3) == 0)
          dam = damage*2/3 + random(skill_lev);
        else
          dam = damage/3 + random(skill_lev);
        return (["msg" : msg,
                 "damage" : -dam,
               ]);
      }

      else if (random(2))
      {
        msg += HIY"$n运起莲花心法，消解了些许的伤害！\n"NOR;
        dam = damage/4 + random(skill_lev);
        return (["msg" : msg,
                 "damage" : -dam,
               ]);
      }

    }

  }

  return 0;
}

int query_power_effect(object me)
{
  int force_skill ;

  force_skill = (int)me->query_skill("lotusforce",1);
  if (force_skill < 150)
    return 100;
  return 110 ;
}

string exert_function_file(string func)
{
  return CLASS_D("bonze") + "/lotusforce/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 102;
}

int learn_bonus()
{
  return 5;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 10  ,
         ]);
}

