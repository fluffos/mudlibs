string main_skill() { return "snowsword-sword"; }

int valid_enable(string usage)
{
  return usage == "sword" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "月宫")
    return notify_fail("舞雪剑乃月宫不传之密！\n");

  if( (string)me->query("gender") !="女性")
    return notify_fail("舞雪剑只有女子才能学习!!\n");

  if( (int)me->query("max_force") < 50 )
    return notify_fail("你的内力不够，没有办法练舞雪剑。\n");
  if( (string)me->query_skill_mapped("force")!= "moonforce")
    return notify_fail("舞雪剑必须配合昆仑山玉女峰的圆月心法才能练。\n");
  if( !(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword" )
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  if ((int)me->query_skill("sword",1) < (int)me->query_skill("wuxue-sword",1))
    return notify_fail("你的基本剑法太差了，无法练习舞雪剑！\n");

  if ((int)me->query_skill("snowsword",1))
    return notify_fail("你已经学会了风回雪舞剑法，没有必要再学习舞雪剑了！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;
  level = query_skill_lvl(me,"wuxue-sword",action);
  pfm_num = (int)me->query_temp("WXS_perform");
  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if(me->query("family/family_name") != "月宫")
    return notify_fail("舞雪剑乃月宫不传之密！\n");

  if( (int)me->query("kee") < 50
   || (int)me->query("force") < 50 )
    return notify_fail("你的内力或气不够，没有办法练习舞雪剑。\n");

  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("wuxue-sword",1);
  if (level > action[i]["lvl"])
    return HIW"踏雪寻芳，轻姿舞雪。\n"NOR;

  level = query_skill_lvl(me,"wuxue-sword",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习舞雪剑！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("moon") + "/wuxue-sword/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("wuxue-sword",1);
  level = query_skill_lvl(me,"wuxue-sword",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了舞雪剑的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}