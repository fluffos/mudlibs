int valid_enable(string usage)
{
  return usage == "stick" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if( (int)me->query("max_force") < 50 )
    return notify_fail("你的内力不够，没有办法练菩提杖，多练些内力再来吧。\n");
  if((string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("菩提杖是方寸山三星洞不传之密！\n");
  if( !(ob = me->query_temp("weapon"))
  || (string)ob->query("skill_type") != "stick" )
    return notify_fail("你必须先找一根棒子才能练棒法。\n");
  if ((int)me->query_skill("stick",1) < (int)me->query_skill("puti-stick",1))
    return notify_fail("你的基础棒法太差了，无法练习菩提杖！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  level = query_skill_lvl(me,"puti-stick",action);
  pfm_num = me->query_temp("PTS_perform");

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];

  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 50
  ||      (int)me->query("force") < 50 )
    return notify_fail("你的内力或气不够，没有办法练习菩提杖。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("puti-stick",1);
  if (level > action[i]["lvl"])
    return HIY"降龙伏虎，苍龙归海。\n"NOR;

  level = query_skill_lvl(me,"puti-stick",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习菩提杖！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("puti") + "/puti-stick/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 15  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("puti-stick",1);
  level = query_skill_lvl(me,"puti-stick",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了菩提杖的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}