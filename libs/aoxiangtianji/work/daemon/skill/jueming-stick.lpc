#include <ansi.h>
inherit SKILL;
mapping *action = ({
  (["name"   : HIB"绝命横击"NOR,
    "action" :
"$N斜里冲前一步，身法诡异，手中$w横扫$n的$l",
    "damage" : 20,
    "dodge"  : 20,
    "parry"  : 20,
    "lvl"    : 0,
    "damage_type" : "挫伤"
  ]),
  (["name"  : HIB"缥缈无踪"NOR,
    "action":
"$N忽然直身飞入半空，很久也不见人影，$n正搜寻间，$N已"
"飞身扑下，$w攻向$n的$l",
    "damage": 20,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 50,
    "damage_type" : "挫伤"
  ]),
  (["name"  : HIW"翻身突击"NOR,
    "action":
"$N原地一个后滚翻，却在落地的一刹那，身体向$n平飞过"
"去，手中$w指向$n的$l",
    "damage": 30,
    "dodge" : 5,
    "parry" : 5,
    "lvl"   : 100,
    "damage_type" : "挫伤"
  ]),
  (["name"   : HIW"旋风阴打"NOR,
    "action" :
"$N突然一个急转身，$w横扫一圈后挟着猛烈的劲道打向$n的$l",
    "damage": 30,
    "dodge" : -5,
    "parry" : -5,
    "lvl"   : 150,
    "damage_type" : "挫伤"
  ]),
  (["name"  : HIR"绝命扑击"NOR,
    "action" : "$N向前扑出，顺势一滚，接着翻身跳起，手里$w斜向上击向$n的$l",
    "damage": 40,
    "dodge" : -10,
    "parry" : -5,
    "lvl"   : 180,
    "damage_type" : "挫伤"
  ])
});
int valid_enable(string usage)
{
  return usage=="stick" || usage=="parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习绝命棒！\n");
  if( (int)me->query("max_force") < 50 )
    return notify_fail("你的内力不够，没有办法练绝命棒。\n");
  if( !(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "stick" )
    return notify_fail("你必须先找一根棒子才能练绝命棒。\n");
  if ((int)me->query_skill("stick",1) < (int)me->query_skill("jueming-stick",1))
    return notify_fail("你的基础棒法太差了，练不了绝命棒法！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;

  level = query_skill_lvl(me,"jumming-stick",action);
  pfm_num = me->query_temp("JMS_perform");

  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习绝命棒！\n");

  if( (int)me->query("kee") < 50
    || (int)me->query("force") < 50 )
    return notify_fail("你的内力或气不够，没有办法练习绝命棒。\n");
  me->receive_damage("kee", 15);
  me->add("force", -5);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("jueming-stick",1);
  if (level > action[i]["lvl"])
    return HIG"绝命一击，神鬼难测。\n"NOR;

  level = query_skill_lvl(me,"jueming-stick",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习绝命棒！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("ghost") + "/jueming-stick/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 15;
}

int practice_bonus()
{
  return 10;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 20  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("jueming-stick",1);
  level = query_skill_lvl(me,"jueming-stick",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了绝命棒的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

