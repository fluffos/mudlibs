//三才剑法
#include <ansi.h>
inherit SKILL;
mapping *action = ({
(["name"   : HIC"「礼贤下士」"NOR,
  "action" : "$N纵身跃起手中$w轻挥，一招「礼贤下士」，斩向$n后颈",
  "parry"  : 10,
  "dodge"  : 10,
  "damage" : 20,
  "lvl"    : 0,
  "damage_type" : "刺伤"
]),
(["name"   : HIW"「完壁归赵」"NOR,
  "action" : "$N手中$w连话三个弧形，一招「完壁归赵」，向$n的右臂齐肩斩落",
  "parry"  : -5,
  "dodge"  : -5,
  "damage" : 30,
  "lvl"    : 50,
  "damage_type" : "刺伤"
]),
(["name"   : HIR"「卧薪尝胆」"NOR,
  "action" : "$N轻吁一声，飞身一跃而起，一招「卧薪尝胆」，连续向$n刺出数剑",
  "parry"  : -5,
  "dodge"  : -5,
  "damage" : 40,
  "lvl"    : 100,
  "damage_type" : "刺伤"
]),
(["name"   : HIG"「五岳为轻」"NOR,
  "action" : "$N仰天长啸，斜行向前，一招「五岳为轻」，$w横削直击，击向$n的$l",
  "parry"  : -10,
  "dodge"  : -10,
  "force"  : 20,
  "damage" : 50,
  "lvl"    : 200,
  "damage_type" : "割伤"
]),
});
int valid_enable(string usage)
{
  return usage == "sword" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，无法修习三才剑。\n");
  if ((int)me->query_skill("sword", 1) < 10)
    return notify_fail("你的基本剑法火候太浅，无法修习三才剑。\n");
  if ((int)me->query_skill("sword", 1) < (int)me->query_skill("sancai-sword", 1))
    return notify_fail("你的基本剑法水平有限，无法领会更高深的三才剑。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword" )
   return notify_fail("你必须先找一把剑才能练剑法。\n");
  return 1;
}

int practice_skill(object me)
{
  if ((int)me->query("kee") < 30)
    return notify_fail("你的气太低，再练下去会有危险的！\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够，无法练习三才剑。\n");
  me->receive_damage("kee", 20);
  me->add("force", -3);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("sancai-sword",1);
  if (level > action[i]["lvl"])
    return RED"三才得利，其势断金。\n"NOR;

  level = query_skill_lvl(me,"sancai-sword",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习三才剑法！对%s这招有了进一步的了解！\n",sk_name);
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  pfm_num = me->query_temp("SCJ_perform");
  level = query_skill_lvl(me,"sancai-sword",action);

  if(pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

string perform_action_file(string func)
{
  return "/daemon/class/common/sancai-sword/"+func;
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("sancai-sword",1);
  level = query_skill_lvl(me,"sancai-sword",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了三才剑法的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
  if (m_skill > 120)
    if (!me->query("common/can_pfm/sanzi"))
      me->set("common/can_pfm/sanzi",1);
}

int learn_bonus()
{
  return 15;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 160 ,
           "effect"      : 25  ,
         ]);
}

