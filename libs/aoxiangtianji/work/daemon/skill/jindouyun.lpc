inherit SKILL;

mapping *action = ({
  (["action" : "$n轻轻一纵，使个「踏云步」，避开了这一招。\n",
    "dodge_power"  : 10
  ]),
  (["action" : "$N眼一花，$n使出「翻云式」一个筋斗从$N头顶越过。\n",
    "dodge_power"  : 15
  ]),
  (["action" : "$n一声：好！一招「追云式」连翻几个筋斗，连影子都没了。\n",
    "dodge_power" : 20
  ]),
  (["action" : "$n左足一点，一招「穿云式」腾空而起，避了开去。\n",
    "dodge_power"  : 25
  ]),
  (["action" : "但是$n使一招「流云步」，身子轻轻飘了开去。\n",
    "dodge_power"  : 35
  ]),
  (["action" : "可是$n胸腹往后一缩，在间不容发之际一个筋斗倒翻而出，好个「倒骑云」！\n",
    "dodge_power"  : 50
  ]),
  (["action" : "只见$n一声长啸，卷起一股疾风，身形亦腾风而起，\n$N的攻击早失了准头。正是“筋斗云”中的「腾云式」！\n",
    "dodge_power"  : 60
  ])
});

mapping query_action(object me)
{
  int zhaoshu, level;

  zhaoshu = sizeof(action);
  level   = (int) me->query_skill("jindouyun",1);

  if (level < 300 )
    zhaoshu--;

  if (level < 250 )
    zhaoshu--;

  if (level < 180 )
    zhaoshu--;
  if (level < 150 )
    zhaoshu--;

  if (level < 120 )
    zhaoshu--;

  if (level < 80 )
    zhaoshu--;
  return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
  return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
  if(me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("筋斗云是方寸山三星洞不传之密！\n");
  if ((int)me->query_skill("dodge",1) < (int)me->query_skill("jindouyun",1))
    return notify_fail("你的基本轻功太低了！\n");

  return 1;
}

string query_dodge_msg(object me)
{
  mapping action;
  action = query_action(me);
  return action["action"];
}

int practice_skill(object me)
{
  if( (int)me->query("kee") < 40 )
    return notify_fail("你的体力太差了，不能练筋斗云。\n");
  me->receive_damage("kee", 30);
  return 1;
}

int query_effect_dodge(object me,object ob)
{
  string dodge_skill ;
  dodge_skill = ob->query_skill_mapped("dodge");
  if (!stringp(dodge_skill))
    return 130;

  switch (dodge_skill)
  {
    case "moondance" :
    case "lotusmove" :
      return 120;
    case "moshenbu" :
    case "xiaoyaoyou" :
      return 80 ;
    default :
      return 100 ;
  }

  return 100;
}

int query_terrain(string terrain)
{
  switch (terrain)
  {
    case "hill" :
      return 4 ;
    case "wood" :
      return 2;
    case "muddy" :
      return 1;
    case "snow" :
    case "sand" :
      return -1;
    case "water" :
      return -3 ;
    default :
      return 0 ;
  }

  return 0;
}

string perform_action_file(string func)
{
  return CLASS_D("puti") + "/jindouyun/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int learn_bonus()
{
  return 8;
}

int practice_bonus()
{
  return 2;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 10  ,
         ]);
}

