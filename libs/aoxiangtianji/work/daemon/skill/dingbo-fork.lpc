inherit SKILL;
#include <ansi.h>
mapping *action = ({
  (["name"  : HIC"「江上往来人」"NOR,
    "action":
"$N怒叱一声，手中$w齐快无比地在$n身前来来回回连划七划。\n"
"这招「江上往来人」变幻无方，$n实在不知哪招是虚，哪招是实",
    "dodge" : 15,
    "parry" : 15,
    "damage": 20,
    "lvl"   : 0,
    "damage_type":  	"戳伤",
  ]),
  (["name"  : HIY"「但爱鲈鱼美」"NOR,
    "action":
"$N手中$w缓缓画了个圆圈，用一招「但爱鲈鱼美」慢慢向$n的$l套去",
    "dodge" : 5,
    "parry" : 5,
    "damage": 30,
    "lvl"   : 100,
    "damage_type" : "戳伤",
  ]),
  (["name"  : HIG"「君看一叶舟」"NOR,
    "action":
"$N身形一旋，冲天而起。手中$w借着下冲之势，一招「君看一叶舟」直插$n的$l",
    "dodge" : 0,
    "parry" : 0,
    "damage": 40,
    "lvl"   : 150,
    "damage_type" : "戳伤",
  ]),
  (["name"  : HIR"「出没风波里」"NOR,
    "action":
"$N突然脸上青气一显，叉上嗡嗡之声大做，正当$n惊诧时，\n"
"$N狂风骤雨般连攻五叉。这招「出没风波里」是整套叉法的精髓，\n"
"施将出来，不但变幻莫测，且声势惊人，$n顿时不知所措",
    "dodge" : -5,
    "parry" : -5,
    "damage": 50,
    "lv1"   : 180,
    "damage_type" : "戳伤",
  ]),
});
string main_skill()
{
  return "fengbo-fork";
}

int valid_learn(object me)
{
  object ob;
  if( (string)me->query("family/family_name")!="东海龙宫")
    return notify_fail("你非龙宫门人，怎么可以学习定波叉？\n");
  if (me->query("class") != "dragon")
    return notify_fail("你非龙族，怎能习惯这水中出没的叉法？\n");

  if( (int)me->query("max_force") < 50 )
    return notify_fail("你的内力不够，无法领会定波叉的精妙之处。\n");
  if (me->query_skill("dragonforce", 1) < me->query_skill("dingbo-fork", 1)/2)
    return notify_fail("你的龙神心法修为太低。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "fork" )
    return notify_fail("你必须先找一柄叉来才能学叉法。\n");
  if ((int)me->query_skill("fork",1) < (int)me->query_skill("dingbo-fork",1))
    return notify_fail("你的基本叉法太低了，无法练习定波叉！\n");

  if (me->query_skill("fengbo-fork",1))
    return notify_fail("你已经学会了风波十二叉，继续练习定波叉没有什么意义了！\n");
  return 1;
}

int practice_skill(object me)
{
  if (me->query("class") != "dragon")
    return notify_fail("你非龙族，怎能习惯这水中出没的叉法？\n");

  if(me->query_skill_mapped("force") !="dragonforce")
    return notify_fail("定波叉必须配合龙神心法才能发挥威力。\n");

  if(me->query("kee") < 50)
    return notify_fail("你的体力太弱，先休息一会儿吧。\n");

  if(me->query("sen") < 50)
    return notify_fail("你的神智不清，就算练了也什么都学不到的。\n");

  if(me->query("force") < 20)
    return notify_fail("你的内力不足，无法照路数舞叉。\n");
  me->add("kee", -20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("dingbo-fork",1);
  if (level > action[i]["lvl"])
    return HIC"\n定波无浪，叉叉有风！\n"NOR;

  level = query_skill_lvl(me,"dingbo-fork",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习定波叉！对%s有了进一步的了解！\n",sk_name);
}

int valid_enable(string usage)
{
  return usage=="fork" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;

  level = query_skill_lvl(me,"dingbo-fork",action);
  pfm_num = me->query_temp("DBF_perform");

  if(pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];

  return action[random(level+1)];
}

string perform_action_file(string func)
{
  return CLASS_D("dragon") + "/dingbo-fork/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("dingbo-fork",1);
  level = query_skill_lvl(me,"dingbo-fork",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了定波叉的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

