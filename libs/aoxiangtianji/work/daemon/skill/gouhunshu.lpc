// 勾魂术
inherit SKILL;
int valid_enable(string usage)
{
  return usage=="spells";
}

int valid_learn(object me)
{
  if( (int)me->query_skill("spells", 1) < 10
   || (int)me->query_skill("spells", 1) <= (int)me->query_skill("gouhunshu", 1) )
    return notify_fail("你的法术修为还不够高深，无法学习勾魂术．\n");

  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习勾魂术！\n");

  return 1;
}

string cast_spell_file(string spell)
{
  return CLASS_D("ghost") + "/gouhunshu/" + spell;
}

string type() { return "magic"; }

string query_shuxing() {return "tu";}

int query_power_effect(object me)
{
  int force_skill ;
  int base_num, day_phase ;
  object where;
  string weather, terrain;

  base_num = 100;
  day_phase = NATURE_D->query_current_day_phase();

  if ((day_phase == 0) || (day_phase > 4))
    base_num = 110;
  else
    base_num = 90;
  where = environment(me);
  if (objectp(where))
  {
    if (where->is_ghost())
      base_num += 10;
    else if (where->is_taoist())
      base_num -= 10;
    terrain = where->query_terrain();
    if (!stringp(terrain))
      terrain = where->query("terrain");
    if (!stringp(terrain))
      terrain = "land";
  }

  weather = NATURE_D->query_weather();

  if (stringp(terrain) && terrain == "muddy")
    base_num += 10;
  else if (stringp(terrain) && terrain == "wood")
    base_num += 8;
  else if (stringp(terrain) && terrain == "sand")
    base_num -= 10;
  else if (stringp(terrain) && terrain == "snow")
    base_num -= 8;

  if (stringp(weather) && weather == "rain")
    base_num += 10 ;
  else if (stringp(weather) && weather == "sun")
    base_num -= 10;
  force_skill = (int)me->query_skill("gouhunshu",1);

  if (force_skill < 150)
    return base_num;
  else if (force_skill < 200)
    return base_num + 5 ;
  else if (force_skill < 300)
    return base_num + 10;
  return base_num + 15;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 115;
}

int learn_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 20  ,
         ]);
}

