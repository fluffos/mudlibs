#include <ansi.h>
inherit SKILL;

mapping *action = ({
 (["action" : "$n身似鬼魅，足不动，腿不抬，竟然飘然飞起，居然轻描淡写避过了$N这招。\n\n",
   "dodge_power"  : 0
 ]),
 (["action" : "$N一招击至，看似打个正着，却不料$n身形突然消失，一回头，发现竟然已在身后！\n\n",
   "dodge_power"  : 5
 ]),
 (["action" : "只见$n脚步散乱，身形乱晃，$N眼前顿时只剩一团鬼影，不知如何攻击！\n\n",
   "dodge_power"  : 8
 ]),
 (["action" : "$n突然加快步法，化作一团烟雾在$N身前身后忽左忽右游走，$N眼花缭乱招招落空。\n\n",
   "dodge_power"  : 10
 ]),
 (["action" : "$n面带诡笑，身体竟似全无重量，看似被击中，却随$N招式飘出，并未受一丝伤害。\n\n",
   "dodge_power"  : 12
 ]),
 (["action" : "$n膝盖不弯，直上直下地跳动，看似极笨拙，却轻而易举地躲开了$N的攻击。\n\n",
   "dodge_power"  : 15
 ])
});

mapping query_action(object me)
{
  int zhaoshu, level;

  zhaoshu = sizeof(action);
  level   = (int) me->query_skill("ghost-steps",1);

  if (level < 200 )
    zhaoshu--;

  if (level < 150 )
    zhaoshu--;

  if (level < 100 )
    zhaoshu--;
  if (level < 80 )
    zhaoshu--;

  return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
  return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习鬼影迷踪！\n");
   if ((int)me->query_skill("dodge",1) < (int)me->query_skill("ghost-steps",1))
     return notify_fail("你的基本轻功太低了！\n");

  return 1;
}

string query_dodge_msg(object me)
{
  mapping action;
  action = query_action(me);
  return action["action"];
}

int practice_skill(object me)
{
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习鬼影迷踪！\n");

  if( (int)me->query("kee") < 40 )
    return notify_fail("你的体力太差了，不能练鬼影迷踪。\n");
  me->receive_damage("kee", 30);
  return 1;
}

int query_effect_dodge(object me,object ob)
{
  string dodge_skill ;
  dodge_skill = ob->query_skill_mapped("dodge");
  if (!stringp(dodge_skill))
    return 130;

  switch (dodge_skill)
  {
    case "yanxing-steps" :
    case "jindouyun" :
      return 120 ;
    case "moondance" :
    case "lotusmove" :
      return 80;
    default :
      return 100 ;
  }

  return 100;
}

int query_terrain(string terrain)
{
  switch (terrain)
  {
    case "muddy" :
      return 5 ;
    case "snow" :
      return 2 ;
    case "wood" :
      return 1 ;
    case "water" :
      return -1 ;
    case "hill" :
      return -2 ;
    case "sand" :
      return -4 ;
    default :
      return 0 ;
  }

  return 0;
}

string perform_action_file(string func)
{
  return CLASS_D("ghost") + "/ghost-steps/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 6;
}

int practice_bonus()
{
  return 4;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 10  ,
         ]);
}

