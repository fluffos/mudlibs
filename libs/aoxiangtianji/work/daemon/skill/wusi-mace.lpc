int valid_learn(object me)
{
  object ob;

  if( (int)me->query("max_force") < 300 )
    return notify_fail("你的内力不够，不能学无私锏法， 多练些内力再来吧。\n");
  if (!(ob = me->query_temp("weapon"))
     ||(string)ob->query("skill_type") != "mace" )
    return notify_fail("你必须先找一柄锏才能练锏法。\n");
  if(me->query("family/family_name") != "将军府")
    return notify_fail("无私锏乃将军府不传之密！\n");
  if( (string)me->query_skill_mapped("force")!= "lengquan-force")
    return notify_fail("无私锏需配合冷泉神功才可发挥威力。\n");
  if ((int)me->query_skill("mace", 1) < (int)me->query_skill("wusi-mace", 1))
    return notify_fail("你的基本锏法水平有限，无法领会更高深的无私锏。\n");

  return 1;
}

int practice_skill(object me)
{
  string myforce=me->query_skill_mapped("force");
  if (myforce != "lengquan-force")
    return notify_fail("无私锏需配合将军府冷泉神功才可发挥威力。\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你内力不足，强练无私锏有走火入魔的危险。\n");
  me->receive_damage("kee", 10);
  me->add("force", -5);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("wusi-mace",1);
  if (level > action[i]["lvl"])
    return RED"呕心沥血，精忠报国。\n"NOR;

  level = query_skill_lvl(me,"wusi-mace",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习无私锏！对%s这招有了进一步的了解！\n",sk_name);
}

int valid_enable(string usage)
{
  return usage=="mace"||usage=="parry";
}

string perform_action_file(string func)
{
  return CLASS_D("fighter") + "/wusi-mace/" + func;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  pfm_num = (int)me->query_temp("WSM_perform");
  level = query_skill_lvl(me,"wusi-mace",action);

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 15;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 200 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("wusi-mace",1);
  level = query_skill_lvl(me,"wusi-mace",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了无私锏的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

