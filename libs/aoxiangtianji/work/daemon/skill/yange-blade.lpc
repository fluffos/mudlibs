string main_skill() { return "yange-blade"; }

mapping sub_skills = ([
        "luori-blade"  : 180,        // 1
        "damo-blade"   : 180,        // 2
]);
int get_ready(object me)
{
  return 1;
}

int get_finish(object me)
{
  if (me->query_dex() < 40)
  {
    tell_object(me, "你演练完毕，始终觉得在身法方面有点问题。\n");
    return 0;
  }

  if (me->query_cor() < 35)
  {
    tell_object(me, "你演练完毕，感觉在胆气方面，似有不够。\n");
    return 0;
  }

  if ((int)me->query_skill("force", 1) < 180)
  {
    tell_object(me, "你演练完毕，几乎虚脱，自己的内功水平看来还有待提高。\n");
    return 0;
  }

  if ((int)me->query_skill("baguazhen", 1) < 180)
  {
    tell_object(me, "你演练完毕，发现自己的八卦阵等级太低，无法有所突破。\n");
    return 0;
  }

  if ((int)me->query("max_force") < 2000)
  {
    tell_object(me, "你演练完毕，丹田提不起半点力来，看来应该继续锻炼内力。\n");
    return 0;
  }

  if (random(10) < 8)
  {
    tell_object(me, "你似乎有所领悟，或许再演练一次就能够大有收获。\n");
    return 0;
  }

  tell_object(me, HIY "你一气呵成，将雁歌刀法演练了一遍，心中顿悟，通晓了雁歌刀法"
                      "的奥妙精髓。\n" NOR);
  me->set("family/can_learn/yange-blade",1);
  return 1;
}

mapping query_sub_skills()
{
  return sub_skills;
}

int query_finish_skill()
{
  return 10;
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "五庄观")
    return notify_fail("雁歌刀是五庄观不传之密！\n");

  if( (int)me->query("max_force") < 300 )
    return notify_fail("你的内力修为不够深，雁歌刀学了也没用。\n");
  if (!(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "blade" )
    return notify_fail("你必须先找一柄刀才能练习刀法。\n");
  if ((int)me->query_skill("blade",1) < (int)me->query_skill("yange-blade",1))
    return notify_fail("你的基本刀法不够，学不了雁歌刀了！\n");

  if (!me->query("family/can_learn/yange-blade"))
    return notify_fail("你的雁歌刀还没有演练(yanlian)，无法进行学习！\n");
  return 1;
}

int valid_enable(string usage)
{
  return (usage=="blade") || (usage=="parry");
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  level = query_skill_lvl(me,"yange-blade",action);
  pfm_num = me->query_temp("YGD_perform");
  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  int dod=(int)me->query_skill("dodge",1);
  int swo=(int)me->query_skill("yange-blade",1);

  if (dod < swo)
     return notify_fail("你的身法跟不上剑法，练下去很可能会伤到自己。\n");
  if ((int)me->query("kee") < 100)
    return notify_fail("你体质欠佳，强练雁歌刀有害无益。\n");
  if ((int)me->query("force") < 100)
    return notify_fail("你内力不足，强练雁歌刀有走火入魔的危险。\n");
  me->receive_damage("kee", 50);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("xiaofeng-sword",1);
  if (level > action[i]["lvl"])
    return HIB"大漠孤烟直，长河落日圆。\n"NOR;

  level = query_skill_lvl(me,"yange-blade",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习雁歌刀！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
   return CLASS_D("zhenyuan") + "/yange-blade/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 102;
}

int query_effect_parry(object me, object victim)
{
  return 105;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 12  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("yange-blade",1);
  level = query_skill_lvl(me,"yange-blade",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了雁歌刀的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}