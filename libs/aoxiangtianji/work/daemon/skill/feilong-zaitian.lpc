#include <ansi.h>
inherit SKILL;
mapping action =
  (["name"   : HIY"「飞龙在天」"NOR,
    "action" : "$N突然身形飞起，双掌居高临下一招「飞龙在天」拍向$n的$l",
    "dodge"  : 15,
    "parry"  : 20,
    "force"  : 110,
    "damage_type": "震伤"
  ]);
string main_skill()
{
  return "dragonfight";
}

int valid_enable(string usage)
{
  return usage == "unarmed";
}

int valid_learn(object me)
{
   if(me->query("family/family_name") != "东海龙宫")
     return notify_fail("非龙宫弟子不能用飞龙在天！\n");
  if( (int)me->query_skill("unarmed",1) < (int)me->query_skill("feilong-zaitian",1))
    return notify_fail("你的基本拳脚还不够精湛，无法领会更深层的飞龙在天！\n");

  if( (int)me->query_skill("dragonforce",1) < (int)me->query_skill("feilong-zaitian",1)/2)
    return notify_fail("你的龙神心法还不够精湛，无法领会更深层的飞龙在天！\n");
  if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
    return notify_fail("练飞龙在天必须空手。\n");

  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内力不够，无法练习拳法！\n");

  if (!me->query("family/can_learn/dragonfight1"))
    return notify_fail("没有师傅的允许，似乎没有办法学习或者练习这门技艺！\n");
  if (me->query_skill("dragonfight",1))
    return notify_fail("你已经学会了龙神搏击，无需再学习飞龙在天！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  if (playerp(me))
    return action;
  return
  (["name"   : HIY"「飞龙在天」"NOR,
    "action" : "$N突然身形飞起，双掌居高临下一招「飞龙在天」拍向$n的$l",
    "dodge"  : -15,
    "parry"  : -15,
    "force"  : 180,
    "damage_type": "震伤"
  ]);
}

int practice_skill(object me)
{
  if( (int)me->query("sen") < 200)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if( (int)me->query("kee") < 200 )
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if( (int)me->query("force") < 200 )
    return notify_fail("你的内力不够了。\n");
  me->receive_damage("kee", 60);
  me->receive_damage("sen", 60);
  me->add("force", -30);
  return 1;
}

string query_practice_msg(object me)
{
  return HIY"你依照所学练习飞龙在天！\n"NOR;
}

string perform_action_file(string func)
{
  return CLASS_D("dragon") + "/feilong-zaitian/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 100 ,
           "effect"      : 20  ,
         ]);
}

