#include <ansi.h>
inherit SKILL;
mapping *action = ({
  (["name"  : HIW"「长空万里」"NOR,
    "action": "$N手中$w舞动出一招「长空万里」，向$n的$l扎去",
    "damage": 20,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 0,
    "damage_type" : "刺伤"
  ]),
  (["name"  : HIW"「浮云悠悠」"NOR,
    "action": "$N一招「浮云悠悠」，身子后撤，稳稳扎住，手中$w略一回撤，抖出一朵枪花，直刺$n$l",
    "damage": 25,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 50,
    "damage_type" : "刺伤"
  ]),
  (["name"  : HIG"「云飞霞舞」"NOR,
    "action": "$N展开身形，一招「云飞霞舞」，手中$w奔若矫龙，飞刺$n$l",
    "damage": 30,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 100,
    "damage_type" : "刺伤"
  ]),
  (["name"  : HIM"「踏云追风」"NOR,
    "action": "$N一招「踏云追风」，$w左扎右挑，笔直刺向$n$l",
    "damage": 40,
    "dodge" : 0,
    "parry" : 0,
    "lvl"   : 120,
    "damage_type" : "刺伤"
  ]),
  (["name"  : HIM"「小鸟登枝」"NOR,
    "action": "$N手中$w向下一压一挑，正是一招「小鸟登枝」，刺向$n的胸口",
    "damage": 45,
    "dodge" : -5,
    "parry" : -5,
    "lvl"   : 150,
    "damage_type" : "刺伤"
  ]),
  (["name"  : HIC"「御风遨游」"NOR,
    "action": "$N身形跃起，衣袖飘飘，手中$w映着阳光，使出一招「御风遨游」，闪处八九个枪尖，齐齐罩向$n",
    "damage": 50,
    "dodge" : -10,
    "parry" : -10,
    "lvl"   : 180,
    "damage_type" : "刺伤"
  ]),
});
int valid_enable(string usage)
{
  return usage == "spear" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name") != "大雪山")
    return notify_fail("追云枪是大雪山不传之密！\n");

  if( (int)me->query("max_force") < 50 )
    return notify_fail("你的内力修为不够深，追云枪学了也没用。\n");
  if (!(ob = me->query_temp("weapon"))
   || (string)ob->query("skill_type") != "spear" )
    return notify_fail("你必须先找一把长枪才能练习枪法。\n");
  if ((int)me->query_skill("spear",1) < (int)me->query_skill("zhuiyun-spear",1))
    return notify_fail("你的基本枪法不够，学不了追云枪！\n");

  if (me->query_skill("fenghuang-spear",1))
    return notify_fail("你已经学会了凤凰枪，无需继续练习追云枪法了！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  level = query_skill_lvl(me,"zhuiyun-spear",action);
  pfm_num = me->query_temp("ZYS_perform");
  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if ((int)me->query("kee") < 50)
    return notify_fail("你气力不支，强练追云枪有害无益。\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你内力不足，强练追云枪有走火入魔的危险。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("zhuiyun-spear",1);
  if (level > action[i]["lvl"])
    return HIW"追云逐月，自在逍遥。\n"NOR;

  level = query_skill_lvl(me,"zhuiyun-spear",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习追云枪！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
   return CLASS_D("xueshan") + "/zhuiyun-spear/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 10;
}

int practice_bonus()
{
  return 5;
}

mapping black_white_ness()
{
  return (["skill_level" : 150 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("zhuiyun-spear",1);
  level = query_skill_lvl(me,"zhuiyun-spear",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了追云枪的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

