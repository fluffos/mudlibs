// necromancy.c 招魂术
inherit SKILL;
int valid_learn(object me)
{
  if( (int)me->query_skill("longxiang",1) <
      (int)me->query_skill("necromancy",1) )
    return notify_fail("你的龙相般若功太低了，无法修炼更高深的招魂术。\n");
  return 1;
}

int practice_skill(object me)
{
  return notify_fail("招魂术只能靠学(learn)来提高。\n");
}

