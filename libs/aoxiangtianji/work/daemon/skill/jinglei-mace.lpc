int valid_learn(object me)
{
  object ob;
  if( (int)me->query("max_force") < 1200 )
    return notify_fail("你的内力修为不够深，不能学惊雷鞭法。\n");
  if(me->query("family/family_name") != "将军府")
    return notify_fail("惊雷鞭法乃将军府不传之密！\n");
  if ((int)me->query_skill("lengquan-force",1) < 150)
    return notify_fail("你的冷泉神功等级不够，无法自如运用惊雷鞭法！\n");
  if( (string)me->query_skill_mapped("force")!= "lengquan-force")
    return notify_fail("惊雷鞭法必须配合将军府的冷泉神功才能练。\n");
  if (!(ob = me->query_temp("weapon"))
     ||(string)ob->query("skill_type") != "mace" )
    return notify_fail("手里没有兵器怎么练？\n");
  if ((int)me->query_skill("mace", 1) < (int)me->query_skill("jinglei-mace", 1))
    return notify_fail("你的基本锏法水平有限，无法领会更高深的惊雷鞭法。\n");
  return 1;
}

int practice_skill(object me)
{
  if ((int)me->query("kee") < 200)
    return notify_fail("你体质欠佳，强练惊雷鞭法有害无益。\n");
  if ((int)me->query("force") < 150)
    return notify_fail("你内力不足，强练惊雷鞭法有走火入魔的危险。\n");
  me->receive_damage("kee", 30);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("jinglei-mace",1);
  if (level > action[i]["lvl"])
    return RED"暴雨惊雷，除邪荡魔。\n"NOR;

  level = query_skill_lvl(me,"jinglei-mace",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习惊雷鞭法！对%s这招有了进一步的了解！\n",sk_name);
}

int valid_enable(string usage)
{
  return usage=="mace"||usage=="parry";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  pfm_num = (int)me->query_temp("JLM_perform");
  level = query_skill_lvl(me,"jinglei-mace",action);

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

string perform_action_file(string func)
{
  return CLASS_D("fighter") + "/jinglei-mace/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int query_effect_parry(object me, object victim)
{
  return 105;
}

int learn_bonus()
{
  return 5;
}

int practice_bonus()
{
  return 3;
}

mapping black_white_ness()
{
  return (["skill_level" : 180,
           "effect"      : 10 ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill = me->query_skill("jinglei-mace",1);
  level = query_skill_lvl(me,"jinglei-mace",action);

  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了惊雷鞭法的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}

