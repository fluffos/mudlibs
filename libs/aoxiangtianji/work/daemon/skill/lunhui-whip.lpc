#include <ansi.h>
inherit SKILL;
mapping *action = ({
  (["name"  : HIW"「人间道」"NOR,
    "action": "$N使一式「人间道」，手中$w盘旋几圈后，幻成一条疾光刺向$n的$l",
    "dodge" : 10,
    "parry" : 15,
    "damage": 15,
    "lvl"   : 0,
    "damage_type": "刺伤"
  ]),
  (["name"  : HIY"「畜生道」"NOR,
    "action": "$N错步上前，使出「畜生道」，$w若有若无，淡淡地向$n的$l挥去",
    "dodge" : 5,
    "parry" : 15,
    "damage": 20,
    "lvl"   : 50,
    "damage_type": "割伤"
  ]),
  (["name"  : HIC"「饿鬼道」"NOR,
    "action": "$N一式「饿鬼道」，纵身飘开数尺，运内力于鞭，手中$w横抽向$n的$l",
    "dodge" : 5,
    "parry" : 5,
    "damage": 20,
    "lvl"   : 80,
    "damage_type": "抽伤"
  ]),
  (["name"  : HIB"「修罗道」"NOR,
    "action": "$N纵身轻轻跃起，一式「修罗道」，手中$w如轮疾转，霍霍扫向$n的$l",
    "dodge" : 0,
    "parry" : 0,
    "damage": 20,
    "lvl"   : 100,
    "damage_type": "割伤"
  ]),
  (["name"  : HIB"「地狱道」"NOR,
    "action": "$N手中$w回环舞动，一式「地狱道」，无声无息地对准$n的$l抽去",
    "dodge" : -5,
    "parry" : -5,
    "damage": 30,
    "lvl"   : 120,
    "damage_type": "抽伤"
  ]),
  (["name"  : HIG"「天极道」"NOR,
    "action": "$N手中$w高高扬起，鞭稍灵动如蛇，一式「天极道」，对准$n的$l斜斜击出",
    "dodge" : -5,
    "parry" : 5,
    "damage": 40,
    "lvl"   : 150,
    "damage_type": "抽伤"
  ]),
  (["name"  : HIG"「六道轮回」"NOR,
    "action": "$N左指凌空虚点，右手$w竟逼出丈许雪亮光芒，一式「六道轮回」翻转抽向$n",
    "dodge" : -10,
    "parry" : -10,
    "damage": 50,
    "lvl"   : 180,
    "damage_type": "鞭伤"
  ]),
});
string main_skill() { return "hellfire-whip"; }

int valid_enable(string usage)
{
  return usage == "whip" || usage == "parry";
}

int valid_learn(object me)
{
  object ob;
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习轮回鞭！\n");
  if ((int)me->query_skill("hellfire-whip",1))
    return notify_fail("你已将这种鞭法融入烈火鞭，不必再分开练习了。\n");

  if( (int)me->query("max_force") < 200 )
    return notify_fail("你的内力不够，没有办法学习轮回鞭。\n");

  if( !(ob = me->query_temp("weapon"))
     || (string)ob->query("skill_type") != "whip" )
    return notify_fail("你必须先找一根鞭子才能学习轮回鞭。\n");

  if ((int)me->query_skill("whip",1) < (int)me->query_skill("lunhui-whip",1))
    return notify_fail("你的基础鞭术太低了，无法学习轮回鞭！\n");
  return 1;
}

mapping query_action(object me, object weapon)
{
  int level, pfm_num;
  level = query_skill_lvl(me,"lunhui-whip",action);
  pfm_num = (int)me->query_temp("LHW_perform");

  if (pfm_num && pfm_num < sizeof(action))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if(me->query("family/family_name")!="阎罗地府")
    return notify_fail("你不是地府弟子，不能学习轮回鞭！\n");
  if ((int)me->query_skill("hellfire-whip",1))
    return notify_fail("你已将这种鞭法融入烈火鞭，不必再分开练习了。\n");
  if( (int)me->query("kee") < 50
   || (int)me->query("force") < 50 )
    return notify_fail("你的内力或气不够，没有办法练习轮回鞭。\n");
  me->receive_damage("kee", 20);
  me->add("force", -10);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("lunhui-whip",1);
  if (level > action[i]["lvl"])
    return HIY"六道轮回，轮转如飞。\n"NOR;

  level = query_skill_lvl(me,"lunhui-whip",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习轮回鞭！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("ghost") + "/lunhui-whip/" + func;
}

int expell_delete()
{
  return 1;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 8;
}

mapping black_white_ness()
{
  return (["skill_level" : 180 ,
           "effect"      : 25  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("lunhui-whip",1);
  level = query_skill_lvl(me,"lunhui-whip",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了轮回鞭的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}