#include <ansi.h>
inherit SKILL;
mapping *action = ({
  (["name"  : HIW"「霉气扑鼻」"NOR,
    "action":
"$n只觉隐隐传来一阵霉气，正奇怪间，$N的左爪已到$l",
    "force" : 80,
    "dodge" : -5,
    "parry" : 5,
    "lvl"   : 0,
    "damage_type":	"抓伤",
  ]),
  (["name"  : HIW"「千疮百孔」"NOR,
    "action":
"$N笨拙无比地伸爪向$n的$l抓去。这招看似千疮百孔，\n"
"破绽无数，但等$n招架时，却被逼得手忙脚乱，叫苦不迭",
    "force" : 80,
    "dodge" : -5,
    "parry" : -5,
    "lvl"   : 50,
    "damage_type":	"抓伤",
  ]),
  (["name"  : HIY"「残缺不全」"NOR,
    "action":
"$N左爪不动，右爪迅捷无比地向$n连施五抓。当$n全神贯注地对付\n"
"这五抓时，$N的右爪已神不知鬼不觉地到了$n的$l",
    "force" : 90,
    "dodge" : 10,
    "parry" : -10,
    "lvl"   : 100,
    "damage_type" :	"抓伤",
  ]),
  (["name"  : HIY"「摇摇欲坠」"NOR,
    "action":
"$N突然间跃起数尺，居高临下向$n抓来。$n虽然看出\n"
"$N胸腹间空门大开，却被这「摇摇欲坠」的凌厉攻势逼得回手自救",
    "force" : 100,
    "dodge" : -10,
    "parry" : -10,
    "lvl"   : 200,
    "damage_type":	"抓伤",
  ]),
});
int valid_learn(object me)
{
  if (me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("你还未习惯血腥，无法学阴风爪。\n");

  if( me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练阴风爪必须空手。\n");

  if ((int)me->query_skill("unarmed",1) < (int)me->query_skill("yinfeng-zhua",1))
    return notify_fail("你的基本拳脚太低了，无法练习阴风爪！\n");
  return 1;
}

int valid_enable(string usage)
{
  return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;
  pfm_num = (int)me->query_temp("YFZ_perform");
  level = query_skill_lvl(me,"yinfeng-zhua",action);

  if (pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

int practice_skill(object me)
{
  if (me->query("class") != "yaomo")
    return notify_fail("你又没爪子，怎么练阴风爪？\n");
  if( (int)me->query("sen") < 100)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if( (int)me->query("kee") < 100 )
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if( (int)me->query("force") < 100 )
    return notify_fail("你的内力不够了。\n");
  me->receive_damage("kee", 20);
  me->receive_damage("sen", 20);
  me->add("force", -20);
  return 1;
}

string query_practice_msg(object me)
{
  int i, level;
  string sk_name;

  i = sizeof(action) -1 ;
  level = (int)me->query_skill("yinfeng-zhua",1);
  if (level > action[i]["lvl"])
    return RED"穿山打洞，唯我独尊。\n"NOR;

  level = query_skill_lvl(me,"yinfeng-zhua",action);
  sk_name = action[level]["name"];
  return sprintf("你依照所学练习阴风爪！对%s这招有了进一步的了解！\n",sk_name);
}

string perform_action_file(string func)
{
  return CLASS_D("wudidong") + "/yinfeng-zhua/" + func;
}

int expell_delete()
{
  return 1;
}

int effective_level()
{
  return 105;
}

int query_effect_parry(object me, object victim)
{
  return 110;
}

int learn_bonus()
{
  return 12;
}

int practice_bonus()
{
  return 6;
}

mapping black_white_ness()
{
  return (["skill_level" : 190 ,
           "effect"      : 10  ,
         ]);
}

void skill_improved(object me)
{
  int i, level , m_skill;
  string sk_name;

  i = sizeof(action) - 1 ;
  m_skill=me->query_skill("yinfeng-zhua",1);
  level = query_skill_lvl(me,"yinfeng-zhua",action);
  if ((level < i) && (m_skill == action[level]["lvl"] + 1) )
  {
    sk_name = action[level]["name"];
    tell_object(me,sprintf(HIR"你领悟了阴风爪的招式：%s%s%s\n"NOR,BLINK,sk_name,NOR));
  }
}