// dongyang-dao 东洋刀法
inherit SKILL;
mapping *action = ({
  (["action": "$N大喝一声，手中$w直劈下来，带起一阵风",
    "force" : 20,
    "damage": 20,
    "dodge" : 10,
    "parry" : 15,
    "lvl"   : 0,
    "damage_type" : "割伤"
  ]),
  (["action": "$N突然横切，划向$n的$l",
    "force" : 20,
    "damage": 30,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 10,
    "damage_type" : "割伤"
  ]),
  (["action": "$N手中的$w连续变换几个方向，最后突然直刺$n的$l",
    "force" : 20,
    "damage": 40,
    "dodge" : 5,
    "parry" : 5,
    "lvl"   : 30,
    "damage_type" : "刺伤"
  ]),
  (["action": "$N手中的$w猛然旋转，舞起一团刀影，直逼$n",
    "force" : 30,
    "damage": 40,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 50,
    "damage_type" : "割伤"
  ]),
  (["action": "$N手中$w一沉，双手持刃拦腰反切，砍向$n的$l",
    "force" : 30,
    "damage": 50,
    "dodge" : 15,
    "parry" : 10,
    "lvl"   : 80,
    "damage_type" : "割伤"
  ]),
  (["action": "$N长啸一声，手中的$w不住的晃动，宛若三把刀劈向$n",
    "force" : 30,
    "damage": 60,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 100,
    "damage_type" : "割伤"
  ]),
  (["action": "$N一转身，把背后全被卖给$n，突然双手一转，$w从$N腰侧刺了出来",
    "force" : 30,
    "damage": 70,
    "dodge" : 10,
    "parry" : 10,
    "lvl"   : 120,
    "damage_type" : "刺伤"
  ]),
  (["action": "$N猛然前袭，手中$w化作一道刀芒闪电般的刺向$n",
    "force" : 30,
    "damage": 80,
    "dodge" : 5,
    "parry" : 5,
    "lvl"   : 150,
    "damage_type" : "刺伤"
  ]),
});
int valid_enable(string usage)
{
  return usage == "blade" || usage == "parry";
}

int valid_learn(object me)
{
  return 0;
}

mapping query_action(object me, object weapon)
{
  int pfm_num, level;

  pfm_num = me->query_temp("DYB_perform");
  level = query_skill_lvl(me,"dongyang-blade",action);

  if(pfm_num && (pfm_num < sizeof(action)))
    return action[pfm_num];
  return action[random(level + 1)];
}

string perform_action_file(string func)
{
  return CLASS_D("common") + "/dongyang-blade/" + func;
}

