// agile.c 如鬼似魅
// Created by Doing Lu 10/7/2K
#include <ansi.h>
inherit F_CLEAN_UP;
#define P_FILE "/daemon/special/agile"
#define CAUSED "agile"
string name() { return HIC "如鬼似魅" NOR; }

int perform(object me, string skill)
{
  int count;
  if (me->query("kee") < 80)
    return notify_fail("你的体力不支，无法竭力提升自己的速度。\n");
  message_vision(HIC "$N" HIC "脚尖一点，踢起一些尘"
                 "土，整个人顿时如同纸鹞一般飘飘忽忽。\n" NOR, me);
  count = me->query_dex();
  count = random(count) + 1;

  if (me->query_temp(CAUSED))
    return notify_fail("你已经竭力提升你自己的速度了。\n");
  me->receive_damage("kee", 40 + random(40));
  me->set_bless_changed(P_FILE,CAUSED,"dodge",60+random(30),count);
  return 1;
}

void remove_effect(object me)
{
  if (objectp(me) && me->query_temp(CAUSED))
    tell_object(me, "你的如鬼似魅施展完毕，身形一顿，又慢了下来。\n");
}

