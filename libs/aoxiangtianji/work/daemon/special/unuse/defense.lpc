// defense.c 护体神功
// Created by Doing Lu 10/7/2K
#include <ansi.h>
inherit F_CLEAN_UP;
string name() { return MAG "护体神功" NOR; }

int perform(object me, string skill)
{
        int count;
	if(me->query("age")<18)
		return notify_fail("你还未成年，不能使用特殊技能 ^_^\n");
        if (me->query("kee") < 80)
                return notify_fail("你的体力不支，无法迅猛提升自己的防护力。\n");

        count =me->query("cps")*2/3;
        count=(int)(count*(1+me->query_skill("parry",1)/150));
        if (me->query_temp("special_skill/defense", 1))
                return notify_fail("你已经尽力提升自己的防护力了。\n");
   	 message_vision(MAG "$N" MAG "凝神聚气，对对手的一举一动感应的更加清晰。\n" NOR, me);
        me->receive_damage("kee", 40 + random(40));
        me->set_temp("special_skill/defense", 1);
        me->add_temp("apply/defense", count);
   	me->start_call_out((: call_other, __FILE__, "remove_effect", me,
			      count :), 360 + random(30));
        return 1;
}

void remove_effect(object me, int count)
{
        me->delete_temp("special_skill/defense", 1);
        me->add_temp("apply/defense", -count);
        tell_object(me, "你心神松懈下来，反应没那么敏锐了。\n");
}

