// hatred.c 杀气冲霄
// Created by Doing Lu 10/7/2K
#include <ansi.h>
inherit F_CLEAN_UP;
#define P_FILE "/daemon/special/hatred"
#define CAUSED "hatred"
string name() { return HIR "杀气冲霄" NOR; }

int perform(object me, string skill)
{
  int count;
  if (me->query("kee") < 80)
    return notify_fail("你的体力不支，无法蓄势提升自己的伤害力。\n");
  if (me->query_temp(CAUSED))
    return notify_fail("你现在已经是杀气腾腾了。\n");
  message_vision(HIR "$N" HIR "眼中精光闪过，冷冷的扫过四周，一股寒意凛然而起。\n" NOR, me);
  switch (me->query("character"))
  {
    case "光明磊落":
      count = 20;
      break;
    case "心狠手辣":
      count = 22;
      break;
    case "狡黠多变":
      count = 18;
      break;
    case "阴险奸诈":
      count = 28;
      break;
  }

  me->receive_damage("kee", 40 + random(40));
  me->set_bless_changed(P_FILE,CAUSED,"damage",60+random(30),count);
  return 1;
}

void remove_effect(object me, int count)
{
  if (objectp(me) && me->query_temp(CAUSED))
    tell_object(me, "你精神一松懈，杀气荡然无存。\n");
}

