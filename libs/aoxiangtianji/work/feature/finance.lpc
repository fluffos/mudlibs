// finance.c
// mon 12/31/96
// can_afford() checks if this_object() can afford a price, it returns:
//
//      0:      cannot afford.
//      1:      can afford with proper money(coins).
//      2:      can afford, but don't have enough proper money(coins).
//
int can_afford(int amount)
{
  int total, cash_value;
  object cash, gold, silver, coin, me=this_player();
  cash = present("thousand-cash_money",me);
  gold = present("gold_money",me);
  silver = present("silver_money",me);
  coin = present("coin_money",me);
  total = 0;
  cash_value = 0;
  if( cash )
    cash_value = cash->value();
  if( gold )
    total += gold->value();
  if( silver )
    total += silver->value();
  if( coin )
    total += coin->value();
  if( (cash_value + total) < amount )
    return 0;
  if( total < amount )
    return 2;
  return 1;
}

int pay_money(int amount)
{
  int total;
  object gold, silver, coin, me=this_player();
  int goldno, silverno, coinno;
  gold = present("gold_money",me);
  silver = present("silver_money",me);
  coin = present("coin_money",me);
// mon 7/21/99
// check for faked money.
  if(gold && !(gold->value()))
    gold=0;
  if(silver && !(silver->value()))
    silver=0;
  if(coin && !(coin->value()))
    coin=0;
  total = 0;
  if( gold )
    total += gold->value();
  if( silver )
    total += silver->value();
  if( coin )
    total += coin->value();
  if( total < amount )
    return 0;
  total -= amount;
  goldno = total/10000;
  silverno = (total % 10000) / 100;
  coinno = total % 100;
  if ( coinno == 0 && coin)
    destruct(coin);
  if (silverno == 0 && silver)
    destruct(silver);
  if (goldno == 0 && gold)
    destruct(gold);
  if (coinno>0)
  {
    if (!objectp(coin))
      coin=new("/obj/money/coin");
    coin->set_amount(coinno);
    coin->move(me,1);
  }

  if (silverno>0)
  {
    if (!objectp(silver))
      silver=new("/obj/money/silver");
    silver->set_amount(silverno);
    silver->move(me,1);
  }

  if (goldno>0)
  {
    if (!objectp(gold))
      gold=new("/obj/money/gold");
    gold->set_amount(goldno);
    gold->move(me,1);
  }

  me->save();
  return 1;
}

