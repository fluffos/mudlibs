object offensive_target(object me)
{
  int sz, i;
  object *enemy, target;
  me->clean_up_enemy();
  return me->select_opponent();
  enemy = me->query_enemy();
  if( !enemy || !arrayp(enemy) )
    return 0;
  sz = sizeof(enemy);
  if( sz > 8 )
    sz = 8;
  if( sz > 0 )
  {
    for (i=0; i<8; i++)
    {
      target = enemy[random(sz)];
      if (environment(target) == environment(me))
        return target;
    }

  }

  return 0;
}

