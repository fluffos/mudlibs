// master.c
#include <dbase.h>
#include <login.h>
#define APPLY_QUSET "/adm/daemons/sys_qregd"
int prevent_learn(object me, string skill)
{
  mapping fam;
  if (! me->is_apprentice_of(this_object())
    && mapp(fam = me->query("family"))
    && fam["family_name"] == query("family/family_name")
    && fam["generation"] > query("family/generation"))
  {
    command("say 虽然你是我门下的弟子，可是并非我的嫡传弟子... 还是去找你师父学吧。");
    return 1;
  }

  return 0;
}

void attempt_detach(object me)
{
  if (! me->is_apprentice_of(this_object()))
  {
    command("say 一边去，找你师傅。");
    return;
  }

  command("sigh");
  command("say 走吧走吧！你走吧！把你学到的武功留下！");
  me->skill_expell_penalty();
  me->unconcious();
  message_vision("$N将手掌粘在$n的背后，喃喃自语，不知道在说些什么。\n", this_object(), me);
  me->add("detach/" + me->query("family/family_name"), 1);
  me->delete("family");
  me->set("title", "普通百姓");
  me->add("detach/times", 1);
  me->save();
}

int ask_MPRW()
{
  object me=this_player();
  object ob=this_object();

  if(me->query("family/family_name")!= ob->query("family/family_name"))
    return notify_fail("你不是本门中人，为何向我要任务？");
  if(me->query("family/family_faith")<100)
    return notify_fail("你门派忠诚度不足100，不能领取任务。");
  command("pat "+me->query("id"));
  command("say 有志气！");

  notify_fail("你没有申请到门派任务！\n");
  if (!APPLY_QUSET->ask_quest(me,ob,"menpai"))
    return 0;
  return 1;
}

int ask_JC()
{
  object me=this_player();
  object ob=this_object();

  if(me->query("family/family_name")!= ob->query("family/family_name"))
    return notify_fail("你不是本门中人，为何向我交差？");

  notify_fail("你没有成功的取消门派任务！\n");
  if (!APPLY_QUSET->cancel_quest(me,ob,"menpai"))
    return 0;
  message_vision("$N不高兴的骂道：$n,你真是个没用的东西！",ob,me);
  return 1;
}

