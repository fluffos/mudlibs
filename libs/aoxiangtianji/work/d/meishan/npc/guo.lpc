inherit NPC;
void create()
{
  set_name("郭申", ({ "guo shen", "guo", "jiangjun" }) );
  set("gender", "男性" );
  set("long", "郭申是梅山七兄弟中的老二。\n");
  set("title", "梅山将军");
  set("age", 45);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 25);
  set("combat_exp",800000);
  set("force",1000);
  set("max_force",1500);
  set("force_factor", 70);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("max_mana", 800);
  set("mana", 1500);
  set("mana_factor", 40);
  set_skill("unarmed",145);
  set_skill("dodge",145);
  set_skill("parry", 145);
  set_skill("sword",145);
  set_skill("force",140);
  set_skill("spells", 100);
  set_skill("dao", 50);
  set_skill("moyun-shou", 145);
  set_skill("wuxiangforce", 140);
  set_skill("sancai-sword", 145);
  set_skill("moshenbu", 145);
  map_skill("spells", "dao");
  map_skill("unarmed", "moyun-shou");
  map_skill("force", "wuxiangforce");
  map_skill("sword", "sancai-sword");
  map_skill("parry", "sancai-sword");
  map_skill("dodge", "moshenbu");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
      (: perform_action, "sword.sanzi" :)
  }) );
  setup();
  carry_object("/d/obj/armor/armor/yinjia")->wear();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
}

int accept_fight(object me)
{
  command("nod");
  command("exert powerup");
  return 1;
}