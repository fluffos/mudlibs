inherit SMALLROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "书房");
  set ("long", @LONG
秦将军请来的教书先生就住在这里。除了一张床和几张桌椅之
外，屋子里就只有几个大书架了。仔细看看，书架上净是兵法、武
功的书。看来秦公子是要子承父业了。
LONG);
  set("exits", ([
    "south" : __DIR__"son_cabinet",
  ]));
  set("objects", ([
    __DIR__"obj/shelf" : 1,
  ]));
  set("book",1);
  setup();
}

void init()
{
  add_action("do_search",({"search","xunzhao"}));
}

int do_search(string arg)
{
  object book;
  object me = this_player();

  if (!arg || (arg != "shelf" && arg != "book"))
  {
    write("你要找什么？\n");
    return 1;
  }

  if (!query("book"))
  {
    write("看来找不到什么有价值的东西了！\n");
    return 1;
  }

  book = new("/d/obj/book/baguatu");
  book->move(me,1);
  book->set("owner",me->query("id"));
  write("你突然发现了一册十分少见的图书，急忙拿在了手中，仔细一看，原来是本八卦图！\n");
  set("book",0);
  return 1;
}

