#include <ansi.h>
inherit ITEM;
#define SHU    "/d/obj/book/advance_archery"
void create()
{
  object ob;
  set_name(WHT "书架" NOR, ({ "shelf"}) );
  set_weight(5000000);
  set_max_encumbrance(800000);
  if (clonep())
  {
    set_default_object(__FILE__);
    ob = find_object(SHU);
    if (! ob) ob = load_object(SHU);
    if (objectp(ob) && !environment(ob))
      ob->move(this_object());
  }

  else
  {
    set("prep", "in");
    set("unit", "只");
    set("long", WHT "一只书架，里面摆满了各种兵书战册。\n" NOR);
    set("value", 1);
  }

}

int is_container()
{
  return 1;
}

