inherit SMALLROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "干戈隅");
  set ("long", @LONG
进门后，右手墙壁上挂了一幅很大的肖像(image)，两旁供着两柄长枪。
一个小童刚刚打扫过房间，屋里一尘不染。尤其是两柄枪，被擦得光
可鉴人。
LONG);
  set("exits", ([ /* sizeof() == 1 */
    "east" : __DIR__"wusi_xuan",
  ]));
  set("item_desc",([
     "image" : "一幅很大的秦将军画像，仔细看看，不免让人有点疑惑，画像的后面似乎隐藏了什么。\n",
  ]));

  setup();
}

void init()
{
  add_action("do_jie",({"jie","jiekai","open","dakai"}));
  add_action("do_knock",({"knock","qiao"}));
}

int do_jie(string arg)
{
  object me = this_player();
  string fam = me->query("family/family_name");

  if (!arg || (arg != "image") && arg != "huaxiang" && arg != "xiang")
  {
    write("什么？\n");
    return 1;
  }

  if (fam != "将军府")
  {
    write("旁边过来个小童，很生气的喊叫到，“你要干什么？”\n");
    return 1;
  }

  write("你看看四周无人，偷偷的把那副画像解开了，哇，居然在画像的后面有个小门！\n"
        "不知道敲敲(knock)会发生什么？\n");
  me->set_temp("jjf/jie_image",1);
  return 1;
}

int do_knock(string arg)
{
  object me = this_player();
  string fam = me->query("family/family_name");
  if (!arg || arg != "door")
  {
    write("什么？\n");
    return 1;
  }

  if (!me->query_temp("jjf/jie_image"))
  {
    write("什么？\n");
    return 1;
  }

  if (objectp(me->query_temp("is_riding")))
  {
    write("你还是先下了坐骑吧！\n");
    return 1;
  }

  if (fam != "将军府")
  {
    write("旁边过来个小童，很生气的喊叫到，“你要干什么？”\n");
    return 1;
  }

  if (!me->query("family/can_bai/liyuanba"))
  {
    message_vision("$N解开了画像，忍不住好奇，把画像后的小门敲了敲！\n",me);
    tell_object(me,"可是什么都没有发生！\n");
    return 1;
  }

  message_vision("$N解开了画像，忍不住好奇，把画像后的小门敲了敲！\n",me);
  message_vision("小门突然一个翻转，$N一下子掉了进去！\n",me);
  me->move(__DIR__"li-mishi");
  return 1;
}

