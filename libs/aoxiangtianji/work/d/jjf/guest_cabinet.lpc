// Room: /d/jjf/guest_cabinet.c
inherit SMALLROOM;
inherit LANDROOM;
#include <ansi.h>
void create ()
{
  set ("short", "小阁楼");
  set ("long", @LONG
秦将军没有女儿，于是小阁楼就留给了来京城小住的亲朋好友。小几
上的一对羊脂玉瓶里插的满满的都是晶莹剔透的白菊，不知哪里放了
个香炉，吐着一缕似有似无的暗香。一个家将站在楼梯口，守着上楼
的路。也不知楼上住的是哪位贵客。
LONG);
  set("objects", ([ /* sizeof() == 1 */
     __DIR__"npc/luochun" : 1,
  ]));

  set("exits", ([ /* sizeof() == 2 */
    "north" : __DIR__"pavillion",
    "up" : __DIR__"guest_cabinet2",
  ]));
  setup();
}

int valid_leave(object me, string dir)
{
  object guard, *inv, letter;
  int i;
  if(dir != "up")
    return ::valid_leave(me, dir);

  inv=all_inventory(me);
  i=sizeof(inv);
  if(objectp(present("luo chun", environment(me))))
    guard=present("luo chun", environment(me));
  if(!objectp(guard))
    return ::valid_leave(me,dir);

  inv=all_inventory(me);
  i=sizeof(inv);
  while (i--)
  {
    if (inv[i]->is_character())
      return notify_fail("你不可以背个活人上去！\n");
  }

  if (!(letter=present("shu xin", me)
     && letter->query("header")=="秦琼至罗成")
     && me->query("family/master_id") != "luo cheng"
     && objectp(guard))
  {
    return notify_fail(CYN "罗春喝道：呔！楼上乃贵人居住之处，不得擅闯！\n"NOR);
  }

  return ::valid_leave(me, dir);
}