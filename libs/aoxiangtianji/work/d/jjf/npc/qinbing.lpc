// qinbing.c
inherit NPC;
void create()
{
  set_name("亲兵", ({ "qin bing", "qin", "bing", "qinbing"}));
  set("gender", "男性");
  set("age", 19+random(30));
  set("title", "将军府");
  set ("long", @LONG
这些亲兵都是在沙场上立过无数汗马功劳的强将。
他们不原受封为官，宁肯跟随保护旧主。
LONG);
  set("combat_exp", 300000+random(40000));
  set_skill("blade", 100);
  set_skill("force", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("spells", 100);
  set_skill("wuhu-blade", 100);
  set_skill("lengquan-force", 100);
  set_skill("unarmed", 100);
  set_skill("yanxing-steps", 100);
  map_skill("force", "lengquan-force");
  map_skill("parry", "wuhu-blade");
  map_skill("blade", "wuhu-blade");
  map_skill("dodge", "yanxing-steps");
  set("max_sen", 1000);
  set("max_kee", 1000+random(200));
  set("force", 2000);
  set("max_force", 1000);
  set("force_factor", 15);
  set("mana", 2000);
  set("max_mana", 1000);
  set("mana_factor", 50);
  create_family("将军府", 3, "蓝");
  setup();
  carry_object("/d/obj/weapon/blade/dandao")->wield();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();

  setup();
}