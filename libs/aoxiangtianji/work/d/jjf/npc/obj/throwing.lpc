inherit THROWING;
void create()
{
  set_name("飞璜石", ({"shi"}));
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long",    "飞璜石是一种十分常见的暗器。\n");
    set("unit", "些");
    set("base_unit", "块");
    set("base_weight", 50);
    set("value", 50);
    set("wound_percent", 30);
    set("weapon_prop/damage", 30);
  }

  set_amount(10);
  set("no_wield", "这不是用来装备的。\n");
  setup();
}

