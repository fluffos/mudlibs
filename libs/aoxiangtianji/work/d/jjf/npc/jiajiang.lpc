// jiading.c 家丁
inherit NPC;
void create()
{
  set_name("家将", ({ "jia jiang", "jia", "jiang"}));
  set("gender", "男性");
  set("age", 19+random(30));

  set("combat_exp", 200000+random(50000));
  set_skill("spear", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("unarmed", 100);
  set_skill("yanxing-steps",100);
  set_skill("duo-spear",100);
  map_skill("spear", "duo-spear");
  map_skill("parry", "duo-spear");
  map_skill("dodge", "yanxing-steps");
  set("force", 1500);
  set("max_force",800);
  setup();
  carry_object("/obj/cloth/bingfu")->wear();
  carry_object("/d/obj/weapon/spear/changqiang")->wield();
  add_money("silver", 2+random(5));
}

