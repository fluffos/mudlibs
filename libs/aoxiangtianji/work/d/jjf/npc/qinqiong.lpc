#include <ansi.h>
#include "jjf.h"
inherit NPC;
inherit F_MASTER;
string ask_chui();
string ask_rank();
void create()
{
  set_name("秦琼", ({ "qin qiong", "qin", "shubao", "qiong", "qin shubao", "master", "shifu" }));
  set("title", "开国元勋");
  set("gender", "男性");
  set("age", 43);
  set("str", 30);
  set("per", 26);
  set("int", 30);
  set("cor", 50);
  set("cps", 50);
  set("long", "秦叔宝是大唐国开国名臣，更是一位出名的武将。\n");
  set("combat_exp", 2000000);
  set("daoxing", 2000000);
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("spear", 200);
  set_skill("mace", 200);
  set_skill("medical",200);
  set_skill("shachang-yishu",200);
  map_skill("medical","shachang-yishu");
  set_skill("lengquan-force", 200);
  set_skill("baguazhou", 200);
  set_skill("yanxing-steps", 200);
  set_skill("changquan", 200);
  set_skill("duo-spear", 200);
  set_skill("wusi-mace", 220);

  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed", "changquan");
  map_skill("parry", "wusi-mace");
  map_skill("spear", "duo-spear");
  map_skill("mace", "wusi-mace");
  set("max_sen", 5000);
  set("max_kee", 5000);
  set("force", 4500);
  set("max_force", 2500);
  set("force_factor", 120);
  set("mana", 4800);
  set("max_mana", 2500);
  set("mana_factor", 120);

  set("inquiry", ([
   "name": "在下秦琼，字叔宝。",
   "here": "这里就是将军府啊，难道你不知道？",
   "rumors": "在下不在江湖行走很久了，江湖上的事情在下可不太清楚。",
   "锤法" : (: ask_chui :),
   "职位" : (: ask_rank :),
   "学习锤法" : (: ask_chui :),
  ]) );
  create_family("将军府", 2, "蓝");

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
     (: cast_spell, "zhanshen" :),
     (: perform_action, "mace.shashou" :),
  }) );
  setup();
  carry_object("/d/obj/armor/armor/jinjia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/weapon/mace/silverjian")->wield();
}

int accept_fight(object me)
{
  command("say 老夫久未和江湖人动手过招了，今日也不想破例。\n");
  return 0;
}

int attempt_apprentice(object me)
{
  string myname = RANK_D->query_respect(me);

  if (me != this_player(1))
    return 0;

  if (! permit_recruit(me))
    return 0;
  if( (string)me->query("family/family_name") != "将军府")
  {
    command("say 我只收将军府的弟子！\n");
    return 0;
  }

  if ((int)me->query("level")<= 25)
  {
    command(sprintf("say 这位%s还是先去跟本府家将打打基础吧！",myname));
    return 0;
  }

  command("haha");
  command(sprintf("say 很好，时下正是用人之际，%s 多加努力，他日必定有成。\n",myname));
  command("recruit " + me->query("id") );
  if ((string)me->query("class") != "fighter")
    me->set("class", "fighter");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname = RANK_D->query_respect(me);
  if( !me->is_apprentice_of(this_object()) )
    return 1;
  if ((string)me->query("family/family_name") != "将军府")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我将军府人，"
                    "老夫所教恐怕难以理解。\n",myname));
    return 1;
  }

  if ((string)me->query("class") != "fighter")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s并非骑马打仗的将军，"
                    "老夫所教恐怕难以理解。\n",myname));
    return 1;
  }

  if (me->query("level") <= 25)
  {
    command(sprintf("emote 皱了皱眉头，说道：%s还欠修练，"
                    "老夫所教恐怕难以理解。\n",myname));
    return 1;
  }

  return 0;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我将军府的弟子！\n";

  if (me->query("class") != "fighter")
    return "你不是将士，问我何用？\n";

  switch (topic)
  {
    case "历练" :
    case "历炼" :
    case "锻炼" :
      return QUEST_D->accept_ask(master, me, topic);
      break;

 //baguazhou
    case "五气朝元" :
    case "chaoyuan" :
      if (me->query("family/can_cast/chaoyuan"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("baguazhou",1) < 80)
        return "你的八卦咒修为不够，暂时无法领悟！\n";
      message_vision("$N微微一笑，在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁会心一笑！\n",me);
      me->set("family/can_cast/chaoyuan",1);
      return "你学会了“五气朝元”！\n";
      break;
    case "天师符法" :
    case "fu" :
      if (me->query("family/can_cast/fu"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("baguazhou",1) < 100)
        return "你的八卦咒修为不够，暂时无法领悟！\n";
      message_vision("$N微微一笑，在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁会心一笑！\n",me);
      me->set("family/can_cast/fu",1);
      return "你学会了“天师符法”！\n";
      break;

    case "战神一笑" :
    case "zhanshen" :
      if (me->query("family/can_cast/zhanshen"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 800)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("baguazhou",1) < 120)
        return "你的八卦咒修为不够，暂时无法领悟！\n";
      message_vision("$N微微一笑，在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁会心一笑！\n",me);
      me->set("family/can_cast/zhanshen",1);
      return "你学会了“战神一笑”！\n";
      break;
//wusi-mace
    case "撒手锏" :
    case "shashou" :
      if (me->query("family/can_pfm/shashou"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("wusi-mace",1) < 80)
        return "你的无私锏修为不够，暂时无法领悟！\n";
      if (me->query_skill("lengquan-force",1) < 80)
        return "你的冷泉神功修为不够，暂时无法领悟！\n";
      message_vision("$N微微一笑，在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁会心一笑！\n",me);
      me->set("family/can_pfm/shashou",1);
      return "你学会了“撒手锏”！\n";
      break;
//duo-spear
    case "枪中夹锏" :
    case "qiangjian" :
      if (me->query("family/can_pfm/qiangjian"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("wusi-mace",1) < 100)
        return "你的无私锏修为不够，暂时无法领悟！\n";
      if (me->query_skill("duo-spear",1) < 100)
        return "你的夺命枪法修为不够，暂时无法领悟！\n";
      if (me->query_skill("lengquan-force",1) < 100)
        return "你的冷泉神功修为不够，暂时无法领悟！\n";
      message_vision("$N微微一笑，在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁会心一笑！\n",me);
      me->set("family/can_pfm/qiangjian",1);
      return "你学会了“枪中夹锏”！\n";
      break;
    case "破阵杀" :
    case "sha" :
      return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"    : "sha",
                "name"   : "破阵杀",
                "sk1"     : "duo-spear",
                "lv1"     : 120,
                "sk2"     : "lengquan-force",
                "lv2"     : 120,
                "max_force" : 1500,
                "gongxian": 300,]));
      break;
//changquan
    case "双手翅展" :
    case "zhan" :
      if (me->query("family/can_pfm/zhan"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 100)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("changquan",1) < 100)
        return "你的长拳修为不够，暂时无法领悟！\n";
      if (me->query_skill("lengquan-force",1) < 100)
        return "你的冷泉神功修为不够，暂时无法领悟！\n";
      message_vision("$N微微一笑，在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁会心一笑！\n",me);
      me->set("family/can_pfm/zhan",1);
      return "你学会了“双手翅展”！\n";
      break;
  }

  return 0;
}

string ask_chui()
{
  object me;
  me = this_player(1);
  if ((string)me->query("family/family_name") != "将军府")
    return "我不清楚。。。\n";
  if (me->query("level") < 25)
    return "你的等级还不够高，学不了锤法！\n";
  if ((int)me->query("family/family_faith") < 1000)
    return "你还是先为本门做些事情吧！\n";
  message_vision("$N低头沉思了良久，说道：这锤法，天下第一人非李元霸莫属了！\n",this_object());
  message_vision("$N长叹了一口气，继续说道，可惜。。。\n",this_object());
  me->set("family/can_bai/liyuanba",1);
  return "万事都要有机缘啊！\n";
}

string ask_rank()
{
  object master = this_object();
  object who = this_player();
  int t = time();

  if (who->is_busy() || who->is_fighting())
    return "你正忙着呢！\n";

  if (t - (int)who->query("last_ask_rank") < 7200)
    return "你不是刚刚问过了吗？\n";

  if (!RANK_D->re_title(master,who))
    return "你无法从我这里获得称号！\n";

  who->set("last_ask_rank",t);
  who->start_busy(1);
  return sprintf("%s 点了点头！\n",master->name());
}

