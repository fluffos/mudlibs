#include <ansi.h>
#include "jjf.h"
inherit NPC;
inherit F_MASTER;
int handle_kill(object me);
int accept_fight(object me);
int attempt_apprentice(object me);
int recruit_apprentice(object me);
void check_fight (object npc, object me);
void player_win(object me);
void player_lose(object me);
void move_down(object ob);
void do_revive(object ob);
void create()
{
  set_name("罗成", ({"luo cheng", "luo", "cheng", "luocheng", "master", "shifu"}));
  set ("long", @LONG
罗成是秦琼的表弟，乃是隋唐第七条好汉。传说他早已
在保长安时被乱箭射死战死，但不知为何还在这里。听
说罗成年幼时曾受过异人传授，学得一身奇异的内功，
因此比武极少败过。
LONG);
  set("title", "开国元勋");
  set("gender", "男性");
  set("age", 34);
  set("str", 50);
  set("cor", 50);
  set("cps", 50);
  set("spi", 30);
  set("per", 30);
  set("con", 50);
  set("int", 30);
  set("kar", 15);
  set("combat_exp", 2200000);
  set("daoxing", 2200000);

  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("spear", 200);
  set_skill("mace", 200);
  set_skill("lengquan-force", 200);
  set_skill("baguazhou", 200);
  set_skill("yanxing-steps", 200);
  set_skill("changquan", 200);
  set_skill("bawang-spear", 200);
  set_skill("wusi-mace", 220);

  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed", "changquan");
  map_skill("parry", "bawang-spear");
  map_skill("spear", "bawang-spear");
  map_skill("mace", "wusi-mace");

  set("max_sen", 45000);
  set("max_kee", 5000);
  set("force", 4000);
  set("max_force", 2000);
  set("force_factor", 100);
  set("mana", 4000);
  set("max_mana", 2000);
  set("mana_factor", 100);

  create_family("将军府", 2, "蓝");
  setup();

  carry_object("/d/obj/weapon/spear/jinqiang")->wield();
  carry_object("/d/obj/armor/armor/jinjia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
}

void init()
{
  object me,ob;
  ::init();

  me = this_object();
  ob = this_player(1);

  if(objectp(ob) && interactive(ob) && member_array(ob, me->query_enemy()) != -1)
  {
    if (me->is_fighting())
    {
      message_vision(CYN"$N对$n喝道：“又是你！滚出去！”"NOR,me, ob);
      move_down(ob);
    }

    else
      do_revive(me);
  }

  add_action("do_kill", "kill");
  add_action("do_surrender", "surrender");
}

int do_surrender()
{
  this_player()->delete_temp("pending/jjf_apprentice_luocheng");
  return 0;
}

int do_kill(string arg)
{
  if(!id(arg))
    return 0;
  handle_kill(this_player(1));
  return 0;
}

int handle_kill(object ob)
{
  object me = this_object();

  if (!objectp(me) || !living(me) )
    return 0;

  if(me->is_fighting())
  {
    message_vision(CYN"$N抱拳道：众位，既然$n想要拼命，还请稍候片刻。\n"NOR, me, ob);
    me->remove_all_enemy();
  }

  do_revive(me);
  command("kill " + ob->query("id"));
}

int accept_fight(object me)
{
  if (is_busy())
    return notify_fail("他正忙着呢！待会再开打！\n");
  if (query_temp("no_move"))
    delete_temp("no_move");

  if(me->query_temp("pending/jjf_apprentice_luocheng"))
  {
    set("kee", query("max_kee"));
    set("eff_kee", query("max_kee"));
    set("sen", query("max_sen"));
    set("eff_sen", query("max_sen"));
    set("force", 2*query("max_force"));
    set("mana", 2*query("max_mana"));
    remove_call_out("check_fight");
    call_out("check_fight", 1, this_object(), me);
    return 1;
  }

  command("say 难道你来这里就是想打架？我看还是算了吧。\n");
  call_out("move_down", 1, me);
  return 0;
}

int attempt_apprentice(object me)
{
  string myname;
  if (me != this_player(1))
    return 0;

  myname=RANK_D->query_respect(me);

  if (! permit_recruit(me))
    return 0;
  if( (string)me->query("family/family_name") != "将军府")
  {
    command("say 我只收将军府的弟子！\n");
    return 0;
  }

  if ((int)me->query("level")<= 25)
  {
    command(sprintf("say 这位%s还是先去跟本府家将打打基础吧！",myname));
    return 0;
  }

  if(me->query("mark/jjf_defeated_luocheng"))
  {
    command(sprintf("say 不错，不错。%s果然是可教之才！\n",myname));
    command(sprintf("say %s武艺过人。你我不妨切磋一番。\n",myname));
    command("recruit " + me->query("id"));
    return 1;
  }

  if (is_fighting())
  {
    command("say 现在在下正忙。");
    return 1;
  }

  command("consider");
  command("say 在下从不收徒。");
  command("say 但阁下若能胜过我手中枪，你我不妨互相切磋功夫。");
  me->set_temp("pending/jjf_apprentice_luocheng", 1);
  return 1;
}

int chat()
{
  if(!is_fighting())
    return 1;
  if(random(100) < 20)
    do_revive(this_object());
}

void check_fight (object npc, object me)
{
  int npc_kee, my_kee, my_ratio, npc_ratio;
  int npc_max_kee, my_max_kee;

  my_kee = me->query("kee");
  npc_kee = npc->query("kee");
  my_max_kee = me->query("max_kee");
  npc_max_kee = npc->query("max_kee");
  my_ratio=my_kee*100/my_max_kee;
  npc_ratio=npc_kee*100/npc_max_kee;
  if (is_fighting())
  {
    call_out ("check_fight",1,npc,me);
    return;
  }

  if (query_temp("last_opponent") != me)
    return;

  if (npc->query_last_damage_from() != me)
    return;

  if (!present(me, environment(npc)))
    return;

  if (npc_ratio < 60 || my_ratio < 60)
  {
    if(npc_ratio < my_ratio)
      call_out("player_win", 1, me);
    else
      call_out("player_lose", 1, me);
  }

  return;
}

void player_win(object me)
{
  this_object()->delete_temp("last_opponent");

  me->receive_damage("kee",0);

  if (me->query_temp("pending/jjf_apprentice_luocheng"))
  {
    me->set("mark/jjf_defeated_luocheng", 1);
    me->delete_temp("pending/jjf_apprentice_luocheng");
    command("recruit "+me->query("id"));
  }

  return;
}

void player_lose(object me)
{
  this_object()->delete_temp("last_opponent");
  me->receive_damage("kee",0);
  command("say "+RANK_D->query_respect(me) +"不必气馁，再接再厉！");
  return;
}

void do_revive(object ob)
{
  int max_kee, max_sen;
  int max_mana, max_force;

  max_kee = ob->query("max_kee");
  max_kee = ob->query("max_sen");
  max_mana = ob->query("max_mana");
  max_force = ob->query("max_force");
  ob->set("kee", max_kee);
  ob->set("eff_kee", max_kee);
  ob->set("sen",max_sen);
  ob->set("eff_sen",max_sen);
  ob->set("force",2*max_force);
  ob->set("mana",2*max_mana);
  ob->clear_condition();
}

void move_down(object me)
{
  if (!me || !environment(me))
    return;

  if(environment(this_object()) != find_object("/d/jjf/guest_cabinet2"))
    return;

  me->move("/d/jjf/guest_cabinet");
  return;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我将军府的弟子！\n";

  if (me->query("class") != "fighter")
    return "你不是将士，问我何用？\n";

  switch (topic)
  {
    case "铁骑铮铮" :
    case "tieji" :
      return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"    : "tieji",
                "name"   : "铁骑铮铮",
                "sk1"     : "bawang-spear",
                "lv1"     : 180,
                "sk2"     : "lengquan-force",
                "lv2"     : 180,
                "max_force" : 2500,
                "gongxian": 800,]));
      break;
  }

  return 0;
}

