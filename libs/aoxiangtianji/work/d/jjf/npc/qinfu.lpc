#include <ansi.h>
#include "jjf.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("秦富", ({"qin fu", "qin", "fu", "master"}));
  set("title", "将军府管家");
  set("gender", "男性");
  set("age", 38);
  set("str", 30);
  set("int", 25);

  set_skill("literate", 90);
  set_skill("force", 90);
  set_skill("spells", 90);
  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("parry", 90);
  set_skill("mace", 90);
  set_skill("lengquan-force", 90);
  set_skill("baguazhou", 90);
  set_skill("yanxing-steps", 90);
  set_skill("changquan", 90);
  set_skill("wusi-mace", 90);
  map_skill("force", "lengquan-force");
  map_skill("spells","baguazhou");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed", "changquan");
  map_skill("mace", "wusi-mace");
  map_skill("parry", "wusi-mace");
  set("max_sen", 700);
  set("max_kee", 700);
  set("force", 1000);
  set("max_force", 500);
  set("force_factor", 30);
  set("mana", 1000);
  set("max_mana", 500);
  set("mana_factor", 30);
  set("combat_exp", 75000);
  create_family("将军府", 4, "入门教头");
  setup();
  carry_object("/d/obj/armor/armor/tongjia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("d/obj/weapon/mace/ironmace")->wield();
}

int attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if( (string)ob->query("family/family_name") == "将军府")
  {
    command("say 大家同门中人，不敢当，不敢当！\n");
    return 0;
  }

  command("haha");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "fighter")
    ob->set("class", "fighter");
  return 1;
}