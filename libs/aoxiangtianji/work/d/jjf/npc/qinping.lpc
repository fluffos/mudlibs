#include <ansi.h>
#include "jjf.h"
inherit NPC;
inherit F_MASTER;
string try_me();
int total=random(20);
mapping c1=([]);
void create()
{
  set_name("秦平", ({"qin ping", "qin", "master"}));
  set("title", "将军府管家");
  set("gender", "男性");
  set("age", 46);
  set("str", 30);
  set("int", 25);

  set_skill("literate", 150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("mace", 150);
  set_skill("lengquan-force", 150);
  set_skill("baguazhou", 150);
  set_skill("yanxing-steps", 150);
  set_skill("changquan", 150);
  set_skill("wusi-mace", 150);
  set_skill("medical",150);
  set_skill("shachang-yishu",150);
  map_skill("medical","shachang-yishu");
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed", "changquan");
  map_skill("mace", "wusi-mace");
  map_skill("parry", "wusi-mace");
  set("max_sen", 1200);
  set("max_kee", 1200);
  set("force", 1500);
  set("max_force", 1000);
  set("force_factor", 50);
  set("combat_exp", 500000);
  set("mana", 1500);
  set("max_mana", 1000);
  set("mana_factor", 50);
  set("daoxing", 500000);
  setup();
  set("inquiry", ([
    "兵器": (: try_me :),
    "衣甲": (: try_me :)
  ]) );

  create_family("将军府", 3, "蓝");
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/d/obj/weapon/mace/ironmace")->wield();
}

int attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if( (string)ob->query("family/family_name") != "将军府")
  {
    command("say 我只收将军府的弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 15)
  {
    command("say 你还需要更多的磨练！\n");
    return 0;
  }

  command("haha");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "fighter")
    ob->set("class", "fighter");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname = RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "将军府")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我将军府人，"
                    "我所教的恐怕难以理解。\n",myname));
    return 1;
  }

  if ((string)me->query("class") != "fighter")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s并非骑马打仗的将军，"
                    "我所教的恐怕难以理解。\n",myname));
    return 1;
  }

  if ((int)me->query("level") <= 15)
  {
    command(sprintf("emote 皱了皱眉头，说道：%s还欠修练，"
                    "我所教的恐怕难以理解。\n",myname));
    return 1;
  }

  return 0;
}

void init()
{
  add_action("do_yao", "yao");
  add_action("do_huan", "huan");
}

int do_yao(string arg)
{
  object me=this_player(1), obj;

  if((string)me->query("family/family_name")!="将军府")
    return notify_fail(CYN"秦平道：对不住，将军府衣甲兵器只发给本派子弟。\n"NOR);
  if( !arg ||
     (arg != "blade"
   && arg != "sword"
   && arg != "axe"
   && arg != "fork"
   && arg != "dagger"
   && arg != "hammer"
   && arg != "mace"
   && arg != "spear"
   && arg != "staff"
   && arg != "stick"
   && arg != "throwing"
   && arg != "whip"
   && arg != "bow"
   && arg != "body"
   && arg != "head"
   && arg != "feet"
   && arg != "waist"))
    return notify_fail(CYN"秦平道：对不住，你要的东西我这里没有。\n"NOR);
  if(c1[arg]>=total)
    return notify_fail(CYN"秦平道：对不住，你要的东西我已经发完了。\n"NOR);
  if (arg == "body"
   || arg == "head"
   || arg == "feet"
   || arg == "waist")
  {
    if (me->query_temp("mark/jjf_armor") >=3)
      return notify_fail(CYN"秦平怒道：你要了这么多件衣甲，还不够？！\n"NOR);
    me->add_temp("mark/jjf_armor", 1);
  }

  else
  {
    if (me->query_temp("mark/jjf_weapon") >= 2)
      return notify_fail(CYN"秦平怒道：你要了这么多件兵器，还不够？！\n"NOR);
    me->add_temp("mark/jjf_weapon", 1);
  }

  c1[arg]+=1;
  if (arg== "bow")
  {
    obj=new("/d/obj/weapon/bow/mugong");
    obj->set("no_sell", 1);
    obj->set("no_drop", 1);
    obj->set("no_give", 1);
    obj->set("no_get",1);
    obj->set("jjf_weapon", 1);
    command("say 这位"+RANK_D->query_respect(me)+"，"+obj->query("name")+"为数不多，千万别随便扔。");
    command("say 要是您不再需要，请还(huan)给我。");
    message_vision("秦平给$N一"+obj->query("unit")+obj->query("name")+ "。\n", me);
    obj->move(me);
  }

  else if (arg == "body"
        || arg == "head"
        || arg == "feet"
        || arg == "waist")
  {
    obj=new(__DIR__"obj/"+arg);
    obj->set("no_sell", 1);
    obj->set("no_drop", 1);
    obj->set("no_give", 1);
    obj->set("jjf_armor", 1);
    obj->set("no_get",1);
    command("say 这位"+RANK_D->query_respect(me)+"，"+obj->query("name")+"为数不多，千万别随便扔。");
    command("say 要是您不再需要，请还(huan)给我。");
    message_vision("秦平给$N一"+obj->query("unit")+obj->query("name")+ "。\n", me);
    obj->move(me);
  }

  else
  {
    obj=new(__DIR__"obj/"+arg);
    obj->set("no_sell", 1);
    obj->set("no_drop", 1);
    obj->set("no_give", 1);
    obj->set("no_get",1);
    obj->set("jjf_weapon", 1);
    command("say 这位"+RANK_D->query_respect(me)+"，"+obj->query("name")+"为数不多，千万别随便扔。");
    command("say 要是您不再需要，请还(huan)给我。");
    message_vision("秦平给$N一"+obj->query("unit")+obj->query("name")+ "。\n", me);
    obj->move(me);
  }

  return 1;
}

string try_me()
{
  command("say 秦将军亲自破费，准备了一些兵器和衣甲。");
  return ("只要是将军府的弟子就可以拿一套去用。");
}

int do_huan(string arg)
{
  object me=this_player(), npc=this_object(), ob;
  if (!arg)
    return notify_fail("你要还什么！\n");
  if(!objectp(ob=present(arg, me)))
    return notify_fail("你身上没有这样东西。\n");
  if(ob->query("jjf_weapon")==1)
  {
    message_vision("$N拿出" + ob->short() + "给$n。\n", me, npc);
    command("say 不错，不错，这"+ob->query("unit")+ob->query("name")+"修修还可以用。");
    command("thank "+me->query("id"));
    destruct(ob);
    me->add_temp("mark/jjf_weapon", -1);
  }

  else if(ob->query("jjf_armor")==1)
  {
    message_vision("$N拿出" + ob->short() + "给$n。\n", me, npc);
    command("say 不错，不错，这"+ob->query("unit")+ob->query("name")+"修修还可以用。");
    command("thank "+me->query("id"));
    destruct(ob);
    me->add_temp("mark/jjf_armor", -1);
  }

  else
    return notify_fail(CYN"秦平道：对不住，这好象不是我们府里的东西吧！\n"NOR);
  return 1;
}

