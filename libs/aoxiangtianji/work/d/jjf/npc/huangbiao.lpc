inherit NPC;
void create()
{
  set_name("黄骠马", ({"huangbiao ma", "ma"}));
  set("race", "野兽");
  set("age", 20);
  set("long", "一只长得不很精神，一身黄毛的大马．\n");
  set("combat_exp", 10000);
  set("chat_chance", 1);
  set("chat_msg", ({
     "黄骠马哼哼的叫了几声．\n"
  }));
  set("ride/msg", "骑");
  set("ride/dodge", 8 + random(4));

  set("limbs", ({ "头部", "腹部", "尾巴","后腿","前腿" }) );
  set("verbs", ({ "bite", "hoof" }) );
  set_temp("apply/attack", 50);
  set_temp("apply/armor", 15);
  set_temp("apply/damage", 25);
  setup();
}

