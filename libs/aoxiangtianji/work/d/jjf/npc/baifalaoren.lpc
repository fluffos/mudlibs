#include <ansi.h>
#include "jjf.h"
inherit NPC;
inherit F_MASTER;
string kick_back();
void create()
{
  set_name(HIW"白发老人"NOR, ({ "lao ren", "lao", "laoren","ren", "baifa", "master"}));
  set("gender", "男性");
  set("age", 100);
  set("str", 20);
  set("per", 130);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("long","
这是一位鹤发童颜的老人。他看起来似乎很老的样子，
但偏又是红光满面。看到你打量他，他对你和蔼地笑了
一笑。");
  set("title", HIY"神仙"NOR);
  set("combat_exp", 5000000);
  set("daoxing", 5000000);
  set_skill("literate", 300);
  set_skill("unarmed", 300);
  set_skill("changquan", 300);
  set_skill("force", 300);
  set_skill("lengquan-force", 300);
  set_skill("axe", 300);
  set_skill("sanban-axe", 300);
  set_skill("dodge", 300);
  set_skill("yanxing-steps", 300);
  set_skill("parry", 300);
  set_skill("spear", 300);
  set_skill("bawang-spear", 300);
  set_skill("spells", 300);
  set_skill("baguazhou", 300);
  set_skill("mace", 300);
  set_skill("jinglei-mace", 300);
  set_skill("hammer", 300);
  set_skill("wudi-hammer", 300);
  set_skill("archery",220);
  set_skill("chuanyang-arrow",220);
  set_skill("medical",300);
  set_skill("shachang-yishu",300);
  map_skill("medical","shachang-yishu");
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("axe", "sanban-axe");
  map_skill("parry", "sanban-axe");
  map_skill("dodge", "yanxing-steps");
  map_skill("spear", "bawang-spear");
  set("max_sen", 8000);
  set("max_kee", 8000);
  set("force", 1500);
  set("max_force", 2500);
  set("force_factor", 140);
  set("max_mana", 3000);
  set("mana", 3000);
  set("mana_factor", 150);
  set("inquiry", ([
    "name"    : "我是谁？我也不记得了。",
    "here"    : "这是一场梦。",
    "rumors"  : "消息？你不专心学艺，又来打听什么消息？",
    "回去"    : (: kick_back :),
    "return"  : (: kick_back :),
  ]) );
  create_family("将军府", 1, "蓝");
  setup();
  carry_object("/d/obj/weapon/axe/huafu")->wield();
  carry_object("/obj/cloth/zhanpao")->wear();
}

string kick_back()
{
  object me = this_player();
  message_vision(CYN"$n抬手朝$N的前额猛的一拍，喝声「去！」\n"NOR, me, this_object());
  message_vision(CYN"$N的身影渐渐淡去了．．．\n"NOR, me);
  me->move("/d/jjf/guest_bedroom");
  message_vision("$N突然惊醒坐起，原来是南柯一梦．．．\n", me);
  return "";
}

int accept_fight(object me)
{
  command("say 唉，年轻人，火气就是大。别动粗别动粗！");
  return 0;
}

int attempt_apprentice(object me)
{
  int effstr;
  string myrespect = RANK_D->query_respect(me);
  if (me != this_player(1))
    return 0;

  if (wizardp(me) && me->query("env/override"))
  {
    command("recruit "+me->query("id"));
    return 0;
  }

  if (! permit_recruit(me))
    return 0;

  if (me->query("family/master_id") != "cheng yaojin"
     || !me->query_temp("jjf/baifa_kar"))
  {
    command(sprintf("say 这。。。老夫素来不收无缘之人，%s还是回去吧。\n",myrespect));
    return 0;
  }

  if (me->query("level") <= 25)
  {
    command(sprintf("emote 皱了皱眉头，说道：%s还欠磨练，老夫所教恐怕不能理解。\n",
                  myrespect));
    return 0;

  }

  effstr = me->query_str();
  if (effstr < 150)
  {
    command(sprintf("say %s的臂力低了些，恐怕难有成就。\n",myrespect));
    return 0;
  }

  command("nod");
  command("say 看来"+myrespect+"与我有缘，老夫就收下你吧！\n");
  command("recruit " + me->query("id") );
  if ((string)me->query("class") != "fighter")
    me->set("class", "fighter");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname = RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "将军府")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非将军府人，老夫所教恐怕不能理解。\n",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "fighter")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s并非战将，老夫所教恐怕不能理解。\n",myname));
    return 1;
  }

  if (me->query("level") <= 32)
  {
    command(sprintf("emote 皱了皱眉头，说道：%s还欠磨练，老夫所教恐怕不能理解。\n",
                  myname));
    return 1;
  }

  if ((int)me->query("obstacle/number") < 34)
  {
    command("say 你尚未取经圆满，我还不能收你！\n");
    return 0;
  }

  if (skill == "mace"         ||
      skill == "jinglei-mace" ||
      skill == "spear"        ||
      skill == "bawang-spear" ||
      skill == "hammer"       ||
      skill == "wudi-hammer")
  {
    if (me->query_skill(skill,1) < 180)
    {
      command(sprintf("emote 皱了皱眉头，说道：%s这门技艺的级别太低了，"
                      "老夫所教恐怕不能理解。\n", myname));
      return 1;
    }

  }

  return 0;
}

