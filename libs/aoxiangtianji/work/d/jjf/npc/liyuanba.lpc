#include <ansi.h>
#include "jjf.h"
inherit NPC;
inherit F_MASTER;
string ask_me();
void create()
{
  set_name("李元霸", ({ "li yuanba", "li", "yuanba"}));
  set("title", "唐皇四弟");
  set("gender", "男性");
  set("age", 25);
  set("str", 30);
  set("per", 10);
  set("cor", 70);
  set("cps", 15);
  set("long","
李元霸是隋唐第一名的好汉，手中一对大锤打遍天下无敌手。
");
  set("combat_exp", 2200000);
  set("daoxing", 2200000);
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
     (: cast_spell, "zhanshen" :),
     (: perform_action, "hammer.jingtian" :),
  }) );
  set_skill("force", 250);
  set_skill("spells", 250);
  set_skill("dodge", 250);
  set_skill("unarmed", 250);
  set_skill("parry", 250);
  set_skill("hammer", 250);
  set_skill("lengquan-force", 250);
  set_skill("baguazhou", 250);
  set_skill("yanxing-steps", 250);
  set_skill("changquan", 250);
  set_skill("wudi-hammer", 250);

  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed", "changquan");
  map_skill("parry", "wudi-hammer");
  map_skill("hammer", "wudi-hammer");
  set_temp("apply/armor", 100);
  set_temp("apply/attack", 100);
  set("max_sen", 8000);
  set("max_kee", 8000);
  set("force", 8000);
  set("max_force", 5000);
  set("force_factor", 250);
  set("max_mana", 5000);
  set("mana", 8000);
  set("mana_factor", 250);
  set("no_cast",1);
  set("inquiry", ([
    "name"     : "你连我。。我。。。我都不知道吗？该。。。该打！",
    "拜师"     : (: ask_me :),
  ]) );
  create_family("将军府", 2, "蓝");
  setup();
  carry_object("/d/obj/weapon/hammer/bahammer")->wield();
  carry_object("/d/obj/armor/armor/tongjia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
}

string ask_me()
{
  command("haha");
  command("say 想要拜。。拜。。。拜师？我砸。。砸。。。砸你三。。三。。。三下不死，还可以考。。。虑考。。虑。\n");
  this_player(1)->add_temp("pending/jjf/lyb_hit", 1);
  return "你可愿意一试？(yuanyi)";
}

void init()
{
  ::init();
  add_action("do_agree", "yuanyi");
  add_action("do_agree", "agree");
}

int do_agree(string arg)
{
  object me, npc, ob;
  string myname, myrude;
  int my_max, my_kee;
  me = this_player(1);
  npc = this_object();
  if (!present(me, environment()))
    return 0;

  if (!me->query_temp("pending/jjf/lyb_hit"))
    return 0;
  if (npc->is_busy())
    return notify_fail("他正忙着呢！\n");

  if (npc->query_temp("no_move"))
    npc->delete_temp("no_move");

  myname = me->name();
  myrude = RANK_D->query_rude(me);
  my_max = me->query("max_kee");

  me->delete_temp("pending/jjf/lyb_hit");
  set("force", 2*query("max_force"));
  set("force_factor", 100);
  set_temp("apply/attack", 20);

  if (!(ob=query_temp("weapon"))
     || ob->query_temp("skill_type") != "hammer")
  {
   destruct(ob);
   ob=new("/d/obj/weapon/hammer/bahammer");
   ob->move(npc);
   command("wield hammer");
  }

  npc->set_temp("ignore_dis",1);
  command("say 哈哈，有胆子！");
  COMBAT_D->do_attack(npc, me, query_temp("weapon"));
  my_kee = me->query("kee");
  if(my_kee < 0
   || my_kee < my_max/3
   || !present(me, environment()))
  {
    command("say 嘿嘿，一家伙都。。都。。。都经不住！\n");
    return 1;
  }

  command("say 再。。再看这一。。一。。。一下！\n");
  COMBAT_D->do_attack(npc, me, query_temp("weapon"));

  my_kee = me->query("kee");
  if(my_kee < 0
   || my_kee < my_max/3
   || !present(me, environment()))
  {
    command("say 能经住我，，我，，，我一下子，已经不。。不。。。不容易了！\n");
    return 1;
  }

  command("say 最。。最。。。最后的一。。一下！\n");
  COMBAT_D->do_attack(npc, me, query_temp("weapon"));
  npc->delete_temp("ignore_dis");
  my_kee = me->query("kee");
  if(my_kee < 0
   || my_kee < my_max/3
   || !present(me, environment()))
  {
    command("say 哈哈，不。。不。。。不行了吧。。。\n");
    return 1;
  }

  me->set("family/can_bai/lyb", 1);
  set("force_factor", 250);
  set_temp("apply/attack", 100);
  command(sprintf("say %s果然是个强人。",myname));
  return 1;
}

int accept_fight(object me)
{
  command("say 想和我。。我。。。我动手吗？\n");
  return 0;
}

int attempt_apprentice(object me)
{
  int effstr;
  string myrude;
  if (me != this_player(1))
    return 0;

  if (! permit_recruit(me))
    return 0;
  if( (string)me->query("family/family_name") != "将军府")
  {
    command("say 我。。我。。。我只和将。。将军。。。军府的人说话！\n");
    return 0;
  }

  if (!me->query("family/can_bai/lyb"))
  {
    command("say 我。。我。。。收徒弟，可。。。可不简单！\n");
    return 0;
  }

  effstr = me->query_str();
  myrude = RANK_D->query_rude(me);
  if (effstr < 120)
  {
    command("say 你。。你连锤子都抗。。。抗不动，学。。。学个屁啊！\n");
    return 0;
  }

  if (me->query_cor() < 30)
  {
    command("say 胆小。。。小的，我看都。。。都不看！\n");
    return 0;
  }

  if (me->query("level") <= 28)
  {
    command("say 我怕。。怕。。。怕你丢我。。我的脸，太差。。差了！\n");
    return 0;
  }

  command("nod");
  command("say 好吧。\n");
  command("recruit " + me->query("id") );
  if ((string)me->query("class") != "fighter")
    me->set("class", "fighter");
  return 1;
}

int prevent_learn(object me, string skill)
{
  if( !me->is_apprentice_of(this_object()) )
    return 1;
  if (skill =="spells" || skill == "baguazhou")
  {
    command("say 我。。我。。。我不教这个！\n");
    return 1;
  }

  return 0;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我将军府的弟子！\n";

  if (me->query("class") != "fighter")
    return "你不是将士，问我何用？\n";

  switch (topic)
  {
    case "惊天一锤" :
    case "jingtian" :
      return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"    : "jingtian",
                "name"   : "惊天一锤",
                "sk1"     : "wudi-hammer",
                "lv1"     : 180,
                "sk2"     : "lengquan-force",
                "lv2"     : 180,
                "max_force" : 2500,
                "gongxian": 800,]));
      break;

  }

  return 0;
}

