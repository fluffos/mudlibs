#include <ansi.h>
#include "jjf.h"
inherit NPC;
inherit F_MASTER;
string gloat();
string ask_me();
void create()
{
  set_name("程咬金", ({ "cheng yaojin", "cheng", "yaojin", "master", "shifu" }));
  set("title", "开国元勋");
  set("gender", "男性");
  set("age", 45);
  set("str", 30);
  set("per", 10);
  set("cor", 70);
  set("cps", 15);
  set("long","
程咬金是大唐开国出名的福将，曾从梦中学来一套威猛无匹的
宣花三斧，后来又曾拜倒过一面大旗。谈起他的福气，真的是
人人羡慕。");
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("axe", 200);
  set_skill("lengquan-force", 200);
  set_skill("baguazhou", 200);
  set_skill("yanxing-steps", 200);
  set_skill("changquan", 200);
  set_skill("sanban-axe", 200);

  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed", "changquan");
  map_skill("parry", "sanban-axe");
  map_skill("axe", "sanban-axe");
  set_temp("apply/armor", 10);
  set("max_sen", 2800);
  set("max_kee", 2800);
  set("force", 2000);
  set("max_force", 1200);
  set("force_factor", 40);
  set("max_mana", 1200);
  set("mana", 2000);
  set("mana_factor", 60);
  set("no_cast",1);
  set("inquiry", ([
    "name"     : "我就是人称福将的程咬金！",
    "here"     : "这里是大唐国都长安府。",
    "rumors"   : "你看老程象是成天吃饱了撑的打听小道消息的么？",
    "福将"     : (: gloat :),
    "白发仙人" : "那白发仙人是我恩师，若想见他，需得有缘。",
    "有缘"     : (: ask_me :),
  ]) );
  create_family("将军府", 2, "蓝");
  setup();
  carry_object("/d/obj/weapon/axe/huafu")->wield();
  carry_object("/d/obj/armor/armor/tongjia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
}

string gloat()
{
  command("say 嘿嘿，提起这个可挠到老程的痒处了！");
  command("say 老程最得意的就是当年那白发仙人梦中传我斧法。。。");
  return "你要是想沾着点老程的福气，就应该拜我为师。";
}

string ask_me()
{
  command("hehe");
  command("say 何为有缘？你若是能接住老程三斧不死，就是有缘人。");
  this_player(1)->add_temp("pending/jjf/to_be_hit", 1);
  return "你可愿意一试？(yuanyi)";
}

void init()
{
  ::init();
  add_action("do_agree", "yuanyi");
  add_action("do_agree", "agree");
}

int do_agree(string arg)
{
  object me, npc, ob;
  string myname, myrude;
  int my_max, my_kee;
  me = this_player(1);
  npc = this_object();
  if (!present(me, environment()))
    return 0;

  if (!me->query_temp("pending/jjf/to_be_hit"))
    return 0;
  if (npc->is_busy())
    return notify_fail("他正忙着呢！\n");

  if (npc->query_temp("no_move"))
    npc->delete_temp("no_move");

  myname = me->name();
  myrude = RANK_D->query_rude(me);
  my_max = me->query("max_kee");

  me->delete_temp("pending/jjf/to_be_hit");
  set("force", 2*query("max_force"));
  set("force_factor", 100);
  if (!(ob=query_temp("weapon"))
     || ob->query_temp("skill_type") != "axe")
  {
   destruct(ob);
   ob=new("/d/obj/weapon/axe/huafu");
   ob->move(npc);
   command("wield axe");
  }

  npc->set_temp("ignore_dis",1);
  command("say 哈哈，有胆子！");
  COMBAT_D->do_attack(npc, me, query_temp("weapon"));
  my_kee = me->query("kee");
  if(my_kee < 0
   || my_kee < my_max/3
   || !present(me, environment()))
  {
    command(sprintf("say 嘿嘿，%s一家伙都经不住，还是回去多练两年吧！",myrude));
    return 1;
  }

  command("say 不错，有点意思，再看这一招！");
  COMBAT_D->do_attack(npc, me, query_temp("weapon"));

  my_kee = me->query("kee");
  if(my_kee < 0
   || my_kee < my_max/3
   || !present(me, environment()))
  {
    command(sprintf("say %s能经住我一下子已经不容易了，我早就看出来这第二下"
                    "子你受不了了！",myrude));
    return 1;
  }

  command("say 居然挺过了老程两家伙！");
  COMBAT_D->do_attack(npc, me, query_temp("weapon"));
  npc->delete_temp("ignore_dis");
  my_kee = me->query("kee");
  if(my_kee < 0
   || my_kee < my_max/3
   || !present(me, environment()))
  {
    command(sprintf("say 唉，%s的缘份比老程也就差了那么一丁点儿。",myrude));
    return 1;
  }

  me->add_temp("jjf/baifa_kar", 1);
  command(sprintf("say %s果然是有缘人。",myname));
  command("say 你去找我师父吧！别忘了他是自己来到我梦中的，这种机会是可遇而不可求。");
  return 1;
}

int accept_fight(object me)
{
  command("say 老夫久未和江湖人动手过招了，今日也不想破例。");
  return 0;
}

int attempt_apprentice(object me)
{
  int effstr;
  string myrude;
  if (me != this_player(1))
    return 0;

  if (! permit_recruit(me))
    return 0;
  if( (string)me->query("family/family_name") != "将军府")
  {
    command("say 我只收将军府的弟子！\n");
    return 0;
  }

  effstr = me->query_str();
  myrude = RANK_D->query_rude(me);
  if (effstr < 100)
  {
    command(sprintf("say %s这点劲连只蚂蚁都捏不死，还能抡斧头？",myrude));
    return 0;
  }

  if (me->query_cor() < 30)
  {
    command(sprintf("say %s见了血，还不得吓破了胆儿？不收！",myrude));
    return 0;
  }

  if (me->query("level") <= 25)
  {
    command(sprintf("say %s基本功夫太差了，先去练练！",myrude));
    return 0;
  }

  command("ah");
  command("say 想不到我老程这三脚猫本事也能收徒。\n");
  command("recruit " + me->query("id") );
  if ((string)me->query("class") != "fighter")
    me->set("class", "fighter");
  return 1;
}

int prevent_learn(object me, string skill)
{
  if( !me->is_apprentice_of(this_object()) )
    return 1;
  if (skill =="spells" || skill == "baguazhou")
  {
    command("say 老夫自己也搞不清楚怎么回事，哪里能教你呢？");
    return 1;
  }

  return 0;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我将军府的弟子！\n";

  if (me->query("class") != "fighter")
    return "你不是将士，问我何用？\n";

  switch (topic)
  {
    case "无敌三板斧" :
    case "三板斧" :
    case "sanban" :
      return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"    : "sanban",
                "name"   : "无敌三板斧",
                "sk1"     : "sanban-axe",
                "lv1"     : 150,
                "sk2"     : "lengquan-force",
                "lv2"     : 150,
                "max_force" : 2000,
                "gongxian": 300,]));
      break;
  }

  return 0;
}

