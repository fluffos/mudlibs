// xiaojie.c
inherit NPC;
void greeting(object ob);
void create()
{
  set_name("校尉", ({"xiao wei", "wei", "xiao"}));
  set("long","将军府的家将，看起来神气凛然．\n");
  set("gender", "男性");
  set("age", 28);
  set("attitude", "peaceful");
  set("per", 25);
  set("force", 800);
  set("max_force", 500);
  set("force_factor", 15);
  set("shen_type", 1);
  set("combat_exp", 30000+random(10000));
  set_skill("spear", 60);
  set_skill("parry", 60);
  set_skill("dodge", 60);
  set_skill("yanxing-steps", 60);
  set_skill("duo-spear", 60);
  map_skill("dodge", "yanxing-steps");
  map_skill("spear", "duo-spear");
  map_skill("parry", "duo-spear");
  setup();
  carry_object("/d/obj/weapon/spear/changqiang")->wield();
  carry_object("/obj/cloth/bingfu")->wear();
}

void init()
{
  object ob;
  ::init();
  if( playerp(ob = this_player()) &&
      !is_fighting() &&
      ob->query_temp("mark/jjf_mishi"))
    greeting(ob);
}

void greeting(object ob)
{
  if( !ob || environment(ob) != environment() ) return;

  if (ob->query_temp("mark/jjf_mishi"))
  {
    command("say 竟敢私闯禁地，杀无赦！\n");
    command("kill "+(string)(ob->query("id")));
  }

}