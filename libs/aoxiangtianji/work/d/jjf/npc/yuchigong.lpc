#include <ansi.h>
#include "jjf.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("尉迟恭", ({"yuchi gong", "yuchi", "gong", "yuchigong", "jingde", "yuchi jingde", "yuchijingde", "master", "shifu"}));
  set ("long", @LONG
尉迟恭，字敬德，乃是唐太宗手下猛将。排为隋唐时第
十二条好汉。起初他是反王刘武州殿前元帅，后因兵败
降唐。他惯使一条点钢枪，且喜使一对雌雄竹节钢鞭。
LONG);

  set("title", "开国元勋");
  set("gender", "男性");
  set("age", 43);
  set("str", 45);
  set("per", 15);
  set("int", 20);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 1800000);
  set("daoxing", 1800000);

  set_skill("literate", 120);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("spear", 150);
  set_skill("mace", 200);
  set_skill("lengquan-force", 200);
  set_skill("baguazhou", 200);
  set_skill("yanxing-steps", 200);
  set_skill("changquan", 200);
  set_skill("duo-spear", 150);
  set_skill("jinglei-mace", 200);

  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed", "changquan");
  map_skill("parry", "jinglei-mace");
  map_skill("spear", "duo-spear");
  map_skill("mace", "jinglei-mace");
  set("max_sen", 4000);
  set("max_kee", 4000);
  set("force", 5000);
  set("max_force", 2500);
  set("force_factor", 100);
  set("mana", 5000);
  set("max_mana", 2500);
  set("mana_factor", 100);

  create_family("将军府", 2, "蓝");
  setup();

  carry_object("/d/obj/weapon/mace/malemace")->wield();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
}

int accept_fight(object me)
{
  command("say 老夫手重，若是伤人反而不美了。\n");
  return 0;
}

int attempt_apprentice(object me)
{
  string myname;
  int kar;
  int effstr;

  if (me != this_player(1))
    return 0;

  myname = RANK_D->query_rude(me);

  if (! permit_recruit(me))
    return 0;
  if( (string)me->query("family/family_name") != "将军府")
  {
    command("say 我只收将军府的弟子！\n");
    return 0;
  }

  if ((int)me->query("level")<= 25)
  {
    command(sprintf("say 这位%s还是先去跟本府家将打打基础吧！",myname));
    return 0;
  }

  kar = me->query_kar();
  effstr = me->query_str();
  if ((effstr< 100) || (int)me->query_con() < 30)
  {
    command(sprintf("say 这%s手无缚鸡之力，不配作我徒弟！\n",myname));
    return 0;
  }

  if (me->query_cps() < 60 && me->query_cor() < 25)
  {
    command(sprintf("say 这%s胆子还不如只老鼠！\n",myname));
    return 0;
  }

  command("say 要想拜我为师，倒也不难。只需将那醉星楼拆了就行！\n");
  me->set("pending/jjf_bai_yuchi", 1);
  return 1;
}

int accept_object(object me, object ob)
{
  string myname, thing;
  object book, npc;
  int kar=me->query_kar(), diff;

  myname = RANK_D->query_rude(me);
  thing=(string)ob->query("id");
  npc = this_object();

  if ((string)ob->query("name_recognized") != "醉星楼柱子")
  {
    command ("say 这是什么破烂？");
    call_out("dropthing", 1, thing);
    return 1;
  }

  if (me->query("pending/jjf_bai_yuchi"))
  {
    command ("nod");
    command (sprintf("say %s果然有两下子，老夫就收下你吧！",myname));
    me->delete("pending/jjf_bai_yuchi");
    command ("recruit " + me->query("id") );
    call_out("destroy", 1, ob);
    return 1;
  }

  else
  {
    call_out("destroy", 1, ob);
    if (ob->query("owner_id") != me->query("id"))
    {
      command("hehe");
      command("say 这截柱子恐怕是你捡来的吧？");
      command("say 就凭你这点本事，也砸的了醉星楼？");
      return 1;
    }

    command ("thumb" +me->query("id"));
    command ("say "+myname+"果然有两下子！");
    diff = 38-kar;
    if (diff < 1)
      diff = 1 ;
    if(random(diff*diff) > random(10))
      return 1;

    command("say 看来"+myname+"跟老夫有缘，而且又帮我出了一口恶气。");
    command("say 这本跟随老夫多年的拆招秘诀就送给你吧！");
    book=new("/d/obj/book/parrybook2");
    message_vision(npc->query("name") + "给$N一本"+book->query("name"), me);
    book->move(me);
    book->set("owner",me->query("id"));
    return 1;
  }

}

int recruit_apprentice(object ob)
{
  if( ::recruit_apprentice(ob) )
    if ((string)ob->query("class") != "fighter")
      ob->set("class", "fighter");
}

void destroy(object ob)
{
  destruct(ob);
  return;
}

void dropthing(string thing)
{
  command("drop "+thing);
  return;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我将军府的弟子！\n";

  if (me->query("class") != "fighter")
    return "你不是将士，问我何用？\n";

  switch (topic)
  {
    case "雷殛怒火" :
    case "lei" :
      return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"    : "lei",
                "name"   : "雷殛怒火",
                "sk1"     : "jinglei-mace",
                "lv1"     : 180,
                "sk2"     : "lengquan-force",
                "lv2"     : 180,
                "max_force" : 2500,
                "gongxian": 800,]));
      break;
  }

  return 0;
}

