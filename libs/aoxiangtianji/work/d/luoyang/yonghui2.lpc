inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "永徽道");
  set("long", @LONG
街道两旁栽植松柏，到处是张灯结彩。大街两旁排列着许多店
铺。临街店铺里经营着汴绣、字画、陶瓷、古董、名酒、小吃
等，热闹非凡。北边是一所私塾。
LONG);
  set("outdoors", "luoyang");
  set("no_clean_up", 0);
  set("exits", ([
    "east" : __DIR__"yonghui3",
    "north" : __DIR__"sishu",
    "west" : __DIR__"yonghui1",
  ]));
  set("objects", ([
    sprintf("/obj/npc/boy%d", 1+random(3)) : 1,
    sprintf("/obj/npc/old%d", 1+random(2)) : 1,
  ]));
  setup();
}

