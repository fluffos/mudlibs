inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "洛阳中心广场");
  set("long", @LONG
你脚下站的就是赫赫有名的古都洛阳，一条条宽敞明净的大道，熙熙攘攘
的人群，热闹的集市，充分展示了这座最古老的城市的生机。街上满是来
这里观光游览的游客，想必吸引他们的是大名鼎鼎的洛阳唐三彩和中国第
一古刹白马寺吧！当然建在这里的洛阳行宫也是许多别处的官员常来膜拜
的地方。广场上好像刚刚下过雨，空气很清新，地上湿漉漉的，整个广场
给人的感觉就是古老而赋有生机，就像是这座古城的一个缩影。
LONG);
  set("outdoors", "luoyang");
  set("no_clean_up", 0);
  set("exits", ([
    "east"  : __DIR__"yonghui1",
    "north" : __DIR__"cunxi1",
    "south" : __DIR__"jingyun1",
    "west"  : __DIR__"wude1",
  ]));
  set("objects", ([
    "/d/luoyang/npc/seller" : 1,
    "/obj/npc/jianke" : 1,
    "/obj/npc/haoke" : 1,
    "/obj/npc/xunbu" : 1,
    "/obj/npc/maiyi2" : 1,
    sprintf("/obj/npc/girl%d", 1+random(4)) : 1,
    sprintf("/obj/npc/old%d", 1+random(2)) : 1,
    "/obj/npc/walker" : 1,
  ]));

  setup();
}

