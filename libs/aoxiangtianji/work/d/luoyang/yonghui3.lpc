inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "永徽道");
  set("long", @LONG
街道两旁栽植松柏，到处是张灯结彩。大街两旁排列着许多店铺。临街店
铺里经营着汴绣、字画、陶瓷、古董、名酒、小吃等，热闹非凡。北边是
一家瓷器店，南边是一个替人照看孩子的地方，叫育婴堂。
LONG);
  set("exits", ([
    "east" : __DIR__"yonghui4",
    "north" : __DIR__"ciqi",
    "south" : __DIR__"yuying",
    "west" : __DIR__"yonghui2",
  ]));
