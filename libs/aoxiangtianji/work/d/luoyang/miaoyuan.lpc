#include <ansi.h>
inherit SMALLROOM;
inherit WOODROOM;
inherit SAFTYROOM;
#define MAX_DX 50000
#define MAX_POT 25000
void create()
{
  set("short", "苗园");
  set("long", @LONG
这里是苗铺主人用来养花的花棚，一个大大的温室，将各种样的奇花
异草呵护在其中，当然花丛中更多的是牡丹，只见那牡丹红的，白的，黑
的，紫的，黄的，各色各样，争奇斗艳，娇艳欲滴，不愧和白马寺一起成
为了洛阳的象征。你也可以在这里种花。
LONG);
  set("outdoors", "luoyang");
  set("no_clean_up", 0);
  set("exits", ([
    "west" : __DIR__"miaopu",
  ]));
  setup();
}

void init()
{
  add_action("do_jiaoshui", "jiaoshui");
  add_action("do_peiyu", "peiyu");
}

int do_peiyu()
{
  object hz, me;
  me = this_player();
  hz = present("hua zhong",me);
  if (!objectp(hz) )
  {
    tell_object(me, "你种子都没有，还想种花？\n");
    return 1;
  }

  if (me->query_temp("jiaoshui") == 1)
  {
    tell_object(me, "你已经完成了培育这道程序，现在可以浇水"
                HIY "(jiaoshui)" NOR "。\n");
    return 1;
  }

  if (me->query("daoxing") < 1000)
  {
    tell_object(me, "你的经验尚浅，还是先到处多走动走动吧。\n");
    return 1;
  }

  if (me->query("daoxing") > 50000)
  {
    tell_object(me, "以你的身份大概不适合种花了吧。\n");
    return 1;
  }

  if (me->query("sen") < 70)
  {
    tell_object(me, "你已经很疲惫了，休息一下再接着种吧。\n");
    return 1;
  }

  message_vision(HIC "$N" HIC "把土坑周围好好地修整了一下，使土壤更加"
                     "适合花的生长。\n" NOR, me);
  me->set_temp("peiyu", 1);
  me->set_temp("jiaoshui", 1);
  me->start_busy(1 + random(3));
  return 1;
}

int do_jiaoshui()
{
  object me, ob;
  int exp, pot;
  me = this_player();
  if (me->query("sen") < 70)
  {
    tell_object(me, "你已经很疲惫了，休息一下再接着种吧。\n");
    return 1;
  }

  if (me->is_busy())
  {
    tell_object(me, "你正忙着呢，别着急。\n");
    return 1;
  }

  if (! me->query_temp("peiyu") == 1)
  {
    tell_object(me, "你没事干浇什么水啊！\n");
    return 1;
  }

  if (me->query_temp("peiyu") == 2)
  {
    exp = 0;
    pot = 0;

    if (random(14) < 5)
    {
      if (random(15) == 1)
      {
        if (random(1000) < 5)
        {
          ob = new("/d/obj/flower/hua4");
          message_vision(HIY "$N" HIY "种出了一朵翡翠兰。\n"NOR, me);
          ob->move(me, 1);
          me->delete_temp("jiaoshui");
          me->delete_temp("zhonghua");
          me->delete_temp("peiyu");
          exp = 2000 + random(5000);
          pot = exp/2;
        }

        else
        {
          ob = new("/d/obj/flower/hua2");
          message_vision(HIY "$N" HIY "种出了一朵无名花。\n" NOR,me);
          ob->move(me,1);
          exp = 300 +random(600);
          pot = exp/2;
        }

      }
      else
      {
        switch (random(5))
        {
          case 1 :
            ob = new("/d/city/obj/flower/hmeigui");
            break;
          case 2 :
            ob = new("/d/city/obj/flower/zi-luolan");
            break;
          case 3 :
            ob = new("/d/city/obj/flower/bai-chahua");
            break;
          case 4 :
            ob = new("/d/city/obj/flower/huang-meigui");
            break;
          default :
            ob = new("/d/city/obj/flower/lan-tiane");
            break;
        }

        if (objectp(ob))
        {
        message_vision(HIC "$N" HIC "十分小心的给小坑里浇了一些"
                           "水，突然一朵" + ob->query("name") + HIC
                           "从坑里冒了出来。\n" NOR, me);
        message_vision(HIY "$N" HIY "把它摘了下来，拿在手里。\n" NOR, me);
        ob->move(me, 1);
        }

        me->delete_temp("jiaoshui");
        me->delete_temp("peiyu");
        me->delete_temp("zhonghua");
        exp = 50 + random(100);
        pot = exp/2;
      }

      me->add("balance",pot/2 + random(pot));
      if ((int)me->query("work/newbie_zh/dx") > MAX_DX)
        exp = 0;
      if ((int)me->query("work/newbie_zh/pot") > MAX_POT)
        pot = 0;
      GIFT_D->delay_work_bonus(me,([ "daoxing" : exp,
                                     "pot"     : pot,
                                     "prompt" : "通过这次种花的经历",
                                   ]),"newbie_zh");
      me->add("sen", -20);

      return 1;
    }

    message_vision(HIR "$N" HIR "笨手笨脚的拿起水壶给小坑里浇水，结"
                                "果水洒的太多把花给毁了。\n", me);
    me->delete_temp("jiaoshui");
    me->delete_temp("zhonghua");
    me->delete_temp("peiyu");
    me->add("sen", -50);
    me->add("daoxing", 3);
    me->add("potential", 1+random(2));
    me->add("balance",1 + random(5));
    return 1;
  }

  if (me->query_temp("jiaoshui") == 1)
  {
    message_vision(HIC "$N" HIC "拿起水壶给小坑浇了一些水。\n" NOR, me);
    me->add("sen", -70);
    me->set_temp("peiyu", 2);
    me->start_busy(1 + random(2));
    return 1;
  }

}

