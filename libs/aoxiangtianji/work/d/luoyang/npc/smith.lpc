#include <ansi.h>
inherit "/std/char/smith.lpc";
void create()
{
  set_name("铁匠", ({ "tiejiang", "smith" }));
  set("title", "打铁铺老板");
  set("shen_type", 1);
  set("gender", "男性" );
  set("age", 33);
  set("long", "铁匠正用铁钳夹住一块红热的铁块放进炉中。\n");
  set("combat_exp", 400);
  set("attitude", "friendly");
  set("vendor_goods",([
   "1" :  "/d/obj/weapon/sword/changjian",
   "2" :  "/d/obj/weapon/hammer/hammer",
   "3" :  "/d/obj/weapon/blade/tudao",
   "4" :  "/d/obj/weapon/dagger/dagger",
   "5" :  "/d/obj/weapon/stick/tiegun",
   "6" :  "/d/obj/weapon/blade/gangdao",
   "7" :  "/d/obj/armor/armor/tiejia",
   "8" :  "/d/obj/weapon/archery/arrow",
   "9" :  "/d/obj/weapon/archery/wolfarrow",
   "10" :  "/d/obj/weapon/bow/bow",
   "11" :  "/d/obj/weapon/bow/longbow",
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

