inherit F_VENDOR_SALE;
void create()
{
  reload("ly_xiao");
  set_name("萧南忠", ({ "xiao nanzhong", "xiao", "nanzhong" }));
  set("title", "杂货铺老板");
  set("shen_type", 1);
  set("gender", "男性");
  set("age", 45);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/damage", 15);
  set("combat_exp", 40000);
  set("attitude", "friendly");
  set("vendor_goods", ([
    "1": "/d/obj/food/cutan",
    "2": "/d/obj/misc/depositbox",
    "3": "/d/obj/misc/bag",
    "4": "/d/obj/misc/qingsi-lou",
    "5": "/d/obj/misc/paper_seal",
    "6": "/d/qujing/huangfeng/obj/tables",
    "7" : "/d/obj/misc/candle1",
    "8" : "/d/obj/misc/denglong",
    "9" : "/d/obj/misc/fire",
  ]) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  object ob;
  ::init();
  if( interactive(ob = this_player()) && !is_fighting() )
  {
    remove_call_out("greeting");
    call_out("greeting",1,ob);
  }

  add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
  if( !ob || !visible(ob) || environment(ob) != environment() ) return;
  switch( random(1) )
  {
    case 0:
      say( name()+"说道：这位" + RANK_D->query_respect(ob)
                 + "，要买些什么东西？\n");
      break;
  }

}

