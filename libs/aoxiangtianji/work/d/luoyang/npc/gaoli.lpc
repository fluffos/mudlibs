// gaoli.c
inherit NPC;
inherit F_VENDOR;
void create()
{
  set_name("高丽商", ({ "gaoli shang", "shang" }));
  set("title", "新罗坊老板");
  set("shen_type", 1);
  set("gender", "男性");
  set("age", 45);
  set("long",
"这是个高丽商人，长得和中国人没啥区别。连卖的东西也差不多。\n");
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/damage", 15);
  set("combat_exp", 40000);
  set("attitude", "friendly");
  set("vendor_goods", ([
     "1" : "/d/obj/misc/mabudai",
     "2" : "/obj/cloth/beixin",
     "3" : "/d/obj/armor/head/toukui",
     "4" : "/d/obj/armor/neck/cycle",
     "5" : "/d/obj/armor/surcoat/surcoat",
     "6" : "/d/obj/armor/shield/shield",
     "7" : "/d/obj/armor/wrists/huwan",
     "8" : "/d/obj/armor/hands/zhitao",
     "9" : "/d/obj/armor/waist/huyao",
     "10" : "/d/obj/armor/shoes/caoxie",
     "11" : "/d/obj/armor/shoes/pixue",
     "12" : "/d/obj/armor/hands/shoutao",
     "13" : "/d/obj/armor/armor/jinsijia",
  ]));

  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  add_action("do_vendor_list", "list");
}

