// seller.c
inherit "/obj/npc/xiaofan";
void create()
{
  set_name("洛阳小贩", ({ "luoyang xiao fan","seller" }) );
  set("gender", "男性" );
  set("age", 32);
  set("vendor_goods", ([
    "1" : "/d/luoyang/obj/armor1",
    "2" : "/d/luoyang/obj/head1",
    "3" : "/d/luoyang/obj/wanlun1",
    "4" : "/d/luoyang/obj/sword1",
    "5" : "/d/luoyang/obj/blade1",
  ]));
  set("chat_chance", 20);
  set("chat_msg", ({
      (:random_move:),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 10);
  if (clonep())
    keep_heart_beat();
}

