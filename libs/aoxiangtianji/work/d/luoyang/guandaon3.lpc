inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "大官道");
  set("long", @LONG
这是一条宽阔笔直，尘土飞扬的大官道，足可容得下十马并驰。南边
是东都洛阳古城，往东北方向直上可以到达北平府。
LONG);
  set("outdoors", "luoyang");
  set("no_clean_up", 0);
  set("exits", ([
    "northeast" : __DIR__"guandaon4",
    "southwest" : __DIR__"guandaon2",
  ]));
  setup();
}

