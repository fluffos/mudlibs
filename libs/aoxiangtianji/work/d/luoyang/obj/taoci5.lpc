#include <ansi.h>
inherit ITEM;
string *prefixs = ({
  HIC"翡翠"NOR,
  HIW"碧玉"NOR,
  HIR"淡朱"NOR,
  HIC"八宝"NOR,
  HIC"玲珑"NOR,
  HIW"白瓷"NOR,
  WHT"七窍"NOR,
  HIB"碧海"NOR,
});
void create()
{
  set_name(element_of(prefixs) + "飞天佩", ({ "feitian pei", "feitian", "pei"}) );
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "只");
    set("long", HIC "经唐三彩烧制的飞天佩，非常的昂贵。\n" NOR);
    set("value", 1500);
  }

}

