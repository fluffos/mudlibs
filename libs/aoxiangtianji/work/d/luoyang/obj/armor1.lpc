#include <ansi.h>
#include <armor.h>
inherit ARMOR;
void create()
{
  set_name(HIY "金环锁子甲" NOR, ({ "suozi jia", "jia"}) );
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("value", 150000);
    set("material", "gold");
    set("armor_prop/armor", 80);
  }

  setup();
}