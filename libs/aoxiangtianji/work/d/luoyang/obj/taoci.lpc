#include <ansi.h>
inherit ITEM;
string *prefixs = ({
  HIC"翡翠"NOR,
  HIW"碧玉"NOR,
  HIR"淡朱"NOR,
  HIC"八宝"NOR,
  HIC"玲珑"NOR,
  HIW"白瓷"NOR,
  WHT"七窍"NOR,
  HIB"碧海"NOR,
});
void create()
{
  set_name(element_of(prefixs)+"鼻烟壶", ({ "biyan hu", "biyan", "biyan"}) );
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "只");
    set("long", HIC "陶瓷所制的鼻烟壶。\n" NOR);
    set("value", 1500);
  }

}

