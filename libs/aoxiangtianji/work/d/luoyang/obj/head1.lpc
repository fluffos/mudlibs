#include <ansi.h>
#include <armor.h>
inherit HEAD;
void create()
{
  set_name(HIY "琉金盔" NOR, ({ "liujin kui", "kui"}) );
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "个");
    set("value", 120000);
    set("material", "leather");
    set("armor_prop/armor", 40);
  }

  setup();
}