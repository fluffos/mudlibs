#include <ansi.h>
inherit KEDIAN;
void create()
{
  ::create();
  set("short", "白马客栈");
  set("long", @LONG
这是洛阳城里最大的一家客栈，紧靠洛阳中心，以洛阳的名胜白马寺
来命名，曰“白马客栈”，由于价格公道，因此到这里来借宿的客人川流
息，络绎不绝，生意及其兴隆，大堂内摆了七八张桌子，店小二跑来跑去
接待着从四面八方来的客人。二楼上是雅厅，客栈后面是马厩。
LONG);
  set("exits", ([
    "east" : __DIR__"majiu",
    "up" : __DIR__"kezhan2",
    "west" : __DIR__"jingyun1",
  ]));
  set("price", 500);
  set("kick_dir", __DIR__"jingyun1");
  set("objects", ([
    "/obj/npc/xiaoer" : 1,
  ]));
  setup();
}

int valid_leave(object me, string dir)
{
  if (! me->query_temp("rent_paid") && dir == "up" )
    return notify_fail(CYN "店小二一下挡在楼梯前，白眼一翻：怎麽着，想白住啊！\n" NOR);
  return ::valid_leave(me, dir);
}

