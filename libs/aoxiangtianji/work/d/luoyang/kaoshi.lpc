inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "科举试场");
  set("long", @LONG
洛阳的科举试场是天下最热闹的一所考场，每月初一，全国各地的士
子都来此处赶考。院门两边由士兵看守，要想夹带可不行，围墙上有张新
贴的告示。
LONG);
  set("objects", ([
     "/d/luoyang/npc/zhukao" : 1,
     sprintf("/obj/npc/shusheng%d", 1+random(3)) : 2,
  ]));

  set("outdoors", "luoyang");
  set("no_clean_up", 0);
  set("exits", ([
     "east" : __DIR__"cunxi3",
  ]));
  setup();
}

