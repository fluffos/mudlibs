inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "永徽道");
  set("long", @LONG
街道两旁栽植松柏，到处是张灯结彩。大街两旁排列着许多店铺。临街店
铺里经营着汴绣、字画、陶瓷、古董、名酒、小吃等，热闹非凡。北边是
庙会所在，非常的热闹，人山人海，人声鼎沸，在里面可以找到你所想要
的东西，南边是一家胭脂店，有不少年轻女子前来光顾。
LONG);
  set("exits", ([
    "east" : __DIR__"yonghui5",
    "north" : __DIR__"miaohui",
    "south" : __DIR__"jinyin",
    "west" : __DIR__"yonghui3",
  ]));
  set("objects", ([
    sprintf("/obj/npc/girl%d", 1+random(4)) : 1,
    sprintf("/obj/npc/girl%d", 1+random(4)) : 1,
  ]));
  set("outdoors", "luoyang");
  set("no_clean_up", 0);
  setup();
}

