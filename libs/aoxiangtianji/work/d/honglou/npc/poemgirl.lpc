inherit NPC;
#include <ansi.h>
int send_back(object me);
void create()
{
  set_name("探春", ({ "tan chun", "chun", "girl" }) );
  set("gender", "女性" );
  set("age", 16);
  set("combat_exp", 200000);
  set("attitude", "friendly");
  set_skill("literate", 100);
  set_skill("dodge", 100);
  set("chat_chance", 3);
  set("chat_msg", ({
     "探春说道：你说天下真有那无名之花吗？\n",
     "探春说道：无名花，无名花，真是难得啊！\n",
  }) );
  setup();
  carry_object("/obj/cloth/pinkskirt")->wear();
  carry_object("/obj/cloth/female-shoe")->wear();
}

int accept_object(object who,object ob)
{
  object m;
  if (ob->query("id")=="wuming hua")
  {
    say("探春笑道：多谢"  + RANK_D->query_respect(who) + "，我真的好喜欢呦！\n");
    command("whisper " + who->query("id") + " 我这里有本书，你拿去看吧！\n");
    m=new("/d/obj/book/forcebook2");
    m->move(who,1);
    m->set("owner",who->query("id"));
    destruct(ob);
    return 1;
  }

  return 0;
}

