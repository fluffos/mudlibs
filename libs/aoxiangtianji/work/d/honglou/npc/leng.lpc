inherit F_VENDOR_SALE;
void create()
{
  reload("honglou_leng");
  set_name("冷子兴", ({"leng zixing","leng","zixing"}));
  set("title", "古董商");
  set("gender", "男性");
  set("combat_exp", 10000);
  set("age", 46);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set("vendor_goods", ([
      "1": "/d/obj/misc/camera",
      "2": "/d/obj/misc/mallet",
      "3": "/d/obj/misc/buwawa",
      "4": "/d/obj/misc/pillow",
    ]) );
  setup();
  carry_object("/obj/cloth/choupao")->wear();
  add_money("silver", 1);
}

void init()
{
  object ob;
  ::init();
  if( interactive(ob = this_player()) && !is_fighting() )
  {
    remove_call_out("greeting");
    call_out("greeting", 3, ob);
  }

  add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
  command ("hmm");
}