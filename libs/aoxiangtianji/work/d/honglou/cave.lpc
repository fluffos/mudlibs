inherit SMALLROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "蓼汀花溆");
  set ("long", @LONG
    水声潺潺泻出，石洞上则萝薜倒垂，下则落花浮荡。
LONG);
  set("exits", ([
    "up" : __DIR__"none.lpc",
    "north" : "/adm/npc/yard2",
    "south" : __DIR__"village",
  ]));

  set("objects", ([
     "/d/obj/flower/seed":1,
  ]));
  setup();
}

