inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "山洞");
  set("long", @LONG

黑乎乎的小山洞，又潮湿，又气闷。微弱的光线下，
可以看到边上有挖开的坑。看来，这里曾经有人来
过，寻找(search)某种宝物。
LONG );
  set("exits", ([
    "up"  : __DIR__"hill3",
  ]));
  set("baowu",1);
  setup();
}

void reset()
{
  ::reset();
  if (!query("baowu") &&
      time() - (int)query("last_baowu") > 3600)
  {
    delete("last_baowu");
    set("baowu",1);
  }

}

void init()
{
  add_action("do_search",({"search","xunzhao"}));
}

int do_search(string arg)
{
  int num;
  object weapon,snake, baowu;
  object who = this_player();
  if (who->is_busy() || who->is_fighting())
  {
    write("你正忙着呢！\n");
    return 1;
  }

  weapon = who->query_temp("weapon");
  if (!objectp(weapon))
  {
    write("你手中没有兵器，这坚硬的冻土可无法挖掘！\n");
    return 1;
  }

  if(who->query_skill("force",1) < 200
     && (string)weapon->query("skill_type")!="sword"
     && (string)weapon->query("skill_type")!="blade")
  {
    write("你的内力不够深厚，应该找把剑，或是刀什么的。\n");
    return 1;
  }

  num = who->query_temp("search_time");
  if (!num)
  {
    message_vision("$N走到坑边，挖了起来！\n",who);
    who->set_temp("search_time",1);
    who->start_busy(2+random(3));
    seteuid(getuid());
    snake = new("/obj/beast/bingshe");
    snake->move(this_object());
    message_vision("$N正埋头挖掘的时候，突然窜出了一条浑身雪白的怪蛇来！\n",who);
    snake->kill_ob(who);
    return 1;
  }

  who->add_temp("search_time",1);
  message_vision("$N在坑边继续用力挖掘！\n",who);
  if (random(num + 1) < 3)
  {
    tell_object(who,"你没有发现任何东西！只是不甘心就此罢手！\n");
    message_vision("看起来$N一无所获！\n",who);
    who->add_temp("search_time",1);
    who->start_busy(2+random(3));
    return 1;
  }

  if (query("baowu"))
  {
    message_vision("突然一声惊呼，$N发现了一个乌黑发亮的矿石！\n",who);
    message_vision("$N赶紧把矿石拣了起来，看来此行不虚啊！\n",who);
    seteuid(getuid());
    baowu = new("/d/item/obj/wujins");
    baowu->move(who,1);
    baowu->set("owner",who->query("id"));
    set("baowu",0);
    set("last_baowu",time());
    remove_call_out("regen");
    call_out("regen",3600);
  }

  else
    message_vision("$N擦了擦汗，叹了口气，看来今天是要一无所获了！\n",who);

  who->delete_temp("search_time");
  who->start_busy(3+random(3));
  return 1;
}

void reget()
{
  set("baowu",1);
}

