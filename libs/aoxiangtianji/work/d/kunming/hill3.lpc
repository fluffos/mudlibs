inherit BIGROOM;
inherit HILLROOM;
void create()
{
  set("short", "山路");
  set("long", @LONG

下了那片山坡，一片杂草丛生，一些不知名的小虫小兽不时
窜出来，眼见有陌生人来，有快速的逃入杂草中。右边的一
堆杂草(cao)似乎惹人生疑。
LONG);
  set("outdoors", "dali");
  set("exits", ([
    "north"   : __DIR__"hill2",
  ]));
  set("item_desc", ([
     "cao" : "一堆乱七八糟的杂草，堆放在这里，颇惹人生疑。\n"
              "如果仔细去查看，也许会有所发现的！\n\n",
     ]) );
  setup();
}

void init()
{
  add_action("do_search",({"search","xunzhao","xunzao"}));
}

int do_search(string arg)
{
  int num;
  object mangshe;
  object who = this_player();
  if (who->is_busy() || who->is_fighting())
  {
    write("你正忙着呢！\n");
    return 1;
  }

  if (!arg || arg != "cao")
  {
    write("你要找什么？\n");
    return 1;
  }

  if (who->query_temp("is_riding"))
  {
    write("你还是先下了坐骑吧！\n");
    return 1;
  }

  num = who->query_temp("search_time");
  if (!num)
  {
    message_vision("$N走到了杂草边上，双手分开杂草，可惜什么都没有！\n",who);
    who->set_temp("search_time",1);
    who->start_busy(2+random(3));
    mangshe = present("mang she", this_object());
    if (!objectp(mangshe))
    {
      message_vision("突然杂草一阵的乱动，一条可怕的蟒蛇直窜了出来，恶狠狠的盯着$N！\n",who);
      mangshe = new("/obj/beast/mangshe");
      mangshe->move(this_object());
      mangshe->kill_ob(who);
    }

    return 1;
  }

  if (who->query_skill("force",1) < 200)
  {
    message_vision("$N呆呆的站立在那里，显然被刚才的蟒蛇给吓坏了！\n",who);
    message_vision("$N叹了口气，觉得自己内功等级不够，看来继续下去风险不小，只能罢手了！\n",who);
    who->delete_temp("search_time",1);
    who->start_busy(2+random(3));
    return 1;
  }

  message_vision("$N很不甘心就此罢手，双手抓住杂草，用力的乱扯！\n",who);
  if (random(num + 1) < 10)
  {
    tell_object(who,"你没有发现任何东西！只是不甘心就此罢手！\n");
    message_vision("看起来$N一无所获！\n",who);
    who->add_temp("search_time",1);
    who->start_busy(2+random(3));
    return 1;
  }

  message_vision("突然一声惊呼，$N一把把杂草扯了起来，一个黑乎乎的山洞显露了出来！\n",who);
  message_vision("$N猝不及防，一个跟斗竟掉了进去！\n",who);
  who->move("/d/kunming/wujin-dong");
  if (who->query_skill("dodge",1) < 200)
  {
    who->receive_damage("kee",who->query("max_kee")/2);
    who->receive_wound("kee",who->query("max_kee")/2);
  }

  message_vision("$N从上面直掉了进来，摔了个昏头昏脑，傻呆呆！\n",who);
  who->start_busy(3+random(3));
  return 1;
}

