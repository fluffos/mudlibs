// seller.c
inherit "/obj/npc/xiaofan";
void create()
{
  set_name("昆明小贩", ({ "kunming xiao fan","seller" }) );
  set("gender", "男性" );
  set("age", 32);
  set("vendor_goods", ([
     "1" : "/d/kunming/obj/huoqiang",
     "2" : "/d/kunming/obj/niurou",
     "3" : "/d/kunming/obj/wan",
     "4" : "/d/kunming/obj/yan",
     "5" : "/d/kunming/obj/yantong",
  ]));
  set("chat_chance", 20);
  set("chat_msg", ({
      (:random_move:),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 10);
  if (clonep())
    keep_heart_beat();
}

