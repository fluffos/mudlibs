inherit BIGROOM;
inherit WATERROOM;
void create ()
{
  set ("short", "海底");
  set ("long", @LONG
到了一个水中世界。迎面走来了两个海底夜叉，虎视眈眈的看
着你。周围的海草轻柔的舞动，不知名的小鱼自由的戏耍。
LONG);
  set("objects", ([
    "/d/eastsea/npc/yecha" : 2,
  ]));

  set("exits", ([
    "up"    : "/d/hangzhou/eroad7",
    "south" : __DIR__"under2",
  ]));
  setup();
}

int valid_leave(object me,string dir)
{
  object yecha = present("ye cha",this_object());

  if(dir == "south" && (string)me->query("family/family_name")!="东海龙宫")
    if (objectp(yecha) && living(yecha))
      return notify_fail("夜叉大喝了一声，这里是南海龙宫所在，闲人请速速离开！\n");
  return ::valid_leave(me,dir);
}