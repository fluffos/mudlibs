inherit BIGROOM;
inherit WATERROOM;
void create ()
{
  set ("short", "水晶宫殿");
  set ("long", @LONG
轻轻的走上了白玉台阶，来到了水晶宫下。正中晶莹透明的水晶
制成的牌匾上，朱红的“水晶宫殿”显得多人眼目。宫殿飞檐层层叠叠。
大门金光闪闪，布满金色门钉。门前地面白玉铺满，两边走廊集玉堆翠，
虾兵蟹将来来回回，警惕的看着周围。
LONG);

  set("exits", ([
    "enter" : __DIR__"qiandian1",
    "north" : __DIR__"xiaolu3",
  ]));
  set("objects", ([
    "/d/eastsea/npc/yecha" : 2,
    "/d/eastsea/npc/lishi" : 2,
  ]));

  setup();
}

int valid_leave(object me,string dir)
{
  object yecha = present("ye cha",this_object());
  object lishi = present("li shi",this_object());

  if(dir == "enter" && (string)me->query("family/family_name")!="东海龙宫")
  {
    if (objectp(yecha) && living(yecha))
      return notify_fail("夜叉大喝了一声，这里是南海龙宫所在，闲人请速速离开！\n");
    if (objectp(lishi) && living(lishi))
      return notify_fail("力士大喝了一声，这里是南海龙宫所在，闲人请速速离开！\n");
  }

  return ::valid_leave(me,dir);
}