inherit BIGROOM;
inherit WATERROOM;
void create ()
{
  set ("short", "前殿");
  set ("long", @LONG
宽阔的前殿前端，是白玉砌成的台阶，一级级通往龙王大殿。
东面是条甬道，通往南海龙太子的住处。而西面这是弯弯曲曲的
回廊，似乎通往后花园。
LONG);

  set("exits", ([
    "north" : __DIR__"qiandian1",
    "south" : __DIR__"yujie1",
    "east"  : __DIR__"yongdao1",
    "west"  : __DIR__"huilang1",
  ]));
  setup();
}