// seller.c
inherit "/obj/npc/xiaofan";
void create()
{
  set_name("开封小贩", ({ "kaifeng xiao fan","seller" }) );
  set("gender", "男性" );
  set("age", 32);
  set("vendor_goods", ([
     "1" : "/d/kaifeng/obj/rice",
     "2" : "/d/kaifeng/obj/soup",
     "3" : "/d/kaifeng/npc/obj/fozhu",
     "4" : "/d/kaifeng/npc/obj/jindi",
     "5" : "/d/kaifeng/npc/obj/jinzhen",
     "6" : "/d/kaifeng/npc/obj/tiebian",
     "7" : "/d/kaifeng/npc/obj/tiejiang",
  ]));
  set("chat_chance", 20);
  set("chat_msg", ({
      (:random_move:),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 10);
  if (clonep())
    keep_heart_beat();
}

