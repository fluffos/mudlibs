#include <ansi.h>
#include <armor.h>
inherit NECK;
void create()
{
  set_name(MAG "紫檀佛串" NOR,({"fo chuan"}));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("material", "wood");
    set("unit", "串");
    set("value", 20000);
    set("armor_prop/spells", 5);
  }

  init_neck(10);
  setup();
}

