inherit BIGROOM;
inherit WOODROOM;
void create ()
{
  set ("short","郊外");
  set ("long", @LONG
此处是开封北郊，由于离开封很近，治安相对稳定。
西面一条大道，直接通往洛阳。
LONG);
  set("outdoors", "kaifeng");
  set("exits", ([
    "south" : __DIR__"xuandemen",
    "north" : __DIR__"jiaowai",
    "west"  : __DIR__"ly-dadao1",
  ]));
  setup();
}

