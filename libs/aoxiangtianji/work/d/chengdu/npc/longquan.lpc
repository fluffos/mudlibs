#include <ansi.h>
inherit NPC;
string ask_skill();
void create()
{
  set_name("龙铨", ({ "long quan", "long" }));
  set("title","金牛武馆教习");
  set("long", "龙老爷子在武馆也干了好多年头了，仍老当益壮。\n");
  set("gender", "男性");
  set("age", 60);
  set_skill("dodge", 120);
  set_skill("force", 120);
  set_skill("parry", 120);
  set_skill("unarmed", 120);
  set_skill("blade", 120);
  set_skill("wuhu-blade",120);
  set_temp("apply/attack", 120);
  set_temp("apply/defense", 120);
  set_temp("apply/damage", 20);
  set("combat_exp", 400000);
  set("inquiry", ([
    "学艺"   : (: ask_skill :),
  ]) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

int recognize_apprentice(object ob)
{
  if (! (int)ob->query_temp("marks/jinniu_paied") == 1)
    return 0;
  return 1;
}

string ask_skill()
{
  object me = this_player();
  string msg;

  msg = "我可以教你一下技能：\n";
  msg += "force        120 \n";
  msg += "dodge        120 \n";
  msg += "parry        120 \n";
  msg += "unarmed      120 \n";
  msg += "blade        120 \n";
  msg += "wuhu-blade   120 \n";
  tell_object(me,msg);
  return "你付钱后就可以向我学习了！\n";
}

