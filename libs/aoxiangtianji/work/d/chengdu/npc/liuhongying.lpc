// liuhongying.c
#include <ansi.h>
inherit NPC;
string ask_skill();
void create()
{
  set_name("刘虹瑛", ({ "liu hongying", "liu" }));
  set("title","金牛武馆教习");
  set("long", "刘教头是武馆的新来教习，你可别小看她哦。\n");
  set("gender", "女性");
  set("age", 32);
  set_skill("dodge", 120);
  set_skill("force", 120);
  set_skill("parry", 120);
  set_skill("unarmed", 120);
  set_skill("sword", 120);
  set_skill("sancai-sword", 120);
  set_temp("apply/attack", 80);
  set_temp("apply/defense", 80);
  set_temp("apply/damage", 20);
  set("combat_exp", 400000);
  set("inquiry", ([
    "学艺"   : (: ask_skill :),
  ]) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

int recognize_apprentice(object ob,string skill)
{
  if (!(int)ob->query_temp("marks/jinniu_paied") == 1)
    return 0;
  return 1;
}

string ask_skill()
{
  object me = this_player();
  string msg;

  msg = "我可以教你一下技能：\n";
  msg += "force        120 \n";
  msg += "dodge        120 \n";
  msg += "parry        120 \n";
  msg += "unarmed      120 \n";
  msg += "sword        120 \n";
  msg += "sancai-sword 120 \n";
  tell_object(me,msg);
  return "你付钱后就可以向我学习了！\n";
}

