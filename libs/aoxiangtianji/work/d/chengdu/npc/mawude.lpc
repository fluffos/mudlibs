#include <ansi.h>
inherit NPC;
string ask_skill();
void create()
{
  set_name("马五德", ({ "ma wude", "ma" }));
  set("title","金牛武馆馆长");
  set("long", "马老爷子是武馆的缔造者，辛苦一辈子了，仍勇于提携后生。\n");
  set("gender", "男性");
  set("age", 65);
  set_skill("dodge", 120);
  set_skill("force", 120);
  set_skill("parry", 120);
  set_skill("unarmed", 120);
  set_skill("spear", 120);
  set_skill("lihua-spear",120);
  set_temp("apply/attack", 80);
  set_temp("apply/defense", 80);
  set_temp("apply/damage", 20);
  set("combat_exp", 400000);
  set("inquiry", ([
    "学艺"   : (: ask_skill :),
  ]) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

int recognize_apprentice(object ob)
{
  if (! (int)ob->query_temp("marks/jinniu_paied") == 1)
    return 0;
  return 1;
}

string ask_skill()
{
  object me = this_player();
  string msg;

  msg = "我可以教你一下技能：\n";
  msg += "force        80 \n";
  msg += "dodge        80 \n";
  msg += "parry        80 \n";
  msg += "unarmed      80 \n";
  msg += "spear        80 \n";
  msg += "lihua-spear  80 \n";
  tell_object(me,msg);
  return "你付钱后就可以向我学习了！\n";
}

