// jitui.c 鸡腿
#include <weapon.h>
inherit HAMMER;
inherit F_FOOD;
void create()
{
  set_name("串串香", ({ "chuanchuan xiang", "xiang" }) );
  set_weight(350);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一种风味小吃。\n");
    set("unit", "根");
    set("value", 80);
    set("food_remaining", 4);
    set("food_supply", 15);
    set("wield_msg", "$N抓起一根$n，握在手中当武器。\n");
    set("material", "bone");
  }

  init_hammer(1);
  setup();
}