inherit SMALLROOM;
inherit LANDROOM;
inherit SAFTYROOM;
void create()
{
  set("short", "铸剑室");
  set("long", @LONG
你一走进这个屋子，就感觉到有一股热浪扑面而来。屋角有一个炉子，
里面燃着熊熊火光，似乎无数的金蛇在你面前晃动。屋角堆放着一堆堆黑
乎乎的东西，不知道是什么。
LONG );
  set("no_sleep_room", 1);
  set("exits", ([
    "out" : __DIR__"road5",
  ]));
  setup();
}

void init()
{
  object me = this_player();
  object ganjiang,moye;

  if (playerp(me))
  {
    ganjiang = present("gan jiang",this_object());
    moye = present("mo ye",this_object());

    if (!objectp(ganjiang))
      ganjiang = new("/adm/npc/ganjiang");
    if (!objectp(moye))
      moye = new("/adm/npc/moye");
  }
}

