// gumu.c 古坚木
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIG "古坚木" NOR, ({ "hard wood", "wood"}));
  set_weight(2200);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一块古色古香的木头，用手摸十分冰寒，看上去坚逾钢铁，非常坚固。\n");
    set("unit", "块");
    set("value", 30000);
    set("item_origin", 1);
    set("material_attrib", "steel");
    set("material_name", HIG "古坚木" NOR);
    set("can_make", ({ "盾"}));
    set("power_point", 50);
    set("no_put",1);
    set("drop_des",1);
    set("no_sell",1);
  }

  setup();
}

