inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "大道");
  set("long", @LONG
这是一条宽阔的官道，这里南望荆州，北去中原。
LONG);
  set("exits", ([
    "northwest" : __DIR__"nroad5",
    "southeast" : __DIR__"nroad3",
  ]));
  set("objects", ([
    "/obj/npc/jianke" : 1,
    sprintf("/obj/npc/shusheng%d", 1+random(3)) : 1,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "city");
  setup();
}

