inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "大道");
  set("long", @LONG
这是一条宽阔的官道，这里离荆州已经不远了。
望北的大道分为了两条，一条望西，通往汉水，
那里是重要的汉水渡口：汉津渡。一条笔直向
北的大道，看不出通往何处。
LONG);
  set("exits", ([
    "northwest" : __DIR__"hanshui1",
    "north" : __DIR__"nroad3",
    "south" : __DIR__"nroad1",
  ]));
  set("objects", ([
    "/obj/npc/haoke" : 1,
    sprintf("/obj/npc/girl%d", 1+random(4)) : 1,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "city");
  setup();
}

