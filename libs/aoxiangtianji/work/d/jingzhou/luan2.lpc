inherit GHOSTROOM;
void create()
{
  set("short", "乱坟岗");
  set("long", @LONG
这里是一处乱坟岗，到处长满了过人高的长草，听说这里
经常闹鬼，所以没人敢来。一阵冷风刮来，吓的你根根体毛竖
起。
LONG);
  set("exits", ([
    "west" : __DIR__"luan",
  ]));
  set("mai_corpse_able", 1);
