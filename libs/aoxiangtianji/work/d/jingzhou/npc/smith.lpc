#include <ansi.h>
inherit "/std/char/smith.lpc";
void create()
{
  set_name("铁匠", ({ "tiejiang", "smith" }));
  set("title", "铁匠铺老板");
  set("shen_type", 1);
  set("gender", "男性" );
  set("age", 33);
  set("long", "铁匠正用铁钳夹住一块红热的铁块放进炉中。\n");
  set("combat_exp", 400);
  set("attitude", "friendly");
  set("vendor_goods",([
   "1" : "/d/obj/weapon/sword/changjian",
   "2" : "/d/obj/weapon/blade/gangdao",
   "3" : "/d/obj/armor/armor/tiejia",
   "4" : "/d/obj/weapon/whip/changbian",
  ]));

  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

