#include <ansi.h>
#include <medical.h>
inherit NPC;
inherit F_VENDOR;
#define MAX_EXP 80000
string ask_job();
int do_peiyao(string arg);
int working(object me);
int halt_working(object me);
void create()
{
  set_name("华坨二世", ({ "huatuo ershi", "hua tuo", "hua", "doctor" }));
  set("title", "神医");
  set("gender", "男性");
  set("age", 65);
  set("int", 38);
  set("kee", 1000);
  set("max_kee", 1000);
  set("sen", 1000);
  set("max_sen", 1000);
  set("shen_type", 1);
  set("combat_exp", 500000);
  set("attitude", "heroism");
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 60);
  set_temp("apply/attack", 70);
  set_temp("apply/defense", 70);
  set_temp("apply/damage", 50);
  set("inquiry", ([
    "配药"   : (: ask_job :),
    "工作"   : (: ask_job :),
    "job"    : (: ask_job :),
  ]));
  set("vendor_goods", ([
     "1"  : HERB("chaihu"),         // 柴胡
     "2"  : HERB("chenpi"),         // 陈皮
     "3"  : HERB("chongcao"),       // 虫草
     "4"  : HERB("chuanwu"),        // 川乌
     "5"  : HERB("dahuang"),        // 大黄
     "6"  : HERB("danggui"),         // 当归
     "7"  : HERB("duhuo"),          // 独活
     "8"  : HERB("fangfeng"),       // 防风
     "9"  : HERB("fuzi"),           // 附子
     "10" : HERB("gsliu"),          // 干石榴
     "11" : HERB("guiwei"),         // 归尾
     "12" : HERB("hafen"),          // 蛤粉
     "13" : HERB("heshouwu"),       // 何首乌
     "14" : HERB("honghua"),        // 红花
     "15" : HERB("huangqi"),        // 黄芪
     "16" : HERB("juhua"),          // 菊花
     "17" : HERB("lanhua"),         // 兰花
     "18" : HERB("lingxian"),       // 灵仙
     "19" : HERB("lingzhi"),        // 灵芝
     "20" : HERB("mahuang"),        // 麻黄
     "21" : HERB("moyao"),          // 没药
     "22" : HERB("niuhuang"),       // 牛黄
     "23" : HERB("niuxi"),          // 牛膝
     "24" : HERB("qianjinzi"),      // 千金子
     "25" : HERB("renshen"),        // 人参
     "26" : HERB("ruxiang"),        // 乳香
     "27" : HERB("shadan"),         // 鲨胆
     "28" : HERB("shancha"),        // 山茶花
     "29" : HERB("shanjia"),        // 山甲
     "30" : HERB("shengdi"),        // 生地
     "31" : HERB("shenglg"),        // 生龙骨
     "32" : HERB("sumu"),           // 苏木
     "33" : HERB("taoxian"),        // 桃仙
     "34" : HERB("tenghuang"),      // 藤黄
     "35" : HERB("tianqi"),         // 田七
     "36" : HERB("tugou"),          // 土狗
     "37" : HERB("wulingzhi"),      // 五灵脂
     "38" : HERB("xiefen"),         // 蝎粉
     "39" : HERB("xijiao"),         // 犀角
     "40" : HERB("xionghuang"),     // 雄黄
     "41" : HERB("xuejie"),         // 血竭
     "42" : HERB("xuelian"),        // 雪莲
     "43" : HERB("yanwo"),          // 燕窝
     "44" : HERB("yjhua"),          // 洋金花
     "45" : HERB("yuanzhi"),        // 远志
     "46" : HERB("zihua"),          // 紫花
     "47" : HERB("zzfen"),          // 珍珠粉
     "48" :  "/d/obj/misc/yanbo",    // 研钵
