// seller.c
inherit "/obj/npc/xiaofan";
void create()
{
  set_name("荆州小贩", ({ "jingzhou xiao fan","seller" }) );
  set("gender", "男性" );
  set("age", 32);
  set("vendor_goods", ([
     "1" : "/d/jingzhou/obj/flower-shoe",
     "2" : "/d/jingzhou/obj/kaoya",
     "3" : "/d/jingzhou/obj/mian",
     "4" : "/d/jingzhou/obj/peanut",
     "5" : "/d/jingzhou/obj/shoutao",
     "6" : "/d/jingzhou/obj/tofu",
  ]));
  set("chat_chance", 20);
  set("chat_msg", ({
      (:random_move:),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 10);
  if (clonep())
    keep_heart_beat();
}

