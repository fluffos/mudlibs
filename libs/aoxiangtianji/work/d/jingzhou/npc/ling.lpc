inherit NPC;
void create()
{
  set_name("凌府伊", ({ "ling fuyi", "ling", "fuyi" }));
  set("title", "荆州知府");
  set("gender", "男性");
  set("age", 35);
  set("str", 20);
  set("dex", 20);
  set("long", "他就是凌思退，荆州现任知府。\n");
  set("combat_exp", 30000);
  set("shen_type", 0);
  set("attitude", "heroism");
  set_skill("unarmed", 50);
  set_skill("force", 50);
  set_skill("sword", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set_skill("sancai-sword", 50);
  set_skill("feiyan-zoubi", 50);
  map_skill("dodge","feiyan-zoubi");
  map_skill("sword","sancai-sword");
  map_skill("parry","sancai-sword");
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/armor", 50);
  set_temp("apply/damage", 15);
  set("force", 500);
  set("max_force", 500);
  setup();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
  carry_object("/obj/cloth/cloth")->wear();
}

