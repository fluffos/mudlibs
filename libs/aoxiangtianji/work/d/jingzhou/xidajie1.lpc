inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "西大街");
  set("long", @LONG
这是一条宽阔的青石板街道，向东西两头延伸。这里行人
稀少，静悄悄地很是冷清。东边是一个热闹的广场。南边是荆
州府衙。
LONG);
  set("outdoors", "jingzhou");
  set("exits", ([
    "east" : __DIR__"guangchang",
    "south" : __DIR__"jzyamen",
    "west" : __DIR__"xidajie2",
  ]));
  set("objects", ([
    sprintf("/obj/npc/boy%d",1+random(3)) : 1,
  ]));
  setup();
}

