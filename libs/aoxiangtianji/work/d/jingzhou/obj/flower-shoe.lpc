#include <ansi.h>
#include <armor.h>
inherit BOOTS;
void create()
{
  set_name(HIG"绣花小鞋"NOR, ({ "flower shoes", "shoes"}) );
  set_weight(900);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "cloth");
    set("unit", "双");
    set("value", 300);
    set("female_only", 1);
  }

  init_boots(2);
  setup();
}

