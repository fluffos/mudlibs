#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
void create()
{
  set_name("黄老板", ({ "huang laoban", "boss", "huang" }));
  set("title", "杂货铺老板");
  set("gender", "男性");
  set("age", 20);
  set("per", 24);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_temp("apply/damage", 25);
  set("combat_exp", 800000);
  set("no_get", "1");
  set("attitude", "friendly");
  set("vendor_goods", ([
   "1" : "/d/obj/misc/fire",
   "2" : "/d/obj/weapon/sword/mujian",
   "3" : "/d/obj/misc/wood",
   "4" : "/d/obj/misc/shoeshine",
   "5" : "/d/obj/misc/brush",
  ]));

  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  object ob;
  ob = this_player();
  ::init();
  if( interactive(ob) && !is_fighting() )
  {
    remove_call_out("greeting");
    call_out("greeting", 2, ob);
  }

  add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
  if( !ob || environment(ob) != environment() ) return;
  say(CYN "黄老板笑着说道：这位" + RANK_D->query_respect(ob)+ "你需"
          "买些什么，请随便看。\n" NOR);
  return;
}