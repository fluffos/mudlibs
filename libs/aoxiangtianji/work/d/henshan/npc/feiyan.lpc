#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
string *lq1 = ({
   "/d/henshan/yueqi/shixuanqin-zhanguo",
   "/d/henshan/yueqi/jiuxiaoqin",
});
string *lq2 = ({
   "/d/henshan/yueqi/zhongnishi",
   "/d/henshan/yueqi/jiaoyeqin",
});
string *lq3 = ({
   "/d/henshan/yueqi/qin-jueyin",
   "/d/henshan/yueqi/qin-konggu",
});
string *lq4 = ({
   "/d/henshan/yueqi/qin-jimo",
   "/d/henshan/yueqi/qin-tianlai",
});
string *lq5 = ({
   "/d/henshan/yueqi/zhuxiao-youlan",
   "/d/henshan/yueqi/zhuxiao-shuiyun",
});
string *lq6 = ({
   "/d/henshan/yueqi/zhuxiao-liuquan",
   "/d/henshan/yueqi/zhuxiao-qingyin",
});
void create()
{
//  reload("henshan_feiyan");
  set_name("绯胭", ({ "fei yan", "fei", "yan" }));
  set("nickname", HIM "八音狐仙" NOR);
  set("title", "老板娘");
  set("long", @LONG
绯胭原本在青楼以卖唱为生，因为被逼无奈，误杀县老
爷的公子，险被处死，后来据说她被狐仙所救，从此隐
姓埋名，做起这乐器的买卖。还有的说她本身就是狐仙
所化，又由于她的一曲《恋八音》，所以人人都称她为
「八音狐仙」。
LONG);
  set("shen_type", 1);
  set("gender", "女性");
  set("age", 25);
  set("per", 28);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_temp("apply/damage", 25);
  set("combat_exp", 800000);
  set("no_get", "1");
  set("attitude", "friendly");
  set("vendor_goods", ([
    "1" : "/d/henshan/yueqi/yuepu-book",
    "2" : "/d/henshan/yueqi/yueqi-book",
    "3" : "/d/henshan/yueqi/huxian-book",
    "4" : "/d/henshan/yueqi/zhuxiao",
    "5" : "/d/henshan/yueqi/huqin",
    "6" : "/d/henshan/yueqi/honghuqin",
    "7" : element_of(lq1),
    "8" : element_of(lq2),
    "9" : element_of(lq3),
    "10" : element_of(lq4),
    "11" : element_of(lq5),
    "12" : element_of(lq6),
    "13" : "/d/henshan/yueqi/tanhuqin",
  ]));

  set("inquiry", ([
     "杜凤鄂" : "杜公子，他还好吗？\n",
  ]));
  set("force_clear",1);
  setup();
  carry_object("/obj/cloth/female-shoe")->wear();
  carry_object(sprintf("/obj/cloth/female%d-cloth",1+random(8)))->wear();
}

void init()
{
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && ! is_fighting())
  {
    remove_call_out("greeting");
    call_out("greeting", 2, ob);
  }

  add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
  if (! ob || environment(ob) != environment()) return;
  say(CYN "绯胭笑着说道：这位" + RANK_D->query_respect(ob)+ "这里"
          "各种乐器应有尽有，请随便看看。\n" NOR);
  return;
}

