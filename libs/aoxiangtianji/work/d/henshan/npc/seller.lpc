// seller.c
inherit "/obj/npc/xiaofan";
void create()
{
  set_name("衡山小贩", ({ "henshan xiao fan","seller" }) );
  set("gender", "男性" );
  set("age", 32);
  set("vendor_goods", ([
     "1" : "/d/henshan/obj/blackcloth",
     "2" : "/d/henshan/obj/luo_cloth",
     "3" : "/d/henshan/obj/water",
     "4" : "/d/henshan/obj/mantou",
  ]));
  set("chat_chance", 20);
  set("chat_msg", ({
      (:random_move:),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 10);
  if (clonep())
    keep_heart_beat();
}

