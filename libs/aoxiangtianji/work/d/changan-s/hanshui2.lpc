#include <ansi.h>
inherit RIVER;
void create()
{
  set("short", "汉水北岸");
  set("long", @LONG
这里已经是汉水北岸了。自北岸渡口往北，一条宽阔的官道直
通远方。此地民风淳朴，路旁夹柳成阴酒厮林立，且都有面大
大的「酒」旗迎风飘扬，蔚为壮观。也有不少小贩沿路叫买，
语多难辨，却也令人盛情难却。
LONG);
  set("arrive_room", "/d/jingzhou/hanshui1");
  set("exits", ([
    "north" : __DIR__"broadway5",
    "east" : __DIR__"river1",
  ]));
  set("resource/fish", ({ "/obj/fish/liyu",
                          "/obj/fish/jiyu",
                          "/obj/fish/qingyu",
                          "/obj/fish/caoyu", }));
  set("outdoors", "jingzhou");
  setup();
  replace_program(RIVER);
}