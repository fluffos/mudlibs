inherit SMALLROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "山涧");
  set ("long", @LONG
山涧的这一端，青滕盘绕。山林间，各种小兽惊奇的
探头张望，却不敢走近来。
LONG);
  set("exits", ([ /* sizeof() == 2 */
    "north" : __DIR__"shanjian1",
    "south" : __DIR__"shanlu4",
  ]));
  set("outdoors", 1);
  setup();
}

int valid_leave (object who, string dir)
{
  if (dir == "north")
    message_vision ("$N一脚踏进溪流，慢慢走了过去。\n",who);
  return ::valid_leave (who, dir);
}