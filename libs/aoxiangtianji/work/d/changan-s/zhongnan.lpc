inherit BIGROOM;
inherit HILLROOM;
void create()
{
  set("short",  "终南山口");
  set("long",  @LONG
终南山又称太乙山，距长安城八十多里，素有“锦秀巨屏拱长安”之
说。据传老子也曾在山中讲经。这条大官道穿越终南山口，两面秀峰入云，
东边似乎有一条小路可以上山。北面是往长安的大道。
LONG);
  set("exits",  ([
        "south"  :  __DIR__"broadway2",
        "north"  :  __DIR__"broadway1",
        "east"   :  __DIR__"shanlu1",
  ]));
  set("outdoors", "changan");
  setup();
}

