inherit NPC;
void create()
{
  set_name("卢生", ({"lu sheng","lu", "sheng"}));
  set("long","一个很会做梦的书生。\n");
  set("gender", "男性" );
  set("age", 25);
  set("combat_exp", 80000);
  set("attitude", "peaceful");
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_skill("literate", 80);
  set_skill("force", 80);
  set_skill("sword", 80);
  set_skill("sancai-sword", 80);
  set_skill("feiyan-zoubi", 80);
  map_skill("sword","sancai-sword");
  map_skill("parry","sancai-sword");
  map_skill("dodge","feiyan-zoubi");
  set("per", 27);
  set("max_kee", 800);
  set("max_sen", 800);
  setup();
  carry_object("/obj/cloth/linen")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
  carry_object("/d/obj/misc/pillow");
}

