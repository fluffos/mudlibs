#include <ansi.h>
inherit NPC;
int do_liandan();
string ask_me();
string ask_yinzhen();
void create()
{
  set_name(HIY"老道"NOR, ({"lao daoshi", "laodao", "dao"}));
  set("gender", "男性");
  set("age", 106);
  set("nickname", HIR "炼丹道人" NOR);
  set("attitude", "heroism");
  set("str", 32);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kee", 20000);
  set("max_kee", 20000);
  set("sen", 20000);
  set("max_sen", 1600);
  set("force", 20000);
  set("max_force", 20000);
  set("combat_exp", 10000000);
  set("daoxing", 10000000);
  set("score", 300000);
  set_skill("medical", 300);
  set_skill("zhenjiu-shu", 300);
  set_skill("liandan-shu", 300);
  set_skill("literate", 150);
  set_skill("bencao-changshi",300);
  set_skill("bencao-shuli",300);
  set_skill("shennong-yaoshu",300);
  map_skill("medical", "bencao-shuli");
  set("inquiry", ([
     "炼丹"    : (:do_liandan:),
     "liandan" : (:do_liandan:),
     "quest"   :  "在我这里可以帮着我「" HIR "炼丹" NOR + CYN
                  "」，如果愿意可以想我询问。\n",
     "job"     :  "在我这里可以帮着我「" HIR "炼丹" NOR + CYN
                  "」，如果愿意可以想我询问。\n",
     "药材"    :  "去找我的小童，他会帮你处理。\n",
     "原料"    :  "去找我的小童，他会帮你处理。\n",
     "yaocai"  :  "去找我的小童，他会帮你处理。\n",
     "药"      :  "去找我的小童，他会帮你处理。\n",
     "医术"    : (: ask_me :),
     "本草常识" : (: ask_me :),
     "神农药术" : (: ask_me :),
     "炼丹术"  : (: ask_me :),
     "针灸术"  : (: ask_me :),
     "本草术理": (: ask_me :),
     "学习"    : (: ask_me :),
     "学技"    : (: ask_me :),
     "银针"    : (: ask_yinzhen :),
     "针"      : (: ask_yinzhen :),
     "针灸"    : (: ask_yinzhen :),
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

int do_liandan()
{
  int exp, dx, pot;
  object me = this_player();
  if (me->query_temp("liandan"))
  {
    if (me->query_temp("liandan") < 4)
    {
      command("say 不是要去炼丹吗，怎么还在这呆着？\n");
      return 1;
    }

    message_vision(CYN "老道对$N" CYN "微笑道：炼丹是个修身养性的"
                       "过程，你能成功，很不错！\n" NOR, me);
    exp = 12 + random(12);
    dx = 12 + random(12);
    pot = 6 + random(6);
    me->add("combat_exp", exp);
    me->add("daoxing", dx);
    me->add("potential", pot);
    tell_object(me, HIC "你获得了" + chinese_number(exp) +
                        "点经验和" + chinese_number(dx) +
                        "点道行和" + chinese_number(pot) + "点潜能。\n"NOR );
    me->delete_temp("liandan");
    me->add("over_quest/liandan_quest", 1);
    return 1;
  }

  else
  {
    message_vision(CYN "老道对$N" CYN "点了点头，说道：炼丹是考验"
                       "人的定力修为，心不静则事不成，你去向童子询问「"
                   HIG "药材" NOR + CYN "」吧。\n", me);
    me->set_temp("liandan", 1);
    return 1;
  }

}

string ask_me()
{
  object me;
  me = this_player();
  if (me->query("common/can_learn/yao") == 1)
    return "我不是答应教你了吗，你这人怎么那么罗嗦？";
  if (me->query("over_quest/liandan_quest") < 200 )
     return "这样吧，你先炼丹，心诚之时我自然会传授给你。";
  me->set("common/can_learn/yao", 1);
  write("我可以传授你如下技能：\n"
        "\t medical         300 \n"
        "\t zhenjiu-shu     300 \n"
        "\t liandan-shu     300 \n"
        "\t bencao-changshi 300 \n"
        "\t bencao-shuli    300 \n"
        "\t shennong-yaoshu 300 \n");
  return "既然你欲诚心钻研学医之道，我就成全成全你吧。";
}

int recognize_apprentice(object me, string skill)
{
  if ( ! me->query("common/can_learn/yao") )
  {
    command("say 我的医术向来是不轻易传授的。");
    return -1;
  }

  if (skill == "literate")
  {
    command("say 读书写字自己去找教书先生学去。");
    return -1;
  }

  return 1;
}

string ask_yinzhen()
{
  object ob;
  object me = this_player();
  if ((int)me->query_skill("zhenjiu-shu", 1) < 60)
    return "你针灸术还不娴熟，随便用针会弄出人命来的。";
  if (present("yin zhen", this_player()))
    return "你身上不是还有一根吗？";
  ob = new("/d/obj/misc/yinzhen");
  ob->move(me);
  message_vision(HIW "\n老道从针盒里轻轻拈出一根银针，递给了$N" HIW "。\n" NOR, me);
  return "这针可是用来救命的，好好的利用它为人治病吧。";
}

