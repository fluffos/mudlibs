inherit NPC;
#include <ansi.h>
void create()
{
  set_name("毒郎中", ({ "du langzhong", "du", "langzhong" }));
  set("long", "一个面目凶神恶刹的中年人，现在在到处收集毒药。\n");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "peaceful");
  set("class", "taoist");
  set("str", 35);
  set("int", 28);
  set("con", 30);
  set("dex", 28);

  set("max_kee", 1200);
  set("max_sen", 1200);
  set("force", 2000);
  set("max_force", 1200);
  set("force_factor", 50);
  set("combat_exp", 600000 + random(600000));
  set("mana", 2000);
  set("max_mana", 1200);
  set("mana_factor", 50);
  set("daoxing", 600000 + random(600000));
  set_skill("force", 100 + random(100));
  set_skill("spells", 100 + random(100));
  set_skill("dodge", 100 + random(100));
  set_skill("unarmed", 100 + random(100));
  set_skill("parry", 100 + random(100));
  set_skill("whip", 100 + random(100));
  set_skill("wuxiangforce", 100 + random(100));
  set_skill("dao", 100 + random(100));
  set_skill("jindouyun", 100 + random(100));
  set_skill("puti-zhi", 100 + random(100));
  set_skill("wuwei-fuchen", 100 + random(100));
  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("whip", "wuwei-fuchen");
  map_skill("parry", "wuwei-fuchen");
  setup();
  carry_object("/obj/cloth/dao-cloth")->wear();
  carry_object("/d/obj/armor/shoes/yunxie")->wear();
  carry_object("/d/obj/weapon/whip/fuchen")->wield();
}