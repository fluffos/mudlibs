inherit SMALLROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "山涧");
  set ("long", @LONG
山路愈加难行，耳边听到了小溪流淌的声音。慢慢
的走近了，却是一条不宽阔的山涧，雾气在水面慢慢的
升腾，山水清澈，这小涧确实很浅。
LONG);
  set("exits", ([ /* sizeof() == 2 */
    "northwest" : __DIR__"shanlu3",
    "south" : __DIR__"shanjian2",
  ]));
  set("outdoors", 1);
  setup();
}

int valid_leave (object who, string dir)
{
  if (dir == "south")
    message_vision ("$N一脚踏进溪流，慢慢走了过去。\n",who);
  return ::valid_leave (who, dir);
}