#include <ansi.h>
inherit SMALLROOM;
inherit LANDROOM;
inherit SAFTYROOM;
#define DAN_DIR         "/d/obj/misc/dan/"
int liandan(object me);
int halt_liandan(object me);
int do_liandan(string arg);
void create()
{
  set("short", HIY "炼丹房" NOR);
  set("long", @LONG
这是姚春的炼丹房，四周堆放着炼丹的药材，一个漆黑的炼丹炉(lu)耸立
在中央，房中的药味经久不散，并且总有一股散不尽的淡青色烟雾，长时间的
丹药炼制已经让这个房间充满了神秘的色彩。
LONG );
  set("item_desc", ([
    "lu" : YEL "一个深黑色的大铁丹炉，顶部不停地升起丝丝青烟。\n" NOR,
  ]));
  set("exits", ([
    "north" : __DIR__"liandan_yaoshi",
  ]));
  setup();
}

void init()
{
  add_action("do_liandan", "liandan");
}

int do_liandan(string arg)
{
  int time;
  object me = this_player();
  time = 15 + random(15);
  if (me->is_busy())
    return notify_fail("等你有空了再说吧。\n");
  if ((int)me->query_temp("liandan") < 1)
    return notify_fail("炼丹之地，切勿滋扰。\n");
  if ((int)me->query_temp("liandan") < 2)
    return notify_fail("原料都没有，炼什么啊？\n");
  if ((int)me->query_temp("liandan") == 3)
    return notify_fail("丹药炼制中，请勿分心。\n");
  if ((int)me->query_temp("liandan") == 4)
    return notify_fail("炼制成功，快去复命吧。\n");
  if ((int)me->query("sen") < 80 ||
       (int)me->query("kee") < 80)
    return notify_fail("你现在的精神状况无法炼制丹药。\n");
  message_vision(HIY "$N" HIY "将原料药材一一放进炉中，盘"
                     "腿坐下，闭目静待。\n" NOR, me);
  me->set_temp("liandan", 3);

  me->set_temp("liandan-j/step", 1);
  me->start_busy((: liandan :),(: halt_liandan :));
/*
  me->start_busy(bind((: call_other, __FILE__, "liandan" :), me),
                 bind((: call_other, __FILE__, "halt_liandan" :), me));
*/
  tell_object(me, HIY "你开始炼丹。\n" NOR);
/*
  me->start_call_out((: call_other, __FILE__, "liandan", me :), time);
  me->start_busy(time / 2 + 1);
*/
  return 1;
}

// 极品丹列表
string *ULTRA_LIST = ({ "danS_1", "danS_2", "danS_3", "danS_4", "danS_5",
                        "danM_3", "danM_4", "danM_5", "danM_8","danM_9", });
// 特殊丹列表
string *SM_LIST = ({ "danM_1", "danM_2", "danM_6", "danM_7",
                     "danA_5", "danB_5", "danC_5", "danD_5",
                     "danB_6", "danD_6",});
// 普通丹列表
string *NORMAL_LIST = ({ "danA_1", "danA_2", "danA_3", "danA_4",
                         "danB_1", "danB_2", "danB_3", "danB_4",
                         "danC_1", "danC_2", "danC_3", "danC_4",
                         "danD_1", "danD_2", "danD_3", "danD_4", });
int liandan(object me)
{
  object ob;
  int skill,finish;
  string msg;
  if (! me->query_temp("liandan-j/step"))
    me->set_temp("liandan-j/step", 1);
  if (! living(me))
  {
    me->delete_temp("liandan");
    me->delete_temp("liandan-j/step");
    return 0;
  }

  finish = 0;
  me->receive_damage("kee", 3);
  me->receive_damage("sen", 3);
  skill = (int)me->query_skill("liandan-shu", 1);
  if (environment(me) != this_object())
  {
    me->delete_temp("liandan");
    me->delete_temp("liandan-j/step");
    return 0;
  }

  switch (me->query_temp("liandan-j/step"))
  {
    case 1:
      msg = HIY"$N" HIY"默默念了几句，显得气定神闲。"NOR;
      break;
    case 2:
      msg = HIW"$N" HIW"眉毛挑动了几下，眼睛闭着，一动不动。"NOR;
      break;
    case 3:
      msg = HIC"$N" HIC"头略微动了动，房间内慢慢的有了点药材的味道。"NOR;
      break;
    case 4:
      msg = HIG"$N" HIG"头渐渐的下垂了些，显得有点疲倦。"NOR;
      break;
    case 5:
      msg = HIC"$N" HIC"仿佛入睡了一般，房间内，药草的气味更浓了。"NOR;
      break;
    case 6:
      break;
    case 7:
      msg = HIB"$N" HIB"觉得有些疲倦，慢慢的神游野外了。"NOR;
      break;
    case 8 :
    case 9 :
    case 10:
      msg = HIC"$N" HIC"嗅了嗅鼻子，依然昏昏然！一股药香弥漫在房间内，气味越来越浓！"NOR;
      break;
    default :
      msg = HIR"正当$N" HIR"昏然欲睡之时，突然药香浓烈刺鼻。$N"
            HIR"不禁精神一振，急忙起身！"NOR;
      finish = 1;
      break;
  }

  if (stringp(msg))
  {
  msg += "\n";
  message_vision(msg,me);
  }

  if (finish)
  {
    if (random(skill) < 60 && random(3) == 1)
    {
      me->set_temp("liandan", 1);
      msg = HIR"$N" HIR"急忙开炉取药，可惜被弄得个灰头土脸！\n"NOR;
      message_vision(msg,me);
    }

    else if (random(skill) > 200 && random(5) == 1)
    {
      msg = HIY "炉顶青烟渐渐转淡，蓦然一道金光闪过，$N"
            HIY "不禁吃了一惊，此时丹药气味渐浓，$N"
            HIY "赶紧把炼制而成的丹丸取出。\n" NOR;
      message_vision(msg,me);
      me->set_temp("liandan", 4);
      ob = new(DAN_DIR + element_of(ULTRA_LIST));
      tell_object(me, HIC "你炼成了极品「" + NOR + ob->name() + NOR + HIC "」。\n" NOR);
      ob->move(me, 1);
      ob->set("owner",me->query("id"));
      if (me->can_improve_skill("liandan-shu") && skill < 300)
      {
        me->improve_skill("liandan-shu", me->query("int") + 10);
        tell_object(me, HIC "在炼丹过程中你的「炼丹术」提高了！\n" NOR);
      }

    }

    else if (random(skill) > 100 && random(5) == 1)
    {
      msg = HIY "炉顶青烟渐渐转淡，蓦然一道红光闪过，$N"
            HIY "不禁吃了一惊，此时丹药气味渐浓，$N"
            HIY "赶紧把炼制而成的丹丸取出。\n" NOR;
      message_vision(msg,me);
      me->set_temp("liandan", 4);
      ob = new(DAN_DIR + element_of(SM_LIST));
      tell_object(me, HIC "你炼成了珍品「" + NOR + ob->name() + NOR + HIC "」。\n" NOR);
      ob->move(me, 1);
      ob->set("owner",me->query("id"));
      if (me->can_improve_skill("liandan-shu") && skill < 300)
      {
        me->improve_skill("liandan-shu", me->query("int") + 10);
        tell_object(me, HIC "在炼丹过程中你的「炼丹术」提高了！\n" NOR);
      }

    }

    else
    {
      msg = HIC "炉顶青烟渐渐转淡，丹药气味渐浓，$N"
            HIC "高兴地把炼制而成的丹丸取出。\n" NOR;
      message_vision(msg,me);
      me->set_temp("liandan", 4);
      ob = new(DAN_DIR + element_of(NORMAL_LIST));
      tell_object(me, HIC "你炼成了「" + NOR + ob->name() + NOR + HIC "」。\n" NOR);
      ob->move(me, 1);
      if (me->can_improve_skill("liandan-shu") && skill < 300)
      {
        me->improve_skill("liandan-shu", me->query("int") / 4 + 1);
        tell_object(me, HIC "在炼丹过程中你的「炼丹术」提高了！\n" NOR);
      }

    }

    return 0;
  }

  me->add_temp("liandan-j/step", 1);
  return 1;
}

int halt_liandan(object me)
{
  message_vision(HIY "$N" HIY "猛的站了起来，叹了口气，算了，不炼了！\n"NOR, me);
  me->delete_temp("liandan");
  me->delete_temp("liandan-j/step");
  return 1;
}

