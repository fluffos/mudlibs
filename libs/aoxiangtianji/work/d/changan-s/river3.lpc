inherit BIGROOM;
inherit WATERROOM;
void create ()
{
  set ("short", "汉水边");
  set ("long", @LONG
汉江水向东静静流去。江边杨柳稀疏，一条不宽的小路沿江
伸展，望眼处，江烟迷茫。江面上，白帆点点，唱晚的渔舟
映着残阳，粼粼的波光泛着金黄。往东南的小路上，渐渐多
了些烧香的游人，据说不远处的二郎庙，求神拜佛很是灵验。
LONG);
  set("exits", ([ /* sizeof() == 2 */
    "west" : __DIR__"river2",
    "southeast" : "/d/meishan/guanjiang1",
  ]));
  set("outdoors", 1);
  setup();
}

