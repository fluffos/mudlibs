#include <ansi.h>
inherit MIDDLEROOM;
inherit WOODROOM;
inherit SAFTYROOM;
void create()
{
  set ("short", HIB"房管所"NOR);
  set ("long", @LONG
泾水河边的居民逐渐增多，因此特别在此设立房管所，临时由
一个不知名的老头负责。
LONG);
  set("exits",
  ([ //sizeof() == 4
     "east" : "/adm/npc/ph",
  ]));
  set("objects",
  ([ //sizeof() == 1
     "/adm/npc/officer" : 1,
  ]));
  set("no_clean_up", 0);
  set("outdoors", 1);
  setup();
}

