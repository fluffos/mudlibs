inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "山路");
  set ("long", @LONG
一条狭窄的山路，路两边树林深深，小路陡峭而崎岖，
望眼远处，雾气迷茫。清新的空气，混合着野花的香味，
不知名的小虫欢乐的歌唱。
LONG);
  set("exits", ([ /* sizeof() == 2 */
    "west" : __DIR__"zhongnan",
    "southeast" : __DIR__"shanlu2",
  ]));
  set("outdoors", 1);
  setup();
}

