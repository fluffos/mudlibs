inherit BIGROOM;
inherit HILLROOM;
void create()
{
  set("short", "五丈原");
  set("long", @LONG
这里是三国时期，诸葛亮屯兵之处，可惜星落五丈原。
出身未捷身先死，常使英雄泪满襟。诸葛亮六出祁山，
伐中原未果。蜀乃弹丸之地，以攻为守的策略确实是自
保及北图发展的最好选择。
LONG);
  set("outdoors", "lanzhou");
  set("exits", ([
    "northdown" : __DIR__"caroad3",
    "southup" : __DIR__"caroad5",
  ]));
  setup();
