inherit SMALLROOM;
inherit HILLROOM;
void create()
{
  set("short", "剑阁");
  set("long", @LONG
剑阁乃是天下极险之处，也是三国时期，蜀汉守卫的重要
关隘。当年姜维在此处对抗钟会的伐蜀大军，不料邓艾乘机偷
渡阴平小道，取绵竹，刘禅投降，三国的蜀汉因此灭亡。
LONG);
  set("outdoors", "lanzhou");
  set("exits", ([
    "northeast" : __DIR__"caroad5",
    "southup" : __DIR__"caroad7",
  ]));
  setup();
}

