inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short","金城郡南");
  set ("long", @LONG
金城郡是西北地区的重要城镇。向西看去，茫茫一片远处隐隐
约约有一群山脉。北边是金城郡南门，城门紧闭，城门洞里摆
着一小食摊在卖着什么。往东有一条大官道可以通达兰州。
LONG);
  set("exits", ([
    "west"      : __DIR__"dadao",
    "southeast" : __DIR__"west3",
    "northeast" : "/d/moon/xiaolu3",
  ]));
