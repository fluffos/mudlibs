inherit "/obj/npc/xiaofan";
void create()
{
  set_name("兰州小贩", ({ "lanzhou xiao fan", "seller", "xiaofan" }) );
  set("gender", "男性" );
  set("age", 32);
  set("vendor_goods", ([
   "1" : "/d/lanzhou/obj/tanghulu",
   "2" : "/d/lanzhou/obj/huasen",
   "3" : "/d/lanzhou/obj/tangbo",
   "4" : "/d/lanzhou/obj/jiuhulu",
   "5" : "/d/lanzhou/obj/maoniurou",
  ]));
  set("chat_chance", 20);
  set("chat_msg", ({
      (:random_move:),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 100);
  if (clonep())
    keep_heart_beat();
}

