#include <ansi.h>
inherit "/obj/npc/bank-npc";
void create()
{
  set_name("钱迷心", ({"qian mixin", "qian", "mixin"}));
  set("title", "钱庄老板");
  set("nickname", "心迷钱");
  set("gender", "男性");
  set("age", 34);
  set("kee", 5000);
  set("max_kee", 5000);
  set("sen", 5000);
  set("max_sen", 5000);
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("env/wimpy", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/damage", 40);
  set("chat_chance", 2);
  set("chat_msg", ({
     CYN "钱迷心骄傲的说道：本银号已经有上百年的历史，在江南可以说是第一家。\n" NOR,
     CYN "钱迷心笑着说道：在本店存钱无利息，取钱收十分之一的手续费，客官您看着办吧。\n" NOR
  }));
  setup();
  add_money("silver", 10);
  carry_object("/obj/cloth/choupao")->wear();
}