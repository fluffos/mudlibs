inherit BIGROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "雪山");
  set ("long", @LONG
雪山之上，朔风凌厉。踩着厚厚的积雪，道路十分难行。
山上远望，西海海面飘浮着一块块的浮冰，在阳光的映射下，
分外刺目。
LONG);
  set("exits", ([
    "southdown" : __DIR__"seashore3",
    "northup" : __DIR__"xueshan2",
  ]));
  set("outdoors", "westsea");
  setup();
}