inherit BIGROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "雪山顶");
  set ("long", @LONG
雪山山顶之上，朔风凌厉。厚厚的积雪几乎没到了膝盖。山
上远望，西海海面飘浮着一块块的浮冰，在阳光的映射下，分外
刺目。
LONG);
  set("exits", ([
    "southdown" : __DIR__"xueshan2",
    "northdown" : "/d/northsea/xueshan3",
  ]));
  set("outdoors", "westsea");
  setup();
}