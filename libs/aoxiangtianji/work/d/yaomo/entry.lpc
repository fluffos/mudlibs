#include <ansi.h>
inherit BIGROOM;
inherit LANDROOM;
inherit SAFTYROOM;
void create()
{
  set ("short", "禹王林");
  set ("long", @LONG
禹王林浓密浩瀚如海，远风吹过，林涛阵阵。雾从脚下生，有如一望
无际万里的纱帐飘渺似烟波海上。近处有一巨大的青铜雕花旗杆，有
一旗帜飘扬，上书“天御玉执禹王爷万年妖魔大会”。
LONG);
  set("exits", ([
     "north" : __DIR__"ready",
     "south" : "/d/kaifeng/yuwangmiao",
  ]));
  set("objects", ([
        __DIR__"npc/zu" :  2,
        __DIR__"npc/ye" :  1,
  ]));
  set("no_npc",1);
  setup();
}
int valid_leave(object me, string dir)
{
  if ( !wizardp(me) && dir == "north" )
    return notify_fail("禹王卒一把拦住了你。\n");
  return ::valid_leave(me, dir);
}
