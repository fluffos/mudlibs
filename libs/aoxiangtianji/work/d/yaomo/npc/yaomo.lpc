#include <ansi.h>
inherit "/obj/questnpc/tasknpc";
void kill_ob(object ob);
void create()
{
  ::create();
  set_name("妖怪","ymdh yaoguai");
  setup();
  if (clonep())
    keep_heart_beat();
}

void init()
{
  object ob = this_object();
  object who = this_player();
  int l;

  if (!playerp(who) || !who->query_temp("ymdh/joiner"))
    return;

  if (ob->is_fighting())
    return;

  l = ob->query("level") - who->query("level");
  if (l < -3)
    message_vision("$N战战兢兢的看了看$n，只想找个地方躲起来！\n",ob,who);
  else if (l > 3)
    message_vision("$N看着$n嘿嘿一阵冷笑！好象很是不屑！\n",ob,who);
  else
  {
    message_vision("$N哈哈大笑，送上来的肉！看起来$N决心杀死$n！\n",ob,who);
    ob->kill_ob(who);
  }

}

void full_me(object me)
{
  me->set("kee",me->query("max_kee"));
  me->set("eff_kee",me->query("max_kee"));
  me->set("sen",me->query("max_sen"));
  me->set("eff_sen",me->query("max_sen"));
  me->set("force",me->query("max_force"))*2;
  me->set("mana",me->query("max_mana"))*2;
  me->clear_condition(0);
  return;
}

void die(object killer)
{
  object dob, weapon, gun;
  int exp,dx,qn,weiwang,score, mylvl, yourlvl;
  if (! objectp(dob = killer))
    dob = query_last_damage_from();
  if (objectp(dob) && dob->query_temp("owner"))
    dob = dob->query_temp("owner");
  if (dob && !dob->query_temp("ymdh/joiner"))
  {
    log_file("static/killed_die", sprintf("%s %s(%s) died at %s because %s.\n",
           ctime(time()),
           name(),
           query("id"),
           environment()->short(),
           dob ? sprintf("%s(%s)", dob->name(1), dob->query("id")) : "none"));
    destruct(this_object());
    return;
  }

  if (random(10) < 2)
  {
    gun = new("/d/yaomo/obj/gun");
    if (objectp(gun))
      gun->move(environment(),1);
  }

  yourlvl = (int)dob->query("level");
  mylvl = query("level");
  if (yourlvl > mylvl + 3)
  {
    message_vision("$N惨叫一声，死了。\n",this_object());
    destruct(this_object());
    return;
  }

  dx = 120 + (mylvl - yourlvl + 3)*10;
  dx = dx/2 + random(dx);
  exp = dx/4 + random(dx/2);
  qn = dx/4 + random(dx/3);
  weiwang = 1 + random(3);
  score = 2 + random(3);
  message_vision("$N惨叫一声，死了。\n",this_object());
  GIFT_D->delay_bonus(dob, ([ "exp"     : exp ,
                              "daoxing" : dx,
                              "pot"     : qn ,
                              "mar"     : random(1 + qn/3*2),
                              "weiwang" : weiwang,
                              "score"   : score,
                              "prompt"  : "击毙" + name() + "之后" ]),"xue");
  if (weapon = dob->query_temp("weapon") ||
      weapon = dob->query_temp("armor/hands"))
    weapon->killer_reward(dob, this_object());
  destruct(this_object());
  return;
}

void kill_ob(object ob)
{
  if (!ob->query_temp("ymdh/joiner"))
  {
    delete_temp("my_killer");
    ::kill_ob(ob);
    return;
  }

  if (!query_temp("my_killer"))
    full_me(this_object());
  set_temp("my_killer",ob);
  ::kill_ob(ob);
  return;
}

void scan()
{
  object ob = this_object();
  ::scan();
  if ((time() - (int)query("born_time")) > query("stay_time") &&
      ! is_fighting() && living(ob))
  {
    message_vision("$N急急忙忙的走了。\n", ob);
    destruct(this_object());
    return;
  }

  return;
}

