#include <ansi.h>;
inherit NPC;
mixed ask_me();
void create()
{
  set_name("禹王爷", ({ "yuwang ye", "yuwang", "yu", "wang", "ye" }));
  set("title", "天御玉执");
  set("gender", "男性");
  set("age", 100);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("per", 30);
  set("kee", 4800);
  set("max_kee", 4800);
  set("sen", 4800);
  set("max_sen", 4800);
  set("force", 9600);
  set("max_force", 4800);
  set("jiali", 150);
  set("combat_exp", 5000000);
  set("daoxing", 5000000);

  set_skill("force", 500);
  set_skill("lengquan-force", 500);
  set_skill("spells", 500);
  set_skill("baguazhou", 500);
  set_skill("axe", 500);
  set_skill("sanban-axe", 500);
  set_skill("dodge", 500);
  set_skill("yanxing-steps", 500);
  set_skill("unarmed", 500);
  set_skill("changquan", 500);
  set_skill("parry", 500);
  set_skill("martial-cognize", 500);
  set_skill("literate", 500);
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("axe", "sanban-axe");
  map_skill("parry", "sanban-axe");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed","changquan");
  set("inquiry", ([
        "妖魔大会"     : (: ask_me :),
  ]));
  setup();

  carry_object("/d/obj/weapon/axe/huafu")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
}

void init()
{
  if (playerp(this_player()))
    add_action("do_sign", "sign");
}

mixed ask_me()
{
  object me;
  me = this_player();
  if (PK_D->is_pking())
    return "现在妖魔大会正在举行呢！\n";
  if (PK_D->is_ready())
    return "很好，现在妖魔大会正要开始，你要报名(sign)么？";
  return "妖魔大会？你先等着吧。\n";
}

int do_sign()
{
  object me;
  string msg;
  object ob;
  me = this_player();
  message_vision(CYN "\n$N" CYN "陪着笑脸对$n" CYN "道：您好，您好，我"
                        "也来签个到。\n" NOR, me, this_object());
  if (me->query("level") < 15)
  {
    message_vision(CYN "$n" CYN "抬头看了看$N" CYN "，说道："
                       "你目前的能力还不足够参加妖魔大会！\n" NOR, me, this_object());
    return 1;
  }

  if (stringp(msg = PK_D->reject_join(me)))
  {
    command("say " + msg);
    return 1;
  }

  foreach (ob in deep_inventory(me))
    if (ob->is_character())
    {
      command("say 你背的谁？参加比赛还拖家带口的！");
      message_vision(HIC "$N" HIC "很不满意的瞪了$n" HIC "一眼！\n" NOR,
                     this_object(), me);
      me->receive_damage("kee", 50);
      return 1;
    }

  message_vision(CYN "$n" CYN "点点头，对$N" CYN "道：很好，很好，你先"
                     "进去准备吧。\n\n" HIY "$N" HIY "点点头，向北面的准备"
                     "室走去。\n" NOR, me, this_object());
  me->move("/d/yaomo/ready");
  me->set_temp("ymdh/joiner",1);
  message("vision", HIW + me->name() + HIW "精神抖擞的走了进来。\n" NOR,
                          environment(me), ({ me }));
  return 1;
}