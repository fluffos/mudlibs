// gun.c
inherit ITEM;
int is_yaomodahui_gun()
{
  return 1;
}

int can_use()
{
  object env = environment();

  if (!objectp(env))
    return 0;
  if (!objectp(environment(env)) || !environment(env)->is_ymdh_field())
    return 0;
  return 1;
}

void create()
{
  set_name("手枪",({"hand gun", "gun" }));
  set_weight(5000);
  if(clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit","只");
    set("value", 0);
    set("material","steel");
    set("long","一把精致的手枪。\n");
    set("no_put",1);
    set("no_sell", "没人敢买也。\n");
    set("no_drop", "不可扔弃也。\n");
    set("no_give", "不可赠人也。\n");
  }

  setup();
}

void init ()
{
  object who = this_player();
  if (!playerp(who))
    return;
  add_action ("do_fire", "fire");
}

int do_fire(string arg)
{
  object ob;
  object who = this_player();
  object gun = this_object();

  if (!present(gun,who))
    return notify_fail("你必须先拿起来！\n");

  if (!arg)
    return notify_fail("你要象谁开枪？\n");

  ob = present(arg,environment(who));
  if(!objectp(ob) ||
     !ob->is_character() ||
     ob->is_corpse() ||
     ob->is_ghost() )
    return notify_fail("看清楚点，这个东西开枪也没有用。\n");

  if (!can_use())
    return 0;
  message_vision("$N猛然掏出了一把手枪，对着$n，“砰”的一声巨响。。。\n",who,ob);
  message_vision("$N转瞬就倒在了血泊中，眼见是不能活了。\n",ob);
  ob->receive_damage("kee",ob->query("max_kee"),who);
  ob->die(who);
  destruct(gun);
  return 1;
}