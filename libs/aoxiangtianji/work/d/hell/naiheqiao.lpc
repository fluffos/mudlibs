inherit SMALLROOM;
inherit MUDDYROOM;
inherit GHOSTROOM;
void create ()
{
  set ("short", "奈何桥");
  set ("long", @LONG
这是一座仅数寸之宽，数长之长的石桥。上有寒风滚滚，下是
血浪滔滔。桥上左右无扶手，险峻之路如同匹练搭长江，桥下
之水阴气逼人，腥风扑鼻。
LONG);
  set("exits", ([
    "south" : __DIR__"bidouya",
    "north" : __DIR__"huangwai",
  ]));

  set("objects", ([
    __DIR__"npc/shizhe" : 2,
  ]));

  setup();
}

