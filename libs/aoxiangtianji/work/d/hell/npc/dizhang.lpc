#include <ansi.h>
#include "hell.h"
inherit NPC;
inherit F_MASTER;
string ask_rank();
void create()
{
  set_name(HIC"地藏王菩萨"NOR, ({"dizang pusa", "pusa"}));
  set("long", "面如朱玉，大耳垂肩，一脸肃静，他便是主管阴曹地府，"
              "天下鬼魂的地藏王菩萨．\n");
  set("gender", "男性");
  set("class", "ghost");
  set("age", 70);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("per", 30);
  set("str", 30);
  set("int", 30+random(5));
  set("max_kee", 8000);
  set("max_sen", 8000);
  set("force", 8000);
  set("max_force", 4000);
  set("force_factor", 200);
  set("max_mana", 4000);
  set("mana", 8000);
  set("mana_factor", 200);
  set("combat_exp", 5000000);
  set("daoxing", 5000000);

  set_skill("literate", 300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("sword", 300);
  set_skill("stick", 300);
  set_skill("whip", 300);
  set_skill("tonsillit", 300);
  set_skill("gouhunshu", 300);
  set_skill("ghost-steps", 300);
  set_skill("jinghun-zhang", 300);
  set_skill("zhuihun-sword", 300);
  set_skill("kusang-stick",300);
  set_skill("hellfire-whip",300);
  set_skill("medical",300);
  set_skill("hell-yishu",300);
  map_skill("medical","hell-yishu");

  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");
  map_skill("dodge", "ghost-steps");
  map_skill("unarmed", "jinghun-zhang");
  map_skill("parry","hellfire-whip");
  map_skill("whip","hellfire-whip");
  map_skill("sword","zhuihun-sword");
  map_skill("stick","kusang-stick");
  set("inquiry", ([
    "职位"    : (: ask_rank :),
  ]) );
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "whip.three" :),
    (: cast_spell, "gouhun" :),
  }) );
  set_temp("apply/armor", 50);
  set_temp("apply/dodge", 50);

  create_family("阎罗地府", 1, "白");
  setup();

  carry_object("/d/obj/armor/cloth/longpao")->wear();
  carry_object("/d/obj/weapon/whip/longsuo")->wield();
}

int attempt_apprentice(object ob)
{
  string myname = RANK_D->query_respect(ob);

  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;

  if ( (string)ob->query("family/family_name") != "阎罗地府")
  {
    command("say 我只收鬼族弟子！\n");
    return 0;
  }

  if (((int)ob->query("level") <= 32 ))
  {
    command("shake");
    command(sprintf("say %s还是先去学些基础功夫吧！\n",myname));
    return 0;
  }

  if ((int)ob->query("obstacle/number") < 34)
  {
    command("say 你尚未取经圆满，我还不能收你！\n");
    return 0;
  }

  command("grin");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",myname));
  command("recruit " + ob->query("id") );
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "阎罗地府")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我阎罗地府人，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "ghost")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我鬼族，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 32 )
  {
    command(sprintf("say %s还是先去学些基础功夫吧！\n",myname));
    return 1;
  }

  return 0;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我地府的弟子！\n";

  if (me->query("class") != "ghost")
    return "你不是鬼族！\n";

  switch (topic)
  {
    case "历练" :
    case "历炼" :
    case "锻炼" :
      return QUEST_D->accept_ask(master, me, topic);
      break;

//gouhunshu
    case "勾魂" :
    case "gouhun" :
      if (me->query("family/can_cast/gouhun"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("gouhunshu",1) < 100)
        return "你的勾魂术修为不够，暂时无法领悟！\n";
      if (me->query("max_mana") < 1000)
        return "你的法力修为不够，暂时无法领悟！\n";
      message_vision("$N点了点头，在$n耳朵边上说了几句。\n",master,me);
      message_vision("$N一怔，不禁心有所悟，点了点头！\n",me);
      me->set("family/can_cast/gouhun",1);
      return "你学会了“勾魂”！\n";
      break;

    case "地狱火" :
    case "inferno" :
       return MASTER_D->teach_pfm(me, this_object(),
             ([ "cast"    : "inferno",
                "name"    : "地狱火",
                "sk1"     : "gouhunshu",
                "lv1"     : 150,
                "max_mana" : 2000,
                "gongxian": 500,]));
       break;

    case "六道轮回" :
    case "ldlh" :
       return MASTER_D->teach_pfm(me, this_object(),
             ([ "cast"    : "ldlh",
                "name"    : "六道轮回",
                "sk1"     : "gouhunshu",
                "lv1"     : 200,
                "sk2"     : "hellfire-whip",
                "lv2"     : 200,
                "max_mana" : 2500,
                "gongxian": 800,]));
       break;
//duo-sword
    case "夺命一击" :
    case "duo" :
      if (me->query("family/can_pfm/duo"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("duoming-sword",1) < 80)
        return "你的夺命剑法修为不够，暂时无法领悟！\n";
      if (me->query_skill("tonsillit",1) < 80)
        return "你的摄气诀修为不够，暂时无法领悟！\n";
      message_vision("$N点了点头，在$n耳朵边上说了几句。\n",master,me);
      message_vision("$N一怔，不禁心有所悟，点了点头！\n",me);
      me->set("family/can_pfm/duo",1);
      return "你学会了“夺命一击”！\n";
      break;
//zhuihun-sword
    case "歌舞阎罗" :
    case "yanluo"  :
       return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"    : "yanluo",
                "name"    : "歌舞阎罗",
                "sk1"     : "zhuihun-sword",
                "lv1"     : 150,
                "sk2"     : "tonsillit",
                "lv2"     : 150,
                "max_force" : 2000,
                "gongxian": 800,]));
       break;
//jueming-stick
    case "阴魂绝" :
    case "jue" :
      if (me->query("family/can_pfm/jue"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("jueming-stick",1) < 100)
        return "你的绝命棒修为不够，暂时无法领悟！\n";
      if (me->query_skill("tonsillit",1) < 100)
        return "你的摄气诀修为不够，暂时无法领悟！\n";
      message_vision("$N点了点头，在$n耳朵边上说了几句。\n",master,me);
      message_vision("$N一怔，不禁心有所悟，点了点头！\n",me);
      me->set("family/can_pfm/jue",1);
      return "你学会了“阴魂绝”！\n";
      break;
//kusang-stick
    case "青面獠牙" :
    case "qmly" :
      if (me->query("family/can_pfm/qmly"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 800)
