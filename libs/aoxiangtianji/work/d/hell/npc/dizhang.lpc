      message_vision("$N点了点头，在$n耳朵边上说了几句。\n",master,me);
      message_vision("$N一怔，不禁心有所悟，点了点头！\n",me);
      me->set("family/can_pfm/qmly",1);
      return "你学会了“青面獠牙”！\n";
      break;

//lunhui-whip
    case "夺魂势" :
    case "duohun" :
      if (me->query("family/can_pfm/duohun"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("lunhui-whip",1) < 80)
        return "你的轮回鞭修为不够，暂时无法领悟！\n";
      if (me->query_skill("tonsillit",1) < 80)
        return "你的摄气诀修为不够，暂时无法领悟！\n";
      message_vision("$N点了点头，在$n耳朵边上说了几句。\n",master,me);
      message_vision("$N一怔，不禁心有所悟，点了点头！\n",me);
      me->set("family/can_pfm/duohun",1);
      return "你学会了“夺魂势”！\n";
      break;
//mingwang-whip
    case "碧落黄泉" :
    case "biluo" :
      if (me->query("family/can_pfm/biluo"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 400)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("mingwang-whip",1) < 100)
        return "你的冥王鞭修为不够，暂时无法领悟！\n";
      if (me->query_skill("tonsillit",1) < 100)
        return "你的摄气诀修为不够，暂时无法领悟！\n";
      message_vision("$N点了点头，在$n耳朵边上说了几句。\n",master,me);
      message_vision("$N一怔，不禁心有所悟，点了点头！\n",me);
      me->set("family/can_pfm/biluo",1);
      return "你学会了“碧落黄泉”！\n";
      break;
//hellfire-whip
    case "神人鬼" :
    case "three" :
       return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"    : "three",
                "name"    : "神·人·鬼",
                "sk1"     : "hellfire-whip",
                "lv1"     : 180,
                "sk2"     : "tonsillit",
                "lv2"     : 180,
                "max_force" : 2500,
                "gongxian": 1000,]));
       break;
//jinghun-zhang
    case "无常抓" :
    case "zhua" :
      if (me->query("family/can_pfm/zhua"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("jinghun-zhang",1) < 100)
        return "你的惊魂掌修为不够，暂时无法领悟！\n";
      if (me->query_skill("tonsillit",1) < 100)
        return "你的摄气诀修为不够，暂时无法领悟！\n";
      message_vision("$N点了点头，在$n耳朵边上说了几句。\n",master,me);
      message_vision("$N一怔，不禁心有所悟，点了点头！\n",me);
      me->set("family/can_pfm/zhua",1);
