#include <ansi.h>
#include "hell.h"
inherit "/d/dntg/hell/wang.lpc";
inherit F_MASTER;
void create()
{
  set_name("幽冥王", ({"youming wang","wang", "master", "youming"}));
  set("long", "身穿大红蟒袍，头戴黑绸软巾．这就是阴山城中的幽冥王．\n");
  set("class", "ghost");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("per", 10);
  set("max_kee", 3800);
  set("max_sen", 3800);
  set("force", 3000);
  set("max_force", 1500);
  set("force_factor", 40);
  set("max_mana", 3000);
  set("mana", 1500);
  set("mana_factor", 75);
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("whip", 200);
  set_skill("tonsillit", 200);
  set_skill("gouhunshu", 200);
  set_skill("ghost-steps", 200);
  set_skill("youming-zhi", 200);
  set_skill("mingwang-whip",200);
  set_skill("hellfire-whip",120);
  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");
  map_skill("dodge", "ghost-steps");
  map_skill("unarmed", "youming-zhi");
  map_skill("parry","mingwang-whip");
  map_skill("whip","mingwang-whip");
  set_temp("apply/armor", 50);
  set_temp("apply/dodge", 50);
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
      (: cast_spell, "gouhun" :),
      (: perform_action, "biluo" :)
  }) );
  create_family("阎罗地府", 2, "黑");
  setup();
  carry_object("/d/obj/armor/cloth/mangpao")->wear();
  carry_object("/d/eastsea/obj/dragonwhip")->wield();
}

int attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ( (string)ob->query("family/family_name") != "阎罗地府")
  {
    message_vision("幽冥王对$N喝道：你是那里来的毛贼，敢跑到宝殿上撒野！与我哄出去！\n", ob);
    message_vision("跑进来两个青面小鬼把$N拖了出去。\n", ob);
    ob->move("/d/hell/gateway");
    return 0;
  }

  if (((int)ob->query("level") < 25 ))
  {
    command("shake");
    command(sprintf("say %s还是先去学些基础功夫吧！\n",RANK_D->query_respect(ob)));
    return 0;
  }

  if (((int)ob->query("dntg/number") < 10 ))
  {
    command("shake");
    command(sprintf("say %s还是先做番大事再来受教吧！\n",RANK_D->query_respect(ob)));
    return 0;
  }

  command("grin");
  message_vision("幽冥王对$N嘿嘿地笑了几声。\n", ob);
  message_vision("幽冥王拍拍$N的肩膀说道：以后在这里多用功，迟早有出头的日子！\n", ob);
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "ghost")
    ob->set("class", "ghost");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "阎罗地府")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我阎罗地府人，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "ghost")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我鬼族，我教的恐怕不能理解。",myname));
    return 1;
  }

  if (((int)me->query("level") <= 25 ))
  {
    command(sprintf("say %s还是先去学些基础功夫吧！\n",myname));
    return 1;
  }

  return 0;
}

