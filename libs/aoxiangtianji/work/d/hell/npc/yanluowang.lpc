#include <ansi.h>
#include "hell.h"
inherit "/d/dntg/hell/wang.lpc";
inherit F_MASTER;
string obstacle_sc();
void create()
{
  set_name("阎罗王", ({"yanluo wang","wang", "master", "yanluo"}));
  set("long", "身穿大红蟒袍，头戴黑绸软巾．面如锅底，须若钢针，这就是阎罗王．\n");
  set("title", "阴间十王");
  set("class", "ghost");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("per", 10);
  set("max_kee", 3800);
  set("max_sen", 3800);
  set("force", 3000);
  set("max_force", 1500);
  set("force_factor", 40);
  set("max_mana", 3000);
  set("mana", 1500);
  set("mana_factor", 75);
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("sword", 200);
  set_skill("stick", 200);
  set_skill("whip", 200);
  set_skill("tonsillit", 200);
  set_skill("gouhunshu", 200);
  set_skill("ghost-steps", 200);
  set_skill("jinghun-zhang", 200);
  set_skill("zhuihun-sword", 200);
  set_skill("kusang-stick",200);
  set_skill("lunhui-whip",200);
  set_skill("medical",200);
  set_skill("hell-yishu",200);
  map_skill("medical","hell-yishu");

  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");
  map_skill("dodge", "ghost-steps");
  map_skill("unarmed", "jinghun-zhang");
  map_skill("parry","lunhui-whip");
  map_skill("whip","lunhui-whip");
  map_skill("sword","zhuihun-sword");
  map_skill("stick","kusang-stick");
  set_temp("apply/armor", 50);
  set_temp("apply/dodge", 50);
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
      (: cast_spell, "gouhun" :),
      (: perform_action, "duohun" :)
  }) );
  set("inquiry", ([
    "name": "哼！连老夫都不认得，想来是活的太久了！\n",
    "here": "这便是阎罗地府，到阳间一谈，嘿嘿，没人不怕！\n",
    "阳间": "人说阴阳殊途，其实不然，阴阳间有五点相交，来去相通！\n",
    "五点": "哈哈，要说知道的人却也不多，那便是年，月，日，时和长安泾水桥！\n",
    "刘父": (: obstacle_sc :),
    "刘伯钦的父亲": (: obstacle_sc :),
  ]) );
  create_family("阎罗地府", 2, "白");
  setup();
  carry_object("/d/obj/armor/cloth/mangpao")->wear();
  carry_object("/d/eastsea/obj/dragonwhip")->wield();
}

string obstacle_sc()
{
  object me = this_player(1);
  int dx,qn;
  if( (string)me->query("obstacle/sc") == "done" )
    return("你不是问过了吗？\n");
  if (me->query("obstacle/number") > 0)
    return "你不是问过一次了吗？\n";
  if( ! me->query_temp("sc/can_ask") )
    return("我不太清楚。\n");
  dx = random(1000);
  dx += 10000;
  qn = dx/3;
  me->set("obstacle/number",1);
  me->set("obstacle/sc","done");
  me->add("daoxing",dx);
  me->add("potential",qn);
  me->add("obstacle/dx",dx);
  me->add("obstacle/qn",qn);
  command("chat "+me->query("name")+"双叉坡灭虎，超度刘父灵魂显功劳！");
  tell_object(me,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed sc on %s\n",
             me->name(1), geteuid(me), ctime(time()) ) );
  me->save();
  return("你顺利的通过了西行取经第一关！\n");
}

int attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ( (string)ob->query("family/family_name") != "阎罗地府")
  {
    message_vision("阎罗王对$N喝道：你是那里来的毛贼，敢跑到宝殿上撒野！与我哄出去！\n", ob);
    message_vision("跑进来两个青面小鬼把$N拖了出去。\n", ob);
    ob->move("/d/hell/gateway");
    return 0;
  }

  if (((int)ob->query("level") < 25 ))
  {
    command("shake");
    command(sprintf("say %s还是先去学些基础功夫吧！\n",RANK_D->query_respect(ob)));
    return 0;
  }

  command("grin");
  message_vision("阎罗王对$N嘿嘿地笑了几声。\n", ob);
  message_vision("阎罗王拍拍$N的肩膀说道：以后在这里多用功，迟早有出头的日子！\n", ob);
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "ghost")
    ob->set("class", "ghost");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "阎罗地府")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我阎罗地府人，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "ghost")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我鬼族，我教的恐怕不能理解。",myname));
    return 1;
  }

  if (((int)me->query("level") <= 25 ))
  {
    command(sprintf("say %s还是先去学些基础功夫吧！\n",myname));
    return 1;
  }

  return 0;
}

int accept_fight(object me)
{
  command("say " + "哈哈！阎王不叫，自己上门！\n");
  command("exert powerup");
  return 1;
}

