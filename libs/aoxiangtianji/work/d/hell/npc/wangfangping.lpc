#include <ansi.h>
#include "hell.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("王方平", ({ "wang fangping", "wang", "fangping" }));
  set("long","王方平本是山中道士，后在丰都山同阴长生同修炼成仙，御封(「鬼王」。\n");
  set("attitude", "peaceful");
  set("per", 30);
  set("str", 25);
  set("int", 25);
  set("age", 30);
  set("title", "轮回司主");
  set("nickname", "鬼王");
  set("combat_exp", 850000);
  set("daoxing", 850000);
  set("max_kee", 1500);
  set("max_sen", 1500);
  set("class", "ghost");
  set("force", 2000);
  set("max_force", 1200);
  set("force_factor", 50);
  set("max_mana", 1200);
  set("mana", 2000);
  set("mana_factor", 40);
  set_skill("literate", 150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("stick", 150);
  set_skill("tonsillit", 150);
  set_skill("gouhunshu", 150);
  set_skill("ghost-steps", 150);
  set_skill("jinghun-zhang", 150);
  set_skill("jueming-stick", 150);
  set_skill("medical",150);
  set_skill("hell-yishu",150);
  map_skill("medical","hell-yishu");
  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");
  map_skill("dodge", "ghost-steps");
  map_skill("unarmed", "jinghun-zhang");
  map_skill("parry","jueming-stick");
  map_skill("stick","jueming-stick");

  create_family("阎罗地府", 3, "白");
  set_temp("apply/dodge", 50);
  set_temp("apply/armor", 50);
  setup();
  carry_object("/d/obj/weapon/stick/wuchangbang")->wield();
  carry_object("/d/obj/armor/cloth/taijicloth")->wear();
}

int attempt_apprentice(object ob)
{
  string my_name;

  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  my_name = RANK_D->query_respect(ob);
  if ( (string)ob->query("family/family_name") !="阎罗地府")
  {
    command("say 你是鬼族吗？\n");
    return 0;
  }

  if (((int)ob->query("level") <= 15 ))
  {
    command("shake");
    command(sprintf("say %s还是先去学些基础功夫吧！\n",my_name));
    return 0;
  }

  command("grin");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",my_name));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "ghost")
    ob->set("class", "ghost");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "阎罗地府")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我阎罗地府人，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "ghost")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我鬼族，我教的恐怕不能理解。",myname));
    return 1;
  }

  if (((int)me->query("level") <= 15 ))
  {
    command(sprintf("say %s还是先去学些基础功夫吧！\n",myname));
    return 1;
  }

  return 0;
}

