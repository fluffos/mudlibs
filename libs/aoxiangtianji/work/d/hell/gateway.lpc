inherit BIGROOM;
inherit MUDDYROOM;
inherit GHOSTROOM;
void create ()
{
  set ("short", "酆都城门");
  set ("long", @LONG
你现在来到一座黑色城楼之前，城楼上刻着三个大字：酆都城。往
北走进城楼只见一片黑漆漆的，只有少许暗红色的火光若隐若现地
闪烁着。
LONG);
  set("exits", ([
    "north" : __DIR__"road1",
  ]));

  setup();
}

void init()
{
  object me = this_player();
  if(me->is_ghost())
    me->move("/d/death/gate");
}