#include <ansi.h>
inherit SMALLROOM;
inherit HILLROOM;
string *duwu = ({
  "/obj/worm/baizuwugong",
  "/obj/worm/changaoxie",
  "/obj/worm/changtuizhu",
  "/obj/worm/datouwugong",
  "/obj/worm/heiguafu",
  "/obj/worm/huabanzhu",
  "/obj/worm/huibeixie",
  "/obj/worm/jinxianwugong",
  "/obj/worm/jiuweixie",
  "/obj/worm/qianjiewugong",
  "/obj/worm/renmianzhu",
  "/obj/worm/shishixie",
  "/obj/worm/tianwu",
  "/obj/worm/tieguxie",
  "/obj/worm/xixuezhu",
});

void create()
{
  set("short", "毒谷");
  set("long", @LONG

山路两边很是荒凉，几乎没有什么花草。不时有些不知名
的小虫从脚底爬过，仔细一看，都是些有毒的东西，不禁让人
毛骨悚然。
LONG);
  set("exits", ([
     "south"    : sprintf(__DIR__"dugu-maze%d",1 + random(4)),
     "north"    : sprintf(__DIR__"dugu-maze%d",1 + random(4)),
     "east"    : sprintf(__DIR__"dugu-maze%d",1 + random(4)),
     "west"    : sprintf(__DIR__"dugu-maze%d",1 + random(4)),
  ]));

  set("objects", ([
     element_of(duwu) : 1,
  ]));

  setup();
}

