#include <ansi.h>
#include "xueshan.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("乌鸦先生", ({"wuya xiansheng", "wuya", "xiansheng"}));
  set("gender", "男性" );
  set("age", 43);
  set("per", 12);
  set("long",
"这位乌鸦先生来自遥远的大雪山。乃是大鹏明王座下有名的高手之一。\n"
"他远看还不错，走近了才发现他长着长长的一张乌鸦嘴。\n");
  set("class", "yaomo");
  set("combat_exp", 80000);
  set("daoxing", 80000);
  set("attitude", "peaceful");
  create_family("大雪山", 4, "弟子");
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("force", 1400);
  set("max_force", 800);
  set("mana", 1400);
  set("max_mana", 700);
  set("force_factor", 40);
  set("mana_factor", 40);
  set("inquiry", ([
    "name" : "问什么问，张着眼睛是看的，长着脑袋是想的。\n",
    "here" : "这就是我们大雪山。\n",
    "怎么去" : "飞过去最快，走也能到。\n",
    "怎么走" : "从这儿往北走。\n",
  ]) );

  set_skill("literate", 90);
  set_skill("force", 90);
  set_skill("spells", 90);
  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("parry", 90);
  set_skill("blade", 90);

  set_skill("ningxue-force", 90);
  set_skill("dengxian-dafa", 90);
  set_skill("xiaoyaoyou", 90);
  set_skill("ningxue-zhang", 90);
  set_skill("xueshan-blade", 90);
  map_skill("force", "ningxue-force");
  map_skill("spells", "dengxian-dafa");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("unarmed", "ningxue-zhang");
  map_skill("blade", "xueshan-blade");
  map_skill("parry", "xueshan-blade");
  setup();
  carry_object("/d/obj/armor/cloth/xueshan-pao")->wear();
  carry_object("/d/obj/armor/armor/tengjia")->wear();
  carry_object("/d/obj/weapon/blade/dandao")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (stringp(myfam))
  {
    if (myfam == "大雪山")
    {
      command("say 不敢当，不敢当！\n");
    }

    return 0;
  }

  command("heihei");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "大雪山")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我雪山弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是妖魔中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  return 0;
}

void init()
{
  add_action("do_answer", "answer");
}

int do_answer(string arg)
{
  object me=this_player();
  string *ans=({"巡山的","过路的","捣乱的",});
  int ans1;
  if( !arg )
    return notify_fail("你说什么？\n");
  if (arg=="0"|| arg=="1"|| arg=="2")
  {
    sscanf(arg,"%d",ans1);
    arg=ans[ans1];
  }

  message_vision("$N答道：" + arg + "。\n", this_player());
  if( (arg== "巡山" || arg== "巡山的") && present("yao pai", this_player()))
  {
    command("look " + me->query("id") );
    command("kick " + me->query("id") );
    command("say 跑哪去啦？大王等你回话都等急了！\n");
    message_vision("乌鸦先生道：快给我进去！\n", me);
    message_vision("只见乌鸦先生嘴里念叨了几句，一脚踢中$N的屁股，$N腾云驾雾般飞了出去．．．\n", me);
    me->move("/d/xueshan/binggu");
    tell_room( environment(me),"天空中$N狠狠的摔了下来，样子有些狼狈。\n",me);
  }

  else if( (arg== "护山" || arg== "护山的") && present("yao pai", this_player()))
  {
    command("look " + me->query("id") );
    command("kick " + me->query("id") );
    command("say 护山的跑这来干嘛？快回去！\n");
    message_vision("只见乌鸦先生嘴里念叨了几句，一脚踢中$N的屁股，$N腾云驾雾般飞了出去．．．\n", me);
    me->move("/d/xueshan/binggu");
    tell_room( environment(me),"天空中$N狠狠的摔了下来，样子有些狼狈。\n",me);
  }

  else if(arg== "守山" || arg== "守山的")
  {
    command("kick " + me->query("id") );
    command("say 即是守山的，就在这给我老老实实呆着吧！\n");
    command("idle " + me->query("id") );
    command("idle");
  }

  else
  {
    command("hehe " + me->query("id") );
    command("say 请吧！\n");
    this_player()->set_temp("to_xueshan", 1);
  }

  return 1;
}