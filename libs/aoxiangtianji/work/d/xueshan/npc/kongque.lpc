#include <ansi.h>
#include "xueshan.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("孔雀明王", ({"kongque mingwang", "kongque", "mingwang", "wang"}));
  set("title", "雪山之祖");
  set("gender", "男性" );
  set("age", 145);
  set("per", 30);
  set("str", 30);
  set("class", "yaomo");
  set("combat_exp", 5000000);
  set("daoxing", 5000000);
  set("attitude", "peaceful");
  create_family("大雪山", 1, "弟子");
  set("rank_info/respect", "明王");
  set("max_kee", 8000);
  set("max_sen", 8000);
  set("force", 7000);
  set("max_force", 4000);
  set("mana", 8000);
  set("max_mana", 4000);
  set("force_factor", 200);
  set("mana_factor", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "spear.fenghuang" :),
    (: cast_spell, "juanbi" :),
    (: cast_spell, "tuntian" :),
  }) );
  set_skill("literate", 300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("spear", 300);
  set_skill("sword", 300);
  set_skill("throwing", 300);
  set_skill("poison",300);
  set_skill("medical",300);
  set_skill("blade",300);

  set_skill("ningxue-force", 300);
  set_skill("dengxian-dafa", 300);
  set_skill("xiaoyaoyou", 300);
  set_skill("ningxue-zhang", 300);
  set_skill("fenghuang-spear", 300);
  set_skill("bingpo-blade",300);
  set_skill("bainiao-sword", 300);
  set_skill("hansha-sheying",300);
  set_skill("xueshan-dushu",300);
  set_skill("xueshan-yaoli",300);
  map_skill("force", "ningxue-force");
  map_skill("spells", "dengxian-dafa");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("unarmed", "ningxue-zhang");
  map_skill("spear", "fenghuang-spear");
  map_skill("parry", "fenghuang-spear");
  map_skill("sword", "bainiao-sword");
  map_skill("blade", "bingpo-blade");
  setup();
  carry_object("/d/obj/armor/cloth/xueshan-pao")->wear();
  carry_object("/d/obj/armor/armor/yinjia")->wear();
  carry_object("/d/obj/weapon/spear/jinqiang")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "大雪山")
  {
    command("say 你是哪儿来的？\n");
    return 0;
  }

  if ((int)ob->query("level") <= 32)
  {
    command("say 你还是找大鹏他们先练着吧。\n");
    return 0;
  }

  if ((int)ob->query("obstacle/number") < 34)
  {
    command("say 你尚未取经圆满，我还不能收你！\n");
    return 0;
  }

  command(":)");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "大雪山")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我雪山弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是妖魔中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 32)
  {
    command("say 你还需要多加磨练，否则听不懂我讲授的！\n");
    return 1;
  }

  if ((int)me->query("obstacle/number") < 34)
  {
    command("say 你取经任务尚未圆满，我可不能收你为徒！\n");
    return 1;
  }

  if (skill == "fenghuang-spear")
  {
    if (!me->query("family/can_learn/fenghuang-spear"))
    {
      command("say 你目前还不可以学习这门技艺！\n");
      return 1;
    }

  }

  return 0;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我大雪山的弟子！\n";

  if (me->query("class") != "yaomo")
    return "嘿嘿，你非妖魔，问我何用？\n";

  if ((int)me->query("obstacle/number") < 34)
    return "你现在问这个干什么？\n";
  switch (topic)
  {
    case "凤凰展翅" :
    case "fenghuang" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "pfm"   : "fenghuang",
           "name"  : "凤凰展翅",
           "sk1"   : "fenghuang-spear",
           "lv1"   : 200,
           "sk2"   : "ningxue-force",
           "lv1"   : 200,
           "max_force" : 3000,
           "gongxian": 1200,]));
      break;
//bainiao-sword
    case "百鸟朝凤" :
    case "chaofeng" :
      if (me->query("family/can_pfm/chaofeng"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 800)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("bainiao-sword",1) < 180)
        return "你的百鸟剑法修为不够，暂时无法领悟！\n";
      if (me->query_skill("ningxue-force",1) < 180)
        return "你的冰谷凝血功修为不够，暂时无法领悟！\n";
      if (me->query_skill("throwing",1) < 180)
        return "你的暗器功夫修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 2500)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/chaofeng",1);
      return "你学会了“百鸟朝凤”！\n";
      break;
  }

  return 0;
}

