#include <ansi.h>
inherit NPC;
string ask_me();
void create()
{
  set_name(HIW"毒郎中"NOR, ({"du langzhong", "langzhong"}));
  set("gender", "男性");
  set("age", 100);
  set("nickname", HIR "炼毒道人" NOR);
  set("attitude", "heroism");
  set("str", 32);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kee", 20000);
  set("max_kee", 20000);
  set("sen", 20000);
  set("max_sen", 1600);
  set("force", 20000);
  set("max_force", 20000);
  set("combat_exp", 10000000);
  set("daoxing", 10000000);
  set("score", 300000);
  set_skill("poison", 300);
  set_skill("literate", 150);
  set_skill("xueshan-dushu",300);
  map_skill("poison","xueshan-dushu");
  set("inquiry", ([
     "炼毒"    : (: ask_me :),
     "学习"    : (: ask_me :),
     "学技"    : (: ask_me :),
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

int accept_object(object me, object ob)
{
  object book;

  if (ob->is_item_make() || ob->query("id") != "du nang")
    return 0;

  me->add_temp("poison/dunang_num",1);
  if (me->query_temp("poison/dunang_num") > 9)
  {
    if (me->query_skill("poison",1) > 50 &&
        me->query_skill("poison",1) < 100)
      book = new("/d/obj/book/dujing2");
    else
      book = new("/d/obj/book/dujing1");
    book->set("owner",me->query("id"));
    book->move(me,1);
    message_vision("$N呵呵一笑，给了$n一本书！\n",this_object(),me);
    return 1;
  }

  if (me->query_temp("poison/dunang_num") > 4)
    me->set_temp("dulangzhong_ok",1);
  return 1;
}

string ask_me()
{
  object who = this_player();

  if (who->query_temp("dulangzhong_ok"))
    return "你直接向我学习就可以了！\n";

  return "炼毒必须的毒囊实在是难得啊！越多越好！\n";
}

int recognize_apprentice(object me, string skill)
{
  if (!me->query_temp("dulangzhong_ok") )
  {
    command("say 我是不轻易传授什么东西的。如果那点我需要的东西，嘿嘿。。。\n");
    return -1;
  }

  if (skill != "poison")
  {
    command("say 我只能教你基本毒术。");
    return -1;
  }

  return 1;
}

