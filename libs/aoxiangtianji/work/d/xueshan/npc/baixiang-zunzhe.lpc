#include <ansi.h>
#include "xueshan.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("白象尊者", ({"baixiang zunzhe", "baixiang", "zunzhe"}));
  set("title", "明王护法");
  set("gender", "男性" );
  set("age", 43);
  set("per", 15);
  set("str", 50);
  set("long", "这位白象尊者是有名的大力士。以前在狮驼山做二大王，\n狮驼山被剿灭后他跟着青狮老魔投奔大鹏明王，做了护法尊者。\n生平最怕的是老鼠，看到尖嘴猴腮的人就讨厌。\n");
  set("class", "yaomo");
  set("combat_exp", 1500000);
  set("daoxing", 1500000);
  set("attitude", "peaceful");
  create_family("大雪山", 2, "弟子");
  set("max_kee", 2000);
  set("max_sen", 2000);
  set("force", 4000);
  set("max_force", 2200);
  set("mana", 4000);
  set("max_mana", 2200);
  set("force_factor", 100);
  set("mana_factor", 110);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "spear.yuncheng" :),
    (: cast_spell, "juanbi" :),
  }) );
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("spear", 200);

  set_skill("ningxue-force", 200);
  set_skill("dengxian-dafa", 200);
  set_skill("xiaoyaoyou", 200);
  set_skill("ningxue-zhang", 200);
  set_skill("pori-spear", 200);
  map_skill("force", "ningxue-force");
  map_skill("spells", "dengxian-dafa");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("unarmed", "ningxue-zhang");
  map_skill("spear", "pori-spear");
  map_skill("parry", "pori-spear");
  setup();
  carry_object("/d/obj/armor/cloth/xueshan-pao")->wear();
  carry_object("/d/obj/armor/armor/yinjia")->wear();
  carry_object("/d/obj/weapon/spear/tiespear")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "大雪山")
  {
    command("say 你是哪儿来的？\n");
    return 0;
  }

  if ((int)ob->query("level") <= 25)
  {
    command("say 你还是找鹦鹉他们先练着吧。\n");
    return 0;
  }

  command(":)");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "大雪山")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我雪山弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是妖魔中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 25)
  {
    command("say 你还需要多加磨练，否则听不懂我讲授的！\n");
    return 1;
  }

  return 0;
}

void init()
{
  object ob=this_player();
  ::init();
  if ( ((string)ob->query("gender")=="男性")
     && ((int)ob->query("str") < 20)
     && (random(3) > 1) )
  {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}

void greeting(object ob)
{
  if( !ob || environment(ob) != environment() )
    return;
  command("kick " + ob->query("id"));
  command("say 尖嘴猴腮！");
  command("laugh");
}