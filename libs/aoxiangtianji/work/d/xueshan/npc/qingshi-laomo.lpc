#include <ansi.h>
#include "xueshan.h"
inherit NPC;
inherit F_MASTER;
string ask_rank();
void create()
{
  set_name("青狮老魔", ({"qingshi laomo", "qingshi", "laomo"}));
  set("title", "明王护法");
  set("gender", "男性" );
  set("age", 63);
  set("per", 18);
  set("long",
"这位青狮老魔原来在狮驼山逍遥，跟大鹏明王颇有交情。\n"
"后来狮驼山被方寸山三星洞的一位得道高人剿灭，\n"
"老魔就投奔大鹏明王做了护法尊者。一个跟和尚有仇，\n"
"一个跟道士有仇，也算是知交好友。\n");
  set("class", "yaomo");
  set("combat_exp", 1500000);
  set("daoxing", 1500000);
  set("attitude", "peaceful");
  create_family("大雪山", 2, "弟子");
  set("max_kee", 2000);
  set("max_sen", 2000);
  set("force", 4000);
  set("max_force", 2200);
  set("mana", 4000);
  set("max_mana", 2200);
  set("force_factor", 100);
  set("mana_factor", 110);
  set("inquiry", ([
   "职位" : (: ask_rank :),
  ]) );
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "blade.kai" :),
    (: cast_spell, "tuntian" :),
  }) );
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("spear", 200);
  set_skill("blade", 200);

  set_skill("ningxue-force", 200);
  set_skill("dengxian-dafa", 200);
  set_skill("xiaoyaoyou", 200);
  set_skill("ningxue-zhang", 200);
  set_skill("zhuiyun-spear", 200);
  set_skill("xueshan-blade", 200);
  map_skill("force", "ningxue-force");
  map_skill("spells", "dengxian-dafa");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("unarmed", "ningxue-zhang");
  map_skill("spear", "zhuiyun-spear");
  map_skill("parry", "xueshan-blade");
  map_skill("blade", "xueshan-blade");
  setup();
  carry_object("/d/obj/armor/cloth/xueshan-pao")->wear();
  carry_object("/d/obj/armor/armor/yinjia")->wear();
  carry_object("/d/obj/weapon/blade/yanblade")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "大雪山")
  {
    command("say 你是哪儿来的？\n");
    return 0;
  }

  if ((int)ob->query("level") <= 25)
  {
    command("say 你还是找鹦鹉他们先练着吧。\n");
    return 0;
  }

  command(":)");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "大雪山")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我雪山弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是妖魔中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 25)
  {
    command("say 你还需要多加磨练，否则听不懂我讲授的！\n");
    return 1;
  }

  return 0;
}

void init()
{
  object ob=this_player();
  ::init();
  if ( ((string)ob->query("gender")=="男性")
     && ((int)ob->query("str") < 20)
     && (random(3) > 1) )
  {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}

void greeting(object ob)
{
  if( !ob || environment(ob) != environment() )
    return;
  command("kick " + ob->query("id"));
  command("say 尖嘴猴腮！");
  command("laugh");
}

string ask_rank()
{
  object master = this_object();
  object who = this_player();
  int t = time();

  if (who->is_busy() || who->is_fighting())
    return "你正忙着呢！\n";

  if (t - (int)who->query("last_ask_rank") < 7200)
    return "你不是刚刚问过了吗？\n";

  if (!RANK_D->re_title(master,who))
    return "你无法从我这里获得称号！\n";

  who->set("last_ask_rank",t);
  who->start_busy(1);
  return sprintf("%s 点了点头！\n",master->name());
}

