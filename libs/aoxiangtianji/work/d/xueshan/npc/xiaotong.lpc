#include <ansi.h>
inherit NPC;
void create()
{
  set_name("小童", ({"xiao tong","tong"}));
  set("class", "yaomo");
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");
  set("per", 10 + random(20));
  set("max_kee", 1800);
  set("max_sen", 1800);
  set("force", 2400);
  set("max_force", 1200);
  set("force_factor", 60);
  set("max_mana", 2400);
  set("mana", 1200);
  set("mana_factor", 75);
  set("combat_exp", 800000);
  set("daoxing", 800000);
  set_skill("force", 120);
  set_skill("spells", 120);
  set_skill("dodge", 120);
  set_skill("unarmed", 120);
  set_skill("parry", 120);
  set_skill("sword", 120);
  set_skill("ningxue-force", 120);
  set_skill("dengxian-dafa", 120);
  set_skill("xiaoyaoyou", 120);
  set_skill("ningxue-zhang", 120);
  set_skill("bainiao-sword",120);
