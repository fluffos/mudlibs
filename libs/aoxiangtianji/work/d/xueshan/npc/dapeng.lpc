#include <ansi.h>
#include "xueshan.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("大鹏明王", ({"dapeng mingwang", "dapeng", "mingwang", "wang"}));
  set("title", "雪山明王");
  set("gender", "男性" );
  set("age", 45);
  set("per", 30);
  set("str", 30);
  set("long",
"这位大鹏明王的确大有来历，说起来跟佛祖如来也有点亲戚关系，\n"
"算是如来的“舅舅”。他不似其兄孔雀明王作恶多端，却也并非善类，\n"
"且因其兄之故跟佛门结下深仇。生平最讨厌的就是和尚。\n");
  set("class", "yaomo");
  set("combat_exp", 2000000);
  set("daoxing", 2000000);
  set("attitude", "peaceful");
  create_family("大雪山", 2, "弟子");
  set("rank_info/respect", "明王");
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 52000);
  set("max_force", 2800);
  set("mana", 5600);
  set("max_mana", 2800);
  set("force_factor", 140);
  set("mana_factor", 140);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "spear.yuncheng" :),
    (: cast_spell, "juanbi" :),
    (: cast_spell, "tuntian" :),
  }) );
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("spear", 200);
  set_skill("throwing",200);
  set_skill("poison",200);
  set_skill("medical",200);

  set_skill("ningxue-force", 200);
  set_skill("dengxian-dafa", 200);
  set_skill("xiaoyaoyou", 200);
  set_skill("ningxue-zhang", 200);
  set_skill("pori-spear", 200);
  set_skill("zhuiyun-spear", 200);
  set_skill("hansha-sheying",200);
  set_skill("xueshan-dushu",200);
  set_skill("xueshan-yaoli",200);
  set_skill("fenghuang-spear",120);
  map_skill("force", "ningxue-force");
  map_skill("spells", "dengxian-dafa");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("unarmed", "ningxue-zhang");
  map_skill("spear", "pori-spear");
  map_skill("parry", "pori-spear");
  map_skill("throwing","hansha-sheying");
  map_skill("poison","xueshan-dushu");
  map_skill("medical","xueshan-yaoli");

  setup();
  carry_object("/d/obj/armor/cloth/xueshan-pao")->wear();
  carry_object("/d/obj/armor/armor/yinjia")->wear();
  carry_object("/d/obj/weapon/spear/jinqiang")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "大雪山")
  {
    command("say 你是哪儿来的？\n");
    return 0;
  }

  if ((int)ob->query("level") <= 25)
  {
    command("say 你还是找鹦鹉他们先练着吧。\n");
    return 0;
  }

  command(":)");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "大雪山")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我雪山弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是妖魔中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 25)
  {
    command("say 你还需要多加磨练，否则听不懂我讲授的！\n");
    return 1;
  }

  return 0;
}

void init()
{
  object ob=this_player();
  ::init();
  if ( ((string)ob->query("gender")=="男性")
    && ((string)ob->query("class")=="bonze")
    && (random(3) > 1) )
  {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}

void greeting(object ob)
{
  if( !ob || environment(ob) != environment() )
    return;

  command("kick " + ob->query("id"));
  command("say 死贼秃！");
  return;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我大雪山的弟子！\n";

  if (me->query("class") != "yaomo")
    return "嘿嘿，你非妖魔，问我何用？\n";

  switch (topic)
  {
    case "历练" :
    case "历炼" :
    case "锻炼" :
      return QUEST_D->accept_ask(master, me, topic);
      break;
//dengxian-dafa
    case "扭转乾坤" :
    case "juanbi" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "cast"   : "juanbi",
           "name"   : "扭转乾坤",
           "sk1"    : "dengxian-dafa",
           "lv1"    : 120,
           "max_mana" : 1500,
           "gongxian": 300,]));
      break;
    case "魔兽吞天" :
    case "tuntian" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "cast"   : "tuntian",
           "name"   : "魔兽吞天",
           "sk1"    : "dengxian-dafa",
           "lv1"    : 150,
           "max_mana" : 2000,
           "gongxian": 300,]));
      break;

    case "天魔解体" :
    case "jieti" :
      if (me->query("family/can_cast/jieti"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 2000)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("dengxian-dafa",1) < 180)
        return "你的登仙大法修为不够，暂时无法领悟！\n";
      if (me->query("max_mana") < 2500)
        return "你的法力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      tell_object(me,"你要记住，用了此招，不是敌死，就是我亡！切记！！\n");
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_cast/jieti",1);
      return "你学会了“天魔解体”！\n";
      break;
//xueshan-blade
    case "冰河开封" :
    case "kai" :
      if (me->query("family/can_pfm/kai"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("xueshan-blade",1) < 100)
        return "你的雪山刀法修为不够，暂时无法领悟！\n";
      if (me->query_skill("ningxue-force",1) < 100)
        return "你的冰谷凝血功修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 1200)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/kai",1);
      return "你学会了“冰河开封”！\n";
      break;
//bingpo-blade
    case "凝血一击" :
    case "ningxue" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "pfm"   : "ningxue",
           "name"   : "凝血一击",
           "sk1"    : "bingpo-blade",
           "lv1"    : 180,
           "sk2"    : "ningxue-force",
           "lv1"    : 180,
           "max_mana" : 2500,
           "gongxian": 800,]));
      break;
//zhuiyun-spear
    case "lieyun" :
    case "裂云矛" :
      if (me->query("family/can_pfm/lieyun"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("zhuiyun-spear",1) < 80)
        return "你的追云枪法修为不够，暂时无法领悟！\n";
      if (me->query_skill("ningxue-force",1) < 80)
        return "你的冰谷凝血功修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 1200)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/lieyun",1);
      return "你学会了“裂云矛”！\n";
      break;
//pori-spear
    case "yuncheng" :
    case "云程万里" :
      if (me->query("family/can_pfm/yuncheng"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("pori-spear",1) < 100)
        return "你的破日枪法修为不够，暂时无法领悟！\n";
      if (me->query_skill("ningxue-force",1) < 100)
        return "你的冰谷凝血功修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 1500)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/yuncheng",1);
      return "你学会了“云程万里”！\n";
      break;
//fenghuang-spear
    case "傲啸云尘" :
    case "xiaoao"  :
      if (me->query("family/can_pfm/xiaoao"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 1200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("fenghuang-spear",1) < 150)
        return "你的破日枪法修为不够，暂时无法领悟！\n";
      if (me->query_skill("ningxue-force",1) < 150)
        return "你的冰谷凝血功修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 2000)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/xiaoao",1);
      return "你学会了“傲啸云尘”！\n";
      break;
  }

  return 0;
}

