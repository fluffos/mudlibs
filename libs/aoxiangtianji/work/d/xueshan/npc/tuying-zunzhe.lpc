#include <ansi.h>
#include "xueshan.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("秃鹰尊者", ({"tuying zunzhe", "tuying", "zunzhe"}));
  set("title", "明王护法");
  set("gender", "男性" );
  set("age", 53);
  set("per", 10);
  set("long", "大鹏明王座下四护法尊者之一。额头高耸，一看就知道功力深厚。\n");
  set("class", "yaomo");
  set("combat_exp", 500000);
  set("daoxing", 500000);
  set("attitude", "peaceful");
  create_family("大雪山", 3, "弟子");
  set("max_kee", 1500);
  set("max_sen", 1500);
  set("force", 3000);
  set("max_force", 1500);
  set("mana", 3000);
  set("max_mana", 1500);
  set("force_factor", 70);
  set("mana_factor", 70);
  set("inquiry", ([
     "name": "嘿嘿！\n",
     "here": "多看少说！\n",
  ]) );

  set_skill("literate", 150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("blade", 150);

  set_skill("ningxue-force", 150);
  set_skill("dengxian-dafa", 150);
  set_skill("xiaoyaoyou", 150);
  set_skill("ningxue-zhang", 150);
  set_skill("xueshan-blade", 150);
  map_skill("force", "ningxue-force");
  map_skill("spells", "dengxian-dafa");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("unarmed", "ningxue-zhang");
  map_skill("blade", "xueshan-blade");
  map_skill("parry", "xueshan-blade");

  setup();
  carry_object("/d/obj/armor/cloth/xueshan-pao")->wear();
  carry_object("/d/obj/armor/armor/tengjia")->wear();
  carry_object("/d/obj/weapon/blade/xueshandao")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "大雪山")
  {
    command("say 你是哪儿来的？\n");
    return 0;
  }

  if ((int)ob->query("level") <= 15)
  {
    command("say 你还是找乌鸦他们先练着吧。\n");
    return 0;
  }

  command(":)");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "大雪山")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我雪山弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是妖魔中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 15)
  {
    command("say 你还需要多加磨练，否则听不懂我讲授的！\n");
    return 1;
  }

  return 0;
}