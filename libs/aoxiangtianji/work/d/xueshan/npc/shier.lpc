inherit NPC;
string *names = ({
  "黄莺侍儿",
  "黄鹂侍儿",
  "黄鹤侍儿",
});
void create()
{
  set_name(element_of(names), ({"shi er", "shier"}));
  set("gender", "女性" );
  set("age", 16);
  set("long", "雪山门下公主侍卫。\n");
  set("class", "yaomo");
  set("combat_exp", 50000);
  set("daoxing", 50000);
  set("attitude", "peaceful");
  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_skill("parry", 60);
  set_skill("blade", 60);
  set_skill("xueshan-blade", 60);
  set_skill("xiaoyaoyou", 60);
  set_skill("force", 60);
  set_skill("ningxue-force", 60);
  map_skill("force", "ningxue-force");
  map_skill("blade", "xueshan-blade");
  map_skill("parry", "xueshan-blade");
  map_skill("dodge", "xiaoyaoyou");
  set("per", 21);
  set("max_kee", 600);
  set("max_sen", 600);
  set("force", 800);
  set("max_force", 500);
  set("force_factor", 20);
  set("mana", 800);
  set("max_mana", 500);
  set("mana_factor", 20);
  setup();
  carry_object("/d/obj/armor/cloth/xueshan-pao")->wear();
  carry_object("/d/obj/armor/armor/tengjia")->wear();
  carry_object("/d/obj/weapon/blade/iceblade")->wield();
}