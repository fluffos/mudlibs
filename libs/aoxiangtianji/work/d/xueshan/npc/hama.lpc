inherit NPC;
void create()
{
  set_name("朱睛冰蟾", ({"bing chan", "hama"}));
  set("race", "野兽");
  set("age", 33);
  set("long", @LONG
一只大蟾蜍，通体雪白，眼珠却血也般红，模样甚是可爱，却也不见有何珍异之处。
LONG);
  set("attitude", "aggressive");
  set("class", "yaomo");
  set("combat_exp", (random(5)*100000+50000));
  set("daoxing", (random(5)*100000+50000));
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
  set("verbs", ({ "bite"}));
  set("kee", 800);
  set("max_kee", 800);
  set("sen", 1200);
  set("max_sen", 800);
  set("force", 1000);
  set("max_force", 1000);
  set("mana", 1000);
  set("max_mana", 500);
  set("force_factor", 30);
  set("mana_factor", 40);
  set("str", 30);
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("ningxue-zhang", random(30)+20);
  set_skill("spells", 100);
  set_skill("dengxian-dafa", random(100)+70);
  set_skill("force", 100);
  set_skill("ningxue-force", random(100)+70);
  map_skill("force", "ningxue-force");
  map_skill("spells", "dengxian-dafa");
  map_skill("unarmed", "ningxue-zhang");
  setup();
}

void unconcious ()
{
  object ob;
  object me = this_object();
  object where = environment (me);
  if (present("/obj/misc/zhujingchan",where))
  {
    destruct (me);
    return;
  }

  ob = new ("/obj/misc/zhujingchan");
  ob->move(where);
  message_vision ("\n$N缩成一团，不再动了。\n",me);
  if (base_name(where) == "/d/xueshan/xihai" )
  {
    where->regen();
  }

  destruct (me);
}

void die ()
{
  unconcious();
}

