#include <ansi.h>
#include "xueshan.h"
inherit NPC;
inherit F_MASTER;
int test_hispai(object ob);
void give_yaopai(object ob);
string give_map(object me);
int do_yes(string arg);
void create()
{
  set_name("神鹰使者", ({"shenying shizhe", "shizhe", "shenying", "eagle"}));
  set("gender", "男性" );
  set("age", 34);
  set("long", "大雪山巡山总督－－神鹰使者，负责四处巡查，八方联络。\n");
  set("class", "yaomo");
  set("combat_exp", 80000);
  set("daoxing", 75000);
  set("attitude", "heroism");
  create_family("大雪山", 4, "弟子");
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("force", 1400);
  set("max_force", 800);
  set("mana", 1400);
  set("max_mana", 700);
  set("force_factor", 40);
  set("mana_factor", 40);
  set("inquiry", ([
    "name" : "在下大雪山神鹰使者，有何贵干？\n",
    "here" : "管它呢！反正比不上我们大雪山。\n",
    "腰牌" : (: test_hispai :),
    "大雪山" : (: give_map :),
  ]) );
  set("no_map", 0);
  set_skill("literate", 90);
  set_skill("force", 90);
  set_skill("spells", 90);
  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("parry", 90);
  set_skill("spear", 90);

  set_skill("ningxue-force", 90);
  set_skill("dengxian-dafa", 90);
  set_skill("xiaoyaoyou", 90);
  set_skill("ningxue-zhang", 90);
  set_skill("zhuiyun-spear", 90);
  map_skill("force", "ningxue-force");
  map_skill("spells", "dengxian-dafa");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("unarmed", "ningxue-zhang");
  map_skill("spear", "zhuiyun-spear");
  map_skill("parry", "zhuiyun-spear");
  setup();
  carry_object("/d/obj/armor/cloth/xueshan-pao")->wear();
  carry_object("/d/obj/armor/armor/tengjia")->wear();
  carry_object("/d/obj/weapon/spear/changqiang")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (stringp(myfam))
  {
    if (myfam == "大雪山")
    {
      command("say 不敢当，不敢当！\n");
    }

    return 0;
  }

  command("heihei");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "大雪山")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我雪山弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是妖魔中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  return 0;
}

int test_hispai(object ob)
{
  ob=this_player();
  if( (! ob->query_temp("get_yaopai") ) && ob->query("family/family_name")=="大雪山")
  {
    give_yaopai(ob);
    return 1;
  }

  return 0;
}

void give_yaopai(object ob)
{
  object yaopai;
  object me=this_object();
  ob=this_player();
  yaopai=new("/d/xueshan/obj/yaopai");
  yaopai->move(me);
  yaopai->set("long","\n
              ＊＊＊＊＊＊＊＊＊＊
              ＊    威镇群魔    ＊
              ＊＊＊＊＊＊＊＊＊＊
                大雪山巡山使者－"+ob->query("name")+"\n");
  command("whisper " + ob->query("id") + " 这是你巡山的腰牌，收好了。");
  command("give yao pai to " + ob->query("id"));
  ob->set_temp("get_yaopai", 1);
  return;
}

string give_map(object me)
{
  me=this_player();
  me->set_temp("need_map", 1);
  return "大雪山，那可是个好地方，你想去吗(yes)？\n";
}

void init()
{
  add_action("do_yes", "yes");
}

int do_yes(string arg)
{
  object me;
  me=this_player();

  if(me->query_temp("need_map"))
  {
    message_vision("$N答道：想去！\n\n", me);
    if( query("no_map") == 0 )
    {
      message_vision("神鹰使者说道：好！那我给你一张地图吧！别让别人抢走了。\n", me);
      me->set_temp("need_map", 0);
      carry_object("/d/obj/misc/xueshan-map");
      command("give xueshan map to " + me->query("id"));
      set("no_map", 1);
      call_out("regenerate", 240);
    }

    else
    {
      message_vision("神鹰使者说道：我本来想给你一张地图的，但是刚才被孙悟空抢走了。\n", me);
    }

    return 1;
  }

  return 0;
}

int regenerate()
{
  set("no_map", 0);
  return 1;
}

