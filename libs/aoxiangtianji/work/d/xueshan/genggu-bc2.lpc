#include <ansi.h>
inherit BIGROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "亘古冰川");
  set ("long", @LONG
这里是茫茫的冰川，亘古的寒冰透着无边的寒意。残阳透着惨白的
笑脸，无奈的躲避到了云层的后面。在山谷的悬崖壁上，赫然有个
巨大的石洞，不知道里面藏着些什么？
LONG);
  set("exits",
  ([
     "south" : __DIR__"genggu-bc1",
     "north" : __DIR__"genggu-bc1",
     "west" : __DIR__"genggu-bc2",
     "east" : __DIR__"genggu-bc2",
     "enter" : __DIR__"bingdong",
  ]));

  set("outdoors", "xuesan");
  setup();
}

void init()
{
  object me;
  int con, damage;
  string msg;
  me = this_player();
  if (!playerp(me))
    return;
  if (me->query_skill("force",1) < 100)
    damage = 400;
  else if (me->query_skill("force",1) < 150)
    damage = 350;
  else if (me->query_skill("force",1) < 200)
    damage = 300;
  else
    damage = 200;
  con = me->query_con();
  con = con / 2 + random(con/2);
  damage -= con + me->query_temp("apply/warm") + query_temp("warm");
  if (damage < 0)
    damage = 0;
  if (damage)
  {
    me->receive_damage("kee",damage);
    me->receive_wound("kee",damage);
    if (damage > 80)
      msg = HIB "一股刺骨的寒风吹过，你只觉得浑身的血液都快被冻住了！\n" NOR;
    else if (damage > 60)
      msg = HIB "一股刺骨的寒风吹过，你只觉得浑身非常僵硬！\n" NOR;
    else if (damage > 40)
      msg = HIB "一股刺骨的寒风吹过，你只觉得冷气透过衣衫钻了进来，浑身没有半点热气！\n" NOR;
    else if (damage > 20)
      msg = HIB "一股刺骨的寒风吹过，你只觉得人都要麻木了！\n" NOR;
    else if (damage > 10)
      msg = HIB "一股刺骨的寒风吹过，你只觉得天气非常的冷！\n" NOR;
    else if (damage > 0)
      msg = HIB "一股刺骨的寒风吹过，你感觉到有点冷！\n" NOR;
    else
      msg = HIC "一股刺骨的寒风吹过，可是你身上还是挺暖和的。\n" NOR;
    if (me->query("kee") < 50 && damage > 10)
      me->apply_condition("ill_dongshang",
         me->query_condition("ill_dongshang") + 5 + damage / 3);
    tell_object(me, msg);
  }

}

int valid_leave(object me, string dir)
{
  object *inv, where;
  int sizeinv ;

  inv = all_inventory(me);
  sizeinv=sizeof(inv);
  while (sizeinv--)
    if (inv[sizeinv]->is_character())
      return notify_fail("你要背个活人去哪儿？\n");
  if (dir != "enter")
    return ::valid_leave(me,dir);

  where = find_object("/d/xueshan/bingdong");
  if (!objectp(where))
    where = load_object("/d/xueshan/bingdong");
  if (!objectp(where))
    return notify_fail("你去不了那个地方了！\n");

  inv = all_inventory(where);
  sizeinv=sizeof(inv);
  while (sizeinv--)
    if (inv[sizeinv]->is_character() && playerp(inv[sizeinv]))
      return notify_fail("好象已经有人在那里了，你暂时无法去！\n");
  return ::valid_leave(me,dir);
}

