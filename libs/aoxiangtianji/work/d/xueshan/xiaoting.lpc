#include <ansi.h>
inherit MIDDLEROOM;
inherit LANDROOM;
void create()
{
  set("short", "小厅");
  set("long", @LONG

小厅里陈设非常简单，几张陈旧的桌椅随意的在小厅摆放。
小厅南面有扇门，门口站立着两个背剑的童子。
LONG);
  set("exits", ([
     "south" : __DIR__"liandu",
     "out"   : __DIR__"xiaowu",
  ]));
  set("objects", ([
     __DIR__"npc/xiaotong" : 2,
  ]));
  setup();
}

int valid_leave(object me,string dir)
{
  object xt = present("xiao tong",this_object());

  if(dir == "south" && (string)me->query("family/family_name")!="大雪山")
    if (objectp(xt))
      return notify_fail("小童喝到，这里不是玩耍的地方，闲人请速速离开！\n");
  return ::valid_leave(me,dir);
}

