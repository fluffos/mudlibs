#include <ansi.h>
inherit BIGROOM;
inherit LANDROOM;
inherit SAFTYROOM;
int do_lianzhi(string arg);
void create()
{
  set("short", "练毒室");
  set("long", @LONG
这里是毒郎中专门的练毒室，可以在这里练制各种毒药，
案上摆着各式各样的器具。屋内正中放着一个一人多高的丹
炉，炉火正旺，有个黑瘦的道人正手持桃木剑绕炉疾走，嘴
里呐呐自语不知在念些什么。
LONG);
  set("exits", ([
     "north" : __DIR__"xiaoting",
  ]));
  set("objects", ([
     __DIR__"npc/dulangzhong": 1,
  ]));
  setup();
}

void init()
{
  add_action("do_lianzhi", "lianzhi");
}

int do_lianzhi (string arg)
{
  object p1, p2, p3, p4, p5, p6, p7;
   object me = this_player();
   int time = 15 + random(15);
/*
   if (me->query("family/family_name") != "大雪山")
     return notify_fail("你不知道该如何下手。\n");
*/
   if (me->query_temp("liandu/xueshan"))
     return notify_fail("你现在正炼着呢，切勿分心。\n");
   if (me->is_busy())
     return notify_fail("你现在正忙着呢。\n");
   if (me->query_skill("poison", 1) < 60 )
     return notify_fail("你的基本毒术不够娴熟，无法炼毒。\n");
   if (me->query("sen") < 80 || me->query("kee") < 80)
     return notify_fail("你现在的精神状况不佳，无法炼毒。\n");
   if (arg != "heding hong" && arg != "furou gao" &&
       arg != "kongque dan" && arg != "chixie fen" &&
       arg != "wusheng san" && arg != "duanchang san")
     return notify_fail("你要炼制什么毒药？\n");
  if (arg == "heding hong")
  {
    p1 = present("du nang", me);
    p2 = present("shexin zi", me);
    p3 = present("qianri zui", me);

    if (!objectp(p1) || p1->is_item_make() || p1->is_character()
     || !objectp(p2) || p2->is_item_make() || p2->is_character()
     || !objectp(p3) || p3->is_item_make() || p3->is_character() )
      return notify_fail("你身上的原料不齐，无法炼毒。\n");
    destruct(p1);
    destruct(p2);
    destruct(p3);
    me->set_temp("liandu/xueshan", "hedinghong");
  }

  else if (arg == "furou gao")
  {
    p1 = present("du nang", me);
    p2 = present("fugu cao", me);
    p3 = present("chuanxin lian", me);

    if (!objectp(p1) || p1->is_item_make() || p1->is_character()
     || !objectp(p2) || p2->is_item_make() || p2->is_character()
     || !objectp(p3) || p3->is_item_make() || p3->is_character() )
      return notify_fail("你身上的原料不齐，无法炼毒。\n");

    destruct(p1);
    destruct(p2);
    destruct(p3);
    me->set_temp("liandu/xueshan", "furougao");
  }

  else if (arg == "kongque dan")
  {
    p1 = present("du nang", me);
    p2 = present("fugu cao", me);
    p3 = present("qianri zui", me);

    if (!objectp(p1) || p1->is_item_make() || p1->is_character()
     || !objectp(p2) || p2->is_item_make() || p2->is_character()
     || !objectp(p3) || p3->is_item_make() || p3->is_character() )
      return notify_fail("你身上的原料不齐，无法炼毒。\n");

    destruct(p1);
    destruct(p2);
    destruct(p3);
    me->set_temp("liandu/xueshan", "kongquedan");
  }

  else if (arg == "chixie fen")
  {
    p1 = present("du nang", me);
    p2 = present("shexin zi", me);
    p3 = present("duanchang cao", me);

    if (!objectp(p1) || p1->is_item_make() || p1->is_character()
     || !objectp(p2) || p2->is_item_make() || p2->is_character()
     || !objectp(p3) || p3->is_item_make() || p3->is_character() )
      return notify_fail("你身上的原料不齐，无法炼毒。\n");

    destruct(p1);
    destruct(p2);
    destruct(p3);
    me->set_temp("liandu/xueshan", "chixiefen");
  }

  else if (arg == "duanchang san")
  {
    p1 = present("du nang", me);
    p2 = present("duanchang cao", me);
    p3 = present("chuanxin lian", me);

    if (!objectp(p1) || p1->is_item_make() || p1->is_character()
     || !objectp(p2) || p2->is_item_make() || p2->is_character()
     || !objectp(p3) || p3->is_item_make() || p3->is_character() )
      return notify_fail("你身上的原料不齐，无法炼毒。\n");

    destruct(p1);
    destruct(p2);
    destruct(p3);
    me->set_temp("liandu/xueshan", "duanchangsan");
  }

  else if (arg == "wusheng san")
  {
    p1 = present("du nang", me);
    p2 = present("heding hong", me);
    p3 = present("duanchang san", me);
    p4 = present("furou gao", me);
    p5 = present("chixie fen", me);
    p6 = present("kongque dan", me);
    p7 = present("jinshe duye", me);

    if (!objectp(p1) || p1->is_item_make() || p1->is_character()
     || !objectp(p2) || p2->is_item_make() || p2->is_character()
     || !objectp(p3) || p3->is_item_make() || p3->is_character()
     || !objectp(p4) || p4->is_item_make() || p4->is_character()
     || !objectp(p5) || p5->is_item_make() || p5->is_character()
     || !objectp(p6) || p6->is_item_make() || p6->is_character()
     || !objectp(p7) || p7->is_item_make() || p7->is_character())
      return notify_fail("你身上的原料不齐，无法炼毒。\n");

    destruct(p1);
    destruct(p2);
    destruct(p3);
    destruct(p4);
    destruct(p5);
    destruct(p6);
    destruct(p7);
    me->set_temp("liandu/xueshan", "wushengsan");
  }

  message_vision (HIR "\n$N" HIR "将身上的药品投入丹炉，按照秘法小心"
                      "炼制起来。\n\n" NOR, me);
  me->start_call_out((: call_other, __FILE__, "liandu", me :), time);
  me->start_busy(time / 2 + 1);
  return 1;
}

void liandu(object me)
{
  object ob;
  int skill, lvl;
  int exp, pot, sco;
  exp = 300 + random(300);
  pot = 100 + random(200);
  sco = 100 + random(100);
  skill = (int)me->query_skill("poison", 1);
  lvl = (int)me->query_skill("poison") + 10;
  if (environment(me) != this_object())
    return;
  me->receive_damage("sen", 50 + random(30));
  me->receive_damage("kee", 50 + random(30));
  if (random(skill) < 50 && random(3) == 1)
  {
    me->delete_temp("liandu/xueshan");
    message_vision(HIR "\n突然间一股腥恶的焦臭至$N" HIR "身旁传"
                       "来，看来是炼毒失败了。\n"NOR,me);
  }

  else
  {
    message_vision(HIW "\n炉顶白雾渐渐转淡，传出阵刺鼻的腥味，$N"
                   HIW "连忙小心翼翼地将药粉取出。\n" NOR, me);
    if (me->query_temp("liandu/xueshan") == "hedinghong")
    {
      ob = new("/obj/poison/hedinghong");
      ob->set("poison", ([
                  "level" : lvl,
                  "id"    : me->query("id"),
                  "name"  : "鹤顶红剧毒",
                  "duration" : 15,
      ]));
      tell_object(me, HIY "你炼成了「" + NOR + ob->name() + NOR + HIY "」。\n" NOR);
    }

    else if (me->query_temp("liandu/xueshan") == "furougao")
    {
      ob = new("/obj/poison/furougao");
      ob->set("poison", ([
                  "level" : lvl,
                  "id"    : me->query("id"),
                  "name"  : "腐肉膏剧毒",
                  "duration" : 15,
      ]));
      tell_object(me, HIY "你炼成了「" + NOR + ob->name() + NOR + HIY "」。\n" NOR);
    }

    else if (me->query_temp("liandu/xueshan") == "kongquedan")
    {
      ob = new("/obj/poison/kongquedan");
      ob->set("poison", ([
                 "level" : lvl,
                 "id"    : me->query("id"),
                 "name"  : "孔雀胆剧毒",
                 "duration" : 15,
      ]));
      tell_object(me, HIY "你炼成了「" + NOR + ob->name() + NOR + HIY "」。\n" NOR);
    }

    else if (me->query_temp("liandu/xueshan") == "chixiefen")
    {
      ob = new("/obj/poison/chixiefen");
      ob->set("poison", ([
                  "level" : lvl,
                  "id"    : me->query("id"),
                  "name"  : "赤蝎粉剧毒",
                  "duration" : 15,
      ]));
      tell_object(me, HIY "你炼成了「" + NOR + ob->name() + NOR + HIY "」。\n" NOR);
    }

    else if (me->query_temp("liandu/xueshan") == "duanchangsan")
    {
      ob = new("/obj/poison/duanchangsan");
      ob->set("poison", ([
                 "level" : lvl,
                 "id"    : me->query("id"),
                 "name"  : "断肠散剧毒",
                 "duration" : 15,
      ]));
      tell_object(me, HIY "你炼成了「" + NOR + ob->name() + NOR + HIY "」。\n" NOR);
    }

    else if (me->query_temp("liandu/xueshan") == "wushengsan")
    {
      ob = new("/obj/poison/wushengsan");
      ob->set("poison", ([
                   "level" : lvl + 20,
                   "id"    : me->query("id"),
                   "name"  : "五圣散剧毒",
                   "duration" : 25,
      ]));
      tell_object(me, HIY "你炼成了剧毒药物「" + NOR
                    + ob->name() + NOR + HIY "」。\n" NOR);
      GIFT_D->delay_bonus(me, ([ "exp"     : exp ,
                                  "pot"     : pot ,
                                  "score"   : sco,
                                  "prompt"  : "炼制毒药成功之后" ]),"liandu");
    }

    ob->move(me);
    me->delete_temp("liandu/xueshan");
    me->improve_skill("poison", 50 + random(me->query_int()));
/*
   if (me->can_improve_skill("xueshan-dushu"))
     me->improve_skill("xueshan-dushu", 50 + me->query("int"));
*/
   tell_object(me, HIC "炼毒过程中你的「基本毒技」和「雪山毒术」提高了！\n\n" NOR);
  }

}

