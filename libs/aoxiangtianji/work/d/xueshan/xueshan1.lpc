inherit BIGROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "茫茫雪峰");
  set ("long", @LONG
北风呼啸，飞雪茫茫，四面望去均是绵延不尽的雪峰。天地之间
似已毫无生迹，除了雪还是雪。
LONG);
  set("exits",
  ([
     "south" : "/d/chengdu/xs-road5",
     "north" : __DIR__"xueshan2",
     "northwest" : __DIR__"shanlu6",
  ]));

  set("outdoors", "xueshan");
  setup();
}

