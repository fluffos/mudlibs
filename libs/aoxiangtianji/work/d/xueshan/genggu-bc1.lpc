inherit BIGROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "亘古冰川");
  set ("long", @LONG
这里是茫茫的冰川，亘古的寒冰透着无边的寒意。残阳透着惨白的
笑脸，无奈的躲避到了云层的后面。放眼都是白茫茫，路在那里？
LONG);
  set("exits",
  ([
     "south" : __DIR__"genggu-bc1",
     "north" : __DIR__"genggu-bc1",
     "west" : __DIR__"genggu-bc2",
     "east" : __DIR__"genggu-bc2",
  ]));

  set("outdoors", "xuesan");
  setup();
}

