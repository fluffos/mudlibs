inherit BIGROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "冰谷口");
  set ("long", @LONG
这里突然出现了一道深谷。向下只能看到一段刀削斧劈似的冰
崖，在往下则是雪雾缭绕，什么也看不清了。谷底下是亘古不
化的冰川，那神秘的冰雪世界也许孕育着神奇。如果想一探究
竟，看来只有从这里跳(jump)了下去。弄个不好，就是粉身碎
骨。
LONG);
  set("item_desc",
    ([ "north" : "冰谷中雪雾缭绕，什么也看不清。\n", ]));
  set("exits",
  ([
     "south" : __DIR__"bingchuan",
     "north" : __DIR__"bingya-up7",
     "west" : __DIR__"bingchuan",
     "east" : __DIR__"bingchuan",
  ]));

  set("outdoors", "xuesan");
  setup();
}

void init()
{
  add_action("do_climb", "climb");
  add_action("do_climb", "pa");
  add_action("do_jump",({"jump","tiao"}));
}

int do_climb(string arg)
{
  object me;
  me=this_player();
  if( !arg || arg != "down" )
    return notify_fail("你要爬到哪里去？\n");
  message_vision("$N手足并用，攀住冰崖向下爬了过去。\n", me);
  me->move(__DIR__"bingya-up7");
  message_vision("$N气喘呼呼地从上面爬了过来。\n", me);
  return 1;
}

int valid_leave(object me, string dir)
{
  if (dir == "north" )
  {
    message_vision("$N不顾一切地往冰崖下一跳．．．\n", me);
    message("vision", "良久，一声杀猪般的惨号从冰崖下传了上来。\n", environment(me), ({ me }));
    call_out("do_unconcious", 0, me);
    return notify_fail("完了．．．\n");
  }

  return ::valid_leave(me, dir);
}

void do_unconcious(object me)
{
  me->move(__DIR__"binggu");
  message_vision("只听一声惨叫，$N死猪般地从冰崖上摔了下来！\n", me);
  me->unconcious();
}

int do_jump(string arg)
{
  object *inv , where;
  object me = this_player(1);

  if (!arg || arg != "down")
  {
    write("你要往哪儿跳？\n");
    return 1;
  }

  if (me->query_temp("is_riding"))
  {
    write("你先下了坐骑吧！\n");
    return 1;
  }

  if (me->query_skill("dodge",1) < 250)
  {
    write("你的轻身功夫不到家，这样跳下去，和寻死无异！\n");
    return 1;
  }

  inv = all_inventory(me);
  inv = filter_array(inv, (: $1->is_character() :));

  if (sizeof(inv) > 0)
  {
    write("这么高的山峰，你背个活人往下跳，看来是不想活了！\n");
    return 1;
  }

  where = find_object("/d/xueshan/genggu-bc1");
  if (!objectp(where))
    where = load_object("/d/xueshan/genggu-bc1");
  if (!objectp(where))
  {
    write("你想往下跳，可惜看来找不对地方！\n");
    return 1;
  }

  inv = all_inventory(where);
  inv = filter_array(inv, (: $1->is_character() &&
                             playerp($1) :));
  if (sizeof(inv) > 0)
  {
    write("下面有人了，这样跳下去，实在是危险啊，砸不死他，也说不定砸死自己！\n");
    return 1;
  }

  message_vision("$N往下看了看，好奇心实在是太大了，决心一探究竟！闭上双眼，不顾一切的往下跳！\n",me);
  me->move(where);
  me->receive_damage("kee",me->query("max_kee")/2);
  me->receive_wound("kee",me->query("max_kee")/2);
  me->receive_damage("sen",me->query("max_sen")/2);
  me->receive_wound("sen",me->query("max_sen")/2);
  message_vision("$N连滚带爬的从上面跌落了下来，真是遍体鳞伤啊！\n",me);
  me->unconcious();
  return 1;
}

