//ghost18.c
#include <ansi.h>
inherit NPC;
string *jjww=({
"若有睡梦见莲华，及以梦见于繖盖",
"或复梦里见月轮，应当获得大利益",
"若有梦见佛形像，诸相具足庄严身",
"众生见者应欢喜，念当必作调御人",
"若此佛刹诸众生，令住信心及持戒",
"若此佛刹诸众生，令住信心于法行",
"若诸佛刹恒河沙，皆悉造寺求福故",
"若有佛刹如恒沙，皆悉遍施诸七宝",
"如铁围山高广大，造塔无量为诸佛",
"若诸众生具满劫，若头若髆常担戴",
"如是人等得胜法，若求菩提利众生",
"彼等众生最胜者，此无比类况有上",
"是故得闻此诸法，智者常生乐法心",
"当得无边大福聚，速得证于无上道"
});
int do_duhua(string arg);
void setup()
{
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaceful");

  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",3500);
  set("force",7000);
  set("max_mana",3500);
  set("mana",7000);
  set_skill("force",200+random(100));
  set_skill("spells",200+random(100));
  set_skill("dodge",200 + random(100));
  set_skill("unarmed",200+random(100));
  set_skill("parry",200+random(100));

  set_skill("tonsillit",200+random(100));
  set_skill("gouhunshu",200+random(100));
  set_skill("ghost-steps",200 + random(100));
  set_skill("jinghun-zhang",200+random(100));
  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");
  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: cast_spell, "gouhun" :),
  }) );

  ::setup();
}

void init()
{
  object ob = this_player();

  if (playerp(ob))
    add_action("do_duhua","duhua");
}

void full_me()
{
  object me = this_object();
  if (!me)
    return;
  me->set("force",2*me->query("max_force"));
  me->set("mana",2*me->query("max_mana"));
  me->set("kee",me->query("max_kee"));
  me->set("sen",me->query("max_sen"));
  me->set("eff_kee",me->query("max_kee"));
  me->set("eff_sen",me->query("max_sen"));
  me->clear_condition(0);
}

int do_duhua(string arg)
{
  mapping duhua_map, my_map, lvl_map;
  string duer,duer_name;
  string con1,con2,con3,msg, msg1,lvl;
  string *name_list;
  object me = this_object();
  object who = this_player(1);

  if (!me->id(arg))
    return notify_fail("你要渡化谁？\n");

  duhua_map = me->query("duhua");
  if (!mapp(duhua_map) || sizeof(duhua_map) < 1)
    return notify_fail("这个。。。无需你渡化！\n");
  lvl = duhua_map["lvl"];
  if (!stringp(lvl))
    return notify_fail("这不知道是哪里的野鬼，无法渡化！\n");

  my_map = who->query("18hell");
  if (mapp(my_map) && sizeof(my_map) > 0)
  {
    lvl_map = my_map[lvl];
    if (mapp(lvl_map) && sizeof(lvl_map) > 0)
    {
      name_list = keys(lvl_map);
      if (member_array(me->query("name"),name_list) != -1)
        return notify_fail("你已经渡化了这个鬼！\n");
    }

  }

  con1 = duhua_map["cond1"];
  if (!stringp(con1))
    return notify_fail("这个鬼无需渡化！\n");
  con2 = duhua_map["cond2"];
  con3 = duhua_map["cond3"];
  msg = HIW"$N" HIW"对$n" HIW"唱和，佛云：" +
        COLOR_D->random_color(2) + element_of(jjww) + NOR +
        HIW" ！\n前世的恶，你如今还不觉醒吗？\n"NOR;
  message_vision(msg,who,me);
  if (!who->query_temp(lvl + "/" + con1))
  {
    duer = (string)who->query_temp("duhua");
    duer_name = (string)who->query_temp("duhua_name");
    if (stringp(duer) && duer == me->query("id"))
    {
      message_vision(HIG"$N" HIG"横了$n" HIG"一眼，我听你罗嗦过了！\n"NOR,me,who);
      return 1;
    }

    else if (stringp(duer))
    {
      message_vision(HIY"$N" HIY"看着$n" HIY"不禁笑了起来，"
                     "你不是正忙着渡化别人吗？怎么打起了我的主意！\n"NOR,me,who);
      tell_object(who,"你现在需要去渡化 " + duer_name + " ！\n");
      return 1;
    }

    who->set_temp("duhua",me->query("id"));
    who->set_temp("duhua_name",me->name());
    msg = HIW + duhua_map["cond1_msg"] + NOR;
    if (!stringp(msg))
      msg = HIW"这世上坏人多了去了，到了这十八层地狱，更是没有“好鬼”！你少来烦我！\n"NOR;
    message_vision("可是$N说道：" + msg,me);
    message_vision("看起来$N一点也不想听$n唠叨！\n",me,who);
    return 1;
  }

  if (stringp(con2) && !who->query_temp(lvl + "/" + con2))
  {
    msg = HIW + duhua_map["cond2_msg"] + NOR;
    if (!stringp(msg))
      msg1 = HIW"你虽然帮了我的忙，但这世上，坏人还是多，我做好人不是很吃亏吗！\n"NOR;
    tell_object(who,msg);
    message_vision("看起来$N不想听$n唠叨了！\n",me,who);
    return 1;
  }

  if (stringp(con3) && !who->query_temp(lvl + "/" + con3))
  {
    msg = HIW + duhua_map["cond3_msg"] + NOR;
    if (!stringp(msg))
      msg1 = HIW"你虽然帮了我的忙，但这世上，坏人还是多，我做好人不是很吃亏吗！\n"NOR;
    tell_object(who,msg);
    message_vision("看起来$N不想听$n唠叨了！\n",me,who);
    return 1;
  }

  msg = HIR + duhua_map["duhua_msg"] + NOR;
  if (!stringp(msg))
    msg = HIR"唉！。。。原来以为这世界上是坏人多，做了好人就要吃亏，看来我错了啊！\n"NOR;
  me->command("say " + msg);
  message_vision(HIY"$N" HIY"听了$n" HIY"的话，不由得很有感触！\n"NOR,me,who);
  message_vision(HIM"$N" HIM"说道：我下辈子一定做好人！\n"NOR,me);
  message_vision(HIW"$N" HIW"泪流满面的走了，看来被$n" HIW"成功的渡化了！\n"NOR,me,who);
  who->set("18hell/" + lvl + "/" + me->query("name"),1);
  who->delete_temp("duhua");
  who->delete_temp("duhua_name");
  destruct(me);
  return 1;
}

