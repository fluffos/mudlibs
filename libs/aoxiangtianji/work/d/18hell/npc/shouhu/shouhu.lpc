#include <ansi.h>
inherit NPC;
void setup()
{
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaful");
  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",4500);
  set("force",9000);
  set("max_mana",4500);
  set("mana",9000);
  set("force_factor",200);
  set("mana_factor",200);
  ::setup();
}

void full_me()
{
  object me = this_object();
  if (!me)
    return;

  me->set("kee",me->query("max_kee"));
  me->set("eff_kee",me->query("max_kee"));
  me->set("sen",me->query("max_sen"));
  me->set("eff_sen",me->query("max_sen"));
  me->set("force",me->query("max_force"))*2;
  me->set("mana",me->query("max_mana"))*2;
  me->clean_condition(0);
  return;
}

void kill_ob (object ob)
{
  full_me();
  set_temp("my_killer",ob);
  command("exert powerup");
  ::kill_ob(ob);
}

void die()
{
  object ob = query_temp("my_killer");
  object me = this_object();

  if (ob &&
      ob == me->query_last_damage_from())
  {
    message_vision ("\n$N哈哈一笑，往空一跳，消失得无影无踪了！\n",me);
    destruct(me);
  }

  else
  {
    full_me();
    message_vision("$N高声吟诵，只觉得浑身又充满了力量！\n");
  }

  return;
}

void unconcious()
{
  die();
}

void scan()
{
  object me = this_object();
  object ob;
  ::scan();
  if (!me || !me->is_fighting())
    return;

  ob = query_temp("my_killer");
  if (!ob ||
      ob != me->query_last_damage_from() ||
      random(8) == 1)
  {
    message_vision("$N高声吟诵道：我大慈大悲的佛主啊，请赐予我无穷的力量！\n",me);
    command("chat 大慈大悲的佛祖，请赐予我力量！\n");
    full_me();
  }

  return;
}

