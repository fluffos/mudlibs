#include <ansi.h>
inherit __DIR__"shouhu";
void create()
{
  set_name(HIW"刀锯地狱守护"NOR,({"18hell shouhu","gui", "ghost"}));
  if (random(2))
    set("gender", "男性" );
  else
    set("gender", "女性" );
  set("age",1000 + random(1000));
  set("long","这是第18层地狱的守护，守护飞升台，以避免凶神恶鬼从此逃亡。\n");

  set_skill("force",300+random(100));
  set_skill("spells",300+random(100));
  set_skill("dodge",300 + random(100));
  set_skill("unarmed",300+random(100));
  set_skill("parry",300+random(100));
  set_skill("blade",300+random(100));

  set_skill("tonsillit",300+random(100));
  set_skill("gouhunshu",300+random(100));
  set_skill("ghost-steps",300 + random(100));
  set_skill("jinghun-zhang",300+random(100));
  set_skill("yange-blade",300+random(100));

  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");
  map_skill("whip","yange-blade");
  map_skill("parry","yange-blade");
  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: perform_action, "blade.dmlr" :),
     (: perform_action, "blade.kou" :),
     (: perform_action, "blade.kuang" :),
     (: cast_spell, "gouhun" :),
  }) );
  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/armor/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/blade/fengdao")->wield();
}

