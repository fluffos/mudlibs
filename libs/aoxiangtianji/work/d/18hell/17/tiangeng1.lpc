#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "田埂");
  set ("long", @LONG

田埂上。两边都是荒芜的农田。

LONG);
  set("exits",
  ([
     "north" : __DIR__"tiangeng2",
     "south" : sprintf(__DIR__"tiangeng%d",1+random(4)),
     "east"  : sprintf(__DIR__"tiangeng%d",1+random(4)),
     "west"  : __DIR__"xiaolu2",
  ]));
  setup();
}

