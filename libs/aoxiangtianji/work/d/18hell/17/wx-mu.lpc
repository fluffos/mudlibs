inherit SMALLROOM;
inherit WOODROOM;
void init()
{
  object me = this_player();

  if (playerp(me))
  {
    message_vision("$N一踏入这片翠绿的山林，只决目摇神迷！\n",me);
    tell_object(me,"你觉得有些迷糊了！\n");
    if (random(3)==1)
      me->apply_condition("ill_fashao",
         me->query_condition("ill_fashao") + 5 + random(50));
    me->receive_damage("sen",(int)me->query("max_sen")/5);
  }

}

