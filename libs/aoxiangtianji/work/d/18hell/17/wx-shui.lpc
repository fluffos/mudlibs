inherit SMALLROOM;
inherit WOODROOM;
void init()
{
  object me = this_player();

  if (playerp(me))
  {
    message_vision("$N一踏入这片淡兰的山林，就被一股寒冷的水汽包围了！\n",me);
    tell_object(me,"你被冻得有些麻木了！\n");
    if (!me->is_busy())
      me->start_busy(1+random(2));
    if (random(3)==1)
      me->apply_condition("ill_dongshang",
         me->query_condition("ill_dongshang") + 5 + random(50));
    me->receive_damage("sen",(int)me->query("max_sen")/5);
  }

}

