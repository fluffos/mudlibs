#include <ansi.h>
inherit __DIR__"wx-jin";
void create ()
{
  set ("short", HIY"山林"NOR);
  set ("long", @LONG

一片金黄的山林。小路变得平坦了很多。

LONG);
  set("exits",
  ([
     "north" : __DIR__"wx-jin2",
     "south" : __DIR__"wx-jin8",
     "east"  : __DIR__"wx-jin6",
     "west"  : __DIR__"wx-jin4",
  ]));
  setup();
}

void init()
{
  object me = this_player();
  ::init();

  if (playerp(me))
    add_action("do_search",({"search","xunzhao"}));
}

int do_search(string arg)
{
  int num;
  object rule, me = this_player();

  if (!arg || (arg != "法尺" && arg != "rule" && arg != "fachi"))
  {
    write("你要寻找什么？\n");
    return 1;
  }

  if (!me->query_temp("18hell/rule_position") ||
      (int)me->query_temp("18hell/rule_position") != 1)
  {
    write("你费了九牛二虎之力，也只能一无所获！\n");
    return 1;
  }

  if (me->is_busy())
  {
    write("你正忙着呢！\n");
    return 1;
  }

  if (me->query("sen") < 400)
  {
    write("你觉得十分疲倦，需要休息一会了！\n");
    return 1;
  }

  num = me->query_temp("18hell/rule_num");
  if (!num)
    message_vision("$N抬头看了看，有低头瞧了瞧，然后开始在地上挖掘寻找起来！\n",me);
  num++;
  if (random(num) > 8)
  {
    message_vision("$N搜寻良久，突然在发现了一把破旧的尺子。\n",me);
    message_vision("$N一把拣了起来，仔细一看，原来是把法尺，上面刻有一些奇怪的图案！\n",me);
    rule = new("/d/18hell/obj/lawrule");
    rule->set("owner",me->query("id"));
    rule->move(me,1);
    me->delete_temp("18hell/rule_num");
    me->delete_temp("18hell/rule_position");
    return 1;
  }

  message_vision("$N仔细在地上搜寻什么，可惜看来一无所获！看来还要继续努力！\n",me);
  num = me->set_temp("18hell/rule_num",num);
  if (!me->is_busy())
    me->start_busy(2+random(2));
  me->receive_damage("sen",80 + random(50));
  return 1;
}

