#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "田埂");
  set ("long", @LONG

田埂上。两边都是荒芜的农田。

LONG);
  set("exits",
  ([
     "north" : sprintf(__DIR__"tiangeng%d",1+random(8)),
     "south" : sprintf(__DIR__"tiangeng%d",1+random(8)),
     "east"  : sprintf(__DIR__"tiangeng%d",1+random(8)),
     "west"  : sprintf(__DIR__"tiangeng%d",1+random(8)),
  ]));
  setup();
}

void init()
{
  object me = this_player();
  object snake;

  if (playerp(me) && me->query_temp("18hell/ask_falsegold"))
  {
    message_vision("\n田埂的草丛中突然窜出一条蛇来，把$N吓了一跳！\n",me);
    snake = new("/d/18hell/17/npc/jinshe");
    snake->move(environment(me));
    snake->kill_ob(me);
    me->delete_temp("18hell/ask_falsegold");
  }

}

