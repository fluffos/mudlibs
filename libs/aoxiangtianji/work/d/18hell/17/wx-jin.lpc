inherit SMALLROOM;
inherit WOODROOM;
void init()
{
  object me = this_player();

  if (playerp(me))
  {
    message_vision("$N一踏入这片金黄的山林，就觉得双耳“嗡”的一阵轰鸣！\n",me);
    tell_object(me,"你觉得反应有些迟钝了！\n");
    if (random(3)==1)
      me->apply_condition("ill_kesou",
         me->query_condition("ill_kesou") + 5 + random(50));
    me->receive_damage("sen",(int)me->query("max_sen")/5);
  }

}

