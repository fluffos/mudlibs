inherit SMALLROOM;
inherit WOODROOM;
void init()
{
  object me = this_player();

  if (playerp(me))
  {
    message_vision("$N一踏入这片红色的山林，只觉得一股热浪扑面而来！\n",me);
    tell_object(me,"你的呼吸都快停顿了！\n");
    if (random(3)==1)
      me->apply_condition("ill_zhongshu",
         me->query_condition("ill_zhongshu") + 5 + random(50));
    me->receive_damage("sen",(int)me->query("max_sen")/5);
  }

}

