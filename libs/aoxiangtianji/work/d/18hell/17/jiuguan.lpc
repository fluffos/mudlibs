#include <ansi.h>
inherit BIGROOM;
inherit LANDROOM;
string look_yizi();
void create ()
{
  set ("short", "小酒馆");
  set ("long", @LONG

这个屋子有几个椅子(yizi)和方桌，几个面目模糊的石磨鬼懒散
的坐在桌边。明天也许就是受难的日子，何不今朝尽情欢乐？

LONG);
  set("exits",
  ([
     "north" : __DIR__"w-shiban2",
     "south" : __DIR__"xiaoyuan",
  ]));
  set("item_desc", ([
    "yizi" : (: look_yizi :),
  ]));
  setup();
}

void init()
{
  object me = this_player();

  if (playerp(me))
  {
    add_action("do_sit",({"sit","zuo","zhuo"}));
    add_action("do_drink","drink");
    tell_object(this_player(), HIW "\n你一走进这小酒馆，就不禁明白了什么是醉生梦死。\n\n" NOR);
  }

}

string look_yizi()
{
  return HIW"一把空的" HIG"椅子" HIW"，看来可以" HIG"坐(sit)" HIW"上去喝一杯。\n";
}

int do_sit(string arg)
{
  object me = this_player();

  if (!arg || (arg != "yizi" && arg != "chair"))
    return notify_fail("你想坐在地上？\n");

  if (me->query_temp("18hell/jiuguan_sit"))
    return notify_fail("你已经坐在了椅子上了！\n");

  message_vision("$N坐在了一把椅子上！看来可以喝(drink)上一杯了！\n",me);
  me->set_temp("18hell/jiuguan_sit",1);
  return 1;
}

int do_drink(string arg)
{
  object me = this_player();
  object ghost;

  if (!me->query_temp("18hell/jiuguan_sit"))
    return notify_fail("这里好象没有人站着喝酒，还是请先坐(sit)下吧！\n");

  message_vision("$N找了个杯子，慢慢的开始喝酒！\n",me);
  if (me->query_temp("18hell/ask_tanzangwine"))
  {
    message_vision("\n时间慢慢的过去了。。。\n$N觉得有些无聊，正准备离开！\n",me);
    ghost = new("/d/18hell/17/npc/zuijiu");
    ghost->move(environment(me));
    message_vision("就在这时，一个酒鬼慢慢的走了过来。\n"
                   "他在$N的对面坐了下来，让$N觉得有了交谈的对象了！\n",me);
  }

  return 1;
}

int valid_leave(object me, string dir)
{
  if (playerp(me) && me->query_temp("18hell/jiuguan_sit"))
  {
    message_vision("$N站了起来，走了出去！\n",me);
    me->delete_temp("18hell/jiuguan_sit");
  }

  return ::valid_leave(me, dir);
}

