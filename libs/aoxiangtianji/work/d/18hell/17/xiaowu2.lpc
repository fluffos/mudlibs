#include <ansi.h>
inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "小屋");
  set ("long", @LONG

一间昏暗的小屋。小屋内没有任何的陈设，泥泞不堪。

LONG);
  set("exits",
  ([
     "north" : __DIR__"w-shiban1",
  ]));
  setup();
}

void init()
{
  object me = this_player();

  if (playerp(me) && !me->query_temp("see_guiwu"))
  {
    message_vision("$N惊疑不定的走了进来，突然看到一个黑黑的身影！\n",me);
    message_vision("那身影慢慢饿一转身，一张血肉模糊，混沌不清的脸对着$N笑了笑！\n",me);
    message_vision("在$N张口结舌，浑身冷汗的时候，那身影却慢慢的淡去了，再凝神看去，却什么都没有！\n",me);
    me->set_temp("see_guiwu",1);
  }

}

