#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "小路");
  set ("long", @LONG

一条小路，路上很是泥泞。再往南下，好象有个小规模的
镇子。

LONG);
  set("exits",
  ([
     "north" : __DIR__"xiaolu2",
     "south" : __DIR__"tulu1",
  ]));
  setup();
}

int valid_leave(object me, string dir)
{
  if (dir == "north" && !playerp(me))
    return 0;
  return ::valid_leave(me, dir);
}

