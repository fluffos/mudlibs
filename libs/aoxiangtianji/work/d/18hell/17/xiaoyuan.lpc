#include <ansi.h>
inherit BIGROOM;
inherit LANDROOM;
string look_well();
void create ()
{
  set ("short", "小院");
  set ("long", @LONG

酒馆后面的小院。在有点吵闹的酒馆后面，竟然有如此一个
安静的小院，还真让人想不到。小院树木不高，但很繁盛。
在藤架下，有一口水井(well)。

LONG);
  set("exits",
  ([
     "north" : __DIR__"jiuguan",
  ]));
  set("item_desc", ([
    "well" : (: look_well :),
  ]));
  set("can_fill",1);
  setup();
}

string look_well()
{
  return HIW"一口很深的水井，看来可以汲(fill)水。\n";
}

