#include <ansi.h>
inherit NPC;
void create()
{
  set_name("农夫鬼",({"nongfu gui","ghost","gui"}));
  if (random(2))
    set("gender", "男性" );
  else
    set("gender", "女性" );
  set("age",100 + random(100));
  set("long","这是个满脸痛苦的农民模样的怪，正在痛苦的呻吟。\n");
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaful");
  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",3500);
  set("force",7000);
  set("max_mana",3500);
  set("mana",7000);
  set_skill("force",280+random(100));
  set_skill("spells",280+random(100));
  set_skill("dodge",280 + random(100));
  set_skill("unarmed",280+random(100));
  set_skill("parry",280+random(100));

  set_skill("tonsillit",280+random(100));
  set_skill("gouhunshu",280+random(100));
  set_skill("ghost-steps",280 + random(100));
  set_skill("jinghun-zhang",280+random(100));

  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "农夫鬼呻吟道：这" HIG"蛇毒" CYN"也太厉害了啊？\n" NOR,
     HIW "农夫鬼哭道：好痛啊，这" HIG"蛇毒" HIW"就没有人来帮我解了吗？！\n" NOR,
     (: random_move :),
  }) );
  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: cast_spell, "gouhun" :),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  object me = this_player();

  if (playerp(me) && !me->query_temp("18hell/see_nongfu"))
  {
    message_vision(HIW"$N" HIW"向$n" HIW"诉苦道：好痛啊，这"
                   HIG"蛇毒" HIW"就没有人来帮我解了吗？！\n",
                   this_object(),this_player());
    me->set_temp("18hell/see_nongfu",1);
  }

}

string accept_ask(object me, string topic)
{
  object gui = this_object();

  if (topic == "蛇毒")
  {
    message_vision("$N哭诉道：我在外边田埂上，发现了一块金子！\n",gui);
    message_vision("$N继续说道：我好高兴啊，以为发财了！\n",gui);
    message_vision("$N一脸的痛苦，说道：现在才明白，贪心是会害了自己的啊！\n",gui);
    message_vision("$N呜呜说道：你知道" HIG"原因"NOR "吗？\n",gui);
    return "你知道为什么？\n";
  }

  if (topic == "为什么" || topic == "原因")
  {
    message_vision("$N恨恨的说道：因为那金子是假的，是条毒蛇变的啊！\n",gui);
    message_vision("$N看$n有点不相信，急忙说道：就在北面的田埂上，多走几次就会发现的！\n",gui,me);
    me->set_temp("18hell/ask_falsegold",1);
    return "不信，你自己去看看！\n";
  }

  return 0;
}

