inherit WORM;
#include <ansi.h>
void create()
{
  set_name(HIY "金蛇" NOR, ({ "gold snake", "snake"}));
  set("long", HIY "这是一只小小的金蛇。\n" NOR);
  set("race", "野兽");
  set("age", 5 + random(10));
  set("attitude", "peaceful");
  set("max_kee", 3000);
  set("max_sen", 3000);
  set("str", 30);
  set("con", 30);
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));
  set("worm_poison", ([
         "level"  : 300,
         "perhit" : 20,
         "remain" : 60,
         "maximum": 60,
         "supply" : 1,
  ]));
  set("combat_exp", 2000000 + random(1000000));
  set("daoxing", 2000000 + random(1000000));
  set_temp("apply/attack", 300 + random(300));
  set_temp("apply/damage", 200 + random(200));
  set_temp("apply/armor", 200 + random(200));
  set_temp("apply/defence", 300 + random(300));
  setup();
}

void die()
{
  object ob;
  object dob;

  dob = query_last_damage_from();
  if (objectp(dob))
  {
    message_vision(HIR "\n$N" HIR "身子蜷缩了起来，看上去真象块金子。\n\n" NOR, this_object());
    ob = new("/d/18hell/obj/falsegold");
    ob->set("owner",dob->query("id"));
    ob->move(environment(this_object()));
  }

  destruct(this_object());
}

