#include <ansi.h>
inherit NPC;
void create()
{
  set_name("醉酒鬼",({"zuijiu gui","gui","ghost"}));
  set("gender", "男性" );
  set("age",100 + random(100));
  set("long","这是个酩酊大醉的鬼，可是他的眼神却始终很亮。\n");
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaful");
  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",3500);
  set("force",7000);
  set("max_mana",3500);
  set("mana",7000);
  set_skill("force",280+random(100));
  set_skill("spells",280+random(100));
  set_skill("dodge",280 + random(100));
  set_skill("unarmed",280+random(100));
  set_skill("parry",280+random(100));

  set_skill("tonsillit",280+random(100));
  set_skill("gouhunshu",280+random(100));
  set_skill("ghost-steps",280 + random(100));
  set_skill("jinghun-zhang",280+random(100));

  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "醉酒鬼喃喃道：谁想" HIG"洗澡" CYN"？给自己的心和肺" HIG"洗澡" CYN"！\n" NOR,
     HIW "醉酒鬼含糊不清的嘟哝：喝了"HIG"我的酒"HIW"啊，前生的错误都看清，喝了"
     HIG"我的酒"HIW"啊，不用阎王来审判！\n" NOR,
  }) );
  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: cast_spell, "gouhun" :),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

string accept_ask(object me, string topic)
{
  object jiutan;
  object gui = this_object();

  if (topic == "悔过酒坛" || topic == "洗澡" || topic == "我的酒")
  {
    message_vision("$N哈哈大笑，好，好，你不是洗自己，就是洗别人！\n",gui);
    jiutan = new("d/18hell/obj/huiguo-jiutan");
    jiutan->set("owner",me->query("id"));
    jiutan->move(me,1);
    call_out("destruct_me",2);
    tell_object(me,"你得到了一个酒坛！\n");
    return "你拿去吧！别忘记了把“酒”给装满！\n";
  }

  return 0;
}

void destruct_me()
{
  string msg;
  object me = this_object();
  if (objectp(me))
  {
    msg = "$N拍手唱道：\n\t是谁创造这游戏？\n";
    msg += "\t\t在这鬼魂世界里！\n";
    msg += "\t\t\t想不清前世的错！\n";
    msg += "\t\t\t\t要用阎罗来审判你！\n";
    msg += "唱罢，哈哈大笑，拍了拍手，转身就走，消散在屋外的迷梦气氛中了！\n";
    message_vision(msg,me);
    destruct(me);
  }

}

