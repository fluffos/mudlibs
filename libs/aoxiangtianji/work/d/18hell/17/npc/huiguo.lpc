#include <ansi.h>
inherit NPC;
void create()
{
  set_name(HIM"改过鬼"NOR,({"gaiguo gui","ghost","gui"}));
  if (random(2))
    set("gender", "男性" );
  else
    set("gender", "女性" );
  set("age",100 + random(100));
  set("long","这是个一脸沉痛的鬼，好象随时都在忏悔似的。\n");
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaful");
  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",3500);
  set("force",7000);
  set("max_mana",3500);
  set("mana",7000);
  set_skill("force",280+random(100));
  set_skill("spells",280+random(100));
  set_skill("dodge",280 + random(100));
  set_skill("unarmed",280+random(100));
  set_skill("parry",280+random(100));

  set_skill("tonsillit",280+random(100));
  set_skill("gouhunshu",280+random(100));
  set_skill("ghost-steps",280 + random(100));
  set_skill("jinghun-zhang",280+random(100));

  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "改过鬼喃喃道：我做了" HIG"坏事" CYN"。。。我做了坏事！\n" NOR,
     HIW "改过鬼哭道：我做了" HIG"坏事" HIW"啊！我心里不好受！\n" NOR,
     (: random_move :),
  }) );
  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: cast_spell, "gouhun" :),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  object me = this_player();

  if (playerp(me) && !me->query_temp("18hell/see_huiguogui"))
  {
    message_vision(HIW"$N" HIW"看了$n" HIW"一眼，喃喃说道：我前世做了"
                   HIG"坏事" HIW"，你知道我正在忏悔吗？！\n",
                   this_object(),this_player());
    me->set_temp("18hell/see_huiguogui",1);
  }

}

string accept_ask(object me, string topic)
{
  string msg;
  object gui = this_object();

  if (topic == "坏事" ||
      topic == "不好受" ||
      topic == "忏悔" ||
      topic == "改过" ||
      topic == "悔过")
  {
    message_vision("$N叹道：我前辈子做了很多坏事，一下子就都明白了！\n",gui);
    message_vision("$N现在我很后悔啊！\n",gui);
    message_vision("$N哭到：我吐了很多" HIG"脏东西"NOR "，那都是我前世的错啊！\n",gui);
    message_vision("$N呜呜说道：你知道我是怎么" HIG"明白"NOR "过来的吗？\n",gui);
    return "有时候明白了，才会知道自己的错！\n";
  }

  if (topic == "明白" || topic == "脏东西")
  {
    msg = "$N说：我做了鬼都不觉得自己有什么错！\n";
    msg += "总觉得这世界你不害人，人就来害你！\n";
    msg += "$N回想到：我每天都喝酒，那天我碰到了一个喝醉的酒鬼，他给了我一个空酒坛！\n";
    msg += "那个酒鬼说，即使是水，装到了这酒坛中，也会变成美酒！\n";
    msg += "我当然不信，他就把酒坛给了我！\n";
    msg += "$N继续回想道：我拿着这酒坛就到酒馆后的水井中装上了酒！\n";
    msg += "天啊，那水到了我的酒坛中，变成了无比醇香的美酒！\n";
    msg += "我又是吃惊，又是高兴，那酒真的醇香无比，我几乎是马上就开始痛饮起来！\n";
    msg += "唉，没有想到的是，那酒喝到肚子里，痛得我满地打滚，然后就吐了无数的黑东西！\n";
    msg += "那酒鬼呵呵笑道：你前世的肮脏都吐了出来了，你心里就明白了！\n";
    msg += "原来那酒坛，据说是叫做“"HIG"悔过酒坛”"NOR "！\n";
    msg += "我真的明白了，前世的冤孽清楚的让我记得，我真是后悔啊！\n";
    message_vision(msg,gui);
    me->set_temp("18hell/ask_tanzangwine",1);
    return "做人，不要造孽啊！\n";
  }

  return 0;
}

