//ghost18.c
#include <ansi.h>
inherit "/d/18hell/npc/du_ghost";
string ask_quantou();
void create()
{
  set_name(HIG"盗贼鬼"NOR,({"daozei gui","gui","ghost"}));
  set("gender", "男性" );
  set("age",10 + random(100));
  set("long",
"这是个满脸横肉的鬼，气势汹汹的。\n");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "盗贼鬼恶狠狠的盯了你一眼。\n" NOR,
     HIW "盗贼鬼嚷嚷道：把钱都拿出来？\n" NOR,
     CYN "盗贼鬼大喊道，老子今天要抢钱了。\n" NOR,
     (: random_move :),
  }) );
  set("duhua",([
     "lvl" : "hell-17",
     "cond1" : "daozeigui1",
     "cond2" : "daozeigui2",
     "cond1_msg" : "这世道是拳头大的说话！\n",
     "cond2_msg" : "我不欺负别人，别人就要来欺负我，那个绿毛恶鬼总想着要杀我啊！\n",
     "duhua_msg" : "罢了，罢了，我还是听你的！\n",
  ]));
  set("inquiry", ([
    "拳头" : (: ask_quantou :),
    "绿毛恶鬼" : "那个西面荒草地藏着的绿毛恶鬼，整天想着来杀我！\n",
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  ::init();
  add_action("do_answer",({"answer","huida"}));
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_cast", ({"cast","perform"}));
}

string ask_quantou()
{
  object me = this_object();
  object who = this_player();

  if (!playerp(who))
    return "一边去。。。\n";

  message_vision("$N嘿嘿一阵冷笑，拳头就是比比谁的拳头更加硬！\n",me);
  who->set_temp("18hell/quantou",1);
  return "你愿意试试吗？answer Y or N \n";
}

int do_answer(string arg)
{
  string duer;
  object weapon;
  object me = this_object();
  object who = this_player();

  if (!playerp(who))
    return 0;
  if (!living(me))
    return notify_fail("他现在什么都听不见！\n");

  if (!arg || (arg != "Y" && arg != "N"))
  {
    write("你要回答什么？\n");
    return 0;
  }

  if (!who->query_temp("18hell/quantou"))
  {
    write("看来他并不愿意和你比试！你必须先征求他的意见！\n");
    return 0;
  }

  weapon = who->query_temp("weapon");
  if (objectp("weapon"))
  {
    write("他要和你比拳头，你拿着武器能行吗？\n");
    return 0;
  }

  duer = (string)who->query_temp("duhua");
  if (!stringp(duer) || duer != me->query("id"))
    return notify_fail("你还是赶紧去忙自己的事情吧！\n");
  if (who->query_temp("hell-17/daozeigui1"))
    return notify_fail("他已经领教过了！\n");
  if (arg == "N")
  {
    write("嘿嘿，算你知道厉害！\n");
    return 1;
  }

  NPC_D->set_from_me(me,who,105+random(10));
  message_vision("$N大声说道，那就来领教领教高招吧！\n",who);
  who->set_temp("18hell/quantou-fight",1);
  return 1;
}

int accept_fight(object who)
{
  string duer;
  object me;
  me = this_object();
  duer = (string)who->query_temp("duhua");
  if (!stringp(duer) || duer != me->query("id"))
    return notify_fail("你还是赶紧去忙自己的事情吧！\n");
  if (who->query_temp("hell-17/daozeigui1"))
    return notify_fail("他已经领教过了！\n");

  if (! who->query_temp("18hell/quantou-fight"))
    return 0;
  remove_call_out("check_fight");
  call_out("check_fight", 1, me, who);
  return 1;
}

void player_win (object me, object who)
{
  object weapon;
  if (!me || !who || environment(me) != environment(who))
    return;
  me->remove_all_enemy();
  who->remove_all_enemy();
  weapon = who->query_temp("weapon");
  if (objectp(weapon))
  {
    message_vision("$N狠狠的说道，你拿兵器打赢我，算什么好汉？\n",me);
    return;
  }

  if (!who->query_temp("18hell/quantou-fight"))
  {
    message_vision("$N冷笑了几声，说道：佩服，佩服！\n",me);
    return;
  }

  if (!who->query_temp("hell-17/daozeigui1"))
    who->set_temp("hell-17/daozeigui1",1);

  me->command("say 今日才知道天外有天啊。\n");
  me->command("say 如此厉害，我实在是心服口服了！\n");
}

void player_lose (object me, object who)
{
  if (!me || !who || environment(me) != environment(who))
    return;
  me->remove_all_enemy();
  who->remove_all_enemy();

  me->command("say 我以为你有什么三头六臂的本事呢！\n");
  me->command("say 你还是先练练武功，再来练嘴皮子吧。\n");
  who->delete_temp("18hell/quantou-fight");
  who->delete_temp("duhua");
}

void check_fight (object me, object who)
{
  object weapon;
  int my_kee, whos_kee;
  int my_max_kee, whos_max_kee;
  if (!me || !who || environment(me) != environment(who))
    return;
  if (me->is_fighting())
  {
    weapon = who->query_temp("weapon");
    if (objectp(weapon))
    {
      message_vision("$N嚷嚷道，你拿武器耍赖啊！不打了！\n",me);
      me->remove_all_enemy();
      who->remove_all_enemy();
      who->delete_temp("18hell/quantou-fight");
      who->delete_temp("duhua");
      return;
    }

    if (random(6) == 1)
    {
      message_vision("$N大声嚷嚷道：鬼神是会保佑我的，哈哈！\n",me);
      message_vision("一道惨白的光束围绕$N，慢慢的消散到了$N身体里！\n",me);
      me->full_me();
    }

    call_out ("check_fight",1,me,who);
    return;
  }

  if (me->query_temp("last_opponent") != who)
    return;

  if (me->query_last_damage_from() != who)
    return;

  if (!present(who, environment(me)))
    return;
  my_kee = me->query("kee");
  whos_kee = who->query("kee");
  my_max_kee = me->query("max_kee");
  whos_max_kee = who->query("max_kee");
  if ((my_kee*100/my_max_kee) <= 40)
    player_win (me, who);
  else if ((whos_kee*100/whos_max_kee) <= 40)
    player_lose (me, who);
  return;
}

int do_fight(string arg)
{
  object who;
  object me;
  who = this_player();
  me = this_object();
  if (me->is_fighting())
  {
    message_vision ("$N对$n摇摇头：一个一个地来，不要一拥而上！\n",me,who);
    return 1;
  }

  if (!who->query_temp("hell-17/daozeigui1") &&
      who->query_temp("18hell/quantou-fight"))
  {
    full_me();
    return 0;
  }

  message_vision ("$N对$n摇摇头：不想和你打架！\n",me,who);
  return 1;
}

int do_cast(string arg)
{
  object who;
  object me=this_object();
  who = this_player();
  message_vision ("$N对$n喝道：你要干什么！\n",me,who);
  message_vision ("$N吓得不敢乱动了。\n",who);
  return 1;
}

int do_steal(string arg)
{
  object who;
  object me=this_object();
  who = this_player();
  message_vision ("$N突然对$n喝道：好你这个小偷，住手！\n",me,who);
  message_vision ("$N吓得将手缩了回去。\n",who);
  return 1;
}

int do_kill(string arg)
{
  object who;
  object me=this_object();
  who = this_player();
  if(!arg || present(arg,environment(me))!=me) return 0;
  message_vision ("$N对$n喝道：你好大的胆！\n",me,who);
  message_vision ("$N一下子吓得瘫倒在地。\n",who);
  return 1;
}

