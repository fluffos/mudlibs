#include <ansi.h>
inherit NPC;
int do_answer(string arg);
void create()
{
  set_name(HIW"含冤鬼"NOR,({"hanyuan gui","ghost","gui"}));
  if (random(2))
    set("gender", "男性" );
  else
    set("gender", "女性" );
  set("age",100 + random(100));
  set("long","这是个满脸义愤的鬼，衣履破烂。\n");
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaful");
  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",3500);
  set("force",7000);
  set("max_mana",3500);
  set("mana",7000);
  set_skill("force",280+random(100));
  set_skill("spells",280+random(100));
  set_skill("dodge",280 + random(100));
  set_skill("unarmed",280+random(100));
  set_skill("parry",280+random(100));

  set_skill("tonsillit",280+random(100));
  set_skill("gouhunshu",280+random(100));
  set_skill("ghost-steps",280 + random(100));
  set_skill("jinghun-zhang",280+random(100));

  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "含冤鬼喊道：难道就真的没有" HIG"天理" CYN"了吗？\n" NOR,
     HIW "含冤鬼悲愤的说道：这" HIG"天理" HIW"何在啊？！\n" NOR,
     (: random_move :),
  }) );
  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: cast_spell, "gouhun" :),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  object me = this_player();

  add_action("do_answer",({"answer","huida"}));
  if (playerp(me) && !me->query_temp("18hell/see_hanyuangui"))
  {
    message_vision(HIW"$N" HIW"向$n" HIW"喊道：你说这"
                   HIG"天理" HIW"就不在了吗？！\n",
                   this_object(),this_player());
    me->set_temp("18hell/see_hanyuangui",1);
  }

}

string accept_ask(object me, string topic)
{
  object gui = this_object();

  if (topic == "天理" || topic == "冤屈" || topic == "冤枉")
  {
    message_vision("$N恨恨的说道：你说做人不相信天理，这鬼怎么也不相信呢？\n",gui);
    message_vision("$N一脸愤怒的抬起头来，这天理无处不在啊，你相信吗？\n",gui);
    me->set_temp("18hell/ask_yuanqu",1);
    return "如果你相信，就回答：answer 相信\n";
  }

  return 0;
}

int do_answer(string arg)
{
  object me = this_object();
  object who = this_player();

  if (!who->query_temp("18hell/ask_yuanqu"))
    return 0;

  if (!arg)
    return 0;

  if (arg != "相信")
  {
    message_vision("$N疑惑的看了看$n，说道，我才不相信你说的呢！\n",who,me);
    who->delete_temp("18hell/ask_yuanqu");
    message_vision("$N长叹了一声。。。\n",me);
    return 1;
  }

  message_vision("$N挺胸说道，我当然相信天理了！\n",who);
  message_vision("$N大声说道：$n你有什么冤屈，尽管告诉我！\n",who,me);
  who->delete_temp("18hell/ask_yuanqu");
  call_out("say_more1",1,me,who);
  return 1;
}

void say_more1(object me, object who)
{
  if (!me || !who)
    return;

  if (!environment(me) || !environment(who) || environment(me) != environment(who))
    return;

  message_vision("$N长叹一声，抬起了头，竟然是满脸的泪水！\n",me);
  message_vision("$N说道：我前世含冤，现在做了鬼，说多了有什么意思呢？\n",me);
  message_vision("$N继续道：只是我。。。我想让人明白，这阳世阴间，天理无处不在啊！\n",me);
  call_out("say_more2",1,me,who);
  return;
}

void say_more2(object me, object who)
{
  int i;

  if (!me || !who)
    return;

  if (!environment(me) || !environment(who) || environment(me) != environment(who))
    return;

  message_vision("$N深深的看了$n一眼，叹了口气！\n",me,who);
  message_vision("$N想了想，对$n说道：看你一身本事，也许可以找到这“天理”何在了！\n",me,who);
  i = 1 + random(5);
  switch(i)
  {
    case 1:
      tell_object(who,CYN"有把" HIG"法尺" CYN"在山林的“金”处，金乃" YEL"黄色"
                      CYN"，你可以前往寻找(search)！\n"NOR);
      break;
    case 2 :
      tell_object(who,CYN"有把" HIG"法尺" CYN"在山林的“木”处，木乃" GRN"绿色"
                      CYN"，你可以前往寻找(search)！\n"NOR);
      break;
    case 3 :
      tell_object(who,CYN"有把" HIG"法尺" CYN"在山林的“水”处，水乃"BLU"兰色"
                      CYN"，你可以前往寻找(search)！\n"NOR);
      break;
    case 4 :
      tell_object(who,CYN"有把" HIG"法尺" CYN"在山林的“火”处，火乃" RED"红色"
                      CYN"，你可以前往寻找(search)！\n"NOR);
      break;
    default :
      tell_object(who,CYN"有把" HIG"法尺" CYN"在山林的“土”处，土乃" WHT"白色"
                      CYN"，你可以前往寻找(search)！\n"NOR);
      break;
  }

  who->set_temp("18hell/rule_position",i);
  message_vision("$N在$n的耳朵边上说了些什么！\n",me,who);
  message_vision("$N喃喃说道：心愿了了，走了！\n",me);
  destruct(me);
  return;
}

