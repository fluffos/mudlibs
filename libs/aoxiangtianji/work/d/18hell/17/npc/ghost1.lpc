//ghost18.c
#include <ansi.h>
inherit "/d/18hell/npc/du_ghost";
string ask_yuma();
void create()
{
  set_name(HIG"贪赃鬼"NOR,({"tanzang gui","gui","ghost"}));
  set("gender", "男性" );
  set("age",10 + random(100));
  set("long",
"这是个一脸严肃的鬼，别看他一本正经，其实贪赃枉法，最喜欢欺压百姓了。\n");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "贪赃鬼装模做样的咳嗽了一声。\n" NOR,
     HIW "贪赃鬼狠狠的看了你一眼，有什么上供的吗？\n" NOR,
     CYN "贪赃鬼迈开方步来回踱了几下，嘿嘿的笑道，今天有人来送银子了。\n" NOR,
     HIW "贪赃鬼叹了口气，狠狠的挥了挥手，不给银子，打死你。\n" NOR,
     (: random_move :),
  }) );
  set("duhua",([
     "lvl" : "hell-17",
     "cond1" : "tanzanggui1",
     "cond2" : "tanzanggui2",
     "cond3" : "tanzanggui3",
     "cond1_msg" : "奶奶的，做了鬼，送金子的都没有了？\n",
     "cond2_msg" : "老子就是王法，什么天理，清正廉明，都是狗屁！\n",
     "cond3_msg" : "这当官的不贪赃，做官有什么乐趣啊？\n",
     "duhua_msg" : "唉，直到今日，才直到这贪赃枉法是毒酒，是损阴德的，是害人更害己啊！\n",
  ]));
  set("inquiry", ([
    "金子" : "黄澄澄的金子啊，我的最爱。。。\n",
    "天理" : "骗你的，打死你，我都不相信！\n",
    "清正廉明" : "骗你的，打死你，我都不相信！\n",
    "贪赃" : "这贪墨啊，如同喝酒，真上了瘾，越贪越有意思，真他奶奶的有意思！\n",
    "喝酒" : "那香醇的美酒啊。。。越喝越有味！\n",
    "玉马" : (: ask_yuma :),
  ]));
  set("yuma",1);
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

int accept_object(object who, object ob)
{
  string duer;
  object me = this_object();
  duer = (string)who->query_temp("duhua");
  if (!stringp(duer) || duer != me->query("id"))
    return 0;

  if (ob->query("id") != "18hell false gold" &&
      ob->query("id") != "18hell law rule" &&
      ob->query("id") != "18hell tanzang wine")
  {
    command("grin");
    message_vision("$N冷笑了一声，有什么用？\n",me);
    return 0;
  }

  if (ob->query("owner") != who->query("id"))
  {
    command("不是自己找到的，我要干吗？\n");
    return 0;
  }

  if (ob->query("id") == "18hell false gold")
  {
    if (who->query_temp("hell-17/tanzanggui1"))
    {
      message_vision("$N嘿嘿笑道，又想来害我啊。。。\n",me);
      return 1;
    }

    message_vision("$N眉开眼笑的说道：金子啊，给我了吗？\n",me);
    message_vision("$N一把就把抢了过去，赶紧揣在了怀中！\n",me);
    call_out("give_gold",1,me,who);
    return 1;
  }

  if (ob->query("id") == "18hell law rule")
  {
    if (!who->query_temp("hell-17/tanzanggui1"))
    {
      message_vision("$N冷笑数声，你想拿这个来吓唬我啊！\n",me);
      command("kick " + who->query("id"));
      return 0;
    }

    if (who->query_temp("hell-17/tanzanggui2"))
    {
      message_vision("$N傻笑道，你也用不着反复来提醒我吧！\n",me);
      command("heng " + who->query("id"));
      return 0;
    }

    message_vision("$N愣呆呆的接了过去，这。。。这。。。\n",me);
    call_out("give_rule",1,me,who);
    return 1;
  }

  if (ob->query("id") == "18hell tanzang wine")
  {
    if (!who->query_temp("hell-17/tanzanggui1") ||
        !who->query_temp("hell-17/tanzanggui2"))
    {
      message_vision("$N哈哈笑道，你真乖啊！\n",me);
      command("kiss " + who->query("id"));
      message_vision("$N毫不客气的把美酒接受了！\n",me);
      return 1;
    }

    if (who->query_temp("hell-17/tanzanggui3"))
    {
      message_vision("$N笑道，又来了！\n",me);
      command("pei " + who->query("id"));
      return 0;
    }

    message_vision("$N大喜，一把把美酒接过！\n",me);
    call_out("give_wine",1,me,who);
    return 1;
  }

  message_vision("$N一脸疑惑的说道：什么玩意？\n",me);
  return 0;
}

void give_gold(object me,object who)
{
  if (!me || !who)
    return;

  if (!environment(me) || !environment(who) || environment(me) != environment(who))
    return;
  message_vision(HIW"$N" HIW"突然觉得有点不对劲，抬头看到$n"
                 HIW"正嘴角含笑的看着自己呢。\n"NOR,me,who);
  message_vision(HIR"$N" HIR"急忙伸手到怀中一摸，突的惨叫了一声。\n"
                 HIR"$N" HIR"伸出的手中哪有什么黄金，分明是条毒蛇正咬住手指！\n"NOR,me);
  message_vision(HIW"$N" HIW"冷笑着看到满脸痛苦的$n"
                 HIW"，口中念唱到：贪墨的是黄金，藏在心中的是条毒蛇啊！\n"NOR,who,me);
  call_out("give_gold1",1,me,who);
}

void give_gold1(object me,object who)
{
  if (!me || !who)
    return;

  if (!environment(me) || !environment(who) || environment(me) != environment(who))
    return;

  message_vision("$N的手臂都变黑了，只得苦苦哀求$n，“这金子真不是好东西。。。呜呜！\n”",me,who);
  message_vision("$N呵呵笑了几声，伸手一点那毒蛇，毒蛇顿时消失了，而$n的手臂也完好如初！\n",who,me);
  message_vision("$N抹抹额头的汗水，说道：直到今日才直到这金子竟然如此毒辣！\n",me);
  me->command("thank " + who->query("id"));
  who->set_temp("hell-17/tanzanggui1",1);
  return;
}

void give_rule(object me,object who)
{
  if (!me || !who)
    return;

  if (!environment(me) || !environment(who) || environment(me) != environment(who))
    return;
  message_vision("$N手中的法尺发出强烈的白光，那时正义之光！\n",me);
  message_vision("那光芒是穿透黑暗的阳光，是照亮心底黑暗的曙光！\n"
                 "$N只觉得心惊肉跳，只觉得要被融化在了那光芒之中！\n\n",me);
  message_vision("$N面带微笑，唱和道：这正义的光芒难道无法穿越你心底的黑暗吗？\n",who);
  call_out("give_rule1",1,me,who);
}

void give_rule1(object me, object who)
{
  if (!me || !who)
    return;

  if (!environment(me) || !environment(who) || environment(me) != environment(who))
    return;
  message_vision("笼罩于强光下的$N只觉得冷汗淋漓而下，那轻柔的光芒直刺心底！\n",me);
  message_vision("仿佛是无边的压力，$N腿一软，竟然跪倒在了地上！\n",me);
  message_vision("$N眼见$n如此，呵呵一笑，伸手把那法尺拿过，弹指一喝，那法尺化做一道光芒直进了$n的心底！\n\n",who,me);
  me->command("bow " + who->query("id"));
  who->set_temp("hell-17/tanzanggui2",1);
  return;
}

void give_wine(object me,object who)
{
  if (!me || !who)
    return;

  if (!environment(me) || !environment(who) || environment(me) != environment(who))
    return;
  message_vision("$N接过酒坛，哈哈笑了起来，$P举坛就痛饮了起来！\n",me);
  message_vision("那酒入肚，如火烧身。$N大叫了一声，酒坛掉到了地上摔个粉碎！\n",me);
  message_vision("$N只觉得肚子一阵阵的疼痛，不由得大声哀号了起来！\n",me);
  call_out("give_wine1",1,me,who);
}

void give_wine1(object me, object who)
{
  if (!me || !who)
    return;

  if (!environment(me) || !environment(who) || environment(me) != environment(who))
    return;
  message_vision("$N看了看满地翻滚的$n，轻轻唱和道：贪婪真的给你快乐吗？莫让贪婪腐蚀了你的心！\n",who,me);
  message_vision("那剧烈的疼痛让$N无法忍受，只得请求$n的帮助！\n",me,who);
  message_vision("$N看着满眼都是眼泪的$n，伸手抚摩$n的头顶，口中念念有词：贪墨的，吐出来，心就清了！\n",who,me);
  message_vision("$N猛烈的呕吐了起来，无数黑乎乎的脏东西被吐了出来！\n",me);
  message_vision("$N良久慢慢的站了起来，看起来人清气爽了很多！\n",me);
  me->command("thank " + who->query("id"));
  who->set_temp("hell-17/tanzanggui3",1);
  return;
}

string ask_yuma()
{
  object yuma;
  object me = this_object();
  object who = this_player();

  if (!query("yuma"))
    return "别提了，被人抢走了！真是鬼见鬼，见活鬼，满头雾水！\n";

  if (!who->query_temp("18hell/ask_yuma"))
    return "什么玉马？不知道。道听途说的事情，你也能当真！！\n";

  if (!who->query_temp("18hell/yuma_kill"))
  {
    command("kick");
    command("say 玉马是那个家伙送给我的！他愿意送，我愿意拿，关你什么事情！！\n");
    command("say 你想帮他出头，拿点本事出来，当我是好欺负的！！\n");
    NPC_D->set_from_me(me,who,105+random(10));
    me->full_me();
    command("kill " + who->query("id"));
    set_temp("my_killer",who);
    return "你找死！\n";
  }

  command("wuwu");
  command("kick");
  yuma = new("/d/18hell/obj/yuma");
  if (objectp(yuma) && yuma->move(who,1))
  {
    message_vision("$N给了$n一个玉马！\n",me,who);
    yuma->set("owner",who->query("id"));
    who->delete_temp("18hell/yuma_kill");
    who->delete_temp("18hell/ask_yuma");
    return "拿去吧！\n";
  }

  else if (objectp(yuma))
  {
    tell_object(who,"你身上的东西实在是太多了吧？\n");
    destruct(yuma);
    return "没有办法给你了！哈哈！！\n";
  }

  return "有这个东西吗？好象找不到了，报告wiz吧！\n";
}

void die(object killer)
{
  object dob;

  if (! objectp(dob = killer))
    dob = query_last_damage_from();
  if (objectp(dob) && dob->query_temp("owner"))
    dob = dob->query_temp("owner");
  if (!objectp(dob) || dob != query_temp("my_killer"))
  {
    command("say 走着瞧！\n");
    message_vision("$N身子一晃，化作飞烟消散了！\n",this_object());
    destruct(this_object());
    return;
  }

  message_vision("$N眼见不敌，急忙赔笑道：有话好好说！有话好好说！动手多伤和气啊！\n",this_object());
  this_object()->remove_all_enemy();
  dob->remove_all_enemy();
  dob->set_temp("18hell/yuma_kill",1);
  full_me();
  return;
}

