#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "田埂");
  set ("long", @LONG

田埂上。两边都是荒芜的农田。

LONG);
  set("exits",
  ([
     "north" : sprintf(__DIR__"tiangeng%d",1+random(4)),
     "south" : sprintf(__DIR__"tiangeng%d",1+random(8)),
     "east"  : __DIR__"tiangeng8",
     "west"  : sprintf(__DIR__"tiangeng%d",1+random(8)),
  ]));
  setup();
}

