inherit SMALLROOM;
inherit WOODROOM;
void init()
{
  object me = this_player();

  if (playerp(me))
  {
    message_vision("$N一踏入这片土黄的山林，大地都开始颤抖了！\n",me);
    tell_object(me,"你站都有些站不稳了！\n");
    if (random(3)==1)
      me->apply_condition("ill_shanghan",
         me->query_condition("ill_shanghan") + 5 + random(50));
    me->receive_damage("sen",(int)me->query("max_sen")/5);
  }

}

