//拔舌地狱
#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "无尽黑暗");
  set("long", @LONG
你不由自主的下落。四周的黑暗时刻要把你吞没。
LONG
);
  setup();
}

void init()
{
  object me ;
  string msg;
  int fali,success, damage;
  me = this_player();

  if (!playerp(me))
    return;

  add_action("do_cast","cast");
  success = 0;
  if (me->query_temp("18hell/in_dong"))
  {
    msg = HIB"一阵低低的呼啸声慢慢传来，只有心的感应，才可以知晓，那呼啸声音慢慢接近，到了近前。\n\n"NOR;
    msg += HIY"蓦的一片火焰飞腾，刹那的光华刺痛了$N双目，那是一把巨大的火钳。\n"
              "是的，是钳子，周身燃烧着绚烂的火焰，凌空飞击$N" HIY"而来。\n"
              "锐利的啸声和着滋滋的燃烧声。\n\n"NOR;
    msg += HIY"那飞钳临近$N" HIY"的头部，“喀”的一声，那钳子突然张开两片锐利的刃口，迅猛的合剪$N"HIY"。\n"NOR;
    message_vision(msg,me);
    fali = me->query("max_mana");
    if (fali/2 + random(fali) < 3500 )
      success = 1;
    fali = me->query("mana");
    if (fali/2 + random(fali) < 6000)
      success = 1;
    fali = me->query("daoxing");
    if (fali/2 + random(fali) < 3000000)
      success = 1;
    if (success)
    {
      msg = HIR"$N" HIR"一声惨叫，看来是没有能够避开！\n"NOR;
      message_vision(msg,me);
      damage = me->query("max_kee")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("kee",damage);
      me->receive_wound("kee",damage);
      damage = me->query("max_sen")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("sen",damage);
      me->receive_wound("sen",damage);
    }

    else
    {
      msg = HIW"$N" HIW"聚集法力在双拳，刺痛的眼睛流出了眼泪。\n"
               "在钳子闪耀出火焰的瞬间，$P双拳弧形的击出。\n"
               "钳子张开了，$N的双拳正中它两片锐利的刃口。\n\n"NOR;
      message_vision(msg,me);
      me->add("mana",-150);
    }

    me->start_busy(2);
    call_out("check_status",1,me);
  }

  else if (!wizardp(me))
  {
    message_vision("一个声音大喝道：$N是怎么来的呢？\n",me);
    me->move("/d/city/scenter");
    me->unconcious();
    message("vision", "空中突然掉下了一个半死的人！\n",environment(me), me);
  }

  else
    message_vision("$N大笑说道：当巫师就是好。\n",me);
  return;
}

#include "dong.lpc"
