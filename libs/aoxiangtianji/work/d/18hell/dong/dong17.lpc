// 石磨地狱
#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "无尽黑暗");
  set("long", @LONG
你不由自主的下落。四周的黑暗时刻要把你吞没。
LONG
);
  setup();
}

void init()
{
  object me ;
  string msg;
  int fali,success, damage;
  me = this_player();

  if (!playerp(me))
    return;

  add_action("do_cast","cast");
  success = 0;
  if (me->query_temp("18hell/in_dong"))
  {
    msg = HIB"一阵阵的撞击声音传来。$N" HIB"看到一个个大小不一的石磨正在前面乱飞而来。\n\n"NOR;
    message_vision(msg,me);
    fali = me->query_skill("force");
    if (fali/2 + random(fali) < 400 )
      success = 1;
    fali = me->query_cps();
    if (fali/2 + random(fali) < 100)
      success = 1;
    fali = me->query("combat_exp");
    if (fali/2 + random(fali) < 4000000)
      success = 1;
    if (success)
    {
      msg = HIR"$N" HIR"被数个石磨撞个正着！\n"NOR;
      message_vision(msg,me);
      damage = me->query("max_kee")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("kee",damage);
      me->receive_wound("kee",damage);
      damage = me->query("max_sen")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("sen",damage);
      me->receive_wound("sen",damage);
    }

    else
    {
      msg = HIW"$N" HIW"在空中不停的摇摆，左避右挡，顺利的冲了过去。\n\n"NOR;
      message_vision(msg,me);
    }

    call_out("check_status",1,me);
  }

  else if (!wizardp(me))
  {
    message_vision("一个声音大喝道：$N是怎么来的呢？\n",me);
    me->move("/d/city/scenter");
    me->unconcious();
    message("vision", "空中突然掉下了一个半死的人！\n",environment(me), me);
  }

  else
    message_vision("$N大笑说道：当巫师就是好。\n",me);
  return;
}

#include "dong.lpc"
