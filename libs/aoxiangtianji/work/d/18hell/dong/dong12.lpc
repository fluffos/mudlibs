// 舂臼地狱
#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "无尽黑暗");
  set("long", @LONG
你不由自主的下落。四周的黑暗时刻要把你吞没。
LONG
);
  setup();
}

void init()
{
  object me ;
  string msg;
  int fali,success, damage;
  me = this_player();

  if (!playerp(me))
    return;

  add_action("do_cast","cast");
  success = 0;
  if (me->query_temp("18hell/in_dong"))
  {
    msg = HIB"四周一片寂静。$N正奇怪这长久的寂静之时，一阵低微的转磨之声慢慢传来\n\n"NOR;
    msg += HIG"$N" HIG"四处张望，却并不见有何动静！\n"
              "慢慢的，那转磨声，似乎还掺杂有水流的声音。\n"NOR;
    msg += HIG"$N" HIG"突的看到一个样子象舂杵的东西正寂静的向自己直扎了过来。\n"NOR;
    message_vision(msg,me);
    fali = me->query("max_force");
    if (fali/2 + random(fali) < 3500 )
      success = 1;
    fali = me->query("force");
    if (fali/2 + random(fali) < 5000)
      success = 1;
    fali = me->query("combat_exp");
    if (fali/2 + random(fali) < 3000000)
      success = 1;
    if (success)
    {
      msg = HIR"$N" HIR"猝不及防，顿时被那舂杵穿透前胸而过了！\n"NOR;
      message_vision(msg,me);
      damage = me->query("max_kee")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("kee",damage);
      me->receive_wound("kee",damage);
      damage = me->query("max_sen")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("sen",damage);
      me->receive_wound("sen",damage);
    }

    else
    {
      msg = HIW"$N" HIW"眼见无法躲避，运集内力于双掌。\n"
               "$P双掌正面直击舂杵，强劲的内力把舂杵震得粉碎。\n\n"NOR;
      message_vision(msg,me);
    }

    call_out("check_status",1,me);
  }

  else if (!wizardp(me))
  {
    message_vision("一个声音大喝道：$N是怎么来的呢？\n",me);
    me->move("/d/city/scenter");
    me->unconcious();
    message("vision", "空中突然掉下了一个半死的人！\n",environment(me), me);
  }

  else
    message_vision("$N大笑说道：当巫师就是好。\n",me);
  return;
}

#include "dong.lpc"
