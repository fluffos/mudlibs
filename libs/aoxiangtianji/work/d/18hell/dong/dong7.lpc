// 刀山地狱
#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "无尽黑暗");
  set("long", @LONG
你不由自主的下落。四周的黑暗时刻要把你吞没。
LONG
);
  setup();
}

void init()
{
  object me ;
  string msg;
  int fali,success, damage;
  me = this_player();

  if (!playerp(me))
    return;

  add_action("do_cast","cast");
  success = 0;
  if (me->query_temp("18hell/in_dong"))
  {
    msg = HIB"$N黑暗中发现自己正望一种大山上直撞了过去。\n\n"NOR;
    msg += HIY"越来越近了，那“山”似乎还闪着点点寒光。\n"
              "原来这是一座无数锋利尖刀形成的刀山，正虎视眈眈的迎接$N" HIY"的到来。\n\n"NOR;
    message_vision(msg,me);
    fali = me->query("max_mana");
    if (fali/2 + random(fali) < 3500 )
      success = 1;
    fali = me->query("mana");
    if (fali/2 + random(fali) < 6000)
      success = 1;
    fali = me->query("daoxing");
    if (fali/2 + random(fali) < 3000000)
      success = 1;
    if (success)
    {
      msg = HIR"$N" HIR"一声惨叫，似乎有无数把尖刀透体而过了！\n"NOR;
      message_vision(msg,me);
      damage = me->query("max_kee")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("kee",damage);
      me->receive_wound("kee",damage);
      damage = me->query("max_sen")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("sen",damage);
      me->receive_wound("sen",damage);
    }

    else
    {
      msg = HIW"$N" HIW"聚集法力，仔细观看那刀山。\n"
               "眼看就要撞上去的时候，定目大喝“开”，刀山消失了，竟是假象。\n\n"NOR;
      message_vision(msg,me);
      me->add("mana",-150);
    }

    me->start_busy(2);
    call_out("check_status",1,me);
  }

  else if (!wizardp(me))
  {
    message_vision("一个声音大喝道：$N是怎么来的呢？\n",me);
    me->move("/d/city/scenter");
    me->unconcious();
    message("vision", "空中突然掉下了一个半死的人！\n",environment(me), me);
  }

  else
    message_vision("$N大笑说道：当巫师就是好。\n",me);
  return;
}

#include "dong.lpc"
