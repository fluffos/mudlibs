// 牛坑地狱
#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "无尽黑暗");
  set("long", @LONG
你不由自主的下落。四周的黑暗时刻要把你吞没。
LONG
);
  setup();
}

void init()
{
  object me ;
  string msg;
  int fali,success, damage;
  me = this_player();

  if (!playerp(me))
    return;

  add_action("do_cast","cast");
  success = 0;
  if (me->query_temp("18hell/in_dong"))
  {
    msg = HIB"突然“哞哞”的数声怪叫，几头巨型怪牛直奔$N而来。\n\n"NOR;
    msg += HIY"那些怪牛浑身金光闪烁，牛角寒光逼人，四蹄翻飞，如风一般席卷而来了。\n\n"NOR;
    message_vision(msg,me);
    fali = me->query("max_mana");
    if (fali/2 + random(fali) < 3500 )
      success = 1;
    fali = me->query("mana");
    if (fali/2 + random(fali) < 6000)
      success = 1;
    fali = me->query("daoxing");
    if (fali/2 + random(fali) < 3000000)
      success = 1;
    if (success)
    {
      msg = HIR"$N" HIR"连叫都叫不出声音了，被那些怪牛踏体而过，气息奄奄！\n"NOR;
      message_vision(msg,me);
      damage = me->query("max_kee")/3;
      if (damage < 800)
        damage = 800;
      me->receive_damage("kee",damage);
      me->receive_wound("kee",damage);
      damage = me->query("max_sen")/3;
      if (damage < 800)
        damage = 800;
      me->receive_damage("sen",damage);
      me->receive_wound("sen",damage);
    }

    else
    {
      msg = HIW"$N" HIW"忙把法力聚集，待怪牛来临。\n"
               "怪牛消失了，不过是假象。\n\n"NOR;
      message_vision(msg,me);
      me->add("mana",-150);
    }

    me->start_busy(2);
    call_out("check_status",1,me);
  }

  else if (!wizardp(me))
  {
    message_vision("一个声音大喝道：$N是怎么来的呢？\n",me);
    me->move("/d/city/scenter");
    me->unconcious();
    message("vision", "空中突然掉下了一个半死的人！\n",environment(me), me);
  }

  else
    message_vision("$N大笑说道：当巫师就是好。\n",me);
  return;
}

#include "dong.lpc"
