// 铁树地狱
#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "无尽黑暗");
  set("long", @LONG
你不由自主的下落。四周的黑暗时刻要把你吞没。
LONG
);
  setup();
}

void init()
{
  object me ;
  string msg;
  int fali,success, damage;
  me = this_player();

  if (!playerp(me))
    return;

  add_action("do_cast","cast");
  success = 0;
  if (me->query_temp("18hell/in_dong"))
  {
    msg = HIB"忽然一阵“叮当”的声音从下面传来。\n\n"NOR;
    msg += HIG"$N" HIG"仔细看去，不由得魂飞魄散！\n"
              "原来在前面，火焰掩映下，一座巨大的铁树堵在了通道中。\n"NOR;
    msg += HIG"那铁树飞快的转动，挂在周身的刀剑闪烁寒光。\n"NOR;
    message_vision(msg,me);
    fali = me->query("max_force");
    if (fali/2 + random(fali) < 3500 )
      success = 1;
    fali = me->query("force");
    if (fali/2 + random(fali) < 5000)
      success = 1;
    fali = me->query("combat_exp");
    if (fali/2 + random(fali) < 3000000)
      success = 1;
    if (success)
    {
      msg = HIR"$N" HIR"一声惨叫，顿时被那铁树卷入其中，全身上下被割得血肉模糊！\n"NOR;
      message_vision(msg,me);
      damage = me->query("max_kee")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("kee",damage);
      me->receive_wound("kee",damage);
      damage = me->query("max_sen")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("sen",damage);
      me->receive_wound("sen",damage);
    }

    else
    {
      msg = HIW"$N" HIW"危机来临，全身内力迸发而出。\n"
               "$P双手凌空推击而出，强劲的内力化为拳风，把铁树震得歪歪倒倒。\n"
               "那流转不住的刀剑顿时闪开，$N乘机一落而下。\n\n"NOR;
      message_vision(msg,me);
    }

    call_out("check_status",1,me);
  }

  else if (!wizardp(me))
  {
    message_vision("一个声音大喝道：$N是怎么来的呢？\n",me);
    me->move("/d/city/scenter");
    me->unconcious();
    message("vision", "空中突然掉下了一个半死的人！\n",environment(me), me);
  }

  else
    message_vision("$N大笑说道：当巫师就是好。\n",me);
  return;
}

#include "dong.lpc"
