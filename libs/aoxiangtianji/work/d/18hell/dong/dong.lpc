int do_cast(string arg)
{
  if (!arg)
    return 0;
  if (arg != "tuoqiao" && arg != "chuqiao")
    return 0;
  write("这里可无法用这个办法离开！\n");
  return 1;
}

int check_status(object me)
{
  object env;

  if (!me || me->is_ghost())
    return 1 ;
  env = environment(me);
  if (!env || env->query("short") != "无尽黑暗")
  {
    tell_object(me,"好象地点不对了！\n");
    return 1;
  }

  if( (int)me->query("sen") < 30
    || (int)me->query("eff_sen") < 30
    || (int)me->query("kee") < 30
    || (int)me->query("eff_kee") < 30 )
  {
    call_out("failed",1,me);
    return 1;
  }

  else
  {
    call_out("message",2,me);
    call_out("next_dong",3,me);
    return 1;
  }

}

int failed(object me)
{
  if (!me || me->is_ghost())
    return 1 ;
   message_vision("$N被无尽的黑洞湮灭了！\n",me);
   me->set_temp("death_msg","被无尽的黑洞湮灭了！");
   me->die();
   me->save();
   return 1;
}

int finish(object me)
{

  object env;

  if (!me || me->is_ghost())
    return 1 ;
  env = environment(me);
  if (!env || env->query("short") != "无尽黑暗")
    return 1;

  message_vision("“砰”的一声，$N重重的落在了地上！\n",me);
  message_vision("四周的压力瞬间消失了，看来$N已经来到了另外的一个世界！\n",me);
  me->set("18hell/entrance",18);
  me->move("/d/18hell/18/entrance");
  return 1;
}

int message(object me)
{
  object env;
  if (!me || me->is_ghost())
    return 1;
  env = environment(me);
  if (!env || env->query("short") != "无尽黑暗")
    return 1;

  switch(random(5))
  {
    case 0:
     message_vision("\n$N觉得四周的压力层层近逼了过来！\n",me);
     break;
    case 1:
     message_vision("\n$N呼吸都困难了。\n",me);
     break;
    case 2:
     message_vision("\n$N觉得天地在旋转。。。\n",me);
     break;
    case 3:
     message_vision("\n黑暗就要把$N吞没了！\n",me);
     break;
    default :
     message_vision("\n$N的身体仿佛要被撕裂了！\n",me);
  }

  return 1;
}

int next_dong(object me)
{
  object env;
  if (!me || me->is_ghost())
    return 1;
  env = environment(me);
  if (!env || env->query("short") != "无尽黑暗")
    return 1;

  me->add_temp("18hell/dong",1);
  if ((int)me->query_temp("18hell/dong") > 18)
  {
    me->delete_temp("18hell/dong");
    me->delete_temp("18hell/in_dong");
    me->start_busy(3);
    call_out("finish",3,me);
    return 1;
  }

  message_vision("$N身不由己的向下直落了下去！\n",me);
  me->move(__DIR__"dong"+sprintf("%d",me->query_temp("18hell/dong")));
  return 1;
}