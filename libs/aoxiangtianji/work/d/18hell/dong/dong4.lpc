// 孽镜地狱
#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "无尽黑暗");
  set("long", @LONG
你不由自主的下落。四周的黑暗时刻要把你吞没。
LONG
);
  setup();
}

void init()
{
  object me ;
  string msg;
  int fali,success, damage;
  me = this_player();

  if (!playerp(me))
    return;

  add_action("do_cast","cast");
  success = 0;
  if (me->query_temp("18hell/in_dong"))
  {
    msg = HIB"$N蓦然发现四周明亮起来，无数个自己下落的身形在四周晃动。\n\n"NOR;
    msg += HIY"原来四周挂满了各种镜子，镜中影像扰人分神。\n"
              "突然无数面镜子燃烧出团团火焰，借着光影喷吐而出，直袭$N" HIY"。\n\n"NOR;
    message_vision(msg,me);
    fali = me->query("max_mana");
    if (fali/2 + random(fali) < 3500 )
      success = 1;
    fali = me->query("mana");
    if (fali/2 + random(fali) < 6000)
      success = 1;
    fali = me->query("daoxing");
    if (fali/2 + random(fali) < 3000000)
      success = 1;
    if (success)
    {
      msg = HIR"$N" HIR"一声惨叫，看来是没有能够避开！\n"NOR;
      message_vision(msg,me);
      damage = me->query("max_kee")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("kee",damage);
      me->receive_wound("kee",damage);
      damage = me->query("max_sen")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("sen",damage);
      me->receive_wound("sen",damage);
    }

    else
    {
      msg = HIW"$N" HIW"聚集法力在全身，不顾一切的往前直冲。\n"
               "满身的法力在$N" HIW"四周形成一个保护环，无数的火球坠落了。\n\n"NOR;
      message_vision(msg,me);
      me->add("mana",-150);
    }

    me->start_busy(2);
    call_out("check_status",1,me);
  }

  else if (!wizardp(me))
  {
    message_vision("一个声音大喝道：$N是怎么来的呢？\n",me);
    me->move("/d/city/scenter");
    me->unconcious();
    message("vision", "空中突然掉下了一个半死的人！\n",environment(me), me);
  }

  else
    message_vision("$N大笑说道：当巫师就是好。\n",me);
  return;
}

#include "dong.lpc"
