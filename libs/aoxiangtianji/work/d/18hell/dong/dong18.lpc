// 刀锯地狱
#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "无尽黑暗");
  set("long", @LONG
你不由自主的下落。四周的黑暗时刻要把你吞没。
LONG
);
  setup();
}

void init()
{
  object me ;
  string msg;
  int fali,success, damage;
  me = this_player();

  if (!playerp(me))
    return;

  add_action("do_cast","cast");
  success = 0;
  if (me->query_temp("18hell/in_dong"))
  {
    msg = HIB"$N" HIB"一抬头，就见一面巨大的刀片，如门板一般。\n\n"NOR;
    msg += HIG"那刀片寒光闪闪，占据了大半的通道，朝着$N" HIG"直劈而来！\n"NOR;
    message_vision(msg,me);
    fali = me->query("max_force");
    if (fali/2 + random(fali) < 4000 )
      success = 1;
    fali = me->query("force");
    if (fali/2 + random(fali) < 6000)
      success = 1;
    fali = me->query("combat_exp");
    if (fali/2 + random(fali) < 4000000)
      success = 1;
    if (success)
    {
      msg = HIR"$N" HIR"顿时被刀锋划体而过，迸溅出满天的鲜血！\n"NOR;
      message_vision(msg,me);
      damage = me->query("max_kee")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("kee",damage);
      me->receive_wound("kee",damage);
      damage = me->query("max_sen")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("sen",damage);
      me->receive_wound("sen",damage);
    }

    else
    {
      msg = HIW"$N" HIW"急速转身，堪堪把那刀锋避过了。\n\n"NOR;
      message_vision(msg,me);
    }

    call_out("check_status",1,me);
  }

  else if (!wizardp(me))
  {
    message_vision("一个声音大喝道：$N是怎么来的呢？\n",me);
    me->move("/d/city/scenter");
    me->unconcious();
    message("vision", "空中突然掉下了一个半死的人！\n",environment(me), me);
  }

  else
    message_vision("$N大笑说道：当巫师就是好。\n",me);
  return;
}

#include "dong.lpc"
