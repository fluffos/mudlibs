// 剪刀地狱
#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "无尽黑暗");
  set("long", @LONG
你不由自主的下落。四周的黑暗时刻要把你吞没。
LONG
);
  setup();
}

void init()
{
  object me ;
  string msg;
  int fali,success, damage;
  me = this_player();

  if (!playerp(me))
    return;

  add_action("do_cast","cast");
  success = 0;
  if (me->query_temp("18hell/in_dong"))
  {
    msg = HIB"突然一股劲风袭来，黑暗中这劲风愈来愈强劲，眨眼就把$N压迫得横了起来。\n\n"NOR;
    msg += HIY"“喀嚓”一声响过，劲力回环，慢慢凝集成了一个暗红的剪刀。\n"
              "是剪刀，张开的刃口映射在暗红中，凌空慢慢迫近$N" HIY"而来。\n"NOR;
    msg += HIY"那飞钳看似缓慢，然而靠近后才发觉凌厉异常。“喀”的一声，迅猛的合剪$N"HIY"的双手。\n"NOR;
    message_vision(msg,me);
    fali = me->query_skill("dodge");
    if (fali/2 + random(fali) < 350 )
      success = 1;
    fali = me->query_dex();
    if (fali/2 + random(fali) < 40)
      success = 1;
    fali = me->query("combat_exp");
    if (fali/2 + random(fali) < 3000000)
      success = 1;
    if (success)
    {
      msg = HIR"$N" HIR"一声惨叫，双手手指剧痛，看来是没有避开！\n"NOR;
      message_vision(msg,me);
      damage = me->query("max_kee")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("kee",damage);
      me->receive_wound("kee",damage);
      damage = me->query("max_sen")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("sen",damage);
      me->receive_wound("sen",damage);
    }

    else
    {
      msg = HIW"$N" HIW"虽然身体被迫横展开，但身体依然灵动异常。\n"
               "在剪刀劲风及体之前，$P身形扭曲成怪异的弧形。\n"
               "$N成功的避开了剪刀的合剪之势。\n\n"NOR;
      message_vision(msg,me);
    }

    call_out("check_status",1,me);
  }

  else if (!wizardp(me))
  {
    message_vision("一个声音大喝道：$N是怎么来的呢？\n",me);
    me->move("/d/city/scenter");
    me->unconcious();
    message("vision", "空中突然掉下了一个半死的人！\n",environment(me), me);
  }

  else
    message_vision("$N大笑说道：当巫师就是好。\n",me);
  return;
}

#include "dong.lpc"
