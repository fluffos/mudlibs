// 油锅地狱
#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "无尽黑暗");
  set("long", @LONG
你不由自主的下落。四周的黑暗时刻要把你吞没。
LONG
);
  setup();
}

void init()
{
  object me ;
  string msg;
  int fali,success, damage;
  me = this_player();

  if (!playerp(me))
    return;

  add_action("do_cast","cast");
  success = 0;
  if (me->query_temp("18hell/in_dong"))
  {
    msg = HIB"刚过冰寒，热浪扑面而来了。\n\n"NOR;
    msg += HIG"$N" HIG"的四周，熊熊的火焰燃烧丈高，火焰上面，一口口的油锅冒着热气。\n"NOR;
    msg += HIG"不时看到油锅把沸腾的热油倾斜出来，“滋滋”冒烟！\n"NOR;
    message_vision(msg,me);
    fali = me->query("max_force");
    if (fali/2 + random(fali) < 3500 )
      success = 1;
    fali = me->query("force");
    if (fali/2 + random(fali) < 5000)
      success = 1;
    fali = me->query("combat_exp");
    if (fali/2 + random(fali) < 3000000)
      success = 1;
    if (success)
    {
      msg = HIR"$N" HIR"惨叫数声，浑身上下被烫起了无数的水泡，看来受伤不轻！\n"NOR;
      message_vision(msg,me);
      damage = me->query("max_kee")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("kee",damage);
      me->receive_wound("kee",damage);
      damage = me->query("max_sen")/3;
      if (damage < 600)
        damage = 600;
      me->receive_damage("sen",damage);
      me->receive_wound("sen",damage);
    }

    else
    {
      msg = HIW"$N" HIW"内力运转全身。不让热油泼溅到身上。\n\n"NOR;
      message_vision(msg,me);
    }

    call_out("check_status",1,me);
  }

  else if (!wizardp(me))
  {
    message_vision("一个声音大喝道：$N是怎么来的呢？\n",me);
    me->move("/d/city/scenter");
    me->unconcious();
    message("vision", "空中突然掉下了一个半死的人！\n",environment(me), me);
  }

  else
    message_vision("$N大笑说道：当巫师就是好。\n",me);
  return;
}

#include "dong.lpc"
