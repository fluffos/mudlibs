#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "泥泞小路");
  set ("long", @LONG

一条泥泞的小路，路边小草青绿，远处看，青山隐隐。
LONG);
  set("exits",
  ([
     "west" : __DIR__"dumu-bridge",
     "southeast" : __DIR__"nining2",
  ]));
  setup();
}

int valid_leave(object me, string dir)
{
  if (dir == "west" && !playerp(me))
    return 0;
  return ::valid_leave(me, dir);
}

