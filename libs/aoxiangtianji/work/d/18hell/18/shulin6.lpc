#include <ansi.h>
inherit SMALLROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "树林");
  set ("long", @LONG

进入了这片树林，顿时没有了方向。那交错的小路模糊在
淡淡的烟幕下。那烟幕在白天的阳光下，黑色缭绕。而在夜晚
暗淡的月光下，惨白缥缈。
LONG);
  set("exits",
  ([
     "west" : sprintf(__DIR__"shulin%d",1+random(6)),
     "east" : sprintf(__DIR__"shulin%d",1+random(6)),
     "south" : sprintf(__DIR__"shulin%d",1+random(6)),
     "north" : sprintf(__DIR__"shulin%d",1+random(6)),
  ]));
  setup();
}

