//ghost18.c
#include <ansi.h>
inherit "/d/18hell/npc/du_ghost";
string ask_xiu();
string ask_chi();
void create()
{
  set_name(HIG"马屁鬼"NOR,({"mapi gui","gui","ghost"}));
  if (random(2))
    set("gender", "男性" );
  else
    set("gender", "女性" );
  set("age",10 + random(100));
  set("long",
"这是个满面堆笑的鬼，别看他满脸笑容，可满脑子想着怎么去害你。\n");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "马屁鬼笑嘻嘻的看了你一眼。\n" NOR,
     HIW "马屁鬼笑道：千穿万穿，马屁不穿。\n" NOR,
     CYN "马屁鬼自言自语道：这马屁拍得好，也是门艺术啊。\n" NOR,
     HIW "马屁鬼呵呵一笑，这没有好处的马屁，拍了也是浪费时间。\n" NOR,
     (: random_move :),
  }) );
  set("duhua",([
     "lvl" : "hell-18",
     "cond1" : "mapigui1",
     "cond2" : "mapigui2",
     "cond1_msg" : "唉，我满腹才学，可惜不知道“羞”是何含义？\n你知道吗？请告诉(anawer)我！\n",
     "cond2_msg" : "想我才高八斗，就是不明白“耻”做何解？\n你知道吗？请告诉(anawer)我！\n",
     "duhua_msg" : "可怜我到了今天做了鬼，才明白“羞耻”啊，，，\n",
  ]));
  set("inquiry", ([
    "马屁" : "这马屁要拍得好，拍出水准，可不容易。。。\n",
    "羞" : (: ask_xiu :),
    "耻" : (: ask_chi :),
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  ::init();

  add_action("do_answer",({"huida","answer"}));
}

string ask_xiu()
{
  string duer;
  object me = this_object();
  object who = this_player();

  duer = (string)who->query_temp("duhua");
  if (!stringp(duer) || duer != me->query("id"))
    return "你还是赶紧去忙你自己的事情吧？\n";
  if (who->query_temp("hell-18/mapigui1"))
    return "你不是已经指教过了吗？\n";
  who->set_temp("18hell/ask_xiu",1);
  me->command("say 嘿嘿，那个老先生，是怎么也不肯告诉我，什么是“羞”？估计他也不知“羞”！\n");
  return "如果你知道，请回答：answer|huida ！\n";
}

string ask_chi()
{
  string duer;
  object me = this_object();
  object who = this_player();

  duer = (string)who->query_temp("duhua");
  if (!stringp(duer) || duer != me->query("id"))
    return "你还是赶紧去忙你自己的事情吧？\n";
  if (!who->query_temp("hell-18/mapigui1"))
    return "我正在为什么是“羞”的问题苦恼呢？\n";
  if (who->query_temp("hell-18/mapigui2"))
    return "你不是已经指教过了吗？\n";
  who->set_temp("18hell/ask_chi",1);
  me->command("say 太可恨了！一个大字不识的樵夫，居然嘲笑我不知“耻”！\n");
  me->command("say 嘿嘿，你说这世界上，有人知道“耻”吗？！我看你也不知“耻”！\n");
  return "如果你知道，请回答：answer|huida ！\n";
}

int do_answer(string arg)
{
  int num, ok_not;
  string msg;
  string duer;
  object who = this_player();
  object me = this_object();

  if (!arg)
    return notify_fail("你回到什么？\n");

  duer = (string)who->query_temp("duhua");
  if (!stringp(duer) || duer != me->query("id"))
    return notify_fail("好象没有你的事情吧？\n");

  if (!who->query_temp("hell-18/mapigui1"))
  {
    if (!who->query_temp("18hell/ask_xiu"))
      return notify_fail("你回答这个干什么？\n");

    msg = HIW"$N" HIW"大声回答$n" HIW"，这“羞”就是：" + HIY + arg + HIW" ！\n"NOR;
    message_vision(msg,who,me);
    ok_not = 0;
    num = (int)who->query_temp("18hell/mapigui-xiu");
    switch (num)
    {
      case 0 :
        break;
      case 1 :
        if (arg == "脸皮不能比城墙厚")
          ok_not = 1;
        break;
      case 2 :
        if (arg == "知道脸红")
          ok_not = 1;
        break;
      default :
        if (arg == "会害臊")
          ok_not = 1;
        break;
    }

  }

  else
  {
    if (!who->query_temp("18hell/ask_chi"))
      return notify_fail("可惜没有人愿意听你的回答！\n");
    msg = HIW"$N" HIW"大声回答$n" HIW"，这“耻”就是：" + HIY + arg + HIW" ！\n"NOR;
    message_vision(msg,who,me);
    ok_not = 0;
    num = (int)who->query_temp("18hell/mapigui-chi");
    switch (num)
    {
      case 0 :
        break;
      case 1 :
        if (arg == "心不能比煤炭黑")
          ok_not = 1;
        break;
      case 2 :
        if (arg == "没有狼心狗肺")
          ok_not = 1;
        break;
      default :
        if (arg == "做了坏事会良心不安")
          ok_not = 1;
        break;
    }

  }

  call_out("check_result",1,me,who,ok_not);
  return 1;

}

void check_result(object me,object who,int ok_not)
{
  int num;

  if (!me || !who)
    return;

  if (!environment(me) || !environment(who) || environment(me) != environment(who))
    return;

  if (ok_not)
  {
    num = (int)who->query_temp("18hell/mapigui-xiu");
    if (num > 0)
    {
      message_vision("$N听了$n的回答，呆呆的想了一会，说道：直到今天才直到原来有“羞”啊！\n",me);
      who->set_temp("hell-18/mapigui1",1);
      who->delete_temp("18hell/mapigui-xiu");
      tell_object(who,"你成功的让马屁鬼直到了“羞”！:-)\n");
      if (!who->query_busy())
        who->start_busy(1);
      return;
    }

    num = (int)who->query_temp("18hell/mapigui-chi");
    if (num > 0)
    {
      message_vision("$N听了$n的回答，想了一会，叫道：直到今天才直到原来有“羞耻”啊！\n",me);
      who->set_temp("hell-18/mapigui2",1);
      who->delete_temp("18hell/mapigui-chi");
      tell_object(who,"你成功的让马屁鬼直到了“羞耻”！:-)\n");
      if (!who->query_busy())
        who->start_busy(1);
      return;
    }

  }

  message_vision("$N嘻嘻一笑，兄台真是聪明伶俐，那个，那个世人难及啊。。。\n",me);
  message_vision("看来$N正在大拍$n的马屁！真是让人浑身都起鸡皮疙瘩！\n",me,who);
  message_vision("$N拍完了马屁，一回头，嘀咕道：这家伙哪知道“羞耻”啊！\n"
                 "可惜$n听了个明明白白，气得要吐血了！\n",me,who);
  tell_object(who,"看来你并没有给出正确的答案啊！\n");
  return;
}

