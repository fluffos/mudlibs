#include <ansi.h>
inherit NPC;
string ask_xiu();
string ask_dubook();
void create()
{
  set_name(HIW"老先生"NOR,({"laoxiansheng","xiansheng","gui","ghost"}));
  set("gender", "男性" );
  set("age",100 + random(100));
  set("long","这是个文质彬彬的鬼，头发胡须都斑白了。\n");
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaful");
  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",3500);
  set("force",7000);
  set("max_mana",3500);
  set("mana",7000);
  set_skill("force",280+random(100));
  set_skill("spells",280+random(100));
  set_skill("dodge",280 + random(100));
  set_skill("unarmed",280+random(100));
  set_skill("parry",280+random(100));
  set_skill("stick",280+random(100));

  set_skill("tonsillit",280+random(100));
  set_skill("gouhunshu",280+random(100));
  set_skill("ghost-steps",280 + random(100));
  set_skill("jinghun-zhang",280+random(100));
  set_skill("kusang-stick",280+random(100));

  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");
  map_skill("stick","kusang-stick");
  map_skill("parry","kusang-stick");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "老先生道：只有读了圣贤书，才可以明白什么是“羞”。\n" NOR,
     HIW "老先生叹道：鬼和人就是不一样，读书都只能晚上读！\n" NOR,
  }) );
  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: cast_spell, "gouhun" :),
  }) );
  set("inquiry", ([
    "读书" : (: ask_dubook :),
    "羞" : (: ask_xiu :),
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  if (playerp(this_player()))
    add_action("do_dubook",({"dushu","dubook","xuexi"}));
}

string ask_xiu()
{
  int i;
  string msg;
  object me = this_object();
  object who = this_player();

  if (!who->query_temp("18hell/ask_xiu"))
    return "你这么大个人，连这都不懂，一看就是没有好好读书的！\n";
  if (!who->query("18hell/dubook_finish"))
    return "不读书，不明白事理，当然就不知道“羞”了！快点来读书吧！\n";

  msg = HIY"$N" HIY"呵呵笑道，$n" HIY"读完了书，还不能明白这道理就藏在书中吗？\n"NOR;
  i = 1 + random(3);
  switch (i)
  {
    case 1 :
      msg += HIY"$N" HIY"伸手在$n" HIY"额头一拍，大声说道：这“羞”就是："
             HIR"脸皮不能比城墙厚" HIY"！\n"NOR;
      break;
    case 2 :
      msg += HIY"$N" HIY"伸手在$n" HIY"脸上拍了拍，笑道：这“羞”就是："
             HIR"知道脸红" HIY"！\n"NOR;
      break;
    default :
      msg += HIY"$N" HIY"向$n" HIY"吐了吐舌头，嘿嘿笑道：这“羞”就是："
             HIR"会害臊" HIY"！\n"NOR;
      break;
  }

  message_vision(msg,me,who);
  who->set_temp("18hell/mapigui-xiu",i);
  return "你明白了吗？\n";
}

string ask_dubook()
{
  object me = this_object();
  object who = this_player();

  if (!who->query_temp("18hell/ask_xiu"))
    return "只有好好读书，才能明白道理，别象那个马屁鬼，连“羞”都不知道！\n";
  if (who->query("18hell/dubook_finish"))
    return "你不是已经读过书了吗？难道还不明白事理？\n";
  if (who->query_temp("18hell/dubook_ok"))
    return "到了开课时间就来学习吧！\n";

  who->set_temp("18hell/dubook_ok",who->query_skill("literate",1));
  message_vision("$N拍了拍$n的头，呵呵笑道：只有通过读书才能明白很多的道理！真是太令我高兴了！\n",me,who);
  return "注意：只有晚上才能授课(dubook)！白天我要休息！！\n";
}

int do_dubook(string arg)
{
  int skill_basic,skill,t;
  object me = this_object();
  object who = this_player();
  int phase = NATURE_D->query_current_day_phase();
  if (!who->query_temp("18hell/ask_xiu"))
  {
    write("只有好好读书，才能明白道理，别象那个马屁鬼，连“羞”都不知道！\n");
    return 1;
  }

  if (who->query("18hell/dubook_finish"))
  {
    write("你不是已经读过书了吗？难道还不明白事理？\n");
    return 1;
  }

  skill_basic = (int)who->query_temp("18hell/dubook_ok");
  if (!skill_basic)
  {
    write("我还没有准许你在我这里读书呢！\n");
    return 1;
  }

  if (phase > 0 && phase < 5)
  {
    message_vision("$N皱了皱眉，说道：白天是我休息的时间，不要打扰我！\n",me,who);
    return 1;
  }

  if (who->is_busy())
  {
    write("你正忙着呢？\n");
    return 1;
  }

  if (who->query("sen") < 200)
  {
    write("你实在是太累了，还是先休息一下吧！\n");
    return 1;
  }

  t = time();
  if (t == who->query_temp("last_18hell_bubook"))
  {
    message_vision("$N很生气的说道：读书重在理解，急急忙忙的，能明白吗？\n",me);
    return 1;
  }

  who->set_temp("last_18hell_bubook",t);

  message_vision("$N摇头晃脑的和$n一起念起书来！\n",who,me);
  if (random(3)==1)
  {
    tell_object(who,"可是你心神不宁，似乎所得不多！\n");
    who->improve_skill("literate", (int)who->query_int()/12 + 1);
  }

  else
    who->improve_skill("literate", (int)who->query_int()/5 + 1);
  if (random(4)==1)
  {
    tell_object(who,"你觉得有些无聊，结果浪费了更多的精力！\n");
    who->receive_damage("sen",50 + random(50));
  }

  else
    who->receive_damage("sen",30 + random(30));
  if (!who->is_busy())
    who->start_busy(1+random(3));
  skill = who->query_skill("literate",1);
  if (skill > skill_basic + 2)
  {
    message_vision("$N觉得自己明白了很多新东西！\n",who);
    message_vision("$N捻须笑道：看来你的学习可以结束了！\n",me);
    who->set("18hell/dubook_finish",1);
  }

  return 1;
}

