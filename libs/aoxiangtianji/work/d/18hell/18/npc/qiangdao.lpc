#include <ansi.h>
inherit NPC;
void create()
{
  set_name(HIM"强盗鬼"NOR,({"qiangdao gui","gui","ghost"}));
  set("gender", "男性" );
  set("age",100 + random(100));
  set("long","这是个气势汹汹的鬼，前世冤孽太重，只得躲在这山林里。\n");
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaful");
  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",3500);
  set("force",7000);
  set("max_mana",3500);
  set("mana",7000);
  set_skill("force",280+random(100));
  set_skill("spells",280+random(100));
  set_skill("dodge",280 + random(100));
  set_skill("unarmed",280+random(100));
  set_skill("parry",280+random(100));
  set_skill("stick",280+random(100));

  set_skill("tonsillit",280+random(100));
  set_skill("gouhunshu",280+random(100));
  set_skill("ghost-steps",280 + random(100));
  set_skill("jinghun-zhang",280+random(100));
  set_skill("kusang-stick",280+random(100));

  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");
  map_skill("stick","kusang-stick");
  map_skill("parry","kusang-stick");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "强盗鬼大喊道：把值钱的都拿出来。\n" NOR,
     HIW "强盗怒号道：杀了我，也还是个鬼！\n" NOR,
  }) );
  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: perform_action, "stick.qmly" :),
     (: cast_spell, "gouhun" :),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  carry_object("/d/obj/weapon/stick/wuchangbang")->wield();
}

void init ()
{
  object ob = this_player();
  ::init();
  if( playerp(ob) && !is_fighting() )
  {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}

void greeting(object ob)
{
  if( !ob || environment(ob) != environment() )
    return;

  if(!ob->query_temp("18hell/ask_suanpan"))
  {
    command("grin " + ob->query("id"));
    message_vision ("$N道：送上门来了，识相的，把值钱的留下，快滚！\n",this_object());
    command("sing");
  }

  else
  {
    message_vision ("$N道：哈哈，居然找上了门。。。\n",this_object());
  }

  this_object()->kill_ob(ob);
}

int accept_fight (object ob)
{
  kill_ob (ob);
  return 1;
}

void kill_ob (object ob)
{
  set_temp("no_return",1);
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

void die()
{
  object ob = query_temp("my_killer");
  object me = this_object();
  object suanpan;
  object where;

  where =environment(me);

  if (ob &&
      ob == query_last_damage_from() &&
      ob->query_temp("18hell/ask_suanpan"))
  {
    ob->delete_temp("18hell/ask_suanpan");
    suanpan = new("/d/18hell/obj/suanpan");
    if (objectp(suanpan) && suanpan->move(ob,1))
    {
      suanpan->set("owner",ob->query("id"));
      message_vision("$N一看$n倒地不起，赶紧从$n身上搜出了一个算盘！\n",ob,me);
    }

    else if (objectp(suanpan))
    {
      destruct(suanpan);
      tell_object(ob,"很可惜，你身上的东西也许太多了！\n");
    }

    else
    {
      tell_object(ob,"很奇怪，你没有找到算盘！\n");
    }

  }

  message_vision ("\n$N惨叫一声，化成一堆骷髅，散落在地上。\n",me);
  destruct(me);
  return;
}

void unconcious()
{
  die();
}

