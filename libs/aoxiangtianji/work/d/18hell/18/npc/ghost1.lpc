//ghost18.c
#include <ansi.h>
inherit "/d/18hell/npc/du_ghost";
string ask_yuma();
string ask_suanpan();
void create()
{
  set_name(HIG"便宜鬼"NOR,({"pianyi gui","gui","ghost"}));
  if (random(2))
    set("gender", "男性" );
  else
    set("gender", "女性" );
  set("age",10 + random(100));
  set("long",
"这是个满面堆笑的鬼，别看他满脸笑容，可满脑子想着怎么去害你。\n");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "便宜鬼贼眉鼠眼的看了你一眼。\n" NOR,
     HIW "便宜鬼嘻嘻笑了声，能够占便宜，真舒服。\n" NOR,
     CYN "便宜鬼四周看了看，偷偷的笑了，估计没干好事。\n" NOR,
     HIW "便宜鬼叹了口气，这年头的傻子越来越少了。\n" NOR,
     (: random_move :),
  }) );
  set("duhua",([
     "lvl" : "hell-18",
     "cond1" : "pianyigui1",
     "cond2" : "pianyigui2",
     "cond1_msg" : "奶奶的，那个贪官占了我好大的便宜，抢走了我的玉马！\n",
     "cond2_msg" : "那个可恨的强盗，把我辛苦积攒的几个钱都抢走了！\n"
                   "最可恨的是，他还把我家传的黑算盘给强走了！\n",
     "duhua_msg" : "我。。。我活着一辈子想占便宜，没有想到死了碰到了你这样的活菩萨，，，\n",
  ]));
  set("inquiry", ([
    "玉马" : (: ask_yuma :),
    "黑算盘" : (: ask_suanpan :),
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

string ask_yuma()
{
  string duer;
  object me = this_object();
  object who = this_player();

  if (query("yuma"))
    return "哈哈，有人帮我抢回来了，真是好人啊！\n";
  duer = (string)who->query_temp("duhua");

  if (!stringp(duer) || duer != me->query("id"))
    return "你问这个干什么？我真不开心着呢！\n";

  if (who->query_temp("hell-18/pianyigui1"))
    return "多谢！下次有麻烦，我还找你！\n";

  who->set_temp("18hell/ask_yuma",1);
  return "玉马是我心爱之物，可惜被那个贪官给贪墨了！\n"
         "那个贪官现在被打入到了第17层石磨地狱，求求你帮我找回来。。。\n";
}

string ask_suanpan()
{
  string duer;
  object me = this_object();
  object who = this_player();

  if (query("suanpan"))
    return "哈哈，有人帮我找回来了，真是好人啊！\n";
  duer = (string)who->query_temp("duhua");

  if (!stringp(duer) || duer != me->query("id"))
    return "你问这个干什么？我不开心着呢！\n";

  if (!who->query_temp("hell-18/pianyigui1"))
    return "我现在烦心的是我的玉马！\n";

  if (who->query_temp("hell-18/pianyigui2"))
    return "多谢！下次有麻烦，我还找你！\n";

  who->set_temp("18hell/ask_suanpan",1);
  return "黑算盘是我祖传的，可惜被北面山里的强盗鬼给抢了！\n你帮我找回来，我下辈子听你的！\n";
}

int accept_object(object who, object ob)
{
  string duer;
  object me = this_object();
  duer = (string)who->query_temp("duhua");

  if (!stringp(duer) || duer != me->query("id"))
    return 0;

  if (ob->query("id") != "18hell yu ma" &&
      ob->query("id") != "18hell hei suanpan")
  {
    command("grin");
    message_vision("$N一把接过，往怀中一揣，嘿嘿，不谢了！\n",me);
    return 1;
  }

  if (ob->query("owner") != who->query("id"))
  {
    command("哈哈，不是自己找到的，我先收下再说！\n");
    return 1;
  }

  message_vision("$N一愣，吃惊道：你真的肯把它给我吗？\n",me);
  if (ob->query("id") == "18hell yu ma")
  {
    if (who->query_temp("hell-18/pianyigui1"))
    {
      command("ah");
      say("怎么又来了？\n");
      return 1;
    }

    who->set_temp("hell-18/pianyigui1",1);
    me->set("yuma",1);
  }

  else if (ob->query("id") == "18hell hei suanpan")
  {
    if (who->query_temp("hell-18/pianyigui1"))
    {
      if (who->query_temp("hell-18/pianyigui2"))
      {
        command("?");
        say("又来了！我不嫌多！嘿嘿！！\n");
        return 1;
      }

      who->set_temp("hell-18/pianyigui2",1);
      me->set("suanpan",1);
    }

    else
    {
      command("grin");
      message_vision("$N一把接过，往怀中一揣，嘿嘿，不谢了！\n",me);
      return 1;
    }

  }

  message_vision("$N不由得感动得流下了眼泪！\n");
  return 1;
}

