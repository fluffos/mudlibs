#include <ansi.h>
inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "小桥北头");
  set ("long", @LONG

这座摇摇晃晃的小桥，把北面的小村和南面的地带链接了起来。
过了这桥，就是另外一个地狱的景象了。

LONG);
  set("exits",
  ([
     "northwest" : __DIR__"cunkou",
     "south" : __DIR__"s-bridge",
