#include <ansi.h>
inherit SMALLROOM;
inherit SANDROOM;
void create ()
{
  set ("short", "碎石路");
  set ("long", @LONG

一条碎石小路。东面是片树林，似乎可以听到有樵夫的歌声。
往南是小村的中心地带了。
LONG);
  set("exits",
  ([
     "north" : __DIR__"nining3",
     "east" : __DIR__"shulin1",
     "south" : __DIR__"suishi2",
  ]));
  setup();
}

