#include <ansi.h>
inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "南村口");
  set ("long", @LONG

这是一个小村的村口，入村的路边上，一个木牌子上，
红色的大字写着：
  刀锯村

LONG);
  set("exits",
  ([
     "north" : __DIR__"suishi5",
     "southeast" : __DIR__"n-bridge",
  ]));
  setup();
}

int valid_leave(object me, string dir)
{
  if (dir == "southeast" && !playerp(me))
    return 0;
  return ::valid_leave(me, dir);
}

