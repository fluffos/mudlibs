#include <ansi.h>
inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "小桥南头");
  set ("long", @LONG

这座摇摇晃晃的小桥，其实是两层地狱的链接。往北是刀锯地狱，
而继续往南行走，就是石磨地狱了。在小桥的边上，一块石头就醒目
的刻着：
  石磨地狱

LONG);
  set("exits",
  ([
     "north" : __DIR__"n-bridge",
     "south" : "/d/18hell/17/entrance",
  ]));
  setup();
}

int valid_leave(object me, string dir)
{
  if (dir == "north" && !playerp(me))
    return 0;
  return ::valid_leave(me, dir);
}

