//ghost18.c
#include <ansi.h>
inherit "/d/18hell/npc/du_ghost";
string ask_xiu();
string ask_chi();
void create()
{
  set_name(HIG"挑拨鬼"NOR,({"tiaobo gui","gui","ghost"}));
  if (random(2))
    set("gender", "男性" );
  else
    set("gender", "女性" );
  set("age",10 + random(100));
  set("long",
"看上去鬼鬼祟祟的，据说前世尽爱挑拨是非。\n");

  set("chat_chance", 10);
  set("chat_msg", ({
     CYN "挑拨鬼冷冷看了你一眼。\n" NOR,
     HIW "挑拨鬼低头想了一会儿，忽然抬头冲你一笑道：那边那个家伙不是好人，尽在我面前说你坏话。\n" NOR,
     (: random_move :),
  }) );
  set("duhua",([
     "lvl" : "hell-1",
     "cond1" : "tiaobogui1",
     "cond2" : "tiaobogui2",
     "cond1_msg" : "这人心，鬼心的["HIG"险恶"NOR"]，岂是三言两语能够说清楚的？\n",
     "cond2_msg" : "实话说，这挑拨一道，专是利用["HIG"人性的弱点"NOR"]，看人被利用，实在大快我心啊！\n",
     "duhua_msg" : "唉，难道我也应该看破，看穿这一切，随你去做个和尚？\n",
  ]));
  set("inquiry", ([
    "挑拨" : "等你能够领会人性的诸多问题，挑拨对你是没有用的。\n",
    "险恶" : (: ask_xiu :),
    "人性的弱点" : (: ask_chi :),
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}