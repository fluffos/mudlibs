//ghost18.c
#include <ansi.h>
inherit "/d/18hell/npc/du_ghost";
void create()
{
  set_name(HIG"教唆鬼"NOR,({"jiaosuo gui","gui","ghost"}));
  if (random(2))
    set("gender", "男性" );
  else
    set("gender", "女性" );
  set("age",10 + random(100));
  set("long",
"这个家伙据说最爱教唆别人干坏事，专门损人不利己。\n");

  set("chat_chance", 10);
  set("chat_msg", ({
     CYN "教唆鬼叹口气，道：人害人，害死人，所以，做鬼了。\n" NOR,
     HIW "教唆鬼溜达了几步，斜眼看了看你，摇了摇头。\n" NOR,
     (: random_move :),
  }) );
  set("duhua",([
     "lvl" : "hell-2",
     "cond1" : "jiaosuogui1",
     "cond2" : "jiaosuogui2",
     "cond1_msg" : "嘿嘿，你且听我说，东边的那个长耳朵鬼，和西边的那个长手鬼，原来是["HIG"两兄弟"NOR"]。\n",
     "cond2_msg" : "有时候我想抽自己两耳光。唉，那个长得象熊的家伙，["HIG"欺负"NOR"]我好长时间了，我。。。\n",
     "duhua_msg" : "太好了，多谢，多谢！\n",
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

