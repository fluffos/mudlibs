//ghost18.c
#include <ansi.h>
inherit "/d/18hell/npc/du_ghost";
void create()
{
  set_name(HIG"长舌鬼"NOR,({"changshe gui","gui","ghost"}));
  if (random(2))
    set("gender", "男性" );
  else
    set("gender", "女性" );
  set("age",10 + random(100));
  set("long",
"满口跑火车，最爱打听别人事情，四处散播的鬼。\n");

  set("chat_chance", 10);
  set("chat_msg", ({
     CYN "长舌鬼神秘的一笑，突然冲你低声说道：你知道吗？可出大事情了。\n" NOR,
     HIW "长舌鬼四处看了看，有些无聊的叹气道：鬼事，都是乱七八糟的。\n" NOR,
     (: random_move :),
  }) );
  set("duhua",([
     "lvl" : "hell-1",
     "cond1" : "changshegui1",
     "cond2" : "changshegui2",
     "cond1_msg" : "这个鬼地方，我不打听打听别人的事情，不是太["HIW"无聊"NOR"]了吗？\n",
     "cond2_msg" : "唉，真是难办！我天生就是["HIG"斜眼歪嘴"NOR"]，一看，就看到别人了，一说，就扯到别人。\n",
     "duhua_msg" : "太好了，多谢，多谢！\n",
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

