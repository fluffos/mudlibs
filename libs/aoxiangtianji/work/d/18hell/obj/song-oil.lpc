inherit ITEM;
int do_make();
void create()
{
  set_name("松脂", ({"18hell song oil", "oil", "songzhi"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一团松树干上凝结的松脂！\n");
    set("unit", "团");
  }

  setup();
}

void init()
{
  if (interactive(this_player()) &&
      environment() == this_player())
  {
    add_action("do_make", "make");
  }

}

int do_make()
{
  object huoba;
  object songzhi;
  object songoil = this_object();
  object who = this_player();

  songzhi = present("18hell song zhi",who);
  if (!objectp(songzhi))
  {
    write("你身上没有松枝，怎么做火把呢？\n");
    return 1;
  }

  if (songoil->query("owner") != who->query("id"))
  {
    write("这松脂不是你自己采集的吧？你怎么做也做不出火把来！\n");
    return 1;
  }

  destruct(songzhi);
  message_vision("$N把采集到的松脂涂抹到干枯的松枝上，慢慢的修剪了一番，"
                 "居然做出了一个松脂火把来！\n",who);
  huoba = new("/d/18hell/obj/song-huoba");
  huoba->set("owner",who->query("id"));
  huoba->move(who,1);
  destruct(songoil);
  return 1;
}

