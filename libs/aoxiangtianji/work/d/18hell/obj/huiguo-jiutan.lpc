inherit ITEM;
int do_fill(string arg);
void create()
{
  set_name("悔过酒坛", ({"18hell huiguo jiutan", "jiutan"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一件看上去很老旧的酒坛，看来可以灌(fill)些东西！\n");
    set("unit", "件");
  }

  setup();
}

void init()
{
  if (interactive(this_player()) &&
      environment() == this_player())
  {
    add_action("do_fill", ({"fill","full","guan","zhuang","zhuangman"}));
  }

}

int do_fill(string arg)
{
  object wine;
  object ob = this_object();
  object me = this_player();
  object env = environment(me);

  if (!env->query("can_fill"))
    return notify_fail("这里没有什么可以装到坛中的！\n");
  if (ob->query("owner") != me->query("id"))
    return notify_fail("这个坛子不属于你的，看来怎么灌水也是白费力气！\n");

  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (!arg || !ob->id(arg))
    return notify_fail("你要灌什么？\n");

  message_vision("$N小心的把坛子中挂满了水！\n",me);
  message_vision("真是奇怪，那水一灌到了坛中，就发出了阵阵的醇香，让$N十分的诧异！\n",me);
  wine = new("/d/18hell/obj/tzwine");
  wine->set("owner",me->query("id"));
  wine->move(me,1);
  destruct(ob);
  return 1;
}

