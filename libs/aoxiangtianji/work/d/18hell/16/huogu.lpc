#include <ansi.h>
inherit SMALLROOM;
inherit HILLROOM;
void init()
{
  object ghost;
  object who = this_player();

  if (!playerp(who))
    return;

  if (random(10) == 0)
  {
    message_vision(HIW"\n$N" HIW"突然眼前一花，好象一个红色的东西在眼前闪过！\n"NOR,who);
    ghost = present("hongfa gui", this_object());
    if (objectp(ghost))
    {
      if (!ghost->is_fighting(who))
        ghost->kill_ob(who);
      return;
    }

    ghost = new("/d/18hell/16/npc/hongfagui");
    ghost->move(environment(who),1);
    message_vision(HIW"$N" HIW"定睛一看，原来是个红发鬼来到了面前！\n"NOR,who);
    message_vision(HIR"$N" RED"裂嘴一笑，哈哈，今晚有肉吃了，烤了吃！！\n"NOR,ghost);
    ghost->command("sing");
    ghost->kill_ob(who);
    return;
  }

  if (random(2) || who->is_fighting())
    return;
  message_vision(HIR"\n一股浓烟扑面而来，顿时把$N" HIR"熏的面目全非了！\n"NOR,who);
  who->receive_damage("kee",(int)who->query("max_kee")/3);
  return;
}

