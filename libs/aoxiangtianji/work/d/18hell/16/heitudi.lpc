#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void regenerate();
void damage_player();
int do_dig();
void init()
{
  object who = this_player();

  if (!playerp(who))
    return;
  add_action("do_dig",({"dig","wa","search"}));
  if (random(4) == 1 && !query("fire"))
  {
    message_vision(RED"\n突然一股火苗窜了出来，顿时把这变成了火海。$N"
                   RED"猝不及防，顿时被困在了火海之中！\n"NOR,who);
    set("old_long",query("long"));
    set("old_exits",query("exits"));
    set("long", @LONG

火，，，火，，，到处是熊熊的烈火！

LONG);

    set("exits",
    ([
       "south" : random(4) ? base_name(this_object()) : query("fire_dir"),
       "north" : random(4) ? base_name(this_object()) : query("fire_dir"),
       "west"  : random(4) ? base_name(this_object()) : query("fire_dir"),
       "east"  : random(4) ? base_name(this_object()) : query("fire_dir"),
    ]));
    setup();
    set("fire",1);
    remove_call_out("regenerate");
    call_out("regenerate", 180);
    remove_call_out("damage_player");
    call_out("damage_player",3);
  }

  else if (query("fire"))
  {
    message_vision("熊熊烈火顿时把$N包围，顿时把$N烧了个焦头烂额！\n",who);
    who->receive_damage("kee",(int)who->query("max_kee")/4);
    who->receive_damage("sen",(int)who->query("max_sen")/4);
  }

}

void regenerate()
{
  if (query("fire") && stringp(query("old_long")))
  {
    message("vision", "熊熊的大火终于熄灭了。\n", this_object());
    delete("fire");
    set("long", query("old_long"));
    set("exits",query("old_exits"));
    delete("old_long");
    delete("old_exits");
    setup();
  }

  return;
}

void damage_player()
{
  object *inv;
  int sizeinv ;

  inv = all_inventory(this_object());
  sizeinv=sizeof(inv);
  if (!query("fire"))
    return;

  if (sizeinv > 0)
  {
    while (sizeinv--)
    {
      if (playerp(inv[sizeinv]))
      {
        message_vision("浓烟之中，一股火苗窜了出来，顿时把$N烧伤了！\n",inv[sizeinv]);
        inv[sizeinv]->receive_damage("kee",(int)inv[sizeinv]->query("max_kee")/4);
        inv[sizeinv]->receive_damage("sen",(int)inv[sizeinv]->query("max_sen")/4);
      }

    }

  }

  call_out("damage_player",4);
}

int do_dig()
{
  object who = this_player();
  object youtong, huoyou;

  if (!query("dig_oil"))
  {
    write("这里挖不出火油来！\n");
    return 1;
  }

  youtong = present("18hell you tong",who);
  if (!objectp(youtong))
  {
    write("你身上连油桶都没有，挖出了油有什么用呢？\n");
    return 1;
  }

  if (who->is_busy())
  {
    write("你现在正忙着呢！\n");
    return 1;
  }

  message_vision("$N开始在地上挖起来！\n",who);
  if (random(4) == 0)
  {
    message_vision("不一会，地上“汩汩”的冒出了黑色的油，$N赶紧用油桶装了起来！\n",who);
    destruct(youtong);
    huoyou = new("/d/18hell/obj/huoyou");
    huoyou->set("owner",who->query("id"));
    huoyou->move(who,1);
    tell_object(who,"你挖出了一桶火油！\n");
    return 1;
  }

  else
  {
    message_vision("结果地上什么都没有，$N擦了擦汗！\n",who);
    tell_object(who,"看来挖还是太浅了，需要继续努力！\n");
    if (!who->start_busy())
      who->start_busy(1+random(2));
    return 1;
  }

}

