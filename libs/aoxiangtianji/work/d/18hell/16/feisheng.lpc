#include <ansi.h>
inherit SMALLROOM;
inherit LANDROOM;
int do_feisheng();
void create ()
{
  set ("short", "飞升台");
  set ("long", @LONG

这里就是飞升台了。从这里可以飞升(feisheng)到另外的
地狱世界。

LONG);
  set("exits",
  ([
     "westdown"  : __DIR__"e-shanlu3",
  ]));
  set("objects",
  ([
      "/d/18hell/npc/shouhu/18" : 1,
      "/d/18hell/npc/shouhu/17" : 1,
      "/d/18hell/npc/shouhu/16" : 1,
  ]));
  setup();
}

void init()
{
  object who = this_player();

  if (playerp(who))
    add_action("do_feisheng","feisheng");
}

int do_feisheng()
{
  object who = this_player();
  object shouhu;
  mapping duhua;
  object *inv;

  if (!playerp(who))
    return 0;

  duhua = who->query("18hell/hell-18");
  if (!mapp(duhua) || sizeof(duhua) < 1)
  {
    write("你尚未完成第一八地狱（刀锯地狱）的渡化！\n");
    return 1;
  }

  duhua = who->query("18hell/hell-17");
  if (!mapp(duhua) || sizeof(duhua) < 1)
  {
    write("你尚未完成第一七地狱（石磨地狱）的渡化！\n");
    return 1;
  }

  duhua = who->query("18hell/hell-16");
  if (!mapp(duhua) || sizeof(duhua) < 1)
  {
    write("你尚未完成第一六地狱（火山地狱）的渡化！\n");
    return 0;
  }

  inv = all_inventory();
  inv = filter_array(all_inventory(),
                      (: playerp($1) :));

  if (sizeof(inv) > 1)
  {
    write("现在这里有不只一位玩家，无法飞升！\n");
    return 1;
  }

  shouhu = present("18hell shouhu");
  if (objectp(shouhu))
  {
    write("刀锯地狱守护一把拦住你，且慢！\n");
    return 1;
  }

  shouhu = present("17hell shouhu");
  if (objectp(shouhu))
  {
    write("石磨地狱守护一把拦住你，且慢！\n");
    return 1;
  }

  shouhu = present("16hell shouhu");
  if (objectp(shouhu))
  {
    write("火山地狱守护一把拦住你，且慢！\n");
    return 1;
  }

  message_vision(HIY"$N" HIY"肃身面对正东方，口中念念有词，刹那就就破空而去了！\n"NOR,who);
  who->set("18hell/entrance",15);
  who->save();
  who->move("/d/18hell/15/entrance",1);
  message_vision("眼前星光一闪，原来是$N从天而降\n",who);
  return 1;
}