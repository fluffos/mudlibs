#include <ansi.h>
inherit NPC;
void create()
{
  set_name(HIY"贪色鬼"NOR,({"tanse gui","gui","ghost"}));
  set("gender", "男性" );
  set("age",100 + random(100));
  set("long","这是个面色苍白，无精打采的鬼。\n");
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaful");
  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",3500);
  set("force",7000);
  set("max_mana",3500);
  set("mana",7000);
  set_skill("force",280+random(100));
  set_skill("spells",280+random(100));
  set_skill("dodge",280 + random(100));
  set_skill("unarmed",280+random(100));
  set_skill("parry",280+random(100));

  set_skill("tonsillit",280+random(100));
  set_skill("gouhunshu",280+random(100));
  set_skill("ghost-steps",280 + random(100));
  set_skill("jinghun-zhang",280+random(100));

  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");

  set("chat_chance", 30);
  set("chat_msg", ({
     CYN "贪色鬼说道：太美了，果然是" HIG"绝色" CYN"！\n" NOR,
     HIW "贪色鬼叹了口气：这" HIG"绝色" HIW"让吃的苦头可大了！\n" NOR,
     (: random_move :),
  }) );
  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: cast_spell, "gouhun" :),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  object me = this_player();

  if (playerp(me) && !me->query_temp("18hell/see_tansegui"))
  {
    message_vision(HIW"\n$N" HIW"对$n" HIW"道：你想不到这鬼地方，居然有" HIG"绝色"
                   HIW"美女吧？嘿嘿。。。\n"NOR,this_object(),me);
    me->set_temp("18hell/see_tansegui",1);
  }

}

string accept_ask(object me, string topic)
{
  string msg;
  object gui = this_object();

  if (topic == "绝色")
  {
    if (!me->query_temp("18hell/ask_meinv"))
    {
      command("haaa");
      command("say 我原来以为只有那个犯戒鬼才感兴趣，没有想到你也如此，哈哈！\n");
      command("grin " + me->query("id"));
      return "你应该先去找找犯戒鬼，看在他的面子上，我说不定透露点点消息给你！\n";
    }

    msg = "$N得意的说道，哈哈，东面来了两个千娇百媚的美女！\n";
    msg += "真是绝色啊！\n";
    message_vision(msg,gui);
    return "你想去见识见识吗？犯戒鬼估计还不知道呢！！\n";
  }

  return 0;
}

