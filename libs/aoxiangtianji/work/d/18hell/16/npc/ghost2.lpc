//ghost18.c
#include <ansi.h>
inherit "/d/18hell/npc/du_ghost";
string ask_girl();
void create()
{
  set_name(HIG"放火鬼"NOR,({"fanghuo gui","gui","ghost"}));
  if (random(2))
    set("gender", "男性" );
  else
    set("gender", "女性" );
  set("age",10 + random(100));
  set("long",
"这是一个看上去哆哆嗦嗦，好象很受惊吓的鬼，其实放火的时候也很凶。\n");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "放火鬼叹了口气。\n" NOR,
     HIW "放火鬼喃喃自语道：好大的一把火啊！\n" NOR,
     CYN "放火鬼好象偷偷的在那里抹眼泪，你一看他，他就转过脸去。\n" NOR,
     (: random_move :),
  }) );
  set("duhua",([
     "lvl" : "hell-16",
     "cond1" : "fanghuogui1",
     "cond2" : "fanghuogui2",
     "cond3" : "fanghuogui3",
     "cond1_msg" : "对不起啊，我很忙，我还要去找“松脂火把”呢！\n",
     "cond2_msg" : "唉，我没有心思听你说法！你知道有种东西叫“火油”吗？据说烧起来很厉害！\n",
     "cond3_msg" : "我要报仇！那个家伙在人间就杀了我儿子，到了阴间还想害我！\n",
     "duhua_msg" : "真是太感谢了，我的心愿了结了，，，！\n",
  ]));
  set("inquiry", ([
    "松脂火把" : "我也只是听说，估计是用松树和松脂做的！\n",
    "火油" : "好神奇的，据说是从地下挖掘出来的，一点点就可以烧很久！\n",
    "报仇" : "那个躲在火谷的红发鬼，在人间就是个大坏蛋，他杀了我的儿子，我放火烧死了他！\n",
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

int accept_object(object who, object ob)
{
  string duer;
  object me = this_object();
  duer = (string)who->query_temp("duhua");
  if (!stringp(duer) || duer != me->query("id"))
    return 0;

  if (ob->query("id") != "18hell huoba" &&
      ob->query("id") != "18hell huoyou")
  {
    command("sigh");
    message_vision("$N看起来很吃惊，疑惑的摇了摇头！\n",me);
    return 0;
  }

  if (ob->query("owner") != who->query("id"))
  {
    command("谢谢，不过要自己去找！\n");
    return 0;
  }

  if (ob->query("id") == "18hell huoba")
  {
    if (who->query_temp("hell-16/fanghuogui1"))
    {
      say ("我已经有了！多谢！！\n");
      return 0;
    }

    message_vision("$N高兴的说道：你找到了？\n",me);
    who->set_temp("hell-16/fanghuogui1",1);
  }

  else if (ob->query("id") == "18hell huoyou")
  {
    if (who->query_temp("hell-16/fanghuogui1"))
    {
      if (who->query_temp("hell-16/fanghuogui2"))
      {
        say ("多谢！你不是已经给过我了吗？\n",me);
        return 0;
      }

      who->set_temp("hell-16/fanghuogui2",1);
    }

    else
    {
      command("ah");
      message_vision("$N轻轻的摇摇头！\n",me);
      return 0;
    }

  }

  command("thank");
  return 1;
}

