#include <ansi.h>
inherit NPC;
void create()
{
  set_name(HIM"迷魂鬼"NOR,({"mihun gui","gui","ghost"}));
  set("gender", "女性" );
  set("age",100 + random(100));
  set("long","这是个千娇百媚的鬼，轻轻一笑，让人怦然心动。\n");
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaful");
  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",3500);
  set("force",7000);
  set("max_mana",3500);
  set("mana",7000);
  set_skill("force",280+random(100));
  set_skill("spells",280+random(100));
  set_skill("dodge",280 + random(100));
  set_skill("unarmed",280+random(100));
  set_skill("parry",280+random(100));
  set_skill("sword",280+random(100));

  set_skill("moonforce",280+random(100));
  set_skill("moonshentong",280+random(100));
  set_skill("moondance",280 + random(100));
  set_skill("baihua-zhang",280+random(100));
  set_skill("snowsword",280+random(100));

  map_skill("force","moonforce");
  map_skill("spells","moonshentong");
  map_skill("dodge","moondance");
  map_skill("unarmed","baihua-zhang");
  map_skill("stick","snowsword");
  map_skill("parry","snowsword");

  set("chat_chance", 20);
  set("chat_msg", ({
     CYN "迷魂鬼眼波流转，冲你娇媚的一笑。\n" NOR,
     HIW "迷魂鬼一抿嘴，吃吃的笑个不停！\n" NOR,
     (: random_move :),
  }) );
  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: perform_action, "sword.huifeng" :),
     (: perform_action, "sword.wuxue" :),
     (: cast_spell, "mihun" :),
  }) );
  setup();
  carry_object("/obj/cloth/pinkskirt")->wear();
  carry_object("/obj/cloth/female-shoe")->wear();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
}

void init ()
{
  object ob = this_player();
  ::init();
  if( playerp(ob) && !is_fighting() )
  {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}

void greeting(object ob)
{
  if( !ob || environment(ob) != environment() )
    return;

  if(!ob->query_temp("18hell/ask_meinv"))
  {
    command("kiss " + ob->query("id"));
    command("giggle");
  }

  else
  {
    message_vision ("$N道：找美女吗？在这里呢。。。\n",this_object());
    this_object()->kill_ob(ob);
  }

}

int accept_fight (object ob)
{
  kill_ob (ob);
  return 1;
}

void kill_ob (object ob)
{
  set_temp("no_return",1);
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

void die()
{
  object ob = query_temp("my_killer");
  object me = this_object();
  object huapi;
  object where;

  where =environment(me);

  if (ob &&
      ob == me->query_last_damage_from() &&
      ob->query_temp("18hell/ask_meinv"))
  {
     huapi = new("/d/18hell/obj/huapi");
    if (objectp(huapi) && huapi->move(ob,1))
    {
      huapi->set("owner",ob->query("id"));
      message_vision("$n倒在了地上，留下了一张画皮，$N赶紧拣了起来！\n",ob,me);
    }

    else if (objectp(huapi))
    {
      destruct(huapi);
      tell_object(ob,"很可惜，你身上的东西也许太多了！\n");
    }

    else
    {
      tell_object(ob,"很奇怪，你没有找到画皮！\n");
    }

  }

  destruct(me);
  return;
}

void unconcious()
{
  die();
}

