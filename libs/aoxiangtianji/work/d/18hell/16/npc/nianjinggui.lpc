#include <ansi.h>
inherit NPC;
void create()
{
  set_name(HIM"念经鬼"NOR,({"nianjing gui","gui", "ghost"}));
  set("gender", "男性" );
  set("age",100 + random(100));
  set("long","这鬼口里面念念有词，不知道在念些什么东西。\n");
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaful");
  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",3500);
  set("force",7000);
  set("max_mana",3500);
  set("mana",7000);
  set_skill("force",280+random(100));
  set_skill("spells",280+random(100));
  set_skill("dodge",280 + random(100));
  set_skill("unarmed",280+random(100));
  set_skill("parry",280+random(100));

  set_skill("tonsillit",280+random(100));
  set_skill("gouhunshu",280+random(100));
  set_skill("ghost-steps",280 + random(100));
  set_skill("jinghun-zhang",280+random(100));

  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "念经鬼说道：前辈子天天" HIG"念经" CYN"，也不知道犯了什么错，也要来受苦！\n" NOR,
     HIW "念经鬼叹了口气：这" HIG"念经" HIW"实在是没意思！\n" NOR,
     (: random_move :),
  }) );
  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: cast_spell, "gouhun" :),
  }) );
  set("jing",1);
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  object me = this_player();

  if (playerp(me) && !me->query_temp("18hell/see_nianjinggui"))
  {
    message_vision(HIW"\n$N" HIW"对$n" HIW"叹气道：" HIG"念经"
                   HIW"好无聊。。。\n"NOR,this_object(),me);
    me->set_temp("18hell/see_nianjinggui",1);
  }

}

string accept_ask(object me, string topic)
{
  object jing;
  object gui = this_object();

  if (topic == "念经")
  {
    if (!me->query_temp("hell-16/fanjiegui1") ||
        !me->query_temp("hell-16/fanjiegui2"))
    {
      command("en");
      command("say 你没事念经干什么？\n");
      return "那个犯戒鬼前世是个和尚，上次问了我念经的事情！\n";
    }

    if (!query("jing"))
      return "可惜我的经给别人拿走了！\n";

    jing = new("/d/18hell/obj/jing");
    jing->set("owner",me->query("id"));
    jing->move(me,1);
    message_vision("$N说道：我都快念烦了，你要就拿去吧！\n",gui);
    return "你拿去给那个犯戒鬼念念，嘿嘿，烦死他！\n";
  }

  return 0;
}

