#include <ansi.h>
inherit NPC;
void create()
{
  set_name(HIW"腹痛鬼"NOR,({"futong gui","gui","ghost"}));
  set("gender", "男性" );
  set("age",100 + random(100));
  set("long","这是个弯腰捂着肚子的鬼，嘴里痛苦的哼着。\n");
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaful");
  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",3500);
  set("force",7000);
  set("max_mana",3500);
  set("mana",7000);
  set_skill("force",280+random(100));
  set_skill("spells",280+random(100));
  set_skill("dodge",280 + random(100));
  set_skill("unarmed",280+random(100));
  set_skill("parry",280+random(100));

  set_skill("tonsillit",280+random(100));
  set_skill("gouhunshu",280+random(100));
  set_skill("ghost-steps",280 + random(100));
  set_skill("jinghun-zhang",280+random(100));

  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "腹痛鬼呻吟：不过吃了块" HIG"肉" CYN"，，，痛死我了！\n" NOR,
     HIW "腹痛鬼痛苦的捂着肚子，整个腰都弯曲了！\n" NOR,
     (: random_move :),
  }) );
  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: cast_spell, "gouhun" :),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  object me = this_player();

  if (playerp(me) && !me->query_temp("18hell/see_futonggui"))
  {
    message_vision(HIW"\n$N" HIW"捂着肚子，对$n" HIW"呻吟道：吃肉吃坏了，"
                   HIG"好痛" HIW"，我的肚子好痛啊。。。\n"NOR,this_object(),me);
    me->set_temp("18hell/see_futonggui",1);
  }

}

string accept_ask(object me, string topic)
{
  string msg;
  object gui = this_object();

  if (topic == "肉" || topic == "好痛")
  {
    msg = "$N痛苦的说道：这事情说来就长了！\n";
    msg += "当年有个老鹰，肚子饿了，要捕猎吃肉！\n";
    msg += "结果一个老和尚要老鹰不要去捕杀兔子！\n";
    msg += "但如果老鹰不吃兔子，自己不就饿死了吗？\n";
    msg += "结果这老和尚就把自己身上的肉割几块下来给老鹰吃！\n";
    msg += "老鹰吃了几口，觉得好难吃，结果剩下的肉被我偷偷的拿走了！\n";
    msg += "我偷偷的吃了其中的一块肉，肚子从阳间一直痛到我做了鬼啊！\n";
    message_vision(msg,gui);
    me->set_temp("18hell/ask_rou",1);
    return "你去找那个老和尚问问“肉”就知道了！他就在外面的破庙里，做了鬼都跟着我！呜呜！！\n";
  }

  if (topic == "老和尚" || topic == "破庙")
  {
    message_vision("$N说道：这老和尚把自己的关在破庙里，在破庙的外面摆弄了些迷宫，符法！\n",gui);
    return "找他还真不容易呢！\n";
  }

  return 0;
}

