#include <ansi.h>
inherit NPC;
void create()
{
  set_name("老和尚",({"lao heshang","monk"}));
  set("gender", "男性" );
  set("age",100 + random(100));
  set("long","这是个慈眉善目的老和尚，须发都白了，双手手臂鲜血淋漓的。\n");
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaful");
  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",3500);
  set("force",7000);
  set("max_mana",3500);
  set("mana",7000);
  set_skill("force",280+random(100));
  set_skill("spells",280+random(100));
  set_skill("dodge",280 + random(100));
  set_skill("unarmed",280+random(100));
  set_skill("parry",280+random(100));

  set_skill("tonsillit",280+random(100));
  set_skill("gouhunshu",280+random(100));
  set_skill("ghost-steps",280 + random(100));
  set_skill("jinghun-zhang",280+random(100));

  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");

  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: cast_spell, "gouhun" :),
  }) );
  set("rou", 1);
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

string accept_ask(object me, string topic)
{
  object rou;
  string msg;
  object monk = this_object();

  if (topic == "肉")
  {
    if (!me->query_temp("18hell/ask_rou"))
      return "做了和尚，吃肉就犯戒了，要到地狱去受苦的！\n";
    if (!query("rou"))
      return "没有了，别人拿走了！\n";
    msg = "$N呵呵笑了笑，伸出双手手臂给$n看！\n";
    msg += "想当年我割肉饲鹰，没有想到被个贪嘴的人把肉给偷去了几块！\n";
    msg += "只是他不明白，我是念了“禁肉咒”的，他那样吃了我的肉，做鬼都不安生！\n";
    msg += "施主听了这个故事，应该有所感悟吧！\n";
    message_vision(msg,monk);
    rou = new("/d/18hell/obj/rou");
    rou->set("owner",me->query("id"));
    rou->move(me,1);
    return "这肉你拿去惩罚别人吧，但一定要问我“禁肉咒”才行！\n";
  }

  if (topic == "禁肉咒")
  {
    rou = present("18hell rou",me);
    if (!objectp(rou) || rou->query("owner") != me->query("id"))
      return "你没有肉，问这个没有什么用！\n";
    message_vision("$N低头在$n说了几句，然后拍了拍$n的头，说道：你可要记住了！\n",monk,me);
    me->set_temp("18hell/rou_zhou",1);
    return "快去吧！希望你能用这肉和咒渡化鬼魂！\n";
  }

  return 0;
}

