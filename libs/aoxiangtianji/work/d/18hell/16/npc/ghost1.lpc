//ghost18.c
#include <ansi.h>
inherit "/d/18hell/npc/du_ghost";
string ask_girl();
void create()
{
  set_name(HIG"犯戒鬼"NOR,({"fanjie gui","gui","ghost"}));
  if (random(2))
    set("gender", "男性" );
  else
    set("gender", "女性" );
  set("age",10 + random(100));
  set("long",
"这是个一个犯戒的鬼，前世虽然做了和尚，但是吃肉喝酒杀人放火，干了不少坏事。\n");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "犯戒鬼摸了摸光头，鬼头鬼脑的念了声：阿弥陀佛。\n" NOR,
     HIW "犯戒鬼偷偷的擦擦嘴，似乎还在回味刚才的酒肉滋味！\n" NOR,
     CYN "犯戒鬼嘿嘿笑了几声，看了看四周，偷偷的拿出一块狗肉吃了起来。\n" NOR,
     (: random_move :),
  }) );
  set("duhua",([
     "lvl" : "hell-16",
     "cond1" : "fanjiegui1",
     "cond2" : "fanjiegui2",
     "cond3" : "fanjiegui3",
     "cond1_msg" : "吃了几块肉就犯了错吗？这年头真是的。。。\n",
     "cond2_msg" : "和尚也是人啊，看见美女流流口水，都是犯戒吗？嘿嘿，美女，，，\n",
     "cond3_msg" : "出家，出家，出了就是家，念经有什么用啊？做了鬼，经也没得念了！\n",
     "duhua_msg" : "唉，直到今天，我看看透啊。。。\n",
  ]));
  set("inquiry", ([
    "吃肉" : "肉可真香。。。为什么不让我吃肉？\n",
    "美女" : (: ask_girl :),
    "念经" : "做了鬼了，经也找不到了！\n",
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

string ask_girl()
{
  string duer;
  object me = this_object();
  object who = this_player();

  duer = (string)who->query_temp("duhua");
  if (!stringp(duer) || duer != me->query("id"))
    return "你还是赶紧去忙你自己的事情吧？\n";
  if (!who->query_temp("hell-16/fanjiegui1"))
    return "吃都没有吃饱，管什么美女？\n";
  if (who->query_temp("hell-16/fanjiegui2"))
    return "嘿嘿，已经见识过了！\n";
  who->set_temp("18hell/ask_meinv",1);
  me->command("say 嘿嘿，老子见过的美女多了去了！\n");
  return "好，你有什么新鲜货色让我见识见识！\n";
}

int accept_object(object who, object ob)
{
  string duer;
  object me = this_object();
  duer = (string)who->query_temp("duhua");
  if (!stringp(duer) || duer != me->query("id"))
    return 0;

  if (ob->query("id") != "18hell rou" &&
      ob->query("id") != "18hell jing" &&
      ob->query("id") != "18hell hongfen kulou" &&
      ob->query("id") != "18hell hua pi")
  {
    command("grin");
    message_vision("$N冷笑了一声，有什么用？\n",me);
    return 0;
  }

  if (ob->query("owner") != who->query("id"))
  {
    command("哈哈，不是自己找到的，我不要！\n");
    return 0;
  }

  if (ob->query("id") == "18hell rou")
  {
    if (who->query_temp("hell-16/fanjiegui1"))
    {
      message_vision("$N嘿嘿笑道，又拿这来吓唬我。。。\n",me);
      return 1;
    }

    message_vision("$N哈哈笑道：是请我吃肉吗？\n",me);
    message_vision("$N四周瞧了瞧，嘻嘻笑了起来，不客气的一把就接了过去！\n",me);
    call_out("give_rou",1,me,who);
    return 1;
  }

  if (ob->query("id") == "18hell hongfen kulou")
  {
    if (who->query_temp("hell-16/fanjiegui2") ||
        who->query_temp("18hell/kulou_give"))
    {
      message_vision("$N嘿嘿笑道，又拿这来教育我。。。\n",me);
      command("kick");
      return 0;
    }

    message_vision("$N一脸疑惑的接了过去，仔细一看，吓了一跳！\n",me);
    message_vision("$N叹道：这美女，，，红颜总有老去，留下这红粉骷髅！\n",who);
    who->set_temp("18hell/kulou_give",1);
    if (who->query_temp("18hell/huapi_give"))
    {
      who->delete_temp("18hell/ask_meinv");
      who->set_temp("hell-16/fanjiegui2",1);
      message_vision("$N想了一想，哈哈一笑道：原来色即是空就是这个道理啊！\n",me);
      command("jump");
    }

    return 1;
  }

  if (ob->query("id") == "18hell hua pi")
  {
    if (who->query_temp("hell-16/fanjiegui2") ||
        who->query_temp("18hell/huapi_give"))
    {
      message_vision("$N嘿嘿笑道，又拿这来教育我。。。\n",me);
      command("kick");
      return 0;
    }

    message_vision("$N一脸疑惑的接了过去，正面一看，嘻嘻一笑，背面一看，吓了一跳！\n",me);
    message_vision("$N叹道：这美女，，，嘿嘿，不过留下画皮一张！\n",who);
    who->set_temp("18hell/huapi_give",1);
    if (who->query_temp("18hell/kulou_give"))
    {
      who->delete_temp("18hell/ask_meinv");
      who->set_temp("hell-16/fanjiegui2",1);
      message_vision("$N想了一想，哈哈一笑道：原来色即是空就是这个道理啊！\n",me);
      command("jump");
    }

    return 1;
  }

  if (ob->query("id") == "18hell jing")
  {
    if (!who->query_temp("hell-16/fanjiegui1"))
    {
      message_vision("$N冷笑数声，一本破书，给我何用！\n",me);
      command("kick " + who->query("id"));
      return 0;
    }

    if (!who->query_temp("hell-16/fanjiegui2"))
    {
      message_vision("$N冷笑数声，我现在还不想读经书！\n",me);
      command("papaya " + who->query("id"));
      return 0;
    }

    if (who->query_temp("hell-16/fanjiegui3"))
    {
      message_vision("$N笑道，你没有新花样吗？\n",me);
      command("heng " + who->query("id"));
      return 0;
    }

    message_vision("$N愣呆呆的接了过去，这。。。这。。。\n",me);
    call_out("give_jing",1,me,who);
    return 1;
  }

  message_vision("$N一脸疑惑的说道：什么玩意？\n",me);
  return 0;
}

void give_rou(object me,object who)
{
  if (!me || !who)
    return;

  if (!environment(me) || !environment(who) || environment(me) != environment(who))
    return;
  message_vision(HIW"$N" HIW"嘿嘿笑了笑，看了看$n"
                 HIW"，不客气的张口就开始吃肉了。\n"NOR,me,who);
  message_vision(HIR"$N" HIR"眨眼就把肉吃完了，满意的拍了拍肚子。\n"NOR,me);
  if (!who->query_temp("18hell/rou_zhou"))
    return;
  message_vision(HIW"$N" HIW"看着$n吃完了肉，嘴里面念念有词！\n"
                 HIW"$n" HIW"只觉得腹中一阵阵的剧痛！\n"NOR,who,me);
  call_out("give_rou1",1,me,who);
}

void give_rou1(object me,object who)
{
  if (!me || !who)
    return;

  if (!environment(me) || !environment(who) || environment(me) != environment(who))
    return;

  message_vision("$N痛得满地打滚，一双眼睛恶狠狠的看着$n！\n”",me,who);
  message_vision("$N不动声色的继续念咒，每句咒文都如同雷一般的振荡在$n的耳鼓！\n",who,me);
  message_vision("$N终于忍耐不住了，大叫道：我佛慈悲，弟子受不了了，再不违戒吃肉了！\n",me);
  message_vision("$N呵呵一笑，闭嘴不念了，$n顿时站了起来！\n",who,me);
  me->command("heng " + who->query("id"));
  who->delete_temp("18hell/rou_zhou");
  who->set_temp("hell-16/fanjiegui1",1);
  return;
}

void give_jing(object me,object who)
{
  if (!me || !who)
    return;

  if (!environment(me) || !environment(who) || environment(me) != environment(who))
    return;
  message_vision("$N慢慢的打开了经书，那经书泛出了淡淡的红光！\n",me);
  message_vision("书中的经文慢慢的凸现了出来，字字如电般的击中了$N的心脏！\n"
                 "$N惊疑不定的翻阅那经书，慢慢的脸上显出了喜悦的神情！\n\n",me);
  message_vision("$N面带微笑，唱和道：你还不相信这佛言吗？\n",who);
  call_out("give_jing1",1,me,who);
}

void give_jing1(object me, object who)
{
  if (!me || !who)
    return;

  if (!environment(me) || !environment(who) || environment(me) != environment(who))
    return;
  message_vision("$N越往后翻看越是惊疑不定，冷汗涔涔的流了下来！\n",me);
  message_vision("$N双腿一屈，竟然跪倒在了地上！佛祖啊，到了今日，我才知道自己的罪过！\n",me);
  me->command("bow " + who->query("id"));
  who->set_temp("hell-16/fanjiegui3",1);
  return;
}

