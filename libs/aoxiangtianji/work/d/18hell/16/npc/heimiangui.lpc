#include <ansi.h>
inherit NPC;
void create()
{
  set_name(HIB"黑面鬼"NOR,({"heimian gui","gui","ghost"}));
  set("gender", "男性" );
  set("age",100 + random(100));
  set("long","这是个面孔焦黑的鬼，浑身上下都象着过火似的。\n");
  set("combat_exp",3000000 + random(2000000));
  set("daoxing",3000000 + random(2000000));
  set("con",30 + random(20));
  set("spi",30 + random(20));
  set("dex",30 + random(20));
  set("str",30 + random(20));
  set("int",30 + random(20));
  set("cor",30 + random(20));
  set("cps",30 + random(20));
  set("kar",30 + random(20));
  set("per",30 + random(20));
  set("attitude", "peaful");
  set("max_kee",5000);
  set("max_sen",5000);
  set("max_force",3500);
  set("force",7000);
  set("max_mana",3500);
  set("mana",7000);
  set_skill("force",280+random(100));
  set_skill("spells",280+random(100));
  set_skill("dodge",280 + random(100));
  set_skill("unarmed",280+random(100));
  set_skill("parry",280+random(100));

  set_skill("tonsillit",280+random(100));
  set_skill("gouhunshu",280+random(100));
  set_skill("ghost-steps",280 + random(100));
  set_skill("jinghun-zhang",280+random(100));

  map_skill("force","tonsillit");
  map_skill("spells","gouhunshu");
  map_skill("dodge","ghost-steps");
  map_skill("unarmed","jinghun-zhang");

  set("chat_chance", 40);
  set("chat_msg", ({
     CYN "黑面鬼说道：没有被" HIR"烧" CYN"死真是命大啊！\n" NOR,
     HIW "黑面鬼说道：奶奶的，那" HIY"火油" HIR"烧" HIW"起来，真是吓人！\n" NOR,
     (: random_move :),
  }) );
  set("chat_chance_combat",20);
  set("chat_msg_combat", ({
     (: cast_spell, "gouhun" :),
  }) );
  set("youtong",1);
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  object me = this_player();

  if (playerp(me) && !me->query_temp("18hell/see_heimiangui"))
  {
    message_vision(HIW"\n$N" HIW"对$n" HIW"喊道：" HIG"烧"
                   HIW"得我好惨啊。。。\n"NOR,this_object(),me);
    me->set_temp("18hell/see_heimiangui",1);
  }

}

string accept_ask(object me, string topic)
{
  string msg;
  object youtong;
  object gui = this_object();

  if (topic == "烧" || topic == "火油")
  {
    msg = "$N说道，那火谷的边上的黑土地，里面有块地方，稍微一挖(dig)，就出来了黑油！！\n";
    msg += "那里的火油也太厉害了，点点火星就烧成这样！！\n";
    message_vision(msg,gui);
    if (query("youtong"))
    {
      message_vision("$N拿出一个油桶来，递给了$n，这个是装油的油桶，你拿去吧！\n",gui,me);
      youtong = new("/d/18hell/obj/youtong");
      youtong->set("owner",me->query("id"));
      youtong->move(me,1);
      delete("youtong");
    }

    else
      message_vision("$N遗憾的说道：可惜我的油桶给了别人，否则可以给你看看哦！\n",gui);
    return "你如果去，可要当心，不留神就被烧黑了！\n";
  }

  return 0;
}

