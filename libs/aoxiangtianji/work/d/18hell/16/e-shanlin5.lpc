     "west"  : sprintf(__DIR__"e-shanlin%d",1+random(4)),
     "east"  : sprintf(__DIR__"e-shanlin%d",1+random(4)),
     "south" : sprintf(__DIR__"e-shanlin%d",1+random(4)),
     "north" : sprintf(__DIR__"e-shanlin%d",1+random(4)),
  ]));
