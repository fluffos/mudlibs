#include <ansi.h>
inherit __DIR__"songlin";
void create ()
{
  set ("short", "松树林");
  set ("long", @LONG

松林拣松涛阵阵，山风及体生寒，松树间相互间隔颇远，但这些
松树显然都有了很多的年头了，浓荫把日光都遮蔽了。

LONG);
  set("exits",
  ([
     "south" : sprintf(__DIR__"songlin%d",5+random(4)),
     "west" : sprintf(__DIR__"songlin%d",5+random(4)),
     "north" : __DIR__"songlin6",
     "east" : sprintf(__DIR__"songlin%d",1+random(8)),
  ]));
  set("number",5);
  setup();
}

