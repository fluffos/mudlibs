#include <ansi.h>
inherit SMALLROOM;
inherit WOODROOM;
void init()
{
  object where = this_object();
  object who = this_player();
  int num, base_dam;

  if (!playerp(who))
    return;

  num = where->query("number");
  if (who->query_temp("18hell/ask_rou"))
    base_dam = 3;
  else
    base_dam = 2;

  if (random(2) || num == 2 || num == 4 || num == 6 || num == 8)
  {
    message_vision(HIY"\n突然周围树木一阵移动，树叶簌簌做响，数道金光从树端直射向$N"
                   HIY"！\n"NOR,who);
    if (random(base_dam) < 2)
    {
      message_vision(HIW"$N" HIW"急忙闪避，但那数道金光来势又急又快，"
                        "角度方位拿捏得也十分巧妙！\n"NOR,who);
      message_vision(HIW"$N" HIW"被这数道金光透体而过！\n"NOR,who);
      who->receive_damage("kee",(int)who->query("max_kee")/base_dam);
      who->receive_damage("sen",(int)who->query("max_seb")/base_dam);
      who->receive_wound("kee",(int)who->query("max_kee")/(base_dam+1));
      who->receive_wound("sen",(int)who->query("max_sen")/(base_dam+1));
      if (!who->is_busy())
        who->start_busy(1+random(2));
    }

    else
      message_vision(HIG"但是被$N" HIG"十分巧妙的避开了！\n"NOR,who);
    return;
  }

  message_vision(HIY"\n$N" HIY"十分警觉的四周看了看，确定没有什么动静！\n"NOR,who);
  return;
}

