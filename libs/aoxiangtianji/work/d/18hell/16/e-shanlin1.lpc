#include <ansi.h>
inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "山林");
  set ("long", @LONG

一条静谧的山林。

LONG);
  set("exits",
  ([
     "west"  : sprintf(__DIR__"e-shanlin%d",1+random(4)),
