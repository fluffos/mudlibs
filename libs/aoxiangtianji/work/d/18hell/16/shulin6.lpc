inherit __DIR__"shulin";
void create ()
{
  set ("short", "树林");
  set ("long", @LONG

树林内虽然静悄悄的，但总让人有危险的感觉。

LONG);
  set("exits",
  ([
     "west" : sprintf(__DIR__"shulin%d",5+random(4)),
