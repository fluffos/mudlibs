#include <ansi.h>
inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "山林");
  set ("long", @LONG

一条静谧的山林。

LONG);
  set("exits",
  ([
     "west"  : sprintf(__DIR__"e-shanlin%d",6+random(4)),
     "east"  : sprintf(__DIR__"e-shanlin%d",6+random(4)),
     "south" : __DIR__"e-shanlu1",
     "north" : __DIR__"e-shanlin7",
  ]));
  setup();
}

