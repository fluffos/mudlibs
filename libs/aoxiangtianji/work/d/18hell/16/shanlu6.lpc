#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "山路");
  set ("long", @LONG

远远向南望去，那个红色的火谷已经只能看到股股黑
烟了。山路还在继续的往深山而去。

LONG);
  set("exits",
  ([
     "south" : __DIR__"shanlu5",
     "north" : "/d/18hell/18/shanlu5",
  ]));
  setup();
}

int valid_leave(object me, string dir)
{
  if (dir == "north" && !playerp(me))
    return 0;
  return ::valid_leave(me, dir);
}

