#include <ansi.h>
inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "山路");
  set ("long", @LONG

小路的边上有个峡谷，那峡谷因为时常有莫名的大火
突然燃烧，而被很多当地的鬼魂称为“火谷”。小路的
两边已经没有什么杂草了。到处都是红色的岩石。

LONG);
  set("exits",
  ([
     "southdown" : __DIR__"shanlu4",
     "north" : __DIR__"shanlu6",
     "west"  : __DIR__"huogu6",
  ]));
  setup();
}

int valid_leave(object me, string dir)
{
  if (dir == "west" && !playerp(me))
    return 0;
  return ::valid_leave(me, dir);
}

