#include <ansi.h>
inherit __DIR__"heitudi";
void create ()
{
  set ("short", HIG"黑土地"NOR);
  set ("long", @LONG

黑黑的土地，泥泞不堪，一股难闻的味道，熏人欲吐！

LONG);
  set("exits",
  ([
     "east" : sprintf(__DIR__"heitudi%d",1+random(8)),
     "west" : sprintf(__DIR__"heitudi%d",1+random(8)),
     "south" : sprintf(__DIR__"heitudi%d",1+random(8)),
     "north" : sprintf(__DIR__"heitudi%d",1+random(8)),
  ]));
  set("dig_oil",1);
  set("fire_dir",sprintf(__DIR__"heitudi%d",4+random(5)));
  setup();
}

