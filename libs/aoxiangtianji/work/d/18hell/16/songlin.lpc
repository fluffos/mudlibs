inherit SMALLROOM;
inherit WOODROOM;
void init()
{
  object me = this_player();
  object where = this_object();
  object songzhi;
  int num;
  string tmp_str;

  if (!playerp(me))
    return;

  num = (int)where->query("number");
  tmp_str = sprintf("18hell/songlin%d",num);
  if (!me->query_temp("18hell/songzhi") &&
      !me->query_temp(tmp_str))
    me->set_temp(tmp_str,1);

  if (num == 4 || num == 8 || num == 12)
  {
    songzhi = present("18hell song zhi",me);
    if (!objectp(songzhi))
    {
      songzhi = present("18hell song zhi",where);
      if (!objectp(songzhi))
      {
        songzhi = new("/d/18hell/obj/songzhi");
        songzhi->move(where,1);
        message_vision("$N被地上的松枝绊了一下，差点摔个四脚朝天！\n",me);
      }

    }

  }

  for (num=1;num<13;num++)
  {
    tmp_str = sprintf("18hell/songlin%d",num);
    if (!me->query_temp(tmp_str))
      break;
  }

  if (num < 13)
    return;

  add_action("do_caiji","caiji");
  add_action("do_make","make");

  where->set ("long", @LONG

松林拣松涛阵阵，山风及体生寒，松树间相互间隔颇远，但这些
松树显然都有了很多的年头了，浓荫把日光都遮蔽了。以赫然发
现一棵十分大的松树，松干上积结成了厚厚的松脂(songzi)，
这些松脂如果采集(caiji)下来，可以和干枯的松枝做成(make)
一个火把。

LONG);
  tell_object(me,"你突然发觉四周有点点不同了！你不由得想停下脚步仔细观察一下。\n");
  me->set_temp("18hell/songzhi",1);
  for (num=1;num<13;num++)
  {
    tmp_str = sprintf("18hell/songlin%d",num);
    me->delete_temp(tmp_str);
  }

}

int do_caiji(string arg)
{
  object me = this_player();
  object songzi;

  if (!arg || (arg != "songzi" && arg != "松脂"))
    return notify_fail("你要采集什么？\n");
  if (!me->query_temp("18hell/songzhi"))
    return notify_fail("这里没有你要采集的东西！\n");
  songzi = present("18hell song oil",me);
  if (objectp(songzi))
    return notify_fail("你身上不是有了吗？\n");
  songzi = new("/d/18hell/obj/song-oil");
  songzi->set("owner",me->query("id"));
  songzi->move(me,1);
  message_vision("$N小心的把松树上的松脂刮了下来，放进自己的口袋！\n",me);
  return 1;
}