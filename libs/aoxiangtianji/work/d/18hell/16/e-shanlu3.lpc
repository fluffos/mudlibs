#include <ansi.h>
inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "山路");
  set ("long", @LONG

到了山峰的脚底，抬头看见一个巨大的平台。平台之上，
各色蟠旗招展。据说那平台乃是“飞升台”，上了平台，
可以飞升到另外的地狱层。

LONG);
  set("exits",
  ([
     "westdown"  : __DIR__"e-shanlu2",
     "eastup"  : __DIR__"feisheng",
  ]));
  setup();
}

int valid_leave(object me, string dir)
{
  mapping duhua;
  if (dir != "eastup")
    return ::valid_leave(me, dir);

  if (!playerp(me))
    return 0;

  duhua = me->query("18hell/hell-18");
  if (!mapp(duhua) || sizeof(duhua) < 1)
  {
    write("你尚未完成第一八地狱（刀锯地狱）的渡化！\n");
    return 0;
  }

  duhua = me->query("18hell/hell-17");
  if (!mapp(duhua) || sizeof(duhua) < 1)
  {
    write("你尚未完成第一七地狱（石磨地狱）的渡化！\n");
    return 0;
  }

  duhua = me->query("18hell/hell-16");
  if (!mapp(duhua) || sizeof(duhua) < 1)
  {
    write("你尚未完成第一六地狱（火山地狱）的渡化！\n");
    return 0;
  }

  return ::valid_leave(me, dir);
}

