#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "小路");
  set ("long", @LONG

一条泥泞的小路。南面有片树林，远远望去，一座破庙
隐约可见。

LONG);
  set("exits",
  ([
     "west" : __DIR__"xiaolu2",
     "east"  : __DIR__"xiaolu4",
     "south" : __DIR__"shulin1"
  ]));
  setup();
}

int valid_leave(object me, string dir)
{
  if (dir == "east" && !playerp(me))
    return 0;
  return ::valid_leave(me, dir);
}

