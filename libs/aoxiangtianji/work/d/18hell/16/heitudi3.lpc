inherit __DIR__"heitudi";
void create ()
{
  set ("short", "黑土地");
  set ("long", @LONG

黑黑的土地，泥泞不堪，一股难闻的味道，熏人欲吐！

LONG);
  set("exits",
  ([
     "east" : sprintf(__DIR__"heitudi%d",1+random(6)),
     "west" : sprintf(__DIR__"heitudi%d",1+random(6)),
     "south" : __DIR__"heitudi4",
     "north" : sprintf(__DIR__"heitudi%d",4+random(3)),
  ]));
  set("fire_dir",sprintf(__DIR__"heitudi%d",3+random(3)));
  setup();
}

