inherit SMALLROOM;
inherit WOODROOM;
void create()
{
  set("short", "密林");
  set("long", @LONG
这是黑森森的一片密林，楠木参天，浓阴蔽日。这里北上
二里是报国寺，南边林间隐藏着一座庙宇。
LONG);
  set("exits", ([
     "north" : __DIR__"bgs",
     "south"  : __DIR__"fhs",
     "westup" : __DIR__"jietuopo",
  ]));

  set("no_clean_up", 0);
  setup();
}

