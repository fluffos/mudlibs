inherit SMALLROOM;
inherit LANDROOM;
inherit TEMPLEROOM;
void create()
{
  set("short", "禅房");
  set("long", @LONG
这里是一间安静宽敞的禅房，乃是千佛庵中弟子打坐修行
之所。地下整整齐齐放着许多蒲团。几位年轻师太和俗家女弟
子正肃容入定。
LONG);
  set("exits", ([
    "west" : __DIR__"qfadadian",
  ]));
  set("no_clean_up", 0);
