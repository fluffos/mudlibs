#include <room.h>
inherit SMALLROOM;
inherit LANDROOM;
inherit SAFTYROOM;
void create()
{
  set("short", "休息室");
  set("long", @LONG
这是福寿庵的休息室，女弟子回山之前通常在此借宿
一宿，好备足体力上山。房内摆有一张桌，靠墙设有
几张木床。
LONG);
  set("exits", ([
    "south" : __DIR__"fsazhaitang",
  ]));
  set("objects", ([
     __DIR__"obj/fojing10" : 1,
     __DIR__"obj/fojing11" : 1,
     __DIR__"obj/fojing20" : 1,
     __DIR__"obj/fojing21" : 1,
  ]));
  create_door("south", "门", "north", DOOR_CLOSED);
  set("sleep_room", 1);
  set("no_clean_up", 0);
  setup();
}

