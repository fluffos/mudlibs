inherit KNOWER;
inherit F_VENDOR;
void create()
{
  set_name("峨嵋小贩", ({ "emei xiao fan", "seller", "fan" }) );
  set("gender", "男性" );
  set("age", 32);
  set("long", "这是个小贩，整天东奔西跑的，知道不少当地的事情。\n");
  set("shen_type", 1);
  set("combat_exp", 300);
  set("str", 17);
  set("dex", 20);
  set("con", 17);
  set("int", 22);
  set("attitude", "peaceful");
  set("vendor_goods", ([
     "1" : "/d/emei/obj/fuchen",
     "2" : "/d/emei/obj/ruanjian",
     "3" : "/d/emei/obj/tianxiang-gao",
     "4" : "/d/emei/obj/yaodai",
     "5" : "/d/emei/obj/ycloth",
     "6" : "/d/emei/obj/zhujian",
  ]) );

  set("chat_chance", 20);
  set("chat_msg", ({
      (:random_move:),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 100);
  if (clonep())
    keep_heart_beat();
}

void init()
{
  add_action("do_vendor_list", "list");
}

