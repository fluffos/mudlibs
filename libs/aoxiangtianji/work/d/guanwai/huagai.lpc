// /guanwai/huagai.c
#include <ansi.h>
inherit BIGROOM;
inherit HILLROOM;
void create()
{
  set("short", "华盖峰");
  set("long", @LONG
长白东侧最高峰，自古以来，华盖峰就是风雨云雾的故道。云雾起处，
恰似掀开锅盖一般，雾气翻滚，池水云天，一脉相连，气壮华夏，故名华盖
峰。山峰下面，是一望无际的茫茫冰川，从上望下看，峭壁陡立，冰雪覆盖，
山峰下面云气迷茫，从这里攀爬而下，几不可能。传说曾有陨石从天际直落
冰川，千百年来，不知是否还在？如若冒险跳(jump)下，只恐怕会尸骨无存。
LONG );
  set("exits", ([
    "north"     : __DIR__"tianhuo",
    "westdown"  : __DIR__"tianchi1",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "guanwai");
  setup();
}

void init()
{
  add_action("do_jump",({"jump","tiao"}));
}

int do_jump(string arg)
{
  object *inv , where;
  int i;
  object me = this_player(1);

  if (!arg || arg != "down")
  {
    write("你要往哪儿跳？\n");
    return 1;
  }

  if (me->query_temp("is_riding"))
  {
    write("你先下了坐骑吧！\n");
    return 1;
  }

  if (me->query_skill("dodge",1) < 200)
  {
    write("你的轻身功夫不到家，这样跳下去，和寻死无异！\n");
    return 1;
  }

  inv = all_inventory(me);
  i = sizeof(inv);
  while (i--)
  {
    if (inv[i]->is_character())
    {
      write("这么高的山峰，你背个活人往下跳，看来是不想活了！\n");
      return 1;
      break;
    }

  }

  where = find_object("/d/guanwai/binggu");
  if (!objectp(where))
    where = load_object("/d/guanwai/binggu");
  if (!objectp(where))
  {
    write("你想往下跳，可惜看来找不对地方！\n");
    return 1;
  }

  inv = all_inventory(where);
  i = sizeof(inv);
  while (i--)
  {
    if (inv[i]->is_character() && playerp(inv[i]))
    {
      write("下面有人了，这样跳下去，实在是危险啊，砸不死他，也说不定砸死自己！\n");
      return 1;
      break;
    }

  }

  message_vision("$N往下看了看，想起陨石的传说，决心一探究竟！闭上双眼，不顾一切的往下跳！\n",me);
  me->move(where);
  me->receive_damage("kee",me->query("max_kee")/2);
  me->receive_wound("kee",me->query("max_kee")/2);
  me->receive_damage("sen",me->query("max_sen")/2);
  me->receive_wound("sen",me->query("max_sen")/2);
  message_vision("$N连滚带爬的从上面跌落了下来，真是遍体鳞伤啊！\n",me);
  return 1;
}

