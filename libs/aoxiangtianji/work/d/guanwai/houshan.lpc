// /guanwai/houshan.c
inherit MIDDLEROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "后山");
  set("long", @LONG
从这里一转弯就上了后山。后山一个不起眼的地方，似乎有个
小山洞(dong)，一些杂物把山洞的门给挡住了。
LONG );
  set("exits", ([
    "northwest" : __DIR__ "tulu",
  ]));
  set("item_desc", ([
    "dong" : "一个用杂物掩藏起来的山洞。"
             "\n山洞有个小门，要进去看来得打开(break)这个破烂的门了。\n",
     ]) );
  set("outdoors", "guanwai");
  setup();
}

void init()
{
  add_action("do_break",({"dakai","break"}));
  add_action("do_open","open");
}

int do_break(string arg)
{
  object *inv;
  int sizeinv ;
  object who = this_player();

  if (!arg || (arg != "door" && arg != "石门"))
  {
    write("你要打开什么？\n");
    return 1;
  }

  if (objectp(who->query_temp("is_riding")))
  {
    write("你还是先下了坐骑吧！\n");
    return 1;
  }

  inv = all_inventory(who);
  sizeinv=sizeof(inv);
  while (sizeinv--)
  {
    if (inv[sizeinv]->is_character())
    {
      write("可惜你背了个活人，无法用力！\n");
      return 1;
      break;
    }

  }

  message_vision("$N暗暗吸了口气，用力的一推那个小门！\n",who);

  if (who->query_skill("force",1) < 100 ||
      who->query_skill("unarmed",1) < 100)
  {
    message_vision("$N用力推门，可惜小门竟然动都不动！\n",who);
    return 1;
  }

  message_vision("那小门突然开了一道缝隙，$N身不由己掉了进去！\n",who);
  who->move(__DIR__"shandong1");
  return 1;
}

int do_open(string arg)
{
  if (!arg || arg != "door")
  {
    write("你要打开什么？\n");
    return 1;
  }

  write("那门不用点力气，看来是无法打开(break)它的！\n");
  return 1;
}

