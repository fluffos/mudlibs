// /guanwai/tianchi2.c
inherit BIGROOM;
inherit WATERROOM;
#include "/obj/quarry/snareroom.lpc"
void create()
{
  set("short", "白头山天池");
  set("long", @LONG
天池十天九雾，云蒸雾绕，变幻无穷。瞬息万变的雾霭风雨，使天池时
而清亮如蓝天明镜，时而缥缈如轻莹薄纱，时而腾跃如大海波涛，景色大观
令人神往。
LONG );
  set("exits", ([
   "north"    : __DIR__"tianchi1",
  ]));
  set("quarrys", ([
   "ji"     : 100000,
   "yang3"  : 50000,
   "he2"    : 50000,
   "xiong"  : 10000,
  ]));
  set("outdoors", "guanwai");
  setup();
}

