#include <ansi.h>
inherit NPC;
void create()
{
  set_name("参客", ({ "shen ke", "shen", "ke" }));
  set("long", "他是一个参客，常年在关外经营，颇为富有。\n");
  set("age", 65);
  set("combat_exp", 300);
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("int", 30);
  set("attitude", "friendly");
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

