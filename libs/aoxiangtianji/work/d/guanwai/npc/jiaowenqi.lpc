// /jiaowenqi.c
#include <ansi.h>
inherit NPC;
void create()
{
  set_name("焦文期", ({ "jiao wenqi", "jiao" }));
  set("long",@LONG
他是关外六魔中的三魔焦文期。背上一把铁琵琶，是武林中少见的奇门兵器。
LONG );
  set("nickname", HIC "关外三魔" NOR);
  set("gender", "男性");
  set("age", 36);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 50);
  set("int", 20);
  set("con", 30);
  set("dex", 20);
  set("max_kee", 1200);
  set("max_sen", 500);
  set("force", 1200);
  set("max_force", 1200);
  set("force_factor", 100);
  set("combat_exp", 170000);
  set("score", 20000);
  set_skill("force", 110);
  set_skill("dodge", 110);
  set_skill("unarmed", 110);
  set_skill("parry", 110);
  set_skill("hammer", 120);
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  carry_object(__DIR__"obj/tiepipa")->wield();
  add_money("silver",40);
}