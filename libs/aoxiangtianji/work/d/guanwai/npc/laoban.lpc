// laoban.c
inherit NPC;
inherit F_VENDOR;
void create()
{
  set_name("酒馆老板", ({ "lao ban" }) );
  set("gender", "男性" );
  set("age", 32);
  set("long","这位酒馆老板满身狗肉香，点头哈腰着对你笑着。\n");
  set("combat_exp", 500);
  set("attitude", "friendly");
  set("no_get", "1");
  set("vendor_goods", ([
        "1" : __DIR__"obj/gourou",
        "2" : __DIR__"obj/gouroutang",
        "3" : __DIR__"obj/map",
        "4" : "/d/guanwai/obj/wan",
        "5" : "/d/guanwai/obj/mantou",
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  ::init();
  add_action("do_vendor_list", "list");
}