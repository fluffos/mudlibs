inherit MIDDLEROOM;
inherit SNOWROOM;
void create()
{
  set("short", "北城");
  set("long", @LONG
这里是用黄土铺就的街道，街上的行人不多，看起来很冷清。偶尔有几
个身着异域服饰的行人走过，看起来是满族，鲜祖的居民。西面有一条幽深
的小巷，不知通向何处。
LONG );
  set("exits", ([
    "south" : __DIR__"jishi",
    "west"  : __DIR__"xiaoxiang",
    "east"  : __DIR__"business_shop",
    "north" : __DIR__"b_biaoju",
  ]));
  set("objects", ([
    sprintf("/d/city/npc/xiucai%d",1 + random(3)) : 1,
    "/obj/npc/walker" : 1,
  ]));
