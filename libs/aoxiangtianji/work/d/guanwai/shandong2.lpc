#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "洞内");
  set("long", @LONG
这里阴风瑟瑟，一片漆黑,什么也看不见。唯有洞外方向透过一丝
光亮。看来没有点火是无法前行了。
LONG);
  set("exits",([
    "southwest"   : __DIR__"shandong1",
  ]));
  set("next_p",__DIR__"shandong3");
  setup();
}

void init()
{
  add_action("do_use","use");
  add_action("do_zou","zou");
}

int do_use(string arg)
{
  object me,fire;
  me = this_player();
  if (! arg || arg != "fire")
    return 0;
  fire = present("fire", me);
  if (! objectp(fire))
    return 0;
  if (me->query_temp("marks/走1"))
    return notify_fail("你不时正举着个火折子吗？\n");

  if (arg == "fire" )
  {
    write(HIW"\n你点燃了火折，发现洞中似乎有一条路可以顺着走(zou)下去。\n\n"NOR);

    delete("long");
    set("long",@LONG
借着火光你看到洞中怪石嶙峋，前方出现一条路不知通向
何处。
LONG);

    me->set_temp("marks/走1", 1);
    destruct(fire);
    return 1;
  }

  return 0;
}

int do_zou(string arg)
{
  object me;
  me = this_player();
  if (me->query_temp("marks/going"))
  {
    write("你不是正在往前走吗？当心碰了头！\n");
    return 1;
  }

  if (me->query_temp("marks/走1") )
  {
    tell_object(me, HIR "\n你拿着火折顺着路不停地走...\n\n" NOR);
    me->set_temp("marks/going",1);
    call_out("enter_next", 1);
    return 1;
  }

  else
  {
    write("你眼前黑漆漆的，什么都看不见，想往哪儿走？\n");
    return 1;
  }

}

void enter_next()
{
  string p;
  object me = this_player();
  if (!playerp(me) || environment(me) != this_object())
    return;

  if (me->query_temp("marks/go_num") < 6)
  {
    tell_object(me, HIW "这条路弯弯曲曲，你感觉走了很久。。。\n\n" NOR);
    me->add_temp("marks/go_num",1);
    call_out("enter_next",1);
    return;
  }

  tell_object(me, HIW "你眼前突然一黑，原来是火折子灭了，看来已经走了段距离了。。。\n\n" NOR);
  me->delete_temp("marks/go_num");
  me->delete_temp("marks/走1");
  me->delete_temp("marks/going");
  p = query("next_p");
  me->move(p);
  return;
}

