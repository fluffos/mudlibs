inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "山洞");
  set("long", @LONG

眼前是个空旷的洞厅，看来是到了山洞的中腹地带了。
在左边的墙壁上，似乎有个石门（door）。
LONG );
  set("exits", ([
    "south" : __DIR__"shandong4",
  ]));
  set("item_desc", ([
     "door" : "一道奇怪的石门，要打开看来不是那么容易的。\n"
              "仔细查看，却发现在门的右下方，一些泥土似乎显得异样的新鲜。\n"
              "也许在那里搜索一番，会有所发现！\n\n",
     ]) );
  set("baowu",1);
  setup();
}

void init()
{
  add_action("do_break",({"dakai","break"}));
  add_action("do_open","open");
  add_action("do_search",({"search","shousuo","sousuo","xunzhao"}));
}

int do_break(string arg)
{
  object *inv;
  int sizeinv ;
  object who = this_player();

  if (!arg || (arg != "door" && arg != "石门"))
  {
    write("你要打开什么？\n");
    return 1;
  }

  if (objectp(who->query_temp("is_riding")))
  {
    write("你还是先下了坐骑吧！\n");
    return 1;
  }

  inv = all_inventory(who);
  sizeinv=sizeof(inv);
  while (sizeinv--)
  {
    if (inv[sizeinv]->is_character())
    {
      write("可惜你背了个活人，无法用力！\n");
      return 1;
      break;
    }

  }

  message_vision("$N暗暗吸了口气，运足全身的力气，扎好步子，用力的推了推石门！\n",who);

  if (who->query_skill("force",1) < 200)
  {
    tell_object(who,"可惜那石门象生了根一般，动都不动，反而一股强力从石门反击了回来，重重的撞在了你的胸口！\n");
    message_vision("看来$N用尽了吃奶的力气也无法推开这石门，自己反被石门用力的弹了开去！\n",who);
    who->receive_damage("kee",who->query("max_kee")/2);
    who->unconcious();
    return 1;
  }

  if (random(3))
  {
    message_vision("$N一张脸憋得通红，那石门微微晃了晃，竟然没有什么动静！\n",who);
    tell_object(who,"一股力道从石门反击了回来，重重的撞击在你的胸口！\n");
    who->receive_damage("kee",who->query("max_kee")/2);
    who->unconcious();
    return 1;
  }

  message_vision("那石门突然闪开了一道缝隙，$N身不由己得直跌了进去！\n",who);
  who->move(__DIR__"neidong");
  return 1;
}

int do_open(string arg)
{
  if (!arg || arg != "door")
  {
    write("你要打开什么？\n");
    return 1;
  }

  write("那石门仿佛生根一般，看起来笨重而厚实，不用点力气，看来是无法打开(break)它的！\n");
  return 1;
}

int do_search(string arg)
{
  int num;
  object ob;
  object who = this_player(1);

  if (who->is_busy() || who->is_fighting())
  {
    write("你正忙着呢！\n");
    return 1;
  }

  message_vision("$N仔细看了看，决定把那堆泥土挖开看看！\n",who);
  num = who->query_temp("search_time");
  if (!num || random(num + 1) < 10)
  {
    tell_object(who,"你没有发现任何东西！只是有种感觉让你觉得应该继续寻找下去！\n");
    message_vision("看起来$N一无所获！\n",who);
    who->add_temp("search_time",1);
    who->start_busy(2+random(3));
    return 1;
  }

  if (query("baowu"))
  {
    ob = new("/d/item/obj/jingtie");
    ob->set("owner",who->query("id"));
    ob->move(who,1);
    set("baowu",0);
    message_vision("$N突然一阵狂喜，看来有所收获！\n",who);
    tell_object(who,"你得到了一块百年精铁！\n");
    remove_call_out("regen");
    call_out("regen",1800);
    return 1;
  }

  message_vision("$N一脸失望，看来这里已经没有东西值得发现的了！\n");
  tell_object(who,"显然，这里没有任何东西值得去发掘了！\n");
  who->start_busy(2+random(3));
  return 1;
}

void regen()
{
  set("baowu",1);
}

