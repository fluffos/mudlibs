#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
#define XUANTIE  "/d/item/obj/xuantie"
string look_keng();
string look_desk();
void create()
{
  set("short", "内洞");
  set("long", @LONG

这里阴风瑟瑟，一片漆黑,什么也看不见。一股腥风扑鼻而来，
看来这里似乎有怪兽出没。
LONG );
  set("exits",([
     "out" : __DIR__"shandong5",
  ]));
  set("objects", ([
     "/obj/beast/mangshe" : 1,
  ]));
  set("item_desc",([
    "desk" : ( :look_desk: ),
    "keng" : ( :look_keng: ),
  ]));
  setup();
}

void init()
{
  add_action("do_use","use");
  add_action("do_move", "move");
  add_action("do_pick", "pick");
}

int do_use(string arg)
{
  object me, fire, snake;
  me = this_player(1);
  if (!arg || arg != "fire")
    return 0;
  fire = present("fire",me);
  if (!objectp(fire))
    return 0;

  if (me->is_busy() || me->is_fighting())
  {
    write("你正忙着呢！\n");
    return 1;
  }

  message_vision("$N点着了一个火折子，开始仔细检查这个山洞！\n",me);
  destruct(fire);
  me->set_temp("dongnei_fire",1);
  delete("long");
  set("long",@LONG
借着火光你发现在洞的左边摆放着一个石桌(desk)。显然这里有人来过。
LONG);
  seteuid(getuid());
  snake = new("/obj/beast/bingshe");
  snake->move(this_object());
  message_vision("$N突然看到了一条浑身雪白的怪蛇，正冷冷的看着$N！\n",me);
  snake->kill_ob(me);
  return 1;
}

int do_move(string arg)
{
  object me,here;
  me = this_player();
  if (!me->query_temp("dongnei_fire"))
  {
    write("你什么都看不见！\n");
    return 1;
  }

  if (! here = find_object(__DIR__"neidong"))
    here = load_object(__DIR__"neidong");
  if (! arg || (arg != "desk" && arg != "石桌"))
    return notify_fail("你想移什么？\n");

  if (here->query_temp("marks/移"))
  {
    write(HIG "\n你用力一推，将石桌移回了原处。\n\n" NOR);
    here->delete_temp("marks/移");
    return 1;
  }

  write(HIC "\n你用力一推，石桌下面竟露出一个坑(keng)来。\n\n"NOR);
  here->set_temp("marks/移", 1);
  return 1;
}

int do_pick(string arg)
{
  object here, baowu, me;
  me = this_player();
  if (! here = find_object(__DIR__"neidong"))
    here = load_object(__DIR__"neidong");
  if (! arg || (arg != "stone"))
    return notify_fail("你要拿什么？\n");

  if (here->query_temp("marks/拿") || ! here->query_temp("marks/移"))
     return notify_fail("你要拿什么？\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  baowu = find_object(XUANTIE);
  if (!objectp(baowu))
    baowu = load_object(XUANTIE);
  if (! environment(baowu))
  {
    baowu->move(me, 1);
    baowu->set("owner",me->query("id"));
    message_vision(HIC "$N" HIC "从坑中将" + baowu->query("name") +
                            HIC "拿了出来。\n" NOR, me);
    return 1;
  }

  else
    return notify_fail(YEL "这里面什么也没有。\n" NOR);
  me->start_busy(2);
  return 1;
}

string look_desk()
{
  object me,here;
  me = this_player();
  if (!me->query_temp("dongnei_fire"))
    return "你什么都看不见！\n";

  if (! here = find_object(__DIR__"neidong"))
    here = load_object(__DIR__"neidong");
  if (here->query_temp("marks/移"))
    return WHT "\n石桌像是已被人推开，下面露出一个坑(keng)来。\n";
  else
    return WHT "\n一张石桌，上面已布满了灰尘。不知道是否可以移动(move)一下？\n";
}

string look_keng()
{
  object me, here, baowu;
  me = this_player();
  if (!me->query_temp("dongnei_fire"))
    return "你什么都看不见！\n";

  baowu = find_object(XUANTIE);

  if (! here = find_object(__DIR__"neidong"))
    here = load_object(__DIR__"neidong");
  if (! here->query_temp("marks/移"))
    return "你要看什么？\n\n";
  if (!objectp(baowu))
    baowu = load_object(XUANTIE);
  if (environment(baowu))
    return HIY "\n这个坑中像是藏东西的，但里面空空如也，显然里面的东西已\n"
               "被人拿走了。\n" NOR;
  return HIY "\n只见里面放着一块闪闪发光的石头(stone)，你忍不住想拿(pick)来看看。\n" NOR;
}

void reset()
{
  object here;

  if (! here = find_object(__DIR__"neidong"))
        here = load_object(__DIR__"neidong");
  ::reset();
  here->delete_temp("marks/移");
  here->delete_temp("marks/拿");
  return ;
}

