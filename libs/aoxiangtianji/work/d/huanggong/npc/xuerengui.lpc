inherit NPC;
#include <ansi.h>
#include "greeting.h"
int is_xue()
{
  return 1;
}

void create()
{
  set_name("薛仁贵", ({ "xue rengui", "xue", "rengui" }) );
  set("gender", "男性");
  set("age", 35);
  set("long","薛仁贵是长安城九门提督，负责皇宫内外安全。\n");
  set("combat_exp", 8000000);
  set("daoxing", 8000000);
  set("title", HIR"九门提督"NOR);
  set("nickname", HIY"勇冠三军"NOR);
  set("attitude", "friendly");
  set("per", 25);
  set("str", 35);
  set("max_kee", 9000);
  set("max_gin", 9000);
  set("max_sen", 9000);
  set("max_mana", 3000);
  set("mana", 5000);
  set("force", 5000);
  set("max_force", 3000);
  set("force_factor", 80);
  set_skill("spear", 280);
  set_skill("unarmed", 280);
  set_skill("changquan", 280);
  set_skill("parry", 280);
  set_skill("dodge", 280);
  set_skill("bawang-spear", 350);
  set_skill("yanxing-steps", 280);
  set_skill("spells", 280);
  set_skill("baguazhou", 280);
  map_skill("spear", "bawang-spear");
  map_skill("parry", "bawang-spear");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed", "changquan");
  map_skill("spells", "baguazhou");
  setup();
  carry_object("/d/obj/weapon/spear/tiespear")->wield();
  carry_object("/d/obj/armor/armor/tongjia")->wear();
}

void init ()
{
  greeting2(this_player());
}

int accept_fight(object me)
{
  command("say 我为殿前将军，岂能与你村野匹夫较艺！");
  return 0;
}

