inherit MIDDLEROOM;
inherit LANDROOM;
inherit SAFTYROOM;
void create()
{
  set ("short", "后殿");
  set ("long", @LONG
后殿里陈列着百鸟绣花图，四周是常春花卉。窗外滴水潺潺，
屋内香火缈缈，放着几只精制紫色香木几。往北就是皇宫的
北门了，只是这里是禁宫，想从这里出宫，看来是不可能的
了。
LONG);
  set("exits", ([
    "south" : __DIR__"hg-dadian",
  ]));
  set("objects", ([
    __DIR__"npc/shinu" : 2,
  ]));

  setup();
}

