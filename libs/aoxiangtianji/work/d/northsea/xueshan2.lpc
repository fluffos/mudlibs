inherit BIGROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "雪山");
  set ("long", @LONG
雪山之上，朔风凌厉。踩着厚厚的积雪，道路十分难行。
山上远望，北海的海面飘浮着一块块的浮冰，在阳光的映射下，
分外刺目。
LONG);
  set("exits", ([
    "southup" : __DIR__"xueshan3",
    "northdown" : __DIR__"xueshan1",
  ]));
  set("outdoors", "northsea");
  setup();
}