{
  set ("short", "海边");
  set ("long", @LONG
北海岸边碧波万顷，海浪温柔的拍打着脚底的白沙，
一切显得安宁而浪漫。南面的雪山上，冷冽的寒风呼啸
着吹了下来。
LONG);
