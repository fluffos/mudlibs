inherit BIGROOM;
inherit WATERROOM;
void create ()
{
  set ("short", "海底");
  set ("long", @LONG
到了一个水中世界。你正迷惑间，突然看见前面站立
着两个海底夜叉，虎视眈眈的看着你。
LONG);
  set("objects", ([
    "/d/eastsea/npc/yecha" : 2,
  ]));

  set("exits", ([
    "up"    : __DIR__"seashore",
    "north" : __DIR__"under2",
  ]));
  setup();
}

int valid_leave(object me,string dir)
{
  object yecha = present("ye cha",this_object());

  if(dir == "north" && (string)me->query("family/family_name")!="东海龙宫")
    if (objectp(yecha) && living(yecha))
      return notify_fail("夜叉大喝了一声，这里是南海龙宫所在，闲人请速速离开！\n");
  return ::valid_leave(me,dir);
}