inherit SMALLROOM;
inherit HILLROOM;
void create()
{
  set("short", "山道");
  set("long", @LONG
山路渐渐平坦了很多，路边的野花越发的繁茂起来。不知何
处的小溪，叮咚叮咚的流淌！
LONG );
  set("exits", ([
    "northeast" : __DIR__"e-shanlu3",
    "east" : __DIR__"e-shanlu5",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "taishan");
  setup();
}

