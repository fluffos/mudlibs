inherit MIDDLEROOM;
inherit HILLROOM;
void create()
{
  set("short", "石经峪");
  set("long", @LONG
这里是一块大石坪，石面刻有篆文「金刚经」，字体其大如斗，
但却没有记载刻石者的名字和刻石的年代。过了此处，渐入空山，
山路越来越不好走了。
LONG );
  set("exits", ([
    "northup" : __DIR__"huima",
    "westdown" : __DIR__"doumo",
  ]));
  set("objects",([
    sprintf("/obj/npc/seng%d",1+random(3)) : 1,
  ]));

  set("outdoors", "taishan");
  setup();
}