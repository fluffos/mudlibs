inherit MIDDLEROOM;
inherit HILLROOM;
void create()
{
  set("short", "宝藏岭");
  set("long", @LONG
这里是泰山的一个名胜。岭上有一座状似狮子的巨石，称为狮
子崖(shiziya)。最出名的还是要数在东北面的东岳庙，也称上
岳庙，是古代封禅的地方，那里有一块唐玄宗的纪泰山铭。
LONG );
  set("exits", ([
    "westup" : __DIR__"bixia",
  ]));
  set("item_desc",([
     "shiziya" : "狮子崖上古木苍苍，不知道藏有什么？\n"
                 "这悬崖似乎可以爬(climb)上去，虽然看上去十分的峻峭。\n",
      ]) );
  set("outdoors", "taishan");
  set("no_clean_up", 0);
  setup();
}

void init()
{
  add_action("do_pa",({"pa","climb"}));
}

int do_pa(string arg)
{
  object me = this_player();
  object ridee;

  if (!arg || arg != "up")
    return notify_fail("你要往什么方向爬？\n");

  if (objectp(ridee = me->query_temp("is_riding")))
    return notify_fail("你还是先下了坐骑吧！\n");
  if (me->query_skill("dodge",1) < 150)
  {
    message_vision("$N不顾一切的往上就爬，手脚并用，可惜似乎不够敏捷，转眼就掉了下来！\n",me);
    me->receive_wound("kee",me->query("max_kee")/3);
    message_vision("$N从上面掉了下来，重重的摔在地上，转眼就晕了过去！\n",me);
    me->unconcious();
    return 1;
  }

  if (random(3))
  {
    message_vision("$N往上就爬，手脚并用，可惜一个不留神，竟掉了下来！\n",me);
    me->receive_wound("kee",me->query("max_kee")/3);
    message_vision("$N从上面掉了下来，重重的摔在地上，转眼就晕了过去！\n",me);
    me->unconcious();
    return 1;
  }

  message_vision("$N小心翼翼的爬到了狮子崖上！\n",me);
  me->move(__DIR__"shiziya",1);
  message_vision("$N从上面爬了上来！\n",me);
  return 1;
}

