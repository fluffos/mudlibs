inherit SMALLROOM;
inherit HILLROOM;
void create()
{
  set("short", "山道");
  set("long", @LONG
一条弯弯曲曲的小山道，两边是幽静的山林，耳边有小鸟的鸣唱。
路边时常可见到小溪潺潺，山风掀起松涛阵阵。
LONG );
  set("exits", ([
    "west" : __DIR__"dongtian",
    "eastdown" : __DIR__"e-shanlu2",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "taishan");
  setup();
}