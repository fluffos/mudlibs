inherit SMALLROOM;
inherit HILLROOM;
void create()
{
  set("short", "山道");
  set("long", @LONG
一条弯弯曲曲的小山道，两边是幽静的山林，耳边有小鸟的鸣唱。
路边时常可见到小溪潺潺，山风掀起松涛阵阵。这里已经看不到
任何游人了。小道弯曲崎岖，连你自己也不禁担心起迷路来。
LONG );
  set("exits", ([
    "northwest" : __DIR__"e-shanlu2",
    "southwest" : __DIR__"e-shanlu4",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "taishan");
  setup();
}

