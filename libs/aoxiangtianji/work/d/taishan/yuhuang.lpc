inherit BIGROOM;
inherit HILLROOM;
void create()
{
  set("short", "玉皇顶");
  set("long", @LONG
此处便是泰山绝顶。这里有一座玉帝观，观前为古登封台，厉
代皇帝封禅的仪式都是在这里举行。台下有一无字碑，据说是汉武
帝所立。不远处有一石碣，上书「孔子小天下处」。
LONG );
  set("exits", ([
    "southdown" : __DIR__"nantian",
    "eastdown"  : __DIR__"riguan",
    "west"      : __DIR__"zhangren",
  ]));
  set("outdoors", "taishan");
  setup();
}

