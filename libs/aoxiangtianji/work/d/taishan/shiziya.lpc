inherit MIDDLEROOM;
inherit WOODROOM;
inherit SAFTYROOM;
void create()
{
  set("short", "狮子崖");
  set("long", @LONG
狮子崖上，古木参天，浓郁的树阴遮挡了阳光，鸟儿轻柔的吟唱。
随意在这古木林中徜徉，一些巨大的古木(wood)色彩似乎有所不同。
LONG );
  set("item_desc",([
     "wood" : "这些古木看上去十分的坚韧。用手敲敲，竟然发出金石的声音。\n"
              "看来这些木头用来做盾牌十分合适，只是要砍伐(famu)一些，似乎不太容易。\n",
  ]) );
  set("outdoors", "taishan");
  set("no_clean_up", 0);
  setup();
}

void init()
{
  add_action("do_famu",({"cut","famu"}));
}

int do_famu(string arg)
{
  object me=this_player();
  object ob;

  if( !arg || (arg == "wood" && arg == "古木"))
    return notify_fail("你要砍什么？\n");

  if (me->is_busy())
    return notify_fail("你现在正忙着呢。");
  if( !(ob = me->query_temp("weapon"))|| (string)ob->query("skill_type") != "axe")
    return notify_fail("先去找把斧头吧！\n");
  if( me->query("kee") < (int)(me->query("max_kee")/3))
    return notify_fail("再砍下去手都要磨破了！\n");
  message_vision("$N朝古木使劲儿砍去。\n", me);
  if ((int)me->query_skill("unarmed", 1) < 150 ||
      (int)me->query_skill("force", 1) < 150)
  {
    tell_object(me,"可惜你的力道不够！这古木动都不动一下！自己反而双臂发麻！\n");
    if (!me->is_busy())
      me->start_busy(2);
    return 1;
  }

  if (random(4))
  {
    message_vision("$N一斧砍在古木上，那古木晃动了几下。只留下一道斧痕。\n",me);
    me->receive_damage("kee",me->query("max_kee")/3);
    if (!me->is_busy())
      me->start_busy(2);
    tell_object(me,"你只觉得一个大力重重的撞击在胸口，只觉得气血一阵翻腾。双臂都麻木了。\n");
    return 1;
  }

  message_vision("$N猛力一斧，那古木竟然“轰”的一声，一块木头飞溅了下来。\n",me);
  seteuid(getuid());
  ob = new("/d/item/obj/gumu");
  ob->move(me,1);
  ob->set("owner",me->query("id"));
  message_vision("$N赶紧把古木捡起。\n");
  tell_object(me,"你得到了一块古木。\n");
  return 1;
}

