inherit MIDDLEROOM;
inherit HILLROOM;
void create()
{
  set("short", "天街");
  set("long", @LONG
此地在南天门东北，这里有数十户小贩聚而成市。从这里往东
南走便是莲花峰，东北是围屏山，从西而下便回到南天门。
LONG );
  set("exits", ([
    "westdown" : __DIR__"nantian",
    "northeast" : __DIR__"weipin",
    "southeast" : __DIR__"lianhua",
  ]));
  set("objects",([
    "/obj/npc/tiaofu" : 1,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "taishan");
  setup();
}

