#include <ansi.h>
inherit __DIR__"gift";
void create()
{
  set_name(HIW "玄王彻地丹" NOR, ({ "xuanwang dan", "xuanwang", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIW "这是一颗纯白无暇的药丸，据说吃了可以增强灵性。\n" NOR);
    set("base_unit", "颗");
    set("base_value", 50000);
    set("base_weight", 50);
    set("only_do_effect", 1);
    set("gift_type", "spi");
    set("gift_name", "先天灵性");
    set("gift_point", 65);
    set("gift_msg", HIY "突然间你只觉天地间一切都充满了灵气。\n" NOR);
  }

  setup();
}