#include <ansi.h>
inherit __DIR__"gift";
void create()
{
  set_name(HIY "万古灵元仙丹" NOR, ({ "wangu xiandan", "wangu",
                                     "xiandan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIY "传说此丹乃是天地间的圣品，凡人吃了可以平增灵性。\n" NOR);
    set("base_unit", "颗");
    set("base_value", 100000);
    set("base_weight", 50);
    set("only_do_effect", 1);
    set("gift_type", "spi");
    set("gift_name", "先天灵性");
    set("gift_point", 85);
    set("gift_msg", HIY "突然间你只觉双眼透出万道灵气，天地似乎变得更加透彻了。\n" NOR);
  }

  setup();
}