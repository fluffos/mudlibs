#include <ansi.h>
inherit __DIR__"gift";
void create()
{
  set_name(NOR + WHT "幸运草" NOR, ({ "xingyun cao", "xingyun", "cao" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", WHT "这是一棵灰色的小草，据说吃了可以获得幸运。\n" NOR);
    set("base_unit", "棵");
    set("base_value", 10000);
    set("base_weight", 50);
    set("only_do_effect", 1);
    set("gift_type", "kar");
    set("gift_name", "先天福缘");
    set("gift_point", 40);
    set("gift_msg", HIM "你只觉得一个清凉透体而下，好象舒服了很多。\n" NOR);
  }

  setup();
}

