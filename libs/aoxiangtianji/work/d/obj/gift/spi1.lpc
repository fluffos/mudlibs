#include <ansi.h>
inherit __DIR__"gift";
void create()
{
  set_name(HIG "通灵丸" NOR, ({ "tongling wan", "tongling", "wan" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIG "这是一颗淡黄色通体浑圆的药丸，据说吃了可以增强灵性。\n" NOR);
    set("base_unit", "颗");
    set("base_value", 10000);
    set("base_weight", 50);
    set("only_do_effect", 1);
    set("gift_type", "spi");
    set("gift_name", "先天灵性");
    set("gift_point", 40);
    set("gift_msg", HIY "突然间你只觉一股清气从头顶直归与脚底，天地似乎变得更加清澈了。\n" NOR);
  }

  setup();
}