#include <skill.h>
#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;
void create()
{
  set_name(HIY"如意黄金宝塔"NOR, ({"huangjin baota", "baota", "ta", "fabao"}));
  set_weight(8000);
  if(clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一座三十三层玲珑透剔舍利子如意黄金宝塔。\n");
    set("unit", "座");
    set("value", 100000);
    set("no_put",1);
    set("no_sell",1);
    set("unique", 1);
    set("replace_file", "/obj/money/silver");
    set("time_available", 3);
  }

  set("is_monitored", 1);
  setup();
}

int ji_ob(object victim)
{
  object fabao=this_object();
  object me=this_player();
  int spi, result, damage;
  string msg;
  if( me->is_busy() )
    return notify_fail("你正忙着呢，无法祭出如意黄金宝塔。\n");
  if( !victim )
    return notify_fail("你想祭的人不在这里。\n");
  if( !me->is_fighting() )
    return notify_fail("只有战斗中才能祭如意黄金宝塔。\n");
  if( (int)me->query("mana") < 1000 )
    return notify_fail("你的法力不能控制如意黄金宝塔。\n");
  if( (int)me->query("sen") < 600 )
    return notify_fail("你现在神智不清，很难驾驭如意黄金宝塔。\n");
  msg = HIC"\n$N" HIC"大喊一声“看塔！”，手一挥，祭出了" +
        fabao->name() + HIC"。。。\n"NOR;
  msg += fabao->name() + HIC"「呼」地一下飞到半空，发出玲珑七"
        "彩之光，层层现佛，艳艳光明。\n突然间光华闪出，如泰山"
        "压顶般向$n" HIC"砸去。\n"NOR;
  message_vision(msg, me, victim);
  if (userp(me) && userp(victim) && !victim->is_want_kill(me->query("id")))
     me->want_kill(victim);
  me->kill_ob(victim);

  if (living(victim) && ! userp(victim))
    victim->kill_ob(me);
  else
    victim->fight_ob(me);

  me->add("mana", -500);
  me->receive_damage("sen", 100);
  me->start_busy(1+random(3));
  spi = fabao->query("time_available") *10;
  fabao->add("time_available", -1);
  result = SPELL_D->attacking_cast_success(me,victim,105 + random(spi));
  if (result < 0)
  {
    message_vision(HIC"\n$N" HIC"大喝一声“收！”，只见$n"
                   HIC"光华大盛！但一闪再闪之下终于乖乖地飞到了$N"
                   HIC"手中。\n"NOR, victim, fabao);
    fabao->move(victim);
  }

  else if( result == 0)
  {
    message_vision(HIC"\n$N" HIC"机警的后退几步，$n" HIC"砸了个空。\n"NOR, victim, fabao);
  }

  else
  {
    damage = 300 + (int)me->query("mana_factor")*3;
    damage -= random((int)victim->query("mana_factor") + 1);
    damage += (int)me->query("mana")/15;
    damage -= random((int)victim->query("mana")/15 + 1);
    damage += damage*spi/100;

    if( damage < 0 ) damage = 0;
    if( damage > 2000 ) damage = 2000;
    if (wizardp(me))
      tell_object(me,sprintf("damage = %d\n",damage));
    if( damage > 0 )
    {
      message_vision(HIC"\n结果$N躲闪不及，被砸了个正着！\n"NOR,victim);
      victim->receive_damage("sen", damage,me);
      victim->receive_wound("sen", random(damage)+1,me);
      COMBAT_D->report_sen_status(victim);
    }

  }

  if( (int)fabao->query("time_available") < 1 )
  {
    message_vision("\n突然间$N发出一阵金色光芒，冲上天去。\n", fabao);
    destruct(fabao);
  }

  return 1;
}

int ji (string target)
{
  object fabao = this_object ();
  object me = this_player();
  string name=fabao->query("name");
  object victim;
  if (!target)
    return notify_fail("你想对谁祭"+name+"？\n");
  victim=present(target,environment(me));
  return fabao->ji_ob(victim);
}

