#include <skill.h>
#include <ansi.h>
#include <weapon.h>
inherit SWORD;
inherit F_UNIQUE;
void create()
{
  set_name("青云宝剑", ({"qingyun baojian", "sword", "jian","baojian", "fabao"}));
  set_weight(8000);
  if(clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一把青色长剑，上印符咒，中分四字，乃是“地，水，火，风”。\n");
    set("unit", "把");
    set("value", 100000);
    set("no_put",1);
    set("no_sell",1);
    set("unique", 1);
    set("replace_file", "/d/obj/weapon/sword/changjian");
    set("wield_msg", "$N将青云宝剑拿在手中，轻轻一抖，似有风雷隐隐，火光摇曳。\n");
    set("time_available", 4);
  }

  init_sword(30);
  set("is_monitored", 1);
  setup();
}

int ji_ob(object victim)
{
  object fabao=this_object();
  object me=this_player();
  object where=environment(me);
  int spi, result, damage;
  string msg;

  if( me->is_busy() )
    return notify_fail("你正忙着呢，无法祭出青云宝剑。\n");
  if( !victim )
    return notify_fail("你想祭的人不在这里。\n");
  if( where->is_safty() || where->query("no_magic") )
    return notify_fail("这里不能祭青云宝剑。\n");
  if( !me->is_fighting() )
    return notify_fail("只有战斗中才能祭青云宝剑。\n");
  if( (int)me->query("mana") < 800 )
    return notify_fail("你的法力不能控制青云宝剑。\n");
  if( (int)me->query("sen") < 500 )
    return notify_fail("你现在神智不清，很难驾驭青云宝剑。\n");
  msg = HIC"\n$N" HIC"大喝一声“看剑！”，只见" + fabao->name() +
        HIC"「呼」地一下飞到半空。。。\n"NOR;

  if( (int)fabao->query("time_available") <= 1 )
    msg += HIC"尘土飞扬中" + fabao->name() + "向$n" HIC"凌空一斩！\n"NOR;
  else if( (int)fabao->query("time_available") == 2 )
    msg += HIC"水花四溅中" + fabao->name() + HIC"向$n飞刺而来！\n"NOR;
  else if( (int)fabao->query("time_available") == 3 )
    msg += HIC"顿时千万条火焰如金蛇乱窜！火光中" + fabao->name() + "向$N"
           HIC"凌空一刺！\n"NOR;
  else if( (int)fabao->query("time_available") == 4 )
    msg += HIC"霎那间天色一变，风声大作！"+ fabao->name() +
           HIC"带出一道低啸向$N" HIC"劈面斩下！\n"NOR;
  message_vision(msg,me,victim);
  if (userp(me) && userp(victim) && !victim->is_want_kill(me->query("id")))
     me->want_kill(victim);
  me->kill_ob(victim);

  if (living(victim) && ! userp(victim))
    victim->kill_ob(me);
  else
    victim->fight_ob(me);

  me->add("mana", -500);
  me->receive_damage("sen", 100);
  me->start_busy(1+random(3));
  spi = fabao->query("time_available") *10;
  fabao->add("time_available", -1);
  result = SPELL_D->attacking_cast_success(me,victim,100 + random(spi));
  if (result < 0)
  {
    message_vision(HIB"\n$N" HIB"手一指大喝一声“收！”，只听$n"
                   HIB"发出一股锐啸！几个翻滚之后终于乖乖地飞到了$N"
                   HIB"手中。\n"NOR, victim, fabao);
    fabao->delete("equipped");
    fabao->move(victim);
  }

  else if( result == 0)
  {
    message_vision(HIC"\n结果$N" HIC"身形急闪，躲过了$n"
                   HIC"的攻势。\n"NOR, victim, fabao);
  }

  else
  {
    damage = 300 + (int)me->query("mana_factor")*2 + (int)me->query_spi()*3;
    damage -= random((int)victim->query("mana_factor") + 1);
    damage += (int)me->query("mana")/20;
    damage -= random((int)victim->query("mana")/20 + 1);
    damage += damage*spi/100;
    if( damage < 0 ) damage = 0;
    if( damage > 2000 ) damage = 2000;
    if (wizardp(me))
      tell_object(me,sprintf("damage = %d\n",damage));
    if( damage > 0 )
    {
      message_vision(HIC"\n结果$N" HIC"躲闪不及，被$n" HIC"斩个正着！\n"NOR,victim,fabao);
      victim->receive_damage("kee", damage,me);
      victim->receive_wound("kee", random(damage)+1,me);
      COMBAT_D->report_sen_status(victim);
    }

  }

  if( (int)fabao->query("time_available") < 1 )
  {
    message_vision("\n突然间$N发出一阵青芒冲上天去。\n", fabao);
    destruct(fabao);
  }

  return 1;
}

int ji (string target)
{
  object fabao = this_object ();
  object me = this_player();
  string name=fabao->query("name");
  object victim;
  if (!target)
    return notify_fail("你想对谁祭"+name+"？\n");
  victim=present(target,environment(me));
  return fabao->ji_ob(victim);
}

