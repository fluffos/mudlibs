#include <ansi.h>
#include <weapon.h>
#include <combat.h>
inherit F_UNIQUE;
inherit HAMMER;
void create()
{
  set_name(YEL"乾坤圈"NOR,({"qiankun quan", "quan", "qiankunquan", "qiankun", "fabao"}));
  set_weight(10000);
  if(clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit","只");
    set("value",0);
    set("value",10000);
    set("no_sell",1);
    set("no_drop","这么好的宝物，扔了多可惜呀！\n");
    set("no_give","这么好的宝物，留着自己用吧！\n");
    set("no_sell", 1);
    set("is_monitored", 1);
    set("no_busy", 0);
    set("replace_file", "/d/obj/fabao/qiankun-fake");
    set("long","一只纯钢打造的钢环，很结实。\n");
    set("wield_msg","$N拿出一只$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n收入豹皮囊。\n");
    set("time_available", 6);
  }

  init_hammer(25);
  setup();
}

int ji_ob(object victim)
{
  object fabao=this_object();
  object me=this_player();
  object where=environment(me);
  int spi, success_adj;
  string msg_init,msg_success,msg_fail,msg_backfire_init,msg_backfire_success;

  if( me->is_busy() )
    return notify_fail("你正忙着呢，无法祭出乾坤圈。\n");
  if( !victim )
    return notify_fail("你想祭的人不在这里。\n");
  if( where->is_safty() || where->query("no_magic") )
    return notify_fail("这里不能祭乾坤圈。\n");
  if( !me->is_fighting() )
    return notify_fail("只有战斗中才能祭乾坤圈。\n");
  if( (int)me->query("mana") < 800 )
    return notify_fail("你的法力不能控制乾坤圈。\n");
  if( (int)me->query("sen") < 500 )
    return notify_fail("你现在神智不清，很难驾驭乾坤圈。\n");
  msg_init = HIC"$N" HIC"掏出一只" + fabao->name() +
             HIC"，向空抛起，口中念念有词，\n";
  msg_init += fabao->name() + HIC"向$n的头顶砸去。\n"NOR;
  msg_success = HIR"$n" HIR"被" + fabao->name() +
                HIR"砸个正着，立不稳脚，跌了一跤。\n" NOR;
  msg_fail = HIB"$n" HIB"伸手一指，大喝一声“落！”只见" + fabao->name() +
             HIB"落回$N" HIB"手中。\n"NOR;
  msg_backfire_init = HIB"$n" HIB"伸手一指，大喝一声“回！”只见" +
                      fabao->name() + HIB"反奔$N" HIB"头上砸了下来！\n"NOR;

  msg_backfire_success = HIR"$n" HIR"反被" + fabao->name() +
                         HIR"砸个正着，立不稳脚，跌了一跤。\n" NOR;

  spi = fabao->query("time_available") * 8;
  fabao->add("time_available", -1);
  success_adj = 100 + random(spi + 1);
  SPELL_D->attacking_cast(
       me,
       victim,
       success_adj,
       BACKFIRE,
       "both",
       msg_init,
       msg_success,
       msg_fail,
       msg_backfire_init,
       msg_backfire_success);
  me->add("mana", -500);
  me->receive_damage("sen", 100);
  me->start_busy(2 + random(3));
  if( (int)fabao->query("time_available") < 1 )
  {
    message_vision("\n突然间$N发出一阵青芒冲上天去。\n", fabao);
    destruct(fabao);
  }

  return 1;
}

int ji (string target)
{
  object fabao = this_object ();
  object me = this_player();
  string name=fabao->query("name");
  object victim;
  if (!target)
    return notify_fail("你想对谁祭"+name+"？\n");
  victim=present(target,environment(me));
  return fabao->ji_ob(victim);
}