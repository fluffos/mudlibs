#include <ansi.h>
#include <weapon.h>

inherit F_UNIQUE;
inherit ITEM;

void create()
{
  set_name("金刚琢",({"jingang zhuo", "jingang", "zhuo", "fabao"}));
  set_weight(5000);
  set_max_encumbrance(5000000);
  if(clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit","只");
    set("value", 100000);
    set("material","jade");
    set("long","一只白森森的圈子。\n");
  }

  set("no_sell", "金刚琢乃法宝没人敢买也。");
  set("no_drop", "金刚琢乃法宝不可扔弃也。");
  set("no_give", "金刚琢乃法宝不可赠人也。");
  set("replace_file", "/d/qujing/jindou/obj/zhuofake.lpc");
  set("is_monitored",1);
  set("time_available", 6);
  setup();
}

int ji_ob (object victim)
{
  object zhuo = this_object ();
  object me = environment(zhuo);
  string zhuoname = zhuo->query("name");
  object ob;
  int spi, result;

  if (me->is_busy())
  {
    tell_object (me, "你无法忙中偷闲祭"+zhuoname+"。\n");
    return notify_fail("你正忙着呢。\n");
  }

  if (sizeof(all_inventory(zhuo))>0)
  {
    tell_object (me, zhuoname+"里有杂物，你无法再祭"+zhuoname+"。\n");
    return notify_fail("你祭"+zhuoname+"失败。\n");
  }

  if (!victim)
  {
    tell_object (me, "你想祭的人不在这里。\n");
    return notify_fail("你祭"+zhuoname+"失败。\n");
  }

  if (!living(victim))
  {
    tell_object (me, victim->query("name")+"已经毫无抵抗能力了。\n");
    return notify_fail("你祭"+zhuoname+"失败。\n");
  }

  if (!me->is_fighting())
  {
    tell_object (me, "只有战斗中才能祭"+zhuoname+"。\n");
    return notify_fail("你祭"+zhuoname+"失败。\n");
  }

  if ((int)me->query("mana") < 1200)
  {
    tell_object (me, "你的法力不足，祭不了"+zhuoname+"。\n");
    return notify_fail("你祭"+zhuoname+"失败。\n");
  }

  if( (int)me->query("sen") < 600)
  {
    tell_object (me, "你无法集中精神念咒语。\n");
    return notify_fail("你祭"+zhuoname+"失败。\n");
  }

  ob = victim->query_temp("weapon");
  if(!ob)
  {
    tell_object (me, "对方没有使用武器。\n");
    return notify_fail("你祭"+zhuoname+"失败。\n");
  }

  message_vision ("\n$N忽地抛起"+zhuoname+"，口中念念有词。\n",me);

  if (userp(me))
    return notify_fail("可惜没有任何效果，看来是个假货！\n");
  if (userp(me) && userp(victim) && !victim->is_want_kill(me->query("id")))
     me->want_kill(victim);
  me->kill_ob(victim);
  if (living(victim) && ! userp(victim))
    victim->kill_ob(me);
  else
    victim->fight_ob(me);
  me->add("mana", -500);
  me->receive_damage("sen", 100);
  me->start_busy(1+random(3));
  spi = zhuo->query("time_available")*8;
  zhuo->add("time_available", -1);
  result = SPELL_D->attacking_cast_success(me,victim,100 + random(spi));
  switch (result)
  {
    case 0 :
      message_vision ("$N一纵身，绕开了空中的"+zhuoname+"。\n",victim);
      break;
    case 1 :
       message_vision ("$N手中的"+ob->name()+"把持不定！\n",victim);
       message_vision ("说时迟那时快，$N手中的"+ob->name()+"已被"+zhuoname+"收去！\n",victim);
       ob->unequip();
       if (ob->query_weight()>zhuo->query_max_encumbrance())
       {
         message_vision (ob->name()+"在"+zhuoname+"里化作一股烟散了！\n",me,victim);
         destruct(ob);
       }

       else
         ob->move(zhuo);
       break;
     default :
      message_vision ("$N伸手一指，只听“咔嚓”一声，"+zhuoname+"在半空扭了一扭，跌了个粉碎。\n",me);
      destruct (zhuo);
      return 1;
  }

  if(objectp(zhuo) && (int)zhuo->query("time_available") < 1 )
  {
    message_vision("\n突然间$N一阵抖动，化为道金光，冲天而去。\n", zhuo);
    destruct(zhuo);
  }

  me->add("mana", -250);
  me->add("sen", -150);
  return 1;
}

int ji (string target)
{
  object zhuo = this_object ();
  object me = this_player();
  string zhuoname = zhuo->query("name");
  object victim;
  if (!target)
    return notify_fail("你想对谁祭"+zhuoname+"？\n");
  victim=present(target,environment(me));
  zhuo->ji_ob(victim);
  return 1;
}