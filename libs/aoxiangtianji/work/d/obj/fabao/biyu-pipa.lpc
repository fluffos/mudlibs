#include <skill.h>
#include <ansi.h>
#include <weapon.h>
inherit HAMMER;
inherit F_UNIQUE;
void create()
{
  set_name(HIG"碧玉琵琶"NOR, ({"biyu pipa", "hammer", "pipa", "fabao"}));
  set_weight(8000);
  if(clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一把碧绿色的琵琶，上印符咒，中分四弦，乃是“地，水，火，风”。\n");
    set("unit", "把");
    set("value", 100000);
    set("no_put",1);
    set("no_sell",1);
    set("unique", 1);
    set("replace_file", "/obj/money/silver");
    set("wield_msg", "$N将碧玉琵琶拿在手中，轻轻拨弦，似乎有风火齐至。\n");
    set("time_available", 6);
  }

  init_hammer(30);
  set("is_monitored", 1);
  setup();
}

int ji_ob(object victim)
{
  object fabao=this_object();
  object me=this_player();
  object where=environment(me);
  int spi, result, damage;
  string msg;

  if( me->is_busy() )
    return notify_fail("你正忙着呢，无法祭出碧玉琵琶。\n");
  if( !victim )
    return notify_fail("你想祭的人不在这里。\n");
  if( where->is_safty() || where->query("no_magic") )
    return notify_fail("这里不能祭碧玉琵琶。\n");
  if( !me->is_fighting() )
    return notify_fail("只有战斗中才能祭碧玉琵琶。\n");
  if( (int)me->query("mana") < 800 )
    return notify_fail("你的法力不能控制碧玉琵琶。\n");
  if( (int)me->query("sen") < 500 )
    return notify_fail("你现在神智不清，很难驾驭碧玉琵琶。\n");
  msg = HIC"\n$N" HIC"大声叫道“好！且听这一曲如何！”，言罢口念咒文，"
        "轻拨弦声。。。\n"NOR;
  msg += HIC"只见" + fabao->name() + HIC"「呼」地一下飞到半空，叮叮铛铛"
        "之声不绝于耳，径向$n" HIC"逼去。\n"NOR;
  message_vision(msg, me, victim);
  if (userp(me) && userp(victim) && !victim->is_want_kill(me->query("id")))
     me->want_kill(victim);
  me->kill_ob(victim);

  if (living(victim) && ! userp(victim))
    victim->kill_ob(me);
  else
    victim->fight_ob(me);

  me->add("mana", -500);
  me->receive_damage("sen", 100);
  me->start_busy(1+random(3));
  spi = fabao->query("time_available") *5;
  fabao->add("time_available", -1);
  result = SPELL_D->attacking_cast_success(me,victim,100 + random(spi));
  if (result < 0)
  {
    message_vision(HIC"\n$N" HIC"大喝一声“收！”，只听叮铛之声大作！只听$n"
                   HIC"的琴音一高再高之后终于乖乖地飞到了$N手中。\n"NOR,
                   victim, fabao);
    fabao->delete("equipped");
    fabao->move(victim);
  }

  else if( result == 0)
  {
    message_vision(HIC"\n$N" HIC"充耳不闻，似乎丝毫不受$n" HIC"的影响。\n"NOR, victim, fabao);
  }

  else
  {
    damage = 300 + (int)me->query("mana_factor")*2 + (int)me->query_spi()*3;
    damage -= random((int)victim->query("mana_factor") + 1);
    damage += (int)me->query("mana")/20;
    damage -= random((int)victim->query("mana")/20 + 1);
    damage += damage*spi/100;
    if( damage < 0 ) damage = 0;
    if( damage > 2000 ) damage = 2000;
    if (wizardp(me))
      tell_object(me,sprintf("damage = %d\n",damage));
    if( damage > 0 )
    {
      message_vision(HIC"\n结果$N躲闪不及，捂住耳朵发出一声惨叫！\n"NOR,victim);
      victim->receive_damage("sen", damage,me);
      victim->receive_wound("sen", random(damage)+1,me);
      COMBAT_D->report_sen_status(victim);
    }

  }

  if( (int)fabao->query("time_available") < 1 )
  {
    message_vision("\n突然间$N发出一阵青芒冲上天去。\n", fabao);
    destruct(fabao);
  }

  return 1;
}

int ji (string target)
{
  object fabao = this_object ();
  object me = this_player();
  string name=fabao->query("name");
  object victim;
  if (!target)
    return notify_fail("你想对谁祭"+name+"？\n");
  victim=present(target,environment(me));
  return fabao->ji_ob(victim);
}