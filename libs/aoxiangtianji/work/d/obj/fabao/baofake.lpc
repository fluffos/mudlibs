#include <ansi.h>
#include <weapon.h>
#define DABAO "/d/obj/fabao/baofake"
#define CAUSED "no_move"

inherit ITEM;

void create()
{
  set_name("旧白布搭包",({"da bao", "bao", "fabao"}));
  set_weight(5000);
  set_max_encumbrance(100000000000);
  if(clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit","只");
    set("value", 100000);
    set("material","cloth");
    set("long","一只破旧的白布搭包。\n");
    set("no_fight", 1);
    set("no_magic", 1);
    set("no_put",1);
    set("no_sell", "旧白布搭包乃法宝没人敢买也。\n");
    set("no_drop", "旧白布搭包乃法宝不可扔弃也。\n");
    set("no_give", "旧白布搭包乃法宝不可赠人也。\n");
    set("time_available", 3);
    set("no_busy", 0);
  }

  setup();
}

void init ()
{
  add_action ("do_out", "out");
}

int do_out ()
{
  object me = this_object ();
  object who = this_player();
  object where = environment (who);
  object room = environment (me);
  if (where != me)
    return 0;
  if (who->query_temp("no_move") ||
      who->is_busy())
  {
    tell_object (who, "你竭力挣扎着想爬出去，却挪动不了身子。\n");
    return 1;
  }

  tell_object (who, "你掀开旧白布搭包口，慢慢爬了出去。\n");
  if (room->is_character())
    room = environment (room);
  who->move(room);
  message_vision ("$N从旧白布搭包口里拱了出来。\n",who);
  return 1;
}

int ji(string target)
{
  object fabao,me,victim;
  string msg, objname;
  int spi,damage, result;
  fabao = this_object();
  me = this_player();
  objname=this_object()->name();
  if (sizeof(all_inventory(fabao))>0)
  {
    tell_object (me, objname+"里有杂物，你无法再祭"+objname+"。\n");
    return notify_fail("你祭"+objname+"失败。\n");
  }

  if (!target)
    return notify_fail("你想用对谁用"+objname+"？\n");
  if (!objectp(victim=present(target, environment(me))))
    return notify_fail("这里没有 "+target+"。\n");
  if(!living(victim))
    return notify_fail("你的目标不是活物！\n");
  if(!me->is_fighting(victim))
    return notify_fail("只有战斗中才能祭" + objname + "。\n");
  if(victim->query_temp("no_move"))
    return notify_fail("对方已经无暇自顾了，有必要用" + objname + "么？\n");
  if( (int)me->query("mana") < 1200)
    return notify_fail("你的法力不够了！\n");
  if( (int)me->query("sen") < 500)
    return notify_fail("你的精神无法集中！\n");
  if (playerp(me))
    return notify_fail("可惜无论你怎么念咒，一点反应都没有，看来是个假货了！\n");

  message_vision (HIR"\n$N" HIR"口中念着咒语，看了$n"
                  HIR"一眼，唰地扔起"+objname+"。\n",me,victim);
  if (userp(me) && userp(victim) && !victim->is_want_kill(me->query("id")))
     me->want_kill(victim);
  me->kill_ob(victim);

  if (living(victim) && ! userp(victim))
    victim->kill_ob(me);
  else
    victim->fight_ob(me);
  me->add("mana", -500);
  me->receive_damage("sen", 100);
  me->start_busy(2+random(3));
  if(userp(me) && (int)fabao->query("time_available") <= 0 )
  {
    tell_room(environment(me),"只见" + objname +
              "突然在半空中变成碎片如天女散花般飘落。\n");
    destruct(fabao);
    return 1;
  }

  spi = fabao->query("time_available")*8;
  fabao->add("time_available", -1);
  if (!userp(me))
    if (fabao->query("time_available") < 0)
      fabao->set("time_available", 0);
  result = SPELL_D->attacking_cast_success(me,victim,100 + random(spi));
  msg = objname + HIY"腾起在半空中，$N" HIY"咒语念动，只见一股白气狂风一般倒吸进去。\n"NOR;
  switch(result)
  {
    case 1:
      msg += HIR"$n" HIR"顿感头重脚轻，身不由己地飘了起来！\n";
      msg += "一瞬间，$n已被" + objname + "装了进去！\n";
      victim->move(fabao);
      damage = random((int)me->query("mana_factor")*3/5 + 1)+1;
      if (damage < 10)
        damage = 10;
      if (damage > 60)
        damage = 60;
      victim->set_curse_changed(DABAO,CAUSED,"dexerity",damage,1);
      victim->unconcious();
      if (objectp(victim))
      {
        victim->receive_wound("kee",(int)victim->query("max_kee")/4, me);
        victim->receive_wound("sen",(int)victim->query("max_sen")/4, me);
      }

      break;
    case 0:
      msg += HIB"\n$n" HIB"知道不好，凝神躲避，结果什么都没发生。\n";
      break;
    default :
      msg += HIB"$n" HIB"伸手一指，只听“咝”地一声" + objname +
             HIB"突然破碎撕开，裂作碎片散落在地。\n"NOR;
      destruct (fabao);
      break;
  }

  message_vision(msg,me,victim);
  me->add("mana", -250);
  me->add("sen", -50);
  return 1;
}

void remove_effect(object me)
{
  if (objectp(me) && me->query_temp(CAUSED))
    tell_object(me,"你终于可以摆脱搭包的困扰了。\n");
}

