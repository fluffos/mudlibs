inherit COMBINED_ITEM;
int is_drug() {return 1;}

int is_self_make()
{
  return 1;
}

int is_owner(object me)
{
  if (!objectp(me))
    return 0;
  return (query("owner") == me->query("id"));
}

mapping cname = ([
  "kee" : "气血",
  "sen" : "精神",
  "force" : "内力",
  "mana"  : "法力"]);

int do_effect(object me)
{
  string eat_msg, type, addtype;
  mixed eff;
  int addmax, last_time, tt;
  int lucky, busy_time;
  if (!present(this_object(),me))
    return notify_fail("你必须把丹药拿起来才可以服用！\n");
  type = query("type");
  addmax = (int)query("addmax");
  addtype = (string)query("addtype");
  busy_time = 0;

  if (!addmax && (!stringp(type) ||
                  (type != "sen" &&
                   type != "kee" &&
                   type != "mana" &&
                   type != "force" &&
                   type != "all")))
  {
    write("嗯！这种丹药不知道哪儿来的，看不出有任何作用！\n");
    destruct(this_object());
    return 1;
  }

  if (me->is_busy())
    return notify_fail("你现在正忙了！\n");

  if (addtype != "force" &&
      addtype != "mana")
    addmax = 0;

  if (intp(query("eff")))
  {
    if (query("eff") < 1 && !addmax)
      eff = 100;
    else
      eff = query("eff");
    if (!is_owner(me))
      busy_time = 1;
  }

  else if (stringp(query("eff")) && query("eff") == "full")
  {
    if (type == "kee" || type == "sen")
      eff = me->query("max_" + type);
    else if (type == "force" || type == "mana")
      eff = 2*me->query("max_" + type);
    if (!is_owner(me))
      busy_time = 2;
  }

  last_time = (int)query("last_time");
  if (last_time < 1)
  {
    if (!is_owner(me))
      last_time = 1;
  }

  if ((string)query("eff") == "full")
  {
    if (last_time < 1)
      last_time = 1;
    last_time *= 2;
  }

  if (addmax)
    tt = (int)me->query_temp("last_self_adddan/" + type);
  else
    tt = (int)me->query_temp("last_self_dan/" + type);

  if (time() - tt < last_time)
  {
    if (addmax || (string)query("eff") == "full")
      write("你刚服用过，这药性十分猛烈，需发挥完效用以后才能继续服用。\n");
    else
      write("你刚服用过药，需药性发挥完效用以后才能继续服用。\n");
    return 1;
  }

  if (!addmax && (type == "kee" || type == "sen"))
  {
    if (me->query(type) >= me->query("max_" + type))
    {
      write(sprintf("你现在%s状态很好，无需服用%s。\n",cname[type],name()));
      return 1;
    }

  }

  else if (!addmax && type != "all")
  {
    if (me->query(type) >= 2*me->query("max_" + type))
    {
      write(sprintf("你现在%s状态很好，无需服用%s。\n",cname[type],name()));
      return 1;
    }

  }

  if (addmax)
    me->set_temp("last_self_adddan/" + addtype, time());
  else
    me->set_temp("last_self_dan/" + type, time());
  eat_msg = query("eat_msg");
  if (stringp(eat_msg))
    message_vision("$N" + eat_msg + "\n",me);
  else
    message_vision("$N吃下一粒" + name() + "。\n", me);

  if (!is_owner(me) && (string)query("eff") != "full")
    eff = eff/2;
  if (type == "all" && eff == "full")
  {
    me->set("kee",me->query("max_kee"));
    me->set("eff_kee",me->query("max_kee"));
    me->set("sen",me->query("max_sen"));
    me->set("eff_sen",me->query("max_sen"));
    if (!is_owner(me))
    {
      me->set("force",2*me->query("max_force"));
      me->set("mana",2*me->query("max_mana"));
      busy_time = 3;
    }

    else
    {
      if (me->query("force") < me->query("max_force")*8/5)
        me->set("force",me->query("max_force")*8/5);
      if (me->query("mana") < me->query("max_mana")*8/5)
        me->set("mana",me->query("max_mana")*8/5);
      busy_time = 1+random(2);
    }

  }

  else if (type == "all")
  {
    me->receive_curing(type, eff);
    me->receive_heal(type, eff);
    me->add("force",eff);
    if (me->query("force") > 2*me->query("max_force"))
      me->set("force",2*me->query("max_force"));
    me->add("mana",eff);
    if (me->query("mana") > 2*me->query("max_mana"))
      me->set("mana",2*me->query("max_mana"));
    if (!is_owner(me))
      busy_time = 2;
  }

  else if (type == "sen" || type == "kee")
  {
    me->receive_curing(type, eff);
    me->receive_heal(type, eff);
  }

  else if (stringp(type) && intp(eff) && eff > 0)
  {
    me->add(type, eff);
    if (me->query(type) > 2*me->query("max_" + type))
      me->set(type,2*me->query("max_" + type));
  }

  lucky = query("lucky");
  if (lucky < 0)
    lucky = 100;

  if (addmax)
  {
    if (addtype == "force" && random(lucky) < me->query_kar())
    {
      me->add_maximum_force(addmax);
      tell_object(me,"你的内力增强了" + chinese_number(addmax) + "点。\n");
    }

    else if (addtype == "mana" && random(lucky) < me->query_kar())
    {
      me->add_maximum_mana(addmax);
      tell_object(me,"你的法力增强了" + chinese_number(addmax) + "点。\n");
    }

    else
      tell_object(me,"可惜这次其实没有成功！\n");
    if (!is_owner(me))
      busy_time = 2;
  }

  if (busy_time > 0 && !me->is_busy())
    me->start_busy(busy_time);
  add_amount(-1);
  if (query_amount() < 1)
    destruct(this_object());
  return 1;
}

int query_jicun_allow() { return 1; }

void owner_is_killed()
{
  if (query("addmax") ||
      (string)query("type") == "all" ||
      (string)query("eff") == "full")
    destruct(this_object());
}

