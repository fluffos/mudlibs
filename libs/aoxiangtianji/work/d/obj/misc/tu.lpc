//Cracked by Roath
inherit ITEM;
#include <ansi.h>
int do_locate(string arg);
int do_task();
void create()
{
  set_name(HIW"探宝"HIG"图"NOR, ({"tanbao tu","tu"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "这是一件用于寻找丢失物件的探宝图，它具有非凡的魔力。\n"+
                "能用(locate)命令找到物品的大概位置！\n");
    set("unit", "件");
    set("value", 300);
  }

}

void init()
{
   add_action("do_locate",({"locate","zhao"}));
   add_action("do_task","task");
}

int do_task()
{
  object me = this_player();
  string output;
  int t = time();
  if (me->is_busy() || me->is_fighting())
    return notify_fail("你正忙着呢！\n");

  if (me->query("sen") < 150)
    return notify_fail("你的法力不够了。\n");
  me->add("sen",-50);

  if ((t - me->query_temp("last_tu_task")) < 10)
    return notify_fail("你刚刚用过这个命令，请稍后在用！\n");

  output = "探宝图里突然映现出一篇蝇头小字：\n\n"+TASK_D->dyn_quest_list();
  me->start_more(output);
  me->set_temp("last_tu_task",t);
  return 1;
}

int query_autoload() { return 1; }

int do_locate(string arg)
{
  object me = this_player();
  int t = time();

  if ( ! arg)
    return notify_fail("locate/zhao <物品>\n");

  if (me->is_busy() || me->is_fighting())
    return notify_fail("你正忙着呢！\n");

  if (me->query("sen") < 150)
    return notify_fail("你的法力不够了。\n");

  me->add("sen",-50);
  if ((t - me->query_temp("last_tu_zhao")) < 10)
    return notify_fail("你刚刚用过这个指令，请稍后再用！\n");

  TASK_D->locate_quest(me,arg);
  me->set_temp("last_tu_zhao",t);
  return 1;
}

