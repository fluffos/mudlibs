#include <ansi.h>
inherit ITEM;
void create()
{
  set_name( WHT"雨伞"NOR, ({ "umbrella", "yusan", "san" }) );
  set_weight(100);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long","一把雨伞，在雨天里可以安全些。\n");
    set("unit", "把");
    set("value", 1000);
    set("material", "bamboo");
  }

  setup();
}

void init ()
{
  add_action ("do_wear", "wear");
  add_action ("do_remove", "remove");
  return;
}

int do_wear (string arg)
{
  object me = this_player();
  if (arg != "umbrella" &&  arg != "san" ) return 0;
  message_vision(sprintf("$N将一把%s撑起来打在头顶上。\n",name()),me);
  me->set_temp("thunder",random(100));
  return 0;
}

int do_remove (string arg)
{
  object me = this_player();
  if (arg != "umbrella" && arg != "san") return 0;
  message_vision(sprintf("$N将%s轻轻收了起来。\n",name()),me);
  me->delete_temp("thunder");
  return 0;
}