#include <ansi.h>
inherit ITEM;
int melted;
int do_make(string);
void create()
{
  seteuid(getuid());
  set_name(HIB "蓝色冰块" NOR, ({ "lan bingkuai", "bingkuai", "bing", "ice" }) );
  set("long", "这是一片长长的，弯弯的，冷飕飕的冰块，还透着点淡蓝色。\n");
  set("unit", "片" );
  set("value", 1000);
  set("no_sell", 1);
  set("material", "ice");
  melted = 0;
  if( clonep(this_object()) )
    call_out("melt", 60, 1);
  set("is_monitored",1);
  setup();
}

void melt(int count)
{
  object env, owner;
  int lv;
  melted = count;
  env=environment(this_object());
  owner = this_object()->query("ice_owner");
  if( env->is_character() )
  {//a player or a NPC.
    if( (int)env->query_skill("ningxue-force", 1) < 20 )
    {
      message_vision("$N觉得身上凉凉的，湿湿的，原来是冰块化了。\n", env);
      if (objectp(owner))
      {
      	lv = owner->query_skill("ningxue-force",1)/3;
        if (lv)
        {
          env->affect_by("ningxue_force",
              ([ "level"    : lv/2+random(lv),
                 "id"       : owner->query("id"),
                 "duration" : lv/50 + random(lv/20) ]));
        }

      }

      destruct(this_object());
      return;
    }

  }

  else if( (int)env->query_max_encumbrance() > 0 && !environment(env) )
  {//a room.
    if( (string)env->query_terrain() != "snow" )
    {
      tell_object(env,"冰块终于化成了一滩水，流得到处都是。\n");
      destruct(this_object());
      return;
    }

  }

  call_out("melt", 60, count + 1);
}

void init()
{
  add_action("do_make", "make");
  add_action("do_make", "zuo");
  add_action("do_chi", "chi");
  add_action("do_chi", "eat");
}

int do_make(string arg)
{
  object ob, me;
  int lv;
  me = this_player();
  if( !arg || (arg != "blade" && arg != "dao" && arg != "sword" && arg != "jian" ) )
    return notify_fail("你要做什么？\n");
  if( arg == "sword" || arg =="jian" )
    return notify_fail("这片冰是弯的，做不了剑。\n");
  lv = (int)me->query_skill("ningxue-force",1);
  if( (int)me->query("force") < 200 || lv < 20 )
  {
    message_vision("$N拿起冰块捏来捏去，结果冰块很快就化掉了。\n", me);
    me->affect_by("ningxue_force",
              ([ "level"    : 100,
                 "id"       : me->query("id"),
                 "duration" : 10 ]));
    destruct(this_object());
    return 1;
  }

  ob=new("/d/obj/weapon/blade/handudao-blue");
  ob->move(me);
  ob->set("ice_owner",me);
  me->add("force", -100);
  message_vision("$N拿起冰块捏来捏去，居然做出了一把弯弯的冰刀！\n", me);
  destruct(this_object());
  return 1;
}

int do_chi(string arg)
{
  object me;
  int lv;

  me = this_player();

  if( !this_object()->id(arg) )
    return 0;
  if( me->is_busy() )
    return notify_fail("你上一个动作还没有完成。\n");
  if(!arg) return notify_fail("你要吃什么？\n");
  message_vision( "$N拿起冰块使劲一咬，只听嘎哒！一声，牙甭了。\n" , me);
  if( (int)me->query("kee") > 20 )
    me->add("kee", -20);
  else
    me->unconcious();
  lv = (int)me->query_skill("ningxue-force", 1);
  if( (int)me->query("force") < 200
    || lv < 20 )
    me->affect_by("ningxue_force",
              ([ "level"    : 120,
                 "id"       : me->query("id"),
                 "duration" : 10 ]));
  return 1;
}