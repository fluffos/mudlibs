#include <ansi.h>
inherit ITEM;
void pillow_destruct();
void create()
{
  set_name("黄粱枕", ({"huangliang zhen","pillow","zhen"}));
  set("long","一只绣花枕头，相传当年卢生枕其而眠，做了个好梦。\n");
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "只");
    set("value", 3000);
    set("material", "cloth");
  }

  setup();
}

int goto_dream(object me)
{
  object env;

  if(!objectp(me))
    return 0;

  if(env=environment(me))
    tell_object(env,"\n" + HIY + me->name() + HIY"拥着" +HIY + name() +
                    HIY"，进入了梦的世界．．．\n\n"NOR);
  me->start_busy(2);
  return 1;
}

void pillow_destruct()
{
  destruct(this_object());
}

