#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIW "万寿丹" NOR, ({"wanshou dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 65000);
    set("auto_dest",1);
    set("only_do_effect", 1);
    set("addmax",2+random(3));
    set("addtype","force");
    set("lucky",55);
    set("last_time",300);
    set("eat_msg",HIY "吃下一粒万寿丹，感到内力又雄厚了一些。" NOR);
  }

  setup();
  set_amount(1);
}