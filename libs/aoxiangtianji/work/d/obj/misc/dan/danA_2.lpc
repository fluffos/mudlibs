#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIW"蓄精丹"NOR, ({"xujing dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 400);
    set("eff",200);
    set("type","sen");
    set("eat_msg",HIW "吃下一粒蓄精丹，感到灵台处一片清净。" NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}

