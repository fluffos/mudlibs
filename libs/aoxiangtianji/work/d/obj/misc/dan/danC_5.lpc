#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIC"修罗"NOR+HIR"无常"NOR+HIY"丹"NOR, ({"xiuluo dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 5000);
    set("eff",2000);
    set("type","force");
    set("eat_msg",HIW"吃下一粒修罗无常丹，内息得到了极大的补充。" NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}