#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIM"龙涎丹"NOR, ({"longxian dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 20000);
    set("auto_dest",1);
    set("only_do_effect", 1);
    set("addmax",1);
    set("addtype","force");
    set("lucky",60);
    set("last_time",200);
    set("eat_msg",HIY "吃下一粒龙涎丹，感到内力又雄厚了一些。" NOR);
  }

  setup();
  set_amount(1);
}