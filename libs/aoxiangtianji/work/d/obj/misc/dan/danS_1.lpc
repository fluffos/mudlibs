#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIY"轩辕"NOR+HIW"补心"NOR+YEL"丹"NOR, ({"xuanyuan dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 12000);
    set("auto_dest",1);
    set("only_do_effect", 1);
    set("eff","full");
    set("type","all");
    set("last_time",15);
    set("eat_msg",HIC "吃下一粒轩辕补心丹，再也感觉不到任何疲惫。" NOR);
  }

  setup();
  set_amount(1);
}

