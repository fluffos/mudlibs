#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIC "阴" HIR "阳" HIY "九转丹" NOR, ({"yinyang dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 75000);
    set("auto_dest",1);
    set("only_do_effect", 1);
    set("addmax",2+random(4));
    set("addtype","force");
    set("lucky",50);
    set("last_time",320);
    set("eat_msg",HIY "吃下一粒阴阳九转丹，感到内力又雄厚了一些。" NOR);
  }

  setup();
  set_amount(1);
}