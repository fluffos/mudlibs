#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIC"归元丹"NOR, ({"guiyuan dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 1000);
    set("eff",550);
    set("type","mana");
    set("eat_msg",HIW"吃下一粒归元丹，法力得到了补充。" NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}