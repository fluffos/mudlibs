#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(YEL"十全大还丹"NOR, ({"shiquan dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 800);
    set("eff",400);
    set("type","kee");
    set("eat_msg",YEL"吃下一粒十全大还丹，感到气力得到了比较大的调整。"NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}

