#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(GRN"润阳丹"NOR, ({"runyang dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 1500);
    set("eff",800);
    set("type","force");
    set("eat_msg",HIW"吃下一粒润阳丹，内息得到了很大的补充。" NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}