#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(RED"血麒丹"NOR, ({"xueqi dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 5000);
    set("eff",2200);
    set("type","mana");
    set("eat_msg",HIW"吃下一粒血麒丹，法力得到了极大的补充。" NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}

