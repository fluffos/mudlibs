#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIR"还魂丹"NOR, ({"huanhun dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 1800);
    set("eff",800);
    set("type","kee");
    set("eat_msg",HIR"吃下一粒还魂丹，气力得到了补充。"NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}