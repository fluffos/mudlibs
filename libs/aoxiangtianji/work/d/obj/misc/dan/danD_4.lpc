#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIR"火麒丹"NOR, ({"huoqi dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 1500);
    set("eff",800);
    set("type","mana");
    set("eat_msg",HIW"吃下一粒火麒丹，法力得到了很大的补充。" NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}