#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIR"回阳无极丹"NOR, ({"huiyang dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 3000);
    set("eff","full");
    set("type","kee");
    set("eat_msg",HIR"吃下一粒回阳无极丹，气力得到了完全的补充。"NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}