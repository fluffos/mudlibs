#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIW"罗刹"NOR+HIR"无常"NOR+HIY"丹"NOR, ({"luosha dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 10000);
    set("eff","full");
    set("type","mana");
    set("eat_msg",HIW"吃下一粒罗刹无常丹，法力得到了完全的补充。" NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}

