#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIY"小金丹"NOR, ({"gold dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 300);
    set("eff",200);
    set("type","mana");
    set("eat_msg",HIW"吃下一粒小金丹，感到法力得到了调整。" NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}

