#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(WHT "龟苓丹" NOR, ({"guiling dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 50000);
    set("auto_dest",1);
    set("only_do_effect", 2);
    set("addmax",2);
    set("addtype","force");
    set("lucky",60);
    set("last_time",250);
    set("eat_msg",HIY "吃下一粒龟苓丹，感到内力又雄厚了一些。" NOR);
  }

  setup();
  set_amount(1);
}