#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIY "九皇补心丹" NOR, ({ "buxin dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 1800);
    set("eff",800);
    set("type","sen");
    set("eat_msg",HIY"吃下一粒九皇补心丹，精神一振，神采奕奕。"NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}