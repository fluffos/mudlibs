#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(CYN"锁泉丹"NOR, ({"suoquan dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 900);
    set("eff",550);
    set("type","force");
    set("eat_msg",HIW"吃下一粒锁泉丹，内息得到了补充。" NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}

