#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIC "养精丹" NOR, ({ "yangjing dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 200);
    set("eff",100);
    set("type","sen");
    set("eat_msg",HIC "吃下一粒养精丹，感到灵台处一片清净。" NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}

