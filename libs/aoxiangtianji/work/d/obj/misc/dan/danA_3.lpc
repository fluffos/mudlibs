#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIR"补精丹"NOR, ({"bujing dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 600);
    set("eff",280);
    set("type","sen");
    set("eat_msg",HIR"吃下一粒补精丹，感到灵台处无比的清净。"NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}

