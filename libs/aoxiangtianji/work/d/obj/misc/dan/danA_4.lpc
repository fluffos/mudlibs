#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIC "引心丹" NOR, ({ "yinxin dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 800);
    set("eff",400);
    set("type","sen");
    set("eat_msg",HIC"吃下一粒引心丹，感到灵台处无比的清净。"NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}

