#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIW"小云丹"NOR, ({"xiaoyun dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 300);
    set("eff",200);
    set("type","force");
    set("eat_msg",HIW"吃下一粒小云丹，感到内息得到了调整。" NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}

