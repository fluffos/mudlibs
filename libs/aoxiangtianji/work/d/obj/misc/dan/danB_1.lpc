#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(YEL"小还丹"NOR, ({"xiaohuan dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 200);
    set("eff",100);
    set("type","kee");
    set("eat_msg",YEL"吃下一粒小还丹，感到气力得到了调整。"NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}