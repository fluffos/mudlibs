#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIY"皓月丹"NOR, ({"haoyue dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 60000);
    set("auto_dest",1);
    set("only_do_effect", 1);
    set("addmax",2+random(2));
    set("addtype","mana");
    set("lucky",60);
    set("last_time",300);
    set("eat_msg",HIY "吃下一粒皓月丹，感到法力又雄厚了一些。" NOR);
  }

  setup();
  set_amount(1);
}

