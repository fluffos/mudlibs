#include <ansi.h>
inherit "/d/obj/misc/selfdan1";
void create()
{
  set_name(HIW"雪参丹"NOR, ({"xueshen dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "粒");
    set("base_value", 600);
    set("eff",380);
    set("type","mana");
    set("eat_msg",HIW"吃下一粒雪参丹，法力得到了调整。" NOR);
    set("only_do_effect", 1);
  }

  setup();
  set_amount(1);
}