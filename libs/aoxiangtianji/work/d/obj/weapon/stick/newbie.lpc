#include <weapon.h>
inherit STICK;
void create()
{
  set_name("新手棍棒", ({"newbie bang", "bang"}));
  set_weight(8000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "把");
    set("no_sell", 1);
    set("long", "一把淡青色的新手使用的棍棒。\n");
    set("value", 0);
    set("no_give",1);
    set("no_put",1);
    set("no_get",1);
    set("no_sell",1);
    set("drop_des",1);
    set("material", "steel");
    set("wield_msg", "$N「呼」地一声抽出一把$n握在手中。\n");
  }

  init_stick(50);
  setup();
}

