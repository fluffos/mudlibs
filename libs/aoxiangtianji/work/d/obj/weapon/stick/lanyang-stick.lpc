#include <ansi.h>
#include <weapon.h>
inherit STICK;
void create()
{
  set_name( HIB "兰阳嵌玉棒" NOR, ({ "lanyang bang", "stick", "bang" }) );
  set_weight(100000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "条");
    set("value", 18000);
    set("material", "gold");
  }

  init_stick(70);
  setup();
}

