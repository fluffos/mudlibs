#include <ansi.h>
#include <weapon.h>
inherit STICK;
void create()
{
  set_name( HIR "噬魂棒" NOR, ({ "shihun bang", "stick", "bang" }) );
  set_weight(100000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "条");
    set("value", 15000);
    set("material", "gold");
    set("weapon_prop/courage", 5);
  }

  init_stick(60);
  setup();
}

