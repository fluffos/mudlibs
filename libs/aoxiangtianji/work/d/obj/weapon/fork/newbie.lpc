#include <weapon.h>
inherit FORK;
void create()
{
  set_name("新手钢叉", ({ "newbie fork", "cha","fork" }) );
  set_weight(6000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "柄");
    set("value", 0);
    set("no_give",1);
    set("no_put",1);
    set("no_get",1);
    set("no_sell",1);
    set("drop_des",1);
    set("material", "iron");
    set("long", "一柄新手使用的钢叉。\n");
    set("wield_msg", "$N抄起一柄$n轻轻的握在手里。\n");
  }

  init_fork(50);
  setup();
}

