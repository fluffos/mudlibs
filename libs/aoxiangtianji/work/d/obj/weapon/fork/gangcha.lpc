// gangcha.c
#include <ansi.h>
#include <weapon.h>
inherit FORK;
void create()
{
  set_name(HIW"钢叉"NOR, ({ "steel fork", "gang cha","fork" }) );
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "柄");
    set("value", 5000);
    set("material", "iron");
    set("long", "一柄锋利的钢叉。\n");
    set("wield_msg", "$N抄起一柄$n，还拿衣服擦了擦叉尖。\n");
  }

  init_fork(40);
  setup();
}

