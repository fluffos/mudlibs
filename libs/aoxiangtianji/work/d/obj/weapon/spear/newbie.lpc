#include <weapon.h>
inherit SPEAR;
void create()
{
  set_name("新手铁枪", ({"newbie spear", "qiang", "spear"}));
  set_weight(9000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "把");
    set("long", "这是一把浑铁长枪，枪尖略显银光．\n");
    set("value", 0);
    set("no_give",1);
    set("no_put",1);
    set("no_get",1);
    set("no_sell",1);
    set("drop_des",1);
    set("material", "iron");
    set("wield_msg","$N拿出一把$n，握在手中．\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_spear(50);
  setup();
}

