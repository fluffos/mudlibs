// tieqiang.c
#include <weapon.h>
inherit SPEAR;
void create()
{
  set_name("稚尾枪", ({"zhiwei spear", "spear", "qiang"}));
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "把");
    set("long", "这是一把花枪，不长，枪尖却闪闪发光。\n");
    set("value", 2500);
    set("material", "iron");
    set("wield_msg", "$N拿出一把$n，握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_spear(40);
  setup();
}

