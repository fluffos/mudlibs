#include <ansi.h>
inherit THROWING;
void create()
{
  set_name("银针", ({"yin zhen","zhen"}));
  if( clonep() )
     set_default_object(__FILE__);
  else
  {
    set("long",    "一把细小的绣花针，闪着点点寒芒。\n");
    set("unit", "把");
    set("base_unit", "根");
    set("base_weight", 5);
    set("base_value", 3);
    set("wound_percent", 30);
    set("weapon_prop/damage", 20);
  }

  set_amount(20);
  setup();
  set("no_wield", "这不是用来装备的。\n");
}

