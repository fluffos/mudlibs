// jili.c
#include <ansi.h>
inherit THROWING;
void create()
{
  set_name("雀翎", ({ "que ling", "ling", "needle" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "些");
    set("base_unit", "枚");
    set("base_weight", 250);
    set("base_value", 5000);
    set("material", "gem");
    set("long", HIG "亮晶晶的细如羽毛，锋刃处寒光微闪。\n"NOR);
    set("wound_percent", 50);
    set("weapon_prop/damage", 220);
  }

  set_amount(5);
  setup();
  set("no_wield", "这不是用来装备的。\n");
}

