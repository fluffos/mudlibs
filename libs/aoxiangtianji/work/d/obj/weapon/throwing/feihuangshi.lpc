// feihuangshi.c
#include <ansi.h>
inherit THROWING;

void create()
{
  set_name("飞蝗石", ({ "feihuangshi", "shi" }) );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "仔细挑选的鹅卵石，大小一致，个个都滴溜溜圆。\n");
    set("unit", "把");
    set("value", 100);
    set("base_unit", "个");
    set("base_weight", 5);
    set("base_value", 5);
    set("wound_percent", 40);
    set("weapon_prop/damage", 50);
  }

  set_amount(20);
  setup();
  set("no_wield", "这不是用来装备的。\n");
}

