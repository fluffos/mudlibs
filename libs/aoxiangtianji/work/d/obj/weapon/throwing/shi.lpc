#include <weapon.h>
inherit THROWING;
void create()
{
  set_name("石块", ({"shi kuai", "shi", "stone"}));
  set("long","一块大石头。\n在路边颇引人注目！\n");
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "些");
    set("base_unit", "块");
    set("base_weight", 4000);
    set("fill_sea",1);
    set("wound_percent", 30);
    set("weapon_prop/damage", 20);
  }

  set_amount(random(10)+5);
  set("no_wield", "这不是用来装备的。\n");
  setup();
}

