// jili.c
#include <ansi.h>
inherit THROWING;
void create()
{
  set_name("凤尾针", ({ "fengwei zhen", "needle" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "些");
    set("base_unit", "枚");
    set("base_weight", 150);
    set("base_value", 2000);
    set("material", "steel");
    set("long", HIG "亮晶晶的细小钢针。\n"NOR);
    set("wound_percent", 60);
    set("weapon_prop/damage", 120);
  }

  set_amount(10);
  setup();
  set("no_wield", "这不是用来装备的。\n");
}

