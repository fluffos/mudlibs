// flower_leaf.c
#include <ansi.h>
inherit THROWING;

void create()
{
  set_name("花瓣", ({ "flower leaf", "hua ban", "ban" }) );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "新鲜的玫瑰花的花瓣，上面还挂这晶莹的露珠。\n");
    set("unit", "把");
    set("value", 50);
    set("base_unit", "片");
    set("base_weight", 1);
    set("base_value", 1);
    set("wound_percent", 1);
    set("weapon_prop/damage", 2);
  }

  set_amount(50);
  setup();
  set("no_wield", "这不是用来装备的。\n");
}

