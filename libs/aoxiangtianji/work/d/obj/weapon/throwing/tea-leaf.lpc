// tea_leaf.c
#include <ansi.h>
#include <weapon.h>
inherit THROWING;

void create()
{
  set_name(HIG"茶叶"NOR, ({ "tea_leaf", "tea" }) );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "才采的新茶，发出一股淡淡的香气。\n");
    set("unit", "把");
    set("value", 50);
    set("base_unit", "片");
    set("base_weight", 1);
    set("base_value", 1);
    set("wound_percent", 1);
    set("weapon_prop/damage", 3);
  }

  set_amount(50);
  setup();
  set("no_wield", "这不是用来装备的。\n");
}

