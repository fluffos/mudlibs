// eluanshi.c
#include <weapon.h>
#include <ansi.h>
inherit THROWING;
void create()
{
  set_name(HIC"鹅卵石"NOR, ({ "eluan shi", "shi"}));
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "些");
    set("long", "这是一粒平平常常的鹅卵石。\n");
    set("base_unit", "粒");
    set("base_value", 2);
    set("base_weight", 300);
    set("value", 20);
    set("material", "stone");
    set("wound_percent", 30);
    set("weapon_prop/damage", 30);
  }

  set_amount(10);
  setup();
  set("no_wield", "这不是用来装备的。\n");
}

