// tielianzi.c
#include <ansi.h>
inherit THROWING;
void create()
{
  set_name("铁莲子", ({ "tie lianzi", "lianzi", "tie" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "把");
    set("base_unit", "颗");
    set("base_weight", 300);
    set("base_value", 1);
    set("material", "iron");
    set("long", HIW "铁莲子是一种以量取胜的暗器，沉颠颠的。\n" NOR);
    set("wound_percent", 40);
    set("weapon_prop/damage", 50);
  }

  set_amount(20);
  setup();
  set("no_wield", "这不是用来装备的。\n");
}

