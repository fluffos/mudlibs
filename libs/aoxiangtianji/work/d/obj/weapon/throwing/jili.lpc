// jili.c
#include <ansi.h>
inherit THROWING;
void create()
{
  set_name("铁蒺藜", ({ "tie jili", "jili" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "些");
    set("base_unit", "枚");
    set("base_weight", 200);
    set("base_value", 20);
    set("material", "iron");
    set("long", HIG "铁蒺藜经常用于淬毒暗器，寸许大小。\n"NOR);
    set("wound_percent", 50);
    set("weapon_prop/damage", 80);
  }

  set_amount(20);
  setup();
  set("no_wield", "这不是用来装备的。\n");
}

