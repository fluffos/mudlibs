// dagger.c : an example weapon
#include <weapon.h>
inherit DAGGER;
void create()
{
  set_name("红绸短剑", ({"hongchou dagger", "dagger" }) );
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "把");
    set("long", "这是一把看起系着红绸的短剑。\n");
    set("value", 50);
    set("material", "steel");
  }

  init_dagger(45);
  set("wield_msg", "$N从怀中摸出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n藏入怀中。\n");
  setup();
}

