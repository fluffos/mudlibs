// dagger.c : an example weapon
#include <weapon.h>
inherit DAGGER;
void create()
{
  set_name("淡月钩", ({"danyue gou", "gou", "dagger" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "把");
    set("long", "一把短小的兵器，弯弯的，如半满的月牙。\n");
    set("value", 18000);
    set("material", "silver");
  }

  init_dagger(60);
// These properties are optional, if you don't set them, it will use the
// default values.
  set("wield_msg", "一道月光洒过，带出寒光一道。\n");
  set("unwield_msg", "寒光略闪后，亮晶晶的半月闪入了$N的怀中。\n");
  setup();
}

