// dagger.c : an example weapon
#include <weapon.h>
inherit DAGGER;
void create()
{
  set_name("日晶轮", ({"rijin lun", "lun", "dagger" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "把");
    set("long", "一把金色的短小兵器，闪烁着淡淡的金光。\n");
    set("value", 80000);
    set("material", "silver");
  }

  init_dagger(80);
// These properties are optional, if you don't set them, it will use the
// default values.
  set("wield_msg", "一道金光闪现，刹那间耀眼的光华刺目夺神。\n");
  set("unwield_msg", "一道金光飞入$N的怀中。\n");
  setup();
}

