#include <weapon.h>
inherit MACE;
void create()
{
  set_name("新手银锏", ({ "newbie jian", "jian", "mace" }) );
  set_weight(7000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "根");
    set("value", 0);
    set("no_give",1);
    set("no_put",1);
    set("no_get",1);
    set("no_sell",1);
    set("drop_des",1);
    set("material", "steal");
    set("long", "一根新手使用的银锏。\n");
    set("wield_msg", "$N握起$n，大喝了一声：好锏。\n");
  }

  init_mace(50);
  setup();
}

