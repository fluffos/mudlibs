// crossbow.c
#include <ansi.h>
inherit BOW;
int is_crossbow() {return 1;}

void create()
{
  set_name("弩", ({ "cross bow", "bow", "nu" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "张");
    set("long", "一张弩，打造得极为精致，具有极好的准确度。\n");
    set("value", 40000);
    set("power", 120);   // 攻击威力
    set("accuracy", 120);   // 准确度
    set("max_str",800);
    set("min_str",120);
  }

  setup();
}