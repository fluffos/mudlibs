// mugong.c
#include <ansi.h>
inherit BOW;
void create()
{
  set_name("木弓", ({ "wood bow", "bow", "gong" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "张");
    set("long", "一张木弓，打造得有点粗糙。\n");
    set("power", 70);   // 攻击威力
    set("accuracy", 70);   // 准确度
    set("max_str",1500);
    set("min_str",80);
  }

  setup();
}

