// longbow.c
#include <ansi.h>
inherit BOW;
void create()
{
  set_name("长弓", ({ "long bow", "bow", "chang gong", "gong" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "张");
    set("long", "一张长弓，打造得颇为精致，具有相当好的准确度。\n");
    set("value", 50000);
    set("power", 120);   // 攻击威力
    set("accuracy", 120);   // 准确度
    set("max_str",300);
    set("min_str",150);
  }

  setup();
}

