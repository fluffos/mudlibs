// goldbow.c
#include <ansi.h>
inherit BOW;
void create()
{
  set_name(HIR "赤鸳弩" NOR, ({ "chiyuan nu", "chiyuan", "nu", "bow" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "张");
    set("long", HIR "这是一张铅铁所铸，舞凤雕纹，制作非常精细的弩。\n" NOR);
    set("no_sell", "我的天…这东西你也敢拿来卖？");
    set("value", 300000);
    set("power", 150);   // 攻击威力
    set("accuracy", 180);   // 准确度
    set("max_str",1000);
    set("min_str",200);
  }

  setup();
}

int is_crossbow() {return 1;}