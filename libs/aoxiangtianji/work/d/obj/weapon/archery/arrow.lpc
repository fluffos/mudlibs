// arrow.c
inherit THROWING;
int is_arrow()
{
  return 1;
}

void create()
{
  set_name("羽箭", ({ "arrow", "jian" }));
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一根细长的箭，箭翎修长，簇失锋利。\n");
    set("unit", "把");
    set("base_unit", "根");
    set("base_weight", 100);
    set("base_value", 200);
    set("wound_percent", 20);
    set("weapon_prop/damage", 30);
  }

  set_amount(10);
  setup();
  set("no_wield", "这不是用来装备的。\n");
}

