#include <weapon.h>
inherit AXE;
void create()
{
  set_name("新手铁斧", ({ "newbie axe", "axe" }) );
  set_weight(12000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "把");
    set("long", "这是一把新手使用的铁斧！\n");
    set("value", 0);
    set("no_give",1);
    set("no_put",1);
    set("no_get",1);
    set("no_sell",1);
    set("drop_des",1);
    set("material", "iron");
    set("wield_msg", "$N拿出一把$n，握在手中当作武器。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_axe(50, TWO_HANDED);
  setup();
}

