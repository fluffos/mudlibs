// futou.c
#include <weapon.h>
inherit AXE;
void create()
{
  set_name("大斧头", ({ "big axe", "da futou","axe" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "柄");
    set("long", "这是一把大斧头，仞口闪现寒光。\n");
    set("value", 5000);
    set("material", "iron");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回后腰。\n");
  }

  init_axe(40);
  setup();
}

