#include <weapon.h>
inherit WHIP;
void create()
{
  set_name("新手皮鞭", ({"newbie whip", "whip"}));
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long","一条新手使用的长长的皮鞭！\n");
    set("unit", "条");
    set("value", 0);
    set("no_give",1);
    set("no_put",1);
    set("no_get",1);
    set("no_sell",1);
    set("drop_des",1);
    set("material", "silver");
  }

  init_whip(50);
  setup();
}

