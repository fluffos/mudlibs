#include <ansi.h>
#include <weapon.h>
inherit WHIP;
void create()
{
  set_name(HIM"凤飞栖梧鞭"NOR, ({"fengfei-whip","whip"}));
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long","一条长长的皮鞭，上面沾满了血．\n");
    set("unit", "条");
    set("value", 20000);
  }

  init_whip(75);
  setup();
}

