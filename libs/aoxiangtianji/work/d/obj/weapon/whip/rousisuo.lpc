#include <ansi.h>
#include <weapon.h>
inherit WHIP;
void create()
{
  set_name(WHT "柔丝索" NOR,({ "rousi suo", "suo", "rousi" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "卷");
    set("value", 200000);
    set("no_sell", 1);
    set("long", HIW "一卷非常柔软的细丝，乃天蚕丝所织。\n" NOR );
    set("wield_msg", HIW "$N" HIW "拿出一卷$n" HIW "，轻轻摊开，握在手中。\n" NOR );
    set("unwield_msg", HIW "$N" HIW "将$n" HIW "收回成卷，放回腰间。\n" NOR );
    set("material", "silk");
  }

  init_whip(35);
  setup();
}

int hit_ob(object me, object victim, int damage)
{
  int dam ;

  message_vision(sprintf("$N手中的%s飘转若情人的发丝，丝丝缠绕住$n！\n",this_object()->name()),
                         me,victim);
  dam = (int) me->query("force_factor");
  dam = random(3*dam) - random((int) victim->query("force_factor"));
  if (dam>0)
  {
    message_vision(sprintf("$N内力借助手中的%s迸发而出，顿时$n如受刀割！\n",this_object()->name()),
                           me,victim);
    victim->receive_wound("sen",dam,me);
  }

  victim->start_busy(1);
  return 0;
}	