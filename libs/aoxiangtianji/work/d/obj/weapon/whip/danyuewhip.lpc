#include <weapon.h>
inherit WHIP;
void create()
{
  set_name("淡月鞭", ({"danyue whip", "bian", "whip"}));
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long","一条银白色的长鞭，挥舞起来宛如淡淡的月辉。\n");
    set("unit", "条");
    set("value", 1200);
    set("material", "silver");
  }

  init_whip(30);
  setup();
}

