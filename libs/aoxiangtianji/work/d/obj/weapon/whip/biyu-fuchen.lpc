#include <weapon.h>
inherit WHIP;
void create()
{
  set_name("碧玉拂尘", ({ "biyu fuchen","fuchen","whip"}));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "柄");
    set("long",
"这是一柄碧玉柄拂尘，做工精细，拂尘丝丝晶莹坚韧，看来是仙界宝物。\n");
    set("value", 50000);
    set("no_give", 1);
    set("no_sell", 1);
    set("material", "leather");
    set("wield_msg","$N「唰」的一声从颈中抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n别回颈中。\n");
  }

  init_whip(80);
  setup();
}

