#include <ansi.h>
#include <weapon.h>
inherit BLADE;
void create()
{
  set_name(HIG"碧月刀"NOR, ({"biyue blade", "blade"}));
  set_weight(8000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "把");
    set("long", "一把雪亮的单刀，仞口碧玉一般，透射一股寒光．\n");
    set("value", 12000);
    set("material", "steel");
    set("wield_msg","$N「唰」地一声抽出一把$n握在手中，脸色更加阴沉了！\n");
    set("unwield_msg","$N将手中的$n插入腰间，嘴角露出一丝笑意．\n");
  }

  init_blade(60);
  setup();
}

