// dadao.c
#include <weapon.h>
inherit BLADE;
void create()
{
  set_name("大刀", ({ "dadao","blade" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "柄");
    set("long", "这是一柄亮晃晃的长柄大刀。\n");
    set("value", 6000);
    set("material", "iron");
    set("wield_msg", "$N「唰」的一声拿出一柄$n，顺手舞动了几下。\n");
    set("unwield_msg", "$N将手中的$n挂在了马边。\n");
  }

  set("attack_distance", 120);
  init_blade(40);
  setup();
}

