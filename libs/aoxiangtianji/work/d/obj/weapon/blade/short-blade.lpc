// blade.c
#include <weapon.h>
inherit BLADE;
void create()
{
  set_name("短刀", ({"short blade", "duan dao", "dao"}) );
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "柄");
    set("value", 3500);
    set("material", "iron");
    set("long", "这是一寻常的短刀，刀短背厚。\n");
    set("attack_distance", 45);
    set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
  }

  init_blade(30);
  setup();
}

