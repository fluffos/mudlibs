#include <weapon.h>
inherit BLADE;
void create()
{
  set_name("白玉板", ({ "baiyu ban", "baiyuban", "yuban", "blade" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "把");
    set("value", 10000);
    set("material", "wood");
    set("wield_msg", "$N拿起一块$n挥了挥。\n");
    set("unwield_msg", "$N将$n插回腰间。\n");
  }

  init_blade(35);
  setup();
}

