#include <ansi.h>
#include <weapon.h>
inherit STAFF;
void create()
{
  set_name( "新手铁杖", ({ "newbie tiezhang", "staff" }) );
  set_weight(8000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "条");
    set("long", "一条沉重的铁杖。\n");
    set("value", 0);
    set("no_give",1);
    set("no_put",1);
    set("no_get",1);
    set("no_sell",1);
    set("drop_des",1);
    set("material", "steel");
  }

  init_staff(50);
  setup();
}

