#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create()
{
  set_name("凤凰琴", ({"fenghuang qin","qin","sword"}));
  set_weight(4000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "把");
    set("value", 19000);
    set("material", "steel");
    set("wield_msg", "$N冷笑一声，从背后拔出了凤凰琴。\n");
    set("unwield_msg", "$N将手中的凤凰琴插回鞘中，嘴角多了一丝笑意。\n");
  }

  init_sword(75);
  setup();
}

