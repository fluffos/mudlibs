// bamboo_sword.c
#include <weapon.h>
inherit SWORD;
void create()
{
  set_name("新手钢剑",({ "newbie sword", "jian", "sword" }) );
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "把");
    set("value", 0);
    set("no_give",1);
    set("no_put",1);
    set("no_get",1);
    set("no_sell",1);
    set("drop_des",1);
    set("material", "steel");
    set("long", "这是一把新手使用的钢剑。\n");
    set("wield_msg", "$N拿出一把$n，握在手中。\n");
    set("unequip_msg", "$N放下手中的$n。\n");
  }

  init_sword(50);
  setup();
}

