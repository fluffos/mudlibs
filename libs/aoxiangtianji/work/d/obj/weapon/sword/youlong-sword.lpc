// blade.c
#include <weapon.h>
inherit SWORD;
void create()
{
  set_name("游龙剑", ({"youlong sword", "sword", "jian"}));
  set_weight(4000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long","一把精钢细作而成的长剑，剑身盘旋着一条游龙．\n");
    set("unit", "把");
    set("value", 8500);
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }

  init_sword(55);
  setup();
}

