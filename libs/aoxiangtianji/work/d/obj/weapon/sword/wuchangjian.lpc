#include <weapon.h>
inherit SWORD;
void create()
{
  set_name("无常剑", ({"wuchang sword", "sword"}));
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一把黑色的长剑，仞口闪着寒光。\n");
    set("unit", "根");
    set("material", "steel");
    set("wield_msg", "$N阴笑一声，手里已多了一把$n。\n");
    set("value", 3000);
  }

  init_sword(40);
  setup();
}

