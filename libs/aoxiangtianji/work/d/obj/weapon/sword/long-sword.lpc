// changjian.c 长剑
#include <weapon.h>
inherit SWORD;
void create()
{
  set_name("长剑", ({"long sword", "changjian", "jian", "sword"}));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "柄");
    set("long", "这是一柄长长的精钢剑，剑口锋利，似乎更适合双手使用。\n");
    set("value", 4000);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }

  init_sword(35);
  setup();
}

