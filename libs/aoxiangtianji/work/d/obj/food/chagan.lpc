#include <ansi.h>
inherit ITEM;
void create()
{
  set_name("五香茶干", ({"cha gan", "gan"}));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一碟五香茶干。\n");
    set("unit", "碟");
    set("value", 120);
    set("food_remaining", 6);
    set("food_supply", 25);
  }

}

