inherit ITEM;
inherit F_LIQUID;
void create()
{
  set_name("油葫芦", ({"you hulu", "youhulu", "hulu", "hu"}));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一个装满菜油的葫芦。\n");
    set("unit", "个");
    set("value", 100);
    set("max_liquid", 20);
    set("liquid", ([
      "type" : "oil",
      "name" : "菜油",
      "remaining" : 12,
   ]));
   set("only_do_effect", 1);
  }

  setup();
}

void do_effect()
{
  object me = this_player();

  if (!present(this_object() , me))
  {
    write("你要喝什么？\n");
    return;
  }

  write("你要喝油？这东西实在是不好喝！\n");
  return;
}

