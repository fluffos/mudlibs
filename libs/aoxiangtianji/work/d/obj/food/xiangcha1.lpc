#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;
void create()
{
  set_name(HIY"檀木茶盅"NOR, ({"tanmu chazhong", "chazhong", "cha", "teapot", "tea"}));
  set_weight(50);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一只檀木茶盅，一股清香直透了出来。\n");
    set("unit", "只");
    set("max_liquid", 2);
  }

  set("liquid", ([
     "type": "water",
     "name": "仙茶",
     "remaining": 2,
  ]) );
  setup();
}

