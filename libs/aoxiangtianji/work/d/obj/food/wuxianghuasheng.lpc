#include <ansi.h>
inherit ITEM;
void create()
{
  set_name("花生豆", ({"huasheng", "dou"}));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一碟花生豆．\n");
    set("unit", "碟");
    set("value", 50);
    set("food_remaining", 4);
    set("food_supply", 10);
  }

  setup();
}		