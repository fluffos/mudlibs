// longpao.c
#include <armor.h>
inherit CLOTH;
void create()
{
  set_name("水晶战袍", ({"shuijing zhanpao","cloth","pao"}));
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("value", 5000);
    set("material", "gem");
    set("armor_prop/spells", 30);
    set("armor_prop/dodge", 30);
  }

  init_cloth(80);
  setup();
}

