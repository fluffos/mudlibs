#include <armor.h>
inherit CLOTH;
void create()
{
  set_name("锦绣战袍", ({"jinxiu zhanpao", "cloth"}));
  set_weight(4000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一件绣花战袍。\n");
    set("material", "silver");
    set("unit", "件");
    set("value", 10000);
  }

  init_cloth(45);
  setup();
}

