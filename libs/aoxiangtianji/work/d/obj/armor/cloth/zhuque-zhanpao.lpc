#include <armor.h>
inherit CLOTH;
void create()
{
  set_name("朱雀战袍", ({"zhuque zhanpao", "cloth"}));
  set_weight(4000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一件绣有朱雀的白色战袍。\n");
    set("material", "silver");
    set("unit", "件");
    set("value", 8000);
  }

  init_cloth(40);
  setup();
}

