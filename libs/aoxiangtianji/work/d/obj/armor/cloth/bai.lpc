#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create()
{
  set_name(WHT"白袍"NOR, ({"white cloth", "cloth"}));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "silk");
    set("long", "一件雪白的布袍，一丝杂色也没有．\n");
    set("unit", "件");
    set("value", 200);
  }

  init_cloth(15);
  setup();
}

