// longpao.c
#include <armor.h>
inherit CLOTH;
void create()
{
  set_name("新手战袍", ({"newbie pao","cloth","pao"}));
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("long",
"给新手使用的战袍．\n");
    set("value", 0);
    set("no_give",1);
    set("no_put",1);
    set("drop_des",1);
    set("no_get",1);
    set("no_sell",1);
    set("material", "leather");
    set("armor_prop/personality", 3);
  }

  init_cloth(40);
  setup();
}

