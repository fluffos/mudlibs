#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create()
{
  set_name(HIB"黑袍"NOR, ({"black cloth", "cloth"}));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "fiber");
    set("long", "一件黑色的布袍，一丝杂色也没有．\n");
    set("unit", "件");
    set("value", 200);
  }

  init_cloth(15);
  setup();
}

