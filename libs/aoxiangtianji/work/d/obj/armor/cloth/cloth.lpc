//上衣  min_armor: 2  max_armor: 80  default_armor: 20
#include <armor.h>
inherit CLOTH;
void create()
{
  set_name("粗布上衣", ({"cubu cloth", "cloth"}));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("long", "一件普通的上衣。\n");
    set("material", "cloth");
    set("value", 500);
  }

  init_cloth(10);
  setup();
}

