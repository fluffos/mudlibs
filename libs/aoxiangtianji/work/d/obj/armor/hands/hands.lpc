//手套  min_armor: 2  max_armor: 15  default armor : 5
#include <armor.h>
inherit HANDS;

void create()
{
  set_name("棉手套", ({ "cloth hands", "hands" }) );
  set_weight(300);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "cloth");
    set("unit", "双");
    set("long", "一双棉手套。\n");
    set("value", 500);
  }

  init_hands(4);
  setup();
}