#include <armor.h>
inherit HANDS;

void create()
{
  set_name("软皮手套", ({ "ruanpi hands", "hands" }) );
  set_weight(1300);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "leather");
    set("unit", "双");
    set("long", "一双软皮手套。\n");
    set("value", 80000);
  }

  init_hands(12);
  setup();
}

