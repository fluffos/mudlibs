//长裙  min_armor: 1  max_armor: 12  default_armor: 8
#include <armor.h>
inherit SKIRTS;
void create()
{
  set_name("碎花裙", ({"suihua skirts", "skirts"}));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("long", "一件很普通的碎花长裙。\n");
    set("material", "cloth");
    set("value", 800);
  }

  init_skirts(10);
  setup();
}

