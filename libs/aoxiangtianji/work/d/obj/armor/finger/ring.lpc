//ring.c
#include <ansi.h>
#include <armor.h>
inherit FINGER;
void create()
{
  set_name(MAG"紫金戒指"NOR, ({ "zijin jiezhi", "jiezhi", "ring" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "个");
    set("value", 3000);
    set("material", "gold");
  }

  init_finger(1);
  setup();
}

