//指环  min_armor: 1  max_armor: 10  default armor : 2
#include <armor.h>
inherit FINGER;

void create()
{
  set_name("铁指环", ({ "iron finger", "finger" }) );
  set_weight(300);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "iron");
    set("unit", "枚");
    set("long", "一枚铁制的指环。\n");
    set("value", 1000);
  }

  init_finger(2);
  setup();
}