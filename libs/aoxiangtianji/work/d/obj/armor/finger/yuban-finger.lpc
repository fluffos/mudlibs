#include <armor.h>
inherit FINGER;
void create()
{
  set_name("玉班指", ({ "yuban zhi", "finger", "ring" }));
  set("weight", 600);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "个");
    set("value", 25000);
    set("material", "gem");
    set("armor_prop/personality", 1);
  }

  set("armor_prop/armor", 5);
  setup();
}

