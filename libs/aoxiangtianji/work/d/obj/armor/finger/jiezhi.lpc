// goldring.c 金戒指
#include <armor.h>
inherit FINGER;
void create()
{
  set_name("金戒指", ({ "jin jiezhi", "jiezhi", "ring" }));
  set("weight", 400);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "个");
    set("value", 2000);
    set("material", "gold");
  }

  init_finger(1);
  setup();
}

