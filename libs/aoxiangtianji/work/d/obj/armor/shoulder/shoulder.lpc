//护肩  min_armor: 2  max_armor: 15  default armor : 8
#include <armor.h>
inherit SHOULDER;

void create()
{
  set_name("牛皮护肩", ({ "leather shoulder", "shoulder" }) );
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "leather");
    set("unit", "条");
    set("long", "这是一条牛皮做成的护肩。\n");
    set("value", 1800);
  }

  init_shoulder(8);
  setup();
}