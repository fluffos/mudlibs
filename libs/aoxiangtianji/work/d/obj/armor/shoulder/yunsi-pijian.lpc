#include <armor.h>
inherit SHOULDER;

void create()
{
  set_name("云丝披肩", ({ "yunsi shoulder", "shoulder" }) );
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "gem");
    set("unit", "条");
    set("long", "这是一条闪着宝石光泽，极薄透明的披肩。\n");
    set("value", 180000);
  }

  init_shoulder(15);
  setup();
}

