//盾 min_armor: 5  max_armor: 30 default_armor: 10
#include <armor.h>
inherit SHIELD;

void create()
{
  set_name("皮盾", ({ "leather shield", "shield", "dun" }) );
  set_weight(4000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "leather");
    set("unit", "面");
    set("long", "这是一面皮盾。\n");
    set("value", 1000);
  }

  init_shield(10);
  setup();
}