#include <armor.h>
inherit SHIELD;

void create()
{
  set_name("千滕盾", ({ "qianteng shield", "shield", "dun" }) );
  set_weight(6000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "wood");
    set("unit", "面");
    set("long", "这是一面古滕绕成的盾。\n");
    set("value", 120000);
  }

  init_shield(20);
  setup();
}

