#include <armor.h>
inherit SHIELD;

void create()
{
  set_name("新手盾牌", ({ "newbie shield", "shield", "dun" }) );
  set_weight(4000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "leather");
    set("unit", "面");
    set("long", "这是一面皮盾。\n");
    set("value", 0);
    set("no_give",1);
    set("no_put",1);
    set("drop_des",1);
    set("no_get",1);
    set("no_sell",1);
  }

  init_shield(12);
  setup();
}

