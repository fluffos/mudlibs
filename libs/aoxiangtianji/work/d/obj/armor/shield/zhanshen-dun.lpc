#include <armor.h>
inherit SHIELD;

void create()
{
  set_name("战神盾牌", ({ "zhanshen shield", "shield", "dun" }) );
  set_weight(6000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "iron");
    set("unit", "面");
    set("long", "这是一面精铁镶边的盾。\n");
    set("value", 50000);
  }

  init_shield(12);
  setup();
}

