//胸饰  min_armor: 1  max_armor: 10  default armor : 3
#include <armor.h>
inherit FLOWER;

void create()
{
  set_name("银胸饰", ({ "silver flower", "flower" }) );
  set_weight(300);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "silver");
    set("unit", "枚");
    set("long", "一枚亮晶晶的胸饰。\n");
    set("value", 2000);
  }

  init_flower(2);
  setup();
}