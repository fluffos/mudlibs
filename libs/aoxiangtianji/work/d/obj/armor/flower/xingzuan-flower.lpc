#include <armor.h>
inherit FLOWER;

void create()
{
  set_name("星钻胸饰", ({ "xingzuan flower", "flower" }) );
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "gem");
    set("unit", "枚");
    set("long", "一枚亮晶晶的胸饰。\n");
    set("value", 20000);
    set("armor_prop/personality", 1);
  }

  init_flower(5);
  setup();
}

