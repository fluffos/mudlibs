//鞋子  min_armor: 2  max_armor: 20  default armor : 8
#include <armor.h>
inherit BOOTS;

void create()
{
  set_name("厚底鞋", ({ "houdi shoes", "shoes" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "cloth");
    set("unit", "双");
    set("long", "这是一双厚底，用布做成的鞋子。\n");
    set("value", 1200);
  }

  init_boots(5);
  setup();
}