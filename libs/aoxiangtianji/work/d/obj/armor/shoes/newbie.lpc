#include <armor.h>
inherit BOOTS;

void create()
{
  set_name("新手战鞋", ({ "newbie shoes", "shoes" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "cloth");
    set("unit", "双");
    set("long", "这是一双厚底，用布做成的鞋子。\n");
    set("value", 0);
    set("no_give",1);
    set("no_put",1);
    set("no_get",1);
    set("no_sell",1);
    set("drop_des",1);
    set("armor_prop/dodge", 5);
  }

  init_boots(10);
  setup();
}

