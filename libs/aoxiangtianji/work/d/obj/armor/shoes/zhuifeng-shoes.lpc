#include <armor.h>
inherit BOOTS;
void create()
{
  set_name("追风快靴", ({ "zhuifeng shoes","shoes" }) );
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "双");
    set("long", "一双薄底的云履。\n");
    set("value", 20000);
    set("armor_prop/dodge", 5);
  }

  init_boots(8);
  setup();
}

