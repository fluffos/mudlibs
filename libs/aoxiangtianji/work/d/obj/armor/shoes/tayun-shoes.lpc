#include <armor.h>
inherit BOOTS;
void create()
{
  set_name("踏云追风", ({ "tayun shoes","shoes" }) );
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "双");
    set("long", "一双薄底的云履。\n");
    set("value", 120000);
    set("armor_prop/dodge", 10);
  }

  init_boots(12);
  setup();
}

