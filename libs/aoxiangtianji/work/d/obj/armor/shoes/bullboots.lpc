#include <armor.h>
inherit BOOTS;
void create()
{
  set_name("公牛皮靴", ({"leather boots", "boots"}));
  set_weight(700);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "双");
    set("long","一双皮靴，上等牛皮制成。\n");
    set("value", 400);
    set("material", "leather");
  }

  init_boots(5);
  setup();
}

