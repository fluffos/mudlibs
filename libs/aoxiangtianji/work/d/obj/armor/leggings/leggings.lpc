//护膝  min_armor: 1  max_armor: 10  default armor : 5
#include <armor.h>
inherit LEGGINGS;

void create()
{
  set_name("厚布护膝", ({ "houbu huxi", "leggings" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "cloth");
    set("unit", "对");
    set("long", "这是一对厚厚的棉布做成的护膝。\n");
    set("value", 800);
  }

  init_leggings(5);
  setup();
}