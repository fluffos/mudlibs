#include <armor.h>
inherit LEGGINGS;

void create()
{
  set_name("千层护膝", ({ "qianceng huxi", "leggings" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "cloth");
    set("unit", "对");
    set("long", "这是一对层层密缝精制做成的护膝。\n");
    set("value", 8000);
  }

  init_leggings(6);
  setup();
}

