#include <armor.h>
inherit NECK;

void create()
{
  set_name("黄金项圈", ({ "golden neck", "neck" }) );
  set_weight(2500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "gold");
    set("unit", "条");
    set("long", "这是一条金灿灿的项圈。\n");
    set("value", 80000);
  }

  init_neck(12);
  setup();
}

