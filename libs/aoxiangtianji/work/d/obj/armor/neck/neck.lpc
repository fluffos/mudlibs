//护颈 min_armor: 1 max_armor: 20 default_armor: 5
#include <armor.h>
inherit NECK;

void create()
{
  set_name("棉围脖", ({ "cloth neck", "neck" }) );
  set_weight(600);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "cloth");
    set("unit", "条");
    set("long", "这是一条棉围脖。\n");
    set("value", 800);
  }

  init_neck(5);
  setup();
}

