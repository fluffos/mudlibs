// huwan.c 护腕
#include <armor.h>
inherit WRISTS;
void create()
{
  set_name("皮护腕", ({"leather wrists", "hu wan", "huwan" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
   set("unit", "双");
   set("long", "这是一件皮护腕，用以保护腕部。\n");
   set("value", 2200);
   set("material", "leather");
  }

  init_wrists(10);
  setup();
}

