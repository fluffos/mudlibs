//护腕 min_armor: 1 max_armor: 15 default_armor: 8
#include <armor.h>
inherit WRISTS;
void create()
{
  set_name("厚布护腕", ({ "houbu wrists", "wrists" }) );
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
   set("unit", "双");
   set("long", "这是一双布质的护腕，用以保护腕部。\n");
   set("value", 1300);
   set("material", "cloth");
  }

  init_wrists(5);
  setup();
}

