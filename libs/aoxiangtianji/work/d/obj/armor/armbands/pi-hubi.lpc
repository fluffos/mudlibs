#include <armor.h>
inherit ARMBANDS;

void create()
{
  set_name("皮护臂", ({ "pi hubi", "armbands" }) );
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "leather");
    set("unit", "条");
    set("long", "这是一条厚厚的棉布做成的护臂，绑在手臂上，可以保护手臂。\n");
    set("value", 8000);
  }

  init_armbands(10);
  setup();
}

