//护臂  min_armor: 1  max_armor: 20  default armor : 5
#include <armor.h>
inherit ARMBANDS;

void create()
{
  set_name("厚布护臂", ({ "houbu hubi", "armbands" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "cloth");
    set("unit", "条");
    set("long", "这是一条厚厚的棉布做成的护臂，绑在手臂上，可以保护手臂。\n");
    set("value", 1500);
  }

  init_armbands(5);
  setup();
}