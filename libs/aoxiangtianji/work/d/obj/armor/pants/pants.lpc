//裤子 min_armor: 1 max_armor: 30 default_armor: 10
#include <armor.h>
inherit PANTS;

void create()
{
  set_name("粗布裤", ({ "cloth pants", "pants" }) );
  set_weight(800);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "cloth");
    set("unit", "条");
    set("long", "这是一条长裤。\n");
    set("value", 200);
  }

  init_pants(5);
  setup();
}

