// tongjia.c
#include <armor.h>
inherit ARMOR;
void create()
{
  set_name("熟铜甲", ({"bronze armor","tongjia","jia","armor"}));
  set_weight(25000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("long", "一件金灿灿的熟铜甲。\n");
    set("value", 7000);
    set("material", "brass");
    set("armor_prop/dodge", -5);
  }

  init_armor(40);
  setup();
}

