#include <ansi.h>
#include <armor.h>
inherit ARMOR;
void create()
{
  set_name(HIY"金丝甲"NOR, ({ "jinsi jia", "jinsi", "jia"}));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("value", 180000);
    set("material", "gold");
  }

  init_armor(80);
  setup();
}

