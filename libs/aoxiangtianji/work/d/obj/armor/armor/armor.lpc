//护甲  min_armor: 5  max_armor: 80  default_armor: 20
#include <armor.h>
inherit ARMOR;
void create()
{
  set_name("铁甲", ({"iron armor", "armor"}));
  set_weight(20000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("long", "一件普通的铁甲，看上去很笨重。\n");
    set("material", "iron");
    set("value", 3000);
    set("armor_prop/dodge", -5);
  }

  init_armor(20);
  setup();
}

