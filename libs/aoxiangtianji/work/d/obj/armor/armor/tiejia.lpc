// tiejia.c
#include <armor.h>
inherit ARMOR;
void create()
{
  set_name("黑铁甲", ({"black armor","heitie jia","jia","armor"}));
  set_weight(30000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("long", "一件沉甸甸的铁甲。\n");
    set("value", 5000);
    set("material", "iron");
    set("armor_prop/dodge", -5);
  }

  init_armor(40);
  setup();
}

