#include <armor.h>
inherit SURCOAT;
void create()
{
  set_name("新手大氅", ({"newbie surcoat", "surcoat"}));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("long", "一件很漂亮的大氅。\n");
    set("material", "cloth");
    set("value", 0);
    set("no_give",1);
    set("no_put",1);
    set("drop_des",1);
    set("no_get",1);
    set("no_sell",1);
  }

  init_surcoat(15);
  setup();
}

