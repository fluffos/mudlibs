#include <armor.h>
inherit SURCOAT;
void create()
{
  set_name("绣云披风", ({"xiuyun pifeng", "pifeng"}));
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一件锦缎所制的披风。\n");
    set("material", "silk");
    set("unit", "件");
    set("value", 200000);
    set("armor_prop/spells", 10);
    set("armor_prop/dodge", 10);
  }

  init_surcoat(22);
  setup();
}

