#include <armor.h>
inherit SURCOAT;
void create()
{
  set_name("兽皮披风", ({"shoupi pifeng", "pifeng", "cloth" }));
  set_weight(4500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一件兽皮披风。\n");
    set("material", "leather");
    set("unit", "件");
    set("value", 700);
    set("armor_prop/courage", 5);
    set("armor_prop/dodge", 10);
  }

  init_surcoat(20);
  setup();
}

