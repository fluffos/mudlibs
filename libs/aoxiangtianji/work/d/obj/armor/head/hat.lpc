#include <armor.h>
inherit HEAD;

void create()
{
  set_name("小帽", ({ "xiao mao", "hat" }) );
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "cloth");
    set("unit", "顶");
    set("long", "这是一顶铁质的头盔，用以保护头部。\n");
    set("value", 200);
  }

  init_head(5);
  setup();
}