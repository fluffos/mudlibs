//头盔 min_armor: 2  max_armor: 40 default_armor: 15
#include <armor.h>
inherit HEAD;

void create()
{
  set_name("铁头盔", ({ "iron helmet", "head" }) );
  set_weight(2500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "steel");
    set("unit", "顶");
    set("long", "这是一顶铁质的头盔，用以保护头部。\n");
    set("value", 1500);
  }

  init_head(8);
  setup();
}