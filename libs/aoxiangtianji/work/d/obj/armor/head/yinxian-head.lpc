#include <armor.h>
inherit HEAD;

void create()
{
  set_name("银线头巾", ({ "yinxian head", "head" }) );
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "silver");
    set("unit", "顶");
    set("long", "这是一顶柔软的头巾，用以保护头部。\n");
    set("value", 150000);
  }

  init_head(25);
  setup();
}

