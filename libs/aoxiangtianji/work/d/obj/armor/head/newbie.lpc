#include <armor.h>
inherit HEAD;

void create()
{
  set_name("新手头盔", ({ "newbie helmet", "head" }) );
  set_weight(2500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "steel");
    set("unit", "顶");
    set("long", "这是一顶铁质的头盔，用以保护头部。\n");
    set("value", 0);
    set("no_give",1);
    set("no_put",1);
    set("drop_des",1);
    set("no_get",1);
    set("no_sell",1);
  }

  init_head(20);
  setup();
}

