#include <armor.h>
inherit WAIST;
void create()
{
  set_name( "玉烟带", ({ "yuyan waist", "waist" }) );
  set_weight(600);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "条");
    set("long", "这是一条镶嵌宝石的腰带。\n");
    set("value", 160000);
    set("material", "gem");
  }

  init_waist(12);
  setup();
}

