//护腰 min_armor: 1 max_armor: 20 default_armor: 8
#include <armor.h>
inherit WAIST;
void create()
{
  set_name( "绸布护腰", ({ "choubu waist", "waist" }) );
  set_weight(600);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "条");
    set("long", "这是一条绸布的护腰，用以保护腰部。\n");
    set("value", 1600);
    set("material", "cloth");
  }

  init_waist(5);
  setup();
}

