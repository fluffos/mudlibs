#include <armor.h>
inherit CAPE;

void create()
{
  set_name("银丝背甲", ({ "silver cape", "cape" }) );
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "leather");
    set("unit", "件");
    set("long", "这是一件银丝穿牛皮而成的背甲，穿在身上可以保护后背。\n");
    set("value", 120000);
  }

  init_cape(12);
  setup();
}

