//背甲  min_armor: 2  max_armor: 20  default armor : 10
#include <armor.h>
inherit CAPE;

void create()
{
  set_name("牛皮背甲", ({ "leather cape", "cape" }) );
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "leather");
    set("unit", "件");
    set("long", "这是一件做成的背甲，穿在身上可以保护后背。\n");
    set("value", 2500);
  }

  init_cape(10);
  setup();
}