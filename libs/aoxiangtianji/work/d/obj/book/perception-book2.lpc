#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(YEL "「听风辩器进阶」" NOR, ({ "perception book2", "book2" }));
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long", YEL "封面上写着一行隶书：听风辩器－－进阶篇。\n" NOR);
    set("value", 10000);
    set("material", "paper");
    set("skill",
    ([
       "name": "perception",
       "exp_required": 50000,
       "sen_cost"  : 30,
       "difficulty": 30,
       "max_skill" : 50,
       "min_skill" : 30,
    ]) );
  }

}

