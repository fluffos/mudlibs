// advance_unarmed.c
inherit ITEM;
void create()
{
  set_name("拳脚详解", ({ "unarmed book", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long",
"封面上写著「拳脚详解）」\n");
    set("value", 3000);
    set("material", "paper");
    set("skill", ([
        "name":         "unarmed",
        "exp_required": 10000,
        "sen_cost":    25,
        "difficulty":   25,
        "max_skill":    50,
        "min_skill":    20,
    ]));
  }

}

