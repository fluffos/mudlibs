inherit ITEM;
void create()
{
  set_name("〖断肠集〗", ({"book"}));
  set_weight(600);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("value", 1000);
    set("material", "paper");
    set("skill", ([
          "name": "literate",
          "sen_cost": 50,
          "difficulty": 40,
          "max_skill": 200,
          "min_skill" : 180,
    ]) );
  }

}

int read_effect(object me)
{
  int num = 0;

  if (me->query("gender") == "女性")
    num -= 20;
  else
    num += 20;
  if (this_object()->query("owner") == me->query("id"))
    num -= 20;
  return num;
}

