#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(YEL "「书法艺术高阶」" NOR, ({ "calligraphy book2", "book2" }));
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long", YEL "一本讲解书法艺术的初级书本。\n" NOR);
    set("value", 10000);
    set("material", "paper");
    set("skill",
    ([
       "name": "calligraphy",
       "sen_cost"  : 40,
       "difficulty": 40,
       "max_skill" : 99,
       "min_skill" : 50,
    ]) );
  }

}

