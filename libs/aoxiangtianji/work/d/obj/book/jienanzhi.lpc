#include <ansi.h>
 inherit ITEM;
void create()
{
  set_name(HIM "「劫难指」" NOR, ({ "jienan zhi", "jienan", "zhi", "book" }));
  set_weight(500);
  if (clonep())
    destruct(this_object());
  else
  {
    set("unit", "本");
    set("long", YEL "这是一本薄薄的书册，书皮已然发黄，封"
                    "面上写着「劫难指」三个字。\n" NOR);
    set("value", 1);
    set("no_sell", 1);
    set("material", "paper");
    set("skill", ([
         "name" : "jienan-zhi",
         "exp_required" : 10000,
         "sen_cost":  30,
         "difficulty": 30,
         "max_skill":  60,
         "min_skill":  0
    ]));
  }

}

