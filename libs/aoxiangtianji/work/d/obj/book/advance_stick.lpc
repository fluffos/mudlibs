inherit ITEM;
void create()
{
  set_name("〖棍法详解〗", ({"stick book", "book"}));
  set_weight(600);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("value", 3000);
    set("material", "paper");
    set("skill", ([
          "name": "stick",
          "exp_required": 5000,
          "sen_cost": 25,
          "difficulty": 25,
          "max_skill": 50,
          "min_skill" : 20,
    ]) );
  }

}

