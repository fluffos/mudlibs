inherit ITEM;
void create()
{
  set_name("〖杖法入门〗", ({"staff book", "book"}));
  set_weight(600);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("value", 1000);
    set("material", "paper");
    set("skill", ([
          "name": "staff",
          "exp_required": 100,
          "sen_cost": 20,
          "difficulty": 20,
          "max_skill": 20,
    ]) );
  }

}

