inherit ITEM;
void create()
{
  set_name("七星剑谱", ({ "sword book", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("no_sell",1);
    set("no_give",1);
    set("no_put",1);
    set("drop_des",1);
    set("long",
"封面上写著「七星剑法」\n");
    set("value", 10000);
    set("material", "paper");
    set("skill", ([
        "name":         "qixing-sword",
        "exp_required":  10000,
        "sen_cost"    :  40,
        "difficulty"  :  30,
        "max_skill"   :  100,
        "min_skill"   :  50,
    ]));
  }

}

int read_effect(object me)
{
  if (this_object()->query("owner") == me->query("id"))
    return -30;
  return 30;
}

