#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(YEL "「听风辩器详解」" NOR, ({ "perception book3", "book3" }));
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long", YEL "封面上写着一行隶书：听风辩器－－详解篇。\n" NOR);
    set("value", 50000);
    set("material", "paper");
    set("skill",
    ([
       "name": "perception",
       "exp_required": 100000,
       "sen_cost"  : 30,
       "difficulty": 30,
       "max_skill" : 100,
       "min_skill" : 50,
    ]) );
  }

}

