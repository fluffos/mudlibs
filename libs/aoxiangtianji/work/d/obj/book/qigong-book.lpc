inherit ITEM;
void create()
{
  set_name("吐纳气功", ({ "qigong book", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long",
"封面上写著「吐纳气功」\n");
    set("value", 5000);
    set("material", "paper");
    set("skill", ([
        "name" : "tuna-qigong",
        "exp_required" : 1000,
        "sen_cost"  :   25,
        "difficulty":   25,
        "max_skill" :   100,
    ]));
  }

}

