// 天山折梅手法图
inherit ITEM;
void create()
{
  set_name( "逍遥折梅手法图下卷", ({ "shoufa tu2", "tu2" }));
  set_weight(200);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "幅");
    set("long", "这是一幅天山折梅手法图，上面画着一些纷繁复杂的招式。\n");
    set("value", 500);
    set("no_put", 1);
    set("material", "paper");
    set("skill", ([
      "name" : "zhemei-shou",
      "exp_required" : 100000,  // minimum combat experience required
      "sen_cost" : 40, // jing cost every time study this
      "difficulty" : 40, // the base int to learn this skill
      "max_skill" : 99, // the maximum level you can learn
      "min_skill" : 50, // the minimum level you can learn
    ]) );
  }

}

int read_effect(object me)
{
  if (this_object()->query("owner") == me->query("id"))
    return -50;
  return 50;
}

