#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(YEL "「听风辩器初级」" NOR, ({ "perception book1", "book1" }));
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long", YEL "封面上简单的写着：听风辩器－－初级。\n" NOR);
    set("value", 5000);
    set("material", "paper");
    set("skill",
    ([
       "name": "perception",
       "exp_required": 10000,
       "sen_cost"  : 30,
       "difficulty": 30,
       "max_skill" : 30,
    ]) );
  }

}

