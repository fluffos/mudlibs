#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(YEL "「棋艺探讨」" NOR, ({ "chess book2", "book2" }));
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long", YEL "一本讲解奕棋的读本。\n" NOR);
    set("value", 12000);
    set("material", "paper");
    set("skill",
    ([
       "name": "chess",
       "sen_cost"  : 50,
       "difficulty": 50,
       "max_skill" : 99,
       "min_skill" : 50,
    ]) );
  }

}

