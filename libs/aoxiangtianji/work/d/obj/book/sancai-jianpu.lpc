inherit ITEM;
void create()
{
  set_name("〖三才剑谱〗", ({ "jian pu", "shu", "book" }));
  set_weight(600);
  if( clonep() )
        set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long", "这是一本三才剑法的图解，书角已经有些残破了。\n");
    set("value", 100);
    set("material", "paper");
    set("skill",
    ([
      "name" : "sancai-sword",
      "exp_required" : 10000,
      "sen_cost" : 30,
      "difficulty" : 30,
      "max_skill" : 100,
      "min_skill" : 0,
    ]) );
  }

}

int read_effect(object me)
{
  if (this_object()->query("owner") == me->query("id"))
    return -30;
  return 30;
}

