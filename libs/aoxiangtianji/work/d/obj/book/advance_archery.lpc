inherit ITEM;
void create()
{
  set_name("弓箭详解", ({ "arrow book", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long",
"封面上写著「弓箭详解）」\n");
    set("value", 5000);
    set("material", "paper");
    set("skill", ([
        "name" : "archery",
        "exp_required" : 5000,
        "sen_cost" : 25,
        "difficulty" : 25,
        "max_skill"  : 50,
        "min_skill"  : 20,
    ]));
  }

}

