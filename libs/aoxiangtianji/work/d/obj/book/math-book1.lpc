#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(YEL "「算术入门」" NOR, ({ "mathematics book1", "book1" }));
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long", YEL "一本讲解算术的初级书本。\n" NOR);
    set("value", 5000);
    set("material", "paper");
    set("skill",
    ([
       "name": "mathematics",
       "sen_cost"  : 30,
       "difficulty": 30,
       "max_skill" : 49,
       "min_skill" : 0,
    ]) );
  }

}

