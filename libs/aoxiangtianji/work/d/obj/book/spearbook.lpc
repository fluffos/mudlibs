inherit ITEM;
void create()
{
  set_name("〖枪法介绍〗", ({"spear book", "book"}));
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("value", 2000);
    set("no_sell", 1);
    set("long", "一本薄薄的小册子．画了些枪法的图解．\n");
    set("material", "paper");
    set("skill", ([
          "name": "spear",
          "exp_required": 10000,
          "sen_cost": 30,
          "difficulty": 30,
          "max_skill": 80,
          "min_skill" : 50,
    ]) );
  }

}

int read_effect(object me)
{
  if (this_object()->query("owner") == me->query("id"))
    return -30;
  return 30;
}

