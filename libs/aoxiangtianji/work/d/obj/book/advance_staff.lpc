inherit ITEM;
void create()
{
  set_name("杖法详解", ({ "staff book", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long",
"封面上写著「杖法详解）」\n");
    set("value", 3000);
    set("material", "paper");
    set("skill", ([
        "name" : "staff",
        "exp_required" : 5000,
        "sen_cost"  :    25,
        "difficulty":   25,
        "max_skill" :   50,
        "min_skill" :    20,
    ]));
  }

}

