// advance_force.c
inherit ITEM;
void create()
{
  set_name("〖内功初解〗", ({ "force book", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long",
"封面上写著「内功初解）」\n");
    set("value", 1000);
    set("material", "paper");
    set("skill", ([
        "name" :  "force",
        "exp_required" : 500,
        "sen_cost"   :    25,
        "difficulty" :   20,
        "max_skill"  :    20,
    ]));
  }

}

