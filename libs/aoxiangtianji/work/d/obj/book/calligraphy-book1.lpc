#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(YEL "「书法艺术入门」" NOR, ({ "calligraphy book1", "book1" }));
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long", YEL "一本讲解书法艺术的初级书本。\n" NOR);
    set("value", 3000);
    set("material", "paper");
    set("skill",
    ([
       "name": "calligraphy",
       "sen_cost"  : 25,
       "difficulty": 25,
       "max_skill" : 49,
       "min_skill" : 0,
    ]) );
  }

}

