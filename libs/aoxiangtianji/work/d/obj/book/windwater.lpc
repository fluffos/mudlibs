inherit ITEM;
void create()
{
  set_name("〖风水〗", ({"book","shu"}));
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long",
"一本脏兮兮的小册子。上面划着一地形之类的图案。\n");
    set("material", "paper");
    set("value", 100);
    set("skill", ([
       "name": "spells",
       "sen_cost": 20,
       "difficulty": 20,
       "max_skill": 20,
    ]) );
  }

  setup();
}

int read_effect(object me)
{
  if (this_object()->query("owner") == me->query("id"))
    return -30;
  return 30;
}

