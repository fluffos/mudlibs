// literate.c
#include <ansi.h>
inherit ITEM;
void set_skill (string str);
void create()
{
  set_name(HIW"〖无字经〗"NOR, ({"wuzi jing", "jing", "book"}));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("material", "paper");
    set("value", 0);
    set("long", "一本薄薄的无字经。\n");
    set("no_drop", "这东西不能丢。\n");
    set("no_put", "珍惜它吧。\n");
    set("no_give", "这东西不能送人。\n");
    set("no_get", "这东西拿不起来\n");
    set("no_sell", "这也能够卖？\n");
    set("auto_dest", 1);
  }

  setup();
}

void init ()
{
  object me = this_object();
  object where = environment();
  string sk_d;
  if (where && playerp(where))
  {
    add_action ("do_decide", "decide");
    sk_d = where->query("obstacle/book");
    if (stringp(sk_d))
      set_skill (sk_d);
    if (me->query("owner"))
    {
      if (me->query("owner") != where->query("id"))
      {
        message_vision("$N一不小心，$n掉到地上不见了：（\n", where, me);
        destruct(me);
      }

    }

    else
      me->set("owner",where->query("id"));
  }

}

void set_skill (string str)
{
  set("skill", ([
        "name": str,
        "exp_required": 1000000,
        "sen_cost": 40,
        "difficulty": 40,
        "max_skill": 200,
  ]));
}

mapping skills = ([
  "archery": "基本弓箭",
  "axe": "基本斧法",
  "blade": "基本刀法",
  "dagger": "短兵刃",
  "dodge": "基本轻功",
  "fork": "基本叉法",
  "hammer": "基本锤法",
  "mace": "基本锏法",
  "parry": "拆招卸力之法",
  "spear": "基本枪法",
  "staff": "基本杖法",
  "stick": "基本棍法",
  "sword": "基本剑术",
  "throwing": "暗器使用",
  "whip": "基本鞭术",
  "unarmed": "扑击格斗之技",
  "force": "内功心法",
  "spells": "法术",
  "literate": "读书识字",
  "medical" : "基本医术",
  "sew"     : "缝纫技艺",
  "hunting"  : "基本狩猎技巧",
  "cooking"  : "厨艺",
]);
void show_skills ()
{
  int i;
  int size = sizeof (skills);
  string *strs = keys(skills);
  write ("你可以选择如下技能：\n");
  strs = (string *)sort_array (strs, 1);
  for (i = 0; i < size; i++)
    write ("  "+strs[i]+": "+skills[strs[i]]+"\n");
}

int do_decide (string arg)
{
  object me = this_object();
  object who = environment();
  string *strs = keys(skills);
  string str,sk_d;
  int i;
  int size = sizeof (skills);
  if (!who || !me)
    return 1;

  if (who->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query("owner") != who->query("id"))
  {
    tell_object (who,"这本经书不是你的。\n");
    return 1;
  }

  sk_d = who->query("obstacle/book");
  if (sk_d && stringp(sk_d))
  {
    str = skills[sk_d];
    tell_object (who,"你早已决定用无字经学习 "+str+" 了。\n");
    return 1;
  }

  str = 0;
  for (i = 0; i < size; i++)
  {
    if (arg == strs[i])
    {
      str = skills[arg];
      break;
    }

  }

  if (! str)
  {
    show_skills ();
    return 1;
  }

  who->set("obstacle/book",arg);
  me->set_skill(arg);
  tell_object (who,"你决定从此用无字经学习 "+str+" 。\n");
  tell_object (who,"你可以将 "+str+" 学习到两百级。\n");
  who->save();
  who->start_busy(2);
  return 1;
}

int read_effect(object me)
{
  if (this_object()->query("owner") == me->query("id"))
    return -50;
  return 50;
}

