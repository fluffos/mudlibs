inherit ITEM;
void create()
{
  set_name("〖招架初解〗", ({ "parry book", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long",
"封面上写著「招架初解）」\n");
    set("value", 1000);
    set("material", "paper");
    set("skill", ([
        "name":         "parry",
        "exp_required": 100,
        "sen_cost":     20,
        "difficulty":   20,
        "max_skill":    20,
    ]));
  }

}

