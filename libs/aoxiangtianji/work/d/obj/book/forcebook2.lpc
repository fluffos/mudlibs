inherit ITEM;
void create()
{
  set_name("〖伏魔山心经〗", ({"fumo book", "book"}));
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long", "一个油布皮的小册子，前一半却不知什么原因被扯掉。\n");
    set("material", "paper");
    set("skill", ([
           "name": "force",
           "exp_required": 20000,
           "sen_cost": 40,
           "difficulty": 40,
           "max_skill": 80,
           "min_skill" : 50,
    ]) );
  }

}

int read_effect(object me)
{
  if (this_object()->query("owner") == me->query("id"))
    return -30;
  return 30;
}

