inherit ITEM;
void create()
{
  set_name("狂风刀法", ({ "blade book", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long",
"封面上写著「狂风刀法）」\n");
    set("value", 10000);
    set("material", "paper");
    set("skill", ([
        "name":         "kuangfeng-blade",
        "exp_required":  10000,
        "sen_cost"    :  40,
        "difficulty"  :  30,
        "max_skill"   :  100,
        "min_skill"   :  50,
    ]));
  }

}

