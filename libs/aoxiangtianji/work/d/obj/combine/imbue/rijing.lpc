//日晶绸
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIY "日晶绸" NOR, ({ "rijing chou", "chou" }) );
  set_weight(30);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIW "一块剔透晶体，散射出绚目的光彩。\n"NOR);
    set("value", 1);
    set("no_sell", 1);
    set("unit", "块");
    set("can_be_imbued", 1);
    set("power",10+random(8));
  }

  setup();
}

int query_jicun_allow() { return 1; }

