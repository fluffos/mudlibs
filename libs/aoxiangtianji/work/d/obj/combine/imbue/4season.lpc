#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIG "四季"HIR"精灵" NOR, ({ "4-season", "season" }) );
  set_weight( 100 );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "缕");
    set("long", "这是一缕四季雨水化成的精灵。\n");
    set("value", 100);
    set("no_sell", 1);
    set("can_be_imbued", 1);
    set("power",5+random(5));
    set("drop_des", 1);
    set("material", "water");
  };
  setup();
}

int query_jicun_allow() { return 1; }

