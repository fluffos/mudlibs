// 乾坤圣水
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIW "乾坤圣水" NOR, ({ "bless water", "water" }) );
  set_weight(30);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIW "一瓶莹剔透圣水，散射出绚目的光彩。\n"NOR);
    set("value", 1);
    set("no_sell", 1);
    set("unit", "瓶");
    set("can_be_imbued", 1);
    set("power",6+random(6));
  }

  setup();
}

int query_jicun_allow() { return 1; }

