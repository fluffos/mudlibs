#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIY "秋之雨" NOR, ({ "autumn rain", "autumn", "rain" }) );
  set_weight( 100 );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "滴");
    set("long", "这是一滴晶莹的秋之瑟雨的雨滴。\n");
    set("value", 100);
    set("can_auction", 1);
    set("drop_des", 1);
    set("material", "water");
  };
  setup();
}

int query_jicun_allow() { return 1; }

