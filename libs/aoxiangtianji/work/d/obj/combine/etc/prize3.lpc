#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIR "赤龍之瞳" NOR, ({ "dragon eye", "dragon", "eye" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIR "傳説中赤龍的眼珠，似乎可以服用。\n" NOR);
    set("unit", "顆");
    set("value", 500000);
    set("only_do_effect", 1);
  }

  setup();
}

int do_effect(object me)
{
  string mapsk;
  string na, un;
  if (!present(this_object(),me))
    return notify_fail("药必须拿起来才可以服用！\n");

  na = query("name");
  un = query("unit");
  if( (time() - (int)me->query("last_pill_time")) < 600 )
  {
    write("你觉得现在内息未定，经脉隐隐还能感到真"
          "气冲荡，不敢贸然服食。\n");
    return 1;
  }

  me->set("last_pill_time", time());
  message_vision(HIY "$N" HIY "吞下一" + un + na + HIY "，脸色一变，似"
                     "乎精神了许多。\n" NOR, me);
  mapsk = me->query_skill_mapped("force");
  me->improve_skill("force", 20000, 1);
  if (stringp(mapsk))
    me->improve_skill(mapsk, 20000, 1);
  tell_object(me, HIM "你只觉一股暖气散布全身，说不出的舒服受用。\n" NOR);
  if (me->query("force") < 2*me->query("max_force"))
    me->set("force",2*me->query("max_force"));
  me->start_busy(random(3) + 3);
  destruct(this_object());
  return 1;
}

int query_jicun_allow() { return 1; }

