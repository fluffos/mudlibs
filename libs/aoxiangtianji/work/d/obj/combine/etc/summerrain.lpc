//夏之暴雨(summer-rain)
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIC "夏之雨" NOR, ({ "summer rain", "summer", "rain" }) );
  set_weight( 100 );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "滴");
    set("long", "这是一滴晶莹的夏之暴雨的雨滴。\n");
    set("value", 100);
    set("drop_des", 1);
    set("material", "water");
  };
  setup();
}

int query_jicun_allow() { return 1; }

