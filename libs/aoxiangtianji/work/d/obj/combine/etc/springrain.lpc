//春之喜雨(spring-rain)
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIG "春之雨" NOR, ({ "spring rain", "spring", "rain" }) );
  set_weight( 100 );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "滴");
    set("long", "这是一滴晶莹的春之喜雨的雨滴。\n");
    set("value", 100);
    set("drop_des", 1);
    set("material", "water");
  };
  setup();
}

int query_jicun_allow() { return 1; }

