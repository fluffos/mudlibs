//enchase for cloth lv2
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIC"七"HIR"色"HIG"神"HIW"石"NOR, ({ "7color stone", "stone" }) );
  set_weight( 1000 );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "块");
    set("long", "这是一块有着七彩颜色的神石，里面含有一些稀有的物质。\n");
    set("value", 100);
    set("can_be_enchased", 1);
    set("enchased_for_cloth",1);
    set("magic/power",30);
    set("magic/level",2);
    set("magic/type",([
                        "shui" : 50 ,
                        "jin"  : 30,
                        "huo"  : 30,
                        "tu"   : 30,
                     ])
       );
    set("no_sell", 1);
  };
}

int query_jicun_allow() { return 1; }

