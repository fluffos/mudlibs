//enchase for cloth lv2
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIW"古藤筋"NOR, ({ "guteng jin", "jin" }) );
  set_weight( 1000 );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "束");
    set("long", "这是一束从万年古藤中抽出的条状物品，古香古色，似乎有着些魔力效果。\n");
    set("value", 5000);
    set("can_be_enchased", 1);
    set("enchased_for_cloth",1);
    set("magic/power",30);
    set("magic/level",2);
    set("magic/type",([
                        "shui" : 30 ,
                        "huo"  : 30,
                        "mu"   : 30,
                        "tu"   : 50,
                     ])
       );
    set("no_sell", 1);
  };
}

int query_jicun_allow() { return 1; }

