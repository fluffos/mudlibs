//enchase for weapon lv1 huo
inherit ITEM;
#include <ansi.h>
void create()
{
  set_name(HIR "火焰刀" NOR, ({"huoyan dao", "huoyan", "dao"}));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIW "红色的小刀状，似乎是火焰在燃烧，传说只有在天界才会出现。\n" NOR);
    set("unit", "块");
    set("value", 50000);
    set("can_be_enchased", 1);
    set("enchased_for_weapon",1);
    set("magic/type", "huo");
    set("magic/level",1);
    set("magic/power", 15);
  }

  setup();
}

int query_jicun_allow() { return 1; }

