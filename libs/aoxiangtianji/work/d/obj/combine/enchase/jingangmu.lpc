//enchase for weapon lv2 mu
inherit ITEM;
#include <ansi.h>
void create()
{
  set_name(HIB "金刚木" NOR, ({"jingang mu", "jingang", "mu"}));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIB "通体泛着金色光泽的坚木，传说是金刚所化。\n" NOR);
    set("unit", "根");
    set("value", 80000);
    set("can_be_enchased", 1);
    set("enchased_for_weapon",1);
    set("magic/type", "mu");
    set("magic/level",2);
    set("magic/power", 30);
  }

  setup();
}

int query_jicun_allow() { return 1; }

