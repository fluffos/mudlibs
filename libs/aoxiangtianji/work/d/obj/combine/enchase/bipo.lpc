//enchase for cloth lv2
inherit ITEM;
#include <ansi.h>
void create()
{
  set_name(HIW "碧魄冰晶" NOR, ({"bipo bingjing", "bipo", "bingjing"}));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIW "晶莹剔透的寒晶，寒气刺骨，乃天界极品。\n" NOR);
    set("unit", "块");
    set("value", 12000);
    set("can_be_enchased", 1);
    set("enchased_for_cloth",1);
    set("magic/level",2);
    set("magic/type",([
                        "shui" : 30 ,
                        "jin"  : 30,
                        "huo"  : 50,
                        "mu"   : 30,
                     ])
       );
    set("magic/power", 30);
  }

  setup();
}

int query_jicun_allow() { return 1; }

