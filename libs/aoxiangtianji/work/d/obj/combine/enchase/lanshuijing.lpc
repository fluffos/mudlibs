//enchase for weapon lv3 tu
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIM "蓝晶" NOR, ({ "lan crystal", "lan" }) );
  set_weight(300);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", HIB "一块闪烁这奇异光芒的蓝色水晶，让人感到一阵阵的心悸。\n" NOR);
    set("value", 200000);
    set("unit", "块");
    set("can_be_enchased", 1);
    set("enchased_for_weapon",1);
    set("magic/type", "tu");
    set("magic/level",3);
    set("magic/power", 60);
    set("material", "crystal");
  };
}

int query_jicun_allow() { return 1; }

