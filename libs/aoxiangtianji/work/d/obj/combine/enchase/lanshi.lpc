//enchase for weapon lv1 tu
inherit ITEM;
#include <ansi.h>
void create()
{
  set_name(HIY "天岚石" NOR, ({"tianlan shi", "tianlan", "shi" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIY "一块来自天际的岚石，散射出夺目光芒。\n" NOR);
    set("unit", "块");
    set("value", 5000);
    set("can_be_enchased", 1);
    set("enchased_for_weapon",1);
    set("magic/type", "tu");
    set("magic/level",1);
    set("magic/power", 15);
  }

  setup();
}

int query_jicun_allow() { return 1; }

