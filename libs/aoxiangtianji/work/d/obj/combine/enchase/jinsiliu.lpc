//enchase for cloth lv2
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIR"金"HIW"丝"HIG"琉"HIW"璃"NOR, ({ "jinsi liuli", "liuli" }) );
  set_weight( 1000 );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "束");
    set("long", "这是一束金丝，色泽流动若琉璃，似乎有着些魔力效果。\n");
    set("value", 5000);
    set("can_be_enchased", 1);
    set("enchased_for_cloth",1);
    set("magic/power",30);
    set("magic/level",2);
    set("magic/type",([
                        "shui" : 30 ,
                        "jin"  : 30,
                        "mu"   : 50,
                        "tu"   : 30,
                     ])
       );
    set("no_sell", 1);
  };
}

int query_jicun_allow() { return 1; }

