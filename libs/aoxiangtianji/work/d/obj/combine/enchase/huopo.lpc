//enchase for cloth lv2
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIW"火魄"NOR, ({ "huo po", "po" }) );
  set_weight( 1000 );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "块");
    set("long", "一块色泽鲜红的晶体，似乎有着些魔力效果。\n");
    set("value", 5000);
    set("can_be_enchased", 1);
    set("enchased_for_cloth",1);
    set("magic/power",30);
    set("magic/level",2);
    set("magic/type",([
                        "jin" : 30 ,
                        "huo" : 30,
                        "mu"  : 50,
                        "tu"  : 30,
                     ])
       );
    set("no_sell", 1);
  };
}

int query_jicun_allow() { return 1; }

