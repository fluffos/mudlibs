//enchase for cloth lv3
inherit ITEM;
#include <ansi.h>
void create()
{
  set_name(HIW "玄冰烈火石" NOR, ({"xuanbing shi", "xuanbing", "shi"}));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIW "晶莹剔透而色泽红润的晶石，乃天界极品。\n" NOR);
    set("unit", "块");
    set("value", 22000);
    set("can_be_enchased", 1);
    set("enchased_for_cloth",1);
    set("magic/level",3);
    set("magic/type",([
                        "shui" : 60 ,
                        "jin"  : 60,
                        "huo"  : 60,
                        "mu"   : 60,
                        "tu"   : 60,
                     ])
       );
    set("magic/power", 60);
  }

  setup();
}

int query_jicun_allow() { return 1; }

