#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(NOR + HIW "银蛛丝" NOR, ({"yinzhu si", "yinzhu", "si"}));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIW "大雪山银蛛所产的丝，强韧坚固，极为珍贵。\n" NOR);
    set("unit", "卷");
    set("value", 10000);
  }

  setup();
}

int query_jicun_allow() { return 1; }

