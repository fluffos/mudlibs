#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(NOR + YEL "乌金矿" NOR, ({"wujin kuang", "wujin", "kuang"}));
  set_weight(1800);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", YEL "这是一块极为罕见的乌金矿石，坚如玄铁，珍贵无比。\n" NOR);
    set("unit", "块");
    set("value", 8000);
  }

  setup();
}

int query_jicun_allow() { return 1; }

