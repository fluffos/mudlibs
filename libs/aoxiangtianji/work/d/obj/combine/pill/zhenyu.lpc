// zhenyu.c 镇狱惊天丸
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIW "镇狱惊天丸" NOR, ({ "zhenyu wan", "zhenyu", "wan" }) );
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIW "一颗龙眼大小的药丸，氤氲扑鼻，一嗅之下便觉心旷\n"
                    "神怡。整个药丸流动着金属般的光泽，入手沉重，在\n"
                    "掌心滑动不停，便似有生命一般。\n" NOR);
    set("value", 500000);
    set("unit", "颗");
    set("only_do_effect", 1);
  }

}

int do_effect(object me)
{
  string mapsk;
  if (!present(this_object(),me))
    return notify_fail("药必须拿起来才可以服用！\n");
  log_file("static/using", sprintf("%s(%s) eat 镇狱惊天丸 at %s.\n",
          me->name(1), me->query("id"), ctime(time())));
  if (stringp(this_object()->query("owner")) &&
      this_object()->query("owner") != me->query("id"))
  {
    message_vision(HIR "$N" HIR "一仰脖，吞下了一颗镇狱惊天丸，却听$P"
                   HIR "一声尖哮，喷出一口鲜血，仰面便倒。\n" NOR, me);
    me->set_temp("die_reason", "贪吃镇狱惊天丸，结果弄得全身筋脉尽断"
                               "而亡");
    me->receive_damage("kee",10);
    me->die();
    destruct(this_object());
    return 1;
  }

  message_vision(HIW "$N" HIW "一仰脖，吞下了一颗镇狱惊天丸，只见$P"
                 HIW "浑身一颤，七窍都冒出白烟来。\n" NOR, me);
  me->add("combat_exp", 80000 + random(20000));
  me->add("combat_exp", 80000 + random(20000));
  me->add("potential", 30000);
  mapsk = me->query_skill_mapped("force");
  me->improve_skill("force", 20000);
  if (stringp(mapsk))
    me->improve_skill(mapsk, 20000);

  mapsk = me->query_skill_mapped("spells");
  me->improve_skill("spells", 30000);
  if (stringp(mapsk))
    me->improve_skill(mapsk, 30000);
  mapsk = me->query_skill_mapped("dodge");
  me->improve_skill("dodge", 20000);
  if (stringp(mapsk))
    me->improve_skill(mapsk, 20000);
  mapsk = me->query_skill_mapped("parry");
  me->improve_skill("parry", 30000);
  if (stringp(mapsk))
    me->improve_skill(mapsk, 30000);

  me->add_maximum_force(20);
  me->add_maximum_mana(20);
  destruct(this_object());
  return 1;
}

int query_jicun_allow() { return 1; }

