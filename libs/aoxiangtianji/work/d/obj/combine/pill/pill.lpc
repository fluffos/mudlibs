#include <ansi.h>
inherit COMBINED_ITEM;
int query_jicun_allow() { return 1; }

void setup()
{
  set_amount(1);
  ::setup();
}

void create()
{
  set_name(HIY "补药" NOR, ({ "pill" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIY "这是一颗增加内功的补药。\n" NOR);
    set("base_unit", "颗");
    set("base_value", 10000);
    set("base_weight", 50);
    set("only_do_effect", 1);
   // 增加技能的种类
    set("pill_skill", "force");
   // 是否为特殊武功
    set("skill_mapped", 1);
   // 技能的增加效果
    set("pill_point", 2000);
   // 功力的增加效果
    set("force_point", 1);
    set("mana_point", 1);
    set("pill_msg1", HIR "你只觉一股暖气散布全身，说不出"
                         "的舒服受用。\n" NOR);
    set("pill_msg2", HIY "你只觉一股热流涌上，内息得到了"
                         "完全的补充。\n" NOR);
  }

  setup();
}

int do_effect(object me)
{
  string skill;
  int pot1, pot2, pot3,time;

  if (!present(this_object(),me))
    return notify_fail("药必须拿起来才可以服用！\n");
  pot1 = query("pill_point");
  pot2 = query("force_point");
  pot3 = query("mana_point");
  time = query("pill_point") / 10;
 // 非技能型的药物重新计算效用时间
  if (!query("pill_point"))
    time = 400 + (query("force_point")+query("mana_point")) * 10;
  if( (time() - (int)me->query("last_pill_time")) < time )
  {
    write("你觉得现在内息未定，经脉隐隐还能感到真气"
          "冲荡，不敢贸然服食。\n");
    return 1;
  }

  // 增加药物效用时间，该时段里不能再次服用
  me->set("last_pill_time", time());
  message_vision(HIY "$N" HIY "服下一" + query("base_unit") +
                 name() + HIY "，急忙开始运功吸收药力。\n"
                 NOR, me);
 // 如果该药物有增加技能的功能，则加之
  if (query("pill_skill") && query("pill_point"))
  {
    // 判断增加的技能是否为特殊技能
    if (query("skill_mapped") >= 1)
      skill = me->query_skill_mapped(query("pill_skill"));
    else
      skill = query("pill_skill");
    // 可以增加该技能
    if (stringp(query("pill_msg1")))
      tell_object(me, query("pill_msg1"));
    if (pot1 > 0)
      me->improve_skill(skill, pot1);
  }

  // 如果该药物有增加功力的功能，则加之
  if (query("force_point") || query("mana_point"))
  {
    // 内功型药物增加内力，否则则增加精力
    if (query("pill_skill") == "force")
    {
     // 提供出信息
      tell_object(me, query("pill_msg2"));
      if (pot2>0)
        me->add_maximum_force(pot2+random(pot2));
      if (me->query("force") < 2*me->query("max_force"))
        me->set("force",2*me->query("max_force"));
      if (me->query("kee") < me->query("max_kee"))
        me->set("kee",me->query("max_kee"));
      if (me->query("eff_kee") < me->query("max_kee"))
        me->set("eff_kee",me->query("max_kee"));
    }

    else if (query("pill_skill") == "spells")
    {
     // 提供出信息
       tell_object(me, query("pill_msg2"));
       if (pot3>0)
         me->add_maximum_mana(pot3+random(pot3));
      if (me->query("mana") < 2*me->query("max_mana"))
        me->set("mana",2*me->query("max_mana"));
      if (me->query("sen") < me->query("max_sen"))
        me->set("sen",me->query("max_sen"));
      if (me->query("eff_sen") < me->query("max_sen"))
        me->set("eff_sen",me->query("max_sen"));
    }

    else
    {
      tell_object(me, query("pill_msg2"));
      if (pot2>0)
      {
        me->add_maximum_force(pot2+random(pot2));
        if (me->query("force") < 2*me->query("max_force"))
          me->set("force",2*me->query("max_force"));
        if (me->query("kee") < me->query("max_kee"))
          me->set("kee",me->query("max_kee"));
        if (me->query("eff_kee") < me->query("max_kee"))
          me->set("eff_kee",me->query("max_kee"));
       }

       if (pot3>0)
       {
         me->add_maximum_mana(pot3+random(pot3));
        if (me->query("mana") < 2*me->query("max_mana"))
          me->set("mana",2*me->query("max_mana"));
        if (me->query("sen") < me->query("max_sen"))
          me->set("sen",me->query("max_sen"));
        if (me->query("eff_sen") < me->query("max_sen"))
          me->set("eff_sen",me->query("max_sen"));
       }

    }

  }

  me->start_busy(random(3) + 3);
  add_amount(-1);
  if (query_amount() < 1)
    destruct(this_object());
  return 1;
}

