#include <ansi.h>
inherit __DIR__"pill";
void create()
{
  set_name(HIR "心菩提" NOR, ({ "xin puti", "xin", "puti" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIR "此万年菩提树之实，采自灵山佛祖座前，珍稀无比。\n" NOR);
    set("base_unit", "颗");
    set("base_value", 8000);
    set("base_weight", 50);
    set("only_do_effect", 1);
    set("pill_skill", "spells");
    set("mana_point", 5);
    set("pill_msg2", HIM "你感到法力又雄厚了一些。\n" NOR);
  }

  setup();
}

