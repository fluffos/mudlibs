#include <ansi.h>
#include <armor.h>
inherit FLOWER;
#include "flowers.h"
void create ()
{
  set_name(element_of(flowers), ({ "flower"}));
  set_weight(100);
  set_weight(100);
   if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long","色彩艳丽的"+query("name")+"。\n");
    set("unit", "朵");
    set("armor_prop/personality", 2);
    set("unequip_msg","$N将"+query("name")+"轻轻地摘下来……。\n");
    set("wear_msg", "$N戴上"+query("name")+"，不禁想起年少时曾经的梦中人。\n");
  }

  init_flower(1);
  setup();
}

