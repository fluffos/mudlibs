// jinchuang.c 金创药
inherit COMBINED_ITEM;
int is_drug() {return 1;}

void create()
{
  set_name("金创药", ({"jinchuang yao", "yao", "jinchuang"}));
  if (clonep())
   set_default_object(__FILE__);
  else
  {
    set("base_unit","包");
    set("unit","包");
    set("long", "这是一包治伤的金创药。\n");
    set("base_value", 1000);
    set("drug_type", "良药");
  }

  set("only_do_effect", 1);
  set_amount(1);
  setup();
}

int do_effect(object me)
{
  if (!present(this_object() , me))
    return notify_fail("这药必须要拿起来才能服用！\n");

  if (me->query("eff_kee") >= me->query("max_kee"))
  {
    write("你现在不需要用金创药。\n");
    return 1;
  }

  else
  {
    me->receive_curing("kee", me->query("max_kee")/5);
    message_vision("$N吃下一包金创药，气色看起来好多了。\n",me);
    if (query_amount()>1)
      add_amount(-1);
    else
      destruct(this_object());
    return 1;
  }

}

