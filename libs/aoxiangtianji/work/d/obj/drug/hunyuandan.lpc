// hunyuandan.c 混元丹
inherit COMBINED_ITEM;
int is_drug() {return 1;}

void create()
{
  set_name("混元丹", ({"hunyuan dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "颗");
    set("unit", "颗");
    set("long", "一颗略带香气的药丸．\n");
    set("base_value", 1000);
    set("drug_type", "良药");
  }

  set("only_do_effect", 1);
  set_amount(1);
  setup();
}

int do_effect(object me)
{
  if (!present(this_object() , me))
    return notify_fail("这药必须要拿起来才能吃！\n");

  if (me->query("eff_sen") >= me->query("max_sen"))
  {
    write("你现在不需要用混元丹。\n");
    return 1;
  }

  else
  {
    me->receive_curing("sen", me->query("max_sen")/6);
    message_vision("$N吃下一包混元丹，精神看起来好多了。\n",me);
    if (query_amount()>1)
      add_amount(-1);
    else
      destruct(this_object());
  }

  return 1;
}

