#include <ansi.h>
inherit COMBINED_ITEM;
int is_drug() {return 1;}

void create()
{
  set_name("三黄宝腊丹", ({"baola dan", "dan"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", HIY "普陀山的疗伤圣药，具有极佳的解毒功效。\n" NOR);
    set("base_unit", "粒");
    set("unit","粒");
    set("base_value", 30000);
    set("base_weight", 55);
    set("only_do_effect", 1);
  }

  set_amount(1);
  setup();
}

int do_effect(object me)
{
  if (!present(this_object() , me))
    return notify_fail("这东西必须要拿起来才能吃！\n");

  if (time() - me->query_temp("last_eat/jiedu") < 50)
  {
    write("你刚服用过药，需药性发挥完效用以后才能继续服用。\n");
    return 1;
  }

  if (! me->query_skill_mapped("force"))
  {
    write("你没有激发任何内功，怎么发挥药力进行驱毒？\n");
    return 1;
  }

  me->set_temp("last_eat/jiedu", time());
  message_vision(HIY "$N" HIY "服下了一颗" + name() + HIY "，急忙"
                     "盘膝坐下，开始运功逼毒。\n" NOR, me);
// 运功驱毒
  me->add_temp("apply/dispel-poison", 300);
  SKILL_D("force")->exert_function(me, "dispel");
  me->add_temp("apply/dispel_poison", -300);
  add_amount(-1);
  if (query_amount() < 1)
    destruct(this_object());
  return 1;
}

