//yangjing.c
#include <ansi.h>
inherit COMBINED_ITEM;
int is_drug() {return 1;}

void create()
{
  set_name(HIG "养精丹" NOR, ({ "yangjing dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit", "颗");
    set("unit","颗");
    set("long", "一颗略带香气的药丸．\n");
    set("base_value", 1500);
    set("drug_type", "良药");
    set("only_do_effect", 1);
  }

  set_amount(1);
  setup();
}

int do_effect(object me)
{
  if (!present(this_object() , me))
    return notify_fail("这药必须要拿起来才能服用！\n");
  if ((int)me->query("eff_sen") >= (int)me->query("max_sen"))
    return notify_fail("你现在不需要用养精丹。\n");
  me->receive_curing("sen", me->query("max_sen")/5);
  message_vision("$N吃下一包养精丹，精神看起来好多了。\n", me);
  if (query_amount()>1)
    add_amount(-1);
  else
    destruct(this_object());
  return 1;
}

