//dieda.c
#include <ansi.h>
inherit COMBINED_ITEM;
int is_drug() {return 1;}

void create()
{
  set_name(HIY "跌打药丸" NOR, ({ "dieda wan", "dieda", "yao" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit","包");
    set("unit","包");
    set("long", "这是一包武林人士必备的金创药。\n");
    set("base_value", 800);
    set("only_do_effect", 1);
  }

  set_amount(1);
  setup();
}

int do_effect(object me)
{
  if (!present(this_object() , me))
    return notify_fail("这东西必须要拿起来才能吃！\n");

  if ((int)me->query("eff_kee") >= (int)me->query("max_kee"))
    return notify_fail("你现在不需要用跌打药丸。\n");
  me->receive_curing("kee", me->query("max_kee")/6);
  message_vision("$N吃下一包跌打药丸，气色看起来好多了。\n", me);
  if (query_amount()>1)
    add_amount(-1);
  else
    destruct(this_object());
  return 1;
}

