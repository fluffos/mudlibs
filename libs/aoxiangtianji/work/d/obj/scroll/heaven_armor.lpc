inherit __DIR__"scroll";
void create()
{
  set_name("〖东方卷轴·金刚护甲〗", ({"heaven_armor scroll", "scroll"}));
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "本");
    set("long", "一个古色的丝帛卷轴。\n");
    set("material", "silk");
  }

  set("scroll","heaven_armor");
  set("shuxing","shui");
  set("drop_des",1);
  setup();
}

