#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name(HIG "玉玲珑" NOR, ({"yu linglong" }));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "探春最心爱的饰物。\n");
    set("unit", "个");
    set("owner_name","探春");
    set("owner_id","tan chun");
  }

  setup();
}