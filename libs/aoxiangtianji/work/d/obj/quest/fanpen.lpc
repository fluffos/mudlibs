#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name(HIY"金饭盆"NOR, ({"jinfan pen", "pen"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一个金制的盆子。\n");
    set("unit", "个");
    set("owner_name","猪八戒");
    set("owner_id","zhu bajie");
  }

  setup();
}