#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name(HIC"考题"NOR, ({"kaoti", "ti"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "贺知章出的考题。\n");
    set("unit", "份");
    set("owner_name","贺知章");
    set("owner_id","he zhizhang");
  }

  setup();
}