#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name(HIW"花茶"NOR, ({"hua cha", "cha"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一包花茶。\n");
    set("unit", "包");
    set("owner_name","茶花娘子");
    set("owner_id","chahua niangzi");
  }

  setup();
}