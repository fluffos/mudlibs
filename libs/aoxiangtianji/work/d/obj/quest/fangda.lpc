inherit "/d/obj/quest/dynamic";
void create()
{
  set_name("放大镜", ({"fangda jing", "jing"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "千里眼的放大镜。\n");
    set("unit", "件");
    set("owner_name","千里眼");
    set("owner_id","qianli yan");
  }

  setup();
}