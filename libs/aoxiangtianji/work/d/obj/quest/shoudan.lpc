#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name(HIW"收单具条"NOR, ({"shoudan jutiao","tiao"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "这是董记当铺的专用票据。\n");
    set("unit", "张");
    set("owner_name","古贵有");
    set("owner_id","gu guiyou");
  }

  setup();
}