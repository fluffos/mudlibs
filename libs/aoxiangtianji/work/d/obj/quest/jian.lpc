inherit "/d/obj/quest/dynamic";
void create()
{
  set_name("铜锏", ({"tong jian", "jian"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long","这是秦琼的惯用兵器。\n");
    set("unit", "件");
    set("owner_name", "秦琼");
    set("owner_id", "qin qiong");
  }

  setup();
}