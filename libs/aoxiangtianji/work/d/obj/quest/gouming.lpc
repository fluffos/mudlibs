#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name("勾命索", ({"gouming suo", "suo"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "白无常用的勾命索。\n");
    set("unit", "条");
    set("owner_name",HIW"白无常"NOR);
    set("owner_id","bai wuchang");
  }

  setup();
}