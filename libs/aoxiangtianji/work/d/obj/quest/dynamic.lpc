inherit ITEM;
int do_mix();
int is_dynamic_item()
{
  return 1;
}

void init()
{
  object ob = this_object();
  object env = environment(ob);

  if (!env || !playerp(env))
    return;

  set("no_give",1);
  if (ob->query("holder"))
  {
    if (ob->query("holder") != env->query("id"))
    {
      tell_object(env,ob->name()+"转眼就不见了!\n");
      remove_call_out("des");
      call_out("des",1);
      return;
    }

  }

  else
    ob->set("holder",env->query("id"));
  add_action("do_mix",({"mix","hecheng"}));
}

void des()
{
  destruct(this_object());
}

string long()
{
  string l = TASK_D->query_baowu_long(base_name(this_object()));

  if (!l)
    return query("long");

  return l;
}

int do_mix()
{
  return TASK_D->do_mix(this_player(), base_name(this_object()));
}