#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name(HIR "紫金盔" NOR, ({"zijin kui", "kui"}));
  set_weight(30);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "当年薛仁贵征战沙场所戴的宝盔。\n");
    set("unit", "顶");
    set("owner_name","薛仁贵");
    set("owner_id","xue rengui");
  }

  setup();
}