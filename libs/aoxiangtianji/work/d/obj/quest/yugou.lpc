#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name(CYN"鱼钩"NOR, ({"yu gou"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", " 渔夫张梢心爱之物。\n");
    set("unit", "个");
    set("owner_name","张梢");
    set("owner_id","fisher");
  }

  setup();
}