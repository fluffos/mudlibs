inherit "/d/obj/quest/dynamic";
void create()
{
  set_name("穿云缀霞针", ({"chuanyun zhen", "zhen"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "有采天之灵，集地之华，绣云补霞的神奇\n");
    set("unit", "件");
    set("owner_name","西王母");
    set("owner_id","xi wangmu");
  }

  setup();
}