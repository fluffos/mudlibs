#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name("地契", ({"di qi", "qi"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "张弟宝的帐簿.\n");
    set("unit", "件");
    set("owner_name","张弟宝");
    set("owner_id","zhang dibao");
  }

  setup();
}