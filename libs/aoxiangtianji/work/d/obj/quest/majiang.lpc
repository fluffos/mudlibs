#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name(HIW"麻将牌"NOR, ({"majiang pai", "pai"}));
  set_weight(80);
  if( clonep() )
     set_default_object(__FILE__);
  else
  {
    set("long", "一副麻将牌。\n");
    set("unit", "副");
    set("owner_name","胡雪源");
    set("owner_id","hu xueyuan");
  }

  setup();
}