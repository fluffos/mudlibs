#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name("捣药杵", ({"daoyao chu", "chu"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "玉兔捣药用的药杵\n");
    set("unit", "件");
    set("owner_name","玉兔");
    set("owner_id","yu tu");
  }

  setup();
}