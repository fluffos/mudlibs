#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name(HIG"算盘"NOR, ({"suan pan", "pan"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "铁算盘用的算账算盘。\n");
    set("unit", "个");
    set("owner_name",HIW"铁算盘"NOR);
    set("owner_id","tie suanpan");
  }

  setup();
}