#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name("朱笔", ({"zhu bi", "bi"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "这可是宝贝啊。\n");
    set("unit", "只");
    set("owner_name","阎罗王");
    set("owner_id","yanluo wang");
  }

  setup();
}