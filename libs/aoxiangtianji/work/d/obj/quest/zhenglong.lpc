#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name("蒸笼", ({"zheng long", "long"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "晚风用来蒸馒头的蒸笼。\n");
    set("unit", "个");
    set("owner_name","晚风");
    set("owner_id","wan feng");
  }

  setup();
}