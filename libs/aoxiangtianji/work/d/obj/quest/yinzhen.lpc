#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name(HIR "银针" NOR, ({"yin zhen", "zhen"}));
  set_weight(10);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "雾渊道长用的银针。\n");
    set("unit", "顶");
    set("owner_name","雾渊道长");
    set("owner_id","wuyuan daozhang");
  }

  setup();
}