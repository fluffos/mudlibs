#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name(HIW"火尖枪"NOR, ({"huojian qiang", "qiang"}));
  set_weight(80);
  if( clonep() )
     set_default_object(__FILE__);
  else
  {
    set("long", "一杆火焰火尖枪,威力无比。\n");
    set("unit", "杆");
    set("owner_name",HIC"哪 吒"NOR);
    set("owner_id","nezha santaizi");
  }

  setup();
}