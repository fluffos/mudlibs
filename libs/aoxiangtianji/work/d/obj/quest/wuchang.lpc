#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name("无常棒", ({"wuchang bang", "bang"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "黑无常用的无常棒。\n");
    set("unit", "件");
    set("owner_name",HIB"黑无常"NOR);
    set("owner_id","hei wuchang");
  }

  setup();
}