#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name("精制鱼线", ({"yu xian", "yuxian"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
     set("long", "这是江州卖鱼竿的丢失的鱼线。\n");
     set("unit", "根");
     set("owner_name","张梢");
     set("owner_id","fisher");
  }

}