inherit "/d/obj/quest/dynamic";
void create()
{
  set_name("耳朵拔子", ({"er ba", "ba zi"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "顺风耳的耳朵拔子.\n");
    set("unit", "件");
    set("owner_name","顺风耳");
    set("owner_id","shunfeng er");
  }

  setup();
}