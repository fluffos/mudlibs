inherit "/d/obj/quest/dynamic";
void create()
{
  set_name("八卦云光帕", ({"yunguang po", "po"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "有坎离震兑之宝，包罗万象之珍\n");
    set("unit", "件");
    set("owner_name","嫦娥");
    set("owner_id","chang e");
  }

  setup();
}