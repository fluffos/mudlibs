#include <ansi.h>
inherit "/d/obj/quest/dynamic";
void create()
{
  set_name(HIR"胭脂"NOR, ({"yan zhi"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "白晶晶的专用化妆用品。\n");
    set("unit", "盒");
    set("owner_name","韦春芳");
    set("owner_id","wei chunfang");
  }

  setup();
}