inherit "/d/obj/quest/dynamic";
void create()
{
  set_name("招牌", ({"zhao pai", "pai"}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "货行老板 梁喜禄的老字号招牌。\n");
    set("unit", "块");
    set("owner_name","梁喜禄");
    set("owner_id","liang xilu");
  }

  setup();
}