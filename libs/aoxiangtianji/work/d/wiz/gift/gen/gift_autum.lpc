// gift_autum.c 中秋节礼物
#include <ansi.h>
inherit ITEM;
#define JIERI "中秋节"
#define JIERI_E "autum"
#define JIANGLI 50000
string *color = ({
    RED, GRN, YEL, MAG, BLU, CYN, WHT,
    HIR, HIG, HIY, HIB, HIM, HIC, HIW, });
void setup()
{}

void init()
{
  add_action("do_open", "open");
}

void create()
{
  set_name(HIM+JIERI"礼物包"NOR, ({JIERI_E+" gift", "gift"}));
  if (clonep())
   set_default_object(__FILE__);
  else
  {
    set("unit", "个");
    set("long", "这是一个神秘的"+JIERI+"礼物包。打开(open)看看！\n");
    set("value", 0);
  }

  set("no_give",1);
  set("no_put",1);
  set("no_drop",1);
  set("no_get",1);
  set("no_open",1);
  setup();
}

int do_open(string arg)
{
  object me ;
  object ob ;
  string str ;

  if (!id(arg))
    return notify_fail("你要打开什么？\n");

  me = this_player(1);
  ob = this_object();
  if (!present(ob,me))
    return notify_fail("礼物包并不在你身上啊！\n");

  if (!query("no_open"))
  {
    destruct(ob);
    return notify_fail("这个礼物包裹已经被人拆开过了！\n");
  }

  delete("no_open");
  if (me->query("level") < 16 ||
      me->query_skill("force",1) < 50)
  {
    destruct(ob);
    return notify_fail("\n你的战斗等级或者基本内功等级不够，系统收回发放的礼物！\n");
  }

  if (ob->query("owner") != me->query("id"))
  {
    destruct(ob);
    return notify_fail(HIR"\n你自己的还不够吗？\n"NOR);
  }

  str =  HIY"$N兴奋地打开了"+ob->name()+HIY"！\n"NOR;
  str += HIW"突然一个礼花爆了开来，把$N吓了一跳：\n"NOR+BLINK+HIR"\n"+JIERI+"快乐！！\n"NOR;
  str+=element_of(color);
  str+=
@TEXT
 .        *                  . . . .  .   .  + .
            "You Are Here" .   .  +  . . .
.                 |      .  .   .    .    . .
                  |     .    .    . +.    +  .
                 \|/            .       .   . .
        . .       V          .    * . . .  .  +   .
           +     ☆           .   .      +
                            .       . +  .+. .
  .                      .     . + .  . .     .      .
           .      .    .     . .   . . .
      *             .    . .  +    .  .           .
          .     .    .  +   . .  *  .       .
               . + .  .  .  .. +  .
.      .  .  .  *   .  *  . +..  .            *
 .      .   . .   .   .   . .  +   .    .            +
TEXT;
  str += NOR+"\n";
  message_vision(str,me);

  tell_object(me,"翱翔天际II全体巫师和玩家共同恭贺"+me->name(1)+JIERI+"快乐！！\n");

  me->add("combat_exp", JIANGLI);
  me->add("daoxing", JIANGLI);
  me->add("potential",JIANGLI/2);
  me->add("experience",JIANGLI/4);
  destruct(ob);
  return 1;
}

