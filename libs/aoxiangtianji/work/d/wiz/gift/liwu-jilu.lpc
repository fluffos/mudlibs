int do_jieri(string arg)
{
  object ob ;
  object where ;
  object notebook ;
  object giftman ;

  mapping jieri_year ;
  mapping jieri_list ;

  string jieri ;
  string *jie_list ;
  string type;
  string year ;
  int year_num ;
  string log_str;

  notebook = this_object();
  ob = this_player();
  where = environment(ob) ;

  if (!where)
    return 0 ;
  if ((string)where->query("short") != FIXLOC)
    return 0 ;

  giftman = present("gift manager",where);
  if (!giftman)
    return 0 ;

  if ( wiz_level(ob)<wiz_level("(arch)") )
  return notify_fail("要arch及以上巫师执行。\n");
  if (!arg)
    return notify_fail("设定节日的格式：jieri <-cancel> year festival ！\n"
                       "一个例子：jieri 2005 春节 设定为春节！\n"
                       "一个例子：jieri -cancel 2005 春节 取消设定的节日！\n");

  if( sscanf(arg, "-%s %s", type, arg) ==2 )
  {
    if (type != "cancel")
      return notify_fail("只有取消设定的节日是才需要这个参数！\n");

    if( sscanf(arg, "%s %s", year, jieri) ==2 )
    {
      if (!notebook->query("jieri/newgift/festival"))
        return notify_fail("现在并没有设定任何节日，请用check命令查看！\n");

      if (jieri != notebook->query("jieri/newgift/festival"))
        return notify_fail("现在并没有设定你要取消的节日啊，请用check命令查看！\n");

      if (year != notebook->query("jieri/newgift/year"))
        return notify_fail("你要取消的节日是哪一年的？请用check命令查看！\n");

      notebook->delete("jieri/newgift/festival");
      notebook->delete("jieri/newgift/year");
      notebook->delete("jieri/newgift/today_gift");
      notebook->delete("jieri/newgift");
      log_str = "jieri/log/"+year+"/"+gift_type[jieri][JIERI_E]+"/" ;

      jieri_list = notebook->query(log_str);
      if (!mapp(jieri_list) || sizeof(jieri_list) < 1)
      {
        write(HIR"似乎数据出现了些问题，请仔细查看！\n"NOR);
        jieri_list = ([ ]);
      }

      jieri_list += (["cancelby"   : ob->query("id"),
                      "canceltime" : ctime(time()),
                    ]);
      notebook->set(log_str,jieri_list);
      notebook->save();
      message_vision(HIY"$N取消了"+HIW+year+HIY"年的"+HIW+jieri
                    +HIY"节日礼物\n"NOR,ob);
      message_vision(HIW"$N认真的拿笔在纪录薄上做了记载！\n",ob);
      CHANNEL_D->do_channel(ob, "chat","现在取消"+BLINK + HIR + jieri + " 礼物！\n"NOR);
      return 1;
    }

    else
      return notify_fail("取消节日的方式是：jieri -cancel year festival  ！\n"
                         "例子： jieri -cancel 2003 中秋节\n");
  }

  else if( sscanf(arg, "%s %s", year, jieri) ==2 )
  {
    write(HIW"现在的时间是："+ctime(time())+" ！\n"NOR);
    jie_list = keys(gift_type);
    if(member_array(jieri,jie_list)==-1)
      return notify_fail(HIR"\n没有这个节日可以设定，可以用check查看可以设定的节日！\n"NOR);

    sscanf(year,"%d",year_num);
    if (year_num <2003)
      return notify_fail(HIR"\n你想要设定去年的节日吗？\n"NOR);
    if (year_num > 2010)
      return notify_fail(HIR"\n你真是深谋远虑啊，那时什么年代了？\n"NOR);
    if (notebook->query("jieri/newgift"))
      return notify_fail(HIR"\n现在已经有节日设定了！可以check现在设定的节日！\n"NOR);

    notebook->set("jieri/newgift/festival",jieri);
    notebook->set("jieri/newgift/year",year);
    notebook->set("jieri/newgift/today_gift",gift_type[jieri][JIERI_LIWU]);

    jieri_list = (["startby"   : ob->query("id"),
                   "starttime" : ctime(time()),
                   "gift"      : gift_type[jieri][JIERI_LIWU],
                   "total"     : 0,
                 ]);
    jieri_year = notebook->query("jieri/log/"+year);
    if (!mapp(jieri_year))
      jieri_year = ([ ]);

    jieri_year += ([
                     gift_type[jieri][JIERI_E] : jieri_list ,
                   ]);

    notebook->set("jieri/log/"+year,jieri_year);
    notebook->save();
    message_vision(BLINK+HIY"$N设定从现在开始可以领取"+HIR+jieri+HIY"礼物！\n"NOR,ob);
    CHANNEL_D->do_channel(ob, "chat","现在开始，请到系统公告室领取"
                          +BLINK + HIR + jieri + " 礼物！\n"NOR);
    ob->start_busy(1);
    return 1;
  }

  else
    return notify_fail("\n请用jieri查看使用方式！\n");
  return 0;
}

int do_check(string arg)
{
  object notebook ;
  object ob ;
  object where;
  object giftman;
  object obj_bug;

  mapping log_year ;
  string *key_jieri ;
  mapping log_bug_id ;
  mapping log_bug_player;
  mapping log_bug;
  string *kid;
  string *jie_list ;

  string type;
  string jieri ;
  string year ;
  string gift ;
  string jie_str ;
  string log_msg ;
  string bug_str_1 ;
  string bug_str_2 ;

  int i,j ;
  int conv_num;

  notebook = this_object();
  ob = this_player();
  where = environment(ob) ;

  if (!where)
  {
    write("这里是地狱吗？\n");
    return 1;
  }

  if ((string)where->query("short") != FIXLOC)
  {
    write("这是什么地方？\n");
    return 1;
  }

  giftman = present("gift manager",where);
  if (!giftman)
  {
    write("礼物管理员到哪儿去了？\n");
    return 1;
  }

  jieri = notebook->query("jieri/newgift/festival");
  year  = notebook->query("jieri/newgift/year");
  gift = notebook->query("jieri/newgift/today_gift");
  if (!wizardp(ob))
  {
    if (!jieri
        || !year
        || !gift)
    {
      tell_object(ob,"现在没有节日礼物可以领取！\n");
      return 1;
    }

    else
    {
      write(HIY"现在正在发放 "+HIW
             +year+"年"+BLINK+HIR+" "+jieri+HIY" 礼物！");
      if ( ob->query("gift/"+year+"/"+gift_type[jieri][JIERI_E]))
        tell_object(ob,"\n你已经领取过正在发送的礼物了！等下一次吧！\n");
      return 1 ;
    }

  }

  else
  {
    if (!arg)
    {
      jie_list = keys(gift_type);
      write(HIW"\n\t目前可以设定的节日列表 ： \n"NOR);
      write(HIY"\t========================\n"NOR);
      for (i=0;i<sizeof(jie_list);i++)
        write(HIW"\t"+jie_list[i]+"\n"NOR);
      write(HIY"\t=======FINISH===========\n"NOR);
      if (!jieri
          || !year
          || !gift)
      {
        write(BLINK+HIR"\n\t目前没有节日设定！\n"NOR);
        return 1;
      }

      write(HIY"现在的节日设定如下："+HIW+year+"年 "+BLINK+HIR+jieri+"！\n"NOR);
      return 1;
    }

    else
    {
      if (sscanf(arg, "-%s %s", type,year) != 2)
        return notify_fail("\ncheck的用法：check -bug id 查看id用户的bug积分情况！\n"
                           "查看year年节日情况：  check -jieri year \n");
      if (type == "jieri")
      {
        log_year = notebook->query("jieri/log/"+year);
        if (!mapp(log_year))
        {
          write("没有"+year+ "的纪录！\n");
          return 1;
        }

        key_jieri = keys(log_year);
        if (sizeof(key_jieri) == 0)
        {
          write(HIW+year+"年的纪录是空的！");
          return 1;
        }

        write(HIW"\n\t"+year+"年的节日纪录情况如下：\n"NOR);
        write(HIY"\t=========================\n"NOR);
        log_msg = "";
        for (i=0;i<sizeof(key_jieri);i++)
        {
          jie_str = key_jieri[i];
          log_msg += HIY"节日名："+HIW+jie_str+"\n"NOR;
          log_msg += HIY"开始时间："+HIW+log_year[jie_str]["starttime"]+"\n"NOR;
          log_msg += HIY"开始人："+HIW+log_year[jie_str]["startby"]+"\n"NOR;
          log_msg += HIY"礼物："+HIW+log_year[jie_str]["gift"]+"\n"NOR;
          log_msg += HIY"取消人："+HIW+log_year[jie_str]["cancelby"]+"\n"NOR;
          log_msg += HIY"取消时间："+HIW+log_year[jie_str]["canceltime"]+"\n"NOR;
          log_msg += HIY"领取人数："+HIW+log_year[jie_str]["total"]+"\n"NOR;
          log_msg += "\n";
          write(log_msg);
        }

        write(HIY"\n\t==========FINISH=========\n"NOR);
        return 1;
      }

      else if (type == "bug")
      {
        if (year != "all")
        {
          obj_bug = find_player(year);
          if (!obj_bug)
            obj_bug = find_living(year);
          if (!obj_bug)
            obj_bug = LOGIN_D->find_body(year);
          if (!obj_bug)
          {
            write("\n你只能检查在线玩家的害虫积分情况！\n");
            return 1;
          }

          conv_num = notebook->query("bug/"+obj_bug->query("id")+"/conv_num");
          if ( !conv_num )
          {
            write("\n"+obj_bug->name()+"还没有害虫积分转换纪录呢！\n");
            return 1;
          }

          write("\n"+HIW+obj_bug->name()+"共有"+chinese_number(conv_num)
                +"次转换害虫积分纪录！\n");
          bug_str_1 = "bug/"+ obj_bug->query("id")+ "/";
          for (i=1;i<=conv_num;i++)
          {
            bug_str_2 = bug_str_1 + sprintf("%d/",i);
            log_bug = notebook->query(bug_str_2);
            write(sprintf("第%d次转换情况：\n=============\n",i));
            write(HIW"转换时间："+HIY+log_bug["time"]+"\n"NOR);
            write(HIW"转换积分："+HIY+log_bug["bug_value"]+"\n"NOR);
            write(HIW"得到礼物："+HIY+log_bug["bug_gift"]+"\n"NOR);
            write("\n\n");
          }

          write("\n====FINISH=====\n");
          return 1;
        }

        else
        {
          log_bug_id = notebook->query("bug");
          if (!mapp(log_bug_id))
          {
            write("现在没有任何害虫转换纪录！\n");
            return 1;
          }

          kid = keys(log_bug_id);
          write(sprintf(HIW"现在共有%d个玩家转换害虫积分纪录！\n",sizeof(kid)));
          for (i=0;i<sizeof(kid);i++)
          {
            year = kid[i];
            log_bug_player = log_bug_id[year] ;
            if (!mapp(log_bug_player))
            {
              write("玩家"+year+"的纪录似乎有问题！\n");
              continue;
            }

            write("玩家"+year+"的纪录如下：\n");
            write("------------------------\n");
            write(sprintf("共有转换次数：%d",(int)log_bug_player["conv_num"]));
            for (j=0;j<log_bug_player["conv_num"];j++)
            {
              log_bug = log_bug_player[sprintf("%d",j+1)];
              write(sprintf("第%d次转换情况：\n",j+1));
              write(HIW"转换时间："+HIY+log_bug["time"]+"\n"NOR);
              write(HIW"转换积分："+HIY+log_bug["bug_value"]+"\n"NOR);
              write(HIW"得到礼物："+HIY+log_bug["bug_gift"]+"\n"NOR);
              write("\n");
            }

          }

          write("\n====FINISH======\n");
          return 1;
        }

      }

      else
      {
        write("\ncheck带参数的用法：check -bug <id/all> 查看某个/或者全部用户的bug积分情况！\n"
                           "查看year年节日情况：  check -jieri year \n");
        return 1;
      }

    }

  }

  return 1;
}

