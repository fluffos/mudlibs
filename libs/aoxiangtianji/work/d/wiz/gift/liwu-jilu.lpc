//created by yekai for axtj
#include <command.h>
inherit ITEM;
inherit F_SAVE;
#include "/d/wiz/gift/gift.h"
int check_bug_level(object ob);
void init()
{
  add_action("do_check", "check");
//  add_action("do_convert", "convert");
  add_action("do_jieri", "jieri");
//  add_action("do_tigao", "tigao");
}

string query_save_file()
{
  return DATA_DIR + "log_gift";
}

void create()
{
  seteuid( getuid() );
  set_name( HIC "礼物纪录薄" NOR, ({"note book", "jilu bo", "book"}) );
  set("no_get", 1);
  set("no_put", 1);
  set("no_drop",1);
  set("no_give",1);
  set("no_sac", 1);
  set("no_clean_up", 1 );
  set("unit", "本");
  restore();
}

string short()
{
  return HIY"翱翔天际礼物纪录薄"NOR;
}

string long()
{
  string long;
  object notebook;

  notebook = this_object();

  long = HIR"一本厚厚的纪录本，上面密密麻麻的写满了字。\n"NOR;

  if (notebook->query("jieri/newgift"))
  {
    long += HIY"\n\t\t封面一行字特别引人注目：\n"NOR;
    long += BLINK + HIR + notebook->query("jieri/newgift/festival") + NOR;
    long += HIY" 快乐！！\n"NOR;
  }

  return long;
}

