int day = 0;
int query_month()
{
  string e_time, month, week, year;
  int hour, minute, second;

  e_time = ctime(time());
  sscanf(e_time,"%s %s %d %d:%d:%d %s", week, month, day, hour, minute, second, year);
  if (month == "Jan")
    return 0;
  if (month == "Feb")
    return 1;
  if (month == "Mar")
    return 2;
  if (month == "Apr")
    return 3;
  if (month == "May")
    return 4;
  if (month == "Jun")
    return 5;
  if (month == "Jul")
    return 6;
  if (month == "Aug")
    return 7;
  if (month == "Sep")
    return 8;
  if (month == "Oct")
    return 9;
  if (month == "Nov")
    return 10;
  if (month == "Dec")
    return 11;
  return 99;
}

string long()
{
  int month;
  string out;

  month = query_month();
  if (month < 0 || month > sizeof(rili))
    return query("long");
  out = rili[month];
  out = replace_string(out,sprintf("|$HIW$%d  ",day),sprintf("|$HIR$%d  ",day));
  return color_filter(out);
}

int do_show(string arg)
{
  int month;
  object me = this_player();

  if (!arg)
    return 0;
  month = to_int(arg);
  if (month < 1 || month > 12)
    return 0;
  me->start_more(color_filter(rili[month-1]));
  return 1;
}

