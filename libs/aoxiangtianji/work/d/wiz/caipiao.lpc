inherit BIGROOM;
inherit LANDROOM;
inherit SAFTYROOM;
#include <ansi.h>
string look_pai();
void create ()
{
  set ("short","彩票中心");
  set ("long", @LONG
这里是翱翔天际购买彩票的地方。入口一个告示牌(pai)，十分醒目．
LONG);
  set("exits", ([
    "down": "/d/wiz/entrance",
  ]));
  set("objects", ([ /* sizeof() == 2 */
    "/d/wiz/npc/caipiao" : 1,
  ]));
  set("no_time", 1);
  set("no_bian",1);
  set("no_quit",1);

  set("item_desc",([
     "pai"  : (: look_pai :)
  ]));

  setup();
}

string look_pai()
{
  string msg;

  msg = "翱翔天际彩票信息：\n";
  msg += sprintf("当前期数：%d\n","/adm/daemons/caipiaod"->query_count()+1);
  msg += sprintf("当前奖池金额：%d两黄金．\n","/adm/daemons/caipiaod"->query_total_reward());
  msg += "投注命令：touzhu 或者 goumai\n";
  msg += "查询命令：info 或者 chaxun\n";
  return msg;
}

