//奖励
#include <ansi.h>
inherit COMBINED_ITEM;
void create()
{
  set_name(HIY "奖励丹" NOR, ({ "medital dan", "jiangli dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("base_unit","颗");
    set("unit","颗");
    set("long", "这是一颗由天神叶开奖励给予的金丹。\n");
    set("base_value", 8000);
    set("only_do_effect", 1);
    set("no_give",1);
    set("no_put",1);
    set("no_get",1);
    set("no_drop",1);
  }

  set_amount(1);
  setup();
}

int do_effect(object me)
{
  int exp,dx,qn;

  if (!present(this_object() , me))
    return notify_fail("这东西必须要拿起来才能吃！\n");

  if (query("owner") != me->query("id"))
    return notify_fail("这不是叶开奖励给你的！\n");
  message_vision("$N眉开眼笑的把金丹吃下，顿时红光满面，好象奥运获得了金牌一般。\n", me);
  exp = 50000;
  dx = exp;
  qn = 30000;
  GIFT_D->bonus(me, ([ "exp"     : exp ,
                       "daoxing" : dx,
                       "pot"     : qn ,
                       "mar"     : qn/3,
                       "prompt"  : "吃下奖励金丹之后" ]),"jiangli");
  if (query_amount()>1)
    add_amount(-1);
  else
    destruct(this_object());
  return 1;
}

