#include <ansi.h>
inherit NPC;
string *sroom_list = ({
     "/d/city/wcenter",
     "/d/city/scenter",
     "/d/city/ecenter",
     "/d/city/ncenter",
  });
void random_chat();
void create()
{
  set_name("百晓生", ({ "baixiao sheng", "baixiao", "sheng" }) );
  set("title", HIY "无所不知" NOR);
  set("gender", "男性");
  set("age", 30+random(20));
  set("long", @LONG
一个年轻的书生，显出一副莫测深高的模样。
LONG );
  set("combat_exp", 5000000);
  set("attitude", "peaceful");
  set("max_force", 3000);
  set("force", 6000);
  set("max_mana", 3000);
  set("mana", 6000);
  set("max_sen", 3000);
  set("sen", 3000);
  set("max_kee", 3000);
  set("kee", 3000);
  set("force_factor", 100);
  set("mana_factor", 150);
  set("str", 30+random(10));
  set("int", 20+random(10));
  set("con", 25+random(10));
  set("dex", 25+random(10));
  set("spi", 25+random(10));
  set_skill("unarmed", 250);
  set_skill("sword", 250);
  set_skill("parry", 250);
  set_skill("dodge", 250);
  set_skill("force", 250);
  set_skill("sancai-sword", 280);
  set_skill("lengquan-force", 280);
  set_skill("changquan", 280);
  set_skill("feiyan-zoubi", 280);
  map_skill("dodge", "feiyan-zoubi");
  map_skill("force", "lengquan-force");
  map_skill("sword", "sancai-sword");
  map_skill("unarmed", "changquan");
  map_skill("parry", "sancai-sword");
  set("chat_chance", 2);
  set("chat_msg", ({
       (: random_move :),
  }));
  set("no_return",1);

  setup();

  if (clonep())
    keep_heart_beat();
  set_max_encumbrance(100000000);
  set_temp("apply/attack", 40);
  set_temp("apply/defense", 40);
  set_temp("apply/damage", 50);
  set_temp("apply/armor", 100);
  carry_object("/d/obj/weapon/sword/youlong-sword")->wield();
  carry_object("/obj/cloth/cloth")->wear();
}

int accept_fight(object ob)
{
  message_vision(CYN "$N摇摇头，对$n" CYN "道：“打架？没兴趣”。\n" NOR, this_object(), ob);
  return 0;
}

int accept_kill(object ob)
{
  return 1;
}

int accept_hit(object ob)
{
  return 1;
}

void receive_damage(string type, int n)
{
  return;
}

void receive_wound(string type, int n)
{
  return;
}

int accept_object(object who, object ob)
{
  if (! ob->query("money_id"))
  {
    command("say 这玩艺我可没啥兴趣！");
    return 0;
  }

  if (ob->value() < 2000)
  {
    command("say 算是给观里的香火么？那我就收下了！");
    return 1;
  }

  command("say 唉！看你也算有点心意，我就帮你一回吧！");
  who->set_temp("baixiao_ask_paid", 1);
  destruct(ob);
  return 1;
}

string accept_ask(object me, string topic)
{
  string str, npc_id, npc_name, answer;
  mapping quest;
  object quest_npc, where;
  object who = this_object();

  if (!playerp(me))
    return "";
  if (playerp(who) || !living(who) || who->is_fighting())
  {
    tell_object(me,"现在" + who->name() + "不能回答任何问题！\n");
    return "";
  }

  if (!me->query_temp("baixiao_ask_paid"))
  {
    tell_object(me,"嘿嘿，没钱喝酒，我什么都不想说啊！\n");
    tell_object(me,"你先付钱，我告诉你不了你，你也不要埋怨我！\n");
    return "哈哈，知道不知道，拿钱再说！\n";
  }

  me->delete_temp("baixiao_ask_paid");

  if (topic != "yuan" &&
      topic != "xue" &&
      topic != "menpai" &&
      topic != "lijing" &&
      topic != "itask" &&
      topic != "rulai" &&
      topic != "pantu")
    return "唉！想我学究天下，也实在是无法回答你的问题！\n";
  str = "quest_xyj/" + topic;
  quest = me->query(str);
  if (!mapp(quest) || sizeof(quest) < 1)
  {
    who->command("sigh");
    return "你问这个干什么？你又没有这方面的事情！\n";
  }

  if ((time() - (int)me->query_temp("last_ask_baixiao")) < 10)
    return "你不是刚刚问过了吗？\n";
  me->set_temp("last_ask_baixiao",time());
  npc_id = quest["npc_id"];
  npc_name = quest["npc_name"];

  if (!stringp(npc_id) || !stringp(npc_name))
    return "奇怪了，没有这方面的线索啊！\n";
  tell_object(me,"百晓生神秘一笑，在你耳朵边上说到：你是想打听 " + npc_name + " 的事情吗？\n");

  if (topic != "pantu" && quest["npc_die"] >= 1 )
    return "嘿嘿，那家伙已经被干掉了！\n";

  quest_npc = find_living(npc_id);
  if (!objectp(quest_npc))
  {
    tell_object(me,who->name() + "掐指算了算，不由得吃了一惊！\n");
    return "啊！那家伙好象躲起来了，根本找不到了！兄弟你还是直接去领罪吧！\n";
  }

  where = environment(quest_npc);
  if (!objectp(where))
  {
    return "嘿嘿，那家伙看来是倒霉了，不知怎的就被投入大牢了，这世上估计是没有人可以找到他了！\n";
  }

  answer = domain_file(base_name(where));
  if(!answer || sizeof(answer)<2)
    return "嗯？似乎有点线索，怎么突然就不见了呢？\n";
  tell_object(me,"百晓生告诉你："+(string)quest_npc->name()+
                 "在"+to_chinese(answer)+"。\n");
  return "嘿嘿，知道我的手段了吧！\n";
}

