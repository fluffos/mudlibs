#include <ansi.h>
inherit "/d/wiz/npc/baqiang";
void create()
{
  set_name("无情", ({ "wu qing", "wu", "qing" }));
  set("title", HIY "铁卫" NOR);
  set("gender", "男性");
  set("age", 35);
  set("long","这是个看起来三十来岁的汉子，身材瘦削，深沉冷酷。\n");
  set("str", 35);
  set("int", 34);
  set("con", 36);
  set("dex", 35);
  set("spi", 35);

  set("kee", 20000);
  set("max_kee", 20000);
  set("sen", 20000);
  set("max_sen", 20000);
  set("force", 36000);
  set("max_force", 18000);
  set("force_factor", 900);
  set("mana", 36000);
  set("max_mana", 18000);
  set("mana_factor", 900);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set("score", 20000000);
  set("weiwang", 20000000);
  set("no_ji",1);

  set_skill("force", 500);
  set_skill("spells", 500);
  set_skill("dodge", 500);
  set_skill("unarmed", 500);
  set_skill("parry", 500);
  set_skill("whip", 500);

  set_skill("lengquan-force", 500);
  set_skill("buddhism", 500);
  set_skill("xiaoyaoyou", 500);
  set_skill("dragonfight", 500);
  set_skill("sanqing-fuchen", 500);

  map_skill("force", "lengquan-force");
  map_skill("spells", "buddhism");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("unarmed", "dragonfight");
  map_skill("parry", "sanqing-fuchen");
  map_skill("blade", "sanqing-fuchen");
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
     (: cast_spell, "bighammer" :),
     (: cast_spell, "jinguzhou" :),
     (: perform_action, "whip.jianqi" :),
     (: perform_action, "whip.ruyu" :),
  }) );
  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/armor/armor/jinsijia")->wear();
  carry_object("/d/obj/armor/shoes/yunxie")->wear();
