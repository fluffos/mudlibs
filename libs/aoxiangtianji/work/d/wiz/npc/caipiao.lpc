//created by yekai for caipiao
inherit NPC;
#include <ansi.h>
int do_chaxun(string arg);
int do_touzhu(string arg);
void create()
{
  set_name("彩票管理员", ({"caipiao manager","manger"}));

  set ("long", @LONG
他是翱翔天际的彩票管理员。
LONG);
  set("gender", "男性");
  set("title",HIY"虚拟管理员"NOR);
  set("age", 330);
  set("per", 40);
  set("attitude", "peaceful");
  setup();
  carry_object("/obj/cloth/jinduan")->wear();
  carry_object("/obj/cloth/xianlv")->wear();
}

void init()
{
  object me;
  if (! objectp(me = this_player())
   || ! userp(me))
    return;
  add_action("do_chaxun",({"chaxun","info"}));
  add_action("do_touzhu",({"touzhu","goumai"}));
  remove_call_out("greeting");
  call_out("greeting", 1, me);
}

void greeting(object me)
{
  if (objectp(me) && environment(me) == environment())
    message_vision("$N笑着对$n说：你好，欢迎来到彩票中心！\n", this_object(), me);
}

int do_chaxun(string arg)
{
  object who = this_player();
  string msg;

  if (who->is_busy())
    return notify_fail("你正忙呢！\n");

  if (arg == "me")
  {
    msg = "/adm/daemons/caipiaod"->query_my_info(who->query("id"));
  }

  else
    msg = "/adm/daemons/caipiaod"->query_history(arg);
  who->start_more(msg);
  who->start_busy(1);
  return 1;
}

int do_touzhu(string arg)
{
  object who = this_player();
  if (who->is_busy())
    return notify_fail("你正忙呢！\n");

  "/adm/daemons/caipiaod"->accept_buy(who,arg);
  who->start_busy(1);
  return 1;
}

