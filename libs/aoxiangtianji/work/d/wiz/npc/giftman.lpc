#include <ansi.h>
inherit NPC;
void create()
{
  set_name("总管", ({"MUD manager","manager"}));
  set("gender", "男性");
  set("title",HIY"泥巴管理员"NOR);
  set("age", 33);
  set("per", 40);
  set("attitude", "peaceful");
  set("combat_exp",30000000);
  set("daoxing",30000000);
  set("force",30000);
  set("max_force",30000);
  set("mana",30000);
  set("max_mana",30000);
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}

void init()
{
  object me;
  if (! objectp(me = this_player())
   || ! userp(me))
    return;
  add_action("do_promote", ({"tisheng","tishen","promote"}));
  return;
}

int do_promote(string arg)
{
  mapping shuxing = ([
    "str" : "力量",
    "dex" : "敏捷",
    "cor" : "勇气",
    "int" : "悟性",
    "spi" : "灵性",
    "cps" : "定力",
    "per" : "魅力",
    "con" : "根骨",
    "kar" : "福缘",
  ]);

  int i, pot, num;
  object who;
  string msg,sx;
  string *ks;

  who = this_player(1);

  if (who->is_busy())
  {
    write("你正忙着呢！\n");
    return 1;
  }

  num = (int)who->query("gift/level/num");
  if (num < 1)
  {
    write("你没有天赋点数可以提升！还要努力加油！\n");
    who->start_busy(2);
    return 1;
  }

  ks = keys(shuxing);
  msg = "promote <属性> 点数 \n";
  msg += "或者 tisheng <属性> 点数 \n";
  msg += "或者 tishen <属性> 点数 \n\n";
  msg += "可以选择的属性如下：\n";
  for (i=0;i<sizeof(ks);i++)
    msg += sprintf("%s : %s\n",ks[i],shuxing[ks[i]]);
  if (!arg)
  {
    write(msg);
    write(sprintf("\n你目前共有%d点天赋点数可以提升！\n",num));
    return 1;
  }

  if (sscanf(arg, "%s %d", sx, pot) != 2)
  {
    write(msg);
    return 1;
  }

  if(member_array(sx,ks)==-1)
  {
    write("没有这种天赋！\n");
    write(msg);
    who->start_busy(2);
    return 1;
  }

  if (pot < 1)
  {
    write("你正确的指定要提升的点数，系统将对此进行纪录！\n");
    who->start_busy(5);
    return 1;
  }

  if (pot > num)
  {
    write("你没有那么多天赋点数可以提升！\n");
    who->start_busy(2);
    return 1;
  }

  num = num - pot;
  if (num < 1)
    who->delete("gift/level/num");
  else
    who->set("gift/level/num",num);
  who->add(sx,pot);
  who->save();
  who->start_busy(2);
  return 1;
}

