inherit BIGROOM;
inherit HILLROOM;
void create()
{
  set("short", "台怀镇");
  set("long", @LONG
五台山有五个高峰，峰顶平坦，形状象高台。
由于这个镇看似在五台怀抱中，故称为台怀
镇，此处为五台山中心。该镇东面有个寺庙
群，鼎盛时期寺庙达三百余座，因此成为中
国的佛教中心之一。
LONG );
  set("exits", ([
    "east"  : __DIR__"e-shanlu1",
    "northeast" : __DIR__"c-shanlu1",
    "south" : __DIR__"s-shanlu1",
    "northwest"  : __DIR__"w-shanlu1",
  ]));
  set("objects", ([
    "/obj/npc/xunbu" : 1,
    "/obj/npc/xiangke" : 1,
    sprintf("/obj/npc/girl%d", 2+random(3)) : 1,
  ]));
  set("outdoors", "wutaishan");
  setup();
}

