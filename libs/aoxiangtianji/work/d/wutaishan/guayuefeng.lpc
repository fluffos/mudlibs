inherit BIGROOM;
inherit HILLROOM;
void create()
{
   set("short", "西台挂月峰" );
   set("long", @LONG
五台山西台名为挂月峰，位于台怀镇西13公里，海拔2773米，
台顶平如掌，面积300余亩。每当明月高照，山泉潺潺，颇有
诗情画意的境界，月坠峰巅之际，恰如悬镜。在西台顶上赏月，
别具一格。台顶有座石砌的法雷寺，供狮子吼文殊。寺北有个
天然水池，池北有泉。红日当头的奇景。对佛教徒而言，这里
是朝拜狮子吼文殊的圣地。
LONG);
  set("exits", ([
    "eastdown"  : __DIR__"w-shanlu2",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "wutai");
  setup();
}

