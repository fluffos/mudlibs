inherit MIDDLEROOM;
inherit HILLROOM;
inherit TEMPLEROOM;
void create()
{
  set("short", "显通寺");
  set("long", @LONG
显通寺建在台怀镇的灵鹫峰下，它是五台山历史最
悠久的佛寺，始建于东汉永平年间。门前钟楼上有
一口重达万斤的铜钟，敲击时声音传遍全山。显通
寺是五台山五大禅处之一。
LONG);
  set("outdoors", "wutaishan");
  set("exits", ([
     "north" : __DIR__"lingjiufeng",
     "south" : __DIR__"tayuansi",
     "east"  : __DIR__"luohou",
     "west"  : __DIR__"e-shanlu1",
     "enter" : __DIR__"xts-guanyin",
  ]));
  set("no_clean_up", 0);
  setup();
}

