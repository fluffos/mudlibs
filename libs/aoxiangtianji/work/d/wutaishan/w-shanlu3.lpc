inherit SMALLROOM;
inherit HILLROOM;
void create()
{
   set("short", "山路" );
   set("long", @LONG
一条狭窄的山路，弯弯曲曲的通往莽莽苍苍的
深山之中。
LONG);
  set("exits", ([
    "southdown" : __DIR__"w-shanlu1",
    "northeast" : __DIR__"w-shanlu4",
    "northup" : __DIR__"w-shanlu5",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "wutai");
  setup();
}

