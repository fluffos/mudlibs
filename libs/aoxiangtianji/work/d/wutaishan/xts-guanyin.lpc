inherit MIDDLEROOM;
inherit LANDROOM;
inherit TEMPLEROOM;
void create()
{
  set("short", "观音殿");
  set("long", @LONG

显通寺七重大殿的第一殿。这座佛殿中供奉的是观音菩萨。
观音菩萨大慈大悲，普渡众生。传说观音菩萨化身万千。
大殿供有观音菩萨的塑像。两边墙壁上彩绘有观音菩萨的
故事传说。
LONG
);
  set("exits", ([
    "west" : __DIR__"xts-chanfang1",
    "east" : __DIR__"xts-ketang1",
    "north" : __DIR__"xts-wenshu",
    "out"   : __DIR__"xiantongsi",
  ]));
  set("no_clean_up", 0);
  set("objects", ([
     sprintf("/obj/npc/seng%d", 1+random(3)) : 1,
     "/obj/npc/oldwomen" : 1,
     "/d/kaifeng/obj/guanyin" : 1,
  ]));
  setup();
}

