inherit BIGROOM;
inherit HILLROOM;
void create()
{
   set("short", "山路" );
   set("long", @LONG
一条宽阔的山路，路的两面。绿树成荫。无数的
善男信女来到这里，前往东边的无数寺庙烧香拜
佛。一些小贩也乘机在这里卖点吃喝的东西。
LONG);
  set("exits", ([
    "east" : __DIR__"xiantongsi",
    "west" : __DIR__"taihuai",
    "south" : __DIR__"e-shanlu2",
    "north" : __DIR__"e-shanlu3",
  ]));
  set("objects", ([
    "/obj/npc/xiangke" : 1,
    "/obj/npc/oldwomen" : 1,
    sprintf("/obj/npc/boy%d", 2+random(2)) : 1,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "wutai");
  setup();
}

