inherit MIDDLEROOM;
inherit HILLROOM;
inherit TEMPLEROOM;
void create()
{
  set("short", "塔院寺");
  set("long", @LONG
五台山五大禅处一，原是显通寺的塔院。寺前有木
牌坊三间，玲珑雅致。
LONG);
  set("outdoors", "wutaishan");
  set("exits", ([
     "north" : __DIR__"xiantongsi",
     "enter" : __DIR__"tys-daxiong",
  ]));
  set("no_clean_up", 0);
  setup();
}

