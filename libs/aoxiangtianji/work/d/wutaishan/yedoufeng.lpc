inherit BIGROOM;
inherit HILLROOM;
void create()
{
   set("short", "北台叶斗峰" );
   set("long", @LONG
五台山北台名为叶斗峰，以惊险取胜，位于台怀镇以
北5公里，海拔高度为3058米，面积达400余亩，是五
台山中之最高峰，也是华北地区最高峰。台顶气候异
常寒冷，通常9月见雪，4月解冻，台背阴面有常年不
化的冰雪，称之为“万年冰”。对佛教徒而言，这里
是朝拜北台无垢文殊的圣地。
LONG);
  set("exits", ([
    "southdown" : __DIR__"w-shanlu4",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "wutai");
  setup();
}

