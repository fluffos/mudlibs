inherit MIDDLEROOM;
inherit HILLROOM;
inherit TEMPLEROOM;
void create()
{
  set("short", "罗睺寺");
  set("long", @LONG
罗睺寺在显通寺东，是一座喇嘛庙，唐时初创。
罗睺寺还有一种奇观，后殿中心有一座活动莲
台，是一木制圆形佛坛，坛上周围雕有波涛和十
八罗汉渡江，当中荷蒂上有木制大型花瓣，内雕
方形佛龛，四方佛分坐在佛龛中，莲台设有中轴
和轮盘，操纵机关时莲台旋转，莲花一开一和，
四方佛时隐时现，这叫做“花开见佛”。罗睺寺
也是五台山五大禅处之一。
LONG);
  set("outdoors", "wutaishan");
  set("exits", ([
     "west" : __DIR__"xiantongsi",
     "east" : __DIR__"xiaohe-w",
  ]));
  set("no_clean_up", 0);
  setup();
}

