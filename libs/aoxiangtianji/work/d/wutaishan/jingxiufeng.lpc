inherit BIGROOM;
inherit HILLROOM;
void create()
{
   set("short", "南台锦绣峰" );
   set("long", @LONG
五台山南台名为锦绣峰，位于台怀镇南12公里，海拔2485米，
面积200余亩。台顶象倒立的藻瓶，周围1里，细花杂草布满了
整个山峦，犹如绿色的地毯。这里有罕见的$HIY$“金莲”$NOR$、“日菊”
和名贵的“银盘蘑菇”。每年芒种过后，盛夏来临，来自各地
的骡马牛羊聚集山上，牧民们的歌声回荡在山谷中，动人心弦。
对佛教徒而言，这里是朝拜南台智慧文殊的圣地。
LONG);
  set("exits", ([
    "southwest" : __DIR__"s-shanlu2",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "wutai");
  setup();
}

