inherit SMALLROOM;
inherit HILLROOM;
void create()
{
   set("short", "小山路" );
   set("long", @LONG
一条弯曲狭小的山路，路的两面，杂草和荆棘丛生。
这里已经比较偏僻了，香客和游客几乎看不到。顺
着这条弯弯曲曲的小山路，可以到达五台山的东台
望海峰。
LONG);
  set("exits", ([
    "westdown" : __DIR__"e-shanlu4",
    "eastup" : __DIR__"wanghaifeng",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "wutaishan");
  setup();
}

