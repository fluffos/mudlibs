inherit MIDDLEROOM;
inherit HILLROOM;
void create()
{
   set("short", "山路" );
   set("long", @LONG
一条不算宽阔的弯曲山路，路的两面。绿树
成荫。这里向东南折往著名的殊像寺。
LONG);
  set("exits", ([
    "southeast" : __DIR__"shuxiangsi",
    "north" : __DIR__"e-shanlu1",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "wutai");
  setup();
}

