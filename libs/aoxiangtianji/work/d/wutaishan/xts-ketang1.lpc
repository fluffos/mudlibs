inherit SMALLROOM;
inherit LANDROOM;
inherit TEMPLEROOM;
void create()
{
  set("short", "客堂");
  set("long", @LONG
这儿是显通寺内的一间客堂，供香客们休息
之用。客堂内桌椅俱全，香茶提供。
LONG);
  set("exits", ([
       "west"    : __DIR__"xts-guanyin",
  ]));
