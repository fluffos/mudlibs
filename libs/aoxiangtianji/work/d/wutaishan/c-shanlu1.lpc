inherit MIDDLEROOM;
inherit HILLROOM;
void create()
{
   set("short", "山路" );
   set("long", @LONG
一条不算宽阔的弯曲山路，路的两面。绿树
成荫。这里向西南，就是台怀镇，东北通往
中台翠石峰。
LONG);
  set("exits", ([
    "northeast" : __DIR__"c-shanlu2",
    "southwest" : __DIR__"taihuai",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "wutai");
  setup();
}

