inherit MIDDLEROOM;
inherit LANDROOM;
inherit TEMPLEROOM;
void create()
{
  set("short", "千钵文殊殿");
  set("long", @LONG

显通寺七重大殿的第五殿。这座佛殿中供奉的是文殊菩萨。
佛坛上供有文殊菩萨千钵塑像。两边墙壁上彩绘有文殊菩
萨的故事传说。殿内青砖铺地，佛香浓郁。
LONG
);
  set("exits", ([
    "north" : __DIR__"xts-tongdian",
    "south"   : __DIR__"xts-wuliang",
  ]));
  set("no_clean_up", 0);
  set("objects", ([
     "/obj/npc/oldwomen" : 1,
     "/d/wutaishan/obj/wenshu" : 1,
  ]));
  setup();
}

