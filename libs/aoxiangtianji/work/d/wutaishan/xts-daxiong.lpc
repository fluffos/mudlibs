inherit BIGROOM;
inherit LANDROOM;
inherit TEMPLEROOM;
void create()
{
  set("short", "大雄宝殿");
  set("long", @LONG

显通寺七重大殿的第三殿。这里经常举办些大型的佛事活动。
正面就是佛祖神像。高大的佛像几乎挨到了屋顶，令人凌然
生威。正对着门的地方摆着几张供桌，上面是时鲜的瓜果。
供桌两边的大蜡烛比人还高。两边是十八罗汉。
LONG);
  set("objects", ([
      "/d/kaifeng/obj/rulaixiang" : 1,
      "/obj/npc/xiangke" : 1,
  ]));
  set("no_clean_up", 0);
  set("exits", ([
     "north" : __DIR__"xts-wuliang",
     "south" : __DIR__"xts-wenshu",
     "east"  : __DIR__"xts-jialan",
     "west"  : __DIR__"xts-xiangfang1",
  ]));
  setup();
}

