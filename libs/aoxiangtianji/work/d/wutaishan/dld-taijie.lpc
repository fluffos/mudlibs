inherit BIGROOM;
inherit HILLROOM;
void create()
{
   set("short", "台阶" );
   set("long", @LONG
黛螺顶山下，一条台阶直向山上。上黛螺顶从山
脚下要登1080级台阶人们到五台山拜佛旅游，因
为各种原因限制，不可能都登上五个台顶。而黛
螺顶上的五方文殊殿模仿五个台顶的五方文殊，
将他们合塑于正殿。所以登黛螺顶就等于登五个
台顶，在五方文殊殿朝拜就等于朝拜了五个台顶
的五方文殊。
LONG);
  set("exits", ([
    "eastup" : __DIR__"dailuoding",
    "west" : __DIR__"xiaohe-e",
    "southeast" : __DIR__"e-shanlu4",
  ]));
  set("objects", ([
    "/obj/npc/xiangke" : 1,
    "/obj/npc/oldwomen" : 1,
    sprintf("/obj/npc/boy%d", 2+random(2)) : 1,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "wutai");
  setup();
}

