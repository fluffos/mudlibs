{
   set("short", "山路" );
   set("long", @LONG
一条狭窄的山路，路两边峭壁陡立，山势极为险要。
从这里向北，沿着这蜿蜒的小路，可以到达北岳恒山。
LONG);
  set("exits", ([
    "southdown" : __DIR__"w-shanlu3",
    "north" : "/d/hengshan/daziling",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "wutai");
  setup();
}

