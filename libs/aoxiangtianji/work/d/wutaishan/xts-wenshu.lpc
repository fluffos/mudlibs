inherit MIDDLEROOM;
inherit LANDROOM;
inherit TEMPLEROOM;
void create()
{
  set("short", "大文殊殿");
  set("long", @LONG

显通寺七重大殿的第二殿。这座佛殿中供奉的是文殊菩萨。
佛坛上供有文殊菩萨和其侍者的塑像。两边墙壁上彩绘有
文殊菩萨的故事传说。
LONG
);
  set("exits", ([
    "west" : __DIR__"xts-chanfang2",
    "east" : __DIR__"xts-ketang2",
    "north" : __DIR__"xts-daxiong",
    "south"   : __DIR__"xts-guanyin",
  ]));
  set("no_clean_up", 0);
  set("objects", ([
     sprintf("/obj/npc/seng%d", 1+random(3)) : 1,
     "/obj/npc/xiangke" : 1,
     "/d/wutaishan/obj/wenshu" : 1,
  ]));
  setup();
}

