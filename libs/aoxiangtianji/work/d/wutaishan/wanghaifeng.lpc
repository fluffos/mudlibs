inherit BIGROOM;
inherit HILLROOM;
void create()
{
   set("short", "东台望海峰" );
   set("long", @LONG
五台山东台名望海峰，位于台怀镇东10公里，海拔2795米，
面积100余亩，台顶曾建有望海楼。夏日天气晴好时，黎明
登临其上，可见云海尽头的红日喷薄而出：中国佛教协会会
长、诗人赵朴初，1981年登临东台时曾即景咏词：“东台顶，
盛夏尚披裘，天着霞衣迎日出，峰腾云海作舟浮，朝气满神
州。” 对佛教徒而言，这里是朝拜东台聪明文殊的圣地。
LONG);
  set("exits", ([
    "westdown" : __DIR__"e-shanlu5",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "wutai");
  setup();
}

