#include <ansi.h>
#define NAME "东海龙王"
inherit NPC;
void create()
{
  set_name(NAME, ({"donghai longwang"}));
  set("male", "男性");
  set("age", 23);
  setup();
}

void init()
{
  ::init();
}

void announce_success(object who)
{
  int dx, qn;

  if ((int)who->query("dntg/number") != 1)
    return;
  dx = random(5000);
  dx += 15000;
  qn = dx/3;
  who->set("dntg/number",2);
  who->set("dntg/donghai","done");
  who->delete("dntg/donghai");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("dntg/dx",dx);
  who->add("dntg/qn",qn);
  command("chat "+who->query("name")+"你竟敢拿走我龙宫的定海神针铁，看我不去玉帝面前告你！\n");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("dntg",sprintf("%s(%s) passed the donghai on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
}