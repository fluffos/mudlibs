#include <room.h>
inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "云楼殿");
  set ("long", @LONG
云楼殿乃是托塔天王之公务堂，托塔天王乃是天界元帅，云楼殿
实乃是天界之军事中枢。廊下将军天王两旁列，杀气腾腾，堂前
一对金烛燃，指点光明。
LONG);
  set("item_desc", ([
    "up" : "台上白云绕绕，什么也看不清楚。\n",
  ]));
  set("exits", ([
    "up": __DIR__"yunloutai",
    "south": __DIR__"yongdao",
  ]));
  set("objects", ([
    __DIR__"npc/julingshen" : 1,
  ]));
  setup();
}