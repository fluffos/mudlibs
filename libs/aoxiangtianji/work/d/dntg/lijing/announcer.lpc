#include <ansi.h>
inherit NPC;
void create()
{
  set_name("太白金星",({"taibai jinxing"}));
  setup();
}

void announce(object winner,object env)
{
  call_out("announce1",2,winner,env);
}

void announce1(object winner,object env)
{
  int dx, qn;

  if ((int)winner->query("dntg/number") != 4)
    return;
  if ((string)winner->query("dntg/lijing") != "done")
  {
    command(sprintf("chat 奉玉帝圣旨，%s%s武功盖世，法术超群，加封为齐天大圣！\n",
                     winner->name(1),RANK_D->query_respect(winner)));
    winner->add("cor",1);
    tell_object(winner,HIC"你得到了一点胆识！\n"NOR);
    winner->set_temp("apply/title",({HIR"齐天大圣"NOR}));
    dx = random(2000);
    dx += 20000;
    qn = dx/3;
    winner->set("dntg/lijing","done");
    winner->set("dntg/number",5);
    winner->add("daoxing",dx);
    winner->add("potential",qn);
    winner->add("dntg/dx",dx);
    winner->add("dntg/qn",qn);
    winner->save();
    tell_object(winner,sprintf("你赢得了%s道行，%s点潜能！\n",
                     COMBAT_D->chinese_daoxing(dx),
                     chinese_number(qn)));

    log_file("dntg",sprintf("%s(%s) passed the hgs-lijing on %s\n",
             winner->name(1), geteuid(winner), ctime(time()) ) );
    env->set("host",winner);
  }

  destruct(this_object());
}

