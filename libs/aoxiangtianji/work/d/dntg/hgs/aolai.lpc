inherit BIGROOM;
inherit WATERROOM;
void create()
{
  set("short", "傲来国");
  set("long", @LONG

东胜神洲海边一小国。傲来国西临大海，东靠花果山，只因为
大海和高山的阻隔，知道这个小国的人不多。
LONG );

  set("exits", ([
    "west"   : __DIR__"aolaiws",
    "east"   : __DIR__"flowerfruit",
    "south"  : __DIR__"northgate",
  ]));
  set("outdoors", 1);
  setup();
}

