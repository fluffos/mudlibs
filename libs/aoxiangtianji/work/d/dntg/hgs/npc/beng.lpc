inherit NPC;
void create()
{
  set_name("崩将军", ({"beng jiangjun","beng","monkey"}));
  set("title","花果山大将");
  set("gender", "男性" );
  set("age", 35);
  set("class","taoist");
  set("long", "一只成了精的通背猿。\n");
  set("combat_exp", 60000);
  set("daoxing", 30000);
  set("attitude", "peaceful");
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_skill("spells", 80);
  set_skill("dao", 80);
  set_skill("stick", 80);
  set_skill("force", 80);
  set_skill("wuxiangforce", 80);
  set_skill("qianjun-stick", 80);
  set_skill("jindouyun", 80);
  map_skill("stick", "qianjun-stick");
  map_skill("parry", "qianjun-stick");
  map_skill("dodge", "jindouyun");
  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  set("max_kee", 800);
  set("max_sen", 800);
  set("max_force", 600);
  set("force", 1200);
  set("force_factor", 30);
  set("max_mana", 600);
  set("mana", 1200);
  set("mana_factor", 20);
  setup();
  carry_object("/d/qujing/obj/armor/shoupiqun")->wear();
  carry_object("/d/obj/weapon/stick/bintiegun")->wield();
}

void init()
{
  ::init();
  set("chat_chance", 3);
  set("inquiry", ([
     "name" : "我就是花果山水帘洞大将崩将军。\n",
     "here" : "这就是花果山。\n",
     "大王" : "嘿！我家大王就是花果山水帘洞洞主。\n",
     "weapon" : "我们花果山正缺这玩艺，要能搞点来多好！\n",
     "bingqi" : "我们花果山正缺这玩艺，要能搞点来多好！\n",
     "兵器" : "我们花果山正缺这玩艺，要能搞点来多好！\n",
  ]) );
  set("chat_msg", ({
     "崩将军说道：要想守卫我花果山，就须操练兵马。\n",
     "崩将军自言自语的说：我等须得些锋利剑戟才能抵御来犯之敌。\n",
     "崩将军低头说道：到哪里才能搞些兵器来呢？\n",
  }) );
}

int accept_object(object who, object ob)
{
  object me=this_object();
  if ((string)ob->query("id")!="bing qi")
  {
    command("say 这玩艺有什么用？");
    message_vision ("\n$N顺手把"+ ob->query("name")+ "扔了。\n",me);
    return 1;
  }

  else if ((int)who->query("dntg/number") != 1)
  {
    command("say 哇！今天运气好，白得了这么多兵器！！\n");
    command("xixi");
    return 1;
  }

  else if (who->query("dntg/donghai")=="begin"
        || who->query("dntg/donghai")=="allow"
        || who->query("dntg/donghai")=="done")
  {
    command("say 兵器已经够用了，不劳大王操心了。\n");
    return 1;
  }

  else if (random(10) != 1)
  {
    message_vision ("\n$N兴奋的叫道：太好了！要是再多一点儿就更好了。\n",me);
    return 1;
  }

  else
  {
    command("jump");
    command("say 大王，我们的兵器是够用了，您自己也挑一样称手的家伙吧！\n");
    who->set("dntg/donghai","begin");
    return 1;
  }

}

void announce_success(object who)
{
  int dx, qn;
  if (who->query("dntg/number"))
    return;
  dx = random(3000);
  dx += 10000;
  qn = dx/3;
  who->set("dntg/number",1);
  who->set("dntg/huaguo","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("dntg/dx",dx);
  who->add("dntg/qn",qn);
  this_object()->command("chat 哈哈，" + who->name() + "斩了霸占我们水帘洞的魔头，"
                      "顺利闯过大闹天宫第一关！\n");
  this_object()->command(sprintf("chat 从此七十二洞精灵皆应尊%s为王，"
                      "随时听候调遣！\n",who->name(1)));
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("dntg",sprintf("%s(%s) passed the first on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
}

void receive_damage(string type)
{
  return;
}

void receive_wound(string type)
{
  return;
}

