inherit "/obj/npc/dangpu-npc";
void create()
{
  set_name("吴本钱", ({"wu benqian","wu","nomoney"}));
  set("gender", "男性");
  set("combat_exp", 8000);
  set("age", 36);
  set("per", 18);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_skill("dodge", 20);
  setup();
  add_money("silver", 1);
  carry_object("/obj/cloth/choupao")->wear();
}