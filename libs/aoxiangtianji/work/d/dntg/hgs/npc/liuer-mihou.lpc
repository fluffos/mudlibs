#include <ansi.h>
inherit NPC;
string ask_me();
void create()
{
  set_name("六耳猕猴", ({"liuer mihou", "liuer", "mihou"}));
  set("title", "灵通子");
  set("gender", "男性" );
  set("age", 35);
  set("per", 14);
  set("str", 30);
  set("long",
"六耳猕猴早年拜在镇元大仙门下，学得一身好本领。\n后来他自觉跟镇元大仙差不多了，便开始不安分起来，\n"
"居然去果园偷吃人参果，结果是果子没吃着反而被镇元大仙逮住，\n痛加斥责后逐出了门墙。\n");
  set("class", "yaomo");
  set("combat_exp", 2200000);
  set("daoxing", 2200000);
  set("attitude", "peaceful");
  set("rank_info/respect", "猴爷");
  set_skill("unarmed", 220);
  set_skill("wuxing-quan", 220);
  set_skill("dodge", 220);
  set_skill("baguazhen", 220);
  set_skill("parry", 220);
  set_skill("sword", 220);
  set_skill("xiaofeng-sword", 220);
  set_skill("force", 220);
  set_skill("zhenyuan-force", 220);
  set_skill("literate", 220);
  set_skill("spells", 220);
  set_skill("taiyi", 220);
  map_skill("spells", "taiyi");
  map_skill("force", "zhenyuan-force");
  map_skill("unarmed", "wuxing-quan");
  map_skill("dodge", "baguazhen");
  map_skill("sword", "xiaofeng-sword");
  map_skill("parry", "kaishan-chui");
  set("max_kee", 2800);
  set("max_sen", 2800);
  set("force", 5000);
  set("max_force", 2800);
  set("mana", 5000);
  set("max_mana", 2800);
  set("force_factor", 120);
  set("mana_factor", 120);
  set("no_ji", 1);
  set("chat_chance_combat", 30);
  set("chat_msg_combat",
  ({
    (: cast_spell, "zhenhuo" :),
  }) );
  set("inquiry", ([
     "name": "齐天大圣孙悟空是也。\n",
     "here": "。。。\n",
     "人参果": "猴爷我最喜欢的就是人参果。\n",
     "秘诀": "秘诀？只要你有人参果，什么都好商量。\n",
     "猕猴手记": "手记？只要你有人参果，什么都好商量。\n",
     "真假"     : (: ask_me :),
  ]) );
  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
}

int accept_object(object me, object ob)
{
  object book;
  if ( (string)ob->query("id") != "renshen guo" )
  {
    message_vision("六耳猕猴尖声叫道：去！去！去！你家猴爷没空理你！\n", me);
    command("kick " + me->query("id"));
    return 0;
  }

  else
  {
    command("jump ");
    command(sprintf("say 这位%s果然是痛快人！\n",RANK_D->query_respect(me)));
    book = new("/d/obj/book/mihou-book");
    book->move(me);
    book->set("owner",me->query("id"));
    message_vision("$N对$n道：那猴爷我也不能小气。说罢递给$n一本小册子。\n", this_object(), me);
    me->set_temp("rsg_given", 1);
    return 1;
  }

}

string ask_me()
{
  this_player()->set_temp("liuer-mihou_ask",1);
  call_out("autokill",1,this_player(),this_object());
  return "嘿嘿";
}

void autokill (object me, object who)
{
  if (!me || !who || environment (me) != environment (who))
    return;
  message_vision ("\n$N大怒：哪个泼贼子冒充你家猴爷！\n",me);
  message_vision ("$n大喝一声要杀死$N！\n",me,who);
  me->kill_ob(who);
  who->kill_ob(me);
}

void kill_ob (object ob)
{
  object me = this_object();
  set_temp("my_killer",ob);
  ob->kill_ob(me);
}

void die()
{
  object guan;
  object me = this_object();
  object ob = me->query_temp("my_killer");
  if (objectp(ob)
    && ob == me->query_last_damage_from()
    && (int)ob->query("obstacle/number") == 26
    && (string)ob->query("obstacle/liuerhou") != "done"
    && ob->query_temp("liuer-mihou_ask"))
  {
    guan = new ("/d/dntg/hgs/npc/pusa");
    guan->move(environment (me));
    guan->announce_success (ob);
    message_vision(HIY "\n$N突然从彩云间现身。\n" NOR,guan);
    message_vision(HIY "\n$N对$n一点手，你这猴头！\n" NOR,guan,me);
    message_vision(HIY "$N哎呀一声，现了真身。\n\n" NOR,me);
    message_vision(HIC "$N说道：这厮我带走，你安心取经去吧。\n\n" NOR,guan);
    ob->delete_temp("liuer-mihou_ask");
    message_vision("$N悻悻地走了。\n\n",me);
    destruct (guan);
  }

  destruct(me);
  return;
}

void unconcious()
{
  die();
}

