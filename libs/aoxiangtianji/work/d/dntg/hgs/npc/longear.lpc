#include <ansi.h>
inherit NPC;
string send_mail();
string receive_mail();
string ask_idle();
string ask_changan();
void create()
{
  set_name("顺风耳", ({"shunfeng er", "er", "longear", "youchai","chai" }) );
  set("title", "邮差");
  set("gender", "男性" );
  set("age", 30);
  set("long", "前玉皇大帝亲信。因为偷听玉皇大帝跟嫦娥调情而被罚为邮差。\n");
  set("combat_exp", 8000);
  set("daoxing", 100000);
  set("attitude", "friendly");
  set("inquiry", ([
    "name":"连我你都不认识？大名鼎鼎的顺风耳就是我。",
    "here" : "鬼知道这是什么地方！我只负责收信发信。",
    "嫦娥" : "唉...可惜只闻其声未见其人。",
    "玉皇大帝" : "你别提他！一提我就有气...只许州官放火，不许百姓点灯。",
    "发信" : (: send_mail :),
    "收信" : (: receive_mail :),
    "信件" : (: receive_mail :),
    "信" : (: receive_mail :),
    "mail" : "您讲的是外国话吧？我听不懂耶~~~~~~~~",
    "发呆" : (: ask_idle :),
    "长安" : (: ask_changan :),
  ]) );
  set_skill("literate", 70);
  set_skill("dodge", 50);
  set_skill("unarmed", 40);
  set("per", 15);
  set("max_kee", 500);
  set("max_gin", 100);
  set("max_sen", 300);
  set("force", 150);
  set("max_force", 300);
  set("force_factor", 0);
  setup();
  add_money("coin", 70);
  carry_object("/obj/cloth/linen")->wear();
}

string send_mail()
{
  object mbox;
  if( this_player()->query_temp("mbox_ob") )
    return "你的信箱还在吧？用信箱就可以寄信了。\n";
  if( !environment()
     || base_name(environment()) != query("startroom") )
    return "等一下到大石头来找我吧。\n";
  seteuid(getuid());
  mbox = new(MAILBOX_OB);
  mbox->move(this_player());
  return "哦... 要寄信是吗？这是你的信箱，寄信的方法信箱上有说明。\n";
}

string receive_mail()
{
  object mbox;
  if( this_player()->query_temp("mbox_ob") )
    return "你的信箱还在吧？你所有的信都在里面。\n";
  if( !environment()
     || base_name(environment()) != query("startroom") )
    return "等一下到大石头来找我吧。\n";
  seteuid(getuid());
  mbox = new(MAILBOX_OB);
  mbox->move(this_player());
  return "好，待我找找....有了，你的信箱在这，慢慢看吧，不打搅你了。\n";
}

string ask_idle()
{
  object who = this_player();

  if (who->query_temp("learned_idle_force"))
    return "你先把俺刚才教你的领悟好再说吧！\n";
  command("say 听好了！发呆神功宗旨：@#$%^&%#$#@$%&*&+*^&……");
  if (who->query("potential") < who->query("learned_points") + 10)
    return HIY "你听得稀里糊涂，看来是潜能不够了。\n" NOR;
  if (who->query_skill("idle-force", 1) > 500)
  {
    write(HIW "你听完了心想，这些我都懂啊，看来长耳朵也"
              "就知道这么多了。\n" NOR);
    return "居然比我都强？\n";
  }

  who->set_temp("learned_idle_force", 1);
  who->add("learned_points", 10);
  write(HIW "你听了心中颇有所得，马上进行发呆练习！\n" NOR);
  return "快去练习吧！\n";
}

string ask_changan()
{
  object ridee;
  object me = this_object();
  object who = this_player();
  if ((int)who->query("level") > 18 || who->query("age") > 18)
    return "你还是自己去吧！\n";

  if (objectp(ridee = who->query_temp("is_riding")))
    return "你还是先下了坐骑吧！\n";

  if (who->is_busy())
    return "你正忙着呢！\n";

  message_vision("$N念了几句咒语，说到，去去去，去来去！\n",me);
  message_vision("瞬间，$N驾风而去了！\n",who);
  who->move("/d/city/ncenter");
  message_vision("一声轰鸣，$N从天而降，原来是千里眼把$N给弄了过来！\n",who);
  return "你就去吧！\n";
}

