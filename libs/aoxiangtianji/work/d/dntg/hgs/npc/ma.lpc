#include <ansi.h>
#define NAME "马元帅"
inherit NPC;
void create()
{
  set_name(NAME, ({"ma yuanshuai"}));
  set("male", "男性");
  set("age", 23);
  set("long", "一只大马猴。\n");
  set("combat_exp", 200000);
  set("daoxing", 200000);
  set("attitude", "peaceful");
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("spells", 100);
  set_skill("dao", 100);
  set_skill("stick", 100);
  set_skill("force", 100);
  set_skill("wuxiangforce", 100);
  set_skill("qianjun-stick", 100);
  set_skill("jindouyun", 100);
  map_skill("stick", "qianjun-stick");
  map_skill("parry", "qianjun-stick");
  map_skill("dodge", "jindouyun");
  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("max_force", 800);
  set("force", 1500);
  set("force_factor", 30);
  set("max_mana", 800);
  set("mana", 1500);
  set("mana_factor", 40);
  setup();
  carry_object("/d/qujing/obj/armor/shoupiqun")->wear();
  carry_object("/d/obj/weapon/stick/bintiegun")->wield();
}

void init()
{
  ::init();
}

void announce_success(object who)
{
  int dx, qn;
  if (who->query("dntg/number"))
    return;
  dx = random(3000);
  dx += 10000;
  qn = dx/3;
  who->set("dntg/number",1);
  who->set("dntg/huaguo","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("dntg/dx",dx);
  who->add("dntg/qn",qn);
  this_object()->command("chat 哈哈，" + who->name() + "斩了霸占我们水帘洞的魔头，"
                      "顺利闯过大闹天宫第一关！\n");
  this_object()->command(sprintf("chat 从此七十二洞精灵皆应尊%s为王，"
                      "随时听候调遣！\n",who->name(1)));
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("dntg",sprintf("%s(%s) passed the first on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
}

void refuse_player(object who)
{
  string name;
  name = who->name();
  message_vision (HIY NAME+"突然跑了过来$N摇摇头："+
                  "我们正在选猴王，没事别来捣乱。\n" NOR,who);
  message_vision (HIY "说罢"+NAME+"急匆匆的离开了。\n" NOR,who);
}