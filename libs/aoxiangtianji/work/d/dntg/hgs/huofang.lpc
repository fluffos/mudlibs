inherit SMALLROOM;
inherit LANDROOM;
inherit SAFTYROOM;
inherit "/d/dntg/hgs/newbie.lpc";
void create ()
{
  set ("short", "仓库");
  set ("long", @LONG
这里不知是那家商号的仓库，周围密密麻麻堆放着些箱子。仓库中
做工的人很多，大多是光着脚的青年汉子。一趟又一趟的搬运着货
物。墙上贴着张大报，大意是缺人手，要请人来工作(work)。
LONG);
  set("objects", ([ /* sizeof() == 1 */
    "/obj/npc/boy3" : 2,
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "south" : __DIR__"west1",
  ]));
  setup();
}

void init()
{
  ::init();
  add_action("do_work", "work");
}

int do_work(string arg)
{
  object *obs;
  object ob;
  object me;
  int t, work_t;
  me = this_player();
  obs = filter_array(all_inventory(this_object()),
                      (: interactive($1) &&
                         $1 != $(me) &&
                         query_ip_number($1) == query_ip_number($(me)) :));
  if (sizeof(obs) > 0)
  {
    message_vision(sprintf("工头笑眯眯地对$N说：真对不住，已经有%s在干活了。\n",obs[0]->name()),me);
    return 1;
  }

  t = time();
  work_t = (int)me->query_temp("last_work_time");

  if (work_t && (t - work_t) < 2)
  {
    message_vision("工头赶紧把$N扶起来：先歇一会儿。\n",me);
    return 1;
  }

  if (me->query("kee") < 25 ||
      me->query("sen") < 25)
    return notify_fail("你可是累坏了，干不动了。\n");
  if ((int)me->query("combat_exp") > 12000)
    return notify_fail("这里已经不适合你做工了。\n");
  message_vision("$N从车上卸下一袋袋的大米，又垒在墙边，累的腰酸腿疼！\n",me);
  me->add("kee",-20);
  me->add("sen",-20);
  ob = new("/obj/money/coin");
  ob->set_amount(10+random(5));
  ob->move(me);
  me->add("combat_exp",2 + random(5));
  message_vision("旁边过来个工头笑眯眯地对$N说：辛苦啦，这是你的工钱。\n",me);
  me->set_temp("last_work_time",time());
  return 1;
}