#include <ansi.h>
inherit BANK;
void create ()
{
  set ("short", "张家钱庄");
  set ("long", @LONG
张家钱庄张万宝乃是城中首富，和许多王孙公子也很有交情。由
于其经营有方，门路又广，钱庄的生意也是不错。正中横摆一张
七尺柜台，台前有个小牌子(paizi)。后面站着位精明的老先生。
LONG);
  set("item_desc", ([
      "paizi":
HIG"本钱庄提供的服务有：\n"NOR
HIC"--------------------------------\n"NOR
HIG"check(chazhang)        查帐\n"NOR
HIG"check(chazhang qn)     查潜能\n"NOR
HIC"--------------------------------\n"NOR
HIG"deposit(cun)           存款\n"NOR
HIC"--------------------------------\n"NOR
HIG"withdraw(qu)           取款\n"NOR
HIC"--------------------------------\n"NOR
HIG"convert(duihuan)       兑换钱币\n"NOR
HIC"--------------------------------\n"NOR
HIG"qn                     潜能业务\n"NOR
HIC"--------------------------------\n"NOR
  ]) );
  set("exits", ([ /* sizeof() == 1 */
    "east" : __DIR__"north2",
  ]));
  set("objects",
  ([ //sizeof() == 1
      __DIR__"npc/zhang" : 1,
  ]));
  set("no_clean_up", 0);
  setup();
}

