inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "太阳宫");
  set("long", @LONG
天宫的一座偏殿，天神进宫面见玉帝之前常在此歇息，
只见这里四壁描龙绣凤，气势非凡。
LONG );
  set("exits", ([
    "north"   : __DIR__"shenpinggong",
    "south"   : __DIR__"tonglugong",
    "west"   : __DIR__"huayuedian",
    "east"   : __DIR__"pixiangdian",
  ]));
  setup();
}

