增长天王手下八大天王之一，正在这里仔细的寻查
每一个过往行人。
");
  set("title", "大力天丁");
  set("age", 35+random(10));
  set("attitude", "peaceful");
  set("str", 30);
  set("dex", 30);
  set("spi", 30);
  set("int", 25);
  set("combat_exp",800000);
  set("daoxing",800000);
  set("force",2500);
  set("max_force",1500);
  set("force_factor", 70);
  set("mana",2500);
  set("max_mana",1500);
  set("mana_factor", 70);
  set("max_kee", 1500);
  set("max_sen", 1500);
  set_skill("unarmed",150);
  set_skill("dodge",150);
  set_skill("parry",150);
  set_skill("spear",150);
  set_skill("force",150);
  set_skill("duo-spear", 150);
  set_skill("yanxing-steps", 150);
  set_skill("spells", 150);
  set_skill("baguazhou", 150);
  set_skill("changquan", 150);
  set_skill("lengquan-force", 150);
  map_skill("spear","duo-spear");
  map_skill("parry", "duo-spear");
  map_skill("dodge", "yanxing-steps");
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("unarmed", "changquan");
  setup();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/d/obj/weapon/spear/tieqiang")->wield();
