inherit NPC;

void create()
{
  int rd;

  rd=random(4);
  set_name("天兵", ({ "tian bing", "tian", "bing" }) );
  set("gender", "男性" );
  set("long",
"托塔李天王帐下天兵，膀阔腰圆，力大无穷。\n"
"他手持兵刃，身穿宝甲，目光扫视着每个路过的人。\n"
);
  set("age", 19+random(15));
  set("str", 30);
  set("spi", 30);
  set("dex", 30);
  set("int", 20);
  set("per", 15+random(10));
  set("combat_exp", 300000);
  set("daoxing", 300000);
  set("max_kee", 1200);
  set("max_sen", 1200);
  set("force",1200);
  set("max_force",800);
  set("force_factor", 40);
  set("mana", 1200);
  set("max_mana", 800);
  set("mana_factor", 40);

  set_skill("unarmed",80);
  set_skill("dodge",80);
  set_skill("parry",80);
  set_skill("feiyan-zoubi", 80);
  set_skill("changquan", 80);
  map_skill("dodge", "feiyan-zoubi");
  map_skill("unarmed", "changquan");

  switch(rd)
  {
    case 0:
      set_skill("stick",80);
      set_skill("dali-stick",80);
      map_skill("stick","dali-stick");
      map_skill("parry","dali-stick");
      break;
    case 1:
      set_skill("sword",80);
      set_skill("sancai-sword",80);
      map_skill("sword","sancai-sword");
      map_skill("parry","sancai-sword");
      break;
    case 2:
      set_skill("fork",80);
      set_skill("dingbo-fork",80);
      map_skill("fork","dingbo-fork");
      map_skill("parry","dingbo-fork");
      break;
    default :
      set_skill("axe",80);
      set_skill("sanban-axe", 80);
      map_skill("axe", "sanban-axe");
      map_skill("parry","sanban-axe");
      break;
  }

  setup();
  carry_object("/d/obj/armor/armor/tianjia")->wear();
  switch(rd)
  {
    case 0:
      carry_object("/d/obj/weapon/stick/bintiegun")->wield();
      break;
    case 1:
      carry_object("/d/obj/weapon/sword/tiejian")->wield();
      break;
    case 2:
      carry_object("/d/obj/weapon/fork/gangcha")->wield();
      break;
    default :
      carry_object("/d/obj/weapon/axe/bigaxe")->wield();
      break;
  }

}