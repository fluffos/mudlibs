inherit NPC;
void create()
{
  set_name("雷公",({"lei gong","lei shen","gong"}));
  set("gender", "男性");
  set("age", 45);
  set("long", "    \n一个尖嘴猴腮的天神，在天宫中负责打雷。\n");
  set("attitude", "heroism");
  set("class", "xian");
  set("combat_exp", 1000000);
  set("daoxing", 1000000);
  set("kee", 1800);
  set("max_kee", 1800);
  set("sen", 1800);
  set("max_sen", 1800);
  set("force", 3000);
  set("max_force", 2200);
  set("mana", 4000);
  set("max_mana", 2200);
  set("force_factor", 100);
  set("mana_factor", 100);
  set("per", 17);
  set_skill("dodge", 180);
  set_skill("jindouyun", 180);
  set_skill("unarmed", 190);
  set_skill("puti-zhi", 190);
  set_skill("spells", 180);
  set_skill("dao", 180);
  set_skill("parry", 180);
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("spells", "dao");
  set("inquiry", ([
    "打雷"   : "急什么？该下雨时我自然会去打雷。",
    "name"   : "我是雷神。",
    "here"   : "这里就是天宫。",
  ]));
  setup();
  carry_object("/obj/cloth/xianpao")->wear();
  carry_object("/d/dntg/sky/obj/leilingfu");
}