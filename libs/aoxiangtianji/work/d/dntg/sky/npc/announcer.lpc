#include <ansi.h>
#define NAME "天蓬元帅"
inherit NPC;
void create()
{
  set_name(NAME, ({"tian peng yuan shuai"}));
  set("male", "男性");
  set("age", 23);
  setup();
}

void init()
{
  ::init();
}

void announce_success(object who)
{
  int dx,qn;
  if ((int)who->query("dntg/number") != 3)
    return;
  dx = random(10000);
  dx += 25000;
  qn = dx/3;
  who->set("dntg/number",4);
  who->set("dntg/bmw","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("dntg/dx",dx);
  who->add("dntg/qn",qn);
  command("chat 大胆" + who->query("name")
        + "！你不好好作你的弼马温，却到天河来捣乱，还敢得罪上官，你给我走着瞧！\n");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("dntg",sprintf("%s(%s) passed bmw on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
}