inherit NPC;

void create()
{
  set_name("时值功曹", ({ "shizhi gongcao", "shi", "hour", "gongcao" }) );
  set("gender", "男性" );
  set("long","
四值功曹乃是托塔李天王帐前猛将。因经验不足而
出战失利，被罚为巡逻官。四人因志同道合而结为
金兰兄弟。时值功曹排行老么，身份最是神秘。他
功夫在众兄弟中最高，但最缺乏经验。\n"
);
  set("age",35);
  set("str",25);
  set("int",25);
  set("max_kee",1000);
  set("kee",1000);
  set("max_sen",1000);
  set("sen",1000);
  set("daoxing",900000);
  set("combat_exp",900000);
  set("force",2000);
  set("max_force",1200);
  set("mana",2000);
  set("max_mana",1200);
  set("force_factor", 60);
  set("mana_factor", 60);
  set_skill("unarmed",150);
  set_skill("parry",150);
  set_skill("dodge",150);
  set_skill("spear",150);
  set_skill("bawang-spear",150);
  set_skill("moshenbu", 150);
  set_skill("force",150);
  set_skill("spells", 150);
  set_skill("dragonfight",150);
  set_skill("baguazhou", 150);
  set_skill("lengquan-force",150);

  map_skill("force","lengquan-force");
  map_skill("unarmed", "dragonfight");
  map_skill("dodge", "moshenbu");
  map_skill("spear", "bawang-spear");
  map_skill("parry","bawang-spear");
  map_skill("spells", "baguazhou");

  set("inquiry", ([
      "name" : "在下就是时值功曹，乃托塔天王帐前大将。",
      "here" : "这里就是天宫。下官奉天王将令，在此巡查。",
  ]) );
  setup();
  carry_object("/d/obj/weapon/spear/biyuqiang")->wield();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
}