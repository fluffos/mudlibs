#include <ansi.h>
inherit NPC;
int promote_me();
int ask_pantao();
void create()
{
  set_name(HIY"玉皇大帝"NOR,({"yuhuang dadi","yuhuang","dadi","yudi","king"}));
  set("gender", "男性");
  set("title", "天宫之主");
  set("age", 45);
  set("long", "    \n这就是自幼修持，苦历过一千七百五十劫的玉皇大帝。\n");
  set("attitude", "peaceful");
  set("class", "xian");
  set("combat_exp", 4000000);
  set("daoxing", 4000000);
  set("kee", 3000);
  set("max_kee", 3000);
  set("sen", 3000);
  set("max_sen", 3000);
  set("force", 6000);
  set("max_force", 3000);
  set("mana", 6000);
  set("max_mana", 3000);
  set("force_factor", 150);
  set("mana_factor", 150);
  set("per", 30);
  set("kar", 30);
  set("str", 30);
  set("spi", 30);
  set("dex", 30);
  set("con", 30);
  set_skill("literate", 300);
  set_skill("sword", 300);
  set_skill("xiaofeng-sword", 300);
  set_skill("spells", 300);
  set_skill("force", 300);
  set_skill("parry", 300);
  set_skill("baguazhen", 300);
  set_skill("buddhism", 300);
  set_skill("zhenyuan-force", 300);
  map_skill("sword", "xiaofeng-sword");
  map_skill("parry", "xiaofeng-sword");
  map_skill("force", "zhenyuan-force");
  map_skill("spells", "buddhism");
  map_skill("dodge", "baguazhen");

  set("inquiry", ([
    "here"   : "这里就是我的灵霄宝殿",
    "name"   : "哪里来的妖仙，真不懂规矩！",
    "官职": (:promote_me :),
    "position": (:promote_me :),
    "pantao": (: ask_pantao :),
    "蟠桃园":(:ask_pantao:),
  ]));
  setup();
  carry_object("/d/obj/armor/cloth/mangpao")->wear();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
  add_money("gold", 1);
}

void init()
{
  object who;
  ::init();
  if( interactive(who = this_player()) && !is_fighting() )
  {
     remove_call_out("greeting");
     call_out("greeting", 1, who);
  }

}

void greeting(object who)
{
  int i,dx, qn;
  string strluzi;
  object luzi , me;
  string msg;
  mapping guanka;
  string *gname;
  me = this_object();

  if ( !who || environment(who) != environment() )
    return;
  if (who->query("dntg/number") <=0 )
  {
    msg = "$N" HIW"怒喝一声：哪里来的" + RANK_D->query_rude(who)
        + HIW"，不经传旨擅自入殿，你眼里还有王法嘛？\n"NOR;
    msg += "$N" HIY"喝道：来人哪！将他给我乱棍打出！\n"NOR;
    message_vision(msg,me);
    call_out ("throws1",1,who);
    return ;
  }

  else if (who->query("dntg/number") == 9 )
  {
    if (who->query("dntg/laojunlu")=="finish")
    {
      me->command("chat 玉皇大帝「唉」的一声叹了口气。\n");
      me->command("chat 罢了，罢了，"+who->query("name")
                    +"，我天宫众将都不是你对手，以后你要怎样就怎样吧！\n");
      me->command("chat 玉皇大帝觉得万念俱灰，难过地叹了口气。\n");
      who->set("dntg/number",10);
//      who->set("dntg/laojunlu","done");
      dx = random(20000);
      dx += 100000;
      qn = dx/3;
      who->add("daoxing",dx);
      who->add("potential",qn);
      tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
      who->set("life/live_forever", 1);
      who->set("always_young", 1);
      who->set("life/live_forever_announced", 1);
      guanka = who->query("dntg");
      gname = keys(guanka);
      for (i = 0; i < sizeof(gname);i++)
        if (guanka[gname[i]] == "done")
          map_delete(guanka,gname[i]);
      who->set("dntg",guanka);
      who->save();
      return ;
    }

// check if there is ppl in laojunlu
    me->set("laojunlu","none");
    for (i=0;i<8;i++)
    {
      strluzi = sprintf("/d/dntg/laojunlu/laojunlu%d",i);
      luzi = load_object(strluzi);
      if (luzi->query("has_ppl")=="yes")
        me->set("laojunlu","passing");
    }

    if (me->query("laojunlu") == "passing")
    {
      this_object()->command("hmm");
      return ;
    }

    else
    {
      msg = "$N" HIR"怒道：$n" HIR"！你这"+RANK_D->query_rude(who)
           + HIR"在下界时屡犯天条，朕一再容你，\n如今你又偷桃，偷酒，"
           "偷仙丹，天神收降于你，你还竟敢顽抗！\n来人！把他给我扔进八"
           "卦炉中缎烧七七四十九日，将之烧为灰烬！\n"NOR;
      message_vision(msg,me,who);
      call_out ("throw_to_lu",1,who);
      return ;
    }

  }

  else if (who->query("dntg/lijing") == "done" ||
           who->query("dntg/number") > 9)
  {
    msg = "$N" HIW"自言自语道：$n" HIW"这个"+ RANK_D->query_rude(who)
        +"越来越没规矩了，竟然不经传旨擅自入殿。\n"NOR;
     message_vision(msg,me,who);
     return ;
  }

  else
  {
    msg = "$N" HIW"朗声宣道道：下界妖仙$n" HIW"初来天庭，不识王法，"
          "朕便赦了你擅自闯殿之罪。\n"NOR;
    message_vision(msg,me,who);
    return ;
  }

  return ;
}

void throw_to_lu (object who)
{
  message_vision(HIY"四面冲上无数天将，将$N" HIY"绳捆索绑，拖了出去。\n"NOR,who);
  who->move("/d/dntg/laojunlu/laojunlu4");
  tell_room( environment(who),"半空中"+who->query("name")+"被笔直的扔了进来。\n", ({who}));
  who->set("dntg/laojunlu","begin");
  who->set_temp("dntg/laojunlu_day",0);
}

int promote_me()
{
  object me=this_object();
  object who=this_player();
  if (who->query("level") <= 15)
  {
     message_vision(HIW"$N" HIW"不屑的冷笑道：哪里来的$n" HIW"！不知天高地厚！\n"NOR,me,who);
     message_vision(HIW"凭$N" HIW"这点本事，也想在天宫当官？\n"NOR,who);
     message_vision("$N" HIW"喝道：来人哪！将$n" HIW"给我乱棍打出！\n"NOR,me,who);
     call_out ("throws1",1,who);
     return 1;
  }

  else if (who->query("dntg/bmw")=="done")
  {
     message_vision("$N" HIW"叹道：$n" HIW"即不愿当弼马温，我这天宫里也没有别的职位，"
                    "$n" HIW"还是另谋高就吧！\n"NOR,me, who);
     return 1;
  }

  else if ((int)who->query("dntg/number") != 3)
  {
    command("hmm");
    command("say 你有何德何能，也跑来要什么官职！\n");
    return 1;
  }

  else if (objectp(present("wuqu xingjun", environment(me))))
  {
    message_vision(HIY"旁边转过武曲星君，启奏$N" HIY"道：“天宫里各宫各殿，各方各处，"
                   "都不少官，只是御马监缺个正堂管事。”\n"NOR,me);
    message_vision("$N" HIW"点了点头说道：“就除你做个‘弼马温’罢。”\n"NOR,me);
    who->set("dntg/bmw","allow");
    return 1;
  }

  else
  {
    message_vision("$N" HIW"点了点头说道：“" + RANK_D->query_respect(who) +
                   HIW"稍侯，待我查看那处少甚官职。”\n"NOR,me);
    return 1;
  }

}

void throws1 (object who)
{
  message_vision(HIW"只见殿外冲进来几个护宫卫士，七手八脚地拖着$N" HIW"走了出去。\n"NOR,who);
  who->move("/d/dntg/sky/qianyuangong");
  tell_room( environment(who),"只见"+who->query("name")+"被踉踉跄跄的推了出来。\n", ({who}));
  call_out ("throws2",2,who);
}

void throws2 (object who)
{
  if (!objectp(who))
    return;
  message_vision(HIW"护宫卫士大喝一声：下去！$N" HIW"被扔回了下界。\n"NOR,who);
  who->move("/d/changan-s/bridge");
  tell_room( environment(who),"半空中"+who->query("name")+"笔直的摔了下来。\n", ({who}));
}

void die()
{
  if (environment())
    message("sound", "\n只听玉皇大帝仰天大叫一声：上天救我！\n", environment());
  set("eff_kee", 3000);
  set("eff_sen", 3000);
  set("kee", 3000);
  set("sen", 3000);
  set("force", 6000);
  set("mana", 6000);
}

void unconcious()
{
  die ();
}

int ask_pantao()
{
  string msg;
  object me = this_object();
  object who=this_player();

  if (who->query("dntg/pantao")=="done")
  {
    message_vision("$N" HIW"狠狠地瞪了$n" HIW"一眼。\n"NOR,me,who);
    command("say 还想去管蟠桃园？没门儿！");
    command("slogan " + who->query("id"));
    return 1;
  }

  if (who->query_temp("dntg/pantao")=="doing")
  {
    command("say 不是已经让你去管桃园了吗？还问什么？");
    return 1;
  }

  if ((int)who->query("level") <= 25)
  {
    msg = "$N" HIW"不屑的冷笑道：哪里来的" + RANK_D->query_rude(who) + HIW"！不知天高地厚！\n"NOR;
    msg += HIW"凭$n" HIW"这点本事，也想执掌蟠桃园？\n"NOR;
    msg += "$N" HIW"喝道：来人哪！将他给我乱棍打出！\n"NOR;
    message_vision(msg,me,who);
    call_out ("throws1",1,who);
    return 1;
  }

  if (who->query_temp("dntg/pantao")=="denied")
  {
    command("heng");
    command("say 说不行就不行，再问也没用！");
    message_vision("$N" HIW"喝道：来人哪！将$n" HIW"给我乱棍打出！\n"NOR,me,who);
    call_out ("throws1",1,who);
    return 1;
  }

  command("hmm");
  command("consider");
  if (random(3))
  {
    command("say 你这人不可靠，我可不放心把蟠桃园交给你管。");
    who->set_temp("dntg/pantao","denied");
    return 1;
  }

  who->set_temp("dntg/pantao","doing");
  who->set("dntg/pantao","doing");
  msg = "$N" HIW"喃喃自语：让$n" HIW"这" + RANK_D->query_rude(who)
      + HIW"闲着，只怕会生出些是非。。。也罢。\n"NOR;
  message_vision(msg,me,who);
  command("ok " + who->query("id"));
  command("say 就让你去管王母娘娘的蟠桃园，少惹麻烦好好干！");
  return 1;
}

