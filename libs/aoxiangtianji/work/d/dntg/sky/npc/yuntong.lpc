inherit NPC;
void create()
{
  set_name("云童",({"yun tong","yun shen","tong"}));
  set("gender", "男性");
  set("age", 15);
  set("long",
"\n天宫中负责起云的天神，他虽看上去年纪轻轻，却\n掌管着天上所有的云彩。\n");
  set("attitude", "heroism");
  set("class", "xian");
  set("combat_exp", 800000);
  set("daoxing", 800000);

  set("kee", 1500);
  set("max_kee", 1500);
  set("sen", 1500);
  set("max_sen", 1500);
  set("force", 2800);
  set("max_force", 1500);
  set("mana", 2800);
  set("max_mana", 1500);
  set("force_factor", 70);
  set("mana_factor", 80);
  set("per", 22);
  set_skill("dodge", 150);
  set_skill("jindouyun", 150);
  set_skill("unarmed", 150);
  set_skill("puti-zhi", 150);
  set_skill("spells", 150);
  set_skill("parry", 150);
  set_skill("dao", 150);
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("spells", "dao");
  set("inquiry", ([
    "起云"   : "有张灵符可以起云，但我不能给你。",
    "cloud"   : "有张灵符可以起云，但我不能给你。",
    "name"   : "我是云神。",
    "here"   : "这里就是天宫。",
  ]));
  setup();
  carry_object("/obj/cloth/xianpao")->wear();
  carry_object("/d/dntg/sky/obj/yunlingfu");
}