inherit NPC;
void create()
{
  set_name("电母",({"dian mu","dian shen","mu"}));
  set("gender", "女性");
  set("age", 45);
  set("long", "    \n一端庄秀雅的天神，在天宫中负责闪电。\n");
  set("attitude", "heroism");
  set("class", "xian");
  set("combat_exp", 700000);
  set("daoxing", 700000);
  set("kee", 1700);
  set("max_kee", 1700);
  set("sen", 1700);
  set("max_sen", 1700);
  set("force", 3000);
  set("max_force", 1500);
  set("mana", 3000);
  set("max_mana", 1500);
  set("force_factor", 70);
  set("mana_factor", 70);
  set("per", 17);
  set_skill("dodge", 150);
  set_skill("jindouyun", 150);
  set_skill("unarmed", 170);
  set_skill("puti-zhi", 170);
  set_skill("spells", 150);
  set_skill("dao", 150);
  set_skill("parry", 150);
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("spells", "dao");
  set("inquiry", ([
    "闪电"   : "没到时候。",
    "name"   : "我是电神。",
    "here"   : "这里就是天宫。",
  ]));

  setup();
  carry_object("/obj/cloth/daogu-cloth")->wear();
  carry_object("/obj/cloth/female-shoe")->wear();
  carry_object("/d/dntg/sky/obj/dianlingfu");
}