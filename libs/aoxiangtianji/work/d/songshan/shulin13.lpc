#include <ansi.h>
inherit SMALLROOM;
inherit WOODROOM;
void create()
{
  set("short", "松树林");
  set("long", @LONG
你眼前骤然一黑，朦胧中，只见左右前后，到处都是铺天盖
地的松树林。几十丈高的大松树簇在一块，密实的枝叶象一蓬蓬
巨伞般伸向天空，把阳光遮得丝毫也无。尺把厚的松针积在地上，
一脚踩下去，半天拔不出来。你似乎迷失了方向，象没头苍蝇般
到处乱闯。
LONG );
  set("exits", ([
    "east" : __DIR__"shulin"+(random(8)+6),
    "south" : __DIR__"shulin"+(random(8)+6),
    "west" : __DIR__"shulin"+(random(8)+6),
    "north" : __DIR__"shulin"+(random(8)+6),
  ]));
  setup();
}

void init()
{
  object ob, room;
  int i = random(2);
  if( i == 0) return;
  ob = this_player();
  if (!playerp(ob))
    return;
  room = this_object();
  room->delete("exits");
  room->set("no_fight", 1);
  room->set("no_magic", 1);
  room->set("no_accept", 1);
  message_vision(HIR "\n$N一不小心，走进了僧兵们设下的陷阱！$N只觉得脚下一阵巨痛，"
                     "原来是踩上了埋在地下的竹签。\n\n" NOR, ob);
  message_vision(HIR "\n$N痛得几乎失去了知觉......\n\n" NOR, ob);
  ob->set_temp("no_move", 1);
  call_out("trapping", 20, ob, room);
}

void trapping(object ob, object room)
{
  if (!ob)
    return;

  if (!living(ob) || environment(ob) != this_object())
  {
    ob->delete_temp("no_move");
    return;
  }

  message_vision(HIY "\n僧兵们把$N从陷井里起了出来，丢出了少林寺！\n\n\n" NOR, ob);
  ob->move(__DIR__"shijie1");
  ob->delete_temp("no_move");
  room->set("exits/south", __DIR__"shulin"+(random(8)+6));
  room->set("exits/north", __DIR__"shulin"+(random(8)+6));
  room->set("exits/east", __DIR__"shulin"+(random(8)+6));
  room->set("exits/west", __DIR__"shulin"+(random(8)+6));
}