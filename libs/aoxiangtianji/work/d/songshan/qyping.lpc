inherit SMALLROOM;
inherit HILLROOM;
void create()
{
  set("short", "青云坪");
  set("long", @LONG
这里便是少室绝顶。极目望去，只见白云缕缕，如苍龙绕岭；
嵩山拔翠，似金刚擎天。山腰五道瀑布飞泻而下，石级蜿延曲折，
宛若一条长虫，游人纷纷其上，已如蚁蛭。
LONG );
  set("exits", ([
    "southdown" : __DIR__"shulin14",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "shaolin");
  setup();
}