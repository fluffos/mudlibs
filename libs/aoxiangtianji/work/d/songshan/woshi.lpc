#include <ansi.h>
inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "卧室");
  set("long", @LONG
卧房里只有一张竹制的矮床上面铺了半破烂的篾席。
后墙之上，有个破洞，被木板(muban)遮住了。
LONG );
  set("exits", ([
    "south" : __DIR__"xiaowu",
  ]));

  set("item_desc",([
     "muban"  : HIY "似乎可以从这里爬(climb)出去。\n" NOR,
  ]));

  set("no_clean_up", 0);
  setup();
}

void init()
{
  add_action("do_climb", ({"climb", "pa"}));
}

int do_climb(string arg)
{
  object me = this_player();
  if (! arg || arg != "dong")
    return notify_fail("你想爬什么？\n");
  write(HIG "\n你掀掉木板，很快爬出了洞口。\n\n" NOR);
  me->move(__DIR__"bamboo1");
  return 1;
}

