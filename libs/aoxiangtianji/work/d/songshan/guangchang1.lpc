#include <ansi.h>
inherit BIGROOM;
inherit LANDROOM;
void create()
{
   set("short", "广场");
   set("long", @LONG
这里是少林寺前的广场，整个广场由大块的青石铺成，极为
平坦。但因年代久远，都有些破损。丛丛小草从石板的缝隙中长
了出来。广场的周围都是密密的松树林，四角上各放了几块石碑，
字迹都甚为模糊。正前方黄墙碧瓦，飞檐翘檩，正中一道二丈来
宽，三丈来高的朱红杉木包铜大门。上方一块大匾，龙飞凤舞地
书着『少林寺』三个大字。边上立了块木牌(mupai)，寺前三三
两两的站着几个僧人。
LONG );
  set("exits", ([
    "east" : __DIR__"guangchang1e",
    "south" : __DIR__"shijie11",
    "west" : __DIR__"guangchang1w",
  ]));
  set("item_desc",([
    "mupai" : "少林寺乃清修之地，不接待外人！\n",
  ]));
  set("outdoors", "shaolin");
  setup();
}