inherit SMALLROOM;
inherit HILLROOM;
void create()
{
  set("short", "峻极禅院山门");
  set("long", @LONG
嵩山绝顶，古称 "峻极" 。这里是佛教大寺，西上
可以到达封禅台。
LONG );
  set("exits", ([
    "southdown" : __DIR__"shandao6",
    "northup"   : __DIR__"chanyuan",
    "westup"    : __DIR__"fengchantai",
  ]));
  set("outdoors", "songshan");
  set("no_clean_up", 0);
  setup();
}

