inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "山路");
  set ("long", @LONG
一条山路，路边鲜花盛开，四季不绝。两边松柏
滴翠，芝兰含香。到了此处，却见鲜花更加繁茂，许多
不知名的鲜花盛开在路边，团团簇簇。
LONG);
  set("exits", ([
    "southwest" : __DIR__"shanlu5",
    "northdown": __DIR__"shanlu3",
  ]));
  set("outdoors", 1);
  setup();
}