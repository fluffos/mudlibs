inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "山路");
  set ("long", @LONG
山路渐渐转入了一条山谷之中。两边峭壁夹立。云
烟在你眼底飘荡，伸手一抓，却又散开，轻轻的随绕着
你。到了此处，却见鲜花更加繁茂，许多不知名的鲜花
盛开在路边，团团簇簇。不远处，花丛掩映间，似乎有
个不大的山洞，透着些霞光。
LONG);
  set("exits", ([
    "west" : __DIR__"shanlu7",
    "eastup": __DIR__"shanlu5",
  ]));
  set("outdoors", 1);
  setup();
}