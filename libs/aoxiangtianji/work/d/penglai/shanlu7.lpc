inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "山路");
  set ("long", @LONG
一条并不宽阔的山涧(jian)隔断了去路。山涧对面，一个不大
的山洞显现出来。洞口鲜花含露，层层叠叠，把个洞口掩映得若明
若暗，格外幽雅。
LONG);
  set("exits", ([
    "east": __DIR__"shanlu6",
  ]));
  set("outdoors", 1);
  setup();
}

void init()
{
  add_action("do_jump",({"jump","tiao"}));
}

int do_jump(string arg)
{
  object me = this_player();
  object ridee;
  int sk;

  if (!arg || (arg != "jian" && arg != "shanjian"))
  {
    write("你要望哪儿跳？\n");
    return 1;
  }

  if (objectp(ridee = me->query_temp("is_riding")))
  {
    write("你还是先下了坐骑吧！\n");
    return 1;
  }

  message_vision("$N一咬牙，跃起往山涧对面的洞口跳了过去！\n",me);
  sk = me->query_skill("dodge");

  if (random(sk) < 80)
  {
    message_vision("$N显然没有办法跳过去，看来是对山涧宽度估计不足。\n",me);
    me->move(__DIR__"hyd-jiandi");
    me->receive_wound("kee",me->query("max_kee")/2);
    message_vision("$N从上面掉了下来，重重的摔在地上，转眼就晕了过去！\n",me);
    me->unconcious();
    return 1;
  }

  me->move(__DIR__"hyd-dongkou");
  message_vision("$N轻轻的跳了过来！\n",me);
  return 1;
}