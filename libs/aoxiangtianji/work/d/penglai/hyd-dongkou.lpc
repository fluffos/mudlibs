inherit SMALLROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "红颜洞下");
  set ("long", @LONG
红颜洞就在上面。这里仿佛是个花的世界，无数奇花异草
在山野间烂漫。
LONG);
  set("exits", ([
    "southup": __DIR__"hongyandong",
  ]));
  set("outdoors", 1);
  setup();
}

void init()
{
  add_action("do_jump",({"jump","tiao"}));
}

int do_jump(string arg)
{
  object me = this_player();
  object ridee;

  if (!arg || (arg != "jian" && arg != "shanjian"))
  {
    write("你要望哪儿跳？\n");
    return 1;
  }

  if (objectp(ridee = me->query_temp("is_riding")))
  {
    write("你还是先下了坐骑吧！\n");
    return 1;
  }

  message_vision("$N跃起往山涧对面跳了过去！\n",me);
  me->move(__DIR__"shanlu7");
  message_vision("$N轻轻的跳了过来！\n",me);
  return 1;
}