inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "薄命岩");
  set ("long", @LONG
一座山崖兀立高耸，佼佼不群。崖边一棵青松，
苍劲挺拔，直插白云之间。这里就是百花仙子隐
居的所在。崖下是百花谷，遍地是奇花异草，可
惜山势陡峭，轻身功夫不佳的如果贸然跃(jump)
下(down)，不免摔得骨断筋折。
LONG);
  set("exits", ([
    "enter": __DIR__"hongyandong",
  ]));
  set("outdoors", 1);
  setup();
}

void init()
{
  add_action("do_jump","jump");
}

int do_jump(string arg)
{
  object ridee;
  object me=this_player();
  int damage;
  string dest = sprintf(__DIR__"baihuagu%d%d",1+ random(4),random(5));
  if (!arg)
    return 0;
  if (arg != "down")
  {
    write("往哪儿跳？\n");
    return 1;
  }

  if (objectp(ridee = me->query_temp("is_riding")))
  {
    write("你还是先下了坐骑吧！\n");
    return 1;
  }

  message_vision("$N纵身往谷底跃下。\n",me);

  damage = 300 - me->query_skill("dodge",1);
  if (damage > 0)
    damage = random(damage);
  me->move(dest);
  if (!damage)
    message_vision("$N从悬崖上跳了下来，轻轻巧巧地落在地上，毫发未损。\n",me);
  else
  {
    me->receive_wound("kee",damage);
    message_vision("$N从悬崖上跳了下来，跌了个大跟斗。\n",me);
    COMBAT_D->report_status(me);
  }

  me->start_busy(1+random(2));
  return 1;
}

