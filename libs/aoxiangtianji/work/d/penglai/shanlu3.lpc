inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "山路");
  set ("long", @LONG
一条山路，路边鲜花盛开，四季不绝。两边松柏
滴翠，芝兰含香。一路走来，东西各出现了一条岔路。
LONG);
  set("exits", ([
    "westup": __DIR__"l-lu1",
    "eastup" : __DIR__"f-lu1",
    "southup" : __DIR__"shanlu4",
    "northeast": __DIR__"shanlu2",
  ]));
  set("outdoors", 1);
  setup();
}