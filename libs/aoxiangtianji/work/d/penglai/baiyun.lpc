inherit SMALLROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "白云洞");
  set ("long", @LONG
洞内云烟缭绕，叉口纷杂。
LONG);
  set("exits", ([
    "out" : __DIR__"undertree",
  ]));
  setup();
}

void init()
{
  add_action("do_look","look");
}

int do_look(string arg)
{
  if (!arg)
    return 0;
  else
  {
    write("满眼都是白云飞烟，洞内景色气象万千。\n");
  }

  return 1;
}		