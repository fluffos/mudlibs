#include <ansi.h>
inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "寿星洞");
  set ("long", @LONG
寿星洞前，左变一颗老松树，枝叶苍虬。右边一颗老柏树，
浓荫郁郁。洞口，一个老头手拿龙头拐杖，正乐呵呵的看着你
呢！
LONG);
  set("exits", ([
    "south": __DIR__"s-lu7",
  ]));
  set("outdoors", 1);
  set("objects", ([
    __DIR__"npc/shouxing" : 1,
  ]));

  setup();
}

void init()
{
  object where = this_object();
  object me = this_player();
  object shouxing = present("shou xing",where);
  int phase = NATURE_D->query_current_day_phase();
  if (phase > 0 && phase < 5)
    return;

  if (!playerp(me) ||
      (!wizardp(me) &&
       me->query("family/family_name") != "五庄观"))
    return;

  if (me->query("level") < 12)
    return;

  if (!objectp(shouxing))
    return;
  if (where->query("give_book"))
    return;
  me->set_temp("wzg/qx-book",1);
  remove_call_out("give_book");
  call_out("give_book",300,me,shouxing);
  where->set("give_book",me->query("id"));
}

void give_book(object me, object shouxing)
{
  object book;
  object where = this_object();
  int phase = NATURE_D->query_current_day_phase();
  if (phase > 0 && phase < 5)
    return;
  if (!objectp(me) || !living(me) || !objectp(shouxing) || !living(shouxing))
    return;
  if (!playerp(me) ||
      (!wizardp(me) &&
       me->query("family/family_name") != "五庄观"))
    return;
/*
  if (!playerp(me) || me->query("family/family_name") != "五庄观")
    return;
*/
  if (environment(me) != where ||
      environment(shouxing) != where)
    return;

  if (!where->query("give_book") ||
      where->query("give_book") != me->query("id"))
    return;

  message_vision(HIY"$N" HIY"突然说道，你看这星河灿烂，难道没有什么感悟吗？\n"NOR,shouxing);
  message_vision(HIY"$N" HIY"听此一问，不由得心中一动！\n"NOR,me);
  message_vision(HIY"$N呆呆的看了半天的星星，突然悟道，原来这星星的布局，有如此神妙之处啊！\n"NOR,me);
  message_vision(HIR"$N" HIR"哈哈大笑，对$n" HIR"说道，道友由此领悟，真是可喜可贺！\n"NOR,shouxing,me);
  message_vision(HIR"$N继续说道，我这里的这本书，就送给你吧！\n"NOR,shouxing);
  book = new("/d/obj/book/qx-book");
  book->move(me,1);
  book->set("owner",me->query("id"));
  tell_object(me,"你得到了一本书！\n");
  where->delete("give_book");
  me->delete_temp("wzg/qx-book");
  return;
}

int valid_leave(object me, string dir)
{
  me->delete_temp("wzg/qx-book");
  if (this_object()->query("give_book") == me->query("id"))
    this_object()->delete("give_book");
  return ::valid_leave(me,dir);
}

