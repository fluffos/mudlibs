#include <ansi.h>
#include "/d/qujing/wuzhuang/npc/wzg.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("寿星", ({"shou xing", "xing"}));
  set("title", "蓬莱三老");
  set("gender", "男性");
  set("long",
"霄汉中间一老人，手捧灵芝飞蔼绣。\n"
"葫芦藏蓄万年丹，宝篆名书千纪寿。\n"
"洞里乾坤任自由，壶中日月随成就。\n"
"遨游四海任清闲，散淡十洲容福胄。\n"
"曾赴蟠桃醉几遭，醒时名月还依旧。\n"
"长头大耳短身躯，南极之方称老寿。\n");
  set("attitude", "peaceful");
  set("class", "xian");
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set("max_kee", 3200);
  set("max_sen", 3200);
  set("force", 4400);
  set("max_force", 2200);
  set("mana", 4400);
  set("max_mana", 2200);
  set("force_factor", 110);
  set("mana_factor", 110);
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("staff", 200);
  set_skill("sword", 200);
  set_skill("whip", 200);

  set_skill("zhenyuan-force", 200);
  set_skill("taiyi", 200);
  set_skill("baguazhen", 200);
  set_skill("wuxing-quan", 200);
  set_skill("fumo-staff", 200);
  set_skill("qixing-sword", 200);
  set_skill("taixuan-whip", 200);
  set_skill("sanqing-fuchen", 120);

  map_skill("force", "zhenyuan-force");
  map_skill("spells", "taiyi");
  map_skill("dodge", "baguazhen");
  map_skill("unarmed", "wuxing-quan");
  map_skill("sword", "qixing-sword");
  map_skill("staff", "fumo-staff");
  map_skill("parry", "fumo-staff");
  map_skill("whip", "taixuan-whip");
  create_family("五庄观", 2, "弟子");
  setup();
  carry_object("/obj/cloth/baipao")->wear();
  carry_object("/d/penglai/obj/guai")->wield();
}

void die()
{
  if( environment() )
  {
    message("sound", "\n\n只听一声鹤鸣，寿星化作一道白光向天上直冲而去。。。\n\n"
                     "半空中有人哈哈笑了几声。。。\n\n", environment());
  }

  destruct(this_object());
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "五庄观")
  {
    command("say 我只收五庄观的弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 25)
  {
    command("say 你需要继续磨练啊！\n");
    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "xian")
    ob->set("class", "xian");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "五庄观")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我五庄观弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "xian")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是地仙中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 25)
  {
    command("say 你需要继续磨练才可以向我学习！\n");
    return 1;
  }

  return 0;
}

