});

string name;
void create()
{
  name=element_of(flowers);
  set_name(name+"仙子", ({ "hua xianzi","xianzi","xian" }) );
  set("long",@LONG
一位品貌秀丽，气质高雅的花仙子，浑身散发出一股异香，
既非冰麝，又非旎檀，似花香而非花香，时刻变换，竟有百
种香气。
LONG);
  set("gender", "女性");
  set("age", 20);
  set("str", 10+random(21));
  set("dex", 10+random(21));
  set("int", 10+random(21));
  set("cor", 10+random(21));
  set("spi", 10+random(21));
  set("con", 10+random(21));
  set("per", 10+random(21));
  set("combat_exp", 10000);
  set("daoxing", 10000);
  set_skill("force", 90);
  set_skill("spells", 90);
  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("parry", 90);
  set_skill("sword", 90);

  set_skill("moonforce",90);
  set_skill("moonshentong",90);
  set_skill("moondance",90);
  set_skill("baihua-zhang",90);
  set_skill("snowsword",90);

  map_skill("force","moonforce");
  map_skill("spells","moonshentong");
  map_skill("dodge","moondance");
  map_skill("unarmed","baihua-zhang");
  map_skill("parry","snowsword");
  map_skill("sword","snowsword");
  set("max_kee", 1500);
  set("max_sen", 1500);
  set("mana", 4000);
  set("max_mana", 1500);
  set("mana", 3000);
  set("mana_factor", 80);
  set("force", 3000);
  set("max_force", 1500);
  set("force_factor", 80);
  set("no_ji",1);
  set("no_cast",1);

  set("inquiry",([
    "花" : (: ask_flower :),
    "flower" : (: ask_flower :),
  ]));
  set_temp("apply/dodge", 80);
  set_temp("apply/attack", 80);
  set_temp("apply/defense", 80);
  set_temp("apply/armor", 100);

  set_temp("born_time", time());
  setup();
  carry_object("/obj/cloth/pinkskirt")->wear();
  carry_object("/obj/cloth/female-shoe")->wear();
  carry_object("/d/obj/weapon/sword/snow_sword")->wield();
}

void init()
{
  ::init();
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_cast", "cast");
  add_action("do_perform", "perform");
}

string ask_flower()
{
  object me = this_object();
  object who = this_player();

  if (me->is_busy() || me->is_fighting())
    return "正忙着呢！\n";

  if (who->is_busy() || who->is_fighting())
    return "你正忙着呢！\n";

  message_vision("$N抿嘴一笑，想要花吗？打赢了我就有！\n",me);
  call_out("fight_player",1,me,who);
  return "来吧！\n";
}

void fight_player(object me, object who)
{
  if (!me || !who || environment(me) != environment(who))
    return;
  command("fight " + who->query("id"));
}

int accept_fight(object who)
{
  object me;
  me = this_object();
  if (me->is_busy() || me->is_fighting())
  {
    tell_object(who,"正忙着呢！急什么！\n");
    return 0;
  }

  remove_call_out("check_fight");
  call_out("check_fight", 1, me, who);
  return 1;
}

void player_win (object me, object who)
{
  object flower;

  if (!me || !who || environment(me) != environment(who))
    return;
  me->remove_all_enemy();
  message_vision ("$N大惊失色：好武功！好武功！\n",me);
  flower = new("/d/obj/flower/hua");
  flower->set("baihuaniang",1);
  flower->move(me);
  command("give flower to " + who->query("id"));
  call_out ("huaxian_disappear",2,me);
}

void player_lose (object me, object who)
{
  if (!me || !who || environment(me) != environment(who))
    return;
  me->remove_all_enemy();
  message_vision ("$N一愣，扑哧笑了笑，轻轻的扶起了$n！\n",me,who);
  call_out ("huaxian_disappear",2,me);
}

void check_fight (object me, object who)
{
  int my_kee, whos_kee;
  int my_max_kee, whos_max_kee;
  if (!me || !who || environment(me) != environment(who))
    return;
  if (!me->is_fighting(who))
    return;

  my_kee = me->query("kee");
  whos_kee = who->query("kee");
  my_max_kee = me->query("max_kee");
  whos_max_kee = who->query("max_kee");
  if ((my_kee*100/my_max_kee) <= 50)
    player_win (me, who);
  else if ((whos_kee*100/whos_max_kee) <= 50)
    player_lose (me, who);
  if (me->is_fighting())
  {
    call_out ("check_fight",1,me,who);
    return;
  }

}

void huaxian_disappear (object me)
{
  if (objectp(me) && environment(me))
  {
    message_vision (CYN"$N" CYN"一转身，消失在了花丛中。\n"NOR,me);
    destruct (me);
  }

}

int do_cast(string arg)
{
  object who = this_player();
  object me = this_object();
  if(arg && present(arg,environment(me))!=me)
    return 0;
  message_vision ("$N吸口气，憋红了脸念了几声咒语。\n",who);
  return 0;
}

int do_perform(string arg)
{
  object who = this_player();
  object me = this_object();
  if(arg && present(arg,environment(me))!=me)
    return 0;
  message_vision ("$N眼前花影如画，什么厉害的招数都使不出来了。\n",who);
  return 0;
}

int do_steal(string arg)
{
  object who = this_player();
  object me = this_object();
  message_vision ("$N趁着黑暗伸出手……一不小心摸到仙子的长发。\n",who);
  message_vision("$N大叫，你敢耍流氓啊！\n",me);
  return 0;
}

int do_kill(string arg)
{
  object who = this_player();
  object me = this_object();
  if(arg && present(arg,environment(me))!=me) return 0;
  message_vision ("$N忽然眼露杀机，颤抖地喊不出来！\n",who);
  return 0;
}

void scan()
{
  ::scan();
  if (time() - query_temp("born_time") > 120 &&
     !is_fighting() && living(this_object()))
  {
    message_vision(CYN "$N一转身，消失在了花丛中。\n" NOR, this_object());
    destruct(this_object());
  }

  return;
}