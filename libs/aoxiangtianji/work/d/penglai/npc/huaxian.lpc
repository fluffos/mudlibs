#include <ansi.h>
inherit NPC;
string ask_flower();
string *flowers= ({
      HIR"桂花"NOR,
      HIR"腊梅"NOR,
      HIY"菊花"NOR,
      HIW"莲花"NOR,
      HIM"海棠"NOR,
      HIB"芍药"NOR,
      HIG"水仙"NOR,
      HIW"玉兰"NOR,
      HIR"杜鹃"NOR,
      HIG"兰花"NOR,
      HIM"牡丹"NOR,
      HIW"茉莉"NOR,
      HIB"瑞香"NOR,
      MAG"紫薇"NOR,
      HIR"山茶"NOR,
      HIM"碧桃"NOR,
      HIR"玫瑰"NOR,
      MAG"丁香"NOR,
      HIM"杏花"NOR,
      HIR"石榴花"NOR,
      HIM"月季"NOR,
      HIR"蔷薇"NOR,
      HIY"梨花"NOR,
      HIR"李花"NOR,
      HIW"木香"NOR,
      HIM"芙蓉"NOR,
      HIB"蓝菊"NOR,
      HIR"罂粟花"NOR,
      HIB"秋海棠"NOR,
      HIB"夜来香"NOR,
      HIY"昙花"NOR,
      HIY"葵花"NOR,
      HIG"苹花"NOR,
      HIG"菱花"NOR,
      HIG"荷花"NOR,
      HIG"灵芝"NOR,
