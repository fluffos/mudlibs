inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "山路");
  set ("long", @LONG
山路渐渐转入了一条山谷之中。两边峭壁夹立。云
烟在你眼底飘荡，伸手一抓，却又散开，轻轻的随绕着
你。到了此处，却见鲜花更加繁茂，许多不知名的鲜花
盛开在路边，团团簇簇。
LONG);
  set("exits", ([
    "westdown" : __DIR__"shanlu6",
    "northeast": __DIR__"shanlu4",
  ]));
  set("outdoors", 1);
  setup();
}