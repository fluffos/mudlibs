inherit SMALLROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "望海亭");
  set ("long", @LONG
半山间的一座小亭。亭中摆着几个石凳，这里是
蓬莱海岛中居住的神仙休息谈天之处。从这里可以欣赏
东海的海景。
LONG);
  set("exits", ([
    "southwest": __DIR__"s-lu5",
    "westdown" : __DIR__"seashore1",
    "eastup": __DIR__"s-lu3",
  ]));
  set("outdoors", 1);
  setup();
}