inherit BIGROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "白云洞外，松阴之下");
  set ("long", @LONG
一棵高有数丈的大松树如伞如盖遮住了天空，松树上垂挂着许
多荜萝葛藤，中见隐见些小花。松树下有一大石台，上面刻了
一个围棋盘，石台旁有三个石凳。数丈外有一石洞，洞前石碑
上刻着「白云洞」三个大字。
LONG);
  set("item_desc", ([
    "enter" : "洞中白云绕绕，什么也看不清楚。\n",
  ]));

  set("exits", ([
    "enter" : __DIR__"baiyun0",
    "southdown" : __DIR__"penglai",
    "westdown"  : __DIR__"s-lu1",
  ]));
  setup();
}