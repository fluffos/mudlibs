inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "涧底");
  set ("long", @LONG
涧底乱石遍地，并没有水流过。抬头看，山花茂密，
一条山路似乎就在上面。从上面，一条山滕(teng)垂了下来，
看来是用来帮助掉下来的人爬(pa)上去的。
LONG);
  set("item_desc", ([
     "teng" : "一条坚韧的山滕，看来可以拉(la)住，借此爬上去！\n",
  ]));

  setup();
}

void init()
{
  add_action("do_take",({"zhua","la"}));
  add_action("do_pa",({"pa","climb"}));
}

int do_take(string arg)
{
  object me = this_player();

  if (!arg || arg != "teng")
  {
    write("你要拉什么？\n");
    return 1;
  }

  message_vision("$N一把把山滕紧紧拉住！\n",me);
  me->set_temp("la_teng",1);
  return 1;
}

int do_pa(string arg)
{
  object me = this_player();
  object ridee;

  if (!arg || arg != "up")
    return notify_fail("你要往什么方向爬？\n");

  if (objectp(ridee = me->query_temp("is_riding")))
    return notify_fail("你还是先下了坐骑吧！\n");

  if (!me->query_temp("la_teng"))
  {
    message_vision("$N不顾一切的往上就爬，手脚并用，可惜沙土松软，转眼就掉了下来！\n");
    me->receive_wound("kee",me->query("max_kee")/3);
    message_vision("$N从上面掉了下来，重重的摔在地上，转眼就晕了过去！\n",me);
    me->unconcious();
    return 1;
  }

  message_vision("$N拉着山滕，不一会儿就爬了上去！\n",me);
  me->move(__DIR__"shanlu7");
  message_vision("$N从下面爬了上来！\n");
  me->delete_temp("la_teng");
  return 1;
}

