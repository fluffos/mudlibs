inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "石崖");
  set ("long", @LONG
小路到了尽头。前面是陡峭的石壁，边上是万丈的悬崖。
一条条的青滕(teng)在石壁上盘绕。抬头看看那石壁，在
半空中仿佛有些亮晶晶的东西。
LONG);
  set("exits", ([
    "east" : __DIR__"chs-road2",
  ]));

  set("item_desc", ([
     "teng" : "一条坚韧的青滕，看来可以拉(la)住，借此爬上去！\n",
  ]));

  set("outdoors", 1);
  set("chs",1);
  setup();
}

void init()
{
  add_action("do_take",({"zhua","la"}));
  add_action("do_pa",({"pa","climb"}));
}

int do_take(string arg)
{
  object me = this_player();

  if (!arg || arg != "teng")
  {
    write("你要拉什么？\n");
    return 1;
  }

  message_vision("$N一把把山滕紧紧拉住！\n",me);
  me->set_temp("la_teng",1);
  return 1;
}

int do_pa(string arg)
{
  object me = this_player();
  object ridee;
  object chs;

  if (!arg || arg != "up")
    return notify_fail("你要往什么方向爬？\n");

  if (objectp(ridee = me->query_temp("is_riding")))
    return notify_fail("你还是先下了坐骑吧！\n");

  if (!me->query_temp("la_teng"))
  {
    message_vision("$N不顾一切的往上就爬，手脚并用，可惜沙土松软，转眼就掉了下来！\n",me);
    me->receive_wound("kee",me->query("max_kee")/3);
    message_vision("$N从上面掉了下来，重重的摔在地上，转眼就晕了过去！\n",me);
    me->delete_temp("la_teng");
    me->unconcious();
    return 1;
  }

  if (me->query_skill("dodge",1) < 150)
  {
    message_vision("$N不顾一切的往上就爬，手脚并用，可惜似乎不够敏捷，转眼就掉了下来！\n",me);
    me->receive_wound("kee",me->query("max_kee")/3);
    message_vision("$N从上面掉了下来，重重的摔在地上，转眼就晕了过去！\n",me);
    me->delete_temp("la_teng");
    me->unconcious();
    return 1;
  }

  if (random(3))
  {
    message_vision("$N不顾一切的往上就爬，手脚并用，可惜那青滕似乎不够坚韧，“啪”的一声断了！\n",me);
    me->receive_wound("kee",me->query("max_kee")/3);
    message_vision("$N从上面掉了下来，重重的摔在地上，转眼就晕了过去！\n",me);
    me->delete_temp("la_teng");
    me->unconcious();
    return 1;
  }

  message_vision("$N拉着山滕，小心翼翼的爬到了半空中！\n",me);
  if (query("chs"))
  {
    tell_object(me,"你一眼就看到了那里有束亮晶晶的东西与众不同，赶紧一把抓在了手中！\n");
    chs = new("/d/item/obj/chanhs");
    chs->move(me,1);
    set("chs",0);
    remove_call_out("gen_chs");
    call_out("gen_chs",3600);
  }

  else
    tell_object(me,"可惜上面什么都没有了！\n");
  message_vision("$N在上面呆了一会儿，觉得实在是危险，赶紧从爬了上来！\n",me);
  me->delete_temp("la_teng");
  return 1;
}

void gen_chs()
{
  set("chs",1);
}

