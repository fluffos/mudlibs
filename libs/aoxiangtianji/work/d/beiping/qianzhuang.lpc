#include <ansi.h>
inherit BANK;
void create()
{
  set("short", "天下钱庄");
  set("long", @LONG
天下钱庄是北平府里最大的一所钱庄，已经有过百年的历史了，信誉相当
的好。钱庄的大门正对着一个高高的柜台，钱庄的老板正在柜台后面清理着
帐目，柜台左边的墙上挂着一个牌子(paizi)。
LONG );
  set("item_desc", ([
      "paizi":
HIG"本钱庄提供的服务有：\n"NOR
HIC"--------------------------------\n"NOR
HIG"check(chazhang)        查帐\n"NOR
HIG"check(chazhang qn)     查潜能\n"NOR
HIC"--------------------------------\n"NOR
HIG"deposit(cun)           存款\n"NOR
HIC"--------------------------------\n"NOR
HIG"withdraw(qu)           取款\n"NOR
HIC"--------------------------------\n"NOR
HIG"convert(duihuan)       兑换钱币\n"NOR
HIC"--------------------------------\n"NOR
HIG"qn                     潜能业务\n"NOR
HIC"--------------------------------\n"NOR
  ]) );
  set("exits", ([
    "south" : __DIR__"dongdajie",
  ]));
  set("no_beg", 1);
  set("objects", ([
    "/d/city/npc/tiegongji" : 1
  ]));
  setup();
}