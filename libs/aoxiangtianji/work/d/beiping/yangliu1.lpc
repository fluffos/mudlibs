inherit SMALLROOM;
inherit SANDROOM;
void create()
{
  set("short", "杨柳胡同");
  set("long", @LONG
这里是杨柳胡同的胡同口，深深的巷道朝着南边曲折的延伸下去，旁晚时
分，胡同口不远的西边炊烟渺渺，似是居住着几户人家。只见北方尘土飞扬，
马蹄声和吆喝声相互穿插，那里便是西大街。
LONG );
  set("exits", ([
    "north" : __DIR__"xidajie2",
    "south" : __DIR__"yangliu2",
    "west" : __DIR__"minju1",
  ]));
  set("objects", ([
    sprintf("/obj/npc/old%d",1+random(2)) : 1,
  ]));

  set("outdoors", "beijing");
  setup();
}

