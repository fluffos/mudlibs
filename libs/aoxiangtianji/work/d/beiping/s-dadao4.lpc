inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "大官道");
  set("long", @LONG
你走在一条尘土飞扬的大官道上。四周人来人往，非常热闹。
不时还有两三骑快马从身边飞驰而过，扬起一路尘埃。道路
两旁是整整齐齐的杨树林。此去往南是巍峨的太行山脉。
LONG );
  set("exits", ([
     "southup" : __DIR__"s-dadao5",
     "northeast" : __DIR__"s-dadao1",
  ]));
  set("objects",([
     "/obj/npc/qigai" : 1,
  ]));
  set("outdoors", "beijing");
  setup();
}

