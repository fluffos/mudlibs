inherit "/obj/npc/dangpu-npc";
void create()
{
  set_name("张德贵", ({ "zhang degui", "zhang", "dedui" }));
  set("title", "当铺老板");
  set("gender", "男性");
  set("age", 47);
  set("kee", 5000);
  set("max_kee", 5000);
  set("sen", 5000);
  set("max_sen", 5000);
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("rank_info/respect", "掌柜的");
  set("env/wimpy", 50);
  set_skill("parry", 60);
  set_skill("unarmed", 60);
  set_skill("dodge", 500);
  set_skill("feiyan-zoubi",500);
  map_skill("dodge", "feiyan-zoubi");
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}