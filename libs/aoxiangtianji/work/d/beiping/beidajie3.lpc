inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "北大街");
  set("long", @LONG
这是北平府的北大街，干净、宽敞、安静。双人合抱的杨树十步一株，
整齐的排在路的两边。西面和东面都是高高的围墙，南面通向城中心，
北面就是北城门了。
LONG );
  set("exits", ([
    "south" : __DIR__"beidajie2",
    "north" : __DIR__"beimen",
  ]));
  set("outdoors", "beiping");
  setup();
}

