inherit SMALLROOM;
inherit LANDROOM;
void create()
{
  set("short", "北平王府");
  set("long", @LONG
这里是曾经的北平王府。当年北平王罗艺，威镇北方，多次和南侵的北方铁骑
作战。而罗艺的儿子罗成，更是大名鼎鼎，是大唐开国的功臣之一，在抗击北
方强敌时，英勇捐躯了。如今的北平王府大门紧闭，门前荒草丛生。
LONG );
  set("exits", ([
    "south" : __DIR__"xidajie",
  ]));
  set("outdoors", "beijing");
  setup();
}

