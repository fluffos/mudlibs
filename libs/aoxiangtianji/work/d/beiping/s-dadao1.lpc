inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "大官道");
  set("long", @LONG
你走在一条尘土飞扬的大官道上。四周人来人往。挑担子的、
行商的、赶着大车的马夫熙熙攘攘，非常热闹。不时还有两
三骑快马从身边飞驰而过，扬起一路尘埃。道路两旁是整整
齐齐的杨树林。北边就是北平府的南门。
LONG );
  set("exits", ([
     "north"      : __DIR__"nanmen",
     "southeast" : __DIR__"s-dadao2",
     "southwest" : __DIR__"s-dadao4",
  ]));
  set("objects",([
     "/obj/npc/boy3" : 1,
  ]));
  set("outdoors", "beijing");
  setup();
}

