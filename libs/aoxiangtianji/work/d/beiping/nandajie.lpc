inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "南大街");
  set("long", @LONG
这里是北平的南大街，也是商业最繁华的地段，一眼望去只见街两旁
店铺林立，五颜六色的店招和旗帜在阳光的照耀下分外鲜明，街上行
人很是不少，东面是一家客店。西面是家当铺。
LONG );
  set("exits", ([
    "south" : __DIR__"nandajie2",
    "north" : __DIR__"center",
    "east"  : __DIR__"kedian",
    "west"  : __DIR__"dangpu",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "beiping");
  setup();
}

