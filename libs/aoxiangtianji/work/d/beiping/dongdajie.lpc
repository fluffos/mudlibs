inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "东大街");
  set("long", @LONG
这是北平府的东大街，同样的宽阔与干净，相比西大街的冷清要热闹多
了，街上人来人往，熙熙攘攘，几个小孩正在胡同口玩耍，南面有不少
人围在一起，路边有条狗正在追一只猫。北面有家钱庄。
LONG );
  set("exits", ([
    "west"  : __DIR__"center",
    "east"  : __DIR__"dongdajie2",
    "north" : __DIR__"qianzhuang",
  ]));
  set("objects", ([
    "/obj/npc/haoke" : 1,
    "/obj/npc/jianke" : 1,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "beiping");
  setup();
}

