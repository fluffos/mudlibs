inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "大驿道");
  set("long", @LONG
你走在一条尘土飞扬的大驿道上。四周人来人往。挑担子的、
行商的、赶着大车的马夫、四处周游的书生，熙熙攘攘，非常
热闹。不时还有两三骑快马从身边飞驰而过，扬起一路尘埃。
道路两旁是整整齐齐的杨树林。南边就是北平府的北门。
LONG );
  set("exits", ([
     "south"      : __DIR__"beimen",
     "northeast" : __DIR__"nroad2",
  ]));
  set("objects",([
     "/obj/npc/tiaofu" : 1,
  ]));
  set("outdoors", "beijing");
  setup();
}

