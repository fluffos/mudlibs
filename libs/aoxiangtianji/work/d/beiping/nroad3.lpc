inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "大驿道");
  set("long", @LONG
你走在一条尘土飞扬的大驿道上。四周人来人往。挑担子的、
行商的，赶着大车的马夫，熙熙攘攘，非常热闹。不时还有
两三骑快马从身边飞驰而过，扬起一路尘埃。道路两旁是整
整齐齐的杨树林。
LONG );
  set("exits", ([
     "northeast" : "/d/guanwai/laolongtou",
     "southwest" : __DIR__"nroad2",
  ]));
  set("objects",([
    sprintf("/obj/npc/shusheng%d",1+random(3)) : 1,
  ]));

  set("outdoors", "beijing");
  setup();
}

