inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "东大街");
  set("long", @LONG
这是北平府的东大街，同样的宽阔与干净，相比西大街的冷清要热闹多
了，街上人来人往，熙熙攘攘。
LONG );
  set("exits", ([
    "west"  : __DIR__"dongdajie",
    "east"  : __DIR__"dongdajie3",
    "north" : __DIR__"duchang",
  ]));
  set("objects", ([
    sprintf("/obj/npc/boy%d", 1+random(3)) : 1,
    sprintf("/obj/npc/old%d", 1+random(2)) : 1,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "beiping");
  setup();
}

