inherit NPC;
void create()
{
  set_name("龙婆", ({"long po"}));
  set("long","龙王的老婆，东海的太后．\n");
  set("gender", "女性");
  set("age", 26);
  set("per", 30);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 200000);
  set("daoxing", 200000);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("unarmed", 80);
  set_skill("dragonstep", 80);
  set_skill("dragonfight", 80);
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "dragonfight");
  set("force", 200);
  set("max_force", 200);
  set("force_factor", 3);
  setup();
  add_money("silver", 20);
  carry_object("/d/obj/armor/cloth/jinpao")->wear();
}