#include <ansi.h>
#include "eastsea.h"
inherit NPC;
inherit F_MASTER;
int give_me(object ob);
void create()
{
  set_name("鲸无敌", ({"jing wudi", "jing"}));
  set("long","身高八丈，膀大腰圆．号称东海第一勇士。"
             "水族需有他发的腰牌才能自由出入于水晶宫中。\n");
  set("gender", "男性");
  set("age", 56);
  set("title", "将军");
  set("per", 10);
  set("str", 35);
  set("con", 30);
  set("int", 20);

  set("max_kee", 3500);
  set("max_sen", 3500);
  set("force", 3200);
  set("max_force", 2000);
  set("force_factor", 80);
  set("mana", 3500);
  set("max_mana", 2000);
  set("mana_factor", 100);
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set("have", 3);
  create_family("东海龙宫", 2, "水族");
  set("inquiry", ([
    "腰牌": (: give_me :),
    "pai": (: give_me :),
  ]) );
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("dragonfight",120);
  set_skill("dragonforce", 200);
  set_skill("seashentong", 200);
  set_skill("dragonstep", 200);
  set_skill("feilong-zaitian", 200);
  set_skill("fork",200);
  set_skill("fengbo-fork",120);
  set_skill("wufeng-fork",200);
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "feilong-zaitian");
  map_skill("parry", "dingbo-fork");
  map_skill("fork","wufeng-fork");

  create_family("东海龙宫", 2, "水族");
  setup();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/d/obj/weapon/fork/gangcha")->wield();
  carry_object("/d/eastsea/obj/pai");
}

int give_me(object ob)
{
  object who, me,pai;
  who=this_player();
  me=this_object();
  if( (string)who->query("family/family_name")!="东海龙宫" )
  {
    if( (int)who->query_temp("pending/ask_time") >= 3)
    {
      message_vision("$N突然跳起，恶狠狠的瞪着$n说：看来你是不想活了！\n", me, who);
      command("kill " + who->query("id"));
      return 1;
    }

    message_vision("$N斜斜地瞟了$n一眼，说：此不足为外人道也！\n", me, who);
    who->add_temp("pending/ask_time", 1);
    return 1;
  }

  else
  {
    if( who->query("level") < 10 )
    {
      command("baobao " +who->query("id"));
      return 1;
    }

    if( (int)who->query("jing_time") > time() )
    {
      message_vision("$N摇了摇头：你刚才不是已经要过了吗？\n",me);
      return 1;
    }

    if(objectp(present("yao pai",who)))
    {
      message_vision("$N很疑惑地看着你说到：你身上不是已经有了吗。\n",me);
      return 1;
    }

    if( (int)me->query("have") )
    {
      command("nod "+who->query("id"));
      pai=new("/d/eastsea/obj/pai");
      if (objectp(pai) && pai->move(who))
      {
        pai->set("owner",who->query("id"));
        message_vision(CYN"$N拿出一只腰牌给$n。\n"NOR,me,who);
        me->add("have", -1);
      }

      else if (objectp(pai))
      {
        message_vision("可惜$N没有拿住，腰牌掉到了地上，不见了！\n",who);
        destruct(pai);
      }

      else
      	message_vision("可惜$N找了半天，也没有找到腰牌！\n",me);
      who->add_temp("pending/ask_time", 1);
      who->set("jing_time",time()+300);
      return 1;
    }

  }

  message_vision("$N对$n无奈的一伸手，说：今日腰牌已发完了，明日再来领吧。\n", me, who);
  return 1;
}

void attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((int)ob->query("level") <= 25)
  {
    command("say 你还是先打打基础吧！");
    return 0;
  }

  command("look "+ ob->query("id"));
  command("nod");
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "dragon")
    ob->set("class", "dragon");
  return;
}

int prevent_learn(object me, string skill)
{
  string myname = RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "东海龙宫")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我东海龙宫人，老夫所教恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "dragon")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我龙族，老夫所教恐怕不能理解。",myname));
    return 1;
  }

  if (me->query("level") <= 25)
  {
    command(sprintf("emote 皱了皱眉头，说道：%s还欠磨练，老夫所教恐怕不能理解。",
                  myname));
    return 1;
  }

  if (skill == "longzhan-yuye")
  {
    if (me->query_skill("longzhan-yuye",1) < 120)
    {
      command("say 这一招你的级别太低了，学不了！\n");
      return 1;
    }

  }
  return 0;
}

