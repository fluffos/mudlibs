inherit NPC;
string *first_name = ({ "青鳝", "赤鲤", "黄鲳", "白鲨", "紫鲭", "金鳌",
"银蛎", "乌鳅"});
string *name_words = ({ "力士"});
void create()
{
  string name;
  name = element_of(first_name);
  name += element_of(name_words);
  set_name(name, ({"li shi", "shi"}));
  set("gender", "男性");
  set("title", "宫前护卫");
  set("age", 20+random(5));
  set("per", 10);
  set("str", 25);
  set("attitude", "heroism");
  set("shen_type", 1);
  set("combat_exp", 100000);
  set("daoxing", 100000);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("unarmed", 80);
  set_skill("spells", 80);
  set_skill("force", 80);
  set_skill("fork", 80);
  set_skill("fengbo-fork", 80);
  set_skill("dragonfight", 80);
  set_skill("dragonforce", 80);
  set_skill("seashentong", 80);
  set_skill("dragonstep", 80);
  map_skill("fork", "fengbo-fork");
  map_skill("parry", "fengbo-fork");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("dodge", "dragonstep");
  set("force", 500);
  set("max_force", 300);
  set("force_factor",15);
  set("mana", 500);
  set("max_mana", 300);
  set("mana_factor", 15);
  set("max_kee", 800);
  set("max_sen", 800);
  setup();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/armor/shield/niupi")->wear();
  carry_object("/d/obj/weapon/fork/fork")->wield();
}

