inherit NPC;
string *first_name = ({ "花头", "金尾", "花皮", "绿背", "双头", "虎齿"});
string *name_words = ({ "龟", "鼋"});
void create()
{
  string name;
  name = element_of(first_name);
  name += element_of(name_words);
  set_name(name, ({ "beast" }) );
  set("race", "野兽");
  set("age", 20);
  set("long", "一只足有锅盖大小的怪龟。\n");
  set("str", 20);
  set("cor", 30);
  set("max_kee", 1900);
  set("max_sen", 1900);
  set("limbs", ({ "头部", "身体", "龟壳", "尾巴", "肚皮"}) );
  set("verbs", ({ "bite", "claw"}) );
  set("combat_exp", 150000+random(150000));
  set("daoxing", 150000+random(150000));
  set_skill("dodge", 60);
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_temp("apply/damage", 30);
  set_temp("apply/armor", 80);
  set_weight(500000);
  set("level", 1);
  setup();
}

void init()
{
  ::init();
  add_action("do_train", "train");
}

int do_train()
{
  object me,who;
  me =this_object();
  who=this_player();
  if(me->is_fighting())
    return notify_fail("这只海兽正在战斗。\n");
  if((string)who->query("family/family_name")!="东海龙宫")
    return notify_fail("什么？\n");
  message_vision("$N对$n大喊一声：孽畜，看你猖狂到几时！\n\n", who,me);
  message_vision("$N扑上来和$n扭打到一起。\n",me,who);
  me->kill_ob(who);
  who->kill_ob(me);
  COMBAT_D->do_attack(me, who, query_temp("weapon"));
  me->set("owner",who->query("id"));
  return 1;
}

void die()
{
  string owner;
  object owner_ob;
  owner = query("owner");
  if(!stringp(owner))
  {
    ::die();
    return;
  }

  owner_ob= find_player(owner);
  if (!objectp(owner_ob))
  {
    ::die();
    return;
  }
  if( (object)query_last_damage_from() != owner_ob )
  {
    ::die();
    return;
  }

  if (query("level") > 1)
    owner_ob->add_temp("dragonforce_practice", owner_ob->query_spi()*query("level"));
  else
    owner_ob->add_temp("dragonforce_practice", owner_ob->query_spi());
  message_vision("$N低头缩尾，以示降服。\n",this_object());
  destruct(this_object());
  return;
}