inherit "/d/eastsea/npc/beast1";
string *f_name = ({ "双头", "金睛", "青皮", "花斑"});
string *n_words = ({ "蛟","虬","螭"});
void create()
{
  string name;
  name = element_of(f_name);
  name += element_of(n_words);
  set_name(name, ({ "jiao" }) );
  set("race", "野兽");
  set("age", 20);
  set("attitude", "aggressive");
  set("long", "一只怪模怪样的海蛟。\n");
  set("str", 20);
  set("cor", 30);
  set("max_kee", 2500);
  set("max_sen", 2500);
  set("limbs", ({ "头部", "身体", "龟壳", "尾巴", "肚皮"}) );
  set("verbs", ({ "bite", "claw"}) );
  set("combat_exp", 800000+random(800000));
  set("daoxing", 800000+random(800000));
  set_skill("dodge", 180);
  set_skill("unarmed", 200);
  set_skill("parry", 180);
  set_temp("apply/damage", 80);
  set_temp("apply/armor", 150);
  set_weight(500000);
  set("level", 3);
  setup();
}