inherit "/d/eastsea/npc/beast1";
string *f_name = ({ "黑头", "花夹"});
string *n_words = ({ "虾","蟹"});
void create()
{
  string name;
  name = element_of(f_name);
  name += element_of(n_words);
  set_name(name, ({ "beast" }) );
  set("race", "野兽");
  set("age", 20);
  set("attitude", "aggressive");
  set("long", "一只怪模怪样的海底野兽。\n");
  set("str", 20);
  set("cor", 30);
  set("max_kee", 2200);
  set("max_sen", 2200);
  set("limbs", ({ "头部", "身体", "龟壳", "尾巴", "肚皮"}) );
  set("verbs", ({ "bite", "claw"}) );
  set("combat_exp", 500000+random(500000));
  set("daoxing", 500000+random(500000));
  set_skill("dodge", 120);
  set_skill("unarmed", 140);
  set_skill("parry", 140);
  set_temp("apply/damage", 50);
  set_temp("apply/armor", 100);
  set_weight(500000);
  set("level", 2);
  setup();
}