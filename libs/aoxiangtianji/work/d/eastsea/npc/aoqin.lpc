#include <ansi.h>
#include "eastsea.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("敖钦", ({"ao qin", "ao","longwang","wang"}));
  set("long","敖钦是南海的龙王，其兄弟分别掌管东，西，南，北四海。由余其"
             "水族众多，声势浩大，俨然独霸一方。\n");
  set("gender", "男性");
  set("age", 60);
  set("title", "南海龙王");
  set("class","dragon");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 3000000);
  set("daoxing", 3000000);
  set("rank_info/respect", "陛下");
  set("per", 20);
  set("str", 30);
  set("max_kee", 8000);
  set("max_sen", 8000);
  set("force", 6000);
  set("max_force", 3000);
  set("force_factor", 120);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 150);
  set_skill("literate", 300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("dragonforce", 300);
  set_skill("seashentong", 300);
  set_skill("dragonstep", 300);
  set_skill("dragonfight", 300);
  set_skill("sword",300);
  set_skill("tabo-sword",300);
  set_skill("chuixiao-jifa", 350);
  set_skill("bihai-chaosheng", 350);

  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "dragonfight");
  map_skill("parry", "tabo-sword");
  map_skill("fork","tabo-sword");
  map_skill("chuixiao-jifa","bihai-chaosheng");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
        (: cast_spell, "water" :),
        (: perform_action, "unarmed.sheshen" :),
  }) );

  create_family("东海龙宫", 1, "水族");
  set_temp("apply/armor",50);
  set_temp("apply/damage",25);
  setup();
  carry_object("/d/obj/armor/cloth/longpao")->wear();
}

int attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((int)ob->query("level") <= 32)
  {
    command("say 你还是先打打基础吧！");
    return 0;
  }

  if (!ob->query("family/can_bai/southsea"))
  {
    command("say 老夫从不无缘无故的收徒！\n");
    return 0;
  }

  if ((int)ob->query("obstacle/number") < 34)
  {
    command("say 你尚未取经圆满，我还不能收你！\n");
    return 0;
  }

  command("say 既然大哥推荐而来，少不得要费我番心思了！罢了，收了吧！\n");
  command("nod");
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "dragon")
    ob->set("class", "dragon");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "东海龙宫")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我龙宫人，老夫所教恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "dragon")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我龙族，老夫所教恐怕不能理解。",myname));
    return 1;
  }

  if (me->query("level") <= 32)
  {
    command(sprintf("emote 皱了皱眉头，说道：%s还欠磨练，老夫所教恐怕不能理解。",
                  myname));
    return 1;
  }

  if ( skill == "dragonfight" ||
       skill == "fengbo-fork")
  {
    if (!me->query("family/can_learn/"+skill))
    {
      command("say %s现在不能学这门技能！这门技能需要自行演练后，才可以学习！\n");
      return 1;
    }

  }
  return 0;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我龙宫的弟子！\n";

  if (me->query("class") != "dragon")
    return "你不是龙族！\n";

  switch (topic)
  {
    case "天外清音" :
    case "tian" :
      if (me->query("family/can_pfm/tian"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 800)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("tabo-sword",1) < 120)
        return "你的踏波奏萧剑修为不够，暂时无法领悟！\n";
      if (me->query_skill("dragonforce",1) < 120)
        return "你的龙神心法修为不够，暂时无法领悟！\n";
      message_vision("$N站起身来，在$n耳边悄悄的说了些什么。\n",master,me);
      message_vision("$N不禁心有所悟，点了点头！\n",me);
      me->set("family/can_pfm/tian",1);
      return "你学会了“天外清音”！\n";
      break;

    case "碧海潮生按玉箫" :
    case "碧海潮生" :
    case "bihai" :
       return MASTER_D->teach_pfm(me, this_object(),
             ([ "exert"    : "bihai",
                "name"   : "碧海潮生按玉箫",
                "sk1"     : "dragonforce",
                "lv1"     : 180,
                "sk2"     : "bihai-chaosheng",
                "lv2"     : 180,
                "sk3"     : "tabo-sword",
                "lv3"     : 180,
                "max_force" : 2500,
                "gongxian": 800,]));
       break;
  }

  return 0;
}

