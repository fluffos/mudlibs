#include <ansi.h>
#include "eastsea.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("鲤总兵", ({"li zongbing", "li", "zongbing"}));
  set("long","东海龙宫鲤总兵。\n");
  set("gender", "男性");
  set("age", 50);
  set("per", 15);
  set("str", 25);
  set("con", 25);
  set("cps", 25);
  set("attitude", "heroism");
  set("shen_type", 1);
  set("max_kee", 1500);
  set("max_sen", 1500);
  set("force", 2000);
  set("max_force", 1200);
  set("force_factor", 30);
  set("mana", 2000);
  set("max_mana", 1200);
  set("mana_factor", 60);
  set("combat_exp", 800000);
  set("daoxing", 800000);
  set_skill("literate", 150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("dragonforce", 150);
  set_skill("seashentong", 150);
  set_skill("dragonstep", 150);
  set_skill("longzhan-yuye", 150);
  set_skill("fork",150);
  set_skill("wufeng-fork",150);
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "longzhan-yuye");
  map_skill("parry", "dingbo-fork");
  map_skill("fork","wufeng-fork");

  create_family("东海龙宫", 3, "水族");
  setup();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/d/obj/weapon/fork/gangcha")->wield();
}

void attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((int)ob->query("level") <= 15)
  {
    command("say 你还是先打打基础吧！");
    return 0;
  }

  command("look "+ ob->query("id"));
  command("nod");
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "dragon")
    ob->set("class", "dragon");
  return;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "东海龙宫")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我东海龙宫人，老夫所教恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "dragon")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我龙族，老夫所教恐怕不能理解。",myname));
    return 1;
  }

  if (me->query("level") < 15)
  {
    command(sprintf("emote 皱了皱眉头，说道：%s还欠磨练，老夫所教恐怕不能理解。",
                  myname));
    return 1;
  }

  if (skill == "longzhan-yuye")
  {
    if (me->query_skill("longzhan-yuye",1) < 80)
    {
      command("say 这一招你的级别太低了，学不了！\n");
      return 1;
    }

  }
  return 0;
}

