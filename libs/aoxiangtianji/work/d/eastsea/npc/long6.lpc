#include <skill.h>
inherit NPC;
void create()
{
  set_name("饕餮",({"tao tie","tao","tie","long","taotie","dragon"}));
  set("long","龙生九子不成龙，各有所好：饕餮乃第六子，平生好食。\n");
  set("gender", "男性");
  set("age", 28);
  set("title", "龙王九子之");
  set("class","dragon");
  set("attitude", "peaceful");
  set("max_kee", 2000);
  set("max_sen", 2000);
  set("force", 900);
  set("max_force", 900);
  set("force_factor", 60);
  set("max_mana", 900);
  set("mana", 900);
  set("mana_factor",30);
  set("str",30);
  set("con",30);
  set("per",10+random(10));
  set("bellicosity",500);
  set("cor",30);
  set("combat_exp", 900000+random(100000));
  set("daoxing", 900000+random(100000));
  set_skill("unarmed", 140);
  set_skill("dodge", 150);
  set_skill("force", 150);
  set_skill("parry", 140);
  set_skill("staff", 150);
  set_skill("spells", 120);
  set_skill("seashentong", 100);
  set_skill("dragonfight", 130);
  set_skill("dragonforce", 120);
  set_skill("pudu-staff", 150);
  set_skill("dragonstep", 150);
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("staff","pudu-staff");
  map_skill("parry", "pudu-staff");
  map_skill("dodge", "dragonstep");
  set("nkgain", 400);
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: cast_spell, "powerup" :),
    "饕餮喃喃道：饿了，饿了，该找点东西吃了。\n",
  }) );
  setup();
  carry_object("/d/obj/armor/armor/yinjia")->wear();
  carry_object("/d/eastsea/obj/dragonstaff")->wield();
  carry_object("/d/eastsea/obj/longzhu6");
}

int accept_fight(object me)
{
  command("consider "+me->query("id"));
  command("jealous");
  command("grin");
  command("say 正好我饿了，吃的就送上门来了！");
  command("kill "+me->query("id"));
  return 1;
}

