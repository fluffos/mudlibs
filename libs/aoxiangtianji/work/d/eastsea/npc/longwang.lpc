#include <ansi.h>
#include "eastsea.h"
inherit NPC;
inherit F_MASTER;
int donghai_quest(object who);
string ask_rank();

void create()
{
  set_name("敖广", ({"ao guang", "ao","guang","longwang","wang"}));
  set("long","敖广是东海的龙王，其兄弟分别掌管东，西，南，北四海。由余其"
             "水族众多，声势浩大，俨然独霸一方。\n");
  set("gender", "男性");
  set("age", 66);
  set("title", "东海龙王");
  set("class","dragon");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 3000000);
  set("daoxing", 3000000);
  set("rank_info/respect", "陛下");
  set("per", 20);
  set("str", 30);
  set("max_kee", 8000);
  set("max_sen", 8000);
  set("force", 6000);
  set("max_force", 3000);
  set("force_factor", 120);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 150);
  set_skill("literate", 300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("medical",300);
  set_skill("sea-yishu",300);
  map_skill("medical","sea-yishu");
  set_skill("dragonforce", 300);
  set_skill("seashentong", 300);
  set_skill("dragonstep", 300);
  set_skill("dragonfight", 300);
  set_skill("fork",300);
  set_skill("fengbo-fork",300);
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "dragonfight");
  map_skill("parry", "fengbo-fork");
  map_skill("fork","fengbo-fork");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
        (: cast_spell, "water" :),
        (: perform_action, "unarmed.sheshen" :),
  }) );

  set("inquiry", ([
    "职位"    : (: ask_rank :),
    "兵器": (: donghai_quest :),
    "weapon": (: donghai_quest :),
  ]) );
  create_family("东海龙宫", 1, "水族");
  set_temp("apply/armor",50);
  set_temp("apply/damage",25);
  setup();
  carry_object("/d/obj/armor/cloth/longpao")->wear();
}

int attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((int)ob->query("level") <= 32)
  {
    command("say 你还是先打打基础吧！");
    return 0;
  }

  if ((int)ob->query("obstacle/number") < 34)
  {
    command("say 你尚未取经圆满，我还不能收你！\n");
    return 0;
  }

  command("look "+ ob->query("id"));
  command("nod");
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "dragon")
    ob->set("class", "dragon");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "东海龙宫")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我东海龙宫人，老夫所教恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "dragon")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我龙族，老夫所教恐怕不能理解。",myname));
    return 1;
  }

  if (me->query("level") <= 32)
  {
    command(sprintf("emote 皱了皱眉头，说道：%s还欠磨练，老夫所教恐怕不能理解。",
                  myname));
    return 1;
  }

  if (skill == "fengbo-fork" ||
      skill == "dragonfight")
  {
    if (!me->query("family/can_learn/"+skill))
    {
      command("say %s现在不能学这门技能！这门技能需要自行演练后，才可以学习！\n");
      return 1;
    }

  }
  return 0;
}

int donghai_quest(object who)
{
  object me=this_object();
  object fighter;
  string weapon_name,weapon_id,weapon_unit,temp_flag;
  who=this_player();
  if (who->query("dntg/donghai")=="done")
  {
    message_vision("$N面色惨淡，不情愿地说：“那神兵还在吗？”\n",this_object());
    return 1;
  }

  if ((int)who->query("dntg/number") != 1)
  {
    command("say 你是何方神圣，也敢跑到我龙宫来索要宝物！\n");
    return 1;
  }

  if (
      who->query("dntg/donghai") == "begin"
      || who->query("dntg/donghai") == "da kan dao"
      || who->query("dntg/donghai") == "jiu gu cha"
      || who->query("dntg/donghai") == "mei hua chui"
     )
  {
    if (who->query("dntg/donghai") == "begin")
    {
      weapon_name="大砍刀";
      weapon_id="da kan dao";
      weapon_unit="柄";
      temp_flag="try_dao";
    }

    if (who->query("dntg/donghai") == "da kan dao")
    {
      weapon_name="九股叉";
      weapon_id="jiu gu cha";
      weapon_unit="支";
      temp_flag="try_cha";
    }

    if (who->query("dntg/donghai") == "jiu gu cha")
    {
      weapon_name="梅花锤";
      weapon_id="mei hua chui";
      weapon_unit="对";
      temp_flag="try_chui";
    }

    if (who->query("dntg/donghai") == "mei hua chui")
    {
      weapon_name="画杆戟";
      weapon_id="hua gan ji";
      weapon_unit="柄";
      temp_flag="try_ji";
    }

    if (present(weapon_id, this_player()) && present("ye cha", environment()))
       message_vision("龙王道：您先拿这"+weapon_name+"和夜叉练练吧！\n",me);
    else if (present(weapon_id, environment()) && present("ye cha", environment()))
       message_vision("龙王道：您先拿这"+weapon_name+"和夜叉练练吧！\n",me);
    else if (present(weapon_id, this_player()) || present(weapon_id, environment()))
    {
      message_vision("东海龙王说道：让我找个人先陪您练练？\n",me);
      message_vision("东海龙王一招手，一个夜叉走了过来。\n",me);
      fighter = new ("/d/dntg/donghai/npc/fighter");
      fighter->move(environment(me));
    }

    else if (present("ye cha", environment()))
       message_vision("龙王道：不知那"+weapon_name+"被谁拿去了！\n",me);
    else
    {
      message_vision("$N连忙起身说道："+RANK_D->query_respect(who)+"稍侯，待我想想？\n",me,who);
      message_vision("我这龙宫中有"+weapon_unit+weapon_name+"还凑合着能使，"+RANK_D->query_respect(who)+"若不嫌弃，就送与"+RANK_D->query_respect(who)+"用吧！\n",who);
      who->set_temp("dntg/donghai",temp_flag);
      call_out ("fight_quest",2,who);
    }

    return 1;
  }

  else if (who->query("dntg/donghai") == "hua gan ji" )
  {
    me->command("consider");
    message_vision("从后宫跑来一个龙婆，在龙王耳边小声说了几句话。\n",me);
    call_out ("sendto_maze",3,who);
    return 1;
  }

  command("nod");
  message_vision("$N懒洋洋的说：“要兵器啊？傲来国有的是，去那里弄些吧。”\n",me);
  message_vision("$N顿了顿，又说：“我龙宫的兵器，谅你们这些凡夫俗子也使不了。”\n",me);
  command("wave");
  return 1;
}

void fight_quest (object who)
{
  object me=this_object();
  object fighter,fa_bao;
  string weapon_name,weapon_unit;
  if (who->query("dntg/donghai") == "begin")
  {
    weapon_name="大砍刀";
    fa_bao = new ("/d/dntg/donghai/obj/dakandao");
    weapon_unit="柄";
  }

  if (who->query("dntg/donghai") == "da kan dao")
  {
    weapon_name="九股叉";
    fa_bao = new ("/d/dntg/donghai/obj/jiugucha");
    weapon_unit="支";
  }

  if (who->query("dntg/donghai") == "jiu gu cha")
  {
    weapon_name="梅花锤";
    fa_bao = new ("/d/dntg/donghai/obj/meihuachui");
    weapon_unit="对";
  }

  if (who->query("dntg/donghai") == "mei hua chui")
  {
    weapon_name="画杆戟";
    fa_bao = new ("/d/dntg/donghai/obj/huaganji");
    weapon_unit="柄";
  }

  message_vision("东海龙王一招手，一个夜叉抬过一"+weapon_unit+weapon_name+"。\n",me);
  fighter = new ("/d/dntg/donghai/npc/fighter");
  fighter->move(environment(me));
  fa_bao->move(environment(me));
  message_vision("东海龙王说道：＂要我要和我的手下先练练？＂\n",me);
}

void sendto_maze (object who)
{
  object me=this_object();
  message_vision("$N说道：" + RANK_D->query_respect(who) +
            "武功盖世，可到后面的海藏中试一试定海神针铁。\n",me,who);
  call_out ("send_maze",3,who);
}

void send_maze (object who)
{
  object me=this_object();
  message_vision("说着，东海龙王把$N送到了一个地方。\n",who);
  who->move("/d/dntg/donghai/haidimigong");
  message_vision("$N一拱手道：" + RANK_D->query_respect(who)
               + "向前走即可看到那神铁，恕老夫不奉陪了。\n",me,who);
  message_vision("说罢，龙王转身回宫了。\n",me);
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我龙宫的弟子！\n";

  if (me->query("class") != "dragon")
    return "你不是龙族！\n";

  switch (topic)
  {
    case "历练" :
    case "历炼" :
    case "锻炼" :
      return QUEST_D->accept_ask(master, me, topic);
      break;
//wufeng-fork
    case "无风海啸" :
    case "haixiao"  :
      if (me->query("family/can_pfm/haixiao"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("wufeng-fork",1) < 80 && me->query_skill("fengbo-fork",1) < 80)
        return "你的无风叉修为不够，暂时无法领悟！\n";
      if (me->query_skill("dragonforce",1) < 80)
        return "你的龙神心法修为不够，暂时无法领悟！\n";
      message_vision("$N微微一笑，在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁会心一笑！\n",me);
      me->set("family/can_pfm/haixiao",1);
      return "你学会了“无风海啸”！\n";
      break;
//dingbo-fork
    case "碧波浪涌" :
    case "bibo"    :
      if (me->query("family/can_pfm/bibo"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("dingbo-fork",1) < 120 && me->query_skill("fengbo-fork",1) < 120)
        return "你的定波叉修为不够，暂时无法领悟！\n";
      if (me->query_skill("dragonforce",1) < 120)
        return "你的龙神心法修为不够，暂时无法领悟！\n";
      message_vision("$N微微一笑，在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/bibo",1);
      return "你学会了“碧波浪涌”！\n";
      break;

//fengbo-fork
    case "无尽风波" :
    case "fengbo"  :
       return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"    : "fengbo",
                "name"   : "无尽风波",
                "sk1"     : "fengbo-fork",
                "lv1"     : 150,
                "sk2"     : "dragonforce",
                "lv2"     : 150,
                "gongxian": 500,]));
       break;
//dragonfight
    case "雷霆一击" :
    case "lei" :
      if (me->query("family/can_pfm/lei"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 800)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("dragonfight",1) < 100)
        return "你的定波叉修为不够，暂时无法领悟！\n";
      if (me->query_skill("dragonforce",1) < 100)
        return "你的龙神心法修为不够，暂时无法领悟！\n";
      message_vision("$N站起身来，在$n面前推演了一番。\n",master,me);
      message_vision("$N不禁心有所悟，点了点头！\n",me);
      me->set("family/can_pfm/lei",1);
      return "你学会了“雷霆一击”！\n";
      break;

    case "舍身技" :
    case "sheshen" :
       return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"    : "sheshen",
                "name"   : "舍身技",
                "sk1"     : "dragonfight",
                "lv1"     : 120,
                "sk2"     : "dragonforce",
                "lv2"     : 120,
                "max_force" : 1800,
                "gongxian": 500,]));
       break;
    case "龙翔天下" :
    case "long" :
       return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"    : "long",
                "name"   : "龙翔天下",
                "sk1"     : "dragonfight",
                "lv1"     : 180,
                "sk2"     : "dragonforce",
                "lv2"     : 180,
                "max_force" : 2500,
                "gongxian": 800,]));
       break;
//dragonforce
    case "碧海龙吟" :
    case "roar" :
      if (me->query("family/can_exert/roar"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 800)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("dragonforce",1) < 150)
        return "你的龙神心法修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 2000)
        return "你的内力修为不够，暂时无法领悟！\n";

      message_vision("$N哈哈一笑，突然纵声长啸，$n只觉得双耳轰鸣，头痛似裂。\n",master,me);
      message_vision("$N慢慢收声，双眼炯炯，钉住$n看了还一会！\n",master,me);
      message_vision("$N一怔，不禁心有所悟，点了点头！\n",me);
      me->set("family/can_exert/roar",1);
      return "你学会了“碧海龙吟”！\n";
      break;
//seashentong
    case "龙神" :
    case "water" :
      if (me->query("family/can_cast/water"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("seashentong",1) < 100)
        return "你的碧海神通修为不够，暂时无法领悟！\n";
      if (me->query("max_mana") < 1200)
        return "你的法力修为不够，暂时无法领悟！\n";

      message_vision("$N点了点头，在$n耳朵边上说了几句。\n",master,me);
      message_vision("$N一怔，不禁心有所悟，点了点头！\n",me);
      me->set("family/can_cast/water",1);
      return "你学会了“龙神”！\n";
      break;
      case "南海" :
      case "southsea" :
        if (me->query("family/can_bai/southsea"))
          return "我不是已经推荐过你了吗？\n";
        if (me->query("family/family_faith") < 300)
          return "你先安心为本门效力吧！\n";
        message_vision("$N呵呵大笑，那南海龙宫，确实也有不少值得学习之处！\n");
        me->set("family/can_bai/southsea",1);
        return "你这就去吧，我自会告诉南海龙王，给予帮助的！\n";
      case "北海" :
      case "northsea" :
        if (me->query("family/can_bai/northsea"))
          return "我不是已经推荐过你了吗？\n";
        if (me->query("family/family_faith") < 300)
          return "你先安心为本门效力吧！\n";
        message_vision("$N呵呵大笑，那北海龙宫，确实也有不少值得学习之处！\n");
        me->set("family/can_bai/northsea",1);
        return "你这就去吧，我自会告诉北海龙王，给予帮助的！\n";
      case "西海" :
      case "westsea" :
        if (me->query("family/can_bai/westsea"))
          return "我不是已经推荐过你了吗？\n";
        if (me->query("family/family_faith") < 300)
          return "你先安心为本门效力吧！\n";
        message_vision("$N呵呵大笑，那西海龙宫，确实也有不少值得学习之处！\n");
        me->set("family/can_bai/westsea",1);
        return "你这就去吧，我自会告诉西海龙王，给予帮助的！\n";
  }

  return 0;
}

string ask_rank()
{
  object master = this_object();
  object who = this_player();
  int t = time();

  if (who->is_busy() || who->is_fighting())
    return "你正忙着呢！\n";

  if (t - (int)who->query("last_ask_rank") < 7200)
    return "你不是刚刚问过了吗？\n";

  if (!RANK_D->re_title(master,who))
    return "你无法从我这里获得称号！\n";

  who->set("last_ask_rank",t);
  who->start_busy(1);
  return sprintf("%s 点了点头！\n",master->name());
}

