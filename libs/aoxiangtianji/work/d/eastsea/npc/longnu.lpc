#include <ansi.h>
#include "eastsea.h"
inherit NPC;
inherit F_MASTER;
string ask_unarmed();
void create()
{
  set_name("龙女", ({"long nu","gongzhu","long","princess"}));
  set("long","紫云宫主人，龙王的女儿．\n");
  set("gender", "女性");
  set("age", 20);
  set("int", 25+random(5));
  set("title", "紫云公主");
  set("attitude", "peaceful");
  set("combat_exp", 350000);
  set("daoxing", 350000);
  set("rank_info/respect", "公主殿下");
  set("class","dragon");
  set("per", 30);
  set("max_kee", 900);
  set("max_sen", 700);
  set("force", 1500);
  set("max_force", 800);
  set("force_factor", 40);
  set("max_mana", 700);
  set("mana", 1400);
  set("mana_factor", 30);
  set("inquiry", ([
    "飞龙在天": (: ask_unarmed :),
    "龙神搏击": (: ask_unarmed :),
  ]) );
  set_skill("literate", 90);
  set_skill("force", 90);
  set_skill("spells", 90);
  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("parry", 90);
  set_skill("dragonforce", 90);
  set_skill("fork", 90);
  set_skill("seashentong", 90);
  set_skill("dragonstep", 90);
  set_skill("feilong-zaitian", 90);
  set_skill("dingbo-fork", 90);
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "feilong-zaitian");
  map_skill("fork", "dingbo-fork");
  map_skill("parry", "dingbo-fork");
  create_family("东海龙宫", 4, "水族");
  setup();
  carry_object("/obj/cloth/pinkskirt")->wear();
  carry_object("/d/obj/weapon/fork/yincha")->wield();
}

int attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
/*
  if( (string)ob->query("family/family_name") == "东海龙宫")
  {
    command("blush");
    command("say 大家同门中人。。。！\n");
    return 0;
  }

*/
  command("jump");
  command("say 我又多了一个弟子耶！\n");
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "dragon")
    ob->set("class", "dragon");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "东海龙宫")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我东海龙宫人，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "dragon")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我龙族，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((skill == "feilong-zaitian") && !me->query("family/can_learn/dragonfight1"))
  {
    command("say 这一招可不是那么容易就可以学的！\n");
    return 1;
  }
  return 0;
}

string ask_unarmed()
{
  command("xixi");
  command("say 想学这一招？先接我三掌。\n");
  this_player(1)->add_temp("pending/sea/elongnu_hit", 1);
  return "你可愿意一试？(yuanyi)";
}

void init()
{
  ::init();
  add_action("do_agree", "yuanyi");
  add_action("do_agree", "agree");
}

int do_agree(string arg)
{
  object me, npc, ob;
  string myname;
  int my_max, my_kee;
  me = this_player(1);
  npc = this_object();
  if (!present(me, environment()))
    return 0;

  if (!me->query_temp("pending/sea/elongnu_hit"))
    return 0;
  if (npc->is_busy())
    return notify_fail("她正忙着呢！\n");

  if (npc->query_temp("no_move"))
    npc->delete_temp("no_move");

  myname = me->name();
  my_max = me->query("max_kee");

  me->delete_temp("pending/sea/elongnu_hit");

  npc->set("force", 2*query("max_force"));
  npc->set("force_factor", 40);
  ob = npc->query_temp("weapon");
  if (!objectp(ob))
    ob = npc->query_temp("secondary_weapon");

  if (objectp(ob))
  {
    command(sprintf("unwield %s",ob->query("id")));
  }

  npc->set_temp("ignore_dis",1);
  command("say 第一招！\n");
  COMBAT_D->do_attack(npc, me);
  my_kee = me->query("kee");
  if(my_kee < 0
   || my_kee < my_max/3
   || !present(me, environment()))
  {
    command(sprintf("say 唉，%s一掌都经不住！",myname));
    return 1;
  }

  command("say 第二招！\n");
  COMBAT_D->do_attack(npc, me);

  my_kee = me->query("kee");
  if(my_kee < 0
   || my_kee < my_max/3
   || !present(me, environment()))
  {
    command(sprintf("say 可惜，%s抗住第一下已经不容易了！",myname));
    return 1;
  }

  command("say 居然挺过了两次！最后一招\n");
  COMBAT_D->do_attack(npc, me);
  npc->delete_temp("ignore_dis");
  my_kee = me->query("kee");
  if(my_kee < 0
   || my_kee < my_max/3
   || !present(me, environment()))
  {
    command(sprintf("say 可惜，%s多抗一下就好了。\n",myname));
    return 1;
  }

  me->set("family/can_learn/dragonfight1", 1);
  command(sprintf("say %s果然是个人物。\n",myname));
  if (objectp(ob))
    command(sprintf("wield %s", ob->query("id")));
  return 1;
}

