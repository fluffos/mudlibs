#include <ansi.h>
#include "eastsea.h"
inherit NPC;
inherit F_MASTER;
int give_me(object ob);
void create()
{
  set_name("龟八斗", ({"gui badou", "gui"}));
  set("long","海底的大才子，以才智过人著称，并且会画金龙符。\n");
  set("gender", "男性");
  set("age", 56);
  set("title", "军师");
  set("per", 10);
  set("attitude", "peaceful");
  set("max_kee", 2000);
  set("max_sen", 2000);
  set("force", 3200);
  set("max_force", 2000);
  set("force_factor", 80);
  set("mana", 3500);
  set("max_mana", 2000);
  set("mana_factor", 100);
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set("inquiry", ([
    "金龙符": (: give_me :),
    "fu": (: give_me :),
  ]) );
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("medical",200);
  set_skill("dragonforce", 200);
  set_skill("seashentong", 200);
  set_skill("dragonstep", 200);
  set_skill("feilong-zaitian", 200);
  set_skill("fork",200);
  set_skill("dingbo-fork",200);
  set_skill("sea-yishu",120);
  set_skill("fengbo-fork",200);
  set("dragonfight",120);
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "feilong-zaitian");
  map_skill("parry", "dingbo-fork");
  map_skill("fork","dingbo-fork");
  map_skill("medical","sea-yishu");

  create_family("东海龙宫", 2, "水族");
  setup();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/d/obj/weapon/fork/gangcha")->wield();
}

int give_me(object ob)
{
  object who, me;
  who=this_player(1);
  me=this_object();
  if( (string)who->query("family/family_name") != "东海龙宫" )
  {
    message_vision("$N斜斜地瞟了$n一眼，说：此不足为外人道也！\n", me, who);
    return 1;
  }

  if ((int)me->query("number") >= 5)
    return notify_fail("龟八斗把手一伸，今天写太多了，明儿个再说吧！\n");
  ob=new("/d/eastsea/obj/fu");
  ob->move(who);
  me->add("number",1);
  message_vision("$N拿出张符纸来，画出金龙，递给了$n。\n", me, who);
  return 1;
}

void attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((int)ob->query("level") <= 25)
  {
    command("say 你还是先打打基础吧！");
    return 0;
  }

  command("look "+ ob->query("id"));
  command("nod");
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "dragon")
    ob->set("class", "dragon");
  return;
}

int prevent_learn(object me, string skill)
{
  string myname = RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "东海龙宫")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我东海龙宫人，老夫所教恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "dragon")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我龙族，老夫所教恐怕不能理解。",myname));
    return 1;
  }

  if (me->query("level") <= 25)
  {
    command(sprintf("emote 皱了皱眉头，说道：%s还欠磨练，老夫所教恐怕不能理解。",
                  myname));
    return 1;
  }

  if (skill == "feilong-zaitian")
  {
    if (me->query_skill("feilong-zaitian",1) < 120)
    {
      command("say 这一招你的级别太低了，学不了！\n");
      return 1;
    }

  }
  return 0;
}

