#include <ansi.h>
#include "eastsea.h"
inherit NPC;
inherit F_MASTER;
string ask_unarmed();
void create()
{
  set_name("西海龙太子", ({"west taizi","taizi","long","prince"}));
  set("long","西海龙王的大太子．\n");
  set("gender", "男性");
  set("int", 25);
  set("age", 26);
  set("title", "龙宫太子");
  set("attitude", "peaceful");
  set("combat_exp", 600000);
  set("daoxing", 600000);
  set("rank_info/respect", "殿下");
  set("class","dragon");
  set("per", 30);
  set("max_kee", 1000);
  set("max_sen", 800);
  set("force", 1800);
  set("max_force", 1000);
  set("force_factor", 50);
  set("max_mana", 1000);
  set("mana", 1800);
  set("mana_factor", 50);
  set("inquiry", ([
    "双龙取水": (: ask_unarmed :),
    "龙神搏击": (: ask_unarmed :),
  ]) );
  set_skill("literate", 120);
  set_skill("force", 120);
  set_skill("spells", 120);
  set_skill("dodge", 120);
  set_skill("unarmed", 120);
  set_skill("parry", 120);
  set_skill("dragonforce", 120);
  set_skill("seashentong", 120);
  set_skill("dragonstep", 120);
  set_skill("shuanglong-qushui", 120);
  set_skill("mace", 120);
  set_skill("wuliang-mace", 120);
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "shuanglong-qushui");
  map_skill("mace", "wuliang-mace");
  map_skill("parry", "wuliang-mace");

  create_family("东海龙宫", 4, "水族");
  setup();
  carry_object("/obj/cloth/choupao")->wear();
  carry_object("/d/obj/weapon/mace/ironmace")->wield();
}

void attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if( (string)ob->query("family/family_name") != "东海龙宫")
  {
    command(":D");
    command("say 。。。！\n");
    return 0;
  }

  if (!ob->query("family/can_bai/westsea"))
  {
    command("say 我为什么要收你做徒弟呢？给个理由先！\n");
    return 0;
  }

  command("say 既然是东海推荐而来，不收不大好吧！\n");
  command("nod " + ob->query("id"));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "dragon")
    ob->set("class", "dragon");
  return;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if( !me->is_apprentice_of(this_object()) )
    return 1;
  if ((string)me->query("family/family_name") != "东海龙宫")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我龙宫人，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "dragon")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我龙族，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((skill == "qianlong-wuyong") && !me->query("family/can_learn/dragonfight5"))
  {
    command("say 这一招可不是那么容易就可以学的！\n");
    return 1;
  }

  return 0;
}

string ask_unarmed()
{
  command("haha");
  command("say 想学这一招？先接我三掌。\n");
  this_player(1)->add_temp("pending/sea/wlongshao_hit", 1);
  return "你可愿意一试？(yuanyi)";
}

void init()
{
  ::init();
  add_action("do_agree", "yuanyi");
  add_action("do_agree", "agree");
}

int do_agree(string arg)
{
  object me, npc, ob;
  string myname;
  int my_max, my_kee;
  me = this_player(1);
  npc = this_object();
  if (!present(me, environment()))
    return 0;

  if (!me->query_temp("pending/sea/wlongshao_hit"))
    return 0;
  if (npc->is_busy())
    return notify_fail("他正忙着呢！\n");

  if (npc->query_temp("no_move"))
    npc->delete_temp("no_move");

  myname = me->name();
  my_max = me->query("max_kee");

  me->delete_temp("pending/sea/wlongshao_hit");

  npc->set("force", 2*query("max_force"));
  npc->set("force_factor", 40);
  ob = npc->query_temp("weapon");
  if (!objectp(ob))
    ob = npc->query_temp("secondary_weapon");

  if (objectp(ob))
  {
    command(sprintf("unwield %s",ob->query("id")));
  }

  npc->set_temp("ignore_dis",1);
  command("say 不错，先来第一招！\n");
  COMBAT_D->do_attack(npc, me);
  my_kee = me->query("kee");
  if(my_kee < 0
   || my_kee < my_max/3
   || !present(me, environment()))
  {
    command(sprintf("say 嘿嘿，%s一掌都经不住，厉害吧！\n",myname));
    return 1;
  }

  command("say 不错，看第二招！\n");
  COMBAT_D->do_attack(npc, me);

  my_kee = me->query("kee");
  if(my_kee < 0
   || my_kee < my_max/3
   || !present(me, environment()))
  {
    command(sprintf("say %s抗住第一下已经不容易了。。。\n",myname));
    return 1;
  }

  command("say 居然挺过了两次！最后一招\n");
  COMBAT_D->do_attack(npc, me);
  npc->delete_temp("ignore_dis");
  my_kee = me->query("kee");
  if(my_kee < 0
   || my_kee < my_max/3
   || !present(me, environment()))
  {
    command(sprintf("say 可惜，%s多抗一下就好了。\n",myname));
    return 1;
  }

  me->set("family/can_learn/dragonfight5", 1);
  command(sprintf("say %s果然是个人物。\n",myname));
  if (objectp(ob))
    command(sprintf("wield %s", ob->query("id")));
  return 1;
}

