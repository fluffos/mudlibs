inherit BIGROOM;
inherit WATERROOM;
void create ()
{
  set ("short", "东海龙宫大门");
  set ("long", @LONG
嵌在宫殿各处的珍宝发出的光芒耀得你连眼睛都睁不开了。依稀看
到宫门上方挂这一幅方匾，上有＂东海龙宫＂四个大字。几名虾兵
蟹将分列两旁，警惕的盯着来往的人。大门边上摆放着几口大钟，
据说是为了和其他龙宫联系用的。其他龙宫的弟子要返回，可以通
过敲击(knock)直接返回。
LONG);
  set("exits", ([
    "west" : __DIR__"under4",
    "east" : __DIR__"inside1",
  ]));
  set("objects", ([ /* sizeof() == 2 */
    __DIR__"npc/soldier1" : 2,
    __DIR__"npc/soldier2" : 2,
  ]));
  setup();
}

void init()
{
    add_action("do_knock",({"knock","qiao"}));
}

int do_knock(string arg)
{
  object me = this_player();

  if (!me || me->query("class") != "dragon")
    return 0;

  if (!arg || (arg != "north" && arg != "west" && arg != "south"))
  {
    write("knock north|west|south 选择要前往的其他龙宫！\n");
    return 1;
  }

  if (me->is_busy() || me->is_fighting())
  {
    write("你现在正忙着呢！\n");
    return 1;
  }

  if (me->query_temp("is_riding"))
  {
    write("你还是先下了坐骑吧！\n");
    return 1;
  }

  message_vision("$N拿起个钟槌在钟上敲了几下！\n",me);
  switch (arg)
  {
    case "north" :
      if ((string)me->query("family/master_id") != "ao sun" &&
          (string)me->query("family/master_id") != "north taizi")
      {
        write("你不是北海龙宫的弟子，无法通过这种方式前往北海龙宫！\n");
        return 1;
      }

      message_vision("只见一道神光罩住了$N，转瞬$N就不见了！\n",me);
      me->move("/d/northeast/seashore");
      message_vision("一道神光从天而下，慢慢把$N的身影显露出来！\n",me);
      return 1;
      break;
    case "west" :
      if ((string)me->query("family/master_id") != "ao run" &&
          (string)me->query("family/master_id") != "west taizi")
      {
        write("你不是西海龙宫的弟子，无法通过这种方式前往西海龙宫！\n");
        return 1;
      }

      message_vision("只见一道神光罩住了$N，转瞬$N就不见了！\n",me);
      me->move("/d/westsea/seashore");
      message_vision("一道神光从天而下，慢慢把$N的身影显露出来！\n",me);
      return 1;
      break;
    case "south" :
      if ((string)me->query("family/master_id") != "ao qin" &&
          (string)me->query("family/master_id") != "south taizi")
      {
        write("你不是南海龙宫的弟子，无法通过这种方式前往南海龙宫！\n");
        return 1;
      }

      message_vision("只见一道神光罩住了$N，转瞬$N就不见了！\n",me);
      me->move("/d/hangzhou/eroad7");
      message_vision("一道神光从天而下，慢慢把$N的身影显露出来！\n",me);
      return 1;
      break;
  }

  return 1;
}

