inherit COMBINED_ITEM;
void create()
{
  set_name("珍珠", ({"pearl"}));
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long",    "一颗浑圆的珍珠。\n");
    set("unit", "颗");
    set("base_unit", "颗");
    set("base_weight", 1);
    set("base_value", 1000);
    set("value", 1000);
  }

  set_amount(1);
  setup();
}

