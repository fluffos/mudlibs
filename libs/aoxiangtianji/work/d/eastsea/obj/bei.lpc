#include <armor.h>
inherit ARMOR;
void create()
{
  set_name("彩贝甲", ({"color shell","jia","armor","shell"}));
  set_weight(4000);
  set_max_encumbrance(3);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("long", "一件七彩贝甲。\n");
    set("value", 0);
    set("no_sell",1);
    set("material", "wood");
    set("armor_prop/dodge",5);
  }

  init_armor(25);
  setup();
}

