#include <weapon.h>
inherit AXE;
void create()
{
  set_name("天龙斧", ({ "dragon axe", "axe" }) );
  set_weight(8000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "柄");
    set("value", 5000);
    set("material", "iron");
    set("long", "一柄长长的斧。\n");
    set("wield_msg", "$N抄起一柄$n，在头上挥舞了一圈。\n");
  }

  init_axe(50);
  setup();
}

