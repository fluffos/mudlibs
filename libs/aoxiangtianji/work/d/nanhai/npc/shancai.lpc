#include <ansi.h>
#include "bonze.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("善财童子", ({ "shancai tongzi", "shancai", "tongzi" }));
  set("title", "南海观音护法童子");
  set("long", @LONG
南海观音座前护法弟子善财童子。
LONG);
  set("gender", "男性");
  set("age", 25);
  set("attitude", "peaceful");
  set("rank_info/self", "贫僧");
  set("class", "bonze");
  set("max_kee", 1500);
  set("max_gin", 1500);
  set("max_sen", 1800);
  set("force", 3500);
  set("max_force", 2000);
  set("force_factor", 100);
  set("max_mana", 2000);
  set("mana", 3800);
  set("mana_factor", 100);
  set("combat_exp", 1250000);
  set("daoxing", 1250000);
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("lotusforce", 200);
  set_skill("buddhism", 200);
  set_skill("lotusmove", 200);
  set_skill("jienan-zhi", 200);
  set_skill("staff", 200);
  set_skill("pudu-staff", 200);
  set_skill("blade", 200);
  set_skill("cibei-blade", 200);
  map_skill("force","lotusforce");
  map_skill("spells", "buddhism");
  map_skill("dodge", "lotusmove");
  map_skill("unarmed","jienan-zhi");
  map_skill("staff","pudu-staff");
  map_skill("parry","pudu-staff");
  map_skill("blade","cibei-blade");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
     (: cast_spell, "bighammer" :),
     (: perform_action, "staff.zhao" :),
  }) );
  create_family("南海普陀山", 2, "弟子");
  setup();
  carry_object("/obj/cloth/seng-cloth")->wear();
  carry_object("/d/obj/weapon/staff/chanzhang")->wield();
}

int attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((string)ob->query("family/family_name") != "南海普陀山")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我南海普陀山弟子，"
                    "贫僧所教恐怕难以理解。\n",RANK_D->query_respect(ob)));
    return 1;
  }

  if ((string)ob->query("class") !="bonze")
  {
    command("say 施主还是先去剃度了吧！\n");
    return 0;
  }

  if( ob->query("level") <= 25)
  {
    command("say 施主还需要进一步的修炼，现在的级别我无法给你帮助！\n");
    return 0;
  }

  command("haha");
  command("recruit " + ob->query("id"));
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname = RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "南海普陀山")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我南海普陀山弟子，"
                    "贫僧所教恐怕难以理解。\n",myname));
    return 1;
  }

  if ((string)me->query("class") != "bonze")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s并非出家之人，"
                    "贫僧所教恐怕难以理解。\n",myname));
    return 1;
  }

  if (me->query("level") < 25)
  {
    command(sprintf("emote 皱了皱眉头，说道：%s还欠修练，"
                    "贫僧所教恐怕难以理解。\n",myname));
    return 1;
  }

  return 0;
}