#include <ansi.h>
#include "bonze.h"
inherit NPC;
inherit F_MASTER;
string *have_yao=({});
string *have_dan=({});
string ask_yao(object who);
string ask_dan(object who);
void create()
{
  set_name("掌厨僧", ({ "zhangchu seng", "seng" }));
  set("gender", "男性");
  set("age", 25);
  set("attitude", "peaceful");
  set("class", "bonze");
  set("max_kee", 700);
  set("max_gin", 700);
  set("max_sen", 800);
  set("force", 1000);
  set("max_force", 600);
  set("force_factor", 30);
  set("max_mana", 700);
  set("mana", 1300);
  set("mana_factor", 30);
  set("combat_exp", 80000);
  set("daoxing", 80000);

  set_skill("literate", 90);
  set_skill("force", 90);
  set_skill("spells", 90);
  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("parry", 90);
  set_skill("lotusforce", 90);
  set_skill("buddhism", 90);
  set_skill("lotusmove", 90);
  set_skill("jienan-zhi", 90);
  set_skill("staff", 90);
  set_skill("pudu-staff", 90);
  map_skill("force","lotusforce");
  map_skill("spells", "buddhism");
  map_skill("dodge", "lotusmove");
  map_skill("unarmed","jienan-zhi");
  map_skill("staff","pudu-staff");
  map_skill("parry","pudu-staff");

  set("inquiry", ([
     "云南白药": (: ask_yao :),
     "灵丹": (: ask_dan :),
  ]) );
  set("apply/yaono", 10);
  set("apply/danno", 10);
  create_family("南海普陀山", 4, "弟子");

  setup();
  add_money("silver", 5);
  carry_object("/obj/cloth/seng-cloth")->wear();
  carry_object("/d/obj/weapon/staff/chanzhang")->wield();
}

string ask_yao(object me)
{
  object ob, who = this_player(1);
  int number;
  if (who->query("family/family_name") != "南海普陀山")
    return sprintf("%s与本门毫无渊源，为什么问起这个？\n",RANK_D->query_respect(who));
  if (present("yunnan baiyao", who))
    return "你身上不是已经有云南白药了吗，怎么又来要？\n";

  if (!(number = me->query("apply/yaono")))
    return "对不起，云南白药已经全部发放出去了。\n";

  if(member_array(who->query("id"),have_yao)!=-1)
    return "你不是刚刚要过吗？\n";
  have_yao+=({who->query("id")});
  set("apply/yaono", --number);
  ob = new("/d/nanhai/obj/yunnandrug");
  ob -> move(me);
  command("give " + who->query("id") + " yunnan baiyao");
  return "云南白药得之不易，要节约着用。\n";
}

string ask_dan(object me)
{
  object ob, who = this_player(1);
  int number;
  if (who->query("family/family_name") != "南海普陀山")
    return sprintf("%s与本门毫无渊源，为什么问起这个？\n",RANK_D->query_respect(who));
  if (present("lingdan", who))
    return "你身上不是已经有灵丹了吗，怎么又来要？\n";
  if (!(number = me->query("apply/danno")))
    return "对不起，灵丹已经全部发放出去了。\n";
  if(member_array(who->query("id"),have_dan)!=-1)
    return "你不是刚刚要过吗？\n";
  have_dan += ({who->query("id")});
  set("apply/danno", --number);
  ob = new("/d/nanhai/obj/lingdan");
  ob -> move(me);
  command("give " + who->query("id") + " lingdan");
  return "灵丹得之不易，要节约着用。\n";
}

int attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((string)ob->query("class") !="bonze")
  {
    command("say 施主还是先去剃度了吧！\n");
    return 0;
  }

  if( (string)ob->query("family/family_name") == "南海普陀山")
  {
    command("say 大家同门中人，不敢当，不敢当！\n");
    return 0;
  }

  command("haha");
  command("recruit " + ob->query("id"));
  return 1;
}

