#include <ansi.h>
#include "bonze.h"
inherit NPC;
inherit F_MASTER;
string ask_staff(object who);
string ask_blade(object who);
void create()
{
  set_name("掌禅僧", ({ "zhangchan seng", "seng" }));
  set("gender", "男性");
  set("age", 35);
  set("attitude", "peaceful");
  set("class", "bonze");
  set("max_kee", 700);
  set("max_gin", 700);
  set("max_sen", 800);
  set("force", 1200);
  set("max_force", 700);
  set("force_factor", 30);
  set("max_mana", 800);
  set("mana", 1200);
  set("mana_factor", 40);
  set("combat_exp", 80000);
  set("daoxing", 80000);
  set_skill("literate", 90);
  set_skill("force", 90);
  set_skill("spells", 90);
  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("parry", 90);
  set_skill("lotusforce", 90);
  set_skill("buddhism", 90);
  set_skill("lotusmove", 90);
  set_skill("jienan-zhi", 90);
  set_skill("staff", 90);
  set_skill("pudu-staff", 90);
  map_skill("force","lotusforce");
  map_skill("spells", "buddhism");
  map_skill("dodge", "lotusmove");
  map_skill("unarmed","jienan-zhi");
  map_skill("staff","pudu-staff");
  map_skill("parry","pudu-staff");
  set("inquiry", ([
    "兵器": "你想要什么兵器？",
    "禅杖": (: ask_staff :),
    "戒刀": (: ask_blade :)
  ]) );
  set("apply/staffno", 10);
  set("apply/spearno", 10);
  create_family("南海普陀山", 4, "弟子");

  setup();
  add_money("silver", 1);
  carry_object("/obj/cloth/seng-cloth")->wear();
  carry_object("/d/obj/weapon/staff/chanzhang")->wield();
}

string ask_staff(object me)
{
  object ob, who = this_player(1);
  int number;
  if (who->query("family/family_name") != "南海普陀山")
    return sprintf("%s与本门毫无渊源，为什么问起这个？\n",RANK_D->query_respect(who));
  if (present("tie zhang", who))
    return "你身上不是已经有铁杖了吗，怎么又来要？\n";
  if (who->query_temp("nanhai/yao-staff"))
    return "你今天已经要过铁杖了！\n";
  if (!(number = me->query("apply/staffno")))
    return "对不起，兵器已经全部发放出去了。\n";
  set("apply/staffno", --number);
  ob = new("/d/obj/weapon/staff/tiezhang");
  ob->set("no_give",1);
  ob->set("no_get",1);
  ob->set("no_sell",1);
  ob->set("value",0);
  ob -> move(me);
  who->set_temp("nanhai/yao-staff",1);
  command("give " + who->query("id") + " staff");
  return "千万记住，兵器只可用来防身，不可滥杀无辜。";
}

string ask_blade(object me)
{
  object ob, who = this_player();
  int number;
  if (who->query("family/family_name") != "南海普陀山")
    return sprintf("%s与本门毫无渊源，为什么问起这个？\n",RANK_D->query_respect(who));
  if (present("jie dao", who))
    return "你身上不是已经有戒刀了吗，怎么又来要？\n";
  if (who->query_temp("nanhai/yao-blade"))
    return "你今天已经要过戒刀了！\n";

  if (!(number = me->query("apply/spearno")))
    return "对不起，兵器已经全部发放出去了。\n";
  set("apply/spearno", --number);
  ob = new("/d/obj/weapon/blade/jiedao");
  ob->set("no_give",1);
  ob->set("no_get",1);
  ob->set("no_sell",1);
  ob->set("value",0);
  ob->move(me);
  who->set_temp("nanhai/yao-blade",1);
  command("give " + who->query("id") + " blade");
  return "千万记住，兵器只可用来防身，不可滥杀无辜。";
}

int attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((string)ob->query("class") !="bonze")
  {
    command("say 施主还是先去剃度了吧！\n");
    return 0;
  }

  if( (string)ob->query("family/family_name") == "南海普陀山")
  {
    command("say 大家同门中人，不敢当，不敢当！\n");
    return 0;
  }

  command("haha");
  command("recruit " + ob->query("id"));
  return 1;
}