#include <ansi.h>
#include "bonze.h"
inherit NPC;
inherit F_MASTER;
int do_drop(object, object);
string ask_rank();
void create()
{
  set_name("观音菩萨", ({ "guanyin pusa", "guanyin", "pusa" }));
  set("title", "救苦救难大慈大悲");
  set("long", @LONG
理圆四德，智满金身。眉如小月，眼似双星。兰心欣紫竹，
蕙性爱得藤。她就是落伽山上慈悲主，潮音洞里活观音。
LONG);
  set("gender", "女性");
  set("age", 35);
  set("attitude", "peaceful");
  set("rank_info/self", "贫僧");
  set("rank_info/respect", "菩萨娘娘");
  set("class", "bonze");
  set("str",24);
  set("per",100);//means no rong-mao description.
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("force", 7000);
  set("max_force", 4000);
  set("force_factor", 200);
  set("max_mana", 4200);
  set("mana", 8000);
  set("mana_factor", 200);
  set("combat_exp", 5000000);
  set("daoxing", 8000000);
  set("inquiry",([
    "净瓶": "前些天，福星借我的净瓶用，到现在也没有还，你去看看吧。" ,
   "职位" : (: ask_rank :),
  ]));
  set_skill("literate", 300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("medical",300);
  set_skill("lotusforce", 300);
  set_skill("buddhism", 300);
  set_skill("lotusmove", 300);
  set_skill("jienan-zhi", 300);
  set_skill("staff", 300);
  set_skill("lunhui-staff", 300);
  set_skill("blade", 300);
  set_skill("cibei-blade", 300);
  set_skill("mace", 300);
  set_skill("jingang-mace", 300);
  set_skill("fojia-yishu",300);
  map_skill("force","lotusforce");
  map_skill("spells", "buddhism");
  map_skill("dodge", "lotusmove");
  map_skill("unarmed","jienan-zhi");
  map_skill("staff","lunhui-staff");
  map_skill("parry","lunhui-staff");
  map_skill("blade","cibei-blade");
  map_skill("medical","fojia-yishu");
  map_skill("mace","jingang-mace");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
     (: cast_spell, "bighammer" :),
     (: cast_spell, "jinguzhou" :),
     (: perform_action, "staff.pudu" :),
  }) );
  create_family("南海普陀山", 1, "菩萨");
  setup();
  carry_object("/d/nanhai/obj/jiasha")->wear();
  carry_object("/d/nanhai/obj/nine-ring")->wield();
}

int attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((string)ob->query("family/family_name") != "南海普陀山")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我南海普陀山弟子，"
                    "贫僧所教恐怕难以理解。\n",RANK_D->query_respect(ob)));
    return 1;
  }

  if ((string)ob->query("class") !="bonze")
  {
    command("say 施主还是先去剃度了吧！\n");
    return 0;
  }

  if( (int)ob->query("level") <= 32)
  {
    command("say 施主还需要进一步的修炼，现在的级别我无法给你帮助！\n");
    return 0;
  }

  if ((int)ob->query("obstacle/number") < 34)
  {
    command("say 你尚未取经圆满，我还不能收你！\n");
    return 0;
  }

  command("nod");
  command("recruit " + ob->query("id"));
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname = RANK_D->query_respect(me);
  if( !me->is_apprentice_of(this_object()) )
    return 1;

  if ((string)me->query("family/family_name") != "南海普陀山")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我南海普陀山弟子，"
                    "贫僧所教恐怕难以理解。\n",myname));
    return 1;
  }

  if ((string)me->query("class") != "bonze")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s并非出家之人，"
                    "贫僧所教恐怕难以理解。\n",myname));
    return 1;
  }

  if ((int)me->query("level") < 32)
  {
    command(sprintf("emote 皱了皱眉头，说道：%s还欠修练，"
                    "贫僧所教恐怕难以理解。\n",myname));
    return 1;
  }

  return 0;
}

void die()
{
  int i;
  object *inv;
  if( environment() )
  {
    message("sound", "\n\n观音菩萨摇头叹道：刚离迷障，又入魔障，世间疾苦，何人度之！\n\n", environment());
    command("sigh");
    message("sound", "\n观音菩萨驾祥云，登彩雾，径往西方去了。。。\n\n", environment());
    inv = all_inventory(this_object());
    for(i=0; i<sizeof(inv); i++)
    {
      if (inv[i]->query("no_drop"))
        continue;
      do_drop(this_object(), inv[i]);
    }

  }

  destruct(this_object());
}

int do_drop(object me, object obj)
{
  if (obj->move(environment(me)))
  {      //d_mana>0 is for "bian". mon 11/05/97
    if((obj->query_temp("d_mana"))>0)
    {
      if( obj->query_temp("is_living")==1 )
        message_vision("$N将$n从背上放了下来，躺在地上。\n", me, obj);
      else
      {
        message_vision( sprintf("$N丢下一%s$n。\n",
                         undefinedp(obj->query_temp("unit"))?
                         "个" : obj->query_temp("unit")), me, obj );
      }

    }

    else
    {
      if( obj->is_character() )
        message_vision("$N将$n从背上放了下来，躺在地上。\n", me, obj);
      else
      {
        message_vision( sprintf("$N丢下一%s$n。\n", obj->query("unit")), me, obj );
        if( !obj->query("value") && !obj->value() )
        {
          tell_object(me,"因为这样东西并不值钱，所以人们并不会注意到它的存在 。\n");
          destruct(obj);
        }

      }

    }

    return 1;
  }

  return 0;
}

void unconcious()
{
  die();
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我普陀山的弟子！\n";

  if (me->query("class") != "bonze")
    return "阿弥陀佛，你不是我佛门弟子！\n";

  switch (topic)
  {
    case "历练" :
    case "历炼" :
    case "锻炼" :
      return QUEST_D->accept_ask(master, me, topic);
      break;

//buddhism
    case "大力降魔杵" :
    case "bighammer" :
      if (me->query("family/can_cast/bighammer"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("buddhism",1) < 100)
        return "你的大乘佛法修为不够，暂时无法领悟！\n";
      message_vision("$N微微一笑，在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁欣喜若狂，哈哈，我会了！\n",me);
      me->set("family/can_cast/bighammer",1);
      return "你学会了“大力降魔杵”！\n";
      break;

    case "隐身术" :
    case "yinshen" :
       return MASTER_D->teach_pfm(me, this_object(),
             ([ "cast"    : "yinshen",
                "name"    : "隐身术",
                "sk1"     : "buddhism",
                "lv1"     : 120,
                "force"   : 150,
                "max_sen" : 1200,
                "gongxian": 300,]));
       break;

    case "莲花护体" :
    case "lianhua" :
      if (me->query("family/can_cast/lianhua"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("buddhism",1) < 120)
        return "你的大乘佛法修为不够，暂时无法领悟！\n";
      message_vision("$N微微一笑，在$n耳朵边说了几句。\n",master,me);
      message_vision("$N点了点，不禁面露喜色！\n",me);
      me->set("family/can_cast/lianhua",1);
      return "你学会了“莲花护体”！\n";
      break;
    case "紧箍咒" :
    case "jinguzhou" :
       if (me->query("obstacle/number") < 34)
         return "施主还是先取完经再说吧！\n";
       return MASTER_D->teach_pfm(me, this_object(),
             ([ "cast"    : "jinguzhou",
                "name"    : "紧箍咒",
                "sk1"     : "buddhism",
                "lv1"     : 200,
                "force"   : 250,
                "max_sen" : 1800,
                "gongxian": 500,]));
       break;
//cibei-blade
    case "刀影指" :
    case "yingzhi" :
      if (me->query("family/can_pfm/yingzhi"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("cibei-blade",1) < 120 ||
          me->query_skill("jienan-zhi",1) < 120 ||
          me->query_skill("lotusforce",1) < 100 ||
          me->query_skill("buddhism",1) < 120)
        return "你的修为尚未到时候，还请多多努力！\n";
      if (me->query("max_force") < 800)
        return "你的内力修为不够！\n";
      message_vision("$N站起身，比划了几下，$n顿时领悟了慈悲刀的诀窍！\n",master,me);
      me->set("family/can_pfm/yingzhi",1);
      return "你学会了慈悲刀的“刀影指”!\n";
      break;

//jingang-mace
    case "韦坨一怒" :
    case "weituo"  :
      if (me->query("family/can_pfm/weituo"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 800)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("jingang-mace",1) < 150 ||
          me->query_skill("lotusforce",1) < 150 ||
          me->query_skill("buddhism",1) < 150)
        return "你的修为尚未到时候，还请多多努力！\n";
      if (me->query("max_force") < 1500)
        return "你的内力修为不够！\n";
      message_vision("$N并不说话，却伸出手指，指了指边上站立的韦坨！\n",master);
      message_vision("$N迷惑间却见韦坨怒目而向，突然灵光闪现，原来如此！\n",me);
      me->set("family/can_pfm/weituo",1);
      return "你学会了金刚锏的“韦坨一怒”!\n";
      break;

//pudu-staff
    case "佛光普照" :
    case "zhao" :
      if (me->query("family/can_pfm/zhao"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("pudu-staff",1) < 80 ||
          me->query_skill("lotusforce",1) < 80 ||
          me->query_skill("buddhism",1) < 80)
        return "你的修为尚未到时候，还请多多努力！\n";
      if (me->query("max_force") < 100)
        return "你的内力修为不够！\n";
      message_vision("$N说道：“技有心生，佛光普照”！\n",master,me);
      me->set("family/can_pfm/zhao",1);
      return "你学会了“佛光普照”!\n";
      break;
//lunhui-staff
    case "普渡众生" :
    case "pudu"    :
       return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"    : "pudu",
                "name"   : "普渡众生",
                "sk1"     : "lunhui-staff",
                "lv1"     : 180,
                "sk2"     : "buddhism",
                "lv2"     : 180,
                "sk3"     : "lotusforce",
                "lv3"     : 180,
                "gongxian": 500,]));
       break;

//jienan-zhi
    case "佛祖捻花" :
    case "nianhua" :
      if (me->query("family/can_pfm/nianhua"))
        return "你不是已经会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("jienan-zhi",1) < 100 ||
          me->query_skill("lotusforce",1) < 100 ||
          me->query_skill("buddhism",1) < 100)
        return "你的修为尚未到时候，还请多多努力！\n";
      if (me->query("max_force") < 500)
        return "你的内力修为不够！\n";
      message_vision("$N在$n的耳朵边上小声的说了些什么！\n",master,me);
      me->set("family/can_pfm/nianhua",1);
      return "你学会了“佛祖捻花”!\n";
      break;
    case "暴风骤雨" :
    case "storm"    :
       return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"    : "storm",
                "name"   : "暴风骤雨",
                "sk1"     : "jienan-zhi",
                "lv1"     : 150,
                "sk2"     : "buddhism",
                "lv2"     : 150,
                "sk3"     : "lotusforce",
                "lv3"     : 150,
                "gongxian": 300,]));
       break;
  }

  return 0;
}

string ask_rank()
{
  object master = this_object();
  object who = this_player();
  int t = time();

  if (who->is_busy() || who->is_fighting())
    return "你正忙着呢！\n";

  if (t - (int)who->query("last_ask_rank") < 7200)
    return "你不是刚刚问过了吗？\n";

  if (!RANK_D->re_title(master,who))
    return "你无法从我这里获得称号！\n";

  who->set("last_ask_rank",t);
  who->start_busy(1);
  return sprintf("%s 点了点头！\n",master->name());
}

