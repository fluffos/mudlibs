inherit NPC;
#define BOOK "/d/obj/book/puduzhang.lpc"
string ask_book();
void create()
{
  set_name("游方行者", ({ "xingzhe" }));
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");
  set("class", "bonze");
  set("max_kee", 350);
  set("max_gin", 300);
  set("max_sen", 350);
  set("force", 300);
  set("max_force", 300);
  set("force_factor", 20);
  set("max_mana", 250);
  set("mana", 250);
  set("mana_factor", 10);
  set("combat_exp", 100000);
  set("daoxing", 200000);
  set_skill("literate", 50);
  set_skill("spells", 50);
  set_skill("buddhism", 40);
  set_skill("unarmed", 60);
  set_skill("jienan-zhi", 50);
  set_skill("dodge", 40);
  set_skill("lotusmove", 40);
  set_skill("parry", 60);
  set_skill("force", 50);
  set_skill("lotusforce", 50);
  set_skill("staff", 60);
  set_skill("pudu-staff", 50);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "pudu-staff");
  map_skill("staff", "pudu-staff");
  create_family("南海普陀山", 4, "弟子");
  set("inquiry",([
    "普渡杖": (: ask_book :),
  ]));
  set("book",1);
  setup();
  carry_object("/obj/cloth/seng-cloth")->wear();
  carry_object("/d/obj/weapon/staff/tiezhang")->wield();
}

string ask_book()
{
  object ubook, where;
  string str;
  object me = this_object();
  object who = this_player();
  if (who->query("class") != "bonze")
    return "施主不是佛门中人，问这个干什么？\n";

  if (!me->query("book"))
    return "啊！刚才有人来问过了，我现在也不知道消息了！\n";

  message_vision("$N说道：普渡杖法是普陀山的入门杖法，有本书记载着起始的练习办法！\n",me);
  ubook = find_object(BOOK);
  if (objectp(ubook) && environment(ubook))
    return "可惜这本书已经被人拿走了！\n";
  if (!objectp(ubook))
    ubook = new(BOOK);
  str = sprintf("/d/nanhai/zhuli%d",random(8));
  where = find_object(str);
  if (!objectp(where))
    where = load_object(str);
  if (!objectp(where) || !objectp(ubook))
    return "奇怪？那书好象找不到了？？\n";
  ubook->move(where);
  me->set("book",0);
  message_vision("$N继续说道：在后山的竹林中看到过这本书！\n",me);
  return "施主何不去寻找寻找呢！\n";
}

