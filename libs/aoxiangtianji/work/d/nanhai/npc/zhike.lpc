#include <ansi.h>
#include "bonze.h"
inherit NPC;
inherit F_MASTER;
void greeting(object ob);
void create()
{
  set_name("知客僧", ({ "zhike seng", "seng" }));
  set("long", "一位年轻的僧人，脸上总是带着热情的笑容。\n他负责在此迎接前来参禅进香的客人。\n");
  set("gender", "男性");
  set("age", 25);
  set("attitude", "peaceful");
  set("class", "bonze");
  set("max_kee", 700);
  set("max_gin", 700);
  set("max_sen", 800);
  set("force", 1800);
  set("max_force", 1000);
  set("force_factor", 50);
  set("max_mana", 1200);
  set("mana", 2200);
  set("mana_factor", 60);
  set("combat_exp", 500000);
  set("daoxing", 500000);
  set_skill("literate", 150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("medical",150);
  set_skill("lotusforce", 150);
  set_skill("buddhism", 150);
  set_skill("lotusmove", 150);
  set_skill("jienan-zhi", 150);
  set_skill("staff", 150);
  set_skill("pudu-staff", 150);
  set_skill("blade", 150);
  set_skill("cibei-blade", 150);
  set_skill("fojia-yishu",150);
  map_skill("force","lotusforce");
  map_skill("spells", "buddhism");
  map_skill("dodge", "lotusmove");
  map_skill("unarmed","jienan-zhi");
  map_skill("staff","pudu-staff");
  map_skill("parry","cibei-blade");
  map_skill("blade","cibei-blade");
  map_skill("medical","fojia-yishu");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
     (: cast_spell, "bighammer" :),
  }) );
  create_family("南海普陀山", 3, "弟子");
  setup();
  carry_object("/obj/cloth/seng-cloth")->wear();
  carry_object("/d/obj/weapon/blade/jiedao")->wield();
}

void init()
{
  object ob;
  ::init();
  if( playerp(ob = this_player()) && !is_fighting()
      && !ob->query("env/invisibility") )
    greeting(ob);
}

void greeting(object ob)
{
  if( !ob || !present(ob, environment(this_object())) )
    return;
  command(sprintf("say 知客僧热情地说道：这位 %s ，欢迎来到南海普陀山！\n",RANK_D->query_respect(ob)));
}

int attempt_apprentice(object ob)
{
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((string)ob->query("family/family_name") != "南海普陀山")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我南海普陀山弟子，"
                    "贫僧所教恐怕难以理解。\n",RANK_D->query_respect(ob)));
    return 1;
  }

  if ((string)ob->query("class") !="bonze")
  {
    command("say 施主还是先去剃度了吧！\n");
    return 0;
  }

  if( ob->query("level") <= 15)
  {
    command("say 施主还需要进一步的修炼，现在的级别我无法给你帮助！\n");
    return 0;
  }

  command("haha");
  command("recruit " + ob->query("id"));
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname = RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "南海普陀山")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我南海普陀山弟子，"
                    "贫僧所教恐怕难以理解。\n",myname));
    return 1;
  }

  if ((string)me->query("class") != "bonze")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s并非出家之人，"
                    "贫僧所教恐怕难以理解。\n",myname));
    return 1;
  }

  if (me->query("level") <= 15)
  {
    command(sprintf("emote 皱了皱眉头，说道：%s还欠修练，"
                    "贫僧所教恐怕难以理解。\n",myname));
    return 1;
  }

  return 0;
}