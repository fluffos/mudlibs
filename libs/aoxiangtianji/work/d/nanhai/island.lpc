#include <ansi.h>
inherit RIVER;
void create ()
{
  set ("short", "小岛");
  set ("long", @LONG
“万顷风云浮碧玉，孤插苍溟小白华”，这是南海上的一个小岛。
岛虽小却大大有名，据说观音菩萨就在岛上传经说法。极目远眺，
隐隐可见大陆的轮廓。
LONG);
  set("arrive_room", "/d/hangzhou/eroad5");
  set("exits", ([
    "north" : __DIR__"tingjing",
  ]));

  set("item_desc",([
    "paizi" : HIG "\nyell boat将有渡船带你回往宁波。\n\n"NOR,
  ]));

  set("resource/fish", ({ "/obj/fish/liyu",
                          "/obj/fish/jiyu",
                          "/obj/fish/qingyu",
                          "/obj/fish/caoyu", }));

  set("outdoors", "/d/nanhai");
  setup();
}