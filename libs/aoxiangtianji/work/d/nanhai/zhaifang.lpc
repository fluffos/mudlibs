inherit SMALLROOM;
inherit LANDROOM;
inherit SAFTYROOM;
void create ()
{
  set ("short", "斋房");
  set ("long", @LONG
这里是普陀山门人弟子们吃饭用斋的场所，桌子上摆着一些
蔬菜水果。由于来此者大多是僧人，因此斋房只提供素席。
LONG);
  set("exits", ([
    "west" : __DIR__"zoulang2",
  ]));

  set("objects", ([
    "/d/obj/food/dhg" : 1,
    "/d/obj/food/hulu" : 1,
    "/d/obj/food/xbc" : 1,
    "/d/obj/food/xqc" : 1,
  ]));

  set("light_up", 1);
  set("resource", ([
  "water" : 1,
  ]));
  setup();
}

