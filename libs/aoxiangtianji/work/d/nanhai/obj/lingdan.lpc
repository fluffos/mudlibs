// jinchuang.c 金创药
inherit COMBINED_ITEM;
void setup()
{}

void create()
{
  set_name("灵丹", ({"lingdan", "dan"}));
  if (clonep())
   set_default_object(__FILE__);
  else
  {
    set("base_unit","包");
    set("unit","包");
    set("long", "这是一粒贵重的灵丹，吃下去能够养精活血。不过时间一长药性就会消失，灵丹也会无影无踪的。\n");
    set("base_value", 1000);
    set("drug_type", "良药");
  }

  set("only_do_effect", 1);
  set_amount(1);
  setup();
}

int do_effect(object me)
{
  if (!present(this_object() , me))
    return notify_fail("这药必须要拿起来才能服用！\n");

  if (me->query("eff_sen") >= me->query("max_sen"))
  {
    write("你现在不需要用灵丹。\n");
    return 1;
  }

  else
  {
    me->receive_curing("sen", 50);
    message_vision("$N吃下一包灵丹，气色看起来好多了。\n",me);
    if (query_amount()>1)
      add_amount(-1);
    else
      destruct(this_object());
    return 1;
  }

}

