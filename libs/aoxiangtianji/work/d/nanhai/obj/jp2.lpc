#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;
void create()
{
  set_name("净瓶", ({"jingping", "bottle"}));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "南海观音盛水的净瓶。\n");
    set("unit", "个");
    set("value", 5000);
    set("max_liquid", 500);
  }

  set("liquid", ([
    "type": "water",
    "name": "圣水",
    "remaining": 10,
    "drunk_apply": 20,
  ]));
}

void init()
{
  add_action("do_pour","pour");
}

int do_pour(string arg)
{
  object ob = this_player();
  object where = environment();
  if (!playerp(where))
    return 0;

  if( ! arg || arg != "water" )
    return notify_fail("你要把什么从静瓶中倒出来？\n");

  if (where != ob || !ob->query("wzg/kill_tree"))
    return notify_fail("这里用不着净瓶。\n");

  if( query("liquid/remaining") < 1 )
    return notify_fail("瓶子中的圣水已经被喝光了。\n");
  if( environment(where)->query("short") != "果树上" )
    return notify_fail("你别忘了自己要去干嘛的？\n");
  message_vision("$N把静瓶中的水慢慢的倒上书上，奇迹发生了。\n",ob);
  message_vision("人参果树马上就发出了嫩芽。\n",ob);
  environment(where)->delete("killed");
  remove_call_out("reware");
  call_out("reward",3,ob);
  return 1;
}

void reward(object ob)
{
  int dx,qn;
  string name=ob->query("name");
  if( (int)ob->query("obstacle/number") != 7 ||
      (string)ob->query("obstacle/wzg") == "done" )
    return;

  if( !ob->query("wzg/kill_tree") )
    return;
  dx = random(1800);
  dx += 18000;
  qn = dx/3;
  ob->set("obstacle/number",8);
  ob->set("obstacle/wzg","done");
  ob->add("daoxing",dx);
  ob->add("potential",qn);
  ob->add("obstacle/dx",dx);
  ob->add("obstacle/qn",qn);
  message("channel:chat",HIC"【闲聊】镇元大仙(Zhenyuan daxian)："+name+"五庄观救活人参果树。\n"NOR,users());
  message("channel:chat",HIY"【过关斩将】观音菩萨(guanyin pusa)："+ob->query("name")+"闯过西行取经又一关！\n"NOR,users());
  tell_object(ob,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed wzg on %s\n",
             ob->name(1), geteuid(ob), ctime(time()) ) );
  ob->delete("wzg/kill_tree");
  ob->save();
  destruct(this_object());
  return;
}

