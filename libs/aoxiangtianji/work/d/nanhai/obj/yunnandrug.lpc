inherit COMBINED_ITEM;
void setup()
{}

void create()
{
  set_name("云南白药", ({"yunnan baiyao", "baiyao", "yao","drug"}));
  if (clonep())
   set_default_object(__FILE__);
  else
  {
    set("base_unit","包");
    set("unit","包");
    set("long", "这是一包贵重的云南白药，省着点用。\n");
    set("base_value", 1000);
    set("drug_type", "良药");
  }

  set("only_do_effect", 1);
  set_amount(1);
  setup();
}

int do_effect(object me)
{
  if (!present(this_object() , me))
    return notify_fail("这药必须要拿起来才能服用！\n");

  if (me->query("eff_kee") >= me->query("max_kee"))
  {
    write("你现在不需要用云南白药。\n");
    return 1;
  }

  else
  {
    me->receive_curing("kee", 50);
    message_vision("$N吃下一包云南白药，气色看起来好多了。\n",me);
    if (query_amount()>1)
      add_amount(-1);
    else
      destruct(this_object());
    return 1;
  }

}

