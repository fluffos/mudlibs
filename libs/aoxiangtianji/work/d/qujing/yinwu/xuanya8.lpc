inherit "/d/qujing/yinwu/xuanya1";
void create ()
{
  ::create();
  set("exits", ([
    "northup"    : __DIR__"xuanya6",
  ]));
}

void init ()
{
  add_action ("do_climb","climb");
}

int do_climb (string arg)
{
  object ridee;
  object who = this_player();
  ridee = who->query_temp("is_riding");
  if (objectp(ridee))
    return notify_fail("你还是先下了坐骑吧！\n");

  message_vision ("$N手脚并用奋不顾身地向上爬去。\n",who);
  if (who->query("level") < 25 || random(4))
  {
    message_vision ("\n……哗哗一声，$N失手滑了下来。\n",who);
    who->unconcious();
  }

  else
    who->move(__DIR__"shanmen");
  return 1;
}