inherit NPC;
string give_fajian();
void create()
{
  set_name("白髯土地", ({"tu di", "tu", "di"}));
  set("gender", "男性");
  set("age", 100);
  set("attitude", "friendly");
  set("combat_exp", 250000);
  set("daoxing", 300000);
  set("per", 25);
  set_skill("dodge", 60);
  set("max_sen",600);
  set("max_gee",600);
  set("max_gin",600);
  set("force",800);
  set("max_force",800);
  set("max_mana",800);
  set("force_factor",25);
  set_skill("spells",60);
  set_skill("stick",60);
  setup();
  set("inquiry", ([
       "here": "这儿是隐雾山，亦有连环洞在此。\n",
       "隐雾山": "隐雾山乃有连环洞之去处，多加小心为是。\n",
       "连环洞": "连环洞在隐雾山下连环相衔，有两个入口也。\n",
       "name": "隐雾山土地也，老夫别无他物，只有一宝。\n",
       "宝": "老夫有一法简，乃一锦一禅师所赠。\n",
       "法简": (: give_fajian :),
       "fajian": (: give_fajian :),
  ]));
  carry_object("/obj/cloth/choupao")->wear();
}

string give_fajian()
{
  object me = this_object();
  object who = this_player();
  object fajian;
  if (who->query("level") < 25 ||
      present("fa jian",who))
  {
    command ("shake");
    return "你现在用不上这个东西！\n";
  }

  fajian = new ("/d/qujing/yinwu/obj/fajian");
  fajian->move(me);
  command("hmm");
  command("give "+who->query("id")+" fa jian");
  who->set_temp("obstacle/yinwu_fajian",1);
  return "哈哈！快去！\n";
}

void announce_success (object who)
{
  int dx, qn;
  if ((int)who->query("obstacle/number") != 29 ||
      (string)who->query("obstacle/yinwu") == "done" ||
      !who->query_temp("obstacle/yinwu_fajian"))
    return;

  dx = random(3600);
  dx += 36000;
  qn = dx/3;
  who->set("obstacle/number",30);
  who->set("obstacle/yinwu","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  who->delete_temp("obstacle/yinwu_fajian");
  command("chat "+who->query("name")+"隐雾山施法，连环洞灭妖邪！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed yinwu on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}