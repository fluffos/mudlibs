inherit NPC;
void recovering (object me, object ob);
void create()
{
  set_name("九头狮", ({ "jiutou shi", "shi" }));
  set("title", "九灵元圣");
  set("long", "一位老妖怪，长着九个狮子头。\n");
  set("gender", "男性");
  set("age", 70);
  set("attitude", "heroism");
  set("per", 19);
  set("max_kee", 4500);
  set("max_sen", 4500);
  set("force", 5000);
  set("max_force", 2500);
  set("force_factor", 120);
  set("max_mana", 2500);
  set("mana", 5000);
  set("mana_factor", 120);
  set("combat_exp", 2000000);
  set("daoxing", 2000000);
  set("no_ji", 1);

  set_skill("force", 230 + random(50));
  set_skill("spells", 230 + random(50));
  set_skill("dodge", 230 + random(50));
  set_skill("unarmed", 230 + random(50));
  set_skill("parry", 230+random(50));
  set_skill("spear", 230+random(50));

  set_skill("huntian-qigong",230+random(50));
  set_skill("yaofa",230+random(50));
  set_skill("feiyan-zoubi",230+random(50));
  set_skill("changquan",230+random(50));
  set_skill("lihua-spear",230+random(50));
  map_skill("force", "huntian-qigong");
  map_skill("spells", "yaofa");
  map_skill("dodge", "feiyan-zoubi");
  map_skill("unarmed", "changquan");
  map_skill("spear", "lihua-spear");
  map_skill("parry", "lihua-spear");
  set("heads", 9);
  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/d/obj/weapon/spear/jinqiang")->wield();
}

void die ()
{
  object prince;
  object me = this_object();
  object ob = query_temp("my_killer");

  if (objectp(ob) &&
      ob == me->query_last_damage_from() &&
      ob->query("obstacle/number") == 31 &&
      ob->query("obstacle/yuhua") != "done" &&
      ob->query_temp("obstacle/yuhua_bang") &&
      ob->query_temp("obstacle/yuhua_pa") &&
      ob->query_temp("obstacle/yuhua_zhang"))
  {
    prince = new ("/d/qujing/yuhua/npc/prince");
    prince->move(environment(ob));
    prince->announce_success (ob);
    destruct (prince);
  }

  message_vision ("\n$N扑倒在地，现身为一头九头狮座。\n",me);
  message_vision ("\n半空中传来救苦天尊的怒喝：元圣儿，回府！\n",me);
  message_vision ("九头狮随着一阵彩云而去。\n",me);
  destruct(me);
  return;
}

void unconcious ()
{
  die ();
}

int accept_fight(object ob)
{
  kill_ob(ob);
  return 1;
}

void kill_ob (object ob)
{
  object me = this_object();
  set_temp("my_killer",ob);
  recovering(me,ob);
  call_out ("hurting",random(20)+20,me,ob);
  ::kill_ob(ob);
}

void recovering (object me, object ob)
{
  if (!objectp(me) || !objectp(ob) || environment(ob) != environment(me))
    return;
  if (me->query("heads") > 0 &&
      (me->query("kee") < (me->query("max_kee")*3/4) ||
       me->query("sen") < (me->query("max_sen")*3/4)))
  {
    message_vision ("\n$N摇晃出一只狮子头，将自己伤处一舔！\n",me);
    me->set("kee",me->query("max_kee"));
    me->set("sen",me->query("max_sen"));
    me->set("eff_kee",me->query("max_kee"));
    me->set("eff_sen",me->query("max_sen"));
  }

  call_out ("recovering",1,me,ob);
}

void hurting (object me, object ob)
{
  string *msgs = ({
    "$N将一只狮子头伸长，一口把$n含在嘴里！\n",
    "$N伸出一只狮头，将$n凌空衔起！\n",
    "$N的狮子头一摆，张开血盆大口将$n咬起！\n",
  });
  object zhudao;
  int heads;
  if (!objectp(me) || !objectp(ob) || environment(ob) != environment(me))
    return;
  heads = me->query("heads");

  zhudao = present("taiyi zhu dao",ob);
  if (! zhudao ||
      zhudao != ob->query_temp("weapon"))
  {
    message_vision ("\n"+element_of(msgs),me,ob);
    ob->move("/d/qujing/zhujie/shi");
    ob->unconcious();
  }

  else if (heads>0)
  {
    object head = new("/d/qujing/zhujie/obj/head");
    message_vision ("但见$N手起刀落，"+
                    "$n惨嚎一声，一只狮头落地！\n",ob,me);
    head->move(environment(me));
    me->add("heads",-1);
    me->set("long", "一位老妖怪，还剩下"+chinese_number(heads-1)+"个狮子头。");
  }

  remove_call_out ("hurting");
  call_out ("hurting",random(20)+20,me,ob);
}

