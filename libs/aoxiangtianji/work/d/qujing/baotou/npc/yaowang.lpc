inherit NPC;
void create()
{
  set_name("妖王", ({"yao wang", "wang" }));
  set("title","黄狮精");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "aggressive");
  set("shen_type", 1);
  set("per", 30);
  set("int", 30);
  set("max_kee", 4000);
  set("max_sen", 4000);
  set("force", 5000);
  set("max_force", 2500);
  set("force_factor", 120);
  set("max_mana", 2500);
  set("mana", 5000);
  set("mana_factor", 120);
  set("combat_exp", 1800000);
  set("daoxing", 1800000);
  set_skill("force", 180 + random(50));
  set_skill("spells", 180 + random(50));
  set_skill("dodge", 180 + random(50));
  set_skill("unarmed", 180 + random(50));
  set_skill("parry", 180+random(50));
  set_skill("staff", 180+random(50));

  set_skill("huntian-qigong",180+random(50));
  set_skill("yaofa",180+random(50));
  set_skill("feiyan-zoubi",180+random(50));
  set_skill("changquan",180+random(50));
  set_skill("fumo-staff",180+random(50));
  map_skill("force", "huntian-qigong");
  map_skill("spells", "yaofa");
  map_skill("dodge", "feiyan-zoubi");
  map_skill("unarmed", "changquan");
  map_skill("staff", "fumo-staff");
  map_skill("parry", "fumo-staff");

  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/d/qujing/baotou/obj/siming")->wield();
}

void die()
{
  message_vision("只见$N摔倒在地，现了本形。原来是只金毛狮子！\n",this_object());
  set_name("金毛狮子", ({"yao wang", "wang" }));
  delete("title");
  ::die();
}

void unconcious()
{
  die();
}