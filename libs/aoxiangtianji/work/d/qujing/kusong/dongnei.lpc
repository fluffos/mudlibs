inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "洞内");
  set ("long", @LONG
洞内颇为宽敞，空荡荡的没有一个人影，似乎有种莫名的
压力环绕着你。靠墙的一把大椅子，虽然空着，却似乎有人才
坐过不久。
LONG);
  set("exits", ([
     "out" : __DIR__"dongkou",
  ]));
  setup();
}

void init()
{
  add_action("do_koujian", "koujian");
}

int do_koujian (string arg)
{
  object me = this_player();
  object huomo = present("huomo shenjun",environment(me));
  if (!me->query("family/can_bai/huomo"))
    return 0;

  if (arg != "huo mo" && arg != "火魔")
  {
    message_vision("只见$N伏下身去……\n",me);
    tell_object(me,"你想叩见谁？\n");
    return 1;
  }

  message_vision("只见$N伏下身去喊道："+
                 RANK_D->query_self(me)+
                 "叩见火魔神君！\n",me);
  if (huomo)
    message_vision("$N伸手一把将$n拎了起来，呵呵笑道：不必不必。\n",huomo,me);
  else
  {
    tell_room(this_object(),"洞穴中央隐隐地泛出一些红色云雾，接着幻成了火苗，跳动了几下。\n");
    call_out("huomo_appear",10+random(10),me);
  }

  return 1;
}

void huomo_appear(object me)
{
  object huomo;
  if (!me || environment(me) != this_object())
    return;
  if (present("huomo shenjun",environment(me)))
    return;
  huomo = new (__DIR__"npc/huomo");
  huomo->move(environment(me));
  message_vision("火苗跳动间，突然泛出了一片红光，一眨眼，那张椅子上，正坐着$N。\n",huomo);
  return;
}

