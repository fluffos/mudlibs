#include <ansi.h>
inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "枯松涧");
  set ("long", @LONG
松林边上有一片小的石崖，北面有一条山涧，似乎传来阵阵流水
的声音。涧上有一座小的石桥，远望桥后是一座高的怪石崖，崖下人
影攒动。往涧底看去，密密麻麻的青草，看不清个究竟。从此跳下，
不知是否会粉身碎骨。
LONG);
  set("exits", ([
    "south" : __DIR__"songlin4",
    "north" : __DIR__"guaishiya",
  ]));
  set("outdoors",1);
  setup();
}

void init()
{
  add_action("do_jump", "jump");
}

int do_jump(string arg)
{
  object ridee;
  object *inv;
  int sizeinv;
  object me = this_player();
  ridee = me->query_temp("is_riding");
  if (!arg || arg != "down")
    return 0;

  if (objectp(ridee))
    return notify_fail("你还是先下了坐骑吧！\n");
  inv = all_inventory(me);
  sizeinv=sizeof(inv);
  while (sizeinv--)
    if (inv[sizeinv]->is_character())
      return notify_fail("你要背个活人跳下去吗，当心被摔死。\n");
  message_vision(HIY"$N纵身一跃，往涧底跳了下去。\n" NOR,me);

  if (random(3) && (int)me->query_skill("dodge",1) <= 150)
  {
    me->move("/d/qujing/kusong/jiandi1");
    message_vision(HIY "只见$N从上面滚了下来，摔了个遍体鳞伤。\n" NOR, me);
    me->receive_damage("kee", (int)me->query("max_kee")/2);
    me->receive_damage("sen", (int)me->query("max_sen")/2);
    me->receive_wound("kee", (int)me->query("max_kee")/2);
    me->receive_wound("sen", (int)me->query("max_sen")/2);
    me->unconcious();
    return 1;
  }

  me->move("/d/qujing/kusong/jiandi");
  message_vision(HIY "只见$N从上面跳了下来。\n" NOR, me);
  me->receive_damage("kee", 20);
  me->receive_damage("sen", 20);
  return 1;
}

