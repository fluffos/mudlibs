inherit SMALLROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "洞口");
  set ("long", @LONG
丛林掩映当中，你突然看到了一个山洞。洞口不大，洞外
站着两个金盔金甲的怪物，正无聊的打着哈欠。
LONG);
  set("exits", ([
    "east" : __DIR__"xiaolu3",
    "enter" : __DIR__"dongnei",
  ]));

  set("objects", ([
    __DIR__"npc/huobing" : 2,
  ]));
}

int valid_leave(object me, string dir)
{
  object bing = present("huo bing",this_object());
  if (userp(me) && dir == "enter")
  {
    if (objectp(bing))
      return notify_fail("守洞的火兵挡住了你的去路！\n");
  }

  return ::valid_leave(me,dir);
}