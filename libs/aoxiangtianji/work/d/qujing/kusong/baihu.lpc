#include <ansi.h>
inherit BIGROOM;
inherit WATERROOM;
void create ()
{
  set ("short", "白虎潭");
  set ("long", @LONG
潭中的水晶莹透彻，远望恰如一只白色的虎爪。潭中偶而有大
鱼跃出，溅起片片的水花。潭的对面有一幅高崖，崖下隐约看
到一个小的山洞。
LONG);
  set("exits", ([ /* sizeof() == 4 */
    "south" : __DIR__"wangyue",
  ]));
  set("outdoors", 1);
  setup();
}

void init()
{
  object me = this_player();

  if (!playerp(me) || environment(me) != this_object())
    return;
  add_action("do_swim", "swim");

  remove_call_out("appear");
  call_out("appear",180,me);
}

int do_swim()
{
  object ridee;
  object me = this_player();
  ridee = me->query_temp("is_riding");
  if (objectp(ridee))
    return notify_fail("你还是先下了坐骑吧！\n");

  message_vision(HIY"$N纵身一跃，跳入潭中。只见$N使足了全身力气，手足并用，"
                 "不一会儿就游到了潭的对岸。\n" NOR,me);
  me->move("/d/qujing/kusong/xuanjing");
  message_vision(HIY "只见$N浑身湿漉漉地从水里爬了上来。\n" NOR, me);
  me->receive_damage("kee", 20);
  me->receive_damage("sen", 20);
  return 1;
}

void appear(object me)
{
  object laoren;

  if (!objectp(me) || environment(me) != this_object())
    return;
  laoren = new("/d/qujing/kusong/npc/laoren");
  laoren->move(environment(me));
  message_vision("$N眼前突然一花，一个老人笑呵呵的站在了面前！\n",me);
  return;
}

