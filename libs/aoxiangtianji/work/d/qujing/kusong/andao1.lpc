inherit SMALLROOM;
inherit MUDDYROOM;
int do_look(string arg);
void create ()
{
  set ("short", "斜巷");
  set ("long", @LONG
一条窄窄的斜巷，四周黑黑的，望不到底，不知能通到何处。
LONG);
  set("replace_look", (: do_look :));
  setup();
}

void init()
{
//  add_action("do_look", "look");
  add_action("do_west", "west");
  add_action("do_east", "east");
  add_action("do_south", "south");
  add_action("do_north", "north");
}

int do_look(string arg)
{
  write("黑乎乎的，什么都看不到！\n");
  return 1;
}

int do_west()
{
  object me = this_player();

  message_vision("$N往西摸黑走了过去。\n",me);
  me->move(sprintf("/d/qujing/kusong/andao%d",1+random(4)));
  message_vision("$N摸黑走了过去。\n",me);
  return 1;
}

int do_east()
{
  object me = this_player();

  message_vision("$N往东摸黑走了过去。\n",me);
  me->move(sprintf("/d/qujing/kusong/andao%d",1+random(4)));
  message_vision("$N摸黑走了过去。\n",me);
  return 1;
}

int do_south()
{
  object me = this_player();

  message_vision("$N往南摸黑走了过去。\n",me);
  me->move(sprintf("/d/qujing/kusong/andao%d",1+random(4)));
  message_vision("$N摸黑走了过去。\n",me);
  return 1;
}

int do_north()
{
  object me = this_player();

  message_vision("$N往北摸黑走了过去。\n",me);
  me->move(sprintf("/d/qujing/kusong/andao%d",1+random(4)));
  message_vision("$N摸黑走了过去。\n",me);
  return 1;
}