#include <ansi.h>
#include "hyd.h"
inherit NPC;
inherit F_MASTER;
string ask_niang();
string ask_niumo();
string ask_huomo();
int do_yes();
string ask_rank();
void create()
{
  set_name("红孩儿", ({"honghai er","er"}));
  set("title", "圣婴大王");
  set("long", "牛魔王与罗刹女的儿子，于火焰山中修炼了一身好本领。\n");
  set("gender", "男性");
  set("age", 16);
  set("per", 25);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("spi", 25);
  set("dex", 25);

  set("attitude", "heroism");
  set("combat_exp", 1500000);
  set("daoxing", 1500000);
  set("class","yaomo");

  set("max_kee", 4500);
  set("max_sen", 4500);
  set("force", 2500);
  set("max_force", 1600);
  set("force_factor", 100);
  set("max_mana", 1600);
  set("mana", 2500);
  set("mana_factor", 80);
  set("no_ji",1);

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: cast_spell, "sanmei" :),
  }));
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("blade",200);
  set_skill("spear",200);
  set_skill("huomoforce",200);
  set_skill("pingtian-dafa",200);
  set_skill("moshenbu", 200);
  set_skill("moyun-shou",200);
  set_skill("huoyan-blade",200);
  set_skill("huoyun-spear",200);
  set_skill("medical",200);
  set_skill("kusong-yaoli",200);
  map_skill("medical","kusong-yaoli");
  set_skill("fencheng-spear",120);

  map_skill("force","huomoforce");
  map_skill("spells","pingtian-dafa");
  map_skill("dodge","moshenbu");
  map_skill("unarmed","moyun-shou");
  map_skill("spear","huoyun-spear");
  map_skill("parry","huoyun-spear");
  map_skill("blade","huoyan-blade");
  create_family("火云洞", 2, "蓝");
  setup();
  set("inquiry", ([
    "铁扇公主": (: ask_niang :),
    "大力棒" : (: ask_niumo :),
    "职位" : (: ask_rank :),
    "火魔"   : (: ask_huomo :),
  ]) );
  setup();
  carry_object("/d/obj/weapon/spear/huojianqiang")->wield();
  carry_object("/obj/cloth/zhanpao")->wear();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "火云洞")
  {
    command("say 我只收火云洞的弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 25)
  {
    command("say 你还需要多努力！\n");
    return 0;
  }

  command("grin");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "火云洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我火云洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我妖魔中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 25)
  {
    command("say 你还需要多多磨练才行啊！\n");
    return 1;
  }

  return 0;
}

void init()
{
  object ob = this_player();
  remove_call_out("check");
  call_out("check",1,ob);
  add_action("do_yes","ok");
}

void check(object ob)
{
  object where=environment();

  if (!ob || environment(ob) != where)
    return;

  if (wizardp(ob))
    return;
  if(ob->query("family/family_name") == "火云洞")
    return;
  if(ob->query("title") == "普通百姓")
    return;
  if(ob->query_temp("kusong_killed") == 1)
    return;
  if ( ob->query_temp("apply/id")
    && member_array("niumo",ob->query_temp("apply/id") ) )
  {
    command("say 父王怎有机会来看望孩儿。");
    command("say 孩儿正好抓到一个和尚，吃了他，可以长生不老啊。");
    command("xixi");
    return;
  }

  if( present("jin che",where)
    || present("mu che",where)
    || present("shui che",where)
    || present("huo che",where)
    || present("tu che",where) )
  {
    if (userp(ob))
    {
      kill_ob(ob);
      message_vision(HIR"只见红孩儿手架五行车，手中火尖枪对$N一指。\n"NOR,ob);
      message_vision(HIR"一股三昧真火带着浓烟扑向$N，$N抽身便走。\n"NOR,ob);
      ob->move("/d/qujing/kusong/guaishiya");
      ob->unconcious();
    }

  }

  return;
}

string ask_niang()
{
  object me;
  me=this_player();
  command("jump");
  me->set_temp("honghaier_ok",1);
  return "我去请我娘一起吃肉好吗（ok）？\n";
}

string ask_niumo()
{
  object me;
  me = this_player(1);
  if ((string)me->query("family/family_name") != "火云洞")
  {
    command("say 你喜欢被父王杀了吃掉吗？\n");
    command("look " + me->query("id"));
    command("grin");
    return "还不如让我吃了呢！嘿嘿！！\n";
  }

  if ((int)me->query("level") > 15)
  {
    command("hmm");
    command("say 我父王对这大力棒很有研究！\n");
    if ((int)me->query("family/family_faith") < 1000)
      return "不过你还是先安心的为本门尽力吧！\n";
    command("say 我可以推荐你到父王那里进行学习！\n");
    me->set("family/can_bai/niumo",1);
    return "你这就去吧！\n";
  }

  command("say 你还是先安心的修炼吧！本事不高，心倒蛮大的！\n");
  command("sigh2");
  return "快快自己修炼去吧！\n";
}

string ask_huomo()
{
  object me;
  me = this_player(1);
  if ((string)me->query("family/family_name") != "火云洞")
  {
    command("say 想死啊？\n");
    command("look " + me->query("id"));
    command("grin");
    return "快走！否则我吃了你！\n";
  }

  if ((int)me->query("level") > 32)
  {
    command("hmm");
    if ((int)me->query("family/family_faith") < 3000)
      return "不过你还是先安心的为本门尽力吧！\n";
    command("say 我可以介绍你去！\n");
    me->set("family/can_bai/huomo",1);
    return "你这就去吧！\n";
  }

  command("say 你还是先安心的修炼吧！本事不高，心倒蛮大的！\n");
  command("sigh2");
  return "快快自己修炼去吧！\n";
}

int do_yes()
{
  object ob = this_player();
  if( ! ob->query_temp("honghaier_ok") )
    return 0;
  command("say 父王请在家等候，孩儿快去快回。");
  command("bye");
  destruct(this_object());
  return 1;
}

int accept_fight (object ob)
{
  command("exert powerup");
  kill_ob (ob);
  return 1;
}

void kill_ob (object ob)
{
  set_temp("no_return",1);
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

void die()
{
  object pusa;
  object ob = query_temp("my_killer");
  object me = this_object();
  if (objectp(ob) &&
      ob == me->query_last_damage_from() &&
      ob->query_temp("kusong_killed") &&
      (int)ob->query("obstacle/number") == 12 &&
      (string)ob->query("obstacle/huoyun") != "done")
  {
    pusa = new ("/d/qujing/kusong/npc/pusa");
    pusa->move(environment(ob));
    pusa->announce_success(ob);
    destruct (pusa);
  }

  message_vision(HIY"天上传来观音菩萨的声音：红孩儿，还不随我回南海去。\n"NOR,ob);
  destruct (me);
  return;
}

void unconcious ()
{
  die();
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我火云洞的弟子！\n";

  if (me->query("class") != "yaomo")
    return "嘿嘿，你问我何用？\n";

  switch (topic)
  {
    case "历练" :
    case "历炼" :
    case "锻炼" :
      return QUEST_D->accept_ask(master, me, topic);
      break;
//pingtian-dafa
    case "三味真火" :
    case "sanmei" :
      return MASTER_D->teach_pfm(me, this_object(),
             ([ "cast"   : "sanmei",
                "name"   : "三味真火",
                "sk1"    : "pingtian-dafa",
                "lv1"    : 100,
                "max_mana" : 1500,
                "gongxian": 300,]));
      break;
//lieyan-spear
    case "赤焰暴长" :
    case "chi" :
      if (me->query("family/can_pfm/chi"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("lieyan-spear",1) < 100)
        return "你的烈焰枪修为不够，暂时无法领悟！\n";
      if (me->query_skill("huomoforce",1) < 100)
        return "你的火魔心法修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/chi",1);
      return "你学会了“赤焰暴长”！\n";
      break;
//huoyun-spear
    case "祭枪" :
    case "ji" :
      if (me->query("family/can_pfm/ji"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("huoyun-spear",1) < 120 &&
          me->query_skill("fencheng-spear",1) < 120)
        return "你的火云枪法修为不够，暂时无法领悟！\n";
      if (me->query_skill("huomoforce",1) < 120)
        return "你的火魔心法修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/ji",1);
      return "你学会了“祭枪”！\n";
      break;

    case "离火三重" :
    case "lihuo" :
      if (me->query("family/can_pfm/lihuo"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 800)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("huoyun-spear",1) < 150 &&
          me->query_skill("fencheng-spear",1) < 150)
        return "你的火云枪法修为不够，暂时无法领悟！\n";
      if (me->query_skill("huomoforce",1) < 150)
        return "你的火魔心法修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/lihuo",1);
      return "你学会了“离火三重”！\n";
      break;
//honglian-blade
    case "流星火雨" :
    case "huo" :
      if (me->query("family/can_pfm/huo"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 150)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("honglian-blade",1) < 80)
        return "你的红莲刀法修为不够，暂时无法领悟！\n";
      if (me->query_skill("huomoforce",1) < 80)
        return "你的火魔心法修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/huo",1);
      return "你学会了“流星火雨”！\n";
      break;

//huoyan-blade
    case "天寰神炎" :
    case "yan" :
      return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"   : "yan",
                "name"   : "天寰神炎",
                "sk1"    : "huoyan-blade",
                "lv1"    : 200,
                "sk2"    : "huomoforce",
                "lv2"    : 200,
                "max_force" : 2800,
                "gongxian": 800,]));
      break;
    case "焚身" :
    case "fen" :
      if (me->query("family/can_pfm/fen"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("huoyan-blade",1) < 150)
        return "你的火焰刀法修为不够，暂时无法领悟！\n";
      if (me->query_skill("huomoforce",1) < 150)
        return "你的火魔心法修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/fen",1);
      return "你学会了“焚身”！\n";
      break;
//moyun-shou
    case "修罗焰" :
    case "xiuluo" :
      if (me->query("family/can_pfm/xiuluo"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("moyun-shou",1) < 100)
        return "你的摩云手修为不够，暂时无法领悟！\n";
      if (me->query_skill("huomoforce",1) < 100)
        return "你的火魔心法修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/xiuluo",1);
      return "你学会了“修罗焰”！\n";
      break;
    case "掌心雷" :
    case "zhangxinlei" :
      return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"   : "zhangxinlei",
                "name"   : "掌心雷",
                "sk1"    : "moyun-shou",
                "lv1"    : 180,
                "sk2"    : "huomoforce",
                "lv2"    : 180,
                "max_force" : 2500,
                "gongxian": 800,]));
      break;
  }

  return 0;
}

string ask_rank()
{
  object master = this_object();
  object who = this_player();
  int t = time();

  if (who->is_busy() || who->is_fighting())
    return "你正忙着呢！\n";

  if (t - (int)who->query("last_ask_rank") < 7200)
    return "你不是刚刚问过了吗？\n";

  if (!RANK_D->re_title(master,who))
    return "你无法从我这里获得称号！\n";

  who->set("last_ask_rank",t);
  who->start_busy(1);
  return sprintf("%s 点了点头！\n",master->name());
}

