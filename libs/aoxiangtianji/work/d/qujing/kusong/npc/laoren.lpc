#include <ansi.h>
inherit NPC;
string ask_guo();
string ask_dong();
void create()
{
  set_name("红面老人", ({"hongmian laoren","laoren"}));
  set("long","一个脸庞红红的，头发也是红红的，笑嘻嘻的老人。\n");
  set("gender", "男性");
  set("age", 200);
  set("int", 25);
  set("combat_exp", 5000000);
  set("daoxing", 5000000);
  set("per", 10);
  set("str", 30);
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 8000);
  set("max_force", 4000);
  set("force_factor", 200);
  set("max_mana", 4000);
  set("mana", 8000);
  set("mana_factor", 200);
  set_skill("literate",300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("spear",300);
  set_skill("blade",300);
  set_skill("stick",300);
  set_skill("fork",300);
  set_skill("huomoforce",300);
  set_skill("pingtian-dafa",300);
  set_skill("moshenbu", 300);
  set_skill("moyun-shou",300);
  set_skill("fencheng-spear",300);
  set_skill("huoyan-blade",300);
  set_skill("dali-stick",300);
  set_skill("yueya-fork",300);

  map_skill("force","huomoforce");
  map_skill("spells","pingtian-dafa");
  map_skill("dodge","moshenbu");
  map_skill("unarmed","moyun-shou");
  map_skill("spear","fencheng-spear");
  map_skill("parry","fencheng-spear");
  set("inquiry", ([
    "玄黄果": (: ask_guo :),
    "小洞" : (: ask_dong :),
  ]) );
  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  call_out("disappear",180);
}

string ask_guo()
{
  return "玄黄果是个好东西，我最喜欢了。你有吗？\n" ;
}

string ask_dong()
{
  return "到对面的小洞很容易，游(swim)过去就可以了。不过，洞里面很危险的。。。\n";
}

int accept_object(object who, object ob)
{
  object book;

  if (ob->query("id") != "xuanhuang guo")
  {
    command("say 这是什么？我不要。。。\n");
  }

  if ((string)who->query("family/family_name") == "火云洞")
  {
    book = new("/d/obj/book/hlblade-book");
    book->set("owner",who->query("id"));
    book->move(who,1);
    message_vision("$N哈哈大笑，连说了几个好，给了你一本书。\n");
  }

  message_vision("$N满心欢喜，哈哈大笑个不停！\n",this_object());
  return 1;
}

void disappear()
{
  if (!this_object())
    return;

  message_vision("$N嘻嘻一笑，转身化作云烟消失了！\n",this_object());
  destruct(this_object());
  return;
}

