#include <ansi.h>
#include "hyd.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("急如火", ({"jiru huo","huo"}));
  set("gender", "男性");
  set("age", 10);
  set("title", "火云洞健将");
  set("long","一个贼眉鼠眼的小妖精。\n");
  set("combat_exp", 100000+random(3000));
  set("daoxing", 100000);
  set("per", 15);
  set("max_sen",800);
  set("max_kee",800);
  set("force",1200);
  set("max_force", 700);
  set("force_factor",30);
  set("mana", 1200);
  set("max_mana", 700);
  set("mana_factor",30);
  set("per", 15);

  set_skill("literate", 90);
  set_skill("force", 90);
  set_skill("spells", 90);
  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("parry", 90);
  set_skill("spear",90);
  set_skill("huomoforce",90);
  set_skill("pingtian-dafa",90);
  set_skill("moshenbu", 90);
  set_skill("moyun-shou",90);
  set_skill("lieyan-spear",90);
  map_skill("force","huomoforce");
  map_skill("spells","pingtian-dafa");
  map_skill("dodge","moshenbu");
  map_skill("unarmed","moyun-shou");
  map_skill("spear","lieyan-spear");
  map_skill("parry","lieyan-spear");
  create_family("火云洞", 4, "蓝");
  setup();
  carry_object("/d/obj/armor/armor/tongjia")->wear();
  carry_object("/d/obj/weapon/spear/changqiang")->wear();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (stringp(myfam))
  {
    if (myfam == "火云洞")
    {
      command("say 不敢当，不敢当！\n");
    }

    return 0;
  }

  command("grin");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "火云洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我火云洞人，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我妖魔中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  return 0;
}

