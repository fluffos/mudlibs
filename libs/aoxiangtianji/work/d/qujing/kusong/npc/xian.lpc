#include <ansi.h>
#include "hyd.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("掀烘兴", ({"xianhong xing","xing"}));
  set("gender", "男性");
  set("age", 10);
  set("title", "火云洞健将");
  set("long","一个贼眉鼠眼的小妖精。\n");
  set("combat_exp", 600000+random(100000));
  set("daoxing", 500000);
  set("per", 15);
  set("max_sen",1200);
  set("max_kee",1200);

  set("force",1800);
  set("max_force", 1000);
  set("force_factor",50);
  set("mana", 1800);
  set("max_mana", 1000);
  set("mana_factor",50);
  set("per", 15);

  set_skill("literate", 150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("spear",150);
  set_skill("huomoforce",150);
  set_skill("pingtian-dafa",150);
  set_skill("moshenbu", 150);
  set_skill("moyun-shou",150);
  set_skill("lieyan-spear",150);
  map_skill("force","huomoforce");
  map_skill("spells","pingtian-dafa");
  map_skill("dodge","moshenbu");
  map_skill("unarmed","moyun-shou");
  map_skill("spear","lieyan-spear");
  map_skill("parry","lieyan-spear");
  create_family("火云洞", 3, "蓝");
  setup();
  carry_object("/d/qujing/kusong/obj/tongjia")->wear();
  carry_object("/d/obj/weapon/spear/changqiang")->wear();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "火云洞")
  {
    command("say 我只收火云洞的弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 15)
  {
    command("say 你还需要多努力！\n");
    return 0;
  }

  command("grin");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "火云洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我火云洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我妖魔中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 15)
  {
    command("say 你还需要多多磨练才行啊！\n");
    return 1;
  }

  return 0;
}