#include <ansi.h>
#include "hyd.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("火魔神君", ({"huomo shenjun","huomo"}));
  set("long","火魔神君是红孩儿的师傅，独自隐居在秘密的地方。\n");
  set("gender", "男性");
  set("age", 200);
  set("int", 25);
  set("attitude", "heroism");
  set("combat_exp", 5000000);
  set("daoxing", 5000000);
  set("class","yaomo");
  set("per", 10);
  set("str", 30);
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 8000);
  set("max_force", 4000);
  set("force_factor", 200);
  set("max_mana", 4000);
  set("mana", 8000);
  set("mana_factor", 200);
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: cast_spell, "sanmei" :),
    (: perform_action, "spear.lihuo" :),
    (: perform_action, "spear.lieyan" :),
  }));
  set_skill("literate",300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("spear",300);
  set_skill("blade",300);
  set_skill("stick",300);
  set_skill("fork",300);
  set_skill("huomoforce",300);
  set_skill("pingtian-dafa",300);
  set_skill("moshenbu", 300);
  set_skill("moyun-shou",300);
  set_skill("fencheng-spear",300);
  set_skill("huoyan-blade",300);
  set_skill("dali-stick",300);
  set_skill("yueya-fork",300);
  set_skill("medical",300);
  set_skill("kusong-yaoli",300);
  map_skill("medical","kusong-yaoli");

  map_skill("force","huomoforce");
  map_skill("spells","pingtian-dafa");
  map_skill("dodge","moshenbu");
  map_skill("unarmed","moyun-shou");
  map_skill("spear","fencheng-spear");
  map_skill("parry","fencheng-spear");
  create_family("火云洞", 1, "蓝");
  setup();
  carry_object("/d/obj/weapon/spear/huojianqiang")->wield();
  carry_object("/obj/cloth/zhanpao")->wear();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "火云洞")
  {
    command("say 我只收火云洞的弟子！\n");
    return 0;
  }

  if (!ob->query("family/can_bai/huomo"))
  {
    command("say 我和你行同陌人，拜我为师？？哈哈！！");
    command("shake");
    return 0;
  }

  if ((int)ob->query("level") <= 32)
  {
    command("say 你还需要多努力！\n");
    return 0;
  }

  if ((int)ob->query("obstacle/number") < 34)
  {
    command("say 你尚未取经圆满，我还不能收你！\n");
    return 0;
  }

  command("grin");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "火云洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非火云洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非妖魔中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 32)
  {
    command("say 你还需要多多磨练才行啊！\n");
    return 1;
  }

  if (skill == "fencheng-spear")
  {
    if (!me->query("family/can_learn/fencheng-spear"))
    {
      command("say 这门技艺，你还无法学习！\n");
      return 1;
    }
  }

  return 0;
}

string accept_ask(object me, string topic)
{
  object master = this_object();

  switch (topic)
  {
    case "烈焰焚城" :
    case "lieyan" :
      if (me->query("family/family_name") != master->query("family/family_name"))
        return "你不是我火云洞的弟子！\n";
      if (me->query("class") != "yaomo")
       return "嘿嘿，你问我何用？\n";
      return MASTER_D->teach_pfm(me, this_object(),
             ([ "pfm"   : "lieyan",
                "name"  : "烈焰焚城",
                "sk1"    : "fencheng-spear",
                "lv1"    : 250,
                "sk2"    : "huomoforce",
                "lv2"    : 250,
                "max_force" : 3200,
                "gongxian": 1000,]));
      break;
  }

  return 0;
}

