#include <ansi.h>
inherit NPC;
void create()
{
  set_name("观音菩萨", ({ "guanyin pusa", "guanyin", "pusa" }));
  set("title", "救苦救难大慈大悲");
  set("long", @LONG
理圆四德，智满金身。眉如小月，眼似双星。兰心欣紫竹，
蕙性爱得藤。她就是落伽山上慈悲主，潮音洞里活观音。
LONG);
  set("gender", "女性");
  set("age", 35);
  set("attitude", "peaceful");
  set("rank_info/self", "贫僧");
  set("rank_info/respect", "菩萨娘娘");
  set("class", "bonze");
  set("max_kee", 5000);
  set("max_sen", 5000);
  setup();
}

void announce_success (object who)
{
  int dx,qn;
  if(!who)
    return;
  if ((int)who->query("obstacle/number") != 12)
    return;
  if (who->query("obstacle/huoyun") == "done")
    return;
  dx = random(2200);
  dx += 22000;
  qn = dx/3;
  who->set("obstacle/number",13);
  who->set("obstacle/huoyun","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  command("chat "+who->query("name")+"枯松涧火云洞.收服红孩儿");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed huoyun on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}

