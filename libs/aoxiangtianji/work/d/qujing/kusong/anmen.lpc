inherit SMALLROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "斜巷");
  set ("long", @LONG
这里好象已是路的尽头，下方有一条窄窄的斜巷，里面黑黑的望
不到底，不知能通到何处。巷口挂着一个木牌，写着“入禁地者
死”五个字。
LONG);
  set("exits", ([
    "east" : __DIR__"yongdao5",
    "southwest" : __DIR__"andao1",
  ]));
  set("objects", ([
    __DIR__"npc/bianfu" : 1,
    __DIR__"npc/mahuang" : 1,
  ]));
  setup();
}

void init()
{
  add_action("do_han", "han");
}

int valid_leave(object me, string dir)
{
  object bianfu = present("bianfu jing",this_object());
  object mahuang = present("mahuang guai",this_object());
  object ridee = me->query_temp("is_riding");

  if (objectp(ridee))
    return notify_fail("那里面可骑不了坐骑！\n");

  if (userp(me) && dir == "southwest")
  {
    if (objectp(bianfu) && objectp(mahuang))
      return notify_fail("守洞的妖怪挡住了你的去路！\n");
  }

  return ::valid_leave(me,dir);
}

int do_han(string arg)
{
  object me = this_player();
  object ridee = me->query_temp("is_riding");

  if (me->query("family/master_id") != "huomo shenjun")
    return 0;
  if (!arg || (arg != "火魔神君" && arg != "huomo") )
    return notify_fail("你大喊大叫什么？\n");

  if (objectp(ridee))
    return notify_fail("你先下了坐骑吧！\n");

  message_vision("$N恭恭敬敬的喊道：拜见魔君！\n",me);
  message_vision("突然一片红光罩住了$N，红光一暗后，$N已经不见了踪影！\n",me);
  me->move(__DIR__"dongnei");
  message_vision("一阵红光闪动后，$N显出了身形！\n",me);
  return 1;
}

