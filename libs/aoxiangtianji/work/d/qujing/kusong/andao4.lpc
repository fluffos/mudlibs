inherit "/d/qujing/kusong/andao1";
void create ()
{
  ::create();
}

void init()
{
  add_action("do_west", "west");
  add_action("do_east", "east");
  add_action("do_south", "south");
  add_action("do_north", "north");
}

int do_west()
{
  object me = this_player();

  message_vision("$N往西摸黑走了过去。\n",me);
  me->move(sprintf("/d/qujing/kusong/andao%d",5+random(4)));
  message_vision("$N摸黑走了过去。\n",me);
  return 1;
}

int do_east()
{
  object me = this_player();

  message_vision("$N往东摸黑走了过去。\n",me);
  me->move(sprintf("/d/qujing/kusong/andao%d",1+random(4)));
  message_vision("$N摸黑走了过去。\n",me);
  return 1;
}

int do_south()
{
  object me = this_player();

  message_vision("$N往南摸黑走了过去。\n",me);
  me->move(sprintf("/d/qujing/kusong/andao%d",1+random(4)));
  message_vision("$N摸黑走了过去。\n",me);
  return 1;
}

int do_north()
{
  object me = this_player();

  message_vision("$N往北摸黑走了过去。\n",me);
  me->move(sprintf("/d/qujing/kusong/andao%d",1+random(4)));
  message_vision("$N摸黑走了过去。\n",me);
  return 1;
}