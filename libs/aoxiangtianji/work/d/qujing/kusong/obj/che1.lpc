inherit ITEM;
void honghaier_appearing (object who);
void create()
{
  set_name("金车", ({ "jin che"}) );
  set_weight(100);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("value",100);
    set("unit", "辆");
    set("no_get",1);
    set("che_num",1);
    set("long","一辆很不寻常的车。\n");
  }

  setup();
}

void init()
{
  add_action("do_break","break");
}

int do_break(string arg)
{
  int i;
  object me = this_object();
  object ob = this_player();
  object where = environment();
  object hong=find_living("honghai er");
  i = (int)me->query("che_num");
  if( ob->query("force") < 500 )
    return notify_fail("你的内力不够。\n");
  if( ! arg || !id(arg))
    return notify_fail("你要砸什么？\n");
  if( present("honghai er",where) )
  {
    tell_object(ob,"红孩儿对你大吼一声：给我住手。\n");
    hong->kill_ob(ob);
    return 1;
  }

  message_vision("只见$N对着" + me->name() + "狠命的砸去，没多大时间，" +
                 me->name() +"就被砸个稀巴烂。\n",ob);
  ob->set_temp(sprintf("che%d_broken",i),1);
  honghaier_appearing(ob);
  ob->set("force",10);
  destruct(this_object());
  return 1;
}

void honghaier_appearing (object who)
{
  object honghaier;
  if (! objectp(who) ||
      ! environment(who) ||
      (int)who->query("obstacle/number") != 12 ||
      (string)who->query("obstacle/huoyun") == "done" ||
      ! who->query_temp("che1_broken") ||
      ! who->query_temp("che2_broken") ||
      ! who->query_temp("che3_broken") ||
      ! who->query_temp("che4_broken") ||
      ! who->query_temp("che5_broken"))
    return;

  honghaier = new ("/d/qujing/kusong/npc/honghaier");
  honghaier->move(environment(who));
  who->set_temp("kusong_killed",1);
  message_vision ("一团红色的烟雾涌了过来,红孩儿突然从里面蹦了出来.\n",who);
  message_vision ("$N手中火尖枪朝$n一指:大胆臭贼,敢破坏我的五行车.\n",honghaier,who);
  message_vision ("只听一声$N怒喝:我就说父王怎么会来看我.臭贼拿命来.\n",honghaier,who);
  who->command("bian");
  honghaier->kill_ob(who);
}

