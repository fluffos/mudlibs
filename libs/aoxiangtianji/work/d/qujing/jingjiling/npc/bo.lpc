#include <ansi.h>
inherit NPC;
void reset_me ();
mapping poem = ([
    "花间一壶酒" : "独酌无相亲",
    "停杯投箸不能食" : "拔剑四顾心茫然",
    "抽刀断水水更流" : "举杯销愁愁更愁",
    "十四为君妇" : "羞颜未尝开",
    "春风不相识" : "何事入罗帏",
    "君不见，黄河之水天上来" : "奔流到海不复回",
    "云想衣裳花想容" : "春风拂槛露华浓",
    "名花倾国两相欢" : "常得君王带笑看",
    "噫吁戏，危乎高哉！蜀道之难" : "难于上青天",
    "明月出天山" : "苍茫云海间",
    "我醉欲眠卿且去" : "明朝有意抱琴来",
    "美人一笑褰珠箔" : "遥指红楼是妾家",
    "五岳寻仙不辞远" : "一生好入名山游",
    "安能摧眉折腰事权贵" : "使我不得开心颜",
    "一枝红艳露凝香" : "云雨巫山枉断肠",
    "月下飞天镜" : "云生结海楼",
    "夕阳无限好" : "只是近黄昏",
    "只在此山中" : "云深不知处",
    "我本楚狂人" : "凤歌笑孔丘",
    "请君试问东流水" : "别意与之谁短长",
    "昔有佳人公孙氏" : "一舞剑器动四方",
    "大弦嘈嘈如急雨" : "小弦切切如私语",
    "谁怜越女颜如玉" : "贫贱江头自浣纱",
    "岱宗夫如何" : "齐鲁青未了",
    "大道如青天" : "我独不得出",
    "三月三日天气新" : "长安水边多丽人",
    "黄昏胡骑尘满城" : "欲往城南望城北",
    "金樽清酒斗十千" : "玉盘珍羞值万钱",
    "故人具鸡黍" : "邀我至田家",
    "吾爱孟夫子" : "风流天下闻",
]);
void create()
{
  set_name("孤直公", ({"guzhi gong", "gong"}));
  set("age", 90);
  set("attitude", "peaceful");
  set("gender", "男性");
  set("class", "yaomo");
  set("title", "深山四操");
  set("nickname", "乌栖凤宿");
  set("str", 30);
  set("int", 30);
  set("per", 30);
  set("con", 30);
  set("dex", 30);
  set("max_kee",5000);
  set("max_sen", 5000);
  set("combat_exp", 2500000);
  set("daoxing", 2500000);
  set("force", 6000);
  set("max_force", 3000);
  set("mana",6000);
  set("max_mana", 3000);
  set("mana_factor", 150);
  set("force_factor", 150);

  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("stick", 200);
  set_skill("wuxiangforce", 200);
  set_skill("dao", 200);
  set_skill("jindouyun", 200);
  set_skill("puti-zhi", 200);
  set_skill("puti-stick", 200);

  map_skill("force","wuxiangforce");
  map_skill("spells","dao");
  map_skill("dodge","jindouyun");
  map_skill("unarmed","puti-zhi");
  map_skill("stick","puti-stick");
  map_skill("parry","puti-stick");
  setup();
  carry_object("/d/qujing/jingjiling/obj/zhang")->wield();
  carry_object("/d/qujing/jingjiling/obj/cloth")->wear();
}

int accept_fight(object ob)
{
  object me = this_object();
  object who=this_player();
  if(me->is_fighting() )
    return notify_fail("孤直公对你说：没见老夫正忙着那么？\n");
  if( (int)me->query("kee")*100/(int)me->query("max_kee") < 80 )
    return notify_fail("孤直公对你说：老夫体乏无力，比不得，比不得。\n");

  if( who->query_temp("jjl_poem/" + me->query("id")) )
  {
    command("say 好，好，你我切搓武艺，点到为止！\n");
    reset_me ();
    call_out ("check_fight",1,me,who);
    return 1;
  }

  command("say 且待老夫考你一考。\n");
  who->set_temp("jjl_answer", me->query("id"));
  call_out("ask_poem", 3, who);
  return 0;
}

void ask_poem(object who)
{
  string *kp;
  string p, msg;
  object me=this_object();

  if (!me || !who)
    return;
  if (!present(who, environment(me)))
    return;

  kp = keys(poem);
  p = element_of(kp);

  who->set_temp("jjlpoem",p);

  msg = HIC"$N" HIC"对$n" HIC"问道：“" + HIY + p + HIC"”的下句是什么？\n"NOR;
  msg += HIC"$N" HIC"说：老夫限你三十秒内回答(answer)。\n"NOR;
  message_vision(msg, me, who);
  me->set_temp("check_answer", 1);
  call_out("say_answer", 30,who);
  return;
}

void say_answer(object who)
{
  object me=this_object();

  if (!me || !who)
    return;

  if (!present(who, environment(me)))
  {
    who->delete_temp("jjlpoem");
    return;
  }

  command("sigh");
  command("say 连这都不知道，老夫不屑与你一斗！\n");
  this_object()->delete_temp("check_answer");
  who->delete_temp("jjlpoem");
  who->delete_temp("jjl_answer");
  return ;
}

void init()
{
  add_action("do_answer", ({"answer","huida"}));
}

int do_answer(string arg)
{
  string p;
  object me = this_object();
  object who = this_player();
  object where;

  if (!me || !who || environment(me) != environment(who))
    return 0;

  where=environment(me);
  if( !me->query_temp("check_answer"))
  {
    return notify_fail("回答我干什么？\n");
  }

  p = who->query_temp("jjlpoem");
  if (!stringp(p))
  {
    return notify_fail("你有需要回答的问题吗？\n");
  }

  if( !arg || strlen(arg) > 30)
    return notify_fail("你说什么？\n");
  message_vision("$N答道：是“" + arg + "”。\n", who);
  if( who->query_temp("jjl_answer") == me->query("id"))
  {
    if( strsrch(arg, poem[p]) >=0  )
    {
      command("haha");
      command("say 不错，不错！老夫就与你过两招。\n");
      who->set_temp("jjl_poem/" + me->query("id"), 1);
      who->delete_temp("jjl_answer");
      who->delete_temp("jjlpoem");
      me->delete_temp("check_answer");
      if(where->query("short") != "石崖")
      {
        command("say 这里不甚宽敞，你我石崖一聚。\n");
        message_vision("$N身影一晃便不见了。\n", me);
        me->move("/d/qujing/jingjiling/shiya");
        message_vision("$N走了过来。\n", me);
      }

      remove_call_out("say_answer");
      return 1;
    }

    else
    {
      command("shake");
      command("say 不对，不对！\n");
      return 1;
    }

  }

  else
  {
    command("sigh " + this_player()->query("id") );
    command("say 多嘴，多嘴！");
    return 1;
  }

}

void announce_success (object who)
{
  int dx,qn;
  if (who->query("obstacle/number") != 21 ||
      who->query("obstacle/jingjiling") == "done")
    return;
  if (!who->query_temp("obstacle/jingjiling/guzhi gong"))
    return;
  if (!who->query_temp("obstacle/jingjiling/lingkong zi"))
    return;
  if (!who->query_temp("obstacle/jingjiling/shiba gong"))
    return;
  if (!who->query_temp("obstacle/jingjiling/fuyun sou"))
    return;

  dx = random(1600);
  dx += 16000;
  qn = dx/3;
  who->set("obstacle/number",22);
  who->set("obstacle/jingjiling","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  command("chat "+who->query("name")+"荆棘岭斗智斗武，力挫众仙！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed jingjiling on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
}

void player_win (object me, object who)
{
  me->remove_all_enemy();
  who->set_temp("obstacle/jingjiling/"+me->query("id"),1);
  message_vision("$N对$n一鞠躬：不错，不错！\n",me,who);
  me->announce_success(who);
}

void player_lose (object me, object who)
{
  me->remove_all_enemy();
  message_vision("$N对$n一挥手：去吧，去吧！\n",me,who);
}

void check_fight (object me, object who)
{
  int my_kee, whos_kee;
  int my_max_kee, whos_max_kee;
  if (!me || !who || environment(me) != environment(who))
    return;
  if (me->is_fighting(who))
  {
    if (random(5) == 0)
      reset_me ();
    call_out ("check_fight",1,me,who);
    return;
  }

  if (me->query_temp("last_opponent") != who)
    return;

  if (me->query_last_damage_from() != who)
    return;

  if (!present(who, environment(me)))
    return;

  my_kee = me->query("kee");
  whos_kee = who->query("kee");
  my_max_kee = me->query("max_kee");
  whos_max_kee = who->query("max_kee");
  if ((my_kee*100/my_max_kee) <= 50)
    player_win (me, who);
  else if ((whos_kee*100/whos_max_kee) <= 50)
    player_lose (me, who);
}

void reset_me ()
{
  object me = this_object();
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("kee", (int)me->query("max_kee"));
  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("sen", (int)me->query("max_sen"));
}

