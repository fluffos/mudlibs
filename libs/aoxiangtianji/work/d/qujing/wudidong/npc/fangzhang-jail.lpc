inherit NPC;
string quest_complete();
void create()
{
  set_name("圆清",({"yuan qing", "yuan", "qing", "fang zhang", "monk", "yuanqing"}));
  set("title","方丈");
  set("gender", "男性");
  set("age", 80);
  set("long","一个削瘦的老和尚，似乎被吓疯了。\n");
  set("combat_exp",5000);
  set("str",30);
  set("per",30);
  set("int",30);
  set("attitude", "peaceful");
  set("inquiry", ([
   "name"   : "唉！老纳本是灵云寺的圆清长老。",
   "here"   : "我也不知道怎么回事。那天晚上我正念佛呢，突然就被一阵阴风刮这里来了。",
   "rumors" : "我连自己的生死都不知，还有什么闲心去打听别的？",
   "生死"   : "也不知有没有哪位英雄肯来搭救我。唉！",
   "rescue" : (: quest_complete :),
   "搭救"   : (: quest_complete :),
  ]));
  setup();
  carry_object("/obj/cloth/linen")->wear();
}

string quest_complete()
{
  object me=this_player();

  if (me->query("obstacle/number") != 27 ||
      me->query("obstacle/wudidong") == "done")
    return "多谢施主再次想起了老衲！\n";

  if (!me->query_temp("mark/wudidong_opened_door") ||
      me->query_temp("mark/wudidong_no_hope_of_knowing_trap"))
  {
      command("say 你、你、你，你是谁？哦，你是来救我的？看你这样子不象啊？");
      command("say 你也是被别人打晕了背进来的吧？我要是跟你出去了，还得给抓回来。");
      return "阿弥陀佛，我佛慈悲！贫僧的这张草铺就让给你吧。";
  }

  call_out("award", 1, me);
  me->start_busy(1);
  return "有人来救我了？\n";
}

int award(object me)
{
  int dx, qn;
  if (!me)
    return 0;

  command("thank");
  command("say 老纳这就起程回寺！");
  me->set("obstacle/number",28);
  me->set("obstacle/wudidong","done");
  me->delete_temp("mark/wudidong_opened_door");
  dx = random(3200);
  dx += 32000;
  qn = dx/3;
  me->add("daoxing",dx);
  me->add("potential",qn);
  me->add("obstacle/dx",dx);
  me->add("obstacle/qn",qn);
  command("chat "+me->query("name")+"独闯无底洞，救我脱离苦难！");
  command("chat "+me->query("name")+"顺利闯过西行又一关！");
  tell_object(me,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed wudidong on %s\n",
             me->name(1), geteuid(me), ctime(time()) ) );
  me->save();
  command("south");
  destruct(this_object());
  return 1;
}

