#include <ansi.h>
inherit NPC;
void create()
{
  set_name("黑骷髅", ({"hei kulou", "yao", "kulou", "skeleton", "monster"}));
  set("long","这明明是一付干枯的骸骨，但不知怎么他竟然是活的！\n");
  set("age", 200+random(200));
  set("attitude", "peaceful");
  set("chat_chance", 5);
  set("chat_msg", ({
    "骷髅道：唉，也不知在这里睡了多久了。\n",
    "骷髅道：都忘了人肉是什么味儿了。\n",
  }) );
  set("inquiry", ([
    "name" : "名字？什么名字？我早就不记得了。",
    "here" : "这里？这里是个破洞。要不是那个混帐绿毛老鼠叫我看着，我早出去吃人肉，享清福了！",
    "rumors" : "嘿嘿，我都在这里睡这么多年了，还能知道点什么？",
    "人肉" : "唉。能吃上点人肉就好了。",
  ]));

  set("combat_exp", 1200000 + random(600000));
  set("daoxing", 1200000 + random(600000));
  set("str", 20+random(35));
  set("spi", 20+random(35));
  set("con", 20+random(35));
  set("dex", 20+random(35));
  set_skill("force", 120 + random(50));
  set_skill("spells", 120 + random(50));
  set_skill("dodge", 120 + random(50));
  set_skill("unarmed", 120 + random(50));
  set_skill("parry", 120+random(50));
  set_skill("blade", 120+random(50));

  set_skill("huntian-qigong",120+random(50));
  set_skill("yaofa",120+random(50));
  set_skill("lingfu-steps",120+random(50));
  set_skill("changquan",120+random(50));
  set_skill("kuangfeng-blade",120+random(50));

  set("max_sen",1200 + random(400));
  set("max_kee",1200 + random(400));
  set("force",3000 + random(1000));
  set("max_force",2000);
  set("mana",3000 + random(1000));
  set("max_mana",2000);
  set("force_factor", 100);
  set("mana_factor", 100);

  map_skill("force", "huntian-qigong");
  map_skill("spells", "yaofa");
  map_skill("dodge", "lingfu-steps");
  map_skill("unarmed", "changquan");
  map_skill("blade", "kuangfeng-blade");
  map_skill("parry", "kuangfeng-blade");
  setup();
  carry_object(sprintf("/d/qujing/obj/armor/armor%d",1+random(4)))->wear();
  carry_object(sprintf("/d/qujing/obj/armor/cloth%d",1+random(3)))->wear();
  carry_object("/d/obj/weapon/blade/kugudao")->wield();
  carry_object("/d/obj/book/wdd_kfbook");
}

void init()
{
  object ob;
  ::init();
  if (interactive(ob=this_player()) && !is_fighting())
  {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}

void greeting(object me)
{
  string myrude=RANK_D->query_rude(me);
  command("hehe "+me->query("id"));
  command("say 你这"+myrude+"来干什么？是不是带好东西孝敬我来着？");
  return;
}

int accept_object(object me, object ob)
{
  if (ob->query("name_recognized") == "人肉包子")
  {
    command("say 不错不错，你小子果然还没忘了我！");
    me->add_temp("wudidong/gave_bookguard_baozi", 1);
    this_object()->command("give book to " + me->query("id"));
    return 1;
  }

  command("say 什么破烂？");
  return 0;
}

