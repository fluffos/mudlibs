#include <ansi.h>
#include "wdd.h"
inherit NPC;
inherit F_MASTER;
string say_key();
string ask_rank();
void create()
{
  set_name("玉鼠精", ({"yu shu","yushu", "shu", "monster"}));
  set_weight(1000000);
  set("gender", "女性" );
  set("age", 23);
  set("long",
"她就是这无底洞的洞主了。她从修道成人行以来，吃人无数，\n"
"也不知为什么玉皇还未曾派兵来围剿。听说她在天宫有亲，也\n"
"不知真假。\n");
  set("title", "地涌夫人");
  set("combat_exp", 5000000);
  set("daoxing", 5000000);
  set("attitude", "heroic");
  set("class","yaomo");
  create_family("陷空山无底洞", 1, "弟子");
  set("int", 25+random(5));
  set("cor", 30+random(10));
  set("per", 50);
  set("max_kee", 8000);
  set("max_sen", 8000);
  set("force", 7000);
  set("max_force", 3500);
  set("force_factor", 170);
  set("mana",7000);
  set("max_mana", 3500);
  set("mana_factor", 170);

  set("inquiry",([
    "职位" : (: ask_rank :),
    "key": (: say_key :),
    "钥匙": (: say_key :),
    "name": "老娘就是这无底洞的开山祖师！",
    "here": "这里就是陷空山无底洞！就算你调十万天兵来也奈何我不得！",
    "rumors": "老娘刚刚抓住一个和尚。看来马上就有新鲜人肉吃了。",
    "人肉包子": "混帐！饿了不会去找厨子？",
    "和尚": "嘿嘿，眼下正饿着他呢。等他肠子干净了就可以蒸熟了吃了。\n"
    "不过也该派人去看看他了。说不定他已经饿死了。",
    "看看": "要看看也行，就是不知道我把钥匙放哪儿了。",
  ]));
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: cast_spell, "qunshu" :),
    (: perform_action, "blade.diyu" :),
    (: perform_action, "blade.xuelang" :),
    (: perform_action, "blade.wuheng" :),
    (: perform_action, "blade.pozhan" :),
  }) );
  set_skill("literate", 300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("sword", 300);
  set_skill("blade", 300);
  set_skill("throwing", 300);
  set_skill("huntian-qigong", 300);
  set_skill("yaofa", 300);
  set_skill("lingfu-steps", 300);
  set_skill("yinfeng-zhua", 300);
  set_skill("qixiu-sword", 300);
  set_skill("kugu-blade",300);
  set_skill("medical",300);
  set_skill("lingshu-yishu",300);
  map_skill("medical","lingshu-yishu");
  set_skill("mantianxing", 300);
  map_skill("throwing","mantianxing");
  set_skill("dagger",300);
  set_skill("chike-dagger",300);
  map_skill("dagger","chike-dagger");

  map_skill("force","huntian-qigong");
  map_skill("spells","yaofa");
  map_skill("dodge","lingfu-steps");
  map_skill("unarmed","yinfeng-zhua");
  map_skill("parry","kugu-blade");
  map_skill("blade","kugu-blade");
  map_skill("sword","qixiu-sword");
  setup();

  carry_object("/d/obj/weapon/blade/yanblade")->wield();
  carry_object("/obj/cloth/nichang")->wear();
  carry_object("/obj/cloth/yuanxiang")->wear();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "陷空山无底洞")
  {
    command("say 我只收无底洞弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 32)
  {
    command("say 你还需要多加磨练！\n");
    return 0;
  }

  if ((int)ob->query("obstacle/number") < 34)
  {
    command("say 你尚未取经圆满，我还不能收你！\n");
    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "陷空山无底洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是无底洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解老鼠的特点，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 32)
  {
    command("say 你还需要多加磨练，才可以明白我的讲授！\n");
    return 1;
  }

  if (skill == "kugu-blade")
  {
    if (!me->query("family/can_learn/kugu-blade"))
    {
      command("say 你现在学不了！\n");
      return 1;
    }

  }

  return 0;
}

string say_key()
{
  int t = time();
  object me=this_player(), ob, npc=this_object();
  int mykar=me->query_kar();
  int real_key_condition;
  if(npc->is_fighting() || me->is_fighting())
    return ("没门！等着点！");
  if (me->is_busy())
    return "慢点！你好忙啊！\n";

  if (member_array("tian shu",me->parse_command_id_list())==-1 )
  {
    call_out("killplayer", 1, me);
    return ("哪儿来的"+RANK_D->query_rude(me)+"？找死！");
  }

  if ((t - (int)me->query_temp("last_wdd_key")) < 30)
  {
    call_out("killplayer", 1, me);
    return ("哪儿来的"+RANK_D->query_rude(me)+"？找死！");
  }

  message_vision(CYN"玉鼠对$N说：“好吧，拿去。”\n"NOR, me);
  if (npc->query_temp("gave_out_key"))
    real_key_condition = 0;
  else
    real_key_condition = 1;
  if (!real_key_condition)
  {
    ob=new("/d/qujing/wudidong/obj/key-fake");
  }

  else if (random(mykar)>8)
  {
    ob=new("/d/qujing/wudidong/obj/key-real");
    npc->set_temp("gave_out_key", 1);
  }

  else
    ob=new("/d/qujing/wudidong/obj/key-fake");
  ob->move(me);
  me->set_temp("mark/wudidong_yushu_gave_me_key", 1);
  me->set_temp("last_wdd_key",t);
  me->start_busy(3);
  return ("好好看守那秃驴！\n");
}

void killplayer(object me)
{
  this_object()->kill_ob(me);
}

void init()
{
  object me;
  ::init();
  if( playerp(me = this_player()) && !is_fighting() )
  {
    call_out("greeting", 1, me);
  }

}

void greeting(object me)
{
  int mykar=me->query_kar();
  string npcname=this_object()->query("name");
  string npcrude=RANK_D->query_self_rude(this_object());
  string myrude=RANK_D->query_rude(me);
  if( !me || environment(me) != environment() )
    return;
  if( me->query("family/family_name") == "陷空山无底洞")
    return;

  if( member_array("yu shu", me->parse_command_id_list())!=-1)
  {
    command("say 哪个混账？竟敢变成"+npcrude+"样子招摇撞骗？！找死！");
    kill_ob(me);
    return;
  }

  if( member_array("tian shu",me->parse_command_id_list())==-1 )
  {
    command("say 哪里来的"+myrude+"？无底洞不是你撒野的地方！拿命来！");
    command("kill " + me->query("id"));
    return;
  }

  if (me->query_temp("wdd_see_yushu"))
    return;

  me->set_temp("wdd_see_yushu",1);
  if( random(mykar) > 8)
    return;
  else
  {
    message_vision(CYN ""+npcname+"对$N大喝道：呔！什么东西！？休想从"+RANK_D->query_self_rude(this_object())+"眼下溜过去！\n"NOR, me);
    message_vision(npcname+"大喊一声：现！$N顿时现出原形，原来是"+me->query("name")+"！\n", me);
    me->command("bian");
    me->delete_temp("spellslevel");
    me->delete_temp("d_mana");
    me->delete_temp("apply/name");
    me->delete_temp("apply/id");
    me->delete_temp("apply/short");
    me->delete_temp("apply/long");
    kill_ob(me);
    return;
  }

}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我无底洞的弟子！\n";

  if (me->query("class") != "yaomo")
    return "嘿嘿，你非妖魔，问我何用？\n";

  switch (topic)
  {
    case "历练" :
    case "历炼" :
    case "锻炼" :
      return QUEST_D->accept_ask(master, me, topic);
      break;
//yaofa
    case "嗜血群鼠" :
    case "qunshu" :
      if (me->query("family/can_cast/qunshu"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("yaofa",1) < 120)
        return "你的妖法修为不够，暂时无法领悟！\n";
      if (me->query("max_mana") < 1500)
        return "你的法力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_cast/qunshu",1);
      return "你学会了“嗜血群鼠”！\n";
      break;
    case "速疗" :
    case "suliao" :
      if (me->query("family/can_cast/suliao"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("yaofa",1) < 80)
        return "你的妖法修为不够，暂时无法领悟！\n";
      if (me->query("max_mana") < 1000)
        return "你的法力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_cast/suliao",1);
      return "你学会了“速疗”！\n";
      break;
//kuangfeng-blade
    case "无痕一刀斩" :
    case "wuheng" :
      if (me->query("family/can_pfm/wuheng"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("kuangfeng-blade",1) < 80)
        return "你的狂风刀法修为不够，暂时无法领悟！\n";
      if (me->query_skill("huntian-qigong",1) < 80)
        return "你的混天气功修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 1000)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/wuheng",1);
      return "你学会了“无痕一刀斩”！\n";
      break;
//shixue-blade
    case "血浪滔天" :
    case "xuelang" :
      if (me->query("family/can_pfm/xuelang"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("shixue-blade",1) < 120)
        return "你的嗜血刀法修为不够，暂时无法领悟！\n";
      if (me->query_skill("huntian-qigong",1) < 120)
        return "你的混天气功修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 1500)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/xuelang",1);
      return "你学会了“血浪滔天”！\n";
      break;
//kugu-blade
    case "破绽百出" :
    case "pozhan" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "pfm"    : "pozhan",
           "name"   : "破绽百出",
           "sk1"    : "kugu-blade",
           "lv1"    : 220,
           "sk2"    : "huntian-qigong",
           "lv2"    : 220,
           "max_force" : 3000,
           "gongxian": 1200,]));
      break;

    case "无边地狱" :
    case "diyu" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "pfm"    : "diyu",
           "name"   : "无边地狱",
           "sk1"    : "kugu-blade",
           "lv1"    : 180,
           "sk2"    : "huntian-qigong",
           "lv2"    : 180,
           "max_force" : 2500,
           "gongxian": 800,]));
      break;
//zishu-sword
    case "妖雾冲天" :
    case "yaowu" :
      if (me->query("family/can_pfm/yaowu"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("zishu-sword",1) < 120)
        return "你的子鼠剑法修为不够，暂时无法领悟！\n";
      if (me->query_skill("huntian-qigong",1) < 120)
        return "你的混天气功修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 1500)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/yaowu",1);
      return "你学会了“妖雾冲天”！\n";
      break;
//qixiu-sword
    case "追腥逐血" :
    case "zxzx" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "pfm"    : "zxzx",
           "name"   : "追腥逐血",
           "sk1"    : "qixiu-sword",
           "lv1"    : 180,
           "sk2"    : "huntian-qigong",
           "lv2"    : 180,
           "max_force" : 2500,
           "gongxian": 800,]));
      break;
//daojian-hebi
    case "刀剑重重天" :
    case "tian" :
      if (me->query("family/can_pfm/tian"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 1500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("daojian-hebi",1) < 260)
        return "你的刀剑合壁修为不够，暂时无法领悟！\n";
      if (me->query_skill("huntian-qigong",1) < 260)
        return "你的混天气功修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 3500)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/tian",1);
      return "你学会了“刀剑重重天”！\n";
      break;

    case "天下有血" :
    case "xue" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "pfm"    : "xue",
           "name"   : "天下有血",
           "sk1"    : "daojian-hebi",
           "lv1"    : 300,
           "sk2"    : "huntian-qigong",
           "lv2"    : 300,
           "max_force" : 4000,
           "gongxian": 1800,]));
      break;
//chike-dagger
    case "闪电连击" :
    case "shandian" :
      if (me->query("family/can_pfm/shandian"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 1500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("chike-dagger",1) < 180)
        return "你的刺客匕修为不够，暂时无法领悟！\n";
      if (me->query_skill("huntian-qigong",1) < 180)
        return "你的混天气功修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 2500)
