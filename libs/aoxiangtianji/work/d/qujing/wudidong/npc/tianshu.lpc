#include <ansi.h>
#include "wdd.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("田鼠精", ({"tian shu", "tian", "shu", "tianshu", "monster"}));
  set("gender", "女性");
  set("age", 23);
  set("long",
"她就是无底洞的大管家。想当年她和玉鼠一齐修仙成了人形，\n"
"但因资质太差，成正果终究是无望。照顾着当年的交情，玉鼠\n"
"安排她做了这洞的管家。\n");
  set("title", "大管家");
  set("cor", 25);
  set("combat_exp", 500000);
  set("daoxing", 500000);
  set("attitude", "heroic");
  set("class","yaomo");
  create_family("陷空山无底洞", 3, "弟子");
  set("str", 30);
  set("per", 30);
  set("max_kee", 1300);
  set("max_sen", 1300);
  set("force", 2000);
  set("max_force", 1200);
  set("force_factor", 50);
  set("mana", 1800);
  set("max_mana", 1200);
  set("mana_factor", 60);
  set("inquiry", ([
        "name": "本姑娘就是这无底洞的大总管！",
        "here": "你瞎了眼啦？这里就是鼎鼎大名的陷空山无底洞！",
        "rumors": "不知道！找别人问去。",
        "人肉包子": "你瞎了眼啦？本姑娘又不是厨子！",
  ]) );

  set_skill("literate", 150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("sword", 150);
  set_skill("blade", 150);
  set_skill("throwing", 150);

  set_skill("huntian-qigong", 150);
  set_skill("yaofa", 150);
  set_skill("lingfu-steps", 150);
  set_skill("yinfeng-zhua", 150);
  set_skill("zishu-sword", 150);
  set_skill("kuangfeng-blade",150);
  set_skill("medical",150);
  set_skill("lingshu-yishu",150);
  map_skill("medical","lingshu-yishu");
  set_skill("mantianxing",150);
  map_skill("throwing","mantianxing");
  map_skill("force","huntian-qigong");
  map_skill("spells","yaofa");
  map_skill("dodge","lingfu-steps");
  map_skill("unarmed","yinfeng-zhua");
  map_skill("parry","kuangfeng-blade");
  map_skill("blade","kuangfeng-blade");
  map_skill("sword","zishu-sword");

  setup();
  carry_object("/d/obj/weapon/blade/gangdao")->wield();
  carry_object("/obj/cloth/yuanxiang")->wear();
  carry_object("/obj/cloth/nichang")->wear();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "陷空山无底洞")
  {
    command("say 我只收无底洞弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 15)
  {
    command("say 你还需要多加磨练！\n");
    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "陷空山无底洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是无底洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解老鼠的特点，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 15)
  {
    command("say 你还需要多加磨练，才可以明白我的讲授！\n");
    return 1;
  }

  return 0;
}

