#include <ansi.h>
#include "wdd.h"
inherit NPC;
inherit F_MASTER;
/************************************************************/
int accept_object(object me, object ob);
void bishu_leave(object me);
/************************************************************/
void create()
{
  set_name("碧鼠精", ({"bi shu", "bi", "shu", "bishu", "monster"}));
  set("gender", "女性");
  set("age", 19);
  set("long",
"虽然她看起来弱不禁风，但听说她天赋及佳，是块修仙的好料子。\n"
"自从入无底洞以来，她的武功进步及快，颇有赶过玉鼠的架式。\n");
  set("title", "无底洞大弟子");
  set("nickname", HIR"九死一生"NOR);
  set("combat_exp", 1500000);
  set("daoxing", 1500000);
  set("attitude", "heroic");
  set("class","yaomo");
  create_family("陷空山无底洞", 2, "弟子");
  set("cor", 50);
  set("str", 30);
  set("per", 30);
  set("max_kee", 3500);
  set("max_sen", 3500);
  set("force", 3500);
  set("max_force", 1800);
  set("force_factor", 90);
  set("mana", 3600);
  set("max_mana", 1800);
  set("mana_factor", 90);

  set("inquiry", ([
        "name": "本姑娘就是地涌夫人的开山大弟子！",
        "here": "你瞎了眼啦？这里就是鼎鼎大名的陷空山无底洞！",
        "rumors": "不知道！找别人问去。",
        "人肉包子": "你瞎了眼啦？本姑娘又不是厨子！",
  ]) );

  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("sword", 200);
  set_skill("blade", 200);
  set_skill("throwing", 200);
   set_skill("kugu-blade", 120);
  set_skill("qixiu-sword", 120);

  set_skill("huntian-qigong", 200);
  set_skill("yaofa", 200);
  set_skill("lingfu-steps", 200);
  set_skill("yinfeng-zhua", 200);
  set_skill("zishu-sword", 200);
  set_skill("kuangfeng-blade",200);
  set_skill("shixue-blade",200);
  set_skill("medical",200);
  set_skill("lingshu-yishu",200);
  map_skill("medical","lingshu-yishu");
  set_skill("mantianxing", 200);
  map_skill("throwing","mantianxing");

  map_skill("force","huntian-qigong");
  map_skill("spells","yaofa");
  map_skill("dodge","lingfu-steps");
  map_skill("unarmed","yinfeng-zhua");
  map_skill("parry","kuangfeng-blade");
  map_skill("blade","kuangfeng-blade");
  map_skill("sword","zishu-sword");

  setup();
  carry_object("/d/obj/weapon/blade/yanblade")->wield();
  carry_object("/obj/cloth/nichang")->wear();
  carry_object("/obj/cloth/yuanxiang")->wear();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "陷空山无底洞")
  {
    command("say 我只收无底洞弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 25)
  {
    command("say 你还需要多加磨练！\n");
    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "陷空山无底洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是无底洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解老鼠的特点，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 25)
  {
    command("say 你还需要多加磨练，才可以明白我的讲授！\n");
    return 1;
  }

  return 0;
}

int accept_object(object me, object ob)
{
  if (ob->query("name_recognized") != "白骨令")
    return notify_fail(CYN"碧鼠怒道：混帐，我又不是收破烂的！\n"NOR);
  remove_call_out("bishu_leave");
  call_out("bishu_leave", 1, me);
  return 1;
}

void bishu_leave(object me)
{
  command("say 这、这、这，这可怎么办是好？");
  command("sigh");
  command("say 既然夫人有令在此，我还是赶紧回去一趟吧！");
  message_vision("碧鼠精抓了一把土，向空中一抛，喝声：走！借土遁去了。\n", me);
  destruct(this_object());
  return;
}

