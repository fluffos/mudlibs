#include <ansi.h>
#include "wdd.h"
inherit NPC;
inherit F_MASTER;
string ask_baozi();
void create()
{
  set_name("鼹鼠", ({"yan shu", "yanshu", "monster", "chu zi", "cook"}));
  set("long",
"他几经修练，终于成了人形。但因他天生眼睛就不好，洞里没人\n"
"喜欢他。若不是因为他蒸得好包子，早被玉鼠赶出去了。\n");
  set("title", "厨子");
  set("gender", "男性");
  set("per", 10);
  set("age", 25);
  set("str", 70);
  set("class","yaomo");
  set("attitude", "peaceful");
  set("combat_exp", 300000);
  set("daoxing", 300000);
  set("max_kee", 1300);
  set("max_sen", 1300);
  set("force", 2000);
  set("max_force", 1200);
  set("force_factor", 50);
  set("mana", 1800);
  set("max_mana", 1200);
  set("mana_factor", 60);
  set_skill("literate", 150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("sword", 150);
  set_skill("blade", 150);
  set_skill("huntian-qigong", 150);
  set_skill("yaofa", 150);
  set_skill("lingfu-steps", 150);
  set_skill("yinfeng-zhua", 150);
  set_skill("zishu-sword", 150);
  set_skill("shixue-blade",150);
  map_skill("force","huntian-qigong");
  map_skill("spells","yaofa");
  map_skill("dodge","lingfu-steps");
  map_skill("unarmed","yinfeng-zhua");
  map_skill("parry","shixue-blade");
  map_skill("blade","shixue-blade");
  map_skill("sword","zishu-sword");

  set("inquiry", ([
     "name": "什么名字！我自己都不记得了！",
     "here": "这里是厨房，你看不出来？",
     "rumors" : "唉，那白毛老鼠又去抓了个和尚，还是得我来蒸！真烦！",
     "和尚": "找别人去问！",
     "人肉包子": (: ask_baozi :),
  ]));

  set("baozi",1);
  create_family("陷空山无底洞", 3, "弟子");
  setup();
  carry_object("/obj/cloth/linen")->wear();
  carry_object("/d/obj/weapon/blade/gangdao")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "陷空山无底洞")
  {
    command("say 我只收无底洞弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 15)
  {
    command("say 你还需要多加磨练！\n");
    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "陷空山无底洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是无底洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解老鼠的特点，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 15)
  {
    command("say 你还需要多加磨练，才可以明白我的讲授！\n");
    return 1;
  }

  return 0;
}

string ask_baozi()
{
  object baozi;
  object me = this_object();
  object who = this_player(1);

  if ((string)who->query("family/family_name") != "陷空山无底洞")
    return "你也想吃人肉包子？不怕坏了你的胃口啊！\n";

  if ((int)who->query("level") <= 15)
    return "去！就你，练高点在想吃肉包子吧！\n";

  if (!me->query("baozi"))
    return "可惜我这里没有了！\n";

  baozi = new("/d/qujing/wudidong/obj/baozi");
  baozi->move(who,1);
  me->set("baozi",0);
  write("你从鼹鼠那儿得到了一个肉包子！\n");
  return "拿去吧！\n";
}

