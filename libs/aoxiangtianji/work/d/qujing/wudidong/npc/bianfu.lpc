#include <ansi.h>
#include "wdd.h"
inherit NPC;
inherit F_MASTER;
void transform();
string ask_me();
void transform_back();
void mie_kou(object me);
void create()
{
  set_name("穷汉", ({"qiong han", "qiong", "han", "poor man","man"}));
  set("title", "普通百姓");
  set("long",
"他看起来一付穷困潦倒的样子，浑身没一件象样的衣服，瘦骨嶙峋的，\n"
"就象三年没吃过一顿饱饭似的。虽说长安城里这样的人比比皆是，但你\n"
"看他就是觉得不顺眼。仔细端详一番，你发现原来他全身长着一层淡淡\n"
"的茸毛。\n");
  set("combat_exp", 30000);
  set("daoxing", 30000);
  set("attitude", "peaceful");
  set("gender", "男性");
  set("age", 39);
  set("class","yaomo");
  create_family("陷空山无底洞", 4, "弟子");
  set_skill("literate", 90);
  set_skill("force", 90);
  set_skill("spells", 90);
  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("parry", 90);
  set_skill("sword", 80);
  set_skill("stealing", 50);
  set_skill("huntian-qigong", 90);
  set_skill("yaofa", 90);
  set_skill("lingfu-steps", 90);
  set_skill("yinfeng-zhua", 90);
  set_skill("zishu-sword", 90);
  set("str", 20);
  set("dex", 20);
  set("cor", 100);
  set("int", 20);
  set("spi", 30);
  set("cps", 100);
  set("per", 10);
  set("con", 40);
  set("kar", 20);

  set("env/wimpy", 70);
  set("max_kee", 800);
  set("max_sen", 800);
  set("force", 350);
  set("max_force", 350);
  set("mana", 350);
  set("max_mana", 300);
  set("inquiry", ([
        "name": "这个……我这穷汉的名字对你又有什么用了？",
        "here": "这里？你问我我问谁去？",
        "rumors": "听说最近附近有些老鼠精在长安城出没。唉。",
        "老鼠精": "我听说他们是个什么什么山什么什么洞的，也不知咋回事。",
        "陷空山": (: ask_me :),
        "无底洞": (: ask_me :),
  ]) );
  setup();
  carry_object("/obj/cloth/linen")->wear();
}

int attempt_apprentice(object me)
{
  string myfam;
  object bianfu;
  string myid = me->query("id");

  if (me != this_player(1))
    return 0;

  bianfu = this_object();

  if (bianfu->query("accept_dizi") != me->query("id"))
    return 0;

  myfam = (string)me->query("family/family_name");

  if (stringp(myfam))
  {
    if (myfam == "陷空山无底洞")
    {
      command("say 不敢当，不敢当！\n");
      return 0;
    }

    else
    {
      command("shake");
      return 0;
    }
  }

  command("spank "+myid);
  command("say 不错不错。");
  command("say 但你要经得起考验才能真正学到我无底洞的高深武功。");
  command("recruit "+myid);
  if ((string)me->query("class") != "yaomo")
    me->set("class", "yaomo");
  bianfu->delete("accept_dizi");
  return 1;
}

string ask_me()
{
  object bianfu, me;
  string myfam, dizi;

  me = this_player(1);
  bianfu = this_object();
  myfam = (string)me->query("family/family_name");

  if (stringp(myfam))
  {
    if (myfam == "陷空山无底洞")
    {
      command("nod");
      return "这你还用问我？！\n";
    }

    else
    {
      command("shake");
      return "你说什么，听不懂？！\n";
    }
  }

  dizi = (string)bianfu->query("accept_dizi");
  if (stringp(dizi))
  {
    if (dizi == me->query("id"))
    {
      command("say 若是想拜我无底洞，尽管说！");
      return "否则就别怪我杀人灭口了！\n";
    }

    else
    {
      command("say 请等会，我正忙着收别人做弟子呢！\n");
      return "稍等一会，马上就好了！\n";
    }
  }

  command("hehe");
  command("say 实话告诉你吧！大爷我就是无底洞的上仙！");
  bianfu->set("accept_dizi", me->query("id"));
  command(sprintf("say %s，你可愿意入我无底洞？",me->name()));
  tell_object(me,"看起来蝙蝠想要收你做徒弟，如果你愿意，可以拜他为师！\n");
  remove_call_out("mie_kou");
  call_out("mie_kou", 10, me);
  return "嘿嘿，你若是不愿，可莫怪我心狠手辣！\n";
}

void transform()
{
  object weapon;
  if(!interactive())
    return;
  set_name("蝙蝠精", ({"bian fu", "bianfu", "fu", "bat", "monster"}));
  set("title", "上仙");
  set("long",
"这明明是一只巨大的蝙蝠，但不知为何竟然会说人话！\n");
  set("combat_exp", 100000);
  set("daoxing", 100000);
  weapon=new("/d/obj/weapon/sword/changjian");
  weapon->move(this_object());
  command("wield sword");
  command("enable force huntian-qigong");
  command("enable unarmed yinfeng-zhua");
  command("enable spells yaofa");
  command("enable sword zishu-sword");
  command("enable parry zishu-sword");
  command("enable dodge lingfu-steps");
  this_object()->set("wudidong_state", 1);
  message_vision(HIY"穷汉摇身一变，现了原形。原来是只蝙蝠！\n"NOR, this_object());
}

void mie_kou(object me)
{
  string myid ;
  object bianfu;
  int count;
  bianfu = this_object();
  if (!objectp(bianfu))
    return;

  if(!living(bianfu))
  {
    bianfu->die();
    return;
  }

  if (!objectp(me) || !playerp(me))
  {
    bianfu->delete("accept_dizi");
    return;
  }

  myid = me->query("id");

  if ((string)me->query("family/family_name") == "陷空山无底洞")
  {
    command("pat " + myid);
    command("say 不错，识时务者俊杰！");
    remove_call_out("transform_back");
    call_out("transform_back", 10);
    bianfu->delete("accept_dizi");
    return;
  }

  if (!present(myid, environment()))
  {
    command("sneer");  // laugh at the cowards
    command(sprintf("say 幸亏%s溜得快。否则，哼！哼！哼！",me->name()));
    call_out("transform_back", 10);
    bianfu->delete("accept_dizi");
    return;
  }

  count = (int)bianfu->query("miekou_count");
  if (count < 6)
  {
    switch (count)
    {
      case 0 :
        command("say 你就考虑考虑吧，时间别太长了！\n");
        break;
      case 1 :
        command("say 还不能做决定吗？\n");
        command("look " + myid);
        break;
      case 2 :
        command("kick " + myid);
        break;
      case 3 :
        command("hammer " + myid);
        break;
      case 4 :
        tell_object(me,"看起来穷汉已经很不耐烦了，如果不想拜他为师，还是赶紧溜吧！\n");
        command("hurry " + myid);
        break;
      default :
        tell_object(me,"看起来穷汉已经很不耐烦了，如果不想拜他为师，还是赶紧溜吧！\n");
        command("say 我可没有心思和你玩，最后的机会，在不决定，别怪我无情！\n");
        break;
    }

    count++;
    bianfu->set("miekou_count",count);
    call_out("mie_kou", 10, me);
    return;
  }

  bianfu->delete("miekou_count");

  if (!bianfu->query("wudidong_state"))
    transform();
  bianfu->delete("accept_dizi");

  command("say "+me->name()+"，你既然执迷不悟，那就纳命来吧！");
  command("kill " + myid);
  remove_call_out("transform_back");
  call_out("transform_back", 10);
  return;
}

void transform_back()
{
  object weapon, me = this_object();
  if(!me->query("wudidong_state"))
  {
    me->delete("accept_dizi");
    return;
  }

  if(!living(me))
  {
    me->die();
    return;
  }

  if (me->is_fighting())
  {
    remove_call_out("transform_back");
    call_out("transform_back", 10);
    return;
  }

  me->delete("accept_dizi");

  if (objectp(weapon=present("sword", me)))
  {
    weapon->unequip();
    destruct(weapon);
  }

  message_vision(HIY"$N摇身一变，变成了个穷汉！\n"NOR, me);
  me->delete("wudidong_state");

  set_name("穷汉", ({"qiong han", "qiong", "han", "poor man","man"}));
  set("title", "普通百姓");
  set("long",
"他看起来一付穷困潦倒的样子，浑身没一件象样的衣服，瘦骨嶙峋的，\n"
"就象三年没吃过一顿饱饭似的。虽说长安城里这样的人比比皆是，但你\n"
"看他就是觉得不顺眼。仔细端详一番，你发现原来他全身长着一层淡淡\n"
"的茸毛。\n");
  set("combat_exp", 3000);
  set("daoxing", 30000);
  set("attitude", "peaceful");
  command("enable parry none");
  command("enable dodge none");
  command("enable force none");
  command("enable sword none");
  command("enable spells none");
  return;
}