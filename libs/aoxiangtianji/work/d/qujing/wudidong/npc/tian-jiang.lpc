#include <ansi.h>
inherit "/d/qujing/npc/yaojing";
string *first_name = ({ "龙蚂蚱","龙小草","龙害虫","龙格格","龙雪豹","龙老蟹","龙未名","龙老余"});
void create()
{
  string name;
  ::create();
  name = element_of(first_name);
  set_name(name, ({ "long shi", "long", "shi" }) );
  set("gender", "男性" );
  set("long",
"这是从海底各族里精选出来的武士\n"
"他细腰乍臂，双肩抱拢，一看就知武艺高强。\n");
  set("title", "龙士");
  set("age", 25+random(10));
}