inherit NPC;
void create()
{
  set_name("老王爷", ({"lao wangye", "wangye", "wang", "ye"}));
  set("title", "玉华县");
  set("gender", "男性");
  set("age", 60);
  set("per", 25);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 100000);
  set("daoxing", 50000);
  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_skill("parry", 60);
  set("max_gin",1600);
  set("max_kee",1600);
  set("max_sen",1600);
  set("max_force",600);
  set("max_mana",600);
  set("force_factor",50);
  setup();
  carry_object("/d/obj/armor/cloth/mangpao")->wear();
}

void announce_success (object who)
{
  int dx, qn;
  if (who->query("obstacle/number") != 31 ||
      who->query("obstacle/yuhua") == "done" ||
      !who->query_temp("obstacle/yuhua_bang") ||
      !who->query_temp("obstacle/yuhua_pa") ||
      !who->query_temp("obstacle/yuhua_zhang"))
    return;
  dx = random(3800);
  dx += 38000;
  qn = dx/3;
  who->set("obstacle/number",32);
  who->set("obstacle/yuhua","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  who->delete_temp("obstacle/yuhua_bang");
  who->delete_temp("obstacle/yuhua_pa");
  who->delete_temp("obstacle/yuhua_zhang");
  command("chat "+who->query("name")+"豹头山寻得三兵器，竹节山制服九头狮怪！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed yuhua on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}

