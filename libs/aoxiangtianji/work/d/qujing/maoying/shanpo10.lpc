inherit "/d/qujing/maoying/shanpo1";
void create ()
{
  ::create();
  set("exits", ([
    "northwest"   : __DIR__"shanpo8",
    "southwest"   : __DIR__"shanpo12",
  ]));
}

void init ()
{
  add_action ("do_enter", "enter");
}

int do_enter ()
{
  object ridee;
  object who = this_player();
  string location = sprintf("/d/qujing/maoying/tuxue%d",1+random(3));
  if (objectp(ridee = who->query_temp("is_riding")))
    return notify_fail("你还是先下了坐骑吧！\n");
  if (find_object(location) || load_object(location))
  {
    message_vision ("$N在蒿草石缝中扒开一个洞，钻了进去。\n",who);
    who->move(location);
  }

  else
    return notify_fail("没有找到你要去的地方！\n");
  return 1;
}