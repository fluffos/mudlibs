#include <ansi.h>
inherit NPC;
void create()
{
  set_name(HIW"银角大王"NOR, ({ "yinjiao dawang", "yinjiao", "dawang", "wang" }));
  set("title", "莲花洞");
  set("long", "一位神态傲然的莲花洞妖王。\n");
  set("gender", "男性");
  set("age", 54);
  set("attitude", "heroism");
  set("per", 30);

  set("max_kee", 4000);
  set("max_sen", 4000);
  set("force", 2800);
  set("max_force", 5600);
  set("force_factor", 120);
  set("max_mana", 2800);
  set("mana", 5600);
  set("mana_factor", 120);
  set("combat_exp", 2200000);
  set("daoxing", 2200000);
  set("no_ji",1);

  set_skill("force", 210);
  set_skill("spells", 210);
  set_skill("dodge", 210);
  set_skill("unarmed", 210);
  set_skill("parry", 210);
  set_skill("sword", 210);

  set_skill("wuxiangforce", 210);
  set_skill("dao",210);
  set_skill("jindouyun", 210);
  set_skill("puti-zhi",210);
  set_skill("liangyi-sword",210);

  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("sword","liangyi-sword");
  map_skill("parry", "liangyi-sword");
  setup();
  carry_object("/d/obj/armor/surcoat/sppifeng")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
  carry_object("/d/obj/fabao/pingreal");
}

void destruct_me (object me)
{
  destruct (me);
}

void die ()
{
  object taishang;
  object me = this_object();
  object ob = query_temp("my_killer");
  object fabao = present ("fabao",me);
  string msg;
  if (objectp(ob)
      && ob == me->query_last_damage_from()
      && (int)ob->query("obstacle/number") == 10
      && (string)ob->query("obstacle/pingding") != "done")
  {
    ob->set_temp("obstacle/pingding_yinjiao_killed",1);
    if (ob->query_temp("obstacle/pingding_huaqi_killed") &&
        ob->query_temp("obstacle/pingding_laonai_killed") &&
        ob->query_temp("obstacle/pingding_jinjiao_killed"))
    {
      taishang = new ("/d/qujing/pingding/npc/taishang");
      taishang->move(environment(me));
      taishang->announce_success (ob);
      destruct(taishang);
    }

  }

  msg = HIY"\n$N" HIY"无可奈何地现了真身，原来是太上老君的银角童子。\n"NOR;
  msg += HIY"\n银角童子鞠了个躬：时辰已到，去见太上老君也。\n"NOR;
  msg += HIY"银角童子往外奔去！\n"NOR;
  if (fabao)
  {
     msg += HIY"$N" HIY"丢下一只$n" HIY"。\n"NOR;
     fabao->move(environment(me));
  }

  message_vision(msg,me,fabao);
  destruct(me);
}

void unconcious ()
{
  die ();
}

int accept_fight(object ob)
{
  kill_ob(ob);
  return 1;
}

void kill_ob (object ob)
{
  object me = this_object();
  set_temp("my_killer",ob);
  call_out ("hurting",random(5)+5,me,ob);
  ::kill_ob(ob);
}

void hurting (object me, object ob)
{
  object fabao;
  if (!objectp(me) || !environment(me))
    return;

  fabao = present ("fabao",me);

  if (!objectp(fabao) || !objectp(ob) || !environment(ob))
    return;
  if (environment(me) != environment(ob))
    return;
  if (!me->is_fighting(ob))
    return;

  command("ji fabao on "+ ob->query("id"));
  remove_call_out ("hurting");
  call_out ("hurting",random(10)+10,me,ob);
}