inherit NPC;
void create()
{
  set_name("老奶奶", ({ "lao nainai", "lao", "nainai", "queen" }));
  set("title", "压龙洞");
  set("long", "一位扭腰摆臀的压龙洞妖后，身上隐隐地发出狐臭。\n");
  set("gender", "女性");
  set("age", 86);
  set("attitude", "heroism");
  set("per", 12);
  set("max_kee", 4500);
  set("max_sen", 4500);
  set("force", 5000);
  set("max_force", 2700);
  set("force_factor", 130);
  set("max_mana", 2700);
  set("mana", 5000);
  set("mana_factor", 130);
  set("combat_exp", 2300000);
  set("daoxing", 2300000);
  set_skill("force", 190);
  set_skill("spells", 190);
  set_skill("dodge", 190);
  set_skill("unarmed", 190);
  set_skill("parry", 190);
  set_skill("stick", 190);

  set_skill("wuxiangforce", 190);
  set_skill("dao",190);
  set_skill("jindouyun", 190);
  set_skill("puti-zhi",190);
  set_skill("puti-stick",190);

  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("stick","puti-stick");
  map_skill("parry", "puti-stick");
  setup();
  carry_object("/d/obj/armor/surcoat/sppifeng")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/weapon/stick/shouzhang")->wield();
}

void die ()
{
  object me = this_object();
  object ob = query_temp("my_killer");
  if (objectp(ob)
      && ob == me->query_last_damage_from()
      && (int)ob->query("obstacle/number") == 10
      && (string)ob->query("obstacle/pingding") != "done")
    ob->set_temp("obstacle/pingding_laonai_killed",1);
  message_vision ("\n$N翻倒在地现了真身，是一只狐狸精。\n",me);
  message_vision ("狐狸精死了。\n",me);
  destruct (me);
}

void unconcious ()
{
  die ();
}

int accept_fight(object ob)
{
  kill_ob(ob);
  return 1;
}

void kill_ob (object ob)
{
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}