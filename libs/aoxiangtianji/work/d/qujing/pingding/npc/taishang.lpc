inherit NPC;
void create()
{
  set_name("太上老君", ({"taishang laojun", "taishang", "laojun"}));
  set("gender", "男性");
  set("age", 100);
  set("attitude", "friendly");
  set("combat_exp", 1250000);
  set("daoxing", 10000000);
  setup();
}

void announce_success (object who)
{
  int dx,qn;
  if ((int)who->query("obstacle/number") != 10 ||
      (string)who->query("obstacle/pingding") == "done")
    return;
  if (!who->query_temp("obstacle/pingding_huaqi_killed") ||
      ! who->query_temp("obstacle/pingding_laonai_killed") ||
      ! who->query_temp("obstacle/pingding_jinjiao_killed") ||
      ! who->query_temp("obstacle/pingding_yinjiao_killed"))
    return;

  dx = random(2500);
  dx += 25000;
  qn = dx/3;

  who->set("obstacle/number",11);
  who->set("obstacle/pingding","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  who->delete_temp("obstacle/pingding_huaqi_killed");
  who->delete_temp("obstacle/pingding_laonai_killed");
  who->delete_temp("obstacle/pingding_jinjiao_killed");
  who->delete_temp("obstacle/pingding_yinjiao_killed");
  command("chat "+who->query("name")+"平顶山压龙山施威，替老夫收回金银童子！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed pingding on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}