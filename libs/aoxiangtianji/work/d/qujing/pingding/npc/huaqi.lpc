#include <ansi.h>
inherit NPC;
void create()
{
  set_name(HIB"狐阿七大王"NOR, ({ "huaqi dawang", "huaqi", "dawang", "wang" }));
  set("title", "压龙洞");
  set("long", "一位扭腰摆臀的压龙洞妖王，身上隐隐地发出狐臭。\n");
  set("gender", "男性");
  set("age", 64);
  set("attitude", "heroism");
  set("per", 30);
  set("max_kee", 4000);
  set("max_sen", 4000);
  set("force", 5000);
  set("max_force", 2500);
  set("force_factor", 100);
  set("max_mana", 2500);
  set("mana", 5000);
  set("mana_factor", 100);
  set("combat_exp", 2000000);
  set("daoxing", 2000000);
  set("no_ji",1);

  set_skill("force", 190);
  set_skill("spells", 190);
  set_skill("dodge", 190);
  set_skill("unarmed", 190);
  set_skill("parry", 190);
  set_skill("stick", 190);

  set_skill("wuxiangforce", 190);
  set_skill("dao",190);
  set_skill("jindouyun", 190);
  set_skill("puti-zhi",190);
  set_skill("puti-stick",190);

  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("stick","puti-stick");
  map_skill("parry", "puti-stick");
  setup();
  carry_object("/d/obj/armor/surcoat/sppifeng")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/weapon/stick/bintiegun")->wield();
  carry_object("/d/obj/fabao/shengreal");
}

void die ()
{
  object me = this_object();
  object fabao = present ("fabao",me);
  object ob = query_temp("my_killer");
  if (objectp(ob)
      && ob == me->query_last_damage_from()
      && (int)ob->query("obstacle/number") == 10
      && (string)ob->query("obstacle/pingding") != "done")
    ob->set_temp("obstacle/pingding_huaqi_killed",1);
  message_vision (HIY"\n$N" HIY"翻倒在地现了真身，是一只狐狸精。\n"NOR,me);
  if (fabao)
  {
     message_vision(HIY"$N" HIY"丢下一只$n" HIY"。\n"NOR,me,fabao);
     fabao->move(environment(me));
  }

  tell_room(environment(me),"狐狸精死了。\n");
  destruct (me);
}

void unconcious ()
{
  die ();
}

int accept_fight(object ob)
{
  kill_ob(ob);
  return 1;
}

void kill_ob (object ob)
{
  object me = this_object();
  set_temp("my_killer",ob);
  call_out ("hurting",random(5)+5,me,ob);
  ::kill_ob(ob);
}

void hurting (object me, object ob)
{
  object fabao;
  if (!objectp(me) || !environment(me))
    return;

  fabao = present ("huangjin sheng",me);

  if (!objectp(fabao) || !objectp(ob) || !environment(ob))
    return;
  if (environment(me) != environment(ob))
    return;
  if (!me->is_fighting(ob))
    return;

  command("ji fabao on "+ ob->query("id"));
  remove_call_out ("hurting");
  call_out ("hurting",random(10)+10,me,ob);
}