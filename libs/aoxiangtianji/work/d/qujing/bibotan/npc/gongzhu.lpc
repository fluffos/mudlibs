inherit NPC;
string say_position();
void create()
{
  set_name("万圣公主", ({"wansheng gongzhu","gongzhu","princess"}));
  set("long","万圣公主是万圣龙王的女儿，最近招了九头怪为驸马。\n");
  set("gender", "女性");
  set("age", 20);
  set("int", 25+random(5));
  set("attitude", "peaceful");
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set("rank_info/respect", "公主殿下");
  set("class","dragon");
  set("per", 30);
  set("max_kee", 3800);
  set("max_sen", 3800);
  set("force", 3000);
  set("max_force", 1600);
  set("force_factor", 70);
  set("max_mana", 1600);
  set("mana", 3000);
  set("mana_factor", 100);
  set_skill("literate", 170);
  set_skill("stealing", 170);
  set_skill("unarmed", 170);
  set_skill("dodge", 170);
  set_skill("force", 170);
  set_skill("parry", 170);
  set_skill("spells", 200);
  set_skill("dragonfight", 170);
  set_skill("dragonforce", 170);
  set_skill("dragonstep", 170);
  set_skill("moonshentong", 200);
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("dodge", "dragonstep");
  map_skill("spells", "moonshentong");
  set("inquiry",([
     "宝贝": "什么宝贝不宝贝的！\n",
     "佛宝": "佛宝现是我龙宫的镇潭之宝了，谁也拿不到。\n",
     "方位": (: say_position :),
  ]));
  set("chat_chance_combat", 10);
  set("chat_msg_combat",
  ({
     (: cast_spell, "mihun" :),
  }) );
  setup();
  carry_object("/d/qujing/bibotan/obj/clasp")->wear();
  carry_object("/d/qujing/bibotan/obj/zhanpao")->wear();
}

string say_position()
{
  object me =this_object();
  object who=this_player();
  if( me->is_fighting() || who->is_fighting() )
    return ("什么方位不方位的，我不懂。\n");
  if(member_array("tianboer xiao", who->parse_command_id_list())==-1)
  {
    call_out("kill_him", 1, who);
    return ("今日不除你，终成我龙宫大患！\n");
  }

  if( who->query_temp("heard_position") )
    return ("什么方位不方位的，我不是已经告诉你！\n");
  call_out("tell_position", 1, who);
  return "";
}

void tell_position(object who)
{
  if( !who || environment(who) != environment())
    return;
  switch (random(8))
  {
    case 0:
      tell_object(who,"今日方位在“乾”位。\n");
      who->set_temp("heard_position", "乾");
      break;
    case 1:
      tell_object(who,"今日方位在“坤”位。\n");
      who->set_temp("heard_position", "坤");
      break;
    case 2:
      tell_object(who,"今日方位在“兑”位。\n");
      who->set_temp("heard_position", "兑");
      break;
    case 3:
      tell_object(who,"今日方位在“离”位。\n");
      who->set_temp("heard_position", "离");
      break;
    case 4:
      tell_object(who,"今日方位在“震”位。\n");
      who->set_temp("heard_position", "震");
      break;
    case 5:
      tell_object(who,"今日方位在“艮”位。\n");
      who->set_temp("heard_position", "艮");
      break;
    case 6:
      tell_object(who,"今日方位在“巽”位。\n");
      who->set_temp("heard_position", "巽");
      break;
    default:
      tell_object(who,"今日方位在“坎”位。\n");
      who->set_temp("heard_position", "坎");
      break;
  }

}

void kill_him(object who)
{
  object husband = present("jiutou fuma", environment(this_object()));

  if(husband)
    husband->kill_ob(who);
  ::kill_ob(who);
}

