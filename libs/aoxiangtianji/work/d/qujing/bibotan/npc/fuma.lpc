#include <ansi.h>
#include "/d/qujing/kusong/npc/hyd.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("九头驸马", ({"jiutou fuma","fuma"}));
  set("long","九头驸马原在北冥大泽中修练，后被招为驸马。\n");
  set("gender", "男性");
  set("age", 20);
  set("title", "九头虫");
  set("int", 25);
  set("attitude", "heroism");
  set("combat_exp", 1200000);
  set("daoxing", 1500000);
  set("class","yaomo");
  set("per", 10);
  set("str", 30);
  set("max_kee", 3500);
  set("max_sen", 3500);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 100);
  set("max_mana", 1600);
  set("mana", 3000);
  set("mana_factor", 80);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("fork",200);
  set_skill("huomoforce",200);
  set_skill("pingtian-dafa",200);
  set_skill("moshenbu", 200);
  set_skill("moyun-shou",200);
  set_skill("yueya-fork",200);

  map_skill("force","huomoforce");
  map_skill("spells","pingtian-dafa");
  map_skill("dodge","moshenbu");
  map_skill("unarmed","moyun-shou");
  map_skill("fork","yueya-fork");
  map_skill("parry","yueya-fork");
  create_family("火云洞", 2, "蓝");
  setup();
  carry_object("/d/obj/weapon/staff/moonstaff")->wield();
  carry_object("/d/qujing/bibotan/obj/zhanpao")->wear();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "火云洞")
  {
    command("say 我只收火云洞的弟子！\n");
    return 0;
  }

  if (!ob->query("family/can_bai/fuma"))
  {
    command("say 我和你行同陌人，拜我为师？？哈哈！！");
    command("kick");
    return 0;
  }

  if ((int)ob->query("level") <= 25)
  {
    command("say 你还需要多努力！\n");
    return 0;
  }

  command("grin");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "火云洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我火云洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我妖魔中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 25)
  {
    command("say 你还需要多多磨练才行啊！\n");
    return 1;
  }

  return 0;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  switch (topic)
  {
    case "飞叉绝艺" :
    case "feicha" :
      if (me->query("family/family_name") != master->query("family/family_name"))
        return "你不是我火云洞的弟子！\n";
      if (me->query("class") != "yaomo")
        return "嘿嘿，你问我何用？\n";
      if (me->query("family/can_pfm/feicha"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("yueya-fork",1) < 150)
        return "你的月牙铲修为不够，暂时无法领悟！\n";
      if (me->query_skill("huomoforce",1) < 150)
        return "你的火魔心法修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/feicha",1);
      return "你学会了“飞叉绝艺”！\n";
      break;
  }

  return 0;
}

