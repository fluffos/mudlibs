//乾卦象征天
//乾、南方
#include <room.h>
inherit "/d/qujing/bibotan/hua_dui";
void create ()
{
  ::create();
  set("position", "乾");
  set("exits", ([
    "south" : __DIR__"yuemen",
    "northeast" : __DIR__"hua_dui",
    "northwest" : __DIR__"hua_gong",
  ]));
  create_door("south", "月牙门", "north", DOOR_CLOSED);
  setup();
}