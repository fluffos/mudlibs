#include <ansi.h>
inherit ITEM;
void init()
{
  object me = this_object();
  object where = environment();
  if (where && playerp(where))
  {
    if (me->query("owner"))
    {
      if (me->query("owner") != where->query("id"))
      {
        message_vision("$N一不小心，$n掉到地上不见了：（\n", where, me);
        destruct(me);
        return;
      }

    }

    else
    {
      me->set("owner",where->query("id"));
    }

  }

}

void create()
{
  set_name(YEL "佛宝舍利子" NOR, ({ "tooth" }) );
  set_weight(600);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一颗淡黄色的珠子，象有种神奇的力量孕育其中。\n");
    set("material", "silver");
    set("unit", "颗");
    set("no_sell", 1);
    set("no_drop", 1);
  }

  setup();
  set("is_monitored", 1);
}

