inherit ITEM;
void create()
{
  set_name("兵器架", ({ "rack" }) );
  set_weight(5000000);
  set_max_encumbrance(40001);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "个");
    set("long",
"这是一口寻常的架子，可以用来堆放一些杂物。\n");
    set("value", 0);
  }

}

int is_container() { return 1; }