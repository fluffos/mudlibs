inherit ITEM;
void init()
{
  object me = this_object();
  object where = environment();
  object ob;
  int i;
  ob=present("tooth",me);

  if (userp(where))
  {
    if (me->query("owner"))
    {
      if (me->query("owner")!=where->query("id"))
      {
        message_vision("$N一不小心，$n掉到地上不见了：（\n", where, me);
        destruct(me);
        return;
      }

    }

    else
    {
      me->set("owner",where->query("id"));
      if (!ob)
      {
        i=random(3);
        seteuid(getuid());
        if(i == 2)
        {
          ob=new("/d/qujing/bibotan/obj/tooth");
          ob->move(me);
          ob->set("owner",where->query("id"));
        }

      }

    }

  }

}

void create()
{
  set_name("黄金匣子", ({ "xiazi" }) );
  set_weight(2000);
  set_max_encumbrance(1200);
  set("unit", "个");
  set("no_sell", 1);
  set("no_put", 1);
  set("no_give", 1);
  set("long", "一个金光灿然的黄金匣子。\n");
  set("value",0);
}

int is_container() { return 1; }

