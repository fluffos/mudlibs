#include <ansi.h>
#define NAME "铁扇公主"
inherit NPC;
int test_player (object who);
void create()
{
  set_name(NAME, ({"tieshan gongzhu", "gongzhu", "princess"}));
  set("title", "火焰山红纶罗刹");
  set("gender", "女性");
  set("age", 28);
  set("per", 25);
  set("str", 30);
  set("dex", 30);
  set("spi", 30);
  set("long", "火焰山铁扇公主。\n");
  set("rank_info/respect", "红纶公主");
  set("combat_exp", 1900000);
  set("daoxing", 1900000);
  set("max_kee", 4500);
  set("max_sen", 4500);
  set("force", 4500);
  set("max_force", 2500);
  set("mana", 4500);
  set("max_mana", 2500);
  set("force_factor", 100);
  set("mana_factor", 100);
  set_skill("force", 180);
  set_skill("spells", 180);
  set_skill("dodge", 180);
  set_skill("unarmed", 180);
  set_skill("parry", 180);
  set_skill("sword", 180);

  set_skill("moonforce", 180);
  set_skill("moonshentong", 180);
  set_skill("moondance", 180);
  set_skill("baihua-zhang", 180);
  set_skill("snowsword", 180);

  map_skill("force", "moonforce");
  map_skill("spells", "moonshentong");
  map_skill("dodge", "moondance");
  map_skill("unarmed", "baihua-zhang");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  set("no_ji",1);
  set("inquiry", ([
    "name":   "你仔细看看我是谁！",
    "here":   "你找土地去问！",
    "火焰山": "哼哼，只有一样法宝能镇住火焰山。",
    "法宝":   "我很少把祖传家珍随便赠予外姓。",
    "铁扇":   (: test_player :),
  ]));
  setup();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("obj/cloth/zhanpao")->wear();
  carry_object("/d/qujing/firemount/obj/tieshan")->wield();
}

void init()
{
  ::init();
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_cast", "cast");
}

void announce_success(object who)
{
  int dx,qn;
  if ((int)who->query("obstacle/number") != 18 ||
      (string)who->query("obstacle/firemount") == "done")
    return;
  dx = random(2400);
  dx += 24000;
  qn = dx/3;

  message_vision (HIY"一团红色云雾飘来，显现出$N" HIY"。\n" NOR,this_object());
  who->set("obstacle/number",19);
  who->set("obstacle/firemount","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  command("chat "+who->query("name")+"扑灭了火焰山八百里大火！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed firemount on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  message_vision (HIY"$N" HIY"化为红色云雾升起，向南边飘去。\n" NOR,this_object());
  return;
}

int accept_object (object who, object ob)
{
  object me = this_object();
  if (ob->query("id") != "palm bone")
  {
    command("shake");
    return 0;
  }

  if (who->query("level") < 24)
  {
    message_vision ("$N对$n摇摇头：你道行不够，这芭蕉骨怕是假货。\n",me,who);
    call_out("return_object",1,who,ob);
    return 1;
  }

  message_vision ("$N接下芭蕉骨，对$n连声道谢。\n",me,who);
  who->add_temp("obstacle/firemount_bone",1);
  if (who->query_temp("obstacle/firemount_bone") > 9)
    message_vision("$N喜不自禁，对着$n频频点头，真是难得啊！\n",me,who);
  return 1;
}

void inform_player (string msg, object who)
{
  object me = this_object();
  message_vision (msg, me, who);
}

void give_tieshan (object me, object who)
{
  object tieshan = present("tie shan",me);
  if (!me || !who || environment(me) != environment(who))
    return;

  if (objectp(tieshan))
  {
    message_vision ("$N苦笑一下，"+
                    "很不情愿地双手捧出铁扇，交给$n。\n",me,who);
    if (tieshan->move(who))
      tieshan->set("owner",who->query("id"));
    else
      tell_object(who,"你身上的东西似乎太多了，没有办法得到铁扇了！\n");
  }

  else
  {
    message_vision ("$N为难地说道：铁扇已经送人了，"+
                    "公主实无他物相赠。\n",me);
  }

  return;
}

int test_player (object me)
{
  object who = this_player();
  string msg = "$N说道：这位"+RANK_D->query_respect(who);
  if (who->query("level") < 24)
  {
    inform_player (msg+"道行不够，公主怕铁扇伤了你的根骨！\n",who);
    return 1;
  }

  if ((int)who->query("obstacle/number") != 18 ||
      (string)who->query("obstacle/firemount") == "done")
  {
    inform_player (msg+"现在有必要用铁扇吗？！\n",who);
    return 1;
  }

  if (who->query_temp("obstacle/firemount_bone") < 9)
  {
    inform_player(msg + "难道不知道吗？没有足够的礼物给我，我怎肯把宝扇借人？\n",who);
    return 1;
  }

  if (who->query_temp("obstacle/firemount") == "won")
  {
    give_tieshan (me,who);
    return 1;
  }

  if (who->query_temp("obstacle/firemount") == "fight")
    inform_player (msg+"又来啦？好，公主奉陪！\n",who);
  else
    inform_player (msg+"虽然予我以重礼，但是想必是个爽快之人，打赢了我再说！\n",who);
  call_out("fight_player",3,who);
  return 1;
}

void fight_player (object who)
{
  object me = this_object();

  if (!who || !me || environment(me) != environment(who))
    return;
  message_vision ("$N对众妖一喝：闪开！\n",me);
  message_vision("$N轻轻一笑，对$n说道：来吧，看看你是否有斤两？\n",me,who);
  who->set_temp("obstacle/firemount","fight");
//  command("fight "+who->query("id"));
}

int accept_fight(object who)
{
  object me;
  me = this_object();

  if ((string)who->query_temp("obstacle/firemount") != "fight")
    return 0;

  if (me->is_busy() || me->is_fighting())
  {
    tell_object(who,"正忙着呢！急什么！\n");
    return 0;
  }

  who->delete_temp("obstacle/firemount");
  remove_call_out("check_fight");
  call_out("check_fight", 1, me, who);
  return 1;
}

void player_win (object me, object who)
{
  if (!me || !who || environment(me) != environment(who))
    return;
  me->remove_all_enemy();
  message_vision ("$N大惊失色：好武功！好武功！\n",me);
  who->set_temp("obstacle/firemount", "won");
  give_tieshan (me,who);
  call_out ("princess_disappear",2,me);
}

void player_lose (object me, object who)
{
  if (!me || !who || environment(me) != environment(who))
    return;
  me->remove_all_enemy();
  message_vision ("$N一愣，慌忙扶住$n，连声说道：失礼失礼！\n",me,who);
  call_out ("princess_disappear",2,me);
}

void check_fight (object me, object who)
{
  int my_kee, whos_kee;
  int my_max_kee, whos_max_kee;
  if (!me || !who || environment(me) != environment(who))
    return;
  if (me->is_fighting(who))
  {
    call_out ("check_fight",1,me,who);
    return;
  }

  if (me->query_temp("last_opponent") != who)
    return;

  if (me->query_last_damage_from() != who)
    return;

  if (!present(who, environment(me)))
    return;

  my_kee = me->query("kee");
  whos_kee = who->query("kee");
  my_max_kee = me->query("max_kee");
  whos_max_kee = who->query("max_kee");
  if ((my_kee*100/my_max_kee) <= 50)
    player_win (me, who);
  else if ((whos_kee*100/whos_max_kee) <= 50)
    player_lose (me, who);
}

void princess_disappear (object me)
{
  if (objectp(me) && environment(me))
  {
    message_vision ("$N慢慢地化为红色云雾消失了。\n",me);
    destruct (me);
  }

}

int do_fight(string arg)
{
  object who = this_player();
  object me = this_object();
  if (me->is_fighting())
  {
    message_vision ("$N对$n摇摇头：一个一个地来，不要一拥而上！\n",me,who);
    return 1;
  }

  if ((string)who->query_temp("obstacle/firemount") == "fight")
  {
    me->set("kee", me->query("max_kee"));
    me->set("eff_kee", me->query("max_kee"));
    me->set("sen", me->query("max_sen"));
    me->set("eff_sen", me->query("max_sen"));
    return 0;
  }

  message_vision ("$N对$n摇摇头：要打架出去打！\n",me,who);
  return 1;
}

int do_cast(string arg)
{
  object who = this_player();
  object me = this_object();
  if(arg && present(arg,environment(me))!=me)
    return 0;
  message_vision ("$N吸口气，憋红了脸念了几声咒语。\n",who);
  return 1;
}

int do_steal(string arg)
{
  message_vision ("$N趁着黑暗伸出手……一不小心摸到公主的长发。\n",this_player());
  return 1;
}

int do_kill(string arg)
{
  object who = this_player();
  object me = this_object();
  if(arg && present(arg,environment(me))!=me) return 0;
  message_vision ("$N忽然眼露杀机，颤抖地喊不出来！\n",who);
  return 1;
}

