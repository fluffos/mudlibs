#include <ansi.h>
inherit NPC;
void create()
{
  set_name("芭蕉怪", ({"bajiao guai", "wannian guai", "guai"}));
  set("title", "万年");
  set("gender", "男性");
  set("age", 12000+random(6000));
  set("con", 20);
  set("cor", 20);
  set("int", 20);
  set("per", 20);
  set("str", 30);
  set("dex", 30);
  set("long", "万年芭蕉怪。\n");
  set("attitude", "peaceful");
  set("combat_exp", 12000000);
  set("daoxing", 12000000);
  set_skill("dodge", 450);
  set_skill("parry", 450);
  set_skill("force", 450);
  set_skill("spells", 450);
  set_skill("unarmed", 450);
  set_skill("whip", 450);
  set_skill("lengquan-force",450);
  set_skill("feiyan-zoubi", 450);
  set_skill("baguazhou",450);
  set_skill("mingwang-whip",450);
  map_skill("force", "lengquan-force");
  map_skill("dodge", "feiyan-zoubi");
  map_skill("spells","baguazhou");
  map_skill("parry","mingwang-whip");
  map_skill("whip","mingwang-whip");
  set("max_kee", 20000);
  set("max_sen", 20000);
  set("force", 20000);
  set("max_force", 11000);
  set("mana", 20000);
  set("max_mana", 11000);
  set("mana_factor",400);
  set("force_factor",400);
  setup();
  carry_object("/d/qujing/firemount/obj/bian")->wield();
  carry_object("/d/qujing/firemount/obj/skirt")->wear();
}

string allow_split()
{
  this_object()->set_temp("split",1);
  message_vision ("$N一愣，随即神秘地朝$n点头一笑。\n",this_object(),this_player());
  return "试过就知道了！\n";
}

void init()
{
  ::init();
  set("inquiry", ([
    "分身术": (: allow_split :),
  ]));
}

int accept_fight (object me)
{
  object ob = this_object();
  if (! ob->query_temp("split"))
    return 1;
  if (! ob->query("triplicate"))
  {
    object ob0, ob1, ob2;
    string str = __DIR__"bajiaow";
    ob0 = present("guai 2",environment(me));
    if (objectp(ob0) && !userp(ob0))
      destruct (ob0);
    ob0 = present("guai 2",environment(me));
    if (objectp(ob0) && !userp(ob0))
      destruct (ob0);
    ob0 = present("guai 2",environment(me));
    if (objectp(ob0) && !userp(ob0))
      destruct (ob0);
    ob1 = new(str);
    ob1->move(environment(ob));
    ob2 = new(str);
    ob2->move(environment(ob));
    message_vision ("$N大喝一声，从身后突然闪出两个$N！\n",ob);
    ob->set("kee",ob->query("max_kee")/10*12);
    ob->set("triplicate",1);
    ob1->set("triplicate",1);
    ob2->set("triplicate",1);
    ob1->fight_ob(me);
    ob2->fight_ob(me);
  }

  return 1;
}

void unconcious()
{
  die();
}