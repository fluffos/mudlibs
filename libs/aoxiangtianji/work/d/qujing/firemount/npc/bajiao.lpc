#include <ansi.h>
inherit NPC;
string allow_split();
void create()
{
  set_name("芭蕉怪", ({"bajiao guai", "guai"}));
  set("gender", "男性");
  set("age", 40+random(30));
  set("con", 20);
  set("cor", 20);
  set("int", 20);
  set("per", 20);
  set("str", 30);
  set("dex", 30);
  set("long", "芭蕉怪。\n");
  set("attitude", "peaceful");
  set("combat_exp", 100000);
  set("daoxing", 100000);
  set_skill("dodge", 60);
  set_skill("parry", 60);
  set_skill("force", 60);
  set_skill("spells", 60);
  set_skill("unarmed", 60);
  set_skill("whip", 60);
  set_skill("feiyan-zoubi",60);
  map_skill("dodge","feiyan-zoubi");
  set("max_kee", 2200);
  set("max_sen", 2200);
  set("force", 2000);
  set("max_force", 1200);
  set("mana", 2000);
  set("max_mana", 1200);
  setup();
  carry_object("/d/qujing/firemount/obj/bian")->wield();
  carry_object("/d/qujing/firemount/obj/skirt")->wear();
}

void init()
{
  ::init();
  set("inquiry", ([
   "分身术": (: allow_split :),
  ]));
}

string allow_split()
{
  this_object()->set_temp("split",1);
  message_vision ("$N一愣，随即神秘地朝$n点头一笑。\n",this_object(),this_player());
  return "试过就知道了！\n";
}

int accept_fight (object me)
{
  object ob = this_object();
  if (! ob->query_temp("split"))
    return 1;
  if (! ob->query("triplicate"))
  {
    object ob0, ob1, ob2;
    string str = __DIR__"bajiao";
    ob0 = present("guai 2",environment(me));
    if (objectp(ob0) && !userp(ob0))
      destruct (ob0);
    ob0 = present("guai 2",environment(me));
    if (objectp(ob0) && !userp(ob0))
      destruct (ob0);
    ob0 = present("guai 2",environment(me));
    if (objectp(ob0) && !userp(ob0))
      destruct (ob0);
    ob1 = new(str);
    ob1->move(environment(ob));
    ob2 = new(str);
    ob2->move(environment(ob));
    message_vision ("$N大喝一声，从身后突然闪出两个$N！\n",ob);
    ob->set("kee",ob->query("max_kee")/10*12);
    ob->set("triplicate",1);
    ob1->set("triplicate",1);
    ob2->set("triplicate",1);
    ob1->fight_ob(me);
    ob2->fight_ob(me);
  }

  return 1;
}

void unconcious()
{
  die();
}