#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
string *names = ({
  HIR"老虎肉"NOR,
  HIG"香獐肉"NOR,
  HIW"蟒蛇肉"NOR,
  HIG"狐狸肉"NOR,
  HIC"兔肉"NOR,
  HIM"鹿肉"NOR,
});
string *ids = ({
    "laohu rou",
    "xiangzhang rou",
    "mangshe rou",
    "huli rou",
    "tu rou",
    "lu rou",
});
void create()
{
  int i = random(sizeof(names));
  set_name(names[i], ({ids[i]}));
  set_weight(80);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一快香喷喷的熏肉。\n");
    set("unit", "块");
    set("value", 100);
    set("food_remaining", 3);
    set("food_supply", 30);
  }

}

