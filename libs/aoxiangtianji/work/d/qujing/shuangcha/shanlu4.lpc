inherit BIGROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "山坡");
  set ("long", @LONG
山坡上一条小河横穿而过，河水顺流而下，发出汩汩的声音，
路两旁怪石嶙峋。树林茂密而整齐。
LONG);
  set("exits", ([
    "east" : __DIR__"on2",
    "southwest"   : __DIR__"shanlu5",
  ]));
  set("outdoors","sc");
  set("objects",([
     __DIR__"npc/taibao":1,
  ]));
  setup();
}

