inherit NPC;
#include <ansi.h>
int do_ok(string arg);
void check(object ob);
void create()
{
  set_name("刘伯钦", ({"liu boqin","liu"}));
  set("gender","男性");
  set("age",30);
  set("title",HIY"镇山太保"NOR);
  set("long","山中的一个猎户，十分的粗壮。");
  set("per", 20);
  set("str", 50);
  set("attitude","friendly");
  set("combat_exp",100000);
  set("max_force",1500);
  set("force",3000);
  set("force_factor",80);
  set("max_kee",1000);
  set("kee",1000);
  set("sen",1000);
  set("max_sen",1000);
  set_skill("unarmed",80);
  set_skill("parry",80);
  set_skill("fork",100);
  set("inquiry",([
     "镇山太保" : "镇山太保就是我啊。",
     "here": "这个地方叫做双叉岭",
  ]));
  setup();
  carry_object("/obj/cloth/magua")->wear();
  carry_object("/d/obj/weapon/fork/gangcha")->wield();
}

void init()
{
  object ob = this_player();

  if (playerp(ob))
  {
    add_action("do_ok",({"ok","yes"}));
    check(ob);
  }

}

void check(object ob)
{
  if (!ob || environment(ob) != environment())
    return;

  if ((int)ob->query("dntg/number") < 10)
    return;

  if ((int)ob->query("obstacle/number") > 0)
    return;
  if( ob->query_temp("sc/liu_said") )
    return ;

  if( environment()->query("short") == "山坡"
     && ob->query_temp("tiger_kill")=="yes")
  {
    command("say 这位....真是厉害，想我镇山太保也不如啊。");
    command("say 如不嫌弃，到我家一叙如何(yes)？ ");
    ob->set_temp("sc/liu_said",1);
  }

  return ;
}

int do_ok(string arg)
{
  object me = this_player();
  object ob = this_object();

  if(!me->query_temp("tiger_kill"))
    return 0;
  if (!me->query_temp("sc/liu_said"))
    return 0;

  if( me->query("obstacle/sc") == "done" )
    return 0;

  if ((int)me->query("obstacle/number"))
    return 0;

  command("say 好吧，那我们走吧。");
  me->delete_temp("sc/liu_said");
  me->set_temp("sc/taibao_seen",1);

  me->move("/d/qujing/shuangcha/shanlu4");
  ob->move("/d/qujing/shuangcha/shanlu4");
  message_vision("$N" HIW"和刘伯钦向山坡走了过来。"NOR,me);
  me->move("/d/qujing/shuangcha/shanlu5");
  ob->move("/d/qujing/shuangcha/shanlu5");
  message_vision("$N" HIW"和刘伯钦向山脚走了过来。"NOR,me);
  me->move("/d/qujing/shuangcha/enter");
  ob->move("/d/qujing/shuangcha/enter");
  message_vision("$N" HIW"和刘伯钦向村前走了过来。"NOR,me);
  me->move("/d/qujing/shuangcha/gate");
  ob->move("/d/qujing/shuangcha/gate");
  message_vision("$N" HIW"和刘伯钦向大门走了过来。"NOR,me);
  me->move("/d/qujing/shuangcha/yard");
  ob->move("/d/qujing/shuangcha/yard");
  message_vision("$N" HIW"和刘伯钦向庭院走了过来。"NOR,me);
  me->move("/d/qujing/shuangcha/yard");
  ob->move("/d/qujing/shuangcha/yard");
  message_vision("$N" HIW"和刘伯钦向庭院走了过来。"NOR,me);
  me->move("/d/qujing/shuangcha/zhengting");
  ob->move("/d/qujing/shuangcha/zhengting");
  message_vision("$N" HIW"和刘伯钦向客厅走了过来。\n"NOR,me);
  command("say 稍等，待我出去一会。");
  destruct(ob);
  me->set_temp("home",1);
  me->delete_temp("tiger_kill");
  return 1;
}

