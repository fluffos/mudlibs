inherit SMALLROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "民居");
  set ("long", @LONG
这也是一户陈姓人家，房子里面布置得非常舒适。屋子东边有
一灶台，正烧着火，不知在做什么，散发出一股清香味。南边
的门通向屋外。
LONG);
  set("exits", ([
    "southwest"   : __DIR__"chen2",
  ]));
  set("objects", ([
     __DIR__"npc/people"  : 1 + random(2),
     __DIR__"npc/kid"  : 1 + random(2),
     __DIR__"npc/ji"  : 1,
  ]));
  setup();
}