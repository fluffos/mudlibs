#include <armor.h>
inherit CLOTH;
string *prefixs = ({
  "花",
  "素",
  "软",
  "细",
});
string *names = ({
  "棉",
  "纱",
  "锦",
  "缎",
});
string *suffixs = ({
  "长裙",
  "短裙",
  "薄裙",
});
void create()
{
  set_name(element_of(prefixs)+element_of(names)+
           element_of(suffixs), ({"skirt"}));
  set_weight(4000);
  if ( clonep() )
     set_default_object(__FILE__);
  else
  {
   set("unit", "件");
   set("value", 300);
   set("female_only", 1);
   set("material", "cloth");
   set("armor_prop/dodge", 1);
  }

  init_cloth(3);
  set("no_sell",1);
  setup();
}