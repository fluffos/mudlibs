#include <armor.h>
inherit CLOTH;
string *prefixs = ({
  "厚",
  "薄",
  "粗",
  "细",
});
string *names = ({
  "棉",
  "麻",
  "罗",
  "丝",
});
string *suffixs = ({
  "裤",
  "袄",
});
void create()
{
  set_name(element_of(prefixs)+element_of(names)+
           element_of(suffixs), ({"cloth"}));
  set_weight(4000);
  if ( clonep() )
     set_default_object(__FILE__);
  else
  {
   set("unit", "件");
   set("value", 300);
   set("material", "cloth");
   set("armor_prop/dodge", 1);
  }

  set("no_sell",1);
  init_cloth(3);
  setup();
}