inherit SMALLROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "民居");
  set ("long", @LONG
这是一户陈姓人家，屋子里摆设简单，设有一木桌两木椅，里
面是一张床，上面的被褥叠得整整齐齐。北面有一个木窗子，
窗外传来鸡叫。
LONG);
  set("exits", ([
    "south"   : __DIR__"chen1",
  ]));
  set("objects", ([
    __DIR__"npc/people"  : 1 + random(2),
    __DIR__"npc/kid"  : 1 + random(2),
  ]));
