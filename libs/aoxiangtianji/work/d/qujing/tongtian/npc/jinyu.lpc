inherit NPC;
void create()
{
  set_name("金鳞怪", ({ "jinlin guai", "jinglin", "guai" }));
  set("title", "通天河");
  set("long", "一位身着金甲的妖怪。\n");
  set("gender", "男性");
  set("age", 76);
  set("attitude", "aggressive");
  set("per", 30);
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 5500);
  set("max_force", 2800);
  set("force_factor", 140);
  set("max_mana", 2800);
  set("mana", 5600);
  set("mana_factor", 140);
  set("combat_exp", 2500000);
  set("daoxing", 2500000);
  set("no_ji",1);

  set_skill("force", 200 + random(50));
  set_skill("spells", 200 + random(50));
  set_skill("dodge", 200 + random(50));
  set_skill("unarmed", 200 + random(50));
  set_skill("hammer", 200 + random(50));
  set_skill("parry", 200 + random(50));

  set_skill("huntian-hammer",200 + random(50));
  set_skill("dragonforce", 200 + random(50));
  set_skill("seashentong",200 + random(50));
  set_skill("dragonstep", 200 + random(50));
  set_skill("huntian-hammer", 200 + random(50));

  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "dragonfight");
  map_skill("hammer", "huntian-hammer");
  map_skill("parry", "huntian-hammer");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
        (: cast_spell, "water" :),
        (: perform_action, "hammer.hundun" :),
  }) );

  setup();
  carry_object("/d/obj/armor/armor/jinjia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/weapon/hammer/bahammer")->wield();
}

void die ()
{
  object chen;
  object me = this_object();
  object ob = query_temp("my_killer");
  if (objectp(ob) &&
      ob == me->query_last_damage_from() &&
      (int)ob->query("obstacle/number") == 14 &&
      (string)ob->query("obstacle/tongtian") != "done")
  {
    chen = new ("/d/qujing/tongtian/npc/chen");
    chen->move(environment(ob));
    chen->announce_success (ob);
    destruct (chen);
  }

  message_vision ("\n$N一甩尾巴，现出金鱼的原身。\n",me);
  message_vision ("\n天上怒喝一声：金鱼，归我莲花池也！\n",me);
  message_vision ("金鱼闻声，乖乖地一纵身扭着腰摇晃着头游走了。\n",me);
  destruct (me);
  return;
}

void unconcious ()
{
  die ();
}

int accept_fight(object ob)
{
  kill_ob(ob);
  return 1;
}

void kill_ob (object ob)
{
  if (userp(ob))
    set_temp("my_killer",ob);
  ::kill_ob(ob);
}

