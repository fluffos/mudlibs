inherit F_VENDOR_SALE;
void create()
{
  reload("qinfa_zhou_xiaoer");
  set_name("周小二", ({"zhou xiaoer", "zhou", "xiaoer", "xiao", "er"}));
  set("shop_title", "小二");
  set("shop_id", ({"xiaoer", "xiao", "er"}));
  set("gender", "男性");
  set("combat_exp", 5000);
  set("age", 30);
  set("per", 21);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 30);
  set("vendor_goods", ([
    "1" : "/d/obj/food/niupi-jiudai",
    "2" : "/d/obj/food/jiunang",
    "3" : "/d/obj/food/egg",
    "4" : "/d/obj/food/mijiu",
    "5" : "/d/obj/food/kaoji",
  ]));
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}

void init ()
{
  ::init();
  add_action ("do_vendor_list", "list");
}

