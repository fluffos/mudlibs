inherit F_VENDOR_SALE;
void create()
{
  reload("qinfa_li_guafu");
  set_name("李寡妇", ({"li guafu", "li", "guafu", "fu"}));
  set("shop_id", ({"guafu", "fu"}));
  set("gender", "女性");
  set("combat_exp", 5000);
  set("age", 30);
  set("per", 21);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 30);
  set("vendor_goods", ([
    "1" : "/obj/cloth/choupao",
    "2" : "/obj/cloth/magua",
    "3" : "/d/obj/armor/cloth/ziyi",
    "4" : "/d/obj/armor/head/hat",
    "5" : "/d/obj/armor/shoes/buxie",
  ]));
  setup();
  carry_object("/obj/cloth/pinkskirt")->wear();
}

void init ()
{
  ::init();
  add_action ("do_vendor_list", "list");
}