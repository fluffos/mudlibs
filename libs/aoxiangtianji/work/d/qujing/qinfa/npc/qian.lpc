inherit F_VENDOR_SALE;
void create()
{
  reload("qinfa_qian_guafu");
  set_name("钱寡妇", ({"qian guafu", "qian", "guafu", "fu"}));
  set("shop_id", ({"guafu", "fu"}));
  set("gender", "女性");
  set("combat_exp", 5000);
  set("age", 30);
  set("per", 21);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 30);
  set("vendor_goods", ([
    "1" : "/d/obj/misc/kuang",
    "2" : "/d/obj/misc/shaoba",
    "3" : "/d/obj/misc/bag",
    "4" : "/d/qujing/qinfa/obj/dao",
  ]));
  setup();
  carry_object("/obj/cloth/pinkskirt")->wear();
}

void init ()
{
  ::init();
  add_action ("do_vendor_list", "list");
}