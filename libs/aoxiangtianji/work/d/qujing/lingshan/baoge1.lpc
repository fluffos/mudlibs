inherit SMALLROOM;
inherit LANDROOM;
inherit TEMPLEROOM;
void create ()
{
  set ("short", "宝阁");
  set ("long", @LONG
阁内有香案无数，每个香案上有金银香炉数只，仙香袅袅，缭
缭绕绕，阁北有一玉座落地金莲灯。西边有一殿门通向大雄宝
殿，楼上为宝阁藏经处。
LONG);
  set("exits", ([
    "up"   : __DIR__"baoge2",
    "north"   : __DIR__"chanfang1",
    "west"   : __DIR__"daxiong",
  ]));
  set("objects", ([
    __DIR__"npc/randeng" : 1,
    __DIR__"npc/xiantong" : 2,
  ]));
  setup();
}

int valid_leave(object me, string dir)
{
  object *inv;
  int sizeinv ;

  inv = all_inventory(me);
  sizeinv=sizeof(inv);
  while (sizeinv--)
    if (inv[sizeinv]->is_character())
      return notify_fail("你要背个活人去哪儿？\n");
  if (dir == "up")
  {
    if (me->query("obstacle/reward") < 1)
      return notify_fail("请回吧！\n");
  }

  return ::valid_leave(me, dir);
}

