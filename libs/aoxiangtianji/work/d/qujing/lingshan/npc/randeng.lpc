#include <ansi.h>
inherit "/d/qujing/lingshan/npc/dashizhi";
string give_book ();
void create()
{
  ::create();
  set_name(HIR"燃灯古佛"NOR, ({ "randeng gufo", "randeng", "gufo" }));
  set("title", "灵山");
  set("inquiry", ([
    "book" : (: give_book :),
    "jing" : (: give_book :),
    "qujing" : (: give_book :),
    "经" : (: give_book :),
    "取经" : (: give_book :),
    "经书" : (: give_book :),
  ]) );
}

void init()
{
  add_action("do_answer",({"answer","huida"}));
}

string give_book()
{
  object me = this_object();
  object who = this_player(1);
  if (who->is_busy())
    return "别着急！\n";

  who->start_busy(2);
  if (who->query("obstacle/number") < 34 ||
      !who->query("obstacle/reward"))
    return "取经结束了才可以来要。快去吧！\n";

  if (who->query("obstacle/book_given"))
    return "你不是已经得到了吗？当心贪心，当心佛祖惩罚你！\n";

  if (me->query_temp("given_book"))
    return "刚刚给了别人！等等再来！！\n";

  if (who->query("combat_exp") < 1000000)
    return "你的武学还不够，暂时还是不要拿了！\n";

  message_vision("$N说道：无字经书每人只能拿一次，武学需要100w！\n",me);
  tell_object(who,"你现在就要拿走吗？answer Y 或者 N ！\n");
  who->set_temp("randeng_answer",1);
  return "你自己考虑清楚！\n";
}

int do_answer(string arg)
{
  object who = this_player(1);
  object me = this_object();
  object book;

  if (!who->query_temp("randeng_answer"))
    return 0;
  if (!arg || (arg != "Y" && arg != "N"))
    return 0;

  who->delete_temp("randeng_answer");
  if (who->query("obstacle/number") < 34 ||
      !who->query("obstacle/reward"))
  {
    write("取经结束了才可以来要。快去吧！\n");
    return 1;
  }

  if (who->query("obstacle/book_given"))
  {
    write("你不是已经得到了吗？当心贪心，当心佛祖惩罚你！\n");
    return 1;
  }

  if (me->query_temp("given_book"))
  {
    write("刚刚给了别人！等等再来！！\n");
    return 1;
  }

  if (who->query("combat_exp") < 1000000)
  {
    write("你的武学还不够，暂时还是不要拿了！\n");
    return 1;
  }

  if (arg == "N")
  {
    message_vision("$N想了好一会，说道，我下次来取吧！\n",who);
    message_vision("$N点点头，说道：下次来取吧！\n",me);
    return 1;
  }

  message_vision("$N下定决心现在就取无字经！\n",who);
  book = new ("/d/obj/book/qujing");
  if(objectp(book) && book->move(who,1))
  {
    command ("nod");
    message_vision("$N给$n一本"+book->query("name")+"。\n",me,who);
    book->set("owner", who->query("id"));
    who->set("obstacle/book_given",1);
    me->set_temp("given_book",1);
    call_out("reset_give",600);
  }

  else if (objectp(book))
  {
    tell_object(who,"书掉到了地上，转眼就消失了！\n");
    destruct(book);
  }

  return 1;
}

void reset_give ()
{
  object me = this_object();
  me->set_temp("given_book",0);
}

