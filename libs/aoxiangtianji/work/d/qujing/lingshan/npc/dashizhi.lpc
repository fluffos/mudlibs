inherit NPC;
string *yi = ({
  "/obj/cloth/c-jiasha",
  "/obj/cloth/monkcloth",
  "/obj/cloth/seng-cloth",
  "/obj/cloth/sengpao",
  "/obj/cloth/sengyi",
  "/obj/cloth/y-jiasha",
});
void create()
{
  set_name("大势至菩萨", ({"dashizhi pusa", "dashizhi", "dashi", "pusa"}));
  set ("long", @LONG
南无阿弥陀佛次徒，观世音菩萨的师弟，三
人并称西方三神。
LONG);
  set("title", "西方三神之");
  set("gender", "男性");
  set("age", 400);
  set("str", 40);
  set("per", 40);
  set("int", 30);
  set("cor", 50);
  set("cps", 40);
  set("max_kee", 8000);
  set("max_gin", 8000);
  set("max_sen", 8000);
  set("force", 10000);
  set("max_force", 5000);
  set("force_factor", 250);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 250);
  set("combat_exp", 5000000);
  set("daoxing", 10000000);
  set_skill("literate", 300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("staff", 300);

  set_skill("lotusforce", 300);
  set_skill("buddhism", 300);
  set_skill("lotusmove", 300);
  set_skill("jienan-zhi", 300);
  set_skill("lunhui-staff", 300);
  map_skill("force", "lotusforce");
  map_skill("spells", "buddhism");
  map_skill("dodge", "lotusmove");
  map_skill("unarmed", "jienan-zhi");
  map_skill("parry", "lunhui-staff");
  map_skill("staff", "lunhui-staff");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
   (: cast_spell, "bighammer" :),
  }) );
  setup();
  carry_object(element_of(yi))->wear();
  carry_object("/d/obj/weapon/staff/chanzhang")->wield();
}

int accept_fight(object me)
{
  command("say 施主玩笑了\n");
  return 0;
}

void die()
{
  if( environment() )
  {
    message("sound", "\n\n大势至菩萨摇头叹道：冤孽！真是冤孽！n\n", environment());
    command("sigh");
    message("sound", "\n大势至菩萨驾祥云，登彩雾，径往西方去了。。。\n\n", environment());
  }

  destruct(this_object());
}