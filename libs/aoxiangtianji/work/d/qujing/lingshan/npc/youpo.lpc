#include <ansi.h>
inherit "/d/qujing/lingshan/npc/biqiu";
void create()
{
  ::create();
  if (random(2))
  {
    set_name(HIW"优婆塞"NOR, ({ "youpo sai", "youpo", "sai" }));
    set("gender", "男性");
  }

  else
  {
    set_name(HIG"优婆夷"NOR, ({ "youpo yi", "youpo", "yi" }));
    set("gender", "女性");
  }

}