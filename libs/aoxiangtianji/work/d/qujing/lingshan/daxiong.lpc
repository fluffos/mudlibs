int do_drop(string arg)
{
  object me=this_player();
  object obj;
  mapping quest_rulai;

  if( !arg )
    return 0;

  if( !objectp(obj = present(arg, me)) )
  {
    tell_object(me,"你身上没有这样东西。\n");
    return 1;
  }

  quest_rulai = me->query("quest_xyj/rulai");
  if (!mapp(quest_rulai) || sizeof(quest_rulai) < 1)
  {
    tell_object(me,"佛祖面前不要随便扔东西！\n");
    return 1;
  }

  if ( quest_rulai["type"] != "capture")
  {
     tell_object(me,"如来佛对你摇头说道：“乱丢垃圾会污染环境的。”\n");
     return 1;
  }

  if( !obj->is_character() )
  {
    tell_object(me,"如来佛对你叹道：怎么可以乱扔垃圾呢？当心咂坏了那些花花草草！\n");
    return 1;
  }

  else
  {
    if(obj->is_corpse() )
    {
      tell_object(me,"如来佛对你说道：怎么把死的也拿来了？\n");
      return 1;
    }

    if(obj->query("quester") != me->query("id") ||
       quest_rulai["npc_id"] != obj->query("id"))
    {
      tell_object(me,"如来佛对你说道：“我没有叫你擒此怪回来。”\n");
      return 1;
    }

    call_out ("accomplish",1,me,obj);
    return 0;
  }

}

void reward(object who, string name)
{
  object weapon;
  int count, mylvl, exp, qn, weiwang,score, t;

  mylvl = (int)who->query("level");
  count = who->query("quest_info/rulai/count");
  count++;
  t = time() - who->query_temp("quest_xyj/last_rulai_time");
  who->add("quest_info/rulai/total_num",1);
  who->add_temp("rulai/capture",1);
  exp = count + mylvl*8 + 150;
  exp += exp*((int)who->query("quest_xyj/rulai/level"))/2;
//  exp = exp/2 + random(exp);
  if (count > 800)
    count = 0;
  who->set("quest_info/rulai/count",count);
  who->add("balance",(mylvl+1)*2500 + random(5000));
  qn = exp/4 + random(exp/3);
  weiwang = 3+random(5);
  score = 4 + random(5);
  GIFT_D->delay_bonus(who, ([ "exp"     : random(1 + exp/3),
                              "daoxing" : exp,
                              "pot"     : qn ,
                              "mar"     : random(1 + qn/3*2),
                              "weiwang" : weiwang,
                              "score"   : score,
                              "prompt"  : "用时" + XYJTIME_D->query_time(t)
                                        + "，活擒" + name + "之后" ]), "rulai");
  if (weapon = who->query_temp("weapon") ||
      weapon = who->query_temp("armor/hands"))
    weapon->killer_reward(who, this_object());
  who->delete("quest_xyj/rulai");
  who->set_temp("rulai_zuochan",1);
  if (SYSQ_D->quest_exist(who,"rulai"))
    SYSQ_D->delete_quest("rulai",who);
  return;
}

void accomplish(object me, object obj)
{
  if (!me || !obj)
    return;

  if(!living(obj))
  {
    tell_room(this_object(),"几个金刚把"+obj->name()+"押了下去。\n\n");
    reward(me,obj->name());
    destruct (obj);
  }

  return;
}

int do_get(string arg)
{
  string from;
  object me = this_player();
  object env;

  if( !arg ) return 0;

  if( sscanf(arg, "%s from %s", arg, from)==2 )
  {
    env = present(from, me);
    if(!env) env = present(from, environment(me));
    if(!env) return 0;
    if(env->is_character() && !living(env))
    {
      tell_object(me,"如来佛对你摇了摇头。\n");
      return 1;
    }

  }

  else
  {
    env = present(arg, environment(me));
    if (!env)
      return 0;
    if(env->is_character() && !living(env))
    {
      tell_object(me,"如来佛对你摇了摇头。\n");
      return 1;
    }

  }

  return 0;
}

