inherit NPC;
void create()
{
  set_name("李天王", ({"li tianwang", "li", "tianwang"}));
  set("gender", "男性");
  set("age", 100);
  set("attitude", "friendly");
  set("combat_exp", 1250000);
  set("daoxing", 2000000);
  set("max_sen",1800);
  set("max_kee",1800);
  set("force",1800);
  set("max_force",1800);
  set("max_mana",1800);
  set("force_factor",125);
  setup();
  carry_object("/d/obj/armor/armor/jinjia")->wear();
}

void announce_success (object who)
{
  int dx, qn;
  if (who->query("obstacle/number") != 19 ||
      who->query("obstacle/jilei") == "done")
    return;
  if (! who->query_temp("obstacle/jilei_yumian_killed"))
    return;
  dx = random(2600);
  dx += 26000;
  qn = dx/3;
  who->set("obstacle/number",20);
  who->set("obstacle/jilei","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  command("chat "+who->query("name")+"积雷山显神通，摩云洞降牛魔！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed jilei on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}