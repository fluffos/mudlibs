inherit NPC;
void create()
{
  set_name("玉面公主", ({ "yumian gongzhu", "yumian", "gongzhu", "princess" }));
  set("title", "积雷山");
  set("long", "一位娇柔万分的女子，伶俐地扭动着腰肢。\n");
  set("gender", "女性");
  set("age", 16);
  set("attitude", "heroism");
  set("per", 32);
  set("max_kee", 3500);
  set("max_sen", 3500);
  set("force", 3200);
  set("max_force", 1800);
  set("force_factor", 80);
  set("max_mana", 1800);
  set("mana", 3200);
  set("mana_factor", 90);
  set("combat_exp", 1800000);
  set("daoxing", 1800000);
  set("no_bian",1);
  set("no_ji", 1);
  set_skill("force", 160);
  set_skill("spells", 160);
  set_skill("dodge", 160);
  set_skill("unarmed", 160);
  set_skill("parry", 160);
  set_skill("sword",160);
  set_skill("moonforce", 160);
  set_skill("moonshentong", 160);
  set_skill("moondance", 160);
  set_skill("baihua-zhang", 160);
  set_skill("huifeng-sword", 160);

  map_skill("force","moonforce");
  map_skill("spells", "moonshentong");
  map_skill("unarmed", "baihua-zhang");
  map_skill("dodge", "moondance");
  map_skill("sword", "huifeng-sword");
  map_skill("parry", "huifeng-sword");
  setup();
  carry_object("/obj/cloth/pinkskirt")->wear();
  carry_object("/d/obj/armor/shoes/huazheboots")->wear();
  carry_object("/d/obj/armor/surcoat/surcoat")->wear();
  carry_object("/d/obj/weapon/sword/snow_sword")->wield();
}

void die ()
{
  object me = this_object();
  object ob = query_temp("my_killer");
  if (objectp(ob) &&
      ob == me->query_last_damage_from())
    ob->set_temp("obstacle/jilei_yumian_killed",1);
  message_vision ("\n$N翻倒在地现了真身，竟是一只狐狸精。\n",me);
  message_vision ("狐狸精扑在地上，死了。\n\n",me);
  me->command("remove boots");
  me->command("remove pifeng");
  me->command("drop boots");
  me->command("drop pifeng");
  destruct (me);
  return;
}

void unconcious ()
{
  die ();
}

int accept_fight(object ob)
{
  kill_ob(ob);
  return 1;
}

void kill_ob (object ob)
{
  object me = this_object();
  object where = environment (me);
  object niumo = present ("niumo wang", where);
  set_temp("my_killer",ob);
  ::kill_ob(ob);
  if (niumo && !playerp(niumo))
  {
    niumo->remove_all_enemy();
    niumo->kill_ob(ob);
  }

}

