#include <ansi.h>
#include "/d/qujing/kusong/npc/hyd.h"
inherit NPC;
inherit F_MASTER;
string ask_fuma();
void create()
{
  set_name("牛魔王", ({ "niumo wang", "niumo", "wang" }));
  set("title", "大力王");
  set("long", "一位身材魁伟力大无比的魔王，一双牛蛋眼正煞神一般瞪着你。\n");
  set("gender", "男性");
  set("age", 70);
  set("attitude", "heroism");
  set("class", "yaomo");
  set("per", 10);
  set("str", 40);
  set("con", 30);
  set("max_kee", 4500);
  set("max_sen", 4500);
  set("force", 5000);
  set("max_force", 2500);
  set("force_factor", 120);
  set("max_mana", 2500);
  set("mana", 5000);
  set("mana_factor", 120);
  set("combat_exp", 2200000);
  set("daoxing", 2200000);
  set("inquiry", ([
    "月牙铲" : (: ask_fuma :),
  ]) );
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("stick",200);
  set_skill("huomoforce",200);
  set_skill("pingtian-dafa",200);
  set_skill("moshenbu", 200);
  set_skill("moyun-shou",200);
  set_skill("dali-stick",200);

  map_skill("force","huomoforce");
  map_skill("spells","pingtian-dafa");
  map_skill("dodge","moshenbu");
  map_skill("unarmed","moyun-shou");
  map_skill("stick","dali-stick");
  map_skill("parry","dali-stick");
  set("no_ji", 1);
  set("nb_heads",30);
  create_family("火云洞", 2, "蓝");
  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  call_out ("riding",1);
}

void riding ()
{
  command ("mount jinjing shou");
}

int check_heads (object me, object ob)
{
  int nb_heads = query("nb_heads")-1;
  object weapon;
  object head;
  me->set("nb_heads",nb_heads);
  if (! ob)
    return nb_heads;
  if (nb_heads <= 0)
    return nb_heads;
  weapon = ob->query_temp("weapon");
  if (! weapon)
    message_vision ("\n$N大喝一声扑向$n，以排山倒海之势将$n的牛头扳了下来。\n",ob,me);
  else if (weapon->query("skill_type") == "axe")
    message_vision ("\n$N高高举起$n，排山倒海地大喝一声，将牛头劈了下来。\n",ob,weapon);
  else if (weapon->query("skill_type") == "blade")
    message_vision ("\n$N高高举起$n，排山倒海地大喝一声，将牛头砍了下来。\n",ob,weapon);
  else if (weapon->query("skill_type") == "sword")
    message_vision ("\n$N高高举起$n，排山倒海地大喝一声，将牛头削了下来。\n",ob,weapon);
  else if (weapon->query("skill_type") == "dagger")
    message_vision ("\n$N高高举起$n，排山倒海地大喝一声，将牛头割了下来。\n",ob,weapon);
  else if (weapon->query("skill_type") == "fork")
    message_vision ("\n$N高高举起$n，排山倒海地大喝一声，将牛头叉了下来。\n",ob,weapon);
  else if (weapon->query("skill_type") == "hammer")
    message_vision ("\n$N高高举起$n，排山倒海地大喝一声，将牛头砸了下来。\n",ob,weapon);
  else if (weapon->query("skill_type") == "spear")
    message_vision ("\n$N高高举起$n，排山倒海地大喝一声，将牛头挑了下来。\n",ob,weapon);
  else if (weapon->query("skill_type") == "staff")
    message_vision ("\n$N高高举起$n，排山倒海地大喝一声，将牛头扫了下来。\n",ob,weapon);
  else if (weapon->query("skill_type") == "stick")
    message_vision ("\n$N高高举起$n，排山倒海地大喝一声，将牛头扫了下来。\n",ob,weapon);
  else if (weapon->query("skill_type") == "throwing")
    message_vision ("\n$N高高举起$n，排山倒海地大喝一声，将牛头射了下来。\n",ob,weapon);
  else if (weapon->query("skill_type") == "whip")
    message_vision ("\n$N高高举起$n，排山倒海地大喝一声，将牛头抽了下来。\n",ob,weapon);
  else if (weapon->query("skill_type") == "mace")
    message_vision ("\n$N高高举起$n，排山倒海地大喝一声，将牛头抽了下来。\n",ob,weapon);
  else
    message_vision ("\n$N大喝一声扑向$n，以排山倒海之势将$n的牛头扳了下来。\n",ob,me);

  head = new ("/d/qujing/jilei/obj/head");
  head->move(environment(me));
  return nb_heads;
}

void die ()
{
  object li;
  object me = this_object();
  object ob = query_last_damage_from();
  object killer = query_temp("my_killer");
  object last = query_temp("last_killed_by");

  if(killer != ob)
    set("nb_heads",40);
// mon 7/30/98
// to prevent other players help to kill niu.
  if(!objectp(last))
    last = ob;
  else if(last != ob)
    set("nb_heads",40); // someone else help, reset count.

  set_temp("last_killed_by",ob);
  if (check_heads (me, ob) > 0)
  {
    set("kee", 4500);
    set("sen", 4500);
    set("eff_kee", 4500);
    set("eff_sen", 4500);
    set("force", 2700);
    set("mana", 2700);
    message_vision ("\n只见牛腔里摇摇晃晃又钻出一个牛头来！\n",me);
    if (ob)
      message_vision ("\n$N精神抖擞地又向$n发起攻击！\n",me,ob);
    return;
  }

  if (objectp(ob) &&
      (int)ob->query("obstacle/number") == 19 &&
      (string)ob->query("obstacle/jilei") != "done")
  {
    li = new ("/d/qujing/jilei/npc/li");
    li->move(environment (ob));
    li->announce_success (ob);
    destruct (li);
  }

  message_vision ("\n天上托塔李天王大吼一声：牛魔归佛也！\n",me);
  message_vision ("\n$N闻声软了下来，还原成一只大白牛，喘着热气。\n",me);
  message_vision ("李天王走过来，用金链拴在牛鼻子上，将$N牵走了。\n",me);
  destruct (me);
}

void unconcious ()
{
  die ();
}

int accept_fight(object ob)
{
  command("exert powerup");
  kill_ob(ob);
  ob->kill_ob(this_object());
  return 1;
}

int test_player (object who)
{
  string *names;
  string name;
  names = who->query_temp("apply/name");
  if (! names)
    return 0;
  if (sizeof(names) < 1)
    return 0;
  name = names[0];
  if (name == "铁扇公主")
    return 1;
  return 0;
}

void kill_ob (object ob)
{
  object me = this_object();

  ::kill_ob(ob);
  if (! test_player (ob))
  {
    message_vision ("$N一双牛蛋眼瞪着你，大吼一声：你！你！滚！\n",me);
    message_vision ("$N现了大白牛的原形向$n扑来，疯狂地低头一顶！\n",me,ob);
    message_vision ("$N一个措手不及，凌空飞起！\n",ob);
    ob->move("/d/qujing/jilei/shidong");
    message_vision ("“轰”地$N摔将下来！\n",ob);
    ob->receive_damage("kee",ob->query("max_kee")/2);
    ob->receive_damage("sen",ob->query("max_sen")/2);
    ob->receive_wound("kee",ob->query("max_kee")/2);
    ob->receive_wound("sen",ob->query("max_sen")/2);
    ob->unconcious();
    return;
  }

  if (!query_temp("my_killer"))
  {
    message_vision ("\n$N大怒：哪个泼贼子冒充俺浑家！\n",me);
    set_temp("my_killer",ob);
  }

  call_out ("checking",1,me,ob);
/*
  if (yumian && !playerp(yumian))
  {
    yumian->remove_all_enemy();
    yumian->kill_ob(ob);
  }

*/
}

void checking (object me, object ob)
{
  if (!objectp(me) || !objectp(ob) || environment(me) != environment(ob))
    return;

  if (me->is_fighting(ob))
  {
    remove_call_out ("checking");
    call_out ("checking",1,me,ob);
  }

  else
  {
    int i = 50 - ob->query_kar();
    if (i < 10)
      i = 10;
    me->set("nb_heads",random(i + 10));
  }

}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "火云洞")
  {
    command("say 我只收火云洞的弟子！\n");
    return 0;
  }

  if (!ob->query("family/can_bai/niumo"))
  {
    command("say 我和你素无渊源，这拜师从何谈起？\n");
    return 0;
  }

  if ((int)ob->query("level") <= 25)
  {
    command("say 你还需要多努力！\n");
    return 0;
  }

  command("grin");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "yaomo")
    ob->set("class", "yaomo");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "火云洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我火云洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "yaomo")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我妖魔中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 25)
  {
    command("say 你还需要多多磨练才行啊！\n");
    return 1;
  }

  return 0;
}

string ask_fuma()
{
  object me;
  me = this_player(1);
  if ((string)me->query("family/family_name") != "火云洞")
  {
    command("say 你是谁？干吗？？\n");
    command("look " + me->query("id"));
    command("grin");
    return "当心我咬你两口！嘿！\n";
  }

  if ((int)me->query("level") > 25)
  {
    command("hmm");
    command("say 碧波潭的九头驸马对这月牙铲比较精通！\n");
    if ((int)me->query("family/family_faith") < 1000)
      return "不过你还是先安心的为本门尽力吧！\n";
    command("say 我可以推荐你到那里进行学习！\n");
    me->set("family/can_bai/fuma",1);
    return "你这就去吧！\n";
  }

  command("say 你还是先安心的修炼吧！本事不高，心倒蛮大的！\n");
  command("sigh2");
  return "快快自己修炼去吧！\n";
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  switch (topic)
  {
    case "棒惊神佛" :
    case "shenfo" :
      if (me->query("family/family_name") != master->query("family/family_name"))
        return "你不是我火云洞的弟子！\n";
      if (me->query("class") != "yaomo")
        return "嘿嘿，你问我何用？\n";
      if (me->query("family/can_pfm/shenfo"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("dali-stick",1) < 120)
        return "你的大力棒修为不够，暂时无法领悟！\n";
      if (me->query_skill("huomoforce",1) < 120)
        return "你的火魔心法修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/shenfo",1);
      return "你学会了“棒惊神佛”！\n";
      break;
  }

  return 0;
}