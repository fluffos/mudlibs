inherit F_VENDOR_SALE;
void create()
{
  reload("jinping_dian_zhu");
  set_name("店主", ({"dian zhu", "zhu"}));
  set("shop_id", ({"dianzhu", "zhu"}));
  set("gender", "男性");
  set("combat_exp", 5000);
  set("age", 30);
  set("per", 21);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 30);
  set("vendor_goods", ([
    "1" : "/d/qujing/jinping/obj/hulu",
    "2" : "/d/qujing/jinping/obj/ji",
    "3" : "/d/qujing/jinping/obj/doufu",
    "4" : "/d/qujing/jinping/obj/mianjin",
    "5" : "/d/qujing/jinping/obj/gao",
    "6" : "/d/qujing/jinping/obj/bing",
    "7" : "/d/qujing/jinping/obj/guan",
  ]) );
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}

void init()
{
  ::init();
  add_action("do_vendor_list", "list");
}