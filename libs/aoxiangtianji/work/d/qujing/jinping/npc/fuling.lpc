inherit NPC;
void create()
{
  set_name("府令", ({ "fu ling", "ling" }) );
  set("gender", "男性");
  set("age", 50);
  set("combat_exp", 120000);
  set("attitude", "heroism");
  set("str", 30);
  set("max_kee", 600);
  set("max_gin", 600);
  set("force", 600);
  set("max_force", 600);
  set("force_factor", random(30)+15);
  set_skill("unarmed", 60);
  set_skill("parry", 60);
  set_skill("dodge", 60);
  setup();
  carry_object("/obj/cloth/changpao")->wear();
}

void announce_success (object who)
{
  int dx, qn;
  if (who->query("obstacle/number") != 32 ||
      who->query("obstacle/jinping") == "done" ||
      !who->query_temp("obstacle/jinping_oil_over") ||
      !who->query_temp("obstacle/jinping_pi1_killed") ||
      !who->query_temp("obstacle/jinping_pi2_killed") ||
      !who->query_temp("obstacle/jinping_pi3_killed"))
    return;

  dx = random(4000);
  dx += 40000;
  qn = dx/3;
  who->set("obstacle/number",33);
  who->set("obstacle/jinping","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  who->delete_temp("obstacle/jinping_oil_over");
  who->delete_temp("obstacle/jinping_pi1_killed");
  who->delete_temp("obstacle/jinping_pi2_killed");
  who->delete_temp("obstacle/jinping_pi3_killed");
  command("chat "+who->query("name")+"金平府灯会解难，青龙山除犀牛精！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed jinping on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}

