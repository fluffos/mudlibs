inherit ITEM;
void burning();
void create()
{
  set_name("金灯缸", ({"jindeng gang", "gang"}));
  set_weight(5000000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一个装着酥合香油的大缸，里面有四十九根大灯马。\n");
    set("unit", "个");
    set("no_get",1);
  }

}

void init ()
{
  if (!playerp(this_player()))
   return;
  if (random(30) == 1)
    burning();
}

void burning ()
{
  object where = environment(this_object());
  string *msgs = ({
    "金灯缸里灯火一闪。\n",
    "金灯缸里的灯火被风一吹，跳了一下。\n",
    "灯火闪了一闪。\n",
    "灯火在缸里跳了一下。\n",
  });
  tell_room (where,element_of(msgs));
}