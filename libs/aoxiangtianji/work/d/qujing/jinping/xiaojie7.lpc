inherit "/d/qujing/jinping/xiaojie1";
void create ()
{
  ::create();
  set("exits", ([
    "west"   : __DIR__"xiaojie6",
    "north"   : __DIR__"xiaojie3",
    "southeast"   : __DIR__"cunlu3",
  ]));
}

int valid_leave (object who, string dir)
{
  if (! interactive (who) &&
      dir == "southeast")
    return 0;
  return ::valid_leave (who, dir);
}

