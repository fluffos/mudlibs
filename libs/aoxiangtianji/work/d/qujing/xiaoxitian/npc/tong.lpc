inherit "/d/qujing/npc/xiaoyao";
string *names = ({
  "黑鼠怪",
  "黄犰怪",
  "灰狨怪",
  "白猁怪",
  "赤狻怪",
  "土猬怪",
  "石猊怪",
  "木猱怪",
  "水獾怪",
});
void create()
{
  ::create();
  set_name("小童", ({"xiao tong", "tong"}));
  set("gender", "男性");
  set("age", 13);
}

void kill_ob (object ob)
{
  object yao;
  object me = this_object();
  message_vision ("$N顿时变了颜色，现了妖精的本相！\n",me);
  yao = new("/d/qujing/xiaoxitian/npc/yao");
  yao->move(environment(me));
  yao->kill_ob(ob);
  destruct(me);
}