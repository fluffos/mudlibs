inherit NPC;
void create()
{
  set_name("黄眉老佛", ({ "huangmei laofo", "huangmei", "laofo", "fo" }));
  set("title", "小雷音寺");
  set("long", "一位面无表情却又精神焕发的老佛。\n");
  set("gender", "男性");
  set("age", 80);
  set("attitude", "heroism");
  set("per", 30);
  set("str", 30);
  set("spi", 30);
  set("con", 30);
  set("dex", 30);

  set("no_ji",1);
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 6000);
  set("max_force", 3000);
  set("force_factor", 120);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 200);

  set("combat_exp", 2200000);
  set("daoxing", 2200000);
  set_skill("force", 200+random(50));
  set_skill("spells", 200+random(50));
  set_skill("dodge", 200+random(50));
  set_skill("unarmed", 200+random(50));
  set_skill("parry", 200+random(50));
  set_skill("mace", 200+random(50));

  set_skill("lotusforce", 200+random(50));
  set_skill("buddhism", 200+random(50));
  set_skill("lotusmove", 200+random(50));
  set_skill("jienan-zhi", 200+random(50));
  set_skill("jinglei-mace", 200+random(50));
  map_skill("force", "lotusforce");
  map_skill("spells", "buddhism");
  map_skill("dodge", "lotusmove");
  map_skill("unarmed", "jienan-zhi");
  map_skill("parry", "jinglei-mace");
  map_skill("mace", "jinglei-mace");
  setup();
  carry_object("/obj/cloth/y-jiasha")->wear();
  carry_object("/d/qujing/xiaoxitian/obj/shield")->wear();
  carry_object("/d/qujing/xiaoxitian/obj/mace")->wield();
  carry_object("/d/obj/fabao/baoreal");
}

void die ()
{
  object mile;
  string msg;
  object me = this_object();
  object ob = query_temp("my_killer");
  object fabao = present ("fabao",me);
  if (objectp(ob) &&
      ob == me->query_last_damage_from() &&
      (int)ob->query("obstacle/number") == 22 &&
      (string)ob->query("obstacle/xiaoxitian") != "done")
  {
    mile = new ("/d/qujing/xiaoxitian/npc/mile");
    mile->move(environment(ob));
    mile->announce_success(ob);
    destruct (mile);
  }

  msg = "\n旋风出现，弥勒佛祖走了进来。\n";
  msg += "\n$N连忙慌着跪了下来，却还身作一黄眉小童。\n";
  msg += "弥勒佛祖领着黄眉小童走了出去！\n";

  if (fabao)
  {
    msg += "黄眉小童丢下一只" + fabao->name() + "。\n";
    fabao->move(environment(me));
  }

  message_vision (msg,me);
  command("unwield mace");
  command("drop mace");
  destruct(me);
  return;
}

void unconcious ()
{
  die ();
}

int accept_fight(object ob)
{
  kill_ob(ob);
  return 1;
}

void kill_ob (object ob)
{
  object me = this_object();
  set_temp("my_killer",ob);
  call_out ("hurting",random(5)+5,me,ob);
  ::kill_ob(ob);
}

void hurting (object me, object ob)
{
  object fabao;
  if (!objectp(me) || !environment(me))
    return;

  fabao = present ("fabao",me);

  if (!objectp(fabao) || !objectp(ob) || !environment(ob))
    return;
  if (environment(me) != environment(ob))
    return;
  if (!me->is_fighting(ob))
    return;

  command("ji fabao on "+ ob->query("id"));
  remove_call_out ("hurting");
  call_out ("hurting",random(10)+10,me,ob);
}

