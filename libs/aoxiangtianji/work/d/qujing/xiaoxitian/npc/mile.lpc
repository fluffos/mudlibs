inherit NPC;
void create()
{
  set_name("弥勒佛祖", ({"mile fozu", "mile", "fozu"}));
  set("gender", "男性");
  set("age", 100);
  set("attitude", "friendly");
  set("combat_exp", 1250000);
  set("daoxing", 5000000);
  set("per", 25);
  set("max_sen",1800);
  set("max_gee",1800);
  set("max_gin",1800);
  set("force",1800);
  set("max_force",1800);
  set("max_mana",1800);
  setup();
}

void announce_success (object who)
{
  int dx, qn;
  if ((int)who->query("obstacle/number") != 22 ||
      (string)who->query("obstacle/xiaoxitian") == "done")
    return;
  dx = random(2800);
  dx += 28000;
  qn = dx/3;

  who->set("obstacle/number",23);
  who->set("obstacle/xiaoxitian","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  command("chat "+who->query("name")+"小西天金铙脱险，小雷音寺战胜黄眉老佛！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed xiaoxitian on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}