inherit MIDDLEROOM;
inherit LANDROOM;
string *w = ({
  __DIR__"obj/boots",
  __DIR__"obj/finger",
  __DIR__"obj/hands",
  __DIR__"obj/head",
  __DIR__"obj/neck",
  __DIR__"obj/waist",
  __DIR__"obj/wrists",
});

void create ()
{
  string *ob = ({});

  set ("short", "洞内");
  set ("long", @LONG
宽敞的洞内雾气腾腾，洞顶上长着粗长的青藤，从头上挂下来。
洞壁插着兽油火把，吱吱地冒着烟，将洞内照亮。洞的地上填
得平平整整，铺着一块一块石板。
LONG);
  set("exits", ([
    "east"   : __DIR__"dongnei3",
    "south"   : __DIR__"dongnei4",
  ]));
  ob += ({element_of(w)});
  w -= ob;
  ob += ({element_of(w)});
  w -= ob;
  ob += ({element_of(w)});
  w -= ob;

  set("objects", ([
      __DIR__"npc/yao"   : 2,
      element_of(w) : 1,
      element_of(ob) : 1,
  ]));
  set("force_clean_temp",1);
  setup();
}