inherit NPC;
void create()
{
  set_name("李老君", ({"li laojun", "li", "laojun"}));
  set("gender", "男性");
  set("age", 100);
  set("attitude", "friendly");
  set("combat_exp", 1250000);
  set("daoxing", 10000000);
  set("per", 25);
  set("max_sen",1800);
  set("max_gee",1800);
  set("max_gin",1800);
  set("force",1800);
  set("max_force",1800);
  set("max_mana",1800);
  set("force_factor",125);
  setup();
  carry_object("/obj/cloth/changpao")->wear();
}

void announce_success (object who)
{
  int dx, qn;
  if ((int)who->query("obstacle/number") != 15 ||
      (string)who->query("obstacle/jindou") == "done")
    return;
  dx = random(2400);
  dx += 24000;
  qn = dx/3;

  who->set("obstacle/number",16);
  who->set("obstacle/jindou","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  command("chat "+who->query("name")+"金兜山大战独角兕，替老夫收回青牛！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed jindou on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}