inherit NPC;
void create()
{
  set_name("独角兕大王", ({ "dujiaosi dawang", "dujiaosi", "dawang", "wang" }));
  set("title", "金兜洞");
  set("long", "一位身材壮实的大块头妖王，头上长着一只角。\n");
  set("gender", "男性");
  set("age", 70);
  set("attitude", "heroism");
  set("per", 30);

  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 6000);
  set("max_force", 3000);
  set("force_factor", 120);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 120);
  set("combat_exp", 2500000);
  set("daoxing", 2500000);
  set("no_ji",1);

  set_skill("force", 200 + random(50));
  set_skill("spells", 200 + random(50));
  set_skill("dodge", 200 + random(50));
  set_skill("unarmed", 200+random(50));
  set_skill("parry", 200+random(50));
  set_skill("spear", 200+random(50));

  set_skill("wuxiangforce", 200+random(50));
  set_skill("dao", 200+random(50));
  set_skill("jindouyun", 200+random(50));
  set_skill("puti-zhi", 200+random(50));
  set_skill("duo-spear", 200+random(50));
  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("spear", "duo-spear");
  map_skill("parry", "duo-spear");
  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/armor/armor/yinjia")->wear();
  carry_object("/d/qujing/jindou/obj/qiang")->wield();
  carry_object("/d/obj/fabao/zhuoreal");
}

void die ()
{
  string msg;
  object li;
  object me = this_object();
  object ob = query_temp("my_killer");
  object fabao = present ("fabao",me);
  if (objectp(ob) &&
      ob == me->query_last_damage_from() &&
      (int)ob->query("obstacle/number") == 15 &&
      (string)ob->query("obstacle/jindou") != "done")
  {
    li = new ("/d/qujing/jindou/npc/lilao");
    li->move(environment(ob));
    li->announce_success (ob);
    destruct (li);
  }

  msg = "\n一阵风吹来，传来天上李老君的声音：牛儿回家也！\n";
  msg += "\n$N闻声现了原身，果然是一头大青牛。\n";
  msg += "大青牛沿着李老君声音的方向奔去！\n";

  if (fabao)
  {
    msg += "大青牛丢下了一只$n\n";
    fabao->move(environment(me));
  }

  message_vision(msg,me,fabao);
  command("unwield spear");
  command("drop spear");
  destruct (me);
  return;
}

void unconcious ()
{
  die ();
}

int accept_fight(object ob)
{
  kill_ob(ob);
  return 1;
}

void kill_ob (object ob)
{
  object me = this_object();
  set_temp("my_killer",ob);
  call_out ("hurting",random(5)+5,me,ob);
  ::kill_ob(ob);
}

void hurting (object me, object ob)
{
  object fabao;
  object *w;
  if (!objectp(me) || !environment(me))
    return;

  fabao = present ("fabao",me);

  if (!objectp(fabao) || !objectp(ob) || !environment(ob))
    return;
  if (environment(me) != environment(ob))
    return;
  if (!me->is_fighting(ob))
    return;

  w = all_inventory(fabao);
  if (sizeof(w) > 0)
  {
    command("get " + w[0]->query("id") + " from fabao");
    command("drop " + w[0]->query("id"));
  }

  command("ji fabao on "+ ob->query("id"));
  remove_call_out ("hurting");
  call_out ("hurting",random(10)+10,me,ob);
}

