inherit SMALLROOM;
inherit LANDROOM;
void create()
{
  set ("short", "小酒店");
  set ("long", @LONG
山前小店，南来北往的行人都喜欢在这里喝上一杯，虽然店
不是很大，经营的东西不是什么特别好的货色，但在这荒山
野岭之中却又难得之至，所以客人很多。一个伙计前前后后
的忙着。
LONG);
  set("exits", ([
    "north" : __DIR__"tulu1",
  ]));
  set("objects", ([
     "/obj/npc/xiaoer2": 1,
  ]) );
  set("no_clean_up", 0);
  setup();
}

