#include <ansi.h>
inherit NPC;
int say_zhu();
int test_jing(object ob);
void create()
{
  set_name("灵吉菩萨", ({"lingji pusa", "pusa"}));
  set("long", "一位慈眉善目的老人，闻说法力高强，在此设院讲经传道，渡化世人。\n");
  set("gender", "男性");
  set("age", 80);
  set("attitude", "friendly");
  set("combat_exp", 3000000);
  set("daoxing", 3000000);
  set("per", 100);
  set("spi", 40);
  set("str", 40);

  set("max_sen",4000);
  set("max_kee",4000);
  set("force",6000);
  set("max_force",3000);
  set("max_mana",3000);
  set("mana",6000);
  set("force_factor",150);
  set("mana_factor",150);

  set_skill("literate", 300);
  set_skill("force", 300);
  set_skill("spells",300);
  set_skill("dodge", 300);
  set_skill("unarmed",300);
  set_skill("parry", 300);
  set_skill("staff", 300);

  set_skill("lotusforce",300);
  set_skill("buddhism", 300);
  set_skill("lotusmove", 300);
  set_skill("jienan-zhi", 300);
  set_skill("lunhui-staff",300);

  map_skill("force","lotusforce");
  map_skill("spells", "buddhism");
  map_skill("dodge", "lotusmove");
  map_skill("unarmed", "jienan-zhi");
  map_skill("parry", "lunhui-staff");
  map_skill("staff", "lunhui-staff");

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: cast_spell, "bighammer" :),
  }) );

  set("inquiry",([
     "珠" : (: say_zhu :),
     "定风珠" : (: say_zhu :),
     "zhu" : (: say_zhu :),
     "name" : "老衲灵吉。",
     "here" : "这里是老衲讲经的地方，小须弥山！",
     "rumors" : "说来惭愧，老衲的定风珠竟被妖怪盗了去！",
  ]));
  setup();
  carry_object("/obj/cloth/y-jiasha")->wear();
  carry_object("/d/obj/weapon/staff/budd_staff")->wear();
}

int say_zhu()
{
  object  me=this_player();

  if ((int)me->query("obstacle/number") != 4 ||
      (string)me->query("obstacle/huangfeng") == "done")
    message_vision("$N躬身一谢，言道：“施主放心，老衲已将定风珠收妥了，不会再丢。”\n",this_object());
  else
  {
    command("sigh");
    command("say 三天前，被那怪一阵阴风摄了去，听说藏于他那后园之中了。\n");
  }

  return 1;
}

void die()
{
  if( environment() )
  {
    message("sound", "\n灵吉菩萨摇头叹道：大法未彰，归去归去,阿弥陀佛！\n\n", environment());
    command("sigh");
    message("sound", "\n灵吉菩萨跃上八爪金龙，架祥云而往西方去了。。。\n\n", environment());
    destruct(this_object());
  }

}

void unconcious()
{
  die();
}

void announce_success (object who)
{
  int dx, qn;
  object zhu;
  if ((int)who->query("obstacle/number") != 4)
    return;

  if (who->query("obstacle/huangfeng") == "done")
    return;

  if (!who->query_temp("obstacle/huangfeng_zhu_getted"))
    return;

  if( !(zhu = present("dingfeng zhu", who)) )
    return;

  dx = random(1600);
  dx += 16000;
  qn = dx/3;

  message_vision(HIW"半空中，灵吉菩萨把手一招，定风珠从$N"
                 HIW"身上破空而去，稳稳的定在菩萨的手中。\n"NOR,who);
  destruct(zhu);
  who->delete_temp("obstacle/huangfeng_zhu_getted");
  who->set("obstacle/number",5);
  who->set("obstacle/huangfeng","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  command("chat " + who->query("name")+"黄风岭降服黄风怪，为佛祖寻回定风珠！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed huangfeng on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}