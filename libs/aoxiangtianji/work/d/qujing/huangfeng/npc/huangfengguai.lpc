#include <ansi.h>
inherit NPC;
string say_zhu();
int query_hupi(object me);
void create()
{
  set_name("黄风怪", ({"huangfeng guai","guai","huangfeng","huang"}));
  set("long","红眉褐发，威风凛凛。人称黄风大王。\n");
  set("gender", "男性" );
  set("age", 40);
  set("title", "黄风岭大王");
  set("combat_exp", 2200000);
  set("daoxing", 2200000);
  set("attitude", "friendly");
  set("int", 30);
  set("cor", 35);
  set("spi", 30);
  set("con", 35);
  set("dex", 30);
  set("str", 35);
  set("no_ji",1);
  set_skill("force", 180 + random(50));
  set_skill("spells", 180 + random(50));
  set_skill("dodge", 180 + random(50));
  set_skill("unarmed", 180 + random(50));
  set_skill("parry", 180 + random(50));
  set_skill("fork", 180 + random(50));
  set_skill("huntian-qigong", 180 + random(50));
  set_skill("yaofa", 180 + random(50));
  set_skill("lingfu-steps", 180 + random(50));
  set_skill("yinfeng-zhua", 180 + random(50));
  set_skill("fengbo-fork", 180 + random(50));
  map_skill("force", "huntian-qigong");
  map_skill("spells", "yaofa");
  map_skill("dodge", "lingfu-steps");
  map_skill("unarmed", "yinfeng-zhua");
  map_skill("parry", "fengbo-fork");
  map_skill("fork", "fengbo-fork");
  set("max_kee", 4800);
  set("max_sen", 4800);
  set("force", 4200);
  set("max_force", 2200);
  set("force_factor", 110);
  set("mana", 4200);
  set("max_mana", 2200);
  set("mana_factor", 110);
  set_temp("gave_key", 0);

  set("inquiry",([
     "珠": (: say_zhu :),
     "定风珠": (: say_zhu :),
     "zhu":(: say_zhu :),
     "name": "老子就是这黄风岭的大寨主！",
     "here": "这里就是黄风岭！",
  ]));
  setup();
  carry_object("/d/obj/weapon/fork/sangu-cha")->wield();
  carry_object("/d/obj/armor/surcoat/jinyipifeng")->wear();
  carry_object("/d/obj/armor/head/huangjin-zhankui")->wear();
}

string say_zhu()
{
  object  me = this_player();
  object  ob;
  object  npc = this_object();
  if(npc->is_fighting() || me->is_fighting())
    return ("哼，老子先剁了你再说！");
  if ((int)me->query("obstacle/number") != 4)
  {
    call_out("killplayer", 1, me);
    return ("你找死啊？看招！");
  }
  if (!me->query_temp("apply/id") ||
      me->query_temp("apply/id")[0] != "hu xianfeng" ||
      !query_hupi(me))
  {
    call_out("killplayer", 1, me);
    return ("哪儿来的"+RANK_D->query_rude(me)+"？胆敢窥探本大王的宝贝,看招！");
  }

  if (me->query_temp("mark/huangfeng_guai_gave_me_key"))
  {
    call_out("killplayer", 1, me);
    return ("你又来了？原来是个假的,看招！");
  }

  if (npc->query_temp("gave_key"))
  {
    command("?");
    call_out("killplayer", 1, me);
    return ("怎么又来了一个要钥匙的？假的,看招！");
  }

  message_vision(CYN"黄风怪对$N" CYN"说：“不知宝贝有没有丢失，你去看看。”\n"NOR, me);
  message_vision(CYN"黄风怪对$N" CYN"叮咛道：“要小心看住，不要有所闪失！”\n"NOR,me);
  ob=new("/d/qujing/huangfeng/obj/key");
  npc->set_temp("gave_key", 1);
  ob->move(me);
  ob->set("owner", me->query("id"));
  me->set_temp("mark/huangfeng_guai_gave_me_key", 1);
  message_vision(YEL"黄风怪给$N" YEL"一把钥匙。\n"NOR,me);
  return ("看好那宝贝！好好干，本王不会亏待你的。\n");
}

void killplayer(object me)
{
  this_object()->kill_ob(me);
}

int query_hupi(object me)
{
  object hupi;

  if (!playerp(me))
    return 0;
  hupi = present("hu pi",me);
  if (!objectp(hupi))
    return 0;

  if (!hupi->query("equipped"))
    return 0;

  return 1;
}

void init()
{
  object me;
  ::init();
  if( playerp(me = this_player()) && !is_fighting() )
  {
    call_out("greeting", 1, me);
  }

}

void greeting(object me)
{
  if(!me || environment(me) != environment() )
    return;
  if(me->query_temp("obstacle/has_here") != 0)
    return;
  me->set_temp("obstacle/has_here",1);
  if (!me->query_temp("apply/id") ||
      me->query_temp("apply/id")[0] != "hu xianfeng" ||
      !query_hupi(me))
  {
    command("say 哪来的混账？竟敢混入黄风洞？！看招！");
    kill_ob(me);
    return;
  }

}

int test_player (object who)
{
  object  me,zhu;

  me = this_player();
  zhu = present("dingfeng zhu", me);

  if( !objectp(zhu) )
    return 0;
  return 1;
}

void die ()
{
  object pusa;
  object me = this_object();
  object ob = query_temp("my_killer");

  message_vision("\n$N趴在地上大口的喘着气。\n",me);
  if (!objectp(ob))
  {
    destruct (me);
    return;
  }

  if(ob->query_temp("obstacle/huangfeng_zhu_getted"))
  {
    message_vision ("\n半空中飞出一条八爪金龙，一把抓住$N，提着头，摔在山石崖边。\n",me);
    message_vision ("$N趴在地上，现了本相，却是一个黄毛貂鼠。又被那龙一把抓起，腾空而去。\n",me);
  }

  else
  {
    message_vision("\n你眨一眨眼,$N往沙里一钻，没了。\n",me);
  }

  if (ob == me->query_last_damage_from()
      && (int)ob->query("obstacle/number") == 4)
  {
    pusa = new ("/d/qujing/huangfeng/npc/lingjipusa");
    pusa->move(environment(me));
    pusa->announce_success(ob);
    destruct(pusa);
  }

  me->command("remove bonnet");
  me->command("remove pifeng");
  me->command("unwield fork");
  me->command("drop all");
  destruct (me);
  return;
}

int accept_fight(object ob)
{
  kill_ob(ob);
  return 1;
}

void kill_ob (object ob)
{
  object yaojing;
  object me = this_object();
  set_temp("my_killer",ob);
  call_out ("hurting",random(5)+5,me,ob);
  yaojing = present("yao jing", environment(me));
  if (objectp(yaojing))
    yaojing->kill_ob(ob);
  yaojing = present("yao jing 2", environment(me));
  if (objectp(yaojing))
    yaojing->kill_ob(ob);
  yaojing = present("yao jing 3", environment(me));
  if (objectp(yaojing))
    yaojing->kill_ob(ob);
  ::kill_ob(ob);
}

void hurting (object me, object ob)
{
  string msg ="$N回过头来，将口张了三张，呼的一口气吹将出去,忽然间一阵黄风从空刮起！\n";
  string *strs = ({"( $N大叫一声,被狂风刮到半空中,又重重的跌在山石上！ )\n",
    "( $N大叫一声,被风沙埋了半身！ )\n",
    "( $N狂叫一声，被风沙活埋了！ )\n",
  });

  int damage;
  if (!objectp(me))
    return;
  if (!objectp(ob))
    return;
  if (environment(ob) != environment(me))
    return;

  message_vision (HIG+"\n"+msg+NOR,me);

  if (!test_player(ob))
  {
    message_vision (HIY+element_of(strs)+NOR,ob);
    damage = ob->query("max_kee")/(6+random(3));
    ob->receive_damage("kee",damage,me);
    ob->receive_wound("kee",damage,me);
    ob->receive_damage("sen",damage,me);
    ob->receive_wound("sen",damage,me);
  }

  else
  {
    message_vision (HIW+"只见$N身上的定风珠发出一道金光，风沙立刻平息了。\n"+
                    "$n顿时慌了神，转过身就想溜！\n"+NOR,ob,me);
  }

  remove_call_out ("hurting");
  call_out ("hurting",random(5)+5,me,ob);
  return;
}

