#include <ansi.h>
inherit "/d/qujing/npc/xiaoyao";
string *names = ({
  HIW"雪狼怪"NOR,
  HIW"银狐精"NOR,
  HIW"野豹怪"NOR,
  HIW"狡免精"NOR,
  HIW"黑雕怪"NOR,
  HIW"白鹿怪"NOR,
  HIW"青蛇精"NOR,
});
void create()
{
  ::create();
  set_name(element_of(names), ({"yao jing", "yao", "jing"}));
  set("gender", "男性");
  set("age", 30+random(30));
  set("chat_chance", 5);
  set("chat_msg", ({ (: random_move :) }));
  setup();
}

