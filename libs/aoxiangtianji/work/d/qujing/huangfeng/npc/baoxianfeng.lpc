inherit "/d/qujing/npc/yaojing";
void create()
{
  ::create();
  set_name("豹先锋", ({"bao xianfeng", "bao", "xianfeng"}));
  set("gender", "男性" );
  set("age", 43);
  set("per", 112);//no rongmao description.
  set("str", 50);
  set("long",
"黄风大王部下的前路先锋，是黄风大王最得力的助手。\n"
"精明干练，和虎先锋一同,是黄风大王的左右手之一\n");
  set("class", "yaomo");
  setup();
}

void die()
{
  object me = this_object();
  object where = environment(me);
  object ob = new("/d/qujing/huangfeng/obj/baopi");

  if (objectp(where) && objectp(ob))
  {
    message_vision ("$N惨叫声中翻身倒地，轻烟过处，只留下一张豹皮。\n",me);
    ob->move(where);
  }

  destruct(me);
  return;
}

