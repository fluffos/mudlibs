inherit BIGROOM;
inherit LANDROOM;
inherit TEMPLEROOM;
void create ()
{
  set ("short", "讲经堂");
  set ("long", @LONG
满室锦绣，一屋威严。佛前案上摆满仙果仙花，素品佳肴。
辉煌宝烛，条条金焰射虹霓：馥郁真香，道道玉烟飞彩雾。
那菩萨正领着门人诵读《法华经》。
LONG);
  set("exits", ([
    "south"    : __DIR__"chanyuan",
    "north" : __DIR__"changjing",
  ]));
  set("objects", ([
    __DIR__"npc/lingjipusa": 1,
    sprintf("/obj/npc/dao%d",1+random(3)) : 2,
  ]));
  setup();
}