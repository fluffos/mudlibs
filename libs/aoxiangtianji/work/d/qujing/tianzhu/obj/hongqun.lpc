#include <armor.h>
inherit CLOTH;
string *prefix = ({
  "翡红",
  "翠绿",
  "雪白",
  "水绿",
  "天青",
  "云白",
  "榴红",
  "枣红",
});
string *e_prefix = ({
  "feihong",
  "cuilv",
  "xuebai",
  "shuilv",
  "tianqing",
  "yunbai",
  "liuhong",
  "zaohong",
});
void create()
{
  int i;
  string n, e_n;

  i = random(sizeof(prefix));
  n = prefix[i];
  e_n = e_prefix[i];

  set_name("花裙", ({ "huaqun", "qun", "skirt" }) );
  set_weight(2700);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一条长裙，配着小金穗。\n");
    set("unit", "条");
    set("value", 2000);
    set("material", "cloth");
    set("female_only", 1);
    set("armor_prop/dodge", 5);
    set("drop_des",1);
  }

  init_cloth(10);
  setup();
}

void init()
{
  int i;
  string n, e_n;

  i = random(sizeof(prefix));
  n = prefix[i];
  e_n = e_prefix[i];

  if (query("name")=="花裙")
    set_name(n+"裙", ({ e_n + " qun", "qun", "skirt" }) );
}

