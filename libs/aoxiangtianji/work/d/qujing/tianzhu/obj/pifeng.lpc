#include <ansi.h>
#include <armor.h>
inherit SURCOAT;
string *prefix = ({
  HIM"紫绒"NOR,
  HIR"红绒"NOR,
  HIY"黄绒"NOR,
  HIB"兰绒"NOR,
  HIG"绿绒"NOR,
  HIC"青绒"NOR,
});
string *e_prefix = ({
  "zirong",
  "hongrong",
  "huangrong",
  "lanrong",
  "lvrong",
  "qingrong",
});
void create()
{
  set_name("披风", ({ "pifeng", "surcoat" }) );
  set_weight(1600);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("value", 400);
    set("armor_prop/armor", 2);
  }

  set("drop_des",1);
  setup();
}

void init()
{
  int i;
  string n, e_n;

  i = random(sizeof(prefix));
  n = prefix[i];
  e_n = e_prefix[i];

  if (query("name")=="披风")
    set_name(n+HIW"披风"NOR, ({ e_n + " pifeng", "pifeng" }) );
}

