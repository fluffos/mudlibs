#include <armor.h>
inherit HEAD;
string *p1 = ({
  "黑",
  "青",
  "黄",
  "兰",
  "紫",
});
string *e_p1 = ({
  "hei",
  "qing",
  "huang",
  "lan",
  "zi",
});
string *p2 = ({
  "丝",
  "棉",
  "绒",
  "布"
});
string *e_p2 = ({
  "si",
  "mian",
  "rong",
  "bu",
});
void create()
{
  set_name("帽子", ({"mao", "head","hat" }) );
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "顶");
    set("long","一顶轻便的黑色丝帽。\n");
    set("value", 300);
    set("material", "cloth");
    set("armor_prop/personality", 1);
  }

  set("drop_des",1);
  init_head(5);
  setup();
}

void init()
{
  int i;
  string n,e_n;

  i = random(sizeof(p1));
  n = p1[i];
  e_n = e_p1[i];
  i = random(sizeof(p2));
  n += p2[i];
  e_n += e_p2[i];

  if (query("name")=="帽子")
    set_name(n + "帽", ({ e_n + " mao", "mao" }) );
}

