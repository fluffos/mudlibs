inherit EQUIP;
string *p = ({
  "烫",
  "刻",
  "镂",
  "印",
});

string *e_p = ({
  "tang",
  "ke",
  "lou",
  "yin",
});
void create()
{
  set_name("花竹篮", ({"hua zhulan","zhu lan","zhulan", "lan","basket"}) );
  set_weight(500);
  set_max_encumbrance(8000);
  set_max_items(12);
  if( clonep() )
  {
    set_default_object(__FILE__);
  }

  else
  {
    set("unit", "只");
    set("long", "这是一只漂亮的烫花竹篮。\n");
    set("value", 200);
  }

  set("armor_prop/armor", 1);
  set("armor_type", "basket");
  set("wear_msg", "$N提起烫花竹篮，轻巧地背在身上。\n");
  set("unequip_msg", "$N将烫花竹篮从背后卸下来，抱在怀里。\n");
  set("drop_des",1);
  setup();
}

void init()
{
  int i;
  string n, e_n;

  i = random(sizeof(p));
  n = p[i];
  e_n = e_p[i];

  if (query("name")=="花竹篮")
    set_name(n + "花竹篮", ({ e_n + "hua zhulan","zhu lan","zhulan", "lan","basket"}) );
}

