#include <armor.h>
inherit BOOTS;
void create()
{
  set_name( "鹿皮鞋", ({ "lupi xie", "pixue", "xie" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "双");
    set("long", "一双软身硬底的鹿皮鞋。\n");
    set("value", 140);
    set("material", "leather");
    set("armor_prop/dodge", 3);
  }

  init_boots(5);
  setup();
}