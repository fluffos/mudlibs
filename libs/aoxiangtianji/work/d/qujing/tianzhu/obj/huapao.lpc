#include <armor.h>
inherit CLOTH;
string *prefix = ({
  "大花",
  "碎花",
  "镶花",
  "纹花",
  "印花"
});
string *e_prefix = ({
  "dahua",
  "suihua",
  "xianghua",
  "wenhua",
  "yinhua"
});

void create()
{
  set_name("花袍", ({"huapao", "pao"}));
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("long","一件棉丝袍，宽大舒适。\n");
    set("material", "cloth");
    set("unit", "件");
    set("value", 500);
    set("armor_prop/personality", 1);
  }

  set("drop_des",1);
  init_cloth(5);
  setup();
}

void init()
{
  int i;
  string n, e_n;

  i = random(sizeof(prefix));
  n = prefix[i];
  e_n = e_prefix[i];

  if (query("name")=="花袍")
    set_name(n + "袍", ({e_n + " pao", "pao"}));
}

