#include <armor.h>
inherit SHIELD;
void create()
{
  set_name("厚牛皮盾", ({"houniu pidun", "pidun", "dun"}));
  set_weight(4500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("value", 2000);
    set("material", "leather");
    set("armor_prop/armor", 20);
  }

  init_shield(15);
  setup();
}