inherit COMBINED_ITEM;
void create()
{
  set_name("济神丸", ({"jishen wan", "wan"}));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "颗");
    set("base_value", 600);
    set("unit", "包");
    set("long", "一颗清凉略苦的药丸．\n");
    set("value", 3000);
    set("drug_type", "良药");
    set("only_do_effect", 1);
  }

  set_amount(1);
  setup();
}

int do_effect(object me)
{
//  if (present(this_object(),me))
//    return notify_fail("你身上没有这种药！\n");
  if ((int)this_player()->query("eff_sen") >= (int)this_player()->query("max_sen"))
    return notify_fail("你现在不需要用济神丸。\n");
  else
  {
    this_player()->receive_curing("sen", 40+random(10));
    message_vision("$N咽下一颗济神丸，精神焕发。\n",this_player());
    if (query_amount()>1)
      add_amount(-1);
    else
      destruct(this_object());
  }

  return 1;
}

