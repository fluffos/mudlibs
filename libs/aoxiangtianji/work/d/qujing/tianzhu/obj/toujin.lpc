#include <armor.h>
inherit HEAD;
string *p1 = ({
  "黑",
  "青",
  "黄",
  "兰",
  "紫",
  "红",
});
string *e_p1 = ({
  "hei",
  "qing",
  "huang",
  "lan",
  "zi",
  "hong",
});
string *p2 = ({
  "丝",
  "棉",
  "绒",
  "布"
});
string *e_p2 = ({
  "si",
  "mian",
  "rong",
  "bu",
});
void create()
{
  set_name("头巾", ({"toujin", "tou jin", "jin" }) );
  set_weight(700);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "一块大的布头巾。\n");
    set("value", 80);
    set("material", "cloth");
    set("armor_prop/personality", 1);
  }

  set("drop_des",1);
  init_head(2);
  setup();
}

void init()
{
  int i;
  string n,e_n;

  i = random(sizeof(p1));
  n = p1[i];
  e_n = e_p1[i];
  i = random(sizeof(p2));
  n += p2[i];
  e_n += e_p2[i];

  if (query("name")=="头巾")
    set_name(n + "头巾", ({ e_n + " toujin", "toujin","tou jin","jin" }) );
}

