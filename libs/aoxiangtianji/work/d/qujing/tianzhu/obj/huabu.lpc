#include <armor.h>
inherit ITEM;
string *prefix = ({
  "大花",
  "碎花",
  "镶花",
  "纹花",
  "印花"
});
string *e_prefix = ({
  "dahua",
  "suihua",
  "xianghua",
  "wenhua",
  "yinhua"
});
void create()
{
  set_name("花布", ({"huabu", "hua bu", "huabu", "bu" }) );
  set_weight(700);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "块");
    set("long", "一块大花布。\n");
    set("value", 50);
    set("material", "cloth");
    set("drop_des",1);
  }

  setup();
}

void init()
{
  int i;
  string n, e_n;

  i = random(sizeof(prefix));
  n = prefix[i];
  e_n = e_prefix[i];

  if (query("name")=="花布")
    set_name(n + "布", ({ e_n + " huabu", "hua bu", "huabu", "bu" }) );
}

