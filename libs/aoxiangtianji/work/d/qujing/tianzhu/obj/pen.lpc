#include <weapon.h>
inherit HAMMER;
string *p1 = ({
  "黑",
  "青",
  "黄",
  "兰",
  "紫",
  "红",
  "白",
});
string *e_p1 = ({
  "hei",
  "qing",
  "huang",
  "lan",
  "zi",
  "hong",
  "bai",
});
string *p2 = ({
  "石",
  "玉",
  "瓷",
});
string *e_p2 = ({
  "shi",
  "yu",
  "ci",
});
void create()
{
  set_name("花盆", ({"huapen","hua pen","pen"}) );
  set_weight(600);
  set_max_encumbrance(6000);
  set_max_items(12);
  if( clonep() ){
    set_default_object(__FILE__);
  } else {
    set("unit", "只");
    set("long", "这是一只花盆。\n");
    set("value", 500);
  }

  set("wield_msg", "$N捧起花盆，小心地抱在胸口。\n");
  set("unwield_msg", "$N将花盆轻轻地放下。\n");
  init_hammer(1);
  set("drop_des",1);
  setup();
}

int is_container()
{
  return 1;
}

void init()
{
  int i;
  string n,e_n;

  i = random(sizeof(p1));
  n = p1[i];
  e_n = e_p1[i];
  i = random(sizeof(p2));
  n += p2[i];
  e_n += e_p2[i];

  if (query("name")=="花盆")
    set_name(n+"花盆", ({ e_n+" huapen","hua pen","pen"}) );
}

