inherit ITEM;
inherit F_FOOD;
string *prefix = ({
  "香",
  "脆",
  "炒",
  "西",
  "南",
  "甜",
});
string *e_prefix = ({
  "xiang",
  "cui",
  "cao",
  "xi",
  "nan",
  "tian",
});
void create()
{
  set_name("瓜子", ({"guazi", "gua zi", "zi", "seed"}));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一包喷香的炒瓜子。\n");
    set("eat_msg", "$N抓出一颗瓜子往嘴里一扔，啪地一声脆响。\n");
    set("unit", "包");
    set("value", 120);
    set("food_remaining", 25);
    set("food_supply", 1);
    set("drop_des",1);
  }

  setup();
}

void init()
{
  int i;
  string n, e_n;

  i = random(sizeof(prefix));
  n = prefix[i];
  e_n = e_prefix[i];

  if (query("name")=="瓜子")
    set_name(n+"瓜子", ({e_n + " guazi", "gua zi", "zi", "seed"}));
}

