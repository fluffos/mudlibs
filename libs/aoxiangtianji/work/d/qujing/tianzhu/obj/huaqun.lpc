#include <armor.h>
inherit CLOTH;
string *prefix = ({
  "大花",
  "碎花",
  "镶花",
  "纹花",
  "印花"
});
string *e_prefix = ({
  "dahua",
  "suihua",
  "xianghua",
  "wenhua",
  "yinhua"
});
void create()
{
  set_name("水印花裙", ({ "huaqun", "hua qun", "qun", "skirt" }) );
  set_weight(2700);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一条淡色水印花裙。\n");
    set("unit", "条");
    set("value", 500);
    set("material", "cloth");
    set("female_only", 1);
    set("armor_prop/dodge", 1);
  }

  set("drop_des",1);
  init_cloth(10);
  setup();
}

void init()
{
  int i;
  string n, e_n;

  i = random(sizeof(prefix));
  n = prefix[i];
  e_n = e_prefix[i];

  if (query("name")=="水印花裙")
    set_name("水印" + n + "裙", ({ e_n + " huaqun", "hua qun", "qun", "skirt" }) );
}

