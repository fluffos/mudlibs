inherit F_VENDOR_SALE;
void create()
{
  reload("tianzhu_guo_sanniang");
  set_name("郭三娘", ({"guo sanniang", "guo", "sanniang", "niang"}));
  set("shop_id", ({"sanniang", "niang"}));
  set("gender", "女性");
  set("combat_exp", 5000);
  set("age", 40);
  set("per", 30);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 30);
  set("vendor_goods", ([
     "1": "/d/qujing/tianzhu/obj/toujin",
     "2": "/d/qujing/tianzhu/obj/pitan",
     "3": "/d/qujing/tianzhu/obj/huabu",
     "4": "/d/qujing/tianzhu/obj/baibu",
  ]) );
  setup();
  carry_object("/obj/cloth/pink_cloth")->wear();
}

void init()
{
  ::init();
  add_action("do_vendor_list", "list");
}