inherit NPC;
int test_player ();
void create()
{
  set_name("国王", ({"guo wang", "wang", "king"}));
  set("long", "天竺国国王，身披龙袍，神态庄严。\n");
  set("title", "天竺国");
  set("gender", "男性");
  set("age", 50);
  set("per", 25);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 200000);
  set("daoxing", 100000);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set("max_gin",800);
  set("max_kee",800);
  set("max_sen",800);
  set("max_force",1000);
  set("max_mana",1000);
  set("force_factor",120);
  set("inquiry", ([
    "name" : "朕乃天竺一国之君也，寡人有一公主。",
    "here" : "天竺国也。",
    "天竺" : "天竺国也。",
    "天竺国" : "天竺国也。",
    "公主" : (: test_player :),
    "驸马" : (: test_player :),
    "招亲" : (: test_player :),
    "princess" : (: test_player :),
  ]));
  setup();
  set_temp("no_return",1);
  carry_object("/d/obj/armor/cloth/longpao")->wear();
}

int test_player ()
{
  object me = this_object();
  object who = this_player();
  object ridee = who->query_temp("is_riding");
  if ((int)who->query("level") < 25)
  {
    message_vision ("$N对$n说道：假驸马道行不足，何以混入禁宫？\n",me,who);
    message_vision ("\n$N对左右吩咐了几句。\n",me);
    message_vision ("几位伺卫官极有礼貌地对$N一点头，拥着$N走出大殿。\n",who);
    who->move("/d/qujing/tianzhu/zhaoyang");
    who->move("/d/qujing/tianzhu/wumen");
    if (objectp(ridee))
      ridee->move("/d/qujing/tianzhu/wumen");
    tell_room(environment(who),"伺卫官走进午门。\n");
    return 1;
  }

  if (who->query("obstacle/tianzhu")=="done")
  {
    message_vision ("$N对$n说道：哦，驸马何来？为何不愿西行取经？\n",me,who);
    return 1;
  }

  if (!who->query_temp("obstacle/tianzhu_thrown"))
  {
    message_vision ("$N对$n说道：何许人也居然斗胆混入禁宫？\n",me,who);
    message_vision ("\n$N对左右吩咐了几句。\n",me);
    message_vision ("几位伺位官极有礼貌地对$N一点头，拥着$N走出大殿。\n",who);
    who->move("/d/qujing/tianzhu/zhaoyang");
    who->move("/d/qujing/tianzhu/wumen");
    if (objectp(ridee))
      ridee->move("/d/qujing/tianzhu/wumen");
    tell_room(environment(who),"伺卫官走进午门。\n");
    return 1;
  }

  if (who->query_temp("obstacle/tianzhu_killed"))
  {
    object junji = present ("jun ji",environment(me));
    message_vision ("$N对$n说道：朕真糊涂也，误将妖精当爱女！\n",me,who);
    if (! junji)
    {
      message_vision ("\n$N奇怪道：军机大臣何在？\n",me);
      return 1;
    }

    message_vision ("\n$N对$n吩咐了几句。\n",me,junji);
    remove_call_out ("following");
    call_out ("following",2,me,junji,who);
    return 1;
  }

  message_vision ("$N对$n说道：驸马何不后宫拜见公主？\n",me,who);
  return 1;
}

void following (object me, object junji, object who)
{
  object where,taijian1,taijian2;
  if (!me || !junji || !who)
    return;

  where = environment(me);

  if (environment(junji) != where || environment(who) != where )
    return;

  message_vision ("\n$N点了点头。\n",junji);
  message_vision ("$N对$n说道：可否带陛下去寻公主？\n",junji,who);
  junji->command_function ("follow "+who->query("id"));
  me->command_function ("follow "+who->query("id"));
  me->set("my_saver",who);
  taijian1 = present ("tai jian 1",environment(me));
  taijian2 = present ("tai jian 2",environment(me));
  if (taijian1)
    taijian1->command_function ("follow "+who->query("id"));
  if (taijian2)
    taijian2->command_function ("follow "+who->query("id"));
}

void announce_success (object who)
{
  int dx, qn;
  if (who->query("obstacle/number") != 33 ||
      who->query("obstacle/tianzhu") == "done" ||
      !who->query_temp("obstacle/tianzhu_thrown") ||
      !who->query_temp("obstacle/tianzhu_killed"))
    return;

  dx = random(4200);
  dx += 42000;
  qn = dx/3;

  who->set("obstacle/number",34);
  who->set("obstacle/tianzhu","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  who->delete_temp("obstacle/tianzhu_thrown");
  who->delete_temp("obstacle/tianzhu_killed");
  command("chat "+who->query("name")+"天竺国大战兔妖，救回天竺公主！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed tianzhu on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}

