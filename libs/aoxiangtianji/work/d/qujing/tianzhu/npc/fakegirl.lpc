#include <ansi.h>
inherit NPC;
void create()
{
  set_name("公主", ({"gong zhu", "zhu", "princess"}));
  set("title", "天竺国");
  set("gender", "女性");
  set("age", 20);
  set("attitude", "peaceful");
  set("combat_exp", 2700000);
  set("daoxing", 2700000);
  set("no_ji", 1);

  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 6000);
  set("max_force", 3000);
  set("mana", 6000);
  set("max_mana", 3000);
  set("force_factor", 150);
  set("mana_factor", 150);
  set_skill("force", 250 + random(50));
  set_skill("spells", 250 + random(50));
  set_skill("dodge", 250 + random(50));
  set_skill("parry", 250 + random(50));
  set_skill("unarmed", 250 + random(50));
  set_skill("sword", 250 + random(50));
  set_skill("moonforce", 250 + random(50));
  set_skill("moonshentong", 250 + random(50));
  set_skill("moondance", 250 + random(50));
  set_skill("baihua-zhang", 250 + random(50));
  set_skill("snowsword",250 + random(50));

  map_skill("force", "moonforce");
  map_skill("spells", "moonshentong");
  map_skill("dodge", "moondance");
  map_skill("unarmed", "baihua-zhang");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  set("chat_chance_combat", 10);
  set("chat_msg_combat",
  ({
     (: cast_spell, "arrow" :),
     (: cast_spell, "mihun" :),
  }) );
  setup();
  carry_object("/obj/cloth/gongpao")->wear();
  carry_object("/d/obj/armor/surcoat/jinyipifeng")->wear();
  carry_object("/d/obj/armor/shoes/huazheboots")->wear();
  carry_object("/d/obj/weapon/sword/snow_sword")->wield();
}

int accept_fight (object ob)
{
  kill_ob (ob);
  return 1;
}

void kill_ob (object ob)
{
  set_temp("no_return",1);
  set_temp("my_killer",ob);
  ::kill_ob(ob);
  call_out ("move_to_cave",5+random(10),this_object());
}

void move_to_cave (object me)
{
  object where;
  string location;
  object room;
  int i = 5;
  if (!objectp(me))
    return;

  where = environment(me);
  if (!objectp(where))
    return;

  location = sprintf("/d/qujing/maoying/tuxue%d",1+random(3));
  while (i--)
  {
    room = find_object(location);
    if (!objectp(room))
      room = load_object(location);
    if (objectp(room) && room != where)
      break;
  }

  if (me->is_fighting())
  {
    message_vision ("$N往旁边一跳，一转眼已无踪无影！\n",me);
    me->move(room);
    me->set("no_return",1);
  }

}

void die()
{
  object ob = query_temp("my_killer");
  object me = this_object();
  if (objectp(ob) &&
      ob == me->query_last_damage_from() &&
      ob->query("obstacle/number") == 33 &&
      ob->query("obstacle/tianzhu") != "done" &&
      ob->query_temp("obstacle/tianzhu_thrown"))
  {
    ob->set_temp("obstacle/tianzhu_killed",1);
  }

  message_vision ("\n$N现了原形，竟是一只玉兔。\n",me);
  message_vision ("只听远远地传来太阴星君的怒斥：“玉兔儿！”\n",me);
  message_vision ("\n玉兔闻声乖乖地向外跳去。\n",me);
  me->command("remove boots");
  me->command("remove pifeng");
  me->command("drop boots");
  me->command("drop pifeng");
  destruct(me);
  return;
}

void unconcious()
{
  die();
}

