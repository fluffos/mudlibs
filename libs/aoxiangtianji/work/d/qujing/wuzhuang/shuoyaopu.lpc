inherit BIGROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "芍药圃");
  set ("long", @LONG
圃浅花盛，宛如在地上铺开了一张火红的地毯。几位提着花蓝的
少女在此打闹嬉戏，清风拂过，袖带飘香，你不由得醉醉地吸了
一口气。
LONG);
  set("exits",
  ([
    "southeast" : __DIR__"juyuan",
    "north" : __DIR__"southpool",
  ]));

  set("objects",
  ([
    __DIR__"npc/hexiangu" : 1,
    __DIR__"npc/girl" : 3,
  ]));
  set("outdoors", "wuzhuang");
  setup();
}

