#include <ansi.h>
#include "wzg.h"
inherit NPC;
inherit F_MASTER;
string asked_guo(object me);
string ask_rank();
void create()
{
   set_name("镇元大仙", ({"zhenyuan daxian", "zhenyuan", "daxian"}));
   set("title", "五庄观观主");
   set("gender", "男性" );
   set("age", 65);
   set("per", 24);
   set("str", 30);
   set("long", "交游遍三界，桃李漫五行。好一位地仙之祖！\n");
   set("class", "xian");
   set("combat_exp", 5600000);
   set("daoxing", 5600000);
   set("attitude", "peaceful");
   create_family("五庄观", 1, "祖师");
   set("rank_info/respect", "观主");
   set("max_kee", 8000);
   set("max_sen", 8000);
   set("force", 9000);
   set("max_force", 4500);
   set("mana", 9000);
   set("max_mana", 4500);
   set("force_factor", 200);
   set("mana_factor", 220);
   set("chat_chance_combat", 90);
   set("chat_msg_combat",
   ({
     (: cast_spell, "zhenhuo" :),
     (: perform_action, "whip.jianqi" :),
     (: perform_action, "whip.ruyu" :),
   }) );
   set("inquiry", ([
     "name": "老夫镇元。\n",
     "here": "这里是五庄观，不过住的可不是道士。\n",
     "人参果": (: asked_guo :),
     "职位" : (: ask_rank :),
   ]) );
  set_skill("literate", 300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("whip", 300);
  set_skill("sword", 300);
  set_skill("blade", 300);
  set_skill("staff", 300);

  set_skill("zhenyuan-force", 300);
  set_skill("taiyi", 300);
  set_skill("baguazhen", 300);
  set_skill("wuxing-quan", 300);
  set_skill("sanqing-fuchen", 300);
  set_skill("xiaofeng-sword", 300);
  set_skill("yange-blade", 300);
  set_skill("fumo-staff", 300);
  set_skill("medical",300);
  set_skill("sanqing-yaoli",300);
  map_skill("medical","sanqing-yaoli");

  map_skill("force", "zhenyuan-force");
  map_skill("spells", "taiyi");
  map_skill("dodge", "baguazhen");
  map_skill("unarmed", "wuxing-quan");
  map_skill("whip", "sanqing-fuchen");
  map_skill("parry", "sanqing-fuchen");
  map_skill("sword", "xiaofeng-sword");
  map_skill("blade", "yange-blade");
  map_skill("staff", "fumo-staff");
  create_family("五庄观", 1, "祖师");
  setup();
  carry_object("/obj/cloth/xianpao")->wear();
  carry_object("/d/obj/armor/shoes/yunxie")->wear();
  carry_object("/d/obj/weapon/whip/biyu-fuchen")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "五庄观")
  {
    command("say 我只收五庄观的弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 32)
  {
    command("say 你需要继续磨练啊！\n");
    return 0;
  }

  if ((int)ob->query("obstacle/number") < 34)
  {
    command("say 你尚未取经圆满，我还不能收你！\n");
    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "xian")
    ob->set("class", "xian");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "五庄观")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我五庄观弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "xian")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是地仙中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 32)
  {
    command("say 你需要继续磨练才可以向我学习！\n");
    return 1;
  }

  if (skill == "sanqing-fuchen" ||
      skill == "xiaofeng-sword" ||
      skill == "yange-blade")
  {
    if (!me->query("family/can_learn/" + skill))
    {
      command("say 这门技能需要先演练，才可以学习或者练习！\n");
      return 1;
    }

  }

  return 0;
}

void init()
{
  object ob = this_player();
  if( ob->query("kill_tree") )
  {
    command("say 小杂毛，如果不把我的人参果树救活，别怪老夫不客气了。");
    command("slap "+ob->query("id"));
  }

  add_action("do_back", "back");
}

void announce (object me, string str)
{
  CHANNEL_D->do_channel(me,"chat",str);
}

void start_renshen()
{
  object me;
  me = this_object();

  set_temp("invite","public");
  announce (me, "五庄观人参果品尝大会即将开始！\n");
  announce (me, "诸位仙贤如愿观礼，使accept zhenyuan daxian便可！\n");
  remove_call_out ("inviting");
  call_out ("inviting",1,me);
  call_out("ready1", 180);
  set_temp("ready0", 1);
}

void ready1()
{
  object me;
  me = this_object();
  announce (me, "五庄观人参果品尝大会马上就要开始！\n");
  announce (me, "诸位仙贤如愿观礼，使accept zhenyuan daxian便可！\n");
  call_out("ready2", 180);
  set_temp("ready1", 1);
}

void ready2()
{
  object me;
  me = this_object();
  announce (me, "五庄观人参果品尝大会现在开始！\n");
  announce (me, "诸位仙贤如愿观礼，使accept zhenyuan daxian便可！\n");
  set_temp("ready2", 1);
}

string asked_guo(object me)
{
  int i, total;
  object guo;
  object *inv ;

  me=this_player();
//if no renshenguo party at all...
  if( query_temp("ready0") != 1 )
    return ("人参果可是个好东西。\n");
//if not in the right place, no guo...
//need the right name, also right outdoors(so ppls can not use fake room).
  if( (environment(this_object()))->query("short") != "人参果园" ||
      (environment(this_object()))->query("outdoors") != "wuzhuang" )
  {
    return ("这里又不是果园，哪来的人参果。\n");
  }

//if waiting for ppls...
  if( query_temp("ready1") != 1 )
    return ("不要急，再等等。\n");
//if ready to begin...
  if( query_temp("ready2") != 1 )
    return ("不要急，马上就有。\n");
//if finished...
  if( query_temp("finished"))
    return ("人参果已分发完了。\n");
//now check how many people here...
  total = 0;
  inv = all_inventory( environment(this_object()) );
  for(i=0; i<sizeof(inv); i++)
  {
    if( userp(inv[i]) && (!wizardp(inv[i]))  )
      total++;
  }

  if( total > 3 )
  {
    return ("哎呀！这么多人，现在只有三枚成熟的人参果。\n");
  }

  else if ( total <= 3 && total > 0 )
  {
    for(i=0; i<sizeof(inv); i++)
    {
      if( userp(inv[i]) && (!wizardp(inv[i]))  )
      {//wiz not counted...
        guo = new("/d/obj/drug/renshen-guo");
        guo->move(inv[i]);
        message_vision("$N给$n一枚人参果。\n", this_object(), inv[i]);
        announce (this_object(), "恭喜恭喜！" + inv[i]->query("name") + "获得人参果一枚。\n");
        log_file("renshenguo",sprintf("%s(%s) 获得人参果在 %s\n",
                                     inv[i]->query("name"),
                                     inv[i]->query("id"),
                                     ctime(time())));
      }

    }

    set_temp("finished", 1);
    call_out("finishing", 5);
    return ("好！人参果分发完毕，诸位仙贤尽情享用吧。\n");
  }

  else
    return ("谁要人参果？\n");
}

void finishing()
{
  message_vision("$N哈哈大笑几声，顿时无影无踪了。\n", this_object());
  delete_temp("invite");
  destruct(this_object());
}

void inviting (object me)
{
  int i;
  object *list;
  if (! me->query_temp("invite"))
    return;

  remove_call_out ("inviting");
  call_out ("inviting",4+random(4),me);
  list = filter_array(users(),(:
                       userp($1) && !wizardp($1) && objectp(environment($1))
                       && environment($1)->query("outdoors")
                       && $1->query("age") > 14
                       && !$1->is_fighting()
                       && !$1->is_busy()
                       && !$1->query_temp("no_move")
                            :));

  i = sizeof(list);
  if (i < 1)
    return;

  while  (i--)
  {
    string here, there;
    reset_eval_cost();

    if (environment(list[i])->query("unit"))
      continue;
    if (list[i]->is_ghost())
      continue;
    if (!living(list[i]))
      continue;
    if ((string)list[i]->query_temp("accept")!=me->query("id"))
      continue;
     list[i]->set_temp("accept",0);
     here = (string)environment(me);
     there = (string)environment(list[i]);
     if (here == there)
        continue;
     message_vision("$N的大袖往外一罩…\n",me);
     list[i]->set_temp("accept",0);
     message_vision("一团祥云飘来，云中伸出一只巨大的衣袖将$N轻轻一罩，消失在天空。\n",list[i]);
     list[i]->move(here);
     message_vision("…$N大袖轻轻一抖，$n滑了出来。\n",me,list[i]);
     break;
  }

}

int do_back(string arg)
{
  string *list_p = ({
      "/d/city/skezhan",
      "/d/city/nkezhan",
      "/d/city/ekezhan",
      "/d/city/wkezhan",
      "/d/city/scenter",
      "/d/city/ncenter",
      "/d/city/wcenter",
      "/d/city/ecenter",
  });

  object who = this_player();
  object me = this_object();
  string there;
  if (who->is_busy() || who->is_fighting())
    return 0;
  if (who->query_temp("accept") != me->query("id"))
    return 0;

  message_vision("$N请求$n送$N回返。\n",who,me);

  there = element_of(list_p);
  who->set_temp("accept",0);
  message_vision("$N的大袖朝着$n轻轻一罩…\n",me,who);
  who->move(there);
  message_vision("…云中伸出一只巨大的衣袖轻轻一抖，只见$N从里面滑了出来。\n",who);
  return 1;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我五庄观的弟子！\n";

  if (me->query("class") != "xian" && me->query("class") != "taoist")
    return "嘿嘿，你非仙非道，问我何用？\n";

  switch (topic)
  {
    case "历练" :
    case "历炼" :
    case "锻炼" :
      return QUEST_D->accept_ask(master, me, topic);
      break;

//taiyi
    case "太乙真火" :
    case "zhenhuo" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "cast"   : "zhenhuo",
           "name"   : "太乙真火",
           "sk1"    : "taiyi",
           "lv1"    : 100,
           "max_mana" : 1500,
           "gongxian": 200,]));
      break;
//damo-blade
    case "狂风飞沙" :
    case "kuang" :
      if (me->query("family/can_pfm/kuang"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("damo-blade",1) < 120)
        return "你的大漠刀法修为不够，暂时无法领悟！\n";
      if (me->query_skill("zhenyuan-force",1) < 120)
        return "你的镇元神功修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 1500)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/kuang",1);
      return "你学会了“狂风飞沙”！\n";
      break;
//luori-blade
    case "环环相扣" :
    case "kou" :
      if (me->query("family/can_pfm/kou"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("luori-blade",1) < 100)
        return "你的落日刀法修为不够，暂时无法领悟！\n";
      if (me->query_skill("zhenyuan-force",1) < 100)
        return "你的镇元神功修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 1500)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/kou",1);
      return "你学会了“环环相扣”！\n";
      break;
//yange-blade
    case "大漠落日" :
    case "dmlr" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "pfm"   : "dmlr",
           "name"   : "大漠落日",
           "sk1"    : "yange-blade",
           "lv1"    : 180,
           "sk2"    : "zhenyuan-force",
           "lv1"    : 180,
