      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/fuhu",1);
      return "你学会了“降龙伏虎”！\n";
      break;
  }

  return 0;
}

string ask_rank()
{
  object master = this_object();
  object who = this_player();
  int t = time();

  if (who->is_busy() || who->is_fighting())
    return "你正忙着呢！\n";

  if (t - (int)who->query("last_ask_rank") < 7200)
    return "你不是刚刚问过了吗？\n";

  if (!RANK_D->re_title(master,who))
    return "你无法从我这里获得称号！\n";

  who->set("last_ask_rank",t);
  who->start_busy(1);
  return sprintf("%s 点了点头！\n",master->name());
}

