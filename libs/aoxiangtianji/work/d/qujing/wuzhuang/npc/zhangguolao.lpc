#include <ansi.h>
#include "wzg.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("张果老", ({"zhang guolao", "zhang", "guolao"}));
  set("gender", "男性" );
  set("age", 50);
  set("per", 20);
  set("long", "一位笑嘻嘻的滑稽老头。\n");
  set("class", "xian");
  set("combat_exp", 120000);
  set("daoxing", 500000);
  set("attitude", "peaceful");
  set("chat_chance", 5);
  set("inquiry", ([
    "name" : "呵呵！张果老是也。\n",
    "here" : "今儿个醉了，还真被你问倒了。\n",
  ]) );
  set("chat_msg", ({
    "张果老嘻嘻嘻地笑了几声。\n",
    "张果老拿起酒葫芦又灌了一口，满意地咂了咂嘴。\n",
    "张果老打了个响指：哈哈，我的小毛驴就是听话。\n",
    (: random_move :)
  }) );
  set("maolu", 0);

  set("max_kee", 2500);
  set("max_sen", 2500);
  set("force", 2200);
  set("max_force", 1500);
  set("mana", 2200);
  set("max_mana", 1500);
  set("force_factor", 70);
  set("mana_factor", 70);
  set_skill("literate", 150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("whip", 150);

  set_skill("zhenyuan-force", 150);
  set_skill("taiyi", 150);
  set_skill("baguazhen", 150);
  set_skill("wuxing-quan", 150);
  set_skill("taixuan-whip", 150);

  map_skill("force", "zhenyuan-force");
  map_skill("spells", "taiyi");
  map_skill("dodge", "baguazhen");
  map_skill("unarmed", "wuxing-quan");
  map_skill("whip", "taixuan-whip");
  map_skill("parry", "taixuan-whip");
  create_family("五庄观", 3, "弟子");
  setup();
  carry_object("/obj/cloth/taiji-cloth")->wear();
  carry_object("/d/obj/armor/shoes/yunxie")->wear();
  carry_object("/d/obj/weapon/whip/fuchen")->wield();
}

void init()
{
  if( this_object()->query("maolu") == 0 )
  {
    call_out("qi_maolu", 1);
    set("maolu", 1);
  }

}

void qi_maolu()
{
  object maolu;
  maolu = new(__DIR__"xiaomaolu.lpc");
  maolu->move( environment(this_object()) );
  command("mount maolu");
  return;
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "五庄观")
  {
    command("say 我只收五庄观的弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 15)
  {
    command("say 你需要继续磨练啊！\n");
    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "xian")
    ob->set("class", "xian");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "五庄观")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我五庄观弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "xian")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是地仙中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 15)
  {
    command("say 你需要继续磨练才可以向我学习！\n");
    return 1;
  }

  return 0;
}