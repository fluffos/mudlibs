#include <ansi.h>
#include "wzg.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("铁拐李", ({"tieguai li", "tieguai", "li"}));
  set("gender", "男性" );
  set("age", 42);
  set("per", 12);
  set("long",
"他脚登一双烂草鞋，身着一件早就没了本来面目的脏袍，"
"嘴里哼着走调小曲，一副悠闲神态。\n");
  set("class", "xian");
  set("combat_exp", 800000);
  set("daoxing", 800000);
  set("attitude", "peaceful");
  set("max_kee", 2800);
  set("max_sen", 2800);
  set("force", 2200);
  set("max_force", 1500);
  set("mana", 2200);
  set("max_mana", 1500);
  set("force_factor", 70);
  set("mana_factor", 70);
  set_skill("literate", 150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("staff", 150);

  set_skill("zhenyuan-force", 150);
  set_skill("taiyi", 150);
  set_skill("baguazhen", 150);
  set_skill("wuxing-quan", 150);
  set_skill("fumo-staff", 150);

  map_skill("force", "zhenyuan-force");
  map_skill("spells", "taiyi");
  map_skill("dodge", "baguazhen");
  map_skill("unarmed", "wuxing-quan");
  map_skill("staff", "fumo-staff");
  map_skill("parry", "fumo-staff");
  create_family("五庄观", 3, "弟子");
  setup();
  carry_object("/obj/cloth/taiji-cloth")->wear();
  carry_object("/d/obj/armor/shoes/yunxie")->wear();
  carry_object("/d/obj/weapon/staff/tieguai")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "五庄观")
  {
    command("say 我只收五庄观的弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 15)
  {
    command("say 你需要继续磨练啊！\n");
    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "xian")
    ob->set("class", "xian");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "五庄观")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我五庄观弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "xian")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是地仙中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 15)
  {
    command("say 你需要继续磨练才可以向我学习！\n");
    return 1;
  }

  return 0;
}