#include <ansi.h>
#include "wzg.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("清风", ({"qing feng", "qingfeng"}));
  set("gender", "男性" );
  set("age", 20);
  set("long", "一个看上去和机灵的仙童，在五庄观上下很是吃得开。\n");
  set("class", "xian");
  set("combat_exp", 70000);
  set("daoxing", 700000);
  set("attitude", "peaceful");
  set("title", "仙童");
  set("per", 20);
  set("max_kee", 800);
  set("max_sen", 800);
  set("max_force", 800);
  set("force", 1500);
  set("max_mana", 800);
  set("max_mana", 1500);
  set("force_factor", 40);
  set("mana_factor", 40);

  set_skill("literate", 90);
  set_skill("force", 90);
  set_skill("spells", 90);
  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("parry", 90);
  set_skill("whip", 90);

  set_skill("zhenyuan-force", 90);
  set_skill("taiyi", 90);
  set_skill("baguazhen", 90);
  set_skill("wuxing-quan", 90);
  set_skill("taixuan-whip", 90);

  map_skill("force", "zhenyuan-force");
  map_skill("spells", "taiyi");
  map_skill("dodge", "baguazhen");
  map_skill("unarmed", "wuxing-quan");
  map_skill("whip", "taixuan-whip");
  map_skill("parry", "taixuan-whip");
  create_family("五庄观", 4, "弟子");

  setup();
  carry_object("/obj/cloth/xianpao")->wear();
  carry_object("/d/obj/armor/shoes/yunxie")->wear();
  carry_object("/d/obj/weapon/whip/fuchen")->wield();
}

void init()
{
  object ob=this_player();
  object me=this_object();
  ::init();
  if ( ((int)ob->query("env/invisibility")  == 0)
    && ((string)environment(me)->query("short")=="正殿") )
  {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}

void greeting(object ob)
{
  if( !ob || !playerp(ob) || environment(ob) != environment() )
    return;
  if ( (int)ob->query("level") > 30 )
    command("say 这位" + RANK_D->query_respect(ob) + "失迎了，快请上坐！请到东殿用香茶！\n");
  else if ( (int)ob->query("level") > 25 )
    command("say 这位" + RANK_D->query_respect(ob) + "失迎了，快请坐！请到东殿用茶！\n");
  else if ( (int)ob->query("level") > 20 )
    command("say 这位" + RANK_D->query_respect(ob) + "，请坐！用茶！\n");
  else if ( (int)ob->query("level") > 15 )
    command("hi " + ob->query("id"));
  return;
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (stringp(myfam))
  {
    if (myfam == "五庄观")
    {
      command("say 不敢当，不敢当！\n");
    }

    return 0;
  }

  command("haha");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "xian")
    ob->set("class", "xian");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "五庄观")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我五庄观弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "xian")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是地仙中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  return 0;
}

