#include <ansi.h>
#include "wzg.h"
inherit NPC;
inherit F_MASTER;
string give_book();
string ask_jinguzhou();
void create()
{
  set_name("吕洞宾", ({"lu dongbin", "lu", "dongbin"}));
  set("gender", "男性" );
  set("age", 35);
  set("per", 30);
  set("long", "吕洞宾大概是镇元门下最出名的弟子了，文采风流，色胆包天。\n");
  set("class", "xian");
  set("combat_exp", 800000);
  set("daoxing", 800000);
  set("inquiry", ([
     "name" : "五庄观纯阳子是也。\n",
     "here" : "身在何处？心老普陀。\n",
     "心得" : (: give_book :),
      "纯阳心得" : (: give_book :),
  ]) );
  set("no_book", 0);
  set("max_kee", 2500);
  set("max_sen", 2500);
  set("force", 2200);
  set("max_force", 1500);
  set("mana", 2200);
  set("max_mana", 1500);
  set("force_factor", 70);
  set("mana_factor", 70);
  set_skill("literate", 150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("sword", 150);

  set_skill("zhenyuan-force", 150);
  set_skill("taiyi", 150);
  set_skill("baguazhen", 150);
  set_skill("wuxing-quan", 150);
  set_skill("qixing-sword", 150);

  map_skill("force", "zhenyuan-force");
  map_skill("spells", "taiyi");
  map_skill("dodge", "baguazhen");
  map_skill("unarmed", "wuxing-quan");
  map_skill("sword", "qixing-sword");
  map_skill("parry", "qixing-sword");
  create_family("五庄观", 3, "弟子");
  setup();
  carry_object("/obj/cloth/taiji-cloth")->wear();
  carry_object("/d/obj/armor/shoes/yunxie")->wear();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "五庄观")
  {
    command("say 我只收五庄观的弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 15)
  {
    command("say 你需要继续磨练啊！\n");
    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "xian")
    ob->set("class", "xian");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "五庄观")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我五庄观弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "xian")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s不是地仙中人，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 15)
  {
    command("say 你需要继续磨练才可以向我学习！\n");
    return 1;
  }

  return 0;
}

string give_book()
{
  object book;
  object me = this_player();
  if( query("no_book") == 0 )
  {
    if ((string)me->query("family/family_name") == "五庄观")
    {
      book = new("/d/obj/book/chunyang");
      book->move(me,1);
      book->set("owner",me->query("id"));
      message_vision("$N给了$n一本书！\n",this_object(),me);
      set("no_book", 1);
      return "好！既然是有心人，那我就给你吧。\n";
    }

    else
    {
      command("hmm");
      return "你要这个干什么？\n";
    }

  }

  else
    return "太不巧了，我已经送人了。\n";
}

