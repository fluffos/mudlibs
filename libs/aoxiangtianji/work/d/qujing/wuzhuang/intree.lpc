#include <ansi.h>
inherit SMALLROOM;
inherit WOODROOM;
void kill(object ob);
void appear(object ob);
void create ()
{
   set ("short", "果树上");
   set ("long", @LONG
你终于爬到了果树的顶上，人参果在你的身边摇摆不定，这人参果
三千年一开花，三千年一结果，再三千年才得熟，短头一万年才可
吃，那果子的模样，就和三朝未满的小孩相似，四肢齐全，五官俱
全。
LONG);
  set("exits",
  ([
    "down": __DIR__"shugan3",
  ]));
  setup();
}

void init()
{
  add_action("do_hit","hit");
}

int do_hit()
{
  string msg;
  object ob = this_player();
  object wield,guo;
  object where = this_object();

  if( ob->is_busy() )
    return notify_fail("你现在正忙着呢。\n");
  if( where->query("killed")||
      ob->query("wzg/kill_tree") )
    return notify_fail("这棵树已经枯萎了。\n");
  wield = ob->query_temp("weapon");
  if(!objectp(wield))
    wield = ob->query_temp("handing");
  if (!objectp(wield))
    return notify_fail("你应该找个东西来打人参果。\n");

  if( wield->query("id") != "jinji zi" ||
      (int)ob->query("obstacle/number") != 7 ||
      (string)ob->query("obstacle/wzg") == "done" )
  {
    msg = HIC"只见$N" HIC"举起手中"+wield->query("name") + HIC"，对着人参果敲去，\n"NOR;
    msg += HIC"人参果只是咕碌一声，钻到地下不见了。把$n" HIC"气得直瞪眼！\n"NOR;
    message_vision(msg,ob);
    if (!ob->is_busy())
      ob->start_busy(3);
    return 1;
  }

  else if( ! ob->query_temp("prepared") )
  {
    msg = HIC"只见$N" HIC"举起手中"+wield->query("name") + HIC"，对着人参果敲去，\n"NOR;
    msg += HIC"人参果掉了下来，可惜$n" HIC"没接住，咕碌一声钻到地下不见了。\n把$n" HIC"气得直瞪眼！\n"NOR;
    message_vision(msg,ob);
    if (!ob->is_busy())
      ob->start_busy(3);
    return 1;
  }

  msg = HIC"只见$N" HIC"举起手中"+wield->query("name")+"，对着树上的果子砸去。\n"NOR;
  msg += HIC"一个人参果飘然的落在$N" HIC"的盘子里面。\n"NOR;
  message_vision(msg,ob);
  remove_call_out("appear");
  call_out("appear",2,ob);
  guo=new("/d/obj/drug/renshenguo-fake");
  guo->move(ob);
  ob->start_busy(10);
  return 1;
}

void appear(object ob)
{
  string msg;
  object a,b;
  object where=this_object();
  if (!ob || !where || !environment(ob) || environment(ob) != where)
    return;

  a = new("/d/qujing/wuzhuang/npc/mingyue");
  b = new("/d/qujing/wuzhuang/npc/qingfeng");
  a->move(where);
  b->move(where);
  msg = HIW"忽然清风、明月闯了进来。\n"NOR;
  msg += HIG"清风破口大骂：$N" HIG"，这个混蛋，偷我们五庄观的人参果。\n"NOR;
  msg += HIG"明月破口大骂：$N" HIG"，你比猪还馋吗？\n"NOR;
  msg += HIG"清风破口大骂：$N" HIG"，你这个贼子，一家人都是贼，才生出这样的贼人。\n"NOR;
  msg += HIG"明月破口大骂：$N" HIG"，快把人参果从肚子里给我吐出来。\n"NOR;
  msg += HIG"明月破口大骂：$N" HIG"，我看你是一身的贼骨头。\n"NOR;
  msg += HIG"清风破口大骂：$N" HIG"，你一定不得好死。\n"NOR;
  msg += HIG"明月破口大骂：$N" HIG"，他妈的，别怪老子不客气了。\n"NOR;

  message_vision(msg,ob);
  remove_call_out("kill");
  call_out("kill",2,ob);
  return;
}

void kill(object ob)
{
  string msg;
  object wield=ob->query_temp("weapon");
  object where = this_object();
  object a = find_living("qing feng");
  object b = find_living("ming yue");
  if (!ob || !where || !environment(ob) || environment(ob) != where)
  {
    if (objectp(a))
      destruct(a);
    if (objectp(b))
      destruct(b);
    return;
  }

  msg = HIC"只见$N" HIC"气的满脸通红，真是个怒发冲冠。\n"NOR;
  msg += HIC"$N" HIC"抡起手中的"+wield->query("name")+HIC"对着人参果树狠命的砸了下去。\n"NOR;
  msg += HIC"可怜一棵前年古树就这样慢慢的枯萎了。\n"NOR;

  message_vision(msg,ob);
  message("channel:chat",HIC"【闲聊】明月(Ming yue)：不好了！" + ob->query("name") +
                         HIC"把人参果树砸倒了。\n"NOR,users());
  tell_object(ob,"明月，清风飞也似的逃走了。\n");
  if (objectp(a))
    destruct(a);
  if (objectp(b))
    destruct(b);
  where->set("killed",1);
  remove_call_out("tree_reset");
  call_out("tree_reset",900);
  ob->set("wzg/kill_tree",1);
  return ;
}

void tree_reset()
{
  this_object()->delete("killed");
}	