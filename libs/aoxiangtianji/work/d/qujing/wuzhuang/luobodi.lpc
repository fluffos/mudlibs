inherit BIGROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "萝卜地");
  set ("long", @LONG
五庄观做事的多，吃饭的也不少，所以观内雇了附近的一些农家
来种蔬菜瓜果。这里是萝卜地。
LONG);
  set("exits",
  ([
    "north" : __DIR__"huludi",
    "southeast" : __DIR__"huangguadi",
  ]));

  set("objects",
  ([
    "/d/obj/food/carrot" : 3,
  ]));
  set("outdoors", "wuzhuang");
  setup();
}

