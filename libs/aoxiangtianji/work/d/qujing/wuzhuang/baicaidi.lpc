inherit BIGROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "白菜地");
  set ("long", @LONG
五庄观做事的多，吃饭的也不少，所以观内雇了附近的一些农家
来种蔬菜瓜果。这里是白菜地。
LONG);
  set("exits",
  ([
    "south" : __DIR__"qiezidi",
    "northwest" : __DIR__"xiguadi",
    "north":    __DIR__"tree",
  ]));

  set("objects",
  ([
    "/d/obj/food/xbc" : 2,
  ]));
  set("outdoors", "wuzhuang");
  setup();
}

