inherit SMALLROOM;
inherit WOODROOM;
inherit SAFTYROOM;
void create ()
{
  set ("short", "人参果园");
  set ("long", @LONG
好大的一遍人参果园！巨大的果树上吊着一枚枚令人垂涎欲滴的
人参果。只是不知道怎样才能弄将下来。据说这人参果娇贵无比，
要是乱摘一气什么都吃不上。
LONG);
  set("outdoors","wuzhuang");
  setup();
}

void init()
{
  object me;
  object *env;
  string *list_p = ({
      "/d/city/skezhan",
      "/d/city/nkezhan",
      "/d/city/ekezhan",
      "/d/city/wkezhan",
      "/d/city/scenter",
      "/d/city/ncenter",
      "/d/city/wcenter",
      "/d/city/ecenter",
  });
  me = this_player();
  env = all_inventory(this_object());

  env = filter_array(env,(:
          playerp($1) &&
          !wizardp($1)
        :));

  if( !wizardp(me) && userp(me) )
  {
    if (me->query_temp("accept") == "zhenyuan daxian")
      if (!me->query_temp("used_huangtong_key"))
      {
        tell_object(me,"你怎么来的？出去吧！\n");
        me->move("/d/qujing/wuzhuang/xiguadi");
        return;
      }

  }

  if (sizeof(env) > 3)
  {
    tell_object(me,"人数够了，你等下次的机会吧！\n");
    me->move(element_of(list_p));
    return;
  }

  if( me->query_temp("used_huangtong_key") == 1 )
  {
    remove_call_out("start_guo");
    call_out("start_guo",1,me);
  }

}

void start_guo(object me)
{
  object zhenyuan;

  if (!objectp(me) || environment(me) != this_object())
    return;

  me->delete_temp("used_huangtong_key");
  message_vision("只听几声哈哈大笑，镇元大仙走了出来。\n", me);
  message_vision("镇元大仙说道：居然被你发现了。那我们就开个人参果大会吧！\n\n\n", me);
  if( !objectp(zhenyuan=present("zhenyuan daxian", this_object())) )
  {   //if zhenyuan already here, we do not need creat another one.
    zhenyuan = new(__DIR__"npc/daxian");
    zhenyuan->move(this_object());
  }

  zhenyuan->start_renshen();
}

