#include <room.h>
inherit BIGROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "后院");
  set ("long", @LONG
来到后院，不觉心情为之一松。好一派鸟语花香。院子虽不大，
看得出有一番精心布置。北面一道小门以梨树枝结成，而雪白的
梨花居然依旧盛开。
LONG);
  set("exits",
  ([
    "north" : __DIR__"juyuan",
    "south" : __DIR__"houdian",
  ]));

  create_door("north", "梨花门", "south", DOOR_CLOSED);
  set("outdoors", "wuzhuang");
  setup();
}

