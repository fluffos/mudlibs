#include <armor.h>
inherit SHIELD;
string *names = ({
  "牦牛皮盾",
  "水牛皮盾",
  "野象皮盾",
  "公鹿皮盾",
  "豺皮盾",
});
string *ids = ({
  "maoniu pidun",
  "shuiniu pidun",
  "yexiang pidun",
  "gonglu pidun",
  "chai pidun",
});
void create()
{
  int i = random(sizeof(names));
  set_name(names[i], ({ids[i],"pidun", "shield"}));
  set_weight(4000);
  if ( clonep() )
     set_default_object(__FILE__);
  else
  {
   set("unit", "件");
   set("value", 500);
   set("material", "leather");
   set("armor_prop/dodge", -1);
  }

  init_shield(12);
  set("no_sell",1);
  setup();
}