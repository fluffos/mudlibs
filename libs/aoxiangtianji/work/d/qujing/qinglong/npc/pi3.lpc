inherit NPC;
void create()
{
  set_name("辟尘大王", ({ "pichen dawang", "dawang" }));
  set("title", "玄英洞");
  set("long", "一位妖怪，鼻子上长着一根角。");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "heroism");
  set("str", 30);
  set("spi", 30);
  set("dex", 30);
  set("max_kee", 5500);
  set("max_sen", 5500);
  set("force", 6000);
  set("max_force", 3400);
  set("force_factor", 150);
  set("max_mana", 3400);
  set("mana", 6000);
  set("mana_factor", 150);
  set("combat_exp", 2700000);
  set("daoxing", 2700000);
  set("no_ji", 1);

  set_skill("force", 250 + random(50));
  set_skill("spells", 250 + random(50));
  set_skill("dodge", 250 + random(50));
  set_skill("unarmed", 250 + random(50));
  set_skill("parry", 250+random(50));
  set_skill("stick", 250+random(50));

  set_skill("huntian-qigong",250+random(50));
  set_skill("yaofa",250+random(50));
  set_skill("feiyan-zoubi",250+random(50));
  set_skill("changquan",250+random(50));
  set_skill("dali-stick",250+random(50));

  map_skill("force", "huntian-qigong");
  map_skill("spells", "yaofa");
  map_skill("dodge", "feiyan-zoubi");
  map_skill("unarmed", "changquan");
  map_skill("blade","dali-stick");
  map_skill("parry","dali-stick");
  set("chat_chance_combat", 5);
  set("chat_msg_combat",
  ({
     (: cast_spell, "qunshu" :),
  }) );
  set("env/wimpy", 50);
  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/d/qujing/qinglong/obj/shield")->wear();
  carry_object("/d/qujing/qinglong/obj/stick")->wield();
}

void die ()
{
  object prince;
  object me = this_object();
  object ob = query_temp("my_killer");

  if (objectp(ob) &&
      ob == me->query_last_damage_from() &&
      ob->query("obstacle/number") == 32 &&
      ob->query("obstacle/jinping") != "done" &&
      ob->query_temp("obstacle/jinping_oil_over"))
  {
    ob->set_temp("obstacle/jinping_pi3_killed",1);
    if(ob->query_temp("obstacle/jinping_pi1_killed") &&
       ob->query_temp("obstacle/jinping_pi2_killed"))
    {
      prince = new ("/d/qujing/jinping/npc/fuling");
      prince->move(environment(ob));
      prince->announce_success(ob);
      destruct (prince);
    }

  }

  message_vision ("\n$N扑倒在地，还原为一头犀牛。\n",me);
  message_vision ("\n天空四木禽星一闪，犀牛被一道光捉了去！\n",me);
  destruct(me);
  return;
}

void unconcious ()
{
  die ();
}

int accept_fight(object ob)
{
  kill_ob(ob);
  return 1;
}

void kill_ob (object ob)
{
  command("exert powerup");
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

