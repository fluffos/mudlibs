inherit NPC;
void create()
{
  set_name("牛角大王", ({ "niujiao dawang", "dawang" }));
  set("long", "一位妖怪，鼻子上长着一根角。");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "heroism");
  set("str", 30);
  set("spi", 30);
  set("dex", 30);
  set("max_kee", 5500);
  set("max_sen", 5500);
  set("force", 6000);
  set("max_force", 3000);
  set("force_factor", 150);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 150);
  set("combat_exp", 2500000);
  set("daoxing", 2500000);
  set("no_ji", 1);

  set_skill("force", 220 + random(50));
  set_skill("spells", 220 + random(50));
  set_skill("dodge", 220 + random(50));
  set_skill("unarmed", 220 + random(50));
  set_skill("parry", 220+random(50));
  set_skill("stick", 220+random(50));

  set_skill("huntian-qigong",220+random(50));
  set_skill("yaofa",220+random(50));
  set_skill("dragonstep",220+random(50));
  set_skill("changquan",220+random(50));
  set_skill("dali-stick",220+random(50));

  map_skill("force", "huntian-qigong");
  map_skill("spells", "yaofa");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "changquan");
  map_skill("stick","dali-stick");
  map_skill("parry","dali-stick");

  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/qujing/qinglong/obj/shield")->wear();
  carry_object("/d/obj/weapon/stick/bintiegun")->wear();
}

void die ()
{
  object me = this_object();
  message_vision ("\n$N扑倒在地，还原为一头犀牛。\n",me);
  destruct(me);
}

void unconcious ()
{
  die ();
}