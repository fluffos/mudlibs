inherit BIGROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "山湾");
  set ("long", @LONG
山湾地带有一些缓缓急急的水流，溪水哗哗作响。岸边是松
松的沼泽地，堆着枯枝烂叶。四处见山峦，路在这里显得宽
畅一些，地面较平坦。
LONG);
  set("exits", ([
    "westup"     : __DIR__"shan2",
    "east"       : __DIR__"yelu4",
  ]));
  set("outdoors","/d/qujing/baoxiang");
  setup();
}

int valid_leave (object who, string dir)
{
  if (userp(who) && (int)who->query("level") < 15  && dir == "westup")
  {
    message_vision ("一阵腥风吹来，$N顿时头重脚轻。\n",who);
    call_out ("fall_down",1,who);
    who->start_busy(1);
    return notify_fail("你禁不住踉跄了几下，两腿突然一软。\n");
  }

  return ::valid_leave(who,dir);
}

void fall_down (object who, object where)
{
  if (who && environment(who) == this_object())
    who->unconcious();
}