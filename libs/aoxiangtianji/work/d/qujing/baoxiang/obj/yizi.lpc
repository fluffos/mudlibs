inherit ITEM;
string *prefix = ({
  "镂",
  "镶",
  "刻",
  "雕",
});
string *e_prefix = ({
  "lou ",
  "xiang ",
  "ke ",
  "diao ",
});
string *prefix1 = ({
  "柳木",
  "柚木",
  "松木",
  "杉木",
  "杨木",
});

string *e_prefix1 = ({
  "liumu ",
  "youmu ",
  "songmu ",
  "shanmu ",
  "yangmu ",
});
string *prefix2 = ({
  "斜靠",
  "靠",
  "斜躺",
  "躺",
  "背靠",
  "背躺",
});
string *e_prefix2 = ({
  "xiekao ",
  "kao ",
  "xietang ",
  "tang ",
  "beikao ",
  "beitang ",
});

void create()
{
  int i;
  string name,e_name;

  i = random(sizeof(prefix));
  name = prefix[i];
  e_name = e_prefix[i];
  i = random(sizeof(prefix1));
  name += prefix1[i];
  e_name += e_prefix1[i];
  i = random(sizeof(prefix2));
  name += prefix2[i];
  e_name += e_prefix2[i];

  set_name(name + "椅", ({e_name + "yizi", "seat"}));
  set_weight(7000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一把雕木斜靠椅。\n");
    set("material", "wood");
    set("unit", "把");
    set("value", 900);
  }

  setup();
}