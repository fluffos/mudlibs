inherit ITEM;
string *prefix = ({
  "镂空",
  "镂花",
  "镶花",
  "刻花",
  "雕花",
});
string *e_prefix = ({
  "loukong ",
  "louhua ",
  "xianghua ",
  "kehua ",
  "diaohua ",
});
string *prefix1 = ({
  "柳木",
  "柚木",
  "松木",
  "杉木",
  "杨木",
});

string *e_prefix1 = ({
  "liumu ",
  "youmu ",
  "songmu ",
  "shanmu ",
  "yangmu ",
});
void create()
{
  int i;
  string name,e_name;

  i = random(sizeof(prefix));
  name = prefix[i];
  e_name = e_prefix[i];
  i = random(sizeof(prefix1));
  name += prefix1[i];
  e_name += e_prefix1[i];

  set_name(name + "桌", ({e_name + "zhuozi", "table"}));
  set_weight(9000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一张木桌。\n");
    set("material", "wood");
    set("unit", "张");
    set("value", 1200);
  }

  setup();
}