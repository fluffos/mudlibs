inherit F_VENDOR_SALE;
string *str = ({
  "/d/qujing/baoxiang/obj/cspitan",
  "/d/qujing/baoxiang/obj/bpitan",
  "/d/qujing/baoxiang/obj/guatan",
});

void create()
{
  reload("baoxiang_fang_zhu");
  set_name("坊主", ({"fang zhu","zhu"}));
  set("gender", "男性");
  set("combat_exp", 1000);
  set("age", 46);
  set("per", 14);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 100);
  set("force_clear",1);
  set("vendor_goods", ([
    "1": element_of(str),
    "2": "/d/qujing/baoxiang/obj/yizi",
    "3": "/d/qujing/baoxiang/obj/zhuozi",
  ]) );
  setup();
  carry_object("/d/qujing/baoxiang/obj/changpao")->wear();
  add_money("silver", 1);
}

void init()
{
  ::init();
  add_action("do_vendor_list", "list");
}

