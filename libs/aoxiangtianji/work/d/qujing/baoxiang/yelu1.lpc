inherit SMALLROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "野路");
  set ("long", @LONG
野路道路细长崎岖，起伏不停。四周远远都是大小山峦，
低洼处是一片湿湿的沼泽地带，看不见人间烟火。走在山路
上静悄悄，雾气浓郁，不由得让人小心加快步伐。
LONG);
  set("exits", ([
    "southeast"  : __DIR__"yelu2",
    "southwest"  : "/d/qujing/pingding/shan11",
  ]));
  set("outdoors",__DIR__"");
  setup();
}