#include <armor.h>
inherit ARMOR;
string *prefixs = ({
  "人",
  "虎",
  "狮",
  "豹",
  "熊",
  "狼",
});
string *names = ({
  "骨甲",
  "皮甲",
});
void create()
{
  set_name(element_of(prefixs)+element_of(names),
           ({"armor","jia"}));
  set_weight(5000+random(2000));
  if ( clonep() )
     set_default_object(__FILE__);
  else {
   set("unit", "件");
   set("value", 500);
   set("material", "leather");
  }

  init_armor(30);
  set("no_sell",1);
  setup();
}