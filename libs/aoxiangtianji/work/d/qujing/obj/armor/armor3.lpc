#include <armor.h>
inherit ARMOR;
string *prefixs = ({
  "白",
  "灰",
  "青",
  "锈",
  "乌",
  "黑",
});
string *names = ({
  "铁甲",
  "铜甲",
});
void create()
{
  set_name(element_of(prefixs)+element_of(names),
           ({"armor","jia"}));
  set_weight(12000);
  if ( clonep() )
     set_default_object(__FILE__);
  else {
   set("unit", "件");
   set("value", 200);
   set("material", "iron");
   set("armor_prop/dodge", -5);
  }

  init_armor(20);
  setup();
}

