#include <weapon.h>
inherit SPEAR;
string *prefix = ({
  "长",
  "短",
  "红",
  "黄",
  "青",
});
string *prefix_id = ({
  "chang",
  "duan",
  "hong",
  "huang",
  "qing",
});

void create()
{
  int i = random(sizeof(prefix));

  set_name(prefix[i] + "缨枪", ({ prefix_id[i] + "ying qiang", "qiang", "spear" }) );
  set("unit", "根");
  set_weight(1000);
  if( clonep() )
     set_default_object(__FILE__);
  else
  {
    set("value", 200);
    set("material", "iron");
  }

  init_spear(35);
  setup();
}

