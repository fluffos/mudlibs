#include <weapon.h>
inherit DAGGER;
void create()
{
  set_name("单刃匕", ({ "danren bi", "bi", "dagger" }) );
  set("unit", "把");
  set_weight(600);
  if( clonep() )
     set_default_object(__FILE__);
  else
  {
    set("value", 120);
    set("material", "iron");
    set("wield_msg","$N操起$n握在手里。\n");
  }

  init_dagger(15);
  setup();
}

