#include <weapon.h>
inherit AXE;
void create()
{
  set_name("鹰嘴斧", ({ "yingzui fu", "fu", "axe" }) );
  set("unit", "柄");
  set_weight(1100);
  if( clonep() )
     set_default_object(__FILE__);
  else
  {
    set("value", 130);
    set("material", "iron");
    set("wield_msg","$N操起$n握在手里。\n");
  }

  init_axe(30);
  setup();
}

