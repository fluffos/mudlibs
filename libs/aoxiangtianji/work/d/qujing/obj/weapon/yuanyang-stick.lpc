#include <weapon.h>
inherit STICK;
void create()
{
  set_name("鸳鸯棍", ({ "yuanyang gun", "gun", "stick" }) );
  set("unit", "根");
  set_weight(700);
  if( clonep() )
     set_default_object(__FILE__);
  else {
    set("value", 410);
    set("material", "iron");
    set("wield_msg","$N操起$n握在手里。\n");
  }

  init_stick(30);
  setup();
}

