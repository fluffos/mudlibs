#include <weapon.h>
inherit WHIP;
void create()
{
  set_name("百节链", ({ "baijie lian", "lian", "whip" }) );
  set_weight(900);
  set("unit", "根");
  if( clonep() )
     set_default_object(__FILE__);
  else
  {
    set("value", 140);
    set("material", "iron");
    set("wield_msg","$N操起$n握在手里。\n");
  }

  init_whip(30);
  setup();
}

