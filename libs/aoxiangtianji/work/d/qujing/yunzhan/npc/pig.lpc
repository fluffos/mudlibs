#include <ansi.h>
inherit NPC;
void create()
{
  set_name("猪怪", ({ "zhu guai","pig" }));
  set("age", 600);
  set("gender", "男性");
  set("long", "一个野猪怪。\n");
  set("attitude", "peaceful");
  set("str", 50);
  set("spi", 30);
  set("con", 30);
  set("dex", 30);
  set("per", 10);
  set("no_ji",1);
  set("combat_exp",2200000);
  set("daoxing",2200000);
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("max_force", 3000);
  set("force", 5000);
  set("force_factor", 120);
  set("max_mana", 3000);
  set("mana", 5000);
  set("mana_factor", 150);

  set_skill("force", 220);
  set_skill("spells", 220);
  set_skill("dodge", 220);
  set_skill("unarmed", 220);
  set_skill("parry", 220);
  set_skill("rake", 220);
  set_skill("lengquan-force",220);
  set_skill("baguazhou", 220);
  set_skill("yanxing-steps", 220);
  set_skill("changquan", 220);
  set_skill("skyriver-rake", 220);

  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed", "changquan");
  map_skill("rake", "skyriver-rake");
  map_skill("parry", "skyriver-rake");

  setup();
  carry_object("/d/obj/weapon/rake/jiuchipa")->wield();
  carry_object("/d/obj/armor/armor/tongjia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
}

void init()
{
  object ob = this_player();
  if ( ob->query_temp("apply/name")&&
       ob->query_temp("apply/name")[0] == "翠兰" )
  {
    command("hug cui lan");
    command("kiss cui lan");
    return;
  }

  return ;
}

int accept_fight (object ob)
{
  command("exert powerup");
  kill_ob (ob);
  return 1;
}

void kill_ob (object ob)
{
  set_temp("no_return",1);
  set_temp("my_killer",ob);
  ::kill_ob(ob);
  if (ob->query_temp("see_pig"))
  {
    call_out ("move_to_cave",1,this_object());
    ob->delete_temp("see_pig");
  }

  return;
}

void move_to_cave (object me)
{
  object where = environment(me);
  if (! where ||
    where->query("short") == HIG"树林"NOR)
    return;
  message_vision ("\n$N化作一道金光消失了！\n",me);
  me->move("/d/qujing/yunzhan/shulin7");
  return;
}

void die()
{
  object me;
  object ob;
  me = this_object();
  ob = me->query_temp("my_killer");
  if (objectp(ob) &&
      ob == me->query_last_damage_from() &&
      (int)ob->query("obstacle/number") == 3)
  {
    message_vision(HIR"只见$N变成道道金光直冲云霄。\n"NOR,me);
    message_vision(HIR"原来$N是个天官下凡，投错了胎。\n"NOR,me);
    ob->set_temp("pig_killed",1);
    destruct(me) ;
    return;
  }

  return ::die();
}