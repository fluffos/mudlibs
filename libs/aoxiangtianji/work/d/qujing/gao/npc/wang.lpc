inherit NPC;
inherit F_VENDOR;
void create()
{
  set_name("王掌柜", ({"wang zhanggui", "wang"}));
  set("long", "小酒馆的老板，吃的胖胖的．\n");
  set("gender", "男性");
  set("title", "酒馆老板");
  set("combat_exp", 3000);
  set("age", 46);
  set("attitude", "friendly");
  set_skill("unarmed", 10);
  set("vendor_goods", ([
    "1": "/d/obj/food/huadiao-jiudai",
    "2": "/d/obj/food/gourou",
    "3": "/d/obj/food/jitui",
    "4": "/d/obj/food/huasheng",
  ]) );
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}

void init()
{
  object ob;
  ::init();
  if( interactive(ob = this_player()) && !is_fighting() )
  {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

  add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
  if( !ob || environment(ob) != environment() )
    return;
  say(sprintf("王掌柜笑咪咪地说道：这位 %s ，进来喝两盅吧。\n",RANK_D->query_respect(ob)));
}

