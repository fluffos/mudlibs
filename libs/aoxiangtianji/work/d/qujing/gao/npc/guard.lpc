inherit NPC;
void create()
{
  set_name("土匪头目", ({"bandit leader", "bandit", "leader"}));
  set("long","清风寨的小头目．\n");
  set("gender", "男性");
  set("age", 28);
  set("attitude", "aggressive");
  set("per", 25);
  set("force", 300);
  set("max_force", 300);
  set("force_factor", 15);
  set("shen_type", 1);
  set("combat_exp", 50000+random(3000));

  set_skill("blade", 60);
  set_skill("parry", 60);
  set_skill("dodge", 60);
  set_skill("wuhu-blade", 60);
  set_skill("feiyan-zoubi", 60);
  map_skill("dodge", "feiyan-zoubi");
  map_skill("blade", "wuhu-blade");
  map_skill("parry", "wuhu-blade");
  set("chat_chance", 2);
  set("chat_msg", ({
    "小头目大喊：太岁头上动土，不想活了！\n",
  }) );
  setup();
  carry_object("/d/obj/weapon/blade/gangdao")->wield();
  carry_object("/d/qujing/gao/obj/piyi")->wear();
}