inherit NPC;
void create()
{
  set_name("土匪", ({"bandit"}));
  set("long","一个体型魁悟，看起来孔武有力的大个子．\n正狠巴巴的瞪着你．\n");
  set("gender", "男性");
  set("age", 25+random(15));
  set("attitude", "aggressive");
  set("combat_exp", 10000+random(5000));
  set_skill("blade", 25+random(15));
  set_skill("parry", 25+random(15));
  set_skill("dodge", 25+random(15));
  set_skill("wuhu-blade", 50);
  set_skill("feiyan-zoubi", 50);
  set("force", 800);
  set("max_force", 400);
  set("mana", 800);
  set("max_mana", 400);

  map_skill("dodge", "feiyan-zoubi");
  map_skill("blade", "wuhu-blade");
  map_skill("parry", "wuhu-blade");
  setup();
  add_money("coin", 50);
  carry_object("/d/obj/weapon/blade/gangdao")->wield();
}

void init()
{
  object ob;
  ::init();
  if( interactive(ob = this_player()) && !is_fighting() )
  {
    set_leader(ob);
  }

}