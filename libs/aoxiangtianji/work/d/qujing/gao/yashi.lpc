#include <ansi.h>
#include <room.h>
inherit SMALLROOM;
inherit LANDROOM;
void create()
{
  set ("short", "雅室");
  set ("long", @LONG
高小姐的卧房便是这里．卧房吗．．当然是休息的地方了．．
靠内有一张素净的床铺(bed)，但空荡荡地不见一个人影．．．
LONG);
  set("item_desc",(["bed":"睡觉用的床铺(gosleep,gobed,bed)。 \n", ]));
  set("exits", ([ /* sizeof() == 4 */
    "down" : __DIR__"guige",
  ]));

  create_door("down", "雕花竹门", "up", DOOR_CLOSED);
  set("no_clean_up", 0);
  setup();
}

void init()
{
  add_action("do_bed", "gosleep");
  add_action("do_bed", "gobed" );
  add_action("do_bed", "bed");
}

int do_bed()
{
  object me, ridee;
  me=this_player();

  ridee = me->query_temp("is_riding");
  if (objectp(ridee))
    return notify_fail("你还是先下了坐骑在上床吧！\n");

  message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
  me->move(__DIR__"bed_yashi");
  message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
  return 1;
}