inherit F_VENDOR_SALE;
void messaging ();
void create()
{
  reload("zhuzi_pang_dianzhu");
  set_name("胖店主", ({"pang dianzhu", "dianzhu"}));
  set("shop_id", ({"dianzhu"}));
  set("gender", "男性");
  set("combat_exp", 5000);
  set("age", 40);
  set("per", 34);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 50);
  set("vendor_goods", ([
    "1": "/d/obj/misc/kuang",
    "2": "/d/obj/weapon/fork/fork",
    "3": "/d/obj/misc/hualan",
  ]) );
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}

void init()
{
  ::init();
  if (playerp(this_player()) && !is_fighting())
    if (random(3)==1)
      messaging();
  add_action("do_vendor_list", "list");
}

void messaging ()
{
  if (random(2))
    command("hug shou dianniang");
  else
    command("sleepy shou dianniang");
}

