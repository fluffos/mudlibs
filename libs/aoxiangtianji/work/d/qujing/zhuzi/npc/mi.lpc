inherit F_VENDOR_SALE;
void create()
{
  reload("zhuzi_mi_laoban");
  set_name("米老板", ({"mi laoban", "mi", "laoban"}));
  set("shop_id", ({"laoban"}));
  set("gender", "男性");
  set("combat_exp", 5000);
  set("age", 50);
  set("per", 34);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 50);
  set("vendor_goods", ([
    "1": "/d/obj/food/salt",
    "2": "/d/obj/food/youhulu",
    "3": "/d/obj/food/niangao",
    "4": "/d/obj/food/rice",
    "5": "/d/obj/food/mijiu",
    "6": "/d/obj/food/zongzi",
  ]) );
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}

void init()
{
  ::init();
  add_action("do_vendor_list", "list");
  if (playerp(this_player()))
  {
    if (random(2))
      command("wink2");
    else
      command("wink2 "+this_player()->query("id"));
  }

}