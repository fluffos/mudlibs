inherit NPC;
void messaging ();
void create()
{
  set_name("瘦店娘", ({"shou dianniang", "dianniang"}));
  set("gender", "女性");
  set("combat_exp", 5000);
  set("age", 30);
  set("per", 34);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 50);
  setup();
  carry_object("/obj/cloth/nichang")->wear();
}

void init ()
{
  if (playerp(this_player()) && !is_fighting())
    messaging();
}

void messaging ()
{
  if (random(2))
    command("sneer dianzhu");
  else
    command("slap dianzhu");
}