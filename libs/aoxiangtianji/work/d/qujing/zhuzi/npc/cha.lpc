inherit F_VENDOR_SALE;
void smiling (object who);
void create()
{
  reload("zhuzi_chahua_niangzi");
  set_name("茶花娘子", ({"chahua niangzi", "chahua", "niangzi"}));
  set("shop_id", ({"niangzi"}));
  set("gender", "女性");
  set("combat_exp", 5000);
  set("age", 30);
  set("per", 34);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 50);
  set("vendor_goods", ([
    "1": "/d/obj/food/chahu",
    "2": "/d/qujing/zhuzi/obj/chagan",
    "3": "/d/qujing/zhuzi/obj/guazi",
    "4": "/d/qujing/zhuzi/obj/huasheng",
  ]) );
  setup();
  carry_object("/obj/cloth/pinkskirt")->wear();
}

void init()
{
  ::init();
  if (!playerp(this_player()))
    return;
  add_action("do_vendor_list", "list");
  if (random(4)==1)
    smiling(this_object());
}

void smiling (object who)
{
  if (random(2))
    command("smile");
  else
    command("smile "+who->query("id"));
}

