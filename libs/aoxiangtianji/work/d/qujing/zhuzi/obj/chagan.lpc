#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
string *p = ({
  HIM"五香茶干"NOR,
  HIM"卤味茶干"NOR,
  HIM"红油茶干"NOR,
  HIM"干炒茶干"NOR,
});

void create()
{
  set_name("茶干", ({"cha gan", "gan"}));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一碟特色茶干。\n");
    set("unit", "碟");
    set("value", 120);
    set("food_remaining", 6);
    set("food_supply", 25);
    set("drop_des",1);
  }

  setup();
}

void init()
{
  if (query("name")=="茶干")
    set_name(element_of(p), ({"cha gan", "gan"}));
}

