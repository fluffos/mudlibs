inherit ITEM;
inherit F_FOOD;
string *p = ({
  "菜肉",
  "鲜肉",
  "咸肉",
  "羊肉",
  "牛肉",
  "素菜",
  "白菜",
  "三鲜",
  "山东",
  "东北",
  "陕西",
  "蓬莱",
});
void create()
{
  set_name("水饺", ({"shui jiao", "jiao", "dumpling"}));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一碗热气腾腾的水饺。\n");
    set("unit", "碗");
    set("value", 200);
    set("food_remaining", 5);
    set("food_supply", 35);
    set("drop_des",1);
  }

}

void init()
{
  if (query("name")=="水饺")
    set_name(element_of(p) + "水饺", ({"shui jiao", "jiao", "dumpling"}));
}

