inherit "/d/qujing/chechi/npc/huli";
void create()
{
  ::create();
  set_name("鹿力大仙", ({"luli daxian", "luli", "daxian" }));
}

void die()
{
  object me = this_object();
  object where = environment(me);
  object ob = new ("/d/qujing/chechi/obj/lutou");
  message_vision ("$N软软地倒下，留下一只白色鹿头。\n",me);
  ob->move(where);
  destruct(me);
}