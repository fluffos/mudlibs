#include <ansi.h>
inherit NPC;
void create()
{
  set_name("监斩官", ({"jianzhan guan", "guan"}));
  set("gender", "男性");
  set("combat_exp", 200000);
  set("daoxing", 100000);
  set("age", 30);
  set("per", 25);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("force_factor",100);
  set("max_gin",1000);
  set("max_kee",1000);
  set("max_sen",1000);
  set("max_force",1200);
  set("max_mana",1200);
  set_skill("unarmed", 90);
  set_skill("dodge", 90);
  set_skill("parry", 90);
  set_skill("force", 90);
  set_skill("spells", 90);
  setup();
  carry_object("/obj/cloth/gongpao")->wear();
  carry_object("/d/qujing/chechi/obj/dao")->wield();
}

// 0: invalid place; 1: invalid condition; 2: valid
int check_valid_player (object who)
{
  object me = this_object();
  object where = environment (me);
  object yangli;
  object huli;
  object luli;
  object king;
  object guizi;
  if (! who || !where || where->query("short") != "坛场")
    return 0;

  yangli = present("yangli daxian",where);
  huli = present("huli daxian",where);
  luli = present("luli daxian",where);
  king = present("guo wang",where);
  guizi = present("zhuhong guizi",where);
  if (!objectp(yangli) || !objectp(huli) || !objectp(luli) || !objectp(king)
     || userp(yangli) || userp(huli) || userp(luli) || userp(king)
     || !objectp(guizi) || userp(guizi))
    return 1;
  if (who->query_temp("obstacle/chechi0") != "eaten")
    return 1;
  if (who->query_temp("obstacle/chechi1") != "seen_king")
    return 1;
  if (who->query_temp("obstacle/chechi2") != "chantai")
    return 1;
  return 2;
}

void init ()
{
  call_out("greet_player",1,this_player());
  add_action ("do_guess","guess");
}

void greet_player (object who)
{
  object me = this_object();
  if (!objectp(who) || environment(who) != environment(me))
    return;
  if (check_valid_player(who) == 2 &&
      ! who->query_temp("obstacle/chechi_greeted2"))
  {
    who->set_temp("obstacle/chechi_greeted2",1);
    tell_room (environment(me),HIC"几位内官抬着一些东西走来，将朱红柜子布置一番。\n"NOR,me);
    tell_room (environment(me),HIC"内官向北离去。\n\n"NOR,me);
    me->command_function("hi "+who->query("id"));
    message_vision (HIC"$N" HIC"对$n" HIC"说道：“隔板猜枚，请道出朱红柜子里为何物。”\n"NOR, me,who);
  }

}

void display_guess (object me, object who, object guizi,
                    string arg, object luli)
{
  if (!objectp(me) || !objectp(who))
    return;
  message_vision (HIC"$N指着柜子说，这里面是" + arg + "吧。\n"NOR,who);
}

void failing_guess (object me,object who, object where,
                    object guizi, string arg, object luli)
{
  display_guess (me,who,guizi,arg,luli);
  who->start_budy(4,5);
  call_out ("failing",5,me,who,where,guizi,arg,luli);
}

void failing (object me, object who, object where,
              object guizi, string arg, object luli)
{
  string str;
  if (! me || !who)
    return;
  if (arg == "宫衣")
  {
    if (random(2))
      str = "桃子";
    else
      str = "道童";
  }

  else if (arg == "桃子")
  {
    if (random(2))
      str = "宫衣";
    else
      str = "道童";
  }

  else if (arg == "道童")
  {
    if (random(2))
      str = "桃子";
    else
      str = "仙衣";
  }

  else
  {
    switch (random(3))
    {
      case 0:
      {
        str = "宫衣";
        break;
      }

      case 1:
      {
        str = "桃子";
        break;
      }

      case 2:
      {
        str = "道童";
        break;
      }

    }

  }

  who->start_budy(3,4);
  call_out ("put_player_in",3,me,who,guizi);
  call_out ("get_player_out",120,me,who,guizi);
  if (luli)
  {
    message_vision (HIG"只见$N" HIG"苦思冥想，说道：“是"+str+"”。\n\n"NOR,luli);
    message_vision (HIC"话音未落，$N" HIC"打开朱红柜子，却果然是"+str+"。\n\n"NOR,me);
  }

  else
    message_vision (HIM"$N" HIM"哼地一声打开朱红柜子，里面是"+str+"。\n\n"NOR,me);
}

void put_player_in (object me, object who, object guizi)
{
  message_vision (HIR"$N" HIR"对$n" HIR"一声冷笑，喊道：“来人！”\n"NOR,me,who);
  message_vision (HIR"从宫里早已走出两个内官，将$N" HIR"左右夹起往柜子里一扔。\n"NOR,who);
  me->set_temp("obstacle/chechi3","player_in");
  who->move(guizi);
}

void get_player_out (object me, object who, object guizi)
{
  me->set_temp("obstacle/chechi3",0);
  me->delete_temp("obstacle/chechi");
  who->move(environment(guizi));
  message_vision (HIC"宫里走出两个内官，将$N" HIC"从柜子里软绵绵地拖了出来。\n\n"NOR,who);
  message_vision (HIC"内官重新将朱红柜子布置一番，向北离开。\n$N" HIC"对$n"
                  HIC"说道：“恕你一回，速猜！”\n"NOR,me,who);
}

void success_guess (object me,object who, object where,
                    object guizi, string arg, object luli)
{
  display_guess (me,who,guizi,arg,luli);
  who->start_budy(2,3);
  call_out ("success",2,me,who,where,arg,luli);
}

void success (object me,object who, object where, string arg, object luli)
{
  if (!me || !who)
    return;
  message_vision (HIC"$N" HIC"说道：“开柜！”\n\n朱红柜子打开，果然是" + arg
                + "！\n\n"NOR,me);
  who->set_temp("obstacle/chechi3","guizi");
  me->delete_temp("obstacle/chechi");
  message_vision ("$N面露喜色，连声向$n拜道：“请！”\n",me,who);
}

int do_guess (string arg)
{
  object who = this_player();
  object me = this_object();
  object where = environment (me);
  object guizi;
  object luli;
  object ridee;
  int status;
  if (! arg || !who || !where)
    return 0;
  ridee = who->query_temp("is_riding");
  if (objectp(ridee))
    return notify_fail("你还是先下了坐骑吧！\n");

  guizi = present("zhuhong guizi",where);
  if (guizi->query("id") != "zhuhong guizi")
    return 0;
  status = check_valid_player(who);
  if (status == 0)
    return 0;
  luli = present("luli daxian",where);
  if (luli && luli->query("id") != "luli daxian")
    luli = 0;
  if (me->query_temp("obstacle/chechi")=="busy")
  {
    message_vision (HIC"$N" HIC"冒冒失失地喊了一声，这里面是"+arg+"！\n"NOR,who);
    message_vision (HIC"$N" HIC"叫道：“住口，这不正猜着吗？”\n"NOR,me);
    return 1;
  }

  if (me->query_temp("obstacle/chechi")=="player_in")
  {
    message_vision (HIC"$N" HIC"癫癫地喊了一声，这里面是"+arg+"！\n"NOR,who);
    message_vision (HIC"$N" HIC"说道：“住口，这里面不还关着人吗？”\n"NOR,me);
    return 1;
  }

  me->set_temp("obstacle/chechi","busy");
  if (status == 1 || ! luli)
  {
    failing_guess(me,who,where,guizi,arg,luli);
  }

  else if (who->query_temp("obstacle/chechi_guizi_times") == 0)
  {
    who->set_temp("obstacle/chechi_guizi_times",1);
    failing_guess(me,who,where,guizi,arg,luli);
  }

  else if (random(3))
    failing_guess(me,who,where,guizi,arg,luli);
  else if (arg != "宫衣" && arg != "桃子" && arg != "道童")
    failing_guess(me,who,where,guizi,arg,luli);
  else
    success_guess(me,who,where,guizi,arg,luli);
  return 1;
}

