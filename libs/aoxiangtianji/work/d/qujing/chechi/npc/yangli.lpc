inherit "/d/qujing/chechi/npc/huli";
void create()
{
  ::create();
  set_name("羊力大仙", ({"yangli daxian", "yangli", "daxian" }));
}

void die()
{
  object me = this_object();
  object where = environment(me);
  object ob = new ("/d/qujing/chechi/obj/yangjiao");
  message_vision ("$N软软地倒下，留下一根灰色羊角。\n",me);
  ob->move(where);
  destruct(me);
}