#include <ansi.h>
inherit ITEM;
int do_look (string arg);
void create()
{
  set_name("朱红柜子", ({"zhuhong guizi", "guizi"}));
  set_weight(6000000);
  set_max_encumbrance(100000000000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "箱");
    set("long", "一箱朱红漆嵌玉金锁大柜子。\n"),
    set("value", 50000);
    set("no_get",1);
  }

  set("replace_look",(: do_look :));
  setup();
}

int is_container()
{
  return 1;
}

void init()
{
  object me,who;
  me = this_object();
  who = this_player();
  me->set("short",me->short());
  call_out ("autoleave",1,me,who,0);
  add_action ("do_command","",1);
//  add_action ("do_look","look");
//  add_action ("do_put","put");
//  add_action ("do_get","get");
}

void autoleave (object me, object who, int i)
{
  if (!objectp(who) || !living(me) || environment(who) != me)
    return;
  if (i < 180)
  {
    call_out("autoleave",1,me,who,i+1);
    return;
  }

  who->move(environment(me));
  message_vision (HIB"只见$N" HIB"面如死灰地被内官拖了出来。\n"NOR,who);
  if (playerp(who))
    who->unconcious();
}

int do_command (string arg)
{
  string *strs = ({
    HIC"你听见"NOR,
    HIC"你好像听见里面"NOR,
    HIC"柜子里"NOR,
    HIC"柜子里似乎"NOR,
  });
  string *msgs = ({
    HIG"$N" HIG"在黑暗中胡乱踢打了几下。\n"NOR,
    HIG"$N" HIG"砰地撞在柜顶上。\n"NOR,
    HIG"$N" HIG"颠三倒四地发出噪音。\n"NOR,
    HIG"$N" HIG"胡乱挣扎着。\n"NOR,
    HIG"$N" HIG"摸摸索索地折腾着。\n"NOR,
    HIG"$N" HIG"发出一声哀鸣。\n"NOR,
    HIG"$N" HIG"狠狠地撞在柜壁上。\n"NOR,
    HIG"$N" HIG"不知所措地在黑暗中踢打着。\n"NOR,
    HIG"$N" HIG"发出笨重的撞击声。\n"NOR,
    HIG"$N" HIG"头撞在壁板上，发出沉闷的一声响。\n"NOR,
  });

  string str = element_of(strs);
  string msg = element_of(msgs);
  object who = this_player();
  object me = this_object();
  if (environment(who) != me)
    return 0;
  message_vision (msg,who);
  msg = replace_string (msg,"$N",who->name());
  tell_room(environment(me),str+msg);
  return 1;
}

int do_look (string arg)
{
  object me = this_object();
  object who = this_player();
  object where = environment(who);
  object ob;
  if (!arg)
    return 0;
  ob = present(arg,where);
  if (ob != me)
    return 0;
  tell_object(who,ob->long());
  return 1;
}

int do_put (string arg)
{
  string item;
  string id;
  object me = this_object();
  object who = this_player();
  object where = environment (me);
  if (sscanf(arg, "%s in %s", item, id)!=2)
    return 0;
  if (me != present(id,where))
    return 0;
  tell_object(who,"这里没有这样东西。\n");
  return 1;
}

int do_get (string arg)
{
  string item;
  string id;
  object me = this_object();
  object who = this_player();
  object where = environment (me);
  if (sscanf(arg, "%s from %s", item, id)!=2)
    return 0;
  if (me != present(id,where))
    return 0;
  tell_object(who,"这里没有这样东西。\n");
  return 1;
}