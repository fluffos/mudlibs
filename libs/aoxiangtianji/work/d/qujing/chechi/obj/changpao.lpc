#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create()
{
  set_name(HIG"绣花长袍"NOR, ({"xiuhua changpao", "cloth"}));
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一件长袍。\n");
    set("material", "cloth");
    set("unit", "件");
    set("value", 300);
  }

  init_cloth(15);
  setup();
}