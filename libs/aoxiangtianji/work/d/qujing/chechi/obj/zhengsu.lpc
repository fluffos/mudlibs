inherit ITEM;
void check_owner();
void create()
{
  set_name("蒸酥", ({"zheng su", "su"}));
  set_weight(1500);
  set("long", "一块供给三清的新鲜蒸酥。\n");
  set("unit", "块");
  set("value", 140);
}

void init()
{
  check_owner();
  add_action ("do_eat","eat");
}

void check_owner()
{
  object me = this_object();
  object where;

  if (!me)
    return;
  where = environment(me);
  if (where && playerp(where))
  {
    if (!me->query("owner"))
    {
      me->set("owner", where->query("id"));
    }

    else if (me->query("owner") != where->query("id"))
      destruct(me);
    remove_call_out("destruct_me");
    call_out("destruct_me",120,me);
  }

}

void destruct_me(object me)
{
  if (objectp(me))
    destruct(me);
}

int do_eat (string arg)
{
  string *a_id;
  object me = this_object();
  object who = this_player();
  object where = environment(who);
  object yuanshi = present("yuanshi tianzun",where);
  object lingbao = present("lingbao daojun",where);
  object taishang = present("taishang laojun",where);
  object yuanshi1 = present("yuanshi tianzun",who);
  object lingbao1 = present("lingbao daojun",who);
  object taishang1 = present("taishang laojun",who);
  object ob;
  if (! arg)
    return 0;
  ob = present(arg,who);
  if (! ob)
    ob = present(arg,where);
  if (ob != me)
    return 0;
  who->set("food",who->max_food_capacity());
  if (!objectp(where) || where->query("short")!="三清殿")
  {
    message_vision ("$N将$n吃了下去。\n",who,me);
    remove_call_out("destruct_me");
    destruct(me);
    return 1;
  }

  a_id = who->query_temp("apply/id");
  if (!arrayp(a_id) || a_id[0] != "taishang laojun")
//  if (!yuanshi1 || !lingbao1 || !taishang1)
  {
    where->daoshi_appear(who);
    message_vision ("$N饥不择食地将$n吃了下去。\n",who,me);
    remove_call_out("destruct_me");
    destruct(me);
    return 1;
  }

  if (yuanshi || lingbao || taishang)
  {
    where->daoshi_appear(who);
    message_vision ("$N狼吞虎咽地将$n吃了下去。\n",who,me);
    remove_call_out("destruct_me");
    destruct(me);
    return 1;
  }

  if (yuanshi1 || lingbao1 || taishang1)
  {
    where->daoshi_appear(who);
    message_vision ("$N风卷残云一般将$n吃了下去。\n",who,me);
    remove_call_out("destruct_me");
    destruct(me);
    return 1;
  }

  // player is too weak to solve the quest
  if ((int)who->query("level") <= 20)
  {
    where->daoshi_appear(who);
    message_vision ("$N急急忙忙地将$n吃了下去。\n",who,me);
    remove_call_out("destruct_me");
    destruct(me);
    return 1;
  }

  if ((int)who->query("obstacle/number") != 13)
  {
    where->daoshi_appear(who);
    message_vision ("$N急急忙忙地将$n吃了下去。\n",who,me);
    remove_call_out("destruct_me");
    destruct(me);
    return 1;
  }

  who->set_temp("obstacle/chechi0","eaten");
  message_vision ("$N一本正经地将$n吃了下去。\n",who,me);
  where->daotong_appear(who);
  remove_call_out("destruct_me");
  destruct(me);
  return 1;
}

