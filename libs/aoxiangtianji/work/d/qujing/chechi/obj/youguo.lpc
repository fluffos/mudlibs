#include <ansi.h>
inherit ITEM;
int do_look (string arg);
void create()
{
  set_name("大油锅", ({"da youguo", "youguo"}));
  set_weight(6000000);
  set_max_encumbrance(100000000000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "口");
    set("long", "一口巨大的油锅，里面热油滚滚。\n"),
    set("value", 50000);
    set("no_get",1);
  }

  set("replace_look",(: do_look :));
  setup();
}

int is_container()
{
  return 1;
}

void init()
{
  object me,who;
  me = this_object();
  who = this_player();
  me->set("short",me->short());
  call_out("disturbed",5+random(20),me,who);
  call_out ("autoleave",1,me,who,0);
//  add_action ("do_look","look");
//  add_action ("do_put","put");
//  add_action ("do_get","get");
}

void disturbed (object me, object who)
{
  string *msgs = ({
    HIY"$N" HIY"在滚油里挣扎了一下。\n"NOR,
    HIY"$N" HIY"从油浪里勉强冒出头来，又沉下去。\n"NOR,
    HIY"$N" HIY"扑打着双手。\n"NOR,
    HIY"$N" HIY"浮出油面，又被油浪压了下去。\n"NOR,
    HIY"$N" HIY"探出头来，大口喘气。\n"NOR,
    HIY"$N" HIY"从油面上伸出手乱抓了一下。\n"NOR,
    HIY"$N" HIY"随着油浪翻卷不止。\n"NOR,
    HIY"$N" HIY"的头勉强伸出滚烫的油面，旋即沉下。\n"NOR,
    HIY"$N" HIY"拼命蹿出油面喘着气。\n"NOR,
  });

  string msg = element_of(msgs);
  object where = environment(me);
  if (!objectp(who) || !living(who) || environment(who) != me)
    return;
  message_vision (msg,who);
  msg = replace_string (msg,"$N",who->name());
  tell_room(where,HIY"油锅中"NOR+msg,who);
  call_out("disturbed",5+random(20),me,who);
}

void autoleave (object me, object who, int i)
{
  if (!objectp(who) || !living(who) || environment(who) != me)
    return;
  if (i < 60)
  {
    call_out("autoleave",1,me,who,i+1);
    return;
  }

  who->move(environment(me));
  message_vision (HIR"几个内官上来用铁爪篱捞出$N" HIR"。\n"NOR,who);
  if (playerp(who))
    who->unconcious();
}

int do_look (string arg)
{
  object me = this_object();
  object who = this_player();
  object where = environment(who);
  object ob;
  mixed *inv;
  int i;
  if (!arg)
    return 0;
  ob = present(arg,where);
  if (ob != me)
    return 0;
  tell_object(who,ob->long());
  inv = all_inventory(ob);
  i = sizeof(inv);
  if (i)
  {
    tell_object(who,"翻滚的热油里有：\n");
    while (i--)
    {
      tell_object(who,"  "+inv[i]->short()+"\n");
    }

  }

  return 1;
}

int do_put (string arg)
{
  string item;
  string id;
  object me = this_object();
  object who = this_player();
  object where = environment (me);
  if (sscanf(arg, "%s in %s", item, id)!=2)
    return 0;
  if (me != present(id,where))
    return 0;
  tell_object(who,"这里没有这样东西。\n");
  return 1;
}

int do_get (string arg)
{
  string item;
  string id;
  object me = this_object();
  object who = this_player();
  object where = environment (me);
  if (sscanf(arg, "%s from %s", item, id)!=2)
    return 0;
  if (me != present(id,where))
    return 0;
  tell_object(who,"这里没有这样东西。\n");
  return 1;
}