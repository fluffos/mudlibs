inherit NPC;
void create()
{
  set_name("小和尚", ({"he shang","monk"}));
  set("long", "一位大和尚，看起来慈善的很，口里还不停的咏经。\n");
  set("gender", "男性");
  set("attitude", "peaceful");
  set("class", "bonze");
  set("age", 20+random(10));
  set("combat_exp", 15000);
  set("per", 25);
  set("max_kee", 700);
  set("max_sen", 700);
  set("force", 800);
  set("max_force", 500);
  set("force_factor", 5);
  set_skill("force", 50+random(20));
  set_skill("unarmed", 50+random(20));
  set_skill("dodge", 50+random(20));
  set_skill("parry", 50+random(40));
  setup();
  carry_object("/obj/cloth/c-jiasha")->wear();
  setup();
}

