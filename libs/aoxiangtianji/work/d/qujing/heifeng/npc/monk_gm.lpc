inherit NPC;
void create()
{
  set_name("广谋", ({"guang mou","monk"}));
  set("long", "一位小和尚，看起来慈善的很，口里还不停的咏经。\n");
  set("gender", "男性");
  set("attitude", "peaceful");
  set("class", "bonze");
  set("age", 10+random(10));
  set("combat_exp", 15000);
  set("daoxing",20000);
  set("per", 25);
  set("max_kee", 380);
  set("max_sen", 380);
  set("force", 250);
  set("force_factor", 5);
  set_skill("force", 20+random(20));
  set_skill("unarmed", 20+random(20));
  set_skill("dodge", 20+random(20));
  set_skill("parry", 20+random(40));
  setup();
  carry_object("/obj/cloth/sengyi")->wear();
  setup();
}