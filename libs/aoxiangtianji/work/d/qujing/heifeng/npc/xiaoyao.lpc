inherit "/d/qujing/npc/xiaoyao";
void create()
{
  ::create();
  set_name("黑风山小妖", ({"xiao yao","yao", "jing"}));
  set("gender", "男性");
  set("long","一个守洞的妖精。\n");
  setup();
}

void die ()
{
  object me = this_object();
  object where = environment (me);
  if (! present("yao jing 4",where) &&
      where->query("short")=="平台")
  {
    object ob = new (__DIR__"xiaoyao");
    ob->move(where);
    message_vision ("\n只见从前方又跑过来一个小妖。\n",me);
  }

  destruct (me);
}

void unconcious ()
{
  die();
}