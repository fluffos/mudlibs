#include <ansi.h>
inherit NPC;
string ask_jiasha();
void create()
{
  set_name("黑熊怪", ({ "hei xiong", "bear", "monster" }));
  set("long", "山间野兽，不知从哪里学到一身好本领。");
  set("gender", "男性");
  set("age", 30);
  set("attitude", "heroism");
  set("per", 9);
  set("rank_info/self", "黑熊");
  set("rank_info/rude", "熊怪");
  set("max_kee", 4000);
  set("max_sen", 4000);
  set("force", 4000);
  set("max_force", 2200);
  set("force_factor", 100);
  set("max_mana", 2200);
  set("mana", 4000);
  set("mana_factor", 100);
  set("combat_exp", 1500000);
  set("daoxing", 1500000);
  set("no_ji",1);
  set_skill("spells", 180 + random(50));
  set_skill("buddhism", 180 + random(50));
  set_skill("unarmed", 180 + random(50));
  set_skill("jienan-zhi", 180 + random(50));
  set_skill("dodge", 180 + random(50));
  set_skill("lotusmove", 180 + random(50));
  set_skill("parry", 180 + random(50));
  set_skill("force", 180 + random(50));
  set_skill("lotusforce", 180 + random(50));
  set_skill("spear", 180 + random(50));
  set_skill("huoyun-spear", 180 + random(50));
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "huoyun-spear");
  map_skill("spear", "huoyun-spear");
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: perform_action, "spear.lihuo" :),
  }) );

  set("inquiry",([
    "袈裟": (: ask_jiasha :),
    "jiasha":  (: ask_jiasha :),
  ]));
  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/weapon/spear/tieqiang")->wield();
}

int accept_fight (object ob)
{
  command("exert powerup");
  kill_ob (ob);
  return 1;
}

void kill_ob (object ob)
{
  set_temp("no_return",1);
  set_temp("my_killer",ob);
  ::kill_ob(ob);
  call_out ("move_to_cave",1,this_object());
}

void move_to_cave (object me)
{
  object where = environment(me);
  object room = load_object("/d/qujing/heifeng/cave");
  if (! where ||
    where->query("short") == "正台")
    return;
  message_vision ("\n$N化作一阵风消失了！\n",me);
  me->move(room);
}

string ask_jiasha()
{
  object ob = this_player();
  if((int)ob->query("obstacle/number") != 2)
  {
    command("shake");
    return("这又何从说起。\n");
  }

  if (! ob->query_temp("apply/name") ||
       ob->query_temp("apply/name")[0] != "金池长老")
  {
    kill_ob(ob);
    return("你是哪个鸟人，敢来参加本大仙的佛衣会。");
  }

  command("hehe");
  return("请稍等。");
}

void die ()
{
  object pusa;
  object me = this_object();
  object ob = query_temp("my_killer");
  if (ob &&
      ob == me->query_last_damage_from() &&
      (int)ob->query("obstacle/number") == 2)
  {
    pusa = new ("/d/qujing/heifeng/npc/pusa");
    pusa->move(environment(me));
    pusa->announce_success (ob);
    destruct (pusa);
  }

  message_vision(HIR"只见$N摔倒在地，现了本形。原来是只黑熊！\n"NOR,me);
  destruct (me);
  return;
}

void unconcious ()
{
  die ();
}

