#include <ansi.h>
inherit NPC;
void create()
{
  set_name("白衣秀士", ({"baiyi xiushi","xiu shi"}));
  set("long", "一位身材很苗条的男子。\n");
  set("gender", "男性");
  set("attitude", "peaceful");
  set("age", 80);
  set("combat_exp", 800000);
  set("daoxing",800000);
  set("per", 10);
  set("max_kee", 2800);
  set("max_sen", 2800);
  set("force", 2500);
  set("max_force",1500);
  set("force_factor", 70);
  set("mana", 2500);
  set("max_mana",1500);
  set("mana_factor", 70);
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: cast_spell, "qunshu" :),
    (: perform_action, "sword.yaowu" :)
  }) );

  set_skill("force", 150+random(50));
  set_skill("spells", 150+random(50));
  set_skill("unarmed", 150+random(50));
  set_skill("dodge", 150+random(50));
  set_skill("parry", 150+random(50));
  set_skill("sword", 150+random(50));
  set_skill("huntian-qigong", 150+random(50));
  set_skill("yaofa", 150+random(50));
  set_skill("lingfu-steps",150+random(50));
  set_skill("yinfeng-zhua", 150+random(50));
  set_skill("zishu-sword",150+random(50));

  map_skill("force", "huntian-qigong");
  map_skill("spells", "yaofa");
  map_skill("dodge", "lingfu-steps");
  map_skill("unarmed", "yinfeng-zhua");
  map_skill("sword", "zishu-sword");
  map_skill("parry", "zishu-sword");

  setup();
  carry_object("/obj/cloth/baipao")->wear();
  carry_object("/d/obj/weapon/sword/peijian")->wield();
}

void kill_ob(object ob)
{
  object where=environment(ob);
  object bear = present("hei xiong",where);
  object lingxu=present("lingxu zi",where);
  if ( bear )
    bear->kill_ob(ob);
  if ( lingxu )
    lingxu->kill_ob(ob);
  ::kill_ob(ob);
  return;
}

void die()
{
  message_vision(HIY"白衣秀士翻了个身，死了。\n",this_object());
  message_vision("只见一条白花蛇落在地上。\n"NOR,this_object());
  this_object()->set_name("白花蛇",({"baihua she","snake"}));
  ::die();
}

