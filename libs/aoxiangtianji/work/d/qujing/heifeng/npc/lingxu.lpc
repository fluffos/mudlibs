inherit NPC;
void create()
{
  set_name("凌虚子", ({"lingxu zi", "zi"}));
  set("gender", "男性");
  set("age", 30);
  set("long", "一个身高臂长的道士，容貌还看的过去。"
              "可仔细一瞧，颈中竟长着密密麻麻的长毛。\n");
  set("attitude", "heroism");
  set("class", "yaomo");
  set("bellicosity", 800);
  set("per", 18);
  set("looking", "相貌凶恶，满脸横肉。");
  set("str", 25);
  set("combat_exp", 900000);
  set("daoxing",900000);
  set("force", 3200);
  set("max_force", 1800);
  set("force_factor", 90);
  set("max_kee", 2800);
  set("max_sen", 2800);
  set("max_mana", 1800);
  set("mana", 3200);
  set("mana_factor", 90);
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: cast_spell, "zhenhuo" :),
    (: perform_action, "whip.ruyu" :)
  }) );
  set_skill("force", 160+random(50));
  set_skill("spells", 160+random(50));
  set_skill("dodge", 160+random(50));
  set_skill("unarmed", 160+random(50));
  set_skill("parry", 160+random(50));
  set_skill("whip", 160+random(50));
  set_skill("zhenyuan-force", 160+random(50));
  set_skill("taiyi", 160+random(50));
  set_skill("baguazhen", 160+random(50));
  set_skill("wuxing-quan", 160+random(50));
  set_skill("taixuan-whip", 160+random(50));

  map_skill("force","zhenyuan-force");
  map_skill("spells","taiyi");
  map_skill("dodge", "baguazhen");
  map_skill("unarmed", "wuxing-quan");
  map_skill("whip","taixuan-whip");
  map_skill("parry","taixuan-whip");
  set_temp("apply/armor", 25);
  setup();

  carry_object("/obj/cloth/dao-cloth")->wear();
  carry_object("/d/obj/armor/shoes/yunxie")->wear();
  carry_object("/d/obj/weapon/whip/fuchen")->wield();
}

int accept_fight (object ob)
{
  command("exert powerup");
  kill_ob (ob);
  return 1;
}

void kill_ob (object ob)
{
  set_temp("no_return",1);
  set_temp("my_killer",ob);
  ::kill_ob(ob);
  call_out ("move_to_cave",1,this_object());
}

void move_to_cave (object me)
{
  object where = environment(me);
  object room = load_object("/d/qujing/heifeng/cave");
  if (! where ||
    where->query("short") == "正台")
    return;
  message_vision ("\n$N驾云夺路而逃！\n",me);
  me->move(room);
}