inherit NPC;
void create()
{
  int i;
  string w;

  i = random(3);

  set_name("宫兵", ({ "gong bing", "bing" }) );
  set("long","一个宫兵。\n");
  set("gender", "男性");
  set("age", 35);
  set("combat_exp", 600000+random(200000));
  set("daoxing", 600000+random(200000));
  set("attitude", "heroism");
  set("str", 30);
  set("dex", 30);
  set("spi", 30);
  set("max_kee", 2500);
  set("max_sen", 2500);
  set("force", 2500);
  set("max_force", 1500);
  set("force_factor", 75);
  set("mana", 2500);
  set("max_mana", 1500);
  set("mana_factor", 75);
  set("people", "people");
  set("no_nk_reward",1);
  set_skill("force", 120 + random(30));
  set_skill("spells", 120 + random(30));
  set_skill("dodge", 120 + random(30));
  set_skill("unarmed", 120 + random(30));
  set_skill("parry", 120 + random(30));
  set_skill("blade", 120 + random(30));
  set_skill("lengquan-force",120 + random(30));
  set_skill("baguazhou",120 + random(30));
  set_skill("yanxing-steps",120 + random(30));
  set_skill("changquan",120 + random(30));
  set_skill("wuhu-blade",120 + random(30));
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed", "changquan");
  map_skill("blade", "wuhu-blade");
  map_skill("parry", "wuhu-blade");

  switch(i)
  {
    case 0 :
      set_skill("blade",120 + random(30));
      set_skill("wuhu-blade",120 + random(30));
      map_skill("blade","wuhu-blade");
      map_skill("parry", "wuhu-blade");
      w = "/d/qujing/baoxiang/obj/wandao";
      break;
    case 1 :
      set_skill("spear",120 + random(30));
      set_skill("lihua-spear",120 + random(30));
      map_skill("spear","lihua-spear");
      map_skill("parry", "lihua-spear");
      w = "/d/obj/weapon/spear/tieqiang";
      break;
    default :
      set_skill("sword",120 + random(30));
      set_skill("sancai-sword",120 + random(30));
      map_skill("sword","sancai-sword");
      map_skill("parry", "sancai-sword");
      w = "/d/obj/weapon/sword/changjian";
      break;
  }

  setup();
  carry_object(w)->wield();
  carry_object("/obj/cloth/zhanpao")->wear();
}