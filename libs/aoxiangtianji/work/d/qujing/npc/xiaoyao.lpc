inherit NPC;
#include "/d/qujing/obj/weapon/y_weapon.h"
void create()
{
  string wtype, w, s;

  set_name("小妖", ({"xiao yao","yao", "jing"}));
  set("gender", "男性");
  set("age", 20 + random(20));
  set("long","一个小妖。\n");

  set("combat_exp", 400000+random(400000));
  set("daoxing", 400000+random(400000));
  set("per", 15);
  set("str", 10+random(35));
  set("spi", 10+random(35));
  set("con", 10+random(35));
  set("dex", 10+random(35));

  set_skill("force", 80 + random(40));
  set_skill("spells", 80 + random(40));
  set_skill("dodge", 80 + random(40));
  set_skill("unarmed", 80 + random(40));
  set_skill("parry", 80+random(40));

  set_skill("huntian-qigong",80+random(40));
  set_skill("yaofa",80+random(40));
  set_skill("feiyan-zoubi",80+random(40));
  set_skill("changquan",80+random(40));

  set("max_sen",1200 + random(400));
  set("max_kee",1200 + random(400));
  set("force",1500 + random(500));
  set("max_force",1000);
  set("mana",1500 + random(500));
  set("max_mana",1000);
  set("force_factor", 50);
  set("mana_factor", 50);

  map_skill("force", "huntian-qigong");
  map_skill("spells", "yaofa");
  map_skill("dodge", "feiyan-zoubi");
  map_skill("unarmed", "changquan");

  wtype = element_of(t_weap);
  set_skill(wtype, 80+random(40));
  s = s_weap[wtype];
  if (stringp(s))
  {
    set_skill(s, 80+random(40));
    map_skill(wtype,s);
    map_skill("parry", s);
  }

  setup();
  carry_object(sprintf("/d/qujing/obj/armor/armor%d",1+random(3)))->wear();
  carry_object(sprintf("/d/qujing/obj/armor/cloth%d",1+random(3)))->wear();
  w = random_w[wtype];
  carry_object(w)->wield();
}