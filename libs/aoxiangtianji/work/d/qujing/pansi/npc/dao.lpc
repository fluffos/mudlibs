inherit NPC;
void create()
{
  set_name("黄花道士", ({ "huanghua daoshi", "dao", "shi" }));
  set("title", "黄花五公");
  set("long", "一位欲神欲仙的黄花观五公道士。");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "heroism");
  set("per", 30);
  set("spi", 30);
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("cps", 30);
  set("cor", 30);

  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 6000);
  set("max_force", 3000);
  set("force_factor", 120);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 150);
  set("combat_exp", 2500000);
  set("daoxing", 2500000);
  set("no_ji",1);
  set_skill("force", 210+random(50));
  set_skill("spells", 210+random(50));
  set_skill("dodge", 210+random(50));
  set_skill("unarmed", 210+random(50));
  set_skill("parry", 210+random(50));
  set_skill("whip", 210+random(50));
  set_skill("zhenyuan-force", 210+random(50));
  set_skill("taiyi", 210+random(50));
  set_skill("baguazhen", 210+random(50));
  set_skill("wuxing-quan", 210+random(50));
  set_skill("taixuan-whip", 210+random(50));

  map_skill("force","zhenyuan-force");
  map_skill("spells","taiyi");
  map_skill("dodge", "baguazhen");
  map_skill("unarmed", "wuxing-quan");
  map_skill("whip","taixuan-whip");
  map_skill("parry","taixuan-whip");
  set_temp("apply/armor", 25);
  setup();
  carry_object("/obj/cloth/dao-cloth")->wear();
  carry_object("/d/obj/armor/shoes/yunxie")->wear();
  carry_object("/d/obj/weapon/whip/fuchen")->wield();
}

void die ()
{
  object daogu;
  object me = this_object();
  object ob = query_temp("my_killer");
  if (ob &&
      ob == me->query_last_damage_from() &&
      (int)ob->query("obstacle/number") == 24 &&
      (string)ob->query("obstacle/pansi") != "done" &&
      ob->query_temp("obstacle/pansi_killed") >= 14)
  {
    daogu = new ("/d/qujing/pansi/npc/daogu");
    daogu->move(environment(ob));
    daogu->announce_success (ob);
    destruct(daogu);
  }

  message_vision ("\n$N扑倒在尘埃里，现身为一七尺蜈蚣精。\n",me);
  message_vision ("\n蜈蚣精化为一股青烟噌地消散了。\n",me);
  destruct(me);
}

void unconcious ()
{
  die ();
}

int accept_fight(object ob)
{
  kill_ob(ob);
  return 1;
}

void full_me(object me)
{
  me->set("kee",me->query("max_kee"));
  me->set("eff_kee",me->query("max_kee"));
  me->set("sen",me->query("max_sen"));
  me->set("eff_sen",me->query("max_sen"));
  me->set("force",me->query("max_force"))*2;
  me->set("mana",me->query("max_mana"))*2;
  me->clean_condition(0);
  return;
}

void kill_ob (object ob)
{
  object me = this_object();
  if (userp(ob))
  {
    full_me(me);
    set_temp("my_killer",ob);
  }

  call_out ("recovering",1,me,ob);
  call_out ("hurting",random(5)+5,me,ob);
  ::kill_ob(ob);
}

void recovering (object me, object ob)
{
  object needle;
  if (!me || !ob || environment(ob) != environment(me))
    return;
  needle = present("xiuhua zhen",ob);
  if ((!objectp(needle) || needle != ob->query_temp("weapon")) &&
      (me->query("kee") < (me->query("max_kee")*3/4) ||
       me->query("sen") < (me->query("max_sen")*3/4)))
  {
    message_vision ("\n$N身上万道金光一闪，顿时精神气血尽回！\n",me);
    me->set("kee",me->query("max_kee"));
    me->set("sen",me->query("max_sen"));
    me->set("eff_kee",me->query("max_kee"));
    me->set("eff_sen",me->query("max_sen"));
  }

  call_out ("recovering",1,me,ob);
}

void hurting (object me, object ob)
{
  string *msgs = ({
    "$N将衣一掀，无数道金光向$n一射！\n",
    "$N一抬手，胁下千只眼睛金光闪闪射向$n！\n",
    "$N掀起胳膊下无数只眼睛迸出金光直射向$n！\n",
  });
  string *strs = ({
    "( $N一个趔趄不由自主地惨叫一声！ )\n",
    "( $N应声倒下，又勉强爬将起来！ )\n",
    "( $N痛苦地惨嚎了一声！ )\n",
  });
  object needle;
  int damage;
  if (!me || !ob || environment(ob) != environment(me))
    return;
  if (! me->is_fighting())
    return;
  message_vision ("\n"+element_of(msgs),me,ob);

  needle = present("xiuhua zhen",ob);
  if (!objectp(needle) ||
      needle != ob->query_temp("weapon") ||
      random(3) == 0)
  {
    message_vision (element_of(strs),ob);
    damage = ob->query("max_kee")/(3+random(3));
    ob->receive_damage("kee",damage,me);
    ob->receive_wound("kee",damage,me);
    ob->receive_damage("sen",damage,me);
    ob->receive_wound("sen",damage,me);
  }

  else
  {
    message_vision ("但见$N手上绣花针一闪，"+
                    "$n嚎叫一声，胁下几只眼睛顿时灭去！\n",ob,me);
  }

  remove_call_out ("hurting");
  call_out ("hurting",random(10)+10,me,ob);
}

