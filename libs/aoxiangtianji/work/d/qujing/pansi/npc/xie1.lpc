#include <ansi.h>
inherit NPC;
void create()
{
  set_name("道士", ({"dao shi", "xie gong", "xie", "shi"}));
  set("title", "毒尾蝎公");
  set("gender", "男性");
  set("age", 80);
  set("attitude", "aggressive");
  set("combat_exp", 3500000);
  set("daoxing", 3500000);
  set_skill("dodge", 260);
  set_skill("parry", 260);
  set_skill("force", 260);
  set_skill("spells", 260);
  set_skill("unarmed", 260);
  set_skill("dao", 260);
  set_skill("wuxiangforce", 260);
  set_skill("ghost-steps", 100);
  set_skill("jienan-zhi", 260);
  set("con", 30);
  set("cor", 30);
  set("int", 30);
  set("per", 30);
  set("spi", 30);
  set("cps", 30);
  set("dex", 30);
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "ghost-steps");
  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  set("max_kee", 6000);
  set("max_sen", 6000);
  set("force", 7000);
  set("max_force", 3500);
  set("mana", 7000);
  set("max_mana", 3500);
  set("force_factor", 30);
  set("mana_factor", 180);
  setup();
  carry_object("/obj/cloth/dao-cloth")->wear();
}

void die()
{
  object shell = new ("/d/obj/misc/shell");
  shell->move(environment(this_object()));
  message_vision ("\n$N浑身一软瘫在地上，化做一堆空空的虫壳。\n",
                  this_object());
  destruct(this_object());
}

void unconcious()
{
  die();
}

