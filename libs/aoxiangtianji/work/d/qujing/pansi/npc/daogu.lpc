inherit NPC;
void create()
{
  set_name("毗蓝婆", ({"pilan po", "po", "daogu"}));
  set("title", "道姑");
  set("gender", "女性");
  set("age", 58);
  set("per", 26);
  set("rank_info/respect", "菩萨");
  set("combat_exp", 5000000);
  set("daoxing", 5000000);
  set_skill("snowsword", 390);
  set_skill("sword", 390);
  set_skill("dragonfight", 390);
  set_skill("unarmed", 390);
  set_skill("dodge", 390);
  set_skill("parry",390);
  set_skill("spells", 390);
  set_skill("dragonstep", 390);
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "dragonfight");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  set("max_kee", 4900);
  set("max_sen", 4900);
  set("force", 9000);
  set("max_force", 4000);
  set("mana", 9000);
  set("max_mana", 4000);
  set("force_factor", 190);
  set("mana_factor", 190);
  setup();
  carry_object("/obj/cloth/pinkskirt")->wear();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
}

void announce_success (object who)
{
  int dx,qn;
  if (who->query("obstacle/number") != 24 ||
      who->query("obstacle/pansi") == "done" ||
      who->query_temp("obstacle/pansi_killed") < 14)
    return;
  dx = random(3200);
  dx += 32000;
  qn = dx/3;
  who->set("obstacle/number",25);
  who->set("obstacle/pansi","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  who->delete_temp("obstacle/pansi_killed");
  command("chat "+who->query("name")+"盘丝岭尽除蜘蛛精黄花观降服蜈蚣精！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed pingding on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}