inherit ITEM;
inherit F_FOOD;
string *p = ({
  "烧",
  "红油",
  "煎",
  "水煮",
});

void create()
{
  set_name(element_of(p) + "面筋", ({"mian jin", "mianjin", "jin"}));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一碗烧得黑乎乎的面筋，看上去有点怪。\n");
    set("unit", "碗");
    set("value", 300);
    set("food_remaining", 4);
    set("food_supply", 50);
  }

}