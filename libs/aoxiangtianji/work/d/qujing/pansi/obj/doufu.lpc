inherit ITEM;
inherit F_FOOD;
void create()
{
  set_name("煎豆腐", ({"jian doufu", "doufu", "fu"}));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一碗煎得两面黄的豆腐，散发着奇怪的腥味。\n");
    set("unit", "碗");
    set("value", 300);
    set("food_remaining", 4);
    set("food_supply", 50);
  }

}