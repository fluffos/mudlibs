inherit NPC;
void create()
{
  set_name("金圣宫", ({"jinsheng gong", "gong", "queen"}));
  set("title", "朱紫国");
  set("gender", "女性");
  set("age", 28);
  set("per", 26);
  set("rank_info/respect", "娘娘");
  set("combat_exp", 100000);
  set("daoxing", 50000);
  set_skill("snowsword", 30);
  set_skill("sword", 30);
  set_skill("dragonfight", 30);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set_skill("spells", 30);
  set_skill("dragonstep", 30);
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "dragonfight");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  set("max_gin", 500);
  set("max_kee", 500);
  set("max_sen", 500);
  set("force", 500);
  set("max_force", 500);
  set("mana", 500);
  set("max_mana", 500);
  set("force_factor", 10);
  setup();
  carry_object("/obj/cloth/pinkskirt")->wear();
}

void test_player (object who);
void init()
{
  test_player (this_player());
  ::init();
}

void test_player (object who)
{
  int dx, qn;
  if (who->query("obstacle/number") != 23 ||
      who->query("obstacle/zhuzi") == "done" ||
      !who->query_temp("obstacle/zhuzi_cured") ||
      !who->query_temp("obstacle/zhuzi_killed"))
    return;
  dx = random(3000);
  dx += 30000;
  qn = dx/3;
  who->set("obstacle/number",24);
  who->set("obstacle/zhuzi","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  who->delete_temp("obstacle/zhuzi_cured");
  who->delete_temp("obstacle/zhuzi_killed");
  command("chat "+who->query("name")+"朱紫国施神力治愈万岁，解救金圣宫于三年久祸！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed pingding on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  command ("thank");
  call_out ("leaving",2);
}

void leaving ()
{
  object me = this_object();
  command("bow");
  command("southeast");
  destruct (me);
}