  "熊师",
  "豹头",
  "彪帅",
  "羊头怪",
  "獭象怪",
  "鹿头怪",
  "苍狼怪",
  "乖獐怪",
  "狡兔怪",
  "长蛇怪",
  "狒狒怪",
  "蟒蛇怪",
});
