inherit NPC;
void create()
{
  set_name("妖王", ({"yao wang", "wang" }));
  set("title","赛太岁");
  set("gender", "男性");
  set("age", 80);
  set("attitude", "peaceful");
  set("per", 30);
  set("int", 30);
  set("str", 30);
  set("spi", 30);
  set("con", 30);
  set("dex", 30);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("force", 6000);
  set("max_force", 3000);
  set("force_factor", 150);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 150);
  set("combat_exp", 2400000);
  set("daoxing", 2400000);
  set("no_ji",1);

  set_skill("force", 220 + random(50));
  set_skill("spells", 220 + random(50));
  set_skill("dodge", 220 + random(50));
  set_skill("unarmed", 220 + random(50));
  set_skill("parry", 220 + random(50));
  set_skill("mace", 220 + random(50));

  set_skill("lengquan-force", 220 + random(50));
  set_skill("baguazhou", 220 + random(50));
  set_skill("yanxing-steps", 220 + random(50));
  set_skill("changquan", 220 + random(50));
  set_skill("jinglei-mace",220 + random(50));

  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed", "changquan");
  map_skill("parry", "jinglei-mace");
  map_skill("mace", "jinglei-mace");

  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/qujing/qilin/obj/shield")->wear();
  carry_object("/d/obj/weapon/mace/wufeng")->wear();
}

void kill_ob (object ob)
{
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

void die()
{
  object me = this_object();
  object where ,ob;
  where = environment(me);
  ob = query_temp("my_killer");
  if (where)
  {
    message("sound","\n\n只听得半空厉声高叫：“手下留情，观音来也！”\n",where);
    message("sound", "\n妖王打了一个滚，现了金毛兽原形，被一道金光罩去。\n\n",
            where);
  }

  if (objectp(ob) &&
      ob == me->query_last_damage_from() &&
      ob->query("obstacle/number") == 23 &&
      ob->query("obstacle/zhuzi") != "done" &&
      ob->query_temp("obstacle/zhuzi_cured"))
    ob->set_temp("obstacle/zhuzi_killed",1);
  destruct (this_object());
}

void unconcious()
{
  die();
}