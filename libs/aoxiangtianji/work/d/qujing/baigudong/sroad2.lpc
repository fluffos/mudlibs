inherit SMALLROOM;
inherit SANDROOM;
void create ()
{
  set ("short", "山石路");
  set ("long", @LONG
烈阳当头熊熊,山路颠簸不平，偶闻惊鸟声，恐有多事端。
近观路有零星白骨，远望难见人烟，让人越走越心慌，只想快
快走出这片地方。
LONG);
  set("outdoors", __DIR__"");
  set("exits", ([
    "east"      : __DIR__"sroad1",
    "northwest" : __DIR__"sroad3",
  ]));
  setup();
}

