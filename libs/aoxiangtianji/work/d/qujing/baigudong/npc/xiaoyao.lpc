#include <ansi.h>
inherit "/d/qujing/npc/xiaoyao";
void create()
{
  ::create();
  set_name("巡山小妖", ({"xiao yao","yao"}));
  set("gender", "男性");
  set("age", 25);
  set("attitude","aggressive");
  set("xiaoyao","xiaoyao");
  set("chat_chance",10);
  set("chat_msg",({
    "巡山小妖馋的口水都流出来了,嘿嘿，今天又有一顿美餐了。！\n",
    "巡山小妖大叫到，大王要我们拿人，今日你休想跑！\n",
    (: random_move :),
    "巡山小妖打了个响指，哈哈，今天福气了。！\n",
    "巡山小妖嘿嘿冷笑两声，今天叫你来得去不得！\n",
    (: random_move :),
  }));
}

void init()
{
  object ob = this_player();
  ::init();
  if( playerp(ob) && !is_fighting() )
  {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}

void greeting(object ob)
{
  if( !ob || environment(ob) != environment() )
    return;
  if(!ob->query_temp("obstacle/xiaoyao_kill"))
  {
    if (ob->query_temp("obstacle/east_from"))
    {
      command("consider "+ob->query("id"));
      message_vision (HIC"$N看了看$n" HIC"，哈哈笑道：前几天大王说有东土大唐"
                      "取经的人路过，吃了可以长生不老,看来就是你!\n" + HIR +
                      RANK_D->query_rude(ob) + HIC"休走！\n" NOR,
                      this_object(),ob);
    }

    else
    {
      message_vision("$N大喜道：又有一顿美餐送上门来了!\n",this_object());
    }

  }

  this_object()->kill_ob(ob);
  ob->set_temp("obstacle/xiaoyao_kill",1);
}

