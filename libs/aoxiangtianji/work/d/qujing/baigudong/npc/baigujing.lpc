#include <ansi.h>
inherit NPC;
void create()
{
  set_name("白骨精", ({"baigu jing", "jing"}));
  set("title", "白骨夫人");
  set("long",@LONG
    白骨夫人乃是千年白骨精修炼成形，前世是怨死鬼魂不
得超生，修炼成形后，怨恨人类，于是发誓要吃尽天下人。
LONG);
  set("gender", "女性");
  set("age", 40);
  set("attitude", "friendly");
  set("combat_exp", 2100000);
  set("daoxing", 2100000);
  set("max_kee", 3000);
  set("max_sen", 3000);
  set("force", 5000);
  set("max_force", 3000);
  set("mana", 5000);
  set("max_mana", 3000);
  set("force_factor", 100);
  set("mana_factor", 150);
  set("no_ji",1);
  set_skill("force", 190 + random(40));
  set_skill("spells", 190 + random(40));
  set_skill("dodge", 190 + random(40));
  set_skill("parry", 190 + random(40));
  set_skill("unarmed", 190 + random(40));
  set_skill("stick", 190 + random(40));

  set_skill("tonsillit", 190 + random(40));
  set_skill("gouhunshu", 190 + random(40));
  set_skill("ghost-steps", 190 + random(40));
  set_skill("jinghun-zhang", 190 + random(40));
  set_skill("kusang-stick", 190 + random(40));

  map_skill("dodge","ghost-steps");
  map_skill("unarmed", "jinghun-zhang");
  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");
  map_skill("stick", "kusang-stick");
  map_skill("parry", "kusang-stick");
  set("chat_chance_combat",40);
  set("chat_msg_combat", ({
     (: perform_action, "stick.qmly" :),
     (: cast_spell, "gouhun" :),
  }) );
  setup();
  carry_object("/d/qujing/baigudong/obj/renpipifeng")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/qujing/baigudong/obj/baigugun")->wield();
}

void init ()
{
  object ob = this_player();
  ::init();
  if( playerp(ob) && !is_fighting() )
  {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}

void greeting(object ob)
{
  if( !ob || environment(ob) != environment() )
    return;

  if(!ob->query_temp("obstacle/baigudong_nuzi_killed") ||
     !ob->query_temp("obstacle/baigudong_furen_killed") ||
     !ob->query_temp("obstacle/baigudong_gonggong_killed") )
  {
    command("consider "+ob->query("id"));
    message_vision ("$N道：好久没吃人肉，想不到今天送上门来了！\n",this_object());
    command("spank");
  }

  else
  {
    message_vision ("$N道：哈哈，又是你，居然找上了门。。。\n",this_object());
  }

  this_object()->kill_ob(ob);
}

int accept_fight (object ob)
{
  kill_ob (ob);
  return 1;
}

void kill_ob (object ob)
{
  set_temp("no_return",1);
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

void die()
{
  object shanshen;
  object ob = query_temp("my_killer");
  object me = this_object();
  object gutou = new("/d/qujing/baigudong/obj/fenkulou");
  object where;

  where =environment(me);

  if (ob &&
      ob == me->query_last_damage_from() &&
      (int)ob->query("obstacle/number") == 8 &&
      ob->query_temp("obstacle/baigudong_nuzi_killed") &&
      ob->query_temp("obstacle/baigudong_furen_killed") &&
      ob->query_temp("obstacle/baigudong_gonggong_killed") &&
      ob->query_temp("obstacle/baigudong_lingfu_getted"))
  {
    shanshen = new ("/d/qujing/baigudong/npc/shanshen");
    shanshen->move(where);
    shanshen->announce_success (ob);
    destruct(shanshen);
    ob->delete_temp("obstacle/baigudong_nuzi_killed");
    ob->delete_temp("obstacle/baigudong_furen_killed");
    ob->delete_temp("obstacle/baigudong_gonggong_killed");
    ob->delete_temp("obstacle/baigudong_lingfu_getted");
  }

  message_vision ("\n$N惨叫一声，化成一堆骷髅，散落在地上。\n",me);
  gutou->move(where);
  command("remove pifeng");
  command("unwield stick");
  command("drop pifeng");
  command("drop stick");
  destruct(me);
  return;
}

void unconcious()
{
  die();
}

