#include <ansi.h>
inherit "/d/qujing/npc/yaojing";
string *prefixs = ({
  "黑脸",
  "青面",
  "白眉",
  "黄牙",
  "紫须",
  "蓝耳",
});

void create()
{
  set_name(element_of(prefixs)+"僵尸", ({"jiang shi", "shi"}));
  set("title", "僵尸");
  set("gender", "男性");
  set("age", 100);
  set("attitude", "aggressive");
  set("combat_exp", 2000000);
  set("daoxing", 2000000);
  set_skill("dodge", 240);
  set_skill("parry", 240);
  set_skill("force", 240);
  set_skill("spells", 240);
  set_skill("unarmed", 240);
}

void unconcious()
{
  die();
}

void die()
{
  message_vision ("\n$N浑身一软瘫在地上，散落在地上化做一摊黄水。\n", this_object());
  destruct(this_object());
}