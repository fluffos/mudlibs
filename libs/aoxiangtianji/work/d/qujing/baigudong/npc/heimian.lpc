inherit NPC;
int give_lingfu();
void create()
{
  set_name("黑面山神", ({"heimian shanshen","shan shen", "shanshen"}));
  set("gender", "男性");
  set("age", 100);
  set("attitude", "friendly");
  set("combat_exp", 500000);
  set("per", 50);
  set_skill("dodge", 150);
  set("max_sen",2000);
  set("max_gee",2000);
  set("max_gin",2000);
  set("force",800);
  set("max_force",800);
  set("max_mana",1620);
  set("force_factor",30);
  set_skill("spells",150);
  set_skill("dao",90);
  set_skill("stick",120);
  set_skill("qianjun-stick",100);
  map_skill("stick","qianjun-stick");
  map_skill("spells","dao");
  setup();
  set("inquiry", ([
    "here": "这儿是白骨山，白骨洞就在上面在此。\n",
    "白骨山": "白骨山妖气重重，瘴气迷天，小心啊。\n",
    "白骨洞": "白骨洞住了个吃人的妖精，厉害异常啊，老夫就是被他赶下山的。\n",
    "name": "黑面山神就是老夫，要上白骨山，唯有问老夫索要灵符。\n",
    "灵符": (: give_lingfu :),
    "lingfu": (: give_lingfu :),
  ]));
  set("chat_chance",30);
  set("chat_msg",({
    "黑面山神唉的叹了一口气，难道就没有人去把白骨精给降服。！\n",
    "黑面山神自言自语道，这白骨山瘴气重重，寻常人是上不得山的。\n",
    "黑面山神笑道，不过老夫的清瘴灵符是一定有用的。\n",
  }));
  carry_object("/obj/cloth/choupao")->wear();
  carry_object("/d/obj/weapon/staff/muzhang")->wield();
}

int give_lingfu()
{
  object me = this_object();
  object who = this_player();
  object lingfu;
  if (me->is_busy() || me->is_fighting())
    return notify_fail("他正忙着呢！\n");
  if (who->is_busy() || who->is_fighting())
    return notify_fail("你正忙着呢！\n");

  if ((int)who->query("obstacle/number") != 8 ||
      present("lingfu",who))
  {
    command ("shake");
    command("sigh");
    command("say 我看你还是自己慢慢琢磨吧！");
    return 1;
  }

  lingfu = new ("/d/qujing/baigudong/obj/lingfu");
  lingfu->move(me);
  command("hehe");
  command("give "+who->query("id")+" lingfu");
  who->set_temp("obstacle/baigudong_lingfu_getted",1);
  destruct (me);
  return 1;
}

int accept_fight (object ob)
{
  tell_object(ob, "这里可不好动手！\n");
  return 0;
}

int accept_kill(object ob)
{
  tell_object(ob, "这里可不好动手！\n");
  return 0;
}	