inherit "/d/qujing/npc/xiaoyao";
void create()
{
  ::create();
  set_name("骷髅兵", ({"kulou bing","bing"}));
  set("gender", "男性");
  set("age", 30);
  set("attitude","aggressive");
  set("chat_chance",10);
  set("chat_msg",({
     "骷髅兵狠狠的说，我被人吃了才变成这样的，我也要吃别人！\n",
     "骷髅兵叫到，我真是冤枉啊！\n",
     "骷髅兵幽幽的叹了一口气，唉，什么时候才能重回人世！\n",
     "骷髅兵嘿嘿冷笑两声，今天叫你来得去不得！\n",
  }));
}

