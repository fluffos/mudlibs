#include <ansi.h>
inherit NPC;
void create()
{
  set_name("黑面山神", ({"heimian shanshen", "shanshen"}));
  set("gender", "男性");
  set("age", 70);
  set("attitude", "friendly");
  set("combat_exp", 730000);
  set("per", 20);
  set("max_sen",1800);
  set("max_gee",1800);
  set("max_gin",1800);
  set("force",800);
  set("max_force",800);
  set("max_mana",1280);
  set("force_factor",60);
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void announce_success (object who)
{
  int dx,qn;
  if ((int)who->query("obstacle/number") != 8)
    return;
  if (who->query("obstacle/baigudong") == "done")
  {
    message_vision(HIY"黑面山神对$N一拱手，又慢慢消失于山壁中！\n" NOR,who);
    return;
  }

  if (!who->query_temp("obstacle/baigudong_nuzi_killed") ||
      ! who->query_temp("obstacle/baigudong_furen_killed") ||
      ! who->query_temp("obstacle/baigudong_gonggong_killed"))
    return;
  dx = random(1800);
  dx += 18000;
  qn = dx/3;
  who->set("obstacle/number",9);
  who->set("obstacle/baigudong","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  command("chat "+who->query("name")+"白骨洞诛灭白骨精，为四方百姓造福！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed baigujing on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}