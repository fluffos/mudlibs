inherit SMALLROOM;
inherit SANDROOM;
void create ()
{
  set ("short", "山石路");
  set ("long", @LONG
烈阳当头熊熊,山路颠簸不平，偶闻惊鸟声，恐有多事端。
近观路有零星白骨，远望难见人烟，让人越走越心慌，只想快快
走出这片地方。
LONG);
  set("outdoors", __DIR__"");
  set("exits", ([
    "northeast": __DIR__"sroad5",
    "northup"   : __DIR__"sroad7",
  ]));
  setup();
}

