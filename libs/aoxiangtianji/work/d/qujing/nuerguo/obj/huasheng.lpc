#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
string *names = ({
  HIR"油炸花生"NOR,
  RED"炒花生"NOR,
  HIW"煮花生"NOR,
  WHT"五香花生"NOR,
  HIY"烘花生"NOR,
  HIG"卤花生"NOR,
  HIB"盐水花生"NOR,
  HIM"细糖花生"NOR,
});
string *e_n = ({
  "youza ",
  "cao ",
  "zhu ",
  "wuxiang ",
  "hong ",
  "lu ",
  "yanshui ",
  "xitang ",
});

void create()
{
  int i;
  i = random(sizeof(names));
  set_name(names[i],
          ({e_n[i] + "huasheng", "hua sheng", "sheng", "peanut"}));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一包花生。\n");
    set("unit", "包");
    set("value", 90);
    set("food_remaining", 10);
    set("food_supply", 9);
  }

}