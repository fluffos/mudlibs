inherit ITEM;
void create()
{
  set_name("水桶", ({ "shui tong", "shuitong", "tong" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "个");
    set("long", "这是一个木制的水桶，上面系着根长长的绳子，是用来打水的。\n");
    set("value", 0);
  }

}

void init()
{
  add_action("do_drink", "drink");
}

int do_drink(string arg)
{
  string fill_id;
  object ob = this_object();
  object me = this_player(1);

  if (!arg || !id(arg))
    return 0;

  if (!present(ob,me))
    return 0;

  fill_id = ob->query("filled");
  if (!stringp(fill_id))
    return 0;

  if((int)me->query("water")*100 > (int)me->max_water_capacity()*90)
    return notify_fail("你再喝，肚子都撑爆炸了！\n");

  if (fill_id != me->query("id") ||
      (string)me->query_temp("obstacle/nuerguo0") != "stomachache" ||
      (string)me->query_temp("obstacle/nuerguo1") != "asked")
  {
    message_vision("$N抱起水桶就是一阵牛饮，完后抹抹嘴，长出了口气，“真是痛快！”",me);
    return 1;
  }

//  ob->delete("filled");
  me->set("water", me->max_water_capacity());
  message_vision ("$N捧起水桶开始喝水，一股凉意流进$N的体内，$N的肚子里动了一下。\n",me);
  if(random(8))
    message_vision ("\n$N奋力张了张嘴，想咳出什么，可什么都没咳出来。\n",me);
  else
  {
    message_vision ("\n$N猛咳了几下，嘴里呛出一些淡黄色的水！\n",me);
    message_vision("$N喘了口气，脸上不禁露出了微笑，看来治好！\n",me);
    me->delete_temp("obstacle/nuerguo0");
    me->delete_temp("obstacle/nuerguo1");
    me->set_temp("obstacle/nuerguo2","cured");
  }

  return 1;
}

