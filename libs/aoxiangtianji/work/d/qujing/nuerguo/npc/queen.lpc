#include <ansi.h>
#define NAME "西梁披霜仙后"
inherit NPC;
void create()
{
  set_name(NAME, ({"xiliang xianhou", "queen"}));
  set("title", "晨曦女神");
  set("gender", "女性");
  set("age", 23);
  set("long", "西梁披霜仙后晨曦女神。\n");
  set("combat_exp", 1000000);
  set("daoxing", 1000000);
  set("force", 900);
  set("max_force", 900);
  set("force_factor", 10);
  setup();
  carry_object("/obj/cloth/pinkskirt")->wear();
  carry_object("/d/obj/weapon/sword/feijian")->wield();
}

void announce_success(object who)
{
  int dx, qn;
  if ((int)who->query("obstacle/number") != 16 ||
      (string)who->query("obstacle/nuerguo") == "done")
    return;
  dx = random(2500);
  dx += 25000;
  qn = dx/3;

  who->set("obstacle/number",17);
  who->set("obstacle/nuerguo","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  command("chat " + who->query("name") + "顺利闯过西行一关！");
  command("chat 西梁上下奔走相告！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed nuerguo on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  message_vision (HIY NAME+"在一阵白雾中徐徐消失。\n" NOR,who);
  return;
}