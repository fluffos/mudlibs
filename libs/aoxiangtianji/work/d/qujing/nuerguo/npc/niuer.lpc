#define NAME "牛二先生"
inherit NPC;
void create()
{
  set_name(NAME, ({"niu er","niuer xiansheng","daoshi"}));
  set("gender", "男性" );
  set("age", 53);
  set("title", "如意真仙");
  set("long", "牛二先生是牛魔王的弟弟。不过他一向不喜欢别人叫他\n牛二先生，而喜欢被叫作如意先生。");
  set("class","taoist");
  set("combat_exp", 1500000);
  set("daoxing", 1800000);
  set("attitude", "peaceful");
  set("no_ji",1);

  set_skill("force", 180);
  set_skill("spells", 180);
  set_skill("dodge", 180);
  set_skill("unarmed", 180);
  set_skill("parry", 180);
  set_skill("whip", 180);

  set_skill("wuxiangforce",180);
  set_skill("dao",180);
  set_skill("jindouyun",180);
  set_skill("puti-zhi",180);
  set_skill("wuwei-fuchen", 180);

  map_skill("force","wuxiangforce");
  map_skill("spells","dao");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("whip","wuwei-fuchen");
  map_skill("parry","wuwei-fuchen");
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "danran" :),
    (: perform_action, "qingxin" :),
    (: cast_spell, "light" :),
  }) );

  set("per", 25);
  set("str", 25);
  set("spi", 25);

  set("max_kee", 4000);
  set("max_sen", 4000);
  set("force", 5000);
  set("max_force", 2600);
  set("mana", 5000);
  set("max_mana", 2600);
  set("force_factor",130);
  set("mana_factor",130);

  set("no_ji",1);
  set("inquiry", ([
    "name": "我是牛魔王的弟弟，别人叫我如意先生。\n",
    "如意先生": "如意，如意，我有时候常常治一些肚子不舒服的毛病。\n",
    "肚子": "肚子胀，肚子大，肚子痛我都可以试一试。\n",
  ]));
  setup();
  carry_object("/obj/cloth/taiji-cloth")->wear();
  carry_object("/d/obj/weapon/whip/fuchen")->wield();
}