inherit SMALLROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "迷宫出口");
  set ("long", @LONG
突然无数棵绿树丛中出现了一个豁口，外面似乎是一条大路。
你心中一喜，总算从迷宫里走出来了。
LONG);
  set("exits", ([
    "westup" : __DIR__"shanpo",
  ]));
  set("outdoors", __DIR__"");
  setup();
}

int valid_leave (object me, string dir)
{
  me->set("startroom","/d/city/nkezhan");
  me->set_temp("lost_in_greenyard",0);
  me->set_temp("out_of_greenyard",0);
  return 1;
}