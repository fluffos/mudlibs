#include <room.h>
inherit BIGROOM;
inherit HILLROOM;
inherit TAOISTROOM;
void create ()
{
  set ("short", "庵内");
  set ("long", @LONG
虽说是道观，聚仙庵内供的既不是太上老君，也不是道家诸
仙，而是一口井(well)。井台上刻有三个大字：“落胎泉”。
一老道正坐在井台边闭目修炼。
LONG);
  set("item_desc",([
      "well":"一口深井，井架上挂着一只吊桶，用来打(water/dashui)水。 \n",
  ]));
  set("exits", ([
    "out" : __DIR__"juxianan",
  ]));
  create_door("out","庵门","enter",DOOR_CLOSED);
  set("objects", ([
     __DIR__"npc/niuer" : 1,
     __DIR__"obj/shuitong" : 1,
  ]));
  setup();
}

void init()
{
  add_action("do_fill", ({"dashui","water"}));
}

int do_fill(string arg)
{
  string fill_id;
  object niuer;
  object shuitong;
  object me = this_player();

  if (!arg || (arg != "水桶" && arg != "shuitong" && arg != "shui tong"))
    return notify_fail("你要干什么？\n");
  shuitong = present(arg,me);
  if (!objectp(shuitong) || shuitong->query("id") != "shui tong" || userp(shuitong))
    return notify_fail("你身上哪来的水桶？\n");

  fill_id = (string)shuitong->query("filled");
  if (stringp(fill_id))
  {
    if (fill_id == me->query("id"))
      return notify_fail("你已经用水桶打好了水！\n");
    else
      return notify_fail("水桶中有水！\n");
  }

  if (me->query_temp("handing") != shuitong)
    return notify_fail("你必须拿起水桶，才可以打水啊！\n");

  if ((string)me->query_temp("obstacle/nuerguo0") != "stomachache")
    return notify_fail("你有这个必要吗？\n");
  if (me->query_temp("obstacle/nuerguo1") != "asked")
    return notify_fail("你有这个必要吗？\n");

  niuer = present("niu er", this_object());
  if (objectp(niuer) && !playerp(niuer))
    return notify_fail("牛二急忙上前喊道，你要干什么？看来他不让你打水！\n");

  message_vision("$N用绳子把水桶扔到了井中，不一会儿就打满了水，慢慢的把水桶拉了上来！\n",me);
  me->command("sweat");
  shuitong->set("filled", me->query("id"));
  return 1;
}