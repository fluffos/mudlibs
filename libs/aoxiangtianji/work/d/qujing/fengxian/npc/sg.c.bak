inherit NPC;
void create()
{
  set_name("上官郡主", ({"shangguan junzhu", "junzhu", "zhu"}));
  set("title", "凤仙郡");
  set("long", "天竺国凤仙郡的一郡之侯。\n");
  set("gender", "男性");
  set("age", 50);
  set("per", 25);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 200000);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set("max_gin",800);
  set("max_kee",800);
  set("max_sen",800);
  set("max_force",1000);
  set("max_mana",1000);
  set("force_factor",120);
  set("inquiry", ([
    "name" : "老夫乃凤仙郡侯，上官乃本郡之官姓。",
    "上官" : "老夫乃凤仙郡侯，上官乃本郡之官姓。",
    "here" : "此乃天竺国凤仙郡，因久旱无雨急寻法师以祭雨求雨祈雨救吾军民也。",
  ]));
  setup();
  carry_object("/obj/cloth/choupao")->wear();
  carry_object("/d/obj/weapon/blade/fengdao")->wield();
}
void init ()
{
  object me = this_object();
  object who = this_player();
  if (!playerp(who))
    return;
  if (who->query("obstacle/fengxian")=="done")
  {
    message_vision ("$N连忙对$n翻身一拜：多谢！\n",me,who);
    return;
  }
  if (who->query("obstacle/number") != 30)
    return;
  message_vision ("$N说道：多少大师前来凤仙郡救济灾民，"+
                  "去各个庙宇道场祭坛，都尚未有果。\n",me);
  message_vision ("$N轻叹了一口气。\n",me);
  return;
}
void check_player (object who)
{
  object me = this_object();

  if (!who || !me || environment(me) != environment(who))
    return;
  if (who->query("obstacle/number") != 30 ||
      who->query("obstacle/fengxian") == "done" ||
      !who->query_temp("obstacle/fengxian_donated") ||
      who->query_temp("obstacle/fengxian_ketou") < 9 ||
      who->query_temp("obstacle/fengxian_zhanbai") < 9 ||
      who->query_temp("obstacle/fengxian_nianxiang") < 9)
    return;
  message_vision ("门外走来一官人，看了$N一眼。\n",who);
  message_vision ("官人对$N一拜说道：方才天上狂风大作，电闪雷鸣，"+
                  "果然一场好雨。\n",me);
  message_vision ("\n官人退下。\n",me);
  command ("ah");
  command ("thank "+who->query("id"));
  call_out ("announce_success",1,who);
}
void announce_success (object who)
{
  int dx, qn;
  if (who->query("obstacle/number") != 30 ||
      who->query("obstacle/fengxian") == "done" ||
      !who->query_temp("obstacle/fengxian_donated") ||
      who->query_temp("obstacle/fengxian_ketou") < 9 ||
      who->query_temp("obstacle/fengxian_zhanbai") < 9 ||
      who->query_temp("obstacle/fengxian_nianxiang") < 9)
    return;

  dx = random(3600);
  dx += 36000;
  qn = dx/3;
  who->set("obstacle/number",31);
  who->set("obstacle/fengxian","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  who->delete_temp("obstacle/fengxian_donated");
  who->delete_temp("obstacle/fengxian_ketou");
  who->delete_temp("obstacle/fengxian_zhanbai");
  who->delete_temp("obstacle/fengxian_nianxiang");
  command("chat "+who->query("name")+"凤仙郡劝善施霖，救得饥民千千万万！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed fengxian on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}
