inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "路口");
  set ("long", @LONG
祭赛国中非常的繁华，路周的楼台高耸，云雾缤纷。只见那三街
六市，货殖通财，来往人等衣冠隆重，足显民富豪华。
LONG);
  set("objects", ([
    sprintf("/obj/npc/shusheng%d",1+random(3)) : 1,
    "/obj/npc/qiaofu" : 1,
  ]));
  set("outdoors", 1);
  set("exits", ([
    "west" : __DIR__"westgate",
    "east" : __DIR__"westmarket",
    "south" : __DIR__"west1",
  ]));
  setup();
}