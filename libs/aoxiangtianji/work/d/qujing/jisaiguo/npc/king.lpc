inherit NPC;
void create()
{
  set_name("祭赛国国王", ({"jisai guowang", "guowang", "king"}));
  set("gender", "男性");
  set("age", 30);
  set("long", "祭赛国国王，看起来英明神武的样子。\n");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("per", 25);
  set("str", 25);
  set("combat_exp", 15000);
  set("daoxing", 30000);
  set_skill("unarmed", 75);
  set_skill("dodge", 75);
  set_skill("blade", 75);
  set_skill("parry", 75);
  set_skill("force", 75);
  set("force", 700);
  set("max_force", 700);
  set("force_factor", 10);
  set("max_kee", 800);
  set("max_sen", 800);
  set("max_mana", 30);
  set("mana", 30);
  setup();
  carry_object("/d/obj/armor/cloth/longpao")->wear();
}

int accept_object(object me,object ob)
{
  object who;
  me=this_object();
  who=this_player();
  if (ob->query("id")=="shu tie" )
  {
    if (who->query("obstacle/number") != 20)
    {
      command("say 多谢，不过，这东西对我没有什么用！\n");
      return 0;
    }
    if(who->query("obstacle/jisaiguo")=="done")
    {
      command("say "+RANK_D->query_respect(who)+ "已替朕取回了佛宝，真是辛苦了！\n");
      return 0;
    }

    if(who->query_temp("obstacle/jisaiguo")=="allow")
    {
      command("say " +RANK_D->query_respect(who)+ "还没起身吗？\n");
      return 0;
    }

    if(ob->query("owner") == who->query("id"))
    {
      command("say 原来如此，看来朕错怪了金光寺的僧人了。\n");
      command("say " + RANK_D->query_respect(who) +
              "满身的好武艺，不如替朕把佛宝取回，造福百姓。\n");
      who->set_temp("obstacle/jisaiguo", "allow");
      call_out("destroy", 1, ob);
      return 1;
    }

    command("say 朕已知道了，不劳"+RANK_D->query_respect(who)+ "操心了！\n");
    call_out("destroy", 1, ob);
    return 1;
  }

  if(ob->query("id")=="tooth")
  {
    if(ob->query("owner") != who->query("id"))
    {
      command("say 什么东西，朕不要它！\n");
      return 0;
    }

    if( who->query("obstacle/jisaiguo")=="done")
    {
      command("say 又劳" +RANK_D->query_respect(who)+ "了，祝一路顺风。\n");
      return 0;
    }

    call_out("announce_success", 3, who);
    call_out("destroy", 1, ob);
    return 1;
  }

  return 0;
}

void destroy(object ob)
{
  if (ob)
    destruct(ob);
  return;
}

void announce_success(object who)
{
  int dx, qn;

  if (!who)
    return;
  if (who->query("obstacle/number") != 20 ||
      who->query("obstacle/jisaiguo") == "done")
    return;

  who->set("obstacle/number",21);
  who->set("obstacle/jisaiguo","done");
  who->delete_temp("obstacle/jisaiguo");
  dx = random(2800);
  dx += 28000;
  qn = dx/3;
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  command("chat "+who->query("name")+"替朕取回佛宝舍利子，为祭赛百性造福，真侠义心肠也！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed jisai on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
}

