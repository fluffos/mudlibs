#include <ansi.h>
inherit NPC;
void create()
{
   set_name("木叉行者", ({ "mucha xingzhe", "mucha", "xingzhe" }));
   set("long","观音菩萨座下徒弟。");
   set("gender", "男性");
   set("age", 35);
   set("attitude", "peaceful");
   set("max_kee", 5000);
   set("max_gin", 5000);
   set("max_sen", 5000);
   set("force", 4000);
   set("max_force", 2000);
   set("force_factor", 145);
   set("max_mana", 3000);
   set("mana", 6000);
   set("mana_factor", 150);
   set("combat_exp", 20000000);
   set("daoxing",150000000);
   setup();
}

void announce_success (object who)
{
  int dx, qn;
  if ((int)who->query("obstacle/number") != 5)
    return;

  if ((string)who->query("obstacle/liusha") == "done")
    return;

  dx = random(1800);
  dx += 18000;
  qn = dx/3;

  who->set("obstacle/number",6);
  who->set("obstacle/liusha","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  command("chat " + who->query("name")+"流沙河收服卷帘大将，同往西天取经！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed liusha on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}