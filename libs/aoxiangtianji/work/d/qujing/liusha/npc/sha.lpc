//Cracked by Roath
inherit NPC;
#include <ansi.h>
void create()
{
  set_name("妖怪", ({"yao guai","yao","guai"}));
  set("long","他本是卷帘大将，因蟠桃会失手打破玻璃盏，被贬到下界。\n");
  set("gender", "男性");
  set("age", 23);
  set("per",30);
  set("combat_exp", 2000000+random(400000));
  set("daoxing", 2000000+random(400000));
  set("per", 30);
  set("str", 30);
  set("spi", 30);
  set("dex", 30);
  set("max_kee", 4500);
  set("kee",4500);
  set("force_factor",120);
  set("max_sen", 4500);
  set("env/wimpy",30);
  set("sen",4500);
  set("force", 4200);
  set("max_force", 2400);
  set("max_mana", 2400);
  set("mana", 4500);
  set("no_ji",1);

  set_skill("force", 190+random(50));
  set_skill("spells", 190+random(50));
  set_skill("dodge", 190+random(50));
  set_skill("unarmed", 190+random(50));
  set_skill("parry", 190+random(50));
  set_skill("staff", 190+random(50));

  set_skill("lotusforce", 190+random(50));
  set_skill("buddhism",190+random(50));
  set_skill("ghost-steps", 190+random(50));
  set_skill("jienan-zhi", 190+random(50));
  set_skill("lunhui-staff", 190+random(50));
  map_skill("force", "lotusforce");
  map_skill("spells", "buddhism");
  map_skill("dodge", "ghost-steps");
  map_skill("unarmed", "jienan-zhi");
  map_skill("staff", "lunhui-staff");
  map_skill("parry", "lunhui-staff");
  setup();
  carry_object("/d/qujing/liusha/obj/staff")->wield();
  carry_object("/obj/cloth/zhanpao")->wear();
}

int accept_fight (object ob)
{
  kill_ob (ob);
  return 1;
}

void kill_ob (object ob)
{
  set_temp("no_return",1);
  set_temp("my_killer",ob);
  set_leader(ob);
  ::kill_ob(ob);
  call_out ("checking",3,this_object());
  call_out ("back",5,this_object());
}

void checking(object me)
{
  object ob=query_temp("my_killer");
  object where = environment(me);
  object room = load_object("/d/qujing/liusha/riverside");
  if( present(ob,where) )
  {
    message_vision (HIY"\n你忽然感觉到一阵胸闷，急抽身向外走！\n",me);
    message_vision ("你和$N同时从水面上跳了出来！\n"NOR,me);
    me->move(room);
    ob->move(room);
  }

  return;
}

void back(object me)
{
  object where = environment(me);
  object room = load_object("/d/qujing/liusha/cave");
  if( me->is_fighting() )
    call_out("back",1,me);
  if( ! where || where->query("short") != "洞内" )
  {
    message_vision(HIR"$N大喝一声：有本事，咱们水底下见。\n",me);
    message_vision("只见$N虚晃一招，跳入水中。\n"NOR,me);
    me->move(room);
    call_out("checking",2,me);
  }

  return;
}

void destruct_me (object me)
{
  destruct (me);
}

void die()
{
  object me,ob,here, yudi;
  string str;

  me = this_object();
  ob = me->query_temp("my_killer");
  if (objectp(ob) &&
      ob == me->query_last_damage_from() &&
      (int)ob->query("obstacle/number") == 5)
  {
    yudi=new(__DIR__"yudi");
    str = HIW"\n忽然天上传来木叉行者的声音。\n"NOR;
    str += "$N" HIW"一回头，却发现$n早已消失的无影无踪。\n"NOR;
    message_vision (str,ob,me);
    here = environment(ob);
    yudi->move(here);
    yudi->announce_success(ob);
    destruct(yudi);
  }

  destruct(me);
  return;
}

void unconcious ()
{
  die ();
}

