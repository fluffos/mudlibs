inherit NPC;
void create()
{
  set_name("白龙马", ({"bailong ma", "horse"}));
  set("race", "野兽");
  set("age", 10);
  set("combat_exp", 200000);
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
  set("verbs", ({ "bite"}));
  set("ride/msg", "骑在");
  set("ride/dodge", 8+random(10));
  set_temp("apply/attack", 40);
  set_temp("apply/armor", 40);
  setup();
}

