inherit SMALLROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "黑洞");
  set ("long", @LONG
一个黑乎乎的泥洞，里面尽是些稀泥。还有些腐烂的草木。
LONG);
  set("exits", ([
    "up": __DIR__"grass",
  ]));
  setup();
}

void init()
{
  add_action("do_push","push");
}

int do_push(string arg)
{
  object here = this_object();
  object me=this_player();

  if( ! arg || arg !="grass" )
    return notify_fail("你要推开什么?\n");

  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (here->query("exits/down"))
    return notify_fail("你碰了一手的烂泥，哈哈！！\n");
  if (random(4) == 0)
  {
    set("exits/down",__DIR__"jiandi10");
    remove_call_out("close");
    call_out("close", 5, here);
    tell_object(me,"你推开一丛杂草，意外发现了一个地方。\n");
    me->start_busy(2);
    return 1;
  }

  else
  {
    write("你碰了一手的烂泥，哈哈！！\n");
    me->start_busy(2);
    return 1;
  }
}

void close(object room)
{
  message("vision","风一吹，又把出口堵上了。\n", room);
  room->delete("exits/down");
  return;
}