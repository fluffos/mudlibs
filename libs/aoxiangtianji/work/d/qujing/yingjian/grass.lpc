inherit SMALLROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "草丛");
  set ("long", @LONG
这里到处都是草，有的草(grass)比人还要高，人在其间根本
看不到外面。听说这些草从里面经常会出现一些野兽什么的。
LONG);
  set("exits", ([
    "northeast": __DIR__"lakeside3",
  ]));
  setup();
}

void init()
{
  add_action("do_push","push");
}

int do_push(string arg)
{
  object here = this_object();
  object me=this_player();

  if( ! arg || arg !="grass" )
    return notify_fail("你要推开什么?\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (here->query("exits/down"))
    return notify_fail("你碰了一手的烂泥，哈哈！！\n");

  if (random(4) == 0)
  {
    set("exits/down",__DIR__"cave");
    remove_call_out("close");
    call_out("close", 5, here);
    tell_object(me,"你推开一丛杂草，意外发现了一个地方。\n");
    me->start_busy(2);
    return 1;
  }

  else
  {
    write("你碰了一手的烂泥，哈哈！！\n");
    me->start_busy(2);
    return 1;
  }
}

void close(object room)
{
  message("vision","风一吹，又把出口堵上了。\n", room);
  room->delete("exits/down");
}

