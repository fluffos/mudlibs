inherit NPC;
void create()
{
   set_name("水妖", ({ "shui yao", "yao"}));
   set("gender", "男性" );
   set("age", 35);
   set("long","盘踞在水下的老妖怪。\n");
   set("max_kee",3000);
   set("max_sen", 3000);
   set("max_force",1500);
   set("force",2800);
   set("force_factor", 80);
   set("max_mana",1500);
   set("mana",2800);
   set("force_factor", 80);
   set("combat_exp", 900000);
   set("daoxing", 900000);
   set("attitude","aggressive");
   set_skill("unarmed", 120);
   set_skill("dragonfight", 120);
   set_skill("dodge", 120);
   set_skill("dragonstep", 120);
   set_skill("parry", 120);
   set_skill("hammer", 120);
   set_skill("huntian-hammer", 120);
   set_skill("force", 120);
   set_skill("dragonforce", 120);
   set_skill("spells",120);
   set_skill("seashentong", 120);
   map_skill("spells", "seashentong");
   map_skill("force", "dragonforce");
   map_skill("unarmed", "dragonfight");
   map_skill("hammer", "huntian-hammer");
   map_skill("dodge", "dragonstep");
   set("chat_chance_combat", 30);
   set("chat_msg_combat", ({
      (: cast_spell, "water" :),
   }) );
   setup();
   carry_object("/obj/cloth/zhanpao")->wear();
   carry_object("/d/qujing/obj/weapon/babao-hammer")->wield();
}

void kill_ob (object ob)
{
  command("exert powerup");
  ::kill_ob(ob);
}