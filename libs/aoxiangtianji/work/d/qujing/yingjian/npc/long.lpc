inherit NPC;
#include <ansi.h>
void create()
{
  set_name("小白龙", ({"bai long","long","dragon"}));
  set("long","他本是西海龙王敖闰之子，因犯了逆仵之罪，被贬下人间。\n");
  set("gender", "男性");
  set("age", 23);
  set("per", 30);
  set("str", 30);
  set("spi", 30);
  set("dex", 30);
  set("combat_exp", 1500000);
  set("daoxing", 1500000);
  set("max_kee", 3500);
  set("kee",3500);
  set("max_sen", 3500);
  set("sen",3500);
  set("force", 3000);
  set("max_force", 1800);
  set("max_mana", 1800);
  set("mana", 3200);
  set("force_factor", 90);
  set("mana_factor", 90);
  set("env/wimpy",50);
  set("no_ji",1);
  set_skill("unarmed", 150);
  set_skill("dodge", 150);
  set_skill("force", 150);
  set_skill("parry", 150);
  set_skill("spells", 150);
  set_skill("seashentong", 150);
  set_skill("dragonfight", 150);
  set_skill("dragonforce", 150);
  set_skill("dragonstep", 150);
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("dodge", "dragonstep");
  setup();
  carry_object("/d/obj/armor/cloth/longpao")->wear();
}

int accept_fight (object ob)
{
  kill_ob (ob);
  return 1;
}

void kill_ob (object ob)
{
  set_temp("no_return",1);
  set_temp("my_killer",ob);
  ::kill_ob(ob);
  call_out ("move_to_cave",1,this_object());
}

void move_to_cave (object me)
{
  string *names = ({
    "小红鱼",
    "小青鱼",
    "小蓝鱼",
    "小白鱼",
    "小花鱼",
  });
  string *ids = ({
    "xiao hong yu",
    "xiao qing yu",
    "xiao lan yu",
    "xiao bai yu",
    "xiao hua yu",
  });
  int i = random(sizeof(names));
  tell_room(environment(me),HIY"小白龙摇身一变，变得和小鱼苗一模一样。\n"NOR);
  tell_room(environment(me),"小白龙逃跑失败.....\n");
  me->set_name(HIY+names[i]+NOR,({ids[i],"fish", "yu"}));
}

void die ()
{
  object pusa;
  object me = this_object();
  object ob = me->query_temp("my_killer");
  if (!objectp(ob)
     || ob != me->query_last_damage_from()
     || (int)ob->query("obstacle/number") != 1)
  {
    ::die();
    return;
  }

  message_vision (HIY"只见$N" HIY"嘶叫一声，冲天而起，原来是条真龙。\n"NOR,me);
  pusa = new ("/d/qujing/yingjian/npc/pusa");
  pusa->move(environment(me));
  pusa->announce_success (ob);
  destruct (pusa);
  return;
}

void unconcious ()
{
  die ();
}