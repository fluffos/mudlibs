inherit NPC;
#include <ansi.h>
void create()
{
  set_name("揭谛", ({ "jie di"}));
  set("title", "观音侍者");
  set("long", @LONG
观音菩萨的侍者。
LONG);
   set("gender", "男性");
   set("age", 35);
   set("attitude", "peaceful");
   set("class", "bonze");
   set("str",24);
   set("per",100);
   set("max_kee", 5000);
   set("max_gin", 5000);
   set("max_sen", 5000);
   set("force", 4000);
   set("max_force", 2000);
   set("force_factor", 145);
   set("max_mana", 3000);
   set("mana", 6000);
   set("mana_factor", 150);
   set("combat_exp", 2000000);
   setup();
   carry_object("/obj/cloth/sengpao")->wear();
}

void announce_success (object who)
{
  int dx,qn;
  string msg;
  object horse = new("/d/qujing/yingjian/obj/horse");
  object here;
  object me = this_object();
  here=environment(who);
  if ((int)who->query("obstacle/number") != 1)
    return;

  if ((string)who->query("obstacle/yj") == "done")
    return;

  dx = random(1200);
  dx += 12000;
  qn = dx/3;
  who->set("obstacle/number",2);
  who->set("obstacle/yj","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  msg = HIY"一片祥云过后，$N" HIY"出现在$n" HIY"面前！\n\n"NOR;
  msg += HIY"只听$N怒斥一声：“玉龙三太子，还不拜过取经人”！\n"NOR;
  msg += HIY"忽然白龙扑倒在地，变成了一匹白马。\n"NOR;
  message_vision (msg,me,who);
  horse->move(here);
  command(sprintf("chat %s鹰愁涧降服白龙马！",who->name(1)));
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed yj on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}