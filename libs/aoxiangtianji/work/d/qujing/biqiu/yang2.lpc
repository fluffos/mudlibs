inherit "/d/qujing/biqiu/yang1";
void create ()
{
  ::create();
  set("exits", ([
    "west"    : __DIR__"yang1",
    "southwest"    : __DIR__"yang3",
    "southeast"    : __DIR__"yang4",
    "east"    : __DIR__"zhuang",
  ]));
}

void init ()
{
  add_action ("do_turn","turn");
  add_action ("do_push","push");
}

int do_turn (string arg)
{
  object who = this_player();
  int times = who->query_temp("obstacle/biqiu_turns");
  if (! arg ||
      (arg != "left" &&
      arg != "right"))
    return notify_fail ("你象无头苍蝇一样围着树转了起来。\n");

  if (arg == "left")
  {
    message_vision ("$N围着树往左转了一圈。\n",who);
    if (times < 3)
      times++;
    else
      times = 0;
  }

  if (arg == "right")
  {
    message_vision ("$N围着树往右转了一圈。\n",who);
    if (times >= 3 && times < 6)
      times++;
    else
      times = 0;
  }

  who->set_temp("obstacle/biqiu_turns",times);
  return 1;
}

int do_push (string arg)
{
  int n;
  object who = this_player();
  object ridee;
  int times = who->query_temp("obstacle/biqiu_turns");
  ridee = who->query_temp("is_riding");
  if (objectp(ridee))
    return notify_fail("你还是先下了坐骑吧！\n");

  if (! arg ||
      arg != "tree")
    return notify_fail ("你伸出手想推什么。\n");

  message_vision ("$N伸出手将树用力一推。\n",who);
  n = 50-who->query_kar();
  if (n< 3)
    n = 3;
  if (times == 6 && random(n) == 0)
  {
    message_vision ("刹那间，一声响亮唿喇喇闪开两扇门，$N一头撞将进去。\n", who);
    who->move(__DIR__"dong");
  }

  who->set_temp("obstacle/biqiu_turns",0);
  return 1;
}

