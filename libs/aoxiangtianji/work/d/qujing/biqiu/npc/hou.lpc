inherit NPC;
void create()
{
  set_name("美后", ({ "mei hou", "hou", "queen" }));
  set("title", "比丘国");
  set("long", "一位娇俊无比，貌似观音的王后。\n");
  set("gender", "女性");
  set("age", 17);
  set("attitude", "heroism");
  set("per", 30);
  set("max_kee", 4500);
  set("max_sen", 4500);
  set("force", 4000);
  set("max_force", 2000);
  set("force_factor", 100);
  set("max_mana", 2000);
  set("mana", 4000);
  set("mana_factor", 100);
  set("combat_exp", 1800000);
  set("daoxing", 1800000);
  set_skill("force", 180);
  set_skill("spells", 180);
  set_skill("dodge", 180);
  set_skill("parry", 180);
  set_skill("unarmed", 180);
  set_skill("sword", 180);
  set_skill("moonforce", 180);
  set_skill("moonshentong", 180);
  set_skill("moondance", 180);
  set_skill("baihua-zhang", 180);
  set_skill("huifeng-sword", 180);

  map_skill("force", "moonforce");
  map_skill("spells", "moonshentong");
  map_skill("dodge", "moondance");
  map_skill("unarmed","baihua-zhang");
  map_skill("sword","huifeng-sword");
  map_skill("parry", "huifeng-sword");
  setup();
  carry_object("/obj/cloth/gongpao")->wear();
  carry_object("/d/obj/weapon/sword/snow_sword")->wield();
}

void kill_ob (object ob)
{
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

void die ()
{
  object ob = query_temp("my_killer");
  object me = this_object();
  if (objectp(ob)
    && ob == me->query_last_damage_from()
    && (int)ob->query("obstacle/number") == 25
    && (string)ob->query("obstacle/biqiu") != "done")
    ob->set_temp("obstacle/biqiu_hou",1);
  message_vision ("\n$N扑在地上现了原身，原是一只狐狸精。\n",me);
  me->set_name("狐狸精", ({"huli jing", "huli", "jing"}));
  ::die();
}

void unconcious ()
{
  die ();
}