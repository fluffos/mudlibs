inherit NPC;
void create()
{
  set_name("国丈", ({"guo zhang", "zhang"}));
  set("title", "玉面道人");
  set("gender", "男性");
  set("age", 60);
  set("attitude", "peaceful");
  set("combat_exp", 2700000);
  set("daoxing", 2700000);
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 6000);
  set("max_force", 3000);
  set("mana", 6000);
  set("max_mana", 3000);
  set("force_factor", 150);
  set("mana_factor", 150);
  set("no_ji",1);

  set_skill("force", 220 + random(50));
  set_skill("spells", 220 + random(50));
  set_skill("dodge", 220 + random(50));
  set_skill("parry", 220 + random(50));
  set_skill("unarmed", 220 + random(50));
  set_skill("staff", 220 + random(50));
  set_skill("zhenyuan-force", 220 + random(50));
  set_skill("taiyi", 220 + random(50));
  set_skill("baguazhen", 220 + random(50));
  set_skill("wuxing-quan", 220 + random(50));
  set_skill("fumo-staff", 220 + random(50));

  map_skill("force", "zhenyuan-force");
  map_skill("spells", "taiyi");
  map_skill("dodge", "baguazhen");
  map_skill("unarmed","wuxing-quan");
  map_skill("staff","fumo-staff");
  map_skill("parry", "fumo-staff");
  setup();
  carry_object("/obj/cloth/gongpao")->wear();
  carry_object("/d/qujing/biqiu/obj/staff")->wield();
}

int accept_fight (object ob)
{
  kill_ob (ob);
  return 1;
}

void kill_ob (object ob)
{
  set_temp("no_return",1);
  set_temp("my_killer",ob);
  ::kill_ob(ob);
  call_out ("move_to_cave",3,this_object());
}

void move_to_cave (object me)
{
  object where = environment(me);
  object room = load_object("/d/qujing/biqiu/dong");
  if (!me->is_fighting() ||
      ! where ||
      where->query("short") == "清华洞")
    return;

  message_vision ("\n忽然间狂风四起，天昏地暗！\n",me);
  message_vision ("等你恍恍惚惚睁开眼时，$N已无踪无影！\n",me);
  me->move(room);
}

void die()
{
  object king;
  object me = this_object();
  object ob = query_temp("my_killer");
  if (objectp(ob)
    && ob == me->query_last_damage_from()
    && (int)ob->query("obstacle/number") == 25
    && (string)ob->query("obstacle/biqiu") != "done"
    && ob->query_temp("obstacle/biqiu_hou")
    && ob->query_temp("obstacle/biqiu_xiaoer") >= 2
    && ob->query_temp("obstacle/biqiu_zuochan") >= 17)
  {
    king = new ("/d/qujing/biqiu/npc/king");
    king->move(environment(ob));
    king->announce_success (ob);
    destruct (king);
  }

  message_vision ("\n$N现了原形，竟是一只白鹿往天上慌慌张张地蹿去。\n",
                  me);
  message_vision ("天上传来南极老人的怒斥：“孽鹿！连老夫的拐杖也偷了去！\n\n",
                  me);
  destruct(me);
  return;
}

void unconcious()
{
  die();
}

