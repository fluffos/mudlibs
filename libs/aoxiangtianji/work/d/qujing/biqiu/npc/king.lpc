inherit NPC;
void create()
{
  set_name("国王", ({"guo wang", "wang", "king"}));
  set("long", "比丘国的国王，身着龙袍，头戴珍珠冠。\n");
  set("title", "比丘国");
  set("gender", "男性");
  set("age", 56);
  set("per", 25);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 200000);
  set("daoxing", 100000);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set("max_gin",800);
  set("max_kee",800);
  set("max_sen",800);
  set("max_force",1000);
  set("max_mana",1000);
  set("force_factor",120);
  setup();
  carry_object("/d/obj/armor/cloth/longpao")->wear();
}

void announce_success (object who)
{
  int dx,qn;
  if (who->query("obstacle/number") != 25 ||
      who->query("obstacle/biqiu") == "done" ||
      !who->query_temp("obstacle/biqiu_hou") ||
      who->query_temp("obstacle/biqiu_xiaoer") < 2 ||
      who->query_temp("obstacle/biqiu_zuochan") < 17)
    return;
  dx = random(3400);
  dx += 34000;
  qn = dx/3;
  who->set("obstacle/number",26);
  who->set("obstacle/biqiu","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  who->delete_temp("obstacle/biqiu_hou");
  who->delete_temp("obstacle/biqiu_xiaoer");
  who->delete_temp("obstacle/biqiu_zuochan");
  command("chat "+who->query("name")+"比丘国拯救无辜小童清华洞治服孽畜！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed biqiu on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  return;
}

