inherit NPC;
void create()
{
  set_name("蝎子精", ({ "xiezi jing", "xiezi", "jing" }));
  set("title", "琵琶洞");
  set("long", "一位艳色迷人的女妖精。\n");
  set("gender", "女性");
  set("age", 26);
  set("attitude", "heroism");
  set("per", 29);
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 5600);
  set("max_force", 2800);
  set("force_factor", 130);
  set("max_mana", 2800);
  set("mana", 5600);
  set("mana_factor", 130);
  set("combat_exp", 2200000);
  set("daoxing", 2200000);
  set("no_ji",1);

  set_skill("force", 200+random(50));
  set_skill("spells", 200+random(50));
  set_skill("dodge", 200+random(50));
  set_skill("unarmed", 200+random(50));
  set_skill("parry", 200+random(50));
  set_skill("fork", 200+random(50));

  set_skill("moonforce", 200+random(50));
  set_skill("dao", 200+random(50));
  set_skill("moondance", 200+random(50));
  set_skill("baihua-zhang", 200+random(50));
  set_skill("fengbo-fork", 200+random(50));

  map_skill("force", "moonforce");
  map_skill("spells", "dao");
  map_skill("dodge", "moondance");
  map_skill("unarmed", "baihua-zhang");
  map_skill("fork", "fengbo-fork");
  map_skill("parry", "fengbo-fork");

  setup();
  carry_object("/d/qujing/dudi/obj/cloth")->wear();
  carry_object("/d/obj/weapon/fork/sanci-fork")->wield();
}

int test_player (object who)
{
  string *names;
  string name;
  int len;
  if (! who)
    return 0;
  names = who->query_temp("apply/name");
  if (! names)
    return 0;
  if (sizeof(names) < 1)
    return 0;
  name = names[0];
  len = strlen (name);
  if (len < 1)
    return 0;
  if (name[len-2..len-1] != "鸡")
    return 0;
  return 1;
}

void disappear_me (object me)
{
  message_vision ("\n$N往外一闪，逃得无影无踪！\n",me);
  destruct (me);
}

void die ()
{
  object maoxiu;
  object me = this_object();
  object ob = query_temp("my_killer");
  message_vision ("\n$N浑身酥软趴在地上，原来是一只琵琶大小的毒蝎子。\n",me);
  message_vision ("\n天空闪过昴宿星官的影子，将蝎子拾起驾云而去。\n",me);
  if (objectp(ob) &&
      ob == me->query_last_damage_from() &&
      (int)ob->query("obstacle/number") == 17 &&
      (string)ob->query("obstacle/dudi") != "done")
  {
    maoxiu = new ("/d/qujing/dudi/npc/maoxiu");
    maoxiu->move(environment(ob));
    maoxiu->announce_success (ob);
    destruct (maoxiu);
    destruct (me);
    return;
  }
  disappear_me(me);
  return;
}

void unconcious ()
{
  die ();
}

int accept_fight(object ob)
{
  kill_ob(ob);
  return 1;
}

void kill_ob (object ob)
{
  object me = this_object();
  set_temp("my_killer",ob);
  call_out ("disappearing",1,me,ob);
  call_out ("hurting",random(5)+5,me,ob);
  ::kill_ob(ob);
}

void disappearing (object me, object ob)
{
  if (!me || !ob || environment(ob) != environment(me))
    return;
  if ((!test_player(ob)) &&
       (me->query("kee") < (me->query("max_kee")/4) ||
        me->query("sen") < (me->query("max_sen")/4)))
  {
    disappear_me(me);
  }

  call_out ("discovering",1,me,ob);
}

void hurting (object me, object ob)
{
  string *msgs = ({
    "$N将裙角一掀，抬起毒刺向$n一扎！\n",
    "$N一转身，一个倒马桩向$n刺去！\n",
    "$N跳起往$n的头上一扎！\n",
  });
  string *strs = ({
    "( $N大叫一声：好痛！ )\n",
    "( $N抱起肿起的头忍不住惨叫一声！ )\n",
    "( $N的头上立刻肿起一大块红红的脑门痈！ )\n",
  });
  int damage;
  if (!me || !ob || environment(ob) != environment(me))
    return;
  message_vision ("\n"+element_of(msgs),me,ob);

  if (! test_player(ob))
  {
    message_vision (element_of(strs),ob);
    damage = ob->query("max_kee")/(3+random(3));
    ob->receive_damage("kee",damage,me);
    ob->receive_wound("kee",damage,me);
    ob->receive_damage("sen",damage,me);
    ob->receive_wound("sen",damage,me);
  }

  else
  {
    message_vision ("只见$N发出一声鸡叫，"+
                    "$n顿时慌乱地放下裙子收起倒马桩！\n",ob,me);
  }

  remove_call_out ("hurting");
  call_out ("hurting",random(10)+10,me,ob);
}