inherit NPC;
string *names = ({
  "蝴蝶精",
  "细腰蜂精",
  "麻蚊精",
  "花姐精",
  "彩蛛精",
});
void create()
{
  set_name(element_of(names), ({"yao jing", "jing", "jing"}));
  set("gender", "女性");
  set("age", 20);
  set("combat_exp", 600000 + random(600000));
  set("daoxing", 600000 + random(600000));
  set("str", 15+random(35));
  set("spi", 15+random(35));
  set("con", 15+random(35));
  set("dex", 15+random(35));
  set("per", 20+random(35));

  set_skill("force", 100 + random(50));
  set_skill("spells", 100 + random(50));
  set_skill("dodge", 100 + random(50));
  set_skill("unarmed", 100 + random(50));
  set_skill("parry", 100+random(50));

  set_skill("huntian-qigong",100+random(50));
  set_skill("yaofa",100+random(50));
  set_skill("feiyan-zoubi",100+random(50));
  set_skill("changquan",100+random(50));

  set("max_sen",2000 + random(400));
  set("max_kee",2000 + random(400));
  set("force",2000 + random(1000));
  set("max_force",1500);
  set("mana",2000 + random(1000));
  set("max_mana",1500);
  set("force_factor", 70);
  set("mana_factor", 70);

  map_skill("force", "huntian-qigong");
  map_skill("spells", "yaofa");
  map_skill("dodge", "feiyan-zoubi");
  map_skill("unarmed", "changquan");

  set_skill("fork",100+random(50));
  set_skill("dingbo-fork",100+random(50));
  map_skill("fork","dingbo-fork");
  map_skill("parry","dingbo-fork");

  setup();
  carry_object("/d/qujing/dudi/obj/cloth")->wear();
  carry_object("/d/qujing/dudi/obj/fork")->wield();
}