#include <armor.h>
inherit CLOTH;
string *prefixs = ({
  "粉色",
  "翡红",
  "淡黄",
  "鹅黄",
  "紫花",
});
string *names = ({
  "柳絮",
  "丝绒",
  "罗纱",
  "细纱",
  "麻纱",
});
string *suffixs = ({
  "护裙",
  "战裙",
});
void create()
{
  set_name(element_of(prefixs)+element_of(names)+
           element_of(suffixs), ({"skirt", "cloth"}));
  set_weight(4000);
  if ( clonep() )
     set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("value", 200);
    set("material", "leather");
    set("armor_prop/dodge", 2);
  }

  init_cloth(8);
  set("no_sell",1);
  setup();
}

