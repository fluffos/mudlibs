inherit NPC;
void create()
{
  set_name("国王", ({"guo wang", "wang", "king"}));
  set("long", "头戴一顶冲天冠，腰束一条碧玉带，身穿一领飞龙舞凤赭黄袍。\n");
  set("title", "乌鸡国");
  set("gender", "男性");
  set("age", 46);
  set("per", 30);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set_skill("unarmed", 120);
  set_skill("dodge", 120);
  set_skill("parry", 120);
  set_skill("dragonstep",120);
  set_skill("dragonfight",120);
  map_skill("dodge","dragonstep");
  map_skill("unarmed","dragonfight");
  set("max_kee",2000);
  set("max_sen",2000);
  set("max_force",1400);
  set("max_mana",1400);
  set("force_factor",120);
  setup();
  carry_object("/d/obj/armor/cloth/longpao")->wear();
}

void announce_success()
{
  object me = this_object();
  object where = environment(me);
  string id = me->query("my_saver");
  object who;
  if (! id)
    return;
  who = present(id,where);
  if (! who)
    return;
  remove_call_out ("announce");
  call_out ("announce",5,me,who);
}

void announce(object me, object who)
{//disabled announce and reward...
  int dx,qn;
  if (who->query_temp("obstacle/wuji") != "saved")
    return;
  if ((int)who->query("obstacle/number") != 11 ||
      (string)who->query("obstacle/wuji") == "done")
    return;
  dx = random(2000);
  dx += 20000;
  qn = dx/3;

  who->set("obstacle/number",12);
  who->set("obstacle/wuji","done");
  who->add("daoxing",dx);
  who->add("potential",qn);
  who->add("obstacle/dx",dx);
  who->add("obstacle/qn",qn);
  who->delete_temp("obstacle/wuji");
  command("thank "+who->query("id"));
  command("chat "+who->query("name")+"乌鸡国救我回生，大灭妖道还我乾坤！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object(who,sprintf("你赢得了%s道行，%s点潜能！\n",
                   COMBAT_D->chinese_daoxing(dx),
                   chinese_number(qn)));
  log_file("obstacle",sprintf("%s(%s) passed wuji on %s\n",
             who->name(1), geteuid(who), ctime(time()) ) );
  who->save();
  command("follow none");
}