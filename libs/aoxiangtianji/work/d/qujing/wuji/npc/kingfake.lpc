inherit NPC;
void create()
{
  set_name("国王", ({"guo wang", "wang", "king"}));
  set("long", "头戴一顶冲天冠，腰束一条碧玉带，身穿一领飞龙舞凤赭黄袍。\n");
  set("title", "乌鸡国");
  set("gender", "男性");
  set("age", 46);
  set("per", 30);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 2000000);
  set("daoxing", 2000000);
  set("no_ji",1);

  set("max_kee", 4000);
  set("max_sen", 4000);
  set("force", 4000);
  set("max_force", 2200);
  set("force_factor", 10);
  set("max_mana", 2200);
  set("mana", 4000);
  set("mana_factor", 30);

  set_skill("unarmed", 180);
  set_skill("dodge", 180);
  set_skill("force", 180);
  set_skill("parry", 180);
  set_skill("fork", 180);
  set_skill("spells", 180);
  set_skill("seashentong", 180);
  set_skill("dragonfight", 180);
  set_skill("dragonforce", 180);
  set_skill("fengbo-fork", 180);
  set_skill("dragonstep", 180);
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("fork", "fengbo-fork");
  map_skill("parry", "fengbo-fork");
  map_skill("dodge", "dragonstep");
  setup();
  carry_object("/d/obj/armor/cloth/longpao")->wear();
}

void autokill (object me)
{
  object where = environment (me);
  object king1 = present ("guo wang 1",where);
  object king2 = present ("guo wang 2",where);
  if (me->is_fighting())
    return;
  if (!king2)
    return;
  if (king2 == me)
    king2 = king1;
  message_vision ("$N对$n大喝一声：“妖怪魔头，竟敢欺世盗名变做朕的模样！”\n", me,king2);
  message_vision ("$N与$n立刻撕打了起来！\n",me,king2);
  me->kill_ob(king2);
  king2->kill_ob(me);
}

void init ()
{
  autokill (this_object());
}

void die ()
{
  string id;
  object mykiller;
  object me = this_object ();
  object longpao = present("long pao",me);
  object where = environment (me);
  object king1 = present ("guo wang 1",where);
  object king2 = present ("guo wang 2",where);
  mykiller = me->query_last_damage_from();
  message_vision ("$N发出一声长长的哀鸣，在尘土里现了青毛狮子的原身！\n",me);
  message_vision ("\n青毛狮子瞪着琉璃盏红眼，喘着粗气。\n",me);
  me->set_name("青毛狮子", ({"blue lion", "lion"}));
  me->delete("title");
  me->delete("long");
  if (objectp(longpao))
    destruct (longpao);
  me->setup();
  me->remove_all_killer();
  me->set("kee",2800);
  me->set("sen",2800);
  call_out("destruct_me",3,me);
  if (!king2)
    return;
  if (king2 == me)
    king2 = king1;
  id = king2->query("my_saver");
  if (!objectp(mykiller))
    return;
  if (mykiller != king2 &&
      mykiller->query("id") != id)
    return;
  if (mykiller != king2 &&
      mykiller != me->query_temp("my_killer"))
    return;

  king2->announce_success();
  return;
}

void destruct_me (object me)
{
  if (objectp(me))
  {
    me->remove_all_killer();
    message_vision ("一道金光照住$N，将$N唰地一声收去。\n",me);
    message_vision ("天上远远传来文殊菩萨的笑声。\n",me);
    destruct (me);
  }

}

void kill_ob (object ob)
{
  if (playerp(ob))
    set_temp("my_killer",ob);
  ::kill_ob(ob);
}

