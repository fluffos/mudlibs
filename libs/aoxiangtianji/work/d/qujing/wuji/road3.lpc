inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "山路");
  set ("long", @LONG
高峰入云，清流见底，青林翠竹，四时俱备。猿鸟乱鸣，沉鳞竞跃，
实是欲界之仙都。
LONG);
  set("outdoors", __DIR__"");
  set("objects", ([
    __DIR__"npc/shanji" : 1,
  ]));
  set("exits", ([
    "northwest" : __DIR__"road4.lpc",
    "eastdown" : __DIR__"road2.lpc",
  ]));
  setup();
}