inherit "/d/qujing/wuji/wall";
void create()
{
  ::create();
  set("exits", ([
    "west" : __DIR__"wall",
    "east" : __DIR__"wall3",
  ]));
}

int valid_leave (object who, string dir)
{
  object shi = present ("wei shi", environment(who));
  if (dir == "west" && shi && living (shi))
      return notify_fail (shi->query("name")+"喝道：禁行！\n");
  return ::valid_leave(who, dir);
}