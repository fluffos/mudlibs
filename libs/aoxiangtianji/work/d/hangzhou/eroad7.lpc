#include <ansi.h>
inherit BIGROOM;
inherit WATERROOM;
void create()
{
  set("short", "南海海边");
  set("long", @LONG
站在海边，腥风扑面，海上浊浪滔天。这南海
海龙王不知道是否就在这海底兴风作浪？
LONG);
  set("exits", ([
    "west"     : __DIR__"eroad6",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "hangzhou");
  setup();
}

void init()
{
  add_action("do_dive","dive");
}

int do_dive()
{
  object me, zhou;
  object ridee;

  me=this_player();
  ridee = me->query_temp("is_riding");
  if ( me->is_fighting() || me->is_busy() )
    return notify_fail("你正忙着呢！\n");
  if(( !(zhou=present("bishui zhou", me))
      ||(string)zhou->query("unit")!="张")
   && (string)me->query("family/family_name")!="东海龙宫")
    return notify_fail("你一个猛子扎到水里．．．\n\n"
                       "但没多会儿就被憋得半死，只好赶紧爬上岸来。\n");
  me->start_busy(1);
  if (objectp(ridee))
  {
    if (ridee->query("under_water"))
    {
      message_vision(HIY"$N一拍$n的头，连人带马跃入水中。\n"NOR,me,ridee);
      ridee->move("/d/northsea/under1");
    }

    else
      return notify_fail("你还是先下了你的坐骑吧！\n");
  }

  else
    message_vision(HIY "$N一个猛子扎到水中，然后不见了．\n" NOR, me);
  me->move("/d/southsea/under1");
  me->start_busy(1);
  message_vision("$N潜了过来。\n",me);
  return 1;
}

