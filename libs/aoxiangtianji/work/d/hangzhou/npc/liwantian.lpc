// likexiu.c
#include <ansi.h>
inherit NPC;
void create()
{
  set_name("李晚天", ({ "li wantian", "li"}) );
  set("title", "杭州府伊");
  set("gender", "男性");
  set("age", 54);
  set("long","李晚天一身军功而成封疆大吏，一身武功自然不容轻视。\n");
  set("combat_exp", 500000);
  set("daoxing", 500000);
  set("shen_type", -1);
  set("attitude", "heroism");
  set("max_kee", 2000);
  set("max_sen", 2000);
  set("max_force", 1200);
  set("force", 2000);
  set("max_mana", 1200);
  set("mana", 2000);
  set("force_factor", 50);
  set("mana_factor", 100);
  set_skill("unarmed", 120);
  set_skill("blade", 120);
  set_skill("parry", 120);
  set_skill("dodge", 120);
  set_skill("spells", 120);
  set_skill("wuhu-blade", 120);
  set_skill("yanxing-steps", 120);
  map_skill("blade","wuhu-blade");
  map_skill("parry","wuhu-blade");
  map_skill("dodge", "yanxing-steps");
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/armor", 50);
  set_temp("apply/damage", 30);
  setup();
  carry_object("/d/obj/weapon/blade/gangdao")->wield();
  carry_object("/d/obj/armor/armor/jinjia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
  add_money("coin", 30);
}