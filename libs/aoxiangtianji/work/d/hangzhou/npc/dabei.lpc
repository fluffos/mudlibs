#include <ansi.h>
inherit NPC;
#define BOOK "/d/obj/book/jienanzhi.lpc"
string give_book();
void create()
{
  set_name("大悲尊者", ({ "dabei zunzhe", "dabei", "zunzhe" }));
  set("gender", "男性");
  set("nickname", HIY "灵隐寺住持" NOR);
  set("long", @LONG
他看上去须眉皆白，眼神却异常有神。
LONG);
  set("age", 72);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 33);
  set("int", 35);
  set("con", 38);
  set("dex", 33);
  set("max_kee", 5200);
  set("kee", 5200);
  set("max_sen", 3000);
  set("sen", 3000);
  set("force", 8000);
  set("max_force", 6000);
  set("force_factor", 230);
  set("mana", 8000);
  set("max_mana", 6000);
  set("mana_factor", 230);
  set("combat_exp", 2000000);
  set("daoxing", 2000000);
  set("score", 20000);
  set_skill("force", 280);
  set_skill("lotusforce", 280);
  set_skill("dodge", 280);
  set_skill("lotusmove", 280);
  set_skill("parry", 280);
  set_skill("jienan-zhi", 320);
  set_skill("unarmed", 320);
  set_skill("literate", 220);
  set_skill("martial-cognize", 220);
  set_skill("spells",280);
  set_skill("buddhism", 320);
  set_skill("pudu-staff",220);
  set_skill("staff", 220);
  map_skill("force", "lotusforce");
  map_skill("spells", "buddhism");
  map_skill("dodge", "lotusmove");
  map_skill("parry", "pudu-staff");
  map_skill("unarmed", "jienan-zhi");
  map_skill("staff", "pudu-staff");
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
        (: exert_function, "recover" :),
        (: exert_function, "powerup" :),
  }));
  set("inquiry",([
    "劫难指": (: give_book :),
  ]));
  set("book",1);
  set_temp("apply/damage", 120);
  set_temp("apply/unarmed_damage", 120);
  set_temp("apply/armor", 220);
  setup();
  carry_object("/obj/cloth/c-jiasha")->wear();
}

string give_book()
{
  object ubook;
  object me = this_object();
  object who = this_player();

  if (!me || !who)
    return "";
  if (who->query("family/family_name") == "南海普陀山")
  {
    if (!me->query("book"))
      return "书已经给人了，施主晚了一步！\n";
    ubook = new(BOOK);
    if (!objectp(ubook))
      return "嗯？那书怎么就不见了呢？\n";
    ubook->move(me);
    ubook->set("owner",who->query("id"));
    command("give book to " + who->query("id"));
    set("book",0);
    return "施主有心，就拿去看看吧！\n";
  }

  return "施主并非佛门中人，为何如此热衷佛门事？\n";
}

