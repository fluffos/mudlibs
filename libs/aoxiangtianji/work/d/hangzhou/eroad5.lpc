#include <ansi.h>
inherit RIVER;
void create()
{
  set("short", "宁波");
  set("long", @LONG
这里是个热闹的集镇，镇上多为出海的渔民。
这里的海边风平浪静，站在海边，远处岛屿黑点
一般，里这里的岸边并不远。这里也是乘渡船前
往南海普坨山的重要港口。渡口就在边上，有块
牌子(paizi)挂在门边。
LONG);
  set("arrive_room", "/d/nanhai/island");
  set("exits", ([
    "northwest"     : __DIR__"eroad4",
    "south" : __DIR__"eroad6",
  ]));

  set("item_desc",([
    "paizi" : HIG "\nyell boat将有渡船带你前往南海普坨山进香拜佛。\n\n"NOR,
  ]));

  set("resource/fish", ({ "/obj/fish/liyu",
                          "/obj/fish/jiyu",
                          "/obj/fish/qingyu",
                          "/obj/fish/caoyu", }));

  set("no_clean_up", 0);
  set("outdoors", "hangzhou");
  setup();
}

