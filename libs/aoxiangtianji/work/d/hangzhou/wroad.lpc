inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "大官道");
  set("long", @LONG
这条大官道宽敞干净，路上行人极多。望东，是杭州城，
望西，这通往苏州。“上有天堂，下有苏杭”，这江南
秀丽的景色，让人不禁几多留恋。
LONG);
  set("exits", ([
    "west"   : "/d/suzhou/dongmen",
    "southeast"   : __DIR__"road1",
  ]));
  set("outdoors", "hangzhou");
  setup();
}

