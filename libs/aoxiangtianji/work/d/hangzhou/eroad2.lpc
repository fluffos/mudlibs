inherit SMALLROOM;
inherit MUDDYROOM;
void create()
{
  set("short", "泥泞小路");
  set("long", @LONG
一条泥泞的小路，一直向东延伸。这里行人几乎没有了，
据说这条小路一直通往东海中。
LONG);
  set("exits", ([
    "east"     : __DIR__"eroad3",
    "west"     : __DIR__"eroad1",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "hangzhou");
  setup();
}

