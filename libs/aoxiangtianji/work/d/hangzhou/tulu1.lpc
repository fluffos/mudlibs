inherit BIGROOM;
inherit WATERROOM;
void create()
{
  set("short", "土路");
  set("long", @LONG
路旁一条小溪。溪水哗哗地流着，不时有鱼儿(fish)跃出水面。
溪旁几各男孩正低着头专心在钓鱼。
LONG);
  set("exits", ([
    "southwest" : __DIR__"shanlu5",
    "east"      : __DIR__"tulu2",
  ]));
  set("objects", ([
     sprintf("/obj/npc/boy%d",1+random(3)) : 1,
  ]));
  set("item_desc", ([
    "fish" : "“哗”一条大鱼跃水而出，“噗”的一声"
             "又掉回水里。渐得男孩一身水。\n",
  ]));
  set("resource/fish", ({ "/obj/fish/liyu",
                          "/obj/fish/jiyu",
                          "/obj/fish/qingyu",
                          "/obj/fish/caoyu", }));
  set("outdoors", "hangzhou");
  setup();
}

