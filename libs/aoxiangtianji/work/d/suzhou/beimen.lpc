inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "北门");
  set("long", @LONG
这是苏州府的北城门。出门远远可见西面的虎丘山。放眼
望去尽是绿的田，翠的草和清清的小河。门边官兵身后贴着一
份告示。南北一条笔直的官道。
LONG );
  set("outdoors", "suzhou");
  set("exits", ([
    "north" : __DIR__"road1",
    "south" : __DIR__"beidajie2",
  ]));
