#include <ansi.h>
inherit NPC;
void create()
{
  set_name(HIC"婢女"NOR, ({ "xiao binu", "bi nu", "girl" }) );
  set("gender", "女性" );
  set("age", 16);
  set("long", "这是一个容貌清秀的天真无邪的婢女。\n");
  set("combat_exp", 2000);
  set("str", 20);
  set("dex", 18);
  set("con", 19);
  set("int", 20);
  set("attitude", "friendly");
  set("max_kee", 100);
  set("max_sen", 100);
  set("force", 100);
  set("max_force", 100);
  set_skill("force", 20);
  set_skill("dodge", 20);
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_temp("apply/attack", 8);
  set_temp("apply/defense", 12);
  set_temp("apply/damage", 11);
  set_temp("apply/armor", 7);
  setup();
  carry_object(sprintf("/obj/cloth/female%d-cloth",1+random(8)))->wear();
}

