// seller.c
inherit "/obj/npc/xiaofan";
void create()
{
  set_name("苏州小贩", ({"suzhou xiao fan", "seller" }) );
  set("gender", "男性" );
  set("age", 32);
  set("long","这位小贩子正笑咪咪地来回忙著，还不时招呼过往的客人进来。\n");
  set("combat_exp", 300);
  set("str", 17);
  set("dex", 20);
  set("con", 17);
  set("int", 22);
  set("attitude", "friendly");
  set("vendor_goods", ([
    "1" : "/d/suzhou/obj/doufu",
    "2" : "/d/suzhou/obj/huotui",
    "3" : "/d/suzhou/obj/potato",
    "4" : "/d/suzhou/obj/soup",
    "5" : "/d/suzhou/obj/xianggu",
    "6" : "/d/suzhou/obj/xiaren",
  ]) );
  set("chat_chance", 20);
  set("chat_msg", ({
      (:random_move:),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 100);
  if (clonep())
    keep_heart_beat();
}

