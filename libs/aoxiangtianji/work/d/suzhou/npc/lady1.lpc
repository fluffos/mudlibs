// lady1.c
inherit NPC;
void create()
{
  set_name("小玉",({ "xiao yu", "girl" }) );
  set("gender", "女性" );
  set("age", 16);
  set("long",
"这是个十六、七岁的苏州女孩，清丽绝俗，一脸温柔的颜色。\n");
  set_temp("apply/defense", 5);
  set("combat_exp", 70);
  set("str", 14);
  set("per", 28);
  set("dex", 15);
  set("con", 16);
  set("int", 15);
  set("attitude", "friendly");
  setup();
  carry_object("/obj/cloth/pinkskirt")->wear();
}

