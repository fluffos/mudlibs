// wang.c
#include <ansi.h>
inherit "/obj/npc/dangpu-npc";
void create()
{
  set_name("王合计", ({ "wang heji", "heji", "wang" }));
  set("title", "当铺老板");
  set("gender", "男性");
  set_max_encumbrance(100000000);
  set("age", 35);
  set("long", "他带着一脸诡秘、奸诈的笑容。\n");
  set("no_get_from", 1);
  set("kee", 5000);
  set("max_kee", 5000);
  set("sen", 5000);
  set("max_sen", 5000);
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("env/wimpy", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/damage", 40);

  setup();
  carry_object("/obj/cloth/choupao")->wear();
}