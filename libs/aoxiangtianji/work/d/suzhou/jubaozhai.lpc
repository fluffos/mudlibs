#include <ansi.h>
inherit BANK;
void create()
{
  set("short", "聚宝斋");
  set("long", @LONG
这是一家老字号的钱庄，已有几百年的历史，在全国各地
都有分店。它发行的银票信誉非常好，通行全国。
    在对面的墙上挂了块牌子(paizi)。
LONG );
  set("no_clean_up", 0);

  set("item_desc", ([
      "paizi":
HIG"本钱庄提供的服务有：\n"NOR
HIC"--------------------------------\n"NOR
HIG"check(chazhang)        查帐\n"NOR
HIG"check(chazhang qn)     查潜能\n"NOR
HIC"--------------------------------\n"NOR
HIG"deposit(cun)           存款\n"NOR
HIC"--------------------------------\n"NOR
HIG"withdraw(qu)           取款\n"NOR
HIC"--------------------------------\n"NOR
HIG"convert(duihuan)       兑换钱币\n"NOR
HIC"--------------------------------\n"NOR
HIG"qn                     潜能业务\n"NOR
HIC"--------------------------------\n"NOR
  ]) );
  set("exits", ([
    "east"  : __DIR__"nandajie1",
  ]));
  set("objects", ([
     __DIR__"npc/sun": 1,
  ]));
  set("no_clean_up", 0);
  setup();
}

