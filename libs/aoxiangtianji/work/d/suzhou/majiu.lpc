#include <room.h>
inherit TRANS_ROOM;
void create()
{
  set("short", "马厩");
  set("long", @LONG
这里是北大街的马厩，常年供应新鲜草料。苏州民风淳朴
马夫们会把马牵到马厩好生照看，将它们喂饱饮足，再洗刷得
干乾净净，一直伺候到客人上路。马厩雨檐下的烂木柱上钉着
一块破木牌(paizi)。马厩中堆放著几堆草料。
LONG);

  set("exits", ([
     "west" : __DIR__"kedian",
     "up"   : "/obj/shop/suzhou_shop",
  ]));
  set("objects", ([
    "/obj/horse/zaohongma": 1,
    "/obj/horse/huangbiaoma": 1,
    "/obj/horse/ziliuma": 1,
    "/obj/npc/mafu": 1,
  ]));
  setup();
}

