{
  set("short", "头门山");
  set("long", @LONG
头山门在虎丘山的南面，形似虎头。隔河照墙上书着“海
涌流辉”四个大字，以示虎丘与大海的渊源关系。
LONG );
  set("outdoors", "suzhou");
