inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "玄武门");
  set ("long", @LONG
高墙巍峨，长梁雕龙，飞檐画凤，这里就是“玄武门”。往
里就是皇宫大门了，一般的百姓到此截然止步，不敢擅自逾
越皇家禁地。
LONG);
  set("objects", ([ /* sizeof() == 2 */
    "/d/huanggong/npc/weishi" : 2,
  ]));

  set("outdoors", 1);
  set("exits", ([ /* sizeof() == 2 */
    "north" : __DIR__"ncenter",
    "south" : __DIR__"bridge1",
  ]));
  setup();
}

int valid_leave(object me, string dir)
{
  if (me->query("quest/reward"))
    return ::valid_leave(me, dir);
  if (dir == "south" )
  {
    if (objectp(present("wei shi", environment(me)))&&!wizardp(me))
      return notify_fail("金甲卫士喊道：此乃皇宫，禁行！\n");
  }

  return ::valid_leave(me, dir);
}

