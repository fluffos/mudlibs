inherit SMALLROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "背阴巷");
  set ("long", @LONG
背阴巷位于长安城西门附近，住户大多是些贫苦人家。由于官府很少管
这里，所以治安并不十分好。周围民居破落，路边杂草丛生，到处是
沉闷的灰色，不见一丝生机。小巷胡同弯弯曲曲，显得有些狭促。来往的
人大多是衣衫褴褛，满面愁色。
LONG);
  set("exits",
  ([
    "east"   : __DIR__"yongtai-dadao4",
    "west"   : __DIR__"beiyin6",
    "south"  : __DIR__"by-minju4",
  ]));
  set("objects",
  ([
      __DIR__"npc/luren"   : 1,
  ]));
  set("outdoors", "CITY");
  set("no_clean_up", 0);
  setup();
}

