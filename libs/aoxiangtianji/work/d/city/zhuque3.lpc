inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "朱雀街");
  set ("long", @LONG
朱雀街是长安城中心大街，青石板路笔直的伸展出去，一路上行人
比肩，笙歌处处。景物之美，直如神仙境地。北面是长安乐坊，传
出阵阵丝竹管乐与欢笑，乃是长安城中第一热闹所在。南面是家老
字号的药铺。
LONG);
  set("exits",
  ([
    "north" : __DIR__"club",
    "south" : __DIR__"yaopu1",
    "west" : __DIR__"scenter",
    "east" : __DIR__"zhuque4",
  ]));
  set("outdoors", "changan");
  setup();
}

