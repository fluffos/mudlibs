inherit SMALLROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "吉祥杂货铺");
  set ("long", @LONG
不知为什么西城虽大，却只有这一间杂货铺。所以每天人来人往
也挺热闹。这里无论是油盐酱醋，还是大米白面，样样齐全。屋
里打扫的也十分干净，魏老板在和几位客人说说笑笑。
LONG);

  set("exits", ([
        "east" : __DIR__"beiyin6",
  ]));
  set("objects", ([
    __DIR__"npc/laowei"   : 1,
    __DIR__"npc/laotou"   : 1,
    __DIR__"npc/xunshi-out": 1,
  ]));
  set("no_clean_up", 0);
  setup();
}

