// doctor.c
inherit F_VENDOR_SALE;
void create()
{
  reload("city_jjiugong");
  set_name("时九公", ({ "shi jiugong", "shi", "jiugong"}));
  set("str", 60);
  set("gender", "男性");
  set("title", "药铺掌柜");
  set("age", 66);
  set("long", "据说时九公原是江湖中的名医。\n");
  set("combat_exp", 250);
  set("attitude", "friendly");
  set("vendor_goods", ([
    "1" : "/d/obj/drug/dieda",
    "2" : "/d/obj/drug/yangjing",
    "3" : "/d/obj/drug/huojin",
    "4" : "/d/obj/drug/liuhe",
    "5" : "/d/obj/drug/baola",
  ]));
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}

void init()
{
  add_action("do_vendor_list", "list");
}

