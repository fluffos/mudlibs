//murong-hao.c
inherit NPC;
inherit F_VENDOR;
void create()
{
  set_name("慕容豪", ({"murong hao", "murong", "hao"}));
  set("title", "老板");
  set("gender", "男性");
  set("age", 25);
  set("long", "慕容豪是慕容世家的弟子。\n");
  set("combat_exp", 200000);
  set("attitude", "heroic");
  set_skill("sword", 90);
  set_skill("unarmed", 90);
  set_skill("dodge", 90);
  set_skill("parry", 90);
  set("force", 1200);
  set("max_force", 600);
  set("force_factor", 5);
  set("vendor_goods", ([
    "1" : "/d/obj/weapon/archery/fengweiarrow",
    "2" : "/d/obj/weapon/archery/ciguarrow",
    "3" : "/d/obj/weapon/axe/huafu",
    "4" : "/d/obj/weapon/blade/fengdao",
    "5" : "/d/obj/weapon/bow/crossbow",
    "6" : "/d/obj/weapon/bow/goldbow",
    "7" : "/d/obj/weapon/fork/sanci-fork",
    "8" : "/d/obj/weapon/hammer/bahammer",
    "9" : "/d/obj/weapon/mace/silverjian",
    "10" : "/d/obj/weapon/spear/huaji",
    "11" : "/d/obj/weapon/staff/duyue-staff",
    "12" : "/d/obj/weapon/stick/lanyang-stick",
    "13" : "/d/obj/weapon/sword/fenghuangqin",
    "14" : "/d/obj/weapon/whip/fengfei-whip",
    "15" : "/d/obj/weapon/dagger/danyue",
  ]));
  setup();
  carry_object("/d/city/obj/jinzhuang")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
}

void init()
{
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting())
  {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

  add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
  if (! ob || ! visible(ob) || environment(ob) != environment())
    return;
  say(name() + "漫不经心的看了你一眼，顺手拿起了身旁"
     "的一把长剑用衣袖拭了拭。\n");
}

int accept_fight(object me)
{
  command("say 他妈的！你一进来老子就知道你是冲着我来的！\n");
  command("hate");
  command("grin");
  command("say 我不是好欺负的！"+RANK_D->query_rude(me)+"你拿命来吧！");
  command("kill" + me->query("id"));
  return 1;
}

