inherit F_VENDOR_SALE;
void greeting(object ob);
void create()
{
  reload("city_weiluqi");
  set_name("老张", ({"lao zhang", "zhang", "boss"}));
  set("title", "面馆老板");
  set("gender", "男性");
  set("age", 35);
  set("kee", 350);
  set("max_kee", 350);
  set("sen", 200);
  set("max_sen", 200);
  set("combat_exp", 10000);
  set("attitude", "friendly");
  set("env/wimpy", 50);
  set("chat_chance", 10);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set("vendor_goods", ([
       "1" : "/d/obj/food/miantang",
       "2" : "/d/obj/food/miantiao1",
       "3" : "/d/obj/food/miantiao2",
       "4" : "/d/obj/food/miantiao3",
  ]));
  setup();
  carry_object("/obj/cloth/choupao")->wear();
  add_money("silver", 1);
}

void init()
{
  object ob;
  ::init();
  add_action("do_vendor_list", "list");

  if (playerp(ob = this_player()) && ! is_fighting())
    greeting(ob);
}

void greeting(object ob)
{
  if( !ob || !visible(ob) || environment(ob) != environment() ) return;
  say(name() + "热情地说道：这位" + RANK_D->query_respect(ob) + "，进来吃碗热乎的面条吧!。\n");
}

