//lanxiang.c
inherit F_VENDOR_SALE;
void greeting(object ob);
void create()
{
  reload("city_lanxiang");
  set_name("张兰香", ({"zhang lanxiang", "zhang", "lanxiang"}));
  set("shop_id",({"laoban","zhanglanxiang","zhang","lanxiang"}));
  set("shop_title", "水果店老板");
  set("gender", "女性");
  set("combat_exp", 4000);
  set("age", 23);
  set("per", 40);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set("vendor_goods", ([
     "1" : "/d/city/obj/pingguo",
     "2" : "/d/city/obj/hamigua",
     "3" : "/d/city/obj/juzi",
  ]));
  setup();
  carry_object("/obj/cloth/pinkskirt")->wear();
  add_money("silver", 30);
}

void init()
{
  object ob;
  ::init();

  add_action("do_vendor_list", "list");

  if (playerp(ob = this_player()) && !is_fighting())
    greeting(ob);
}

void greeting(object ob)
{
  if (! ob || environment(ob) != environment())
    return;
  say(name() + "笑咪咪地说道：这位" + RANK_D->query_respect(ob) +
      "，新到的各种水果，买点儿回家尝尝吧。\n");
}