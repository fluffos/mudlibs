inherit NPC;
inherit F_VENDOR;
void create()
{
  set_name("茶博士", ({"cha boshi","waiter"}));
  set("shop_id", ({"cha boshi", "waiter"}));
  set("gender", "男性");
  set("class", "scholar");
  set("combat_exp", 1000);
  set("age", 26);
  set("per", 14);
  set("attitude", "friendly");
  set_skill("unarmed", 10);
  set("vendor_goods", ([
    "1": "/d/obj/food/huadiao-jiudai",
    "2": "/d/obj/food/huasheng",
  ]) );
  setup();
}

void init()
{
  ::init();
  add_action("do_vendor_list", "list");
}

