inherit "/std/char/furniture_seller";
void create()
{
  set_name("家具店老板", ({ "furniture boss","boss"}) );
  set("gender", "男性" );
  set("title","家私城");
  set("age", 35+random(10));
  set("long", "这是一位透着精明的老板。\n");
  set("combat_exp", 100000);
  set("daoxing", 100000);
  set("str", 27);
  set("force", 200);
  set("max_force", 200);
  set("force_factor", 2);
  set("furnitures",({
    "/obj/furniture/chuang1",
    "/obj/furniture/chuang2",
    "/obj/furniture/chuang3",
    "/obj/furniture/chuang4",
    "/obj/furniture/shuzhuo",
    "/obj/furniture/shuzhuangtai",
    "/obj/furniture/candle",
  }));
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}

