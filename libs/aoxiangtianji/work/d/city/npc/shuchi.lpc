//shuci.c
inherit F_VENDOR_SALE;
void greeting(object ob);
void create()
{
  reload("city_shuchi");
  set_name("书痴", ({ "shu chi", "chi", }) );
  set("gender", "男性" );
  set("age", 40);
  set("title", "汇文阁老板");
  set("combat_exp", 50000);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set_skill("unarmed", 50);
  set_skill("literate", 100);
  set("attitude", "friendly");
  set("per",25);
  set("vendor_goods", ([
     "1" : "/d/obj/book/san",
     "2" : "/d/obj/book/bai",
     "3" : "/d/obj/book/qian",
     "4" : "/d/obj/book/mbook1",
     "5" : "/d/obj/book/mbook2",
     "6" : "/d/obj/book/perception-book1",
     "7" : "/d/obj/book/perception-book2",
     "8" : "/d/obj/book/perception-book3",
     "9" : "/d/obj/book/calligraphy-book1",
     "10" : "/d/obj/book/calligraphy-book2",
     "11" : "/d/obj/book/chess-book1",
     "12" : "/d/obj/book/chess-book2",
     "13" : "/d/obj/book/xiao-book1",
     "14" : "/d/obj/book/math-book1",
     "15" : "/d/obj/book/math-book2",
  ]));
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}

void init()
{
  object ob;

  ::init();

  add_action("do_vendor_list", "list");

  if (playerp(ob = this_player()) && ! is_fighting())
    greeting(ob);
}

void greeting(object ob)
{
  if (! ob || ! visible(ob) || environment(ob) != environment())
    return;
  command("say 这位" + RANK_D->query_respect(ob) + "快请进，快请进。");
}

