inherit NPC;
string test_player1();
string test_player2();
string test_player3();
string test_player4();
void create()
{
  set_name("不知和尚", ({ "buzhi heshang" , "heshang", "bonze" }));
  set("gender", "男性");
  set("age", 100);
  set("attitude", "peaceful");
  set("class", "bonze");
  set("max_kee", 2000);
  set("per", 30);
  set("max_sen", 2000);
  set("force", 2400);
  set("max_force", 2400);
  set("force_factor", 120);
  set("max_mana", 2400);
  set("mana", 2400);
  set("mana_factor", 100);
  set("combat_exp", 1000000);
  set("daoxing", 2000000);
  set_skill("literate", 100);
  set_skill("spells", 160);
  set_skill("buddhism", 160);
  set_skill("dodge", 160);
  set_skill("lotusmove", 160);
  set_skill("parry", 160);
  set_skill("unarmed", 160);
  set_skill("jienan-zhi", 160);
  set_skill("force", 160);
  set_skill("lotusforce", 160);
  set_skill("staff", 160);
  set_skill("lunhui-staff", 160);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "lunhui-staff");
  map_skill("staff", "lunhui-staff");
  set("inquiry", ([
    "袈裟"   : (: test_player1 :),
    "这么贵" : (: test_player2 :),
    "不要钱" : (: test_player3 :),
    "取经"   : (: test_player4 :),
  ]));
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
     (: cast_spell, "bighammer" :),
  }) );
  set("chat_chance", 5);
  set("chat_msg", ({
     "不知和尚摇头晃脑地说：佛度有缘人。\n",
     "不知和尚摇头晃脑地说：我佛慈悲。\n",
     "不知和尚摇头晃脑地说：南无阿弥陀佛。\n",
  }) );

  setup();
  carry_object("/obj/cloth/sengyi")->wear();
  carry_object("/d/obj/weapon/staff/budd_staff")->wield();
}

string test_player1()
{
  object me = this_player();

  if (me->query_temp("buzhi_jiasha"))
    return "施主真是太贪心了，于取经不利啊！\n";
  if((int)me->query("obstacle/number") != 2
     || me->query("obstacle/hf") == "done")
    return "袈裟乃是至宝，施主现在用不上！\n";

  me->set_temp("buzhi_ask1",1);
  return "袈裟是我佛无价之宝,只鱼有缘人,货买3000两\n";
}

string test_player2()
{
  object me = this_player();

  if (!me->query_temp("buzhi_ask1"))
    return "一分钱，一分货！\n"	;
  me->set_temp("buzhi_ask2",1);
  return "有缘人分文不取！\n";
}

string test_player3()
{
  object me = this_player();

  if (!me->query_temp("buzhi_ask1") || !me->query_temp("buzhi_ask2"))
    return "不要钱的东西到垃圾堆里去找！\n"	;
  me->set_temp("buzhi_ask3",1);
  return "西行取经，即为有缘人！\n";
}

string test_player4 ()
{
  object who = this_player();
  object me = this_object();

  if (!who->query_temp("buzhi_ask1") ||
      !who->query_temp("buzhi_ask2") ||
      !who->query_temp("buzhi_ask3"))
    return "取经问我干什么？\n"	;

  who->delete_temp("buzhi_ask1");
  who->delete_temp("buzhi_ask2");
  who->delete_temp("buzhi_ask3");
  who->set_temp("buzhi_jiasha",1);
  me->command_function("nod");
  carry_object("/d/city/obj/jiasha2");
  command("give jia sha to " + who->query("id"));
  return "佛祖保佑你！\n";
}