//murong-hao.c
inherit NPC;
inherit F_VENDOR;
void create()
{
  set_name("慕容英", ({"murong ying", "murong", "ying"}));
  set("title", "老板");
  set("gender", "男性");
  set("age", 25);
  set("long", "慕容英是慕容世家的弟子。\n");
  set("combat_exp", 500000);
  set("daoxing", 500000);
  set("attitude", "heroic");
  set_skill("sword", 90);
  set_skill("unarmed", 90);
  set_skill("dodge", 90);
  set_skill("parry", 90);
  set("force", 1200);
  set("max_force", 600);
  set("force_factor", 100);
  set("vendor_goods", ([
    "1" : "/d/obj/armor/armbands/pi-hubi",
    "2" : "/d/obj/armor/armor/jinsijia",
    "3" : "/d/obj/armor/cape/yinsi-cape",
    "4" : "/d/obj/armor/cloth/jinxiu-cloth",
    "5" : "/d/obj/armor/finger/yuban-finger",
    "6" : "/d/obj/armor/flower/xingzuan-flower",
    "7" : "/d/obj/armor/hands/ruanpi-hands",
    "8" : "/d/obj/armor/head/yinxian-head",
    "9" : "/d/obj/armor/leggings/qianceng-huxi",
    "10" : "/d/obj/armor/neck/golden-neck",
    "11" : "/d/obj/armor/shield/qianteng-dun",
    "12" : "/d/obj/armor/shoes/tayun-shoes",
    "13" : "/d/obj/armor/shoulder/yunsi-pijian",
    "14" : "/d/obj/armor/surcoat/xiuyun-pifeng",
    "15" : "/d/obj/armor/waist/yuyan-waist",
  ]));
  setup();
  carry_object("/d/city/obj/jinzhuang")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
}

void init()
{
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting())
  {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

  add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
  if (! ob || ! visible(ob) || environment(ob) != environment())
    return;
  say(name() + "漫不经心的看了你一眼，悠闲的喝了口茶。\n");
}

int accept_fight(object me)
{
  command("say 他妈的！你一进来老子就知道你是冲着我来的！\n");
  command("hate");
  command("grin");
  command("say 我不是好欺负的！"+RANK_D->query_rude(me)+"你拿命来吧！");
  command("kill" + me->query("id"));
  return 1;
}

