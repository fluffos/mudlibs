//chen-laoban
inherit F_VENDOR_SALE;
void create()
{
  reload("city_chen-laoban");
  set_name("陈老板", ({ "chen laoban", "chen","laoban" }));
  set("title", "首饰店老板");
  set("shop_id", ({"laoban"}));
  set("gender", "男性");
  set("shen_type", 1);
  set("age", 43);
  set("combat_exp", 100000);
  set("attitude", "friendly");
  set("str", 30);
  set("max_kee", 300);
  set("max_sen", 300);
  set("force", 300);
  set("max_force", 300);
  set("force_factor", random(10)+15);
  set_skill("unarmed", 30);
  set_skill("parry", 40);
  set_skill("dodge", 40);
  set("vendor_goods", ([
     "1" : "/d/obj/armor/finger/yinjie",
     "2" : "/d/obj/armor/finger/zuanjie",
     "3" : "/d/obj/armor/finger/baojie",
     "4" : "/d/obj/armor/finger/jinjie",
     "5" : "/d/obj/armor/finger/baijie",
  ]));
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}

void init()
{
  ::init();
  add_action("do_vendor_list", "list");
}

