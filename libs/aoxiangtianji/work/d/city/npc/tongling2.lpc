//tongling2.c
inherit NPC;
void create()
{
  set_name("萧群", ({ "xiao qun"}) );
  set("gender", "男性");
  set("age", 30);
  set("combat_exp", 1200000);
  set("title", "御林军统领");
  set("attitude", "friendly");
  set("per", 25);
  set("str", 35);
  set("max_kee", 4000);
  set("max_sen", 4000);
  set("force", 3000);
  set("max_force", 1500);
  set("force_factor", 50);
  set("mana", 3000);
  set("max_mana", 1500);
  set("mana_factor", 70);
  set_skill("sword", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("force", 150);
  set_skill("sancai-sword", 150);
  set_skill("feiyan-zoubi", 150);
  map_skill("sword", "sancai-sword");
  map_skill("dodge", "feiyan-zoubi");
  map_skill("parry", "sancai-sword");

  setup();
  carry_object("/d/obj/weapon/sword/youlong-sword")->wield();
  carry_object("/d/obj/armor/armor/tongjia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
}

int accept_fight(object me)
{
  command("say 我贵为御林军统领，岂能与你一般见识！");
  return 0;
}

