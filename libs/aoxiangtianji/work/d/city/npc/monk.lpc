//monk.c
inherit NPC;
void greeting(object me);
void create()
{
  set_name("知客和尚", ({"monk"}));
  set("gender", "男性");
  set("attitude", "peaceful");
  set("class", "bonze");
  set("age", 20+random(10));
  set("combat_exp", 25000);
  set("per", 30);
  set("max_kee", 500);
  set("max_sen", 300);
  set("force", 300);
  set("force_factor", 5);
  set_skill("force", 15+random(20));
  set_skill("unarmed", 15+random(20));
  set_skill("dodge", 15+random(20));
  set_skill("parry", 15+random(40));
  setup();
  carry_object("obj/cloth/sengyi")->wear();
  setup();
}

void init()
{
  object ob;
  ::init();
  if (playerp(ob = this_player()) && ! is_fighting())
    greeting(ob);
}

void greeting(object me)
{
  if (!objectp(me) || !this_object() || environment(me) != environment(this_object()))
    return;
  command("hi " + me->query("id"));
  return ;
}

