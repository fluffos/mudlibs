// jingxuan.c
inherit NPC;
void create()
{
  set_name("净玄", ({"jing xuan", "monk" }));
  set("title","宝象寺长老");
  set("gender", "男性");
  set("age", 80);
  set("attitude", "friendly");
  set("per", 30);
  set("int", 30);
  set("max_kee", 700);
  set("max_sen", 700);
  set("force", 800);
  set("max_force", 800);
  set("force_factor", 30);
  set("combat_exp", 120000);
  set_skill("unarmed", 70);
  set_skill("dodge", 70);
  set_skill("parry", 70);
  set_skill("force", 70);
  setup();
  carry_object("obj/cloth/sengpao")->wear();
}

int accept_kill(object me)
{
  command("say 这位"+ RANK_D->query_respect(me) +
          "你我无冤无仇，这样又是何必呢？");
  return 0;
}

int accept_fight(object me)
{
  command("say 这位"+ RANK_D->query_respect(me) +
          "你我无冤无仇，这样又是何必呢？");
  return 0;
}

