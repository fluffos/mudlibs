inherit NPC;
void create()
{
  set_name("苦力", ({"kuli"}));
  set("age", 22);
  set("gender", "男性");
  set("long","一个衣衫破旧的苦力人。\n");
  set("attitude", "heroism");
  set("combat_exp", 8000+random(2000));
  set("shen_type", 1);
  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_skill("parry", 20);
  set_skill("blade", 20);
  setup();
  carry_object("/obj/cloth/linen")->wear();
}

