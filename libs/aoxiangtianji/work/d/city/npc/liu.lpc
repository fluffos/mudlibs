inherit F_VENDOR_SALE;
void greeting(object ob);
void create()
{
  reload("city_liu");
  set_name("刘老实", ({ "liu laoshi", "liu" }));
  set("title", "杂货铺老板");
  set("shen_type", 1);
  set("gender", "男性");
  set("age", 55);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_temp("apply/damage", 15);
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("vendor_goods", ([
    "1" :"/obj/cloth/beixin",
    "2" : "/d/obj/armor/shield/shield",
    "3" : "/d/city/obj/muqin",
    "4" : "/d/obj/misc/fire",
    "5" : "/d/obj/misc/wood",
    "6" : "/d/obj/misc/shoeshine",
    "7" : "/d/obj/misc/brush",
    "8" : "/d/obj/misc/diaogan",
    "9" : "/d/obj/misc/yuer",
    "10" : "/d/obj/misc/yanwu",
    "11" : "/d/obj/misc/shexiang",
  ]));
  setup();
  carry_object("/obj/cloth/changpao")->wear();
}

void init()
{
  object ob;
  ::init();
  add_action("do_vendor_list", "list");
  if(playerp(ob = this_player()) && !is_fighting() )
    greeting(ob);
}

void greeting(object ob)
{
  if( !ob || !visible(ob) || environment(ob) != environment() ) return;
  switch( random(2) )
  {
    case 0:
      say( name()+"说道：这位" + RANK_D->query_respect(ob)
                 + "，要买些什么东西？\n");
      break;
  }

}

