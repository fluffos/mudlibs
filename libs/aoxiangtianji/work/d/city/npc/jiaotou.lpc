inherit NPC;
string ask_skill();
void create()
{
  set_name("范芦平", ({"fan luping", "fan"}));
  set("age", 32);
  set("gender", "男性");
  set("long",
"一个精精瘦瘦的小个子，在练一套拳．\n");
  set("title", "武馆教头");
  set("attitude", "peaceful");
  set("combat_exp", 800000);
  set("daoxing", 800000);
  set("shen_type", 1);
  set("max_force", 800);
  set("force", 1500);
  set("force_factor", 5);
  set("max_mana", 800);
  set("mana", 1500);
  set("mana_factor", 40);
  set_skill("spells", 100);
  set_skill("force", 100);
  set_skill("taoism", 60);
  set_skill("tuna-qigong", 60);
  map_skill("spells","taoism");
  map_skill("force","tuna-qigong");
  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_skill("parry", 60);
  set_skill("changquan",60);
  map_skill("unarmed", "changquan");
  set_skill("feiyan-zoubi", 60);
  map_skill("dodge", "feiyan-zoubi");
  set("inquiry", ([
    "学艺"   : (: ask_skill :),
  ]) );
  setup();
  carry_object("/obj/cloth/linen")->wear();
}

int recognize_apprentice(object ob)
{
  return 1;
}

string ask_skill()
{
  object me = this_player();
  string msg;

  msg = "我可以教你一下技能：\n";
  msg += "spells      100 \n";
  msg += "force       100 \n";
  msg += "taoism       60 \n";
  msg += "tuna-qigong  60 \n";
  msg += "dodge        60 \n";
  msg += "feiyan-zoubi 60 \n";
  msg += "parry        60 \n";
  msg += "unarmed      60 \n";
  tell_object(me,msg);
  return "你可以直接向我学习！\n";
}

