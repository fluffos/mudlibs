#include <ansi.h>
inherit NPC;
void create()
{
  set_name(HIY"范青屏"NOR, ({"fan qingping", "fan"}));
  set("age", 72);
  set("gender", "男性");
  set("long",
"范老拳师壮年时也是响当当的英雄，现在虽老了，手脚利落却不输当年．\n");
  set("title", "拳盖三省");
  set("attitude", "friendly");
  set("max_kee", 1500);
  set("max_sen", 1500);
  set("combat_exp", 1000000);
  set("daoxing", 1000000);
  set("shen_type", 1);
  set("max_force", 1200);
  set("force", 2000);
  set("force_factor", 15);
  set("max_mana", 1200);
  set("mana", 2000);
  set("mana_factor", 60);
  set_skill("unarmed", 100);
  set_skill("changquan", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("feiyan-zoubi", 100);
  map_skill("unarmed", "changquan");
  map_skill("dodge", "feiyan-zoubi");
  set("chat_chance",1);
  set("chat_msg", ({
        "范青屏叹道：腿脚不利落了，也没人去给我提笼小二的包子来。\n",
}));
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}

int accept_object(object who,object ob)
{
  object book;

  if (ob->query("id")=="zhurou bao")
  {
    command("say 嘿嘿，老二这包子是越做越小了。\n");
    command("say 不过还是要谢谢你呀！\n");
    book = new("/d/obj/book/quanjing");
    book->move(who);
    book->set("owner",who->query("id"));
    message_vision("$N给了$n一本书！\n",this_object(),who);
    return 1;
  }

  return 0;
}

