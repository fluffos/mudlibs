// dizi.c
inherit NPC;
void create()
{
  set_name("武馆弟子", ({ "wuguan dizi", "dizi", "trainee" }) );
  set("gender", "男性" );
  set("age", 18+random(10));
  set("long", "你看到一位身材高大的汉子，正在辛苦地操练着。\n");
  set("combat_exp",200000);
  set("daoxing",200000);

  set("max_force", 400);
  set("force", 800);
  set("force_factor", 2);
  set("max_mana", 400);
  set("mana", 800);
  set("mana_factor", 10);

  set_skill("dodge", 40);
  set_skill("unarmed", 40);
  set_skill("parry", 40);
  set_skill("force", 40);

  setup();
  carry_object("/obj/cloth/linen")->wear();
}

