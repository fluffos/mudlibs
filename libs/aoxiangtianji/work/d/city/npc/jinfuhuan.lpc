inherit F_VENDOR_SALE;
void greeting(object ob);
void create()
{
  reload("jin_fuhuan");
  set_name("金复还", ({ "jin fuhuan", "jin","fuhuan" }));
  set("title", "珠宝行老板");
  set("shen_type", 1);
  set("str", 35);
  set("gender", "男性");
  set("age", 45);
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_skill("parry", 60);
  set_skill("force", 60);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set("vendor_goods", ([
     "1" : "/d/obj/armor/finger/ring",
     "2" : "/d/city/obj/wrists",
     "3" : "/d/city/obj/neck",
  ]));
  setup();
  carry_object("/obj/cloth/choupao")->wear();
  add_money("silver", 2);
}

void init()
{
  object ob;
  ::init();
  add_action("do_vendor_list", "list");
  if( playerp(ob = this_player()) && !is_fighting() )
    greeting(ob);
}

void greeting(object ob)
{
  if( !ob || !visible(ob) || environment(ob) != environment() )
    return;
  if( ob->query("env/invisibility") )
    return;
  switch( random(2) )
  {
    case 0:
      say(name()+ "笑眯眯的迎上来：这位" + RANK_D->query_respect(ob)
                + "，随便看看．\n");
      break;
  }

}