inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "冯诩道");
  set ("long", @LONG
冯诩道是长安城中心大街，青石板路笔直的伸展出去，一路上行人
比肩，笙歌处处。景物之美，直如神仙境地。
LONG);
  set("exits",
  ([
     "west" : __DIR__"xuanwu4",
     "south" : __DIR__"fengxu2",
     "southeast" : __DIR__"qinglong1",
  ]));
  set("can_build_home",1);
  set("outdoors", "changan");
  setup();
}

