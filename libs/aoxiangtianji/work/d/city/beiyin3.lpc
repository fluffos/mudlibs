inherit SMALLROOM;
inherit MUDDYROOM;
void create ()
{
  set ("short", "背阴巷");
  set ("long", @LONG
背阴巷位于长安城之西南，住户大多是些贫苦人家。由于官府很少管
这里，所以治安并不十分好。周围民居破落，路边杂草丛生，到处是
沉闷的灰色，不见一丝生机。来往的人大多是衣衫褴褛，满面愁色。
西面是个帮会堂口，阴森森的，北面有家小酒馆。
LONG);
  set("exits",
  ([ //sizeof() == 4
     "north" : __DIR__"jiuguan",
     "east" : __DIR__"beiyin2",
     "northwest" : __DIR__"sanhua",
     "southwest" : __DIR__"beiyin4",
  ]));
  set("objects",
  ([ //sizeof() == 1
     __DIR__"npc/thief" : 1,
  ]));
  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
}

