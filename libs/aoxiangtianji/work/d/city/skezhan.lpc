string long()
{
  mixed msg;
  string day = query_jieri();

  msg = jieri[day];
  if (!msg)
    return query("long");
  if (stringp(msg))
    return color_filter(msg);
  if (arrayp(msg) && sizeof(msg) > 0)
    return color_filter(element_of(msg));
  return query("long");
}

int do_show(string arg)
{
  object me = this_player();
  mixed msg;

  if (!arg)
    return 0;
  msg = jieri[arg];
  if (!msg)
    return 0;
  if (stringp(msg))
  {
    me->start_more(color_filter(msg));
    return 1;
  }

  if (arrayp(msg) && sizeof(msg) > 0)
  {
    me->start_more(color_filter(element_of(msg)));
    return 1;
  }

  return 0;
}

