inherit ROOM;
inherit SAFTYROOM;
void create ()
{
  set ("short", "乐坊二楼");
  set ("long", @LONG
乐坊楼上显得格外热闹，走廊里人来人往，几间屋子里人声嘈杂，牌
签骨骰钱币落盘的声音不绝。看样子，客人们赌得正欢呢。
LONG);
  set("exits",
   ([ //sizeof() == 4
     "up" : __DIR__"club3",
     "west" : __DIR__"duchang1",
     "north" : __DIR__"duchang3",
     "south" : __DIR__"duchang4",
     "down" : __DIR__"club",
     "east" : __DIR__"duchang2",
   ]));
  set("no_clean_up", 0);
  set("no_quit",1);
  set("no_bian",1);
  setup();
}

int valid_leave(object me, string dir)
{
  object *inv;
  int sizeinv ;

  if (stringp(dir))
  {
    inv=all_inventory(me);
    sizeinv=sizeof(inv);
    while (sizeinv--)
    {
      if (inv[sizeinv]->is_character())
      {
      	write("不可以背个活人去娱乐场所！\n");
        return 0;
      }

    }

  }

  return ::valid_leave(me,dir);
}

