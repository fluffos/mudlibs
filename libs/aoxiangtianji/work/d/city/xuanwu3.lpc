inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "玄武街");
  set ("long", @LONG
玄武街是长安城中心大街，青石板路笔直的伸展出去，一路上行人
比肩，笙歌处处。景物之美，直如神仙境地。北面东边传出朗朗的读书
声，那里是当朝的学府国子监。南面是家书店。
LONG);
  set("exits",
  ([
     "north" : __DIR__"guozijian",
     "south" : __DIR__"bookstore1",
     "west" : __DIR__"ncenter",
     "east" : __DIR__"xuanwu4",
  ]));
  set("outdoors", "changan");
  setup();
}

