inherit MIDDLEROOM;
inherit LANDROOM;
inherit SAFTYROOM;
#define MAX_EXP 6000
#define MAX_POT 3000
void create ()
{
  set ("short", "货栈");
  set ("long", @LONG
这是一家生意兴隆货栈。货栈门口车来车往，几个活计在忙忙碌碌
地工作着，地上放着一些刚刚运来的货物。屋里面整齐的排列着几排货
架，货架上堆着各式各样的杂货，有一个掌柜模样的人坐在柜台后面笑
容可鞠地招呼着客人。货栈的墙上贴着一张破旧的告示(gaoshi)。
LONG);
  set("item_desc", (["gaoshi" : "现在正紧缺人手，急需雇佣一批短工来干活。
work    开始工作。
", ]));
  set("exits",
  ([ //sizeof() == 1
     "west" : __DIR__"yongtai-dadao1",
  ]));
  set("objects",
   ([ //sizeof() == 1
      __DIR__"npc/liang" : 1,
   ]));
  setup();
}

void init()
{
  add_action("do_work", "work");
}

int do_work(string arg)
{
  object ob;
  object me;
  int t,work_t,cost ;
  int exp_getted, pot_getted;
  int exp, pot;

  me = this_player();

  if(sizeof(filter_array(
       all_inventory(this_object()), (:userp:)))>30)
  {
    message_vision("梁老板笑眯眯地对$N说："+
                   "真对不住，人手已经够了。\n",me);
    return 1;
  }

  t = time();
  work_t = (int)me->query_temp("last_work_time");

  if (work_t && (t - work_t) < 2)
  {
    message_vision("梁老板赶紧把$N扶起来：先歇一会儿。\n",me);
    return 1;
  }

  if (me->query("kee") < 25 ||
      me->query("sen") < 25)
    return notify_fail("你可是累坏了，干不动了。\n");

  if ((int)me->query("combat_exp") > 5000)
    return notify_fail("这里已经不适合你做工了。\n");

  message_vision("$N从车上卸下一袋袋的大米，又"
                 "垒在墙边，累的腰酸腿疼！\n",me);
  cost = 45 - me->query("str");
  if (cost < 10)
    cost = 10;
  me->receive_damage("kee", cost);
  me->receive_damage("sen", cost);
  ob = new("/obj/money/coin");
  ob->set_amount(10+random(5));
  ob->move(me);
  exp_getted = (int)me->query("work/newbie_work/exp");
  if (exp_getted > MAX_EXP)
    exp = 0;
  else
    exp = 10 + random(10);
  pot_getted = me->query("work/newbie_work/pot");
  if (pot_getted > MAX_POT)
    pot = 0;
  else
    pot = 1 + random(10);
  GIFT_D->delay_work_bonus(me,([ "exp" : exp,
                                 "pot"    : pot,
                                 "prompt" : "通过这次劳动",
                               ]),"newbie_work");
  message_vision("梁老板笑眯眯地对$N说：辛苦啦，这是你的工钱。\n",me);
  me->set_temp("last_work_time",time());
  return 1;
}

