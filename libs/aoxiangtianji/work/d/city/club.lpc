inherit ROOM;
inherit SAFTYROOM;
void create ()
{
  set ("short", "长安乐坊");
  set ("long", @LONG
这里是长安城一家有名的娱乐场所。当夜幕降临后，这里就格外热闹。
进进出出的客人有达官贵人，南来北往的商旅，浪迹天涯的游子，三
五成群的兵士，有时也能看见一些作俗客打扮的僧人或道士。
LONG);
  set("exits",
    ([ //sizeof() == 4
       "up" : __DIR__"clubup",
       "south" : __DIR__"zhuque3",
        ]));
  set("no_clean_up", 0);
  set("no_quit",1);
  set("no_bian",1);
  set("no_npc",1);
  setup();
}

int valid_leave(object me, string dir)
{
  object *inv;
  int sizeinv ;

  if (dir == "up")
  {
    inv=all_inventory(me);
    sizeinv=sizeof(inv);
    while (sizeinv--)
    {
      if (inv[sizeinv]->is_character())
      {
      	write("不可以背个活人去娱乐场所！\n");
        return 0;
      }

    }

  }

  return ::valid_leave(me,dir);
}

