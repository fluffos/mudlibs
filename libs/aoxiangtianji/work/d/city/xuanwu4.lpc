inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "玄武街");
  set ("long", @LONG
玄武街是长安城中心大街，青石板路笔直的伸展出去，一路上行人
比肩，笙歌处处。景物之美，直如神仙境地。 东边是冯诩道。北
面是天监台。
LONG);
  set("exits",
  ([ //sizeof() == 2
      "east" : __DIR__"fengxu1",
      "west" : __DIR__"xuanwu3",
      "north" : __DIR__"tianjiantai",
      "south" : __DIR__"yamen",
  ]));
  set("outdoors", "changan");
  setup();
}

