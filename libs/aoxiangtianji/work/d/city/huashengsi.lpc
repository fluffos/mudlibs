inherit MIDDLEROOM;
inherit LANDROOM;
inherit TEMPLEROOM;
void create ()
{
  set ("short","化生寺" );
  set ("long", @LONG
化生寺是长安城里规模最大的一家丛林了。整日里香烟袅绕，颂经声
不绝于耳。来这里上香还愿的善男信女也特别多，若到了皇道吉日，
更是人山人海。
LONG);
  set("exits",
   ([ //sizeof() == 4
      "south" : __DIR__"hss-baodian",
      "east" : __DIR__"baihu2",
   ]));
  set("objects",
    ([ //sizeof() == 1
       __DIR__"npc/hss-sengren1" : 1,
       __DIR__"npc/yfsengren" : 2,
    ]));
  set("no_clean_up", 0);
  setup();
}

