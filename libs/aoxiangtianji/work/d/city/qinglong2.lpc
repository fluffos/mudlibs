inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "青龙街");
  set ("long", @LONG
青龙街是长安城中心大街，青石板路笔直的伸展出去，一路上行人
比肩，笙歌处处。景物之美，直如神仙境地。
LONG);
  set("exits", ([
     "north" : __DIR__"qinglong1",
     "south" : __DIR__"ecenter",
     "east"  : __DIR__"bingqipu",
     "west"  : __DIR__"wuguan",
  ]));
  set("outdoors", "changan");
  setup();
}

