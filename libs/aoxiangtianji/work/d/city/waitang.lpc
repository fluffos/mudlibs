inherit BIGROOM;
inherit LANDROOM;
inherit SAFTYROOM;
string look_gaoshi();
void create ()
{
  set ("short", "刑部外堂");
  set ("long", @LONG

这里是大唐刑部开设的一个外堂，派有经验丰富的官差
专门办理各类江湖案件。大门的左边，醒目的贴着一个告
示(gaoshi)。之所以在这里开办一个外堂，也是想借助江
湖力量来治理江湖。
LONG);
  set("exits",
  ([ //sizeof() == 1
      "west" : __DIR__"yamen",
  ]));
  set("item_desc", ([
     "gaoshi" : (: look_gaoshi :),
  ]));
  set("objects",
  ([ //sizeof() == 2
      "/obj/job/quest/npc/guanchai" : 1,
  ]));
  setup();
}

string look_gaoshi()
{
  return FINGER_D->get_killer() + "\n         大唐刑部\n                     尉迟恭\n";
}

