inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "玄武街");
  set ("long", @LONG
玄武街是长安城中心大街，青石板路笔直的伸展出去，一路上行人
比肩，笙歌处处。景物之美，直如神仙境地。西边是扶风道。北面
是麒麟阁，南边是醉星楼。
LONG);
  set("exits",
  ([
    "west" : __DIR__"fufeng1",
    "east" : __DIR__"xuanwu2",
    "north" : __DIR__"qilin",
    "south" : __DIR__"zuixing",
  ]));
  set("outdoors", "changan");
  setup();
}

