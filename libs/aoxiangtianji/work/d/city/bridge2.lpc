inherit SMALLROOM;
inherit WATERROOM;
void create ()
{
  set ("short", "金水桥");
  set ("long", @LONG
金水桥是一条直通皇宫的大石桥，宽敞可容四马并驰，建造得鬼斧
神功，气势磅礴，使人生起一夫当关万夫莫敌的感觉。桥下有一条清澈
见底、蜿蜒地川流的小河，河水有时撞在石上，发出淙淙的流水声，悦
耳动听。桥北通向故皇宫，南面是青龙街。
LONG);
  set("exits",
  ([ //sizeof() == 2
      "south" : __DIR__"chaoyangmen",
      "north" : "/d/huanggong/hg-nanmen",
  ]));
  set("objects",
  ([ //sizeof() == 1
     __DIR__"npc/yulinjun" : 2,
     __DIR__"npc/tongling2" : 1,
  ]));
  set("outdoors", "changan");
  setup();
}

int valid_leave(object me, string dir)
{
  if (me->query("quest/reward") || me->query("office_number") > 100)
    return ::valid_leave(me, dir);
  if (dir == "north" )
  {
    if (objectp(present("xiao qun", environment(me)))&&!wizardp(me))
      return notify_fail("御林军统领喊道：此乃皇宫，禁行！\n");
    if (objectp(present("yulin jun", environment(me)))&&!wizardp(me))
      return notify_fail("御林军齐声喊道：此乃皇宫，禁行！\n");
  }

  return ::valid_leave(me, dir);
}

