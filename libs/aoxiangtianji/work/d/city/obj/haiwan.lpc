// haiwan
// mon 6/18/98
inherit ITEM;
inherit F_LIQUID;
void create()
{
  set_name("青瓷大海碗", ({"hai wan", "wan", "bowl"}));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一个盛满白开水的青瓷大海碗。\n");
    set("unit", "个");
    set("max_liquid", 20);
    set("no_get","留给大家喝不好吗？：）\n");
    set("drink_msg", "$N端起$n咕嘟咕嘟地灌下几大口$l。\n");
  }

  set("liquid", ([
    "type": "water",
    "name": "白开水",
    "remaining": 20,
    "drunk_apply": 5,
  ]));
}