//护腕 min_armor: 1 max_armor: 15 default_armor: 8
#include <armor.h>
inherit WRISTS;
void create()
{
  set_name("银手链", ({ "silver shoulian", "wrists" }) );
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
   set("unit", "双");
   set("long", "这是一双银质手链。\n");
   set("value", 5000);
   set("material", "cloth");
  }

  init_wrists(10);
  setup();
}

