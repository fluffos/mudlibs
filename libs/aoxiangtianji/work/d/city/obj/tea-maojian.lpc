//teapot.c
inherit ITEM;
inherit F_LIQUID;
void create()
{
  set_name("黄山毛尖茶", ({ "maojian tea", "tea" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一壶清香的毛尖。\n");
    set("unit", "个");
    set("value", 100);
    set("max_liquid", 10);
  }

  set("liquid", ([
    "name": "茶水",
    "remaining": 10,
  ]));
}