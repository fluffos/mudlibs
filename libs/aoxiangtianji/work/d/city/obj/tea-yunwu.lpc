//teapot.c
inherit ITEM;
inherit F_LIQUID;
void create()
{
  set_name("云雾茶", ({ "yunwu tea", "tea" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一壶透着异香的云雾茶水。\n");
    set("unit", "个");
    set("value", 30);
    set("max_liquid", 10);
  }

  set("liquid", ([
    "name": "茶水",
    "remaining": 10,
  ]));
}