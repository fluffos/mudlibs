//teapot.c
inherit ITEM;
inherit F_LIQUID;
void create()
{
  set_name("西湖龙井", ({ "longjing tea", "tea" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", "一壶西湖龙井茶，清透的茶汤有股淡淡的香味。\n");
    set("unit", "个");
    set("value", 100);
    set("max_liquid", 10);
  }

  set("liquid", ([
    "name": "茶水",
    "remaining": 10,
  ]));
}