#include <ansi.h>
inherit BIGROOM;
inherit MUDDYROOM;
inherit SAFTYROOM;
int do_drop(object me, object obj);
void create()
{
  set("short", "瓦砾场");
  set ("long", @LONG
你眼前出现一座硕大的垃圾堆。这里是长安城内最大的废物堆积处，
有环保意识的好心玩家，从来不随地乱扔废物，总是把他们扔(drop)
到这里来。
LONG);
  set("item_desc" , ([
    "east": WHT"那里是女茅厕，你也想偷窥?\n"NOR,
    "west": WHT"那里是男茅厕，你也想偷窥?\n"NOR,
  ]));
  set("exits", ([
    "up" : "/d/city/wcenter",
  ]));
  set("no_recall",1);
  set("no_npc",1);
  set("no_bian",1);
  setup();
}

void init()
{
  add_action("do_main", "drop");
}

int do_main(string arg)
{
  object me=this_player();
  object obj, obj2;
  int amount;
  string item;
  if(me->is_busy())
    return notify_fail("你正忙着呢．．．\n");

  if(!arg) return notify_fail("你要丢弃什么东西？\n");
  if(arg == "key"
    || arg == "huangtong key"
    || arg == "wenshu"
    || arg == "wen"
    || arg == "baoxianku qingdan"
    || arg == "qingdan")
    return notify_fail("这样东西不能被仍弃。\n");
  if(sscanf(arg, "%d %s", amount, item)==2)
  {
    if( !objectp(obj = present(item, me)) )
      return notify_fail("你身上没有这样东西。\n");
    if( !obj->query_amount() )
      return notify_fail( obj->name() + "不能被分开丢弃。\n");
    if( amount < 1 )
      return notify_fail("东西的数量至少是一个。\n");
    if( amount > obj->query_amount() )
      return notify_fail("你没有那么多的" + obj->name() + "。\n");
    else if( amount == (int)obj->query_amount() )
      return do_drop(me, obj);
    else
    {
      obj2 = new(base_name(obj));
      obj2->set_amount(amount);
      if(do_drop(me, obj2))
      {
        obj->set_amount( (int)obj->query_amount()-amount );
        return 1;
      }

      return 0;
    }

  }

  if(!objectp(obj = present(arg, me)))
    return notify_fail("你身上没有这样东西。\n");
  return do_drop(me, obj);
}

int do_drop(object me, object obj)
{
  if(me->is_busy())
    return notify_fail("你正忙着呢．．．\n");
  if(obj->query("no_droproom"))
    return notify_fail("这样东西不能被仍弃。\n");
  if (obj->move(environment(me)))
  {
    if((obj->query_temp("d_mana"))>0)
    {
      if( obj->query_temp("is_living")==1 )
        message_vision("$N将$n从背上放了下来，躺在地上。\n", me, obj);
      else
      {
        message_vision( sprintf("$N丢下一%s$n。\n",
         undefinedp(obj->query_temp("unit"))?"个":obj->query_temp("unit")), me, obj );
      }

    }

    else
    {
      if( obj->is_character() )
        message_vision("$N将$n从背上放了下来，躺在地上。\n", me, obj);
      else
      {
        if (obj->query("money_id") )
        {
          message_vision( sprintf("$N将%s扔进垃圾堆。。。\n", MONEY_D->money_num(obj->value())),me );
          destruct(obj);
        }

        else
        {
          message_vision( sprintf(HIC"$N将一%s$n"HIC"扔进垃圾堆。\n"NOR,
                                  obj->query("unit")),me,obj);
          destruct(obj);
        }

      }

    }

    return 1;
  }

  return 0;
}

int valid_leave(object me, string dir)
{
  if( wizardp(me)) return 1;
  if (dir == "east" && this_player()->query("gender")=="男性")
    return notify_fail(HIR"大男人想进女厕所偷窥么?!\n"NOR);
  if (dir == "west" && this_player()->query("gender")=="女性")
    return notify_fail(HIR"没羞，女人要进男厕所偷窥吗?!\n"NOR);
  return ::valid_leave(me, dir);
}

