inherit SMALLROOM;
inherit LANDROOM;
inherit SAFTYROOM;
void create ()
{
  set ("short", "回春药铺");
  set ("long", @LONG
这是长安城一家老字号的药铺，相传原来的老板是皇宫中的御医，手
段可知一二。药铺中的摆设也十分考究，桌椅被勤快的伙计擦的干干
净净。墙上挂满了别人送来的谢匾。
LONG);
  set("exits",
  ([
    "north" : __DIR__"zhuque3",
  ]));
  set("objects",
  ([
     __DIR__"npc/yang" : 1,
  ]));

  set("no_clean_up", 0);
  setup();
}

void init()
{
  object ob = this_player();

  if(ob->query_condition("killer"))
  {
    message_vision("药店老板大吃一惊，杀人犯怎么来了？出去！老板一把把$N推了出去。\n",ob);
    ob->move("/d/city/zhuque3");
    message_vision("$N被人一把推了过来，差点摔倒在地。\n",ob);
    ob->start_busy(2);
  }

}

