inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "朱雀街");
  set ("long", @LONG
朱雀街是长安城中心大街，青石板路笔直的伸展出去，一路上行人
比肩，笙歌处处。景物之美，直如神仙境地。路南是家大的客栈，
来往旅人不绝，北面是家钱庄。
LONG);
  set("exits", ([
   "west" : __DIR__"zhuque1",
   "east" : __DIR__"scenter",
   "south" : __DIR__"skezhan",
   "north" : __DIR__"sbank",
  ]));
  set("outdoors", "changan");
    set("objects", ([ /* sizeof() == 1 */
    "/obj/npc/zhongkui" : 1,
  ]));
  setup();
}

int valid_leave(object me, string dir)
{
  object *inv;
  int sizeinv ;
  if (dir == "south")
  {
    inv = all_inventory(me);
    sizeinv=sizeof(inv);
    while (sizeinv--)
      if (inv[sizeinv]->is_character())
        return notify_fail("你不可以背个活人去客栈？\n");
    if(me->query_condition("killer"))
      return notify_fail("你现在还敢去客栈？\n");

    if (objectp(me->query_temp("is_riding")))
      return notify_fail("店小二不欢迎你骑着个东西进他的客店！\n");
  }

  return ::valid_leave(me, dir);
}

