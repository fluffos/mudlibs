inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "朱雀街");
  set ("long", @LONG
朱雀街是长安城中心大街，青石板路笔直的伸展出去，一路上行人
比肩，笙歌处处。景物之美，直如神仙境地。南面是家毛货店，北
面有个鞋帽店。东边是冯诩道。
LONG);
  set("exits",
  ([
     "south" : __DIR__"maohuo",
     "north" : __DIR__"xiemao",
     "west" : __DIR__"zhuque3",
     "east" : __DIR__"fengxu5",
  ]));
  set("outdoors", "changan");
  setup();
}

