#include <armor.h>
inherit CLOTH;
void create()
{
  set_name("斜月三星袍", ({"xieyue cloth", "cloth"}));
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("value", 10000);
    set("material", "cloth");
    set("armor_prop/dodge", 10);
    set("armor_prop/spells", 20);
  }

  init_cloth(30);
  setup();
}

