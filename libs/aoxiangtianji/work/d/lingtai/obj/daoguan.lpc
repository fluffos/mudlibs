#include <ansi.h>
#include <armor.h>
inherit HEAD;
string *perfix = ({
  HIR"红"NOR,
  HIW"白"NOR,
  HIG"青"NOR,
  HIB"蓝"NOR,
  HIY"黄"NOR,
});

void create()
{
  set_name(element_of(perfix) + "木道冠", ({ "bonnet", "hat" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "顶");
    set("long", "一顶硬木的道冠。\n");
    set("material", "wood");
    set("value", 100);
    set("armor_prop/personality", 1);
  }

  init_head(5);
  setup();
}