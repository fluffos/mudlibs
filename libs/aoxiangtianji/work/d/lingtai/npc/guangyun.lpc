#include <ansi.h>
#include "lingtai.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("广筠子", ({"guang yunzi", "guang"}));
  set("gender", "男性" );
  set("age", 43);
  set("long", "方寸山三星洞第三代弟子中的杰出人物．\n");
  set("combat_exp", 500000);
  set("daoxing", 500000);
  set("per", 30);
  set("str", 25);
  set("spi", 30);
  set("int", 25);
  set("dex", 30);
  set("attitude", "peaceful");
  set("class", "taoist");

  set("max_kee", 1500);
  set("max_sen", 1500);
  set("force", 2200);
  set("max_force", 1200);
  set("force_factor", 50);
  set("mana", 2400);
  set("max_mana", 1200);
  set("mana_factor", 60);
  set_skill("literate",150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("stick", 150);
  set_skill("wuxiangforce", 150);
  set_skill("dao", 150);
  set_skill("jindouyun", 150);
  set_skill("puti-zhi", 150);
  set_skill("puti-stick",150);
  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("stick", "puti-stick");
  map_skill("parry", "puti-stick");
  create_family("方寸山三星洞", 3, "弟子");
  setup();
  carry_object("/d/lingtai/obj/daoguan")->wear();
  carry_object("/d/obj/armor/cloth/xiangpao")->wear();
  carry_object("/d/obj/weapon/stick/qimeigun")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "方寸山三星洞")
  {
    command("say 我只收方寸山弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 15)
  {
    command("say 你还要需要更多的磨练！\n");
    return 0;
  }

  command("hehe");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "taoist")
    ob->set("class", "taoist");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "方寸山三星洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我三星洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "taoist")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解道家之事，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 15)
  {
    command("shake");
    command("say 可惜我讲的，你估计听不懂！看来你需要更多的磨练！\n");
    return 1;
  }

  return 0;
}