  set("attitude", "peaceful");
  set_skill("unarmed", 30);
  set_skill("dodge", 60);
  set_skill("parry", 30);
  set_skill("literate", 40);
  set_skill("puti-zhi", 20);
  set_skill("force", 60);
  set_skill("wuxiangforce", 60);
  map_skill("unarmed", "puti-zhi");
  map_skill("force", "wuxiangforce");
  set("per", 30);
  set("max_kee", 300);
  set("max_sen", 300);
  set("force", 450);
  set("max_force", 300);
