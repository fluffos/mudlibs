#include <ansi.h>
#include "lingtai.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name( HIW "孙悟空" NOR, ({ "sun wukong", "wukong","swk"  }) );
  set("long",
"一个身不足五尺，瘦瘦干干，满身黄毛的猢狲。\n");
  set("age", 30);
  set("max_gin", 11000);
  set("max_kee", 11000);
  set("max_sen", 11000);
  set("max_force", 8000);
  set("force", 16000);
  set("max_mana", 8000);
  set("mana", 16000);
  set("force_factor", 400);
  set("mana_factor", 400);
  set("str", 40);
  set("cor", 40);
  set("cps", 40);
  set("spi", 40);
  set("int", 40);
  set("con", 40);
  set("kar", 40);
  set("per", 100);
  set("dex", 40);
  set("combat_exp", 8000000);
  set("daoxing", 8000000);
  set_skill("literate",300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("stick", 300);
  set("class","taoist");
  set_skill("wuxiangforce", 300);
  set_skill("dao", 300);
  set_skill("jindouyun", 300);
  set_skill("puti-zhi", 300);
  set_skill("qianjun-stick",300);
  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("stick", "qianjun-stick");
  map_skill("parry", "qianjun-stick");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
       (: cast_spell, "light" :),
       (: cast_spell, "thunder" :),
       (: perform_action, "pili" :),
       (: perform_action, "wu" :),
       (: perform_action, "qiankun" :),
  }) );

  set("title", HIR"齐天大圣"NOR);
  set("apply/attack", 100);
  set("apply/defense", 100);
  create_family("方寸山三星洞", 1, "蓝");
  setup();
  carry_object("/d/obj/weapon/stick/fake-jingubang.lpc")->wield();
  carry_object("/d/obj/armor/cloth/shuijin-zhanpao")->wear();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "方寸山三星洞")
  {
    command("say 方寸山弟子我才会考虑！\n");
    return 0;
  }

  if ((int)ob->query("level") < 36)
  {
    command("say 你还要需要更多的磨练！\n");
    return 0;
  }

  if ((int)ob->query("dntg/number") < 10)
  {
    command("say 你一番事业尚未成就，我可不愿收你为徒！\n");
    return 0;
  }

  if ((int)ob->query("obstacle/number") < 34)
  {
    command("say 你尚未取经圆满，我可不愿收你为徒！\n");
    return 0;
  }

  if (!ob->query("family/can_bai/swk"))
  {
    command("shake");
    command("say 没有恩师的推荐，我无心收徒！\n");
    return 0;
  }

  command("hehe");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "taoist")
    ob->set("class", "taoist");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "方寸山三星洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我三星洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "taoist")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解道家之事，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 35)
  {
    command("shake");
    command("say 可惜我讲的，你估计听不懂！看来你需要更多的磨练！\n");
    return 1;
  }

  return 0;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  switch (topic)
  {
    case "乾坤一棒" :
    case "qiankun" :
      if (me->query("family/family_name") != master->query("family/family_name"))
        return "你不是我方寸山的弟子！\n";
      if (me->query("class") != "taoist")
        return "嘿嘿，非我道家弟子，你问我何用？\n";
      if (me->query("family/can_pfm/qiankun"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 800)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("qianjun-stick",1) < 150)
        return "你的道家仙法修为不够，暂时无法领悟！\n";
      if (me->query_skill("wuxiangforce",1) < 150)
        return "你的小无相修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 2000)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/qiankun",1);
      return "你学会了“乾坤一棒”！\n";
      break;

    case "神猴狂舞" :
    case "wu" :
      if (me->query("family/family_name") != master->query("family/family_name"))
        return "你不是我方寸山的弟子！\n";
      if (me->query("class") != "taoist")
        return "嘿嘿，非我道家弟子，你问我何用？\n";
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "pfm"   : "wu",
           "name"   : "神猴狂舞",
           "sk1"    : "qianjun-stick",
           "lv1"    : 220,
           "sk2"    : "wuxiangforce",
           "lv2"    : 220,
           "max_force" : 3300,
           "gongxian": 2000,]));
      break;
  }

  return 0;
}

