#include <ansi.h>
#include "lingtai.h"
inherit NPC;
inherit F_MASTER;
string ask_swk();
string ask_rank();
void create()
{
  set_name(HIW"菩提祖师"NOR, ({"master puti","puti", "master"}));
  set("long", "大觉金仙没垢姿，西方妙相祖菩提\n");
  set("title", HIC"斜月三星"NOR);
  set("gender", "男性");
  set("age", 100);
  set("class", "taoist");
  set("attitude", "friendly");
  set("rank_info/respect", "老师祖");
  set("per", 26);
  set("looking", "玉面多光润，苍髯颌下飘，金睛飞火焰，长目过眉梢。");
  set("int", 30);
  set("max_kee", 8000);
  set("max_sen", 8000);
  set("force", 8000);
  set("max_force", 4000);
  set("force_factor", 200);
  set("max_mana", 4000);
  set("mana", 8000);
  set("mana_factor", 200);
  set("combat_exp", 5000000);
  set("daoxing", 10000000);
  set_skill("literate",300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("whip", 300);
  set_skill("stick", 300);
  set_skill("sword", 300);
  set_skill("wuxiangforce", 300);
  set_skill("dao", 300);
  set_skill("jindouyun", 300);
  set_skill("puti-zhi", 300);
  set_skill("wuwei-fuchen",300);
  set_skill("qitian-stick",300);
  set_skill("liangyi-sword",300);
  set_skill("medical",300);
  set_skill("puti-yaoli",300);
  map_skill("medical","puti-yaoli");

  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("stick", "qitian-stick");
  map_skill("parry", "qitian-stick");
  map_skill("sword", "liangyi-sword");
  map_skill("whip", "wuwei-fuchen");
  set("inquiry", ([
    "职位"    : (: ask_rank :),
    "孙悟空"  : (: ask_swk :),
  ]) );
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
       (: cast_spell, "light" :),
       (: cast_spell, "dingshen" :),
       (: cast_spell, "thunder" :),
       (: perform_action, "pili" :),
  }) );

  create_family("方寸山三星洞", 1, "蓝");
  setup();
  carry_object("/d/lingtai/obj/pao")->wear();
  carry_object("/d/lingtai/obj/shoe")->wear();
  carry_object("/d/lingtai/obj/putibang")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "方寸山三星洞")
  {
    command("say 我只收方寸山弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 32)
  {
    command("say 你还要需要更多的磨练！\n");
    return 0;
  }

  if ((int)ob->query("obstacle/number") < 34)
  {
    command("say 你尚未取经圆满，我还不能收你！\n");
    return 0;
  }

  command("hehe");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "taoist")
    ob->set("class", "taoist");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "方寸山三星洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我三星洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "taoist")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解道家之事，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 32)
  {
    command("shake");
    command("say 可惜我讲的，你估计听不懂！看来你需要更多的磨练！\n");
    return 1;
  }

  if (skill == "qitian-stick")
  {
    if ((int)me->query("dntg/number") < 10)
    {
      command("say 这棒法需要干一番轰轰烈烈的大事情，才可以深刻领会！\n");
      return 1;
    }
  }

  return 0;
}

string ask_swk()
{
  object me;
  me = this_player(1);
  if ((string)me->query("family/family_name") != "方寸山三星洞")
  {
    command("shake");
    return "你问的，我不清楚！\n";
  }

  if (me->query("dntg/number") < 10)
  {
    command("kick");
    return "你连大闹天宫都没有过完，想那么多干什么？\n";
  }

  if (me->query("obstacle/number") < 34)
  {
    command("kick");
    return "你连西行取经都没有结束，想那么多干什么？\n";
  }

  if ((int)me->query("level") > 30)
  {
    command("hmm");
    command("say 我这个弟子现在在哪儿呢？\n");
    if ((int)me->query("family/family_faith") < 3000)
      return "你还是先安心的为本门尽力吧！\n";
    command("say 你去找到他，也许看在我的面子上，他会教你一招半式！\n");
    me->set("family/can_bai/swk",1);
    return "你这就去吧！\n";
  }

  command("say 你还是先安心的修炼吧！\n");
  command("sigh2");
  return "快快自己修炼去吧！\n";
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我方寸山的弟子！\n";

  if (me->query("class") != "taoist")
    return "嘿嘿，非我道家弟子，你问我何用？\n";

  switch (topic)
  {
    case "历练" :
    case "历炼" :
    case "锻炼" :
      return QUEST_D->accept_ask(master, me, topic);
      break;

//dao
    case "苍灵箭" :
    case "light" :
      if (me->query("family/can_cast/light"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("dao",1) < 100)
        return "你的道家仙法修为不够，暂时无法领悟！\n";
      if (me->query("max_mana") < 1000)
        return "你的法力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_cast/light",1);
      return "你学会了“苍灵箭”！\n";
      break;
    case "定身法" :
    case "dingshen" :
      if (me->query("family/can_cast/dingshen"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("dao",1) < 120)
        return "你的道家仙法修为不够，暂时无法领悟！\n";
      if (me->query("max_mana") < 1500)
        return "你的法力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_cast/dingshen",1);
      return "你学会了“定身法”！\n";
      break;

    case "五雷咒" :
    case "thunder" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "cast"   : "thunder",
           "name"   : "五雷咒",
           "sk1"    : "dao",
           "lv1"    : 120,
           "max_mana" : 1500,
           "gongxian": 500,]));
      break;

//puti-stick
    case "霹雳三打" :
    case "pili" :
      if (me->query("family/can_pfm/pili"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("puti-stick",1) < 80)
        return "你的道家仙法修为不够，暂时无法领悟！\n";
      if (me->query_skill("wuxiangforce",1) < 80)
        return "你的小无相修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 1000)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/pili",1);
      return "你学会了“霹雳三打”！\n";
      break;
//qitian-stick
    case "谈笑退天兵" :
    case "tanxiao" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "pfm"    : "tanxiao",
           "name"   : "谈笑退天兵",
           "sk1"    : "qitian-stick",
           "lv1"    : 150,
           "sk2"    : "wuxiangforce",
           "lv2"    : 150,
           "max_force" : 2000,
           "gongxian": 500,]));
      break;
//liangyi-sword
    case "乱气剑" :
    case "luan" :
      if (me->query("family/can_pfm/luan"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 800)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("liangyi-sword",1) < 150)
        return "你的两仪剑法修为不够，暂时无法领悟！\n";
      if (me->query_skill("wuxiangforce",1) < 150)
        return "你的小无相修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 2000)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/luan",1);
      return "你学会了“乱气剑”！\n";
      break;
//wuwei-fuchen
    case "清心除邪" :
    case "qingxin" :
      if (me->query("family/can_pfm/qingxin"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("wuwei-fuchen",1) < 120)
        return "你的道家仙法修为不够，暂时无法领悟！\n";
      if (me->query_skill("wuxiangforce",1) < 120)
        return "你的小无相修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 1800)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/qingxin",1);
      return "你学会了“清心除邪”！\n";
      break;

    case "淡然若定" :
    case "danran" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "pfm"    : "danran",
           "name"   : "淡然若定",
           "sk1"    : "wuwei-fuchen",
           "lv1"    : 150,
           "sk2"    : "wuxiangforce",
           "lv2"    : 150,
           "max_force" : 2000,
           "gongxian": 500,]));
      break;
//wuxiangforce
    case "借力打力" :
    case "jldl" :
      if (me->query("family/can_exert/jldl"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 800)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("wuxiangforce",1) < 120)
        return "你的小无相修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 1500)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_exert/jldl",1);
      return "你学会了“借力打力”！\n";
      break;
  }

  return 0;
}

string ask_rank()
{
  object master = this_object();
  object who = this_player();
  int t = time();

  if (who->is_busy() || who->is_fighting())
    return "你正忙着呢！\n";

  if (t - (int)who->query("last_ask_rank") < 7200)
    return "你不是刚刚问过了吗？\n";

  if (!RANK_D->re_title(master,who))
    return "你无法从我这里获得称号！\n";

  who->set("last_ask_rank",t);
  who->start_busy(1);
  return sprintf("%s 点了点头！\n",master->name());
}

