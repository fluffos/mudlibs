#include <ansi.h>
#include "lingtai.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("云阳真人", ({"master yunyang", "master", "yunyang"}));
  set("long", "云阳真人与菩提祖师实是半师半友，也是三星洞内外总管．"
              "因其壮年时降魔除妖无数，人称「小天师」．\n");
  set("gender", "男性");
  set("title", "小天师");
  set("class", "taoist");
  set("age", 70);
//  set("attitude", "friendly");
  set("rank_info/respect", "老道长");
  set("per", 30);
  set("int", 30);
  set("str", 30);
  set("cps", 30);
  set("spi", 30);
  set("dex", 30);

  set("max_kee", 2500);
  set("max_sen", 2500);
  set("force", 4500);
  set("max_force", 2200);
  set("force_factor", 100);
  set("max_mana", 2200);
  set("mana", 4500);
  set("mana_factor", 110);
  set("combat_exp", 1500000);
  set("daoxing", 1500000);

  set_skill("literate",200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("whip", 200);
  set_skill("stick", 200);
  set_skill("sword", 200);
  set_skill("wuxiangforce", 200);
  set_skill("dao", 200);
  set_skill("jindouyun", 200);
  set_skill("puti-zhi", 200);
  set_skill("wuwei-fuchen",200);
  set_skill("puti-stick",200);
  set_skill("liangyi-sword",200);
  set_skill("medical",200);
  set_skill("puti-yaoli",200);
  set_skill("qitian-stick",120);
  map_skill("medical","puti-yaoli");

  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("whip", "wuwei-fuchen");
  map_skill("parry", "wuwei-fuchen");
  map_skill("sword", "liangyi-sword");
  map_skill("stick", "puti-stick");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "whip.danran" :),
    (: perform_action, "whip.qingxin" :),
    (: cast_spell, "light" :),
    (: cast_spell, "dingshen" :),
    (: cast_spell, "thunder" :)
  }) );
  create_family("方寸山三星洞", 2, "蓝");
  setup();
  carry_object("/d/obj/armor/cloth/xiangpao")->wear();
  carry_object("/d/obj/armor/shoes/yunxie")->wear();
  carry_object("/d/lingtai/obj/daoguan")->wear();
  carry_object("/d/obj/weapon/whip/fuchen")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "方寸山三星洞")
  {
    command("say 我只收方寸山弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 25)
  {
    command("say 你还要需要更多的磨练！\n");
    return 0;
  }

  command("hehe");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "taoist")
    ob->set("class", "taoist");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "方寸山三星洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我三星洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "taoist")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解道家之事，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 25)
  {
    command("shake");
    command("say 可惜我讲的，你估计听不懂！看来你需要更多的磨练！\n");
    return 1;
  }

  return 0;
}

