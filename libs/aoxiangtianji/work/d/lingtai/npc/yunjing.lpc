#include <ansi.h>
#include "lingtai.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("云静", ({"yun jing", "yun"}));
  set("gender", "男性" );
  set("age", 33);
  set("long", "方寸山三星洞第四代弟子中的杰出人物．\n");
  set("int", 25);
  set("str", 30);
  set("per", 30);
  set("attitude", "peaceful");
  set("class", "taoist");
  set("combat_exp", 100000);
  set("daoxing", 100000);
  set("max_kee", 1100);
  set("max_sen", 1100);
  set("force", 1200);
  set("max_force", 800);
  set("force_factor", 30);
  set("mana", 1500);
  set("max_mana", 800);
  set("mana_factor", 40);
  set_skill("literate",90);
  set_skill("force", 90);
  set_skill("spells", 90);
  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("parry", 90);
  set_skill("stick", 90);
  set_skill("wuxiangforce", 90);
  set_skill("dao", 90);
  set_skill("jindouyun", 90);
  set_skill("puti-zhi", 90);
  set_skill("puti-stick",90);
  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("stick", "puti-stick");
  map_skill("parry", "puti-stick");
  create_family("方寸山三星洞", 4, "弟子");
  setup();
  carry_object("/d/lingtai/obj/daoguan")->wear();
  carry_object("/obj/cloth/dao-cloth")->wear();
  carry_object("/d/obj/weapon/stick/qimeigun")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (stringp(myfam))
  {
    if (myfam == "方寸山三星洞")
    {
      command("say 不敢当，不敢当！\n");
    }

    return 0;
  }

  command("hehe");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "taoist")
    ob->set("class", "taoist");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "方寸山三星洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我三星洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "taoist")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解道家之事，我教的恐怕不能理解。",myname));
    return 1;
  }

  return 0;
}