#include <ansi.h>
#include "lingtai.h"
inherit NPC;
inherit F_MASTER;
int borrow_me(object ob);
int borr_me(object ob);
void create()
{
  set_name("广羲子", ({"guang xizi", "guang"}));
  set("title", "经阁总管");
  set("gender", "男性" );
  set("age", 53);
  set("long", "一个看起来慈眉善目的道士，正拿着一本经书读着．\n");

  set("combat_exp", 600000);
  set("daoxing", 600000);
  set("per", 30);
  set("str", 25);
  set("spi", 30);
  set("int", 25);
  set("dex", 30);
  set("attitude", "peaceful");
  set("class", "taoist");

  set("max_kee", 1500);
  set("max_sen", 1500);
  set("force", 2200);
  set("max_force", 1200);
  set("force_factor", 50);
  set("mana", 2400);
  set("max_mana", 1200);
  set("mana_factor", 60);
  set_skill("literate",150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("whip", 150);
  set_skill("wuxiangforce", 150);
  set_skill("dao", 150);
  set_skill("jindouyun", 150);
  set_skill("puti-zhi", 150);
  set_skill("wuwei-fuchen",150);
  set_skill("medical",150);
  set_skill("puti-yaoli",150);
  map_skill("medical","puti-yaoli");

  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("whip", "wuwei-fuchen");
  map_skill("parry", "wuwei-fuchen");
  create_family("方寸山三星洞", 3, "弟子");
  set("inquiry", ([
    "book": "这里大多是我们道教经典，也有些平常书籍。",
    "千字文": (: borrow_me :),
    "道德经": (: borr_me :),
  ]) );
  set("chat_chance", 5);
  set("chat_msg", ({
    "广羲子笑道：我这人最爱吃松果了！\n",
  }));
  setup();
  carry_object("/obj/cloth/dao-cloth")->wear();
  carry_object("/d/obj/armor/shoes/yunxie")->wear();
  carry_object("/d/lingtai/obj/daoguan")->wear();
  carry_object("/d/obj/weapon/whip/fuchen")->wield();
}

int borr_me(object ob)
{
  object m;
  ob = this_player();
  if ((string)this_player()->query("family/family_name")=="方寸山三星洞")
  {
    if ( this_player()->query("pending/book"))
    {
      message_vision("$N对$n说：上次借的还没还，怎么好再借给你呢？\n", this_object(), ob);
      return 1;
    }

    if( (int)this_player()->query_skill("literate", 1) < 10 )
    {
      message_vision("$N对$n说：你读书写字太差，借给你恐怕也看不懂啊。\n", this_object(), ob);
      return 1;
    }

    if ( (int)this_object()->query("daode") )
    {
      message_vision("$N一拱手，说：刚借出去，明天再来吧！\n", this_object());
      return 1;
    }

    m = new("/d/obj/book/daode");
    m->set("owner",ob->query("id"));
    m->move(ob);
    ob->set("pending/book", 1);
    this_object()->set("daode", 1);
    message_vision("$N从架上拿下本书来递给$n，说：记住要还唷！\n", this_object(), ob);
    return 1;
  }

  message_vision("$N说：我们这里的书不外借！\n", this_object());
  return 1;
}

int borrow_me(object ob)
{
  object m;
  ob = this_player();
  if ((string)this_player()->query("family/family_name")=="方寸山三星洞")
  {
    if ( this_player()->query("pending/book"))
    {
      message_vision("$N对$n说：上次借的还没还，怎么好再借给你呢？\n", this_object(), ob);
      return 1;
    }

    if( (int)this_player()->query_skill("literate", 1) < 10 )
    {
      message_vision("$N对$n说：你读书写字太差，借给你恐怕也看不懂啊。\n", this_object(), ob);
      return 1;
    }

    if ( (int)this_object()->query("qian") )
    {
      message_vision("$N一拱手，说：刚借出去，明天再来吧！\n", this_object());
      return 1;
    }

    m=new("/d/obj/book/qian");
    m->move(ob);
    m->set("owner",ob->query("id"));
    ob->set("pending/book", 1);
    this_object()->set("qian", 1);
    message_vision("$N从架上拿下本书来递给$n，说：记住要还唷！\n", this_object(), ob);
    return 1;
  }

  message_vision("$N说：我们这里的书不外借！\n", this_object());
  return 1;
}

int accept_object(object who,object ob)
{
  if (!ob->is_character() && ob->query("id")=="qian")
  {
    if ( this_player()->query("pending/book") )
    {
      say("广羲子哈哈笑了几声，好借好还，再借不难！\n");
      who->set("pending/book", 0);
      this_object()->delete("qian");
      destruct(ob);
      return 1;
    }

    else
      say("广羲子笑道：多谢，多谢！\n");
    destruct(ob);
    return 1;
  }

  if (!ob->is_character() && ob->query("id")=="daodejing")
  {
    if ( this_player()->query("pending/book") )
    {
      say("广羲子哈哈笑了几声，好借好还，再借不难！\n");
      who->set("pending/book", 0);
      this_object()->delete("daode");
      destruct(ob);
      return 1;
    }

    else
      say("广羲子笑道：多谢，多谢！\n");
    destruct(ob);
    return 1;
  }

  if (!ob->is_character() && ob->query("id")=="song guo")
  {
    say("广羲子笑道：多谢，多谢！我最爱吃了！\n");
    who->set("pending/book", 0);
    destruct(ob);
    return 1;
  }

  return 0;
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  myfam = (string)ob->query("family/family_name");
  if (myfam != "方寸山三星洞")
  {
    command("say 我只收方寸山弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 15)
  {
    command("say 你还要需要更多的磨练！\n");
    return 0;
  }

  command("hehe");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "taoist")
    ob->set("class", "taoist");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "方寸山三星洞")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我三星洞弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "taoist")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解道家之事，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 15)
  {
    command("shake");
    command("say 可惜我讲的，你估计听不懂！看来你需要更多的磨练！\n");
    return 1;
  }

  return 0;
}

