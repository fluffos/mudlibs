inherit MIDDLEROOM;
inherit LANDROOM;
inherit TEMPLEROOM;
void create()
{
  set("short", "白云庵");
  set("long", @LONG
庵内供奉白衣观世音，除地上一个蒲团，四
壁萧然。见性峰峰高绝顶，有人到此确实比
较难。
LONG);
  set("exits", ([
    "south"  : __DIR__"square",
  ]));
  set("objects", ([
    sprintf("/obj/npc/daogu%d", 1+random(3)) : 1,
  ]));
  setup();
}

