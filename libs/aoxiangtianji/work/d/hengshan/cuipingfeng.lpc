inherit SMALLROOM;
inherit HILLROOM;
void create()
{
  set("short", "翠屏峰");
  set("long", @LONG
你爬上了翠屏峰，这翠屏峰是恒山主峰的西峰。树木
遮天，难见天日。山林静谧，隐隐晨钟轻敲，一切尘
俗尽皆洗尽，山深有静气，恒山本色。
LONG
);
  set("exits", ([
    "southdown" : __DIR__"cuiping2",
  ]));
  set("outdoors", "hengshan");
  set("no_clean_up", 0);
  setup();
}

