#include <room.h>
inherit RIVER;
void create()
{
  set("short", "黄河岸边");
  set("long", @LONG
这里是黄河岸边。黄河流淌到这里，已经泥沙浑浊了。黄色的河水
在河床里翻滚着，咆哮着，卷起一个个巨大的漩窝。
LONG );
  set("arrive_room", "/d/yangzhou/nroad4");

  set("exits", ([
    "southeast" : __DIR__"nroad3",
    "east"  : __DIR__"huanghe2",
  ]));
  set("resource/fish", ({ "/obj/fish/liyu",
                          "/obj/fish/jiyu",
                          "/obj/fish/qingyu",
                          "/obj/fish/caoyu", }));
  set("no_clean_up", 0);
  set("outdoors", "huanghe");
  set("room_size","big");
  setup();
}

