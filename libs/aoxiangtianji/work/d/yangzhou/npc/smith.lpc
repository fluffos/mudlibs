// smith.c
#include <ansi.h>
inherit "/std/char/smith.lpc";
#define WEAP "/d/obj/weapon/"
void create()
{
  set_name("铁匠", ({ "tie jiang", "tie", "smith" }));
  set("title", "铁匠铺老板");
  set("shen_type", 1);
  set("gender", "男性" );
  set("age", 33);
  set("long", "铁匠正用铁钳夹住一块红热的铁块放进炉中。\n");
  set("combat_exp", 400);
  set("attitude", "friendly");
  set("vendor_goods",([
     "1" : WEAP"sword/changjian",
     "2" : WEAP"hammer/hammer",
     "3" : WEAP"blade/tudao",
     "4" : WEAP"dagger/dagger",
     "5" : WEAP"stick/tiegun",
     "6" : WEAP"blade/gangdao",
     "7" : WEAP"archery/arrow",
     "8" : WEAP"archery/wolfarrow",
     "9" : WEAP"bow/bow",
     "10" : WEAP"bow/longbow",
     "11" : WEAP"blade/short-blade",
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

