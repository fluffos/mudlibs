// zeng.c
#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
#define MAX_EXP 50000
string ask_job();
int  working(object me);
int  halt_working(object me);
string ask_cloth();
string *c1 = ({ __DIR__"cloth/belt",
                __DIR__"cloth/boots",
              });

string *c2 = ({
                __DIR__"cloth/bu-shoes",
                __DIR__"cloth/cloth",
             });

string *c3 = ({
               __DIR__"cloth/color-dress",
               __DIR__"cloth/fu-cloth",
             });

string *c4 = ({
                __DIR__"cloth/gui-dress",
                __DIR__"cloth/hat",
             });
string *c5 = ({
                __DIR__"cloth/jade-belt",
                __DIR__"cloth/liu-dress",
             });

string *c6 = ({
                __DIR__"cloth/marry-dress",
                __DIR__"cloth/mini-dress",
             });
string *c7 = ({
                __DIR__"cloth/moon-dress",
                __DIR__"cloth/pink-dress",
             });
string *c8 = ({
               __DIR__"cloth/qi-dress",
               __DIR__"cloth/red-dress",
             });
string *c9 = ({
                __DIR__"cloth/scarf",
                __DIR__"cloth/sha-dress",
             });
string *c10 = ({
                __DIR__"cloth/shoes",
                __DIR__"cloth/xian-cloth",
             });
string *c11 = ({
                __DIR__"cloth/xiu-cloth",
                __DIR__"cloth/xiu-scarf",
             });
string *c12 = ({
                __DIR__"cloth/yan-dress",
                __DIR__"cloth/zi-dress",
                __DIR__"cloth/feature",
             });
void create()
{
  set_name("柔心", ({ "rou xin", "rou", "xin" }));
  set("gender", "女性");
  set("age", 16);
  set("per", 25);
  set("con", 25);
  set("int", 25);
  set("dex", 25);
  set("str", 25);
  set_skill("unarmed", 60);
  set_skill("changquan", 60);
  set_skill("sew",201);
  map_skill("unarmed", "changquan");
  set_temp("apply/damage", 15);
  set("combat_exp", 500000);
  set("attitude", "friendly");
  set("vendor_goods", ([
    "1" : element_of(c1),
    "2" : element_of(c2),
    "3" : element_of(c3),
    "4" : element_of(c4),
    "5" : element_of(c5),
    "6" : element_of(c6),
    "7" : element_of(c7),
    "8" : element_of(c8),
    "9" : element_of(c9),
    "10" : element_of(c10),
    "11" : element_of(c11),
    "12" : element_of(c12),
  ]));

  set("inquiry", ([
    "工作" : (: ask_job :),
    "job"  : (: ask_job :),
    "时尚" : (: ask_cloth :),
    "衣服" : (: ask_cloth :),
  ]));
  set("force_clear",1);
  setup();
  carry_object(__DIR__"cloth/feature")->wear();
}

void init()
{
  add_action("do_vendor_list", "list");
  add_action("do_sew", "sew");
}

int recognize_apprentice(object ob, string skill)
{
  if ((int)ob->query_temp("mark/柔心") < 1)
    return 0;
  if (skill != "sew")
  {
    command("say 我...我可只会做衣服。\n");
    return -1;
  }

  ob->add_temp("mark/柔心", -1);
  return 1;
}

int accept_object(object who, object ob)
{
  if ((int)who->query_temp("mark/柔心") < 1)
    who->set_temp("mark/柔心", 0);
  if (ob->query("money_id") && ob->value() >= 2000)
  {
    message_vision("柔心同意指点$N一些做衣服的常识和技巧。\n", who);
    who->add_temp("mark/柔心", ob->value() / 50);
    destruct(ob);
    return 1;
  }

  command("say 你最少要付了二十两银子才可以和我学习做衣服。\n");
  return 0;
}

string ask_job()
{
  object me;
  object *obs;
  me = this_player();
  if (me->query_temp("job/sew"))
    return "让你做的衣服你弄好了么？";
  if (me->query("gender") != "女性")
    return "这女孩子家的活你也来干？";
  if (me->query("combat_exp") < 50)
    return "让你在我这儿干活我还真有点不放心。";
  if (me->query("combat_exp") > 150000)
    return "大侠您好，您还是看见什么好的自己选件吧，让您干活也太委屈了！";
  if (me->query("kee") < 30)
    return "你脸色这么差，还是先歇会儿吧。";
  if (me->query("sen") < 30)
    return "你精神头不行啊，别把我得料子糟踏了！";
  if (me->query_skill("sew",1) < 30)
    return "你的缝制手艺那么差，那里能帮我？";
  if (me->query_int() < 20)
    return "嘻嘻...你这么笨手笨脚的，也会做衣服？";
  if (! interactive(me))
    return "...";
  obs = filter_array(all_inventory(environment()),
                      (: interactive($1) &&
                         $1 != $(me) &&
                         $1->query_temp("job/sew") &&
                         query_ip_number($1) == query_ip_number($(me)) :));
  if (sizeof(obs) > 0)
    return "现在已经有" + obs[0]->name() + "在帮我啦，不劳你了。";
  me->set_temp("job/sew", 1);
  return "好，你就帮我做点裁缝(sew)的小活吧！喏，东西都在这儿。";
}

int do_sew(string arg)
{
  object me;
  me = this_player();
  if (me->is_busy())
    return notify_fail("你正忙着呢，别着急。\n");
  if (! me->query_temp("job/sew"))
  {
    message_vision("$N偷偷的拿起一个顶针，$n一声娇吒道："
                   "你给我放下，有什么好玩的？\n",
                   me, this_object());
    return 1;
  }

  me->set_temp("job/step", 1);
  me->start_busy((: working :),(: halt_working :));
/*
  me->start_busy(bind((: call_other, __FILE__, "working" :), me),
                 bind((: call_other, __FILE__, "halt_working" :), me));
*/
  tell_object(me, "你开始缝纫。\n");
  return 1;
}

int working(object me)
{
  string msg;
  int finish;
  int b;
  if (! me->query_temp("job/step"))
    me->set_temp("job/step", 1);
  if (! living(me))
  {
    me->delete_temp("job/sew");
    me->delete_temp("job/step");
    return 0;
  }

  finish = 0;
  me->receive_damage("sen", 1);
  me->receive_damage("kee", 2);
  switch (me->query_temp("job/step"))
  {
    case 1:
      msg = "$N戴上一个顶针，摸出针线。";
      break;
    case 2:
      msg = "$N展开布料，对着样子比划了半天。";
      break;
    case 3:
      msg = "$N轻轻的折了折料子，留下几条痕印。";
      break;
    case 4:
    case 6:
      msg = "$N专心致志的一针一线的缝纫。";
      break;
    case 5:
      msg = "$N凝眉看了看样子，若有所思。";
    case 7:
      msg = "$N轻动纤纤细指，缝针上下穿梭，衣服的模样渐渐的出来了。";
      break;
    default:
      msg = "$N把衣服缝好，烫熨完毕，叠好递给$n。";
      finish = 1;
      break;
  }

  msg += "\n";
  message_vision(msg,me,this_object());

  if (finish)
  {
    object ob;
    msg += "$n看了$N缝出来的衣服，点头道：不错，有点意思。\n";
    me->delete_temp("job/sew");
    me->delete_temp("job/step");
    me->add_temp("mark/柔心", random(30));
    me->improve_skill("sew", 10 + random(10));
    if (me->query("combat_exp") <= 150000)
    {
      b = 20 + random(15);
      if ((int)me->query("work/newbie_sew/exp") > MAX_EXP)
        b = 0;
      GIFT_D->delay_work_bonus(me,([ "exp" : b,
                                      "pot" : b/2,
                                      "prompt" : "通过这次裁缝经历",
                                   ]),"newbie_sew");
      if (me->query_skill("sew", 1) < 50)
        me->improve_skill("sew", (b + 1)/3);
    }

    else
      b = 0;
    ob = new("/obj/money/coin");
    ob->set_amount(30 + random(30));
    ob->move(me, 1);
    return 0;
  }

  me->add_temp("job/step", 1);
  return 1;
}

int halt_working(object me)
{
  message_vision("$N把手中的针线一扔，嘀咕道："
                 "没劲，本姑娘不干了！\n", me);
  me->delete_temp("job/sew");
  me->delete_temp("job/step");
  return 1;
}

string ask_cloth()
{
  string *cloth = ({ });
  string c,msg;
  int i;

  cloth += c1;
  cloth += c2;
  cloth += c3;
  cloth += c4;
  cloth += c5;
  cloth += c6;
  cloth += c7;
  cloth += c8;
  cloth += c9;
  cloth += c10;
  cloth += c11;
  cloth += c12;
  cloth -= ({0});

  msg = "本店共有如下时尚服饰：\n\n";
  i = 0;
  foreach (c in cloth)
  {
    i++;
    msg += sprintf("%d：%s\n",i,c->query("name"));
  }

  msg += "\n";
  msg += "质量优良，供不应求，请list查看现有货品。\n";
  msg += "敬请随时关注本店，如果现在无法买到自己想要的货品，请以后再来！\n\n";
  return msg;
}

