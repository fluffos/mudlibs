// zi-dress.c example cloth
#include <ansi.h>
#include <armor.h>
inherit SKIRTS;
void create()
{
  set_name( HIM "紫绫纱湘裙" NOR, ({ "shaxiang qun", "shaxiang", "qun" }) );
  set_weight(700);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("value", 2000);
    set("material", "cloth");
    set("female_only", 1);
    set("wear_msg","$N穿上一件$n。\n");
    set("remove_msg","$N将$n脱了下来。\n");
  }

  init_skirts(8);
  setup();
}

