// marry-dress.c example cloth
#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create()
{
  set_name( HIR "结婚礼服" NOR, ({ "jiehun lifu", "lifu", "jiehun" }) );
  set_weight(700);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("value", 20000);
    set("material", "cloth");
    set("wear_msg","$N穿上一件$n。\n");
    set("remove_msg","$N将$n脱了下来。\n");
  }

  init_cloth(5);
  setup();
}

