#include <ansi.h>
#include <armor.h>
inherit BOOTS;
void create()
{
  set_name(YEL "羊皮靴" NOR, ({ "yangpi xue", "yangpi", "xue" }) );
  set_weight(1500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "双");
    set("value", 1200);
    set("material", "leather");
    set("armor_prop/dodge", 2);
    set("wear_msg","$N穿上一双$n。\n");
    set("remove_msg","$N将$n脱了下来。\n");
  }

  init_boots(5);
  setup();
}

