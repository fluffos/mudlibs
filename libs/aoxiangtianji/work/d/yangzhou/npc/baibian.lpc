#include <ansi.h>
inherit NPC;
void create()
{
  seteuid(getuid());
  set_name("张三", ({ "zhang san", "zhang", "san", "bai bian" }) );
  set("title", HIY "百变道人" NOR);
  set("gender", "男性" );
  set("age", 50);
  set("long", "一位邋邋遢遢的道士。\n");
  set("attitude", "heroism");
  set("class", "taoist");
  set("str", 21);
  set("con", 30);
  set("int", 27);
  set("dex", 23);
  set("spi", 25);
  set("max_kee", 1600);
  set("max_sen", 1600);
  set("force", 2000);
  set("max_force", 1000);
  set("force_factor", 30);
  set("mana", 2000);
  set("max_mana", 1000);
  set("mana_factor", 30);

  set("env/wimpy", 60);
  set_temp("apply/attack",  10);
  set_temp("apply/defense", 20);
  set("combat_exp", 250000);
  set_skill("force", 100);
  set_skill("unarmed", 100);
  set_skill("stick", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("puti-zhi", 100);
  set_skill("puti-stick", 100);
  set_skill("wuxiangforce", 100);
  set_skill("jindouyun", 100);
  set_skill("spells", 120);
  set_skill("dao", 120);
  map_skill("force", "wuxiang");
  map_skill("unarmed","puti-zhi");
  map_skill("parry", "puti-stick");
  map_skill("stick", "puti-stick");
  map_skill("dodge", "jindouyun");
  map_skill("spells", "dao");
  create_family("方寸山三星洞", 3, "弟子");
  set("chat_chance", 20);
  set("chat_msg", ({
        (: random_move :)
  }) );
  setup();
  carry_object("/obj/cloth/dao-cloth")->wear();
  carry_object("/obj/cloth/dao-xie")->wear();
  carry_object("/d/obj/weapon/stick/bintiegun")->wield();
  add_money("silver", 3);
}

void init()
{
  object ob, me;
  string temp_str ;
  me = this_object();
  ob = this_player();
  ::init();
  if (me->is_fighting() || wizardp(ob)) return;
  remove_call_out("pretending");
  call_out("pretending", 1, ob);
  temp_str = UPEXP_D->query_upexp(me);
  temp_str = UPEXP_D->query_upexp(ob);
  if (me->query("level") < ob->query("level"))
    NPC_D->set_from_me(me,ob,105);
}

void pretending(object ob)
{
  object me = this_object();

  if (!objectp(ob) || environment(ob) != environment()) return;
  switch(random(3))
  {
    case 0:
      command("grin " + ob->query("id"));
      command("bian " + ob->query("id"));
      command("exert recover");
      break;
    case 1:
      command("hi " + ob->query("id"));
      command("exert heal");
      command("exert recover");
      break;
    case 2:
      command("stare " + ob->query("id"));
      me->fight_ob(ob);
      ob->fight_ob(me);
      break;
  }

}

