  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/damage", 15);
  set("combat_exp", 40000);
  set("attitude", "friendly");
  set("vendor_goods", ([
    "1" : "/obj/cloth/cuttonp",
    "2" : "/d/obj/misc/mabudai",
    "3" : "/obj/cloth/beixin",
    "4" : "/d/obj/armor/head/toukui",
    "5" : "/d/obj/armor/neck/cycle",
    "6" : "/d/obj/armor/surcoat/surcoat",
    "7" : "/d/obj/armor/shield/shield",
    "8" : "/d/obj/armor/wrists/huwan",
    "9" : "/d/obj/armor/hands/zhitao",
    "10" : "/d/obj/armor/waist/huyao",
    "11" : "/d/obj/armor/shoes/caoxie",
    "12" : "/d/obj/armor/shoes/pixue",
    "13" : "/d/obj/armor/hands/shoutao",
    "14" : "/d/obj/armor/hands/tieshou",
    "15" : "/d/obj/armor/armor/jinsijia",
    "16" : "/d/obj/misc/wood",
    "17" : "/d/obj/misc/shoeshine",
    "18" : "/d/obj/misc/brush",
    "19": "/d/qujing/huangfeng/obj/tables",
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

