#include <ansi.h>
inherit "/obj/npc/bank-npc";
void create()
{
  set_name("钱眼开", ({"qian yankai", "qian", "yankai"}));
  set("title", "钱庄老板");
  set("nickname", "铁公鸡");
  set("gender", "男性");
  set("age", 34);
  set("str", 22);
  set("int", 24);
  set("dex", 18);
  set("con", 18);
  set("kee", 5000);
  set("max_kee", 5000);
  set("sen", 5000);
  set("max_sen", 5000);
  set("combat_exp", 500000);
  set("attitude", "friendly");
  set("env/wimpy", 50);
  set("chat_chance", 1);
  set("chat_msg", ({
    CYN "钱眼开骄傲的说道：本银号已经有上百年的历史，在江南可以说是第一家。\n" NOR,
    CYN "钱眼开笑着说道：在本店存钱无利息，取钱也不收手续费，客官您看着办吧。\n" NOR
  }));
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/damage", 40);

  carry_object("/obj/cloth/choupao")->wear();
  setup();
}