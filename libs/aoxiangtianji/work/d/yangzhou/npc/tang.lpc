#include <ansi.h>
inherit "/obj/npc/dangpu-npc";
void create()
{
  set_name("唐楠", ({ "tang nan", "tang", "nan" }));
  set("title", "当铺老板");
  set("gender", "男性");
  set_max_encumbrance(100000000);
  set("age", 35);
  set("str", 100);
  set("long", "据说唐楠是四川唐家的后代。\n");
  set("no_get_from", 1);
  set("max_kee", 5000);
  set("kee", 5000);
  set("max_sen", 5000);
  set("sen", 5000);

  set_skill("unarmed", 60);
  set_skill("dodge", 500);
  set_temp("apply/attack", 30);
  set_temp("apply/attack", 30);
  set_temp("apply/damage", 15);
  set("combat_exp", 500000);
  set("attitude", "friendly");
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}