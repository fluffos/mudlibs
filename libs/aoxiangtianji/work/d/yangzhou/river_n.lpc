inherit BIGROOM;
inherit WATERROOM;
void create()
{
  set("short", "长江渡口");
  set("long", @LONG
这里是长江岸边。烟波浩渺的江面上，点点渔帆来回穿梭。
LONG );
  set("exits", ([
    "north" : __DIR__"nanmen",
    "south" : __DIR__"river_s",
  ]));
  set("resource/fish", ({ "/obj/fish/liyu",
                          "/obj/fish/jiyu",
                          "/obj/fish/qingyu",
                          "/obj/fish/caoyu", }));
  set("no_clean_up", 0);
  setup();
}

