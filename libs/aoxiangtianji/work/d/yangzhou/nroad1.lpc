inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "大官道");
  set("long", @LONG
这是一条宽阔笔直，尘土飞扬的大官道，足可容得下十马并驰。往南
已经可以看见扬州城的巍巍城墙，望北直通向中原腹地。
LONG);
  set("outdoors", "yangzhou");
