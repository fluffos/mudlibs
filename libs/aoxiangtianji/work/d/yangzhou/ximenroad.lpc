inherit BIGROOM;
inherit LANDROOM;
void create()
{
  set("short", "西门大道");
  set("long", @LONG
这里是扬州西城门外大道。向东就是西门了。望西南
弯曲而下，通往荆州重镇。
LONG );
  set("outdoors", "city");
  set("exits", ([
    "east"  : __DIR__"ximen",
    "southwest" : "/d/jingzhou/road1",
  ]));
  set("objects", ([
    sprintf("/obj/npc/boy%d", 1+random(3)) : 1,
  ]));
  setup();
}