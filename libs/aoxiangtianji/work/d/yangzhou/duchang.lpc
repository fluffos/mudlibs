inherit MIDDLEROOM;
inherit LANDROOM;
void create()
{
  set("short", "赌场");
  set("long", @LONG
这里是赌场的大堂，四周的房间里传出来吆五喝六的赌博
声。这个赌场规模虽算不上很大，但赌的种类却很齐全，服务
也非常周到。
LONG );
  set("objects", ([
     "/obj/npc/duke" : 1,
     "/obj/npc/haoke" : 1,
     "/obj/npc/dipi" : 1,
  ]));
  set("exits", ([
    "west" : __DIR__"daxiao",
    "up"   : __DIR__"duchang2",
    "north": __DIR__"bet",
    "east" : __DIR__"nandajie1",
  ]));
