// seller.c
inherit "/obj/npc/xiaofan";
void create()
{
  set_name("华山小贩", ({ "huashan xiao fan","seller" }) );
  set("gender", "男性" );
  set("age", 32);
  set("vendor_goods", ([
     "1" : "/d/huashan/obj/rice",
     "2" : "/d/huashan/obj/soup",
  ]));
  set("chat_chance", 20);
  set("chat_msg", ({
      (:random_move:),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 10);
}

