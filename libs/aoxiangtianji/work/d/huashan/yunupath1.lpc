inherit SMALLROOM;
inherit WOODROOM;
void create()
{
  set("short","玉女峰山路");
  set("long",@LONG
这里是玉女峰后山的一条山路。路边长满了翠竹，每当微风拂过
，竹叶便沙沙作响，显得分外的幽静。
LONG);
  set("outdoors", "huashan");
  set("no_clean_up", 0);
  set("exits",([
    "southup"  : __DIR__"yunupath2",
    "northup"  : __DIR__"yunu",
  ]));
  setup();
}

