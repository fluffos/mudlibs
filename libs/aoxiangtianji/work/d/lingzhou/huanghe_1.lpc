inherit RIVER;
void create()
{
  set("short", "黄河");
  set("long", @LONG
黄河沿蒙古高原南边向东流淌，遇太行山脉的阻拦，便转头南下，
形成晋陕的分界。东北方向好象有个渡口。
LONG );
  set("arrive_room", "/d/city/weifen");

  set("exits", ([
    "west"      : __DIR__"hetao",
  ]));
  set("resource/fish", ({ "/obj/fish/liyu",
                          "/obj/fish/jiyu",
                          "/obj/fish/qingyu",
                          "/obj/fish/caoyu", }));
  set("no_clean_up", 0);
  set("outdoors", "huanghe");
  set("room_size","big");
  setup();
}

