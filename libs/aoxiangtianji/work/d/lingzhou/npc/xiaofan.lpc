inherit "/obj/npc/xiaofan";
void create()
{
  set_name("灵州小贩", ({ "lingzhou xiao fan", "seller", "xiaofan" }) );
  set("gender", "男性" );
  set("age", 32);
  set("vendor_goods", ([
   "1" : "/d/lingzhou/obj/paomo",
   "2" : "/d/lingzhou/obj/kaoyangtui",
  ]));
  set("chat_chance", 20);
  set("chat_msg", ({
      (:random_move:),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 100);
  if (clonep())
    keep_heart_beat();
}

