// shiwushi.c
inherit NPC;
void create()
{
  set_name("石人武士", ({ "wu shi", "shi" }));
  set("gender", "男性");
  set("age", random(10) + 20);
  set("str", 25);
  set("dex", 16);
  set("long", "这是守护西夏王陵的石人武士。\n");
  set("combat_exp", 500000 + random(400000));
  set("attitude", "aggressive");
  set_skill("unarmed", 80);
  set_skill("force", 80);
  set_skill("blade", 80);
  set_skill("wuhu-blade", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_skill("feiyan-zoubi", 80);
  map_skill("blade", "wuhu-blade");
  map_skill("parry", "wuhu-blade");
  map_skill("dodge", "feiyan-zoubi");
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/armor", 50);
  set_temp("apply/damage", 50);
  set("force", 2000);
  set("max_force", 1000);
  set("force_factor", 10);
  setup();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/weapon/blade/wandao")->wield();
}

