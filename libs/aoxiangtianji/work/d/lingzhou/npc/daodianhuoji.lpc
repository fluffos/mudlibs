// daodianhuoji.c
inherit NPC;
inherit F_VENDOR;
void create()
{
  set_name("小伙计", ({ "xiao huoji", "huoji" }));
  set("shen_type", 1);
  set("gender", "男性" );
  set("age", 33);
  set("combat_exp", 400);
  set("attitude", "friendly");
  set("vendor_goods",([
     "1" : "/d/obj/weapon/blade/tudao",
     "2" : "/d/obj/weapon/dagger/dagger",
     "3" : "/d/obj/weapon/blade/wandao",
     "4" : "/d/obj/weapon/blade/gangdao",
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  add_action("do_vendor_list", "list");
}

