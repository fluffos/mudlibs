      if (me->query_skill("baihua-zhang",1) < 100)
        return "你的百花掌修为不够，暂时无法领悟！\n";
      if (me->query_skill("moonforce",1) < 100)
        return "你的圆月心法修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 1200)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/flower",1);
