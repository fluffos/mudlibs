#include <ansi.h>
#include "moon.h"
inherit NPC;
inherit F_MASTER;
string ask_rank();
void create()
{
  set_name("西王母", ({"xi wangmu", "xi", "wangmu","master"}));
  set("long", "西华至妙生伊川，穆王八骑访昆仑。\n");
  set("title", "月宫祖师");
  set("gender", "女性");
  set("age", 100);
  set("class","moon");
  set("attitude", "friendly");
  set("rank_info/respect", "老太太");
  set("cor", 30);
  set("per", 30);
  set("looking", "面色红润，满脸福态。");
  set("max_kee", 8000);
  set("max_sen", 8000);
  set("force", 7000);
  set("max_force", 4000);
  set("force_factor", 200);
  set("max_mana", 4000);
  set("mana", 8000);
  set("mana_factor", 200);
  set("combat_exp", 5000000);
  set("daoxing", 5000000);
  set("inquiry", ([
   "职位" : (: ask_rank :),
  ]) );
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
       (: cast_spell, "mihun" :),
       (: cast_spell, "arrow" :),
       (: perform_action, "sword.tian" :),
  }) );
  set_skill("literate", 300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("sword", 300);
  set_skill("whip", 300);
  set_skill("moonforce", 300);
  set_skill("moonshentong", 300);
  set_skill("moondance", 300);
  set_skill("baihua-zhang", 300);
  set_skill("jueqing-whip", 300);
  set_skill("snowsword", 300);

  set_skill("medical",300);
  set_skill("moon-yaoli",300);
  map_skill("medical","moon-yaoli");
  map_skill("force", "moonforce");
  map_skill("spells", "moonshentong");
  map_skill("dodge", "moondance");
  map_skill("unarmed", "baihua-zhang");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  map_skill("whip", "jueqing-whip");
  create_family("月宫", 1, "弟子");
  setup();
  carry_object("/d/moon/obj/tianyi")->wear();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
  carry_object("/obj/cloth/female-shoe")->wear();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((string)ob->query("gender") != "女性")
  {
    command("shake");
    command(sprintf("say 我们月宫只收女徒，这位还是另请高就吧。\n",RANK_D->query_respect(ob)));
    return 0;
  }

  myfam = (string)ob->query("family/family_name");
  if (myfam != "月宫")
  {
    command("say 我只收月宫弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 32)
  {
    command("say 你还需要多加磨练！\n");
    return 0;
  }

  if ((int)ob->query("obstacle/number") < 34)
  {
    command("say 你尚未取经圆满，我还不能收你！\n");
    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "moon")
    ob->set("class", "moon");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "月宫")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我月宫弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "moon")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解月宫的事，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 32)
  {
    command("say 你还需要多加磨练，才可以明白我的讲授！\n");
    return 1;
  }

  if (skill == "snowsword" ||
      skill == "jueqing-whip")
  {
    if (!me->query("family/can_learn/"+skill))
    {
      command("say 你目前还不可以学习这门技艺！\n");
      return 1;
    }

  }
  return 0;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我月宫的弟子！\n";

  if (me->query("class") != "moon")
    return "嘿嘿，你问我何用？\n";

  switch (topic)
  {
    case "历练" :
    case "历炼" :
    case "锻炼" :
      return QUEST_D->accept_ask(master, me, topic);
      break;

//moonshentong
    case "落日神箭" :
    case "arrow" :
      if (me->query("family/can_cast/arrow"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("moonshentong",1) < 100)
        return "你的晚月神通修为不够，暂时无法领悟！\n";
      if (me->query("max_mana") < 1000)
        return "你的法力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_cast/arrow",1);
      return "你学会了“落日神箭”！\n";
      break;

    case "迷魂" :
    case "mihun" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "cast"   : "mihun",
           "name"   : "迷魂",
           "sk1"    : "moonshentong",
           "lv1"    : 150,
           "max_mana" : 2000,
           "gongxian": 500,]));
      break;
    case "回梦" :
    case "huimeng" :
      if (me->query("family/can_cast/huimeng"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("moonshentong",1) < 120)
        return "你的晚月神通修为不够，暂时无法领悟！\n";
      if (me->query("max_mana") < 1500)
        return "你的法力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_cast/huimeng",1);
      return "你学会了“回梦”！\n";
      break;
    case "蚀月咒" :
    case "shiyue" :
      if (me->query("family/can_cast/shiyue"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 300)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("moonshentong",1) < 100)
        return "你的晚月神通修为不够，暂时无法领悟！\n";
      if (me->query("max_mana") < 800)
        return "你的法力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_cast/shiyue",1);
      return "你学会了“蚀月咒”！\n";
      break;
    case "情网" :
    case "qingwang" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "cast"   : "qingwang",
           "name"   : "情网",
           "sk1"    : "moonshentong",
           "lv1"    : 150,
           "sk2"    : "jueqing-whip",
           "lv2"    : 150,
           "max_mana" : 2000,
           "max_force" : 2000,
           "gongxian": 500,]));
      break;
//hanxin-whip
    case "怒放寒梅" :
    case "nufang" :
      if (me->query("family/can_pfm/nufang"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("hanxin-whip",1) < 100 &&
         me->query_skill("jueqing-whip",1) < 100)
        return "你的寒心鞭修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 800)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/nufang",1);
      return "你学会了“怒放寒梅”！\n";
      break;
//wenyue-whip
    case "月影徘徊" :
    case "yueying" :
      if (me->query("family/can_pfm/yueying"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("wenyue-whip",1) < 100 &&
          me->query_skill("jueqing-whip",1) < 100)
        return "你的问月鞭修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 800)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/yueying",1);
      return "你学会了“月影徘徊”！\n";
      break;
//jueqing-whip
    case "绝情断义" :
    case "jueqing" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "pfm"    : "jueqing",
           "name"   : "情网",
           "sk1"    : "jueqing-whip",
           "lv1"    : 180,
           "sk2"    : "moonforce",
           "lv2"    : 180,
           "max_force" : 2000,
           "gongxian": 800,]));
      break;
//huifeng-sword
    case "回风拂柳" :
    case "huifeng" :
      if (me->query("family/can_pfm/huifeng"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("huifeng-sword",1) < 100)
        return "你的回风剑法修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 800)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/huifeng",1);
      return "你学会了“回风拂柳”！\n";
      break;
//wuxue-sword
    case "寒风舞雪" :
    case "wuxue" :
      if (me->query("family/can_pfm/wuxue"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 200)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("wuxue-sword",1) < 100)
        return "你的回风剑法修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 800)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_pfm/wuxue",1);
      return "你学会了“寒风舞雪”！\n";
      break;
//snowsword
    case "漫天飞雪" :
    case "tian" :
      return MASTER_D->teach_pfm(me, this_object(),
        ([ "pfm"    : "tian",
           "name"   : "漫天飞雪",
           "sk1"    : "snowsword",
           "lv1"    : 180,
           "sk2"    : "moonforce",
           "lv2"    : 180,
           "sk3"    : "moondance",
           "lv3"    : 180,
           "max_force" : 2000,
           "gongxian": 1200,]));
      break;
    case "玉碎" :
    case "yusui" :
      if (me->query("family/can_pfm/yusui"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 1500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query_skill("snowsword",1) < 180)
        return "你的风回雪舞剑修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 2500)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N长叹了一声，在$n耳朵边说了几句。\n",master,me);
      tell_object(me,"此招一出，不是敌死，就是我亡！千万慎重使用！\n");
      message_vision("$N不禁点了点头！\n",me);
