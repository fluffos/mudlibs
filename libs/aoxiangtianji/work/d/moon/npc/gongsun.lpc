#include <ansi.h>
inherit NPC;
void create()
{
  set_name("公孙大娘", ({"gongsun daniang", "gongsun", "daniang","master"}));
  set("title", "舞者");
  set("gender", "女性");
  set("age", 25);
  set("class", "moon");
  set("attitude", "friendly");
  set("rank_info/respect", "仙姑");
  set("per", 30);
  set("int", 30);
  set("max_kee", 1800);
  set("max_sen", 1800);
  set("force", 3600);
  set("max_force", 2000);
  set("force_factor", 100);
  set("max_mana", 2000);
  set("mana", 3600);
  set("mana_factor", 100);
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
       (: cast_spell, "mihun" :),
       (: cast_spell, "arrow" :),
  }) );
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("sword", 200);
  set_skill("dagger",220);
  set_skill("moonforce", 200);
  set_skill("moonshentong", 200);
  set_skill("moondance", 200);
  set_skill("zhemei-shou", 200);
  set_skill("huifeng-sword", 200);
  set_skill("wuxue-sword", 200);
  set_skill("jianwu",200);

  map_skill("force", "moonforce");
  map_skill("spells", "moonshentong");
  map_skill("dodge", "moondance");
  map_skill("unarmed", "zhemei-shou");
  map_skill("sword", "wuxue-sword");
  map_skill("parry", "jianwu");
  map_skill("dagger","jianwu");

  setup();
  carry_object("/d/moon/obj/luoyi")->wear();
  carry_object("/d/obj/weapon/dagger/chou-dagger")->wield();
}

int recognize_apprentice(object me,string skill)
{
  if (me != this_player(1))
    return 0;

  if (me->query("family/family_name") != "月宫" ||
      !me->query("family/can_learn/gongsun") )
    return 0;
  if (me->query("level") <= 32)
  {
    write("你的能力还不足，学剑舞早了点！\n");
    return -1;
  }

  if (me->query_per() < 32 || me->query_dex() < 30)
  {
    write("学习舞蹈需要一定的魅力和敏捷，这方面不够，是难有作为的！\n");
    return -1;
  }

  if (skill != "dagger" && skill != "jianwu")
  {
    write("我只有用短剑舞蹈的本事可以教教，其他的。。。\n");
    return -1;
  }

  return 1;
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != "月宫" ||
      !me->query("family/can_learn/gongsun") )
    return "我和你毫无关联，你问我这个干什么！\n";

  if (me->query("class") != "moon")
    return "我不知道！\n";
  switch (topic)
  {
    case "霓裳舞" :
    case "nishang" :
      if (me->query("family/can_pfm/nishang"))
        return "你不是已经学会了吗？\n";
      if (me->query("family/family_faith") < 1500)
        return "你做出的贡献还不够，请多努力！\n";
      if (me->query_skill("jianwu",1) < 180)
        return "你的剑舞修为不够，暂时无法领悟！\n";
      if (me->query("max_force") < 2500)
        return "你的内力修为不够，暂时无法领悟！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      message_vision("$N不禁点了点头！\n",me);
      me->add("family/family_faith",-500);
      me->set("family/can_pfm/nishang",1);
      return "你学会了“霓裳舞”！\n";
      break;
  }

  return 0;
}

