#include <ansi.h>
#include "moon.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("菊影",({"shade","juying", "fairy"}));
  set("long",
"翩若惊鸿，婉若游龙，荣曜秋菊，华茂春松。"
"仿佛兮若轻云之蔽月，飘摇兮若流风之回雪。"
"远而望之，皎若太阳升朝霞。迫而察之，灼若芙渠出绿波。\n");
  set("title", "月宫舞仙");
  set("gender", "女性");
  set("age", 18);
  set("class", "moon");
  set("attitude", "friendly");
  set("rank_info/respect", "仙姑");
  set("per", 30);
  set("int", 30);
  set("max_kee", 1200);
  set("max_sen", 1200);
  set("force", 1600);
  set("max_force", 1000);
  set("force_factor", 50);
  set("max_mana", 1000);
  set("mana", 1500);
  set("mana_factor", 50);
  set("combat_exp", 500000);
  set("daoxing", 500000);
  set_skill("literate", 150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("sword", 150);
  set_skill("moonforce", 150);
  set_skill("moonshentong", 150);
  set_skill("moondance", 150);
  set_skill("baihua-zhang", 150);
  set_skill("wuxue-sword", 150);
  map_skill("force", "moonforce");
  map_skill("spells", "moonshentong");
  map_skill("dodge", "moondance");
  map_skill("unarmed", "baihua-zhang");
  map_skill("sword", "wuxue-sword");
  map_skill("parry", "wuxue-sword");
  create_family("月宫", 3, "弟子");
  setup();
  carry_object("/d/moon/obj/luoyi")->wear();
  carry_object("/d/obj/weapon/sword/snow_sword")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((string)ob->query("gender") != "女性")
  {
    command("shake");
    command(sprintf("say 我们月宫只收女徒，这位还是另请高就吧。\n",RANK_D->query_respect(ob)));
    return 0;
  }

  myfam = (string)ob->query("family/family_name");
  if (myfam != "月宫")
  {
    command("say 我只收月宫弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 15)
  {
    command("say 你还需要多加磨练！\n");
    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "moon")
    ob->set("class", "moon");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "月宫")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我月宫弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "moon")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解月宫的事，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 15)
  {
    command("say 你还需要多加磨练，才可以明白我的讲授！\n");
    return 1;
  }

  return 0;
}