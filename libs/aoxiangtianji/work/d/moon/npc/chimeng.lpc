#include <ansi.h>
#include "moon.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("痴梦仙姑",({"chi meng","dream", "fairy"}));
  set("long",
"此乃迷津痴梦仙姑也；不受金银之谢，但遇有缘者渡之！\n");
  set("title", "迷津渡者");
  set("gender", "女性");
  set("age", 18);
  set("class", "moon");
  set("attitude", "friendly");
  set("rank_info/respect", "仙姑");
  set("per", 30);
  set("int", 30);
  set("max_kee", 2800);
  set("max_sen", 2800);
  set("force", 3600);
  set("max_force", 2000);
  set("force_factor", 100);
  set("max_mana", 2000);
  set("mana", 3600);
  set("mana_factor", 100);
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
       (: cast_spell, "mihun" :),
       (: cast_spell, "arrow" :),
       (: perform_action, "whip.yueying" :),
  }) );
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("whip", 200);
  set_skill("moonforce", 200);
  set_skill("moonshentong", 200);
  set_skill("moondance", 200);
  set_skill("baihua-zhang", 200);
  set_skill("hanxin-whip", 200);
  set_skill("wenyue-whip", 200);
  set_skill("jueqing-whip", 120);

  map_skill("force", "moonforce");
  map_skill("spells", "moonshentong");
  map_skill("dodge", "moondance");
  map_skill("unarmed", "baihua-zhang");
  map_skill("whip", "wenyue-whip");
  map_skill("parry", "wenyue-whip");
  create_family("月宫", 2, "弟子");
  setup();
  carry_object("/d/moon/obj/luoyi")->wear();
  carry_object("/d/obj/weapon/whip/jueqingwhip")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if (ob->query_temp("chimeng-wuyuan"))
  {
    command("say 今天你是无缘了！待有缘再来吧！\n");
    return 0;
  }

  if ((string)ob->query("gender") != "女性")
  {
    command("shake");
    command(sprintf("say 我们月宫只收女徒，这位还是另请高就吧。\n",RANK_D->query_respect(ob)));
    return 0;
  }

  myfam = (string)ob->query("family/family_name");
  if (myfam != "月宫")
  {
    command("say 我只收月宫弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 25)
  {
    command("say 你还需要多加磨练！\n");
    return 0;
  }

  if (random((int)ob->query_kar()) <= 20)
  {
    command("say 你我无缘，请另投名师吧！\n");
    ob->set_temp("chimeng-wuyuan",1);
    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "moon")
    ob->set("class", "moon");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "月宫")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我月宫弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "moon")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解月宫的事，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 25)
  {
    command("say 你还需要多加磨练，才可以明白我的讲授！\n");
    return 1;
  }

  return 0;
}

