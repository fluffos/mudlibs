//mugu.c
inherit NPC;
void create()
{
  set_name("麻姑", ({"magu"}));
  set("gender", "女性" );
  set("age", 35);
  set("title","月宫管家");
  set("long", "麻姑在月宫可是里里外外一把手。\n");
  set("combat_exp", 100);
  set("daoxing", 5000);
  set("attitude", "peaceful");
  set("per", 15);
  set("max_kee", 200);
  set("max_gin", 100);
  set("max_sen", 100);
  setup();
  carry_object("/obj/cloth/pink_cloth")->wear();
  carry_object("/obj/cloth/female-shoe")->wear();
}

