#include <ansi.h>
#include "moon.h"
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("月奴", ({"yue nu", "yuenu", "yue","master"}));
  set("long",
"她乃是桂树采天地之精华化成，后拜嫦娥为师．\n");
  set("title", "桂花仙");
  set("gender", "女性");
  set("age", 20);
  set("class", "moon");
  set("attitude", "friendly");
  set("rank_info/respect", "仙姑");
  set("per", 30);
  set("int", 30);
  set("max_kee", 800);
  set("max_sen", 800);
  set("force", 1200);
  set("max_force", 700);
  set("force_factor", 20);
  set("max_mana", 800);
  set("mana", 1500);
  set("mana_factor", 40);
  set("combat_exp", 100000);
  set("daoxing", 100000);
  set_skill("literate", 90);
  set_skill("force", 90);
  set_skill("spells", 90);
  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("parry", 90);
  set_skill("sword", 90);
  set_skill("moonforce", 90);
  set_skill("moonshentong", 90);
  set_skill("moondance", 90);
  set_skill("baihua-zhang", 90);
  set_skill("huifeng-sword", 90);
  map_skill("force", "moonforce");
  map_skill("spells", "moonshentong");
  map_skill("dodge", "moondance");
  map_skill("unarmed", "baihua-zhang");
  map_skill("sword", "huifeng-sword");
  map_skill("parry", "huifeng-sword");
  create_family("月宫", 4, "弟子");
  setup();
  carry_object("/d/moon/obj/luoyi")->wear();
  carry_object("/d/obj/weapon/sword/snow_sword")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((string)ob->query("gender") != "女性")
  {
    command("shake");
    command(sprintf("say 我们月宫只收女徒，这位还是另请高就吧。\n",RANK_D->query_respect(ob)));
    return 0;
  }

  myfam = (string)ob->query("family/family_name");
  if (stringp(myfam))
  {
    if (myfam == "月宫")
    {
      command("say 不敢当，不敢当！\n");
    }

    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "moon")
    ob->set("class", "moon");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "月宫")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我月宫弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "moon")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解月宫的事，我教的恐怕不能理解。",myname));
    return 1;
  }

  return 0;
}