inherit NPC;
void create()
{
  set_name("后羿", ({"hou yi"}));
  set("gender", "男性" );
  set("title","落日神箭");
  set("long", "他就是传说中射落九个太阳的大英雄。\n");
  set("age", 25);
  set("per", 25);
  set("combat_exp", 2500000);
  set("daoxing", 2500000);
  set("max_kee", 2500);
  set("max_sen", 2500);
  set("attitude", "friendly");
  set("per", 30);

  set_skill("force",200);
  set_skill("archery",200);
  set_skill("dodge",200);
  set_skill("unarmed",200);
  set_skill("changquan",200);
  set_skill("parry",200);
  set_skill("sword",200);
  set_skill("sancai-sword",200);
  set_skill("lengquan-force",200);
  set_skill("baguazhou",200);
  set_skill("feiyan-zoubi",200);
  set_skill("jiutian-arrow",200);
  map_skill("force","lengquan-force");
  map_skill("spells","baguazhou");
  map_skill("unarmed","changquan");
  map_skill("dodge","feiyan-zoubi");
  map_skill("sword","sancai-sword");
  map_skill("parry","sancai-sword");
  map_skill("archery","jiutian-arrow");

  set("force",1500);
  set("max_force",1500);
  set("force_factor",50);
  set("inquiry", ([
    "name" : "我就是射日的后羿。\n",
  ]) );
  set("no_cast",1);
  set("chat_chance", 8);
  set("chat_msg", ({
     "后羿仰天长叹！\n",
     "后羿擦了擦额头上的汗水。\n",
     "后羿眼里流露出一丝哀怨。\n",
     (: random_move :)
  }) );
  setup();
  carry_object("/d/obj/armor/surcoat/surcoat")->wear();
}

int recognize_apprentice(object me,string skill)
{
  if (me != this_player(1))
    return 0;
  if (me->query("family/family_name") != "月宫" ||
      me->query("family/master_id") != "chang e")
  {
    write("我自己的心事重重，哪有时间去教你啊！\n");
    return -1;
  }

  if (!me->query("family/can_learn/houyi"))
  {
    write("我和你素不相识，没有心情教你！\n");
    return -1;
  }

  if (me->query("level") <= 32)
  {
    write("可惜你的能力太低了，还需多加磨练！\n");
    return -1;
  }

  if (skill != "archery" && skill != "jiutian-arrow")
  {
    write("我除了弓箭略懂一二，其他的本领实在是有限！\n");
    return -1;
  }

  return 1;
}

