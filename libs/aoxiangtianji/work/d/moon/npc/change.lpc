#include <ansi.h>
#include "moon.h"
inherit NPC;
inherit F_MASTER;
string ask_houyi();
void create()
{
  set_name("嫦娥", ({"chang e", "change", "chang","master"}));
  set("long",
"西王母的大弟子。早年因帮助丈夫盗取西王母之灵药而\n与其师势成水火。后得和解并邀西王母出掌月宫一门。\n");
  set("title", "月宫主人");
  set("gender", "女性");
  set("age", 20);
  set("class", "moon");
  set("attitude", "friendly");
  set("rank_info/respect", "仙姑");
  set("per", 30);
  set("int", 30);
  set("max_kee", 2800);
  set("max_sen", 2800);
  set("force", 3600);
  set("max_force", 2000);
  set("force_factor", 100);
  set("max_mana", 2000);
  set("mana", 3600);
  set("mana_factor", 100);
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
       (: cast_spell, "mihun" :),
       (: cast_spell, "arrow" :),
       (: perform_action, "sword.wuxue" :),
  }) );
  set("inquiry", ([
    "后羿"   : (: ask_houyi :),
  ]) );
  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("sword", 200);
  set_skill("moonforce", 200);
  set_skill("moonshentong", 200);
  set_skill("moondance", 200);
  set_skill("zhemei-shou", 200);
  set_skill("huifeng-sword", 200);
  set_skill("wuxue-sword", 200);
  set_skill("snowsword", 120);
  set_skill("medical",200);
  set_skill("moon-yaoli",200);
  map_skill("medical","moon-yaoli");

  map_skill("force", "moonforce");
  map_skill("spells", "moonshentong");
  map_skill("dodge", "moondance");
  map_skill("unarmed", "zhemei-shou");
  map_skill("sword", "wuxue-sword");
  map_skill("parry", "wuxue-sword");
  create_family("月宫", 2, "弟子");
  setup();
  carry_object("/d/moon/obj/luoyi")->wear();
  carry_object("/d/obj/weapon/sword/feijian")->wield();
}

int attempt_apprentice(object ob)
{
  string myfam;
  if (ob != this_player(1))
    return 0;

  if (! permit_recruit(ob))
    return 0;
  if ((string)ob->query("gender") != "女性")
  {
    command("shake");
    command(sprintf("say 我们月宫只收女徒，这位还是另请高就吧。\n",RANK_D->query_respect(ob)));
    return 0;
  }

  myfam = (string)ob->query("family/family_name");
  if (myfam != "月宫")
  {
    command("say 我只收月宫弟子！\n");
    return 0;
  }

  if ((int)ob->query("level") <= 25)
  {
    command("say 你还需要多加磨练！\n");
    return 0;
  }

  if ((ob->query_per() <= 25) ||
      (ob->query_dex() <= 35))
  {
    command("say 你的资质并不适合舞蹈，请另投名师吧！\n");
    return 0;
  }

  command("smile");
  command(sprintf("say 很好，%s多加努力，他日必定有成。\n",RANK_D->query_respect(ob)));
  command("recruit " + ob->query("id") );
  if ((string)ob->query("class") != "moon")
    ob->set("class", "moon");
  return 1;
}

int prevent_learn(object me, string skill)
{
  string myname=RANK_D->query_respect(me);
  if ((string)me->query("family/family_name") != "月宫")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s非我月宫弟子，我教的恐怕不能理解。",
                  myname));
    return 1;
  }

  if ((string)me->query("class") != "moon")
  {
    command(sprintf("emote 皱了皱眉头，说道：%s无法理解月宫的事，我教的恐怕不能理解。",myname));
    return 1;
  }

  if ((int)me->query("level") <= 25)
  {
    command("say 你还需要多加磨练，才可以明白我的讲授！\n");
    return 1;
  }

  return 0;
}

string ask_houyi()
{
  object ob = this_player(1);
  int phase = NATURE_D->query_current_day_phase();

  if ((string)ob->query("family/family_name") != "月宫")
    return "。。。\n";

  if ((int)ob->query("level") <= 20)
    return "你还是先磨练磨练自己吧！\n";

  if ((int)ob->query("family/family_faith") < 1500)
    return "你先尽力为月宫多做点事情再说吧！\n";

  if (ob->query("family/master_id") != "chang e")
    return "你不是我的弟子，问我这个干什么？\n";

  if (NATURE_D->query_festival() != "七夕")
    return "我现在哪有心情去想那些从前的往事啊！喜鹊该飞走了吧？\n";
  if (phase > 0 && phase < 5)
    return "唉！有些事情还真说不明白，月儿出来了吗？\n";
  command("sigh");
  command("say 有些事情，总也不懂。。。\n");
  command("say 懂了，也只能留下些剪不断的哀怨。。。\n");
  command("say 你去问问他吧。。。我实在没有什么可以多说的了！\n");
  ob->set("family/can_learn/houyi",1);
  return "希望他还能记得我。。。\n";
}

string accept_ask(object me, string topic)
{
  object master = this_object();
  if (me->query("family/family_name") != master->query("family/family_name"))
    return "你不是我月宫的弟子！\n";

  if (me->query("class") != "moon")
    return "你真是很有礼貌啊！可惜我什么都不知道！\n";
  if( !me->is_apprentice_of(master) )
    return "有问题还是去请教你自己的师傅吧！\n";

  switch (topic)
  {
    case "舞蹈" :
    case "跳舞" :
    case "剑舞" :
    case "jianwu" :
      if (me->query("family/can_learn/gongsun"))
        return "你快去自己研究吧？\n";
      if (me->query("family/family_faith") < 1500)
        return "你为本门做出的贡献还不够，请多努力！\n";
      if (me->query("level") < 32)
        return "你还没有能力去了解剑舞的事情！\n";
      message_vision("$N在$n耳朵边说了几句。\n",master,me);
      tell_object(me,"这天下只有公孙大娘能把剑术化做美妙的舞姿，有机缘，可以多向她请教！\n");
      tell_object(me,"为师我和她还有点交情，看在我的面子上，她该教你一些！\n");
      message_vision("$N不禁点了点头！\n",me);
      me->set("family/can_learn/gongsun",1);
      return "你可以开始研究剑舞了！\n";
      break;
  }

  return 0;
}

