inherit SMALLROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "崎岖小路");
  set ("long", @LONG
小路异常难行。时而盘上高山，时而跨过深谷。一路上人烟
稀少，只有一些被你惊起的飞禽走兽。
LONG);
  set("objects", ([
    "/d/city/npc/dog" : 1,
    "/obj/quarry/lang" : 1,
  ]));
  set("outdoors", 1);
  set("exits", ([
    "southeast" : __DIR__"xiaolu3",
    "northwest" : __DIR__"xiaolu1",
  ]));
  setup();
}

