inherit SMALLROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "储藏室");
  set ("long", @LONG
一间不大的房间,放满了练舞的道具和一些日常的用具。
LONG);
  set("objects", ([
    __DIR__"obj/daoyaochu" : 1,
    "/d/obj/weapon/axe/bigaxe" : 2,
    "/d/obj/weapon/whip/wuchou":2,
    "/d/obj/weapon/sword/snow_sword" : 1,
  ]));
  set("exits", ([
    "northwest" : __DIR__"courtyard.lpc",
    "south" : __DIR__"wulang.lpc",
  ]));
  setup();
}

