inherit SMALLROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "赏梅小路");
  set ("long", @LONG
不经意间已经穿过了矮矮的丛林，冰天雪地扑面而来。
寒风吹过，透体冰冷。放眼而望，在这皑皑的白雪之间，
朵朵梅花点缀。
LONG);
  set("exits",
  ([
     "eastdown" : __DIR__"fabao-room",
     "southwest" : __DIR__"hanmei-road2",
  ]));
  set("outdoors", "moon");
  setup();
}

