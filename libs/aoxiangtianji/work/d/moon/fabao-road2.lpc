inherit SMALLROOM;
inherit SANDROOM;
void create ()
{
  set ("short","踏雪小路");
  set ("long", @LONG
斜斜的一道山脊往西延伸过去。一路踏雪而行，放眼两边青松翠柏，
颇有诗意。路边一些枯黄的花草在雪中露出点点颜色。
LONG);
  set("exits",
  ([
     "east" : __DIR__"fabao-road1",
     "west" : __DIR__"fabao-room",
  ]));
  set("outdoors", "moon");
  setup();
}

