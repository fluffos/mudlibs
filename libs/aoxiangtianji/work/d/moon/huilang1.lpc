inherit SMALLROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "回廊");
  set ("long", @LONG
曲折游廊，阶下石子漫成甬路，西边是一间茶蘼爬满了的小
屋，花香馥郁。
LONG);
  set("exits", ([
    "east" : __DIR__"courtyard.lpc",
    "south": __DIR__"huilang.lpc",
    "west" : __DIR__"wangmu_room.lpc",
  ]));

  set("objects", ([
    __DIR__"npc/chuyao" : 1,
  ]));
  setup();
}