inherit SMALLROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "落日峰");
  set ("long", @LONG
上山峰的小路渐渐多了很多的分叉，迂回盘绕。路两边的积雪慢慢的显得
单薄了。两边的树林渐渐的茂密起来。
LONG);
  set("exits",
  ([
     "north" : sprintf(__DIR__"luori-maze%d",1+random(4)),
     "west" : sprintf(__DIR__"luori-maze%d",1+random(4)),
     "east" : sprintf(__DIR__"luori-maze%d",1+random(4)),
     "south" : __DIR__"luori-road3",
  ]));
  setup();
}

