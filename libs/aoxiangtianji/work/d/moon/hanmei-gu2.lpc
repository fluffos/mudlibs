inherit SMALLROOM;
inherit WOODROOM;
inherit SAFTYROOM;
void create ()
{
  set ("short", "寒梅谷");
  set ("long", @LONG
这谷中气候十分温暖，花草繁茂，溪流淙淙。不知名的
小鸟欢乐的鸣唱，谷低显得十分的宁静。
LONG);
  set("exits",
  ([
     "west" : __DIR__"hanmei-gu1",
  ]));
  set("objects", ([
    __DIR__"npc/gongsun" : 1,
  ]));

  set("outdoors", "moon");
  setup();
}

