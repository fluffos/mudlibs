inherit SMALLROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "落日峰");
  set ("long", @LONG
一条上山峰的小路，迂回盘绕。路两边的积雪慢慢的显得
单薄了。两边的树林渐渐的茂密起来。落日峰最奇险的一
段也正在这里。远望奇峰叠翠，峭壁森森。往下看，云气
雾霭，不知有多深险。传说女娲曾在昆仑一带炼石补天。
如从此下到峡谷，或会有所发现，只是一个不慎，只怕要
粉身碎骨了。
LONG);
  set("exits",
  ([
     "north" : __DIR__"luori-maze12",
     "southup" : __DIR__"luori-road5",
  ]));
  set("outdoors", "moon");
  setup();
}

void init()
{
  add_action("do_jump",({"jump","tiao"}));
}

int do_jump(string arg)
{
  object *inv , where;
  int i;
  object who = this_player();

  if (who->is_busy() || who->is_fighting())
  {
    write("你正忙着呢！\n");
    return 1;
  }

  if (!arg || arg != "down")
  {
    write("你往哪里跳？\n");
    return 1;
  }

  if (who->query_temp("is_riding"))
  {
    write("你还是先下了坐骑吧！\n");
    return 1;
  }

  inv = all_inventory(who);
  i = sizeof(inv);
  while (i--)
  {
    if (inv[i]->is_character())
    {
      write("这么高的山峰，你背个活人往下跳，看来是不想活了！\n");
      return 1;
      break;
    }

  }

  message_vision("$N看了看深险的峡谷，咬牙想往下跳！\n",who);

  if (who->query_skill("dodge",1) < 300)
  {
    write("可惜觉得轻功或许不够，只的放弃了！\n");
    message_vision("$N叹了口气，看来是有点不敢了！\n",who);
    return 1;
  }

  if (who->query_skill("force",1) < 300)
  {
    write("可惜觉得内功或许不够，只的放弃了！\n");
    message_vision("$N叹了口气，看来是有点不敢了！\n",who);
    return 1;
  }

  where = find_object("/d/moon/kunlun-xiagu");
  if (!objectp(where))
    where = load_object("/d/moon/kunlun-xiagu");
  if (!objectp(where))
  {
    write("你想往下跳，可惜看来找不对地方！\n");
    return 1;
  }

  message_vision("$N身形跃起，往下跳了下去，转眼就消失在了茫茫的云海之间！\n",who);
  who->receive_damage("kee",who->query("max_kee")/3*2);
  who->receive_wound("kee",who->query("max_kee")/3*2);
  who->receive_damage("sen",who->query("max_sen")/3*2);
  who->receive_wound("sen",who->query("max_sen")/3*2);
  who->move(where);
  who->unconcious();
  message_vision("$N如同断线的风筝，从上面跌了下来，摔了个七荤八素，人事不知！\n",who);
  return 1;
}

