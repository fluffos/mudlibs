inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "落日峰顶");
  set ("long", @LONG
这里到了山峰顶点，阳光透过云程洒下一地的阳光。山顶不大，
靠着一块岩石的向阳处有一个简陋的小屋，小屋门前站立一个
彪形大汉，虎皮披风，古铜色的皮肤，双目眨也不眨的看着你。
LONG);
  set("exits",
  ([
     "northdown" : __DIR__"luori-road4",
  ]));
  set("objects", ([
    __DIR__"npc/houyi" : 1,
  ]));
