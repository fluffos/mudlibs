inherit SMALLROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "赏梅小路");
  set ("long", @LONG
一路行来，两边各色梅花渐渐多了起来，团团簇簇。
寂静的山谷，听着落寞的踏雪脚步声，这寒梅在寒风
中微微点头。路边却有一簇红梅(hongmei)格外引人
注目，那鲜红映衬在白雪之下，真夺人眼目。
LONG);
  set("exits",
  ([
     "north" : __DIR__"hanmei-road2",
     "southwest" : __DIR__"luori-road1",
  ]));
  set("item_desc",([
    "hongmei" : "一簇红梅格外引人注目，仔细看看，更令人惊讶的是，在这红梅的边上，似乎有块木牌(pai)！\n",
    "pai" : "求梅种梅赏梅，一生爱梅，不忍折梅，临去留之，埋于此牌之下！  孤梅真人\n",
  ]) );
  set("book1",1);
  set("book2",1);
  set("outdoors", "moon");
  setup();
}

void init()
{
  add_action("do_search",({"search","xunzhao","xun"}));
  add_action("do_zhong", ({"zhong"}));
}

int do_search(string arg)
{
  object book, huazhong;
  object me = this_player();

  if (!arg || (arg != "pai" && arg != "牌" && arg != "木牌"))
  {
    write("你要找什么？\n");
    return 1;
  }

  if (me->query("family/family_name") != "月宫")
  {
    write("你什么都没有得到！\n");
    return 1;
  }

  message_vision("$N开始在木牌下面仔细摸索，寻找什么！\n",me);
  if (!me->query_temp("moon/zhong_mei"))
  {
    if (!query("book1"))
    {
      write("可惜书被别人拿走了！你什么都没有得到！！\n");
      return 1;
    }

    if (me->query_skill("zhemei-shou",1) >= 50)
    {
      write("很可惜，你什么都得不到了！\n");
      return 1;
    }

    book = new("/d/obj/book/zhemei_book1");
    huazhong = new("/d/moon/obj/meihua-zhong");
    if (objectp(book) && book->move(me,1))
    {
      book->set("owner",me->query("id"));
      write("你得到了一本书！\n");
      if (objectp(huazhong) && huazhong->move(me,1))
      {
        huazhong->set("owner",me->query("id"));
        write("你得到了一袋花种！看来可以种(zhong)花了！\n");
      }

      else if (objectp(huazhong))
        destruct(huazhong);
      set("book1",0);
      return 1;
    }

    else if (objectp(book))
      destruct(book);
    return 1;
  }

  else
  {
    if (me->query_skill("zhemei-shou",1) <= 49)
    {
      write("很可惜，看来你什么都得不到了！\n");
      return 1;
    }

    if (!query("book2"))
    {
      write("可惜书被别人拿走了，你什么都没有得到！\n");
      return 1;
    }

    book = new("/d/obj/book/zhemei_book2");
    if (objectp(book) && book->move(me,1))
    {
      book->set("owner",me->query("id"));
      set("book2",0);
      write("哈哈，你找到了第二本书！\n");
      me->delete_temp("moon/zhong_mei");
      return 1;
    }

    else if (objectp(book))
      destruct(book);
    return 1;
  }

}

int do_zhong(string arg)
{
  object huazhong;
  object me = this_player(1);

  huazhong = present("meihua zhongzi",me);
  if (!objectp(huazhong))
  {
    write("你没有种子，种什么花？\n");
    return 1;
  }

  if (!arg || (arg != "花种" && arg != "zhongzi" && arg != "meihua zhongzi"))
  {
    write("你要种什么？\n");
    return 1;
  }

  message_vision("$N挖了一个坑，把种子洒在坑里，用雪把种子盖了起来！"
                 "然后站起来，默默的祈祷了一下！\n",me);
  if (huazhong->query("owner") != me->query("id"))
  {
    write("什么事情都没有发生！\n");
    return 1;
  }

  message_vision("不一会，雪地中冒出了可嫩芽，迎着寒风，转瞬长大了，绽放出了鲜红的梅花！"
                 "$N不由得张大了嘴巴！吃惊的看着这一切！\n",me);
  me->set_temp("moon/zhong_mei",1);
  write("你心中一动，觉得再那木牌之下，还隐藏着什么，看来值得再去寻找一番！\n");
  return 1;
}

