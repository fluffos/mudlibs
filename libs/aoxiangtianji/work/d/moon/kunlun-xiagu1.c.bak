inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", "昆仑峡谷");
  set ("long", @LONG
这里是昆仑山的一个峡谷。峡谷内野草凄凄，积雪
皑皑。一片深红色的岩石在这雪地显得十分刺目。
那岩石历经风雨，表明有些剥落了。看来这里确曾
是炼石之处。不知道在那岩石的下面，是否埋藏有
宝物？
LONG);
  set("exits",
  ([
     "south" : __DIR__"kunlun-xiagu",
  ]));
  set("baowu",1);
  setup();
}
void reset()
{
  ::reset();
  if (!query("baowu") &&
      time() - (int)query("last_baowu") > 3600)
  {
    delete("last_baowu");
    set("baowu",1);
  }
}
void init()
{
  ::init();
  if (playerp(this_player()))
    add_action("do_search",({"search","xunzhao"}));
}
int do_search(string arg)
{
  int num;
  object weapon,snake, baowu, *inv;
  object who = this_player();
  if (who->is_busy() || who->is_fighting())
  {
    write("你正忙着呢！\n");
    return 1;
  }
  weapon = who->query_temp("weapon");
  if (!objectp(weapon))
  {
    write("你手中没有兵器，这岩石可无法挖掘！\n");
    return 1;
  }
  if(who->query_skill("force",1) < 300
     && (string)weapon->query("skill_type")!="sword"
     && (string)weapon->query("skill_type")!="blade")
  {
    write("你的内力不够深厚，应该找把剑，或是刀什么的。\n");
    return 1;
  }
  inv = all_inventory(this_object());
  inv = filter_array(inv, (: $1->is_character() &&
                             playerp($1) :));
  if (sizeof(inv) > 1)
  {
    write("这里似乎还有个玩家虎视眈眈的看着，贸然挖掘似乎不大好吧？\n");
    return 1;
  }

  num = who->query_temp("search_time");
  if (!num || !who->query_temp("kill_xuanmang"))
  {
    message_vision("$N走到坑边，挖了起来！\n",who);
    who->set_temp("search_time",1);
    who->start_busy(2+random(3));
    seteuid(getuid());
    snake = new("/clone/beast/xuanmang");
    snake->move(this_object());
    message_vision("$N正埋头挖掘的时候，突然窜出了一条大蟒蛇来！\n",who);
    snake->kill_ob(who);
    return 1;
  }

  who->add_temp("search_time",1);
  message_vision("$N在坑边继续用力挖掘！\n",who);
  if (random(num + 1) < 15)
  {
    tell_object(who,"你没有发现任何东西！只是不甘心就此罢手！\n");
    message_vision("看起来$N一无所获！\n",who);
    who->add_temp("search_time",1);
    who->start_busy(2+random(3));
    if ((num % 4) == 0 )
    {
      seteuid(getuid());
      snake = new("/clone/beast/xuanmang");
      snake->move(this_object());
      message_vision("$N正埋头挖掘的时候，突然窜出了一条冰蛇来！\n",who);
      snake->kill_ob(who);
    }
    return 1;
  }
  if (query("baowu"))
  {
    message_vision("突然一声惊呼，$N发现了一个五彩的矿石！\n",who);
    message_vision("$N赶紧把矿石拣了起来，看来获得了补天石啊！\n",who);
    seteuid(getuid());
    baowu = new("/d/item/obj/butian");
    baowu->move(who,1);
    baowu->set("owner",who->query("id"));
    set("baowu",0);
    set("last_baowu",time());
    remove_call_out("regen");
    call_out("regen",3600);
  }
  else
    message_vision("$N擦了擦汗，叹了口气，看来今天是要一无所获了！\n",who);

  who->delete_temp("search_time");
  who->start_busy(3+random(3));
  return 1;
}
void reget()
{
  set("baowu",1);
}
