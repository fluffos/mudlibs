inherit SMALLROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "赏梅小路");
  set ("long", @LONG
一路行来，两边各色梅花渐渐多了起来，团团簇簇。
寂静的山谷，听着落寞的踏雪脚步声，这寒梅在寒风
中微微点头。
LONG);
  set("exits",
  ([
     "northeast" : __DIR__"hanmei-road1",
     "south" : __DIR__"hanmei-road3",
  ]));
  set("outdoors", "moon");
  setup();
}

