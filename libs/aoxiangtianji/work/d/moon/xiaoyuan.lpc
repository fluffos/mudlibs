inherit SMALLROOM;
inherit WOODROOM;
void create ()
{
  set ("short", "篱笆小院");
  set ("long", @LONG
篱笆围成的小院。地上种满了奇花异草。中间有一张木桌及几只小木凳，
桌上摆着各色果品。东，西，北各有一间精致的小屋。
LONG);
  set("objects", ([
    __DIR__"obj/guihuageng" : 1,
    "/d/obj/food/guihua-jiudai" : 1,
    __DIR__"npc/yuenu" : 1,
    "/obj/mptop" : 1,
  ]));
  set("outdoors", 1);
  set("exits", ([
    "east" : __DIR__"eroom",
    "north" : __DIR__"nroom",
    "south" : __DIR__"ontop2",
    "west" : __DIR__"wroom",
  ]));
  set("valid_startroom", 1);
  setup();
  call_other("/obj/board/moon_b", "???");
}

