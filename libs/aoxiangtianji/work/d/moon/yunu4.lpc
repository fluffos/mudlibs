inherit SMALLROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "玉女峰");
  set ("long", @LONG
冰雪世界。这里天地茫茫无际，远望苍穹低垂，两边峭壁(qiaobi)
陡立。这里根本就没有路，一步一步的前行都需要攀爬在冰上。
LONG);
  set("outdoors", 1);
  set("exits", ([
    "northdown" : __DIR__"yunu3",
    "westup" : __DIR__"yunu5",
  ]));
  set("item_desc",([
    "qiaobi" : "往峭壁下望，云雾蒙蒙，不知有多深？从此跳下去，只怕落个粉身碎骨！\n",
  ]) );
  setup();
}

void init()
{
  add_action("do_jump",({"jump","tiao"}));
}

int do_jump(string arg)
{
  object ridee;
  object me = this_player();

  ridee = me->query_temp("is_riding");
  if (objectp(ridee))
  {
    write("你还是先下了坐骑吧！\n");
    return 1;
  }

  if (me->query("family/family_name") != "月宫")
  {
    write("你低头看了看，只觉得心胆俱裂，哪敢往下跳啊！\n");
    return 1;
  }

  if (me->query_skill("dodge",1) < 150)
  {
    write("你的自己的身手没有什么把握，实在是不敢跳下去！\n");
    return 1;
  }

  message_vision("$N充满了好奇，不顾一切的向下跳，身形转瞬就淹没在了云烟之中，渐渐的不见了！\n",me);

  me->move(__DIR__"hanmei-gu1");
  message_vision("$N从上面直掉了下来，摔了个四脚朝天！\n", me);
  if (me->query_skill("jianwu",1) < 120)
    me->unconcious();
  return 1;
}

