inherit SMALLROOM;
inherit LANDROOM;
inherit SAFTYROOM;
void create()
{
  set("short", "杏林");
  set("long", @LONG
不知从何时开始昆仑山的玉女峰上便有了这么一片杏林，杏林
中便有了这么一位老人。他总在花前月下出现，为天下的有情
人祝福，主婚。此刻他拄着木杖，坐在一块大石头上，正在认
真地翻阅着一本看起来很特别的簿子。
LONG
);
  set("no_sleep_room", "1");

  set("exits", ([
    "out" : __DIR__"yltw",
  ]));
  set("objects", ([
     __DIR__"npc/yuelao": 1,
  ]));
  setup();
}

