inherit SMALLROOM;
inherit SNOWROOM;
void create ()
{
  set ("short", "玉女峰");
  set ("long", @LONG
这里靠近玉女峰顶。虽说是冰雪遍地，你并不觉得太冷。四周冰缝中长着
一些洁白的雪莲。
LONG);
  set("objects", ([
    __DIR__"obj/xuelian" : 2,
  ]));
  set("outdoors", 1);
  set("exits", ([
    "northup" : __DIR__"ontop2.lpc",
    "eastdown" : __DIR__"yunu5",
  ]));
  setup();
}

