inherit BIGROOM;
inherit SANDROOM;
void create ()
{
  set ("short", "踏雪小路");
  set ("long", @LONG
斜斜的一道山脊往西延伸过去。一路踏雪而行，放眼两边青松翠柏，
颇有诗意。小路到了这里，慢慢没入了一片丛林之中。这丛林并不
深，透过树杈间的积雪，阳光斑驳的透了进来。
LONG);
  set("exits",
  ([
     "east" : __DIR__"fabao-road2",
     "westup" : __DIR__"hanmei-road1",
  ]));
  setup();
}

