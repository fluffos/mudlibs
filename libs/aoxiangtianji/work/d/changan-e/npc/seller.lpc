// seller.c
inherit "/obj/npc/xiaofan";
void create()
{
  set_name("长安小贩", ({ "changan xiao fan","seller" }) );
  set("gender", "男性" );
  set("age", 32);
  set("vendor_goods", ([
     "1" : "/d/obj/weapon/stick/shouzhang",
     "2" : "/d/obj/armor/shoes/maxie",
     "3" : "/d/obj/food/bottle",
     "4" : __DIR__"obj/egg",
     "5" : __DIR__"obj/youlong",
  ]));
  set("chat_chance", 20);
  set("chat_msg", ({
      (:random_move:),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 10);
  if (clonep())
    keep_heart_beat();
}

