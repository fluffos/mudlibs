// smith.c
inherit "/std/char/smith.lpc";
void create()
{
  set_name("冯铁匠", ({ "feng", "smith" }) );
  set("gender", "男性" );
  set("age", 53);
  set("long",
"冯铁匠想是常年弯腰打铁，背已驼了，双眼被烟火薰的又红又细，\n"
"左腿残废，肩窝下撑著一根拐杖。\n");
  set("combat_exp", 120000);
  set("str", 24);
  set("dex", 17);
  set("con", 28);
  set("int", 27);
  set("shen_type", 1);
  set("attitude", "friendly");
  set_skill("dodge", 70);
  set_skill("hammer", 120);
  set_skill("parry", 60);
  set_skill("force", 40);
  set_temp("apply/attack", 40);
  set_temp("apply/defense", 40);
  set("vendor_goods", ([
    "1" : "/d/obj/weapon/hammer/hammer",
  ]));
  set("inquiry", ([
    "name": "小人姓冯，村里人都叫我冯铁匠。",
    "here": "这里是小人糊口的铺子，小人就住在後边的屋子。",
    "锄头": "锄头... 抱歉，锄头已经卖光了...",
    "铁锤": "铁锤？小人做的铁锤坚固又耐用，一把只要三百文钱。",
  ]));
  setup();
  add_money("coin", 50);
  carry_object(__DIR__"obj/hothammer")->wield();
}