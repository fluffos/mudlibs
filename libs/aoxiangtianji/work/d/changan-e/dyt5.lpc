#include <ansi.h>
inherit SMALLROOM;
inherit HILLROOM;
void create ()
{
  set ("short", HIW"大雁塔内"NOR+HIC"第五层"NOR);
  set ("long", @LONG
大雁塔内结构精洁宽敞，塔内布置精美，给人以清静肃穆
之感。四周开有龛窗，塔内有楼梯直通上下。这里似乎是
非同寻常的场所。
LONG);
  set("exits", ([
        "down"    : __DIR__"dyt4",
        "up"      : __DIR__"dyt6",
      ]));
  setup();
}

