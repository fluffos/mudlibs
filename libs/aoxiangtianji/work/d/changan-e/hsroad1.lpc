inherit BIGROOM;
inherit SANDROOM;
void create()
{
  set("short", "青石大道");
  set("long", @LONG
你走在一条青石大道上，人来人往非常繁忙，不时地有人骑着马匆匆
而过。大道两旁有一些小货摊，似乎是一处集市。
LONG );
  set("outdoors", "village");
  set("exits", ([
    "north" : __DIR__"hsroad2",
    "southeast" : "/d/luoyang/guandaos4",
  ]));
  set("objects", ([
    sprintf("/obj/npc/girl%d",1+random(4)): 1,
    sprintf("/obj/npc/girl%d",1+random(3)): 1,
  ]));
  setup();
}

