inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "官道");
  set ("long", @LONG
这是一条长长的官道，官道上马车并行，人流不断。东北直通往北平
府，往南就是著名的关洛大道了，西边一座高塔巍然，而东，似乎似
乎透着些神秘！
LONG );
  set("exits", ([
