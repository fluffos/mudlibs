inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "进士场");
  set ("long", @LONG
进士场是一个不大不小的广场，据说新科进士在受赐之后都要在进士
场题名刻碑。另外这里也是文人墨客汇集的地方，在这里交流心得体
会。北边是碑林。
LONG);
  set("exits", ([
      "north" : __DIR__"beilin1",
      "east"  : __DIR__"guandao2",
  ]));

  set("objects", ([
      "/d/city/npc/xiucai1" : 1,
      "/d/city/npc/xiucai2" : 1,
      "/d/city/npc/xiucai3" : 1,
    ]));
