inherit BIGROOM;
inherit LANDROOM;
void create ()
{
  set ("short", "官道");
  set ("long", @LONG
这是一条长长的官道，官道上马车并行，人来人往。官道一头伸向
东南，一头伸向西北，东边有一座丘陵。
LONG);
  set("exits", ([
        "northwest"  : __DIR__"guandao2",
        "southeast"  : __DIR__"guandao4",
        "east"       : __DIR__"shihuang",
  ]));

  set("outdoors", "changan");
  setup();
}