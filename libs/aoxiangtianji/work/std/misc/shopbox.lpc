// this object is put in hockshop to hold items.
// by mon. 2/28/98
#include <ansi.h>
inherit ITEM;
#define MAX_GOODS_NUM 10
#define MAX_TOTAL_NUM 150
void create()
{
   set_name("聚宝盒",({"treasure box", "box"}));
   set("short", "聚宝盒");
   set("env/invisibility",10);
   set_max_encumbrance(50000000);
   set_max_items(10000);
   set_weight(100);
   set("no_get",1);
   set("no_magic", 1);
   set("no_fight", 1);
   seteuid(getuid());
   setup();
}

void refresh_goods_list()
{
  mapping tmp_list, num_list, wp_list;
  string *k_l;
  int i;

  num_list = query_temp("goods");
  if(!mapp(num_list) || sizeof(num_list) < 1)
    return;

  k_l = keys(num_list);
  tmp_list = ([ ]);
  for (i=0;i<sizeof(k_l);i++)
  {
    wp_list = num_list[k_l[i]];
    if (!mapp(wp_list) || sizeof(wp_list) < 1)
    {
      map_delete(num_list,k_l[i]);
      continue;
    }

    tmp_list += ([ sprintf("%d",i+1) : wp_list ]);
  }

  set_temp("goods",tmp_list);
  return;
}

int add_goods(object obj)
{
  mapping goods;
  string *kg;
  string owner,objfile;
  int num, i, g_num;

  if (!objectp(obj))
    return 0;

  goods = query_temp("goods");
  objfile = base_name(obj);
  owner = obj->query("owner");
  num = obj->query_amount();
  if (num < 1)
    num = 1;

  if (!mapp(goods) || sizeof(goods) < 1)
  {
    goods = ([ "1" : ([
                       "objfile" : objfile,
                       "name" : obj->query("name"),
                       "id"   : obj->query("id"),
                       "num"  : num,
                       "owner" : owner,
                      ]),
            ]);
  }

  else
  {
    kg = keys(goods);
    if (sizeof(kg) > MAX_TOTAL_NUM)
    {
      write("本当铺仓库已经满了。\n");
      return 0;
    }

    g_num = 0;
    for (i=0;i<sizeof(kg);i++)
    {
      if (goods[sprintf("%d",i+1)]["objfile"] == objfile)
      	g_num++;
    }

    if (g_num > MAX_GOODS_NUM)
    {
      write("这类物品太多了，本当铺不收！\n");
      return 0;
    }

    goods += ([ sprintf("%d",sizeof(kg)+1) : ([
                                               "objfile" : objfile,
                                               "name" : obj->query("name"),
                                               "id"   : obj->query("id"),
                                               "num"  : num,
                                               "owner" : owner,
                                             ]),
             ]);
  }

  set_temp("goods",goods);
  obj->move(this_object());
  destruct(obj);
  return 1;
}

int goods_found(string parm, string file)
{
  switch (parm)
  {
    case "all" :
      return 1;
      break;
    case "book" :
    case "书" :
    case "书本" :
      if(file->query("skill"))
        return 1;
      else
        return 0;
      break;
    case "drug" :
    case "药品" :
    case "药" :
      if(file->is_drug())
        return 1;
      else
        return 0;
      break;
    case "herb" :
