string goods_list(string arg)
{
  mapping num_list, wp_list;
  string out, unit, o_name;
  int i, value, found;
  num_list = query_temp("goods");
  if(!mapp(num_list) || sizeof(num_list) < 1)
    return "没有任何物品可以出售。\n";

  if (!arg || arg == "all")
  {
    out = "你可以购买下列这些东西：\n";
    for (i=0;i<sizeof(num_list);i++)
    {
      reset_eval_cost();
      wp_list = num_list[sprintf("%d",i+1)];
      if (!mapp(wp_list) || sizeof(wp_list) < 1)
        continue;
      value = wp_list["objfile"]->query("value");
      if (!value)
        value = wp_list["objfile"]->query("base_value");
      unit = wp_list["objfile"]->query("unit");
      if (!stringp(unit))
        unit = wp_list["objfile"]->query("base_unit");

      o_name = (string)wp_list["name"];
      out += sprintf("[%-3d] %-"+(20+color_len(o_name))+"s %-30s → 还剩%s%s \n",
                     i+1,
                     o_name,
                     MONEY_D->money_num(value),
                     chinese_number(wp_list["num"]),
                     unit);
    }

  }

  else
  {
    out = "本店目前有如下" + arg + "当卖：\n";
    found = 0;
    for (i=0;i<sizeof(num_list);i++)
    {
      reset_eval_cost();
      wp_list = num_list[sprintf("%d",i+1)];
      if (!mapp(wp_list) || sizeof(wp_list) < 1)
        continue;
      if (!goods_found(arg,wp_list["objfile"]))
      {
        if (COLOR_D->clean_color(wp_list["name"]) != arg && wp_list["id"] != arg)
          continue;
      }

      value = wp_list["objfile"]->query("value");
      if (!value)
        value = wp_list["objfile"]->query("base_value");
      unit = wp_list["objfile"]->query("unit");
      if (!stringp(unit))
        unit = wp_list["objfile"]->query("base_unit");
      found = 1;
      o_name = (string)wp_list["name"];
      out += sprintf("[%-3d] %-"+(20+color_len(o_name))+"s %-30s → 还剩%s%s \n",
                     i+1,
                     o_name,
                     MONEY_D->money_num(value),
                     chinese_number(wp_list["num"]),
                     unit);
    }

    if (!found)
      out = "本店目前没有任何" + arg + "当卖！\n";
  }

  return out;
}

void reduce_goods(string arg)
{
  mapping num_list, wp_list;
  int catlog;
  num_list = query_temp("goods");
  if(!mapp(num_list) || sizeof(num_list) < 1)
    return;

  if(!arg)
    return;

  catlog = to_int(arg);
  if (!catlog || catlog < 0 || catlog > sizeof(num_list))
    return;

  wp_list = num_list[sprintf("%d",catlog)];
  if (!mapp(wp_list) || sizeof(wp_list) < 1)
    return;

  map_delete(num_list,sprintf("%d",catlog));
  set_temp("goods",num_list);
  refresh_goods_list();
}

object buy_goods(string arg)
{
  object ob = 0;
  mapping num_list, wp_list;
  string *obj_id;
  string o_name, o_id, owner, obj_file;
  int catlog, num;
  num_list = query_temp("goods");
  if(!mapp(num_list) || sizeof(num_list) < 1)
  {
    write("现在没有东西出售。\n");
    return 0;
  }

  if(!arg)
  {
    write("你要买什么？\n");
    return 0;
  }

  catlog = to_int(arg);
  if (!catlog || catlog < 0 || catlog > sizeof(num_list))
  {
    write("你要买什么物品？\n");
    return 0;
  }

  wp_list = num_list[sprintf("%d",catlog)];
  if (!mapp(wp_list) || sizeof(wp_list) < 1)
  {
    write("你要买什么？有这种物品卖吗？\n");
    return 0;
  }

  obj_file = wp_list["objfile"];
  o_name = wp_list["name"];
  o_id = wp_list["id"];
  num = wp_list["num"];
  owner = wp_list["owner"];
/*
  map_delete(num_list,sprintf("%d",catlog));
  set_temp("goods",num_list);
  refresh_goods_list();
*/
  if (!stringp(obj_file))
  {
    write("找不到这样物品了！\n");
    return 0;
  }

  ob = new(obj_file);
  if (!objectp(ob))
  {
    write("这个物品不存在了！\n");
    return 0;
  }

  ob->set_amount(num);
  if (o_name != ob->query("name") || o_id != ob->query("id"))
  {
    obj_id = ob->query_my_id();
    obj_id[0] = o_id;
    ob->set_name(o_name,obj_id);
    ob->set("owner",owner);
    ob->setup();
  }

  return ob;
}

int clean_up()
{
  return 0;
}

