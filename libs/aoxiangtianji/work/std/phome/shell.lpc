// shell.c
// 玩家的中文名如改名，此处应能自动更改。
inherit ITEM;
protected void get_domain(string arg,object me);
protected void confirm_cost(string arg,object me,int cost);
protected void get_level(string arg,object me);
int is_build_home_shell() {return 1;}
void create()
{
  set_name("建房申请表", ({"shell"}));
  set("long", "这是一张没有填写(tianxie)的空白建房申请表。\n");
  set("unit", "张");
  set("weight", 10);
  set("value", 0);
}
void init()
{
  add_action("do_fill",({"tianxie","fill"}));
}
int do_fill(string arg)
{
  object me = this_player();
  if (!objectp(me) || !playerp(me))
    return 0;

  if(arg != "shell")
    return 0;
  if(query("player_id"))
    return notify_fail("这张表格已经填写过了，要重填再去买一张空白的吧。\n");
  write("填写过程中，可以用quit 或者 q来退去填写！\n");
  write("你准备交多少地皮使用费？(单位：两/黄金)\n");

  input_to ((: get_domain :),me);
  return 1;
}
protected void get_domain(string arg,object me)
{
  int cost;
  if (!objectp(me) || !playerp(me))
    return 0;
  if(arg[0] == 'q')
    return;
  cost = to_int(arg);
  if(!cost || !intp(cost) || cost < 1)
  {
    write("你准备交多少地皮使用费？(单位：两/黄金)\n");
    input_to ((: get_domain :),me);
    return;
  }
  write("你准备交"+chinese_number(cost)+"两黄金的地皮使用费吗？(y/n)\n");
  input_to((: confirm_cost :),me,cost);
}
protected void confirm_cost(string arg,object me,int cost)
{
  int v1,v2;

  if (!objectp(me) || !playerp(me))
    return 0;
  if(arg[0] == 'q')
    return;
  if(arg == "" || (arg[0]!='y' && arg[0]!='Y'))
  {
    write("你准备交多少地皮使用费？(单位：两/黄金)\n");
    input_to ((: get_domain :),me);
    return;
  }
  set("domain_cost",cost*10000);
  write("可修建的房屋等级如下：\n");
  v1 = PLAYERHOME_D->home_value(1);
  v2 = PLAYERHOME_D->home_value(2);
  write(sprintf("  1. 一间茅草屋(大约%s)          2. 一间瓦房(大约%s)\n",
                 MONEY_D->money_str(v1),
                 MONEY_D->money_str(v2)));
  v1 = PLAYERHOME_D->home_value(3);
  v2 = PLAYERHOME_D->home_value(4);
  write(sprintf("  3. 一所宅院(大约%s)            4. 豪华大宅院(大约%s)\n",
                 MONEY_D->money_str(v1),
                 MONEY_D->money_str(v2)));
  write("请选择你要修建的房屋等级(1-4)：\n");
  input_to((: get_level :),me);
}
protected void get_level(string arg,object me)
{
  int level, v1, v2;
  if (!objectp(me) || !playerp(me))
    return 0;
  if(arg[0] == 'q')
    return;
  level = to_int(arg);
  if((level != 1)&&(level != 2)&&(level != 3)&&(level != 4) )
  {
    write("可修建的房屋等级如下：\n");
    v1 = PLAYERHOME_D->home_value(1);
    v2 = PLAYERHOME_D->home_value(2);
    write(sprintf("  1. 一间茅草屋(大约%s)          2. 一间瓦房(大约%s)\n",
                   MONEY_D->money_str(v1),
                   MONEY_D->money_str(v2)));
    v1 = PLAYERHOME_D->home_value(3);
    v2 = PLAYERHOME_D->home_value(4);
    write(sprintf("  3. 一所宅院(大约%s)            4. 豪华大宅院(大约%s)\n",
                   MONEY_D->money_str(v1),
                   MONEY_D->money_str(v2)));
    write("请选择你要修建的房屋等级(1-4)：\n");
    input_to((: get_level :),me);
  }
  set("player_id",me->query("id"));
  set("home_level",level);
  set("long","这是一张填写好的建房申请表，抬头写着：申请人 "
             +me->query("name")+"。\n");
  tell_object(me,"ok.\n");
}
