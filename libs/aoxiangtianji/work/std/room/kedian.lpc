inherit ROOM;
inherit SAFTYROOM;
void create()
{
  set("short", "客店");
  set("long", @LONG
这是一家客栈。
LONG);
  set("no_time", 1);
  set("no_bian",1);
  set("freeze",1);
  set("no_npc", 1);
  set("valid_startroom", 1);
  set("no_sleep_room",1);
  set("resource", ([
     "water" : 1,
  ]));

  set("price", 500);
  setup();
}

int valid_leave(object me, string dir)
{
  object mbox,*inv;
  int sizeinv ;

  inv = all_inventory(me);
  sizeinv=sizeof(inv);
  while (sizeinv--)
    if (inv[sizeinv]->is_character())
      return notify_fail("你要背个活人去哪儿？\n");
  if(objectp(mbox = me->query_temp("mbox_ob")))
  {
    tell_object(me, "你将信箱交回给邮差。\n");
    destruct(mbox);
  }

  return ::valid_leave(me, dir);
}

