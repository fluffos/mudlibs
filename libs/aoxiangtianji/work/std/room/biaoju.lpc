#include <ansi.h>
inherit BIGROOM;
inherit LANDROOM;
inherit SAFTYROOM;
int is_biaoju_room() {return 1;}

int do_chaxun(string arg);
int do_tuoyun(string arg);
void create ()
{
  string city = domain_file(file_name(this_object()));

  set ("short", to_chinese(city) + "镖局");
  set ("long", @LONG
这里是城中的镖局，负责帮助客户押运各种货物。τ
ｃｈａｘｕｎ  :  查询各类信息．τ
ｔｕｏｙｕｎ  :  托运货物．
LONG);
  setup();
}

void init()
{
  object who = this_player();

  if (!playerp(who))
    return;
  add_action("do_chaxun", ({"chaxun","info"}));
  add_action("do_tuoyun",({"tuoyun","yunsong"}));
}

int do_chaxun(string arg)
{
  string msg;
  object who = this_player();

  if (!playerp(who))
    return 0;
  if (environment(who) != this_object())
    return 0;
  if (who->is_busy())
    return notify_fail("你正忙着呢。\n");
  msg = BIAOJU_D->query_biaoju_info(arg);
  if (!stringp(msg))
    return 0;
  who->start_more(msg);
  who->start_busy(2);
  return 1;
}

int do_tuoyun(string arg)
{
  string city,msg;
  object who = this_player();

  if (!playerp(who))
    return 0;
  if (environment(who) != this_object())
    return 0;
  if (who->is_busy())
    return notify_fail("你正忙着呢。\n");
  city = domain_file(file_name(this_object()));
  msg = BIAOJU_D->accept_task(city,who,arg);
  if (!stringp(msg))
    return 0;
  who->start_more(msg);
  who->start_busy(2);
  return 1;
}

