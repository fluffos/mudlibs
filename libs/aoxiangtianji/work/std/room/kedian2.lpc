inherit ROOM;
inherit SAFTYROOM;
void create()
{
  set("short", "客店房间");
  set("long", @LONG
这是一家客栈。
LONG);
  set("no_npc", 1);
  set("sleep_room", 1);
  set("hotel",1);
  setup();
}

int valid_leave(object me, string dir)
{
  object mbox,*inv;
  int sizeinv ;
  string ldir;

  inv = all_inventory(me);
  sizeinv=sizeof(inv);
  while (sizeinv--)
    if (inv[sizeinv]->is_character())
      return notify_fail("你要背个活人去哪儿？\n");
  if(objectp(mbox = me->query_temp("mbox_ob")))
  {
    tell_object(me, "你将信箱交回给邮差。\n");
    destruct(mbox);
  }

  ldir = query("leave_dir");
  if (!stringp(ldir))
    ldir = "down";
  if ( dir == ldir )
    me->delete_temp("rent_paid");

  return ::valid_leave(me, dir);
}

