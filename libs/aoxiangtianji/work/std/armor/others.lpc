//设定这个的意义在于可扩展装备的意义范围
//例如象护身符一类的东西可以在与装备不冲突属性的
//情况下又具有一定的特殊的属性。在实际的应用中
//其作用意义是很大的。在一般情况下请勿在此类
//物件上设任何的防御数值。
#include <armor.h>
inherit EQUIP;
int is_armor() {return 1;}

int is_armor_others() {return 1;}

void setup()
{
  if( !clonep(this_object()) )
    set("armor_type", TYPE_OTHERS);
  ::setup();
}

