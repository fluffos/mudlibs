// 盾牌(护具类)
#include <armor.h>
inherit EQUIP;
int is_armor() {return 1;}

int is_armor_shield() {return 1;}

void setup()
{
  if( !clonep(this_object()) )
  {
    set("armor_type", TYPE_SHIELD);
    set("armor_parts",({"body","arm","hand"}));
  }

  ::setup();
}

void init_shield(int armor)
{
  if( clonep(this_object()) )
    return;
  if( !armor)
    set("armor_prop/armor",PROP_SHIELD);
  else
    set("armor_prop/armor",armor);

  if( !query("combine") && !query("NO_LIMIT"))
  {
    if( query("armor_prop/armor") > PROP_SHIELD_MAX )
      set("armor_prop/armor",PROP_SHIELD_MAX);
    if( query("armor_prop/armor") < PROP_SHIELD_MIN )
      set("armor_prop/armor",PROP_SHIELD_MIN);
  }

  if( !query("armor/max_armor") )
    set("armor/max_armor",query("armor_prop/armor"));
  else
    set("armor_prop/armor",query("armor/max_armor"));

  if ((int)query("armor/max_armor") > (int)query("armor_prop/armor"))
    set("armor/max_armor",query("armor_prop/armor"));
}

