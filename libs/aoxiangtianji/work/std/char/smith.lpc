// smith.c
#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
#define MAX_EXP 55000
#define KEY_VALUE	10000	/* 配家门钥匙，1 gold 一把 */
string ask_me();
int  do_gu(string arg);
int  do_dapi(string arg);
int  do_cuihuo(string arg);
int  do_repair(string arg);
void reward(object me);
protected void pei_key(string arg,object me,string *domains);
// no create_function: inherit by other NPC
void init()
{
  ::init();
  add_action("do_vendor_list", "list");
  add_action("do_buy", "buy");
  add_action("do_gu", "gu");
  add_action("do_dapi", "dapi");
  add_action("do_cuihuo", "cuihuo");
  add_action("do_repair", "repair");
  add_action("do_repair", "xiuli");
  add_action("do_pei","pei"); /* 配玩家私宅的钥匙.*/
}

void setup()
{
  set("inquiry/job",    (: ask_me :));
  set("inquiry/工作",   (: ask_me :));
  set("inquiry/repair", "你想要修(" HIY "repair" NOR + CYN ")点什么？" NOR);
  set("inquiry/修理",   "你想要修(" HIY "repair" NOR + CYN ")点什么？" NOR);
  ::setup();
}

string ask_me()
{
  object me = this_player();
  if (me->is_busy())
  {
    write("你正忙着呢！\n");
    return "";
  }

  me->start_busy(1);
  if (me->query("combat_exp") > 50000)
    return "让您老干这个未免屈尊了吧？";
  if (me->query("kee") < 50)
    return me->name() + "还是歇会儿吧！要是出了人命我可承担不起。";
  if (me->query_temp("smith/gu"))
    return "让你去鼓(" HIY "gu" NOR + CYN ")风箱，你怎么还磨蹭？";
  if (me->query_temp("smith/dapi"))
    return "叫你打的坯(" HIY "dapi" NOR + CYN ")你打了没有？";
  if (me->query_temp("smith/cuihuo"))
    return "干活怎么尽偷懒？快给我淬火(" HIY "cuihuo" NOR + CYN ")去！";
  switch(random(3))
  {
    case 0:
      me->set_temp("smith/gu", 1);
      return sprintf("好！%s帮我鼓(" HIY "gu" NOR + CYN ")一会儿风箱。",me->name());
    case 1:
      me->set_temp("smith/dapi", 1);
      return sprintf("这样吧，%s帮我打(" HIY "dapi" NOR + CYN")一下坯吧！",me->name());
    case 2:
      me->set_temp("smith/cuihuo", 1);
      return sprintf("%s去帮我把这些刚出炉的淬(" HIY "cuihuo" NOR + CYN ")一下火。",me->name());
  }

}

int do_gu(string arg)
{
  object me = this_player();
  if (me->is_busy())
    return notify_fail("你现在正忙。\n");
  if (! me->query_temp("smith/gu"))
  {
    message_vision(HIR "\n$n" HIR "刚偷偷的拉起鼓风机，鼓"
                       "了几阵风。\n就听见$N" HIR "对$n" HIR
                       "大喝道：滚开，乱搞什么。\n" NOR, this_object(), me);
    me->start_busy(2);
    return 1;
  }

  message_vision(HIY "$n" HIY "拉起鼓风机拼命鼓了起来，$N" HIY"看了点了点头。\n" NOR,
                 this_object(), me);
  reward(me);
  return 1;
}

int do_dapi(string arg)
{
  object me = this_player();
  if (me->is_busy())
    return notify_fail("你现在正忙。\n");
  if (! me->query_temp("smith/dapi"))
  {
    message_vision(HIR "\n$n" HIR "拿起几块生铁，在手里"
                       "掂了掂。\n就听见$N" HIR "对$n" HIR
                       "大喝道：放下，乱搞什么。\n" NOR,
                        this_object(), me);
    me->start_busy(2);
    return 1;
  }

  message_vision(HIY "$n" HIY "拿着锤子对刚出炉的火热的生铁用"
                     "力敲打着，$N" HIY "“嗯”了一声，看上去有些"
                     "满意。\n" NOR,
                     this_object(), me);
  reward(me);
  return 1;
}

int do_cuihuo(string arg)
{
  object me = this_player();
  if (me->is_busy())
    return notify_fail("你现在正忙。\n");
  if (! me->query_temp("smith/cuihuo"))
  {
    message_vision(HIR "\n$n" HIR "刚抄起一个打造好的坯子"
                       "，摆弄了几下。\n就听见$N" HIR "对$n"
                   HIR "大喝道：放下，别给我搞坏了。\n" NOR,
                   this_object(), me);
    me->start_busy(2);
    return 1;
  }

  message_vision(HIY "$N" HIY "用铁钳抄起一块火红的坯子，伸进"
                     "了水池，“哧”的一声轻烟四冒。\n" NOR, me);
  reward(me);
  return 1;
}

void reward(object me)
{
  int exp, pot;
  object coin;
  me->delete_temp("smith/gu");
  me->delete_temp("smith/dapi");
  me->delete_temp("smith/cuihuo");
  coin = new("/obj/money/coin");
  coin->set_amount(20 + random(20));
  coin->move(this_object());
  message_vision(CYN "$N" CYN "对$n" CYN "道：干得不坏，这是给"
                     "你的工钱。\n" NOR, this_object(), me);
  command("give coin to " + me->query("id"));
  exp = 20 + random(20);
  if ((int)me->query("work/newbie_tj/exp") > MAX_EXP)
    exp = 0;
  pot = exp/3 + random(exp/3 + 1);
  GIFT_D->delay_work_bonus(me,([ "exp" : exp,
                                 "pot"    : pot,
                                 "prompt" : "通过这次锻炼",
                               ]),"newbie_tj");
  me->receive_damage("kee", 30 + random(20));
  me->start_busy(3);
}

int do_repair(string arg)
{
  object me;
  object ob;
  mixed  msg;
  int consistence;
  int cost;
  mapping repair;
  if (! arg)
    return notify_fail("你打算修理什么物件？\n");
  me = this_player();
  if (! objectp(ob = present(arg, me)))
    return notify_fail("你身上好像没有这样东西。\n");
  if (undefinedp(consistence = ob->query("consistence")))
    return notify_fail(ob->name() + "似乎不需要在这里修理吧？\n");
  if (consistence >= 100)
    return notify_fail(ob->name() + "现在完好无损，修理做什么？\n");
  if (! undefinedp(msg = ob->query("no_repair")))
  {
    if (! stringp(msg))
      write(CYN + name() + CYN "皱眉道：这东西我可修"
                               "理不了。\n" NOR);
    else
      write(CYN + name() + CYN "皱眉道：" + msg + NOR + CYN);
    return 1;
  }

  if (mapp(repair = me->query_temp("pending/repair")) && repair["item"] == ob)
  {
    if (me->is_busy())
      return notify_fail("你现在正忙着呢！\n");
    if (MONEY_D->player_pay(me, repair["cost"]) != 1)
      return notify_fail("你身上的钱不够啊！\n");
     message_vision(HIW "$n" HIW "把" + ob->name() + HIW "递"
                        "给了$N" HIW "。\n只见$N" HIW "拿起工具，"
                        "东敲西补，将" + ob->name() + HIW "好好修"
                        "了修。\n" NOR, this_object(), me);
     ob->set("consistence", 100);
     message_vision(HIC "$N" HIC "道：“好了。”随手把" + ob->name()
                  + HIC "还给了$n" HIC "，$n" HIC "看了看，"
                    "满意的掏出了一些钱付了帐。\n" NOR,
                    this_object(), me);
     me->start_busy(1 + random(100 - consistence) / 10);
     me->delete_temp("pending/repair");
     return 1;
  }

  cost = (120 - consistence) * ob->query("value") / 600;
  if (cost >= 100000) cost = ((cost - 100000) / 2 + 100000) / 10000 * 10000; else
  if (cost >= 10000)  cost = cost / 1000 * 1000; else
  if (cost >= 1000)   cost = cost / 100 * 100; else
  if (cost >= 100)    cost = cost / 10 * 10;
  message_vision(CYN "\n$n" CYN "拿出一" + ob->query("unit") +
                 ob->name() + NOR + CYN "，$N" CYN "瞥了一眼"
                 "，道：要修好它得要" + MONEY_D->price_str(cost) +
                 NOR + CYN "才行。\n" NOR, this_object(), me);
  tell_object(me, YEL "如果你的确想修理这件物品，请再输入一次这条命令。\n" NOR);
  me->set_temp("pending/repair/item", ob);
  me->set_temp("pending/repair/cost", cost);
  return 1;
}

int do_pei(string arg)
{
  object me = this_player();
  string *homes, *domains = ({});
  int i,n,l,bk;
  if (!objectp(me) || !playerp(me))
    return 0;

  if(!environment() || base_name(environment()) != query("startroom"))
    return 0;
  if(arg != "key" && arg != "钥匙")
  {
    write("你要配什么？\n");
    return 1;
  }

  if( ! (homes = PLAYERHOME_D->user_have_home(me->query("id"))) )
    return notify_fail("你还没有自己的住宅配什么钥匙呀！\n");
  n = sizeof(homes);
  for(i=0;i<n;i++)
  {
    string domain;
    if(sscanf(homes[i],"/phome/%s/%*s",domain))
      domains += ({ domain });
  }

  if( (n=sizeof(domains)) == 1 )
    pei_key("1",me,domains);
  else
  {
    string out = "";
    for(i=0;i<n;i++)
      if(strlen(domains[i]) > l)
        l = strlen(domains[i]);
    bk = to_int(60/(l+4));
    l++;
    for(i=0;i<n;i++)
      out += sprintf("%-2d.%-"+(string)l+"s%s",(i+1),domains[i],(i%bk==(bk-1))?"\n":"" );
    write("你在以下"+chinese_number(n)+"处地区都有自己的住宅，你要配哪一处的钥匙：\n"+out+"\n");
    input_to( (: pei_key :),me, domains );
  }

  return 1;
}

protected void pei_key(string arg,object me,string *domains)
{
  object ob;
  int n,f;
  if (!objectp(me) || !playerp(me))
    return 0;
  if(arg[0] == 'q')
    return;
  n = to_int(arg);
  --n;
  if( (n<0) || (n>=sizeof(domains)) || !me)
    return;
  ob = new(sprintf("/phome/%s/%s_key",domains[n],me->query("id")));
  if(!objectp(ob))
  {
    write("你的家门钥匙出现错误，请向巫师报告。\n");
    return;
  }

  f = me->can_afford(KEY_VALUE);
  if(!f || f == 2)
  {
    write(sprintf("配家门钥匙每把需要%s，回去拿够了现钱再来吧。\n",MONEY_D->money_str(KEY_VALUE)));
    destruct(ob);
    return;
  }

  me->pay_money(KEY_VALUE);
  if(!ob->move(me,1))
  {
    destruct(ob);
    write("你身上已经拿不了更多的东西了，下次再来配吧。");
    return;
  }

  write(name()+"说道：“钥匙配好了，千万保管好。”\n");
  write(sprintf("%s给你一把%s。\n",name(),ob->name()));
}

