// 鞭类(武器类)
#include <weapon.h>
#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit EQUIP;
#endif
int is_weapon() {return 1;}

int is_weapon_whip() {return 1;}

varargs void init_whip(int damage, int flag)
{
  if( clonep(this_object()) ) return;
  set("weapon_prop/damage", damage);
	//设定最大破损默认值
  if( !query("max_weapon") )
    set("max_weapon",query("weapon_prop/damage"));
//设定默认硬度值
  if( !query("rigidity") )
    set("rigidity","/adm/daemons/weapond"->query_cz(query("material")));
  set("flag", flag );
  set("skill_type", "whip");
  if( !query("actions") )
  {
    set("actions", (: call_other, WEAPON_D, "query_action" :) );
    set("verbs", ({ "whip","wave" }) );
  }

}

int query_attack_distance()
{
  int distance;
  distance = (int)query("attack_distance");

  if (distance)
    return distance;
  else
    return WHIP_DIS;
}	