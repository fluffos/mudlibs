// 刀类
#include <weapon.h>
#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit EQUIP;
#endif
int is_weapon() {return 1;}

int is_weapon_blade() {return 1;}

//刀具有的伤害 slice hack chop slash
varargs void init_blade(int damage, int flag)
{
  if( clonep(this_object()) )
    return;
  set("weapon_prop/damage", damage);
//设定最大破损默认值
  if( !query("max_weapon") )
    set("max_weapon",query("weapon_prop/damage"));
//设定默认硬度值
  if( !query("rigidity") )
    set("rigidity","/adm/daemons/weapond"->query_cz(query("material")));
  set("flag", (int)flag | EDGED);
  set("skill_type", "blade");
  if( !query("actions") )
  {
    set("actions", (: call_other, WEAPON_D, "query_action" :) );
    set("verbs", ({ "slash", "slice", "hack", "chop" }) );
  }

}

int query_attack_distance()
{
  int distance;
  distance = (int)query("attack_distance");

  if (distance)
    return distance;
  else
    return BLADE_DIS;
}	