  set("int", 20);
  set("con", 20);
  set("dex", 25);
  set("max_kee", 1500);
  set("max_sen", 1500);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 50);
  set("combat_exp", 40000);
  set("score", 100);
  set("apply/attack",  50);
  set("apply/defense", 50);
  set_skill("force", 80);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_skill("jindouyun", 80);
  set_skill("wuxiangforce", 80);
