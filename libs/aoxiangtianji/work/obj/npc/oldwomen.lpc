#include <ansi.h>
inherit NPC;
void greeting(object ob);
void create()
{
  set_name("烧香老太", ({"lao taitai", "lao", "taitai"}));
  set("gender", "女性");
  set("long", "见佛烧香的老太太。\n");
  set("combat_exp", 5000);
  set("age",55+random(20));
  set_skill("dodge", 20);
  set_skill("force", 20);
  set_skill("parry", 20);
  set_skill("unarmed", 20);
  set_skill("sword", 20);
  set("chat_chance", 20);
  set("chat_msg",({
        (:random_move:),
  }));
  setup();
  add_money("silver", 2);
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  object ob = this_player();
  ::init();

  if (playerp(ob) && ! is_fighting())
    greeting(ob);
}

void greeting(object ob)
{
  object xiang = present("xiang", environment());
  if (playerp(xiang) || !ob || environment(ob) != environment())
    return;
  if (xiang)
  {
    message_vision(CYN "$N" CYN "恭敬地向$n" NOR +
                   CYN "跪倒，嘴里念念有词。\n" NOR,
                   this_object(), xiang);
    return;
  }

  tell_object(ob, CYN "烧香老太对你道：对菩萨要恭敬，要敬重鬼神。\n" NOR);
  return;
}