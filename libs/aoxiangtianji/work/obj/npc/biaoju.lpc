#include <ansi.h>
inherit NPC;
void greeting(object ob);
void create()
{
  set_name("镖师", ({"biaoju boss", "master"}));
  set("title", "镖局账房");
  set("gender", "男性");
  set("age", 40+random(30));
  set("str", 22);
  set("int", 24);
  set("dex", 18);
  set("con", 18);
  set("kee", 5000);
  set("max_kee", 5000);
  set("sen", 5000);
  set("max_sen", 5000);
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("env/wimpy", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/damage", 40);
  setup();
  carry_object("/obj/cloth/choupao")->wear();
}

void init()
{
  object ob;
  ::init();
  if(playerp(ob = this_player()) && !is_fighting() )
    greeting(ob);
}

void greeting(object ob)
{
  if( !ob || !visible(ob) || environment(ob) != environment() )
    return;
  switch( random(1) )
  {
    case 0:
      say( name()+"说道：这位" + RANK_D->query_respect(ob)
                 + "，可有什么货物需要押送？\n");
      break;
  }

}

