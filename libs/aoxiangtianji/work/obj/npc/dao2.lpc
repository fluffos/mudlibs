// seng.c
inherit NPC;
void create()
{
  set_name("中年道士", ({"zhongnian daoshi", "daoshi", "taoist"}));
  set("long","一个梳着三发髻的道士。\n");
  set("gender", "男性");
  set("attitude", "peace");
  set("class", "taoist");
  set("age", 30+random(10));
  set("str", 25);
  set("int", 20);
  set("con", 20);
  set("dex", 25);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("force", 500);
  set("max_force", 500);
  set("force_factor", 20);
  set("combat_exp", 20000);
  set("score", 100);
  set("apply/attack",  30);
  set("apply/defense", 30);
  set_skill("force", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set_skill("jindouyun", 50);
  set_skill("wuxiangforce", 50);
  set_skill("puti-zhi", 50);
  map_skill("force", "wuxiangforce");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  setup();
  carry_object("/obj/cloth/dao-cloth")->wear();
  carry_object("/obj/cloth/dao-xie")->wear();
  add_money("coin", 50);
}

