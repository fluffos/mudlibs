// seng.c
inherit NPC;
void create()
{
  set_name("老尼姑", ({"lao nigu", "nigu"}));
  set("long","一个慈眉善目的老尼姑。\n");
  set("gender", "男性");
  set("attitude", "peace");
  set("class", "bonze");
  set("age", 67);
  set("str", 25);
  set("int", 20);
  set("con", 20);
  set("dex", 25);
  set("max_kee", 1500);
  set("max_sen", 1500);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 50);
  set("combat_exp", 40000);
  set("score", 100);
  set("apply/attack",  50);
  set("apply/defense", 50);
  set_skill("force", 80);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_skill("lotusmove", 80);
  set_skill("lotusforce", 80);
  set_skill("jienan-zhi", 80);
  map_skill("force", "lotusforce");
  map_skill("dodge", "lotusmove");
  map_skill("unarmed", "jienanzhi");
  setup();
  carry_object("/obj/cloth/y-jiasha")->wear();
  carry_object("/obj/cloth/ni-xie")->wear();
  add_money("coin", 50);
}

