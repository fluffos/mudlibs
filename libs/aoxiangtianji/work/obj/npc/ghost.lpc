//Created by waiwai@2002/12/05
#include <ansi.h>
inherit NPC;
string *first_name = ({ "勾魂夺命", "阴魂不散" });
string *name_words = ({ "鬼"});
void create()
{
	string name;
       name = element_of(first_name);
       name += element_of(name_words);
       set_name(name, ({"ghost"}));
       set("gender", "男性" );
	set("age", 30+random(20));
	set("race", "妖魔");
	set("tudi", 1);
	set("env/invisibility", 1);
	set("title", HIB "(鬼气)" NOR);
       set("combat_exp", 3000000);
	set("daoxing", 50000);
	set("attitude", "heroism");
	set_skill("unarmed", 100);
	set_skill("dodge", 100);
	set_skill("parry", 100);
	set_skill("ghost-steps", 100);
	set_skill("jinghun-zhang", 100);
	map_skill("dodge", "ghost-steps");
	map_skill("parry", "jinghun-zhang");
	map_skill("unarmed", "jinghun-zhang");
	set("no_blade", 1);//不怕冰刀
	set("no_poison", 1);//不怕用毒
       set_temp("die", WHT"突然周围升起一股烟雾～～～\n"NOR);
       setup();
}

int heal_up()
{
        if( environment() && !is_fighting() ) {
                remove_call_out("leave");
                call_out("leave", 3);
                return 1;
        }

        return ::heal_up() + 1;
}

void leave()
{
      if(this_object()) {
        message("vision",HIB + name() + "身子一晃，变成一股青烟散去了。\n" NOR,environment(),this_object() );
        destruct(this_object());
      }

//      return;
}

void unconcious() { die(); }

