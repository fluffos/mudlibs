// seng.c
inherit NPC;
void create()
{
  set_name("小道姑", ({"xiao daogu", "daogu", "taoist"}));
  set("long","一个天真调皮的小道姑，时不时的看着你偷偷笑。\n");
  set("gender", "女性");
  set("attitude", "peace");
  set("class", "taoist");
  set("age", 12+random(4));
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 25);
  set("max_kee", 700);
  set("max_sen", 700);
  set("force", 300);
  set("max_force", 300);
  set("force_factor", 20);
  set("combat_exp", 10000);
  set("apply/attack",  30);
  set("apply/defense", 30);
  set_skill("force", 40);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_skill("parry", 40);
  setup();
  carry_object("/obj/cloth/daogu-cloth")->wear();
  carry_object("/obj/cloth/dao-xie")->wear();
  add_money("coin", 20);
}

