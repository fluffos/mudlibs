#include <ansi.h>
inherit NPC;
void owner_is_killed(object killer);
void invocation(object me);
void create()
{
	string *elf,*beast;
	elf=({
	"火精灵",
	"水精灵",
	"矮精灵",
	"海精灵",
	"小矮人",
	"小侏儒",
	"小天使",
	"美人鱼",
	"小米宝宝",
	"森林精灵",
	"魔法精灵",
	});
	beast=({
	"三头龙",
	"双头蛇",
	"巨蜥",
	"火龙",
	"飞龙",
	"巨蟒",
	"长毛狮",
	"红眼狮",
	});	if(random(2)==1) {
		set_name(elf[random(11)], ({ "elf" }) );
		set("long","来自迷雾岛的精灵,拥有不可思议的魔法,一千年以来,\n"
		           "迷雾岛的精灵们一直遵守这一条契约永远守护被迷雾\n"
		           "岛精灵们挑选中的魔法师\n");
        	set("title","迷雾岛精灵");
        	set("nickname",HIR"守护精灵"NOR);
	} else 	{
		set_name(beast[random(8)], ({ "beast" }) );
		set("long","来自迷雾岛的怪物,拥有不可思议的力量,一千年以来,\n"
		           "迷雾岛的怪物们一直遵守这一条契约永远守护被迷雾\n"
		           "岛精灵们挑选中的魔法师\n");
		set("race","野兽");
              set("limbs", ({ "头部", "身体", "尾巴" }) );
              set("verbs", ({ "bite", "claw" }) );
           	set("title","迷雾岛怪兽");
        	set("nickname",HIG"守护怪兽"NOR);
	}

	set("per",30);
	set("str",30);
	set("cor", 30);
	set("cps", 25);
	set("kee", 3000);
	set("force", 2000);
	set("max_force", 2000);
	set("sen", 3000);
	set("max_kee", 3000);
	set("max_sen", 3000);
	set("max_mana", 2000);
	set("mana", 2000);
	set("combat_exp", 300000);
	set_skill("parry", 10);
	set_skill("dodge",10);
	set("tudi",1);
	set("no_blade", 1);
	set("no_poison", 1);
       set_temp("die", WHT"突然周围升起一股烟雾～～～\n"NOR);
	setup();
	if(this_object()->query("id")=="elf") {
		carry_object(__DIR__"obj/elfcloth")->wear();
	}

}

int heal_up()
{
	object player;
	player=query("owner");
	if(!player||!objectp(player)||!environment(player)) {
		destruct(this_object());
		return 1;
	}

	else if(environment(this_object())!=environment(player)) {
		if(player) {
		this_object()->move(environment(player));
//		message_vision("$N走了过来...\n",this_object());
		this_object()->set_temp("protect", player);
		} else destruct(this_object());
		}

	return ::heal_up() + 1;
}

void invocation(object me)
{
	this_object()->set_name(this_object()->query("name"),({me->query("id")+"'s "+this_object()->query("id")}));
//	command("protect "+me->query("id")+"");
	command("guard "+me->query("id")+"");
}

void owner_is_killed(object killer)
{
       object player;
	player=query_temp("protect");
	if(player) player->delete_temp("invocation");
	destruct(this_object());
	return ;
}

int accept_fight(object ob) { return 0; }

void unconcious () { die(); }

void killed_enemy(object victim)
{
	object player;
	player=query("owner");
	if(!player||!objectp(player)||!environment(player)) {
		destruct(this_object());
		return ;
	}

	player=query_temp("protect");
	if(!player||!objectp(player)||!environment(player)) {
		return ;
	}

	player->set_temp("last_damage_from",player);
	return ;
}

