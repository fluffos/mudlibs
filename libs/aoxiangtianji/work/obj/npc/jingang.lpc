void invocation(object who);
#include <ansi.h>
inherit NPC;
void invocation(object who);
void create()
{
  set_name("天神护法金刚", ({ "tianshen jingang","jingang" }) );
  set("max_kee", 500);
  set("max_sen", 500);
  set("max_mana", 200);
  set("mana", 200);
  set("max_force", 200);
  set("force", 200);
  set("age", 50);
  set("str", 25);
  set("cor", 30);
  set("spi", 30);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("sword", 30);
  set_skill("parry",30);
  set_skill("sword",30);
  set_skill("force",30);
  set_skill("spells",30);
  set_skill("feiyan-zoubi",30);
  set_skill("sancai-sword",30);
  set_skill("changquan",30);
  set_skill("tuna-qigong",30);
  set_skill("taoism",30);
  map_skill("force","tuna-qigong");
  map_skill("spells","taoism");
  map_skill("unarmed","changquan");
  map_skill("sword","sancai-sword");
  map_skill("parry","sancai-sword");
  map_skill("dodge","feiyan-zoubi");
  set("chat_chance_combat", 30);
  set("chat_msg_combat",
  ({
     (: perform_action, "sword.sanzi" :),
  }) );
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/damage", 30);
  set_temp("apply/armor", 30);
  setup();
  if (clonep())
    keep_heart_beat();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
}

void init()
{
  add_action("do_release", "release");
}

int do_release()
{
  object who=this_player();
  if( who != this_object()->query_temp("owner") )
    return notify_fail("什么？\n");
  message_vision("$N向$n挥了挥手，$n慢慢地走开了。\n", who, this_object());
  destruct( this_object() );
  return 1;
}

void invocation(object who)
{
  int i;
  object *enemy;
  message_vision("$N大喝到，小神前来护法！\n",this_object());
  this_object()->set_temp("owner",who);
  NPC_D->set_from_me(this_object(), who, 100 + random(who->query("level")/4 + 1));
  message_vision(HIY"\n$N加入战斗。\n\n"NOR, this_object());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while(i--)
  {
    if( enemy[i] && living(enemy[i]) )
    {
      kill_ob(enemy[i]);
      if( userp(enemy[i]) )
        enemy[i]->fight_ob(this_object());
      else
      {
        enemy[i]->kill_ob(this_object());
        enemy[i]->kill_ob(who);
      }

    }

  }

  set_leader(who);
}

void die()
{
  if( environment() )
  {
    message("sound", "护法金刚长叹一声，眨眼就消失了。\n", environment());
  }

  destruct(this_object());
}

void scan()
{
  object master;
  ::scan();

  master = query_temp("owner");
  if (!objectp(master) ||
      !master->is_fighting() ||
      environment() != environment(master))
  {
    message_vision("$N拱手道，没有战斗，小神先告退了。。。\n",this_object());
    destruct(this_object());
    return;
  }

  return;
}