// seng.c
inherit NPC;
void create()
{
  set_name("中年和尚", ({"zhongnian heshang", "heshang", "seng"}));
  set("long","一个老实厚道的和尚。\n");
  set("gender", "男性");
  set("attitude", "peace");
  set("class", "bonze");
  set("age", 30+random(10));
  set("str", 25);
  set("int", 20);
  set("con", 20);
  set("dex", 25);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("force", 500);
  set("max_force", 500);
  set("force_factor", 20);
  set("combat_exp", 20000);
  set("score", 100);
  set("apply/attack",  30);
  set("apply/defense", 30);
  set_skill("force", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set_skill("lotusmove", 50);
  set_skill("lotusforce", 50);
  set_skill("jienan-zhi", 50);
  map_skill("force", "lotusforce");
  map_skill("dodge", "lotusmove");
  map_skill("unarmed", "jienan-zhi");
  setup();
  carry_object("/obj/cloth/sengpao")->wear();
  carry_object("/obj/cloth/seng-xie")->wear();
  add_money("coin", 50);
}

