// shami.c
inherit NPC;
void create()
{
  set_name("小道童", ({"xiao daotong","daotong",}));
  set("long","一个小道童，长得眉清目秀的，非常可爱。\n");
  set("gender", "男性");
  set("age", 12);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("class", "taoist");
  set("per", 25);
  set("str", 20);
  set("int", 20);
  set("con", 22);
  set("dex", 25);
  set("max_kee", 500);
  set("max_sen", 500);
  set("force", 150);
  set("max_force", 150);
  set("combat_exp", 2000);
  set_skill("force", 30);
  set_skill("dodge", 20);
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_temp("apply/attack", 15);
  set_temp("apply/defense", 15);
  set_temp("apply/damage", 5);
  setup();
  carry_object("/obj/cloth/dao-cloth.lpc")->wear();
  carry_object("/obj/cloth/dao-xie.lpc")->wear();
}

