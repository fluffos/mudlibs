inherit "/std/char/zhangmen";
string zm_apply();
void create()
{
  ::create();
  set("current_master","zhenyuan daxian");
  set("master_file","/d/qujing/wuzhuang/npc/daxian");
  set("family/family_name","五庄观");
  set("inquiry", ([
    "掌门大弟子" : (: zm_apply :),
    "掌门弟子" : (: zm_apply :),
    "大弟子" : (: zm_apply :),
    "掌门" : (: zm_apply :),
  ]) );
  setup();
}

string zm_apply()
{
  object me = this_object();
  object ob = this_player();
  if (me->query("family/family_name") != ob->query("family/family_name"))
  {
    return "我便是本派掌门弟子！\n";
  }

  if (ob->query("betrayer") || ob->query("betray/count"))
  {
     return "你曾叛师欺祖，言无信行不轨，岂能出任掌门弟子一职！\n";
  }

  if (me->query("current_player") == ob->query("id"))
  {
    return "你又糊涂了！\n";
  }

  ob->set_temp("menpai_zm_applied", 1);
  return "好！你有意出任掌门弟子一职？我们就切磋一下吧！\n";
}

