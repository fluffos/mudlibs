// 客店xiaoer.c
inherit KNOWER;
inherit F_VENDOR;
void greeting(object ob);
void create()
{
  set_name("店小二", ({ "xiao er", "xiao", "waiter" }) );
  set("gender", "男性" );
  set("age", 22);
  set("long","这位店小二正笑咪咪地忙著，还不时拿起挂在脖子上的抹布擦脸。\n");
  set("combat_exp", 100);
  set("attitude", "friendly");
  set("rank_info/respect", "小二哥");
  set("vendor_goods", ([
    "1" : "/d/obj/food/jitui",
    "2" : "/d/obj/food/guihua-jiudai",
    "3"	: "/d/obj/food/gourou",
    "4" : "/d/obj/misc/tu",
    "5" : "/d/obj/misc/jinpai",
    "6" : "/d/obj/misc/fire",
    "7" : "/d/obj/misc/wood",
    "8" : "/d/obj/misc/shier",
    "9" : "/d/obj/misc/yuer",
    "10" : "/d/obj/misc/diaogan",
    "11" : "/obj/misc/bushoujia",
    "12" : "/d/obj/misc/shoeshine",
    "13" : "/d/obj/misc/brush",
  ]));

  setup();
}

void init()
{
  object ob;
  ::init();
  if(playerp(ob = this_player()) && !is_fighting() )
    greeting(ob);
  add_action("do_vendor_list","list");
}

void greeting(object ob)
{
  string kick_dir ;

  if( !ob || environment(ob) != environment() ) return;

  kick_dir = environment(ob)->query("kick_dir");

  if (ob->query_condition("killer"))
  {
    command("say 杀人犯怎么可以进来？快给我出去，免得官府找我麻烦！\n");
    command("kick " + ob->query("id"));
    message("vision", ob->name() + "被小二一脚踢出门外。\n",environment(ob), ({ob}));

    if (stringp(kick_dir) && objectp(load_object(kick_dir)))
    {
      ob->move(kick_dir);
      message("vision", ob->name() + "被人从客栈里踢了出来，"
                        "栽倒在地上，磕掉两颗门牙。\n", environment(ob), ({ob}));
      return;
    }

    else
    {
      ob->move(VOID_OB);
      ob->unconcious();
      return;
    }
  }

  switch( random(2) )
  {
    case 0:
      say( "店小二笑咪咪地说道：这位" + RANK_D->query_respect(ob) + "，进来喝杯茶，歇歇腿吧。\n");
      break;
    case 1:
      say( "店小二用脖子上的毛巾抹了抹手，说道：这位" + RANK_D->query_respect(ob) + "，请进请进。\n");
      break;
  }

}

int accept_object(object who, object ob)
{
  object where ;
  int price;

  where = environment(who);
  if (!objectp(where))
    return 0;
  price = where->query("price");

  if (!price)
    price = 500 ;

  if (ob->query("money_id") && ob->value() >= price)
  {
    tell_object(who, "小二一哈腰，说道：多谢您老，客官请上楼歇息。\n");
    who->set_temp("rent_paid",1);
    return 1;
  }

  return 0;
}

