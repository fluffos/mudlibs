inherit NPC;
void says (object me);
void create()
{
  set_name("花旦", ({ "hua dan", "hua", "dan" }) );
  set("gender", "男性" );
  set("age", 32);
  set("long","一个在戏院唱戏的戏子。\n");
  set("shen_type", 1);
  set("combat_exp", 10000);
  set("str", 17);
  set("dex", 20);
  set("con", 17);
  set("int", 22);
  set("attitude", "peaceful");
  set_skill("dodge",20);
  set_skill("unarmed",20);
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 30);
}

void init()
{
  ::init();
  if (playerp(this_player()) && random(2))
    says(this_object());
}

void says (object me)
{
  string *msgs = ({
        	"$N在台上走了几步。\n",
        	"$N高声唱着什么。\n",
        	"$N在空中使了一个花步，一个跟头翻了过来。\n",
        	"$N口中念念有词。\n",
        	"$N一个回身走向台角。\n",
        	"$N鞠了个躬。\n",
        	"$N翻了个空翻。\n",
  });

  message_vision (element_of(msgs),me);
}

