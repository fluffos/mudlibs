#include <ansi.h>
inherit NPC;
void create()
{
  set_name("乞丐",({"qi gai", "qi", "gai"}));
  set("gender", "男性");
  set("age",25);
  set("combat_exp", 7000);
  set("shen_type", -1);
  set("attitude", "peaceful");
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);
  set("chat_chance", 2);
  set("chat_msg", ({
     CYN "乞丐有气无力的说道：给几文钱吧。\n" NOR,
     CYN "乞丐把手伸到了你的面前。\n" NOR,
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

