// Update by waiwai@2003/05/23
#include <ansi.h>
inherit NPC;
inherit F_NOCLONE;
int test_player (object me);
void create()
{
	set_name("生日宝宝", ({  "happy baby" }));
	set("title", HIR"生辰灵童"NOR);
	set("gender", "男性");
	set("age", 15);
	set("per", 40);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("no_blade", 1); //不怕冰刀
	set("no_poison", 1); //不怕用毒
	set("no_kill", 1); // 禁止杀
	set("limit_fight", 1); // 禁止fight
	set("inquiry", ([
        "gift":   (: test_player :),
        "生日礼物": (: test_player :),
        "礼物": (: test_player :),
      ]));
	setup();
	// Added by waiwai@2003/05/23
       set("startroom", "/d/wiz/system");
       check_clone();
       if (! this_object()) return;
}

int test_player (object me)
{
	object who = this_player();
/*
	if( !wizardp(who) && userp(who) ) {
	me->command_function("say 目前没有开放领取生日礼物。");
	return 1;
	}

*/
	if( who->query("age")<20 ) {
	me->command_function("say 生日礼物需要满20岁才能开始领取。");
	return 1;
	}

	if( who->query("combat_exp")<100000 ) {
	me->command_function("say 生日礼物需要满10万武学才能开始领取。");
	return 1;
	}

	if( who->query("daoxing")<100000 ) {
	me->command_function("say 生日礼物需要满100年道行才能开始领取。");
	return 1;
	}

	if ( !wizardp(who) && who->query("age") <= who->query("gift_age")) {
	me->command_function("shake");
	me->command_function("say 你已经拿过生日礼物了。");
	return 1;
	}

	me->command_function("nod");
	call_out ("give_gift",1,me,who);
	return 1;
}

// Update by waiwai@2003/05/23
void give_gift (object me, object who)
{
	int gift;

	object age   = who->query("age");
	who->set("gift_age",age);
	switch (random(7)) {
	case 0:
	{
	gift=10000+random(100000);
       who->add("balance",gift);
       message("shout",
	HIR"\n┋"HIY"生辰纪念"HIR"┋"NOR WHT"生日宝宝：祝"+log_id(who)+who->query("age")+
	"岁生日快乐，三界之神赐"+MONEY_D->money_num(gift)+"存款。\n"NOR,users());
        log_file("player/sr_log", sprintf("%s得到生日礼物%s 时间在：[%s]\n",
		log_id(who), MONEY_D->money_num(gift), log_time() ));
	break;
	}

	case 1:
	{
	gift=5000+random(50000);
       who->add("daoxing",gift);
	message("shout",
	HIR"\n┋"HIY"生辰纪念"HIR"┋"NOR WHT"生日宝宝：祝"+log_id(who)+who->query("age")+
	"岁生日快乐，三界之神赐"+XYJTIME_D->check_daoxing(gift)+"道行。\n"NOR,users());
        log_file("player/sr_log", sprintf("%s得到生日礼物%s道行 时间在：[%s]\n",
		log_id(who), XYJTIME_D->check_daoxing(gift), log_time() ));
	break;
	}

	case 2:
	{
	gift=1000+random(3000);
       who->add("potential",gift);
	message("shout",
	HIR"\n┋"HIY"生辰纪念"HIR"┋"NOR WHT"生日宝宝：祝"+log_id(who)+who->query("age")+
	"岁生日快乐，三界之神赐"+gift+"点潜能。\n"NOR,users());
        log_file("player/sr_log", sprintf("%s得到生日礼物%d潜能 时间在：[%s]\n",
		log_id(who),gift, log_time() ));
	break;
	}

	case 3:
	{
	gift=1000+random(3000);
       who->add("combat_exp",gift);
	message("shout",
	HIR"\n┋"HIY"生辰纪念"HIR"┋"NOR WHT"生日宝宝：祝"+log_id(who)+who->query("age")+
	"岁生日快乐，三界之神赐"+gift+"点武学。\n"NOR,users());
        log_file("player/sr_log", sprintf("%s得到生日礼物%d武学 时间在：[%s]\n",
		log_id(who),gift, log_time() ));
	break;
	}

	case 4:
	{
	gift=10+random(50);
       who->add("office_number",gift);
	message("shout",
	HIR"\n┋"HIY"生辰纪念"HIR"┋"NOR WHT"生日宝宝：祝"+log_id(who)+who->query("age")+
	"岁生日快乐，三界之神赐"+gift+"点官职。\n"NOR,users());
        log_file("player/sr_log", sprintf("%s得到生日礼物%d官职 时间在：[%s]\n",
		log_id(who),gift, log_time() ));
	break;
	}

	case 5:
	{
	gift=10+random(50);
       who->add("shengwang",gift);
	message("shout",
	HIR"\n┋"HIY"生辰纪念"HIR"┋"NOR WHT"生日宝宝：祝"+log_id(who)+who->query("age")+
	"岁生日快乐，三界之神赐"+gift+"点声望。\n"NOR,users());
        log_file("player/sr_log", sprintf("%s得到生日礼物%d声望 时间在：[%s]\n",
		log_id(who),gift, log_time() ));
	break;
	}

	case 6:
	{
       if( (int)who->query("MP_killM")>0) {
       who->add("MP_killM",-1);
	message("shout",
	HIR"\n┋"HIY"生辰纪念"HIR"┋"NOR WHT"生日宝宝：祝"+log_id(who)+who->query("age")+
	"岁生日快乐，三界之神赐减1点门派罪孽度。\n"NOR,users());
        log_file("player/sr_log", sprintf("%s得到生日礼物减1点门派罪孽度 时间在：[%s]\n",
		log_id(who), log_time() ));
	} else
       if( (int)who->query("Freason")<20) {
       who->add("Freason",1);
       who->add("reason",1);
	message("shout",
	HIR"\n┋"HIY"生辰纪念"HIR"┋"NOR WHT"生日宝宝：祝"+log_id(who)+who->query("age")+
	"岁生日快乐，三界之神赐1点善缘。\n"NOR,users());
        log_file("player/sr_log", sprintf("%s得到生日礼物1点善缘 时间在：[%s]\n",
		log_id(who), log_time() ));
	} else
       if( (int)who->query("PKS1")>0) {
       who->add("PKS1",-1);
	message("shout",
	HIR"\n┋"HIY"生辰纪念"HIR"┋"NOR WHT"生日宝宝：祝"+log_id(who)+who->query("age")+
	"岁生日快乐，三界之神赐减1点PK值。\n"NOR,users());
        log_file("player/sr_log", sprintf("%s得到生日礼物减1点PK值 时间在：[%s]\n",
		log_id(who), log_time() ));
	} else {
	gift=1000+random(5000);
       who->add("potential",gift);
	message("shout",
	HIR"\n┋"HIY"生辰纪念"HIR"┋"NOR WHT"生日宝宝：祝"+log_id(who)+who->query("age")+
	"岁生日快乐，三界之神赐"+gift+"点潜能。\n"NOR,users());
        log_file("player/sr_log", sprintf("%s得到生日礼物%d潜能 时间在：[%s]\n",
		log_id(who),gift, log_time() ));
	}

	break;
	}

	}

	who->start_busy(1+random(2));
}

