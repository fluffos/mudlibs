// Created by waiwai@2001/02/20
#include <armor.h>
#include <ansi.h>
inherit FINGER;
void create()
{
        set_name(HIB"魔法"HIW"水晶"HIY"戒指"NOR, ({ "ring" }));
        set("long", WHT"这是一枚没有人知道是谁送给红儿的神秘戒指，闪着神秘的流彩。\n"NOR);
        set("weight", 200);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "枚");
                set("value", 100000);
                set("material", "水晶");
                set("Fmaterial", "gem");
                set("armor_prop/armor", 2);
                set("armor/max_armor", 2);
                set("armor_prop/personality", 30);
                set("female_only", 1);
        }

        setup();
}

