#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create()
{
        set_name(CYN"农家的短衫"NOR, ({ "rub cloth", "rub", "cloth" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "一件穿在寻常农家人身上的短衫。\n");
		set("unit", "件");
		set("value", 1);
		set("npc_only", 1);
		set("material", "cloth");
		set("Fmaterial", "cloth");
		set("armor_prop/armor", 1);
		set("armor/max_armor", 1);
        }

	setup();
}

