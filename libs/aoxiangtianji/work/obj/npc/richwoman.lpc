inherit NPC;
void create()
{
  set_name("富家小姐", ({ "fujia xiaojie", "xiaojie", "girl" }) );
  set("gender", "女性" );
  set("age", 16 + random(8));
  set("long","一个白白胖胖的年轻人，一看就知道是娇生惯养惯了的。\n");
  set("shen_type", 1);
  set("combat_exp", 10000);
  set("per", 10 + random(30));
  set("str", 10);
  set("dex", 10);
  set("con", 10);
  set("int", 10);
  set("attitude", "peaceful");
  set_skill("dodge",20);
  set_skill("unarmed",20);
  setup();
  carry_object("/obj/cloth/jinduan")->wear();
  add_money("silver", 2);
}

