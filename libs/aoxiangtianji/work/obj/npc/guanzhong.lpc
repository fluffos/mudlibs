inherit NPC;
void create()
{
  set_name("观众", ({ "guan zhong", "guan", "zhong" }) );
  set("gender", "男性" );
  set("age", 32);
  set("long","一个在戏院里看戏的观众。\n");
  set("combat_exp", 10000);
  set("str", 17);
  set("dex", 20);
  set("con", 17);
  set("int", 22);
  set("attitude", "peaceful");
  set_skill("dodge",20);
  set_skill("unarmed",20);
  set("chat_chance", 3);
  set("chat_msg", ({
     "观众大声鼓掌称好。\n",
     "观众忍不住，大声喊起了好来！\n",
     "观众奇怪的看了你一眼，你懂戏吗？\n",
     "观众不耐烦的横了你一眼，不懂戏，不要吵吵！\n"
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 30);
}

