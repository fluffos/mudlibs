// shami.c
inherit NPC;
void create()
{
  set_name("小尼姑", ({"little nigu","nigu",}));
  set("long","他是本寺小尼姑。\n");
  set("gender", "女性");
  set("age", 12);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("class", "bonze");
  set("str", 16);
  set("int", 25);
  set("con", 22);
  set("dex", 25);
  set("per", 24);
  set("max_kee", 500);
  set("max_sen", 500);
  set("force", 150);
  set("max_force", 150);
  set("combat_exp", 2000);
  set_skill("force", 30);
  set_skill("dodge", 20);
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_temp("apply/attack", 15);
  set_temp("apply/defense", 15);
  set_temp("apply/damage", 5);
  setup();
  carry_object("/obj/cloth/ni-cloth.lpc")->wear();
  carry_object("/obj/cloth/ni-xie.lpc")->wear();
}

