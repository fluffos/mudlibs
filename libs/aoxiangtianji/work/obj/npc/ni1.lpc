// seng.c
inherit NPC;
void create()
{
  set_name("小尼姑", ({"xiao nigu", "nigu"}));
  set("long","一个天真调皮的小尼姑。\n");
  set("gender", "女性");
  set("attitude", "peace");
  set("class", "bonze");
  set("age", 12+random(6));
  set("str", 18);
  set("int", 28);
  set("con", 25);
  set("dex", 25);
  set("per", 15 + random(15));
  set("max_kee", 700);
  set("max_sen", 700);
  set("force", 300);
  set("max_force", 300);
  set("force_factor", 20);
  set("combat_exp", 10000);
  set("apply/attack",  30);
  set("apply/defense", 30);
  set_skill("force", 40);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_skill("parry", 40);
  setup();
  carry_object("/obj/cloth/ni-cloth")->wear();
  carry_object("/obj/cloth/ni-xie")->wear();
  add_money("coin", 20);
}

