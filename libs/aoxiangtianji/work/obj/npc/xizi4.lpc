inherit NPC;
void says (object me);
void create()
{
  set_name("青衣",({"qing yi"}));
  set("gender", "女性");
  set("long", "戏剧中的一个脚色!\n");
  set("age", 25);
  set("combat_exp", 7000);
  set("shen_type", 1);
  set("attitude", "peaceful");
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("silver", 20);
}

void init()
{
  ::init();
  if (playerp(this_player()) && random(2))
    says(this_object());
}

void says (object me)
{
  string *msgs = ({
        	"$N在台上走了几步。\n",
        	"$N高声唱着什么。\n",
        	"$N在空中使了一个花步，一个跟头翻了过来。\n",
        	"$N口中念念有词。\n",
        	"$N一个回身走向台角。\n",
        	"$N鞠了个躬。\n",
        	"$N翻了个空翻。\n",
  });

  message_vision (element_of(msgs),me);
}

