inherit NPC;
void create()
{
  set_name("诗人", ({ "shi ren", "shi", "ren" }) );
  set("gender", "男性" );
  set("age", 43);
  set("shen_type", 1);
  set("combat_exp", 10000);
  set("str", 20);
  set("dex", 20);
  set("con", 20);
  set("int", 20);
  set("attitude", "peaceful");

  set("chat_chance", 2);
  set("chat_msg", ({
      (:random_move:),
  }) );

  setup();
  carry_object("/obj/cloth/baipao")->wear();
  add_money("silver", 2);
}

