inherit NPC;
void create()
{
  set_name("穷书生", ({ "qiong shusheng", "shusheng" }) );
  set("gender", "男性" );
  set("age", 28);
  set("long","一个目光呆滞，嘴里念念有词的穷书生。\n");
  set("shen_type", 1);
  set("combat_exp", 10000);
  set("str", 10);
  set("dex", 10);
  set("con", 10);
  set("int", 30);
  set("attitude", "peaceful");
  set_skill("dodge",20);
  set_skill("unarmed",20);
  set("chat_chance", 5);
  set("chat_msg", ({
      (:random_move:),
  }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  add_money("coin", 200);
}

