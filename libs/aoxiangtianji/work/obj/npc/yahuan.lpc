//yahuan.c
inherit NPC;
void create()
{
  string cloth;

  set_name("丫环", ({"yahuan"}));
  set("long","一个小丫环，正在打扫房间．\n");
  set("gender", "女性");
  set("age", 16);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("combat_exp", 500);
  setup();
  cloth = sprintf("/obj/cloth/female%d-cloth",1+random(8));
  carry_object(cloth)->wear();
}

