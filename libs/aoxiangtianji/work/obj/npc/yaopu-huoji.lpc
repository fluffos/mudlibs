// huoji. 药铺伙计
inherit NPC;
inherit F_VENDOR;
void create()
{
  set_name("药铺伙计", ({ "yaopu huoji", "huoji" }));
  set("str", 20);
  set("gender", "男性");
  set("age", 18);
  set("long", "他是个药铺卖药的伙计。\n");
  set("combat_exp", 250);
  set("attitude", "friendly");
  set("vendor_goods", ([
    "1" : "/d/obj/drug/jinchuang",
    "2" : "/d/obj/drug/hunyuandan",
    "3" : "/d/obj/drug/dust",
    "4" : "/d/obj/drug/fashao",
    "5" : "/d/obj/drug/shanghan",
    "6" : "/d/obj/drug/xiaoshu",
    "7" : "/d/obj/drug/dongshang",
    "8" : "/d/obj/drug/zhike",
    "9" : "/d/obj/drug/xionghuang",
  ]));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
}

void init()
{
  add_action("do_vendor_list", "list");
}

