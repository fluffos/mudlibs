#include <ansi.h>
#include <armor.h>
inherit OTHERS;
void create()
{
	set_name(HIR "玛瑙" NOR, ({ "agate" }) );
	set_weight(30);
	if( clonep() )
		set_default_object(__FILE__);
        else {
	       set("long", HIR "一块晶莹剔透的暗红色玛瑙。\n" NOR);
              set("value", 50000);
		set("unit", "块");
//              set("can_be_enchased", 1);
		set("can_auction", 1);
              set("magic/type", "fire");
              set("magic/power", 100);
	}

        setup();
}

