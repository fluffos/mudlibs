// 十二生肖百岁铭牌之金鸡铭牌
#include <ansi.h>
#include <armor.h>
inherit OTHERS;
void create()
{
	set_name(YEL"金鸡铭牌"NOR, ({ "cock gift","ji", "gift", "cock"}));
	set_weight(3000);
	if ( clonep() )
	     set_default_object(__FILE__);
	else {
	set("long",
"
 "HIR"◥◣◣"NOR"
 "HIY"◢"HBWHT BLK".   "NOR"  "WHT"◢◣
  "HBWHT HIR"▉ "NOR HIW"◤◢█◣"NOR"
   "HBWHT BLK"▕,,▕"NOR HIW"▇◥
   ◥"HBWHT BLK"▔▔"NOR HIW"◤"HIY"
      ⊥"NOR"      [一块刻有酉鸡生肖图案的寿辰铭牌]
\n");
	set("unit", "块");
	set("value", 500);
	set("no_sell", 1);
	set("no_give", 1);
	set("no_drop", 1);
	set("no_putin", 1);
	set("no_stock", 1); //不能放到黑店
	set("deadfly", 1); //死亡时自动飞掉(destruct)标志
	set("need_sx", "酉鸡"); //不同属相不能装备标志
	set("material", "gold");
	set("Fmaterial", "gem");
	set("armor_prop/armor", 2);
	set("armor_prop/personality",1);
	set("armor_prop/dodge", 3);
	}

	setup();
}

