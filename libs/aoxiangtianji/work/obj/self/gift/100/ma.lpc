#include <ansi.h>
#include <armor.h>
inherit OTHERS;
void create()
{
	set_name(YEL"骏马铭牌"NOR, ({ "house gift","ma", "gift", "house"}));
	set_weight(3000);
	if ( clonep() )
	     set_default_object(__FILE__);
	else {
	set("long",
"    "BRED" "NOR WHT"◣  ◢"NOR BRED" "NOR"
    "HIW"◢"HIB"██"HIW"◣
    "NOR BLU BWHT"  .◥.  "NOR"
 "BRED WHT"▅"NOR WHT" ◥"NOR BWHT BLK"＿＿"NOR WHT"◤ "NOR BRED WHT"▅"NOR"
 "HIW"■ ◢"NOR BWHT BLK" oo "NOR HIW"◣ ■"NOR"
 "HIW"◥ ◥"NOR BWHT HIR"▃▃"NOR HIW"◤ ◤"NOR"     [一块刻有午马生肖图案的寿辰铭牌]
\n");
	set("unit", "块");
	set("value", 500);
	set("no_sell", 1);
	set("no_give", 1);
	set("no_drop", 1);
	set("no_putin", 1);
	set("no_stock", 1); //不能放到黑店
	set("deadfly", 1); //死亡时自动飞掉(destruct)标志
	set("need_sx", "午马"); //不同属相不能装备标志
	set("material", "gold");
	set("Fmaterial", "gem");
	set("armor_prop/armor", 2);
	set("armor_prop/personality",1);
	set("armor_prop/dodge", 3);
	}

	setup();
}

