void set_random_qj_neg_hs() {random_qj_neg_hs = random(sizeof(qj_neg_hs_id));}

void set_random_qj_rou4() {random_qj_rou4 = random(sizeof(qj_rou4_id));}

void set_random_qj_tz_guazi() {random_qj_tz_guazi = random(sizeof(qj_tz_guazi_id));}

void set_random_love_food() {random_love_food = random(sizeof(love_food_id));}

void set_random_zhuzi_food_dish() {random_zhuzi_food_dish = random(sizeof(zhuzi_food_dish_id));}

mixed get_a_food(object me)
{
  string *sth = ({});
  int lvl;
  string cname, ename;
  if (!objectp(me))
    return 0;
  set_random_qj_neg_hs();
  set_random_qj_rou4();
  set_random_qj_tz_guazi();
  set_random_love_food();
  set_random_zhuzi_food_dish();

  lvl = me->query("level");
  if (lvl <= 35)
  {
    sth = keys(quests_food1);
  }

  else if (lvl <= 45)
  {
    sth = keys(quests_food1);
    sth += keys(quests_food2);
  }
  else
  {
    sth = keys(quests_food1);
    sth += keys(quests_food2);
    sth += keys(quests_food3);
  }

  sth -= ({0});
  cname = element_of(sth);
  if (member_array(cname,keys(quests_food1)) != -1)
    ename = quests_food1[cname];
  else if (member_array(cname,keys(quests_food2)) != -1)
    ename = quests_food2[cname];
  else if (member_array(cname,keys(quests_food3)) != -1)
    ename = quests_food3[cname];
  else
    return 0;

  return ([
            "msg"   : "需要一种食品",
            "cname" : cname,
            "ename" : ename,
         ]);
}

