void set_random_a1_tz_sm_1() {random_a1_tz_sm_1 = random(sizeof(a1_tz_sm_id1));}

void set_random_a1_tz_sm_2() {random_a1_tz_sm_2 = random(sizeof(a1_tz_sm_id2));}

void set_random_a1_tz_hq() {random_a1_tz_hq = random(sizeof(a1_tz_hq_id));}

void set_random_a1_tz_huaq() {random_a1_tz_huaq = random(sizeof(a1_tz_huaq_id));}

void set_random_a1_tz_pf() {random_a1_tz_pf = random(sizeof(a1_tz_pf_id));}

void set_random_yz_cloth() {random_yz_cloth = random(sizeof(yz_cloth_id));}

void set_random_qj_a2_jd() {random_qj_a2_jd = random(sizeof(qj_a2_id));}

mixed get_a_armor(object me)
{
  string *sth = ({});
  int lvl;
  string cname, ename;
  if (!objectp(me))
    return 0;
  set_random_a1_tz_sm_1();
  set_random_a1_tz_sm_2();
  set_random_a1_tz_hq();
  set_random_a1_tz_huaq();
  set_random_a1_tz_pf();
  set_random_yz_cloth();
  set_random_qj_a2_jd();

  lvl = me->query("level");
  if (lvl <= 35)
  {
    sth = keys(quests_armor1);
  }

  else if (lvl <= 45)
  {
    sth = keys(quests_armor1);
    sth += keys(quests_armor2);
  }
  else
  {
    sth = keys(quests_armor1);
    sth += keys(quests_armor2);
    sth += keys(quests_armor3);
  }

  sth -= ({0});
  cname = element_of(sth);
  if (member_array(cname,keys(quests_armor1)) != -1)
    ename = quests_armor1[cname];
  else if (member_array(cname,keys(quests_armor2)) != -1)
    ename = quests_armor2[cname];
  else if (member_array(cname,keys(quests_armor3)) != -1)
    ename = quests_armor3[cname];
  else
    return 0;

  return ([
            "msg"   : "需要一件防具",
            "cname" : cname,
            "ename" : ename,
         ]);
}

