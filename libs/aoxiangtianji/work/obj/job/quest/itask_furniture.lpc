mixed get_a_furniture(object me)
{
  string *sth = ({});
  int lvl;
  string cname, ename;
  if (!objectp(me))
    return 0;
  set_random_ca_flower();
  set_random_ly_tc();

  set_random_sky_lingfu();
  set_random_longzhu();
  set_random_yueqi();

  set_random_f3_yz1();
  set_random_f3_yz2();
  set_random_f3_yz3();
  set_random_f3_zz1();
  set_random_f3_zz2();
  set_random_qj_tz_hp1();
  set_random_qj_tz_hp2();
  set_random_qj_tz_hualan();

  lvl = me->query("level");
  if (lvl <= 35)
  {
    sth = keys(quests_furniture1);
  }

  else if (lvl <= 45)
  {
    sth = keys(quests_furniture1);
    sth += keys(quests_furniture2);
  }
  else
  {
    sth = keys(quests_furniture1);
    sth += keys(quests_furniture2);
    sth += keys(quests_furniture3);
  }

  sth -= ({0});
  cname = element_of(sth);
  if (member_array(cname,keys(quests_furniture1)) != -1)
    ename = quests_furniture1[cname];
  else if (member_array(cname,keys(quests_furniture2)) != -1)
    ename = quests_furniture2[cname];
  else if (member_array(cname,keys(quests_furniture3)) != -1)
    ename = quests_furniture3[cname];
  else
    return 0;

  return ([
            "msg"   : "需要一件杂物",
            "cname" : cname,
            "ename" : ename,
         ]);
}

