mixed get_a_weapon(object me)
{
  string *sth = ({});
  int lvl;
  string cname, ename;
  if (!objectp(me))
    return 0;

  lvl = me->query("level");
  if (lvl <= 35)
  {
    sth = keys(quests_weapon1);
  }

  else if (lvl <= 45)
  {
    sth = keys(quests_weapon1);
    sth += keys(quests_weapon2);
  }
  else
  {
    sth = keys(quests_weapon1);
    sth += keys(quests_weapon2);
    sth += keys(quests_weapon3);
  }

  sth -= ({0});
  cname = element_of(sth);
  if (member_array(cname,keys(quests_weapon1)) != -1)
    ename = quests_weapon1[cname];
  else if (member_array(cname,keys(quests_weapon2)) != -1)
    ename = quests_weapon2[cname];
  else if (member_array(cname,keys(quests_weapon3)) != -1)
    ename = quests_weapon3[cname];
  else
    return 0;

  return ([
            "msg"   : "需要一件武器",
            "cname" : cname,
            "ename" : ename,
         ]);
}

