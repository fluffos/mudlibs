#include <ansi.h>
inherit F_CLEAN_UP;
void create()
{
  seteuid(getuid());
}

public int ask_RW(object me, object ob)
{
  mapping quest_rulai ;
  string msg;
  object quest_npc;
  int type , yg_lvl;
  int k_num,d_num,p_num,c_num,a_num;
  int t = time();
  string *q_t = ({
  	  "kill",
  	  "capture",
  	  "persuade",
  	  "defeat"});
  if (!playerp(me))
    return 0;
  if (!ob->is_rulai())
    return 1;
  if (me->query("level") < 35)
  {
    tell_object(me,"你现在的能力还不足以领取这个任务！\n");
    return 1;
  }

  if ((t - (int)me->query_temp("quest_xyj/last_rulai_time")) < 90)
  {
    tell_object(me,"你刚刚领过任务！\n");
    return 1;
  }

  if (playerp(ob) || !living(ob) || ob->is_fighting())
  {
    tell_object(me,"你现在不能从" + ob->name() + "领任务！\n");
    return 1;
  }

  if (me->query("obstacle/number") < 34)
  {
    tell_object(me,"你尚未修成正果，还不能从" + ob->name() + "领任务！\n");
    return 1;
  }

  if (me->query_temp("rulai_zuochan"))
  {
    message_vision(CYN"\n$N" CYN"说道：$n"
                   CYN"先到禅房参悟，以提高自身的修行，再来拿任务吧。\n"NOR,ob,me);
    return 1;
  }

  quest_rulai = me->query("quest_xyj/rulai");
  if (mapp(quest_rulai) && sizeof(quest_rulai) > 0)
  {
    switch (quest_rulai["type"])
    {
      case "kill" :
        switch (random(3))
        {
          case 0 :
            message_vision(CYN "$N" CYN "念声“我佛慈悲”，然后对$n"
                           CYN "说道：\n我不是让去杀了" NOR + HIC +
                           quest_rulai["npc_name"] + NOR +
                           CYN"吗？你还没有完成呢！\n" NOR, ob, me);
            break;
          case 1 :
            message_vision(CYN "$N" CYN "淡然一笑，对着$n" CYN"道："
                               "\n施主现在的任务是去杀了" NOR + HIC +
                               quest_rulai["npc_name"] + NOR +
                               CYN"。\n" NOR, ob, me);
            break;
          default :
            message_vision(CYN "$N" CYN "念了声“阿弥佗佛”，然后对$n"
                           CYN "说道：\n施主现在是要去除掉" NOR + HIC +
                               quest_rulai["npc_name"] + NOR +
                               CYN"，不让他继续为恶。\n" NOR, ob, me);
        }

        break;
      case "capture" :
        switch (random(3))
        {
          case 0 :
            message_vision(CYN "$N" CYN "轻声念道“我佛慈悲”，对$n"
                           CYN "摇头说道：\n我不是让去擒捉" NOR + HIC +
                           quest_rulai["npc_name"] + NOR +
                           CYN"吗？！\n" NOR, ob, me);
            break;
          case 1 :
            message_vision(CYN "$N" CYN "微微一笑，对$n" CYN"念道："
                               "\n施主现在有任务，是去擒拿" NOR + HIC +
                               quest_rulai["npc_name"] + NOR +
                               CYN"。\n" NOR, ob, me);
            break;
          default :
            message_vision(CYN "$N" CYN "掐了掐指头，然后对$n"
                               "说道：\n施主现在是要去擒拿" NOR + HIC +
                               quest_rulai["npc_name"] + NOR +
                               CYN"。\n" NOR, ob, me);
        }

        break;
      case "persuade" :
        switch (random(3))
        {
          case 0 :
            message_vision(CYN "$N" CYN "捻花一笑，对$n"
                           CYN "说道：\n我不是让去劝服" NOR + HIC +
                           quest_rulai["npc_name"] + NOR +
                           CYN"吗？！\n" NOR, ob, me);
            break;
          case 1 :
            message_vision(CYN "$N" CYN "念了声佛，对$n" CYN"沉吟道："
                               "\n施主现有的任务，是去劝服" NOR + HIC +
                               quest_rulai["npc_name"] + NOR +
                               CYN"。\n" NOR, ob, me);
            break;
          default :
            message_vision(CYN "$N" CYN "摇头叹了口气，对$n"
                               "说道：\n施主现要去劝服" NOR + HIC +
                               quest_rulai["npc_name"] + NOR +
                               CYN"。\n" NOR, ob, me);
        }

        break;
      default :
        switch (random(3))
        {
          case 0 :
            message_vision(CYN "$N" CYN "眉头微微一皱，对$n"
                           CYN "说：\n我让你去降服" NOR + HIC +
                           quest_rulai["npc_name"] + NOR +
                           CYN"，你还没有办到吧？\n" NOR, ob, me);
            break;
          case 1 :
            message_vision(CYN "$N" CYN "轻声念了念佛，对$n" CYN"道："
                               "\n施主现在是要去降服" NOR + HIC +
                               quest_rulai["npc_name"] + NOR +
                               CYN"。\n" NOR, ob, me);
            break;
          default :
            message_vision(CYN "$N" CYN "沉吟了一会，对$n"
                               "慢慢念道：\n施主需要降服" NOR + HIC +
                               quest_rulai["npc_name"] + NOR +
                               CYN"。\n" NOR, ob, me);
        }

        break;
    }

    return 1;
  }

  type = random(100);
  if (type < 10)
    yg_lvl = 1;
  else if (type < 40)
    yg_lvl = 2;
  else if (type < 80)
    yg_lvl = 3;
  else if (type < 90)
    yg_lvl = 4;
  else
    yg_lvl = 5;

  me->set("quest_xyj/rulai/level",yg_lvl);
  quest_npc = NPC_D->create_quest_npc(me,ob,"rulai",3);

  if (objectp(quest_npc))
  {
    if (!SYSQ_D->quest_reg(me,ob,quest_npc, "rulai"))
    {
      if (objectp(quest_npc))
        destruct(quest_npc);
      return 0;
    }

    me->set_temp("quest_xyj/last_rulai_time",t);
  }

  else
  {
    tell_object(me,"你没有成功的获得这次申请的任务！系统已经做好的了纪录，也可以就此向wiz反应！");
    log_file("quest_xyj/rulai",sprintf("%s(%s)在%s没有成功的获得任务！\n",
                                  me->name(1),
                                  me->query("id"),
                                  ctime(t)));
    return 1;
  }

  k_num = (int)me->query_temp("rulai/kill");
  c_num = (int)me->query_temp("rulai/capture");
  p_num = (int)me->query_temp("rulai/persuade");
  d_num = (int)me->query_temp("rulai/defeat");
  a_num = (k_num + c_num + p_num + d_num)/4;
  if (k_num > a_num)
    q_t -= ({"kill"});
  if (c_num > a_num)
    q_t -= ({"capture"});
  if (p_num > a_num)
    q_t -= ({"persuade"});
  if (d_num > a_num)
    q_t -= ({"defeat"});
  q_t -= ({0});
  if (sizeof(q_t) < 1)
    q_t = ({"kill","capture","persuade","defeat"});

  me->delete_temp("rulai_cancel");
  if (a_num)
  {
    msg = sprintf(WHT"本次上线，你已经完成："HIR"杀"WHT"%d次 "HIG"擒"WHT"%d次 "HIW"劝"WHT"%d次 "HIB"降"WHT"%d次\n"NOR,
                   k_num,c_num,p_num,d_num);
    tell_object(me,msg);
  }

  switch (element_of(q_t))
  {
    case "kill" :
      me->set("quest_xyj/rulai/type","kill");
      msg = sprintf(HIW"现有 %s " HIW"在 %s " HIW"出没，残杀了不少无辜。，"
                       "\n他恶贯满盈，你这就去把他" HIR"杀" HIW"了！\n"NOR,
                    me->query("quest_xyj/rulai/npc_name"),
                    me->query("quest_xyj/rulai/npc_place"));
      tell_object(me,msg);
      message_vision("$N" HIC"对$n" HIC"悄声说了些什么！\n",ob,me);
      break;
    case "capture" :
      me->set("quest_xyj/rulai/type","capture");
      msg = sprintf(HIW"在 %s " HIW"有个 %s " HIW"，尚未恶贯满盈，但极难点化。"
                       "\n你去把他" HIR"生擒" HIW"回来，我要亲自点化他！\n"NOR,
                    me->query("quest_xyj/rulai/npc_place"),
                    me->query("quest_xyj/rulai/npc_name"));
      tell_object(me,msg);
      message_vision("$N" HIC"在$n" HIC"耳边说了些什么！\n",ob,me);
      break;
    case "persuade" : // persuade
      me->set("quest_xyj/rulai/type","persuade");
      msg = sprintf(HIW"有个 %s " HIW"在 %s " HIW"出没，他本性不坏。"
                       "\n只可惜他未能冲破迷津，你这就去" HIR"点化" HIW"它吧。\n"NOR,
                    me->query("quest_xyj/rulai/npc_name"),
                    me->query("quest_xyj/rulai/npc_place"));
      tell_object(me,msg);
      message_vision("$N" HIC"对$n" HIC"悄声说了些什么！\n",ob,me);
      break;
    default : // defeat
      me->set("quest_xyj/rulai/type","defeat");
      msg = sprintf(HIW"听说在 %s " HIW"出了个 %s " HIW"，十分的好勇斗狠。"
                       "\n想他出山未久，仍然可以原谅。你只要" HIR"教训"
                    HIW"了他一番，他就不敢为恶了！\n"NOR,
                    me->query("quest_xyj/rulai/npc_place"),
                    me->query("quest_xyj/rulai/npc_name"));
      tell_object(me,msg);
      message_vision("$N" HIC"在$n" HIC"耳边说了些什么！\n",ob,me);
  }

  switch (yg_lvl)
  {
    case 1:
      message_vision("\n$N" HIY"说道：本次任务" HIR"简单" HIY"，$n"
                     HIY"如果不能顺利完成，就实在是有点说不过去了！\n",
                     ob,me);
      break;
    case 2 :
      message_vision("\n$N" HIY"说道：本次任务" HIR"略有难度" HIY"，希望$n"
                     HIY"能够顺利完成！\n",
                     ob,me);
      break;
    case 3 :
      message_vision("\n$N" HIY"说道：本次任务" HIR"难度偏上" HIY"，只能祝愿$n"
                     HIY"能够顺利完成！\n",
                     ob,me);
      break;
    case 4 :
      message_vision("\n$N" HIY"说道：本次任务" HIR"难度极大" HIY"，$n"
                     HIY"请考虑清楚！\n",
                     ob,me);
      break;
    default :
      message_vision("\n$N" HIY"沉吟良久才说道：本次任务" HIR"难度十分艰巨困难"
                     HIY"，$n" HIY"无需勉强！\n",
                     ob,me);
  }

  return 1;
}

public int ask_JC(object me, object ob)
{
  mapping quest_rulai ;
  object quest_npc;
  string msg;
  int jc_count,t = time();

  if (!playerp(me))
    return 0;

  if (playerp(ob) || !living(ob) || ob->is_fighting())
  {
    tell_object(me,"你现在无法和" + ob->name() + "交流！\n");
    return 1;
  }

  me->delete_temp("rulai/level");

  quest_rulai = me->query("quest_xyj/rulai");
  if (!mapp(quest_rulai) || sizeof(quest_rulai) < 1)
  {
    tell_object(me,"佛祖现在有任务给你吗？\n");
    return 1;
  }

  if (quest_rulai["npc_die"] >= 1 )
  {
    msg = "$N" HIW"叹息道，已经被杀了，阿弥陀佛！\n"NOR;
    message_vision(msg,ob);
    me->delete("quest_xyj/rulai");
    if (stringp(quest_rulai["npc_id"]))
      quest_npc = find_living(quest_rulai["npc_id"]);
    if (quest_npc && objectp(quest_npc) && !quest_npc->is_fighting() && living(quest_npc))
    {
      if (environment(quest_npc))
        message_vision(HIC "$N" HIC "看了看四周，急急忙忙的走掉了。\n" NOR, quest_npc);
      destruct(quest_npc);
    }

    if (SYSQ_D->quest_exist(me,"rulai"))
      SYSQ_D->delete_quest("rulai",me);
    return 1;
  }

  if (t - (int)me->query_temp("quest_xyj/last_rulai_time") < 120)
  {
    message_vision("$N对$n说道：时辰未到，不可放弃，阿弥陀佛。\n", ob, me);
    return 1;
  }

  message_vision("$N" HIY"对$n" HIY"说道，“佛祖，看来本次任务我无法完成了！”\n"NOR,me,ob);
  if (stringp(quest_rulai["npc_id"]))
    quest_npc = find_living(quest_rulai["npc_id"]);
  if (quest_npc && objectp(quest_npc) && !quest_npc->is_fighting() && living(quest_npc))
  {
    if (environment(quest_npc))
      message_vision(HIC "$N" HIC "看了看四周，急急忙忙的走掉了。\n" NOR, quest_npc);
    destruct(quest_npc);
    if (SYSQ_D->quest_exist(me,"rulai"))
      SYSQ_D->delete_quest("rulai",me);
  }

  msg = "$N" HIC"看着$n" HIC"叹了口气，说道：无妨，我亲自去收服他！\n"NOR;
  message_vision(msg,ob,me);
  me->delete("quest_xyj/rulai");
  me->set_temp("rulai_zuochan",1);
  me->set_temp("rulai_cancel",1);
  if (SYSQ_D->quest_exist(me,"rulai"))
    SYSQ_D->delete_quest("rulai",me);
  jc_count = (int)me->query("quest_info/rulai/jc_count");
  if (jc_count < 5)
  {
    jc_count++;
    tell_object(me,sprintf("你已经有%d次没有完成如来任务了！\n",jc_count));
  }

  else
  {
    jc_count = 0;
    me->delete("quest_info/rulai/count");
    me->add("daoxing",-300);
    me->add("combat_exp",-300);
    me->add("weiwang", -5);
    if ((int)me->query("weiwang") < 0)
      me->set("weiwang",0);
    me->add("score", -5);
    if ((int)me->query("score") < 0)
      me->set("score",0);
  }

  me->set("quest_info/rulai/jc_count",jc_count);
  me->save();
  return 1;
}