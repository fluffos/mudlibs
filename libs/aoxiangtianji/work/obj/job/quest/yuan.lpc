#include <ansi.h>
inherit F_CLEAN_UP;
void create()
{
  seteuid(getuid());
}

public int ask_RW(object me, object ob)
{
  mapping quest_yuan ;
  string npc_name, msg;
  object quest_npc;
  int t = time();
  if (!playerp(me))
    return 0;

  if (!ob->is_yuan())
  {
    write("什么？\n");
    return 1;
  }

  if (me->query("level") < 15)
  {
    tell_object(me,"你现在的能力还不足以领取我的任务！\n");
    return 1;
  }

  if ((t - (int)me->query_temp("quest_xyj/last_yuan_time")) < 80)
  {
    tell_object(me,"你刚刚领过任务！\n");
    return 1;
  }

  if (playerp(ob) || !living(ob) || ob->is_fighting())
  {
    tell_object(me,"现在" + ob->name() + "无法给你任务！\n");
    return 1;
  }

  quest_yuan = me->query("quest_xyj/yuan");
  if (mapp(quest_yuan) && sizeof(quest_yuan) > 0)
  {
    npc_name = quest_yuan["npc_name"];
    if (!stringp(npc_name))
      return 1;
    switch (random(7))
    {
      case 0 :
        msg = sprintf("$N" HIY"说道，不是让你去杀%s" HIY"吗？\n"NOR,npc_name);
        break;
      case 1 :
        msg = sprintf("$N" HIC"满脸的不满，你不是要去剿灭%s" HIC"吗？\n"NOR, npc_name);
        break;
      case 2 :
        msg = sprintf("$N" HIW"嘟哝道，%s" HIW"还在为非作歹呢！\n"NOR,npc_name);
        break;
      case 3 :
        msg = sprintf("$N" HIG"跳了起来，你就是拼了命，也要把%s" HIG"杀了！\n"NOR,npc_name);
        break;
      case 4 :
        msg = sprintf("$N" CYN"说道，难道%s" CYN"这么厉害吗？笨蛋！\n"NOR,npc_name);
        break;
      case 5 :
        msg = sprintf("SN" HIW"说道，%s" HIW"也不是什么三头六臂，快去把他给杀了！"NOR,npc_name);
        break;
      case 6 :
        msg = sprintf("$N" HIC"瞪大了双眼，%s" HIC"这个家伙这么难对付吗？！\n"NOR,npc_name);
      default :
        msg = sprintf("$N" HIY"不耐烦的吼道，你现在要做的，是去杀了%s" HIY"！而不是找我罗嗦！\n"NOR,npc_name);
        break;
    }

    message_vision(msg,ob);
    return 1;
  }

  quest_npc = NPC_D->create_quest_npc(me,ob,"yuan",1);
  if (objectp(quest_npc))
  {
    if (!SYSQ_D->quest_reg(me,ob,quest_npc, "yuan"))
    {
      me->delete("quest_xyj/yuan");
      if (objectp(quest_npc))
        destruct(quest_npc);
      return 1;
    }

    me->set_temp("quest_xyj/last_yuan_time",t);
    ob->command("good "+me->query("id"));
    switch (random(8))
    {
      case 0 :
        msg = sprintf(HIW"现有 %s " HIW"在 %s " HIW"为非作歹，你去灭了他！\n"NOR,
               me->query("quest_xyj/yuan/npc_name"),
               me->query("quest_xyj/yuan/npc_place"));
        break;
      case 1:
        msg = sprintf("%s" HIY"说道：“在%s" HIY"有个%s" HIY"骚扰百姓！”\n"NOR,
               ob->name(),
               me->query("quest_xyj/yuan/npc_place"),
               me->query("quest_xyj/yuan/npc_name"));
        break;
      case 2:
        msg = sprintf("%s" HIG"掐指一算，说道：“近来有个 %s" HIG" 在 %s " HIG"横行霸道，你去处理了吧！”\n"NOR,
               ob->name(),
               me->query("quest_xyj/yuan/npc_name"),
               me->query("quest_xyj/yuan/npc_place"));
        break;
      case 3 :
        msg = sprintf(HIR"你去解决了%s" HIR"，据说最近在%s" HIR"可以查到他的踪迹！\n",
               me->query("quest_xyj/yuan/npc_name"),
               me->query("quest_xyj/yuan/npc_place"));
        break;
      case 4 :
        msg = sprintf(HIB"你去降服了%s" HIB"，在%s" HIB"可以查找他的踪迹！\n"NOR,
               me->query("quest_xyj/yuan/npc_name"),
               me->query("quest_xyj/yuan/npc_place"));
        break;
      case 5 :
        msg = sprintf(HIC"那个叫 %s" HIC" 的，在 %s " HIC"屡次为难官府，办了他！\n"NOR,
               me->query("quest_xyj/yuan/npc_name"),
               me->query("quest_xyj/yuan/npc_place"));
        break;
      case 6 :
        msg = sprintf(HIG"最近在%s" HIG"出了一个%s" HIG"，罪行罄竹难书，快去！\n"NOR,
               me->query("quest_xyj/yuan/npc_place"),
               me->query("quest_xyj/yuan/npc_name"));
        break;
      default :
        msg = sprintf(HIM"在%s" HIM"，有个%s" HIM"屡屡对唐王不敬，肆意侮辱，提头来见！\n"NOR,
               me->query("quest_xyj/yuan/npc_place"),
               me->query("quest_xyj/yuan/npc_name"));
        break;
    }

    tell_object(me,msg);
    message_vision("$N" HIC"对$n" HIC"悄声说了些什么！\n",ob,me);
    return 1;
  }

  else
  {
    tell_object(me,"你没有成功的获得这次申请的任务！系统已经做好的了纪录，也可以就此向wiz反应！");
    log_file("quest_xyj/yuan",sprintf("%s(%s)在%s没有成功的获得任务！\n",
                                  me->name(1),
                                  me->query("id"),
                                  ctime(t)));
  }

  return 1;
}

public int ask_JC(object me, object ob)
{
  mapping quest_yuan ;
  object quest_npc;
  string msg;

  if (!playerp(me))
    return 0;

  if (playerp(ob) || !living(ob) || ob->is_fighting())
  {
    tell_object(me,"你现在无法和" + ob->name() + "交流！\n");
    return 0;
  }

  quest_yuan = me->query("quest_xyj/yuan");
  if (!mapp(quest_yuan))
  {
    tell_object(me,"你现在没有任务，取消什么？\n");
    return 0;
  }

  if (quest_yuan["npc_die"] >= 1 )
  {
    msg = "$N" HIW"说道，那家伙已经被干掉了。你不用再管了！\n"NOR;
    message_vision(msg,ob);
    me->delete("quest_xyj/yuan");
    if (SYSQ_D->quest_exist(me,"yuan"))
      SYSQ_D->delete_quest("yuan",me);
    return 1;
  }

  message_vision("$N" HIY"对$n" HIY"说道，“我没有办法完成这次任务了！”\n"NOR,me,ob);
  if (stringp(quest_yuan["npc_id"]))
    quest_npc = find_living(quest_yuan["npc_id"]);
  if (quest_npc && objectp(quest_npc) && !quest_npc->is_fighting() && living(quest_npc))
  {
    if (environment(quest_npc))
      message_vision(HIC "$N" HIC "看了看四周，急急忙忙的走掉了。\n" NOR, quest_npc);
    destruct(quest_npc);
    if (SYSQ_D->quest_exist(me,"yuan"))
      SYSQ_D->delete_quest("yuan",me);
  }

  switch (random(6))
  {
    case 0 :
      msg = "$N" HIC"不高兴的对着$n" HIC"嘟哝了几句，叹了口气！\n"NOR;
      break;
    case 1 :
      msg = "$N" HIY"无可奈何的朝$n" HIY"点点了头！\n"NOR;
      break;
    case 2 :
      msg = "$N" HIW"的一张脸瞬间变了颜色，张口结舌的看着$n" HIW"，别提有多难看了！\n"NOR;
      break;
    case 3 :
      msg = "$N" CYN"狠狠的在自己脑门上拍了几下，看来是对$n" CYN"很不高兴了！\n"NOR;
      break;
    case 4 :
      msg = "$N" HIW"狠狠的踹了$n" HIW"几脚！\n"NOR;
      break;
    case 5 :
      msg = "$N" HIR"大吃一惊，看着$n" HIR"好半天说不出话来！良久，一声轻叹！\n"NOR;
      break;
    default :
      msg = "$N" HIM"微微叹息了一声，对$n" HIM"说道，“下次注意了！”\n"NOR;
      break;
  }

  message_vision(msg,ob,me);
  me->add("combat_exp",-500);
  me->add("score",-3);
  if ((int)me->query("score") < 0)
    me->set("score",0);
  me->add("weiwang",-3);
  if ((int)me->query("weiwang") < 0)
    me->set("weiwang",0);
  me->delete("quest_xyj/yuan");
  if (SYSQ_D->quest_exist(me,"yuan"))
    SYSQ_D->delete_quest("yuan",me);
  return 1;
}

