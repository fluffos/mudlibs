#include <ansi.h>
inherit F_CLEAN_UP;
void create()
{
  seteuid(getuid());
}

public int ask_RW(object me, object ob)
{
  mapping quest_pantu ;
  string msg;
  object quest_npc, wenshu;
  int lv;
  int t = time();
  if (!playerp(me))
    return 0;
  if (!ob->is_guanfu_pantu())
    return 1;
  if (me->query("office_number") < 400)
  {
    tell_object(me,"你还是先去薛仁贵大人那里锻炼锻炼在来吧！\n");
    return 1;
  }

  if (me->query("level") < 30)
  {
    tell_object(me,"你现在的能力还不足以领取这个任务！\n");
    return 1;
  }

  if ((t - (int)me->query_temp("quest_xyj/last_pantu_time")) < 80)
  {
    tell_object(me,"你刚刚领过任务！\n");
    return 1;
  }

  if (playerp(ob) || !living(ob) || ob->is_fighting())
  {
    tell_object(me,"你现在不能从" + ob->name() + "领任务！\n");
    return 1;
  }

  quest_pantu = me->query("quest_xyj/pantu");
  if (mapp(quest_pantu) && sizeof(quest_pantu) > 0)
  {
    tell_object(me,"你上次领取的任务还没有完成！\n");
    return 1;
  }

  lv = (int)me->query("level");
  if (lv <= 30)
    quest_npc = NPC_D->create_quest_npc(me,ob,"pantu",1);
  else if (lv <= 40)
    quest_npc = NPC_D->create_quest_npc(me,ob,"pantu",2);
  else
    quest_npc = NPC_D->create_quest_npc(me,ob,"pantu",3);

  if (objectp(quest_npc))
  {
    if (!SYSQ_D->quest_reg(me,ob,quest_npc, "pantu"))
    {
      if (objectp(quest_npc))
        destruct(quest_npc);
      return 0;
    }

    me->set_temp("quest_xyj/last_pantu_time",t);
    wenshu = new("/job/quest/obj/wenshu.lpc");
    wenshu->set("owner",me->query("id"));
    wenshu->move(me,1);
    ob->command("good "+me->query("id"));
    msg = sprintf(HIW"现有 %s " HIW"逃亡到了 %s " HIW"，你去灭了他！\n"NOR,
               me->query("quest_xyj/pantu/npc_name"),
               me->query("quest_xyj/pantu/npc_place"));
    tell_object(me,msg);
    message_vision("$N" HIC"对$n" HIC"悄声说了些什么！\n",ob,me);
    return 1;
  }

  else
  {
    tell_object(me,"你没有成功的获得这次申请的任务！系统已经做好的了纪录，也可以就此向wiz反应！");
    log_file("quest_xyj/pantu",sprintf("%s(%s)在%s没有成功的获得任务！\n",
                                  me->name(1),
                                  me->query("id"),
                                  ctime(t)));
  }

  return 0;
}

public int ask_JC(object me, object ob)
{
  mapping quest_pantu ;
  object quest_npc, wenshu;
  string msg;

  if (!playerp(me))
    return 0;

  if (playerp(ob) || !living(ob) || ob->is_fighting())
  {
    tell_object(me,"你现在无法和" + ob->name() + "交流！\n");
    return 1;
  }

  me->delete_temp("pantu/next_lv");

  quest_pantu = me->query("quest_xyj/pantu");
  if (!mapp(quest_pantu) || sizeof(quest_pantu) < 1)
  {
    tell_object(me,"你现在没有任务，取消什么？\n");
    return 1;
  }

  wenshu = present("wenshu",me);

  if (quest_pantu["npc_die"] >= 1 )
  {
    msg = "$N" HIW"说道，那家伙已经被干掉了。你不用再管了！\n"NOR;
    message_vision(msg,ob);
    me->delete("quest_xyj/pantu");
    if (objectp(wenshu) && wenshu->query("owner") == me->query("id"))
      destruct(wenshu);
    if (stringp(quest_pantu["npc_id"]))
      quest_npc = find_living(quest_pantu["npc_id"]);
    if (quest_npc && objectp(quest_npc) && !quest_npc->is_fighting() && living(quest_npc))
    {
      if (environment(quest_npc))
        message_vision(HIC "$N" HIC "看了看四周，急急忙忙的走掉了。\n" NOR, quest_npc);
      destruct(quest_npc);
    }

    if (SYSQ_D->quest_exist(me,"pantu"))
      SYSQ_D->delete_quest("pantu",me);
    return 1;
  }

  message_vision("$N" HIY"对$n" HIY"说道，“看来没有办法完成本次任务了！”\n"NOR,me,ob);
  if (stringp(quest_pantu["npc_id"]))
    quest_npc = find_living(quest_pantu["npc_id"]);
  if (quest_npc && objectp(quest_npc) && !quest_npc->is_fighting() && living(quest_npc))
  {
    if (environment(quest_npc))
      message_vision(HIC "$N" HIC "看了看四周，急急忙忙的走掉了。\n" NOR, quest_npc);
    destruct(quest_npc);
    if (SYSQ_D->quest_exist(me,"pantu"))
      SYSQ_D->delete_quest("pantu",me);
  }

  msg = "$N" HIC"不高兴的对着$n" HIC"嘟哝了几句，叹了口气！\n"NOR;
  message_vision(msg,ob,me);
  if (!objectp(wenshu) || wenshu->query("owner") != me->query("id"))
  {
    me->add("combat_exp",-500);
    me->add("score",-5);
    if ((int)me->query("score") < 0)
      me->set("score",0);
    me->add("weiwang",-5);
    if ((int)me->query("weiwang") < 0)
      me->set("weiwang",0);
    me->add("office_number",-5);
    if ((int)me->query("office_number") < 0)
      me->set("office_number",0);
    me->delete("quest_xyj/pantu");
    if (objectp(wenshu))
      destruct(wenshu);
  }

  else
  {
    me->add("combat_exp",-300);
    me->add("score",-3);
    if ((int)me->query("score") < 0)
      me->set("score",0);
    me->add("weiwang",-3);
    if ((int)me->query("weiwang") < 0)
      me->set("weiwang",0);
    me->add("office_number",-2);
    if ((int)me->query("office_number") < 0)
      me->set("office_number",0);
    me->delete("quest_xyj/pantu");
    destruct(wenshu);
  }

  if (SYSQ_D->quest_exist(me,"pantu"))
    SYSQ_D->delete_quest("pantu",me);
  return 1;
}

