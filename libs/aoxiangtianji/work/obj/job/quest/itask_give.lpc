                         "贡献，你是否愿意(" HIY "answer Y|N" HIW
                         ")接受？\n\n" NOR);
// 记录可以领取任务奖励的NPC
    who->set_temp("quest_gift/npc", me->query("id"));
// 记录任务奖励物品的路径
    who->set_temp("quest_gift/obj", gift);
// 记录领取该物品所需的门牌贡献
    who->set_temp("quest_gift/gongxian", gongxian);

    log_file("quest_yk",sprintf("%s(%s)得到师门综合任务奖励：%s 于%s\n",
          who->name(1), getuid(who),base_name(ob),ctime(time())));
    return;
  }

  else
  {
    message_vision(CYN "$n" CYN "对$N" CYN "道：正好我这"
                       "里有…嗯…还是算了，相信你也用不到。"
                       "\n" NOR, who, me);
    log_file("quest_yk",sprintf("%s(%s)无法获得师门任务奖励因为门忠：%d 小于 %d\n",
          who->name(1),
          getuid(who),
          (int)who->query("family/family_faith"),
          gongxian));
  }

  destruct(ob);
}

int quest_give(object who, object me, object ob)
{
  mapping q;              // WHO的任务
  string msg;             // 掌门说的消息
  int t, s_t;             // 用来计算时间的变量
  int exp;                // 获得的经验
  int pot;                // 获得的潜能
  int mar;
  int daoxing;            // 获得的道行
  int gongxian;           // 获得的门派贡献
  int weiwang,score;
  int lvl;                // 人物的等级
  int quest_level;        // QUEST的等级
  int quest_count;        // 连续QUEST的数目
  int timeover;           // 标志：超时了？
  int added;              // 做任务的时候额外出现的敌人或敌人逃走
  mixed special = 0;      // 是否有特殊奖励
  if (me->query("family/family_name") != who->query("family/family_name"))
    return 0;
  if (who->query("quest_xyj/itask/master_id") != me->query("id"))
    return 0;

  q = who->query("quest_xyj/itask");
  quest_count = who->query("quest_info/itask/count") + 1;
  s_t = (int)who->query_temp("quest_xyj/last_itask_time");

  if (!mapp(q) || sizeof(q) < 1)
    return 0;

  if (q["type"] != "letter"
      && q["type"] != "kill"
      && q["type"] != "search")
    return 0;

  if (!objectp(ob))
    return 0;

  if(userp(ob))
    return 0;

  if (ob->is_item_make())
    return 0;

  if (who->is_busy())
    return 0;

  if (ob->is_letter())
  {
    if (ob->query("send_from") != me->query("id"))
      return 0;

    if (q["type"] != "letter" || ob->query("send_to") != q["id"])
    {
      message_vision(CYN "$N" CYN "深深的叹了一口气，没说什么？\n" NOR, me);
      destruct(ob);
      return 1;
    }

    message_vision(CYN "$N" CYN "瞪着$n" CYN "道：干什么？交给你"
                   "的活你不打算干了？\n" NOR, me, who);
    return 1;
  }

  if (ob->is_receipt())
  {
    if (ob->query("reply_to") != me->query("id"))
    {
       me->command("say 给我这玩艺干什么？");
       return 1;
    }

    if (!mapp(q) || q["type"] != "letter" || q["npc_id"] != ob->query("reply_by"))
    {
      me->command("nod");
      me->command("say 多谢了。");
      destruct(ob);
      return 1;
    }

    if (ob->query("receive_from") != who->query("id"))
    {
      me->command("nod");
      me->command("say 多谢了。");
      destruct(ob);
      return 1;
    }

    msg = CYN "$N" CYN "接过" + ob->name() + NOR + CYN"，仔细看了"
              "看，满意的说：很好。\n" NOR;
    t = time();
    if (t > s_t + 600)
    {
       msg += CYN "$N" CYN "叹了口气，又道：可惜，不是让你十分钟内做完吗？\n算"
             "了，将功补过，你先退下吧。\n" NOR;
       timeover = 1;
    }

    else
    {
      if (t - s_t < 120)
      {
         msg += CYN "$N" CYN "点点头道：你很不错，这么"
                    "快就完成了，好好干！\n" NOR;
         timeover = -1;
      }

      else
         msg += CYN "$N" CYN "点点头道：这次不错，辛苦了。\n" NOR;
      timeover = 0;
    }

    message_vision(msg, me, who);
    who->add("quest_info/itask/count",1);
    who->add("quest_info/itask/total_num",1);

    exp = 50 + random(80) + quest_count/2 + random(quest_count+1);
    daoxing = 50 + random(80)+ quest_count/2 + random(quest_count+1);
    gongxian = 1;
    destruct(ob);
  }

  else if (mapp(q) && q["type"] == "kill" && (ob->is_corpse() || ob->is_head()))
  {
    if (! stringp(ob->query("killed_by")))
    {
      message_vision(CYN "$N" CYN "捂着鼻子看了看" + ob->name()
                     + NOR + CYN "，道：什么臭烘烘的？快给我"
                     "拿走。\n" NOR, me);
      return 1;
    }

    if (ob->query("killed_by") != who->query("id"))
      return 0;
    if (ob->query("owner_id") != q["npc_id"])
    {
      message_vision(CYN"$N" CYN"生气的说道：这是我让你杀的吗？快拿走！\n"NOR,me);
      return 0;
    }

    else if (ob->query("victim_name"))
    {
      if (ob->query("victim_name") != q["npc_name"])
        return 0;
    }

    else
      return 0;

    msg = CYN "$N" CYN "接过" + ob->name() + NOR + CYN "，呵呵大笑"
              "，对$n" CYN "道：\n";
    if (who->is_good())
      msg += CYN "又除了一害，很好！";
    else if (who->is_bad())
      msg += CYN "好极了！什么大侠，不堪一击！";
    else
      msg += CYN "干得好，漂亮！";
    msg += "\n" NOR;
    t = time();
    if (who->query_temp("itask/escape_times"))
    {
       msg += CYN "$N" CYN "赞许道：这次没想到敌人这么强悍，实"
                  "在未曾料到，辛苦，辛苦！\n" NOR;
    }

    if (t - s_t> 900)
    {
       msg += CYN "$N" CYN "摇摇头，又道：可惜，不是让你十五分钟做完吗？\n算"
              "了，将功补过，你先退下吧。\n" NOR;
       timeover = 1;
    }

    else
    {
      if (t - s_t < 120)
      {
        msg += CYN "$N" CYN "点点头道：干得不错，这么"
               "快就完成了，好好干！\n" NOR ;
        timeover = -1;
      }

      else
        msg += CYN "$N" CYN "点点头道：这次不错，辛苦了。\n" NOR;
      timeover = 0;
    }

    message_vision(msg, me, who);
    destruct(ob);
    lvl = who->query("level");
    exp = 180 + random(180) + quest_count/2 + random(quest_count+1) + lvl*2;
    daoxing = 180 + random(180) + quest_count/2 + random(quest_count+1) + lvl*2;
    gongxian = 1;

    who->add("quest_info/itask/count",1);
    who->add("quest_info/itask/total_num",1);

    quest_level = who->query_temp("itask/next_lv");
    msg = "\n";
    switch (quest_level)
    {
      case 0:
        exp = exp / 2 + 1;
        daoxing = daoxing / 2 + 1;
        msg += CYN "$N" CYN "看着$n" CYN "接着说道：还行吧，下"
                   "次我给你个难点的任务。\n" NOR;
        break;
      case 1:
        msg += CYN "$N" CYN "对$n" CYN "又道：不错，看来我可以"
                   "托付些重任给你了。\n" NOR;
        break;
      case 2:
        exp += exp / 4;
        daoxing += daoxing / 4;
        msg += CYN "$N" CYN "对$n" CYN "笑道：真是不错，不愧是"
                   "我们" + who->query("family/family_name") + "的"
                   "矫矫者。\n" NOR;
        break;
      case 3:
        exp += exp / 2;
        daoxing += daoxing / 2;
        gongxian += 1;
        msg += CYN "$N" CYN "赞许道：非常不错，这次可给我们" +
                who->query("family/family_name") + "争脸了。\n"
                NOR;
        break;
    }

    message_vision(msg, me, who);
    quest_level += 1;

    if (quest_level > 3)
      quest_level = 1;
    who->set_temp("itask/next_lv",quest_level);

    added = (int)who->query_temp("itask/escape_times") ;
    who->delete_temp("itask/escape_times");
// 根据NPC的帮手和逃走的次数调整经验
    if (added)
    {
      exp += (random(exp) + 1) * added/2;
      daoxing += (random(daoxing)+1)*added/2;
      gongxian += 1;
    }

  }

  else if (mapp(q) && q["type"] == "search")
  {
    if (q["cname"] != ob->query("name"))
      return 0;

    if (q["ename"] != ob->query("id"))
    {
      message_vision ("$N对$n说道：我等着你的"+q["cname"]+
                    "，东西倒挺象，但不是同一个货；我要的是("+
                    q["ename"]+")，你给的是("+
                    ob->query("id")+")！\n",me,who);
      return 1;
    }

    msg = CYN "$N" CYN "接过" + ob->name() + NOR + CYN"，仔细看了"
              "看，满意的说：很好。\n" NOR;
    t = time();
    if (t > s_t + 3600)
    {
       msg += CYN "$N" CYN "叹了口气，又道：可惜，不是让你一个小时内做完吗？\n算"
             "了，将功补过，你先退下吧。\n" NOR;
       timeover = 1;
    }

    else
    {
      if (t - s_t < 120)
      {
         msg += CYN "$N" CYN "点点头道：你很不错，这么"
                    "快就完成了，好好干！\n" NOR;
         timeover = -1;
      }

      else
         msg += CYN "$N" CYN "点点头道：这次不错，辛苦了。\n" NOR;
      timeover = 0;
    }

    message_vision(msg, me, who);
    who->add("quest_info/itask/count",1);
    who->add("quest_info/itask/total_num",1);

    exp = 100 + random(80) + quest_count/2 + random(quest_count+1);
    daoxing = 100 + random(80)+ quest_count/2 + random(quest_count+1);
    gongxian = 1;
    destruct(ob);
  }

  else
  {
    write("你给我这个干什么？\n");
    return 1;
  }

// 根据任务完成的次数修正奖励
  if (quest_count >= 500)
  {
// 连续完成了超过500次的任务
    exp += 150 + random(quest_count+1);
    daoxing += 150 + random(quest_count+1);
    gongxian += 1 + random(5);
  }

  else if (quest_count >= 200)
  {
// 连续完成了超过200次的任务
    exp += 100 + random(quest_count + 1);
    daoxing += 100 + random(quest_count + 1);
    gongxian += 1 + random(3);
  }

  else if (quest_count >= 100)
  {
// 连续完成了超过100次的任务
    exp += 50 + random(quest_count + 1);
    daoxing += 50 + random(quest_count+1);
    gongxian += 1;
  }

  else if (quest_count >= 10)
  {
// 连续完成了超过10次的任务
    exp += 20+random(quest_count + 1);
    daoxing += 20 + random(quest_count + 1);
    pot += 5 + random(quest_count + 1);
  }

  msg = "\n";
  if (quest_count == 30)
  {
    msg += CYN "$N" CYN "哈哈大笑两声道：真有你的，连着三"
               "十次任务都完成的漂漂亮亮，很好，很好。\n" NOR;
    special = 1;
  }

  else  if (quest_count == 50)
  {
    msg += CYN "$N" CYN "哈哈大笑两声道：真有你的，连着五"
               "十次任务都完成的漂漂亮亮，很好，很好。\n" NOR;
    special = 2;
  }

  else if (quest_count == 100)
  {
    msg += CYN "$N" CYN "哈哈大笑两声道：真有你的，连着上"
               "百次任务都完成的漂漂亮亮，很好，很好。\n" NOR;
    special = 3;
  }

  else if (quest_count == 200)
  {
    msg += CYN "$N" CYN "大喜道：不错不错，真是不错，两百"
               "次任务干得很好。\n" NOR;
    special = 4;
  }

  else if (quest_count == 300)
  {
    msg += CYN "$N" CYN "大喜道：不错不错，连续三百个任务"
           "都丝毫不出差错，真是漂亮。\n" NOR;
    special = 5;
  }

  else if (quest_count == 400)
  {
     msg += CYN "$N" CYN "大喜道：真是不错，竟然连续四百个"
                "任务丝毫不出差错，干得好。\n" NOR;
     special = 6;
  }

  else if (quest_count == 500)
  {
    msg += CYN "$N" CYN "叹道：真是长江后浪推前浪，想不到"
               "你接连五百次任务都无一疏漏，真是不错！\n" NOR;
    special = 7;
  }

  else if (quest_count == 600)
  {
    msg += CYN "$N" CYN "叹道：真是长江后浪推前浪，想不到"
               "你接连六百次任务都无一疏漏，漂亮之极！\n" NOR;
    special = 8;
  }

  else if (quest_count == 700)
  {
    msg += CYN "$N" CYN "叹道：真是长江后浪推前浪，想不到"
               "你七百次任务竟无一疏漏，不易，不易！\n" NOR;
    special = 9;
  }

  else if (quest_count == 800)
  {
    msg += CYN "$N" CYN "叹道：真是长江后浪推前浪，想不到"
               "你接连八百次任务都无一疏漏，不易之极！\n" NOR;
    special = 10;
  }

  else if (quest_count == 900)
  {
    msg += CYN "$N" CYN "深深地叹道：想不到你接连九百次任"
               "务都无一疏漏，不易之极！不易之极！\n" NOR;
    special = 11;
  }

  else if (quest_count == 1000)
  {
     msg += CYN "$N" CYN "深深叹了口气，道：想不到你连着一"
                "千次任务无一失手，看来我们" +
                 me->query("family/family_name") +
                "真是后继有人啊！\n" NOR;
     special = 12;
  }

  else if (quest_count > 1001)
  {
    quest_count = 0;
  }

  else if ((quest_count % 10) == 0)
  {
    msg += CYN "$N" CYN "喜道：真是不赖，居然连着" +
           chinese_number(quest_count) +
          "次都没有失手，干的好！\n" NOR;
  }

  else
    msg += CYN "$N" CYN "满意的对$n点了点头！\n"NOR;
  message_vision(msg, me, who);
  who->delete("quest_xyj/itask");
// bouns
  if (timeover < 0)
  {
    exp += random(exp/2);
    daoxing += random(daoxing/2);
  }

  else if (timeover > 0)
  {
    exp /= 2;
    daoxing /= 2;
    gongxian /= 2;
  }

  else
  {
    if ((quest_count >= 100
         && random(300) < quest_count/40
         &&(time() - (int)who->query_temp("last_itask_gift")) > 60)
         || special)
      special_bonus(me, who, special);
  }

  pot = (random(exp) + random(daoxing))/3*2 ;
  mar = random(1 + pot/3*2);
  weiwang = 1 + random(quest_count/5 + 1);
  score = 2 + random(quest_count/5 + 1);

  GIFT_D->delay_bonus(who, ([ "exp"     : exp ,
                              "daoxing" : daoxing,
                              "pot"     : pot ,
                              "mar"     : mar,
                              "weiwang" : weiwang,
                              "score"   : score,
                              "gongxian": gongxian,
                              "prompt"  : "通过这次锻炼" ]),"itask");

  who->set_temp("last_itask_gift",time());
  if ((int)who->query("quest_info/itask/count") > 1000)
  {
    who->delete("quest_info/itask/count");
    who->delete("quest_info/itask/jc_count");
  }

  who->start_busy(2);
  who->delete("introduce");
// 随机停止发送任务，必须等完成一定数量的freequest才能继续。
  if (random(20) == 1 && quest_count >= 30)
    who->add("quest_xyj/freequest_need", 1 + random(3));
  return 1;
}