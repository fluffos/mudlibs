#include <ansi.h>
inherit F_CLEAN_UP;
void create()
{
  seteuid(getuid());
}

mixed query_quest(object me)
{
  if (!objectp(me))
    return 0;

  switch (random(4))
  {
    case 0 :
      return __DIR__"itask_armor"->get_a_armor(me);
      break;
    case 1 :
      return __DIR__"itask_food"->get_a_food(me);
      break;
    case 2 :
      return __DIR__"itask_furniture"->get_a_furniture(me);
      break;
    default :
      return __DIR__"itask_weapon"->get_a_weapon(me);
      break;
  }

  return 0;
}

