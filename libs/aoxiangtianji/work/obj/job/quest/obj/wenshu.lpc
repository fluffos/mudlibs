#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(WHT "铁捕文书" NOR, ({ "wenshu", "wen",}));
  set("weight", 100);
  if(clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "张");
    set("long", WHT"这是一张铁捕文书，上面有一个画像，底下有一行小字。\n" NOR);
    set("no_get", 1);
    set("no_give", 1);
    set("no_sell", 1);
    set("no_drop", 1);
  }

  setup();
}

void init()
{
  object ob = this_object();
  object env = environment(ob);
  if (objectp(env) && playerp(env))
  {
    add_action("do_guankan", ({"guankan","kan"}));
    if (ob->query("owner") && ob->query("owner") != env->query("id"))
    {
      remove_call_out("dest");
      call_out("dest",3);
    }

  }

}

int do_guankan(string arg)
{
  mapping quest_pantu;
  object me;
  object pantu;
  string place,name,npc_id;

  me = this_player();
  if(!arg || arg != "wenshu")
    return 0;
  if (this_object()->query("owner") != me->query("id"))
  {
    write("上面模模糊糊的，你看不出个所以然来！\n");
    return 1;
  }

  quest_pantu = me->query("quest_xyj/pantu");

  if (!mapp(quest_pantu) || sizeof(quest_pantu) <= 0)
  {
    write(WHT"\n这是一张官府悬赏捉拿叛徒的文书，上面却形象模糊地画着一个人的"NOR+
          WHT"\n头像，下面有一行小字，上面写的东西早就模糊不已。"NOR+
          HIY"\n而飞鸽传书太慢，要犯目前出没地点不定。\n"NOR+
          HIY"任务几乎渺茫，难度不小。\n\n"NOR);
    return 1;
  }

  place = quest_pantu["npc_place"];
  name = quest_pantu["npc_name"];
  npc_id = quest_pantu["npc_id"];

  if (!stringp(npc_id))
  {
    write(WHT"\n目标找不到了，速回官府奏请取消本次任务吧！\n"NOR);
    destruct(this_object());
    return 1;
  }

  pantu = find_living(npc_id);
  if (!objectp(pantu))
  {
    write(WHT"\n目标似乎已经消失了，看来你的这次任务失败了，速回官府奏请取消本次任务吧！\n"NOR);
    destruct(this_object());
    return 1;
  }

  place = pantu->query("place");
  if (stringp(place) && stringp(name))
  {
    write(WHT"\n这是一张开封知府悬赏捉拿妖神的文书，上面栩栩如生的画着一个人的"NOR+
          WHT"\n头像，下面有一行小字，上面写着："NOR+
          YEL"\n        「"NOR+HBRED+name+NOR+WHT"」        \n"NOR+
          HIY"\n据飞鸽传书，要犯目前出没于「"+place+"」附近。\n\n"NOR);
  }

  else
  {
    write(WHT"\n已经找不到你的目标了，看来你的这次官府任务失败了！\n"NOR);
    destruct(this_object());
  }

  return 1;
}

void dest()
{
  if (objectp(this_object()))
    destruct(this_object());
}

