#include <ansi.h>
inherit NPC;
string ask_job();
void create()
{
  set_name("秦琼", ({ "da yuanshuai", "qin", "marshal"}));
  set("title", "大唐兵马大元帅");
  set("gender", "男性");
  set("age", 60);
  set("per", 30);
  set("combat_exp", 15000000);
  set("daoxing", 15000000);
  set_skill("force", 800);
  set_skill("spells", 800);
  set_skill("dodge", 800);
  set_skill("unarmed", 800);
  set_skill("parry", 800);
  set_skill("mace", 800);
  set_skill("lengquan-force", 800);
  set_skill("baguazhou", 800);
  set_skill("yanxing-steps", 800);
  set_skill("changquan", 800);
  set_skill("wusi-mace", 800);

  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed", "changquan");
  map_skill("parry", "wusi-mace");
  map_skill("mace", "wusi-mace");

  set("gin", 30000);
  set("max_gin", 30000);
  set("kee", 30000);
  set("max_kee", 30000);
  set("sen", 30000);
  set("max_sen", 30000);
  set("force", 30000);
  set("max_force", 15000);
  set("mana", 30000);
  set("max_mana", 15000);
  set("force_factor", 750);
  set("inquiry", ([
   "守卫" : (: ask_job :),
  ]) );
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
     (: cast_spell, "zhanshen" :),
     (: perform_action, "mace.shashou" :),
  }) );

  set("job",0);
  setup();
  carry_object("/d/obj/armor/armor/jinjia")->wear();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/weapon/mace/silverjian")->wield();
}

string ask_job()
{
  int office;
  object qob, *obs;
  object who = this_player();

  office = (int)who->query("office_number");
  if (office < 500)
    return "你的官职不够，无法申请领兵出战！\n";
  obs = children("/obj/quest/teamjob/teamwar");
  if (!find_object(TEAMJOB_D) || !arrayp(obs) || sizeof(obs) < 1)
    return "当今四海生平，何用领兵出征？\n";
  qob = obs[0];

  if (!qob->is_create())
    return "现在是投军的时候吗？\n";

  if (TEAMJOB_D->is_teamjob_start(qob))
    return "已经有人领兵出征了！\n";

  return qob->join_job(who);
}

