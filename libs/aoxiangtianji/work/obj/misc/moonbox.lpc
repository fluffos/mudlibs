//翱翔天际
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIM"月光宝盒"NOR, ({ "moon box","box" }) );
  set_weight(100);
  set("long","这就是一个神秘月光宝盒了，据说(ji)可以穿梭时空。\n");
  set("value", 10000);
  set("material", "steel");
  set("no_sell", 1);
  set("no_get", 1);
  set("no_give", 1);
  set("no_steal", 1);
  set("no_put", 1);
  set("no_drop", 1);
  set("unit", "块");
  set("mark",0);
}

string long()
{
  if (query("mark"))
    return "这个月光宝盒被做了标记，ji之后可以返回到长安北广场！\n";
  return query("long");
}

void init()
{
  add_action("do_ji", "ji");
  add_action("do_biaoji",({"biaoji","mark"}));
}

int do_biaoji()
{
  string fam;
  object me = this_player();

  fam = me->query("family/family_name");
  if (!stringp(fam))
    return notify_fail("你无需做标记，你还没有门派，只能返回到长安的北广场！\n");
  if (query("mark"))
  {
    set("mark",0);
    message_vision("$N把月光宝盒上的记号清除了，下次ji，将返回到自己的门派！\n",me);
    return 1;
  }

  message_vision("$N在月光宝盒上做了个记号，下次ji，可以返回到长安北广场！\n",me);
  set("mark",1);
  return 1;
}

int do_ji(string arg)
{
  string fam,start,*kf;
  mapping alter_loc = ([
    "南海普陀山" : "/d/nanhai/gate",
    "东海龙宫"   : "/d/eastsea/gate",
    "将军府"     : "/d/jjf/gate",
    "阎罗地府"   : "/d/hell/gateway",
    "火云洞"     : "/d/qujing/kusong/guaishiya",
    "月宫"       : "/d/moon/ontop2",
    "方寸山三星洞" : "/d/lingtai/gate",
    "陷空山无底洞" : "/d/qujing/wudidong/dong1",
    "大雪山"      : "/d/xueshan/binggu",
    "五庄观"      : "/d/qujing/wuzhuang/gate",
  ]);
  int t = time();
  object me=this_player();
  if (!arg || (arg != "box" && arg != "moonbox"))
    return 0;

  if(me->is_fighting())
  {
    write("打架中你哪还有手去拿月光宝盒呢？\n");
    return 1;
  }

  if(me->is_busy())
  {
    write("你正忙着呢,哪有空去拿月光宝盒呢？\n");
    return 1;
  }

  if(environment(me)->is_safty() ||
     environment(me)->query("no_fight") ||
     environment(me)->query("no_magic") )
  {
    write("你想干什么？\n");
    return 1;
  }

  if (t - (int)me->query_temp("last_moonbox") < 3)
  {
    write("你刚刚才使用过,请稍候再次使用！\n");
    return 1;
  }

  if (me->query("level") > 40)
  {
    write("你的战斗等级已经很高了！用cast tuoqiao就可以了！\n");
    return 1;
  }

  kf = keys(alter_loc);
  fam = me->query("family/family_name");
  if (!stringp(fam) || member_array(fam,kf) == -1)
  {
    start = "/d/city/ncenter";
  }

  else
    start = alter_loc[fam];
  if (query("mark"))
    start = "/d/city/ncenter";

  message_vision(HIM"$N打开月光宝盒,喊道："
                        "「波若波罗密乾坤大法，走！」\n"
                        "月光宝盒现出五彩霞光..... "
                        "$N身影逐渐消失在霞光之中.\n"NOR,me);

  me->set_temp("last_moonbox",t);
  me->move(start);
  message_vision(HIM"$N的身影突然出现在一片霞光之中。\n"NOR, me);
  return 1;
}

void owner_is_killed()
{
  object me = environment();
  if (playerp(me))
    tell_object(me,HIM"只见一阵烟雾闪过...尸体上什么东西消失了。\n"NOR);
  destruct(this_object());
  return;
}

