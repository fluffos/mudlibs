// standard bed for players.
#include <ansi.h>
inherit ITEM;
void setup()
{
  set_max_encumbrance(300000);
  set_weight(100000);
  set("sleep_room",1);
  set("if_bed",1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_get",1);
  set("unit", "张");
  ::setup();
}

void set_exits()
{
  object env = environment();
  if (!objectp(env) || !env->is_player_home())
    return;
  set("out",base_name(env));
  set("exits",([
    "out" : base_name(env),
  ]));
}

void init()
{
  object me=this_player(1);
  if (!objectp(me) ||
      !environment(me) ||
      !playerp(me))
    return;
  set_exits();
  add_action("do_bed", "bed");
  add_action("go_out","out");
}

int do_bed()
{
  string out;
  object env, ridee;
  object obj = this_object();
  object me=this_player();

  if (!objectp(me) ||
      !playerp(me) ||
      !environment(me) ||
      !objectp(obj) ||
      !environment(obj))
    return 0;
  env = environment(me);
  if (!env->is_player_home() || env != environment(obj))
    return 0;
  ridee = me->query_temp("is_riding");
  if (objectp(ridee))
    return notify_fail("你还是先下了坐骑吧！\n");
  message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
  if(!me->move(obj))
  {
    write(HIY "床上已经挤不下了！\n" NOR);
  }

  else
  {
    message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
    out = obj->query("out");
    if (!stringp(out))
    {
      obj->set("out",base_name(env));
      obj->set("exits",([
        "out" : base_name(env),
      ]));
    }

  }

  return 1;
}

int go_out()
{
  object me=this_player();
  object out=this_object()->query("out");

  if (!objectp(me) || !stringp(out))
    return 0;
  message_vision("$N掀开纱帐，从床里钻了出去。\n",me);
  me->move(out,1);
  tell_room(out,me->query("name")+
      "掀开纱帐，从床里钻了出来。\n",({me}));
  return 1;
}