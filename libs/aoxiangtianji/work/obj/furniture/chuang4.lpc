#include <ansi.h>
inherit "/obj/furniture/bed.lpc";
void create()
{
  set_name(BLINK + HIY"鸳鸯"NOR HIM"金丝" HIW"床"NOR, ({ "jinsi chuang","bed"}) );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "这是一张宽大的鸳鸯床，床褥绣着戏水鸳鸯图案。\n");
    set("value", 250000);
    set("material", "wood");
  }

  setup();
}