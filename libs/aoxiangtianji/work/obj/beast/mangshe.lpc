inherit SNAKE;
#include <ansi.h>
void create()
{
  set_name(HIG "蟒蛇" NOR, ({ "mang she", "mang", "she" }));
  set("long", HIG "这是一只昂首直立，吐着长舌芯的大蟒蛇。\n" NOR);
  set("age", 6);
  set("str", 50);
  set("dex", 20);
  set("con", 50);
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 5000);
  set("max_force", 3000);
  set("mana", 5000);
  set("max_mana", 3000);
  set("combat_exp", 500000);
  set("combat_exp", 500000);
  set("power", 50);
  set("item1", "/obj/quarry/item/sherou");
  set("item2", "/obj/quarry/item/shepi");
  set_temp("apply/force", 200);
  set_temp("apply/parry", 200);
  set_temp("apply/dodge", 200);
  set_temp("apply/attack", 180);
  set_temp("apply/defense", 180);
  set_temp("apply/unarmed_damage", 220);
  set_temp("apply/armor", 220);
  setup();
}