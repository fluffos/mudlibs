#include <ansi.h>
inherit SNAKE;
void create()
{
  set_name(HIG "毒蛇" NOR, ({ "du she", "du", "she" }));
  set("long", HIG "一支昂首吐信的毒蛇正虎视眈眈地盯著你。\n" NOR);
  set("age", 1);
  set("str", 15);
  set("dex", 50);
  set("max_kee", 500);
  set("max_sen", 500);
  set("combat_exp", 120000);
  set("snake_poison", ([
    "level"   : 80,
    "remain"  : 20,
    "maximum" : 20,
    "perhit"  : 10,
    "supply"  : 1,
  ]));
  set("power", 12);
  set("item1", "/obj/quarry/item/sherou");
  set("item2", "/obj/herb/shedan");
  set_temp("apply/dodge", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/unarmed_damage", 50);
  setup();
}

