#include <ansi.h>
inherit SNAKE;
#define NAME    HIW "玄冰" HIR "赤" HIW "蟒" NOR
void create()
{
  set_name(NAME, ({ "xuanbing chimang", "xuan", "bing", "xuanbing",
                    "chimang", "mang", "snake" }));
  set("long", HIW @LONG
这是一只雪山怪蛇，只见它通体雪白，眼如烈
炎。看来这个冰洞是它的巢穴。
LONG NOR);
  set("age", 15);
  set("str", 50);
  set("dex", 50);
  set("con", 100);
  set("max_kee", 20000);
  set("max_sen", 20000);
  set("force", 12000);
  set("max_force", 6000);
  set("mana", 12000);
  set("max_mana", 6000);
  set("combat_exp", 5000000);
  set("daoxing", 5000000);
  set("no_ji", 1);

  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_skill("parry", 500);
  set_skill("force", 500);
  set("snake_poison", ([
        "level"  : 300,
        "perhit" : 200,
        "remain" : 300,
        "maximum": 300,
        "supply" : 30,
  ]));
  set("power", 500);
  set("item1", "/obj/quarry/item/sherou");
  set("item2", "/obj/herb/shedan");
  set("item3", "/d/obj/combine/pill/blood");
  set_temp("apply/attack",  500);
  set_temp("apply/unarmed_damage", 500);
  set_temp("apply/defense", 500);
  set_temp("apply/armor", 500);
  setup();
}

void die(object killer)
{
  object dob;

  if (! objectp(dob = killer))
    dob = query_last_damage_from();
  if (objectp(dob) && dob->query_temp("owner"))
    dob = dob->query_temp("owner");
  if (dob)
    dob->add_temp("kill_xuanmang",1);
  ::die(dob);
}

