#include <ansi.h>
inherit SNAKE;
void create()
{
  set_name(HIR "眼镜蛇" NOR, ({ "yanjing she", "yanjing", "she" }));
  set("long", HIR "这是一条五彩斑斓的眼镜蛇，毒性猛烈之极。\n" NOR);
  set("age", 3);
  set("str", 35);
  set("dex", 50);
  set("max_kee", 1800);
  set("max_sen", 1800);
  set("combat_exp", 500000);
  set("snake_poison", ([
    "level"  : 150,
    "perhit" : 50,
    "remain" : 80,
    "maximum": 80,
    "supply" : 3,
  ]));
  set("power", 50);
  set("item1", "/obj/quarry/item/sherou");
  set("item2", "/obj/herb/shedan");
  set_temp("apply/parry", 120);
  set_temp("apply/dodge", 120);
  set_temp("apply/attack", 120);
  set_temp("apply/defense", 120);
  set_temp("apply/unarmed_damage", 120);
  set_temp("apply/armor", 120);
  setup();
}