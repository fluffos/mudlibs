#include <ansi.h>
inherit SNAKE;
#define NAME    HIW "白冰怪蛇" NOR
void create()
{
  set_name(NAME, ({ "baibing snake", "snake" }));
  set("long", HIW @LONG

这是一只白冰怪蛇，只见它通体冰白，眼如黑
豆。看来你无意中惊扰了它的美梦了。
LONG NOR);
  set("age", 12);
  set("str", 30);
  set("dex", 30);
  set("spi", 30);
  set("con", 80);
  set("max_kee", 6000);
  set("max_sen", 6000);
  set("force", 6000);
  set("max_force", 3000);
  set("mana", 6000);
  set("max_mana", 3000);
  set("combat_exp", 1500000);
  set("daoxing", 1500000);

  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("force", 200);
  set("snake_poison", ([
        "level"  : 150,
        "perhit" : 100,
        "remain" : 150,
        "maximum": 150,
        "supply" : 15,
  ]));
  set("power", 200);
  set("no_ji",1);
  set("item1", "/obj/quarry/item/sherou");
  set("item2", "/obj/herb/shedan");
  set_temp("apply/attack",  200);
  set_temp("apply/unarmed_damage", 200);
  set_temp("apply/defense", 200);
  set_temp("apply/armor", 200);
  setup();
}

void die(object killer)
{
  object dob;

  if (! objectp(dob = killer))
    dob = query_last_damage_from();
  if (objectp(dob) && dob->query_temp("owner"))
    dob = dob->query_temp("owner");
  if (dob)
    dob->add_temp("kill_bingshe",1);
  ::die(dob);
}

