#include <armor.h>
inherit CLOTH;
string *prefixs = ({
  "布",
  "粗布",
  "棉布",
  "粗棉布",
  "丝布",
});
void create()
{
  set_name(element_of(prefixs) + "衣", ({ "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("material", "cloth");
  }

  init_cloth(10);
  setup();
}

