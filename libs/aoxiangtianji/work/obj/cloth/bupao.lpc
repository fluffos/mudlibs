#include <ansi.h>
#include <armor.h>
inherit CLOTH;
string *prefixs = ({
  HIR"红"NOR,
  HIM"橙"NOR,
  HIY"黄"NOR,
  HIG"绿"NOR,
  HIB"兰"NOR,
  HIC"青"NOR,
  HIW"白"NOR,
});
void create()
{
  set_name(element_of(prefixs) + "布袍", ({ "bu pao", "bupao", "pao" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("material", "cloth");
    set("value", 100);
  }

  init_cloth(12);
  setup();
}

