// dao-xie.c
#include <ansi.h>
#include <armor.h>
inherit BOOTS;
void create()
{
  set_name( HIY "道鞋" NOR, ({ "dao xie", "xie" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "双");
    set("long", "一双青布麻鞋。\n");
    set("value", 0);
    set("material", "cloth");
    set("armor_prop/armor", 5);
    set("armor/max_armor",5);
    set("armor_prop/dodge", 2);
  }

  init_boots(5);
  setup();
}

