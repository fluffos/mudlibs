// dao-cloth.c 道袍
#include <armor.h>
#include <ansi.h>
inherit CLOTH;
string *prefixs = ({
  HIR"红色"NOR,
  HIM"橙色"NOR,
  HIY"黄色"NOR,
  HIG"绿色"NOR,
  HIB"兰色"NOR,
  HIC"青色"NOR,
  HIW"白色"NOR,
});
void create()
{
  set_name(element_of(prefixs) + "道袍", ({"dao pao", "cloth", "pao"}) );
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("value", 0);
    set("long", "一件普普通通的道袍。\n");
    set("material", "cloth");
  }

  init_cloth(15);
  setup();
}

