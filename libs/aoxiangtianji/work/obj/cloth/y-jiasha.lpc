#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create()
{
  set_name("黄色袈裟",({"jia sha","jiasha","cloth"}));
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("material", "cloth");
    set("value",100);
  }

  init_cloth(22);
  setup();
}