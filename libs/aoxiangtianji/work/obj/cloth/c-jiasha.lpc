// c_jiasha.c 袈裟
#include <armor.h>
#include <ansi.h>
inherit CLOTH;
string *prefixs = ({
  HIR"红色"NOR,
  HIM"橙色"NOR,
  HIY"黄色"NOR,
  HIG"绿色"NOR,
  HIB"兰色"NOR,
  HIC"青色"NOR,
  HIW"白色"NOR,
});
void create()
{
  set_name( element_of(prefixs) + "袈裟",({"jia sha" ,"jiasha","cloth"}));
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("material", "cloth");
    set("value",500);
  }

  init_cloth(18);
  setup();
}

