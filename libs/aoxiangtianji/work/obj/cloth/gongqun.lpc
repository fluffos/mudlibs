#include <armor.h>
inherit SKIRTS;
void create()
{
  set_name("宫裙", ({ "gong qun", "skirt" }) );
  set_weight(2700);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("long", "一袭长长宫裙．\n");
    set("unit", "袭");
    set("value", 1000);
    set("material", "cloth");
    set("armor_prop/dodge", 10);
  }

  init_skirts(10);
  setup();
}

