#include <ansi.h>
inherit ITEM;
void create()
{
  seteuid(getuid());
  set_name(WHT"翱翔天际在线人数分时统计板"NOR, ({ "ban"}) );
  set("no_get", 1);
  setup();
}

string long()
{
        return HIY"▓▓▓▓▓▓▓翱翔天际▓▓▓▓▓▓
▓"HIC" １．今日分时在线人数板(ban1)"HIY" ▓
▓"HIC" ２．平均分时在线人数板(ban2)"HIY" ▓
▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓\n\n"NOR;
}

void init()
{
  add_action("do_look", "look");
}

int do_look(string arg)
{
  int t = time();

  if (t - this_player()->query_temp("last_look_ban") < 5)
    return 0;

  this_player()->set_temp("last_look_ban",t);
  if( arg == "ban1" )
  {
    write(ONLINE_D->query_day_temp());
    return 1;
  }

  else if( arg == "ban2" )
  {
    write(ONLINE_D->query_norm_temp());
    return 1;
  }

  else
    return 0;
}

