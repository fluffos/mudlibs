#include <ansi.h>
inherit NPC;
int give_tear(object ob);
void create()
{
  set_name("路人", ({ "thunder man", "man", "thunder"}) );
  set("gender", "男性");
  set("age", 28);
  set("per", 10+random(5));
  set("title", "被闪电击中的");
  set("long","一位不幸被闪电击中了的路人。\n");
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("chat_chance", 10);
  set("chat_msg", ({
     "被闪电击中的路人晕晕忽忽地晃了下脑袋。\n",
     "被闪电击中的路人有点不知东南西北了。\n",
     (: random_move :)
  }) );
  set("inquiry", ([
     "闪电" : (: give_tear :),
     "shandian" : (: give_tear :),
  ]) );
  set("arrive_msg","摇摇晃晃地走了过来。。。");
  set("leave_msg","摇摇晃晃地走开了。。。");
  setup();
  carry_object(__DIR__"obj/duangua")->wear();
  carry_object(__DIR__"obj/duanku")->wear();
}

int give_tear(object ob)
{
  object tear;
  object me=this_object();
  ob=this_player();
  tear=new("/obj/nature/obj/tear-rain");
  if(present("tear rain", ob) )
  {
    command("heng "+ob->query("id") );
    message_vision(CYN"$N对$n说道：上次取笑我还不够吗？真乃落井下石之人。\n"NOR, me,ob);
    command("slap "+ob->query("id") );
    message_vision(WHT"\n$N头也不回地跑了。。。\n"NOR, me);
    destruct(me);
    return 1;
  }

  else
    message_vision(CYN"$N听到此言不禁伤心的哭了起来。。。\n", me,ob);
  message_vision("泪水从$N被闪电击过的焦黑的脸上流了下来。。。\n", me,ob);
  tear=new("/obj/nature/obj/tear-rain");
  if (objectp(tear) && tear->move(ob) )
    message_vision(CYN"\n$N顺势一伸手竟然接住了一滴"+tear->name()+CYN"。\n"NOR, ob);
  else if (objectp(tear))
  {
    message_vision(CYN"\n$N一伸手想去接住那滴"+tear->name()+CYN"，可惜掉到了地上不见了。\n"NOR, ob);
    destruct(tear);
  }
  command("sigh");
  message_vision(WHT"\n$N踉跄地跑开不见了。。。\n"NOR, me);
  destruct(me);
  return 1;
}

void die()
{
  object me = this_object();
  command("wuwu");
  command("say 今天真是倒霉透了啊！\n");
  command("remove pants");
  command("drop pants");
  command("remove cloth");
  command("drop cloth");
  message_vision(WHT"\n$N踉跄地跑开不见了。。。\n"NOR, me);
  destruct(me);
}

void unconcious() { die(); }

	