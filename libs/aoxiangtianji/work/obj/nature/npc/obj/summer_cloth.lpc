#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create()
{
  set_name(WHT"短袖凉衫"NOR, ({ "summer cloth", "summer", "cloth" }) );
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一件一般穿在夏季的短袖凉衫，薄布制的上面勾着丝边。\n");
    set("unit", "件");
    set("value", 300);
    set("npc_only", 1);
    set("material", "cloth");
  }

  init_cloth(5);
  set("is_monitored",1);
  setup();
}

