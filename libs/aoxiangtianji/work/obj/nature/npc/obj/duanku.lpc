#include <ansi.h>
#include <armor.h>
inherit PANTS;
void create()
{
  set_name(CYN"褴褛的短裤"NOR, ({ "poor pants", "pants", "poor" }) );
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一件穿在路人身上的短裤，可惜被闪电击中后变的褴褛不堪。\n");
    set("unit", "条");
    set("value", 10);
    set("material", "cloth");
  }

  init_pants(5);
  setup();
}