inherit ITEM;
int is_nature_gift()
{
  return 1;
}

void create()
{
  set_name("自然礼物", ({ "nature gift", "gift" }) );
  set_weight( 100 );
  set("value", 100);
  set("npc_no_get",1);
  set("drop_des", 1); // drop时消失标志
  set("material", "ice");//冰水性物件标志
  set_temp("drop_msg", this_object()->query("name")
          + " 随风而逝，消失在空气中不见了～～～\n");
  setup();
}

void init()
{
  object env=environment();
  if(!clonep())
    return;
  if(!objectp(env))
  {
    call_out("self_destroy",1);
    return;
  }

  if (userp(env))
  {
    if (!query("owner"))
      set("owner",env->query("id"));
    else if (query("owner") != env->query("id"))
    {
      call_out("self_destroy",1);
      return;
    }

    add_action("do_melt",({"melt","ronghua"}));
  }

}

void self_destroy()
{
  object env=environment();
  if(env)
  {
    if(env->is_character())
    { // npc or player
      tell_object(env,"只见"+this_object()->query("name")
        +"慢慢淡化，渐渐的不见了踪影。\n");
    }

  }

  destruct(this_object());
}

int do_melt(string arg)
{
  string id_str, sx;
  object me = this_object();
  object who = this_player();

  if (!userp(who) || !objectp(me) || !me->is_nature_gift())
    return 0;

  if (!present(me,who))
    return 0;

  if (!arg || !me->id(arg))
  {
    write("你要融化什么东西？\n");
    return 1;
  }

  if (me->query("owner") != who->query("id"))
  {
    write("这好象不是上天赐给你的！\n");
    destruct(me);
    return 1;
  }

  sx = who->query("nature_gift/shuxing");
  if (stringp(sx) && me->query("shuxing") != sx)
  {
    write(sprintf("你有了 %s 属性的自然礼物，无法再融合具有 %s 属性的%s ！\n",
          sx,
          me->query("shuxing"),
          me->name()));
    return 1;
  }

  id_str = me->query("id");
  id_str = replace_string(id_str, " ", "_");
  message_vision("$N双手捧住$n，双眼微合，嘴中念念有词，$n慢慢的融化了！\n",who,me);
  who->set("nature_gift/combine/" + id_str,1);
  who->set("nature_gift/shuxing",me->query("shuxing"));
  destruct(me);
  return 1;
}

