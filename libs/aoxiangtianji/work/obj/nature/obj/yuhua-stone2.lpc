#include <ansi.h>
inherit ITEM;
void create()
{
  string *colors = ({ HIW, HIR, HIY, HIC, HIM, HIG, HIB });

  set_name(element_of(colors) + "雨" + NOR
         + element_of(colors) + "花" + NOR
         + element_of(colors) + "石" + NOR, ({ "yuhua stone", "stone" }) );
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一粒色彩斑斓的小石子，每一粒都似乎在讲述着一个故事。\n");
    set("unit", "粒");
    set("value", 5000);
  }

}

