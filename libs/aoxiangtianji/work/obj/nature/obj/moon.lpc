#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(BLINK HIW "月华" NOR, ({ "moon", "yuehua" }) );
  set_weight(30);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", HIW "天空的月亮倾泻而出的月华。\n" NOR);
    set("value", 10000);
    set("unit", "缕");
    set("des", 1);
  }

  set_temp("drop_msg", "飘落不见了！\n");
  setup();
}