// Created by waiwai@2001/03/22
/*
桂花(sweet osmanthus) 学名(Osmanthus fragrans)
又称“木犀”，“丹桂”。双子叶植物，木犀科。常绿乔木，高达12米，枝叶
茂盛。叶对生，椭圆形，叶缘有细锯齿，革质，深绿色。花单生在叶腋，或簇
生在枝顶端，白色，9～10月开放，香气浓郁。核果卵圆形。
桂花变种很多，一般把开黄白色或淡黄色的称银桂；开纯黄色花的称金桂；开
橙色，橙红色的称丹桂。其中丹桂桂香气最烈，是桂花中的上品。此外尚有花
香较淡，但能多次连续不断开花的四季桂。
原产中国西南部及中部，长江以南广泛种植，以苏州，杭州，成都等地栽培最
多，广西桂林更是盛产，华北各地常做盆栽。
桂花喜温暖湿润气候，不耐寒，适宜在阳光充足，排水较好的砂质壤土栽种。
冬季施基肥，夏季施追肥，能促进生长和开花。一般采用压条(地压或高压)，
扦插或嫁接繁殖。桂花对烟尘抗性较弱，不宜在大气污染地区栽植。寿命较长，
陕西勉县武侯墓前的汉桂，据传已有1700年的历史。
桂花除做观赏外，成片栽种时可采花提取香料，供制蜜饯或糕点。采花1公斤与
糖1公斤拌和腌制而成的糖桂花，色香经年不变。
*/
#include <allobj.h>
#include <message.h>
inherit ITEM;
void power_lowtree();
void create()
{
  set_name(HIG"婆娑桂花树"NOR, ({ "sweet osmanthus", "tree" }) );
  set_weight(999999);
  set_max_encumbrance(80000);
  set("no_get", 1);
  set("no_sell", 1);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
   set("unit", "株");
   set("long",
HIM"一株挂满桂花的桂花树，清风一吹，桂花随风飘落，清香随风飘散。"NOR"
桂花(sweet osmanthus) 学名(Osmanthus fragrans)
又称“木犀”，“丹桂”。双子叶植物，木犀科。常绿乔木，高达12米，枝叶
茂盛。叶对生，椭圆形，叶缘有细锯齿，革质，深绿色。花单生在叶腋，或簇
生在枝顶端，白色，9～10月开放，香气浓郁。核果卵圆形。
桂花变种很多，一般把开黄白色或淡黄色的称银桂；开纯黄色花的称金桂；开
橙色，橙红色的称丹桂。其中丹桂桂香气最烈，是桂花中的上品。此外尚有花
香较淡，但能多次连续不断开花的四季桂。
原产中国西南部及中部，长江以南广泛种植，以苏州，杭州，成都等地栽培最
多，广西桂林更是盛产，华北各地常做盆栽。
桂花喜温暖湿润气候，不耐寒，适宜在阳光充足，排水较好的砂质壤土栽种。
冬季施基肥，夏季施追肥，能促进生长和开花。一般采用压条(地压或高压)，
扦插或嫁接繁殖。桂花对烟尘抗性较弱，不宜在大气污染地区栽植。寿命较长，
陕西勉县武侯墓前的汉桂，据传已有1700年的历史。
桂花除做观赏外，成片栽种时可采花提取香料，供制蜜饯或糕点。采花1公斤与
糖1公斤拌和腌制而成的糖桂花，色香经年不变。\n"NOR);
    set("value", 100000000);
  }
  setup();
}
// 用最简单的方式，尽量不用call_out()
void init()
{
  string season;
  season = NATURE_D->check_season();
// 首先排除季节，冬季是不可能开花的
  if( season != "Winter-Sun" || season != "Winter-Snow" || season != "Winter-Wind" )
  {
    if(!random(10))
      message_vision(HIY"\n桂花树已经开花了,清香宜人。。。。\n"NOR,this_object());
  }
}
void power_lowtree()
{
  int i;
  for (i=1;i<=40;i++)
  {
    new(CITY_OBJ"huaban2")->move(CLONE_ROOM"bobing");
  }	
}