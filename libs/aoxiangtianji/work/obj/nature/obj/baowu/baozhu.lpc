#include <ansi.h>
#include <combat.h>
#include <armor.h>
inherit NECK;
void setup()
{
  set("unit", "颗");
  set("material", "crystal");
  set("no_drop", "如此宝贵的宝物再世难求啊。\n");
  set("no_give", "这种稀世之宝怎么能轻易送人呢?\n");
  set("no_sell", "卖?这种稀世之宝谁买得起啊!\n");
  set("no_put",1);
  set("no_break", 1);
  set("wear_msg","$N带上了一个光华四射的$n，顿时显得神采奕奕！\n");
  set("unequip_msg","$N将$n轻轻地摘下来。。。\n");
  ::setup();
}

void init()
{
  object env=environment();
  if(!clonep())
    return;
  if(!objectp(env))
  {
    call_out("self_destroy",1);
    return;
  }

  if (userp(env))
  {
    if (query("owner") != env->query("id"))
    {
      call_out("self_destroy",1);
      return;
    }

    add_action("do_wear","wear");
    add_action("do_remove", "remove");
  }

  return;
}

void self_destroy()
{
  object env=environment();
  if(env)
  {
    if(env->is_character())
    { // npc or player
      tell_object(env,"只见"+this_object()->query("name")
        +"光华暗淡，竟然渐渐的不见了踪影。\n");
    }

  }

  destruct(this_object());
  return;
}

