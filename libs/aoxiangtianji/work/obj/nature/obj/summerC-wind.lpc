// 风之精灵(summerC-wind)
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIW "风之精灵" NOR, ({ "wind elf", "wind", "elf" }) );
  set_weight( 100 );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "缕");
    set("long", "这是一缕采自季风季节的风之精灵。\n");
    set("value", 100);
    set("des", 1); // drop时消失标志
  };
  set_temp("drop_msg", this_object()->query("name")
     + CYN" 悄然而逝，消失在空气中不见了～～～\n"NOR);
  setup();
}

