#include <ansi.h>
inherit ITEM;
void create()
{
  mapping name;
	
  name=NAME2_D->random_name("yuhua");
  set_name(name["name"], name["id"]);
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一粒色彩斑斓的小石子，每一粒都似乎在讲述着一个故事。\n");
    set("unit", "粒");
    set("value", 2000);
  }
}
