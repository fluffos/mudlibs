// 枯枝(Withered branch)
#include <ansi.h>
inherit __DIR__"nature_gift";
void create()
{
  ::create();
  set_name(YEL "枯枝" NOR, ({ "withered branch", "branch", "withered" }) );
  set("unit", "段");
  set("long", "这是一段被风折断的树枝，上面挂着几片叶子。\n");
  set("material", "water");
  set("shuxing","earth");
  setup();
}

