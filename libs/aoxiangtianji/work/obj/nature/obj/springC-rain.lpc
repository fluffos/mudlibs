//春之甘霖(springC-rain)
#include <ansi.h>
inherit ITEM;
void create()
{
  set_name(HIG "春之甘霖" NOR, ({ "springC rain", "springC", "rain" }) );
  set_weight( 100 );
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "滴");
    set("long", "这是一滴晶莹的春之甘霖的雨滴。\n");
    set("value", 100);
    set("des", 1); // drop时消失标志
    set("material", "water");//水性物件标志
  };
  set_temp("drop_msg", this_object()->query("name")
          + CYN" 随风而逝，消失在空气中不见了～～～\n"NOR);
  setup();
}

