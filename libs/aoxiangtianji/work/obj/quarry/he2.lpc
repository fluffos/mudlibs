#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(HIW"雪鹤"NOR, ({ "xue he", "xue", "he" }));
  set("long", HIW "全身洁白的雪鹤，是大雪山的特产。\n" NOR);
  set("no_auto_kill", 1);
  set("aves", 1);
  set("age", 1);
  set("str", 5);
  set("dex", 30);
  set("max_kee", 500);
  set("max_sen", 500);
  set("combat_exp", 100000);
  set("daoxing", 100000);
  set("force", 1000);
  set("max_force", 500);
  set("mana", 1000);
  set("max_mana", 500);
  set("power", 10);
  set_temp("apply/parry", 50);
  set_temp("apply/dodge", 100);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/unarmed_damage", 50);
  set_temp("apply/armor", 50);
  setup();
}