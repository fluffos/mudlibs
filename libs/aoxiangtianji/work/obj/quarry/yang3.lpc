#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(HIY"黄羊"NOR, ({ "huang yang", "huang", "yang" }));
  set("long", HIY "这是一头健壮的野生黄羊。\n" NOR);
  set("no_auto_kill", 1);
  set("age", 1);
  set("str", 8);
  set("dex", 25);
  set("max_kee", 500);
  set("max_sen", 500);
  set("combat_exp", 100000);
  set("daoxing", 100000);
  set("force", 1000);
  set("max_force", 500);
  set("mana", 1000);
  set("max_mana", 500);
  set("power", 10);
  set("item1", __DIR__"item/yangrou");
  set("item2", __DIR__"item/yangpi");
  set_temp("apply/parry", 50);
  set_temp("apply/dodge", 50);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/unarmed_damage", 50);
  set_temp("apply/armor", 50);
  setup();
}

