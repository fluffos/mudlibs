#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(HIW"银狼"NOR, ({ "yin lang", "yin", "lang" }));
  set("long", HIW "这是一只全身雪白的银狼。\n" NOR);
  set("age", 3);
  set("str", 35);
  set("dex", 50);
  set("max_kee", 1500);
  set("max_sen", 1500);
  set("combat_exp", 600000);
  set("daoxing", 600000);
  set("force", 3000);
  set("max_force", 1500);
  set("mana", 3000);
  set("max_mana", 1500);
  set("power", 60);
  set("item1", __DIR__"item/langrou");
  set("item2", __DIR__"item/langpi2");
  set_temp("apply/parry", 150);
  set_temp("apply/dodge", 150);
  set_temp("apply/attack", 150);
  set_temp("apply/defense", 160);
  set_temp("apply/unarmed_damage", 180);
  set_temp("apply/armor", 180);
  setup();
}

