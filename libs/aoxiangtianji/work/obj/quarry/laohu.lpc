#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(YEL"老虎"NOR, ({ "lao hu", "lao", "hu" }));
  set("long", YEL "这是一只斑斓猛虎，威猛极了。\n" NOR);
  set("age", 3);
  set("str", 35);
  set("dex", 50);
  set("max_kee", 2200);
  set("max_sen", 2200);
  set("combat_exp", 800000);
  set("daoxing", 800000);
  set("force", 4400);
  set("max_force", 2200);
  set("mana", 4400);
  set("max_mana", 2200);
  set("power", 80);
  set("item1", __DIR__"item/hurou");
  set("item2", __DIR__"item/hupi");
  set_temp("apply/parry", 160);
  set_temp("apply/dodge", 160);
  set_temp("apply/attack", 160);
  set_temp("apply/defense", 160);
  set_temp("apply/unarmed_damage", 200);
  set_temp("apply/armor", 160);
  setup();
}