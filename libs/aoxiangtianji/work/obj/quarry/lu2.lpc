#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(HIW"麋鹿"NOR, ({ "mi lu", "mi", "lu" }));
  set("long", HIW "这是一只行动敏捷的麋鹿。\n" NOR);
  set("no_auto_kill", 1);
  set("age", 3);
  set("str", 20);
  set("dex", 25);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("combat_exp", 150000);
  set("daoxing", 150000);
  set("force", 1000);
  set("max_force", 500);
  set("mana", 1000);
  set("max_mana", 500);
  set("power", 15);
  set("item1", __DIR__"item/lurou");
  set("item2", "/obj/herb/lurong");
  set_temp("apply/parry", 50);
  set_temp("apply/dodge", 80);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 80);
  set_temp("apply/unarmed_damage", 100);
  set_temp("apply/armor", 100);
  setup();
}

