#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(YEL"东北虎"NOR, ({ "dongbei hu", "dongbei", "hu" }));
  set("long", YEL "这是一只体型巨大的东北虎，威猛极了。\n" NOR);
  set("age", 3);
  set("str", 35);
  set("dex", 50);
  set("max_kee", 2500);
  set("max_sen", 2500);
  set("combat_exp", 1000000);
  set("daoxing", 1000000);
  set("force", 5000);
  set("max_force", 2500);
  set("mana", 5000);
  set("max_mana", 2500);
  set("power", 100);
  set("item1", __DIR__"item/hurou");
  set("item2", __DIR__"item/hupi");
  set_temp("apply/parry", 200);
  set_temp("apply/dodge", 200);
  set_temp("apply/attack", 200);
  set_temp("apply/defense", 200);
  set_temp("apply/unarmed_damage", 250);
  set_temp("apply/armor", 200);
  setup();
}

