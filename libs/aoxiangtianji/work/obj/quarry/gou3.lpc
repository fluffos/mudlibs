#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(CYN"藏獒"NOR, ({ "zang ao", "zang", "ao" }));
  set("long", NOR + CYN "这是一只凶猛的藏獒，正警觉的来回踱步。\n" NOR);
  set("age", 1);
  set("str", 18);
  set("dex", 30);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("combat_exp", 500000);
  set("daoxing", 500000);
  set("force", 2000);
  set("max_force", 1000);
  set("mana", 2000);
  set("max_mana", 1000);
  set("power", 50);
  set("item1", __DIR__"item/gourou");
  set("item2", __DIR__"item/goupi");
  set_temp("apply/parry", 100);
  set_temp("apply/dodge", 100);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/unarmed_damage", 150);
  set_temp("apply/armor", 100);
  setup();
}

