#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(CYN"鳄鱼"NOR, ({ "e yu", "e", "yu" }));
  set("long", CYN "这是一只体形庞大的鳄鱼，相当的凶猛。\n" NOR);
  set("age", 3);
  set("str", 50);
  set("dex", 20);
  set("max_kee", 2400);
  set("max_sen", 2400);
  set("force", 4800);
  set("max_force", 2400);
  set("mana", 4800);
  set("max_mana", 2400);
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set("power", 120);
  set("item1", __DIR__"item/eyurou");
  set("item2", __DIR__"item/eyupi");
  set_temp("apply/force", 240);
  set_temp("apply/parry", 240);
  set_temp("apply/dodge", 240);
  set_temp("apply/attack", 240);
  set_temp("apply/defense", 240);
  set_temp("apply/unarmed_damage", 300);
  set_temp("apply/armor", 240);
  setup();
}