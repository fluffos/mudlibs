#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(CYN"乌龟"NOR, ({ "wu gui", "wu", "gui" }));
  set("long", CYN "这是一只大乌龟，看来岁数不小了。\n" NOR);
  set("no_auto_kill", 1);
  set("age", 28);
  set("str", 5);
  set("dex", 2);
  set("con", 20);
  set("max_kee", 500);
  set("max_sen", 500);
  set("combat_exp", 50000);
  set("daoxing", 50000);
  set("force", 1000);
  set("max_force", 500);
  set("mana", 1000);
  set("max_mana", 500);
  set("power", 5);
  set("item1", "/obj/herb/guijia");
  set_temp("apply/attack", 30);
  set_temp("apply/damage", 30);
  set_temp("apply/armor", 200);
  setup();
}