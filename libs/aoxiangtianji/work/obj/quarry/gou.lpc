#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(YEL"野狗"NOR, ({ "ye gou", "ye", "gou" }));
  set("long", YEL "这是一只饥饿凶猛，吐着长舌头的野狗。\n" NOR);
  set("age", 1);
  set("str", 18);
  set("dex", 30);
  set("max_kee", 500);
  set("max_sen", 500);
  set("combat_exp", 120000);
  set("daoxing", 120000);
  set("force", 1000);
  set("max_force", 500);
  set("mana", 1000);
  set("max_mana", 500);
  set("power", 12);
  set("item1", __DIR__"item/gourou");
  set("item2", __DIR__"item/goupi");
  set_temp("apply/parry", 50);
  set_temp("apply/dodge", 50);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/unarmed_damage", 50);
  set_temp("apply/armor", 50);
  setup();
}