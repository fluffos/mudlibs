#include <ansi.h>
inherit COMBINED_ITEM;
void create()
{
  set_name(WHT"兽肉"NOR, ({ "shou rou","rou" }));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", NOR + WHT "这是一块散发着腥臊臭的兽肉。\n" NOR);
    set("base_unit", "块");
    set("base_value", 500);
  }

  set("only_do_effect", 1);
  set("base_weight", 300);
  setup();
  set_amount(1);
}

int do_effect(object me)
{
  write("这块" + name() + "还是生的，烤(broil)熟了再吃吧。\n");
  return 1;
}

int broil(object me, object ob)
{
  object fob;
  string n, e_n;
  me = this_player();

  if (me->is_busy())
  {
    write("你现在忙着呢，过会儿再烤吧。\n");
    return 1;
  }

  message_sort(HIM "$N" HIM "把" + name() + HIM "放在" + ob->name() +
               HIM "上细细烤着，只听毕啵毕啵几声，闻得一阵诱人的香味"
                   "渐渐散了出来。$P见状连忙把烤好的" + name() + HIM "取"
                   "下。\n\n" NOR, me);
  fob = new("/obj/quarry/item/animal-meat");
  n = COLOR_D->clean_color(name());
  n = RED +"烤" + n + NOR;
  e_n = "kao " + query("id");
  fob->set_name(n, ({ e_n, "kao rou","rou" }));
  fob->move(me, 1);
  add_amount(-1);
  if (query_amount() < 1)
    destruct(this_object());
  me->start_busy(2);
  return 1;
}