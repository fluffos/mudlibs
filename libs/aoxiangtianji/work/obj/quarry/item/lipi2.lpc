#include <ansi.h>
inherit "/obj/quarry/item/shoupi";
void create()
{
  ::create();
  set_name(HIW"白狐皮"NOR, ({ "baihu pi", "baihu", "pi" }));
  set("long", HIW"这是一张质地非常不错的狐狸皮，柔软光滑之极。\n"NOR);
  set("base_value", 10000);
  set("power",40);
  set("sew_type/cloth",1);
  set("sew_type/pifeng",1);
  set("sew_type/hat",1);
}