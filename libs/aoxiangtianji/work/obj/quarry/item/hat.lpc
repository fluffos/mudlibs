#include <armor.h>
inherit HEAD;

void create()
{
  set_name("兽皮帽", ({ "shoupi mao", "hat" }) );
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "leather");
    set("unit", "顶");
    set("long", "这是一顶兽皮制作而成的帽子。\n");
    set("NO_LIMIT",1);
  }

  init_head(5);
  setup();
}