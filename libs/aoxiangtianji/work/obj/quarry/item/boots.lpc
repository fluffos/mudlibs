//上衣  min_armor: 2  max_armor: 80  default_armor: 20
#include <armor.h>
inherit CLOTH;
void create()
{
  set_name("兽皮鞋", ({"shoupi shoes", "shoes"}));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("long", "一件兽皮制作而成的鞋子。\n");
    set("material", "leather");
    set("NO_LIMIT",1);
  }

  init_cloth(2);
  setup();
}

