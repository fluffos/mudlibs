//大氅  min_armor: 2  max_armor: 25  default_armor: 10
#include <armor.h>
inherit SURCOAT;
void create()
{
  set_name("兽皮披风", ({"shoupi surcoat", "surcoat"}));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "件");
    set("long", "一件很漂亮的兽皮披风。\n");
    set("material", "leather");
    set("NO_LIMIT",1);
  }

  init_surcoat(10);
  setup();
}

