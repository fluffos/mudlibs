#include <ansi.h>
inherit "/obj/quarry/item/shoupi";
void create()
{
  ::create();
  set_name(HIY "豹皮" NOR, ({ "bao pi", "bao", "pi" }));
  set("long", HIY "成年雄豹的皮，革质坚韧，皮毛柔软光滑之极。\n" NOR);
  set("base_value", 8000);
  set("power",50);
  set("sew_type/cloth",1);
  set("sew_type/pifeng",1);
  set("sew_type/hat",1);
}