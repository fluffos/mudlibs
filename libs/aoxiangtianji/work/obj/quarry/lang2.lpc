#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(WHT"饿狼"NOR, ({ "e lang", "e", "lang" }));
  set("long", WHT "这是一只凶残饥饿的野狼。\n" NOR);
  set("age", 1);
  set("str", 35);
  set("dex", 40);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("combat_exp", 400000);
  set("daoxing", 400000);
  set("force", 2000);
  set("max_force", 1000);
  set("mana", 2000);
  set("max_mana", 1000);
  set("power", 40);
  set("item1", __DIR__"item/langrou");
  set("item2", __DIR__"item/langpi");
  set_temp("apply/parry", 80);
  set_temp("apply/dodge", 80);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/unarmed_damage", 120);
  set_temp("apply/armor", 100);
  setup();
}

