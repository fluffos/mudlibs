#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(WHT"山猪"NOR, ({ "shan zhu", "shan", "zhu" }));
  set("long", WHT "这是一只非常凶猛的山猪。\n" NOR);
  set("age", 1);
  set("str", 35);
  set("dex", 40);
  set("max_kee", 900);
  set("max_sen", 900);
  set("combat_exp", 400000);
  set("daoxing", 400000);
  set("force", 1800);
  set("max_force", 900);
  set("mana", 1800);
  set("max_mana", 900);
  set("power", 40);
  set("item1", __DIR__"item/zhurou");
  set_temp("apply/parry", 80);
  set_temp("apply/dodge", 80);
  set_temp("apply/attack", 80);
  set_temp("apply/defense", 80);
  set_temp("apply/unarmed_damage", 120);
  set_temp("apply/armor", 80);
  setup();
}

