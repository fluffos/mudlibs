#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(CYN"黑熊"NOR, ({ "hei xiong", "hei", "xiong" }));
  set("long", CYN "这是一只身材巨大，凶猛异常的黑熊。\n" NOR);
  set("age", 8);
  set("str", 50);
  set("dex", 20);
  set("con", 50);
  set("max_kee", 2800);
  set("max_sen", 2800);
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set("force", 5500);
  set("max_force", 2800);
  set("mana", 5500);
  set("max_mana", 2800);
  set("power", 120);
  set("item1", __DIR__"item/xiongrou");
  set("item2", __DIR__"item/xiongpi");
  set("item3", "/obj/herb/xiongdan");
  set_temp("apply/force", 220);
  set_temp("apply/parry", 220);
  set_temp("apply/dodge", 220);
  set_temp("apply/attack", 220);
  set_temp("apply/defense", 220);
  set_temp("apply/unarmed_damage", 250);
  set_temp("apply/armor", 220);
  setup();
}

