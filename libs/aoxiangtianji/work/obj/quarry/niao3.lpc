#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(CYN"乌鸦"NOR, ({ "wu ya", "wu", "ya" }));
  set("long", CYN"这是一只黑乌鸦，呱呱叫个不停。\n"NOR);
  set("no_auto_kill", 1);
  set("aves", 1);
  set("max_kee", 500);
  set("max_sen", 500);
  set("combat_exp", 50000);
  set("daoxing", 50000);
  set("force", 1000);
  set("max_force", 500);
  set("mana", 1000);
  set("max_mana", 500);
  set("power", 5);
  set_temp("apply/parry", 50);
  set_temp("apply/dodge", 50);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/unarmed_damage", 50);
  set_temp("apply/armor", 50);
  setup();
}