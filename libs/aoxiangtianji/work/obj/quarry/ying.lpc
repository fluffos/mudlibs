#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(CYN"秃鹰"NOR, ({ "tu ying", "tu", "ying" }));
  set("long", CYN "这是一只既丑陋，又威武的秃鹰。\n" NOR);
  set("aves", 1);
  set("age", 1);
  set("str", 35);
  set("dex", 50);
  set("max_kee", 1500);
  set("max_sen", 1500);
  set("combat_exp", 500000);
  set("daoxing", 500000);
  set("force", 3000);
  set("max_force", 1500);
  set("mana", 3000);
  set("max_mana", 1500);
  set("power", 50);
  set("item1", __DIR__"item/yingrou");
  set_temp("apply/parry", 100);
  set_temp("apply/dodge", 150);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/unarmed_damage", 100);
  set_temp("apply/armor", 100);
  setup();
}

