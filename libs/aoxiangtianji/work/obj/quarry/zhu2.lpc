#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(YEL"野猪"NOR, ({ "ye zhu", "ye", "zhu" }));
  set("long", YEL"这是一只凶猛异常的野猪。\n"NOR);
  set("age", 5);
  set("str", 35);
  set("dex", 40);
  set("max_kee", 1200);
  set("max_sen", 1200);
  set("combat_exp", 600000);
  set("daoxing", 600000);
  set("force", 2400);
  set("max_force", 1200);
  set("mana", 2400);
  set("max_mana", 1200);
  set("power", 60);
  set("item1", __DIR__"item/zhurou");
  set_temp("apply/parry", 120);
  set_temp("apply/dodge", 120);
  set_temp("apply/attack", 120);
  set_temp("apply/defense", 120);
  set_temp("apply/unarmed_damage", 150);
  set_temp("apply/armor", 120);
  setup();
}