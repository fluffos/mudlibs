#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(WHT"狐狸"NOR, ({ "hu li", "hu", "li" }));
  set("long", WHT "这是一只乖巧的狐，双眼隐隐发光，透出灵气。\n" NOR);
  set("no_auto_kill", 1);
  set("age", 1);
  set("str", 30);
  set("dex", 30);
  set("max_kee", 800);
  set("max_sen", 800);
  set("combat_exp", 200000);
  set("daoxing", 200000);
  set("force", 1600);
  set("max_force", 800);
  set("mana", 1600);
  set("max_mana", 800);
  set("power", 20);
  set("item1", __DIR__"item/lirou");
  set("item2", __DIR__"item/lipi");
  set_temp("apply/parry", 50);
  set_temp("apply/dodge", 80);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/unarmed_damage", 50);
  set_temp("apply/armor", 50);
  setup();
}