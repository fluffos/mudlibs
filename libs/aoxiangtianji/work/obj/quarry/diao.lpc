#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(CYN"紫貂"NOR, ({ "zi diao", "zi", "diao" }));
  set("long", CYN "这是一只行动异常敏捷的紫貂。\n" NOR);
  set("no_auto_kill", 1);
  set("age", 1);
  set("str", 8);
  set("dex", 30);
  set("max_kee", 500);
  set("max_sen", 500);
  set("combat_exp", 100000);
  set("power", 10);
  set("item1", __DIR__"item/diaorou");
  set("item2", __DIR__"item/diaopi");
  set_temp("apply/parry", 50);
  set_temp("apply/dodge", 80);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/unarmed_damage", 50);
  set_temp("apply/armor", 50);
  setup();
}

