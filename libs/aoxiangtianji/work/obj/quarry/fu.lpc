#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(WHT "蝙蝠" NOR, ({ "bian fu", "bian", "fu" }));
  set("long", WHT "这是一只蝙蝠，正倒挂在洞顶。\n" NOR);
  set("no_auto_kill", 1);
  set("aves", 1);
  set("age", 1);
  set("str", 5);
  set("dex", 60);
  set("max_kee", 500);
  set("max_sen", 500);
  set("combat_exp", 100000);
  set("daoxing", 100000);
  set("force", 1000);
  set("max_force", 500);
  set("mana", 1000);
  set("max_mana", 500);
  set("power", 10);
  set_temp("apply/parry", 50);
  set_temp("apply/dodge", 100);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/unarmed_damage", 50);
  set_temp("apply/armor", 50);
  setup();
}