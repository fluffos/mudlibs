#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(YEL"猴子"NOR, ({ "hou zi", "hou", "zi" }));
  set("long", YEL "这是一只行动敏捷的大马猴。\n" NOR);
  set("no_auto_kill", 1);
  set("age", 1);
  set("str", 22);
  set("dex", 30);
  set("max_kee", 500);
  set("max_sen", 500);
  set("combat_exp", 150000);
  set("daoxing", 150000);
  set("force", 1000);
  set("max_force", 500);
  set("mana", 1000);
  set("max_mana", 500);
  set("power", 15);
  set_temp("apply/parry", 50);
  set_temp("apply/dodge", 50);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/unarmed_damage", 50);
  set_temp("apply/armor", 50);
  setup();
}

