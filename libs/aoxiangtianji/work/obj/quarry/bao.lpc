#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(HIY"金钱豹"NOR, ({ "jinqian bao", "jinqian", "bao" }));
  set("long", HIY "这是一只全身有着金钱斑纹的雄豹。\n" NOR);
  set("age", 3);
  set("str", 35);
  set("dex", 50);
  set("max_kee", 1600);
  set("max_sen", 1600);
  set("combat_exp", 800000);
  set("daoxing", 800000);
  set("force", 3200);
  set("max_force", 1600);
  set("mana", 3200);
  set("max_mana", 1600);
  set("power", 80);
  set("item1", __DIR__"item/baorou");
  set("item2", __DIR__"item/baopi");
  set_temp("apply/parry", 160);
  set_temp("apply/dodge", 160);
  set_temp("apply/attack", 160);
  set_temp("apply/defense", 160);
  set_temp("apply/unarmed_damage", 240);
  set_temp("apply/armor", 160);
  setup();
}