#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(HIW"白狐"NOR, ({ "bai hu", "bai", "hu" }));
  set("long", HIW "这是一只全身雪白的狐，双眼隐隐发光，透出灵气。\n" NOR);
  set("no_auto_kill", 1);
  set("age", 1);
  set("str", 35);
  set("dex", 35);
  set("max_kee", 1500);
  set("max_sen", 1500);
  set("combat_exp", 350000);
  set("daoxing", 350000);
  set("force", 2000);
  set("max_force", 1000);
  set("mana", 2000);
  set("max_mana", 1000);
  set("power", 35);
  set("item1", __DIR__"item/lirou");
  set("item2", __DIR__"item/lipi2");
  set_temp("apply/parry", 80);
  set_temp("apply/dodge", 120);
  set_temp("apply/attack", 80);
  set_temp("apply/defense", 80);
  set_temp("apply/unarmed_damage", 100);
  set_temp("apply/armor", 80);
  setup();
}