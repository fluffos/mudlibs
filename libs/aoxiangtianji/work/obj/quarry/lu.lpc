#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(YEL"梅花鹿"NOR, ({ "meihua lu", "meihua", "lu" }));
  set("long", YEL "这是一只行动敏捷的梅花鹿。\n" NOR);
  set("no_auto_kill", 1);
  set("age", 3);
  set("str", 20);
  set("dex", 25);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("combat_exp", 120000);
  set("daoxing", 120000);
  set("force", 1000);
  set("max_force", 500);
  set("mana", 1000);
  set("max_mana", 500);
  set("power", 12);
  set("item1", __DIR__"item/lurou");
  set("item2", "/obj/herb/lurong");
  set_temp("apply/parry", 50);
  set_temp("apply/dodge", 80);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/unarmed_damage", 50);
  set_temp("apply/armor", 50);
  setup();
}