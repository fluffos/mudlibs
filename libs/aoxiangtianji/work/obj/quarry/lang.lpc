#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(WHT"野狼"NOR, ({ "ye lang", "ye", "lang" }));
  set("long", WHT "这是一只凶残饥饿的野狼。\n" NOR);
  set("age", 1);
  set("str", 35);
  set("dex", 40);
  set("max_kee", 800);
  set("max_sen", 800);
  set("combat_exp", 250000);
  set("daoxing", 250000);
  set("force", 1600);
  set("max_force", 800);
  set("mana", 1600);
  set("max_mana", 800);
  set("power", 25);
  set("item1", __DIR__"item/langrou");
  set("item2", __DIR__"item/langpi");
  set_temp("apply/parry", 50);
  set_temp("apply/dodge", 50);
  set_temp("apply/attack", 80);
  set_temp("apply/defense", 50);
  set_temp("apply/unarmed_damage", 80);
  set_temp("apply/armor", 100);
  setup();
}

