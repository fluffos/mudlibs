#include <ansi.h>
inherit QUARRY;
void create()
{
  set_name(WHT"灰熊"NOR, ({ "hui xiong", "hui", "xiong" }));
  set("long", WHT"这是一只身材巨大，凶猛异常的灰熊。\n" NOR);
  set("age", 6);
  set("str", 50);
  set("dex", 20);
  set("con", 50);
  set("max_kee", 2200);
  set("max_sen", 2200);
  set("combat_exp", 800000);
  set("daoxing", 800000);
  set("force", 4000);
  set("max_force", 2200);
  set("mana", 4000);
  set("max_mana", 2200);
  set("power", 80);
  set("item1", __DIR__"item/xiongrou");
  set("item2", __DIR__"item/xiongpi");
  set("item3", "/obj/herb/xiongdan");
  set_temp("apply/force", 160);
  set_temp("apply/parry", 160);
  set_temp("apply/dodge", 160);
  set_temp("apply/attack", 160);
  set_temp("apply/defense", 160);
  set_temp("apply/unarmed_damage", 180);
  set_temp("apply/armor", 160);
  setup();
}