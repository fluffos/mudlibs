        (: perform_action, "sword.zxzx" :),
        (: cast_spell, "qushu" :),
      }) );
      wp = "/d/eastsea/obj/dragonsword";
    }
  }

  set("class", "yaomo");
  set("family/family_name", "陷空山无底洞");
  carry_object(wp)->wield();
  carry_object(a)->wear();
  carry_object(c)->wear();
}

