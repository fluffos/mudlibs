void from_puti(object owner,int lvl,int type, string quest_type);
void from_wudidong(object owner,int lvl,int type, string quest_type);
void from_xueshan(object owner,int lvl,int type, string quest_type);
void from_zhenyuan(object owner,int lvl,int type, string quest_type);
void random_move();
int is_questnpc() {return 1;}

