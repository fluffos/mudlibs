        set_skill("sanban-axe",1);
        map_skill("axe","sanban-axe");
        map_skill("parry", "sanban-axe");
        set("chat_msg_combat",
        ({
          (: perform_action, "axe.sanban" :),
          (: cast_spell, "fu" :),
          (: cast_spell, "zhanshen" :),
        }) );
        wp = "/d/obj/weapon/axe/huafu";
        break;
      case 1 :
        set_skill("mace",1);
        set_skill("jinglei-mace",1);
        map_skill("mace", "jinglei-mace");
        map_skill("parry","jinglei-mace");
        set("chat_msg_combat",
        ({
          (: cast_spell, "fu" :),
          (: cast_spell, "zhanshen" :),
        }) );
        wp = "/d/obj/weapon/mace/silverjian";
        break;
      case 2 :
        set_skill("spear",1);
        set_skill("bawang-spear",1);
        map_skill("spear", "bawang-spear");
        map_skill("parry", "bawang-spear");
        set("chat_msg_combat",
        ({
          (: perform_action, "spear.sha" :),
          (: perform_action, "spear.tieji" :),
          (: cast_spell, "fu" :),
          (: cast_spell, "zhanshen" :),
        }) );
        wp = "/d/obj/weapon/spear/jinqiang";
        break;
      default :
        set_skill("hammer",1);
        set_skill("wudi-hammer",1);
        map_skill("hammer", "wudi-hammer");
        map_skill("parry",  "wudi-hammer");
        set("chat_msg_combat",
        ({
          (: perform_action, "hammer.jingtian" :),
          (: cast_spell, "fu" :),
          (: cast_spell, "zhanshen" :),
        }) );
        wp = "/d/obj/weapon/hammer/bahammer";
    }

  }

  set("class", "fighter");
  set("family/family_name", "将军府");
  carry_object(wp)->wield();
  carry_object(a)->wear();
  carry_object(c)->wear();
}

void from_ghost(object owner,int lvl,int type,string quest_type)
{
  int i;
  string c,a,wp;

  set_npc_name(owner,lvl,type,quest_type, "阎罗地府");
  if (random(2))
    set("gender", "男性");
  else
    set("gender", "女性");

  set_skill("literate", 1);
  set_skill("force", 1);
  set_skill("spells", 1);
  set_skill("dodge", 1);
  set_skill("unarmed", 1);
  set_skill("parry", 1);

  set_skill("tonsillit",1);
  set_skill("gouhunshu",1);
