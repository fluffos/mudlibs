void kill_ob(object ob)
{
  if (! is_busy())
    exert_function("powerup");
  if (ob->query("quest/id") != query("id"))
  {
    ::kill_ob(ob);
     return;
  }

  ::kill_ob(ob);
}

int accept_fight(object ob)
{
  command("say 好！咱们就比划比划！");
  kill_ob(ob);
  return 1;
}

int accept_kill(object ob)
{
  command("say 哼！找死！");
  return 1;
}

