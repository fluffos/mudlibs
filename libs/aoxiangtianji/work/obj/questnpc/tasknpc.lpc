void create()
{
  set_name("任务妖怪","task yaoguai");
  set("age", 20);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
// the follow 5 setting has no use
  set("max_kee", 100);
  set("max_sen", 100);
  set("force", 200);
  set("max_force", 100);
  set("force_factor", 100);
  set("mana", 200);
  set("max_mana", 100);
  set("mana_factor", 100);
  set("combat_exp", 3000000);
  set("daoxing", 3000000);

  set("chat_chance", 20);
  set("chat_msg", ({ (: random_move :) }));
  set("no_get", 1);
  set("no_bian", 1);
  set("no_find", 1);
  set("scale", 120);
  set("born_time", time());
  set("stay_time", 900);
  setup();
}

/*
object owner : the npc owner
string fam : maybe you can appoint a fixed family for npc
int type :
  0: no my name signed
  1: have a my name signed, like 某某的 XXX
*/
void set_npc_family(object owner, string npc_fam,int type,string quest_type)
{
  int lvl;
  string *fam = ({
    "bonze",
    "dragon",
    "fighter",
    "ghost",
    "kusong",
    "moon",
    "puti",
    "wudidong",
    "xueshan",
    "zhenyuan",
  });

  if (objectp(owner))
    lvl = (int)owner->query("level");
  else
    lvl = 0;
  if(!stringp(npc_fam))
    npc_fam = element_of(fam);

  switch (npc_fam)
  {
    case "bonze" :
      from_bonze(owner,lvl, type, quest_type);
      break;
    case "dragon" :
      from_dragon(owner,lvl,type, quest_type);
      break;
    case "fighter" :
      from_fighter(owner,lvl,type, quest_type);
      break;
    case "ghost" :
      from_ghost(owner,lvl,type, quest_type);
      break;
    case "kusong" :
      from_kusong(owner,lvl,type, quest_type);
      break;
    case "moon" :
      from_moon(owner,lvl,type, quest_type);
      break;
    case "puti" :
      from_puti(owner,lvl,type, quest_type);
      break;
    case "wudidong" :
      from_wudidong(owner,lvl,type, quest_type);
      break;
    case "xueshan" :
      from_xueshan(owner,lvl,type, quest_type);
      break;
    default :
      from_zhenyuan(owner,lvl,type, quest_type);
  }

  return;
}

void set_npc_name(object owner,int lvl,int type, string quest_type, string my_fam)
{
  string *fam;
  mapping prefix = ([
    "南海普坨山" : ({
          BLINK + HIW"凶和尚 "NOR,
          BLINK + HIW"恶和尚 "NOR,
          BLINK + HIW"魔僧 "NOR,
          BLINK + HIW"妖僧 "NOR,}),
    "东海龙宫" : ({
          BLINK + HIW"东海孽龙 "NOR,
          BLINK + HIW"南海妖龙 "NOR,
          BLINK + HIW"西海恶龙 "NOR,
          BLINK + HIW"北海凶龙 "NOR,}),
    "将军府" : ({
          BLINK + HIW"将军府凶徒 "NOR,
          BLINK + HIW"将军府恶徒 "NOR,
          BLINK + HIW"将军府歹徒 "NOR,
          BLINK + HIW"将军府叛将 "NOR,}),
    "阎罗地府" : ({
          BLINK + HIW"幽冥凶鬼 "NOR,
          BLINK + HIW"幽冥恶鬼 "NOR,
          BLINK + HIW"幽冥断魂鬼 "NOR,
          BLINK + HIW"幽冥丧魄鬼 "NOR,}),
    "火云洞" : ({
          BLINK + HIR"火云凶魔 "NOR,
          BLINK + HIR"火云恶魔 "NOR,
          BLINK + HIR"火云妖魔 "NOR,
          BLINK + HIR"火云鬼魔 "NOR,}),
    "月宫" : ({
          BLINK + HIR"月宫魔女 "NOR,
          BLINK + HIR"月宫恶女 "NOR,
          BLINK + HIR"月宫怨女 "NOR,
          BLINK + HIR"月宫凶妇 "NOR,}),
    "方寸山三星洞" : ({
          BLINK + HIR"灵台魔道 "NOR,
          BLINK + HIR"灵台恶道 "NOR,
          BLINK + HIR"方寸凶道 "NOR,
          BLINK + HIR"方寸邪道 "NOR,}),
    "陷空山无底洞" : ({
          BLINK + HIR"魔鼠 "NOR,
          BLINK + HIR"恶鼠 "NOR,
          BLINK + HIR"凶鼠 "NOR,
          BLINK + HIR"邪鼠 "NOR,}),
    "大雪山" : ({
          BLINK + HIR"雪山凶妖 "NOR,
          BLINK + HIR"雪山恶妖 "NOR,
          BLINK + HIR"雪山魔妖 "NOR,
          BLINK + HIR"雪山邪妖 "NOR,}),
    "五庄观" : ({
          BLINK + HIR"五庄观凶徒 "NOR,
          BLINK + HIR"五庄观匪徒 "NOR,
          BLINK + HIR"五庄观妖道 "NOR,
          BLINK + HIR"五庄观邪道 "NOR,}),
  ]);
  string n_name;

  if (!objectp(owner)) //owner还没有确定的情况
  {
    NPC_D->generate_cn_name(this_object(),0,0);
    this_object()->setup();
    return;
  }
  n_name = "";
  if (type == 1)
    n_name = owner->name(1) + "的 ";
  if (quest_type == "yuan" || quest_type == "lijing" || quest_type == "menpai")
  {
    if (lvl <= 8)
      n_name += " 小小 ";
    else if (lvl <= 20)
      n_name += " 十年 ";
    else if (lvl <= 33)
      n_name += " 百年 ";
    else if (lvl <= 45)
      n_name += " 千年 ";
    else if (lvl <= 58)
      n_name += " 万年 ";
    else
      n_name += " 得道 ";

    NPC_D->generate_animal_name(this_object(),n_name, 0);
    this_object()->setup();
  }
  else if (quest_type == "xue")
  {
    n_name += element_of(tf_pfx1) + " " + element_of(tf_pfx);
    NPC_D->generate_cn_name(this_object(),n_name,0);
    this_object()->setup();
  }

  else
  {
    fam = prefix[my_fam];
    n_name += element_of(fam);
    NPC_D->generate_cn_name(this_object(),n_name,0);
    this_object()->setup();
  }

  return;
}

void from_bonze(object owner,int lvl,int type, string quest_type)
{
  int i;
  string c,a,wp;
  set_npc_name(owner,lvl,type,quest_type, "南海普坨山");
  set("gender", "男性");
  set_skill("literate", 1);
  set_skill("force", 1);
  set_skill("spells", 1);
  set_skill("dodge", 1);
  set_skill("unarmed", 1);
  set_skill("parry", 1);
  set_skill("lotusforce",1);
  set_skill("buddhism",1);
  set_skill("lotusmove",1);
  set_skill("jienan-zhi",1);
  map_skill("force","lotusforce");
  map_skill("spells","buddhism");
  map_skill("dodge","lotusmove");
  map_skill("unarmed","jienan-zhi");

  set("chat_chance_combat", 30);

  if (lvl <= 25)
  {
    set_skill("staff",1);
    set_skill("pudu-staff",1);
    map_skill("staff", "pudu-staff");
    map_skill("parry", "pudu-staff");
    set("chat_msg_combat",
    ({
       (: perform_action, "staff.zhao" :),
       (: cast_spell, "bighammer" :),
    }) );
    wp = "/d/obj/weapon/staff/gangzhang";
    c = "/obj/cloth/seng-cloth";
    a = "/d/obj/armor/armor/tiejia";
  }

  else if (lvl <= 35)
  {
    i = random(3);
    switch(i)
    {
      case 0 :
        set_skill("blade",1);
        set_skill("cibei-blade",1);
        map_skill("blade", "cibei-blade");
        map_skill("parry", "cibei-blade");
        set("chat_msg_combat",
        ({
           (: perform_action, "blade.yingzhi" :),
           (: cast_spell, "bighammer" :),
        }) );
        wp = "/d/obj/weapon/blade/yanblade";
        c = "/obj/cloth/c-jiasha";
        a = "/d/obj/armor/armor/yinjia";
        break;
      case 1 :
        set_skill("mace",1);
        set_skill("jingang-mace",1);
        map_skill("mace", "jingang-mace");
        map_skill("parry", "jingang-mace");
        set("chat_msg_combat",
        ({
           (: perform_action, "mace.weituo" :),
           (: cast_spell, "bighammer" :),
        }) );
        wp = "/d/eastsea/obj/dragonmace";
        c = "/obj/cloth/c-jiasha";
        a = "/d/obj/armor/armor/yinjia";
        break;
      default :
        set_skill("staff", 1);
        set_skill("pudu-staff", 1);
        map_skill("staff", "pudu-staff");
        map_skill("parry", "pudu-staff");
        set("chat_msg_combat",
        ({
           (: perform_action, "staff.zhao" :),
           (: cast_spell, "bighammer" :),
        }) );
        wp = "/d/eastsea/obj/dragonstaff";
        c = "/obj/cloth/c-jiasha";
        a = "/d/obj/armor/armor/yinjia";
        break;
    }

  }

  else
  {
    set_skill("lunhui-staff",1);
    set_skill("staff",1);
    map_skill("staff","lunhui-staff");
    map_skill("parry", "lunhui-staff");
    set("chat_msg_combat",
    ({
       (: perform_action, "staff.zhao" :),
       (: perform_action, "staff.pudu" :),
       (: cast_spell, "bighammer" :),
    }) );
    wp = "/d/eastsea/obj/dragonstaff";
    c = "/obj/cloth/y-jiasha";
    a = "/d/obj/armor/armor/jinjia";
  }

  set("class", "bonze");
  set("family/family_name", "南海普陀山");
  carry_object(wp)->wield();
  carry_object(a)->wear();
  carry_object(c)->wear();
}

void from_dragon(object owner,int lvl,int type, string quest_type)
{
  int i;
  string c,a,wp;

  set_npc_name(owner,lvl,type,quest_type, "东海龙宫");

  if (random(2))
    set("gender", "男性");
  else
    set("gender", "女性");
  set_skill("literate", 1);
  set_skill("force", 1);
  set_skill("spells", 1);
  set_skill("dodge", 1);
  set_skill("unarmed", 1);
  set_skill("parry", 1);
  set_skill("dragonforce",1);
  set_skill("seashentong",1);
  set_skill("dragonstep",1);
  set_skill("dragonfight",1);
  map_skill("force","dragonforce");
  map_skill("spells","seashentong");
  map_skill("dodge","dragonstep");
  map_skill("unarmed","dragonfight");

  set("chat_chance_combat", 30);

  if (lvl <= 25)
  {
    set_skill("fork",1);
    if (random(2))
    {
      set_skill("wufeng-fork",1);
      map_skill("fork", "wufeng-fork");
      map_skill("parry", "wufeng-fork");
      set("chat_msg_combat",
      ({
         (: perform_action, "fork.haixiao" :),
         (: cast_spell, "water" :),
      }) );
    }

    else
    {
      set_skill("dingbo-fork",1);
      map_skill("fork", "dingbo-fork");
      map_skill("parry", "dingbo-fork");
      set("chat_msg_combat",
      ({
         (: perform_action, "fork.bibo" :),
         (: cast_spell, "water" :),
      }) );
    }
    wp = "/d/obj/weapon/fork/fork";
    c = sprintf("/obj/cloth/male%d-cloth",1+random(8));
    a = "/d/obj/armor/armor/tiejia";
  }

  else if (lvl <= 35)
  {
    i = random(3);
    c = "/obj/cloth/zhanpao";
    a = "/d/obj/armor/armor/yinjia";
    switch(i)
    {
      case 0 :
        set_skill("hammer",1);
        set_skill("huntian-hammer",1);
        map_skill("hammer", "huntian-hammer");
        map_skill("parry", "huntian-hammer");
        set("chat_msg_combat",
        ({
           (: perform_action, "hammer.hundun" :),
           (: cast_spell, "water" :),
        }) );
        wp = "/d/obj/weapon/hammer/tongchui";
        break;
      case 1 :
        set_skill("mace",1);
        set_skill("wuliang-mace",1);
        map_skill("mace", "wuliang-mace");
        map_skill("parry", "wuliang-mace");
        set("chat_msg_combat",
        ({
           (: perform_action, "mace.dhwl" :),
           (: cast_spell, "water" :),
        }) );
        wp = "/d/eastsea/obj/dragonmace";
        break;
      default :
        set_skill("fork", 1);
        if (random(2))
        {
          set_skill("wufeng-fork",1);
          map_skill("fork", "wufeng-fork");
          map_skill("parry", "wufeng-fork");
          set("chat_msg_combat",
          ({
            (: perform_action, "fork.haixiao" :),
            (: cast_spell, "water" :),
          }) );
        }

        else
        {
          set_skill("dingbo-fork",1);
          map_skill("fork", "dingbo-fork");
          map_skill("parry", "dingbo-fork");
          set("chat_msg_combat",
          ({
            (: perform_action, "fork.bibo" :),
            (: cast_spell, "water" :),
          }) );
        }

        wp = "/d/eastsea/obj/dragonfork";
    }

  }

  else
  {
    if (random(2))
    {
      set_skill("fengbo-fork",1);
      set_skill("fork",1);
      map_skill("fork","fengbo-fork");
      map_skill("parry", "fengbo-fork");
      set("chat_msg_combat",
      ({
         (: perform_action, "fork.bibo" :),
         (: perform_action, "fork.haixiao" :),
         (: perform_action, "fork.fengbo" :),
         (: cast_spell, "water" :),
         (: exert_function, "roar" :),
      }) );
      wp = "/d/obj/weapon/fork/sangu-cha";
    }

    else
    {
      set_skill("tabo-sword",1);
      set_skill("sword",1);
      map_skill("sword","tabo-sword");
      map_skill("parry", "tabo-sword");
      set("chat_msg_combat",
      ({
         (: perform_action, "sword.tian" :),
         (: cast_spell, "water" :),
         (: exert_function, "roar" :),
         (: exert_function, "bihai" :),
      }) );
      wp = "/d/obj/weapon/sword/qinghong";
    }

    c = "/obj/cloth/zhanpao";
    a = "/d/obj/armor/armor/jinjia";
  }

  set("class", "dragon");
  set("family/family_name", "东海龙宫");
  carry_object(wp)->wield();
  carry_object(a)->wear();
  carry_object(c)->wear();
}

void from_fighter(object owner,int lvl,int type,string quest_type)
{
