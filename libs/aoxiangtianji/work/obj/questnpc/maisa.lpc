//english.c 中亚人
#include <ansi.h>
inherit CHALLENGER;
void create()
{
  set_name("中亚人", ({ "maisa" }));
  set("long", "一个中亚人。\n");
  set("gender", "男性");
  set("age", 20);
  set("str", 40);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("spi", 20);
// the follow 5 setting has no use
  set("max_kee", 100);
  set("max_sen", 100);
  set("force", 100);
  set("max_force", 100);
  set("force_factor", 100);
  set("mana", 100);
  set("max_mana", 100);
  set("mana_factor", 100);
  set("combat_exp", 3000000);
  set("daoxing", 3000000);
  set("scale", 100);
  set_skill("force", 1);
  set_skill("zhongya-force", 1);
  set_skill("spells", 1);
  set_skill("zhongya-spells", 1);
  set_skill("dodge", 1);
  set_skill("zhongya-steps", 1);
  set_skill("parry", 1);
  set_skill("yuanyue-blade", 1);
  set_skill("blade", 1);
  map_skill("spells", "zhongya-spells");
  map_skill("blade", "yuanyue-blade");
  map_skill("force", "zhongya-force");
  map_skill("dodge", "zhongya-steps");
  map_skill("parry", "yuanyue-blade");
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
      (: exert_function, "powerup" :),
      (: exert_function, "recover" :),
      (: perform_action, "blade.chong" :),
      (: perform_action, "blade.juan" :),
  }));
  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/d/obj/weapon/blade/wandao")->wield();
}

string challenge()
{
  set("opinion/msg",
  ({
    (random(2) ? "中亚一带的武学颇为怪异，出招往往不落常套。"
               : "传说他们那里的勇士，刀法往往是出神入化。"),
    (random(2) ? "从如此遥远的地方远度而来，也真是够难为他的了！"
               : "嗯，弯刀虽利于劈砍，但是变化略少，近身作战有利。"),
    (random(2) ? "看此人的步伐沉稳，一定是招式毒辣有余，而灵便不够！"
               : "弯刀仞口十分锋利，重量不轻，杀伤力看来比较高，这可是要非常小心的啊。"),
  }));
  command(random(2) ? "haha" : "kick");
  switch (random(2))
  {
    case 0:
      return "我来自" + query("nation") + "，听说你们大唐"
             "武术高明，特地前来切磋切磋！";
    default:
      return "我是" + query("nation") + "的" + name() + "，大"
             "唐有谁愿意和我一较高低？";
  }

}

void unconcious()
{
  command("chat 啊！怎么……怎么这么厉害？");
  die();
}

void competition_with(object ob)
{
  command("say 太好了，我们就分个高低看看！\n");
  ::competition_with(ob);
}

void lost()
{
  string *ob_list = ({
      "/d/obj/combine/etc/va1",
      "/d/obj/combine/etc/va2",
      "/d/obj/combine/etc/va3",
      "/d/obj/combine/etc/va4",
      "/d/obj/combine/etc/va5",
      "/d/obj/combine/etc/va6",
  });
  object ob;
  ob = new(element_of(ob_list));
  message_vision(HIY "$N" HIY "身子一退，掉下一" + ob->query("unit") +
                 ob->name() + HIY "。\n\n" NOR, this_object());
  ob->move(environment());
  ::lost();
}