// tracenpc.c
#include <ansi.h>
#include <quest.h>
inherit "/obj/questnpc/tasknpc";
void create()
{
  mapping my;
  set_name("寻友","trace npc");
  set("age", 20);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("no_get", 1);
  set("no_bian", 1);
  set("no_find", 1);
  set("born_time", time());
  set("stay_time", 3600);
  my = query_entire_dbase();
  my["max_kee"] = 1000;
  my["eff_kee"] = my["max_kee"];
  my["kee"] = my["max_kee"];
  my["max_sen"] = 1000;
  my["eff_sen"] = my["max_sen"];
  my["sen"] = my["max_sen"];
  my["max_force"] = 1000;
  my["force"] = my["max_force"] * 2;
  my["max_mana"] = 1000;
  my["mana"] = my["max_mana"] * 2;
  setup();
}

varargs int move(mixed dest, int raw)
{
  int r;
// 执行原本的MOVE函数
  r = ::move(dest, raw);
  if (query_temp("trace"))
  {
    remove_call_out("give_intercession");
    call_out("give_intercession", 2);
  }

  return r;
}

// 判断是否有人需要调解
void give_intercession()
{
  object ob;
  object me;
  if (! query_temp("trace"))
    return;
  ob = query_temp("trace");
  ob = present(ob, environment(this_object()));
  if (! objectp(ob))
    return;
  if (environment(ob) != environment(this_object()))
    return;
  if (! living(ob))
    return;
  me = query_leader();
  message("vision", HIC + sort_msg(name() + "看见" + ob->name() +
                    HIC "，蓦地冲上前去，大叫道：“老天开眼啊，兄弟今"
                    "天终于寻到你了！”说罢只见两人拥在一起，热泪纵横"
                    "，场面煞是感人。\n" NOR), environment());
  if (objectp(me))
  {
    tell_object(me, HIY "\n你见两人此番状态，颇为感慨，不由得暗"
                        "自欣慰。\n\n" NOR);
    GIFT_D->delay_bonus(me, ([ "exp" : 200 + random(100),
                               "daoxing" : 150 + random(200),
                               "pot" : 200 + random(100),
                               "score"   : 20 + random(20),
                               "weiwang" : 10 + random(10),
                               "prompt"  : "通过这次助人寻友" ]),"freequest");
    CHANNEL_D->do_channel(this_object(), "rumor", "听说" + me->name(1) +
                                         "(" + me->query("id") + ")帮" +
                                         name() + HIM "找到了失散的兄弟"
                                         + ob->name() + HIM "。" NOR);
// 被列为门派中断的自由任务
    if (me->query("quest_xyj/freequest_need") > 0)
      GIFT_D->delay_freequest_bonus(me);
  }

  delete_temp("trace");
  set_leader(0);
  destruct(ob);
  destruct(this_object());
}

void unconcious()
{
  die();
}

void scan()
{
  object ob = this_object();
  ::scan();
  if ((time() - (int)query("born_time")) > query("stay_time") &&
      ! is_fighting() && living(ob))
  {
    message_vision("$N急急忙忙的走了。\n", ob);
    destruct(this_object());
    return;
  }

  return;
}

