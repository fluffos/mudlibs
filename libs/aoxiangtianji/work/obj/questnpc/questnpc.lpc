#include <ansi.h>
inherit "/obj/questnpc/tasknpc";
void create()
{
  mapping my;
  set_name("自由任务","freequest npc");
  set("age", 20);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("no_get", 1);
  set("no_bian", 1);
  set("no_find", 1);
  set("born_time", time());
  set("stay_time", 3600);
  my = query_entire_dbase();
  my["max_kee"] = 1000;
  my["eff_kee"] = my["max_kee"];
  my["kee"] = my["max_kee"];
  my["max_sen"] = 1000;
  my["eff_sen"] = my["max_sen"];
  my["sen"] = my["max_sen"];
  my["max_force"] = 1000;
  my["force"] = my["max_force"] * 2;
  my["max_mana"] = 1000;
  my["mana"] = my["max_mana"] * 2;
  setup();
}

int accept_fight(object ob)
{
  command("say 嗯？你是什么人？我没有兴趣和你较量。");
  return 0;
}

int accept_kill(object ob)
{
  command("say 岂有此理！居然欺负到我的头上了！");
  command("exert powerup");
  return 1;
}

void remove(string euid)
{
  if (! environment() || query_temp("die"))
  {
    ::remove(euid);
    return;
  }

  if (! living(this_object()))
  {
    message_vision("路过两个人，看到昏迷不醒的$N"
                   "，叹口气，把$P架走了。\n",
                   this_object());
    return;
  }

  message_vision("$N看了看四周，急急忙忙的走了。\n", this_object());
  ::remove(euid);
}

void die(object killer)
{
  set_temp("die", 1);
  ::die(killer);
}

void scan()
{
  object ob = this_object();
  ::scan();
  if ((time() - (int)query("born_time")) > query("stay_time") &&
      ! is_fighting() && living(ob))
  {
    message_vision("$N急急忙忙的走了。\n", ob);
    destruct(this_object());
    return;
  }

  return;
}

