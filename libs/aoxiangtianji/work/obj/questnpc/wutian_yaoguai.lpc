#include <ansi.h>
inherit "/obj/questnpc/tasknpc";
void create()
{
  int i;
  ::create();
  set_name("妖怪","xue yaoguai");

  i = random(500);
  if(i<200)
  {
    set("type","aggressive");
  }

  else if(i<400)
  {
    set("type","blocker");
  }

  else
    set("type","normal");

  setup();
  if (clonep())
    keep_heart_beat();
}

void init()
{
  object me=this_object();
  object who=this_player();
  string type;
  ::init();

  if(!playerp(who) || who->query("level") < 28)
    return;
  if(!living(me))
    return;

  type=query("type");
  switch (type)
  {
    case "aggressive" :
    {
      message_vision("$N盯着$n，馋得直流口水：嘿嘿．．．\n", me, who);
      kill_ob(who);
      break;
    }

    case "blocker":
    {
      add_action("do_block","",1);
      break;
    }

  }

}

int do_block(string arg)
{
  object me=this_object();
  object who=this_player();
  string verb=query_verb();
  int t;

  if(wizardp(who) && !visible(who))
    return 0;
  if(me->is_fighting())
    return 0;
  if(verb!="go" &&
     verb!="fly" &&
     !(environment() && environment()->query("exits/" + verb)))
    return 0;
  if(who->query_temp("mieyao/allow_to_go"))
  {
    who->delete_temp("mieyao/allow_to_go");
    who->delete_temp("mieyao/leave_time");
    return 0;
  }

  t=who->query_temp("mieyao/leave_time");
  if(t>0 && time()>t)
  {
    who->delete_temp("mieyao/leave_time");
    message_vision("$n乘$N一个不注意，急忙溜了过去。\n",me,who);
    return 0;
  }

  if(t==0)
  {
    t=time()+30+random(90);
    who->set_temp("mieyao/leave_time",t);
    message_vision("$N猛地跳过来拦在$n面前，高声叫道：\n哈哈，来了一个！给我站住！！\n\n",me,who);
  }

  tell_object(who,me->name()+"一把抓住了你！\n");
  return 1;
}

void die()
{
  object dob;

  dob = query_last_damage_from();
  if (objectp(dob) && dob->query_temp("owner"))
    dob = dob->query_temp("owner");

  message_vision("$N惨叫一声，死了。\n",this_object());
  if (objectp(dob))
  {
    dob->add("quest_info/wutian/total_num",1);
    GIFT_D->delay_bonus(dob, ([ "exp"     : query("level")*5 + 50+random(100)  ,
                                "pot"     : 50 + random(100) ,
                                "prompt"  : "击毙" + name() + "之后" ]), "wutian");
  }

  destruct(this_object());
  return;
}

void scan()
{
  object ob = this_object();
  ::scan();
  if ((time() - (int)query("born_time")) > query("stay_time") &&
      ! is_fighting() && living(ob))
  {
    message_vision("$N急急忙忙的走了。\n", ob);
    destruct(this_object());
    return;
  }

  return;
}

