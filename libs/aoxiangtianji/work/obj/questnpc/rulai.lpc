#include <ansi.h>
inherit "/obj/questnpc/tasknpc";
void create()
{
  ::create();
  set_name("妖怪","rulai yaoguai");
  setup();
  if (clonep())
    keep_heart_beat();
}

void init()
{
  object ob, me, where;
  int mylvl;
  string msg;
  ob = this_player();
  me = this_object();
  where = environment(ob);
  mylvl = ob->query("level");
  add_action("do_persuade", ({"persuade","quan"}));
  ::init();

  if (playerp(ob)
    && me->query("quester") == ob->query("id")
    && !where->is_safty()
    && ob->query("quest_xyj/rulai/npc_id") == me->query("id")
    && stringp(ob->query("quest_xyj/rulai/type"))
    && !me->query("see_player"))
  {
    switch ((string)ob->query("quest_xyj/rulai/type"))
    {
      case "kill" :
        switch (random(10))
        {
          case 0 :
            msg = RED"\n$n" YEL"一眼看到$N" YEL"正往这里赶来，不由得嘿嘿冷笑数声。\n"NOR;
            msg += RED"$n" YEL"喝道：你千辛万苦的追踪而来，不就是为了决一死战吗？\n"NOR;
            message_vision(msg,ob,me);
            kill_ob(ob);
            break;
          case 1 :
          case 2 :
          case 3 :
          case 4 :
            msg = HIG"\n$n" HIW"看到$N" HIW"飞奔而来，不由得有些心虚！\n"NOR;
            msg += HIG"$n" HIW"知道避无可避，只得迎了上去，赔笑道：\n"NOR;
            msg += HIM + RANK_D->query_respect(ob) + HIW "远道而来，辛苦辛苦，不知所为何事！\n"NOR;
            message_vision(msg,ob,me);
            break;
          case 5 :
          case 6 :
            msg = CYN"\n$n" HIB"眼见$N" HIB"越来越近，看看无法避免，不由得横下心来！\n"NOR;
            msg += HIG"$n" HIW"站立路中央，摆开架势，一声大喝：\n"NOR;
            msg += HIM + RANK_D->query_respect(ob) + HIW "一路风尘，某家在此等候多时了！\n"NOR;
            message_vision(msg,ob,me);
            me->set_leader(ob);
            break;
          default :
            msg = HIB"\n$n" HIW"嘿嘿奸笑数声，迎着$N" HIW"来到$P的面前！\n"NOR;
            msg += HIB"$n" HIW"赔笑道：\n"NOR;
            msg += HIM + RANK_D->query_respect(ob) + HIW "为我而来，却不知我也是为人所害啊！\n"NOR;
            msg += HIB"$n" HIW"继续道：还望明查，速速回报给佛祖！\n"NOR;
            message_vision(msg,ob,me);
        }

        break;
      case "capture" :
        if (me->query("no_get"))
          me->delete("no_get");
        switch(random(10))
        {
          case 0 :
            msg = RED"\n$n" YEL"看到$N" YEL"，不由得大怒：千里追踪，当我怕了你？\n"NOR;
            msg += YEL"怒喝声中，" RED"$n" YEL"向$N直冲了过去！简直是要拼命了！！\n"NOR;
            message_vision(msg,ob,me);
            kill_ob(ob);
            break;
          case 1 :
          case 2 :
          case 3 :
            msg = HIB"\n$n" HIY"看到$N" HIY"追奔而来，嘿嘿冷笑道：\n"NOR;
            msg += HIY"既然你一再逼迫，某家就在这里等你了。看你有何本事抓了某家！\n\n"NOR;
            message_vision(msg,ob,me);
            me->set_leader(ob);
            break;
          default :
            msg = HIB"\n$n" HIY"看到$N" HIY"正冷冷的瞧着自己，嘿嘿奸笑几声，上前道：\n"NOR;
            msg += HIY"这位" + HIM + RANK_D->query_respect(ob) + HIY"是佛祖差遣而来吗？\n"NOR;
            msg += HIY"还请高抬贵手，彼此都好！\n\n"NOR;
            message_vision(msg,ob,me);
        }

        break;
      case "persuade" :
        switch(random(3))
        {
          case 0 :
            msg = RED"\n$n" YEL"一眼看到$N" YEL"正盯着自己，不由得笑了！\n"NOR;
            msg += RED"$n" YEL"对$N" YEL"说道：\n"NOR;
            msg += YEL"我正要挑战天下，没有时间听" + HIM + RANK_D->query_respect(ob) +
                   YEL"唠叨，还请见谅！\n"NOR;
            message_vision(msg,ob,me);
            break;
          case 1 :
            msg = HIB"\n$n" HIY"看到$N" HIY"走了过来，冷笑道：\n"NOR;
            msg += HIY"天下的奇人异士某家都想领教领教，希望"HIM + RANK_D->query_respect(ob) +
                   HIY"不是来唱歌给我听的！\n"NOR;
            message_vision(msg,ob,me);
            break;
          default :
            msg = HIB"\n$n" HIY"看到$N" HIY"瞧着自己，不由得停下脚步：\n"NOR;
            msg += HIY"听说佛祖差遣" + HIM + RANK_D->query_respect(ob) + HIY"前来和我较量！\n"NOR;
            msg += HIY"就让我们来比划比划吧！\n\n"NOR;
            message_vision(msg,ob,me);
        }

        break;
      default :
        switch(random(3))
        {
          case 0 :
            msg = RED"\n$n" YEL"对着$N" YEL"高声喝叫道：\n"NOR;
            msg += YEL"某家在此等候多时了！有本事就来！！\n" NOR;
            message_vision(msg,ob,me);
            break;
          case 1 :
            msg = HIB"\n$n" HIY"冲着$N" HIY"哈哈笑道：\n"NOR;
            msg += HIY"这天下是拳头大的说话算！让我们先打上一架再说！\n"NOR;
            message_vision(msg,ob,me);
            break;
          default :
            msg = HIB"\n$n" HIY"对$N" HIY"勾了勾小手指：\n"NOR;
            msg += HIY"佛祖不是差遣你来拿我吗？我就在这等你，嘿嘿，看看有何本事如此嚣张！！\n"NOR;
            message_vision(msg,ob,me);
        }

        break;
    }

    me->set("see_player",1);
  }

}

void full_me(object me)
{
  me->set("kee",me->query("max_kee"));
  me->set("eff_kee",me->query("max_kee"));
  me->set("sen",me->query("max_sen"));
  me->set("eff_sen",me->query("max_sen"));
  me->set("force",me->query("max_force"))*2;
  me->set("mana",me->query("max_mana"))*2;
  me->clear_condition(0);
  return;
}

void reward(object who)
{
  object weapon;
  int count, mylvl, exp, qn, weiwang,score, t;
  string q_type;

  mylvl = (int)who->query("level");
  count = who->query("quest_info/rulai/count");
  count++;
  exp = 0;
  t = time() - who->query_temp("quest_xyj/last_rulai_time");
  who->add("quest_info/rulai/total_num",1);
  q_type = (string)who->query("quest_xyj/rulai/type");
  if (q_type == "kill")
  {
    q_type = "用时" + XYJTIME_D->query_time(t) + "，击毙";
    exp = count + mylvl*8 + 120;
    who->add_temp("rulai/kill",1);
  }

  else if (q_type == "persuade")
  {
    q_type = "用时" + XYJTIME_D->query_time(t) + "，劝服";
    exp = count + mylvl*8 + 250;
    who->add_temp("rulai/persuade",1);
  }

  else if (q_type == "defeat")
  {
    q_type = "用时" + XYJTIME_D->query_time(t) + "，降服";
    exp = count + mylvl*8 + 280;
    who->add_temp("rulai/defeat",1);
  }

  exp += exp*((int)who->query("quest_xyj/rulai/level"))/2;
//  exp = exp/2 + random(exp + 1);
  if (count > 800)
    count = 0;
  who->set("quest_info/rulai/count",count);
  who->add("balance",(mylvl+1)*2500 + random(5000));
  qn = exp/4 + random(exp/3 + 1);
  weiwang = 3+random(5);
  score = 4 + random(5);

  GIFT_D->delay_bonus(who, ([ "exp"     : random(1 + exp/3),
                              "daoxing" : exp,
                              "pot"     : qn ,
                              "mar"     : random(1 + qn/3*2),
                              "weiwang" : weiwang,
                              "score"   : score,
                              "prompt"  : q_type + name() + "之后" ]), "rulai");
  if (weapon = who->query_temp("weapon") ||
      weapon = who->query_temp("armor/hands"))
    weapon->killer_reward(who, this_object());
  who->delete("quest_xyj/rulai");
  who->set_temp("rulai_zuochan",1);
  if (SYSQ_D->quest_exist(who,"rulai"))
    SYSQ_D->delete_quest("rulai",who);
  destruct(this_object());
  return;
}

void die(object killer)
{
  object dob, weapon;
  object me;
  string quester, msg;

  me = this_object();
  quester = me->query("quester");
  if (stringp(quester) && objectp(dob = find_player(quester)))
    dob->set("quest_xyj/rulai/npc_die",1);

  if (!me->query_temp("my_killer"))
  {
    message_vision("$N一看不是对手，急急忙忙的溜了。\n", me);
    if (SYSQ_D->quest_exist(dob,"rulai"))
      SYSQ_D->delete_quest("rulai",dob);
    destruct(me);
    return;
  }

  if (! objectp(dob = killer))
    dob = me->query_last_damage_from();
  if (objectp(dob) && dob->query_temp("owner"))
    dob = dob->query_temp("owner");
  if (dob && dob->query("quest_xyj/rulai/npc_id") != query("id"))
  {
    CHANNEL_D->do_channel(this_object(), "rumor",
                          sprintf("听说%s被人杀死了。", name()));
    log_file("static/killed_die", sprintf("%s %s(%s) died at %s because %s.\n",
           ctime(time()),
           name(),
           query("id"),
           environment()->short(),
           dob ? sprintf("%s(%s)", dob->name(1), dob->query("id")) : "none"));
    destruct(this_object());
    if (SYSQ_D->quest_exist(quester,"rulai"))
      SYSQ_D->delete_quest("rulai",quester);
    return;
  }

  if (quester != dob->query("id"))
  {
    message_vision("$N一看不是对手，急急忙忙的溜了。\n", me);
    if (SYSQ_D->quest_exist(quester,"rulai"))
      SYSQ_D->delete_quest("rulai",quester);
    destruct(me);
    return;
  }

  if ((string)dob->query("quest_xyj/rulai/type") != "kill")
  {
    ::die(dob);
    return;
  }

  msg = HIW"$N" HIW"惨叫一声，死了！"NOR;
  msg += HIW"$n" HIW"上前仔细查看了一番，点了点头。\n"NOR;
  message_vision(msg,me,dob);
  if (weapon = dob->query_temp("weapon") ||
    weapon = dob->query_temp("armor/hands"))
  weapon->killer_reward(dob, this_object());
  reward(dob);
  return;
}

int accept_fight(object ob)
{
  string q_type;
  object me=this_object();
  if (!playerp(ob)
    || me->query("quester") != ob->query("id")
    || ob->query("quest_xyj/rulai/npc_id") != me->query("id"))
  {
    message_vision(CYN"$N" CYN"说道：快走开，我正要赶路呢。\n"NOR,me);
    return 0;
  }

  q_type = (string)ob->query("quest_xyj/rulai/type");
  if ( !stringp(q_type) ||
       q_type == "kill" ||
       q_type == "capture" ||
       q_type == "persuade")
  {
    command("say 我不找你，你倒送上门来了，我就成全了你。");
    me->kill_ob(ob);
    return 1;
  }

  if ( query("eff_kee") < query("max_kee")
    || query("eff_sen") < query("max_sen") )
  {
    message_vision(CYN"$N说道：我受伤了，这样打不公平吧。\n"NOR,me);
    return 0;
  }

  set_temp("my_killer",ob);
  command("say 废话少说，尽管放马过来，看谁怕谁。");
  command("exert powerup");
  command("enforce max");
  remove_call_out("check_result");
  call_out("check_result", 1, me, ob);
  return 1;
}

int check_result(object me, object ob)
{
  int guai_max_kee, ob_max_kee;
  guai_max_kee  = me->query("max_kee");
  ob_max_kee = ob->query("max_kee");

  if (me->is_fighting())
  {
    call_out("check_result",1, me, ob);
    return 1;
  }

  if ( !living(me)
    || (int)me->query("kee") < 1
    || (int)me->query("sen") < 1 )
    return 1;

  if (((int)me->query("kee")*100/guai_max_kee) <= 50 )
  {
    if ( !living(me)
       || (int)me->query("kee") < 1
       || (int)me->query("sen") < 1 )
      return 1;

    if (random(3) < 1)
      command ("say 我还没准备好，你就开打了，不算数。");
    else
    {
      if (ob->query_temp("rulaitask/fight_time"))
      {
        command ("say 我现在方知天外有天，人外有人，我还要回山多多修炼，告辞了。");
        reward(ob);
        return 1;
      }

      else
      {
        command ("say 我一时大意，也没尽全力，我不服，再比一次。");
        ob->set_temp("rulaitask/fight_time",1);
        return 1;
      }

    }

  }

  else
  {
    command("say 哈哈，你输了，我天下无敌。");
    return 1;
  }

}

int accept_kill(object ob)
{
  if (ob->query("quest_xyj/rulai/npc_id") != query("id"))
  {
    delete_temp("my_killer");
    ::kill_ob(ob);
    return 1;
  }

  if (!query_temp("my_killer"))
    full_me(this_object());
  set_temp("my_killer",ob);
  command("enforce max");
  kill_ob(ob);
  return 1;
}

int do_persuade(string arg)
{
  object me =this_player();
  object ob = this_object();
  int guai_max_kee,guai_eff_kee;

  if (!me || !playerp(me) || !ob || environment(ob) != environment(me))
    return 0;
  if(!arg || !ob->id(arg))
    return 0;
  if ((string)me->query("quest_xyj/rulai/type") != "persuade")
  {
    command("pei");
    ::kill_ob(ob);
    return 1;
  }

  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");

  me->command("say 放下屠刀，立地成佛。");

  if ( !living(ob) )
    return notify_fail("很显然，"+ob->name()+"听不见你说的话。\n");
  if (ob->query("quester") != me->query("id")
    || me->query("quest_xyj/rulai/npc_id") != ob->query("id")
    || !ob->is_fighting(me))
  {
    message_vision(CYN"$N" CYN"说道：你罗嗦些什么，快滚开。\n"NOR,ob);
    return 1;
  }

  guai_max_kee = ob->query("max_kee");
  guai_eff_kee = ob->query("eff_kee");

  if ( guai_eff_kee*100/guai_max_kee < 15 )
  {
    command("say 你说的有道理，我这就回山去。");
    reward(me);
    return 1;
  }

  if (guai_eff_kee*100/guai_max_kee < 20 )
  {
    command("say 你看我现在，不比做佛快乐吗。");
    me->start_busy(1+random(3));
    return 1;
  }

  else
  {
    me->start_busy(3);
    return notify_fail(ob->name()+"正专心致志战斗，懒得理你。\n");
  }

}

int accept_object (object who, object ob)
{
  object guai;
  guai = this_object();

  if ( (ob->query("name") != "金创药" || ob->query("id") != "jinchuang yao") &&
       (ob->query("name") != "混元丹" || ob->query("id") != "hunyuan dan"))
  {
    message_vision(CYN"$N说道：这是什么玩意儿，想毒死我啊。\n"NOR,guai);
    return 0;
  }

  else
  {
    guai->receive_curing("kee", 100);
    guai->receive_curing("sen", 100);
    command("exert recover");
    if ( query("eff_kee") == query("max_kee") )
      message_vision(CYN"$N说道：我好了，来来来，咱们再大战三百回合。\n"NOR,guai);
    return 1;
  }

}

// remove
void remove(string euid)
{
  object qob;
  if (objectp(qob = query_temp("quest_ob")))  // 这个人已经消失了，取消相关联的任务
    destruct(qob);
  ::remove(euid);
}

void scan()
{
  object ob = this_object();
  ::scan();
  if ((time() - (int)query("born_time")) > query("stay_time") &&
      ! is_fighting() && living(ob))
  {
    message_vision("$N急急忙忙的走了。\n", ob);
    CHANNEL_D->do_channel(ob, "rumor",
             sprintf("听说%s隐居到了深山老泽，从此不再出没在世间。", name()));
    log_file("static/killed_die", sprintf("%s %s(%s) vanished because timeout(%d:%d).\n",
             log_time(), name(), query("id"), time() - query("born_time"),
             query("stay_time")));
    SYSQ_D->delete_quest(ob->query("quest_type"),ob->query("quester"));
    destruct(this_object());
    return;
  }

  return;
}

