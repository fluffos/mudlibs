// japanese.c 日本鬼子
inherit CHALLENGER;
string *ob_list = ({
      "/d/obj/gift/str1",
      "/d/obj/gift/int1",
      "/d/obj/gift/con1",
      "/d/obj/gift/dex1",
      "/d/obj/gift/spi1",
      "/d/obj/combine/item/zijin",
      "/d/obj/combine/item/wujin",
});
void create()
{
  object ob;
  set_name("日本鬼子", ({ "japanese" }));
  set("long", "日本鬼子。\n");
  set("gender", "男性");
  set("age", 20);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("spi", 20);
  set("max_kee", 100);
  set("max_sen", 100);
  set("force", 100);
  set("max_force", 100);
  set("force_factor", 100);
  set("mana", 100);
  set("max_mana", 100);
  set("mana_factor", 100);
  set("combat_exp", 3000000);
  set("daoxing", 3000000);
  set("scale", 100);
  set_skill("force", 1);
  set_skill("fushang-force", 1);
  set_skill("spells", 1);
  set_skill("fushang-spells", 1);
  set_skill("dodge", 1);
  set_skill("renshu", 1);
  set_skill("parry", 1);
  set_skill("dongyang-blade", 1);
  set_skill("blade", 1);
  map_skill("blade", "dongyang-blade");
  map_skill("spells","fushang-spells");
  map_skill("force", "fushang-force");
  map_skill("dodge", "renshu");
  map_skill("parry", "dongyang-dao");
  set("rank_info/rude", "鬼子");
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
      (: exert_function, "powerup" :),
      (: exert_function, "recover" :),
      (: perform_action, "blade.luan" :),
      (: perform_action, "blade.zhan" :),
  }));
  setup();
  carry_object("/obj/cloth/zhanpao")->wear();
  carry_object("/d/obj/armor/armor/tiejia")->wear();
  carry_object("/d/obj/weapon/blade/jpn-dao")->wield();
  ob = new(element_of(ob_list));
  ob->move(this_object());
}

string challenge()
{
  set("opinion/msg", ({
    (random(2) ? "此人来自东洋扶桑，据说那里的东洋刀法极其怪异。"
               : "东洋扶桑远在东海之外，那里的武士擅长使用窄刃长刀。"),
    (random(2) ? "是啊，东洋忍术也是诡秘得很。"
               : "没错，不过东洋刀造型奇特，配合忍术还是颇有威力。"),
    (random(2) ? "哼！此人气焰如此嚣张，实为习武者大忌！"
               : "此人可谓鼠目寸光，须知武道无穷，一丝也马虎不得！"),
  }));
  command(random(2) ? "haha" : "heng");
  switch (random(3))
  {
    case 0:
      return "我！大和武士" + name() + "，来向你们大唐"
             "武人挑战！谁敢出来迎战？";
    case 1:
      return "我就是东洋扶桑国的" + name() + "，你们大"
             "唐有没有人是我的对手？";
    default:
      return "我" + name() + "代表大和武士来向你们挑战"
             "，有种的就给我滚出来！";
  }

}

void unconcious()
{
  command("chat 八格呀路！");
  die();
}

void competition_with(object ob)
{
  command("say 八格呀路，你死去吧！\n");
  ::competition_with(ob);
  kill_ob(ob);
}