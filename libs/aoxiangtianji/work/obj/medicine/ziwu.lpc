// ziwu.c
// 100 + 150 + 80 + 50 + 150 + 50 = 580
#include <ansi.h>
#include "medicine.h"
void create()
{
  set_name(CYN "子午灵" NOR, ({"ziwu ling", "yao"}));
  set("family","陷空山无底洞");
  if (clonep())
     set_default_object(__FILE__);
  else
  {
    set("long", CYN "这是一粒暗褐色的丹药，疗伤效果还不错。\n" NOR);
    set("base_unit", "粒");
    set("base_value", 5000);
    set("base_weight", 50);
    set("only_do_effect", 1);
    set("mixture", ([
          "herb" : ([ "danggui" : 1,
                      "hafen"   : 1,
                      "moyao"   : 1,
                      "shengdi" : 1,
                      "tianqi"  : 1,
                      "zihua"   : 1, ]),
          "force" : 70,
          "sen"  : 25,
          "time"  : 1,
          "min_level" : 50,
          "medical" : 80,
    ]));
  }

  setup();
}

int do_effect(object me)
{
  mapping my;
  int num = 4;
  if (!present(this_object(),me))
    return notify_fail("药并不在你身上！\n");
  my = me->query_entire_dbase();
  if (my["eff_kee"] == my["max_kee"])
  {
    write("你现在并没有受伤，不必服用" + name() + "。\n");
    return 1;
  }

  message_vision(CYN "$N" CYN "张开嘴，猛地吞下了" + name() +
                 CYN "，轻轻的哼了一声。\n" NOR, me);
  if (this_object()->query("owner") != me->query("id"))
    num += 1;

  if (query("family") != me->query("family/family_name"))
    num += 1;
  me->receive_curing("kee", me->query("max_kee")/4);
  me->receive_heal("kee", me->query("max_kee")/4);
  if (num > 4 && me->is_fighting() && !me->is_busy())
    me->start_busy(1);
  add_amount(-1);
  if (query_amount() < 1)
    destruct(this_object());
  return 1;
}

