// jiuhua.c
#include <ansi.h>
#include "medicine.h"
void create()
{
  set_name(WHT "六合返精散" NOR, ({"liuhe san", "san"}));
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", WHT "这是一小包白色的粉末，具有镇定养精的效果。\n" NOR);
    set("base_unit", "包");
    set("base_value", 5000);
    set("base_weight", 40);
    set("only_do_effect", 1);
    set("mixture", ([
             "herb" : ([ "chuanwu"  : 1,
                         "tianqi"   : 1,
                         "niuhuang" : 1,
                         "shanjia"  : 1,
                         "shancha"  : 1,
                         "gsliu"    : 1, ]),
              "force" : 80,
              "sen"  : 35,
              "time"  : 1,
              "min_level" : 50,
              "medical" : 80,
    ]));
  }

  setup();
}

int do_effect(object me)
{
  mapping my;
  int num = 4;
  if (!present(this_object(),me))
    return notify_fail("药并不在你身上！\n");
  my = me->query_entire_dbase();
  if (my["eff_sen"] == my["max_sen"])
  {
    write("你现在精神状态很好，无需服用" + name() + "。\n");
    return 1;
  }

  message_vision(HIW "$N" HIW "一张嘴，吞下了" + name() +
                 HIW "，看上去精神好多了。\n" NOR, me);
  if (query("owner") != me->query("id"))
    num += 1;

  me->receive_curing("sen", me->query("max_sen")/num);
  me->receive_heal("sen", me->query("max_sen")/num);
  if (!me->is_busy() && num > 4 && me->is_fighting())
    me->start_busy(1);
  add_amount(-1);
  if (query_amount() < 1)
    destruct(this_object());
  return 1;
}

