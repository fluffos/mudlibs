// tongmai.c
#include <ansi.h>
#include "medicine.h"
void create()
{
  set_name(WHT "贯气通脉丹" NOR, ({"tongmai dan", "dan"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else
  {
    set("long", WHT "这是一粒药丸，看上去银光闪闪，实是效果极佳疗伤"
                    "圣药。\n" NOR);
    set("base_unit", "粒");
    set("base_value", 18000);
    set("base_weight", 85);
    set("only_do_effect", 1);
    set("mixture", ([
             "herb" : ([ "chuanwu"  : 1,
                         "honghua"  : 1,
                         "danggui"  : 1,
                         "chenpi"   : 1,
                         "moyao"    : 1,
                         "shengdi"  : 1,
                         "yjhua"    : 1,
                         "heshouwu" : 1,
                         "xionghuang" : 1, ]),
             "force" : 150,
             "sen"  : 40,
             "time"  : 5,
             "min_level" : 120,
             "medical" : 150,
    ]));
  }

  setup();
}

int do_effect(object me)
{
  mapping my;
  if (!present(this_object(),me))
    return notify_fail("药并不在你身上！\n");
  my = me->query_entire_dbase();
  if (my["eff_kee"] == my["max_kee"])
  {
    write("你现在并没有受伤，不必服用" + name() + "。\n");
    return 1;
  }

  message_vision(WHT "$N" WHT "把" + name() +
                 WHT "咕咚一声吞下了肚，立刻气色看起来好多了。\n" NOR, me);
  me->receive_curing("kee", me->query("max_kee"));
  me->receive_heal("kee", me->query("max_kee"));
  if (!me->is_busy() && query("owner") != me->query("id") && me->is_fighting())
    me->start_busy(1);
  add_amount(-1);
  if (query_amount() < 1)
    destruct(this_object());
  return 1;
}

