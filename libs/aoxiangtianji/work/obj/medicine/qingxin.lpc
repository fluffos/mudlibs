// qingxin.c
#include <ansi.h>
#include "medicine.h"
void create()
{
  set_name(HIG "清心定神散" NOR, ({"qingxin san", "san"}));
  set_weight(50);
  if (clonep())
     set_default_object(__FILE__);
  else
  {
    set("long", HIG "这是一包淡绿色的粉末，具有非常不错的镇定效果。\n" NOR);
    set("base_unit", "包");
    set("base_value", 5500);
    set("base_weight", 60);
    set("only_do_effect", 1);
    set("mixture", ([
           "herb" : ([ "chaihu"  : 1,
                       "xuejie"   : 1,
                       "yjhua"    : 1,
                       "ruxiang"  : 1,
                       "shanjia"  : 1,
                       "gsliu"    : 1,
                       "shenglg"  : 1, ]),
           "force" : 100,
           "sen"  : 50,
           "time"  : 3,
           "min_level" : 80,
           "medical" : 100,
    ]));
  }

  setup();
}

int do_effect(object me)
{
  mapping my;
  int num = 4;
  if (!present(this_object(),me))
    return notify_fail("药并不在你身上！\n");
  my = me->query_entire_dbase();
  if (my["eff_sen"] == my["max_sen"])
  {
    write("你现在精神状态很好，无需服用" + name() + "。\n");
    return 1;
  }

  message_vision(HIG "$N" HIG "一张嘴，吞下了" + name() +
                 HIG "，看上去精神好多了。\n" NOR, me);
  if (query("owner") != me->query("id"))
    num += 1;

  me->receive_curing("sen", me->query("max_sen")/num);
  me->receive_heal("sen", me->query("max_sen")/num);

  if (!me->is_busy() && num > 4 && me->is_fighting())
    me->start_busy(1);
  add_amount(-1);
  if (query_amount() < 1)
    destruct(this_object());
  return 1;
}

