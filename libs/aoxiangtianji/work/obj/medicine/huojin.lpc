// huojin.c
// 80 + 80 + 100 + 150 + 80 + 50 + 150 +150 = 840
#include <ansi.h>
#include "medicine.h"
void create()
{
  set_name(MAG "活筋舒血丸" NOR, ({"huojin wan", "wan"}));
  if (clonep())
     set_default_object(__FILE__);
  else
  {
    set("long", MAG "这是一粒药丸，呈现出淡淡的粉色，疗伤效果颇为不错。\n" NOR);
    set("base_unit", "粒");
    set("base_value", 6000);
    set("base_weight", 60);
    set("only_do_effect", 1);
    set("mixture", ([
            "herb" : ([ "chuanwu"  : 1,
                        "honghua"  : 1,
                        "danggui"  : 1,
                        "lingxian" : 1,
                        "moyao"    : 1,
                        "shengdi"  : 1,
                        "taoxian"  : 1,
                        "tianqi"   : 1, ]),
            "force" : 80,
            "sen"  : 30,
            "time"  : 3,
            "min_level" : 80,
            "medical" : 100,
    ]));
  }

  setup();
}

int do_effect(object me)
{
  mapping my;
  int num = 3;
  if (!present(this_object(),me))
    return notify_fail("药并不在你身上！\n");
  my = me->query_entire_dbase();
  if (my["eff_kee"] == my["max_kee"])
  {
    write("你现在并没有受伤，不必服用" + name() + "。\n");
    return 1;
  }

  message_vision(MAG "$N" MAG "小心的吞下了" + name() +
                 MAG "，运了两口气，脸色看起来好多了。\n" NOR, me);
  if (query("owner") != me->query("id"))
    num += 1;
  me->receive_curing("kee", me->query("max_sen")/num);
  me->receive_heal("kee", me->query("max_sen")/num);
  if (!me->is_busy() && num > 3 && me->is_fighting())
    me->start_busy(1);
  add_amount(-1);
  if (query_amount() < 1)
    destruct(this_object());
  return 1;
}

