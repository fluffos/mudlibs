// sanjin.c
// 80 + 100 + 100 + 180 + 50 + 90 = 600
#include <ansi.h>
#include "medicine.h"
void create()
{
  set_name(CYN "三金散" NOR, ({"sanjin shan", "shan"}));
  set("family","方寸山三星洞");
  if (clonep())
     set_default_object(__FILE__);
  else
  {
    set("long", CYN "这是一包疗伤的药品。\n" NOR);
    set("base_unit", "包");
    set("base_value", 5500);
    set("base_weight", 50);
    set("only_do_effect", 1);
    set("mixture", ([
          "herb" : ([ "chuanwu"  : 1,
                      "fuzi"     : 1,
                      "mahuang"  : 1,
                      "niuhuang" : 1,
                      "xuejie"   : 1,
                      "yuanzhi"  : 1, ]),
          "force" : 70,
          "sen"  : 25,
          "time"  : 1,
          "min_level" : 50,
          "medical" : 80,
    ]));
  }

  setup();
}

int do_effect(object me)
{
  mapping my;
  int num = 5;
  if (!present(this_object(),me))
    return notify_fail("药并不在你身上！\n");
  my = me->query_entire_dbase();
  if (my["eff_sen"] >= my["max_sen"] && my["eff_kee"] >= my["max_kee"])
  {
    write("你现在并没有受伤，不必服用" + name() + "。\n");
    return 1;
  }

  message_vision(CYN "$N" CYN "张开嘴，猛地吞下了" + name() +
                 CYN "，轻轻的哼了一声。\n" NOR, me);
  if (this_object()->query("owner") != me->query("id"))
    num += 1;

  if (query("family") != me->query("family/family_name"))
    num += 1;
  me->receive_curing("sen", me->query("max_sen")/num);
  me->receive_heal("sen", me->query("max_sen")/num);
  me->receive_curing("kee", me->query("max_sen")/num);
  me->receive_heal("kee", me->query("max_sen")/num);
  if (num > 5 && me->is_fighting() && !me->is_busy())
    me->start_busy(1);
  add_amount(-1);
  if (query_amount() < 1)
    destruct(this_object());
  return 1;
}

