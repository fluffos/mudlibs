varargs void generate_animal_name(object ob,string p_n, string s_n)
{
  string *kc, *kl, *km, *kn;
  string n_a,n_b,n_c,n_d;
  string e_a,e_b,e_c,e_d;
  string temp_name, *temp_id;
  kc = keys(color_list);
  km = keys(middle_list);
  kl = keys(animal_list);
  kn = keys(animal_names);

  n_a = element_of(kc);
  n_b = element_of(km);
  n_c = element_of(kl);
  n_d = element_of(kn);

  e_a = color_list[n_a];
  e_b = middle_list[n_b];
  e_c = animal_list[n_c];
  e_d = animal_names[n_d];

  if (random(3) == 1)
  {
     temp_name = n_a + n_b + n_c;
    if(random(2))
    {
      temp_name += "精" ;
      temp_id = ({e_a + e_b + " " + e_c + " jing",
                  e_c + " jing",
                  "jing"});
    }

    else
    {
      temp_name += "怪";
      temp_id = ({e_a + e_b + " " + e_c + " guai",
                  e_c + " guai",
                  "guai"});
    }

  }

  else
  { temp_name = n_a + n_b + n_d;
    if(random(2))
    {
      temp_name += "精" ;
      temp_id = ({ e_a + e_b + " " +e_d + " jing",
                   e_d + " jing",
                   "jing"});
    }

    else
    {
      temp_name += "怪";
      temp_id = ({e_a + e_b + " " +e_d + " guai",
                  e_d + " guai",
                  "guai"});
    }

  }

  if (stringp(p_n))
    temp_name = p_n + " " + temp_name;
  if (stringp(s_n))
    temp_name += " " + s_n;
  if (objectp(ob))
    ob->set_name(temp_name, temp_id);
}