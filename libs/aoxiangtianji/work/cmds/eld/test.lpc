void process_file(string file_path) {
    string content;
	int pos;

    content = read_file(file_path);

    if( strsrch(content, "╟",-1) > strsrch(content, "╚",-1) ) {
		write("..........开始替换"+file_path+"--\n");
		pos = strsrch(content, "╟", -1);
        content[pos..pos] = "╚";
	}	
    if( strsrch(content, "╟") < strsrch(content, "╔") ) {
		write("..........开始替换"+file_path+"--\n");
		pos = strsrch(content, "╟");
        content[pos..pos] = "╔";
        write_file(file_path, content,1);
    }
}

void traverse_dir(string dir) {
    string *files,dirr;
    int i;
if (dir[<1..<1]!="/")dirr = dir+"/";
else dirr = dir;
    files = get_dir(dirr);
    for(i=0; i<sizeof(files); i++) {
        string path = dirr + files[i];
        int type = file_size(path);

        if(type == -2) {		
            traverse_dir(path);
        }
        else if(type != -1) {
            process_file(path);
        }
    }
}

int main() {
    string base_dir = "/doc/";
    traverse_dir(base_dir);
	return 1;
}