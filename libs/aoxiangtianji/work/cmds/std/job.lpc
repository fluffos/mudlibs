#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
  string output,name, *kq;
  mapping quest;
  int i, num, exp, dx, max, min;
  object ob;

  seteuid(getuid(me));
  if( !arg )
  {
    ob = me;
    name = "你";
  }

  else if (wizardp (me))
  {
    ob = find_player(arg);
    if(!objectp(ob))
      ob = find_living(arg);
    if(!objectp(ob))
      ob = LOGIN_D->find_body(arg);
    if(!ob || !me->visible(ob))
      return notify_fail("没有这个人。\n");
    name = ob->query("name");
  }

  else
    return notify_fail("你只能查看自己的状况！\n");
  quest = ob->query("quest_xyj");
  if (!mapp(quest) || sizeof(quest) < 1)
    return notify_fail(name + "现在没有任何任务！\n");

  kq = keys(quest);
  output = "";
  for (i=0;i<sizeof(kq);i++)
  {
    if (!mapp(quest[kq[i]]) || sizeof(quest[kq[i]]) < 1)
      continue;
    switch (kq[i])
    {
      case "yuan" :
        output += "任务名称：袁天罡\n";
        num = ob->query_temp("yuan/next_lv");
        output += "当前等级：" + chinese_number(num) + " \n";
        output += "奖励：\n";
        exp = 100 + ob->query("level")*3 + num*30;
        min = exp/4;
        max = exp/4 + exp/2;
        output += "\t武学：" + chinese_number(exp) + "点 \n";
        output += "\t道行：从 " + XYJTIME_D->check_daoxing(min) +
                        " 到 " + XYJTIME_D->check_daoxing(max) + "\n";
        output += "已用时：" + XYJTIME_D->query_time(time()-quest["yuan"]["s_time"]) + " \n";
        break;
      case "xue" :
        output += "任务名称：薛仁贵\n";
        num = ob->query("quest_info/xue/count");
        output += "当前已完成：" + chinese_number(num) + "个 \n";
        output += "奖励：\n";
        dx = 150 + ob->query("level")*4 + num;
        min = dx/4;
        max = dx/4 + dx/2;
        output += "\t道行：" + XYJTIME_D->check_daoxing(dx) + " \n";
        output += "\t武学：从 " + chinese_number(min) +
                        " 到 " + chinese_number(max) + " 点 \n";
        output += "已用时：" + XYJTIME_D->query_time(time()-quest["xue"]["s_time"]) + " \n";
        break;
      case "lijing" :
        output += "任务名称：李靖\n";
        num = ob->query_temp("lijing/next_lv");
        output += "当前等级：" + chinese_number(num) + " \n";
        output += "奖励：\n";
        exp = 150 + ob->query("level")*3 + num*40;
        min = exp/4;
        max = exp/4 + exp/2;
        output += "\t武学：" + chinese_number(exp) + "点 \n";
        output += "\t道行：从 " + XYJTIME_D->check_daoxing(min) +
                        " 到 " + XYJTIME_D->check_daoxing(max) + "\n";
        output += "已用时：" + XYJTIME_D->query_time(time()-quest["lijing"]["s_time"]) + " \n";
        break;
      case "menpai" :
        output += "任务名称：门派任务\n";
        num = ob->query("quest_info/menpai/count");
        output += "当前已完成：" + chinese_number(num) + "个 \n";
        output += "奖励：\n";
        dx = 150 + ob->query("level")*3 + num;
        min = dx/4;
        max = dx/4 + dx/2;
        output += "\t道行：" + XYJTIME_D->check_daoxing(dx) + " \n";
        output += "\t武学：从 " + chinese_number(min) +
                        " 到 " + chinese_number(max) + " 点 \n";
        output += "已用时：" + XYJTIME_D->query_time(time()-quest["menpai"]["s_time"]) + " \n";
        break;
      case "pantu" :
        output += "任务名称：官府叛徒\n";
        num = ob->query("quest_info/pantu/count");
        output += "当前已完成：" + chinese_number(num) + "个 \n";
        output += "奖励：\n";
        exp = 250 + ob->query("level")*5 + num;
        exp = exp*6/5;
        min = 0;
        max = 1 + exp/3;
        output += "\t武学：" + chinese_number(exp) + "点 \n";
        output += "\t道行：从 没有 " +
                        " 到 " + XYJTIME_D->check_daoxing(max) + "\n";
        output += "已用时：" + XYJTIME_D->query_time(time()-quest["pantu"]["s_time"]) + " \n";
        break;
      case "itask" :
        output += "任务名称：门派综合任务\n";
        num = ob->query("quest_info/itask/count");
        output += "当前已完成：" + chinese_number(num) + "个 \n";
        output += "当前任务类型：";
        switch (quest["itask"]["type"])
        {
          case "letter" :
            output += "送信 \n";
            break;
          case "search" :
            output += "寻物 \n";
            break;
          default :
            output += "杀 \n";
            break;
        }

        output += sprintf("本次连续中已经取消次数：%d\n",ob->query("quest_info/itask/jc_count"));
        output += "奖励：\n";
        output += "\t因任务而定。\n";
        output += "已用时：" + XYJTIME_D->query_time(time()-quest["itask"]["s_time"]) + " \n";
        break;
      case "rulai" :
        output += "任务名称：如来任务\n";
        num = ob->query("quest_info/rulai/count");
        output += "当前已完成：" + chinese_number(num) + "个 \n";
        output += "当前任务类型：";
        switch (quest["rulai"]["type"])
        {
          case "kill" :
            output += "杀 \n";
            break;
          case "persuade" :
            output += "劝 \n";
            break;
          case "defeat" :
            output += "降 \n";
            break;
          default :
            output += "擒 \n";
            break;
        }

        output += "奖励：\n";
        output += "\t因任务种类，难度而定。\n";
        output += sprintf("本次连续中已经取消次数：%d\n",ob->query("quest_info/rulai/jc_count"));
        output += "已用时：" + XYJTIME_D->query_time(time()-quest["rulai"]["s_time"]) + " \n";
        break;
      default :
         output += "没有这种任务！\n";
    }

    output += "-------------------\n";
  }

  ob->start_more(output);
  return 1;
}

int help(object me)
{
      write(@HELP
指令格式: job
查看自己当前申请的任务情况！
HELP);
       return 1;
}

