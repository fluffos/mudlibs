int main(object me, string arg)
{
  string loc;
  string myfam ;
  int mana_cost;
  object ridee, map,towhere;
  string *keys_desc;
  string *keys_loc;
  int can_fly, size_loc ;
  string ridemsg = "" ;

  seteuid(getuid());

  if(!wizardp(me))
  {
    if( me->is_fighting() )
      return notify_fail("你正在战斗，飞不开。\n");
    if (me->is_busy()
     || me->query_temp("doing_xiudao")
     || me->query_temp("pending/exercising")
     || me->query_temp("pending/meditating"))
      return notify_fail("你好忙啊，静心处理现在的事情吧，防止走火入魔！\n");
    if( !wizardp(me) && !environment(me)->query("outdoors") )
      return notify_fail("周围没有一片云，没办法腾云驾雾。\n");
    if( me->is_ghost() )
      return notify_fail("做了鬼了，就老实点吧！\n");
    if( !arg )
      return notify_fail("你要飞到哪里去？\n");
    if( me->query_temp("no_move") )
      return notify_fail("你被定住了，哪里飞得起来！\n");
    if( RANK_D->grade_dx( RANK_D->describe_dx( (int)me->query("daoxing") ) )
      < RANK_D->grade_dx(BLU "初领妙道" NOR) )
    {
      message_vision(HIY"$N奋力望上一跳，似乎想飞起来。"
                      + "结果离地不到三尺就一个倒栽葱摔了下来。\n"NOR, me);
      return notify_fail("你现在连初领妙道都谈不上，哪里飞得起来。\n");
    }

    if( RANK_D->grade_fali( RANK_D->describe_fali( (int)me->query("max_mana") ) )
      < RANK_D->grade_fali(HIB "腾云驾雾" NOR) )
    {
      message_vision(HIY"$N奋力望上一跳，似乎想飞起来。"
                      + "结果离地不到三尺就一个倒栽葱摔了下来。\n"NOR, me);
      return notify_fail("看来以你的法力修为还不能腾云驾雾。\n");
    }

    if( (int)me->query("mana") < 200 )
    {
       message_vision(HIY"$N奋力望上一跳，似乎想飞起来。"
                       + "结果离地不到三尺就一个倒栽葱摔了下来。\n"NOR, me);
       return notify_fail("你目前法力不够充盈。\n");
    }

    if( (int)me->query("sen") * 100 / (int)me->query("max_sen") < 50 )
      return notify_fail("你现在头脑不太清醒，当心掉下来摔死。\n");
    if( (int)me->query("kee") * 100 / (int)me->query("max_kee") < 50 )
      return notify_fail("你想飞起来，可是体力似乎有点不支。\n");
  }

  if( (time() - (int)me->query_temp("last_fly_time")) < 2)
  {
    if (me->query("sen") >= 100)
      me->add("sen", -100);
    return notify_fail(YEL"你飞得太快，精神跟不上来，先歇会吧。。。\n"NOR);
  }

  me->set_temp("last_fly_time",time());

  mana_cost=-(100-(int)me->query_skill("spells"))/4-40;
  if(mana_cost > 0)
    mana_cost=0;
  myfam = (string)me->query("family/family_name");
  keys_desc = keys(fly_disc);
  if(member_array(myfam,keys_desc) != -1)
  {
    message_vision(fly_disc[myfam][FLY_START],me);
  }

  else
    message_vision(HIW"$N低喝了声“走”，一阵飞沙走石后，$N转瞬间没了踪迹。。。\n",me);
  me->add("mana", mana_cost);
  can_fly = 0;
  keys_loc = keys(fly_loc);

  if(member_array(arg,keys_loc)!=-1)
  {
    if (fly_loc[arg][FLY_MAP] == "nocond"
     && fly_loc[arg][FLY_MENPAI] == "nocond"
     && fly_loc[arg][FLY_COND] == "nocond")
     can_fly = 1 ;
    else if (fly_loc[arg][FLY_MAP] != "nocond")
    {
      map=present(fly_loc[arg][FLY_MAP], me);
      if( objectp(map) && (string)map->query("unit") == "张" )
        can_fly = 1 ;
    }

    else if (fly_loc[arg][FLY_MENPAI] != "nocond")
    {
      if (stringp(myfam) && (myfam == fly_loc[arg][FLY_MENPAI]))
        can_fly = 1 ;
    }

    else if (fly_loc[arg][FLY_COND] != "nocond")
    {
      if (me->query(fly_loc[arg][FLY_COND]))
        can_fly = 1 ;
    }

    if (wizardp(me))
      can_fly = 1 ;
  }

  if(can_fly == 0)
  {
    switch (random(4))
    {
      case 0 :
        message_vision("$N一纵身跳上云端，手搭凉棚四处张望，"
                       "才发觉根本没了方向。。。\n",me);
        message_vision("\n$N无奈的跳下来云端！\n", me);
        return 1;
      case 1 :
        message_vision("$N一声低喝“去也”，上了云头，"
                       "可惜$N自己也不知道该飞往何处！\n\n",me);
        message_vision("\n$N一脸迷茫的跳了下来！\n", me);
        return 1;
      case 2 :
        message_vision("$N一声“呼哨”，跃起老高，怎奈却不知道该去哪里！\n\n",me);
        message_vision("\n$N一脸不高兴的蹦了下来！，“咚”的一声，好响\n", me);
        return 1;
      default :
        message_vision("$N在天上转了半天也不知该往那边飞。。。\n",me);
        message_vision("\n$N失望地从云上跳了下来！\n", me);
        return 1;
    }

  }

  size_loc = sizeof(fly_loc[arg][FLY_LOC]);
  loc = fly_loc[arg][FLY_LOC][random(size_loc)];

  if (! stringp(loc))
    return 1;

  if(MISC_D->random_capture(me,0,1))
    return 1;
  towhere = load_object(loc);
  if (!objectp(towhere))
  {
    tell_object(me,"你不能飞往那个地方！\n");
    log_file("file_err",sprintf("命令fly，目的文件%s似乎没有找到！时间：%s",
         loc,ctime(time())));
    return 1;
  }

  me->move(loc);
  ridee = me->query_temp("is_riding");
  if (objectp(ridee))
  {
    ridemsg = ridee->query("ride/msg")+"着"+ridee->name();
    ridee->move(loc);
  }

  else
    ridemsg = "";
  if(member_array(myfam,keys_desc)!=-1)
  {
    message_vision(sprintf(fly_disc[myfam][FLY_END],ridemsg),me);
  }

  else
    message_vision(HIW"$N按下云头从空中跳了下来。。。\n",me);

  return 1;
}

int help(object me)
{
  int i ;
  string *keys_loc;
  string didian, msg ;
  write("\n指令格式 : fly|fei [目的地]\n\n");
  write("你可以飞到的地方：\n");
  write("===============\n\n");
  msg = "\t";

  keys_loc = keys(fly_loc);
  for(i=0; i<sizeof(keys_loc); i++)
  {
    didian = keys_loc[i];
    msg += sprintf("%s%-10s%s --> %s%-20s%s",
           HIY,didian,NOR,
           HIW,fly_loc[didian][FLY_ZHONGWEN],NOR);
    msg += " || ";
    if ((i % 2) == 0)
      msg += "\n\t";
  };
  msg += "\n=====FINISH========\n";
  write(msg);
  return 1;
}

