#include <command.h>
#define FLY_START      0
#define FLY_END        1
#define FLY_MAP        0
#define FLY_MENPAI     1
#define FLY_COND       2
#define FLY_ZHONGWEN   3
#define FLY_LOC        4
mapping fly_disc = ([
      "陷空山无底洞" : ({ HIW"只见平地里忽然刮起一阵阴风，将$N紧紧裹住，"
                            "顷刻间$N随风而去，消失得无影无踪。。。 \n\n"NOR ,
                        HIW"\n忽然间刮起一阵阴风，风尽处，$N%s走了出来…… \n"NOR,
                      }),

      "将军府"       : ({ HIY"$N用手轻轻一指，只见天上降下一朵五彩祥云，"
                            "$N纵身跃上，乘祥云飘摇而去。。。\n\n"NOR ,
                         HIY"\n只见空中飘落一朵五彩祥云，$N%s拨开云端走了出来…… \n"NOR,
                      }),

      "阎罗地府"     : ({ CYN"$N往黑暗处一指，只见所指之处仿佛出现一扇门，"
                            "$N大步走入，门也随之消失。。。 \n\n"NOR,
                         CYN"\n阴影中吹起一阵冷风，伴随着冷森森的笑声，$N%s如魑魅般"
                            "从黑暗中出现…… \n"NOR,
                      }),

      "方寸山三星洞" : ({ HIG"$N捻个口诀，口中念动真言，大叫一声：“筋斗云！”，只见天"
                            "上降下一朵七色云彩，$N纵身跃上，飞驰而去。。。\n\n"NOR ,
                        HIG"\n只听见天上传来一声：“俺来也！”，人随声到，$N%s从筋斗云"
                           "中冉冉落下……。\n"NOR,
                      }),

      "月宫"        : ({ HIM"$N嫣然一笑，忽地飘飘飞起，姿态婀娜,一阵微风过后，"
                            "只留下淡淡的馨香。。。\n\n"NOR ,
                        HIM"\n只见一道月光洒在你面前，柔柔的，冷冷的，一阵馨香过后,"
                        "$N%s从月光中飘然而至…… \n"NOR,
                      }),

      "五庄观"       : ({ HIB"$N大袖一摆，只见风起云涌，人已借风云之势在空中大步"
                          "迈去。。。\n\n"NOR ,
                         HIB"\n一阵清风吹来，$N%s从空中降落…… \n"NOR,
                      }),

      "大雪山"       : ({ HIW"$N随手一挥，只见一团雪雾裹住真身，旋转而去。。 \n\n"NOR,
                         HIW"\n霎时间，大雪纷飞，$N%s亦如晶莹剔透的雪花随风飘下…… \n"NOR,
                      }),

      "南海普陀山"   : ({ HIY"$N口中念着佛号，脚下升起祥云，缓缓离地飞去。。\n\n"NOR,
                         HIY"\n一声洪亮的“南无阿伲陀佛”，$N%s从佛光中，祥云里走出…… \n"NOR,
                      }),

      "东海龙宫"     : ({ HIC"$N口摇身一变，现出原形，正是一条神龙，随即穿云而"
                         "去。。。 \n\n"NOR ,
                         HIC"\n半空中仿佛冲出一条水柱，$N%s从水柱上稳稳跳落地下……  \n"NOR,
                      }),

      "火云洞"       : ({ HIY"$N周身笼起一团火焰，火焰四处饶绕，一阵焦味过后，$N踩着"
                          "一团"HIR"火"HIY"焰冲天而去。。。\n\n"NOR ,
                         HIY"\n只见一阵狂风带着焦味吹过后,$N%s夹着一团"HIR"火"
                         HIY"从空中撞了出来。\n"NOR,
                       }),
/*
      "蜀山剑派"     : ({ HIC"$N口捻个口诀，扔出一把宝剑，$N飞驰而上，"
                            "一招「御剑飞行」向远方飞去。。。。\n\n"NOR ,
                         HIC"\n一道蓝光闪过,$N%s从剑上跳了下来。\n"NOR,
                      }),

      "花果山盘丝洞" :  ({ MAG"$N皓腕轻抖，但见一道彩虹落了下来，$N纤腰轻摆飘然而上，"
                          "霞光一闪，彩虹消失的无影无踪。\n"NOR,
                         MAG"\n但见一道彩虹从天空划过，$N%s随彩虹飘然而至。 \n"NOR,
                      }),
*/
        ]);
