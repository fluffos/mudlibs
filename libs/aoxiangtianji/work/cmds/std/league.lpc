#include <ansi.h>
inherit F_CLEAN_UP;
int help(object me);
void create()
{
  seteuid(getuid());
}

int main(object me, string arg)
{
  string league_cmd;
  if (!playerp(me))
    return 0;

  if (! arg)
  {
    return LEAGUE_D->get_help(me);
  }

  if (!wizardp(me) && !stringp(LEAGUE_D->query_player_league_id(me)))
    return notify_fail("你还没有加入任何联盟。\n");

  if (sscanf(arg, "%s %s", league_cmd, arg) != 2)
  {
    league_cmd = arg;
    arg = 0;
  }

  league_cmd = "/cmds/std/league/" + league_cmd + ".lpc";
  if (file_size(league_cmd) < 0)
    return notify_fail("你要发什么队伍命令？\n");
  return league_cmd->main(me, arg);
}

int help(object me)
{
  return LEAGUE_D->get_help(me);
}

