// CMDS /cmds/std/score.c
#include <login.h>
#include <combat.h>
#include <mudlib.h>
#include <command.h>
inherit F_CLEAN_UP;

#define SX "/adm/etc/12sx"
#define XZ "/adm/etc/12xz"

string *shengxiao =explode(read_file(SX),"\n");
string *xingzuo =explode(read_file(XZ),"\n");

string display_attr(int gift, int value);
string status_color(int current, int max);
string tribar_graph(int val, int eff, int max, string bcolor, string fcolor, string dcolor);
string display_faith(int faith);

void create()
{
  seteuid(ROOT_UID);
}

string check_daoxing(int gain)
{
  int year,day,hour;
  string str;

  year=gain/1000;
  day=(gain-year*1000)/4;
  hour=(gain-year*1000-day*4)*3;

  str="";
  if(year) str=str+(year)+"年";
  if(day) str=str+(day)+"天";
  if(hour) str=str+(hour)+"时辰";

  return str;
}

int main(object me, string arg)
{
  object ob, mastername;
  mapping my;
  string line, str, banghui;
  int qn,used_qn,age,deaddao_last;
  string msg;

  seteuid(getuid(me));

  if(!arg )
    ob = me;
  else if (wizardp(me) )
  {
    ob = present(arg, environment(me));
    if (!ob)
      ob = find_player(arg);
    if (!ob)
      ob = find_living(arg);
    if (!ob)
      return notify_fail("你要察看谁的个人档案情况？\n");
  }
  else if( stringp(banghui=me->query("league/league_name")))
  {
    ob =present(arg,environment(me));
    if(!ob || !ob->is_character())
      return notify_fail("你要察看谁的个人档案情况？\n");
    if((string)ob->query("league/league_name")!=banghui)
      return notify_fail("你只能查看本联盟成员的个人档案情况。\n");
  }
  else
    return notify_fail("只有巫师或同联盟的人才能察看别人的个人档案情况。\n");

  if( wiz_level(me) < wiz_level(ob) )
    return notify_fail("你要察看谁的个人档案情况？\n");

  my = ob->query_entire_dbase();
//1st line
  write(NOR YEL"≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡"HIG"个"NOR YEL"≡≡≡"HIG"人"NOR YEL"≡≡≡"HIG
               "档"NOR YEL"≡≡≡"HIG"案"NOR YEL"≡≡≡≡≡≡≡≡≡≡≡≡≡≡\n"NOR);
//2nd line
  write("你现在的头衔 : "+RANK_D->query_rank(ob)+"\n");
//3rd line
  write("你现在的职称 : "+ob->short(1)+"\n");
//4th line
  line = NOR YEL"≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡\n"NOR;

//5th line  年龄 生日 性别 体重 帮会
  str = "";
  line += sprintf( " 年龄：[ %s%8d%s ]   生日：[ %s%-24s%s ]\n",
                    ob->query("age") < 20 ? HIG : HIY,
                    ob->query("age"),
                    NOR,
                    CYN,
                    XYJTIME_D->check_usr_birthday(ob),
                    NOR);
  line += sprintf( " 性别：[ %s%-8s%s ]   体重：[ %-14s ]   职业：[ %s%s ]\n",
                    ob->query("gender") == "男性" ? RED : GRN,
                    ob->query("gender"),
                    NOR,
                    chinese_number((int)ob->query_weight()/1000)+"公斤",
                    UPEXP_D->query_occupation(ob),
                    NOR);

//6th line 职业 帮会职务 阳寿
  line += sprintf(" 联盟：[ %-8s ]   ",
      stringp(ob->query("league/league_name")) ? ob->query("league/league_name"):"尚未联盟");

  if( stringp(ob->query("league/league_name")) )
    line += sprintf("联盟等级：[ %-8s ]",
         (int)ob->query("league/grant") ? chinese_number((int)ob->query("league/grant")) : "普通成员");
  else
    line+= " 联盟等级：[ 尚未联盟 ]"NOR;
  age = (int)ob->query("life/life_time");
  age -= (int)ob->query_age() / 86400;
  msg = sprintf("[ %-6s年 ]", chinese_number(age) );
  if( userp(ob) )
  {
    if( !ob->query("life/live_forever_announced") && !ob->query("life/live_forever") )
    {
      if(wizardp(me)
      || RANK_D->grade_dx(RANK_D->describe_dx(ob->query("daoxing")))>=RANK_D->grade_dx(CYN"脱胎换骨"NOR))
      {
        line+= "   阳寿："+msg+"\n";
      }
      else
        line+= "   阳寿：[ 暂时隐藏 ]\n"NOR;
    }
    else
      line+= "   阳寿：[ "RED"不生不灭"NOR" ]\n"NOR;
  }
  else if( !userp(ob) )
    line+= "   阳寿：[ "RED"不生不灭"NOR" ]\n"NOR;

//7th line 婚姻 性状态
  if (ob->query("married"))
  {
    if (ob->query("gender")=="女性")
    {
      line += sprintf(" 丈夫：[ %-8s ]", ob->query("couple/name"));
    }
    else
    {
      if ((int)me->query("married")<=1)
      {
        line += sprintf(" 妻子：[ %-8s ]", ob->query("couple/name"));
      }
      else
      {
        if( ob->query("couple/name") && ob->query("couple2/name"))
          line += sprintf(" 发妻：[ %-8s]   小妾[%-8s ]",
                    ob->query("couple/name"),ob->query("couple2/name"));
        else if( ob->query("couple/name") && !ob->query("couple2/name"))
          line += sprintf(" 发妻：[ %-8s ]   小妾[ 不 明 ]",
                    ob->query("couple/name"));
        else if( ob->query("couple2/name") && !ob->query("couple/name"))
          line += sprintf(" 发妻：[ 不 明 ]   小妾[ %-8s ]", ob->query("couple/name"));
      }
    }
  }
  else
  {
    if (!ob->query("unmarryed"))
      line += " 婚姻: [ 未    婚 ]";
    else
      line += " 婚姻: [ "RED"离    异"NOR" ]";
  }

  if ( !ob->query("sex/times") && !ob->query("sex/times2") )
  {
    if (ob->query("gender")=="女性")
      line += sprintf("   状态：[ 处  女 ]");
    else
      line += sprintf("   状态：[ 童  男 ]");
  }
  else if ( ob->query("sex/times") && ob->query("sex/times2") )
  {
    line += sprintf("   状态：[ "HIG"%-8s"NOR" ]",ob->query("sex/first") );
  }
  else if ( !ob->query("sex/times") &&  ob->query("sex/times2") )
    line += sprintf("   状态：[ "HIG"%-8s"NOR" ]",ob->query("sex/first") );
  else if ( ob->query("sex/times") &&  !ob->query("sex/times2") )
    line += sprintf("   状态：[ %-8s ]",ob->query("sex/first") );
  else
    line += "   状态: [ 不  明 ]";
  if ( ob->query("sex/times") && !ob->query("sex/times2"))
    line += sprintf( "   做爱：[ %-2d/ 0 ] \n",ob->query("sex/times"));
  else if ( !ob->query("sex/times") && ob->query("sex/times2"))
    line += sprintf( "   做爱：[ 0 /%2d %8s ] \n",ob->query("sex/times2"),ob->query("sex/seced"));
  else if ( ob->query("sex/times") && ob->query("sex/times2"))
    line += sprintf( "   做爱：[ %2d/%2d %8s ] \n",
      ob->query("sex/times2"),ob->query("sex/times"),ob->query("sex/seced"));
  else
    line += sprintf( "   做爱：[ 未曾云雨 ] \n");

//8th line 天性 祖籍 官职
  line += sprintf(" 天性：[ %s%-8s%s ]",
                  HIG,
                  stringp(ob->query("character")) ? ob->query("character"):"不明",
                  NOR);
  line += sprintf( "   官职：[ %-8d ]   官拜：[ %s ]\n",
          ob->query("office_number"), ob->query("degree")?ob->query("degree"):"未入仕途");

//9th line 生肖 星座 师承 善缘
  if( userp(ob) )
    line += sprintf( " 生肖：[ %-8s ]   星座：[ %-8s ]", ob->query("12_sx"),ob->query("12_xz") );
  else if( !userp(ob) )
    line += sprintf( " 生肖：[ %-8s ]   星座：[ %-8s ]",
     element_of(shengxiao) , element_of(xingzuo) );
  mastername= ob->query("family/master_name");
  if( userp(me) && userp(ob) )
  {
    if( !(string)me->query("Pfamily") )
    {
      if ( mastername )
        line += sprintf( "   师承：[ %-8s ] \n",filter_color(mastername));
      else
        line += sprintf( "   师承：[ 未入师门 ] \n");
    }
    else
      line += sprintf( "   师承：[ "HIR+(string)me->query("Pfamily")+"弃徒"NOR" ] \n");
  }
  else
  {
    if( ob->query("family/family_name") )
      line += sprintf( "   师承：[ %-8s ] \n",ob->query("family/family_name") );
    else
      line += sprintf( "   师承：[ 无门无派 ] \n");
  }

//10th line 力量 精神状态 五行
  line += sprintf( " 力量：[%2d/%4s %s]", my["str"], display_attr(my["str"], ob->query_str()),NOR);
  if( my["eff_sen"] <my["max_sen"] )
    str = HIR+"生病";
  else if( my["sen"]*100 / my["max_sen"]>=70 )
    str = HIG + "饱满";
  else if( my["sen"]*100 / my["max_sen"]>=40 )
    str = HIR + "疲倦";
  else
    str = HIB + "很累";
  line += " ·精神状态·" + tribar_graph(my["sen"], my["eff_sen"], my["max_sen"], NOR, HIR ,HIW)
                  + sprintf( "  [%4s%s]\n", str,NOR);

//11th line 根骨 气血状态 兵士
  line += sprintf( " 根骨：[%2d/%4s %s]", my["con"], display_attr(my["con"], ob->query_con()), NOR );
  if( my["eff_kee"] <my["max_kee"] )
    str = HIR+"受伤";
  else if( my["kee"]*100 / my["max_kee"]>=70 )
    str = HIG + "充沛";
  else if( my["kee"]*100 / my["max_kee"]>=40 )
    str = HIR + "伤残";
  else
    str = HIB + "重伤";
  line += " ·气血状态·" + tribar_graph(my["kee"], my["eff_kee"], my["max_kee"],NOR, HIR ,HIW)
           + sprintf( "  [%4s%s]\n",str,NOR);

//12th line 悟性 食物状态
  if( my["food"] * 100 / ob->max_food_capacity() > 100 )
    str = HIY+"辟谷";
  else if( my["food"] * 100 / ob->max_food_capacity() >= 90 )
    str = HIC+"很饱";
  else if( my["food"] * 100 / ob->max_food_capacity() >= 50 )
    str = HIC+"正常";
  else if( my["food"] * 100 / ob->max_food_capacity() >= 20 )
    str = HIR+"缺食";
  else
    str = HIB + "饥饿";
  line += sprintf( " 悟性：[%2d/%4s %s]", my["int"], display_attr(my["int"], ob->query_int()), NOR );
  line += " ·食物状态·" + tribar_graph(my["food"], ob->max_food_capacity(),
         ob->max_food_capacity(), NOR, HIC ,HIR)
         + sprintf( "  [%4s%s]\n", str, NOR );

//13th line 灵性 饮水状态
  line += sprintf( " 灵性：[%2d/%4s %s]", my["spi"], display_attr(my["spi"], ob->query_spi()), NOR );

  if( my["water"] * 100 / ob->max_water_capacity() > 100 )
    str = HIY + "辟谷";
  else if( my["water"] * 100 / ob->max_water_capacity() > 50 )
    str = HIC + "正常";
  else if( my["water"] * 100 / ob->max_water_capacity() > 30 )
    str = HIR + "缺水";
  else
    str = HIB + "饥渴";
  line += " ·饮水状态·" + tribar_graph(my["water"], ob->max_water_capacity(),
         ob->max_water_capacity(), NOR, HIC ,HIR)
         + sprintf( "  [%4s%s]\n",  str, NOR );

  line += sprintf( " 敏捷：[%2d/%4s %s]", my["dex"], display_attr(my["dex"], ob->query_dex()), NOR );

  line += sprintf(" ·战斗等级· %s ·当前经验点数· %d ·升级· -%d\n",
                  UPEXP_D->query_upexp(ob),
                  UPEXP_D->query_total_exp(ob),
                  UPEXP_D->query_next_exp(ob));

//14th line  魅力 拼杀记录
  if(wizardp(me)
    || RANK_D->grade_dx(RANK_D->describe_dx(ob->query("daoxing")))>=RANK_D->grade_dx(CYN"脱胎换骨"NOR))
  {
    line += sprintf( " 魅力：[%2d/%4s %s]", my["per"], display_attr(my["per"], ob->query_per()), NOR );
  }
  else
    line += sprintf( " 魅力：[%2s/%4s %s]",
          wizardp(ob)?sprintf("%d",my["per"]):"隐藏",
          wizardp(ob)?display_attr(my["per"], ob->query_per()):"隐藏", NOR );

  line += " ·拼杀记录·"
           + sprintf( "杀害玩家：%d/%3d [%d]"NOR" 位,杀死敌人：%d 位\n",
                (int)ob->query("combat/PKS"),
                (int)ob->query("combat/WPK"),
                (int)ob->query("combat/DPS"),
                (int)ob->query("combat/MKS"));

//15th line 勇气 阵亡记录
  if(wizardp(me)
   || RANK_D->grade_dx(RANK_D->describe_dx(ob->query("daoxing")))>=RANK_D->grade_dx(CYN"脱胎换骨"NOR))
  {
    line += sprintf( " 勇气：[%2d/%4s %s]",my["cor"], display_attr(my["cor"], ob->query_cor()), NOR );
  }
  else
    line += sprintf( " 勇气：[%2s/%4s %s]",
              wizardp(ob)?sprintf("%d",my["cor"]):"隐藏",
              wizardp(ob)?display_attr(my["cor"], ob->query_cor()):"隐藏", NOR );
  line += " ·阵亡记录·"
       + sprintf( "PK阵亡：%s%d%s 次,杀敌阵亡：%s%d%s 次\n",
           YEL, (int)ob->query("killed/dietimes"), NOR,
           YEL, (int)ob->query("combat/dietimes"), NOR);

//16th line 定力  潜能
  if(wizardp(me)
   || RANK_D->grade_dx(RANK_D->describe_dx(ob->query("daoxing")))>=RANK_D->grade_dx(CYN"脱胎换骨"NOR))
  {
    line += sprintf( " 定力：[%2d/%4s %s]",my["cps"], display_attr(my["cps"], ob->query_cps()), NOR );
  }
  else
    line += sprintf( " 定力：[%2s/%4s %s]",
               wizardp(ob) ? sprintf("%d",my["cps"]) : "隐藏",
               wizardp(ob) ? display_attr(my["cps"], ob->query_cps()):"隐藏", NOR );
  qn = my["potential"];
  used_qn = my["learned_points"];
  line += sprintf(" ·潜能·：[%d]\n",(qn - used_qn));

//17th line 福缘 钱庄存款
  if(wizardp(me) ||
     RANK_D->grade_dx(RANK_D->describe_dx(ob->query("daoxing")))>=RANK_D->grade_dx(CYN"脱胎换骨"NOR))
  {
    line += sprintf( " 福缘：[%2d/%4s %s]",my["kar"], display_attr(my["kar"], ob->query_kar()), NOR );
  }
  else
    line += sprintf( " 福缘：[%2s/%4s %s]",
            wizardp(ob)?sprintf("%d",my["kar"]):"隐藏",
            wizardp(ob)?display_attr(my["kar"], ob->query_kar()):"隐藏", NOR );

  if( (int)ob->query("balance")>0 )
    line+= " ·钱庄存款·"+MONEY_D->money_num((int)ob->query("balance"))+"\n\n";
  else if( (int)ob->query("balance")<0 )
    line+= RED" ·钱庄欠款·"+MONEY_D->money_num((-(int)ob->query("balance")))+"\n\n"NOR;
  else
    line+= " ·钱庄存款·目前是个穷鬼\n\n";

//18th 门派忠诚度 潜能存储
  line += sprintf(" 门派忠诚度： "YEL"%s(%d)   " NOR "   潜能储存数： "YEL"%5d \n\n"NOR,
           display_faith((int)ob->query("family/family_faith")),
           (int)ob->query("family/family_faith"),
           (int)ob->query("qn_balance"));

  line += HIY"关卡纪录"NOR HIR"·"NOR HIW"大闹天宫："NOR;
  if (!ob->query("dntg/number"))
    line += HIB" 你尚未开始！\n"NOR;
  else if (ob->query("dntg/number") < 10)
    line += HIY" 你已经过了 " + HIR + chinese_number(ob->query("dntg/number")) +
            HIY " 道关卡！\n"NOR;
  else
    line += HIR"你已经大闹天宫完毕！\n"NOR;

  line += HIY"关卡纪录"NOR HIR"·"NOR HIW"西行取经："NOR;
  if (!ob->query("obstacle/number"))
    line += HIB" 你尚未西行！\n\n"NOR;
  else if (ob->query("obstacle/number") < 34)
    line += HIY" 你经历了 " + HIR + chinese_number(ob->query("obstacle/number")) +
            HIY " 道劫难！\n\n"NOR;
  else
    line += HIR"你已经历经了所有劫难！\n\n"NOR;

//19th 上次杀戮
  if( stringp(ob->query("combat/kill_id")) && stringp(ob->query("combat/kill_name")) )
    line+=sprintf(" 上次杀戮：[%s]前 将"YEL"%s(%s)"NOR"杀死！\n",
      XYJTIME_D->query_timec((int)ob->query("combat/killtime")),
      (string)ob->query("combat/kill_name"),
      (string)ob->query("combat/kill_id"));
  else
    line+= "目前没有杀戮纪录！\n";

//20th 上次死因
  if( ob->query("killed/last_killer") && ob->query("killed/last_killername") )
  {
    line+=sprintf("上次PK死因：[%s]前 被"YEL"%s(%s)"NOR"杀死！\n",
          XYJTIME_D->query_timec(ob->query("killed/killtime")),
          ob->query("killed/last_killername"),ob->query("killed/last_killer"));
  }
  else
    line+= "没有PK死亡纪录！\n";

  if(stringp(ob->query("combat/last_die")))
    line+=sprintf("上次NK死因：%s\n\n",(string)ob->query("combat/last_die"));
  else
    line+= "没有NK死亡纪录！\n\n";

//21th PK道行
  if(ob->query("combat/pkgain") )
  {
    line +=sprintf(NOR"ＰＫ道行：%s  \n",
       XYJTIME_D->check_daoxing(ob->query("combat/pkgain")));
  }

//22th NK道行
  if(ob->query("combat/nkgain") )
  {
    line +=sprintf(NOR"ＮＫ道行：%s  \n",
      XYJTIME_D->check_daoxing(ob->query("combat/nkgain")));
  }

  deaddao_last = (int)ob->query("death/last_dx_loss");
  line += sprintf(GRN"  ·上次死亡损失：    \n"NOR
      HIR"       武学：%d\n"NOR
      HIR"       道行：%s\n"NOR
      HIR"       潜能：%d\n"NOR,
     (int)ob->query("death/last_exp_loss"),
     (deaddao_last>0) ? check_daoxing(deaddao_last):"没有道行损失",
     (int)ob->query("death/last_qn_loss"));
  if (ob->query("death/skill_loss"))
    line += sprintf(HIR"       损失一级技能\n"NOR);
//23th 道行境界 武学境界 法力修为 内力修为
  line += sprintf("\n道行境界：%s 武学境界：%s 法力修为：%s 内力修为：%s\n",
    RANK_D->describe_dx(ob->query("daoxing")),
    RANK_D->describe_exp(ob->query("combat_exp")),
    RANK_D->describe_fali(ob->query("max_mana")),
    RANK_D->describe_neili(ob->query("max_force")));

//24th bottom
  line += YEL"≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡ "HIR"西游记"NOR YEL" ≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡\n"NOR;

//25th
  if( userp(me) && userp(ob) )
  {
    line += sprintf("在西游记%s已经历了 "YEL"%s"NOR" 的岁月 "NOR,
      ob==me?"你":ob->name(1),FINGER_D->age_string( (int)ob->query("mud_age")) );
    line += sprintf("本次上线%s的停留时间为 "YEL"%s \n"NOR,
      ob==me?"你":ob->name(1),XYJTIME_D->query_time(time() - ob->query_temp("temp_time")) );
  }

  write(line);
  return 1;
}

string display_attr(int gift, int value)
{
   if( value > gift )
     return sprintf( HIY "%4d", value );
   else if( value < gift )
     return sprintf( HIC "%4d", value );
   else
     return sprintf("%3d", value);
}

string status_color(int current, int max)
{
  int percent;

  if( max )
    percent = current * 100 / max;
  else
    percent = 100;

  if( percent > 100 )
    return HIC;
  if( percent >= 90 )
    return HIG;
  if( percent >= 60 )
    return HIY;
  if( percent >= 30 )
    return YEL;
  if( percent >= 10 )
    return HIR;
  return RED;
}

string tribar_graph(int val, int eff, int max, string bcolor, string fcolor, string dcolor)
{
  string ret;
  int i, n, eff_n, max_n = 10;

  if( max == 0 )
    max = 1;
  n = val * 100 / max / 10;
  eff_n = eff * 100 / max / 10;

  if( n < 0 )
    n = 0;
  if( eff_n < 0 )
    eff_n = 0;
  if( n > max_n )
    n = max_n;
  if( eff_n > max_n )
    eff_n = max_n;

  ret = NOR  + bcolor + fcolor ;
  for( i = 0 ; i < max_n; i ++ )
  {
    if( i > eff_n )
      ret += dcolor;
    if( i < n )
      ret += "━";
    else
      ret += HIW"━"NOR;
  }
  ret += fcolor + NOR ;
  return ret;
}

string display_faith(int faith)
{
  string msg;
  int *lists, i;
  mapping desc=([
   -1000   :       HIR"大逆不道"NOR,
   -600    :       RED"倒行逆施"NOR,
   -300    :       HIB"胡做非为"NOR,
   -50     :       BLU"带罪之身"NOR,
    0      :       "碌碌无为",
   200     :       "无功无过",
   500     :       YEL"略有功劳"NOR,
   1000    :       HIY"功绩初显"NOR,
   2000    :       HIC"任劳任怨"NOR,
   5000    :       WHT"忠心不二"NOR,
   10000   :       HIW"门派柱石"NOR,
   20000   :       HIW"赤胆忠心"NOR,
  ]);

  lists=keys(desc);
//  lists=sort_array(lists, "sort_keys", this_object());
  lists=sort_array(lists, 0);
  for(i=0;i<sizeof(lists);i++)
  {
    msg=desc[lists[i]];
    if(faith<=lists[i])
      break;
  }
  return msg;
}

int help(object me)
{
        write(@HELP

指令格式：score/sc
          score <对象名称>  （巫师专用）

显示自己或者指定对象（含怪物）的基本资料。
此指令可以“sc”代替。

对于隐藏参数只有当你道行达到脱胎换骨时才
可以看到。。。

相关讯息：hp

HELP
        );

        return 1;
}

