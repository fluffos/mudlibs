#include <ansi.h>
inherit F_CLEAN_UP;
int do_get(object me, object ob, object old_env);
void create()
{
  seteuid(getuid());
}

int main(object me, string arg)
{
  string from, item, wiz_status;
  object obj, *inv, env, obj2,old_env;
  int i, amount;
  mixed no_get;
  wiz_status = SECURITY_D->get_status(me);
  if( !arg )
    return notify_fail("你要捡起什么东西？\n");
  if (!environment(me))
    return 0;
  if (userp(me) && !wizardp(me))
  {
    if( environment(me)->query("no_get") )
      return notify_fail(HIC"这里不让拣东西！！！\n"NOR);
    if( !arg )
      return notify_fail(HIC"你要捡起什么东西？\n"NOR);
    if (me->is_busy()
     || me->query_temp("doing_xiudao")
     || me->query_temp("pending/exercising"))
      return notify_fail("你现在正忙着呢。\n");
  }

  if (environment(me)->do_get(arg) > 0 )
    return 1;

// Check if a container is specified.
  if( sscanf(arg, "%s from %s", arg, from)==2 )
  {
    env = present(from, me);
    if(!objectp(env))
      env = present(from, environment(me));
    if(!objectp(env))
      return notify_fail("你找不到 " + from + " 这样东西。\n");
    if(env->is_character() && living(env) && (wiz_level(me) <= wiz_level(env)))
      return notify_fail("你的巫师等级必须比对方高，才能搜身。\n");

    if(env->is_corpse() &&
       objectp(env->query("killer")) &&
       me != env->query("killer") &&
       environment(me) == environment(env->query("killer")))
      return notify_fail("这样趁火打劫不好哦。\n");

    if (env->query("no_get"))
      return notify_fail("你无法从那里拿东西！\n");
    if( !wizardp(me) && userp(env) )
    {
      if( env->query("disable_type")=="<睡梦中>" )
        return notify_fail(HIR"趁人家睡觉的时候下手？嘿嘿，你也太缺德了！\n"NOR);
      if((int)env->query_temp("sleeped")>0)
        return notify_fail(HIR"趁人家睡觉的时候下手？嘿嘿，你也太缺德了！\n"NOR);
      if( env->query("disable_type")==" <昏迷不醒中>" )
        return notify_fail(HIR"趁人家昏迷不醒的时候下手？嘿嘿，你也太缺德了！\n"NOR);
      if( env ->query_temp("netdead") )
        return notify_fail("你不能拿断线的人的东西.\n");
    }

  }

  else
    env = environment(me);

  if(sscanf(arg, "%d %s", amount, item)==2)
  {
    if( !objectp(obj = present(item, env)) )
      return notify_fail("这里没有这样东西。\n");

    no_get = obj->query("no_get");
    if( no_get && !(wizardp(me) && me->query("env/override")) )
    {
       return notify_fail(stringp(no_get) ? no_get : "这个东西拿不起来。\n");
    }

    if( !obj->query_amount() )
      return notify_fail( obj->name() + "不能被分开拿走。\n");

    if( amount < 1 )
      return notify_fail("东西的个数至少是一个。\n");

    if( amount > obj->query_amount() )
      return notify_fail("这里没有那么多的" + obj->name() + "。\n");
    else if( amount == (int)obj->query_amount() )
    {
      return do_get(me, obj,0);
    }

    else
    {
      obj2 = new(base_name(obj));
      obj2->set_amount(amount);
      if(do_get(me,obj2, environment(obj)))
      {
        obj->set_amount( (int)obj->query_amount()-amount);
        return 1;
      }

      if (objectp(obj2))
        destruct(obj2);
      return 0;
    }

  }

// Check if we are making a quick get.
//	if(arg=="all")
// mon 5/29/99
// players are not allowed to "get all" from another player.
  if(arg=="all" && (wizardp(me) || !userp(env)) )
  {
    if( me->is_fighting() )
      return notify_fail("你还在战斗中！只能一次拿一样。\n");
    if( !env->query_max_encumbrance() )
      return notify_fail("那不是容器。\n");
    inv = all_inventory(env);
    if( !sizeof(inv) )
      return notify_fail("那里面没有任何东西。\n");
    for(i=0; i<sizeof(inv); i++)
    {
      if( inv[i]->is_character()
         || inv[i]->query("no_get")
         || inv[i]->query_temp("dig_money")
         || inv[i]->query_temp("seed_money")
         || inv[i]->query_temp("hide"))
        continue;
      if( inv[i] ->query("keepto") )
        if( !(inv[i] ->query("keep_id")== log_id(me) ))
           if( inv[i] ->query("keepto")!= log_id(me) )
             continue;
      do_get(me, inv[i],0);
    }

    write("Ok。\n");
    return 1;
  }

// added by mon to incorporate the "bian" function.
  obj = present(arg, env);
  if(!objectp(obj) || obj==this_player())
    return notify_fail("你要拿什么东西？\n");
  else
  {
    if((obj->query_temp("d_mana"))>0)
    {
      if( obj->query_temp("is_living")==1 || obj->query_temp("k_bian"))
        return notify_fail("你附近没有这样东西。\n");
      else
      {
         no_get = obj->query("no_get");
         if( no_get
           && !(wizardp(me) && me->query("env/override")))
           return notify_fail(stringp(no_get) ? no_get : "这个东西拿不起来。\n");
         old_env = environment(obj);
         if( obj->move(me) )
         {
           if( me->is_fighting() )
             me->start_busy(1);
           message_vision( sprintf("$N%s一%s$n。\n",
           old_env==environment(me)?  "捡起": (old_env->is_character() ?
                            "从" + old_env->name() + "身上" + "搜出":
                            "从" + old_env->name() + "中拿出"),
                            undefinedp(obj->query_temp("unit"))?
	                    "个":obj->query_temp("unit") ), me, obj);
           return 1;
         }

         else
           return 0;
      }

    }

    else
    {
      if(obj->is_character() && living(obj) )
        return notify_fail("你连活人也要拿吗？\n");
    }

  }

  if( wiz_status != "(admin)" && wiz_status != "(arch)" && userp(me) )
  {
    if( obj->query_temp("dig_money") && obj->query_temp("dig_money") != me->query("id") )
      return notify_fail(HIG"这是 "+obj->query_temp("dig_money")+" 挖出来的金钱，你不能趁火打劫！\n"NOR);
    if( obj ->query_temp("seed_money") && obj ->query_temp("seed_money") != me->query("id") )
      return notify_fail(HIG"这是 "+obj->query_temp("seed_money")+" 摇出来的金钱，你不能趁火打劫！\n"NOR);
    if( obj ->query("keepto") )
    {
      if( !(obj ->query("keep_id")== log_id(me) ))
      {
        if( obj ->query("keepto")!= log_id(me) )
          return notify_fail(HIG"这样东西是被"+obj->query("keep_id")+"做了 "HIR"〆 "HIG"记号给"
                 +obj ->query("keepto")+"的，你拿不起来！\n"NOR);
      }

    }

  }

  no_get = obj->query("no_get");
  if( no_get && !(wizardp(me) && me->query("env/override")))
    return notify_fail(stringp(no_get) ? no_get : "这个东西拿不起来。\n");
  return do_get(me, obj,0);
}

int do_get(object me, object obj, object old_env)
{
  int equipped;
  object env;
  if( !objectp(obj))
    return 0;
  if(!objectp(old_env))
    old_env = environment(obj);
  if (!wizardp(me))
  {
    if( obj->is_character() )
    {
      if( living(obj) )
        return 0;
    }

    else
    {
      if( obj->query("no_get") )
        return 0;
    }

  }

  env = environment(me);
  if (!wizardp(me) && userp(me) )
  {
    if( !living(obj) && obj->query("env/no_get") )
      return notify_fail("你怎么背也背不起来。。。\n");
  }

  if( obj->query("equipped") )
    equipped = 1;
  if( obj->move(me) )
  {
    if( me->is_fighting() )
      me->start_busy(1);
    if (!obj)
      return 0;
    if( obj->is_character() )
      message_vision( "$N将$n扶了起来背在背上。\n", me, obj );
    else
      message_vision( sprintf("$N%s一%s$n。\n",
           (!old_env || old_env==environment(me))? "捡起":
                (old_env->is_character() ?
                 "从" + old_env->name() + "身上" + (equipped? "除下" : "搜出"):
                 "从" + old_env->name() + "中拿出"),
             undefinedp(obj->query("unit"))?
                 "个":obj->query("unit") ), me, obj );
    return 1;
  }

  else
    return 0;
}

int help(object me)
{
	write(@HELP
指令格式 : get <物品名称> [from <容器名>]

这个指令可以让你捡起地上或容器内的某样物品.
可以使用：set no_get <任何非0值>
设定为自己在昏迷和睡眠的时候不会被别人背起来
系统每次连线默认设定为有效，如果你想取消请用
unset no_get 取消即可

HELP
    );
    return 1;
}

