// drop.c
inherit F_CLEAN_UP;
#include <command.h>
int do_drop(object me, object obj,int raw);
void create()
{
  seteuid(getuid());
}

int main(object me, string arg)
{
  object obj, *inv, obj2;
  int i, amount;
  string item;
  mixed no_drop;
  if(!wizardp(me) && me->is_busy())
    return notify_fail(WHT"你正忙着呢．．．\n"NOR);
  if(!arg)
    return notify_fail("你要丢弃什么东西？\n");
  if (!environment(me))
    return 0;

  if (environment(me)->do_drop(arg) > 0)
    return 1;
  if(sscanf(arg, "%d %s", amount, item)==2)
  {
    if( !objectp(obj = present(item, me)) )
      return notify_fail("你身上没有这样东西。\n");
    if (no_drop = obj->query("no_drop"))
      return notify_fail(stringp(no_drop) ? no_drop : "这样东西不能丢弃。\n");

    if( !obj->query_amount() )
      return notify_fail( obj->name() + "不能被分开丢弃。\n");
    if( amount < 1 )
      return notify_fail("东西的数量至少是一个。\n");
    if( amount > obj->query_amount() )
      return notify_fail("你没有那么多的" + obj->name() + "。\n");
    if( amount == (int)obj->query_amount() )
      return do_drop(me, obj,0);
    else
    {
      obj->set_amount((int)obj->query_amount() - amount);
      obj2 = new(base_name(obj));
      obj2->set_amount(amount);
      if (! do_drop(me, obj2, 0))
      {
        obj2->move(me);
        return 0;
      }

      if (userp(me) && obj->query_autoload())
        me->save();
      return 1;
    }

  }

  if (arg == "all")
  {
    inv = all_inventory(me);
    for(amount = 0, i = 0; i < sizeof(inv); i++)
    {
      if (! living(me))
        break;
      amount += do_drop(me, inv[i], 1);
    }

    if (! amount)
    {
      write("你什么都没有丢掉。\n");
      return 1;
    }

    message("vision", me->name() + "丢下了一堆东西。\n", environment(me), ({ me }));
    write("丢完了。\n");
    return 1;
  }

  if(!objectp(obj = present(arg, me)))
    return notify_fail("你身上没有这样东西。\n");
  return do_drop(me, obj, 0);
}

int do_drop(object me, object obj, int raw)
{
  mixed no_drop;
  object riding;
  object *inv;
  object env;
  string drop_msg;
  if(!wizardp(me) && me->is_busy())
    return notify_fail(WHT"你正忙着呢．．．\n"NOR);
  if (obj == (riding = me->query_temp("is_riding")))
  {
    message_vision("$N从$n背上飞身跳下。\n", me, riding);
    me->command("dismount " + riding->query("id"));
    if (me->query_temp("is_riding"))
    {
      me->delete_temp("is_riding");
      me->add_temp("apply/dodge",-me->query_temp("ride/dodge"));
      me->delete_temp("ride/dodge",0);
      obj->delete_temp("is_rided_by");
      obj->delete_temp("no_return",0);
    }

    obj->move(environment(me));
    return 1;
  }

  if (no_drop = obj->query("no_drop"))
    return notify_fail(stringp(no_drop) ? no_drop : "这样东西不能随意丢弃。\n");
  if (no_drop = environment(me)->query("no_drop"))
    return notify_fail(stringp(no_drop) ? no_drop : "这里东西丢弃下去也看不见。\n");
  switch ((string)obj->query("equipped"))
  {
    case "worn":
      tell_object(me, obj->name() + "必须脱下来才能丢掉。\n");
      return 0;
    case "wielded":
      tell_object(me, obj->name() + "必须解除装备才能丢掉。\n");
      return 0;
  }

  if(userp(me) && obj->value() >= 100000 && me->add_temp("drop_moneyd") < 20 )
  {
    me->add_temp("drop_moneyd",1);
    write(HIG"警告：频繁仍弃超过50两黄金的金钱将会遭到小鬼抢劫！！！\n"NOR);
  }

  else if(userp(me) && me->add_temp("drop_moneyd") >= 20)
  {
    me->delete_temp("drop_moneyd");
    write(HIG"一只绿色小鬼很快地跑出来，接住你丢下的金钱，然后消失不见了。。。\n"NOR);
    write(HIR"\n由于你频繁仍弃超过50两黄金的金钱，你的金钱被小鬼抢劫了。。。\n"NOR);
    destruct(obj);
    return 1;
  }

  inv = all_inventory(environment(me));
  if(sizeof(inv)>30)
  {
    tell_object(me, "这里东西太多了，你乱丢恐怕" + obj->name() + "就找不到了。\n");
    return 0;
  }

  if( obj->move(environment(me)) )
  {
    if (obj->is_character())
      message_vision("$N将$n从背上放了下来，躺在地上。\n", me, obj);
    else
    {
      if( wizardp(me)
        && (string)SECURITY_D->get_status(me) != "(admin)")
      {
        write(HIG"一只绿色小鬼很快地跑出来，接住你丢下的东西，然后消失不见了！！！\n"NOR);
        destruct(obj);
        return 1;
      }

      env = COLOR_D->clean_color(MISC_D->find_place(environment(me)))+
            COLOR_D->clean_color(environment(me)->query("short"));
      if( wizardp(me) && !obj->value())
      {
        log_file("wizcmds/wiz_drop", sprintf("%s在[%s (%O.c)]仍下一%s%s 时间在：[%s]\n",
                log_id(me),
                env,
                environment(me),
                obj->query("unit"),
                COLOR_D->clean_color(obj->name()),
                log_time()));
      }

      drop_msg = obj->query("drop_msg");
      if (stringp(drop_msg))
      {
      	message_vision(drop_msg, me, obj);
      }

      else
      {
        if (!raw)
          message_vision(sprintf("$N丢下一%s$n。\n", obj->query("unit")), me, obj);
        else
          write("你丢下了一" + obj->query("unit") + obj->name() + "\n");
      }

      if (! obj->query("value") && ! obj->value())
      {
        write("因为这样东西并不值钱，所以人们并不会注意到它的存在。\n");
        destruct(obj);
      }

      else if (obj->query("drop_des"))
      {
        write(obj->name()+"转瞬消失在空气中，不见了。\n");
        destruct(obj);
      }

      if (userp(me) && objectp(obj) && obj->query_autoload())
        me->save();
    }

    return 1;
  }

  return 0;
}

int help(object me)
{
  write(@HELP
指令格式 : drop <物品名称>

这个指令可以让你丢下你所携带的物品.
注意在仍掉某物的同时必须保证该物没有做 keep 记号
并且没有装备，比如你本身穿着衣服不先脱下来是不能
直接仍掉的吧？：P

相关指令：keep，keepto, unwield，remove/tuo
HELP
);
  return 1;
}

