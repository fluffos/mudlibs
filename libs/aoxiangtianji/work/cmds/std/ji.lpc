#include <ansi.h>
inherit F_CLEAN_UP;
#include "/cmds/std/valid_kill.h"
void create()
{
  seteuid(getuid());
}

int main(object me, string arg)
{
  string targetname, fabaoname;
  object target, fabao;
  mixed no_ji;
  if (!me)
    return 0 ;

  if( environment(me)->is_safty()
   || environment(me)->query("no_kill")
   || environment(me)->query("no_fight")
   || environment(me)->query("no_magic"))
    return notify_fail(GRN"这里不能用法宝！\n"NOR);

  if( !arg )
    return notify_fail("你要祭哪样法宝？\n");
  if((int)me->query("level") <= 25 )
    return notify_fail(GRN"你的能力太差了，不能祭法宝！ \n"NOR);
// Check if correct format is followed
  if( sscanf(arg, "%s on %s", fabaoname, targetname)>2 )
    return notify_fail("指令格式 : ji <法宝名称> [on <目标>]\n");
  if( sscanf(arg, "%s on %s", fabaoname, targetname)==2 )
  {
    if(!objectp(fabao = present(fabaoname, me)))
      return notify_fail("你没有这样的法宝。\n");

    if (me->is_busy() && !fabao->query("no_busy"))
      return notify_fail("你上一个动作还没有完成，无暇分身祭法宝。\n");

    if(!objectp(target = present(targetname, environment(me))))
      return notify_fail("这里没有你想要对付的人。\n");

    if(target==me)
      return notify_fail("对自己祭法宝？\n");

    no_ji = target->query("no_ji");

    if (no_ji)
      return notify_fail(stringp(no_ji) ? no_ji : "你不能对这个目标祭法宝。\n");
    if(!valid_kill(me,target,0))
      return 0;

    if( userp(me) && userp(target) && me->query_condition("killer") )
      return notify_fail(HIR"你刚杀过人，不能出手杀人。\n"NOR);

    if( userp(me) && userp(target) && target->query_temp("netdead") )
      return notify_fail("对方正在断线中，不能对其ji法宝。\n");

    if (userp(me) && userp(target))
    {
      if( !target
       || !target->is_character()
       || !me->is_fighting(target)
       || !living(target))
        return notify_fail("不是在战斗中，不可以对玩家祭法宝！\n");
    }
    return fabao->ji(targetname);
  }

  fabao=present(arg, me);
  if(!fabao)
    return notify_fail("你没有" + arg +"这样法宝。\n");
  if (me->is_busy() && !fabao->query("no_busy"))
   return notify_fail("你上一个动作还没有完成，无暇分身祭法宝。\n");
  return fabao->ji();
}

int help(object me)
{
    write(@HELP
指令格式 : ji <法宝名称> [on <目标>]
这个指令可以让你祭一项法宝。
HELP
);
  return 1;
}

