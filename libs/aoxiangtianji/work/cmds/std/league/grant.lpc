// league command: grant
#include <ansi.h>
void create() { seteuid(getuid()); }

int main(object me, string arg)
{
  string id,msg;
  int lvl;

  if (!playerp(me) || !arg)
    return 0;
  if (sscanf(arg,"%s %d",id,lvl) != 2)
  {
    id = arg;
    lvl = 0;
  }

  msg = LEAGUE_D->grant_member(id, me,lvl);
  if (!stringp(msg))
    return 0;
  write(msg);
  return 1;
}

