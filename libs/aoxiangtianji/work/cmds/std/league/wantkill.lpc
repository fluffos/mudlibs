// league command: wantkill
#include <ansi.h>
void create() { seteuid(getuid()); }

int main(object me, string arg)
{
  string msg,type;
  string league_id, pid;
  string *wantkill;
  int i;

  if (!playerp(me))
    return 0;
  league_id = LEAGUE_D->query_player_league_id(me);
  if (!stringp(league_id))
    return notify_fail("你还不是任何联盟的成员。\n");
  if (!arg)
  {
     wantkill= LEAGUE_D->query_league_want_kill(league_id);
    if (!arrayp(wantkill) || sizeof(wantkill) < 1)
      return notify_fail("你的联盟当前没有针对任何玩家发出追杀令。\n");
    msg = "你所在的联盟当前的追杀令如下：\n";
    for (i=0;i<sizeof(wantkill);i++)
      msg += sprintf("%s\n",
                     wantkill[i]);
    msg += "\n";
    me->start_more(msg);
    return 1;
  }

  if (LEAGUE_D->query_league_leader(league_id) != me->query("id"))
    return notify_fail("只有盟主才能操作追杀命令。\n");

  if (sscanf(arg,"-%s %s",type,pid) != 2)
  {
    type = 0;
    pid = arg;
  }

  else if (type != "cancel")
    return notify_fail("请注意，要结束追杀某个玩家，league enemy -cancel [玩家id]。\n");

  if (type == "cancel")
    msg = LEAGUE_D->remove_a_want_kill(league_id, pid);
  else
    msg = LEAGUE_D->add_new_want_kill(league_id,pid);
  if (!stringp(msg))
    return 0;
  write(msg);
  return 1;
}