// league command: expell
#include <ansi.h>
void create() { seteuid(getuid()); }

int main(object me, string arg)
{
  string id,msg;
  int force;

  if (!playerp(me))
    return 0;
  if (sscanf(arg,"%s %d",id,force) != 2)
  {
    id = arg;
    force = 0;
  }

  msg = LEAGUE_D->remove_member_from_league(id, me,force);
  if (!stringp(msg))
    return 0;
  write(msg);
  return 1;
}