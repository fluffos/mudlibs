// league command: dismiss
#include <ansi.h>
void create() { seteuid(getuid()); }

int main(object me, string arg)
{
  string league_id;

  if (!playerp(me))
    return 0;
  league_id = LEAGUE_D->query_player_league_id(me);
  if (!stringp(league_id))
    return notify_fail("你还不是任何联盟的成员。\n");

  if (LEAGUE_D->query_league_leader(league_id) != me->query("id"))
    return notify_fail("只有盟主才能下令解散联盟。\n");
  LEAGUE_D->dismiss_league(league_id);
  write("你下令解散了联盟。\n");
  return 1;
}