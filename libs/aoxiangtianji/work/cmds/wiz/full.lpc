inherit F_CLEAN_UP;
#include <command.h>
int main(object ob,string arg)
{
  string wiz_status;
  object me;
  int jin, qi, hun, neili, fali, lingli, shiwu, yinshui, dz;
  if( ob != this_player(1) )
    return 0;
  wiz_status = SECURITY_D->get_status(ob);
  if( wiz_status != "(admin)" && wiz_status != "(arch)" && wiz_status != "(wizard)" )
    return notify_fail("只有 wizard 以上级别的巫师才能使用这个指令。\n");
  if (wiz_level(me) > wiz_level("(arch)") )
    return notify_fail(HIR"你无权恢复别人的状态！\n"NOR);
  if (!arg)
    me = ob;
  else
  {
     me = present(arg, environment(ob));
     if (!me)
       me =  find_player(arg);
     if (!me)
       return notify_fail("你要恢复谁的状态？\n");
  }

  if (!wizardp(me) && userp(me))
  {
//By waiwai@2001/06/18 只记录和显示full player的数据和信息
    log_file("wizcmds/full",sprintf("%s 用full指令恢复过 %s 时间在: [%s]\n",
       log_id(ob), log_id(me), log_time() ) );
    if( wiz_status != "(admin)" )
      message("channel:rumor",HIR"『FULL精灵』公正法官(faguan)："HIW"据说"+log_id(ob)
             +"恢复了 "+log_id(me)+" 的身体活力。\n"NOR,users());
  }

  hun = me->query("max_gin");
  jin = me->query("max_sen");
  qi =me->query("max_kee");
  lingli = me->query("max_atman");
  fali = me->query("max_mana");
  neili = me->query("max_force");
  dz = me->query("eff_douzhi");
  shiwu = me->max_food_capacity();
  yinshui = me->max_water_capacity();
  me->set("eff_sen", jin);
  me->set("eff_kee", qi);
  me->set("eff_gin", hun);
  me->set("sen", jin);
  me->set("kee", qi);
  me->set("gin", hun);
//  me->set("douzhi", dz);
//  me->set("atman", lingli);
  me->set("mana", fali);
  me->set("force", neili);
  me->set("food", shiwu);
  me->set("water", yinshui);
  if( wizardp(me) )
  {
    me->set("bellicosity", 100);
//    me->set("shengwang", 100);
    me->clear_condition();
  }

  write(HIY"你喃喃自语念道：天神呀，给我恢复的力量吧！！！\n"NOR);
//Added By waiwai@2001/06/18
  if(!wizardp(me) && userp(me))
  {
    tell_object(me,HIY"你突然被一道神光包围，"+log_id(ob)+"恢复了你身体的活力！！！\n"NOR);
  }

  return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : full
此指令可让你恢复所有的精气。
HELP
    );
    return 1;
}

