#include <command.h>
inherit F_CMD;
inherit F_CLEAN_UP;
int main(object me, string str)
{
  object ob, env;
  string wiz_status, wiz_status2;
  if( me != this_player(1) )
    return 0;
  wiz_status2 = SECURITY_D->get_status(me);
  if (!str)
    return notify_fail("指令格式: Summon <ID>\n");
  ob = LOGIN_D->find_body(str);
  if (!ob)
    ob = LOGIN_D->find_body(str);
  if (!ob)
    return notify_fail(HIR "咦。。。有这个人吗？\n" NOR);
  if(wizardp(ob) && wiz_level(me) < wiz_level(ob))
    return notify_fail(HIR "咦。。。有这个人吗？\n" NOR);
  if ( ob==me )
    return notify_fail(HIR"抓自己？你比较有创意哦。\n"NOR);
  wiz_status = SECURITY_D->get_status(ob);
  if( wiz_status == "(admin)" )
    return notify_fail(HIW "请相互尊重，不要随意对天神做这个动作！\n" NOR);
  if(present(ob, environment(me)))
    return notify_fail(log_id(ob)+"已经在你面前了。。。。\n");
  env = environment(ob);
  tell_room(env, YEL"隐约听到有人在召唤"+log_id(ob)+"。。。瞬间"+log_id(ob)+"便不由自主地被一股力量吸引而去。。。\n"NOR, ob);
  ob->move(environment(me));
  tell_object(me, HIW + "你对空高喊："+log_id(ob)+"何在。。。瞬然间"+log_id(ob)+"被你召唤到了你的面前。。。\n" + NOR);
  tell_object(ob, HIW"你隐约听到有人在召唤："+log_id(ob)+"。。。\n"NOR);
  tell_object(ob, HIW"恍惚间一股神秘的力量使你来到了"+log_id(me)+"的身边。。。\n"NOR);
  tell_room(environment(ob), YEL+log_id(ob)+"突然出现"+ "在你眼前。。。。\n"NOR, ({me,ob}));
  if(!wizardp(ob) && wiz_status2 != "(admin)" )
  {
    message("channel:system",
    HIR"┋公正法官┋"+log_id(me)+"把"+log_id(ob)+"从"+env->query("short")+HIR"抓到了"HIG+
       "["+MISC_D->find_place(environment(me))+environment(me)->query("short")+HIG"]\n"NOR, users());
    log_file("wizcmds/summon_log", sprintf("%s把%s从%s%s(%O.c)抓到\n%s%s(%O.c) 时间在：[%s] \n",
           log_id(me), log_id(ob), MISC_D->find_place(env), filter_color(env->query("short")), env,
           MISC_D->find_place(environment(me)), filter_color(environment(me)->query("short")),
           environment(me), log_time() ));
  }

  return 1;
}

int help(object me)
{
write(@HELP
指令格式 : summon <某人>
此指令可让你将某人召唤到你的面前。。。。
HELP
    );
    return 1;
}

