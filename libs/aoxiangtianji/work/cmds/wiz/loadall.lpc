#include <ansi.h>
inherit F_CLEAN_UP;
string *color=({ HIR, HIG, HIY, HIB, HIM, HIC, HIW});
int i;
int help(object me);
int loadall(string dir );
int main(object me, string dir)
{
	if(!dir)dir="/";
	if(dir[<1]!='/') dir+="/";
	if(file_size(dir)!=-2)
		return notify_fail(dir+"not exist。\n");
	//log_file("loadall", "查错#check dir :" + dir +"\n");
	write("check dir "+dir+"\n" );
	i=0;
	if(loadall(dir ))
	return 1;
}

int loadall(string dir )
{
	string file,err,*dirs,blank="            ";
    if(!arrayp(get_dir(dir)))
		return 1;
	dirs=get_dir(dir);
	if(dir=="/")
		dirs = dirs - ({".git", ".vscode", "backup", "bin", "binaries","cygdrive","dev", "fluffos", "data", "doc", "dump", "grant", "help", "log", "mudos","proc","temp", "u", "version"});

	write(color[i]+blank[0..i]+"┏ checking "+dir+"\n");
	foreach(file in dirs)
	{
		if( member_array(file,({"simul_efun","phome"})) > -1 )
		continue;

		reset_eval_cost();
		switch(file_size(dir+file))
		{
			case -1:
				//无法读取该目录，跳过
				break;
			case -2:
				if(file!="."&&file!="..")
				{i++; loadall(dir+file+"/");}

				break;
			default:

				if((dir+file)[<2..]==".lpc")
				{
					if(err=catch( load_object(dir+file) ))
						log_file("loadall", dir+file+"\n--" + err );
				}

		}

	}

	write(color[i]+blank[0..i]+"┗ "+dir+" is over!\n");
	i--;
	return 1;
}

int help (object me)
{
        write(@HELP
    载入某个目录下的所有.c文件(包含子目录)，以查找所有
可能的编译错误。

指令格式： loadall [dir]
比如      loadall /d/city/
没有 dir，则dir默认为 / ，文件太多可能会卡一会。
HELP
        );
        return 1;
}

