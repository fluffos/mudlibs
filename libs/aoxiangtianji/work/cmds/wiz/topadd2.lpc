#include <command.h>
inherit F_CLEAN_UP;
inherit F_CMD;
int main(object me)
{
   object *user = users();
   if (me!=this_player(1))
     return 0;
   for (int i=0;i<sizeof(user);i++)
   {
     "/adm/daemons/weapontopd"->topten_checkplayer(user[i]);
     reset_eval_cost();
    }

    write(WHT"武功排行版更新完毕!\n\n"NOR);
    CHANNEL_D->do_channel(me, "adm","用topadd2指令更新了武功排行榜！\n"NOR);
    log_file("wizcmds/topadd2",sprintf("%s用topadd2更新过武功排行榜 时间在: [%s] \n",
           log_id(me), log_time() ) );
    return 1;
 }

