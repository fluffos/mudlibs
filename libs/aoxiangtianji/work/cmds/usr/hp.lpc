#include <ansi.h>
inherit F_CLEAN_UP;
string status_colorS(int current, int max);
string status_color(int current, int max);
string check_daoxing(int gain);
int main(object me, string arg)
{
  object ob;
  mapping my;
  int dao, deaddao, weapon;
  string logon_s, str, attack_skill;
  int sq;
  seteuid(getuid(me));

  if(!arg)
    ob = me;
  else if (wizardp(me))
  {
    ob = present(arg, environment(me));
    if (!objectp(ob))
      ob = find_player(arg);
    if (!objectp(ob))
      ob = find_living(arg);
    if (!objectp(ob))
      return notify_fail("你要察看谁的状态？\n");
  }

  else
    return notify_fail("只有巫师能察看别人的状态。\n");
  if( wiz_level(me) < wiz_level(ob) )
    return notify_fail("你要察看谁的状态？\n");
  if (ob->query("logon_power") > 32400)
    logon_s = HIG"兴趣盎然"NOR;
  else if (ob->query("logon_power") > 21600)
    logon_s = HIW"略感疲倦"NOR;
  else if (ob->query("logon_power") > 10800)
    logon_s = HIM"疲惫不堪"NOR;
  else
    logon_s = HIR"极度疲乏"NOR;

  my = ob->query_entire_dbase();
  printf(WHT"\n┏━━━━━━━━━ ""战斗等级: %s(-%d)   职业：%s%s   连线状态：%s%s(%d) ━━━━━━━┓\n"NOR,
              UPEXP_D->query_upexp(ob),
              UPEXP_D->query_next_exp(ob),
              UPEXP_D->query_occupation(ob),
              WHT,
              logon_s,
              WHT,
              (int)ob->query("logon_power"));
  if(my["force"]<0)
    my["force"]=0;
  printf("  ·气血· %s%4d(%d)/ %4d(%d) %s(%3d%%)" NOR" ·内力· %s%4d / %4d (%3d%%) (+%d)\n" NOR,
                  status_color(my["kee"], my["eff_kee"]),
                  my["kee"],
                  me->query_temp("apply/kee"),
                  my["eff_kee"],
                  me->query_temp("apply/eff_kee"),
                  status_color(my["eff_kee"],
                  my["max_kee"]),
                  my["eff_kee"] * 100 / my["max_kee"],
                  status_color(my["force"],
                  my["max_force"]),
                  my["force"],
                  my["max_force"],
                  my["maximum_force"] ? my["max_force"] * 100 / my["maximum_force"] : 100,
                  my["force_factor"] );
  if(my["mana"]<0)
    my["mana"]=0;
  printf("  ·精神· %s%4d(%d)/ %4d(%d) %s(%3d%%)" NOR" ·法力· %s%4d / %4d (%3d%%) (+%d)\n" NOR,
                  status_color(my["sen"], my["eff_sen"]),
                  my["sen"],
                  me->query_temp("apply/sen"),
                  my["eff_sen"],
                  me->query_temp("apply/eff_sen"),
                  status_color(my["eff_sen"],
                  my["max_sen"]),
                  my["eff_sen"] * 100 / my["max_sen"],
                  status_color(my["mana"], my["max_mana"]),
                  my["mana"],
                  my["max_mana"],
                  my["maximum_mana"] ? my["max_mana"] * 100 / my["maximum_mana"] : 100,
                  my["mana_factor"] );

  if(my["food"]*100/ob->max_food_capacity()>100) str=HIC"辟谷";
  else if(my["food"]*100/ob->max_food_capacity()>90) str=HIG"很饱";
  else if(my["food"]*100/ob->max_food_capacity()>80) str=HIY"正常";
  else if(my["food"]*100/ob->max_food_capacity()>60) str=HIY"正常";
  else if(my["food"]*100/ob->max_food_capacity()>40) str=HIY"缺食";
  else if(my["food"]*100/ob->max_food_capacity()>35) str=HIY"缺食";
  else if(my["food"]*100/ob->max_food_capacity()>30) str=HIY"缺食";
  else if(my["food"]*100/ob->max_food_capacity()>29) str=HIY"缺食";
  else if(my["food"]*100/ob->max_food_capacity()>25) str=HIR"缺食";
  else if(my["food"]*100/ob->max_food_capacity()>20) str=HIR"缺食";
  else if(my["food"]*100/ob->max_food_capacity()>10) str=HIR"缺食";
  else str=HIR"饥饿";
  printf(NOR"  ·食物· %s%4d/ %4d "HIG"("NOR"%4s%s"HIG")"NOR,
                  status_color(my["food"],
                  ob->max_food_capacity()),
                  my["food"],
                  ob->max_food_capacity(),
                  str,
                  status_color(my["food"],
                  ob->max_food_capacity()));
  printf(NOR"       ·武学· %s%d[-%d]\n"NOR,HIY,
                  (int)ob->query("combat_exp"),
                  (int)ob->query("death/exp_loss"));
  if(my["water"]*100/ob->max_water_capacity()>100) str=HIC"辟谷";
  else if(my["food"]*100/ob->max_food_capacity()>90) str=HIG"很饱";
  else if(my["water"]*100/ob->max_water_capacity()>80) str=HIY"正常";
  else if(my["water"]*100/ob->max_water_capacity()>60) str=HIY"正常";
  else if(my["water"]*100/ob->max_water_capacity()>40) str=HIY"缺水";
  else if(my["water"]*100/ob->max_water_capacity()>35) str=HIY"缺水";
  else if(my["water"]*100/ob->max_water_capacity()>30) str=HIY"缺水";
  else if(my["water"]*100/ob->max_water_capacity()>29) str=HIY"缺水";
  else if(my["water"]*100/ob->max_water_capacity()>25) str=HIR"缺水";
  else if(my["water"]*100/ob->max_water_capacity()>20) str=HIR"缺水";
  else if(my["water"]*100/ob->max_water_capacity()>10) str=HIR"缺水";
  else str=HIR"饥渴";
  printf("  ·饮水· %s%4d/ %4d "HIG"("NOR"%4s%s"HIG")",
           status_color(my["water"], ob->max_water_capacity()),
  my["water"], ob->max_water_capacity(),str,
           status_color(my["water"], ob->max_water_capacity()));

  dao=(int)ob->query("daoxing");
  deaddao=(int)ob->query("death/dx_loss");

  if( deaddao<0 ) ob->set("death/dx_loss",0);
  if( !dao || dao<0 ) dao=0;
  if( dao >0 && deaddao>0)
    printf(NOR"       ·道行· "WHT"%s[-%s]\n"NOR,
        check_daoxing(dao), check_daoxing(deaddao) );
  else  if( dao >0 && !deaddao)
    printf(NOR"       ·道行· "WHT"%s[-0]\n"NOR, check_daoxing(dao) );
  else
    printf(NOR"       ·道行· "WHT"没有道行\n"NOR);
  sq = ob->query_cps()*60;
  if(sq>5000)
    sq=5000;
  if(userp(ob))
    if( my["bellicosity"]>sq)
      ob->set("bellicosity",sq);
  printf("  ·杀气· %s%4d"NOR HIG"/ %4d (%3d%%) "NOR
         "      ·潜能· "YEL"%d(%3d%%)[-%d]"NOR
         "      ·实战体会· "YEL"%d(%3d%%)\n "NOR,
      status_colorS(my["bellicosity"],sq),
      my["bellicosity"],
      sq,
      (1 +my["bellicosity"]) ? (1 + my["bellicosity"]) * 100 / (1 +sq) : 100,
      (int)ob->query("potential") - (int)ob->query("learned_points"),
      (1 +(int)ob->query("potential")) ?
      (1 + (int)ob->query("learned_points")) * 100 / (1 +(int)ob->query("potential")) : 100,
      ob->query("death/qn_loss"),
      (int)ob->query("experience") - (int)ob->query("learned_experience"),
      (1 +(int)ob->query("experience")) ?
      (1 + (int)ob->query("learned_experience")) * 100 / (1 +(int)ob->query("experience")) : 100);

  printf(" ·斗志· %s%4d"HIG"/ %4d (%4d)" NOR,
           status_color(my["douzhi"],my["eff_douzhi"]),
           my["douzhi"],
           my["eff_douzhi"],
           ob->query("anger"));
  printf(NOR"       ·威望· %s%d[-%d]  %s·阅历· %s%d[-%d]\n" NOR,
     YEL,
     (int)ob->query("weiwang"),
     (int)ob->query("death/weiwang"),
     NOR,
     YEL,
     (int)ob->query("score"),
     (int)ob->query("death/score"));

  printf("  ·门派忠诚度·  "WHT"%10-d"NOR"       ·官职· "WHT"%d  \n"NOR,
     ob->query("family/family_faith"),ob->query("office_number"));
  printf("  ·兵器·  "WHT"%10-d"NOR"             ·盔甲· "WHT"%d(VF：%d VS：%d) \n"NOR,
     ob->query_temp("apply/damage"),
     ob->query_temp("apply/armor"),
     ob->query_temp("apply/armor_vs_force"),
     ob->query_temp("apply/armor_vs_spells"));

  weapon = ob->query_temp("weapon");
  if( objectp(weapon) )
  {
    if( weapon->query("use_apply_skill") )
      attack_skill = weapon->query("apply/skill_type");
    else
      attack_skill = weapon->query("skill_type");
  }

  else
    attack_skill = "unarmed";

  printf("  ·战斗力·  "WHT"%10-d"NOR"           ·防御力· "WHT"%d(%d) \n"NOR,
     COMBACC_D->math_ap(ob,attack_skill),
     COMBACC_D->math_dp(ob,ob,0,0),
     COMBACC_D->math_pp(ob,ob,0,0));
  printf("  ·法术攻击力·  "WHT"%10-d"NOR"       ·法术防御力· "WHT"%d \n"NOR,
     SPELL_D->math_ap(ob),
     SPELL_D->math_dp(ob));
/*
  deaddao_last = (int)ob->query("death/last_dx_loss");
  printf(GRN"  ·上次死亡损失：    \n"NOR
      HIR"       武学：%d\n"NOR
      HIR"       道行：%s\n"NOR
      HIR"       潜能：%d\n"NOR,
     (int)ob->query("death/last_exp_loss"),
     (deaddao_last>0) ? check_daoxing(deaddao_last):"没有道行损失",
     (int)ob->query("death/last_qn_loss"));
  if (ob->query("death/skill_loss"))
    printf(HIR"       损失一级技能\n"NOR);
*/
  printf(WHT"┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"HIR" 翱翔天际 "NOR WHT"━━━━━━━━━━━━━━━━━━━━━┛\n"NOR);
  return 1;
}

string status_color(int current, int max)
{
  int percent;

  if( max>0 )
    percent = current * 100 / max;
  else
    percent = 100;
  if( percent > 100 )
    return HIC;
  if( percent >= 90 )
    return HIG;
  if( percent >= 60 )
    return HIY;
  if( percent >= 30 )
    return YEL;
  if( percent >= 10 )
    return HIR;
  return RED;
}

string status_colorS(int current, int max)
{
  int percent;

  if( max>0 )
    percent = current * 100 / max;
  else
    percent = 100;
  if( percent > 100 )
    return HIR;
  if( percent >= 99 )
    return BLINK HIR;
  if( percent >= 50 )
    return HIR;
  if( percent >= 30 )
    return RED;
  if( percent >= 10 )
    return RED;
  return RED;
}

string check_daoxing(int gain)
{
  int year,day,hour;
  string str;
  year=gain/1000;
  day=(gain-year*1000)/4;
  hour=(gain-year*1000-day*4)*3;
  str="";
  if(year) str=str+(year)+"年";
  if(day) str=str+(day)+"天";
  if(hour) str=str+(hour)+"时辰";
  return str;
}

int help(object me)
{
	write(@HELP
指令格式 : hp
           hp <对象名称>                   (巫师专用)

这个指令可以显示你或指定对象(含怪物)的精, 气, 神数值。

see also : score
HELP
    );
    return 1;
}

