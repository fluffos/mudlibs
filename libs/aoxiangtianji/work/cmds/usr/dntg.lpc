inherit F_CLEAN_UP;
#include <ansi.h>
#include <dntg.h>
int telling1 (object who);
string name;
int main(object me, string arg)
{
  object ob;
  seteuid(getuid());
  if( !arg )
  {
    ob = me;
    name = "你";
  }

  else if (wizardp (me))
  {
    ob = find_player(arg);
    if(!objectp(ob))
      ob = find_living(arg);
    if(!objectp(ob))
      ob = LOGIN_D->find_body(arg);
    if(!ob || !me->visible(ob))
      return notify_fail("没有这个人。\n");
    name = ob->query("name");
  }

  else
    return 0;
  telling1(ob);
  return 1;
}

int help()
{
  write(@TEXT
指令格式：dntg <某人>
显示某人大闹天宫的资料。
请见：help qujing
TEXT
);
  return 1;
}

int telling1 (object who)
{
  int nb,i, dx, qn;
  string msg;

  string *names = ({
    "huaguo",
    "donghai",
    "hell",
    "bmw",
    "lijing",
    "pantao",
    "yaochi",
    "laojun",
    "erlang",
    "laojunlu",
  });

  nb = (int)who->query("dntg/number");
  msg = HIW"\n\t========你的大闹天宫状况========\n\n"NOR;
  for(i=0;i<sizeof(names);i++)
  {
    if (nb > i)
      msg += HIG;
    else if (nb == i)
      msg += BLINK + HIR;
    else
      msg += HIY;
    msg += "\t ";
    msg += obstacles[names[i]];
    msg += "\n"NOR;
  }

  msg += HIW"\n\t================================\n\n"NOR;
  if (nb == 0)
    msg += HIM"你还没有做过大事！\n"NOR;
  else
  {
    dx = who->query("dntg/dx");
    qn = who->query("dntg/qn");
    msg += HIW"你已经过了" + chinese_number(nb) + "关！\n"NOR;
    msg += HIW"你累计获得道行奖励" + HIY + COMBAT_D->chinese_daoxing(dx)
         + HIW" 潜能" + HIY + chinese_number(qn) + "点" HIW"\n"NOR;
  }

  write(msg);
  return 1;
}