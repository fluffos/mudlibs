#include <ansi.h>
inherit F_CLEAN_UP;
int help(object me);
void create() { seteuid(getuid()); }

int main(object me, string arg)
{
  string map,name,name2,fname,*pname,msg,name1;

  if (me != this_player(1))
    return 0;

  if( !arg )
  {
    msg = HIY"map 地图查阅指令使用说明：\n"NOR;
    msg += "────────────────────────────────────\n";
    msg += "map 显示本帮助文件。\n";
    msg += "map here 查阅本地地图。  彩色处是你当前所在地区。\n";
    msg += "map main 查阅总图。\n";
    msg += "────────────────────────────────────\n";
    me->start_more(msg);
    return 1;
  }

  if( arg == "main" )
  {
    map = read_file("/doc/help/maps/total-map");
    me->start_more(map);
    return 1;
  }

  if( arg == "here")
  {
    fname = file_name(environment(me));
    pname = explode(fname,"/");
    name = domain_file(fname);
    name2 = pname[2];

    switch (name)
    {
      case "city" :
        map = read_file("/doc/help/maps/changan-map");
        break;
      case "changan-e" :
        map = read_file("/doc/help/maps/changane-map");
        break;
      case "changan-s" :
        map = read_file("/doc/help/maps/changans-map");
        break;
      case "dntg" :
        map = read_file(sprintf("/doc/help/maps/%s-map",name2));
        break;
      case "eastsea" :
        map = read_file("/doc/help/maps/sea-map");
        break;
      case "huanggong" :
        map = read_file("/doc/help/maps/changan-map");
        break;
      case "meishan" :
        map = read_file("/doc/help/maps/guanjiang-map");
        break;
      case "nanhai" :
        map = read_file("/doc/help/maps/putuo-map");
        break;
      case "qujing"  :
      {
        switch (name2)
        {
          case "baotou" :
            map = read_file("/doc/help/maps/qujing/yuhua-map");
            break;
          case "gao" :
            map = read_file("/doc/help/maps/qujing/yunzhan-map");
            break;
          case "huangfeng" :
            map = read_file("/doc/help/maps/qujing/huangfengling-map");
            break;
          case "jisaiguo" :
            map = read_file("/doc/help/maps/qujing/jisai-map");
            break;
          case "maoying" :
            map = read_file("/doc/help/maps/qujing/tianzhu-map");
            break;
          case "qilin" :
            map = read_file("/doc/help/maps/qujing/zhuzi-map");
            break;
          case "qinglong" :
            map = read_file("/doc/help/maps/qujing/jinping-map");
            break;
          case "village" :
            map = read_file("/doc/help/maps/qujing/liusha-map");
            break;
          case "wuzhuang" :
            map = read_file("/doc/help/maps/qujing/wzg-map");
            break;
          case "zhujie" :
            map = read_file("/doc/help/maps/qujing/yuhua-map");
            break;
          default :
            map = read_file(sprintf("/doc/help/maps/qujing/%s-map",name2));
        }

        break;
      }

      default :
        map = read_file(sprintf("/doc/help/maps/%s-map",name));
        break;
    }

    if(stringp(map))
    {
      name1 = environment(me)->query("short");
      map = replace_string(map, name1, HIR+name1+NOR);
    }

    else
      return notify_fail("目前本站尚未提供此地图！\n");
    me->start_more(color_filter(map));
  }

  else
    return notify_fail("很遗憾，目前没有提供这里的地图。\n");
  return 1;
}

int help(object me)
{
  string msg;

  msg = HIY"map 地图查阅指令使用说明：\n"NOR;
  msg += "────────────────────────────────────\n";
  msg += "map 显示本帮助文件。  彩色处是你当前所在地区。\n";
  msg += "map here 查阅本地地图。\n";
  msg += "map main 查阅总图。\n";
  msg += "────────────────────────────────────\n";
  me->start_more(msg);
  return 1;
}

