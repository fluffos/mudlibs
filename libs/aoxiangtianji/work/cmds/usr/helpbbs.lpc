#define DOC_HELP_DIR "/doc/help/"
void create()
{
  seteuid(getuid());
}

int helpmore(string cmd, string *text, int line)
{
  int i;
  switch(cmd)
  {
    case "b":
      line = line - 46;
      if(line<-22)
        return 1;
      for(i=line + 23; line < i;line++)
        write(color_filter(text[line])+"\n");
      break;
    case "q":
      check_nowait();
      return 1;

 //   case "":
	default:
      for(i=line + 23; line<sizeof(text) && line<i; line++)
        write(color_filter(text[line]) + "\n");
      if( line>=sizeof(text) )
      {
        printf("== 全文完" HIY "%d%%" NOR " == (ENTER 返回上个选单)",(line*100/sizeof(text)) );
        check_user();
        return 1;
      }
 //     break;

  }

  printf("== 未完继续 " HIY "%d%%" NOR " == (ENTER 继续下一页，q 离开，b 前一页)",(line*100/sizeof(text)) );
  input_to("helpmore", text, line);
}

void start_help(string msg)
{
  if (!stringp(msg))
  {
    write("没有这个文件！\n");
    return;
  }

  helpmore("", explode(msg, "\n"), 0);
}

void check_nowait()
{
  object me = this_player();

  if (!playerp(me))
    return;
  if( me->query_temp("help_n"))
    confirm_n_choice("");
  else if( me->query_temp("help_g"))
    confirm_g_choice("");
  else if( me->query_temp("help_d"))
    confirm_d_choice("");
  else if( me->query_temp("help_u"))
    confirm_u_choice("");
  else if( me->query_temp("help_m"))
    confirm_m_choice("");
  else if( me->query_temp("help_m1"))
    confirm_m1_choice("");
  else if( me->query_temp("help_m2"))
    confirm_m2_choice("");
  else if( me->query_temp("help_m3"))
    confirm_m3_choice("");
  else if( me->query_temp("help_m4"))
    confirm_m4_choice("");
  return;
}

void check_user()
{
  object me = this_player();

  if (!playerp(me))
    return;
  if( me->query_temp("help_n"))
    input_to((: confirm_n_choice :),me);
  else if( me->query_temp("help_g"))
    input_to("confirm_g_choice",me);
  else if( me->query_temp("help_d"))
    input_to("confirm_d_choice",me);
  else if( me->query_temp("help_u"))
    input_to("confirm_u_choice",me);
  else if( me->query_temp("help_m1"))
    input_to("confirm_m1_choice",me);
  else if( me->query_temp("help_m2"))
    input_to("confirm_m2_choice",me);
  else if( me->query_temp("help_m3"))
    input_to("confirm_m3_choice",me);
  else if( me->query_temp("help_m4"))
    input_to("confirm_m4_choice",me);
  else if( me->query_temp("help_m"))
    input_to("confirm_m_choice",me);
  return;
}

int main(object me, string arg)
{

  if(!arg)
  {
    me->set_temp("help",1);
    m_display();
    write(YEL"你现在的打算："NOR);
    input_to((: confirm_main_choice :),me);
    return 1;
  }

  HELP_CMD->main(me, arg);
  return 1;
}

void view_main()
{
  string name,select;
  object me = this_player();
  if (!playerp(me))
    return;
  select = me->query_temp("select");
  write(CLR"\n");
  if(select== "main")
    name = BRED HIY"游戏指南"NOR;
  else if( select== "newbie")
    name = "新手指南";
  else if( select== "game")
    name = "游戏主题";
  else if( select== "depart")
    name = "门派介绍";
  else if( select== "map")
    name = "地形指南";
  else if( select== "user")
    name = "个人设定区";
  else if( select== "board")
    name = "布告栏";
  write(BBLU HIY"分类选单"NOR"                   " HIR"〖 "+HIG+BRED+CHINESE_MUD_NAME+NOR+HIR" 〗"
        "                  "BBLU HIY"选单["+select+"]\n"NOR);
  write("目前选择：[ "+name+" ]\n");
  write(HIG"◎"NOR CYN"━━━━━━━━━━━━━━"HIR"┃"BLINK BBLU HIR" 公告版 "NOR
        HIR"┃"NOR CYN"━━━━━━━━━━━━━━"NOR HIG"◎\n"NOR);
  auto_load();
  write(HIG"◎"NOR CYN"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"NOR HIG"◎	\n"NOR);
  write("\n");
}

void view_main_1()
{
  int ppl_cnt;
  object *usr;

  usr = users();
  usr = filter_array(usr,(: playerp($1) :));
  ppl_cnt = sizeof(usr);
  write("\n");
  write(YEL"_.-*```*-.__.-*```*-.__.-*```*-.__.-*```*-.__.-*```*-.__.-*```*-.__.-*\n"NOR);
  write("\n");
  write(BCYN RED"北京时间: "+MAG+ctime(time())+"    "NOR+BCYN RED"在线玩家: "+
        MAG+ppl_cnt+"    "NOR+BCYN RED"用户等级: "+MAG+wizhood(this_player())+"\n"NOR,);
  write("\n");
}

