void m_display()
{
  this_player()->set_temp("select","main");
  view_main();
  write("                        "HIR"(n)"NOR"ewbie   〖  "BGRN HIW"新手指南"NOR"  〗\n");
  write("                        "HIR"(g)"NOR"ame     〖  "BMAG HIW"游戏主题"NOR"  〗\n");
  write("                        "HIR"(d)"NOR"epart   〖  "BRED HIW"门派介绍"NOR"  〗\n");
  write("                        "HIR"(m)"NOR"ap      〖  "BCYN HIW"地形指南"NOR"  〗\n");
  write("                        "HIR"(u)"NOR"ser     〖  "BBLU HIW"个人设定区"NOR"〗\n");
  write("                        bo"HIR"(a)"NOR"rd    〖  "BBLU HIW"公告栏"NOR"    〗\n");
  write("                        g"HIR"(o)"NOR"odbye  〖  "HBWHT RED"重归江湖"NOR" 〗\n");
  view_main_1();
}

void u_display()
{
  view_main();
  write("                       "HIC"(Ｉ)"NOR"nfo        个人资料\n");
  write("                       "HIC"(Ｌ)"NOR"ockScreen  锁定萤幕\n");
  write("                       "HIC"(Ｒ)"NOR"egister    填写《注册申请单》\n");
  write("                       "HIC"(Ｐ)"NOR"ager       切换呼叫器\n");
  write("                       "HIC"(Ｇ)"NOR"return     返回主菜单\n");
  view_main_1();
}

int info()
{
  object me = this_player();
  if (!playerp(me))
    return 0;

  write("暂未开放！\n");
  return 1;
}

int register()
{
  object me = this_player();
  if (!playerp(me))
    return 0;

  write("暂未开放！\n");
  return 1;
}

int pager()
{
  object me = this_player();
  if (!playerp(me))
    return 0;

  write("暂未开放！\n");
  return 1;
}

int lock()
{
  object me,ob;
  me = this_player();
  ob = me->query_temp("link_ob");
  write(HIW"▲ 请输入密码，以解除萤幕锁定："NOR);
  input_to("get_old_pass", 1, ob);
  return 1;
}

void get_old_pass(string pass, object ob)
{
  string old_pass;
  old_pass = ob->query("password");
  if( crypt(pass, old_pass)!=old_pass )
  {
    lock();
    return ;
  }

  u_display();
  write(YEL"\r请输入您的选择:"NOR);
  input_to((: confirm_u_choice :),this_player());
  return ;
}

void auto_load()
{
  object me = this_player();

  if (!playerp(me))
    return;

  if( random(20) >  8)
    message(me);
  else
    message1(me);
}

int message1(object me)
{
  int i;
  string msg;
  i = me->query("combat/MKS")+me->query("combat/PKS");
  msg = sprintf(HIC"      "HIC"%s"HIY"大侠"NOR"：你翱翔天际已经 "+BBLU MAG"%s"NOR HIC" 之久！\n"NOR,
                me->name(),FINGER_D->age_string((int)me->query("mud_age")));
  msg += sprintf(HIC"                在你翱翔天际的日日夜夜里, 你已经累积了 "+BYEL HIR+ "%-10d \n"NOR,
                 UPEXP_D->query_total_exp(me));
  msg += sprintf(HIC"                点经验, 共击倒 "+BCYN HIM+"%s"NOR" 个对手,前途不可限量!\n"NOR,
                 chinese_number(i));
  write(msg);
  return 1;
}

int message(object me)
{
 write(HIR"   ●    （ ● ）  （●）      ●）     ●     （●）   □●□   （●\n"NOR);
 write(HIB" ＜｜＞   └｜┘    （（（   （｜     （｜）     ｜）     ｜      （□\n"NOR);
 write(HIY"  ／＼    ＜  □   （         ／ ）    （□     （ ＼   □  □    ＜））\n"NOR);
 write(HIC+me->name()+HIC",玩累了吧？来,我们一起做运动---左三圈，右三圈，脖子扭扭，屁股扭扭...\n"NOR);
}

protected void confirm_n_choice(string arg)
{
  object me = this_player();

  if (!playerp(me))
    return;

  me->set_temp("help_n",1);
  if(!arg || arg=="")
  {
    n_display();
    write(YEL "\r请重新输入您得选择:"NOR);
    input_to((: confirm_n_choice :),me);
    return ;
  }

  switch(arg)
  {
    case "1":
      start_help(read_file(DOC_HELP_DIR"newbie/newbie-know"));
      break;
    case "2":
      start_help(read_file(DOC_HELP_DIR"newbie/new-hits"));
      break;
    case "3":
      start_help(read_file(DOC_HELP_DIR"newbie/gift"));
      break;
    case "4":
      start_help(read_file(DOC_HELP_DIR"newbie/tianxing"));
      break;
    case "5":
      start_help(read_file(DOC_HELP_DIR"newbie/spskill"));
      break;
    case "6":
      start_help(read_file(DOC_HELP_DIR"newbie/world"));
      break;
    case "7":
      start_help(read_file(DOC_HELP_DIR"newbie/weapon"));
      break;
    case "8":
      start_help(read_file(DOC_HELP_DIR"newbie/armor"));
      break;
    case "9":
      start_help(read_file(DOC_HELP_DIR"newbie/book"));
      break;
    case "10":
      start_help(read_file(DOC_HELP_DIR"newbie/time-game"));
      break;
    case "11":
      start_help(read_file(DOC_HELP_DIR"gametopic/channel"));
      break;
    case "12":
      start_help(read_file(DOC_HELP_DIR"concepts/faq"));
      break;
    case "b":
    case "q":
      me->delete_temp("help_n");
      m_display();
      write(YEL "\r请输入您得选择:"NOR);
      input_to((: confirm_main_choice :),me);
      return ;
    default:
      n_display();
      write(YEL"\r请输入您的选择:"NOR);
      input_to((: confirm_n_choice :),me);
      return;
  }

  return;
}

