protected void confirm_main_choice(string arg)
{
  object me = this_player();

  if (!playerp(me))
    return;
  if(arg=="")
  {
    m_display();
    write(YEL "\r请从新输入您得选择:"NOR);
    input_to((: confirm_main_choice :),me);
    return ;
  }

  switch(arg[0])
  {
    case 'o':
    case 'q':
      me->delete_temp("select");
      me->delete_temp("help");
      return;
    case 'u':
      me->set_temp("select","user");
      u_display();
      write(YEL"\r请输入您的选择:"NOR);
      input_to((: confirm_u_choice :),me);
      return ;
    case 'n':
      me->set_temp("select","newbie");
      n_display();
      write(YEL"\r请输入您的选择:"NOR);
      input_to((: confirm_n_choice :),me);
      return ;
    case 'g':
      me->set_temp("select","game");
      g_display();
      write(YEL"\r请输入您的选择:"NOR);
      input_to((: confirm_g_choice :),me);   //confirm_a_choice
      return ;
    case 'd':
      me->set_temp("select","depart");
      d_display();
      write(YEL"\r请输入您的选择:"NOR);
      input_to((: confirm_d_choice :),me);
      return ;
    case 'm':
      me->set_temp("select","map");
      p_display();
      write(YEL"\r请输入您的选择:"NOR);
      input_to((: confirm_m_choice :),me);
      return ;
    case 'a':
      write(RED"\r暂时还未开放公告功能！\n"NOR);
      m_display();
      write(YEL"\r请输入您的选择:"NOR);
      input_to((: confirm_main_choice :),me);
    default:
      m_display();
      write(YEL"\r请输入您的选择:"NOR);
      input_to((: confirm_main_choice :),me);
      return;
  }

  return;
}

int help(object me)
{
  write(@HELP
指令格式 : helpbbs
可以用此命令来详细了解本游戏。
相关命令：HELP
HELP
    );
    return 1;
}