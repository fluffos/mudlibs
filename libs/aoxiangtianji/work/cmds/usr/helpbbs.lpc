protected void confirm_u_choice(string arg)
{
  object me = this_player();
  if (!playerp(me))
    return;

  me->set_temp("help_u",1);
  if(arg=="")
  {
    u_display();
    write(YEL "\r请从新输入您得选择:"NOR);
    input_to((: confirm_u_choice :),me);
    return ;
  }

  switch(arg[0])
  {
    case 'r':
      register();
      return ;
    case 'p':
      pager();
      check_user();
      return ;
    case 'l':
      lock();
      return ;
    case 'f':
    case 'g':
    case 'h':
    case 'q':
      m_display();
      write(YEL "\r请输入您得选择:"NOR);
      this_player()->delete_temp("help_u");
      input_to((: confirm_main_choice :),this_player());
      return ;
    default:
      u_display();
      write(YEL"\r请输入您的选择:"NOR);
      input_to((: confirm_u_choice :),me);
      return ;
  }

  return;
}

