#include <ansi.h>
inherit F_CLEAN_UP;
#define MAX_NUM 30
string get_str(object ob)
{
  int sen, max_sen, eff_sen;
  int sen_num, eff_num, num;
  string msg;
  int big,small;
  sen = (int)ob->query("sen");
  eff_sen = (int)ob->query("eff_sen");
  if (eff_sen < 1)
    eff_sen = 1;
  max_sen = (int)ob->query("max_sen");

  sen_num = sen*100/max_sen;
  sen_num = sen_num*MAX_NUM/100;
  eff_num = eff_sen*100/max_sen;
  eff_num = eff_num*MAX_NUM/100;

  msg = sprintf("%s神%s：%3d%%/%3d%%  ",HIB,NOR,sen*100/eff_sen,eff_sen*100/max_sen);

  if (sen_num <= eff_num)
  {
    small = sen_num;
    big = eff_num;
  }

  else
  {
    small = eff_num;
    big = sen_num;
  }

  for (num=0;num < small;num++)
    msg += HIY"■"NOR;

  for (num=small;num < big;num++);
    msg += HIR"■"NOR;

  for (num=big;num<MAX_NUM;num++)
    msg += HIW"□"NOR;

  msg += "\n";
  return msg;
}

int main(object me, string arg)
{
  object ob;

  seteuid(getuid(me));

  if(!arg)
    ob = me;
  else if (wizardp(me))
  {
    ob = present(arg, environment(me));
    if (!objectp(ob))
      ob = find_player(arg);
    if (!objectp(ob))
      ob = find_living(arg);
    if (!objectp(ob))
      return notify_fail("你要察看谁的状态？\n");
  }

  else
    return notify_fail("只有巫师能察看别人的状态。\n");
  if( wiz_level(me) < wiz_level(ob) )
    return notify_fail("你要察看谁的状态？\n");
  write(get_str(ob) + "\n");
  return 1;
}

