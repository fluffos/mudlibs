#include <ansi.h>
inherit F_CLEAN_UP;
void create()
{
  seteuid(getuid());
}

int main(object me, string arg)
{
  object gift;
  string shuxing;
  string gift_str;
  string intro = "命令格式 ： nature [water]| [fire]| [wind]| [earth]| [light] \n";

  if (!arg || (arg != "water" &&
               arg != "fire" &&
               arg != "wind" &&
               arg != "earth" &&
               arg != "light"))
  {
    write(intro);
    return 1;
  }

  shuxing = me->query("nature_gift/shuxing");
  if (!stringp(shuxing) || shuxing != arg)
  {
    write("你还没有获得任何自然的礼物或者属性不匹配！\n");
    return 1;
  }

  gift_str = "/obj/nature/obj/baowu/" + arg;
  gift = present(gift_str,me);
  if (objectp(gift))
  {
    write(sprintf("你身上已经有了 %s ！\n",gift->name()));
    return 1;
  }

  if (time() - (int)me->query_temp("last_nature_gift") < 1800)
  {
    write("你必须过段时间才可以再次使用这个命令！\n");
    return 1;
  }

  message_vision("$N喃喃念道：天道给我以帮助吧！\n",me);
  if (arg == "water")
  {
    if (!me->query("nature_gift/combine/autumn_rain"))
    {
      write("你尚未融化“秋之瑟雨”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/spring_rain"))
    {
      write("你尚未融化“春之喜雨”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/summer_rain"))
    {
      write("你尚未融化“夏之暴雨”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/winter_rain"))
    {
      write("你尚未融化“冬之雪雨”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    message_vision("一道光华凝集在了$N的手中，慢慢聚集成了一个光芒四射的明珠！\n",me);
    gift = new(gift_str);
    gift->set("owner",me->query("id"));
    gift->move(me,1);
    me->set_temp("last_nature_gift",time());
    tell_object(me,"你得到了水的力量！\n");
    me->add("nature_gift/water",1);
    if ((int)me->query("nature_gift/water") >= 10)
    {
      me->delete("nature_gift/combine/autumn_rain");
      me->delete("nature_gift/combine/spring_rain");
      me->delete("nature_gift/combine/summer_rain");
      me->delete("nature_gift/combine/winter_rain");
      me->delete("nature_gift/water");
      me->delete("nature_gift/shuxing");
      tell_object(me,"你使用水的力量的次数达到了极限，水神给了你最后一次礼物！\n");
      tell_object(me,"你需要重新融化水神留给自然的礼物，才可以再次获得他的帮助！\n");
    }

    return 1;
  }

  if (arg == "fire")
  {
    if (!me->query("nature_gift/combine/autumn_sun"))
    {
      write("你尚未融化“秋之余阳”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/spring_sun"))
    {
      write("你尚未融化“春之艳阳”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/summer_sun"))
    {
      write("你尚未融化“夏之骄阳”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/winter_sun"))
    {
      write("你尚未融化“冬之暖阳”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    message_vision("一道光华凝集在了$N的手中，慢慢聚集成了一个光芒四射的明珠！\n",me);
    gift = new(gift_str);
    gift->set("owner",me->query("id"));
    gift->move(me,1);
    me->set_temp("last_nature_gift",time());
    tell_object(me,"你得到了火的力量！\n");
    me->add("nature_gift/fire",1);
    if ((int)me->query("nature_gift/fire") >= 10)
    {
      me->delete("nature_gift/combine/autumn_sun");
      me->delete("nature_gift/combine/spring_sun");
      me->delete("nature_gift/combine/summer_sun");
      me->delete("nature_gift/combine/winter_sun");
      me->delete("nature_gift/fire");
      me->delete("nature_gift/shuxing");
      tell_object(me,"你使用火的力量的次数达到了极限，火神给了你最后一次礼物！\n");
      tell_object(me,"你需要重新融化火神留给自然的礼物，才可以再次获得他的帮助！\n");
    }

    return 1;
  }

  if (arg == "wind")
  {
    if (!me->query("nature_gift/combine/autumn_wind"))
    {
      write("你尚未融化“秋之瑟风”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/spring_wind"))
    {
      write("你尚未融化“春之暖风”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/summer_wind"))
    {
      write("你尚未融化“夏之炎风”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/winter_wind"))
    {
      write("你尚未融化“冬之寒风”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    message_vision("一道光华凝集在了$N的手中，慢慢聚集成了一个光芒四射的明珠！\n",me);
    gift = new(gift_str);
    gift->set("owner",me->query("id"));
    gift->move(me,1);
    me->set_temp("last_nature_gift",time());
    tell_object(me,"你得到了风的力量！\n");
    me->add("nature_gift/wind",1);
    if ((int)me->query("nature_gift/wind") >= 10)
    {
      me->delete("nature_gift/combine/autumn_wind");
      me->delete("nature_gift/combine/spring_wind");
      me->delete("nature_gift/combine/summer_wind");
      me->delete("nature_gift/combine/winter_wind");
      me->delete("nature_gift/wind");
      me->delete("nature_gift/shuxing");
      tell_object(me,"你使用风的力量的次数达到了极限，风神给了你最后一次礼物！\n");
      tell_object(me,"你需要重新融化风神留给自然的礼物，才可以再次获得他的帮助！\n");
    }

    return 1;
  }

  if (arg == "earth")
  {
    if (!me->query("nature_gift/combine/withered_branch"))
    {
      write("你尚未融化“枯枝”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/fallen_leaves"))
    {
      write("你尚未融化“落叶”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/spring_earth"))
    {
      write("你尚未融化“春之鲜泥”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/winter_earth"))
    {
      write("你尚未融化“冬之冻土”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    message_vision("一道光华凝集在了$N的手中，慢慢聚集成了一个光芒四射的明珠！\n",me);
    gift = new(gift_str);
    gift->set("owner",me->query("id"));
    gift->move(me,1);
    me->set_temp("last_nature_gift",time());
    tell_object(me,"你得到了大地的力量！\n");
    me->add("nature_gift/earth",1);
    if ((int)me->query("nature_gift/earth") >= 10)
    {
      me->delete("nature_gift/combine/withered_branch");
      me->delete("nature_gift/combine/spring_earth");
      me->delete("nature_gift/combine/fallen_leaves");
      me->delete("nature_gift/combine/winter_earth");
      me->delete("nature_gift/earth");
      me->delete("nature_gift/shuxing");
      tell_object(me,"你使用大地的力量的次数达到了极限，大地之神给了你最后一次礼物！\n");
      tell_object(me,"你需要重新融化大地之神神留给自然的礼物，才可以再次获得他的帮助！\n");
    }

    return 1;
  }

  if (arg == "light")
  {
    if (!me->query("nature_gift/combine/tear_rain"))
    {
      write("你尚未融化“灰色泪雨”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/light_elf"))
    {
      write("你尚未融化“电之魄”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    if (!me->query("nature_gift/combine/thunder_elf"))
    {
      write("你尚未融化“雷之魂”！\n");
      message_vision("$N什么都没有得到！\n",me);
      return 1;
    }

    message_vision("一道光华凝集在了$N的手中，慢慢聚集成了一个光芒四射的明珠！\n",me);
    gift = new(gift_str);
    gift->set("owner",me->query("id"));
    gift->move(me,1);
    me->set_temp("last_nature_gift",time());
    tell_object(me,"你得到了雷电的力量！\n");
    me->add("nature_gift/light",1);
    if ((int)me->query("nature_gift/light") >= 10)
    {
      me->delete("nature_gift/combine/tear_rain");
      me->delete("nature_gift/combine/light_elf");
      me->delete("nature_gift/combine/thunder_elf");
      me->delete("nature_gift/light");
      me->delete("nature_gift/shuxing");
      tell_object(me,"你使用大地的力量的次数达到了极限，大地之神给了你最后一次礼物！\n");
      tell_object(me,"你需要重新融化大地之神神留给自然的礼物，才可以再次获得他的帮助！\n");
    }

    return 1;
  }

  write("你什么都没有得到！\n");
  return 1;
}

