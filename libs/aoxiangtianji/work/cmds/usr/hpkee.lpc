#include <ansi.h>
inherit F_CLEAN_UP;
#define MAX_NUM 30
string get_str(object ob)
{
  int kee, max_kee, eff_kee;
  int kee_num, eff_num, num;
  int small, big;
  string msg;
  if (!objectp(ob))
    return "";

  kee = (int)ob->query("kee");
  eff_kee = (int)ob->query("eff_kee");
  max_kee = (int)ob->query("max_kee");

  kee_num = kee*100/max_kee;
  kee_num = kee_num*MAX_NUM/100;
  eff_num = eff_kee*100/max_kee;
  eff_num = eff_num*MAX_NUM/100;
  if (!eff_kee || !max_kee)
    return "";
  msg = sprintf("%s气%s：%3d%%/%3d%%  ",HIW,NOR,kee*100/eff_kee,eff_kee*100/max_kee);

  if (kee_num <= eff_num)
  {
    small = kee_num;
    big = eff_num;
  }

  else
  {
    small = eff_num;
    big = kee_num;
  }

  for (num=0;num < small;num++)
    msg += HIY"■"NOR;

  for (num=small;num < big;num++);
    msg += HIR"■"NOR;

  for (num=big;num<MAX_NUM;num++)
    msg += HIW"□"NOR;

  msg += "\n";
  return msg;
}

int main(object me, string arg)
{
  object ob;

  seteuid(getuid(me));

  if(!arg)
    ob = me;
  else if (wizardp(me))
  {
    ob = present(arg, environment(me));
    if (!objectp(ob))
      ob = find_player(arg);
    if (!objectp(ob))
      ob = find_living(arg);
    if (!objectp(ob))
      return notify_fail("你要察看谁的状态？\n");
  }

  else
    return notify_fail("只有巫师能察看别人的状态。\n");
  if( wiz_level(me) < wiz_level(ob) )
    return notify_fail("你要察看谁的状态？\n");
  write(get_str(ob));
  return 1;
}

