#include <ansi.h>
#include <mudlib.h>
inherit F_CLEAN_UP;
int top_list(object ob1, object ob2)
{
  int score1,score2;
  score1 = MPTOP_D->get_score(ob1);
  score2 = MPTOP_D->get_score(ob2);
  return score2 - score1;
}

// 逆序排列(从高到低)
int sort_family(string f1, string f2, mapping fame)
{
  return fame[f2] - fame[f1];
}

// 逆序排列(从高到低)
int sort_league(string f1, string f2, mapping fame)
{
   return fame[f2] - fame[f1];
}

int main(object me, string arg)
{
  mapping last, fame;
  string *fam;
  string msg,color;
  int delta;

  object *list,*ob;
  int i,j;
  if (!objectp(me))
    return 0;
  if (me != this_player(1))
    return 0;

  if ((time() - (int)me->query_temp("last_top_time")) < 5 )
    return notify_fail("系统寻找中。。。\n");

  me->set_temp("last_top_time",time());

  if (! arg)
  {
    ob = filter_array(users(), (: !wizardp($1) :));

    list = sort_array(ob, (: top_list :));
    msg =  "\n                   "GRN" ┏    "NOR""+GRN+"翱翔天际在线高手排行榜"NOR" "GRN"   ┓\n"NOR;
    msg += ""GRN"┏━━━━━━━┯━┻━━━━━━━━━┯━━━━━┻━┯━━━━━┓\n"NOR;
    msg += ""GRN"┃   "NOR" "GRN""GRN"名次 "NOR"  "GRN"   │"NOR" "GRN""
             GRN"  在  线  高  手 "NOR" "GRN"   │"NOR"  "GRN""GRN" 所在门派 "NOR""
             GRN"  │ "NOR""GRN""GRN"目前评价"NOR" "GRN"┃\n"NOR;
    msg += ""GRN"┠───────┴───────────┴───────┴─────┨\n"NOR;
    for (i = 0 ;i < sizeof(list) ; i++)
    {
      if (i>=15)
        break;
      if( !playerp(list[i]) )
        continue;
      if(list[i] == me)
        color = WHT;
      else
        color = GRN;
      msg += sprintf("%s┃    %-9s │%-12s%-10s│%-14s│%8d  ┃\n%s",
               color,
               chinese_number(i+1),
               list[i]->query("name"),
               "["+ geteuid(list[i])+"]",
               stringp(list[i]->query("family/family_name")) ?
                    list[i]->query("family/family_name") : "普通百姓",
               MPTOP_D->get_score(list[i]),
               NOR);
    }

    msg += ""GRN"┠───────┴───────────┴───────┴─────┨\n"NOR;

    for( i = 0;i<sizeof(list);i++)
    {
      if(list[i] == me)
        break;
    }

    j = i+1;

    msg += sprintf(""GRN"┃   "HIR"%-10s"NOR""GRN" │"HIR"%-12s"NOR""
                     HIR"%-10s"NOR""GRN"│"HIR""HIR"%-14s"NOR""GRN"│"
                     HIR"%8d"NOR"  "GRN"┃\n"NOR,
                   chinese_number(j),me->query("name"),"["+
                   me->query("id")+"]",
                   me->query("family")?  me->query("family/family_name"):"普通百姓",
                   MPTOP_D->get_score(me));
    msg += ""GRN"┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n"NOR;
    msg +=  "  "+GRN+"" + NOR GRN+ NATURE_D->game_time() + "记。"NOR GRN"\n\n"NOR;
  }

  else if (arg == "family")
  {
    fame = FAMILY_D->query_family_fame();
    last = FAMILY_D->query_all_last_family_fame();

    fam = keys(fame) - ({ 0 });
    fam = sort_array(fam, (: sort_family :), fame);

    msg = WHT "目前江湖上所有名门大派的声望状况\n" NOR
          HIY "────────────────\n" NOR;
    for (i = 0; i < sizeof(fam); i++)
    {
      delta = fame[fam[i]] - last[fam[i]];
      msg += sprintf("%2d. %-12s  %-9d(%s%d%s)\n",
                i + 1, fam[i], fame[fam[i]],
               (delta > 0) ? HIY "+" : (delta < 0) ? HIR : WHT, delta, NOR);
    }

    msg += HIY "────────────────\n" NOR
           WHT "一共是" + chinese_number(i) + "个门派。\n" NOR;
  }

  else
    return notify_fail("你要看什么排行榜？\n");
  write(msg);
  return 1;
}

int help(object me)
{
write(@HELP
指令格式: top [<没有参数> | family]
1.不带参数：
    这个指令可以让你知道在线十五大高手是哪些，别去惹他们。
2. top family
  查看目前江湖上大门派的排名状况和相比去年变化的程度。

HELP
    );
    return 1;
}

