#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
  object ob;

  seteuid(getuid(me));

  if(!arg)
    ob = me;
  else if (wizardp(me))
  {
    ob = present(arg, environment(me));
    if (!objectp(ob))
      ob = find_player(arg);
    if (!objectp(ob))
      ob = find_living(arg);
    if (!objectp(ob))
      return notify_fail("你要察看谁的状态？\n");
  }

  else
    return notify_fail("只有巫师能察看别人的状态。\n");
  if( wiz_level(me) < wiz_level(ob) )
    return notify_fail("你要察看谁的状态？\n");

  me->command("hpkee");
  write("\n");
  me->command("hpsen");
  return 1;
}

