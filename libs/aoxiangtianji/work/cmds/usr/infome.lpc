#include <ansi.h>
inherit F_CLEAN_UP;
int help(object me);
int main(object me, string arg)
{
  mapping gift;
  mapping quest_info, quest_gift;
  object ob;
  string msg;

  seteuid(getuid(me));

  if(!arg)
    ob = me;
  else if (wizardp(me))
  {
    ob = find_player(arg);
    if (!objectp(ob))
      return notify_fail("你要查看哪个玩家的状态？\n");
  }

  else
    return notify_fail("只有巫师能察看别人的状态。\n");
  if( wiz_level(me) < wiz_level(ob) )
    return notify_fail("你要察看谁的状态？\n");
  msg = HIW"==========吃丹信息=========\n\n"NOR;
  gift = ob->query("gift");
  if (!mapp(gift) || sizeof(gift) < 1)
    msg += HIY"\t没有任何吃丹记录！\n"NOR;
  else
  {
    msg += "┃神力丸(str)┃通灵丸(spi)┃幸运草(kar)┃增慧丹(int)┃福寿膏(dex)┃壮骨粉(con)┃\n";
    msg += sprintf("┃%-2d/%-8d┃%-2d/%-8d┃%-2d/%-8d┃%-2d/%-8d┃%-2d/%-8d┃%-2d/%-8d┃\n",
                      (mapp(gift["str"]) && sizeof(gift["str"]) > 0) ? gift["str"]["succeed"] : 0,
                      (mapp(gift["str"]) && sizeof(gift["str"]) > 0) ? gift["str"]["all"] : 0,
                      (mapp(gift["spi"]) && sizeof(gift["spi"]) > 0) ? gift["spi"]["succeed"] : 0,
                      (mapp(gift["spi"]) && sizeof(gift["spi"]) > 0) ? gift["spi"]["all"] : 0,
                      (mapp(gift["kar"]) && sizeof(gift["kar"]) > 0) ? gift["kar"]["succeed"] : 0,
                      (mapp(gift["kar"]) && sizeof(gift["kar"]) > 0) ? gift["kar"]["all"] : 0,
                      (mapp(gift["int"]) && sizeof(gift["int"]) > 0) ? gift["int"]["succeed"] : 0,
                      (mapp(gift["int"]) && sizeof(gift["int"]) > 0) ? gift["int"]["all"] : 0,
                      (mapp(gift["dex"]) && sizeof(gift["dex"]) > 0) ? gift["dex"]["succeed"] : 0,
                      (mapp(gift["dex"]) && sizeof(gift["dex"]) > 0) ? gift["dex"]["all"] : 0,
                      (mapp(gift["con"]) && sizeof(gift["con"]) > 0) ? gift["con"]["succeed"] : 0,
                      (mapp(gift["con"]) && sizeof(gift["con"]) > 0) ? gift["con"]["all"] : 0);
  }

  msg += "\n＝＝＝吃丹信息统计完毕＝＝＝＝＝＝\n\n";
  write(msg);

  msg = "＝＝＝＝新手任务＝＝＝＝\n\n";
  quest_info = ob->query("work");
  if (!mapp(quest_info) || sizeof(quest_info) < 1)
    msg += "你尚未开始工作！\n";
  else
  {
    msg += "┃货栈任务  ┃擦鞋任务  ┃铁匠任务  ┃种花任务  ┃\n";
    msg += sprintf("┃%-10d┃%-10d┃%-10d┃%-10d┃\n",
 (mapp(quest_info["newbie_work"]) && sizeof(quest_info["newbie_work"]) > 0) ?
                    quest_info["newbie_work"]["exp"] : 0,
 (mapp(quest_info["newbie_brush"]) && sizeof(quest_info["newbie_brush"]) > 0) ?
                    quest_info["newbie_brush"]["dx"] : 0,
 (mapp(quest_info["newbie_tj"]) && sizeof(quest_info["newbie_tj"]) > 0) ?
                    quest_info["newbie_tj"]["exp"] : 0,
 (mapp(quest_info["newbie_zh"]) && sizeof(quest_info["newbie_zh"]) > 0) ?
                    quest_info["newbie_zh"]["dx"] : 0);
    msg += "┃配药任务  ┃钓鱼任务  ┃炒菜任务  ┃裁缝任务  ┃\n";
    msg += sprintf("┃%-10d┃%-10d┃%-10d┃%-10d┃\n",
 (mapp(quest_info["newbie_yao"]) && sizeof(quest_info["newbie_yao"]) > 0) ?
                    quest_info["newbie_yao"]["exp"] : 0,
 (mapp(quest_info["newbie_fish"]) && sizeof(quest_info["newbie_fish"]) > 0) ?
                    quest_info["newbie_fish"]["dx"] : 0,
 (mapp(quest_info["newbie_cook"]) && sizeof(quest_info["newbie_cook"]) > 0) ?
                    quest_info["newbie_cook"]["dx"] : 0,
 (mapp(quest_info["newbie_sew"]) && sizeof(quest_info["newbie_sew"]) > 0) ?
                    quest_info["newbie_sew"]["exp"] : 0);
    msg += "┃采矿任务1 ┃采矿任务2 ┃运送任务1 ┃运送任务2 ┃\n";
    msg += sprintf("┃%-10d┃%-10d┃%-10d┃%-10d┃\n",
 (mapp(quest_info["newbie_mine"]) && sizeof(quest_info["newbie_mine"]) > 0) ?
                    quest_info["newbie_mine"]["exp"] : 0,
 (mapp(quest_info["newbie_mine"]) && sizeof(quest_info["newbie_mine"]) > 0) ?
                    quest_info["newbie_mine"]["dx"] : 0,
 (mapp(quest_info["newbie_transit"]) && sizeof(quest_info["newbie_transit"]) > 0) ?
                    quest_info["newbie_transit"]["exp"] : 0,
 (mapp(quest_info["newbie_transit"]) && sizeof(quest_info["newbie_transit"]) > 0) ?
                    quest_info["newbie_transit"]["dx"] : 0);
    msg += "┃伐木任务  ┃狩猎任务  ┃\n";
    msg += sprintf("┃%-10d┃%-10d┃\n",
 (mapp(quest_info["newbie_famu"]) && sizeof(quest_info["newbie_famu"]) > 0) ?
                    quest_info["newbie_famu"]["exp"] : 0,
 (mapp(quest_info["newbie_hunt"]) && sizeof(quest_info["newbie_hunt"]) > 0) ?
                    quest_info["newbie_hunt"]["exp"] : 0);
  }

  msg += "\n＝＝＝新手任务统计完毕＝＝＝＝＝＝\n\n";
  write(msg);

  msg = "＝＝＝＝杀妖任务信息＝＝＝＝\n\n";
  quest_info = ob->query("quest_info");
  if (!mapp(quest_info) || sizeof(quest_info) < 1)
    msg += "你尚未杀妖除魔！\n";
  else
  {
    msg += "┃任务名称  ┃武学奖励  ┃道行奖励  ┃潜能奖励  ┃实战奖励  ┃威望奖励  ┃阅历奖励  ┃门忠  ┃合计  ┃\n";
    quest_gift = quest_info["yuan"];
    msg += "┃袁天罡任务┃";
    if (!mapp(quest_gift) || sizeof(quest_gift) < 1)
      msg += "没有记录                                                                              ┃\n";
    else
    {
      msg += sprintf("%10d┃%10d┃%10d┃%10d┃%10d┃%10d┃%6d┃%6d┃\n",
                   quest_gift["exp"],
                   quest_gift["dx"],
                   quest_gift["pot"],
                   quest_gift["experience"],
                   quest_gift["weiwang"],
                   quest_gift["score"],
                   quest_gift["faith"],
                   quest_gift["total_num"] ?
                       quest_gift["total_num"] : quest_gift["count"]);
    }

    quest_gift = quest_info["xinmo"];
    msg += "┃门派心魔  ┃";
    if (!mapp(quest_gift) || sizeof(quest_gift) < 1)
      msg += "没有记录                                                                              ┃\n";
    else
    {
      msg += sprintf("%10d┃%10d┃%10d┃%10d┃%10d┃%10d┃%6d┃%6d┃\n",
                   quest_gift["exp"],
                   quest_gift["dx"],
                   quest_gift["pot"],
                   quest_gift["experience"],
                   quest_gift["weiwang"],
                   quest_gift["score"],
                   quest_gift["faith"],
                   quest_gift["count"] ?
                       quest_gift["count"] : quest_gift["total_num"]);
    }

    quest_gift = quest_info["wutian"];
    msg += "┃无佛无天  ┃";
    if (!mapp(quest_gift) || sizeof(quest_gift) < 1)
      msg += "没有记录                                                                              ┃\n";
    else
    {
      msg += sprintf("%10d┃%10d┃%10d┃%10d┃%10d┃%10d┃%6d┃%6d┃\n",
                   quest_gift["exp"],
                   quest_gift["dx"],
                   quest_gift["pot"],
                   quest_gift["experience"],
                   quest_gift["weiwang"],
                   quest_gift["score"],
                   quest_gift["faith"],
                   quest_gift["count"] ?
                       quest_gift["count"] : quest_gift["total_num"]);
    }

    quest_gift = quest_info["freequest"];
    msg += "┃自由任务  ┃";
    if (!mapp(quest_gift) || sizeof(quest_gift) < 1)
      msg += "没有记录                                                                              ┃\n";
    else
    {
      msg += sprintf("%10d┃%10d┃%10d┃%10d┃%10d┃%10d┃%6d┃%6d┃\n",
                   quest_gift["exp"],
                   quest_gift["dx"],
                   quest_gift["pot"],
                   quest_gift["experience"],
                   quest_gift["weiwang"],
                   quest_gift["score"],
                   quest_gift["faith"],
                   quest_gift["count"] ?
                       quest_gift["count"] : quest_gift["total_num"]);
    }

    quest_gift = quest_info["menpai"];
    msg += "┃门派任务  ┃";
    if (!mapp(quest_gift) || sizeof(quest_gift) < 1)
      msg += "没有记录                                                                              ┃\n";
    else
    {
      msg += sprintf("%10d┃%10d┃%10d┃%10d┃%10d┃%10d┃%6d┃%6d┃\n",
                   quest_gift["exp"],
                   quest_gift["dx"],
                   quest_gift["pot"],
                   quest_gift["experience"],
                   quest_gift["weiwang"],
                   quest_gift["score"],
                   quest_gift["faith"],
                   quest_gift["count"] ?
                       quest_gift["count"] : quest_gift["total_num"]);
    }

    quest_gift = quest_info["xue"];
    msg += "┃薛仁贵任务┃";
    if (!mapp(quest_gift) || sizeof(quest_gift) < 1)
      msg += "没有记录                                                                              ┃\n";
    else
    {
      msg += sprintf("%10d┃%10d┃%10d┃%10d┃%10d┃%10d┃%6d┃%6d┃\n",
                   quest_gift["exp"],
                   quest_gift["dx"],
                   quest_gift["pot"],
                   quest_gift["experience"],
                   quest_gift["weiwang"],
                   quest_gift["score"],
                   quest_gift["faith"],
                   quest_gift["count"] ?
                       quest_gift["count"] : quest_gift["total_num"]);
    }

    quest_gift = quest_info["lijing"];
    msg += "┃李靖任务  ┃";
    if (!mapp(quest_gift) || sizeof(quest_gift) < 1)
      msg += "没有记录                                                                              ┃\n";
    else
    {
      msg += sprintf("%10d┃%10d┃%10d┃%10d┃%10d┃%10d┃%6d┃%6d┃\n",
                   quest_gift["exp"],
                   quest_gift["dx"],
                   quest_gift["pot"],
                   quest_gift["experience"],
                   quest_gift["weiwang"],
                   quest_gift["score"],
                   quest_gift["faith"],
                   quest_gift["total_num"] ?
                       quest_gift["total_num"] : quest_gift["count"]);
    }

    quest_gift = quest_info["itask"];
    msg += "┃综合任务  ┃";
    if (!mapp(quest_gift) || sizeof(quest_gift) < 1)
      msg += "没有记录                                                                              ┃\n";
    else
    {
      msg += sprintf("%10d┃%10d┃%10d┃%10d┃%10d┃%10d┃%6d┃%6d┃\n",
                   quest_gift["exp"],
                   quest_gift["dx"],
                   quest_gift["pot"],
                   quest_gift["experience"],
                   quest_gift["weiwang"],
                   quest_gift["score"],
                   quest_gift["faith"],
                   quest_gift["count"] ?
                       quest_gift["count"] : quest_gift["total_num"]);
    }

    quest_gift = quest_info["pantu"];
    msg += "┃叛徒任务  ┃";
    if (!mapp(quest_gift) || sizeof(quest_gift) < 1)
      msg += "没有记录                                                                              ┃\n";
    else
    {
      msg += sprintf("%10d┃%10d┃%10d┃%10d┃%10d┃%10d┃%6d┃%6d┃\n",
                   quest_gift["exp"],
                   quest_gift["dx"],
                   quest_gift["pot"],
                   quest_gift["experience"],
                   quest_gift["weiwang"],
                   quest_gift["score"],
                   quest_gift["faith"],
                   quest_gift["count"] ?
                       quest_gift["count"] : quest_gift["total_num"]);
    }

    quest_gift = quest_info["rulai"];
    msg += "┃如来任务  ┃";
    if (!mapp(quest_gift) || sizeof(quest_gift) < 1)
      msg += "没有记录                                                                              ┃\n";
    else
    {
      msg += sprintf("%10d┃%10d┃%10d┃%10d┃%10d┃%10d┃%6d┃%6d┃\n",
                   quest_gift["exp"],
                   quest_gift["dx"],
                   quest_gift["pot"],
                   quest_gift["experience"],
                   quest_gift["weiwang"],
                   quest_gift["score"],
                   quest_gift["faith"],
                   quest_gift["total_num"] ?
                       quest_gift["total_num"] : quest_gift["count"]);
    }

  }

  msg += "＝＝＝＝任务状况统计完毕＝＝＝＝\n\n";
  write(msg);
  return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : infome
           infome <对象名称>                   (巫师专用)

这个指令可以查询玩家的吃丹和任务状况。

see also : score hp
HELP
    );
    return 1;
}

