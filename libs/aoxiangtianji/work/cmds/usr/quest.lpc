#include <ansi.h>
inherit F_CLEAN_UP;
int help(object me);
int main(object me, string arg)
{
  string master_id,type,aorc;
  object master;
  string q_dir = "/job/quest/";

  seteuid(getuid());
  if (me != this_player(1))
    return 0;

  if (! arg)
  {
    if (!wizardp(me))
      return help(me);
    SYSQ_D->query_quest_info(me);
    return 1;
  }

  if (sscanf (arg, "%s %s", master_id, type) != 2)
  {
    help(me);
    return 1;
  }

  master = present(master_id,environment(me));
  if (!objectp(master))
  {
   write("这里没有" + master_id + "这个人！\n");
    return 1;
  }

  if (userp(master) || !living(master))
    return 0;

  aorc = 0;
  sscanf (type, "%s %s", type,aorc);
  if (!SYSQ_D->valid_quest(type))
  {
    write("系统没有" + type + "这种任务！\n");
    return 1;
  }

  if (me->is_busy() || me->is_fighting())
  {
    write("你正忙着呢！\n");
    return 1;
  }

  q_dir += type ;
  if (aorc == "cancel")
    return q_dir->ask_JC(me, master);
  return q_dir->ask_RW(me,master);
}

int help(object me)
{
   write( @HELP
指令格式: quest <可以给任务的npc的id> <任务类型> <cancel>
例如： quest li liling 你将向李靖申请一个灭妖的任务
      quest li lijing cancel 你向李靖申请取消你的灭妖任务
再看一个例子：
如果你的门派师傅是yunyang
      quest yunyang menpai 你向云阳道人申请了一个门派任务
      quest yunyang menpai cancel 你向云阳道人申请取消你的门派任务
目前可以申请的任务有如下这些：
   yuan   长安袁天罡的灭妖任务,
   lijing  天庭李靖的灭妖任务,
   menpai  各个门派的门派任务，直接向自己的师傅申请即可,
   itask   各个门派的综合任务，直接向自己的师傅申请即可,
   pantu   官府的叛徒任务，到官府申请即可,
   rulai   系统如来的如来任务,
   xue     长安皇宫的薛仁贵任务,

HELP );
   return 1;
}

