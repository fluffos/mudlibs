#include <ansi.h>
inherit F_CLEAN_UP;
int help(object me);
int main(object me, string arg)
{
  string str;
  seteuid(geteuid(me));
  if ((time() - (int)me->query_temp("last_topten_time")) < 5 )
    return notify_fail("系统寻找中。。。\n");

  me->set_temp("last_topten_time",time());
  if (!arg||arg=="")
    return help(me);
  str="/adm/daemons/toptend.lpc"->topten_query(arg);
  write(str+"\n");
  return 1;
}

int help(object me)
{
  write(HIW"指令格式 : topten <类型>\n"NOR+TOPTEN_D->query_type());
  return 1;
}

