// [1;31m此文件禁止随意移动和更改[0m
// CMDS /cmds/usr/uptime.c
inherit F_CLEAN_UP;
#include <mudlib.h>
#include <ansi.h>
string report_str();
int main(int i)
{
  int tmp, uptime, time;
  seteuid(getuid());
  tmp = uptime();
  if( file_size( "/data/date") > 0 )
    sscanf( read_file( "data/date" ), "%d %d", time, uptime );
  else
    return 1;
  if( uptime > tmp )
    uptime = 0;
  else
  {
    time = time + tmp - uptime;
    uptime = tmp;
  }

/*
  if(intp(i))
  {
    write(CHINESE_MUD_NAME+"『"BBLU " "+INTERMUD_NAME+ " "NOR"』上次当机原因："YEL+
    read_file("/log/nosave/LASTCRASH")+""NOR);
    write("                                    上次当机时间："YEL+ read_file("/log/nosave/LASTTIME")+""NOR);
  }

*/
  write_file( "/data/date", sprintf( "%d %d", time, uptime ), 1 );
  write(CHINESE_MUD_NAME+"『"BBLU" " +INTERMUD_NAME+ " "NOR"』已经连续运行："YEL +report_str()+ NOR"\n");
  write(CHINESE_MUD_NAME+"『"BBLU" " +INTERMUD_NAME+ " "NOR"』已经总共执行："YEL +
          CHINESE_D->chinese_period(time) + NOR"\n");
  return 1;
}

string report_str()
{
  int t, d, h, m, s;
  string time;
  t = uptime();
  s = t % 60;		t /= 60;
  m = t % 60;		t /= 60;
  h = t % 24;		t /= 24;
  d = t;
  if(d)
    time = chinese_number(d) + "天";
  else
    time = "";
  if(h)
    time += chinese_number(h) + "小时";
  if(m)
    time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";
  return(time);
}

int help(object me)
{
	write(
"\n指令格式 : uptime\n\n"
"这个指令告诉您「" MUD_NAME "」泥巴游戏已经连续执行
和自开站以来总共执行了多久。\n\n"
    );
    return 1;
}

