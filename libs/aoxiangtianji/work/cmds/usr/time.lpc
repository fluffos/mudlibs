#include <command.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
  int year,month,day,time;
  int hour,minute,d_flag;
  string tmp, season, weather, out;
  year = NATURE_D->query_year();
  month = NATURE_D->query_month()%12;
  day = NATURE_D->query_days();
  time = NATURE_D->query_current_time();
  hour = time / 60;
  hour = hour % 24;
  minute = time - hour * 60;

  d_flag = NATURE_D->is_day();

  if(hour <4 && hour>=0)
    tmp = HIC"凌晨"NOR;
  else if(hour<6 && hour >=4)
    tmp = HIW"清晨"NOR;
  else if(hour<9 && hour>=6)
    tmp = HIW"上午"NOR;
  else if(hour<12 && hour>=9)
    tmp = HIR"正午"NOR;
  else if(hour<15 && hour>=12)
    tmp = HIB"下午"NOR;
  else if(hour<18 && hour>=15)
    tmp = HIB"傍晚"NOR;
  else if(hour<20 && hour>=18)
    tmp = HIB"夜晚"NOR;
  else
    tmp = HIG"深夜"NOR;
  switch (month)
  {
    case 0:
    case 12:
      season = HIW"初冬的"NOR+tmp;
      break;
    case 1:
      season = HIW"隆冬的"NOR+tmp;
      break;
    case 2:
      season = HIW"冬末的"NOR+tmp;
      break;
    case 3:
      season = HIG"初春的"NOR+tmp;
      break;
    case 4:
      season = HIG"春季的"NOR+tmp;
      break;
    case 5:
      season = HIG"春末的"NOR+tmp;
      break;
    case 6:
      season = HIM"初夏的"NOR+tmp;
      break;
    case 7:
      season = HIR"盛夏的"NOR+tmp;
      break;
    case 8:
      season = HIM"夏末的"NOR+tmp;
      break;
    case 9:
      season = HIY"初秋的"NOR+tmp;
      break;
    case 10:
      season = HIY"秋季的"NOR+tmp;
      break;
    case 11:
      season = HIY"深秋的"NOR+tmp;
      break;
  }

  weather=NATURE_D->check_weather();
  sscanf( weather,"(%*s) [天气]：%s",weather);

  out = sprintf("\n时间：%s创世%s年%s月%s日 [%s]\n      %s时%s分 [%s] [%s]\n\n",
           MUD_NAME,
           ((year == 0)? "元":chinese_number(year)),
           (month==0) ? "十二" : chinese_number(month),
           chinese_number(day),
           season,
           chinese_number(hour),
           chinese_number(minute),
           d_flag?HIW"日"NOR:HIG"夜"NOR,
           weather);

  write(out);
  return 1;
}

int help(object me)
{
     write(@HELP
指令格式: time
这个指令让你知道西游记现在游戏中的国家时辰。
相关信息：uptime，bjtime
HELP
    );
    return 1;
}

