#include <command.h>
inherit F_CLEAN_UP;
void create()
{
  seteuid(getuid());
}

int main(object me, string arg)
{
  object ob;
  if (!arg)
    return notify_fail("你要召唤什么物品？\n");
  if (!wizardp(me) && ((int)me->query("level") > 32 || (int)me->query("age") > 22))
    return notify_fail("你已经无法使用这个命令来获得新手装备了。\n");
  if (me->is_ghost())
     return notify_fail("等你还了阳再说吧。\n");
  if (arg == "armor")
  {
    if (me->query_temp("newbie_armor"))
      return notify_fail("你今天已经要过了！\n");
    seteuid(getuid());
    ob = new("/d/obj/armor/armor/newbie");
    ob->move(me,1);
    seteuid(getuid());
    ob = new("/d/obj/armor/cloth/newbie");
    ob->move(me,1);
    seteuid(getuid());
    ob = new("/d/obj/armor/surcoat/newbie");
    ob->move(me,1);
    seteuid(getuid());
    ob = new("/d/obj/armor/head/newbie");
    ob->move(me,1);
    seteuid(getuid());
    ob = new("/d/obj/armor/shoes/newbie");
    ob->move(me,1);
    seteuid(getuid());
    ob = new("/d/obj/armor/shield/newbie");
    ob->move(me,1);
    message_vision("$N喃喃自语，天神给我以帮助吧！\n",me);
    tell_object(me,"你获得了新手装备！\n");
    me->set_temp("newbie_armor",time());
    return 1;
  }

  if (me->query_temp("newbie_weapon"))
    return notify_fail("你今天已经获得过了新手武器的帮助！\n");

  seteuid(getuid());
  ob = new("/d/obj/weapon/" + arg + "/newbie");
  if (!objectp(ob))
    return notify_fail("没有这种新手武器提供！\n");

  ob->move(me,1);
  message_vision("$N仰天大喊道，天神给我以力量吧！\n",me);
  tell_object(me,"你获得了 " + ob->query("name") + " ！\n");
  me->set_temp("newbie_weapon",time());
  return 1;
}

int help(object me)
{
write(@HELP
指令格式 : newbie armor 获得新手装备
          newbie <weapon 类型> 获得指定的新手武器
每个id一下上线只能获得依次新手武器和装备的帮助！
HELP
    );
    return 1;
}

