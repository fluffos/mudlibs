#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
  string msg;
  seteuid(getuid());

  if( !(msg="/adm/daemons/moneyd"->show_msg()) )
  {
    write(WHT"现在没有发放任何钱财。\n"NOR);
    return 1;
  }

  write(WHT"你似乎可以在下面这个地方挖到钱财：\n"NOR+msg+NOR"\n");
  return 1;
}

int help(object me)
{
   write( @HELP
指令格式: wheremoney
这个指令对于寻找钱财相当有用。
相关指令：digmoney
HELP
   );
   return 1;
}

