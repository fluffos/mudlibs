#include <command.h>
inherit F_CLEAN_UP;
void create()
{
  seteuid(getuid());
}

int main(object me, string arg)
{
  if (!wizardp(me) && ((int)me->query("level") > 15 || (int)me->query("age") > 18))
    return notify_fail("你已经无法使用这个命令了。\n");
  if (me->is_ghost())
     return notify_fail("等你还了阳再说吧。\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  message_vision("$N擦了擦满头的大汗，一屁股坐在了地上，好好的休息休息！\n",me);
  me->start_busy(2);
  me->set("kee",me->query("max_kee"));
  me->set("sen",me->query("max_sen"));
  return 1;
}

int help(object me)
{
write(@HELP
当你是个新手的时候，level不大于15，年纪不大于18，
可以用这个命令恢复气血和精神。
HELP
    );
    return 1;
}

