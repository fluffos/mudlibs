#include <command.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
  string wiz_status ;
  string user,yuanyin;
  object ob,dan;
  if( me != this_player(1) )
    return 0;
  wiz_status = SECURITY_D->get_status(me);
  if( wiz_status != "(admin)" )
    return notify_fail("只有 (admin) 级别的巫师才能使用这个指令！\n");
  if (!arg)
    return notify_fail("你要奖励谁？\n");

  if (sscanf(arg, "%s because %s", user, yuanyin) != 2)
    return notify_fail("你要以什么原由奖励？格式：jiangli [user] because [原因]！\n");

  seteuid(getuid());
  ob = find_player(user);
  if (!objectp(ob))
    return notify_fail("没有发现这个玩家！\n");
  dan = new("/d/wiz/obj/jindan");
  if (objectp(dan) && dan->move(ob,1))
  {
    dan->set("owner",ob->query("id"));
    tell_object(ob,"你获得了奖励金丹！\n");
    message("channel:rumor",HIR"『奖励精灵』："HIW"据说" + me->name()
           +"奖励了 " + ob->name() + " ，因为：" + yuanyin + "\n"NOR,users());
    log_file("jiangli",sprintf("%s(%s) 获得了奖励金丹(/d/wiz/obj/jindan) 因为 %s\n"
                               "发送人：%s(%s)\n"
                               "时间：%s\n",
                               ob->query("id"),
                               ob->name(),
                               yuanyin,
                               me->query("id"),
                               me->name(),
                               ctime(time())));
    return 1;
  }

  write("金丹出错！\n");
  if (objectp(dan))
    destruct(dan);
  return 1;
}

