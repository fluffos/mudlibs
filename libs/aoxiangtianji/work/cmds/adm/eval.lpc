// addprop.c
#include <skill.h>
#include <command.h>
#define TMP_FILE    "/_lpc_cmd"
inherit F_CLEAN_UP;
void create() { seteuid(getuid()); }

int main(object me, string str)
{
        string file, err;
        mixed ret;
        object ob;
        int i;

        if(!str || sscanf(str, "%sreturn %s", ret, err) != 2) {
            notify_fail("用法: eval return <code>\n");
            return 0;
        }

        file = TMP_FILE;
        for(i = 0; file_size(file + i + ".lpc") >= 0; i++);
        file = file + i;
        if(ob = find_object(file)) destruct(ob);
        write_file(file + ".lpc", "#include <globals.h>\n _lpc(){" + str +";"+ "}\n");
        err = catch(ret = (mixed)call_other(file, "_lpc"));
        if(ob = find_object(file)) destruct(ob);
        rm(file + ".lpc");
        if(err)
            write(err);
        else
            printf("%O\n",ret);
        return 1;

}

int help(object me)
{
        write( @HELP
指令格式: eval return <code>

这个指令使你可以执行自己的代码
HELP );
        return 1;
}

