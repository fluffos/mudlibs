#include <command.h>
inherit F_CLEAN_UP;
#define MASTER    "/adm/etc/newbie_master"
int main(object me, string arg)
{
  string wiz_status ;
  string *file_line;
  int i;
  object ob;
  if( me != this_player(1) )
    return 0;
  wiz_status = SECURITY_D->get_status(me);
  if( wiz_status != "(admin)" )
    return notify_fail("只有 (admin) 级别的巫师才能使用这个指令！\n");
  if (!arg)
    return notify_fail("你要指定谁做新手导师？\n");

  seteuid(getuid());
  ob = find_player(arg);
  if (!objectp(ob))
    return notify_fail("没有发现这个玩家！\n");
  if (ob->query("newbie_master"))
    return notify_fail("这个玩家已经是新手导师了！\n");

  if( file_size(MASTER) != -1 )
  {
    file_line = explode(read_file(MASTER), "\n");
      for(i=0; i<sizeof(file_line); i++)
      {
        if( file_line[i]=="" || file_line[i][0]=='#' )
          continue;
        if( file_line[i] == ob->query("id"))
        {
          ob->set("newbie_master",1);
          return notify_fail("这个玩家已经是新手导师了！\n");
        }

      }

  }

  message("channel:rumor",HIR"『新手导师』："HIW"据说" + me->name()
          +"指定了 " + ob->name() + " 作为新手导师！\n"NOR,users());
  ob->set("newbie_master",1);
  ob->save();
  write_file(MASTER,sprintf("%s\n",ob->query("id")));
  log_file("newbie_master",sprintf("%s(%s) 被指定为了新手导师\n"
                               "指定人：%s(%s)\n"
                               "时间：%s\n",
                               ob->query("id"),
                               ob->name(),
                               me->query("id"),
                               me->name(),
                               ctime(time())));
  return 1;
}

