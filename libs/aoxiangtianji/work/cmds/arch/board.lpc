// board.c
// created by doing
#include <ansi.h>
#include <getconfig.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
  string *file;
  string msg;
  string wiz_status;
  int i, j;
  wiz_status = SECURITY_D->get_status(me);
  if( wiz_status != "(admin)" && wiz_status != "(arch)" )
    return notify_fail("只有 (arch) 以上的巫师才能使用这个命令！\n");
  seteuid(getuid());
  file = map_array(get_dir("/obj/board/"), (: "/obj/board/" + $1 :));
  i = sizeof(file);
  if (! i)
  {
    write("目前没有任何留言版。\n");
    return 1;
  }

  if (arg)
  {
    sscanf(arg, "%d", j);
    j--;
    if (j < 0 || j >= i)
      return notify_fail("没有这个留言板。\n");
    return me->force_me("goto " + file[j]->query("location"));
  }

  msg = "目前" + LOCAL_MUD_NAME() + "的留言版有以下这些：\n";
  for (j = 0; j < i; j++)
    msg += sprintf(HIY "%2d" NOR ". %s\n", j + 1, file[j]->short());
  msg += "用 board n 去看你想看的留言板。\n";
  write(msg);
  return 1;
}

int help(object me)
{
write(@HELP

  游戏里许多地方都会有一些供人留言的留言版，这些留言
  版的使用方法都大同小异，基本上都提供下列指令：

  post <标题>
  开始进行留言，你必须指定一个标题才能留言。
  注意：这里进行留言，需要30级的literate

  read <编号> 阅读指定编号的留言。
  read new 阅读您第一未读过的留言。
  read next 同上。
  discard <编号>
  删除指定编号的留言，除了巫师以外，你只能删除自己
  写的留言。

HELP );
    return 1;
}


