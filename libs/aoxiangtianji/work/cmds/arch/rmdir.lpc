// rmdir.c
inherit F_CLEAN_UP;
int help(object me);
int main(object me, string arg)
{
	string dir;
        string wiz_status;
        wiz_status = SECURITY_D->get_status(me);
        if( wiz_status != "(admin)" && wiz_status != "(arch)" )
          return notify_fail("只有 (arch) 以上级别的巫师才能使用这个指令！\n");
	if(!arg) return help(me);
	dir = resolve_path(me->query("cwd"), arg);
	seteuid(geteuid(me));
	if( rmdir(dir) )
		write("Ok.\n");
	else
		write("删除失败。\n");
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : rmdir <子目录名>
删除一个子目录。
HELP
	);
	return 1;
}

