//Created by waiwai@2002/05/24
inherit F_CLEAN_UP;
int where_all();
#include <mudlib.h>
int main(object me, string str)
{
  object ob, where, *ob_list;
  int i,lvl;
  if (!str)
    return where_all();
  ob = find_player(str);
  if( !ob )
    ob = find_living(str);
  if( !ob )
    ob = LOGIN_D->find_body(str);
//Added by waiwai@2002/05/24
  lvl = wiz_level(me);
  if( !ob || !me->visible(ob))
  {
    str = resolve_path(me->query("cwd"), str);
    ob_list = children(str);
    if(ob && ob->query("env/invisibility"))
    {
      if( lvl < wiz_level(ob) )
        return notify_fail("没有这个玩家、生物、或地方。\n");
    }

    if(sizeof(ob_list)<1)
      return notify_fail("找不到这个人.\n");
    for(i=0; i<sizeof(ob_list); i++)
    {
      if( !ob = environment(ob_list[i]) )
        continue;
      printf("%O\n", ob );
    }

    return 1;
  }

//  if( ob !=me )
//    return notify_fail("现在没这个人。\n");
  where = environment(ob);
  if (!where)
    return notify_fail("这个人("+file_name(ob)+")不知道在那里耶。。。\n");
  printf("%s(%s)现在在%s%s(%s.c).\n",
          (string)ob->name(1),
          (string)ob->query("id"),MISC_D->find_place(where),
          undefinedp(where->query("short"))?
          where->short():
          where->query("short"),
          (string)file_name(where));
  return 1;
}

int where_all()
{
  string str, wiz_status;
  object *list;
  int j;
  object me, where;
  me = this_player();
  wiz_status = SECURITY_D->get_status(me);
  if( wiz_status != "(admin)" )
    return notify_fail("\n");
  str = "※ "+VERSION_NAME+"    ["+MUD_IP+"]\n";
  str += "—————————————————————————————————————\n";
  str += "英文代号    中文姓名          目前具体位置(位置系统路径)       系统等级 \n";
  str += "—————————————————————————————————————\n";
  list = users();
  j = sizeof(list);
  while( j-- )
  {
    where=environment(list[j]);
    if( !where )
      continue;
    if(wiz_status != "(admin)")
      continue;
    str = sprintf("%-8s%-12s%-18s%s%-s(%s.c) %s\n",
                   str,
                   list[j]->query("id"),
                   list[j]->query("name"),
                   MISC_D->find_place(where),
                   where->query("short"),
                   file_name(where),
                   SECURITY_D->get_status(list[j]) );
                 }

    str += "—————————————————————————————————————\n";
    me->start_more(str);
    return 1;
}

int help(object me)
{
	write(@HELP
指令格式: where <玩家的 ID>
这个指令是用来得知玩家目前所在的位置.
HELP
	);
	return 1;
}

