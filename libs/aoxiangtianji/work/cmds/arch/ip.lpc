// Update by waiwai@2002/12/05
inherit F_CLEAN_UP;
int main(object me,string arg)
{
  string from;
  if( ! arg )
    return notify_fail("请输入一个ip地址\n");
   if (me!=this_player(1))
     return 0;
   seteuid( getuid(me) );
   from="/adm/daemons/ipd"->seek_ip_address(arg);
   tell_object(me,"你输入的" +arg+ "来自 "+from+" \n");
   return 1;
}

