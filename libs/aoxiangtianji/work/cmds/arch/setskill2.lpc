inherit F_CLEAN_UP;
inherit F_CMD;
#include <command.h>
int main(object me, string arg)
{
  int level;
  object ob;
  string work, obj;
  string wiz_status;
  wiz_status = SECURITY_D->get_status(me);
  if( me!=this_player(1) ) return 0;
  if( wiz_status != "(admin)" )
    return notify_fail(CYN"你没有权利使用这个指令！\n"NOR); //By waiwai@2001/06/05
  if( !arg )
    return notify_fail("setskill2 <某人> <技能>/all <级别数>。\n");
  if( !arg || sscanf(arg, "%s %s %d", obj, work, level)!=3 )
    return notify_fail("setskill3 <某人> <技能>/all <级别数> \n");
  ob = find_player(obj);
  if( !ob )
    ob = find_living(obj);
  if( !ob )
    ob = present(obj, environment(me));
  if( !ob )
    return notify_fail("找不到这个生物.\n");
  if( (wiz_level(me) < wiz_level(ob)) && userp(ob) )
    return notify_fail("你没有设置" + ob->name() + "技能的权利。\n");
  if( (wiz_level(me) < wiz_level("(admin)")) && me!=ob )
    return notify_fail("你没有设置" + ob->name() + "技能的权利。\n");
  if( work == "all" )
  {
    if( level ==0 )
    {
       ob->set("work/medical", 0);
       ob->set("work/niangjiu", 0);
       ob->set("work/shoulie", 0);
       ob->set("work/fish", 0);
       ob->set("work/combine", 0);
       ob->set("work/weapon", 0);
       ob->set("work/cooking", 0);
       ob->set("work/farmer", 0);
       ob->set("work/wakuang", 0);
       ob->set("work/war", 0);
       write("将"+ob->name()+"("+ob->query("id")+")的所有基本生存技能设置为 "+level+" \n");
       write(WHT"成功设置完毕.\n"NOR);
    }

    else if( work == "work/medical"
          || work == "work/weapon"
          || work == "work/niangjiu"
          || work == "work/shoulie"
          || work == "work/fish"
          || work == "work/combine"
          || work == "work/war"
          || work == "work/cooking"
          || work == "work/farmer"
          || work == "work/wakuang"
          ||  work == "all" )
    {
      ob->set("work/medical", level);
      ob->set("work/weapon", level);
      ob->set("work/niangjiu", level);
      ob->set("work/shoulie", level);
      ob->set("work/fish", level);
      ob->set("work/combine", level);
      ob->set("work/cooking", level);
      ob->set("work/farmer", level);
      ob->set("work/wakuang", level);
      ob->set("work/war", level);
      write("将"+ob->name()+"("+ob->query("id")+")的所有基本生存技能设置为 "+level+" \n");
      write(WHT"成功设置完毕.\n"NOR);
    }

    else
      return notify_fail(WHT"设置错误！！！\n"NOR);
  }

  else if( work == "work/medical"
        || work == "work/makejia"
        || work == "work/niangjiu"
        || work == "work/shoulie"
        || work == "work/buyu"
        || work == "work/combine"
        || work == "work/war"
        || work == "work/cooking"
        || work == "work/farmer"
        || work == "work/wakuang"
        ||  work == "all" )
  {
    ob->set(work, level);
    write(WHT"将 "+ob->name(1)+"("+ob->query("id")+") "WHT"的");
    printf("%-36s 设置为： %d\n", to_chinese(work) + "(" + work + ")", level);
    write(WHT"成功设置完毕.\n"NOR);
  }

  else
    return notify_fail(WHT"设置错误！！！\n"NOR);
  if( ob!=me )
    log_file("wizcmds/setskill2",sprintf("%s设置%s的 %s(%s) 生存技能到 %d 时间在：[%s]\n",
             log_id(me), log_id(ob), to_chinese(work), work, level, log_time() ) );
  return 1;
}

int help()
{
        write(@LONG
指令格式：setskill2  <某人> <基本生存技能>/all <级别数>
用来设定某人的某种生存技能的级别数, 如果第二项是 all 则将其所有的
技能改为设定的级别数。如果选择了级别数为 0 则设定该人此项技能为0。
警告：请慎用此命令。
LONG    );
        return 1;
}

