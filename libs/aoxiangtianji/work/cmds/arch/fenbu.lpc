#include <command.h>
int main(object me)
{
  if( me!=this_player(1) )
    return 0;
  if( wiz_level(me) < wiz_level("(arch)") )
    return notify_fail("你的巫师等级太低，没有使用这个指令的权力。\n");
  log_file("wizcmds/taskfenbu_log","["+log_time()+"] "+log_id(this_player())
        +"手动分布使命(TASK)。 \n");
  TASK_D->init_dynamic_quest(1);
  return 1;
}

int help(object me)
{
  write(@HELP
fenbu 命令是用来重新布所有（完成和没完成）的使命（ｔａｓｋｓ）
HELP
    );
return 1;
}

