// CMDS /cmds/std/learn.c
#include <skill.h>
#include <ansi.h>
inherit F_CLEAN_UP;
int can_learn(object me, string skill);
string *reject_msg = ({
	"说道：您太客气了，这怎么敢当？\n",
	"像是受宠若惊一样，说道：请教？这怎么敢当？\n",
	"笑着说道：您见笑了，我这点雕虫小技怎够资格「指点」您什么？\n",
});
void create()
{
  seteuid(getuid());
}

int main(object me, string arg)
{
  object where = environment(me);
  string skill, teacher, skill_name;
  object ob;
  mixed flag;
  int master_skill, my_skill, sen_cost, times, i;
  int rand,  upper, qlearned, mystery;
  mapping white_black;

  int t = time();
  if(!arg)
    return notify_fail("指令格式：learn <技能> from <某人> for <次数>\n");
  if(sscanf(arg, "%s for %d", arg, times)!=2 )
    times=1;

  if(times<1)
    times=1;
  if(times>100)
    times=100;
  if(!arg || sscanf(arg, "%s from %s", skill, teacher)!=2 )
    return notify_fail("指令格式：learn <技能> from <某人> for <次数>\n");
  if(where->query("pigging"))
    return notify_fail("你还是专心拱猪吧！\n");
  if( where->query("alternative_die") )
    return notify_fail("这里不能学习。\n");
  if(me->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if((string)me->query("Pfamily"))
    return notify_fail("你已被"+me->query("Pfamily")+"逐出师门，好自为知吧。。。\n");
  if(me->is_ghost())
    return notify_fail("你还是个死鬼，学什么学？老实给我呆着吧你！。\n");
  if(t == me->query_temp("time/learn"))
    return notify_fail("你刚刚才学习过（如果你要连续学习，可以指明学习的次数）。\n");
  if(me->is_fighting())
    return notify_fail("临阵磨枪？来不及啦。\n");
  if(! (ob = present(teacher, environment(me))) || ! ob->is_character())
    return notify_fail("你要向谁求教？\n");
  if(! living(ob))
    return notify_fail("嗯....你得先把" + ob->name() + "弄醒再说。\n");
  if( ob->prevent_learn(me, skill) )
    return 1;
  if (playerp(ob))
    return notify_fail("你无法向玩家请教！\n");

  if(! me->is_apprentice_of(ob))
  {
    rand = ob->recognize_apprentice(me, skill);
    if (rand == 0)
      return notify_fail( ob ->name() + element_of(reject_msg) );
    else if (rand < 0)
      return 1;
  }

  if(! master_skill = ob->query_skill(skill, 1))
    return notify_fail("这项技能你恐怕必须找别人学了。\n");
  if(stringp(flag = ob->query("no_teach/" + skill)))
  {
    message_vision(CYN "$N" CYN "摇摇头，说道：" + flag + "\n" NOR, ob);
    return 1;
  }

  else if (intp(flag) && flag)
  {
    if (flag != -1)
      write(CYN + ob->name() + CYN "说道：对不起，" + to_chinese(skill)
                + "可不能随便传授。\n" NOR);
    return 1;
  }

  my_skill = SKILL_D(skill)->valid_learn_level();
  if (my_skill && me->is_apprentice_of(ob) && me->query_skill(skill, 1) >= my_skill)
  {
     write(CYN + ob->name() + CYN "说道：你的" + to_chinese(skill) +
           CYN "功力已经是非同凡响了，我就不再教你，你自己多研究吧。"
               "\n" NOR);
     return 1;
  }

  upper= (int)me->query("potential")-(int)me->query("learned_points");
  if(times>upper)
    times=upper;
  if(upper<=0)
    return notify_fail("你的潜能已经发挥到极限了，没有办法再成长了。\n");
  my_skill = me->query_skill(skill, 1);
  if (me->query("detach/times") && my_skill >= (int)(master_skill - me->query("detach/times") * 10))
     return notify_fail(CYN + ob->name() + CYN "皱了皱眉头，不禁想"
                        "起你过去的叛师经历。\n" NOR);
  if (my_skill > master_skill/2*3)
  {
     write(CYN + ob->name() + CYN "说道：你的" + to_chinese(skill) +
           CYN "功力已经是非同凡响了，我就不再教你，你自己多研究吧。"
               "\n" NOR);
     return 1;
  }

  if( userp(me) && !wizardp(me) )
  {
    if( my_skill >= 200 && my_skill < 300)
    {
      if((int)me->query("family/family_faith")<= my_skill*4 )
      {
      	if (me->is_apprentice_of(ob))
          message_vision(CYN"$N笑着说：你对本门的忠诚度不够！"
                            "我怕你是个半途而废的料。\n"NOR,ob);
        else
          message_vision(CYN"$N笑着说：我虽不是你的师傅！"
                            "但你学习这门技能却需要考虑你的门忠。\n"NOR,ob);
        return 0;
      }

    }

    else if( my_skill >=300 && my_skill <400)
    {
      if((int)me->query("family/family_faith")<= my_skill*6 )
      {
      	if (me->is_apprentice_of(ob))
          message_vision(CYN"$N笑着说：你对本门的忠诚度不够！"
                          "还请多多努力。\n"NOR,ob);
        else
          message_vision(CYN"$N笑着说：我虽不是你的师傅！"
                            "但你学习这门技能却需要考虑你的门忠。\n"NOR,ob);
        return 0;
      }

    }

    else if( my_skill >=400 && my_skill <500)
    {
      if((int)me->query("family/family_faith")<= my_skill*8 )
      {
      	if (me->is_apprentice_of(ob))
          message_vision(CYN"$N笑着说：你对本门的忠诚度不够！"
                          "还请多多努力。\n"NOR,ob);
        else
          message_vision(CYN"$N笑着说：我虽不是你的师傅！"
                            "但你学习这门技能却需要考虑你的门忠。\n"NOR,ob);
        return 0;
      }

    }

    else if( my_skill >=500 )
    {
      if((int)me->query("family/family_faith")<= my_skill*12 )
      {
      	if (me->is_apprentice_of(ob))
          message_vision(CYN"$N笑着说：你对本门的忠诚度不够！"
                          "还请多多努力。\n"NOR,ob);
        else
          message_vision(CYN"$N笑着说：我虽不是你的师傅！"
                            "但你学习这门技能却需要考虑你的门忠。\n"NOR,ob);
        return 0;
      }

    }

  }

  if (!can_learn(me, skill))
    return 0;
  notify_fail("依你目前的能力，没有办法学习这种技能。\n");
  if (! SKILL_D(skill)->valid_learn(me))
    return 0;
  sen_cost = 300 / (int)me->query_int();
  if ( my_skill < 30)
    sen_cost *= 2;
  if((me->query("potential") - me->query("learned_points")) < times)
    return notify_fail("你的潜能不够学习这么多次了。\n");
  write(sprintf(CYN "你开始向%s"NOR CYN"请教" + chinese_number(times) +
                    "句有关「%s」的疑问。\n" NOR,ob->name(), to_chinese(skill)));
  tell_object(ob, sprintf("%s向你请教有关「%s」的问题。\n", me->name(), to_chinese(skill)));
  if (! me->can_improve_skill(skill))
  {
     write("也许是缺乏实战经验，你对" +
           ob->name() + "的回答总是无法领会。\n");
     return 1;
  }

  if(playerp(ob))
  {
    if ((int)ob->query("sen") > sen_cost * times / 5 + 1)
      ob->receive_damage("sen", sen_cost / 5 + 1);
    else
    {
      write("但是" + ob->name() + "显然太累了，没有办法教你什麽。\n");
      tell_object(ob, "但是你太累了，没有办法教" + me->name() + "。\n");
      return 1;
    }

  }

  me->set_temp("time/learn", t);
  mystery = 0 ;
  for (i = 0; i < times ; i++)
  {
    reset_eval_cost();
    if ((int)me->query("sen") < sen_cost)
    {
      if (me->query("env/auto_refresh") &&
          me->query_skill("force",1) > 100 &&
          CLASS_D("force/refresh")->exert(me, me))
      {
        write("你觉得精神好了一些，继续进行学习。\n");
        i--;
        continue;
      }

      else
      {
        me->set("sen", 0);
        break;
      }

    }

    if (i == 0)
    {
      if(me->query("special_skill/mystery"))
      {
      if(me->query("special_skill/mystery"))
        if( skill=="force" )
          write("你的玄黄聚纳使你多增加了一些内力技能点数。\n");
      }

      if(my_skill < master_skill)
      {
        if(skill_name = SKILL_D(skill)->query_skill_name(my_skill))
          write(sprintf("你听了%s的指导，对「%s」这一招似乎有了些心得。\n", ob->name(), skill_name));
        else
          write(sprintf("你听了%s的指导，似乎有了些心得。\n", ob->name()));
      }

      else
      {
        message_vision("$N对$n说道：你的「"+to_chinese(skill)+
                       "」已经不输为师了，咱们一起切磋切磋吧！\n",ob,me);
        write(sprintf(HIR"你与%s切磋了一会儿，似乎有所领悟。\n"NOR, ob->name()));
      }

    }

    me->receive_damage("sen", sen_cost);
    me->add("learned_points", 1);
    rand = random(me->query_int()+1);
    if(me->query("special_skill/mystery"))
      if( skill=="force" )
        mystery = 2+random(10);
    rand += mystery;
    rand += (int)SKILL_D(skill)->learn_bonus();
    white_black = SKILL_D(skill)->black_white_ness();
    if (mapp(white_black) && sizeof(white_black))
    {
      if (my_skill > white_black["skill_level"])
      {
      	upper = my_skill - white_black["skill_level"];
      	upper = upper*white_black["effect"]/100;
      	upper = random(upper + 2);
      	rand -= upper ;
      	if (rand < 10)
      	  rand = random(10) + 1;
      }

      else
      {
      	upper = white_black["skill_level"] - my_skill;
      	upper = upper*white_black["effect"]/100;
      	upper = random(upper + 1);
      	if (upper > 15)
      	  upper = 15;
      	rand += upper;
      }
    }

    if(my_skill < master_skill)
      me->improve_skill(skill, rand);
    else
    {
      qlearned=me->query_learned()[skill];
      if (qlearned>3*(my_skill+1)*(my_skill+1))
        me->improve_skill(skill, rand);
      else
        me->improve_skill(skill, rand, 1);
    }

  }

  if (i == 0)
    write(WHT"然而你今天太累了，无法再进行任何学习了。\n"NOR);
  else if (i > 0 && i < times)
    write(WHT"但是你今天太累了，学习了" + chinese_number(i) + "次以后只好先停下来。\n"NOR);
  return 1;
}

int can_learn(object me, string skill)
{
  string skill_name;
  mapping skills;
  string mskill;
  if(stringp(mskill = SKILL_D(skill)->main_skill())
   && !SKILL_D(skill)->main_to_keep()
   && mskill != skill
   && me->query_skill(mskill, 1) > 0)
    return notify_fail("你现在没有必要再单独学习" + to_chinese(skill) + "了。\n");
  skills = me->query_skills();
  if (! mapp(skills))
    return 1;
  if (! SKILL_D(skill)->valid_enable("force") ||
      SKILL_D(skill)->valid_force("*"))
    return 1;
  foreach (skill_name in keys(skills))
  {
    if (file_size(SKILL_D(skill_name) + ".lpc") == -1)
      continue;
    if (! SKILL_D(skill_name)->valid_enable("force") || skill_name == skill)
      continue;
    if (! SKILL_D(skill_name)->valid_force(skill) && skill_name != "tuna-qigong")
      return notify_fail(HIR"你不散了" + to_chinese(skill_name) + "，怎么学习" + to_chinese(skill) + "？\n"NOR);
  }

  return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : learn|xue <某人> <技能> <次数>

这个指令可以让你向别人请教有关某一种技能的疑难问题，当然，你请教的对象在这
项技能上的造诣必须比你高，而你经由这种方式学习得来的技能也不可能高於你所请
教的人，然而因为这种学习方式相当於一种「经验的传承」，因此学习可以说是熟悉
一种新技能最快的方法。
此外学习也需要消耗一些精力，而消耗的精力跟你自己、与你学习对象的悟性有关。
其他相关指令 : apprentice, practice, skills, study，enable
HELP
);
  return 1;
}

