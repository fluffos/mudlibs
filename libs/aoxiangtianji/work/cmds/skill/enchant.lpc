#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
  int max, pts;

  max = (int)me->query("max_mana")/20+1;
  if (! arg || (arg != "none" && arg != "max"
             && arg != "half" && ! sscanf(arg, "%d", pts)))
    return notify_fail("\n指令格式：enchant <使出几点法力伤敌>"
                       "|max|half|none \n你现在最多能用" HIY +
                       chinese_number(max) + NOR "点法力伤敌。\n");

  if( !me->query_skill_mapped("spells") )
    return notify_fail("你必须先 enable 一种法术。\n");
  if( arg=="none" )
    me->delete("mana_factor");
  else
  {
    if (arg == "max")
      pts = max;
    if (arg == "half")
      pts = max / 2;
    if (pts <= 0)
      return notify_fail("你只能用 none 表示不运内力，或数字"
                         "表示每一击用几点内力。\n");
    if (pts > max)
      return notify_fail("你最多只能用" HIY + chinese_number(max)
                       + NOR "点内力伤敌。\n");
    me->set("mana_factor", pts);

  }

  if (! me->query("mana_factor"))
    write(HIC "你决定放弃使用法力加力。\n" NOR);
  else
    write(HIC "你决定用" HIY + chinese_number(pts) + HIC "点法力伤敌。\n" NOR);
  return 1;
}

int help (object me)
{
        write(@HELP
指令格式: enchant <法力点数>|none|half|max

这个指令让你设定使用魔法武器时要用来导引武器魔力所用的法力强度。
法力点数越高，魔法武器的杀伤力也越强。
enchant none 则表示你不使用法力加力。
enchant max 表示使用最大的法力加力。
enchant half 表示用最大法力加力的一半
HELP
);
  return 1;
}

