// summon. 取回兵器
#include <command.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
  object ob;
  string id, str;
  if (! arg)
  {
    mapping bl, prop;
    string *kb, *kp;
    string msg,f_id, f_name, f_type, f_summon, f_status;
    int i;
    bl = me->query("build");
    if (!mapp(bl) || sizeof(bl) < 1)
      return notify_fail("你目前还没有任何自制法宝！\n");
    kb = keys(bl);
    id = me->query("id");
    msg = "┏━━━━┓━━━━━━━━┓━━━━┓━━━━┓━━━━━━━━━━━━━━━━━━━━┓\n";
    msg += HBBLU"┃法宝ＩＤ┃法宝名称        ┃法宝类型┃能否召唤┃法宝状态                                ┃\n"NOR;
    msg += "┗━━━━┛━━━━━━━━┛━━━━┛━━━━┛━━━━━━━━━━━━━━━━━━━━┛\n";
    for (i=0;i<sizeof(kb);i++)
    {
      f_id = 0;
      sscanf(kb[i],me->query("id") + "-%s",f_id);
      if (!stringp(f_id))
        continue;
      str = ITEM_DIR + id[0..0] + "/"  + id + "-" + f_id;
      if (!find_object(str) &&
         !load_object(str) &&
         file_size(str + ".lpc") <= 0)
      {
        f_name = " ";
        f_type = " ";
        f_summon = " ";
        f_status = HIR"ERROR"NOR;
      }

      else
      {
        call_other(str, "???");
        ob = find_object(str);
        if (!objectp(ob))
        {
          f_name = "";
          f_type = "";
          f_summon = "";
          f_status = HIR"ERROR"NOR;
        }

        else
        {
          f_name = ob->query("name");
          if (ob->is_weapon())
          {
            f_type = (string)ob->query("skill_type");
            prop = ob->query("weapon_prop");
          }

          else if (ob->is_armor())
          {
            f_type = (string)ob->query("armor_type");
            prop = ob->query("armor_prop");
          }

          else
            f_type = "";
          if (stringp(me->query("can_summon/" + f_id)))
            f_summon = HIG"Y"NOR;
          else
            f_summon = HIW"N"NOR;
          if (!mapp(prop) || sizeof(prop) < 1)
            f_status = "状态：" + HIR"ERROR"NOR;
          else
          {
            kp = keys(prop);
            f_status = "";
            for (int j=0;j<sizeof(kp);j++)
            {
              if (kp[j] != "damage" &&
                  kp[j] != "armor" &&
                  kp[j] != "dodge" &&
                  kp[j] != "spells" &&
                  kp[j] != "attack")
                continue;
              f_status += kp[j] + "(";
              f_status += prop[kp[j]] + ") ";
            }

          }

        }

      }

      msg += sprintf("┃%-"+(8+color_len(f_id))+"s┃%-"+
                            (16+color_len(f_name))+"s┃%-"+
                            (8+color_len(f_type))+"s┃%-"+
                            (8+color_len(f_summon))+"s┃%-"+
                            (40+color_len(f_status))+"s┃\n",
                            f_id,f_name,f_type,f_summon,f_status);
    }

    msg += "┗━━━━┛━━━━━━━━┛━━━━┛━━━━┛━━━━━━━━━━━━━━━━━━━━┛\n";
    msg += "\n";
    write(msg);
    return 1;
  }

  if (!wizardp(me) && !stringp(str = me->query("can_summon/" + arg)))
    return notify_fail("你不知道如何召唤这个物品。\n");
  if (me->is_ghost())
     return notify_fail("等你还了阳再召唤吧。\n");

  id = me->query("id");
  str = ITEM_DIR + id[0..0] + "/"  + me->query("id") + "-" + arg;
  if (!find_object(str) &&
      !load_object(str) &&
      file_size(str + ".lpc") <= 0)
    return notify_fail("你要召唤什么？\n");

  call_other(str, "???");
  ob = find_object(str);
  if (! ob || ! ob->receive_summon(me))
  {
    message_vision(HIM "$N" HIM "扬起手来，口中念念有"
                       "词。\n然而什么也没有发生 :)\n", me);
  }

  return 1;
}

int help(object me)
{
write(@HELP
指令格式 : xsummon <物品的ID>
此指令可让你把某些物品呼唤过来并装备上，当然你得有一定的
精力施展仙术才行。
HELP
    );
    return 1;
}

