inherit F_CLEAN_UP;
#include <ansi.h>
#define SYNTAX   " 指令格式：fangqi2 <skills名称> to <要设置到的级别数> \n"
int main(object me, string arg)
{
  int skill_lvl, lvl=0;
  string skill;
  if (userp(me) && !wizardp(me))
  {
    if (uptime() - me->query_temp("last_fangqi2_time/fangqi2") < 180 )
      return notify_fail(WHT"你不能连续使用这个指令。\n"NOR);
    if( me->query("skills/fangqi2") >=10 )
      return notify_fail(WHT"你使用这个指令的次数已达10次,无权再使用了。\n"NOR);
  }

  if (!arg || sscanf(arg,"%s to %d",skill,lvl) !=2)
    return notify_fail(SYNTAX);
  skill_lvl = me->query_skill(skill,1);
  if( lvl <0 )
    return notify_fail(WHT"技能级别不能设置为负。\n"NOR);
  if( lvl == skill_lvl && lvl>0)
    return notify_fail(WHT"你不能设置为相同级别。\n"NOR);
  if( lvl > skill_lvl || lvl > 600)
    return notify_fail(WHT"设置级别错误或者这项技能已经超过了600。\n"NOR);
  if( !me->delete_skill(skill) )
    return notify_fail(WHT"你并没有这项技能。\n"NOR);
  if( lvl >0 )
    write(WHT"你重新设定 " HIR+ to_chinese(skill) + NOR WHT" 级别到 "HIR+lvl+"\n"NOR);
  else
    write(WHT"你重新设定 " HIR+ to_chinese(skill) + NOR WHT" 级别到 "HIR+lvl+" 这项技能被完全的删除掉了。\n"NOR);
  if( lvl > 0 )
    me->set_skill(skill, lvl);
  me->set_temp("last_fangqi2_time/fangqi2",uptime());
  me->add("skills/fangqi2",1);
  tell_object(me, "\n你可以使用这个指令10次，已经使用了" + chinese_number(me->query("skills/fangqi2"))+"次了！\n");
  return 1;
}

int help()
{
  write(@TEXT
指令格式：fangqi2 <skills名称> to [要设置到的级别数值]
例如：
√五行拳 (wuxing-quan)   - 勉勉强强   150        0 - [  0%]
fangqi2 wuxing-quan to 140
√五行拳 (wuxing-quan)   - 勉勉强强   140        0 - [  0%]

重新设定一项你所学过的技能，注意这里所说的「放弃」是指将这项技能从你人物
的资料中重新设定到一定的级别。但是skills超过600的将不能使用这个指令了。
这个指令使用的场合通常是用来设定一些「不小心」练出来或练过了的的技能。
这个指令每个人只能使用10次。
TEXT
);
  return 1;
}

