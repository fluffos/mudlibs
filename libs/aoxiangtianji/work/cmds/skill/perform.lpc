#include <skill.h>
#include "/cmds/std/valid_kill.h";
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
  object weapon, target;
  string martial, skill, perf;
  mixed temp_pfm;

  seteuid(getuid());

  if (me->query_temp("in_qingwang"))
    return notify_fail(MAG"你眼前出现那个熟悉的身影，搅的你心烦气燥，似离情，剪不断，理还乱。\n"NOR);
  if( me->is_busy() )
    return notify_fail("( 你上一个动作还没有完成，不能施用外功。)\n");

  temp_pfm = me->query_temp("busy_for_pfm");
  if (stringp(temp_pfm))
    return notify_fail(sprintf("你正在使用%s！\n",temp_pfm));
  else if (intp(temp_pfm) && (temp_pfm > 0))
    return notify_fail("你正在使用其他绝招攻击敌人。\n");
  if( !arg )
    return notify_fail("你要用外功做什么？\n");
  if (userp(me) && !wizardp(me))
  {
    if(environment(me)->is_safty() ||
       environment(me)->query("no_fight") ||
       environment(me)->query("no_kill") ||
       environment(me)->query("no_magic") )
      return notify_fail("这里不能使用外功。\n");
  }

  if (environment(me)->do_perform(arg) > 0)
    return 1;

/*
  t = time();
  if (t == me->query_temp("last_pfm_time"))
    return notify_fail("你刚刚使用了绝技！\n");
  me->set_temp("last_pfm_time",t);
*/

  if( sscanf(arg, "%s on %s", perf, arg)==2 )
  {
    arg=perf+" "+arg;
  }

  if(sscanf(arg, "%s %s", perf, arg)==2 )
  {
    target = present(arg, environment(me));
    if( !objectp(target) )
      target = present(arg, me);
    if( !objectp(target) )
      return notify_fail(sprintf("这里没有 %s。\n",arg));

    if(!valid_kill(me,target,0))
      return 0;
    if( userp(me) && userp(target) && target->query_temp("netdead") )
      return notify_fail("对方正在断线中，不能对其施用外功。\n");
    if (target->do_perform(perf) > 0)
      return 1;
  }

  else
  {
    perf = arg ;
    target = 0 ;
  }

  weapon = me->query_temp("weapon");
  if (sscanf(perf, "%s.%s", martial, perf) != 2)
  {
    if (objectp(weapon))
      martial = weapon->query("skill_type");
    else
      martial = "unarmed";
  }

  else
  {
    if (objectp(weapon) && martial == "unarmed")
      return notify_fail("你手中持有武器，使用这个绝招不大方便！\n");
  }

  if( stringp(skill = me->query_skill_mapped(martial)) )
  {
    notify_fail("你所使用的外功中没有这种功能。\n");
    if( SKILL_D(skill)->perform_action(me, perf, target) )
    {
      if( random(200) < (int)me->query_skill(skill) )
        me->improve_skill(skill, 1, 1);
      return 1;
    }

    else if( SKILL_D(martial)->perform_action(me, perf, target) )
    {
      if( random(200) < (int)me->query_skill(martial, 1) )
        me->improve_skill(martial, 1, 1);
      return 1;
    }

    return 0;
  }

  return notify_fail("你请先用 enable 指令选择你要使用的外功。\n");
}

int help (object me)
{
        write(@HELP
指令格式：perfrom [<武功种类>.]<招式名称> [on] [<施用对象>]
如果你所学的外功(拳脚、剑法、刀法....)有一些特殊的攻击方式或招式，可以
用这个指令来使用，你必须先用 enable 指令指定你使用的武功，不指定武功种
类时，空手的外功是指你的拳脚功夫，使用武器时则是兵刃的武功。

换句话说，只要是 enable 中的武功有特殊招式的，都可以用这个指令使用。
HELP
        );
        return 1;
}

