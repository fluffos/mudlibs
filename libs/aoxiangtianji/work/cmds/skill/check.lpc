// check.c
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me,string arg)
{
  object ob;
  int mana_cost;
  int sen_cost;
  string msg;
  if(!arg)
    return notify_fail("你想打听谁的状态？\n");
  if( !wizardp(me) && userp(me) )
  {
    if(environment(me)->is_safty() ||
       environment(me)->query("no_fight") ||
       environment(me)->query("no_magic") )
      return notify_fail("安全区内不能用地耳灵。\n");

    if (me->is_busy() || me->is_fighting() )
      return notify_fail("你现在正忙着呢。\n");

    if( me->is_ghost() )
      return notify_fail(HIB"做了鬼了，就老实点吧！\n"NOR);

    if((int)me->query("daoxing") < 100000)
      return notify_fail("你的道行不够，用不了地耳灵。\n");

    if((int)me->query("mana") < 60)
      return notify_fail("你的法力不够，用不了地耳灵。\n");

    if( (int)me->query("sen") <= 60
       || uptime()-me->query_temp("last_check_time")<30)
      return notify_fail(WHT"你的精神无法集中。\n"NOR);
    me->set_temp("last_check_time",uptime());
  }

  mana_cost=-(100-(int)me->query_skill("spells"))/4-40;
  mana_cost=mana_cost+10;
  if(mana_cost > -100)
    mana_cost=-100;
  me->add("mana", mana_cost);
  sen_cost=50;
  message_vision(WHT"$N口中念了几句咒文，眼中突然精光一闪，大喝一声"HIY"“顺风耳何在！”"
                 NOR WHT"只见一股烟雾过后，一个神色慌张的家伙不知从哪里钻了出来在$N耳边"
                 "低声嘀咕了几句。\n"NOR, me);

  me->add("sen", -60);
  ob = find_player(arg);
  if(!objectp(ob))
  {
     ob=present(arg,environment(this_player()));
     if(objectp(ob) && !living(ob))
       ob=0;
  }

  if( !objectp(ob) )
    ob = find_living(arg);
  if(!objectp(ob) || (ob->query("env/invisibility") && wizardp(ob) ))
    return notify_fail("顺风耳告诉你：奇怪，找不到这个人．．．\n");

  if( userp(me) && (wiz_level(me) < wiz_level(ob)) )
    return notify_fail("顺风耳告诉你：奇怪，找不到这个人．．．\n");
  if( wizardp(me) && (wiz_level(me) < wiz_level(ob)) )
    return notify_fail("顺风耳告诉你：奇怪，找不到这个人．．．\n");
  if( objectp(ob) && ob != me )
  {
    if( ob->query("no_find") )
      return notify_fail("顺风耳告诉你：这个。。。小人不敢说。\n");
    if (!environment(ob) || environment(ob)->query("no_find"))
      return notify_fail("顺风耳告诉你：这个。。。小人不敢说。\n");
    if( ob->query("capapie_tattoo") )
    {
      if( !wizardp(me) && ob->query("capapie_tattoo/feature/no_check") )
        return notify_fail("顺风耳告诉你：“" + ob->name()
                         + "身上刺着" + ob->query("capapie_tattoo/totem")
                         + "，小的实在不敢泄露天机。”\n");
    }

    else
    {
      mapping tattoo;
      if( mapp( tattoo = ob->query("tattoo") ) )
      {
         string *limbs = keys(tattoo);
         foreach(string limb in limbs)
           if( !wizardp(me) && ob->query("tattoo/" + limb + "/feature/no_check") )
             return notify_fail("顺风耳告诉你：“" + ob->name() + "身上刺着"
                     + ob->query("tattoo/" + limb + "/totem")
                     + "，小的实在不敢泄露天机。”\n");
      }

    }

  }

  if( !wizardp(me) )
    if((int)ob->query("age") <= 18 && userp(ob) && ob!=me)
      return notify_fail("顺风耳告诉你：你竟要我去打听小孩子，有没有搞错！\n");

  write("顺风耳告诉你："NOR+HIY+log_id(ob)+HIC"的"NOR+HIR"道行"+NOR"修行已达"+
               RANK_D->describe_dx((int)ob->query("daoxing"))+"的境界。\n");
  write("顺风耳告诉你："NOR+HIY+log_id(ob)+HIC"的"NOR+HIY"武学"+NOR"修为已达"+
               RANK_D->describe_exp((int)ob->query("combat_exp"))+"的境界。\n");
  write("顺风耳告诉你："NOR+HIY+log_id(ob)+HIC"的"NOR+HIB"法力"+NOR"修为已达"+
               RANK_D->describe_fali((int)ob->query("max_mana"))+"的境界。\n");
  write("顺风耳告诉你："NOR+HIY+log_id(ob)+HIC"的"NOR+HIM"内力"+NOR"修为已有"+
               RANK_D->describe_neili((int)ob->query("max_force"))+"的火候。\n");
  message_vision(WHT"$N忽然莫名其妙地哆嗦了一下。\n"NOR,ob);
  msg=MAG"你急忙掐指一算，"NOR;
  if( wizardp(me) && !wizardp(ob) )
  {
    msg+=MAG"心中却只是一片茫然。\n"NOR;
  }

  else if( ob->query("daoxing")>me->query("daoxing")/5 )
    msg+=MAG"原来是 "HIR+log_id(me)+NOR MAG" 正在打听你的道行。\n"NOR;
  else
    msg+=MAG"心中却只是一片茫然。\n"NOR;
  tell_object(ob, msg);
  return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : check|cha [<某人>]
地耳灵: 打听别人现在的道行,法力,武学以及内力级别。
要求道行大于100年
HELP
);
  return 1;
}

