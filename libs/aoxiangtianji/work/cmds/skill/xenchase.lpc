// enchase.c
// Modify by Rcwiz for hero
#include <ansi.h>
inherit F_CLEAN_UP;
void create() { seteuid(getuid()); }

int main(object me, string arg)
{
  string item, tessera;
  object obj, dest;
  int type;
  if (! arg)
    return notify_fail("你要干什么？\n");
  if (me->is_busy())
    return notify_fail("先忙完了你的事情再做这件事情吧！\n");
  if (me->is_fighting())
    return notify_fail("你现在正在打架，没时间做这些事情。\n");
  if (sscanf(arg, "%s with %s", item, tessera) != 2)
     return notify_fail("你要往这上面镶嵌什么物品？\n");

  type = 0;
  if (tessera == "out")
    type = 1;

  if (!type && !objectp(obj = present(tessera, me)))
    return notify_fail("你身上没有这样东西可以用来镶嵌。\n");
  if (! objectp(dest = present(item, me)))
    return notify_fail("你身上没有这样道具。\n");
  notify_fail("你无法把镶嵌到" + dest->name() + "上。\n");
  return ITEM_D->do_enchase(me, dest, obj,type);
}

int help(object me)
{
  string msg;
  msg = "\n\n"
"指令格式 :  xenchase <道具> with <特殊物品>\n\n"
"这个指令可以让你将某样特殊物品镶嵌到另外一种道具上，使得道具\n"
"具有特殊的能力。\n\n";
  msg += " xenchase <道具> with out \n\n这将取出你已经镶嵌的物品！\n\n";
  write(msg);
  return 1;
}

