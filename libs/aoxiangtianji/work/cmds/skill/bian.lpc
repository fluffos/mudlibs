// CMDS /cmds/std/bian.c
#include <command.h>
int do_bian(object me);
int main(object me, string arg)
{
  object who,env;
  int mana,spells,dmana;
  seteuid(getuid());
  env = environment(me);
  if(!objectp(env) || env->query("no_bian") )
    return notify_fail(HIR"你喃喃自语，想要变身，可是咒语在这里好象不起作用！\n"NOR);
  if( me->is_ghost() )
    return notify_fail(HIB"鬼本无形，还需要变化吗？！\n"NOR);
  if( me->is_fighting() )
    return notify_fail(HIW"你正在战斗，变身有用吗？!\n"NOR);
  if (env->do_bian(arg) > 0)
    return 1;

  if (me->is_busy()
   || me->query_temp("doing_xiudao")
   || me->query_temp("pending/exercising")
   || me->query_temp("pending/meditating"))
    return notify_fail("你好忙啊，静心处理现在的事情吧，防止走火入魔！\n");

  if (!arg || arg=="me" || arg==me->query("id"))
    who=me;
  else
  {
    if(!objectp(who=present(arg,environment(me))))
      return notify_fail("你想变成什么？\n");

    if (who->do_bian(arg) > 0)
      return 1;

    if( wiz_level(me) < wiz_level(who))
      who =me;
  }

  if(who==me)
  {
    me->delete_temp("spellslevel");
    me->delete_temp("apply/name");
    me->delete_temp("apply/id");
    me->delete_temp("apply/short");
    me->delete_temp("apply/long");
    me->delete_temp("family");
    me->delete_temp("no_heal_up/bian");
    if(me->query_temp("d_mana"))
    {
      me->delete_temp("d_mana");
      me->delete_temp("k_bian");
      while( environment(me)->is_character() )
        me->move(environment(environment(me)));
      if( me->query("env/invisibility") >7 )
        tell_object(me,HIY"你口念咒语，身形一晃，现了真身。\n");
      else
        message_vision(HIY "$N口念咒语，身形一晃，现了真身。\n"NOR,me);
    }

    else
    {
      return notify_fail("你想变成谁？\n");
    }

  }

  else
  {
    spells=me->query_skill("spells");
    mana=me->query("mana");
    if( !wizardp(me) && userp(me) )
    {
      if( RANK_D->grade_dx( RANK_D->describe_dx( (int)me->query("daoxing") ) )
         < RANK_D->grade_dx(BLU "初领妙道" NOR) )
        return notify_fail("你现在还初领妙道都谈不上，哪里能变。\n");

      if( RANK_D->grade_fali(
            RANK_D->describe_fali( (int)me->query("max_mana") ) )
          < RANK_D->grade_fali(HIB "神出鬼没" NOR) )
        return notify_fail("看来以你的法力修为还不能神出鬼没。\n");

      if (spells<100)
        return notify_fail("你的法术等级不够。\n");

      if (mana<150)
        return notify_fail("你目前法力不够充盈。\n");

      if( who->query("limit_fight"))
        return notify_fail("你不能变成对方的模样。\n");

      if (who->query("no_bian"))
        return notify_fail(HIB"你的法术再高也不足以变成" + who->name() + "。\n"NOR);
    }

    if (wizardp(who) && !wizardp(me))
      return notify_fail(HIB"你的法术再高也不足以变成大神。\n"NOR);

// 刺青
    if( userp(me) && who->query("capapie_tattoo") )
    {
      if( who->query("capapie_tattoo/feature/no_bian") )
      {
        message_vision(HIY"$N手捻口诀，念动真言，想变成$n，但是怎么也变不象。\n"NOR, me, who);
        return 1;
      }

    }

    else
    {
      mapping tattoo;
      if( mapp( tattoo = who->query("tattoo") ) )
      {
        string *limbs = keys(tattoo);
        foreach(string limb in limbs)
          if( who->query("tattoo/" + limb + "/feature/no_bian") )
          {
            message_vision(HIY"$N手捻口诀，念动真言，想变成$n，但是怎么也变不象。\n"NOR, me, who);
            return 1;
          }

      }

    }

    if( userp(me) && (!who->is_character() || who->is_corpse()) )
    {
      if( me->query_temp("leader") )
        return notify_fail(HIC"你正在跟随别人，不能变为非活物。\n"NOR);
      else
        me->set_temp("k_bian",1);  //变成非活物标记k_bian
    }

    dmana=30+400/(spells-20);
    if( me->query("env/invisibility") >7 )
    {
      tell_object(me,HIY"你手捻口诀，念动真言，摇身一变，变得和"
                + who->name()+HIY"一模一样！\n");
    }

    else
    {
      message_vision(HIY "$N手捻口诀，念动真言，摇身一变，变得和$n"
                       + "一模一样！\n" NOR,me,who);
    }

    if(wizardp(me) && !me->query_temp("apply/name"))
    {
      log_file("wizcmds/bian",sprintf("[%s] %s \n在 %s %s  变幻成了%s(%s)\n",
               log_time(),
               log_id(me),
               COLOR_D->clean_color(MISC_D->find_place(environment(me))),
               COLOR_D->clean_color(env->query("short")),
               who->name(1),
               geteuid(who)) );
    }

    me->set_temp("spellslevel",spells);
    me->set_temp("apply/name",({ who->name() }) );
    if(!userp(who))  //变成玩家，id不变
      me->set_temp("apply/id",who->parse_command_id_list());
    me->set_temp("apply/short", ({who->short()}));
    me->set_temp("apply/long", ({who->long()}));
    me->add("mana",-100);
    if((int)who->query_temp("d_mana")>0) //对象也是个“变化者”
    {
      me->set_temp("is_living", who->query_temp("is_living"));
      me->set_temp("unit",who->query_temp("unit"));
      me->set_temp("is_character",who->query_temp("is_character"));
      me->set_temp("gender",who->query_temp("gender"));
      me->set_temp("age",who->query_temp("age"));
      me->set_temp("race",who->query_temp("race"));
      me->set_temp("family",who->query_temp("family"));
    }

    else
    {
      me->set_temp("is_living",living(who));
      me->set_temp("unit",who->query("unit"));
      me->set_temp("is_character",who->is_character());
      me->set_temp("gender",who->query("gender"));
      me->set_temp("age",who->query("age"));
      me->set_temp("race",who->query("race"));
      me->set_temp("family",who->query("family"));
    }

    if (!me->query_temp("d_mana"))
      call_out("do_bian",5,me);
    me->set_temp("d_mana",dmana);
    me->set_temp("no_heal_up/bian",1);
  }

  return 1;
}

int do_bian(object me)
{
  int dmana,mana,spells;
  if(!me)
    return 1;
  dmana=me->query_temp("d_mana");
  spells=me->query_temp("spellslevel");

  mana=me->query("mana");
  if ((mana-dmana)>50 && spells>0 && dmana>0)
  {
    me->add("mana",(-dmana));
    call_out("do_bian",5,me);
  }

  else
  {
    mana=mana-dmana;
    if (mana<20)
      mana=20;
    me->set("mana",mana);
    me->delete_temp("spellslevel");
    me->delete_temp("d_mana");
    me->delete_temp("apply/name");
    me->delete_temp("apply/id");
    me->delete_temp("apply/short");
    me->delete_temp("apply/long");
    me->delete_temp("k_bian");
    while( environment(me)->is_character() )
      me->move(environment(environment(me)));
    if (dmana>0)
    {
      if( me->query("env/invisibility") >7  )
        tell_object(me,HIY"只见你面色苍白，一个恍惚之间，已经现了原形。\n");
      else
       	message_vision(HIY"只见$N面色苍白，一个恍惚之间，已经现了原形。\n" NOR,me);
    }

    me->delete_temp("no_heal_up/bian");
  }

  return 1;
}

int help(object me)
{
  write(@HELP
指令格式 ： bian [<人物>|<NPC>|<me>]
变身术，这个指令让你变化成其他人物的模样。是否能变，还要取决于
你的法术和法力大小。
其他相关指令： observe。
HELP
);
  return 1;
}