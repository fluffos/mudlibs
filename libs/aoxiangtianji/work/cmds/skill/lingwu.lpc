// lingwu.c
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
  string skillname;
  int skill;
  object where = environment(me);
  if( !arg )
    return notify_fail("你想自己领悟什么功夫？\n");
/*
  if(!me->query("vip"))
    return notify_fail(WHT"VIP会员专用指令，你无权使用。\n"NOR);
*/
  if(where->is_safty() ||
     where->query("no_fight")  ||
     where->query("sleep_room") ||
     where->query("no_book") ||
     where->query("no_kill") ||
     where->query("alternative_die") ||
     where->query("no_magic") )
    return notify_fail(HIR"这里不能领悟。\n"NOR);
  if( me->query_int() < 65)
    return notify_fail(WHT"你使劲地想啊想，可是发现什么也领会不到。看来悟性还不够。\n"NOR);
/*
  if(me->query_skill("archery") >=350)
    return notify_fail(WHT"你使劲地想啊想，可是发现什么也领会不到。\n"NOR);
*/
  if(me->is_fighting())
    return notify_fail(HIR"战斗中禁止领悟。\n"NOR);

  if (me->is_busy()
   || me->query_temp("doing_xiudao")
   || me->query_temp("pending/exercising")
   || me->query_temp("pending/meditating"))
    return notify_fail(WHT"你现在正忙着呢。\n"NOR);
  if ( !(skillname = me->query_skill_mapped(arg)) )
  {
    if (arg == to_chinese(arg))
      return notify_fail(HIR"好象没这种功夫吧？\n"NOR);
  }

  if (!me->query_skill(arg,1))
    return notify_fail(WHT"你好象不会"HIR"「" + to_chinese(arg) + "」"NOR WHT"吧？\n"NOR);
  skill = me->query_skill(arg,1);
  if ( (string)SKILL_D(arg)->type() == "knowledge" )
    return notify_fail( HIR+to_chinese(arg) +NOR WHT "只能靠学习来提高。\n"NOR);
  if (! me->can_improve_skill(arg))
  {
     write(WHT"你的实战经验不够，再怎么想也没用。\n"NOR);
     return 0;
  }

  notify_fail("依你目前的能力，没有办法学习这种技能。\n");
  if (! SKILL_D(arg)->valid_learn(me))
    return 0;
  if (skill < 300)
    return notify_fail(WHT"你的这门功夫级别太低，无法自己领悟，还是去找师父学习吧。\n"NOR);
  if (skill >= 500)
    return notify_fail(WHT"你的这门功夫级别太高，无法自己领悟。\n"NOR);
  if ( me->query("sen") < 20 )
    return notify_fail("你已经很累了，休息一下吧。\n");
  if ( me->query("kee") < 30 )
    return notify_fail("你气血不够了，休息一下吧。\n");
  if ( me->query("force") <= 10 )
    return notify_fail("你内力不够了，休息一下吧。\n");
  if ( me->query("potential") - me->query("learned_points") <= 100 )
    return notify_fail("你的潜能不够了。\n");
  write(YEL "你盘膝坐下，冥思苦想，似乎对" WHT+ to_chinese(arg) +YEL "的体会又深了一层。\n" NOR);
  me->receive_damage("sen",10);
  me->receive_damage("kee",30);
  me->add("learned_points", 50);
  me->add("force",-5);
  me->improve_skill(arg, me->query_int()/10 * skill/5);
  me->start_busy(2+random(5));
  return 1;
}

int help(object me)
{
  write(@TEXT
指令格式：lingwu <技能种类>
这个指令可以让你自己领悟某项大于300而小于500的技能。而你必须从实际运用中
获得足够的武学经验以支持你的这项技能。悟性65以下不能进行领悟。
相关指令：learn
TEXT
);
  return 1;
}