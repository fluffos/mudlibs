// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ITEM;

void create()
{
        set_name("信件", ({"xin", "letter"}));
        set("long",
               "这是一封你师门托付你的信件。\n");
        set("unit", "封");
        set("weight", 5);
//	set("no_drop", 1);
	set("no_get", 1);

	setup();
}
