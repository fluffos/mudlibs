// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
mapping *quest = ({
     ([      "quest":                "护法袈裟",
        "diff":                 10,
        ]),
     ([      "quest":                YEL "黄金斧" NOR,
        "diff":                 9,
        ]),
     ([      "quest":                YEL "飞驼金甲" NOR,
        "diff":                 8,
        ]),
     ([      "quest":                HIW "玉斧" NOR,
        "diff":                 7,
        ]),
     ([      "quest":                RED "血狼" NOR,
        "diff":                 6,
        ]),
     ([      "quest":                HIW "玉剑" NOR,
        "diff":                 5,
        ]),
     ([      "quest":                HIW "钻石" NOR,
        "diff":                 4,
        ]),
     ([      "quest":                HIG "翡翠" NOR,
        "diff":                 4,
        ]),
     ([      "quest":                HIW "剑 谱" NOR,
        "diff":                 10,
        ]),
     ([      "quest":                MAG "灵脂兰" NOR,
        "diff":                 6,
        ]),
     ([      "quest":                "银冠蛇胆",
        "diff":                 6,
        ]),
     ([      "quest":                "金冠蛇胆",
        "diff":                 6,
        ]),
});
mapping query_quest()
{
        return quest[random(sizeof(quest))];
}
