// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#include <ansi.h>
inherit SKILL;
mapping *quest = ({
        ([      "quest":		"孙不二",               
                "quest_type":           "杀",
                "time":  		900,
               "score"	:		10
        ]),
        ([      "quest":                "胖头陀",
                "quest_type":           "杀",
                "time":                 900,
                "score" :               10
        ]),
         ([      "quest":                "哑仆",
                "quest_type":           "杀",
                "time":                 900,
                "score" :               10
        ]),
        ([      "quest":                "裘万家",
                "quest_type":           "杀",
                "time":                 900,
                "score" :               10
        ]),
        ([      "quest":                "李莫愁",
               "quest_type":           "杀",
                "time":                 900,
               "score" :               10
        ]),       
         ([      "quest":                "铁手掌",
                "quest_type":           "寻",
                "time":                 800,
                "score" :               8
        ]),  
        ([      "quest":                GRN"玉竹棒"NOR,
                "quest_type":           "寻",
                "time":                 800,
                "score" :               6
        ]),
        ([      "quest":                "霍都",
               "quest_type":           "杀",
                "time":                 700,
                "score" :               10
        ]),
});

mapping query_quest()

{
        return quest[random(sizeof(quest))];
}

