void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (arg->query_temp("start_job") == 1) {
        say("裨将皱了皱眉：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，你还是安心守城吧。\n");
    } else if (arg->query_temp("mark/job_shadi") == 2) {
        say("裨将拱手说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，你来得正是时候，蒙古靼子已经快攻上城了。\n");
        arg->apply_condition("jobshadi_limit", random(5) + 5);
        arg->set_temp("start_job", 1);
        arg->set_temp("where", environment(arg));
        call_out("to_rob", 10, arg);
    }
    if (arg->query_temp("job_over") == 1) {
        say("裨将拱手说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，你已经可以回去复命了。\n");
        return;
    }
}

void to_rob(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v4 = arg->query("family");
    if (!arg) {
        return;
    }
    v1 = users();
    v3 = environment(arg);
    if (!arg->query_temp("start_job")) {
        return;
    }
    if (environment(arg)->query("short") == "青龙内门") {
        v2 = clone_object("/quest/guojob/job2/robber1");
        v2->do_change(arg);
        v2->move(v3);
        message_vision("\e[1;31m突然城下爬上来一个蒙古兵士。\n\e[2;37;0m", arg);
        v2->kill_ob(arg);
        arg->kill_ob(v2);
    }
}
