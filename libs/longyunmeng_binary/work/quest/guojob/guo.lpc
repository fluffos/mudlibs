    v2->set_temp("team_count", v5);
    v2->apply_condition("zzz_busy", 60);
    for (v4 = 0; v4 < v5; v4++) {
        v3[v4]->apply_condition("zzz_busy", 60);
    }
    for (v4 = 100; v4 * v4 * v4 / 10 <= v7; v4++) {
    }
