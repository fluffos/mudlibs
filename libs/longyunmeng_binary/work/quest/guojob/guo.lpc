string ask_job() {
    mixed v1;
    mixed v2;
    mixed v5;
    mixed v7;
    mixed v10;
    v1 = this_player();
    v2 = this_object();
    v5 = v1->query("combat_exp");
    if (interactive(v1) && v1->query_temp("zzz_job_target") && v1->query_condition("zzz_mission")) {
        return "你上一次的任务还没完成!";
    }
    if (interactive(v1) && !v1->query_temp("zzz_job_target") && v1->query_condition("zzz_mission")) {
        return "你办事不力，先等会吧。";
    }
    if (interactive(v1) && v1->query_condition("zzz_busy")) {
        return "现在我可没有给你的任务，等会再来吧。\n";
    }
    if (v5 <= 100000) {
        return "你的武功太差了,等练强了再来吧。\n";
    }
    v10 = "保护";
    v1->set_temp("zzz_job_type", v10);
    if (v10 == "保护") {
        v7 = names[1][random(sizeof(names[1]))];
        v1->apply_condition("zzz_mission", 30);
        v1->set_temp("zzz_job_target", v7);
        message_vision("\e[36m$N点了点头，对$n说道:蒙古人收买了一批武林败类,好象要暗杀" + v7 + "，你去保护他一下。\n\e" + "[2;37;0m", v2, v1);
        call_out("begin_kill", 30, v1, v7);
        return "多加小心。";
    }
}

int accept_object(mixed arg1, mixed arg2, mixed arg3) {
    if (arg2->query("id") != "corpse") {
        command("say 你给我这个干吗?");
        return 0;
    }
    if (!arg1->query_temp("zzz_job_target")) {
        command("say 好啊！不过你得先申请任务。");
        return 0;
    }
    if (arg1->query_temp("zzz_job_type") == "保护") {
        if (arg2->query_temp("must_killby") != arg1->query("id") || arg2->query("victim_user") || arg1->query_temp("zzz_given")) {
            command("shake");
            command("say 你杀错人了。");
            return 0;
        }
    }
    arg1->set_temp("zzz_given", 1);
    call_out("destroying", 1, arg2);
    call_out("ok", 1, arg1);
    return 1;
}

