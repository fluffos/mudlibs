void job(mixed arg1, mixed arg2, mixed arg3, mixed arg4) {
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v4 = this_object();
    v5 = 0;
    if (environment(arg1)->query("short") != arg2 && arg1->query_condition("zzz_busy")) {
        tell_object(arg1, "\e[1;33m\n你防守的地方不对吧!奸细出城了，你任务失败！\n\e[2;37;0m");
    }
    v4->apply_condition("zzz_busy", 0);
    if (environment(arg1)->query("short") == arg2 && arg1->query_condition("zzz_busy")) {
        if (arg4 > 0) {
            if (random(20) > 16) {
                v2 = clone_object("/quest/guojob/mengbing");
                v2->do_copy(arg1, arg3, 3);
                v2->set("title", "\e[1;33m蒙古千夫长\e[2;37;0m");
                v2->move(environment(arg1));
                v2->kill_ob(arg1);
            } else {
                v2 = clone_object("/quest/guojob/mengbing");
                v2->do_copy(arg1, arg3, 1);
                v2->move(environment(arg1));
                v2->kill_ob(arg1);
                v2 = clone_object("/quest/guojob/mengbing");
                if (random(20) > 10) {
                    v2->do_copy(arg1, arg3, 2);
                    v2->set("title", "\e[1;33m蒙古百夫长\e[2;37;0m");
                } else {
                    v2->do_copy(arg1, arg3, 1);
                }
                v2->move(environment(arg1));
                v2->kill_ob(arg1);
            }
            call_out("job", 120, arg1, arg2, arg3, arg4 - 1);
        } else if (present("menggu dahan", environment(arg1))) {
            tell_room(environment(arg1), "\e[1;36m蒙古兵挥挥手，示意奸细先走。\n奸细匆匆忙忙的离开了。\n\e[2;37;0m");
            tell_object(arg1, "\e[1;33m\n奸细出城了，你任务失败！\n\e[2;37;0m");
        } else {
            v2 = clone_object("/quest/guojob/jianxi");
            v2->do_copy(arg1, arg3);
            v2->set("title", "\e[1;31m奸细\e[2;37;0m");
            v2->move(environment(arg1));
            message_vision("\e[1;33m$N狂笑不已：就凭你们几个也想挡住我的去路?\n\e[2;37;0m", v2);
            v2->kill_ob(arg1);
            v3 = clone_object("/quest/guojob/mijian");
            v3->set_temp("host", arg1->query("id"));
            v3->move(v2);
        }
    } else {
        tell_object(arg1, "\e[1;33m\n奸细偷偷溜出了城，你任务失败！\n\e[2;37;0m");
    }
    return;
}

