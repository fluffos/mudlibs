    mixed v1;
    mixed v2;
    mixed v3;
    if (!arg) {
        return;
    }
    command("pat" + arg->query("id"));
    command("say 干的好，你办事干净利落,将来必成大器!");
    if (!arg->query("zzz_job_count")) {
        arg->set("zzz_job_count", 1);
    } else {
        arg->add("zzz_job_count", 1);
    }
    v3 = arg->query("zzz_job_count");
    v3 /= 30;
    v1 = random(20) + 200 + v3;
    if (arg->query_temp("zzz_job_super")) {
        v1 += 100;
        arg->delete_temp("zzz_job_super");
    }
    v2 = v1 / 3 + random(10);
    arg->add("potential", v2);
    arg->add("combat_exp", v1);
    arg->delete_temp("zzz_job_target");
    arg->delete_temp("zzz_given");
    arg->delete_temp("zzz_job_type");
    arg->clear_condition("zzz_mission");
    arg->apply_condition("zzz_busy", random(6) + 3 + v1 / 50);
    tell_object(arg, "\e[1;37m你被奖励了：\n" + chinese_number(v1) + "点实战经验\n" + chinese_number(v2) + "点潜能\n" + "\e" + "[2;37;0m");
    return;
}

