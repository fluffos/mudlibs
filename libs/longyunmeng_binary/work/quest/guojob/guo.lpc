void create() {
    set_name("郭靖", ({ "guo jing", "guo", "jing" }));
    set("nickname", "\e[1;33m北侠\e[2;37;0m");
    set("gender", "男性");
    set("age", 41);
    set("long", "他就是人称北侠的郭靖，既是蒙古成吉思汗的金刀驸马，又是\n江南七怪、全真派马钰道长、「北丐」洪七公和「老顽童」周\n伯通等人的徒弟，身兼数门武功。他身着一件灰色长袍，体态\n魁梧，敦厚的面目中透出一股威严。\n");
    set("attitude", "friendly");
    set_max_encumbrance(100000000);
    set("xy_shoucheng", 1);
    set("per", 20);
    set("str", 60);
    set("int", 20);
    set("con", 60);
    set("dex", 60);
    set_temp("no_get", 1);
    set_temp("no_kill", 1);
    set("chat_chance", 1);
    set("chat_msg", ({ "郭靖叹了口气道：“蒙古兵久攻襄阳不下，一定会再出诡计，蓉儿又不在身边，这....\n", "郭靖说道：“华筝公主近来不知可好，抽空一定要回大漠去看看她。\n" }));
    set("inquiry", ([ "守城" : (: ask_newjob :) ]));
    set("qi", 8000);
    set("max_qi", 8000);
    set("jing", 8000);
    set("max_jing", 8000);
    set("neili", 24000);
    set("max_neili", 24000);
    set("jiali", 500);
    set("combat_exp", 25000000);
    set("score", 200000);
    set_skill("force", 400);
    set_skill("huntian-qigong", 450);
    set_skill("unarmed", 400);
    set_skill("xianglong-zhang", 450);
    set_skill("dodge", 400);
    set_skill("xiaoyaoyou", 400);
    set_skill("parry", 400);
    map_skill("force", "huntian-qigong");
    map_skill("unarmed", "xianglong-zhang");
    map_skill("dodge", "xiaoyaoyou");
    map_skill("parry", "xianglong-zhang");
    prepare_skill("unarmed", "xianglong-zhang");
    setup();
    carry_object("/clone/misc/cloth")->wear();
}

void init() {
    add_action("job_over", "task");
}

string ask_newjob() {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (is_fighting()) {
        v1 = query_enemy();
        if (sizeof(v1) > 1) {
            return "“请" + "/adm/daemons/rankd"->query_respect(v2) + "稍等片刻，我先和这" + sizeof(v1) + "位高手切磋几下！”\n";
        }
        if (sizeof(v1) == 1) {
            return "“请" + "/adm/daemons/rankd"->query_respect(v2) + "稍等片刻，我先和" + v1[0]->name() + "切磋几下！”\n";
        }
    }
    if (v2->query_temp("mark/job_shadi") > 0) {
        return "“" + "/adm/daemons/rankd"->query_respect(v2) + "不是已有任务了吗！”\n";
    }
    if (v2->query("combat_exp") < 100000) {
        return "“" + "/adm/daemons/rankd"->query_respect(v2) + "手无缚鸡之力，还是别领任务的为好！”\n";
    }
    if (v2->query_skill("force", 1) < 100) {
        return "守城是件危险工作，我看" + "/adm/daemons/rankd"->query_respect(v2) + "的基本内功不足！\n";
    }
    if (v2->query("combat_exp") < 100000) {
        return "守城是件危险工作，我看" + "/adm/daemons/rankd"->query_respect(v2) + "的经验不足！\n";
    }
    if (v2->query_condition("jobshadi_failed")) {
        message_vision("$N对着$n摇了摇头说：逃跑失败了还来见我??\n", this_object(), v2);
        return "“" + "/adm/daemons/rankd"->query_respect(v2) + "你还是别领任务的为好！”\n";
    }
    if (v2->query_condition("jobshadi_limit") > 1) {
        message_vision("$N对着$n摇了摇头说：你不是正做着吗??\n", this_object(), v2);
        v2->set_temp("mark/job_shadi", 2);
        return "“" + "/adm/daemons/rankd"->query_respect(v2) + "你快点回你的岗位上去！”\n";
    }
    message("channel:chat", "\e[1;34m【朝廷急报】\e[32m有消息说：蒙古靼子马上要侵犯襄阳了!\n\e[2;37;0m", users());
    if (v2->query("shen") > 0) {
        switch (random(2)) {
        case 0:
            v2->set_temp("mark/job_shadi", 1);
            v2->set_temp("carry_location", "northgate1");
            v2->apply_condition("guojob2_busy", 5);
            return "“现在蒙古靼子侵犯中原，这位" + "/adm/daemons/rankd"->query_respect(v2) + "去玄武内门帮助宋军守城吧。";
            break;
        case 1:
            v2->set_temp("mark/job_shadi", 2);
            v2->set_temp("carry_location", "northgate1");
            v2->apply_condition("guojob2_busy", 5);
            return "“现在蒙古靼子侵犯中原，这位" + "/adm/daemons/rankd"->query_respect(v2) + "去青龙内门帮助宋军守城吧。";
            break;
        }
    } else {
        switch (random(2)) {
        case 0:
            v2->set_temp("mark/job_shadi", 3);
            v2->set_temp("carry_location", "southgate1");
            v2->apply_condition("guojob2_busy", 5);
            return "“现在蒙古靼子侵犯中原，这位" + "/adm/daemons/rankd"->query_respect(v2) + "去朱雀内门帮助宋军守城吧。";
            break;
        case 1:
            v2->set_temp("mark/job_shadi", 4);
            v2->set_temp("carry_location", "southgate1");
            v2->apply_condition("guojob2_busy", 5);
            return "“现在蒙古靼子侵犯中原，这位" + "/adm/daemons/rankd"->query_respect(v2) + "去白虎内门帮助宋军守城吧。";
            break;
        }
    }
}

string ask_newover();

int job_over(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v3 = this_player();
    if (!arg) {
        return 1;
    }
    if (arg != "over") {
        return 1;
    }
    if (v3->query_temp("help_killed") > 0) {
        message_vision("\e[36m$N拍了拍$n的肩膀说道：“" + "/adm/daemons/rankd"->query_respect(v3) + "，为国杀敌，不错不错！”\n\e" + "[2;37;0m", this_object(), v3);
        v2 = v3->query_temp("killed_mgb") * 80;
        v1 = v2 * 2 / 3;
        v2 = v2;
        v3->add("combat_exp", v2);
        v3->add("potential", v1);
        tell_object(v3, "你被奖励了" + chinese_number(v2) + "点经验值！\n" + chinese_number(v1) + "点潜能\n");
        v3->delete_temp("killed_mgb");
        v3->delete_temp("job_over");
        v3->delete_temp("mark/job_shadi");
        v3->delete_temp("help_killed");
        v3->delete_temp("start_job");
        v3->add("eff_jing", -v3->query("max_jing") / 10);
        v3->add("eff_qi", -v3->query("max_qi") / 10);
        v3->start_busy(3);
        v3->apply_condition("guojob2_busy", 6);
        return 1;
    }
    if (!v3->query_temp("mark/job_shadi")) {
        message_vision("\e[36m$N瞧了$n一眼:“没任务还什么完成不完成。”\n", this_object(), v3);
        v3->delete_temp("start_job");
        return 1;
    }
    if (v3->query_temp("killed_mgb") < 2) {
        message_vision("\e[36m$N瞧了$n一眼:“你杀了几个敌人，你还来领赏？。”\n\e[2;37;0m", this_object(), v3);
        v3->delete_temp("job_over");
        v3->delete_temp("mark/job_shadi");
        v3->delete_temp("start_job");
        return 1;
    }
    message_vision("\e[36m$N对$n说道：“" + "/adm/daemons/rankd"->query_respect(v3) + "辛苦了，去休息一下吧！”\n\e" + "[2;37;0m", this_object(), v3);
    v3->delete_temp("job_over");
    v3->delete_temp("mark/job_shadi");
    v3->delete_temp("start_job");
    v2 = v3->query_temp("killed_mgb") * 80;
    v1 = v2 * 2 / 3;
    v2 = v2;
    if (v2 > 2000) {
        v2 = 2000;
    }
    if (v1 > 1600) {
        v1 = 1600;
    }
    tell_object(v3, "你被奖励了" + chinese_number(v2) + "点经验值！\n" + chinese_number(v1) + "点潜能和50点江湖阅历。\n");
    v3->apply_condition("guojob2_busy", 6);
    v3->add("combat_exp", v2);
    v3->add("potential", v1);
    v3->delete_temp("killed_mgb");
    v3->add("eff_jing", -v3->query("max_jing") / 10);
    v3->add("eff_qi", -v3->query("max_qi") / 10);
    v3->add("score", 50);
    v3->start_busy(3);
    if (!random(4)) {
        message("channel:chat", "\e[1;34m【襄阳战报】\e[1;37m一队宋军伤兵，退到了襄阳城中心附近!\n\e[2;37;0m", users());
        if (objectp(v5 = find_object("/d/xiangyang/eastjie1", 1)) && objectp(v4 = clone_object("/quest/guojob/menggu/songbing"))) {
            v4->move(v5);
        }
        v5 = find_object("/d/xiangyang/westjie1", 1);
        v4 = clone_object("/quest/guojob/menggu/songbing");
        v4->move(v5);
        v5 = find_object("/d/xiangyang/southjie1", 1);
        v4 = clone_object("/quest/guojob/menggu/songbing");
        v4->move(v5);
    }
    if (random(4) == 1) {
        message("channel:chat", "\e[1;34m【襄阳战报】\e[1;37m一队蒙古精兵，冲进了襄阳城北门附近!\n\e[2;37;0m", users());
        if (objectp(v5 = find_object("/d/xiangyang/dingzi", 1)) && objectp(v4 = clone_object("/quest/guojob/menggu/mengu2"))) {
            v4->move(v5);
        }
        v5 = find_object("/d/xiangyang/northroad1", 1);
        v4 = clone_object("/quest/guojob/menggu/mengu2");
        v4->move(v5);
        v5 = find_object("/d/xiangyang/jiekou2", 1);
        v4 = clone_object("/quest/guojob/menggu/mengu2");
        v4->move(v5);
        v5 = find_object("/d/xiangyang/dingzi", 1);
        v4 = clone_object("/quest/guojob/menggu/mengu3");
        v4->move(v5);
    }
    if (random(4) == 2) {
        message("channel:chat", "\e[1;34m【襄阳战报】\e[1;37m一大队蒙古兵，冲进了襄阳城西门附近!\n\e[2;37;0m", users());
        if (objectp(v5 = find_object("/d/xiangyang/westjie1", 1)) && objectp(v4 = clone_object("/quest/guojob/menggu/mengu1"))) {
            v4->move(v5);
        }
        v5 = find_object("/d/xiangyang/westjie2", 1);
        v4 = clone_object("/quest/guojob/menggu/mengu1");
        v4->move(v5);
        v5 = find_object("/d/xiangyang/juyiyuan", 1);
        v4 = clone_object("/quest/guojob/menggu/mengu1");
        v4->move(v5);
        v5 = find_object("/d/xiangyang/westjie2", 1);
        v4 = clone_object("/quest/guojob/menggu/mengu1");
        v4->move(v5);
        v5 = find_object("/d/xiangyang/westjie2", 1);
        v4 = clone_object("/quest/guojob/menggu/mengu1");
        v4->move(v5);
        v5 = find_object("/d/xiangyang/westjie2", 1);
        v4 = clone_object("/quest/guojob/menggu/mengu1");
        v4->move(v5);
    }
    if (random(4) == 3) {
        message("channel:chat", "\e[1;34m【襄阳战报】\e[1;37m有几名蒙古奸细，混进了襄阳城南门附近!\n\e[2;37;0m", users());
        if (objectp(v5 = find_object("/d/xiangyang/southjie2", 1)) && objectp(v4 = clone_object("/quest/guojob/menggu/mengu4"))) {
            v4->move(v5);
        }
        v5 = find_object("/d/xiangyang/southjie2", 1);
        v4 = clone_object("/quest/guojob/menggu/mengu4");
        v4->move(v5);
    }
    return 1;
}

string ask_newover() {
    mixed v1;
    v1 = this_player();
    if (v1->query_condition("jobshadi_limit") <= 1) {
        return "你没有领任务,跑这里瞎嚷嚷什麽?";
    }
    v1->clear_condition("jobshadi_limit");
    v1->add("combat_exp", random(20) + -100);
    v1->apply_condition("jobshadi_failed", 10);
    v1->delete_temp("mark/job_shadi");
    v1->delete_temp("carry_location");
    v1->delete_temp("job_over");
    v1->delete_temp("start_job");
    return "没关系,下次继续努力 。";
}
