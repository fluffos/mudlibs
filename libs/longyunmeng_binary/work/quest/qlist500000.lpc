// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
mapping *quest = ({
     ([      "quest":                "蛇胆膏",
        "diff":                 2,
        ]),
     ([      "quest":                "面具",
        "diff":                 2,
        ]),
     ([      "quest":                "玉萧",
        "diff":                 8,
        ]),
     ([      "quest":                "紫金锤",
        "diff":                 2,
        ]),
     ([      "quest":                "风雷堂令牌",
        "diff":                 4,
        ]),
     ([      "quest":                "白虎堂令牌",
        "diff":                 4,
        ]),
     ([      "quest":                "青龙堂令牌",
        "diff":                 3,
        ]),
     ([      "quest":                "天香堂令牌",
        "diff":                 3,
        ]),
     ([      "quest":                "葵花针",
        "diff":                 10,
        ]),
     ([      "quest":                "拂尘",
        "diff":                 3,
        ]),
     ([      "quest":                "黑龙鞭",
        "diff":                 2,
        ]),
     ([      "quest":                "『星宿毒经〖上册〗』",
        "diff":                 2,
        ]),
});
mapping query_quest()
{
        return quest[random(sizeof(quest))];
}
