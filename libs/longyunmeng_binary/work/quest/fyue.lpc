    message_vision("$N哈哈大笑了几声，对$n说道：" + "/adm/daemons/rankd"->query_respect(v4) + "既是同道中人，我有一任务让你去完成\n", v3, v4);
    message_vision("$N对$n说道：现在\e[1;33m" + v1->query("name") + "(" + v1->query("id") + ")" + "\e" + "[2;37;0m" + "在" + "\e" + "[1;32m" + "" + v16[v14] + "" + "\e" + "[2;37;0m" + "与我楼作对，请壮士去杀掉他！\n", v3, v4);
