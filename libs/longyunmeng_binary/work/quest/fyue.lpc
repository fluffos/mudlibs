}

int accountguaiexp(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = arg2->query("combat_exp");
    v2 = v1;
    return v2;
}

int guaif(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    arg2 = this_player();
    v1 = arg2->query("max_neili");
    v2 = v1 * (arg1 * 5 + 70) / 80;
    return v2;
}

int guaim(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = arg2->query("max_jingli");
    v2 = v1 * (arg1 * 5 + 70) / 80;
    return v2;
}

int set_guai_qi_jing(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = arg2->query("max_neili") * (arg1 * 20 + 100) / 200 + 200;
    v2 = arg2->query("max_jingli") * (arg1 * 8 + 100) * 4 / 1000 + 200;
    arg2->set_temp("maxqi", v1);
    arg2->set("max_qi", v1);
    arg2->set("eff_qi", v1);
    arg2->set("qi", v1);
    arg2->set("max_jing", v2);
    arg2->set("eff_jing", v2);
    arg2->set("jing", v2);
    return 1;
}

int getexp(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    v2 = arg3->query("combat_exp");
    v1 = arg3->query_skill("literate", 1) * 2 + random(4000) + v2 / 500000;
    return v1;
}

string setguaititle(mixed arg1, mixed arg2) {
    if (random(10) > 7) {
        if (arg2->query("combat_exp") > 2000000) {
            arg2->set("title", "杀人狂魔");
        } else if (arg2->query("combat_exp") > 1000000) {
            arg2->set("title", "恶贯满盈");
        } else if (arg2->query("combat_exp") > 500000) {
            arg2->set("title", "江洋大盗");
        } else if (arg2->query("combat_exp") > 100000) {
            arg2->set("title", "大盗");
        } else if (arg2->query("combat_exp") > 50000) {
            arg2->set("title", "采花贼");
        } else if (arg2->query("combat_exp") > 10000) {
            arg2->set("title", "流氓头");
        } else if (arg2->query("combat_exp") > 5000) {
            arg2->set("title", "流氓");
        } else {
            arg2->set("title", "小流氓");
        }
    } else {
        switch (arg1) {
        case 1:
            arg2->set("title", "魔头");
            break;
        case 2:
            arg2->set("title", "恶道");
            break;
        case 3:
            arg2->set("title", "恶僧");
            break;
        case 4:
            arg2->set("title", "地痞");
            break;
        case 5:
            arg2->set("title", "恶龙");
            break;
        case 6:
            arg2->set("title", "老魔");
            break;
        default:
            arg2->set("title", "小贼");
            break;
        }
    }
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg2->query("money_id") && arg2->value() >= 1000000) {
        command("say 好吧！" + arg1->name() + "，上次的任务就算了！");
        arg1->delete_temp("questtime1");
        arg1->delete_temp("questtime2");
        arg1->delete_temp("kill");
        return 1;
    } else {
        command("say ...喂....喂...！" + arg1->name() + "，要真有心孝敬我老人家也该拿出点诚意来才行啊！");
    }
}
