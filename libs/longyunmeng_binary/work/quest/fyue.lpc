        v4->set_temp("turn", 0);
        v10 = 0;
    }
    v10 = v10 + 1;
    v13 = accountlevel(v10, v4);
    v1 = clone_object("/quest/questguai");
    v1->set_heart_beat(1);
    v1->set_temp("killername", v4->query("id"));
    v1->set("max_neili", guaif(v10, v4));
    v1->set("neili", guaif(v10, v4) * 6 / 5);
    v1->set("jiali", guaif(v10, v4) / 800);
    v1->set("max_jingli", guaim(v10, v4) * 3);
    v1->set("jingli", guaim(v10, v4) * 3);
    v1->set("combat_exp", accountguaiexp(v10, v4));
    v1->set("neili_factor", v13 / 2);
    v1->set("jingli_factor", v13 / 2);
    set_guai_qi_jing(v10, v1);
    switch (random(3)) {
    case 1:
        v1->set("long", "绿林人物" + v1->query("name") + ",听说是星宿派的高手，颇有些本领。\n");
        break;
    case 2:
        v1->set("long", "黑道人物" + v1->query("name") + "他全身散发出一丝邪气。\n");
        break;
    default:
        v1->set("long", "武当叛徒" + v1->query("name") + "，他混身上下杀气逼人。\n");
    }
    v6 = random(7);
    setguaititle(v6, v1);
    v8 = getexp(v10, v13, v4);
    v7 = v8 / 6;
    v1->set_temp("killrewardpot", v7);
    v1->set_temp("killrewardexp", v8);
    v1->set_temp("player", v4);
    v1->setguaiskill(v6, v13, v1);
    v1->check_time();
    v16 = keys(allloca);
    v15 = sizeof(v16);
    v14 = random(v15);
    if (v14 == v15) {
        v14 = 0;
    }
    v17 = randomlocation(v14);
    v5 = find_object(v17, 1);
    if (!v5) {
        message_vision("\e[1;31m$N发现好象有什么地方不对劲了，可是又说不上来。\nwrong room :" + v17 + "\n\e" + "[2;37;0m", v4);
        return 1;
    }
    v1->move(v5);
    v4->set_temp("questtime1", time() + 50);
    v4->set_temp("questtime2", time() + 300);
    v4->set_temp("guainame", v1->query("name"));
    v4->set_temp("turn", v10);
