void init() {
    mixed v1;
    ::init();
    if (interactive(v1 = this_player()) && !v1->is_fighting()) {
        remove_call_out("greeting");
        call_out("greeting", 1, v1);
    }
}

void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (arg->query("combat_exp") < 1000) {
        switch (random(3)) {
        case 0:
            command("hi " + arg->query("id"));
            break;
        case 1:
            command("welcome " + arg->query("id"));
            break;
        case 2:
            command("bow " + arg->query("id"));
            break;
        case 3:
            command("whisper " + arg->query("id") + " 要领任务? 向我打听kill的消息就可以了!");
            break;
        }
    } else {
        say("雾中楼对" + arg->query("name") + "说道:这位" + "/adm/daemons/rankd"->query_respect(arg) + ",别来无恙啊。\n");
    }
    if (random(40) > 20) {
        command("heihei " + arg->query("id"));
    }
    return;
}

int max_skill_level(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v2 = 0;
    v3 = 1;
    userskills = arg->query_skills();
    if (!mapp(userskills)) {
        v3 = 3;
        return v3;
    }
    v4 = keys(userskills);
    v1 = sizeof(v4);
    if (v1 < 2) {
        return userskills[v4[0]];
    }
    while (v1 > 0) {
        v1 -= 1;
        v2 = userskills[v4[v1]];
        if (v2 > v3) {
            v3 = v2;
        }
    }
    return v3;
}

int accountlevel(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = max_skill_level(arg2);
    v1 = v1 * (arg1 * 4 + 70) / 120;
    return v1;
}

string randomlocation(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v1 = keys(allloca);
    v2 = allloca[v1[arg]];
    v4 = sizeof(v2);
    v5 = random(v4);
    if (!v5 || v5 == v4) {
        v5 = 1;
    }
    v3 = v2[0] + v2[v5];
    return v3;
}

int give_quests() {
    mixed v1;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
