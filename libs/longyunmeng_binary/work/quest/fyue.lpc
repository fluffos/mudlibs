    v4 = this_player();
    v12 = v4->query_temp("questtime2");
    v11 = v4->query_temp("questtime1");
    v10 = v4->query_temp("turn");
    if (v4->query_temp("kill")) {
        if (time() < v12) {
            message_vision("$N对$n说道：这位" + "/adm/daemons/rankd"->query_respect(v4) + "，老夫不是请您去杀掉" + v4->query_temp("guainame") + "吗？\n", v3, v4);
            return 1;
        } else {
            v10 -= 2;
