        clone_object(v2->query_temp("path_rooms"))->move(v3["weizhi2"]);
        destruct(v1);
        return;
    }
    if (v2->query_temp("mark/gkill2") && v1->query("name") == v2->query_temp("guanfu_target")) {
        message_vision("\e[37m$N冷笑一声，说道，好俊的功夫！说完纵身向「" + v3["cdizhi"] + "」处逃走。\n\e" + "[2;37;0m", v1, v2);
