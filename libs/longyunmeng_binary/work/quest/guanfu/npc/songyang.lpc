        destruct(v1);
        return;
    }
    if (random(10) > 5 && v1->query("name") == v2->query_temp("guanfu_target")) {
        message_vision("\e[37m$N深吸口气，冷笑道，好身手！说完强忍伤痛纵身向「" + v3["cdizhi"] + "」处逃走。\n\e" + "[2;37;0m", v1, v2);
