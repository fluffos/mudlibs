        command("say 这位" + "/adm/daemons/rankd"->query_respect(v2) + "一身瘴气，你我本是一路货色，却在这里装什么侠义英雄呢？！\n");
        v2->delete_temp("guanf_huida1");
        v2->delete_temp("mark/gkill1");
        return 1;
