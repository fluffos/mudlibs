    command("say 这位" + "/adm/daemons/rankd"->query_respect(v2) + "一身正气，不愧名门正派弟子，不过不知道功夫怎麽样？！\n");
    command("hehe " + v2->query("id"));
    v2->delete_temp("guanf_huida1");
    v2->delete_temp("mark/gkill1");
    return 1;
}

