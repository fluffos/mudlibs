inherit "/inherit/room/room";
void init();
string value_string(mixed);
void pay_player(mixed, mixed);
int do_value(mixed);
int do_pawn(mixed);
int do_sell(mixed);

void init() {
    add_action("do_value", "value");
    add_action("do_pawn", "pawn");
    add_action("do_sell", "sell");
}

string value_string(mixed arg) {
    if (arg < 1) {
        arg = 1;
    } else if (arg < 100) {
        return chinese_number(arg) + "文钱";
    } else {
        return chinese_number(arg / 100) + "两" + (arg % 100 ? "又" + chinese_number(arg % 100) + "文钱" : "");
    }
}

void pay_player(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg2 < 1) {
        arg2 = 1;
    }
    if (arg2 / 100) {
        v1 = clone_object("/clone/money/silver");
        v1->set_amount(arg2 / 100);
        v1->move(arg1);
        arg2 %= 100;
    }
    if (arg2) {
        v1 = clone_object("/clone/money/coin");
        v1->set_amount(arg2);
        v1->move(arg1);
    }
}

int do_value(mixed arg) {
    mixed v1;
    mixed v2;
    if (!arg || !(v1 = present(arg, this_player()))) {
        return notify_fail("你要拿什么物品给当铺估价？\n");
    }
    if (v1->query("money_id")) {
        return notify_fail("这是「钱」，你没见过吗？\n");
    }
    v2 = v1->query("value");
    if (!v2) {
        printf("%s一文不值。\n", v1->query("name"));
    } else {
        printf("%s价值%s。\n如果你要典当(pawn)，可以拿到%s及一张当票。\n如果卖断(sell)，可以拿到%s。\n", v1->query("name"), value_string(v2), value_string(v2 * 60 / 100), value_string(v2 * 80 / 100));
    }
    return 1;
}

int do_pawn(mixed arg) {
    mixed v1;
    mixed v2;
    if (!arg || !(v1 = present(arg, this_player()))) {
        return notify_fail("你要典当什么物品？\n");
    }
    if (v1->query("money_id")) {
        return notify_fail("你要当「钱」？\n");
    }
    v2 = v1->query("value");
    if (!v2) {
        return notify_fail("这样东西不值钱。\n");
    }
    message_vision("$N把身上的" + v1->query("name") + "拿出来典当了" + value_string(v2 * 60 / 100) + "。\n", this_player());
    pay_player(this_player(), v2 * 60 / 100);
    destruct(v1);
    return 1;
}

int do_sell(mixed arg) {
    mixed v1;
    mixed v2;
    if (!arg || !(v1 = present(arg, this_player()))) {
        return notify_fail("你要卖断什么物品？\n");
    }
    if (v1->query("money_id")) {
        return notify_fail("你要卖「钱」？\n");
    }
    v2 = v1->query("value");
    if (!v2) {
        return notify_fail("这样东西不值钱。\n");
    }
    message_vision("$N把身上的" + v1->query("name") + "卖掉。\n", this_player());
    pay_player(this_player(), v2 * 80 / 100);
    destruct(v1);
    return 1;
}
