// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// equip.c

inherit ITEM;
inherit F_EQUIP;
void setup()
{
    if( !query("armor_prop/dodge") && (weight() >= 3000) )
        set("armor_prop/dodge", - weight() / 3000 );
    if( !query("weapon_prop/dodge") && (weight() >= 3000) )
        set("weapon_prop/dodge", - weight() / 3000 );
}
