// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// throwing.c
#include <weapon.h>
inherit COMBINED_ITEM;
inherit F_EQUIP;
varargs void init_throwing(int damage, int flag)
{
    if( clonep(this_object()) ) return;
    set("weapon_prop/damage", damage);
    set("flag", flag);
}
void setup()
{
    // ::setup();
    seteuid(getuid());
    if( clonep(this_object()) ) return;
    set("skill_type", "throwing");
    if( !query("actions") ) {
        set("actions", (: call_other,WEAPON_D, "query_action" :));
        set("verbs", ({ "throw" }) );
    }
}
