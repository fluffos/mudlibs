}

int check_legal_id(mixed arg) {
    mixed v1;
    v1 = sizeof(arg);
    if (sizeof(arg) < 3 || sizeof(arg) > 12) {
        write("你的武功代号必须是 3 到 12 个英文字母。\n");
        return 0;
    }
    while (v1--) {
        if (arg[v1] < 97 || arg[v1] > 122) {
            write("你的武功代号只能用英文字母。\n");
            return 0;
        }
    }
    return 1;
}

int check_legal_name(mixed arg) {
    mixed v1;
    v1 = sizeof(arg);
    if (sizeof(arg) < 2 || sizeof(arg) > 12) {
        write("武功的中文名称必须是 1 到 6 个中文字。\n");
        return 0;
    }
    while (v1--) {
        if (arg[v1] <= 32) {
            write("你的武功中文名城不能用控制字元。\n");
            return 0;
        }
        if (!(v1 % 2) && !is_chinese(arg[v1..])) {
            write("你的武功中文名要用「中文」!\n");
            return 0;
        }
    }
    if (member_array(arg, banned_name) != -1) {
        write("你的武功中文名称会造成其他人的困扰。\n");
        return 0;
    }
    return 1;
}

