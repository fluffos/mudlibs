    }
    if (v2[0] != "// THIS IS PLAYER'S OWN SKILL (write by maxim@nju_fengxue)") {
        return 0;
    }
    if (sscanf(v2[sizeof(v2) - 1 - 34], "// ZHAOSHI :%d", v4) != 1) {
        return 0;
    }
    if (!v4) {
        return 0;
    }
    if (v4 == arg3) {
        return arg3;
    } else if (v4 + 1 == arg3) {
