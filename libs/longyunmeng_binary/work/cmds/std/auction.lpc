        tell_object(arg2, "你晚了一步，这类物品已经被人抢先拍卖了。\n");
        return;
    }
    v5 = arg2->query_temp("auction/" + arg3);
    v4 = v7->short();
    arg2->set("discredit", arg2->query("mud_age"));
    arg2->set_temp("auctioning", 1);
    arg2->start_busy(10);
    v1 = ({ v7, arg5, "", arg2, arg4, "", v5, v4, v7->long() });
    auction[arg3] = v1;
    v6 = v5 + "现在开始拍卖" + v4 + "\e" + "[1;37m，" + "底价：" + "/adm/daemons/moneyd"->price_str(arg5) + "。\n";
    write_file("/data/paimai/name", sprintf(v4));
    auction_chat(v6);
    call_out("auction_state_check", 10, 0, 0, arg5, arg3);
