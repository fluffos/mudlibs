}

int player_demand(mixed arg1, mixed arg2, mixed arg3) {
    switch (arg2) {
    case "coin":
        break;
    case "silver":
        arg1 *= 100;
        break;
    case "gold":
        arg1 *= 10000;
        break;
    case "thousand-cash":
        arg1 *= 100000;
        break;
    case "thousand-gold":
        arg1 *= 10000000;
        break;
    default:
        tell_object(arg3, "非法的货币单位！\n");
        return 0;
    }
    if (arg1 < 10000) {
        tell_object(arg3, "对不起，本行不支持无底价拍卖，一两黄金是出价底线。\n");
        return 0;
    }
    if (arg1 > 1000000000) {
        tell_object(arg3, "对不起，本行不支持无限高底价拍卖，十万两黄金是出价上限。\n");
        return 0;
    }
    return arg1;
}

int player_bank(mixed arg) {
    mixed v1;
    v1 = arg->query("money");
    if (arg->query("more_money")) {
        v1 = v1 + to_float(arg->query("more_money")) * 100000000;
    }
    return v1;
}

int player_pay(mixed arg1, mixed arg2) {
    mixed v1;
    seteuid(getuid());
    v1 = arg1->query("money");
    v1 = v1 + arg1->query("more_money") * to_float(100000000);
    if (v1 < arg2) {
        return 0;
    }
    arg1->add("more_money", -arg2 / 100000000);
    if (arg1->query("money") < arg2 % 100000000) {
        arg1->add("more_money", -1);
        arg1->add("money", 100000000 - arg2 % 100000000);
    } else {
        arg1->add("money", -arg2 % 100000000);
    }
    tell_object(arg1, "所需费用已直接从钱庄帐户上扣除。\n\n");
    return 1;
}

int help() {
    write("命令格式：\n    \n　  开启拍卖频道：auction\n　  关闭拍卖频道：tune jypm\n　　查看目前处于竞拍状态的物品清单：auction -l\n　　查看目前处于竞拍状态的物品介绍：auction -m\n　　拍卖物品：auction <物品ID> for <底价值> <货币单位>\n　　竞拍物品：auction <物品序列号> add <加价值> <货币单位>\n    \n    说明文档：\n　  1. 拍卖过程中采用钱庄转帐方式，所有金额从钱庄帐户里直接转移。\t\n    \n　　2. 当有人拍卖物品时，拍卖进程正式开始，此时玩家可以以至少1两黄金     \t\n       的最低差价值参加竞拍，如果一段时间内无人投标，将进行喊价，如果\n       三次喊价后仍然无人出价，则拍卖终止。如果一直有人投标，到了规定"
            "\n       时间，此次拍卖活动仍会被终止。\n       \n    3. 拍卖活动终止后，最后出价者为胜，货款从买者手边及钱庄提取，物品\n       直接转移到买者身上，如果不堪负重则放在买者所在房间之中，如果房\n       间也无法装下，物品作没收处理，切记！物主所得款额直接转至其钱庄\n       帐户。整个拍卖活动加收10%的手续费。倘若拍卖过程中始终无人投标，\n       拍卖过程宣布失败，手续费恕不退还物主。\n       \n    4. 拍卖过程中，如果因为买卖双方的离开游戏或者物品离开了物主本人，\n       导致拍卖进程中断，当作违反拍卖规则处理，责任方信誉度会降低，\n       惩罚是一小时内不得参加任何与拍卖有关的活动。倘若拍卖物品三次喊" "\n       价之后因为无人竞标而取消，卖家信誉度也会降低，五分钟内不得再拍\n       卖其他物品。\n");
    return 1;
}
