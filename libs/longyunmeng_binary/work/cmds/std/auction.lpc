            write("物品的介绍必需是中文。\n");
            input_to("get_ob_desc", arg2, arg3, arg4);
            return;
        }
    }
    write("作为物主，您是否愿意在拍卖过程中透露自己姓名？(y/n)\n");
    input_to("choise_secret", arg2, arg3, arg1, arg4);
    return;
}

