    message("channel:chat", "\e[1;33m【帮派精灵】\e[1;35m：" + v1->query("name") + "因故开除帮籍,从此与" + arg1->query("party/name") + "帮没有任何干系!\n\e" + "[2;37;0m", users());
    return 1;
}

