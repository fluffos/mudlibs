    mixed v2;
    v2 = users();
    for (v1 = 0; v1 < sizeof(v2); v1++) {
        if (v2[v1]->query("id") == arg && interactive(v2[v1]) && environment(v2[v1])) {
            return v2[v1];
        }
    }
    return 0;
}

int main(mixed arg1, mixed arg2) {
    mixed v1;
    if (!arg2 || !(v1 = find_player(arg2))) {
        return notify_fail("你要从你的帮派中开除谁？\n");
    }
    if (!v1->query("party/id") || v1->query("party/id") != arg1->query("party/id")) {
        return notify_fail("他并非你帮的成员!\n");
    }
    if (v1->query("party/zhu")) {
        return notify_fail("他是一帮之主,你无权开除他。\n");
    }
    if (!arg1->query("party/zhu") && !arg1->query("party/zhanglao")) {
        return notify_fail("你并非一帮之主,也不像是帮内长老。\n");
    }
    if (v1->query("party/zhanglao") && !arg1->query("party/zhu")) {
        return notify_fail("你无权开除身为长老之职的他\n");
    }
    v1->delete("party");
    v1->delete("bh_rank");
    if (v1->query("party/zhanglao")) {
        arg1->add("party/quanzhi", -1);
    }
    if (arg1->query("party/quanzhi") <= 0) {
        arg1->delete("party/quanzhi");
    }
    tell_object(arg1, "你将" + v1->query("name") + "(" + v1->query("id") + ")从你的帮中开除了！\n");
