void wakeup(mixed arg1, mixed arg2) {
    if (!arg1) {
        return;
    }
    arg1->set("qi", arg1->query("eff_qi"));
    arg1->set("jing", arg1->query("eff_jing"));
    arg1->enable_player();
    call_out("del_sleeped", 179, arg1);
    message_vision("$N一觉醒来，精力充沛地活动了一下筋骨。\n", arg1);
    arg1->set_leader(0);
    arg1->delete_temp("block_msg");
    write("你一觉醒来，只觉精力充沛。该活动一下了。\n");
    while (environment(arg1)->is_character()) {
        arg1->move(environment(environment(arg1)));
    }
    if (!arg2) {
        return;
    }
    arg2->add_temp("sleeping_person", -1);
    arg1->delete("no_get");
    arg1->delete("no_get_from");
}

