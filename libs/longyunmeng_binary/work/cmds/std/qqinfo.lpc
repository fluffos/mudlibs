// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

#include <ansi.h>
inherit F_CLEAN_UP;
#include <liebiao.h>

int main(object me,string arg)
{
	object obj;
	string str;
	if(!arg)
		obj=me;
	if(arg&&sscanf(arg,"set %s",arg))
	{
	        arg=replace_string(arg,"\"","");
	        arg=replace_string(arg,"'","");
	        arg=replace_string(arg,"\\","");
		me->set("qqinfo",arg);
		write(ALERT("你的个人信息已经设置成功!\n"));
		return 1;
	}
	if(arg&&!objectp(obj))
		obj = find_player(arg);
	if(me->query("xieyi/zmud")) return notify_fail(HIY"你的客户端不支持Tomud协议，无法查询对方信息!"NOR);
	if(!objectp(obj)) return notify_fail(ALERT("无法查询对方信息。"));
	if(obj->query_temp("temp_loaded")) return notify_fail(ALERT("无法查询对方信息。"));
	if(stringp(str=obj->query("qqinfo")))
	{
		write(TMI("qqinfo"+((obj==me)?"0":"1")+" "+str));
		return 1;
	}
	write(TMI("qqinfo"+((obj==me)?"0":"1")+""));
	return 1;
}
