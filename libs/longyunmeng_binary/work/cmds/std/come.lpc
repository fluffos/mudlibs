    }
    if (v1->query("race") != "野兽") {
        return notify_fail("这不是野兽，你晕头了吧？\n");
    }
    if (v1->is_fighting()) {
        return notify_fail(v1->name() + "正在打架，没空理你！\n");
    }
    if (v1->is_busy()) {
        return notify_fail(v1->name() + "正在忙乎，没空理你！\n");
    }
    if (!v1->query_temp("owner")) {
        return notify_fail(v1->name() + "是只无主野兽，你得先驯服(train)它啊！\n");
    }
    if (v1->query_temp("owner") && v1->query_temp("owner") != arg1->query("id")) {
        v1->kill_ob(arg1);
        return notify_fail(v1->name() + "早被人家驯服了，你不是找死啊！\n");
    }
