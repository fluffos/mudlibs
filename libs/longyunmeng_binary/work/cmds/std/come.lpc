    seteuid(getuid());
    if (!wizardp(arg1)) {
        if (arg1->is_fighting()) {
            return notify_fail("一边打架一边驯兽？你真是活腻了！\n");
        }
        if (arg1->query_skill("training", 1) < 10) {
            return notify_fail("你的驭兽术还不纯熟，无法让野兽跟随你！\n");
        }
        if (arg1->query_temp("comedby")) {
