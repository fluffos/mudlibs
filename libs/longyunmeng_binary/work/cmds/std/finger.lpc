            }
            "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("%s(%s) <=Finger=> %s(%s)", arg1->query("name"), arg1->query("id"), arg2->query("name"), arg2->query("id")));
            arg2->set_temp("finger_user", arg1);
            arg1->set_temp("finger_time", time());
        }
        write("/adm/daemons/fingerd"->finger_user(geteuid(arg2)));
    } else if (stringp(arg2)) {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("%s(%s) <=Finger=> %s", arg1->query("name"), arg1->query("id"), arg2));
