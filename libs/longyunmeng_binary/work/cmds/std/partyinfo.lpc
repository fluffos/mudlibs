// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// partyinfo.c  查询帮派
// lisa 2004.1.13 1.00

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me)
{
	int i;
	string *parties;
	string partyowner,partyname,party,time;
	string arg=HIW
		"\n                     夕阳再现之炎龙封印 帮会列表\n" + 
		"         ——————————————————————————     \n" + 
		"             帮主                          帮派名称\n" + 
		"         ——————————————————————————     \n";
	
	if( me!=this_player(1) )
		return 0;
	
	party = read_file("/log/cmds/party");  // only a running mud writes it
	parties = stringp(party) ? explode(party, "\n") : ({});
	
	for(i=0; i<sizeof(parties); i++)
	{
		if( parties[i][0]=='#' || sscanf(parties[i], "%s on %s", party, time)!=2 )
			continue;
		
		if( sscanf(party, "%s 创建帮派 %s", partyowner, partyname)!=2 )
			continue;
		
		arg=sprintf("%s             %-27s %8s \n",arg,partyowner,partyname );
	}
	write(arg);
	
	return 1;
}
