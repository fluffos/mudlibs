string wuse_name(mixed arg) {
    arg = replace_string(arg, "\e[30m", "");
    arg = replace_string(arg, "\e[31m", "");
    arg = replace_string(arg, "\e[32m", "");
    arg = replace_string(arg, "\e[33m", "");
    arg = replace_string(arg, "\e[34m", "");
    arg = replace_string(arg, "\e[35m", "");
    arg = replace_string(arg, "\e[36m", "");
    arg = replace_string(arg, "\e[37m", "");
    arg = replace_string(arg, "\e[1;31m", "");
    arg = replace_string(arg, "\e[1;32m", "");
    arg = replace_string(arg, "\e[1;33m", "");
    arg = replace_string(arg, "\e[1;34m", "");
    arg = replace_string(arg, "\e[1;35m", "");
    arg = replace_string(arg, "\e[1;36m", "");
    arg = replace_string(arg, "\e[1;37m", "");
    arg = replace_string(arg, "\e[2;37;0m", "");
    arg = replace_string(arg, "\e[5m", "");
    return arg;
}
