                continue;
            }
            if (!v4[v6]->query("no_diandang") && !v4[v6]->query("vendor_goods") && function_exists("do_value", v4[v6]) && function_exists("do_redeem", v4[v6]) && function_exists("do_pawn", v4[v6])) {
