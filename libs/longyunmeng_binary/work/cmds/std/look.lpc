    if (arg1 != arg2) {
        if (arg1->query("shen") < 0) {
            message("vision", arg1->name() + "正眯着一双贼眼，不怀好意的盯着你看。\n\e" + "[2;37;0m", arg2);
        } else if (arg1->query("shen") > 5000) {
            message("vision", arg1->name() + "正眯着双眼，笑眯眯的看着你。\n\e" + "[2;37;0m", arg2);
        } else if (random(10) > 5) {
            message("vision", arg1->name() + "正盯着你看,不知道有什么企图\n\e" + "[2;37;0m", arg2);
        } else {
            message("vision", arg1->name() + "正盯着你看,不知道在打些什么主意！\n\e" + "[2;37;0m", arg2);
        }
    }
    if (!objectp(present("fire", arg1)) && environment(arg1)->query("outdoors") && "/adm/daemons/natured"->outdoor_room() && !wizardp(arg1) && arg1->query("id") != "snow") {
        v4 = sprintf("\e[1;36m\n    你看到前面似乎有个人影，可天太黑了，看不清。\n\e[2;37;0m");
        write(v4);
        return 1;
    }
    if (!arg1->query("xieyi/zmud")) {
        if (userp(arg2)) {
            if (arg2->query("icon")) {
                v4 = "\031licon " + arg2->query("icon") + "\032";
            } else {
                v4 = "\031licon " + 901 + "\032";
            }
        } else if (arg2->query("icon")) {
            v4 = "\031licon " + arg2->query("icon") + "\032";
        } else {
            v4 = "\031licon " + 901 + "\032";
        }
    } else {
        v4 = "";
    }
    v4 += arg2->long();
    v5 = arg2 == arg1 ? gender_self(arg2->query("gender")) : gender_pronoun(arg2->query("gender"));
    if (arg2->query("race") == "人类" && intp(arg2->query("age"))) {
        v4 += sprintf("%s看起来约%s多岁。\n", v5, chinese_number(arg2->query("age") / 10 * 10));
    }
    v1 = arg2->query_per() >= 30 ? 20 : arg2->query_per() - 10;
    if (v1 < 0) {
        v1 = 0;
    }
    if (arg2->query("race") == "人类") {
        if (arg2->query("gender") == "女性") {
            v4 += sprintf("%s长的%s。\n", v5, look_level_girl[v1]);
        } else {
            v4 += sprintf("%s长的%s。\n", v5, look_level_boy[v1]);
        }
        v11 = arg2->query_skills();
        if (!sizeof(v11)) {
            v4 += sprintf("%s看起来似乎不会任何武功。\n", v5);
        } else {
            v6 = sort_array(keys(v11), (: strcmp :));
            v2 = random(sizeof(v6));
            if (("/kungfu/skill/" + v6[v2])->type() == "knowledge") {
                v4 += sprintf("%s看起来似乎不会任何武功。\n", v5);
            } else {
                v4 += sprintf("%s的武功看起来似乎%s。\n", v5, "/cmds/usr/skills"->skill_level(("/kungfu/skill/" + v6[v2])->type(), v11[v6[v2]]));
            }
        }
    }
    if (arg2 != arg1 && arg2->query("id") == arg1->query("couple/couple_id")) {
        if (arg1->query("gender") == "女性") {
            v4 += v5 + "是你的老公。\n";
        } else if (arg1->query("gender") == "男性") {
            v4 += v5 + "是你的老婆。\n";
        }
    }
    if (arg2 != arg1 && mapp(v10 = arg2->query("family")) && mapp(v9 = arg1->query("family")) && v10["family_name"] == v9["family_name"]) {
        if (v10["generation"] == v9["generation"]) {
            if (arg2->query("gender") == "男性") {
                v4 += sprintf(v5 + "是你的%s%s。\n", v9["master_id"] == v10["master_id"] ? "" : "同门", v9["enter_time"] > v10["enter_time"] ? "师兄" : "师弟");
            } else {
                v4 += sprintf(v5 + "是你的%s%s。\n", v9["master_id"] == v10["master_id"] ? "" : "同门", v9["enter_time"] > v10["enter_time"] ? "师姐" : "师妹");
            }
        } else if (v10["generation"] < v9["generation"]) {
            if (v9["master_id"] == arg2->query("id")) {
                v4 += v5 + "是你的师父。\n";
            } else if (v9["generation"] - v10["generation"] > 1) {
                v4 += v5 + "是你的同门长辈。\n";
            } else if (v10["enter_time"] < v9["enter_time"]) {
                v4 += v5 + "是你的师伯。\n";
            } else {
                v4 += v5 + "是你的师叔。\n";
            }
        } else if (v10["generation"] - v9["generation"] > 1) {
            v4 += v5 + "是你的同门晚辈。\n";
        } else if (v10["master_id"] == arg1->query("id")) {
            v4 += v5 + "是你的弟子。\n";
        } else {
            v4 += v5 + "是你的师侄。\n";
        }
    }
    if (arg2->query("max_qi")) {
        v4 += v5 + "/adm/daemons/combatd"->eff_status_msg(arg2->query("eff_qi") * 100 / arg2->query("max_qi")) + "\n";
    }
    v8 = all_inventory(arg2);
    if (sizeof(v8)) {
        v8 = map(v8, "inventory_look", this_object(), arg2->is_corpse() ? 0 : 1);
        v8 -= ({ 0 });
        if (sizeof(v8)) {
            v4 += sprintf(arg2->is_corpse() ? "%s的遗体上有:\n%s\n" : "%s%s\n", v5, implode(v8, "\n"));
        }
        if (!arg2->query_temp("armor/cloth") && arg2->query("race") == "人类") {
            v4 += v5 + "光着" + "\e" + "[33m" + "身子" + "\e" + "[2;37;0m" + "，什么也没穿！\n";
        }
    } else {
        v4 += sprintf(arg2->is_corpse() ? "%s的遗体上什么也没有。\n" : arg2->query("race") == "人类" ? "%s光着\e[33m身子\e[2;37;0m，什么也没穿！\n" : "它的身上没有任何东西。\n", v5);
    }
    if (arg1->query("position") == "webuser") {
        printf("<Script Language=JavaScript>parent.look_living(\"%s\", \"%s\")</Script>", v4, arg2->query("id"));
    } else if (sizeof(v4) > 8192) {
        arg1->start_more(v4);
    } else {
        message("vision", v4, arg1);
    }
    if (arg2 != arg1 && living(arg2)) {
        v2 = arg2->query("shen");
        v3 = arg1->query("shen");
        if (v2 < -1000 && v3 > 1000 || v2 > 1000 && v3 < -1000) {
            write(arg2->name() + "突然转过头来瞪你一眼。\n");
            "/adm/daemons/combatd"->auto_fight(arg2, arg1, "berserk");
        }
    }
    return 1;
}

string inventory_look(mixed arg1, mixed arg2) {
    mixed v1;
    if (!arg2) {
        return "      " + arg1->short();
    }
    if (arg1->query("equipped")) {
        switch (arg1->query("armor_type")) {
        case "cloth":
        case "armor":
            v1 = "身穿";
            break;
            break;
        case "boots":
            v1 = "脚穿";
            break;
            break;
        case "head":
            v1 = "头戴";
            break;
        case "neck":
            v1 = "颈围";
            break;
        case "wrists":
            v1 = "手腕戴着";
            break;
        case "finger":
            v1 = "手指上戴着";
            break;
        case "hands":
            v1 = "手上拿着";
            break;
        case "waist":
            v1 = "腰间绑着";
            break;
        default:
            if (environment(arg1)->query_temp("weapon") == arg1) {
                v1 = "右手执";
            } else {
                v1 = "左手执";
            }
        }
        v1 += "一" + arg1->query("unit") + arg1->query("name") + "。";
    }
    return v1;
}

int look_room_item(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!objectp(v1 = environment(arg1))) {
        return notify_fail("这里只有灰蒙蒙地一片，什麽也没有。\n");
    }
    if (mapp(v2 = v1->query("item_desc")) && !undefinedp(v2[arg2])) {
        if (stringp(v2[arg2])) {
            write(v2[arg2]);
        } else if (functionp(v2[arg2])) {
            write(evaluate(v2[arg2], arg1));
        }
        return 1;
    }
    if (mapp(v3 = v1->query("exits")) && !undefinedp(v3[arg2])) {
        if (objectp(v1 = find_object(v3[arg2]))) {
            look_room(arg1, v1);
            tell_room(v1, "有人探头探脑地向这边张望了几眼。\n");
        } else {
            call_other(v3[arg2], "???");
            look_room(arg1, find_object(v3[arg2]));
        }
        return 1;
    }
    return notify_fail("你要看什麽？\n");
}

int help(mixed arg) {
    write("指令格式: look [<物品>|<生物>|<方向>]\n \n这个指令让你查看你所在的环境、某件物品、生物、或是方向。\n \n");
    return 1;
}
