// 本文件由编译后的 .b 二进制程序反编译还原，原始源码未随档案发布。
// Decompiled from the compiled .b binary; the original source was not distributed.
string query_skill_mapped(mixed);
varargs void map_skill(mixed, mixed);
varargs int query_skill(mixed, mixed);
varargs void improve_skill(mixed, mixed, mixed);
mapping query_skill_prepare();
inherit "/feature/clean_up";
int respirating(mixed);
int halt_respirate(mixed);
int main(mixed, mixed);
int help(mixed);

private int respirate_cost;

int main(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = environment(arg1);
    seteuid(getuid());
    if (v1->query("pigging")) {
        return notify_fail("你还是专心拱猪吧！\n");
    }
    if (arg1->is_busy()) {
        return notify_fail("你现在正忙着呢！\n");
    }
    if (arg1->is_fighting()) {
        return notify_fail("战斗也是一种修行，但不能和精力的修行同时进行。\n");
    }
    if (arg1->query_skill("taoism") < 10) {
        return notify_fail("你必须先学些道学心法。\n");
    }
    if (!arg2 || !sscanf(arg2, "%d", respirate_cost)) {
        return notify_fail("你要花多少精修行？\n");
    }
    if (respirate_cost < 10) {
        return notify_fail("你最少要花 10 点精力才能进行修行。\n");
    }
    if (arg1->query("jing") < respirate_cost) {
        return notify_fail("你现在精不足，无法修行精力！\n");
    }
    if (arg1->query("qi") * 100 / arg1->query("max_qi") < 70) {
        return notify_fail("你现在身体状况太差了，无法集中精神！\n");
    }
    write("你闭上眼睛开始打坐。\n");
    arg1->set_temp("pending/respirate", 1);
    arg1->set_temp("respirate_cost", respirate_cost);
    message("vision", arg1->name() + "盘膝坐下，开始吐纳炼精。\n", environment(arg1), ({ arg1 }));
    arg1->start_busy((: respirating :), (: halt_respirate :));
    return 1;
}

int respirating(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = arg->query_temp("respirate_cost");
    v2 = arg->query_skill("taoism", 1) * 2;
    if (v1 < 1) {
        return 0;
    }
    if (v1 < v2) {
        v2 = v1;
    }
    if (v1 > v2 * 2) {
        v2 = v1 / 2;
    }
    arg->add("jingli", v2);
    arg->set_temp("respirate_cost", v1 -= v2);
    arg->add("jing", -v2);
    if (v1 > 0) {
        return 1;
    }
    arg->set_temp("pending/respirate", 0);
    v1 = 0;
    message_vision("$N吐纳完毕，睁开双眼，站了起来。\n", arg);
    if (arg->query("jingli") < arg->query("max_jingli") * 2) {
        return 0;
    } else if (arg->query("max_jingli") > arg->query_skill("taoism") * 10) {
        write("你的精力修为似乎已经达到了瓶颈。\n");
        arg->set("jingli", arg->query("max_jingli") * 2);
        return 0;
    } else {
        arg->add("max_jingli", 1);
        arg->set("jingli", arg->query("max_jingli"));
        write("你的精力增加了！！\n");
        return 0;
    }
}

int halt_respirate(mixed arg) {
    if (arg->query("jingli") > arg->query("max_jingli") * 2) {
        arg->set("jingli", arg->query("max_jingli") * 2);
    }
    arg->set_temp("pending/respirate", 0);
    return 1;
}

int help(mixed arg) {
    write("指令格式 : respirate [<耗费「精」的量>]\n \n打坐修行，利用「炼精化气，炼气化神，炼神还虚」的方法将你的精\n转变成精力。\nSee also: exercise\n");
    return 1;
}
