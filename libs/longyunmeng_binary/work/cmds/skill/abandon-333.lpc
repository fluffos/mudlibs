int main(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg1 != this_player(1)) {
        return 0;
    }
    v1 = arg1->query_temp("link_ob");
    if (!v1) {
        return 0;
    }
    while (v1 && v1->is_character()) {
        v1 = v1->query_temp("link_ob");
    }
    if (!arg2 || arg2 == "") {
        return notify_fail("你要放弃哪一项技能？\n");
    }
    if (!(arg1->query_skill(arg2, 1) + arg1->query_skill_learn(arg2))) {
        return notify_fail("你并没有学过这项技能。\n");
    }
    write("请输入你的身份标识：");
    input_to("get_biaoshi", 1, v1, arg2);
    return 1;
}

int get_biaoshi(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    write("\n");
    v2 = arg2->query("biaoshiold");
    if (oldcrypt(arg1, v2) != v2) {
        write("身份标识错误！\n");
        return 0;
    }
    if (!v1->delete_skill(arg3)) {
        return notify_fail("你没有学过这项技能。\n");
    }
    write("你决定放弃继续学习" + to_chinese(arg3) + "。\n");
    v1->reset_action();
    return 1;
}

int help() {
    write("指令格式：abandon <技能名称>\n放弃一项你所学过的技能，注意这里所说的「放弃」是指将这项技能从你人物\n的资料中删除，如果你以后还要练，必须从０开始重练，请务必考虑清楚。\n这个指令使用的场合通常是用来删除一些「不小心」练出来的技能，由于每个\n人有着不同的天赋，所修习的武功也不会相同。如果样样都学，到头来只会样\n样不精。\n");
    return 1;
}
