// 本文件由编译后的 .b 二进制程序反编译还原，原始源码未随档案发布。
// Decompiled from the compiled .b binary; the original source was not distributed.
string query_skill_mapped(mixed);
varargs void map_skill(mixed, mixed);
varargs int query_skill(mixed, mixed);
varargs void improve_skill(mixed, mixed, mixed);
mapping query_skill_prepare();
int mingsing(mixed);
int halt_mingsi(mixed);
int main(mixed, mixed);
int help(mixed);

private int mingsi_cost;

int main(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = environment(arg1);
    seteuid(getuid());
    if (v1->query("pigging")) {
        return notify_fail("你还是专心拱猪吧！\n");
    }
    if (arg1->is_busy()) {
        return notify_fail("你现在正忙着呢！\n");
    }
    if (arg1->is_fighting()) {
        return notify_fail("战斗也是一种修行，但不能和法力的修行同时进行。\n");
    }
    if (arg1->query_skill("spells") < 15) {
        return notify_fail("你必须先学些基本法术。\n");
    }
    if (!arg2 || !sscanf(arg2, "%d", mingsi_cost)) {
        return notify_fail("你要花多少精力修行？\n");
    }
    if (mingsi_cost < 10) {
        return notify_fail("你最少要花 10 点精力才能进行修行。\n");
    }
    if (arg1->query("jingli") < mingsi_cost) {
        return notify_fail("你现在精力不足，无法修行法力！\n");
    }
    if (arg1->query("qi") * 100 / arg1->query("max_qi") < 70) {
        return notify_fail("你现在身体状况太差了，无法集中精神！\n");
    }
    if (arg1->query("jing") * 100 / arg1->query("max_jing") < 70) {
        return notify_fail("你现在身体状况太差了，无法集中精神！\n");
    }
    write("你闭上眼睛开始冥思。\n");
    arg1->set_temp("pending/mingsi", 1);
    arg1->set_temp("mingsi_cost", mingsi_cost);
    message("vision", arg1->name() + "盘膝坐下，开始冥思悟道。\n", environment(arg1), ({ arg1 }));
    arg1->start_busy((: mingsing :), (: halt_mingsi :));
    return 1;
}

int mingsing(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = arg->query_temp("mingsi_cost");
    v2 = arg->query_skill("spells", 1) * 2;
    if (v1 < 1) {
        return 0;
    }
    if (v1 < v2) {
        v2 = v1;
    }
    if (v1 > v2 * 2) {
        v2 = v1 / 2;
    }
    arg->add("fashufali", v2);
    arg->set_temp("mingsi_cost", v1 -= v2);
    arg->add("jingli", -v2);
    if (v1 > 0) {
        return 1;
    }
    arg->set_temp("pending/mingsi", 0);
    v1 = 0;
    message_vision("$N冥思完毕，睁开双眼，站了起来。\n", arg);
    if (arg->query("fashufali") < arg->query("max_fashufali") * 2) {
        return 0;
    } else if (arg->query("max_fashufali") > arg->query_skill("spells") * 5 + 15) {
        write("你的法力修为似乎已经达到了瓶颈。\n");
        arg->set("fashufali", arg->query("max_fashufali") * 2);
        return 0;
    } else {
        arg->add("max_fashufali", 1);
        arg->set("fashufali", arg->query("max_fashufali"));
        write("你的法力增加了！！\n");
        return 0;
    }
}

int halt_mingsi(mixed arg) {
    if (arg->query("fashufali") > arg->query("max_fashufali") * 2) {
        arg->set("fashufali", arg->query("max_fashufali") * 2);
    }
    arg->set_temp("pending/mingsi", 0);
    return 1;
}

int help(mixed arg) {
    write("指令格式 : mingsi [<耗费「精力」的量>]\n \n冥思修行，利用「炼精化神，炼神修法，炼法悟道」的方法将你的精力\n转变成法力。\n");
    return 1;
}
