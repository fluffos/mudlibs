inherit "/feature/clean_up";
int help(mixed);
int main(mixed, mixed);

int main(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!arg2) {
        return help(arg1);
    }
    seteuid(geteuid(arg1));
    if (arg2 == "me") {
        v1 = arg1;
    } else if (arg2 == "my link") {
        v1 = arg1->query_temp("link_ob");
    } else {
        v1 = present(arg2, arg1);
        if (!v1) {
            v1 = present(arg2, environment(arg1));
        }
        if (!v1) {
            v1 = find_object(resolve_path(arg1->query("cwd"), arg2));
        }
        if (!v1) {
            return notify_fail("没有这样物件....。\n");
        }
    }
    printf("物件 [%O]\n-----------------------------------------------------\n", v1);
    write("档案：\t\t" + base_name(v1) + ".c\n");
    write("领域：\t\t" + domain_file(base_name(v1)) + "\n");
    write("作者：\t\t" + author_file(base_name(v1)) + "\n");
    write("权限：\t\tuid = " + getuid(v1) + ", euid = " + geteuid(v1) + "\n");
    write("等级：\t\t" + wizhood(v1) + "\n");
    write("使用记忆体：\t" + memory_info(v1) + "\n");
    v2 = "";
    if (living(v1)) {
        v2 += "生物 ";
    }
    if (userp(v1)) {
        v2 += "使用者 ";
    }
    if (interactive(v1)) {
        v2 += "线上 ";
    }
    if (wizardp(v1)) {
        v2 += "巫师 ";
    }
    if (clonep(v1)) {
        v2 += "复制 ";
    }
    if (virtualp(v1)) {
        v2 += "虚拟 ";
    }
    if (query_heart_beat(v1)) {
        v2 += "心跳:" + query_heart_beat(v1) + " ";
    }
    write("属性：\t\t" + v2 + "\n");
    write("复制个数：\t" + sizeof(children(base_name(v1) + ".lpc")) + "\n");
    write("参考连结：\t" + refs(v1) + "\n");
    return 1;
}

