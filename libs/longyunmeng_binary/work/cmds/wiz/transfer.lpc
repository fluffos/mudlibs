// Decompiled from the compiled .b binary; the original source was not distributed.
int help(mixed);
int main(mixed, mixed);

int main(mixed arg1, mixed arg2) {
    mixed v1;
    if (!arg2) {
        v1 = 30;
    } else if (!sscanf(arg2, "%d", v1)) {
        return help(arg1);
    }
    if (v1 < 1) {
        return notify_fail("你没有这么多潜能来转移！\n");
    }
    if (arg1->query("jing") * 10 < v1) {
        return notify_fail("你的精神状态不足以转化这么多潜能！\n");
    }
    if (arg1->query("potential") - arg1->query("learned_points") >= v1) {
        arg1->add("jing", -v1 / 10);
        arg1->add("potential", -v1);
        arg1->add("combat_exp", v1 * 2);
        write("OK!\n");
    } else {
        write("你没有这么多潜能来转移！\n");
    }
    return 1;
}

int help(mixed arg) {
    write("指令格式 :transfer <潜能点>\n\n      把潜能转成经验。\nsee also : hp\n\n");
    return 1;
}
