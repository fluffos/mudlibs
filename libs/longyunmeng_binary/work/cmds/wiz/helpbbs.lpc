int lock() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = v1->query_temp("link_ob");
    write("\e[1;37m▲ 请输入密码，以解除萤幕锁定：\e[2;37;0m");
    input_to("get_old_pass", 1, v2);
    return 1;
}

void get_old_pass(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = arg2->query("password");
    if (crypt(arg1, v1) != v1) {
        lock();
        return;
    }
    u_display();
    write("\e[33m\r请输入您的选择:\e[2;37;0m");
    input_to((: confirm_u_choice :), this_player());
    return;
}

int cloak() {
    mixed v1;
    v1 = this_player();
    if (!wizardp(v1)) {
        u_display();
        write("\e[33m\r请输入您的选择:\e[2;37;0m");
        input_to((: confirm_u_choice :), this_player());
        return 1;
    }
    if (v1->query("env/invisibility")) {
        write("我要重现江湖...\n");
        v1->delete("env/invisibility");
    } else {
        write("哈哈！我隐形起来了。\n");
        v1->set("env/invisibility", 5);
    }
    return 1;
}

private void confirm_u_choice(mixed arg) {
    this_player()->set_temp("help_u", 1);
    if (arg == "") {
        u_display();
        write("\e[33m\r请从新输入您得选择:\e[2;37;0m");
        input_to((: confirm_u_choice :), this_player());
        return;
    }
    switch (arg[0]) {
    case 114:
        register();
        return;
    case 112:
        pager();
        check_user();
        return;
    case 99:
        cloak();
        check_user();
        return;
    case 108:
        lock();
        return;
    case 102:
    case 103:
    case 103:
    case 104:
        m_display();
        write("\e[33m\r请输入您得选择:\e[2;37;0m");
        this_player()->delete_temp("help_u");
        input_to((: confirm_main_choice :), this_player());
        return;
    default:
        u_display();
        write("\e[33m\r请输入您的选择:\e[2;37;0m");
        input_to((: confirm_u_choice :), this_player());
        return;
    }
    return;
}

