void create() {
    seteuid(getuid());
}

int main(mixed arg1, mixed arg2) {
    mixed v1;
    if (v1 = arg1->query_temp("link_ob")) {
        write("您的 Email address [" + v1->query("email") + "]: ");
        input_to("get_email", v1);
        return 1;
    }
}

string rp_color(mixed arg) {
    if (!arg) {
        return "";
    }
    arg = replace_string(arg, "$BLK$", "\e[30m");
    arg = replace_string(arg, "$RED$", "\e[31m");
    arg = replace_string(arg, "$GRN$", "\e[32m");
    arg = replace_string(arg, "$YEL$", "\e[33m");
    arg = replace_string(arg, "$BLU$", "\e[34m");
    arg = replace_string(arg, "$MAG$", "\e[35m");
    arg = replace_string(arg, "$CYN$", "\e[36m");
    arg = replace_string(arg, "$WHT$", "\e[37m");
    arg = replace_string(arg, "$HIR$", "\e[1;31m");
    arg = replace_string(arg, "$HIG$", "\e[1;32m");
    arg = replace_string(arg, "$HIY$", "\e[1;33m");
    arg = replace_string(arg, "$HIB$", "\e[1;34m");
    arg = replace_string(arg, "$HIM$", "\e[1;35m");
    arg = replace_string(arg, "$HIC$", "\e[1;36m");
    arg = replace_string(arg, "$HIW$", "\e[1;37m");
    arg = replace_string(arg, "$BLINK$", "\e[5m");
    arg = replace_string(arg, "$NOR$", "\e[2;37;0m");
    return arg + "\e" + "[2;37;0m";
}

void get_email(mixed arg1, mixed arg2) {
    if (arg1 != "") {
        arg2->set("email", arg1);
    }
    write("您的自我介绍: (finger时显示)\n");
    arg2->query_temp("body_ob")->edit((: call_other, "/cmds/wiz/chfn.lpc", "get_profile", arg2 :));
}

void get_profile(mixed arg1, mixed arg2) {
    arg2 = rp_color(arg2);
    arg1->set("profile", arg2);
    write("您的签名格式: (post时用)\n");
    arg1->query_temp("body_ob")->edit((: call_other, "/cmds/wiz/chfn.lpc", "get_signature", arg1 :));
}

void get_signature(mixed arg1, mixed arg2) {
    if (sizeof(arg2) > 1400) {
        write("签名格式太长！请重新设定　\n");
    } else {
        arg2 = rp_color(arg2);
        arg1->set("signature", arg2);
    }
    write("请记得用 save 储存您所作的修改　\n");
}

int help(mixed arg) {
    write("指令格式 : chfn\n\n用途 : 用来修改 email address , 编辑自我介绍(finger 时看到)\n       及签名(post 时用)　\n");
    return 1;
}
