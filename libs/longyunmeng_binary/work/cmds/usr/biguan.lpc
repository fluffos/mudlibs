int breaking(mixed arg) {
    mixed v1;
    if (arg->is_ghost()) {
        arg->delete_temp("breakuping");
        return 0;
    }
    if (arg->query("potential") < 15) {
        tell_object(arg, "你的潜能不够了。\n");
        arg->delete_temp("breakuping");
        arg->set("potential", 0);
        message_vision("$N睁开双目，缓缓吐了一口气，站了起来。\n", arg);
        message("channel:chat", "\e[1;33m【镜花水月】\e[1;35m听说" + arg->query("name") + "\e" + "[1;35m闭关结束,似乎没有太大的进展！\n\e" + "[2;37;0m", users());
        return 0;
    }
    if (arg->query_temp("netdead") || arg->query("lixian/biguan")) {
        arg->delete_temp("breakuping");
        message_vision("$N睁开双目，缓缓吐了一口气，站了起来。\n", arg);
        message("channel:chat", "\e[1;33m【镜花水月】\e[1;35m听说" + arg->query("name") + "\e" + "[1;35m闭关中途突然复出,似乎没有太大的进展！\n\e" + "[2;37;0m", users());
        return 0;
    }
    arg->add("potential", -5);
    if (random(500000) < arg->query("con") && !arg->query("breakup")) {
        message_vision("\e[1;37m只见$N\e[1;37m头上白雾腾腾、浑身如同笼罩在云中，看来已经到了三花聚顶、五气朝元、龙虎相济、天人交会的紧要关头！\n\e[2;37;0m", arg);
        tell_object(arg, "\e[1;31m你觉得内力在丹田源源而生，不断冲击诸处大穴，浑身燥热难当，几欲大声呼喊。\n\e[2;37;0m");
        message_vision("\e[1;36m突然$N\e[1;36m大喝一声，一股无形气浪陡然散布开来，四周空气登时变得燥热。\n\e[2;37;0m", arg);
        tell_object(arg, "\e[1;32m你顿时觉得浑身一阵轻松，一股清凉之意油然而起，心灵一片空明，内力没有丝毫阻滞，舒泰之极。\n\e[2;37;0m");
        arg->delete_temp("breakuping");
        arg->set("breakup", 1);
        message("channel:chat", "\e[1;33m【镜花水月】\e[1;35m听说" + arg->query("name") + "\e" + "[1;35m经过闭关苦修,终于打通了任督二脉,窥视到了无上的武学境界！\n\e" + "[2;37;0m", users());
        arg->add("max_jingli", arg->query("max_jingli") / 10);
        arg->add("max_neili", arg->query("max_neili") / 10);
        arg->set_skill("force", arg->query_skill("force", 1) + 100);
        return 0;
    }
    switch (random(5)) {
    case 0:
        v1 = "你默默运转内力，隐隐有些感觉。\n";
        arg->start_busy(3);
        break;
    case 1:
        v1 = "你将内力运出丹田，过紫宫、入泥丸、透十二重楼，遍布奇筋八脉，然后收回丹田。\n";
        arg->start_busy(3);
        break;
    case 2:
        v1 = "你将内力运经诸穴，抵四肢百赅，然后又回收丹田。\n";
        arg->start_busy(3);
        break;
    case 3:
        v1 = "你在丹田中不断积蓄内力，只觉得浑身燥热。\n";
        arg->start_busy(3);
        break;
    default:
        v1 = "你缓缓呼吸吐纳，将空气中水露皆收为己用。\n";
        arg->start_busy(3);
        break;
    }
    tell_object(arg, v1);
    if (!arg->query("breakup") && arg->query_temp("breakuping")) {
        call_out("breaking", 3, arg);
    }
    return 1;
}

int help(mixed arg) {
    write("指令格式 : biguan\n\n闭关修行以打通任督二脉，需要非常深厚的内力和内功功底才能做到。\n而且会消耗潜能。一旦打通了任督二脉可以同时扩展精、气、精力、\n内力的上限。\n如你想中断闭关修行，输入\nbiguan -stop\n就可以了。\n");
    return 1;
}
