inherit "/feature/clean_up";
int get_biaoshi(mixed, mixed);
int get_levup_yn(mixed, mixed);
int get_levelup(mixed);
int main(mixed, mixed);
int help();

int main(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg1 != this_player(1)) {
        return 0;
    }
    v1 = arg1->query_temp("link_ob");
    if (!v1) {
        return 0;
    }
    while (v1 && v1->is_character()) {
        v1 = v1->query_temp("link_ob");
    }
    if (!arg1->query("combat_exp", 1) || arg1->query("combat_exp", 1) < 30000000) {
        return notify_fail("\e[1;33m你的实战经验不足，无法进行升级。\n\e[2;37;0m");
    }
    write("\e[1;33m为了安全起见要求验证身份标识,请输入你的身份标识：\e[2;37;0m");
    input_to("get_biaoshi", 1, v1);
    return 1;
}

int get_biaoshi(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = arg2->query("biaoshiold");
    write("\n");
    if (crypt(arg1, v1) != v1) {
        write("\e[1;31m身份标识验证失败！\n\e[2;37;0m");
        return 0;
    }
    write("\e[1;32m【\e[1;35m温磬提示\e[1;32m】：\e[1;37m每提升一等级会减少 \e[1;33m" + 15000000 + " 点\e" + "[1;37m 实战经验，实战经验关系到你\n" + "\t\t\t\t\t\t\t可以学习的战斗技能上限以及技能绝招使用的命中率。另外你现\n" + "\t\t\t\t\t\t\t在利用该指令手动提升等级所获得的属性点会比你的实战经验达到\n" + "\t\t\t\t\t\t\t \e" + "[1;33m" + 2100000000 + "\e" + "[1;37m 后系统自动帮你提升等级时所获得的属性点少很多。\n" + "\e" + "[1;32m\t\t\t\t\t\t\t虽然系统没有等级上限的限制但这可能影响到你的游戏进程，因\n" + "\t\t\t\t\t\t\t为各项属性的高低会对你的战斗力强弱造成很大影响。希望你能\n" + "\t\t\t\t\t\t\t慎重考虑斟酌！\n" + "\e" + "[1;33m你是否决定现在就要提升等级？[\e" + "[1;32mY\e" + "[1;37m/\e" + "[1;31mN\e" + "[1;33m]：\e" + "[2;37;0m");
    input_to("get_levup_yn", 1, arg2);
    return 1;
}

int get_levup_yn(mixed arg1, mixed arg2) {
    if (strsrch(arg1, "Y") != -1 || strsrch(arg1, "y") != -1) {
        get_levelup(arg2);
        return 1;
    } else {
        write("\e[1;33m\n你放弃了这次等级提升。\n\e[2;37;0m");
        return 0;
    }
}

int get_levelup(mixed arg) {
    mixed v1;
    v1 = this_player();
    write("\n");
    if (!v1->query("combat_exp", 1) || v1->query("combat_exp", 1) < 30000000) {
        write("\e[1;31m等级提升失败。\n\e[2;37;0m");
        return 0;
    } else {
        v1->add("combat_exp", -15000000);
        v1->add("xyzx_sys/level", 1);
        v1->add("xyzx_sys/jingzhun", 1);
        v1->add("xyzx_sys/lingxing", 1);
        v1->add("xyzx_sys/minjie", 1);
        v1->add("xyzx_sys/fanying", 1);
        v1->add("xyzx_sys/shuxingdian", 10);
        tell_object(v1, "\e[1;32m你的\e[1;35m『 等 级 』\e[1;32m提升了！增加 \e[1;33m" + chinese_number(10) + " 点 \e" + "[1;32m属性点。\n" + "\e" + "[1;32m你的精准提升了。\n" + "\e" + "[1;35m你的灵性提升了。\n" + "\e" + "[1;37m你的敏捷提升了。\n" + "\e" + "[1;36m你的反应提升了。\n\e" + "[2;37;0m");
        return 1;
    }
}

int help() {
    write("指令格式：levelup\n这个指令可以让你手动提升人物等级，每提升一级需扣除 1500万 的实战经验，\n同时你会得到10点属性点由你自由分配(具体加点方式请参考：help jiadian)。\n除了可以通过该指令手动提升等级外，当你的经验达到21亿时系统还会自动提升\n你的等级，系统自动升级每级给的属性点比手动提升等级要多上5点，所以建议\n你最好还是让系统自动帮你提升等级。\n[注意：人物等级为零时，可以直接杀NPC获得经验及潜能，前提是NPC的经验需\n      比你的经验的十分之一要高。当你的等级大于零时也就是你的等级有提升\n      过时，除了在动态地图外，你杀NPC将不能再获得经验及潜能了。另外在\n      动态地图以外杀NPC升级只能到一亿(等级*1"
            "500+经验)]\n[重要提示：泰山的盟主及使者像需要等级大于零，也就是你的等级必须至少有一\n      级才可以打。另外说明一下升级后状态的大体变化：等级提升需扣除一定\n      的经验，但不影响攻、御值，也就是攻击、防御是不会变的，这个你可以\n      通过 score 查看，而你把获得的属性点加到属性上，状态就会根据你的\n      加点方式，也就是你的属性变动而变化。具体哪些属性会对状态造成何影\n      响请参考 help jiadian]\n");
    return 1;
}
