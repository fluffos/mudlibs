        v1 += sprintf("\e[1;32m %s\e[1;32m今天剩余的双倍经验时间\e[37m：\e[1;33m0小时0分钟0秒\n\n\e[2;37;0m", v18 == arg1 ? "你" : v18->name(1));
    }
    v1 += sprintf("\n");
    write(v1);
    return 1;
}

string display_attr(mixed arg1, mixed arg2) {
    if (arg2 > arg1) {
        return sprintf("\e[1;33m%5d\e[2;37;0m", arg2);
    } else if (arg2 < arg1) {
        return sprintf("\e[36m%5d\e[2;37;0m", arg2);
    } else {
        return sprintf("%5d", arg2);
    }
}

string tribar_graph(mixed arg1, mixed arg2, mixed arg3, mixed arg4) {
    return arg4 + bar_string[0..arg1 * 25 / arg3 * 2 - 1] + (arg2 > arg1 ? blank_string[arg1 * 25 / arg3 * 2..arg2 * 25 / arg3 * 2 - 1] : "") + (arg3 > arg2 ? none_string[arg2 * 25 / arg3 * 2..49] : "") + "\e" + "[2;37;0m";
}

int check_cc(mixed arg) {
    mixed v1;
    mixed v2;
    for (v2 = 0, v1 = 0; v1 < sizeof(arg); v1++) {
        if (arg[v1] == 27) {
            for (; arg[v1] != 109; v1++) {
                v2++;
            }
            v2++;
        }
    }
    return v2;
}

string value_string(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg1) {
        v1 = (arg1 / 10000 ? chinese_number(arg1 / 10000) + "亿" : "") + chinese_number(arg1 % 10000) + "万";
        if (arg2 < 1) {
            return v1 + "两黄金";
        } else if (arg2 < 100) {
            return v1 + "两黄金" + chinese_number(arg2) + "文钱";
        } else if (arg2 < 10000) {
            return v1 + "两黄金" + chinese_number(arg2 / 100) + "两白银" + (arg2 % 100 ? "又" + chinese_number(arg2 % 100) + "文钱" : "");
        } else {
            return v1 + chinese_number(arg2 / 10000) + "两黄金" + (arg2 % 10000 / 100 ? chinese_number(arg2 % 10000 / 100) + "两白银" : "") + (arg2 % 10000 % 100 ? "又" + chinese_number(arg2 % 10000 % 100) + "文钱" : "");
        }
    } else if (arg2 < 1) {
        return "";
    } else if (arg2 < 100) {
        return chinese_number(arg2) + "文钱";
    } else if (arg2 < 10000) {
        return chinese_number(arg2 / 100) + "两白银" + (arg2 % 100 ? "又" + chinese_number(arg2 % 100) + "文钱" : "");
    } else {
        return chinese_number(arg2 / 10000) + "两黄金" + (arg2 % 10000 / 100 ? chinese_number(arg2 % 10000 / 100) + "两白银" : "") + (arg2 % 10000 % 100 ? "又" + chinese_number(arg2 % 10000 % 100) + "文钱" : "");
    }
}
