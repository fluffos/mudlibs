string status_color(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg2 > 0) {
        v1 = arg1 * 100 / arg2;
    } else {
        v1 = 100;
    }
    if (v1 > 100) {
        return "\e[1;36m";
    }
    if (v1 >= 90) {
        return "\e[1;32m";
    }
    if (v1 >= 60) {
        return "\e[1;33m";
    }
    if (v1 >= 30) {
        return "\e[33m";
    }
    if (v1 >= 10) {
        return "\e[1;31m";
    }
    return "\e[31m";
}

