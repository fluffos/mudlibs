// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#include <globals.h>
int main()
{
  mapping error;
  int i;
  if (!(error = this_player()->query_error())) return 1;
  printf("%sProgram: %s\n", error["error"], error["program"]);
  for (i=0; i<sizeof(error["trace"]); i++) {
    printf("%i: %s in %s:%i\n", i, error["trace"][i]["function"], error["trace"][i]["program"], error["trace"][i]["line"]);
  }
  return 1;
}
