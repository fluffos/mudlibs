// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit F_CLEAN_UP;
int main(object me)
{
        mapping info;
        float x, fraction,fraction2;
        string str;

        info = rusage();
        x = info["utime"] + info["stime"];

        x = info["stime"]/10;
        fraction = x / uptime();
        x = info["utime"]/10;
        fraction2 = x / uptime();
        str = sprintf("CPU usage -- Sys: %2.2f -- User: %2.2f\n", fraction,fraction2);
        write( str );
        return 1;
}

