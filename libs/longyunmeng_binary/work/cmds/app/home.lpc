inherit "/feature/clean_up";
int main(mixed, mixed);
int help(mixed);

int main(mixed arg1, mixed arg2) {
    mixed v1;
    if (file_size(user_path(geteuid(arg1)) + "workroom.lpc") <= 0) {
        return notify_fail("你没有自己的工作室。\n");
    }
    if (stringp(v1 = arg1->query("env/msg_home"))) {
        message_vision(v1 + "\n", arg1);
    }
    arg1->move("/u/" + geteuid(arg1) + "/workroom.lpc");
    return 1;
}

int help(mixed arg) {
    write("指令格式 : home\n利用此一指令可直接回到自己的工作室。\n如果你有 'msg_home' 这个设定, 则在场的人都会看到那个讯息.\n");
    return 1;
}
