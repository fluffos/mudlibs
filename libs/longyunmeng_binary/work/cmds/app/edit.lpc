    }
}

int main(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!arg2) {
        return notify_fail("指令格式：edit <档名>\n");
    }
    if (in_edit(arg1)) {
        return notify_fail("你已经在使用编辑器了。\n");
    }
    v1 = resolve_path(arg1->query("cwd"), arg2);
    if (!master()->valid_read(v1, arg1, "edit")) {
        printf("Edit: 权限不允许读%s.\n", v1 == "" ? "根目录" : v1);
        return 1;
    }
    if (!master()->valid_write(v1, arg1, "edit")) {
        printf("Edit: 权限不允许写%s.\n", v1 == "" ? "根目录" : v1);
        return 1;
    }
    foreach (v2 in users()) {
        if (v1 == "/" + in_edit(v2)) {
            return notify_fail("共享冲突：" + v2->name(1) + "(" + capitalize(v2->query("id")) + ")" + "正在编辑该文件(" + v1 + ")。\n");
        }
    }
    printf("编辑文件：%s\n", v1);
    "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("%s(%s)正在编辑文件(%s)。", arg1->name(1), capitalize(arg1->query("id")), v1));
    log_file("edit/" + geteuid(arg1), sprintf("edit %s %s\n", resolve_path(arg1->query("cwd"), arg2), ctime(time())));
    seteuid(geteuid(arg1));
    ed(resolve_path(arg1->query("cwd"), arg2));
    arg1->set("cwf", v1);
