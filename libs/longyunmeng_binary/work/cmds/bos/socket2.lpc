// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// socket.c

inherit F_CLEAN_UP;

int help();

int main(object me, string arg)
{
// MudOS's dump_socket_status() is not in FluffOS; socket_status() is, when the driver has sockets
#if efun_defined(dump_socket_status)
	write(dump_socket_status());
#elif efun_defined(socket_status)
	write(sprintf("%O\n", socket_status()));
#else
	write("这个驱动程序没有 socket 功能。\n");
#endif
	return 1;
}

int help()
{
	write("你可以用这个指令显示当前 socket 程序会话情况。\n");
	return 1;
}
