void create() {
    seteuid(getuid());
}

int main(mixed arg1, mixed arg2) {
    mixed v1;
    if (!arg2) {
        return notify_fail("你要恢复谁的数据?\n");
    }
    v1 = present(arg2, environment(arg1));
    if (!v1) {
        v1 = present(arg2, arg1);
    }
    if (!v1) {
        v1 = find_player(arg2);
    }
    if (!v1) {
        return notify_fail("找不到指定的人。\n");
    }
    if (file_size("/data//user/" + arg2[0..0] + "/" + arg2 + ".oo.o") == -1) {
        return notify_fail(v1->query("name") + "(" + v1->query("id") + ")没有备份档案。\n");
    }
    cp("/data//user/" + arg2[0..0] + "/" + arg2 + ".oo.o", "/data//user/" + arg2[0..0] + "/" + arg2 + ".o");
    write_file("/log/cmds/huifu", sprintf("%s(%s) 恢复 %s(%s) 的档案on %s\n", arg1->name(1), arg1->query("id"), v1->name(1), v1->query("id"), ctime(time())));
    write("\e[1;37m\n" + v1->query("name") + "(" + v1->query("id") + ")\e" + "[1;32m的档案恢复完毕。\n\e" + "[2;37;0m");
    return 1;
}

