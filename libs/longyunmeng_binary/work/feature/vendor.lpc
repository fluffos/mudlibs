        v3->pay_money(v8 * v10);
        if (v1 == "") {
            message_vision("$N向$n买下" + "/adm/daemons/chinesed"->chinese_number(v10) + v6->query("unit") + v6->query("name") + "。\n", v3, v5);
        } else {
            if (v10 > 9 && v1->query("name") == "牛皮酒袋") {
                message_vision("$N一边转身去装酒，嘴里一边嘀咕：买这么多酒，用来洗澡呀？\n", v5);
            }
            message_vision("$N向$n买下" + "/adm/daemons/chinesed"->chinese_number(v10) + v1->query("unit") + v1->query("name") + "。\n", v3, v5);
        }
        return 1;
    } else {
        return notify_fail("你的钱不够。\n");
    }
}
