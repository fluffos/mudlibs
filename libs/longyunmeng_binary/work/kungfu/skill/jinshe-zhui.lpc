inherit "/inherit/skill/skill";
int valid_enable(mixed);
mapping query_action(mixed, mixed);
int practice_skill(mixed);
string perform_action_file(mixed);

mapping *action = ({ ([ "name" : "千变万化", "action" : "$N双手一晃，一招「千变万化」，手中的$w幻出万道金光，\n如一条金龙般飞向$n的$l", "dodge" : -20, "force" : 200, "damage" : 300, "post_action" : (: call_other, "/adm/daemons/weapond", "throw_weapon" :), "damage_type" : "刺伤" ]), ([ "name" : "奇诡莫测", "action" : "$N右手一抖，一道金光冒出，只一刹那间，左手$w迅雷般越\n过右手的$w，正是一招「奇诡莫测」，抢先飞向$n的$l", "dodge" : -40, "force" : 300, "damage" : 400, "post_action" : (: call_other, "/adm/daemons/weapond", "throw_weapon" :), "damage_type" : "刺伤" ]) });

int valid_learn(mixed arg) {
    mixed v1;
    if (arg->query("max_neili") < 500) {
        return notify_fail("你的内力不够，没有办法练金蛇锥法。\n");
    }
    if (!(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "throwing") {
        return notify_fail("你必须先找一些暗器才能练金蛇锥法。\n");
    }
    return notify_fail("金蛇锥法没法教授。\n");
}

int valid_enable(mixed arg) {
    return arg == "throwing";
}

mapping query_action(mixed arg1, mixed arg2) {
    return action[random(sizeof(action))];
}

int practice_skill(mixed arg) {
    if (arg->query("qi") < 30 || arg->query("neili") < 500) {
        return notify_fail("你的内力或气不够，没有办法练习金蛇锥法。\n");
    }
    arg->receive_damage("qi", 30);
    arg->add("neili", -30);
    write("你按著所学练了一遍金蛇锥法。\n");
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/jinshe-zhui/" + arg;
}
