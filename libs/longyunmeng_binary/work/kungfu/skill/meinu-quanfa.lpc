int valid_enable(mixed arg) {
    return arg == "unarmed" || arg == "parry";
}

int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("空手方能练习美女拳法。\n");
    }
    if (arg->query("gender") != "女性") {
        return notify_fail("你无法体会美女拳法的精要。\n");
    }
    if (arg->query_skill("yunu-xinjing", 1) < 10) {
        return notify_fail("玉女心经领悟不够，无法修习美女拳法。\n");
    }
    if (arg->query_skill("dodge", 1) < 20) {
        return notify_fail("你的轻功太差，无法练美女拳法。\n");
    }
    return 1;
}

