int valid_learn(mixed arg) {
    mixed v1;
    if (arg->query_skill("songshan-sword", 1) >= 450) {
        return notify_fail("师傅只能教你到这，以后靠自己多加练习体会。\n");
    }
    if (arg->query("max_neili") < 50) {
        return notify_fail("你的内力不够，没有办法练嵩山剑法。\n");
    }
    if (!(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("你必须先找一把剑才能练剑法。\n");
    }
    return 1;
}

int valid_enable(mixed arg) {
    return arg == "sword" || arg == "parry";
}

mapping query_action(mixed arg1, mixed arg2) {
    return action[random(sizeof(action))];
}

int practice_skill(mixed arg) {
    if (arg->query("qi") < 30 || arg->query("neili") < 5) {
        return notify_fail("你的内力或气不够，没有办法练习嵩山剑法。\n");
    }
    arg->receive_damage("qi", 30);
    arg->add("neili", -5);
    write("你按著所学练了一遍嵩山剑法。\n");
    return 1;
}

