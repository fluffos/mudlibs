int heal_myself(mixed);
int heal_target(mixed, mixed);
int exert(mixed, mixed);

int heal_myself(mixed arg) {
    mixed v1;
    v1 = arg->query_skill_mapped("force");
    if (!stringp(v1)) {
        return notify_fail("你所学的内功中没有这项技能。\n");
    }
    if (arg->is_fighting()) {
        return notify_fail("战斗中运功疗伤？找死吗？\n");
    }
    if (arg->query_skill(v1, 1) < 50) {
        return notify_fail("你的" + to_chinese(v1) + "修为还不够。\n");
    }
    if (arg->query("neili") < 50) {
        return notify_fail("你的真气不够。\n");
    }
    if (arg->query("eff_qi") < arg->query("max_qi") / 2) {
        return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");
    }
    if (arg->query("eff_jing") == arg->query("max_jing")) {
        return notify_fail("你现在不需要运功疗伤！\n");
    }
    write("\e[1;37m你全身放松，坐下来开始运功疗伤。\n\e[2;37;0m");
    message("vision", "\e[1;37m" + arg->name() + "吐出一口瘀血，脸色看起来好多了。\n\e" + "[2;37;0m", environment(arg), arg);
    arg->receive_curing("jing", arg->query_skill("force") / 5 + 10);
    arg->add("neili", -50);
    arg->set("jiali", 0);
    arg->start_busy(1);
    arg->improve_skill(v1, random(arg->query_skill(v1, 1) / 3), 0);
    return 1;
}

int heal_target(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = arg1->query_skill_mapped("force");
    if (!arg2->is_character() || arg2->is_corpse()) {
        return notify_fail("看清楚一点，那并不是活物。\n");
    }
    if (!stringp(v1)) {
        return notify_fail("你所学的内功中没有这项技能。\n");
    }
    if (arg1->is_fighting() || arg2->is_fighting()) {
        return notify_fail("战斗中无法运功疗伤！\n");
    }
    if (arg1->query("max_neili") < 300) {
        return notify_fail("你的内力修为不够。\n");
    }
    if (arg1->query("neili") < 150) {
        return notify_fail("你的真气不够。\n");
    }
    if (arg2->query("eff_qi") < arg2->query("max_qi") / 5) {
        return notify_fail(arg2->name() + "已经受伤过重，经受不起你的真气震荡！\n");
    }
    if (arg2->query("eff_jing") == arg2->query("max_jing")) {
        return notify_fail(arg2->name() + "现在不需要疗伤！\n");
    }
    message_vision("\e[1;33m$N坐了下来运起内功，将手掌贴在$n背心，缓缓地将真气输入$n体内....\n\n过了不久，$N额头上冒出豆大的汗珠，$n吐出一口瘀血，脸色看起来红润多了。n\e[2;37;0m", arg1, arg2);
    arg2->receive_curing("jing", arg1->query_skill("force") / 3 + 10);
    arg1->add("neili", -150);
    arg1->set("jiali", 0);
    arg2->set("jiali", 0);
    arg1->start_busy(5);
    arg2->start_busy(3);
    arg1->improve_skill(v1, random(arg1->query_skill(v1, 1) / 3), 0);
    return 1;
}

int exert(mixed arg1, mixed arg2) {
    if (!arg2 || arg2 == arg1) {
        return heal_myself(arg1);
    } else {
        return heal_target(arg1, arg2);
    }
}
