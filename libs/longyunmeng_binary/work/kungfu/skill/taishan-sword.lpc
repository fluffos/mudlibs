mapping *action = ({ ([ "name" : "岱宗如何", "action" : "$N右手$w斜指而下，左手五指正在屈指而数，从一数到五，握而成拳，又\n将拇指伸出，次而食指，终至五指全展，跟着又屈拇指而屈食指，再屈中\n指，然后手中$w剑光暴长，向$n的$l刺去", "dodge" : 50, "damage" : 170, "damage_type" : "刺伤" ]), ([ "name" : "朗月无云", "action" : "$N手中$w一晃，向右滑出三步，一招“朗月无云”，转过身来，身\n子微矮，$w向$n斜斜刺去", "dodge" : -70, "damage" : 120, "damage_type" : "刺伤" ]), ([ "name" : "峻岭横空", "action" : "$N手中$w圈转，一招「峻岭横空」去势奇疾，无数剑光刺向$n的$l", "dodge" : -40, "damage" : 90, "damage_type" : "刺伤" ]), ([ "name" : "泰山十八盘", "action" : "$N展开剑势，身随剑走，左边一拐，右边一弯，越转越急。猛地\n$w剑光暴长，一招「泰山十八盘」往$n$l刺去",
