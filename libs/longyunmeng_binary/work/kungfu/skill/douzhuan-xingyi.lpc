    }
    v1 = arg1->query_skill("douzhuan-xingyi", 1);
    v1 += v1 + random(v1);
    v5 = arg2->query("family/family_name");
    v3 = arg1->query_temp("weapon");
    v4 = "\e[1;37m\n以彼之道，还施彼身。突然之间，$N使出$n的绝技。\n\n\e[2;37;0m";
