int valid_enable(mixed arg) {
    return arg == "parry";
}

string query_parry_msg(mixed arg) {
    return parry_msg[random(sizeof(parry_msg))] + "。\n";
}

int valid_learn(mixed arg) {
    return notify_fail("斗转星移只能通过领悟来提高。\n");
}

int practice_skill(mixed arg) {
    return notify_fail("斗转星移只能通过领悟来提高，无法通过练习来提高。\n");
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/douzhuan-xingyi/" + arg;
}

