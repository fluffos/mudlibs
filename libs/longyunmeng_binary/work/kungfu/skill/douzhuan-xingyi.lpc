            v4 += "\e[1;36m\n$N手中长剑剑芒跃动，剑光暴长，剑尖颤动似乎分左右刺向$n\n\e[2;37;0m";
            if (arg2->query("qi") > v1 / 2) {
                arg2->receive_wound("qi", v1 / 2);
            }
        } else {
            v4 += "\e[1;32m\n$N深吸一口气，大喝一声，连续击出\e[1;37m" + (random(10) + 1) + "\e" + "[1;32m掌，后招推着前招，掌力叠合在一起扑向$n！\n\e" + "[2;37;0m";
            if (arg2->query("qi") > v1) {
                arg2->receive_wound("qi", v1);
            }
        }
        arg1->add("neili", -100);
        arg1->add("jing", -10);
        if (!arg2->is_busy() && !random(3)) {
            arg2->start_busy(2);
        }
        v2 = arg2->query("qi") * 100 / arg2->query("max_qi");
        v4 += "( $n" + eff_status_msg(v2) + " )\n";
        break;
    case "日月神教":
        if (objectp(arg1->query_temp("weapon"))) {
            v4 += "\e[33m\n$N\e[31m阴侧侧长笑数声，天魔刀法接连出招。\n\e[2;37;0m";
            if (arg2->query("qi") > v1 / 2) {
                arg2->receive_wound("qi", v1 / 2);
            }
        } else {
            v4 += "\e[31m\n$N猛地纵起，向$n扑去，手指一弹，细针飞了出去，插向$n右目。\n\e[2;37;0m";
            if (arg2->query("qi") > v1) {
                arg2->receive_wound("qi", v1);
            }
        }
        arg1->add("neili", -100);
        arg1->add("jing", -10);
        if (!arg2->is_busy() && !random(3)) {
            arg2->start_busy(2);
        }
        v2 = arg2->query("qi") * 100 / arg2->query("max_qi");
        v4 += "( $n" + eff_status_msg(v2) + " )\n";
        break;
    case "凌霄城":
        if (objectp(arg1->query_temp("weapon"))) {
            v4 += "\e[1;37m\n$N长啸一声,使出「万梅飘零」,手中兵器疾卷,掀起万朵雪花向前铺天盖地的撒去。\n在白茫茫的一片中,忽然出现万朵梅花形剑花,穿透雪幕,朝四面八方狂射而出。\n\e[2;37;0m";
            if (arg2->query("qi") > v1 / 2) {
                arg2->receive_wound("qi", v1 / 2);
            }
        } else {
            v4 += "\e[1;37m\n$N冰雪心法运转一周天，全身只觉一股寒气蒸腾欲出,清啸一声,\n飞身而上,施展出「\e[1;37m烟雪春梅」，双手一搓一放,一股凝人气血的\n狂飙向$n铺天盖地席卷而去。\n\e[2;37;0m";
            if (arg2->query("qi") > v1) {
                arg2->receive_wound("qi", v1);
            }
        }
        arg1->add("neili", -100);
        arg1->add("jing", -10);
        if (!arg2->is_busy() && !random(3)) {
            arg2->start_busy(2);
        }
        v2 = arg2->query("qi") * 100 / arg2->query("max_qi");
        v4 += "( $n" + eff_status_msg(v2) + " )\n";
        break;
    case "五毒教":
        if (objectp(arg1->query_temp("weapon"))) {
            v4 += "\e[1;33m\n$N将发结解开，披头散发，脸色突然变白，手中的" + v3->name() + "也跟着剧烈抖动着！\n突然$N一声狂嚎，如神哭鬼号似的厉啸响自天地，发疯似的将五毒追魂钩狂乱使出！\n\e" + "[2;37;0m";
            if (arg2->query("qi") > v1 / 2) {
                arg2->receive_wound("qi", v1 / 2);
            }
        } else {
            v4 += "\e[1;31m\n$N一声狞笑飞身纵起，凌空一指向$n的眉心点去。\n\e[2;37;0m";
            if (arg2->query("qi") > v1) {
                arg2->receive_wound("qi", v1);
            }
        }
        arg1->add("neili", -100);
        arg1->add("jing", -10);
        if (!arg2->is_busy() && !random(3)) {
            arg2->start_busy(2);
        }
        v2 = arg2->query("qi") * 100 / arg2->query("max_qi");
        v4 += "( $n" + eff_status_msg(v2) + " )\n";
        break;
    case "唐门":
        if (objectp(arg1->query_temp("weapon"))) {
            v4 += "\e[1;35m\n$N双目突然泛过怪异绿光,中指在不易察觉间微微一动,一点银星悄无声息打向$n眉心。！\n\e[2;37;0m";
            if (arg2->query("qi") > v1 / 2) {
                arg2->receive_wound("qi", v1 / 2);
            }
        } else {
            v4 += "\e[1;35m\n$N突然收掌，然后迅速发掌! 掌中尽然有毒砂，这掌风尽然是五颜六色的！！\n\e[2;37;0m";
            if (arg2->query("qi") > v1) {
                arg2->receive_wound("qi", v1);
            }
        }
        arg1->add("neili", -100);
        arg1->add("jing", -10);
        if (!arg2->is_busy() && !random(3)) {
            arg2->start_busy(2);
        }
        v2 = arg2->query("qi") * 100 / arg2->query("max_qi");
        v4 += "( $n" + eff_status_msg(v2) + " )\n";
        break;
    case "飞天御剑流":
        if (objectp(arg1->query_temp("weapon"))) {
            v4 += "\e[1;35m\n$N使出飞天御剑流的最高剑决的\e[1;31m天翔龙闪\e[1;37m，$n只见$N身形一闪，咽喉已被对穿而过！ \n\e[2;37;0m";
            if (arg2->query("qi") > v1 / 2) {
                arg2->receive_wound("qi", v1 / 2);
            }
        } else {
            v4 += "\e[1;35m\n「三重劲!」$N全身骨骼一阵爆响,拼尽毕生功力使出了喧哗流拳法的终极绝技。\n\e[2;37;0m";
            if (arg2->query("qi") > v1) {
                arg2->receive_wound("qi", v1);
            }
        }
        arg1->add("neili", -100);
        arg1->add("jing", -10);
        if (!arg2->is_busy() && !random(3)) {
            arg2->start_busy(2);
        }
        v2 = arg2->query("qi") * 100 / arg2->query("max_qi");
        v4 += "( $n" + eff_status_msg(v2) + " )\n";
        break;
    default:
        v4 += "\e[1;37m$N使出$n的成名绝技，刹那间一股排山倒海之力击中$n。\n\e[2;37;0m";
        arg1->add("neili", -100);
        arg1->add("jing", -10);
        if (arg2->query("qi") > v1 / 3) {
            arg2->receive_wound("qi", v1 / 3);
        }
        if (!arg2->is_busy() && !random(3)) {
            arg2->start_busy(2);
        }
        v2 = arg2->query("qi") * 100 / arg2->query("max_qi");
        v4 += "( $n" + eff_status_msg(v2) + " )\n";
    }
    message_vision(v4, arg1, arg2);
}
