            v4 += "\e[34m\n突然$N大喝一声：「雷动九天」，面色唰的变得通红，须发皆飞，真气溶入" + v3->name() + "\e" + "[34m当中，“嗡”的一声，发出\e" + "[1;37m闪闪光亮\e" + "[34m！\n\e" + "[2;37;0m";
            arg1->add("neili", -100);
