        message_vision("\e[1;33m只见$N急速挥舞" + v2->name() + "，转出无数个大小圈子，以阴柔之劲缠住对方的" + v1->name() + "！\n\e" + "[2;37;0m", arg1);
        arg2->start_busy(1);
