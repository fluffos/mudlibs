            v1->move(environment(arg1));
            arg2->reset_action();
        } else {
            message_vision("\e[1;33m\n$N暗运巧劲，" + v1->name() + "顺着方向快速旋转数下，解开了" + v2->name() + "的缠绕。\n\e" + "[2;37;0m", arg2);
            arg2->add("neili", -50);
