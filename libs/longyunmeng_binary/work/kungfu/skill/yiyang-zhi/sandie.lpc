int perform(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!arg2) {
        arg2 = offensive_target(arg1);
    }
    if (!arg2 || !arg2->is_character() || !arg1->is_fighting(arg2) || !living(arg2)) {
        return notify_fail("「阳关三叠」只能在战斗中使用。\n");
    }
    if (objectp(arg1->query_temp("weapon"))) {
        return notify_fail("只有空手才能施展「阳关三叠」。\n");
    }
    if (arg1->query_skill("yiyang-zhi", 1) < 100 || arg1->query_str() < 25) {
        return notify_fail("你有的功夫还不够娴熟，不会使用「阳关三叠」。\n");
    }
    if (!arg1->query_skill("kumu-shengong", 1)) {
        if (arg1->query_skill("kumu-shengong", 1) < 320) {
            return notify_fail("以你现在的内功修为还使不出「阳关三叠」。\n");
        }
    }
    if (arg1->query_skill_mapped("force") != "kumu-shengong") {
        return notify_fail("你所使用的内功不对。\n");
    }
    if (arg1->query_skill_mapped("parry") != "yiyang-zhi") {
        return notify_fail("你所使用的招架不对。\n");
    }
    if (arg1->query("neili") < 1200) {
        return notify_fail("你的内力修为太弱，不能使用「阳关三叠」！\n");
    }
    if (arg1->query("neili") < 800) {
        return notify_fail("你的真气不够！\n");
    }
    if (arg1->query("yd_2") && (arg2->query_skill_mapped("force") == "hamagong" || arg2->query_skill_mapped("strike") == "hamagong")) {
        v1 = "\e[33m\n$N背向$n，凝气于指，一式「阳关三叠」反手缓缓点出，纯阳指力直袭$n胸口！\n\e[2;37;0m";
        if (random(arg1->query_skill("force", 1)) > arg2->query_skill("force", 1) / 4) {
            arg1->start_busy(1);
            arg2->start_busy(1);
            v2 = arg1->query_skill("yiyang-zhi", 1);
            v2 = arg1->query_skill("kurong-changong", 1) + v2;
            v2 = random(v2) + 150;
            arg2->receive_damage("qi", v2);
            arg2->receive_wound("qi", v2 / 3);
            arg1->add("neili", -300);
            v3 = arg2->query("qi") * 100 / arg2->query("max_qi");
            v1 += "\e[1;31m$n一见之下，大为失色，发现这似乎正是自己的克星！\n\e[2;37;0m";
            v1 += damage_msg(v2, "内伤");
            v1 += "( $n" + eff_status_msg(v3) + " )\n";
        } else {
            arg1->start_busy(3);
            arg1->add("neili", -200);
            v1 += "\e[1;33m$p见这反手点穴似乎正是蛤蟆功的克星，识得厉害，危及之中一个铁板桥，上身向后一倒，艰难的躲过这一招。\n\e[2;37;0m";
        }
    } else {
        v1 = "\e[33m\n$N凝气于指，一式「阳关三叠」点出，但听得嗤嗤声响，一股纯阳的内力直袭$n胸口！\n\e[2;37;0m";
        if (random(arg1->query_skill("parry")) > arg2->query_skill("parry") / 4) {
            arg1->start_busy(1);
            arg2->start_busy(2);
            v2 = arg1->query_skill("yiyang-zhi", 1);
            v2 = arg1->query_skill("kurong-changong", 1) + v2;
            v2 = v2 + random(v2 / 2);
            arg2->receive_damage("qi", v2);
            arg2->receive_wound("qi", v2 / 3);
            arg1->add("neili", -(v2 / 2));
            v3 = arg2->query("qi") * 100 / arg2->query("max_qi");
            v1 += damage_msg(v2, "内伤");
            v1 += "( $n" + eff_status_msg(v3) + " )\n";
            if (arg1->query_skill("yiyang-zhi", 1) > 150) {
                call_out("perform2", 0, arg1, arg2);
            }
        } else {
            arg1->start_busy(3);
            arg1->add("neili", -100);
            v1 += "\e[1;33m可是$p一个巧云翻身，远远的躲了开去。\n\e[2;37;0m";
        }
    }
    message_vision(v1, arg1, arg2);
    return 1;
}

int perform2(mixed arg1, mixed arg2) {
    mixed v1;
    if (!arg1 || !arg2) {
        return 0;
    }
    if (!living(arg2)) {
        return notify_fail("对手已经不能再战斗了。\n");
    }
    if (arg1->query("neili", 1) < 600) {
        return notify_fail("你待要再出第二指，却发现自己的内力不够了！\n");
    }
    v1 = "\e[33m\n接着$N踏前一步，出第二指隔空点向$n胸前“玉堂穴”，认穴竟无厘毫之差！\n\e[2;37;0m";
    if (random(arg1->query_skill("dodge")) > arg2->query_skill("dodge") / 4) {
        v1 += "\e[1;31m结果一指点中，$n只觉得全身气脉通道阻塞，真气立受干挠！\n\e[2;37;0m";
        arg1->start_busy(1);
        arg2->start_busy(arg1->query_skill("force", 1) / 30);
        arg1->add("neili", -(arg1->query_skill("force", 1) / 2));
        if (arg1->query_skill("yiyang-zhi", 1) > 200) {
            call_out("perform3", 0, arg1, arg2);
        }
    } else {
        arg1->start_busy(3);
        arg1->add("neili", -150);
        arg2->add("neili", -50);
        v1 += "\e[1;33m\n$p眼看逼无可逼，便也一指点去，两根指尖相碰，$p顺势跳了开去。\n\e[2;37;0m";
    }
    message_vision(v1, arg1, arg2);
    return 1;
}

int perform3(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = arg1->query_skill("yiyang-zhi", 1);
    v1 = v1 / 10;
    if (!living(arg2)) {
        return notify_fail("对手已经不能再战斗了。\n");
    }
    if (arg1->query("neili", 1) < 400) {
        return notify_fail("你待要再出第三指，却发现自己的内力不够了！\n");
    }
    v2 = "\e[33m\n紧跟着$N一阳指第三次点出，以纯阳内力，同时透入$n体内任脉紫宫穴、\n阴维脉大横穴、冲脉幽门穴、带脉章门穴和阴跤脉晴明穴！\n\e[2;37;0m";
    if (random(arg1->query_skill("force")) > arg2->query_skill("force") / 4) {
        arg1->add("neili", -200);
        v2 += "\e[1;31m$n只觉体内奇经八脉中内息为之一怠，全身气力竟然提不起来了！\n\e[2;37;0m";
        arg2->add_temp("apply/attack", -100);
        arg2->add_temp("apply/dodge", -100);
        arg2->add_temp("apply/parry", -100);
        arg2->add("neili", -500);
        call_out("back", v1 + 3, arg2);
    } else {
        arg1->start_busy(arg2->query_skill("force", 1) / 30);
        arg1->add("neili", -300);
        arg2->start_busy(2);
        v2 += "\e[1;33m\n$p喘息未定，见$P指力如狂风般点来，连忙又跃开数尺，狼狈地避开。\n\e[2;37;0m";
    }
    message_vision(v2, arg1, arg2);
    return 1;
}

void back(mixed arg) {
    if (!arg) {
        return;
    }
    arg->add_temp("apply/attack", 100);
    arg->add_temp("apply/dodge", 100);
    arg->add_temp("apply/parry", 100);
}
