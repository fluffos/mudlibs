        }
        if (arg1 < 200) {
            return "结果$n被$N以内力反震，「嘿」地一声退了两步。\n";
        }
        if (arg1 < 300) {
            return "结果$n被$N以内力一震，胸口有如受到一记重锤，连退了五六步！\n";
        }
        return "结果$n被$N的内力一震，眼前一黑，身子向后飞出丈许！！\n";
        break;
    case "抓伤":
        if (arg1 < 10) {
            return "结果只是在$n$l处轻轻刮过，没有什么伤害。\n";
        }
        if (arg1 < 25) {
            return "结果$n皱了皱眉，$p的$l已经被拉出了一道浅浅的血痕。\n";
