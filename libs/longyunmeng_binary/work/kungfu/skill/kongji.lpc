            return "结果「唰」地一声，$n的$l上顿时被抓出五道血痕，鲜血流了出来！\n";
        }
        if (arg1 < 200) {
            return "结果$n疼得大叫一声，$p$l上被抓出了几道深深的血沟，鲜血直流！\n";
        }
        if (arg1 < 300) {
            return "结果只听见$n一声惨嚎，$N的手抓已在$p的$l处刺出了五个血肉模糊的窟窿！\n";
        }
        if (arg1 < 400) {
            return "结果「啊」地一声惨叫，$n身上$p处被$N抓下了一大片皮肉，鲜血横飞满地！！\n";
        }
        return "结果伴随着$n一声凄惨的嚎叫，直透$p$l处，连皮带肉扯下一大块，露出了血淋淋的骨头！！\n";
        break;
    default:
        if (!arg2) {
            arg2 = "伤害";
        }
        v1 = "结果造成非常可怕的严重";
        if (arg1 < 230) {
            v1 = "结果造成极其严重的";
        }
        if (arg1 < 170) {
            v1 = "结果造成十分严重的";
        }
        if (arg1 < 120) {
            v1 = "结果造成相当严重的";
        }
        if (arg1 < 80) {
            v1 = "结果造成颇为严重的";
        }
        if (arg1 < 50) {
            v1 = "结果造成一处严重";
        }
        if (arg1 < 30) {
            v1 = "结果造成一处";
        }
        if (arg1 < 20) {
            v1 = "结果造成轻微的";
        }
        if (arg1 < 10) {
            v1 = "结果只是勉强造成一处轻微";
        }
        return v1 + arg2 + "！\n";
    }
}

int valid_enable(mixed arg) {
    return arg == "sword" || arg == "parry";
}

mapping query_action(mixed arg1, mixed arg2) {
    return action[random(sizeof(action))];
}

string query_parry_msg(mixed arg) {
    return parry_msg[random(sizeof(parry_msg))];
}

int valid_learn(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = arg->query("family");
    if (!v2 || v2["family_name"] != "华山派" || v2["master_id"] != "feng qingyang") {
        return notify_fail("独孤九剑只有向风清扬老前辈学习。\n");
    }
    if (arg->query("max_neili") < 600) {
        return notify_fail("你的内力不够，没有办法练独孤九剑。\n");
    }
    if (arg->query_skill("zixia-shengong", 1) < 100) {
        return notify_fail("独孤九剑必须配合紫霞神功才能练习。\n");
    }
    if (!(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("你必须先找一把剑才能练剑法。\n");
    }
    if (arg->query_skill("lonely-sword", 1) > 120) {
        return notify_fail("这套剑法我就教到这儿，以后就要靠你自己练了。\n");
    }
    return 1;
}

int practice_skill(mixed arg) {
    return notify_fail("独孤九剑只能通过" + order[random(13)] + "「总诀式」\e" + "[2;37;0m来演练。\n");
}

int valid_effect(mixed arg1, mixed arg2, mixed arg3, mixed arg4) {
}

