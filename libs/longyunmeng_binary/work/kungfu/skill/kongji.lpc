string eff_status_msg(mixed arg) {
    if (arg >= 100) {
        return "\e[1;32m看起来充满活力，一点也不累。\e[2;37;0m";
    }
    if (arg > 90) {
        return "\e[1;32m似乎有些疲惫，但是仍然十分有活力。\e[2;37;0m";
    }
    if (arg > 80) {
        return "\e[1;33m看起来可能有些累了。\e[2;37;0m";
    }
    if (arg > 75) {
        return "\e[1;33m看起来可能受了点轻伤。\e[2;37;0m";
    }
    if (arg > 70) {
        return "\e[1;33m动作似乎开始有点不太灵光，但是仍然有条不紊。\e[2;37;0m";
    }
    if (arg > 65) {
        return "\e[1;33m受了几处伤，不过似乎并不碍事。\e[2;37;0m";
    }
    if (arg > 60) {
        return "\e[1;33m受伤不轻，看起来状况并不太好。\e[2;37;0m";
    }
    if (arg > 50) {
        return "\e[1;33m气喘嘘嘘，看起来状况并不太好。\e[2;37;0m";
    }
    if (arg > 45) {
        return "\e[1;31m气息粗重，动作开始散乱，看来所受的伤着实不轻。\e[2;37;0m";
    }
    if (arg > 40) {
        return "\e[1;31m似乎十分疲惫，看来需要好好休息了。\e[2;37;0m";
    }
    if (arg > 35) {
        return "\e[1;31m已经伤痕累累，正在勉力支撑着不倒下去。\e[2;37;0m";
    }
    if (arg > 30) {
        return "\e[1;31m已经一副头重脚轻的模样，正在勉力支撑着不倒下去。\e[2;37;0m";
    }
    if (arg > 25) {
        return "\e[1;31m受了相当重的伤，只怕会有生命危险。\e[2;37;0m";
    }
    if (arg > 20) {
        return "\e[1;31m看起来已经力不从心了。\e[2;37;0m";
    }
    if (arg > 15) {
        return "\e[31m伤重之下已经难以支撑，眼看就要倒在地上。\e[2;37;0m";
    }
    if (arg > 10) {
        return "\e[31m摇头晃脑、歪歪斜斜地站都站不稳，眼看就要倒在地上。\e[2;37;0m";
    }
    if (arg > 5) {
        return "\e[31m受伤过重，已经奄奄一息，命在旦夕了。\e[2;37;0m";
    }
    if (arg > 0) {
        return "\e[31m已经陷入半昏迷状态，随时都可能摔倒晕去。\e[2;37;0m";
    }
    return "\e[31m受伤过重，已经有如风中残烛，随时都可能断气。\e[2;37;0m";
}

string damage_msg(mixed arg1, mixed arg2) {
    mixed v1;
    if (!arg1) {
        return "结果没有造成任何伤害。\n";
    }
    switch (arg2) {
    case "割伤":
    case "擦伤":
        if (arg1 < 10) {
            return "结果只是轻轻地划破$p的皮肉。\n";
        }
        if (arg1 < 50) {
            return "结果在$p$l划出一道细长的血痕。\n";
        }
        if (arg1 < 100) {
            return "结果「嗤」地一声，在$n身上划出一道伤口！\n";
        }
        if (arg1 < 170) {
            return "结果「嗤」地一声，在$n身上划出一道血淋淋的伤口！\n";
        }
        if (arg1 < 280) {
            return "结果「嗤」地一声，在$n身上划出一道又长又深的伤口，溅得$N满脸鲜血！\n";
        }
        return "结果只听见$n一声惨嚎，$w已在$p$l划出一道深及见骨的可怕伤口！！\n";
        break;
    case "刺伤":
        if (arg1 < 10) {
            return "结果只是轻轻地刺破$n的皮肉。\n";
        }
        if (arg1 < 50) {
            return "结果在$n$l刺出一个创口。\n";
        }
        if (arg1 < 100) {
            return "结果「噗」地一声刺入了$n$l寸许！\n";
        }
        if (arg1 < 170) {
            return "结果「噗」地一声刺进$n的$l，使$p不由自主地退了几步！\n";
        }
        if (arg1 < 280) {
            return "结果「噗嗤」地一声，$w已在$n$l刺出一个血肉模糊的血窟窿！\n";
        }
        return "结果只听见$n一声惨嚎，$w已在$p的$l对穿而出，鲜血溅得满地！！\n";
        break;
    case "砸伤":
        if (arg1 < 20) {
            return "结果只是轻轻地碰撞到了$n一下，没有造成什么伤害。\n";
        }
        if (arg1 < 60) {
            return "结果$w只将$n的$l砸出一块瘀红。\n";
        }
        if (arg1 < 120) {
            return "结果「啪」地一声，$w打中$n的$l，登时肿了一块老高！\n";
        }
        if (arg1 < 240) {
            return "结果$w重重得击中$n的$l，打得$p倒退数步，「哇」地吐出一大口鲜血！\n";
        }
        if (arg1 < 380) {
            return "结果只听见「硼」地一声巨响，$w打在$n身上，将$p像一捆稻草般击飞出去！\n";
        }
        return "只见$w重重地撞击在$n的身上，几声骨碎声中，$p象散了架似的瘫了下去！！\n";
        break;
    case "瘀伤":
        if (arg1 < 10) {
            return "结果只是轻轻地碰到，比拍苍蝇稍微重了点。\n";
        }
        if (arg1 < 20) {
            return "结果在$p的$l造成一处瘀青。\n";
        }
        if (arg1 < 40) {
            return "结果一击命中，$n的$l登时肿了一块老高！\n";
        }
        if (arg1 < 80) {
            return "结果一击命中，$n闷哼了一声显然吃了不小的亏！\n";
        }
        if (arg1 < 120) {
            return "结果「砰」地一声，$n退了两步！\n";
        }
        if (arg1 < 200) {
            return "结果这一下「砰」地一声打得$n连退了好几步，差一点摔倒！\n";
        }
        if (arg1 < 300) {
            return "结果重重地击中，$n「哇」地一声吐出一口鲜血！\n";
        }
        if (arg1 < 400) {
            return "结果只听见「砰」地一声巨响，$n像一捆稻草般飞了出去！！\n";
        }
        return "只听见$n一声惨叫，整个身体象断了线的风筝一样飞了出去！！\n";
        break;
    case "内伤":
        if (arg1 < 10) {
            return "结果只是把$n打得退了半步，毫发无损。\n";
        }
        if (arg1 < 20) {
            return "结果$n痛哼一声，在$p的$l造成一处瘀伤。\n";
        }
        if (arg1 < 50) {
            return "结果一击命中，把$n打得痛得弯下腰去！\n";
        }
        if (arg1 < 100) {
            return "结果$n闷哼了一声，脸上一阵青一阵白，显然受了点内伤！\n";
        }
        if (arg1 < 200) {
            return "结果$n脸色一下变得惨白，昏昏沉沉接连退了好几步！\n";
        }
        if (arg1 < 300) {
            return "结果重重地击中，$n「哇」地一声吐出一口鲜血！\n";
        }
        if (arg1 < 400) {
            return "结果「轰」地一声，$n全身气血倒流，口中鲜血狂喷而出！\n";
        }
        return "结果只听见几声喀喀轻响，$n一声惨叫，像滩软泥般塌了下去！！\n";
        break;
    case "震伤":
        if (arg1 < 100) {
