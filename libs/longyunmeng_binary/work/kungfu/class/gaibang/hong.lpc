void attempt_apprentice(mixed arg) {
    if (arg->query_str() < 20 || arg->query_con() < 25) {
        command("say 当叫化子需要能吃苦耐劳，依我看" + "/adm/daemons/rankd"->query_respect(arg) + "的资质似乎不适合当叫化子？");
        return;
    }
    if (mapp(arg->query("family")) && arg->query("family/family_name") != "丐帮") {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "既然已有名师指点，何必又来拜老叫化呢？");
        return;
    }
    command("recruit " + arg->query("id"));
    if (arg->query("class") != "beggar") {
        arg->set("class", "beggar");
    }
}

int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = this_object();
    if (arg2->query("food_supply") <= 0) {
        return 0;
    }
    if (arg2->query("name") != "叫化鸡") {
        command("say 老叫化对" + arg2->query("name") + "没什么兴趣……");
        return 0;
    }
    if (query("food") >= max_food_capacity() - arg2->query("food_supply")) {
        command("say 老叫化现在饱得很。");
        return 0;
    }
    command("say 啊……这正是我想吃的叫化鸡呀！");
    command("eat ji");
    command("say 想不到你小小年纪，心思却很细，就跟当年的蓉儿一样！");
    if (arg2->query("family/family_name") != "" && arg2->query("family/family_name") != "丐帮") {
        command("say " + "/adm/daemons/rankd"->query_respect(arg2) + "你还呆在这里干什么？");
        return 1;
    }
    if (v1 = present("yuzhu_zhang", v2)) {
        v1->move(arg1);
        write("这根竹杖跟随我多年了，就送给你作见面礼吧。");
        return 1;
    } else {
        write("不过你来得不是时候，玉竹杖已经给别人了。");
        return 1;
    }
    return 1;
}
