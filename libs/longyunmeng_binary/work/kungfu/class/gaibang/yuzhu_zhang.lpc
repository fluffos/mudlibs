// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// bamboo_club.c
#include <ansi.h>
#include <weapon.h>
inherit CLUB;
void create()
{
    set_name("玉竹杖", ({"yuzhu zhang", "zhu", "club"}));
    set_weight(5000);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "根");
        set("long", "一根泛着淡淡青光的竹杖。\n");
        set("value", 10000);
        set("material", "bamboo");
        set("wield_msg", "$N抽出一根青光闪闪的竹杖抓在手中。\n");
        set("unwield_msg", "$N把手中的玉竹杖插回腰中。\n");
    }
    init_club(30);
    setup();
}   
int query_autoload() { return 1; }	
