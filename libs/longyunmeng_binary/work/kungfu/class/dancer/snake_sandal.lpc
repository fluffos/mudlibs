// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// snake_sandal.c
#include <armor.h>
#include <ansi.h>
inherit BOOTS;
void create()
{
       set_name( RED "穿花蛇影鞋" NOR, ({ "snake sandals", "sandals" }) );
    set_weight(1000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
                set("unit", "双");
        set("value", 8000);
        set("material", "cloth");
                set("armor_type", "boots");
        set("armor_prop/armor", 2);
        set("armor_prop/dodge", 2);
    }
}
