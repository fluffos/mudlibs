    arg2 = replace_string(arg2, "吗", "");
    arg2 = replace_string(arg2, "耶", "");
    arg2 = replace_string(arg2, "吧", "");
    if (arg2 != "") {
        add("memory/" + arg1, ({ arg2 }));
        return 1;
    } else {
        return 0;
    }
}

