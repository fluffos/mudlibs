        }
        if (sscanf(arg1, "%*s摸", arg1) == 2) {
            arg1 = "摸" + arg1;
        }
        switch (random(20)) {
        case 4:
            command("chat* cry\n");
            break;
        case 6:
            command("chat 非礼啊非礼！" + arg2 + "这小流氓又来啦！\n");
            break;
