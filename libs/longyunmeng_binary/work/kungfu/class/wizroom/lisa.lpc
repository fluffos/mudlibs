int ask_husband() {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (v2->query("id") == "wenwu") {
        command("xixi wenwu");
        tell_room(environment(v2), "冰雁轻轻偎进老公" + Husband_name + "的怀里！ \n", ({ v2 }));
        tell_object(v2, "冰雁轻轻偎进你的怀里，在你耳边轻声的说：龙，好想你呀！\n");
        command("kiss wenwu");
        return 1;
    }
    if (v1 = present("wenwu", environment())) {
        command("xixi wenwu");
        message_vision("冰雁深情的望了老公" + Husband_name + "一眼，轻轻一笑：他是我老公呀，你找他有事儿吗？\n", v2);
        return 1;
    } else {
        command(":(");
        command("sigh");
        message_vision("冰雁目光一暗，低下了头：他是我老公呀，好些天没见到他了，好想他呀。\n", v2);
        return 1;
    }
}

