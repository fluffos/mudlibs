void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (!userp(arg)) {
        return;
    }
    message_vision("$N对$n嫣然一笑.\n\n", this_object(), arg);
    if (this_object()->query("startroom") == base_name(environment())) {
        if (arg->query("id") == "wenwu") {
            Husband_name = arg->query("name");
            set("nickname", "\e[35m" + arg->query("name") + "的妻子" + "\e" + "[2;37;0m");
            command("say 龙，你回来了呀，人家好想你的。");
            command("say 龙，带我出去玩会儿吧，一个人，好无聊耶！");
            command("follow wenwu");
        } else {
            command("say 这位" + "/adm/daemons/rankd"->query_respect(arg) + "，何缘来到小女子房中？\n");
        }
    }
    if (this_object()->query("startroom") != base_name(environment())) {
        if (arg->query("id") == "wenwu") {
            if (this_object()->query_leader() != arg) {
                command("say 龙，人家找你好久了，终于看见你了，好想你哦！走，我们回家吧！：）");
                command("follow wenwu");
            }
            Husband_name = arg->query("name");
            set("nickname", "\e[35m" + arg->query("name") + "的妻子" + "\e" + "[2;37;0m");
        } else if (!present("wenwu", environment())) {
            command("say 这位" + "/adm/daemons/rankd"->query_respect(arg) + "，你可曾见我相公么？\n");
        }
    }
}

