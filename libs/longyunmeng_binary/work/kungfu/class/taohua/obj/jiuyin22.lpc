// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ITEM;
inherit F_UNIQUE;
 
void create()
{
        set_name("「九阴真经」下册", ({ "jiuyin zhenjing2","zhenjing2", }));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
             set("long",
         "这是一本用薄绢写成的书。上书：九阴真经  下”。\n"
        "笔法清秀脱俗，看来出于女子手笔。\n",
        );
                set("value", 0);
                set("material", "silk");
                set("skill", ([
                        "name":       "jiuyin-baiguzhao",
                        "exp_required": 0,
                        "jing_cost":  30,
                        "difficulty": 20,
                        "max_skill":  100
                ]) );
        }
}
