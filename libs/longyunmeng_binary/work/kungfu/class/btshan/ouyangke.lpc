    mixed v1;
    if (!arg1 || environment(arg1) != environment()) {
        return 0;
    }
    if (!objectp(arg2)) {
        return 0;
    }
    if (!present(arg2, arg1)) {
        say("你没有这件东西。\n");
        return 0;
    }
    if (arg2->query("gender") != "女性") {
        say("欧阳克不需要这件东西。\n");
        return 0;
    }
    if (arg2->query("age") < 18) {
        say("欧阳克大惊失色道：未成年少女我怎敢要！\n");
        return 0;
    }
    if (arg2->query("age") > 40) {
        say("欧阳克轻蔑地一笑道：这种老古董还是留给你自己吧！\n");
        return 0;
    }
    if (base_name(environment()) == "/d/city/lichunyuan") {
        say("欧阳克嘿嘿一笑：刚......你不是想我精尽人亡吧？\n");
        return 0;
    }
    v1 = clone_object("/clone/money/silver");
    v1->set_amount(30);
    v1->move(arg1);
    message_vision("欧阳克一把把" + arg2->query("name") + "揽在怀里，对$N说这点银子是你的辛苦费，\n              咱回头见。\n说完，就携着" + arg2->query("name") + "往丽春院奔去...\n", arg1);
    move("/d/city/lichunyuan");
