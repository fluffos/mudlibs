void greeting(mixed arg) {
    if (!arg || environment(arg) != environment() || is_fighting()) {
        return;
    }
    if (arg->query("gender") == "女性") {
        switch (random(3)) {
        case 0:
            command("rose " + arg->query("id"));
            break;
        case 1:
            command("kiss " + arg->query("id"));
            break;
        case 2:
            command("love " + arg->query("id"));
            break;
        }
    } else {
        say("欧阳克叹了一口气说：这位" + "/adm/daemons/rankd"->query_respect(arg) + ",你要是能给我弄一个女人来就好了。\n");
    }
    return;
}

void attempt_apprentice(mixed arg) {
    if (arg->query("family/family_name") == "白驼山派") {
        if (arg->query("combat_exp") < 10000) {
            command("say 你的经验太低，我还不能收你。继续努力吧。\n");
        } else {
            command("say 你跟着我要好好学。\n");
            command("recruit " + arg->query("id"));
        }
        return;
    }
    if (arg->query("gender") == "女性") {
        message_vision("欧阳克动情地说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "真乃我的红颜知己，\n我现在还不能收你，只能送你上白驼山。\n", arg);
    } else {
        message_vision("欧阳克笑笑说：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，我现在还不能收你，只能送你上白驼山。\n", arg);
    }
    write("\e[1;33m只见欧阳克把纸扇往你眼前一晃，\n\n     你觉得眼前一闪，身体轻飘飘地飞了出去￣￣\n\e[2;37;0m");
    arg->move("/d/baituo/liangong.lpc");
}

int accept_fight(mixed arg) {
    if (arg->query("gender") == "女性") {
        message_vision("欧阳克摆摆手说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，我怎能欺负女孩子呢！\n", arg);
        return 0;
    }
    if (arg->query("family/family_name") == "白驼山派") {
        if (arg->query("combat_exp") < 100000) {
            return notify_fail("欧阳克笑道：你的经验太低了,再练几年吧。！\n");
        }
    }
    message_vision("欧阳克一拱手说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，在下领教了。\n", arg);
    return 1;
}

