// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// poison.c
#include <condition.h>
int update_condition(object me, mapping info)
{
    if( !mapp(info) ) return 0;
    me->receive_damage("qi", info["damage"]);
    me->receive_wound("qi", info["damage"] / 2);
    info["duration"] --;
    me->apply_condition("snake_poison", info);
    tell_object(me, info["message"] );
    if( info["duration"] < 1 ) return 0;
    return CND_CONTINUE;
}
