// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// scorpion_poison.c

#include <ansi.h>

int update_condition(object me, int duration)
{
    me->receive_wound("jing", 10);
//    me->receive_wound("kee", 10);
//    me->receive_damage("sen", 10);
    me->receive_damage("qi", 10);
    me->apply_condition("scorpion_poison", duration - 1);
    tell_object(me, HIG "你感到呼吸困难，四肢渐渐肿了起来。\n" NOR );
        if( duration < 1 ) return 0;
        return 1;
}

