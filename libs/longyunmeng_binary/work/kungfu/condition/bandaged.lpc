// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// bandaged.c
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
    if( (int)me->query("eff_qi") < (int)me->query("max_qi") )
        me->receive_curing("qi", 3);
    
    me->apply_condition("bandaged", duration - 1);
    if( !duration ) return 0;
    return CND_CONTINUE;
}
