int update_condition(mixed, mixed);

int update_condition(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg2 < 1) {
        tell_object(arg1, "官府不再通缉你了！\n");
        return 0;
    }
    if (environment(arg1)->query("no_fight") && !arg1->query_temp("diable_inputs")) {
        v1 = random(30);
        arg1->receive_damage("jing", arg1->query("max_jing") / 10);
        arg1->receive_damage("qi", arg1->query("max_qi") / 10);
        arg1->receive_wound("jing", arg1->query("max_jing") / 20);
