// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// seller.c

inherit NPC;

void create()
{
	set_name("挑夫", ({ "tiao fu", "porter" }) );
	set("gender", "男性" );
	set("age", 28);
	set("long",
		"这是个老实巴交的穷挑夫，长得膀阔腰圆，一身肌肉。\n");
//	set("shen_type", 1);
	set("combat_exp", 1000);
        set("str", 25);
        set("dex", 22);
        set("con", 20);
        set("int", 15);
	set("attitude", "heroism");

	setup();
        carry_object("clone/misc/cloth")->wear();

}

