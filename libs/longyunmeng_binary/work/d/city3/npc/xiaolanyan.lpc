// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// bye enter

inherit NPC;

void create()
{
        set_name("小烂眼", ({ "xiao lanyan", "xiao" }));
        set("gender", "男性");
        set("age", 19);
        set("long", "这是个流里流气的小烂眼，满口四川土话。\n");
        
        set("combat_exp", 1000);
        set("shen_type", -1);

        set("attitude", "peaceful");
        
        set_skill("unarmed", 20);
        set_skill("dodge", 20);
        set_temp("apply/attack", 10);
        set_temp("apply/defense", 10);

        setup();
        carry_object("/clone/misc/cloth")->wear();
        add_money("silver",2);
}

