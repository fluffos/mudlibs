// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// poorman.c

inherit NPC;

void create()
{
        set_name("壮汉", ({ "zhuang han","han"}) );
        set("gender", "男性" );
        set("age", 33);
        set("long", "一个体格强壮的汉子。\n");
        set("attitude", "friendly");
        set("combat_exp", 750);
//	set("shen", 50);
	set("shen_type", 1);
        set("str", 20);
        set("dex", 18);
        set("con", 17);
        set("int", 13);
        setup();
        set("chat_chance", 15);
        set("chat_msg", ({
"壮汉伸手打了个哈哈。\n",
"壮汉伸手捉住了身上的虱子，骂道：老子身上没几两肉，全叫你们给咬了。 \n",
                (: random_move :)
        }) );
        carry_object(__DIR__"obj/cloth")->wear();
}

