// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// cai by -wyz
inherit ITEM;
inherit F_FOOD;
void create()
{
        set_name( "竹筒雞", ({"ji"}));
        set_weight(200);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", HIW "这是一碟香喷喷的云南名菜。\n" NOR);
                set("unit", "碟");
                set("value", 150);
                set("food_remaining", 3);
                set("food_supply", 60);
                set("eat_msg", "$N小心翼翼拨开竹片夹起一块$n，想也不想的塞进嘴里。\n");
        }
}

