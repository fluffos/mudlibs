// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// cai by -wyz
inherit ITEM;
inherit F_FOOD;
void create()
{
        set_name( "魚香肉絲", ({"silk"}));
        set_weight(200);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", WHT "这是一碟香喷喷的四川名菜。\n" NOR);
                set("unit", "碟");
                set("value", 150);
                set("food_remaining", 3);
                set("food_supply", 60);
                set("eat_msg", "$N夹起一簇$n，闭起眼睛，轻咬一口，只觉香味在两只鼻孔间窜来窜去。\n");
        }
}

