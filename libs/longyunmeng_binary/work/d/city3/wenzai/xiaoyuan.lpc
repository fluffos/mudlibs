inherit ROOM;

void create()
{
        set("short", "小院子");
	set("long", @LONG
这里是个小院子，打扫得甚为整洁，旁边有棵大树，院子内
放了一些扫把等杂物。往北是个不大的客厅。
LONG
	);

        set("outdoors","chengdu");
