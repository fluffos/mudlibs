int do_jump(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "liang") {
        if (v1->query_temp("marks/跳1")) {
            if (v1->query_dex() < 20) {
                write("你试图跳上房梁，无奈身法不够敏捷，只好做罢。\n");
            } else {
                write("你纵身跃上了房梁。\n");
                message("vision", v1->name() + "一纵身跃上了房梁。\n", environment(v1), ({ v1 }));
                v1->move("/d/quanzhou/liang");
                message("vision", v1->name() + "从下面跃了上来。\n", environment(v1), ({ v1 }));
            }
            return 1;
        }
