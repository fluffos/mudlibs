inherit "/inherit/room/room";
int do_break(mixed);
void create();
void init();
void close(mixed);
void buqun_rob(mixed, mixed);

void create() {
    set("short", "向阳老宅");
    set("long", "这里是福威镖局总镖头林震南在福建的旧居。室内的家具横七竖八地\n倒在地上。房间的一角结着一张蜘蛛网，屋里到处是尘土，显然是已经很\n久没有人住了。房间的尽头有一扇门(men)，但已被坍塌的砖瓦挡住了。\n");
    set("exits", ([ "south" : "/d/quanzhou/xijie" ]));
    set("item_desc", ([ "men" : "这扇门已被挡住无法通行，除非你打破(break)它。\n" ]));
    setup();
}

void init() {
    mixed v1;
    mixed v2;
    v2 = this_player();
    add_action("do_break", "break");
    if (objectp(v1 = present("kuihua baodian", v2))) {
        remove_call_out("buqun_rob");
        call_out("buqun_rob", 1, v2, v1);
    }
}

int do_break(mixed arg) {
    mixed v1;
    v1 = this_player()->query("neili");
    if (!arg || arg != "men") {
        write("不要随便打碎别人的东西！\n");
        return 1;
    }
    message_vision("$N走到后门前，拜出骑马蹲裆式，深吸一口气，双掌同时拍出。\n", this_player());
    if (v1 >= 200) {
        message_vision("$N只听一声轰响，$N把门震开了！\n", this_player());
        set("exits/north", "/d/quanzhou/houyuan");
        this_player()->set("neili", v1 - 200);
        remove_call_out("close");
        call_out("close", 5, this_object());
    } else {
        message_vision("$N大吼一声“开！”，结果什么也没发生。看来$N的内力不够强。\n", this_player());
        this_player()->set("neili", 0);
    }
    return 1;
}

void close(mixed arg) {
    message("vision", "门上的砖头瓦块稀里哗拉坍塌下来，又挡住了后门。\n", arg);
    arg->delete("exits/north");
}

void buqun_rob(mixed arg1, mixed arg2) {
    message_vision("\e[1;33m忽然，一个蒙面人从黑影里闪了出来，一招「有凤来仪」，手中长剑闪烁\n不定，刺向$N的咽喉！\n\e[2;37;0m", arg1);
    if (!arg1->query_skill("pixie-jian", 1)) {
        message_vision("$N一愣之间，已被蒙面人刺中！\n", arg1);
        arg2->move(environment(arg1));
        destruct(arg2);
        arg1->unconcious();
    } else {
        message_vision("$N身形飘忽，有如鬼魅，转了几转，移步到蒙面人的身后，躲过了蒙面人这一招。\n", arg1);
    }
    write("蒙面人双足点地，越墙而走。\n你感觉蒙面人的身法好像是华山派的。\n");
}
