    add_action("do_du", "du");
    add_action("do_du", "study");
    add_action("do_join", "join");
}

void create() {
    set_name("葵花宝典", ({ "kuihua baodian", "baodian", "book" }));
    set_weight(600);
    if (clonep()) {
        set_default_object("/d/quanzhou/npc/obj/kuihua.lpc");
    } else {
        set("unit", "本");
        set("long", "这就是武林第一秘籍《葵花宝典》，相传是一位宫中太监所作。\n");
        set("value", 50000);
        set("material", "paper");
        set("no_drop", "这样东西不能离开你。\n");
        set("no_get", "这样东西不能离开那儿。\n");
    }
}

int do_du(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v5;
    mixed v6;
    v1 = this_player();
    v2 = environment(v1);
    if (!(arg == "kuihua baodian" || arg == "baodian" || arg == "book")) {
        return 0;
    }
    if (v2->query("pigging")) {
        write("你还是专心拱猪吧！\n");
        return 1;
    }
    if (v1->is_busy()) {
        write("你现在正忙着呢。\n");
        return 1;
    }
    if (v1->is_fighting()) {
        write("你无法在战斗中专心下来研读新知！\n");
        return 1;
    }
    if (!id(arg)) {
        write("你要读什么？\n");
        return 1;
    }
    if (v1->query("gender") == "女性") {
        write("自古没有女人可以读《葵花宝典》的。\n");
        return 1;
    }
    if (v1->query("gender") == "男性") {
        write("《葵花宝典》的第一页写着：欲练神功，必先自宫。\n");
        return 1;
    }
    if (!v1->query_skill("literate", 1)) {
        write("你是个文盲，先学点文化(literate)吧。\n");
        return 1;
    }
    switch (random(3)) {
    case 0:
        message("vision", v1->name() + "偷偷摸摸翻出一本书在读。\n", environment(v1), v1);
        break;
    case 1:
        message("vision", v1->name() + "边读书边骚首弄姿，好象在模仿女人。\n", environment(v1), v1);
        break;
    case 2:
        message("vision", v1->name() + "边读书边把腰身扭来扭去。\n", environment(v1), v1);
        break;
    }
    if (v1->query("jing") < 15) {
        write("你现在过于疲倦，无法专心下来研读新知。\n");
        return 1;
    }
    if (v1->query_skill("pixie-jian", 1) > 84) {
        v6 = 15;
    } else if (v1->query_skill("pixie-jian", 1) > 74) {
        v6 = 10;
    } else {
        v6 = 5;
    }
    if (v1->query("neili") < v6) {
        write("你内力不够，无法钻研这么高深的武功。\n");
        return 1;
    }
    v5 = v1->query_skill("pixie-jian", 1);
    if (v1->query("combat_exp") < v5 * v5 * v5 / 10) {
        write("你的实战经验不足，再怎么读也没用。\n");
        return 1;
    }
    if (v1->query_skill("pixie-jian", 1) > 9) {
        if (!objectp(v3 = present("golden ring", v1)) || !v3->query("equipped")) {
            write("你没戴戒指，感到很难理解阴柔的指法。\n");
            return 1;
        }
    }
    if (v1->query_skill("pixie-jian", 1) > 19) {
        if (!objectp(v3 = present("flower shoes", v1)) || !v3->query("equipped")) {
            write("你没穿绣花鞋，感到很难理解阴柔的步法。\n");
            return 1;
        }
    }
    if (v1->query_skill("pixie-jian", 1) > 29) {
        if (!objectp(v3 = present("xiuhua zhen", v1)) || !v3->query("equipped")) {
            write("你没用绣花针，感到无法理解这种阴柔灵活的武功。\n");
            return 1;
        }
    }
    if (v1->query_skill("pixie-jian", 1) > 39) {
        if (!objectp(v3 = present("pink cloth", v1)) || !v3->query("equipped")) {
            write("你没穿女人的衣衫，感到很难理解阴柔的身法。\n");
            return 1;
        }
    }
    if (v1->query_skill("pixie-jian", 1) > 49) {
        if (!objectp(v3 = present("golden necklace", v1)) || !v3->query("equipped")) {
            write("你没戴项链，觉得练这种阴柔的功夫缺乏自信。\n");
            return 1;
        }
    }
    if (v1->query_skill("pixie-jian", 1) > 59) {
        if (v1->query("rank_info/respect") != "公公") {
            write("你现在需要正式加入(join)东厂才能继续深造辟邪剑法。\n");
            write("键入join你便成为东厂的一位太监。这将不影响你的师承，\n");
            write("而且大家都将尊称你为公公。\n");
            v1->set_temp("pending/join", 1);
            return 1;
        }
    }
    if (v1->query_skill("pixie-jian", 1) > 99) {
        write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
        return 1;
    }
    v1->receive_damage("jing", 15);
    v1->set("neili", v1->query("neili") - v6);
    if (!v1->query_skill("pixie-jian", 1)) {
        v1->set_skill("pixie-jian", 0);
        write("                   《葵花宝典》阅读指南\n\n    恭喜你开始研习武林第一功夫－－－－辟邪剑法！\n注意事项：\n一．研习辟邪剑法必先自宫，如你不想让别人发现这个天大的秘密，你必须\n    找一无人所在之处阅读，且当有别的玩家在场时不要使用辟邪剑法战斗，\n    因为当你阅读或使用辟邪剑法时会出现一些阴柔的举动，使别人产生怀\n    疑。切记不可收徒或拜别的玩家为师，以免被人检查你的技能。\n\n二．辟邪剑法功力极强，既可作剑法，又可作腾挪之法。\n\n三．《葵花宝典》不可送人，出售，丢弃，捡拾，唯一的获取方法是你使用\n    你得到的密码去密室寻找。\n\n四．辟邪剑法不可通过拜师或自己锻炼来长进，只能通过研习《葵花宝典》\n    来提高。\n\n         祝你早日成为武林第一高手，称霸天下！\n");
    }
    v1->improve_skill("pixie-jian", v1->query_skill("literate", 1) / 3 + 1);
    write("你研读《葵花宝典》，颇有心得。\n");
    return 1;
