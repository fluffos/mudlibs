// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#include <ansi.h>
#include <weapon.h>

//inherit COMBINED_ITEM;
inherit THROWING;

void create()
{
	set_name("石子", ({ "shizi", "shi" }));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一堆普普通通的碎石子。\n");               
		set("unit", "堆");
		set("value", 1);
		set("base_value", 0);
		set("base_unit", "颗");
		set("base_weight", 12);
	}
	set_amount(random(70) + 81);
	init_throwing(15);
}

