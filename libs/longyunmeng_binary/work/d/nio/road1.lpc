// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// Room: /u/jpei/thd/road1.c

inherit ROOM;

void create()
{
	set("short", "土路");
	set("long", @LONG
一条郊外的土路，远处似乎有座村落。
LONG
	);
	set("no_clean_up", 0);
	set("outdoors","nio");

	set("exits", ([
		"north": __DIR__"road.lpc",
		"southeast": __DIR__"road2.lpc",
	]) );

	setup();
	replace_program(ROOM);
}

