// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// Room: /u/jpei/thd/njroad1.c

inherit ROOM;

void create()
{
	set("short", "村中小路");
	set("long", @LONG
一条村中的小路。路边是一家破旧的小酒店，好象已经很久没人来过了的
样子。
LONG
	);
	set("no_clean_up", 0);
	set("outdoors","nio");

	set("exits", ([
		"west": __DIR__"njwest.lpc",
		"east": __DIR__"njroad2.lpc",
		"south": __DIR__"xiaodian.lpc",
	]) );

	setup();
	replace_program(ROOM);
}

