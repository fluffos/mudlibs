int accept_object(mixed arg1, mixed arg2) {
    if (!arg2->query("money_id")) {
        return 0;
    }
    if (arg2->value() < 1000000) {
        if (arg1->query_temp("is_applying_house")) {
            command("say " + "/adm/daemons/rankd"->query_respect(arg1) + "出手这么大方。府上保准富丽堂皇。\n");
        } else {
            command("say " + "/adm/daemons/rankd"->query_respect(arg1) + "这么客气，我这就给您办。\n");
