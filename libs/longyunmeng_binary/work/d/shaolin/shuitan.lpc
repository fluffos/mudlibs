}

void init() {
    add_action("do_ketou", "ketou");
    this_player()->set_temp("shui", 0);
    add_action("do_daoshui", "daoshui");
}

int do_ketou(mixed arg) {
    mixed v1;
    message_vision("$N虔诚地跪下来，给佛像磕了一个头。\n", this_player());
    v1 = clone_object("d/shaolin/obj/tong");
    v1->move("/d/shaolin/shuitan");
    if (this_player()->query_skill("dodge", 1) >= 30 && this_player()->query_skill("dodge", 1) <= 100) {
        return notify_fail("冥冥之中，你似乎觉得佛祖在点拨你在轻功方面的疑难。\n");
    }
}

int do_daoshui(mixed arg) {
