        tell_object(arg1, "你考虑清楚了就请作出决定吧。(decide)\n");
        arg1->set_temp("fee_paid", 1);
        return 1;
    } else if (arg2->query("money_id") && arg2->value() < 1000000) {
        tell_object(arg1, "赵六嘿嘿一笑，说道：给我这麽多钱？ 将来我可没法还你啊。\n");
        return 1;
