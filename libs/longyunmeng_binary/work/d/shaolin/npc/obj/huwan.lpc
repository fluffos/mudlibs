// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// huwan.c
#include <ansi.h>
#include <armor.h>
inherit WRISTS;
void create()
{
    set_name( "铁护腕", ({ "hu wan", "huwan" }) );
    set_weight(500);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "双");
                set("long", "这是一件皮质的护腕，上面满布铁钉，用以保护腕部。\n");
        set("value", 6000);
            set("shaolin",1);
        set("material", "wrists");
        set("armor_prop/armor", 5);
        set("shaolin",1);
    }
    setup();
}
int query_autoload() { return 1; }
