// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// jiedao.c
#include <weapon.h>
inherit BLADE;
void create()
{
    set_name("戒刀", ({ "jie dao", "dao", "blade" }) );
    set_weight(4000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "把");
        set("value", 500);
         set("flag",2);
        set("material", "iron");
        set("long", "这是一柄尺半长的戒刀，刀光闪闪，入手沉重，似是精铁打成。\n");
        set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
        set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
    }
    init_blade(25,2);
    setup();
}
int query_autoload() { return 1; }