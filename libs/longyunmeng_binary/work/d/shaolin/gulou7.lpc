void create() {
    set("short", "鼓楼七层");
    set("long", "这里就是鼓楼之顶。直入眼帘的便是一只大鼓。大鼓鼓身通红，\n似由白杨木箍成。两头包以水牛皮，用一匝大铜钉钉在鼓身边缘。\n鼓心有一圈白渍，看来是因为多次击打形成的。整个大鼓放在一\n个一人高的架子上，架子底层搁着两根大鼓槌。尽管山风吹人欲\n倒，谁都禁不住想击一下鼓(drum)试试。往外看，有个很大的汉\n白玉窗台(window)，上面足可站一个人，你如果想不开的话，跳\n楼(tiao lou)是一个好的解决方法。\n");
    set("exits", ([ "down" : "/d/shaolin/gulou6" ]));
    set("item_desc", ([ "drum" : (: look_drum :), "window" : (: look_out :) ]));
    set("objects", ([ "/kungfu/class/shaolin/qing-wen" : 1 ]));
    setup();
}

void init() {
    add_action("do_hit", "hit");
    add_action("do_out", "tiao");
}

int do_hit(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (!arg || arg != "drum") {
        return notify_fail("你要敲什麽？\n");
    }
    if (v1->query("qi") * 100 / v1->query("max_qi") < 30) {
        v2 = clone_object("/kungfu/class/shaolin/qing-xiao");
        v1->set_temp("last_damage_from", v2);
        v1->die();
        destruct(v2);
        return 1;
    } else {
        v1->add("qi", -30);
    }
    if (random(v1->query_str()) < 30) {
        message_vision("$N一不小心敲到自己头上了。\n", v1);
        v1->unconcious();
    } else {
        v3 = v1->query_entire_dbase();
        message_vision("$N敲了一下大鼓，『咚……』声音传遍整个寺庙。\n", v1);
        write("鼓声如迅雷般在你耳边炸响，你头脑中一片糊涂，\n全身摇摇欲坠，勉力支撑着不倒在地上。心中一个\n声音告诉你，得赶快离开这里，不然就没命了。\n");
        if (v3["potential"] - v3["learned_points"] < 100) {
            v3["potential"] += 1;
        }
    }
    return 1;
}

int do_out(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    v1 = this_player();
    v4 = v1->query_dex();
    v7 = v1->query_kar();
    v2 = (v4 + v7) * 5 + random(200);
    v3 = random(v2);
    v5 = 600 / v1->query_int();
    v6 = 800 / v1->query_int();
    v8 = 0;
    if (!arg || arg != "lou") {
        tell_room(environment(v1), v1->name() + "想不开想跳楼，可是双腿却不听使唤，瑟瑟发抖!\n", ({ v1 }));
        write("你高兴得跳得老高，不知道出了什么毛病\n");
        return 1;
    }
    if (v1->query("tiaolou_cnt") >= 6000) {
        if (random(v1->query("kar")) > 20) {
            v1->set_skill("dodge", v1->query_skill("dodge", 1) + 1);
            write("\e[1;32m你的轻功增加了!\n");
            "/adm/daemons/channeld"->do_channel(this_object(), "rumor", sprintf("由于%s坚持不懈的跳楼,轻功技能取得了长足的进展。\n", v1->name(1)));
        }
        v1->set("tiaolou_cnt", 0);
        return 1;
    }
    if (v1->query("jing") < v5 || v1->query("qi") < v6) {
        message_vision("$N满脸失望,哎,的一声叹了口气,就从楼上跳了下去。\n", v1);
        message_vision("只听『砰』地一声$N从鼓楼上落了下来。\n", v1);
        v1->move("/d/shaolin/gulou");
        v1->unconcious();
        return 1;
    }
    if (v1->query_skill("dodge", 1) < 100 && v3 < 10) {
        v1->move("/d/shaolin/gulou");
        v1->command("chat* help!");
        v1->die();
    } else if (v1->query("neili") < 2000 && v3 < 15) {
        message_vision("$N爬上窗户，一个纵身，跳了出去。\n", v1);
        v1->move("/d/shaolin/gulou");
        message_vision("只听『砰』地一声$N摔了个半死。\n", v1);
        v1->unconcious();
    } else {
        message_vision("$N爬上窗户，一个纵身，跳了出去。\n", v1);
        set_eval_limit(0);
        v1->move("/d/shaolin/gulou");
        message_vision("只听『砰』地一声$N从楼上跳了下来。\n", v1);
        tell_object(v1, "你感觉到自己的轻功又有进境了！\n");
        if (v1->query_skill("dodge", 1) < 400) {
            v1->improve_skill("dodge", v1->query_skill("dodge", 1));
        } else if (v1->query_skill("dodge", 1) < 700) {
            v1->improve_skill("dodge", v1->query_skill("dodge", 1) * v7 / 30);
        } else if (random(v7) > 15) {
            v1->improve_skill("dodge", v1->query_skill("dodge", 1));
        } else {
            v1->improve_skill("dodge", v1->query_skill("dodge", 1) / 2);
        }
        v1->add("tiaolou_cnt", 1);
        v1->receive_damage("jing", v5);
        v1->receive_damage("qi", v6);
        v1->set_temp("die_for", "从鼓楼上跳下来摔");
        v1->delete_temp("last_damage_from");
    }
    return 1;
}

