        if (v1->query("family/family_name") == "少林派" && v1->query("family/generation") == 37 && !v1->query("guilty")) {
            return;
        } else {
            message_vision("\e[1;33m$N一进戒律院，...只听几声大喝，如同炸雷般在大殿里回响。\n$N不禁浑身发抖，再也站立不住，腿一软，扑通一声跪了下来。\n\n\e[2;37;0m", v1);
