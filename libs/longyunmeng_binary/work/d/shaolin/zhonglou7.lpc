void create() {
    set("short", "钟楼七层");
    set("long", "这里就是钟楼之顶。直入眼帘的便是那口大钟和一根悬挂空\n中的巨杵。细看大钟，整整有两丈来高，直径也有丈许。钟身似\n由青铜浇铸，上面满是密密麻麻的印文古篆，估计重逾数千斤。\n巨杵粗可合抱，丈把来长，一头裹以厚皮，正对着钟腰。尽管山\n风吹人欲倒，谁都禁不住想撞一下钟(bell)试试。往外看，有个很\n大的汉白玉窗台(window)，上面足可站一个人,你如果想不开的话，\n可以试一试跳楼(tiao lou)。\n");
    set("exits", ([ "down" : "/d/shaolin/zhonglou6" ]));
    set("item_desc", ([ "bell" : (: look_bell :), "out" : (: look_out :) ]));
    set("objects", ([ "/kungfu/class/shaolin/qing-xiao" : 1 ]));
    setup();
}

void init() {
    add_action("do_knock", "knock");
    add_action("do_out", "tiao");
}

int do_knock(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (!arg || arg != "bell") {
        return notify_fail("你要敲什麽？\n");
    }
    if (v1->query("qi") * 100 / v1->query("max_qi") < 40 && random(v1->query_str()) < 15) {
        v2 = clone_object("/kungfu/class/shaolin/qing-xiao");
        v1->set_temp("last_damage_from", v2);
        v1->die();
        destruct(v2);
        return 1;
    } else {
        v1->add("qi", -20);
    }
    if (random(v1->query_dex()) < 20) {
        message_vision("$N一不小心敲到自己头上了。\n", v1);
        v1->unconcious();
    } else {
        v3 = v1->query_entire_dbase();
        message_vision("$N敲了一下大钟，『咣……』声音传遍整个寺庙。\n", v1);
        write("钟声如迅雷般在你耳边炸响，你头脑中一片糊涂，\n全身摇摇欲坠，勉力支撑着不倒在地上。心中一个\n声音告诉你，得赶快离开这里，不然就没命了。\n");
        v3["combat_exp"] += 1;
    }
    return 1;
}

int do_out(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    v1 = this_player();
    v4 = v1->query_dex();
    v7 = v1->query_kar();
    v2 = (v4 + v7) * 5 + random(200);
    v3 = random(v2);
    v5 = 600 / v1->query_int();
    v6 = 800 / v1->query_int();
    v8 = 0;
    if (!arg || arg != "lou") {
        tell_room(environment(v1), v1->name() + "想不开想跳楼，可是双腿却不听使唤，瑟瑟发抖!\n", ({ v1 }));
        write("你高兴得跳得老高，不知道出了什么毛病\n");
        return 1;
    }
    if (v1->query("tiaolou_cnt") >= 6000) {
        if (random(v1->query("kar")) > 20) {
            v1->set_skill("dodge", v1->query_skill("dodge", 1) + 1);
            write("\e[1;32m你的轻功增加了!\n");
            "/adm/daemons/channeld"->do_channel(this_object(), "rumor", sprintf("由于%s坚持不懈的跳楼,轻功技能取得了长足的进展。\n", v1->name(1)));
        }
        v1->set("tiaolou_cnt", 0);
        return 1;
    }
    if (v1->query("jing") < v5 || v1->query("qi") < v6) {
        message_vision("$N满脸失望,哎,的一声叹了口气,就从楼上跳了下去。\n", v1);
        message_vision("只听『砰』地一声$N从钟楼上落了下来。\n", v1);
        v1->move("/d/shaolin/gulou");
        v1->unconcious();
        return 1;
    }
    if (v1->query_skill("dodge", 1) < 100 && v3 < 30) {
        v1->move("/d/shaolin/zhonglou");
        v1->unconcious();
    } else if (v1->query("neili") < 2000 && v3 < 15) {
        message_vision("$N爬上窗户，一个纵身，跳了出去。\n", v1);
        v1->move("/d/shaolin/zhonglou");
        message_vision("只听『砰』地一声$N摔了个半死。\n", v1);
        v1->unconcious();
    } else {
        message_vision("$N爬上窗户，一个纵身，跳了出去。\n", v1);
        v1->move("/d/shaolin/zhonglou1");
        message_vision("只听『砰』地一声$N从楼上跳了下来。\n", v1);
        tell_object(v1, "你感觉到自己的轻功又有进境了！\n");
        if (v1->query_skill("dodge", 1) < 200) {
            v1->improve_skill("dodge", v1->query_skill("dodge", 1));
        } else if (v1->query_skill("dodge", 1) < 700) {
            v1->improve_skill("dodge", v1->query_skill("dodge", 1) * v7 / 30);
        } else if (random(v7) > 15) {
            v1->improve_skill("dodge", v1->query_skill("dodge", 1));
        } else {
            v1->improve_skill("dodge", v1->query_skill("dodge", 1) / 2);
        }
        v1->add("tiaolou_cnt", 1);
        v1->receive_damage("jing", v5);
        v1->receive_damage("qi", v6);
        v1->set_temp("die_for", "从钟楼上跳下来摔");
        v1->delete_temp("last_damage_from");
    }
    return 1;
}

string look_bell() {
    return "※※※※※※※※※※※※※※※※※※※※※※※\n※※※※　　　　　　　　　　　　　　　※※※※\n※※※※　　　　　佛语有曰：　　　　　※※※※\n※※※※　　　　　　　　　　　　　　　※※※※\n※※※※　『做一天和尚，撞一天钟』　　※※※※\n※※※※　　　　　　　　　　　　　　　※※※※\n※※※※　（ｋｎｏｃｋ　ｂｅｌｌ）　　※※※※\n※※※※　　　　　　　　　　　　　　　※※※※\n※※※※※※※※※※※※※※※※※※※※※※※\n";
}

string look_out() {
    return "这里是钟楼顶层的窗台，从这里可以遥望整个少室山脉，\n以及高耸入云的嵩山。浮世烟尘，尽在眼底。据说在此地\n可以与天界诸佛直接交流，对禅修大有益处。\n";
}
