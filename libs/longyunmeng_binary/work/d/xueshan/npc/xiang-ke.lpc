// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// xiang-ke.c 进香客
inherit NPC;
void create()
{
    int value;
    value = random(10);
    set_name("进香客", ({ "jinxiang ke", "ke", "guest" }));
    set("gender", "男性");
    set("age", 14 + value * 3 );
    set("combat_exp", 500 + 5 * value);
    set("shen_type", 0);
    setup();
    add_money("silver", 1 + value);
}
