inherit ROOM;
void create()
{
        set("short","密道");
        set("long",@LONG
    这是一条狭窄的暗道。
LONG
        );
        set("exits",([
                "north" : __DIR__"mishi",
                "east" : __DIR__"neidian",
        ]));
        setup();
        replace_program(ROOM);
}
