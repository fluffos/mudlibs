// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#include <weapon.h>
inherit HAMMER;
void create()
{
        set_name( "法轮",({ "fa lun" ,"lun" ,"falun" }));
        set_weight(1000);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "把");
                set("long","这是一柄法轮，僧人们用他来作法事。\n");
                set("value", 50);
                set("material", "wood");
                set("wield_msg", "$N抽出一柄$n握在手中。\n");
                set("unwield_msg","$N将手中的$n放回腰间。\n");
    }
        init_hammer(10,2);
    setup();
}
int query_autoload() { return 1; }