inherit ROOM;
void create()
{
        set("short","客店");
        set("long",@LONG
    这里是一个路边的小客店。来往的行人都在这里稍事休息。往东的
路可以到达中原。
LONG
        );
        set("valid_startroom",1);
        set("exits",([
                "east" : __DIR__"tulu2",
        ]));
set("objects", ([
  __DIR__"npc/xiaoer2" :1
]));
        setup();
}
