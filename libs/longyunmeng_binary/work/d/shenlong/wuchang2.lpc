// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit ROOM;
void create()
{
    set("short", "练武场");
    set("long", @LONG
这是一个练武场,由巨大的花岗岩石板铺就,竖立着几个木人。
LONG
    );
    set("exits", ([
        "west" : __DIR__"wuchang",
    ]));
    set("objects",([
                "/d/shaolin/npc/mu-ren" : 4 ]));
    set("outdoors", "city2");
    setup();
    replace_program(ROOM);
}
