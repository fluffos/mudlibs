// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit NPC;
void create()
{
        set_name("家丁", ({ "jia ding", "ding" }));
        set("gender", "男性");
        set("age", 24);
        set("str", 24);
        set("int", 23);
        set("con", 23);
        set("dex", 22);
        set("combat_exp", 30000);
        set("shen_type", 0);
        set("attitude", "peaceful");
        set("max_qi",750);
        set("max_jing",500);
        set("neili",550);
        set("max_neili",550);
        set("jiali",0);
        set("score", 6000);

        set_skill("cuff", 75);
        set_skill("parry",75);
        set_skill("ding-dodge",55);
        set_skill("dodge",55);
        set_skill("force",55);
        set_skill("ding-force",55);
        set_skill("sword",55);

        map_skill("force","ding-force");
        map_skill("dodge","ding-dodge");

        set_temp("apply/attack", 20);
        set_temp("apply/defense", 20);

        setup();
        carry_object(__DIR__"obj/cloth2")->wear();
}
