inherit "/inherit/room/room";
int do_pai(mixed);
void create();
void init();
int do_jump(mixed);
int do_clean(mixed);

void create() {
    set("short", "水池");
    set("long", "这是一大水池。一阵微风吹过，水中菏叶随风在水面上漂浮, 水面(mian)\n碧波涌起，妙不可言。水池中央有一座假山，其中的石洞是很多的，使人\n忍不住想探个究竟。\n");
    set("outdoors", "mr");
    set("item_desc", ([ "mian" : "水面泛着涟漪，闪烁着点点光亮，几只蜻蜓落在荷花上。\n" ]));
    set("exits", ([ "west" : "/d/mr/xiaojing7" ]));
    setup();
}

void init() {
    add_action("do_jump", "jump");
    add_action("do_clean", "clean");
}

int do_jump(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (arg != "chi") {
        return notify_fail("你要到那去？\n");
    }
    if (v1->query_dex() < 17) {
        write("你试图跳过水池，无奈身法不够敏捷，只好做罢。\n");
    } else {
        write("你纵身跳过了水池,落到了假山上。\n");
        message("vision", v1->name() + "一纵身越过了水池。\n", environment(v1), ({ v1 }));
        v1->move("/d/mr/jiashan");
        message("vision", v1->name() + "从水池边跃了上来。\n", environment(v1), ({ v1 }));
        return 1;
    }
}

int do_pai(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!living(this_player()) || arg != "mian") {
        return 0;
    }
    if (v1->is_busy()) {
        write("你现在正忙着呢。\n");
        return 1;
    }
    if (v1->is_fighting()) {
        write("你无法在战斗中腾出手来！\n");
        return 1;
    }
    if (v1->query_skill("strike", 1) > 100) {
        write("击打水面已经无法提高你的基本掌法了！\n");
        return 0;
    }
    if (v1->query("jing") < 30) {
        v1->receive_damage("jing", 10);
        write("你太累了，已经没有力气来击打水面了！\n");
        return 1;
    }
    v1->receive_damage("jing", random(10) + 15);
    write("你不时地击打着水面，泛起阵阵涟漪，这是你觉得你的基本掌法有所提高。\n");
    message_vision("$N正在不时地击打着水面，泛起阵阵涟漪。\n", v1);
    v1->improve_skill("strike", v1->query("int"));
    return 1;
}

int do_clean(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!(v2 = present("paper", v1)) || userp(v2)) {
        return notify_fail("你要干什么？\n");
    }
    if (arg != "paper" && arg != "纸卷") {
        return notify_fail("你要干什么？\n");
    }
    write("你不经意的把纸卷丢到水池中。\n", v1);
    write("纸卷渐渐干净了，显出了一行行小字。\n", v1);
    destruct(v2);
    v2 = clone_object("/d/mr/npc/obj/paper1.lpc");
    v2->move(v1);
    return 1;
}
