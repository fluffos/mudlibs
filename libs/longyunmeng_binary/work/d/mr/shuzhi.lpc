inherit "/inherit/room/room";
int do_yue(mixed);
void create();
void init();
int do_jump(mixed);

void create() {
    set("short", "树枝");
    set("long", "你跳上枝头，一片碧绿的草地映入眼帘，树的那边有一枝更大的树枝，\n不知能不能越过去。\n");
    setup();
}

void init() {
    add_action("do_jump", "jump");
    add_action("do_yue", "yue");
}

int do_yue(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!living(v1)) {
        return 0;
    }
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (v1->query("jing") < 30) {
        return notify_fail("你太累了，无法继续再跳了！\n");
    }
    if (v1->query_skill("dodge", 1) > 100) {
        return notify_fail("你在树枝间跃来跳去，但是再跳下去好象对你的轻功没多大的帮助。\n");
    }
    if (v1->query_skill("dodge", 1) < 30) {
        return notify_fail("因为与那边的树枝太远，使你无法越过去，差点摔倒！\n");
    }
    v1->receive_damage("jing", 20);
    v1->improve_skill("dodge", v1->query("int"));
    message_vision("$N在树枝间来回的跳跃。\n", v1);
    v1->move("/d/mr/shuzhi");
    return 1;
}

int do_jump(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (arg != "down") {
        return notify_fail("你要到那去？\n");
    }
    if (arg == "down") {
        write("你顺着树枝跳了下去。\n");
        message("vision", v1->name() + "顺着树枝跳了下去。\n", environment(v1), ({ v1 }));
        v1->move("/d/mr/liulin3");
        message("vision", v1->name() + "从树枝上跳了下去。\n", environment(v1), ({ v1 }));
    }
    return 1;
}
