// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// soup.c

inherit ITEM;
inherit F_LIQUID;
#include <ansi.h>
void create()
{
        set_name(HIC"雪鹤汤"NOR, ({"soup"}));
        set_weight(50);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一碗香气扑鼻的雪鹤汤。\n");
                set("unit", "碗");
                set("value", 80);
        set("max_liquid", 4);
    }

    set("liquid", ([
        "type": "water",
        "name": "雪鹤汤",
        "remaining": 6,
        "drunk_supply": 20,
    ]));
}

