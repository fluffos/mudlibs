// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit  NPC;

void  create()
{
        set_name("秀才",  ({"xiucai"}));
        set("age",  22);
        set("gender",  "男性");
        set("long", "落榜秀才，颇觉得有些怀才不遇。\n");
        set("attitude",  "peaceful");
        set("per",  22);
        set("combat_exp",  8000);
        set("shen_type",  1);
        set("class",  "scholar");
        set("force",  200);
        set("max_force",  200);
        set("force_factor",  3);
        set_skill("unarmed",  40);
        set_skill("dodge",  40);
        set_skill("parry",  40);
        setup();

        carry_object("/clone/misc/cloth")->wear();
}

