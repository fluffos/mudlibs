// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// huoji. 药铺伙计
inherit NPC;
inherit F_DEALER;
void create()
{
        set_name("药铺伙计", ({ "yaopu huoji", "huoji" }));
        set("str", 20);
        set("gender", "男性");
        set("age", 18);
        set("long", "他是平神医从乡下招来帮忙的。\n");
        set("combat_exp", 250);
        set("attitude", "friendly");
        set("vendor_goods", ({
                __DIR__"obj/jinchuang",
//                __DIR__"obj/qiannengdan",
                __DIR__"obj/yangjing"
        }));
        setup();
        carry_object(__DIR__"obj/linen")->wear();
}
void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}

