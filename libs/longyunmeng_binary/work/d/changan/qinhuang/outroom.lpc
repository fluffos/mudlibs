    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (v1->query_temp("pa")) {
        return notify_fail("你已经在石台上了，还爬什么呀！\n");
    }
    if (arg == "石台") {
        message_vision("$N想都不想，就爬上了去。\n", v1);
        v1->set_temp("pa", 1);
        return 1;
    }
}

int do_jump(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("pa")) {
        return 0;
    }
    if (!arg || arg == "") {
        return notify_fail("你要跳到什么地方去呀？\n");
