// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// by dubei
// Modify By River 99.5.20
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIY"观澜亭"NOR);
        set("long", @LONG
这座亭子四角攥尖顶，檐角飞翘，四柱拱托，古拙而又精巧。山下弧形水
渠环绕，水声潺潺，亭四周山石林立，千资百态。坐立亭中可望碧波滚滚，令
人有临海观澜之感。
LONG
        );

        set("exits", ([
                "southdown" : __DIR__"xiaoxi",
                "east" : __DIR__"xqx",
        ]));

        set("outdoors", "绝情谷");
        setup();
}
