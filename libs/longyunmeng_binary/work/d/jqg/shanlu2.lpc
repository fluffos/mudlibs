// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// shanlu2.c 
// By River@sj 99.5.20
inherit ROOM;

void create()
{
        set("short", "山间小路");
        set("long", @LONG
你走在一条蜿蜒而上的山间小路上，这里十分荒凉，前面不远处就是一些
小树林，北面有条小路不知通向哪里。
LONG
        );
        set("outdoors", "襄阳");

        set("exits", ([
                "northwest" : __DIR__"shanlu1",
                "southeast" : __DIR__"shanlu3",
        ]));

        setup();
        replace_program(ROOM);
}
