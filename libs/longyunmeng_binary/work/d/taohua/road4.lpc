// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
 
void create()
{
        set("short", "小路");
        set("long",@LONG
这是一条通往后山的小径。小路两旁长满了杂草。由于人们很少走这条路，
甚至连路中央也稀稀疏疏冒出了草芽。东边有一个小山洞。
LONG);
        set("exits", ([
  "east"   : __DIR__"road5",
  "north"  : __DIR__"road2",
]));
        set("objects", ([
        __DIR__"npc/dushe": 4,
	]) );
        set("outdoors", "taohua");
       
 
        setup();
}
