// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
 
void create()
{
        set("short", "小路");
        set("long",@LONG
 这是一条小径，弯弯曲曲向远方延伸。小径两边种植了一些桃花树。
 你只一瞥就发现：这些桃花全是白色的。
LONG);
        set("exits", ([
  "west"  : __DIR__"road1",
  "north" : __DIR__"road3",
  "south" : __DIR__"road4",
]));
        set("outdoors", "taohua");
 
        setup();
}
