// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit NPC;
 
void create()
{
        set_name("婢女", ({ "binu", }) );
        set("gender", "女性" );
        set("age",18);
        set("class", "taohua");
        set("combat_exp", 100);
        set_skill("unarmed", 5);
        set_skill("dodge", 10);
        set_skill("force",50);
        set("force", 50);
        set("max_force", 50);
        setup();
        carry_object("/d/taohua/obj/baichou")->wear();
}
