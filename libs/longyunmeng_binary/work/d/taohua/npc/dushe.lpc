// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// dushe
#include <ansi.h>
inherit NPC;
void create()
{
        set_name("毒蛇", ({ "snake" }) );
        set("long",     "一支昂首吐信的毒蛇正虎视眈眈地盯著你。\n");
        set("race", "野兽");
        set("age", 3);
        set("attitude", "aggressive");
        set("max_gin", 80);
        set("max_kee", 80);
        set("str", 10);
        set("cor", 50);
        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );
        set_temp("apply/attack", 10);
        set_temp("apply/damage", 10);
        set_temp("apply/armor", 10);
        set("combat_exp", 1000);
        setup();
}
int hit_ob(object me, object ob, int damage)
{
    if ((int)ob->query("combat_exp") > 10000) return 1 ;
        if( random(damage) > (int)ob->query_temp("apply/armor")
        &&      (int)ob->query_condition("snake_poison") < 10 ) {
                ob->apply_condition("snake_poison", 20);
        tell_object(ob, HIG "你觉得被咬中的地方一阵麻木！\n" NOR );
        }
}
