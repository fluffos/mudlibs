// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit NPC;
void create()
{
    set_name("侍童", ({ "shi tong", "tong" }));
    set("gender", "男性");
    set("age", 15);
    set("combat_exp", 100);
    set_skill("unarmed", 5);
    set_skill("blade", 5);
    set_skill("parry", 5);
    set_skill("dodge", 5);
        
    set_temp("apply/attack", 2);
    set_temp("apply/defense", 2);
    set_temp("apply/damage", 2);
        setup();
        carry_object("/clone/misc/cloth")->wear();
}
