        call_out("out_zhen", v7 + 2, v2);
    }
    v1->receive_damage("jing", v8);
    return 1;
}

void out_zhen(mixed arg) {
    if (!arg) {
        return;
    }
    if (!living(arg)) {
        message_vision("$N长舒了一口气，终于脱出了迷阵！\n", arg);
