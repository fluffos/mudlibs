    if (v7 > 8) {
        v7 = 8;
    }
    message_vision("\e[1;33m\n$N拿起布阵箱，在$n周围迅速摆下什么东西......，\n等$n醒过神来却发现自己身陷阵中，动弹不得！\n\n\e[2;37;0m", v1, v2);
    v1->start_busy(3);
    if (userp(v2)) {
        v1->fight_ob(v2);
        v2->fight_ob(v1);
    } else {
        v2->kill_ob(v1);
        v1->fight_ob(v2);
    }
    if ((random(v5) + 1) * v3 < v6 * v4 / 2) {
        message_vision("\n但$n很快就识破了$N的阵法，立刻破阵而出！\n", v1, v2);
    } else {
