    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    v1 = this_player();
    if (!arg) {
        return notify_fail("你想对谁布阵？\n");
    }
    if (this_object()->query("jian") <= 0) {
        return notify_fail("道具已经用光了。\n");
    }
    if (environment(v1)->query("freeze")) {
        return notify_fail("这里不能用布阵箱。\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    if (environment(v1)->query("no_fight")) {
        return notify_fail("这里禁止战斗。\n");
    }
    if (!objectp(v2 = present(arg, environment(v1)))) {
        return notify_fail("这里没有这个人。\n");
    }
    if (!v2->is_character() || v2->is_corpse()) {
        return notify_fail("看清楚一点，那并不是活物。\n");
    }
    if (v2 == v1) {
        return notify_fail("你想自杀？ :P\n");
    }
    v3 = v1->query("combat_exp") / 20 + 1;
    v4 = v2->query("combat_exp") / 20 + 1;
    v5 = v1->query_skill("qimen-wuxing") + 1;
    v6 = v2->query_skill("qimen-wuxing") + 1;
    if (v5 <= 0) {
        return notify_fail("你不会奇门五行之术，不能布阵！\n");
    }
    v8 = v4 * 30 / v3;
    if (v8 < 30) {
        v8 = 30;
    }
    if (v1->query("jing") < v8) {
