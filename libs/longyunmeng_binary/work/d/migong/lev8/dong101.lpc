// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
		set("short", WHT"钟乳石洞"NOR);
	set("long", WHT @LONG
 洞顶都是尖尖的钟乳石，四周不停的有水珠滴下。 
LONG NOR);
	set("exits", ([
		"north" : __DIR__"dong102",
		"west" : __DIR__"dong100",
                                	]));
        set("objects", ([
              __DIR__"npc/boss" : 1,
             __DIR__"npc/boss1" : 1,
              __DIR__"npc/boss2" : 1,
                ]));
	set("no_clean_up", 0);
	setup();
	}

int valid_leave(object me, string dir)
{
        me = this_player();
        if ( dir == "north" && objectp(present("baidu shenjun", environment(me))))
                return notify_fail(BLU"百毒神君"NOR"说道：“给我乖乖的留下做药人吧。”\n");
        if ( dir == "west" && objectp(present("baidu shenjun", environment(me))))
                return notify_fail(BLU"百毒神君"NOR"说道：“给我乖乖的留下做药人吧。”\n");

        return ::valid_leave(me, dir);
}
