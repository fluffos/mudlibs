    this_object()->clear_condition();
    "/adm/daemons/combatd"->announce(this_object(), "dead");
    if (objectp(v2 = query_temp("last_damage_from"))) {
        set_temp("my_killer", v2->query("id"));
        "/adm/daemons/combatd"->killer_reward(v2, this_object());
