mixed get_auto_actions(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = 0;
    for (v1 = 0; v1 < sizeof(pfm); v1++) {
        if (pfm[v1]["party"] == query("party")) {
            v2 = 1;
            break;
        }
    }
    if (!v2) {
        return ({ });
    }
    if (pointerp(pfm[v1][arg])) {
        return pfm[v1][arg];
    } else {
        return ({ });
    }
}

void change_combat_mode(mixed arg1, mixed arg2) {
    switch (arg2) {
    case 0:
        delete("chat_chance_combat");
        delete("chat_msg_combat");
        set("jiali", 1);
        break;
    case 1:
        set("chat_chance_combat", 100);
        set("chat_msg_combat", get_auto_actions("perform"));
        set("jiali", 50);
        break;
    case 2:
        set("chat_chance_combat", 100);
        set("chat_msg_combat", get_auto_actions("perform1"));
        set("jiali", query_skill("force") / 2);
        break;
    case 3:
        set("chat_chance_combat", 100);
        set("chat_msg_combat", get_auto_actions("perform2"));
        set("jiali", 1);
        break;
    default:
        set("chat_chance_combat", 80);
        set("chat_msg_combat", get_auto_actions("perform"));
        set("jiali", 50);
        return;
    }
    set("combat_mode", arg2);
}

void random_chat() {
    mixed v1;
    mixed v2;
    mixed v5;
    v2 = "";
    if (!environment(this_object())) {
        return;
    }
    v5 = all_inventory(environment(this_object()));
    if (!sizeof(v5)) {
        return;
    }
    v1 = sort_array("/adm/daemons/emoted"->query_all_emote(), 1);
    v2 = v1[random(sizeof(v1))];
    command(v2 + " " + v5[random(sizeof(v5))]->query("id"));
    set("answer", v2);
    return;
}

int chat() {
    mixed v1;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    v5 = 0;
    if (!is_busy() && living(this_object()) && environment(this_object())) {
        if (pointerp(v6 = get_auto_actions("powerup"))) {
            for (v1 = 0; v1 < sizeof(v6); v1++) {
                if (functionp(v6[v1])) {
                    evaluate(v6[v1]);
                }
            }
        }
    }
    if (query("neili") > 100 && query("max_neili") > 200 && !is_busy() && living(this_object()) && environment(this_object())) {
        if (query("eff_jing") && query("jing") * 100 / query("eff_jing") <= 80) {
            command("exert regenerate");
        }
        if (query("eff_qi") && query("qi") >= 0 && query("qi") * 100 / query("eff_qi") <= 80) {
            command("exert recover");
        }
        if (query("eff_qi") && query("qi") >= 0 && query("max_qi") && !is_fighting() && !query("mute") && query_skill_mapped("force") && query("eff_qi") < query("max_qi") && query("eff_qi") >= query("max_qi") / 3) {
            command("exert heal");
        }
        if (query("max_neili") && query("neili") * 100 / query("max_neili") <= 80 && !is_fighting() && query_skill_mapped("force")) {
            v1 = query_skill("force") / 15 * (query_skill("force") / 100 + 1) + 1;
            command(sprintf("dazuo %d", v1));
        }
    }
    if (!(v3 = query(is_fighting() ? "chat_chance_combat" : "chat_chance"))) {
        return 0;
    }
    if (pointerp(v6 = query(is_fighting() ? "chat_msg_combat" : "chat_msg"))) {
        if (query_temp("is_unconcious")) {
            return 0;
        }
        if (!living(this_object())) {
            return 0;
        }
        if (!environment(this_object())) {
            return 0;
        }
        if (sizeof(v6) && random(100) < v3) {
            v4 = random(sizeof(v6));
            if (stringp(v6[v4])) {
                say(v6[v4]);
            } else if (functionp(v6[v4])) {
                return evaluate(v6[v4]);
            }
        }
        return 1;
    }
    return 1;
}

void init() {
    mixed v1;
    mixed v4;
    mixed v5;
    v5 = this_object();
    remove_call_out("hunting");
    if (interactive(v1 = this_player())) {
        v1->start_busy(1);
        if (!random(3) && v5->query("shen") > 10) {
            if (!random(3)) {
                v4 = clone_object("/clone/money/silver");
                v4->set_amount(random(150));
                v4->move(v1);
                tell_object(v1, " " + v5->query("name") + "给" + v1->query("name") + "了一些" + "\e" + "[1;37m白银\e" + "[2;37;0m" + "。\n\e" + "[2;37;0m");
            } else if (random(3) == 1) {
                v4 = clone_object("/clone/money/gold");
                v4->set_amount(random(50));
                v4->move(v1);
                tell_object(v1, " " + v5->query("name") + "给" + v1->query("name") + "了一些" + "\e" + "[1;33m黄金\e" + "[2;37;0m" + "。\n\e" + "[2;37;0m");
            } else {
                v4 = clone_object("/clone/money/coin");
                v4->set_amount(random(350));
                v4->move(v1);
                tell_object(v1, " " + v5->query("name") + "给" + v1->query("name") + "了一些" + "\e" + "[33m铜钱\e" + "[2;37;0m" + "。\n\e" + "[2;37;0m");
            }
        }
        call_out("hunting", 0);
    }
    if (!environment()->query("no_fight")) {
        v1->start_busy(1);
    }
    if (!random(2)) {
        call_out("hunting", 0);
    }
}

void hunting() {
    mixed v1;
    mixed v2;
    mixed v5;
    v5 = this_object();
    v2 = all_inventory(environment());
    for (v1 = sizeof(v2) - 1; v1 >= 0; v1--) {
        if (!v2[v1]->is_character() || v2[v1] == this_object() || !living(v2[v1])) {
            continue;
        }
        if (v5->query("shen") > 10) {
            continue;
        }
        if (v2[v1]->query("vendetta/authority")) {
            continue;
        }
        fight_ob(v2[v1]);
        v2[v1]->fight(this_object());
        call_out("check", 0);
    }
}

void die() {
    mixed v1;
    mixed v2;
    mixed v5;
    mixed v7;
    mixed v8;
    mixed v9;
    if (!living(this_object())) {
        revive(1);
    }
    if (wizardp(this_object()) && query("env/immortal")) {
        return;
