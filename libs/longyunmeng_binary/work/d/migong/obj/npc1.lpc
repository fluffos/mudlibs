    }
    if (objectp(v1 = "/adm/daemons/chard"->make_corpse(this_object(), v2))) {
        v1->move(environment());
    }
    v2->remove_all_killer();
    if (userp(v2)) {
        tell_object(v2, "\e[1;37m你被奖励了：" + chinese_number(v7) + "点实战经验，\n" + chinese_number(v8) + "点潜能，\n" + chinese_number(v9) + "点江湖阅历。\n\e" + "[2;37;0m");
        v5 = clone_object("/clone/box/gbox");
        v5->move(environment(this_object()));
        this_object()->remove_all_killer();
        message_vision("$N找到了一个宝箱。\n", v2);
        v5 = clone_object("/clone/gem/gem");
        message_vision("$N得到一颗亮晶晶的宝石。\n", v2);
        command("rumor " + v2->query("name") + "得到一颗" + v5->query("name") + "!\e" + "[2;37;0m。\n");
        v5->move(v2);
        v5 = clone_object("/clone/gem/ring" + random(10));
        message_vision("$N得到一个魔法戒指。\n", v2);
        command("rumor " + v2->query("name") + "得到一个" + v5->query("name") + "!\e" + "[2;37;0m。\n");
        v5->move(v2);
        all_inventory(environment())->remove_killer(this_object());
        destruct(this_object());
    }
