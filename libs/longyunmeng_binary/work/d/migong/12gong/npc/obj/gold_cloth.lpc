#include <armor.h>
#include <ansi.h>

inherit CLOTH;
#include "chk_owner.lpc"

void create()
{
   set_name(HIY"黄金圣衣"NOR, ({ "huangjin shengyi" }) );
   set_weight(10000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
set("no_drop",1);
     set("no_get",1);
      set("no_sell",1);
       set("value",0);
     set("material", "steel");
     set("armor_prop/armor",1200);
  }
   setup();
}
int query_autoload() { return 1; }
