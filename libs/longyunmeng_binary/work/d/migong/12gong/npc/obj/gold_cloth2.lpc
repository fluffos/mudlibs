#include <armor.h>

inherit CLOTH;
#include "chk_owner.lpc"

void create()
{
   set_name("黄金圣衣", ({ "huangjin shengyi" }) );
   set_weight(10000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
     set("no_get",1);
     set("no_give",1);
     set("value",2000000);
     set("material", "steel");
     set("armor_prop/armor",1200);
  }
   setup();
}
int query_autoload() { return 1; }
