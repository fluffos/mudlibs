#include <armor.h>

inherit CLOTH;

void create()
{
   set_name("狮子圣衣", ({ "shizi shengyi" }) );
   set_weight(3000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
     set("material", "steel");
     set("armor_prop/armor",450);
   }
   setup();
}
