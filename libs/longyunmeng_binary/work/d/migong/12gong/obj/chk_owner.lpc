// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
void check_owner();
void destroy(object ob);

void init()
{
        check_owner();
}


void check_owner()
{
        object ob =this_object();
        object me =environment(ob);
if ( !me->query("12gongs/all") && !wizardp(me))
       call_out("destroy", 0, ob, me);                       
//           destroy(ob);
}
void destroy(object ob)
{
        write(ob->query("name")+"呼的不见了！ \n");
        destruct(ob);
        return;
}
