// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// book.c

inherit ITEM;

void create()
{
        set_name( "占卜入门", ({ "book" }));
        set_weight(100);
        set("value", 10000);
        set("unit", "本");
        set("long", "这是一本讲解占卜学的书籍。\n");
		set("owner_id",1);
        set("skill", ([
                "name":                 "foreknowledge",
                "exp_required": 	0,                
                "sen_cost":             30,     
                "difficulty":   	30,            
"max_skill":            1500	
                                            
        ]) );
}
