// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// book.c

inherit ITEM;

void create()
{
	int	i;

        string *names = ({
                "「易经」", "「太极拳谱」", "「三才剑谱」", "「五行身法图」",
                "「太极内功入门」"
        });

        string *skills= ({
                "changelaw", "taiji-quan", "three-sword", "five-steps", "taiji-shengong"
        });

	i = random(5);
        set_name( names[i], ({ "book" }));
        set_weight(100);
        set("value", 100000);
        set("unit", "本");
        set("long", "这是一本修练武当派入门武功的书籍。\n");
        set("skill", ([
                "name":                 skills[i],
                "exp_required": 0,                
                "sen_cost":             30,     
                "difficulty":   30,            
                "max_skill":    40           
                                            
        ]) );
}
