// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("乌木簪", ({ "black clip", "clip" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("value", 200);
		set("material", "wood");
                set("wield_msg", "$N从头上拔下一根$n捏在手中。\n");
                set("unwield_msg", "$N把手中的$n插在头上。\n");
	}
        init_sword(10);
	setup();
}
