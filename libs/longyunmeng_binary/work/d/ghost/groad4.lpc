// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit ROOM;

void create()
{
	set("short", "弯曲小路");
	set("long", @LONG
路的两旁，有各式各样的树木，还有些不知名的花草。在阳光普
照的时候，这山谷一定很美。可是这山谷里是不是也有阳光普照的时
候？
LONG
	);
	set("exits", ([
                "west" : __DIR__"dating",
                "southeast" : __DIR__"groad5",
	]));
	set("coor/x",-1120);
	set("coor/y",-100);
	set("coor/z",-20);
	setup();
replace_program(ROOM);

}
