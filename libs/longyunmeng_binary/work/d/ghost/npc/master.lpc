void reset() {
    delete_temp("learned");
    set("apprentice_available", 20);
}

void attempt_apprentice(mixed arg) {
    if (query("apprentice_available")) {
        if (find_call_out("do_recruit") != -1) {
            command("say 慢著，一个一个来。");
        } else {
            call_out("do_recruit", 2, arg);
        }
    } else {
        command("say 本庄主今天已经收了二十个弟子，不想再收徒了。");
    }
}

void do_recruit(mixed arg) {
    if (arg->query_temp("marks/顾云飞")) {
        command("stare " + arg->query("id"));
        command("say 你不是来做奸细的吧？\n");
        return;
    } else if (arg->query_temp("marks/幽灵山庄")) {
        say("\n");
        command("say 好！你把武当的镇山七星宝剑拿来给我，不用拜师，我也传授你一身武功！\n");
        arg->set("marks/拿七星宝剑", 1);
    } else {
        command("say 你日后必有大成！");
        command("smile");
        command("recruit " + arg->query("id"));
    }
}

int recruit_apprentice(mixed arg) {
    if (::recruit_apprentice(arg)) {
        arg->set("class", "ghost");
    }
    add("apprentice_availavble", -1);
}

int recognize_apprentice(mixed arg) {
    if (arg->query("marks/老刀把子") || arg->query("class") == "ghost") {
        return 1;
    }
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg2->name() != "七星剑") {
        return 0;
    }
    if (!arg1->query("marks/拿七星宝剑")) {
        return 0;
    }
    if (arg2->query("real") && arg2->query_temp("marks/owner") == arg1) {
        arg1->delete("marks/拿七星宝剑");
        command("spank " + arg1->query("id"));
        command("say 你想要武功秘集，还是向我学武？(accept book/teach?)");
        arg1->set_temp("marks/拿到七星宝剑", 1);
        add_action("do_accept", "accept");
    } else {
        say("老刀把子接过七星剑，仔细地看了看。\n");
        command("sigh");
        command("say 这一柄又是假的！");
    }
    return 1;
}

int do_accept(mixed arg) {
    mixed v1;
    mixed v2;
    if (!arg || arg != "book" && arg != "teach") {
        return notify_fail("什麽？\n");
    }
    v1 = this_player();
    if (!v1->query_temp("marks/拿到七星宝剑")) {
        return notify_fail("什麽？\n");
    }
    v1->set_temp("marks/拿到七星宝剑", 0);
    if (arg == "book") {
        v2 = clone_object("/d/ghost/npc/obj/book");
        v2->move(this_object());
        command("give book to " + v1->query("id"));
    } else {
        command("say 从今天开始，你可以同我学武了。");
    }
    v1->set("marks/老刀把子", 1);
    return 1;
}

void init() {
    add_action("give_quest", "quest");
}

void re_rank(mixed arg) {
    mixed v1;
    v1 = arg->query("combat_exp");
    if (v1 <= 32000) {
        arg->set("title", "幽灵山庄弟子");
        return;
    } else if (v1 <= 128000) {
        arg->set("title", "幽灵山庄领班");
        return;
    } else if (v1 <= 512000) {
        arg->set("title", "幽灵山庄小管家");
        return;
    } else if (v1 <= 1536000) {
        arg->set("title", "幽灵山庄管家");
        return;
    } else if (v1 <= 3456000) {
        arg->set("title", "幽灵山庄大管家");
        return;
    } else if (v1 <= 5187000) {
        arg->set("title", "幽灵山庄总管");
        return;
    } else if (v1 <= 26244000) {
        arg->set("title", "幽灵山庄大总管");
        return;
    } else {
        arg->set("title", "幽灵山庄副庄主");
    }
    return;
}
