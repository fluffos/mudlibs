// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// yupei.c 玉佩
#include <armor.h>
#include <ansi.h>
inherit NECK;
void create()
{
	set_name(HIC "玉佩" NOR, ({ "yu pei", "yu" }));
       	set("long", "\n这是一块淡兰色的宝玉，莹滑温润，光洁无瑕，真是稀世罕有。\n"+
         "或许因为这是风儿送的，凌儿总爱把它带在胸前。\n");
	set("weight", 300);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "枚");
		set("value", 50000);
		set("material", "玉");
		set("armor_prop/armor", 2);
		set("female_only", 1);
	}
	setup();
}	
int query_autoload() { return 1; }