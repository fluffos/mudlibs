// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// tudao.c
#include <weapon.h>
inherit BLADE;
void create()
{
	set_name("屠刀", ({ "knife" }));
	set_weight(7000);
                set("flag",2);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一血淋淋的屠刀。\n");
		set("value", 2000);
		set("material", "steel");
		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回刀鞘。\n");
	}
        init_blade(30,2);
	setup();
}
int query_autoload() { return 1; }