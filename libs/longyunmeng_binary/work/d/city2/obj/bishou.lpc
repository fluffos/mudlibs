// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// bishou.c 匕首
#include <weapon.h>
#include <ansi.h>
inherit DAGGER;
void create()
{
        set_name(HIR "鳌拜匕首" NOR, ({ "bishou","sword" }));
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "细看那匕首，剑身如墨，无半点光泽。\n");
		set("value", 50000);
                set("flag",2);
		set("material", "steel");
                set("no_drop", "这样东西不能离开你。\n");
                set("no_give", "这样东西不能给人。\n");
		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中，只觉一股寒气扑面而来。\n");
		set("unwield_msg", "$N将手中的$n插回剑鞘，只听嗤的一声轻响。\n");
	}
        init_dagger(200,2);
	setup();
}
int query_autoload() { return 1; }