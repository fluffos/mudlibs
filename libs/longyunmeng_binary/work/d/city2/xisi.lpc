// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
void create()
{
	set("short", "西四北大街");
	set("long", @LONG
这是一条长长的街道。东边就是游人们常去的文庙，那里长年香火不断，
烟雾缭绕。南边是西单。
LONG
	);
        set("outdoors", "city2");
	set("exits", ([
		"north" : __DIR__"xisi2",
		"east" : __DIR__"wenmiao",
		"south" : __DIR__"xidan1",
	]));
	setup();
	replace_program(ROOM);
}
