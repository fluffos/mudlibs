// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#include <ansi.h>
inherit ROOM;
void create()
{
    set("short", "庄府大厅");
    set("long", @LONG
这是一间大厅。通往各个房间.东边的屋里有女子啼哭之声隐隐传来.
LONG
    );
    set("exits", ([
		"east" : "/d/city2/zhuang6",
