// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
void create()
{
	set("short", "朝阳路");
	set("long", @LONG
这是一条青石路，一路走来见不到几个行人。东南边是东门。
朝阳门在西北边。
LONG
	);
        set("outdoors", "city2");
	set("exits", ([
		"northwest" : __DIR__"chaoyang",
		"southeast" : __DIR__"dongmen",
	]));
	setup();
}
