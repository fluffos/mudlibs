// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
void create()
{
	set("short", "地安门东大街");
	set("long", @LONG
这是一条东西走向的大道。西边通往地安门。东边通往王府井。
LONG
	);
        set("outdoors", "city2");
	set("exits", ([
		"east" : __DIR__"di_an1",
