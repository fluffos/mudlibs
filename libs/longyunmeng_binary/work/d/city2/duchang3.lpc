    call_out("gamble_prepare", 2);
    room_status = 1;
}

int do_dou(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v1 = this_player();
    if (!arg || sscanf(arg, "%s %d %s", v2, v3, v4) != 3) {
        return notify_fail("请使用：  dou <押鸡种类> <数目> <货币>\n");
    }
    if (v2 != "hg" && v2 != "lw") {
        return notify_fail("你要押什么样的鸡？\n");
    }
    v5 = present(v4 + "_money", v1);
    if (!v5) {
        return notify_fail("你身上没有这种货币。\n");
    }
    if (v3 < 1) {
        return notify_fail("请多押一些钱。\n");
    }
    if (v3 > v5->query_amount()) {
        return notify_fail("你身上的钱不够押。\n");
    }
    if (v3 * v5->query("base_value") > 10000) {
        return notify_fail("你想豪赌啊，拜托！官兵就上来了。\n");
    }
    if (v1->query_temp("gamble_ji/amount") > 0) {
        return notify_fail("你已经押过了。\n");
    }
    if (room_status > 1) {
        return notify_fail("现在正在斗鸡呢，稍等片刻。\n");
    }
    v1->set_temp("gamble_ji/kind", v2);
    v1->set_temp("gamble_ji/amount", v3);
    v1->set_temp("gamble_ji/money", v4);
    message_vision(sprintf("$N拿出%s%s%s往青玉栏杆上一放，押在%s上。\n", chinese_number(v3), v5->query("base_unit"), v5->query("name"), jis[v2]), v1);
    if (v3 == v5->query_amount()) {
        destruct(v5);
    } else {
        v5->add_amount(-v3);
    }
    return 1;
}

int valid_leave(mixed arg1, mixed arg2) {
    if (arg2 == "south") {
        if (arg1->query_temp("gamble_ji/amount") > 0) {
            message_vision("$N扔下押鸡的钱不要了。\n", arg1);
        }
        arg1->delete_temp("gamble_ji");
    }
    return ::valid_leave(arg1, arg2);
}

void gamble_prepare() {
    mixed v1;
    v1 = this_object();
    tell_room(v1, "白髯鸡仙从左右鸡笼里各拿出一只红冠鸡和一只绿尾鸡。\n");
    hg_ji = clone_object("/d/city2/npc/douji");
    hg_ji->set("name", "红冠鸡");
    hg_ji->move(v1);
    lw_ji = clone_object("/d/city2/npc/douji");
    lw_ji->set("name", "绿尾鸡");
    lw_ji->move(v1);
    tell_room(v1, "白髯鸡仙说：好，可以押钱了，一赢二。\n");
    room_status = 1;
    call_out("gamble_start", 20);
}

void gamble_start() {
    mixed v1;
    v1 = this_object();
    tell_room(v1, "白髯鸡仙说声：停押，斗鸡。\n");
    tell_room(v1, "然后将两只鸡抱起，拿出铁啄熟练地安上，把鸡放进栏内。\n");
    room_status = 2;
    hg_ji->kill_ob(lw_ji);
    lw_ji->kill_ob(hg_ji);
    call_out("gamble_perform", 1);
}

object present_ji(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = all_inventory(arg);
    v2 = sizeof(v1);
    while (v2--) {
        if (userp(v1[v2])) {
            continue;
        }
        if (v1[v2]->id("ji")) {
            return v1[v2];
        }
    }
}

void gamble_perform() {
    mixed v1;
    mixed v2;
    v1 = this_object();
    if (!living(hg_ji)) {
        hg_ji->die();
    }
    if (!living(lw_ji)) {
        lw_ji->die();
    }
    v2 = present_ji(v1);
    if (v2 && v2->is_fighting()) {
        remove_call_out("gamble_perform");
        call_out("gamble_perform", 1);
        return;
    }
    if (v2->query("qi") < 15) {
        v2->unconcious();
        v2->die();
    }
    call_out("gamble_finish", 1);
}

