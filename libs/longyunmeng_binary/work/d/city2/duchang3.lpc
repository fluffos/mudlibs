void create() {
    set("short", "斗鸡房");
    set("long", "斗鸡房里一左一右放着两个青竹鸡笼，一个鸡笼里关着一群红\n冠鸡，另一个鸡笼里关着一群绿尾鸡。屋子正中是七尺见方的斗鸡\n场，由一圈低低的青玉栏杆围成。一位白髯鸡仙正在张罗着斗鸡。\n在他的后面墙上有一个牌子(paizi)。\n");
    set("item_desc", ([ "paizi" : "押红冠鸡：  dou hg <amount> <money>\n押绿尾鸡：  dou lw <amount> <money>\n" ]));
    set("objects", ([ "/d/city2/npc/jixian" : 1 ]));
    set("exits", ([ "west" : "/d/city2/duchang2" ]));
    set("light_up", 1);
    set("no_fight", 1);
    set("no_magic", 1);
    setup();
}

