// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit NPC;
void create()
{
	set_name("厨师", ({ "chu shi", "chu" }));
	set("gender", "男性");
	set("age", 45);
	set("combat_exp", 7500);
        set_skill("unarmed", 35);
        set_skill("force", 35);
        set_skill("dodge", 40);
        set_temp("apply/attack", 30);
        set_temp("apply/defense", 40);
	set("shen_type", -1);
	setup();
	carry_object("/d/city/obj/cloth")->wield();
}
	
