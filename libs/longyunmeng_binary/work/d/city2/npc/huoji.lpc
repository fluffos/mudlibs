// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit NPC;
inherit F_DEALER;
void create()
{
	set_name("客店伙计", ({ "kedian huoji", "huoji" }));
	set("str", 20);
	set("gender", "男性");
	set("age", 18+random(20));
	set("long", "他是小客店的伙计。\n");
	set("combat_exp", 2500);
	set("attitude", "friendly");
	set("chat_chance", 3);
	set("chat_msg", ({
	"伙计说道：你...你...你可别杀我啊，我是良...良民。\n",
	}));
	setup();
	carry_object("/clone/misc/cloth")->wear();
}
