// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// huoji. 药铺伙计
inherit NPC;
inherit F_DEALER;
void create()
{
	set_name("药铺伙计", ({ "yaopu huoji", "huoji" }));
	set("str", 20);
	set("gender", "男性");
	set("age", 18);
	set("long", "他十分强壮，看上去会几分武功，对药铺生意似乎并不在乎。\n");
	set("combat_exp", 15000);
	set("attitude", "friendly");
	set("vendor_goods", ({
		"/d/city/obj/jinchuang",
		"/d/city/obj/yangjing",
		"/d/city2/obj/gaoyao",
	}));
	set_skill("unarmed", 60);
	set_skill("dodge", 60);
	set_skill("parry", 60);
	setup();
	carry_object("/clone/misc/cloth")->wear();
	add_money("silver", 5);
}
void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}
