// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit NPC;
void create()
{
	set_name("观众", ({ "guan zhong", "guan" }));
	set("gender", "男性");
	set("age", 15+random(70));
	set("combat_exp", 5000+random(10000));
        set_skill("unarmed", 10+random(50));
        set_skill("force", 10+random(50));
        set_skill("dodge", 10+random(50));
        set_temp("apply/attack", 5+random(50));
        set_temp("apply/defense", 5+random(50));
	set("shen_type", 0);
	setup();
	carry_object("/d/city/obj/cloth")->wear();
	add_money("silver", random(20));
}
	
