// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
/*  <SecCrypt CPL V3R05>  */
 
//  by  snowcat  on  7/5/1997  
inherit  NPC;

int  random2  (int  i)
{
    return  (random(i)+uptime())  %  i;
}

void  create()
{
    set_name("斗鸡",  ({  "dou ji",  "ji"  })  );
    set("race",  "野兽");
    set("gender",  "雄性");
    set("age",  2);
    set("no_die",1);
    set("long",  "一只雄赳赳的斗鸡。\n");
    set("attitude",  "friendly");
    set("max_qi",200+random2(2));
    set("qi",200+random2(2));
    set("max_jing",100+random2(2));
    set("jing",100+random2(2));
    set("str",  40+random2(2));
    set("int",  40+random2(2));
    set("con",  40+random2(2));
    set("dex",  40+random2(2));
    set_skill("unarmed",  random2(2)+10);
    set_skill("dodge",  random2(2)+10);
    set_skill("parry",  random2(2)+10);
    set("limbs",  ({  "头部",  "身体",  "尾巴"  })  );
    set("verbs",  ({  "bite"})  );
    
    set_temp("apply/attack", 1);
    setup();
}

