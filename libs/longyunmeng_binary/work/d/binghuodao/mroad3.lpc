inherit ROOM;
#include <ansi.h>
void create()
{
        set("short", "空地");
        set("long", @LONG
一块开辟出的空地,明显是人工的.
LONG );
set("exits", ([
"south" : __DIR__"mroad1",                
"north"  : __DIR__"home",
"northeast"  : __DIR__"xhome",
        ]));

        set("outdoors", "binghuodao");
//      set("no_clean_up", 0);
        setup();
}
