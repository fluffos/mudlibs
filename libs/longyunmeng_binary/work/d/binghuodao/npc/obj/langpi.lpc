// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//shepi

#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create()
{
        set_name( HIW "雪狼皮" NOR, ({ "lang pi", "pi" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
set("value",15000);
                set("material", "leather");
                set("armor_prop/armor", 10);
        }
        setup();
}

