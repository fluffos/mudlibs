void create() {
    set("short", "山洞");
    set("long", "这个山洞里伸手不见五指，只有出口处透进一丝光线。\n");
    set("exits", ([ "out" : "/d/xingxiu/tianroad5" ]));
    set("no_clean_up", 0);
