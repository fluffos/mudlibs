    add_action("do_use", "use");
    add_action("do_study", "study");
}

int do_use(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (!(v2 = present("fire", v1))) {
        return 0;
    }
    if (v1->query_temp("marks/钻")) {
        return 0;
    }
    if (arg == "fire") {
        write("你点燃了火折，发现西面石壁上画有一幅老僧持刀图，及一些乱七八糟的线条。\n");
        v1->set_temp("marks/钻", 1);
        set("long", "山洞西面石壁上画有一幅老僧持刀图，及一些乱七八糟的线条。\n");
        call_out("dest_fire", 300, v1, v2);
