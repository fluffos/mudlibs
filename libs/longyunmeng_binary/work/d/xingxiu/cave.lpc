    if (!arg1 || !arg2) {
        return;
    }
    message("vision", "\e[1;34m插在石壁上的" + arg2->name() + "燃尽了。\n\e" + "[2;37;0m", this_object());
    arg1->delete_temp("marks/钻");
    destruct(arg2);
    set("long", "这个山洞里伸手不见五指，只有出口处透进一丝光线。\n");
}
