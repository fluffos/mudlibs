    }
}

int do_study(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (!arg || arg != "tu") {
        return notify_fail("你要读什么？\n");
    }
    if (!v1->query_temp("marks/钻")) {
        tell_object(v1, "四周一片漆黑你要读什么？\n");
        return 1;
    }
    if (v1->query_skill("literate", 1) < 1) {
        write("你是个文盲，先学点文化(literate)吧。\n");
        return 1;
    }
    if (v1->query_int() < 35) {
        write("你的悟性不够，先学点文化(literate)吧。\n");
        return 1;
    }
    v2 = v1->query("max_jing") / 10;
    if (v1->query("jing") < v2) {
        write("你现在眼花缭乱，精疲力尽了。\n");
        return 1;
    }
    v1->receive_damage("jing", v2);
    message_vision("$N正以掌作刀模仿石壁上的古怪图案，比划了几下。\n", v1);
    write("你对着图案琢磨了一回儿，似有所悟。\n");
    v3 = v1->query_skill("blade", 1);
    if (v3 < 450 && random(10) > 5 && v3 * v3 * v3 / 20 < v1->query("combat_exp")) {
        v1->improve_skill("blade", v1->query_int());
    }
    return 1;
}

