// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// weapon: tiegun.c
// Jay 3/18/96
#include <weapon.h>
inherit CLUB;
void create()
{
        set_name("铁棍", ({ "tie club", "club" }) );
        set_weight(1500);
                set("flag",1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "这是一根浑铁棍，似乎威力不大。\n");
                set("value", 100);
                set("material", "iron");
                set("wield_msg", "$N拿出一根$n，握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }
        init_club(15,1);
        setup();
}
int query_autoload() { return 1; }