// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// npc: /d/xingxiu/npc/ke.c
// Jay 3/27/96
inherit NPC;
void create()
{
        set_name("欧阳锋", ({ "ouyang feng", "ouyang", "feng" }));
        set("long", "他是白驼山庄主，号称“西毒”的欧阳锋\n");
        set("title", "老毒物");
        set("gender", "男性");
        set("age", 53);
        set("attitude", "peaceful");
        set("str", 30);
        set("int", 24);
        set("con", 30);
        set("dex", 24);
        set("qi", 500);
        set("max_qi", 500);
        set("jing", 300);
        set("max_jing", 300);
        set("neili", 1500);
        set("max_neili", 1500);
        set("jiali", 50);
        set("combat_exp", 1500000);
        set("score", 200000);
        set_skill("force", 200);
   // other set needed for future use.
        setup();
}
