// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// jiulou1.c

inherit ROOM;

void create()
{
        set("short", "酒楼");
        set("long", @LONG
这家酒楼是荆州府方圆百里内的唯一一家，不过连名字都没
有。楼下布置简易，顾客多是匆匆的行人，买点包子、鸡腿、米
酒就赶路去了。楼上是雅座。
LONG
        );
        set("exits", ([
                "south" : __DIR__"beijie",
                "up" : __DIR__"jiulou2",
        ]));
        set("objects", ([
                __DIR__"npc/xiaoer" : 1,
        ]));

        setup();
}

