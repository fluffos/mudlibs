// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// minju4.c 民居
// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("short", "民居");
        set("long", @LONG
这间屋子你一进来就看见屋角大袋小袋地堆满了粮食，看得出来今
年的收成确实不错。屋内坐着一位村民，正笑嘻嘻地看着自己的积粮，
也许正在盘算这个冬天又不愁了。
LONG
        );
        set("exits", ([
                "northeast" : __DIR__"guchang",
        ]));

        set("objects", ([
                __DIR__"npc/cunmin" : 1,
        ]));
        setup();
        replace_program(ROOM);
}
