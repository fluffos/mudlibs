// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ITEM;

void create()
{
        set_name( "全真剑谱", ({ "book","jian pu" }));
        set_weight(100);
        set("unique", 1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long", "这是一本全真剑谱，上面画着一些纷繁复杂的招式及修练法门。\n");
                set("material", "paper");
                set("skill", ([
                         "name": "quanzhen-jianfa",        
                        "exp_required": 100000, // minimum combat experience required
                        "jing_cost": 30,        // jing cost every time study this
                        "difficulty": 30,       // the base int to learn this skill
                        "max_skill":    150,    // the maximum level you can learn
                ]) );
        }
}

int query_autoload() { return 1; }