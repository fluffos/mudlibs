// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//jinmu.c

inherit ITEM;



void init();

int do_see();



void init()

{

	add_action("do_see","see");

}



void create()

{

        set_name( "海底金母", ({ "jin mu","jin","mu"}));

        set_weight(30000);

        if( clonep() )

                set_default_object(__FILE__);

        else {

                set("unit", "块");

                set("long","这是一块海底金母，泛着紫悠悠的光，看起来沉甸甸的，\n"

		    "似乎是制造兵器的绝好材料。\n");

                set("value", 0);

                set("material", "iron");

              }

}







int do_see()

{

	write("xixi");

        return(0);

}

int query_autoload() { return 1; }