// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// greyrobe.c; 灰色道袍// By kyd#include <armor.h>inherit CLOTH;void create(){	set_name("灰色道袍", ({"pao", "cloth", "dao pao"}) );    set_weight(3000);    if( clonep() )       set_default_object(__FILE__);    else {        set("unit", "件");		set("long", "一件普普通通的灰色道袍。\n");        set("material", "cloth");        set("armor_prop/armor", 2);    }    setup();}
int query_autoload() { return 1; }