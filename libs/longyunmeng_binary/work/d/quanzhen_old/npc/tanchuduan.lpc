int accept_object(mixed arg1, mixed arg2) {
    arg1->delete_temp("sword");
    arg1->set_temp("m_sword", 1);
    switch (arg2->query("name")) {
    case "千年神木":
        arg1->add_temp("shenmu", 1);
        break;
    case "海底金母":
        arg1->add_temp("jinmu", 1);
        break;
    case "寒丝羽竹":
        arg1->add_temp("hanzhu", 1);
        break;
    default:
        message("vision", "这是什么！师傅说这不能用来打造兵器！", arg1);
        return 0;
    }
    message("vision", "谭处端低头检视了一下手中的" + arg2->query("name") + "点了点头说：\n", arg1);
    message("vision", "。。。好我们现在就开始铸剑\n", arg1);
    write("请这位" + "/adm/daemons/rankd"->query_respect(arg1) + "给剑起名字吧！(zhu 剑的名字 英文代号)\n");
    return 2;
}

