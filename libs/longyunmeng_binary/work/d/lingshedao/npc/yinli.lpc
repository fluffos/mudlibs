    call_out("goto_lingshedao", 10, v1);
    return 1;
}

void goto_lingshedao(mixed arg) {
    tell_object(arg, "船终于靠在了一个岛的海滩上.殷离把你推下船,然后\n扬帆往回驶去.\n");
    arg->move("/d/lingshedao/haitan1");
}

string ask_me() {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (query("book_count") < 1) {
        return "你来晚了，锦盒我已经赠送给别入了。";
    }
    add("book_count", -1);
    message_vision("\e[1;33m殷离从怀里拿出一个锦盒，交了给$N \n\n\e[2;37;0m", v2);
    v1 = clone_object("/clone/book/jinhe");
    v1->move(v2);
    return "这个锦盒你要好好保管。\n";
}

int do_quit(mixed arg) {
    if (arg == "roar") {
        write(this_player()->query("name") + "，这里不能用roar吧！\n");
        return 1;
    }
}
