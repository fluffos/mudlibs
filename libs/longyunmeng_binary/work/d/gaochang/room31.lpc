            return 1;
        }
        message("vision", v1->name() + "“嗖”地一声跳了下去。\n", environment(v1), ({ v1 }));
        v1->move("/d/gaochang/room32");
        message("vision", v1->name() + "从上面跳了下来。\n", environment(v1), ({ v1 }));
        this_player()->delete_temp("marks/跳1");
        if (objectp(v2 = present("fire", this_player()))) {
            message_vision("$N手一松, 火折子不知掉到那了。\n", v1);
            destruct(v2);
            return 1;
        }
    } else {
        write("你想往哪儿跳?!\n");
        return 1;
    }
}
