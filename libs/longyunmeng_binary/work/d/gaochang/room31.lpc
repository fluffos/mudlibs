    set("long", "这个山洞里伸手不见五指，黑沉沉的甚么也瞧不见。\n");
    setup();
}

void init() {
    add_action("do_use", "use");
    add_action("do_tiao", "tiao");
}

int do_use(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (!present("fire", v1)) {
        return 0;
    }
    if (arg == "fire") {
        write("    取出火折一晃，吓了一跳，原来下去到地有十七八丈高，峰内地面远\n比外面的为低。\n");
        set("long", "凭借火折的微光，你可以看到从这下去到地有十七八丈高，峰内地面远\n比外面的为低。\n");
        this_player()->set_temp("marks/跳1", 1);
        return 1;
    }
}

int do_tiao(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->query_temp("marks/跳1")) {
        if (!arg || arg != "down") {
            return notify_fail("你要往哪跳？\n");
        }
        write("你犹豫了一下，鼓气勇气，跳了下去。\n");
        if (v1->query_skill("dodge", 1) < 500) {
            message("vision", v1->name() + "急剧向下坠去。看来是凶多吉少了!\n", environment(v1), ({ v1 }));
            v1->unconcious();
            v1->receive_wound("qi", 400);
            v1->move("/d/gaochang/room32");
