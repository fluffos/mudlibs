// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//zhang.c
inherit NPC;
void create()
{
        set_name("獐", ({ "zhang" }) );
        set("race", "野兽");
        set("age", 2);
        set("long", "一头可爱的獐，它的血是大补之物。\n");
        set("attitude", "peaceful");
 
        set("str", 30);
        set("cor", 26);
        set("limbs", ({ "头部", "身体", "爪子", "尾巴" }) );
        set("verbs", ({ "bite" }) );
 
        set("combat_exp", 3000);
        set_temp("apply/attack", 50);
        set_temp("apply/damage", 10);
    set_temp("apply/defence",30);
    set_temp("apply/armor",10);
    setup();
}
