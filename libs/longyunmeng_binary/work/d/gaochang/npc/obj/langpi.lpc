inherit ITEM;
void create()
{
        set_name("灰狼皮", ({"langpi", "pi"}));
        set_weight(7000);
        set("unit", "张");
        set("long", "这是一张上等的灰狼皮, 大得可做成垫子。\n");
        set("value", 3000);
//        setup();
}
int query_autoload() { return 1; }