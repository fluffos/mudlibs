inherit ITEM;
void create()
{
        set_name("绵羊皮", ({"yangpi", "pi"}));
        set_weight(6000);
        set("unit", "张");
        set("long", "这是一张上等的绵羊皮, 是缝制羊皮袄的好原料。\n");
        set("value", 300);
//        setup();
}
int query_autoload() { return 1; }