inherit ITEM;
void create()
{
        set_name("毛毯", ({"maotan", "tan"}));
        set_weight(8000);
        set("unit", "张");
        set("long", "这是一张美丽的哈萨克毛毯。\n");
        set("value", 3000);
//        setup();
}
int query_autoload() { return 1; }