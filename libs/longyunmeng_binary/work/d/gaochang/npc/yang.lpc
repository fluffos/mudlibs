// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit NPC;
void create()
{
    set_name("绵羊", ({ "mian yang", "yang" }) );
	set("race", "野兽");
	set("age", 5);
    set("long", "一头雪白可爱的又肥又壮的绵羊。\n");
	set("attitude", "peaceful");
     set("no_die",1);
	
	set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }) );
    set("verbs", ({ "hoof", "bite" }) );
    set("combat_exp", 200);
//	set("shen_type", 0);
	
    set_temp("apply/attack", 1);
	set_temp("apply/defense", 5);
    set_temp("apply/damage", 3);
    set_temp("apply/armor", 2);
	setup();
}
void die()
{
	object ob;
    message_vision("$N凄唳的嚎了几声，倒在地上死了。\n", this_object());
        ob = new(__DIR__"obj/yangpi");
	ob->move(environment(this_object()));
	destruct(this_object());
}
	
