// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#define BOOK   2
#define FILE   "/doc/doc/00"+BOOK
inherit ITEM;
void create()
{
    set_name("(第"+chinese_number(BOOK)+"回) "+BOLD+"封神演义"+NOR, ({ "book" }));
    set_weight(50);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "本");
        set("long", CYN "\n                      封  神  演  义\n______________________________________________________\n"+NOR);
        set("value", 500);
        set("no_sell",1);
        set("material", "silk");
    }
}

string long()
{
      return query("long")+read_file(FILE);
}

int query_autoload() { return 1; }