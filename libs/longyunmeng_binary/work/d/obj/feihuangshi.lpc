// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#include <weapon.h>
 
inherit THROWING;
 
void create()
{
      set_name("飞蝗石", ({ "feihuangshi", "shi" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "这是一把,只有半寸来长的小刀。\n");
                set("unit", "堆");
                set("base_unit", "颗");
                set("base_weight", 200);
                set("value",100);
                set("damage", 10);       //Here the damage=int_throwing, added by King
        }
        set_amount(1);
        init_throwing(30,2);
        setup();
}
void set_amount(int amount)
{
    if (amount>500)  amount=500;
    ::set_amount(amount);
}

int query_autoload() { return 1; }