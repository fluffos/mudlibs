// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//ROOM lianjianshi.c
inherit ROOM;
void create()
{
        set("short", "杖场");
        set("long",
        "这里是玄兵古洞的造杖的地方。四周道也不是十分荒凉，相反还可说有\n"
        "几分景致。露天放着一个巨大的炉子，冒着蓬蓬的蓝炎，似乎什么都能被它\n"
        "融化似的。\n"  
        );
        set("exits", ([
                "east" : "/d/baituo/xiaolu2",
        ]));
    set("objects",([__DIR__"npc/shizhang" :1,]));
        setup();
    replace_program(ROOM);
}
