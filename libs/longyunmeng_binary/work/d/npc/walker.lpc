int accept_object(mixed arg1, mixed arg2) {
    if (userp(arg2)) {
        command("fear " + arg1->query("id"));
        return 0;
    }
    command("smile");
    command("say 多谢这位" + "/adm/daemons/rankd"->query_respect(arg1) + "！");
    return 1;
}

int accept_fight(mixed arg) {
    command("say " + "/adm/daemons/rankd"->query_respect(arg) + "饶命！小的这就离开！\n");
}

void get_all() {
    mixed v1;
    mixed v2;
    v1 = 0;
    if (base_name(environment()) == "/d/city/guangchang") {
        command("climb up");
    } else if (base_name(environment()) == "/d/city/chatroom") {
        command("tiao down");
    }
    if (is_fighting() || is_busy()) {
        return;
    }
    foreach (v2 in all_inventory(environment())) {
        if (v2->is_character()) {
            continue;
        }
        if (v2->query("board_id")) {
            continue;
        }
        if (v2->query("no_get")) {
            continue;
        }
        if (v2->move(this_object())) {
            v1++;
            message_vision("$N捡起一" + v2->query("unit") + v2->name() + "。\n", this_object());
            destruct(v2);
        }
    }
    if (v1) {
        command("smile scavenger");
    }
}
