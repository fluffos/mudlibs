// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// cuihua.c

inherit NPC;

void create()
{
	set_name("翠花",({ "cui hua", "hua" }) );
        set("gender", "女性" );
        set("age", 25);
        set("long", "这是个打扮很妖艳的少妇，时不时的用眼角向你扫一眼。\n");

//      set("shen", -100);
        set("shen_type", -1);
        set("str", 15);
        set("dex", 18);
        set("con", 15);
        set("int", 17);
        set("combat_exp", 200);
        set_temp("apply/attack", 5);
        set_temp("apply/defense", 10);
        set("attitude", "peaceful");
        setup();
        carry_object(__DIR__"obj/cloth")->wear();
}

