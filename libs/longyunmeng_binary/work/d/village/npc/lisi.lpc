}

int waiting(mixed arg) {
    mixed v1;
    v1 = find_player(arg->query("waiting_target"));
    if (objectp(v1)) {
        if (v1->is_ghost()) {
            arg->delete("waiting_target");
            call_out("do_back", 1, arg);
            return 1;
        } else if (arg->is_fighting() && present(v1, environment(arg))) {
            call_out("checking", 0, arg);
            return 1;
        } else if (living(arg) && !environment(v1)->query("no_fight")) {
            call_out("do_chase", 0, arg);
            return 1;
        }
    }
    remove_call_out("waiting");
    call_out("waiting", 60, arg);
    return 1;
}

int checking(mixed arg) {
    if (arg->is_fighting()) {
        call_out("checking", 1, arg);
        return 1;
    }
    if (present("corpse", environment(arg))) {
        arg->delete("waiting_target");
        call_out("do_back", 1, arg);
        return 1;
    }
    call_out("waiting", 0, arg);
    return 1;
}

