    message_vision("$N走了过来。\n\e[2;37;0m", arg);
    arg->set_leader(v1);
    command("look " + v1->query("id"));
    if (!environment(arg)->query("no_fight")) {
        call_out("do_kill", 1, arg, v1);
        return 1;
    } else {
        call_out("waiting", 0, arg);
        return 1;
    }
    return 1;
}

int do_kill(mixed arg1, mixed arg2) {
    if (objectp(arg2) && present(arg2, environment(arg1)) && !environment(arg1)->query("no_fight")) {
