        tell_object(arg1, "李四沉下脸来：好，爽快说吧，你要我帮你杀谁？\n");
        tell_object(arg1, "请键入：杀 目标\n");
        arg1->set_temp("fee_paid", 1);
        set_skill("force", v1);
        set_skill("unarmed", v1);
        set_skill("parry", v1);
        set_skill("dodge", v1);
        set_skill("sword", v1);
        set("combat_exp", v1 * v1 / 10 * v1);
        return 1;
    } else if (arg2->query("money_id") && arg2->value() < 10000) {
