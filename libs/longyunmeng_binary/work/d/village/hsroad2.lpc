// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// hsroad2.c
// by Xiang

inherit ROOM;

void create()
{
	set("short", "青石大道");
	set("long", @LONG
你走在一条青石大道上，东边隐约可见到扬州城的城墙。北面两条土路分
岔通向山里。
LONG );
        set("outdoors", "wudang");
	set("exits", ([
        "east"     : __DIR__"hsroad1",
		"northwest" : __DIR__"hsroad3",
		"northeast" : "/d/huashan/jzroad1",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}

