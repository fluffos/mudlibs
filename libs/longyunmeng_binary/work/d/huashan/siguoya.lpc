void init() {
    add_action("do_break", "break");
}

int do_break(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!arg || arg != "bi") {
        write("不要随便打碎别人的东西！\n");
        return 1;
    }
    message_vision("$N走到石壁前，拔出腰间所悬长剑，运劲向石壁刺了过去。\n", this_player());
    if (v2->query("family/family_name") == "华山派" && v2->query("family/master_id") == "feng qingyang") {
        v2->move("/d/huashan/houshan");
        return 1;
    }
    v1 = v2->query("neili");
    if (v1 >= 2000) {
        message_vision("$N只听一声轰响，石壁被捅穿了，原来里面有一个大洞。！\n", this_player());
        set("exits/enter", "/d/huashan/houshan");
