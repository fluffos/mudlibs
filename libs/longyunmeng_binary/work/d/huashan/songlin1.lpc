// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// Room: /d/huashan/songlin1.c

inherit ROOM;

void create()
{
	set("short", "松树林");
	set("long", @LONG
这是一片松树林。几丈高的松树密密麻麻，遮得不见天日。地上
落满松针，有不知名的野兔偷偷逃过。四周一片寂静。
LONG );
	set("exits", ([
		"south" : __DIR__"changlang",
		"north" : __DIR__"songlin"+(random(4)+1),
		"east"  : __DIR__"songlin"+(random(4)+1),
		"west"  : __DIR__"songlin"+(random(4)+1),
	]));
	set("outdoors", "huashan");
        set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}


