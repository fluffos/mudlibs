// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// qianchi.c
inherit ROOM;
void create()
{
    set("short", "千尺幢");
    set("long", @LONG
前面有一斜如天垂石梯的山阶，这就是赫赫有名的千尺幢，千尺幢是
依一陡峭岩脊的裂缝开凿而成，斜度约七十度，高约二十米，仅容一人上
落。如果不是精气十足，还是不要冒险攀登的好。
LONG
    );
    set("exits", ([ /* sizeof() == 2 */
        "westdown" : __DIR__"qingke",
        "southup" : __DIR__"baichi",
    ]));
    set("objects", ([ 
        __DIR__"npc/youke" : 2,
    ]));
 
    set("no_clean_up", 0);
    set("outdoors", "huashan" );
    setup();
}
 
int valid_leave(object me, string dir)
{
    if (dir == "southup"){
        me->add("jing", -30);
        me->add("qi", -30);
    }
    return 1;
}
