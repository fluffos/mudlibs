            message_vision("\e[1;31m$N被白羊撞了个人仰马翻！\n\e[2;37;0m", v2);
            v2->add("eff_kee", query("max_kee") * -2 / 10);
            v2->add("eff_sen", query("max_sen") * -2 / 10);
        } else {
            message_vision("\e[1;31m$N对着白羊大喝一声：停！白羊乖乖从旁边溜开了！\n\e[2;37;0m", v2);
        }
        break;
    case 2:
        message_vision("\e[1;31m$N运起[星屑旋转功],黄金斗气冲向$n \n", v1, v2);
        if (random(2)) {
            message_vision("\e[1;31m$N被[星屑旋转功]击中,顿时血流如注，顷刻染红了全身！\n\e[2;37;0m", v2);
            v2->add("eff_kee", query("max_kee") * -3 / 10);
            v2->add("eff_sen", query("max_sen") * -3 / 10);
        } else {
            message_vision("\e[1;31m$N看准黄金斗气的方向，纵身跃起，躲过这致命一击！\n\e[2;37;0m", v2);
        }
        break;
