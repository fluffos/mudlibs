// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// guangchang.c 广场
// by Xiang
inherit ROOM;
void create()
{
    set("short", "武当广场");
    set("long", @LONG
这是一个由大石板铺成的广场，是武当弟子学习武功和互相切磋的地点。
周围种满了梧桐树，一到秋天就是满地的落叶。一个年纪轻轻的道童正在打
扫。北边是灵霄宫三清殿。
LONG
    );
        set("outdoors", "wudang");
    set("exits", ([
        "southdown" : __DIR__"shijie62",
        "north" : __DIR__"sanqingdian",
        "west"  :__DIR__"shijie7",
    ]));
    set("objects", ([
        CLASS_D("wudang") + "/daotong" : 2]));
    setup();
}
