// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// wdroad5.c
// by Xiang
inherit ROOM;
void create()
{
        set("short", "青石大道");
        set("long", @LONG
你走在一条青石大道上，四周静悄悄的。西南方向似乎有一条黄土路。
似乎东南方有一丝杀气,远远传来,令人不寒而栗.
LONG
        );
        set("outdoors", "wudang");
        set("exits", ([
                "southeast" : "/d/heimuya/road1", 
                "southwest" : __DIR__"wdroad6",
                "north" : __DIR__"wdroad4",
        ]));
        setup();
}
