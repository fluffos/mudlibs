// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// wdroad8.c 黄土路
// by Xiang
inherit ROOM;
void create()
{
    set("short", "黄土路");
    set("long", @LONG
你走在一条尘土飞扬的黄土路上，两旁是阴森森的树林。西边是一座高山。
LONG
    );
        set("outdoors", "wudang");
    set("exits", ([
        "south" : __DIR__"wdroad9",
        "east" : __DIR__"wdroad7",
        "west" : __DIR__"shanmen",
    ]));
    set("objects", ([
        __DIR__"npc/yetu" : 4 ]));
    setup();
}
