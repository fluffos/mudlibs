// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// little_bee.c
inherit NPC;
void create()
{
    set_name("小蜜蜂", ({
 "little bee", "bee"}) );
    set("race", "野兽");
    set("age", 2);
    set("long", "一只飞来飞去的小蜜蜂。\n");
    
    set("str", 30);
    set("dex", 40);
    set("limbs", ({
 "头部", "身体", "翅膀", "尾巴" }) );
    set("verbs", ({
 "bite", "poke" }) );
    set_temp("apply/attack", 10);
    set_temp("apply/armor", 3);
    
    set("chat_chance", 2);
    set("chat_msg", ({
        (: this_object(), "random_move" :),
    "小蜜蜂嗡嗡嗡飞过来，在你头上转了一圈，又飞走了。\n",
     }) );
    setup();
}
