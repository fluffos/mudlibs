// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// yetu.c 野兔
inherit NPC;
void create()
{
        set_name("野兔", ({
 "ye tu", "ye", "tu","hare" }) );
    set("race", "野兽");
    set("age", 5);
        set("no_die",1);
    set("long", "一只好可爱的小野兔。\n");
    set("attitude", "peaceful");
    
    set("limbs", ({
 "头部", "身体", "前脚", "后脚", "尾巴" }) );
    set("verbs", ({
 "bite", "claw" }) );
    set("combat_exp", 500);
    set("chat_msg", ({
        (: this_object(), "random_move" :),
    }) );
    
    set_temp("apply/attack", 2);
    set_temp("apply/defense", 5);
    set_temp("apply/damage", 2);
    set_temp("apply/armor", 1);
    setup();
}
void die()
{
    object ob;
    message_vision("$N凄惨的嚎了几声，死了。\n", this_object());
    ob = new(__DIR__"turou");
    ob->move(environment(this_object()));
    destruct(this_object());
}
    
