// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// xiao_tufei.c
inherit NPC;
void create()
{
        set_name("小土匪", ({
"xiao tufei", "tufei"}));
        set("gender", "男性" );
    set("title","盗贼");
        set("age", 22);
        set("long", "这是个胆大包天的小土匪，杀人越或货，无恶不做。\n");
        set_temp("apply/attack", 15);
        set_temp("apply/defense", 15);
        set("combat_exp", 750);
    set("shen", -150);
        set("str", 25);
        set("dex", 20);
        set("con", 18);
        set("int", 15);
        set("attitude","friendly");
        setup();
        carry_object("/clone/misc/cloth")->wear();
        add_money("coin", 30);
}
