// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// guest.c 进香客
inherit NPC;
void create()
{
    int age;
    age = 20 + random(40);
    
    set_name("进香客", ({
 "jinxiang ke", "ke", "guest" }));
    set("gender", "男性");
    set("age", age);
    set_skill("unarmed", 20);
    set_skill("dodge", 20);
    set("apply/attack", 15);
    set("apply/defense", 15);
    set("apply/damage", 5);
    set("combat_exp", 150+age*10);
    set("shen_type", 1);
    setup();
    add_money("silver", 3+age/10);
    carry_object("/clone/misc/cloth")->wear();
}
    
