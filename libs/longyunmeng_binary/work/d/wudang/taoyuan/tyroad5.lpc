            message_vision("\e[1;33m$N一个趔趄摔了一跤！还好，只伤了些皮骨，没有滚下去。\n\n\e[2;37;0m", v2);
            v2->receive_damage("qi", random(v2->query("age")) * 4 + 30);
            v2->receive_damage("jing", 50);
        } else {
            message_vision("\e[1;31m$N光顾着抬头看天，一不留神脚下踏了个空，... 啊...！\n\n\e[2;37;0m", v2);
            tell_object(v2, "\e[1;31m你控制不住地直往山下滚，只觉得浑身无处不疼，痛得要晕死过去。\n\n\e[2;37;0m");
