// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit ROOM;
void create()
{
    set("short", "三天门");
    set("long", @LONG
这里是武当的三天门，一座高高的牌楼矗立眼前，不时地有进香客从你的
身边走过。两边是几个菩萨，一条宽阔的石阶穿堂而过，直通笼罩在云雾中的
天柱峰，望着堂中烟云缭绕的香炉，和周围虔诚的许愿人，令人肃然起敬。
LONG
    );
        set("outdoors", "wudang");
    set("exits", ([
        "south" : __DIR__"hutou",
        "north" : __DIR__"liantai",
    ]));
        set("objects", ([
                __DIR__"npc/guest" : 1]));
    setup();
    replace_program(ROOM);
}
