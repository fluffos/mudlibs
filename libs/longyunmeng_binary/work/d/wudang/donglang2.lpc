inherit "/inherit/room/room";
string look_men();
void create();
void init();
int close_men();
int do_knock(mixed);
int do_push(mixed);
int force_open(mixed);

void create() {
    set("short", "东厢走廊");
    set("long", "你走在一条走廊上，隐约可以听到东边传来呼吸声，似乎有人正在那里练功，\n北边有一扇门（men），好象是虚掩着。南边是间竹子扎就的屋子，十分的素雅，\n里面飘出一阵阵的茶香，有人轻声细语地不知说那些什么，引得女孩子＂吃吃＂\n笑出声来。\n");
    set("exits", ([ "east" : "/d/wudang/liangongfang", "south" : "/d/wudang/chashi", "west" : "/d/wudang/donglang1" ]));
    set("item_desc", ([ "men" : (: look_men :) ]));
    setup();
}

void init() {
    add_action("do_knock", "knock");
    add_action("do_push", "push");
}

int close_men() {
    mixed v1;
    if (!(v1 = find_object("/d/wudang/xiuxishi"))) {
        v1 = find_object("/d/wudang/xiuxishi", 1);
    }
    if (objectp(v1)) {
        delete("exits/north");
        message("vision", "门吱吱呀呀地自己合上了。\n", this_object());
        v1->delete("exits/south");
        message("vision", "门吱吱呀呀地自己合上了。\n", v1);
    } else {
        message("vision", "ERROR: men not found(close).\n", v1);
    }
}

int do_knock(mixed arg) {
    mixed v1;
    if (query("exits/north")) {
        return notify_fail("大门已经是开着了。\n");
    }
    if (!arg || arg != "door" && arg != "men") {
        return notify_fail("你要敲什么？\n");
    }
    if (!(v1 = find_object("/d/wudang/xiuxishi"))) {
        v1 = find_object("/d/wudang/xiuxishi", 1);
    }
    if (objectp(v1)) {
        if (v1->query_temp("sleeping_person") > 0) {
            message_vision("$N刚轻轻地敲了一下门，就听见里面传出一阵雷鸣般的鼾声，\n显然里面的人睡得跟死猪似的，怎么敲都没用了\n", this_player());
        } else if (v1->query_temp("person_inside") > 0) {
            switch (random(2)) {
            case 0:
                message_vision("$N轻轻地敲了敲门，只听见里面有人很不耐烦地吼到：\n刚躺下就来敲门！我睡着了，听不见！！！\n", this_player());
                break;
            case 1:
                message_vision("$N轻轻地敲了敲门，只听见里面有些响动，\n好象有人在踱来踱去，拿不定主意是否开门。\n", this_player());
                break;
            }
        } else {
            v1->delete_temp("sleeping_person");
            message_vision("$N轻轻地敲了敲门：咚、咚、咚．．．咚、咚、咚．．．\n", this_player());
        }
    }
    if (objectp(v1)) {
        message("vision", "外面传来一阵敲门声，你从门缝往外一瞧，是" + this_player()->query("name") + "一脸焦急地站在门外，\n看样子也想进来休息。\n", v1);
    }
    return 1;
}

int do_push(mixed arg) {
    mixed v1;
    if (query("exits/north")) {
        return notify_fail("门已经是开着了。\n");
    }
    if (!arg || arg != "door" && arg != "men") {
        return notify_fail("你要推什么？\n");
    }
    if (!(v1 = find_object("/d/wudang/xiuxishi"))) {
        v1 = find_object("/d/wudang/xiuxishi", 1);
    }
    if (objectp(v1)) {
        if (v1->query_temp("person_inside") <= 0) {
            v1->delete_temp("person_inside");
            set("exits/north", "/d/wudang/xiuxishi");
            message_vision("$N轻轻地把门推开。\n", this_player());
            v1->set("exits/south", "/d/wudang/donglang2.lpc");
            remove_call_out("close_men");
            call_out("close_men", 10);
        } else {
            message_vision("$N想把门推开，却发觉门被人从里面闩上了。\n", this_player());
        }
    }
    return 1;
}

string look_men() {
    mixed v1;
    if (query("exits/north")) {
        return "门上挂了个牌子：南柯梦处\n";
    }
    if (!(v1 = find_object("/d/wudang/xiuxishi"))) {
        v1 = find_object("/d/wudang/xiuxishi", 1);
    }
    if (objectp(v1)) {
        if (v1->query_temp("person_inside") > 0) {
            return "门上挂了个牌子：请毋打扰\n";
        }
    }
    return "门上挂了个牌子：休息室\n";
}

int valid_leave(mixed arg1, mixed arg2) {
    mixed v1;
    if (!(v1 = find_object("/d/wudang/xiuxishi"))) {
        v1 = find_object("/d/wudang/xiuxishi", 1);
    }
    if (objectp(v1) && arg2 == "north") {
        v1->add_temp("person_inside", 1);
        remove_call_out("force_open");
        call_out("force_open", 599, v1);
    }
    return ::valid_leave(arg1, arg2);
}

int force_open(mixed arg) {
    if (!objectp(arg)) {
        return 0;
    }
    if (arg->query_temp("person_inside") <= 0) {
        return 0;
    }
    arg->delete_temp("person_inside");
    set("exits/north", "/d/wudang/xiuxishi");
    arg->set("exits/south", "/d/wudang/donglang2.lpc");
    message("vision", "外面突然响起粗重的脚步声，由远而近，到门前停了下来．．．\n张松溪啪地把门打开，伸个头进来，一脸狐疑：呆大半天了还不出去，搞什么鬼？\n", arg);
    remove_call_out("close_men");
    call_out("close_men", 10);
}
