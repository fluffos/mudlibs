    if (!objectp(present("xiao cui", this_object()))) {
        arg1->delete_temp("tea_cup");
        return ::valid_leave(arg1, arg2);
    }
    if (arg2 == "north" && (present("xiang cha", this_player()) && present("mi tao", this_player())) && objectp(present("xiao cui", environment(arg1)))) {
        switch (random(2)) {
        case 0:
            return notify_fail("小翠把嘴一撇：吃饱了喝足了还不够，临走怀里还揣上一些，小女子也替您脸红呢！\n");
            break;
        case 1:
            message_vision("小翠对$N道了个万福：张真人吩咐，饮食不得带出茶房。", arg1);
            return notify_fail("\n");
            break;
        }
    } else {
    }
    arg1->delete_temp("marks/sit");
    arg1->delete_temp("tea_cup");
    return ::valid_leave(arg1, arg2);
}
