void create() {
    set("short", "茶室");
    set("long", "满屋的果香和茶香，沁人心脾。山西面的茶农们因感激武当弟子\n保护他们免受土匪的骚乱和官府的苛捐杂税，每年开春采茶季节，总\n要送来上好的茶叶。这茶叶由少女在三更至日出间采摘，并放在怀中\n用体温焙制，得天地精华，汇处子体香，故名＂女儿香＂，据说喝了\n能提精补神，十分珍贵。屋里四周得体地摆着些桌子(table)和椅子\n(chair)，坐满了武当的男女弟子。南边有扇窗子(window)，景色宜\n人。\n");
    set("exits", ([ "west" : "/d/wudang/liantai" ]));
    set("item_desc", ([ "table" : "一张典雅的桃木小桌，上面放着水果盘和饮茶器具。\n", "chair" : "一只青竹打制的靠椅，躺(sit)上去摇摇晃晃，好舒服耶！\n", "window" : "可以看得见东南远处桃花一片，拟似彩云盖地，让人神往。窗子下面就是广场．\n" ]));
    set("objects", ([ "/d/wudang/npc/xiaocui" : 1, "/d/wudang/obj/mitao" : 2, "/d/wudang/obj/xiangcha" : 1 ]));
    set("no_fight", 1);
    setup();
}

void init() {
    add_action("do_jump", "jump");
    add_action("do_tap", "tap");
    add_action("do_tap", "knock");
    add_action("do_sit", "sit");
}

int do_jump(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    v2 = this_player()->query_dex();
    if (arg != "window" && arg != "out") {
        return command("jump " + arg);
    }
    v1->delete_temp("marks/sit");
    v1->delete_temp("tea_cup");
    message_vision("$N＂嗖＂地一声跳出窗户。\n", v1);
    if (v2 <= 23 && random(3) < 2 || v2 > 23 && v2 <= 26 && random(2)) {
        message_vision("结果＂啪＂地一声$N在下面的广场上摔了个结结实实。\n", v1);
        if (objectp(v3 = present("mi tao", this_player()))) {
            message_vision("水蜜桃砸烂了，溅了$N一屁股桃汁。\n", v1);
            destruct(v3);
            return 1;
        }
        if (objectp(v3 = present("xiang cha", this_player()))) {
            message_vision("怀里的香茶翻了，湿了$N一裤子茶水。\n", v1);
            destruct(v3);
            return 1;
        }
        v1->receive_damage("qi", 60, v1);
        v1->receive_wound("qi", 40, v1);
        v1->improve_skill("dodge", random(3));
    } else if (v2 <= 26) {
        message_vision("$N摇摇晃晃地落在下面的广场上，差点摔倒！\n", v1);
        v1->improve_skill("dodge", random(2));
    } else {
        message_vision("$N提一口气，姿态潇洒地飘落在下面广场上！\n", v1);
    }
    v1->move("/d/wudang/guangchang");
    return 1;
}

int do_tap(mixed arg) {
    mixed v1;
    mixed v2;
    if (!arg || arg != "desk" && arg != "table") {
        return notify_fail("你要敲什么？\n");
    }
    v1 = this_player();
    if (!objectp(v2 = present("xiao cui", environment(v1)))) {
        return notify_fail("你敲了敲桌子，却还是没人理你。你突然感觉自己很无聊。\n");
    }
    if (!v1->query_temp("marks/sit")) {
        return notify_fail("你敲了敲桌子，却没想到有对年轻人从桌底下钻出来，愕然地看着你，\n你突然感觉自己很愚蠢。\n");
    }
    if (v1->query_temp("marks/served")) {
        message_vision("小翠不耐烦地对$N说道：刚给你上过茶你接着就要，你是个Ｒｏｂｏｔ我可不是啊！\n", v1);
        return notify_fail("");
    }
    message_vision("$N端坐在桌前，轻轻扣了下桌面，小翠莞尔一笑，过来招呼。\n", v1);
    v2->serve_tea(v1);
    v1->set_temp("marks/served", 1);
    call_out("delete_served", 10, v1);
    return 1;
}

void delete_served(mixed arg) {
    if (objectp(arg)) {
        arg->delete_temp("marks/served");
    }
}

int do_sit(mixed arg) {
    if (!arg || arg != "chair") {
        return notify_fail("你要坐什么上面？\n");
    }
    if (this_player()->query_temp("marks/sit")) {
        return notify_fail("你已经有了个座位了。\n");
    }
    this_player()->set_temp("marks/sit", 1);
    return notify_fail("你找了个空位座下，等着上茶。\n");
}

