inherit "/inherit/room/room";
void create();
void init();
void check_trigger();
int do_push(mixed);
int pushstone(mixed);

void create() {
    set("short", "后院");
    set("long", "后院是一大片开阔的草地，绿草如荫，几朵野花点缀其间，草\n地中间放着一块大石刻成的棋盘，一个黄眉老僧和一个青袍客正在\n下棋。北边有一间石屋，门口被一块大石头挡住了。\n");
    set("outdoors", "wanjiegu");
    set("exits", ([ "south" : "/d/wanjiegu/hall" ]));
    set("objects", ([ "/d/wanjiegu/npc/monk" : 1 ]));
    set("no_clean_up", 0);
    set("item_desc", ([ "大石头" : "一块很大的石头，挡住了石屋的入口。\n", "rock" : "一块很大的石头，挡住了石屋的入口。\n" ]));
    setup();
}

void init() {
    add_action("do_push", "push");
}

void check_trigger() {
    if (query("trigger") == 9 && !query("exits/north")) {
        message("vision", "\e[1;37m大石终于被推开了，露出通向石屋的通道。\n\e[2;37;0m", this_object());
        set("exits/north", "/d/wanjiegu/stone_room");
        delete("trigger");
    }
}

int do_push(mixed arg) {
    mixed v2;
    v2 = this_player();
    if (v2->is_busy()) {
        message_vision("你的上一个动作还没有完成！\n", v2);
        return 1;
    }
    if (!arg || arg == "") {
        write("你要干什么？\n");
        return 1;
    }
    if (arg == "rock" || arg == "大石头") {
        if (v2->query("str") + v2->query("neili_factor") < 15) {
            tell_object(v2, "你的力气太小了，用点内力试试看！\n");
            return 1;
        }
        v2->start_busy(2);
        message_vision("\e[1;37m$N气运丹田，发内力推动大石头。\n\e[2;37;0m", v2);
        call_out("pushstone", 2, v2);
        v2->stop_busy();
        check_trigger();
        return 1;
    }
}

int pushstone(mixed arg) {
    if (arg->query("neili") >= arg->query("neili_factor")) {
        message_vision("\e[1;37m大石头动了一下。\n\e[2;37;0m", arg);
        arg->add("neili", -arg->query("neili_factor"));
        add("trigger", 1);
        return 1;
    } else {
        tell_object(arg, "你的内力不够了，休息一会再推吧！\n");
        return 1;
    }
}

