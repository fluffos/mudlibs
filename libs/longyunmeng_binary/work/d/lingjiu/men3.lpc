// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//ROOM men3.c
inherit ROOM;
void create()
{
    set("short", "闭关室大门");
        set("long",
         "这是闭关室南边，北面有一扇大门。\n"
           );
        set("outdoors", "lingjiu");
        set("exits", ([
        "north" : __DIR__"biguan",
        "south" : __DIR__"xiaodao2",
        ]));
 
        set("objects",([
        __DIR__"npc/shisao" : 1,
    ]));
        setup();
}
int valid_leave(object me, string dir)
{
    object ob;
    ob=present("shi sao", environment(me));
    if (ob && living(ob)){
        if (  (dir == "north")  && ((string)me->query("family/family_name") != "灵鹫宫"))
         return notify_fail("石嫂伸手拦住你，说道：“对不起，本门重地，请回！”\n");
    }
        return ::valid_leave(me, dir);
}
