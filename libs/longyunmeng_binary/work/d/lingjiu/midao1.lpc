// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit ROOM;
void create()
{
    set("short", "密道");
    set("long", @LONG
你的眼前是一条用汉白玉铺成的台阶，一直向下延伸，两边的墙壁都
是花岗岩，墙上隔十来步就有一盏油灯，使你能看清周围。
LONG
    );
    set("exits", ([
        "up" : __DIR__"huayuan",
        "northdown": __DIR__"midao2",
    ]));
    set("objects",([
        __DIR__"npc/nvlang" : 1,
    ]));
    setup();
}
int valid_leave(object me, string dir)
{
    object ob;
    ob=present("nv lang", environment(me));
    if (ob && living(ob)){
        if (  (dir == "northdown") && ((string)me->query("family/family_name") != "灵鹫宫") )
        return notify_fail  ("蒙面女郎伸手拦住你，说道：“对不起，本门重地，请回！”\n");
    }
    return ::valid_leave(me, dir);
}
