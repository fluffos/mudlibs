// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// qjc 2000/5/3 

inherit ROOM;

void create()
{
	set("short", "悠云阁");
	set("long", "这是一座建于崖边的楼阁，楼外白云渺
渺把整座楼都笼罩在一片白雾之中。楼前的山崖上有一座小石瀑，
瀑下的石潭不少鱼儿悠闲得游来游去。楼旁的空地上摆了一张石
几和几张石凳，上面放着一张棋盘(qi)。离石几不远还有一块靠
着潭边的突出岩石，在上面钓鱼倒很不错。这儿是啸天长老悠云
的隐居之地，不过现在不知他又在何处云游了。\n");

	set("exits", ([
                "east" : __DIR__"zly",
	]));
	setup();
	replace_program(ROOM);
}

