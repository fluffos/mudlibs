// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ITEM;
void init();
int do_dian(string arg);
void create()
{
    set_name("入会香", ({ "baixiang" }) );
    set_weight(30);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "柱");
                set("long", "这是一柱香,你可以点燃它(dian)。\n");
        set("value", 100);
        set("material", "wood");
    }
    setup();
}
void init()
{
    add_action("do_dian", "dian");
}
int do_dian(string arg)
{
    object me;
    me = this_player();
    if(!arg||arg!="baixiang")
        return notify_fail("你要点燃什么东西？\n");
    else
        {
            me->set_temp("marks/dian_temp",1);
        return notify_fail("你点燃一柱香拿在手中。\n");
        }       
    return 0;
}
int query_autoload() { return 1; }