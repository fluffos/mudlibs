// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.


inherit ROOM;

void create()
{
        set("short", "清风堂");
        set("long",@LONG
素幔低垂，设备朴素，临窗的桌上堆满卷轴，一大桶毛笔显示出主
人学识渊博。一只剑形花瓶插着几朵犁花，带来几分清新的气息。
LONG );
        set("exits", ([
"east" : __DIR__"canheje",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

