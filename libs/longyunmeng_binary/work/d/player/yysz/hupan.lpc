void check_trigger() {
    mixed v1;
    if (!query("exits/enter")) {
        if (!(v1 = find_object("/d/player/yysz/xiaozhou"))) {
            v1 = find_object("/d/player/yysz/xiaozhou", 1);
        }
        if (v1 = find_object("/d/player/yysz/xiaozhou")) {
            if (!v1->query("yell_trigger")) {
                v1->set("yell_trigger", 1);
                set("exits/enter", "/d/player/yysz/xiaozhou");
                v1->set("exits/out", "/d/player/yysz/hupan.lpc");
                message("vision", "一尾小舟缓缓地驶了过来，一个漂亮无比的少女招手让你登舟。\n", this_object());
                remove_call_out("on_board");
