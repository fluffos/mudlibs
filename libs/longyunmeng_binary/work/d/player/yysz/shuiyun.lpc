// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit ROOM;

void create()
{
        set("short", "水云轩");
        set("long",@LONG
湖心的一座小小的亭台，四面环水，只有西侧有一条曲桥与岸上相
连。轩中清风拂面，水波微扬，一群群游鱼清晰可见，别有一番诗情画
意。
LONG );
        set("outdoors", "yysz");
        set("exits", ([
            "west" : __DIR__"jiashan",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

