void create() {
    set("short", "议事大厅");
    set("long", "\t这里是唐门的议事大厅。平时一般不使用，只有在唐门发生重大事情的时\n候，唐门的长辈才在这儿聚集商量。整个大厅建筑得很奇怪，四周有八根朱红大柱\n地面黝黑发亮，是唐门平时冶炼暗器所剩的铁屑溶制成的整块。正中是一个很大的\n八卦图(bagua)。\n");
    set("valid_startroom", 1);
    set("exits", ([ "west" : "/d/tangmen/jingyitang", "east" : "/d/tangmen/xingtang", "north" : "/d/tangmen/changlang2", "south" : "/d/tangmen/changlang8" ]));
    set("objects", ([ "/d/tangmen/npc/dizi" : 4 ]));
    set("item_desc", ([ "bagua" : "\e[1;33m很奇怪的八卦图，不知道唐门为什么要在这儿刻上它。\n" ]));
    setup();
}

void init() {
    add_action("do_break", "break");
}

int do_break(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!arg || arg != "bagua") {
        write("唐门的财物岂是你随便能破坏的！\n");
        return 1;
    }
    if (this_player()->query_temp("marks/闹")) {
        message_vision("$N走到八卦前，腾身而起，运起全身内力，双掌自上而下重重击向八卦。\n", this_player());
        v1 = v2->query("neili");
        if (v1 >= 1500) {
            message_vision("\e[1;31m$N只听轰得一声巨响！！！八卦竟然翻转，面前出现一个洞。\n\e[2;37;0m", this_player());
            set("exits/down", "/d/tangmen/qiushi");
            this_player()->set("neili", v1 - 1500);
            remove_call_out("close");
            call_out("close", 10, this_object());
        } else {
            message_vision("\e[1;37m结果只听一声闷哼，$N被八卦的反弹力震得眼前一黑....\n\e[2;37;0m", this_player());
            this_player()->set("neili", 0);
            this_player()->unconcious();
        }
        v2->delete_temp("marks/闹");
        return 1;
    } else {
        write("\e[1;33m你娃脑壳有包啊？看到是铁砣砣都要去打！\n\e[2;37;0m");
        return 1;
    }
}

void close(mixed arg) {
    message("vision", "只听见一阵嘎嘎的响声，八卦又翻了转来，恢复了原样。\n", arg);
    arg->delete("exits/down");
}
