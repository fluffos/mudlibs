inherit ROOM;
void create()
{
	set("short", "曲廊");
	set("long", @LONG
	弯弯曲曲的回廊，廊下就是藕香湖水，湖面满是翠绿的荷叶，中间点缀着朵
朵粉色荷花，偶尔可以看到几条鱼儿在荷间游弋。远处飘来时断时续的忧郁琴音，听
着让人黯然神伤。
LONG
	);
        set("outdoors", "tangmen");
	set("exits", ([
		"westup" : __DIR__ "jiaolou3",
		"east" : __DIR__ "ouxiang",
        ]));
	setup();
	replace_program(ROOM);
}

