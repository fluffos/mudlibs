void create() {
    set("short", "兵器库");
    set("long", "\t这里是唐门的兵器库，里面整整齐齐堆放着各种各样的暗器及刀剑，唐门弟子\n可以在这儿取用。库里还有火炉和铁锤，可以自己升火打造(da)钢镖。\n");
    set("exits", ([ "north" : "/d/tangmen/changlang4", "west" : "/d/tangmen/xingtang", "east" : "/d/tangmen/xiaoxiao-lou" ]));
