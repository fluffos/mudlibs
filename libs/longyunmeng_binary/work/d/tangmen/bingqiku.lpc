    add_action("do_sheng", "sheng");
}

int do_da(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg || arg != "biao") {
        return notify_fail("你要干什么？\n");
    }
    if (v1->query_temp("marks/镖")) {
        if (v1->query("qi") < 10) {
            write("你已经太累了，休息一会儿再打吧。\n");
            return 1;
        }
        v1->receive_damage("qi", 5);
        message_vision("$N满头大汗，挥舞着铁锤。\n", v1);
        v2 = clone_object("/d/tangmen/obj/gangbiao1");
        v2->move(this_player());
        message_vision("$N已经打好了一枚钢镖。\n", v1);
        return 1;
    }
    write("火已经熄灭了，你还是把火生起来再说吧。\n");
    return 1;
}

int do_sheng(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "huo") {
        return notify_fail("你要干什么？\n");
    }
    if (v1->query_temp("marks/镖")) {
        write("火已经生着了。\n");
        return 1;
    }
    message_vision("$N往炉中添了些木炭，拿起风箱开始升火。\n", v1);
    message_vision("\e[1;31m炉火熊熊燃了起来。\n\e[2;37;0m", v1);
    this_player()->set_temp("marks/镖", 1);
    remove_call_out("fire");
    call_out("fire", 20, this_object());
    return 1;
}

void fire(mixed arg) {
    message("vision", "\e[1;33m只见炉火扑闪了几下，熄了。\n\e[2;37;0m", arg);
    this_player()->delete_temp("marks/镖");
}
