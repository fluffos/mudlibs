                v1->set("yell_trigger", 1);
                set("exits/enter", "/d/tangmen/huafang");
                v1->set("exits/out", "/d/tangmen/fufeng.lpc");
                message("vision", "一座画舫缓缓地驶了过来，唐菱将一块踏脚板搭上堤岸，以便乘客\n上下。\n", this_object());
                message("vision", "唐菱将一块踏脚板搭上堤岸，形成一个向上的阶梯。\n", v1);
