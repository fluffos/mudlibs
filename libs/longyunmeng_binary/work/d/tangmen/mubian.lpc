inherit ROOM;

void create()
{
	set("short","匾后");
	set("long",
        "这里匾的后面，集满了许多灰尘。你用袖子掸了掸，发现好象有什么东西。\n"
     );

	set("exits",([
		"down" : __DIR__"jizuting",
      ]));
	set("objects",([
		__DIR__"obj/anqibook" : 1,
	]));


 setup();
 replace_program(ROOM);
}




