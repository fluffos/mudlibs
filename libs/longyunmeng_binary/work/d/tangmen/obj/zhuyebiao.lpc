// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// zhuyebiao.c
#include <weapon.h>
inherit THROWING;

void create()
{
	set_name("竹叶镖", ({"zhuyebiao", "biao" }));
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "这是一把形如竹叶的飞镖。\n");
		set("unit", "些");
                set("base_value", 1);
		set("material", "steel");
                set("base_unit", "枚");
		set("base_weight", 10); 
	}	
        set_amount(300);
        init_throwing(80);
        setup();
}


