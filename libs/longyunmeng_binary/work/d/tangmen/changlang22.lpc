// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//room: /d/tangmen/changlang22.c
// by HEM
inherit ROOM;

void create()
{
  set("short","长廊");
  set("long",
      "这里一段长廊，两旁是红木廊柱，顶上有很漂亮的漆画和书法。每一段长廊的\n"
"书画恰好都组成了一个故事或是一个久远的传说。\n"
     );

  set("exits",([
      "south" : __DIR__"changlang21",
      "north" : __DIR__"huayuan8",
    ]));

 setup();
 replace_program(ROOM);
}




