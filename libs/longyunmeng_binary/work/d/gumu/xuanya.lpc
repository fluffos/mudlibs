inherit "/inherit/room/room";
void create();
void init();
int do_tiao(mixed);
int do_yao(mixed);
int do_climb(mixed);

void create() {
    set("short", "\e[1;35m悬崖\e[2;37;0m");
    set("long", "此处已是绝路，光秃秃的石壁，下面则是云雾弥漫的万丈深崖(xuanya)，\n传闻中有个古墓弟子因受不了古墓之清苦寡欲，从此处一跃而下，了却一生，\n近悬崖边有棵摩天大树(tree)，枝叶极盛，如大伞一张遮掩住方圆之地。\n");
    set("outdoors", "古墓");
    set("exits", ([ "north" : "/d/gumu/rukou" ]));
    set("item_desc", ([ "xuanya" : "\e[1;35m悬崖下只是一片云雾缭绕。跳(tiao)下去恐是有去无回。\n\e[2;37;0m", "tree" : "一棵高大的巨树,上面留下曾经被人摇晃的痕迹。\n" ]));
    setup();
}

void init() {
    add_action("do_tiao", "tiao");
    add_action("do_yao", "yao");
    add_action("do_climb", "climb");
}

int do_tiao(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (arg == "xuanya") {
        if (v1->query_temp("mark/jump") < 2) {
            write("人生苦短,且古墓神功绝世,你再考虑一下吧. \n");
            v1->add_temp("mark/jump", 1);
            return 1;
        }
        message_vision("\e[1;31m$N纵身跳下悬崖,悲呼一声,兄弟姐妹们,来生再见,回声不绝于耳。\n", v1);
        v1->delete_temp("mark/jump");
        v1->set_temp("last_damage_from", "跳崖自杀而");
        v1->unconcious();
        v1->move("/d/gumu/yading");
        v1->die();
        return 1;
    }
    return notify_fail("你要跳到哪里？\n");
}

int do_yao(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!(v1 = v2->query("family")) || v1["family_name"] != "古墓派") {
        return notify_fail("你不是古墓传人，如何能领悟古墓武功？\n");
    }
    if (v2->is_busy() || v2->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (v2->query("jing") < 30) {
        return notify_fail("你精力不能集中,去稍作歇息吧. \n");
    }
    if (arg == "tree") {
        if (v2->query_skill("parry", 1) < 50) {
            return notify_fail("你使出浑身的劲力，但是大树却纹丝不动。\n");
        }
        if (v2->query_skill("parry", 1) > 100) {
            return notify_fail("你使劲地摇晃大树，发现大树快被你摇断了。\n");
        }
        write("你使劲地摇晃着大树，震的大树微微晃动。\n");
        v2->receive_damage("jing", random(20) + 10);
        v2->improve_skill("parry", v2->query_int() / 3 + v2->query_skill("parry") / 4);
        return 1;
    }
    return notify_fail("你要摇什么？\n");
}

int do_climb(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (arg == "tree") {
        message_vision("\e[33m$N腾身往大树上爬去。\n\e[2;37;0m", v1);
        if (v1->query_skill("dodge", 1) < 1500) {
            message_vision("\e[1;31m结果$N从树上一个筋斗掉下来。\n\e[2;37;0m", v1);
            v1->receive_wound("qi", random(5) + 5);
            return 1;
        }
        message_vision("\e[1;33m$N很快消失在浓荫密叶中。\n\e[2;37;0m", v1);
        v1->move("/d/gumu/shushang");
        return 1;
    }
    write("你想往哪爬? \n");
}
