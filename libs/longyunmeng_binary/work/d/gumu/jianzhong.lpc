void create() {
    set("short", "\e[1;37m剑冢\e[2;37;0m");
    set("long", "搬开冢上石块，露出并列著的三柄长剑。在第一、第二两把剑之间，另有\n一块长条石片。三柄剑和石片并列於一块大青石之上。  \n");
    setup();
}

void init() {
    add_action("do_ti", "ti");
    add_action("do_tui", "tui");
}

int do_ti(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg) {
        return 0;
    }
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (arg == "gangjian") {
        if (v1->query_temp("sword")) {
            return notify_fail("你已经看过第一把剑了啊。\n");
        }
        message_vision("\e[1;33m$N提起右首第一柄剑，只见剑下的石上刻有两行小字：「凌厉刚猛，无坚不\n摧，弱冠前以之与河朔群雄争锋。」\n\e[2;37;0m", v1);
        v1->set_temp("sword", 1);
        return 1;
    } else if (arg == "xuantiejian") {
        if (!v1->query_temp("sword")) {
            return notify_fail("什么？\n");
        }
        if (v1->query_str() < 30) {
            return notify_fail("你用力想提起玄铁剑，但力不从心。\n");
        }
        if (v1->query("max_neili") < 30000) {
            message_vision("\e[1;33m$N再伸手去提第二柄剑，只提起数尺，呛啷一声，竟然脱手掉下，在石上一\n碰，火花四溅，不禁吓了你一跳。\n\e[2;37;0m", v1);
            v1->add("neili", -300);
            return 1;
        }
        v1->add("neili", -300);
        v1->delete_temp("sword");
        v1->delete_temp("sword1");
        v1->set_temp("sword2", 1);
        v2 = clone_object("/d/gumu/obj/xuantiejian");
        if (!clonep(v2)) {
            return notify_fail("\e[1;31m你来晚了，玄铁剑已经给人取走了。\n\e[2;37;0m");
        }
        v2->move(v1);
        v1->set_temp("jian_get", 1);
        message_vision("\e[1;33m於是$N再俯提起，这次有了防备，提起七八十斤的重物自是不当一回事。见那\n剑两边剑锋都是钝口，剑尖更圆圆的似是个半球。看剑下的石刻时，见两行小\n字道：「重剑无锋，大巧不工。四十岁前恃之横行天下。」\n\e[2;37;0m", v1);
        return 1;
    } else if (arg == "mujian") {
        if (!v1->query_temp("sword2")) {
            return notify_fail("你想提起什么？\n");
        }
        message_vision("\e[1;33m$N力运左臂去取第三柄剑。那知拿在手中却轻飘飘的浑似无物，凝神一看，原\n来是柄木剑，年深日久，剑身剑柄均已腐朽，但见剑下的石刻道：「四十岁後，\n不滞於物，草木竹石均可为剑。自此精修，渐进於无剑胜有剑之境。」\n\e[2;37;0m", v1);
        v1->delete_temp("sword2");
        return 1;
    }
}

int do_tui(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (!arg || arg != "shi") {
        return notify_fail("你要推什么？\n");
    }
    if (arg == "shi") {
        message_vision("\e[33m$N深深地吸了口气，缓缓推动青石。\n\n\e[2;37;0m", v1);
    }
    write("\e[1;32m你把青石推开！露出了剑冢的出口。\n\e[2;37;0m");
    set("exits/out", "/d/gumu/pingtai");
    remove_call_out("close");
    call_out("close", 5, this_object());
    return 1;
}

void close(mixed arg) {
    message("vision", "\e[1;33m青石慢慢移回了原位，又挡住了出口。\n\e[2;37;0m", arg);
    arg->delete("exits/out");
}
