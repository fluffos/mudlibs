inherit "/inherit/room/room";
void create();
void init();
int do_zuo(mixed);
int do_liao(mixed);

void create() {
    set("short", "\e[1;36m休息室\e[2;37;0m");
    set("long", "这里是古墓弟子的休息室，房中空空洞洞，一如古墓无异。一块长条青石\n作床，床上铺了张草席，一幅白布当作薄被，此外除了一根人高的绳索横过室\n中，别无他物。\n");
    set("exits", ([ "north" : "/d/gumu/gmht" ]));
    set("objects", ([ "/d/gumu/obj/bed" : 1 ]));
    set("sleep_room", 1);
    set("no_fight", 1);
    create_door("north", "石门", "south");
    setup();
}

void init() {
    add_action("do_zuo", "zuo");
    add_action("do_liao", "liao");
}

int do_zuo(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (v2->is_busy() || v2->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (!(v1 = v2->query("family")) || v1["family_name"] != "古墓派") {
        return notify_fail("你不是古墓传人，如何能领悟古墓武功？\n");
    }
    if (arg == "bed") {
        if (v2->query("qi") < 40) {
            return notify_fail("你的气太少，无法抵御严寒。\n");
        }
        if (v2->query("potential") - v2->query("learned_points") < 1) {
            return notify_fail("你的潜能没了，不能再继续修习了\n");
        }
        write("\e[1;36m你往寒玉床上盘腿而坐。\n\e[2;37;0m");
        if (v2->query_skill("force", 1) < 20) {
            message_vision("\e[1;31m$N还未坐稳,就怪叫一声, 从床上跳了下来，想必是受不了千年古玉之寒气。\n\e[2;37;0m", v2);
            return 1;
        }
        if (v2->query("potential") - v2->query("learned_points") < 0) {
            return notify_fail("你的潜能不够了。\n");
        }
        if (v2->query_skill("yunu-xinjing", 1) > 50) {
            return notify_fail("你的玉女心经已有相当火厚,寒玉床不能再助你修习内功了。\n");
        }
        write("借寒玉床之天然神效，真气自然流动，你开始修习内功心法，当真灵验无比。 \n\e[2;37;0m");
        v2->receive_damage("qi", random(15) + 10);
        v2->add("potential", -1);
        v2->start_busy(random(2));
        v2->improve_skill("yunu-xinjing", v2->query_int() / 2 + v2->query_con() / 2);
        return 1;
    }
    return notify_fail("你要坐在哪里? \n");
}

int do_liao(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->is_fighting() || v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    if (this_player()->query("eff_qi") == this_player()->query("max_qi")) {
        return notify_fail("你现在身上没有受到任何伤害！\n");
    }
    if (v1->query_condition("marks_bed") > 0) {
        v1->receive_wound("qi", 10);
        message_vision("\e[1;31m$N突然只觉一阵奇寒侵入身体，想是两次疗伤时隔太短，身子尚未复原之故。\n\e[2;37;0m", v1);
        v1->unconcious();
        return 1;
    }
    if (arg == "bed") {
        message_vision("\e[1;33m$N爬上寒玉床, 要借千年寒玉疗伤. \n\e[2;37;0m", v1);
        if (v1->query_skill("yunu-xinjing", 1) < 40) {
            return notify_fail("寒玉床疗伤需以纯熟的玉女心经内功相辅, 否则无法外疗. \n");
        }
        v1->set("eff_qi", v1->query("max_qi"));
        v1->apply_condition("marks_bed", 25);
        return 1;
    }
    return notify_fail("你要在哪疗伤? \n");
}
