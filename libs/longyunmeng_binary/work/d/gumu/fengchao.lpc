inherit "/inherit/room/room";
void delete_hexiu(mixed, mixed);
void create();
void init();
int do_tong(mixed);
void danger(mixed);

void create() {
    set("short", "\e[1;31m蜂巢\e[2;37;0m");
    set("long", "这丛红花排开来长达数丈，密密层层，奇香扑鼻，但见花丛有如一座大屏\n风，红瓣绿枝，煞是好看，四下里树荫垂盖，便似天然结成的一座花房树屋。\n四周都是一片清幽，只闻泉声鸟语，杳无人迹，确是个上好的练功所在。\n");
    set("exits", ([ "eastdown" : "/d/gumu/guoyuan" ]));
    set("outdoors", "古墓");
    setup();
}

void init() {
    add_action("do_tong", "tong");
}

int do_tong(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着呢。\n");
    }
    if (!(v2 = v1->query("family")) || v2["family_name"] != "古墓派") {
        return notify_fail("你不是古墓派传人，不要再在古墓久留了。\n");
    }
    if (arg == "fengchao") {
        if (v1->query_condition("gumu_job") > 0) {
            return notify_fail("你捅了半天发现蜂巢里什么都没有了。\n");
        }
        if (v1->query("combat_exp") < 30000) {
            return notify_fail("采蜂蜜很危险，你现在还不能干。\n");
        }
        if (v1->query("combat_exp") > 120000) {
            return notify_fail("你武功已经够高，采蜂蜜的事就让小弟子们去做吧。\n");
        }
        if (v1->query_temp("gm_fengmi")) {
            return notify_fail("你不是已经采了蜂蜜了么？\n");
        }
        message_vision("\e[1;33m$N用力捅了捅蜂巢，从中挖出了不少蜂蜜。\n\e[2;37;0m", v1);
        clone_object("/d/gumu/obj/fengmi")->move(v1);
        v1->start_busy(5);
        call_out("danger", 3, v1);
        return 1;
    }
    return notify_fail("你胡乱捅了几下，结果什么也没有发生。\n");
}

void danger(mixed arg) {
    mixed v1;
    tell_object(arg, "\e[1;31m你隐约感觉到有东西围了过来....，着眼四观，发现自己被包围了。\n\e[2;37;0m");
    clone_object("/d/gumu//npc/beast")->move("/d/gumu/fengchao");
    v1 = present("feng mi", arg);
    destruct(v1);
    tell_object(arg, "\e[31m你紧张起来，蜂蜜随手落在地上。\n\e[2;37;0m");
    arg->set_temp("gm_fengmi", 1);
}
