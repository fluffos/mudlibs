// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// fengmi1.c 蜂蜜 By csy 98/12
#include <ansi.h>;
inherit ITEM;
inherit F_FOOD;
void create()
{
     set_name(HIC"蜂蜜"NOR, ({"feng mi","fengmi"}));
     set_weight(25);
     if (clonep())
     set_default_object(__FILE__);
     else {
     set("unit", "堆");
     set("long", "蜂蜜散发出诱人的香味。\n");
     set("no_get", 1);
     set("no_drop", 1);
     set("no_give", 1); 
     set("food_remaining", 1);
     set("food_supply", 50); 
     setup();
     }
}
int query_autoload() { return 1; }
