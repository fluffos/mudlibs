// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// bee2.c  By csy 98/12
inherit NPC;
#include <ansi.h>
#include "bee2.h"
void create()
{
        set_name("玉蜂", ({ "yu feng", "bee","feng" }) );
        set("race", "野兽");
        set("age", 4);
        set("long", "一只可爱的玉蜂，可能是小龙女以前饲养的。\n");
        set("attitude", "peaceful");         

        set("str", 20);
        set("con", 30);

        set("limbs", ({  "身体",  "翅膀" , "头部" }) );
        set("verbs", ({ "bite" }) );

        set("combat_exp", 5000);

        set_temp("apply/attack", 35);
        set_temp("apply/damage", 23);
        set_temp("apply/armor", 24);

        setup();
}

void die()
{
        message_vision("\n$N被你一下挥落，魂消烟散，尸骨全无。\n", this_object()); 
        destruct(this_object());
}

