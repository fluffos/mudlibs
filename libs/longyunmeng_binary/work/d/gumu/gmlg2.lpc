inherit "/inherit/room/room";
void create();
void init();
int do_yanxi(mixed);
int do_xiulian(mixed);
int do_tui(mixed);
void close(mixed);

void create() {
    set("short", "\e[1;31m练功房\e[2;37;0m");
    set("long", "一间石室，形状甚是奇特，前（frontwall)窄后(backwall)宽，成为梯形，\n东(eastwall)边半圆，西(westwall)边却作三角型。室顶石板上刻满诸般花纹\n符号，均是已利器刻成，或深或浅，殊无规则。此处供古墓弟子修炼入门外功。\n");
    set("exits", ([ "south" : "/d/gumu/gmzt" ]));
    setup();
}

void init() {
    add_action("do_xiulian", "xiulian");
    add_action("do_yanxi", "yanxi");
    add_action("do_tui", "tui");
}

int do_yanxi(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!(v1 = v2->query("family")) || v1["family_name"] != "古墓派") {
        return notify_fail("你不是古墓传人，如何能领悟古墓武功？\n");
    }
    if (v2->is_busy() || v2->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (v2->query_skill("literate", 1) < 30) {
        return notify_fail("你丫斗字不识,领悟个啥? \n");
    }
    if (arg == "top") {
        if (v2->query("gender") == "女性") {
            return notify_fail("全真剑法呈阳刚之气，不适合女子练习。\n");
        }
        if (v2->query_skill("sword", 1) < 20) {
            return notify_fail("你基本剑法太差，无法研习全真剑法。\n");
        }
        if (v2->query_skill("quanzhen-jianfa", 1) >= 1) {
            return notify_fail("你已经学会全真剑法，自己好好练吧。\n");
        }
        write("你仰视室顶的图纹，心中揣摩全真剑法的精妙之处。\n");
        v2->receive_damage("jing", 5);
        v2->improve_skill("quanzhen-jianfa", 2);
        return 1;
    }
    return 1;
}

int do_xiulian(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!(v1 = v2->query("family")) || v1["family_name"] != "古墓派") {
        return notify_fail("你不是古墓传人，如何能领悟古墓武功？\n");
    }
    if (v2->is_busy() || v2->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (v2->query("jing") < 20) {
        return notify_fail("你精力不能集中,去稍作歇息吧. \n");
    }
    if (v2->query_skill("literate", 1) < 30) {
        return notify_fail("你丫斗字不识,领悟个啥? \n");
    }
    if (arg == "frontwall") {
        write("你抡掌劈向前方窄窄的石壁，蓬一声被震退数步，手臂一阵酸麻。\n");
        if (v2->query_skill("strike", 1) > 50) {
            return notify_fail("你掌力雄浑，不该再死练蛮力了。\n");
        }
        v2->receive_damage("jing", random(15) + 5);
        v2->improve_skill("strike", v2->query_int() / 3 + v2->query_skill("strike") / 4);
        return 1;
    }
    if (arg == "backwall") {
        write("你挥拳直击弧型后壁，石粉四溅,你也被自己的猛劲震退数步。\n");
        if (v2->query_skill("cuff", 1) > 50) {
            return notify_fail("你拳力已刚猛无比，却无甚招数。\n");
        }
        v2->receive_damage("jing", random(15) + 5);
        v2->improve_skill("cuff", v2->query_int() / 3 + v2->query_skill("cuff", 1) / 4);
        return 1;
    }
    if (arg == "eastwall") {
        write("你绕东面石壁踏着剑步，用心揣摩壁上剑法精髓。\n");
        if (v2->query_skill("sword", 1) > 50) {
            return notify_fail("你对石壁上所述剑法已全然掌握,无须再费力了. \n");
        }
        v2->receive_damage("jing", random(15) + 5);
        v2->improve_skill("sword", v2->query_int() / 3 + v2->query_skill("sword", 1) / 4);
        return 1;
    }
    if (arg == "westwall") {
        write("你虚拈手指,对着西面的三角形石壁,细心操练暗器的收发手势. \n");
        if (v2->query_skill("throwing", 1) > 50) {
            return notify_fail("你暗器收发随心,再不能提高于此. \n");
        }
        v2->receive_damage("jing", random(15) + 5);
        v2->improve_skill("throwing", v2->query_int() / 3 + v2->query_skill("throwing", 1) / 4);
        return 1;
    }
    return 0;
}

int do_tui(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (v2->is_busy() || v2->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (arg == "eastwall") {
        if (!(v1 = v2->query("family")) || v1["family_name"] != "古墓派") {
            return notify_fail("你不是古墓传人，不能进入古墓密室！\n");
        }
        message_vision("\e[33m$N伸手到半圆的弧底推了几下，一块大石缓缓移开，现出一扇洞门。\n\e[2;37;0m", v2);
        set("exits/enter", "/d/gumu/gmlg3");
        v2->receive_damage("qi", 30);
        remove_call_out("close");
        call_out("close", 5, this_object());
        return 1;
    }
    return notify_fail("你要推什么？\n");
}

void close(mixed arg) {
    message("vision", "\e[1;33m大石慢慢退回了原位，又挡住了入口。\n\e[2;37;0m", arg);
    arg->delete("exits/enter");
}
