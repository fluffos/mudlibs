    mixed v1;
    v1 = this_player();
    add_action("do_swim", "swim");
    v1->receive_damage("qi", 500);
    v1->receive_damage("jing", 500);
    message_vision("\e[1;34m$N的真气正在流失，呼吸十分困难。\n\e[2;37;0m", v1);
    if (v1->query("qi") < 10 || v1->query("jing") < 10) {
        v1->set_temp("last_damage_from", "在潜流中被淹");
        v1->unconcious();
        v1->die();
        return;
    }
}

int do_swim(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "southup") {
        return notify_fail("你要游向哪里？\n");
    }
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (arg == "southup") {
        if (v1->query_encumbrance() * 100 / v1->query_max_encumbrance() >= 40) {
            return notify_fail("你身子沉重，用尽全力也无法浮上去!\n");
        }
