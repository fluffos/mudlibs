int do_tiao(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (!arg || arg != "shenyuan") {
        return notify_fail("你要往哪跳？\n");
    }
    if (!v1->query_temp("tiaoya")) {
        write("\e[1;31m这个悬崖如此凶险，你就这么跳下去只怕凶多吉少，你还是再考虑一下吧。\n\e[2;37;0m");
        write("\e[1;31m决定跳就敲（yes），改变主意就敲（no）。\n\e[2;37;0m");
        v1->set_temp("tiaoya", 1);
        return 1;
    }
    write("你到底怎么决定的？\n");
    return 1;
}

int do_yes() {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (!v1->query_temp("tiaoya")) {
        return 0;
    }
    message_vision("\e[1;31m$N犹豫再三，终于下定决心，两眼一闭，涌身向崖底跳去！\n\e[2;37;0m", v1);
    v1->delete_temp("tiaoya");
    message_vision("\e[1;31m\n$N身体冲开迷雾，只感觉耳边生风，向崖底直坠下去。\n\e[2;37;0m", v1);
    if (v1->query("kar", 1) >= 28) {
        if (random(25) >= 20) {
            call_out("win", 1);
            return 1;
        } else {
            call_out("fail", 1);
            return 1;
        }
    }
    return 1;
}

