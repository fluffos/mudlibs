int do_tang(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (arg == "bed") {
        message_vision("\e[1;36m$N附身躺在青石制成的石床上面。\n\e[2;37;0m", v1);
        v1->set_temp("marks/床", 1);
        return 1;
    }
    return notify_fail("你要躺在地上，小心着凉哦！\n");
}

int do_ban(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("marks/床")) {
        return 0;
    }
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着呢！\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你上一个动作还没有完成！\n");
    }
    if (arg == "shiban") {
