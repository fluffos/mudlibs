        }
        message_vision("\e[1;33m$N用力扳动突起的石板，只听得轧轧几响，石床已落入下层石室。\n\e[2;37;0m", v1);
        v1->add("neili", -200);
        v1->delete_temp("marks/床");
        v1->move("/d/gumu/ss0");
        write("\e[1;33m室顶石壁又慢慢自行推上了。\n\e[2;37;0m");
        return 1;
    }
    return notify_fail("你要扳什么？\n");
