}

void init() {
    mixed v1;
    v1 = this_player();
    add_action("do_qian", "qian");
    add_action("do_pa", "pa");
    if (v1->query("jingli", 1) < 20 || v1->query("qi", 1) < 20) {
        v1->set_temp("last_damage_from", "在水潭中被淹");
        v1->unconcious();
        v1->die();
        return;
    }
}

int do_qian(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "down") {
        return notify_fail("你要往哪里潜？\n");
    }
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (arg == "down") {
        if (v1->query_encumbrance() * 100 / v1->query_max_encumbrance() <= 50) {
            return notify_fail("由于重力不够，你无法继续下潜!\n");
        }
        message_vision("\e[1;32m$N一个猛栽，潜了下去。\n\e[2;37;0m", v1);
        v1->move("/d/gumu/guditan2");
        tell_room(environment(v1), v1->name() + "从上面潜了下来。\n", ({ v1 }));
        message_vision("\e[1;34m$N只觉得头晕晕的，身体浸在冰冷的水中，不住的颤抖。\n\e[2;37;0m", v1);
        return 1;
    }
    return 1;
}

int do_pa(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "up") {
        return notify_fail("你要往哪里爬？\n");
    }
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
