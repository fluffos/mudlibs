void create() {
    set("short", "\e[1;36m平台\e[2;37;0m");
    set("long", "你置身平台上面，四周树木苍翠，山气清佳。环顾左右，只见许多石块堆\n著一个大坟。这坟背向山谷，俯仰空阔，单是这座剑冢便已占尽形势。仔细一\n看大石上「剑冢」两个大字之旁，尚有两行字体较小的石刻（zi）。 \n");
    set("item_desc", ([ "zi" : "\e[1;33m「剑魔独孤求败既无敌於天下，乃埋剑於斯。」\n\n「呜呼！群雄束手，长剑空利，不亦悲夫！」\n\e[2;37;0m" ]));
    set("outdoors", "古墓");
    setup();
}

void init() {
    add_action("do_move", "move");
    add_action("do_move", "yi");
    add_action("do_tiao", "tiao");
}

int do_move(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg) {
        return 0;
    }
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (arg == "stone" || arg == "shikuai") {
        if (v1->query("max_neili") < 1500 || v1->query_str() < 30) {
            return notify_fail("你费劲地想移动石块，但它纹丝不动。\n");
        }
        message_vision("\e[33m$N深深地吸了口气，缓缓推动石块。\n\n\e[2;37;0m", v1);
        write("\e[1;32m只见石块慢慢地移动，你把石块移开了！露出了剑冢的入口。\n\e[2;37;0m");
        set("exits/enter", "/d/gumu/jianzhong");
        v1->receive_damage("jing", 150);
        remove_call_out("close");
        call_out("close", 5, this_object());
        return 1;
    }
    return notify_fail("你要移动什么？\n");
}

void close(mixed arg) {
    message("vision", "\e[1;33m石块慢慢移回了原位，又挡住了入口。\n\e[2;37;0m", arg);
    arg->delete("exits/enter");
}

int do_tiao(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "down") {
        return notify_fail("你往哪里跳？");
    }
    if (arg == "down") {
        message_vision("\e[1;32m$N身形陡转，点击突石借力，纵下峭壁。\n\e[2;37;0m", v1);
    }
    v1->move("/d/gumu/qiaobi");
    v1->receive_damage("jing", 150);
    return 1;
}
