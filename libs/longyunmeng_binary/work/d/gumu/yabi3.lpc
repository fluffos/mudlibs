int do_pa(mixed);

void init() {
    add_action("do_pa", "pa");
}

void create() {
    set("short", "\e[1;32m崖壁\e[2;37;0m");
    set("long", "你手握藤条，身体紧紧贴附在悬崖峭壁之上。向四周望去，只见到云雾缭\n绕的一片迷茫。阵阵切骨山风吹得你遍体冰凉。山壁光滑平境，要是没有支撑\n点，就连飞鸟也难以立足。\n");
    set("outdoors", "古墓");
    setup();
}

int do_pa(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "down" && arg != "up") {
        return notify_fail("你要往哪爬？\n");
    }
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着呢。\n");
    }
    if (arg == "down") {
        if (v1->query_temp("tengacc") <= 0) {
            return notify_fail("\e[1;31m藤条已经放尽，你无法再往下面爬了！\n\e[2;37;0m");
        }
        message_vision("\e[1;32m$N颤颤噤噤地爬了下去。\n\e[2;37;0m", v1);
        v1->move("/d/gumu/yabi4");
        v1->add_temp("tengacc", -1);
        v1->start_busy(1);
        tell_room(environment(v1), v1->name() + "从上面爬了下来。\n", ({ v1 }));
    }
    if (arg == "up") {
        message_vision("\e[33m$N颤颤噤噤地爬了上去。\n\e[2;37;0m", v1);
        v1->move("/d/gumu/yabi2");
        v1->add_temp("tengacc", 1);
        v1->start_busy(1);
        tell_room(environment(v1), v1->name() + "从上面爬了下来。\n", ({ v1 }));
    }
    return 1;
}
