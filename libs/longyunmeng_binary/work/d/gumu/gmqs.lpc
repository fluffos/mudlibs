    set("long", "一张石桌(table)，一条石凳，桌上放着一把古琴(qin)，是小龙女休憩时\n刻抚琴抒怀的地方。每每琴音袅袅，平淡清和，直引人心弛神往，与世无争。\n");
    set("exits", ([ "south" : "/d/gumu/fang", "north" : "/d/gumu/jianshi", "west" : "/d/gumu/gmht", "east" : "/d/gumu/shitou" ]));
    set("item_desc", ([ "qin" : "\e[1;36m这是一把年代极远的古琴，琴风古朴，暗蕴玄机。\n琴上刻着[ 至远 宁心 渡风 ] 六个字。\n\e[2;37;0m", "table" : "桌上放着一把古琴。 \n" ]));
    create_door("east", "石门", "west", 1);
    setup();
}

void init() {
    add_action("do_tan", "tan");
    add_action("do_nuo", "nuo");
    add_action("do_yanxi", "yanxi");
}

int do_tan(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (arg == "qin") {
        if (!(v1 = v2->query("family")) || v1["family_name"] != "古墓派") {
            return notify_fail("你不是古墓传人，如何能领悟古墓武功？\n");
        }
        if (v2->query("qi") < 30 || v2->query("jing") < 30) {
            return notify_fail("你精神恍忽, 先去歇息一会再来弹琴吧。\n");
        }
        write("\e[1;36m你闭目调理一会气息, 心神宁静的抚琴而弹。\n\e[2;37;0m");
        if (v2->query_skill("force", 1) < 50) {
            return notify_fail("你弹了半天, 琴声仿若鸦鸣, 你还是弹棉花去吧。\n");
        }
        if (v2->query_skill("force", 1) > 100) {
            message_vision("\e[1;36m$N心随弦走，融入琴境，伴随琴声，高声吟道：\n\e[5m\e[1;33m\n\t沧海一声笑 滔滔两岸潮\n\t浮沉随浪 只记今朝\n\t苍天笑 纷纷世上潮\n\t谁负谁胜出 天知晓\n\t江山笑 烟雨遥\n\t涛浪淘尽 红尘俗世几多娇\n\t清风笑 竟惹寂寥\n\t豪情还剩了一襟晚照\n\t苍生笑 不再寂寥\n\t豪情仍在 痴痴笑笑\n\e[2;37;0m", v2);
            return 1;
        }
        write("你心随弦走, 融入琴境, 渐渐心气平和, 周身真气自然流动。\n");
        v2->receive_damage("qi", random(10) + 15, v2);
        v2->receive_damage("jing", random(10) + 15, v2);
        v2->improve_skill("force", v2->query_con() / 4 + v2->query_skill("force", 1) / 4);
        return 1;
    }
    write("你要弹什么? 弹棉花? \n");
    return 1;
}

int do_nuo(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (arg == "qin") {
        message_vision("\e[33m$N轻轻地挪开了古琴。\n\e[2;37;0m", v1);
        write("\e[1;36m琴下的桌面上居然刻着一篇文字。\n\e[2;37;0m");
        v1->set_temp("marks/qin", 1);
        return 1;
    }
    return notify_fail("你要挪什么? \n");
}

int do_yanxi(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (arg == "table") {
        if (v2->query_temp("marks/qin")) {
            if (v2->query("potential") - v2->query("learned_points") < 1) {
                return notify_fail("你的潜能不够了。\n");
            }
            if (!(v1 = v2->query("family")) || v1["family_name"] != "古墓派") {
                return notify_fail("你不是古墓传人，如何能领悟古墓武功？\n");
            }
            if (v2->query("qi") < 40) {
                return notify_fail("你的精神很差, 改先去休息一会. \n");
            }
            if (v2->query_skill("force", 1) < 40) {
                return notify_fail("你的基本内功太低，无法研习更高级的内功。\n");
            }
            if (v2->query_skill("yunu-xinjing", 1) < 50) {
                return notify_fail("你的玉女心经等级太低，无法领悟桌上的文字。\n");
            }
            if (v2->query_skill("yunu-xinjing", 1) > 100) {
                return notify_fail("你的玉女心经精进一层，可以双人合修玉女神功了。\n");
            }
            write("你开始研习桌上的玉女心经。\n");
            v2->improve_skill("yunu-xinjing", v2->query_int() / 2 + v2->query_con() / 2);
            v2->receive_damage("qi", random(20) + 15);
            v2->add("potential", -1);
            return 1;
        }
        return notify_fail("你对着桌上的古琴研究了一番，发现它很值钱。\n");
    }
    return notify_fail("你要研习什么？\n");
}
