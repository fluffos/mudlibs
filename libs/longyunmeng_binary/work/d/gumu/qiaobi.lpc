int do_look(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg) {
        return 0;
    }
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (v1->query_temp("shibi1") >= 1) {
        return notify_fail("你还没有看够？\n");
    }
    if (arg == "shibi") {
        if (v1->query_temp("shibi") >= 10) {
            write("\e[1;33m\n你凝神瞧了一阵，突见峭壁上每隔数尺便生著一丛青苔，数十丛笔直排列而上。\n\e[2;37;0m");
            v1->add_temp("shibi1", 1);
