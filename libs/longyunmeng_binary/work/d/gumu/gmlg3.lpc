inherit "/inherit/room/room";
void create();
void init();
int do_yanxi(mixed);
int do_xiulian(mixed);
int do_tui(mixed);
void close(mixed);

void create() {
    set("short", "\e[1;31m练功房\e[2;37;0m");
    set("long", "里面又是一室，却和先一间处处对称，而又处处相反，乃是后窄前宽，西圆东\n角，室顶也是刻满了无数符号。此处乃是古墓派祖师林朝英的武功之秘。\n");
    setup();
}

void init() {
    add_action("do_xiulian", "xiulian");
    add_action("do_yanxi", "yanxi");
    add_action("do_tui", "tui");
}

int do_yanxi(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!(v1 = v2->query("family")) || v1["family_name"] != "古墓派") {
        return notify_fail("你不是古墓传人，如何能领悟古墓武功？\n");
    }
    if (v2->is_busy() || v2->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (v2->query_skill("literate", 1) < 30) {
        return notify_fail("你丫斗字不识,领悟个啥? \n");
    }
    if (arg == "top") {
        if (v2->query("gender") == "男性") {
            return notify_fail("玉女剑法呈阴柔之气，不适合男子练习。\n");
        }
        if (v2->query_skill("sword", 1) < 20) {
            return notify_fail("你基本剑法太差，无法研习玉女剑法。\n");
        }
        if (v2->query_skill("yunu-jianfa", 1) >= 1) {
            return notify_fail("你已经学会玉女剑法，自己好好练吧。\n");
        }
        message_vision("$N仰视室顶的图纹，心中揣摩玉女剑法的精妙之处。\n", v2);
        v2->receive_damage("jing", 5);
        v2->improve_skill("yunu-jianfa", 2);
        return 1;
    }
    return 1;
}

int do_xiulian(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!(v1 = v2->query("family")) || v1["family_name"] != "古墓派") {
        return notify_fail("你不是古墓传人，如何能领悟古墓武功？\n");
    }
    if (v2->is_busy() || v2->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (v2->query("jing") < 40) {
        return notify_fail("你精力不能集中,去稍作歇息吧. \n");
    }
    if (v2->query_skill("literate", 1) < 30) {
        return notify_fail("你丫斗字不识,领悟个啥? \n");
    }
    if (arg == "backwall") {
        write("你抡掌劈向后方窄窄的石壁，蓬一声被震退数步，手臂一阵酸麻。\n");
        if (v2->query_skill("strike", 1) < 50) {
            return notify_fail("你看了半天只觉莫测高深，什么也没有学会。\n");
        }
        if (v2->query_skill("strike", 1) > 100) {
            return notify_fail("你掌力雄浑，不该再死练蛮力了。\n");
        }
        v2->receive_damage("jing", random(20) + 10);
        v2->improve_skill("strike", v2->query_int() / 3 + v2->query_skill("strike") / 4);
        return 1;
    }
    if (arg == "frontwall") {
        write("你挥拳直击弧型前壁，石粉四溅,你也被自己的猛劲震退数步。\n");
        if (v2->query_skill("cuff", 1) < 50) {
            return notify_fail("你看了半天只觉莫测高深，什么也没有学会。\n");
        }
        if (v2->query_skill("cuff", 1) > 100) {
            return notify_fail("你拳力已刚猛无比，却无甚招数。\n");
        }
        v2->receive_damage("jing", random(20) + 10);
        v2->improve_skill("cuff", v2->query_int() / 3 + v2->query_skill("cuff", 1) / 4);
        return 1;
    }
    if (arg == "westwall") {
        write("你绕西面石壁踏着剑步，用心揣摩壁上剑法精髓。\n");
        if (v2->query_skill("sword", 1) < 50) {
            return notify_fail("你看了半天只觉莫测高深，什么也没有学会。\n");
        }
        if (v2->query_skill("sword", 1) > 100) {
            return notify_fail("你对石壁上所述剑法已全然掌握,无须再费力了. \n");
        }
        v2->receive_damage("jing", random(20) + 10);
        v2->improve_skill("sword", v2->query_int() / 3 + v2->query_skill("sword", 1) / 4);
        return 1;
    }
    if (arg == "eastwall") {
        write("你虚拈手指,对着东面的三角形石壁,细心操练暗器的收发手势. \n");
        if (v2->query_skill("throwing", 1) < 50) {
            return notify_fail("你看了半天只觉莫测高深，什么也没有学会。\n");
        }
        if (v2->query_skill("throwing", 1) > 100) {
            return notify_fail("你暗器收发随心,再不能提高于此. \n");
        }
        v2->receive_damage("jing", random(20) + 10);
        v2->improve_skill("throwing", v2->query_int() / 3 + v2->query_skill("throwing", 1) / 4);
        return 1;
    }
    return 0;
}

int do_tui(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (arg == "westwall") {
        message_vision("\e[33m$N伸手到半圆的弧底推了几下，一块大石缓缓移开，现出一扇洞门。\n\e[2;37;0m", v1);
        set("exits/out", "/d/gumu/gmlg2");
        v1->receive_damage("qi", 30);
        remove_call_out("close");
        call_out("close", 5, this_object());
        return 1;
    }
    return notify_fail("你要推什么？\n");
}

void close(mixed arg) {
    message("vision", "\e[1;33m大石慢慢退回了原位，又挡住了出口。\n\e[2;37;0m", arg);
    arg->delete("exits/out");
}
