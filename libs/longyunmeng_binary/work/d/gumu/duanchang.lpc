inherit "/inherit/room/room";
void init();
void create();
int do_pa(mixed);
int do_bang(mixed);
int do_cuo(mixed);
int do_tiao(mixed);
int do_yes();
int do_no();
int win();
int fail();

void init() {
    add_action("do_pa", "pa");
    add_action("do_bang", "bang");
    add_action("do_cuo", "cuo");
    add_action("do_tiao", "tiao");
    add_action("do_yes", "yes");
    add_action("do_no", "no");
}

void create() {
    set("short", "\e[1;33m断肠崖\e[2;37;0m");
    set("long", "你走到山峰顶部的一处山崖，山崖上不知是谁刻得有几行大字（dazi），\n自此向上，数十丈光溜溜的寸草不生，终年云雾环绕，天风猛烈，便飞鸟也甚\n难在峰顶停足。山崖旁边就是一道深渊（shenyuan）。悬崖边上长着一棵老松\n树（song）斜斜的探出崖边。\n");
    set("item_desc", ([ "dazi" : "\e[1;33m                             \n            ※※※※※※※※※※※※※※※※※※\n            ※※※※　                  ※※※※\n            ※※※※    十 六 年 后，   ※※※※\n            ※※※※                    ※※※※\n            ※※※※    在 此 相 会，   ※※※※\n            ※※※※                    ※※※※\n            ※※※※    夫 妻 情 深，   ※※※※\n            ※※※※                    ※※※※\n            ※※※※    勿 失 信 约。　 ※※※※ \n            ※※※※　                  ※※※※\n            ※※※※※※※※※※※※※※※※※※\n\e[2;37;0m", "shenyuan" : "\e[1;34m你从渊口向下望去，但见渊中云雾缭绕，黑幽幽的深不见底。\n\e[2;37;0m",
            "song" : "\e[1;32m一棵老松树，盘枝交错，斜探着枝桠深入云霄。\n\e[2;37;0m" ]));
    set("exits", ([ "westdown" : "/d/gumu/shanlu10" ]));
    set("outdoors", "古墓");
    setup();
}

int do_pa(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (!arg || arg != "down") {
        return notify_fail("你要往哪爬？\n");
    }
    if (!v1->query_temp("mark/bang")) {
        return notify_fail("你想跳崖自杀么？直接跳下去吧！\n");
    }
    message_vision("\e[1;32m$N颤颤噤噤地爬了下去。\n\e[2;37;0m", v1);
    v1->move("/d/gumu/yabi1");
    v1->add_temp("tengacc", -1);
    tell_room(environment(v1), v1->name() + "从上面爬了下来。\n", ({ v1 }));
    v1->delete_temp("mark/bang");
    return 1;
}

int do_bang(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (v1->query_temp("tengacc", 1) <= 0) {
        return notify_fail("你要用什么绑？\n");
    }
    if (!arg || arg != "song") {
        return notify_fail("你要绑什么？\n");
    }
    if (v1->query_temp("mark/bang")) {
        return notify_fail("绳子已经绑好了。\n");
    }
    message_vision("\e[1;33m$N仔仔细细地把树藤一端绑在松树干上。\n\e[2;37;0m", v1);
    v1->set_temp("mark/bang", 1);
    return 1;
}

int do_cuo(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "shupi") {
        return notify_fail("你要搓什么？\n");
    }
    if (v1->query_temp("tengacc", 1) <= 0) {
        if (v1->is_busy() || v1->is_fighting()) {
            return notify_fail("你正忙着哪！\n");
        }
        message_vision("\e[32m$N剥下一块树皮，将它搓成一根树藤。\n\e[2;37;0m", v1);
        v1->set_temp("tengacc", 1);
        return 1;
    }
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    message_vision("\e[32m$N剥下一块树皮，用它把树藤接长。\n\e[2;37;0m", v1);
    v1->add_temp("tengacc", 1);
    return 1;
}

int do_tiao(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (!arg || arg != "shenyuan") {
        return notify_fail("你要往哪跳？\n");
    }
    if (!v1->query_temp("tiaoya")) {
        write("\e[1;31m这个悬崖如此凶险，你就这么跳下去只怕凶多吉少，你还是再考虑一下吧。\n\e[2;37;0m");
        write("\e[1;31m决定跳就敲（yes），改变主意就敲（no）。\n\e[2;37;0m");
        v1->set_temp("tiaoya", 1);
        return 1;
    }
    write("你到底怎么决定的？\n");
    return 1;
}

int do_yes() {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (!v1->query_temp("tiaoya")) {
        return 0;
    }
    message_vision("\e[1;31m$N犹豫再三，终于下定决心，两眼一闭，涌身向崖底跳去！\n\e[2;37;0m", v1);
    v1->delete_temp("tiaoya");
    message_vision("\e[1;31m\n$N身体冲开迷雾，只感觉耳边生风，向崖底直坠下去。\n\e[2;37;0m", v1);
    if (v1->query("kar", 1) >= 28) {
        if (random(25) >= 20) {
            call_out("win", 1);
            return 1;
        } else {
            call_out("fail", 1);
            return 1;
        }
    }
    return 1;
}

int do_no() {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (!v1->query_temp("tiaoya")) {
        return 0;
    }
    write("\e[1;32m你思虑再三取消了跳下去的决定。\n\e[2;37;0m");
    v1->delete_temp("tiaoya");
    return 1;
}

int win() {
    mixed v1;
    v1 = this_player();
    write("\e[1;31m\n你身体距离谷底越来越近，定睛看去，谷底原来是一片水潭！\n\e[2;37;0m");
    write("\e[1;31m\n你在空中，身体已经不受控制，直接向水中落去。\n\e[2;37;0m");
    write("\e[1;31m\n扑通一声，你肚子首先入水，五脏六腑一阵翻滚。张嘴想要惊呼，咕噜咕噜，\n反而被灌了一肚子水。\n\e[2;37;0m");
    v1->move("/d/gumu/guditan1");
    tell_room(environment(v1), "只听到一声惨叫，" + v1->name() + "从天空直坠了下来。\n", ({ v1 }));
    tell_room(environment(v1), v1->name() + "向下面径直沉了下去。\n", ({ v1 }));
    v1->receive_damage("jingli", 100);
    v1->receive_damage("qi", 100);
    v1->move("/d/gumu/guditan2");
    tell_room(environment(v1), v1->name() + "从上面直坠了下来。\n", ({ v1 }));
    tell_room(environment(v1), v1->name() + "向下面径直沉了下去。\n", ({ v1 }));
    v1->receive_damage("jingli", 200);
    v1->receive_damage("qi", 200);
    v1->move("/d/gumu/guditan3");
    tell_room(environment(v1), v1->name() + "从上面直坠了下来。\n", ({ v1 }));
    tell_room(environment(v1), v1->name() + "向下面径直沉了下去。\n", ({ v1 }));
    v1->receive_damage("jingli", 300);
    v1->receive_damage("qi", 300);
    v1->set("water", v1->max_water_capacity() + 200);
    v1->move("/d/gumu/guditan4");
    tell_room(environment(v1), v1->name() + "从上面直坠了下来。\n", ({ v1 }));
    message_vision("\e[1;34m$N只觉得头晕晕的，身体浸在冰冷的水中，不住的颤抖。\n\e[2;37;0m", v1);
    return 1;
}

