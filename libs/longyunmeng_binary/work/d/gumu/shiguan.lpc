    add_action("do_search", "search");
}

int do_dian(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (arg == "fire") {
        if (!objectp(v1 = present("fire", v2))) {
            return notify_fail("你没有火折，点什么？\n");
        }
        message_vision("\e[1;31m只听见“呲 ---”的一声，$N点亮了手中的火折。\n\n\e[2;37;0m", v2);
        write("\e[1;33m再看那十六个字时，只见其后还写得有许多小字：破解玉女心经之法，吾置\n之于此室之下，后人有缘，一观便知 ......重阳真人 .....\n\e[2;37;0m");
        v2->set_temp("marks/古墓1", 1);
        return 1;
    }
    return 0;
}

int do_search() {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("marks/古墓1")) {
        return 0;
    }
    if (v1->query_temp("gumu1") < 8) {
        message_vision("\e[1;33m$N点亮火折，仔细地在石棺内四下摸索。\n\e[2;37;0m", v1);
        v1->add_temp("gumu1", 1);
