    }
    message_vision("\e[1;31m$N觉得手下一沉，果然摸到个可容一手的凹(ao)处。\n\e[2;37;0m", v1);
    v1->delete_temp("marks/古墓1");
    v1->delete_temp("gumu1");
    v1->set_temp("marks/古墓2", 1);
    return 1;
}

