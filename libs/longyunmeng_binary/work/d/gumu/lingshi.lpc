int do_tui(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (arg == "guangai") {
        message_vision("\e[33m$N使劲推开了棺盖。\n\e[2;37;0m", v1);
        v1->set_temp("marks/石棺", 1);
        return 1;
    }
    return notify_fail("你要推什么？\n");
}

int do_tang(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("marks/石棺")) {
        return 0;
    }
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着哪！\n");
