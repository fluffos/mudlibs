// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "空地");
	set("long", 
	    "空地不大，大约100多平方米，似乎是人为的产物。空地的\n"
	    "就存在了。各种说不出名字的植物茂盛的生长着，遮天蔽日，因\n"
	    "此显得阴森恐怖。到处都是水坑，烂泥。地上有有几行脚印，似\n"
	    "乎是人留下来的。脚印朝西方延伸而去。\n"
	);
	set("exits",([
		"north" : __DIR__"zhaoze4",
		"east" : __DIR__"zhaoze8",
		"west" : __DIR__"secret/xiaowu",
	    ]));
	setup();
	//replace_program(ROOM);
}
