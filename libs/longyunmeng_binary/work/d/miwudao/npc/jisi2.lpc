// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit NPC;
void create()
{
        set_name("祭祀", ({ "jisi"}) );
        set("nickname", "祭祀");
        set("gender", "男性");
        set("age", 30);
        set("long","迷雾岛的祭祀,直接由大祭祀圣莫尔统领,负责迷雾岛的祭祀事务\n");

        set("combat_exp", 200000);

        set("class", "divine");
        set("occupation","enchanter");
        set("appointed", "photosphere");
	set_temp("magic_armor",1);
        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

        set("mana", 1000);
        set("max_mana", 1000);

      	set_skill("literate", 100);
     	set_skill("magic",80);
      	set_skill("unarmed",20);
      	set_skill("parry",20);
      	set_skill("dodge",20);
      	set_skill("divinemagic",70);

        map_skill("magic","divinemagic");

        setup();
        
        add_money("silver",random(20)+1);
}
