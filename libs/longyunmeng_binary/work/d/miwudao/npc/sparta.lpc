// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit NPC;
void create()
{
        set_name("斯巴达", ({ "captain sparta","sparta"}) );
        set("nickname", "卫队长");
        set("gender", "男性");
        set("age", 35);
        set("long","迷雾岛的卫队长---斯巴达,斯巴达对迷雾堡堡主忠心耿耿.从年轻的时候就\n"
                   "一直跟随迈西斯,他的身手不凡,是个比较难缠的角色.\n");

        set("combat_exp", 800000);

        //set("class", "divine");
        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);
        
        set("max_kee",2000);
	set("kee",2000);
      	
      	set_skill("unarmed",100);
      	set_skill("force",100);
      	set_skill("parry",100);
      	set_skill("dodge",100);
	set_skill("sword",120);
        //set_skill("xiyang-jian",120);
        
        //map_skill("sword","xiyang-jian");
        set_temp("apply/armor", 30);

        setup();
        carry_object(__DIR__"obj/powersword")->wield();
        carry_object(__DIR__"obj/powershield")->wear();
        add_money("silver",random(50)+1);
}
 
