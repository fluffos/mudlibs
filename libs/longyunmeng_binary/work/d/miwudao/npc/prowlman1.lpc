// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit NPC;
void create()
{
        set_name("巡逻兵", ({ "fighter cop"}) );
        set("nickname", "战士");
        set("gender", "男性");
        set("age", 25);
        set("long","一名身着重装铠甲的男子,手持长剑,双眼机警的扫视着街上来来往往\n"
                   "的人群,不放过任何一个形迹可疑的人.保卫城堡的安全是他们的职责\n");

        set("combat_exp", 500000);

        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

      	set_skill("unarmed",80);
      	set_skill("parry",80);
      	set_skill("dodge",80);
        set_skill("sword",60);
        //set_skill("xiyang-jian",60);
        
        //map_skill("sword","xiyang-jian");
        
        set_temp("apply/dodge", 100);
        set_temp("apply/armor", 100);

        setup();
        
        carry_object(__DIR__"obj/gangjian")->wield();
        add_money("silver",random(50)+1);
}
 
