// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// taolord.c

inherit NPC;
void create()
{
        set_name("流浪魔法师", ({ "enchanter"}) );
        set("nickname", "中级魔法师");
        set("gender", "男性");
        set("age", 30);
        set("long","三十年前,大魔法师恩利斯以及他的伙伴们与暗黑龙王进行了一场艰苦的战斗\n"
                   "最终恩利斯和他的伙伴们获得了胜利,消灭了暗黑龙王,这个世界因此重新获得\n"
                   "了和平.恩利斯的最爱--凯萨琳在那次战斗中用自己的生命,施展了最后一个防\n"
                   "护魔法,从而使恩利斯拥有了永远年轻的身体.\n");

        set("combat_exp", 500000);

        //set("class", "divine");
        set("occupation","enchanter");
        set("appointed", "fengya");
	set_temp("magic_armor",1);
        
        set("str", 30);
        set("spi", 30);


        set("mana", 1000);
        set("max_mana", 1000);


     	set_skill("magic",60);
      	set_skill("unarmed",30);
      	set_skill("parry",30);
      	set_skill("dodge",30);
      	set_skill("divinemagic",50);

        map_skill("magic","divinemagic");

        setup();
        carry_object("/d/miwudao/npc/obj/cloth")->wear();
        add_money("silver",random(20)+1);
}


 
void init()
{
}
void questbonus(object ob)
{
	if(random(3)<1)
   		ob->set("quest/fealty",2);
	else ob->set("quest/fealty",1);
}
