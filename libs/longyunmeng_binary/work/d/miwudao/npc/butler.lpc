// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//shopkeeper10.c
//贩卖道具,蜡烛.......
inherit NPC;
void create()
{
        set_name("巴特勒", ({ "shopman butler","butler"}) );
        set("nickname","道具店老板");
        set("gender", "男性");
        set("age", 25);
        set("long","道具店老板,专门贩卖各种战士和魔法师使用的道具..\n");
        set("combat_exp", 100000);

        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

      	set_skill("unarmed",60);
      	set_skill("parry",80);
      	set_skill("dodge",80);

        setup();
        
        add_money("silver",random(50)+1);
}
 
