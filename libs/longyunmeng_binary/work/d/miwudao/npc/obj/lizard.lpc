// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit ITEM;
inherit F_FOOD;

void create()
{

	if(random(2)==1)
	{
		set_name("蜥蜴尾巴", ({ "lizard tail", "tail" }) );
		set("long", "半截烤的喷香的蜥蜴尾巴,味道也应该不错\n");
	}
	else
	{
		set_name("蜥蜴肉蒲",({"lizard meat","meat"}));
		set("long", "一块烤的香喷喷的蜥蜴肉蒲.\n");
	}
	
	set_weight(350);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("value", 30);
		set("food_remaining", 8);
		set("food_supply", 40);
	}
	setup();
}
