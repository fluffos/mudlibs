// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// gangzhang.c 魔法法杖

#include <weapon.h>
inherit STAFF;

void create()
{
	set_name("月光法杖", ({ "moon staff" }));
	set_weight(1000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("long", "月光法杖,蕴涵了月光的力量\n");
		set("value", 1000);
		set("rigidity",100);
		set("material", "steel");
		set("wield_msg", "$N缓缓将$n握在手中。\n");
		set("unwield_msg", "$N缓缓将$n收回背后。\n");
	}
  	init_staff(40);
	//此处增加魔法防御.....暂时不添加
	setup();
}
