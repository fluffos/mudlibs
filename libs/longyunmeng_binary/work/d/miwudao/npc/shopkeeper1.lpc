// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//shopkeeper1.c
//此人负责为玩家定制武器
inherit NPC;
void create()
{
        set_name("史密斯", ({ "black smith","smith"}) );
        set("nickname", "著名铁匠");
        set("gender", "男性");
        set("age", 25);
        set("long","迷雾堡最著名的铁匠\n"
                   "\n");

        set("combat_exp", 500000);

        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

      	set_skill("unarmed",60);
      	set_skill("parry",80);
      	set_skill("dodge",80);
      	set_skill("divinemagic",90);

        set_temp("apply/dodge", 100);
        set_temp("apply/armor", 100);

        setup();
        
        add_money("silver",random(50)+1);
}
 
