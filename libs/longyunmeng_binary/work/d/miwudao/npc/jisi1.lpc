// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit NPC;
void create()
{
        set_name("圣莫尔", ({ "st.maur"}) );
        set("nickname", "大祭祀");
        set("gender", "男性");
        set("age", 30);
        set("long","圣莫尔是迷雾岛最大的祭祀,掌管整个迷雾岛一切的祭祀活动\n"
                   "圣莫尔也是一名高级魔法师,拥有威力惊人的魔法力量,即使是\n"
                   "传说中的伟大战士,迷雾堡堡主迈西斯本人也对他敬畏三分.\n");
        set("combat_exp", 1000000);

        set("class", "divine");
        set("occupation","enchanter");
        set("appointed", "star");//
	set_temp("magic_armor",1);//
        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

        set("mana_factor",100);

        set("mana", 3000);
        set("max_mana", 3000);


      	set_skill("literate", 100);
     	set_skill("magic",150);
      	set_skill("unarmed",30);
      	set_skill("parry",30);
      	set_skill("dodge",30);
      	set_skill("divinemagic",120);

        map_skill("magic","divinemagic");

        setup();

	carry_object(__DIR__"obj/carmor")->wear();
        carry_object(__DIR__"obj/chead_armor")->wear();
        carry_object(__DIR__"obj/cboots_armor")->wear();

        add_money("silver",random(100)+1);
}


