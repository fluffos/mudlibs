// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit NPC;
void create()
{
        set_name("卫兵", ({ "guardsman"}) );
        set("nickname", "中级战士");
        set("gender", "男性");
        set("age", 25);
        set("long","很普通的战士,他们的任务是维护迷雾之堡的治安.他们的武功虽然平平,但是确都是\n"
                   "有组织,有纪律的,轻易不要招惹他们,\n");

        set("combat_exp", 350000);

        //set("class", "divine");
        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

      	set_skill("unarmed",60);
      	set_skill("parry",80);
      	set_skill("dodge",80);

        set_temp("apply/dodge", 100);
        set_temp("apply/armor", 100);

        setup();
        
        add_money("silver",random(30)+1);
}
 
