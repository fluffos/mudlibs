// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// taolord.c

inherit NPC;
void create()
{
        set_name("艾丽思", ({ "alice"}) );
        set("nickname", "中级魔法师");
        set("gender", "女性");
        set("age", 45);
        set("long","虽然艾丽思已经上了年纪,可是,从她的脸上仍然可以看出她年轻,\n"
                   "的时候一定是非常的美丽.\n");

        set("combat_exp", 1500000);

        set("class", "divine");
        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

      	set_skill("unarmed",60);
      	set_skill("parry",80);
      	set_skill("dodge",80);
      	set_skill("divinemagic",90);

        set_temp("apply/dodge", 100);
        set_temp("apply/armor", 100);

        setup();
        
        add_money("gold",1);
}
 
