// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//shopkeeper3.c
//贩卖战士使用的武器.
inherit F_VENDOR;
inherit NPC;
void create()
{
        set_name("布尔迪厄", ({ "shopman pierrebourdieu","pierrebourdieu"}) );
        set("nickname","武器店老板");
        set("gender", "男性");
        set("age", 25);
        set("long","迷雾堡有名的武器贩子,贩卖各种战士,侠客使用的武器.迷雾堡的大部分战士都\n"
                   "喜欢来这里挑选一把自己喜欢趁手的兵器.\n");

        set("combat_exp", 500000);

        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

      	set_skill("unarmed",60);
      	set_skill("parry",80);
      	set_skill("dodge",80);

        set_temp("apply/dodge", 100);
        set_temp("apply/armor", 100);

        set("vendor_goods", ([
        __DIR__"obj/gangdao":10, 
        __DIR__"obj/gangjian":10,
        __DIR__"obj/hammer":10, 
        __DIR__"obj/gangzhang":10, 
        __DIR__"obj/changbian":10, 
        __DIR__"obj/changqiang":10, 
                
        ]));


        setup();
        carry_object("/d/miwudao/npc/obj/cloth")->wear();
        add_money("silver",random(50)+1);
}
 
void init()
{

}