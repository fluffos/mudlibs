// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "药店");
	set("long",
"著名的医生马休斯开设的药店，专门卖一些治疗跌打损伤的药物。\n"
"这里的生意很兴隆，无论是一般的平民还是战士都来这里治病，\n"
"解毒。\n"
);
	set("exits",([
	"south" : __DIR__"dajie8",
	"east" : __DIR__"dangpu",
	]));

	set("objects",([
	__DIR__"npc/matthews":1,
	]));


	setup();
//replace_program(ROOM);
}
