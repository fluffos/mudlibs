// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "酒馆");
	set("long",
"面积不大的酒馆。售卖的酒也不多，瓶架上只有几种酒。客人似\n"
"乎也不多，似乎迷雾岛的人不大喜欢饮酒。\n"
);
	set("exits",([
	"north" : __DIR__"dajie7",
	"west" : __DIR__"fangjudian1",
	]));

	set("objects",([
	__DIR__"npc/waiter":1,
	__DIR__"npc/drunkard":1,
	]));

	setup();
//replace_program(ROOM);
}
