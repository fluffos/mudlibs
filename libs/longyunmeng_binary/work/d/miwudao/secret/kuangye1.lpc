// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "旷野");
	set("long",
"海风徐徐吹来，特有的味道让人心旷神怡。眺眼远望，远处就是\n"
"遗忘之海。\n"
);
	set("exits",([
	"south" : __DIR__"yanshi",
	"east" : __DIR__"shulin1",
	]));
	setup();
//	replace_program(ROOM);
}
