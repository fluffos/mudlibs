// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "平地");
	set("long",
"一块很平的区域，周围光秃秃的什么都没有。这里似乎是整个恶\n"
"龙岛的中心地带。四面八方的道路都汇聚在了这里。最令人奇怪\n"
"的是在最中心的地方有一个10米大的洞穴，洞穴深不见底，往下\n"
"望去，只觉得阴森森的，令人毛骨悚然。\n"
);
	set("exits",([
	"south" : __DIR__"shulin3",
	"north" : __DIR__"shulin1",
	"west" : __DIR__"yanshi",
	"east" : __DIR__"shuitan",
	"down" : __DIR__"shandong",
	]));
	setup();
//	replace_program(ROOM);
}
