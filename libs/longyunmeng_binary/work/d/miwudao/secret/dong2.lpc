// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "青龙洞");
	set("long",
"阴森的山洞让人毛骨悚然，从西边不时的传来一声沉重的呼吸声。\n"
"再往西边估计就是山洞的尽头了。\n"
);
	set("exits",([
	"west" : __DIR__"dong1",
	"east" : __DIR__"dong3",
	]));
	setup();
//	replace_program(ROOM);
}
