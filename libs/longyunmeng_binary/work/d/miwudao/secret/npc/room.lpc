// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#pragma save_binary

string *roomlines;
int save_file();
void create()
{
        string file;
        file = read_file("/task/room_location");
        roomlines = explode(file,"\n"); 
        seteuid(getuid());
}
int add_file(string filename)
{
        if(!pointerp(filename->query("coor"))) return 0;
        if(member_array(filename,roomlines)!=-1)
                return 0;
                roomlines+=({filename});
        if(!random(100)) save_file();
}
int query_num()
{
        return sizeof(roomlines);
}
int save_file()
{
        string file;
        int i;
	return 0;//这个东西已经没有存在的价值。
        file="";
        for(i=0;i<sizeof(roomlines);i++)
                file+=roomlines[i]+"\n";
        write_file("/task/room_location",file,1);
}
int delete_file(string filename)
{
        if(member_array(filename,roomlines)==-1)
            return 0;
        roomlines-=({filename});
        save_file();
        return 1;
}
