// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "青龙洞底");
	set("long",
"这里就是山洞的尽头，不过你似乎闯入了龙型生物的老巢，无数\n"
"的巨龙从四面八方向你靠拢过来。\n"
);
	set("exits",([
	"east" : __DIR__"dong2",
	//"down" : __DIR__"sszq",//此处改为由npc/dragon1死后自动打开
	]));

	set("objects",([
	 __DIR__"npc/dragon1":1,
	 __DIR__"npc/qinglong":5,
	]));

	setup();
//	replace_program(ROOM);
}
