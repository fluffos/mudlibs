// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "恶龙岛海滩");
	set("long",
"恶龙岛海滩，金色的海滩绵延几百米，离海滩不远的地方是一片\n"
"片葱绿的树木。再往北就是一片树林。\n"
);
	set("exits",([
	"north" : __DIR__"shulin3",
	"south" : __DIR__"haitan1",
	]));
	setup();
//	replace_program(ROOM);
}
