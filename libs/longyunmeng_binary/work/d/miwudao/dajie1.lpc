// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "大街");
	set("long",
"宽敞干净的街道。往南走通往迷雾岛的神圣广场，往北走通往迷\n"
"雾岛的心脏地带——迷雾堡。\n"
);
	set("exits",([
	"south" : __DIR__"xiaoguangchang1",
	"north" : __DIR__"damen1",
	]));
	setup();
//replace_program(ROOM);
}
