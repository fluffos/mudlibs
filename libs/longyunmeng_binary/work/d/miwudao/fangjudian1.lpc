// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "防具店");
	set("long",
"墙上挂满了各种防具，有盔甲，头盔，护手，护膝。盾牌等等。\n"
"价格不一，适合各种人士购买使用。\n"
);
	set("exits",([
	"north" : __DIR__"dajie6",
	"west" : __DIR__"bupu",
	"east" : __DIR__"jiuguan",
	]));
	set("objects",([
	__DIR__"npc/brown":1,
	]));
	setup();
//replace_program(ROOM);
}
