// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "迷雾沼泽");
	set("long",
"迷雾沼泽不知道是什么时候形成的，大概自从迷雾岛形成的时候\n"
"就存在了。各种说不出名字的植物茂盛的生长着，遮天蔽日，因\n"
"此显得阴森恐怖。到处都是水坑，烂泥。地上有许多凌乱的脚印，\n"
"也不知道是什么生物留下来的。\n"
);
	set("exits",([
	"south" : __DIR__"zhaoze4",
	"east" : __DIR__"zhaoze2",
	]));
	setup();
//replace_program(ROOM);
}
