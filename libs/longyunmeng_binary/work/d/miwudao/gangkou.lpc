// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "港口");
	set("long",
"港口旁边停泊着各种各样的船只，到处都是来来往往的人们，大\n"
"家不停地从船上将一桶桶各种各样的鱼搬到岸边。看来渔民的收\n"
"获不小。\n"
);
	set("exits",([
	"east" : __DIR__"dadao1",
	]));

	set("objects",([
	 __DIR__"secret/npc/boatman":1,
	]));
	
	
	setup();
//replace_program(ROOM);
}
