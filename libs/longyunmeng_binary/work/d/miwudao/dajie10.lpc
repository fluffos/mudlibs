// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "大街");
	set("long",
"街道宽敞而明亮，街道旁边是巨大的树木。房屋是用石头砌成的。\n"
"再往北走就是迷雾岛的小广场了。\n"
);
	set("exits",([
	"south" : __DIR__"dajie11",
	"north" : __DIR__"xiaoguangchang3",
	]));

	set("objects",([
	__DIR__"npc/boy":1,
	__DIR__"npc/girl":1,
	]));

	setup();
//replace_program(ROOM);
}
