// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "书店");
	set("long",
"书橱上面放置了大量的书籍，有各种格斗技巧以及魔法书籍。当\n"
"然，能够拿出来贩卖的书籍都是一些常见的初级技能。\n"
);
	set("exits",([
	"south" : __DIR__"datiepu",
	"east" : __DIR__"wuqidian1",
	]));
	set("objects",([
	__DIR__"npc/shopkeeper2":1,
	]));
	setup();
//replace_program(ROOM);
}
