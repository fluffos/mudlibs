// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "大街");
	set("long",
"街道的角落里躺着几个乞丐在懒洋洋的晒着太阳。即使是繁华的\n"
"迷雾岛，也照样有穷人。\n"
);
	set("exits",([
	"west" : __DIR__"dajie2",
	"east" : __DIR__"xiaoguangchang2",
	]));

	set("objects",([
	__DIR__"npc/beggar":2,
	]));

	setup();
//replace_program(ROOM);
}
