// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "荒野");
	set("long",
"无人的荒野，周围长满了各种叫不出名字的花花草草。偶尔不知\n"
"道从哪里跑出来的小动物飞快的从你的身边闪过。\n"
);
	set("exits",([
	"west" : __DIR__"huangye1",
	]));
	setup();
//replace_program(ROOM);
}
