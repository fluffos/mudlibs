// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "花店");
	set("long",
"迷雾岛唯一的花店，花店不算大，只有几十平方米，不过整齐的\n"
"货架上面却放满了各种各样的花草，有君子兰，玫瑰，郁金香，\n"
"勿忘我，满天星等等。多不胜数。花店的主人是安吉拉——迷雾\n"
"岛有名的美女。\n"
);
	set("exits",([
	"south" : __DIR__"daojudian",
	"north" : __DIR__"lvguan",
	"west" : __DIR__"dajie9",
	]));

	set("objects",([
	__DIR__"secret/npc/angela":1,
	]));
	setup();
        //replace_program(ROOM);
}
