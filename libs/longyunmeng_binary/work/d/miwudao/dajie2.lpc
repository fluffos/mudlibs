// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "大街");
	set("long",
"街道两旁是两排整齐的树木，树木旁边则是各种花草。几只蜜蜂\n"
"辛勤的在劳动者。两只蝴蝶在互相追逐嬉戏。再往西边走就要到\n"
"达迷雾岛的西区了。迷雾岛的西区是魔法师和战士们的天堂，里\n"
"面设有各种店铺。\n"
);
	set("exits",([
	"west" : __DIR__"dajie7",
	"east" : __DIR__"dajie3",
	]));

	set("objects",([
	__DIR__"npc/enchanter":1,
	]));

	setup();
//replace_program(ROOM);
}
