// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "大街");
	set("long",
"这里是迷雾岛的西区大街。往南边就是防具店，往北边就是武器\n"
"店。\n"
);
	set("exits",([
	"south" : __DIR__"fangjudian1",
	"north" : __DIR__"wuqidian1",
	"west" : __DIR__"datiepu",
	"east" : __DIR__"dajie7",
	]));

	set("objects",([
	__DIR__"npc/fighter":1,
	__DIR__"npc/localruffian":1,
	]));

	setup();
//replace_program(ROOM);
}
