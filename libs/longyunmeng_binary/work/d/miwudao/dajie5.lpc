// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "大街");
	set("long",
"迷雾岛的大街都很干净，宽敞，两旁是两排树龄有二十多年的高\n"
"大树木。旁边栽满了各种花花草草。虽然整个迷雾岛只是在三十\n"
"年前才开始兴建，但是不难看出迷雾岛的堡主对整个迷雾岛的建\n"
"设起到很好的规划。\n"
);
	set("exits",([
	"west" : __DIR__"dajie4",
	"east" : __DIR__"dajie8",
	]));
	setup();
//replace_program(ROOM);
}
