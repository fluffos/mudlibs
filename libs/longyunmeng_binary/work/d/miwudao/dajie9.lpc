// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "大街");
	set("long",
"人类在迷雾岛居住的历史只有几十年，但是这几十年的建设非常\n"
"的迅速，现在地迷雾岛已经相当地繁华，因此整个迷雾岛都能够\n"
"看到慕名而来的游客，有来自西方的，也有来自神秘的东方。\n"
);
	set("exits",([
	"south" : __DIR__"qianzhuang",
	"north" : __DIR__"dangpu",
	"west" : __DIR__"dajie8",
	"east" : __DIR__"huadian",
	]));

	set("objects",([
	__DIR__"npc/traveller1":1,
	__DIR__"npc/traveller2":1,
	]));

	setup();
//replace_program(ROOM);
}
