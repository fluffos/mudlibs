// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// xiaodao5.c
// shilling 97.2
inherit ROOM;
void create()
{
    set("short", "林间小道");
    set("long", @LONG
这是一条从南到北的林间小道，沿途风景极之清幽，参天古树，拔地而
起，两旁百花争艳。令人留连忘返。
LONG
    );
    set("exits", ([
        "south" : __DIR__"muwu1",
        "north" : __DIR__"qingcaop",
]));
    set("no_clean_up", 0);
    set("outdoors", "xiaoyao");
    setup();
    replace_program(ROOM);
}
