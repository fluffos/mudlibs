// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
void create()
{
        set("short", "湖上曲桥");
        set("long", @LONG
昆明湖成葫芦状，在此一曲飞桥连接两岸。至黄昏偶驻，远处灯火万点，间以星影
萤光，错落难辨。深秋时，霜风初起，枫林渐染黄碧，野岸衰柳芙蓉，掩映水际，芦苇
中鸿雁群集，嘹呖干云，哀声动人。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "north" : __DIR__"bridge",
  "south" : __DIR__"grassroom",
]));

        set("objects", ([
        __DIR__"npc/piaoke" : 1,
        __DIR__"npc/piaoke2" :1,
                        ]) );

        set("outdoors","dali");

        setup();
}
