}

int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = arg1->query_skill("literate", 1);
    v1 = v1 ? v1 * 10 : 500;
    if (arg1->query("dushu") + 1 < 1) {
        say(this_object()->name() + "笑道：“这怎么好意思，您上次给的钱还没读完呢！”\n");
        return 0;
    }
    if (arg2->value() / 15 + arg1->query("dushu") < 0) {
        say(this_object()->name() + "受宠若惊地说：“这么多钱我可不敢收呀！”\n");
        return 0;
    }
    if (!arg1->query("dushu")) {
        if (arg2->value() >= v1) {
            say(this_object()->name() + "点了点头，说道：哦，像你这麽有心的学生还真是不多见，好好努力\n                      可以向我请教读书写字(literate)的任何问题。\n");
            arg1->set("dushu", arg2->value() / 15);
            return 1;
        } else {
            say(this_object()->name() + "说道：你的诚意不够，这钱还是拿回去吧。\n");
            return 0;
        }
    } else if (arg2->value()) {
        if (arg2->value() >= v1) {
            say(this_object()->name() + "点了点头，说道：哦，像你这麽有心的学生还真是不多见，好好努力\n                      将来必定前途无量，谢了。\n");
            arg1->add("dushu", arg2->value() / 15);
            return 1;
        } else {
            say(this_object()->name() + "说道：你的诚意不够，这钱还是拿回去吧。\n");
            return 0;
        }
    }
    return 1;
}

