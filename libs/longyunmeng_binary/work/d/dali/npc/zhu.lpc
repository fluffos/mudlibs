int do_sleep(mixed arg) {
    mixed v1;
    if (!arg) {
        return 0;
    }
    message("vision", arg->name() + "揉揉眼睛，回房睡觉去了。\n", environment(arg));
    if (!(v1 = find_object("/d/dali/shuyuan2"))) {
        v1 = find_object("/d/dali/shuyuan2", 1);
    }
    arg->move(v1);
    command("sleep");
    call_out("do_back", 20, arg);
    return 1;
}

int do_back(mixed arg) {
    mixed v1;
    if (!arg) {
        return 0;
    }
    if (!living(arg)) {
        remove_call_out("do_back");
