    arg->delete("env");
    if (!(v1 = find_object(arg->query("startroom")))) {
        v1 = find_object(arg->query("startroom"), 1);
    }
    arg->move(v1);
    message("vision", arg->name() + "伸了伸懒腰，走了过来。\n", v1);
    return 1;
}

int return_home(mixed arg) {
    if (!environment() || environment() == arg) {
        return 1;
    }
    if (!living(this_object()) || is_fighting() || !mapp(environment()->query("exits"))) {
        call_out("return_home", 10, arg);
        return 1;
    }
    message("vision", this_object()->name() + "急急忙忙地离开了。\n", environment(), this_object());
    return move(arg);
}

int do_kill(mixed arg) {
