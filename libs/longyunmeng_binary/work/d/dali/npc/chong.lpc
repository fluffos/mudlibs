// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit NPC;

void create()
{
        set_name("萤火虫", ({ "cong" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一只亮晶晶的萤火虫\n");
        set("max_qi", 1);
        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set_skill("dodge", 200);

        setup();
}
