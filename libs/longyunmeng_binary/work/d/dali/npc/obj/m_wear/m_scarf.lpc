// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#include <armor.h>
inherit NECK;

/*  其他：
HEAD    头盔、头巾
NECK    项圈、围巾
ARMOR   盔甲
SURCOAT 外套
WAIST   护腰
WRISTS  护腕
SHIELD  盾
FINGER  指套
HANDS   手套
BOOTS   鞋子
*/

void create()
{
        set_name("围巾", ({ "my scarf","scarf" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一条用蚕丝织成的围巾，手工精细，针针体现着老裁缝高超的手艺。\n");
                set("unit", "条");
                set("material", "cloth");
                set("armor_prop/armor", 30);
                set("make",1);
                set("no_get",1);
//                set("no_drop",1);
                set("no_put",1);
        }
        setup();
        
}
mixed query_autoload()
{
        return query("name");
}
void autoload(string param)
{
        if (!param || !stringp(param))
        return;
        set("name",param);
}
void owner_is_killed() { destruct(this_object()); }

