void create() {
    set("short", "厢房");
    set("long", "屋小幽雅，正中一张小几，几上有琴，琴上无弦。旁边一圆凳，凳上鸳鸯垫。\n屋角木床，床单上大红刺绣，绣的是一对鸳鸯戏水。墙角挂着一幅小篆对联：\n                焚琴煮鹤从来有，惜香怜玉几个知。\n");
    set("exits", ([ "east" : "/d/dali/corror2" ]));
    set("sleep_room", 1);
    set("no_fight", "1");
