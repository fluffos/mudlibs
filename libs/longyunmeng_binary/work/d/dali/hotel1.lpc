    create_door("east", "木雕门", "west", 1);
}

void init() {
    add_action("do_makelove", "makelove");
}

int do_makelove(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v2 = this_player();
    if (v2->query("gender") == "无性") {
        tell_object(v2, "唉!你无根无性，今生今世都没这个能力了！\n");
        return 1;
    }
    if (!arg || !objectp(v1 = present(arg, environment(v2)))) {
        tell_object(v2, "你想和谁赴巫山之会？\n");
        return 1;
    }
    if (!v1->is_character() || v2->query("gender") == v1->query("gender")) {
        return notify_fail("这样...？！恐怕不行吧？\n");
    }
    if (!living(v1)) {
        return notify_fail("人家都这样了，你还...\n");
    }
    if (!environment(v2)->query("sleep_room") || environment(v2)->query("no_sleep_room")) {
        return notify_fail("总得找个温馨点儿的地方吧。\n");
    }
    v3 = all_inventory(environment(v2));
    for (v4 = 0; v4 < sizeof(v3); v4++) {
        if (v3[v4]->is_character() && v3[v4] != v2 && v3[v4] != v1 && !wizardp(v3[v4])) {
            return notify_fail("这儿还有别人呢，多不好意思呀！\n");
        }
    }
    if (!v2->query_temp("makelove/quest")) {
        if (v2->query("gender") == "男性") {
            message_vision("\e[1;35m$N轻轻来到$n身后，双手环抱在$n的腰间，\n\n在$n耳边柔声说道：亲爱的，今晚...\n\e[2;37;0m", v2, v1);
            tell_object(v1, "\e[1;31m傻子也能看出来他想和你共渡良宵，\n\n如果你愿意，请你也对" + v2->name() + "(" + v2->query("id") + ")" + "下一次 makelove 指令。\n\e" + "[2;37;0m");
        } else {
            message_vision("\e[1;35m不知是因为烛光，还是酒精，亦或是因为兴奋，$N的小脸儿红红的，\n\n端着酒杯，$N直勾勾地盯着$n：亲爱的...听说...喝酒...乱性...\n\e[2;37;0m", v2, v1);
            tell_object(v1, "\e[1;31m傻子也能看出来她想和你共渡良宵，\n\n如果你愿意，请你也对" + v2->name() + "(" + v2->query("id") + ")" + "下一次 makelove 指令。\n\e" + "[2;37;0m");
        }
        v1->set_temp("makelove/quest", 1);
    } else {
        if (v2->query("gender") == "男性") {
            message_vision("\e[1;35m$N回敬似的盯着$n的眼睛，半晌一言不发，突然一把抱住$n，\n\n一双热唇堵住了$n的嘴，让$n简直喘不上来气，酒杯、红烛打了一地...\n\e[2;37;0m", v2, v1);
            call_out("over", 1, v2, v1);
        } else {
            message_vision("\e[1;35m$n甚至能看见$N羞红的耳根，$N轻轻挣开$n的怀抱，\n\n默默地焚香沐浴，$n却再也忍不住，一把将$N抱了起来...\n\e[2;37;0m", v2, v1);
            call_out("over", 1, v1, v2);
        }
        v2->delete_temp("makelove/quest");
    }
    return 1;
}

void over(mixed arg1, mixed arg2) {
    message_vision("\e[1;31m...一阵疾风骤雨。\n\e[2;37;0m", arg1);
    if (arg1->query("qi") < 30 || arg1->query("jing") < 30 || arg2->query("qi") < 30 || arg2->query("jing") < 30) {
        if (arg1->query("qi") < 30 || arg1->query("jing") < 30) {
            message_vision("\e[1;31m$N突然口吐鲜血，晕倒在地。看来是纵欲过度了。\e[2;37;0m", arg1);
            arg1->unconcious();
        } else {
            message_vision("\e[1;31m$N突然口吐鲜血，晕倒在地。看来是纵欲过度了。\e[2;37;0m", arg2);
            arg2->unconcious();
        }
    } else {
        switch (random(10)) {
        case 0:
            message_vision("\e[1;31m$N突然大叫一声，显然是极度兴奋，紧接着竟晕死过去！\n\e[2;37;0m", arg1);
            arg1->unconcious();
            arg2->add("qi", arg2->query_str() - 55 + random(10));
            arg2->add("jing", arg2->query_con() - 55 + random(10));
            break;
        case 1:
            message_vision("\e[1;31m$N突然大叫一声，显然是极度兴奋，紧接着竟晕死过去！\n\e[2;37;0m", arg2);
            arg2->unconcious();
            arg1->add("qi", arg2->query_str() - 55 + random(10));
            arg1->add("jing", arg2->query_con() - 55 + random(10));
            break;
        default:
            if (random(1)) {
                message_vision("\e[33m$N坐在一旁闷头不语，望了一眼仍在微微娇喘的$n，\n\n喃喃说到：要不然...再让我试一次...\n\e[2;37;0m", arg1, arg2);
            } else {
                message_vision("\e[1;33m$n静静地躺在$N的怀里，靠着那起伏的胸膛，\n\n听着那均匀的呼吸，感到无限的幸福...\n\e[2;37;0m", arg1, arg2);
            }
            arg2->add("qi", arg2->query_str() - 55 + random(10));
            arg2->add("jing", arg2->query_con() - 55 + random(10));
            arg1->add("qi", arg2->query_str() - 55 + random(10));
            arg1->add("jing", arg2->query_con() - 55 + random(10));
        }
    }
}

