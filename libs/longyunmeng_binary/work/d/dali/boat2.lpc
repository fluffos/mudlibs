// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
void create()
{
        set("short", "云雨舟甲板");
        set("long", @LONG
湖色淡绿，天色淡蓝。微波荡漾，风景宜人。一声声划拳行酒令，加杂着女人的
娇笑，不时的从船舱中传出。聆耳细听，风声中似乎还加杂着低低的悲泣之声。与船
上的欢声笑语极不融洽。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"boat1",
  "south" : __DIR__"boat3",
]));

        set("objects", ([
        __DIR__"npc/shuishou" : 2,
        __DIR__"npc/mother": 2,
                        ]) );

        set("outdoors","dali");

        setup();
}
