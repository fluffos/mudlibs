int do_climb(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着呢！\n");
    }
    if (v1->query("str") >= 25 && v1->query_skill("force", 1) < 150) {
        write("\e[1;33m\n你运劲双肩，手脚兼用，向前钻去，但孔道确实太小，不能进去。\n\n\e[2;37;0m");
        write("\e[1;31m\n你只觉得整个身体被嵌在孔中，不能移动了。\n\e[2;37;0m");
        v1->start_busy(10);
        return 1;
    }
    if (v1->query("str") < 25) {
        message("vision", v1->name() + "加速向前钻去。\n", environment(v1), ({ v1 }));
        write("你手足兼用，迅速向有光亮之处钻去。\n");
    } else {
        message_vision("$N运起内功，硬生生地向前钻去。\n", v1);
    }
    write("\e[1;32m\n你眼前霍然一亮，竟然是一个青翠的山谷！\n\n");
    v1->move("/d/fairyland/cuigu");
    v1->start_busy(1);
    message("vision", v1->name() + "从洞口钻了出来。\n", environment(v1), ({ v1 }));
    return 1;
}

