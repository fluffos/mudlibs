// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// zhu-changling.c 

#include <ansi.h>
inherit NPC;

void create()
{
	set_name("朱长龄", ({"zhu changling", "zhu"}));
	set("title", HIR"红梅山庄庄主"NOR);
	set("gender", "男性");
	set("age", 45);
        set("unique", 1);

	set_skill("unarmed", 60);
	set_skill("force", 50);
	set_skill("dodge", 65);
	set_skill("parry", 65);
	set_temp("apply/attack", 40);
	set_temp("apply/defense", 40);
	set_temp("apply/damage", 10);

	set("combat_exp", 70000);
	set("shen_type", -1);
	setup();
	add_money("silver", 50);
}

