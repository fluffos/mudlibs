// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// xueji.c

inherit NPC;

void create()
{
        set_name("雪鸡", ({"xue ji","ji"}));
        set("race", "野兽");
        set("age", 2);
        set("long", "一只肥肥白白的雪鸡。\n");

        set("limbs", ({ "头部", "身体", "前爪", "后爪", "尾巴" }) );
        set("verbs", ({ "bite", "claw" }) );

        set("combat_exp", 100);

	set_temp("apply/attack", 20);
        set_temp("apply/defense", 20);
        set_temp("apply/damage", 20);
        set_temp("apply/armor", 10);

        setup();
}

void die()
{
       message_vision("$N惨嚎一声，慢慢倒下死了！\n", this_object());
       new("d/fairyland/obj/xueji-rou")->move(environment());
       destruct(this_object());
}
