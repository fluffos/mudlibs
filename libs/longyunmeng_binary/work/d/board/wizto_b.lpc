// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// /clone/board/towiz_b.c
inherit BULLETIN_BOARD;
void create()
{
	set_name("巫师公告板", ({ "board" }) );
	set("location", "/d/city/wumiao");
	set("board_id", "wizto_b");
	set("long", "这是一个巫师发布公告的留言板。\n" );
	setup();
	set("capacity", 60);
}
varargs int do_post(string arg)
{
	if (!wizardp(this_player()))
		return notify_fail("只有巫师才可以在这里留言。\n");
	return ::do_post(arg);
}
