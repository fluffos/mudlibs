// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// /clone/board/wudang_b.c
inherit BULLETIN_BOARD;
void create()
{
	set_name("武当弟子留言板", ({ "board" }) );
	set("location", "/d/wudang/sanqingdian");
	set("board_id", "wudang_b");
	set("long", "这是一个供武当门下交留的留言板。\n" );
	setup();
	set("unit","块");
	set("capacity", 30);
}
