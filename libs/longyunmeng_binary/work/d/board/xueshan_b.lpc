// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// /clone/board/xueshan_b.c
// by secret
inherit BULLETIN_BOARD;
void create()
{
       set_name("雪山寺缘法轮",({ "board" }) );
	set("location", "/d/xueshan/dadian");
	set("board_id", "xueshan_b");
        set("long",
		"这是一个黄铜铸成的法轮，从它上面斑驳的铜绿痕迹可以看出它的年代已经\n"
		"相当久远了，缘法轮旁边放著一本册子供寺中僧人或香客留言。\n" );
	setup();
	set("unit","个");
	set("capacity", 30);
}
