// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// /clone/board/baituo_b.c
inherit BULLETIN_BOARD;
void create()
{
	set_name("灵鹫宫弟子留言板", ({ "board" }) );
	set("location", "/d/lingjiu/dating");
	set("board_id", "lingjiu_b");
	set("long", "这是一个供灵鹫宫弟子交流的留言板。\n" );
	setup();
	set("unit","块");
	set("capacity", 30);
}
