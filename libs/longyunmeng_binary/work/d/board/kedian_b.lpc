// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// /clone/board/kedian_b.c
inherit BULLETIN_BOARD;
void create()
{
	set_name("客店留言板", ({ "board" }) );
	set("location", "/d/city/kedian");
	set("board_id", "kedian_b");
    set("no_get",1);
	set("long", "一块普通的留言板，供过往的行人留言用。\n" );
	setup();
	set("unit","块");
        set("capacity", 218);
	replace_program(BULLETIN_BOARD);
}
