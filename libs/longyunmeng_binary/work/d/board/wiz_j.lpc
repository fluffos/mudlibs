// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// /clone/board/wiz_b.c
inherit BULLETIN_BOARD;
void create()
{
    set_name("工作里程碑", ({ "bei" }) );
	set("location", "/d/wizard/wizard_job");
	set("board_id", "wiz_j");
    set("long", "这是一本专供巫师记录工作的大理石碑。\n");
	setup();
	set("capacity", 60);
}
