// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// qin.c
#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
        set_name(HIW"白玉瑶琴"NOR, ({ "yao qin", "qin"}));
        set_weight(6000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "具");
                set("long", "这是一具用白玉做成的瑶琴。\n");
                set("value", 2000);
                set("material", "steel");
                set("wield_msg", "$N从背后将$n拿在手中。\n");
                set("unwield_msg", "$N将手中的$n放回背后。\n");
        }
        init_sword(100);
        setup();
}

int query_autoload() { return 1; }	
