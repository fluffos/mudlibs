    set("short", "\e[1;36m练功房\e[2;37;0m");
    set("long", "    这是一间用花岗岩砌成的石屋。室内一只大炉中燃了洪炭，煮着热\n气腾腾的一镬(huo )东西，镬旁两个黑衣小童，一个使劲推拉风箱，另一个\n用铁铲翻炒镬中之物，听这沙沙之声，所炒的似是铁沙。几名帮中弟子闭目\n盘膝坐在锅前，或对着腾上的热气吐呐，或插指于镬中苦练。\n");
    set("exits", ([ "east" : "/d/tiezhang/guangchang" ]));
    set("objects", ([ "/d/tiezhang/npc/heiyi" : 1 ]));
    set("item_desc", ([ "huo" : "这是一口巨大的铁锅，锅中盛满铁沙，下面燃着炭火。\n" ]));
    setup();
}

void init() {
    add_action("do_chazhi", "chazhi");
}

int do_chazhi(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!living(v2)) {
        return 0;
    }
    if (!living(this_player()) || arg != "huo") {
        write("你想往哪儿插呀！\n");
        return 1;
    }
    if (!(v1 = this_player()->query("family")) || v1["family_name"] != "铁掌帮") {
        return notify_fail("你非本帮弟子，不能在此练功！\n");
    }
    if (v2->query_skill("strike", 1) > 100) {
        return notify_fail("你将双手插入镬中，发现铁沙的温度对你来说太低，已毫无意义了。\n");
    }
    if (v2->query("qi") < 30) {
        v2->receive_damage("qi", 10);
        write("你觉得一股热气直逼上来，焦燥难当！\n");
        v2->unconcious();
        return 1;
    }
    v2->receive_damage("qi", random(40));
    v2->improve_skill("strike", v2->query("int"));
    message_vision("$N将双手插进镬中的铁沙里。\n", v2);
    write("灼热的铁沙将你的双手烫得通红，你觉得双手变得强壮有力。\n");
    return 1;
}
