void greeting(mixed arg) {
    if (!present(arg, environment())) {
        return;
    }
    switch (random(2)) {
    case 0:
        say("店小二笑咪咪地说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，进来喝杯茶，歇歇腿吧。\n");
        break;
    case 1:
        say("店小二用脖子上的毛巾抹了抹手，说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，请进请进。\n");
