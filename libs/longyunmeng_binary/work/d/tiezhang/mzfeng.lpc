int do_caiqi(mixed);

void create() {
    set("short", "拇指峰");
    set("long", "    拇指峰是铁掌五峰中最为低矮的一峰，名为峰，实则只是一座较\n高的石山罢了。峰顶到处是又大又圆的岩石，在日晒雨淋下，被风蚀得十\n分光滑。在岩石的缝隙中，长出许多松树，其中一棵尤其引人注目。这棵\n松名为--并蒂松(song)，乃同根而生，于距地一米高处，忽分为二。这两\n根树干同粗同高，均长得高大挺拔，枝叶茂盛，尤如兄弟一般，因此又名\n--兄弟松。\n");
    set("exits", ([ "southdown" : "/d/tiezhang/sslu-3" ]));
    set("item_desc", ([ "song" : "这棵松树能长得如此奇特，必蕴涵了天地日月之精华。\n" ]));
    set("no_clean_up", 0);
    setup();
}

void init() {
    add_action("do_caiqi", "caiqi");
}

int do_caiqi(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!living(v2)) {
        return 0;
    }
    if (!living(this_player()) || arg != "song") {
        message_vision("你想干什么？\n", v2);
        return 1;
    }
    if (!(v1 = this_player()->query("family")) || v1["family_name"] != "铁掌帮") {
        return notify_fail("你非本帮弟子，不能在此练功！\n");
    }
    if (v2->query_skill("force", 1) > 100) {
        return notify_fail("你的内功太高了，已经不能从树中采气了！\n");
    }
    if (v2->query_skill("force", 1) < 30) {
        return notify_fail("你的内功太低了，还不能从树中采气！\n");
    }
    if (v2->query("jing") < 20) {
        v2->receive_damage("jing", 10);
        write("你忽然觉得头痛欲裂，无法控制体内的真气！\n");
        v2->unconcious();
        return 1;
    }
    v2->receive_damage("jing", random(40));
    message_vision("$N双手呈环状，虚抱住一只树干，缓缓吐呐练功。\n", v2);
    v2->improve_skill("force", v2->query("int"));
    return 1;
}
