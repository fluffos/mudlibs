void create() {
    set("short", "\e[32m无名峰\e[2;37;0m");
    set("long", "    跨过路上的荆棘和荒草，你终于登上了无名峰的峰顶。由于这里 \n地处五峰之中，四周有其它山峰阻挡，因此风势很小，常年笼罩在一片云雾\n之中。峰顶长满了齐腰的荒草，怪石嶙峋，一片荒凉景色。在峰顶的正中，\n赫然矗立着一座岩石砌就的坟墓，坟墓的前面立着一块一人多高的花岗岩的 \n墓碑(bei)。\n");
    set("exits", ([ "southdown" : "/d/tiezhang/hclu-4" ]));
    set("item_desc", ([ "bei" : (: look_bei :) ]));
    set("no_clean_up", 0);
    set("outdoors", "tiezhang");
    setup();
}

void init() {
    add_action("do_move", "move");
}

int do_move(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (this_player()->query_temp("marks/闹1")) {
        if (v1->query_str() < 30) {
            return notify_fail("你的力量不够，无法将石碑推开。\n");
        }
        if (arg != "bei") {
            return notify_fail("你要推什么？？\n");
        }
        write("你扎下马步，深深的吸了口气，将墓碑缓缓的向旁推开。\n");
        message("vision", v1->name() + "双膀用力，将墓碑向旁缓缓推开，下面露出一个黑洞洞的入口。\n", environment(v1), ({ v1 }));
        set("exits/enter", "/d/tiezhang/shijie-1");
        remove_call_out("close_passage");
        call_out("close_passage", 10);
        return 1;
    }
    return notify_fail("你有病呀！没事推墓碑做什么？？\n");
}

void close_passage() {
    if (!query("exits/enter")) {
        return;
    }
    message("vision", "墓碑发出隆隆的声音，缓缓移回原处。\n", this_object());
    delete("exits/enter");
}

