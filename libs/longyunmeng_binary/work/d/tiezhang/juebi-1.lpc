int do_climb(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (v2->query_skill("dodge", 1) < 30) {
        return notify_fail("你的轻功不够，无法爬上去。\n");
    }
    if (!(v1 = this_player()->query("family")) || v1["family_name"] != "铁掌帮") {
