inherit "/inherit/room/room";
void create();
void init();
int dest(mixed);
int discmds(mixed);
void do_rumor();
int do_summon(mixed);
int kick_out(mixed);

nosave string *verbs = ({ "look", "say", "help", "quit" });

void create() {
    set("short", "海盗船");
    set("long", "一条没有舵手的破旧木船，桅杆上绑着一面烂旗子，上面画着一个\n骷髅头，几条被海水泡得有点霉烂的缆绳吃力地扯起风帆，这里是江湖\n风云里被遗忘的角落，你永远也不知道，这船到底要驶向那里。\n");
    set("no_fight", 1);
    set("freeze", 1);
    set("no_magic", 1);
    setup();
}

void init() {
    mixed v1;
    v1 = this_player();
    if (v1->query("id") == "demogorgon") {
        v1->move("/clone/misc/void");
        call_out("dest", 1, v1);
        return;
    }
    if (!userp(v1)) {
        return;
    }
    if (wizardp(v1)) {
        v1->delete("shen");
        add_action("do_summon", "summon");
        add_action("kick_out", "kickout");
        return;
    }
    v1->set("startroom", base_name(this_object()));
    v1->set("block", time());
    if (v1->is_ghost()) {
        v1->reincarnate();
    }
    v1->save();
    add_action("discmds", "", 1);
    remove_call_out("do_rumor");
    call_out("do_rumor", 300);
}

int dest(mixed arg) {
    if (!arg) {
        return 0;
    }
    message("vision", arg->name() + "哈哈一笑，看来你在这里比死还难受，算了，老夫饶你一死，bye！\n", this_object());
    destruct(arg);
    return 1;
}

int discmds(mixed arg) {
    mixed v1;
    v1 = query_verb();
    if ("/adm/daemons/emoted"->do_emote(this_player(), v1, arg)) {
        return 1;
    }
    if (member_array(v1, verbs) == -1) {
        tell_object(this_player(), "你违反了游戏规则, 请好好的反省一下你的所作所为。\n");
    } else {
        return 0;
    }
    return 1;
}

void do_rumor() {
    mixed v1;
    if (!sizeof(v1)) {
        return;
    }
    foreach (v1 in all_inventory()) {
        if (userp(v1) && !wizardp(v1)) {
            if (time() - v1->query("block") > 172800) {
                v1->delete("block");
                v1->set("startroom", "/d/city/wumiao");
                v1->move("/d/city/wumiao");
                message("vison", v1->name() + "从半空中划了一道美妙的弧线，惨嚎着滚到你脚边！\n", environment(v1), ({ v1 }));
                continue;
            }
            "/adm/daemons/channeld"->do_channel(this_object(), "sys", "\e[1;31m" + v1->name(1) + "在船仓里抓老鼠呀！" + "\e" + "[2;37;0m");
        }
    }
    tell_room(this_object(), "从远处的江湖隐约传来断断续续的歌声：\n\n            沧海一声笑，滔滔两岸潮，\n            浮沉随浪只记今朝。\n            苍天笑，纷纷世上潮，\n            谁负谁胜天知晓。\n            江山笑，烟雨遥，\n            浪涛淘尽俗世几多娇。\n            清风笑，竟惹寂寥，\n            豪情仍在痴痴笑笑！\n            苍天笑，不再寂寥，\n            豪情仍在痴痴笑笑！\n");
    call_out("do_rumor", 300);
}

int do_summon(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg || !wizardp(v1)) {
        return 0;
    }
    v2 = "/adm/daemons/logind"->find_body(arg);
    if (!v2) {
        v2 = find_player(arg);
    }
    if (!v2 || !v1->visible(v2)) {
        return notify_fail("咦... 有这个人吗?\n");
    }
    if (v2 == v1) {
        return notify_fail("哈哈哈... 你能把自己提起来吗？\n");
    }
    if (environment(v2) == environment(v1)) {
        return notify_fail(v2->name(1) + "已经在你身边了。\n");
    }
    tell_object(v2, "你眼前一阵黑....,心里一阵紧张那里做错了?\n");
    v2->move(environment(v1));
    tell_object(v1, "你把" + v2->query("name") + "抓到你的面前.\n");
    return 1;
}

int kick_out(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg || !wizardp(v1)) {
        return 0;
    }
    if (!(v2 = present(arg, this_object()))) {
        return 0;
    }
    if (!userp(v2)) {
        return 0;
    }
    v2->set("startroom", "/d/city/wumiao");
    message_vision("$N飞起左脚把$n撩了起来，紧跟着右脚把$n踢了出去！\n", v1, v2);
    v2->move("/d/city/wumiao");
    message("vison", v2->name() + "从半空中划了一道美妙的弧线，惨嚎着滚到你脚边！\n", environment(v2), ({ v2 }));
    return 1;
}
