// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// youngboy.c  苗族少年
inherit NPC;

void create()
{
	set_name("苗族少年", ({ "young boy", "boy" }));
	set("gender", "男性");
	set("age", 20);
       set("per",30);
       set("max_qi",400);
	set("long", "一个身穿苗族服饰的英俊少年。\n");
	set("combat_exp", 8000);
	set("shen_type", 1);
       set_skill("unarmed", 30);
       set_skill("dodge", 30);
	setup();
	carry_object("/d/city/obj/cloth")->wear();
}
	
