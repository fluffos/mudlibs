// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//   zhanglang.c
//  by victori
inherit NPC;
void create()
{
        set_name("蟑螂", ({ "zhang lang","lang" }) );
	 set("race", "野兽");
        set("age", 4);
	 set("per", 30);
        set("long", "一只令人恶心的小虫子，正好奇的看着你。\n");
        set("combat_exp", 60);
        set("attitude", "friendly");
set("limbs", ({ "头部", "身体", "尾巴" }) );	
	set_skill("dodge", 300);
	set_skill("unarmed", 5);
	set_skill("parry", 5);
	set("max_qi", 100);

  	set("chat_chance",10);
  	set("chat_msg",({
        "叽叽...叽叽叽叽，....叽叽叽..~~~~。\n",

    	}));
        setup();

}
