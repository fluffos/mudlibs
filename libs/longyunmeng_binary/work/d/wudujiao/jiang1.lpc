void check_trigger() {
    mixed v1;
    if (!query("exits/enter")) {
        if (!(v1 = find_object("/d/wudujiao/duchuan"))) {
            v1 = find_object("/d/wudujiao/duchuan", 1);
        }
        if (v1 = find_object("/d/wudujiao/duchuan")) {
            if (!v1->query("yell_trigger")) {
                v1->set("yell_trigger", 1);
                set("exits/enter", "/d/wudujiao/duchuan");
                v1->set("exits/out", "/d/wudujiao/jiang1.lpc");
                message("vision", "一叶扁舟缓缓地驶了过来，艄公将一块踏脚板搭上堤岸，以便乘客\n上下。\n", this_object());
                message("vision", "艄公将一块踏脚板搭上堤岸，形成一个向上的阶梯。\n", v1);
                remove_call_out("on_board");
