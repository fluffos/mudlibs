// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// skirt.c
//
// This is the basic equip for players just login.

#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create()
{
        set_name(HIR"天蚕丝裙"NOR, ({ "skirt" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一件用天蚕丝织成的裙子，摸上去柔软光滑。\n");
                set("unit", "件");
                set("material", "cloth");
                set("armor_prop/armor", 150);
//              set("value", 2000);
       }
        setup();
}

int query_autoload() { return 1; }