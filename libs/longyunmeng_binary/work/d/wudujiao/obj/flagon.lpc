// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// flagon.c  酒壶

 inherit ITEM;
inherit F_LIQUID;
// inherit COMBINED_ITEM;

void create()
{
	set_name("酒壶", ({"jiu hu", "hu", "flagon"}));
	set_weight(700);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一个用来装烧酒的大酒壶。\n");
		set("unit", "个");
		set("value", 100);
		set("max_liquid", 15);
	}
 
	// because a container can contain different liquid
	// we set it to contain wine at the beginning
	set("liquid", ([
		"type": "alcohol",
		"name": "烧酒",
		"remaining": 15,
		"drunk_apply": 3,
              "slumber_effect": 100,
	]));
}
int query_autoload() { return 1; }