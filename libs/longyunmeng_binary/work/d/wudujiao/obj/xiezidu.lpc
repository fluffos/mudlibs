// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#include <ansi.h>

inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_eat","eat");
}

void create()
{
	       set_name("蝎子毒囊", ({"xiezi dunang" ,"dunang"}));
	
		set("unit", "个");
		set("long", "这是一个蝎子的毒囊。\n");
		set("value", 100);
//            set("no_drop", "这样东西不能离开你。\n");
              set_weight(100);

	
	setup();
}

int do_eat(string arg)
{
    object me = this_player();
    if (arg != "xiezi dunang"&& arg !="dunang")
    return 0;
    tell_object(me,  "你想死啊，用suicide比较快一点。\n" );
    return 1;
}
int query_autoload() { return 1; }