// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// shandao2.c

inherit ROOM;

void create()
{
        set("short", "山道");
        set("long", @LONG
这一路上山，地势极险，脚下是万丈深谷，而山道极之陡峭
窄小，倘若一不留神，必将命丧于此。
LONG    );
        set("outdoors", "heimuya");
        set("exits", ([
            "eastdown" : __DIR__"shandao1",
            "westup"   : __DIR__"shijie1",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
