// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
 
void create()
{
        set("short", "草地");
        set("long",@LONG
你走在一片草地。草地西边似乎香气四逸,东边好象是一个小花圆。
LONG );
        set("exits", ([
  "west"   : __DIR__"chufang1",
  "east"   : __DIR__"hua1",
   "north" :__DIR__"dating1",
   "south" :__DIR__"grass1",
]));
           setup();
}
