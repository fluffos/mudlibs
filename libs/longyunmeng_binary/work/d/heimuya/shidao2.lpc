// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// shidao1.c

inherit ROOM;

void create()
{
        set("short", "石道");
        set("long", @LONG
一路上日月教教众把守严密，经过三处山道，来到一处水滩
之前，西面有一道石阶通往水滩。
LONG    );
        set("outdoors", "heimuya");
        set("exits", ([
            "westdown" : __DIR__"xingxingtan",
            "south" : __DIR__"shidao1",
        ]));
        set("objects", ([
            __DIR__"npc/wangcheng" : 1,
            __DIR__"npc/heiyiren" : 2,
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
