// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
 
void create()
{
        set("short", "圣姑堂");
        set("long",@LONG
这里是黑木崖的圣姑所在地“圣姑堂”。堂上无彩云罗,刹是
漂亮.堂中一位妙龄女子,神彩奕奕.
LONG );
        set("exits", ([
  "east"   : __DIR__"chitang",
]));
        set("objects", ([
		__DIR__"npc/ren" : 1,
		__DIR__"npc/shinu":2,
           ]));       
         setup();
}
