int do_jump(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg != "down") {
        return notify_fail("你想要跳崖自杀？这么想不开啊？\n");
    }
    tell_object(v1, "\e[1;31m你不加思索，纵身一跃，跳下了悬崖。。。。\n\e[2;37;0m");
    message("vision", "\e[2;37;0m只见" + v1->query("name") + "万念俱灰，纵身跳入了悬崖之中。。。。\n\e" + "[2;37;0m", environment(v1), v1);
    if (random(v1->query_kar()) < 10 && v1->query_skill("dodge") < 30) {
        v1->die();
        return 1;
    }
    v1->set("qi", -1);
    v1->move("/d/heimuya/zhaoze/xiaoyao/yanfeng");
