void create() {
    set("short", "洪荒古泽");
    set("long", "你站在齐腰深的水里，周围是给烧得乌黑的古树和芦苇。前面有\n一缺口，象是被一种巨大的动物经过所形成的。远处隐隐传来阵阵的\n低沉的声音和热浪。\n");
    set("exits", ([ "southwest" : "/d/heimuya/zhaoze/huozhao1" ]));
