}

void init() {
    mixed v1;
    v1 = this_player();
    add_action("do_pull", "pull");
    if (random(v1->query("kar")) < 10) {
        message_vision("\e[31m$N身子突然下沉... ...\n\e[2;37;0m", v1);
        v1->set_temp("drop_zhaoze", 1);
    }
}

int do_pull(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!arg) {
        return notify_fail("你要拉谁？\n");
    }
    if (!(v1 = present(arg, this_object()))) {
        return notify_fail("你要拉谁？\n");
    }
    if (v2->query_temp("drop_zhaoze")) {
        return notify_fail("你自己都自身难保了，还想拉别人？\n");
    }
    if (!v1->query_temp("drop_zhaoze")) {
        return notify_fail(v1->name() + "不用你拉！\n");
    }
    message_vision("你扯住$N的手，使劲把$n扯了上来。\n", v2, v1);
    v1->delete_temp("drop_zhaoze");
    return 1;
}

int valid_leave(mixed arg1, mixed arg2) {
    if (arg2 == "south" && arg1->query_temp("drop_zhaoze")) {
        message_vision("$N使劲挣扎一下，试图爬出泥潭.....\n", arg1);
        if (random(10) > 5) {
            arg1->apply_condition("scorpoin_poison", 20);
            tell_object(arg1, "\e[31m\n你突然觉得脚被什么东西刺了一下... ...\n\e[2;37;0m");
        }
        if (random(arg1->query_skill("dodge", 1)) > 600) {
            message_vision("$N身形一纵，跃出泥潭。\n", arg1);
            return 1;
        } else {
            message_vision("$N结果越陷越深！\n", arg1);
            arg1->set_temp("die_for", "陷进沼泽闷");
            arg1->receive_wound("qi", 200);
            return notify_fail("你陷入沼泽，动弹不得。\n");
        }
    }
    return 1;
}
