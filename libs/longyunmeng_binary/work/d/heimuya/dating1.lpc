// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//ROM dating
inherit ROOM;
void create()
{
        set("short", "堂厅");
        set("long",
             "这是『日月神教』下第一大堂:风雷堂的大厅，四目望去,满朴素的,\n"
         "堂梁上有一副联子(vote).\n"
        );
	
        set("exits", ([
                "south" : __DIR__"grass2",
                "northdown" : __DIR__"linjxd5",
        ]));
 
        set("objects",([
		               __DIR__"npc/jiaotu" : 2,
        ]));
        set("item_desc", ([
        "vote": "日月神教,文成武德,泽被苍生。\n"
	]) );
        setup();
        
}
