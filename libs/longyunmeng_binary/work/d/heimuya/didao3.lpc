// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//room: didao5.c
inherit ROOM;
void create()
{
  set("short","秘道");
  set("long",
	"\n"
        "走在里面,你不觉想到这似乎在每个角落都藏着无限杀机,你感到近了近\n"
        "了,越来越近了。\n"
     );
  set("exits",([
      "east" : __DIR__"didao3",
      "west" : __DIR__"didao3",
      "north" : __DIR__"didao4",
      "south" : __DIR__"didao1",
     ]));
   
 setup();
}
