int do_yell(mixed arg) {
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "boat") {
        arg = "船家";
    }
    if (this_player()->query("age") < 16) {
        message_vision("$N使出吃奶的力气喊了一声：“" + arg + "”\n", this_player());
    } else if (this_player()->query("neili") > 500) {
        message_vision("$N吸了口气，一声“" + arg + "”，声音中正平和地远远传了出去。\n", this_player());
    } else {
        message_vision("$N鼓足中气，长啸一声：“" + arg + "！”\n", this_player());
    }
    if (arg == "船家") {
        check_trigger();
        return 1;
    } else {
        message_vision("风浪中远远传来一阵回声：“" + arg + "～～～”\n", this_player());
    }
    return 1;
}

