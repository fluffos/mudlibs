// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// dafu.c

#include <ansi.h>
#include <weapon.h>

inherit AXE;

void create()
{
	set_name("大斧", ({"da fu", "axe"}));
	set_weight(5000);

	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "一柄十分锋利的大斧。\n");
		set("value", 100);
		set("material", "bamboo");
		set("wield_msg", "$N回手从身后抽出一柄大斧。\n");
		set("unwield_msg", "$N手往后一别，把大斧插在后腰上。\n");
	}
	init_axe(50);
	setup();
}
int query_autoload() { return 1; }