// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// bishuijian.c
// for 岳灵珊
#include <weapon.h>
inherit HAMMER;
void create()
{
        set_name("紫金锤", ({ "zijin chui", "chui", "hammer" }));
        set_weight(300000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "枚");
                set("long", "这是一枚由海底金母铸造而成的大锤，看上去紫\n"
			    "光盈盈, 显得极是沉重。\n");
                set("value", 10000);
                set("material", "steel");
                set("wield_msg", "$N振臂一挥, 抡出一枚沉重的$n。\n");
                set("unwield_msg", "$N将手中的$n慢慢收回。\n");
        }
        init_hammer(400,2);
        setup();
}
int query_autoload() { return 1; }