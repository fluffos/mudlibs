// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
 
void create()
{
        set("short", "白虎堂");
        set("long",@LONG
这里是黑木崖的第二大堂“白虎堂”。堂内青砖铺地,堂内横尸满地。
LONG );
        set("exits", ([
  "north"   : __DIR__"baistep2",
  "south"      : __DIR__"chitang", 
]));
        set("objects", ([
		__DIR__"npc/shanggy" : 1,
           ]));       
         setup();
}
