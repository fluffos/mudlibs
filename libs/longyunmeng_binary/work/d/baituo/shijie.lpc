// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//shijie.c
inherit ROOM;
void create()
{
  set("short","石阶");
  set("long","这里是青石板铺成的石阶。\n");
  set("exits",([
      "east" : __DIR__"caoping",
	"northup" : __DIR__"damen",
      "southdown" : __DIR__"guangchang" ,
     ]));
  set("outdoors", "baituo");
  setup();
}
