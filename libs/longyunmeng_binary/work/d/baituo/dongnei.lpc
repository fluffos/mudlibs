// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//dongnei.c
inherit ROOM;
void create()
{
	set("short", "洞内");
	set("long",
	     "这里是山贼的老窝的所在。旁边有一侧洞，里面隐隐传来女子的哭声。\n"
	);
	set("exits", ([
		"west" : __DIR__"cedong",
		"south" : __DIR__"dongkou",
	]));
	set("objects",([
		__DIR__"npc/shanzei3" : 1,
	]));
	setup();
}
int valid_leave(object me, string dir)
{
	object ob=present("shanzei tou",environment(me));
	if (objectp(ob) && living(ob))
	if (  (dir == "west") )
		 return notify_fail("山贼头操起拳头：你想占我老婆的便宜？快滚！\n");
	return ::valid_leave(me, dir);
}
