// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//nongshe.c
inherit ROOM;
void create()
{
        set("short", "农舍");
        set("long",
             "这里是一间小农舍，家具很新。看来主人比较富裕。\n"
        );
        set("exits", ([
                "west" : __DIR__"guangchang",
        ]));
        set("objects",([
		__DIR__"npc/woman" : 1,
        ]));
        setup();
}
