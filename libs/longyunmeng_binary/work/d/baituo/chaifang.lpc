// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//room: caifang.c
inherit ROOM;
void create()
{
  set("short","柴房");
  set("long","这是间不宽的柴房，木柴已经快烧光了，墙角放着几把『柴刀』。\n");
  set("exits",([
      "west" : __DIR__"chufang",
     ]));
  set("objects",([
    __DIR__"npc/laocai" : 1,
    ]));
 setup();
 replace_program(ROOM);
}
