// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//room: /d/btshan/restroom.c
//restroom
inherit ROOM;
void create()
{
  set("short","休息室");
  set("long",
      "这里是间休息室，里面有张大床。在这里睡觉非常舒服，没人能\n"
  "打扰。南面是气派的长廊。\n"
     );
  set("exits",([
      "south" : __DIR__"changlang",
     ]));
  set("sleep_room", 1);
  set("no_fight",1);
  set("no_steal",1);
 setup();
}
