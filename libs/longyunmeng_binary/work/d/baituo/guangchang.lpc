// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//ROM
inherit ROOM;
void create()
{
        set("short", "广场");
        set("long",
             "这里是一块不小的广场，上面堆着农家晒的谷物。北上是\n"
         "『白驼山庄』。东面有间小农舍，西边有块菜地，东南方是一\n"
         "座小桥。\n"
        );
        set("outdoors", "baituo");
        set("exits", ([
                "east" : __DIR__"nongshe",
//                "west" : __DIR__"caide",
                "northup" : __DIR__"shijie",
                "northwest" : __DIR__"shanlu",
                "southeast" : __DIR__"bridge",
        ]));
        set("objects",([
		__DIR__"npc/kid" : 2,
	]));
        setup();
        replace_program(ROOM);
}
