// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//zhuyuan.c
inherit ROOM;
void create()
{
  set("short","竹园");
  set("long",
      "这里是一个幽静的竹园，高高低低的翠竹把这里装点得\n"
  "别有情致。西北方是后院，东北方有个兔苑。南边是花园。\n"
     );
  set("exits",([
      "northeast" : __DIR__"tuyuan",
      "northwest" : __DIR__"houyuan",
      "south" : __DIR__"huayuan",
     ]));
  set("outdoors", "baituo");
  setup();
}
