// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//room: houmen.c
inherit ROOM;
void create()
{
	set("short","后门");
	set("long",
       "这是个山庄的后门。这里有捷径可以通向星宿海。\n"
	);
	set("exits",([
		"north" : "/d/xingxiu/xxh1",
		"south" : __DIR__"tuyuan",
	]));
        set("objects", ([
            __DIR__"npc/menwei" : 1 ,
       ]));
	set("outdoors", "baituo");
	setup();
}
int valid_leave(object me, string dir)
{
	object ob=present("men wei", environment(me));
	if (objectp(ob) && living(ob))
	if (  (dir == "south")  && ((int)me->query("shen") > 300))
	 return notify_fail("门卫把手一拦：你这种正派人物，老子一看就恶心，快滚！\n");
	return ::valid_leave(me, dir);
}
