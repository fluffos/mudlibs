// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// woman.c
inherit NPC;
void create()
{
	set_name("樵夫", ({ "qiao fu","qiao","fu" }) );
	set("gender", "男性" );
	set("age", 33);
	set("long", "一个很健壮的樵夫。\n");
	set("shen_type", 1);
	set("combat_exp", 800);
	set("str", 22);
	set("dex", 18);
	set("con", 18);
	set("int", 18);
	set("attitude", "friendly");
	setup();
	carry_object("/clone/misc/cloth")->wear();
	carry_object("/d/baituo/obj/chai");
	carry_object("/d/baituo/obj/chaidao")->wield();
}
