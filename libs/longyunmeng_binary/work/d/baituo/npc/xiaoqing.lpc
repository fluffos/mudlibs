void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (random(2) == 1) {
        say("小青笑吟吟地说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "请进，见到你真高兴。\n");
        return;
    } else {
        say("小青笑了笑说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "快请进吧。 \n");
        return;
    }
}

string inquiry_gao() {
    mixed v1;
    v1 = this_player();
    if (query_temp("dan") == 3) {
        return "你没见我已经作好了嘛！\n";
    }
    if (!query_temp("times")) {
        return "师傅现在已经不叫我做『蛇胆膏』了！\n";
    }
    say("这位" + "/adm/daemons/rankd"->query_respect(v1) + "不瞒您说。师傅让我作『蛇胆膏』，\n可我", v1);
    switch (query_temp("dan")) {
    case 0:
        write("\e[1;33m差一只青蛇胆，一只金蛇胆。\n\e[2;37;0m");
        break;
    case 1:
        write("\e[1;33m还差一只金蛇胆。\n\e[2;37;0m");
        break;
    case 2:
        write("\e[1;33m还差一只青蛇胆。\n\e[2;37;0m");
        break;
    }
    return "不知哪位好心人能帮帮我呢？\n";
}

