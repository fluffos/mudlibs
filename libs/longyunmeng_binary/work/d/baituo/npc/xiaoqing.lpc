            message_vision("小青看到金蛇胆，高兴得跳了起来。\n\n\t\t\t    搂着$n的脖子说：还差青蛇胆就大功告成了！\n", arg1);
            return 1;
        }
    }
    if (arg2->query("name") == "青蛇胆") {
        if (query_temp("dan") == 1) {
            message_vision("小青一看是，满脸遗憾\n\t\t\t    地对$n说：我还差金蛇胆，不缺青蛇胆。\n", arg1);
            return 0;
        }
        add_temp("dan", 1);
        if (query_temp("dan") == 1) {
            message_vision("小青看到青蛇胆，高兴得跳了起来。\n\n                            搂着$N的脖子说：还差就金蛇胆大功告成了！\n", arg1);
            return 1;
        }
    }
    command("kiss " + arg1->query("id"));
    write("\e[1;33m只见小青手脚麻利地把两只蛇胆投入药罐中，又加入一些\n\n\t  不知是什么的药粉，然后把稀里哗啦一摇，嘿！『蛇胆膏』做\n\n\t  成了。\n\e[2;37;0m");
    message_vision("小青很神秘地凑近$N悄悄说了些什么。\n", arg1);
    tell_object(arg1, "我偷偷拿了一点『蛇胆膏』送给你，师傅不会发现的。\n");
    message_vision("小青深情地望了$N一眼，脸红了。\n", arg1);
    v1 = clone_object("/d/baituo/obj/shedangao");
    v1->move(arg1);
    set_temp("dan", 0);
    add_temp("times", -1);
