// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//shanzei1.c
inherit NPC;
void create()
{
	set_name("小山贼", ({ "xiao shanzei","xiao" }) );
	set("gender", "男性" );
	set("age", 12);
	set("long", "这是个尚未成年的小山贼。\n");
	set("attitude", "friendly");
	set("shen_type", -1);
	set("str", 15);
	set("int", 16);
	set("con", 15);
	set("dex", 16);
	set("max_qi", 200);
	set("max_jing", 200);
	set("neili", 80);
	set("max_neili", 80);
	set("combat_exp", 1000+random(500));
	set("score", 1000);
	setup();
	add_money("silver", 1);
}
