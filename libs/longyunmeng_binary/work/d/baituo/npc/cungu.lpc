// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// cungu.c
inherit NPC;
void create()
{
	set_name("村姑", ({ "cun gu","gu","cun" }) );
	set("gender", "女性" );
	set("age", 20);
	set("long", "一个很清秀的年轻农村姑娘，挎着一只盖着布小篮子。\n");
	set("shen_type", 1);
	set("combat_exp", 4000);
	set("str", 15);
	set("dex", 16);
	set("con", 15);
	set("int", 17);
	set("attitude", "friendly");
	setup();
	carry_object("/clone/misc/cloth")->wear();
        carry_object("/d/baituo/obj/caomei");
        carry_object("/d/baituo/obj/turou");
}
