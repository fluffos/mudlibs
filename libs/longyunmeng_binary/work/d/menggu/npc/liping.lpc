// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit NPC;
void create()
{
   set_name("李萍",({"li ping"}));
   set("gender","女性");
   set("long","郭靖的母亲,流落在蒙古!\n");
   set("score",5000);
   set("combat_exp",60000);
   
set("per",30);
set("age",43);
   set("kee",800);
   set("max_kee",800);
set("food",250);
set("water",250);
   set("force",300);
   set("max_force",300);
   set("force_factor",10);

   set_skill("dodge",20);
   set_skill("force",20);
   set_skill("parry",20);
   set_skill("unarmed",20);
   set_skill("whip",20);

   setup();
   add_money("silver",5);
carry_object(__DIR__"obj/cloth")->wear();
}
