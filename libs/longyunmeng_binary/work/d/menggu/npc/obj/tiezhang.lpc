// staff.c

#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
   set_name( "铁杖", ({ "tie zhang", "zhang", "staff" }) );
   set_weight(8000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "条");
     set("long", "一条沉重的铁杖。\n");
     set("value", 1000);
     set("no_sell",1);
     set("material", "steel");
   }

   init_staff(20);
   setup();
}
