// blade.c

#include <weapon.h>

inherit WHIP;

void create()
{
        set_name("皮鞭", ({"whip"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一条长长的皮鞭，上面沾满了血．\n");
                set("unit", "条");
                set("value", 500);
        }
        init_whip(10);
        setup();
}

