// yinqiang.c
// updated 5-30-97, pickle

#include <ansi.h>
#include <weapon.h>

inherit CLUB;

void create()
{
        set_name(HIW "亮银枪" NOR, ({"silver spear", "qiang", "spear"}));
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long","这是把沉重的长枪，枪尖是纯银打制，锋利无比．\n");
                set("value", 18000);
                set("wield_msg","$N拿出一把$n握在手中，眼前闪过一道寒光．\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_club(70);
        setup();
}

