// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit NPC;
void create()
{
   set_name("蒙古小孩",({"kid"}));
   set("age",9);
   set("combat_exp",200);
   set_skill("dodge",10);
   set_skill("unarmed",3);
   set("chat_chance",7);
   set("chat_msg",({
   (:random_move:),
   }));
   setup();
 carry_object(__DIR__"obj/cloth")->wear();
 add_money("coin",20);
}