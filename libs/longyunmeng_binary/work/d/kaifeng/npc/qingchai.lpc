void del_gaoed(mixed arg) {
    if (objectp(arg) && arg->query("gaoed")) {
        arg->delete("gaoed");
    }
}

int do_gao(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!v2->query_temp("gao_paid")) {
        return notify_fail("\e[1;33m再怎么也得交点手续费嘛！\n\e[2;37;0m");
    }
    if (!arg) {
        return notify_fail("<Syntax>: gao <player id>\n");
    }
    v1 = find_player(arg);
    if (!v1) {
        v1 = find_living(arg);
    }
    if (!v1) {
        return notify_fail("\e[1;35m找不到你要的疑犯！\n\e[2;37;0m");
    }
    v2->set("gaoed", 1);
    if (v2->query("pks") > random(10) || v2->query("combat_exp") < random(1000) || random(10) > 7) {
        call_out("dzj", 5, v2);
    } else {
        call_out("del_gaoed", 3000, v2);
        v2->delete_temp("gao_paid");
        tell_room(environment(v1), "一群衙役一拥而上，把" + v1->query("name") + "抓了起来, 然後绑走了.\n", v1);
        tell_object(v1, "一群衙役一拥而上，对你说：有人告你了，跟我们走一趟\n");
        v1->move(environment(v2));
        tell_object(v2, v1->query("name") + "被抓到了衙门.\n");
        tell_object(v1, "你发现是" + v2->query("name") + "告你的.\n");
        tell_room(environment(v1), v1->query("name") + "突然被抓" + "到衙门来了\n", ({ v2, v1 }));
        message_vision("\n$N看到$n站在大堂上暗笑不止,不由心火上升" + v2->query("name") + "咂们等着瞧!\n", v1, v2);
        if (random(10) < 7) {
            call_out("dzj2", 5, v1);
        } else {
            message_vision("\e[1;33m包龙星大声喝道: 这次算你走运，既然没有犯案，就快滚吧!\n\e[2;37;0m", v1);
        }
    }
    return 1;
}

