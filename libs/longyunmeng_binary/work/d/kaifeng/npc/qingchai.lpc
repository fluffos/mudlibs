void dzj(mixed arg) {
    mixed v1;
    message_vision("\e[1;33m两旁衙役高呼:威~~呜~~~!!\n\e[2;37;0m", arg);
    v1 = random(3);
    if (!v1) {
        remove_call_out("beating");
        call_out("beating", 3, arg);
        return;
    }
    call_out("dzj", v1--, arg);
}

