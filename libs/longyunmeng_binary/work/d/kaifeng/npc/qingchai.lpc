    message_vision("\e[1;31m突然$N不动了,一个衙役来到包龙星身边耳语了几句\n只听包龙星说:这次盏且放过你下次再犯决不轻饶,退堂!!\n\e[2;37;0m", arg);
    arg->move("/d/city/jianyu");
    arg->unconcious();
}

