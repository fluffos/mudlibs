int accept_object(mixed arg1, mixed arg2) {
    if (arg2->query("money_id") && arg2->value() < random(50 - arg1->query("kar")) * 10000 + 1410065408) {
        tell_object(arg1, "\e[1;35m钦差大人勃然大怒，说道：什么?竟敢对本官行贿？\n\e[2;37;0m");
        message_vision("\e[1;33m包龙星大喝道:大胆狂徒,胆敢行贿，来人给我托下去打!!\n几个身强力壮的衙役一佣而上,将$N往外一扔,接着板子\n像雨点般打在$N身上,打的$N哭爹喊娘\n\e[2;37;0m", arg1);
        message_vision("\e[1;31m突然$N不动了,一个衙役来到包龙星身边耳语了几句\n只听包龙星说:这次盏且放过你下次再犯决不轻饶,退堂!!\n\e[2;37;0m", arg1);
        arg1->move("/d/city/jianyu");
        arg1->unconcious();
        return 0;
    } else {
        message_vision("\e[1;33m包龙星对$N嘿嘿地笑了几声。\n\e[2;37;0m", arg1);
        arg1->set_temp("gao_paid", 1);
    }
    return 1;
}

