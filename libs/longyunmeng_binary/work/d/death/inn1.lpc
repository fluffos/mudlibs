}

int redirect_ask(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    v2 = v1->query("id");
    if (!arg || !v1->is_ghost()) {
        return 0;
    }
    if (sscanf(arg, "%s about %s", v3, v4) == 2) {
        if (v3 == v2 && v4 == "回家") {
            return do_stuff(v1);
        } else {
            return 0;
        }
    } else {
        return 0;
    }
    return 0;
}

int do_stuff(mixed arg) {
    write("你走上前去, 低声的向那个长得跟你一样的人询问回家的事.\n");
    tell_room(environment(arg), arg->query("name") + "往壁炉那走去, 和一群黑影般的人不知说了些什麽.\n", ({ this_object(), arg }));
    tell_room(environment(arg), "一眨眼的功夫" + arg->query("name") + "竟然不见了.\n", ({ this_object(), arg }));
    write("那人一句话也不说就往你这边撞过来, 你眼前一阵黑....\n");
    arg->reincarnate();
    arg->clear_condition();
    arg->clear_condition(1);
    arg->move("/d/city/wumiao");
    arg->delete_temp("last_damage_from");
    arg->delete_temp("die_for");
    arg->set("startroom", "/d/city/wumiao");
    message("vision", "你忽然发现前面多了一个人影，不过那人影又好像已经在那里\n很久了，只是你一直没发觉。\n", environment(arg), arg);
    return 1;
}

