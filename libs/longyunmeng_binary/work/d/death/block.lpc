// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
void create()
{
	set("short","空房间");
	set("long","你完了...\n");
	set("valid_startroom",1);
	set("no_fight",1);
	setup();
}
void init()
{
	if (!wizardp(this_player()))
	add_action("block_cmd","",1);
}
int block_cmd()
{
	return 1;
}
