// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//shigu.c
#include <weapon.h>

inherit HAMMER;

void create()
{
    set_name("尸骨", ({ "shi gu", "shi","gu" }) );
    set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        	set("unit", "只");
        	set("value", 50);
        	set("material", "wood");
        	set("long", "这是一只白森森的尸骨。\n");
        	set("wield_msg","$N手中握住一把$n，眼中露出阴邪的笑意。\n");
        	set("unwield_msg", "$N将$n插回腰间，脸色顿时也恢复了正常。\n");
	}
    	init_hammer(100);
	setup();
}
