// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//HSQCHANGLANG.C

inherit ROOM;

void create()
{
	set("short", "洪水旗长廊");
	set("long", @LONG
你正走在一条长廊之上, 长廊蜿蜒曲折, 两旁是如画景象. 
小河从廊下静静流淌, 河面之上飘浮着淡淡的轻烟, 如雾如纱.
但河面上又静得让人奇怪, 似乎没有一点生气.
LONG );
	set("exits", ([
		"north" : __DIR__"hsqdating",
		"out"   : __DIR__"hsqmen",
	]));
	set("outdoors", "mingjiao");
	set("no_clean_up", 0);
	setup();
}
