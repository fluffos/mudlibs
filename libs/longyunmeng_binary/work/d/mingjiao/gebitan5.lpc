// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//gebitan5.c

inherit ROOM;

void create()
{
        set("short", "戈壁滩");
	set("long", @LONG
眼前是一望无际的戈壁滩，没有路标，也没有一个行人，天
显得很高，远山披雪，苍鹰翱翔，走在这茫茫戈壁之上，你似乎
迷路了。
LONG );
 	set("exits",([
	    "east" : __DIR__"gebitan5",
	    "west" : __DIR__"shanjiao",	
	    "north" : __DIR__"gebitan5",
	    "south" : __DIR__"gebitan4",  				
	]));
	set("no_clean_up", 0);
	setup();
}
