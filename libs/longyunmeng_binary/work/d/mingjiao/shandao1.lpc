int do_hua(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        write("你要滑什么？\n");
        return 1;
    }
    if (v1->is_busy()) {
        return notify_fail("你上一个动作还没有完成！\n");
    }
