// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// jianlun.c

inherit ITEM;

void create()
{
        set_name("剑论", ({ "sword book" ,"book"}));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long",
                        "这是一卷明教前代弟子所著的书简，上面有一些模糊的图象，似乎\n"
                        "是画的一些击剑的小人形。\n");
                set("value", 5000);
                set("material", "paper");
                set("skill", ([
                        "name":               "sword",     
                       "exp_required":  100,                                                                                                          "jing_cost":   20,                             
                        "difficulty":   25,                                                                                                                "max_skill":   60,  ]));                                                                                
        }
}

int query_autoload() { return 1; }
