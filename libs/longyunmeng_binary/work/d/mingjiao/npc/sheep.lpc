// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// sheep.c

inherit NPC;

void create()
{
    set_name("野羊", ({ "sheep" }) );
    set("gender", "雄性");
    set("race", "野兽");
    set("age", 2);
    set("long",
        "这只野羊在低头吃草，见了人也不惊避。\n");
    set("combat_exp", 5000);
    set("shen_type", -1);
    set("attitude", "peaceful");
    set("limbs", ({ "羊角", "前蹄", "后蹄" }) );
    set("verbs", ({ "hoof" }) );

    set("water", 200);
    set("food", 200);

    set("apply/attack", 10);
    set("apply/defense", 10);

    setup();
}
