// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// biaotou.c 财主管家
inherit NPC;
void create()
{
	set_name("镖头", ({ "biao tou", "biao" }));
	set("gender", "男性");
	set("age", 35);
	set("combat_exp", 5000);
	set_skill("unarmed", 30);
	set_skill("blade", 40);
	set_skill("parry", 30);
	set_skill("dodge", 30);
	
	set_temp("apply/attack", 15);
	set_temp("apply/defense", 15);
	set_temp("apply/damage", 20);
	setup();
	carry_object(__DIR__"obj/gangdao")->wield();
	carry_object("/clone/misc/blk_cloth")->wear();
}
	
