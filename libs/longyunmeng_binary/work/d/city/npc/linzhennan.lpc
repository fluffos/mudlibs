int ask_fuwei() {
    say("林震南炫耀地说：我们林家三代走镖，一来仗着先祖远图公当年闯下的威名，二\n来靠著我们林家家传的玩艺儿不算含糊，这才有今日的局面，成为大江以南首屈\n一指的大镖局。江湖上提到『福威镖局』四字，谁都要翘起大拇指，说一声：『\n好福气！好威风！』哈哈，哈哈！\n");
    this_player()->set_temp("marks/林1", 1);
    return 1;
}

int ask_yuantu() {
    if (this_player()->query_temp("marks/林1")) {
        say("林震南磕一磕烟斗，说道：远图公是我的祖父，福威镖局是他一手创办的。当年\n祖父以七十二路辟邪剑法开创镖局，当真是打遍黑道无敌手。其时白道上英雄见\n他太过威风，也有去找他比试武艺的，青城派掌门余观主的师父长青子少年之时\n便在他辟邪剑法下输了几招。\n");
        this_player()->set_temp("marks/林2", 1);
        return 1;
    } else {
        say("林震南说道：远图公是我的祖父。\n");
        return 1;
    }
}

