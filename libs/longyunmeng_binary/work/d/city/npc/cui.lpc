// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// cui.c 崔员外
inherit NPC;
void create()
{
	set_name("崔员外", ({ "cui yuanwai", "cui" }));
	set("gender", "男性");
	set("age", 55);
	set("max_qi",500);
	set_skill("unarmed", 50);
	set_skill("dodge", 50);
	set_skill("parry", 50);
	set_temp("apply/attack", 40);
	set_temp("apply/defense", 40);
	set_temp("apply/damage", 10);
	set("combat_exp", 25000);
	set("shen_type", -1);
	setup();
	add_money("gold", 3);
	carry_object(__DIR__"obj/yaoshi");
	carry_object("/clone/misc/long_cloth")->wear();
}
	
