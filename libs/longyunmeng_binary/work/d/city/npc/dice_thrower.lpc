    }
    if (arg2 / 100000) {
        v1 = clone_object("/clone/money/thousand-cash");
        v1->set_amount(arg2 / 100000);
        if (!v1->move(arg1)) {
            v1->move(environment(arg1));
        }
        arg2 %= 100000;
