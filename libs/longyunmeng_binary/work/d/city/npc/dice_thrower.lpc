        v1->set_amount(arg2 / 100);
        if (!v1->move(arg1)) {
            v1->move(environment(arg1));
        }
        arg2 %= 100;
    }
    if (arg2) {
        v1 = clone_object("/clone/money/coin");
        v1->set_amount(arg2);
        if (!v1->move(arg1)) {
