// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// guigong.c
inherit NPC;

void create()
{
        set_name("龟公", ({ "gui gong", "gui", "gong" }));
        set("gender", "男性");
        set("age", 25);

        set("long", "一个满脸狠肉的汉子，在丽春院日子久了，养的白白肥肥。\n");
        set("combat_exp", 30000);
        set("shen_type", 2);
        set_skill("unarmed", 70);
        set_skill("dodge", 70);
        set("chat_msg", ({
             "小娘皮，来了这里就乖乖地侍侯大爷们吧。",
             "想跑？跑到天涯海角都给你追回来！",
             "哼！你们这些小贱人，活该！",
        }) );
        setup();
        carry_object(__DIR__"obj/cloth")->wear();
}
