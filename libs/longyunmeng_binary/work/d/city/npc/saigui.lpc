// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit NPC;

int random2 (int i)
{
  return (random(i)+uptime()) % i;
}

void create()
{
  set_name("赛龟", ({ "sai gui", "gui" }) );
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 2);
  set("long", "一只慢腾腾的赛龟。\n");
  set("attitude", "friendly");
  set("str", 20+random2(2));
  set("int", 20+random2(2));

  set("dex", 20);

  set("per", 20);
  set("limbs", ({ "头部", "爪子", "尾巴" }) );
  set("verbs", ({ "bite"}) );

  setup();
}

