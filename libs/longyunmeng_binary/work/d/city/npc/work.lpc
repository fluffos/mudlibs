void create() {
    set("short", "谷物加工厂");
    set("long", "这是一间谷物加工厂，这里是谷子脱壳成米的地方。米厂老板是一\n个一看就知道是十分精明的干瘦的中年人，老是带着一脸奸笑。你可以\n看到许多人正在忙忙碌碌的工作着，门口挂著一块牌子(sign)。\n");
    set("no_sleep_room", 1);
    set("exits", ([ "north" : "/d/city/npc/dongmen" ]));
    set("item_desc", ([ "sign" : "现在正紧缺人手，急需雇佣一批短工来干活。\nwork     开始工作。\n" ]));
    set("no_magic", 1);
    setup();
}

void init() {
    add_action("do_work", "work");
    if (!wizardp(this_player())) {
        add_action("discmds", ({ "duanlian", "ansuan", "touxi", "persuade", "teach", "exert", "exercise", "study", "learn", "sleep", "kill", "steal", "cast", "conjure", "expell", "fight", "hit", "perform", "prcatice", "scribe", "surrender" }));
    }
}

int discmds() {
    tell_object(this_player(), "还是老老实实工作吧？！\n");
    return 1;
}

int do_work(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    v1 = 300 / v2->query("str");
    if (v1 < 15) {
        v1 = 15;
    }
    if (v2->query("jing") < random(30) || v2->query("qi") < random(30)) {
        message_vision("$N开始辛苦地工作......\n", v2);
        write("你突然感到头晕眼花。。。。。。\n");
        tell_room(environment(v2), "\e[31m" + v2->name() + "脸色看起来不大对头，斗大的汗珠从脸上滑了下来。\n哎,又是一个要钱不要命的..!\n\e" + "[2;37;0m", ({ v2 }));
        v2->unconcious();
        return 1;
    }
    if (v2->query("jing") < 30 || v2->query("qi") < 30) {
        return notify_fail("你快累死了，要钱不要命了吗？\n");
    }
    if (v2->query_temp("working")) {
        return notify_fail("加油呀！谁叫你穷呀！\n");
    }
    if (cot > 2 || v2->query("combat_exp") > 3000000) {
        write("老板嘿嘿一笑：我这里人手已经够了，做义工可没工钱的哟！\n");
        v2->start_busy(5);
        return 1;
    }
    message_vision("$N开始辛苦地工作......\n", v2);
    cot++;
    v2->set_temp("working", 1);
    v2->add_temp("work_times", 1);
    call_out("working", random(v1) + 10, v2);
    return 1;
}

int working(mixed arg) {
    mixed v1;
    if (!arg) {
        return 1;
    }
    arg->add("jing", -30);
    arg->add("qi", -30);
    if (environment(arg)->query("short") != "谷物加工厂" || arg->query_temp("work_out")) {
        write("你工作的时候开小差，结果累了半天什么都没得到!\n");
        arg->set_temp("working", 0);
        arg->delete_temp("work_out");
        cot--;
        return 1;
    }
    if (random(arg->query_temp("work_times")) > random(100) + 60) {
        if (arg->query("kar") > 20) {
            message("vision", "\e[1;33m〖谷物加工厂〗\e[2;37;0m:\e[33m 由于\e[1;37m" + arg->name() + "\e" + "[2;37;0m\e" + "[33m工作勤劳，获得了老板的嘉奖!\n\e" + "[2;37;0m", users());
        } else {
            message_vision("老板对$N说：嗯，做的不错，这是给你的奖励！\n", arg);
        }
        v1 = clone_object("/clone/money/gold");
        v1->set_amount(1);
        v1->move(arg);
        arg->add("potential", 30);
        arg->delete_temp("work_times");
        arg->set_temp("working", 0);
        cot--;
        return 1;
    }
    message_vision("$N辛苦的工作终于结束了，可人也累的半死。\n", arg);
    v1 = clone_object("/clone/money/silver");
    v1->set_amount(random(20) + 10);
    arg->add("combat_exp", random(10));
    arg->add("potential", random(10));
    v1->move(arg);
    message_vision("老板冷冷地对$N说：这是你的工钱。\n", arg);
    arg->set_temp("working", 0);
    cot--;
    return 1;
}

int valid_leave(mixed arg1, mixed arg2) {
    if (arg2 == "north") {
        arg1->set_temp("work_out", 1);
    }
    return ::valid_leave(arg1, arg2);
}

void reset() {
    cot = 0;
    ::reset();
}
