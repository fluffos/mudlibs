}

string look_yanqing() {
    this_player()->start_more(read_file("/doc/poem/doc2"));
    return "\n";
}

int do_read(mixed arg) {
    if (arg == "" || file_size("/doc/poem/story/" + arg) <= 0) {
        return notify_fail("我们没有这本书。\n");
    }
    switch ("/adm/daemons/moneyd"->player_pay(this_player(), 100000)) {
    case 0:
        return notify_fail("穷光蛋，一边呆着去！\n");
    case 2:
        return notify_fail("您的零钱不够了，银票又没人找得开。\n");
    }
    log_file("LIBRARY", sprintf("%s read %s.\n", this_player()->query("name"), arg));
    this_player()->start_more(read_file("/doc/poem/story/" + arg));
    return 1;
}
