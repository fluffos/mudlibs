void create() {
    set("short", "性文学图书馆");
    set("long", "    这是一间极为隐蔽的图书收藏室。你可以用 read 来阅读一些书,look书架的名字可以看到书籍列表! 现在有2个书架:\n武侠类(wuxia) 言情类(yanqing)\n上的黄色小说。\n");
    set("item_desc", ([ "wuxia" : (: look_wuxia :), "yanqing" : (: look_yanqing :) ]));
