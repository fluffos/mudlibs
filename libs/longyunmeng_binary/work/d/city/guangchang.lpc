void init() {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("armor/cloth") && v1->query("race") == "人类") {
        if (time() - v1->query_temp("rumor/nocloth") > 10) {
            v1->set_temp("rumor/nocloth", time());
            call_out("do_rumor", random(5), v1);
        }
    }
    if (v1->is_ghost()) {
        write("\e[34m突然间阴风阵阵，你耳边响起一阵空洞而又阴森的声音:‘回来哟，回来哟!’\n\e[2;37;0m");
        write("\e[1;37m一阵白雾将你裹了起来，你又回到了鬼门关\n\e[2;37;0m");
        v1->move("/d/death/gate");
    }
    add_action("do_enter", "enter");
    add_action("do_climb", "climb");
}

int do_enter(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "shudong") {
        message("vision", v1->name() + "一弯腰往洞里走了进去。\n", environment(v1), ({ v1 }));
        v1->move("/d/gaibang/inhole");
        message("vision", v1->name() + "从洞里走了进来。\n", environment(v1), ({ v1 }));
        return 1;
    }
}

int do_climb(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = localtime(time());
    v1 = this_player();
    if (v2[6] == 6 && !environment(v1)->query("ok")) {
        return notify_fail("树干上布满了青苔,看样子是没法爬上的!\n");
    }
    if (!arg || arg != "up") {
        return notify_fail("你要往哪个方向爬？\n");
    }
    if (v1->query_condition("killer")) {
        message("vision", v1->name() + "战战兢兢地拉着大榕树的盘根，屁股一扭一扭地往上爬，突然一声惨叫，又掉了下来。\n", environment(v1), ({ v1 }));
        write("你战战兢兢地拉着大榕树的盘根往上爬，一不小心摔了个狗吃屎。\n");
        return 1;
    }
    if (v1->query("gender") != "女性") {
        message("vision", v1->name() + "战战兢兢地拉着大榕树的盘根，屁股一扭一扭地往上爬。\n", environment(v1), ({ v1 }));
    } else if (v1->query("age") < 40 && v1->query("per") > 24) {
        message("vision", v1->name() + "轻轻一跳，衣裙飘飘，象仙子般飞上大榕树。\n", environment(v1), ({ v1 }));
    } else {
        message("vision", v1->name() + "战战兢兢的抓住树干往上爬去。\n", environment(v1), ({ v1 }));
    }
    v1->move("/d/city/chatroom");
    if (v1->query("gender") != "女性") {
        message("vision", v1->name() + "气喘嘘嘘地爬了上来。\n", environment(v1), ({ v1 }));
    } else if (v1->query("age") < 40 && v1->query("per") > 24) {
        message("vision", "一阵清香飞来，你定眼一看，" + v1->name() + "已经婷婷玉立在你眼前。\n", environment(v1), ({ v1 }));
    } else {
        message("vision", v1->name() + "战战兢兢地从下面爬了上来。\n", environment(v1), ({ v1 }));
    }
    return 1;
}

