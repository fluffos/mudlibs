            message_vision("只见$N随手一扔，药居然刚好扔进药箱，好运气呀。\n", arg1);
            arg1->add("qi", -1);
            arg1->start_busy(1);
            break;
        case 1:
            message_vision("$N分的好仔细呀，还要检查一次。\n", arg1);
            arg1->add("qi", -3);
            arg1->start_busy(3);
            break;
        case 2:
            message_vision("$N看着手上的药材，想了半天终于还是没有找到该放的地方。\n", arg1);
            arg1->add("qi", -4);
