            message_vision("\e[1;33m哎呀，$N累的满头大汗，一不小心分错了药。\n\e[2;37;0m", arg1);
            arg1->add("qi", -5);
            arg1->start_busy(1);
            arg1->set_temp("fengyaow", 1);
            continue;
        }
        switch (random(3)) {
