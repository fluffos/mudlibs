int do_ban() {
    write("你干什么这是别人的内室呀，不要影响别人工作。\n");
    return 1;
}

int do_fengyao() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v1 = this_player();
    if (v1->query_temp("fengyaoover")) {
        return notify_fail("你的药已经分完了，快去找老板要报酬吧。\n");
    }
    if (v1->query_temp("fengyao")) {
        return notify_fail("你已经在工作了。\n");
    }
    if (!v1->query_temp("fengyaobegin")) {
        return notify_fail("你来做什么快走快走。\n");
    }
    message_vision("\n$N将袖子一缅，做出一副要大干一场的样子，唉，分个药也要这么样吗？\n\n", v1);
    v1->set_temp("fengyao", 1);
    v1->add("qi", -5);
    v1->delete_temp("fengyaobegin");
    call_out("del_fengyao", 1, v1, v5, v2, v3, v4);
    return 1;
}

