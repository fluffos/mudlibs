int qianbing(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    for (v1 = 0; v1 < sizeof(member); v1++) {
        if (member[v1]->query("name") == arg1->query("name")) {
            v2 = v1;
            for (v1 = v2 - 1; v1 != v2; v1--) {
                if (v1 < 0) {
                    v1 = sizeof(member) - 1;
                }
                switch (arg2) {
                case 1:
                    if (member[v1]->query_temp("bobing/g1")) {
                        member[v1]->add_temp("bobing/g1", -1);
                        arg1->add_temp("bobing/g1", 1);
                        message_vision("\e[1;33m$N搏到一秀一个，抢了$n一秀饼一块！\n\e[2;37;0m", arg1, member[v1]);
                        return 1;
                    }
                    break;
                case 2:
                    if (member[v1]->query_temp("bobing/g2") > 0) {
                        member[v1]->add_temp("bobing/g2", -1);
                        arg1->add_temp("bobing/g2", 1);
                        message_vision("\e[1;33m$N搏到二举一个，抢了$n二举饼一块！\n\e[2;37;0m", arg1, member[v1]);
                        return 1;
                    }
                    break;
                case 3:
                    if (member[v1]->query_temp("bobing/g3")) {
                        member[v1]->add_temp("bobing/g3", -1);
                        arg1->add_temp("bobing/g3", 1);
                        message_vision("\e[1;33m$N搏到四进一个，抢了$n四进饼一块！\n\e[2;37;0m", arg1, member[v1]);
                        return 1;
                    }
                    break;
                case 4:
                    if (member[v1]->query_temp("bobing/g4")) {
                        member[v1]->add_temp("bobing/g4", -1);
                        arg1->add_temp("bobing/g4", 1);
                        message_vision("\e[1;33m$N搏到三红一个，抢了$n三红饼一块！\n\e[2;37;0m", arg1, member[v1]);
                        return 1;
                    }
                    break;
                case 5:
                    if (member[v1]->query_temp("bobing/g5")) {
                        member[v1]->add_temp("bobing/g5", -1);
                        arg1->add_temp("bobing/g5", 1);
                        message_vision("\e[1;33m$N搏到对堂一个，抢了$n对堂饼一块！\n\e[2;37;0m", arg1, member[v1]);
                        return 1;
                    }
                    break;
                default:
                    message_vision("\e[1;33m$N搏到一块没有用的饼！\n\e[2;37;0m", arg1);
                    break;
                }
            }
            message_vision("\e[1;33m$N抢不到一块有用的饼！\n\e[2;37;0m", arg1);
            return 0;
        }
    }
    message_vision("\e[1;33m$N居然找不到自己座位！\n\e[2;37;0m", arg1);
    return 0;
}
