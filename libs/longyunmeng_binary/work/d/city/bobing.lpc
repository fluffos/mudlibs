                if (member[v1]->query("id") == arg) {
                    v3 = member[v1];
                }
            }
            if (v1 == sizeof(member)) {
                notify_fail("这个人不在这里搏饼\n");
            }
        } else {
            notify_fail("没人在这搏饼\n");
        }
    }
    v2 = query_member(v3);
    if (v2) {
        if (leader == v3) {
            if (v2 == sizeof(member)) {
                v2 = 1;
            } else {
                v2++;
            }
            leader = member[v2 - 1];
        }
    } else {
        return 1;
    }
    if (sizeof(member) > minperson) {
        message_vision("\e[1;32m$N离开了大家少了一个伙伴了！\n\e[2;37;0m", v3);
    } else {
        message_vision("\e[1;32m$N离开了大家玩不成了！\n\e[2;37;0m", v3);
    }
    Maxperson++;
    if (v3 == winner) {
        winner->set_temp("bobing/g6", 0);
        winner = v4;
    }
    delete_member(v3);
    return 1;
}

int fsit() {
    mixed v1;
    v1 = this_player();
    if (v1->query("mud_age") < 18000) {
        tell_object(v1, "\e[1;33m你年纪太小了，等不会是dummy吧？\n\e[2;37;0m");
        return 1;
    }
    if (!query_member(v1)) {
        if (Maxperson > 0) {
            message_vision("\e[1;36m$N坐下来和大家一起搏饼。\n\e[2;37;0m", v1);
            Maxperson--;
            add_member(v1);
            v1->set_temp("bobing/dest", "");
            v1->set_temp("bobing/g1", 0);
            v1->set_temp("bobing/g2", 0);
            v1->set_temp("bobing/g3", 0);
            v1->set_temp("bobing/g4", 0);
            v1->set_temp("bobing/g5", 0);
            v1->set_temp("bobing/g6", 0);
            v1->set_temp("bobing/maxscore", 0);
            v1->set_temp("bobing/maxaward", 0);
        } else {
            tell_object(v1, "\e[1;33m这一桌满了，你去别处看看吧。\n\e[2;37;0m");
        }
    }
    return 1;
}

int valid_leave(mixed arg1, mixed arg2) {
    if (query_member(arg1)) {
        return notify_fail("\e[1;34m你要先离开搏饼桌才能离开这里。\n\e[2;37;0m");
    }
    return 1;
}

int delete_member(mixed arg) {
    mixed v1;
    if (!pointerp(member)) {
        return 0;
    }
    for (v1 = 0; v1 < sizeof(member); v1++) {
        if (member[v1] == arg) {
            member -= ({ arg });
            Max1 += arg->query_temp("bobing/g1");
            Max2 += arg->query_temp("bobing/g2");
            Max3 += arg->query_temp("bobing/g3");
            Max4 += arg->query_temp("bobing/g4");
            Max5 += arg->query_temp("bobing/g5");
            Max6 += arg->query_temp("bobing/g6");
            arg->delete_temp("bobing");
            break;
        }
    }
}

int add_member(mixed arg) {
    if (!pointerp(member)) {
        member = ({ arg });
        leader = arg;
    } else {
        member += ({ arg });
        if (sizeof(member) >= minperson) {
            allow_start = 1;
            tell_room(environment(leader), "太好了，人凑够了，可以开始玩了。\n");
            tell_room(environment(leader), leader->query("name") + "先掷吧。\n");
        }
    }
    return 1;
}

int query_member(mixed arg) {
    mixed v1;
    if (!pointerp(member)) {
        return 0;
    }
    for (v1 = 0; v1 < sizeof(member); v1++) {
        if (member[v1] == arg) {
            return v1 + 1;
        }
    }
    return 0;
}

