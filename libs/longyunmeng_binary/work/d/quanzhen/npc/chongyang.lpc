    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg || !objectp(v2 = present(arg, environment(v1)))) {
        return;
    }
    if (arg == "zhang sanfeng" || arg == "zhang") {
        v2->kill_ob(v1);
    } else {
        v2->fight_ob(v1);
    }
    v1->fight_ob(v2);
}

int accept_fight(mixed arg) {
    mixed v1;
    v1 = this_object();
    v1->set("eff_qi", v1->query("max_qi"));
    v1->set("qi", v1->query("max_qi"));
    v1->set("jing", v1->query("max_jing"));
    v1->set("neili", v1->query("max_neili"));
    if (v1->is_fighting()) {
        return 0;
    }
    if (!present(arg, environment())) {
        return 0;
    }
    remove_call_out("checking");
    call_out("checking", 1, v1, arg);
    return 1;
}

int checking(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!present(arg2, environment())) {
        return 1;
    }
    v1 = arg1->query("max_qi");
    v2 = arg2->query("max_qi");
    if (arg1->is_fighting()) {
        if (arg1->query("qi") * 100 / v1 <= 80) {
            arg1->set("eff_qi", arg1->query("max_qi"));
            arg1->set("qi", arg1->query("max_qi"));
            arg1->set("jing", arg1->query("max_jing"));
            arg1->set("neili", arg1->query("max_neili"));
        }
        if (present(arg2, environment())) {
