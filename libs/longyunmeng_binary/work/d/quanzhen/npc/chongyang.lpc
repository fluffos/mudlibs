void attempt_apprentice(mixed arg) {
    if (arg->query("family/family_name") != "全真教" || arg->query("class") != "sworder") {
        command("say 我全真乃是道家门派。");
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "若想拜我派需先入我道。");
        return;
    }
    if (arg->query_skill("tiangang-zhengqi", 1) < 300) {
        command("say 我全真教乃内家武功，最重视内功心法。");
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "是否还应该在天罡正气上多下点功夫？");
        return;
    }
    if (arg->query("shen") < 100000) {
        command("say 学武之人，德义为先，功夫次之。");
        command("say 在德行方面，" + "/adm/daemons/rankd"->query_respect(arg) + "是否还做得不够？");
        return;
    }
    if (arg->query_int() < 60) {
        command("say 我全真教武功全从道中悟出。");
        command("say 要能达到炉火纯青之境，悟性低不得。");
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "的悟性还大有潜力可挖，还是请回吧。");
        return;
    }
    command("chat 好！好！！好！！！");
    command("chat 希望" + "/adm/daemons/rankd"->query_respect(arg) + "你能够学到我全真教的真髓！！");
    command("chat* pat " + arg->query("id"));
    command("recruit " + arg->query("id"));
    arg->set("title", "\e[1;36m全真教重阳真人传人\e[2;37;0m");
}

