// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
//daguandao.c  大官道
inherit  ROOM;

void  create  ()
{
        set("short",  "大官道");
        set("long",  @LONG
这是一条宽阔笔直的官道，足可容得下十马并驰。往东通向函谷关，
往西北则直达长安城，西面则是去终南山的必经之路武功镇。
LONG);
        set("exits",  ([  /*  sizeof()  ==  2  */
                "east"      :  __DIR__"daguandao2",
                "west"      :  "/d/wugongzhen/guandao1",
        ]));
        set("outdoors",  1);
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

