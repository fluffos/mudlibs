// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// fu-houyuan.c 后院
// By csy 1999.03

inherit ROOM;

void create()
{
        set("short", "后院");
        set("long", @LONG
这里是后院。走到这里，花香味更加浓烈了。你仔细一看，东南
边有一道圆形门，似乎花香是从那里传出来的。从这里再往南走，就
是侯员外的卧室了。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "southeast" : __DIR__"houhuayuan",
                "north" : __DIR__"fu-datang",
                "south" : __DIR__"fu-woshi",
        ]));
        set("no_clean_up", 0);
        setup();
}

