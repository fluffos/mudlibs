// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

inherit ROOM;
string look_writing();
void create()
{
    set("short", "走廊");
    set("long", @LONG
这是一条走廊。房顶一侧支在西面的高墙上，另一侧则与东
侧的清和殿屋顶相连。彩梁画栋，连顶棚也用彩漆绘满了各种飞
天的图形，每幅精美的雕画似乎都在诉说一个娓娓动人的故事。
往西通往后院，南北都有房间。
LONG
    );
    set("exits", ([
        "west" : __DIR__"houyuan",
        "east" : __DIR__"qihedian",
        "north" : __DIR__"fang1",
        "south" : __DIR__"fang2",
    ]));
    setup();
}
