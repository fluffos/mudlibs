void create() {
    set("short", "刘府大门");
    set("long", "这里是刘府大门。刘府的主人，就是衡山派中的仅次于掌门人莫大\n先生的第二号人物刘正风刘老爷子。今天兴许刘府有事吧，大门(gate)\n紧闭，管家家丁也异样紧张。只有檐下的写着 \"刘府\" 二字的大红灯笼\n中的烛火忽闪晃动才显出点活人气。\n");
    set("exits", ([ "south" : "/d/henshan/hengyang1" ]));
    set("item_desc", ([ "gate" : "朱红的大门紧闭着，敲敲(knock)看吧。\n" ]));
    set("objects", ([ "/d/henshan/npc/xiang" : 1, "/d/henshan/npc/mi" : 1 ]));
    setup();
}

void init() {
    add_action("do_knock", "knock");
    add_action("do_push", "push");
    add_action("do_push", "open");
}

int do_knock(mixed arg) {
    mixed v1;
    v1 = this_player();
    message_vision("$N“咚，咚，咚，。。。”地敲着门，可里面却一点动静都没有。\n", v1);
    v1->set_temp("marks/liufu", 1);
    return 1;
}

int do_push(mixed arg) {
    mixed v3;
    v3 = this_player();
    if (!v3->query_temp("marks")) {
        return notify_fail("门关得牢牢的，急切打不开！\n");
    }
    if (!arg || arg != "gate") {
        return notify_fail("这是干嘛？\n");
    }
    message_vision("\e[1;33m$N走到门前，把门随便一推，居然就推开了大门！\n\e[2;37;0m", v3);
    set("exits/enter", "/d/henshan/liufudayuan");
    remove_call_out("close");
    call_out("close", 5, this_object());
    return 1;
}

void close_out() {
    if (query("exits/enter")) {
        delete("exits/enter");
    }
}

void close(mixed arg) {
    message("vision", "一阵咿咿呀呀门响，里面有人把大门给关上了。\n", arg);
    arg->delete("exits/enter");
}
