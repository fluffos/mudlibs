// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// /d/xiakedao/road3.c 侠客岛 山路3

inherit ROOM;
void create()
{
        set("short", "山路");
        set("long", @LONG
这是通往山顶的小路，路旁杂草丛生，夹杂着一些不知名的野
花。四周静悄悄地没有人声。你深深吸口气，一阵山野的芬芳直入
心扉。
LONG );
        set("outdoors", "xiakedao");
        set("exits", ([
                "northdown" : __DIR__"road2",
                "southup" : __DIR__"road4",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
