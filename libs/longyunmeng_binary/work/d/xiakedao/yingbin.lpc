// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// yingbin.c 迎宾馆

inherit ROOM;

void create()
{
        set("short", "迎宾馆");
        set("long", @LONG
这是一个石洞，地下的青石板铺得甚是整齐，两旁有一些木制家
具，整个房间并无特殊之处，但收拾得干干净净，一尘不染。东面是
一个小吃部，西面是休息室。
LONG );
        set("exits", ([
               "east" : __DIR__"xiaodian",
               "west" : __DIR__"xiuxis",
               "south" : __DIR__"shidong2",
               "out" : __DIR__"dongmen",
        ]));
        set("no_clean_up", 0);
        setup();
}
