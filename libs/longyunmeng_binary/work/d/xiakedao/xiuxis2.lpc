inherit ROOM;

void create()
{
        set("short", "休息室");
        set("long", @LONG
这是一间石洞，洞内中间摆着几张大床，几张桌子，看来是
个休息的地方，室中光线柔和，使人更增睡意。
LONG );
        set("exits", ([
                "south" : __DIR__"neiting",
        ]));
        set("no_fight",1);
        set("no_steal",1);
        set("no_clean_up", 0);
        set("sleep_room",1);
        setup();
}
