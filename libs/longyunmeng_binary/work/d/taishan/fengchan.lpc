void create() {
    set("short", "封禅台");
    set("long", "如今这里是推选天下武林总盟主之处，各路英雄如能技压群雄，\n比武夺魁，便能问鼎盟主宝座，成为统领中原武林的领袖。高台上\n摆放着汉白玉宝座，盟主便在此坐堂议事。台上高高立着一竿旗，\n上书：替天行道 四个大字。 盟主左右各侍立着两位白衣武士，两\n边都放着一长排虎皮交椅，时常有武林前辈高手前来参见盟主。\n");
    set("valid_startroom", 1);
    set("exits", ([ "down" : "/d/taishan/fengchan-new", "east" : "/d/taishan/xiayi", "west" : "/d/taishan/zhengqi" ]));
    set("objects", ([ "/d/taishan/npc/meng-zhu" : 1, "/d/taishan/obj/bingqipu" : 1, "/d/taishan/npc/wei-shi1" : 2 ]));
    set("no_clean_up", 1);
    set("outdoors", "taishan");
    setup();
    set("item_desc", ([ "宝座" : "你看着看着忽然发现宝座后面有些异样,也许里面藏着什么秘密,不过盟主坐在上面,谁敢乱动啊...,听说盟主特别喜欢脏的东西,也许送他堆屎他一高兴就让你当盟主了,不过你敢吗?\n" ]));
    setup();
}

void init() {
    add_action("do_lashi", "lashi");
}

int do_lashi(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!arg || arg != "盟主") {
        write("不要随地大小便！\n");
        return 1;
    }
    message_vision("$N颤颤的爬到武林盟主头上拉了一堆臭不可闻的屎。\n", this_player());
    if (v2->query("family/family_name") == "飞天楼" && v2->query("family/master_id") == "flypp") {
        v2->move("/d/flypproom/fightroom87");
        return 1;
    }
    v1 = v2->query("neili");
    if (v1 >= 500000) {
        message_vision("突然武林盟主身体抖了几下(好象感觉挺爽),懒洋洋的倒了下去,身后出现了一排天梯！\n", this_player());
        set("exits/up", "/d/flypproom/fightroom87");
        this_player()->set("neili", v1 - 2000);
        remove_call_out("close");
        call_out("close", 3, this_object());
    } else {
        message_vision("武林盟主说道:竟敢在老子头上拉屎,你活的不耐烦了??\n", this_player());
        this_player()->set("neili", 0);
        this_player()->unconcious();
    }
    return 1;
}

void close(mixed arg) {
    message("vision", "武林盟主一觉睡醒,伸了伸懒腰,一切又恢复正常。\n", arg);
    arg->delete("exits/up");
}

int valid_leave(mixed arg1, mixed arg2) {
    if (arg2 == "up") {
        arg1->command("drop all");
    }
    return ::valid_leave(arg1, arg2);
}
