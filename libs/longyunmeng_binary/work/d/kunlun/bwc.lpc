    set("exits/west", "/d/kunlun/xis");
    arg->set("exits/east", "/d/kunlun/bwc.lpc");
    message("vision", "外面突然响起粗重的脚步声，由远而近，到门前停了下来．．．\n西华子啪地把门打开，伸个头进来，一脸狐疑：呆大半天了还不出去，搞什么鬼？\n", arg);
    v1 = all_inventory(arg);
