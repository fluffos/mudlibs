// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit NPC;
void create()
{
    set_name("小沙弥", ({ "xiao shami","shami"}) );
    set("gender", "男性" );
    set("class", "bonze");
    set("age", 15);
    set("str", 20);
    set("int", 20);
    set("con", 20);
    set("dex", 20);
    set("qi", 500);
    set("max_qi", 500);
    set("jing", 100);
    set("max_jing", 100);
    set("neili", 100);
    set("max_neili", 100);
    set("jiali", 10);
    set("combat_exp", 8000);
    set("score", 1000);
    set_skill("force", 50);
    set_skill("dodge", 50);
    set_skill("parry", 50);
    set_skill("buddhism", 100);
    set_skill("literate", 50);
    
    setup();
    carry_object(__DIR__"obj/c-jiasha")->wear();
}
