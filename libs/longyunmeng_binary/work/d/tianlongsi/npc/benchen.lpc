// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit NPC;
void create()
{
    set_name("本尘", ({ "ben chen","chen"}) );
    set("gender", "男性" );
    set("class", "bonze");
    set("age", 70);
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
    set("qi", 3500);
    set("max_qi", 3500);
    set("jing", 1500);
    set("max_jing", 1500);
    set("neili", 3000);
    set("max_neili", 3000);
    set("jiali", 150);
    set("combat_exp", 800000);
    set_skill("force", 120);
    set_skill("yiyang-zhi", 120);
    set_skill("dodge", 180);
    set_skill("parry", 120);
    set_skill("unarmed", 185);
    set_skill("kumu-shengong", 180);
    set_skill("buddhism", 120);
    set_skill("literate", 120);
    map_skill("force", "kumu-shengong");
    map_skill("unarmed", "yiyang-zhi");
    
    setup();
    carry_object(__DIR__"obj/y-jiasha")->wear();
}
