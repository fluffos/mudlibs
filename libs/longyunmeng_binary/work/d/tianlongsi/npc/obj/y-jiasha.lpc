#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create()
{
        set_name(HIY"黄色袈裟"NOR,({"jiasha","jia sha","cloth"}));
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("armor_prop/armor", 20);
                set("value",100);
        }
        setup();
}
int query_autoload() { return 1; }