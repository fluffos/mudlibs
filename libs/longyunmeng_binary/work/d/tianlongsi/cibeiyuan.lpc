// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
void create()
{
        set("short", "慈悲院");
        set("long",@LONG
这是僧人们点化顽徒的地方。不少江湖豪客由于厌倦了打打杀杀
的日子，来到此处落发为僧，叛依佛门。墙上一幅佛祖神像，两边各
有一条幅，上书：放下屠刀，立地成佛。
LONG
        );
        set("exits", ([
                "east" : __DIR__"wuwujing",
        "south" : __DIR__"sanwugong",
    ]));
        setup();
}
