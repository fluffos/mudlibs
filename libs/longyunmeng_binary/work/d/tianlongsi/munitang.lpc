// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
void create()
{
        set("short", "牟尼堂");
        set("long",@LONG
这是高僧们的静修之处。整堂全以松木制成，板门木柱，木料均不去
皮，天然质朴，和一路行来金碧辉煌的殿堂截然不同。室中五个和尚分坐
五个蒲团。四僧朝外，东首一个和尚面朝里壁一动不动。
LONG
        );
        set("exits", ([
        "north": __DIR__"banruotai",
    ]));
    set("objects",([
                __DIR__"npc/benchen" : 1,
        __DIR__"npc/kurong" : 1,
        __DIR__"npc/benguan" : 1,
        __DIR__"npc/benxiang" : 1,
        __DIR__"npc/bencan" : 1,
        ]));
        setup();
        replace_program(ROOM);
}
