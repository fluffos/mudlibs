// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
void create()
{
        set("short", "无乐阁");
        set("long",@LONG
这是历代大理王侯前来进香还愿时休息的地方。阁内檀象宝炉，软榻
矮几，一应俱全，清静之中隐然透出一丝富贵之象。
LONG
        );
        set("exits", ([
        "north": __DIR__"ruihemen",             
            "east" : __DIR__"huangtianmen",
    ]));
    set("objects",([
                __DIR__"npc/xiaoshami" : 2,
        ]));
        setup();
        replace_program(ROOM);
}
