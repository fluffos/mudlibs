// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;
void create()
{
        set("short", "三无宫");
        set("long",@LONG
这里可以买香到后面参拜西方大士。几个进香客正围着一个老年僧
人讨价还价。
LONG
        );
        set("exits", ([
                "southeast" : __DIR__"doushuai",
        "north" : __DIR__"cibeiyuan",
    ]));
    set("objects",([
                "/d/wudang/npc/guest" : 4,
        __DIR__"npc/laoniansengren" : 1,
        ]));
        setup();
        replace_program(ROOM);
}
