string ask_me() {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (v2->query("shen") < 0) {
        v2->set_leader(v1);
        call_out("do_kill", 1, this_player());
    } else if (v2->query("shen") < 30000000) {
        return "以你目前的作为是不能拿这把刀的。\n";
    } else if (v2->query("shen") > 30000000) {
        if (query("baodao_count") > 0) {
            call_out("waiting", 0, v2, v1);
            add("baodao_count", -1);
            v1 = clone_object("/d/guanwai/npc/obj/cwbdao");
            v1->move(v2);
            command("rumor " + v2->query("name") + "拿到闯王军刀啦。\n");
            return " 好吧，这把闯王宝刀就赠与你，希望你好好利用它。\n";
        } else {
            return "你来晚了，现在这把刀已不在此处。\n";
        }
    }
}

void do_kill(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_object();
    v2 = environment(v1);
    if (v2->query("no_fight")) {
        v2->set("no_fight", 0);
    }
    if (interactive(arg)) {
        command("say 你这恶贼竟敢打我宝刀的主意，给我纳命来！\n");
        v1->set_leader(arg);
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, arg);
    }
}

int accept_object(mixed arg1, mixed arg2) {
    if (!arg1 || environment(arg1) != environment()) {
        return 0;
    }
    if (!objectp(arg2)) {
        return 0;
    }
    if (!present(arg2, arg1)) {
        return notify_fail("你没有这件东西。");
    }
    if (arg2->query("id") == "yan ji") {
        write("\e[1;36m\n胡斐说道：这位" + "/adm/daemons/rankd"->query_respect(arg1) + "，如此大恩大德，在下实不知何以为报。\n");
        write("\e[1;36m\n胡斐大喜道：狗贼！想不到你也有今天！！手起刀落，将阎基剁为两段。\n");
        arg2->die();
        arg1->set_temp("marks/hujiadaopu", 1);
    }
    return 1;
}

string ask_book() {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!v2->query_temp("marks/hujiadaopu", 1)) {
        return "你说什么? \n";
    }
    if (v2->query("shen") < 5000000) {
        return "刀谱落入宵小之手，难免是阎基第二。\n";
    } else if (v2->query("shen") > 5000000) {
        if (query("book_count") > 0) {
            write("\e[1;36m胡斐说着转身从阎基尸身上搜出一本破旧书本，递了给你。\n");
            call_out("waiting", 0, v2, v1);
            add("book_count", -1);
            v1 = clone_object("/clone/book/blade_book");
            v1->move(this_player());
            message("channel:chat", "\e[1;33m【镜花水月】\e[1;35m" + v2->query("name") + "拿到胡家刀谱啦。\n\e" + "[2;37;0m", users());
            return "这本刀谱被这狗贼霸占多时了，现在就赠与你吧。\n";
        } else {
            return "你来晚了，现在刀谱已不在此处。\n";
        }
    }
