// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// erhu.c

inherit NPC;

void create()
{
	set_name("忽伦二虎", ({ "er hu" }));
	set("gender", "男性");
	set("nickname", "巨人");
	set("age", 19);
	set("long", "他是一个满洲巨人，手脚粗大，善于相扑，却生性纯朴。\n");
	
	set("combat_exp", 100000);
	set("shen_type", 0);

	set("attitude", "peaceful");
	
	set_skill("unarmed", 90);
	set_skill("dodge", 90);
	set_temp("apply/attack", 100);
	set_temp("apply/defense", 100);

	setup();
	carry_object("/clone/misc/cloth")->wear();
	add_money("silver",2);
}
