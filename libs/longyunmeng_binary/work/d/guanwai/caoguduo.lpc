// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// /guanwai/caoguduo.c

inherit ROOM;

void create()
{
	set("short", "谷草垛");
	set("long", @LONG
经过一番艰苦的跋涉，你的眼前出现了一片低矮的丘陵。远远看去象秋
收后堆成的谷草垛，密密麻麻，数不清有多少个。翻过这片丘陵再向东行，
就可进入长白大山了。东面的天边有一缕炊烟，看来似乎有人。
LONG );
	set("exits", ([
		"northwest" : __DIR__"mantianxing",
		"east"      : __DIR__"baihe",
	]));
	set("no_clean_up", 0);
	set("outdoors", "guanwai");
	setup();
}
