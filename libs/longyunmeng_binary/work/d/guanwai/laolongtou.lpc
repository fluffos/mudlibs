// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// /guanwai/laolongtou.c
inherit ROOM;

void create()
{
	set("short", "老龙头");
	set("long", @LONG
老龙头是万里长城最东端。澄海楼巍峨高踞城头，楼上“雄襟万里”的
横匾居高临下，直俯大海。自澄海楼筑有一石城逐级而下伸入大海，站在石
城终端楼平台上四眺，海天一色，无边无际，气象万千。
LONG );
	set("exits", ([
		"northwest" : __DIR__"shanhaiguan",
		"southwest" : "/d/city2/road3",
	]));
	set("objects",([
		__DIR__"npc/fengxifan" : 1,
	]));
//	set("no_clean_up", 0);
 	set("outdoors", "guanwai");
	setup();
	replace_program(ROOM);
}

