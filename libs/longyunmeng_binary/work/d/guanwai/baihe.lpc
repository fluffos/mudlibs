// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// /guanwai/baihe.c

inherit ROOM;

void create()
{
	set("short", "白河");
	set("long", @LONG
这里是长白山下的一个小村，只有四，五间粗陋的小木屋。这里并没有
固定的居民，木屋都是进山采参的参客所盖，为的是在进山前能在这里好好
的休息一下。东面就是巍峨耸立的长白大山。
LONG );
	set("exits", ([
		"west"  : __DIR__"caoguduo",
		"east"  : __DIR__"milin1",
		"north" : __DIR__"xiaowu",
	]));
	set("no_clean_up", 0);
	set("outdoors", "guanwai");
	setup();
}
