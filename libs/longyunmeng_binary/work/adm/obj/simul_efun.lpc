        return v2;
    } else {
        return 0;
    }
}

float min_max_attnum(mixed arg1, mixed arg2, mixed arg3, mixed arg4) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    v6 = arg1 + arg2 + arg3 + arg4;
