}

void shout(mixed arg) {
    efun::message("shout", arg, users(), this_player() || ({ }));
}

void write(mixed arg) {
    if (this_player()) {
        efun::message("write", arg, this_player());
    } else if (previous_object()) {
        efun::message("write", arg, previous_object());
    } else {
        efun::write(arg);
    }
}

varargs void say(mixed arg1, mixed arg2) {
    if (living(previous_object())) {
        efun::message("say", arg1, environment(previous_object()), previous_object());
    } else if (this_player()) {
        efun::message("say", arg1, environment(this_player()), this_player());
    }
}

int notify_fail(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1 && efun::userp(v1)) {
        if (stringp(arg)) {
            if (v1->query_temp("big5")) {
                arg = "/adm/daemons/languaged"->toBig5(arg);
            }
        }
    }
    return efun::notify_fail(arg);
}

varargs void printf(mixed arg1, mixed arg2, mixed arg3, mixed arg4, mixed arg5, mixed arg6, mixed arg7, mixed arg8, mixed arg9, mixed arg10, mixed arg11, mixed arg12, mixed arg13, mixed arg14, mixed arg15, mixed arg16, mixed arg17) {
