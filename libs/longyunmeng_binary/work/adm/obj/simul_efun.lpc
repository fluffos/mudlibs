int is_chinese(mixed arg) {
    // UTF-8 strings index by character: a CJK ideograph, not a GBK lead byte (KB 07 8.1)
    if (sizeof(arg) >= 1 && arg[0] >= 0x4e00 && arg[0] <= 0x9fff) {
        return 1;
    }
    return 0;
}

string gender_self(mixed arg) {
    switch (arg) {
    case "女性":
        return "你";
        break;
    default:
        return "你";
    }
}

string gender_pronoun(mixed arg) {
    switch (arg) {
    case "中性神":
        return "他";
        break;
    case "男性":
        return "他";
        break;
    case "无性":
        return "他";
        break;
    case "女性":
        return "她";
        break;
    case "雌性":
    case "雄性":
        return "它";
        break;
    default:
        return "它";
    }
}

