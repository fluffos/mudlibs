varargs void message(mixed arg1, mixed arg2, mixed arg3, mixed arg4) {
    // FluffOS takes an object or an array as the exclude list, not 0
    efun::message(arg1, arg2, arg3, arg4 || ({ }));
}

void cat(mixed arg) {
    if (file_size(arg) > 8192) {
        write("\n文件太长，请用more指令！\n\n");
    } else {
        write(read_file(arg) || "");
    }
}

void log_file(mixed arg1, mixed arg2) {
    // write_file() into a directory that is not there throws (KB 05 §7.44)
    assure_file("/log/" + arg1);
    write_file("/log/" + arg1, arg2);
}

void assure_file(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (file_size(arg) != -1) {
        return;
    }
    seteuid("Root");
    v2 = explode(arg, "/");
    v2 = v2[0..sizeof(v2) - 2];
    v1 = "/";
    for (v3 = 0; v3 < sizeof(v2); v3++) {
        v1 += v2[v3];
        mkdir(v1);
        v1 += "/";
    }
}

string base_name(mixed arg) {
    mixed v1;
    if (sscanf(file_name(arg), "%s#%*d", v1) == 2) {
        return replace_string(v1, "\\", "/");
    } else {
        return replace_string(file_name(arg), "\\", "/");
    }
}

varargs void auto_save_item(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v2 = "";
    v4 = all_inventory(arg1);
    if (!arg1->query("id")) {
        return;
    }
    if (!environment(arg1)) {
        return;
    }
    if (base_name(arg1) != "/clone/user/user") {
        return;
    }
    v1 = "/data/item/" + arg1->query("id") + "/";
    if (file_size(v1) != -2) {
        mkdir("/data/item/" + arg1->query("id"));
    }
    v3 = get_dir(v1, -1);
    if (sizeof(v3)) {
        for (v5 = 0; v5 < sizeof(v3); v5++) {
            if (file_size(v1 + v3[v5][0]) != -1) {
                rm(v1 + v3[v5][0]);
            }
        }
    }
    if (sizeof(v4) < 1) {
        rmdir("/data/item/" + arg1->query("id"));
        return;
    }
    for (v5 = 0; v5 < sizeof(v4); v5++) {
        if (v4[v5]->query("xyzx_ylfy_buy_sell")) {
            continue;
        }
        if (v4[v5]->query("xyzx_save_item") && v4[v5]->query("owner_id")) {
            v2 += base_name(v4[v5]) + ":" + v5 + "\n";
            if (v4[v5]->query("equipped")) {
                v4[v5]->set_temp("save_temp_remove", 1);
                if (!v4[v5]->unequip()) {
                    log_file("destruct", sprintf("Failed to unequip %s when destructed.\n", file_name(v4[v5])));
                }
            }
            v4[v5]->save(v1 + v5);
            if (arg2 && v4[v5]->query_temp("save_temp_remove")) {
                v4[v5]->delete_temp("save_temp_remove");
                if (v4[v5]->query("weapon_prop")) {
                    v4[v5]->wield();
                    continue;
                }
                if (v4[v5]->query("armor_prop")) {
                    v4[v5]->wear();
                }
            }
        }
    }
    if (v2 != "") {
        write_file(v1 + "物品", v2, 1);
    } else {
        rmdir("/data/item/" + arg1->query("id"));
    }
    return;
}

void auto_restore_item(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    v1 = "/data/item/" + arg->query("id") + "/";
    if (file_size(v1) != -2) {
        return;
    }
    if (file_size(v1 + "物品") == -1) {
        return;
    }
    v5 = get_dir(v1, -1);
    if (sizeof(v5) < 2) {
        return;
    }
    v2 = read_file(v1 + "物品");
    v3 = explode(v2, "\n");
    for (v7 = 0; v7 < sizeof(v3); v7++) {
        if (strsrch(v3[v7], ":") != -1) {
            v4 = explode(v3[v7], ":");
            if (sscanf(v4[0], "/d/npc/m_weapon/%*s")) {
                arg->set_temp("my_make_item", 1);
            }
            v6 = clone_object(v4[0]);
            v6->restore(v1 + v4[1]);
            v6->set_name(v6->query("name"), ({ v6->query("id") }));
            actions = "/adm/daemons/weapond"->query_action_xyzx(v6);
            v6->set("actions", actions);
            v6->move(arg);
        }
    }
    return;
}

object find_player(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (v1 = efun::find_player(arg)) {
        return v1;
    }
    v2 = children("/clone/user/user");
    for (v3 = 0; v3 < sizeof(v2); v3++) {
        if (v2[v3]->query("id") == arg) {
            if (environment(v2[v3])) {
                v1 = v2[v3];
                return v1;
            }
        }
    }
    return 0;
}

int userp(mixed arg) {
    if (efun::userp(arg)) {
        return 1;
    }
    if (base_name(arg) == "/clone/user/user") {
        if (environment(arg)) {
            return 1;
        }
    }
    return 0;
}

int query_ip_port(mixed arg) {
    mixed v1;
    if (v1 = efun::query_ip_port(arg)) {
        return v1;
    }
    if (userp(arg)) {
        return 2003;
    }
}

object *get_all_user() {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = users();
    v2 = children("/clone/user/user");
    for (v3 = 0; v3 < sizeof(v2); v3++) {
        if (!interactive(v2[v3]) && clonep(v2[v3])) {
            v1 += ({ v2[v3] });
        }
    }
    return v1;
}

varargs object snoop(mixed arg1, mixed arg2) {
    if (!arg2) {
        return efun::snoop(arg1);
    }
    if (!wizardp(arg1)) {
        return 0;
    }
    log_file("snoop", arg1->name() + " snoops " + arg2->name() + " at " + ctime(time()));
    return efun::snoop(arg1, arg2);
}

void shutdown(mixed arg) {
    if (base_name(previous_object()) != "/adm/daemons/natured" && base_name(previous_object()) != "/adm/daemons/automap") {
        return;
    } else {
        efun::shutdown(arg);
    }
}

void destruct(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    if (arg) {
        if (previous_object()) {
            v1 = catch {
    arg->remove(geteuid(previous_object()));
};
        } else {
            v1 = catch {
    arg->remove(0);
};
        }
        if (v1) {
            if (userp(arg) && geteuid(previous_object()) != "Root") {
                return;
            }
        }
        if (base_name(arg) == "/adm/obj/master") {
            return;
        }
        if (clonep(arg) && objectp(environment(arg))) {
            v2 = environment(arg);
            if (v2) {
                if (interactive(v2)) {
                    if (!v2->query("xieyi/zmud")) {
                        tell_object(v2, "\031lbrem1 " + "/adm/daemons/rankd"->new_short(arg) + ";" + "\032");
                    }
                } else if (!v2->is_character()) {
                    v3 = all_inventory(v2);
                    for (v4 = 0; v4 < sizeof(v3); v4++) {
                        if (v3[v4] == arg) {
                            continue;
                        }
                        if (environment(v3[v4]) == v2) {
                            if (!v3[v4]->query("xieyi/zmud")) {
                                if (interactive(v3[v4])) {
                                    tell_object(v3[v4], "\031lbrem0 " + "/adm/daemons/rankd"->new_short(arg) + ";" + "\032");
                                }
                            }
                        }
                    }
                }
            }
        }
        if (userp(arg)) {
            v3 = users();
            for (v4 = 0; v4 < sizeof(v3); v4++) {
                if (!v3[v4]->query("xieyi/zmud")) {
                    tell_object(v3[v4], "\031lbrem2 " + "/adm/daemons/rankd"->new_short(arg) + ";" + "\032");
                }
            }
            // a login object whose registration was abandoned holds just the
            // id: saving it would leave an account without a password behind
            if (base_name(arg) != "/clone/user/login" || arg->query("password")) {
                arg->save();
            }
            auto_save_item(arg);
        }
        efun::destruct(arg);
    }
}
