int sort_user(mixed arg1, mixed arg2) {
    if (wizardp(arg1) && !wizardp(arg2)) {
        return -1;
    }
    if (wizardp(arg2) && !wizardp(arg1)) {
        return 1;
    }
    if (wizardp(arg1) && wizardp(arg2)) {
        return "/adm/daemons/securityd"->get_wiz_level(arg2) - "/adm/daemons/securityd"->get_wiz_level(arg1);
    }
    if (arg1->query("id") && !arg2->query("id")) {
        return -1;
    }
    if (arg2->query("id") && !arg1->query("id")) {
        return 1;
    }
    if (!arg1->query("id") && !arg2->query("id")) {
        return arg2->query("combat_exp") - arg1->query("combat_exp");
    }
    return strcmp(arg2->query("id"), arg1->query("id"));
}

