void in_read_callback(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (undefinedp(socket_info[arg1][17]) || !socket_info[arg1][17]) {
        return;
    }
    if (!arg2) {
        arg2 = "";
    }
    arg2 = replace_string(arg2, "\r", "");
    v1 = explode(arg2, "\n") - ({ 0 });
    v3 = sizeof(v1);
    for (v2 = 0; v2 < v3; v2++) {
        parse_comm(arg1, v1[v2]);
    }
}

void in_close_callback(mixed arg) {
    if (undefinedp(socket_info[arg][17])) {
        return;
    }
    logout(arg);
    lose_user(arg);
}

protected string get_path(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = resolve_path(socket_info[arg1][5], arg2);
    return v1;
}

protected void check_connections() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = keys(socket_info);
    v2 = sizeof(v1);
    while (v2--) {
        if (!undefinedp(socket_info[v1[v2]][10])) {
            v3 = time() - socket_info[v1[v2]][22];
            if (socket_info[v1[v2]][10] < v3) {
                socket_write(v1[v2], "421 Timeout: closing control session.\n");
                logout(v1[v2]);
                lose_user(v1[v2]);
            }
        }
    }
    v1 = keys(socket_info);
    v2 = sizeof(v1);
    while (v2--) {
        if (!undefinedp(socket_info[v1[v2]][7])) {
            v4 = socket_info[v1[v2]][7];
            if (undefinedp(socket_info[v4])) {
                lose_connection(v1[v2]);
            }
        }
    }
    call_out("check_connections", 180);
}

void resolve_callback(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    if (undefinedp(v1 = temp_map[arg3])) {
        log_file("FTPD", sprintf("No such key in temp_map: %d.\n", arg3));
    } else if (undefinedp(socket_info[v1])) {
        log_file("FTPD", sprintf("No such fd in socket_info: %d.\n", v1));
    } else if (arg1 && arg1 != "") {
        socket_info[v1][18] = arg1;
    }
}

void remove() {
    if (number_of_users && this_player(1) && wizhood(this_player()) != "(admin)") {
        error("Cannot destruct while there are active ftp sessions.\n");
    }
}
