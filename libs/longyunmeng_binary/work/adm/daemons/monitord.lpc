// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.

#include <ansi.h>

inherit F_DBASE;

void create()
{
   seteuid(getuid());
   set("name", "监控精灵");
   set("channel_id","监控精灵");
   set("id", "monitord");
}

void report_system_msg (string msg)
{
   CHANNEL_D->do_channel(this_object(), "sys", msg);
   log_file("monitord","["+ctime(time())+"] "+msg+"\n");
}

void report_system_object_msg (object ob, string msg)
{
   CHANNEL_D->do_channel(this_object(), "sys",
     ob->name() + "(" + capitalize(ob->query("id")) + ")" + msg);
   log_file("monitord","["+ctime(time())+"] "+
     ob->name()+"("+capitalize(ob->query("id"))+")"+msg+"\n");
}
