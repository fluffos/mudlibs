    if (!undefinedp(channels[arg2]["intermud"]) && arg1->is_character()) {
        channels[arg2]["intermud"]->send_msg(channels[arg2]["channel"], arg1->query("id"), arg1->name(1), arg3, arg4, channels[arg2]["filter"]);
    }
    if (userp(arg1) && !wizardp(arg1)) {
        if (stringp(arg1->query_temp("last_channel_msg")) && (strsrch(arg3, arg1->query_temp("last_channel_msg")) >= 0 || strsrch(arg1->query_temp("last_channel_msg"), arg3) >= 0)) {
            arg1->add_temp("channel_repeat", 1);
        } else {
            arg1->delete_temp("channel_repeat");
        }
        if (arg1->query_temp("channel_repeat") > 2) {
            arg1->set("chblk_" + arg2, time());
            switch (arg2) {
            case "chat":
                arg2 = "闲聊";
                break;
            case "rumor":
                arg2 = "谣言";
                break;
            case "new":
                arg2 = "新手";
                break;
            case "es":
                arg2 = "网际闲聊";
                break;
            case "jh":
                arg2 = "夕阳再现";
                break;
            default:
                arg2 = "交谈";
            }
            do_channel(this_object(), "rumor", "由于讲话过于罗嗦，" + arg1->name(1) + "(" + capitalize(arg1->query("id")) + ")的" + arg2 + "频道被噎死了。");
        }
        arg1->set_temp("last_channel_msg", arg3);
        if (arg1->add_temp("channel_count", 1) > 1) {
            arg1->delete_temp("channel_count");
            if (arg1->query_temp("last_channel_time") == uptime()) {
                arg1->set("chblk_" + arg2, time());
                switch (arg2) {
                case "chat":
                    arg2 = "闲聊";
                    break;
                case "rumor":
                    arg2 = "谣言";
                    break;
                case "new":
                    arg2 = "新手";
                    break;
                case "es":
                    arg2 = "网际闲聊";
                    break;
                case "jh":
                    arg2 = "夕阳再现";
                    break;
                default:
                    arg2 = "交谈";
                }
                do_channel(this_object(), "rumor", "由于讲话太多太快，" + arg1->name(1) + "(" + capitalize(arg1->query("id")) + ")的" + arg2 + "频道被噎死了。");
            }
            arg1->set_temp("last_channel_time", uptime());
        }
    }
    return 1;
}

int filter_listener_tomud(mixed arg1, mixed arg2) {
    if (!environment(arg1)) {
        return 0;
    }
    if (arg1->query("xieyi/zmud")) {
        return 0;
    }
    if (userp(arg1) && arg1->query("id") != "wenwu") {
        if (arg2["arch_only"]) {
            if (userp(arg1)) {
                if (wiz_level(arg1) < wiz_level("(arch)")) {
                    return 0;
                }
            }
        }
        if (arg2["adm_only"]) {
            if (userp(arg1)) {
                if (wiz_level(arg1) < wiz_level("(admin)")) {
                    return 0;
                }
            }
        }
        if (arg2["wiz_only"]) {
            if (userp(arg1)) {
                return wizardp(arg1);
            }
        }
        if (arg2["es_only"]) {
            if (wiz_level(arg1) > 0) {
                return 1;
            }
            if (arg1->query("age") > 23) {
                return 1;
            }
            return 0;
        }
        if (arg2["xth_only"]) {
            if (wiz_level(arg1) > 0) {
                return 1;
            }
            if (arg1->query("ttt") == 1) {
                return 1;
            }
            return 0;
        }
    }
    return 1;
}

