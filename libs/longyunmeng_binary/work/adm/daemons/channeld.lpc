void register_relay_channel(mixed arg) {
    mixed v1;
    v1 = previous_object();
    if (undefinedp(channels[arg]) || !v1) {
        return;
    }
    if (pointerp(channels[arg]["extra_listener"])) {
        if (member_array(v1, channels[arg]["extra_listener"]) >= 0) {
            return;
        }
        channels[arg]["extra_listener"] += ({ v1 });
    } else {
        channels[arg]["extra_listener"] = ({ v1 });
    }
}

string remove_addresses(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!stringp(arg1)) {
        return arg1;
    }
    if (arg2) {
        v3 = "[(][A-Za-z]+@[a-zA-Z]+[0-9]+[.]?[)]";
    } else {
        v3 = "[(][A-Za-z]+@" + upper_case(capitalize(replace_string((find_object("/adm/daemons/network/dns_master") ? "/adm/daemons/network/dns_master"->query_mud_name() : "JXONE") ? (find_object("/adm/daemons/network/dns_master") ? "/adm/daemons/network/dns_master"->query_mud_name() : "JXONE") : "", " ", "."))) + "[)]";
    }
    v2 = reg_assoc(arg1, ({ v3 }), ({ 1 }));
    if (!pointerp(v2)) {
        return arg1;
    }
    arg1 = "";
    for (v1 = 0; v1 < sizeof(v2[0]); v1++) {
        if (!v2[1][v1]) {
            arg1 += v2[0][v1];
        }
    }
    return arg1;
}

int family_listener_zmud(mixed arg1, mixed arg2) {
    if (!environment(arg1)) {
        return 0;
    }
    if (!arg1->query("xieyi/zmud")) {
        return 0;
    }
    if (wizardp(arg1) || arg1->query("family/family_name") == arg2) {
        return 1;
    } else {
        return 0;
    }
}

