protected void cha_mail(mixed arg1, mixed arg2) {
    mixed v1;
    write("\n");
    if (arg1 != arg2->query("email")) {
        write("\e[1;31m\n注册邮箱效验失败，你的地址已被记录，如有疑问请咨询在线巫师.\n\e[2;37;0m");
        log_file("login/bslogin.log", sprintf("%-15s 试图在 %-27s 使用身标登陆 %-15s 时注册邮箱验证失败\n", query_ip_number(arg2), "/adm/daemons/chinesed"->chinese_time(7, ctime(time())), arg2->query("id")));
        destruct(arg2);
        return;
    }
    if (!"/adm/daemons/band"->vaild_allow_address(arg2)) {
        destruct(arg2);
        return;
    }
    v1 = find_body(arg2->query("id"));
    if (v1) {
        if (v1->query_temp("netdead")) {
            reconnect(arg2, v1);
            return;
        }
        write("您要将另一个连线中的相同人物赶出去，取而代之吗？(\e[1;32my\e[2;37;0m/\e[1;31mn\e[2;37;0m)");
        input_to("confirm_relogin", arg2, v1);
        return;
    }
    if (objectp(v1 = make_body(arg2))) {
        if (v1->restore()) {
            if (time() - v1->query("kickout_time") < 600) {
                write("\e[1;31m\n由于你违反规则被踢出游戏，作为惩罚请十分钟后再联线。\n\e[2;37;0m");
                destruct(v1);
                destruct(arg2);
                return;
            }
            if (time() - v1->query("quit_time") < 15) {
                write("\e[1;33m\n你刚退出游戏，为了减轻系统负担请稍候再行连入，谢谢合作！！！\n\e[2;37;0m");
                destruct(v1);
                destruct(arg2);
                return;
            }
            if (query_ip_port(arg2) != 2001) {
                v1->delete("xieyi");
                v1->delete("position");
            }
            if (query_ip_port(arg2) != 2003) {
                v1->delete("xieyi");
            }
            if (query_ip_port(arg2) != 8888) {
                v1->delete("xieyi");
            }
            if (query_ip_port(arg2) == 2001) {
                v1->set("xieyi/zmud", 1);
                v1->set("position", "webuser");
            }
            if (query_ip_port(arg2) != 5555 && query_ip_port(arg2) != 9999) {
                v1->set("xieyi/zmud", 1);
            }
            if (query_ip_port(arg2) == 8888) {
                v1->set("xieyi/zmud", 1);
            }
            if (wiz_level(v1) > 0) {
                log_file("login/wiz/" + v1->query("id"), sprintf("%-20s从%20s  登    录(%s)。\n", v1->query("name") + "(" + v1->query("id") + ")", query_ip_number(arg2), ctime(time())));
            } else {
                log_file("login/login", sprintf("%-20s从%20s  登    录(%s)。\n", v1->query("name") + "(" + v1->query("id") + ")", query_ip_number(arg2), ctime(time())));
            }
            enter_world(arg2, v1);
            return;
        } else {
            destruct(v1);
        }
    }
    write("请您重新创造这个人物。\n");
    confirm_id("y", arg2, 1);
}
