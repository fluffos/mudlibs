        write("您是否满意这个中文名字(\e[1;32my\e[2;37;0m/\e[1;31mn\e[2;37;0m)？");
        printf("\e[1;37m ──\e[2;37;0m\e[33m〖 \e[1;31m%s\e[2;37;0m\e[33m 〗\e[2;37;0m：\e[2;37;0m", Rname);
        input_to("get_resp", arg2);
        return;
    } else {
        write("对不起，您只能选择满意(\e[1;32my\e[2;37;0m)不满意(\e[1;31mn\e[2;37;0m)： ");
        input_to("get_resp", arg2);
        return;
    }
}

protected void get_name(mixed arg1, mixed arg2) {
    if (arg1 == "") {
        Rname = random_name();
        write("看来您要个随机产生的中文名字．．\n");
        write("请问您是否满意这个中文名字(\e[1;32my\e[2;37;0m/\e[1;31mn\e[2;37;0m)？");
        printf("\e[1;37m ──\e[2;37;0m\e[36m〖 \e[1;33m%s\e[2;37;0m\e[36m 〗\e[2;37;0m：\e[2;37;0m", Rname);
        input_to("get_resp", arg2);
    } else {
        if (!check_legal_name(arg1)) {
            write("请再次输入您的中文名字：");
            input_to("get_name", arg2);
            return;
        }
        printf("%O\n", arg2);
        arg2->set("name", arg1);
        write("请设定您的密码：");
        input_to("new_password", 1, arg2);
    }
}

protected void new_password(mixed arg1, mixed arg2) {
    write("\n");
    if (sizeof(arg1) < 5) {
        write("密码的长度至少要五个字符，请重设您的密码：");
        input_to("new_password", 1, arg2);
        return;
    }
    if (strsrch(arg1, "//") != -1) {
        write("\e[1;31m非法的输入，请重设您的密码：");
        input_to("new_password", 1, arg2);
        return;
    }
    arg2->set("passwordold", crypt(arg1, 0));
    write("请再输入一次您的密码，以确认您没记错：");
    input_to("confirm_password", 1, arg2);
}

protected void confirm_password(mixed arg1, mixed arg2) {
    mixed v1;
    write("\n");
    v1 = arg2->query("passwordold");
    if (crypt(arg1, v1) != v1) {
        write("您两次输入的密码并不一样，请重新设定一次密码：");
        input_to("new_password", 1, arg2);
        return;
    }
    write("\n");
    write("\e[1;33m请设定您的身份标识，该标识在您自杀，以及取回密码时使用。不可修改，请谨慎保管:\e[2;37;0m");
    input_to("new_biaoshi", 1, arg2);
    return;
}

protected void new_biaoshi(mixed arg1, mixed arg2) {
    write("\n");
    if (sizeof(arg1) < 9) {
        write("身份标识的长度至少要九个字符，请重设您的身份标识：");
        input_to("new_biaoshi", 1, arg2);
        return;
    }
    if (strsrch(arg1, "//") != -1) {
        write("\e[1;31m非法的输入，请重设您的身份标识：");
        input_to("new_biaoshi", 1, arg2);
        return;
    }
    arg2->set("biaoshiold", crypt(arg1, 0));
    write("请再输入一次您的身份标识，以确认您没记错：");
    input_to("confirm_biaoshi", 1, arg2);
}

protected void confirm_biaoshi(mixed arg1, mixed arg2) {
    mixed v1;
    write("\n");
    v1 = arg2->query("biaoshiold");
    if (crypt(arg1, v1) != v1) {
        write("您两次输入的身份标识并不一样，请重新设定一次：");
        input_to("new_biaoshi", 1, arg2);
        return;
    }
    write("\n");
    write("\e[1;36m一个人物的天赋对于他或她所修习的武艺息息相关。「夕阳再现」中的人\n物大多具有以下六项天赋,其中福缘与容貌是隐藏属性：\n　　　\n　　㈠　膂力：影响攻击能力及负荷量的大小。\n　　㈡　悟性：影响学习武功秘籍的速度及理解师傅的能力。\n　　㈢　根骨：影响体力恢复的速度及升级后所增加的体力。\n　　㈣　身法：影响防御及躲避的能力。\n　　㈤　福缘：影响解迷、奇遇，拜师等运气方面。\n　　㈥  容貌：影响解密，拜师的条件以及玩家和NPC对你的印象。\n\e[2;37;0m");
    write("\n您可以输入 (\e[1;33m1-4\e[2;37;0m) 指定其中的一项值，或者输入 \e[1;31m0\e[2;37;0m 由系统随机选择。\n");
    write("您的选择是 (\e[1;33m0-4\e[2;37;0m)：");
    input_to("select_gift", arg2);
}

void get_gift(mixed arg1, mixed arg2, mixed arg3, mixed arg4) {
    if (arg1[0] != 121 && arg1[0] != 89) {
        random_gift(arg3, arg4);
        printf("\n膂力[%s]，悟性[%s]，根骨[%s]，身法[%s]\n", display_attr(arg3["str"]), display_attr(arg3["int"]), display_attr(arg3["con"]), display_attr(arg3["dex"]));
        write("您同意这一组天赋吗？");
        input_to("get_gift", arg2, arg3, arg4);
        return;
    }
    write("\n");
    write("\e[1;37m「夕阳再现」存在着十一系魔法元素，当一个人的魔法修为达到一定的水平\n就可以随意地操纵这些魔法元素。「夕阳再现」的每个人天生就拥有对其\n中一种魔法元素进行操作的天赋：\n　　　\n　　(0)　光明：感知、运用光的力量，对黑暗力量有一定的约束作用。\n　　(1)　土  ：感知、运用大地的力量，一定程度上抑制水之力量。\n　　(2)　火  ：感知、运用火焰的力量，一定程度上抑制金之力量。\n　　(3)　水  ：感知、运用水和冰的力量，一定程度上抑制火之力量。\n　　(4)　木  ：感知、运用森林的力量，一定程度上抑制土之力量。\n　　(5)　气  ：感知、运用风的力量，对火、水之力量有一定的推助作用。\n　　(6)　雷  ：感知、运用雷电"
            "的力量，一定程度上可以推涨金之力量。\n　　(7)　心灵：感知、运用精神力量，对异空间的生物有着奇妙的感知联系。\n　　(8)　黑暗：感知、运用黑暗的力量，对光明力量有一定的缚束作用。\n　　(9)　空间：感知、运用空间的力量，对空间有着莫名的亲切和熟悉。\n　　(10) 金  ：感知、运用金的力量，一定程度上抑制木之力量。\n\e[2;37;0m");
    write("\n您可以通过输入 (\e[1;33m0-10\e[2;37;0m) 选择您在\e[1;32m「\e[1;31m夕阳再现\e[1;32m」\e[2;37;0m里拥有的魔法天赋：\n");
    input_to("get_magic_born", arg2, arg3, arg4);
}

void select_gift(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = ([ ]);
    if (!sscanf(arg1, "%d", v1) || v1 < 0 || v1 > 4) {
        write("\n输入错误，请重新选择：");
        input_to("select_gift", arg2);
        return;
    }
    if (v1) {
        write("\n请输入您想要的数值(10-30)：");
        input_to("set_gift", arg2, v2, v1);
    } else {
        get_gift(" ", arg2, v2, v1);
    }
}

void set_gift(mixed arg1, mixed arg2, mixed arg3, mixed arg4) {
    mixed v1;
    if (!sscanf(arg1, "%d", v1) || v1 < 10 || v1 > 30) {
        write("\n数值错误，请重新输入：");
        input_to("set_gift", arg2, arg3, arg4);
        return;
    }
    switch (arg4) {
    case 1:
        arg3["str"] = v1;
        break;
    case 2:
        arg3["int"] = v1;
        break;
    case 3:
        arg3["con"] = v1;
        break;
    case 4:
        arg3["dex"] = v1;
    }
    get_gift(" ", arg2, arg3, arg4);
}

protected void get_email(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    write("\n");
    if (arg1 == "" || strsrch(arg1, "@") == -1 || sscanf(arg1, "%s@%s", v2, v3) != 2 || strsrch(v3, ".") == -1) {
        write("电子邮件地址需要是 id@address 的格式。\n");
        write("您的电子邮件地址：");
        input_to("get_email", arg2, arg3);
        return;
    }
    arg2->set("email", arg1);
    arg2->set("body", "/clone/user/user");
    if (!objectp(v1 = make_body(arg2))) {
        destruct(arg2);
        return;
    }
    v1->set("str", arg3["str"]);
    v1->set("dex", arg3["dex"]);
    v1->set("con", arg3["con"]);
    v1->set("int", arg3["int"]);
    v1->set("kar", arg3["kar"]);
    v1->set("per", arg3["per"]);
    v1->set("wuxing/mofa", arg3["magic_num"]);
    arg2->set("registered", 1);
    v1->set("registered", 1);
    write("您要扮演男性(\e[1;36mm\e[2;37;0m)的角色或女性(\e[1;31mf\e[2;37;0m)的角色？");
    input_to("get_gender", arg2, v1);
}

protected void get_gender(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    write("\n");
    if (arg1 == "") {
        write("您要扮演男性(\e[1;36mm\e[2;37;0m)的角色或女性(\e[1;31mf\e[2;37;0m)的角色？");
        input_to("get_gender", arg2, arg3);
        return;
    }
    if (arg1[0] == 109 || arg1[0] == 77) {
        arg3->set("gender", "男性");
    } else if (arg1[0] == 102 || arg1[0] == 70) {
        arg3->set("gender", "女性");
    } else {
        write("对不起，您只能选择男性(\e[1;36mm\e[2;37;0m)或女性(\e[1;31mf\e[2;37;0m)的角色：");
        input_to("get_gender", arg2, arg3);
        return;
    }
    if (query_ip_port(arg2) != 2001) {
        arg3->delete("xieyi");
        arg3->delete("position");
    }
    if (query_ip_port(arg2) != 2003) {
        arg3->delete("xieyi");
    }
    if (query_ip_port(arg2) != 8888) {
        arg3->delete("xieyi");
    }
    if (query_ip_port(arg2) == 2001) {
        arg3->set("xieyi/zmud", 1);
        arg3->set("position", "webuser");
    }
    if (query_ip_port(arg2) != 5555 && query_ip_port(arg2) != 9999) {
        arg3->set("xieyi/zmud", 1);
    }
    if (query_ip_port(arg2) == 8888) {
        arg3->set("xieyi/zmud", 1);
    }
    log_file("login/newid.log", sprintf("%-12s was created from %-20s (%s)\n", arg3->query("id"), query_ip_number(arg2), ctime(time())));
    "/adm/daemons/channeld"->do_channel(this_object(), "sys", "又有一个新玩家：" + arg3->query("name") + "[" + arg3->query("id") + "]。\e" + "[2;37;0m");
    init_new_player(arg3);
    enter_world(arg2, arg3);
    v2 = read_file("/adm/daemons/iduser", 1);
    v1 = atoi(v2);
    v1 = v1 + 1;
    v2 = sprintf("%d", v1);
    write_file("/adm/daemons/iduser", v2, 1);
    write("\n");
}

object make_body(mixed arg) {
    mixed v1;
    mixed v2;
    if (stringp(arg->query("body"))) {
        v2 = clone_object(arg->query("body"));
    } else {
        return 0;
    }
    if (!v2) {
        write("现在可能有人正在修改使用者物件的程式，无法进行复制。\n");
        write(v1 + "\n");
        return 0;
    }
    seteuid(arg->query("id"));
    export_uid(v2);
    export_uid(arg);
    seteuid(getuid());
    v2->set("id", arg->query("id"));
    v2->set_name(arg->query("name"), ({ arg->query("id") }));
    return v2;
}

protected void init_new_player(mixed arg) {
    arg->set("title", "普通百姓");
    arg->set("birthday", time());
    arg->set("max_fashufali", 100);
    arg->set("fashufali", 100);
    arg->set("potential", 100);
    arg->set("channels", ({ "es", "chat", "jypm", "xyxw", "rumor", "tell", "new", "shout", "jh", "xy" }));
    arg->set("combat_exp", 5);
    arg->set("money", 2000);
}

protected void get_wizpas(mixed arg1, mixed arg2) {
