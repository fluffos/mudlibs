    }
    if (!v6->query("last_on")) {
        write("\e[45;1m欢迎您来与我们共同历阅这个虚拟世界，特为您奉上一份小礼物以表心意！\n\e[1;32m礼物领取路径：fly yz;w;n;w;pick gift;chai gift                    \n\e[2;37;0m");
