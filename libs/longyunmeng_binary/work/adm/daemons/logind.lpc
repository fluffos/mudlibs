        "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("%s(%s)由%s连线进入。", arg2->name(), arg2->query("id"), query_ip_name(arg2)));
    }
    "/adm/daemons/updated"->check_user(arg2, 3);
    "/adm/daemons/statud"->compare_status(arg2);
    arg2->set_temp("temp_exp", arg2->query("combat_exp"));
    arg2->set_temp("temp_time", time());
    if (userp(arg2)) {
        v9 = children("/clone/user/user");
        for (v7 = 0; v7 < sizeof(v9); v7++) {
            if (!arg2->query("xieyi/zmud")) {
                tell_object(arg2, "\031lbadd2 " + "/adm/daemons/rankd"->new_name(v9[v7]) + ";" + "\032");
            }
            if (!v9[v7]->query("xieyi/zmud")) {
                tell_object(v9[v7], "\031lbadd2 " + "/adm/daemons/rankd"->new_name(arg2) + ";" + "\032");
            }
        }
    }
    arg2->force_me("wear all");
    if (!wizardp(arg2) && arg2->query("age") < lock_age) {
        write("\e[1;33m对不起，现在游戏禁止年龄在" + lock_age + "以下的人物进入！\n\e" + "[2;37;0m");
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", arg2->query("name") + "(" + arg1->query("id") + ")被迫离开游戏了。");
        arg2->save();
        destruct(arg2);
        destruct(arg1);
    }
}

varargs void reconnect(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    arg2->set_temp("link_ob", arg1);
    arg1->set_temp("body_ob", arg2);
    if (query_ip_port(arg1) != 2001) {
        arg2->delete("xieyi");
        arg2->delete("position");
    }
    if (query_ip_port(arg1) != 2003) {
        arg2->delete("xieyi");
    }
    if (query_ip_port(arg1) != 8888) {
        arg2->delete("xieyi");
    }
    if (query_ip_port(arg1) == 2001) {
        arg2->set("xieyi/zmud", 1);
        arg2->set("position", "webuser");
    }
    if (query_ip_port(arg1) != 5555 && query_ip_port(arg1) != 9999) {
        arg2->set("xieyi/zmud", 1);
    }
    if (query_ip_port(arg1) == 8888) {
        arg2->set("xieyi/zmud", 1);
    }
    exec(arg2, arg1);
    arg2->reconnect();
    if (userp(arg2)) {
        v4 = users();
        for (v3 = 0; v3 < sizeof(v4); v3++) {
            if (!arg2->query("xieyi/zmud")) {
                tell_object(arg2, "\031lbadd2 " + "/adm/daemons/rankd"->new_name(v4[v3]) + ";" + "\032");
            }
        }
        if (!arg2->query("xieyi/zmud")) {
            v1 = all_inventory(arg2);
            if (sizeof(v1)) {
                for (v2 = 0; v2 < sizeof(v1); v2++) {
                    tell_object(arg2, "\031lbadd1 " + "/adm/daemons/rankd"->new_short(v1[v2]) + ";" + "\032");
                }
            }
        }
    }
    if (!arg3) {
        if (arg2->query("lixian/biguan")) {
            arg2->delete("lixian/biguan");
            "/adm/daemons/biguand"->del_bg_user(arg2);
            tell_room(environment(arg2), arg2->query("name") + "\e" + "[33m闭关复出重新踏入江湖。\n\e" + "[2;37;0m", ({ arg2 }));
            message("channel:chat", "\e[1;33m【镜花水月】：\e[1;37m听说 \e[1;36m" + arg2->query("name") + "\e" + "[1;37m 闭关中途突然复出,似乎对天道终极奥义有了进一步了解！\n\e" + "[2;37;0m", users());
        } else {
            tell_room(environment(arg2), arg2->query("name") + "\e" + "[33m重新连线回到这个世界。\n\e" + "[2;37;0m", ({ arg2 }));
        }
    }
    arg2->force_me("look");
    if (arg2->query("id") != "wenwu") {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("%s(%s)由(%s)重新连线进入。", arg2->query("name"), arg2->query("id"), query_ip_number(arg2)));
    }
    "/adm/daemons/updated"->check_user(arg2);
}

int check_legal_id(mixed arg) {
    mixed v1;
