int check_legal_name(mixed arg) {
    mixed v1;
    v1 = sizeof(arg);
    // characters, not GBK bytes (KB 07 8.1)
    if (sizeof(arg) < 1 || sizeof(arg) > 5) {
        write("对不起，你的中文名字必须是 1 到 5 个中文字。\n");
        return 0;
    }
    while (v1--) {
        if (arg[v1] <= 32) {
            write("对不起，你的中文名字不能用控制字元。\n");
            return 0;
        }
        if (!is_chinese(arg[v1..])) {
            write("对不起，请您用「中文」取名字。\n");
            return 0;
        }
    }
    if (member_array(arg, banned_name) != -1) {
        write("对不起，这种名字会造成其他人的困扰。\n");
        return 0;
    }
    for (v1 = 0; v1 < sizeof(banned_name); v1++) {
        if (strsrch(arg, banned_name[v1]) != -1) {
            write("对不起，这种名字会造成其他人的困扰。\n");
            return 0;
        }
    }
    return 1;
}

object find_body(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (objectp(v1 = find_player(arg))) {
        return v1;
    }
    v2 = children("/clone/user/user");
    for (v3 = 0; v3 < sizeof(v2); v3++) {
        if (clonep(v2[v3]) && getuid(v2[v3]) == arg) {
            return v2[v3];
        }
    }
    return 0;
}

int set_agelock(mixed arg) {
    if (wiz_level(this_player(1)) < wiz_level("(admin)")) {
        return 0;
    }
    if (!arg) {
        lock_age = 0;
    } else {
        lock_age = arg;
    }
    return 1;
}

int set_wizlock(mixed arg) {
    if (wiz_level(this_player(1)) <= arg) {
        return 0;
    }
    if (geteuid(previous_object()) != "Root") {
        return 0;
    }
    wiz_lock_level = arg;
    return 1;
}

int set_madlock(mixed arg) {
    if (wiz_level(this_player(1)) < wiz_level("(arch)")) {
        return 0;
    }
    if (arg == 1) {
        mad_lock = 1;
    } else {
        mad_lock = 0;
    }
    return 1;
}

int get_madlock() {
    return mad_lock;
}

protected void get_version(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    if (strsrch(arg1, ascii_num(Rasc) + "2060") != -1) {
        if (query_ip_port(arg2) == 5555 || query_ip_port(arg2) == 9999) {
            input_to((: get_id :), arg2, arg3);
            return;
        } else {
            write("\e[41;1m\e[1;33m\n您使用的是Tomud协议客户端，请使用端口 \e[1;32m" + 5555 + "\e" + "[1;37m 或 \e" + "[1;32m" + 9999 + "\e" + "[1;33m 重新连线！\n\e" + "[2;37;0m");
            destruct(arg2);
            return;
        }
    } else if (query_ip_port(arg2) == 5555 || query_ip_port(arg2) == 9999) {
        write("\e[41;1m\e[1;33m\n您的客户端不支持Tomud协议，请使用端口 \e[1;32m" + 2003 + "\e" + "[1;37m 或 \e" + "[1;32m" + 8888 + "\e" + "[1;33m 重新连线！\n\e" + "[2;37;0m");
        destruct(arg2);
        return;
    } else {
        arg1 = lower_case(arg1);
        if (!check_legal_id(arg1)) {
            write("\e[33m请输入您的英文名字：\e[2;37;0m");
            input_to("get_id", arg2, arg3);
            return;
        }
        v2 = users();
        v4 = 0;
        for (v3 = 0; v3 < sizeof(v2); v3++) {
            if (wizardp(v2[v3])) {
                v4++;
            }
        }
        if ("/adm/daemons/securityd"->get_status(arg1) == "(player)" && sizeof(users()) - v4 >= 500) {
            v1 = find_body(arg1);
            if (!v1 || !interactive(v1)) {
                write("\e[1;33m对不起，夕阳再现之炎龙封印的使用者已经太多了，请待会再来。\n\e[2;37;0m");
                destruct(arg2);
                return;
            }
        }
        if (wiz_level(arg1) < wiz_lock_level) {
            write("\e[1;33m对不起，夕阳再现之炎龙封印目前限制巫师等级 \e[1;32m" + wiz_lock_level + "\e" + "[1;33m 以上的人才能连线。\n\e" + "[2;37;0m");
            destruct(arg2);
            return;
        }
        if (arg2->set("id", arg1) != arg1) {
            write("Failed setting user name.\n");
            destruct(arg2);
            return;
        }
        for (v3 = 0; v3 < sizeof(banned_id); v3++) {
            if (strsrch(arg1, banned_id[v3]) != -1) {
                write("\e[1;33m对不起，这个帐户正在有另一个使用者在登录，请重新输入你的英文名。\n\e[2;37;0m");
                write("\e[33m请输入您的英文名字：\e[2;37;0m");
                input_to("get_id", arg2, arg3);
                return;
            }
        }
        if (arg1 == "guest") {
            write("\e[1;33m对不起，现在限制guest帐户登录，请重新输入你的英文名。\n\e[2;37;0m");
            write("您的\e[1;37m英文\e[2;37;0m名字：");
            input_to("get_id", arg2, arg3);
            return;
        }
        if (wiz_level(arg1) < 2) {
            if (!"/adm/daemons/band"->is_welcome(arg1)) {
                if (arg3 > 50) {
                    write("\e[1;31m这个IP上来的玩家太多了，不能进入！！ \n\e[2;37;0m");
                    destruct(arg2);
                    return;
                }
            }
        }
        if (file_size(arg2->query_save_file() + ".o") >= 0) {
            if (arg2->restore()) {
                if (wiz_level(arg1) > 0) {
                    write("\e[1;37m您目前的权限是\e[1;33m" + wizhood(arg1) + "\e" + "[1;37m,为了安全起见，请输入本站巫师登陆效验码：\e" + "[2;37;0m");
                    input_to("get_wizpas", 1, arg2);
                } else {
                    write("\e[33m请输入您的密码：\e[2;37;0m");
                    input_to("get_passwd", 1, arg2);
                }
                return;
            } else {
                write("\e[1;33m您的人物储存挡出了一些问题，请利用 其他ID 通知巫师处理。\n\e[2;37;0m");
                destruct(arg2);
                return;
            }
        }
        v5 = 0;
        for (v3 = 0; v3 < sizeof(v2); v3++) {
            if (v2[v3]->query("id") == arg1) {
                v5++;
            }
            if (v5 > 1) {
                write("\e[1;33m对不起，这个帐户正在有另一个使用者在登录，请重新输入你的英文名。\n\e[2;37;0m");
                write("请输入您的您的英文名字：");
                input_to("get_id", arg2, arg3);
                return;
            }
        }
        write("使用 \e[1;37m" + arg2->query("id") + "\e" + "[2;37;0m 这个名字将会创造一个新的人物，您确定吗(\e" + "[1;32my\e" + "[2;37;0m/\e" + "[1;31mn\e" + "[2;37;0m)？");
        input_to("confirm_id", arg2, arg3);
    }
}

void get_magic_born(mixed arg1, mixed arg2, mixed arg3, mixed arg4) {
    mixed v1;
    if (!sscanf(arg1, "%d", v1) || v1 < 0 || v1 > 10) {
        write("\e[1;32m「\e[1;31m夕阳再现\e[1;32m」\e[2;37;0m并没有这种魔法类型，请重新选择(\e[1;33m0-10\e[2;37;0m)：\n\e[1;37m　　(0)　光明：感知、运用光的力量，对黑暗力量有一定的约束作用。\n　　(1)　土  ：感知、运用大地的力量，一定程度上抑制水之力量。\n　　(2)　火  ：感知、运用火焰的力量，一定程度上抑制金之力量。\n　　(3)　水  ：感知、运用水和冰的力量，一定程度上抑制火之力量。\n　　(4)　木  ：感知、运用森林的力量，一定程度上抑制土之力量。\n　　(5)　气  ：感知、运用风的力量，对火、水之力量有一定的推助作用。\n　　(6)　雷  ：感知、运用雷电的力量，一定程度上可以推涨金之力量。\n　　(7)　心灵：感知、运用精神力量"
                "，对异空间的生物有着奇妙的感知联系。\n　　(8)　黑暗：感知、运用黑暗的力量，对光明力量有一定的缚束作用。\n　　(9)　空间：感知、运用空间的力量，对空间有着莫名的亲切和熟悉。\n　　(10) 金  ：感知、运用金的力量，一定程度上抑制木之力量。\e[2;37;0m");
        input_to("get_magic_born", arg2, arg3, arg4);
        return;
    }
    arg3["magic_num"] = v1;
    switch (arg3["magic_num"]) {
    case 0:
        write("\n您选择了\e[1;36m“光明”\e[2;37;0m系作为您在\e[1;32m「\e[1;31m夕阳再现\e[1;32m」\e[2;37;0m里的魔法天赋。");
        break;
    case 1:
        write("\n您选择了\e[33m“土”\e[2;37;0m系作为您在\e[1;32m「\e[1;31m夕阳再现\e[1;32m」\e[2;37;0m里的魔法天赋。");
        break;
    case 2:
        write("\n您选择了\e[1;31m“火”\e[2;37;0m系作为您在\e[1;32m「\e[1;31m夕阳再现\e[1;32m」\e[2;37;0m里的魔法天赋。");
        break;
    case 3:
        write("\n您选择了\e[1;37m“水”\e[2;37;0m系作为您在\e[1;32m「\e[1;31m夕阳再现\e[1;32m」\e[2;37;0m里的魔法天赋。");
        break;
    case 4:
        write("\n您选择了\e[1;32m“木”\e[2;37;0m系作为您在\e[1;32m「\e[1;31m夕阳再现\e[1;32m」\e[2;37;0m里的魔法天赋。");
        break;
    case 5:
        write("\n您选择了\e[1;37m“气”\e[2;37;0m系作为您在\e[1;32m「\e[1;31m夕阳再现\e[1;32m」\e[2;37;0m里的魔法天赋。");
        break;
    case 6:
        write("\n您选择了\e[1;34m“雷”\e[2;37;0m系作为您在\e[1;32m「\e[1;31m夕阳再现\e[1;32m」\e[2;37;0m里的魔法天赋。");
        break;
    case 7:
        write("\n您选择了\e[1;35m“心灵”\e[2;37;0m系作为您在\e[1;32m「\e[1;31m夕阳再现\e[1;32m」\e[2;37;0m里的魔法天赋。");
        break;
    case 8:
        write("\n您选择了\e[37m“黑暗”\e[2;37;0m系作为您在\e[1;32m「\e[1;31m夕阳再现\e[1;32m」\e[2;37;0m里的魔法天赋。");
        break;
    case 9:
        write("\n您选择了\e[1;37m“空间”\e[2;37;0m系作为您在\e[1;32m「\e[1;31m夕阳再现\e[1;32m」\e[2;37;0m里的魔法天赋。");
