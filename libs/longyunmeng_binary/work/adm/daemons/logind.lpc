varargs void enter_world(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    mixed v9;
    v8 = random(3);
    arg2->set_temp("link_ob", arg1);
    arg1->set_temp("body_ob", arg2);
    arg2->set("registered", arg1->query("registered"));
    exec(arg2, arg1);
    arg2->setup();
    if (arg2->query("age") == 14) {
        arg2->set("food", arg2->max_food_capacity());
        arg2->set("water", arg2->max_water_capacity());
    }
    if (arg2->query("lixian/biguan")) {
        arg2->delete("lixian/biguan");
    }
    arg2->save();
    arg1->save();
    if (!arg2->over_encumbranced()) {
        if (arg2->query("age") < 18) {
            if (arg2->query("gender") == "女性") {
                v1 = clone_object("/clone/misc/pink_cloth");
            } else {
                v1 = clone_object("/clone/cloth/cloth");
            }
            if (!arg1->query("last_on")) {
                v1->move(arg2);
                v1->wear();
                arg2->set("env/wimpy", 80);
            }
        }
        arg2->set("xy_huiyuan", "2006年12月31日");
        if (arg2->query("xy_huiyuan")) {
            if (strsrch(arg2->query("xy_huiyuan"), "年") != -1 && strsrch(arg2->query("xy_huiyuan"), "月") != -1 && strsrch(arg2->query("xy_huiyuan"), "日") != -1) {
                "/feature/vip"->del_vip(arg2, arg2->query("xy_huiyuan"));
            } else {
                arg2->delete("xy_huiyuan");
            }
        }
        if (!arg2->query("xy_huiyuan")) {
            arg2->set("xy_huiyuan", "免费会员");
        }
        if (arg2->query("block/time") && time() > arg2->query("block/time")) {
            arg2->delete("startroom");
            arg2->delete("block/time");
        }
    }
    if (!arg3) {
        v6 = arg1;
        v6->set("id", arg2->query("id"));
        v6->restore();
        if (arg2->query("lixian/biguan")) {
            arg2->delete("lixian/biguan");
        }
        if (!arg2->query("xieyi/zmud")) {
            if (arg2->query("xy_huiyuan")) {
                write("\031alert 您的会员资格：截止于" + arg2->query("xy_huiyuan") + "\n" + "\032");
                write("\031statu 会员截止时间：" + arg2->query("xy_huiyuan") + "\n" + "\032");
            } else {
                write("\031alert 您的会员资格：已过期\n\032");
                write("\031statu 会员截止时间：过期\n\032");
            }
        } else if (arg2->query("xy_huiyuan")) {
            write("\e[1;32m★ 您的会员资格：\e[1;36m截止于" + arg2->query("xy_huiyuan") + "\n\e" + "[2;37;0m");
        } else {
            write("\e[1;32m★ 您的会员资格：\e[1;36m已过期\n\e[2;37;0m");
        }
        write("\e[1;32m★ 您目前的权限：\e[1;33m" + wizhood(arg2) + "\n\e" + "[2;37;0m");
        if (!v6->query("last_from")) {
            write("\e[1;32m★ 您上次光临是从：\e[1;37m您尚是第一次进入炎龙大陆\n\e[2;37;0m");
        } else {
            write("\e[1;32m★ 您上次光临是从：\e[1;37m" + v6->query("last_from") + "\n\e" + "[2;37;0m");
            write("\e[1;32m★ 您上次连线地址为：\e[44;1m\e[1;37m" + "/feature/ipsite"->seek_ip_address(v6->query("last_from")) + "\n\e" + "[2;37;0m");
        }
        if (!v6->query("last_on")) {
            write("\e[1;32m★ 您上次连线的时间是：\e[1;36m欢迎您成为我们的一员\n\e[2;37;0m");
        } else {
            write("\e[1;32m★ 您上次连线的时间是：\e[1;31m" + "/adm/daemons/chinesed"->chinese_time(5, ctime(v6->query("last_on"))) + "\n\e" + "[2;37;0m");
        }
        v4 = arg2->query("id");
        v5 = "/data/mail/" + v4[0..0] + "/" + v4 + ".o";
        if (file_size(v5) && arg2->query("new_mail") < file_size(v5)) {
            call_out("have_mail", 3);
        }
        if (arg2->is_ghost()) {
            v3 = "/d/death/gate";
        } else {
