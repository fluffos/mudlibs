            if (!objectp(arg1->query_temp("weapon")) && sizeof(arg1->query_skill_prepare()) > 1 || objectp(arg1->query_temp("weapon")) && arg1->query_temp("weapon")->query("skill_type") == "sword" && arg1->query_skill("pixie-jian", 1) >= 60 && arg1->query_skill_mapped("sword") == "pixie-jian") {
                arg1->set_temp("action_flag", 1);
                do_attack(arg1, arg2, arg1->query_temp("weapon"), 2);
                arg1->set_temp("action_flag", 0);
            }
        }
        if (living(arg2)) {
            if (!objectp(v1 = arg1->query_temp("weapon"))) {
                v2 = "unarmed";
            } else {
                v2 = v1->query("skill_type");
            }
            v2 = arg1->query_skill_mapped(v2);
            if (stringp(v2)) {
                arg1->set_temp("action_flag", 1);
                ("/kungfu/skill/" + v2)->do_interlink(arg1, arg2);
                arg1->set_temp("action_flag", 0);
            }
        }
    } else if (random(arg2->query_dex() * 2) < arg1->query_dex() || random(10) < 3) {
        arg1->set_temp("guarding", 0);
        if (!arg2->is_fighting(arg1)) {
