                        arg2->add("xyzx_sys/level", -arg2->query("xyzx_sys/level") / 20);
                    }
                }
            }
            if (arg2->query("potential")) {
                arg2->add("potential", -(arg2->query("potential") / 2));
            }
        }
        v1 = 10;
        if (objectp(arg1)) {
            if (!arg1->query_temp("kill_other/" + arg2->query("id")) && arg2->query_temp("kill_other/" + arg1->query("id"))) {
                v5 = "被" + arg1->query("name") + "(" + arg1->query("id") + ")正当防卫杀死了。";
            } else {
                v5 = "被" + arg1->query("name") + "(" + arg1->query("id") + ")杀死了。";
            }
        }
        if (userp(arg1) && arg2->query_condition("killer")) {
            "/adm/daemons/channeld"->do_channel(this_object(), "rumor", sprintf("\e[1;32m官府通缉犯%s被%s就地正法，为江湖除一大害!\e[2;37;0m", arg2->query("name"), arg1->query("name")));
        } else if (!arg1->query_temp("kill_other/" + arg2->query("id")) && arg2->query_temp("kill_other/" + arg1->query("id"))) {
            "/adm/daemons/channeld"->do_channel(this_object(), "rumor", sprintf("\e[1;35m听说%s" + v5, arg2->query("name")));
        } else {
            "/adm/daemons/channeld"->do_channel(this_object(), "rumor", sprintf("听说%s" + v5, arg2->query("name")));
        }
        if (userp(arg1)) {
            write_file("/log/static/KILL_PLAYER", sprintf("%s(%s) 被 %s(%s) 杀死于 %s\n", arg2->name(1), arg2->query("id"), arg1->name(1), arg1->query("id"), "/adm/daemons/chinesed"->chinese_time(7, ctime(time()))));
            if (arg1->query_temp("pker_starttime") + arg1->query_temp("pker_time") * 900 < arg1->query("mud_age")) {
                arg1->set_temp("pker_starttime", arg1->query("mud_age"));
                arg1->delete_temp("pker_time");
            }
            arg1->add_temp("pker_time", 1);
            if (!arg2->query_condition("killer")) {
                if (arg1->query_temp("kill_other/" + arg2->query("id")) && !arg2->query_temp("kill_other/" + arg1->query("id"))) {
                    "/adm/daemons/channeld"->do_channel(this_object(), "rumor", sprintf("官府开始捉拿%s,并奖励将杀人犯就地正法之江湖好汉。", arg1->query("name")));
                }
            }
            if (arg1->query_temp("kill_other/" + arg2->query("id")) && !arg2->query_temp("kill_other/" + arg1->query("id"))) {
                if (!arg2->query_condition("killer")) {
                    arg1->apply_condition("killer", 1000 + arg1->query_condition("killer"));
                    arg1->add("PKS", 1);
                    if (arg1->query("PKS_day") && time() - arg1->query("PKS_time") > 86400) {
                        arg1->delete("PKS_day");
                    }
                    if (!arg1->query("PKS_time") || time() - arg1->query("PKS_time") > 86400) {
                        arg1->set("PKS_time", time());
                    }
                    if (!arg2->query_condition("killer") && time() - arg1->query("PKS_time") < 86400) {
                        arg1->add("PKS_day", 1);
                        tell_object(arg1, "\e[1;33m这是你今天第 \e[1;31m" + arg1->query("PKS_day") + "\e" + "[1;33m 次PK，今天你还有 \e" + "[1;31m" + (3 - arg1->query("PKS_day")) + "\e" + "[1;33m 次PK机会。\n\e" + "[2;37;0m");
                    }
                }
                if (arg1->query("PKS_day") > 15) {
                    arg1->set("block/time", time() + 86400);
                    arg1->move("/clone/misc/block");
                    arg1->set("startroom", "/clone/misc/block.lpc");
                    tell_object(arg1, "\e[1;31m你一天内杀害玩家数达到15人以上，囚禁一天以待反省。\n");
                    message("channel:chat", "\e[1;33m【镜花水月】\e[1;35m听说\e[1;31m" + arg1->query("name") + "\e" + "[1;35m因为今天PK次数过多关进了监狱！\n\e" + "[2;37;0m", users());
                }
                arg1->delete_temp("kill_other/" + arg2->query("id"));
                arg2->delete_temp("kill_other/" + arg1->query("id"));
                arg1->delete_temp("other_kill/" + arg2->query("id"));
                arg2->delete_temp("other_kill/" + arg1->query("id"));
            }
            if (!(!arg2->query_condition("killer") && arg1->query_condition("killer") && userp(arg1))) {
                arg2->add("combat_exp", -arg2->query("combat_exp") / 30);
                arg2->add("xyzx_sys/levup_exp", -arg2->query("xyzx_sys/levup_exp") / 30);
                if (arg2->query("xyzx_sys/level") > 1) {
                    if (arg2->query("xyzx_sys/level") > 0 && arg2->query("xyzx_sys/level") < 30) {
                        arg2->add("xyzx_sys/level", -1);
                    } else {
                        arg2->add("xyzx_sys/level", -arg2->query("xyzx_sys/level") / 30);
                    }
                }
            }
            if (arg2->query_condition("killer")) {
                arg2->add("combat_exp", -arg2->query("combat_exp") / 30);
                arg2->add("xyzx_sys/levup_exp", -arg2->query("xyzx_sys/levup_exp") / 30);
                if (arg2->query("xyzx_sys/level") > 1) {
                    if (arg2->query("xyzx_sys/level") > 0 && arg2->query("xyzx_sys/level") < 30) {
                        arg2->add("xyzx_sys/level", -1);
                    } else {
                        arg2->add("xyzx_sys/level", -arg2->query("xyzx_sys/level") / 30);
                    }
                }
            }
        }
        arg2->set("xyzx_sys/kill_me", arg1->query("name"));
    } else {
        if (userp(arg1)) {
            arg1->add("MKS", 1);
        }
        v1 = 1;
    }
    if (v4 == arg2->query("id") && !userp(arg2)) {
        "/adm/daemons/channeld"->do_channel(this_object(), "rumor", sprintf("%s将自己的师傅%s杀死了,真是惨无人道啊。", arg1->query("name"), arg2->query("name")));
    }
    if (!arg1->is_ghost() && userp(arg1)) {
        arg1->add("shen", -arg2->query("shen") / 10);
    }
    v9 = arg1->query("combat_exp");
    if (arg2->query("xyzx_sys/level") >= arg1->query("xyzx_sys/level")) {
        v11 = to_float(arg2->query("xyzx_sys/level")) * 15000000 + arg2->query("combat_exp") + arg2->query("xyzx_sys/levup_exp");
        v12 = (to_float(arg1->query("xyzx_sys/level")) * 15000000 + v9 + arg1->query("xyzx_sys/levup_exp")) / 10;
        if (!userp(arg2) && userp(arg1) && v11 > v12) {
            if (!(arg1->query("combat_exp") >= 100000000 && arg1->query("xyzx_sys/level") < 5)) {
                v10 = arg2->query("combat_exp") / 10000;
                v10 = random(v10) + random(3000);
                arg1->add("combat_exp", v10);
                arg1->add("potential", v10 / 10);
                tell_object(arg1, "你成功杀死了" + arg2->name() + "得到了 \e" + "[1;35m" + v10 + "\e" + "[2;37;0m 点经验和 \e" + "[1;33m" + v10 / 10 + "\e" + "[2;37;0m 点潜能。\n\e" + "[2;37;0m");
            }
        }
    }
    if (stringp(v3 = arg2->query("vendetta_mark"))) {
        arg1->add("vendetta/" + v3, 1);
    }
    if (arg1->query("family/master_id") == arg2->query("id")) {
        if (arg2->query_temp("fighting") == arg1) {
            arg1->delete("family");
            arg1->set("title", "普通百姓");
            arg1->delete("class");
            arg2->delete_temp("fighting");
            "/adm/daemons/channeld"->do_channel(arg2, "chat", sprintf("真不愧是青出于蓝而胜于蓝！%s，你可以出师了，从此另立门户吧！", arg1->query("name")));
        } else if (arg1->query("class") == "bonze" && arg2->query("class") == "bonze") {
            arg1->set("kill_bonze", time());
            arg1->delete("family");
            if (v7 = arg1->query_temp("link_ob")) {
                arg1->set("name", v7->query("name"));
            }
            arg1->set("title", "普通百姓");
            arg1->delete("class");
            "/adm/daemons/channeld"->do_channel(arg2, "chat", sprintf("%s，你谋害自己的师傅，为我佛门所不容，你走吧！", arg1->query("name")));
        }
    }
}

string tribar_graph(mixed arg1, mixed arg2, mixed arg3, mixed arg4) {
    return arg4 + bar_string[0..arg1 * 10 / arg3 * 2 - 1] + (arg2 > arg1 ? blank_string[arg1 * 10 / arg3 * 2..arg2 * 10 / arg3 * 2 - 1] : "") + (arg3 > arg2 ? none_string[arg2 * 10 / arg3 * 2..19] : "");
}

int level_combat(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = 0;
    v1 = to_float(arg1->query("eff_jing")) / arg1->query("max_jing");
    v2 = to_float(arg1->query("eff_qi")) / arg1->query("max_qi");
    v3 = to_int(v1 * v2 * arg2);
    return v3;
}
