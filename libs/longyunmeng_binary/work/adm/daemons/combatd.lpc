void announce(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    switch (arg2) {
    case "dead":
        if (random(20) > 10) {
            message_vision("\e[2;37;0m\n$N扑在地上挣扎了几下，腿一伸，口中喷出几口\e[1;31m鲜血\e[2;37;0m，死了！\n\n\e[2;37;0m", arg1);
        } else if (random(20) > 10) {
            message_vision("\e[2;37;0m\n$N大叫一声倒在地上，挣扎了几下，\e[1;31m死了\e[2;37;0m！\n\n", arg1);
        } else {
            message_vision("\e[2;37;0m\n$N口中喷出几口\e[1;31m鲜血\e[2;37;0m，倒在地上,死了！\n\n", arg1);
        }
        break;
    case "unconcious":
        if (random(20) > 10) {
            message_vision("\n$N脚下一个不稳，跌在地上一动也不动了。\n\n", arg1);
        } else {
            message_vision("\n$N突然觉得头晕目眩，跌在地上不省人事了。\n\n", arg1);
        }
        break;
    case "revive":
        if (random(20) > 10) {
            message_vision("\n$N慢慢睁开眼睛，清醒了过来。\n\n", arg1);
        } else {
            message_vision("\n慢慢的,$N又恢复了神智。\n\n", arg1);
        }
        if (sizeof(v1 = arg1->query_killer()) > 0) {
            for (v2 = 0; v2 < sizeof(v1); v2++) {
                if (objectp(v1[v2])) {
                    if (present(v1[v2], environment(arg1))) {
                        auto_fight(arg1, v1[v2], "hatred");
                        return;
                    }
                }
                break;
            }
        }
    }
}

void winner_reward(mixed arg1, mixed arg2) {
    arg1->defeated_enemy(arg2);
}

int die_for(mixed arg) {
    if (!userp(arg) && !(base_name(arg) == "/clone/user/user" && arg->query("lixian/biguan"))) {
        return 0;
    }
    arg->add("DIED", 1);
    arg->clear_condition();
    arg->add("shen", -arg->query("shen") / 10);
    arg->add("combat_exp", -arg->query("combat_exp") / 50);
    arg->add("xyzx_sys/levup_exp", -arg->query("xyzx_sys/levup_exp") / 50);
    if (arg->query("xyzx_sys/level") > 1) {
        if (arg->query("xyzx_sys/level") > 0 && arg->query("xyzx_sys/level") < 20) {
            arg->add("xyzx_sys/level", -1);
        } else {
            arg->add("xyzx_sys/level", -arg->query("xyzx_sys/level") / 20);
        }
    }
    arg->delete("vendetta");
    arg->delete("bellicosity");
    if (arg->query("thief")) {
        arg->set("thief", arg->query("thief") / 2);
    }
    if (arg->query("potential")) {
        arg->add("potential", -arg->query("potential") / 4);
    }
    arg->skill_death_penalty();
    if (stringp(arg->query_temp("die_for"))) {
        "/adm/daemons/channeld"->do_channel(this_object(), "rumor", sprintf("听说%s%s死了。", arg->name(1), arg->query_temp("die_for")));
        arg->delete_temp("die_for");
    } else {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", arg->name(1) + "死于" + environment(arg)->query("short") + "(" + file_name(environment(arg)) + ")\n");
        "/adm/daemons/channeld"->do_channel(this_object(), "rumor", sprintf("\e[1;37m听说%s死了，而且死的很离奇！\e[2;37;0m", arg->name(1)));
    }
}

void killer_reward(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v7;
    mixed v9;
    mixed v10;
    mixed v11;
    mixed v12;
    if (!arg1) {
        return;
    }
    arg1->killed_enemy(arg2);
    v4 = arg1->query("family/master_id");
    if (userp(arg2)) {
        if (wiz_level(arg1) > 1) {
            return;
        }
        if (arg2->is_att_killing(arg1)) {
            arg2->set_temp("die_for", "活腻而被" + arg1->query("name") + "杀");
            die_for(arg2);
            return;
        }
        if (userp(arg1)) {
            arg2->add("PKD", 1);
        }
        arg2->add("DIED", 1);
        arg2->clear_condition();
        arg2->add("shen", -arg2->query("shen") / 10);
        arg2->delete("vendetta");
        arg2->delete("bellicosity");
        if (arg2->query("thief")) {
            arg2->set("thief", arg2->query("thief") / 2);
        }
        if (!userp(arg1) && arg1->query("id") == "demogorgon" && arg2->query("age", 1) > 18) {
            arg2->add("combat_exp", -arg2->query("combat_exp") / 50);
            v2 = arg2->query_skill("literate", 1);
            if (v2 > 10) {
                arg2->set_skill("literate", v2 - 10);
            } else {
                if (arg2->query("potential")) {
                    arg2->add("potential", -(arg2->query("potential") / 2));
                }
                arg2->add("combat_exp", -arg2->query("combat_exp") / 20);
            }
        } else {
            arg2->skill_death_penalty();
            if (!(!arg2->query_condition("killer") && arg1->query_condition("killer") && userp(arg1))) {
                arg2->add("combat_exp", -arg2->query("combat_exp") / 20);
                arg2->add("xyzx_sys/levup_exp", -arg2->query("xyzx_sys/levup_exp") / 20);
                if (arg2->query("xyzx_sys/level") > 1) {
