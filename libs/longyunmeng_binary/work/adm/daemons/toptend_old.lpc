        break;
    case "exp":
        v1 = arg1->query("combat_exp");
        break;
    case "shen":
        v1 = -arg1->query("shen");
        break;
    case "force":
        v1 = arg1->query("max_neili");
        break;
    case "age":
        v1 = arg1->query("mud_age");
        break;
    case "per":
        if (arg1->query("gender") != "女性") {
            v1 = -1;
        } else {
            v1 = arg1->query_per();
        }
        break;
    default:
        v1 = -1;
    }
    return v1;
