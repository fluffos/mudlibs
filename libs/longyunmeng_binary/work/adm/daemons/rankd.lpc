string query_respect(mixed arg) {
    mixed v1;
    mixed v2;
    if (stringp(v2 = arg->query("rank_info/respect"))) {
        return v2;
    }
    v1 = arg->query("age");
    switch (arg->query("gender")) {
    case "女性":
        switch (arg->query("class")) {
        case "bonze":
            if (v1 < 18) {
                return "小师太";
            } else {
                return "师太";
            }
            break;
        case "taoist":
            if (v1 < 18) {
                return "小仙姑";
            } else {
                return "仙姑";
            }
            break;
        default:
            if (v1 < 18) {
                return "小姑娘";
            } else if (v1 < 50) {
                return "姑娘";
            } else {
                return "婆婆";
            }
            break;
        }
    case "男性":
    default:
        switch (arg->query("class")) {
        case "bonze":
            if (v1 < 18) {
                return "小师父";
            } else {
                return "大师";
            }
            break;
        case "taoist":
            if (v1 < 18) {
                return "道兄";
            } else {
                return "道长";
            }
            break;
        case "swordsman":
        case "fighter":
            if (v1 < 18) {
                return "小老弟";
            } else if (v1 < 50) {
                return "壮士";
            } else {
                return "老前辈";
            }
            break;
        default:
            if (v1 < 20) {
                return "小兄弟";
            } else if (v1 < 50) {
                return "壮士";
            } else {
                return "老爷子";
            }
            break;
        }
    }
}

