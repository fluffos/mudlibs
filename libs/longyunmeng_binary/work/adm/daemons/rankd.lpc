string query_close(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (objectp(arg1)) {
        if (!arg2) {
            v1 = this_player()->query("age");
        } else {
            v1 = arg1->query("age");
        }
        if (!arg2) {
            v2 = arg1->query("age");
        } else {
            v2 = arg2;
        }
    }
    if (!arg3) {
        v3 = arg1->query("gender");
    } else {
        v3 = arg3;
    }
    switch (v3) {
    case "女性":
        if (v1 > v2) {
            return "妹妹";
        } else {
            return "姐姐";
        }
        break;
    default:
        if (v1 > v2) {
            return "弟弟";
        } else {
            return "哥哥";
        }
    }
}

string query_self_close(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (objectp(arg1)) {
        if (!arg2) {
            v1 = this_player()->query("age");
        } else {
            v1 = arg1->query("age");
        }
        if (!arg2) {
            v2 = arg1->query("age");
        } else {
            v2 = arg2;
        }
    }
    if (arg2) {
        v3 = arg1->query("gender");
    } else {
        v3 = this_player()->query("gender");
    }
    switch (v3) {
    case "女性":
        if (v1 > v2) {
            return "姐姐我";
        } else {
            return "小妹我";
        }
        break;
    default:
        if (v1 > v2) {
            return "愚兄我";
        } else {
            return "小弟我";
        }
    }
}

varargs string new_short(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v2 = "";
    if (!objectp(arg)) {
        "/adm/daemons/channeld"->do_channel(this_player(), "chat", "object参数错误！");
        return "";
    }
    if (!arg->query_temp("apply/id") || !arg->query_temp("apply/name") || !arg->query_temp("apply/short")) {
        v3 = arg->query("name") + "(" + arg->query("id") + ")";
    } else {
        v3 = arg->query_temp("apply/name")[0] + "(" + arg->query_temp("apply/id")[0] + ")";
    }
    if (v1 = arg->query("icon")) {
        if (intp(v1)) {
            v2 = sprintf("%d", v1);
        } else if (stringp(v1)) {
            v2 = v1;
        } else {
            v2 = "00901";
        }
    } else if (userp(arg)) {
        v2 = arg->query("gender") == "男性" ? "1173" : "1174";
    } else if (living(arg)) {
        v2 = "00901";
    } else {
        v2 = "00961";
    }
    while (sizeof(v2) < 5) {
        v2 = "0" + v2;
    }
    return v3 + v2;
}

varargs string new_name(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v2 = "";
    if (!objectp(arg)) {
        "/adm/daemons/channeld"->do_channel(this_player(), "chat", "object参数错误！");
        return "";
    }
    if (arg->query_condition("killer")) {
        v3 = "$";
    } else if (arg->query_temp("netdead")) {
        v3 = "#";
    } else if (interactive(arg) && query_idle(arg) > 150) {
        v3 = "*";
    } else if (arg->query("lixian/biguan")) {
        v3 = "@";
    } else if (!arg->query("xieyi/zmud")) {
        v3 = "T";
    } else {
        v3 = " ";
    }
    if (arg->query("gender") == "女性") {
        v3 += "[女]";
    } else if (arg->query("gender") == "无性") {
        v3 += "[无]";
    } else {
        v3 += "[男]";
    }
    v3 += arg->query("name") + "(" + arg->query("id") + ")";
    if (v1 = arg->query("icon")) {
        if (intp(v1)) {
            v2 = sprintf("%d", v1);
        } else if (stringp(v1)) {
            v2 = v1;
        } else {
            v2 = "00901";
        }
    } else if (userp(arg)) {
        v2 = arg->query("gender") == "男性" ? "1173" : "1174";
    } else if (living(arg)) {
        v2 = "00901";
    } else {
        v2 = "00961";
    }
    while (sizeof(v2) < 5) {
        v2 = "0" + v2;
    }
    return v3 + v2;
}
