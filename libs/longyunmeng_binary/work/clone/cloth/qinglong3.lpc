// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// zixuan pifeng.c

#include <ansi.h>

inherit EQUIP;

void create()
{
set_name(HIG"青龙圣盔"NOR, ({ "qinglong shengkui", "qinglong","shengkui" }));
set_weight(2000);
if (clonep())
set_default_object(__FILE__);
else {
set("long", HIM"传说中的圣灵装备之"HIG"青龙盔"HIM"。\n");
set("material", "cloth");
set("armor_type", "head");
set("unit", "顶");
set("armor_prop/intelligence", 10);
set("value", 200000);
set("armor_prop/armor", 100);
}
setup();
}