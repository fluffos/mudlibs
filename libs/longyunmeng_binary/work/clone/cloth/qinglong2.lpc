// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// zixuan pifeng.c

#include <armor.h>
#include <ansi.h>

inherit BOOTS;

void create()
{
set_name(HIG"青龙圣靴"NOR, ({ "qinglong shengxue", "qinglong","shengxue" }));
set_weight(2000);
if (clonep())
set_default_object(__FILE__);
else {
set("long", HIM"传说中的圣灵装备之"HIG"青龙靴"HIM"。\n");
set("material", "leather");
set("unit", "双");
set("armor_prop/dexerity", 10);
set("armor_prop/dodge", 300);
set("value", 200000);
set("armor_prop/armor", 500);
}
setup();
}