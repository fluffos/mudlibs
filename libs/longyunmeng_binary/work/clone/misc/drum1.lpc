    } else if (!arg1 || !present(arg1, v2)) {
        v1 = arg2;
        message("vision", "\e[1;36m" + arg2->name() + "哈哈大笑几声，跳了下去。\n" + "\e" + "[2;37;0m", v2, ({ arg2 }));
    } else {
        tell_room(environment(), "\e[1m由于双方弃权,继续下一轮比赛。\n\e[2;37;0m");
    }
    if (v1) {
        v3 = query("arena");
        v3[v1] += 1;
        if (arg1) {
            arg1->move(environment());
        }
        if (arg2) {
            arg2->move(environment());
        }
        message_vision("\e[1;36m$N哈哈大笑，从擂台上跳了下来。\n\e[2;37;0m", v1);
        tell_room(environment(), "\e[1m这一回合的结果是：  " + v1->query("name") + " 胜。\n\e" + "[2;37;0m");
        recover(arg1);
        recover(arg2);
    }
