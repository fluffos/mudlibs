            call_out("checking", 2, arg1, arg2);
            return;
        }
    }
    if (!arg1 && !arg2) {
        tell_room(environment(), "\e[1m由于双方弃权,继续下一轮比赛。\n\e[2;37;0m");
    } else if (arg1 && (!arg2 || !present(arg2, v2))) {
        v1 = arg1;
