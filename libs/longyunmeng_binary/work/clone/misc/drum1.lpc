    call_out("start_fight", 5);
}

int att_fight(mixed arg1, mixed arg2) {
    mixed v1;
    if (!arg1 || !arg2) {
        remove_call_out("start_fight");
        call_out("start_fight", 5);
        return 1;
    }
    if (!(v1 = find_object("/d/huashan/lunjian1"))) {
        v1 = find_object("/d/huashan/lunjian1", 1);
    }
    if (present(arg1, v1) && present(arg2, v1)) {
        if (!arg1->is_killing(arg2) || !arg2->is_killing(arg1)) {
            if (query("time")) {
                tell_object(arg1, "\t\t\e[1;31m===" + "/adm/daemons/chinesed"->chinese_number(query("time")) + "===\n\n" + "\e" + "[2;37;0m");
                tell_object(arg2, "\t\t\e[1;31m===" + "/adm/daemons/chinesed"->chinese_number(query("time")) + "===\n\n" + "\e" + "[2;37;0m");
                add("time", -1);
                call_out("att_fight", 5, arg1, arg2);
                return 1;
            }
            tell_room(v1, "\e[1;33m\t-------  开     始  -------\n\n\e[2;37;0m");
            message_vision("\n$N对著$n喝道：「" + "/adm/daemons/rankd"->query_rude(arg2) + "！今日不是你死就是我活！」\n\n", arg1, arg2);
        }
        if (!arg1->is_killing(arg2)) {
            arg1->kill_ob(arg2);
        }
        if (!arg2->is_killing(arg1)) {
            arg2->kill_ob(arg1);
        }
    }
    remove_call_out("checking");
    call_out("checking", 2, arg1, arg2);
    return 1;
}

void recover(mixed arg) {
    if (!arg) {
        return;
    }
    if (!living(arg)) {
        arg->revive();
    }
    arg->set("eff_jing", arg->query("max_jing"));
    arg->set("jing", arg->query("max_jing"));
    arg->set("eff_qi", arg->query("max_qi"));
    arg->set("qi", arg->query("max_qi"));
    if (arg->query("neili") < arg->query("max_neili")) {
        arg->set("neili", arg->query("max_neili"));
    }
    if (arg->query("jingli") < arg->query("max_jingli")) {
        arg->set("jingli", arg->query("max_jingli"));
    }
    arg->set("food", arg->max_food_capacity());
    arg->set("water", arg->max_water_capacity());
    arg->clear_condition();
}

string clear_title(mixed arg) {
    if (!arg) {
        return "";
    }
    if (strsrch(arg, "本月少年组第一") >= 0 || strsrch(arg, "本月少年组第二") >= 0 || strsrch(arg, "本月少年组第三") >= 0) {
        arg = replace_string(arg, "\e[1;33m本月少年组第一\e[2;37;0m", "");
        arg = replace_string(arg, "\e[1;33m本月少年组第二\e[2;37;0m", "");
        arg = replace_string(arg, "\e[1;33m本月少年组第三\e[2;37;0m", "");
    }
    return arg;
}

void add_title(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = "\e[1;37m" + arg2 + "\e" + "[2;37;0m" + clear_title(arg1->query("title"));
    arg1->set("title", v1);
}

int give_money(mixed arg1, mixed arg2) {
    mixed v1;
    if (query("drum_knocked")) {
        message("vision", query("drum_knocked") + "笑嘻嘻地对大伙说到：哈哈，哈哈，多谢捧场！\n", environment());
        foreach (v1 in arg1) {
            if (v1 && !wizardp(v1) && environment() == environment(v1)) {
                clone_object("/clone/money/thousand-gold")->move(v1);
                clone_object("/clone/money/thousand-gold")->move(v1);
            }
        }
        message("vision", query("drum_knocked") + "给参赛的江湖人士每人二张金票：“小小意思，笑纳，笑纳。”\n", environment());
    }
    de_group(arg2);
    return 1;
}

