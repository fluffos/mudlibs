    if (!write_file(v1, "// This is a room made by roommaker.\n\ninherit ROOM;\n\nvoid create()\n{\n    set(\"short\", \"空房间\");\n    set(\"long\", \"这是一间什麽也没有的空房间。\\n\");\n    setup();\n}\n")) {
