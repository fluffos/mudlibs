// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// color_cloth.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name(MAG "粉"RED"红"BLU"披"HIW"风" NOR, ({ "color cloth", "cloth" }) );
	set_weight(1000);
	set("value", 5);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这件粉红色的披风上面绣著几只凤凰，煞是性感。\n");
		set("unit", "块");
		set("material", "cloth");
		set("armor_prop/constitution",20);
		set("armor_prop/personality", 200);
		set("female_only", 1);
	}
	setup();
}

int query_autoload() { return 1; }