            tell_object(this_player(), "你已经取下面具了!\n");
            return 1;
        }
        if (!(v1 = query("equipped_ob"))) {
            v1 = this_player();
        }
        v1->delete_temp("apply/name");
        v1->delete_temp("apply/id");
        v1->delete_temp("apply/short");
        v1->delete_temp("apply/long");
        if (arg == "cancel") {
            tell_object(v1, "人皮面具从你脸上滑落下来。\n");
        } else {
            message_vision("$N从脸上取下了一个人皮面具。\n", v1);
        }
        delete("equipped");
        delete("equipped_ob");
        return 1;
    }
    if (!objectp(v1 = present(arg, environment(this_player()))) || wiz_level(v1) > 1 || v1->query("apply/name") || !living(v1) || v1->query("race") != "人类") {
        return notify_fail("你想假装谁？\n");
    }
    if (v1 == this_player()) {
        return notify_fail("扮自己还用得着面具么？\n");
    }
    if (this_player()->query_temp("apply/name") == v1->name()) {
        tell_object(this_player(), "你已经带上面具了!\n");
        return 1;
    }
    write("你开始假装" + v1->name() + "。\n");
    message_vision("$N戴上了一个精功制成的人皮面具。\n", this_player());
    this_player()->set_temp("apply/name", ({ v1->name() }));
    this_player()->set_temp("apply/id", v1->parse_command_id_list());
    this_player()->set_temp("apply/short", ({ v1->short(1) }));
    this_player()->set_temp("apply/long", ({ v1->long() }));
    set("equipped", "mask");
    set("armor_type", "head");
    set("equipped_ob", this_player());
