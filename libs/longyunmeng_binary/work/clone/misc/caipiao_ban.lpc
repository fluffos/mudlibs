int do_duijiang() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v5;
    v5 = this_player();
    restore();
    if (!query("duijiang")) {
        return notify_fail("还未到兑奖时间！\n");
    }
    if (query_temp("busy")) {
        return notify_fail("稍候........\n");
    }
    set_temp("busy", 1);
    v2 = sizeof(all_biao);
    v3 = 0;
    while (v1 < v2) {
        if (all_biao[v1]["id"] == v5->query("id") && all_biao[v1]["jieguo"] != "无奖" && all_biao[v1]["name"] == v5->query("name")) {
            v3 = v1 + 1;
            break;
        }
        v1++;
    }
    delete_temp("busy");
    if (!v3) {
        return notify_fail("你并没有买彩票呀！\n");
    } else if (all_biao[v3 - 1]["jieguo"] == -1) {
        return notify_fail("你已经兑过奖了！\n");
    } else if (all_biao[v3 - 1]["jieguo"] == "无奖") {
        return notify_fail("你根本没中奖，来兑个屁！\n");
    } else {
        v5->set_temp("check", all_biao[v3 - 1]["z_num"] + " " + all_biao[v3 - 1]["t_num"]);
        v5->set_temp("num", v3 - 1);
        write("您的中奖号码是" + v5->query_temp("check") + "。\n");
        input_to("check", v5);
        return 1;
    }
    return 1;
}

