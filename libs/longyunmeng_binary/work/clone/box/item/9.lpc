// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// gangjian.c

#include <weapon.h>
inherit DAGGER;

void create()
{
	set_name("普通匕首", ({ "dagger", "bishou" }));
	set_weight(6000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把普通的小匕首。用来暗算别人比较合适。\n");
		set("value", 2000);
		set("material", "steel");
		set("wield_msg", "$N从兜里掏出一把$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n放会兜里。\n");
	}
	init_dagger(25,0);
	setup();
}
