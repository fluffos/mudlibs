// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// flower_leaf.c
 
#include <weapon.h>
 
inherit THROWING;
 
void create()
{
	set_name("花瓣", ({ "flower leaf", "hua ban", "ban" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "新鲜的玫瑰花的花瓣，上面还挂这晶莹的露珠。\n");
		set("unit", "把");
		set("value", 0);
		set("base_unit", "片");
		set("base_weight", 1);
		set("base_value", 0);
		set("damage", 2);	//Here the damage=int_throwing, added by King
	}
	set_amount(50);
	init_throwing(2);
	setup();
}
