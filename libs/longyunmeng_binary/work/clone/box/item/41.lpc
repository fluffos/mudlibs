#include <ansi.h>

inherit ITEM;

inherit F_FOOD;

void create()
{
    set_name(HIM"熊肉"NOR, ({"liewu8"}));
    set_weight(50000);
    set("long", "一块熊肉");
    set("unit", "块");

        set( "value", 800 + random( 600 ) );
        set( "food_remaining", 5 );
        set( "food_supply", 25 );
}

