varargs void update_age(mixed arg) {
    if (!environment()) {
        return;
    }
    if (!arg && environment()->query("freeze")) {
        last_age_set = time();
        return;
    }
    if (!last_age_set) {
        last_age_set = time();
    }
    add("mud_age", time() - last_age_set);
    last_age_set = time();
    set("age", query("age_modify") + 14 + query("mud_age") / 86400);
}

void setup() {
    update_age();
    ::setup();
    restore_autoload();
}

protected void user_dump(mixed arg) {
    switch (arg) {
    case 1:
        tell_room(environment(), query("name") + "断线超过 " + 15 + " 分钟，自动退出这个世界。\n");
        command("quit");
        break;
    case 2:
        if (wizardp(this_object()) || environment()->query("freeze")) {
            return;
        }
        tell_object(this_object(), "对不起，您已经发呆超过 " + 20 + " 分钟了，请下次再来。\n");
        tell_room(environment(), "一阵风吹来，将发呆中的" + query("name") + "化为一堆飞灰，消失了。\n", ({ this_object() }));
        command("quit");
        break;
    default:
        return;
    }
}

protected void net_dead() {
    mixed v1;
    if (objectp(v1 = query_temp("link_ob"))) {
        destruct(v1);
    }
    if (!environment()) {
        command("quit");
        return;
    }
    if (!this_object()->query("lixian/biguan")) {
        set_heart_beat(0);
    }
    remove_all_enemy();
    if (!this_object()->query("lixian/biguan")) {
        set_temp("netdead", 1);
    }
    if (userp(this_object())) {
        if (!this_object()->query("lixian/biguan")) {
            call_out("user_dump", 900, 1);
            tell_room(environment(), query("name") + "断线了。\n", this_object());
            environment()->set("channel_id", environment()->query("short"));
            "/adm/daemons/channeld"->do_channel(environment(), "sys", query("name") + "(" + capitalize(query("id")) + ")" + "断线了。");
        }
    }
}

void reconnect() {
    // a body taken over from another connection needs its commands back (KB 06 §7.108)
    enable_commands();
    set_heart_beat(1);
    if (!this_object()->query("lixian/biguan")) {
        set_temp("netdead", 0);
        remove_call_out("user_dump");
    }
    tell_object(this_object(), "重新连线完毕。\n");
}

void kick() {
    if (is_busy() || is_fighting()) {
        return;
    }
    command("quit");
}

int id(mixed arg) {
    mixed v1;
    if (geteuid() != arg) {
        return 0;
