void terminal_type(mixed arg) {
    set_temp("terminal_type", arg);
    message("system", "终端机型态设定为 " + arg + "。\n", this_object());
}

void reset() {
    if (query("thief") > 0) {
        add("thief", -1);
    }
}

string query_save_file() {
    mixed v1;
    v1 = geteuid();
    if (!v1) {
        v1 = getuid();
    }
    if (!stringp(v1)) {
        return 0;
