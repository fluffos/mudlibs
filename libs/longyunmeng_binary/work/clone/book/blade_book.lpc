inherit "/inherit/item/item";
void create();
void init();
int do_study(mixed);

void create() {
    set_name("胡家刀谱残篇", ({ "blade book", "book" }));
    set_weight(200);
    if (clonep()) {
        set_default_object("/clone/book/blade_book.lpc");
    } else {
        set("unit", "本");
        set("long", "这是一本胡家刀谱的几页残篇。\n");
        set("value", 500);
        set("material", "paper");
        set("skill", ([ "name" : "hujia-dao", "exp_required" : 1000, "jing_cost" : random(20) + 20, "difficulty" : 20, "min_skill" : 30, "max_skill" : 101 ]));
    }
}

int query_autoload() {
    return 1;
}

void init() {
    if (this_player() == environment()) {
        add_action("do_study", "study");
        add_action("do_study", "du");
    }
}

int do_study(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    v1 = v2->query_skill("hujia-dao", 1);
    if (v2->is_fighter()) {
        tell_object(v2, "战斗中无法阅读新知！\n");
        return 1;
    }
    if (v2->is_busy()) {
        tell_object(v2, "你现在正忙着呢。\n");
        return 1;
    }
    if (v1 >= 101) {
        tell_object(v2, "你仔细的研究了这本书，发现其中所述对你而言太浅了。\n");
        return 1;
    }
    if (v2->query_skill("blade", 1) < 350) {
        tell_object(v2, "你的基本刀法基础不够，还无法领悟胡家刀的精髓。\n");
        return 1;
    }
    if (v2->query("combat_exp") < v1 * v1 * v1 / 10) {
        write("你的实战经验不足，再怎么读也没用。\n");
        return 1;
    }
    if (v2->query("jing") < 20) {
        tell_object(v2, "你太累了，还是休息一下吧！\n");
        return 1;
    }
    v2->receive_damage("jing", 20);
    v2->improve_skill("hujia-dao", v2->query_skill("hujia-dao") + v2->query_int());
    message_vision("$N正在专心研读胡家刀法。\n", v2);
    return 1;
}
