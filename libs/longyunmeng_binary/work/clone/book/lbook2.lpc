// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// lbook2.c
#include <ansi.h>
inherit ITEM;
void create()
{
        set_name(YEL"百家姓"NOR, ({ "literateb2", "shu2", "book2" }));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);                                   
        else
        { 
               set("unit", "本");
                set("long","读书人必读的百家姓。\n");
                set("value", 100000); //原来是20 gold,mudos
                set("material", "paper");
                set("skill",
                ([
                        "name": "literate",      // name of the skill
                        "exp_required": 100,      // minimum combat experience required
                        "jing_cost":    10,      // jing cost every time study this
                        "difficulty":   15,      // the base int to learn this skill
                        "max_skill":    79,      // the maximum level you can learn
                        "min_skill":    50,      // minimun level required
                ]) );
        }
}
int query_autoload() { return 1; }