// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
// yunnandrug.c 云南白药

inherit ITEM;

void setup()
{}

void init()
{
   add_action("do_eat", "eat");
}

void create()
{
   set_name("云南白药", ({"yunnan baiyao", "baiyao", "yao","drug"}));
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "瓶");
     set("long", "这是一瓶贵重的云南白药，省着点用。\n");
     set("value", 5000);
     set("no_sell",1);
     set("drug_type", "良药");
   }
   set("is_monitored",1);
   setup();
}

int do_eat(string arg)
{
   if (!id(arg))
     return notify_fail("你要吃什么药？\n");
   if ((int)this_player()->query("eff_qi") == 
       (int)this_player()->query("max_qi"))
     return notify_fail("没病别乱吃药。\n");
   else {
     this_player()->receive_curing("qi", 50);
     message_vision("$N拿起瓶云南白药往嘴里一倒，胡乱咽了下去。\n", this_player());
     destruct(this_object());
     return 1;
   }
}

int query_autoload() { return 1; }