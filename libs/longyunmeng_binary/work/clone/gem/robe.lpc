// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_AUTOLOAD;

void create()
{
	set_name(HIC"魔法师袍"NOR, ({ "magic robe", "robe" }) );
	set("long", HIC"这是一件古怪的长袍，无论谁披上它都会有一种神奇的魔力附身。\n"NOR);
	set_weight(3000);
	set("unit", "件");
	set("value", 25000000);
	set("material", "cloth");
	set("armor_prop/armor", 600);
	set("armor_type", TYPE_CLOTH);
	set("no_put",1);
	set("no_pawn",1);
	set("no_beg",1);
	set("no_steal",1);
	set("buy_sell",1);
        set("no_clone",1);
	set("no_beg",1);
	set("no_steal",1);
        setup();
}

int query_autoload() { return 1; }
