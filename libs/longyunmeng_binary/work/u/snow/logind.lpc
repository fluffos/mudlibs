    } else if (arg1[0] == 110 || arg1[0] == 78) {
        Rname = random_name();
        write("您是否满意这个中文名字(\e[1;31my\e[2;37;0m/\e[1;33mn\e[2;37;0m)？");
        printf("\e[1;37m ──\e[2;37;0m\e[33m〖 \e[1;31m%s\e[2;37;0m\e[33m 〗\e[2;37;0m：\e[2;37;0m", Rname);
        input_to("get_resp", arg2);
        return;
    } else {
        write("对不起，您只能选择满意(\e[1;31my\e[2;37;0m)不满意(\e[1;33mn\e[2;37;0m)： ");
        input_to("get_resp", arg2);
        return;
    }
}

protected void get_name(mixed arg1, mixed arg2) {
    if (arg1 == "") {
        Rname = random_name();
        write("看来您要个随机产生的中文名字．．\n");
        write("请问您是否满意这个中文名字(\e[1;31my\e[2;37;0m/\e[1;33mn\e[2;37;0m)？");
        printf("\e[1;37m ──\e[2;37;0m\e[36m〖 \e[1;33m%s\e[2;37;0m\e[36m 〗\e[2;37;0m：\e[2;37;0m", Rname);
        input_to("get_resp", arg2);
    } else {
        if (!check_legal_name(arg1)) {
            write("请再次输入您的中文名字：");
            input_to("get_name", arg2);
            return;
        }
        printf("%O\n", arg2);
        arg2->set("name", arg1);
        write("请设定您的密码：");
        input_to("new_password", 1, arg2);
    }
}

protected void new_password(mixed arg1, mixed arg2) {
    write("\n");
    if (sizeof(arg1) < 5) {
        write("密码的长度至少要五个字符，请重设您的密码：");
        input_to("new_password", 1, arg2);
        return;
    }
    arg2->set("password", crypt(arg1, 0));
    write("请再输入一次您的密码，以确认您没记错：");
    input_to("confirm_password", 1, arg2);
}

protected void confirm_password(mixed arg1, mixed arg2) {
    mixed v1;
    write("\n");
    v1 = arg2->query("password");
    if (crypt(arg1, v1) != v1) {
        write("您两次输入的密码并不一样，请重新设定一次密码：");
        input_to("new_password", 1, arg2);
        return;
    }
    write("\n");
    write("\e[2;37;0m\e[35m※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※\n※                                                                    ※\n※  一个人物的天赋对于他或她所修习的武艺息息相关。「江湖风云录」中的  ※\n※  人物大多具有以下六项天赋,其中福缘与容貌是隐藏属性：               ※\n※                                                                    ※\n※\t①　膂力：影响攻击能力及负荷量的大小。                        ※\n※\t②　悟性：影响学习武功秘籍的速度及理解师傅的能力。            ※\n※\t③　根骨：影响体力恢复的速度及升级后所增加的体力。            ※\n※\t"
            "④　身法：影响防御及躲避的能力。                              ※\n※\t⑤　福缘：影响解迷、奇遇，拜师等运气方面。                    ※\n※　　　⑥  容貌：影响解密，拜师的条件以及玩家和NPC对你的印象。       ※\n※                                                                    ※\n※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※\n\e[2;37;0m");
    write("\n您可以输入 \e[1;31m(1-4)\e[2;37;0m 指定其中的一项值，或者输入 \e[1;31m0\e[2;37;0m 由系统随机选择。\n");
    write("您的选择是 (\e[36m0-4\e[2;37;0m)：");
    input_to("select_gift", arg2);
}

void get_gift(mixed arg1, mixed arg2, mixed arg3, mixed arg4) {
    if (arg1[0] != 121 && arg1[0] != 89) {
        random_gift(arg3, arg4);
        printf("\n膂力[%s]，悟性[%s]，根骨[%s]，身法[%s]\n", display_attr(arg3["str"]), display_attr(arg3["int"]), display_attr(arg3["con"]), display_attr(arg3["dex"]));
        write("您同意这一组天赋吗？");
        input_to("get_gift", arg2, arg3, arg4);
        return;
    }
    write("\n您的电子邮件地址：");
    input_to("get_email", arg2, arg3);
}

void select_gift(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = ([ ]);
    if (!sscanf(arg1, "%d", v1) || v1 < 0 || v1 > 4) {
        write("\n输入错误，请重新选择：");
        input_to("select_gift", arg2);
        return;
    }
    if (v1) {
        write("\n请输入您想要的数值(10-30)：");
        input_to("set_gift", arg2, v2, v1);
    } else {
        get_gift(" ", arg2, v2, v1);
    }
}

void set_gift(mixed arg1, mixed arg2, mixed arg3, mixed arg4) {
    mixed v1;
    if (!sscanf(arg1, "%d", v1) || v1 < 10 || v1 > 30) {
        write("\n数值错误，请重新输入：");
        input_to("set_gift", arg2, arg3, arg4);
        return;
    }
    switch (arg4) {
    case 1:
        arg3["str"] = v1;
        break;
    case 2:
        arg3["int"] = v1;
        break;
    case 3:
        arg3["con"] = v1;
        break;
    case 4:
        arg3["dex"] = v1;
    }
    get_gift(" ", arg2, arg3, arg4);
}

protected void get_email(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    write("\n");
    if (arg1 == "" || strsrch(arg1, "@") == -1 || sscanf(arg1, "%s@%s", v2, v3) != 2 || strsrch(v3, ".") == -1) {
        write("电子邮件地址需要是 id@address 的格式。\n");
        write("您的电子邮件地址：");
        input_to("get_email", arg2, arg3);
        return;
    }
    arg2->set("email", arg1);
    arg2->set("registered", 1);
    arg2->set("body", "/clone/user/user");
    if (!objectp(v1 = make_body(arg2))) {
        return;
    }
    v1->set("str", arg3["str"]);
    v1->set("dex", arg3["dex"]);
    v1->set("con", arg3["con"]);
    v1->set("int", arg3["int"]);
    v1->set("kar", arg3["kar"]);
    v1->set("per", arg3["per"]);
    arg2->set("registered", 1);
    v1->set("registered", 1);
    write("您要扮演男性(\e[1;32mm\e[2;37;0m)的角色或女性(\e[1;35mf\e[2;37;0m)的角色？");
    input_to("get_gender", arg2, v1);
}

protected void get_gender(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    write("\n");
    if (arg1 == "") {
        write("您要扮演男性(\e[1;32mm\e[2;37;0m)的角色或女性(\e[1;35mf\e[2;37;0m)的角色？");
        input_to("get_gender", arg2, arg3);
        return;
    }
    if (arg1[0] == 109 || arg1[0] == 77) {
        arg3->set("gender", "男性");
    } else if (arg1[0] == 102 || arg1[0] == 70) {
        arg3->set("gender", "女性");
    } else {
        write("对不起，您只能选择男性(\e[1;32mm\e[2;37;0m)或女性(\e[1;35mf\e[2;37;0m)的角色：");
        input_to("get_gender", arg2, arg3);
        return;
    }
    log_file("login/newid.log", sprintf("%-12s was created from %-20s (%s)\n", arg3->query("id"), query_ip_number(arg2), ctime(time())));
    "/adm/daemons/channeld"->do_channel(this_object(), "sys", "又有一个新玩家：" + arg3->query("name") + "[" + arg3->query("id") + "]。\e" + "[2;37;0m");
    init_new_player(arg3);
    enter_world(arg2, arg3);
    v2 = read_file("/u/snow/iduser", 1);
    v1 = atoi(v2);
    v1 = v1 + 1;
    v2 = sprintf("%d", v1);
    write_file("/u/snow/iduser", v2, 1);
    write("\n");
}

object make_body(mixed arg) {
    mixed v1;
    mixed v2;
    if (stringp(arg->query("body"))) {
        v2 = clone_object(arg->query("body"));
    } else {
        return 0;
    }
    if (!v2) {
        write("现在可能有人正在修改使用者物件的程式，无法进行复制。\n");
        write(v1 + "\n");
        return 0;
    }
    seteuid(arg->query("id"));
    export_uid(v2);
    export_uid(arg);
    seteuid(getuid());
    v2->set("id", arg->query("id"));
    v2->set_name(arg->query("name"), ({ arg->query("id") }));
    return v2;
}

protected void init_new_player(mixed arg) {
    arg->set("title", "普通百姓");
    arg->set("birthday", time());
    arg->set("potential", 100);
    arg->set("channels", ({ "es", "chat", "rumor", "tell", "new", "jh" }));
    if (arg->query("gender") == "女性") {
        arg->set("combat_exp", 50);
        arg->set("money", 2000);
    }
}

protected void have_mail() {
    write("\e[1m\n杜宽(Post officer)告诉你：有您的信！请到驿站来一趟...\n\n\e[2;37;0m");
}

varargs void enter_world(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    v6 = random(4);
    arg2->set_temp("link_ob", arg1);
    arg1->set_temp("body_ob", arg2);
    arg2->set("registered", arg1->query("registered"));
    exec(arg2, arg1);
    arg2->setup();
    if (arg1->query("age") == 14) {
        arg2->set("food", arg2->max_food_capacity());
        arg2->set("water", arg2->max_water_capacity());
    }
    arg2->save();
    arg1->save();
    if (!arg2->over_encumbranced()) {
        if (arg2->query("gender") == "女性") {
            v1 = clone_object("/clone/misc/pink_cloth");
        } else {
            v1 = clone_object("/clone/cloth/cloth");
        }
        v1->move(arg2);
        v1->wear();
        if (arg2->query("age") < 18) {
            v1 = clone_object("/clone/misc/site");
            v1->move(arg2);
        }
    }
    if (!arg3) {
        cat("/adm/etc/motd");
        v5 = clone_object("/clone/user/login");
        v5->set("id", arg2->query("id"));
        v5->restore();
        write("★ 您目前权限：" + wizhood(arg2) + "\n");
        write("★ 您上次光临江湖风云是从：" + v5->query("last_from") + "\n");
        write("★ 您上次连线的时间是：" + ctime(v5->query("last_on")) + "\n\n");
        v3 = arg2->query("id");
        v4 = "/data/mail/" + v3[0..0] + "/" + v3 + ".o";
        if (file_size(v4) && arg2->query("new_mail") < file_size(v4)) {
            call_out("have_mail", 3);
        }
        if (arg2->is_ghost()) {
            v2 = "/d/death/gate";
        } else {
            if (!stringp(v2 = arg2->query("startroom"))) {
                v2 = start_room[v6];
            }
            if (v2 == "/d/death/gate") {
                v2 = start_room[v6];
            }
        }
        if (file_size(v2 + ".lpc") > 0 && !catch {
    find_object(v2, 1);
}) {
            arg2->move(v2);
        } else {
            arg2->move(start_room[v6]);
            v2 = start_room[v6];
            arg2->set("startroom", start_room[v6]);
        }
        tell_room(v2, arg2->query("name") + "连线进入这个世界。\n", ({ arg2 }));
    }
    write("\e[1;37m你连线进入这个世界，开始了自己的\e[1;32m江湖\e[1;37m生涯\n\e[2;37;0m");
    if (arg1->query_temp("no_allow_ip")) {
        write("\n\n警告：你未设定自己的登录地址范围。请用\e[1;31m allowip \e[2;37;0m指令设置。\n\n");
    }
    if (file_size("/log/login/notice") > 0) {
        write("\e[1;32m     ～～～～～～～～～～～～～～～～～～～～～～～～～～～～～～～～\n\e[2;37;0m");
        write(read_file("/log/login/notice"));
        write("\e[1;32m     ～～～～～～～～～～～～～～～～～～～～～～～～～～～～～～～～\n\n\e[2;37;0m");
    }
    if (arg2->query("gender") == "男性" && arg2->query("age") <= 25) {
        switch (random(2)) {
        case 0:
            v4 = "少年侠士";
            break;
        case 1:
            v4 = "/adm/daemons/rankd"->query_respect(arg2);
            break;
        }
    } else if (arg2->query("gender") == "女性" && arg2->query("age") <= 25) {
        switch (random(2)) {
        case 0:
            v4 = "妙龄少女";
            break;
        case 1:
            v4 = "/adm/daemons/rankd"->query_respect(arg2);
            break;
        }
    } else {
        v4 = "/adm/daemons/rankd"->query_respect(arg2);
    }
    if (!(wizardp(arg2) && arg2->query("env/no_login_msg"))) {
        message("channel:chat", "\e[1;31m〖有间客栈〗\e[2;37;0m: \e[1;36m听说又来了一位叫做\e[1;37m" + arg2->name() + "\e" + "[1;36m的" + v4 + "\n\e" + "[2;37;0m", users());
    }
    if (arg2->query("id") != "snow") {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("%s(%s)由%s连线进入。", arg2->name(), arg2->query("id"), query_ip_name(arg2)));
    }
    "/adm/daemons/updated"->check_user(arg2);
    "/adm/daemons/statud"->compare_status(arg2);
    arg2->set_temp("temp_exp", arg2->query("combat_exp"));
    arg2->set_temp("temp_time", time());
}

varargs void reconnect(mixed arg1, mixed arg2, mixed arg3) {
    arg2->set_temp("link_ob", arg1);
    arg1->set_temp("body_ob", arg2);
    exec(arg2, arg1);
    arg2->reconnect();
    if (!arg3) {
        tell_room(environment(arg2), arg2->query("name") + "\e" + "[33m重新连线回到这个世界。\n\e" + "[2;37;0m", ({ arg2 }));
    }
    if (arg2->query("id") != "snow") {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("%s(%s)由(%s)重新连线进入。", arg2->query("name"), arg2->query("id"), query_ip_number(arg2)));
    }
    "/adm/daemons/updated"->check_user(arg2);
}

int check_legal_id(mixed arg) {
    mixed v1;
    v1 = sizeof(arg);
    if (sizeof(arg) < 3 || sizeof(arg) > 14) {
        write("对不起，你的\e[1;37m英文\e[2;37;0m名字必须是 3 到 10 个英文字母。\n");
        return 0;
    }
    while (v1--) {
        if (arg[v1] < 97 || arg[v1] > 122) {
            write("对不起，你的\e[1;37m英文\e[2;37;0m名字只能用英文字母。\n");
            return 0;
        }
    }
    return 1;
}

