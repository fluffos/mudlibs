inherit ROOM;

void create()
{
	set("short", "小路");
	set("long", @LONG
一条小路向东南延伸，四周尽是花香鸟语，空气顿时清新了许
多。前面有一座小小的山冈。
LONG
	);
        set("outdoors", "wudujiao");

	set("exits", ([
		"northwest" : __DIR__"road3",
		"southup" : __DIR__"shanlu2",
//		"west" : __DIR__"wumiao",
//		"north" : __DIR__"road3",
	]));
        set("objects", ([
                "/d/wudang/npc/yetu": 3,
	]));

	setup();
	replace_program(ROOM);
}

