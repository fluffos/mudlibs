// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#include <ansi.h>

inherit ITEM;

void setup()
{}

void create()
{
	       set_name(HIC"龙涎香"NOR, ({"longxian xiang","xiang" }));
	
		set("unit", "块");
		set("long", "这是一块黑红色的东西，散发出奇异香气,据说可以吸引毒虫。\n");
		set("value", 500);
//            set("no_drop", "这样东西不能离开你。\n");
              set_weight(50);

	
	setup();
}

