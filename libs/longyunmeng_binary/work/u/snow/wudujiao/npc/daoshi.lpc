void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    switch (random(3)) {
    case 0:
        say("游方道人嘿嘿一阵奸笑道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，也是来住店的吗？\n");
        break;
