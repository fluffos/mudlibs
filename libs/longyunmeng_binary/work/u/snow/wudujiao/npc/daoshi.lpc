    case 2:
        say("游方道人面现惊讶之色道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "眉现黑气，近日会有大难。\n贫道有一些随身丹丸可以卖给你，或许可救你一命。\n");
        break;
    }
}

void attempt_apprentice(mixed arg) {
    if (arg->query("gender") == "无性") {
        command("say 这位公公不要开玩笑了。");
        command("say 这位" + "/adm/daemons/rankd"->query_respect(arg) + "还是快去伺候皇上吧！");
        return;
    }
    if (arg->query("shen") > 1000) {
        command("say 做我五毒教弟子必须心狠手辣。");
        command("say 我教弟子贵在随心所欲，不收伪君子");
        return;
    }
    command("recruit " + arg->query("id"));
    arg->set("class", "none");
    arg->set("title", "\e[1;33m五毒教徒\e[2;37;0m");
    return;
}

