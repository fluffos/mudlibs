void attempt_apprentice(mixed arg) {
    if (arg->query("gender") == "无性") {
        command("say 这位公公不要开玩笑了。");
        command("say 这位" + "/adm/daemons/rankd"->query_respect(arg) + "还是快去伺候皇上吧！");
        return;
    }
    if (arg->query("shen") > -5000) {
        command("say 做我五毒教弟子必须心狠手辣。");
        command("say 这位" + "/adm/daemons/rankd"->query_respect(arg) + "心慈手软，可惜与我教没有缘分啊！");
        return;
    }
    if (arg->query("family/family_name") != "五毒教") {
        command("say 这位" + "/adm/daemons/rankd"->query_respect(arg) + "不是本教弟子，还是请回吧！");
        return;
    }
    if (arg->query_skill("duji", 1) < 60) {
        command("say 我五毒教弟子以毒杀人，修习毒技是首要的。");
        command("say 这位" + "/adm/daemons/rankd"->query_respect(arg) + "是否还应该多多钻研本门的绝学？");
        return;
    }
    if (arg->query_skill("wudu-shengong", 1) < 60) {
        command("say 你的五毒神功还学的不够啊。");
        return;
    }
    command("recruit " + arg->query("id"));
    arg->set("class", "none");
    arg->set("title", "\e[1;33m五毒教弟子\e[2;37;0m");
    return;
}
