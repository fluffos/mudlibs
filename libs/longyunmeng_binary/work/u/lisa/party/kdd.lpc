// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
// team.c

#include <ansi.h>

inherit F_CLEAN_UP;
object find_player(string target)
{
      int i;
        object *objs;
        objs=users();
        for (i=0;i<sizeof(objs);i++)
                if (objs[i]->query("id")==target && interactive(objs[i]) && environment(objs[i]))
                        return objs[i];
        return 0;
}

int main(object me, string arg)
{
	object obj;
	if(!arg || !obj = find_player(arg))
	{
		return notify_fail("你要从你的帮派中开除谁？\n");
	}
	if (!me->query("bangzhu"))
	{
		return notify_fail("你并非一帮之主。\n");
	}
	if (!obj->query("partyid") || obj->query("partyid")!=me->query("partyid"))
	{
		return notify_fail("他并非你帮的成员!\n");
	}
	obj->delete("partyid");
	tell_object(me,"你将"+obj->query("name")+"("+obj->query("id")+")从你的帮中开除了！\n");
	tell_object(obj,me->query("name")+"("+me->query("id")+")将你从"+me->query("partyname")+"帮中开除了！\n");
	CHANNEL_D->do_channel(me, "xyxw",obj->query("name")+"("+obj->query("id")+")从此与"+me->query("partyname")+"帮毫无关系!\n");

	return 1;
}

int help(object me)
{
	write( @HELP
kdd id

	这个命令可以让你开除你帮中的成员。
注：你必须为该帮派的帮主。且该成员必须在线。
HELP
   );
   return 1;
}