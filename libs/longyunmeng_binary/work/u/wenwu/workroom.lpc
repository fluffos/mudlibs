// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
inherit ROOM;

void create()
	{
		set("short","云梦工作室");
		set("long","　这是没有建造工作室的巫师的临时住处，这里的设备非常简单，只有\n一些常用物品。"+
			HIY"\n[IP地址查询定位]："+
			HIW"\n-------------------------------------------------------------"+
			HIG"\nhttp://www.linkwan.com/gb/broadmeter/VisitorInfo/QureyIP.asp"+
			HIW"\n-------------------------------------------------------------\n"NOR);
		set("exits",([
			"gc":"/d/city/guangchang",
			"up":"d/wizard/snow_room",
			]));
		set("objects", ([
			"/kungfu/class/wizroom/lisa" : 1,                     	
			"/kungfu/class/wizroom/wenwu" : 1,                       	
			"/kungfu/class/wizroom/mishu" : 1,                              	
			"/clone/misc/bangong" : 1,
			]));
		set("valid_startroom", 1);     	
		set("no_fight", "1");
        set("no_clean_up", 0);
        setup();
		}
void init()
	{
		add_action("do_kill","kill");
	}
int do_kill()
    {
       message_vision("$N脸色一沉，全身散发出一股浓烈的杀气，\n",this_player());
       return 0;
    }
int valid_leave(object me, string dir)
	{
		if( dir=="up" && !wizardp(me) )
			return notify_fail("那里只有巫师才能进去。\n");
		return ::valid_leave(me, dir);
	}

