int exercising(mixed);
int halt_exercise(mixed);
int main(mixed, mixed);
int help(mixed);

int main(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    seteuid(getuid());
    v2 = environment(arg1);
    if (arg1->query_skill("force", 1) < 10) {
        return notify_fail("你还是先学些呼吸心法的技巧！\n");
    }
    if (v2->query("pigging")) {
        return notify_fail("你还是专心拱猪吧！\n");
    }
    if (arg1->is_busy() || arg1->query_temp("pending/exercising")) {
        return notify_fail("你现在正忙着呢。\n");
    }
    if (environment(arg1)->query("no_fight")) {
        return notify_fail("这里是是非之地，不可久留，别练功了，快走吧！\n");
    }
    if (arg1->is_fighting()) {
        return notify_fail("战斗中不能练内功，会走火入魔。\n");
    }
    if (!arg2 || !sscanf(arg2, "%d", v1)) {
        return notify_fail("你要花多少气练功？\n");
    }
    if (v1 < 10) {
        return notify_fail("你的内功还没有达到那个境界！\n");
    }
    if (arg1->query("qi") < v1) {
        return notify_fail("你现在的气太少了，无法产生内息运行全身经脉。\n");
    }
    if (arg1->query("jing") * 100 / arg1->query("max_jing") < 70) {
        return notify_fail("你现在精不够，无法控制内息的流动！\n");
    }
    write("\e[1;31m你坐下来运气用功，一股\e[1;37m内息\e[1;31m开始在体内流动。\n\e[2;37;0m");
    arg1->set_temp("pending/exercise", 1);
    arg1->set_temp("exercise_cost", v1);
    message("vision", arg1->name() + "盘膝坐下，开始修炼内力。\n", environment(arg1), ({ arg1 }));
    arg1->start_busy((: exercising :), (: halt_exercise :));
    return 1;
}

int exercising(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = arg->query_temp("exercise_cost");
    v2 = arg->query_skill("force", 1) * 2;
    v3 = environment(arg);
    if (!interactive(arg)) {
        return 0;
    }
    if (v1 < 1) {
        return 0;
    }
    if (v1 < v2) {
        v2 = v1;
    }
    if (v1 > v2 * 2) {
        v2 = v1 / 2;
    }
    arg->add("neili", v2);
    arg->set_temp("exercise_cost", v1 -= v2);
    if (v3->query("xuanbing")) {
        arg->add("qi", v2 / 3);
    }
    if (v3->query("hanyuchuang")) {
        arg->add("qi", v2 / 2);
    }
    arg->add("qi", -v2);
    if (v1 > 0) {
        return 1;
    }
    arg->set_temp("pending/exercise", 0);
    message_vision("\e[1;33m$N运功完毕，深深吸了口气，站了起来。\n\e[2;37;0m", arg);
    if (arg->query("neili") < arg->query("max_neili") * 2) {
        return 0;
    } else if (arg->query("max_neili") > (arg->query_skill("force", 1) + arg->query_skill("force") / 5) * 10) {
        write("你的内力修为似乎已经达到了瓶颈。\n");
        arg->set("neili", arg->query("max_neili") * 2);
        return 0;
    } else if (arg->query_skill("linji-zhuang", 1) == 100 && arg->query("max_neili") == 500) {
        arg->add("max_neili", 100);
        arg->set("neili", arg->query("max_neili"));
        write("你只觉丹田处一股热流涌向全身，有着说不出来舒服得感觉。不知不觉中你已经练成了临济十二庄的天字庄。");
        return 0;
    } else if (arg->query_skill("linji-zhuang", 1) == 300 && arg->query("max_neili") == 1000) {
        arg->add("max_neili", 200);
        arg->set("neili", arg->query("max_neili"));
        write("你只觉你的内息游遍了你全身，仿佛容入了天地之间，你已经融会贯通了临济十二庄的地字庄，已经可以(yun tiandi)了。");
        return 0;
    } else {
        arg->add("max_neili", 1);
        arg->set("neili", arg->query("max_neili"));
        write("\e[1;37m你的内力增加了！！\n\e[2;37;0m");
        return 0;
    }
}

int halt_exercise(mixed arg) {
    if (arg->query("neili") > arg->query("max_neili") * 2) {
        arg->set("neili", arg->query("max_neili") * 2);
    }
    arg->set_temp("pending/exercise", 0);
    return 1;
}

int help(mixed arg) {
    write("指令格式 : exercise [<耗费「气」的量> 必须多于 10]\n运气练功，控制体内的气在各经脉间流动，藉以训练人体肌肉骨骼的耐\n力、爆发力，并且用内力的形式将能量储备下来。\n");
    return 1;
}
