                if (arg1->query_skill(v1, 1) > 100 && arg1->query_skill(v1, 1) < arg1->query_skill("force", 1)) {
                    arg1->improve_skill(v1, random(arg1->query_con()) + 1, 0);
                } else {
                    arg1->improve_skill(v1, random(arg1->query_con()) + 1, 1);
