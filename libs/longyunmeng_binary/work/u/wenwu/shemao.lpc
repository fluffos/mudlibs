// 本文件源码取自同一游戏的源码版（033-2 longyunmeng），用 v22pre11 编译器重新编译，与本版的 .b 二进制完全一致。
// Source taken from the source edition of this game (033-2); it compiles to the same program as this edition's .b binary.
#include <weapon.h>

inherit CLUB;

void create()
{
set_name(HIY"丈八蛇矛"NOR, ({ "zhangba shemao","shemao","gun" }) );	
        set_weight(1500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
set("long", "三国九大神器之一,张翼德心爱兵器。\n");	
                set("value", 100);
                set("material", "iron");
set("wield_msg", HIY"$N抽出一柄$n，"HIY"顿觉雄心万丈,大有取敌首于百万军之气概。\n"NOR);      	
set("unwield_msg", HIG"$N放下手中的$n,"HIG"磅礴杀气逐渐平复下来。\n"NOR);  	
        }

init_club(500);	
        setup();
}
mixed hit_ob(object me, object victim)	
{
return HIY"力道一波大于一波,宛如神将张飞临世,周围激起阵阵气浪！\n" NOR; 	
}
int query_autoload() { return 1; }
