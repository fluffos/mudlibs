int do_bet(mixed arg) {
    mixed v1;
    if (Playing) {
        if (!arg) {
            if (BetAmount <= 0) {
                command("say 目前这场比赛并未设定赌注，纯切磋牌技。");
            }
        } else {
            command("say 牌局开始之后就不能换赌注金额了。");
        }
        return 1;
    }
    if (!arg) {
        if (BetAmount <= 0) {
            command("say 目前并未设定赌注，纯练功夫。");
        }
        return 1;
    }
    if (sscanf(arg, "%d", v1) != 1) {
        write("设定赌注方法为: bet <金额> , 若纯娱乐请用 bet 0\n");
        return 1;
    }
    if (v1 < 0) {
        return 1;
    }
    if (v1 > 10000) {
        return 1;
    }
    if (Play > 0) {
        command("say 要设定赌注必须在还没有人加入牌桌(addin)前设定。");
        return 1;
    }
    BetAmount = v1;
    return 1;
}

