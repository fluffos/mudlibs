        v3 += arg1[v1..v1 + 1];
    }
    return v3;
}

string sort_data(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    v1 = sizeof(arg);
    v6 = "";
    v7 = "";
    for (v2 = -1; v2 < v1; v2++) {
        v2++;
        for (v3 = v2 + 2; v3 < v1; v3++) {
            v3++;
            v4 = do_check_num(arg[v2..v2 + 1], 1);
            v5 = do_check_num(arg[v3 - 1..v3], 1);
            if (v4 < v5) {
                v7 = arg[v2..v2 + 1];
                arg[v2..v2 + 1] = arg[v3 - 1..v3];
                arg[v3 - 1..v3] = v7;
            }
        }
    }
    return arg;
}

int do_look(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    mixed v9;
    mixed v10;
    v3 = this_player();
    v4 = "";
    v5 = "";
    v6 = "";
    v7 = "";
    v8 = "";
    v9 = query_verb();
    if (v9 == ".") {
        arg = "mj";
    }
    if (v9 == "..") {
        arg = "chicken";
    }
    if (v9 == ".1") {
        arg = "1p";
    }
    if (v9 == ".2") {
        arg = "2p";
    }
    if (v9 == ".3") {
        arg = "3p";
    }
    if (v9 == ".4") {
        arg = "4p";
    }
    if (v9 == ".0") {
        arg = "all";
    }
    if (v3->query("id") == P1Data["Id"]) {
        v10 = P1Data;
    } else if (v3->query("id") == P2Data["Id"]) {
        v10 = P2Data;
    } else if (v3->query("id") == P3Data["Id"]) {
        v10 = P3Data;
    } else if (v3->query("id") == P4Data["Id"]) {
        v10 = P4Data;
    } else if (arg == "mj") {
        if (!Playing) {
            write("牌局还没开始!!\n");
            return 1;
        }
        v1 = 5;
        v4 += "东家:" + NowPlayerId[0] + "\t 南家:" + NowPlayerId[1] + "\t 西家:" + NowPlayerId[2] + "\t 北家:" + NowPlayerId[3] + "\n";
        v4 += P1Data["Id"] + ":摆在外面的牌有:\n";
        v4 += show_mj(P1Data["Out"] + P1Data["OutPon"] + P1Data["OutFlower"], v1 + 1);
        v4 += P2Data["Id"] + ":摆在外面的牌有:\n";
        v4 += show_mj(P2Data["Out"] + P2Data["OutPon"] + P2Data["OutFlower"], v1 + 1);
        v4 += P3Data["Id"] + ":摆在外面的牌有:\n";
        v4 += show_mj(P3Data["Out"] + P3Data["OutPon"] + P3Data["OutFlower"], v1 + 1);
        v4 += P4Data["Id"] + ":摆在外面的牌有:\n";
        v4 += show_mj(P4Data["Out"] + P4Data["OutPon"] + P4Data["OutFlower"], v1 + 1);
        v4 += P1Data["Id"] + ":打过的牌有:";
        v4 += show_mj(P1Data["Dump"], 2) + "\n";
        v4 += P2Data["Id"] + ":打过的牌有:";
        v4 += show_mj(P2Data["Dump"], 2) + "\n";
        v4 += P3Data["Id"] + ":打过的牌有:";
        v4 += show_mj(P3Data["Dump"], 2) + "\n";
        v4 += P4Data["Id"] + ":打过的牌有:";
        v4 += show_mj(P4Data["Dump"], 2) + "\n";
        write(v4);
        return 1;
    } else {
        return 0;
    }
    if (v10["Auto"] == "auto") {
        v2 = 1;
    }
    if (!(arg == "1p" || arg == "2p" || arg == "3p" || arg == "4p" || arg == "all" || arg == "chicken" || arg == "end" || arg == "dump" || arg == "mj")) {
        return 0;
    }
    if (arg == "1p") {
        v10 = P1Data;
    }
    if (arg == "2p") {
        v10 = P2Data;
    }
    if (arg == "3p") {
        v10 = P3Data;
    }
    if (arg == "4p") {
        v10 = P4Data;
    }
    if (arg == "1p" || arg == "2p" || arg == "3p" || arg == "4p") {
        v1 = 0;
        if (v10["Show"] == "代码") {
            v1 = 3;
        }
        if (v10["Show"] == "color") {
            v1 = 5;
        }
        if (!Playing || check_id(v3->query("id"), "player") == "" || v2 == 1) {
            if (v10["OutGon"] != "") {
                v4 += v10["Id"] + ":暗杠的牌有:\n";
                v4 += show_mj(v10["OutGon"], v1 + 1);
            }
            v4 += v10["Id"] + ":手中的牌有:\n";
            v4 += show_mj(v10["Mj"], v1);
        }
        v4 += v10["Id"] + ":摆在外面的牌有:\n";
        v4 += show_mj(v10["Out"] + v10["OutPon"] + v10["OutFlower"], v1 + 1);
        v4 += v10["Id"] + ":打过的牌:\n";
        v4 += show_mj(v10["Dump"], 2);
    } else if (arg == "mj") {
        if (!Playing) {
            return 0;
        }
        if (v10["OutGon"] != "") {
            v4 += "你的暗杠的牌有:\n";
            v4 += show_mj(v10["OutGon"], 1);
        }
        if (v10["Show"] == "代码") {
            v1 = 3;
        }
        if (v10["Show"] == "color") {
            v1 = 5;
        }
        v4 += "你摆在外面的牌有:\n";
        v4 += show_mj(v10["Out"] + v10["OutPon"] + v10["OutFlower"], v1 + 1);
        v4 += "你手中的牌有:\n";
        v4 += show_mj(v10["Mj"], v1);
        v4 += "你的设定有:";
    } else if (arg == "all") {
        v1 = 0;
        if (v10["Show"] == "代码") {
            v1 = 3;
        }
        if (v10["Show"] == "color") {
            v1 = 5;
        }
        v4 += show_site(v10["Id"]);
        v4 += P1Data["Id"] + ":摆在外面的牌有:\n";
        v4 += show_mj(P1Data["Out"] + P1Data["OutPon"] + P1Data["OutFlower"], v1 + 1);
        v4 += P1Data["Id"] + ":打过的牌有:\n";
        v4 += show_mj(P1Data["Dump"], 2) + "\n";
        v4 += P2Data["Id"] + ":摆在外面的牌有:\n";
        v4 += show_mj(P2Data["Out"] + P2Data["OutPon"] + P2Data["OutFlower"], v1 + 1);
        v4 += P2Data["Id"] + ":打过的牌有:\n";
        v4 += show_mj(P2Data["Dump"], 2) + "\n";
        v4 += P3Data["Id"] + ":摆在外面的牌有:\n";
        v4 += show_mj(P3Data["Out"] + P3Data["OutPon"] + P3Data["OutFlower"], v1 + 1);
        v4 += P3Data["Id"] + ":打过的牌有:\n";
        v4 += show_mj(P3Data["Dump"], 2) + "\n";
        v4 += P4Data["Id"] + ":摆在外面的牌有:\n";
        v4 += show_mj(P4Data["Out"] + P4Data["OutPon"] + P4Data["OutFlower"], v1 + 1);
        v4 += P4Data["Id"] + ":打过的牌有:\n";
        v4 += show_mj(P4Data["Dump"], 2) + "\n";
    } else if (arg == "chicken") {
        if (Playing) {
            v4 = LookP + "正认真的在打牌\n";
            v4 += "还剩下" + sprintf("%d", (end - count - 16 - Goned) / 2) + "只牌就流局了。\n";
            if (LastDump != "") {
                v4 += LastDumpId + "刚刚打出了" + show_mj(LastDump, 2) + "\n";
            }
            v4 += "庄家: " + NowPlayerId[0];
            if (Count) {
                v4 += "[连庄" + chinese_number(Count) + "]\n";
            } else {
                v4 += "\n";
            }
            v5 = show_mj(P1Data["Out"] + P1Data["OutPon"] + P1Data["OutFlower"], 2);
            v6 = show_mj(P2Data["Out"] + P2Data["OutPon"] + P2Data["OutFlower"], 2);
            v7 = show_mj(P3Data["Out"] + P3Data["OutPon"] + P3Data["OutFlower"], 2);
            v8 = show_mj(P4Data["Out"] + P4Data["OutPon"] + P4Data["OutFlower"], 2);
            if (!NowPlayer) {
                v4 += "\e[1;33m";
            }
            v4 += "东家[" + NowPlayerId[0] + "]:" + "\e" + "[2;37;0m" + v5 + "\n";
            if (NowPlayer == 1) {
                v4 += "\e[1;33m";
            }
            v4 += "南家[" + NowPlayerId[1] + "]:" + "\e" + "[2;37;0m" + v6 + "\n";
            if (NowPlayer == 2) {
                v4 += "\e[1;33m";
            }
            v4 += "西家[" + NowPlayerId[2] + "]:" + "\e" + "[2;37;0m" + v7 + "\n";
            if (NowPlayer == 3) {
                v4 += "\e[1;33m";
            }
            v4 += "北家[" + NowPlayerId[3] + "]:" + "\e" + "[2;37;0m" + v8 + "\n";
            v4 += sprintf("[%10s]打过的牌有:", P1Data["Id"]);
            v4 += show_mj(P1Data["Dump"], 2) + "\n";
            v4 += sprintf("[%10s]打过的牌有:", P2Data["Id"]);
            v4 += show_mj(P2Data["Dump"], 2) + "\n";
            v4 += sprintf("[%10s]打过的牌有:", P3Data["Id"]);
            v4 += show_mj(P3Data["Dump"], 2) + "\n";
            v4 += sprintf("[%10s]打过的牌有:", P4Data["Id"]);
            v4 += show_mj(P4Data["Dump"], 2) + "\n";
        } else if (NowPlayerId[0] != "") {
            v4 = LookP + "正在等人打牌";
        } else {
            v4 = LookP + "一位可爱的麻将西施正等人加入(addin)牌局。";
        }
    } else if (arg == "end") {
        v4 += "还有" + chinese_number((end - count - 16 - Goned) / 2) + "只牌就流局了\n";
    } else if (arg == "dump") {
        v4 += LastDumpId + "刚刚打出了" + show_mj(LastDump, 2) + "\n";
    } else {
        return 0;
    }
    if (arg == "mj") {
        if (v10["AutoTin"] != "") {
            v4 += "遇到" + show_mj(v10["AutoTin"], 2) + "会自动胡牌、";
        }
        if (v10["AutoGon"] != "") {
            v4 += "遇到" + show_mj(v10["AutoGon"], 2) + "会自动杠牌、";
        }
        if (v10["AutoPon"] != "") {
            v4 += "遇到" + show_mj(v10["AutoPon"], 2) + "会自动碰牌。";
        }
        if (v10["Show"] == "代码") {
            v4 += "显示方式为代码方式。";
        }
        if (v10["Show"] == "color") {
            v4 += "显示方式为彩色。";
        }
        if (v10["Auto"] == "auto") {
            v4 += "你设定自动听牌。";
        }
        if (v10["AutoTin"] == "" && v10["AutoGon"] == "" && v10["AutoPon"] == "" && v10["Show"] == "" && v10["Auto"] == "") {
            v4 += "你没有任何设定。\n";
        }
    }
    write(sprintf("%s\n", v4));
    return 1;
}

int do_tin(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v4 = this_player();
    if (!Playing) {
        write("牌局还没开始。\n");
        return 1;
    }
    if (check_id(v4->query("id"), "player") == "") {
        write("这场牌局与你无关。\n");
        return 1;
    }
    if (v4->query("id") != NowPlayerId[NowPlayer]) {
        write("还没轮到你。\n");
        return 1;
    }
    if (!Touched) {
        write("请先摸牌。\n");
        return 1;
    }
    if (v4->query("id") == P1Data["Id"]) {
        v5 = P1Data;
    } else if (v4->query("id") == P2Data["Id"]) {
        v5 = P2Data;
    } else if (v4->query("id") == P3Data["Id"]) {
        v5 = P3Data;
    } else if (v4->query("id") == P4Data["Id"]) {
        v5 = P4Data;
    } else {
        return 1;
    }
    if (v5["Auto"] == "auto") {
        write("你已经开始自动听牌了。\n");
        return 1;
    }
    if (!arg) {
        write("tin <废牌代号>。\n");
        return 1;
    } else {
        v3 = do_check_Mj(MjE, arg);
        if (!v3) {
            return notify_fail("没有[" + arg + "]这种代码。\n");
        }
        v3 = do_check_Mj(v5["Mj"], arg);
        if (!v3) {
            return notify_fail("你没" + do_check_num(arg, 0) + "这张牌。\n");
        }
    }
    v2 = do_delete_Mj(v5["Mj"], arg, 1);
    v1 = find_tin(v2);
    if (v1 == "ERROR") {
        write("看不懂你这乱七八糟的牌。\n");
    } else if (v1 != "") {
        write("可以听的牌有:[" + v1 + "]\n");
        v5["AutoTin"] = v1;
        Auto_Tin = 1;
        message_vision("\n$N大叫一声：\e[1;37m ～ 我 ～ 听 ～ 牌 ～ 啦 ～～\e[2;37;0m\n\n", v4);
        Auto = 1;
        v5["Auto"] = "auto";
        call_out("do_dump", 0, arg, v4);
    } else {
        write("你目前还不能听牌。\n");
    }
    return 1;
}

int do_help(mixed arg) {
    if (arg == "setmj") {
        write("\n                       基  本  设  定\n            setmj 可用的有自动胡、杠、碰、听、显式方法。\n--------------------------------------------------------------------\n例子1: setmj pon 1w        设定会自动碰1w 当别人打出一万时会自动碰一万。\n       setmj gon 1w                                         自动杠一万。\n       setmj tin 1w        (可多次设定以便胡多个牌)         自动胡一万。\n例子2: setmj show 代码     设定为只显示代码。\n       setmj show color    设定为彩色显示。\n例子3: setmj tin none      取消会自动胡牌设定。\n       setmj gon none\n       setmj pon none\n例子4: setmj auto tin      设定自动听牌。\n--------------------------------------------------------------------\n");
        return 1;
    }
}

string to_say_play() {
    return "\n        指  令    例          子                             说    明\n    ┌────────────────────────────────┐\n    │  bet       bet 100 设定每台为100货币                  设定赌注 │\n    │  addin     ----------                                 加入排局 │\n    │  look      l mj或.看自己牌,l 1p或.1看玩家1的牌                 │\n    │            l all或..看全部,l end看流局l dump。        看牌     │\n    │  mo(0)     ----------                                 摸牌     │\n    │  dump(dd)  dump <代码>。                              打牌     │\n    │  e"
            "at       eat <代码1> <代码2>。                      吃牌     │\n    │  pon(p)    ----------                                 碰牌     │\n    │  gon       gon 或 gon <代码>(暗杠用)。                杠牌     │\n    │  hu                                                   胡牌     │\n    │  setmj     help setmj。                               设定参数 │\n    │  start     ----------                                 牌局开始 │\n    │  restart   restart 或 restart mj。                    重新开始 │\n    │  showmj    showmj <id> 让其他人看自己的牌             现牌     │\n    │  top      " " top                                        查资料   │\n    └────────────────────────────────┘\n";
}

string to_say_rule() {
    return " \n　　每胡就有底台３，在加上所得的台就是总台，要是自摸就＊３，相当于三一的算法。\n放枪就由总战绩那扣掉所失的台数。胡者则加上去。\n \n";
}

int show_top(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v1 = "";
    v2 = ({ });
    v3 = ({ });
    v5 = this_player();
    if (sizeof(record) < 1) {
        return notify_fail("目前没有战绩记录。\n");
    }
    if (!arg) {
        v3 = keys(record);
        v2 = do_sort_record("total", v3);
        v1 = "排 名        玩    家           局数 自摸 胡牌 放枪 战绩分 犯规\n";
        v1 += "===== ========================= ==== ==== ==== ==== ====== ====\n";
        for (v4 = 0; v4 < sizeof(v2); v4++) {
            v1 += sprintf("%-5d %-24s %4d %4d %4d %4d %6d %4d\n", v4 + 1, record[v2[v4]]["name"], record[v2[v4]]["rounds"], record[v2[v4]]["self"], record[v2[v4]]["win"], record[v2[v4]]["lose"], record[v2[v4]]["total"], record[v2[v4]]["bad"]);
        }
        v5->start_more(v1);
        return 1;
    }
    v3 = keys(record);
    v2 = do_sort_record("total", v3);
    if (member_array(arg, v2) != -1) {
        v1 = "排 名        玩    家           局数 自摸 胡牌 放枪 战绩分 犯规\n";
        v1 += "===== ========================= ==== ==== ==== ==== ====== ====\n";
        for (v4 = 0; v4 < sizeof(v2); v4++) {
            if (v2[v4] != arg) {
                continue;
            }
            v1 += sprintf("%-5d %-24s %4d %4d %4d %4d %6d %4d\n", v4 + 1, record[v2[v4]]["name"], record[v2[v4]]["rounds"], record[v2[v4]]["self"], record[v2[v4]]["win"], record[v2[v4]]["lose"], record[v2[v4]]["total"], record[v2[v4]]["bad"]);
        }
        v5->start_more(v1);
        return 1;
    } else {
        write("查无此玩家战绩记录。\n");
        return 1;
    }
    return 1;
}

int set_mjdata(mixed arg1, mixed arg2) {
    if (!arg1) {
        return 0;
    }
    message_vision("$N立刻将$n的成绩记录下来。\n", this_object(), arg1);
    if (undefinedp(record[getuid(arg1)])) {
        record[getuid(arg1)] = ([ "name" : arg1->name_id(1), "rounds" : 1, "self" : arg2[0], "win" : arg2[1], "lose" : arg2[2], "total" : arg2[3], "bad" : arg2[4] ]);
    } else {
        record[getuid(arg1)]["rounds"]++;
        record[getuid(arg1)]["self"] += arg2[0];
        record[getuid(arg1)]["win"] += arg2[1];
        record[getuid(arg1)]["lose"] += arg2[2];
        record[getuid(arg1)]["total"] += arg2[3];
        record[getuid(arg1)]["bad"] += arg2[4];
    }
    return 1;
}

int get_tc(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    v5 = "";
    v6 = "";
    v7 = "";
    v8 = "";
    v4 = arg["Mj"] + arg["Out"] + arg["OutPon"] + arg["OutGon"];
    if (NowPlayerId[0] == arg["Id"]) {
        Tc += "@1";
    }
    if (arg["Out"] == "" && arg["OutPon"] == "" && Touched) {
        Tc += "@l";
    } else if (arg["Out"] == "" && arg["OutPon"] == "") {
        Tc += "@4";
    } else if (Touched) {
        Tc += "@2";
    }
    if (sizeof(arg["Mj"]) < 5) {
        Tc += "@i";
    }
    v1 = sizeof(v4);
    while (v1--) {
        v1--;
        if (do_check_num(v4[v1..v1 + 1], 1) < 10) {
            v5 += v4[v1..v1 + 1];
            continue;
        }
        if (do_check_num(v4[v1..v1 + 1], 1) < 19) {
            v6 += v4[v1..v1 + 1];
            continue;
        }
        if (do_check_num(v4[v1..v1 + 1], 1) < 28) {
            v7 += v4[v1..v1 + 1];
            continue;
        }
        v8 += v4[v1..v1 + 1];
    }
    if (!(Times / Play) && NowPlayerId[0] == arg["Id"] && do_check_Mj(v8, "ea") > 2) {
        Tc += "@e";
    } else if (!(Times / Play) && do_check_Mj(v8, "ea") > 2 || NowPlayerId[0] == arg["Id"] && do_check_Mj(v8, "ea") > 2) {
        Tc += "@5";
    }
    if (Times / Play == 1 && NowPlayerId[1] == arg["Id"] && do_check_Mj(v8, "so") > 2) {
        Tc += "@f";
    } else if (Times / Play == 1 && do_check_Mj(v8, "so") > 2 || NowPlayerId[1] == arg["Id"] && do_check_Mj(v8, "so") > 2) {
        Tc += "@6";
    }
    if (Times / Play == 2 && NowPlayerId[2] == arg["Id"] && do_check_Mj(v8, "we") > 2) {
        Tc += "@g";
    } else if (Times / Play == 2 && do_check_Mj(v8, "we") > 2 || NowPlayerId[2] == arg["Id"] && do_check_Mj(v8, "we") > 2) {
        Tc += "@7";
    }
    if (Times / Play == 3 && NowPlayerId[3] == arg["Id"] && do_check_Mj(v8, "no") > 2) {
        Tc += "@h";
    } else if (Times / Play == 3 && do_check_Mj(v8, "no") > 2 || NowPlayerId[3] == arg["Id"] && do_check_Mj(v8, "no") > 2) {
        Tc += "@8";
    }
    if (sizeof(arg["OutFlower"]) == 16) {
        Tc += "@A";
    } else if (sizeof(arg["OutFlower"]) == 14 && sizeof(P1Data["OutFlower"] + P2Data["OutFlower"] + P3Data["OutFlower"] + P4Data["OutFlower"]) == 16) {
        Tc += "@D";
    } else if (do_check_Mj(arg["OutFlower"], "f1") == 1 && do_check_Mj(arg["OutFlower"], "f2") == 1 && do_check_Mj(arg["OutFlower"], "f3") == 1 && do_check_Mj(arg["OutFlower"], "f4") == 1) {
        Tc += "@B";
    } else if (do_check_Mj(arg["OutFlower"], "f5") == 1 && do_check_Mj(arg["OutFlower"], "f6") == 1 && do_check_Mj(arg["OutFlower"], "f7") == 1 && do_check_Mj(arg["OutFlower"], "f8") == 1) {
        Tc += "@C";
