                tell_object(v5, show_site(NowPlayerId[v1]));
            }
        }
    }
    message_vision("\e[33m$N说：庄家 \e[1;33m" + NowPlayerId[0] + "\e" + "[2;37;0m" + "\e" + "[33m" + " 请开门牌。\n" + "\e" + "[2;37;0m", this_object());
    return 1;
}

int do_setmj(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v4 = this_player();
    if (v4->query("id") == P1Data["Id"]) {
        v3 = P1Data;
    } else if (v4->query("id") == P2Data["Id"]) {
        v3 = P2Data;
    } else if (v4->query("id") == P3Data["Id"]) {
        v3 = P3Data;
    } else if (v4->query("id") == P4Data["Id"]) {
        v3 = P4Data;
    } else {
        return 0;
    }
    if (!arg) {
        v2 = this_object()->name() + "对著你说: 你目前的设定有:\n";
        if (v3["AutoTin"] != "") {
            v2 += "遇到\e[1;34m" + show_mj(v3["AutoTin"], 2) + "\e" + "[2;37;0m" + "会自动" + "\e" + "[1;34m" + "[胡牌]" + "\e" + "[2;37;0m" + "。\n";
        }
