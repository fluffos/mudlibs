int do_addin() {
    mixed v1;
    v1 = this_player();
    if (!userp(v1)) {
        return 0;
    }
    if (v1->query("id") == P1Data["Id"] || v1->query("id") == P2Data["Id"] || v1->query("id") == P3Data["Id"] || v1->query("id") == P4Data["Id"]) {
        if (!Playing) {
            message_vision("$N大喊: [欠脚啊～～] 不停的哭哭啼啼.....。\n", v1);
        } else {
            message_vision("$N对著大家说: 今天自摸" + (random(12) + 1) + "次就好。\n", v1);
        }
        return 1;
    }
    if (Playing) {
        if (random(2)) {
            message_vision(this_object()->name() + "对著" + v1->name() + "说： 牌局正在进行中请到旁边坐一下...。\n", v1);
        } else {
            message_vision("$N喊著: [我也要玩啦～～] 不停的哭哭啼啼.....。\n", v1);
        }
        return 1;
    }
    if (BetAmount > 0) {
        switch (v1->money_type()) {
        case 1:
            if (v1->query("bank/past") < BetAmount * 5) {
                message_vision(this_object()->name() + "对著" + v1->name(1) + "说： 你的帐户里面没有足够的赌资。\n", v1);
                return 1;
            }
            break;
        case 2:
            if (v1->query("bank/now") < BetAmount * 5) {
                message_vision(this_object()->name() + "对著" + v1->name(1) + "说： 你的帐户里面没有足够的赌资。\n", v1);
                return 1;
            }
            break;
        case 3:
            if (v1->query("bank/future") < BetAmount * 5) {
                message_vision(this_object()->name() + "对著" + v1->name(1) + "说： 你的帐户里面没有足够的赌资。\n", v1);
                return 1;
            }
            break;
        default:
            break;
        }
    } else {
    }
    if (!P1Data["Id"] || P1Data["Id"] == "") {
        P1Data["Id"] = v1->query("id");
        NowPlayerId[Play] = v1->query("id");
        message_vision("$N加入了这场牌局。\n", v1);
        Play++;
        Times = 0;
        LookP += "在前面有" + v1->name() + "，";
        return 1;
    } else if (!P2Data["Id"] || P2Data["Id"] == "") {
        P2Data["Id"] = v1->query("id");
        message_vision("$N加入了这场牌局。\n", v1);
        NowPlayerId[Play] = v1->query("id");
        Play++;
        Times = 0;
        LookP += v1->name() + "，";
        return 1;
    } else if (!P3Data["Id"] || P3Data["Id"] == "") {
        P3Data["Id"] = v1->query("id");
        message_vision("$N加入了这场牌局。\n", v1);
        NowPlayerId[Play] = v1->query("id");
        Play++;
        Times = 0;
        LookP += v1->name() + "，";
        return 1;
    } else if (!P4Data["Id"] || P4Data["Id"] == "") {
        P4Data["Id"] = v1->query("id");
        message_vision("$N加入了这场牌局。\n", v1);
        NowPlayerId[Play] = v1->query("id");
        Play++;
        Times = 0;
        LookP += v1->name();
        return wash_mj(Play);
    }
    return notify_fail("人数已足。\n");
}

int do_dump(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    v3 = ({ 0, 0, 0, 0, 0 });
    if (!arg2) {
        arg2 = this_player();
    }
    if (check_id(arg2->query("id"), "player") == "") {
        command("stare " + arg2->query("id"));
        command("say 这牌局跟你没关系。");
        return 1;
    }
    if (!Playing) {
        command("kick " + arg2->query("id"));
        command("say 牌局还没开始请不要拿牌乱丢!!");
        return 1;
    }
    tell_object(arg2, "换谁打牌:" + NowPlayerId[NowPlayer] + "\n");
    if (!arg1) {
        return notify_fail("指令:dump <代码>\n");
    }
    if (arg2->query("id") != NowPlayerId[NowPlayer]) {
        command("hammer " + arg2->query("id"));
        command("say 想偷打牌!!作弊ㄚ?");
        return 1;
    }
    if (!Touched) {
        command("faint " + arg2->query("id"));
        command("say 你还没摸牌!!");
        return 1;
    }
    if (Goned == 5) {
        message_vision("$N说道：此局因\e[1;31m五杠合牌\e[2;37;0m请再重新开始 start 。\n", this_object());
        Playing = 0;
        Count++;
        if (Play >= 4) {
            for (v2 = 0; v2 < Play; v2++) {
                v6 = present(NowPlayerId[v2], environment(this_object()));
                if (!v6) {
                    v6 = find_player(NowPlayerId[v2]);
                }
                if (v6) {
                    v3 = ({ 0, 0, 0, 0, 0 });
                    set_mjdata(v6, v3);
                }
            }
        }
        return 1;
    }
    NO_HU = 0;
    HU_F = 0;
    NO_GON = 0;
    if (arg2->query("id") == P1Data["Id"]) {
        v5 = P1Data;
    } else if (arg2->query("id") == P2Data["Id"]) {
        v5 = P2Data;
    } else if (arg2->query("id") == P3Data["Id"]) {
        v5 = P3Data;
    } else if (arg2->query("id") == P4Data["Id"]) {
        v5 = P4Data;
    }
    v1 = do_check_Mj(MjE, arg1);
    if (!v1) {
        return notify_fail("没有[" + arg1 + "]这种代码。\n");
    }
    v1 = do_check_Mj(v5["Mj"], arg1);
    if (!v1) {
        return notify_fail("你没" + do_check_num(arg1, 0) + "这张牌。\n");
    }
    tell_object(arg2, "你说道：" + do_check_num(arg1, 0) + "\n");
    tell_room(environment(this_object()), "\e[33m" + arg2->name() + "说：" + do_check_num(arg1, 0) + "。\n" + "\e" + "[2;37;0m", arg2);
    message_vision("$N打出了一张.." + do_check_num(arg1, 3) + "\n", arg2);
    v5["Mj"] = do_delete_Mj(v5["Mj"], arg1, 1);
    LastDump = arg1;
    v5["Dump"] += arg1;
    LastDumpId = v5["Id"];
    Touched = 0;
    NowPlayer++;
    NowPlayer %= Play;
    message_vision("\e[33m$N说：还剩下[\e[1;36m" + (end - count - 16 - Goned) / 2 + "\e" + "[2;37;0m" + "\e" + "[33m" + "]张牌可摸，现在轮到 " + "\e" + "[1;33m" + capitalize(NowPlayerId[NowPlayer]) + "\e" + "[2;37;0m" + "\e" + "[33m" + " 摸牌。\n" + "\e" + "[2;37;0m", this_object());
    if (v7 = present(NowPlayerId[NowPlayer], environment(this_object()))) {
        tell_object(v7, "\e[1;37m\a< 该你罗!! >\n\e[2;37;0m");
    }
    if (Auto_Tin) {
        v4 = check_id(arg1, "tin");
        if (v4 != "") {
            arg2 = present(v4, environment(this_object()));
            if (!arg2) {
                arg2 = find_player(v4);
            }
            if (!arg2) {
                return 1;
            }
            return do_win(arg1, arg2);
        }
    }
    if (Auto_Gon) {
        v4 = check_id(arg1, "gon");
        if (v4 != "") {
            arg2 = present(v4, environment(this_object()));
            if (!arg2) {
                arg2 = find_player(v4);
            }
            if (!arg2) {
                return 1;
            }
            do_gon(arg1, arg2);
        }
    }
    if (Auto_Pon) {
        v4 = check_id(arg1, "pon");
        if (v4 != "") {
            arg2 = present(v4, environment(this_object()));
            if (!arg2) {
                arg2 = find_player(v4);
            }
            if (!arg2) {
                return 1;
            }
            do_pon(arg1, arg2);
        }
    }
    if (count == end - 16 - Goned) {
        Playing = 0;
        Count++;
        message_vision("\e[33m$N说：此局\e[1;36m流局\e[2;37;0m\e[33m请再重新开始 \e[1;31mstart\e[2;37;0m\e[33m 。\n\e[2;37;0m", this_object());
        if (Play >= 4) {
            for (v2 = 0; v2 < Play; v2++) {
                v6 = present(NowPlayerId[v2], environment(this_object()));
                if (!v6) {
                    v6 = find_player(NowPlayerId[v2]);
                }
                if (v6) {
                    v3 = ({ 0, 0, 0, 0, 0 });
                    set_mjdata(v6, v3);
                }
            }
        }
        return 1;
    }
    if (Auto) {
        if (NowPlayerId[NowPlayer] == P1Data["Id"]) {
            v5 = P1Data;
        } else if (NowPlayerId[NowPlayer] == P2Data["Id"]) {
            v5 = P2Data;
        } else if (NowPlayerId[NowPlayer] == P3Data["Id"]) {
            v5 = P3Data;
        } else if (NowPlayerId[NowPlayer] == P4Data["Id"]) {
            v5 = P4Data;
        }
        if (v5["Auto"] == "auto") {
            arg2 = present(NowPlayerId[NowPlayer], environment(this_object()));
            if (!arg2) {
                arg2 = find_player(NowPlayerId[NowPlayer]);
            }
            if (!arg2) {
                return 1;
            }
            call_out("do_touch", 1, "AUTO", arg2);
        }
    }
    return 1;
}

int do_eat(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    v5 = this_player();
    if (!arg || sscanf(arg, "%s %s", v3, v4) != 2) {
        return 0;
    }
    if (check_id(v5->query("id"), "player") == "") {
        command("stare " + v5->query("id"));
        command("say 这牌局跟你没关系。");
        return 1;
    }
    if (!Playing) {
        command("say 牌局还没开始。");
        return 1;
    }
    tell_object(v5, "换谁摸牌:" + NowPlayerId[NowPlayer] + "\n");
    if (v5->query("id") != NowPlayerId[NowPlayer]) {
        command("hammer " + v5->query("id"));
        command("say 还没轮到你。");
        return 1;
    }
    if (!LastDump || LastDump == "") {
        command("hammer " + v5->query("id"));
        command("say 摸牌吧。");
        return 1;
    }
    if (Touched) {
        command("flop " + v5->query("id"));
        command("say 打牌啦!!");
        return 1;
    }
    if (!do_check_eat(v3, v4, LastDump)) {
        command("flop " + v5->name());
        command("say 你眼睛花了ㄚ!!这样也能吃。");
        return 1;
    }
    if (v3 == v4) {
        command("flop " + v5->name());
        command("say 相同的牌不能吃，只能用碰(pon)的。");
        return 1;
    }
    if (v5->query("id") == P1Data["Id"]) {
        v6 = P1Data;
    } else if (v5->query("id") == P2Data["Id"]) {
        v6 = P2Data;
    } else if (v5->query("id") == P3Data["Id"]) {
        v6 = P3Data;
    } else if (v5->query("id") == P4Data["Id"]) {
        v6 = P4Data;
    }
    v1 = do_check_Mj(MjE, v3);
    if (!v1) {
        return notify_fail("没有[" + v3 + "]这种代码。\n");
    }
    v1 = do_check_Mj(MjE, v4);
    if (!v1) {
        return notify_fail("没有[" + v4 + "]这种代码。\n");
    }
    v1 = do_check_Mj(v6["Mj"], v3);
    if (!v1) {
        return notify_fail("你没" + do_check_num(v3, 0) + "这张牌。\n");
    }
    v1 = do_check_Mj(v6["Mj"], v4);
    if (!v1) {
        return notify_fail("你没" + do_check_num(v4, 0) + "这张牌。\n");
    }
    message_vision("\e[1;32m\n\a【 ～ 吃 ～ 】\e[2;37;0m\n$N拿出了一张" + do_check_num(v3, 3) + "与一张" + do_check_num(v4, 3) + "吃下了" + do_check_num(LastDump, 3) + "。\n\n", v5);
    v6["Out"] += v4;
    v6["Out"] += LastDump;
    v6["Out"] += v3;
    v6["Mj"] = do_delete_Mj(v6["Mj"], v3, 1);
    v6["Mj"] = do_delete_Mj(v6["Mj"], v4, 1);
    Touched = 1;
    NO_HU = 1;
    NO_GON = 1;
    v2 = 0;
    if (v6["Show"] == "代码") {
        v2 = 3;
    }
    if (v6["Show"] == "color") {
        v2 = 5;
    }
    tell_object(v5, show_mj(v6["Mj"], v2));
    return delete_last_dump(v6["Id"]);
}

int do_gon(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!arg2) {
        arg2 = this_player();
    }
    if (check_id(arg2->query("id"), "player") == "") {
        command("stare " + arg2->query("id"));
        command("say 这牌局跟你没关系。");
        return 1;
    }
    if (!Playing) {
        command("say 牌局还没开始!!");
        return 1;
    }
    if (LastDumpId == arg2->query("id") && !arg1) {
        command("stare " + arg2->query("id"));
        command("say 那张牌是你自己打的。");
        return 1;
    }
    if (Touched && NowPlayerId[NowPlayer] != arg2->query("id")) {
        command("hammer " + arg2->query("id"));
        command("say 别人没打牌你怎么杠。");
        return 1;
    }
    if (!arg1) {
        arg1 = LastDump;
    }
    if (arg2->query("id") == P1Data["Id"]) {
        v2 = P1Data;
    } else if (arg2->query("id") == P2Data["Id"]) {
        v2 = P2Data;
    } else if (arg2->query("id") == P3Data["Id"]) {
        v2 = P3Data;
    } else if (arg2->query("id") == P4Data["Id"]) {
        v2 = P4Data;
    }
    if (v2["Auto"] == "auto") {
        return 1;
    }
    v1 = do_check_Mj(v2["Mj"], arg1);
    if (v1 == 1) {
        if (!Touched) {
            return notify_fail("你还没摸牌。\n");
        }
        v1 = do_check_Mj(v2["OutPon"], arg1);
        if (!v1) {
            return notify_fail("你只有一张不能杠。\n");
        }
        if (NO_GON) {
            return notify_fail("这样无法杠牌。\n");
        }
        message_vision("\n$N说道：\e[1;34m\a【 ～ 杠 ～ 】\e[2;37;0m\n\n", arg2);
        v2["Mj"] = do_delete_Mj(v2["Mj"], arg1, 1);
        sort_data(v2["OutPon"] += arg1);
        arg1 = List[end..end + 1];
        end -= 2;
        Goned++;
        message_vision("\n$N从后面补了一张牌。\n\n", arg2);
        write(sprintf("你补到一张%s\n", do_check_num(arg1, 0)));
        v1 = 0;
        if (v2["Show"] == "代码") {
            v1 = 3;
        }
        if (v2["Show"] == "color") {
            v1 = 5;
        }
        v2["Mj"] += arg1;
        check_flower(v2);
