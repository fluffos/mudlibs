            v2 += "遇到\e[1;33m" + show_mj(v3["AutoGon"], 2) + "\e" + "[2;37;0m" + "会自动" + "\e" + "[1;33m" + "[杠牌]" + "\e" + "[2;37;0m" + "。\n";
        }
        if (v3["AutoPon"] != "") {
            v2 += "遇到\e[1;32m" + show_mj(v3["AutoPon"], 2) + "\e" + "[2;37;0m" + "会自动" + "\e" + "[1;32m" + "[碰牌]" + "\e" + "[2;37;0m" + "。\n";
        }
        if (v3["Show"] == "代码") {
            v2 += "显示方式为\e[1;33m[代码]\e[2;37;0m方式。\n";
        }
        if (v3["Show"] == "color") {
            v2 += "显示方式为\e[1;32m[彩色]\e[2;37;0m。\n";
        }
        if (v3["Auto"] == "auto") {
            v2 += "你设定\e[1;31m[自动听牌]\e[2;37;0m。\n";
        }
        if (v3["AutoTin"] == "" && v3["AutoGon"] == "" && v3["AutoPon"] == "" && v3["Show"] == "" && v3["Auto"] == "") {
            v2 += "你没有任何设定。\n";
        }
        tell_room(environment(v4), this_object()->name() + "在" + v4->name() + "耳边说了一些话。\n", v4);
        tell_object(v4, v2);
        return 1;
    }
    if (sscanf(arg, "%s %s", arg, v2) != 2) {
        return notify_fail("指令:setmj <tin>&<gon>&<pon> <代码>\n");
    }
    if (arg == "tin") {
        if (v2 == "none") {
            v3["AutoTin"] = "";
            return notify_fail("你取消自动胡牌设定。\n");
        }
        if (member_array(v2, Mjlist) == -1) {
            return notify_fail("没有[" + v2 + "]这种牌。\n");
        }
        v1 = do_check_Mj(MjE, v2);
        if (v1 != 1) {
            return notify_fail("没有[" + v2 + "]这种牌。\n");
        }
        v1 = do_check_Mj(v3["AutoTin"], v2);
        if (v1) {
            v3["AutoTin"] = do_delete_Mj(v3["AutoTin"], v2, 1);
            return notify_fail("你\e[1;31m删掉了\e[2;37;0m遇到" + do_check_num(v2, 0) + "会自动胡牌的设定。\n");
        }
        v3["AutoTin"] += v2;
        Auto_Tin = 1;
        write("你设定遇到" + do_check_num(v2, 0) + "时会自动胡牌。\n");
        return 1;
    } else if (arg == "gon") {
        if (v2 == "none") {
            v3["AutoGon"] = "";
            return notify_fail("你取消自动杠牌设定。\n");
        }
        if (member_array(v2, Mjlist) == -1) {
            return notify_fail("没有[" + v2 + "]这种牌。\n");
        }
        v1 = do_check_Mj(v3["Mj"], v2);
        if (!v1) {
            return notify_fail("你没" + do_check_num(v2, 0) + "这张牌。\n");
        }
        if (v1 < 3) {
            return notify_fail("你手中要有三张" + do_check_num(v2, 0) + "才能设定杠此牌。\n");
        }
        v1 = do_check_Mj(v3["AutoGon"], v2);
        if (v1) {
            v3["AutoGon"] = do_delete_Mj(v3["AutoGon"], v2, 1);
            return notify_fail("你\e[1;31m删掉了\e[2;37;0m遇到" + do_check_num(v2, 0) + "会自动杠牌的设定。\n");
        }
        v3["AutoGon"] += v2;
        Auto_Gon = 1;
        write("你设定遇到" + do_check_num(v2, 0) + "时会自动杠牌。\n");
        return 1;
    } else if (arg == "pon") {
        if (v2 == "none") {
            v3["AutoPon"] = "";
            return notify_fail("你取消自动碰牌设定。\n");
        }
        if (member_array(v2, Mjlist) == -1) {
            return notify_fail("没有[" + v2 + "]这种牌。\n");
        }
        v1 = do_check_Mj(v3["Mj"], v2);
        if (!v1) {
            return notify_fail("你没" + do_check_num(v2, 0) + "这张牌。\n");
        }
        if (v1 < 2) {
            return notify_fail("你手中要有两张" + do_check_num(v2, 0) + "才能设定碰此牌。\n");
        }
        v1 = do_check_Mj(v3["AutoPon"], v2);
        if (v1) {
            v3["AutoPon"] = do_delete_Mj(v3["AutoPon"], v2, 1);
            return notify_fail("你\e[1;31m删掉了\e[2;37;0m遇到" + do_check_num(v2, 0) + "会自动碰牌的设定。\n");
        }
        v3["AutoPon"] += v2;
        Auto_Pon = 1;
        write("你设定遇到" + do_check_num(v2, 0) + "时会自动碰牌。\n");
        return 1;
    } else if (arg == "show") {
        if (v2 == "none" || v2 == "1") {
            v3["Show"] = "";
            return notify_fail("你取消显示设定。\n");
        }
        if (v2 == "代码" || v2 == "3") {
            v2 = "代码";
            write("你设定只显示代码。\n");
        } else if (v2 == "color" || v2 == "2") {
            v2 = "color";
            write("你设定彩色显示。\n");
        } else {
            return 1;
        }
        v3["Show"] = v2;
        return 1;
    } else if (arg == "auto") {
        if (v2 == "none") {
            return notify_fail("不能取消自动听牌，要是设定错误等著诈胡吧!!:>。\n");
        }
        if (v3["AutoTin"] == "") {
            return notify_fail("请先设定要听的牌。\n");
        }
        if (!Touched) {
