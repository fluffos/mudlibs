int do_touch(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!arg2) {
        arg2 = this_player();
    }
    if (check_id(arg2->query("id"), "player") == "") {
        command("stare " + arg2->query("id"));
        command("say 这牌局跟你没关系。");
        return 1;
    }
    if (!Playing) {
        command("say 牌局还没开始你要摸牌去藏起来ㄚ~~");
        return 1;
    }
    tell_object(arg2, "换谁摸牌:" + NowPlayerId[NowPlayer] + "\n");
    if (arg2->query("id") != NowPlayerId[NowPlayer]) {
        command("hammer " + arg2->query("id"));
        command("say 想偷牌!!没那么容易~~");
        return 1;
    }
    if (Touched) {
        command("flop " + arg2->query("id"));
        command("say 打牌啦!!");
        return 1;
    }
    NO_HU = 0;
    NO_GON = 0;
    if (arg2->query("id") == P1Data["Id"]) {
        v3 = P1Data;
    } else if (arg2->query("id") == P2Data["Id"]) {
        v3 = P2Data;
    } else if (arg2->query("id") == P3Data["Id"]) {
        v3 = P3Data;
    } else if (arg2->query("id") == P4Data["Id"]) {
        v3 = P4Data;
    }
    if (v3["Auto"] == "auto") {
        if (arg1 != "AUTO") {
            write("设定自动听牌后、不可自己摸牌。\n");
            return 1;
        }
    }
    Touched = 1;
    arg1 = List[count..count + 1];
    count += 2;
    tell_room(environment(this_object()), arg2->name() + "摸了一张牌。\n", arg2);
    tell_object(arg2, "你摸了一张牌。\n");
    tell_object(arg2, "你摸到一张.." + do_check_num(arg1, 3) + "\n");
    if (v3["Auto"] == "auto") {
        if (do_check_num(arg1, 1) > 34) {
            for (v1 = 0; v1 < 1; v1++) {
                v3["OutFlower"] += arg1;
                HU_F = 1;
                tell_room(environment(this_object()), "\e[33m" + arg2->name() + "说：" + "\e" + "[1;34m" + "花牌" + "\e" + "[2;37;0m" + "\e" + "[33m" + "补花!!。\n\n" + "\e" + "[2;37;0m" + arg2->name() + "往后面补了一张牌。\n", arg2);
                tell_object(arg2, "你说：\e[1;34m花牌\e[2;37;0m补花!!。\n\n你往后面补了一张牌。\n");
                arg1 = List[end..end + 1];
                end -= 2;
                tell_object(arg2, "你摸到了一张" + do_check_num(arg1, 3) + "\n");
                if (do_check_num(arg1, 1) > 34) {
                    v1--;
                }
            }
        }
        v2 = do_check_Mj(v3["AutoTin"], arg1);
        if (v2) {
            v3["Mj"] += arg1;
            v3["Mj"] = sort_data(v3["Mj"]);
            return do_win(arg1, arg2);
        }
        call_out("do_dump", 0, arg1, arg2);
    }
    v3["Mj"] += arg1;
    check_flower(v3);
    v1 = 0;
    if (v3["Show"] == "代码") {
        v1 = 3;
    }
    if (v3["Show"] == "color") {
        v1 = 5;
    }
    tell_object(arg2, show_mj(v3["Mj"], v1));
    return 1;
}

int do_pon(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!arg2) {
        arg2 = this_player();
    }
    if (check_id(arg2->query("id"), "player") == "") {
        command("stare " + arg2->query("id"));
        command("say 这牌局跟你没关系。");
        return 1;
    }
    if (!Playing) {
        command("die " + arg2->query("id"));
        command("say 牌局还没开始!!碰你的头啦!!");
        return 1;
    }
    if (Touched) {
        command("hammer " + arg2->query("id"));
        command("say 别人没打牌你怎么碰。");
        return 1;
    }
    if (LastDumpId == arg2->query("id")) {
