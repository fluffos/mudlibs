        }
        message_vision("\n$N大叫一声：\e[1;37m ～ 我 ～ 听 ～ 牌 ～ 啦 ～～\e[2;37;0m\n\n", v4);
        Auto = 1;
        v3["Auto"] = "auto";
        return 1;
    } else {
        return notify_fail("没有这种设定。\n");
    }
}

int do_check_eat(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = do_check_num(arg1, 1);
    v2 = do_check_num(arg2, 1);
    v3 = do_check_num(arg3, 1);
    if (v1 < 10) {
        if (v2 > 10 || v3 > 10) {
            return 0;
        }
    } else if (v1 < 19 && v1 > 10) {
        if (v2 > 19 || v3 > 19 && v2 < 10 || v3 < 10) {
            return 0;
        }
    } else if (v1 < 28 && v1 > 19) {
        if (v2 < 19 || v3 < 19) {
            return 0;
        }
    }
    v1 = do_check_num(arg1, 2);
    v2 = do_check_num(arg2, 2);
    v3 = do_check_num(arg3, 2);
    if (v1 > 9 || v2 > 9 || v3 > 9) {
        return 0;
    }
    if ((v1 + v2) % 2) {
        if (v1 > v2) {
            if (v3 == v1 + 1 || v3 == v1 - 2) {
                return 1;
            }
        } else if (v3 == v2 + 1 || v3 == v2 - 2) {
            return 1;
        }
        return 0;
    } else {
        if (v1 > v2) {
            if (v3 == v1 - 1 || v3 == v2 + 1) {
                return 1;
            }
        } else if (v3 == v2 - 1 || v3 == v1 + 1) {
            return 1;
        }
        return 0;
    }
}

