mixed do_check_num(mixed arg1, mixed arg2) {
    mixed v1;
    if (!arg1) {
        return MjC[0];
    }
    sscanf(arg1, "%d%s", v1, arg1);
    if (!v1) {
        if (arg1 == "xx") {
            v1 = 43;
        } else if (arg1 != "") {
            v1 = strsrch(MjE, arg1);
            v1 = v1 / 2 + 1;
        }
    } else {
        if (arg1 == "w") {
            v1 = v1;
        } else if (arg1 == "t") {
            v1 = v1 + 9;
        } else if (arg1 == "s") {
            v1 = v1 + 18;
        }
        if (arg2 == 2) {
            v1 %= 9;
            if (!v1) {
                v1 = 9;
            }
        }
    }
    if (!arg2) {
        if (v1 >= sizeof(MjC)) {
            return MjC[0];
        }
        return MjC[v1];
    } else if (arg2 == 3) {
        if (arg1 == "w") {
            return "\e[1;31m" + MjC[v1] + "\e" + "[2;37;0m";
        } else if (arg1 == "t") {
            return "\e[1;36m" + MjC[v1] + "\e" + "[2;37;0m";
        } else if (arg1 == "s") {
            return "\e[1;32m" + MjC[v1] + "\e" + "[2;37;0m";
        } else if (arg1 == "jo") {
            return "\e[1;31m" + MjC[v1] + "\e" + "[2;37;0m";
        } else if (arg1 == "fa") {
            return "\e[1;32m" + MjC[v1] + "\e" + "[2;37;0m";
        } else if (arg1 == "ba") {
            return "\e[1;37m" + MjC[v1] + "\e" + "[2;37;0m";
        } else {
            return "\e[1;35m" + MjC[v1] + "\e" + "[2;37;0m";
        }
    } else {
        return v1;
    }
}

