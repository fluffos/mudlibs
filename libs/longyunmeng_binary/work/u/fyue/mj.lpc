    Touched = 0;
    Auto = 0;
    Auto_Tin = 0;
    Auto_Gon = 0;
    Auto_Pon = 0;
    Goned = 0;
    LastDump = "";
    LastDumpId = "";
    v5 = keys(v6);
    for (v1 = 0; v1 < 144; v1++) {
        v2 = random(sizeof(v5));
        if (v5[v2] == "f1" || v5[v2] == "f2" || v5[v2] == "f3" || v5[v2] == "f4" || v5[v2] == "f5" || v5[v2] == "f6" || v5[v2] == "f7" || v5[v2] == "f8") {
            if (v6[v5[v2]] < 1) {
                v6[v5[v2]] = v6[v5[v2]] + 1;
                List += v5[v2];
            } else {
                v1--;
            }
            continue;
        }
        if (v6[v5[v2]] < 4) {
            v6[v5[v2]] = v6[v5[v2]] + 1;
            List += v5[v2];
            continue;
        }
        v1--;
    }
    command("say 嗯!!好了可以开始了来吧!!");
    if (Count) {
        v4 = "[连庄" + chinese_number(Count) + "]";
    }
    if (Times) {
        if (!Count) {
            v3 = NowPlayerId[0];
            if (Play > 1) {
                NowPlayerId[0] = NowPlayerId[1];
            }
            if (Play > 2) {
                NowPlayerId[1] = NowPlayerId[2];
            }
            if (Play > 3) {
                NowPlayerId[2] = NowPlayerId[3];
            }
            NowPlayerId[Play - 1] = v3;
        }
    }
    if (Times / Play == 4) {
        Times = 0;
    }
    if (Times / Play == 3) {
        v3 = "\e[1;37m北风\e[2;37;0m";
    }
    if (Times / Play == 2) {
        v3 = "\e[1;33m西风\e[2;37;0m";
    }
    if (Times / Play == 1) {
        v3 = "\e[1;31m南风\e[2;37;0m";
    }
    if (!(Times / Play)) {
        v3 = "\e[1;32m东风\e[2;37;0m";
    }
    v1 = Times;
    v1 %= Play;
    v1++;
    message_vision("[" + v3 + chinese_number(v1) + "]牌局开始:庄家" + "\e" + "[1;33m" + NowPlayerId[0] + "\e" + "[1;31m" + v4 + "\e" + "[2;37;0m" + "掷出骰子" + "[" + "\e" + "[1;32m" + chinese_number(v1 = random(16) + 3) + "\e" + "[2;37;0m" + "]点。\n", this_object());
    if (Play > 0) {
        P1Data["Mj"] = List[0..31];
    }
    if (Play > 1) {
        P2Data["Mj"] = List[32..63];
    }
    if (Play > 2) {
        P3Data["Mj"] = List[64..95];
    }
    if (Play > 3) {
        P4Data["Mj"] = List[96..127];
    }
    count = Play * 2 * 16;
    if (Play > 0) {
        check_flower(P1Data);
    }
    if (Play > 1) {
        check_flower(P2Data);
    }
    if (Play > 2) {
        check_flower(P3Data);
    }
    if (Play > 3) {
        check_flower(P4Data);
    }
    Playing = 1;
    message_vision("$N说道：庄家\e[1;33m" + NowPlayerId[0] + "\e" + "[2;37;0m" + "请开门牌。\n", this_object());
    return 1;
}

int do_setmj(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v4 = this_player();
    if (v4->query("id") == P1Data["Id"]) {
        v3 = P1Data;
    } else if (v4->query("id") == P2Data["Id"]) {
        v3 = P2Data;
    } else if (v4->query("id") == P3Data["Id"]) {
        v3 = P3Data;
    } else if (v4->query("id") == P4Data["Id"]) {
        v3 = P4Data;
    } else {
        return 1;
    }
    if (!arg) {
        v2 = this_object()->name() + "对着你说你设定的有:\n";
        if (v3["AutoTin"] != "") {
            v2 += "遇到\e[1;34m" + show_mj(v3["AutoTin"], 2) + "\e" + "[2;37;0m" + "会自动" + "\e" + "[1;34m" + "[胡牌]" + "\e" + "[2;37;0m" + "。\n";
        }
        if (v3["AutoGon"] != "") {
            v2 += "遇到\e[1;33m" + show_mj(v3["AutoGon"], 2) + "\e" + "[2;37;0m" + "会自动" + "\e" + "[1;33m" + "[  牌]" + "\e" + "[2;37;0m" + "。\n";
        }
        if (v3["AutoPon"] != "") {
            v2 += "遇到\e[1;32m" + show_mj(v3["AutoPon"], 2) + "\e" + "[2;37;0m" + "会自动" + "\e" + "[1;32m" + "[碰牌]" + "\e" + "[2;37;0m" + "。\n";
        }
        if (v3["Show"] == "代码") {
            v2 += "显示方式为\e[1;33m[代码]\e[2;37;0m方式。\n";
        }
        if (v3["Show"] == "color") {
            v2 += "显示方式为\e[1;32m[彩色]\e[2;37;0m。\n";
        }
        if (v3["Auto"] == "auto") {
            v2 += "你设定\e[1;31m[自动听牌]\e[2;37;0m。\n";
        }
        if (v3["AutoTin"] == "" && v3["AutoGon"] == "" && v3["AutoPon"] == "" && v3["Show"] == "" && v3["Auto"] == "") {
            v2 += "你没有任何设定。\n";
        }
        tell_room(environment(v4), this_object()->name() + "在" + v4->name() + "耳边说了一些话。\n", v4);
        tell_object(v4, v2);
        return 1;
    }
    if (sscanf(arg, "%s %s", arg, v2) != 2) {
        return notify_fail("指令:setmj <tin>&<gon>&<pon> <代码>\n");
    }
    if (arg == "tin") {
        if (v2 == "none") {
            v3["AutoTin"] = "";
            return notify_fail("你取消自动胡牌设定。\n");
        }
        v1 = do_check_Mj(MjE, v2);
        if (v1 != 1) {
            return notify_fail("没有[" + v2 + "]这种牌。\n");
        }
        v1 = do_check_Mj(v3["AutoTin"], v2);
        if (v1) {
            v3["AutoTin"] = do_delete_Mj(v3["AutoTin"], v2, 1);
            return notify_fail("你\e[1;31m删掉了\e[2;37;0m遇到" + do_check_num(v2, 0) + "会自动胡牌的设定。\n");
        }
        v3["AutoTin"] += v2;
        Auto_Tin = 1;
        write("你设定遇到" + do_check_num(v2, 0) + "时会自动胡牌。\n");
        return 1;
    } else if (arg == "gon") {
        if (v2 == "none") {
            v3["AutoGon"] = "";
            return notify_fail("你取消自动  牌设定。\n");
        }
        v1 = do_check_Mj(v3["Mj"], v2);
        if (!v1) {
            return notify_fail("你没" + do_check_num(v2, 0) + "这张牌。\n");
        }
        if (v1 < 3) {
            return notify_fail("你手中要有叁张" + do_check_num(v2, 0) + "才能设定  此牌。\n");
        }
        v1 = do_check_Mj(v3["AutoGon"], v2);
        if (v1) {
            v3["AutoGon"] = do_delete_Mj(v3["AutoGon"], v2, 1);
            return notify_fail("你\e[1;31m删掉了\e[2;37;0m遇到" + do_check_num(v2, 0) + "会自动  牌的设定。\n");
        }
        v3["AutoGon"] += v2;
        Auto_Gon = 1;
        write("你设定遇到" + do_check_num(v2, 0) + "时会自动  牌。\n");
        return 1;
    } else if (arg == "pon") {
        if (v2 == "none") {
            v3["AutoPon"] = "";
            return notify_fail("你取消自动碰牌设定。\n");
        }
        v1 = do_check_Mj(v3["Mj"], v2);
        if (!v1) {
            return notify_fail("你没" + do_check_num(v2, 0) + "这张牌。\n");
        }
        if (v1 < 2) {
            return notify_fail("你手中要有两张" + do_check_num(v2, 0) + "才能设定碰此牌。\n");
        }
        v1 = do_check_Mj(v3["AutoPon"], v2);
        if (v1) {
            v3["AutoPon"] = do_delete_Mj(v3["AutoPon"], v2, 1);
            return notify_fail("你\e[1;31m删掉了\e[2;37;0m遇到" + do_check_num(v2, 0) + "会自动碰牌的设定。\n");
        }
        v3["AutoPon"] += v2;
        Auto_Pon = 1;
        write("你设定遇到" + do_check_num(v2, 0) + "时会自动碰牌。\n");
        return 1;
    } else if (arg == "show") {
        if (v2 == "none" || v2 == "1") {
            v3["Show"] = "";
            return notify_fail("你取消显示设定。\n");
        }
        if (v2 == "代码" || v2 == "3") {
            v2 = "代码";
            write("你设定只显示代码。\n");
        } else if (v2 == "color" || v2 == "2") {
            v2 = "color";
            write("你设定彩色显示。\n");
        } else {
            return 1;
        }
        v3["Show"] = v2;
        return 1;
    } else if (arg == "auto") {
        if (v2 == "none") {
            return notify_fail("不能取消自动听牌，要是设定错误等着诈胡吧!!:>。\n");
        }
        if (v3["AutoTin"] == "") {
            return notify_fail("请先设定要听的牌。\n");
        }
        if (!Touched) {
            return notify_fail("请先摸牌再做此设定。\n");
        }
        if (v2 == "tin") {
            write("你设定自动听牌。\n");
        } else {
            return 1;
        }
        message_vision("\n$N大叫一声：\e[1;37m我听啦～～～\e[2;37;0m\n\n", v4);
        Auto = 1;
        v3["Auto"] = "auto";
        return 1;
    } else {
        return notify_fail("没有这种设定。\n");
    }
}

int do_check_eat(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = do_check_num(arg1, 1);
    v2 = do_check_num(arg2, 1);
    v3 = do_check_num(arg3, 1);
    if (v1 < 10) {
        if (v2 > 10 || v3 > 10) {
            return 0;
        }
    } else if (v1 < 19 && v1 > 10) {
        if (v2 > 19 || v3 > 19 && v2 < 10 || v3 < 10) {
            return 0;
        }
    } else if (v1 < 28 && v1 > 19) {
        if (v2 < 19 || v3 < 19) {
            return 0;
        }
    }
    v1 = do_check_num(arg1, 2);
    v2 = do_check_num(arg2, 2);
    v3 = do_check_num(arg3, 2);
    if (v1 > 9 || v2 > 9 || v3 > 9) {
        return 0;
    }
    if ((v1 + v2) % 2) {
        if (v1 > v2) {
            if (v3 == v1 + 1 || v3 == v1 - 2) {
                return 1;
            }
        } else if (v3 == v2 + 1 || v3 == v2 - 2) {
            return 1;
        }
        return 0;
    } else {
        if (v1 > v2) {
            if (v3 == v1 - 1 || v3 == v2 + 1) {
                return 1;
            }
        } else if (v3 == v2 - 1 || v3 == v1 + 1) {
            return 1;
        }
        return 0;
    }
}

string show_mj(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = "";
    v2 = "";
    v3 = sizeof(arg1) + 2;
    if (!arg1 || arg1 == "") {
        return "";
    }
    if (arg2 != 3) {
        while (v3--) {
            v3--;
            v1 += do_check_num(arg1[v3..v3 + 1], 0);
        }
        if (arg2 == 2) {
            v2 = v1;
        } else {
            v3 = sizeof(v1);
            v2 = "┌";
            for (v4 = 0; v4 < v3 / 2 - 1; v4++) {
                if (!(v4 % 2)) {
                    v2 += "—";
                    continue;
                }
                v2 += "┬";
            }
            v2 += "┐\n│";
            for (v4 = 0; v4 < v3 - 1; v4++) {
                if (arg2 == 5 || arg2 == 6) {
                    if (v1[v4 + 2..v4 + 3] == "万") {
                        v2 += "\e[1;31m";
                    } else if (v1[v4 + 2..v4 + 3] == "筒") {
                        v2 += "\e[1;36m";
                    } else if (v1[v4 + 2..v4 + 3] == "索") {
                        v2 += "\e[1;32m";
                    } else if (v1[v4 + 2..v4 + 3] == "风") {
                        v2 += "\e[1;35m";
                    } else if (v1[v4 + 2..v4 + 3] == "中") {
                        v2 += "\e[1;31m";
                    } else if (v1[v4 + 2..v4 + 3] == "发") {
                        v2 += "\e[1;32m";
                    } else if (v1[v4 + 2..v4 + 3] == "板") {
                        v2 += "\e[1;37m";
                    } else if (v1[v4 + 2..v4 + 3] == "春" || v1[v4 + 2..v4 + 3] == "夏" || v1[v4 + 2..v4 + 3] == "秋" || v1[v4 + 2..v4 + 3] == "冬") {
                        v2 += "\e[1;31m";
                    } else if (v1[v4 + 2..v4 + 3] == "梅" || v1[v4 + 2..v4 + 3] == "兰" || v1[v4 + 2..v4 + 3] == "竹" || v1[v4 + 2..v4 + 3] == "菊") {
                        v2 += "\e[1;30m";
                    }
                }
                v2 += v1[v4..v4 + 1];
                v4++;
                v4++;
                v4++;
                v2 += "\e[2;37;0m│";
            }
            v2 += "\n│";
            for (v4 = 2; v4 < v3; v4++) {
                if (arg2 == 5 || arg2 == 6) {
                    if (v1[v4..v4 + 1] == "万") {
                        v2 += "\e[31m";
                    } else if (v1[v4..v4 + 1] == "索") {
                        v2 += "\e[32m";
                    } else if (v1[v4..v4 + 1] == "筒") {
                        v2 += "\e[36m";
                    } else if (v1[v4..v4 + 1] == "风") {
                        v2 += "\e[35m";
                    } else if (v1[v4..v4 + 1] == "中") {
                        v2 += "\e[1;31m";
                    } else if (v1[v4..v4 + 1] == "发") {
                        v2 += "\e[1;32m";
                    } else if (v1[v4..v4 + 1] == "白") {
                        v2 += "\e[1;37m";
                    } else if (v1[v4..v4 + 1] == "春") {
                        v2 += "\e[1;32m";
                    } else if (v1[v4..v4 + 1] == "夏") {
                        v2 += "\e[1;34m";
                    } else if (v1[v4..v4 + 1] == "秋") {
                        v2 += "\e[1;33m";
                    } else if (v1[v4..v4 + 1] == "冬") {
                        v2 += "\e[1;37m";
                    } else if (v1[v4..v4 + 1] == "梅") {
                        v2 += "\e[1;37m";
                    } else if (v1[v4..v4 + 1] == "兰") {
                        v2 += "\e[1;31m";
                    } else if (v1[v4..v4 + 1] == "竹") {
                        v2 += "\e[1;32m";
                    } else if (v1[v4..v4 + 1] == "菊") {
                        v2 += "\e[1;33m";
                    }
                }
                v2 += v1[v4..v4 + 1];
                v4++;
                v4++;
                v4++;
                v2 += "\e[2;37;0m│";
            }
            v2 += "\n└";
            for (v4 = v3 / 2 - 1; v4 > 0; v4--) {
                if (v4 % 2) {
                    if (!arg2 || arg2 == 5) {
                        v2 += arg1[v4 - 1..v4];
                    } else {
                        v2 += "—";
                    }
                    continue;
                }
                v2 += "┴";
            }
            v2 += "┘\n";
        }
        return v2;
    } else {
        v3 *= 2;
        for (v4 = v3 / 2 - 1; v4 > 0; v4--) {
            if (v4 % 2) {
                v2 += arg1[v4 - 1..v4];
                continue;
            }
            v2 += " ";
        }
        v2 += "\n";
    }
    return v2;
}

string check_id(mixed arg1, mixed arg2) {
