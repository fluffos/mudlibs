                HU_F = 1;
                tell_room(environment(this_object()), arg2->name() + "说道：" + "\e" + "[1;34m" + "花牌" + "\e" + "[2;37;0m" + "补花!!。\n\n" + arg2->name() + "往後面补了一张牌。\n", arg2);
                tell_object(arg2, "你说道：\e[1;34m花牌\e[2;37;0m补花!!。\n\n你往後面补了一张牌。\n");
                arg1 = List[end..end + 1];
                end -= 2;
                tell_object(arg2, "你摸到了一张" + do_check_num(arg1, 0) + "\n");
                if (do_check_num(arg1, 1) > 34) {
                    v1--;
                }
            }
        }
        v2 = do_check_Mj(v3["AutoTin"], arg1);
        if (v2) {
            v3["Mj"] += arg1;
            v3["Mj"] = sort_data(v3["Mj"]);
            return do_win(arg1, arg2);
        }
        call_out("do_dump", 0, arg1, arg2);
    }
    v3["Mj"] += arg1;
    check_flower(v3);
    v1 = 0;
    if (v3["Show"] == "代码") {
        v1 = 3;
    }
    if (v3["Show"] == "color") {
        v1 = 5;
    }
    tell_object(arg2, show_mj(v3["Mj"], v1));
    return 1;
}

int do_pon(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!arg2) {
        arg2 = this_player();
    }
    if (check_id(arg2->query("id"), "player") == "") {
        command("stare " + arg2->query("id"));
        command("say 这牌局跟你没关系。");
        return 1;
    }
    if (!Playing) {
        command("die " + arg2->query("id"));
        command("say 牌局还没开始!!碰你的头啦!!");
        return 1;
    }
    if (Touched) {
        command("hammer " + arg2->query("id"));
        command("say 别人没打牌你怎麽碰。");
        return 1;
    }
    if (LastDumpId == arg2->query("id")) {
        command("stare " + arg2->query("id"));
        command("say 那张牌是你自己打的!。");
        return 1;
    }
    if (!arg1) {
        arg1 = LastDump;
    } else if (arg1 != LastDump) {
        return notify_fail("那张" + do_check_num(arg1, 0) + "已经过期了。\n");
    }
    if (arg2->query("id") == P1Data["Id"]) {
        v2 = P1Data;
    } else if (arg2->query("id") == P2Data["Id"]) {
        v2 = P2Data;
    } else if (arg2->query("id") == P3Data["Id"]) {
        v2 = P3Data;
    } else if (arg2->query("id") == P4Data["Id"]) {
        v2 = P4Data;
    }
    if (v2["Auto"] == "auto") {
        return 1;
    }
    v1 = do_check_Mj(v2["Mj"], arg1);
    if (!v1) {
        return notify_fail("你没" + do_check_num(arg1, 0) + "这张牌要怎麽碰。\n");
    }
    if (v1 < 2) {
        return notify_fail("你手中要有两张" + do_check_num(arg1, 0) + "才能碰。\n");
    }
    message_vision("\n$N大叫：" + do_check_num(arg1, 0) + "～" + "\e" + "[1;37m" + "石并～～～" + "\e" + "[2;37;0m" + "\n\n", arg2);
    for (v1 = 0; v1 < Play; v1++) {
        if (NowPlayerId[NowPlayer] == arg2->query("id")) {
            break;
        }
        NowPlayer++;
        NowPlayer %= Play;
    }
    for (v1 = 0; v1 < 3; v1++) {
        v2["OutPon"] += arg1;
    }
    v2["Mj"] = do_delete_Mj(v2["Mj"], arg1, 2);
    v2["AutoPon"] = do_delete_Mj(v2["AutoPon"], arg1, 1);
    NO_HU = 1;
    NO_GON = 1;
    Touched = 1;
    v1 = 0;
    if (v2["Show"] == "代码") {
        v1 = 3;
    }
    if (v2["Show"] == "color") {
        v1 = 5;
    }
    tell_object(arg2, show_mj(v2["Mj"], v1));
    return delete_last_dump(v2["Id"]);
}

int do_restart(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->query("id") == "guest") {
        return 0;
    }
    if (arg != "mj") {
        if (check_id(v1->query("id"), "player") == "") {
            command("stare " + v1->query("id"));
            command("say 这牌局跟你没关系。");
            return 1;
        }
    }
    message_vision("$N把牌局重新设定。\n", v1);
    message_vision("$N说道：牌局重新设定请用\e[1;31m addin \e[2;37;0m加入牌局。\n", this_object());
    NowPlayerId[0] = "";
    NowPlayerId[1] = "";
    NowPlayerId[2] = "";
    NowPlayerId[3] = "";
    P1Data["Id"] = "";
    P2Data["Id"] = "";
    P3Data["Id"] = "";
    P4Data["Id"] = "";
    Count = 0;
    LookP = "";
    Play = 0;
    Times = 0;
    end = 286;
    count = 0;
    Playing = 0;
    return 1;
}

