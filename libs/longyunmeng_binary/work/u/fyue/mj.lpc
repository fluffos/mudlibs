    }
    v1 = do_check_Mj(v5["Mj"], arg1);
    if (!v1) {
        return notify_fail("你没" + do_check_num(arg1, 0) + "这张牌。\n");
    }
    tell_object(arg2, "你说道：" + do_check_num(arg1, 0) + "\n");
    tell_room(environment(this_object()), arg2->name() + "说道：" + do_check_num(arg1, 0) + "\n", arg2);
    command("say " + arg2->name() + "打出了一张" + do_check_num(arg1, 0));
    v5["Mj"] = do_delete_Mj(v5["Mj"], arg1, 1);
    LastDump = arg1;
    v5["Dump"] += arg1;
    LastDumpId = v5["Id"];
    Touched = 0;
    NowPlayer++;
    NowPlayer %= Play;
    message_vision("$N说道：现在轮到\e[1;33m" + NowPlayerId[NowPlayer] + "\e" + "[2;37;0m" + "摸牌。\n", this_object());
    if (Auto_Tin) {
        v4 = check_id(arg1, "tin");
        if (v4 != "") {
            arg2 = present(v4, environment(this_object()));
            if (!arg2) {
                arg2 = find_player(v4);
            }
            if (!arg2) {
