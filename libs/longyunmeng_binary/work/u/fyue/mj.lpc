int do_help(mixed arg) {
    if (arg == "setmj") {
        write("                       基  本  设  定\n            setmj 可用的有自动胡、  、碰、听、显式方法。\n--------------------------------------------------------------------\n例子1: setmj pon 1w        设定会自动碰1w 当别人打出一万时会自动碰一万。\n       setmj gon 1w                                         自动  一万。\n       setmj tin 1w                                         自动胡一万。\n例子2: setmj show 代码        设定为只显示代码。\n       setmj show color 设定为彩色显示。\n例子3: setmj tin none        取消会自动胡牌设定。\n       setmj gon none\n       setmj pon none\n例子4: setmj auto tin        设定自动听牌。\n--------------------------------------------------------------------\n");
        return 1;
    }
}

int to_say_play() {
    write("        指  令          例          子                               说    明\n    ┌—————————————————————————————┐\n    │        addin          ----------                               加入排局 │\n    │        look          l mj或.看自己牌,l 1p或.1看玩家1的牌                │\n    │                  l all或..看全部,l end看流局l dump。  看牌        │\n    │        mo          ----------                               摸牌        │\n    │        dump          dump <代码>。                        打牌        │\n    │        eat          eat <代码1> <代码2>"
            "。                吃牌        │\n    │        pon          ----------                               碰牌        │\n    │        gon          gon 或 gon <代码>(暗  用)。                 牌        │\n    │        hu                                               胡牌        │\n    │        setmj          help setmj。                               设定参数 │\n    │        start          ----------                               牌局开始 │\n    │        restart   restart 或 restart mj。               重新开始 │\n    │        top          top aip,top -p,top -w,top -h,top -d             "
            "   │\n    │                  top -l看全部,-lw,-lh,-ld。               查资料        │\n    └—————————————————————————————┘\n");
    return 1;
}

int to_say_rule() {
    write(" \n　　每胡就有底台５，在加上所得的台就是总台，要是自摸就＊３，相当於五一的算法。\n放枪就由总战绩那扣掉所失的台数。胡者则加上去。\n \n");
    return 1;
}

int show_top(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    mixed v9;
    mixed v10;
    v8 = ({ "", "", "", "", "", "" });
    v9 = "";
    if (!arg) {
        arg = this_player()->query("id");
    } else if (arg == "-lp" || arg == "-pl" || arg == "-l") {
        arg = "all1";
    } else if (arg == "-lw" || arg == "-wl") {
        arg = "all2";
    } else if (arg == "-lh" || arg == "-hl") {
        arg = "all3";
    } else if (arg == "-ld" || arg == "-dl") {
        arg = "all4";
    }
    if (file_size("/data/obj/mj_data.o") == -1) {
        return notify_fail("资料档没没有找到。\n");
    }
    v10 = explode(read_file("/data/obj/mj_data.o"), ",");
    if (arg == "all1") {
