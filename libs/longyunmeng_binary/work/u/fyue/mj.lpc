int do_addin() {
    mixed v1;
    v1 = this_player();
    if (v1->query("id") == P1Data["Id"] || v1->query("id") == P2Data["Id"] || v1->query("id") == P3Data["Id"] || v1->query("id") == P4Data["Id"]) {
        if (!Playing) {
            message_vision("$N对着欠脚啊～～不停的哭哭啼啼.....。\n", v1);
        } else {
            message_vision("$N对着大家说今天自摸" + (random(12) + 1) + "次就好。\n", v1);
        }
        return 1;
    }
    if (Playing) {
        if (random(1)) {
            message_vision(this_object()->name() + "对着" + v1->name() + "说道：牌局正在进行中请到旁边坐一下...。\n", v1);
        } else {
            message_vision("$N对着我也要玩啦～～不停的哭哭啼啼.....。\n", v1);
        }
        return 1;
    }
    if (!P1Data["Id"] || P1Data["Id"] == "") {
        P1Data["Id"] = v1->query("id");
        NowPlayerId[Play] = v1->query("id");
        message_vision("$N加入了这场牌局。\n", v1);
        Play++;
        Times = 0;
        LookP += "在前面有" + v1->name() + "，";
        return 1;
    } else if (!P2Data["Id"] || P2Data["Id"] == "") {
        P2Data["Id"] = v1->query("id");
        message_vision("$N加入了这场牌局。\n", v1);
        NowPlayerId[Play] = v1->query("id");
        Play++;
        Times = 0;
        LookP += v1->name() + "，";
        return 1;
    } else if (!P3Data["Id"] || P3Data["Id"] == "") {
        P3Data["Id"] = v1->query("id");
        message_vision("$N加入了这场牌局。\n", v1);
        NowPlayerId[Play] = v1->query("id");
        Play++;
        Times = 0;
        LookP += v1->name() + "，";
        return 1;
    } else if (!P4Data["Id"] || P4Data["Id"] == "") {
        P4Data["Id"] = v1->query("id");
        message_vision("$N加入了这场牌局。\n", v1);
        NowPlayerId[Play] = v1->query("id");
        Play++;
        Times = 0;
        LookP += v1->name();
        return wash_mj(Play);
    }
    return notify_fail("人数已足。\n");
}

