int do_eat(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    v5 = this_player();
    if (!arg || sscanf(arg, "%s %s", v3, v4) != 2) {
        return 0;
    }
    if (check_id(v5->query("id"), "player") == "") {
        command("stare " + v5->query("id"));
        command("say 这牌局跟你没关系。");
        return 1;
    }
    if (!Playing) {
        command("say 牌局还没开始。");
        return 1;
    }
    tell_object(v5, "换谁摸牌:" + NowPlayerId[NowPlayer] + "\n");
    if (v5->query("id") != NowPlayerId[NowPlayer]) {
        command("hammer " + v5->query("id"));
        command("say 还没轮到你。");
        return 1;
    }
    if (!LastDump || LastDump == "") {
        command("hammer " + v5->query("id"));
        command("say 摸牌吧。");
        return 1;
    }
    if (Touched) {
        command("flop " + v5->query("id"));
        command("say 打牌啦!!");
        return 1;
    }
    if (!do_check_eat(v3, v4, LastDump)) {
        command("flop " + v5->name());
        command("say 你眼精花了ㄚ!!这样也能吃。");
        return 1;
    }
    if (v3 == v4) {
        command("flop " + v5->name());
        command("say 相同的牌不能吃。");
        return 1;
    }
    if (v5->query("id") == P1Data["Id"]) {
        v6 = P1Data;
    } else if (v5->query("id") == P2Data["Id"]) {
        v6 = P2Data;
    } else if (v5->query("id") == P3Data["Id"]) {
        v6 = P3Data;
    } else if (v5->query("id") == P4Data["Id"]) {
        v6 = P4Data;
    }
    v1 = do_check_Mj(MjE, v3);
    if (!v1) {
        return notify_fail("没有[" + v3 + "]这种代码。\n");
    }
    v1 = do_check_Mj(MjE, v4);
    if (!v1) {
        return notify_fail("没有[" + v4 + "]这种代码。\n");
    }
    v1 = do_check_Mj(v6["Mj"], v3);
    if (!v1) {
        return notify_fail("你没" + do_check_num(v3, 0) + "这张牌。\n");
    }
    v1 = do_check_Mj(v6["Mj"], v4);
    if (!v1) {
        return notify_fail("你没" + do_check_num(v4, 0) + "这张牌。\n");
    }
    message_vision("\n$N拿出了一张\e[1;32m" + do_check_num(v3, 0) + "\e" + "[2;37;0m" + "与一张" + "\e" + "[1;33m" + do_check_num(v4, 0) + "\e" + "[2;37;0m" + "吃下了" + "\e" + "[1;31m" + do_check_num(LastDump, 0) + "\e" + "[2;37;0m" + "。\n\n", v5);
    v6["Out"] += v4;
    v6["Out"] += LastDump;
    v6["Out"] += v3;
    v6["Mj"] = do_delete_Mj(v6["Mj"], v3, 1);
    v6["Mj"] = do_delete_Mj(v6["Mj"], v4, 1);
    Touched = 1;
    NO_HU = 1;
    NO_GON = 1;
    v2 = 0;
    if (v6["Show"] == "代码") {
        v2 = 3;
    }
    if (v6["Show"] == "color") {
        v2 = 5;
    }
    tell_object(v5, show_mj(v6["Mj"], v2));
    return delete_last_dump(v6["Id"]);
}

int do_gon(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!arg2) {
        arg2 = this_player();
    }
    if (check_id(arg2->query("id"), "player") == "") {
        command("stare " + arg2->query("id"));
        command("say 这牌局跟你没关系。");
        return 1;
    }
    if (!Playing) {
        command("say 牌局还没开始!!");
        return 1;
    }
    if (LastDumpId == arg2->query("id")) {
        command("stare " + arg2->query("id"));
        command("say 那张牌是你自己打的!。");
        return 1;
    }
    if (Touched && NowPlayerId[NowPlayer] != arg2->query("id")) {
        command("hammer " + arg2->query("id"));
        command("say 别人没打牌你怎麽  。");
        return 1;
    }
    if (!arg1) {
        arg1 = LastDump;
    }
    if (arg2->query("id") == P1Data["Id"]) {
        v2 = P1Data;
    } else if (arg2->query("id") == P2Data["Id"]) {
        v2 = P2Data;
    } else if (arg2->query("id") == P3Data["Id"]) {
        v2 = P3Data;
    } else if (arg2->query("id") == P4Data["Id"]) {
        v2 = P4Data;
    }
    if (v2["Auto"] == "auto") {
        return 1;
    }
    v1 = do_check_Mj(v2["Mj"], arg1);
    if (v1 == 1) {
        if (!Touched) {
            return notify_fail("你还没摸牌。\n");
        }
        v1 = do_check_Mj(v2["OutPon"], arg1);
        if (!v1) {
            return notify_fail("你只有一张不能  。\n");
        }
        if (NO_GON) {
            return notify_fail("这样无法  牌。\n");
        }
        message_vision("\n$N说道：\e[1;34m木贡\e[2;37;0m～～～\n\n", arg2);
        v2["Mj"] = do_delete_Mj(v2["Mj"], arg1, 1);
        sort_data(v2["OutPon"] += arg1);
        arg1 = List[end..end + 1];
        end -= 2;
        Goned++;
        message_vision("\n$N从後面补了一张牌。\n\n", arg2);
        printf("你补到一张%s\n", do_check_num(arg1, 0));
        v1 = 0;
        if (v2["Show"] == "代码") {
            v1 = 3;
        }
        if (v2["Show"] == "color") {
            v1 = 5;
        }
        v2["Mj"] += arg1;
        check_flower(v2);
        tell_object(arg2, show_mj(v2["Mj"], v1));
        Touched = 1;
        return 1;
    }
    if (v1 < 3) {
        return notify_fail("你手中要有叁张" + do_check_num(arg1, 0) + "才能  。\n");
    }
    if (!Touched) {
        if (arg1 != LastDump) {
            return notify_fail("这样无法  。\n");
        }
    } else if (v1 < 4) {
        return notify_fail("你手中要有四张" + do_check_num(arg1, 0) + "才能暗  。\n");
    }
    for (v1 = 0; v1 < Play; v1++) {
        if (NowPlayerId[NowPlayer] == arg2->query("id")) {
            break;
        }
        NowPlayer++;
        NowPlayer %= Play;
    }
    v2["Mj"] = do_delete_Mj(v2["Mj"], arg1, 3);
    if (Touched && NowPlayerId[NowPlayer] == arg2->query("id")) {
        NO_HU = 0;
        message_vision("\n$N脸上露出邪恶的笑容说道：暗  hehe.....\n\n", arg2);
        v2["Mj"] = do_delete_Mj(v2["Mj"], arg1, 1);
        for (v1 = 0; v1 < 4; v1++) {
            v2["Out"] += "xx";
        }
        for (v1 = 0; v1 < 4; v1++) {
            v2["OutGon"] += arg1;
        }
    } else {
        NO_HU = 1;
        message_vision("\n$N大叫：" + do_check_num(arg1, 0) + "～" + "\e" + "[1;37m" + "木贡～～～" + "\e" + "[2;37;0m" + "\n\n", arg2);
        for (v1 = 0; v1 < 4; v1++) {
            v2["Out"] += arg1;
        }
    }
    arg1 = List[end..end + 1];
    end -= 2;
    Goned++;
    message_vision("$N从後面补了一张牌。\n", arg2);
    tell_object(arg2, "你补到一张" + do_check_num(arg1, 0) + "\n");
    v2["Mj"] += arg1;
    check_flower(v2);
    v1 = 0;
    if (v2["Show"] == "代码") {
        v1 = 3;
    }
    if (v2["Show"] == "color") {
        v1 = 5;
    }
    tell_object(arg2, show_mj(v2["Mj"], v1));
    if (Touched) {
        return 1;
    }
    Touched = 1;
    return delete_last_dump(v2["Id"]);
}

varargs int do_win(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    v3 = ({ 0, 0, 0, 0 });
    v4 = "";
    if (!arg2) {
        arg2 = this_player();
    }
    if (check_id(arg2->query("id"), "player") == "") {
        command("stare " + arg2->query("id"));
        command("say 这牌局跟你没关系。");
        return 1;
    }
    if (!Playing) {
        command("say 牌局还没开始...");
        return 1;
    }
    if (NO_HU || LastDumpId == arg2->query("id")) {
        return notify_fail("这样不能胡牌。\n");
    }
    if (LastDump == "" && Touched) {
        message_vision("\n$N大叫：\e[1;37m天～～～胡～～～\e[2;37;0m\n\n", arg2);
