    case 0:
        say("老何笑咪咪地说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，进来喝几盅酒，歇歇腿吧。\n");
        break;
    case 1:
        say("老何用脖子上的毛巾抹了抹手，说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，请进请进。\n");
        break;
    }
}

void saying(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
