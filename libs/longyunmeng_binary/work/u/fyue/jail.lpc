int do_free(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    if (!(v2 = present(arg, this_object()))) {
        return notify_fail("释放谁?\n");
    }
    message_vision("$N将$n释放了!\n", v1, v2);
    message("system", "\n\n  \e[1;32m " + v2->name(1) + "出狱了, 希望他能改过自新, 下次不要再犯法了。\e[0m\n\n", users());
    v4 = v2->query("putjail_position");
    if (v4) {
        v3 = find_object(v4, 1);
        if (v3 && v3 != this_object()) {
            message_vision("$N被传送回" + v3->query("short") + "了..\n", v2);
            v2->move(v3);
        } else {
            v2->move("/d/city/wumiao");
        }
    } else {
        v2->move("/d/city/wumiao");
    }
    v2->delete_temp("out_of_power");
    v2->delete("putjail_time");
    v2->delete("putjail_position");
    v2->save();
    return 1;
}

