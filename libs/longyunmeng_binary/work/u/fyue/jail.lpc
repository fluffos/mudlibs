void auto_free(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!arg1) {
        return;
    }
    if (environment(arg1) != this_object()) {
        arg1->delete("putjail_position");
        arg1->delete("putjail_time");
        arg1->delete_temp("out_of_power");
        return;
    }
    if (arg2 < 1) {
        message("system", "\n\n  \e[1;32m " + arg1->name(1) + "出狱了, 希望他能改过自新, 下次不要再犯法了。\e[0m\n\n", users());
        v1 = arg1->query("putjail_position");
        if (v1) {
            v2 = find_object(v1, 1);
        }
        if (v2 && v2 != this_object()) {
            arg1->move(v2);
        } else {
            arg1->move("/d/city/wumiao");
        }
        arg1->delete_temp("out_of_power");
        arg1->delete("putjail_position");
        arg1->delete("putjail_time");
        arg1->save();
        return;
    }
    message_vision("$N的刑期还有" + arg2 + "秒.\n", arg1);
    arg1->set("putjail_time", arg2);
    arg1->save();
    if (arg2 > 300) {
        call_out("auto_free", 300, arg1, arg2 - 300);
    } else {
        call_out("auto_free", arg2, arg1, 0);
    }
    return;
}
