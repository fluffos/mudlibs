int do_countdown(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (sscanf(arg, "%s %d", v3, v2) != 2) {
        return notify_fail("time <who> <几秒>\n");
    }
    if (!(v1 = present(v3, this_object()))) {
        return notify_fail("自动释放谁?\n");
    }
    if (v2 < 179) {
        return notify_fail("至少要关三分钟!! (180秒)\n");
    }
    message_vision("$N将$n的监禁时间设定为" + v2 + "秒。\n", this_player(), v1);
    v1->set("putjail_time", v2);
    v1->save();
    v1->move("/u/fyue/jail");
    call_out("auto_free", 180, v1, v2 - 180);
    return 1;
}

