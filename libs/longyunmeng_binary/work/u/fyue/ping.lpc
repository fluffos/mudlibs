int ask_working() {
    mixed v1;
    v1 = this_player();
    if (v1->query("combat_exp") > 500000) {
        message_vision("平一指对$N说道：“阁下一代高手，小店劳烦不起。呵。。。呵。。。”\n", v1);
        return 1;
    }
    if (v1->query_temp("fengyaobegin")) {
        message_vision("平一指对$N说道：“你不是已经要了工作了，还不去干！”\n", v1);
        return 1;
    }
    if (v1->query("qi") < random(30)) {
        message_vision("平一指对$N说道：“算了吧你，都这样了还想工作，把药分错了会出人命的。”\n", v1);
        return 1;
    }
    if (v1->query_temp("fengyaoover")) {
        message_vision("平一指对$N说道：“哦？ 你连自己的工资也不要。”\n", v1);
        message_vision("平一指对$N说道：“好吧，既然这样我也就不勉强你了。”\n", v1);
        message_vision("平一指对$N说道：“那你就到内室去帮我再分次药吧。”\n", v1);
        v1->delete_temp("fengyaow");
        v1->delete_temp("fengyaoover");
        v1->set_temp("fengyaobegin", 1);
        return 1;
    }
    message_vision("平一指对$N说道：“好吧，那你就到内室去帮我分分药吧。”\n", v1);
    v1->set_temp("fengyaobegin", 1);
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg1->query_temp("count")) {
        if (arg2->query("money_id") && arg2->value() >= arg1->query_temp("count") * 1000) {
            arg1->set("eff_qi", arg1->query("max_qi"));
            arg1->set("eff_jing", arg1->query("max_jing"));
            arg1->set("eff_gin", arg1->query("max_gin"));
            arg1->apply_condition("drunk", 0);
            tell_object(arg1, "平一指拿出些药丸给你服下，不一会，你的气色看起来好多了。\n");
            arg1->set_temp("count", 0);
            return 1;
        } else {
            tell_object(arg1, "平一指冷冷一笑：你的诚意不够，还是请回吧！\n");
        }
    }
}

