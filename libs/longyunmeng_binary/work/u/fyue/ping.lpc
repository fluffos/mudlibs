string value_string(mixed arg) {
    if (arg < 1) {
        arg = 1;
    } else if (arg < 100) {
        return chinese_number(arg) + "文钱";
    } else if (arg < 10000) {
        return chinese_number(arg / 100) + "两白银" + (arg % 100 ? "又" + chinese_number(arg % 100) + "文钱" : "");
    } else {
        return chinese_number(arg / 10000) + "两黄金" + (arg % 10000 / 100 ? chinese_number(arg % 10000 / 100) + "两白银" : "") + (arg % 10000 % 100 ? "又" + chinese_number(arg % 10000 % 100) + "文钱" : "");
    }
}

