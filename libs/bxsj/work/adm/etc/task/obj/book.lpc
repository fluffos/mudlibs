#include <ansi.h>

inherit ITEM;

void create() {
  set_name("孔孟之书", ({ "book", "shu" }));
  set_weight(40);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("task_owner", "zhu xi");
    set("task_owner_cname", "顾炎武");
    set("reward_point", 4);
    set("unit", "本");
    set("no_sell", 1);
    set("no_beg", 1);
    set("value", 1000);

  }
  setup();

}
