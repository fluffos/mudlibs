#include <human.h>

inherit STD_ROOM;

void create() {
    ::create();
    set_short("a village cross-street");
    set_long("A small street traveling west to east through brick dwellings covered in dark ivy, intersecting a road traveling north to south. Several birch trees branch over the street and dwellings. A framework of hexagons glimmer overhead.");
    set_exits(([
        "west": HUMAN_ROOM + "market_st_w7.lpc",
        "north": HUMAN_ROOM + "first_st_n1.lpc",
        "east": HUMAN_ROOM + "market_st_w5.lpc",
        "south": HUMAN_ROOM + "first_st_s1.lpc",
    ]));
    set_looks(([
        "street": "A street sign is labeled First St and W. Market St.",
        ({
            "framework",
            "hexagons"
        }): "Far above, the hexagons form a geodesic dome.",
    ]));
}
