/**
 * Disabled: Causes the next line of input to be sent to the specified function.
 *
 * @param args
 */
nomask varargs int input_to(mixed args...) {
    error("efun::input_to disabled");
}

/**
 * Disabled: The current player object.
 * Use this_user() instead.
 *
 * @param flag
 */
nomask varargs object this_player(int flag) {
    error("efun::this_player disabled");
}

/**
 * Returns a list of interactive users that have an account set.
 * This excludes the login prompt before account name input.
 *
 * @returns {STD_USER} an array of interactive user accounts
 */
object *users() {
    return filter(efun::users(), (: $1 && $1->query_name() :));
}

/**
 * Write text to the current user or to the debug log.
 *
 * @param msg the text to receive or display
 */
nomask void write(string msg) {
    object character = SEFUN->this_character();
    if (character && character->query_key_name() != "test") {
        character->receive_message("system", msg);
    } else if (efun::this_user()) {
        efun::this_user()->receive_message("system", msg);
    } else {
        if (msg[<1] == '\n') {
            msg = msg[0..<2];
        }
        debug_message(msg);
    }
}

/**
 * Deliver a message to one target, or (if it isn't itself a listener)
 * recurse into its full contents looking for listeners inside it -- the
 * exact semantics of the driver's own do_message() dispatch, reimplemented
 * in LPC. See message() below for why.
 *
 * @param type the type of message
 * @param message text to display
 * @param ob the object to deliver to (or recurse through)
 * @param exclude objects to skip
 */
private void deliver_message(mixed type, string message, object ob, object *exclude) {
    if (!ob || member_array(ob, exclude) > -1) {
        return;
    }
    if (interactive(ob) || function_exists("receive_message", ob)) {
        catch(ob->receive_message(type, message));
    } else {
        // Single arg only on this driver (the internal recursion depth
        // do_message() itself uses is exactly one level too -- its "1"
        // argument to the internal all_inventory() means "include hidden
        // objects", not "recurse deeper"; that hidden-object nuance is
        // the one edge case this LPC reimplementation doesn't replicate).
        object *contents = all_inventory(ob);
        foreach (object item in contents) {
            if (member_array(item, exclude) > -1) {
                continue;
            }
            if (interactive(item) || function_exists("receive_message", item)) {
                catch(item->receive_message(type, message));
            }
        }
    }
}

/**
 * Deliver typed messages to the targets.
 *
 * This driver build was NOT compiled with NO_ADD_ACTION (this project's
 * shared driver, unlike the local_options.h this repo ships and expects
 * you to build your own driver from), so the real efun::message() never
 * routes to a target that isn't itself flagged O_LISTENER/interactive --
 * that flag is only auto-set by the driver's own object-init code under
 * `#ifdef NO_ADD_ACTION` (see fluffos's vm/internal/simulate.cc). Since
 * this codebase's whole account/character split relies on message()
 * reaching a plain, non-interactive STD_CHARACTER object (which forwards
 * to its owning STD_USER's receive_message()), every message() call to a
 * character (or to a room, to reach the characters standing in it) was
 * silently swallowed -- confirmed live: catch(message("room", "x", ob))
 * returned 0 (no error) but delivered nothing, while write() (which calls
 * receive_message() directly via -> rather than through efun::message())
 * worked fine. Reimplemented message() entirely in LPC against
 * receive_message(), replicating do_message()'s own dispatch (deliver
 * directly to a listener/interactive target, otherwise recurse into its
 * full inventory looking for one) instead of depending on a driver
 * capability this build doesn't have.
 *
 * @param type the type of message
 * @param message text to display to targets
 * @param target the recipient(s) of message
 * @param exclude an exclusion list of recipients
 */
varargs void message(mixed type, string message, mixed target, mixed exclude) {
    object *targets;

    if (!strlen(message) || (!objectp(target) && !arrayp(target))) {
        return;
    }
    if (objectp(exclude)) {
        exclude = ({ exclude });
    } else if (!arrayp(exclude)) {
        exclude = ({});
    }
    targets = objectp(target) ? ({ target }) : target;
    foreach (object ob in targets) {
        deliver_message(type, message, ob, exclude);
    }
}
