inherit "/std/shadow.lpc";

inherit "/std/living/stats.lpc";
inherit "/std/living/vitals.lpc";

inherit M_CONTAINER;
inherit M_LEVELABLE;

void set_level(int l) {
    levelable::set_level(l);
    vitals::update_vitals(1);
    // @lpc-ignore
    this_object()->update_limbs();  // limbs require vitals
}
