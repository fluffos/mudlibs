 }
 
+/**
+ * This driver build was compiled with PACKAGE_UIDS, which requires these
+ * three applies to exist at all -- get_root_uid()/get_bb_uid() are called
+ * once at master boot (set_master()), and creator_file() is then called by
+ * give_uid_to_object() on EVERY subsequent object load; without any one of
+ * the three the driver refuses to load a single object. This mudlib's own
+ * real access-control model is entirely privs-based (D_ACCESS above, driven
+ * by query_privs()/query_file_privs()), never driver-level uids -- nothing
+ * in this codebase calls getuid()/seteuid() for a real decision -- so a
+ * flat "everyone is Root" stub is a minimal, behavior-preserving shim, not
+ * a new ownership scheme. (Same fix as this project's nightmare3/nightmare4.)
+ */
+string get_root_uid() {
+    return "Root";
+}
+string get_bb_uid() {
+    return "Backbone";
+}
+string creator_file(string _file) {
+    return get_root_uid();
+}
+
+/**
+ * This driver build also has the mudlib_stats package, which asks the master
+ * for the author of its own file and for the domain of "/" once at boot, and
+ * prints a warning on every boot when these applies are missing. They keep
+ * the flat model above: Root is every file's author, and the backbone uid as
+ * a domain makes the driver give each object its creator's domain, which is
+ * what it did without the applies.
+ *
+ * @param {string} _file - path of the file
+ * @returns {string} the author or domain name
+ */
+string author_file(string _file) {
+    return get_root_uid();
+}
+string domain_file(string _file) {
+    return get_bb_uid();
+}
+
