inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object who, string arg)
{
  object me;
  object where = environment(who);
  object rider;
  object ridee;

  if (! arg ||
      ! where ||
      ! (me = present(arg,where)) ||
      ! me->query("ride/msg"))
    return notify_fail ("你想驾驶什么？\n");

  ridee = who->query_temp("ridee");
  if (ridee &&
      environment(ridee) != environment(who))
   ridee = 0;

  if (ridee)
    return notify_fail ("你已经在驾驶"+ridee->name()+"了！\n");

  rider = me->query_temp("rider");
  if (rider &&
      environment(rider) != environment(me))
   rider = 0;

  if (rider)
    return notify_fail (me->name()+"上面已经有人在驾驶了！\n");

  message_vision ("$N整理下衣服，爬上$n，开动引擎！\n",who,me);
  me->set_temp("no_return",1);
  me->set_temp("rider",who);
  who->set_temp("ridee",me);
  me->move(where);
  who->set_temp("ride/dodge",me->query("ride/dodge"));
  who->add_temp("apply/dodge",me->query("ride/dodge"));
  who->set_temp("ride/damage",me->query("ride/damage"));
  who->add_temp("apply/damage",me->query("ride/damage"));
  who->set_temp("ride/attack",me->query("ride/attack"));
  who->add_temp("apply/attack",me->query("ride/attack"));
  who->set_temp("ride/armor",me->query("ride/armor"));
  who->add_temp("apply/armor",me->query("ride/armor"));
  who->set_temp("ride/parry",me->query("ride/parry"));
  who->add_temp("apply/parry",me->query("ride/parry"));
  return 1;
}

int help(object me)
{
    write(@HELP
指令格式 : jiashi <机器人名称>

这个指令可以让你驾驶机器人。

HELP
);
  return 1;
}

