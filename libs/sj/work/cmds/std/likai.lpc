inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object who, string arg)
{
  object me;
  object where = environment(who);

  if (! arg ||
      ! where ||
      ! (me = present(arg,where)) ||
      ! me->query("ride/msg"))
    return notify_fail ("你想从什么上下来？\n");

  if (me != who->query_temp("ridee"))
    return notify_fail ("你并没有驾驶"+me->name()+"。\n");
      
  message_vision ("$N关闭引擎，从$n的楼梯上爬了下来。\n",who,me);
  me->set_temp("no_return",0);
  me->set_temp("rider",0);
  who->set_temp("ridee",0);          
  who->add_temp("apply/dodge",-who->query_temp("ride/dodge"));
  who->add_temp("apply/damage",-who->query_temp("ride/damage"));
  who->add_temp("apply/attack",-who->query_temp("ride/attack"));
  who->add_temp("apply/armor",-who->query_temp("ride/armor"));
  who->add_temp("apply/parry",-who->query_temp("ride/parry"));
  who->set_temp("ride/dodge",0);
  who->set_temp("ride/damage",0);
  who->set_temp("ride/attack",0);
  who->set_temp("ride/armor",0);
  who->set_temp("ride/parry",0);
  return 1;
}

int help(object me)
{
    write(@HELP
指令格式 : likai <机器人名称>

这个指令可以让你从机器人上下来。

HELP
);
  return 1;
}

