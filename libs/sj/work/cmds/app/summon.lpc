// summon command..

inherit F_CLEAN_UP;
inherit F_DBASE;
#include <ansi.h>
int main(object me, string str)
{
        object ob;
        int i;
        if (!str) return notify_fail("<Syntax>: Summon <player id>\n");
        ob = LOGIN_D->find_body(str);
        if (!ob) return notify_fail("咦... 有这个人吗?\n");
        if (ob->query("block/time",1)) 
        return notify_fail("此人正在被关押期间，你不能随意放他出来。\n");
          if( (wiz_level(me) < wiz_level(ob)) || (wiz_level(me) == wiz_level(ob)) )
                    if( wiz_level(me) != wiz_level("(zhuguan)") )
                          return notify_fail("你无权对等级比你高的巫师或天神使用这条指令.\n");
        // moving
        tell_room(environment(ob),HIY"\n周围升起一片黄色的祥云把"+
        (string)ob->query("name")+"托了起来, 然後不见了.\n"NOR, ob);
        tell_object(ob,HIY"一片黄色的祥云把你托了起来, 你感到周围呼呼风响，一阵晕眩...\n"NOR);
        ob->move(environment(me));
        tell_object(me, CYN"你把"+(string)ob->query("name")+"弄到你的面前.\n"NOR);
        tell_object(ob,CYN".... 醒来时发现是"+(string)me->query("name")+
        "把你弄过来的.\n"NOR);
        tell_room(environment(ob),(string)ob->query("name")+"突然出现"+
        "在你眼前\n",({me,ob}));
        log_file("cmds/summon",
                sprintf("%s(%s) summon %s(%s) on %s。\n",
                me->name(1), //记录使用命令的人名
                geteuid(me), //记录使用命令的ID
                ob->name(1),
                geteuid(ob),
           ctime(time())));
        // ok ..
        return 1;
}

int help(object me)
{
write(@HELP
指令格式 : summon <某人>

此指令可让你(你)将某人抓到你面前。
HELP
    );
    return 1;
}

