#include "/doc/help.h"
#include "ansi.h"
inherit F_CLEAN_UP;
int main(object me, string arg) {
  int heal, heal1, neili;
  object ob;
  if (arg)
    if (LOGIN_D->find_body(arg))
      ob = LOGIN_D->find_body(arg);
    else
      ob = present(arg, environment(me));
  else
    ob = me;
  if (ob)
    me = ob;
  else return notify_fail("使用错误。\n");
  heal = (int)me->query("max_qi") - (int)me->query("qi");
  heal1 = (int)me->query("max_qi") - (int)me->query("eff_qi");
  me->add("eff_qi", heal1);
  me->add("qi", heal);
  heal = (int)me->query("max_jing") - (int)me->query("jing");
  heal1 = (int)me->query("max_jing") - (int)me->query("eff_jing");
  //       if ((me->query("max_neili")) > (me->query("neili")))
  //       neili = (int)me->query("neili");
  //       else
  neili = (int)me->query("max_neili");

  me->add("eff_jing", heal1);
  me->add("jing", heal);
  me->set("neili", neili);
  heal = me->max_water_capacity();
  heal1 = me->max_food_capacity();
  me->set("food", heal1);
  me->set("water", heal);
  message_vision(BLINK + HIG + "$N恢复成功!" + NOR "\n", me);
  return 1;
}
int help() {
  write(@TEXT
指令格式：full
这个指令让你加满精气神。
TEXT
  );
  return 1;
}
