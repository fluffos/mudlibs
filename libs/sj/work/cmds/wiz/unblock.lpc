//unblock.c
#include <ansi.h>
 
inherit F_CLEAN_UP;
inherit F_DBASE;
 
void auto_post(string title,string arg);
 
void create() 
{
        seteuid(getuid());
        set("channel_id","游戏精灵(assoil)");
}
 
int main(object me, string arg)
{
        object ob;
        string who,why;
 
         if (!arg) return notify_fail("<格式>: unblock <玩家> because <原因>.\n");

        if( sscanf(arg,"%s because %s",who,why) != 2 )
                 return notify_fail("<格式>: unblock <玩家> because <原因>.\n");

        ob = LOGIN_D->find_body(who);
        if (!ob) return notify_fail("No suck player online now ...\n");

        // moving

        tell_object(ob,RED"\n\n一阵大风刮来, 你眼前一阵黑....\n\n"NOR);

           ob->delete("block/time");
         ob->move("/d/city/startroom");
         ob->set("startroom","/d/city/startroom");        tell_object(me, "你把"+(string)ob->query("name")+"从沧海中释放了出来。\n");

        tell_object(ob,YEL"\n.... 醒来时发现是"+(string)me->query("name")+
                        "把你从沧海总解救了出来。\n\n"NOR);

        auto_post(
                sprintf("公告：%s离开了沧海.",ob->name()),

                sprintf("%s(%s) 因为"HIG"%s"NOR"的缘故，\n"
                          "受到"+(string)me->query("name")+"的特赦将其提前释放出沧海。\n\n",
                        ob->name(),ob->query("id"),why,
                         CTIME_D->chinese_time((int)ob->query("block/time"))
        ) );

        if( !wizardp(ob) )
                CHANNEL_D->do_channel(this_object(),"rumor",ob->query("name")+"离开了沧海。");
 write("ok!\n");
        return 1;
}

void auto_post(string title,string body) {
        mapping note;
        object POSTER;
          if( objectp(POSTER=load_object("/clone/board/news_b")) )
        {
                note=([]);
                note["title"] = title;;
                note["author"] = sprintf("%s(%s)",this_player()->query("name"),this_player()->query("id"));
                note["time"] = time();
                POSTER->done_post(this_player(),note,body);
        }
        return;
}

int help(object me)
{
write(@HELP
指令格式 : unblock <某人> because <原因>

此指令可让你(你)将某人放出沧海。
HELP
    );
    return 1;
}


