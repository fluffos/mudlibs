#include <ansi.h>
inherit F_CLEAN_UP;

#define RENWU "/adm/etc/renwu"
mapping wizlevel=([
"(zhuguan)"    : WHT "\n〖宇宙特警〗:" NOR,
"(admin)"      : HIW "\n〖银河特警〗:" NOR,
"(arch)"       : HIY "\n〖星际特警〗:" NOR,
"(wizard)"     : HIG "\n〖国际刑警〗:" NOR,
"(apprentice)" : HIC "\n〖国内巡警〗:" NOR,
"(immortal)"   : HIM "\n〖普通民警〗:" NOR,
]);

int main(object me, string arg)
{
      
        string *list,wiz,quest,msg;
        int i,j;
        mapping quests=([ ]);
        object ob;
        int flag,count;
        
        if (file_size(RENWU))
                foreach (string str in explode(read_file(RENWU),"\n")){
                if( str[0]=='#' || sscanf(str, "%s %s", wiz, quest)!=2 ) continue;
                quests+=([ wiz : quest ]);
            }
        write(MUD_NAME + "目前的管理人员有：");
write(HIC"\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"NOR);
    list = SECURITY_D->query_wizlist();
        count=0;
        for (i=11;i > 0;i--){
            flag=1;
            msg="";
            j=0;
            if(i==10) continue;
            foreach (wiz in list){
                     if (wiz_level(wiz)==i){
                    j++;
                    if (flag){
                             msg+= wizlevel[wizhood(wiz)]+"\n";
                        flag=0;
                    }
                 if (objectp(ob=find_player(wiz)) && me->visible(ob) )
                           msg+=(j%4?" ":"\n")+NOR+CYN+wiz+NOR" ";
                    else
                            msg+=(j%4?" ":"\n")+wiz+" ";
                     if (undefinedp(quests[wiz]))
                          msg+="(任务未定)";
                    else
                           msg+="("+quests[wiz]+")";
                      count++;
                }
            }
            write(msg);
        }
write(HIC"\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"NOR);
       
          write("\n共有: "HIR+chinese_number(count)+NOR" 位。其中"NOR+CYN"天蓝色"NOR"的表示在线管理人员。\n");
   
        return 1;
}

int help(object me)
{
write(@HELP
指令格式 : wizlist

用途 : 列出目前所有的巫师名单。
HELP
     );
     return 1;
}


