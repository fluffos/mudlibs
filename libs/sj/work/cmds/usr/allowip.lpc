//cmds/usr/allowip.c
// 欢乐英雄
// allowip.c玩家指定合法的登录IP地址。
// creatied by lion@hero
 
#define MAX_VARS        20
 
inherit F_CLEAN_UP;
 
int help();
int check_allowip();
int check_player_allowip(object); 

int main(object me, string arg)
{
    int i;
    int ip1,ip2,ip3,ip4;
    string term, *terms;
    string site;
    mapping allowip;
    ip1 = -1;
    ip2 = -1;
    ip3 = -1;
    ip4 = -1;
   if( me != this_player(1) ) return 0;
        allowip = me->query("allowip");
        if( !arg || arg=="" ) {
                if(!mapp(allowip) || !sizeof(allowip) )
                        write("你目前没有设定合法登录IP,请用allowip <ip>命令设定。\n");
            
            else {
                    terms = keys(allowip); 
                write("你目前设定的合法登录IP有：\n");
                        for(i=0; i<sizeof(terms); i++)
                                printf("   %s\n", terms[i]);
                }
                return 1;
        }

   if(sizeof(allowip)>= MAX_VARS)
       return notify_fail("你最多可以设定"+MAX_VARS+"个合法IP范围。\n");
 //i hate to do so,only to prevent bugs. by lion
 if(sscanf(arg,"%d.%d.%d.%d",ip1,ip2,ip3,ip4)<2)
                    return help();
if(ip1<0||ip1>255||ip2<0||ip2>255)
                    return help();

    site = ip1+"."+ip2;
    if(ip3>=0&&ip3<256)
    site +="."+ip3;
    if(ip4>=0&&ip4<256)
    site +="."+ip4;
if(mapp(allowip))
   {
   terms = keys(allowip); 
  i = sizeof(terms);
  while(i--)
    if(site==terms[i])
        {
    me->delete("allowip/"+terms[i]);
    write("你删除了IP设定："+site+"\n");
      return 1;    
      }
   } 
 me->set("allowip/"+site,1);
 write("你增加了IP设定："+site+"\n");
 return 1;   

}


int help()
{
        write(@TEXT
指令格式：allowip <IP地址>
 
这个指令让你指定你合法的登录IP地址范围，以后有人使用你的帐号登录本游戏的时候，
我们将首先根据你的设定判断他登录的IP是否合法，如果不合法，即使他知道了你的密码
也无法登录进游戏。
如果不带任何参数的使用本命令，将显示你当前已经设定的合法IP地址范围。
你可以设定最多20个IP地址范围，登录IP跟任何一个你设定的ip范围符合，都将是合法的。

正确的IP地址格式应该是xxx.xxx.xxx.xxx,其中的xxx是0-255之间的整数，例如：
202.117.7.55，如果你使用其他格式，将不能正确设定。
例如：
allowip 202.117.7.55 是指定只有202.117.7.55这一个ip是合法的，
allowip 202.117.7    是指定所有202.117.7.* 的IP地址都是合法的，
allowip 202.117      是指定所有202.117.*.* 的IP地址都是合法的。

值得注意的是，如果您是使用拨号上网，你使用的IP将是不固定的，所以不能使用该命令
指定ip范围。

取消你以前设定的IP范围，只要再用一次allow <ip>命令就可以了。 
TEXT
        );
        return 1;
}


