//  who.c
// 

#include <ansi.h>
#include <net/dns.h>

inherit F_CLEAN_UP;

int sort_user(object,object);

#define ENGLISH_MUD_NAME INTERMUD_MUD_NAME
void create() { seteuid(getuid()); }
int opt_gb, opt_mj, opt_dl, opt_wd, opt_em, opt_hs, opt_xx, opt_mr, opt_thd, opt_sl, opt_qz, opt_gm;
mixed main(object me, string arg, int remote)
{
        string str, *option, fname = "";
        object *list, *ob;
            int SendInterMud=0;
        string HostName,strMsg;
         int i, ppl_cnt, cnt, count, wcnt = 0;
        int opt_long, opt_id, opt_wiz, opt_party;


        if( arg ) {
                option = explode(arg, " ");
                i = sizeof(option);
                while( i-- )
                        switch(option[i]) {
                                case "-l": opt_long = 1; break;
                                case "-w": opt_wiz = 1; break;
                                case "-fenghuang": opt_gb =1; break;
                                case "-budui": opt_gb =1; break;
                                case "-huangzhu": opt_gb =1; break;
                                case "-shengdian": opt_gb =1; break;
                                case "-p": opt_party = 1; break;
                                default:
                        if( option[i][0]=='@' ) {
                        if( !find_object(DNS_MASTER) )
                                return notify_fail("网路精灵并没有被载入，请先将网路精灵载入。\n");
                        SendInterMud=1;
                        HostName=sprintf("%s",option[i][1..sizeof(option[i])]);
                        break;
                        }
                        }
        }

        if (SendInterMud) {
                RWHO_Q->send_rwho_q(HostName,me, strMsg );
                write("网路讯息已送出，请稍候。\n");
                return 1; 
                }
        str = HIG "◎"+MUD_NAME+HIG "◎  "+HIC"目前江湖中 ";
//      if (opt_party) str+=HIR+me->query("family/family_name"); 
     str += HIC"\n≡"+HIY"──────────────────────────────────────"HIC"≡\n"NOR;
        ob = filter_array(objects(), (: userp :));
        if (opt_party)
                ob = filter_array(ob, (: $1->query("family/family_name") ==
                        $2->query("family/family_name") :), me);
        if (opt_mr) ob = filter_array(ob, (: $1->query("family/family_name") == "凤凰星" :));
          if (opt_thd) ob = filter_array(ob, (: $1->query("family/family_name") == "圣 殿" :));
        if (opt_gm) ob = filter_array(ob, (: $1->query("family/family_name") == "特种部队" :));
          if (opt_qz) ob = filter_array(ob, (: $1->query("family/family_name") == "皇 族" :));
        list = sort_array(ob, (: sort_user :));
        ppl_cnt = 0;
        cnt = 0;
        if( opt_long || opt_wiz ) {
                i = sizeof(list);
                while( i-- ) {
                        // Skip those users in login limbo.
                        if( !environment(list[i]) ) continue;
                        if( !me->visible(list[i]) ) continue;
            if( opt_wiz && !wiz_level(list[i]) ) continue;
                        if (interactive(list[i])) ppl_cnt++;
                        else cnt++;
                        str = sprintf("%s%12s%s%s\n",
                                str,
                                RANK_D->query_rank(list[i]),
                                interactive(list[i])?(query_idle(list[i]) > 120?HIM "+" NOR:" "):HIR "#" NOR,
                                list[i]->short(1)
                        );
                }
        } else {
                i = sizeof(list);
                count = 0;
                while( i-- ) {
                        // Skip those users in login limbo.
                        if( !environment(list[i]) ) continue;
                          if( me && !me->visible(list[i]) ) continue;
                          if(!me && (int)list[i]->query("env/invisibility")>0 )                   continue;

                        if (!wiz_level(list[i]) && fname != list[i]->query("family/family_name")) {
                            fname = list[i]->query("family/family_name");
                            if (count % 5) str += "\n";
                                str += sprintf(HIC "%-10s" NOR, (fname?fname:"没门派") + "：");
                            count = 1;
                        }
                        if (!wcnt && wiz_level(list[i])) {
                            if (count % 5) str += "\n";
                              str += sprintf(HIY "%-10s" NOR, "巫  师：");
                            wcnt = 1;
                            count = 1;
                        }
                        if (!(count%5)) {
                                count++;
                                str += "          ";
                        }
                        str = sprintf("%s%s%-16s"NOR"%s",
                                str,
                                interactive(list[i])?(query_idle(list[i]) > 120?HIM "+":" "):HIR "#",
                                list[i]->name(1)+"("+capitalize(list[i]->query("id"))+")",
                                ++count%5 ? "": "\n"
                        );
                        if (interactive(list[i])) ppl_cnt++;
                        else cnt++;
                }
                if( count%5 ) str += "\n";
        }
       str += HIC"≡"+HIY"──────────────────────────────────────"HIC"≡\n"NOR;
        str = sprintf("%s有 %d 位玩家连线中，%d 位玩家断线中，系统负担：%s\n"HIR"#"NOR" 表示断线中  "HIM"+"NOR" 表示发呆中", str, ppl_cnt,
                cnt, query_load_average());

     if( remote ) return str;

        me->start_more(str);
        return 1;
}

int sort_user(object ob1, object ob2)
{
        string name1, name2;

        reset_eval_cost();
        if( wiz_level(ob1) != wiz_level(ob2) )
                return wiz_level(ob2)
                        - wiz_level(ob1);
        
        name1 = ob1->query("family/family_name");
        name2 = ob2->query("family/family_name");

        if (intp(name1)) name1 = "";
        if (intp(name2)) name2 = "";
        if (name1 > name2) return -1;
        if (name1 < name2) return 1;

        return (int)ob2->query("combat_exp") - (int)ob1->query("combat_exp");
}

int help(object me)
{
write(@HELP
指令格式 : who [-l|-w|-p|-gaibang/mingjiao/dali ......]

这个指令可以列出所有在线上的玩家及其等级。

-l 选项列出较长的讯息。
-p 只列出同门的玩家。
-w 只列出线上所有的巫师。
-门派名称 只列出该门派的玩家。

相关指令： finger
HELP
        );
        return 1;
}

