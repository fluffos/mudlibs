inherit BULLETIN_BOARD;
#include <ansi.h>;
void create()
{
  set_name(HIR"圣殿投拆薄"NOR, ({ "board" }) );
        set("location", "/d/shendao/toushu");
        set("board_id", "toushu_b");
        set("long", "这是一个圣殿投拆的留言板,你有什么牢骚在这里发吧。\n" );
        setup();
        set("capacity", 30);
        replace_program(BULLETIN_BOARD);
}
