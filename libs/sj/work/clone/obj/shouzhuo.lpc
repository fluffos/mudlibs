// shouzhuo.c

#include <armor.h>

inherit WRISTS;

void create() {
  set_name("白玉手镯", ({ "shouzhuo" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long",
      "一对白玉手镯，看来值不少钱。\n");
    set("value", 2000);

    set("armor_prop/armor", 4);
    set("armor_prop/defense", 4);
    set("armor_prop/personality", 2);
    set("material", "gold");
  }
  setup();
}
