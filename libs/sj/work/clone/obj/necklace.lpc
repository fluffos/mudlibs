#include <armor.h>

inherit NECK;

void create() {
  set_name("金项链", ({ "necklace" }));
  set_weight(350);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "串");
    set("long",
      "一串精致的金项链，看来值不少钱。\n");
    set("value", 5000);

    set("armor_prop/armor", 3);
    set("armor_prop/defense", 3);
    set("armor_prop/personality", 3);
    set("material", "gold");
  }
  setup();
}
