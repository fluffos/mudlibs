// yincai.c

#include <weapon.h>

inherit SWORD;

void create()
{
        set_name("银钗", ({ "cai" }));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "支");
                set("long",
                        "一支银钗，钗头打磨得比较锋利。\n");
                set("value", 2000);

                set("armor_prop/armor", 2);
                set("armor_prop/defense", 2);
                set("armor_prop/personality", 2);
                set("material", "silver");
        }

        init_sword(2);

        setup();
}
