// transite.c   write by fan
inherit ITEM;
#include <ansi.h>
mapping where_map = ([
  "0": "/d/tianlang/street",
  "fh": "/d/fenghuang/fenghuang/luxingchu",
  "tz": "/d/budui/luxingchu",
  "sdi": "/d/shendian/haian",
  "hz": "/d/huang/luxingchu",
  "c": "/d/city/guangchang",
]);
void init() {
  add_action("do_trans", "trans");
}
void create() {
  set_name("魔法传送帖", ({ "trans site", "site" }));
  set_weight(100); set_max_encumbrance(8000);
  set("value", 100);
  set("no_drop", "这样东西不能离开你。\n");
  if (clonep()) set_default_object(__FILE__);
  else {
    set("long", "
用法: trans 要到地放
fh ：通往凤凰星
tz ：通往特种部队
sdi ：通往圣殿
hz ：通往皇族
c  : 城中心广场
\n");
    set("unit", "张");
  }
}
int do_trans(string arg) {
  object me, obj;
  string msg, str;
  str = where_map[arg];
  if (!arg || !stringp(str)) return notify_fail("你要去哪里？\n");
  me = this_player();
  if (!environment(me)->query("outdoors"))
    return notify_fail("在房间内无法使用此传送魔法！\n");

  if (me->is_fighting())
    return notify_fail("战斗中无法使用魔法传送！");
  str += ".lpc";
  if (file_size(str) < 0)
    return notify_fail("没有这个地方。\n");
  if (stringp(msg = me->query("env/msg_mout"))) { if (msg != "") message_vision(msg + "\n", me); }
  message_vision(HIW "空中出现一阵风，把$N吹走了。\n", me);
  me->move(str);
  if (stringp(msg = me->query("env/msg_min"))) {
    if (msg != "") message_vision(msg + "\n", me);
  } else message_vision("$N被一阵风吹了过来。\n", me); return 1;
}
