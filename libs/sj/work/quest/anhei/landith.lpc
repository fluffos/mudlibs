inherit NPC;
#include <ansi.h>
int time_period(int timep, object me);
string join_me(object me);
#define QUEST_D(b)     ("/quest/anhei")

void create() {
  set_name("兰帝斯", ({ "landith" }));
  set("title", "暗黑门左接引使");
  set("long",
    "暗黑门左接引使负责向门下众杀手分派任务。\n");

  set("gender", "男性");
  set("age", 28);

  set("str", 30);
  set("int", 30);
  set("cps", 3000);
  set("cor", 30);

  set("combat_exp", 2000000);
  set("attitude", "heroism");

  set("neili", 10000);
  set("max_neili", 10000);
  set("max_jingli", 10000);

  set("food", 100000000);
  set("water", 100000000);

  set("inquiry", ([
    "join": (: join_me :),
    "暗黑门": "你敢乱说, 小心老子宰了你! \n",
  ]));

  set_skill("sword", 220);
  set_skill("unarmed", 200);
  set_skill("long-jian", 200);
  set_skill("dodge", 250);
  set_skill("guimei", 200);
  map_skill("dodge", "guimei");
  map_skill("sword", "long-jian");

  setup();
  carry_object("/d/anhei/obj/long-jian")->wield();
  carry_object("/d/anhei/obj/long-pao")->wear();
}

int accept_fight(object me) {
  command("say 小子！你赶惹暗黑门, 不要命了！");
  return 0;
}

void init() {
  add_action("give_quest", "quest");
}

string join_me(object me) {
  if ((me->query("quest")))
    return "这位" + RANK_D->query_respect(me) + ", 你已经是暗黑门的弟兄了。";
  else
    return "哦...加入暗黑门是有风险的哟...";
}

int give_quest() {
  mapping quest;
  object me;
  int j, combatexp, timep, factor, num;
  string tag = "1000000";
  string *levels = ({
    "100000",
    "150000",
    "200000",
    "300000",
    "500000",
    "800000",
    "1000000",
    "1300000",
    "1700000",
    "2200000",
    "3000000",
    "4500000",
    "6000000",
    "8000000",
    "10000000",
    "20000000",
    //		"35000000",
    //		"60000000",
    //		"100000000"
  });
  me = this_player();
  combatexp = (int)(me->query("combat_exp"));

  if (combatexp < 100000) {
    message_vision("兰帝斯对$N哼了一声道: 这种小角色还想进暗黑门, 你也真好意思开口....\n", me);
    return 1;
  }

  // Let's see if this player still carries an un-expired task
  if ((quest = me->query("quest"))) {
    if (((int)me->query("task_time")) > time())
      return 0;
    else {
      message_vision("兰帝斯对$N哼了一声道: 真给暗黑门丢脸, 就再给你一次机会试试。\n", me);
      me->set("kee", (int)(me->query("kee") / 2 + 10));
    }
  }

  for (j = sizeof(levels) - 1; j >= 0; j--) {
    if (atoi(levels[j]) <= combatexp) {
      num = j;
      factor = 10;
      break;
    }
  }
  if (num > 0) {
    if (random(50) > 45) {
      num = num - 1;
    }
  } else {
    if ((num < sizeof(levels) - 1) && (random(100) > 95)) {
      num = num + 1;
      factor = 15;
    }
  }
  tag = levels[num];
  quest = QUEST_D(b)->query_quest();
  timep = quest["time"];

  while (quest["quest_type"] == "寻") {
    quest = QUEST_D(tag)->query_quest();
    timep = quest["time"];
  }

  time_period(timep, me);
  tell_object(me, "杀了『" + quest["quest"] + "』为暗黑门立功。\n" NOR);
  quest["exp_bonus"] = quest["exp_bonus"];
  quest["pot_bonus"] = quest["pot_bonus"];
  quest["score"] = quest["score"];

  me->set("quest", quest);
  me->set("task_time", (int)time() + (int)quest["time"]);
  me->set("quest_factor", factor);
  return 1;
}

int time_period(int timep, object me) {
  int t, d, h, m, s;
  string time;
  t = timep;
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d)
    time = chinese_number(d) + "天";
  else
    time = "";

  if (h)
    time += chinese_number(h) + "小时";
  if (m)
    time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";

  tell_object(me, HIW "兰帝斯说道：\n在" + time + "内");
  return 1;
}
