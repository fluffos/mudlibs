#include <ansi.h>


inherit F_SSERVER;

int perform(object me, object target)

{

	int damage;

	object weapon;

	string msg,skill;

	mapping map_skills;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )

		return notify_fail("疾雷八剑「卸字决」只能向战斗中的对手使用。\n");

	if( weapon = target->query_temp("weapon") )

		skill = weapon->query("skill_type");

	else	skill = "unarmed";

	

	if( (int)me->query_skill("jilei-bajian", 1) < 50 )

		return notify_fail("你的疾雷八剑火候不够。\n");

	map_skills = target->query_skill_map();

	if ( target->query_skill_mapped(skill) != 0 )

			skill = map_skills[skill];

	msg = CYN "$N使出疾雷八剑「卸字决」，剑尖直指$n的"+to_chinese(skill)+"中的破绽。\n" NOR;

	if( random(me->query("int")) > random(target->query("int"))/2 ) 
{

		damage = (int)me->query_skill("jilei-bajian", 1);

		damage = random(damage*4/3) + 50;

		target->receive_damage("qi", damage);

		target->receive_wound("qi", damage/3);
                target->start_busy(3);
                target->start_busy(1);

		if( damage < 300 ) msg += HIY"结果$n被$N造成相当严重的刺伤 ！\n"NOR;

        	else if( damage < 700 ) msg += HIR"结果「嗤」地一声$n被$N刺出了一个又长又深的伤口 ！\n"NOR;

        	else msg += RED"结果「噗嗤」地一声，长剑已在$n的身上刺出一个血肉□糊的血窟窿 ！！\n"NOR;

	}
 else {

		msg += "可是$n看破了$N的企图，并没有上当。\n" NOR;

	}

	message_vision(msg, me, target);

	return 1;

}
