#include <ansi.h>

#include <combat.h>


inherit F_SSERVER;

int perform(object me, object target)

{

  int j, damage, jiali;
  jiali = me->query("jiali") + 1;

  damage = me->query_skill("siling-quan", 1) / 40 * jiali;
  if (damage > 1200) damage = 1200;


  j = me->query_skill("siling-quan") / 2;


  if (!target) target = offensive_target(me);


  if (!target || !me->is_fighting(target) || !living(target))

    return notify_fail("「四灵排空」只能在战斗中对对手使用。\n");


  if (objectp(me->query_temp("weapon")))

    return notify_fail("你必须空手才能使用「四灵排空」！\n");


  if ((int)me->query_skill("siling-quan", 1) < 120)

    return notify_fail("你的四灵拳还不够娴熟，使不出「四灵排空」绝技。\n");

  if ((int)me->query_skill("force") < 200)

    return notify_fail("你的内功等级不够，不能使用「四灵排空」。\n");


  if ((int)me->query_str() < 32)

    return notify_fail("你的膂力还不够强劲，使不出「四灵排空」来。\n");


  if (me->query_skill_mapped("unarmed") != "siling-quan"
    || me->query_skill_mapped("parry") != "siling-quan")

    return notify_fail("你现在无法使用「四灵排空」！\n");
  if ((int)me->query("max_neili") < 800)

    return notify_fail("你现在内力太弱，使不出「四灵排空」。\n"); if ((int)me->query("jing") < 100)

      return notify_fail("你现在精神太差，使不出「四灵排空」。\n");

  if ((int)me->query("neili") < 500)

    return notify_fail("你现在真气太弱，使不出「四灵排空」。\n");


  if ((int)me->query_temp("powerup"))

    return notify_fail("你正在使用内功。\n");


  message_vision(WHT "\n$N一声断喝，双拳击出仿佛却是四拳，「四灵排空」挟排山倒海之势击出！\n" NOR, me);


  me->add_temp("apply/unarmed", j / 2);

  me->add_temp("apply/damage", j / 3);

  me->add_temp("apply/attack", j / 3);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  target->receive_damage("qi", damage + 20, me);
  target->receive_wound("qi", damage / 2, me);


  me->add_temp("apply/strike", -j / 2);

  me->add_temp("apply/damage", -j / 3);

  me->add_temp("apply/attack", -j / 3);

  me->add("neili", -400);

  me->add("jing", -70);

  me->start_busy(3);

  target->start_busy(2 + random(2));

  return 1;

}
