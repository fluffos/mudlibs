inherit ITEM;

inherit F_FOOD;


void create()

{

  set_name("蛋糕", ({ "cake", "dan", "gao" }));

  set_weight(120);

  if (clonep())

    set_default_object(__FILE__);

  else {
    set("long", "一块新烤好的蛋糕。\n");

    set("unit", "块");

    set("value", 120);

    set("food_remaining", 7);

    set("food_supply", 50);

  }

}
