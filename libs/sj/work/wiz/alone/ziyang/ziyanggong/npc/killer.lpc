#include <ansi.h>


inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;
int ask_me();
void create() {
  object me;
  int myskill;
  me = this_player();
  myskill = me->query_skill("force");
  if (myskill < me->query_skill("unarmed"))
    myskill = me->query_skill("unarmed");
  if (myskill < me->query_skill("dodge"))
    myskill = me->query_skill("dodge");
  if (myskill < me->query_skill("parry"))
    myskill = me->query_skill("parry");
  set_name("怪兽", ({ "guai shou", "shou" }));
  set("age", 1000);
  set("gender", "雄性");
  set("long", "一只怪兽，用饥饿的目光看着你，样子十分凶狠。\n");
  set("attitude", "heroism");
  set("qi", (me->query("qi") + 100));
  set("max_qi", (me->query("max_qi") + 100));
  set("jing", me->query("jing"));
  set("neili", (me->query("neili") + 300));
  set("max_neili", (me->query("max_neili") + 300));
  set("max_jing", me->query("max_jing"));
  set("str", me->query("str"));
  set("dex", (me->query("dex") + 3));
  set("con", me->query("con"));
  set("killman", me->query("id"));
  set("combat_exp", me->query("combat_exp"));
  set_skill("dodge", myskill);
  set_skill("unarmed", myskill);
  set_skill("force", myskill);
  set_skill("parry", myskill);
  //       set_skill("rennai",myskill);
  set_skill("sword", myskill);
  set_temp("apply/attack", (int)40 + random(30));

  set_temp("apply/damage", (int)random(20) + 10);
  set_temp("apply/parry", (int)random(30) + 50);
  set_temp("apply/dodge", (int)random(20) + 30);
  me->set("jiali", me->query_entire_dbase()["jiali"]);

  setup();
  carry_object("/clone/misc/cloth")->wear();

}
void die() {
  object me = this_player();
  object killer;
  int i, exp, pot, money;
  string skill;
  if (!living(this_object())) revive(1);
  this_object()->clear_condition();

  COMBAT_D->announce(this_object(), "dead");
  if (objectp(killer = query_temp("last_damage_from"))) {
    set_temp("my_killer", killer->query("id"));
    COMBAT_D->killer_reward(killer, this_object());
  }

  if (userp(killer)) {
    exp = random(50) + this_player()->query("kar", 1);
    pot = random(20) + this_player()->query("kar", 1);
    money = random(30) + this_player()->query("kar", 1);
    killer->add("combat_exp", exp);
    killer->add("potential", pot);
    killer->add("money", money);

    tell_object(killer, sprintf(HIY "你得到了%d点战斗力，%d点学习值，%d电子货币。\n" NOR, exp, pot, money));

  }

  this_object()->dismiss_team();
  destruct(this_object());
}
