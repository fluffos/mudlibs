

inherit NPC;

int give_food();

int give_water();

string* foods = ({
       "cake",
       
});

void create()
{
       set_name("林可儿", ({ "lin keer", "lin", "keer" }) );
       set("gender", "女性" );
       set("age", 20);
       set("long",
               "她是紫阳城主龙霁阳的妻子，在这里负责给这里的紫阳城人预备食物。\n");
       set("combat_exp", 1000000);
       set("attitude", "friendly");
       set("rank_info/respect", "夫人");
       set("inquiry", ([
               "name" : "我是林可儿。/n",
	       "food" : (: give_food :),
	       "water" : (: give_water :),	
       ]) );
       setup();
                carry_object(__DIR__"obj/baiyi")->wear();
                carry_object(__DIR__"obj/shoes")->wear();

}

int give_food()
{
       object food, me, ob;

       me = this_object();
       ob = this_player();

       say("林可儿柔声说：“多吃点，别饿坏了，吃完了还有。”\n");

       food = new( __DIR__"obj/" + foods[random(sizeof(foods))] );

       food->move(ob);

       message_vision("$N交给$n一块蛋糕。\n", me, ob);

       return 1;
}
 
int give_water()
{
       object water, me, ob;

       me = this_object();
       ob = this_player();

       say("林可儿柔声道：“这是刚泡好的茶，小心烫。”\n");


       water = new( __DIR__"obj/tea");

       water->move(ob);

       message_vision("$N交给$n一杯热茶。\n", me, ob);

       return 1;
}