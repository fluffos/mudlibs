#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "紫阳宫废墟");
  set("long", @LONG
这里就是紫阳宫的旧址，昔日热闹的景象自然早已不在，代之以残垣断
壁，四处都蒙上了一层厚厚的土，你看着这里的景物，不禁了产生无限
的感慨。
LONG
  );

  set("exits", ([

    "west": __DIR__ "feixu1",
    "north": __DIR__ "feixu5",

  ]));
  setup();

}
void init() {
  add_action("do_west", "west"); write(BLU "你感到周围有些异样！\n" NOR,);
}
int do_west(string arg) {
  object me, killer;
  me = this_player();
  killer = new(__DIR__ "npc/killer");

  if (arg == "" || !arg) {
    if ((me->query("combat_exp") > 80000) && (random(2) < 1))


    {
      message_vision("\n突然黑暗中出现了点点荧光。\n"
        "对你喝道：太好了，可以饱餐一顿了！\n", me);
      killer->move(environment(me));

      killer->kill_ob(me);
      me->improve_skill("parry", (int)(me->query_int() / 5));
    } else me->move(__DIR__ "feixu1");
    return 1;
  }
}
