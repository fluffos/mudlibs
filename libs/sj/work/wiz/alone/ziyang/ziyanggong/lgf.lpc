#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", BLU "练功房" NOR);
  set("long", @LONG

这里是紫阳宫练功室，有很多人在这里练习基本武功，这里的墙是经过
特制的很适合练习使用，左右两边的墙(westwall)(eastwall)分别可
供你练剑和练掌法使用。
LONG
  );
  set("exits", ([
    "west": __DIR__ "zoulang1",
  ]));
  setup();
}

void init() {
  add_action("do_lianxi", "lianxi");

}



int do_lianxi(string arg) {
  mapping fam;
  object me = this_player();

  if (!(fam = me->query("family")) || fam["family_name"] != "紫阳派")
    return notify_fail("你不是紫阳传人，如何能领悟紫阳武功？\n");
  if (me->query("qi") < 30)
    return notify_fail("你该去休息了,心急吃不了烫豆腐。\n");

  if (me->query("jing") < 30)
    return notify_fail("你精力不能集中,去稍作歇息吧. \n");

  if (arg == "westwall") {
    message_vision("$N抡掌劈向前方窄窄的石壁，蓬一声被震退数步，手臂一阵酸麻。\n", me);

    if (me->query_skill("unarmed", 1) > 101)
      return notify_fail("你掌力雄浑，不该再死练蛮力了。\n");

    me->receive_damage("jing", 20);
    me->improve_skill("unarmed", (int)(me->query_int() / 2) +
      (int)(me->query_str() / 3));
    return 1;
  }



  if (arg == "eastwall") {
    message_vision("$N绕东面石壁踏着剑步，用心揣摩壁上剑法精髓。\n", me);

    if (me->query_skill("sword", 1) > 60)
      return notify_fail("你对石壁上所述剑法已全然掌握了. \n");

    me->receive_damage("jing", 20);
    me->improve_skill("sword", (int)(me->query_int() / 2) +
      (int)(me->query_skill("sword", 1) / 4));
    return 1;
  }


  return 0;
}
