inherit ROOM;
#include <ansi.h>
void create()
{
        set("short","临时打工处");
        set("long", @LONG
这里是给刚刚来到紫阳城的人打工的地方，人们在这里赚到一些
食宿的费用，如果你后悔来到这里，也要在这里挣得回去的路费.墙上
贴着的牌子(sign)可以指导你怎样进行工作.
LONG
        );
        set("no_fight",1);

        set("exits", ([
                
   "west"  : __DIR__"street6",
        ]));
        
        
       set("item_desc",(["sign": "想要来打工的人，请在这里使用工作指令(work)\n",
                             
                         ]));
        setup();
        
}
void init()
{
  add_action("do_work", "work");
}
int do_work()
{
        object me;
        int exp;
        me = this_player();

if (me->query("combat_exp")>100000) return notify_fail("您以后可以自立了！\n");
 if ( me->query("qi") < 20 ) return notify_fail("你的生命力不够，休息一下再来吧！\n");
if ( me->is_busy()) return notify_fail("你正忙着呢！\n");
me->add("qi",-random(20));
        if ( random((int)me->query("kar")) < 5 )
        {
                message_vision("$N在工作的时候东张西望，不专心工作，结果一分钱也没拿到.\n", me);
me->start_busy(random(10));
       
       }

        else
        {
                message_vision("$N辛苦地工作着，虽然很累，但也有一种满足感\n", me);
me->add("money",random(20));
me->add("combat_exp",random(15) + 2);
me->add("potential",random(20));
me->start_busy(random(10));
        }

   
return 1;
}

