#include <weapon.h>

inherit SWORD;


void create()

{

	set_name("双刃剑", ({ "shuangren jian","jian", "sword" }));

	set_weight(6000);

	if (clonep())

		set_default_object(__FILE__);

	else {

		set("unit", "柄");

		set("long", "这是一柄双刃利剑,搞不好可能会伤到自己。\n");

		set("value", 6000);

		set("material", "steel");

		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");

		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");

	}

	init_sword(60);

	setup();

}
