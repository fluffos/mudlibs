#include <weapon.h>

inherit SWORD;


void create()

{

  set_name("寒冰剑", ({ "hanbing jian", "jian", "sword" }));

  set_weight(7500);

  if (clonep())

    set_default_object(__FILE__);

  else {

    set("unit", "柄");

    set("long", "这是一柄寒冰所制的剑,握在手中有刺骨的感觉。\n");

    set("value", 40000);

    set("material", "steel");

    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");

    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");

  }

  init_sword(140);

  setup();

}
