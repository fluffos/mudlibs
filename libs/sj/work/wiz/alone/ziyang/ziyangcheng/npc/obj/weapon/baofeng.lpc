#include <weapon.h>

inherit SWORD;


void create()

{

  set_name("暴风之剑", ({ "baofeng jian", "jian", "sword" }));

  set_weight(7000);

  if (clonep())

    set_default_object(__FILE__);

  else {

    set("unit", "柄");

    set("long", "这是一柄传说中的宝剑,据说能呼风唤雨。\n");

    set("value", 15000);

    set("material", "steel");

    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");

    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");

  }

  init_sword(120);

  setup();

}
