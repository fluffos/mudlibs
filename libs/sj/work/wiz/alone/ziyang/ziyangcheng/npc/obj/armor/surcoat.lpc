// necklace.c 肚带

#include <armor.h>

inherit SURCOAT;

void create() {
  set_name("腰带", ({ "yao dai", "surcoat", "dai" }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "leather");
    set("unit", "条");
    set("long", "这是一件皮质的腰带，用以保护腹部。\n");
    set("value", 1100);
    set("armor_prop/parry", 8); set("armor_prop/dodge", -1);
  }
  setup();
}
