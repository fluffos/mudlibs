inherit ITEM;

inherit F_FOOD;


void create()

{

  set_name("饼干", ({ "bing gan", "biscuit", "bing" }));

  set_weight(80);

  if (clonep())

    set_default_object(__FILE__);

  else {
    set("long", "一袋压缩饼干,可以用来充饥。\n");

    set("unit", "袋");

    set("value", 100);

    set("food_remaining", 20);

    set("food_supply", 10);

  }

}
