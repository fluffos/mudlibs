#include <weapon.h>

inherit SWORD;


void create()

{

  set_name("古代魔剑", ({ "mo jian", "jian", "sword" }));

  set_weight(10000);

  if (clonep())

    set_default_object(__FILE__);

  else {

    set("unit", "柄");

    set("long", "这是一柄古代流传下来的据说带有魔法的剑。\n");

    set("value", 80000);

    set("material", "magic");

    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");

    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");

  }

  init_sword(80 + (30 - this_player()->query("per")) * 5);

  setup();

}
