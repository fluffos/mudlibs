inherit MONEY;


void create()

{
  set_name("一千元支票", ({ "zhipiao", "piao", "cash" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "zhipiao");
    set("long", "一张面额一千元的支票。\n");
    set("unit", "叠");
    set("base_value", 1000);
    set("base_unit", "张");
    set("base_weight", 4);
  }
  set_amount(1);
}
