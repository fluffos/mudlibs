// dark-jian.c

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(BLK "暗黑剑" NOR, ({ "dark","sword" }));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "这是把奇怪的兵器，剑上篆刻着几个字"BLK"‘暗黑神器’"NOR"。\n");
                set("value", 4000000);
                set("material", "steel");
                set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中，只觉四周被黑暗包围。\n");
                set("unwield_msg", "$N将手中的$n插回剑鞘，只听嗤的一声轻响。\n");
        }
 init_sword(2000);
        setup();
}
int query_autoload()
{
        return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{

        victim->receive_wound("qi",10);
        return HIW "暗黑剑突然化作一团黑烟，包围着$n的全身。\n" NOR;

}