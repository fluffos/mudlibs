 
#include <ansi.h>
inherit NPC;
int time_period(int timep,object me);
 
void create()
{
        set("chat_chance", 25);
 
        set_name("梦幻", ({ "menghuan" }) );
        set("title", "暗黑门右接引使");
        set("gender", "女性" );
        set("age", 28);
        set("str", 30);
        set("int", 30);
        set("cps",30);
        set("long",
                "暗黑门右接引使负责承接暗杀的生意。\n");
        set("combat_exp", 2000000);
        set("attitude", "heroism");
 
        set("force", 10000);
        set("max_force", 10000);
        set("force_factor", 100);
 
        set_skill("dodge", 200);
        set_skill("unarmed", 200);
        set_skill("sword", 220);
        set_skill("guimei", 200);
        set_skill("anhei-shengong", 200);
	set_skill("anhei-xinfa", 200);
	set_skill("force", 200);
	set_skill("duzun-zhao", 200);
	set_skill("long-jian", 200);
        map_skill("dodge", "guimei");
	map_skill("sword", "long-jian");
        map_skill("unarmed", "duzun-zhao");
	map_skill("force", "anhei-shengong");
 
       set("inquiry", ([  "暗黑门": "你敢乱说, 小心姑奶奶宰了你! \n",
        ]) );
 
        setup();
        carry_object("/d/diyu/obj/long-jian")->wield();
        carry_object("/d/diyu/obj/long-pao")->wear();
}
int accept_fight(object me)
{
        command("say 小子！你赶惹暗黑门, 不要命了！");
        return 0;
}
 
void init()
{
        add_action("give_quest", "quest");
}
 
int give_quest()
{
        mapping quest ;
        object me;
        int j, combatexp, timep,factor,num;
        string tag = "1000000";
 string *levels = ({
 		"100000",
		"150000",
		"200000",
		"300000",
		"500000",
		"800000",
		"1000000",
		"1300000",
		"1700000",
		"2200000",
		"3000000",
		"4500000",
		"6000000",
		"8000000",
		"10000000",
		"20000000",
//		"35000000",
//		"60000000",
//		"100000000"
        });
        me = this_player();
        combatexp = (int) (me->query("combat_exp"));
 
        if(combatexp<100000)
          {
        message_vision("梦幻对$N哼了一声道: 这种小角色还想请暗黑门, 你也真好意思开口...
.\n",me);
         return 1;
          }
 
// Let's see if this player still carries an un-expired task
        if((quest =  me->query("quest")))
        {
        if( ((int) me->query("task_time")) >  time() )
                return 0;
        else
        {
         message_vision("梦幻对$N妩媚的一笑道: 想要暗黑门出手, 先帮我找样东西。\n", me)
;
         me->set("kee",(int)(me->query("kee")/2+10));
        }
        }
 
        for(j= sizeof(levels) - 1 ; j>=0; j--)
        {
                if( atoi(levels[j])  <= combatexp )
                        {
                      num=j;
                          factor=10;
                          break;
                        }
        }
        if (num>0)
        {
                if (random(50)>45)
                {
                num=num-1;
                }
        } else {
                if ((num<sizeof(levels)-1)&&(random(100)>95))
                {
                num=num+1;
                factor=15;
                }
        }
        tag=levels[num];
        quest = QUEST_D(tag)->query_quest();
        timep = quest["time"];
 
        while (quest["quest_type"] == "杀")
        {
        quest = QUEST_D(tag)->query_quest();
        timep = quest["time"];
        }
 
        time_period(timep, me);
        tell_object(me,"先找回『"+quest["quest"]+"』给我,或许我给你派杀手。\n" NOR);
        quest["exp_bonus"]=quest["exp_bonus"];
        quest["pot_bonus"]=quest["pot_bonus"];
        quest["score"]=quest["score"];
 
        me->set("quest", quest);
        me->set("task_time", (int) time()+(int) quest["time"]);
        me->set("quest_factor",factor);
        return 1;
}
 
int time_period(int timep, object me)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;
 
        if(d) time = chinese_number(d) + "天";
        else time = "";
 
        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";
 
        tell_object(me,HIW "梦幻说道：\n在" + time + "内");
        return 1;
}
 
int accept_object(object who, object ob)
{
        int bonus, exp, pot, score,factor;
        string test;
        mapping quest;
 
        if(!(quest =  who->query("quest")))
        {
        tell_object(who,"梦幻说道：这不是我想要的。\n");
        return 0;
        }
 
        if( ob->name(1) != quest["quest"])
        {
        tell_object(who,"梦幻说道：这不是我想要的。\n");
        return 0;
        }
 
        if ((int) who->query("task_time") < time() )
        {
        tell_object(who,"梦幻说道：真可惜！你没有在指定的时间内回来！\n");
        destruct(ob);
        return 0;
        }
 
        else
        {
        tell_object(who,"梦幻说道：对不起！现在暗黑门还不能派杀手！\n");
        exp = quest["exp_bonus"]/2 + random(quest["exp_bonus"]/2);
        pot = quest["pot_bonus"]/2 + random(quest["pot_bonus"]/2);
        score = quest["score"]/2 + random(quest["score"]/2);
        factor=who->query("quest_factor");
        destruct(ob);
 
        if (factor)
        {
                exp=exp*factor/10;
                pot=pot*factor/10;
                score=score*factor/10;
        }
 
        bonus = (int) who->query("combat_exp");
        bonus += exp;
        who->set("combat_exp", bonus);
        bonus = (int) who->query("potential");
        bonus = bonus - (int) who->query("learned_points");
        bonus = bonus + pot;
        if( bonus > 100) bonus = 100;
        bonus += (int) who->query("learned_points");
        who->set("potential", bonus );
        bonus = (int) who->query("score");
        bonus += score;
        who->set("score", bonus);
        tell_object(who,HIW"你被奖励了：\n" + chinese_number(exp)
          + "点战斗力\n"+ chinese_number(pot) + "点潜能\n"
          + chinese_number(score)+"点综合评价\n"NOR);
        who->set("quest", 0 );
        return 0;
        }
     return 0;
}