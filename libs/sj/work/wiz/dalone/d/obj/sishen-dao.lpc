// sishen-dao.c 死神刀

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create() {
  set_name("死神刀", ({ "sishen dao", "dao" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把银光雪亮的死神刀，刀刃间隐隐有血光流动，锋利无匹，
映面生寒。\n");
    set("value", 1000000);
    set("material", "steel");
    set("weapon_prop/strength", 15);
    set("wield_msg", HIY "只听「铮」的一声，死神刀已到了$N的手中。
瞬时天际间风云变色，电闪雷鸣，弥漫着一片无边杀意。\n" NOR);
    set("unwield_msg", HIY "死神刀一下子消失了。\n" NOR);
  }
  init_blade(500);
  setup();
}
