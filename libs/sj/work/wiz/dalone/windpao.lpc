#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name(HIC "疾风战袍" NOR, ({ "wind pao", "pao" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("value", 2250000);
                set("material", "gold");
      set("armor_prop/armor", 1000);
        }
        setup();
}
int query_autoload()
{
        return 1;
}