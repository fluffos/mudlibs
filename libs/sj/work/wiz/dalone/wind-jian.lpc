// wind-jian.c

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(HIC "疾风剑" NOR, ({ "wind","sword" }));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "这是把奇怪的兵器，剑上篆刻着几个字"HIC"‘风的意志’"NOR。\n");
                set("value", 4000000);
                set("material", "steel");
                set("wield_msg", MAG "$N「唰」的一声抽出一柄$n"MAG"握在手中，只觉一阵飓风扑面而来。\n");
                set("unwield_msg", HIW "$N将手中的$n"HIW"插回剑鞘，只听嗤的一声轻响。\n");
        }
 init_sword(2000);
        setup();
}
int query_autoload()
{
        return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{

        victim->receive_wound("qi",10);
        return HIC "疾风剑突然快如飓风，席卷着$n的全身。\n" NOR;

}