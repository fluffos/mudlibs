// jin.c 金山游侠

inherit NPC;

void create() {
  set_name("金山游侠", ({ "jinshan", "jin" }));
  set("nickname", "暗黑六魔");
  set("long",
    "他就是死神的六弟子金山游侠。\n"
    "他今年三十岁，性如烈火。\n");
  set("gender", "男性");
  set("age", 30);
  set("attitude", "heroism");
  set("shen_type", -1);
  set("str", 26);
  set("int", 30);
  set("con", 26);
  set("dex", 28);

  set("max_qi", 2200);
  set("max_jing", 2800);
  set("neili", 5500);
  set("max_neili", 5500);
  set("jiali", 100);
  set("combat_exp", 1250000);
  set("score", 60000);

  set_skill("force", 180);
  set_skill("anhei-shengong", 160);
  set_skill("dodge", 180);
  set_skill("guimei", 160);
  set_skill("unarmed", 180);
  set_skill("duzun-zhao", 160);
  set_skill("parry", 180);
  set_skill("sword", 200);
  set_skill("long-jian", 200);
  //	set_skill("anhei-xinfa", 180);
  set_skill("literate", 180);

  map_skill("force", "anhei-shengong");
  map_skill("dodge", "guimei");
  map_skill("unarmed", "duzun-zhao");
  map_skill("parry", "long-jian");
  map_skill("sword", "long-jian");

  create_family("暗黑门", 3, "游侠");

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "sword.xian" :),
    (: exert_function, "recover" :),
  }));

  setup();
  carry_object("/d/anhei/obj/changjian")->wield();
  carry_object("/d/anhei/obj/cloth")->wear();
}
