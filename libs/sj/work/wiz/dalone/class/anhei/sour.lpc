// sour.c 索尔

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("索尔", ({ "sour" }));
  set("nickname", HIR "暗黑天王" NOR);
  set("long",
    "他就是暗黑门的头领、当今宇宙的邪恶化身。\n"
    "身穿一件黑色长袍。\n"
    "身材高大，正直壮年，英俊潇洒。\n");
  set("gender", "男性");
  set("age", 28);
  set("attitude", "heroism");
  set("shen_type", -1);
  set("str", 40);
  set("int", 40);
  set("con", 40);
  set("dex", 30);

  set("max_qi", 50000);
  set("max_jing", 30000);
  set("neili", 100000);
  set("max_neili", 100000);
  set("jiali", 350);
  set("combat_exp", 20000000);
  set("score", 500000);

  set_skill("force", 300);
  set_skill("anhei-shengong", 300);
  set_skill("dodge", 350);
  set_skill("guimei", 350);
  set_skill("unarmed", 300);
  set_skill("duzun-zhao", 300);
  set_skill("parry", 300);
  set_skill("sword", 300);
  set_skill("blade", 300);
  set_skill("shixue-daofa", 300);
  set_skill("long-jian", 300);
  set_skill("anhei-xinfa", 350);
  set_skill("literate", 100);

  map_skill("force", "anhei-shengong");
  map_skill("dodge", "guimei");
  map_skill("blade", "shixue-daofa");
  map_skill("unarmed", "duzun-zhao");
  map_skill("parry", "long-jian");
  map_skill("sword", "long-jian");

  create_family("暗黑门", 1, "创派祖师");
  set("class", "anhei");

  setup();
  carry_object("/d/anhei/obj/long-pao")->wear();
  carry_object("/d/anhei/obj/long-jian")->wield();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("anhei-shengong", 1) < 50) {
    command("say 我暗黑门乃邪恶门派，不重视内功心法怎能一统天下。");
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在暗黑神功上多下点功夫？");
    return;
  }
  if ((int)ob->query("shen") > -2000) {
    command("say 本门之人，邪恶为先，功夫的高低倒还在其次，未练武，要先学坏。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if (ob->query_int() < 30) {
    command("say 我暗黑门武功全从地狱中悟出。");
    command("say 要能达到炉火纯青之境，体质什么的倒是无关紧要，悟性却是半点也马虎不得。");
    command("say " + RANK_D->query_respect(ob) + "的悟性还大有潜力可挖，还是请回吧。");
    return;
  }
  command("chat 哈哈哈哈！！！！");
  command("chat 想不到本人又觅得一个可塑之才，一统天下的日子不远啦。");
  command("recruit " + ob->query("id"));
}
