// wuliao 1995/12/04 

inherit ROOM;
void create()
{
        set("short", "太空港口");
        set("long", @LONG
这里就是太空港口，整个宇宙的战舰、飞船几乎都要从这里经过。只见边上
停着几百艘庞大的星际战舰。一个看起来十分猥亵的男人正得意洋洋的看着
大家忙碌，他就是太空港口的负责人-杨五六，如果你们需要战舰可以找他。
边上还立着一块告示牌(paizi)。
LONG);
        set("item_desc", ([
                "paizi": "现有大量星际战舰批发，请速来联系。\n 中心城-凤凰星(100电子货币) qu fenghuang \n 中心城-皇族(100电子货币) qu huang \n 中心城-圣殿(100电子货币) qu shengdian \n 中心城-特种部队(100电子货币) qu budui \n",
        ]));
        set("exits", ([
                "west" : __DIR__"zongshu",
        ]));
set("no_fight",1);
        set("objects", ([
                __DIR__"npc/yangwuliu": 1,
        ]));
        setup();
}

void init()
{
  add_action("do_qu","qu");
}

void do_qu(string arg)
{ object me=this_player();
  if (!arg) return notify_fail("你要去哪里？\n");
  if (me->query("money")<100) return notify_fail("你的电子货币不够了！\n");
  if (arg=="fenghuang")
    { if (me->query("combat_exp")<100000 && me->query("family/family_name")!="凤凰星") return notify_fail("你不是凤凰星的，不能进去！\n");
      me->add("money",-100);
      me->move("/d/fenghuang/fenghuang/luxingchu");
      tell_object(me,"只见一道黄光闪过，你已经到了凤凰星！\n");
      return;  
  }
  if (arg=="budui")
    { if (me->query("combat_exp")<100000 && me->query("family/family_name")!="特种部队") return notify_fail("你不是特种部队的，不能出去！\n");
      me->add("money",-100);
      me->move("/d/budui/luxingchu");
      tell_object(me,"只见一道蓝光闪过，你已经到了特种部队！\n");
      return;    
}
if (arg=="shengdian")
    { if (me->query("combat_exp")<100000 && me->query("family/family_name")!="圣殿") return notify_fail("你不是圣殿的，不能出去！\n");
      me->add("money",-100);
    me->move("/d/shendian/luxingchu");
      tell_object(me,"只见一道红光闪过，你已经到了圣殿！\n");
      return;
    }
if (arg=="huang")
    {if (me->query("combat_exp")<100000 && me->query("family/family_name")!="皇族") return notify_fail("你不是皇族的，不能出去！\n");
      me->add("money",-100);
      me->move("/d/huang/luxingchu");
      tell_object(me,"只见一道白光闪过，你已经到了皇族！\n");
      return;
    }
     
}

