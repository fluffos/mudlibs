#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "太空港");
  set("long",
    HIW "这是绝地武士的总部－自由军的基地。\n" NOR
    HIW "左边的太空港上停泊着数艘" HIR "X战斗飞船" HIW "，它的威力从他的外表就可以看出来，\n" NOR
    HIW "一艘大型飞船停在另一边，它就是银河系飞的最快的飞船－" HIB "银鹰号" HIW "它的主人\n" NOR
    HIW "先在不在船上，船舱关的紧紧的！\n" NOR
  );

  set("exits", ([
    "south": __DIR__ "zoulang",

  ]));

  set("outdoors", "juedi");
  setup();
}
