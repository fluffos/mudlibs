#include <ansi.h>
inherit NPC;
void greeting(object ob);
void create()
{
        set_name("卫兵", ({ "wei bing", "bing", "guard" }));
        set("long", "他就是绝地基地的卫兵，手上拿着激光枪。\n");
             set ("title", HIW"麦当劳服务员" NOR);
        set("gender", "男性");
        set("age", 16);
        set("attitude", "friendly");
        set("shen_type", 1);

        set("per", 100);
        set("str", 100);
        set("int", 100);
        set("con", 100);
        set("dex", 100);
        set("qi", 200);
        set("max_qi", 200);
        set("jing", 200);
        set("max_jing", 100);
        set("neili", 300);
        set("max_neili", 300);
        set("combat_exp", 20000);

        set_skill("dodge", 90);
        set_skill("unarmed", 90);
        set_skill("parry", 90);

        set("chat_chance", 1);
        set("chat_msg", ({
                "打工妹笑着说道：欢迎您光临麦当劳！\n",
                        "接待小姐说道：您想要点什么？\n",
        }) );

        setup();
        carry_object("/d/city/obj/qun")->wear();
}
