inherit ROOM;

void create()
{
    set("short","天二楼");
    set("long",@LONG
这里是天宾馆的二楼，往里面看去，是一个餐厅，
你也不觉想进去吃点东西，随便休息一下。
LONG);
    set("exits",([
       "down":__DIR__"hotel",
        "up":__DIR__"floor2",
       "enter":__DIR__"room",
    ]));

    setup();
    replace_program(ROOM);
}
