inherit NPC;

void create()
{
    set_name("圣殿战士",({"wei shi","weishi","shi","wei"}));
    set("long", 
        "他就是圣殿战士。\n"
        "他看起来不过十八九岁。\n");
    set("age",19);
    set("gender","男性");
    set("attitude","peaceful");
    set("shen_type",1);
    set("str",29);
    set("int",27);
    set("con",19);
    set("dex",29);

    set("max_qi", 400);
    set("max_jing",400);
    set("qi",400);
    set("jing",400);
    set("max_neili",350);
    set("neili",350);
    set("jiali",15);
    set("combat_exp",4000);
    set("score",3000);

    set_skill("dodge",40);
    set_skill("unarmed",40);
    set_skill("force",40);
    set_skill("parry",40);
    set_skill("literate",80);

    set("chat_chance", 1);
    set("chat_msg", ({
        "圣殿战士说道：加入我们圣殿吧！你将成为无上的战士。\n",
    }) );
    setup();
//    carry_object("/d/earth/obj/kuijia")->wear();    

}
