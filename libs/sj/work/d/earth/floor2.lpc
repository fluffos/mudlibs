inherit ROOM;

void create()
{
    set("short","地三楼");
    set("long",@LONG
这里是天宾馆的三楼，从这里的窗户望出去，圣殿更显
得大，在这里看到的只能是圣殿的一小部分，随着微
风的抚面，你的心思随着飘啊，飘啊
LONG);
    set("exits",([
        "down":__DIR__"floor1",
        "up":__DIR__"dinlou",
    ]));

    setup();
    replace_program(ROOM);
}
