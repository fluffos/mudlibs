// guinu.c

inherit NPC;

void create() {
  set_name("龟奴", ({ "gui nu", "nu" }));
  set("gender", "男性");
  set("age", 37);
  set("long", "这是一个妓院打杂的龟奴。\n");
  set("attitude", "peaceful");

  set("combat_exp", 10000);
  set("SEN", -10);

  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);

  set("score", 1000);

  setup();

}
