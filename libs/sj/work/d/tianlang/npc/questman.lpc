// questman.c 

#include <ansi.h>
inherit NPC;

string do_zhuibu();
int get_reward(object me, object obj);
int accept_object(object me, object obj);
int potential_lv(int exp);

void create() {
  set_name(YEL "警察" NOR, ({ "jing cha" }));
  set("gender", "男性");
  set("age", 43);
  set("str", 40);
  set("dex", 20);
  set("long", "他就是警察听说这人喜欢罗唆哦。\n");
  set("combat_exp", 30000);
  set("shen_type", 0);
  set("attitude", "heroism");

  set_skill("unarmed", 50);
  set_skill("force", 50);
  set_skill("sword", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/armor", 50);
  set_temp("apply/damage", 15);

  set("neili", 500);
  set("max_neili", 500);
  set("jiali", 10);

  set("inquiry", ([
    "工作": (: do_zhuibu :),
    "报酬": (: accept_object :),
  ]));

  setup();
}

string do_zhuibu() {

  string *quest = ({
    "/d/tianlang/street1.lpc",
    "/d/tianlang/street2.lpc",
    "/d/tianlang/street3.lpc",
    "/d/tianlang/street4.lpc",
    "/d/tianlang/street5.lpc",
    "/d/tianlang/street6.lpc",
    "/d/tianlang/street7.lpc",
  });

  object obj, ob = this_player();
  int exp = ob->query("combat_exp");

  if (ob->is_busy() || ob->query_temp("pending/exercising"))
    return "你现在正忙着呢。\n";

  if (ob->query_condition("in_zhuibu"))
    return "你不是己经在追捕了吗？ 如果你不想干，就放弃吧。\n";

  if (ob->query_condition("after_zhuibu"))
    return "你已经很辛苦了，还是先休息一会再来吧！\n";

  if (exp > 1000000)
    return "你的EXP够了吧?\n";
  if (exp < 500000) {
    if (exp < 10000) {
      command("pat " + ob->query("id"));
      return ("警察多说道：你年纪还小，大人的事怎么能做呢？\n");
    } else if (exp < 100000) {
      obj = new("/d/huang/npc/xiaotou");
      obj->move(quest[random(1)]);
      ob->set_temp("杀/" + obj->query("id"), 1);
    }
    ob->start_busy(1);

    ob->set("oldtitle", ob->query("title"));
    ob->set("title", HIY "天狼星抓捕者" NOR);
    ob->apply_condition("in_zhuibu", 20);
    message_vision(YEL "$N已被委任为天狼星抓捕者。\n" NOR, ob);
    remove_call_out("destrory");
    call_out("destrory", 1000, obj);
    return "小偷偷了东西速去抓拿！\n";
  } else {
    return ("警察说道：您还是去干点别的事吧，这点小事就不麻烦您了？\n");
  }
}

int accept_object(object me, object obj) {
  if (!me || environment(me) != environment()) return 0;

  if (!objectp(obj)) return 0;

  if (me->query_condition("in_zhuibu")) {
    if (me->query_temp("杀/" + obj->query("id"))) {
      command("nod");
      command("say 很好很好，这是你的奖赏。\n");
      call_out("get_reward", 0, me, obj);
      me->apply_condition("after_zhuibu", 60);
      me->apply_condition("in_zhuibu", 0);
      me->delete_temp("杀/" + obj->query("id"));
      me->set("title", me->query("oldtitle"));
      me->delete("oldtitle");
      return 1;
    } else {

      command("say 竟敢欺骗本人，找死！\n");
      me->apply_condition("after_zhuibu", 7);
      me->apply_condition("in_zhuibu", 0);
      me->set("title", me->query("oldtitle"));
      me->delete_temp("杀/" + obj->query("id"));
      me->delete("oldtitle");
      me->add("combat_exp", 200);
      return 0;
    }
  } else {
    command("say 你好象还没什么任务吧，\n");
    return 0;
  }
}

int get_reward(object me, object obj) {
  int exp, pot;
  exp = random(200);
  pot = random(100);
  remove_call_out("destrory");
  call_out("destrory", 1, obj);
  me->add("combat_exp", exp);
  me->add("potential", pot);
  tell_object(me, sprintf(HIW "你得到了%d点战斗力，%d点学习值。\n" NOR, exp, pot));
}

void destrory(object ob) {
  return;
}
