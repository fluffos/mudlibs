// guanli.c  
#include <ansi.h>

inherit NPC;
inherit F_VENDOR;
//inherit F_DEALER;
void create()
{
        set_name("管理员", ({ "guanli yuan", "yuan" }));
            set ("title", HIB  "都市大图书馆管理员" NOR);
        set("shen_type", 1);

        set("gender", "男性");
        set("age", 25);
        set("long",
                "这是都市大图书馆的图书管理员，你需要什么书可以找他了。\n");
        set_skill("unarmed", 50);
        set_skill("dodge", 50);
        set_temp("apply/damage", 15);

        set("combat_exp", 40000);
        set("attitude", "friendly");
        set("vendor_goods", ({
"/clone/newbook/xiyouji",
"/clone/newbook/sanguo",
"/clone/newbook/shuifu",
"/clone/newbook/honglou",
        }));

        setup();
        carry_object("/d/city/obj/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
 add_action("do_buy", "buy");
}

