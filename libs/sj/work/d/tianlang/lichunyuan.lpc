#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "丽春院");
        set("long", @LONG
你现在正站在丽春院里。丽春院是扬州最有名的一间青楼，三教
九流的人士在这里进进出出，楼上不时传来阵阵女子的笑声。靠近门
口的地方有一块乌木雕成的招牌(sign)。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  "up" : __DIR__"jiyuan2",
  "south" : __DIR__"dcstreet",
]));
        set("objects", ([
                __DIR__"npc/guinu" : 2,
]));
        set("no_clean_up", 0);

        setup();
}

int valid_leave(object me,string dir)
{
        if(dir!="up")
                return ::valid_leave(me,dir);
 if(me->query("money") < 1000)
return notify_fail("没钱学人泡溜？\n");
write(HIG+me->query("id")+HIW"你可以上去慢慢玩了\n"NOR);

me->add("money", -1000);
        return ::valid_leave(me,dir);
}
