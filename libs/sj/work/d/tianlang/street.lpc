// Room: /d/tianlang/street.c

#include <ansi.h>
#define THIS_PAR "bcsf"
inherit ROOM;
void create()
{
           set("short", "天狼中心");
        set("long", @LONG 
这里就是天狼星的大道,大街上人来人往真的是很热闹，人们都是在这里买东西的
这里有各式各样的货品，你想要什么就有什么，当然是有钱就有，没钱就无。
LONG
);
set("valid_startroom",1);
        set("outdoors", "tianlang");
         set("objects", ([
"/d/tianlang/npc/jingcha" : 1,
     "/wiz/fyue/table": 1,
]));
        set("exits", ([
                            "south" : __DIR__"street2",
                            "north" : __DIR__"street3",
                            "west" : __DIR__"street1",
                            "east" : __DIR__"street4",
                                "up":"/d/biwu/gate",
                    "down" : __DIR__"jiagong",
        ]));
      setup();
        replace_program(ROOM);
    call_other("/clone/board/tianlang","???");
}

void init()
{
  add_action("look_cmd","look");
}
int look_cmd()
{
 object me;
 me=this_player();
if(!me->query(THIS_PAR + "_pick")){
tell_object(me,HIG"巫师说：你快点pick gift吧\n"NOR);
}
}
