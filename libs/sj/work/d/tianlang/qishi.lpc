//棋室
inherit ROOM;
#include <ansi.h>

void create()
{
      set("short","棋室");
      set("long","这是长安最出名的棋室，很多人都来此找人下棋(xiaqi)。瞧，又来了一个。\n");
      set("exits",([
            "south":__DIR__"dcgate",
            ]));
        set("objects",([
              "/d/tianlang/npc/laoqimi":1,
            ]));
        set("no_fight","1");
        set("no_coean_up","1");
        setup();
}

