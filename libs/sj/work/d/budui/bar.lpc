inherit ROOM;

void create() {
  set("short", "特种联盟酒吧");
  set("long", @LONG
这里是特种联盟的酒吧，你一进到这里就感到一股活跃的气息。许多人和机器人在一起
喝着酒，聊着天，把心中所有的烦恼都抛到了脑后。吉他声伴着架子鼓声，把整个酒吧的气氛一
次次推向高潮。这里的老板是个由S博士研究的机器人，叫TJ,他不但很机灵，而且也识场伙。下
面是一个酒窖。门口有一个牌子(sign),上面似乎写了些什么！
LONG
  );
  set("no_fight", 1);

  set("exits", ([
    "north": __DIR__ "armorshop",
    "west": __DIR__ "foodshop",
    "down": __DIR__ "bar2",
  ]));
  set("objects", ([
    __DIR__ "npc/fuwuxiaojie": 1,
    __DIR__ "npc/wunv": 2,
  ]));
  set("item_desc", ([ "sigh": "这里有冰凉解渴的各种酒类，欢迎大家前来品尝，如有醉酒"
    "现象，本店概不负责！\n",
  ]));
  setup();
}
