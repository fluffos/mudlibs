inherit F_DEALER;
inherit NPC;
#include <ansi.h>
void create()
{
        set_name(HIY"电信局员工"NOR, ({ "worker"}));
	set("shen_type", 0);

	set("gender", "男性");
	set_max_encumbrance(100000000);
	set("age", 10);
	set("long",
                "他就是负责电信局书店的员工，你可以向他买书读。\n");
	set("no_get_from", 1);

	set_skill("unarmed", 60);
	set_skill("dodge", 60);
	set_temp("apply/attack", 30);
	set_temp("apply/attack", 30);
	set_temp("apply/damage", 15);

	set("combat_exp", 50000);
	set("attitude", "friendly");
        set("vendor_goods",({
"/clone/newbook/sanguo",
"/clone/newbook/shuifu",
"/clone/newbook/honglou",
}));
	setup();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
	
}

void die()
{
	message_vision("\n$N死了。\n", this_object());
	destruct(this_object());
}
