inherit F_DEALER;
inherit NPC;
#include <ansi.h>

void create()
{
        set_name(HIY"娇娇"NOR, ({ "jiao jiao", "jiao" }));
	set("title",HIB"特种之花"NOR);
	set("shen_type", 0);

	set("gender", "女性");
	set_max_encumbrance(100000000);
	set("age", 18);
	set("long",HIB
		"你一看到娇娇，就会觉得这次的特种部队之行特别有意义。\n"
                "娇娇长得神貌飞扬，婀娜多姿，飘渺青虚，整个一个人间仙女！\n"
                "特别是她那水汪汪的双眼，不停的向你眨呀眨的，只看得你神飞魂绕！\n"NOR);
	set("no_get_from", 1);

        set_skill("unarmed", 150);

        set_skill("dodge", 120);
        set_temp("apply/attack", 60);
        set_temp("apply/attack", 60);
        set_temp("apply/damage", 30);

        set("combat_exp", 3500000);
	set("attitude", "friendly");
       

	
	setup();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
	add_action("do_sell","sell");
}

void die()
{
	message_vision("\n$N死了。\n", this_object());
	destruct(this_object());
}
