inherit NPC;

void create()
{
	set_name("客店机器人", ({ "waiter", "robot" }) );
	set("gender", "男性" );
	set("age", 10);
	set("long",
		"这位机器人正笑咪咪地忙著，还不时拿起汽油瓶补充能量。\n");
        set("combat_exp", 500);
	set("attitude", "friendly");
	set("rank_info/respect", "机器人");
	setup();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(2) ) {
		case 0:
			say( "机器人-WAITER笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，进来喝杯茶，歇歇腿吧。\n");
			break;
		case 1:
			say( "机器人-WAITER喝了几口汽油，说道：这位" + RANK_D->query_respect(ob)
				+ "，请进请进。\n");
			break;
	}
}

int accept_object(object who, object ob)
{
	
	if (ob->query("money_id") && ob->value() >= 5000) 
	{
		tell_object(who, "机器人-WAITER笑了笑，说道：多谢您老，请上楼歇息。\n");

		who->set_temp("rent_paid",1);

		return 1;
	}
        else who->set_temp("rent_paid",0);
	return 0;
}
