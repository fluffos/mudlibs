inherit ITEM;
void create() {
  set_name("异行激素", ({ "yixing jisu", "jisu" }));
  set("unit", "瓶");
  set("long", "这是一瓶异行激素，是用来制备药物的。\n");
  set("no_drop", "这样东西不能随地乱丢！\n");
  set("value", 500);
  setup();
}
void init() {
  add_action("do_give", "give");
}
int do_give(string arg) {
  object me;
  object ob, who;
  string obs, whos;
  int exp, pot, money;
  me = this_player();
  ob = this_object();
  if (ob->query_temp("给过了"))
    return notify_fail("你的东西已经给过别人了，博士我不想要！\n");
  if (!arg || arg == "")
    return notify_fail("你要给谁什么？\n");
  if (sscanf(arg, "%s to %s", obs, whos) != 2)
    return 0;
  if (obs != "jisu" && obs != "jisu") return 0;
  ob = present("jisu", me);
  if (!ob) write("你没有这样东西。\n");
  who = find_living(whos);
  if (!who) write("没有这个人。\n");
  if (who->query("id") == "doctor")
    if (me->query("family/family_name") == "特种部队") {
      exp = 20 + random(20); pot = 30 + random(20);
      printf("你被奖励了%d点学习值，%d点战斗力！\n", pot, exp);
      me->add("combat_exp", exp); me->add("potential", pot); me->delete_temp("任务");
    }
  if (ob && who) {
    ob->move(who);
    message_vision("$N给$n一瓶异行激素。\n", me, who);
    ob->set_temp("给过了", 1);
  }
  return 1;
}
