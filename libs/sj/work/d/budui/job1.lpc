inherit ROOM;

void create() {
  set("short", "特种部队地道深处");
  set("long", @LONG
这里就是特种部队地道深处，在这里常有些异行出没，有些异行特别厉害
来这的人可要小心了！不过这些异行身上的激素却是用来研究的好材料。
你可以搜寻异行(search)。
LONG);
  set("exits", ([ "up": "/d/budui/bar2", ]));
  setup();
}
void init() {
  add_action("do_search", "search");
}
int do_search() {
  object me;
  object shou;
  object room;
  int exp;
  me = this_player();
  if (me->query("combat_exp") > 500000)
    return notify_fail("你已经不需要采激素了！\n");
  if (!(me->query_temp("任务")))
    return notify_fail("你还没有得到在这搜寻异行的批准呢！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (me->query("jing") < 25)
    return notify_fail("你的精神不够，感觉不到异行的气息，休息一会儿\n");
  me->add("jing", -10);
  exp = random(10);
  if ((exp - 3) < 1) {
    message_vision("$N用全力感应着异行的气息，可却什么都没感应到！\n", me);
    me->start_busy(3);
  }

  else {
    message_vision("突然，$N颤了颤，似乎感应到了什么！\n", me);
    write("你收集到了一瓶异行激素！\n");
    shou = new(__DIR__ "npc/yixingjisu");
    shou->move(me);
    me->start_busy(2);
  }
  return 1;
}
