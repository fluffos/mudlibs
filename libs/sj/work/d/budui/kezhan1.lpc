inherit ROOM;

void create()
{
	set("short", "特种客栈");
	set("long", @LONG
这就是特种部队的客栈了，你一走进这里，不由得从心底发出一阵赞叹：“好先进呀！”
里面全都是全自动的机器人在你周围走来走去，应付着各式各样的客人。至于这个店的老
板是什么人，没人有知道，只是有人传说他是个杰迪武士，可从来都没有人见过他。
LONG
	);
       set("no_fight",1);

	
	set("exits", ([
		"up" : __DIR__"kezhan21",
                "north" : __DIR__"bdguangchang",
       	]));
        set("objects", ([
		__DIR__"npc/robot-xiaoer" : 1,
	]));
	setup();
	replace_program(ROOM);
}
int valid_leave(object me, string dir)
{

	if ( !me->query_temp("rent_paid") && dir == "up" )
	return notify_fail("机器人--WAITER一下挡在楼梯前，白眼一翻：怎麽着，想白住啊！\n");

	
	return ::valid_leave(me, dir);
}
