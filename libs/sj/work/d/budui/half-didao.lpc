inherit ROOM;

void create() {
  set("short", "特种部队的新地道");
  set("long", @LONG
这里就是特种部队的地道，四周都是湿漉漉的黑墙，看上去好象只挖好了一半，
看来还需要人来继续挖完，你可以试着挖(wa didao)挖看。
LONG);
  set("exits", ([ "east": "/d/budui/didao3", ]));
  setup();
}
void init() {
  add_action("do_wa", "wa");
}
int do_wa(string arg) {
  object me;
  int exp;
  me = this_player();
  if (!present("dian zuan", me)) return notify_fail("没有电钻怎么挖啊？\n");

  if (me->query("qi") < 15) return notify_fail("你的生命力不够，休息一下再来吧！\n");
  if (!arg || (arg != "didao")) return notify_fail("你要挖什麽？\n");
  me->add("qi", -30);
  if (random((int)me->query("kar")) < 5) {
    message_vision("$N一不小心把地道给弄垮了，又得重挖，唉！\n", me);
    me->add("qi", -10);
    me->set_temp("busy", 1);

  }

  else {
    mapping mine;
    mine = me->query_entire_dbase();
    message_vision("$N手中拿着电钻，对准墙上那最硬的一块，拼命的挖着。\n", me);
    write("你一边拼命的挖着，看着墙上那一片片飞舞的硬石头，心中叫到：“爽呀！”\n");
    mine["combat_exp"] += 2;
    me->set_temp("busy", 1);

  }


  return 1;
}
