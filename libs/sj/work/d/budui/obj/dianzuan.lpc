#include <weapon.h>
#include <ansi.h>

inherit "/inherit/weapon/gun";

void create()
{
set_name("电钻", ({"dian zuan" }) );
        set_weight(1500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
  set("unit", "把");
    set("long", "这是一把普通的电钻。\n");
                set("value", 100);
                set("material", "iron");
       set("wield_msg", "$N拿出一把$n，握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

  init_gun(0);
        setup();
}
