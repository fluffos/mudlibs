#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name( HIR"太空衣"NOR, ({ "taikong cloth", "cloth" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
               set("value",200);
                set("material", "leather");
                set("armor_prop/armor", 50);
        }
        setup();
}
