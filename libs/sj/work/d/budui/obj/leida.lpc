inherit ITEM;
inherit F_AUTOLOAD;

#include <ansi.h>
void create()
{
	seteuid(getuid());
	set_name(HIR"超酷雷达"NOR, ({ "leida" }) );
	set("unit", "个");
	
      set("value",20000);
	setup();
}
int whereis(string arg)
{
  object where, me;
  object *ob;
  string msg;
  int i;

  me = this_player();
  if (arg) {
    where = environment(find_player(arg));
   
    if (!where) return notify_fail ("他在虚无飘藐间。\n");
    msg = where->query ("short")+"\n";
 
  }
  else {
    ob = users();
    msg = "";
    for(i=0; i<sizeof(ob); i++) {
      where = environment(ob[i]);
      if (!where)
                       msg = sprintf("%s%14s(%-10s) %15s %s\n",
                       msg, ob[i]->query("name"), ob[i]->query("id"),
                       query_ip_name(ob[i]));
                     
      else
                       msg = sprintf("%s%13s(%-10s) %s\n",
                       msg, ob[i]->query("name"), ob[i]->query("id"),
                       query_ip_name(ob[i]));
                     
      }
  }
  write (msg);
  return 1;

}
