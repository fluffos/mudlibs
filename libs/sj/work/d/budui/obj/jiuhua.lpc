//jiuhuawan.c
#include <ansi.h>
inherit ITEM;
void setup()
{}
void init()
{
        add_action("do_eat", "eat");
}
void create()
{
        set_name(HIR"火龙肝"NOR, ({"huolong gan", "gan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "这是一颗火龙的肝脏，对修炼气息大有帮助。\n");
                set("value", 900000);
        }
        setup();
}

int do_eat(string arg)
{
        int fw;
        object me = this_player();

	if (!id(arg))  return notify_fail("你要吃什么？\n");
	if (me->is_busy() )
		return notify_fail("别急，慢慢吃，小心别噎着了。\n");
        if(arg=="gan") 
	{
           me ->set("water",0);
           me ->set("food",0);
           me ->set("qi",1);
           me ->set("jing",1);
        me ->add("max_neili",100);
         me->set("neili",0);
message_vision(HIR"$N吃下一颗火龙肝，心中顿时如火焚身。焦躁不以，突然一个列揣……\n"NOR,me);
        me->unconcious();
		me->start_busy(1);
        	destruct(this_object());
	}
	return 1;
}

