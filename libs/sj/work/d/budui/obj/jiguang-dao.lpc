

inherit "inherit/weapon/blade.h"
#include <weapon.h>
;
void create()
{
set_name("激光刀", ({"blade" }) );
        set_weight(1500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
  set("unit", "把");
    set("long", "这是一把激光刀，似乎威力巨大。\n");
                set("value", 500);
                set("material", "iron");
       set("wield_msg", "$N抽出一把$n，按动启动开关，只见激光刀立刻闪耀着银白色的光芒。\n");
                set("unwield_msg", "$N把手中的$n收了回去。\n");
        }

  init_gun(50);
        setup();
}
