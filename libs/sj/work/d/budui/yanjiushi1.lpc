inherit ROOM;

#include <ansi.h>
void create() {
  set("short", HIC "超酷研究室" NOR);
  set("long", @LONG
这里就是S博士办公的地方，你的前方有一个象木桌，S博士就是在这个桌子上研究出了
许许多多有用的东西。现在S博士有事不在这，所以这里显得特别空荡，初了桌子上的仪
器以外，什么都没有了。
LONG
  );
  set("no_fight", 1);



  set("exits", ([
    "south": __DIR__ "tiantailu1",
    "west": __DIR__ "yanjiushi2",
    "east": __DIR__ "yanjiushi3",
    "north": __DIR__ "chucang1", ]));
  set("objects", ([
    __DIR__ "npc/yanjiuyuan": 2,
    __DIR__ "npc/doctor": 1,
  ]));
  setup();
