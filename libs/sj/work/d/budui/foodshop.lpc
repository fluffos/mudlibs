inherit ROOM;

void create() {
  set("short", "特种食品仓库");
  set("long", @LONG
你一走进这里，就闻到一股清香扑鼻而来，你顺着香味看去，只见食品架(sigh)上
摆满了各式各样的压缩食品。食品店里顾客来来往往，似乎都显得很匆忙，把你挤得差点摔
一交隔壁是一个酒吧，嘈杂声不停的从隔壁传出来。
LONG
  );

  set("exits", ([
    "east": __DIR__ "bar",
    "west": __DIR__ "kezhan2",
    "north": __DIR__ "bdguangchang1",
  ]));

  set("item_desc", ([ "sigh": "这里出售：压缩饼干，碳素汽水，牛排。\n", ]));
  set("objects", ([ __DIR__ "npc/robot-food": 1, ]));
  setup();
  replace_program(ROOM);
}
