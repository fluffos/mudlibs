inherit ROOM;

void create() {
  set("short", "助手实验室");
  set("long", @LONG
这里是S博士的助手使用的实验室，虽然气派比起S博士的“超酷研究室”是差了许多，
但在一般平常人眼里，仍是一个非常不错的实验室。因为S博士一般都不在，所以日常
接待客人的人物就由他的助手来代替他完成。门口的LCD(lcd)上写了一些东西。
LONG
  );



  set("exits", ([
    "east": __DIR__ "yanjiushi1",
  ]));
  set("item_desc", ([ "lcd": "这里是专门负责买卖一写S博士的杰作，虽然价钱比较贵，但是功能却十分完善。\n", ]));
  set("objects", ([ __DIR__ "npc/zhushoua": 1 ]));

  setup();
}
