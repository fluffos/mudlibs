#include <ansi.h>
inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE; void create() {
  set_name("蓝任", ({ "lan ren", "lan" }));
  set("nickname", HIR "极乐天下" NOR);
  set("age", 25);
  set("title", HIY "极乐将军" NOR);
  set("gender", "男性");
  set("long", "他是宗主的亲传弟子，刀法了得，以刀法得名，人称极乐将军。\n");
  set("attitude", "peaceful");


  set("qi", 1000);
  set("max_qi", 1000);
  set("jing", 1000);
  set("neili", 1000);
  set("max_neili", 1000);
  set("max_jing", 1000);
  set("str", 32);
  set("dex", 40);
  set("per", 40);
  set("combat_exp", 400000);
  set("shen_type", 1);

  set_skill("literate", 200);
  set_skill("blade", 280);
  set_skill("unarmed", 220);
  set_skill("dodge", 220);
  set_skill("parry", 220);
  set_skill("force", 240);
  set_skill("jile-dao", 280);
  set_skill("wuzu-xinfa", 240);
  set_skill("fenghuang-shenfa", 220);
  set_temp("apply/attack", 80);
  set_temp("apply/defense", 80);
  set_temp("apply/damage", 40);
  set_temp("apply/armor", 80);
  map_skill("blade", "jile-dao");
  map_skill("parry", "jile-dao");
  map_skill("dodge", "fenghuang-shenfa");
  map_skill("force", "wuzu-xinfa");
  create_family("凤凰星", 3, "大将");
  set("chat_chance", 1);
  set("chat_msg", ({
    "蓝任叹了口气道：“唉 …… 不知最近宗主是怎么了?……”\n",
    "好象变了一个人似的。\n",
  }));

  setup();
  carry_object("/u/zhangm/fenghuang/obj/pixue")->wear();
  carry_object("/u/zhangm/fenghuang/obj/junfu")->wear();
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if ((string)ob->query("family/family_name") == "凤凰星") {
    message_vision("蓝任对着$N点点头，微微笑了笑。\n", ob);
    return;
  }
}

void attempt_apprentice(object ob) {
  ob = this_player();
  if (!(int)this_player()->query_temp("bmark/毕业生"))
    command("say 你还是去凤凰军校去进修一下吧。\n");
  else {
    command("say 好吧，我收下你。\n");
    command("recruit " + ob->query("id"));
    return;
  }
  return;
}
