#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "聊天局");
        set("long", @LONG
这里是圣岛中心楼的聊天局,整整齐齐的摆着几排宽大舒适的
红木座椅.一些早到的人都在或高或低的讨论着.
LONG
        );
        set("no_fight", 1);
        set("no_sleep_room",1);
      set("no_clean_up", 0);
        set("exits", ([
                "down" : __DIR__"guangchang",
        ]));

       setup();
}