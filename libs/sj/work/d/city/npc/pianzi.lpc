// waiter.c

inherit NPC;
inherit F_VENDOR;
#include <ansi.h>;

void create()
{
        set_name("郑其", ({ "pian zi", "zi" }) );
        set("gender", "男性" );
        set("age", 22);
        set("long",
                "这是个行走江湖的骗子，一脸的奸诈。\n");
        set("combat_exp", 500);
        set("attitude", "friendly");
        set("rank_info/respect", "江湖骗子");
        set("vendor_goods", ({
                "/d/city/food/yan",
                "/d/city/food/hefan",
                "/d/city/food/jiuhu",
        }) );
        setup();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        if (!ob->query_temp("welcome100") || ob->query("mud_age")<1000)
        {
                ob->set_temp("welcome100","1");
tell_object(ob,"郑其笑咪咪地说道：这位"+RANK_D->query_respect(ob)+"，欢迎来到"HIR"世纪(CENTURY)"NOR"
\n\n");
        }
        switch( random(2) ) {
                case 0:
                        say( "郑其笑咪咪地说道：这位" + RANK_D->query_respect(ob)
                                + "，买根烟抽抽吧，能提神哦！。\n");
                        break;
                case 1:
                        say( "郑其指了指盒饭，说道：这位" + RANK_D->query_respect(ob)
                                + "，要盒饭吗？\n");
                        break;
        }
}

int accept_object(object who, object ob)
{
        
        if (ob->query("money_id") && ob->value() >= 5000) 
        {
                tell_object(who, "郑其一哈腰，说道：多谢您老。\n");

                who->set_temp("rent_paid",1);

                return 1;
        }

        return 0;
}

