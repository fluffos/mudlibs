#include <ansi.h>
inherit NPC;
void greeting(object ob);
void create()
{
        set("long", "中心城维护治安的警察，样子很凶哦。\n");
          set_name("警察", ({ "jingcha", "jing", "cha" }));
        set("gender", "男性");
              set ("title", HIW  "神捕" NOR);
        set("age", 39);
        set("attitude", "friendly");
        set("shen_type", 1);

        set("per", 15);
        set("str", 15);
        set("int", 14);
        set("con", 15);
        set("dex", 16);
        set("qi", 200);
        set("max_qi", 200);
        set("jing", 200);
        set("max_jing", 100);
        set("neili", 300);
        set("max_neili", 300);
        set("combat_exp", 20000);

        set_skill("unarmed", 90);
        set_skill("dodge", 90);
        set_skill("parry", 90);
        set("chat_chance", 10);
        set("chat_msg", ({
                "警察说道：怎么又进来了！\n",
                        "警察高声说道：你小子以后见到我就跑快点，哼！\n",
        }) );

        setup();
        carry_object("/d/city/obj/cloth1")->wear();
}

