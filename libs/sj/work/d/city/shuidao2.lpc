inherit ROOM;
void create()
{
        set("short", "隧道");
        set("long", @LONG
这是一条阴暗潮湿的隧道，地上很多老鼠穿来穿去，令你感到
一阵恶心。
LONG);
        set("outdoors", "city");
        set("exits", ([
                "up" : __DIR__"shuidao",
                "down"  : __DIR__"shuidao3",
        ]));
        set("objects", ([  "/d/city/npc/laoshu" : 1,
        ]));

        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}


