// pepsi.c  

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("奶惜", ({ "nai xi", "nai", "xi" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一只可以河很久的奶惜.\n");
    set("unit", "瓶");
    set("value", 400);
    set("max_liquid", 50);
  }

  // because a container can contain different liquid
  // we set it to contain wine at the beginning
  set("liquid", ([
    "type": "alcohol",
    "name": "奶惜",
    "remaining": 3,
    "drunk_supply": 100,
  ]));
}
