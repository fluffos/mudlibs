// juwuba.c 

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("巨无霸", ({"juwu ba", "jwb", "ba"}));
        set_weight(50);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一个新仙的面包。\n");
                set("unit", "个");
                set("value", 300);
                 set("food_remaining", 3);
                    set("food_supply", 200);
        }
}

