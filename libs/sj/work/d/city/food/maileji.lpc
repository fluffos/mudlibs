// mailiji.c 

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("麦乐鸡", ({"maile ji", "mlj", "ji"}));
        set_weight(20);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一盒香喷喷的麦乐鸡。\n");
                set("unit", "盒");
                set("value", 500);
                 set("food_remaining", 6);
                    set("food_supply", 50);
        }
}

