// Room: /d/city/bank
//zurn 
inherit ROOM;


void create()
{
        set("short", "中央大银行");
        set("long", @LONG
这里就是中心城最有实力的银行了，在这里你可以办理各项金融业务，
其分支机构遍布各个角落，你可以享受最好的服务，在大厅的正中有
一个旋转式楼梯，在楼梯旁有一个金制公告板（ｓｉｇｎ）一块。

                     中央大银行

LONG
        );
        
        set("exits", ([
                "west"          : __DIR__"nandajie2",
        ]) );
        set("item_desc", ([
                "sign": @TEXT
这里是钱庄，目前我们提供的服务有：

convert     兑换货币。
withdraw    提取存款。
deposit     存入货币。
balance     察寻存款。
loan        贷款。
TEXT
        ]) );


        set("objects", ([

                        ]) );

        setup();
}

