#include <room.h>

inherit ROOM;

void create() {
  set("short", "紫阳城大街");
  set("long", @LONG
这里是紫阳城的大街,凡是本城的人,都要辛勤的劳动所以,街上人来人
往好不热闹.这里往南就是紫阳城的中央广场，北边是紫阳城主的家宅，
大门(door)的两边是两棵柳树。
LONG
  );
  set("outdoors", "ziyangcheng");
  set("item_desc", ([
    "door": "大门紧关着，不过好象并没上锁。",
  ]));

  set("exits", ([

    "south": __DIR__ "guangchang",
    "north": __DIR__ "jiazhai",
  ]));
  create_door("north", "大门", "south", DOOR_CLOSED);

  setup();
}
