inherit ITEM;

inherit F_LIQUID;


void create()

{

  set_name("啤酒", ({ "pi jiu", "jiu", "wine" }));

  set_weight(700);

  if (clonep())

    set_default_object(__FILE__);

  else {

    set("long", "这是一瓶啤酒。\n");

    set("unit", "瓶");

    set("value", 40);

    set("max_liquid", 15);

  }


  set("liquid", ([

    "type": "alcohol",

    "name": "啤酒",

    "remaining": 10,

    "drunk_supply": 20,

  ]));

}
