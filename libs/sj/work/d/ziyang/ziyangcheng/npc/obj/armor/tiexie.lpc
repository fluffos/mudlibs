#include <ansi.h>
#include <armor.h>
inherit BOOTS;

void create() {
  set_name(GRN "铁鞋" NOR, ({ "tie xie", "shoes", "xie" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一双精铁打造的鞋子。\n");
    set("unit", "双");
    set("value", 2000);
    set("material", "steel");
    set("armor_type", "feet");
    set("armor_prop/armor", 30);
    set("armor_prop/dodge", -5);

  }
}
