


inherit ITEM;

inherit F_FOOD;


void create()

{

	set_name("面包", ({"mian bao", "bao","bread"}));

	set_weight(80);

	if (clonep())

		set_default_object(__FILE__);

	else {
		set("long", "一个涂了黄油的面包,看上去很香\n");

		set("unit", "个");

		set("value", 120);

		set("food_remaining", 7);

		set("food_supply", 30);

	}

}
