#include <weapon.h>
#include <ansi.h>

inherit SWORD;


void create()

{

	set_name(HIW"星辰剑"NOR, ({ "xingchen jian","jian", "sword" }));

	set_weight(6000);

	if (clonep())

		set_default_object(__FILE__);

	else {

		set("unit", "柄");

		set("long", "这柄剑身长五尺,剑身上似乎有着群星闪烁。\n");

		set("value", 20000);

		set("material", "steel");

		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");

		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");

	}

	init_sword(130);

	setup();

}
