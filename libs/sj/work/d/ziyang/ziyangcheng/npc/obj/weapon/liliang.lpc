#include <weapon.h>

inherit SWORD;


void create()

{

	set_name("力量之剑", ({ "liliang jian","jian", "sword" }));

	set_weight(14000);

	if (clonep())

		set_default_object(__FILE__);

	else {

		set("unit", "柄");

		set("long", "这是一把能够由你的力量自由挥发的剑。\n");

		set("value", 70000);

		set("material", "steel");

		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");

		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");

	}

	init_sword((this_player()->query("str") - 20) * 2 + 20 );

	setup();

}
