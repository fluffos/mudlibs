inherit NPC;

inherit F_DEALER;


void create()

{

    set_name("王老板", ({ "wang laoban","wang", "laoban" }));

    set("title", "武器店老板");

    set("nickname", "安全第一");

	set("shen_type", 1);


	set("str", 42);

    set("gender", "男性");

    set("age", 42);

	set("long","他正笑呵呵的瞧着自己的柜台，满意地点了点头。\n");

	set("combat_exp", 1000);

	set("attitude", "friendly");

	set("inquiry", ([

        

	]));

	      set("vendor_goods", ({

    __DIR__"obj/weapon/gangjian",
    __DIR__"obj/weapon/baihong-jian",
    __DIR__"obj/weapon/baofeng",
    __DIR__"obj/weapon/kuojian",
    __DIR__"obj/weapon/mojian",
    __DIR__"obj/weapon/shuangren",
    __DIR__"obj/weapon/tujijian",
    __DIR__"obj/weapon/xingchenjian",
    __DIR__"obj/weapon/yinjian",
    __DIR__"obj/armor/jarmor",
    __DIR__"obj/armor/zhanyi",
    __DIR__"obj/armor/toukui",
    __DIR__"obj/armor/zhanxue",
    __DIR__"obj/armor/shield",
		}));


	setup();

	add("money", 50);

}


void init()

{

	object ob;

	
	::init();

	if (interactive(ob = this_player()) && !is_fighting())
 {

		remove_call_out("greeting");

		call_out("greeting", 1, ob);

	}

        add_action("do_list", "list");

        add_action("do_buy", "buy");

}


void greeting(object ob)

{

	if (!ob || environment(ob) != environment()) return;

	switch(random(2))
 {

	case 0 :
        say("王老板行了个礼，说：这位" + RANK_D->query_respect(ob) +
			"，您请进。\n");

		break;

	case 1 :
        say("王老板说道：这位" + RANK_D->query_respect(ob) +
			"，我们这里的家伙，可都是货真价实的削铁如泥呀。\n");


		break;

	}

}
