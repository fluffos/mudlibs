inherit NPC;

inherit F_DEALER;


void create()

{

    set_name("唐老板", ({ "tang laoban","tang", "laoban" }));

    set("title", "杂货店老板");

    set("nickname", "见钱眼开");

	set("shen_type", -1);


	set("str", 40);

    set("gender", "男性");

    set("age", 45);

	set("long","他正眯缝着眼睛盯着你，想着如何从你身上敲诈。\n");

	set("combat_exp", 500);

	set("attitude", "friendly");

	set("inquiry", ([

        

	]));

	
	set("vendor_goods", ({

		__DIR__"obj/food/wine",		__DIR__"obj/food/bread",
		__DIR__"obj/food/biscuit",
		__DIR__"obj/food/ham",
		__DIR__"obj/food/kettle",
		__DIR__"obj/armor/goldring",
		__DIR__"obj/armor/necklace",
		__DIR__"obj/armor/pimao",
		__DIR__"obj/armor/shoutao",
		__DIR__"obj/armor/surcoat",
		__DIR__"obj/armor/tiexie",


			}));


	setup();

	add("money", 50);

}


void init()

{

	object ob;

	
	::init();

	if (interactive(ob = this_player()) && !is_fighting())
 {

		remove_call_out("greeting");

		call_out("greeting", 1, ob);

	}

        add_action("do_list", "list");

        add_action("do_buy", "buy");

}


void greeting(object ob)

{

	if (!ob || environment(ob) != environment()) return;

	switch(random(2))
 {

	case 0 :
        say("唐老板笑眯眯地说道：这位" + RANK_D->query_respect(ob) +
			"，您要点什么?\n");

		break;

	case 1 :
        say("唐老板说道：哟！这位" + RANK_D->query_respect(ob) +
			",什么风把您给吹来了?\n");


		break;

	}

}
