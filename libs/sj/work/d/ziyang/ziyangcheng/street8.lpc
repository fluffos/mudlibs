inherit ROOM;

void create() {
  set("short", "紫阳城大街");
  set("long", @LONG
这里是紫阳城的大街,凡是本城的人,都要辛勤的劳动,所以,街上人来人
往好不热闹.
LONG
  );
  set("outdoors", "ziyangcheng");

  set("exits", ([
    "north": __DIR__ "street7",
    "south": __DIR__ "street9",
    "east": __DIR__ "wuqidian",
  ]));

  setup();
  replace_program(ROOM);
}
