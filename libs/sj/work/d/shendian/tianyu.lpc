#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int ask_me();
int ask_abandon();
int do_heal();

void create()
{
        set_name("潭雨", ({ "tian yu","tian","yu"}));
        set("nickname", HIC "天之姣女" NOR);
        set("long", 
                "她就是圣殿的美女之一，人称“天之姣女”的潭雨。\n"
        );
        set("gender", "女性");
        set("age", 40);
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("per", 55);
        
        set("qi", 6000);
        set("max_qi", 6000);
        set("jing", 6000);
        set("max_jing", 6000);
        set("neili", 6000);
        set("max_neili", 6000);
        set("jiali", 50);
        set("combat_exp", 800000);
        set("score", 300000);

        set_skill("force", 130);
        set_skill("sword", 110);
        set_skill("parry", 120);
        set_skill("dodge", 120);
        set_skill("finger", 110);
        set_skill("literate", 140);
        create_family("圣殿", 2, "武士");

        set("inquiry", ([ "job": (:ask_me:),
        ]) );
    
        setup();
}
int ask_me()
{
   mapping myfam;
  mapping quest;
  object ob;
  object me=this_player();
  quest =("/d/shendian/npc/tianyujob")->query_quest();
   myfam = (mapping)me->query("family");
if (!(int)me->query_temp("mask/agree") && (!myfam || me->query("family/family_name")!="圣殿"))
          {
           command("shake "+(string)me->query("id"));
           command("say "+RANK_D->query_respect(me)+"素无来往，不知此话从何说起呢？");
           return 1;
          } 
//     if(me->query("recruit_number") > 20 && me->query("combat_exp")> 200000)
     if(me->query("combat_exp")> 200000)
     {
       command("say 你已经为本殿出了不少力了，我这暂时不用"+RANK_D->query_respect(me)+"帮忙了，你还是去做做其他任务吧。");
       return 1;
     }
        if (me->is_busy()) {
                write("你现在正忙着呢。\n");
                return 1;
        }

     command("nod "+(string)me->query("id"));
 command("say 你来得正好，我这正好有事让你做，圣岛上最近出现一批奸细，你去找出来，杀掉他们");
     command("say 据报有个人在"+quest["place"]+quest["target_place"]+"附近出现过，你去把了解。");
     ob = new(__DIR__"mongmian",1);
     ob->move(quest["place_path"]);
     ob->set("jobby",(string)me->query("id"));
     ob->do_jobtime(me);
     return 1;
}
