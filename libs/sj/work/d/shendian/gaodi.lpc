#include <room.h>

inherit ROOM;

void create()
{
	set("short", "高地");
	set("long", @LONG
这里虽然只是一个微微向上tu起的地方，但视眼分外的开阔，因为
这里靠近海边，阵阵海风吹来，你不由得感到一阵寒意，高地当中搭
起一个棚子，据说是当年“凤凰星”大宗主——陈信就是在这里元神
出鞘，历时一年之久，而那个棚子正是圣岛临时搭给他遮雨之用。几
位神圣的弟大正在棚子下练功，好似要感受当年陈信神游的感觉。
LONG );
	set("exits", ([
		"west" : __DIR__"shanpo",
//		"north" : "/d/shaolin/yidao",
//		"west"  : "/d/huanghe/caodi1",
	]));
        set("objects", ([
                "/d/shendian/npc/kanzhengang" : 1,
        ]));
	set("outdoors", "shendian");
	setup();
}
