#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIY "圣殿银行" NOR);
  set("long", @LONG
这是一家老字号的银号，已有近千年的历史，但来这转帐的人很多，据说是
为了看那个漂亮的银行服务生。
    在对面的墙上的电子屏幕(pingmu)上显示着最新的货币汇率。
LONG);
  set("exits", ([
    "west": __DIR__ "shangjie1",
  ]));
  set("item_desc", ([
    "pingmu": @TEXT
       本银行提供以下服务：
       转帐      zhuanzhang <某人> <电子货币数量>
TEXT
  ]));

  set("objects", ([
    __DIR__ "npc/banker": 1
  ]));
  set("no_clean_up", 0);
  set("no_fight", 1);
  set("no_beg", 1);
  setup();
}
