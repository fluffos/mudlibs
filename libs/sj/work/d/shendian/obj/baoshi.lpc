#include <weapon.h>
#include <ansi.h>
inherit HAMMER;
void create()
{
        set_name(HIG  "宝石" NOR, ({ "bao si" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long", "一块紫红色的宝石,隐隐的闪烁着光芒,
上面有一行小字,陈信.哦,原来是当年陈信光临圣殿时留下来的,似乎可以hell\n");
                set("max_hell",10);
                set("material", "stone");
        }
        init_hammer(10);
        setup();
}
void init()
{
        if(environment()==this_player())
        add_action("do_hell","hell");

}

int do_hell()
{
        object me;
        me = this_player();
        if(query("max_hell") <=0)
        return notify_fail("此宝石似乎没什么用处了！\n");
        if(me->query("eff_qi") == me->query("max_qi"))
        return notify_fail("好你这个宝石只能用来治疗外伤，对内伤没用,真可惜！\n");
        me->set("eff_qi",(int)me->query("max_qi"));
        add("max_hell",-1);
        message_vision("$N将一块紫红宝石心脏前,只见宝石闪动间,血淋淋的伤口
居然奇迹般的愈合了！！\n",me);
        return 1;
}


