#include <weapon.h>
inherit F_UNIQUE;
inherit SWORD;

void create() {
  set_name("小光剑", ({ "guang jian", "jian", "sword" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", @LONG
这柄剑外表看起来不是十分的显眼，软绵绵的，平时可以缠在腰间，但是只要用内
息一灌，便坚硬无比，发出蓝色的光芒。
LONG);
    set("no_break", 1);
    set("endure", 150);
    set("sharpness", 100);
    set("material", "steel");
    set("wield_msg", "$N从腰一探，拿出一把独尊光剑，剑锋闪过一道蓝光。\n");
    set("unwield_msg", "只见$N手的$n一软，马上又缠在了腰间。\n");
  }
  init_sword(100);
  setup();
}
