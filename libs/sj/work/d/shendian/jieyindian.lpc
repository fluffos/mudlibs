#include <room.h>

inherit ROOM;

void create()
{
	set("short", "接引殿");
	set("long", @LONG
这里是圣岛的接引殿，外来的人都要在这里等着传呼，这个大殿十分的
宽敞，天花板上一个圆形的装饰溜璃灯，分外的引人注目，大殿的靠中部位
排着几排宽大的沙发，显然是给外来人临时休息坐的。几位圣岛武士，正四
外转忧着，不时用一种警觉的目光打量着你，使你不由得感到一阵心寒。
LONG );
	set("exits", ([
		"north" :__DIR__"jianyian",
		"northwest" :__DIR__"guodao3",
		"northeast"  : __DIR__"guodao4",
                "south"  : __DIR__"sleeproom",
	]));
        set("objects", ([
                "/d/shendian/npc/liuming" : 1,
                "/d/shendian/npc/tianjianxia" : 1,
        ]));
	set("outdoors", "city");
	setup();
}
