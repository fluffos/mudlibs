#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int ask_me();
int ask_fangqi();
int do_heal();

void create() {
  set_name("潭雨", ({ "tian yu", "tian", "yu" }));
  set("nickname", HIC "天之姣女" NOR);
  set("long",
    "她就是圣殿的美女之一，人称“天之姣女”的潭雨。\n"
  );
  set("gender", "女性");
  set("age", 40);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("per", 55);

  set("qi", 6000);
  set("max_qi", 6000);
  set("jing", 6000);
  set("max_jing", 6000);
  set("neili", 6000);
  set("max_neili", 6000);
  set("jiali", 50);
  set("combat_exp", 800000);
  set("score", 300000);

  set_skill("force", 130);
  set_skill("sword", 110);
  set_skill("parry", 120);
  set_skill("dodge", 120);
  set_skill("finger", 110);
  set_skill("literate", 140);
  set_skill("guang-jian", 180);
  set_skill("wuzhu-xinfa", 180);
  set_skill("shunjian-yidong", 180);
  map_skill("sword", "guang-jian");
  map_skill("force", "wuzhu-xinfa");
  map_skill("dodge", "shunjian-yidong");
  create_family("圣殿", 2, "武士");
  set("inquiry", ([ "job": (: ask_me :),
    "fangqi": (: ask_fangqi :),
  ]));

  setup();
  carry_object("/d/shendian/obj/wushifu")->wear();
  carry_object("/d/shendian/obj/duzhenjian")->wield();
}
int ask_me() {
  mapping myfam;
  mapping quest;
  object ob;
  object me = this_player();
  quest = ("/d/shendian/npc/tianyujob")->query_quest();
  myfam = (mapping)me->query("family");
  if (!(int)me->query_temp("mask/agree") && (!myfam || me->query("family/family_name") != "圣殿")) {
    command("shake " + (string)me->query("id"));
    command("say " + RANK_D->query_respect(me) + "素无来往，不知此话从何说起呢？");
    return 1;
  }
  if (me->query_temp("job"))  // return "你已经有任务在身了！\n";
  {
    command("say 你不是已经有任务了吗？");
    return 1;
  }
  if (me->query("combat_exp") < 45000) {
    command("shake " + (string)me->query("id"));
    command("say 你的经验还太低了，还是先去做做其他任务吧。");
    return 1;
  }

  if (me->query("combat_exp") > 300000) {
    command("say 你已经为本殿出了不少力了，我这暂时不用" + RANK_D->query_respect(me) + "帮忙了，你还是去做做其他任务吧。");
    return 1;
  }
  command("nod " + (string)me->query("id"));
  command("say 你来得正好，我这正好有事让你做，圣岛上最近出现一批奸细，你去找出来，杀掉他们");
  command("say 据报有个人在" + quest["place"] + quest["target_place"] + "附近出现过，你去把他了解");
  ob = new(__DIR__ "mongmian", 1);
  ob->move("/d/shendian/luyindao5");
  me->set_temp("job", 1);
  ob->set("jobby", (string)me->query("id"));
  ob->do_jobtime(me);
  return 1;
}
int ask_fangqi() {
  object me = this_player();
  if (me->query("job", 1)) {
    command("say 我又没有给你任务，放弃什么？");
    return 1;
  }
  command("sigh");
  command("say 要你做一点事都做不好，怎么配做圣殿武士呀。");
  command("say 你因放弃任务受到一个小小的惩罚,你被扣除100点战斗值.50点学习值.。");
  command("say 我可警告你呀,放弃任务累计数超过20次,我将不会给你任务。");
  command("disapp1 " + (string)me->query("id"));
  me->add("combat_exp", -100);
  me->add("potential", -200);
  me->delete_temp("job", 1);
  return 1;


}
