#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int ask_learn();
void do_heal();
          
string *first_name = ({
                         "石",
                         "白峰",
                         "刚",
                         "昱",
                         "成",
                         "广殷",
                         "文亮",
                         "效",
                         "彬",
                         "严",
                });
string *family_name = ({
                         "张",
                         "王",
                         "高",
                         "赵",
                         "钱",
                         "李",
                         "孙",
                         "刘",
                         "谢",
                         "曹",
                         "江",
                         "顾",
                         "铁",
                       });
                                      
string *skills = ({

                 });

void create()
{      
       int skills;
       set_name(family_name[random(sizeof(family_name))]+
    first_name[random(sizeof(first_name))], ({ "mentu","tu"}));
        set("gender", "男性");
        set("age", 20+random(10));
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 21+random(10));
        set("int", 21+random(10));
        set("con", 21+random(10));
        set("dex", 21+random(10));
        set("jobby","");
        set("skill_exp",0);
        set("clone_killer",2+random(5));
        set("learn_skill","");
        
        set("max_qi",
this_player()->query("max_qi")/10*(8+random(8)));     
        set("max_jing", this_player()->query("max_jing")/10*(8+random(8)));
        set("max_neili", this_player()->query("max_neili")/10*(5+random(5)));
        set("jiaji", random(51));
        set("combat_exp",
this_player()->query("combat_exp")/10*(8+random(8)));
       set("learn_number",
random(this_player()->query("kar")+this_player()->query_int())+20);

        set_skill("force",random(skills)+10);
        set_skill("dodge", random(skills)+10);
        set_skill("sword", random(skills)+10);
        set_skill("parry", random(skills)+10);
        set_skill("finger", random(skills)+10);
        set_skill("literate",10+random(this_player()->query_skill("literate",1)));
       
        set("inquiry", ([ "teach": (:ask_learn:),
        ]) );

        set("chat_chance",20);
        set("chat_msg", ({
                (: do_heal :),
        }) );

        set("chat_chance_combat",20);
        set("chat_msg_combat", ({
                (: do_heal :),
        }) );

        create_family("圣殿",4 , "武士");
        set("title",HIG"圣殿门徒"NOR);     
        setup();
        carry_object("/clone/cloth/cloth")->wear();
        carry_object("/clone/weapon/changjian")->wield();
}

void do_heal()
{
  command("exert recover");
  command("exert regenerate");
  return;
}

void init()
{
  add_action("do_teach","zhidian");
}

int do_teach(string arg)
{
  object ob;
  object me=this_player();
  string teach, skill;
  int master_skill, my_skill, skill_totalup, skill_up, jingli_cost;
  if(!me->query_temp("teach_job"))
   return notify_fail("什么？\n");

  if(!arg)
   return notify_fail("指令格式: zhidian <人名(id)> <技能名<skills>> \n");

  if(me->is_busy())
   return notify_fail("你正忙着呢。\n");

  if((sscanf(arg, "%s %s", teach, skill)!=2))
   return notify_fail("指令格式: zhidian <人名(id)> <技能名<skills>> \n");
  if( teach == (string)me->query("id"))
   return notify_fail("让你教别人呢？怎么想自个儿练？\n");

  if(!objectp(ob = present(teach,environment(this_object()))))
   return notify_fail("这里有这个人吗？\n");

 if(me->query("jingli") < 30)
   return notify_fail("你的精力太低了，歇歇再教吧。\n");

  if( !living(ob) )
   return notify_fail("你得先把" + ob->name() + "弄醒再说。\n");
  
  if(ob->query_temp("practicing"))
   return notify_fail("他正在练这呢，你想拔苗助长啊？\n");
  
  if( me->is_fighting() )
   return notify_fail("你先顾顾自己吧。\n");

  if(ob->query("jobby")!=me->query("id"))
  {
   command("? "+(string)me->query("id"));
   tell_object(me,"看来他并不是你要教武的人。\n");
   return 1;
  }
  if( skill == "literate")
   return notify_fail("你又不是教书先生，教他这个干什么？\n");


  if( !master_skill = me->query_skill(skill, 1) )
   return notify_fail("你又不会这项技能，怎么还想教别人？\n");

//  if(skill != (string)query("learn_skill"))
//   return notify_fail("他不想练这项技能。\n");
  my_skill = ob->query_skill(skill, 1);
  if( my_skill >= master_skill )
   return notify_fail("这项技能他的程度已经不输你了。\n");

  message_vision("$N开始向$n指导「"+to_chinese(skill)+"」。\n",me,ob);  
  command("consider");
  message_vision("$n按照$N的指导，慢慢练了起来……\n",me,ob);
  jingli_cost = 10-random(me->query_int());
  me->add("jingli",-jingli_cost);
  ob->set_temp("practicing",1);
  me->start_busy(1+random(4));
  if(random(me->query_int()+ob->query_int()) < 35) 
  {
  message_vision(HIY"$n练了半天，可惜仍然没有一点进步。\n"NOR,me,ob);
  ob->delete_temp("practicing");
  return 1;
  }
  else
  {
  message_vision("$n反复练着地练习着「"+to_chinese(skill)+"」，觉得越来越得心应手。\n",me,ob);
  tell_object(me,HIG"他的这项技能有所提升！\n"NOR);
  ob->delete_temp("practicing");
  skill_up=random(me->query_int())+1;
  ob->add("skill_exp",skill_up);
  ob->add("learn_number",-1);
  tell_object(me,"他"+to_chinese(skill)+"的经验是"+ob->query("skill_exp")+"。\n");
        if((int)ob->query("skill_exp") > (my_skill+1) * (my_skill+1))
        {
        ob->set("skill_exp",0); 
        ob->set_skill(skill,my_skill+1);
        command("say 我的「"+to_chinese(skill)+"」进步了！");
        command("jump " + (string)me->query("id"));
        tell_object(me,CYN"他的"+to_chinese(skill)+"等级是"+my_skill+"段。\n"NOR),
        me->add_temp("teach_upskills",1);
        }
        if(random(me->query_int()) > 25 && master_skill*master_skill*master_skill/10 < me->query("combat_exp"))
        {
        tell_object(me,HIG"你似乎觉得自己的"+to_chinese(skill)+"也有所进步！\n"NOR);
        me->improve_skill(skill, random(me->query_int())+1);
        }
      return 1;
  }
}

int do_command(object me)
{
  remove_call_out("do_clone");
  call_out("do_clone",30,me);
}

int do_clone(object me)
{
  object ob,obj;
  ob=this_object();
  if(query("clone_killer")>0 && 15 > random(me->query("kar")))
    {
      message_vision(HIG"只听“嗖”地一声，光芒一闪，一位黑衣武士出现在你面前！\n"NOR,me);
      message_vision(HIY"那人狂笑道：$n你想临阵磨枪，只怕是来不及了！让大爷来陪你玩玩吧！\n"NOR,me,ob);
      
      message_vision(HIR"那人向$n发起进攻！\n"NOR,me,ob);
      obj = new(__DIR__"challenger",1);
      obj->move(environment(me));
      obj->kill_ob(ob);
//      obj->set_leader(ob);
      obj->delete("killer_job");
      obj->do_follow(me);
      obj->kill_ob(me);
      me->kill_ob(obj);
      ob->kill_ob(obj);
      ob->do_command(me);
      add("clone_killer",-1);
      return 1;
    }  
  ob->do_command(me);
  return 1;
}

int do_jobtime(object me)
{
  remove_call_out("jobover");
  call_out("jobover",300+random(me->query("kar")*2),me);
}

int jobover(object me)
{
  remove_call_out("jobover");
  command("say 今天您就教到这吧，接下来我自己练习练习吧。");
  command("thank "+(string)me->query("id"));
  message_vision("说罢，$N转身到练武场去了。\n",this_object());
  me->delete_temp("teach_job");
  me->set_temp("teach_finished",1);  
  destruct(this_object());
}

int ask_learn()
{
  object me=this_player();
  string skill;
  skill = skills[random(sizeof(skills))];
  if((string)query("jobby")==(string)me->query("id"))
  {
  set("learn_skill",skill);
  set_skill(skill,10);
  tell_object(me,CYN"他想让你指点他的「"+to_chinese(skill)+"」。\n"NOR);
  return 1;
  }
  return 0;
}
