inherit NPC;
#include <ansi.h>

string ask_toy();
string ask_work();
string ask_workover();

void create() {
  set_name("曹林", ({ "cao lin", "cao" }));
  set("nickname", HIY "看剑便是刀" NOR);
  set("title", HIR "圣殿武器总管" NOR);
  set("gender", "男性");
  set("age", 38);
  set("long",
    "此人是圣殿的武器主管，新手可以向他领取一些初级的武器，\n");
  set("combat_exp", 10000);
  set("max_jing", 300);
  set("max_qi", 300);
  set_skill("dodge", 40);
  set_skill("unarmed", 40);
  set_temp("apply/armor", 60);
  set_temp("apply/damage", 20);
  set("attitude", "friendly");
  set("inquiry", ([
    "武器": (: ask_toy :),
  ]));

  setup();

  set("hammer_count", 4);
  set("chat_chance", 5);
  set("chat_msg", ({
    "曹林大家加油练功，练好就去PK？”\n"
    "曹林喊道：“喂那个那个小子，你在干嘛，没事做吗”\n",
    "曹林偷偷的对你说：“这个。。嘿嘿，最近你发现有美漂亮的MM了吗？”\n",
    "曹林对你说道：“哎，出门在外，还是随身带吧武器的好呀。！\n",
  }));
  carry_object("/clone/cloth/cloth")->wear();
}
int accept_fight() {
  command("say 一边去，没见我正忙着呢，哪凉快哪呆着去！");
  return 0;
}

string ask_toy() {
  object ob;

  if (present("jian", this_player()))
    return "你身上不是有吗？你这个大笨木瓜！";
  if (query("hammer_count") < 1)
    return "我现在手头上也没有，你再等会儿吧！";
  add("hammer_count", -1);
  ob = new("/d/shendian/obj/xiaoguanjian");
  ob->move(this_player());
  return "好好保管，别搞丢了！”\n曹六给了你一把小光剑。";
}
