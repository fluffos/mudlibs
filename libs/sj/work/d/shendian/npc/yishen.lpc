inherit NPC;
inherit F_DEALER;
int ask_me();
#include <ansi.h>;
void create() {
  set_name("宁那求", ({ "la qong" }));
  set("title ", HIY "圣殿救护兵" NOR);
  set("nickname", HIC "救死护伤" NOR);
  set("gender", "男性");
  set("age", 95);
  set("int", 30);
  set("inquiry", ([
    "治病": (: ask_me :),
  ]));
  set("qi", 1000);
  set("max_qi", 1000);
  set("jing", 1000);
  set("max_jing", 1000);
  set("shen_type", 1);
  set("combat_exp", 100000);
  set("attitude", "heroism");
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 60);
  set_temp("apply/attack", 70);
  set_temp("apply/defense", 70);
  set_temp("apply/damage", 50);
  set("vendor_goods", ({
  }));
  setup();
  carry_object("/clone/misc/cloth")->wear();
}
int ask_me() {
  object ob;
  ob = this_player();
  if ((int)ob->query("eff_qi") == (int)ob->query("max_qi")) {
    command("?" + ob->query("id"));
    command("say 我看你生龙活虎的样子，不像是生病呀，搞什么，逗我开心呀，我没闲工具呢？\n");
    return 1;
  } else {
    message_vision(HIW "say 宁那送看着$N不注意，拿起一根针筒对准$N的屁股刺了下去。" NOR, ob);
    message_vision(HIW "只听$N一声惨呼，直吓得你浑身冷汗。" NOR, ob);
    remove_call_out("recover");
    call_out("recover", 2, ob);
    return 1;
  }
}
int recover(object ob) {
  ob->set("eff_qi", (int)ob->query("max_qi"));
  ob->set("eff_jing", (int)ob->query("max_jing"));
  message_vision(HIG "过了一会儿，虽然你觉得屁股还有点疼，但原来的病好像全好了。\n" NOR, ob);
  command("say 好了，你的病已经治好了，以后没事不要来烦我，我要去看ＭＭ呢。\n");
  return 1;
}
