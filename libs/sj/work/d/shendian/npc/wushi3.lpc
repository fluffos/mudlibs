inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("护殿武士", ({ "wu shi", "wu","shi" }));
        set("long", 
                "他就是护殿武士。\n"
                "他看起来二十多岁了。\n");
        set("gender", "男性");
        set("age", 22);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 50);
        set("int", 25);
        set("con", 30);
        set("dex", 30);
        
        set("max_qi", 500);
        set("max_jing", 500);
        set("neili", 500);
        set("max_neili", 500);
        set("jiali", 50);
        set("max_neili", 500);
        set("jiali", 10);
      set("combat_exp", 300000);
        set("score", -7000);

        set_skill("force", 100);
        set_skill("wuzhu-xinfa", 100);
        set_skill("dodge", 100);
        set_skill("shunjian-yidong", 100);
        set_skill("sword", 100);
   set_skill("guang-jian", 150);
        set_skill("unarmed", 100);
        set_skill("literate", 100);

        map_skill("force", "wuzhu-xinfa");
        map_skill("dodge", "shunjian-yidong");
        map_skill("sword", "guang-jian");

        set("chat_chance", 1);
        set("chat_msg", ({
        "护殿卫生说道：此处是圣殿的禁地,最好不要来这里。！\n",
        "护殿卫生警惕的看着,一边把手慢慢伸向剑柄。！\n",
          "护殿武士说:听说呀,里面关着一个杀人狂,功夫可厉害了。！\n",
        }) );
        setup();
              carry_object("/clone/cloth/cloth")->wear();
  carry_object("/d/shendian/obj/duzhenjian")->wield();
}

