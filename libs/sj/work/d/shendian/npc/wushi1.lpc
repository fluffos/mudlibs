inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("护殿武士", ({ "wu shi", "wu","shi" }));
        set("long", 
                "他就是护殿武士。\n"
                "他看起来二十多岁了。\n");
        set("gender", "男性");
        set("age", 22);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 30);
        set("int", 25);
        set("con", 30);
        set("dex", 30);
        
   set("max_qi", 500);
       set("max_jing", 500);
  set("neili", 800);
    set("max_neili", 500);
       set("jiali", 30);
   set("combat_exp", 160000);
        set("score", -7000);

     set_skill("force", 100);
        set_skill("wuzhu-xinfa", 50);
      set_skill("dodge", 90);
    set_skill("shunjian-yidong", 100);
        set_skill("sword", 80);
   set_skill("sheshen-zhang", 120);
        set_skill("unarmed", 70);
    set_skill("literate", 50);
  map_skill("force", "wuzhu-xinfa");
        map_skill("dodge", "shunjian-yidong");
        map_skill("unarmed", "sheshen-zhang");
        map_skill("sword", "guang-jian");

        set("chat_chance", 1);
        set("chat_msg", ({
        "护殿卫士说道：圣殿的长老们又悟出一种新的功夫，据说威力极大。！\n",
        "护殿卫士说道：喂，请来加入圣殿吧，圣殿好呀。！\n",
        }) );
        setup();
              carry_object("/clone/cloth/cloth")->wear();

}




