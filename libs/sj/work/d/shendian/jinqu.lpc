#include <room.h>

inherit ROOM;

void create() {
  set("short", "禁区");
  set("long", @LONG
这里就是圣殿的禁区,看你走了过来,周围武士都警戒的看着
你,仍至有几位已经把手放在了剑柄上.显然此地不能久留,还是
先走为妙.
LONG
  );
  set("outdoors", "shendian");

  set("exits", ([
    "east": __DIR__ "luyindao5",
    "northwest": __DIR__ "jinqu1",
  ]));
  set("objects", ([
    __DIR__ "npc/wushi3": 3 ]));
  setup();
}


int valid_leave(object me, string dir) {
  mapping myfam;
  myfam = (mapping)me->query("family");

  if ((!myfam || myfam["family_name"] != "圣殿") && dir == "northwest" &&
    objectp(present("wu", environment(me))))
    return notify_fail("武士一把抓住你,你干什么,非圣殿武士,不得入内.\n");

  return ::valid_leave(me, dir);
}
