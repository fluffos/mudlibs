inherit ROOM;

void create() {
  set("short", "岩洞");
  set("long", @LONG
这里四周没有丝毫的光亮，每前进一步，都要先试探个虚实，但是却觉
得脚下平整，便似走在石板路上一般，只见道路不断地往下倾斜，越走越低。
但是最外面有一个失控的黑洞，好象能回到一个地方。
LONG
  );

  set("exits", ([
    "north": __DIR__ "damen",
    "down": __DIR__ "xiuxis",
    "out": "/d/tianlang/street",
  ]));
  setup();
  replace_program(ROOM);
