inherit NPC;
#include <ansi.h>;
inherit F_MASTER;

void create()
{
        set_name("陈信", ({ "chen xin", "chen" }));
        set("nickname", MAG "天下无敌" NOR);
        set("long", 
                "他就是凤凰星的领袖人物。\n"
                "他已年过半百。\n");
        set("gender", "男性");
        set("age", 56);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 50);
        set("int", 55);
        set("con", 50);
        set("dex", 50);
        
        set("max_qi", 15000);
        set("max_jing", 1500);
        set("neili", 3000);
        set("max_neili", 3000);
        set("jiali", 150);
        set("combat_exp", 1500000);
        set("score", -7000);

        set_skill("force", 220);
        set_skill("tenglong-finger", 220);
        set_skill("liedi-club", 220);
        set_skill("club", 220);
        set_skill("wuzu-xinfa", 220);
        set_skill("yufeng-shu", 220);
        set_skill("jile-dao", 220);
        set_skill("dodge", 220);
        set_skill("fenghuang-shenfa", 220);
        set_skill("rennai", 220);
        set_skill("yinyang-zhang", 200);
        set_skill("parry", 200);
        set_skill("literate", 200);
        set_skill("tenglong-zhang",220);
        set_skill("blade",220);
        set_skill("unarmed",220);
        set_skill("wudijiguang-zhan",220);
        map_skill("force", "wuzu-xinfa");
        map_skill("dodge", "fenghuang-shenfa");
        map_skill("parry", "jile-dao");
        map_skill("club", "liedi-club");
        map_skill("unarmed", "wudijiguang-zhan");
        map_skill("rennai","yufeng-shu");
        map_skill("blade","jile-dao");
        create_family("凤凰星", 2, "宗主");
        set("chat_chance", 1);
        setup();
     carry_object("/d/fenghuang/fenghuang/npc/obj/blade")->wield();
     carry_object("/d/fenghuang/fenghuang/npc/obj/jia")->wear();
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }

}

void greeting(object ob)
{
        object obj;
        obj=this_object();
        tell_room(environment(this_object()),"你这个恶贼，竟敢跑到这里来送死！\n");
    obj->kill_ob(ob);
}

void die()
{
        object  killer;
        int i,exp,pot;
        string skill;
        if( !living(this_object()) ) revive(1);
        this_object()->clear_condition();

        COMBAT_D->announce(this_object(), "dead");
        if( objectp(killer = query_temp("last_damage_from")) ) {
                set_temp("my_killer", killer->query("id"));
                COMBAT_D->killer_reward(killer, this_object());
        }

        if (userp(killer) && killer->query_temp("killme1")==1 && killer->query("budui")!=1)
        {
           exp=random(30000);
           pot=random(15000);
           killer->add("combat_exp",exp);
           killer->add("potential",pot);
           killer->set_temp("killme",0);
           killer->set("budui",1);
           tell_object(killer,HIM"你杀死了正义的陈信，离飘渺世间又近了一步！\n"NOR);
           tell_object(killer,sprintf(HIW"你被奖励了%d点战斗力，%d点学习值 \n"NOR,exp,pot));  
          }
        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());

        this_object()->dismiss_team();
        destruct(this_object());
}





