#include <ansi.h>
inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;void create()
{
        set_name("黄祥", ({ "huang xiang", "huang" }));
        set("nickname", HIW "天生神力" NOR);
        set("age", 25);
        set("title", HIR "猛龙将军" NOR);
        set("gender", "男性");
        set("long", "他是宗主的亲传弟子，掌法了得，臂力惊人，人称猛龙将军。\n");
        set("attitude", "peaceful");


        set("qi", 1000);
        set("max_qi", 1000);
        set("jing", 1000);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali",150);
        set("max_jing", 1000);
        set("str", 32);
        set("dex", 40);
        set("per", 40);
        set("combat_exp", 1000000);
        set("shen_type", 1);

        set_skill("literate", 210);
        set_skill("unarmed",210);
        set_skill("dodge", 210);
        set_skill("parry", 210);
        set_skill("force", 210);
        set_skill("wuzu-xinfa", 210);
        set_skill("fenghuang-shenfa", 210);
        set_skill("yinyang-zhang",210);
        set_temp("apply/attack", 80);
        set_temp("apply/defense", 80);
        set_temp("apply/damage", 40);
        set_temp("apply/armor", 80);
        map_skill("unarmed","yinyang-zhang");
        map_skill("parry", "yinyang-zhang");
        map_skill("dodge", "fenghuang-shenfa");
        map_skill("force", "wuzu-xinfa");
        create_family("凤凰星",3,"大将");
        setup();
        carry_object("/u/zhangm/fenghuang/obj/pixue")->wear();
        carry_object("/u/zhangm/fenghuang/obj/junfu")->wear();
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }

}

void greeting(object ob)
{
        object obj;
        obj=this_object();
        tell_room(environment(this_object()),"你这个恶贼，竟敢跑到这里来送死！\n");
  obj->kill_ob(ob);
}

void die()
{
        object  killer;
        int i,exp,pot;
        string skill;
        if( !living(this_object()) ) revive(1);
        this_object()->clear_condition();

        COMBAT_D->announce(this_object(), "dead");
        if( objectp(killer = query_temp("last_damage_from")) ) {
                set_temp("my_killer", killer->query("id"));
                COMBAT_D->killer_reward(killer, this_object());
        }

        if (userp(killer) && killer->query_temp("killme1")==1 && killer->query("budui")!=1)
        {
           exp=random(20000);
           pot=random(10000);
           killer->add("combat_exp",exp);
           killer->add("potential",pot);
           tell_object(killer,HIM"你杀死了正义的黄祥，离飘渺世间又近了一步！\n"NOR);
           tell_object(killer,sprintf(HIW"你被奖励了%d点战斗力，%d点学习值 \n"NOR,exp,pot));  
          }
        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());

        this_object()->dismiss_team();
        destruct(this_object());
}






