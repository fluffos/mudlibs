

inherit NPC;
string ask_me();
void create()
{
        set_name("凤凰战士", ({ "zhan shi", "shi" }));
        set("long", 
                "一个全负武装的凤凰星战士。\n");
        set("gender", "男性");
        set("age", 20);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 10);
        set("int", 15);
        set("con", 10);
        set("dex", 10);
        
        set("max_qi", 500);
        set("max_jing", 500);
        set("neili", 500);
        set("max_neili", 500);
        set("jiali", 100);
        set("combat_exp", 100000);
        set("score", 100);

        set_skill("force", 100);
        set_skill("dodge", 100);
        set_skill("parry", 100);
        set_skill("unarmed",100);
        set_skill("yinyang-zhang", 100);
        set_skill("wuzu-xinfa",100);
        set_skill("lingboweibu",100);
        map_skill("force","wuzu-xinfa");
        map_skill("dodge","lingboweibu",100);
        map_skill("parry","yinyang-zhang"); 
        map_skill("unarmed","yinyang-zhang");
        setup();
}

