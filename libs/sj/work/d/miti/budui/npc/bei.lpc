// bei.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_me();
int jiandi1();
int jiandi2();
void create()
{
        set_name("贝斯威", ({ "bei shiwei", "bei" }));
        set("long", 
                "他就是特种部队里的大队长。\n"
                "他已年过三十。\n");
        set("gender", "男性");
        set("age", 31);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 30);
        set("int", 25);
        set("con", 30);
        set("dex", 30);
        
        set("max_qi", 1500);
        set("max_jing", 1500);
        set("neili", 1500);
        set("max_neili", 1500);
        set("jiali", 150);
        set("combat_exp", 1000000);
        set("score", -7000);

        set_skill("force", 200);
        set_skill("jiqi-gaizao", 200);
        set_skill("dodge", 200);
        set_skill("jiqi-qudong", 200);
        set_skill("gun", 200);
        set_skill("jiguang-gun", 200);
        set_skill("parry", 200);
        set_skill("literate", 200);
        set_skill("duanqing-xinfa",200);
        set_skill("lengxue-dao",200);
        set_skill("yinyang-zhang",200);
        set_skill("unarmed",200);
        set_skill("blade",200);
        map_skill("force", "duanqing-xinfa");
        map_skill("dodge", "jiqi-qudong");
        map_skill("parry", "jiguang-gun");
        map_skill("gun", "jiguang-gun");
        map_skill("unarmed","yinyang-zhang");
        map_skill("blade","lengxue-dao");
        create_family("特种部队", 2, "大队长");
         set("inquiry", ([
                "下去" : (: ask_me :),
        ]));
        setup();
}

string ask_me()
{ object ob=this_player();
  if (ob->query("budui")==1) return "你已经完成任务了！还到这里来干什么\n";
  command("say 根据雷达探测，敌人就在下面。现派你下去歼敌，你可愿意？(Y/N)");
  input_to("jiandi");
return "哈哈哈哈！\n";
}

int jiandi(string arg)
{
  if (arg=="Y" || arg=="y")
   {    
   jiandi1();
   return 1;
  }
  if (arg=="N" || arg=="n") 
   {
    jiandi2();
    return 1;
   }
  command("say 你到底选择什么？");
  return 1;
}

int jiandi1()
{
  object me,obj;
  me=this_player();
  obj=this_object();
  command("say 你这个叛贼，竟然不听我的话，看我不杀了你！");
  me->set_temp("killme",1);
  obj->kill_ob(me);
  return 1;
}

int jiandi2()
{ 
  object me;
  me=this_player();
  command("say 那好，你就下去吧，不过要小心呀！");
  me->set_temp("killme1",1);
  me->move("/d/miti/budui/didao2");
  return 1;
 } 

void die()
{
        object  killer;
        int i,exp,pot;
        string skill;
        if( !living(this_object()) ) revive(1);
        this_object()->clear_condition();

        COMBAT_D->announce(this_object(), "dead");
        if( objectp(killer = query_temp("last_damage_from")) ) {
                set_temp("my_killer", killer->query("id"));
                COMBAT_D->killer_reward(killer, this_object());
        }

        if (userp(killer) && killer->query_temp("killme")==1 && killer->query("budui")!=1)
        {
           exp=random(20000);
           pot=random(10000);
           killer->add("combat_exp",exp);
           killer->add("potential",pot);
           killer->set_temp("killme",0);
           killer->set("budui",1);
           tell_object(killer,HIM"你杀死了邪恶的大队长，离飘渺世间又近了一步！\n"NOR);
           tell_object(killer,sprintf(HIW"你被奖励了%d点战斗力，%d点学习值 \n"NOR,exp,pot));  
          }
        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());

        this_object()->dismiss_team();
        destruct(this_object());
}


