inherit ROOM;

#include <ansi.h>
void create() {
  set("short", HIW "皇族医院" NOR);
  set("long", @LONG
这里就是特种医院了，皇族队员可以在这免费医疗
其它门派是进不来的，这里的环境看起来相当的好，给人一种
清净的感觉。特种部队的队员在这医疗请用(yiliao)指令。
LONG);
  set("exits", ([
    "west": "/d/huang/luxingchu",
  ]));
  setup();
}
void init() {
  add_action("do_yiliao", "yiliao");
}
int do_yiliao() {
  object me;
  int max;
  me = this_player();
  if (!me->query("family/family_name") || me->query("family/family_name") != "皇族")
    return notify_fail("你不是皇族的队员，不能医疗。\n");
  max = me->query("max_qi");
  if (me->query("eff_qi") == max) return notify_fail("你没有受伤！\n");
  max = me->query("max_qi");
  me->set("eff_qi", max);
  max = me->query("max_jing");
  me->set("eff_jing", max);
  me->start_busy(3);
  message_vision("$N做在医疗室里，享受着医疗的舒适。\n", me);
  return 1;
}
