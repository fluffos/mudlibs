inherit SKILL;

int valid_enable(string usage) { return usage == "rennai"; }

int valid_learn(object me)
{
  if ((int)me->query_skill("rennai", 1) < 20)
 return notify_fail("你的忍耐技能火候还不够。\n");
        return 1;
}

int practice_skill(object me)
{
return notify_fail("坚体术只能用学。\n");
}

string baofa_function_file(string func)
{
 return __DIR__"jianti-shu/" + func;
}