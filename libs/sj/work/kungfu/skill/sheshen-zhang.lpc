        "damage" : 290,
        "lvl" : 80,
        "damage_type" : "内伤"
]),
});


int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 100)
                return notify_fail("你的气息不够。\n");
  if ((int)me->query_skill("wuzhu-xinfa", 1) < 20 )
                return notify_fail("你的唯尊心法火候太浅。\n");
        return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
     level   = (int) me->query_skill("sheshen-zhang",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
        object weapon;

          if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("学神圣君掌不能用武器。\n");
        if (((int)me->query("qi") < 50) || (int)me->query("jing")<20)
        return notify_fail("你的体力不够练神圣掌。\n");
        me->receive_damage("qi", random(40));
        me->receive_damage("jing", random(20));
        return 1;
}
string perform_action_file(string action)
{
        return __DIR__"sheshen-zhang/" + action;
}
