        "force" : 180,
        "dodge" : -5,
        "parry"    :   10,
        "damage" : 180,
        "lvl" : 20,
        "damage_type" : "内伤"
]),
([      "action" : "$N突然加速，在$n周围穿插游走，虚虚实实从四面八方向$n拍出无数的掌影，这一式"BLINK HIM"「八面威风"NOR"」竟令$n无从防起。",
        "force" : 200,
        "dodge" : 5,
        "parry" : 5,
        "damage" : 200,
        "lvl" : 30,
        "damage_type" : "内伤"
]),
([	"action": "$N突然身形飞起，双掌居高临下一招"HIB"「双龙在天」"NOR"拍向$n的$l",
        "force" : 220,
        "dodge" : 10,
        "parry" : 10,
        "damage" : 220,
        "lvl" : 40,
