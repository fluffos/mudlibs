    "force": 140,
    "dodge": 10,
    "damage": 70,
    "lvl": 9,
    "skill_name": "闪电惊虹",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w一抖，一招「日在九天」，斜斜一剑反腕撩出，攻向$n的$l",
    "force": 160,
    "dodge": 5,
    "damage": 80,
    "lvl": 18,
    "skill_name": "日在九天",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中剑锵啷啷长吟一声，一式「火色烈阳」，一道剑光飞向$n的$l",
    "force": 180,
    "dodge": 10,
    "damage": 110,
    "lvl": 27,
    "skill_name": "火色烈阳",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一式「怒剑骄阳」，手中$w舞出无数剑花，使$n难断虚实，无可躲避",
    "force": 220,
    "dodge": 15,
    "damage": 120,
    "lvl": 36,
    "skill_name": "怒剑骄阳",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w斜指苍天，剑芒吞吐，一式「九弧震日」，对准$n的$l斜斜击出",
    "force": 260,
    "dodge": 5,
    "damage": 170,
    "lvl": 44,
    "skill_name": "九弧震日",
