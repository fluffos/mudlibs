/* <SecCrypt CPL V3R05> */
 
// zhanlong-dafa.c 【斩龙大法】
inherit SKILL;

int valid_enable(string usage) { return usage=="spells"; }

int valid_learn(object me)
{
        if( (int)me->query_skill("spells", 1) < 10
        ||      (int)me->query_skill("spells", 1) <=
(int)me->query_skill("zhanlong-dafa", 1) )
                return
notify_fail("你的灵术修为还不够高深，无法学习斩龙大法。\n");
        return 1;
}

string cast_spell_file(string spell)
{
        return CLASS_D("yaomo") + "/kungfu/skill/dengxian-dafa/" + spell;
}



