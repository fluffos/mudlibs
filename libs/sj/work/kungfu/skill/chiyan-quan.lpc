([      "action" : RED
"$N步伐轻灵，两臂伸舒如鞭，一式"MAG"「赤地千里」"NOR"，"HIB"令$n无可躲闪",NOR
        "force" : 230,
        "dodge" : 15,
        "damage": 10,
        "lvl" : 20,
        "skill_name" : "赤地千里",
        "damage_type" : "内伤"
]),
([      "action" : HIW
"$N身形跃起，一式"RED"「火海刀山」"NOR"，"BLU"双拳当空击下，势不可挡",NOR
        "force" : 270,
        "dodge" : 5,
        "damage": 20,
        "lvl" : 30,
        "skill_name" : "火海刀山",
        "damage_type" : "内伤"
]),
([      "action" : YEL
"$N身形一矮，一式"HIW"「焚心似火」"NOR"，"HIM"两拳自下而上，攻向$n",NOR
        "force" : 250,
        "dodge" : 10,
        "damage": 15,
        "lvl" : 40,
        "skill_name" : "焚心似火",
        "damage_type" : "内伤"
]),
([      "action" : HIB
 "$N身形一转，一式"HIB"「烈焰冲天」"NOR"，"YEL"攻向$n的身前身后",NOR
        "force" : 280,
        "dodge" : 25,
        "damage": 25,
        "lvl" : 48,
        "skill_name" : "烈焰冲天",
