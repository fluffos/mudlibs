inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create() {
  set_name(HIC "史太龙" NOR, ({ "shitailong", "master" }));
  set("nickname", HIB "胸肌男子" NOR);
  set("gender", "男性");
  set("age", 30);
  set("long",
    "他就是特种部队的黑暗首领，号称胸肌男子的史太龙。\n");
  set("attitude", "peaceful");

  set("str", 50);
  set("int", 50);
  set("con", 50);
  set("dex", 50);
  set("qi", 9000);
  set("max_qi", 9000);
  set("jing", 5000);
  set("max_jing", 5000);
  set("neili", 9000);
  set("max_neili", 9000);
  set("jiali", 300);

  set("combat_exp", 5000000);
  set("score", -200000);

  set_skill("force", 200);
  set_skill("duanqing-xinfa", 200);
  set_skill("blade", 200);
  set_skill("lengxue-dao", 200);
  set_skill("dodge", 200);
  set_skill("jiqi-qudong", 200);
  set_skill("parry", 200);
  set_skill("unarmed", 200);
  set_skill("yinyang-zhang", 200);


  map_skill("force", "duanqing-xinfa");
  map_skill("unarmed", "yinyang-zhang");
  map_skill("dodge", "jiqi-qudong");
  map_skill("parry", "lengxue-dao");
  map_skill("blade", "lengxue-dao");

  create_family("特种部队", 2, "黑暗首领");

  setup();

}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("jiqi-gaizao", 1) < 150) {
    command("say 你的机器改造还没到家");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("say 希望你杀人无数,发扬我特种部队!");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "killer")
    ob->set("class", "killer");
}
