// song.c 宋天楚

inherit NPC;
inherit F_MASTER;

string ask_me();

void create()
{
	set_name("宋天楚", ({ "song tianchu", "song" }));
	set("nickname", "暗黑首魔");
	set("long", 
		"他就是死神的大弟子、暗黑七魔之首的宋天楚。\n"
		"身穿一件闪闪发光的龙袍。\n"
		"他已年过六十，身材瘦长，满脸红光。恬淡冲和，沉默寡言。\n");
	set("gender", "男性");
	set("age", 61);
	set("attitude", "peaceful");
	set("shen_type", -1);
	set("str", 28);
	set("int", 28);
	set("con", 28);
	set("dex", 28);
	
	set("max_qi", 5000);
	set("max_jing", 5000);
	set("neili", 8000);
	set("max_neili", 8000);
	set("jiali", 50);
	set("combat_exp", 4000000);
	set("score", 70000);

	set_skill("force", 200);
	set_skill("anhei-shengong", 200);
	set_skill("dodge", 185);
	set_skill("guimei", 160);
	set_skill("unarmed", 200);
	set_skill("duzun-zhao", 180);
	set_skill("parry", 180);
	set_skill("sword", 180);
//	set_skill("long-jian", 160);
	set_skill("literate", 150);
	set_skill("anhei-xinfa", 150);

	map_skill("force", "anhei-shengong");
	map_skill("dodge", "guimei");
	map_skill("unarmed", "duzun-zhao");
//	map_skill("parry", "long-jian");
//	map_skill("sword", "long-jian");

	create_family("暗黑门", 3, "首领");

	set("inquiry", ([
		"秘籍" : (: ask_me :),
	]));

	set("book_count", 1);

	set("chat_chance_combat", 40);
	set("chat_msg_combat", ({
		(: perform_action, "unarmed.hunpofeiyang" :),
		(: exert_function, "recover" :),
	}) );

	setup();
//	carry_object("/d/anhei/obj/changjian.lpc")->wield();
	carry_object("/d/anhei/obj/cloth.lpc")->wear();

}

void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen") > 0) {
		command("say 我暗黑门乃是堂堂大派，对弟子要求极严。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否还做得不够？");
		return;
	}
	command("say 好吧，本尊就收下你了。");
	command("recruit " + ob->query("id"));
	if( (string)ob->query("class") != "anhei")
		ob->set("class", "anhei");
}

string ask_me()
{
	mapping fam; 
	object ob;
	
	if (!(fam = this_player()->query("family")) || fam["family_name"] != "暗黑门")
		return RANK_D->query_respect(this_player()) + 
		"与本门素无来往，不知此话从何谈起？";
	if (query("book_count") < 1)
		return "你来晚了，本门的内功心法不在此处。";
	add("book_count", -1);
	ob = new(__DIR__"force_book");
	ob->move(this_player());
	return "好吧，这本「暗黑神功图」你拿回去好好钻研。";
}
