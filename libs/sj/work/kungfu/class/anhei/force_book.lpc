// force_book.c 内功心法

inherit ITEM;

void create()
{
	set_name("暗黑神功图", ({ "shu", "book" }));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是一本电子刊物，里面密密麻麻的画了不少打坐吐呐的姿势。\n");
		set("value", 500);
		set("material", "paper");
		set("skill", ([
			"name":	"anhei-shengong",	// name of the skill
			"exp_required":	500000,	// minimum combat experience required
			"jing_cost":	30,	// jing cost every time study this
			"difficulty":	10,	// the base int to learn this skill
			"max_skill":	80	// the maximum level you can learn
		]) );
	}
}
