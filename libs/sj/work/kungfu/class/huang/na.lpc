// na.c

inherit NPC;

void create()
{
        set_name("艾琳娜", ({ "ailing na", "na" }));
        set("long", 
                "她就是皇族美丽的小公主。\n"
                "她正值花季年龄。\n");
        set("gender", "女性");
        set("age", 18);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);

        set("max_qi", 1000);
        set("max_jing", 1000);
        set("neili", 1000);
        set("max_neili", 1000);
        set("jiali", 150);
        set("combat_exp", 5000000);
        set("score", 7000);

        set_skill("force", 150);
        set_skill("baqi-jue", 150);
        set_skill("dodge", 150);
        set_skill("weizhen-steps", 180);
        set_skill("strike", 150);
        set_skill("bashan-zhang", 200);
        set_skill("parry", 150);
        set_skill("literate", 150);
        set_skill("dingbang-jian",180);
        set_skill("sword",150);
        set_skill("cuff",150);
        set_skill("chiyan-quan",180);
        map_skill("force", "baqi-jue");
        map_skill("dodge", "weizhen-steps");
        map_skill("parry", "dingbang-jian");
        map_skill("strike", "bashan-zhang");
        map_skill("cuff","chiyan-quan");
        map_skill("sword","dingbang-jian");
        create_family( "皇族",2,"小公主");
        setup();
              carry_object("/d/huang/obj/qiankun")->wield();
              carry_object("/d/huang/obj/cai-cloth")->wear();

}
