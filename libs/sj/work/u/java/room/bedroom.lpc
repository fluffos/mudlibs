#include <room.h>
inherit ROOM;

void create()
{
      set("short", "松竹小筑");
      set("long", @LONG
入门正中悬挂一幅唐伯虎画的<<海棠春睡图>>，两边有宋学士
秦太虚写的一副对联，云：
    嫩寒锁梦因春冷  芳气笼人是酒香
    香炉中的檀香袅袅，含而不化。案上的宝镜映着淡淡青烟，益
发撩人。
    轻罗烟般的联珠帐笼罩着的连理榻，纱衾软软，鸳枕依依。
    这里是本泥塘天后居室。
LONG );
      set("exits", ([ /* sizeof() == 1 */
          "down": "/u/java/workroom",
          "east": __DIR__"readroom",
      ]));
      set("valid_startroom","1");

      set("no_fight", 1);
      set("no_clean_up", 0);
      set("sleep_room", 1);
      setup();
      create_door("east", "垂花小门", "west", DOOR_CLOSED);
}
