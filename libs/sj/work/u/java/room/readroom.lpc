#include <room.h>
inherit ROOM;

string look_window();

void create() {
  set("short", "天籁小阁");
  set("long", @LONG
这里是天后的书房。
    屋里平排着十列书架，满满当当都是天下武林秘籍。这是她少年
时候壮游宇内，遍访名山收罗来的天下所有的门派的武功。
    屋角小窗(window)下，一灯如豆，齐膝高的小书案上有几卷摊开
的书。
LONG);
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "bedroom"
  ]));
  set("item_desc", ([
    "window":
    "    这里是花园西阁楼二楼的窗台，从这里可以遥望整个花园，\n"
    "高耸入云的北山。浮世烟尘，尽在眼底。\n",
  ]));
  /*
      set("objects", ([
          "/clone/book/lbook1" : 1,
          "/clone/book/lbook2" : 1,
          "/clone/book/lbook3" : 1,
          "/clone/book/lbook4" : 1,
          "/clone/book/daodejing-i" : 1, 
          "/clone/book/daodejing-ii" : 1, 
          "/clone/book/skybook" : 1,
          "/clone/book/ls_book" : 1,
          "/clone/food/wuchangdan" : 1,
      ]));
*/
  set("valid_startroom", 1);
  set("no_fight", 1);
  set("no_clean_up", 0);
  setup();
  create_door("west", "垂花小门", "east", DOOR_CLOSED);
}

string look_out() {
  return "    这里是花园西阁楼二楼的窗台，从这里可以遥望整个花园，\n"
    "高耸入云的北山。浮世烟尘，尽在眼底。\n";
}
