inherit ROOM;
#include <room.h>
void create()
{
      set("short","门派捷径");
      set("long",@LONG
你站在云层中。俯瞰下界，青山点点，碧水迢迢，宛若一副绝妙的
山水盆景。禅院道场，钟鼓隐隐，紫气条条。真是好风光。
    少林寺：  southdown
    武当山：  westdown
    峨嵋山：  eastdown
    青城山：  northdown
    嵩  山：  down
    泰  山：  east
    华  山：  west
    衡  山：  south
    恒  山：  north
    雪山派：  southwest
    逍遥派：  southeast
LONG);

      set("exits",([ /* sizeof() == 1 */
          "southdown" : "/d/shaolin/dxbdian",
          "westdown"  : "/d/wudang/sanqingdian",
          "eastdown"  : "/d/emei/hcaguangchang",
          "northdown"  : "/d/qingcheng/songfengguan",
          "east"      : "/d/taishan/fengchan",
          "down"      : "/d/songshan/chanyuan",
          "west"      : "/d/huashan/qunxianguan",
          "north"     : "/d/hengshan/square",
          "south"     : "/d/henshan/zhurongdian",
          "southeast" : "/d/xiaoyao/qingcaop",
          "southwest" : "/d/xueshan/dadian",
      ]));

      setup();
}
