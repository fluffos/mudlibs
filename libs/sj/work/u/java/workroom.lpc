inherit ROOM;
#include <room.h>

void create()
{
      set("short","怜月小居");
      set("long",@LONG
这是一间简陋的草堂，屋角有一张木床靠近窗台放着一张表面
斑驳的木桌和一条竹椅，桌的左首是一盏昏黄的油灯，右边则凌乱
地摆放着几册泛黄的线装书，中央用铜镇纸压着一幅书法，龙飞凤
舞般地写着十六个大字：“生死涅磐，犹如昨梦；菩提烦恼，等似
空花。”显见主人淡泊功名之极。
LONG);
      set("exits",([ /* sizeof() == 1 */
          "up"    : __DIR__"room/bedroom",
          "east"  : __DIR__"room/faction",
          "west"  : __DIR__"room/society",
          "north" : __DIR__"room/towns",
          "south" : __DIR__"room/garden",
      ]));
      set("valid_startroom","1");
      setup();
      create_door("south", "垂花小门", "north", DOOR_CLOSED);
//      create_door("north", "市镇小门", "south", DOOR_CLOSED);
//      create_door("east" , "门派小门", "west" , DOOR_CLOSED);
//      create_door("west" , "帮会小门", "east" , DOOR_CLOSED);
}

