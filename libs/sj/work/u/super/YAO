inherit ITEM;
void create()
{
     set_name("毒药",({"yao"});
     set("long","看什么看，就是毒药你也得吃！\n");
     setup();
}
void init()
{
     add_action("do_eat","eat");
}
int do_eat(string arg)
{
     object me=this_player();
  if (!arg || arg != "yao" ) return notify_fail("巫师喊你吃的东西，你敢不吃？\n");
 write("你吃了一个毒药，心里感到有点不畅快~\n");
  me->add("money",1000)
 return 1;
}
