inherit BULLETIN_BOARD;
#include <ansi.h>

void create()
{
        set_name(HIC"凤凰星留言板"NOR, ({ "board" }) );
        set("location", "/d/fenghuang/fenghuang/zhongxin");
        set("board_id", "fenghuang_b");
        set("long", "这是凤凰星的留言板。\n" );
        setup();
        set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}

