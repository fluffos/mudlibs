inherit NPC;
#include <ansi.h>;
inherit F_MASTER;

void create() {
  set_name("陈信", ({ "chen xin", "chen" }));
  set("nickname", MAG "天下无敌" NOR);
  set("long",
    "他就是凤凰星的领袖人物。\n"
    "他已年过半百。\n");
  set("gender", "男性");
  set("age", 56);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 50);
  set("int", 55);
  set("con", 50);
  set("dex", 50);

  set("max_qi", 15000);
  set("max_jing", 1500);
  set("neili", 1500);
  set("max_neili", 35000);
  set("jiali", 150);
  set("combat_exp", 6400000);
  set("score", -7000);

  set_skill("force", 400);
  set_skill("tenglong-finger", 400);
  set_skill("liedi-club", 400);
  set_skill("club", 400);
  set_skill("wuzu-xinfa", 400);
  set_skill("yufeng-shu", 400);
  set_skill("jile-dao", 400);
  set_skill("dodge", 400);
  set_skill("fenghuang-shenfa", 400);
  set_skill("rennai", 400);
  set_skill("yinyang-zhang", 400);
  set_skill("parry", 400);
  set_skill("literate", 500);
  set_skill("tenglong-zhang", 400);
  set_skill("blade", 400);
  set_skill("unarmed", 400);
  set_skill("wudijiguang-zhan", 400);
  map_skill("force", "wuzu-xinfa");
  map_skill("dodge", "fenghuang-shenfa");
  map_skill("parry", "jile-dao");
  map_skill("club", "liedi-club");
  map_skill("unarmed", "wudijiguang-zhan");
  map_skill("rennai", "yufeng-shu");
  map_skill("blade", "jile-dao");
  create_family("凤凰星", 2, "宗主");
  set("chat_chance", 1);
  set("chat_msg", ({
    "陈信把手放进金盆里。\n",
    "陈信自言自语的说：要一统天下必须心狠手辣！\n",
    "陈信威严的咳嗽了一声。\n",
  }));

  setup();
  carry_object("/d/fenghuang/fenghuang/npc/obj/key");
  carry_object("/d/fenghuang/fenghuang/npc/obj/blade")->wield();
  carry_object("/d/fenghuang/fenghuang/npc/obj/jia")->wear();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("wuzu-xinfa", 1) < 160) {
    command("say 你的无祖心法还太差了");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("say 希望你它日能助我一统天下！");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "killer")
    ob->set("class", "killer");
}
