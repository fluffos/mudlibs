inherit NPC;


void create()
{
  set_name("机器人", ({"jiqi ren", "jiqi"}));
  set("race", "野兽");
  set("age", 10);

  set_skill("dodge", 60);
  set("combat_exp", 10000);
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
  set("verbs", ({ "bite"}));

  set("chat_chance", 1);

  set("ride/msg", "坐");
  set("ride/dodge", 1);
  set("ride/damage", 1);
  set("ride/attack", 1);
  set("ride/parry", 1);
  set("ride/armor", 1);
  set_temp("apply/attack", 1);
  set_temp("apply/armor", 1);
  setup();
}

