inherit ITEM;
#include <ansi.h>

void create()
{
set_name(HIC"寂寞牌万能商务通"NOR, ({"shou ji","xunhu ji","jieshou qi","czb"}));
        set_weight(500);
set("num", 10);
set("value",1000);
        set("unit", "块");
set("no_get", 1);
set("no_drop", 0);
        set("long", "这是一块闪闪发亮的外星金属。\n");
        setup();
}
int query_autoload()
{
return 1;
}

