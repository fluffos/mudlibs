// Room: bog1.c
// Date: Mar 2 1998

#include <ansi.h>
inherit ROOM;

void init();
int do_wang();

void create()
{
      set("short", "黑暗之泽");
      set("long", @LONG
这里是一片无尽的黑沼泽，又臭又脏并冒着黑泡的污水，
夹着腐烂的泥巴淹没了你的脚面。四处望望看不到边，让你觉
得真是上天无路入地无门，还是快快回头是岸吧。
LONG );
      set("outdoors", "solomon");
      set("no_fight", "1");
      set("no_steal", "1");
      setup();
}

void init()
{
    add_action("do_wang", "wang");
}

int do_wang()
{
    object ob;
    ob = this_player();
    message_vision(HIC"$N极目四望，发现有一条脚印踩出的路，于是求生试探之心大动。\n"NOR, ob);
    switch (random(4))
    {
       case 0 : set("exits/east", __DIR__"bog5");break;
       case 1 : set("exits/east", __DIR__"bog7");break;
       case 2 : set("exits/east", __DIR__"bog5");break;
       default: set("exits/east", __DIR__"bog6");
    }
    switch (random(4))
    {
       case 0 : set("exits/west", __DIR__"bog5");break;
       case 1 : set("exits/west", __DIR__"bog6");break;
       case 2 : set("exits/west", __DIR__"bog5");break;
       default: set("exits/west", __DIR__"bog6");
    }
    switch (random(4))
    {
       case 0 : set("exits/south", __DIR__"bog5");break;
       case 1 : set("exits/south", __DIR__"bog6");break;
       case 2 : set("exits/south", __DIR__"bog5");break;
       default: set("exits/south", __DIR__"bog6");
    }
    switch (random(4))
    {
       case 0 : set("exits/north", __DIR__"bog5");break;
       case 1 : set("exits/north", __DIR__"bog6");break;
       case 2 : set("exits/north", __DIR__"bog5");break;
       default: set("exits/north", __DIR__"bog6");
    }
    remove_call_out("close_out");
    call_out("close_out", 3);
    return 1;
}

void close_out()
{
    if (query("exits/east"))  delete("exits/east");
    if (query("exits/west"))  delete("exits/west");
    if (query("exits/south")) delete("exits/south");
    if (query("exits/north")) delete("exits/north");
}
