// Room: readroom.c
// Date: Mar 2 1998

inherit ROOM;
#include <room.h>

object chouti;
object ob1,ob2,ob3,ob4,ob5,ob6,ob7,ob8,ob9,ob10;

void init();
void d_dakai(string arg);
void d_guanbi();
int valid_leave(object me, string dir);
int do_nothing();

void create()
{
      set("short", "书房");
      set("long", @LONG
屋里平排着十列书架，满满当当都是从燕子坞搬来的天下各种秘
籍。十个书架分成了好多个抽屉，每个抽屉都贴有明显的标签，有文
学部(literate)，杂学部(zaxue)，内功部(force)，剑法部(sword)，
掌法部(strike)，心法部(xinfa)，拳法部(cuff)，鞭法部(whip)，
佛经部(fojing)，手法部(hand)，爪法部(claw)，轻功部(dodge)，
杖法部(staff)，指法部(finger)等等。
LONG );
      set("exits", ([
          "west" : __DIR__"bedroom"
      ]));
      set("item_desc", ([
          "literate" : "这是一个装满文学宝书的抽屉，你可以试着打开。",
          "other"    : "这是一个装满杂学密籍的抽屉，你可以试着打开。",
          "force"    : "这是一个装满内功密籍的抽屉，你可以试着打开。",
          "sword"    : "这是一个装满剑法密籍的抽屉，你可以试着打开。",
          "strike"   : "这是一个装满掌法密籍的抽屉，你可以试着打开。",
          "xinfa"    : "这是一个装满心法密籍的抽屉，你可以试着打开。",
          "cuff"     : "这是一个装满拳法密籍的抽屉，你可以试着打开。",
          "whip"     : "这是一个装满鞭法密籍的抽屉，你可以试着打开。",
          "fojing"   : "这是一个装满佛经经典的抽屉，你可以试着打开。",
          "hand"     : "这是一个装满手法密籍的抽屉，你可以试着打开。",
          "dodge"    : "这是一个装满轻功密籍的抽屉，你可以试着打开。",
          "parry"    : "这是一个装满招架密籍的抽屉，你可以试着打开。",
          "staff"    : "这是一个装满杖法密籍的抽屉，你可以试着打开。",
          "finger"   : "这是一个装满指法密籍的抽屉，你可以试着打开。",
      ]));
      set("valid_startroom", "1");
      set("no_fight", "1");
      set("no_steal", "1");
      set("no_clean_up", 0);
      setup();
      create_door("west", "书库小门", "east", DOOR_CLOSED);
}

void init()
{
      add_action("d_dakai","dakai");
      add_action("d_guanbi","guanbi");
      add_action("do_nothing","save");
      add_action("do_nothing","quit");
}

int do_nothing()
{
        return 1;
}

int d_dakai(string arg)
{
      object me;
      if (!arg)
            return notify_fail("你想打开哪个抽屉？\n");
      me = this_player();
      if (me->query_temp("mark/dakai"))
            return notify_fail("你已打开一个抽屉了。\n");
      switch (arg)
      {
             case "literate":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/clone/book/lbook1");
                   ob2=new("/clone/book/lbook2");
                   ob3=new("/clone/book/lbook3");
                   ob4=new("/d/xiaoyao/obj/lbook4");
                   ob5=new("/d/shaolin/obj/book-paper");
                   ob4->move(chouti);
                   ob3->move(chouti);
                   ob2->move(chouti);
                   ob1->move(chouti);
                   ob5->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",5);
                   return notify_fail("你打开文学部抽屉。\n");
                   break;
             case "zaxue":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/d/shaolin/obj/xisuijing");
                   ob2=new("/clone/book/skybook");
                   ob3=new("/d/xingxiu/obj/dujing_1");
                   ob4=new("/d/city2/obj/bookming");
                   ob5=new("/d/shaolin/obj/wuji1");
                   ob6=new("/d/shaolin/obj/wuji2");
                   ob7=new("/d/shaolin/obj/wuji3");
                   ob1->move(chouti);
                   ob2->move(chouti);
                   ob3->move(chouti);
                   ob4->move(chouti);
                   ob5->move(chouti);
                   ob6->move(chouti);
                   ob7->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",7);
                   return notify_fail("你打开杂学部抽屉。\n");
                   break;
             case "force":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/kungfu/class/huashan/zixia_book");
                   ob2=new("/d/shaolin/obj/yijinjing");
                   ob3=new("/d/taohua/obj/jiuyin1");
                   ob4=new("/d/shaolin/obj/book-silk");
                   ob1->move(chouti);
                   ob2->move(chouti);
                   ob3->move(chouti);
                   ob4->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",4);
                   return notify_fail("你打开内功部抽屉。\n");
                   break;
             case "sword":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/d/heimuya/obj/kuihua");
                   ob2=new("/clone/book/ls_book");
                   ob3=new("/d/city2/obj/yljianpu");
                   ob4=new("/d/lingjiu/obj/qijianpu");
                   ob1->move(chouti);
                   ob2->move(chouti);
                   ob3->move(chouti);
                   ob4->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",4);
                   return notify_fail("你打开剑法部抽屉。\n");
                   break;
             case "strike":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/d/lingjiu/obj/liuyangzhangfa1");
                   ob2=new("/d/lingjiu/obj/liuyangzhangfa2");
                   ob2->move(chouti);
                   ob1->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",2);
                   return notify_fail("你打开掌法部抽屉。\n");
                   break;
             case "xinfa":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/d/wudang/obj/daodejing-i");
                   ob2=new("/d/wudang/obj/daodejing-ii");
                   ob3=new("/d/xueshan/obj/jing");
                   ob3->move(chouti);
                   ob2->move(chouti);
                   ob1->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",3);
                   return notify_fail("你打开心法部抽屉。\n");
                   break;
             case "cuff":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/d/wudang/obj/quanpu");
                   ob2=new("/d/shaolin/obj/book-stone");
                   ob1->move(chouti);
                   ob2->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",2);
                   return notify_fail("你打开拳法部抽屉。\n");
                   break;
             case "whip":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/d/city2/obj/ylbian");
                   ob1->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",1);
                   return notify_fail("你打开鞭法部抽屉。\n");
                   break;
             case "fojing":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/d/city2/obj/book14_1");
                   ob2=new("/d/city2/obj/book14_2");
                   ob3=new("/d/city2/obj/book14_3");
                   ob4=new("/d/city2/obj/book14_4");
                   ob5=new("/d/city2/obj/book14_5");
                   ob6=new("/d/city2/obj/book14_6");
                   ob7=new("/d/city2/obj/book14_7");
                   ob8=new("/d/city2/obj/book14_8");
                   ob9=new("/d/emei/obj/fojing10");
                   ob10=new("/d/emei/obj/fojing20");
                   ob10->move(chouti);
                   ob9->move(chouti);
                   ob8->move(chouti);
                   ob7->move(chouti);
                   ob6->move(chouti);
                   ob5->move(chouti);
                   ob4->move(chouti);
                   ob3->move(chouti);
                   ob2->move(chouti);
                   ob1->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",10);
                   return notify_fail("你打开佛经部抽屉。\n");
                   break;
             case "hand":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/d/lingjiu/obj/zhemeitu1");
                   ob2=new("/d/lingjiu/obj/zhemeitu2");
                   ob3=new("/d/shenlong/obj/shoufa");
                   ob3->move(chouti);
                   ob2->move(chouti);
                   ob1->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",3);
                   return notify_fail("你打开手法部抽屉。\n");
                   break;
             case "claw":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/d/taohua/obj/jiuyin2");
                   ob1->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",1);
                   return notify_fail("你打开爪法部抽屉。\n");
                   break;
             case "dodge":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/d/shaolin/obj/book-bamboo");
                   ob2=new("/d/shenlong/obj/bufa");
                   ob3=new("/d/xiaoyao/obj/bojuan");
                   ob1->move(chouti);
                   ob2->move(chouti);
                   ob3->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",3);
                   return notify_fail("你打开轻功部抽屉。\n");
                   break;
             case "parry":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/d/shaolin/obj/book-iron");
                   ob1=new("/d/taohua/npc/obj/zy_book");
                   ob1->move(chouti);
                   ob2->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",2);
                   return notify_fail("你打开招架部抽屉。\n");
                   break;
             case "staff":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/d/shenlong/obj/zhangfa");
                   ob1->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",1);
                   return notify_fail("你打开杖法部抽屉。\n");
                   break;
             case "finger":
                   chouti=new("/u/solomon/obj/chouti");
                   ob1=new("/d/tianlongsi/obj/liumai-jianpu");
                   ob1->move(chouti);
                   chouti->move(this_object());
                   me->set_temp("mark/dakai",1);
                   return notify_fail("你打开指法部抽屉。\n");
                   break;
             default:
                   return notify_fail("好象没有这个抽屉？\n");
      }
}

int d_guanbi()
{
      object me;
      me = this_player();
      if (!me->query_temp("mark/dakai"))
            return notify_fail("你没打开抽屉。\n");
      switch (me->query_temp("mark/dakai"))
      {
            case 10:
                  destruct(ob10);
            case 9:
                  destruct(ob9);
            case 8:
                  destruct(ob8);
            case 7:
                  destruct(ob7);
            case 6:
                  destruct(ob6);
            case 5:
                  destruct(ob5);
            case 4:
                  destruct(ob4);
            case 3:
                  destruct(ob3);
            case 2:
                  destruct(ob2);
            case 1:
                  destruct(ob1);
                  destruct(chouti);
            default:
                  me->delete_temp("mark/dakai");
      }
      reclaim_objects();
      return notify_fail("你将抽屉关闭。\n");
}

int valid_leave(object me, string dir)
{
      if (me->query_temp("mark/dakai"))
            return notify_fail("好象没有关闭抽屉？\n");
      return 1;
}
