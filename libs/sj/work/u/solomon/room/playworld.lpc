inherit ROOM;
#include <room.h>

void create() {
  set("short", "花花世界");
  set("long", @LONG
这里是世上最诱人的地方，来到此处可就万劫不复啦。在你进
一步陷入之前先提醒你一下，千万记得一句俗话，酒是穿肠毒药，
色是刮骨钢刀。好啦，你如果还想沉迷我也没有办法。楼上是家妓
院，楼下是家赌场，南面有家酒店，北边开了两个武场，西边可是
家钱庄哟。
LONG);
  set("no_fight", "1");
  set("no_steal", "1");
  set("exits", ([
    "east": "/u/solomon/workroom",
    "south": "/d/city/zuixianlou",
    "west": "/d/city/qianzhuang",
    "north": "/d/city/wudao",
    "up": "/d/city/lichunyuan",
    "down": "/d/city/duchang",
  ]));
  setup();
  create_door("east", "黄金小门", "west", DOOR_CLOSED);
}
