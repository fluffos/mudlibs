// Room: bamboo1.c
// Date: Mar 2 1998

inherit ROOM;

void create()
{
      set("short", "竹径");
      set("long", @LONG
这里是一段落满青苔的青石板小路，右边是流水回萦，小桥略
陈，左边是竹树掩映，山花浪漫，真个是幽深静谧，秀丽清朗。向
南是本山绝险之处，东边有一座松木搭成的木屋，还挺大的样子，
北边是个小竹屋，西边茂密的竹林中盘旋着一条小径。
LONG );
      set("outdoors", "solomon");
      set("no_fight", "1");
      set("no_steal", "1");
      set("exits", ([
            "west"   : __DIR__"bamboo",
            "southup": __DIR__"geste",
            "east"   : __DIR__"pracroom",
            "north"  : __DIR__"drugroom",
      ]));
      setup();
}

int valid_leave(object me, string dir)
{
      int i,c_exp,c_skill;
      if (!wizardp(me))
      {
           if (dir == "east")
           {
                 if (me->query("chanxin/save")==5)
                 {
                       i=random(100);
                       if (i==0)
                             return ::valid_leave(me, dir);
                       else
                             return notify_fail("天神喝道：“心术不正者免进。”\n");
                 }
                 else
                 {
                       me->delete("chanxin");
                       return notify_fail("天神喝道：“心术不正者免进。”\n");
                 }
           }
           if (dir == "north")
           {
                 if (me->query("qi")==me->query("max_qi")&&
                     me->query("jing")==me->query("max_jing"))
                 {
                       me->delete("chanxin");
                       return notify_fail("天神喝道：“心术不正者免进。”\n");
                 }
                 if (me->query("chanxin/save")==5)
                 {
                       i=random(100);
                       if (i==0)
                             return ::valid_leave(me, dir);
                       else
                             return notify_fail("天神喝道：“心术不正者免进。”\n");
                 }
                 else
                 {
                       me->delete("chanxin");
                       return notify_fail("天神喝道：“心术不正者免进。”\n");
                 }
           }
      }
      if (dir == "south")
      {
             c_exp=me->query("combat_exp");
             c_skill=me->query_skill("dodge",1);
             if (((c_skill*c_skill*c_skill/10)< c_exp) && (c_skill<301))
                   me->improve_skill("dodge", (int)me->query_skill("dodge", 1)*10);
             tell_object(me,"你气喘呼呼地向上爬，终于爬到了本山的绝顶“空谷回音”。\n");
      }
      return ::valid_leave(me, dir);
}
