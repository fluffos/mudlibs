inherit ROOM;
#include <room.h>

void create() {
  set("short", "竹径");
  set("long", @LONG
这里是一段落满青苔的青石板小路，右边是流水回萦，小桥略
陈，左边是竹树掩映，山花浪漫，真个是幽深静谧，秀丽清朗。东
边茂密的竹林中盘旋着一条小径，北边有个小竹屋，在林中若隐若
现。
LONG);
  set("outdoors", "solomon");
  set("no_fight", "1");
  set("no_steal", "1");
  set("exits", ([
    "west": "/u/solomon/workroom",
    "east": __DIR__ "bamboo1",
    "north": __DIR__ "jingxiushi",
  ]));
  setup();
  create_door("west", "青竹小门", "east", DOOR_CLOSED);
}

int valid_leave(object me, string dir) {
  int i, c_exp, c_skill;
  if (!wizardp(me)) {
    if (dir == "north" && me->query("id") != "jadi") {
      if (me->query("qi") == me->query("max_qi") &&
        me->query("jing") == me->query("max_jing")) {
        me->delete("chanxin");
        return notify_fail("天神喝道：“心术不正者免进。”\n");
      }
      if (me->query("chanxin/save") == 5) {
        i = random(100);
        if (i == 0)
          return ::valid_leave(me, dir);
        else
          return notify_fail("天神喝道：“心术不正者免进。”\n");
      } else {
        me->delete("chanxin");
        return notify_fail("天神喝道：“心术不正者免进。”\n");
      }
    }
  }
  return ::valid_leave(me, dir);
}
