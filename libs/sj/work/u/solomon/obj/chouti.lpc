// chouti.c 抽屉

inherit ITEM;

void create()
{
	set_name("抽屉", ({ "chouti" }));
	set_weight(500);
	set_max_encumbrance(10000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("long", "一个用橡木做成的抽屉，好像可以装东西。\n");
		set("value", 100);
	}
}

int is_container() { return 1; }
