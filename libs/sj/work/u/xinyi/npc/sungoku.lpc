// sangoku.c
// 星意，1999，4，25

#include <ansi.h>
#ifndef NPCDATA
#define NPCDATA "/data/npc/"
#endif
#define SUNGOKU NPCDATA + "sungoku"

inherit NPC;
inherit F_UNIQUE;
inherit F_SAVE;

string query_save_file() {
  return SUNGOKU;
}

void create() {
  seteuid(getuid());

  if (!restore()) {
    set_name("孙悟空", ({ "sungoku", "sun", "goku" }));
    set("short", "来自「七龙珠」的" HIC "孙悟空" NOR "(Sun goku)");
    set("long",
      "孙悟空是来自鸟山明的漫画「七龙珠」，你别小看他现在一付傻头傻脑的样子\n"
      "，他所获得的战斗经验都会储存下来。\n");
    set("gender", "男性");
    //set("race", "赛亚人");
    set("chat_chance", 15);
    set("chat_msg", ({
      (: this_object(), "random_move" :),
      CYN "孙悟空说道：哈罗！来比武吧？\n" NOR,
      CYN "孙悟空翻了个跟斗，用一只手指撑在地下，说道：这招你会不会啊？\n" NOR,
    }));
    set("chat_msg_coombat", ({
      CYN "\n孙悟空扮个鬼脸，说道：来呀！再来呀！\n" NOR,
      CYN "\n孙悟空说道：这一招是爷爷教我的，厉害吧！\n" NOR,
    }));

    // We have 7 pills per reset.
    set("pills", 70);

    // This is the initial apply for his race.		
    set("perm_apply", ([
      "attack": 10,
      "dodge": 10,
      "damage": 5,
    ]));

    set("str", 25);
    set("con", 25);
    set("int", 25);
    set("dex", 25);
    set("per", 25);

    set("max_qi", 100);
    set("eff_qi", 100);
    set("qi", 100);
    set("max_jing", 100);
    set("jing", 100);
    set("neili", 0);
    set("max_neili", 0);
    set("jiali", 0);
    set("shen_type", 0);

    set("no_clean_up", 1);
    set("combat_exp", 1050);

    set_skill("force", 9);
    set_skill("unarmed", 9);
    set_skill("sword", 9);
    set_skill("dodge", 9);
    set_skill("parry", 9);

    set_temp("apply", query("perm_apply"));
    setup();

    carry_object(__DIR__ "obj/kame_suit")->wear();

  }

  else {
    set("id", "sun");
    set_name(query("name"), ({ query("id") }));
    setup();
    if (this_object()->query("armor")) carry_object(this_object()->query("armor"))->wear();
  }
}

void init() {
  object ob = this_object();
  add_action("do_save", "saveme");

}

int do_save() {
  return save();
}

void reset() {
  int learn;

  set("pills", 20);

  if ((int)query("potential") > (int)query("learned_points")) {
    learn = (int)query("potential") - (int)query("learned_points");
    add_temp("apply/attack", learn / 3);
    add_temp("apply/dodge", learn / 3);
    add_temp("apply/parry", learn / 3);
    add("learned_points", (learn / 3) * 60);
  }

  save();
}

int accept_fight(object who) {
  if (is_fighting()) {
    if (random(query("eff_qi")) > (int)query("qi")) {
      say(CYN "孙悟空大叫：这么多人我打一个？不行不行，等我打败这些人再跟你打！\n" NOR);
      return 0;
    } else {
      say(CYN "孙悟空大叫：这么多人我打一个？没关系，我一定让你们好看！\n" NOR);
      return 1;
    }
  }
  say(CYN "孙悟空很高兴地说道：好啊，好啊，我要出招了...\n" NOR);
  return 1;
}

int receive_damage(string type, int pts) {
  int damage;

  damage = ::receive_damage(type, pts);
  if ((type == "qi") && (damage > (int)query("max_qi") / 5)) {
    say(CYN "孙悟空捂著受伤的地方，说道：好痛啊...真有你的....\n" NOR);
    if (random(query("qi")) < damage)
      random_move();
  }

  if ((int)query("pills")
    && (((int)query("qi")) < 60
      || ((int)query("jing") < 20))) {
    say(HIY "孙悟空从口袋摸出一粒花梨塔猫仙人给他的仙豆吞了下去。\n" NOR);
    set("qi", query("eff_qi"));
    set("jing", query("eff_jing"));
    set("sen", query("eff_sen"));
    add("pills", -1);
  }
  return damage;
}

varargs void improve_skill(string skill, int amount, int raw) {
  // Thus we can gain skill levels from direct fighting.
  ::improve_skill(skill, amount);
}

void revive() {
  // This is a feature of sungoku's race. See the comic :P.
  add("combat_exp", (int)query("combat_exp") / 3 + 50);
  reset();
  ::revive();
}

void kill_ob(object ob) {
  fight_ob(ob);
}

void defeated_enemy(object ob) {
  say(CYN "孙悟空作出一个 V 字型的手势，说道：我赢了！" NOR);
  remove_killer(ob);
}
