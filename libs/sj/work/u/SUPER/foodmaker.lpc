// roommaker.c
// for ESLib
#include <ansi.h>
inherit F_SAVE;


inherit ITEM;

void create() {
  set_name(HIC "食品制造器" NOR, ({ "food maker", "maker", "food" }));
  set_weight(1000000);
  set("unit", "个");
  set("long", @LONG
这是一个新开发出来的产品，它可以来制造自己的食物名称。COOL！！！
你可以投币(toubi)进去，然后跟它取个名字，你就有属于自己的食物了。
食物能吃多久是根据你投入的电子货币计算的，哈哈！
LONG
  );
}


void init() {


  add_action("do_toubi", "toubi");


}

int do_toubi(string arg) {
  int const;

  if (!arg || !sscanf(arg, "%d", const))
    return notify_fail("你要投币多少？\n");
  if (const > 200) return notify_fail("你不能投多于200的电子货币进去！\n");
  message_vision("$N投了一些电子货币到食品制造器，里面！\n", this_player());
  message_vision("谢谢，你要什么食物，我这里要什么有什么！\n", this_player());
  add_action("do_want", "我要");
  this_player()->set_temp("投币", 1);
  return const;
}
int do_want(string arg) {
  string file, dir, code;
  int money;
  object ob;
  object me = this_player();

  if (!(me->query_temp("投币"))) return notify_fail("你还没投币呢！\n");
  if (!arg || arg == "") return notify_fail("你要什么咯？\n");

  file = resolve_path(this_player()->query("cwd"), "/u/super/userfood/shiwu.lpc");
  if (file_size(file) != -1)
    write_file(file, @ROOM_CODE
//made in 投币机;
inherit ITEM;
inherit F_FOOD;

void create()
{
       set_name(arg,({"shiwu"});
       set("long",这一看就知道是冒牌货，不知道是从哪儿弄来的，悠着点吃。\n");
       set_weight(80);
       if (clonep())            set_default_object(__FILE__);   else {  
       set("unit", "个");
       set("value", 0);
       set("food_remaining", (int)const/2);
       set("food_supply", 30);}

        setup();

}
ROOM_CODE);
  message_vision("只看见$N将电子货币投入食品制造器里，然后从里面弹出一个" + arg + "来~~！\n", this_player());
  ob = new("/u/super/userfood/shiwu.lpc");
  ob->setup();
  ob->move(this_player());
  return 1;
}
