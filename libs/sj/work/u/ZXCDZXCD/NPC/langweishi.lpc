#include <ansi.h>
inherit NPC;

void create() {
  set_name("狼卫士", ({ "wei shi", "wei" }));
  set("long",
    "他是兽族的新一代,他们在兽族的地位是不可忽视的。\n"
    "他看起来精力充沛。\n");
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");
  set("shen_type", 0);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);

  set("max_qi", 500);
  set("max_jing", 200);
  set("neili", 300);
  set("max_neili", 300);
  set("jiali", 30);
  set("combat_exp", 15000);
  set("score", 300);

  set_skill("force", 50);
  set_skill("dodge", 50);
  set_skill("unarmed", 50);
  set_skill("parry", 50);
  set_skill("sword", 50);


  set("chat_chance_combat", 90);

  setup();

}
