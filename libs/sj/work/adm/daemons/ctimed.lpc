/* 格式:
 * Format 1 ,一九九九年十二月十七日二十三点十七分 星期五
 * Format 2 ,一九九九年十二月十七日 晚上 十一点十七分 星期五
 * Format 3 ,十二月十七日二十三点十七分 星期五
 * Format 4 ,十二月十七日二十三点十七分
 * Format 5 ,1999年12月17日 晚上 11点17分 星期五
 * Format 6 ,12月17日23点42分
 */

#include <localtime.h>
#include <ansi.h>
inherit F_CLEAN_UP;

void creat() { seteuid(getuid()); }

string chinese_time(int format) {
  string e_time, week, month, year, time, msg_time;
  string c_week, c_year, c_month, c_time, p_time, t_msg;
  int day, hour, minute, second, c_hour;
  string *month_name = ({ "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul",
    "Aug", "Sep", "Oct", "Nov", "Dec" });
  string *week_name = ({ "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" });

  time = (string)localtime(time());
  if (stringp(time))
    e_time = time;
  else e_time = ctime(time());

  sscanf(e_time, "%s %s %d %d:%d:%d %s", week, month, day, hour, minute, second, year);

  c_week = chinese_number(member_array(week, week_name) + 1);
  c_month = chinese_number(member_array(month, month_name) + 1);
  c_hour = hour;
  c_year = sprintf("%s%s%s%s",
    chinese_number(year[0] - 48),
    chinese_number(year[1] - 48),
    chinese_number(year[2] - 48),
    chinese_number(year[3] - 48));

  if (hour < 3 && hour > 0) { msg_time = HIW " 深夜 " NOR; t_msg = MAG "肚子饿不饿？要不要来点宵夜呢？" NOR; } else if (hour < 6 && hour >= 3) {
    msg_time = HIG " 凌晨 " NOR; t_msg = YEL "还没休息吗？小心明天起不来哦!" NOR;
  } else if (hour < 8 && hour >= 6) {
    msg_time = HIM " 早上 " NOR; t_msg = RED "一日之计在于晨，好好体验玩MUD的乐趣吧!" NOR;
  } else if (hour < 12 && hour >= 8) {
    msg_time = HIY " 上午 " NOR; t_msg = HIC "外面是否阳光明媚呢？祝你一天好心情!" NOR;
  } else if (hour == 12) { msg_time = HIR " 中午 " NOR; t_msg = BLU "吃过午饭了吗?人是铁饭是钢，一顿不吃饿得慌！" NOR; } else if (hour < 19 && hour > 12) {
    msg_time = HIC " 下午 " NOR; t_msg = HIG "要不要来杯下午茶？休息是为了走更长的路" NOR;
  } else if (hour < 24 && hour >= 19) {
    msg_time = HIB " 晚上 " NOR; t_msg = CYN "欢迎您的光临，祝你在战国玩的愉快!" NOR;
  } else if (hour == 24 || hour == 0) {
    msg_time = HIR " 子夜 " NOR; t_msg = WHT "请早点休息，注意保重您的身体!" NOR;
  }

  if (hour > 12) c_hour = hour - 12;

  c_year = c_year + "年";
  c_month = c_month + "月";
  if (c_week == "六") c_week = HIR + " 星期六" + NOR;
  else if (c_week == "七") c_week = HIR + " 星期天" + NOR;
  else c_week = HIC + " 星期" + c_week + NOR;

  c_time = chinese_number(day) + "日";
  c_time += chinese_number(hour) + "点";
  c_time += chinese_number(minute) + "分";
  c_time += chinese_number(second) + "秒";

  p_time = WHT + chinese_number(day) + "日";
  p_time += msg_time;
  p_time += WHT + chinese_number(c_hour) + "点";
  p_time += chinese_number(minute) + "分";
  p_time += chinese_number(second) + "秒";

  if (format) {
    switch (format) {
      case 1: return c_year + c_month + c_time + c_week;
      case 2: return c_year + c_month + p_time + c_week;
      case 3: return c_month + c_time + c_week;
      case 4: return c_month + c_time;
      case 5: return WHT + year + "年" + (member_array(
        month,
        month_name
      ) + 1) + "月" + day + "日" + msg_time + WHT + c_hour + "点" + minute + "分" + c_week;
      case 6: return msg_time + WHT + c_hour + "点" + minute + "分 " + t_msg;
      default: return c_year + c_month + c_time + c_week;
    }
  }
  return c_year + c_month + c_time + c_week;
}

string chinese_period(int t) {
  int y, n, d, h, m, s;
  string time;

  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t % 30; t /= 30;
  n = t % 12; t /= 12;
  y = t;

  time = "";

  if (y) time = y + "年";
  if (n) time += n + "个月";
  if (d) time += d + "天";
  if (h) time += h + "小时";
  if (m) time += m + "分";
  time += s + "秒";

  return time;
}
