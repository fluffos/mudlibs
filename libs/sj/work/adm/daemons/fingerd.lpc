#include <net/dns.h>;
#include <ansi.h>;
#include <mudlib.h>

inherit F_DBASE;
void create() {
  seteuid(getuid());
  set("name", "精灵");
  set("id", "Finger");
  set("channel_id", "精灵");
}

string age_string(int time) {
  int month, day, hour, min, sec;

  sec = time % 60;
  time /= 60;
  min = time % 60;
  time /= 60;
  hour = time % 24;
  time /= 24;
  day = time % 30;
  month = time / 30;
  return (month ? month + "m" : "") + (day ? day + "d" : "") + (hour ? hour + "h" : "") + min + "m";
}

int online_time(object body) {
  return time() - (int)body->query("temp/time");
}

int online_time_total(object body) {
  return body->query("time_aged") + time() - (int)body->query("temp/time");
}

string finger_all() {
  object *ob;
  string msg, fip;
  int i, j;

  ob = users();
  msg = "";
  j = sizeof(ob);
  if (!wizardp(this_player()))  // player finger
  {
    for (i = 0; i < j; i++) {
      if (this_player() && !this_player()->visible(ob[i])) continue;
      msg = sprintf("%s%-14s%-14s%-14s\n",
        msg, ob[i]->query("name"), ob[i]->query("id"),
        query_idle(ob[i]) + "s");
    }
    return CHINESE_MUD_NAME + "\n"
      "——————————————————\n"
      + "姓名          帐号          发呆\n" +
      "——————————————————\n"
      +msg +
      "——————————————————\n";
  } else          // wizard finger
  {
    for (i = 0; i < sizeof(ob); i++) {
      if (this_player() && !this_player()->visible(ob[i])) continue;
      msg = sprintf("%s%-14s%-23s%-22s%-12s%s\n",
        msg, ob[i]->query("name"), ob[i]->query("id"),
        CHINESE_D->chinese_time((int)ob[i]->query("mud_age")),
        query_idle(ob[i]) + "秒", query_ip_number(ob[i]));
    }
    return CHINESE_MUD_NAME + "\n"
      + "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
      + "姓  名       帐  号               年  龄                 发  呆        连  线\n"
      + "──────────────────────────────────────────\n"
      +msg
      + "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
  }
}

string finger_user(string name) {
  object ob, body;
  string msg, o_time, q_time, mud;
  int public_flag;

  if (sscanf(name, "%s@%s", name, mud) == 2) {
    GFINGER_Q->send_finger_q(mud, name, this_player(1));
    return "网路指令传送过程可能需要一些时间，请稍候。\n";
  }
  ob = new(LOGIN_OB);
  ob->set("id", name);
  if (!ob->restore()) return "没有这个玩家...。\n";

  q_time = CTIME_D->chinese_period(time() - (int)ob->query("last_quit"));
  if (!wizardp(this_player())) {

    if (objectp(body = find_player(name)) && geteuid(body) == name) {
      public_flag = body->query("env/public") ? 1 : 0;
      o_time = CTIME_D->chinese_period(online_time(body));
    } else {
      body = LOGIN_D->make_body(ob);
      if (!body->restore()) return "没有这个玩家。\n";
      public_flag = body->query("env/public") ? 1 : 0;
      destruct(body);
    }

    msg = sprintf("   姓    名：\t%s\n   英文代号：\t%s\n   权限等级：\t%s\n"
      "   电子邮箱：\t%s\n",
      ob->query("name"),
      ob->query("id"),
      SECURITY_D->get_status(name),
      "不告诉你",
    );
    if (objectp(body = find_player(name)) && geteuid(body) == name) {
      if (!ob->query("evn/invisibility")) {
        msg += sprintf("   目前状态：\t" + HIG + "连线\n" + NOR);
        msg += sprintf("   连线时间：\t%s\n", MAG + o_time + NOR);
      }
    } else {
      msg += sprintf("   目前状态：\t" + HIR + "离线\n" + NOR);
      msg += sprintf("   离线时间：\t%s\n", CYN + q_time + NOR);
    }
  } else          // wizard finger
  {
    msg = sprintf("   姓    名：\t%s\n   英文代号：\t%s\n   权限等级：\t%s\n"
      "   电子邮箱：\t%s\n",
      ob->query("name"),
      ob->query("id"),
      SECURITY_D->get_status(name),
      ob->query("email"),
    );
    if (objectp(body = find_player(name)) && geteuid(body) == name) {
      o_time = CTIME_D->chinese_period(online_time(body));
      msg += sprintf("   目前状态：\t" + HIG + "连线\n" + NOR);
      msg += sprintf(
        "   连线地址：\t%s( %s )\n",
        YEL + query_ip_number(body) + NOR,
        query_ip_name(body)
      );
      msg += sprintf("   连线时间：\t%s\n", MAG + o_time + NOR);
    } else {
      msg += sprintf("   目前状态：\t" + HIR + "离线\n" + NOR);
      msg += sprintf("   离线时间：\t%s\n", CYN + q_time + NOR);
      msg += sprintf("   在线时间：\t%s\n", HIB + ob->query("online_time") + NOR);
    }
    msg += sprintf("   上次连线地址：%s\n", YEL + ob->query("last_from") + NOR);
    msg += sprintf("   上次连线时间：%s\n", ob->query("last_on"));
  }
  if (ob->query("id") != this_player()->query("id")) {
    if (objectp(body = find_player(name)) && geteuid(body) == name) {
      CHANNEL_D->do_channel(this_object(), "sys",
        sprintf("%s(%s)在 Finger %s(%s)。",
          this_player()->query("name"),
          capitalize(this_player()->query("id")),
          ob->query("name"),
          capitalize(ob->query("id"))));
    }
  }
  destruct(ob);
  return "\n" + CHINESE_MUD_NAME + " 玩家信息:\n"
    +HIG + "━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n" + NOR
    +msg
    +HIG + "━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n" + NOR;
}

object acquire_login_ob(string id) {
  object ob;

  if (ob = find_player(id)) {
    // Check if the player is linkdead
    if (ob->query_temp("link_ob"))
      return ob->query_temp("link_ob");
  }
  ob = new(LOGIN_OB);
  ob->set("id", id);
  return ob->restore() ? ob : 0;
}

string get_killer() {
  int i;
  string msg;
  object *ob = users();

  msg = "";
  for (i = 0; i < sizeof(ob); i++)
    if ((int)ob[i]->query_condition("killer"))
      msg += (ob[i]->short() + "\n");
  if (msg == "")
    return "本城治安良好。\n";
  else
    return "现在本城正在缉拿以下人犯：\n\n" + msg;
}
