// banker.c 银行家
inherit F_CLEAN_UP;

#include <dbase.h>
#include <ansi.h>

int do_zhuanzhang(string arg) {
  object ob, i, me;
  string str;
  int num;
  ob = this_player(1);
  me = this_player();
  if (!arg) return notify_fail(HIG "zhuanzhang <某人> <世纪货币>\n" NOR);
  if (sscanf(arg, "%s %d", str, num) == 2);
  else return notify_fail(HIC "你要转给谁？\n" NOR);
  ob = find_player(str);
  if (num < 0) return notify_fail(HIB "别想些歪门邪道来骗钱！\n" NOR);
  if (query_ip_name(i) == query_ip_name(ob)) return notify_fail("请多看一看游戏规则！下不为例！\n");
  if (num > i->query("money")) return notify_fail(HIW "你没有这么多电子货币了！\n" NOR);
  if (!ob) return notify_fail(NOR + CYN "现在没这个人.\n" NOR);
  if (wizardp(i) && !wizardp(ob))
    return notify_fail(BLINK + HIW "你是巫师啊，不能转帐给玩家啊，想作弊啊。\n" NOR);
  if (wizardp(ob) && !wizardp(i))
    return notify_fail(HIM "他是巫师啊，不用你的货币。\n" NOR);
  i->add("money", -num);
  ob->add("money", num);
  tell_object(i, sprintf(HIW "你转了%d世纪货币给%s！\n" NOR, num, ob->query("name")));
  tell_object(ob, sprintf(HIW "%s转了%d世纪货币给你！\n" NOR, me->query("name"), num));

  log_file("/nosave/zuanzhang.log", sprintf(HIW "%s%s" NOR "转帐给" CYN "%s%s" HIG "%d" NOR "世纪货币。%s\n",
    i->query("name"), "(" + i->query("id") + ")", ob->query("name"), "(" + ob->query("id") + ")", num, CTIME_D->chinese_time(5)));
  return 1;
}
