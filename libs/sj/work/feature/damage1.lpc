#include <ansi.h>
#include <dbase.h>
#include <login.h>
#include <move.h>

int ghost = 0;

int is_ghost() { return ghost; }

varargs int receive_damage(string type, int damage, object who)
{
        int val;

        if( damage < 0 ) error("F_DAMAGE: 伤害值为负值。\n");
        if( type!="jing" && type!="qi" )
                error("F_DAMAGE: 伤害种类错误( 只能是 jing, qi 其中之一 )。\n");

        if( objectp(who) ) set_temp("last_damage_from", who);
        val = (int)query(type) - damage;

        if( val >= 0 ) set(type, val);
        else set( type, -1 );

        set_heart_beat(1);

        return damage;
}

varargs int receive_wound(string type, int damage, object who)
{
        int val;

        if( damage < 0 ) error("F_DAMAGE: 伤害值为负值。\n");
        if( type!="jing" && type!="qi" )
                error("F_DAMAGE: 伤害种类错误( 只能是 jing, qi 其中之一 )。\n");

        if( objectp(who) ) set_temp("last_damage_from", who);
        val = (int)query("eff_" + type) - damage;

        if( val >= 0 ) set("eff_" + type, val);
        else {
                set( "eff_" + type, -1 );
                val = -1;
        }

        if( (int)query(type) > val ) set(type, val);

        set_heart_beat(1);

        return damage;
}

int receive_heal(string type, int heal)
{
        int val;

        if( heal < 0 ) error("F_DAMAGE: 恢复值为负值。\n");
        if( type!="jing" && type!="qi" )
                error("F_DAMAGE: 恢复种类错误( 只能是 jing, qi 其中之一 )。\n");

        val = (int)query(type) + heal;

        if( val > (int)query("eff_" + type) ) set(type, (int)query("eff_" + type));
        else set( type, val );

        return heal;
}

int receive_curing(string type, int heal)
{
        int max, val;

        if( heal < 0 ) error("F_DAMAGE: 恢复值为负值。\n");
        if( type!="jing" && type!="qi" )
                error("F_DAMAGE: 恢复种类错误( 只能是 jing, qi 其中之一 )。\n");

        val = (int)query("eff_" + type);
        max = (int)query("max_" + type);

        if( val + heal > max ) {
                set("eff_" + type, max);
                return max - val;
        } else {
                set( "eff_" + type, val + heal);
                return heal;
        }
}
void remove_ride ()
{
   object rider, ridee;
   
   if (ridee = query_temp("ridee"))
     ridee->delete_temp("rider");
          delete_temp("ridee");
         add_temp("apply/dodge",-query_temp("ride/dodge"));
 add_temp("apply/damage",-query_temp("ride/damage"));
 add_temp("apply/attack",-query_temp("ride/attack"));
 add_temp("apply/armor",-query_temp("ride/armor"));
add_temp("apply/parry",-query_temp("ride/parry"));
set_temp("ride/dodge",0);
set_temp("ride/damage",0);
set_temp("ride/attack",0);
set_temp("ride/armor",0);
set_temp("ride/parry",0);
        if (rider = query_temp("rider"))
           rider->remove_ride();
          delete_temp("rider");
}
void unconcious()
{
        object defeater,where,killer;
   killer= query_temp("last_damage_from"); 
        if( !living(this_object()) ) return;
        if( wizardp(this_object()) && query("env/immortal") ) return;
        where=environment(this_object());
        if (where->query("no_die"))
        {
         set("qi",this_object()->query("max_qi"));
         set("jing",this_object()->query("max_jing"));
         set("eff_jing",this_object()->query("max_jing"));
         set("eff_qi",this_object()->query("max_qi"));
         set("neili",this_object()->query("max_neili"));
         this_object()->remove_all_killer();
         killer->remove_all_killer();
         this_object()->remove_all_killer();
         CHANNEL_D->do_channel(this_object(), "rumor",sprintf("%s被踢出比武场了。", this_object()->query("name")));
         this_object()->move("/d/taikong/gangkou");
         return;
        }
        if( objectp(defeater = query_temp("last_damage_from")) )
                COMBAT_D->winner_reward(defeater, this_object());

        this_object()->remove_all_enemy();
        set("hunmi",1);
        message("system", HIR "\n你两眼一闭，接著屁都看不到了....\n\n" NOR,
                this_object());
        this_object()->disable_player("");
        set("jing", 0);
        set("qi", 0);
        set_temp("block_msg/all", 1);
        COMBAT_D->announce(this_object(), "unconcious");
        remove_ride();
        call_out("revive", random(100 - query("con")) + 30);
}

void revive(int quiet)
{
        remove_call_out("revive");
        while( environment()->is_character() )
                this_object()->move(environment(environment()));
                this_object()->enable_player();
        if( !quiet ) {
                COMBAT_D->announce(this_object(), "revive");
                set_temp("block_msg/all", 0);
                set("hunmi",0);
                
                message("system", HIY "\n慢慢地你又看到了蓝天、白云..\n\n" NOR,
                        this_object());
        } else
                {set_temp("block_msg/all", 0);set("hunmi",0);}
}

void die()
{
        object corpse, killer,where;
        int i;
        string diemsg;
           
        if( !living(this_object()) ) revive(1);
        if( wizardp(this_object()) && query("env/immortal") ) return;
        where=environment(this_object());
   killer= query_temp("last_damage_from"); 
        if (where->query("no_die"))
        {
         set("qi",this_object()->query("max_qi"));
         set("jing",this_object()->query("max_jing"));
         set("eff_jing",this_object()->query("max_jing"));
         set("eff_qi",this_object()->query("max_qi"));
         set("neili",this_object()->query("max_neili"));
         this_object()->remove_all_killer();
         killer->remove_all_killer();
         CHANNEL_D->do_channel(this_object(), "rumor",sprintf("%s被踢出比武场了。", this_object()->query("name")));
         this_object()->move("/d/taikong/gangkou");
         return;
        }
        // Clear all the conditions by death.
        this_object()->clear_condition();
        COMBAT_D->announce(this_object(), "dead");
        
        if ( diemsg=(string)this_object()->query_temp("diemsg") )
        COMBAT_D->killer_reward(diemsg, this_object());
        else 
        
        if( objectp(killer) ) {
                set_temp("my_killer", killer->query("id"));
                COMBAT_D->killer_reward(killer, this_object());
        }else
                { diemsg="一声不响的光荣牺牲了";
                COMBAT_D->killer_reward(diemsg, this_object());
             }
        remove_ride();
        
        this_object()->delete_temp("diemsg");
        if( objectp(corpse = CHAR_D->make_corpse(this_object(), killer)) )
                corpse->move(environment());

        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());

        this_object()->dismiss_team();
        if( userp(this_object()) ) {
                if (this_object()->is_busy())
                        this_object()->interrupt_me();
                set("jing", 1); set("eff_jing", 1);
                set("qi", 1);   set("eff_qi", 1);
                ghost = 1;
                this_object()->move(DEATH_ROOM);
                DEATH_ROOM->start_death(this_object());//这句似乎没什么用呀！
        } else
                destruct(this_object());
}

void reincarnate()
{
        ghost = 0;
        set("eff_jing", query("max_jing"));
        set("eff_qi", query("max_qi"));
}

int max_food_capacity() { return query_weight() / 200; }

int max_water_capacity() { return query_weight() / 200; }

int heal_up()
{
        int update_flag, i;
        mapping my;
        object ob=this_object();

//      if( this_object()->is_fighting() ) return -1;

        update_flag = 0;

        my = query_entire_dbase();

        if( my["water"] > 0 ) 
        {
         my["water"] -= 1;update_flag++; 
        }
        if( my["food"] > 0 ) 
        {
        my["food"] -= 1;
        if ( my["food"] == ob->max_food_capacity()*0.3 )
                tell_object(ob,HIY "\n你的肚子已经在提抗议啦。\n"NOR);
        if ( my["food"] == ob->max_food_capacity()*0.1 )
                {
                tell_object(ob,HIY "\n你饿得往地上一趴，动都动不得。\n"NOR);
                ob->delete_temp("foods");
                }
        update_flag++; 
        }
        else
        {       if (!ob->query_temp("foods"))
                {tell_object(ob,HIR "\n你饿得快撩拦啦。\n"NOR);
                ob->set_temp("foods",10);}
        
                if ((int)ob->query_temp("foods") > 1) ob->add_temp("foods",-1);
                else {tell_object(ob,HIR "\n你饿得快要光荣就义了。。。。\n"NOR);  
                        if (wizardp(ob))
                        {tell_object(ob,HIG "还好你是神经，只见你发出一个仙屁，真爽\n"NOR);
                        ob->set("food",ob->max_food_capacity());ob->set("water",ob->max_water_capacity());
                        }else
                        if ((int)ob->query("age")<15) 
                        {
                        tell_object(ob,HIY "你掏出一支冰淇淋狠狠的啃了两口，爽罪达。\n"NOR);
                        ob->set("food",ob->max_food_capacity());ob->set("water",ob->max_water_capacity());
                        }else
                        {if (userp(ob))
                        ob->unconcious();
                        ob->set_temp("foods",10);
                        }
                }
                update_flag++; 
        }

        if( my["water"] < 1 && userp(this_object()) ) return update_flag;
        
        my["jing"] += my["con"] / 3 + my["max_jingli"] / 10;
        if( my["jing"] >= my["eff_jing"] ) {
                my["jing"] = my["eff_jing"];
                if( my["eff_jing"] < my["max_jing"] ) { my["eff_jing"] ++; update_flag++; }
        } else update_flag++;

        my["qi"] += my["con"] / 3 + my["max_neili"] / 10;
        if( my["qi"] >= my["eff_qi"] ) {
                my["qi"] = my["eff_qi"];
                if( my["eff_qi"] < my["max_qi"] ) { my["eff_qi"] ++; update_flag++; }
        } else update_flag++;

        if( my["food"] < 1 && userp(this_object()) ) return update_flag;

        if( my["max_jingli"] && my["jingli"] < my["max_jingli"] ) {
                my["jingli"] += (int)this_object()->query_skill("magic", 1) / 2;
                if( my["jingli"] > my["max_jingli"] ) my["jingli"] = my["max_jingli"];
                update_flag++;
        }

        if( my["max_force"] && my["force"] < my["max_force"] ) {
                my["force"] += (int)this_object()->query_skill("force", 1) / 2;
                if( my["force"] > my["max_force"] my["force"] = my["max_force"];
                update_flag++;
        }

        return update_flag;
}

void sleep()
{
        object env;
        int fight_flag, magic_flag;

        if( !living(this_object()) ) return;

        if(!(env = environment(this_object())) )        return;

        fight_flag = env->query("no_fight");
        magic_flag = env->query("no_magic");
        if(!fight_flag) env->set("no_fight", 1);
        if(!magic_flag) env->set("no_magic", 1);
        
        this_object()->remove_all_enemy();
        this_object()->set_temp("sleeping", 1);
        this_object()->disable_player(" <沉睡中>");
//      set_temp("block_msg/all", 1);

        remove_call_out("wakeup");
        call_out("wakeup", 10+random(10), env, fight_flag, magic_flag);
}



void wakeup(object env, int fight_flag, int magic_flag)
{
        object me;

        remove_call_out("wakeup");

        me=this_object();

        me->enable_player();

        if(!env)        return;

        if(!fight_flag) env->set("no_fight", 0);
        if(!magic_flag) env->set("no_magic", 0);

        me->set("gin",me->query("eff_gin") );
        me->set("kee",me->query("eff_kee") );
        me->set("sen",me->query("eff_sen") );
        if(me->
query("max_atman") > me->query("atman") )
                me->add("atman", (me->query("max_atman")-me->query("atman"))/10);
        if(me->query("max_force") > me->query("force") )
        if(me->query("max_mana")>me->query("mana") )
                me->add("mana",(me->query("max_mana")-me->query("mana"))/10);

        me->delete_temp("sleeping");
//      set_temp("block_msg/all", 0);

        message_vision("$N一觉醒来，活动了几下筋骨，整个人看起来精神了很多。\n" ,me);
}
