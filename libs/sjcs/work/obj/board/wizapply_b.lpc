// wiz_apply

inherit BULLETIN_BOARD;
#include <ansi.h>

void create()
{
        set_name(HIR"申请簿"NOR, ({ "wiz_apply" }) );
        set("location", "/d/wiz/apply_room");
        set("board_id", "wiz_apply");
        set("long", "申请巫师留言本。\n" );
        setup();
        set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}

