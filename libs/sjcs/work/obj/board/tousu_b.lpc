// wizard_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("对wiz的投诉板", ({ "board" }) );
        set("location", "/d/wiz/tousu");
        set("board_id", "tousu_b");
	set("long",
                "这是一个的板子， post。\n" );
	setup();
	set("capacity", 150);
	replace_program(BULLETIN_BOARD);
}
