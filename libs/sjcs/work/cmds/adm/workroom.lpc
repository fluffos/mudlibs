inherit ROOM;
void create ()
{
        set ("short", "巫师工作室");
        set ("long", @LONG

这里是大天神公子为巫师工作学习修建的工作室，欢迎你加盟
【月亮西游】。你可以在这里自己添上些描述，如果你不熟悉
lpc、edit，你可以请在线巫师帮你修改，或者ls /doc/wiz/
看看我上传的有关巫师的教程。
LONG);
        set("exits", 
        ([ //sizeof() == 2
                  "west" : "/d/wiz/wizroom",
                "down" : "/d/city/kezhan",
                        ]));
        set("objects", 
        ([
                "/obj/wiz/rack" : 1,
        ]));
        set("outdoors", "changan");
        set("no_time",1);
        set("if_bed",1);
        set("sleep_room",1);
        set("no_upgrade_age",1);
        set("valid_startroom", 1);
        setup();
}


