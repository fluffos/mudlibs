// chnick.c 
// by xot

#include <ansi.h>
inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
        string tmp;
        object ob = me;

        if( !arg )
                return notify_fail("你要给谁取什么绰号？\n");
	
        if (sscanf(arg, "%s %s", tmp, arg) == 2)
                ob = present(tmp, environment(me));
        if (!ob) return notify_fail("这里没有这个人。\n");
	if (arg == "-del" ){
		ob->delete("nickname");
		tell_object(me,ob->query("name")+"的绰号被取消了。\n");
		tell_object(ob,"你的绰号被"HIR+me->query("name")+NOR"取消了。\n");		
		return 1;		
	}
//      if( strlen(arg) > 10020 )
//      return notify_fail("这个名字太长了，想一个短一点的、响亮一点的。\n");
        arg = replace_string(arg, "$BLK$", BLK);
        arg = replace_string(arg, "$RED$", RED);
        arg = replace_string(arg, "$GRN$", GRN);
              arg = replace_string(arg, "$YEL$", YEL);
        arg = replace_string(arg, "$BLU$", BLU);
        arg = replace_string(arg, "$MAG$", MAG);
        arg = replace_string(arg, "$CYN$", CYN);
        arg = replace_string(arg, "$WHT$", WHT);
        arg = replace_string(arg, "$HIR$", HIR);
        arg = replace_string(arg, "$HIG$", HIG);
        arg = replace_string(arg, "$HIY$", HIY);
        arg = replace_string(arg, "$HIB$", HIB);
        arg = replace_string(arg, "$HIM$", HIM);
        arg = replace_string(arg, "$HIC$", HIC);
        arg = replace_string(arg, "$HIW$", HIW);
        arg = replace_string(arg, "$NOR$", NOR);
        message_vision(HIY "$N将$n的绰号改为" + arg + "。\n" NOR, me, ob);
        ob->set("nickname", arg);
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式: chnick [玩家] 绰号
修改玩家或自己的绰号。

HELP );
        return 1;
}
