#include <ansi.h>
#define SYNTAX	"指令格式：offcutsys \n"
inherit F_CLEAN_UP;

private int do_purge_players();

int main(object me, string arg)
{
	string name, reason;
	string status;
	status = wizhood(me);
	if( me!=this_player(1)
	|| wiz_level(me) < wiz_level(status) )
		return notify_fail("你没有权力使用这个指令。\n");
	return do_purge_players();
}

private int do_purge_players()
{
	int i, j, ppl_cnt;
	string *dir, *ppls, name;
	mixed info;
	object who;
	seteuid(getuid());
	write("处理中：\n");
	ppl_cnt = 0;
	dir = get_dir(DATA_DIR + "login/");
	for(i=0; i<sizeof(dir); i++)
	{
		reset_eval_cost();
//		write("目录"+dir[i]+": 玩家");
		ppls = get_dir(DATA_DIR + "login/" + dir[i] + "/");
		ppl_cnt += sizeof(ppls);
		for(j=0; j<sizeof(ppls); j++)
		{
			if( sscanf(ppls[j], "%s.o", name)==1 )
				if( (string)SECURITY_D->get_status(name)!="(player)" )
					continue;
			who = new(LOGIN_OB);
			who->set("id", name);
			if (! who->restore())
 				continue;
			who->delete("stock");
			who->save();
			destruct(who);
		}
	}
	return 1;
}

int help(object me)
{
write(@HELP
指令格式：offcutsys

查询处理离线的所有玩家。
HELP
	);
    return 1;
}

