inherit F_CLEAN_UP;
#include <ansi.h>

int main(object me, string arg)
{
object obj;
if (me->is_busy())
 {
 write("你还是慢点挖吧。\n");
  return 1;
}
if (environment(me)->query_temp("have_bao")==1)
{
write("你挖到一个宝藏。\n");
switch (random(5))
{
case 5:
obj=new("/baowu/bao0");
obj->move(me);
break;
case 4:
obj=new("/baowu/bao4");
obj->move(me);
break;
case 3:
obj=new("/baowu/bao3");
obj->move(me);
break;
case 2:
obj=new("/baowu/bao2");
obj->move(me);
break;
case 1:
obj=new("/baowu/bao1");
obj->move(me);
break;
default:
obj=new("/baowu/bao5");
obj->move(me);
}
message("channel:rumor",HIC"〖江湖传闻〗"+me->query("name")+"在"+environment(me)->query("name")+"挖到了"+obj->query("name")+"。\n"NOR,users());
environment(me)->delete_temp("have_bao");
return 1;
} 
write("这里什么都没有。\n");
me->start_busy(random(5));
return 1;
}


