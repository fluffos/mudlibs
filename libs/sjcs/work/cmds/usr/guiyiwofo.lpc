inherit F_CLEAN_UP;
#include <ansi.h>

int main(object me, string arg)
{
if (me->query_condition("no_kill"))
 {
 write("佛祖不在，你还是等一会儿吧。\n");
  return 1;
}
if (me->query("no_kill")==1)
{
write("你已经归依我佛了。\n");
return 1;
}
        write("你决定归依佛门，暂不杀生。\n");
me->set("no_kill",1);
 message("channel:rumor",HIM"〖无中生有〗"+me->query("name")+"：我决定归依佛门，暂不杀生。\n"NOR,users());
   me->apply_condition("no_kill",50);
        return 1;
}

