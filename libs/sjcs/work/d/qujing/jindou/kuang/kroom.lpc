// /d/qujing/jindou/kuang/kroom.c
#include <ansi.h>
inherit ROOM;
int block_cmd(string);
void create()
{
 set("short","矿 脉");
 set ("long", HIY BLINK"
              没事挖矿 前途无量
\n"NOR);
 set("outdoors", "changan");
 set("exits", ([ /* sizeof() == 1 */
 "down": "/d/qujing/jindou/kuang/changeroom",
]));
 set("objects", ([
 "/d/qujing/jindou/kuang/kuang.lpc" : 2,
 ]));
 setup();
}
void init()
{
add_action("do_dig", "dig");
add_action("do_dig", "digg");
add_action("block_cmd", "", 1);
}
int block_cmd(string args)
{
string verb;
verb = query_verb();

 if (verb == "bian") return 1;
 if (verb == "cast") return 1;
 if (verb == "steal") return 1;
 if (verb == "perform") return 1;
 if (verb == "ji") return 1;
 if (verb == "kill") return 1;
    if (verb == "xiudao") return 1;
    if (verb == "exert") return 1;
    return 0;
}
int do_dig(string arg)
{
 object me = this_player();
object obj,ob;
 if( (!arg) || !((arg == "kuang") || (arg == "矿"))) return notify_fail("你想挖什么呢\n");
 if (me->is_busy()) return notify_fail("你上一个动作还没有完成!\n");
//  if(me->query("age")<18) return notify_fail("你还不适合这项工作\n");
 if(me->query("combat_exp")>10000000) return notify_fail("你已经不需要用挖矿来锻炼了\n");
 if( !(obj = me->query_temp("weapon"))|| (string)obj->query("skill_type") != "axe")
 return notify_fail("先去找把锄头吧！\n");
 me->start_busy(4+ random(2));
 tell_object(me,"你开始挖矿....!\n");
 call_out("getkuang", 4, me);
 return 1;
}
int getkuang()
{
object ob;
 switch(random(3)) {  
 case 0 :
 ob = new("/d/qujing/jindou/kuang/kuang.lpc");
 ob->move(this_player());
 this_player()->receive_damage("kee", 150+random(10));
 this_player()->receive_damage("sen", 150+random(10));
 tell_object(this_player(),"你挖到"+ob->query("name")+"加油!\n");
 break;
 case 1:
 ob = new("/d/qujing/jindou/kuang/laji.lpc");
 ob->set_amount(random(2));
 ob->move(this_player());
 this_player()->receive_damage("kee", 100+random(10));
 this_player()->receive_damage("sen", 100+random(10));
 tell_object(this_player(),HIW"划不来,挖了半天,全是垃圾\n"NOR);
break;
 case 2:
 tell_object(this_player(),HIR"你累了半天,结果什么都没有挖到\n"NOR);
 this_player()->receive_damage("kee", 100+random(10));
 this_player()->receive_damage("sen", 100+random(10));
 break;
}
}
//by pku

