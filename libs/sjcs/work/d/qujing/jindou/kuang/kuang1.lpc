// /d/qujing/jindou/kuang/kuang.c
#include <ansi.h>
inherit ITEM;
string *name = ({
CYN"铅矿"NOR,
CYN"锡矿"NOR,
WHT"铝矿"NOR,
CYN"铁矿"NOR,
YEL"铜矿"NOR,
HIW"银矿"NOR,
HIY"金矿"NOR,
HIY"铂金矿"NOR,
HIG"水晶矿"NOR,
HIC"天晶矿"NOR,
HIB"蓝晶矿"NOR,});
void create()
{
 set_name(name[random(sizeof(name))],({"kuang"}));
 set_weight(100+ random(100));
 if( clonep() )
  set_default_object(__FILE__);
 else {
 set("no_give", "拿到矿产部门吧!\n");
 set("no_sell", "拿到矿产部门吧!\n");
 set("no_get", "拿到矿产部门吧!\n");
 set("no_drop", "拿到矿产部门吧!\n");
 set("no_put", "拿到矿产部门吧!\n");
 set("no_steal", "拿到矿产部门吧!\n");
 set("unit", "些");
 set("base_unit", "块");
 set("value", 0);
 set("material", "stone");
 }
setup();
}
void init()
{
add_action("do_change", "jiaohuan");
add_action("do_change", "change");
}
int do_change(string arg)
{
 object me = this_player();
 object ob = this_object();
 object obj;
 int values;
 obj = new("/clone/money/silver.lpc");
 if(!arg = "kuang") return notify_fail("交换什么呢?\n");
 if(!arg) return notify_fail("交换什么呢?\n");
 if( environment(me)->query("short")!="矿产部门" ) return notify_fail("你还是到矿产部门去交换吧\n");
 if(me->query("combat_exp")>2000000) return notify_fail("你已经不需要这些东西来锻炼了\n");
if (me->query("betrayer") || me->query("betray/count")) return notify_fail("你曾叛师欺祖，言无信行不轨，岂能再来挖矿！！\n");
  if(me->query("daoxing")>2000000) return notify_fail("你已经不需要这些东西来锻炼了\n");
  if(me->query("kuang/number")>20000) return notify_fail("你已经挖得差不多数量的矿了，可以不再挖啦\n");
 if(me->query("age")<18) return notify_fail("小小年龄,就做小偷,哼,矿是那里来的??\n");
 if(me->query("age")>20) return notify_fail("年纪这么大了,还来做这种事，真是大才小用啊??\n");
 if(ob->query("name")==CYN"铅矿"NOR) values=10;
 if(ob->query("name")==CYN"锡矿"NOR) values=20;
 if(ob->query("name")==WHT"铝矿"NOR) values=40;
 if(ob->query("name")==CYN"铁矿"NOR) values=60;
 if(ob->query("name")==YEL"铜矿"NOR) values=80;
 if(ob->query("name")==HIW"银矿"NOR) values=100;
 if(ob->query("name")==HIY"金矿"NOR) values=120;
 if(ob->query("name")==HIY"铂金矿"NOR) values=140;
 if(ob->query("name")==HIG"水晶矿"NOR) values=160;
 if(ob->query("name")==HIC"天晶矿"NOR) values=180;
 if(ob->query("name")==HIB"蓝晶矿"NOR) values=200;
 obj->set_amount(values);
 obj->move(me);
 me->add("combat_exp", values*1)
;
 me->add("daoxing", values*1)
;
 me->add("potential", values/100);
 me->add("kuang/number", 1);
 tell_object(me, HIW "你得到了矿产部门的酬劳:"HIR BLINK+values+"两白银"+values*5+"点经验"+values/2+"点潜能和"+values*5+"点道行\n"NOR);
 destruct(ob);
 return 1;
}
//by pku

