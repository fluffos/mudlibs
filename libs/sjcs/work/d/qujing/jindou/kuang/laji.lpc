#include <ansi.h>
inherit ITEM;
string *dropobj = ({
"恐龙化石","kl huashi",
"鳄鱼化石","ey huashi",
"烂皮靴", "lan pixue",
"破渔网", "po fishnet",
"破草帽", "po hat",
"大石头", "big stone",
"树叶", "shu ye",
"坏了的斧头", "po axe",
"破碗","po wan",
"丢弃的电器", "dian qi",
"始祖鸟化石","bird stone",
});
void create()
{
 int n;
 n=random(11);
 set_name(dropobj[2*n],({dropobj[2*n+1]}));
 set_weight(100);
 if( clonep() )
   set_default_object(__FILE__);
 else {
    set("unit", "堆");
    set("material", "stone");
    set("value", 10);
    set("long", HIR BLINK"
    垃圾请丢在+,down 不要污染环境"NOR+HIW"
  
                         环保局宣\n"
    NOR);
    set("no_sell", 1);
    set("no_drop", "不要污染环境\n");
    set("no_give", "你都不想要，给别人干什么?\n");
    set("no_put", "这些东西还不快丢了，装起来干什么?\n");
    set("no_steal", "偷它干什么?\n");
    }
 setup();
}
//by pku

