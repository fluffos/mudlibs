inherit ROOM;

#include <ansi.h>

void check_time(object where);
void feel_hungry(object where);
void feel_full(object where);
int do_xianmei();

void create()
{
set("short","大殿");
set("long",@LONG

    虽然这是在地下，可是你不能想象在这里充满着宫殿的
气息，而妲己正端坐在太师椅上，当你进来的时候，她用余
光瞟了你一眼，你不禁低下头，不敢再多看她一眼，她自商
代灭亡后就逃到了这个洞里，居住至今。旁边的地上有个不
容易注意的小洞，里面黑黝黝的，不知道是通往哪里，你可
以试着钻(zuan)一下。

LONG);
set("exits", ([
         "north" : __DIR__"nei2",
     //  "west" : __DIR__"road4",
     //  "north": __DIR__"chufang",
       "south":__DIR__"mishi",
]));
set("objects", ([
  __DIR__"npc/daji" : 1,
]) );

  set("valid_startroom", 1);
setup();
"/obj/board/xy_b"->foo();

}

void init ()
{
  add_action ("do_zuan","zuan");
}

int do_zuan (string arg)
{
  object who = this_player();
        
  message_vision ("$N屁股一撅，朝着洞里钻了进去……\n",who);
  who->move("/d/city/center");
  return 1;
}

