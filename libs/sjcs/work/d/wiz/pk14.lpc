// tousu.c

#include <login.h>
#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "强者路");
        set("long", @LONG

战斗天地，生死由天。

LONG);

        set("exits", ([
                // "east" : "/d/wiz/pk",
                // "west" : "/d/wiz/pk",
                 "north" : "/d/wiz/pk13",
                 "south" : "/d/wiz/pk",
                
         ]) );

        set("no_time",1);
        set("no_fight", 1);
        set("no_fly", 1);
        set("no_magic", 1);

        setup();
       // call_other( "obj/board/pk_b.lpc", "???" );
}

void init()
{   
        if (!wizardp(this_player())) {
          this_player()->set("startroom","/d/wiz/pk");
          this_player()->save();
          add_action("block_cmd","",1);         
        }
        call_out("hehe", 2, this_player());
}
int block_cmd()
{
        string verb = query_verb();

        if (verb=="say") return 0; //allow say
        if (verb=="help") return 0;
        if (verb=="top") return 0;
        if (verb=="who") return 0;
        if (verb=="inventory") return 0;
        if (verb=="go") return 0;
        if (verb=="hp") return 0;
        if (verb=="score") return 0;
        if (verb=="post") return 0;
        if (verb=="chat") return 0;
        if (verb=="look") return 0;
        if (verb=="kill") return 0;
        if (verb=="fight") return 0;
        if (verb=="ji") return 0;
        if (verb=="exert") return 0;
        if (verb=="cast") return 0;
        if (verb=="get") return 0; 
        if (verb=="perform") return 0;
        return 1;
}
