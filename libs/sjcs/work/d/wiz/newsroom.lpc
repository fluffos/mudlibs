#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
	set("short", HIY "三界传说新闻发布中心" NOR);
	set("long", @LONG
这里是三界传说的新闻发布中心，有什么新闻都可以在这里发布(post)，
然后系统自动随机通知所有在线玩家。
LONG );
	set("exits", ([
           "north" : __DIR__"wizroom",
	]));
	set("objects",([ 
         "/cmds/usr/news" : 1,
	]));
	set("no_clean_up", 1);
	setup();
}
