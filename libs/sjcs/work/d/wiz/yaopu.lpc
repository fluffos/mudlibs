// tousu.c

#include <login.h>
#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "杀手药店");
        set("long", @LONG

这是杀手乐园一家老字号的药铺，相传原来的老板是皇宫中的御医，手
段可知一二。药铺中的摆设也十分考究，桌椅被勤快的伙计擦的干干
净净。墙上挂满了别人送来的谢匾。
LONG);

        set("exits", ([
                 //"east" : "/d/wiz/pk",
                 //"west" : "/d/wiz/pk3",
                 "north" : "/d/wiz/pk3",
                // "south" : "/d/wiz/pk4",
                
         ]) );

             set("objects", 
        ([ //sizeof() == 4
                "/d/wiz/yang" : 1,
                "/d/city/npc/bing" : 3,
        ]));



        set("no_time",1);
        set("no_fight", 1);
        set("no_fly", 1);
        set("no_magic", 1);

        setup();
     //   call_other( "obj/board/pk_b.lpc", "???" );
}

void init()
{   
        if (!wizardp(this_player())) {
          this_player()->set("startroom","/d/wiz/pk");
          this_player()->save();
          add_action("block_cmd","",1);         
        }
        call_out("hehe", 2, this_player());
}
int block_cmd()
{
        string verb = query_verb();

        if (verb=="say") return 0; //allow say
        if (verb=="help") return 0;
        if (verb=="top") return 0;
        if (verb=="who") return 0;
        if (verb=="inventory") return 0;
        if (verb=="go") return 0;
        if (verb=="hp") return 0;
        if (verb=="score") return 0;
        if (verb=="post") return 0;
        if (verb=="chat") return 0;
        if (verb=="look") return 0;
        return 1;
}
