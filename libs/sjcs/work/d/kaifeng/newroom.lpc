#include <ansi.h>
inherit ROOM;
void create()
{
        set("short",HIR"西游神话"HIW"新手成长室"NOR);
        set("long",@LONG
    这里就是西游神话新手成长室,在这里新手可以输入(shenhua),
就会得到意想不到的帮助!
LONG);
        set("exits",([
 "down":"/d/kaifeng/tieta",
]));
set("no_magic", 1);
        set("no_fight", 1);
        setup();
}
void init()
{
      add_action("do_shenhua","shenhua");
}
  int do_shenhua()
{
   object me=this_player();
   if((me->query("age")<=15)&&(me->query("combat_exp")<=200000))
{
    me->set("eff_sen", (int)me->query("max_sen"));
    me->set("sen", (int)me->query("max_sen"));
    me->set("gin", (int)me->query("max_gin"));
    me->set("eff_gin", (int)me->query("max_gin"));
    me->set("kee", (int)me->query("max_kee"));
    me->set("eff_kee", (int)me->query("max_kee"));
    me->set("water", (int)me->max_water_capacity());
    me->set("food", (int)me->max_food_capacity());
    me->set("force", (int)me->query("max_force"));
    me->set("mana", (int)me->query("max_mana"));
    message_vision(HIM"$N觉得有股神秘的力量注入体内,感到全身充满了活力.\n"NOR,me);
    return 1;
}
else
{     return notify_fail(HIW"你已经不算是新手了.\n"NOR);
}
}
