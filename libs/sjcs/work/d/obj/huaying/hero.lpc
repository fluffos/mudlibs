#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create()
{

        set_name(HIR"英雄"NOR, ({ "hero", "jiezhi", "ring" }));
	set("weight", 400);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("value", 200000);
      set("no_sell",1);
      set("no_give",1);
      set("no_drop",1);
      set("no_get",1);
		set("long",HIG"这是一个神秘的戒指。能带给你无穷的力量。\n"NOR);
		set("material", "gold");
		set("armor_prop/armor", 30);
		set("armor_prop/strength", 30);
		set("armor_prop/karma", 10);
}
	setup();
}
