// leizhu.c 泪珠
// last updated by xueyi 8.8.2002

#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create()
{
	set_name(HIW"泪珠"NOR, ({ "leizhu", "jiezhi", "ring" }));
	set("weight", 400);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("value", 200000);
		set("long",HIW"这是一个神秘的戒指。能带给你无尽的智慧。\n"NOR);
		set("material", "gold");
		set("armor_prop/armor", 30);
		set("armor_prop/composure", 10);
		set("armor_prop/spirituality", 10);
}
	setup();
}
