#include <ansi.h>

inherit F_AUTOLOAD;  
inherit ITEM;

void create()
{
    set_name(HIY"股市充值卡"NOR, ({ "add card", "card"}));
	set_weight(50);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "张");
                set("value", 10000);
		set("material", "steel");
	}
	setup();
}

void init()
 {
   add_action("do_look","add");
 }

int do_look(string arg)  
 {
    int score;
    object me;
    me=this_player();
    if(arg!="card" && arg!="add card")
        return 0;
    if (me->query("stock/add")>1)
    	return notify_fail("现行股市规则规定每个玩家最多只可充值1次！！！。\n");
    me->add("stock/total",100000);
    me->add("stock/add",1);
    message_vision("$N使用股市充值卡，发现股市资金帐户上多了100000文的资金。\n", me);
    destruct(this_object());
      return 1;
 }

int query_autoload() { return 1; }
void owner_is_killed()
{
destruct(this_object());
}