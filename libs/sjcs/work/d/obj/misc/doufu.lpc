inherit ITEM;
void init()
{
        add_action("do_eat", "zhuang");
}
void create()
{
        set_name("豆腐", ({"doufu","fu"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long", "这是一快刚从零下36度的冰箱里拿出来的冰豆腐。\n");
        }
}
int do_eat(string arg)
{
        string *skills;
        mapping all_skills;
        int i;
        if (!id(arg))
             return notify_fail("你要撞什么？\n");
 else{
	this_player()->move("/d/city/sleep");
        message_vision("$N拿起冰豆腐撞了上去，感觉来到了一个陌生的地方。\n", this_player());
        destruct(this_object());
        return 1;
        }
}