#include <ansi.h>

inherit F_AUTOLOAD;  
inherit ITEM;

void create()
{
    set_name(HIY"股市资金查询卡"NOR, ({ "check card", "card"}));
	set_weight(50);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "张");
                set("value", 1000);
		set("material", "steel");
	}
	setup();
}

void init()
{
   add_action("do_look","look");
}

int do_look(string arg)  
{
//	in ii;
	object me=this_player();
//	ii=me->query("stock/total")+me->query("stock/in");
    	if(arg!="card"&&arg!="check card")
        	return 0;
    	if (me->query("stock/total")>0)
		tell_object(me,"这是一张股市资金查询卡，卡上显示你股市资金的当前余额为：\n"
    		+ me->query("stock/total") + "文，已经充值：" + me->query("stock/add")
    		+ "次，下次奖励要求盈利："+ (me->query("stock/reward") +1)* 100000 +"文。 \n");
	else
   		tell_object(me,"这是一张股市资金查询卡，卡上显示你股市资金的当前余额为：\n"
    		+ "空 \n");
      	return 1;
}

int query_autoload() { return 1; }

void owner_is_killed()
{
destruct(this_object());
}
