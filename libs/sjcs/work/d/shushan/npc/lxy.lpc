
inherit NPC;
inherit F_MASTER;
int ask_me();
int recruit_apprentice(object ob);
int attempt_apprentice(object me);
int do_report();

void create()
{
        set_name("李逍遥", ({ "li xiaoyao", "li", "xiaoyao" }));
        set("title","蜀山剑派入门弟子");
        set("long", 
"李逍遥身材较瘦，长的浓眉阔眼，气宇暄昂。\n");
        set("gender", "男性");
        set("age", 18);
        set("attitude", "peaceful");
        set("str", 30);
        set("int", 40);
        set("con", 30);
        set("per", 30);
        set("kee", 2800);
        set("max_kee", 2800);
        set("sen", 1600);
        set("max_sen", 1600);
        set("force", 4800);
        set("max_force", 2400);
        set("mana", 4800);
        set("max_mana", 2400);
        set("force_factor", 60);
        set("mana_factor", 60);

        set("combat_exp", 1800000);
        set("daoxing", 2500000);

        set_skill("force", 150);
        set_skill("dodge", 160);
        set_skill("spells", 180);
        set_skill("parry", 140);
        set_skill("sword", 180);
        set_skill("canxin-jian", 200);
        set_skill("shushan-force", 130);
        set_skill("zuixian-steps", 160);
//      set_skill("jingya-sword", 130);
        set_skill("literate", 80);
        set_skill("xianfeng-spells", 120);
        map_skill("spells", "xianfeng-spells");
        map_skill("force", "shushan-force");
        map_skill("dodge", "zuixian-steps");
        map_skill("parry", "canxin-jian");
        map_skill("sword", "canxin-jian");
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: exert_function, "recover" :),
                (: perform_action, "sword","xiangsi" :),
                (: exert_function, "powerup" :),
        }) );

        set("inquiry", ([
                "赵灵儿" : "你能帮我去救灵儿？我可会报答你的！\n",
                "醉道士" : "好久没见师父了！\n",
                "去镇妖塔"     : (: ask_me :),
                "任务完成"     : (: do_report :),
        ]));
        setup();
    create_family("蜀山派", 1, "掌门");
        carry_object("/obj/cloth")->wear();
        carry_object("/d/obj/weapon/sword/qingfeng")->wield();
}

int attempt_apprentice(object me)
{
me =this_player();

me->set("shushan/xiangsi_perform",1);
  command("pat "+me->query("id"));
  command("say 那我收下你吧．");
  command("recruit " + me->query("id") );
  return 1;
}

int do_report()
{
        int i=random(500)+1;
        object who = this_player();
        object me = this_object();
          object ling = new("/d/shushan/npc/linger");
        if(who->query("obstacle/shushan") == "done"){
        tell_object(who,"你不是已经闯过此关了吗？\n");
        command("shake "+who->query("id"));
        return 1;
        }
     if (who->query("shushan/zhanyi") == 1 && objectp(present(ling->query("id"), environment(me)))){
        command("thank "+who->query("id"));
        command("u&me "+who->query("id"));
        command("chat "+who->name()+"成功打破镇妖塔，救出灵儿，打破了数百年来没人能在镇妖塔出来的记录！\n");
        who->add("obstacle/number",1);
        who->add("obstacle/potential",1);
        who->set("obstacle/shushan","done");
        who->add("daoxing",8000+i);
        destruct(present(ling->query("id"), environment(me)));
        who->delete_temp("shushan/linger_daying");
        tell_object(who,"你赢得了"+chinese_number(8)+"年"+chinese_number(i/4)+"天"+chinese_number((i-(i/4)*4)*3)+"时辰的道行！\n");
        who->set("title","仙剑奇侠");
        who->save();
        return 1;
        }
    if (who->query("shushan/zhanyi") != 1)//由下面判断是否救出灵儿。
         {tell_object(who,"你救出灵儿了吗？\n");
          return 1;}
                
       if(!objectp(present(ling->query("id"), environment(me))))//由下面判断灵儿是否在身边。
         {tell_object(who,"你把灵儿带到哪里去了？\n");
          return 1;}
                
        return 1;
}

int ask_me()
{
        object ob=this_player();
     if(ob->query("obstacle/shenglingzhu") != "done")
        return 0;
        if(ob->query("obstacle/shushan") == "done")
        {
        command("say 谢谢你！不能再麻烦你啦！");
        return 1;
        }
        command("wa");
command("say 好吧，拜托你啦，成功救出灵儿的话，一定要告诉我！\n");       
        return 1;
}

