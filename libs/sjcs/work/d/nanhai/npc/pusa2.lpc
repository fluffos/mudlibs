inherit NPC;
#include <ansi.h>
inherit F_MASTER;
string ask_for_cantpk();
string ask_for_canpk();
int do_cantpk(string arg);
int do_canpk(string arg);
int do_drop(object, object);

void create()
{
        set_name("观音菩萨", ({ "guanyin pusa", "guanyin", "pusa" }));
        set("title",HIG "没事专门管人间"HIR"杀人"HIY"之事" NOR);
        set("long", @LONG
如果你不想让人pk 那就(ask pusa about 终生不杀人)吧，保你没事!!
如果你功夫练好了，又想杀人了，那就请三思之后(ask pusa about 反悔)吧
不过要掉道行，武学和潜能的，杀人可不是那么容易的事呀！！
LONG);
        set("gender", "女性");
        set("age", 35);
        set("attitude", "peaceful");
        set("rank_info/self", "贫僧");
        set("rank_info/respect", "菩萨娘娘");
        set("class", "bonze");
                set("str",24);
        set("per",100);//means no rong-mao description.
        set("max_kee", 5000);
        set("max_gin", 5000);
        set("max_sen", 6000);
        set("force", 4000);
        set("max_force", 4000);
        set("force_factor", 200);
        set("max_mana", 4000);
        set("mana", 6000);
        set("mana_factor", 200);
        set("combat_exp", 2000000);
        set("daoxing", 10000000);

        set_skill("literate", 200);
        set_skill("spells", 300);
        set_skill("buddhism", 300);
        set_skill("unarmed", 280);
        set_skill("jienan-zhi", 250);
        set_skill("dodge", 280);
        set_skill("lotusmove", 300);
        set_skill("parry", 280);
        set_skill("force", 300);
        set_skill("lotusforce", 300);
        set_skill("staff", 280);
        set_skill("lunhui-zhang", 250);
        map_skill("spells", "buddhism");
        map_skill("unarmed", "jienan-zhi");
        map_skill("dodge", "lotusmove");
        map_skill("force", "lotusforce");
        map_skill("parry", "lunhui-zhang");
        map_skill("staff", "lunhui-zhang");
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: cast_spell, "bighammer" :),
        }) );
        set("inquiry",([
      "终生不杀人" : (: ask_for_cantpk :),
            "反悔" : (: ask_for_canpk :),
                "净瓶": "前些天，福星借我的净瓶用，到现在也没有还，你去看看吧。" ]));
    


        //let's use cast bighammer to protect her...weiqi:)
        create_family("南海普陀山", 1, "菩萨");

        setup();
        carry_object("/d/nanhai/obj/jiasha")->wear();
        carry_object("/d/nanhai/obj/nine-ring")->wield();
}
void init()
{
        add_action("do_cantpk", "decide");
               add_action("do_canpk", "jueding");
              }
string ask_for_cantpk()
{
        object me=this_player();
        if(me->query("cantpk"))
        return ("你已经选择过了！\n");
        if (me->query("age") >=14) {
                command("say 你真的愿意选择终生不杀玩家也不想被玩家杀吗？");
                me->set_temp("ask_cantpk", 1);
                return ("一旦决定了，终生不得反悔，你决定(decide)吗？");
        }

        return ("你年龄太小，哪里懂杀伐之事？\n");
}
int do_cantpk(string arg)
{
        
if(!this_player()->query_temp("ask_cantpk"))
return 0;
if(this_player()->query_temp("ask_cantpk")) {
                message_vision("$N答道：弟子愿意。\n\n", this_player());
                command("say 施主果然热爱和平，愿好运常伴！");
                this_player()->set("cantpk",1);
                this_player()->set("canpk",0);
                this_player()->delete_temp("ask_cantpk");
                this_player()->save();
                command("chat "+this_player()->query("name")+"("+this_player()->query("id")+")"+"做出决定，
终生不杀人。");
                command("chat "+"愿好人一生平安！");
                return 1;
        }
}
string ask_for_canpk()
{
        object me=this_player();
        if(me->query("canpk"))
        return ("你已经反悔过了！\n");
//         if(me->query("potential")<=100000)
//         return ("没潜能也想反悔吗？\n");
              if(me->query("combat_exp")<=100000)
              return ("没武学也想反悔吗？\n");
              if(me->query("daoxing")<=100000)
              return ("没道行也想反悔吗？\n");
        if (me->query("age") >=14) {
                command("say 你真的想其它杀玩家,真的想反悔吗？");
                me->set_temp("ask_canpk", 1);
                return ("一旦决定了，终生不得反悔，你决定(jueding)吗？");
        }

        return ("你年龄太小，哪里懂杀伐之事？\n");
}
int do_canpk(string arg)
{
        
if(!this_player()->query_temp("ask_canpk"))
return 0;
if(this_player()->query_temp("ask_canpk")) {
                message_vision("$N答道：弟子愿意。\n\n", this_player());
                command("say 施主不爱和平，那也是没办法的事了！");
                this_player()->set("canpk",1);
                this_player()->set("cantpk",0);
                this_player()->delete_temp("ask_canpk");
                 this_player()->add("combat_exp",-100000);
//                 this_player()->add("potential",-100000);
                this_player()->add("daoxing",-100000);
                this_player()->save();
                command("chat "+this_player()->query("name")+"("+this_player()->query("id")+")"+"做出决定，
反悔要杀人啦。");
                command("chat "+"愿坏人处处遭瘟,不得好死！");
                return 1;
        }
}

void attempt_apprentice(object ob)
{
        if (!((string)ob->query("bonze/class") =="bonze" )) {
                command("say 我佛门神通广大，" + RANK_D->query_respect(ob) + "欲成正果，先入我门。\n");
                write("看样子观音菩萨对你未剃度出家颇为不快。\n");
                return;
        }       


        if (((int)ob->query_skill("buddhism", 1) < 100 )) {
                command("say " + RANK_D->query_respect(ob) + "不在佛法上苦修，恐怕难成正果。\n");
                return;
        }
        command("pat " + ob->query("id") );
        command("say 好！这才是我佛门的好弟子。只要多加努力，定可早成正果。\n");

        command("recruit " + ob->query("id") );
ob->set("class","bonze");
        return; 
}
void die()
{
        int i;
        string file;
        object *inv;

        if( environment() ) {
        message("sound", "\n\n观音菩萨摇头叹道：刚离迷障，又入魔障，世间疾苦，何人度之！\n\n", environment());
        command("sigh");
        message("sound", "\n观音菩萨驾祥云，登彩雾，径往西方去了。。。\n\n", environment());
        inv = all_inventory(this_object());
        for(i=0; i<sizeof(inv); i++) {
                if (inv[i]->query("no_drop")) continue;
                do_drop(this_object(), inv[i]);
//              if (stringp(file = find_command("drop")) && 
//                      call_other(file, "do_drop", this_object(), inv[i])) ;
        }
        }

        destruct(this_object());
}

int do_drop(object me, object obj) {
  if (obj->move(environment(me))) {
      //d_mana>0 is for "bian". mon 11/05/97
      if((obj->query_temp("d_mana"))>0) {
            if( obj->query_temp("is_living")==1 )
                 message_vision("$N将$n从背上放了下来，躺在地上。\n", me, obj);
            else {
                 message_vision( sprintf("$N丢下一%s$n。\n",
                 undefinedp(obj->query_temp("unit"))?
                         "个":obj->query_temp("unit")
                         ), me, obj );
           }
      } else {
           if( obj->is_character() )
                  message_vision("$N将$n从背上放了下来，躺在地上。\n", me, obj);
           else {
             message_vision( sprintf("$N丢下一%s$n。\n", obj->query("unit")),
                     me, obj );
             if( !obj->query("value") && !obj->value() ) {
                tell_object(me,"因为这样东西并不值钱，所以人们并不会注意到它的存在
                   。\n");
                destruct(obj);
             }
           }
      }
      return 1;
  }
  return 0;
}


void unconcious()
{
        die();
}

int accept_object(object who, object ob)
   {
        if ( ob->query("id") == "sheng lingzhu" )
          {
           if( who->query("obstacle/zhu") )
            {
            command("say "+who->query("name")+"，你已经过完三十六关了。\n");
      return 1;
            }
           command("wa");
           remove_call_out("check");
           call_out("check",2,who);
           return 1;
          }
      return 1;
}
void check(object who)

{
  int i;
  if (who->query("combat_exp") < 10000)
     return;
  if (!who->query("obstacle/xuanyuan"))
    return;
  if ( who->query("obstacle/zhu") == "done" )
       return ;
  i = random(600);
  who->add("obstacle/number",1);
  who->set("obstacle/zhu","done");
  who->add("combat_exp",i+20000);
  command("chat "+who->query("name")+"替我佛如来找回圣灵珠！");
  command("chat "+who->query("name")+"顺利闯过西行最后一关！");
  command("chat 祝贺"+who->query("name")+"功德圆满。");
  tell_object (who,"你赢得了"+chinese_number(20)+"年"+
               chinese_number(i/4)+"天"+
               chinese_number((i-(i/4)*4)*3)+"时辰的道行！\n");
  who->save();
  who->start_busy(2);
}

