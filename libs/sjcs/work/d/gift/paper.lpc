//inherit COMBINED_ITEM;
#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_canwu", "canwu");
}

void create()
{
        set_name(HIY BLINK"佛经"NOR, ({"fo jing", "book"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
        set("base_unit","本");
        set("unit","堆");
        set("long", HIW"
                  南无阿弥驼佛
 这是一本流传千古的佛经,用他可以降低你的PK值....
                请使用canwu book \n"NOR);
set("no_give", 1);
 set("no_drop", 1);
 set("no_put", 1);
 set("no_steal", 1);
 set("no_get", 1);
 set("value", 0);
 set("no_sell", 1);
 set("value", 0);
                }
        setup();
}

int do_canwu(string arg)
{
   object me = this_player();
   if (!id(arg))
   return notify_fail("你要吃什么药？\n");
   if (!arg="book") return notify_fail(HIR BLINK"请使用:canwu book \n"NOR);
   if (me->query("PKS")<1) return notify_fail(HIY"你没有杀过人,佛经对你没有作用\n"NOR);
   if (me->query("PKS")>30) return notify_fail(HIR"你已经超出佛经所能同化的范围了.sorry \n"NOR);
   message_vision(HIW"南无阿弥驼佛 恶有恶报 善有善报 不是不报 时辰未到\n"NOR,me);
   me->add("PKS", -1);
   tell_object(me,HIW"经过一番领悟你发觉你的PK值降低了!恭喜恭喜!\n"NOR);
   destruct(this_object());
   me->start_busy(5+ random(4));
   return 1;
}

