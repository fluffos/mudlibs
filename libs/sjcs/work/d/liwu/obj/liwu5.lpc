#include <ansi.h>
inherit ITEM;
 void create()
{
        set_name(HIG "西游壮胆丹" NOR, ({"nei dan", "dan"}));
        set_weight(20);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "枚");
                set("long", "一枚能使你变得更胆大的西游壮胆丹。\n");
                set("value", 200000);
        }

        setup();
}

void init()
{
    if (!wizardp(this_player())) {
        set("no_get"," 嘿嘿，做梦吧! \n");
        set("no_drop","这么宝贵的东东，哪能乱扔! \n");
	   set("no_give","你太慷慨了吧！\n");
       }
        add_action("do_eat", "eat");
}

int do_eat(string arg)
{
 	int cor_limit,improve;
	object me = this_player();
        if( !living(me) )
		return notify_fail("你想当机吗？\n");
	cor_limit = me->query("cor");
	if (!id(arg))
	return notify_fail("你要吃什么？\n");
        if ( cor_limit < 39  ) 
	   {improve=1+random(1);
           me->add("cor",improve);
	   me->save();
 	   message_vision(HIY "$N吃下一枚西游壮胆丹，顿然觉得自己好像什么都不怕了...\n" NOR, this_player());
	}
        else 
        message_vision(HIY "$N吃下一枚西游壮胆丹，不过好象没什么感觉...\n" NOR, this_player());
		destruct(this_object());
	return 1;
}

void owner_is_killed()
{
destruct(this_object());
}