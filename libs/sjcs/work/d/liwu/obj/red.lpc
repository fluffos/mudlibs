// 红包

#include <ansi.h>
inherit ITEM;
int do_open(string arg);
     
    string *red_object=({
                      "/d/liwu/obj/liwu1",
                      "/d/liwu/obj/liwu2",
                      "/d/liwu/obj/liwu3",
                      "/d/liwu/obj/liwu4",
                      "/d/liwu/obj/liwu5",
                      });
              
void create()
{
	set_name(HIR"红包"NOR, ({"hong bao", "bao", "hong"}));
	set_weight(10);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一个用红纸制作而成的"+HIR"红包，"NOR+"似乎可以撕开(tearoff)。\n");
		set("unit", "个");
		set("value", "500000");
	}
}


   void init()
  { if(query("teared"))return;
    set("no_give","每个人只有一个，你都这么大方！\n");
    set("no_put","每个人只有一个，你都这么大方！\n");
    set("no_steal","每个人只有一个，你都这么大方！\n");
    set("no_get","每个人只有一个，不要这么贪心！\n");
    set("no_drop","这么珍贵的东西你也扔？！\n");
    add_action("do_open","tearoff");
  }

int do_open(string arg)
{ 
	object me=this_player(),ob;
        int rand;
    	if(query("teared"))              
        	return 0;
    	set("teared",1);
    	set("value", 100);
    	set("no_give",0);
    	set("no_get",0);
    	set("no_drop",0);
    	set("long", "一个用红纸制作而成的"+HIR"红包，"NOR+"已经被撕开了。\n");
        if(me->query("gender")=="男性")
    		tell_object(me,"你迫不及待地将"+HIR+"红包"NOR+"撕开，\n");
        else
    		tell_object(me,"你小心翼翼地将"+HIR+"红包"NOR+"打开，\n");
       	rand=random(6);
      	if(rand<sizeof(red_object))
      	{
           	ob=new(red_object[rand]);
		me->add("potential",50000);
		me->add("daoxing",100000);
		me->add("combat_exp",100000);           	
  		ob->move(me);
   		tell_object(me,"你获得了许多奖励和一"+ob->query("unit")+ob->query("name")+"。\n"NOR);
      	}
      	else 
      	{
      		if(present("gold card",me))
                {
                	tell_object(me,"你的金卡加了一百两"HIY+"黄金"NOR+"。\n"NOR);
                   	me->add("balance",1000000);
                }
                else
                {
                	ob=new("/d/liwu/obj/goldcard");
                        ob->move(me);
                        tell_object(me,"你发现了一张"+HIY"金卡"NOR+"。\n"NOR);
                        me->add("balance",1000000);                                
               	}  
      	} 
	destruct(this_object());
        return 1;
}  

void owner_is_killed()
{
destruct(this_object());
}
  

  
