  set("daoxing", 4000000);
  set("title", "格斗天尊");
  set("age", 30);
  set("str", 40);
  set("int", 40);
  set("per", 30);
  set("con", 30);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin",20000);
  set("max_kee",20000);
  set("max_sen",20000);
  set("max_force",10000);
  set("force_factor", 200);
  set("force",20000);
  set("mana",20000);
  set("max_mana",10000);
  set("mana_factor", 200);
