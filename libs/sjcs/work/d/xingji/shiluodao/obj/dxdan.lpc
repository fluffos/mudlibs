#include <ansi.h>

inherit ITEM;

int do_eat(string);
void create()
{
  set_name(HIC "奖励丹" NOR, ({"dan", "dxdan"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "黑黑的野果子，很象人参果喔！！。\n");
    set("value", 5000);
    set("no_sell", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("no_drop", 1);
  }
  
  setup();
}

void init()
{
        add_action("do_eat", "eat");
}

int do_eat(string arg)
{
  object me = this_player();
    
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

        message_vision(WHT"$N吃下一颗奖励丹，精神百倍！！！。\n"NOR, me);  
  
        me->add("bellicosity", -random( (int)me->query_kar() * 10));
        if ((int)me->query("bellicosity") < 0 ) me->set("bellicosity", 0);
      //  me->add("daoxing", 2000);

  destruct(this_object());
  return 1;
}

