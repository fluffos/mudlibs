#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

void create()
{
  set_name(BLINK+HIW"麒麟蚕衣"NOR, ({"qilin canyi", "canyi"}));
  set_weight(4500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("material", "crimsonsteel");
    set("unit", "件");
    set("value", 700);
    set("armor_prop/armor", 70);
    set("armor_prop/dodge", 15);
    set("armor_prop/spells", 30);
  }
  setup();
}

