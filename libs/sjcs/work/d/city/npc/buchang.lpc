inherit NPC;
#include <ansi.h>
int give_dan();
int answer_me();

void create()
{
        set_name(HIW"补偿大使"NOR, ({"bu chang","chang"}));
	set ("long", @LONG
他是在这里代表系统向各位玩家道歉的，
他整天都跪着，好可怜啊，请各位玩家谅解吧！
不信你就去要求(ask)他补偿吧。记得，只能有一次哦！
LONG);
           set("gender", "男性");
           set("title",HIG"系统"NOR);
           set("age", 24);
           set("per", 13);
       	   set("attitude", "peaceful");
           set("shen_type", 1);
	   set("inquiry", 
	   	([
           	"buchang":(:give_dan:),
          	"补偿":(:give_dan:),
           	"name":(:answer_me:),
		]));
        setup();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
}
}
int answer_me()
{
command("say 我是系统的补偿大使，在这里
发放补偿用品给大家的。\n");
return 1;
}

int give_dan()
{
object dan;
object who=this_player();
if (!userp(who))
{
	command("heng");
	command("say 我只对玩家补偿的？！");
	command("qi");
return 1;
}
         if (this_player()->query("yudian/buchang")=="got")
{
          message_vision("$N对着$n哼了一声。\n",this_object(),this_player());
       	  command("say 补偿也不能无休止啊！补偿过就不再有了！");
  	  return 1;
}
         if (this_player()->query("combat_exp")<=400000 || this_player()->query("daoxing")<=108000)
{
          message_vision("$N对着$n哼了一声。\n",this_object(),this_player());
       	  command("say 想用新人来骗礼物啊！滚！！！");
  	  return 1;
}
	if (random(10000)==1) 
	{
	dan=new("/d/obj/drug/huanyang");
	dan->move(who);
	}	
	dan=new("/u/sys/obj/buchang");
	dan->move(who);
	message_vision("$N由衷的说到：I am sorry!\n$N给$n一粒系统补偿丹,并关照立刻吃掉以免融化。\n",this_object(),this_player());
        who->set("yudian/buchang","got");
return 1;
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
say(name()+"由衷地说：“对不起啊？我自己也被别人害得很惨！唔唔！”\n"NOR);

}

