#include <ansi.h>
inherit NPC;
int ask_me();
int ask_bing();
void create()
{
       set_name("堕落天使", ({ "duoluo tianshi", "angel" }));
        set("title","天神");
        set("long", 
              "他就是堕落天使，他是这里的天神。\n"
              "如果你想收集神书，你可以问问他(book)和(shi).\n"
              );
        set("age", 20);
        set("class", "beggar");
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 700);
        set("int", 40);
        set("con", 40);
        set("dex", 700);
        set("no_kill",1);
        set("max_kee", 99999999);
        set("max_sen", 999999999);
        set("force", 4500);
        set("max_force", 4500);
        set("mana", 4500);
        set("max_mana", 4500);
        set("jiali", 0);
        set("combat_exp", 25000000);
        set("daoxing", 45000000);
        set("score", 50000);                
        set_skill("spells",200);
        set_skill("unarmed",200);
        set_skill("dodge",200);
        set_skill("force", 200);
        set_skill("parry", 210);
        set_skill("literate", 200);

set("inquiry", ([
            "book": "你想得到秘籍吗？就问我(shi)吧！",
            "shi": "给我钱吧！我会给你一样有用的东西！",
            ]) );
        setup();
}
int accept_object(object me, object ob)
{
object shi; 
if( ob->query("money_id") && ob->value() >= 2000000)
{       
         if (!present("xdshi", me))
        {
        shi = new("/d/xingji/feitan");
        command("say 好吧,刚好我心情好"+me->query("name")+"既然给了钱，我就勉强给你一张！\n");
        shi->move(me);
        message_vision("$N将一张飞毯交给了$n。\n" , this_object(), me );
        } else 
        command("say 你不是有了一张嘛，还想要？钱我没收！看不惯就PK我呀！\n");
return 1;
}
command("say 不用谢我了！");
return 1;
}

