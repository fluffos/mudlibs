inherit NPC;

#include <ansi.h>
int do_jiangli();

void create()
{
        set_name(HIR"接引使"NOR, ({ "da shi","shi" }) );
        set("gender", "男性" );
        set("title", HIG"西行战记"NOR );
        set("age", 26);
        set("long",
"西行战记接引使，新手可以试试 ask da shi about 奖励 。\n"
        );
        set("shen_type", 1);
        set("combat_exp", 200000); 
        set("inquiry", ([
                  "奖励"  : (: do_jiangli :) 
        ]));

        setup();
}


void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
             say("接引使说道：这位" + RANK_D->query_respect(ob)
             + "，你是新手的话可以向我要些奖励！"HIR"ask da shi about 奖励 "NOR"。\n");
        return;
}
int do_jiangli()
{
  object me = this_player();
  object sth;
  if(me->query("dashi_jiangli") != 1)

    {
        tell_object(me, "接引使翻了翻玩家名册说道：你是刚来的吧，你可以得到如下新手奖励！\n");
        me->set("dashi_jiangli",1);
        command("xxzj "+HIC"欢迎"+me->query("name")+" 来到"+HIY"西行战记"+HIG"，请各位玩家多多关照。" NOR);

        me->add("combat_exp",20000);
        me->add("potential",15000);
        me->add("force",100);
        me->add("eff_force",100);
        me->add("maximum_force",100);
        me->add("max_force",100);
        me->add("mana",100);
        me->add("max_mana",100);
        me->add("maximum_mana",100);
        me->add("eff_mana",100);
        me->add("daoxing",36000);
        tell_object(me,HIG"接引使说道：好吧！伸手在你的头上拍了一下，你觉得自己现在和原来不一样了！\n" +
        chinese_number(20000) + "点武学经验\n"+
        "三十六年道行\n"+
        chinese_number(100) + "点内力\n"+
        chinese_number(100) + "点法力\n"+
        chinese_number(15000) + "点潜能\n" NOR);
//        sth = new("/obj/money/gold");
//        sth -> move( this_object() );
//        command("give gold to " + me->query("id"));
    }
  else tell_object(me, "接引使翻了翻玩家名册说道：你好像不是新手哦！\n");
  return 1;
}

