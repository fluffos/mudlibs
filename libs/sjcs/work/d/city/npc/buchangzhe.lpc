inherit NPC;
#include <ansi.h>
string give_buchang();
void create()
{
                  set_name(""HIC"当机补偿使者"NOR"", ({"buchangzhe"})); 
   set ("long", @LONG
他是在这里负责给大家发当机补偿的。
LONG);
           set("gender", "男性");
        set("title",HIY"倒霉的"NOR);
        set("age", 20);
        set("per", 40);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("inquiry", ([
            "补偿"    :(:give_buchang:),
]));
        setup();
}
string give_buchang()
{
         object who=this_player();
         if (!userp(who)){
                command("heng");
                command("qi");
                return ("什么小猫小狗也来要礼物？！\n");
}
         if (this_player()->query("buchang") > 0 ){
         message_vision("$N对着$n哼了一声。\n",this_object(),this_player());
                return ("真贪心！补偿只有一份！领过就不给了！\n");
}
         who->add("combat_exp",50000);
         who->add("daoxing",50000);
         who->add("potential",50000);
         who->set("buchang",1);
         message_vision("$N对着$n阴阴一笑，$n觉得身上多了些东西。\n",this_object(),this_player());
         command("chat 恭喜恭喜，"+who->query("name")+"得到了当机补偿！\n");
         command("heihei");
}
