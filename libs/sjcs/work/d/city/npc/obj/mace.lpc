//malemace.c
//created 5-30-97 pickle
#include <weapon.h>
#include <ansi.h>
inherit MACE;
inherit F_UNIQUE;
void create()
{
  set_name(YEL "豹尾鞭" NOR, ({"bao mace", "mace", "baomace", "bao"}));
  set_weight(10000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 18000);
    set("material", "steel");
    set("long", "这是一柄精钢铸成的豹尾鞭。\n");
    set("wield_msg", "$N从肩上取下一个布袋，解了开来，袋中竟然是$n！\n");
    set("unwield_msg", "$N拿起布袋擦了擦$n，又把它小心翼翼地包了起来。\n");
  }
  
  init_mace(70);
  setup();
}