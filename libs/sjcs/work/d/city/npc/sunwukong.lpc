inherit NPC;

#include <ansi.h>
#include <mudlib.h>
int do_jiangli();

void create()
{
        set_name(HIY"孙悟空"NOR, ({ "sun wukong","sun","wukong" }) );
        set("gender", "男性" );
        set("title", "七龙珠" );
        set("age", 26);
        set("long",
"一个七龙珠里的孙悟空，试试 ask sun about 西行战记 。\n"
        );
        set("shen_type", 1);
        set("combat_exp", 500000);
        set("daoxing", 1000000);  
        set("inquiry", ([
                  "西行战记"  : (: do_jiangli :) 
        ]));

        setup();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
             say("孙悟空说道：这位" + RANK_D->query_respect(ob)
             + "，你可以向我要求一些新手奖励哦！ "HIR"ask sun about 西行战记 "NOR"。\n");
        return;
}
int do_jiangli()
{
  object me = this_player();
  object sth;
  if(me->query("sun_jiangli") != 1)
    {
        tell_object(me, "孙悟空说道：太好了,你应该得到新手奖励！\n");
        me->set("sun_jiangli",1);
        command("xxzj 欢迎"+HIC""+me->query("name")+""+NOR"加入"+MUDLIB_NAME+"的大家庭，给予"+HIR"新手奖励"+NOR"以兹"+HIM"鼓励"+NOR"。");

        me->add("combat_exp",2000);
        me->add("potential",2000);
        tell_object(me,HIW"你被奖励了：\n" +
        chinese_number(2000) + "点武学经验\n"+
        chinese_number(2000) + "点潜能\n"+
        chinese_number(1) + "两金子\n" NOR);
        sth = new("/obj/money/gold");
        sth -> move( this_object() );
        command("give gold to " + me->query("id"));
    }
  else tell_object(me, "孙悟空说道：你已经得到过新手奖励了，不要太贪心哟！\n");
  return 1;
}

