#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void init() 
{
        add_action("do_rock","rock"); 
}

void create() 
{
        set_name(HIC"红玫瑰"NOR, ({ "mei gui","hua" }) );
        set_weight(2000); 
        if( clonep() )
                set_default_object(__FILE__); 
        else {
                set("unit", "支"); 
                set("value", 0); 
                set("material", "steel"); 
                set("long", "一朵娇艳动人的玫瑰。\n"); 
                set("wield_msg", HIM"$N微微一笑，一朵红玫瑰飘然而至。\n"NOR); 
                set("unequip_msg", HIM"$N点了点头，玫瑰消失了。\n"NOR); 
          init_sword(2); 
             setup();
}

int do_rock(string arg)
{
       object me, obj;

       me = this_player(); 

      if(me->query("id")!="rock") 
              return notify_fail(HIW"你找死啊\n"NOR); 

      if( !arg )
              return notify_fail("你想迷昏谁\n"); 

      if(!objectp(obj = present(arg, environment(me))))
              return notify_fail("这里没有这个人\n"); 

      if( !obj->is_character() || obj->is_corpse() )
               return notify_fail("那不是活的\n"); 

       if(obj == me)

message_vision(HIB"\n$N你会爱上我吗?",me,obj);
