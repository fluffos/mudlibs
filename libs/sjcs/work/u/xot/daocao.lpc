//daocao.c
//toto 2002.6

inherit ITEM;


void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name("救命稻草", ({"jiuming daoccao", "daocao","plll"}));
        
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "棵 ");
              set("value", 30000);
            set("weight", 50);
                set("long", "这是一棵古怪的小草。\n");
        }
}
int do_eat(string arg)
{
        int jin,qi,fali,neili;
        int shiwu,yinshui;
        object me;
        me=this_player();
        if (!id(arg))
             return notify_fail("你要吃什么？\n");
 else{
        jin = me->query("max_sen");
        qi =me->query("max_kee");
        fali = me->query("max_mana")*2;
        neili = me->query("max_force")*2;
//        shiwu = me->max_food_capacity()*2;
//        yinshui = me->max_water_capacity()*2;
        me->set("eff_sen", jin);
        me->set("eff_kee", qi);
        me->set("sen", jin);
        me->set("kee", qi);
//        me->set("mana", fali);
//        me->set("force", neili);
        message_vision("$N吃下一棵救命稻草，小命有了保障。\n", me);
        destruct(this_object());

        return 1;
        }
}

 
