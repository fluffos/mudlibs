inherit NPC;
#include <ansi.h>
int give_bonnet();
int give_dan();
int give_family();

void create()
{
         set_name(HIR"木马"NOR, ({"xot"}));
         set ("long", @LONG
木马是在这里的天神，为了迎接大家特地来这里发
礼物(gift)给大家。他身上还有天师法冠(bonnet)呢!
不信你就去问问(ask)他(gift)(family)。记得，天师
法冠用完了要还哦！
LONG);
          set("gender", "男性");
          set("title",HIW"天神"NOR);
          set("age", 30);
          set("per", 40);
          set("attitude", "peaceful");
          set("shen_type", 1);
          carry_object("/d/lingtai/obj/faguan")->wear();
          set("inquiry", ([
                "bonnet":(:give_bonnet:),
                "gift":(:give_dan:),
                "newbie":(:give_dan:),
                "family":(:give_family:),
                "礼物":(:give_dan:),
                "天师法冠":(:give_bonnet:),
                "法冠":(:give_bonnet:),
         ]));
         setup();
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

int accept_object(object who, object ob)
{
      if( (string)ob->query("id")=="loyal bonnet" )
      {
                who->set("yudian/bonnet",0);
                command("say 下次用着再来找我要。");
        return 1;
      }
}

int give_dan()
{
        object dan;
        object who=this_player();
        if (!userp(who))
        {
                command("heng");
                command("say 什么小猫小狗也来要礼物？！");
                command("qi");
                return 1;
        }
         if (who->query("yudian/gift")=="got")
        {
                message_vision("$N对着$n哼了一声。\n",this_object(),who);
                command("say 礼物只有一份！领过就不给了！");
                 return 1;
        }
        who->add("combat_exp",100000);
        who->add("daoxing",100000);
        who->add("force",400);
        who->add("max_force",400);
        who->add("max_mana",400);
        who->add("mana",400);
        who->add("maximum_force",400);
        who->add("maximum_mana",400);
        who->add("potential",200000);
        message_vision("$N手一指，一朵彩云从飞来，笼罩了$n的全身。\n",this_object(),who);
        who->set("yudian/gift","got");
        return 1;
}
int give_bonnet()
{
        object bonnet;
        object who=this_player();
        if (!userp(who))
        { 
                command("heng");
                command("say 什么小猫小狗也来要东西？！");
                command("qi");
                return 1;
        }
          if (this_player()->query("yudian/bonnet")=="got")
        {
                message_vision("$N对着$n哼了一声。\n",this_object(),this_player());
                command("say 上次给你的还没还呢！不给了！");
                return 1;
        }
        bonnet=new("/d/lingtai/obj/faguan");
        bonnet->move(who);
        message_vision("$N念动咒语，变出一个天师法冠。\n$N给$n一顶天师法冠。\n",this_object(),this_player());
        who->set("yudian/bonnet","got");
          command("say "+HIW"用完了记得还我哦，否则下次不给了！"NOR);
        return 1;
 }
void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
        tell_object(ob,name()+"神秘地说：“想要礼物吗？你可以("+BLINK HIR"ask xot about family"NOR+")，\n"
        +"不过，你只有一次机会哦！哈哈！”\n"NOR);

}

int give_family()
{
        object who=this_player();
        string fam;
        int temp;
//武功级数
          temp=60;
        if (!userp(who))
        {
                command("heng");
                command("say 什么小猫小狗也来要礼物？！");
                command("qi");
                return 1;
        }
        if (!(who->query("yudian/gift")=="got"))
        {   
            command("say 你先去要了新人礼物(newbie)吧！");
                 return 1;
         }
         
         if (who->query("门派/gift")=="got")
        {
                message_vision("$N对着$n哼了一声。\n",this_object(),who);
                command("say 礼物只有一份！领过就不给了！");
                 return 1;
        }
      if (!who->query("family"))
        {   
            command("say "+HIM"你先去拜了师(bai)再说吧！"NOR);
                 return 1;
         }
        fam=who->query("family/family_name");
//基本武功
        who->set_skill("dodge",temp);
        who->set_skill("force",temp);
        who->set_skill("literate",temp);
        who->set_skill("parry",temp);
        who->set_skill("spells",temp);
        who->set_skill("unarmed",temp);
        who->set_skill("sword",temp);
        who->set_skill("blade",temp);
//      who->set_skill("dodge",temp);
//门派武功
        switch(fam)
        {
                case "武圣门":
                {
//                      who->set_skill("sword",temp);
                        who->set_skill("feisheng",temp);
                        who->set_skill("fumobashi",temp);
                        who->set_skill("mizongbu",temp);
                        who->set_skill("wuying",temp);
                        who->set_skill("xiantian",temp);
                         break;
                }
                case "月宫":
                {
//                      who->set_skill("sword",temp);
                        who->set_skill("baihua-zhang",temp);
                        who->set_skill("moondance",temp);
                        who->set_skill("moonforce",temp);
                        who->set_skill("moonshentong",temp);
                        who->set_skill("snowsword",temp);
                        break;
                }
                case "陷空山无底洞":
                {
                        who->set_skill("huntian-qigong",temp);
                        who->set_skill("lingfu-steps",temp);
                        who->set_skill("qixiu-jian",temp);
                        who->set_skill("stealing",temp);
                        who->set_skill("yaofa",temp);
                        who->set_skill("yinfeng-zhua",temp);
                        break;
                }
                case "南海普陀山":
                {
                        who->set_skill("buddhism",temp);
                        who->set_skill("jienan-zhi",temp);
                        who->set_skill("lotusforce",temp);
                        who->set_skill("lotusmove",temp);
                        who->set_skill("lunhui-zhang",temp);
                        who->set_skill("staff",temp);
                        break;
                }
                                case "轩辕古墓":
                {
                        who->set_skill("fox-hand",temp);
                        who->set_skill("huxing-step",temp);
                        who->set_skill("needle",temp);
                        who->set_skill("tianyi-zhen",temp);
                        who->set_skill("xuanhu-shentong",temp);
                        who->set_skill("xuanhu-xinfa",temp);
                        who->set_skill("xuanhu-blade",temp);
                        break;
                }

                case "方寸山三星洞":
                {
                        who->set_skill("stick",temp);
                        who->set_skill("dao",temp);
                        who->set_skill("jindouyun",temp);
                        who->set_skill("puti-zhi",temp);
                        who->set_skill("qianjun-bang",temp);
                        who->set_skill("wuxiangforce",temp);
                        break;
                }
                case "五庄观":
                {
                        who->set_skill("hammer",temp);
                        who->set_skill("baguazhen",temp);
                        who->set_skill("kaishan-chui",temp);
                        who->set_skill("taiyi",temp);
                        who->set_skill("wuxing-quan",temp);
                        who->set_skill("zhenyuan-force",temp);
                        break;
                }
                case "东海龙宫":
                {
                        who->set_skill("fork",temp);
                        who->set_skill("fengbo-cha",temp);
                        who->set_skill("dragonfight",temp);
                        who->set_skill("dragonforce",temp);
                        who->set_skill("dragonstep",temp);
                        who->set_skill("seashentong",temp);
                        break;
                }
                case "大雪山":
                {
                        who->set_skill("throwing",temp);
                        who->set_skill("bainiao-jian",temp);
                        who->set_skill("dengxian-dafa",temp);
                        who->set_skill("ningxie-force",temp);
                        who->set_skill("xiaoyaoyou",temp);
                        who->set_skill("cuixin-zhang",temp);
                        break;
                }
                case "盘丝洞":
                {
                        who->set_skill("whip",temp);
                        who->set_skill("jiuyin-xinjing",temp);
                        who->set_skill("lanhua-shou",temp);
                        who->set_skill("pansi-dafa",temp);
                        who->set_skill("qingxia-jian",temp);
                        who->set_skill("yinsuo-jinling",temp);
                        who->set_skill("yueying-wubu",temp);
                        break;
                }
                case "阎罗地府":
                {
                        who->set_skill("stick",temp);
                        who->set_skill("ghost-steps",temp);
                        who->set_skill("gouhunshu",temp);
                        who->set_skill("jinghun-zhang",temp);
                        who->set_skill("kusang-bang",temp);
                        who->set_skill("tonsillit",temp);
                        break;
                }
                case "将军府":
                {
                        who->set_skill("archery",temp);
                        who->set_skill("mace",temp);
                        who->set_skill("baguazhou",temp);
                        who->set_skill("spear",temp);
                        who->set_skill("bawang-qiang",temp);
                        who->set_skill("changquan",temp);
                        who->set_skill("lengquan-force",temp);
                        who->set_skill("wusi-mace",temp);
                        who->set_skill("xuanyuan-archery",temp);
                        who->set_skill("yanxing-steps",temp);
                        break;
                }
                case "盱眙山":
                {
                        who->set_skill("halberd",temp);
                        who->set_skill("fumozhou",temp);
                        who->set_skill("guiyuanforce",temp);
                        who->set_skill("lianhuan-tui",temp);
                        who->set_skill("tianlong-halberd",temp);
                        who->set_skill("tianwei-shi",temp);
                        break;
                }
case "火云洞":
                {
                        who->set_skill("spear",temp);
                        who->set_skill("stick",temp);
                        who->set_skill("huoyun-qiang",temp);
                        who->set_skill("huomoforce",temp);
                        who->set_skill("moshenbu",temp);
                        who->set_skill("moyun-shou",temp);
                        who->set_skill("pingtian-dafa",temp);
                        break;
                }
case "蜀山派":
                {
                        who->set_skill("shushan-force",temp);
                        who->set_skill("xianfeng-spells",temp);
                        who->set_skill("yujianshu",temp);
                        who->set_skill("zuixian-steps",temp);
                        break;
                }
case "三界山":
                {
                        who->set_skill("huntianforce",temp);
                        who->set_skill("huxiaojian",temp);
                        who->set_skill("tianmogong",temp);
                        who->set_skill("zhaoyangbu",temp);
                        break;
                }                
                default:
                {
                tell_object(who,HIY"好像那里不对，快去找巫师说。\n");
                break;
                }

        }
        if (who->query("force",1)>99)
        {
                who->set("门派/gift","got"); 
                tell_object(who,HIR"木马"NOR+"告诉你:你得到了门派奖励！\n"NOR);
                command("chat* "+this_object()->query("name")+"：" + who->query("name") + "，得到了门派技能奖励！\n");
         }

        return 1;      
}
