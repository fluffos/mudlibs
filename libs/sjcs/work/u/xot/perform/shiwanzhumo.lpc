// shiwanzhumo.c 十万诸魔
// last updated by xueyi 9.8.2002

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
         string msg,str;
         int extra;
         int i;
         object weapon;
         if( !target ) target = offensive_target(me);
         if( !target || !target->is_character() || !me->is_fighting(target) )
                   return notify_fail("十万诸魔只能对战斗中的对手使用。\n");
         if(me->query("family/family_name")!="陷空山无底洞")
                   return notify_fail("“十万诸魔”只有陷空山无底洞之人才可以用！\n");
         if(me->query("wudidong/mojie")!="zhong")
                   return notify_fail(HIY"你入魔道不深，尚未领悟魔界精髓！\n"NOR);
         weapon = me->query_temp("weapon");
         if( (string)weapon->query("skill_type") != "blade" )
                   return notify_fail("你手上无刀，不能使用十万诸魔！\n");
         if( (int)me->query("force") <= 1000 )
                   return notify_fail("你内力不够，不能使用十万诸魔！\n");
         if(me->query("force_factor")>120) 
                   return notify_fail(HIW"十万诸魔重招不中力！运力太巨，你使不了这么精妙的刀法！\n"NOR);
         extra = me->query_skill("kugu-blade",1) / 4;
         me->add_temp("apply/attack", extra);
         me->add_temp("apply/damage", extra);
         msg = HIW  "$N使出［枯骨刀法］的十万诸魔，手中的"+ weapon->name() +"斜斜挥出，十万诸魔齐出！！！\n" NOR;
         message_vision(msg, me, target);
         COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
         msg = HIW  "$N凝聚起魔人神三界十万妖魔的无边力量，一式－十－万－诸－魔 －如急电般劈向$n！\n" NOR;
         message_vision(msg, me, target);
         COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
         msg = HIR BLINK "|-----十-----|"NOR + HIC"$N手中"+ weapon->name()+  "幻出奇异的光华刺向$n！\n" NOR;
         message_vision(msg, me, target);
         COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
         msg = HIR BLINK  "|-----万-----|"NOR + HIC"$N手中"+ weapon->name()+  "发出摄人心魄的呼啸向$n劈去！\n" NOR;
         message_vision(msg, me, target);
         COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
         msg = HIR BLINK  "|-----诸-----|"NOR + HIC"$N手中"+ weapon->name()+  "竟然发出妙不可言的奇香扑向$n！\n" NOR;
         message_vision(msg, me, target);
         COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
         msg = HIR BLINK  "|-----魔-----|"NOR + HIC"$N手中"+ weapon->name()+  "刀光连闪，一阵阵魔光扑向$n！\n" NOR;
         message_vision(msg, me, target);
         COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
         msg = HIW BLINK  "              山雨欲来风满楼！十万诸魔齐呼啸！\n" NOR;
         message_vision(msg, me, target);
         COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg); 
         msg = HIC  "十万诸魔齐在云端隐现，$N手中"+ weapon->name()+  "鬼神莫测已然到了$n的眼前！\n" NOR;
         message_vision(msg, me, target);
         COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);        
         if (target->query("eff_kee")<0 || !living(target))  
            {str=target->name()+"被"+""HIW""+me->name()+""HIM""+"用蚀日鼠魔绝招『"HIC"十万诸魔"HIM"』杀死了。";
//                   message("channel:rumor",HIM"【"HIW"空穴来风"HIM"】某人："+str+"\n"NOR,users());
	               }
         me->add_temp("apply/attack", -extra);
         me->add_temp("apply/damage", -extra);
         me->start_busy(random(2) + random(2) + random(2));
         return 1;
}
