//针神.c by 
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
        object weapon;
        string str;
            if(!target) target = offensive_target(me);
            if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「神针」？\n");

         if(me->query("family/family_name")!="轩辕古墓")
                return notify_fail("「神针」只有轩辕古墓才可以用！\n");

         if(!me->is_fighting())
                return notify_fail("「神针」只能在战斗中使用！\n");
        
//        if(me->query("pansidong/jueqing_perform")!=1)
//                return notify_fail("你还没领会「神针」！\n");
          if( time()-(int)me->query_temp("pfm_end") < 2 )
          return notify_fail("你现在「神针」刚用毕，等会儿再用吧！\n");

        if((int)me->query("max_force") < 500)
                     return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不足！\n");

         if((int)me->query("sen") < 250)
                return notify_fail("你的精神不足，没法子施用外功！\n");

         if((int)me->query_skill("tianyi-zhen",1) < 100)
                return notify_fail("你的天一神针级别还不够，无法使用「神针」!\n");

        weapon=me->query_temp("weapon");
            message_vision(HIW"\n$N运足精神，抖手刺出一针，"+weapon->query("name")+"化作四道光芒直射$n!\n"NOR, me, target);
            message_vision(HIR"\n$N一式「马嵬坡下泥土中，不见玉颜空死处」，脚踏「巽」位！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, weapon);
        COMBAT_D->do_attack(me, target, weapon);
            message_vision(HIG"\n$N一式「楼阁玲珑五云起，其中绰约多仙子」，占住「兑」位！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, weapon);
        COMBAT_D->do_attack(me, target, weapon);
            message_vision(HIC"\n$N一式「在天愿作比翼鸟，在地愿为连理枝」，连踏「乾」「坤」二位！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, weapon);
        COMBAT_D->do_attack(me, target, weapon);
            message_vision(HIB"\n$N一式「天长地久有时尽，此恨绵绵无绝期」，由「坤」向「乾」疾退！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, weapon);
        COMBAT_D->do_attack(me, target, weapon);
         if (target->query("eff_kee")<0 || !living(target))  
 {str=target->name()+""HIM"被"HIW""+me->name()+""HIM"用轩辕古墓绝招「神针」杀死了。听说尸体的有几个深深针孔！";
 //                        message("channel:rumor",HIM"【"HIW"空穴来风"HIM"】某人："+str+"\n"NOR,users());
}
        me->receive_damage("sen", 100);
        me->add("force", -200);

            if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                        }
        }
        me->set_temp("pfm_end",time());
        return 1;
}
