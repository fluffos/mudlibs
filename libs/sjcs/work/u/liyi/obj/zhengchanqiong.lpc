// LLY@FYSY 


#include <weapon.h>
#include <ansi.h>
inherit SPEAR;

void create()
{
        set_name(HIB "震苍穹" NOR, ({ "zhengchanqiong" ,"spear" ,"qiang" ,}) );
        set_weight(13000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "如来神掌第八式佛法无边护法佛兵。\n");
                set("value", 200000);
                set("material", "blacksteel");
        }
        init_spear(140);
        set("wield_msg","$N双手一分，从背后解下$n握到手中．\n");
        set("unwield_msg", "$N将手中的$n系到背后．\n");
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        victim->receive_damage("sen",dam/50);
        victim->receive_damage("kee",dam/50);
        return HIB "身行急转，现出如来法相点出佛法无边。\n" NOR;
}

