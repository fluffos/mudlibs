// LLY@FYSY 


#include <weapon.h>
#include <ansi.h>
inherit WHIP;

void create()
{
        set_name(HIM "破红尘" NOR, ({ "pohongchen" ,"whip" ,"bian" ,}) );
        set_weight(13000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "如来神掌第七式天佛降临护法佛兵。\n");
                set("value", 200000);
                set("material", "leather");
        }
        init_whip(140);
        set("wield_msg", "$N左手轻扬，$n忽地甩了出来\n");
        set("unwield_msg", "$N把手中$n缠回腰间．\n");
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        victim->receive_damage("sen",dam/50);
        victim->receive_damage("kee",dam/50);
        return HIM "身行急转，现出如来法相手结金刚橛印甩出一式天佛降临。\n" NOR;
}

