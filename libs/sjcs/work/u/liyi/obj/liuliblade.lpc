// LLY@FYSY 


#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create()
{
        set_name(MAG "琉璃戒刀" NOR, ({ "liuliblade" ,"blade" ,"dao" ,}) );
        set_weight(13000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "如来神掌第二式金顶佛灯护法佛兵。\n");
                set("value", 200000);
                set("material", "wood");
        }
        init_blade(140);
        set("wield_msg", "没有人能看得见$N拔刀的动作，$N的$n忽然间就已经闪电般拔出。。\n");
        set("unwield_msg", "$N将$n收回刀鞘里。\n");
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        victim->receive_damage("sen",dam/50);
        victim->receive_damage("kee",dam/50);
        return MAG "身行急转，现出如来法相手结光聚佛顶印劈出一式金顶佛灯。\n" NOR;
}

