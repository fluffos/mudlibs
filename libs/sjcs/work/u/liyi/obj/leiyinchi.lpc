// LLY@FYSY 


#include <weapon.h>
#include <ansi.h>
inherit MACE;

void create()
{
        set_name(HIW "雷音尺" NOR, ({ "leiyinchi" ,"mace" ,"jian" ,}) );
        set_weight(13000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "如来神掌第四式佛问迦蓝护法佛兵。\n");
                set("value", 200000);
                set("material", "wood");
        }
        init_mace(140);
        set("wield_msg", "$N操起一根$n，摆了个架式。\n");
        set("unwield_msg", "$N将$n别回腰间。\n");
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        victim->receive_damage("sen",dam/50);
        victim->receive_damage("kee",dam/50);
        return HIW "身行急转，现出如来法相手结天鼓雷音印使出一式佛问迦蓝。\n" NOR;
}

