// LLY@FYSY 


#include <weapon.h>
#include <ansi.h>
inherit FORK;

void create()
{
        set_name(CYN "碧海叉" NOR, ({ "bihaicha" ,"fork" ,"cha" ,}) );
        set_weight(13000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "四海宝物碧海宝叉。\n");
                set("value", 200000);
                set("material", "iron");
        }
        init_fork(150+random(50));
        set("wield_msg", "$N抄起一柄$n，还拿衣服擦了擦叉尖。\n");
        set("unwield_msg", "$N放下手中的$n。\n");
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        if (random(100)>40)
        {dam = (int) me->query("force");
        victim->receive_damage("sen",dam/75);
        victim->receive_damage("kee",dam/75);
        return CYN "碧波浪涌海潮似要淹没万物!\n" NOR;
}
else
return 1;
}

