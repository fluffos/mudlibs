// LLY@FYSY 


#include <weapon.h>
#include <ansi.h>
inherit STICK;

void create()
{
        set_name(HIY "万华金龙夺" NOR, ({ "jinlongduo" ,"stick" ,"bang" ,}) );
        set_weight(13000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "如来神掌第一式佛光初现护法佛兵。\n");
                set("value", 200000);
                set("material", "steel");
        }
        init_stick(150+random(50));
        set("wield_msg", "$N「呼」地一声抽出一把$n握在手中。\n");
        set("unwield_msg", "$N哼了一声，将$n插回后腰。\n");
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        if (random(100)>40)
       { dam = (int) me->query("force");
        victim->receive_damage("sen",dam/50);
        victim->receive_damage("kee",dam/50);
        return HIY "身行急转，现出如来法相手结一心印使出一式佛光初现。\n" NOR;
}
else
return 1;
}
