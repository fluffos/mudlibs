#include <weapon.h>
#include <ansi.h>
inherit NEEDLE;

void create()
{
        set_name(HIR "仙鹤神针" NOR, ({ "xianheshenzhen" ,"zhen" ,"needle" ,}) );
        set_weight(13000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("long", "当年武林中的一件至宝。\n");
                set("value", 200000);
                set("material", "steel");
        }
        init_needle(150+random(50));
        set("wield_msg", "$N捻起一根$n，握在手中当武器。\n");
        set("unwield_msg", "$N将手中的$n放下。\n");
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        if (random(100)>40)
        {dam = (int) me->query("force");
        victim->receive_damage("sen",dam/75);
        victim->receive_damage("kee",dam/75);
                return HIR "无数血色仙鹤在$n旁飞舞。\n" NOR;
}
else
return 1;
}


