#include <weapon.h>
#include <ansi.h>

inherit NEEDLE;
inherit F_UNIQUE;

void create()
{
        set_name("神木针",({ "shenmu zhen", "zhen", "needle" }) );
        set_weight(20000);
if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 0);
                set("rigidity", 9);
                set("sharpness", 9); 
                set("no_get", 1);
                set("material", "steel");
                set("weapon_prop/dodge", -5);
                set("weapon_prop/parry", 5); 
                set("wield_neili", 300);
                set("wield_maxneili", 700);
                set("wield_str", 22);
                set("wield_msg", HIW"$N“唰”的一声抽出一根神木针。\n"NOR);
                set("long", "这是一根神木针。\n");                
                set("unwield_msg", HIW "神木针幻作一道白光，「唰」地飞入腰间。\n" NOR);                
}
        init_needle(120);
        setup();
}

