#include <weapon.h>
#include <ansi.h>

inherit WHIP;
inherit F_UNIQUE;
void create()
{
        set_name("白铜鞭",({ "baitong bian", "bian", "whip" }) );
        set_weight(10000);
    if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 0);
                set("treasure",1);
                set("rigidity", 1);
                set("sharpness", 1);
                set("unique", 1);
                set("weapon_prop/dodge", -2);
                set("weapon_prop/parry", 1);        
                set("material", "steel");
                set("long", "这是把白铜鞭，枪身上隐隐的透出白光，当真锋利无比。\n");
                set("wield_msg", HIW "只听见「嗡」地一声，白光闪现，$N将腰间解下的$n抖得笔直。\n" NOR);
                set("unwield_msg", HIW "白铜鞭幻作一道白光，「唰」地飞入腰间。\n" NOR);
                set("unequip_msg", HIW "白铜鞭幻作一道白光，「唰」地飞入腰间。\n" NOR);
}
        init_whip(40);
        setup();
}

