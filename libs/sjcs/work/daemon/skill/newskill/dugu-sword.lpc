//TIE@FY3
inherit SKILL;
mapping *action = ({
        ([      "action":               
"$N抱剑旋身，转到$n身后，杂乱无章地向$n刺出一剑，不知使的是什么剑法！",
                "force" :               50,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N身行飘拂，如烟似云，手中长剑无声无息已然刺至$n的$l！",
                "force":               50,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N身行突转凝滞，手中长剑如有千斤向$n慢慢推去，但重剑无锋、大巧不工之意尽在其中！",
                "force":               50,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N举剑狂挥，迅速无比地点向$n的$l，却令人看不出其所用是什么招式！",
                "force":                90,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N剑意突焕气象森严，便似千军万马奔驰而来，长枪大戟，黄沙千里，剑势击向$n的$l！",
                "force":               100,
                "damage_type":  "刺伤"
        ]),

});

int valid_learn(object me)
{
        object ob;
        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练剑法。\n");

        if( (int)me->query("max_force") < 300 )
                return notify_fail("你的内力不够，没有办法练独孤九剑。\n");

        if( (string)me->query_skill_mapped("force")!= "wuzheng-force")
                return notify_fail("独孤九剑必须配合无争心法才能练。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return notify_fail("你的内力或气不够，没有办法练习独孤九剑。\n");

        if( (string)me->query_skill_mapped("force")!= "wuzheng-force")
                return notify_fail("独孤九剑必须配合无争心法才能练。\n");

        me->receive_damage("kee", 30);
        me->add("force", -3);
        write("你按著所学练了一遍独孤九剑。\n");
        return 1;
}

 
int effective_level() { return 20;}

string *parry_msg = ({
        "$n剑挟刀势，大开大阖地乱砍一通，但招招皆击在$N攻势的破绽，迫得$N不得不守！\n",
        "$n手中的$v光芒陡长，剑光自远而近，荡开了$N的$w。\n",

});

string *unarmed_parry_msg = ({
        "$n用手中的$v带得$N脚步踉跄，封住了$N的攻势。\n",
        "$n剑挟刀势，大开大阖地乱砍一通，但招招皆击在$N攻势的破绽，迫得$N不得不守！\n",
        "$n将手中的$v一抖，一招「野渡无人」，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus()
{
        return -150;
}
int practice_bonus()
{
        return -300;
}
int black_white_ness()
{
        return 10;
}
string perform_action_file(string action)
{
        return CLASS_D("bianfu") + "/dugu-sword/" + action;
}
