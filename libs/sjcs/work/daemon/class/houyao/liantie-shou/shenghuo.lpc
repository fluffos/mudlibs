 
#include <ansi.h>

inherit F_DBASE;
inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
        int skill;

       string msg,str; 

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展「圣火令」?\n");
        if(me->query_temp("BAIGU_perform")) 
                return notify_fail("你已经使出「圣火令」了！\n");
        if( time()-(int)me->query_temp("BAIGU_end") < 4 )
                return notify_fail("绝招用多就不灵了！\n");

        if(!me->is_fighting(target) )
                return notify_fail("圣火令只能在战斗中使用!!\n");

        if((int)me->query("max_force") <1000 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") <50 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("liantie-shou",1) <300)
                return notify_fail("你的炼铁手级别还不够施展这一招圣火令!!\n");
        if((int)me->query_skill("unarmed",1) <100)
                return notify_fail("你的格斗扑击之术等级不够!!\n");

        me->delete("env/brief_message");
        target->delete("env/brief_message");
        weapon=me->query_temp("weapon");
     msg = RED
"\n$N默念炼铁心经，使出炼铁手掌绝学"HIR"「圣火令」"HIR"，在一片火光中逼向$n!\n" NOR;
    message_vision(msg, me, target);

        skill = me->query_skill("liantie-shou");
        me->set_temp("BAIGU_perform", 1);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->delete_temp("BAIGU_perform");
        me->set_temp("BAIGU_end",time());
            if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))  
                       {str=target->name()+HIR"被"+me->name()+"用欧冶子密传"NOR+HIR"「圣火令」"+RED"烧死了！";
                         message("channel:rumor",HIR"【空穴来风】某人："+str+"\n"NOR,users());
                       }
        me->add("force", -200);
        return 1;
}


