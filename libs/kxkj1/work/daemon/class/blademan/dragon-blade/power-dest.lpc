#include <combat.h>

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int hit = 0;
  int damage;

  if (!target) target = offensive_target(me);
  if (me->query_skill("dragon-blade", 1) < 100 - me->query("con") * 1.5)
    return notify_fail("你的狂龙刀法火喉不够，没办法用狂龙怒斩。\n");
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("狂龙怒斩只能在战斗中使用。\n");

  if (me->query("force") < 250)
    return notify_fail("你的内力不够。\n");
  if (me->query("kee") < 200)
    return notify_fail("你的气不够。\n");

  msg = HIY "$N将刀气及怒气会聚，一招「狂龙怒斩”刀气如狂龙般撞向$n\n" NOR;

  me->start_busy(1);
  if (random(me->query_skill("blade")) > random(target->query_skill("dodge") + target->query_skill("parry"))) {
    msg += YEL;
    msg += "$n闪躲不及，刀气贯穿了$n的身体。\n" NOR;
    write(HIY "    远处传来隆隆巨响！！\n\n    " + me->name() +
      "的狂龙怒斩贯穿了" + target->name() + "身躯．．．\n\n" NOR);
    damage = me->query_skill("force") + me->query("bellicosity") / 8;
    damage = random(damage / 2) + damage / 2;
    target->receive_wound("kee", damage);
    me->add("kee", -20);
    me->add("force", -250);
    hit = 1;
  } else {
    msg += YEL "$n在危急时刻猛然一闪，躲开了刀气。\n" NOR;
    me->add("force", -250);
  }
  message_vision(msg, me, target);
  if (hit == 1) COMBAT_D->report_status(target);
  return 1;
}
