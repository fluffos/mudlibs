// kee-wind.c

#include <ansi.h>
inherit F_FUNCTION;
inherit SSERVER;

int perform(object me, object target) {
  string msg;
  object ob;
  string *name;

  if (!target) target = offensive_target(me);

  if (me->query_skill("snow-martial", 1) < 20)
    return notify_fail("你的雪苍武学程度不够，无法使用御气成风绝技。\n");
  if (!me->is_fighting()) {
    tell_object(me, "御气成风要在战斗中才能使用。\n");
    return 1;
  }
  if (me->query("family/family_name") != "雪苍派")
    return notify_fail("这种武功\只有雪苍派的门人才可以使用。\n");
  if (query_function("kee-wind") * 10 + 50 > me->query("force"))
    return notify_fail("你的内力不够。\n");
  message_vision(
    HIC "$N盘坐在地上，开始运起雪苍武学中" + HIY + "「御气成风”" + HIC + "的功\夫。\n$N将体内的真气运出，随即运起「成风诀”～～～\n", me, target);
  message_vision(
    HIR "\n突然间～～狂风大作～～形成一股旋风～～\n", me, target);

  if (query_function("kee-wind") >= 30 - me->query("int") / 3) {
    message_vision(
      HIY "一阵强光耀眼，一颗气弹往$n射去！\n", me, target);
    me->start_busy(1);
    me->receive_wound("kee", 50);
    if (random(query_function("kee-wind") * 6) > random(target->query_skill("dodge") + target->query_skill("parry"))) {
      message_vision("$n不及反应，被气弹打中，掀起一阵狂爆，把$n弹了出去！\n\n", me, target);
      message_vision(NOR, me);
      target->receive_wound(
        "kee",
        me->query_skill("snow-martial", 1) + random(me->query_skill("snow-martial", 1) * 3)
      );
      COMBAT_D->report_status(target);
    } else
      message_vision(
        "$n拼死地跳开来，只见气弹打在地上，发出隆隆巨响。\n", me, target);
  } else if (query_function("kee-wind") >= 10 - me->query("int") / 2) {
    message_vision(
      HIG "$N所造出的强风将$n卷住，使$n无法动弹！\n", me, target);
    target->start_busy(random(4));
  } else {
    message_vision(
      HIC "可惜$N功\力不够，旋风逐渐散去。\n", me, target);
    if (me->query("force") < 0) me->set("force", 0);
  }
  me->add("force", -50 - 10 * query_function("kee-wind"));
  if (query_function("kee-wind") * 3 < me->query_skill("snow-martial", 1))
    function_improved("kee-wind", random(me->query("force") / 10));

  message_vision(NOR, me);
  return 1;
}
