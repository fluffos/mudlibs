// powerup.c
// wade 改过, 原先检查是否 enforceup 是用 set("enforceup",1) 设定
//	改成 set_temp("enforceup",1)
// wade fixed in 5/23/1996

#include <ansi.h>
inherit F_FUNCTION;
inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target)
{
	int skill;

          if( target != me ) return notify_fail("你只能用雪苍神功\提升内力威力。\n");

	if (me->query("force") < 50+query_function("enforceup")*5)
	  return notify_fail("你的内力不够，不能使用凝气诀。\n");
	if(me->query_temp("enforceup")) return notify_fail("你已经在用了。\n");
	// 旧的是用 set("enforceup") 设定, 所以砍掉
	me->delete("enforceup");
	skill = query_function("enforceup")/3;

	me->add("force",-5*query_function("enforceup")-50);
	me->set_temp("enforceup",1);
        message_vision(
	HIY "$N运起凝气诀，将体内真气凝聚，使内劲为之大增。\n" NOR,me);
	me->add("force_factor",skill*2);

	skill*=5;
	me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/2 :), skill);

	if( me->is_fighting() ) me->start_busy(3);
	if(query_function("enforceup")*3<me->query_skill("snowforce",1))
	function_improved("enforceup",random(me->query("force")/10));
	return 1;
}

void remove_effect(object me, int amount)
{
	me->set_temp("enforceup",0);
        me->set("force_factor",10);
        tell_object(me,"你体内的真气开始散开了。\n");
}
