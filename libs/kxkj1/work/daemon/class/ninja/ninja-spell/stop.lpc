// 定身术(write bye cyw)

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg;
  int ap;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("一阵白光后什么也没发生\n");

  if ((int)me->query("mana") < 25)
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 10)
    return notify_fail("你的精神没有办法有效集中！\n");

  me->add("mana", -25);
  me->receive_damage("sen", 10);

  if (random(me->query("max_mana")) < 50) {
    write("你失败了。\n");
    return 1;
  }
  msg = HIW "\n\n$N口中喃喃地唸着咒文‘罗~天~藏~翩~~~~定’\n\n" NOR;

  ap = me->query_skill("ninja-spell");
  target->start_busy(ap / 10 + 1);
  msg += "四周白光亮起,$n的身体被$N给定住了！\n\n";

  message_vision(msg, me, target);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
    me->kill_ob(target);
  }
  me->add("mana", -25);
  me->start_busy(1);
  return 1;
}
