// 毁灭术(write bye cyw)

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg;
  int wk;
  wk = random(1 + 5);
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你想了想好像咒语念错了\n");

  if ((int)me->query("mana") < 200)
    return notify_fail("你的法力还不足化为火球！\n");

  if ((int)me->query("sen") < 10)
    return notify_fail("你的精神没有办法有效集中！\n");

  me->add("mana", -25);
  me->receive_wound("sen", 10);

  if (random(me->query("max_mana")) < 200) {
    write("你失败了。\n");
    return 1;
  }
  if (wk == 1 || wk == 5) {
    message_vision(HIY "\n\n\n$N指着$n狠狠的说道:一起到地狱去吧....哈哈哈!\n" NOR, me, target);
    message_vision(HIW "\n\n只见$N往后一跳开始悲痛地唸起咒文‘天~地~骤~恨~~~~灭’!\n" NOR, me, target);
    message_vision(HIR "\n\n最后$N全身燃烧化为一团火球往$n直奔而去！\n\n\n" NOR, me, target);
    target->die();
    me->add("max_mana", -150);
    me->add("mana", -150);
    me->die();
    return 1;
  }
  if (wk == 2) {
    message_vision(HIY "\n\n\n$N指着$n狠狠的说道:一起到地狱去吧....哈哈哈!\n" NOR, me, target);
    message_vision(HIW "\n\n就在$N念着咒文的同时,天空降下一阵七色光芒罩住$n的全身\n" NOR, me, target);
    message_vision(HIM "\n\n你化为一团火球往$n直奔而去,但大半的力量都被七色光罩所化解\n" NOR, me, target);
    message_vision(HIR "\n\n没想到连老天都帮着$n,$N真是含恨而死阿!\n\n\n" NOR, me, target);
    target->add("kee", -(target->query("kee") - 4 + random(3 + 6)));
    me->add("max_mana", -50);
    me->add("mana", -50);
    me->die();
    return 1;
  }
  if (wk == 3) {
    message_vision(HIY "\n\n\n$N指着$n狠狠的说道:一起到地狱去吧....哈哈哈!\n" NOR, me, target);
    message_vision(HIW "\n\n由于$N没有必死的决心,导致咒文的威力大减\n" NOR, me, target);
    message_vision(HIR "\n\n最后$N化为一团火球往$n直奔而去,一阵撞击后大地恢复了平静!\n\n\n" NOR, me, target);
    target->add("kee", -(target->query("kee")));
    me->add("kee", -(me->query("kee")));
    me->add("max_mana", -100);
    me->add("mana", 100);
    return 1;
  }
  if (wk == 4) {
    message_vision(HIY "\n\n\n$N指着$n狠狠的说道:一起到地狱去吧....哈哈哈!\n" NOR, me, target);
    message_vision(HIW "\n\n只见$N专心的念着咒文‘天~地~骤~恨~~~~灭’!\n" NOR, me, target);
    message_vision(HIC "\n\n最后$N化为一团火球往$n直奔而去,一阵撞击后大地恢复了平静!\n\n\n" NOR, me, target);
    target->die();
    me->add("kee", -(me->query("kee")));
    me->add("max_mana", -170);
    me->add("mana", -170);
    return 1;
  }
}
