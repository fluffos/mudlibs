#include <ansi.h>

int perform(object me, string arg) {
  int lv;
  seteuid(getuid());
  lv = F_MAGIC->query_magic(me, "gather");
  if (me->query("atman") < 100)
    return notify_fail("你的灵力不够，不能用火邪大法。\n");
  if (F_MAGIC->query_magic(me, "fire") > 0)
    return notify_fail("因为你已经学会来火邪大法，所以不能练万法归宗。\n");
  message_vision(
    HIY "$N盘坐在地上，施展出「万法归宗”，吸收大地精气！\n" NOR, me);
  message_vision(
    HIC "过了一会，$N站了起来，吐了一口气，精气神各方面恢复了不少。\n" NOR, me);
  me->receive_heal("gin", random(lv * 2));
  me->receive_heal("kee", random(lv * 2));
  me->receive_heal("sen", random(lv * 2));
  me->add("atman", -100);
  F_MAGIC->add_magic(me, "gather", random(me->query("spi")));
  return 1;
}
