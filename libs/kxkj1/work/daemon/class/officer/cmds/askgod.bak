//  made by ccat
#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_GUILDCMDS;

int main(object me, string arg)
{
  object obj,aim,objj;
  int skill,i,kee,report=0;
  string str,name;
  
  if( me->query("sen") < 30 ) return notify_fail("你的神不足.\n");
  if(me->is_fighting())  return notify_fail("战斗中无法占卜。\n");

  if( !arg )
    return notify_fail("指令格式：cmd askgod <id>\n");

  arg = lower_case(arg);

  if( !objectp(obj = present(arg, environment(me))) )
    return notify_fail("你想对谁占卜?\n");

  if( !obj->is_character() || obj->is_corpse() || obj->query_temp("netdead") )
    return notify_fail("那并不是活物。\n");

  skill = me->query_skill("security",1);
  skill = random(skill);
  me->receive_damage("sen",30,me);
  i = random(4);
  aim = me;
  if(i) aim = obj;
  name = aim->query("name");
  i = random(9);
  switch(i)
  {
    case 0:
    case 1:
    case 2:
      report=1;
      kee = aim->query("max_kee");  
      if( skill < 15)
      {
          str="突然间 "+name+" 开始上吐下泻,似乎昨晚不小心吃坏肚子了";
          kee = kee*0.2; 
       }else if( skill < 25)
       {
          str="突然间 "+name+"脸色一阵青一阵白,似乎内息走插了";
          kee = kee*0.4;
       }else if( skill < 45)
       {
          str="突然间平地一声雷起,一道闪电击中"+name;
          kee = kee*0.6;
       }else if( skill < 80)
       {
          str=name+" 途然嘴巴一歪,显然是中风了";
          kee = kee*0.8;
       }else{
          str="唉!!... "+name+"显然活不过今晚";
          kee = kee*0.95;
       }
       aim->receive_damage("kee",kee,me);
       break;
    case 3:
    case 4:
    case 5:
       if( skill < 30)
       {  
          str=name+"身上突然燃起熊熊烈火,显然是作孽太多了";
          aim->apply_condition("burn",(int)skill/6);
       }else if( skill<60 ){
          str=name+"突然掩住下部,看似发春了";
          aim->apply_condition("spring",(int)skill/10);
       }else{
          str="途然大地分裂,一阵黑火从地底冒出,燃烧着 "+name;
          aim->apply_condition("hellfire",(int)skill/10);
       }
       break;
    case 6:
    case 7:
       str=name+" 途然像狗一样趴在地上,原来是捡到了钱";
       objj=new("/obj/money/silver");
       objj->move(aim);
       objj->add_amount(skill);
       break;
    case 8:
         str="看样子明天是晴天";
  }
  message_vision("$N\摆\起神案,对着$n开始占卜...\n"+
                 str+"!!\n",me,obj);
  if( report)
     COMBAT_D->report_status(aim, 0);
  return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : cmd askgod <人物>
指令说明 : 
           这个指令让你对某人占卜,但无法预知是福是祸.
           治安策越高,造成的影响越大.
HELP
    );
    return 1;
}
 
