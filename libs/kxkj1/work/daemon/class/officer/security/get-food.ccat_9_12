#include <ansi.h>
void get_dumpling(object me);
int do_command(object me,object ob,string arg)
{
	int i;
	if(ob->query("officer_type")!="food")
	{
		tell_object(me,"他不是伙食官。\n");
		return 1;
	}
	message_vision(
	CYN "$N说道：我需要粮食，马上给我准备。\n" NOR,me);
	message_vision(
	CYN "$N说道：大人这是您要的粮食。\n$N拿了些粮食给$n。\n" NOR,ob,me);
	for(i=0;i<5;i++)
		get_dumpling(me);
	return 1;
}
void get_dumpling(object me)
{
	object obj;
	seteuid(getuid());
	obj=new("/obj/example/dumpling");
	obj->move(me);
}
