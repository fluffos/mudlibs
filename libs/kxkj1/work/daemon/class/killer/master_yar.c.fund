#include <ansi.h>
#include "/open/open.h"
inherit NPC;
inherit F_MASTER;
string to_kill();
string ask_blade()
{
	object ob;
	if( present("ghost blade",this_player()) ) return " ?";
	if( !this_player()->query("quests/to-kill") ) return " ?";
	ob = new("/open/snow/obj/ghost-blade");
	ob->move(this_player());
	message_vision("$N给$n一把幽灵魔刀。\n",this_object(),this_player());
	return "hmm ...";
}
void create()
{
	object ob;
	set_name("叶秀杀",({"master yar","yar"}));
	set("long","他是名震江湖的一代杀手，黑牙联的头目。\n");
	set("gender","男性");
	set("class","killer");
	set("nickname","杀眼无情");
          set("combat_exp",1000000);
          set("attitude","heroism");
	set("age",26);
		set("str", 44);
		set("cor", 24);
		set("cps", 18);
		set("per", 24);
		set("int", 42);
	set("force",1500);
	set("max_force",1500);
	set("max_kee",1100);
	set("kee",1100);
	set_skill("array",60);
	set_skill("rain-throwing",100);
	set("no_ask",1);
	set_skill("blade",50);
	set_skill("cure",40);
	set_skill("dagger",90);
	set_skill("literate",50);
	set_skill("dodge",60);
	set_skill("force",50);
	set_skill("move",100);
	set_skill("parry",60);
	set_skill("poison",60);
	set_skill("sword",60);
	set_skill("throwing",100);
	set_skill("shade-steps",100);
	map_skill("throwing","rain-throwing");
	map_skill("dodge","shade-steps");
	set_skill("blackforce",90);
	map_skill("force","blackforce");
	set("inquiry",([
	"追杀令" : (: to_kill :),
	"幽灵魔刀" : (: ask_blade :),
	]));
	set("force_factor",10);
	setup();
	create_family("黑牙联",2,"主席");
	ob=carry_object("/open/snow/obj/hate_knife");
	ob->set_amount(100);
	ob->wield();
}

void init()
{
	add_action("do_join","join");
}
string to_kill()
{
	object ob;
	if( this_player()->query("quests/to-kill") ) {
		command("?");
		return ".....";
	}
	if( present("letter",this_player() ) ){
		command("?");
		return " ....";
	}
	command("look "+this_player()->query("id"));
	command("hmm");
	ob = new(__DIR__"letter");
	ob->move( this_player() );
	message_vision("$N递给$n一封密函。\n",this_object(),this_player());
	return ".....";
}
  void attempt_apprentice(object ob)
{
	command("l "+ob->query("id"));
	if(this_player()->query("cor")<20)
	{
		command("sigh "+ob->query("id"));
		command("shake");
		return;
	}
	command("smile");
	command("nod");
	command("recruit "+ob->query("id"));
}
int accept_fight(object ob)
{
	command(":D");
	message_vision( this_object()->name()+"脸上一副鄙视的样子。\n",ob);
	return 1;
}
int accept_kill(object ob)
{
	message_vision( this_object()->name()+"突然变脸，脸上出现杀气。\n",ob);
	this_object()->set("bellicosity",3000);
        command("cmd bellup");
	return 1;
}
int do_join()
{
	object ob=this_player();
	if(!ob->query("class"))
	{
		ob->set("class","killer");
		command("nod "+ob->query("id"));
	}
	else
	{
		command("shake");
		return 1;
	}
	message("system",
	HIB "纷乱动荡的武林中～～\n\n又出现一名恐怖的杀手～～\n" NOR,users());
	return 1;
}
int accept_object( object me , object ob )
{
	object obj;
	if( !ob->query("true-corpse") ) {
		command("?");
		return 0;
	}
	if( me->query("quests/to-kill") ) return 0;
	command("nod");
	obj = new("/open/snow/obj/ghost-blade");
	obj->move(this_player());
	message_vision("$N给$n一把"+obj->name()+"。\n",this_object(),
		this_player());
	me->set("quests/to-kill",1);
}
