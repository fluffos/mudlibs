// invocation.c

inherit SSERVER;
int perform(object me, object target) {
  object god;

  if (!me->is_fighting())
    return notify_fail("只有战斗中才能召出剑神！\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 60)
    return notify_fail("你的精神无法集中！\n");

  message_vision("$N将一股强劲内力注入剑中。\n", me);

  me->add("force", -500);
  me->receive_damage("sen", 10);
  me->receive_damage("gin", 10);


  seteuid(getuid());
  god = new("/u/w/wugi/example/sword-god");
  god->move(environment(me));
  god->invocation(me);

  return 1;
}
