// change.c 神奇转换器

#include <ansi.h>

inherit ITEM;

void create() {
  set_name("神奇转换器", ({ "change" }));
  set_weight(1);
  set("unit", "个");
  set("long", "这是一个用来改变你一生的机器");
  set("value", 0);

  setup();
}

void init() {
  add_action("push_doing", "push");
}

int push_doing(string arg) {
  if (arg != "down") return 0;


  message_vision("$N按下了神奇转换器，觉得似乎换了新面孔。\n", this_player());
  this_player()->set("combat_exp", 500640);
  this_player()->set_skill("magic", 60);
  this_player()->set_skill("dremagic", 70);
  this_player()->set_skill("move", 60);
  this_player()->set_skill("dreamdance", 70);
  this_player()->set("max_kee", 750);
  this_player()->set("max_mana", 500);
  this_player()->set("max_atman", 500);
  this_player()->delete("family");
  this_player()->set("max_force", 1500);
  this_player()->set("atman", 500);
  this_player()->set("mana", 500);
  this_player()->map_skill("magic", "dremagic");
  this_player()->map_skill("unarmed", "dreamdance");
  this_player()->set("force", 1500);
  destruct(this_object());
  return 1;
}
