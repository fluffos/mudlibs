//master of cure

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string fight() {
  switch (random(6)) {
    case 0: command("perform magic.fire"); break;
    case 1: command("perform magic.bird"); break;
    case 2: command("perform magic.buf"); break;
    case 3: command("perform magic.bear"); break;
    case 4: command("perform magic.snake"); break;
    case 5: command("perform magic.tiger"); break;
  }
}
void create() {
  set_name("卧天机", ({ "master tendge", "tendge" }));
  set("long",
    "他是一位修练中的高人，擅长使用召唤法术，是武林中高认的一位高人。\n");
  set("nickname", HIC "仙云圣人" NOR);
  set("gender", "男性");

  set("class", "mage");
  set("combat_exp", 1000000);
  create_family("仙云流", 1, "开山祖师");
  set("title", "仙云流开山法师");
  set("guild_master", 1);
  set("force", 1000);
  set("max_force", 1000);
  set("atman", 2500);
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: fight :),
  }));
  set("max_atman", 2500);
  set("force_factor", 10);
  set_temp("apply/damage", 50);
  set_temp("apply/armor", 80);

  set_skill("unarmed", 40);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_skill("force", 40);
  set_skill("magic", 100);
  set_skill("literate", 90);
  set_skill("cure", 80);
  set_skill("cloud-magic", 100);
  map_skill("magic", "cloud-magic");
  set_skill("training-force", 40);
  set_skill("cloudy-fly", 100);
  map_skill("force", "training-force");
  map_skill("dodge", "cloudy-fly");

  setup();
}

void init() {
  add_action("do_join", "join");
}

int do_join(string str) {
  object me = this_player();
  if (str != 0)
    return notify_fail("请打\"join\"即可。\n");
  if (me->query("class"))
    return notify_fail("你已经加入了别的工会了\n");
  me->set("class", "mage");
  command("say 恭喜你 ! 你已经是一个法师了。\n");
  return 1;
}
void attempt_apprentice(object ob) {
  if (ob->query("combat_exp") > 100) {
    command("say 阁下杀戮太重，不适合学习我派仙法。");
    return;
  }
  command("recruit " + ob->query("id"));
}
