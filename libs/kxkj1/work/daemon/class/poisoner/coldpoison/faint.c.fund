// counterattack.c

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;
	object ob;

	if( !target ) target = offensive_target(me);
	if(!present("faint poison",me))
		return notify_fail("你的身上没有一刻香。\n");

       msg=HIY "$N从口中放出迷烟，往$n吹去！\n" NOR;

	me->start_busy(1);
	if(random(me->query_skill("poison"))>random(target->query_skill("dodge"))) {
        msg+= GRN "$n一不留神，吸到了迷烟。\n" NOR;
	target->receive_damage("sen",random(40));
	} else {
        msg+=HIG "$n识破了$N的毒招，身子一侧，避了开去。\n" NOR;
	}
	message_vision(msg, me, target);
           me->kill_ob(target);
	ob=present("faint poison",me);
	ob->add_amount(-1);
	return 1;
}
