// throw.c

#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_GUILDCMDS;
inherit SSERVER;

int main(object me, string arg) {
  object obj, ob;
  object target;
  string st1, st2, po;
  if (!arg)
    return notify_fail("指令格式：throw <毒> to <人>\n");
  if (sscanf(arg, "%s to %s", st2, st1) != 2) {
    st2 = arg; st1 = 0;
  }
  if (!ob = present(st2, me))
    return notify_fail("你的身上没有这种东西。\n");
  if (!ob->query("can_throw"))
    return notify_fail("这种东西不能这样使用。\n");
  if (!me->is_fighting())
    return notify_fail("只有战斗中才能用。\n");
  if (!wizardp(me) && environment(me)->query("no_fight"))
    return notify_fail("这里禁止战斗。\n");

  if (!stringp(st1))
    obj = offensive_target(me);
  else if (!objectp(obj = present(st1, environment(me))))
    return notify_fail("你想攻击谁？\n");
  if (!obj || obj->query("no_kill")) return notify_fail("这家伙你不能动就是不能动。\n");
  if (wizardp(me) && !wizardp(obj) && wizhood(me) != "(manager)" && wizhood(me) != "(admin)" && wizhood(me) != "(arch)")
    return notify_fail("巫师不能对玩者用毒。\n");

  if ((obj->query_temp("mud_age") < 172800) && userp(obj) && userp(me))
    return notify_fail("请给新手一个空间好吗?\n");

  if (!obj->is_character())
    return notify_fail("看清楚一点，那并不是生物。\n");

  if (obj == me) return notify_fail("你不能攻击自己。\n");

  message_vision(
    HIG "$N从袖口拿出一包" + ob->name() + "往$n撒去！\n" NOR, me, obj);
  target = obj;
  if (random(2 * me->query_skill("poison")) > random(target->query_skill("dodge") + target->query_skill("parry"))) {
    message_vision(
      GRN "$n闪躲不及，被" + ob->name() + "撒中！\n" NOR, me, obj);
    po = ob->query("poison_type");
    obj->apply_condition(po, obj->query_condition(po) + ob->query("poison_power"));
  } else
    message_vision(
      GRN "$n急忙中一闪，有惊无险的避了开去。\n" NOR, me, obj);
  ob->add_amount(-1);
  return 1;
}

int help(object me) {
  write(@HELP
 
指令格式：throw <毒> to <目标物>
 
说明：这个指令可以让你在战斗中对敌方用毒。
 
HELP
  );
  return 1;
}
