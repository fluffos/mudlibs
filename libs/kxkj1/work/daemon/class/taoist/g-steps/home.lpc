// by dell

#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  if (me->is_fighting())
    return notify_fail("你还在战斗中，无法使用回归术。\n");
  message_vision(HIY "$N使出奇门遁甲之「回归”。\n" NOR, me);
  message_vision(HIW "只见$N眨眼间已不知去向。\n" NOR, me);
  me->move("/open/tendo/room/t07.lpc");
  return 1;
}
