 
#include <ansi.h>
int perform(object me,object target)
{
	int i;
	object *all;
	if( me->query("sen") < 10 )
		return notify_fail("你的精神不够，无法使用。\n");
	if( me->query_skill("plan") < 30 )
		return notify_fail("你的谋略程度不够。\n");
	if( !target ) return notify_fail("你要对谁用计 ?\n");
	me->add("sen",-10);
	message_vision( HIY + @LONG
$N突然地对$n展开奇袭，杀得$n措手不及！
LONG + NOR , me , target );
	target->start_busy(1);
	me->kill_ob(target);
	target->kill_ob(me);
	return 1;
}
