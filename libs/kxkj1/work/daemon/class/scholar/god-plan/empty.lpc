#include <ansi.h>
int perform(object me, object target) {
  int i;
  object *all = me->query_enemy();
  if (!me->is_fighting())
    return notify_fail("空城计只能在战斗中使用。\n");
  if (me->query("sen") < 5)
    return notify_fail("你的精神不够集中，无法使用三十六计。\n");
  if (me->query_skill("plan") < 30)
    return notify_fail("你的谋略能力不够。\n");
  for (i = 0; i < sizeof(all); i++)
    if (all[i]->query_temp("empty-succeed"))
      return notify_fail("相同的谋略，再使用就失效了。\n");
  me->add("sen", -5);
  if (random(me->query_skill("plan")) > random(50)) {
    message_vision(HIC + @LONG
$N使用孔明兵法之中的空城计，使敌方生疑！
LONG + NOR, me);
    for (i = 0; i < sizeof(all); i++)
      all[i]->set_temp("empty-succeed", 1);
    me->remove_all_killer();
  } else
    message_vision(HIY + @LONG
$N想要使用空城计，但是失败了。
LONG + NOR, me);
  return 1;
}
