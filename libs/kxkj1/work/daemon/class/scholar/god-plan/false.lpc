#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  int i;
  int exp;
  if (!me->is_fighting())
    return notify_fail("虚兵之计只能在战斗中使用。\n");
  if (!target) return notify_fail("你要对谁用计 ?\n");
  if (!me->is_fighting(target))
    return notify_fail("你并没有和他战斗。\n");
  if (me->query("sen") < 5)
    return notify_fail("你的精神力不够，无法用计。\n");
  if (me->query_skill("plan", 1) < 15)
    return notify_fail("你的谋略能力不够。\n");
  if (target->query_temp("false-succeed"))
    return notify_fail("相同的计策对同一个人没有效。\n");
  exp = target->query("combat_exp") / 10000 + 10;
  me->add("sen", -5);
  me->start_busy(1);
  if (random(me->query_skill("plan")) > random(exp)) {
    message_vision(HIG + @LONG
$n中了$N的虚兵之计，突然迟疑了一下，$N就在这个时后发动猛攻！
LONG + NOR, me, target);
    target->start_busy(3);
    target->set_temp("false-succeed", 1);
  } else {
    message_vision(HIG + @LONG
$n识破了$N的奸计，使$N的虚兵之计失效。
LONG + NOR, me, target);
  }
  return 1;
}
