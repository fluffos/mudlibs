// handwriting.c by Onion
inherit F_FUNCTION;
inherit SSERVER;
int perform(object me, object target) {
  string *ATTACK_MSG = ({
    "[0;34m$N手动笔书康有为之《广艺舟双楫》, 颇有新意, 灵动之貌急点$n。\n",
    "[0;31m$N手写明朝之《永乐大典》, 体格极严, 楷则固定, 一股僵硬之风扑向$n。\n",
    "[0;33m$N手点丹青, 字书赵佶之《瘦金体》, 独数一格之风, 领然一股气度直逼$n。\n",
    "[0;32m$N规矩的临出欧阳询之《九成宫醴泉铭》, 用笔结字法度严谨, 定下$n之一举一动。\n",
    "[0;36m$N流彩书出《兰亭集序》, 字字真情之作, 精彩动人, 意象绵延至$n全身。\n",
    "[1;34m$N写出北魏龙门石窟《魏灵藏》, 字径两尺, 洋洋洒洒, 有山河之势, 直压$n而去。\n",
    "[1;31m$N身形似风, 双手同时画出「二爨”,《爨宝子碑》、《爨龙颜碑》, 字势奇峭飞动、丰姿飘定, 前后之姿围困住$n。\n",
    "[1;33m$N临募出书圣王右军之《十七帖》, 隐含「草”的飞动驰骋之势, 挥洒意趣一笔草如乱絮般将$n紧紧箍住。\n",
    "[1;32m$N工整的写出钟繇之《宣示表》, 卓见有树之势, 一新楷书之写意, 准确的连系至$n胸前大穴之中。\n",
    "[1;36m$N临风点出《乙瑛碑》, 蚕头燕尾, 由圆转方, 每一撇、每一捺均扣准$n周身大穴。\n",
    "[1;36m$N手书《玉箸篆》, 字瘦硬婉, 犹如一无形刻石重压在$n身上, 无法挣扎。\n",
    "[1m$N当空一书, 表现出一种庄严肃穆的庙堂风格, 气势浑穆、高远凝重, 《西周金文》之笔势已将$n牢牢禁制。\n",
    "[1m$N身形突然一钝, 手若刻碑, 隐隐若雷之声, 赫然是失传已久之远古《甲骨殷契》, 笔势笼罩$n周身三十六大穴。[0m\n"
  });
  int action, range;
  int force_cost;
  object weapon;
  range = (me->query_skill(
    "six-fingers",
    1
  ) + me->query_skill("literate", 1) + me->query_function("handwriting")) / 15;
  if (range > sizeof(ATTACK_MSG))
    range = sizeof(ATTACK_MSG);
  action = random(range);
  force_cost = 80 + 2 * action - me->query_function("handwriting") / 10;
  if (!me->query_skill("literate"))
    return notify_fail("你的学识不足。\n");
  if (!me->is_fighting())
    return notify_fail("你只能在战斗中使出「临书点穴”。\n");
  if (target == me)
    return notify_fail("不能对付自己呀!!\n");
  if (me->query("force") < 100)
    return notify_fail("你的内力不够。\n");
  if (objectp(weapon = me->qurey_temp("weapon")) && (weapon->query("skill_type") != "stabber" || weapon->query("skill_type") != "unarmed"))
    return notify_fail("'鸡丝'不对喔。\n");
  if (!target)
    target = offensive_target(me);
  message_vision("\n" + ATTACK_MSG[action] + "[0m\n", me, target);
  if (action + range + (me->query_function("handwriting") / 5) > random(40) + target->query_skill("literate") / 5) {
    message_vision("[1m$N成功\的将$n给封锁住了!\n[0m", me, target);
    target->start_busy((action / 2) + 1);
    function_improved("handwriting", 4 * action + me->query_function("handwriting"));
  } else {
    message_vision("可惜$N失败了..\n", me);
    function_improved("handwriting", (2 * action) + 10);
    me->start_busy(1);
  }
  me->add("force", -force_cost);
  return 1;
}
