// rose_poison.c

#include <ansi.h>

int update_condition(object me, int duration) {
  if (duration == 0) return 0;
  me->set("kee", me->query("max_kee"));
  me->apply_condition("god_out", duration - 1);
  message_vision(
    HIC "$N的仙云之气护住$N的身躯。\n" NOR, me);
  if (duration < 1) return 0;
  return 1;
}
