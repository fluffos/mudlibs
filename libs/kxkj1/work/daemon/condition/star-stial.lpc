#include <ansi.h>

int update_condition(object me, int duration) {
  if (me->is_fighting()) {
    tell_object(me, HIB "你的内伤复发，只觉得胸口一阵刺痛。\n" NOR);
    me->add("kee", -20);
    me->add("force", -20);
    if (me->query("force") < 0) me->set("force", 0);
  }
  me->apply_condition("star-stial", 0);
  return 1;
}
