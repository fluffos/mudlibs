// nine-steps.c

inherit SKILL;

string *dodge_msg = ({

  "\n$n展现‘[1;31m移形幻影[0m’似真似幻，似幻似真，让$N捉摸不定,忽然一个转身,就轻易闪开\n",

  "\n$n使出‘[1;32m鬼魅身法[0m’犹如一形十影，追风逐电，迅速移位，顷刻如鬼魅般飞到$N身旁\n",

  "\n面对$N的攻击，只要中任何一招，便会筋碎骨断，于是$n利用‘[1;33m金蝉脱壳[0m’闪开\n",

  "\n$n凝神入定，口中唸唸有词，瞬间伸手一指发出‘[1;34m定身法[0m’尝试把$N给定住不动！\n",

  "\n$n施展‘[1;33m九天灵影身法[0m’身法式‘[1;35m鱼游身法[0m’，身随意行，四方游走，避开$N攻击\n",

  "\n$n展现‘[1;33m九天灵影身法[0m’拆卸式‘[1;36m怀中抱月[0m’，见招拆招，见式破式，静观$N的弱点\n",

  "\n$n使出‘[1;33m九天灵影身法[0m’攻击式‘[1;31m八臂邪神[0m’，如狂风暴雨绵绵不断攻击$N永不停息\n",

  "\n$n打出‘[1;33m九天灵影身法[0m’困住式‘[1;35m阎罗召唤[0m’，出现鬼魂，神出鬼没扑到$N的身后\n",
});

int valid_enable(string usage) {
  return (usage == "dodge") || (usage == "move");

}

int valid_learn(object me) {
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 5)
    return notify_fail("你的气不够，不能练九天灵影步。\n");
  me->receive_wound("kee", 5);
  return 1;
}
