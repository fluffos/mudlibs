#include <ansi.h>
inherit SKILL;
string *dodge_msg = ({
  "$n使出雪苍武学中的迷踪身法，身形一转，避了开去。\n",
  "$n使出迷踪身法中的「灵影浮动”身形微晃，使$N这招扑了空。\n",
  "$n步法交错，身形移位，闪了开去。\n",
});
string *array_msg = ({
  "$n守在东位，一手「盘天式”攻得$N手忙脚乱！\n",
  "$n守在西位，一招「卧地式”企图扰乱$N的攻势！\n",
  "$n站在南位，一式「南风迷”连递数个虚招！\n",
  "$n站在北位，一式「北风狂”连续猛攻$N！\n",
});


int valid_learn(object me) {
  return 1;
}
string query_dodge_msg(string limb) {
  if (this_player()->query_temp("use_form") == 1)
    message_vision(array_msg[random(sizeof(array_msg))], this_object(), this_player());
  return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_enable(string usage) {
  return (usage == "dodge" || usage == "move");
}


int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的气不够，不能练黑影迷踪步。\n");
  me->receive_damage("kee", 30);
  return 1;
}
