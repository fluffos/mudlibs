// taoism.c by dell

inherit SKILL;

string type() {
  return "knowledge";
}

int valid_enable(string usage) {
  return usage == "cure";
}

int valid_learn(object who) {
  int maxlvl;
  if (who->query("class") != "taoist")
    return notify_fail("你又不是道士，学它没用。\n");
  if ((int)who->query("bellicosity") > 1)
    return notify_fail("你的杀气太重，无法领悟天师正道。\n");
  maxlvl = (int)who->query("int") * 4;
  if ((int)who->query("taoism") >= maxlvl)
    return notify_fail("天师正道太难了，你怎么学也无法领会。\n");
  maxlvl = (int)who->query("cps") * 4;
  if ((int)who->query("taoism") >= maxlvl)
    return notify_fail("天师正道太难了，你怎么也定不下心来学习。\n");
  return 1;
}

int practice_skill(object who) {
  int cost = 40;
  if ((int)who->query("sen") <= cost)
    return notify_fail("你的神不够，不能练天师正道。\n");
  who->receive_damage("sen", cost);
  write("你入定无为，天师正道无意中领悟了许多。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("taoist") + "/taoism/" + action;
}
