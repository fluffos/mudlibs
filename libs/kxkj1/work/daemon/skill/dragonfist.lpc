// dragonfist.c

#include <ansi.h>
#include <combat.h>
inherit SKILL;
inherit SSERVER;

mapping *action = ({
  ([ "action": "$N右膝微屈，左掌画个半圆，一招「亢龙有悔”，对准$n的$l「
呼”地一掌",
    "dodge": -60,
    "parry": 50,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N扬起右掌，一招「时乘六龙”便往$n的$l招呼过去",
    "dodge": -40,
    "parry": 40,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左手虚晃，右掌「龙战于野”往$n的$l击出",
    "dodge": -40,
    "parry": 40,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N身形一转，右掌护胸，左掌拍出「潜龙勿用”击向$n$l",
    "dodge": -35,
    "parry": 50,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N身形飞起，双掌使出「飞龙在天”往下击向$n$l",
    "dodge": -70,
    "parry": 30,
    "damage_type": "瘀伤"
  ]),
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练降龙十八掌必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "unarmed");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  return 1;
}
