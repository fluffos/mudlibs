//gold-blade.c
#include <combat.h>
#include <ansi.h>
void movedown(object me, object target, object weapon, int damage);
inherit SKILL;

mapping *action = ({
  ([ "action": "$N向前冲了过去,在到达$n寸分然向上跃起 ,手中的 $w忽然化成一道白光向$n$l射去",
    "damage": 50,
    "dodge": 10,
    "parry": -20,
    "damage_type": "砍伤",
  ]),
  ([ "action": "$N喝到:「小心了”,$N忽然一个燕子翻身,身子一飞冲天,从袖中摸出了三把手里剑, 咻咻咻的就朝着$n$l射去",
    "damage": 200,
    "dodge": 20,
    "parry": -30,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N眼中面露青光,手中的$w忽然幻化成千百只青蛇,朝着$n飞了过去",
    "damage": 30,
    "dodge": -30,
    "parry": 10,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N大喝:「火龙曲舞”,一刀往空中劈了开来,发出的火花化成一只火龙,朝着$n飞了过去",
    "damage": 30,
    "dodge": -50,
    "parry": 10,
    "damage_type": "烧伤"
  ]),
  ([ "action": "$N身子拔起一丈 ,身子在半空中一个倒挂,在半空中挥动$w攻向$n$l",
    "damage": 80,
    "dodge": -50,
    "parry": -20,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N含起卷轴念起某种咒语,忽然从地下冒出了一只巨大的赖蛤蟆,口中喷出阵阵的硫酸射向$n",
    "damage": 100,
    "force": 100,
    "parry": -30,
    "dodge": -10,
    "damage_type": "灼伤"
  ]),
  ([ "action": "$N步法怪异莫名,手中的$w发出嘤嘤怪响,攻向$n的七大要害,",
    "damage": 60,
    "parry": -20,
    "dodge": 0,
    "damage_type": "劈伤"
  ]),
  ([ "action": "$N大喝:「雷电闪”,$N手中的$w发出阵阵的电光,射向天空,忽然空中出现一道落雷, 往$n头上打了下去",
    "damage": 300,
    "force": 300,
    "parry": 30,
    "dodge": 30,
    "damage_type": "灼伤"
  ]),
  ([ "action": "$N喝到:「土之道”－$N将手中的$w往地上一插,忽然间,地面上所有的岩石发出怪声,往$n飞了过去",
    "damage": 150,
    "force": 50,
    "parry": -10,
    "dodge": 10,
    "damage_type": "刺伤"
  ]),
});
int valid_learn(object me) {
  object ob;
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，没有办法练机甲忍刀。\n");
  if ((string)me->query_skill_mapped("force") != "badforce")
    return notify_fail("机甲忍刀必须配合恶人心法才能练。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀才能练忍刀。\n");
  if ((int)me->query("max_force") / 10 < (int)me->query_skill("hanzo-bl
ade", 1))
    return notify_fail("你的内力不够深厚 ,无法练此刀法。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "blade") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

void movedown(object me, object target, object weapon, int damage) {
  if (random(3) > 1)
    return;
  if (me->query("force") < 20) return;
  me->add("force", -20);
  message_vision(
    HIG "$N拿起一张卷轴含在口中,忽然$N的身影幻化成数十个人把$n给包围,并展开攻击\n" NOR, me, me, target);
  if (random(target->query("combat_exp")) < random(me->query("combat_exp")))

  {
    message_vision(GRN "结果$n手忙脚乱，无法攻击 !\n" NOR, target);
    target->start_busy(me->query_skill("hanzo-blade", 1) / 20);
  } else
    message_vision(GRN "结果被$n识破了招式,找到了真的实体!\n" NOR, target);
}
int practice_skill(object me) {
  object weapon;

  if (me->query("max_force") / 10 < me->query_skill("hanzo-blade", 1))
    return notify_fail("你内力不足 ,强自练习 ,只会受害。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你要有适合的武器才能练习紫金六阳刀法。\n");

  if ((int)me->query("kee") < 30)
    return notify_fail("气不够啰 ,修息一下再练吧。\n");
  me->receive_damage("kee", 30);
  return 1;
}
string perform_action_file(string action) {
  return CLASS_D("blademan") + "/hanzo-blade/" + action;
}
