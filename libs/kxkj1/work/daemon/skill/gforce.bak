// liuinforce.c
#include <ansi.h>
inherit SKILL;

int valid_enable(string usage) { return usage=="force"
	|| usage=="unarmed"
;}

int valid_learn(object me) { return 1; }

int practice_skill(object me)
{
	return notify_fail("紫府神功\只能用学(learn)的或是从运功(exert)中增加熟练度\n");
}

string exert_function_file(string func)
{
	return CLASS_D("taoist") +"/gforce/" + func;
}
void skill_improved(object me)
{
	int s;

	s = me->query_skill("liuinforce", 1);
	if( s%10==9 && (int)me->query("con") < s/4) {
		tell_object(me, HIW "由于你的内功\修炼有成，你的体质改善了。\n" NOR);
		me->add("con",3);
		tell_object(me , HIY "经过一番努力，你的内力增强了" NOR );
		me->add("max_force",30);
	}
}
