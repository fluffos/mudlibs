// spring-blade.c



inherit F_CLEAN_UP;



mapping *action = ({

  ([ "action": "$N使一招「泼猴随棍上”,手中$w一缩一
伸,突击$n的丹田",

    "damage": 70,

    "dodge": 20,

    "damage_type": "撞伤"

  ]),

  ([ "action": "$N一招「顽猴怯抛棍”,$N假意的将手中
$w抛给$n",

    "damage": 66,

    "dodge": 17,

    "damage_type": "丢伤"

  ]),

  ([ "action": "$N一招「灵猴翻天印”,$N翻身将$w往$n
头部重锤",

    "damage": 62,

    "dodge": 15,

    "damage_type": "锤伤"

  ]),

  ([ "action": "$N一招「怒猴狂搜姿”,$N将$w夹在头部
旋转,直冲$n",

    "damage": 58,

    "dodge": 12,

    "damage_type": "击伤"

  ]),

  ([ "action": " $N一招「仙猴偷蹯桃”,$N一弯身,将$w由
下往上直撞$n的下巴",

    "damage": 54,

    "dodge": 10,

    "damage_type": "撞伤"

  ]),

});



int valid_learn(object me)

{
  object ob;

  if ((int)me->query_skill("typical") < 5)

    return notify_fail("你的资质不够, 没法练.\n");

  if (!(ob = me->query_temp("weapon"))

    || (string)ob->query("skill_type") != "stick")

    return notify_fail("你必须先找一根棍子才能练棍法\n");

  return 1;

}



int valid_skill_usage(string usage)

{

  return usage == "stick" || usage == "parry";


}



mapping query_action(object me, object weapon)

{

  return action[random(sizeof(action))];

}
