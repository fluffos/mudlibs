//k.o.f
#include <ansi.h>
#include <combat.h>

inherit SKILL;
inherit SSERVER;

mapping *action = ({
  ([ "action": "$N使出一招" + HIR "[暗杀炎]" NOR + ",手中放出一团红莲之火飞向
$n的脚部",
    "dodge": -20,
    "parry": -5,
    "ac": 25,
    "damage_type": "伤害"
  ]),
  ([ "action": "$N手中带着火焰,使出一招" + RED "[鬼烧]" NOR + "击向$n的$l",
    "dodge": -10,
    "parry": -20,
    "ac": 20,
    "damage_type": "伤害"
  ]),
  ([ "action": "$N纵身跳起,使出一招" + HIB "[胧车]" NOR + ",朝$n的$l连踢了数下"
    ,
    "dodge": -8,
    "parry": -10,
    "ac": 23,
    "damage_type": "伤害"
  ]),
  ([ "action": "$N忽地一吼,一招" + HIY "[琴月阳]" NOR + "以迅捷无比的速度把
$n抓起来,轰!$n全身着火了!!",
    "dodge": -8,
    "parry": -30,
    "ac": 25,
    "damage_type": "伤害"
  ]),
  ([ "action": "$N忽然飞跳上前,使出一招" + HIR "[神悬]" NOR + ",用带火炎的拳
头朝$n的$l打过去",


    "dodge": -20,
    "parry": -20,
    "ac": 30,
    "damage_type": "伤害"
  ]),
  ([ "action": "$N冲向前去,双手握拳,使出" + MAG "[葵花]" NOR + ",朝$n的头部
连打三下",
    "dodge": -20,
    "parry": -20,
    "ac": 27,
    "damage_type": "伤害"
  ]),
  ([ "action": "$N全身凝气不动,右手抓着一团红莲之火" + HIR "全身燃烧着火焰"
    NOR + ",使出大绝招" + HIY "[大蛇雉]" NOR + " ,朝$n放出红莲之火",
    "dodge": -30,
    "parry": -30,
    "ac": 30,
    "damage": 50,

    "damage_type": "伤害"
  ]),
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练草雉之拳必须空手。\n");
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的最大爆发力太弱，无法练草雉拳法\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("sen") < 40)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  me->add("sen", -40);
  return 1;
}
