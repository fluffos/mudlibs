// recover.c

int exert(object me, object target)
{
	if( target != me ) 
	return notify_fail("你只能用内功\调匀自己的气息。\n");	
        if( (int)me->query("force") < 30)
	return notify_fail("你的内力不够。\n");
        me->receive_curing("kee",15+ (int)me->query_skill("force")/8);
        me->receive_heal("kee", 15+ (int)me->query_skill("force")/8);
	me->add("force", -30);

	message_vision("[36m$N深深吸了几口气，脸色看起来好多了。[0m\n", me);

	if( me->is_fighting() ) me->start_busy(1);

	return 1;
}
