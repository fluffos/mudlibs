void create() {
  set("short", "竞技场");
  set("long", "这里便是城内著名的竞技场, 宽阔的场地上空无一人, 倒是在旁围观的
路人却团团围住了中央的场子, 似乎待会便有一场龙争虎斗的样子。
    在竞技场的入口处站着两位卫兵, 大概是防范有人闹事。
");

  set("outdoors", "/open/capital");

  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "r60",
  ]));

  set("objects", ([
    CAP_NPC "Fguard": 3,
  ]));

  setup();
}
