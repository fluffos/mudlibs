#include <weapon.h>

inherit SWORD;

void create() {
  set_name("[1;33m尚方宝剑[0m", ({ "god sword", "sword" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "皇帝所配带的宝剑，据说持此剑便有如圣上亲临。剑鞘上镶着耀眼的宝\n"
      "石，而剑锋则发出金黄色的剑气。\n");
    set("value", 10000);
    set("material", "gold");
  }
  init_sword(20);

  set("wield_msg", "$N「锵”地一声～恭请出$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n谨慎地插入～圣龙剑鞘。\n");

  setup();
}
