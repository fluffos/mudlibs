#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("乌龙茶", ({ "wu-long tea", "tea" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "
一壶乌龙茶。\n");
    set("unit", "壶");
    set("value", 20);
    set("饱和", 10);
  }
  set("液体", ([
    "种类": "茶",
    "名称": "乌龙茶",
    "剩": 10,
    "止渴": 30,
    "drunk_apply": -5,
  ]));
  setup();
}
