// mob3.c by konn

#include <ansi.h>
inherit NPC;

int kill_him(object);

void create() {
  set("title", "魔界□鬼");
  set_name(HIW "白发邪妖" NOR, ({ "white ghost", "ghost" }));
  set("long",
    "\n魔界中的邪恶之鬼，专门吸干人的精髓后，再把尸骨切剁\n" +
    "成烂泥，弃掷于魔界恶兽□洞，任洞内妖魔尽兴吸取。\n");

  set("age", 2058);
  //        set("race","妖怪");
  set("race", "野兽");
  set("gender", "雄性");
  set("attitude", "friendly");
  set("max_gin", 22310);
  set("max_kee", 44100);
  set("max_sen", 34410);
  set("max_force", 2000);
  set("force_factor", 10);
  set("combat_exp", 1750000);

  set_temp("apply/attack", 120);
  set_temp("apply/damage", 120);
  set_temp("apply/dodge", 200);
  set_temp("apply/move", 200);
  set_temp("apply/armor", 200);

  set_skill("unarmed", 40);
  set_skill("dodge", 115);
  set_skill("move", 120);
  set_skill("parry", 125);
  set_skill("hell-evil", 100);
  map_skill("unarmed", "hell-evil");

  set("limbs", ({ "头部", "胸部", "大黑手", "大黑脚", "背部", "腰部" }));
  set("verbs", ({ "bite", "claw" }));

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    HIW "\n          白发邪妖张着大嘴拚命对你呵气!\n\n" NOR,
    HIW "\n          白发邪妖用它的千丈白发将你缠住!\n\n" NOR
  }));

  setup();
}

void init() {
  object obj;

  ::init();
  if (interactive(obj = this_player()) && !is_fighting()) {
    remove_call_out("kill_him");
    call_out("kill_him", 0, obj);
  }
}

int kill_him(object obj) {
  //        if(obj->query("race") == "妖怪") return 1;
  if (obj->query("race") == "野兽") return 1;
  if (obj->query("max_force") > 999 ||
    obj->query("combat_exp") > 299999)
    command("kill " + obj->query("id"));
  return 1;
}
