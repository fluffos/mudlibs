inherit ROOM;
#include "/open/mogi/forest/room/forest.msg"

void create() {
  set("short", "魔森林");
  set("long",
    (: print_forest_msg :)
  );

  set("evil", 1);
  set("no_auc", 1);
  set("no_transmit", 1);
  set("light_up", -1);
  set("exits", ([ /* sizeof() == 3 */
    "east": __DIR__ "room31",
    "north": __DIR__ "room37",
  ]));

  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "mob": 1,
  ]));

  setup();
}
