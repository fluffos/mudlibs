// room26.c by konn
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "魔森林");
  set("long", @LONG
在这里，四周环境与其它地方不太相同，在你正前方的那颗树，好像藏有什
么密秘，你可以在此 search 看看!



LONG);

  set("evil", 1);
  set("no_auc", 1);
  set("no_transmit", 1);
  set("light_up", -1);
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "room20",
    "west": __DIR__ "room32",
  ]));

  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "mob": 1,
  ]));

  setup();
}

void init() {
  add_action("do_sea", "search");
}

int do_sea() {
  int a;
  object me = this_player();
  if (!present("wishful jade", me) ||
    !present("evil key", me))
    return 0;

  tell_object(this_player(), HIW "\n只见一只怪手将你抓住...\n\n" NOR);
  switch (a = random(8) + 1) {
    case 1: this_player()->move(__DIR__ "cube1");
    break;
    case 2: this_player()->move(__DIR__ "cube3");
    break;
    case 3: this_player()->move(__DIR__ "cube7");
    break;
    case 4: this_player()->move(__DIR__ "cube9");
    break;
    case 5: this_player()->move(__DIR__ "cube19");
    break;
    case 6: this_player()->move(__DIR__ "cube21");
    break;
    case 7: this_player()->move(__DIR__ "cube25");
    break;
    case 8: this_player()->move(__DIR__ "cube27");
    break;
  }
  tell_object(this_player(), HIW "\n一眨眼，你被送到一个陌生的环境\n\n" NOR);
  return 1;
}
