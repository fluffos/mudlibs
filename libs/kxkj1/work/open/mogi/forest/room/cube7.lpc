LONG);
  set("item_desc", ([ /* sizeof == 1 */
    "cube": "\n这是一个3*3*3 的魔方阵，你必须走到中央后" +
    "search方可出去!\n\n",
  ]));

  set("evil", 1);
  set("no_auc", 1);
  set("no_transmit", 1);
  set("light_up", -1);
  set("exits", ([ /* sizeof() == 6 */
    "north": __DIR__ "cube9",
    "east": __DIR__ "cube1",
    "west": __DIR__ "cube4",
