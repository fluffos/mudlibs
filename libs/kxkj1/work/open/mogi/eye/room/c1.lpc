#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "石洞");
  set("long", @LONG

     阴深深的洞穴,不知隐藏了什么宝物
    在墙角有个箱子,不知有什么东西(box)
      在北边的墙脚有个古怪的印记 (key)。

LONG);

  set("item_desc", ([ /* sizeof() == 2*/
    "box": "深色的箱子上面布满着灰尘....\n",
    "key": "看来是这石洞的秘门,看来好像可以(move) \n",
  ]));

  set("exits", ([ /* sizeof() == 3 */

    "west": "/u/m/mystery/room6",
  ]));
  set("light_up", 1);
  set("valid_startroom", 1);
  setup();
}

void init() {
  add_action("do_key", "move");
  add_action("do_touch", "touch");
}

int do_key(string str) {
  object ob = this_player();
  int kee1;
  if (str != "key") return 0;

  if (ob->query("id") == "mystery") {
    write(" 「喀”的一声，你推动了暗门。\n");
    write(" 你进入了密室。\n");
    ob->move("/u/m/mystery/c3");
    return 1;
  } else {
    kee1 = ob->query("kee") + 5;
    tell_object(ob, "你触动了机关，只觉脚下一虚，身子直往下坠.....\n");
    message_vision(HIW "只听到$N一声惨叫，$N已失去踪迹\n" NOR, ob);
    write(HIR "好好反省吧!!\n" NOR);
    ob->set("env/immrotal", "no");
    ob->add("kee", -kee1);
    ob->move(__DIR__ "c2");
    return 1;
  }
}

int do_touch(string str) {
  if (str != "box") return 0;

  tell_object(this_player(), "右边的墙缓缓移出一道门。\n");
  add("exits/east", __DIR__ "c4");
  return 1;
}
