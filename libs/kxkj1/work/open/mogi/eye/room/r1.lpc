#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "魔眼洞入口");
  set("long", @LONG
  魔眼洞为魔界的第一关卡,如果等级不够的千万别进来送死
  你听，远方妖怪传来凄厉的哀豪声，不禁使你毛骨悚然起来。
  洞中除了有可怕的妖怪外，还有着近十层的妖气在里面迷漫，一般人进 
  去之后，浓烈的妖气会消耗其精气神，而导致在里面昏迷不醒，最后惨 
  遭被怪物吞食的命运。在这地上竖了一个碑(sign)。



LONG);

  set("evil", 1);
  set("no_auc", 1);
  set("no_transmit", 1);
  set("light_up", 1);
  set("outdoors", __DIR__ "room");
  set("item_desc", ([ /* sizeof == 2 */
    "sign": HIW "       珍习你的生命,尽早回头吧....\n" +
    "否则....嘿嘿嘿 .....先办好你的后事吧....\n" NOR
  ]));

  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "r2",
    "west": __DIR__ "r3",
    "north": __DIR__ "b1",
  ]));

  setup();
}
