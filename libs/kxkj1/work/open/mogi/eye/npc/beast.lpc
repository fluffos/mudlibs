// mogi 之 mob <made by Ryn>

#include <ansi.h>

inherit NPC;

void create() {
  set_name("小鬼", ({ "small-ghost", "ghost" }));
  set("long", "\n它是魔界中常见的妖怪，不过不要看他外表弱小，" +
    "就轻视它，发起狠来，连神仙都怕它喔!\n");
  set("gender", "雄性");
  set("race", "野兽");
  set("nickname", "魔界恶妖");
  set("combat_exp", 20000);
  set("attitude", "killer");
  set("age", 1000);
  set("max_kee", 2000);
  set_skill("move", 120);
  set_skill("dodge", 100);
  set_skill("parry", 90);
  set_skill("unarmed", 50);
  set_skill("hell-evil", 10);
  map_skill("unarmed", "hell-evil");

  set_temp("apply/dodge", 150);

  set("limbs", ({ "头部", "眼睛", "胸部", "大黑手", "大黑脚", "背部", "腰部" }));
  set("verbs", ({ "bite", "claw" }));
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    HIW "\n小鬼说:大胆竟敢闯入魔界,你不要命了....\n" NOR +
    HIW "\n纳命来吧!\n" NOR,
  }));

  setup();

}
