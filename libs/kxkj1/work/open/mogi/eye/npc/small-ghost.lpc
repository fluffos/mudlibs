// small ghost.c

#include "/open/open.h"
#include <ansi.h>

inherit NPC;

void create() {
  set_name("小史莱姆", ({ "small ghost", "ghost" }));
  set("race", "妖怪");
  set("race", "野兽");
  set("age", 50);
  set("long", "一只可爱的小的魉皇鬼，看来好像还没有觅食的能力。\n");
  set("str", 40);
  set("cor", 40);
  set("max_kee", 2000);
  set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }));
  set("verbs", ({ "bite" }));
  set("combat_exp", 50000);
  set_temp("apply/armor", 90);
  set_temp("apply/attack", 30);
  setup();
}

void init() {
  add_action("do_fight", "fight");
}

int do_fight(string arg) {
  object who;
  who = this_player();

  if (!arg || (arg != "ghost" && arg != "small ghost"))
    return notify_fail("你想攻击谁？\n");
  else {
    kill_ob(who);
    accept_kill(who);
  }

  return 1;
}

int accept_kill(object who) {
  object ob, ghost;
  ob = this_object();

  if (!present("big ghost", environment(ob))) {
    tell_room(environment(ob), HIW "\n突然，一只巨大的史莱姆向你冲了过来！" NOR);
    ghost = new("/open/mogi/eye/npc/big-ghost");
    ghost->move(environment(ob));
    ghost->kill_ob(who);
  }
  return 1;
}
