inherit NPC;

void create()
{
	set_name("亡命之徒",({"bandit"}));
	set("long","一个因杀人而被通缉的人,现在他正过着躲躲藏藏的日子.\n");
	set("gender","男性");
	set("combat_exp",357);
	set("attitude","friendly");
        set("age",25);
	set("class","bandit");
	set("str", 30);
        set("cor", 30);
        set("per", 15);
        set("int", 15);
	set("cps", 30);
	set("con", 30);
        set("kar", 20);
	set("chat_chance",10);
	set("chat_msg",({
	"亡命之徒说道:别跟官兵说我躲在这里喔.\n",
	"亡命之徒说道:真是的,杀个人有什么了不起的?干麻抓我.\n"}));
        set_skill("dodge",30);
	set_skill("dagger",30);
        set_skill("parry",20);
	setup();
        carry_object("/obj/example/dagger.c")->wield();
}

         
      
