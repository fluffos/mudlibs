// made by ccat
inherit COMBINED_ITEM;
void create()
{
        set_name("仙山灵芝", ({"super item","item"}) );
	set("long",
"此物乃蜀中将军自蜀山神峰采来之神药,专克血气失调.\n"+
"此要须经药师调配(check item),方得食用(swallow pill).\n");
	set("unit", "棵");
	set("base_unit", "棵");
        set("no_sell",1);
	set("value",2500);
        set("base_weight", 50);
	set_amount(1);
	setup();
}

void init()
{
	if( this_player()==environment() )
	{
		add_action("swallow_pill", "swallow");
		add_action("check_item","check");
	}	
}

int swallow_pill(string arg)
{      
      if( (arg=="pill" || arg=="super pill") && (query("unit") == "盒") )
      {
	object user;
	user = this_player();
        message_vision("$N吃下一粒灵芝仙丹.\n", user);
        if( user->query_condition("ff_poison") )
          user->apply_condition("ff_poison",0);
	add_amount(-1);
        return 1;
       }
        return 0;
        
}

int check_item(string arg)
{
     int cure;
     if( (arg=="item" || arg=="super item") && (query("unit") == "棵") )
     {
        object user;
        user = this_player();
        cure = user->query_skill("cure",1);
        if( cure > 14)
        {
          message_vision("$N试着将灵芝制成仙丹.\n", user);
          set("no_drop", 1);
          set_name("灵芝仙丹", ({"super pill","pill"}) );
          set("unit", "盒");
          set("base_unit", "粒");
          cure = cure/3;
          set_amount((int)cure);
        }else
          message_vision("$N的医术太低,无法将灵芝制成仙丹.\n", user);
        return 1; 
     }
     return 0;   
}              
              
                           
