// made by ccat 
inherit COMBINED_ITEM;
void create()
{
        set_name("还精丸", ({"gin pill","pill"}) );
	set("long",
	"一粒还精丸,会将你的气转换成精,你可以吞下它(swallow pill).\n");
	set("unit", "盒");
	set("base_unit", "粒");
        set("value", 150);
        set("base_weight", 50);
	set_amount(1);
	setup();
}
void init()
{
	if( this_player()==environment() )
		add_action("swallow_pill", "swallow");
}
int swallow_pill(string arg)
{       
      if(arg=="pill" || arg=="gin pill")
      {
        int max,now,now1,kee1;
        object ob;
        ob = this_player();
	message_vision(
		"$N吃下一粒还精丸\n", ob);
        max = ob->query("max_gin");
        kee1 = ob->query("kee");
        if(kee1 > 40 )
        {
           ob->add("kee",-30);
           ob->add("gin",25);
        }else{
          write("你的气太低无法转换成精.\n");           
        }
        now = ob->query("gin");
        if(now > max)
        {   
            ob->set("gin",max);
            now = max;
        } 
	add_amount(-1);
	return 1;
	}
	return 0;
	
}

