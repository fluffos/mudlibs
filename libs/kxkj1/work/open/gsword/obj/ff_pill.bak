// made by ccat
inherit COMBINED_ITEM;
void create()
{
        set_name("天山雪莲", ({"force item","item"}) );
	set("long",
"此物乃蜀中将军自天山绝顶采来之神药,可以顺间恢复内力.\n"+
"此要须经药师调配(check item),方得食用(swallow pill).\n");
	set("unit", "棵");
	set("base_unit", "棵");
        set("no_sell",1);
	set("value",2500);
        set("base_weight", 50);
	set_amount(1);
	setup();
}

void init()
{
	if( this_player()==environment() )
	{
		add_action("swallow_pill", "swallow");
		add_action("check_item","check");
	}	
}

int swallow_pill(string arg)
{      
      if( (arg=="pill" || arg=="force pill") && (query("unit") == "盒") )
      {
	object user;
	int max_force,force;
	user = this_player();
	message_vision("$N吃下一粒雪莲丹.\n", user);
        max_force = user->query("max_force");
        force = user->query("force");
        if( force < max_force)
          user->set("force",max_force);
	add_amount(-1);
        return 1;
       }
        return 0;
        
}

int check_item(string arg)
{
     int cure;
     if( (arg=="item" || arg=="force item") && (query("unit") == "棵") )
     {
        object user;
        user = this_player();
        cure = user->query_skill("cure",1);
        if( cure > 20)
        {
          message_vision("$N试着将天山雪莲制成灵丹.\n", user);
          set_name("雪莲丹", ({"force pill","pill"}) );
          set("no_drop", 1);
          set("unit", "盒");
          set("base_unit", "粒");
          cure = cure/7;
          set_amount((int)cure);
        }else
          message_vision("$N的医术太低,无法将雪莲制成灵丹.\n", user);
        return 1; 
     }
     return 0;   
}              
              
                           
