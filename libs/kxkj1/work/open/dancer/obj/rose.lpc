#include <ansi.h>
inherit EQUIP;
void create() {
  set_name(HIM "粉红玫瑰花" NOR, ({ "pink rose", "rose" }));
  set_weight(1000);
  set("gender_only", "女性");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "
一朵盛开的粉红大玫瑰花, 产于落雁阁寻梦园, 听说那儿住了一对神仙伴侣.
这种玫瑰乃是吸收日月精华而成长, 据说插在头发上可增强内力说.
");
    set("unit", "朵");
    set("armor_type", "hat");
    set("material", "flower");
    set("value", 0);
    set("armor_prop/dodge", 6);
    set("armor_prop/move", 6);
    set("armor_prop/force", 10);
    set("armor_prop/armor", 20);

    set("wear_msg", "$N优雅地把$n插在头发上,更添几分姿色。\n");
  }
}
