// copy from konn,re-edit from ccat 
#include <ansi.h>
inherit NPC;
object fu_weapon;
int have_weapon=0;
void create()
{
        set_name("慕容复", ({"murofu"}));
        set("title", "以彼之道 还彼之身");
        set("long", "苏杭名士慕容复,善各家武\功\,乃江南第一高手.\n");
        set("age", 40);
        set("str", 30);
        set("force", 1500);
        set("max_force", 1500);
        set("force_factor", 10);
        set("combat_exp", 700000);
        set("race", "人类");
        set("gender", "男性");
        set_skill("dodge", 80);
        set_skill("move", 80);
        set_skill("parry", 80);
        set_skill("force", 80);
        set_skill("blade", 80);
        set_skill("six-fingers", 75);
        set_skill("linpo-steps",70);
        
        map_skill("stabber", "six-fingers");
        map_skill("dodge", "linpo-steps");

        set_temp("apply/damage", 60);
        set_temp("apply/armor", 90);
        set_temp("apply/dodge", 80);

        set("functions/handwriting/level",35);
        set("chat_chance_combat", 50);
        set("chat_msg_combat",({
           (: perform_action("stabber.handwriting") :),
           (: perform_action("sha_kee") :),
           (: perform_action("blade.gold-dest") :),
      }));
        setup();

        add_money("gold",15);
}
int accept_fight(object me)
{
  say("慕容复说: 对不起,先父有遗言,不准任意与中原武人交手.\n");
  return 0;
}
int accept_kill(object me)
{
        object weapon = me->query_temp("weapon");
        string skill, m_skill;
        int lv_1, lv_2, exp,kee,force;
 
        if( !have_weapon )
        {
          have_weapon = 1;
          fu_weapon = new("/open/ping/obj/fu_weapon");
          fu_weapon->move(this_object());
          command("wield fan");
        }
           
        if( weapon ) skill = weapon->query("skill_type");
        else skill = "unarmed";
        
        lv_1 = (int) 1.3 * me->query_skill(skill, 1);
        set_skill(skill, lv_1);

        m_skill = me->query_skill_mapped(skill);
        if( m_skill )
        {
          say("慕容复说: 你使的是"+to_chinese(m_skill)+"吧! 哼我就用它来"
              +"对付你!!\n");
          lv_2 = (int) 1.3 * me->query_skill(m_skill, 1);
          set_skill(m_skill, lv_2);
          map_skill(skill,m_skill);
        }
	fu_weapon->set("skill_type", skill);
	
	exp = 2 * me->query("combat_exp");
        kee = 2 * me->query("max_kee");
        force = 2 * me->query("max_force");
	if( exp > 100000)
	{
       	 set("combat_exp", exp);
         set("max_kee", kee);
         set("eff_kee", kee);
         set("kee", kee);
         set("max_force", force);
         set("force", force);
        } 
         setup();
        return 1;
}

void heart_beat()
{
        mapping exit;
        string *exit_name;
        object env, mob = this_object();
        int i;

        set_heart_beat(1);
        if( mob->is_busy() ) mob->delete_busy();

// 在战斗中寻找出口逃跑, kee < 25% 逃跑
        
        if( mob->is_fighting() && ( query("kee")*100/query("max_kee") < 25) ) 
        {
           env = environment(mob);
           exit = env->query("exits");
           exit_name = keys(exit);
           i = random(sizeof(exit_name));
                command(exit_name[i]);
                if( environment(mob) == env ) 
                {
                    tell_room(environment(mob), name()+"身子一晃就不见了。\n"NOR);
		    move(exit[exit_name[i]]);
                 }
        }

// 有五次补精气神的机会, kee < 50% 补
        if( query_temp("heal") < 5 ) 
        {
            if( query("kee")*100/query("max_kee") < 50 ) 
            {
                mob->receive_curing("kee",180);
                mob->receive_heal("kee",180);
                add_temp("heal", 1);
                tell_room(environment(), HIY+name()+"使出家传绝学,"+
                     "简简单单的治好自己的伤口.\n"+NOR);
            }
        }
        ::heart_beat();
}
