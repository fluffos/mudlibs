//vendor.c
#include "/open/open.h"
inherit F_VENDOR;

void create()
{
	set_name("小贩",({"vendor"}));
	set("gender", "男性" );
	set("age", 27);
	set("long", @LONG

  四处设摊卖些小东西的人,你可以列出(list)他卖些什么...
  
LONG
	);
	set("no_kill",1);
        set("attitude", "friendly");
	set("vendor_goods", ({
		COMMON_OBJ"bandage",
		COMMON_OBJ"pill",
		COMMON_OBJ"pill1",
		COMMON_OBJ"plaster",
                PING_OBJ"cloud",
                CAPITAL_OBJ"tea",
		"/obj/example/wineskin",
		"/obj/example/dumpling",
		"/obj/example/chicken_leg",
	}) );
	setup();
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(3) ) {
		case 0:
                say("小贩靠近你小声的说: 西域神器唤云扇,很有用喔...\n");
			break;
		case 1:
                say("小贩嘶声么\喝道: "+RANK_D->query_respect(ob)
                        +"过来看看吗!?\n");
			break;
		case 2:
		say("小贩高声喊道: 跳楼大拍卖,"+RANK_D->query_respect(ob)
			+"要的话，我可以算便宜一点喔!\n");
			break;
	}
}
