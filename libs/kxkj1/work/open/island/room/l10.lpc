#include "/u/c/cage/lib/cage.h"
#include "/u/c/cage/lib/door.h"
#include <room.h>
inherit ROOM;
void reset() {
  ::reset();
  remove_call_out("reset");
  call_out("reset", 240);
  set("door/north/status", DOOR_LOCK);
  delete("exits/north");
}
void create() {
  set("short", "山洞");
  set("long", @LONG
走到此地,你看到前方有一石门(door)挡在你前面,
这个石门看起来重愈千斤,若想要以人力打开此门,是不可能的。
想必须以机关之物打开,否则是无法进入的。

LONG);
  set("door/north", ([
    "name": "石门",
    "connect": __DIR__ "land0.lpc",
    "relation": "south",
    "status": DOOR_LOCK,
  ]));
  set("exits", ([
    "down": __DIR__ "l9", ]));
  setup();
}
void init() {
  add_action("handle_look", "look");
  add_action("handle_open", "open");
  add_action("handle_close", "close");
  add_action("do_kick", "kick");
}

int handle_look(string str) {
  if (str == "door")
    return (look_door("north", str));
}

int handle_open(string str) {
  return (open_door("north", str));
}

int handle_close(string str) {
  return (close_door("north", str));
}
int do_kick(string str) {
  object who;
  who = this_player();
  if (str == "door")
    tell_room(this_object(), "你看到" + who->query("name") + "很生气地在石门上踢了一下。
不知走了什么好运,竟然让" + who->query("name") + "踢到机关之所在,石门突然[36;1m喀～喳[0m一声,石门的锁跳开了。 \n");
  set("door/north", ([
    "name": "石门",
    "connect": __DIR__ "land0.lpc",
    "relation": "south",
    "status": DOOR_CLOSE,
  ]));
  return 1;
}
