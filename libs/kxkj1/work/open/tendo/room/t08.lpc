// Room: /open/tendo/room/t08.c
#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HIB "§ 昆仑山～太极殿 §" NOR);
  set("long", @LONG
经过了长途跋涉，翻过了丛山峻岭，终于来到了传说中的道家圣
地。你现在所站的位置是位于昆仑山山项的【 太极殿 】。你眼前所
看到是一位有仙风道骨的长者，而他旁边则站着一位三代弟子。此外
在掌门人身旁有幅巨大的太极图(picture) ，据掌门人说: 凡是我派
弟子皆能走入此图到中央驿站去，但别派的就只能用扇子或搭十一号
公车了。

LONG);
  set("item_desc", ([
    "picture": "凡是我派中人可由 into 到中央驿站。\n",
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "t03",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    "/daemon/class/taoist/master_lu": 1,
    "/open/tendo/npc/taoist1": 1,
  ]));
  set("light_up", 1);
  set("valid_startroom", 1);

  setup();
  call_other("/obj/board/tendo_b", "???");
}
void init() {
  add_action("do_into", "into");
}

int do_into() {
  object who;
  who = this_player();

  if (who->query("class") != "taoist")
    return notify_fail("汝非我派中人，不得进入此图。\n");
  who->move("/open/center/room/inn");
  tell_room(this_object(), "你看到" + who->query("name") + "进入太极图中，忽" +
    "的一声，人已不见了。\n");
  return 1;
}
