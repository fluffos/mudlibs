#include "/open/open.h"
inherit NPC;
void create() {
  object ob;
  set_name("小童", ({ "boy" }));
  set("title", "看守");
  set("gender", "男性");
  set("class", "killer");
  set("age", 11);
  set("attitude", "killer");
  set("long", "他在此看守旧玩家所留下来的东西\t
你不要以为他是小孩子就好欺负,若没有一定程度,要杀他是不可能....\n");
  set_skill("rain-throwing", 1);
  map_skill("throwing", "rain-throwing");
  set("kee", 200);
  set("max_kee", 200);
  set("combat_exp", 200);
  setup();
  add_money("gold", 5);
  ob = carry_object("/open/killer/obj/lustar.lpc");
  ob->add_amount(99);
  ob->wield();
}
