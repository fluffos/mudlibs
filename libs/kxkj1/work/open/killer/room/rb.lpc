inherit ROOM;
void create() {
  set("short", "密室");
  set(
    "long",
    @LONG
这是黑牙联用来暗杀个大门派重要人物,所建的密道 
因为有许多的门派令人看守大门,使得杀手们无法顺利进行暗杀行动                     以至于杀手们费了几十年,来建造这个密道,                                          如今此密道已成,但你却不知道他是要通往那里!!

LONG
  );
  set("exits", ([
    "east": __DIR__ "rbe.lpc",
    "west": __DIR__ "rbw.lpc",
    "south": __DIR__ "rbs.lpc",
    "north": __DIR__ "rbn.lpc",
    /*   "up"     : __DIR__"rbu.lpc",
   "down"   : __DIR__"rbd.lpc", */ ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_transmit", 2);
  set("light_up", 1);
  setup();
}
