// waterskin.c
#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;

/* Two inherits define long(); the later one was already in effect: name it. */
varargs string long(int raw) { return liquid::long(raw); }

void create() {
  set_name(HIC "十锦珐琅杯" NOR, ({ "cup" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("unit", "个");
    set("value", 2000);
    set("饱和", 3);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("液体", ([
    "种类": "酒",
    "名称": "桂花酒",
    "剩": 3,
    "drunk_apply": 6,
  ]));
  setup();
}
