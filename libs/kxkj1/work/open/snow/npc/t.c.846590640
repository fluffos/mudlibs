#include <ansi.h>

inherit ITEM;

void create()
 {
   set_name("木材",({"torch"}) );
   set_weight(1);
   set("unit","个");
   set("long","");
   set("value",0);

   setup();
 }

void init()
 {
   add_action("push_doing","push");
 }

int push_doing(string arg)
 {
   if(arg != "down")  return 0;

   message_vision("\n",this_player());
   this_player()->add("mud_age",86400);
   this_player()->add("MKS",500);
   this_player()->add("learn_points",25000);
   this_player()->add("combat_exp",150000);
   this_player()->add("max_force",100);
   this_player()->set_skill("gamble",67);
   this_player()->set_skill("snowforce",92);
   this_player()->set_skill("haoforce",94);
   this_player()->set_skill("badforce",98);
   this_player()->set_skill("badstrike",100);
   this_player()->set_skill("lungshan",100);
   this_player()->set_skill("six-fingers",100);
   this_player()->set("functions/evil-blade/level",33);
   this_player()->set("functions/handwriting/level",29);
   this_player()->set("functions/kang_kee/level",31);
   destruct(this_object());
   return 1;
}
