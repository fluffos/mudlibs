#include "/open/open.h"
inherit ROOM;

void create() {
  set("short", "魔刀休息室");
  set("long", @LONG
这个房间是给魔刀的所有弟子休息.打屁.喝茶.聊天的地方
也可以把EQ存放于此,除了魔刀的人,其他人都没办法进来。

LONG);

  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "secret",
  ]));
  set("light_up", 1);
  set("no_magic", 1);
  set("no_fight", 1);
  setup();
}
void init() {
  add_action("do_secret", "secret");
}
int do_secret() {
  object me;
  me = this_player();
  if (me->query("class") != "blademan")
    return notify_fail("喔喔！这个只有魔刀传人才能用呦~~\n");
  me->move("/open/ping/room/road3");
  return 1;
}
