// char.c

#include <command.h>
inherit NPC;

void init()
{
	::init();
	add_action("order_npc","order");
}

int order_npc(string arg)
{
	mapping dondo;
	object who;
	string npc_name,verb,act,re;
	who = this_player();
	if( !(who->query_temp("lead") ) ||
	who->query_temp("lead") != this_object()->short() )
	return 0;
	if( !arg )
	return notify_fail("你要命令谁？\n");
	if( sscanf(arg,"%s %s %s",npc_name,verb,act) <= 1)
	return notify_fail("请问你想要我帮你做什么事？\n");
	dondo = this_object()->query("not_do");
	if( !(re = dondo[verb]) )
	{
	  tell_object(who,"没问题！\n");
	  command(verb+" "+act);
	  return 1;
	}
	else {
	  return notify_fail(re);
	}
}
