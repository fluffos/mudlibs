inherit BULLETIN_BOARD;

void create() {
  set_name("狂想空间留言版", ({ "board" }));
  set("location", "/open/common/room/inn");
  set("board_id", "fs_b");
  set("long", @LONG
这是专门提供精彩性或具永久性 post 的留言版, 如果你有精彩文章的话,
欢迎来此 post,但是对于发问发牢骚联络感情等文章, 请到其他地方去, 否则
被砍掉可别哭喔!
LONG);
  setup();
  set("capacity", 50);
  // replace_program(BULLETIN_BOARD);
}
