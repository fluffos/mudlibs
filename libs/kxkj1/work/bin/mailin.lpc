#include <stdio.h>

/*  定义信箱的位置  */
#define MBOX	"/home/ice/s00/mail/jjchen"
/*  十分钟检查一次  */
#define DELAY	600

main(int argc, char * argv[]) {
  FILE * fp, *mfp;
  char tmp[81], fn[81];
  char mail[100][255][81];
  int s[100];
  int m; /*  m 封信  */ int n; /*  每封信的行数  */ int i, j, k;

  if (argc != 2) {
    fprintf(stderr, "用法: %s 写到哪里的档\n如:\n\n%s ../data/intermail\n",
      argv[0], argv[0]);
    return (1);
  }
  strcpy(fn, argv[1]);

  while (1) { /*  无限循环  */
    fp = fopen(MBOX, "r");
    if (!fp) return (1);
    mfp = fopen(fn, "a");
    m = -1;
    n = -1;
    fgets(tmp, 80, fp);
    while (!feof(fp)) {
      if (strncmp(tmp, "From ", 5) == 0 && strlen(tmp) > 7) {
        if (m >= 0) {        /*  算是读完一封了, 要重新另一封  */
          s[m] = n + 1;
        }
        m++;
        n = 0;
      } else
        n++;
      strcpy(mail[m][n], tmp);
      fgets(tmp, 80, fp);
    }
    fclose(fp);
    s[m++] = n + 1;
    /*  读完了, 可以砍掉了  */
    fp = fopen(MBOX, "w");

    for (i = 0; i < m; i++) {
      k = 0;
      strcpy(tmp, "");
      for (j = 0; j < s[i]; j++) {
        if (k == 0) {
          if (strlen(mail[i][j]) == 1) {
            k = 1;
          }
        } else if (k == 1) {
          if (sscanf(mail[i][j], "#mailto:%s", tmp) == 1) {
            k = 2;
            if (strncmp(tmp, "#mailto:", 8) == 0)
              sprintf(tmp, ">%s", tmp);
            fprintf(mfp, "#mailto: %s\n", tmp);
          }
        } else if (k == 2) {        /*  表示有找到 #mailto: 字样.  */
          fprintf(mfp, "%s", mail[i][j]);
        }
      }
      if (k != 2) {  /*  表示不是要寄到 mud 里头咧  */
        for (j = 0; j < s[i]; j++) {
          fprintf(fp, "%s", mail[i][j]);
        }
      }
    }
    fclose(fp);
    fclose(mfp);
    sleep(DELAY);
  }
}
