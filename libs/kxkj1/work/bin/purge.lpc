#include <stdio.h>
#include <time.h>
#include <string.h>
#include <dirent.h>

/*  一天 86400 秒 一星期 604800 十天 864000 一个月 259200 三个月 7776000  */
#define SEC_PER_DAY	86400

typedef struct {
  char name[81]; /*  名字          */ char level[13]; /*  巫师等级      */ char boss[11]; /*  boss	  */ int last_on, /*  上次离线时间  */ birthday, /*  注册日期      */ mud_age, /*  总上线时间    */ combat_exp;     /*  实战经验      */
}
user;

typedef struct {
  char name[11];
  char level[13];
  char boss[11];
}
wizard;

main(int argc, char * argv[]) {
  DIR * dirp; /*  目录指标, 由 opendir() 取得  */ struct dirent * de; /*  目录指标内的所有档名, 由 readdir 取得  */ FILE * wizp; /*  wizard data   */ user u; /*  玩家的资料    */ wizard w[512]; /*  巫师的资料    */ int now, /*  现在时刻      */ time_limit, /*  期限, 单位是秒*/ m, i; /*  巫师人数      */ char name[11], /*  for wiz name  */ boss[11], /*  for wiz boss  */ c, /*  ?		  */ path1[81], /*  档名路径      */ dft_path[81];

  if (argc == 1) strcpy(dft_path, "/home/tmp/jjchen/free");
  else strcpy(dft_path, argv[1]);

  /*  读 wiz list  */
  m = 0;
  if ((wizp = fopen("../adm/etc/wizlist", "r")) != NULL)
    fscanf(wizp, "%s %s", w[m].name, w[m].level);
  while (!feof(wizp)) {
    strcpy(w[m].boss, "");
    m++;
    fscanf(wizp, "%s %s", w[m].name, w[m].level);
  }
  fclose(wizp);

  /*  读 wiz boss  */
  if ((wizp = fopen("../adm/etc/wizboss", "r")) != NULL)
    fscanf(wizp, "%s %s", name, boss);
  while (!feof(wizp)) {
    set_wiz_boss(w, m, name, boss);
    fscanf(wizp, "%s %s", name, boss);
  }
  fclose(wizp);

  for (c = 'a'; c <= 'z'; c++) {
    /*  /data/user 里的是玩家的状态资料档  */
    /*  /data/login 里的是玩家 create 时的基本资料  */
    sprintf(path1, "%s/data/user/%c", dft_path, c);
    dirp = opendir(path1); /*  path1 类似于 /data/user/[a-z]  */ if (!dirp)
      return (0);
    /*  打开目录之后一个一个查档, 类似 "ls" 命令  */
    for (de = readdir(dirp); de; de = readdir(dirp)) {
      if (!read_user_dbase(w, m, u, de, path1)) continue;

      if (time_limit = calc_time(u)) {  /*  time_limit != 0 表示受期限影响  */
        time(& now);                     /*  取得现在时刻  */

        /*  底下判定是否要 purge ...  */
        if (u.last_on - now > time_limit) /*  这边只是降巫师的等级    */
          if (!level_down(w, m, u)) {  /*  player 无可降级, 砍档!  */
            sprintf(path1, "%s/%s.o", path1, u.name);
            unlink(path1);
            sprintf(path1, "%s/data/user/%c/%s.o", dft_path, c, u.name);
            unlink(path1);
          }
      }
    } /*  for  */
    /*  本目录找完, 随手关掉  */
    closedir(dirp);
  }

  /*  现在把 wizboss 的资料存档  */
  sprintf(path1, "%s/adm/etc/wizboss", dft_path);
  if (wizp = fopen(path1, "w"))
    for (i = 0; i < m; i++)
      if (!strcmp(w[i].level, "(player)") || w[i].level[0])
        fprintf(wizp, "%s %s\n", w[i].name, w[i].level);
  fclose(wizp);
}

/*  从 /data/user/?/*.o 读资料进来  */
set_dbase(wizard * w, int m, user * u, char * buf, char * name) {
  char level[13], boss[11];

  strcpy(u->name, name);
  if (get_wiz_level(w, m, name, level, boss)) {
    strcpy(u->level, level);
    strcpy(u->boss, boss);
  } else {
    strcpy(u->level, "(player)");
    u->boss[0] = '\0';
  }

  u->last_on = get_int(buf, "last_on");
  u->birthday = get_int(buf, "birthday");
  u->mud_age = get_int(buf, "mud_age");
  u->combat_exp = get_int(buf, "combat_exp");
}

/*  利用关键字从一串字里找一个整数, 请参考 /data/user/?/*.o  */
get_int(char * buf, char * key) {
  char * c, *c1, *c2, *c3, str[20];

  strcat(buf, key);
  c1 = (char *) strstr(buf, key);
  if (c1 - buf + strlen(key) == strlen(buf)) {
    return (-1);
  }
  c2 = (char *) strchr(c1, ',');
  c1 += strlen(key) + 2;
  c3 = str;
  for (c = c1; c < c2; c++, c3++)
    * c3 = * c;
  * c3 = '\0';

  return (atoi(str));
}

/*  从 wade.o 取得名字 wade  */
get_name(char * fn, char * name) {
  char * c, *c1;

  for (c = fn, c1 = name; * c != '.'; c++, c1++)
    * c1 = * c;
  * c1 = '\0';
}

/*  把 boss(name) 的字串设到 wizboss 结构 里  */
set_wiz_boss(wizard * w, int m, char * name, char * boss) {
  int i;

  for (i = 0; i < m; i++)
    if (!strcmp(w[i].name, name)) {
      strcpy(w[i].boss, boss);
      return (1);
    }
}

/*  去 wizlist 的结构找一名 player 的 wizlevel  */
get_wiz_level(wizard * w, int m, char * name, char * level, char * boss) {
  int i;

  for (i = 0; i < m; i++)
    if (!strcmp(w[i].name, name)) {
      strcpy(level, w[i].level);
      strcpy(boss, w[i].boss);
      return (1);
    }
  return (0);
}

/*  用数字表示 wizard level  */
wizardp(user u) {
  char * level;

  level = u.level;

  if (!strcmp(level, "(player)") || !level) return (0);
  else if (!strcmp(level, "(immortal)")) return (1);
  else if (!strcmp(level, "(apprentice)")) return (2);
  else if (!strcmp(level, "(wizard)")) return (3);
  else if (!strcmp(level, "(arch)")) return (4);
  else if (!strcmp(level, "(admin)")) return (5);
  else if (!strcmp(level, "(guest)")) return (6);
  else if (!strcmp(level, "(manager)")) return (7);
  else return (0);
}

/*  允许最久没上线的限制规则, 传回秒数  */
calc_time(user u) {
  int wizlvl;

  if (wizlvl = wizardp(u)) /*  巫师              */
    if (wizlvl < 4)  /*  比 arch 小的巫师  */
      if (u.boss[0])  /*  有 boss           */
        /*  这个 if else 请参考 /doc/help/wiz_rules   */
        if (wizlvl == 3) return (90 * SEC_PER_DAY);
      else return (30 * SEC_PER_DAY);
    else /*  没 boss           */ if (wizlvl == 3) return (30 * SEC_PER_DAY);
  else if (wizlvl == 2) return (10 * SEC_PER_DAY);
  else return (7 * SEC_PER_DAY);
  else return (0);
  else return (90 * SEC_PER_DAY); /*  一般玩家        */
}

/*  从一个档案(de)里读取资料  */
read_user_dbase(wizard * w, int m, user u, struct dirent * de, char * path1) {
  FILE * fp; /*  user data 档  */ char buf[5120], /*  字串的 buffer */ path[81], /*  档名路径      */ * file, /*  档名          */ dir[81];        /*  路径          */

  file = de->d_name;

  /*  守先, 滤掉 (.) (..) 这两个档  */
  if (file[strlen(file) - 1] == '.') /*  通常是 . .. 这两个档  */
    return (0);

  get_name(file, u.name);
  sprintf(path, "%s/%s", path1, file);

  if (fp = fopen(path, "r")) {
    fgets(buf, 5120, fp);
    while (strstr(buf, "dbase") != buf && !feof(fp))
      fgets(buf, 5120, fp);
    set_dbase(w, m, & u, buf, file);
  } else return (0);
  fclose(fp);

  return (1);
}

/*  降级处份, 一般巫师降级传回 1, 如果是 player 降级, 传回 0 以便砍档  */
level_down(wizard * w, int m, user u) {
  char * level;
  int i, flag;

  level = u.level;

  flag = 1;

  /*  先降级  */
  if (strcmp(level, "(wizard)")) strcpy(u.level, "(apprentice)");
  else if (strcmp(level, "(apprentice)")) strcpy(u.level, "(immortal)");
  else if (strcmp(level, "(immortal)")) strcpy(u.level, "(player)");
  else flag = 0;

  /*  再改变 wizlist 的结构内的资料  */
  for (i = 0; i < m; i++)
    if (!strcmp(w[i].name, u.name)) {
      strcpy(w[i].level, u.level);
      break;
    }

  printf("level down %s\n", u.name);

  return (flag);
}
