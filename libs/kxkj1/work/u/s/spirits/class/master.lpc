inherit NPC;
inherit F_MASTER;

void create() {
  set_name("王平", ({ "master wang", "master", "wang" }));
  set("nickname", "如风幻影");
  set("gender", "男性");
  set("age", 35);
  set("long",
    "王平是一位武功\十分高深的武者，他的武功\变化多端，拥有一\n"
    "身的好武艺，他的行踪飘忽不当，爱好游山玩水。\n");

  set("combat_exp", 1000000);
  set("score", 200000);

  set("class", "fighter");

  set("str", 20);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set("force", 700);
  set("max_force", 700);
  set("force_factor", 3);

  set("atman", 1400);
  set("max_atman", 1400);

  set("mana", 2000);
  set("max_mana", 2000);
  set("mana_factor", 5);

  set("inquiry", ([
    "东方神教": "我东方神教是集所有武学于一身的教派,是最有希望成为
           武林盟主的教派。\n"
  ]));

  set("apprentice_available", 5);
  set("chat_chance", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "drainerbolt" :),
    (: cast_spell, "netherbolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "invocation" :),
  }));

  create_family("东方神教", 2, "教主");

  set_skill("literate", 70);
  set_skill("magic", 80);
  set_skill("force", 30);
  set_skill("spells", 100);
  set_skill("scratching", 100);
  set_skill("unarmed", 30);
  set_skill("sword", 40);
  set_skill("parry", 40);
  set_skill("dodge", 40);
  set_skill("gouyee", 60);
  set_skill("taoism", 100);
  set_skill("necromancy", 100);

  map_skill("magic", "taoism");
  map_skill("spells", "necromancy");

  set_temp("apply/dodge", 20);
  set_temp("apply/armor", 20);

  setup();

  //      carry_object(__DIR__"sword")->wield();
  //      carry_object(__DIR__"robe")->wear();
  //      carry_object(__DIR__"hat")->wear();
  //      carry_object(__DIR__"shoe")->wear();
}

void attempt_apprentice(object ob) {
  if (query("apprentice_available")) {
    if (find_call_out("do_recruit") != -1)
      command("say 慢着，一个一个来。");
    else
      call_out("do_recruit", 2, ob);
  } else {
    command("say 我今天已经收了五位徒弟了，不想再收徒了。");
  }
}

void do_recruit(object ob) {
  command("hmm");
  command("say 好!!就收你为徒吧!希望你以后多加努力...");
  command("recruit " + ob->query("id"));
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "fighter");
  add("apprentice_availavble", -1);
}
