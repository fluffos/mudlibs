// Room: 
// 架构 Writed by Server 1995.10.8

inherit ROOM;

void create() {
  set("short", "训练室");
  set("long", @LONG
  这是一间不存在的训练教室。
有一位不存在的老师会提升你的能力。
你可以在这里训练你的精气神(Train)，
你可以先向老师询问需要多少经验值才能提升能力(Cost)。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "inn": "/d/snow/inn.lpc",
  ]));

  setup();
}
void init() {
  add_action("do_cost", "cost");
  add_action("do_train", "train");

}

int do_cost() {
  int num;
  num = this_player()->query("max_gin");
  printf("要提升你的精需要 %d 经验值。\n", (num - 100) * (num - 100));
  num = this_player()->query("max_kee");
  printf("要提升你的气需要 %d 经验值。\n", (num - 100) * (num - 100));
  num = this_player()->query("max_sen");
  printf("要提升你的神需要 %d 经验值。\n", (num - 100) * (num - 100));
  return 1;
}

int do_train(string arg) {
  int num;
  int exp;
  int max_exp;

  if (!arg) {
    write("你可以训练精、气或神(gin,kee,sen)\n");
    return 1;
  };
  switch (arg) {
    case "gin":
      num = this_player()->query("max_gin");
      exp = (num - 100) * (num - 100);
      max_exp = this_player()->query("combat_exp");
      if (max_exp >= exp) {
        this_player()->set("max_gin", num + 1);
        this_player()->set("combat_exp", max_exp - exp);
        printf("你的精从 %d 提升到了 %d \n", num, num + 1);
      } else {
        write("你的经验值不够! \n");
      }
      break;
    case "kee":
      num = this_player()->query("max_kee");
      exp = (num - 100) * (num - 100);
      max_exp = this_player()->query("combat_exp");
      if (max_exp >= exp) {
        this_player()->set("max_kee", num + 1);
        this_player()->set("combat_exp", max_exp - exp);
        printf("你的气从 %d 提升到了 %d \n", num, num + 1);
      } else {
        write("你的经验值不够! \n");
      }
      break;
    case "sen":
      num = this_player()->query("max_sen");
      exp = (num - 100) * (num - 100);
      max_exp = this_player()->query("combat_exp");
      if (max_exp >= exp) {
        this_player()->set("max_sen", num + 1);
        this_player()->set("combat_exp", max_exp - exp);
        printf("你的神从 %d 提升到了 %d \n", num, num + 1);
      } else {
        write("你的经验值不够! \n");
      }
      break;
    default:
      write("你可以训练精、气或神(gin,kee,sen)\n");
      break;
      return 1;
  }
  return 1;
}
