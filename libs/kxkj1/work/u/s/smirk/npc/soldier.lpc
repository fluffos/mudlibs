//禁卫军

#include "/open/capital/capital.h"

inherit NPC;
int i = 0;
int app();

void create() {
  set_name("禁卫军", ({ "soldier" }));
  set("gender", "男性");
  set("age", 21);
  set("class", "soldier");
  set("str", 25);
  set("long", "负责城内的守卫及巡逻工作的士兵，一身军服看起来帅呆了。\n");
  set("combat_exp", 3096);
  set("chat_chance", 10);
  set("chat_msg", ({
    (: this_object(), "around" :),
  }));
  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: this_object(), "app" :),
  }));
  set_skill("blade", 40);
  set_skill("parry", 30);
  set_skill("dodge", 20);
  set_skill("her-blade", 10);
  map_skill("blade", "her-blade");

  setup();
  carry_object(CAP_OBJ "Ns_suit")->wear();
  carry_object(CAP_OBJ "Ns_boots")->wear();
  carry_object(CAP_OBJ "Ns_hat")->wear();
  carry_object(CAP_OBJ "Ns_blade")->wield();
  carry_object(CAP_OBJ "Ns_armor")->wear();
}

int app() {
  object *enemy = this_object()->query_enemy(this_player());
  int i = sizeof(enemy);
  while (i--) {
    if (!enemy[i]->query_temp("kill_soldier")) {
      enemy[i]->set_temp("kill_soldier", 1);
      say("[1;31m大胆" + RANK_D->query_rude(enemy[i]) + enemy[i]->query("name") +
        "，竟敢在天子脚下捣乱。[0m\n");
    }
  }
}

int accept_fight(object who) {
  return notify_fail("禁卫军说：对不起，我正在执行公务。\n");
}

void greeting(object ob) {
  call_out("around", random(20), ob);
  if (ob->query_temp("kill_soldier")) {
    command("stare " + ob->query("id"));
    tell_object(ob, "禁卫军对你喝到你这个扰乱城内秩序的人，还不束手就擒。\n");
    kill_ob(ob);
  } else {
    if (ob->query_temp("pass"))
      command("smile " + ob->query("id"));
    else
      command("stare " + ob->query("id"));
  }
}

int around() {
  object ob = this_object();
  string dir;
  dir = environment(ob)->query("gopath");
  if (!is_fighting()) {
    command("go " + dir);
    i++;
  }
  call_out("around2", random(20) + 10, ob);
  if (i >= 150)
    destruct(ob);
}
int around2() {
  object ob = this_object();
  string dir;
  dir = environment(ob)->query("gopath");
  if (!is_fighting()) {
    command("go " + dir);
    i++;
  }
  call_out("around", random(20) + 10, ob);
}
