//endsword.c
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create() {
  set_name(YEL "龙魂薄刃" NOR, ({ "endsword", "sword" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", MAG "自上古时期就流传下来的一把神刃,据说是由龙神所幻化而成的一把神兵,只有被认定的人能使用之!!!\n" NOR);
    set("value", 3000000);
    set("material", "crimsonsteel");
    set("wield_msg", CYN "有一种声音,突然传进你的耳中:哈哈哈....你就是我寻找多年的人!!\n" HIY "剑身突然发出金光!!\n" NOR);
    set("unwield_msg", MAG "$N手中的剑金光逐渐退去.....\n" NOR);
    setup();
    init_sword(99999);
  }
}
