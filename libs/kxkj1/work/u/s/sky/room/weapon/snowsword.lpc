//snowsword.c
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create() {
  if (clonep())
    set_name(HIM [D [D [D [2 ~[2 ~HIM "雪山冰刃" NOR, ({ "snow sword", "sword" }));
    set_weight(30);
    set_default_object(__FILE__);
    else {
      set("unit", "把");
      set("long", "此剑相传是黄帝所佩的剑,剑上纹着栩栩如生的龙形。\n");
      set("value", 1000000000);
      set("material", "crimsonsteel");

      set("wield_msg", "[B一股寒意涌上心头!!\n" HIG
        "一股浩然正气油然而生...心中呐喊「喝!”\n" NOR);
    }
    setup();
    init_sword(3000);
    }
