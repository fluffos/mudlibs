// Room: /u/l/lum/workroom.c
inherit ROOM;

void create() {
  set("short", "灵魂转换室");
  set("long", @LONG
这里是太空船中最隐密的地方，也是拉姆太空船中最大的秘密，四边的墙上都是一座
座巨大的玻璃箱，仔细一看，吓．．．里面竟然全都是人，其中还有不少是你认识的
名人，这些躯壳就是在必要时提供拉姆转换的身体。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "out": "/u/l/lum/workroom.lpc",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    "/u/w/wade/npc/prog.lpc": 1,
    "/u/s/sky/room/work/garrison_2.lpc": 1,
    "/obj/wiz_cloak.lpc": 1,
  ]));

  set("light_up", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_clean_up", 0);
  set("valid_startroom", 1);
  setup();
}
void init() {
  add_action("do_fire", "is");
}
int do_fire(string str) {
  string ob, player;
  object obj, npc, me;

  seteuid(geteuid());

  me = this_player();
  if (sscanf(str, "%s", player) != 1)
    return 0;
  npc = find_player(player);
  if (!(npc = find_player(player)))
    if (!(npc = find_living(player)))
      if (!(npc = present(player, environment(me))))
        return notify_fail("没这个" + str + "\n");
  npc->set("title", "仙剑派第五代弟子");
  npc->set("nickname", "");
  npc->set_name("星尘", ({ "sky" }));
  npc->set("long", @LONG
LONG);
  me->clear_condition();
  message_vision(sprintf("$N拿着催眠镜喃喃念着:你是小朋友回来吧.....
忽然发现哪里怪怪的!。"),
    this_player());



  return 1;
}
