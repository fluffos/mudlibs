//yu-needle.c
#include <ansi.h>
#include <weapon.h>

inherit STABBER;

void create() {
  set_name(HIR "雪山火玉针" NOR, ({ "yu needle", "needle" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "雪山火玉针是由雪山火玉精炼其粹所制！
雪山火玉色红，温润，具天然的磁性．\n");
    set("unit", "支");
    set("value", 3000);
    set("light_up", -1);
    set("material", "crimsonsteel");
    set("wield_msg", "$N伸手往针袋一掏，忽然一支$n掐在手指间！
散发出一丝丝红色的光芒!\n");
    set("unwield_msg", "$N将手中的$n插入针袋中。\n");
  }
  init_stabber(60);
  setup();
}
