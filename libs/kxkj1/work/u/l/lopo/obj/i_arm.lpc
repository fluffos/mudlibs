//lon_armband.c
#include <ansi.h>
#include <armor.h>

inherit EQUIP;

void create() {
  set_name(HIY "龙鳌护臂" NOR, ({ "lon armband", "armband" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "龙鳌护臂乃取万年龙龟甲药浸, 日晒千日而化！\n");
    set("value", 1000);
    set("material", "steel");
    set("armor_type", "armband");
    set("armor_prop/armor", 3);
  }
  setup();
}
