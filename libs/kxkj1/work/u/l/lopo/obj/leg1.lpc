//snake_legging.c
#include <ansi.h>
#include <armor.h>

inherit EQUIP;

void create() {
  set_name(HIG "青龙绑腿" NOR, ({ "chen legging", "legging" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", "青龙绑腿是由青花蛇皮制成 ！\n");
    set("value", 1000);
    set("material", "steel");
    set("armor_type", "legging");
    set("armor_prop/armor", 3);
    set("armor_prop/dodge", 3);
    set("armor_prop/move", 3);
  }
  setup();
}
