//wu_hands.c
#include <ansi.h>
#include <armor.h>

inherit EQUIP;
void create() {
  set_name(HIY "乌金手套" NOR, ({ "wu hands", "hands" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", "乌金手套乃采深水乌金抽丝编织！\n");
    set("value", 1000);
    set("material", "steel");
    set("armor_type", "hands");
    set("armor_prop/armor", 3);
  }
  setup();
}
