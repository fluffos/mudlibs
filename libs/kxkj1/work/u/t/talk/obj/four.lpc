// knife

#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create() {
  set_name("铅弹", ({ "buttle" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("base_unit", "把");
    set("long",
      " 		这是海外的高级物品
		枪只还在研发中		
		\n");
    set("value", 8000);
    set("material", "steel");
  }
  init_throwing(70);
  set_amount(1);
  set("wield_msg", "$N从腰包小心的\n");
  set("unwield_msg", "$N小心收起$n。\n");

  setup();
}
