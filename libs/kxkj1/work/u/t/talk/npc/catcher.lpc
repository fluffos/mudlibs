//bun.c

#include <ansi.h>

inherit PARTY_NPC;

void create() {
  set_name("摸鱼捕快", ({ "catcher" }));
  set("gender", "男性");
  set("officer_type", "catcher");
  set("class", "officer");
  set("officer_class", "六扇门捕头");
  set("combat_exp", 11550);
  set_skill("sword", 40);
  set("kee", 10000);
  set_temp("apply/attack", 100);
  set_temp("apply/damage", 100);
  set_temp("apply/armor", 100);
  set_skill("dodge", 40);
  set("officer_power", 10);
  set("max_officer_power", 10);
  set("age", 30);
  setup();
  carry_object("obj/longsword")->wield();
}
