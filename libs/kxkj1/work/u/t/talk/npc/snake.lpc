#include <ansi.h>
#include "/open/open.h"
inherit NPC;
void create() {
  set_name("乖乖鱼的尸体", ({ "corpse" }));
  set("gender", "雄性");
  set("age", 10);
  set("race", "野兽");
  set("limbs", ({ "头部", "尾巴", "腹部" }));
  set("verbs", ({ "bite" }));
  set("pursuer", 1);
  set_skill("dodge", 10);
  set_skill("axe", 10);
  set("long", "一只带有剧毒的蛇，牠正对着你昂首吐信。\n");
  set("attitude", "aggressive");
  set_skill("unarmed", 10);
  set_skill("move", 10000);
  set("chat_chance_combat", 5);
  set("chat_msg_combat", ({
    (: this_object(), "special_att" :),
  }));
  setup();
  carry_object("/open/poison/obj/gall.lpc")->set_amount(1);

}
int special_att() {
  object ob = this_object()->query_enemy();
  if (ob->query("family/family_name") != "冥蛊魔教") {

    message_vision("毒蛇突然扑上来向你狠狠的咬了一口。\n", this_object());
    ob->apply_condition("snake_poison", 20);
    return 1;
  }
}
