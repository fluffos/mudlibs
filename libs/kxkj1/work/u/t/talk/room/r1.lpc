// 有暗门的房间 //
#include <mudlib.h>

inherit ROOM;

void create() {
  set("short", "面壁室");
  set("long", @LONG
         "这里是聊天王每日三省吾身之处, 反省今天做了什么坏事.
有机关( search wall ) 还没改好, 所以可以玩
LONG);

  set("item_desc", ([ /* sizeof() == 3 */
    "picture": "聊天之道 第九式 图示
",
    "help": "嘿!嘿!
",
    "mirror": "明心镜
",
  ]));
  set("exits", ([ /* sizeof() == 5 */
    "talk": "/u/t/talk/workroom.lpc",
    "wade": "/u/w/wade/workroom.lpc",
    "pop": "/u/p/ppopp/workroom.lpc",
    "remark": "/u/r/remark/workroom.lpc",
    "okla": "/u/o/oklatalk/workroom.lpc",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "guard": 1,
  ]));


  setup();
}
setup();
void init() {
  add_action("do_search", "search");
}
int do_search(string str) {
  if (str != "wall") return 0;
  message_vision(
    "$N在这里到处乱摸, 突然处碰机关, \n", this_player());
  delete("exits/okla");
  delete("exits/pop");
  delete("exits/talk");
  delete("exits/remark");
  delete("exits/wade");
  set("exits/down", "/u/t/talk/workroom");
  return 1;
}
