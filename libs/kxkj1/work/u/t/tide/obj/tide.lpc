#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIC "明月专用御寒衣" NOR, ({ HIW "tide's cloth" NOR }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("no_sell", 1);
    set("no_drop", 1);
    set("material", "慈母手中线");
    set("armor_prop/armor", 100);
    set("long", "明月平日御寒穿着的衣服。\n");
  }
  setup();
}

void init() {
  if (this_player()->query("id") == "tide") {
    add_action("do_put", "put");
    add_action("do_who", "wwho");
    add_action("do_ease", "ease");
    add_action("do_steal", "steal");
    add_action("do_full", "full");
    add_action("do_wave", "wave");
  }
}

int do_put(string thing) {
  object obj;
  if (!thing || thing == "")
    if (!(obj = present(thing, environment(this_player()))))
      return notify_fail(HIY "<<系统>> 你要丢啥啊...?\n" NOR);

    else {
      obj->move(environment(this_player()));
      write(HIC "<<系统>> 你把" + obj->query("name") + "丢到地上。\n" NOR);
      return 1;
    }
  return 1;
}

int do_who(string arg) {
  object *list;
  int i;
  list = users();
  if (arg && arg != "-w")
    return notify_fail(HIY "<<系统>> 指令格式: wwho [-w]\n");
  for (i = 0; i < sizeof(list); i++) {
    if (arg == "-w") {
      if (!wizardp(list[i])) continue;
      write(sprintf("%-10s %20s(%-10s)\n",
        RANK_D->query_rank(list[i]),
        list[i]->name(),
        list[i]->query("id")));
    }
  }
  return 1;

}

int do_ease(string str) {
  object me, ob;
  me = this_player();

  if (!str || str == "")
    return notify_fail(HIY "<<系统>> 阿没你是要去哪？\n" NOR);

  if (!(ob = find_player(str)))
    if (!(ob = find_living(str))
      return notify_fail(HIY "<<系统>> 现在没这人吧!?\n" NOR);

      if (environment(ob) == environment(me))
        return notify_fail(HIY "<<系统>> 你已在此地了，别脱裤子放屁了。\n" NOR);

        else {
          message_vision(HIC "忽的一阵疾风掠来一朵白色的筋斗云，将$N带走了。\n" NOR, me);
          me->move(environment(ob));
          tell_room(environment(ob), HIC "一朵白云将" + me->query("name") + "送到了此处。\n" NOR);
          return 1;
        }
      return 1;
    }

      int do_steal(string arg) {
        objcet me, pepo, obj;
        string ob, player;
        me = this_player();
        seteuid(getuid());

        if (sscanf(str, "%s from %s", ob, player) != 2)
          return notify_fail(HIY "<<系统>> steal <东西> from <某人>\n" NOR);

        if (!(pepo = find_player(npc)))
          if (!(pepo = find_living(npc)))
            if (!(pepo = present(player, environment(me))))
              return notify_fail(HIY "<<系统>> sorry!!现在没此人喔...:>\n" NOR);

        if (!(obj = present(ob, pepo)))
          return notify_fail(HIY "<<系统>> 这人没那个东东喔...\n" NOR);

        else {
          obj->move(me);
          write(HIC "<<系统>> 恭喜!!你成功的偷了别人的" + obj->query("name") + "\n" NOR);
          return 1
        }
        return 1;
      }

  int do_full(string arg) {
    object me;
    me = this_player();

    if (!arg || arg != me->query("id"))
      return notify_fail(HIY "<<系统>> 你的用法有错误喔...\n" NOR);
    me->set("gin", me->query("max_gin"));
    me->set("kee", me->query("max_kee"));
    me->set("sen", me->query("max_sen"));
    me->set("atman", me->query("max_atman"));
    me->set("force", me->query("max_force"));
    me->set("mana", me->query("max_mana"));
    me->set("food", me->max_water_capacity());
    me->set("water", me->max_food_capacity());
    tell_object(me, HIC "<<系统>> ok。\n" NOR);
    return 1;
  }

  int wave(string arg) {
    string kind;
    int amount;
    object n_money;

    if (!arg || sscanf(arg, "%d %s", amount, kind) != 2)
      return notify_fail("[cloak]: wave <多少钱> <钱币种类>\n");

    n_money = present(kind + "_money", this_player());
    if (!n_money && file_size("/obj/money/" + kind + ".lpc") < 0)
      return notify_fail("你摇了半天却什么也没有出来。\n");
    if (amount < 1)
      n_money->query("base_unit"),
      n_money->query("name")
    ),
    this_player()
  );
return 1;
}
