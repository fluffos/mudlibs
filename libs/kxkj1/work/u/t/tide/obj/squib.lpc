#include <ansi.h>

inherit ITEM;

void create() {
  set_name("鞭炮", ({ "squib" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "串");
    set("long", "这是一串用来欢迎某人的鞭炮，你可以点燃(fire)它。\n");
    set("value", 500);
  }
  setup();
}

void init() {
  add_action("do_light", "light");
}

int do_light(string arg) {
  object me = this_player();
  if (!arg || arg != "squib") return 0;
  message_vision("$N点燃了鞭炮，赶紧丢了出去。\n\n", me);
  tell_room(environment(me), HIB "   鞭 炮 滚 到 你 的 脚 下 ．．．   \n");
  tell_room(environment(me), HIR "　 　 ┌＊  　 　 ＊　  　    　　  \n");
  tell_room(environment(me), "　　┌┴┐    　┌┴┐ 　   ┌＊┐  \n");
  tell_room(environment(me), " 　 │鞭│  →  │鞭│  →  │鞭│  \n");
  tell_room(environment(me), " 　 │炮│　    │炮│    　│炮│  \n");
  tell_room(environment(me), " 　 └─┘      └─┘      └─┘  \n");
  tell_room(environment(me), HIB "         你 正 想 捡 起 它 ．．．   \n");
  tell_room(environment(me), HIY "\n碰．．．" HIG "砰．．．" HIC "乓．．．" NOR "←鞭炮声。\n\n");
  tell_room(environment(me), HIW "恭 喜! 你 省 下 一 笔 烫 发 钱 了....\n\n" NOR);
  destruct(this_object());
  return 1;
}
