#include <ansi.h>

inherit NPC;

void create() {
  set("title", "FS 迷");
  set_name("周会敏", ({ "fs girl", "fs", "girl" }));
  set("long", "一个喜赏「明月”，崇拜「信长”，爱好「风流才子”的美丽女子" +
    "；是FS的爱用者。若不\n是因她「家太远”，你便可以天天和她边吃着「波萝面包”、" +
    "或是「制冰专家”所做的冰\n淇淋，一边欣赏「流云”行水，或者照顾她养的那只名唤" +
    "「小三”的「流浪的小野猫”。\n");
  set("gender", "女性");
  set("age", 20);
  set("attitude", "friendly");

  //set_skill("unarmed",100);
  //set_skill("dodge",100);
  set("combat_exp", 9999990);

  set("chat_chance", 1);
  set("chat_msg", ({
    "周会敏说道：我好喜欢ＦＳ--狂想空间喔。\n",
    "周会敏说道：没事的话就look我喔！\n",
    "周会敏说道：我一定要收集到FS所有巫师的签名。\n",
    "周会敏说道：我今天是来找tide签名的....:b。\n",
    "周会敏说道：我越来越喜欢wade了，FS做的真好。待tide签完名，我就去找他签。\n",
  }));

  set("inquiry", ([
    "明月": "就是这次我找他签名的这个巫师啊!!\n",
    "tide": "tide=明月，do you know...?\n",
    "FS": "这你都不知道，那你现在是在玩哪个MUD呢??\n",
    "ode": "就是明月的师父啊!!明月的本事都是他教的呢!!\n",
    "wade": "FS的天神啊!!听说明月蛮崇拜他的耶!!\n",
  ]));

  setup();

  carry_object("/obj/cloth")->wear();
}

void init() {
  object me;
  ::init();
  if (interactive(me = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 2, me);
  }
}

void greeting(object me) {
  int P;
  P == 0;
  if (!me || environment(me) != environment()) return;
  if (me->query("id") == "tide") {
    say("周惠敏高兴的说：哇！明月来了！签名、签名。\n", me);
    P == P++;
    command("jump");
  }
  if (me->query("id") == "lopo") {
    say("周惠敏雀跃道：哇！是风灵耶....谢谢你那么帮明月。谢谢你。\n");
    P == P++;
    command("kiss " + me->query("id"));
  }
  if (me->query("id") == "oda") {
    say("周会敏惊道：你...你不是明月的师父吗？久仰、久仰...\n");
    message_vision(HIC "周会敏盈盈的向$N磕了个头，说道：我代tide谢谢你。\n" NOR, me);
    P == P++;
    command("thank " + me->query("id"));
  } else if (P == 0) {
    switch (random(3)) {
      case 0:
        say("周会敏问道：你也是来找明月签名的吗？还是有啥事呢？\n"); break;
      case 1:
        say("周会敏说道：我先来的喔；待会儿明月来时，我是第一让他签名的喔。\n");
        break;
      case 2:
        say("周会敏喜道：啊！我认识你，你也是FS的巫师嘛。签名、签名！\n");
        break;
    }
  }
}
