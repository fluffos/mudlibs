#include <ansi.h>
inherit MONEY;

void create() {
  set_name(HIC "采铃勋章" NOR, ({ "fund token", "token" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "coin");
    set("long", "大魔女" + HIC + "采铃" + NOR + "随身携带之物。\n");
    set("unit", "面");
    set("base_value", 1);
    set("base_unit", "面");
    set("base_weight", 1);
  }
  set_amount(1);
}

void init() {
  add_action("do_haha", "haha");
  add_action("do_kee", "kee");
}
int do_haha() {
  object me;
  this_player()->set("friend", ([
    0: "/obj/npc/god",
    1: "/open/snow/npc/liu_che",
  ]));
  me = this_player();
  message_vision(
    HIB "$N的身影随着幻化出的无数黑影而消失。\n" NOR, me);
  me->move("/u/f/fund/workroom");
  message_vision(
    HIB "$N的身影伴随无数黑影而出现。\n" NOR, me);
}
int do_kee() {
  this_player()->set("sec_kee", 1);
  this_player()->set("s_kee", 100);
  this_player()->set("max_s_kee", 100);
  return 1;
}
