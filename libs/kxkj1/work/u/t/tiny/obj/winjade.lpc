inherit EQUIP;
void create() {
  set_name("玉佩", ({ "jade" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "十分普通的一块玉 ,地摊上也买的到。\n");
    set("unit", "块");
    set("armor_type", "nick");
    set("value", 3000);
    set("armor_prop/armor", 3);
    set("wear_msg", "$N把$n戴在脖子上。\n");
  }
}
