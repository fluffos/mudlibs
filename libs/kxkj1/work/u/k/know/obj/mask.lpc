// black_suit.c

#include <armor.h>
#include <ansi.h>

inherit HEAD;

void create() {
  set_name("人皮面具" NOR, ({ "mask", "mask" }));

  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 9999);
    set("material", "head");
    set("armor_prop/armor", 1);
    set("armor_prop/id", ({ "???", "???" }));
    set("armor_prop/name", ({ "宝宝" }));
    set("armor_prop/short", ({ "宝宝(???)" }));
    set("armor_prop/long", ({
      "一个眉头深锁的男子,俊俏的脸庞中带着一丝的忧郁，而满头黑发中一撮突兀的白发遮住了半边的脸庞，更令人有莫测高深的神秘感觉...\n"
    }));
  }
  setup();
}
int query_autoload() {
  return 1;
}
