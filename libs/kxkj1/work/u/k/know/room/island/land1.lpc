inherit ROOM;

void create() {
  set("short", "山谷");
  set("long", @LONG
这里青山环抱,土地平旷,阡陌交错,溪流泉涌,灵秀清幽
一点也看不出,这外面皆是一片断崖所行成的海岛,内部却是如此般的情境。
前方有一村落聚集,在此隐密的岛竟然有人,你不仅想像你来到了桃花源了吗??
你看到后面是藤蔓交错的山壁。
LONG);
  set("light_up", 1);
  set("outdoors", "/open/island");
  set("exits", ([ /* sizeof() == 2 */
    "start": __DIR__ "1.lpc",
    "know": "/u/k/know/workroom",
  ]));
  setup();
}
void init() {
  add_action("do_pass", "pass");
}
int do_pass(string arg) {
  object who;
  who = this_player();

  if (!arg || arg != "rattan")
    return notify_fail("你要通过什么？\n");
  tell_object(who, "你用手拨开藤蔓,向山壁里面走去。\n");
  who->move(__DIR__ "land0.lpc");
  return 1;
}
