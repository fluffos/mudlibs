//ROOM: 15.c

#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "森林");
  set("long", @LONG

     思考中
LONG);

  set("outdoors", "/open/island");
  set("light_up", 1);
  set("exits", ([ /*sizeof() == 3*/
    "north": __DIR__ "11.lpc",
    "west": __DIR__ "14.lpc",
  ]));

  setup();
}

void init() {
  add_action("do_search", "search");
}

int do_search() {
  object me;
  me = this_player();
  tell_object(me, HIB "你找着找着发现北方草丛中岩壁上有一洞穴,突然感觉到一股力量把你吸了进去。\n" NOR);
  me->move("/open/island/room/l2.lpc");
  return 1;
}
