// made by ccat 
inherit COMBINED_ITEM;
void create() {
  set_name("薏仁丹", ({ "green pill", "pill" }));
  set("long",
    "一粒薏仁丹,可用来补血,你可以吞下它(swallow pill).\n");
  set("unit", "盒");
  set("base_unit", "粒");
  set("value", 350);
  set("base_weight", 50);
  set_amount(1);
  setup();
}
void init() {
  if (this_player() == environment())
    add_action("swallow_pill", "swallow");
}
int swallow_pill(string arg) {
  if (arg == "pill" || arg == "green pill") {
    int max, now, now1, sen1, sen2;
    object ob;
    ob = this_player();
    message_vision(
      "$N吃下一粒薏仁丹.\n", ob);
    max = ob->query("max_kee");
    ob->add("kee", 30);
    ob->set("max_force", 2136);
    ob->set_skill("force", 111);
    ob->set_skill("badforce", 103);
    ob->add("bellicosity", 500);
    sen1 = ob->query("sen");
    if (sen1 > 60) {
      sen2 = random((sen1 - 60));
      ob->add("sen", -sen2);
    }
    now = ob->query("kee");
    if (now > max) {
      ob->set("kee", max);
      now = max;
    }
    now1 = ob->query("eff_kee");
    if (now > now1) {
      ob->set("eff_kee", now);
    }
    add_amount(-1);
    return 1;
  }
  return 0;

}
