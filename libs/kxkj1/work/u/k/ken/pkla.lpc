// pkla.c by konn
#include <ansi.h>
inherit F_CLEAN_UP;
int help(object);

int main(object me, string arg) {
  object *pkers;
  int i, j, k, t, from = 0, time = 0;

  seteuid(getuid());
  if (!interactive(me)) return 1;
  if (!arg) return help(me);

  // 列印出目前受挑战的玩家
  arg = lower_case(arg);
  pkers = users();
  if (arg == "list") {
    printf("\n擂台老大:\n");
    for (i = 0; i < sizeof(pkers); i++) {
      if (pkers[i]->query_temp("pker_master"))
        write(sprintf("    %s(%s)\n",
          pkers[i]->name(), pkers[i]->query("id")));
    }
    printf("\n");
    return 1;
  }
  // 巫师不可有以下的参数
  else if (wizardp(me))
    return notify_fail("巫师不能够参加擂台pk!\n");
  else if (me->is_ghost())
    return notify_fail("鬼魂想作什么?\n");
  // 对其他玩家下挑战书
  else if ((me->query("potential") - me->query("learned_points")) < 200)
    return notify_fail("你的潜能不够, 不能参加pk 大赛!\n");
  else if (arg == "me") {
    if (me->query_temp("pker_master"))
      return notify_fail("你已经下挑战书了!\n");
    if (me->query_temp("pker"))
      return notify_fail("你已经接受别人的挑战了!\n");

    for (i = 0; i < sizeof(pkers); i++)
      if (pkers[i]->query_temp("pker_master")) t++;

    if (t >= 1)
      return notify_fail("擂台人数已满, 请稍等一下!\n");

    me->set_temp("pker_master", 1);
    shout(HIC "\n蔡总管喝道: " HIW + me->name() + HIC "愿意接受擂台挑战! " +
      "请各位武林好手前来奉茶!\n" NOR);
    tell_object(me, HIC "\n蔡总管喝道: " HIW + me->name() + HIC "愿意接受擂" +
      "台挑战! 请各位武林好手前来奉茶!\n" NOR);

    me->set_temp("pk_room", 1);
    for (j = 1; j <= 1; j++) {
      for (k = 0; k < sizeof(pkers); k++) {
        if (pkers[k]->query_temp("pk_room") == j) {
          k = sizeof(pkers) + 1;
          me->add_temp("pk_room", 1);
        }
      }
      if (k != sizeof(pkers) + 1) break;
    }
    return 1;
  }
  // 接受玩家的挑战
  else if (arg == "accept") {
    if (me->query_temp("pker_master"))
      return notify_fail("你已经下挑战书了, 不能再接受别人的挑战!\n");
    if (me->query_temp("pker"))
      return notify_fail("你已经接受别人的挑战了!\n");

    for (i = 0; i < sizeof(pkers); i++)
      if (pkers[i]->query_temp("pker_master")) t++;
    if (t == 0)
      return notify_fail("目前擂台没有人, 你愿意挑战别人吗?\n");

    t = random(t);
    for (i = 0; i < sizeof(pkers); i++) {
      if (!pkers[i]->query_temp("fight") &&
        pkers[i]->query_temp("pker_master")) {
        if (from == t) break;
        from++;
      }
    }

    me->set_temp("enemy", pkers[i]->query("id"));
    pkers[i]->set_temp("enemy", me->query("id"));
    me->set_temp("pker", 1);
    me->set_temp("fight", 1);
    pkers[i]->set_temp("fight", 1);
    shout(HIC "蔡总管喝道: " HIW + pkers[i]->name() + HIC "与" HIW +
      me->name() + HIC "将在二分钟后开始比赛!\n" NOR);
    tell_object(me, HIC "蔡总管喝道: " HIW + pkers[i]->name() + HIC +
      "与" HIW + me->name() +
      HIC "将在二分钟后开始比赛!\n" NOR);
    call_out("wait_fight", 120);

    tell_object(pkers[i],
      HIR "蔡总管告诉你: 比赛时间到, 请到比试场参加比赛!\n" NOR);
    tell_object(me,
      HIR "蔡总管告诉你: 比赛时间到, 请到比试场参加比赛!\n" NOR);

    pkers[i]->move("/open/gblade/room/pkr7");
    me->move("/open/gblade/room/pkr7");

    shout(HIC "蔡总管喝道: " HIW + pkers[i]->name() + HIC "与" HIW +
      me->name() + HIC "在第一武道馆开始比赛!\n" NOR);
    tell_object(me, HIC "蔡总管喝道: " HIW + pkers[i]->name() + HIC "与" HIW +
      me->name() + HIC "在第一武道馆开始比赛!\n" NOR);

    tell_object(pkers[i], HIY "\n蔡总管说道: 比赛开始!\n" NOR);
    tell_object(me, HIY "\n蔡总管说道: 比赛开始!\n" NOR);
    tell_object(pkers[i], HIY + "" + me->name() + "弯着腰对你说道: " +
      "请多多指教!\n" NOR);
    tell_object(me, HIY + "" + pkers[i]->name() + "弯着腰对你说道: " +
      "请多多指教!\n" NOR);
    pkers[i]->kill_ob(me);
    me->kill_ob(pkers[i]);
    return 1;
  }
  // 放弃叫阵
  else if (arg == "end") {
    if (!me->query_temp("pker_master") &&
      !me->query_temp("pker"))
      return notify_fail("你并没有参加擂台赛!\n");
    if (me->query_temp("pker"))
      return notify_fail("你已经接受别人的挑战了!\n");
    if (me->query_temp("pker_master") &&
      me->query_temp("fight"))
      return notify_fail("你已经在战斗了!\n");

    me->delete_temp("pker_master");
    shout(HIC "\n蔡总管喝道: " HIW + me->name() + HIC "退出了比赛!" +
      " 请大家踊跃报名!\n" NOR);
    tell_object(me, HIC "\n蔡总管喝道: " HIW + me->name() + HIC "退出了比赛!" +
      " 请大家踊跃报名!\n" NOR);
    return 1;
  } else return help(me);
}

void wait_fight() {
  return;
}

int help(object me) {
  write(@HELP

指令格式: pkla <me>|<accept>|<end>|<list>

pkla me       是用来叫阵, 以寻求玩家来与你pk。若想
              放弃可下pkla end。
pkla accept   用来接受对方的挑战, 但无法决定对手。
pkla end      可用此命令来取消对其他玩家所下的挑战
              , 若挑战被接受, 则此命令无效!
pkla list     列出现在接受挑战的玩家们。


HELP);
  return 1;
}
