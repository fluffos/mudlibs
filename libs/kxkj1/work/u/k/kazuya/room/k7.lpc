#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "思亭");
  set("long", @LONG
每当小阎王在烦恼时,就会来这里散心.....
    亭子上刻着
            
            情到情无天已老
              海至海枯地亦荒
                过往人间笑人生
                  客留丛中闻花香
                  
 这句诗充份写出其心中的无奈与悲伤～～～～～～

LONG);
  set("light_up", 1);
  setup();
}
void init() {
  object me;
  me = this_player();
  if (!interactive(me)) return;
  if (me->query("id") == "kazuya") return;
  if (me->query_temp("totoro") != 1 &&
    me->query("nala") != 1) {
    me->move("/u/k/kazuya/workroom");
    tell_object(me, HIB "\n      对不起,这个除了主人外,不准他人进入 \n" NOR);
  }
}
