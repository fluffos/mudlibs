inherit ROOM;

void create() {
  set("short", "喜欢");
  set("long", @LONG


  [1;37m                好喜[1;31m欢你[0m[1;37m好喜欢[1;31m你好[0m[1;37m喜欢
                  你[1;31m好喜欢你[0m[1;37m好[1;31m喜欢你好[0m[1;37m喜
                  [1;31m喜欢你好喜欢你好喜欢你    [33m送给我最喜欢的
                  [1;31m你好喜欢你好喜欢你好喜            [33m ～ verena[0m
  [1;37m                欢[1;31m你好喜欢你好喜欢你[0m[1;37m好
