void init() {
  object me = this_player();
  add_action("do_apple", "apple");
  if (!interactive(me)) return;
  if (me->query("id") == "kazuya" || me->query("id") == "nala") return;
  me->move("/u/k/kazuya/workroom");
  tell_object(me, HIB "\n      对不起,未经许\可请勿进入!! \n" NOR);
}

int do_apple(string str) {
  object who = this_player();
  who->move("/u/k/kazuya/workroom");
  return 1;
}
