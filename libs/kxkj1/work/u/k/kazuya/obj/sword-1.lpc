#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {

  seteuid(geteuid());
  set_name("[1m[36m□[37m□[36m□[37mb[0m", ({ "Sad sword", "sword" }));
  set_weight(5000);
  set("value", 10000);
  set("light_up", -1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "\n
                 半 筝 永 是 花 中 泥，
                 瑟 刃 已 成 忘 情 诗；
                 傲 笑 人 间 风 云 客，
                 愁 月 从 此 落 天 池。\n");
    set("material", "blacksteel");
    set("wield_msg", "$N无奈的将$n从剑鞘抽出,不堪回味的往事又坜坜在目,
$N深深地感到世事无情啊～。\n");
    set("unwield_msg", "$N将$n插入背后的剑鞘中。\n");
    init_sword(100);
  }
  setup();
}
int query_autoload() {
  return 1;
}
