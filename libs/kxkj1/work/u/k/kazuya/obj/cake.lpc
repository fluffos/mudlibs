//cake by know

inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIY "一片特制的蜂蜜生日蛋糕" NOR, ({ "cake" }));
  set_weight(100);
  set("unit", "片");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 1000000);
    set("long", "哇!!!这是一片从18寸大蛋糕切下来的蛋糕,看起来真是与众不同呀,它完全是用蜂蜜和
鸡蛋为主的原料所精心调制的蛋糕,最特别的是根本看不到会令人发胖的奶油耶。\n");
  }
}

void init() {
  if (this_player() == environment())
    add_action("do_eat", "eat");
}

int do_eat(string arg) {
  if (!arg || arg != "cake")
    return notify_fail("妳要吃啥？\n");

  message_vision(HIC "$N仔细一闻发觉好香好香,嘴巴张的大大的一口把它放进嘴中
" HIG "从$N的表情看出来一定是天下少有的美味....hmm...好想再吃一口....\n" NOR, this_player());

  destruct(this_object());
  return 1;
}
