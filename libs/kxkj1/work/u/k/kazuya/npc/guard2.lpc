#include <command.h>
#include <ansi.h>
inherit NPC;

void create() {
  set_name("灵界侦探", ({ "guard" }));
  set("title", "小阎王直属");
  set("gender", "男性");
  set("age", 20);
  set("attitude", "heroism");
  set("long", @LONG
他奉命看管灵界之门,以免遭受魔界的袭击.
LONG);

  set("combat_exp", 1000000);
  set("str", 30);
  set("con", 20);
  set("int", 30);
  set("per", 40);
  set("cps", 30);
  set("kar", 30);
  set_skill("lungshan", 200);
  set_skill("black-steps", 200);
  set_skill("haoforce", 100);
  set_skill("force", 120);
  set("force", 5000);
  set("force_factor", 100);
  set("max_force", 5000);
  set("max_kee", 3000);
  set("kee", 3000);
  map_skill("parry", "lungshan");
  //  map_skill("unarmed","lungshan");
  map_skill("dodge", "black-steps");
  map_skill("move", "black-steps");
  map_skill("force", "haoforce");
  set("chat_chance_combat", 30);
  set("functions/kang_kee/level", 100);
  set("chat_msg_combat", ({
    //   (: perform_action,"force.kang_kee" :)
    // (: do_special :)
  }));
  set_temp("apply/armor", 400);
  set_temp("apply/damage", 100);
  setup();
  set("default_actions", (: call_other, __FILE__, "query_action" :));
  reset_action();
}

void greeting(object who) {
  if (who->query("id") == "kazuya" && who->query("name") == "小阎王") {
    command("bow");
    command("say " + who->query("name") + "大人你好  :)");

    /*      if(who->query("id")=="nala" && who->query("name")=="娜娜"
        || who->query("id")=="snow" && who->query("name")=="雪菜"
        || who->query("id")=="ahnu" && who->query("name")=="阿奴")
          {
              command("bow "+who->query("id"));
              command("say 妳好,"+who->query("name")+"小姐 :D");
          }return; */

  } else {
    command("say 欢迎你到灵界来 :) ");
  }

  if (who->query("id") == "nala" && who->query("name") == "娜娜"
    || who->query("id") == "snow" && who->query("name") == "雪菜"
    || who->query("id") == "ahnu" && who->query("name") == "阿奴") {
    command("bow " + who->query("id"));
    command("say 妳好," + who->query("name") + "小姐 :D");
  }
  return;
}

//void do_special();

mapping *action = ({
  ([ "action": "$N凝聚力量,大喊一声: ‘ 灵 丸 ’， 只见一个光球从$N手中
飞射而出，对准$n射来。",
    "dodge": -30,
    "parry": -50,
    "damage": 200,
    "force": 100,
    "damage_type": "内伤",
  ]),
});

mapping query_action() {
  return action[random(sizeof(action))];
}

