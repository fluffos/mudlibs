    des2 = replace_string(des, des1, "");
    user->set("long", des2);
    message_vision("$N脱下了天使之戒,头上的光环渐渐消逝.\n", user);
    set_heart_beat(0);
  }
  return 0;
}

int do_quit() {
  object this;
  string des, des1, des2;
  this = this_object();
  if (this == user->query_temp("angle_ring")) {
    user->delete_temp("angle_ring");
    des = user->query("long");
    des1 = HIW + (string)user->query("name") + "头上有个明亮的白色光环" + NOR + "\n";
    des2 = replace_string(des, des1, "");
    user->set("long", des2);
    message_vision("$N脱下了天使之戒,头上的光环渐渐消逝.\n", user);
    set_heart_beat(0);
  }
  return 0;
}


int do_auc(string str) {
  object ob, this;
  string des, des1, des2;
  if (!str) return 0;
  this = this_object();
  if (!objectp(ob = present(str, user)))
    return notify_fail("你身上没有这样东西。\n");
  if (this != ob) return 0;
  if (this == user->query_temp("angle_ring")) {
    user->delete_temp("angle_ring");
    des = user->query("long");
    des1 = HIW + (string)user->query("name") + "头上有个明亮的白色光环" + NOR + "\n";
    des2 = replace_string(des, des1, "");
    user->set("long", des2);
    message_vision("$N脱下了天使之戒,头上的光环渐渐消逝.\n", user);
    set_heart_beat(0);
  }
  return 0;
}


void heart_beat() {
  int max, now, fce, nfc;
  if (!query("equipped")) return;
  if (user->query_temp("ghost")) return;
  max = (int)user->query("max_kee");
  now = (int)user->query("kee");
  fce = (int)user->query("max_force");
  nfc = (int)user->query("force");
  if (max > now) {
    user->receive_curing("kee", (max - now));
    user->receive_heal("kee", (max - now));
    if (nfc < fce) user->set("force", fce);
    message_vision(HIM + "$N头上的光环降下环绕$N全身，$N的伤口复原.\n" + NOR, user);
  }
}
