// 二版,改正以往须call 一个隐形怪兽的缺点,使用的变数也大为简化.


#include <ansi.h>
#include <armor.h>
inherit EQUIP;

object user;

void create() {
  set_name(HIW + "天使之戒" + NOR, ({ "angle_ring", "ring" }));
  set_weight(2500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 15000);
    set("material", "steel");
    set("armor_type", "finger");
    set("armor_prop/armor", 700);
  }
  setup();
}

void init() {
  if (this_player() == environment(this_object())) {
    add_action("do_quit", "quit");
    add_action("do_drop", "drop");
    add_action("do_auc", "auc");
    add_action("do_wear", "wear");
    add_action("do_give", "give");
    add_action("do_remove", "remove");
    add_action("do_sell", "sell");
    user = this_player();
  }
}

int do_wear(string str) {
  object ob, this;
  string des, des1, des2;
  if (!str) return 0;
  this = this_object();
  if (str != "all") {
    if (!objectp(ob = present(str, user)))
      return notify_fail("你身上没有这样东西。\n");
    if (this != ob) return 0;
  }
  if (!(user->query_temp("angle_ring")) && user == environment(this)) {
    user->set_temp("angle_ring", this);
    message_vision("\n$N戴上天使之戒,头上多了一道光环.\n", user);
    set_heart_beat(1);
    if (!user->query("long"))
      user->set("long", HIW + user->query("name") +
        "头上有个明亮的白色光环" + NOR + "\n");
    else {
      des = user->query("long");
      des1 = HIW + (string)user->query("name") + "头上有个明亮的白色光环" + NOR + "\n";
      des2 = replace_string(des, des1, "");
      //      user->set("long",des2);
      user->set("long", des2 + HIW + user->query("name") +
        "头上有个明亮的白色光环" + NOR + "\n");
    }
  }
  return 0;
}

int do_drop(string str) {
  object ob, this;
  string des, des1, des2;
  if (!str) return 0;
  this = this_object();
  if (str != "all") {
    if (!objectp(ob = present(str, user)))
      return notify_fail("你身上没有这样东西。\n");
    if (this != ob) return 0;
  }
  if (this == user->query_temp("angle_ring") && !(this->query_temp("secured"))) {
    user->delete_temp("angle_ring");
    des = user->query("long");
    des1 = HIW + (string)user->query("name") + "头上有个明亮的白色光环" + NOR + "\n";
    des2 = replace_string(des, des1, "");
    user->set("long", des2);
    message_vision("$N脱下了天使之戒,头上的光环渐渐消逝.\n", user);
    set_heart_beat(0);
  }
  return 0;
}

