int do_give(string str) {
  object ob, this;
  string des, des1, des2;
  string item, ppl;
  if (!str) return 0;
  this = this_object();
  if (sscanf(str, "%s to %s", item, ppl) == 2
    || sscanf(str, "%s %s", ppl, item) == 2);
  if (!item || !objectp(ob = present(item, user)))
    return notify_fail("你身上没有这样东西。\n");
  if (this != ob) return 0;
  if (this == user->query_temp("angle_ring") && !(this->query_temp("secured"))) {
    user->delete_temp("angle_ring");
    des = user->query("long");
    des1 = HIW + (string)user->query("name") + "头上有个明亮的白色光环" + NOR + "\n";
    des2 = replace_string(des, des1, "");
    user->set("long", des2);
    message_vision("$N脱下了天使之戒,头上的光环渐渐消逝.\n", user);
    set_heart_beat(0);
  }
  return 0;
}

