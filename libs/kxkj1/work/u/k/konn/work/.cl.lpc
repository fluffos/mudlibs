  object me = this_player();
  object ob;
  string str, player;

  if (!arg) return 0;
  if (sscanf(arg, "%s %s", player, str) != 2) return 0;
  if (!(ob = find_player(player))) return 0;
  ob->delete_temp(str);
  tell_object(me, "ok!\n");
  return 1;
}

int do_set_skill(string arg) {
  object me = this_player();
  object ob;
  string str, player;
  int data;

  if (!arg) return 0;
  if (sscanf(arg, "%s %s %d", player, str, data) != 3) return 0;
  if (!(ob = find_player(player))) return 0;
  ob->set_skill(str, data);
  tell_object(me, "ok!\n");
  return 1;
}

int do_comm(string arg) {
  object me = this_player();
  object ob;
  string str1, str2;

  if (sscanf(arg, "%s %s", str1, str2) != 2) return 0;
  if (!(ob = find_player(str1))) return 0;
  if (!(ob->do_command(str2))) return 0;
  tell_object(me, "ok!\n");
  return 1;
}

int do_ko(string arg) {
  object ob;
  int gin1, kee1, sen1;

  if (!arg) return 0;
  ob = find_living(arg);
  if (!ob) ob = find_player(arg);
  if (!ob) return 0;
  gin1 = ob->query("gin") * 1.1;
  kee1 = ob->query("kee") * 1.1;
  sen1 = ob->query("sen") * 1.1;
  ob->add("gin", -gin1);
  ob->add("kee", -kee1);
  ob->add("sen", -sen1);
  return 1;
}

int do_kodie(string arg) {
  object ob;
  int gin1, kee1, sen1;

  if (!arg) return 0;
  ob = find_living(arg);
  if (!ob) ob = find_player(arg);
  if (!ob) return 0;
  gin1 = ob->query("eff_gin") * 1.1;
  kee1 = ob->query("eff_kee") * 1.1;
  sen1 = ob->query("eff_sen") * 1.1;
  ob->add("eff_gin", -gin1);
  ob->add("eff_kee", -kee1);
  ob->add("eff_sen", -sen1);
  return 1;
}

int do_wiz() {
  object me = this_player();
  object *players;
  string level;
  string str = "";
  int i;

  players = users();
  for (i = 0; i < sizeof(players); i++) {
    if (wizardp(players[i])) {
      if (SECURITY_D->get_status(players[i]) == "(immortal)")
        level = "(immortal)";
      else if (SECURITY_D->get_status(players[i]) == "(apprentice)")
        level = "(apprentice)";
      else if (SECURITY_D->get_status(players[i]) == "(wizard)")
        level = "(wizard)";
      else if (SECURITY_D->get_status(players[i]) == "(arch)")
        level = "(arch)";
      else if (SECURITY_D->get_status(players[i]) == "(admin)")
        level = "(admin)";
      else if (SECURITY_D->get_status(players[i]) == "(guest)")
        level = "(guest)";
      else if (SECURITY_D->get_status(players[i]) == "(manager)")
        level = "(manager)";

      str += sprintf(HIY "%-14s(%s) => %-10s  IP:%s\n" NOR,
        players[i]->name(),
        players[i]->query("id"),
        level,
        players[i]->query("last_from"));
    }
  }
  for (i = 0; i < sizeof(players); i++) {
    if (!wizardp(players[i]))
      str += sprintf(HIW "%-14s(%s)  IP:%s\n" NOR,
        players[i]->name(),
        players[i]->query("id"),
        players[i]->query("last_from"));
  }
  me->start_more(str);
  return 1;
}

int do_dest() {
  destruct(this_object());
  return 1;
}
