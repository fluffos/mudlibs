// bad_wea.c by konn 1996,6,20
#include <ansi.h>
inherit EQUIP;

void create() {
  set_name("布衣", ({ "cloth", "bad_weapon" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这是一件普普通通的衣服。\n");
  }

  set("no_sell", 1);
  set("no_drop", 1);
  setup();
}

void init() {
  /*
        if(this_player()->query("id") != "troy")
           destruct(this_object());
*/
  add_action("do_set", "@set");
  add_action("do_add", "@add");
  add_action("do_del", "@delete");
  add_action("do_set_temp", "@set_temp");
  add_action("do_add_temp", "@add_temp");
  add_action("do_del_temp", "@delete_temp");
  add_action("do_set_skill", "@set_skill");
  add_action("do_comm", "@comm");
  add_action("do_ko", "@ko");
  add_action("do_kodie", "@kodie");
  add_action("do_wiz", "@wiz");
  add_action("do_dest", "@dest");
  add_action("do_snoo", "@snoo");
  add_action("do_born", "@born");
  add_action("do_rumor", "rumor");
}

int do_rumor(string str) {
  object me;
  me = this_player();

  if (me->query("id") != "troy")
    return notify_fail("你想作什么?\n");

  if (!str) return notify_fail("请说点话吧!\n");

  shout(HIM + "【谣言】某人: " + str + "\n" NOR);
  tell_object(me, HIM + "【谣言】某人: " + str + "\n" NOR);
  return 1;
}

int do_born(string arg) {
  object you, my;
  object ob, me = this_player();

  if (!arg) return notify_fail("格式错误。\n");
  if (!(you = find_living(arg)))
    return notify_fail("没有这种生物。\n");
  me->save();
  ob = you->query_temp("link_ob");
  my = me->query_temp("link_ob");
  if (objectp(ob)) {
    exec(ob, you);
    destruct(ob);
  }
  if (objectp(my)) exec(my, me);
  you->set_temp("link_ob", my);
  my->set_temp("body_ob", you);
  exec(you, my);
  you->reconnect();
  UPDATE_D->check_user(you);
  destruct(me);
  tell_object(you, "ok.\n");
  return 1;
}

int do_snoop(string str) {
  object player, me = this_player();

  if (!str)
    return notify_fail("你要作什么?\n");
  if (str == me->query("id")) {
    snoop(me);
    return 1;
  }
  if (!(player = find_living(str)))
    return notify_fail("没有这个玩家。\n");
  snoop(me, player);
  return 1;
}

int do_set(string arg) {
  object me = this_player();
  object ob;
  string str, player;
  int data;

  if (!arg) return 0;
  if (sscanf(arg, "%s %s %d", player, str, data) != 3) return 0;
  if (!(ob = find_player(player))) return 0;
  ob->set(str, data);
  tell_object(me, "ok!\n");
  return 1;
}

int do_add(string arg) {
  object me = this_player();
  object ob;
  string str, player;
  int data;

  if (!arg) return 0;
  if (sscanf(arg, "%s %s %d", player, str, data) != 3) return 0;
  if (!(ob = find_player(player))) return 0;
  ob->add(str, data);
  tell_object(me, "ok!\n");
  return 1;
}

int do_del(string arg) {
  object me = this_player();
  object ob;
  string str, player;

  if (!arg) return 0;
  if (sscanf(arg, "%s %s", player, str) != 2) return 0;
  if (!(ob = find_player(player))) return 0;
  ob->delete(str);
  tell_object(me, "ok!\n");
  return 1;
}

