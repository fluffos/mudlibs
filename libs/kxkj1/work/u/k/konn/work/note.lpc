// note.c  made by konn

inherit ITEM;

void create() {
  set_name("小纸条", ({ "note" }));
  set_weight(10);
  set("long", "\n" +
    "医者公会暗门 \"doctor\"\n\n" +
    "                        密道地图

                 以             ◎
                 后             |
                 若     # - # - # - # - #
                 还     |           |   |
                 需     # - # - #   #   # - #
                 要             |
                 这             @ - # - #
                 张             |       |
                 纸             #   # - #
                 条             |
                 ，         # - #
                 只         |   |
                 须     # - #   #
                            |
       ask leen about 密道  #

              @: 进入密道后所在位置
             ◎: 地道出口
      ");

  set("no_drop", 1);
  set("no_sell", 1);
  set("no_give", 1);
  set("light_up", -1);
  setup();
}
