// shinnoforce.c
//神农琉璃心法
//god plant      ====神仙草
//linju plant    ====灵芝草
//fulin plant    ====伏苓草
//liyu eye       ====冰睛雪鲤眼
//dragon heart   ====毒龙心
//hu beat        ====金刀门内仙鹤脑
//rose flower    ====火玫瑰花
//smell          ====香烟草
//li lin         ====冰睛雪鲤鳞
//li gain        ====冰睛雪鲤肝
//god dog plant  ====金毛狗

#include <ansi.h>
inherit SKILL;

mapping make = ([

  "nine-pill": ([ 1: "god plant",
    2: "linju plant",
    3: "fulin plant",
    4: "liyu eye",
  ]),

  "hwehwun-pill": ([ 1: "linju plant",
    2: "fulin plant",
    3: "dragon heart",
  ]),

  "yunshon-pill": ([ 1: "linju plant",
    2: "li eye",
    3: "fulin plant",
  ]),

  "linju-pill": ([ 1: "linju plant",
    2: "hu beat",
  ]),


  "yulu-pill": ([ 1: "rose fllower",
    2: "li lin",
  ]),

  "chanshin-pill": ([ 1: "fulin plant",
    2: "linju plant",
  ]),

  "deflower-pill": ([ 1: "smell",
    2: "li gain",
    3: "fulin plant",
  ]),

  "health-pill": ([ 1: "linju plant",
  ]),

  "outheal-pill": ([ 1: "gold dog plant",
  ]),

]);

mapping make_name = ([
  "nine-pill": "九转金丹",
  "hwehwun-pill": "云青回魂丹",
  "yunshon-pill": "白云熊胆丸",
  "linju-pill": "仙鹤灵芝丸",
  "yulu-pill": "百花玉露丸",
  "chanshin-pill": "清心健脑丸",
  "deflower-pill": "三步回春丹",
  "health-pill": "固本培元丹",
  "outheal-pill": "狗皮药膏",
]);

// 要做药所需的最小内功等级

mapping make_need_lv = ([
  "nine-pill": 75,
  "hwehwun-pill": 50,
  "yunshon-pill": 50,
  "linju-pill": 40,
  "yulu-pill": 40,
  "chanshin-pill": 40,
  "deflower-pill": 30,
  "health-pill": 20,
  "outheal-pill": 20,
]);

int valid_enable(string usage) {
  return (usage == "cure") || (usage == "force");
}


int valid_learn(object me) {
  return 1;
}

int practice_skill(object me) {
  return notify_fail("神农琉璃心法只能用学的。\n");
}

int make(object me, string name) {
  object medicine;
  int i;
  mapping dict;
  string pstr = "";

  if (!make[name])
    return notify_fail("神农医术中没有这种丹丸的炼制方法, 你想自己炼炼看吗?\n");

  if (me->query_skill("shinnoforce", 1) < make_need_lv[name])
    return notify_fail("你的医术修为不够，无法配制这种药。\n");

  dict = make[name];
  for (i = 1; i <= sizeof(dict); i++) {
    if (!present(dict[i], me))
      return notify_fail("你的药材不够，没办法炼这种药。\n");
    medicine = present(dict[i], me);
    pstr += "(" + medicine->name() + ")";
  }
  message_vision(HIY "$N用" + pstr + "来做" + make_name[name] + "。\n" NOR, me);
  for (i = 1; i <= sizeof(dict); i++)
    destruct(present(dict[i], me));
  medicine = new("obj/medicine/" + name);
  medicine->set("medicine_power", me->query_skill("cure"));
  medicine->move(me);
  return 1;
}
