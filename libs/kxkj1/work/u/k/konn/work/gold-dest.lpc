#include <combat.h>
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  object *enemy, ob;
  int damage, i;
  enemy = me->query_enemy();
  i = sizeof(enemy);

  if ((string)me->query_skill_mapped("blade") != "gold-blade")
    return notify_fail("只有在使紫金六阳刀法时才能使出千人斩。\n");
  if (!(ob = me->query_temp("weapon")) ||
    (string)ob->query("skill_type") != "blade")
    return notify_fail("只有在使紫金六阳刀法时才能使出千人斩。\n");
  if (me->query_skill("gold-blade", 1) < 50)
    return notify_fail("你的紫金六阳刀法根基不够，" +
      "没办法使出千人斩。\n");
  if (!me->is_fighting())
    return notify_fail("千人斩只能在战斗中使用。\n");
  if (me->query("force") < 300)
    return notify_fail("你的内力不够。\n");

  message_vision(HIY "$N虎吼一声 , 使出金刀绝学「千人斩”" +
    ",刀气分击各敌 !\n" NOR, me);

  damage = me->query("force") / 4 + me->query_skill("gold-blade", 1) / 2;
  me->add("force", -250);

  while (i--) {
    if (random(me->query("combat_exp")) > 0.01 * random(enemy[i]->query("combat_exp"))) {
      enemy[i]->receive_wound("kee", damage);
      message_vision(HIR "$N闪躲不及 , 刀气从胸膛贯穿而过 !\n" NOR, enemy[i]);
      COMBAT_D->report_status(enemy[i]);
    } else message_vision(YEL "$N机灵的躲过了刀气 !\n" NOR, enemy[i]);
  }
  return 1;
}
