// start.c bye konn

inherit F_CLEAN_UP;

int main(object me, string arg) {

  seteuid(getuid());

  if (arg)
    return notify_fail("你下的命令太长了! help start 看一下吧!\n");

  if (me->is_fighting())
    return notify_fail("战斗中想偷溜? 先把你的敌人解决了再说吧!\n");

  message_vision("忽然从地底冒出一只大手将$N抓住...\n", me);
  me->move("/open/center/room/inn");
  tell_room(environment(), "只见" + me->query("name") + "缓缓的从地底" +
    "走了上来!\n");

  return 1;
}

int help(object me) {
  write(@HELP
当你迷路时, 可以下"start"此命令, 便送你到中央驿站。

also see : waveto (须有fan 才能用)

HELP);
  return 1;
}
