// quests.c bye konn
#include <obj.h>
#include <login.h>
#include <ansi.h>

string *quests = ({
  CYN "狂想空间的大神是谁?\n" NOR,
});

string *answers = ({
  "wade和lum",
});

string ask_quests(object me) {
  object obj = this_object();
  int i;

  write(CYN + obj->name() + "问道: \n" NOR);
  i = random(sizeof(quests));
  write(CYN + quests[i] + NOR);
  return answers[i];
}

private mapping wiz_status;
private mapping wiz_boss;

int doing_set(object me, string uid, string str_2) {
  string *wizlist, *wiz, wizl;
  int i;

  wizlist = explode(read_file(WIZBOSS), "\n");
  wiz_boss = allocate_mapping(sizeof(wizlist));
  wizlist = explode(read_file(WIZLIST), "\n");
  wiz_status = allocate_mapping(sizeof(wizlist));

  if (str_2 == "(player)") {
    map_delete(wiz_status, uid);
    map_delete(wiz_boss, uid);
  } else {
    wiz_status[uid] = str_2;
    wiz_boss[uid] = me->query("id");
  }
  wiz = keys(wiz_status);
  for (wizl = "", i = 0; i < sizeof(wiz); i++)
    wizl += wiz[i] + " " + wiz_status[wiz[i]] + "\n";
  rm(WIZLIST);

  if (write_file(WIZLIST, wizl)) return 1;
  else return 0;
}
