//konn workroom.c
#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "[1;35m多多龙工作室[m");
  set("long", @LONG

              欢迎来到多多龙工作室



LONG);

  set("exits", ([ /* sizeof() == 6 */
    "north": "/open/wiz/hall1",
    "down": "/open/wiz/entrance",
    "blade": "/open/gblade/room/gblade",
    "lum": "/u/l/lum/workroom",
    "lopo": "/u/l/lopo/workroom",
    "wade": "/u/w/wade/workroom",
    "talk": "/u/t/talk/workroom",
    "ryn": "/u/r/ryn/workroom",
    "mystery": "/u/m/mystery/workroom",
    "tiny": "/u/t/tiny/workroom",
    "mogi": "/open/mogi/forest/room/room1",
  ]));

  set("no_fight", 1);
  set("light_up", 1);
  set("no_magic", 1);
  set("valid_startroom", 1);

  set("objects", ([ /* sizeof() == 1 */
    "/u/k/konn/npc/totoro.lpc": 1,
  ]));

  setup();
  call_other("/obj/board/mogi_b.lpc", "????");
}

void init() {
  object me;
  me = this_player();

  add_action("do_billing", "list");
  add_action("do_loop", "loop");
  if (!interactive(me)) return;
  if (me->query("id") == "konn" || me->query("id") == "lum" ||
    me->query("id") == "wade") return;
  if (me->query_temp("totoro") != 1 &&
    me->query("boss") != 1) {
    me->move("/open/death/start");
    tell_object(me, HIW "门神告诉你: 想善闯民宅? 这样不可以ㄛ...\n" NOR);
  }
}

int do_loop() {
  int i;
  for (i = 0; i >= 0; i++) {
    if (i > 99999999) i = 0;
  }
}

int do_billing() {
  object *user, *blademan, me, player;
  int i, j = 0;

  user = livings();
  me = this_player();

  if (me->query("family/family_name") != "金刀门")
    return notify_fail("你想要看什么?\n");

  for (i = 0; i < sizeof(user); i++)
    if (user[i]->query("family/family_name") == "金刀门") {
      player = user[i];
      blademan[j++] = player;
    }

  tell_object(me, sprintf(HIG "             金刀门排行榜:\n\n"));
  return 1;
}
