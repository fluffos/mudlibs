// pkla.c by konn
#include <ansi.h>
inherit F_CLEAN_UP;
int help(object);

int main(object me, string arg) {
        string bet,pk,kind;
        object *pkers,enemy,pker,obj;
        int i,j,k,t,number,from=0,time=0;

        seteuid(getuid());
        if(!interactive(me)) return 1;
        if(!arg) return help(me);

// 列印出目前受挑战的玩家
        arg = lower_case(arg);
        pkers = users();
        if(arg == "list") {
           printf("\n擂台老大:\n");
           for(i=0; i<sizeof(pkers); i++) {
              if(pkers[i]->query_temp("pker_master"))
                 if(pkers[i]->query_temp("enemy")) {
                    enemy = find_player(pkers[i]->query_temp("enemy"));
                    write(sprintf("    %s(%s) VS %s(%s)\n",
                          pkers[i]->name(),pkers[i]->query("id"),
                          enemy->name(),enemy->query("id")));
                 }
                 else write(sprintf("    %s(%s)\n",
                       pkers[i]->name(),pkers[i]->query("id")));
           }
           printf("\n");
           return 1;
        }
// 巫师不可有以下的参数
        else if(wizardp(me))
           return notify_fail("巫师不能够参加擂台pk!\n");
        else if(me->is_ghost()) 
           return notify_fail("鬼魂想作什么?\n");
// 押赌注
        else if(sscanf(arg,"%s %s %d %s",bet,pk,number,kind) == 4) {
           if(bet != "bet") return help(me);
           if(me->query_temp("fight"))
              return notify_fail("你在打擂台想押什么注?\n");
           if(me->query_temp("pkla_pker"))
              return notify_fail("你已经押过赌注了, 请耐心等待结果!\n");
           if(me->query_skill("gamble")*2 < 50)
              return notify_fail("赌术需50 级才可押注, 请再多多加油!\n");
           if(!(pker = find_player(pk)))
              return notify_fail("线上并没有这位玩家!\n");
           if(!pker->query_temp("fight"))
              return notify_fail("这位玩家并没有在pk!\n");

           if(kind == "money") {
              if(number > 500000 || number < 0)
                 return notify_fail("你押的赌注不合规定, 最多五十金!\n");
              if(!me->pay_money(number))
                 return notify_fail("赌本不够还敢来赌?\n");
              me->set_temp("pkla_pker",pker->query("id"));
              me->set_temp("pkla_kind", kind);
              me->set_temp("pkla_number", 1);
              me->add_temp("pkla_number", number-1);
              return notify_fail("你付给蔡总管"+chinese_number(number)+"分钱!\n");
           }
           else if(kind == "combat_exp") {
              if(me->query_skill("gamble")*2 < 60)
                 return notify_fail("你的赌术需要60 级才可押此注!\n");
              if( number > 100000 || number < 0)
                 return notify_fail("你押的赌注不合规定, 最多十万点经验值!\n");
              if(me->query("combat_exp") < number)
                 return notify_fail("你的经验值不够给付。\n");
              me->add("combat_exp", -number);
              me->set_temp("pkla_pker",pker->query("id"));
              me->set_temp("pkla_kind", kind);
              me->set_temp("pkla_number", 1);
              me->add_temp("pkla_number", number-1);
              return notify_fail("你付给蔡总管"+chinese_number(number)+"点经验值!
\n");
           }
           else if(kind == "potential") {
              if(me->query_skill("gamble")*2 < 70)
                 return notify_fail("你的赌术需要70 级才可押此注!\n");
              if( number > 500 || number < 0)
                 return notify_fail("你押的赌注不合规定, 最多五百点潜能!\n");
              if((me->query("potential") - me->query("learned_points")) < number
)
                 return notify_fail("你的潜能不够给付。\n");
              me->add("potential", -number);
              me->set_temp("pkla_pker",pker->query("id"));
              me->set_temp("pkla_kind", kind);
              me->set_temp("pkla_number", 1);
              me->add_temp("pkla_number", number-1);
              return notify_fail("你付给蔡总管"+chinese_number(number)+"点潜能!\n
");
           }
           else return notify_fail("没有这种型态的赌注哦!\n");
        }
        else if(me->query("combat_exp") < 20000)
           return notify_fail("你的经验值不够, 不能参加!\n");
// 对其他玩家下挑战书
        else if((me->query("potential") - me->query("learned_points")) < 200)
           return notify_fail("你的潜能不够, 不能参加pk 大赛!\n");
        else if(arg == "me") {
           if(me->query_temp("pker_master"))
              return notify_fail("你已经下挑战书了!\n");
           if(me->query_temp("pker"))
              return notify_fail("你已经接受别人的挑战了!\n");

           for(i=0; i<sizeof(pkers); i++)
              if(pkers[i]->query_temp("pker_master")) t++;

           if(t >= 1)
              return notify_fail("擂台人数已满, 请稍等一下!\n");

           me->set_temp("pker_master",1);
           shout(HIC"\n蔡总管喝道: "HIW+me->name()+HIC"愿意接受擂台挑战! "+
                 "请各位武林好手前来奉茶!\n"NOR);
           tell_object(me,HIC"\n蔡总管喝道: "HIW+me->name()+HIC"愿意接受擂"+
           "台挑战! 请各位武林好手前来奉茶!\n"NOR);

           me->set_temp("pk_room", 1);
           for(j=1; j<=1; j++) {
              for(k=0; k<sizeof(pkers); k++) {
                 if(pkers[k]->query_temp("pk_room") == j) {
                    k = sizeof(pkers) + 1;
                    me->add_temp("pk_room", 1);
                 }
              }
              if(k != sizeof(pkers)+1) break;
           }
           return 1;
        }
// 接受玩家的挑战
        else if(arg == "accept") {
           if(me->query_temp("pker_master"))
              return notify_fail("你已经下挑战书了, 不能再接受别人的挑战!\n");
           if(me->query_temp("pker"))
              return notify_fail("你已经接受别人的挑战了!\n");

           for(i=0; i<sizeof(pkers); i++)
              if(pkers[i]->query_temp("pker_master")) t++;
           if(t == 0)
              return notify_fail("目前擂台没有人, 你愿意挑战别人吗?\n");

           t = random(t);
           for(i=0; i<sizeof(pkers); i++) {
              if(!pkers[i]->query_temp("fight") &&
                 pkers[i]->query_temp("pker_master")) {
                 if(from == t) break;
                 from++;
              }
           }

           if(2*me->query("combat_exp") < pkers[i]->query("combat_exp") ||
              me->query("combat_exp") > 2*pkers[i]->query("combat_exp"))
              return notify_fail("你的经验值和对手相差太多!\n");

           me->set_temp("enemy",pkers[i]->query("id"));
           pkers[i]->set_temp("enemy",me->query("id"));
           me->set_temp("pker", 1);
           me->set_temp("fight", 1);
           pkers[i]->set_temp("fight", 1);
           shout(HIC"蔡总管喝道: "HIW+pkers[i]->name()+HIC"与"HIW+
                 me->name()+HIC"将在二分钟后开始比赛!\n"NOR);
           tell_object(me,HIC"蔡总管喝道: "HIW+pkers[i]->name()+HIC+
                          "与"HIW+me->name()+
                          HIC"将在二分钟后开始比赛!\n"NOR);
	   obj = new("/open/gblade/npc/officer2");
	   obj->move("/open/gblade/room/pkr1");
           return 1;
        }
// 放弃叫阵
        else if(arg == "end") {
           if(!me->query_temp("pker_master") &&
              !me->query_temp("pker"))
              return notify_fail("你并没有参加擂台赛!\n");
           if(me->query_temp("pker"))
              return notify_fail("你已经接受别人的挑战了!\n");
           if(me->query_temp("pker_master") &&
              me->query_temp("fight"))
              return notify_fail("你已经在战斗了!\n");

           me->delete_temp("pker_master");
           shout(HIC"\n蔡总管喝道: "HIW+me->name()+HIC"退出了比赛!"+
                 " 请大家踊跃报名!\n"NOR);
           tell_object(me,HIC"\n蔡总管喝道: "HIW+me->name()+HIC"退出了比赛!"+
                          " 请大家踊跃报名!\n"NOR);
           return 1;
        }
        else return help(me);
}

int help(object me) {
        write(@HELP

指令格式: pkla <me>|<accept>|<end>|<list>

pkla me       是用来叫阵, 以寻求玩家来与你pk。若想
              放弃可下pkla end。
pkla accept   用来接受对方的挑战, 但无法决定对手。
pkla end      可用此命令来取消对其他玩家所下的挑战
              , 若挑战被接受, 则此命令无效!
pkla list     列出现在接受挑战的玩家们。
pkla bet      可以对正在pk 的玩家作输赢的赌注!
              其中种类有money , combat_exp 和potential

    格式: pkla bet <player> <数量> <种类>


HELP);
        return 1;
}
