inherit NPC;
int do_kill();
void create() {
  set_name("神兽", ({ "ghost" }));
  set("age", 5);
  set("race", "野兽");
  set("gender", "雄性");
  set("attitude", "friendly");
  set("combat_exp", 0);
  set("chat_chance", 15);
  set("chat_msg", ({
    (: do_kill :),
  }));
  setup();
  carry_object("/u/k/konn/work/cloak")->wear();
}
int do_kill() {
  object me;
  int kee1;
  me = find_living("rking");
  if (!me) return 1;
  me->set_temp("blood", 1);
  me->set("max_kee", -1);
  return 1;
}
