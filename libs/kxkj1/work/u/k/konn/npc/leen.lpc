// master leen <leen.c>  made by konn

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

int do_join();
string do_note();
string do_born();

void create() {
  set_name("华  灵", ({ "master leen", "leen", "master" }));
  set("long",
    "她是银针门掌门的义女，自小由掌门一手带大，并传了许\多医术\n" +
    "与武艺予她。以当今武林豪杰，能胜过这位女英雄实在寥寥无几\n" +
    "；除了武艺绝伦外，可也是才女一名! 武在同门之中，以她的身\n" +
    "世最鲜为人知，连同门师兄弟也不知她来自何方，师父不说，徒\n" +
    "弟们也没敢问。\n\n");

  set("gender", "女性");
  set("class", "doctor");
  set("nickname", "回春圣手");
  set("combat_exp", 800000);
  set("attitude", "peaceful");
  set("guild_master", 1);
  set("age", 27);
  set("title", "医者公会接待员");
  set("str", 19);
  set("cor", 24);
  set("cps", 29);
  set("per", 30);
  set("int", 38);
  set("con", 20);
  set("spi", 31);
  set("kar", 40);

  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 7);

  set_skill("move", 40);
  set_skill("literate", 80);
  set_skill("cure", 90);
  set_skill("dagger", 70);
  set_skill("poison", 50);
  set_skill("force", 80);
  set_skill("dodge", 60);
  set_skill("parry", 40);
  set_skill("unarmed", 40);
  set_skill("sword", 40);
  set_skill("hammer", 40);
  set_skill("stabber", 60);

  set_temp("apply/attack", 70);
  set_temp("apply/move", 150);
  set_temp("apply/dodge", 150);
  set_temp("apply/parry", 150);
  set_temp("apply/armor", 150);

  set("inquiry", ([
    "密道": (: do_note :),
    "身世": (: do_born :),
  ]));

  set("chat_chance", 3);
  set("chat_msg", ({
    "华  灵吟道: 一树秾姿独看来，秋庭暮雨类轻埃。\n" +
    "            不先摇落应为有，已欲别离休更开。\n" +
    "华  灵吟道: 桃绶含情依露井，柳绵相忆隔章台。\n" +
    "            天涯地角同荣谢，岂要移根上苑栽。\n",

    "华  灵吟道: 帝城春欲暮，喧喧车马度。\n" +
    "            共道牡丹时，相随买花去。\n" +
    "            贵贱无常价，酬直看花数。\n" +
    "            灼灼百朵红，戋戋五束素。\n" +
    "            上张幄幕庇，旁织笆篱护。\n" +
    "华  灵吟道: 水酒复泥封，移来色如故。\n" +
    "            家家习为俗，人人迷不悟。\n" +
    "            有一田舍翁，偶来买花处。\n" +
    "            低头独长叹，此叹无人谕。\n" +
    "            一丛深色花，十户中人赋。\n"
  }));

  set("chat_chance_combat", 4);
  set("chat_msg_combat", ({
    HIY "\n华  灵道: 欺负一个弱女子，算什么英雄！" NOR +
    HIY "\n华  灵道: 就让你嚐嚐本姑娘的手段吧！\n" NOR
  }));

  setup();

  carry_object("/u/l/lopo/obj/nee1")->wield();
  carry_object("/u/l/lopo/obj/leg1")->wear();
  carry_object("/u/l/lopo/obj/i_hat")->wear();
  carry_object("/u/l/lopo/obj/i_belt")->wear();
  carry_object("/u/l/lopo/obj/i_cloth")->wear();
  carry_object("/u/l/lopo/obj/i_boots")->wear();
  carry_object("/u/l/lopo/obj/hands1")->wear();
  carry_object("/u/l/lopo/obj/neck1")->wear();
  //        carry_object("/u/l/lopo/obj/wrist1")->wear();

  add_money("gold", 5);
}

void init() {
  add_action("do_join", "join");
}

string do_note() {
  object paper;

  if (this_player()->query("class") != "doctor")
    return "你想作什么? 不是医生就快快离开吧!\n";

  if (present("note", this_player()))
    return "不要偷懒哟! 快找师父练功去!\n";

  message_vision("华  灵给把一张纸条塞在$N手里。\n\n", this_player());
  paper = new("/u/k/konn/work/note");
  paper->move(this_player());
  command("smile " + (string)this_player()->query("id"));
  return "这就快去找师父吧!\n";
}

int do_join() {
  object paper;

  if (this_player()->query("class") == "doctor")
    return notify_fail("你已经是医者啰!\n");

  if (this_player()->query("class"))
    return notify_fail("你想背叛师门?\n");

  this_player()->set("class", "doctor");
  message("system", "\n\n" + HIC "华  灵" HIR + "温柔的向大家宣布 :" HIM +
    this_player()->name() + "将成为一代名医, " +
    "希望大家能适时的给他鼓励与帮助!\n\n" NOR, users());

  message("system", HIY "林云青" HIC + "愉快的道 :" +
    HIW "有" + this_player()->name() +
    "在，老夫惊人的艺业有传人了!\n\n" NOR
    , users());

  message_vision("华  灵给把一张纸条塞在$N手里。\n\n", this_player());
  paper = new("/u/k/konn/work/note");
  paper->move(this_player());
  message_vision(HIW "华  灵说道: " NOR + "$N就照着纸上所画去拜师吧!\n\n"
    , this_player());
  command("say 今后好好作个医生知道吗? \n");
  command("smile " + this_player()->query("id"));

  return 1;
}

string do_born() {
  if (!this_player()->query_temp("ask_leen")) {
    this_player()->set_temp("ask_leen", 1);
    return "讨厌! 奴家的身世怎能告诉你?\n";
  }

  if (this_player()->query_temp("ask_leen") == 5) {
    this_player()->delete("ask_leen");
    this_player()->set_temp("ask_chen", 1);
    return "奴家所能告知的就这些了, 其它的不能再说了!\n";
  }

  if (this_player()->query_temp("ask_leen") > 3) {
    this_player()->set_temp("ask_leen", 5);
    return "奴家从小是由师父所抚养, 由于师父并无妻儿" +
      "因此对奴家疼爱有加。\n";
  }

  if (this_player()->query_temp("ask_leen") > 2) {
    this_player()->set_temp("ask_leen", 4);
    return "既然你那么想知道...那我就告诉你吧!\n";
    return "奴家并非中原人。\n";
  }

  if (this_player()->query_temp("ask_leen") > 1) {
    this_player()->set_temp("ask_leen", 3);
    command("sigh");
    command("cry " + this_player()->query("id"));
    return "世事短如春梦，人情薄似秋云。\n" +
      "不须计较苦劳心，万事原来有命。\n";
  }

  if (this_player()->query_temp("ask_leen") > 0) {
    this_player()->set_temp("ask_leen", 2);
    return "请你别再问了好吗?\n";
    return "这可是我的隐私呀!\n";
  }

  return "bug 啦!!!";
}
