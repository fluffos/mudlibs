// unjoin.c//change by cgy

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        if( me->query("unjoin"))
               return notify_fail("只能放弃职业一次\n");
        // 加了上述二行及后面的 set("unjoin")//	
       if( me->query("class") && !me->query("family") ) {
		write("你放弃了你目前的这个职业。\n");
		me->delete("class");
                me->set("unjoin",1);
	}
	else 	write("放弃职业 ? 有没有弄错 ?\n");
	return 1;
}

int help(object me)
{
     write(@HELP
指令格式 : unjoin
指令说明 : 
           这个指令让你(妳)可以放弃你目前的职业，
           但是必需是在还没拜师的情况下。
HELP
    );
    return 1;
}
