//made by urd
#include <ansi.h>

inherit NPC;

void create() {
  set_name("FATIMA", ({ "fatima" }));
  set("nickname", HIY "FATIMA" NOR);
  set("no_update", 1);
  set("race", "FATIMA");
  set("gender", "女性");
  set("age", 20);
  set("long",
    "一个没有主人的 FATIMA ,看起来很有气质。\n");

  set("combat_exp", 1);
  set("class", "fatima");

  set("str", 1);
  set("cor", 1);
  set("int", 1);
  set("dex", 1);
  set("con", 1);
  set("kar", 1);
  set("per", 1);
  set("spi", 1);

  set("force", 0);

  set("atman", 1000);
  set("max_atman", 1000);

  set("spellpower", "normal");

  //set("inquiry", ([
  //]) );

  //set("spell_chance", 1000);
  //set("spell","fireball");

  //create_family("邪神剑派", 2, "FATIMA");

  set_temp("apply/dodge", 40);
  set_temp("apply/armor", 50);

  setup();

}

int accept_fight(object who) {
  command("say 不要啦~~~。\n");
  return notify_fail("FATIMA 还没有主人，你就行行好，放过她吧。\n");
}

void init() {
  object ob, me;
  // ::init();
  ob = this_player();
  me = this_object();
  add_action("do_command", "fc");

  if ((me->query_temp("master") == ob) && me->query_leader() == 0)
    call_out("follow_master", 0, ob);
}
void follow_master(object ob) {
  int i, *skvalue, j;
  string *skname, egname, follow, help_msg;
  mapping skills, skmap;

  if (!ob || environment(ob) != environment()) return;
  command("follow " + ob->query("id"));
  ob->set_temp("fatima", this_object());

  if (ob->query("fatima/egname") != 0) {
    egname = "fatima " + ob->query("fatima/egname");
    set("id", egname);
    set_name(ob->query("fatima/chname"), ({ egname, "fatima", ob->query("fatima/egname")
    }));
  }
  if (ob->query("fatima/nickname") != 0)
    set("nickname", ob->query("fatima/nickname"));
  if (ob->query("fatima/long") != 0)
    set("long", ob->query("fatima/long"));
  set_temp("master", ob);
  set("help_npc", ob->query("id"));
  help_msg = HIY + ob->query("name") + "挺身为保卫自己的 Fatima 而战！" + NOR;
  set("help_msg", help_msg);
  set_living_name(ob->query("fatima/egname"));
  set("kee", ob->query("fatima/kee"));
  set("gin", ob->query("fatima/gin"));
  set("atman", ob->query("fatima/atman"));
  set("str", (int)ob->query("str") * 7 / 10);
  set("cor", (int)ob->query("cor") * 7 / 10);
  set("int", (int)ob->query("int") * 7 / 10);
  set("dex", (int)ob->query("dex") * 7 / 10);
  set("con", (int)ob->query("con") * 7 / 10);
  set("kar", (int)ob->query("kar") * 7 / 10);
  set("per", (int)ob->query("per") * 7 / 10);
  set("spi", (int)ob->query("spi") * 7 / 10);
  set("combat_exp", i = (ob->query("combat_exp") * 7 / 10));

  skills = ob->query_skills();
  if (mapp(skills)) {
    skname = keys(skills);
    skvalue = values(skills);
    for (i = 0; i < sizeof(skname); i++) {

      //command("say "+skname[i]);
      //ob->set_skill(skname[i],100);
      set_skill(skname[i], j = (skvalue[i] * 7 / 10));
    }
  }
  skmap = ob->query_skill_map();
  if (mapp(skmap)) {
    skvalue = values(skmap);
    for (i = 0; i < sizeof(skname); i++) {
      //   command("say enable "+skvalue[i]);
      map_skill(skname[i], skvalue[i]);
    }
  }
}
int do_command(string arg) {
  string ob, leader;

  if (this_player() != this_object()->query_temp("master")) return 0;
  if (!arg) return notify_fail("你要你的 FATIMA 做什么？\n");
  ob = this_player()->query("id");
  if (arg == "fight " + ob || arg == "kill " + ob)
    return notify_fail("你的 FATIMA 不愿意做这种事..\n");
  if (sscanf(arg, "follow %s", leader) == 1 && leader != ob) {
    "/cmds/usr/rest.lpc"->main(this_player());
    return 1;
  }
  command(arg);
  return 1;
}
void die() {
  object master;
  if (objectp(master = this_object()->query_temp("master"))) {
    master->set("fatima/status", "die");
    tell_object(master, HIR "你的 Fatima 死了!!\n" NOR);
    CHANNEL_D->do_channel(this_object(), "rumor",
      sprintf("%s的 Fatima:%s 被杀死了..",
        master->query("name"), this_object()->query("name")));
    destruct(this_object());
  } else {
    CHANNEL_D->do_channel(this_object(), "sys",
      sprintf("%s的 Fatima 出了问题..", this_object()->query_temp("master")));
    destruct(this_object());
  }
}
