#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "衣物室");
  set("long", @LONG
这里是放置 Fatima 衣物的房间，各式各样的 Fatima 服整整齐
齐的放置在这里，但主人似乎已经帮你挑好了最适合的 Fatima 服，
挂在相当显眼的衣架上。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "fatima_room.lpc",
  ]));

  setup();
}
void init() {
  object ob;
  ob = this_player();
  if ((ob->query("fatima/status")) == 2) call_out("create_cloth", 0, ob);
}
int create_cloth(object ob) {
  object obj;
  obj = new("u/u/urd/obj/facloth.lpc");
  write(CYN "远远传来巴兰榭博士的声音: 就是你现在拿的这件了,快拿过来让 Fatima 穿上吧！\n" NOR);
  obj->move(ob);
  ob->set("fatima/status", "inuse");
}
