//made by urd
#include <ansi.h>
inherit NPC;
void do_special();

void create() {
  set_name("白虎", ({ "white tiger", "tiger" }));
  set("age", 28);
  set("long", "四大将军中的白虎，最得意的绝招就是冰钻指。\n");
  set("title", HIY "飘渺城四大将军" NOR);
  set("gender", "男性");
  set("str", 40);
  set("cps", 40);
  set("kar", 40);
  set("spe", 40);
  set("int", 40);
  set("cor", 40);
  set("attitude", "killer");
  set("bellicosity", 700);
  set("max_gin", 12374);
  set("max_kee", 15000);
  set("max_sen", 3647);
  set("gin", 12374);
  set("kee", 15000);
  set("sen", 3647);
  set("combat_exp", 1900000);
  set("max_force", 20000);
  set("force", 20000);
  set("max_atman", 15000);
  set("max_mana", 15000);
  set("atman", 12000);
  set("mana", 12000);
  set("force_factor", 100);
  set_skill("dodge", 200);
  set_skill("axe", 150);
  set_skill("unarmed", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: do_special :)
  }));
  set_temp("apply/armor", 100);
  setup();
  carry_object("/open/killer/obj/tiaxe")->wield();
}
void do_special() {
  object *enemy, target;
  int i;

  enemy = this_object()->query_enemy();
  i = sizeof(enemy);
  target = enemy[random(i)];

  message_vision(
    HIY "\n白虎大叫：看我的‘冰  钻  指！！！’～～～\n" NOR, target);
  message_vision(
    HIW "\n白虎的身躯突然转起来，从中伸出两段\n\n镙旋样子的东西，向着$N飞去。
\n" NOR, target);
  target->receive_wound("kee", random(200 + 250));
  COMBAT_D->report_status(target);

}
