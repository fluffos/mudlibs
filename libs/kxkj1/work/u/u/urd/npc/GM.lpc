//made by urd
#include <ansi.h>

inherit EQUIP;

int do_weapon1(object obj);
int do_weapon2(object obj);
int do_weapon3(object obj);

void create() {
  set_name("吉姆", ({ "GM" }));
  set("long", "这是地球联邦军所使用的最早的机型。\n");
  set_weight(1);
  set("unit", "架");
  set("no_get", 1);
  set("no_drop", 1);
  set("value", "1");
  set("MHclass", 1);
  set("check", 1);
  set("count", 1);
  set("strudy", 1);
}

void init() {
  add_action("do_ascend", "ascend");
  add_action("do_descend", "descend");
  add_action("do_teleport", "teleport");
  add_action("do_perform", "performs");
}

int do_ascend() {
  object me;

  me = this_player();
  if (me->query_temp("marks/ascend"))
    return notify_fail("你无法同使驾驶两台MH。\n");

  message_vision("$N爬上" + this_object()->name() + "座位。\n", me);
  me->set_temp("marks/ascend", 1);
  me->add_temp(
    "apply/name",
    ({ me->name() + HIW "(正驾驶着" NOR + this_object()->name() + HIW ")" NOR })
  );
  move(me);
  return 1;
}

int do_descend() {
  object me;
  string *name;

  me = this_player();
  if (!me->query_temp("marks/ascend"))
    return notify_fail("你并没有使用MH。\n");

  message_vision("$N从" + this_object()->name() + "走下来。\n", me);
  me->delete_temp("marks/ascend");
  //    short = me->query_temp("apply/short");
  //   short -= ({ me->name()+ "(正驾驶着"+this_object()->name()+")" });
  me->delete_temp("apply/name", name);
  move(environment(me));
  return 1;
}

int do_teleport(string arg) {
  object who, me;
  //	int count1;

  if (this_object() != present(this_object(), this_player()))
    return notify_fail("你没有使用MH喔。\n");

  if (!arg) return notify_fail("你想瞬间移动到那里。\n");

  me = this_player();
  who = find_player(arg);
  if (!who) who = find_living(arg);
  if (!who) return notify_fail("你想瞬间移动到那里。\n");

  //	count1 = (int)this_object()->query("count");
  //	if( (count1 -= 4) < 0 ) {
  //		count1 += 4;
  //		set("count",count1);
  //		return notify_fail(this_object()->name()+"能量不够了。\n");
  //	}
  //	
  //	set("count",count1);	
  message_vision("$N瞬间移动.\n", me);
  tell_room(who, me->name() + "出现在你眼前。\n");
  me->move(environment(who));
  return 1;
}

int do_perform(string arg) {
  string func, target;
  object ob;

  if (this_object() != present(this_object(), this_player()))
    return notify_fail("你没使用MH喔。\n");

  if (!arg || sscanf(arg, "%s on %s", func, target) != 2)
    return notify_fail("你想启动什么功\能?\n");

  if (!objectp(ob = present(target, environment(this_player()))))
    return notify_fail("你想对谁启动功\能?\n");

  if (!ob
    || !ob->is_character()
    || ob->is_corpse()
    || ob == this_player())
    return notify_fail("你想对谁启动功\能?\n");

  if (func == "weapon1") { do_weapon1(ob); }
  if (func == "weapon2") { do_weapon2(ob); }
  if (func == "weapon3") { do_weapon3(ob); }
  return 1;
}

int do_weapon1(object obj) {
  object me;
  string msg;

  me = this_player();
  /*
	if( !me->is_fighting() ) {
		write("只有在战斗中才能使用破坏炮。\n");
		return 1;
	}
*/
  if (!living(obj)) {
    write("....。\n");
    return 1;
  }
  /*	
	if( !this_object()->query("check") ) {
		write(this_object()->name()+"能量不够了。\n");
		return 1;
	}
	
	set("check",0);	
*/
  msg = ".....。\n";
  message_vision(msg, me);
  message_vision(".....\n", obj);
  message_vision(".....\n", obj);
  message_vision(".....。\n\n", obj);
  obj->receive_damage("kee", random(1));
  obj->receive_wound("kee", random(1));
  message_vision(".....。\n", me);
  message_vision("......\n", me);
  me->start_busy(3);
  return 1;
}

int do_weapon2(object obj) {
  object me;
  string msg;
  int count1;

  me = this_player();
  /*	
	if ( !me->is_fighting() ) {
		write("只有在战斗中才能使用光剑。\n");
		return 1;
	}
*/
  if (!living(obj)) {
    write(".....。\n");
    return 1;
  }

  count1 = (int)this_object()->query("count");
  if ((count1 -= 1) < 0) {
    write(this_object()->name() + "能量不够了。\n");
    count1 += 1;
    this_object()->set("count", count1);
    return 1;
  }

  set("count", count1);
  msg = "$N从左侧腰间抽出了光剑用了往" + obj->name() + "砍了过去。\n";
  message_vision(HIW "滋的一声 ..\n" NOR, me);
  message_vision(msg, me);
  message_vision(".....。\n", obj);
  obj->receive_damage("kee", 1);
  obj->receive_wound("kee", 1);
  return 1;
}

int do_weapon3(object obj) {
  object me;
  string msg;
  int count1;

  me = this_player();
  /*
        if( !me->is_fighting() ) {
                write("只有在战斗中才能使用特殊剑技。\n");
                return 1;
        }
*/
  if (!living(obj)) {
    write(".....\n");
    return 1;
  }

  count1 = (int)this_object()->query("count");
  if ((count1 -= 2) < 0) {
    write(this_object()->name() + "能量不够了。\n");
    count1 += 2;
    this_object()->set("count", count1);
    return 1;
  }

  set("count", count1);
  msg = "" + obj->name() + "";
  message_vision(msg, me);
  obj->receive_damage("kee", random(5000));
  obj->receive_wound("kee", random(5000));
  return 1;
}
