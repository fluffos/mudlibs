#include <ansi.h>

inherit EQUIP;

void create() {
  set_name(HIR "Fatima 服" NOR, ({ "fatima suit", "suit" }));
  set_weight(500);
  set("long", "
  由黑、红、白三色相间的服装,上头还镶着些宝石,看起来非常耐看。\n
  ");

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("armor_type", "cloth");
    set("value", 0);
    set("armor_prop/dodge", 10);
    set("armor_prop/armor", 1);
  }
}
