#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create() {
  set_name(HIG "战神戒指" NOR, ({ "duku ring", "ring" }));
  set_weight(1000);
  set("armor_type", "finger");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", @LONG
剑魔有感于当年杀孽太重，特以万年寒冰石制成此戒指，以避免滥杀无辜。
LONG);
    set("material", "jade");
    set("value", 10000);
    set("armor_prop/armor", 100);

    set("armor_prop/sword", 100);
  }
  setup();
}
