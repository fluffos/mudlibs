#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create() {
  set_name(HIG "剑魔战袍" NOR, ({ "duku suit", "suit" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "剑魔击杀太湖毒龙之后，取其筋与苗疆乌蚕丝混纺而成。\n");
    set("material", "blacksteel");
    set("value", 10000);
    set("armor_type", "cloth");
    set("armor_prop/armor", 100);
    set("armor_prop/move", 100);
  }
  setup();
}
