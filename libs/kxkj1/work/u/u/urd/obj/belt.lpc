#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create() {
  set_name(HIG "战神腰带" NOR, ({ "duku belt", "belt" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "只有战神才配使用的腰带。\n");
    set("material", "blacksteel");
    set("value", 10000);
    set("armor_type", "belt");
    set("armor_prop/armor", 100);
    set("armor_prop/force", 100);
  }
  setup();
}
