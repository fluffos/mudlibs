#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create() {
  set_name(HIG "玄铁护膝" NOR, ({ "duku legging", "legging" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是剑魔独孤求败的护膝。\n");
    set("material", "blacksteel");
    set("value", 10000);
    set("armor_type", "legging");
    set("armor_prop/armor", 100);

  }
  setup();
}
