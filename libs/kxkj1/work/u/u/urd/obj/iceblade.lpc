// blade.c

#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create() {
  set_name(HIC "冰刀" NOR, ({ "blade" }));
  set_weight(24000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 6000000);
    set("material", "steel");
    set("long", "雪饮乃是一把稀世的宝刀 ,刀身上阵阵透出的寒气 ,让人  感觉出它惊人的威力 .听说世上只有一把剑能与之抗衡 ,这把剑现在还不知是那把 . \n");
    set("wield_msg", "$N抽出寒气透骨的$n握在手中 ,$N的手瞬间的蒙上一层霜 ,$N感觉到$n无匹的力量注入$N的体内。\n");
    set("unequip_msg", "$N将$n插回背上的缠刀布中。\n");
  }
  init_blade(9999999);
  setup();
}
