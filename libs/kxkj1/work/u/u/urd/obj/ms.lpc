//ms.c by urd
#include <ansi.h>

inherit EQUIP;

int do_mega(object obj);
int do_ls(object obj);
int do_ld(object obj);

void create() {
  set_name(HIW "古伦加斯特" NOR, ({ "MS", "ms" }));
  set("long", "这是一台单人操作型 MS 。\n");
  set_weight(1);
  set("unit", "架");
  set("no_get", 1);
  set("no_drop", 1);
  set("value", "100000000");
  set("MHclass", 7);
  set("check", 100);
  set("count", 5000);
  set("strudy", 5000);
}

void init() {

  add_action("do_ascend", "ascend");
  add_action("do_descend", "descend");
  add_action("do_teleport", "teleport");
  add_action("do_perform", "pf");
}

int do_ascend() {
  object me;

  me = this_player();
  if (me->query_temp("marks/ascend"))
    return notify_fail("你无法同时驾驶两台MS。\n");

  message_vision("$N登上了" + this_object()->name() + "的驾驶舱。\n", me);
  me->set_temp("marks/ascend", 1);
  me->add_temp(
    "apply/name",
    ({ me->name() + HIW "(正驾驶着" NOR + this_object()->name() + HIW ")" NOR })
  );
  move(me);
  return 1;
}

int do_descend() {
  object me;
  string *name;

  me = this_player();
  if (!me->query_temp("marks/ascend"))
    return notify_fail("你没在MS上耶。\n");

  message_vision("$N从" + this_object()->name() + "的驾驶舱跳了出来。\n", me);
  me->delete_temp("marks/ascend");
  //    short = me->query_temp("apply/short");
  //   short -= ({ me->name()+ "(正驾驶"+this_object()->name()+")" });
  me->delete_temp("apply/name", name);
  move(environment(me));
  return 1;
}

int do_teleport(string arg) {
  object who, me;
  //int count1;

  if (this_object() != present(this_object(), this_player()))
    return notify_fail("你没驾驶" + HIW "MS" NOR + "喔。\n");

  if (!arg) return notify_fail("你想发进到那里去。\n");

  me = this_player();
  who = find_player(arg);
  if (!who) who = find_living(arg);
  if (!who) return notify_fail("你想发进到那里去。\n");

  //count1 = (int)this_object()->query("count");
  //if( (count1 -= 4) < 0 ) {
  //count1 += 4
  //set("count",count1);
  //return notify_fail(this_object()->name()+"能量不够了。\n");
  //}
  //
  //set("count",count1);
  message_vision("$N启动160%的出力，突然间就消失在天空中.\n", me);
  tell_room(who, me->name() + "降落在你面前。\n");
  me->move(environment(who));
  return 1;
}

int do_perform(string arg) {
  string func, target;
  object ob;

  if (this_object() != present(this_object(), this_player()))
    return notify_fail("你没驾驶" HIW + "MS" NOR + "喔。\n");

  if (!arg || sscanf(arg, "%s on %s", func, target) != 2)
    return notify_fail("你想启动什么功\能?\n");

  if (!objectp(ob = present(target, environment(this_player()))))
    return notify_fail("你想对谁启动功\能?\n");

  if (!ob
    || !ob->is_character()
    || ob->is_corpse()
    || ob == this_player())
    return notify_fail("你想对谁启动功\能?\n");

  if (func == "mega") { do_mega(ob); }
  if (func == "ls") { do_ls(ob); }
  if (func == "ld") { do_ld(ob); }
  return 1;
}

int do_mega(object obj) {
  object me;
  string msg;

  me = this_player();
  /*
if( !me->is_fighting() ) {
write("只有在战斗中才能使用计都罗喉剑．暗杀剑。\n");
return 1;
}
*/
  if (!living(obj)) {
    write("暗杀剑是用来打活动的物品的。\n");
    return 1;
  }
  /*
if( !this_object()->query("check") ) {
write(this_object()->name()+"能量不够了。\n");
return 1;
}

set("check",0);
*/
  msg = HIW "新人类的精神力觉醒了!!" + HIW "MS" NOR + HIW "的剑上开始聚集能量了。
\n\n" NOR;
  message_vision(msg, me);
  message_vision(HIW "$N升出右手，高呼：‘计都罗喉剑．暗杀剑！！’正对着$N" + HIW "的
方向挥了过去\n\n" NOR, obj);
  message_vision(HIY "一股极大的剑光迸了出来 !\n\n" NOR, obj);
  message_vision(HIR "$N" NOR + HIW "那一个方向的事物瞬间离开了这个世界。\n\n" NOR, obj);
  obj->receive_damage("kee", random(10000));
  obj->receive_wound("kee", random(10000));
  message_vision(HIB "时空在一阵" HIW "扭曲" HIB "后回复了平静。\n" NOR, me);
  message_vision(HIW "MS" NOR + HIW "的能量完全耗尽 ,核融合引擎正不断的补充能量中 .
\n" NOR, me);
  me->start_busy(2);
  return 1;
}

int do_ls(object obj) {
  object me;
  string msg;
  int count1;

  me = this_player();
  /*
if ( !me->is_fighting() ) {
write("只有在战斗中才能使用计都罗喉剑。\n");
return 1;
}
*/
  if (!living(obj)) {
    write("普通的攻击就可以击坠他了。\n");
    return 1;
  }

  count1 = (int)this_object()->query("count");
  if ((count1 -= 1) < 0) {
    write(this_object()->name() + "能量不够了。\n");
    count1 += 1;
    this_object()->set("count", count1);
    return 1;
  }

  set("count", count1);
  msg = "$N从身后取出了剑，往天一指，大呼：‘※计都罗喉剑※！！’正对着" + obj->name() + "砍了过去。\n";
  message_vision(HIW "滋的一声 ..\n" NOR, me);
  message_vision(msg, me);
  message_vision(HIM "$N" HIM "遭到" + HIW "MS" NOR + HIW "的剑严重的攻击。
\n" NOR, obj);
  obj->receive_damage("kee", 700);
  obj->receive_wound("kee", 800);
  return 1;
}

int do_ld(object obj) {
  object me;
  string msg;
  int count1;

  me = this_player();
  /*
        if( !me->is_fighting() ) {
                write("只有在战斗中才能使用特殊技。\n");
                return 1;
        }
*/
  if (!living(obj)) {
    write("敌人已经失去了战斗能力 .普通攻击就可以击毁他了.\n");
    return 1;
  }

  count1 = (int)this_object()->query("count");
  if ((count1 -= 2) < 0) {
    write(this_object()->name() + "能量不够了。\n");
    count1 += 2;
    this_object()->set("count", count1);
    return 1;
  }

  set("count", count1);
  msg = "$N从背后射出连动装置朝" + obj->name() + "轰了过去。\n";
  message_vision(msg, me);
  message_vision(HIG "连动装置飞了过来布在四周...\n" NOR, me);
  message_vision(MAG "连动装置四处乱飞的朝$N射击...\n" NOR, obj);
  message_vision(HIM "$N" HIM "受到了致命的打击。\n" NOR, obj);
  obj->receive_damage("kee", random(5000));
  obj->receive_wound("kee", random(5000));
  return 1;
}
