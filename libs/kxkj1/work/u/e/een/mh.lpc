// KOG.c

#include <ansi.h>

inherit EQUIP;

int buster(object obj);
int lightsword(object obj);
int swallo(object obj);

void create() {
  set_name(HIY "黄金骑士" NOR, ({ "K.O.G", "kog", "mh", "MH" }));
  set(
    "long",
    "一台价值连城的黄金 MH ,你可以用 ascend 来启动并登上它,\n或是用 descend 来离开驾驶舱;\n登上 MH 后可以用 teleport 来瞬间移动。\n"
  );
  set_weight(1);
  set("unit", "架");
  set("no_get", 1);
  set("no_drop", 1);
  set("value", "100000000");
  set("MHclass", 5);
  set("check", 1);
  set("count", 10);
}

void init() {

  add_action("do_ascend", "ascend");
  add_action("do_descend", "descend");
  add_action("do_teleport", "teleport");
  add_action("do_perform", "performs");
}

int do_ascend() {
  object me;

  me = this_player();
  if (me->query_temp("marks/ascend"))
    return notify_fail("你无法同使驾驶两台MH。\n");

  message_vision("$N登上了" + this_object()->name() + "。\n", me);
  me->set_temp("marks/ascend", 1);
  me->add_temp("apply/short", ({ me->short() + "(正驾驶着" + this_object()->name() + ")" }));
  move(me);
  this_object()->set("name", this_object()->name() + "的遥控表");
  return 1;
}

int do_descend() {
  object me;
  string *short, name;

  me = this_player();
  if (!me->query_temp("marks/ascend"))
    return notify_fail("你没在MH上耶。\n");
  sscanf(this_object()->name(), "%s的遥控表", name);
  this_object()->set("name", name);
  message_vision("$N从" + this_object()->name() + "走了出来。\n", me);
  me->delete_temp("marks/ascend");
  short = me->query_temp("apply/short");
  short -= ({ me->short() + "(正驾驶" + this_object()->name() + ")" });
  me->delete_temp("apply/short", short);
  move(environment(me));

  return 1;
}

int do_teleport(string arg) {
  object who, me;
  //	int count1;

  if (this_object() != present(this_object(), this_player()))
    return notify_fail("你没驾驶这台K.O.G喔。\n");

  if (!arg) return notify_fail("你想瞬间移动到那里去。\n");

  me = this_player();
  who = find_player(arg);
  if (!who) who = find_living(arg);
  if (!who) return notify_fail("你想瞬间移动到那里去。\n");

  //	count1 = (int)this_object()->query("count");
  //	if( (count1 -= 4) < 0 ) {
  //		count1 += 4;
  //		set("count",count1);
  //		return notify_fail(this_object()->name()+"能量不够了。\n");
  //	}
  //	
  //	set("count",count1);	
  message_vision("$N启动瞬间移动，突然间就消失了。\n", me);
  tell_room(who, me->name() + "瞬间移动到你面前。\n");
  me->move(environment(who));
  return 1;
}

int do_perform(string arg) {
  string func, target;
  object ob;

  if (this_object() != present(this_object(), this_player()))
    return notify_fail("你没驾驶这台K.O.G喔。\n");

  if (!arg || sscanf(arg, "%s on %s", func, target) != 2)
    return notify_fail("你想启动什么功\能?\n");

  if (!objectp(ob = present(target, environment(this_player()))))
    return notify_fail("你想对谁启动功\能?\n");

  if (!ob
    || !ob->is_character()
    || ob->is_corpse()
    || ob == this_player())
    return notify_fail("你想对谁启动功\能?\n");

  if (func == "buster") {
    call_out(ob, 1, "buster");
    if (func == "lightsword") { do_lightsword(ob); }
    if (func == "swallo") { do_swallo(ob); }
    write("what ??\n");
    return 1;
  }

  int buster(object obj) {
    object me;
    string msg;

    me = this_player();
    /*
	if( !me->is_fighting() ) {
		write("只有在战斗中才能使用破坏炮。\n");
		return 1;
	}
*/
    if (!living(obj)) {
      write("他已经昏了，你还用破坏炮打他，太狠了吧。\n");
      return 1;
    }
    /*	
	if( !this_object()->query("check") ) {
		write(this_object()->name()+"能量不够了。\n");
		return 1;
	}
	
	set("check",0);	
*/
    msg = "一阵蠢动后， $N从背后拿出了可怕的" RED "巨型破坏炮。\n" NOR;
    message_vision(msg, me);
    message_vision("破坏炮对着$N轰了过去\n", obj);
    message_vision(HIM "$N" HIM "因受不了破坏炮的威力煞时吐了一大口" RED "鲜血。\n" NOR, obj);
    obj->receive_damage("kee", 1500);
    obj->receive_wound("kee", 1500);
    message_vision(HIB "时空在一阵" HIW "扭曲" HIB "后回复了平静。\n" NOR, me);
    //	me->start_busy(5);
    return 1;
  }

  int lightsword(object obj) {
    object me;
    string msg;
    int count1;

    me = this_player();
    /*	
	if ( !me->is_fighting() ) {
		write("只有在战斗中才能使用光剑。\n");
		return 1;
	}
*/
    if (!living(obj)) {
      write("他已经昏了，你还用光剑砍他，太狠了吧。\n");
      return 1;
    }

    count1 = (int)this_object()->query("count");
    if ((count1 -= 1) < 0) {
      write(this_object()->name() + "能量不够了。\n");
      count1 += 1;
      this_object()->set("count", count1);
      return 1;
    }

    set("count", count1);
    msg = "$N从左侧腰间抽出了光剑用了往" + obj->name() + "砍了过去。\n";
    message_vision(HIW "咻的一声 ----------------------- 咻咻。\n" NOR, me);
    message_vision(msg, me);
    message_vision(HIM "$N" HIM "因受不了光剑的冲击，登时胸口疼痛，吐了一口血。\n" NOR, obj);
    obj->receive_damage("kee", 100);
    obj->receive_wound("kee", 50);
    return 1;
  }

  int swallo(object obj) {
    object me;
    string msg;
    int count1;

    me = this_player();
    /*
        if( !me->is_fighting() ) {
                write("只有在战斗中才能使用特殊剑技。\n");
                return 1;
        }
*/
    if (!living(obj)) {
      write("他已经昏了，你还想砍他，太狠了吧。\n");
      return 1;
    }
    /*
        count1 = (int)this_object()->query("count");
        if( (count1 -= 2) < 0 ) {
                write(this_object()->name()+"能量不够了。\n");
                count1 += 2;
                this_object()->set("count",count1);
                return 1;
        }

        set("count",count1);
 */ msg = "$N从左侧腰间抽出了神圣□真剑往" + obj->name() + "砍了过去。\n";
    message_vision(msg, me);
    message_vision(HIG "==================飞燕剑===================\n" NOR, me);
    message_vision(MAG "剑技纷纷，使$N" MAG "眼光了乱。\n" NOR, obj);
    message_vision(HIM "$N" HIM "受了一阵疯狂的砍击后吐好几大口血。\n" NOR, obj); obj->receive_damage("kee", 250);
    obj->receive_wound("kee", 125);
    return 1;
  }
