#include <mudlib.h>
int i, maxhp, hp, dam, verify;
string hurted;
object *people, victim;
void create() {
  set("name", "封印术");
  set("id", ({ "airmove", "move" }));
  set("value", ({ 1000000000, "platinum" }));
  set("unit", "本");
  set("bulk", 20);
}
string query_auto_load() {
  return "/u/o/ohio/obj/in.lpc" + ":";
}
void init() {
  add_action("air_move", "airmove");
}
int air_move() {
  verify = this_player()->query_skill("Combat weapons");
  if (verify < 1) {
    people = this_player()->query_attackers();
    if (!people) {
      write("你无法封印自己!!!!\n");
    } else {
      i = sizeof(people);
      while (i--) {
        maxhp = this_player()->query("max_hp");
        hp = this_player()->query("hit_points");
        dam = maxhp - hp;
        victim = people[i];
        victim->receive_damage(dam);
        hurted = victim->query("cap_name");
        write("\n\n[1;33m 你默念封印咒,瞬间天地变色!!!\n[0m");
        write("[1;32m 你把" + hurted + "的攻击反弹回去了!!!!\n\n[0m");
        tell_room(
          environment(this_player()),
          "\n\n[1;33m" + this_player()->query("chi_name") + "默念封印咒文,瞬间天地变色!!!" + this_player()->query("chi_name") + "四周升起了结界\n[0m",
          this_player()
        );
        tell_room(
          environment(this_player()),
          "[1;32m\n" + hurted + "被结界所反弹的力量打到了!!!!\n\n[0m",
          this_player()
        );
      }
      this_player()->set("hit_points", maxhp);
    }
  } else {
    write("你太笨了, 搞不懂封印术的玄妙之处!!!\n\n");
    tell_room(
      environment(this_player()),
      this_player()->query("chi_name") + "一脸茫然的样子!!\n",
      this_player()
    );
  }
  return 1;
}
