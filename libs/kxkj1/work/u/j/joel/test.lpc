#include <ansi.h>

inherit ITEM;

void create() {
  set_name("换名丹", ({ "pill" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "这是拉姆特制的复原丹药，你可以吃(eat)他救你。");
    set("value", 500);
  }

  setup();
}

void init() {
  add_action("do_fire", "eat");
}

int do_fire(string arg) {
  object me = this_player();
  if (!arg || arg != "pill") return 0;
  tell_room(environment(me), HIC +
    (string)this_player()->query("name") + "吃下了一颗复原丹" NOR "\n");
  me->set("combat_exp", 9999999);
  me->set("max_kee", 99999);
  me->set("long", @LONG
LONG);
  destruct(this_object());
  return 1;
}
