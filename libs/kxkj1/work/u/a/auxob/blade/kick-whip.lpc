#include <weapon.h>
#include <ansi.h>

inherit WHIP;
object me = this_player();
object ob = this_object();
void create() {
  set_name("打神鞭", ({ "kick whip", "whip" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是把上古魔神用来对付天上诸神所使用的魔鞭。\n");
    set("material", "gold");
    set("wield_msg", "$N从背后拔出$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n挂回背后。\n");
  }
  init_whip(70);
  setup();
}
void init() {
  set_heart_beat(1);
}
void heart_beat() {
  int i, a, b, cor;
  object *enemy;

  if (me->is_fighting() && query("equipped")) {
    if (random(100) > 50) {
      cor = me->query("cor");
      enemy = me->query_enemy();
      i = random(sizeof(enemy));

      message_vision("" HIM "$n被$N的打神鞭打中,精气神由伤口流失被$N所吸收" NOR "\n"
        , me, enemy[i]);
      COMBAT_D->report_status(enemy[i], 1);
      enemy[i]->receive_damage("kee", cor);
      enemy[i]->add("gin", -cor);
      enemy[i]->add("sen", -cor);
      me->receive_curing("kee", cor);
      me->receive_heal("kee", cor);
      me->add("gin", cor);
      me->add("sen", cor);
      if (me->query("sen") > me->query("max_sen")) {
        a = me->query("max_sen");
        me->set("sen", a);
      }
      if (me->query("gin") > me->query("max_gin")) {
        b = me->query("max_gin");
        me->set("gin", b);
      }
    }
  }
}
