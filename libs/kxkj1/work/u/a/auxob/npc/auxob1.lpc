#include <command.h>

inherit NPC;

void create() {
  set_name("魔刀开山大弟子", ({ "auxob1" }));
  set("title", "auxob首徒");
  set("gender", "男性");
  set("age", 20);
  set("attitude", "friendly");
  set("long", @LONG
他是auxob的头号大弟子.
LONG);

  set("combat_exp", 1000000);
  set("str", 30);
  set("con", 20);
  set("int", 30);
  set("per", 40);
  set("cps", 30);
  set("kar", 30);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 100);
  set("max_kee", 5000);
  set("kee", 5000);
  set("limbs", ({ "头", "手", "脚", "背", "腹", "腰" }));
  set_skill("dragon-blade", 120);
  set_skill("powerforce", 100);
  set_skill("blade", 120);
  set_skill("parry", 120);
  set_skill("dodge", 100);
  map_skill("blade", "dragon-blade");
  map_skill("parry", "dragon-blade");
  map_skill("force", "powerforce");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "blade.power-dest" :), }));

  setup();
  carry_object("/u/a/auxob/blade/lion-blade")->wield();
}
void greeting(object who) {
  if ((who->query("id") == "auxob") && (who->query("name") == "魔刀")) {
    command("say 魔刀无敌");
    command("bow " + who->query("name"));
    command("say " + who->query("name") + "师父您好  :)");
    command("say " + who->query("name") + "师父万岁 :>");
  } else {
    command("say 欢迎你到魔刀工作室来 :) ");
  }
  return;
}
