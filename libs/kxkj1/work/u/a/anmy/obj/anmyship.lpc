#include <ansi.h>

inherit ITEM;
inherit F_AUTOLOAD;

void create() {
  set_name(HIC "笨岚仙子号" NOR, ({ "Anmyship", "anmyship", "ship" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "台");
    set("value", 0);
    set("no_get", 1);
    set("no_insert", 1);
  }
}

void init() {
  add_action("do_fly", "fly");
}

int do_fly(string str) {
  object me;
  me = this_player();
  message_vision(sprintf("" HIW "$N" NOR "驾驶着" HIG "笨岚仙子号" NOR "飞向岚子小窝...
....\n"), this_player());
  if (!str)
    me->move("/u/a/anmy/workroom");
  else if (str == "home")
    me->move("/u/o/oda/workroom");

  message_vision(sprintf("一阵微光包围，原来是" HIY "$N" NOR "驾驶着" HIW "笨岚仙子号
" NOR "来到了这里。\n"), this_player());
  return 1;
}

int query_autoload() {
  return 1;
}
