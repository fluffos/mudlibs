// test.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIC "小天使" NOR, ({ "angel" }));
  set("race", "人类");
  set("gender", "女性");
  set("age", 10);
  set("long",
    "一位天使圣界可爱的小天使,她正在以迷人的笑容 \n"
    "对着你微笑着,让你有种亲切的感觉充满全身。 \n");

  set("str", 24);
  set("cor", 26);
  set("per", 35);
  set("combat_exp", 2000);
  set_skill("sword", 20);
  set_skill("dodge", 25);
  set_skill("parry", 30);
  set_skill("unarmed", 40);

  set("limbs", ({ "头部", "身体", "胸部", "腹部" }));

  set("chat_chance", 12);
  set("chat_msg", ({
    "小天使对着你亲切的微笑。\n",
  }));

  set_temp("apply/attack", 30);
  set_temp("apply/armor", 20);
  set("attitude", "friendly");

  setup();
  add_money("coin", 100);

}
