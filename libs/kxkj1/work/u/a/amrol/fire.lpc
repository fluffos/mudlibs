// firedance.c//cgy

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg;
  int damage, ap, dp, bp;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展火舞这个法术？\n");

  if ((int)me->query_skill("dremagic") < 30)
    return notify_fail("你的法术等级不足以施展此术！\n");

  if ((int)me->query("atman") < 50)
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("gin") < 10)
    return notify_fail("你的精神没有办法有效集中！\n");

  me->add("atman", -50);
  me->receive_damage("gin", 10);

  if (random(me->query("max_atman")) < 50) {
    write("你失败了。\n");
    return 1;
  }
  if ((int)me->query_skill("dremagic") > 99) {
    write("[1;32m\n            妳领悟了夜梦天舞及梦玄法鉴的精髓，预备施展[1;34m火凤飞翔[1;32m之术。\n[0m");
    msg = HIC "\n                   $N的身体渐渐的被火焰包围，而$n的身形也渐" NOR;
    msg += HIY "\n                     渐的幻化为一只凤凰，只见一只火凤凰迅速的" NOR;
    msg += HIG "\n                             向着$n飞去，令$n不及招架。\n\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(1);
    call_out("act1", 5, msg, target, me);
    return 1;
  } else if ((int)me->query_skill("dremagic") < 70) {
    write("[1;32m\n                        妳施展出师父所传授的火系法术。\n[0m");
    msg = HIC "\n                      $N高举右手，口念咒语，渐渐的在右手指尖上" NOR;
    msg += HIC "\n                         形成一颗火球，然后将火球朝着$n袭去!!\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(1);
    call_out("act3", 5, msg, target, me);
    return 1;
  } else {
    write("[1;32m\n                   妳忽然对夜梦天舞及梦玄法鉴的有所领悟。\n[0m");
    msg = HIC "\n                   $N的身体渐渐的发出些许的火光，然后火光渐" NOR;
    msg += HIY "\n                   渐的集中于两手，最后两手带着火焰朝$n挥去!\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(1);
    call_out("act2", 5, msg, target, me);
    return 1;
  }
}
int act1(string msg, object target, object me) {
  int damage, ap, dp, bp;
  ap = me->query_skill("magic");
  bp = me->query_skill("unarmed");
  ap = ((ap * ap * ap / 8) + (bp * bp * bp / 8)) * (int)me->query("gin") / 100;
  dp = target->query("combat_exp");
  if (random(ap + dp) > (dp / 2)) {
    damage = (int)me->query("max_atman") / 20 + random((int)me->query("eff_gin") / 10);
    damage -= (int)target->query("max_atman") / 30 + random((int)me->query("eff_gin") / 15);
    if (damage > 0) {
      write("[1;32m\n                     结果成功\的施展出火凤飞翔。\n[0m");
      msg = RED "                   $n闪躲不及，浑身上下都着了火，痛苦异常!!\n" NOR;
      //                      say( "[1;34m                     "+target->query("name")+"闪躲不及，浑身上下都着了火，痛苦异常!!\n[0m");
      target->add("kee", -400);
      me->add("atman", -100);
      me->improve_skill("dremagic", random(me->query("spi")));
    } else if (damage < 0) {
      write("[1;32m\n                   结果并没有发挥预期的效果。\n[0m");
      msg = MAG "                   $n闪过了致命的攻击只有轻微的灼伤！\n" NOR;
      //                      say( "[1;35m                   "+target->query("name")+"闪过了致命的攻击只有轻微的灼伤！\n[0m");
      target->add("kee", -150);
      me->add("atman", -100);
      me->improve_skill("dremagic", random(me->query("spi")) / 2);
    } else if (random(ap + dp) < (dp / 2)) {
      write("[1;32m\n                     结果丝毫起不了作用令妳暗自惋昔。 \n[0m");
      msg = HIC "                 只见$n以迅雷不及掩耳之速闪过攻击。\n" NOR;
      //              say( "[1;35m               只见"+target->query("name")+"以迅雷不及掩耳之速闪过攻击。\n[0m");
      me->add("atman", -100);
    }

    if (damage > 0) COMBAT_D->report_status(target);

    message_vision(msg, me, target);
    if (!target->is_fighting(me)) {
      if (living(target)) {
        if (userp(target)) target->fight_ob(me);
        else target->kill_ob(me);
      }
      me->kill_ob(target);
    }
  }
  return 1;

}
