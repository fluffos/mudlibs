#include <ansi.h>
#include <weapon.h>
inherit STABBER;
void create() {
  set_name(MAG "君子扇" NOR, ({ "gentleman fan", "fan" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一把由当代大儒宁采臣所佩带的扇子。\n");
    set("vaule", 50000);
    set("material", "crimsonsteel");
    set("wield_msg", "$N‘唰’地一声展开了一柄君子扇握在手中。\n");
    set("unwield_msg", "$N将手中的君子扇合了起来插入腰间。\n");
  }
  init_stabber(100);
  setup();
}
