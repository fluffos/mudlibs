#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create() {
  set_name(HIY "君子之靴" NOR, ({ "gentleman boots", "boots" }));
  set_weight(700);
  set("armor_type", "boots");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("value", 30000);
    set("long", "这是当代大儒宁采臣所著的皮靴。\n");
    set("material", "leather");
    set("armor_prop/armor", 100);
    set("armor_prop/dodge", 100);
  }
  setup();
}
