#include <command.h>
#include <net/daemons.h> 
#include <mudlib.h>
#include <ansi.h>
#include <armor.h>
inherit CLOTH;
inherit F_SAVE;
inherit F_AUTOLOAD;
inherit F_DAMAGE;
inherit F_CLEAN_UP;
 
void create()
{
  set_name(HIG+"扩音器"+NOR, ({"ring"}));
  set("long",@LONG
    这是胖胖的小蠢猪的随身配备，也是耍宝的宝物。相传可招唤法
力无边的宋七力相助，可说是胖胖的小蠢猪法宝。
LONG);
  set_weight(50);
  set("unit", "只");
  seteuid(getuid());
  set("value",10000);
  set("armor_type","ring");
  set("material","steel");
  set("armor_prop/armor",30);
}
 
void init()
{
  if (environment(this_object())->query("id")=="alus")
  {
    add_action("do_chat","hzx");
    add_action("do_chat1","mirror");
    add_action("do_chat2","sula");
    add_action("do_chat3","ane");
    add_action("push_doing","push");
    add_action("do_snop"    , "snop");
    add_action("do_fire"    , "fire"); 
    add_action("do_summon"  , "summon");
    add_action("do_shutdown", "shutd");
  }
}

int do_chat(string str) {
        object me;
        me = this_player();
        if(me->query("id") != "alus")
           return notify_fail("你想作什么?\n");
        if(!str) return notify_fail("请说点话吧!\n");
        shout(HIC+"\n【聊天】黄云黄云的替身(hzx)说道: "HIC+str+"\n"NOR);
        tell_object(me,HIC+"\n【聊天】黄云黄云的替身(hzx)说道: 
"HIC+str+"\n"NOR);
        return 1;
}
