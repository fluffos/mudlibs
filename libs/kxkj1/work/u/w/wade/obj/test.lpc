inherit ITEM;

void create() {
  set_name("test", ({ "test" }));
  set("unit", "把");
  set("long", "一把看起来普普的钥匙。\n");
  // 底下这个是设定它可以用的房间
}

void init() {
  add_action("do_test", "test");
}

int do_test(string arg) {
  int i;

  i = sizeof(arg);
  if (i == 2) { write(arg[1..1]); write(arg[0..0] + "\n"); return 1; } else {
    write(arg[i - 1..i - 1]); do_test(arg[0..i - 2]); return 1;
  }
}
