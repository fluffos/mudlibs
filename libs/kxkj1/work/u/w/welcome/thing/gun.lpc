#include <mudlib.h>
#include <armor.h>
#include <ansi.h>

inherit ARMBANDS;

void create() {
  set_name(HIB + "左轮手枪" + NOR, ({ "pistol", "gun" }));
  set("long", @LONG
    这把手枪是阿獠的随身配备，它的攻击力十分强大，保养也很好。在危急时你可以试
用它对你的敌人开枪(shot)，不过如果你对射击技巧不是很有自信的话，最好还是别轻举
妄动。
LONG);
  set_weight(100);
  set("unit", "把");
  seteuid(getuid());
  set("value", 700000);
  set("material", "steel");
  set("armor_type", "armbands");
  set("armor_prop/dodge", 10);
  set("armor_prop/armor", 5);
}

void init() {
  add_action("do_fire", "shot");
}

int do_fire(string str) {
  object target, targetenv;
  int gin1, kee1, sen1;

  if ((string)this_player()->query("id") != "cage") {
    if (random(11) > 5)
      message_vision(HIW + "\n$N掏出手枪开了一枪结果什么也没打到。\n" + HIC +
        "实在逊弊了。\n" + NOR, this_player());
    else {
      message_vision(HIW + "\n$N掏出手枪开了一枪。\n" + HIC +
        "哇！膛爆~~~实在笨死了。\n" + NOR, this_player());
      this_player()->add("kee", -100);
    }
    return 1;
  }
  if (!str || str == "") {
    write(HIR "你掏出手抢对空鸣枪一声！\n" NOR);
    tell_room(environment(this_player()), HIC + this_player()->query("name")
      +HIR "掏出手抢对空开了一枪，枪声响彻十里之内。\n" NOR,
      ({ this_object(), this_player() }));
    return 1;
  }
  target = present(str, environment(this_player()));
  if (!target) target = find_living(str);
  if (!target) {
    write(HIC + "你到底要打什么？\n" + NOR);
    return 1;
  }
  targetenv = environment(target);


  if (target == this_player() || (!target->is_character())) {
    write("这个．．．．不太对吧\n");
    return 1;
  }
  message_vision(HIW + "\n$N掏出手枪对着$n的要害开了一枪。\n" +
    HIR + "\n‘碰’的一声~~~~~\n" +
    HIC + "$p大量的鲜血从钮扣大的伤口激射而出。\n" + NOR,
    this_player(), target, target);
  tell_object(target,
    HIW "当你有意识时，你的身上已经多了一个钮扣般的伤口，鲜血洫洫流出\n" NOR +
    "( 你" + RED "受伤过重，发觉天旋地转，已经站不住脚了。" NOR
    + " )\n");
  target->set_heart_beat(1);
  gin1 = target->query("gin") * 0.99;
  kee1 = target->query("kee") * 0.99;
  sen1 = target->query("sen") * 0.99;
  target->add("gin", -gin1);
  target->add("kee", -kee1);
  target->add("sen", -sen1);
  if (target->query("kee") < 100) target->add("kee", -200);
  return 1;
}

int query_autoload() {
  if (this_player()->query("id") == "cage") return 1;
  return 0;
}
