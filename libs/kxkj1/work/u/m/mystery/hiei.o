dbase (["kee":937,"food":333,"describe":"以前 妳犹如天上的一片云 可望而不可及现在 我却失去了妳的踪影每每在我不经意的偶然 妳悄悄地叩了我的心房我推开窗户 却发现妳已经在远方向我挥手告别逝去的岁月并不值得回想 错过的缘□会让人久久无法忘怀我仿佛就看见命运之神就站在墙边窃笑笑我的痴 笑我的任他摆\布深夜了 妳的声音敲醒了我逐渐层积的对妳的想念突然地闯进了我的世界 告诉我妳就要离开风捎来了妳的消息 也带走了我的思念月 使夜空更美 却黯淡了星光偶然地错过了妳的相约 不知该到何时 风会再把妳送回我身边","chat_msg_combat":({0,}),"title":"仙剑派第四代弟子","relation":(["master chen":(["name":"陈知衡","value":30,]),]),"board_last_read":(["player_b":839266509,"fighter_b":845706224,"start_b":846614669,"wall":840072418,"lungshan":846513853,"sue_b":845379609,"swordsman":846632825,"urd_b":836336157,"oldman_b":845891736,"fs_b":845947991,"wizard_b":839529127,"chen_b":846307530,"killer_b":845960265,"gblade":841959817,"duan_b":846173922,"wizard_j":833639123,"eq_b":833307377,"bad_b":839862635,"skill_b":837509685,"killerwiz_b":843656930,"wade_b":832926937,"poisoner_b":846520708,"doctor_b":843196860,]),"get_sha_sp":1,"kar":10,"birthday":830788453,"atman":800,"startroom":"/open/wiz/courthouse","per":15,"ice-stial":1,"enforceup":0,"potential":398105,"今天":833377890,"pk_lose":65,"PKS":44,"s_kee":38,"force":2501,"status":2,"gender":"男性","int":30,"learned_points":248787,"last_location":"/open/wiz/courthouse","spi":15,"nickname":"[42;1m[1;33m□□□[2;37;0m","officer_class":"大理寺郎中","cor":20,"max_mana":415,"max_s_kee":35,"water":333,"dragon-sword":1,"一周上线时间":103353,"last_from":"140.113.17.156","env":(["传授":(["totoro":(["all":"YES",]),"nala":(["all":"YES",]),"weiwei":(["ghost-steps":"YES",]),"all":(["shasword":"YES",]),]),"7":"YES","wimpy":60,"wait_edit":"YES","no_tell":"YES","":([]),]),"sec_kee":"tiger","unjoin":1,"人际关系":(["dvb":31,"sue":66,"lakers":50,"aeka":37,"love":631,"minimum":2,"phoenix":9,"eho":745,"meimei":1122,"nala":961,"diadia":64,"mufasa":1485,"kurama":20,"snow":517,"kazuya":6,"ice":3,"dellii":149,"lanslort":84,"city":226,"tch":25,"maimai":219,"loip":26,"ahnu":408,"cuteyu":101,"yusuke":10353,]),"couples":(["name":"娜娜","id":"nala",]),"id":"hiei","mana":415,"bank":(["coin":952875,]),"gin":270,"actions":,"secre