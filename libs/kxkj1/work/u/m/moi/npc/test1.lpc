#include <ansi.h>
inherit F_VENDOR;

string magic1();
string magic2();

void create() {
  set_name("龙清和", ({ "chinho" }));
  set("long", "陆清风的师兄,因全心致力于武学之上,故将掌门之位让给他师弟"
    "!!\n");
  set("gender", "男性");
  set("class", "taoist");
  set("combat_exp", 700000);
  set("attitude", "heroism");
  set("age", 53);
  set("title", "天道派护法长老");
  set("str", 25);
  set("cor", 29);
  set("cps", 28);
  set("per", 24);
  set("spi", 25);
  set("int", 26);
  set("force", 3000);
  set_skill("literate", 70);
  set("max_force", 3000);
  set("max_mana", 2000);
  set("mana", 2000);
  set("max_atman", 2000);
  set("atman", 2000);
  set_skill("force", 50);
  set_skill("gforce", 80);
  map_skill("force", "gforce");
  set_skill("dodge", 40);
  set_skill("parry", 60);
  set_skill("whip", 50);
  set_skill("gwhip", 70);
  map_skill("whip", "gwhip");
  map_skill("parry", "gwhip");
  set_skill("gspell", 50);
  map_skill("dodge", "gspell");
  set("force_factor", 10);
  setup();
  carry_object("/u/m/moi/obj/whip")->wield();
  carry_object("/u/m/moi/obj/hat1")->wear();
  carry_object("/u/m/moi/obj/shoe1")->wear();
  carry_object("/u/m/moi/obj/robe1")->wear();
}
