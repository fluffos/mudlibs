// bleed_whip.c
#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create() {
  set_name("鞭子", ({ "whip" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("value", 500);
    set("material", "iron");
    set("long",
      "这是一条普通的鞭子 .\n");
  }
  init_whip(10);
  setup();
}
