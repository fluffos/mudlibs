// chicken_leg.c

#include <weapon.h>

inherit HAMMER;
inherit F_FOOD;

void create()
{
      set_name("烤火鸡", ({ "fried chicken", "chicken" }) );
	set_weight(350);
	if( clonep() )
		set_default_object(__FILE__);
	else {
           set("long", "一只烤得香喷喷的火鸡, 不要犹豫了, 咬吧!!\n");
           set("unit", "只");
           set("value", 0);
           set("food_remaining", 5);
           set("food_supply", 100);
		set("material", "bone");
	}
        init_hammer(0);
	setup();
}

int finish_eat()
{
        set_name("被啃光的鸡骨头", ({ "bone" }) );
	set_weight(150);
        set("long", "肉被啃光的鸡骨头!!\n");
	return 1;
}
