// trainee.c

inherit NPC;

int present;
object *usr = ({});

string give_leg();

void create() {
  set_name("圣诞老公公", ({ "old christmax man", "christmax man", "man" }));
  set("gender", "男性");
  set("age", 85);
  set("long", "你看到一个满脸红光,精神饱满的老公公,正向你招手!!\n"
    "看到他, 不禁让你联想到圣诞节, 问问他吧, 也许\会收到礼物哩\n");
  set("inquiry", ([
    "圣诞节": (: give_leg :),
    "圣诞礼物": (: give_leg :),
    "礼物": (: give_leg :),
  ]));
  present = 50;
  setup();
}

void reset() {
  present = 50;
  usr = ({});
}

string give_leg() {
  object who, leg;
  string name;

  who = this_player();
  name = who->query("id");

  // 最多送 50 份礼物
  if (present == 0) return "对不起喔, 烤火鸡已经送完了。\n";

  // 一人送一次
  if (member_array(name, usr) != -1) return "圣诞快乐呀!\n";

  leg = new("/u/m/moi/obj/chicken_leg.lpc");
  leg->move(who);
  message_vision("圣诞老公公给$N烤火鸡\n", who);
  // 把礼物数减 1
  present = present - 1;
  usr += ({ name });

  return "Merry Christmas!!\n";
}
