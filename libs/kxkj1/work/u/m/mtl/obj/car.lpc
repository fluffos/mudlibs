#define _DIR_ "/u/m/mtl"
inherit NPC;

void create() {
  set_name("法拉利Ｆ４０", ({ "car" }));
  set("long", @LONG

      天啊！这是一部大红色的名贵跑车，低矮的车身，
      浑圆的造型，隐隐可以听见引擎低沈浑厚的吼声，
      好似随时都可能轰的一声消失在地平的另一端。

     你可以开门进入车内(drive)参观再出来(leave)。
LONG);

  set("chat_chance", 10);
  set("chat_msg", ({
    "法拉利Ｆ４０的引擎嘶吼：轰～轰～轰～～\n"
  }));
  set("str", 100);
  set("no_kill", 1);
  set("no_fight", 1);
  setup();
}

init() {
  object car, player;
  car = this_object();
  player = this_player();
  if (environment(car) == environment(player)) {
    add_action("do_look", "look");
    add_action("do_drive", "drive");
  }
  if (environment(player) == car) {
    add_action("do_leave", "leave");
    add_action("do_go", "go");
  }
}

int do_look(string arg) {
  if (arg == "car") {}
}
int do_drive(string arg) {
  object car, player;

  car = this_object();
  player = this_player();

  player->move(car);
  set_temp("long", "
     真皮的座椅与方向盘，核桃木饰板，典雅的内装，
     果然是部名贵的跑车。
");
}

int do_leave(string arg) {
  this_player()->move(environment(this_object()));
}

int do_go(string arg) {
  mapping neighbor;
  string *dirs;
  int exit_no;
  string long, short;
  int i;

  command("go " + arg);
  neighbor = environment(this_object())->query("exits");
  dirs = keys(neighbor);
  exit_no = sizeof(neighbor);
  long = environment(this_object())->query("long");
  short = environment(this_object())->query("short");
  message_vision(short + "\n" + long, this_player());
  write("有路的方向：");
  for (i = 0; i < exit_no; i = i + 1)
    write(dirs[i] + " ");
  write("\n");
  return notify_fail("");
}
