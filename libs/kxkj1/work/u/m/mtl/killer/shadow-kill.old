// shadow-kill by mtl

#include <combat.h>
inherit SKILL;

void busyk(object me,object victim,object weapon, int damage);
void devour(object me, object victim, object weapon, int damage);
void bloodk(object me, object victim, object weapon, int damage);
void reversek(object me, object victim, object weapon, int damage);
void shadowk(object me, object victim, object weapon, int damage);
void devast(object me, object victim, object weapon, int damage);

mapping *action = ({
([ "action":"$N斗然使出‘停云催雪，地落八荒’的绝情杀着，气吞万里如虎，剑虹流星坠雨般的向$n罩去，让$n避无可避。",
	"dodge": -30,
	"parry": 20,
	"damage": 80,
	"force": 30,
	"damage_type": "刺伤",
]),
([ "action":"$N喟然叹道：不恨古人吾不见，恨古人、不见吾狂耳～剑影骤然随着那怅然杀意，使出‘云山千叠，骇浪覆顶’向$n层层递去，招招指向要害。",
	"dodge": -40,
	"parry": 20,
	"damage": 100,
	"force":  40,
	"damage_type":  "刺伤",
	"post_action": (: devour :),
]),
([ "action":"$N似笑非笑，凄凄唸起‘弃魂散魄’心诀。只见$N手上的$w一抹紫孽蒸起，不住旋动，激起一道风刃向$n腰间急劈。",
	"dodge": -40,
	"parry": 25,
	"damage": 120,
	"force": 30,
	"damage_type": "割伤",
	"post_action": (: bloodk :),
]),
([ "action":"$N逆走青玄步法，使出‘乱象错形’的奥秘，陷$n于五行易位之闇黑空间。剑首寂然指向京房卦之血脉卦位，只见$n正向跌跌撞撞地向$w奔去....",
	"dodge": 10,
	"parry": 0,
	"damage": 130,
	"force": 40,
	"damage_type": "刺伤",
	"post_action": (: reversek :),
]),
([ "action":"$N意念一起一息之间，身形已然‘如入不动魔地’，手中$w如来如去，无声无息亦无影地递在$n$l....",
	"dodge": 15,
	"parry": 5,
	"damage": 130,
	"force": 50,
	"damage_type": "刺伤",
	"post_action": (: shadowk :),
]),
([ "action":"$N内照形躯、守窍通关，豁然顿悟了"+BLINK+BOLD+"‘一切有形剑法，"+YEL+"如梦幻泡影"+WHT+"，"+BLU+"如露亦如电"+WHT+"’"+NOR+"。过去所学的闇影剑法，一时之间融会贯通，源源不断在手中使出，化为不可思量之势，涌向$n....",
	"dodge": -30,
	"parry": 20,
	"damage": 150,
	"force": 30,
	"damage_type": "刺伤",
	"post_action": (: devast :),
]),
});

void busyk(object me, object victim, object weapon, int damage)
{
	if(random(200) > (int) me->query("bellicosity")/5 +me->query_skill("shadow-kill",1) )
	{
	  victim->set("start_busy",2);
	  message_vision(sprintf(HIB"趁着$n忙于招架这密如繁星般的攻击之际，$N见机不可失，剑势疾回，意欲再进一招....\n"NOR),me,victim);
	}
}

void devour(object me, object victim, object weapon, int damage)
{
	if( me->query("bellicosity") > 100  )
	if( random(200) < (int)me->query("bellicosity")/5+me->query_skill("shadow-kill",1))
	{
	  victim->receive_damage("kee", 4*me->query("force_factor")+(int)me->query("bellicosity")/20);
	  message_vision(sprintf(HIC"$N$w上枉死的冤魂，受不住$N阵阵杀气的催动，从剑锋脱出，向$n扑噬而去。\n"NOR),me,victim);
	}
}

void bloodk(object me, object victim, object weapon, int damage)
{
	if( random(200) < me->query_skill("force")+me->query_skill("shadow-kill",1) )
	if( damage > 1)
	{
	  victim->add("sen",-10);
	  victim->receive_damage("kee", 5*me->query("force_factor") +
	    (int)me->query_skill("rain-throwing",1)/5 );
	  message_vision(sprintf(HIM"只见从$n$l喷洒而出的鲜血，突然凝成无数血柱，如灵蛇般向$n窜去，摄走$n的魂魄。\n"NOR),me,victim);
	}
}

void reservek(object me, object victim, object weapon, int damage)
{        
	if( random(250) < me->query_skill("gdragon-steps",1)+me->query_skill("shadow-kill",1) )
	{
	  victim->apply_condition("bleeding",(int)me->query_skill("cure")/5 +  
	    random( (int)me->query_skill("shadow-kill",1)/10 +
	      (int)me->query_skill("parry")/10 ) );
	  message_vision(sprintf(HIY"$N双手倒握$w，往自己胸口送去－－却见到$n胸口一道血柱如飞泉般喷出。\n"NOR),me,victim);
	}
}

void shadowk(object me, object victim, object weapon, int damage)
{
	if( random(350) < me->query_skill("force")+
	  me->query_skill("shadow-kill",1) + me->query_skill("gdragon-steps",1) )
	{           
	   victim->recieve_damage("kee",7*me->query("force_factor") +
	     me->query_skill("shadow-kill",1)/5 );
	   message_vision(sprintf(HIB"$N召唤风影化身与$n厮杀。$N的法身迳向$n背后绕去，双手提剑往$n天灵直落。\n"NOR),me,victim);
	}
}

void devast(object me,object victim, object weapon, int damage)
{
	int i,time = me->query_skill("shadow-kill")/10;
	if( me->query("force_factor") >= 10 )
	{
	  if( me->query_temp("devast") == 0 )
	  {
	    me->set_temp("devast",1);
	    message_vision(sprintf(HIR"刺向$n$l....\n"NOR),me,victim);
	    for(i=0;i<time;i++)
	      if( random(2000) < (int)me->query("bellicosity")+1000 )
		COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
	    me->delete_temp("devast");
	  }
	}
}

mapping query_action(object me, object weapon)
{
	int skill_level=(int)(me->query_skill("shadow-kill",1)/10);
	object wea=me->query_temp("weapon");
	if (skill_level<= 5)
	  return action[random(skill_level)];
	if (skill_level>=6)
	  return action[random(6)];
}

int valid_learn(object me)
{
	object wea;
	if( !(wea = me->query_temp("weapon"))
	  || (string)wea->query("skill_type") != "sword" )
	  return notify_fail("你必须先找一把剑才能练剑法。\n");
	if( (int)me->query("max_force") < 10)
	  return notify_fail("你的内力上限不足, 不可以练闇影剑法。\n");
	if(me->query_skill("windforce",1)*3<=me->query_skill("shadow-kill",1))
	  return notify_fail("你的风影心法技能不足，无法练闇影剑法。\n");
	if(me->query_skill("gdragon-steps",1)*3<=me->query_skill("shadow-kill",1))
	  return notify_fail("你的青玄身法技能不足，无法体会闇影剑法里，移形换位之精义。\n");
	if(me->query("bellicosity")<=6*me->query_skill("shadow-kill",1) )
	  return notify_fail("你的杀气不足，不适合训练更高的闇影剑法。\n");
	return 1;
}

int valid_enable(string usage) 
{
	return (usage=="sword"||usage=="parry");
}

int practice_skill(object me)
{
	if( !me->query_temp("weapon") )
	  return notify_fail("练闇影剑法还是要有把剑吧....\n");
	if( (int)me->query("kee") < 30 )
	  return notify_fail("体力不够啰,休息一下再继续练吧.\n");
	me->receive_damage("kee", 30);
	return 1;
}
