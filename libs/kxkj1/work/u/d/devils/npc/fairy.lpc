#include <ansi.h>

inherit NPC;

void create() {
  set("nickname", HIB "天仙" NOR);
  set_name("九天玄女", ({ "fairy" }));
  set("gender", "女性");
  set("age", 19);
  set("long", @LONG
    你看到一位身穿白纱的少女，美目含笑的望着你，她清丽脱俗
的脸庞深深吸引着你的目光。
LONG);

  set("str", 24);
  set("cor", 26);
  set("int", 29);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set("combat_exp", 10000000);
  set("chat_chance", 20);
  set("chat_msg", ({
    HIW "雪缘深深的叹了一口气.......\n" NOR,
    HIW "雪缘喃喃自语：该做什么菜给星尘吃呢?\n" NOR,
    HIW "雪缘玩弄着发梢，突然脸红了起来，大概是想到″星尘″了～\n" NOR,
  }));

  set_temp("apply/attack", 1);
  setup();
  carry_object("/u/d/devils/obj/sword")->wield();
  carry_object("/u/d/devils/npc/obj/linen")->wear();
}
