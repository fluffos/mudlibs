// kenhin.c

inherit NPC;
void do_special();
void create() {
  set_name("绯村剑心", ({ "vagrant kenhin", "vagrant", "kenhin" }));
  set("title", "浪人");
  set("nickname", "拔刀千人斩");
  set("gender", "男性");
  set("age", 35);
  set("attitude", "peaceful");
  set("long",
    "绯村剑心是一个红头发、左脸颊有着十字伤痕的男子，他那充满温柔\n"
    "、及关怀的眼神中看不出一丝杀气，充满稚气的脸庞让人看不出他曾\n"
    "是维新的志士，但他生气起来是相当可怕的!!\n");

  set("kee", 20000);
  set("max_kee", 20000);
  set("str", 40);
  set("cps", 60);
  set("per", 34);
  set("int", 50);
  set("kar", 16);
  set("con", 50);
  set("combat_exp", 3000000);
  set("force", 9000);
  set("max_force", 9000);
  set("force_factor", 10);
  set("score", 500000);


  set("inquiry", ([
    "维新": "就是明治维新啊!!不过那已经过去了!!\n",
    "过去": "过去的事就不要提了\n",
    //                 "奥义":       "是整个泷山拳里最精华的部份，唯持有阳炎臂环的弟子才能学。\n",
    //                 "阳炎臂环":   "要取得此臂环必须接受测验(accept test)\n",
    //                 "测验":       "'\n",
  ]));

  set_skill("move", 70);
  set_skill("unarmed", 60);
  set_skill("sword", 130);
  set_skill("blade", 130);
  set_skill("force", 90);
  set_skill("parry", 150);
  set_skill("dodge", 200);

  set("chat_chance", 10);
  set("chat_msg", ({

    "绯村剑心摸着头观望四周着说: 第一次到这地方，人生地不熟的。\n",
    "绯村剑心掩着肚子, 面有难色说: 肚子好饿喔~~~~~ \n",
  }));

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: do_special :)


  }));
  setup();
  //      carry_object("
  //      carry_object("plumage")->wear();
  add_money("gold", 1000);
}

void do_special() {
  object *enemy, target;
  int i;

  enemy = this_object()->query_enemy();
  i = sizeof(enemy);
  target = enemy[random(i)];

  message_vision(
    "\n绯村剑心拔刀一鸣，[1;36m‘飞天御剑流’～～～～～～～[1;5;34m 龙  槌  闪 [0m  \n", target);
  message_vision(
    "\n绯村剑心手上的刀宛然重锤般由上至下打了下来!!\n", target);
  target->receive_wound("kee", random(200 + 250));
  COMBAT_D->report_status(target);

}
