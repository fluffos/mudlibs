#include <ansi.h>

inherit NPC;
void do_special();
void use_poison(object me, object viction);

mapping *action = ({
  ([
    "action": "$N怒吼一声，用庞大的身躯向$n直扑而来",
    "dodge": 20,
    "parry": -5,
    "damage": 50,
    "damage_type": "骨折"
  ]),
  ([
    "action": "$N纵身一跃，劲运双掌，由上而下攻击，正是一招‘飞龙在天’",
    "dodge": 30,
    "parry": 25,
    "damage": 70,
    "damage_type": "骨折",
  ]),
  ([
    "action": "$N身法忽变，一招‘龙爪手’身体随风而动，飘乎
不定，三指成爪出手诡异，抓向$n",
    "dodge": 35,
    "parry": 40,
    "damage": 80,
    "damage_type": "抓伤",
  ]),
  ([
    "action": "$N高声长啸，一招‘龙吟虎啸’，震得$n站立不住",
    "dodge": 50,
    "parry": 15,
    "damage": 90,
    "damage_type": "内伤"
  ]),
  ([
    "action": "$N双膝微屈，做跪拜投降之势，却趁机扫腿攻向$n下盘，正是一招‘龙困浅滩’",
    "dodge": 30,
    "parry": -10,
    "damage": 160,
    "force": 160,
    "damage_type": "瘀青",
  ]),
  ([
    "action": "$N身形一转使出‘神龙摆\尾’，火红的右臂出其不意的向后拍出，以雷霆之势击向$n",
    "dodge": 10,
    "parry": -20,
    "damage": 130,
    "force": 60,
    "damage_type": "瘀青",
    "post_action": (: use_poison :)
  ]),
  ([ "action": "$N狂啸一声，使出‘亢龙有悔’，刹那间掌影已拢罩$n的全身",
    "dodge": 15,
    "parry": 60,
    "damage": 230,
    "force": 200,
    "damage_type": "内伤",
  ]),
  ([ "action": "$N脸色一沈，集全灵之力，使出必杀招‘青龙藏云杀’，霎时龙在天全身散发出黑气令你如陷五里雾中，在$n摸不清敌人在哪时，一道宏大的气功\从背后袭来。",
    "dodge": 100,
    "parry": 100,
    "damage": 200,
    "force": 180,
    "damage_type": "内伤",
    "post_action": (: use_poison :)
  ]),
});

void create() {
  set_name("龙在天", ({ "long ji tan", "long", "ji", "tan" }));
  set("race", "人类");
  set("nickname", "青龙神将");
  set("age", 39);
  set("long",
    "你看到一个身形魁梧的大汉，他浑身散放着死亡的气息，双目精光闪闪，有如黑暗中\n"
    "的星星，最引你注意的还是他的右手，整只手臂通红，并不断地散放出令人窒息的热\n"
    "气，难道那便是传说中的火龙臂 ?\n");
  set("str", 30);
  set("cps", 30);
  set("kar", 20);
  set("spe", 20);
  set("int", 20);
  set("cor", 30);
  set("kee", 2000);
  set("max_kee", 2000);
  set("limbs", ({ "头部", "胸部", "腿部", "手臂" }));

  set("attitude", "herosim");
  set("combat_exp", 1500000);
  set_skill("dodge", 260);
  set_skill("unarmed", 200);
  set("chat_chance", 10);
  set("chat_msg", ({

    "龙在天喃喃自语：我是奉城主 Lum  之命屠杀，死了不要怨我！\n",
    "龙在天无奈的说：不想死得很痛苦的话，就 suicide -f 吧！怪只怪你们得罪了Lum。\n",
  }));

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: do_special :)
  }));
  set_temp("apply/defend", 100000);
  set_temp("apply/armor", 100000);
  set_temp("apply/damage", 100);
  setup();
  set("default_actions", (: call_other, __FILE__, "query_action" :));
  reset_action();
}

mapping query_action() {
  return action[random(sizeof(action))];
}
void use_poison(object me, object viction) {
  // here can write many thing u want
  viction->apply_condition("burn", 20 + viction->query_condition("burn"));
}
void do_special() {
  object *enemy, target;
  int i;

  enemy = this_object()->query_enemy();
  i = sizeof(enemy);
  target = enemy[random(i)];

  message_vision(
    HIR "\n龙在天大喝一声，看我的‘火龙臂’\n", target);
  message_vision(
    HIR "\n龙在天的右手突然发出一道雄猛的火劲直逼向$N。\n" NOR, target);
  target->receive_wound("kee", random(100));
  COMBAT_D->report_status(target);

}
