inherit ROOM;

void create() {
  set("short", "魔域");
  set("long", @LONG
你现在来到了魔渡众生的老巢--魔域,这里到处都是断肢残驱,仿佛
刚经过一场战争.....
LONG);

  set("exits", ([ /* sizeof() == 5 */
    "down": "/open/wu/room/school8",
    "east": __DIR__ "droom1",
    "fly": "/open/wu/hall/wizroom",
    "hole": __DIR__ "proom1",
    "hall": "/open/wiz/hall1",
  ]));
  set("light_up", 1);
  set("valid_startroom", "1");

  setup();
}
int valid_leave(object me, string dir) {
  if (me->query("class") != "fighter" && dir == "east")
    return notify_fail("这是杀手的禁地!\n");
  return ::valid_leave(me, dir);
}
void init() {
  add_action("do_pass", "pass");
}
int do_pass() {
  object me;
  me = this_player();
  me->move("/open/center/room/inn");
  return 1;
}
