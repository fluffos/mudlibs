// made by ccat

#include <weapon.h>
inherit WHIP;
void create() {
  set_name("金刚拂尘", ({ "dell whisk", "whisk" }));
  set_weight(0);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "绰人的秘密武器"
      + "( change <type>, ex: change sword )\n"
      + "( type : unarmed sword blade whisk whip fan dagger stabber)\n");
    set("unit", "件");
    set("no_drop", 1);
    set("value", 2000);
    set("material", "gold");
  }
  init_whip(100);
  setup();
}
void init() {
  add_action("do_change", "change");
}
int do_change(string str) {
  switch (str) {
    case "unarmed":
      set("skill_type", "unarmed");
      set_name("银爪", ({ "dell claws", "claws", "specail" }));
      write("金刚拂尘开始作奇异的变化.\n金刚拂尘化成了一双金爪.\n");
      break;
    case "sword":
      set("skill_type", "sword");
      set_name("金剑", ({ "dell sword", "sword", "specail" }));
      write("金刚拂尘开始作奇异的变化.\n金刚拂尘化成了金剑.\n");
      break;
    case "blade":
      set("skill_type", "blade");
      set_name("金刀", ({ "dell blade", "blade", "specail" }));
      write("金刚拂尘开始作奇异的变化.\n金刚拂尘化成了金刀.\n");
      break;
    case "dagger":
      set("skill_type", "dagger");
      set_name("金刚匕首", ({ "dell dagger", "dagger" }));
      write("金刚拂尘开始作奇异的变化.\n金刚拂尘化成了金刚匕首.\n");
      break;
    case "stabber":
    case "fan":
    case "pen":
      set("skill_type", "stabber");
      set_name("金刚扇", ({ "dell stabber", "stabber" }));
      write("金刚拂尘开始作奇异的变化.\n金刚拂尘化成了金刚扇.\n");
      break;
    case "whip":
    case "whisk":
      set("skill_type", "whip");
      set_name("金刚拂尘", ({ "dell whisk", "whisk" }));
      write("金刚拂尘变回原来的拂尘.\n");
      break;
    default:
      write("金刚拂尘左变右变,就是无法变成你要的东西.\n");
  }
  return 1;
}
