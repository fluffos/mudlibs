// fu_hat.c
#include <armor.h>
#include <ansi.h>
inherit EQUIP;

void create() {
  set_name(HIY "麒麟冠" NOR, ({ "dark hat", "hat" }));
  set_weight(500);
  set("armor_type", "head");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    set("value", 200000);
    set("material", "steel");
    set("armor_prop/armor", 30);
    set("armor_prop/dodge", 10);
    set("armor_prop/move", 10);

  }
  setup();
}
