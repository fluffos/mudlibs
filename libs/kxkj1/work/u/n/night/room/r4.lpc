#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "白屋门口");
  set("long", @LONG
一栋两层高的红瓦白屋耸立在你眼前, 淡淡的红瓦, 雪白的墙璧, 
是乡下人家的一般样式, 屋内隐隐有嘻闹声传出, 大概是屋主的小孩
正在游戏着, 你看到阳台上小恋正在晾衣服, 她抬头对你望了一望,带
着她那一惯温柔的微笑, 欢迎着你的到访.   
LONG);
  set("valid_startroom", 1);
  set("outdoors", "");
  set("exits", ([
    "enter": __DIR__ "r5",
    "south": __DIR__ "r3",
  ]));
  setup();
}

void init() {
  object me = this_player();
  string str = me->query("id");
  if (!interactive(me)) return;
  if (str == "night" || str == "ccat") return;
  me->move("/obj/void");
  tell_object(me, HIG "私人产业,非请莫入,\n" NOR);

}
