// Room: /u/n/night/workroom
#include <ansi.h>
inherit ROOM;

void create() {
  string long;

  set("short", HIR "狄" HIG "斯" HIY "奈" HIB "乐" HIM "园" NOR);

  long = "" +
    "这里是所有人们的天堂,每个人来到这里都能感觉到欢乐的气氛. 前面有一个很大的广\n" +
    "场,广场中间伫立着一座十分漂亮的" HIC "喷水池" NOR ",你可以看到" HIW "白雪" HIR "公主" +
    NOR "跟七个" HIG "小矮人" NOR "正热情的跟你\n打招呼呢!\n" +
    HIY "□HIR" □ HIY "□HIR" □ HIY "□HIR" □ NOR "跟" HIY "唐" HIG "老鸭" NOR "手上拿着汽球,高" +
    "兴地欢迎你来到这快乐的天堂.\n" +
    "前方不远处有许\多的游乐设施: 旋转木马,云霄飞车,海盗船,还有一个好大好大的摩天轮转\n" +
    "啊转的.你是不是很想进去玩啊?\n" +
    "旁边一座小小的" HIM "糖果屋" NOR ",里面有卖冰淇淋,爆米花,热狗,以及各式各样的糖果跟" +
    "汽水,让你忍\n不住想进去大快朵颐一番. 在这里你可以远离城市的烦嚣,忘却" +
    "各种的烦恼,尽情的游玩,好\n好的放松自己。\n\n\n";

  set("long", long);
  set("valid_startroom", 1);
  set("exits", ([
    "wiz": "/open/wiz/entrance",
    "down": "/open/common/room/inn",
    "konn": "/u/k/konn/workroom",
  ]));
  set("light_up", 1);
  set("no_magic", 1);
  set("no_fight", 1);
  set("no_clean_up", 1);
  setup();
}
