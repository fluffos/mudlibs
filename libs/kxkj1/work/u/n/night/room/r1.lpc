#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "十二橡树园");
  set("long", @LONG
你正处于一栋乡村宅院大门前, 隔着镂花白滨铁大门, 你可以看到
院子里花木扶疏, 绿油油的大草坪随地展开, 有喷泉流水, 蝶蜂飞舞, 
稍远处老树拔地而起, 形成处处的绿阴, 正是庭院深深, 好景处处, 好
一户清闲人家. 滨铁大门是关着的, 你可以试着打开它(open door).
LONG);
  set("valid_startroom", 1);
  set("outdoors", "");
  set("item_desc", ([
    "north": (: look_door, "north" :),
  ]));
  set("exits", ([
    "north": __DIR__ "r2",
    "south": "/u/n/night/workroom",
  ]));
  create_door("north", HIW "镂花白滨铁大门" NOR, "south", DOOR_CLOSED);
  setup();
}

void init() {
  object me = this_player();
  string str = me->query("id");
  if (!interactive(me)) return;
  if (str == "night" || str == "ccat") return;
  me->move("/obj/void");
  tell_object(me, HIG "私人产业,非请莫入,\n" NOR);

}
