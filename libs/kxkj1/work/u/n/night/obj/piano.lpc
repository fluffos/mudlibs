inherit ITEM;
void create() {
  set_name("钢琴", ({ "piano" }));
  set_weight(400000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一台yamaha 的 piano,妳可以弹弹它(play).\n");
    set("value", 10000);
  }
}
void init() {
  add_action("do_play", "play");
}
int do_play(string str) {
  write("钢琴传出阵阵优美琴声: 5 5 4 4 3 2  5 6 5 i 3 2  2 2 2 3 2 1  1.\n" +
    "                      海蓝蓝的天气 海蓝蓝的天气 我的爱是lemontree...\n");
  return 1;
}
