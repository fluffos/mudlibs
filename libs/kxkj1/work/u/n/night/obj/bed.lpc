inherit ITEM;
void create() {
  set_name("弹簧床", ({ "bed" }));
  set_weight(400000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一张软软的弹簧床, 上面放着几只小喵咪布偶,\n" +
      "看的你好想下去睡睡(sleep).\n");
    set("value", 10000);
  }
}
void init() {
  add_action("do_sleep", "sleep");
}
int do_sleep(string str) {
  object me = this_player();
  str = me->query("id");
  if (str != "night" && str != "ccat") {
    write("不要随便躺别人的床.\n");
    return 1;
  }
  me->add("age", -1);
  write("妳躺在软软的弹簧床上,感到全身舒适.\n");
  return 1;
}
