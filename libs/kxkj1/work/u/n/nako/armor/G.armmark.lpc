// germany_armmark.c

inherit EQUIP;

void create() {
  set_name("师团臂章", ({ "Germany mark", "mark" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "武装亲卫队大德意志师团团徽.\n");
    set("unit", "枚");
    set("value", 500);
    set("material", "cloth");
    set("armor_type", "armbands");
    set("armor_prop/armor", 1);
  }
  setup();
}
