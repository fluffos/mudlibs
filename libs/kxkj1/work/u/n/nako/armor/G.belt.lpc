#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create() {
  set_name("德军用腰带", ({ "Germany belt", "belt" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "德意志陆军制式腰带,黑色,皮革制.\n");
    set("material", "leather");
    set("value", 500);
    set("armor_type", "waist");
    set("armor_prop/armor", 10);
    set("arnor_prop/unarmed", 2);
  }
  setup();
}
