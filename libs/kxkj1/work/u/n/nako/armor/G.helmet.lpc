// germany_helmet.c

inherit EQUIP;

void create() {
  set_name("德军钢盔", ({ "Germany helmet", "helmet" }));
  set_weight(2500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "德意志陆军制式钢盔,一九四一年克鲁伯兵工厂制造.\n");
    set("unit", "顶");
    set("value", 950);
    set("material", "steel");
    set("armor_type", "head");
    set("armor_prop/armor", 7);
  }
  setup();
}
