inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIW "日本名产水蜜桃" NOR, ({ "momo" }));
  set("long", "又大又红的水蜜桃, 散发出一股诱人的香气, 是 Nako 从日本带回来给大家吃的礼物。\n");
  set("unit", "颗");
  set("base_weight", 50);
}

void init() {
  if (this_player() == environment())
    add_action("do_eat", "eat");
}

int do_eat(string arg) {
  if (!arg || arg != "momo") return notify_fail("你要吃什么? \n");

  message_vision(HIY
    "$N三两口把水蜜桃吃完, 一股甜美极了的滋味在$N的口中散布开来.....\n" +
    "$N脸上露出幸福的表情....\n" NOR, this_player());

  this_player()->add("food", 50);
  this_player()->add("water", 50);
  destruct(this_object());
  return 1;
}
