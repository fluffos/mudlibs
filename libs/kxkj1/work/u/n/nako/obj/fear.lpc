inherit ITEM;
#include <ansi.h>

void create() {
  set_name("无线电收发报机", ({ "radio" }));
  set("long", @LONG
一台军用无线电,你可以将它调(turn)至特定频道收信和发报。
频道 1 : 刀客频道 (turn1)       <用 blademan 发信>
频道 2 : 剑士频道 (turn2)       <用 swordsman 发信>
频道 3 : 魔教徒频道 (turn3)     <用 poisoner 发信>
LONG);
  set("unit", "台");
  set("base_weight", 200);
}

void init() {
  if (this_player() == environment()) {
    add_action("do_turn1", "turn1");
    add_action("do_turn2", "turn2");
    add_action("do_turn3", "turn3");
    add_action("do_turn4", "turn4");
    add_action("do_turn5", "turn5");
    add_action("do_turn6", "turn6");
  }
}

int do_turn1(string arg) {
  message("system", "陈蝶衣走了过来。\n", users());
  return 1;
}

int do_turn2(string arg) {
  message("system", "陈蝶衣用一种异样的眼光扫视在场每一个人。\n", users());
  return 1;
}

int do_turn3(string arg) {
  message("system", "陈蝶衣对你喝道：本姑娘我看你实在不顺眼，去死吧！\n", users());
  return 1;
}

int do_turn4(string arg) {
  message("system", HIR "看起来陈蝶衣想杀死你！\n" NOR, users());
  return 1;
}

int do_turn5(string arg) {
  message("system", HIB "只见天上降下一朵云陇罩着陈蝶衣\n" NOR, users());
  return 1;
}

int do_turn6(string arg) {
  message("system", "陈蝶衣自杀了，你以后再也看不到这个人了。\n", users());
  return 1;
}
