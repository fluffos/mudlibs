//skuld bomb by urd
#include <mudlib.h>
#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIW + "诗寇蒂炸弹" + NOR, ({ "skuld bomb", "bomb" }));
  set("long",
    "这是诗寇蒂专用的炸弹。\n");
  set_weight(1);
  set("unit", "颗");
  seteuid(getuid());
}
void init() {
  add_action("fire", "trow");
}
int query_auto_load() {
  return 1;
}
int fire(string str) {
  object target, targetenv;
  int gin1, kee1, sen1;
  if ((string)this_player()->query("id") != "nako")
    return notify_fail("这不是你所用的炸弹!!\n");
  if (!str || str == "") {
    write(HIW "$N从衣服内取出一颗炸弹往$n丢了过去................\n" NOR);
    tell_room(environment(this_player()), HIC + this_player()->query("name")
      +HIW "看见$N从衣服中取出了一棵炸弹，边往$n丢去边喊‘诗  寇  蒂  炸  弹～～～’
\n" NOR,
      ({ this_object(), this_player() }));
    return 1;
  }
  target = present(str, environment(this_player()));
  if (!target) target = find_living(str);
  if (!target) {
    write(HIY "看清楚在用炸弹...OK??\n" NOR);
    return 1;
  }
  targetenv = environment(target);
  if (target != this_player())
    write(HIW "诗  寇  蒂  终  级  炸  弹～～～\n");
  else {
    write("想炸自己?? 用 suicide -f 比较快啦！\n");
    return 1;
  }
  tell_object(target,
    HIW "突然从某处飞过来一颗炸弹, 正打中打在你身上!!\n" NOR +
    "( 你" RED "受伤过重, 已经有如风中残烛, 随时都有可能断气。" NOR ")\n");
  return 1;
}
