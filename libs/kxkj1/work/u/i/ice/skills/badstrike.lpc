// badstrike.c
#include <combat.h>
#include <ansi.h>

inherit SKILL;

void bleed(object me, object victim, object  weapon, int damage);
void block(object me, object victim, object  weapon, int damage);
void suck(object me, object victim, object  weapon, int damage);
void upforce(object me, object victim, object  weapon, int damage);
void berserk(object me, object victim, object  weapon, int damage);

mapping *action = ({
        ([      "action":               "$N邪念一动，「恶向胆边生”，化解$n的层层防守，攻向$n的最弱处$l",
                "dodge":                5,
                "parry":                5,
                "force":                20,
		"damage":		20,
                "damage_type":  "瘀伤"
        ]),
	([	"action":		"$N使出一招「厄运当头”，击向$n的天庭盖\",
		"dodge":		10,
		"parry":		10,
		"force":		25,
		"damage":		25,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"$N使出一招「恶意中伤”，无情的往$n的$l狂攻而去",
		"dodge":		10,
		"parry":		10,
		"force":		35,
		"damage":		35,
		"post_action":		(: bleed :),
		"damage_type":	"瘀伤"
	]),
	([	"action":		"$N使出「饿虎扑食”，身形如饿虎般欺至$n身前，噬向$n的$l",
		"dodge":		25,
		"parry":		25,
		"force":		50,
		"damage":		50,
		"post_action":		(: suck :),
		"damage_type":	"瘀伤"
	]),
	([	"action":		"$N身形一变，使出「扼杀诀”，如死神般攻向$n的$l",
		"dodge":		35,
		"parry":		35,
		"force":		70,
		"damage":		70,
		"post_action":		(: block :),
		"damage_type":	"瘀伤"
	]),
	([	"action":		"$N大喝一声，卷起一股「恶势力”击向$n，要$n屈服于其下",
		"dodge":		50,
		"parry":		50,
		"force":		100,
		"damage":		100,
		"post_action":          (: upforce :),
		"damage_type":	"瘀伤"
	]),
	([	"action":		"$N吐气扬声，真气运至最高境界，终极奥义「鬼哭神嚎”呼之欲出，无情地想将$n化为灰烬",
		"parry":		75,
		"dodge":		75,
		"force":		150,
		"damage":		150,
		"post_action":		(: berserk :),
		"damage_type":	"瘀伤"
	]),
});



int valid_learn(object me)
{
	if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
		return notify_fail("练恶霸掌必须空手。\n");
	if( (int)me->query_skill("badforce", 1) < 10 )
		return notify_fail("你的恶化魔功不够恶化，无法修练恶霸掌。\n");
	if( (int)me->query("max_force") < 20 )
		return notify_fail("你的内力太弱，无法练恶霸掌法。\n");
        if((int)me->query("bellicosity") < 30 )
          	return notify_fail("你的杀气不够，不能修练恶霸掌。\n");
	return 1;
}

int valid_enable(string usage) { return usage=="unarmed"; }

mapping query_action(object me, object weapon)
{
int skill_level, limit;

        skill_level=(int)me->query_skill("badstrike", 1);
        if (skill_level < 10)
                return action[random(2)];
        else if (skill_level < 25 )
                return action[random(3)];
        else if (skill_level < 45 )
                return action[random(4)];
        else if (skill_level < 70 )
                return action[random(5)];
        else if (skill_level < 100 )
                return action[random(6)];
        else 
                return action[random(sizeof(action))];
}                                                           

void bleed(object me, object victim, object  weapon, int damage)
{
	if(damage > 50 && !me->query_temp("berserk"))
	{
		victim->receive_wound("kee", random((int)damage / 20 + (int)me->query_skill("badforce", 1)/10));
		message_vision(HIM"$N用内力把$n震伤，不停的狂吐鲜血。\n"NOR, me, victim);
		COMBAT_D->report_status(victim, 1);
	}
}

void block(object me, object victim, object  weapon, int damage)
{
	if(me->query_skill_mapped("force")=="badforce" && !me->query_temp("berserk") && me->query("combat_exp") > random(victim->query("combat_exp")))
	{
		victim->start_busy( (int)me->query_skill("badforce", 1) / 20 + 2);
		message_vision(HIB"$N暗使内力，使得$n为其恶化魔功\所震而暂时无法动弹。\n"NOR, me, victim);	
	}
}

void suck(object me, object victim, object  weapon, int damage)
{
	int lose;
	if( damage > 0 && victim->query("force") > 0 && me->query_skill_mapped("force") == "badforce" && !me->query_temp("berserk"))
	{
		lose = (int)me->query_skill("badforce", 1)/5 + 5;
		if( victim->query("force") < lose)
			lose = victim->query("force");
	 	me->add("force", lose);
		victim->add("force", -lose);
		message_vision(HIY"$N使出恶化魔功\之吸功\大法，把$n的功\力吸去不少。\n"NOR, me, victim);
	}
}

void remove_upforce(object me);

void upforce(object me, object victim, object  weapon, int damage)
{
	int skill;

	skill = (int)me->query_skill("badforce", 1)/10;
	if( !me->query_temp("berserk") && !me->query_temp("upforce") && damage>50 && me->query_skill_mapped("force")=="badforce")
	{
		message_vision(HIG"$N一击得手，$n的鲜血激发了恶化魔功\的潜能，内力暴长。\n"NOR, me, victim);
		me->set_temp("oldforce", me->query("force_factor"));
		me->set("force_factor", (int)me->query("force_factor")*skill/4+1);
		me->set_temp("upforce", 1);
		me->start_call_out( (: call_other, __FILE__, "remove_upforce", me :),  skill);
	}
}

void remove_upforce(object me)
{
          me->set("force_factor", me->query_temp("oldforce"));
	  me->delete_temp("oldforce");
          me->delete_temp("upforce");
          message_vision(HIW"$N狂意渐退，内力渐渐收回。\n"NOR, me);
}

void berserk(object me, object victim, object  weapon, int damage)
{
        int lose, i;
	if(!me->query_temp("berserk") && me->query("combat_exp") > random(victim->query("combat_exp")))
	{
        	lose = (int)me->query_skill("badstrike", 1)/10 + 1;
		me->set_temp("berserk", 1);
		for(i = 0;i < lose; i++)
		{
        		message_vision(HIR"$N打出恶霸掌之连击技，向$n狂风暴雨般横扫而去。\n"NOR, me, victim);
			COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
		}
		me->delete_temp("berserk");
	}
} 

int practice_skill(object me)
{
        if((int)me->query("bellicosity")<30)
          	return notify_fail("你的杀气不够，不能修练恶霸掌。\n");
        if( (int)me->query("force") < 10 )
                return notify_fail("妳的内力不够了。\n");
	if( (int)me->query("kee") < 30 )
		return notify_fail("你的体力不够了，休息一下再练吧。\n");
	me->receive_damage("kee", 30);
	me->add("bellicosity",-1);
        me->add("force", -10);                   
	return 1;
}
