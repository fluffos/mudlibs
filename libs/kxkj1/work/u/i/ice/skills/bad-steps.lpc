// bad-steps.c
//#include <combat.h>

inherit SKILL;

string *dodge_msg = ({
  "$n使出「恶行恶状”大摇大摆\的闪开$N的招式。\n",
  "$n不知道哪个时候用了「恶劣行径”闪的好远，让$N的猛招扑了空。\n",
  "$n沉气运出「扼守要害”硬是要得地把$N的招式接了下来。\n",
  "$n突然使出「阿腴奉承”的绝招，让$N一时得意忘形忘了攻击。\n",
});

int valid_enable(string usage) {
  return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) {
  if ((int)me->query("spi") > 20)
    return notify_fail("你的灵性太高，没有办法练恶毒身法。\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}
