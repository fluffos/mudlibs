// This is a room made by roommaker.

inherit ROOM;

void create() {
  set("short", "冰法庭");
  set("long", @LONG
这里是审判笨蛋的法庭, 如果你答不出冰判官的问题, 那你代志就大条了!!!!!
这里有一张纸条 (note) 仿佛有着重要的讯息, 说不定是离开这里的方法喔!! 冰判
官仿佛一直盯着你, 让你喘不过气来, 呼吸困难!!
LONG
  );
  set("item_desc", ([
    "note": "WARNING!!! 不要意图消灭冰判官, 否则后果不堪设想!!\n"
  ]));
  setup();
  set("no_clean_up", 0);
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_spells", 1);
  set("objects", ([
    __DIR__ "judge": 1 ]));

  setup();
}

void test_me(object me) {
  me->set_temp("old_startroom", me->query("startroom"));
  me->set("startroom", __FILE__);
  me->set_temp("last_location", base_name(environment(me)));
  message_vision("忽然一阵闪光罩住了$N。\n", me);
  me->move(this_object());
}
