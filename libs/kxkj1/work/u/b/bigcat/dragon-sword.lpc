// sword.c : an example weapon
#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  seteuid(getuid());
  set_name(HIW "龙气剑" NOR, ({ "dragon sword", "sword" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "郑士欣在四十年前 ,收服为害于北海之水龙 ,
并将此龙千年修行之灵气收集 ,提炼成这把冠
绝当世的宝剑 .\n");
    set("value", 10000);
    set("material", "steel");
    set("str", 30);
    set("ski_type1", "sword");
    set("ski_level1", 40);
    set("ski_type2", "shasword");
    set("ski_level2", 50);
    set("wield_msg", "$N运起内劲,右手一股无形剑气冲出,正是$n 。\n");
    set("unwield_msg", "$N将右手内劲收回,$n消失无形 。\n");
  }
  init_sword(100);
  setup();
}
