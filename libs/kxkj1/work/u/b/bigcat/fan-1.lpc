// made by ccat
#include <weapon.h>
inherit sword;
void create() {
  set_name("赤麟□剑", ({ "creat sword" }));  // 绝对不要单独 sword
  set_weight(15000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "传说为某铁匠为报全家被绿毛所杀之仇 ,纵身投入火炉所铸之复仇之剑 .\n" +
      "( 如果失灵,请重新 unwield,wield 再去战斗.)\n");
    set("unit", "件");
    set("value", 1000);
    set("material", "steel");
    set("no_sell", 1);
  }
  init_sword(15);
  setup();
}

void init() {
  add_action("do_drop", "drop");
  add_action("do_auc", "auc");
  add_action("do_wield", "wield");
  add_action("do_give", "give");
  add_action("do_unwield", "unwield");
  add_action("do_kill", "kill");
  add_action("do_fight", "fight");
}
int do_fight(string str) {
  int sword, _call_out_sword;
  object ob;
  ob = this_player();
  sword = ob->query_temp("sword", 1);
  _call_out_sword = ob->query_temp("_call_out_sword", 1);
  if (sword && (!_call_out_sword)) {
    ob = new("/open/gsword/obj_sp/sword-1-sp.lpc");
    ob->move(environment(this_player()));
    this_player()->set_temp("_call_out_sword", 1);
    ob->invocation(this_player(), str);
  }
}
int do_kill(string str) {
  int sword, _call_out_sword;
  object ob;
  ob = this_player();
  sword = ob->query_temp("sword", 1);
  _call_out_sword = ob->query_temp("_call_out_sword", 1);
  if (sword && (!_call_out_sword)) {
    ob = new("/open/gsword/obj_sp/sword-1-sp.lpc");
    ob->move(environment(this_player()));
    this_player()->set_temp("_call_out_sword", 1);
    ob->invocation(this_player(), str);
  }
}
int do_wield(string str) {
  if (str == "evil_sword" || str == "all") {
    this_player()->set_temp("sword", 1);
    message_vision("$N手握赤麟 ,复仇怨念冲激使$N全身涨红 ,隐约散发出一股肃杀之气 .\n", this_player());
  }
}
int do_drop(string str) {
  if (str == "evil_sword" || str == "all") {
    this_player()->delete_temp("sword");
    message_vision("$N将赤麟放下 ,逐渐恢复心智.\n", this_player());
  }
}
int do_give(string str) {
  if (str == "evil_sword" || str == "all") {
    this_player()->delete_temp("sword");
    message_vision("$N将赤麟放下 ,逐渐恢复心智..\n", this_player());
  }
}
int do_unwield(string str) {
  if (str == "evil_sword" || str == "all") {
    this_player()->delete_temp("_call_out_sword");
    this_player()->delete_temp("sword");
    message_vision("$N将赤麟放下 ,逐渐恢复心智..\n", this_player());
  }
}
int do_auc(string str) {
  if (str == "evil_sword" || str == "all") {
    this_player()->delete_temp("sword");
    message_vision("$N将赤麟放下 ,逐渐恢复心智..\n", this_player());
  }
}
