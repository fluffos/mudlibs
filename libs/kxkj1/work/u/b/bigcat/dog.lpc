// dog.c
// 建 npc(mob) 时, 请参考 /doc/guild 下的东东

// 所谓的 inherit 是继承的意思
// 被继承的物件有的功能都可以用
// 譬如膏药, 好的坏的都一样是膏药, 其实都可以有相同部份
// 所以可以先写好相同部份, 再给人继承改不同部份
// 底下 NPC 的定义请看 /include/globals.h
inherit NPC;

void create() {
  // 给名字时, 中文摆前面, 英文部份可以多个, 但是一定不能给大写, 
  set_name("大狼狗", ({ "wolf dog", "wolf", "dog" }));
  // 如果未指定种族, 系统将会自动选定人类。
  set("race", "野兽");
  set("age", 3);
  // 设定 long 有两种方法, 可以参考房间的叙述
  set("long", "泷山派训练负责看守大门的大狼犬,如果你居心不良或有什么不轨的企图,那么它就会主动攻击你...\n");

  {}
  // 设定属性
  // 设定的东西可以参考 /doc/build/npc
  set("str", 24);
  set("cor", 26);

  // 设定攻击时出现的攻击部位
  set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  // chat_chance 设定说话速度，数字越大说的越快
  set("chat_chance", 15);
  set("chat_msg", ({
    // 底下这一行会自动走, 拿掉就不会了
    // (: this_object(), "random_move" :),
    "大狼狗正仔细的观察你。\n",
    "大狼狗在你的身体上嗅了一会儿。\n",
    "大狼狗抬起脚在你的身上撒了一泡尿。\n" }));

  set_temp("apply/attack", 15);
  set_temp("apply/armor", 15);

  // 这一段最底下这一行会让 mob 穿上防具
  // 注意, 我是希望采用相对法, 怎么相对呢?
  // 假如你有一个档叫 wade.h, 定义在 /u/w/wade 下
  // 内容可以真的去参考看看 /u/w/wade/wade.h
  // carry_object(WADE_OBJ"/cloth")->wear();

  setup();
}
void init() {
  object ob;
  ::init();
  ob = this_player();
  remove_call_out("greeting");
  call_out("greeting", 1, ob);
}
void greeting(object ob) {
  if (ob->query("per") == 10) {
    say("1");
    kill_ob(ob);
  }
  say("2");
}
