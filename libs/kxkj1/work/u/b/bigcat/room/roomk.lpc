#include <room.h>

inherit ROOM;

void create() {
  set("short", "仙剑派正厅");
  set("long", @LONG
  一进这房间,金光闪耀,你突然感到晕炫,往后退了两三步,好不容易站稳了,你仔细一
看,不禁泪盈满匡,心中一阵激动,厅内站的不是别人,正是仙剑派无极真人,他正是你费
尽千辛万苦所寻找的人,在环顾四周,你不禁更为吃惊,大厅有四根金龙柱,而四旁挂着
四盏琉璃灯,两旁更有无数的奇珍异宝。



LONG
  );

  set("objects", ([
    "/u/s/shorst/npc/tony": 1 ]));
  set("valid_startroom", 1);
  set("no_fight", "1");
  set("exits", ([
    "north": "/u/b/bigcat/room/roomh",
    "south": "/u/b/bigcat/room/roomn",
    "east": "/u/b/bigcat/room/rooml",
    "west": "/u/b/bigcat/room/roomj"
  ]));

  setup();
}
