#include <room.h>

inherit ROOM;

void create() {
  set("short", "仙剑派大厅");
  set("long", @LONG
    你一进来就觉得这个地方气派不凡,厅内整齐非凡,四处泛着白光,你不禁怀疑
    自己是否来到了仙境,只见厅内站着一位慈祥的老者,他似忽似笑非笑的望着你
    ,仔细一看,原来白光是发自这位老者的身上!!



LONG
  );

  set("exits", ([
    "south": "/u/b/bigcat/room/roomh",
    "out": "/u/b/bigcat/room/test"
  ]));
  setup();
}
