#include <room.h>

inherit ROOM;

void create() {

  set("short", "河边");
  set("long", @LONG
这是小溪的南岸，在两旁都是巨木的陪衬下，这条小溪就小的更加为不足道了，
不过倒是这条小溪为这片森林带来更丰富的生命，也为一些花花草草带来生存
的空间。
LONG
  );

  set("exits", ([
    "west": __DIR__ "wriver",
    "south": __DIR__ "wfair1",
    "east": __DIR__ "wriver2"
  ]));
  setup();

}
