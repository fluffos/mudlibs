// 青楼 妓女
#include "/open/open.h"
inherit NPC;
void create() {
  set_name("春兰", ({ "lan" }));
  set("nickname", "琵\琶女");
  set("title", "青楼名妓");
  set("long", "四名妓中她排行第二，她是青楼最刁钻的姑娘，但由于身材是全"
    "青楼最\n标致的，且颇受大爷们的喜爱。因此连妈妈桑也奈何不了她。她"
    "最善长\n的是琵\琶，因此也叫「琵\琶女”。\n");
  set("gender", "女性");
  set("class", "scholar");
  set("attitude", "peaceful");
  set("age", 20);
  set("force", 500);
  set("max_force", 500);
  set("combat_exp", 172500);
  set_skill("force", 40);
  set_skill("dodge", 40);
  set_skill("parry", 40);
  set_skill("unarmed", 50);
  set_skill("sunforce", 60);
  set_skill("linpo-steps", 60);
  set_skill("six-fingers", 70);
  map_skill("force", "sunforce");
  map_skill("dodge", "linpo-steps");
  map_skill("move", "linpo-steps");
  map_skill("parry", "six-fingers");
  map_skill("unarmed", "six-fingers");
  set_temp("apply/damage", 40);
  set("force_factor", 10);
  setup();
  add_money("gold", 1);
}
void greeting(object ob) {
  int gender, per, age;
  gender = 0;
  age = ob->query("age");
  if (!ob || environment(ob) != environment()) return;
  if (ob->query("gender") == "女性")
    gender = 1;
  switch (random(1)) {
    case 0:
      if (age < 20 && gender)
        say("喂!" + RANK_D->query_respect(ob) + "，这里不是小孩子" +
          "该来的地方喔!! 快离开吧!!\n");
      if (age < 20 && !gender)
        say(RANK_D->query_respect(ob) + "也来这种地方??有没搞错??" +
          "小心弄坏身体呦!!\n");
      if (age < 30 && age > 19 && gender)
        say("这位" + RANK_D->query_respect(ob) + "，这不是妳应该来的" +
          "地方喔!!快离开吧!!\n");
      if (age < 30 && age > 19 && !gender)
        say("这位" + RANK_D->query_respect(ob) + "，快进来坐坐" +
          "让冬儿我服伺您。\n");
      if (age > 29 && gender)
        say("这位" + RANK_D->query_respect(ob) + "，妳年纪也不小了" +
          "，来这做什么呢?\n");
      if (age > 29 && !gender)
        say(RANK_D->query_respect(ob) + "，您都不小了还来这" +
          "，可见您的身子一定还非常健康啰!!\n");
      break;
  }
}
