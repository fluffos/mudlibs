#include <combat.h>
#include <ansi.h>
inherit SKILL;

void hurt(object me, object victim, object weapon, int damage);
void bleed(object me, object victim, object weapon, int damage);
void conti(object me, object victim, object weapon, int damage);

mapping *action = ({
  ([ "action": "$N使出八卦掌中的第一招「未卜先知”，掌风向$n$l拍去",
    "dodge": -30,
    "parry": -20,
    "damage": 20,
    "force": 400,
    "damage_type": "掌伤",
    "weapon": "「未卜先知”",
  ]),

  ([ "action": "$N使出八卦掌中的第二招「光风霁月”，掌风跿的增强，向$n$l拍去",
    "dodge": -40,
    "parry": -15,
    "damage": 30,
    "force": 300,
    "damage_type": "掌伤",
    "weapon": "「光风霁月”",
  ]),

  ([ "action": "$N使出八卦掌中的第三招「先发制人”，右手手掌轮番向$n$l拍去",
    "dodge": -35,
    "parry": -20,
    "damage": 40,
    "force": 400,
    "damage_type": "掌伤",
    "weapon": "「先发制人”",
    "post_action": (: bleed :),
  ]),
  ([ "action": "$N使出八卦掌中的第四招「后发先至”，左手手掌自胁下穿过拍向$n$l",
    "dodge": 25,
    "parry": 0,
    "damage": 50,
    "force": 500,
    "damage_type": "掌伤",
    "weapon": "「后发先至”",
  ]),
  ([ "action": "$N使出八卦掌中的第五招「物换星移”，忽左忽右的拍向$n$l",
    "dodge": -50,
    "parry": -20,
    "damage": 50,
    "force": 300,
    "damage_type": "掌伤",
    "weapon": "「物换星移”",
    "post_action": (: hurt :),
  ]),
  ([ "action": "$N使出八卦掌中的第六招「柔能克刚”，手掌绵绵不绝的拍向$n$l",
    "dodge": -50,
    "parry": -20,
    "damage": 130,
    "force": 300,
    "damage_type": "掌伤",
    "weapon": "「柔能克刚”",
    "post_action": (: hurt :),

  ]),
  ([ "action": "$N使出八卦掌中第七招「归去来兮”，左、右掌轮番向$n$l击去",
    "dodge": -50,
    "parry": -20,
    "damage": 140,
    "force": 300,
    "damage_type": "掌伤",
    "weapon": "「归去来兮”",
    "post_action": (: conti :),
  ]),
  ([ "action": "$N使出八卦掌中第八招「玉石俱焚”，大喝一声双掌同时向$n$l拍去",
    "dodge": -30,
    "parry": -20,
    "damage": 90,
    "force": 40,
    "damage_type": "掌伤",
    "weapon": "「玉石俱焚”",
    "post_action": (: bleed :),
  ]),
});

void hurt(object me, object victim, object weapon, int damage) {
  if (me->query("force_factor") > 0)
    if (random(500) < me->query_skill("force") + me->query_skill("six-fingers", 1)) {
      victim->receive_damage("kee", 3 * me->query("force_factor") + me->query_skill("sunforce"));
      message_vision(
        sprintf("[1;35m$N六脉神剑诡异的气劲钻入$n体内, $n脸上突然一阵青白, 看来已受了不小的内伤。\n[0m"),
        me,
        victim
      );
      if (damage <= 0)
        COMBAT_D->report_status(victim);
    }
}
void bleed(object me, object victim, object weapon, int damage) {
  if (damage > 40) {
    victim->apply_condition("bleeding",
      random(me->query_skill("sunforce") + me->query_skill("six-fingers")) / 10);
    message_vision(sprintf("[1;31m$N六脉神剑的剑意斩断了$n身上的动脉，开始泊泊的流出鲜血。[0m\n"), me, victim);
  }
}
void conti(object me, object victim, object weapon, int damage) {
  int i, time = random(me->query_skill("six-fingers") / 15);
  if (me->query("force_factor") >= 10) {
    if (me->query_temp("conti") == 0) {
      me->set_temp("conti", 1);
      message_vision(
        sprintf("\n[1;33m$N忽然顿悟六脉神剑[1;5;36m气游百穴[0m、[1;5;36m连绵不绝[0m[1;33m的要诀, 剑气自然而然的破体而出, 欲罢不能!![0m\n"),
        me
      );
      for (i = 0; i <= time; i++)
        COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
      me->delete_temp("conti");
    }
  }
}

mapping query_action(object me, object weapon) {
  int skill_level = (int)(me->query_skill("six-fingers", 1) / 10);
  object wea = me->query_temp("weapon");

  if (wea != 0)
    if (wea->query("skill_type") == "stabber")
      return action[random(7) + 7];
  if (skill_level <= 6)
    return action[random(skill_level)];
  else
    return action[random(7)];
}

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练六脉神剑还是要空手吧....\n");
  if ((int)me->query("max_force") < 10)
    return notify_fail("你的内力上限不足, 不可以练六脉神剑。\n");
  if (me->query_skill("force") * 3 <= me->query_skill("six-fingers", 1))
    return notify_fail("你的基本内力技能不足, 无法练六脉神剑。\n");
  if (me->query_skill("literate") * 3 <= me->query_skill("six-fingers", 1))
    return notify_fail("你的知识不足，无法体会六脉神剑里，全身经脉运行之道的精要变化。\n");
  return 1;
}

int valid_enable(string usage) {
  if (this_player()->query_skill("six-fingers", 1) >= 45) {
    return (usage == "unarmed" || usage == "stabber") || (usage == "parry");
  }
  return (usage == "unarmed");
}

int practice_skill(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练六脉神剑还是要空手吧....\n");
  if ((int)me->query("gin") < 5)
    return notify_fail("你的精不够，无法练习。\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("体力不够啰,休息一下再继续练吧.\n");
  if ((int)me->query("force") < 1)
    return notify_fail("目前内力不足,休息一会儿再练吧.\n");
  me->receive_damage("gin", 5);
  me->receive_damage("kee", 30);
  me->add("force", -1);
  return 1;
}
string perform_action_file(string action) {
  return CLASS_D("scholar") + "/six-fingers/" + action;
}
