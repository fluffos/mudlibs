// by borstquc
#include <ansi.h>
inherit ROOM;

void create() {
  string long;

  set("short", HIB "色彩染坊" NOR);

  long = "\n" +
    "    " + HIY "这里是马疑慈用来决定色彩的房间，既然你来了就看看吧!!\n\n\n" +
    NOR "普通色                  加 HI - 高亮度  加 B 背景       加 HB 高亮度背景\n
" + BLK " BLK - 黑色                       " + BBLK " BBLK - 黑色 \n" +
    RED " RED - 红色 " + HIR " HIR - 亮红色 " + BRED " BRED - 红色 " NOR + HBRED " HBRED - 亮红色
" NOR +
    GRN " GRN - 绿色 " + HIG " HIG - 亮绿色 " + BGRN " BGRN  - 绿色 " NOR + HBGRN " HBGRN  - 亮绿色 \n" NOR +
    YEL " YEL - 土黄色 " + HIY " HIY - 黄色 " + BYEL " BYEL - 土黄色 " NOR + HBYEL " HBYEL - 黄色 \n" NOR +
    BLU " BLU - 深蓝色 " + HIB " HIB - 蓝色 " + BBLU " BBLU - 深蓝色 " NOR + HBBLU " HBBLU - 蓝色 \n" NOR +
    MAG " MAG - 浅紫色 " + HIM " HIM - 粉红色 " + BMAG " BMAG - 浅紫色 " NOR + HBMAG " HBMAG - 粉红色 \n" NOR +
    CYN " CYN - 蓝绿色 " + HIC " HIC - 天青色 " + BCYN " BCYN - 蓝绿色 " NOR + HBCYN " HBCYN - 天青色 \n" NOR +
    WHT " WHT - 浅灰色 " + HIW " HIW - 白色 " + BWHT " BWHT- 浅灰色 " NOR + HBWHT " HBWHT - 白色 \n" NOR +
    "\n\n";

  set("long", long);
  set("light_up", 1);
  set("no_magic", 1);
  set("no_fight", 1);
  set("no_clean_up", 1);
  setup();
}
