#include <ansi.h>

inherit EQUIP;

void create() {
  set_name(HIC "Ｈ2Ｏ的连身洋装" NOR, ({ "hcloth", "cloth" }));

  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("meterial", "silk");
    set("unit", "件");
    set("value", 1000);
    set("armor_type", "cloth");
    set("armor_prop/armor", 100);
    set("armor_prop/dodge", 5);
    set("armor_prop/force", 3);
    set("long", "
这是一件Ｈ2Ｏ的连身洋装，虽然看来时分朴素，但却散发出另人心动的气质，穿上它之后
似忽能让妳更加迷人..\n");
  }
  setup();
}
