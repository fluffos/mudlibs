#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", CYN "幻水之径" NOR);
  set("long", @LONG
这条路是通往阿修罗城的道路, 你觉得像是走在水中, 却又不
是真的水.   这条通道是由幻力支撑而成, 连结了阿修罗城和
天界.   南方就是阿修罗城了, 但是只有阿修罗族才能进去, 
自从圣战一役后. 这个城市便陷入了沈睡.
LONG);

  set("exits", ([
    "up": __DIR__ "dm3",
  ]));
}
