//九曜举起手中的水晶杖, 喃喃念了几句你听不懂的咒语.
#include <ansi.h>
void do_special();
inherit NPC;

void create() {
  set_name("九曜", ({ "joey" }));
  //        set("race","神族");
  set("long",
    "前代的占星人九曜, 年纪约有数百岁了.   刚从善见城的水牢逃出来,
她在此守候老战友夜才王, 为了从前的一个约定.\n");
  set("nickname", "前代占星师");
  set("gender", "女性");
  set("age", 675);
  set("str", 30);
  set("con", 30);
  set("force", 600);
  set("max_force", 600);
  set("force_factor", 5);
  set_skill("unarmed", 70);
  set_skill("move", 60);
  set_skill("dodge", 65);
  set("attitude", "friendly");
  set("max_gin", 200);
  set("max_kee", 1000);
  set("max_sen", 100);
  set("limbs", ({ "头部", "手腕", "手臂", "右脚", "腰部" }));
  set("verbs", ({ "claw", "poke" }));
  set("chat_chance", 4);
  set("chat_msg", ({
    "九曜长长的叹了一口气。\n", })
  );
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: do_special :)
  }));
  set("combat_exp", 150000);
  setup();
  add_money("gold", 1);
}

void do_special() {
  object *enemy, target;
  int i;

  enemy = this_object()->query_enemy();
  i = sizeof(enemy);
  target = enemy[random(i)];

  message_vision(
    HIY "\n九曜举起手中的水晶杖, 喃喃念了几句你听不懂的咒语.\n" NOR, target);
  target->receive_wound("kee", 50 + random(100));
  COMBAT_D->report_status(target);

}
