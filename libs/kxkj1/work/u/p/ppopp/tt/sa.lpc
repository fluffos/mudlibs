// dusa.c by oda

#include "/open/open.h"
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("杜杀", ({ "du sa", "du", "sa" }));
  set("nickname", "血手");
  set("title", "恶人谷大头目");
  set("gender", "男性");
  set("age", 41);
  set("class", "bandit");
  set("guild_master", 1);
  set("attitude", "badman");
  set("combat_exp", 900000);
  set(
    "long",
    "这个人身子又瘦又长，一身雪白的长袍，他的脸就跟他的衣服一样苍白。\n仔细一看，你才发现他的左手已经断了，并且装上了一个锋利的钢钩。\n他就是恶人谷中最令人畏惧的十大恶人之首－「血手”杜杀。\n"
  );

  set("str", 40);
  set("cor", 40);
  set("int", 24);
  set("spi", 22);
  set("cps", 30);
  set("con", 30);
  set("per", 16);
  set("max_force", 1500);
  set("force", 1500);
  set("force_factor", 10);

  set_skill("array", 100);
  set_skill("blade", 90);
  set_skill("badblade", 100);
  set_skill("cure", 40);
  set_skill("dodge", 50);
  set_skill("ghost-steps", 60);
  set_skill("force", 60);
  set_skill("badforce", 70);
  set_skill("move", 50);
  set_skill("parry", 50);
  set_skill("sword", 75);
  set_skill("throwing", 60);
  set_skill("unarmed", 50);
  map_skill("blade", "badblade");
  map_skill("parry", "badblade");
  map_skill("force", "badforce");
  map_skill("dodge", "ghost-steps");
  map_skill("move", "ghost-steps");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
  }));

  setup();
  create_family("恶人谷", 1, "大头目");
  set("family/next_title", "小喽喽");
  add_money("gold", 10);
  carry_object(BAD_OBJ "hook")->wield();
}

void init() {
  add_action("do_join", "join");
}

int accept_fight(object who) {
  message_vision("杜杀冷冷的瞄了$N一眼。\n", who);
  command("say 哼，不自量力的家伙。\n");
  return 1;
}

void attempt_apprentice(object who) {
  if (!who->query("class")) {
    command("shake " + who->query("id"));
    command("say 等你加入(join)盗贼这一行再说吧。");
    return;
  }
  if (who->query("class") != "bandit") {
    command("stare " + who->query("id"));
    command("say 恶人谷是干强盗的，你们这些善良老百姓还是快滚吧！");
    return;
  }
  command("look " + who->query("id"));
  command("say 好！我就收你这个徒弟。");
  command("recruit " + who->query("id"));
  command("say 不过既然你加入了恶人谷，就永远别想脱离这里，否则....");
  command("hehe " + who->query("id"));
}

int do_join() {
  object who;
  who = this_player();

  if (who->query("class"))
    return notify_fail("你已经加入其他工会了。\n");
  who->set("class", "bandit");
  message(
    "system",
    HIW "杜杀仰天狂啸：咱们盗贼又多了一个极恶之徒－" HIR + who->query("name") + HIW "\n大家要小心啦！哈哈哈哈！\n" NOR,
    users()
  );

  return 1;
}
void die() {
  object weapon;
  weapon = present("hook", this_object());
  destruct(weapon);
  ::die();
}
