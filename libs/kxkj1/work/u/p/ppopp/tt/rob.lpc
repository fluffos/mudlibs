// 本装甲机兵是由拉姆科技研究所承制

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIW "装甲机兵「因格拉姆Ⅰ”控制器" NOR, ({ "1 comd",
    "comd" }));

  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "架");
    set("value", 9999);
    set("material", "crimsonsteel");
    set("armor_type", "cloth");
    set("armor_prop/armor", 30000);
    set("armor_prop/dodge", 30000);
    set("armor_prop/id", ({ "Ango Lumo", "lumo" }));
    set("armor_prop/name", ({ "因格拉姆" }));
    set("armor_prop/short", ({ "巨型装甲机兵「因格拉姆”(Ango Lumo)" }));
    set("armor_prop/long", ({
      "一台巨大的机器人，宛如一栋摩天大楼，伫立在你的前面，它全身装配最好的武器，是超
现代科技的的结晶。\ n " }));
  }
  set("wear_msg", @LONG
$N大叫:「机神合体”
忽然，从因格拉姆的体内射出一道光芒，将$N吸入它的机体内．．
LONG);
  set("remove_msg", "机动警察　绝赞发售中\n");
  setup();

}
