#include <ansi.h>
inherit NPC;

void create() {
  set_name("七彩凤凰", ({ "fon_huang bird", "bird" }));
  set("race", "野兽");
  set("age", 1000);
  set("long", "
这是一只十分美丽的千年七彩凤凰,她正专心地孵着蛋呢!!!\n");
  set("str", 250);
  set("cor", 70);
  set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: this_object(), "special_attack" :),
  }));

  set_temp("apply/attack", 3500);
  set_skill("dodge", 100);
  set_skill("unarmed", 100);
  set("combat_exp", 100000);
  set_temp("apply/armor", 4500);
  setup();
}
int special_attack() {
  object ob;
  ob = this_object()->query_enemy();
  message_vision(HIB "七彩凤凰 突然展开翅膀,冷不防一片羽毛向你心窝射去.\n" NOR, this_object());
  ob->add("kee", -50);
  return 1;
}
