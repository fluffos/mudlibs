#include <ansi.h>
inherit NPC;
void create() {
  set_name("小悟刀", ({ "win" }));
  set("long", "

月黑风高, 一声凄厉的狼号划破夜空. 破晓时分, 淡淡霜露, 一条枯瘦的人影
随着冥纸火光, 摇曳在湿冷小径. 朝阳露出署光, 射在沈沈金刀, 刀光闪耀在
冷酷的脸庞, 不见一丝笑容.
小悟刀, 一生爱刀, 用刀, 惜刀, 悟刀.
                                            悟～嘛!!!
小悟刀, 为悟刀而生, 为悟刀而活, 为悟刀而悟.
                                            悟～嘛!!!
小悟刀, 自幼父母双亡, 魔刀莫测收为义子. 但因其体内充满正气, 不适练魔
刀, 而转拜金刀门, 成为金刀无敌的私传弟子. 前一阵子, 魔刀莫测被独孤愁
所害, 愤而自创悟刀门, 立誓为义父报仇. 
");
  set("gender", "男性");
  set("combat_exp", 450000);
  set("age", 26);
  set("class", "blademan");
  set("title", "悟刀门门主");
  set("nickname", HIW "追风浪子" NOR);
  set("score", 1000);
  set("attitude", "heroism");
  set("max_kee", 500);
  set("max_gin", 200);
  set("max_sen", 200);
  set("force", 1150);
  set("max_force", 1150);
  set("force_factor", 10);
  set_skill("unarmed", 50);
  set_skill("blade", 95);
  set_skill("dodge", 60);
  set_skill("move", 40);
  set_skill("force", 70);
  set_skill("parry", 80);
  set_skill("literate", 55);
  set_skill("gold-blade", 70);
  map_skill("blade", "gold-blade");
  map_skill("parry", "gold-blade");
  set_skill("fly-steps", 75);
  map_skill("dodge", "fly-steps");
  map_skill("move", "fly-steps");
  set_skill("sixforce", 70);
  map_skill("force", "sixforce");
  set("str", 30);
  set("cor", 28);
  set("int", 35);
  set("cps", 20);
  set("con", 30);
  set("spi", 20);
  set("kar", 15);
  set("per", 32);
  set("chat_chance", 4);
  set("chat_msg", ({
    "小悟刀 朗声说道:‘悟～嘛!!!’\n",
    "小悟刀 凄然叹道:‘义父, 你在哪啊～’\n",
  }));
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: this_object(), "special_attack" :),
  }));
  set("inquiry", ([
    "义父": "就是轰动当年武林四大高手之一的 魔刀莫测啊!!! \n",
    "莫测": "当年一不小心中了独孤愁的诡计,而今～～下落不明!!! \n",
    "独孤愁": "这个面善心恶的伪君子,快告诉我他在哪,我要亲手杀了他!!! \n"
  ]));
  setup();
  create_family("悟刀门", 1, "门主");
  set("family/next_title", "门徒");
  add_money("gold", 10);
  carry_object("/open/gblade/obj/boots2.lpc")->wear();
  carry_object("/open/center/obj/belt1.lpc")->wear();
  carry_object("/u/p/ppopp/obj/cloak1.lpc")->wear();
  carry_object("/open/gsword/obj/robe_1.lpc")->wear();
  carry_object("/u/p/ppopp/obj/winblade.lpc")->wield();
}
int accept_kill(object me) {
  command("say 觉悟吧!!! 哼!!! 悟～嘛!!!");
  return 1;
}
int accept_fight(object me) {
  if ((int)me->query("combat_exp") <= 15000) {
    command("say 你还不配死在我的刀下,哼!!! 悟～嘛!!!");
    return 0;
  }
  command("say 觉悟吧!!! 哼!!! 悟～嘛!!!");
  return 1;
}
int special_attack() {
  object ob;
  ob = this_object()->query_enemy();
  message_vision(
    HIB "小悟刀 大喝一声使出绝招" HIR "□HIY" M □ HIW "瞍" HIG "C□HIM" □ HIB ",刀光剑气穿透了你的胸腔.\n" NOR,
    this_object()
  );
  ob->add("kee", -50);
  return 1;
}
