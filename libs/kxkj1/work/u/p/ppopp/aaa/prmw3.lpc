#include <ansi.h>
#include <room.h>
inherit ROOM;

int i = 0;
void create() {
  set("short", "中庭");
  set("long", @LONG

    沿着紫色茉莉走着, 看到一座圆形花圃, 花圃中间有个
小喷泉, 是个小 Baby 的样式, 好可爱喔!!! 西面是一片湖
, 湖中有座小亭子. 而左方是一座假山(stone),你的直觉告
诉你, 它背后好像有东西....

LONG);
  set("item_desc", ([ /* sizeof() == 2 */
    "stone": "
你偷偷地绕到假山后头,赫然发现假山后有个男人(man)鬼鬼祟祟地,
真想用脚去踹踹(kick)他. \n",
    "baby": "
这是一个小婴孩样式的小喷泉,看了真想去摸摸(touch)它. 你可别小
看它喔!!! 它可是负责这整个花圃浇水的工作喔!!! \n",
  ]));

  set("light_up", 1);
  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "prmw4",
    "south": __DIR__ "prmw2",
    "east": __DIR__ "prmw10",
  ]));
  set("outdoors", "/open/dancer");
  setup();
}

void init() {
  add_action("do_kick", "kick");
  add_action("do_touch", "touch");
}

int do_kick(string str) {
  object me;
  me = this_player();
  if (str != "man") return 0;
  if (i >= 1) {
    write(HIY "$N朝着那个鬼鬼祟祟的人,狠狠的踢了一脚!\n" NOR);
    message_vision(HIY "$N一脚踢了个空,一时失去重心,摔了个狗吃屎!!!\n" NOR, me);
    write(HIC "$N突然发现原来自己踢的只是假山的影子!\n" NOR);
  }
}
