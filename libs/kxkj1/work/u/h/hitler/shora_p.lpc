// sword.c : an example weapon
#include <weapon.h>
#include <ansi.h>

inherit UNARMED;

void create() {
  seteuid(getuid());
  set_name("修罗护手", ({ "shora hand plate", "plate" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "副");
    set("long", "这是一副充满邪气的黑色手甲, 上面铸有邪神的图案!\n");

    set("value", 10000);
    set("material", "steel");
    set("ski_level", 40);
    set("ski_type", "unarmed");
    set("wield_msg", "$N套上$n之后, 身旁笼罩诡异的气息!! \n");
    set("unwield_msg", "$N将$n脱去后, 那诡异之气渐渐散去  \n");
  }
  init_unarmed(80);

  setup();
}
