// wolf.c

inherit NPC;
void do_special();
void create() {
  set_name("渥夫", ({ "South Cross Star Knight Captain Wolf ", "knigt", "captain", "wolf" }));
  set("title", "南十字星骑士团亲卫队队长");
  set("nickname", "[1m苍狼[0m");
  set("gender", "男性");
  set("age", 29);
  set("attitude", "aggressive");
  set("long",
    "渥夫是日耳曼远征军南十字军骑士亲卫队队长，他那狼般锐利的眼神\n"
    "使你不由的恐惧起来!!\n");

  set("str", 45);
  set("cps", 30);
  set("per", 34);
  set("int", 30);
  set("kar", 32);
  set("con", 40);
  set("kee", 1100);
  set("combat_exp", 990000);


  set_skill("move", 70);
  set_skill("unarmed", 60);
  set_skill("parry", 130);
  set_skill("dodge", 100);
  set_skill("sword", 100);

  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: do_special :)
  }));

  set_temp("apply/armor", 400);
  set_temp("apply/attack", 160);

  setup();

  //      carry_object("
  //      carry_object("plumage")->wear();
  add_money("gold", 8);
}

void do_special() {
  object *enemy, target;
  int i;

  enemy = this_object()->query_enemy();
  i = sizeof(enemy);
  target = enemy[random(i)];

  message_vision(
    "\n渥夫持剑高喝  [1m ‘  狼  □  牙  ’ [0m  \n", target);
  message_vision(
    "\n渥夫身影宛如曙光初现般的冲出，忽然$n的身上出现两道伤痕，不断地喷出鲜红的血液来!!\n", target);
  target->receive_wound("kee", random(70 + 50));
  COMBAT_D->report_status(target);

}
