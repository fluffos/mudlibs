// hat.c

inherit EQUIP;

void create() {
  set_name("小帽", ({ "small hat", "hat" }));
  set_weight(700);
  set("long", "一顶很普通的帽子,上面还插着一根羽毛");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    set("value", 700);
    set("material", "cloth");
    set("armor_type", "head");
    set("armor_prop/armor", 1);
  }
}
