#include <ansi.h>
#include   "/open/open.h"

inherit ROOM;

void create() {
  set("short", HIR "听雨轩" NOR);
  set("long", @LONG
       千里高的瀑布倾泄而下,一点一滴的打在奇石上
       时而有如小雨绵绵,有时宛如大雨倾盆,令人心
       境随之千变万化,一阵阵的水雾飘在脸上,使人
       在暑意中倍感清凉痛快,这就是听雨轩盛名的由
       来。
[A.
LONG + NOR);

  set("exits", ([ /* sizeof == 5 */
    "west": "/u/h/hugh/workroom.lpc",
  ]));
  set("light_up", 1);
  setup();
}
