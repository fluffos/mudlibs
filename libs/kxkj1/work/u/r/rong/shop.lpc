//改用阵列的写法 , 及改正原本商店的缺点

#include <ansi.h>
#include <room.h>

inherit ROOM;
inherit CHINESE_D;
inherit F_FINANCE;
inherit F_MORE;

string *goods = ({});
string do_find_ob(string str, int index);

void create() {
  set("no_clean_up", 1);
}

void init() {
  add_action("do_sell", "sell");
  add_action("do_buy", "trade");
  add_action("do_list", "list");
  add_action("do_value", "value");
}

int do_value(string arg) {
  object *inv;
  if (arg)
    return 0;
  inv = all_inventory(this_player());
  if (!inv)
    return notify_fail("你身上没有任何东西可供估价。\n");
  printf(HIC "你身上带着这些东西：\n%s" NOR,
    implode(map_array(inv, "ob_value", this_object()), ""));
  return 1;
}

int do_sell(string arg) {
  object ob, me = this_player(), *inv;
  int valu, trade_lv, index = 1, i;
  trade_lv = me->query_skill("trade", 1);
  if (!arg)
    return notify_fail("你要卖什么东西？\n");

  if (arg == "all") {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++) {
      valu = inv[i]->query("value");
      if (valu && !inv[i]->query("no_drop") && !inv[i]->query_temp("secured") && !inv[i]->query("no_sell")) {
        if (!trade_lv)
          trade_lv = 1;
        valu = valu * 75 / 100 + valu * trade_lv / 400;
        me->pay_player(valu);
        message_vision(
          sprintf("$N卖掉一%s%s , 得到%s\n", inv[i]->query("unit"), inv[i]->query("name"), cvalue(valu)),
          me
        );
        if (trade_lv >= 1 || trade_lv < 100)
          me->improve_skill("trade", (random(me->query("int")) +
            random(me->query("per")) / 2));
        if (member_array(base_name(inv[i]), goods) == -1)
          goods += ({ base_name(inv[i]) });
        destruct(inv[i]);
      }
    }
  }

  else {

    if (sscanf(arg, "%s %d", arg, index) == 2)
      if (index < 1) index = 1;

    if (!(ob = present(arg + " " + index, me)))
      return notify_fail("要卖空？\n");
    valu = ob->query("value");
    if (ob->query("no_drop") || ob->query_temp("secured") || ob->query("no_sell"))
      return notify_fail("你不能卖这东西\n");
    if (!valu || valu <= 0) {
      printf("你卖掉没价值的东西, 店老板看了一眼就丢进垃圾桶了.\n");
      destruct(ob);
      return 1;
    }
    if (!trade_lv)
      trade_lv = 1;
    if (trade_lv >= 1 || trade_lv < 100)
      me->improve_skill("trade", (random(me->query("int")) +
        random(me->query("per")) / 2));
    valu = valu * 75 / 100 + valu * trade_lv / 400;
    printf("回收的中古货要打个折扣，\n你卖掉%s得到%s\n", ob->short(),
      cvalue(valu));
    me->pay_player(valu);
    message_vision(HIC "$N卖掉一" + ob->query("unit") + ob->query("name") + "\n" NOR,
      me);
    if (member_array(base_name(ob), goods) == -1)
      goods += ({ base_name(ob) });

    destruct(ob);
  }
  return 1;
}
int do_list(string arg) {
  string str = "";
  int i, valu;
  if (arg)
    return 0;
  str += sprintf("在这你可以买到：\n");
  for (i = 0; i < sizeof(goods); i++) {
    valu = goods[i]->query("value");
    str += sprintf("%-40s价格:%-20s\n", goods[i]->short(), cvalue(valu));
  }
  start_more(str);
  return 1;
}

int do_buy(string arg) {
  object ob, me = this_player();
  int trade_lv, v, i, n, afford, valu, index;
  string str;
  if (!trade_lv = me->query_skill("trade", 1))
    trade_lv = 1;
  if (!arg)
    return notify_fail("你要买什么东西？\n");
  if (!pointerp(goods) || (n = sizeof(goods)) == 0) return notify_fail("抱歉 , 没这种东西 ?\n");

  if ((sscanf(arg, "%s %d", str, index) != 2)) {
    str = arg;
    index = 1;
  }
  if (index < 1) index = 1;
  arg = do_find_ob(str, index);

  if (member_array(arg, goods) == -1)
    return notify_fail("抱歉, 没这东西\n");
  v = goods[i]->query("value");
  valu = v * 90 / 100 + v * (100 - trade_lv) / 100;
  if (me->can_afford(valu)) {
    me->pay_money(valu);
    n = me->query("int") - 10;
    if (me->query_skill("trade", 1) < 100)
      me->improve_skill("trade", 10 + random(n));

    ob = new(arg);
    ob->move(me);
    message_vision("$N花了" + cvalue(valu) +
      "买下了一" + ob->query("unit") + ob->short() + "\n",
      me);
    goods -= ({ base_name(ob) });
    return 1;
  } else
    return notify_fail("你的钱不够。\n");
}

string do_find_ob(string str, int index) {
  int count, i;
  for (i = 0, count = 0; i < sizeof(goods); i++) {
    if (goods[i]->id(str)) {
      count++;
      if (count == index)
        return goods[i];
    }
  }
  return "";
}
