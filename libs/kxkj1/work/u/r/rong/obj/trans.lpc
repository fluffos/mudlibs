// made by ccat
// Rong make a little change to be a wiztool
#include <ansi.h>
inherit ITEM;
inherit F_AUTOLOAD;

void create() {
  set_name("传送器", ({ "trans" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", @LONG
一个简单的巫师传送工具
1:京城 2:蜀中 3:平南 4:中央
5:凌云 6:枫林 

LONG
    );
    set("value", 1000000000000);
    set("no_drop", 1);
  }
}
void init() {
  add_action("do_waveto", "wa");
}

int do_waveto(string arg) {
  object me;
  me = this_player();
  switch (arg) {
    case "1":
      me->move("/open/capital/room/r70");
      break;
    case "2":
      me->move("/open/gsword/room/su3");
      break;
    case "3":
      me->move("/open/ping/room/road4");
      break;
    case "4":
      me->move("/open/center/room/inn");
      break;
    case "5":
      me->move("/open/start/room/s5");
      break;
    case "6":
      me->move("/open/port/room/r3-1");
      break;
  }
  return 1;
}

int query_autoload() {
  return 1;
}
