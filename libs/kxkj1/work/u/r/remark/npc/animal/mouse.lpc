#include "/open/open.h"
#include <ansi.h>
inherit NPC;

void create() {
  set_name(BLU "老鼠" NOR, ({ "mouse" }));
  set("gender", "雄性");
  set("age", 10);
  set("long", HIY "一只肥胖的老鼠,到处跑来跑去。\n" NOR);
  set("combat_exp", 1000);
  set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("attitude", "heroism");
  set_skill("unarmed", 12);
  set_skill("dodge", 12);
  set("chat_chance", 10);
  set("chat_msg", ({
    HIR "  ㄗ～～～ㄗ～～～ㄗ～～.\n" NOR,
    (: random_move :),
  }));

  setup();
  add_money("coin", 20);
}
