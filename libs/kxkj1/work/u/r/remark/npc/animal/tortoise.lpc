inherit NPC;
#include <ansi.h>
void create() {
  set_name(HIG "小乌龟" NOR, ({ "tortoise" }));
  set("race", "野兽");
  set("age", 3);
  set("long", "笨笨的小乌龟,正在到处乱爬\n");

  set("str", 14);
  set("cor", 16);

  set("limbs", ({ "头部", "身体", "前脚", "后脚", "龟壳" }));
  set("verbs", ({ "bite", "claw" }));

  set_temp("apply/attack", 5);
  set_temp("armor", 33);

  setup();
}
