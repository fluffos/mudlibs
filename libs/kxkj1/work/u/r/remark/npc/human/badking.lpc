#include "/open/open.h"
#include <ansi.h>
inherit NPC;
void create() {
  set_name("大魔王", ({ "badking", "king" }));
  set("nickname", "大魔王");
  set("title", "魔王 test 版");
  set("race", "人类");
  set("gender", "男性");
  set("age", 5135);
  set("long", "大魔王 test 版。\n");
  set("str", 30);
  set("cor", 30);
  set("max_kee", 400);
  set("max_force", 500);
  set("force", 500);
  set("force_factor", 5);
  set("combat_exp", 50000);
  set_skill("sword", 15);
  set_skill("parry", 40);
  set_skill("dodge", 30);
  set_skill("move", 30);

  setup();
  carry_object("/obj/weapon/can-sword.lpc")->wield();
}

int accept_fight(object who) {
  CHANNEL_D->do_channel(this_object(), "mud",
    HIY "\n新一代的人类勇者～～～" + who->query("name") + "～～～居然只敢跟我 fight
...笑死人了" NOR);
  return notify_fail("大魔王瞪你一眼说: 名闻遐迩的勇者胆量就只有这样嘛 ? \n");
  return 1;
}

int accept_kill(object who) {
  object me;
  me = this_object();
  if (me->is_fighting())
    return 1;
}

void die() {
  CHANNEL_D->do_channel(this_object(), "mud",
    HIR "\n巫师界恶魔堡一阵狂笑传出...
 哈～～～～哈 哈！
　　哈～～～～哈！
　　　　　果然是背负盛名的勇者,能够轻易的击败我
          不过黑暗是永远存在的,在不久的将来
          我以恶魔之名立下诅咒,世界必定沉沦于黑暗之中
           哈哈哈~~~~~~~~~~~~~~~~......." NOR);
  ::die();
}
