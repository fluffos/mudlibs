#include <ansi.h>
inherit PARTY_NPC;
void create() {
  set_name(HIY "冒险家" NOR, ({ "blade man", "hon" }));
  set("gender", "男性");
  set("age", 27);
  set("long",

    HIR "         刀下无情,杀愁杀恨杀幻,
            人却多心,有泪有梦有爱.\n" NOR);

  set("attitude", "heroism");
  set("combat_exp", 42000);

  set("str", 41);
  set("int", 23);
  set("cor", 32);
  set("cps", 43);
  set("con", 21);

  set("force", 700);
  set("force_factor", 5);
  set("max_force", 700);

  set("chat_chance_combat", 40);
  /*
	set("chat_msg_combat", ({
		(: exert_function, "powerup" :),
		(: exert_function, "recover" :),
	}) );
   */
  set_skill("force", 71);
  set_skill("unarmed", 23);
  set_skill("blade", 62);
  set_skill("parry", 61);
  set_skill("dodge", 56);
  set_skill("gold-blade", 64);
  set_skill("fly-steps", 70);
  set_skill("sixforce", 33);
  map_skill("force", "sixforce");
  map_skill("parry", "gold-blade");
  map_skill("blade", "gold-blade");
  map_skill("dodge", "fly-steps");
  map_skill("move", "fly-steps");
  setup();

  carry_object("/open/gblade/obj/gold-blade")->wield();
  add_money("gold", 1);
}
