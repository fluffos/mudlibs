inherit ITEM;

void create() {
  set_name("药丸", ({ "pill" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗气味芬芳的药丸。\n");
    set("value", 10000);
  }
}
void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  string kind;
  int max;
  object me, n_money;

  if (!arg || (arg != "pill"))
    return notify_fail("你要吃什么啊??\n");

  me = this_player();

  me->set("gender", "男性");
  me->clear_condition();
  me->set("name", "罗德");
  me->set("title", "拾荒客");
  me->set("race", "赛亚人");
  message_vision(sprintf("$N从瓶子里倒出一颗药丸吞了下去!\n"), this_player());
  return 1;
}
