#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create() {
  set_name(HIG "流星臂环" NOR, ({ "star armband", "armband" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是能增加速度的神秘臂环。\n");
    set("material", "blacksteel");
    set("value", 100000);
    set("armor_type", "armband");
    set("armor_prop/armor", 50);
    set("armor_prop/unarmed", 60);
    set("armor_prop/dodge", 70);
  }
  setup();
}
