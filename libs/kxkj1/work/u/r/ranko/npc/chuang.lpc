#include <ansi.h>

inherit NPC;
void create() {
  set_name("庄欣怡", ({ "sin-yi chuang", "chuang" }));
  set("nickname", HIC "芙蓉仙子" NOR);
  set("class", "poisoner");
  set("long", "
冥蛊魔教教主的掌上明珠，此女长的亭亭玉立，可谓人间绝色，一手冥蛇鞭
法及九天灵影步法可说是尽得真传，但生性不喜杀戮，一人独守空闺。\n");
  set("attitude", "heroism");
  set("age", 18);
  set("max_kee", 500);
  set("max_sen", 500);
  set("max_gin", 500);
  set("str", 27);
  set("con", 24);
  set("cps", 30);
  set("per", 30);
  set("int", 25);
  set("spi", 22);
  set("kar", 28);
  set_skill("whip", 50);
  set_skill("ming-snake", 50);
  set_skill("literate", 60);
  set_skill("dodge", 50);
  set_skill("nine-steps", 50);
  set_skill("unarmed", 40);
  set_skill("parry", 50);
  set_skill("force", 40);
  set_skill("poisonforce", 60);
  set_skill("poison", 50);
  set_skill("coldpoison", 50);
  map_skill("dodge", "nine-steps");
  map_skill("force", "poisonforce");
  map_skill("parry", "ming-snake");
  map_skill("whip", "ming-snake");
  map_skill("poison", "coldpoison");
  set("combat_exp", 200000);
  set("force_factor", 5);



  setup();
  create_family("冥蛊魔教", 3, "教主女儿");
  add_money("gold", 5);
  carry_object("/open/poison/obj/circle.lpc")->wear();
  carry_object("/open/poison/obj/godcloth.lpc")->wear();
  carry_object("/open/poison/obj/rope1.lpc")->wield();
  carry_object("/open/poison/obj/cape.lpc")->wear();
  carry_object("/open/poison/obj/feather.lpc")->wear();

}
