// Room: /u/p/poison/transfer.c
inherit ROOM;

void create() {
  set("short", "传送间");
  set("long", @LONG
这是一间什么都没有的房间。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "back": __DIR__ "workroom.lpc",
  ]));
  set("light_up", 1);

  setup();
}
void init() {
  add_action("do_waveto", "waveto");
}

int do_waveto(string arg) {
  int money, no_transmit;
  object me;
  string startroom;
  me = this_player();
  no_transmit = environment(me)->query("no_transmit", 1);
  if (no_transmit) {
    write("突然一阵能量从地底发出,击散了你招来的云朵,\n");
    write("似乎这里的大神不愿此地可以传送...\n");
    return 1;
  }
  money = me->query("bank/coin");
  if (money < 1000) {
    write("[1;31m 传送房得营幕上显示：老兄你不够钱啦！！□[0;37m\n");
    return 1;
  }
  message_vision("[1;34m[1;35m只见天上降下一只神兽把$N驮走了。[0m\n", me);
  switch (arg) {
    case "1":
      me->move("/open/capital/room/r70");
      break;
    case "2":
      me->move("/open/gsword/room/su3");
      break;
    case "3":
      me->move("/open/ping/room/road4");
      break;
    case "4":
      me->move("/open/center/room/inn");
      break;
    case "5":
      me->move("/open/start/room/s5");
      break;
    case "6":
      me->move("/open/port/room/r3-1");
      break;
    case "7":
      me->move("/open/gsword/room/g5-1.lpc");
      break;
      if (!startroom) {
        write(" 唤云扇说: 无此地点...\n");
        return 1;
      }
      me->move(startroom);
      break;
    default:
      write(" 唤云扇说: 无此地点...\n");
      return 1;
  }
  money = money - 1000;
  me->set("bank/coin", money);
  message_vision("[1;36m一阵呼啸后，神兽从天空慢慢的降了下来，$N从上面跳下。[0m\n", me);
  write(" [1;31m传送间传来一阵讯息：谢谢啦！下次在来！！[0m\n");
  return 1;
}
