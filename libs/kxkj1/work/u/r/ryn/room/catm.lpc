// mogi 之 mob <made by Ryn>

#include <ansi.h>

inherit NPC;

void create() {
  set_name("千眼妖", ({ "thousands-eyes ghost", "ghost" }));
  set("long", "\n它是魔界中常见的妖怪，不过不要看他外表弱小，" +
    "就轻视它，发起狠来，连神仙都怕它喔!\n");
  set("gender", "雄性");
  set("race", "野兽");
  set("nickname", "魔界恶妖");
  set("combat_exp", 200000);
  set("attitude", "killer");
  set("age", 1000);
  set("max_kee", 950);
  set_skill("move", 120);
  set_skill("dodge", 100);
  set_skill("parry", 90);
  set_skill("unarmed", 45);

  set_temp("apply/attack", -50);
  set_temp("apply/dodge", 150);

  set("limbs", ({ "头部", "眼睛", "胸部", "大黑手", "大黑脚", "背部", "腰部" }));
  set("verbs", ({ "bite", "claw" }));
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    HIW "\n千眼妖怪突然睁开了所有的眼睛,射出数道强光,\n" NOR +
    HIW "\n企图使你暂时失明!\n" NOR,
  }));

  setup();

}
