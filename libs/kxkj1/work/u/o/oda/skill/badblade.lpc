// badblade.c by oda

inherit SKILL;

mapping *action = ({
  ([
    "action": "$N面带微笑，背地里暗运内劲，一招‘笑里藏刀’忽地攻向$n下盘",
    "dodge": -20,
    "parry": -20,
    "damage": 25,
    "damage_type": "割伤"
  ]),
  ([
    "action": "$N抽身一跃，满天刀光砍向$n$l，迷惑敌人耳目，正是一招‘恶女迷魂’",
    "dodge": -30,
    "parry": 25,
    "damage": 40,
    "damage_type": "割伤"
  ]),
  ([
    "action": "$N不顾自己面门大开，一招‘损人害己’气运刀锋，扑身狂进，攻向$n$l",
    "dodge": -35,
    "parry": 15,
    "damage": 65,
    "damage_type": "割伤"
  ]),
  ([
    "action": "$N手腕一转，一招‘蚀骨蚀肉’的凌厉刀网直向$n全身削去",
    "dodge": -20,
    "parry": 25,
    "damage": 90,
    "damage_type": "割伤"
  ]),
  ([
    "action": "$N气运丹田，力贯刀锋，重心一沈朝$n当头砍下，正是霸气十足的‘恶人挡路’",
    "dodge": 30,
    "parry": -30,
    "damage": 160,
    "force": 160,
    "damage_type": "割伤"
  ]),
  ([
    "action": "$N身形一转使出‘恶鬼招魂’，霎时风声鹤唳，手中的$w从不可思议的方位窜出，直取$n首级",
    "dodge": -50,
    "parry": 15,
    "damage": 130,
    "force": 60,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N狂啸一声，手中$w有如疯狂般向$n$l狂砍而去，不留一线生机，好一招‘狂狮怒吼’",
    "dodge": -35,
    "parry": -35,
    "damage": 230,
    "force": 200,
    "damage_type": "割伤",
  ]),
  ([ "action": "$N脸色一沈，将全身杀气贯注于$w之上，使出杜杀绝学‘血手无情’",
    "dodge": 40,
    "parry": -50,
    "damage": 200,
    "force": 180,
    "damage_type": "割伤",
  ]),
});

int valid_learn(object me) {
  object ob = me->query_temp("weapon");
  int skill, bell;
  skill = me->query_skill("badblade", 1);
  bell = me->query("bellicosity");

  if (me->query_skill("bad-throwing"))
    return notify_fail("恶人谷的武功你只能学一种。\n");
  if (!ob || ob->query("skill_type") != "blade")
    return notify_fail("你手中没刀怎么练极恶刀法？\n");
  if (me->query_skill("blade", 1) < 10)
    return notify_fail("刀都还拿不稳就要练极恶刀法？先去练练基本刀法再来吧。\n");
  if ((skill < 50 && bell < (skill * 5)) || (skill >= 50 && bell < 250))
    return notify_fail("你的杀气不足，无法体会更高深的极恶刀法。\n");
  return 1;
}

int practice_skill(object me) {
  if (me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if (me->query("force") < 5)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -5);
  return 1;
}

int valid_enable(string usage) {
  return (usage == "blade" || usage == "parry");
}

mapping query_action(object me, object weapon) {
  int level, limit;
  level = (int)(me->query_skill("badblade", 1));
  limit = (int)(level / 10);
  if (limit < 2)
    return action[random(2)];
  if (limit < 4)
    return action[random(4)];
  if (limit < 5)
    return action[random(5)];
  if (limit < 6)
    return action[random(6)];
  if (limit < 7)
    return action[random(6) + 1];
  if (limit < 8)
    return action[random(6) + 2];
  if (limit < 9)
    return action[random(5) + 3];
  if (limit < 10)
    return action[random(4) + 4];
  else
    return action[random(4) + 4];
}
