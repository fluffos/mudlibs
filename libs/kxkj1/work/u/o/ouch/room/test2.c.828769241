int valid_leave(object me, string dir)
{
  this_player()->delete("move");
  return 1;

}

void init()
{
  int str;
  str = this_player()->query("str");
    this_player()->set("move", 1);
    if(str > 25)   call_out("tt",4);
    if(str > 20 && str < 25)    call_out("tt",6);
    if(str >15 && str < 20)    call_out("tt",8);
    else                       call_out("tt",10);
    add_action("stop_move", "stop");
}



  
 void tt()
{
 if(this_player()->query("move") == 1)
 {
 .




 this_player()->move("/u/o/ouch/room/test1.c");
 } }
int stop_move()
{
 if(this_player()->query("id") == "ouch")
{
message_vision(sprintf("大老粗运用神力停止(stop)了自己的传送\n"),this_player());
 this_player()->delete("move");
 return 1;
}
 else
{
 return notify_fail("你..你是啥小啊..你说停就停啊!!\n");
 return 0;
}
}
