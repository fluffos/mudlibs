#include <ansi.h>

inherit NPC;
inherit F_MASTER;
void create() {
  set_name("采花淫贼", ({ "sex bandit", "bandit" }));
  set("gender", "男性");
  set("combat_exp", 1000000);
  set("attitude", "heroism");
  set("age", 20);
  set("str", 38);
  set("cor", 30);
  set("cps", 25);
  set("per", 22);
  set_skill("blade", 100);
  set_skill("dodge", 30);
  set_skill("force", 32);
  set_skill("move", 32);
  set_skill("parry", 34);
  set_skill("sword", 30);
  set_skill("snowforce", 36);
  set_skill("unarmed", 35);
  set_skill("snow-martial", 40);
  set_skill("gold-blade", 100);
  map_skill("dodge", "snow-martial");
  map_skill("unarmed", "snow-martial);[D[D");
  map_skill("force", "snowforce");
  map_skill("blade", "gold-blade");
  map_skill("parry", "gold-blade");
  set("max_force", 2000);
  set("force", 2000);
  set("force_factor", 10);
  setup();
  carry_object("/u/o/ouch/weapon/tblade.lpc")->wield();
}

void init() {
  object me;
  me = this_player();
  if (me->query("gender") == "女性") {
    write("采花淫贼说道: 嘿嘿嘿!!来来来....小姑娘过来陪大爷玩玩....。\n");
  } else {
    write("采花淫贼看都不看你一眼便哼的一声，把头转过去了...。\n");
  }
}
