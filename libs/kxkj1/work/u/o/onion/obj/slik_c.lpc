#include <armor.h>

inherit CLOTH;

void create() {
  set_name("青丝长袍", ({ "slik cloth", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这件淡青色的丝衫上面绣着几种花纹，看起来别有一番风采。\n");
    set("unit", "件");
    set("value", 1000);
    set("material", "cloth");
    set("armor_prop/armor", 10);
  }
  setup();
}
