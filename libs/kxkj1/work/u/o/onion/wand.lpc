#include <combat.h>
inherit ITEM;
inherit F_CONDITION;
void create() {
  set_name("神仙杖", ({ "god wand", "wand" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是神仙专用的魔杖, 可做任何事情。");
    set("value", 1);
  }
  setup();
}
void init() {
  add_action("do_wave", "wave");
}

