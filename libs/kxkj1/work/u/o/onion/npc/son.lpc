inherit NPC;

void create() {
  set_name("赵晓龙", ({ "long-sau", "sau", "long" }));
  set("race", "人类");
  set("age", 22);
  set("gender", "男性");
  set("long",
    "赵晓龙是赵鼎天最唯一的儿子,自小便对武学有浓厚的兴趣与天份,在乃父的调教之下,\n" +
    "已得其真传,真正的实力不下于照鼎天,赵晓龙不仅仅在武学上浸淫,对于其他琴棋书画,\n" +
    "医卜星相等,也颇有涉猎,为近年来武林中一位相当有名的青年侠少.\n"
  );
  set("inquiry", ([
    "name": "我乃赵鼎天的儿子,赵晓龙.",
    "打猎": "喔..那次打猎发生了一件奇怪的事,就是舍妹在途中忽然失踪了,\n" +
    "		但舍妹对发生何事却毫无记忆,这件事也就不了了之了..",
  ]));
  set_temp("apply/attack", 10);
  set_temp("apply/armor", 40000);
  set("max_kee", 800);
  set("combat_exp", 3000);
  set("score", 1000);
  set("attitude", "heroism");
  set("max_force", 300);
  set("force", 300);
  set("force_factor", 5);
  set("max_mana", 100);
  set("mana", 100);
  set("mana_factor", 5);
  set_skill("spells", 20);
  set_skill("necromancy", 10);
  map_skill("spells", "necromancy");
  set_skill("unarmed", 20);
  //      set_skill("face",20);
  set_skill("poison", 20);
  set_skill("cure", 20);
  set_skill("force", 20);
  set_skill("whip", 40);
  set_skill("dodge", 60);
  set_skill("parry", 50);
  set_skill("literate", 20);
  //	set_skill("fon-man-whip",30);
  //	map_skill("whip","fon-man-whip");
  //	map_skill("parry","fon-man-whip");

  set("chat_chance_combat", 5);
  set("chat_msg_combat", ({
    (: cast_spell, "drainerbolt" :),
    (: cast_spell, "netherbolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "invocation" :),
  }));

  setup();
  add_money("silver", 30);
  carry_object("/u/o/onion/obj/whip.lpc")->wield();
}

int receive_damage(string type, int pts) {
  int damage;
  object who;
  damage = ::receive_damage(type, pts);
  if (is_killing()) {
    if (((int)query("max_kee") > (int)query("kee") * 3) &&
      (int)this_object()->query_temp("call_guard") != 1) {
      this_object()->set_temp("call_guard", 1);
      say("[1;33m赵晓龙沉声道：这可是你逼我的!!出来吧!!\n" +
        "赵晓龙低啸一声,叫出了他的保镖...\n[0m");
      message_vision(sprintf("[1;32m忽然间，你听到一声「着”，" +
        "$N身后突然一股大力涌来，拳风凛凛。[0m\n"), this_player());
      who = new("/u/o/onion/npc/guard");
      who->move(environment(this_object()));
      who->invocation(this_object());
    }
  }
  return damage;
}
int accept_fight(object me) {
  if (is_fighting()) {
    if ((int)this_object()->query_temp("call_guard") == 0) {
      say("[1;36m赵晓龙微一转身说道：在下虽在江湖小有名气,却也不敢托大," +
        "待我了完这里的事后,\n再向" + RANK_D->query_respect(me) + "讨教。[0m\n");
      return 0;
    } else {
      say("[1;33m赵晓龙喝道：大伙儿一起上啊,莫损了武威镖局的威名。[0m\n");
      return 1;
    }
  } else {
    say("[1;36m赵晓龙微微一笑道：有遣了," + RANK_D->query_respect(me) + "," +
      RANK_D->query_self(me) + "这就出招啦。[0m\n");
    return 1;
  }
}
