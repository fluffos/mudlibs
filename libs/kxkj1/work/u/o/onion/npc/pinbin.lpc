inherit NPC;

void create() {
  set_name("洋葱小窝扫地工--小彬彬", ({ "noname" }));
  set("race", "人类");
  set("age", 20);
  set("long", "
    小彬彬是[Onion]从垃圾堆里捡回来的小孩,长的其貌不扬,也难怪
会被丢弃,小彬彬为了感谢[Onion]的救命之恩,便留在恩公的身边服侍他.\n"
  );
  set("chat_chance", 5);
  set("chat_msg", ({
    "小彬彬说: 麻烦您高抬贵脚,我要扫一扫这里。\n",
    "小彬彬露出感激的表情说: 我一辈子也不会忘了[Onion]的救命之恩的。\n",
    "小彬彬 用小小的舌头舔你的脚。\n",
    (: random_move :)
  }));

  set("attitude", "peaceful");
  set_temp("apply/attack", 2500);
  set("combat_exp", 200000);
  setup();
}
return_home() {
  return 1;
}

int accept_object(object me, object obj) {
  command("smile");
  command("say 多谢这位" + RANK_D->query_respect(me) + "！");
  return 1;
}
