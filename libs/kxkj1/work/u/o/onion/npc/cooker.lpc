inherit NPC;
int enable_blade();
void create() {
  set_name("大厨师", ({ "cooker" }));
  set("race", "人类");
  set("age", 45);
  set("long",
    "大厨师年轻时原本是皇宫的御用厨师,所作的菜色可谓天南地北,无所不通,\n" +
    "但不知为何,他后来溜出宫中,云游四方,后来才被武威镳局瓢把子 赵鼎天\n" +
    "给请了回来.\n"
  );
  set("int", 22);

  set("attitude", "heroism");
  set("max_force", 500);
  set("force", 500);
  set("force_factor", 4);
  set_skill("dodge", 50);
  set_skill("blade", 50);
  set_skill("parry", 50);
  //        set_skill("anru-blade",40);
  //        set_skill("crazy-blade",40);
  set_skill("spring-blade", 40);
  //        set_skill("dragon-blade",40);
  map_skill("blade", "spring-blade");
  set_temp("enable_blade", "spring-blade");

  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({ (: this_object(), "enable_blade" :) }));
  set("inquiry", ([
    "name": "在下姓蔡,单名为王,只会做做几样小菜而已...",
    "here": "这儿是厨房啊..难道你看不出来吗?"
  ]));

  set("chat_chance", 5);
  set("chat_msg", ({
    "大厨师转头对你说 : 放在桌上的菜待会要拿出去,你可别偷吃ㄚ。\n",
    "大厨师偷偷的对你说 : 告诉你一个秘密,走道上的花瓶是大管家最心爱的东西...\n",
  }));

  set("attitude", "friendly");
  set_temp("apply/attack", 10);
  set("combat_exp", 700);
  setup();
  add_money("silver", 50);
  carry_object("/u/o/onion/obj/cutblade.lpc")->wield();

}
