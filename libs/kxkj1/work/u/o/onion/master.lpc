//master of cure

inherit NPC;
inherit F_MASTER;
int time = 0;

void create() {
  set_name("扁鸠", ({ "Master Ben", "master", "ben" }));
  set("long",
    "扁鹊的第四代子孙，继承先组的遗志，广传医学，\n
	别看他个头小小的，被他扎上一针可就有你受的。\n");
  set("nickname", "药到病除");
  set("gender", "男性");

  set("class", "doctor");
  create_family("银针门", 3, "门主");
  set("guild_master", 1);

  set_skill("unarmed", 60);
  set_skill("parry", 40);
  set_skill("dodge", 60);
  set_skill("force", 70);
  set_skill("literate", 60);
  set_skill("cure", 100);
  set_skill("dagger", 70);
  set_skill("move", 40);
  set_skill("poison", 70);
  set_skill("throwing", 90);

  set("inquiry", ([
    "扁鹊": "此人乃在下之先祖，为造福世人，穷尽\n
	毕生精力研究医学，也是本门之开山始祖。\n",
    "name": "在下乃是扁鹊的第四代子孙，也是目前\n
	银针门门主。\n",
  ]));

  setup();
}

void init() {
  add_action("do_join", "join");
  set_heart_beat(1);
}
void heart_beat() {
  object pill;
  object *inv;
  int i;
  inv = all_inventory(this_object());
  if (sizeof(inv))
    for (i = 0; i < sizeof(inv); i++)
      if (inv[i]->query("money_id"))
        destruct(inv[i]);
  if (time++ > 10) {
    pill = new(CLASS_D("doctor/medicine/curesick"));
    pill->set("value", 50000);
    pill->set("medicine_power", 200);
    pill->move(this_object());
    command("auc pill");
    time = 0;
  }
}

int do_join(string str) {
  object me = this_player();
  if (str != 0)
    return notify_fail("请打\"join\"即可。\n");
  if (me->query("class") == "doctor")
    return notify_fail("你不要开玩笑了，你不是早就加入了吗？\n");
  if (me->query("class"))
    return notify_fail("你已经加入了别的工会了\n");
  me->set("class", "doctor");
  /*
	printf("%s给%s一组针灸用的银针。\n",
	this_object()->name(),me->name());
*/
  tell_object(me, "恭禧你！你已经成为医者的一员了。\n");
  return 1;
}
