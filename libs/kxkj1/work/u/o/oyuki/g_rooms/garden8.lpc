// Room: /u/n/nako/g_rooms/garden8
inherit ROOM;

void create() {
  set("short", "小凉亭");
  set("long", @LONG
凉亭坐落于庭园一隅, 被大树枝叶所密覆着。整做亭子是由湖南运来的湘君竹所
建造而成, 别有一种朴实之意境, 休憩于亭下, 饮着怡红院特制的香茶, 美女随侍于
侧, 真是人间天堂!西方有一丛垂柳, 在柳枝飘摇间你似乎见到什么...
LONG);

  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "garden7",
    "east": __DIR__ "garden4",
  ]));
  set("outdoors", "/u/n");

  setup();
}
void init() {
  add_action("do_search", "search");
}

int do_search(string arg) {
  object me = this_player();
  write("你发现西边的柳树林中似乎有条小路, 便走了过去。\n");
  me->move(__DIR__ "way4");
  return 1;
}
