// guild_d.c written by fund


#define DICTIONARY DATA_DIR + "guild"

inherit F_SAVE;

mapping dict = ([]);

void add_translate(string pick_class, string key, string chinz);
void remove_translate(string pick_class, string key);

void create() {
  seteuid(geteuid());
  restore();
}

// void remove() { save(); }


string query_save_file() { return DICTIONARY; }

// This is called by to_chinese() simul_efun

void remove_translate(string pick_class, string key) {
  mapping temp = dict[pick_class ];
  map_delete(temp, key);
  dict[pick_class ] = temp;
  save();

}
void remove_class(string pick_class) {
  map_delete(dict, pick_class);
  save();
}

void add_translate(string pick_class, string key, string chinz) {
  mapping temp = ([]);
  if (dict[pick_class ]) temp = dict[pick_class ];
  temp[key] = chinz;
  dict[pick_class ] = temp;

  save();
}

mapping query_translate() {
  if (!undefinedp(dict)) return dict;
  else return ([]);
}
