inherit ROOM;

void init() {
  add_action("do_buy", "buy");
  add_action("do_sell", "sell");
  add_action("do_list", "list");
}

int do_buy(string arg) {
  if (!arg || !query("goods/" + arg))
    return notify_fail("No this goods\n");
  return 1;
}

int do_sell(string arg) {
  object ob;
  if (!arg) return notify_fail("what do you want to sell ?\n");
  if (!(ob = present(arg, this_player())))
    return notify_fail("you don't have this goods\n");
  return 1;
}

int do_list() {
  string *name = keys(query("goods"));
  int i;
  for (i = 0; i < sizeof(name); i++)
    write(sprintf("%-20s%10d\n", name[i],
      query("goods/" + name[i])->query("value")));
  return 1;
}
