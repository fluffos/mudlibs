#include <ansi.h>
#include "/daemon/sec_kee/spe.lpc"
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object obj, old_target;
  if (!me->query("sec_kee"))
    return notify_fail("你的身上没有灵气。\n");
  switch (me->query("sec_kee")) {
    case 1: dragon_spe(me);
    break;
    break;
  }

  return 1;
}
