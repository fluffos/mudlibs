#include <ansi.h>

inherit ROOM;

mapping attr = ([
  "str": "力量",
  "cor": "勇气",
  "int": "智慧",
  "spi": "超能",
  "cps": "定性",
  "dex": "速度",
  "con": "体质",
  "kar": "运气"
]);

int do_attrup(string);
int do_levelup();
void init() {
  add_action("do_join", "join");
  add_action("do_advance", "advance");
  add_action("do_skillup", "train");
  add_action("do_list", "list");
  add_action("do_cost", "cost");
}
string query_guild_data(string key) {
  string class_file;
  mapping data;
  class_file = "/daemon/class/" + query("guild_class") + "/class.lpc";
  data = class_file->query_data();
  return data[key];
}
int do_join() {
  object me = this_player();
  string class_file;
  if (me->query("class"))
    return notify_fail("你已经加入某个工会了。\n");
  class_file = "/daemon/class/" + query("guild_class") + "/class.lpc";
  if (file_size(class_file) < 0)
    if (file_size(class_file) < 0 || !ALLOW_D->is_allowed_guild(query_guild_
      data("guild_name")))
      return notify_fail("这个工会尚未合法。\n");
  if (!class_file->valid_join(me))
    return notify_fail("你无法加入这个工会。\n");
  message_vision("$N加入了" + query_guild_data("guild_name") +
    "成为一名" + query_guild_data("class_name") + "。\n", me);
  me->set("guild/guild_name", query_guild_data("guild_name"));
  me->set("class", query("guild_class"));
  me->set("title", query_guild_data("class_name"));

  me->set("title", query_guild_data("class_name"));
  class_file->join(me);
  return 1;
}
int do_advance(string arg) {
  object me = this_player();
  int exp_needed;
  int level;
  string class_file;
  if (attr[arg] || arg == "level") {
    if (me->query("class") != query("guild_class"))
      return notify_fail("你不是这个工会的人。\n");
    class_file = "/daemon/class/" + query("guild_class") + "/class.lpc";
    if (file_size(class_file) < 0)
      return notify_fail("这个工会尚未合法。\n");
  }
  if (attr[arg]) {
    if (me->query(arg) >= me->query("max_" + arg))
      return notify_fail("你的" + attr[arg] + "已经达到上限，无法再提升。\
n");
    if (me->query("level") * 5 < me->query(arg))
      return notify_fail("你的等级不够，无法再提升属性。\n");
    level = me->query(arg) + 1;
    exp_needed = level * level * level / 10;
    if (me->query("combat_exp") < exp_needed)
      return notify_fail("你的经验值不够。\n");
    me->add(arg, 1);
    me->add("combat_exp", -exp_needed);
    class_file->attrup(me);
    tell_object(me, HIY "你的" + attr[arg] + "提升了。\n" NOR);
    return 1;
  }
  if (arg == "level") {
    level = me->query("level") + 1;
    exp_needed = level * level * level;
    if (me->query("combat_exp") < exp_needed)
      return notify_fail("你的经验值不够，无法提升等级。\n");
    me->add("level", 1);
    me->add("combat_exp", -exp_needed);
    class_file->levelup(me);
    tell_object(me, HIW "你的等级提升了。\n" NOR);
    return 1;
  }
  return notify_fail("指令格式 : advance [ level | 属性 ]\n");
}
int do_skillup(string arg) {
  object me = this_player();
  mapping guild_skills;
  string class_file;
  int money_needed;
  int level;
  if (me->query("class") != query("guild_class"))
    return notify_fail("你不是这个工会的人。\n");
  if (!arg)
    return notify_fail("指令格式 : train [skill] \n");
  class_file = "/daemon/class/" + query("guild_class") + "/class.lpc";
  if (file_size(class_file) < 0)
    return notify_fail("这个工会尚未合法。\n");
  guild_skills = class_file->query_guild_skills();
  if (file_size(SKILL_D(arg) + ".lpc") < 0 || !guild_skills[arg])
    return notify_fail("没有这样技能。\n");
  if (me->query_skill(arg, 1) > me->query("level") * 5)
    return notify_fail("你的等级不够，无法提升技能。\n");
  if (me->query_skill(arg, 1) >= guild_skills[arg])
    return notify_fail("你的这样技能已经达到上限。\n");
  level = me->query_skill(arg, 1) + 1;
  money_needed = level * level * level * SKILL_D(arg)->cost_level() / 20;
  money_needed = money_needed * 3;
  if (me->query("money") < money_needed)
    return notify_fail("你的钱不够，不能提升技能。\n");
  me->set_skill(arg, me->query_skill(arg, 1) + 1);
  me->add("money", -money_needed);
  tell_object(me, HIY "你的" + to_chinese(arg) + "等级提升了。\n" NOR);
  return 1;
}
int do_list() {
  object me = this_player();
  string class_file, *name;
  int i;
  mapping guild_skills;
  if (me->query("class") != query("guild_class"))
    return notify_fail("你不是这个工会的人。\n");
  class_file = "/daemon/class/" + query("guild_class") + "/class.lpc";
  if (file_size(class_file) < 0)
    return notify_fail("这个工会尚未合法。\n");
  guild_skills = class_file->query_guild_skills();
  name = keys(guild_skills);
  write("这个工会的技能有：\n");
  for (i = 0; i < sizeof(name); i++)
    write(sprintf("  %-40s - 最高等级 - %d\n", to_chinese(name[i]) + "(
" + name[i] + ")", guild_skills[name[i]]));
  return 1;
}

int do_cost() {
  object me = this_player();
  mapping guild_skills;
  int i;
  string class_file;
  string *attr_keys = keys(attr), *name;
  int levelup_exp, attrup_exp, skillup_money, level, attr_p;
  class_file = "/daemon/class/" + query("guild_class") + "/class.lpc";
  if (file_size(class_file) < 0)
    return notify_fail("这个工会尚未合法。\n");
  level = me->query("level") + 1;
  levelup_exp = level * level * level;
  write(sprintf(HIC "□ " CYN "提升等级需花费 %d 的经验值。\n\n" NOR, levelup
    _exp));
  write(HIC "□ " CYN "提升属性需花费的经验值：\n\n" NOR);
  for (i = 0; i < sizeof(attr_keys); i++) {
    attr_p = me->query(attr_keys[i]) + 1;
    attrup_exp = attr_p * attr_p * attr_p / 10;
    write(sprintf("   %-20s  :%d\n", attr[attr_keys[i]] + "(" + attr_keys
      [i] + ")", attrup_exp));
  }
  guild_skills = class_file->query_guild_skills();
  name = keys(guild_skills);
  write(HIC "\n□ " CYN "提升技能需花费的钱：\n\n" NOR);
  for (i = 0; i < sizeof(name); i++) {
    level = me->query_skill(name[i], 1) + 1;
    skillup_money = level * level * level * SKILL_D(name[i])->cost_l evel() / 20;
    skillup_money = skillup_money * 3;
    write(sprintf("   %-40s  :%d\n", to_chinese(name[i]) + "(" + name[i] +
      ")", skillup_money));
  }
  return 1;
}
