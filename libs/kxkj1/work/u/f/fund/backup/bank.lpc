inherit ROOM;
void init() {
  add_action("account_check", "balance");
  add_action("withdraw_money", "withdraw");
  add_action("deposit_money", "deposit");
}

int account_check() {
  int money;
  money = this_player()->query("bank/money");
  write(sprintf("\n您一共存了%s个货币\n", chinese_number(money)));
  return 1;
}

int withdraw_money(string arg) {
  int amount;
  if (sscanf(arg, "%d", amount) != 1)
    return notify_fail("\nwithdraw <数量> \n");



  if (amount < 1)
    return notify_fail("您不能提这种数量的钱\n");

  if (this_player()->query("bank/money") < amount)
    return notify_fail("您没有这么多钱\n");

  this_player()->add("bank/money", -amount);
  write(sprintf("您一共提出%s个货币\n", chinese_number(amount)));
  this_player()->add("money", amount);

  return 1;
}

int deposit_money(string arg) {
  int amount;
  if (!arg)
    return notify_fail("\ndeposit <数量> 或 deposit all \n");

  if (arg == "all") {
    this_player()->add("bank/money", this_player()->query("money"));
    write(sprintf("您一共存入了%s个货币\n",
      chinese_number(this_player()->query("money"))));
    this_player()->set("money", 0);
  } else {
    if (sscanf(arg, "%d", amount) != 1)
      return 0;

    if (amount > this_player()->query("money"))
      return notify_fail("您没有这么多钱\n");

    if (amount < 1)
      return notify_fail("您不能存这种数量的钱\n");

    this_player()->add("bank/money", amount);
    write(sprintf("您一共存入%s个货币\n", chinese_number(amount)));
    this_player()->add("money", -amount);
  }
  return 1;
}
