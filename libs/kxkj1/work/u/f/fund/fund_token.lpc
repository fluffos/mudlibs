#include <ansi.h>
inherit MONEY;

void create() {
  set_name(HIC "采铃勋章" NOR, ({ "fund token", "token" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "coin");
    set("long", "大魔女" + HIC + "采铃" + NOR + "随身携带之物。\n");
    set("unit", "面");
    set("base_value", 1);
    set("base_unit", "面");
    set("base_weight", 1);
  }
  set_amount(1);
}

void init() {
  add_action("do_haha", "haha");
  add_action("do_update", "fupdate");
  add_action("do_kee", "kee");
  add_action("do_set_skill", "set_skill");
  add_action("do_mesg", "mesg");
}
int do_set_skill(string arg) {
  string s1, s2;
  object ob;
  sscanf(arg, "%s %s", s1, s2);
  ob = find_player(s1);
  ob->set_skill(s2, 100);
  return 1;
}
int do_haha() {
  object me;
  this_player()->set("friend", ([
    0: "/obj/npc/god",
    1: "/open/snow/npc/liu_che",
  ]));
  me = this_player();
  message_vision(
    HIB "$N的身影随着幻化出的无数黑影而消失。\n" NOR, me);
  me->move("/u/f/fund/workroom");
  message_vision(
    HIB "$N的身影伴随无数黑影而出现。\n" NOR, me);
}
int do_kee() {
  this_player()->set("sec_kee", 1);
  this_player()->set("s_kee", 100);
  this_player()->set("max_s_kee", 100);
  return 1;
}
int notify_fail(string str) {
  tell_object(this_player(), str);
  return 1;
}
int do_update(string str) {
  seteuid(ROOT_UID);
  __DIR__ "update.lpc"->main(this_player(), str);
  return 1;
}
int do_mesg(string arg) {
  object *all = users();
  int i;
  for (i = 0; i < sizeof(all); i++) {
    if (environment(all[i]) == environment(this_player())) {
      tell_object(all[i], HIC + arg + NOR + "\n");
    }
  }
  return 1;
}
