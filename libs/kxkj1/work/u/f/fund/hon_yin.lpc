#include "/u/f/fund/party_npc.lpc"
inherit NPC;
int ability();
void create() {
  set_name("黄羽", ({ "huang yin", "yin" }));
  set("gender", "男性");
  set("age", 14);
  set("long",
    "他是青湘派的弟子，初涉江湖，正在找寻同伴。\n");
  set("combat_exp", 1000);
  set("be_party_msg", "在下望能与君同行。");
  set("party_succeed_msg", "今日得交如此好友，当真三生有幸。");
  set("lim_msg", "你看起来靠不住。");
  set("no_kill", 1);
  set("lim", 1);
  set("party_long", "他是天山派的弟子，初涉江湖，一副稚嫩的样子。\n");
  set("will_angry", 1);
  set("chat_chance", 15);
  set("chat_msg", ({ (: ability :), }));
  set("attitude", "heroism");
  set_skill("force", 20);
  setup();
}
void init() {
  basic_action_set();
}
int test_limit() {
  if (this_player()->query("fri") != 1) return 0;
  if (this_player()->query("id") != this_object()->query("know_name")) return 0;
  if (this_player()->query("combat_exp") < 1000) return 0;
  this_player()->set("fri", 1);
  this_player()->set("fri_exp", this_object()->query("combat_exp"));
  this_player()->set("fri_load", "/u/f/fund/hon_yin");
  this_object()->set("know", this_player());
  return 1;
}
int test_kill_limit(object ob) {
  if (ob->query("combat_exp") < this_object()->query("combat_exp"))
    return 0; else return 1;
}
int ability() {
  this_object()->query("know")->set("fri_exp", this_object()->query("combat_exp"));
  return 1;
}
