// shade-steps.c

inherit SKILL;

string *dodge_msg = ({
  "$n的纤腰微微一顿，一个翻转，躲开了$N这一招。\n",
  "$n双脚连踏，一式「情何以惑”轻巧的脱离$N的攻击范围。\n",
  "$n身形旋绕，轻巧的一招「情海如天”，数个转身，将$N的攻势化于无形。\n",
  "$n快步移位，身法忽快忽慢，变幻莫测，使$N的攻击失效。\n",
});

int valid_enable(string usage) {
  return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) {

  if (me->query("gender") != "女性")
    return notify_fail("这是女孩子练的轻功\，男生练不来的。\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if (me->query("kee") < 30)
    return notify_fail("你的气不够，没办法练倩影追情身法。\n");
  me->receive_damage("kee", 30);
  return 1;
}
