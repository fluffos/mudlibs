mapping officer_lv = ([
  "太师": 100,
  "相国": 80,
  "尚书": 75,
  "御史": 70,
  "侍郎": 60,
  "太卫": 50,
  "大夫": 40,
  "长史": 30,
  "舍人": 20,
  "司马": 10,
  "知县": 5,
]);


int query_officer_lv(object me) {
  return officer_lv[me->query("officer_class")];
}
int set_officer_lv(object me) {
  string *name;
  int i;
  name = keys(officer_lv);
  for (i = 0; i < sizeof(officer_lv) - 1; i++)
    if (me->query("max_officer_power") >= officer_lv[name[i]] &&
      me->query("max_officer_power") < officer_lv[name[i + 1]])
      me->set("officer_class", name[i]);
}
