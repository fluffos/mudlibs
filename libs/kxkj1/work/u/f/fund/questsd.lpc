// questsd.c

#include <localtime.h>

#define DICTIONARY DATA_DIR + "quests"

inherit F_SAVE;



mapping dict = ([]);

void add_translate(string key, string chinz);
void remove_translate(string key);

void create() {
  seteuid(getuid());
  restore();
}

void remove() { save(); }


string query_save_file() { return DICTIONARY; }

string chinese(string str) {
  if (!undefinedp(dict[str])) return dict[str];
  else return str;
}

void remove_translate(int key) {
  map_delete(dict, key);
  save();
}

void add_translate(string key, string chinz) {
  dict[key] = chinz;
  save();
}

void dump_translate() {
  string *k, str;
  int i;

  str = "";
  k = keys(dict);
  for (i = 0; i < sizeof(k); i++)
    str += sprintf("%-30s %s\n", k[i], dict[k[i]]);
  write_file("/CHINESE_DUMP", str);
}


mapping query_translate(int key) {
  if (!undefinedp(dict[key])) return dict[key];
  else return ([]);
}
mapping query_data() {
  if (!undefinedp(dict)) return dict;
  else return ([]);
}
