#include <room.h>

inherit ROOM;

void create() {
  set("short", "洞穴");
  set("long", @LONG
这里是洞穴的内部，在西面的石壁(wall)
上似乎勉强可以看到几个字：
 
    「仙剑无极，魔刀莫测”
 
                  独孤愁
 
LONG);
  set("exits", ([
    "north": "/u/f/fund/room/hole3",
    "south": "/u/f/fund/room/hole",
  ]));
  setup();
}
void init() {
  add_action("do_look", "l");
  add_action("do_look", "look");
  add_action("do_key", "push");
}
int do_look(string str) {
  if (str != "wall") return 0;
  tell_object(this_player(), "你发现墙上有一个暗门(key)。\n");
  return 1;
}
int do_key(string str) {
  if (str != "key") return 0;
  tell_object(this_player(), "结果「喀”的一声，你推动了石壁。\n");
  tell_object(this_player(), "你进入了密室。\n");
  this_player()->move("/u/f/fund/room/secret");
  return 1;
}
