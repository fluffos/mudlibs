#include <room.h>

inherit ROOM;

void create() {
  set("short", "紫云宝殿");
  set("valid_startroom", 1);
  set("long", "这里是雪苍派的圣地‘紫云宝殿’，宝殿里装饰者无数的珍宝，显得华丽非凡，是雪苍派弟子聚会时，或有贵客来临时候的一个重要场所。\n");
  set("exits", ([
    "down": "/u/f/fund/room/room3",
    "south": "/u/f/fund/room/room5_out",
    "north": "/u/f/fund/room/room6",
  ]));
  set("objects", ([ __DIR__ "npc/liu_che": 1, ]));
  setup();
}
