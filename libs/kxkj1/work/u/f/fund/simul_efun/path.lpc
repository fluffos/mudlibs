#include <login.h>
mapping path = ([
  "/u/f/fund": 1,
  "/cmds/wiz/call": 1,
]);
string *wiz_level = ({
  "(player)",
  "(apprentice)",
  "(wizard)",
  "(arch)",
  "(admin)",
});

string *wizlist;

void create() {
  wizlist = explode(read_file(WIZLIST), "\n");
}
int path_power(string pathname) {
  return path[pathname];
}
string wizlevel(object ob) {
  int i;
  string id, level;
  for (i = 0; i < sizeof(wizlist); i++) {
    sscanf(wizlist[i], "%s %s", id, level);
    if (id == getuid(ob)) return level;
  }
  return "(player)";
}
int wiz_power(object ob) {
  int i;
  string ob_level = wizlevel(ob);
  for (i = 0; i < sizeof(wiz_level); i++)
    if (wiz_level[i] == ob_level) return i;
  return 0;
}
int set_wizlevel(object ob, string level) {
  string promoter = getuid();
  string wiz_id = getuid(ob);
  string new_wizlist = "", id, old_level;
  int i;
  for (i = 0; i < sizeof(wizlist); i++) {
    sscanf(wizlist[i], "%s %s", id, old_level);
    if (id == wiz_id) old_level = level;
    if (old_level != "(player)")
      new_wizlist = new_wizlist + id + " " + old_level + "\n";
  }
  if (wiz_power(ob) == 0) new_wizlist = new_wizlist + wiz_id + " " + level + "\n";

  rm(WIZLIST);
  write_file(WIZLIST, new_wizlist);
  return 1;
}
