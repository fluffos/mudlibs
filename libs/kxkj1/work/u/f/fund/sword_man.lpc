#include <ansi.h>

inherit NPC;
inherit PARTY_NPC;
void create() {
  set_name("飘流的剑客", ({ "sword man", "man" }));
  set("gender", "男性");
  set("combat_exp", 5000);
  set("attitude", "heroism");
  set("age", 20);
  set("str", 38);
  set("cor", 30);
  set("cps", 25);
  set("per", 22);
  set_skill("sword", 40);
  set_skill("dodge", 60);
  set("be_party_msg", "在下生平喜爱结交英雄豪结，不知阁下是否愿与在下结伴 ?\n");
  set("lim", 1);
  set("lim_msg", "话不投机半句多。\n");
  set("party_succeed_msg", "荣幸之至。\n");
  set("no_kill", 1);
  setup();
  carry_object("/obj/longsword")->wield();
}

int test_limit() {
  if (this_player()->query("kar") < 20 || this_player()->query("per") < 20 || this_player()->query("combat_exp") < 3000)
    return 0;
  return 1;
}
int test_kill_limit(object ob) {
  if (ob->query("combat_exp") < 3000) {
    command("say 我不杀无名小辈。\n");
    return 0;
  }
  return 1;
}
