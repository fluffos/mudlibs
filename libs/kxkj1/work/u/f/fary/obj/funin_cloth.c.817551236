#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
       set_weight(250);
	if( clonep() )
		set_default_object(__FILE__);
	else {
          set("unit","件");
          set("value",2000);
		set("material", "cloth");
             set("armor_prop/armor",20);
               set("armor_prop/dodge",5);
               set("armor_prop/move",4);
     set("long","有着红色光芒印有风的记号,好似传说的风王所遗留的,据说有招风
的力量。\n");
set("wear_msg",NOR"~~~~~~~~~~~~~~  "HIR"风"NOR"  ~~~~~~~~~~~~~~~~~~~ \n"NOR
"\n"
"\n"
"\n"
"\n"
"一阵无名的"HIW"风"NOR",不知从何而来,只觉莫名力量自体外涌入。\n");
}
	setup();
}
