#include <ansi.h>
#include <armor.h>

inherit EQUIP;

void create() {
  set_name("[1;36m风\银\彩战甲[0m", ({ "funin armor", "armor" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 2000);
    set("material", "ironsteel");
    set("armor_prop/armor", 10);
    set("armor_prop/attack", 3);
    set("armor_prop/dodge", -18);
    set("long", "有着[1;31m红色光芒[0m印有风的记号,它虽是战甲,可是却是非长轻便,而且具有相当的防御力。\n");
  }
  setup();
}
