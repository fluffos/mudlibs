// sword.c : an example weapon
#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create() {
  seteuid(getuid());
  set_name("[1;33m风\罡\刃[0m", ({ "winlin blade", "blade" }));
  set_weight(12000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "三千年前,风王降临了这块大陆,使得大陆的一切终归平静
,而祂走时吸纳了天地之气,再灌入自己的真气,而成了这把旷世奇刃。\n");
    set("value", 6000);
    set("material", "ironsteel");
    set("unwield_msg", "$N将右手内劲收回,$n消失无形 。\n");
  }
  init_blade(40);
  setup();
}
