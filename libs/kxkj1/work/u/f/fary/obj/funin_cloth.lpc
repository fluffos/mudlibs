#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name("风银彩缕\衣", ({ "funin cloth", "cloth" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 2000);
    set("material", "cloth");
    set("armor_prop/armor", 2);
    set("armor_prop/dodge", 5);
    set("armor_prop/move", 4);
    set("long", "这是一件
的力量。\n");
  }
  setup();
}
