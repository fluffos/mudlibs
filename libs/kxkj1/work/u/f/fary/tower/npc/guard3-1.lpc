//guard3-1.c make by pokai

inherit NPC;
#include <ansi.h>

void do_special();
void create() {
  set_name("简霸川", ({ "chien ba chou", "chou", "chien" }));
  set("nickname", "狂龙手");
  set("gender", "男性");
  set("attitude", "heroism");
  set("age", 35);
  set("class", "fighter");
  set("str", 23);
  set("cor", 23);
  set("int", 16);
  set("spi", 12);
  set("cps", 13);
  set("con", 20);
  set("per", 15);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 8);


  set("long", "你眼前的是一个彪形大汉，看到他粗壮的胳臂，你就知道他不是间单的人物。\n");
  set("combat_exp", 620000);
  set_skill("dodge", 70);
  set_skill("move", 67);
  set_skill("force", 65);
  set_skill("unarmed", 75);
  set_skill("lungshan", 90);
  set_skill("haoforce", 90);
  set_skill("henma-steps", 55);
  set("chat_chance", 5);
  set("chat_msg", ({
    "简霸川自个儿在那儿比拳，似乎无视于你的存在。\n",
    "简霸川喃喃说道：拳法要义，练气为先.......\n",
  }));

  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: do_special :)
  }));

  map_skill("dodge", "henma-steps");
  map_skill("unarmed", "lungshan");
  map_skill("force", "haoforce");

  setup();

  create_family("泷山派气宗", 3, "三煞");

  carry_object("/u/f/fary/tower/obj/w-armband")->wear();
  carry_object("/obj/cloth")->wear();

}
void do_special() {
  object *enemy, target;
  int i;

  enemy = this_object()->query_enemy();
  i = sizeof(enemy);
  target = enemy[random(i)];

  message_vision(
    HIR "\n简霸川左手搭在又手腕上，右拳像箭一般激射而出 ～～ 「阵风龙！！”\n" NOR, target);
  message_vision(
    HIR "只见赵明双掌幻化成一张掌网，疯狂地往你周身大穴拍打而去！！\n" NOR, target);
  target->receive_wound("kee", random(50));
  COMBAT_D->report_status(target);
}
