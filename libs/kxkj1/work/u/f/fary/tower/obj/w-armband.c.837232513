// This file is Wou wei armband , file name w-armband.c

#include <ansi.h>

inherit EQUIP;

void create()
{
        set_name( HIC "武威苍松臂环" NOR, ({ "wou-wei armband", "armband" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("long",HIC "
    一只用千年灵松所雕刻成的臂环，上头有浅浅的云状雕花，以及「耀武扬威”
    四个隶书小字。\n" NOR);

        set("armor_type","wrists");
        set("unit", "只");
        set("material", "wood");
        set("armor_prop/armor", 1);
        set("armor_prop/dodge", 20);
        set("armor_prop/move",20);
        set("no_drop",1);
        set("no_sell",1);
	set("no_put",1);
        set("no_give",1);
        set("no_get",1);
        }
        setup();
}
int query_autoload () { return 1; }

