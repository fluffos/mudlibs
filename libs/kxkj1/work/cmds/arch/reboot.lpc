// reboot.c

#define WADE_ROOM     "/u/w/wade/workroom"
#include <login.h>
#include <obj.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string wiz_status;
  object npc;
  int t;

  if (me != this_player(1)) return 0;

  wiz_status = SECURITY_D->get_status(me);
  if (wiz_status != "(manager)" && wiz_status != "(admin)" && wiz_status != "(arch)" && wiz_status != "(guest)")
    return notify_fail("只有 (arch) 以上的巫师才能重新启动" + MUD_NAME + "\n");

  seteuid(getuid());

  npc = new(NPC_DEMOGORGON);
  npc->move(WADE_ROOM);
  if (!arg)
    npc->start_shutdown(15);
  else {
    sscanf(arg, "%d", t);
    npc->start_shutdown(t);
  }

  write("Ok。\n");

  return 1;
}
