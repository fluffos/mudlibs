// quit.c

#include <command.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

mapping gift = ([
  "str": "膂力",
  "cor": "胆识",
  "int": "悟性",
  "spi": "灵性",
  "cps": "定力",
  "per": "容貌",
  "con": "根骨",
  "kar": "福缘",
]);

void create() {
  seteuid(getuid());
  set("name", "离线指令");
  set("id", "quit");
  set_temp("channel_id", "连线精灵");
}

int main(object me, string arg) {
  mapping my;
  object *inv, link_ob, body_ob, mob, wiz;
  string *gift_key, *my_key, id, src, dst;
  int i;

  if (wizardp(me) && arg) {
    if (wiz_level(me) < 4)
      return notify_fail("你的职权无法强迫玩家离开。\n");
    wiz = me;
    if (!(me = find_player(arg)))
      return notify_fail("没有这个玩家。\n");
    if (wiz_level(wiz) < wiz_level(me))
      return notify_fail("你无法强迫上级离开。\n");
  }

  if (me->query_temp("fight"))
    if (me->query_temp("pker_master") ||
      me->query_temp("pker"))
      return notify_fail("正在战斗中, 不行quit!\n");

  if (me->query("enforceup")) {
    me->set("enforceup", 0);
    me->set("force_factor", 10);
  }

  gift_key = keys(gift);
  if (me->query_temp("spe") == 1)
    SEC_KEE_D(me->query("sec_kee"))->remove_it(me);

  for (i = 0; i < sizeof(gift); i++)
    if (me->query(gift_key[i]) > 30) {
      tell_object(me, "你的" + gift[gift_key[i]] + "过高，系统将它改为 30。\n");
      me->set(gift_key[i], 30);
    }

  if (!wizardp(me)) {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++)
      if (!inv[i]->query_autoload())
        DROP_CMD->do_drop(me, inv[i]);
  }

  if (sizeof(me->query_team()) > 0)
    if (sizeof(me->query_team()) == 2)
      me->query_temp("leader")->dismiss_team();

  // 这里是判断: 如果有人switch mob 的话, 则将link_ob 交回原
  // char身上。这里是使玩家档坏的最大原因, 现在已经改好了
  //                                       modified by Konn
  //
  if (body_ob = me->query_temp("body_ob")) {
    link_ob = me->query_temp("link_ob");
    me->delete_temp("body_ob");
    exec(link_ob, me);
    exec(body_ob, link_ob);
    body_ob->setup();
    tell_object(me, "你的魂魄回到" + body_ob->name() + "的身上。\n");
    write("ok.\n");
    return 1;
  }

  if (wiz) {
    tell_object(me, wiz->name() + "(" + wiz->query("id") + ")强迫你离线。\n");
    message_vision("$N被$n瞪了一眼就离开游戏了。\n", me, wiz);
  } else {
    write("欢迎下次再来！\n");
    message_vision("$N离开游戏。\n", me);
  }

  log_file("quit",
    sprintf("%s(%s)于 %s 离开游戏。\n他的上一个命令是 '%s'\n",
      me->query("name"),
      me->query("id"),
      ctime(time()),
      me->query_temp("last_input"))
  );

  // Modify By Spirits. 10.02.1995
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s(%s)离开游戏了。", me->query("name"), me->query("id")));
  me->set("last_on", time());

  /*
        my = me->query_entire_temp_dbase();
        my_key = keys(my);
        for(i=0; i<sizeof(my_key); i++)
            me->delete_temp(my_key[i]);
*/
  me->save();

  /*      // 以下这段save第一备份档程式, 觉得没这个必要, 玩家若想备份档
        // 案的话他们自己会备份, 这样写有个坏处, 倘若原档案坏了的话,
        // 那么连第一备份档也会跟着坏掉, 这样就没有备份的意义了, 请原
        // 原作者将这段删除。
        //
        id = me->query("id");
        seteuid(ROOT_UID);
        src = sprintf ("/data/user/%s/%s.o", id[0..0], id);
        dst = sprintf ("/data/backup/user/%s/%s.o", id[0..0], id);
        if( !cp(src, dst) )
            return 1;
        src = sprintf ("/data/login/%s/%s.o", id[0..0], id);
        dst = sprintf ("/data/backup/login/%s/%s.o", id[0..0], id);
        if( !cp(src, dst) )
            return 1;
*/
  destruct(me);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : quit <player>
指令说明 : 
           当你(妳)想离开狂想的时候，可利用此一指令。
           离开之前，系统会自动储存您的进度。
	   大巫师则可以强迫玩家离线。
HELP);
  return 1;
}
