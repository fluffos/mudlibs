inherit F_CLEAN_UP;

int main(object me, string arg)
{
  string	*gage;

  gage = me->query_gage();
  if (!arg) {
    if (gage != ({}))
      printf ("你锁定的对象如下:\n%O\n", gage);
    else
      printf ("你没有锁定任何人。\n");
    return 1;
  }
  if (me->delete_gage(arg))
    printf ("你已经取消锁定 %s 的讯息。\n", arg);
  else {
    me->add_gage(arg);
    printf ("你已经锁定不接受 %s 的讯息。\n", arg);
  }
  return 1;
}

int help(object me)
{
write(@HELP
指令格式 : gage [玩家]
指令说明 :
           这个指令可以让你锁定不接受某人的干扰，
         想解除可以再下一次命令打开(像个开关)，
         如 gage wade
           如果没有指定玩家，会显示目前你锁定的对象。
HELP
    );
    return 1;
}
// 	document modified by ice
// 
//            gage 的对象无法对你下 kill 命令。
