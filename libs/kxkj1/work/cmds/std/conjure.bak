// conjure.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string magic;
	
	seteuid(getuid());

	if( environment(me)->query("no_fight") )
		return notify_fail("这里不准战斗。");

	if( environment(me)->query("no_magic") )
		return notify_fail("这里不准使用法术。");

	if( !arg )
		return notify_fail("你要用灵力施展什么神通？\n");
	arg = lower_case(arg);

	if( stringp(magic = me->query_skill_mapped("magic")) ) {
		if( !(SKILL_D(magic)->conjure_power(me, arg)) )
			return SKILL_D("magic")->conjure_power(me, arg);
		return 1;
	}

	return notify_fail("你请先用 enable 指令选择你要使用的法术。\n");
}

int help (object me)
{
        write(@HELP
指令格式 : conjure <法术名称> [<施用对象>]
指令说明 :
           使用法术或神通，你必需指定<法术名称>，<施用对象>则可有可无。
           在你使用某一种法术之前，你必须先用 enable 指令来指定你要使
           用的法术系。
特别注意 :
           如果你改变自己的法术系，你原本蓄积的灵力并不能直接转换过去，
         必须从 0 开始。
其他参考 :
           cast
HELP
        );
        return 1;
}
