#include <ansi.h>
#define SYNTAX	"指令格式：switch <使用者姓名>\n"

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string uid;
  object user, ob, my_ob;

  seteuid(getuid());
  if (!arg) return notify_fail(SYNTAX);

  if (stringp(arg))
    uid = arg;
  else
    return notify_fail(SYNTAX);

  user = present(uid, environment(me));
  if (!user) find_living(uid);
  if (!user) return notify_fail("Cannot find such living " + uid + "\n");
  if (wizardp(user)) return notify_fail("Cannot switch user to wizard\n");
  // Add by ice... 避免玩家说有问题..
  if (find_player(uid)) return notify_fail("Cannot switch user to player\n");

  ob = user->query_temp("link_ob");
  my_ob = me->query_temp("link_ob");
  message_vision("$N化成一道光芒钻进$n体内。\n", me, user);
  if (objectp(ob)) {
    exec(ob, user);
    destruct(ob);
  }
  user->set_temp("link_ob", me);
  me->set_temp("body_ob", user);
  exec(user, me);
  user->reconnect();
  UPDATE_D->check_user(user);
  // user->setup();
  // destruct (me);

  return 1;
}

int help() {
  write(SYNTAX + @TEXT

变身为某一玩家，或是变身为某一位 NPC 。
quit 之后会回到自身
TEXT
  );
}
