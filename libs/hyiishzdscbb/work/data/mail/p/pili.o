#/clone/misc/mailbox.c
dbase (["id":"mailbox","no_get":1,"no_beg":1,"unit":"个","owner_id":"pili","name":"天若友情的信箱","no_insert":1,"no_put":1,"no_steal":1,"no_drop":1,"long":"这是个人信箱，但信件内容对巫师无法保密，请勿谈及个人隐私：mailto  <某人>            寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read    <信件编号>        阅读某一封信件。discard <信件编号>        丢弃一封信件。",])
mails ({(["time":969478293,"to":"rrt","from":"天若友情(pili)","title":"娥眉拍掌","text":"{'天堂有路你不走呀;d;a;#3 sw;out;w;#8 n;#3 ne;su;w;sw;w;#7 wu;nw}{nw;nu;wu;sw;wu}",]),(["time":970860869,"to":"rrt","from":"天若友情(pili)","title":"泉洲路径","text":"(n;#3 e;enter dong;'天堂有路你不走呀;d;b;se;se;out;n;n;#7 s)",]),})
