dbase (["no_put":1,"no_steal":1,"owner_id":"xiaoyao zi","unit":"个","long":"这是个人信箱，但信件内容对巫师无法保密，请勿谈及个人隐私：mailto  <某人>            寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read    <信件编号>        阅读某一封信件。discard <信件编号>        丢弃一封信件。","id":"mailbox","no_insert":1,"no_get":1,"no_beg":1,"no_drop":1,"name":"醉卧美人膝的信箱",])
mails ({(["text":"// garrison.cinherit NPCvoid create(){        set_name(洗衣老板, ({ lao ban, boss }) )        set(long,                \"扬州中最老的老头，扬州老小都很尊敬他\\n\")        set(gender,男性)        set(combat_exp, 8888)        setup()        carry_object(obj/cloth)->wear()}void init(){        ::init()        add_action(do_wash, wash)}int do_wash(string arg){        object ob        object meif(me->is_busy()) return notify_fail(你的动作还没有完成，不能工作。\\n)message_vision($N辛苦的洗衣服工作终于结束了，哦可以去拿报酬咯.\\n,me)me->add(gin,-12)me->add(sen,-12)ob->move(me,10)message_vision(上了年纪的老头对$N说：年轻人多做点工作对身体有好处!。\\n, me)me->start_busy(1)return 1}","to":"bbs","from":"醉卧美人膝(xiaoyao zi)","time":967976224,"title":"大爷我写的job的npc",]),(["text":"// Copyright (C) 1995, by Tie Yu and Daniel Yu. All rights reserved.// This software can not be used, copied, or modified in any form without// the written permission from authors.inherit ROOMvoid create(){        set(short, 洗衣店)        set(long, @LONG这是一间洗衣店，这里是有钱人将衣服拿来浆洗的地方。这里的老板是一个上了年纪的老头，孤身一人，无儿无女，仅靠这洗衣店微薄的收入维持生活。门口有一个大木牌（ｓｉｇｎ）。LONG        )        set(exits, ([ /* sizeof() == 1 */  \"southdown\" : __DIR__\"garments\",]))        set(item_desc, (                \"gaoshi\": @TEXT本店需要一批能吃苦的人手来洗衣服。W A S H　开始工作。TEXT        ]) )        set(objects, (        __DIR__npc/lao ban : 1,                        ]) )    set(no_fight, 1)    set(no_magic, 1)    set(NONPC,1)        setup()        replace_program(ROOM)}","to":"bbs","from":"醉卧美人膝(xiaoyao zi)","time":967976258,"title":"大爷我写的job",]),})
