#/clone/misc/mailbox.c
dbase (["no_get":1,"name":"杀手的信箱","id":"mailbox","owner_id":"bbs","no_insert":1,"no_put":1,"unit":"个","no_beg":1,"no_steal":1,"no_drop":1,"long":"这是个人信箱，但信件内容对巫师无法保密，请勿谈及个人隐私：mailto  <某人>            寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read    <信件编号>        阅读某一封信件。discard <信件编号>        丢弃一封信件。",])
mails ({(["from":"杀手(bbs)","time":967002896,"title":"有事找你","text":"有事找你,留个电话给我.l我们几个wiz 有事要和你说.","to":"zzz",]),(["from":"盗帅(kazuya)","time":967214172,"title":"无题","text":"","to":"bbs",]),(["from":"看看(kkkkk)","time":967214699,"title":"关于wiz","text":"现在wiz多了人也多了是件好事但许多wiz都自己在玩,杀npc啦，杀飞贼啦，把master杀了我们怎么学功夫?甚至还自己开dummy玩这对player来说有些不公平，希望能管理一下.还有就是wei quest很多人不知哪来的那么多钱(我怀疑有wiz call的)如eva,applett,like等等人我上线差不多都看见他们在robot做wei quest起码用了几万gold,applett好象只有15岁就150k exp了,怎么可能？如果查不出希望能把wei quest改一改，放弃quest的时候减1/5个quest的exp这样至少不能乱放弃quest,他们现在除了能买到的固定几样东西其他的都放弃的我们吧里本来也有人玩的，还拉了人，可看见这种事你说有信心练吗?这样下去发现的玩家多了都会丧失信心的。","to":"bbs",]),(["from":"醉卧美人膝(chao)","time":967688033,"title":"emei的药。我自己做的啦","text":"// lianzi-wan.cinherit ITEMvoid setup(){}void init(){        add_action(do_fu, fu)}void create(){        set_name(MAG天香断续膏NOR, ({tianxiang duanxugao, duanxugao, gao}))        if (clonep())                set_default_object(__FILE__)        else {                set(unit, 颗)                set(long, 这是一副峨嵋派的灵丹妙药，在受伤的时候敷上可以很快复原。\\n)                set(value, 5000)                set(no_get, 这样东西你拿不了。\\n)        }        setup()}int do_fu(string arg){//      int nv//      nv = ((int)this_player()->query(max_qi) - (int)this_player()->query(eff_qi)) * 8 / 10        if (!id(arg))                return notify_fail(你要敷什么药？\\n)        if ((int)this_player()->query(eff_qi) ==             (int)this_player()->query(max_qi))                return notify_fail(你现在不需要用天香断续膏。\\n)        else {                this_player()->set(eff_qi, this_player()->query(max_qi))                this_player()->set(qi, this_player()->query(max_qi))                message_vision($N在伤口敷上一副天香断续膏，气色看起来好多了。\\n, this_player())                destruct(this_object())                return 1        }}","to":"bbs",]),(["from":"醉卧美人膝(xiaoyao zi)","time":967976224,"title":"大爷我写的job的npc","text":"// garrison.cinherit NPCvoid create(){        set_name(洗衣老板, ({ lao ban, boss }) )        set(long,                \"扬州中最老的老头，扬州老小都很尊敬他\\n\")        set(gender,男性)        set(combat_exp, 8888)        setup()        carry_object(obj/cloth)->wear()}void init(){        ::init()        add_action(do_wash, wash)}int do_wash(string arg){        object ob        object meif(me->is_busy()) return notify_fail(你的动作还没有完成，不能工作。\\n)message_vision($N辛苦的洗衣服工作终于结束了，哦可以去拿报酬咯.\\n,me)me->add(gin,-12)me->add(sen,-12)ob->move(me,10)message_vision(上了年纪的老头对$N说：年轻人多做点工作对身体有好处!。\\n, me)me->start_busy(1)return 1}","to":"bbs",]),(["from":"醉卧美人膝(xiaoyao zi)","time":967976258,"title":"大爷我写的job","text":"// Copyright (C) 1995, by Tie Yu and Daniel Yu. All rights reserved.// This software can not be used, copied, or modified in any form without// the written permission from authors.inherit ROOMvoid create(){        set(short, 洗衣店)        set(long, @LONG这是一间洗衣店，这里是有钱人将衣服拿来浆洗的地方。这里的老板是一个上了年纪的老头，孤身一人，无儿无女，仅靠这洗衣店微薄的收入维持生活。门口有一个大木牌（ｓｉｇｎ）。LONG        )        set(exits, ([ /* sizeof() == 1 */  \"southdown\" : __DIR__\"garments\",]))        set(item_desc, (                \"gaoshi\": @TEXT本店需要一批能吃苦的人手来洗衣服。W A S H　开始工作。TEXT        ]) )        set(objects, (        __DIR__npc/lao ban : 1,                        ]) )    set(no_fight, 1)    set(no_magic, 1)    set(NONPC,1)        setup()        replace_program(ROOM)}","to":"bbs",]),(["from":"雪花飘(snowfly)","time":971407776,"title":"about help","text":"你告诉小人物：help 加5点悟性吧，我好需要的，上次没加呢小人物(hxsd)告诉你：我和bbs说过了，让他给你加我报告了好多bug了哦，所以该奖励的呢help 加5点悟性，好想学taixuan的，bow bow上次你说给我加的，后来我发现其实没有加，大概你忘了吧，:)所以帮我加5点悟性吧，beg bowthx","to":"bbs",]),(["from":"雪花飘(snowfly)","time":971423515,"title":"hihi","text":"hihi【悟性】 46【防御力】8477561(+4)  读书写字 (literate)                      - 深不可测 300/   38那样，我先天只有16了，我本来有24的，wuwuwuw越来越少了help me recover","to":"bbs",]),})
