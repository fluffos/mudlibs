#/clone/misc/mailbox.c
dbase (["no_insert":1,"name":"小人物的信箱","no_get":1,"no_drop":1,"no_beg":1,"no_steal":1,"no_put":1,"long":"这是个人信箱，但信件内容对巫师无法保密，请勿谈及个人隐私：mailto  <某人>            寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read    <信件编号>        阅读某一封信件。discard <信件编号>        丢弃一封信件。","owner_id":"hxsd","unit":"个","id":"mailbox",])
mails ({(["text":"现在wiz多了人也多了是件好事但许多wiz都自己在玩,杀npc啦，杀飞贼啦，把master杀了我们怎么学功夫?甚至还自己开dummy玩这对player来说有些不公平，希望能管理一下.还有就是wei quest很多人不知哪来的那么多钱(我怀疑有wiz call的)如eva,applett,like等等人我上线差不多都看见他们在robot做wei quest起码用了几万gold,applett好象只有15岁就150k exp了,怎么可能？如果查不出希望能把wei quest改一改，放弃quest的时候减1/5个quest的exp这样至少不能乱放弃quest,他们现在除了能买到的固定几样东西其他的都放弃的我们吧里本来也有人玩的，还拉了人，可看见这种事你说有信心练吗?这样下去发现的玩家多了都会丧失信心的。","time":967214699,"to":"hxsd","from":"看看(kkkkk)/转寄自看看","title":"关于wiz",]),(["text":"// thousand.cinherit MONEYvoid create(){        set_name(HIY 一千两金票 NOR, ({thousand-gold, thousand-gold_money, gold_money}))        if( clonep() )                set_default_object(__FILE__)        else {                set(money_id, thousand-cash)                set(long, 一张面额值十万两银子的银票。\\n)                set(unit, 叠)                set(base_value, 100000)                set(base_unit, 张)                set(base_weight, 3)                set(no_drop,1)                set(no_give,1)                set(no_get,1)                set(no_put,1)        }        set_amount(1)}","time":967695800,"to":"hxsd","from":"逍遥子(xiaoyao zi)","title":"我自己做的thousand-gold看看能不能放上去",]),(["text":"rt","time":968989650,"to":"hxsd","from":"影子(figure)","title":"有奖励吗？",]),(["text":"来海洋已经好多天了， 进来以后一直立志成为东方不败老大的笛子sorry 是弟子但是现在经过努力成功之后却发现日月教有很多问题有待完善现在一一列出第一就是pixie-jian 和pixie-sword 之间的问题，我不知道当初设定这两种skill的初衷是什么但是我想不外忽就是区别做出男人的牺牲和不作出牺牲的区别把但是用到现在来觉得到是pixie-sword 比pixie-jian 好用不错，pixie-jian 确实可以两hit 一下攻击， 也可以作为dodge 来使用这都是它的长处但是作为一项顶级skills来说最强的地方应该体现在它的perform 上面很遗憾的发现在我使用pixie-sword 的时候perform cimu 虽然命中率不高但是如果exp比对手高一些，十下里也能中个5-6下对方中招之后也会busy 个好几招这样的perform对于是学pixie-jian之前的过度skill说已经应该算挺强的了也正应为如此我对pixie-jian的perform充满着幻想，于是作出了最大的牺牲但是发现cut 了以后我无法学习自己的本门force百般无奈之下只好在400k exp的时候放弃 重新练了现在这个id可是当我花了好多心血学来的pixie-jian perform cimu的时候发现我perform之后自己busy还没过对方就已经连出三招真不知道是插别人的眼睛还是插自己的，第二就是拜东方不拜学的葵花心法后对pixie-jian 有什么助益呢？答案是没有，作为东方不拜的传人使用出来的pixie-jian和用林家残缺不全的pixie剑谱学的一样在原著中显然是不对的，否则为什么林平之和岳不群被独孤九剑轻松搞定而令狐冲遇到东方不败就一败涂地呢？ 显然是有原因的。如果wiz 能把这点表现出来的话也就不枉我们千辛万苦才拜到的东方老大这里要申明的是败dongfang bubai 的quest和条件没有任何人告诉我，是我自己一步一步解出quest然后一次又一次的开新人试出来的拜师条件第三就是那么大个日月神教，门口排场不小，但是里面却只有豆腐干那么大的一点地方连吃饭的地方都没有，而且魔教身为当时的第一大教 对门下弟子居然一点福利也没有门派里面更没有辅助门下弟子功力的什么奇门异术，落魄到这种地步魔教还是散伙算了暂时说的就那么多了，其他的一时想不起来,如果能够接受的话请通知一声， 本人不胜期待！                                 艳阳。ussssssswnwwswwseswwwuk ship3p3k ship3p3k shik guardlhpk guarddaexert healhpexert heallhp","time":969869575,"to":"hxsd","from":"艳阳(yanyang)","title":"问题与建议",]),(["text":" 我不想  post 所以 mail you我想知道  rule  到底是干什么工作？？？程序开发？？那为什么什么事也不做 到这里说这个巫师说那个不是 没见过他做任何事眼下 门派 job 工作量太大  难道就让我和chao  两个人完成？chao 还不是很熟练rule 竟然说 我对玩家 下 kill  这从何说起 ？？？难道一个这样的人能做 arch ?简直浪费权限 我们 edit  都没权限  怎么写 难道都放在自己的目录 维护只能自己来？上次我和你说 让 chao 做我助手 因为他对这里很有热情 我相信他会作的很好只是对程序不是很熟悉 罢了 这没什么，可以慢慢来  但让一个 会的  而不工作的 巫师来开发 这要到何年马月啊 如果他喜欢管理 就让他去在线管理算了  不要站着茅坑不拉屎 我们现在连 /d/下都不能edit 让rule 改一下  比等天还难，我认为他只会说 不会做别的我也不多说了  /d/下最好改一下 让wiz 以上都能edit 把 不然出口等 根本没法做至于 rule 怎么做 你看着办吧 如果让他管理wiz  我是不赞成的 ","time":972893423,"to":"hxsd","from":"萧湘雨夜(skyzxm)","title":"有点事要和你说",]),(["text":"你也是admin 我到要问问 巫师规则是玩的吗？我post chao私下给玩家吃东西 他就要bbs cut  我难道有admin 撑腰 就什么都不用怕？？一个14岁 乳臭未干的毛孩子竟然能做 巫师 我真有点怀疑你们是怎么想的另外现在做 公共job的只有我一个妈的 还吃力不讨好 竟然被 cut 这算什么意思 比我大的巫师犯错 说不得？？是不是？bbs 我没看他做什么 也许我不知道 你应该知道吧chao 什么也做不了 写个程序  void()-setup()一个分号也没有job 部分还要我来写 我不是神 我是人 你们 随便cut 有没有商量过你去看看玩家的post 把save别人说几句就杀档 他妈的 我作了job一半竟然 cut你到给我个说法 bbs 每次来都会有问题 前面是 mugua 这次更好是不是 一定要拍你们马屁啊  不然就 cut purge ?是不是 一定要拍你们马屁啊  不然就 cut purge ?如果是 我明确告诉你 我不会我只会按规则办事 我只会按规则办事 不然 你也可以下岗了 好了 我屁话也不说了 你自己看着办 如果你看得起我 如果你相信我的话  就 恢复 我和  所有 被杀的 id分别是  jieli wzx kissme 分别是  jieli wzx kissme 分别是  jieli wzx kissme 分别是  jieli wzx kissme 分别是  jieli wzx kissme 分别是  jieli wzx kissme 再放一句屁：我不希望和败类一起工作 希望 cut bbs 和 那个没用小孩子还有 没上线的 id 为什么 purge ???现在人家本人还不知道玩家的安全感 哪里来 ？？post 78 说的很对  bbs 每次来是制造一大堆问题  让我们解决 哪里像巫师 ？？？好了  你自己 看着办好了  我现在的 id 是 loveyyj如果我和他们不恢复 这里真的完了  不信的话 我过一个月来看看 我们也可以打个赌