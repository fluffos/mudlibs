#include <ansi.h>
inherit NPC;

string ask_me();
void create() {
  set_name("一灯大师", ({ "yideng dashi", "yideng", "dashi" }));
  set("long", "他原本是大理的皇帝，俗名叫段智兴，\n在江湖上被尊称为南帝，后来出家做了和尚。\n");
  set("gender", "男性");
  set("title", "慈悲为怀");
  set("nickname", HIY "南僧" NOR);
  set("class", "bonze");
  set("age", 93);
  set("shen_type", 1);
  set("str", 40);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("qi", 8000);
  set("max_qi", 8000);
  set("jing", 1500);
  set("max_jing", 1500);
  set("neili", 15000);
  set("max_neili", 10000);
  set("jiali", 200);
  set("combat_exp", 3000000);
  set("score", 1000000);

  set_skill("force", 500);
  set_skill("kurong-changong", 500);
  set_skill("dodge", 450);
  set_skill("shaolin-shenfa", 450);
  set_skill("parry", 450);
  set_skill("finger", 500);
  set_skill("staff", 450);
  set_skill("yiyang-zhi", 500);
  set_skill("weituo-gun", 450);
  set_skill("buddhism", 500);
  set_skill("literate", 120);

  map_skill("force", "kurong-changong");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("parry", "yiyang-zhi");
  map_skill("finger", "yiyang-zhi");
  map_skill("staff", "weituo-gun");
  prepare_skill("finger", "yiyang-zhi");
  set("inquiry", ([
    "六脉神剑": "“依老衲的内功修为本来可以练成全套六脉神剑，但这种杀人的武功不练也罢!”\n",
    "一阳指": "一阳指乃我大理段氏独门武学。\n" ]));

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "finger.dianxue" :),
    (: exert_function, "recover" :),
  }));
  create_family("天龙寺", 18, "大师");
  setup();
  carry_object("/d/shaolin/npc/obj/hui-cloth")->wear();
}
void attempt_apprentice(object ob) {
  if ((int)ob->query("combat_exp") < 100000) {
    message_vision("一灯大师对$N笑道：你的经验太低了,我还不能收你！\n", ob);
    return;
  }
  if ((int)ob->query_skill("kurong-changong", 1) < 50) {
    command("say 我大理天龙寺乃内家武功，最重视内功心法。");
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在枯荣禅功上多下点功夫？");
    return;
  }
  message_vision("一灯大师拍拍$N的头，微微点了点头。\n", ob);
  command("recruit " + ob->query("id"));
  return;
}
