inherit NPC;
inherit F_MASTER;
void create()
{
	set_name("岳不群", ({ "yue buqun", "yue", "buqun" }));
	set("nickname", "君子剑");
	set("long", 
"岳不群是华山派的当今掌门人。\n");
	set("gender", "无性");
	set("age", 45);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 23);
	set("int", 23);
	set("con", 24);
	set("dex", 28);
	
	set("max_qi", 2000);
	set("max_jing", 600);
	set("neili", 3000);
	set("max_neili", 2000);
	set("jiali", 50);
	set("combat_exp", 500000);
	set("score", 5000);

	set_skill("force", 200);
	set_skill("dodge", 180);
	set_skill("parry", 180);
	set_skill("sword", 200);
	set_skill("cuff", 180);
	set_skill("strike", 160);
	set_skill("zixia-shengong", 200);
	set_skill("huashan-jianfa", 180);
	set_skill("pixie-jian", 180);
	set_skill("huashan-shenfa", 180);
	set_skill("hunyuan-zhang", 160);
	set_skill("poyu-quan", 160);

	map_skill("force", "zixia-shengong");
	map_skill("dodge", "huashan-shenfa");
	map_skill("parry", "pixie-jian");
	map_skill("sword", "pixie-jian");
	map_skill("cuff", "poyu-quan");
	map_skill("strike", "hunyuan-zhang");

	prepare_skill("strike", "hunyuan-zhang");
	prepare_skill("cuff", "poyu-quan");

	create_family("华山派", 13, "掌门");

	setup();
	carry_object("/clone/misc/cloth")->wear();
	carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen") < 1000) {
		command("say 我华山派乃是堂堂名门正派，对弟子要求极严。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否还做得不够？");
		return;
	}

	if ((int)ob->query_int() < 25) {
		command("say 依我看" + RANK_D->query_respect(ob) + "的资质似乎不适合学我华山派武功？");
		return;
	}
	
	command("say 好吧，我就收下你了。");
	command("recruit " + ob->query("id"));
	if((string)ob->query("class") != "swordsman")
		ob->set("class", "swordsman");

	return;
}