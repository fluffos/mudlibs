// sample master.c code
// xiake island master.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();

void create() {
  set_name("龙岛主", ({ "master long", "long", "master" }));
  set("nickname", RED "不败神龙" NOR);
  set("gender", "男性");
  set("age", 50);
  set("long",
    "这难道就是江湖传说的侠客岛的龙岛主吗？\n他看上去跟一般的中年人无异，可是他已有百岁高龄。\n他因为和木岛主联手挑战石破天，结果\n木岛主力竭战死，他也快油尽灯枯了。\n不过他俩能在死前领会太玄功的奥妙，都兴奋不已。\n");
  set("attitude", "peaceful");

  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("neili", 5000);
  set("max_neili", 9000);
  set("qi", 3000);
  set("eff_qi", 3000);
  set("max_qi", 8000);
  set("jing", 1000);
  set("max_jing", 1000);
  set("jingli", 1000);
  set("max_jingli", 1000);
  set("jiali", 100);

  set("combat_exp", 2500000);
  set("score", 500000);

  set_skill("force", 400);
  set_skill("taixuan-gong", 399);
  set_skill("unarmed", 400);
  set_skill("dodge", 400);
  set_skill("parry", 400);
  set_skill("literate", 100);

  map_skill("force", "taixuan-gong");
  map_skill("unarmed", "taixuan-gong");
  map_skill("dodge", "taixuan-gong");
  map_skill("parry", "taixuan-gong");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.shibu" :),
    (: exert_function, "regenerate" :),
    (: exert_function, "recover" :),
  }));
  setup();

  create_family("侠客岛", 1, "掌门");
  carry_object("/clone/misc/cloth")->wear();
}
void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < 0) {
    command("say 老夫不收邪魔歪道做弟子。");
    return;
  }
  command("say 没想到老夫临死之前还能收到一个好徒弟。");
  command("recruit " + ob->query("id"));
}
