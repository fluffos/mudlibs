// guojing.c 郭靖

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("郭靖", ({"guo jing", "guo", "jing"}));
	set("title", "侠之大者");
	set("nickname", HIY"北侠"NOR);
	set("gender", "男性");
	set("age", 35);
	set("long", 
		"他就是人称北侠的郭靖，既是蒙古成吉思汗的金刀驸马，又是\n"
		"江南七怪、全真派马钰道长、「北丐」洪七公和「老顽童」周\n"
		"伯通等人的徒弟，身兼数门武功。\n"
		"他身着一件灰色长袍，体态魁梧，敦厚的面目中透出一股威严\n"
		"令人不由得产生一股钦佩之情。\n");
 	set("attitude", "peaceful");
	
	set("str", 40);
	set("int", 20);
	set("con", 30);
	set("dex", 25);
  set("food",1000);
  set("water",1000);
	set("chat_chance", 1);
	set("chat_msg", ({
		"郭靖叹了口气道：“蒙古兵久攻襄阳不下，一定会再出诡计，蓉儿又不在身边，这....\n",
		"郭靖说道：“华筝公主近来不知可好，抽空一定要回大漠去看看她。\n",
		(: random_move :),
	}));

	set("inquiry", ([
		"黄蓉" : "蓉儿是我的爱妻，你问她做甚？\n",
		"丐帮" : "东北西北东西北。\n",
		"拜师" : "现在蒙古人围攻襄阳，我哪有心情收徒啊！\n",
	]));
  set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: perform_action, "strike.xianglong" :),
		(: perform_action, "strike.dielang" :),
		(: exert_function, "recover" :),
	}) );
	set("qi", 20000);
	set("max_qi", 20000);
	set("jing", 10000);
	set("max_jing", 10000);
	set("jingli",1300);
	set("max_jingli",1300);
	set("neili", 40000);
	set("max_neili", 20000);
	set("jiali", 300);
	
	set("combat_exp", 3000000);
	set("score", 200000);
	 
	set_skill("force", 450);		// 基本内功
	set_skill("jiuyin-shengong", 450);	// 九阴神功
	set_skill("strike", 450);		// 基本拳脚
	set_skill("xianglong-zhang", 450);	// 降龙十八掌
	set_skill("hubo", 400);
	set_skill("dodge", 400);		// 基本躲闪
	set_skill("xiaoyaoyou", 400);		// 逍遥游
	set_skill("parry", 450);		// 基本招架
	
	map_skill("force", "jiuyin-shengong");
	map_skill("strike", "xianglong-zhang");
	map_skill("dodge", "xiaoyaoyou");
	map_skill("parry", "xianglong-zhang");
	prepare_skill("strike", "xianglong-zhang");
	setup();
	create_family("全真教", 3, "弟子");
	carry_object("/clone/misc/cloth")->wear();
}

int recognize_apprentice(object ob)
{
	if (!(int)ob->query_temp("mark/郭"))
		return 0; 
	ob->add_temp("mark/郭", -1);
	return 1;
}

int accept_object(object who, object ob)
{
	if (!(int)who->query_temp("mark/郭"))
		who->set_temp("mark/郭", 0);
	if (ob->query("money_id") && ob->value() >= 5000) {
		message_vision("郭靖同意指点$N一些问题。\n", who);
		who->add_temp("mark/郭", ob->value() / 250);
		return 1;
	}
	return 0;
}
void attempt_apprentice(object ob)
{
	command("say 在下拙于言辞，不想误人子弟。");
}