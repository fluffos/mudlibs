#include <lib.h>

inherit LIB_BASE_TRAINER;
inherit LIB_SENTIENT;

protected void create(){
    base_trainer::create();
    sentient::create();
}

/* base_trainer and sentient both define init(); the driver kept sentient's, so the student record
 * that base_trainer's init() clears when a pupil comes back never was, and "I am already training
 * you!" stuck for good once someone left in the middle of a lesson. */
void init(){
    sentient::init();
    base_trainer::init();
}
