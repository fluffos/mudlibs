TalkHist (["say":({"2026.08.26-18.38,03 Lars says in Common, \"%^BOLD%^CYAN%^Thank you for your business, Qintestds.%^RESET%^\"","2026.08.26-18.39,04 Herkimer says in Common, \"%^BOLD%^CYAN%^First you must prove yourself worthy. Help my brother Leo find the Orcslayer and I will happily welcome you into our family. Until then, you may not join the mages.%^RESET%^\"","2026.08.26-18.39,14 Herkimer says in Common, \"%^BOLD%^CYAN%^You lack enough silver coins to pay for that spell.%^RESET%^\"","2026.08.26-18.39,14 Herkimer says in Common, \"%^BOLD%^CYAN%^Light costs 100 silver and you only have 88.000000.%^RESET%^\"","2026.08.26-18.39,14 Herkimer says in Common, \"%^BOLD%^CYAN%^I can only accept silver. It's a magic thing. If you want, you can try to exchange your other currency for silver at the bank across the street.%^RESET%^\"","2026.08.26-18.49,33 Herkimer says in Common, \"%^BOLD%^CYAN%^You lack enough silver coins to pay for that spell.%^RESET%^\"","2026.08.26-18.49,33 Herkimer says in Common, \"%^BOLD%^CYAN%^Light costs 100 silver and you only have 88.000000.%^RESET%^\"","2026.08.26-18.49,33 Herkimer says in Common, \"%^BOLD%^CYAN%^I can only accept silver. It's a magic thing. If you want, you can try to exchange your other currency for silver at the bank across the street.%^RESET%^\"","2026.08.26-18.54,43 Dirk says in Common, \"%^BOLD%^CYAN%^Level 2 with the title of \"the simple novice\" requires 500 experience points and 0 quest points.%^RESET%^\"","2026.08.26-18.54,43 Dirk says in Common, \"%^BOLD%^CYAN%^I'm sorry, Qintestds, but you have not fulfilled all the requirements of level 2. Please come back and try again once you have fulfilled them.%^RESET%^\"",}),"exclaim":({"2026.08.26-18.37,33 James exclaims in Common, \"%^BOLD%^CYAN%^Here is a claritin pill for 10 silver!%^RESET%^\"",}),"ask":({"2026.08.26-18.39,04 Herkimer asks in Common, \"%^BOLD%^CYAN%^Hmm...want to join our guild, do you?%^RESET%^\"",}),])
