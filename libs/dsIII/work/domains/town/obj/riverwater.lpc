#include <lib.h>
#include <meal_types.h>

inherit LIB_FLASK; 

/* An invisible fixture of its room, like LIB_DUMMY: isDummy() and the invisibility are all that
 * LIB_BASE_DUMMY added to an item.  Inheriting it next to LIB_FLASK gave the object two copies of
 * everything the two share. */
int isDummy(){ return 1; }

protected void create() {
    flask::create();
    SetKeyName("water");
    SetId(({"river","riverwater" }));
    SetAdjectives("powerful","river");
    SetLong("The edge of a powerful river.");
    SetShort("the edge of a powerful river");
    SetFlaskContents("water");
    SetFlaskUses(2);
    SetStrength(5);
    SetMaxFlask(2);
    SetEverFill(1);
    SetMealType(MEAL_DRINK);
    SetNoCondition(1);
    SetInvis(1);
}

mixed CanGet(object ob) { return "#The river stays in place.";}
