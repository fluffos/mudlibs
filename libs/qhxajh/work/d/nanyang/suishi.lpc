// /d/city/nanyang/suishi.c
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", YEL "碎石岭" NOR);
  set("long", @LONG
西行是独秀峰，脚下已经无路，只有些藤条挂在崖壁上，是采药人常用的攀
登工具。北面是一道山谷，谷底幽深黑暗，寒风刺骨。向东下山，就可以望见南
阳城了。南面而望，可见田地屋舍，河流纵横。
LONG);
  set("exits", ([
    "northdown": __DIR__ "heifeng",
    "eastdown": __DIR__ "shanyao",
  ]));
  set("objects", ([
    __DIR__ "npc/caiyao": 1,
  ]));
  set("outdoors", "nanyang");
  setup();
}
