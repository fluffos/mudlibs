// liang.c

#include <ansi.h>
inherit NPC;

void create() {
  set_name("大汉", ({ "da han", "man" }));
  set("title", "");
  set("long", "一位彪形大汉。\n");
  set("age", 20 + random(20));
  set("gender", "男性");
  seteuid(getuid());
  set_wugong("unarmed", 60, random(30) + 30, 1);
  set_wugong("blade", 50, random(50) + 10, 1);
  set_xiuwei_by_type("unarmed", random(80));
  set_xiuwei_by_type("blade", random(80));
  set("combat_exp", 1000);
  set("talk_msg", ({
    "这里是南阳城",
    "这里是诸葛亮的故乡",
    "柯府老爷为民除害，大家都感恩待德呀！",
    "南阳城北接中原，南渡汉水。",
  }));
  setup();
  // This archive has no clone/weapon/ or clone/wear/ tree (noted in
  // NOTES.md). cloth2 lives under npc/obj/; blade has no local copy.
  // Unguarded carry_object()->wear()/wield() is §7.73 call_other(0)
  // on every room reset that clones this NPC (caught by room setup
  // catch, but still a real programming bug — same mini-archive
  // path-relocation shape as xo's round-three fix).
  {
    object blade, cloth;
    blade = carry_object(BLADE_DIR "blade");
    if (blade) blade->wield();
    cloth = carry_object(__DIR__ "obj/cloth2");
    if (cloth) cloth->wear();
  }
}
