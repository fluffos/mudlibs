// 
#include <ansi.h>
#include <weapon.h>

inherit WHIP;


void create()
{
        set_name(GRN "青龙鞭" NOR, ({ "qinglong bian","whip" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一条四尺来长鞭子，用牛筋缠以钢丝，外裹绿麻。\n");
                set("unit", "条");
                set("value", 1200);
                set("material", "iron");
        }
        init_whip(40);

        set("wield_msg", "$N从腰间解下一条$n握在手中。\n");
        set("unwield_msg", "$N将手中的$n束在腰间。\n");

        setup();
}

