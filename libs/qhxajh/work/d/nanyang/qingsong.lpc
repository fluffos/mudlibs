// /d/city/nanyang/qingsong.c
#include <ansi.h>
inherit ROOM;
void create()
{
  set("short",GRN"青松冈"NOR);
  set("long",@LONG
身处一片松海之中，鼻子里嗅到的是松树那种特殊的清香。耳边回荡着各种
鸟雀的鸣叫声，十分动听。向北下山有一条小路, 是通向关中的捷径，然而如今
少有人走，已渐渐荒草丛生了。东面有一座不小的山寨。
LONG);
  set("exits",([
    "northeast"   : __DIR__"shanzhai",
    "west"  : __DIR__"laoya",
  ]));
  set("outdoors","nanyang");
  setup();
}
