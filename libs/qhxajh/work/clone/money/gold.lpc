// gold.c  modified by lin on Feb,28 97
#include <ansi.h>
inherit MONEY;

void create()
{
	set_name(YEL "黄金" NOR, ({"gold","gold_money"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("money_id", "gold");
		set("long", "黄澄澄的金子,上面刻着“户部平准一两”\n");
		set("unit", "些");
		set("base_value", 10000 );
		set("base_unit", "两");
		set("base_weight", 33);
	}
	set_amount(1);
}

