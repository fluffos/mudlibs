// money.c 
// by trill

inherit F_DBASE;
inherit F_SAVE;

void create()
{
    set( "name", "Ǯ" );
    set( "id", "money" );
    restore();
}

string query_save_file()
{
    return DATA_DIR + "money";
}

int check_money( string my_id )
{
    mapping money;
    string *id;
    int i, result;

    if ( my_id ) return query( my_id );

    money = query_entire_dbase();

    id = keys( money );
    for ( i = 0; i < sizeof( id ); i ++ )
        if ( intp( query( id[ i ] ) ) )
            result += query( id[ i ] );
    return result;
}
