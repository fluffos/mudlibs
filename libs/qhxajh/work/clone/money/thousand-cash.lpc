// thousand-cash.c   modified by lin on March 3,  1997
#include <ansi.h>
inherit MONEY;

void create() {
  set_name(HIW "一千两银票" NOR, ({ "thousand-cash", "thousand-cash_money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "thousand-cash");
    set("long", HIC "一张面额值一千两银子的银票。\n" NOR);
    set("unit", "叠");
    set("base_value", 1000000);
    set("base_unit", "张");
    set("base_weight", 1);
  }
  set_amount(1);
}
