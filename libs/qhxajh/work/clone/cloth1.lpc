#include <armor.h>
inherit CLOTH;
void create()
{
    set_name("青布衣衫", ({ "bu shan","shan", "cloth" }) );
    set_weight(400);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long","一件普普通通的布衫子.\n");
        set("unit", "套");
        set("material", "cloth");
        set("armor_prop/armor", 1);
    }
    setup();
}
