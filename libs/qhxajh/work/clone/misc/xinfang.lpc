int change_description(string owner_id) {
  string short, long;
  mapping desc;

  desc = query(owner_id);
  if (!desc) return 0;
  if (!undefinedp(desc["short"]))
    set("short", desc["short"]);
  if (!undefinedp(desc["long"]))
    set("long", desc["long"]);
  return 1;
}

void save_desc() {
  string owner_id = query_temp("owner_id");
  string long, short;
  mapping owner;
  long = query("long");
  short = query("short");
  owner = query("owner");
  restore();
  set(owner_id + "/long", long);
  set(owner_id + "/short", short);
  set("owner", owner);
  set("long", long);
  set("short", short);

  save();
}
