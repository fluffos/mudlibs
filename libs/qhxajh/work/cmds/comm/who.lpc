// who.c
// last modify 1997
// Qyz..增加一个关于family的敌人的信息。

#include <net/dns.h>
#include <ansi.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

mixed main(object me, string arg, int remote) {
  string name, str, *option, your_id, my_fam;
  object *list;
  int i, j, ppl_cnt, qtt;
  int opt_long, opt_id, opt_wiz, opt_enemy, opt_family;

  if (arg) {
    option = explode(arg, " ");
    i = sizeof(option);
    while (i--)
      switch (option[i]) {
        case "-l": opt_long = 1; break;
        case "-w": opt_wiz = 1; break;
        case "-e": opt_enemy = 1; break;
        case "-f": opt_family = 1; break;
        default: return notify_fail("指令格式：who [-l | -w | -e | -f]\n");
      }
  }

  if (opt_long) {
    if ((int)me->query("gin") < 30 && !wizardp(me))
      return notify_fail("你的精神太差了，没有办法得知其他玩家的详细资料。\n");
    me->receive_damage("gin", 10);
  }
  str = GRN "◎ " + mud_name() + "◎" NOR + " - 目前线上的";
  if (opt_wiz)
    str += "神仙有：\n";
  else if (opt_enemy)
    str += "本门公敌有：\n";
  else if (opt_family)
    str += "同门有：\n";
  else
    str += "玩家有：\n";
  str += "-------------------------------------------------------------------\n";
  list = users();
  if (opt_long || opt_wiz) {
    j = sizeof(list);
    while (j--) {
      // Skip those users in login limbo.
      if (!environment(list[j])) continue;
      if (!me->visible(list[j])) continue;
      if (opt_wiz && !wizardp(list[j])) continue;
      if (!wizardp(me))
        str = sprintf("%s %s %s\n", str,
          RANK_D->query_rank(list[j]), list[j]->short(1));
      else
        str = sprintf("%s %s %-30s %s\n", str, RANK_D->query_rank(list[j]),
          list[j]->short(1), list[j]->query("title"));
    }
  } else if (opt_enemy) {
    my_fam = me->query("family/family_name");
    if (!my_fam)
      return notify_fail("你现在还没有门派呢。\n");
    j = sizeof(list);
    while (j--) {
      // Skip those users in login limbo.
      your_id = list[j]->query("id");
      if (!FAMILY_D->is_family_enemy(my_fam, your_id)) continue;
      if (!qtt = (int)FAMILY_D->query_enemy_quantity(my_fam, your_id) / 100) continue;

      if (!environment(list[j])) continue;
      if (me && !me->visible(list[j])) continue;
      name = sprintf("%s(%s)", list[j]->name(1),
        capitalize(list[j]->query("id")));
      str = sprintf("%s%-25s仇恨度： %10s  点\n", str, name,
        chinese_number(qtt));
    }
  } else if (opt_family) {
    ppl_cnt = 0;
    my_fam = me->query("family/family_name");
    if (!my_fam)
      return notify_fail("你现在还没有门派呢。\n");
    j = sizeof(list);
    while (j--) {
      // Skip those users in login limbo.
      your_id = list[j]->query("id");
      if (!list[j]->is_tongmen_of(me)) continue;
      if (!environment(list[j])) continue;
      if (me && !me->visible(list[j])) continue;
      name = sprintf("%s(%s)", list[j]->name(1),
        capitalize(list[j]->query("id")));
      str = sprintf("%s%-25s%s", str, name,
        (ppl_cnt % 3 == 2 ? "\n" : ""));
      ppl_cnt++;
    }
    if (ppl_cnt % 3) str += "\n";
  }

  else {
    ppl_cnt = 0;
    j = sizeof(list);
    while (j--) {
      // Skip those users in login limbo.
      if (!environment(list[j])) continue;
      if (me && !me->visible(list[j])) continue;
      name = sprintf("%s(%s)", list[j]->name(1),
        capitalize(list[j]->query("id")));
      str = sprintf("%s%-25s%s", str, name,
        (ppl_cnt % 3 == 2 ? "\n" : ""));
      ppl_cnt++;
    }
    if (ppl_cnt % 3) str += "\n";
  }

  str += "-------------------------------------------------------------------\n";
  str = sprintf("%s共有 %d 位使用者连线中，系统负担：%s\n", str, sizeof(list),
    query_load_average() + "\n");

  if (remote) return str;

  me->start_more(str);
  return 1;
}

int sort_user(object ob1, object ob2) {
  if (wizardp(ob1) && !wizardp(ob2)) return -1;

  if (wizardp(ob2) && !wizardp(ob1)) return 1;

  if (wizardp(ob1) && wizardp(ob2))
    return (int)SECURITY_D->get_wiz_level(ob2) - (int)SECURITY_D->get_wiz_level(ob1);

  return (int)ob2->query("combat_exp") - (int)ob1->query("combat_exp");
}

int help(object me) {
  write(@HELP
指令格式 : who [-l | -w | -e | -f]

这个指令可以列出所有在线上的玩家。

-w 只列出线上所有的神仙。
-l 列出线上所有的玩家的详细信息。
-e 列出线上你所在门派的敌人。
-f 列出线上你的同门。

相关指令： finger
HELP
  );
  return 1;
}
