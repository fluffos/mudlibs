// localcmds.c

#include <Action.h>

inherit F_CLEAN_UP;


int main(object me, string arg)
{
	write("你身上及四周的物品与所在的环境提供以下指令：\n");
    foreach(class Action action in me->GetActions())
		printf("%-15s %-40O\n", action->verb, 
            find_object(action->ob));
	return 1;
}

int help()
{
	write(@TEXT
指令格式：localcmds

列出你身上及四周的物品与所在的环境提供的所有指令。
TEXT
	);
	return 1;
}

