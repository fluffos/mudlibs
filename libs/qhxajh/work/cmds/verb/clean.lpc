// clean.c

inherit F_CLEAN_UP;

int main(object me) {
  object env;
  string family, name;
  int times;

  env = environment(me);
  if (!me->can_act())
    return notify_fail("你现在腾不出功夫来扫地。\n");

  if (!family = env->query("need_clean"))
    return notify_fail("这里不用扫。\n");

  if (family != me->query("family/family_name"))
    return notify_fail("这是人家的地盘，用不着你来扫。\n");

  if (times = env->query_temp_marks("been_cleaned") >= 5)
    return notify_fail("这里已经被打扫得干干净净了。\n");

  if (name = env->query_temp_marks("being_cleaned"))
    return notify_fail("现在" + name + "已经在打扫了。\n");

  if (me->query("sen") < 40)
    return notify_fail("你现在体力不足，还是歇息一会再来扫吧。\n");

  me->disable_command("verb", "你正在扫地，还是先扫完再干别的吧。\n");
  message_vision("$N找了一把扫帚，慢慢地开始打扫起来。\n", me);

  env->set_temp_marks("being_cleaned", me->name());
  call_out("done_clean", 5, me, env);
  return 1;
}

int done_clean(object me, object env) {
  if (env == environment(me)) {
    message_vision("$N终于扫完了地，伸了伸腰，长吁了一口气。\n", me);
    me->receive_damage("sen", 25);
    me->add("class_score/" + me->query("family/family_name"), 1);
    me->enable_path();
    env->delete_temp_marks("being_cleaned");
    env->add_temp_marks("been_cleaned", 1);
    // lin 6.3 
    if (me->query("quest/quest") == "打扫" + env->query("short"))
      me->set("done_quest", "打扫" + env->query("short"));
    return 1;
  } else {
    env->delete_temp_marks("being_cleaned");
    return 1;
  }
}
