// sleep.c
#include <ansi.h>
void wakeup(object,object);
//void del_sleeped(object);

int main(object me, string arg)
{
	mapping fam;
	object where = environment(me);

        seteuid(getuid());
	if ( (!(fam = me->query("family")) || fam["family_name"] !=(string)where->query("sleep_room") )
             && where->query("sleep_room")!="inn" && !where->can_sleep( me ) )
             return notify_fail("这里不是让你睡的地方。\n");
 
        if ( environment(me)->query("wiz"))
                return notify_fail(HIR "这是属于神的房间，不能用来练功\n" NOR);
  
	if (me->is_busy())
		return notify_fail("你正忙着，怎么能睡觉呢。\n");

	if( me->is_fighting() )
		return notify_fail("战斗中不能睡觉！\n");
        
//	if (me->query_temp("sleeped"))
//	return notify_fail("你可不能整天睡觉呀，该出去活动活动了。\n");

        if (me->query_condition("sleeped"))
                return notify_fail("你可不能整天睡觉呀，该出去活动活动了。\n");


	if (where->query("sleep_room") || where->can_sleep( me ) )
	{
		write("你躺到自己的床上，闭上眼睛，开始睡觉。\n");
		write("不一会儿，你就进入了梦乡。\n");
		me->set_temp("block_msg/all",1);
		message_vision("$N一歪身，倒在床上，不一会便鼾声大作，进入了梦乡。\n",me);
	}

	where->set("no_fight", 1);
	where->add_temp("sleeping_person", 1);

	me->set("no_get", 1);	
	me->set("no_get_from", 1);

//	me->set_temp("sleeped",1);
	me->disable_player("<睡梦中>");
	call_out("wakeup",random(90 - me->query("con")), me, where);
	return 1;
}

void wakeup(object me,object where)
{
	me->set("kee",    me->query("eff_kee"));
	me->add("gin", (me->query("eff_gin") - me->query("gin"))*2/3 );
	me->add("sen",(me->query("eff_sen") - me->query("sen"))*2/3 );
	if( (int)me->query("force") < (int)me->query("max_force") )
	me->add("force", (me->query("max_force") - me->query("force"))/2 );
	me->enable_player();
  
        me->apply_condition("sleeped",12);
//      以避免有人利用QUIT来躲避延迟。
//	call_out("del_sleeped", 359, me);

	message_vision("$N一觉醒来，精力充沛地活动了一下筋骨。\n",me);
	me->set_temp("block_msg/all", 0);
	write("你一觉醒来，只觉精力充沛。该活动一下了。\n");

	if (!where->query("sleep_room") && !where->query("hotel"))
		where->delete("no_fight");
     
	where->add_temp("sleeping_person", -1);
	me->delete("no_get");	
	me->delete("no_get_from");	
 
}

//void del_sleeped(object me)
//{
//	if (objectp(me) &&  me->query_temp("sleeped"))
//		me->delete_temp("sleeped");
//}

int help(object me)
{
  write(@HELP
指令格式 : sleep
  睡觉是一个人生活中必不可少的一部分活动。当然，在XO中，睡觉
不可能象生活中一样占去你大量的时间。睡觉可以让玩家恢复体力和
精神等等参数，使自己的状态恢复到良好的水平。
  睡觉必须在特殊的房间中进行。对于每个门派，有自己的只许本门
派弟子使用的卧室；在城市中，则有所有玩家都可以使用的客房，但
大部分都是需要花钱的。
  
HELP
    );
    return 1;
}
