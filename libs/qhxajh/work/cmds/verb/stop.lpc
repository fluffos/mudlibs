// Filename : /cmds/std/stop.c

int main(object me, string arg) {
  // 顺序还是比较重要的
  if (me->is_duilianing()) {
    message_vision("$N猛地一收招，向后跳开半步，停手不练了。\n", me);
    me->remove_all_duishou();
  } else if (me->is_fighting()) {
    me->remov_all_bihua();
    me->remove_all_enemy();
    message_vision("$N向后一跃，跳出战圈不打了。\n", me);
  } else if (me->is_lianing()) {
    message_vision("$N气收丹田，停止了练习。\n", me);
    me->stop_lian();
  } else if (!me->is_busy())
    return notify_fail("你现在不忙。\n");

  me->interrupt_me();
  return 1;
}


int help(object me) {
  write(@HELP
指令格式 : stop

这个指令用来把你从一个持续的动作中解放出来。

相关指令 : lian

HELP
  );
  return 1;
}
