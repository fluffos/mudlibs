// kill.c
// rewrited by qyz

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object obj;
	string *killer, callname;

    if ( environment(me)->query("wiz"))
        return notify_fail(HIR "这是属于神的房间，不能用来练功\n" NOR);

	if ( environment(me)->query("no_fight") )
		return notify_fail("这里不准战斗。\n");

    if ( environment(me)->query("no_kill") )
    {
        if ( environment(me)->query("no_kill") == 1 )
            return notify_fail("这里不准杀人。\n");
//        else
//            tell_object(me,"大庭广众之下杀人不太好吧？\n");
    }

	if ( !arg )
		return notify_fail("你想杀谁？\n");

	if ( !objectp(obj = present(arg, environment(me))) )
		return notify_fail("看清楚些，这里没有这个人。\n");

	if ( !obj->is_character() || obj->is_corpse() )
		return notify_fail("看清楚一点，那并不是活物。\n");

	if ( obj == me )
		return notify_fail("用 suicide 指令会比较快。:P\n");

    if ( me->query_lianing() )
        return notify_fail("练习时就想杀人，呵呵，你真行。\n");

    if ( me->is_duanling() )
        return notify_fail("等对练结束了再杀人也不迟嘛。\n");

	callname = RANK_D->query_rude(obj);

	message_vision("\n$N对着$n喝道：「" 
		+ callname + "！今日不是你死就是我活！」\n\n", me, obj);
    if ( userp(obj) )
    {
        // 对于在xiulian中现在可以stop就让player自己stop
        /*
        if ( obj->query_temp("mask_exercising") )
        {
            int gin = obj->query("gin");
            obj->set("force", 0);
            obj->receive_damage("gin", gin / 2);
            obj->delete_temp("mask_exercising");
            obj->interrupt_me();
            message_vision(HIR"$N匆忙地站起身应战，但气力已是大减！\n"NOR,
                obj );
            obj->start_busy( random( 5 ) );
        } */
        me->kill_ob( obj );
        obj->fight_ob( me );
        // 如果是动物, 怎么还能是"这个人"呢?
        if ( !obj->is_killing( me->query( "id" ) ) )
            tell_object( obj, HIR"看来" + me->query("name") +
                "想杀死你，你如果想跟这个人性命相搏，不死不休,请你也对\n"
                "这个人下一个 kill 指令\n"NOR );
	    return 1;
    }
    else if ( !userp(obj) )
    {
        if ( obj->refuse_killing(me) ) 
            return 1;
        //return notify_fail("看来你是无法再出手了.\n"); 
        me->kill_ob( obj );
        obj->kill_ob( me );
    }
    return 1;
}

int help(object me)
{
    write(@HELP
指令格式 : kill <某人> | sha <某人>
 
这个指令让你主动开始攻击一个人物，并且尝试杀死对方，由于 kill 只需要单方
面一厢情愿就可以成立，因此你对任何人使用 kill 指令都会开始战斗，通常如果
对方是 NPC 的话，他们也会同样对你使用 kill。

当有人对你使用 kill 指令时会出现红色的字样警告你，对于一个玩家而言，如果
你没有对一名敌人使用过 kill 指令，你将会反击直到将敌人打昏为止，当然，也
可能存在失手将对方打死的可能性。

其他相关指令: bihua( tiaozhan ), duilian, qiecuo( fight ) 

HELP
    );
    return 1;
}
 
