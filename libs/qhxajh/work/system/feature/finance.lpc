// can_afford() checks if this_object() can afford a price, it returns:
//
//      0:      cannot afford.
//      1:      can afford with proper money(coins).
//      2:      如果身上的硬通货不够，但是有银票 return 2。
//
int can_afford(int amount)
{
	int total;
    object gold, silver, coin, cash, this;

    this = this_object();
    gold = present("gold_money", this);
    silver = present("silver_money", this);
    coin = present("coin_money", this);
    cash = present("thousand-cash_money", this);

    total = 0;
    if ( gold ) total += gold->value();
    if ( silver ) total += silver->value();
    if ( coin ) total += coin->value();

    if ( total < amount )
    {
        if ( cash ) return 2;
        else return 0;
    }

    return 1;
}

int pay_money(int amount)
{
    int total, gn, sn, cn;
    object gold, silver, coin, this;

    this = this_object();
    gold = present("gold_money");
    silver = present("silver_money");
    coin = present("coin_money");

    total = 0;
    if ( gold ) total += gold->value();
    if ( silver ) total += silver->value();
	if ( coin ) total += coin->value();

	if ( total < amount ) return 0;

    total -= amount;

	gn = total /10000;
	total -= gn * 10000;
	sn = total /1000;
	cn = total - sn * 1000;

	if ( gold ) gold->set_amount(gn);
	else if ( gn )
    {
    	gold = new( CLONE_DIR + "money/gold" );
    	gold->set_amount( gn );
    	gold->move( this );    
    }
	if ( silver ) silver->set_amount(sn) ;
	else if ( sn > 0  )
    {
    	silver = new( CLONE_DIR + "money/silver" );
    	silver->set_amount( sn );
    	silver->move( this );
    }
	if ( coin ) coin->set_amount(cn);
	else if ( cn > 0 )
    {
    	coin = new( CLONE_DIR + "money/coin" );
    	coin->set_amount( cn );
    	coin->move( this );
    }
    
	return 1;        

}

