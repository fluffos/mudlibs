// filename : /feature/command.c
//

#include <command.h>
#include <dbase.h>
#include <origin.h>
#include <options.h>

nosave int last_time;
nosave int last_count;
nosave string *path;

int force_me(string cmd);
nomask void disable_player(string);
nomask void enable_player();
nomask int valid_command(object, string);
nomask varargs void disable_command(string, string);
nomask void enable_path();
int can_act();
varargs void start_busy(mixed, mixed);

string find_command(string verb) {
  return (string)COMMAND_D->find_command(verb, path);
}

nomask int command_hook(string arg) {
  string verb, file;
  object env, this;
  this = this_object();

  if (userp(this) && !wizardp(this)) {
    if (time() - last_time == 0) {
      last_count++;
      if (last_count > MIN_COMMAND_LIMIT) {
        if (last_count > MAX_COMMAND_LIMIT) {
          log_file(COMMAND_LIMIT_LOG,
            sprintf("%s(%s)在(%s)输入权力被停止.\n",
              this->query("name"), this->query("id"),
              ctime(time())[4..18]));
          start_busy(2, "你输入指令太多，是机器人！！！\n");
          return 1;
        }
        return notify_fail("你输入的指令超过限制, 系统拒不接受.\n");
      }
    } else {
      last_time = time();
      last_count = 0;
    }
  }
  verb = query_verb();
  file = find_command(verb);
  if (stringp(file) && this_object()->query_temp_marks("is_riding") != 0) {
    string *file_name = explode(file, "/");
    if (file_name[1] == "verb") {
      switch (file_name[2]) {
        case "drink": case "drop": case "eat": case "follow":
        case "give": case "go": case "look": case "nod":
        case "remove": case "ride": case "shake": case "stop":
        case "talk": case "unwield": case "wear": case "wield":
          break;
        default:
          return notify_fail("你现在骑着一"
            +this_object()->query_temp_marks("is_riding")
            + "呢，无法做出这个动作！\n");
      }
    }
  }
  env = environment();
  if (!arg &&
    (env && stringp(env->query("exits/" + verb))) &&
    stringp(file = find_command("go")) &&
    valid_command(this, file) &&
    call_other(file, "main", this, verb)) {} else if (stringp(file = find_command(verb)) &&
    valid_command(this, file) &&
    call_other(
      file,
      "main",
      this,
      arg
    )) {} else if (EMOTE_D->do_emote(
    this,
    verb,
    arg
  )) {} else if (CHANNEL_D->do_channel(this, verb, arg)) {} else if (objectp(this) &&
    this->query_temp("disable_status") &&
    stringp(verb) &&
    find_command(verb)) {
    return notify_fail(this->query_temp("disable_status") + "\n");
  } else {
    return 0;
  }

  return 1;
}

nomask void set_path(string *p) {
  path = p;
}

string *query_path() { return path; }

int force_me(string cmd) {
  if (geteuid(previous_object()) != ROOT_UID)
    return 0;

  return command(this_object()->process_input(cmd));
}

nomask void enable_player() {
  string disable_path;
  disable_path = query_temp("disable_path");

  if (stringp(query("id")))
    set_living_name(query("id"));
  else
    set_living_name(query("name"));

  enable_commands();
  EnableCommands();
  add_action("command_hook", "", 1);
  last_time = time();
  last_count = 0;

  if (!userp(this_object())) {
    set_path(NPC_PATH);
  } else {
    switch (wizhood(this_object())) {
      case "(admin)":
        set_path(ADM_PATH);
        enable_wizard();
        break;

      case "(arch)":
        set_path(ARC_PATH);
        enable_wizard();
        break;

      case "(wizard)":
        set_path(WIZ_PATH);
        enable_wizard();
        break;

      case "(apprentice)":
        set_path(APR_PATH);
        enable_wizard();
        break;

      case "(immortal)":
        set_path(IMM_PATH);
        break;

      default:
        set_path(PPL_PATH);
        break;
    }
  }
}

nomask void disable_player(string type) {
  object prev, this;

  prev = previous_object();
  this = this_object();
  if (geteuid(prev) != ROOT_UID && prev != this)
    return;

  set("disable_type", type);
  disable_commands();
  DisableCommands();
}

nomask int valid_command(object this, string file) {
  mapping path_level = ([
    "comm": 1,
    "verb": 2,
    "skill": 3,
    "std": 1,
    "usr": 1,
    "imm": 1,
    "app": 1,
    "wiz": 1,
    "arch": 1,
    "adm": 1,
  ]);
  string path, cmd, disable_path;

  if (sscanf(file, "/cmds/%s/%s", path, cmd) != 2)
    return 0;
  disable_path = this->query_temp("disable_path");
  if (disable_path && path_level[path] >= path_level[disable_path])
    return 0;
  else
    return 1;
}

varargs nomask void disable_command(string path, string reason) {
  object this;
  this = this_object();
  this->set_temp("disable_path", path);
  if (reason)
    this->set_temp("disable_status", reason);
}

nomask void enable_path() {
  object this;
  this = this_object();
  this->delete_temp("disable_path");
  this->delete_temp("disable_status");
}

int can_act() {
  object this;
  this = this_object();
  if (!living(this)) return 0;
  if (this->is_busy() ||
    this->is_lianing() ||
    this->is_duilianing() ||
    this->is_fighting()) {
    return notify_fail("你现在正忙着呢。\n");
  }
  if (this->query_temp("disable_path") == "verb") {
    if (this->query_temp("disable_status")) {
      return notify_fail(this->query_temp("disable_status"));
    } else {
      return 0;
    }
  }
  return 1;
}
