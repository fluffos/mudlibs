// filename : /feature/name.c

#include <ansi.h>
#include <dbase.h>

mixed query_temp_marks(mixed);

nosave string *my_id;

string *query_id() {
  return my_id;
}

void set_name(string name, string *id) {
  set("name", name);
  set("id", id[0]);
  my_id = id;
}

int id(string str) {
  string *applied_id;
  object this, ppl;

  this = this_object();
  ppl = this_player();

  if (ppl && !ppl->visible(this)) return 0;

  applied_id = query_temp_marks("apply/id");
  if (pointerp(applied_id) && sizeof(applied_id))
    if (member_array(str, applied_id) != -1)
      return 1;
    else
      return 0;

  if (pointerp(my_id) && member_array(str, my_id) != -1)
    return 1;
  else
    return 0;
}

string *parse_command_id_list() {
  string *applied_id;

  applied_id = query_temp_marks("apply/id");
  if (pointerp(applied_id) && sizeof(applied_id))
    return applied_id;
  else
    return my_id;
}

varargs string name(int raw) {
  string str, *mask;

  mask = query_temp_marks("apply/name");
  if (!raw && sizeof(mask))
    return mask[sizeof(mask) - 1];
  else {
    str = query("name");
    if (stringp(str))
      return str;
    else
      return file_name(this_object());
  }
}

varargs string short(int raw) {
  string title, nick, str, *mask;
  object this;

  this = this_object();

  str = query("short");
  if (!stringp(str))
    str = name(raw) + "(" + capitalize(query("id")) + ")";

  if (!this->is_character()) return str;

  mask = query_temp_marks("apply/short");
  if (!raw && sizeof(mask))
    str = (string)mask[sizeof(mask) - 1];
  else {
    nick = query("nickname");
    if (stringp(nick))
      str = sprintf("「%s」%s", nick, str);
  }

  if (!raw) {
    if (this->is_ghost())
      str = HIB "(鬼气) " NOR + str;
    if (query_temp("netdead"))
      str += HIG " <断线中>" NOR;
    if (in_input())
      str += HIC " <输入文字中>" NOR;
    if (query_temp("mask_exercising"))
      str += HIG " <修炼中>" NOR;
    if (query_temp("mask/dazuo"))
      str += HIG " <修炼中>" NOR;
    if (in_edit())
      str += HIY " <编辑档案中>" NOR;
    if (interactive(this) && query_idle(this) > 120)
      str += HIM " <发呆中>" NOR;
    if (!living(this))
      str += HIR + query("disable_type") + NOR;
    if (this->query("race") == "人类" && !sizeof(mask)) {
      // if NPC has title, don't display zhiye
      if ((!userp(this)) && stringp(query("title"))) {
        if (this->query("title") != "")
          str = sprintf("%s %s", query("title"), str);
        else
          str = sprintf("%s", str);
      } else
        str = sprintf("%s %s", RANK_D->query_zhiye(this), str);
    }
  }
  return str;
}

varargs string long(int raw) {
  string str, extra, *mask;

  mask = query_temp_marks("apply/long");
  if (!raw && sizeof(mask))
    str = mask[sizeof(mask) - 1];


  else if (!stringp(str = query("long")))
    str = short(raw) + "。\n";

  extra = this_object()->extra_long();
  if (stringp(extra))
    str += extra;

  return str;
}
