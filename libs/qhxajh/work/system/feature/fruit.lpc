//filename : /system/featuer/fruit.c

#include <ansi.h>
#include <dbase.h>

int is_food()
{
    return 1;
}

int do_eat(string arg)
{
    mapping gifts;
    object me = this_player();
    object ob = this_object();
    object core;
    string msg, *list;
    int i, temp, sign;

    if ( !this_object()->id( arg ) ) return notify_fail("你要吃什么？\n");
    if ( !me->can_act() )
        return notify_fail( "你上一个动作还没有完成。\n" );
    if ( me->is_fighting() || me->is_duilianing() || me->is_lianing() )
        me->start_busy(2);
    if ( !query( "fruit_remaining" )  )
        return notify_fail( "你拿着这个" + ob->name() +
            "，看了半天觉得无处下嘴。\n");
    if ( (int)me->query("water") >= (int)me->max_food_capacity() ||
        (int)me->query("food") >= (int)me->max_water_capacity() )
    {
        if ( msg = query( "over_msg" ) )
            write( msg );
        else
            write("吃那么多？？真贪心，小心撑死了……\n");
        return 1;
    }
    add( "fruit_remaining", -1);
    set( "value", 0);
    if ( query( "fruit_remaining" ) )
    {
        me->add( "food" ,  query( "food_supply" ) );
        me->add( "water" , query( "water_supply" ) );

        if ( gifts = query("gifts") )
        {
            list = keys( gifts );
            for( i = 0; i < sizeof( list ); i ++ )
            {
                me->add( "hamlet_food/" + list[ i ],
                    query("gifts/" + list[ i ] ) );
                temp = me->query( "hamlet_food/" + list[ i ] );
                sign = ( temp > 0 ) ? 1 : -1 ;
                temp *= sign;
                if ( temp >= 1000  && random( 2000 - temp ) == 0 )
                {
                    me->set( "hamlet_food/" + list[ i ], 0 );
                    if ( me->query( list[ i ] ) >= 35
                        && sign > 0 )
                        sign = 0;
                    if ( me->query( list[ i ] ) <= 10
                        && sign < 0 )
                        sign = 0;
                    me->add( list[ i ] , sign );
                    tell_object( me, YEL
                        "由于你日常的饮食习惯而造成了你天赋的改变！\n"
                    NOR );
                }
            }
        }

        if ( msg = query( "eat_msg" ) )
            message_vision( msg, me, ob );
        else
            message_vision( RED"$N拿起$n，狠狠地咬了几口，大赞道：味道好极了！\n" NOR, me, ob);
    }
    else
    {
        if ( msg = query ("end_msg" ) )
            message_vision( msg , me, ob );
        else
            message_vision(RED"$N吃完最后一口$n，心满意足的说：真不错。\n", me,ob);
        if ( query("core") )
        {
            core = new( CLONE_DIR + "misc/core.lpc" );
            core->set_name(query("core"), query("core_id") );
            if ( query("core_unit") )
                core->set("unit", query("core_unit"));
            else
                core->set("unit", query("unit") );
            if ( query("core_long") )
                core->set("long", query("core_long") );
            core->move( environment( this_object() ) );
        }
        remove_call_out( "stats" );
        destruct( this_object() );
    }
    return 1;
}

int stats( int i )
{
    string base_long, base_name;
    object core, env;
    int life;

    if( !life = query( "life" )*240  ) return -1;
    
    switch ( i )
    {
        case 0:
            set("base_long", query("long") );
            set("base_name", query("name") );
            break;
        case 1:
            base_long = query("base_long");
            set("long",base_long+"，上面好象有些斑点，不过还不算显眼。\n");
            break;
        case 2:
            base_name = query("base_name");
            base_long = query("base_long");
            set("name","有点烂了的"+base_name );
            set("long",base_long+"，可惜已经开始烂了。\n");
            break;
        case 3:
            base_name = query("base_name");
            base_long = query("base_long");
            set("name", "烂" + base_name );
            set("long",base_long+"，可惜已经烂了，散发出一股异味。\n");
            break;
        default :
            if ( query("core") )
            {
                core = new( CLONE_DIR + "misc/core.lpc" );
                core->set_name(query("core"), query("core_id") );
                if ( query("core_unit") )
                    core->set("unit", query("core_unit"));
                else
                    core->set("unit", query("unit") );
                if ( query("core_long") )
                    core->set("long", query("core_long") );
                if ( env = environment( this_object() ) ) core->move( env );
            }
            tell_room( environment(this_object()),
               this_object()->query("name")+"终于完全烂掉了。\n" );
            destruct( this_object() );
            break;
    }
    return i;
}
