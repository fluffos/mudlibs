//qiang.c
//枪法
inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N将手中的$w一抖，大喝一声，直刺$n的$l",
    "lian":
    "$N将手中的$w一抖，双手紧握，奋力前刺。。",
    "jibie": 8,
    "sen": 1,
    "zhaoshi": "刺字诀",
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N双手紧握$w，看准目标，奋力向$n$l一刺.....",
    "lian":
    "$N双手紧握$w，猛地刺出......",
    "jibie": 16,
    "zhaoshi": "刺字诀",
    "sen": 1,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N手挽枪杆，将手中的$w挥舞起来,以枪杆作棒，「呼」地挥向$n的腰间",
    "lian":
    "$N双手将$w挥舞起来，「呼」地一声横扫而出",
    "zhaoshi": "挥字诀",
    "jibie": 24,
    "sen": 1,
    "limb": "腰间",
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N一抖手中的$w,枪尖一沉，猛地向上挑起，直打$n$l",
    "lian":
    "$N一抖手中的$w,枪尖一沉，猛地向上挑起",
    "zhaoshi": "挑字诀",
    "jibie": 32,
    "sen": 1,
    "damage_type": "划伤",
  ]),
  ([ "action":
    "$N横揽$w,勾身揽步，将$w倒转过来，向$n胸前刺去",
    "lian":
    "$N横揽$w,勾身揽步，将$w倒转过来，向前刺去",
    "zhaoshi": "点字诀",
    "jibie": 40,
    "limb": "胸前",
    "sen": 1,
    "damage_type": "瘀伤",
  ]),
});

string *parry_msg = ({
  "$n将手中的$w横揽在胸前，「当」的一声，将$N的$w挡开了\n",
  "$n$w抖成一团枪花，将$N的$w搅在其中....\n",
});

string *unarmed_parry_msg = ({
  "$n转身而退，避开$N的攻势，反手一招「回马枪」，反刺$N$l!\n",
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("weapon_type") != "qiang")
    return notify_fail("你必须用枪练枪法。\n");

  return 1;
}


string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

string query_xiuwei_type() { return "long"; }

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() { return 1; }

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 10; }


string query_weapon_type() {
  return "qiang";
}
