// Filename : /system/skill/sword.c
// 基本剑法

inherit SKILL;

mapping	* action=({
    ([	"action":"$N一招「仙人指路」，手中$w从中路直击而出",
    	"lian"  :"$N手中$w从中路直击而出",
		"jibie" :5, 
		"sen"   :1, 
        "damage_type":"刺伤"   ]),
    ([  "action":"$N手中$w化作几道剑光，向$n的$l急刺过去",
        "lian"  :"$N手中$w化作几道剑光，急刺出去",
		"jibie" :10, 
		"sen"   :1, 
        "damage_type":"刺伤"    ]),
    ([  "action":"$N左手捏了个剑诀，右手$w平平向$n眉心刺去",
        "lian"  :"$N左手捏了个剑诀，右手$w平刺而出",
		"jibie" :20, 
		"sen"   :1, 
        "damage_type":"刺伤"    ]),
    ([  "action":"$N身形一动，手中$w划了个圆圈，将$n团团围在中央",
        "lian"  :"$N身形一动，手中$w连划了几个圆圈",
		"jibie" :31, 
		"sen"   :1, 
        "damage_type":"刺伤"    ]),
    ([  "action":"$N猛一抖手中的$w，挽出一道剑花，把$n全身裹住",
        "lian"  :"$N猛一抖手中的$w，挽出一道剑花",
		"jibie" :42, 
		"sen"   :1, 
        "damage_type":"刺伤"    ]),
    ([  "action":"$N将手中长剑平平举起，划出一道圆弧，直向$n$l刺去",
        "lian"  :"$N将手中长剑平平举起，划出一道圆弧",
		"jibie" :53, 
		"sen"   :1, 
        "damage_type":"刺伤"    ]),
});

string *parry_msg = ({
    "$n把$v一横，架住了$N的$w。\n",
    "$n不避$N$w的锋芒，$v反刺出去，逼使$N中途收招。\n",
});

string *unarmed_parry_msg = ({
    "$n手中$v反刺而出，化解了$N的攻势。\n",
    "$p向旁边侧踏一步，$v一招横削，封住了破绽。\n",
});

int valid_learn(object me)
{
    return 1;
}

int valid_lian( object me )
{
	object weapon;

	weapon = me->query_temp( "weapon" );
    if ( !weapon || weapon->query("skill_type") != "sword" )
        return notify_fail("你必须先找一把剑才能练剑法。\n");

	return 1;
}

mapping query_action(int jibie)
{
	int i, size;

	size = sizeof( action );
	for ( i = 0; i < sizeof( action ); i++ )
		if ( action[ i ][ "jibie" ] > jibie )
		{
			size = i;
			break;
		}
    return action[ random( size ) ];
}

string query_xiuwei_type() { return "sword"; }

// 武功等级从一等到十等依次递增
// 返回这路武功的等级, 第一等返回 1, 第十等返回 10.
int query_dengji() { return 1; }

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie() { return 9; }
int query_parry_ratio() { return 9; }
