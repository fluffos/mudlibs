// Filename : /system/skill/jiben-qinggong.c

inherit SKILL;

mapping *action = ({
    ([ "action":"$n纵身一跳，闪身躲了开去。",
       "lian"  :"$N提气在胸，收腹提肩，纵身一越，只跳起二尺来高。",
       "jibie" :5,
       "sen"   :1, ]),
    ([ "action":"$n猛的一闪身，向后跳开数尺。",
       "lian"  :"$N以足尖点地，大步跨出数尺，险些扭伤了足踝。",
       "jibie" :10,
       "sen"   :1, ]),
    ([ "action":"$n双脚轻点，身形向后一退。",
       "lian"  :"$N提气丹田，平地拔起三尺。",
       "jibie" :20,
       "sen"   :1, ]),
    ([ "action":"$n轻飘飘地向旁边一闪，$N的凌厉攻势尽数落在了空里。",
       "lian"  :"$N把握住身体的平衡，借着踢腿的力量，向旁边一跃。",
       "jibie" :30,
       "sen"   :1, ]),
    ([ "action":"$n向高空里一纵身，跃起五尺来高。",
       "lian"  :"$N向高空里一纵身，跃起五尺来高。",
       "jibie" :40,
        "sen"  :1, ]),
    ([ "action":"$n用力一拔，从$N头上跃了过去。",
       "lian"  :"$N跃起五尺，在空中一个转折，轻轻落下地来。",
       "jibie" :50,
       "sen"   :1, ]),
    ([ "action":"$n低头侧身，蜷腿一纵，向旁边跃开七尺。",
       "lian"  :"$N低头侧身，蜷腿一纵，向旁边跃开七尺。",
       "jibie" :60,
       "sen"   :1, ]),
});

int valid_learn(object me)
{
	return 1;
}

int valid_lian(object me)
{
    int encu;
    encu = me->query_encumbrance() * 100 / me->query_max_encumbrance();
    if ( encu < 10 )
        return notify_fail("轻功必须负重练习。\n");
    return 1;
}

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
        {
            size = i;
            break;
        }
    return action[ random( size ) ];
}

string query_xiuwei_type() { return "dodge"; }

// 返回这路武功的等级, 第一等返回 1, 第十等返回 10.
int query_dengji() { return 1; }

