string select_start_room() {
  return start_rooms[random(sizeof(start_rooms))];
}

void log_login(object ob, object user, string format) {
  if (wiz_level(user->query("id")))
    log_file(WIZ_USAGE_LOG, sprintf(format,
      user->query("id"), user->query("name"),
      query_ip_name(ob), ctime(time())));
  else
    log_file(PPL_USAGE_LOG, sprintf(format,
      user->query("id"), user->query("name"),
      query_ip_name(ob), ctime(time())));
}

int new_random() {
  float base, u1, u2, n, N;

  N = -0.1;
  while (N < 0) {
    base = random(9999) + 1;
    u1 = base / 10000;
    base = random(9999) + 1;
    u2 = base / 10000;
    n = sqrt(-2 * log(u1)) * cos(2 * 3.1415 * u2);
    N = n * 4.7 + 10.5;
  }
  return to_int(N);
}

int select_max_age(object user) {
  int max_age;
  int per, Int, spi, con;

  per = user->query("per");
  Int = user->query("int");
  spi = user->query("spi");
  con = user->query("con");
  max_age = BASE_MAX_AGE + new_random();
  max_age -= (per - 20) / 3 + (Int - 20) / 3 + (spi - 20) / 3;
  max_age += con / 6;
  return max_age;
}

void replace_some_mark(object user) {
  if (user->query("family/family_name") == "无量剑派西宗") {
    user->set("no_kill", "west_wuliang");
  }
  if (user->query("class") == "bonze") {
    user->set("bonze");
  }
  if (!user->query("max_age")) {
    user->set("max_age", select_max_age(user));
  }
  if (user->query("title") == "镇南王府第二代弟子") {
    user->set("title", "镇南王府见习家丁");
  }
}

///////////////////////////////////////////////////////////////////////////////
// Internal Functions

private void read_config_file() {
  string file, *tmp, *tmp2;
  int i, j;

  banned_name = ({});
  file = read_file(BANNED_NAME);
  if (!file) return;

  tmp = explode(file, "\n");
  for (i = 0; i < sizeof(tmp); i++)
    if ((tmp[i][0] == '/') ||
      (tmp[i][0] == '\n') ||
      (tmp[i] == "")) {
      continue;
    } else {
      tmp2 = explode(tmp[i], " ");
      tmp[i] = implode(tmp2, "");
      tmp2 = explode(tmp[i], ",");
      for (j = 0; j < sizeof(tmp2); j++)
        banned_name += ({ tmp2[j] });
    }

  banned_id = ({});
  file = read_file(BANNED_ID);
  if (!file) return;

  tmp = explode(file, "\n");
  for (i = 0; i < sizeof(tmp); i++)
    if ((tmp[i][0] == '/') ||
      (tmp[i][0] == '\n') ||
      (tmp[i] == "")) {
      continue;
    } else {
      tmp2 = explode(tmp[i], " ");
      tmp[i] = implode(tmp2, "");
      tmp2 = explode(tmp[i], ",");
      for (j = 0; j < sizeof(tmp2); j++)
        banned_id += ({ tmp2[j] });
    }
}

private void read_multi_allow_file() {
  string file, ip, id_list;
  string *tmp, *tmp2;
  int i;

  multi_allow = ([]);
  file = read_file(MULTI_ALLOW);
  if (!file) return;

  tmp = explode(file, "\n");
  for (i = 0; i < sizeof(tmp); i++)
    if ((tmp[i][0] == '#') ||
      (tmp[i][0] == '\n') ||
      (tmp[i] == "")) {
      continue;
    } else {
      sscanf(tmp[i], "%s:%s", ip, id_list);
      tmp2 = explode(id_list, " ");
      id_list = implode(tmp2, "");
      tmp2 = explode(id_list, ",");
      multi_allow[ip] = tmp2;
    }
  //printf( "multi_allow %O\n", multi_allow );
}

void update_user_ip() {
  object *all;
  int i;
  string ip;

  remove_call_out("update_user_ip");
  call_out("update_user_ip", USER_IP_UPDATE_TIME);
  user_ip = ([]);
  all = users();
  for (i = 0; i < sizeof(all); i++) {
    ip = query_ip_number(all[i]);
    if (!user_ip[ip])
      user_ip[ip] = ({ all[i]->query("id") });
    else
      user_ip[ip] += ({ all[i]->query("id") });
  }
  //printf( "user_ip %O\n", user_ip );
}

void read_revise_file() {
  string file, old_skill, new_skill;
  string *tmp;
  int i;

  skill_revise = ([]);
  file = read_file(SKILL_REVISE);
  if (!file) return;

  tmp = explode(file, "\n");
  for (i = 0; i < sizeof(tmp); i++)
    if ((tmp[i][0] == '#') ||
      (tmp[i][0] == '\n') ||
      (tmp[i] == "")) {
      continue;
    } else {
      sscanf(tmp[i], "%s:%s", old_skill, new_skill);
      skill_revise[old_skill] = new_skill;
    }
  //printf( "skill revise: %O\n", skill_revise );
}

void revise_illegal_data(object user) {
  int i, jibie, lingwu, jilei;
  string *old_skills;

  old_skills = keys(skill_revise);
  for (i = 0; i < sizeof(old_skills); i++) {
    jibie = user->query_jibie(old_skills[i]);
    if (jibie) {
      lingwu = user->query_lingwu(old_skills[i]);
      jilei = user->query_jilei(old_skills[i]);
      user->delete_wugong(old_skills[i]);
      user->set_wugong(skill_revise[old_skills[i]],
        jibie, lingwu);
      user->set_jilei(old_skills[i], jilei);
    }
  }

  user->delete_wugong("force");
  user->delete_wugong("parry");
  if (user->query("class") == "bonze")
    user->set("marks/leonhart/和尚", 1);
  user->save();
}
