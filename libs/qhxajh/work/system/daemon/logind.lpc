// Filename : /system/daemon/logind.c

#include <ansi.h>
#include <command.h>
#include <login.h>
#include <options.h>

#define BANNED_NAME     SYSTEM_CONFIG_DIR "banned_name"
#define BANNED_ID       SYSTEM_CONFIG_DIR "banned_id"
#define MULTI_ALLOW     SYSTEM_CONFIG_DIR "multi_allow"
#define SKILL_REVISE    SYSTEM_CONFIG_DIR "skill_revise"

inherit F_DBASE;

int wiz_lock_level = WIZ_LOCK_LEVEL;
int startup_time;

// 允许 multi_login 的登记表
mapping multi_allow;
// 目前的 IP 与 ID 的对应表
mapping user_ip;

mapping skill_revise;

string *banned_name;
string *banned_id;
string *start_rooms = ({
  "/d/nanyang/beimen",
});

private void replace_some_mark(object user);
private int select_max_age(object user);
private void read_config_file();
private void read_multi_allow_file();
private void read_revise_file();
private void update_user_ip();
private void get_id(string arg, object ob);
private void confirm_id(string yn, object ob);
private void check_double_login(object user);
private void init_new_player(object user);
private void revise_illegal_data(object user);

// 这些函数会被其他模块调用吗？
varargs void enter_world(object ob, object user, int silent);
varargs void reconnect(object ob, object user, int silent);
object find_body(string name);
object make_body(object ob);
int check_legal_id(string arg);
int check_legal_name(string arg);
int new_random();
string select_start_room();
void log_login(object ob, object user, string format);

void create() {
  seteuid(getuid());
  set("channel_id", "连线精灵");
  read_config_file();
  read_multi_allow_file();
  read_revise_file();
  update_user_ip();
  startup_time = time();
}

void logon(object ob) {
  object *usr;
  int i, wiz_cnt, ppl_cnt, login_cnt;
  int t, d, h, m, s;
  string time;

  if (time() - startup_time < NO_LOGIN_LIMIT_TIME) {
    printf(YEL "对不起，为了系统稳定，请在系统起动 %d 秒后再登录。\n" NOR
      , NO_LOGIN_LIMIT_TIME);
    destruct(ob);
    return;
  }

  if (BAN_D->is_banned(query_ip_name(ob))) {
    printf(YEL "对不起，你的 IP 在ＸＯ不受欢迎。如果有任何疑问，\n"
      "请用电子邮件联系 zhc@bjnet.edu.cn ！\n");
    destruct(ob);
    return;
  }

  cat(WELCOME);

  if (wiz_lock_level > 0)
    write(RED "           >>> 本ＭＵＤ暂时关闭，只有巫师等级" +
      chinese_number(wiz_lock_level) + "的玩家可以连线。 <<<\n" NOR);

  t = uptime();
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d)
    time = chinese_number(d) + "天";
  else
    time = "";

  if (h)
    time += chinese_number(h) + "小时";
  if (m)
    time += chinese_number(m) + "分";
  if (time == "")
    write(mud_name() + "刚起动" + "，");
  else
    printf(mud_name() + "已经运行了" + time + "，");

  usr = users();
  wiz_cnt = 0;
  ppl_cnt = 0;
  login_cnt = 0;
  for (i = 0; i < sizeof(usr); i++) {
    if (!environment(usr[i]))
      login_cnt++;
    //else if ( wizardp(usr[i]) )
    //	wiz_cnt++;
    else
      ppl_cnt++;
  }
  printf(HIR "目前共有 %d 位玩家在这个世界中。\n\n", ppl_cnt);
  //    printf(HIR "目前共有 %d 位神仙、%d 位凡人在这个世界中。\n\n",
  //    	wiz_cnt, ppl_cnt );
  //    printf("目前共有 %d 位神仙、%d 位凡人在这个世界，以及 %d 
  //位使用者尝试连线中。\n\n",
  //    	wiz_cnt, ppl_cnt, login_cnt );

  write(CYN "您的英文名字：" NOR);
  input_to("get_id", ob);
}

private void get_id(string arg, object ob) {
  object ppl;
  string my_ip;

  arg = lower_case(arg);
  if (!check_legal_id(arg)) {
    write(CYN "您的英文名字：" NOR);
    input_to("get_id", ob);
    return;
  }

#ifdef MAX_USERS
  if ((string)SECURITY_D->get_status(arg) == "(player)" &&
    sizeof(users()) >= MAX_USERS) {
    ppl = find_body(arg);

    // Only allow reconnect an interactive player when MAX_USERS exceeded.
    if (!ppl || !interactive(ppl) || !wizardp(ob)) {
      write(YEL "对不起，" + MUD_NAME + "的使用者已经太多了，请待会再来。\n" NOR);
      destruct(ob);
      return;
    }
  }
#endif

#ifdef ALLOW_MULTI_LOGIN
  // 检查 multi_login
  my_ip = query_ip_number(ob);
  //printf( "my_ip %s\n", my_ip );
  if (SECURITY_D->get_status(arg) == "(player)") {
    //printf( "%O\n%O\n", user_ip[ my_ip ], multi_allow[ my_ip ] );
    if (user_ip[my_ip] &&
      (member_array(arg, user_ip[my_ip]) == -1)) {
      if (!multi_allow[my_ip] ||
        (member_array(arg, multi_allow[my_ip]) == -1)) {
        printf(YEL "ＸＯ禁止 multi_login，请 help player_rules！\n");
        destruct(ob);
        return;
      }
    }
    if (!user_ip[my_ip])
      user_ip[my_ip] = ({ arg });
    else
      user_ip[my_ip] += ({ arg });
  }
#endif // ALLOW_MULTI_LOGIN

  if (wiz_level(arg) < wiz_lock_level && !ALLOW_D->is_allowed(arg)) {
    write(RED "对不起，" + MUD_NAME + "目前限制神仙等级 " +
      wiz_lock_level + " 以上的人才能连线。\n" NOR);
    destruct(ob);
    return;
  }

  if ((string)ob->set("id", arg) != arg) {
    write(RED "Failed setting user name.\n" NOR);
    destruct(ob);
    return;
  }

  if (arg == "guest") {
    // If guest, let them create the character.
    confirm_id("Yes", ob);
    return;
  } else if (file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0) {
    if (ob->restore()) {
      write(BLU "请输入您的密码：" NOR);
      input_to("get_passwd", 1, ob);
      return;
    }
    write(YEL "您的角色存盘数据出了问题，请利用 guest 通知神仙处理。\n" NOR);
    destruct(ob);
    return;
  }

  write(YEL "使用 " + (string)ob->query("id") +
    " 这个名字将会在笑傲江湖中创造一个新的生命，\n您确定吗(y/n)？" NOR);
  input_to("confirm_id", ob);
}

private void get_passwd(string pass, object ob) {
  string my_pass, msg;
  object user;

  write("\n");
  my_pass = ob->query("password");
  if (crypt(pass, my_pass) != my_pass) {
    if (wiz_level(ob->query("id"))) {
      msg = sprintf("%s error login at %s from %s\n",
        ob->query("id"), ctime(time()), query_ip_number(ob));
      log_file(WIZ_LOGIN_ERR_LOG, msg);
    }
    write("密码错误！\n");
    destruct(ob);
    return;
  }

  // Check if we are already playing.
  user = find_body(ob->query("id"));
  if (user) {
    if (user->query_temp("netdead")) {
      reconnect(ob, user);
      return;
    }
    write(YEL "您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)" NOR);
    input_to("confirm_relogin", ob, user);
    return;
  }

  user = make_body(ob);
  if (objectp(user)) {
    if (user->restore()) {
      log_login(ob, user, "%s(%s) loggined from %s (%s)\n");
      enter_world(ob, user);
      //revise_illegal_data( user );
      return;
    } else {
      write(YEL "您的角色存盘数据出了问题，请利用 guest 通知神仙处理。\n" NOR);
      destruct(user);
    }
  }
  write(HIW "请您重新创造这个人物。\n" NOR);
  confirm_id("y", ob);
}

private void confirm_relogin(string yn, object ob, object user) {
  object old_link;

  if (yn == "") {
    write(YEL "您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)" NOR);
    input_to("confirm_relogin", ob, user);
    return;
  }

  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("好吧，欢迎下次再来。\n");
    destruct(ob);
    return;
  } else {
    tell_object(user, HIW "有人从别处( " + query_ip_number(ob)
      + " )连线取代你所控制的人物。\n" NOR);
    log_login(ob, user, "%s(%s) replaced by %s (%s)\n");
  }

  // Kick out tho old player.
  old_link = user->query_temp("link_ob");
  if (old_link) {
    exec(old_link, user);
    destruct(old_link);
  }

  reconnect(ob, user);
}

private void confirm_id(string yn, object ob) {
  if (yn == "") {
    write(YEL "使用这个名字将会在笑傲江湖中创造一个新的生命，您确定吗(y/n)？" NOR);
    input_to("confirm_id", ob);
    return;
  }

  if (yn[0] != 'y' && yn[0] != 'Y') {
    write(HIW "好吧，那麽请重新输入您的英文名字：" NOR);
    input_to("get_id", ob);
    return;
  }

  write(MAG @TEXT

    那么请您为您即将在XO MUD里使用的新生命起一个中文名字吧!!您
可以用这个名字赋予他（她）与众不同的个性和气质。要注意，您起的
名字不要太古怪，不要金庸小说里人物的名字，更不要取一些不雅或容
易造成他人困惑的名字，否则XO将视情况要求你修改你的名字。
TEXT);
  write(HIR "    名字一旦输入就终生不能再自行修改，请务必慎重。\n\n" NOR);
  write(HIW "您的中文名字：" NOR);
  input_to("get_name", ob);
}

private void get_name(string arg, object ob) {
  if (!check_legal_name(arg)) {
    write(HIW "您的中文名字：" NOR);
    input_to("get_name", ob);
    return;
  }

  //printf("%O\n", ob);
  ob->set("name", arg);
  write(HIW "请设定您的密码：" NOR);
  input_to("new_password", 1, ob);
}


private void new_password(string pass, object ob) {
  write("\n");
  if (strlen(pass) < 6) {
    write(HIY "密码的长度至少要六个字符，请重设您的密码：" NOR);
    input_to("new_password", 1, ob);
    return;
  }
  ob->set("password", crypt(pass, 0));
  write(HIW "请再输入一次您的密码，以确认您没记错：" NOR);
  input_to("confirm_password", 1, ob);
}

private void confirm_password(string pass, object ob) {
  string old_pass;

  write("\n");
  old_pass = ob->query("password");
  if (crypt(pass, old_pass) != old_pass) {
    write(HIW "您两次输入的密码并不一样，请重新设定一次密码：" NOR);
    input_to("new_password", 1, ob);
    return;
  }

  write(HIW "您的电子邮件地址：" NOR);
  input_to("get_email", ob);
}

private void get_email(string email, object ob) {
  object user;

  ob->set("email", email);

  // If you want do race stuff, ask player to choose one here, then you can
  // set the user's body after the question is answered. The following are
  // options for player's body, so we clone a body here.
  ob->set("body", USER_OB);
  user = make_body(ob);
  if (!objectp(user))
    return;

  write(HIW "您要扮演男性(m)的角色或女性(f)的角色？" NOR);
  input_to("get_gender", ob, user);
}

private void get_gender(string gender, object ob, object user) {
  if (gender == "") {
    write(YEL "您要扮演男性(m)的角色或女性(f)的角色？" NOR);
    input_to("get_gender", ob, user);
    return;
  }

  if (gender[0] == 'm' || gender[0] == 'M')
    user->set("gender", "男性");
  else if (gender[0] == 'f' || gender[0] == 'F')
    user->set("gender", "女性");
  else {
    write(YEL "对不起，您只能选择男性(m)或女性(f)的角色：" NOR);
    input_to("get_gender", ob, user);
    return;
  }

  log_login(ob, user, "%s(%s) was created from %s (%s)\n");
  init_new_player(user);
  enter_world(ob, user);
}

object make_body(object ob) {
  string err;
  object user;
  int n;

  user = new(ob->query("body"));
  if (!user) {
    write("现在可能有人正在修改使用者对象的程序，无法进行复制。\n");
    write(err + "\n");
    return 0;
  }
  seteuid(ob->query("id"));
  export_uid(user);
  export_uid(ob);
  seteuid(getuid());
  user->set("id", ob->query("id"));
  user->set_name(ob->query("name"), ({ ob->query("id") }));
  return user;
}

private void init_new_player(object user) {
  user->set("title", "普通百姓");
  user->set("birthday", time());

  user->set("str", 10 + new_random());
  user->set("cps", 10 + new_random());
  user->set("int", 10 + new_random());
  user->set("cor", 10 + new_random());
  user->set("con", 10 + new_random());
  user->set("spi", 10 + new_random());
  user->set("per", 10 + new_random());
  user->set("kar", 10 + new_random());
  user->set("dex", 10 + new_random());

  user->set("food", ((int)user->query("str") + 10) * 10);
  user->set("water", ((int)user->query("str") + 10) * 10);

  user->set("channels", ({ "chat", "rumor", "family" }));
  user->set("max_age", select_max_age(user));
  //  user->set("social_exp", 50);
  //  user->set("combat_exp", 100);
}

varargs void enter_world(object ob, object user, int silent) {
  object cloth, room;
  string startroom, temp;

  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);
  exec(user, ob);

  write("目前权限：" + wizhood(user) + "\n");
  user->setup();

  // In case of new player, we save them here right aftre setup 
  // compeleted.
  user->save();
  ob->save();
  user->set("last_save_time", time());  // autosave requires.

  cloth = new("/clone/cloth1");
  cloth->move(user);
  cloth->wear();

  if (!silent) {
    cat(MOTD);
    if (wizardp(user)) {
      cat(SYSTEM_CONFIG_DIR "wizmotd");
    }
    if (user->is_ghost() && !wizardp(user))
      startroom = DEATH_ROOM;
    else if (!stringp(startroom = user->query("startroom"))) {
      startroom = select_start_room();
      rm(LOG_D->query_log_file(user->query("id")));
      LOG_D->do_log(user, sprintf("你充满传奇色彩的一生就从%s开始。",
        load_object(startroom)->query("short")));
    }

    if (catch(load_object(startroom))) {
      startroom = select_start_room();
      user->set("startroom", startroom);
    }
    user->move(startroom);
    replace_some_mark(user);
    MARRY_D->check_will_marry(user);
    MARRY_D->check_marriage(user);
    tell_room(startroom, user->query("name") +
      "连线进入这个世界。\n", ({ user }));
  }

  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s(%s)由%s连线进入。", user->name(), geteuid(user), query_ip_name(user)));

  check_double_login(user);
}

varargs void reconnect(object ob, object user, int silent) {
  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);
  exec(user, ob);

  user->reconnect();
  if (!silent) {
    tell_room(environment(user), user->query("name") +
      "重新连线回到这个世界。\n", ({ user }));
  }
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s(%s)由%s重新连线进入。", user->query("name"),
      geteuid(user), query_ip_name(user)));
  check_double_login(user);
  UPDATE_D->check_user(user);
}

int check_legal_id(string id) {
  int i;
  string file_name;

  i = strlen(id);

  if ((strlen(id) < 3) || (strlen(id) > 12)) {
    write("对不起，你的英文名字必须是 3 到 12 个英文字母。\n");
    return 0;
  }
  while (i--)
    if (id[i] < 'a' || id[i] > 'z') {
      write("对不起，你的英文名字只能用英文字母。\n");
      return 0;
    }

  if (member_array(id, banned_id) != -1) {
    file_name = sprintf(DATA_DIR "user/%c/%s", id[0], id);
    if (file_size(file_name + __SAVE_EXTENSION__) >= 1) {
      write("你的帐号暂时被封了，请用quest登陆。\n");
      return 0;
    }
    write("对不起，这种英文名字会造成其他人的困扰。\n");
    return 0;
  }
  return 1;
}

int check_legal_name(string name) {
  int i;

  i = strlen(name);

  if ((strlen(name) < 2) || (strlen(name) > 5)) {
    write("对不起，你的中文名字必须是 2 到 5 个中文字。\n");
    return 0;
  }
  while (i--) {
    if (name[i] <= ' ') {
      write("对不起，你的中文名字不能用控制字元。\n");
      return 0;
    }
    if (i % 2 == 0 && !is_chinese(name[i..<0])) {
      write("对不起，请您用「中文」取名字。\n");
      return 0;
    }
  }

  if (member_array(name, banned_name) != -1) {
    write("对不起，这种名字会造成其他人的困扰。\n");
    return 0;
  }
  return 1;
}

object find_body(string name) {
  object ob, *body;

  ob = find_player(name);
  if (objectp(ob)) return ob;
  body = children(USER_OB);
  for (int i = 0; i < sizeof(body); i++)
    if (clonep(body[i]) && getuid(body[i]) == name)
      return body[i];

  return 0;
}

int set_wizlock(int level) {
  if (wiz_level(this_player(1)) <= level)
    return 0;
  if (geteuid(previous_object()) != ROOT_UID)
    return 0;
  wiz_lock_level = level;
  return 1;
}

