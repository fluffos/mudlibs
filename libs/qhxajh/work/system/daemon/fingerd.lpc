#include <net/dns.h>

void create()
{
	seteuid( getuid() );
}

string age_string(int time)
{
	int month, day, hour;

	time /= 3600;
	hour = time % 24;
	time /= 24;
	day = time % 30;
	month = time / 30;
	return (month?month + "m":"") + (day?day + "d":"") + hour + "h";
}

object *check_dup_ip(object the_user)
{
	object *usr, *usr1;
	int i, num_dup = 0, j = 0;
	
	string the_user_ip = query_ip_name(the_user);
	usr = users();
	
	for ( i = 0; i < sizeof( usr ); i++ )
		if ( the_user_ip == query_ip_name( usr[i] ) )
			num_dup++;
	
	if ( num_dup <= 1 )
        return 0;
	else
        num_dup --;

	usr1 = allocate(num_dup);
	
	for ( i = 0; i < sizeof(usr); i++ )
		if ( the_user_ip == query_ip_name(usr[i]) && the_user != usr[i] )
			usr1[ j++ ] = usr[i];
	
	return usr1;
}

string finger_all()
{
	object *ob, me;
	string msg;
	int i;

	ob = users();
	msg = "";
	me = this_player();
	for ( i = 0; i < sizeof( ob ); i++ )
	{
		if ( me && !me->visible(ob[i]) )
			continue;
		if ( wizardp(me) )
			msg = sprintf("%s%-20s  %-20s  %-10s %s\n",
				msg, ob[i]->query("name"), ob[i]->query("id"),
				age_string( (int)ob[i]->query("mud_age")),
				query_ip_name(ob[i]) );
		else msg = sprintf("%s%-20s  %-20s \n",
				msg, ob[i]->query("name"), ob[i]->query("id"),);
	}
	return msg;
}

string finger_user(string name)
{
	object ob, body, *usr,me;
	string msg, mud;
	int i;

    
	if ( sscanf(name, "%s@%s", name, mud) == 2 )
	{
		GFINGER_Q->send_finger_q(mud, name, this_player(1));
		return "网路指令传送过程可能需要一些时间，请稍候。\n";
	}

	me = this_player();
	ob = new(LOGIN_OB);
	ob->set("id", name);
	if ( !ob->restore() )
    {
        destruct( ob );
		return "没有这个玩家。\n";
    }
	msg =  sprintf( "\n英文代号：\t%s\n姓    名：\t%s\n权限等级：\t%s\n上次连线时间：\t%s\n",
		ob->query("id"),
		ob->query("name"),
		SECURITY_D->get_status(name),
 		ctime(ob->query("last_on")) );

	if ( wizardp(me) )
		msg += sprintf("电子邮件地址：\t%s\n上次连线地址：\t%s\n",
				ob->query("email"),
				ob->query("last_from") );
		
	body = find_player( name );

	if ( objectp( body ) && geteuid( body ) == name )
	{
		if ( wizardp(me) )
        {
			msg += sprintf( "\n%s目前正在从 %s 连线中。\n",
			        body->name(1), query_ip_name(body) );
	
            /*	
			usr = check_dup_ip(body);

			if ( arrayp(usr) )
            {
				msg += sprintf("\n发现以下用户与其从同一地址(%s)连线：\n",
						query_ip_name(body));
				msg += sprintf("姓名          帐号          年龄          发呆	上次连线地址\n");
				for ( i = 0; i < sizeof(usr); i++ )
					msg += sprintf("%-14s%-14s%-14s%-7s%s\n",
						usr[i]->query("name"), usr[i]->query("id"),
						FINGER_D->age_string( (int)usr[i]->query("mud_age")), 
						query_idle(usr[i])+ "秒",
						(string)usr[i]->query_temp("link_ob")->query("last_from") );
			}
            */
		}
		else
		    msg += sprintf( "\n%s目前正在连线中。\n",body->name(1));
	}

	destruct( ob );
	return msg;
}

varargs string remote_finger_user(string name, int chinese_flag)
{
	object ob, body;
	string msg;

	ob = new(LOGIN_OB);
	ob->set("id", name);
	if ( !ob->restore() )
		return chinese_flag ? "没有这个玩家。\n" : "No such user.\n";
	if ( chinese_flag )
		msg = sprintf( "\n英文代号：\t%s\n姓    名：\t%s\n权限等级：\t%s\n"
				"电子邮件地址：\t%s\n上次连线地址：\t%s( %s )\n\n",
				ob->query("id"), ob->query("name"),
				SECURITY_D->get_status(name), ob->query("email"),
				ob->query("last_from"), ctime(ob->query("last_on")) );
	else
		msg =  sprintf(
			"\nName\t: %s\nStatus\t: %s\nEmail\t: %s\nLastOn\t: %s( %s )\n\n",
			capitalize(ob->query("id")),
			SECURITY_D->get_status(name),
			ob->query("email"),
			ob->query("last_from"),
			ctime(ob->query("last_on") )
	);
	body = find_player(name);
	if ( body )
	{
		if ( !this_player() || this_player()->visible(body) )
			msg += chinese_flag ?
				("\n" + ob->query("name") + "目前正在线上。\n") :
				("\n" + capitalize(name) + " is currently connected.\n");
	}

	destruct(ob);
	return msg;
}

object acquire_login_ob(string id)
{
	object ob;

	ob = find_player(id);
	if ( ob )
	{
		// Check if the player is linkdead
		if ( ob->query_temp("link_ob") )
			return ob->query_temp("link_ob");
	}
	ob = new(LOGIN_OB);
	ob->set("id", id);
	return ob->restore() ? ob : 0;
}
