// filename : /std/char/special_quest.c
// 用来给一些比较特殊的quest


#define QUEST(x) ("/quest/speical_quest/" + x )

#include <dbase.h>
#include <login.h>
#include <ansi.h>

string *quest_fail_msg = ({
  "疑惑地看着你：“怎么回事？怎么你。。。”\n",
});
string *quest_delay_msg = ({
  "很是失望，叹了口气说：“你做事怎么如此磨蹭？！”\n",
});

string *quest_refuse_msg = ({
  "$N向$n摇了摇头：“你还是应当多练练功为上。”\n",
});

int time_period(int timep, object me);

private string get_quest_fail_msg();
private string get_quest_delay_msg();
private string get_quest_refuse_msg();

/////////////////////////////////////////////////////////////////////////////

string get_family_id(string family_name) {
  switch (family_name) {
    case "无量剑派东宗": return "east"; break;
    case "无量剑派西宗": return "west"; break;
    case "伏牛派": return "funiu"; break;
    case "崆峒派": return "kongdong"; break;
    case "少林派": return "shaolin"; break;
    case "镇南王府": return "duanshi"; break;
    case "蓬莱派": return "penglai"; break;
    case "凤翔镖局": return "biaoju"; break;

    default: return "common"; break;
  }
}

//modify qyz 1997-3-26
int give_quest() {
  mapping quest;
  object me, ob;
  int j, class_score, timep, bonus, num, positive_score, negative_score;
  string my_class, ob_class, my_class_id;
  string tag = "1000000";
  string *levels = ({
    "0",
    "400",
    "900",
    "1600",
    "2500",
    "3600",
    "4900",
    "6400",
    "8100",
    "10000",
    "12100",
    "14400",
    "40000",
    "50000",
    "60000",
    "80000",
    "100000",
    "200000",
    "400000",
    "800000",
    "1000000"
  });
  me = this_player();
  ob = this_object();
  if (me->is_tongshi_of(ob)) {
    my_class = me->query("zuzhi/zuzhi_name");
    ob_class = ob->query("zuzhi/zuzhi_name");
  } else {
    my_class = me->query("family/family_name");
    ob_class = ob->query("family/family_name");
  }
  my_class_id = get_family_id(my_class);
  if (my_class != ob_class) {
    tell_object(me, ob->name() + "疑惑地看着你：“这位" + RANK_D->query_respect(me) + "想要干什么？”\n");
    return 1;
  }
  if (quest = me->query("quest")) {
    if (me->query("quest/class") != my_class_id) {
      tell_object(me, ob->name() + "疑惑地看着你：“这位" + RANK_D->query_respect(me) + "想要干什么？”\n");
      return 1;
    }

    if (me->query("done_quest") == quest["quest"]) {
      if (me->query("task_time") && me->query("task_time") < time()) {
        if (!quest["delay_msg"])
          tell_object(me, ob->name() + get_quest_delay_msg());
        else
          tell_object(me, quest["delay_msg"]);
        me->delete("quest");
        me->delete("done_quest");
        return 1;
      } else {
        tell_object(me, quest["reward_msg"]);
        bonus = quest["bonus"];
        bonus += random((int)me->query("kar")) / 10;
        me->add("class_score/" + my_class, bonus);
        printf(RED "->你对" + my_class + "的忠诚度升高 %s 点\n" NOR
          , chinese_number(bonus));
        if (positive_score = quest["positive_score"]) {
          positive_score *= (1 + random((int)me->query("kar")) / 15);
          me->add("positive_score", positive_score);
          printf(GRN "->正评价升高 %s 点\n" NOR
            , chinese_number(positive_score));
        }
        if (negative_score = quest["negative_score"]) {
          negative_score *= (1 + random((int)me->query("kar")) / 15);
          me->add("negative_score", negative_score);
          printf(CYN "->负评价升高 %s 点\n" NOR
            , chinese_number(negative_score));
        }
        me->delete("done_quest");
        me->delete("quest");
        return 1;
      }
    }

    else {
      if ((me->query("task_time") > time()) && quest["time"])
        return 0;
      else {
        if (!quest["fail_msg"])
          tell_object(me, ob->name() + get_quest_fail_msg());
        else
          tell_object(me, quest["fail_msg"]);
        me->add("class_score/" + my_class, -quest["bonus"] / 3);
        if (quest["bonus"] / 3)
          printf(HIY "->你对" + my_class + "的忠诚度下降 %s 点\n" NOR
            , chinese_number(quest["bonus"] / 3));
        me->delete("quest");
        me->delete("done_quest");
        return 1;
      }
    }
  }
  if (me->query("task_time") && (me->query("task_time") > time())) {
    message_vision(get_quest_refuse_msg(), ob, me);
    return 1;
  }
  class_score = me->query("class_score/" + my_class);
  for (j = sizeof(levels) - 1; j >= 0; j--) {
    if (atoi(levels[j]) <= class_score) {
      num = j;
      break;
    }
  }
  if (num > 9) {
    num = 9;
  }
  tag = levels[num];
  // 现在先共用一个quest库    if ( random( class_score ) < 50 )
  tag = get_family_id(ob_class) + "/quest0";
  else if (random(class_score) < 300)
    tag = get_family_id(ob_class) + "/quest1";
  else if (random(class_score) < 1000)
    tag = get_family_id(ob_class) + "/quest2";
  else
    tag = get_family_id(ob_class) + "/quest3";

  quest = QUEST(tag)->query_quest();
  tell_object(me, quest["quest_msg"]);
  if (quest["send_ob"])
    new(quest["send_ob"])->move(me);
  me->set("quest", quest);
  me->set("quest/class", my_class_id);
  me->delete("task_time");
  if (timep = quest["time"]) {
    time_period(timep, me);
    me->set("task_time", time() + quest["time"]);
  }
  return 1;
}

int time_period(int timep, object me) {
  int t, d, h, m, s;
  string time;
  t = timep;
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d) time = chinese_number(d) + "天";
  else time = "";

  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";

  tell_object(me, HIW "你有" + time + "的时间\n去完成你师傅给的任务。\n" NOR);
  return 1;
}

int accept_object(object who, object ob) {
  string test, who_class, my_class, who_class_id;
  object me;
  mapping quest;
  int bonus, p_score, n_score;
  //p_score is positive_score, n_score is negative_score.

  me = this_object();
  // Qyz 把收到的物品销毁.
  call_out("destruct_quest_object", 2, me, ob);

  if (who->is_tongshi_of(me)) {
    my_class = me->query("zuzhi/zuzhi_name");
    who_class = who->query("zuzhi/zuzhi_name");
  } else {
    my_class = me->query("family/family_name");
    who_class = who->query("family/family_name");
  }
  who_class_id = get_family_id(who_class);
  if (my_class != who_class ||
    who->query("quest/class") != who_class_id) {
    tell_object(who, me->name() + "疑惑地看着你：这位" +
      RANK_D->query_respect(who) + "是什么意思？\n");
    return 0;
  }
  if (!(quest = who->query("quest"))) {
    tell_object(who, me->name() + "笑道：你给我东西干什么？\n");
    return 0;
  }
  if ("取" + ob->name(1) != quest["quest"] || ob->is_character()) {
    tell_object(who, me->name() + "皱眉说：我当初可不是让你去找这个呀！\n");
    return 0;
  }
  if (who->query("task_time") && (who->query("task_time") < time())) {
    if (!quest["delay_msg"])
      tell_object(who, me->name() + get_quest_delay_msg());
    else
      tell_object(who, quest["delay_msg"]);
    who->delete("quest");
    return 1;
  } else {
    tell_object(who, quest["reward_msg"]);
    bonus = quest["bonus"];
    bonus += random(me->query("kar")) / 5;
    who->add("class_score/" + who_class, bonus);
    printf(HIR "->你对" + my_class + "的忠诚度升高 %s 点\n" NOR,
      chinese_number(bonus));
    if (p_score = quest["positive_score"]) {
      p_score *= (1 + random(me->query("kar")) / 15);
      who->add("positive_score", p_score);
      printf(HIG "->正评价升高 %s 点\n" NOR, chinese_number(p_score));
    }
    if (n_score = quest["negative_score"]) {
      n_score *= (1 + random(me->query("kar")) / 15);
      who->add("negative_score", n_score);
      printf(HIC "->负评价升高 %s 点\n" NOR
        , chinese_number(n_score));
    }
    who->delete("quest");
    return 1;
  }
}

private void destruct_quest_object(object me, object ob) {
  if (environment(ob) == me)
    destruct(ob);
}

string get_quest_fail_msg() {
  return quest_fail_msg[random(sizeof(quest_fail_msg))];
}

string get_quest_delay_msg() {
  return quest_delay_msg[random(sizeof(quest_delay_msg))];
}

string get_quest_refuse_msg() {
  return quest_refuse_msg[random(sizeof(quest_refuse_msg))];
}
