//一个标准的NPC。可以让新手补充食物。
// Qyz

inherit NPC;

void init()
{
    object ob;

    ::init();

    add_action("do_fill", "fill");

    if( interactive( ob = this_player() ) && !is_fighting() )
    {
        remove_call_out("greeting");
        call_out("greeting",1,ob);
    }
}

void greeting( object ob )
{
    if( !ob || environment() != environment(ob) )
    return;

    if( !living(ob) || ob->is_fighting() )
    return;

    if( ob->query("age") > 14 )
    return;

    if( ob->query("food") * 100/ ob->max_food_capacity() > 50 &&
        ob->query("water") * 100/ ob->max_water_capacity() > 50 )
    return;

    message_vision( "$N笑逐颜开地对$n说：饿了吧？快坐下吃点东西，补充（ ｆｉｌｌ）一下\n"
                    "食物和饮水吧。\n", this_object(), ob );
}

int do_fill( string arg )
{
    object me, ob;
    ob = this_object();
    me = this_player();

    if( !me->can_act() )
        return notify_fail("你现在正忙着呢。\n");

    if( !living(ob) || ob->is_fighting() )
        return notify_fail( ob->name() + "现在没办法拿东西给你吃。\n");

    if( me->query("age") > 14 )
    {
        message_vision("$N摇摇头对$n笑道：那么大个人，怎么还来这里要东西吃？\n",
                       ob, me );
        return 1;
    }

    if( me->query("food") * 100/ me->max_food_capacity() > 50 &&
        me->query("water") * 100/ me->max_water_capacity() > 50 )
    {
        message_vision("$N拍拍$n的头笑道：已经吃得那么饱了还吃呀？先出去玩一\n"
                        "再回来吧。\n", ob, me );
        return 1;
    }

    message_vision("$N快手快脚地给$n倒了一碗茶水，又端出了一大碗饭来说：快\n"
                    "吃吧，一定饿坏了吧? \n"
                    "$n埋头吃喝起来，不一会就把东西吃了个精光。\n", ob, me );
    tell_object( me, "你吃饱喝足了，感到全身又充满了力量。\n");

    me->set( "food", me->max_food_capacity() );
    me->set( "water", me->max_water_capacity() );

    return 1;
}


                        
    