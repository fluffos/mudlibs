// filename : /std/room/smithshop.c
// edit by Lin on March 7,1997

inherit ROOM;

void init()
{
        seteuid(getuid());
        seteuid(geteuid());
	add_action( "do_sell", "sell" );
}

string value_string(int value)
{
	if ( value < 1 )
		value = 1;
	else if ( value < 1000 )
		return chinese_number( value ) + "文钱";
	else
		return chinese_number( value / 1000 ) + "两"
			+ (value % 1000 ? "又" + chinese_number( value % 1000) + "文钱": "");
}

void pay_player(object who, int amount)
{
	object ob;

	if ( amount < 1 )
		amount = 1;
        if ( amount /1000000)
        {      
                ob = new(MONEY_DIR"thousand-cash");
                ob->set_amount( amount / 1000000);
                ob->move(who);
                amount %=1000000;
        }
        if (amount / 10000)
        {
                ob = new(MONEY_DIR"gold");
                ob->set_amount( amount / 10000);
                ob->move(who);
                amount %= 10000;
        }
	if ( amount / 1000 )
	{
		ob = new(MONEY_DIR"silver");
		ob->set_amount( amount / 1000 );
		ob->move( who );
		amount %= 1000;
	}
	if ( amount )
	{
		ob = new(MONEY_DIR"coin");
		ob->set_amount( amount );
		ob->move( who );
	}
}
int do_sell(string arg)
{
	object ob;
        string mat;
	int value,value1,value2;
    
    if ( !this_player()->can_act() )
        return 0;
        
	if ( !arg || !( ob = present( arg, this_player() ) ) )
		return notify_fail( "你要卖断什麽物品？\n" );

        mat=ob->query("material");
	if ( !mat || ( mat != "iron" && mat != "steel") )
		return notify_fail( "这里只收铁器。\n" );
	value = ob->query_weight() / 50;
	if ( !value ) 
		return notify_fail( "这样东西不值钱。\n" );
      
        if ( ob->query( "cant_sell"))
                return notify_fail( (string)ob->query("cant_sell"));

	message_vision( "$N把身上的" + ob->query( "name" ) + "卖了"+value_string(value)+"。\n",
		this_player() );

	pay_player( this_player(), value );
	destruct( ob );

	return 1;
}
