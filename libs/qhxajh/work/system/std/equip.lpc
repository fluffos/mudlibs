// filename : /std/equip.c

inherit ITEM;
inherit F_EQUIP;

void setup() {
  if (!query("armor_prop/dodge") && (weight() >= 3000)
    && query("armor_prop"))
    set("armor_prop/dodge", -weight() / 3000);
  if (!query("weapon_prop/dodge") && (weight() >= 3000)
    && query("weapon_prop"))
    set("weapon_prop/dodge", -weight() / 3000);
}

int wear() {
  object this = this_object();
  if (::wear()) {
    write("ok\n");
    if (this->query("value") >= 1000)
      this->set("value", this->query("value") / 3);
    else
      this->delete("value");
    return 1;
  } else
    return 0;
}
