// filename : /std/item.c

#include <dbase.h>
#include <move.h>
#include <name.h>

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

void setup()
{
    set_temp( "create_time", time() );
    if ( clonep() )
        call_other( this_object(), "stats", 0);
	seteuid( getuid() );
}

int is_infective()
{
    if( this_object()->query("infectivity") )
        return 1;
    return 0;
}
int is_medicine()
{
     if( this_object()->query("is_medicine") )
        return 1;
    return 0;
}
