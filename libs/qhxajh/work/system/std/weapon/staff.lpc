// staff.c

#include <weapon.h>

#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit EQUIP;
#endif

varargs void init_staff(int damage, int wound, int flag)
{
	if ( clonep( this_object() ) ) return;

	set( "weapon_prop/damage", damage );
	if ( undefinedp(wound) )
		set( "weapon_prop/wound", damage );
	else set("weapon_prop/wound", wound  );
	set( "flag", (int)flag | LONG );
	set( "skill_type", "long" );
	set( "weapon_type","staff");
	//staff包括月牙铲，黄金杵。。。。。。
	set( "verbs", ({ "bash", "crush", "slam" }) );
}

