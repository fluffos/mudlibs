#/adm/daemons/newsd.c
dbase (["notes":({(["title":"6-3号重启。更新N多武器和装备，后续还有。阵营装备增加星级（0~5星）。守城提;高基础经验、削弱等级加成经验。[2;37;0m","msg":"[2;37;0m","time":1536204956,"author":"天涯-tianya",]),(["title":"6-9号重启。部分pfm增加对应武器加成。炼丹术修复与完善。修复自练甲与自练武器问题。华山论剑功能修复完成。[2;37;0m","msg":"[2;37;0m","time":1536205038,"author":"天涯-tianya",]),(["title":"6-16号重启。增加一个新手盟，目的是新手过渡。运镖任务定位为潜能，同时调整贩盐、送信、打铁、分药等任务奖励。开放端午节活动。[2;37;0m","msg":"[2;37;0m","time":1536205172,"author":"天涯-tianya",]),(["title":"6-23号重启。修复扬州树顶天神更改自练武器造型的错误。陪练教头删除武器。调整自练、疗伤、打坐的效率。[2;37;0m","msg":"[2;37;0m","time":1536205249,"author":"天涯-tianya",]),(["title":"6-30号重启。百晓生增加更换阵营的丹，代价技能清零，等级降低50%。全面提高所有怪的爆率。[2;37;0m","msg":"[2;37;0m","time":1536205287,"author":"天涯-tianya",]),(["title":"7-7号重启。文庙增加无根丹，治疗JJ。带星的箱子需在下线前开启，否则星丢失。梅庄、杀手楼解密开放。[2;37;0m","msg":"[2;37;0m","time":1536205359,"author":"天涯-tianya",]),(["title":"7-15号重启。开放BOSS系统，每晚8点刷新一个BOSS，必爆。北京文庙增加补天丹，用来解决先天残缺问题。蜀山、圣剑魔宫解密开放。[2;37;0m","msg":"[2;37;0m","time":1536205389,"author":"天涯-tianya",]),(["title":"7-21号重启。全真教开放天罡北斗阵，奖励经验。调整负重和食物的计算方式。桃花岛、铁掌帮、通吃帮解密开放。[2;37;0m","msg":"[2;37;0m","time":1536205447,"author":"天涯-tianya",]),(["title":"7-28号重启。微调装备属性。微调NPC属性。五毒教、蝶舞门解密开放。[2;37;0m","msg":"[2;37;0m","time":1536205500,"author":"天涯-tianya",]),(["title":"8-5号重启。微调命中闪避招架与其他属性的公式。略微提高与师傅学习技能的比例。逍遥派、星宿派、移花宫解密开放。[2;37;0m","msg":"[2;37;0m","time":1536205581,"author":"天涯-tianya",]),(["title":" 8-11号重启。NPC内力精力稍微降低。珍珑棋局开放。姑苏慕容解密开放。[2;37;0m","msg":"[2;37;0m","time":1536205619,"author":"天涯-tianya",]),(["title":" 8-18重启。绝大部分武器调整为单手。武当增加真武七截阵。修复解密与出师的冲突。古墓派、武当派解密开放。[2;37;0m","msg":"[2;37;0m","time":1536205666,"author":"天涯-tianya",]),(["title":"8-25号重启。明教、血河、少林解密开放，至此所有门派解密完成。开放日常任务--开封府公孙策领取。[2;37;0m","msg":"[2;37;0m","time":1536205721,"author":"天涯-tianya",]),(["title":"9-1号重启。开放日常任务--武功镇武学考核任务。为配合后续武功改动，增加一个设置自动连设置开关(zidong yes/no)。[2;37;0m","msg":"[2;37;0m","time":1536205768,"author":"天涯-tianya",]),(["title":"9-8号重启。重新开放自动连招：打狗棒、浪子三招、胡家刀、化血神针、漫天花雨、玉女剑法、辟邪剑。自动连招的条件与老炎龙类似。重新开放在招架上推pfm的功能。大部分pfm不再要求激发特内，只要求学会特内。套装再增加内裤和胸罩两件。[2;37;0m","author":"天涯-tianya","time":1536370467,"msg":"[2;37;0m",]),(["title":"9-15重启。上次更新导致的连招问题还原。修复了扬州知府任务和另外一个送信任务。解决了套装星级的一个问题。战斗精灵进行了调整，重写了某些不合理代码。五毒神功增加一个复活功能。由于星宿派刷铜人的尴尬，木人铜人教头封禁exert功能。[2;37;0m","msg":"[2;37;0m","time":1536971068,"author":"天涯-tianya",]),(["title":"9-20号临时重启。修复一个重大错误。wukill任务调整，怪的等级降低，意味着没有fight经验了。长老令牌调整为爆率+5%。NPC的技能将不再出现浮动变化。新增一个命令jiemi，用来查看自己的解密状态。[2;37;0m","msg":"[2;37;0m","time":1543638523,"author":"天涯-tianya",]),(["title":"9-22号重启。马云商城开启，使用江湖币可以在这里购买丹药。江湖币可以通过两个日常任务及每天晚上8点的boss获取。中秋国庆五天乐开启。[2;37;0m","msg":"[2;37;0m","time":1543638611,"author":"天涯-tianya",]),(["title":"9-29号重启。修复并开放世界寻物任务。自练武器和神兵恢复成双手武器。[2;37;0m","msg":"[2;37;0m","time":1543638662,"author":"天涯-tianya",]),(["title":"10-6号重启。pfm的化学伤害文字显示改换方法。朱半仙任务失败可以给予黄金坐牢取消。程药发任务失败则随意给予东西坐牢取消。[2;37;0m","msg":"[2;37;0m","time":1543638777,"author":"天涯-tianya",]),(["title":"10-13号重启。少数暗器设计为无限数量。开启武学境界的玩法准备代码。[2;37;0m","msg":"[2;37;0m","time":1543638918,"author":"天涯-tianya",]),(["title":"10-20号重启。NPC添加武学境界，底层战斗精灵添加武学境界代码。[2;37;0m","msg":"[2;37;0m","time":1543639002,"author":"天涯-tianya",]),(["title":"10-27号重启。修复某些错误。[2;37;0m","msg":"[2;37;0m","time":1543639029,"author":"天涯-tianya",]),(["title":"11-3号重启。开放江湖奇遇，碧云仙子可以突破先天境界，挑战5~9位高手。丐帮和谐不能买东西代码。[2;37;0m","msg":"[2;37;0m","time":1543639120,"author":"天涯-tianya",]),(["title":"11-10号重启。增加慕容龙城。更新字母a~k开头的技能特效，开放境界效果。[2;37;0m","msg":"[2;37;0m","time":1543639182,"author":"天涯-tianya",]),(["title":"11-17号重启。开放林朝英、唐老太爷。再次更新字母a~k开头的技能，攻击特效与招架特效显示数值。[2;37;0m","msg":"[2;37;0m","time":1543639251,"author":"天涯-tianya",]),(["title":"11-24号重启。更新字母L~p开头的技能特效。挖流星开放IP限制。[2;37;0m","msg":"[2;37;0m","time":1543639298,"author":"天涯-tianya",]),(["title":"12-1号重启。更新字母q~w开头的技能特效。侠客岛开放面壁，福源越高悟性越低则效率越快。新增命令xiantian，用来查看自己先天丹药的情况。[2;37;0m","msg":"[2;37;0m","time":1543639369,"author":"天涯-tianya",]),}),])
