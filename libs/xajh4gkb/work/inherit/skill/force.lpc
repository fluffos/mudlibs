// force.c

inherit SKILL;
mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
    int damage;
    me->add("neili", - factor );
    damage = (int)me->query("neili")/500 + factor - (int)victim->query("neili")/500;
    if( damage < 0 )
	{
	//	if ( !me->query_temp("weapon") && random(me->query_skill("force")) < victim->query_skill("force") ) 
		if ( me->query_skill("force") < random(victim->query_skill("force")) && me->query("neili") < random(victim->query("neili")) && me->query("max_neili") < victim->query("max_neili") && random(20)==1) 	//2016.6.1阿飞改，现在拿武器也同样会被反震，另外原来的写法坑爹
		{
			damage = - damage;
			me->receive_damage( "qi", damage ,victim );
			me->receive_wound( "qi", damage/2 ,victim);
			if( damage < 100 ) return HIG"$N受到$p的内力反震，闷哼一声。\n"NOR;
			else if( damage < 1000 ) return HIC"$N被$p以内力反震，「嘿」地一声退了两步。\n"NOR;
			else if( damage < 10000 ) return HIR"$N被$p以内力一震，胸口有如受到一记重锤，连退了五六步！\n"NOR;
			else return "$N被$p的内力一震，眼前一黑，吐出一大口鲜血！！\n";
		}
		else
			return damage_bonus + factor;
	}
	else
		return damage;
}

int valid_learn_ob(object ob) {return 1;} //返回1,内功不能和玩家学

varargs mixed armor_ob(object me, object victim, int damage_bonus,int force_armor, int combat_msg)
{
    if ( !living(victim) || damage_bonus < 1 ) 
		return damage_bonus;
	if ( force_armor < 0 ) force_armor = 0;
    if ( victim->query("neili") >= force_armor+damage_bonus )
	{
        if ( force_armor > damage_bonus)
		{
            victim->add("neili",-damage_bonus);
            return BOLD "$p用"+to_chinese(victim->query_skill_mapped("force"))+"的护体真气化解了$N的伤害！\n" NOR;
        }
		else
		{
			if ( combat_msg < 4 )
				message_vision( BOLD "$p催动"+to_chinese(victim->query_skill_mapped("force"))+"的护体真气试图削弱$N的伤害！\n" NOR,me,victim);
            victim->add("neili",-force_armor);
            return damage_bonus-force_armor;
        }
	}
	return damage_bonus;
}
