//2015.10 修改 红宝石和黄宝石的 效果关联武器等级 by suimeng
#include <ansi.h>
#include <weapon.h>

inherit M_WEAPON;
inherit F_GEMS;

void init_sockets(object me)
{
	set("max_sockets", 4);
	if ( wizardp(me) ) set("max_sockets", 7);	
	if ( !wizardp(me) && (int)query("sockets/max")>4 )
		set("sockets/max",4);
	
	if (me->query("diablo/" + query("skill_type") + "/id") != query("id")) return;

	set("sockets", me->query("diablo/" + query("skill_type") + "/sockets"));

	//增加个人拥有识别参数
	set("diablo/only_me",me->query("id"));

	set_weapon_desc();
}

void setup()
{
	if ( objectp(this_player()) ) init_sockets(this_player());
	::setup();
}

void spec_prop(object me, string socket, int socket_level, int mode)
{
	int w_lv;
	w_lv = me->query("weapon/lv");
	if (!valid_gem(socket, socket_level)) return;
	if (me->query("diablo/" + query("skill_type") + "/id") != query("id")) return;
	if ( query("diablo/only_me") != me->query("id") ) return;

	switch (socket)	
{
	case "ruby":
		break;
	case "topaz":
		break;
	case "sapphire":
		break;
	case "emerald":
		break;
	case "amethyst":
		if (mode == 1)
			message_vision(MAG + query("name") + MAG"发出柔和的光芒围绕着$N，激发了$P的战斗力！\n"NOR, me);
		else
			message_vision(MAG"随着紫色光芒慢慢的散去，$N的战斗力又复原了。\n"NOR, me);
		me->add_temp("apply/damage", w_lv/20 * socket_level * mode);
		break;
	case "diamond":
		if (mode == 1)
			message_vision(HIW"只见一道白光直透" + query("name") + HIW"，威力猛然大增！\n"NOR, me);
		else
			message_vision(HIW"白光渐渐隐入了" + query("name") + HIW"。\n"NOR, me);
		me->add_temp("apply/attack", w_lv * socket_level * mode);
		break;
	case "skull":
		break;
	}
	return;
}

int wield()
{
	int i, sockets, ret;
	object me = environment();

	if (!(ret = ::wield())) return 0;
	sockets = query("sockets/max");
	for (i = 1; i <= sockets; i++)
		spec_prop(me, query(sprintf("sockets/socket%d", i)), query(sprintf("sockets/socket%d_level", i)), 1);
	return ret;
}

int unequip()
{
	int i, sockets, ret;
	object me = environment();

	if (!(ret = ::unequip())) return 0;
	sockets = query("sockets/max");
	for (i = 1; i <= sockets; i++)
		spec_prop(me, query(sprintf("sockets/socket%d", i)), query(sprintf("sockets/socket%d_level", i)), -1);
	return ret;
}

string spec_effect(object me, object victim, int damage_bonus, string socket, int socket_level)
{
	int damage;
	string msg = "";
	object weapon;
	int w_lv;
	w_lv = me->query("weapon/lv");

	if (!valid_gem(socket, socket_level)) return msg;
	if (random(100) + me->query_temp("apply/magic") < 80) return msg;
	if (me->query("diablo/" + query("skill_type") + "/id") != query("id")) return msg;
	if ( query("diablo/only_me") != me->query("id") ) return msg;

	switch (socket)
	{
	case "ruby":
		damage = w_lv * socket_level*2;
		if ((int)victim->query("qi")+100 > damage)
		{
			victim->receive_damage("qi", damage,me);
			victim->receive_wound("qi", damage/3,me);
		}			
		msg = HIR"一道红光猛的击中了$n，$p只觉得浑身一阵巨痛！\n"NOR;
		break;
	case "topaz":
		damage = w_lv * socket_level*2;
		if ((int)victim->query("jing")+100 > damage)
		{
			victim->receive_damage("jing", damage,me);
			victim->receive_wound("jing", damage/3,me);
		}
		msg = HIY"一道黄光猛的击中了$n，$p只觉得意思越来越模糊！\n"NOR;
		break;
	case "sapphire":
		if (!victim->is_busy())
		{
			msg = HIB"一道奇异的蓝光包围着$n，$p只觉天旋地转，身体无法动弹！\n"NOR;
			victim->start_busy(random(socket_level) + 1);
		}
		
		break;
	case "emerald":
		if (!victim->query_condition("emerald_poison"))
		{
			msg = HIG"$n只见一道绿气迅速的从伤口渗入了$p的经脉！\n"NOR;
			victim->apply_condition("emerald_poison", socket_level + 10);
//			if (!victim->is_killing(me->query("id")) ) victim->kill_ob(me);
		}
		
		break;
	case "amethyst":
		break;
	case "diamond":
		if (objectp(weapon = victim->query_temp("weapon")))
		{
			if (random(query("weapon_prop/damage")) > weapon->query("weapon_prop/damage") / 2
			        || random(me->query("str")) > victim->query("str") / 2)
			{
				if (query("skill_type") == "sword" || query("skill_type") == "blade" || query("skill_type") == "axe")
				{
					message_vision(HIW"只听见「哐」地一声轻响，$n手中的" + weapon->query("name") + HIW"已经被" + query("name") + HIW"削为两截！\n"NOR, me,victim);
					weapon->unequip();
					weapon->move(environment(victim));
					weapon->set("name", "断掉的" + weapon->query("name"));
					weapon->set("value", 0);
					weapon->set("weapon_prop", 0);
					victim->reset_action();
				}
				if (query("skill_type") == "staff" || query("skill_type") == "hammer" || query("skill_type") == "club")
				{
					message_vision(HIW "$n只觉得手中" + weapon->query("name") + HIW"把持不定，脱手飞出！\n" NOR, me,victim);
					weapon->unequip();
					weapon->move(environment(victim));
					victim->reset_action();
				}
				if (query("skill_type") == "whip")
				{
					message_vision(HIW"只听见「唰」地一声轻响，$n手中的" + weapon->query("name") + HIW"已经被" + query("name") + HIW"卷为两截！\n"NOR, me,victim );
					weapon->unequip();
					weapon->move(environment(victim));
					weapon->set("name", "断掉的" + weapon->query("name"));
					weapon->set("value", 0);
					weapon->set("weapon_prop", 0);
					victim->reset_action();
				}
			}
		}
		
		break;
	case "skull":
		msg = WHT"忽然间，$n只觉鬼哭狼嚎声不绝于耳，三魂六魄都给吸了出去！\n"NOR;
		damage = w_lv * socket_level;
		if (damage > 0)
		{
			victim->receive_damage("qi", damage,me);
			victim->receive_damage("jing", damage,me);
			me->add("eff_qi", damage/5);
			me->add("qi", damage/2);
			me->add("eff_jing", damage/5);	
			me->add("jing", damage/2);						
			if (me->query("eff_qi") > me->query("max_qi")) me->set("eff_qi", me->query("max_qi"));
			if (me->query("qi") > me->query("eff_qi")) me->set("qi", me->query("eff_qi"));
			if (me->query("eff_jing") > me->query("max_jing")) me->set("eff_jing", me->query("max_jing"));
			if (me->query("jing") > me->query("eff_jing")) me->set("jing", me->query("eff_jing"));	
			
			if ((int)victim->query("neili")+100 > damage)
			{
				victim->add("neili", -damage);
				me->add("neili", damage/2);
				if (me->query("neili") > me->query("max_neili") * 2) me->set("neili", me->query("max_neili") * 2);
			}
			if ((int)victim->query("jingli")+100 > damage)
			{
				victim->add("jingli", -damage);
				me->add("jingli", damage/2);
				if (me->query("jingli") > me->query("max_jingli") * 2) me->set("jingli", me->query("max_jingli") * 2);
			}
		}
		
		break;
	}

	return msg;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int i, sockets,damage1;
	string msg = "";

//2018.4.25阿飞改，这段自练武器的剑气伤害可以放在自练武器本身的代码里，但是似乎有问题
	if( random(100)>=80 && (int)me->query("weapon/lv") >= 500 )
	{
		damage1 = (int)me->query("weapon/lv")*20;
		damage1 = damage1+random(damage1);
		victim->receive_damage("qi", damage1,me);
        victim->receive_wound("qi", damage1/2,me);

		if (query("skill_type") == "sword") msg += HIR BLINK "剑荡九州，$n被$N犀利的剑气所伤！\n" NOR;
		if (query("skill_type") == "axe") msg += HIR BLINK "开天辟地，$n被$N犀利的斧气所伤！\n" NOR;
		if (query("skill_type") == "blade") msg += HIR BLINK "霸绝天下，$n被$N犀利的刀气所伤！\n" NOR;
		if (query("skill_type") == "club") msg += HIR BLINK "横扫六合，$n被$N犀利的棍气所伤！\n" NOR;
		if (query("skill_type") == "staff") msg += HIR BLINK "普渡众生，$n被$N犀利的杖气所伤！\n" NOR;
		if (query("skill_type") == "whip") msg += HIR BLINK "凤舞九天，$n被$N犀利的鞭气所伤！\n" NOR;
		if (query("skill_type") == "hammer") msg += HIR BLINK "星沉地动，$n被$N犀利的锤气所伤！\n" NOR;
		if (query("skill_type") == "spear") msg += HIR BLINK "炼狱火海，$n被$N犀利的枪气所伤！\n" NOR;
		if (query("skill_type") == "fork") msg += HIR BLINK "断空噬地，$n被$N犀利的叉气所伤！\n" NOR;
		if (query("skill_type") == "dagger") msg += HIR BLINK "飞鸟裂天，$n被$N犀利的矛气所伤！\n" NOR;
    }
	
	sockets = query("sockets/max");
	for (i = 1; i <= sockets; i++)
		msg += spec_effect(me, victim, damage_bonus, query(sprintf("sockets/socket%d", i)), query(sprintf("sockets/socket%d_level", i)));
	return msg;
}
