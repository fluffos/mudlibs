				break;
			case 7: this_object()->set("inborn",YEL"冷静"NOR);
				break;
			case 8: this_object()->set("inborn",CYN"专注"NOR);
				break;			
		}
//2019.1.10阿飞改，NPC设置天赋		
		switch ( random(7) )
		{
			case 0: if(this_object()->query("gender")=="女性") this_object()->set("body",HIM"姹女媚体"NOR);
					else
