//生物核心程序
//修正 npc在经验转换时造成的一些属性异常的问题，具体效果自己可以去  sc shan dian 对比
#include <action.h>
#include <ansi.h>
#include <command.h>
#include <condition.h>
#include <dbase.h>
#include <move.h>
#include <name.h>
#include <skill.h>
#include <team.h>
#include <user.h>
#include <liebiao.h>

inherit F_ACTION;
inherit F_ALIAS;
inherit F_APPRENTICE;
inherit F_ATTACK;
inherit F_ATTRIBUTE;
inherit F_COMMAND;
inherit F_CONDITION;
inherit F_DAMAGE;
inherit F_DBASE;
inherit F_EDIT;
inherit F_FINANCE;
inherit F_MESSAGE;
inherit F_MORE;
inherit F_MOVE;
inherit F_NAME;
inherit F_SKILL;
inherit F_TEAM;
inherit F_SUIT;    //套装

//Use a tick with longer period than heart beat to save cpu's work
nosave int tick;
nosave int baishi = 0;
nosave int save_times = 0;
nosave int use_skill_busy = 0;
nosave int all_lvl_set_flap = 0; // 为1时表示NPC的经验已经转换成等级

string tribar_graph(int, int, int, string);
int query_use_skill_busy();
int set_use_skill_busy(int num);

void create()
{
	//so LOGIN_D can export uid to us
	seteuid(0);
}

//Use this function to identify if an object is a character.
int is_character() { return 1; }

// setup: used to configure attributes that aren't known by this_object()
//at create() time such as living_name (and so can't be done in create()).
void setup()
{
	mapping my;
	mapping skill_status;	//用于统一定义NPC的技能等级
	string *sname;	//用于统一定义NPC的技能等级
	string *basic=( {"dodge","unarmed","force","parry","literate","finger","hand","strike","club","staff","fork","hammer","blade","cuff","axe","sword","whip","dagger","spear","throwing","claw","poison","stick","magic","spells",
	                });	//用于统一定义NPC的基础技能等级
	int lvl, upnum, level,expk;
    int i, temp;	//用于统一定义NPC的技能等级
	seteuid(getuid(this_object()));
	set_heart_beat(1);
	tick = 5 + random(10);
	enable_player();
	CHAR_D->setup_char(this_object());
	if ( !userp(this_object())/* && all_lvl_set_flap == 0*/ )
	{// NPC设置，版本升级至完全等级制时
		my = query_entire_dbase();
		if(my["combat_exp"]<=0) lvl=0; //2015.12.20 添加，防止出现 exp<0的情况
		else lvl = to_int(sqrt(to_float(my["combat_exp"]/(LEVUP_EXP/2)))); // 经验可转换的等级数
//		this_object()->set("combat_exp", 0);
		this_object()->set("xyzx_sys/level", query("xyzx_sys/level",1) + lvl); //经验和等级相加 2016.1.29
		level = this_object()->query("xyzx_sys/level",1);
		if (level<1) level=1;	//2016.8.12阿飞添加，当值出现level=0的情况
		expk = level*level/(level+2000);
		upnum = level * LEVUP_SHUXD_NUM_ONE/* + START_SET_SXD*/;
		upnum += query("xyzx_sys/shuxingdian");
		upnum += level / 1000 * level;//2016.5.22阿飞改，更改系数以便于调节NPC四维属性
		upnum += level / 100 * 100;//2016.5.22阿飞改，更改系数以便于调节NPC四维属性
		upnum += level / 10 * 10;//2016.5.22阿飞改，更改系数以便于调节NPC四维属性
		upnum = upnum/10;
		upnum = 10+level/10;
//2016.5.22阿飞改，由于原先代码会造成NPC实力不断的叠加，所以删除+后面的部分
	//	this_object()->set("xyzx_sys/jingzhun", upnum + query("xyzx_sys/jingzhun"));
	//	this_object()->set("xyzx_sys/lingxing", upnum + query("xyzx_sys/lingxing"));
	//	this_object()->set("xyzx_sys/minjie", upnum + query("xyzx_sys/minjie"));
	//	this_object()->set("xyzx_sys/fanying", upnum + query("xyzx_sys/fanying"));	
		this_object()->set("xyzx_sys/jingzhun", upnum );  //设置NPC四维属性
		this_object()->set("xyzx_sys/lingxing", upnum );  //设置NPC四维属性
		this_object()->set("xyzx_sys/minjie", upnum );    //设置NPC四维属性
		this_object()->set("xyzx_sys/fanying", upnum );	  //设置NPC四维属性
		this_object()->set("jiali", 100+(expk/3+random(expk/2)) );
		this_object()->set("jiajing", 100+(expk/3+random(expk/2)) );
		this_object()->set("max_neili", 1000+900*expk );			
		this_object()->set("max_jingli", 1000+900*expk );
		this_object()->set("neili", 1000+(900+random(600))*expk );
		this_object()->set("jingli", 1000+(900+random(600))*expk );
		this_object()->set("max_qi", 1000+240*expk );
		this_object()->set("max_jing", 1000+240*expk );
        this_object()->set("str", 25+15*level/(level+5000)); //统一重置NPC先天
        this_object()->set("con", 25+15*level/(level+5000)); //统一重置NPC先天
        this_object()->set("dex", 25+15*level/(level+5000)); //统一重置NPC先天
        this_object()->set("int", 25+15*level/(level+5000));	//统一重置NPC先天
        this_object()->set("kar", 25+15*level/(level+5000)); //统一重置NPC先天
        this_object()->set("per", 25+15*level/(level+5000));	//统一重置NPC先天	
        this_object()->set_temp("apply/karma", 10+(expk/10+random(expk/10)));  			//统一重置NPC后天属性
        this_object()->set_temp("apply/personality", 10+(expk/10+random(expk/10)));  	//统一重置NPC后天属性	
        this_object()->set_temp("apply/strength", 10);  		//统一重置NPC后天属性
        this_object()->set_temp("apply/intelligence", 10);  	//统一重置NPC后天属性
        this_object()->set_temp("apply/constitution", 10);  	//统一重置NPC后天属性
        this_object()->set_temp("apply/dexerity", 10);  		//统一重置NPC后天属性
		this_object()->set("shen", (int)this_object()->query("shen_type")*expk*500);
		this_object()->set("score", 500+expk*10);
		this_object()->set_temp("apply/damage", 100+(expk/6+random(expk/6)));
		this_object()->set_temp("apply/armor", 2000+(expk+random(expk)));
		set("xyhy_type",1);
		set("xy_huiyuan", "3001年1月1日");	
//2017.8.5阿飞改，若NPC有技能，统一重置NPC的基础技能与特殊技能等级
		if ( mapp(skill_status = this_object()->query_skills()) ) 	
		{
			skill_status = this_object()->query_skills();
			sname  = keys(skill_status);
			temp = sizeof(skill_status);
			for(i=0; i<temp; i++) 
			{
				if (member_array(sname[i],basic)!=-1)
				{
					this_object()->set_skill(sname[i],500+level*2+(level/2));
				} else			
				{
					this_object()->set_skill(sname[i],500+level/2+(level/2));
				}
			}
		}
//2018.10.15阿飞改，NPC统一设置武学境界		
		if (level>=14000) {this_object()->set("breakup", 4);this_object()->set("cognize",HIR"破碎虚空"NOR);}
		else if (level>=9000) {this_object()->set("breakup", 3);this_object()->set("cognize",HIM"天人之道"NOR);}
		else if (level>=5000) {this_object()->set("breakup", 2);this_object()->set("cognize",HIG"先天意境"NOR);}
		else if (level>=2000) {this_object()->set("breakup", 1);this_object()->set("cognize",HIC"后天境界"NOR);}
		else {set("cognize","凡人");}	
//2018.12.25阿飞改，NPC设置解密
		if ((string)this_object()->query("family/family_name")=="大理段家") this_object()->set("jm/dali",1);
		if ((string)this_object()->query("family/family_name")=="飞天御剑流") this_object()->set("jm/feitian",1);
		if ((string)this_object()->query("family/family_name")=="丐帮") this_object()->set("jm/gaibang",1);
