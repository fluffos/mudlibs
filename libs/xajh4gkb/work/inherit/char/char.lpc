//2019.1.5阿飞改，NPC添加道学和禅宗的影响
		my["max_jing"] += ((int)this_object()->query_skill("buddhism",1)-my["age"]+my["max_neili"]/1000)*((int)this_object()->query_skill("yijinjing",1)/200);
		my["max_qi"] += ((int)this_object()->query_skill("taoism",1)-my["age"]+my["max_jingli"]/1000)*((int)this_object()->query_skill("taiji-shengong",1)/200);
//2019.1.5阿飞改，增加天赋(inborn)功能
		if( stringp(this_object()->query("inborn")) && (string)this_object()->query("inborn")==HIM"强壮"NOR) 
