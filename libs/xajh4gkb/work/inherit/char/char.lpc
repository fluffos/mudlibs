						if(random(2)==0) this_object()->set("body",HIR"玄阳龙体"NOR);
						else this_object()->set("body",CYN"阴阳魔胎"NOR);
					}
				break;
			case 1: this_object()->set("body",HIC"太阴灵体"NOR);
				break;
			case 2: this_object()->set("body",HIG"苍天霸体"NOR);
				break;
			case 3: this_object()->set("body",HIY"太上仙体"NOR);
				break;
			case 4: this_object()->set("body",HIB"幽冥邪胎"NOR);
