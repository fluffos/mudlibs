// shisan 剑十三
// 2000.5.30  by ybl

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;

int perform(object me, object target) {
  object weapon;
  int i, count, damage, damage1, extra;
  int ap, dp;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「剑十三」只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你所使用的武器不对\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if ((int)me->query_skill("youlong-shenfa", 1) < 1000)
    return notify_fail("你的游龙身法不够娴熟，不会使用「剑十三」。\n");
  if ((int)me->query_skill("luohua-jian", 1) < 1000)
    return notify_fail("你的落花剑法不够娴熟，不会使用「剑十三」。\n");
  if ((int)me->query_skill("baihua-cuoquan", 1) < 1000)
    return notify_fail("你的百花错拳不够娴熟，不会使用「剑十三」。\n");
  if (!wizardp(me) && me->query_skill_mapped("sword") != "luohua-jian")
    return notify_fail("「剑十三」只能使用剑法才能出剑!\n");
  if ((int)me->query_skill("honghua-shengong", 1) < 1000)
    return notify_fail("你的红花神功不够深厚，不能使用「剑十三」绝技。\n");
  if (!wizardp(me) && me->query_skill_mapped("force") != "honghua-shengong")
    return notify_fail("不使用本门内功，如何使用本门绝学!\n");
  if ((int)me->query("max_neili") < 1000000)
    return notify_fail("你现在内力修为太弱，不能使用「剑十三」。\n");
  if ((int)me->query("max_jingli") < 1000000)
    return notify_fail("你的精力修为还不够高，不能使用「剑十三」。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够了。\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的内力不够了。\n");
  if (!(int)me->query("breakup"))
    return notify_fail("你任督二脉未通,无法领悟[" HIR "剑十三" NOR "]\n" NOR);
  if (target && !living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  message_vision(HBWHT "$N贯通红花会武学，使出了红花会的绝学之精髓！\n" NOR, me, target);
  message_vision(HIC "$N在战斗中突然领悟领悟第十三剑，出剑速度突然加快！\n" NOR, me, target);
  message_vision(HIB "只见剑光一闪，$N已是数剑出手，快到不可思议！\n" NOR, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1		
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "luohua-jian",
    1
  ) + me->query_skill("baihua-cuoquan", 1) + me->query_skill("sword") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  extra = target->query_skill("sword") / 10 + me->query_skill("luohua-jian", 1) / 10;
  if (me->query_skill("luohua-jian", 1) < 2000) count = 6;
  if (me->query_skill("luohua-jian", 1) > 2000) count = 12;
  message_vision(YEL + "\n$N" + RED + "纵声长笑数声，落花剑法接连出招。\n" NOR, me, target);

  for (i = 1; i <= count; i++) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }
  me->add("neili", -1000);

  if (me->query_skill("luohua-jian", 1) > 2000 && me->query_skill("baihua-cuoquan", 1) > 2000) {
    message_vision(
      HIW "\n突然间天空中一声巨响，一道闪电划破夜空劈在" + weapon->name() + HIW "上，$N挟雷电之威，向$n扑了过去。\n" NOR,
      me,
      target
    );
    message_vision(HIB
      "\n                          剑                             剑         \n"
      "\n                      剑      剑                         剑         \n"
      "\n                  剑              剑                     剑         \n"
      "\n              剑                      剑                 剑         \n"
      "\n          剑                              剑             剑         \n"
      "\n      剑                                      剑   剑    剑         \n"
      "\n              剑剑剑剑剑剑剑剑剑剑剑               剑    剑         \n"
      "\n                                                   剑    剑         \n"
      "\n                                                   剑    剑         \n"
      "\n                                                   剑    剑         \n"
      "\n                        剑                         剑    剑         \n"
      "\n    剑                  剑                  剑     剑    剑         \n"
      "\n        剑              剑              剑         剑    剑         \n"
      "\n            剑          剑          剑                   剑         \n"
      "\n                剑      剑      剑                       剑         \n"
      "\n                    剑  剑  剑                           剑         \n"
      "\n        剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑       剑      剑         \n"
      "\n                                                    剑   剑         \n"
      "\n                                                       剑剑         \n" NOR, me, target);

    me->add_temp("apply/attack", extra * 4);
    me->add_temp("apply/damage", extra * 4);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add_temp("apply/attack", -extra * 4);
    me->add_temp("apply/damage", -extra * 4);
    me->add("neili", -1000);
    damage1 = me->query_skill(
      "luohua-jian",
      1
    ) + me->query_skill(
      "baihua-cuoquan",
      1
    ) + me->query_skill(
      "honghua-shengong",
      1
    ) + me->query_skill("sword", 1) + me->query_skill("force", 1);
    damage = damage1 / 2 + random(damage1 / 2);
    damage = damage * (100 - target->query_meridian()) / 100;
    if (random(ap) > dp / 3) {
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      me->add("neili", -1000);
      message_vision(HIC "剑气纵横三万里，一剑光寒十九洲！\n" NOR, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
      //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);	
    }
  }

  if (me->query_skill("luohua-jian", 1) > 3000 && me->query_skill("baihua-cuoquan", 1) > 3000) {
    message_vision(
      MAG "\n$N" + weapon->name() + MAG "微微晃动，当气势蓄至巅峰时，大步前跨，一股惊天动地的剑气，立即潮涌而去。\n" NOR,
      me,
      target
    );
    if (me->query("jm/honghua")) damage1 = me->query_skill(
      "youlong-shenfa",
      1
    ) * me->query(
      "int",
      1
    ) * 3 / 2 + me->query_skill(
      "luohua-jian",
      1
    ) * me->query(
      "int",
      1
    ) * 3 / 2 + me->query_skill(
      "baihua-cuoquan",
      1
    ) * me->query(
      "int",
      1
    ) * 3 / 2 + me->query_skill(
      "honghua-shengong",
      1
    ) * me->query("int", 1) * 3 / 2 + me->query_skill("sword", 1) + me->query_skill("force", 1);
    else damage1 = me->query_skill(
      "luohua-jian",
      1
    ) * me->query(
      "int",
      1
    ) + me->query_skill(
      "baihua-cuoquan",
      1
    ) * me->query(
      "int",
      1
    ) + me->query_skill(
      "honghua-shengong",
      1
    ) * me->query("int", 1) + me->query_skill("sword", 1) + me->query_skill("force", 1);

    if (random(ap) > dp / 3) {
      damage = damage1 / 3 + random(damage1 / 3) + target->query("qi") * 4 / 100;
      damage = damage * (100 - target->query_meridian()) / 100;
      message_vision(HIY
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n          剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑         \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n"
        "\n                            剑                           \n" NOR, me, target);

      message_vision(HIC
        "\n                                                       \n"
        "\n                                                       \n"
        "\n                                                       \n"
        "\n                                                       \n"
        "\n                    剑剑剑剑剑剑剑剑剑                 \n"
        "\n                                                       \n"
        "\n                                                       \n"
        "\n                                                       \n"
        "\n                                                       \n"
        "\n                                                       \n"
        "\n              剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑           \n"
        "\n                                                       \n"
        "\n                                                       \n"
        "\n                                                       \n"
        "\n                                                       \n"
        "\n                                                       \n"
        "\n                                                       \n"
        "\n        剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑剑     \n"
        "\n                                                       \n" NOR, me, target);

      message_vision(BLU "这一剑已慢慢的，慢慢的刺了出来！\n" NOR, me, target);
      message_vision(MAG "从最不可思议的部位刺了出来，刺出时忽然又有了最不可思议的变化！\n" NOR, me, target);
      message_vision(CYN "一种极缓慢，极优美的动作，就像是风那么自然。\n" NOR, me, target);
      message_vision(HIC "可是风吹来的时候，有谁能抵挡？又有谁知道风是从那里吹来的？\n" NOR, me, target);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      target->add("neili", -damage);
      me->add("neili", -2000);
      message_vision(
        HIR "这一剑不该存在世间！世上根本没有人能破这一剑！！\n" NOR,
        me,
        target,
        damage,
        HBWHT + HIM "气血伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
      if (random(5) == 0) {
        if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
          me,
          HIW "该绝招对敌人造成了昏迷。\n" NOR
        );
        target->unconcious(me);
        return 1;  //这里其实应该加个return 1的，昏迷之后理应中断PFM
      }

    } else {
      damage = damage1 / 10 + random(damage1 / 5) + target->query("qi") * 1 / 100;
      damage = damage * (100 - target->query_meridian()) / 100;
      me->add("neili", -1000);
      target->add("neili", -1000);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      message_vision(HIB "$n知道自己无法闪避，神情绝望！！！\n" NOR, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
      damage = damage1 / 10 + random(damage1 / 5) + me->query("qi") * 1 / 100;
      damage = damage * (100 - me->query_meridian()) / 100;
      me->receive_wound("qi", damage, target);
      me->receive_damage("qi", damage / 3, target);
      message_vision(
        HIY "$n无法控制这一剑，这一剑本就不该存在世间！$n倒转这一剑，刺向自己！！！\n" NOR,
        target,
        me,
        damage,
        HBWHT + HIM "气血伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法			
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"，对自己气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);
      if (random(10) == 0) {
        if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
          me,
          HIW "该绝招对自己造成了昏迷。\n" NOR
        );
        me->unconcious(target);
        return 1;  //这里其实应该加个return 1的，昏迷之后理应中断PFM
      }
    }
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
