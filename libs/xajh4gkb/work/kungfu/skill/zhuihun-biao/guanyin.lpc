// guanyin.c 观音泪
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int i, lmt, damage, equip, ak, dk;
  int ap, dp, extra;
  object *inv; object weapon;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail(HIW "「观音泪」只能对战斗中的对手使用。\n" NOR);
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing")
    return notify_fail("不拿暗器也能用？你以为自己是神仙呀!");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
  if ((int)me->query_skill("zhuihun-biao", 1) < 1000)
    return notify_fail(HIW "你的「追魂镖」还不到家，无法使用「观音泪」！\n" NOR);
  if ((int)me->query_skill("biye-wu", 1) < 1000)
    return notify_fail(HIW "你的「碧叶随风舞」还不到家，无法使用「观音泪」！\n" NOR);
  if ((int)me->query_skill("qiulinshiye", 1) < 1000)
    return notify_fail(HIW "你的「秋林拾叶」还不到家，无法使用「观音泪」！\n" NOR);
  if ((int)me->query_skill("biyun-xinfa", 1) < 1000)
    return notify_fail("你的碧云心法火侯太浅，无法使用「观音泪」！\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的内力不够，无法使用「观音泪」！\n");
  if ((int)me->query("max_neili") < 1000000)
    return notify_fail("你的内力修为不够，无法使用「观音泪」！\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够，无法使用「观音泪」！\n");
  if ((int)me->query("max_jingli") < 500000)
    return notify_fail("你的精力修为不够，无法使用「观音泪」！\n");
  if (me->query_skill_mapped("force") != "biyun-xinfa")
    return notify_fail("你的未使用碧云心法，无法使用「观音泪」！\n");
  if (me->query_skill_mapped("unarmed") != "biye-wu")
    return notify_fail("你的未使用碧叶随风舞，无法使用「观音泪」！\n");
  if (me->query_skill_mapped("dodge") != "qiulinshiye")
    return notify_fail("你的未使用秋林拾叶，无法使用「观音泪」！\n");
  if (me->query_skill_mapped("throwing") != "zhuihun-biao")
    return notify_fail("你的未使用追魂镖，无法使用「观音泪」！ 。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢，哪有空运功？\n");
  if (!(int)me->query("breakup"))
    return notify_fail("你任督二脉未通,无法使用「观音泪」！\n" NOR);
  if (weapon->query("weapon_prop/damage") < 100)
    return notify_fail("你使用的暗器太差劲了！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  message_vision(HBWHT "$N贯通唐门武学，使出了唐门的绝学之精髓！\n" NOR, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1 
  msg = HIY "$N融汇贯通唐门属门绝技，使出了唐门失传百年的，惊艳天下的暗器---【观音泪】！\n\n" NOR;
  message_vision(msg, me, target);
  extra = me->query_skill(
    "zhuihun-biao",
    1
  ) / 10 + me->query_skill("biyun-xinfa", 1) / 10 + me->query_skill("biye-wu", 1) / 10;
  damage = me->query_skill(
    "zhuihun-biao",
    1
  ) + me->query_skill(
    "biyun-xinfa",
    1
  ) + me->query_skill("biye-wu", 1) + weapon->query("weapon_prop/damage") * 5;
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "zhuihun-biao",
    1
  ) + me->query_skill("biye-wu", 1) + me->query_skill("throwing") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;  //2015.4 加入解决伤害为0
  damage = damage / 3 + random(damage / 3);
  damage = damage * (100 - target->query_meridian()) / 100;
  if (me->query_skill("zhuihun-biao", 1) < 2000) lmt = 3 + random(3);
  if (me->query_skill("zhuihun-biao", 1) >= 2000) lmt = 5 + random(5);
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  for (i = 1; i <= lmt; i++) {
    msg = HIW "$N轻声哀叹：第" + chinese_number(i) + "滴泪！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  target->receive_damage("qi", damage, me);
  target->receive_wound("qi", damage / 2, me);
  me->add("neili", -(100 * lmt));
  me->add("jingli", -1000);
  message_vision(HIR "观音有泪，泪众生苦。\n" NOR, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
  //	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);

  if (me->query_skill("zhuihun-biao", 1) > 2000 && me->query_skill("biye-wu", 1) > 2000) {
    message_vision(HIR "紧接着，$N双手合拢，做莲花装，顿时一朵莲花绽放！\n" NOR, me, target);
    damage = me->query_skill(
      "zhuihun-biao",
      1
    ) + me->query_skill(
      "biyun-xinfa",
      1
    ) + me->query_skill("biye-wu", 1) + weapon->query("weapon_prop/damage") * 5;
    if (damage < 10) damage = 10;  //2015.4 加入解决伤害为0
    damage = damage / 3 + random(damage / 3);
    damage = damage * (100 - target->query_meridian()) / 100;
    if (random(ap) > dp / 3) {
      message_vision(HIC "$N低首凝视手中莲花，莲花染血，如红莲怒放！。$n\n" NOR, me, target);
      me->add_temp("apply/attack", extra * 2);
      me->add_temp("apply/damage", extra);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      me->add_temp("apply/attack", -extra * 2);
      me->add_temp("apply/damage", -extra);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      target->add("neili", -damage);
      me->add("neili", -2000);
      me->add("jingli", -1000);
      message_vision(
        HIG "$n目光被红莲吸引，隐隐只见佛光染血，然来是自己的血！。\n" NOR,
        me,
        target,
        damage,
        HBWHT + HIM "气血伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法
      //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);		
    } else {
      message_vision(HIC "$n双眸微闭，窥破红莲破绽，一指点出，佛影消散。\n" NOR, me, target);
    }
  }

  if (me->query_skill("zhuihun-biao", 1) > 3000 && me->query_skill("biye-wu", 1) > 3000) {
    message_vision(HIR "一轮暗器之后，$N低头垂泪：观音有泪，众生皆苦！\n" NOR, me, target);
    if (me->query("jm/tangmen"))
      damage = me->query_skill(
        "zhuihun-biao",
        1
      ) * me->query(
        "dex",
        1
      ) * 3 / 2 + me->query_skill(
        "biye-wu",
        1
      ) * me->query(
        "int",
        1
      ) * 3 / 2 + me->query_skill(
        "biyun-xinfa",
        1
      ) * me->query(
        "int",
        1
      ) * 3 / 2 + me->query_skill(
        "throwing",
        1
      ) + weapon->query("weapon_prop/damage") * 5 + me->query_skill("force", 1);
    else damage = me->query_skill(
      "zhuihun-biao",
      1
    ) * me->query(
      "dex",
      1
    ) + me->query_skill(
      "biye-wu",
      1
    ) * me->query(
      "int",
      1
    ) + me->query_skill(
      "biyun-xinfa",
      1
    ) * me->query(
      "int",
      1
    ) + me->query_skill(
      "throwing",
      1
    ) + weapon->query("weapon_prop/damage") * 3 + me->query_skill("force", 1);
    if (damage < 10) damage = 10;  //2015.4 加入解决伤害为0
    if (random(ap) > dp / 3) {
      damage = damage / 3 + random(damage / 3) + target->query("qi") * 6 / 100;
      damage = damage * (100 - target->query_meridian()) / 100;
      message_vision(HIC "$N颤抖着伸出手掌，一颗珍珠般的暗器位于手心，晶莹欲滴！。$n\n" NOR, me, target);
      message_vision(HIB "一刹那间，$N运转碧叶随风舞手法，将这滴观音泪抛向空中，顿时光芒耀眼！\n" NOR, me, target);
      message_vision(HIY "这滴不存在人间的观音泪，自古以来就没有人能避开！就算是神，也无法避开！\n" NOR, me, target);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      target->add("neili", -damage);
      //	if (!target->is_busy()) target->start_busy(random(3));
      me->add("neili", -3000);
      me->add("jingli", -5000);
      message_vision(
        HIM "n神情呆滞，全身巨震！吐出一大口鲜血！只见胸口已是破了一个大洞！\n" NOR,
        me,
        target,
        damage,
        HBWHT + HIM "气血伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法
      //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);

      inv = all_inventory(target);
      ak = sizeof(inv);
      if (ak > 3) ak = 3;
      dk = random(ak);
      for (equip = 0; equip < dk; equip++) {
        if (inv[equip]->query("equipped")
          && (inv[equip]->query("armor_type") == "armor" || inv[equip]->query("armor_type") == "cloth" || inv[equip]->query("armor_type") == "surcoat")) {
          message_vision(
            HIR "$n身穿的" + inv[equip]->query("name") + HIR + "破了一个大洞，$n手忙脚乱地把它脱了下来，丢弃在地上！\n" + NOR,
            me,
            target
          );
          inv[equip]->unequip();
          //				inv[equip]->reset_action();
          inv[equip]->move(environment(target));
          inv[equip]->set("name", "破碎的" + inv[equip]->query("name"));
          inv[equip]->set("item_old_value", inv[equip]->query("value"));
          inv[equip]->set("value", 0);
          inv[equip]->set("backold_armor_prop", inv[equip]->query("armor_prop"));
          inv[equip]->set("armor_prop", 0);
          //				inv[equip]->set("long", "这是一件碎得无法再穿的"+inv[equip]->query("name")+"。\n");
          if (!target->is_killing(me)) target->kill_ob(me);
          if (!me->is_killing(target)) me->fight_ob(target);
          message_vision(HIW "$N摧毁了$n的装备！$n非得跟你玩命不可！\n" + NOR, me, target);
        }
      }
    } else {
      damage = damage / 9 + random(damage / 9) + target->query("qi") * 2 / 100;
      damage = damage * (100 - target->query_meridian()) / 100;
      message_vision(HIC "$n运转全身真气，化气为盾，挡在要害之处。\n" NOR, me, target);
      me->add("neili", -500);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      message_vision(
        HIY "观音泪击破$n的元气盾后，杀伤力已是减弱不少！\n" NOR,
        me,
        target,
        damage,
        HBWHT + HIM "气血伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法
      //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);
    }
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
