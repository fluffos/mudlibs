// 剑动莫名	

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  object weapon, ob;
  string msg;
  int skill, times, i;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「剑动莫名」只能在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你必须使用武器才能使用「剑动莫名」！\n");
  //	if ( base_name(weapon)!="/clone/weapon/yuenv" ) 
  //		return notify_fail("你必须手持越女朝阳剑才能使用「剑动莫名」！\n"); 
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query_skill("sword", 1) < 1000)
    return notify_fail("你的基本剑法的火候还不到家, 不能使用这一绝技 !\n");
  //	if ( me->query_skill_mapped("sword") != "wuming-jianfa")
  //		return notify_fail("你必须激发无名剑法才能使用「剑动莫名」！\n");   
  //	if ( me->query_skill_mapped("force") != "taixuan-gong")
  //		return notify_fail("你必须激发太玄功才能使用「剑动莫名」！\n"); 	 
  if ((int)me->query_skill("wuming-jianfa", 1) < 500)
    return notify_fail("你的无名剑法的火候还不到家, 不能使用这一绝技 !\n");
  if ((int)me->query_skill("taixuan-gong", 1) < 500)
    return notify_fail("你的太玄功的火候还不到家, 不能使用这一绝技 !\n");
  if ((int)me->query("neili") < (int)me->query_skill("wuming-jianfa", 1) * 4)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query("max_neili") < 500000)
    return notify_fail("你的内力修为不够！\n");
  if ((int)me->query("max_jingli") < 500000)
    return notify_fail("你的精力修为不够。\n");
  if ((int)me->query("jingli") < (int)me->query_skill("wuming-jianfa", 1) * 4)
    return notify_fail("你的精力不够。\n");
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  skill = me->query_skill("wuming-jianfa", 1) / 3;
  if (me->query_skill_mapped("force") != "taixuan-gong") skill += (int)me->query_skill(
    "wuming-jianfa",
    1
  ) / 2;  //2018.9.5阿飞改，不使用本门特内则减益	
  //	if ( base_name(weapon)=="/clone/weapon/yuenv" )  skill -= me->query_skill("wuming-jianfa", 1)/3; 
  if ((string)weapon->query("id") == "yuenv chaoyang jian") skill -= me->query_skill(
    "wuming-jianfa",
    1
  ) / 3;  //2018.3.25阿飞改，拿特殊武器有加成

  msg = MAG "\n$N脸现幽思,往事如潮涌上心头,手中剑望空斜指一股怨气从剑尖散发弥漫开来！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  me->clean_up_enemy();
  ob = me->select_opponent();
  me->add_temp("apply/strength", -skill);
  me->add_temp("apply/attack", -skill);
  me->add_temp("apply/damage", -skill);
  times = me->query_skill("wuming-jianfa", 1) / 60;
  if (times < 1) times = 1;
  if (me->query("jm/wuming")) {
    if (times > 100 + (int)me->query_temp("lianzhao_max_add") * 4) times = 100 + (int)me->query_temp("lianzhao_max_add") * 4;
  } else {
    if (times > 50 + (int)me->query_temp("lianzhao_max_add") * 2) times = 50 + (int)me->query_temp("lianzhao_max_add") * 2;
  }

  me->add_temp("lianzhao", times);  //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
  for (i = 0; i < times; i++) {
    if (!ob) break;
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  }
  me->add_temp("apply/strength", skill);
  me->add_temp("apply/attack", skill);
  me->add_temp("apply/damage", skill);
  me->add("neili", -(200 * times));
  me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记	
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
