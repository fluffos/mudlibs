// yinrou.c 「葵花大法」

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;
string *order = ({ "关元穴", "檀中穴", "肩井穴", "太阳穴", "气海穴", "百汇穴", "腹结穴", "涌泉穴", "大椎穴" });
int perform(object me, object target) {
  string msg;
  int extra, ap, dp, damage;
  int i, attack_time;
  object weapon;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你手中没有装备剑类武器！\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  if ((int)me->query("max_neili") < 200000)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("max_jingli") < 200000)
    return notify_fail("你的精力修为不够。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query_skill("pixie-jian", 1) < 1000)
    return notify_fail("你的辟邪剑法不够!不能贯通使用！\n");
  if ((int)me->query_skill("kuihua-dafa", 1) < 1000)
    return notify_fail("你的葵花大法不够高!不能贯通使用！\n");
  if ((int)me->query_skill("jiuyin-zhenjing", 1) || (int)me->query_skill("jiuyang-shengong", 1))
    return notify_fail("你的杂学太多，无法对本门武功贯通使用！\n");
  if (me->query_skill_mapped("force") != "kuihua-xinfa")
    return notify_fail("不使用本门内功，如何使用本门绝学!\n");
  if (me->query_skill_mapped("sword") != "kuihua-dafa")
    return notify_fail("你没有使用葵花大法，不能使用「葵花大法」。\n");
  if ((string)me->query("gender") == "女性")
    return notify_fail("自古就没有女子可以使用.\n");
  if ((string)me->query("gender") == "男性")
    return notify_fail("欲练神功，必先自宫，欲使神功，快快进宫.\n");
  if ((string)me->query("genderbak") == "男性")
    return notify_fail("你个假太监，赶紧去割了.\n");
  if (!(int)me->query("breakup"))
    return notify_fail("你任督二脉未通,无法使用「葵花大法]\n" NOR);
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  msg = HBWHT "$N贯通日月神教武学，使出了日月神教的绝学之精髓！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1	
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "kuihua-dafa",
    1
  ) + me->query_skill("pixie-jian", 1) + me->query_skill("force") + me->query_skill("sword");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  extra = me->query_skill("kuihua-dafa", 1) / 10;
  attack_time = me->query_skill("kuihua-dafa", 1) / 600;
  if (attack_time > 10) attack_time = 10;
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  msg = HIR "$N忽然化身为二，幻出左右两个身影高速滑向$n，手中$w幻化不定，招招紧逼$n的$l!" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIC "$N的人影变成了几个，．．．．一个接一个刺向$n。\n" NOR;
  message_vision(msg, me, target);
  for (i = 0; i < attack_time; i++) {
    msg = HIW "$n身旁出现人影，向$n的" + HIY + (order[random(7)]) + NOR + HIW + "刺了过去！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  i = attack_time;
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->add("neili", -1000);

  if ((int)me->query_skill(
    "kuihua-dafa",
    1
  ) > 2000 && (int)me->query_skill("pixie-jian", 1) > 2000) {
    msg = YEL "\n\n只见$N双目一滞，面上闪过一阵异彩，身法突然加快，如影随形，蹂身而上！\n" NOR;
    msg += YEL "随着一声凄厉的长啸，$N手中宝剑绽开朵朵剑花，猛地罩向$n全身各处命门大穴！\n" NOR;
    message_vision(msg, me, target);
    me->add_temp("apply/attack", extra * 2);
    me->add_temp("apply/damage", extra);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    me->add_temp("apply/attack", -extra * 2);
    me->add_temp("apply/damage", -extra);
    if (random(ap) > dp / 3) {
      damage = me->query_skill(
        "kuihua-dafa",
        1
      ) * 5 + me->query_skill(
        "kuihua-xinfa",
        1
      ) * 5 + me->query_skill(
        "pixie-jian",
        1
      ) * 5 + me->query_skill("sword", 1) + me->query_skill("dodge") + me->query_skill("force");
      damage = damage / 4 + random(damage / 4);
      damage = damage * (100 - target->query_meridian()) / 100;
      if (damage < 1000) damage = 1000;
      msg = RED "$n惊叫一声，" + HIY + (order[random(7)]) + NOR + RED + "部位血花飞溅,\n" NOR;
      switch (random(2)) {
        case 1:
          {
            msg += RED "$n“哇”地一口鲜血从口中喷出！\n" NOR;
            break;
          }
        default:
          msg += RED "$n身形一震, 一股鲜血从口中喷出,直喷向$N,但见$N头一歪,轻松的躲了过去！！\n" NOR;
      }
      switch (random(2)) {
        case 1:
          {
            target->add("neili", -damage);
            target->receive_wound("qi", damage, me);
            target->receive_damage("qi", damage / 2, me);
            message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
            //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
            break;
          }
        default:
          {
            target->add("jingli", -damage);
            target->receive_wound("jing", damage, me);
            target->receive_damage("jing", damage / 2, me);
            message_vision(msg, me, target, damage, HBWHT + HIM "精神伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
            //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
          }
      }
      me->add("neili", -1000);
      me->add("jingli", -1000);
    } else {
      message_vision(CYN "$p冷笑一声，身形虚晃几下闪了开去！\n" NOR, me, target);
    }
  }
  if ((int)me->query_skill(
    "kuihua-dafa",
    1
  ) > 3000 && (int)me->query_skill("pixie-jian", 1) > 3000) {
    message_vision(RED "\n$N猛地纵起，向$n扑去，手指一弹，细针飞了出去，插向$n右目。\n\n" NOR, me, target);
    if (me->query("jm/riyue")) damage = me->query_skill(
      "kuihua-dafa",
      1
    ) * me->query(
      "int",
      1
    ) * 3 / 2 + me->query_skill(
      "kuihua-xinfa",
      1
    ) * me->query(
      "int",
      1
    ) * 3 / 2 + me->query_skill(
      "pixie-jian",
      1
    ) * me->query(
      "dex",
      1
    ) * 3 / 2 + me->query_skill(
      "kuihua-feiying",
      1
    ) * me->query(
      "dex",
      1
    ) * 3 / 2 + me->query_skill("sword") + me->query_skill("dodge") + me->query_skill("force") + me->query_dex(1) * me->query(
      "dex",
      1
    );
    else damage = me->query_skill(
      "kuihua-dafa",
      1
    ) * me->query(
      "int",
      1
    ) + me->query_skill(
      "kuihua-xinfa",
      1
    ) * me->query(
      "int",
      1
    ) + me->query_skill(
      "pixie-jian",
      1
    ) * me->query(
      "dex",
      1
    ) + me->query_skill(
      "kuihua-feiying",
      1
    ) * me->query(
      "dex",
      1
    ) + me->query_skill("sword") + me->query_skill("dodge") + me->query_skill("force") + me->query_dex(1) * me->query(
      "dex",
      1
    );
    damage = damage / 3 + random(damage / 3) + target->query("qi") * 5 / 100;
    damage = damage * (100 - target->query_meridian()) / 100;
    if (random(ap) > dp / 3) {
      target->add("neili", -damage);
      target->add("jingli", -damage);
      target->apply_condition("no_perform", 20);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 3, me);
      me->add("neili", -2000);
      message_vision(HIR "\n$n猝不及防，大叫一声，右眼中针！\n" NOR, me, target);
      if (random(4) == 1) {
        target->map_skill("parry");  //下特殊招架
        message_vision(
          RED "$n剧痛无比，浑身抽搐，" + HIY + (order[random(7)]) + NOR + RED + "被封，无法招架。\n" NOR,
          me,
          target
        );
      }
      message_vision(
        HIY "$N感觉细针正插在自己的瞳仁之中，如果这针直贯入脑，便有性命之忧！\n" NOR,
        me,
        target,
        damage,
        HBWHT + HIM "气血伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法
      //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    } else {
      message_vision(HIY "\n可是$n看破了$N的企图，飞身闪了开去。\n" NOR, me, target);
    }
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
