#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

#define PI "「" HIW "群邪辟易" NOR "」"

inherit F_SSERVER;

string *finger_name = ({ "左手中指", "左手无名指", "左手食指",
  "右手中指", "右手无名指", "右手食指",
});

int perform(object me, object target) {
  string msg, name;
  object weapon;
  int i, extra, attack_time;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail(PI "只能对战斗中的对手使用。\n");
  if (objectp(weapon = me->query_temp("weapon"))) {
    if ((string)weapon->query("skill_type") != "sword" || me->query_skill_mapped("sword") != "kuihua-dafa")
      return notify_fail("你使用的武器不对，难以施展" PI "。\n");
  } else {
    if (me->query_skill_mapped("unarmed") != "kuihua-dafa")
      return notify_fail("你使用的武器不对，难以施展" PI "。\n");
  }
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
  if ((int)me->query_skill("kuihua-dafa", 1) < 300)
    return notify_fail("你的葵花神功不够娴熟，难以施展" PI "。\n");
  if ((int)me->query_skill("pixie-jian", 1) < 300)
    return notify_fail("你的辟邪剑法不够娴熟，难以施展" PI "。\n");
  if (me->query("neili") < (int)me->query_skill("kuihua-dafa", 1))
    return notify_fail("你现在的真气不足，难以施展" PI "。\n");
  if (me->query("jingli") < (int)me->query_skill("kuihua-dafa", 1))
    return notify_fail("你现在的精力不足，难以施展" PI "。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力修为还不够高。\n");
  if ((int)me->query("max_jingli") < 10000)
    return notify_fail("你的精力修为还不够高。\n");
  if ((int)me->query_skill("kuihua-dafa", 1) < 300 && (int)me->query_skill("kuihua-xinfa", 1) < 300)
    return notify_fail("你的葵花神功不够娴熟。\n");
  //	if( me->query_skill_mapped("force") != "kuihua-xinfa" )
  //		return notify_fail("你没有使用葵花神功。\n");
  if ((string)me->query("gender") == "女性")
    return notify_fail("自古就没有女子可以使用.\n");
  if ((string)me->query("gender") == "男性")
    return notify_fail("欲练神功，必先自宫，欲使神功，快快进宫.\n");
  if ((string)me->query("genderbak") == "男性")
    return notify_fail("你个假太监，赶紧去割了.\n");
  if (target && !living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  if (me->query_temp("weapon"))
    name = "手中" + weapon->name();
  else
    name = finger_name[random(sizeof(finger_name))];

  msg = HIW "$N" HIW "身形忽然变快，蓦的冲向$n" HIW "，" + name + HIW "幻作数道虚影，顿时无数星光一齐射向$n" HIW "！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  extra = me->query_skill("kuihua-dafa", 1) / 10;
  attack_time = me->query_skill("kuihua-dafa", 1) / 600;
  if (attack_time < 1) attack_time = 1;
  if (me->query("jm/riyue")) {
    if (attack_time > 100 + (int)me->query_temp("lianzhao_max_add") * 4) attack_time = 100 + (int)me->query_temp("lianzhao_max_add") * 4;
  } else {
    if (attack_time > 50 + (int)me->query_temp("lianzhao_max_add") * 2) attack_time = 50 + (int)me->query_temp("lianzhao_max_add") * 2;
  }

  msg = HIW "$N的人影变成了几个，．．．．\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  //	me->add_temp("lianzhao", attack_time);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  me->add_temp("apply/strength", extra);
  for (i = 0; i < attack_time; i++) {
    msg = HIC "突然在$n的身旁出现一个人影，" + name + HIC "向$n刺了过去！\n" NOR;
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
    me->add("neili", 10);
    me->add("jingli", 10);
  }
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->add_temp("apply/strength", -extra);
  //	me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
