#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me)
{
    object weapon;
    int jing_cost,xtint,jineng_exp_add;
	int flag;
	

	xtint = me->query("int",1);
    jing_cost = me->query_skill("kuihua-dafa",1);

	if( environment(me)->query("no_fight") )
		return notify_fail("这里是是非之地，不可久留，别练功了，快走吧！\n");	
    if( me->is_fighting() )
        return notify_fail("「自宫决」不能在战斗中演练。\n");
	if ( !wizardp(me) && (string)me->query("family/family_name") != "日月神教") 
		return notify_fail("只有日月神教弟子才能使用「自宫决」。\n");
    if(me->is_busy())
        return notify_fail("你现在正忙着！\n");
    if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你必须先去找一把剑。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if (me->query_temp("apply/shade_vision")) 
		return notify_fail("纳尼！隐身了还在自宫？恐怕会搞错地方吧。\n"); 	
	if ( (string)me->query("gender")=="女性" )
		return notify_fail("自古就没有女子可以自宫的.\n");
	if ( (string)me->query("gender")=="男性" )
		return notify_fail("葵花宝典第一页：欲练神功，必先自宫。\n");
	if ( (string)me->query("genderbak")=="男性" )
		return notify_fail("葵花宝典第二页：即使自宫，未必成功。\n");		
    if (me->query_skill("kuihua-dafa",1) < 100)
        return notify_fail("你的葵花大法不够娴熟！\n");
    if ( me->query("neili") < jing_cost )
        return notify_fail("你的内力不够！\n");
    if ( me->query("jingli") < jing_cost )
        return notify_fail("你的精力不够！\n");
	if ((int)me->query("max_neili")<100000)								
		return notify_fail("你的内力修为不够。\n");
	if ((int)me->query("max_jingli")<100000)								
		return notify_fail("你的精力修为不够。\n");
    if (me->query_skill("kuihua-xinfa",1) < 300)
        return notify_fail("你的葵花心法等级不够！\n");
    if (me->query_skill("pixie-jian",1) < 300)
        return notify_fail("你的辟邪剑法等级不够！\n");
	if ( me->query_skill_mapped("force") != "kuihua-xinfa")
		return notify_fail("你必须配合葵花心法才能使用「自宫决」！\n"); 
	if (me->query_skill_mapped("sword") != "kuihua-dafa")
		return notify_fail("你没正确激发该技能 。\n");	
    if (me->query_skill("sword",1)<= me->query_skill("kuihua-dafa",1))
        return notify_fail("你的基本剑法不够，无法通过演练「自宫决」！\n");	
    if (me->query_skill("pixie-jian",1)<= me->query_skill("kuihua-dafa",1))
        return notify_fail("你的辟邪剑法不够，无法通过演练「自宫决」！\n");	
    if( me->query("jing") < jing_cost )
        return notify_fail("你现在太累了，无法集中精神演练「自宫决」！\n");
    if( me->query_skill("kuihua-dafa",1)>(me->query("xyzx_sys/level")+300)*2 )
        return notify_fail("你的实战经验不够，无法体会「自宫决」！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	write(HIW "你使出辟邪剑法之「自宫决」，将手中" + weapon->name() + HIW "挥舞了几下，双腿一颤，葵花大法似乎更精进了一些。\n" + NOR);

	if(me->query("xyhy_type")==2) flag = 5/4;	//2016.6.20阿飞改，黄金会员自练速度为1.25倍
	else flag = 1;
	if (me->query_temp("jineng_exp_add")) jineng_exp_add = (int)me->query_temp("jineng_exp_add",1);	//处于技能自练提升状态时
	else jineng_exp_add = 0;	
    me->add("neili", -jing_cost);
	me->add("jingli", -jing_cost);	
    me->improve_skill("kuihua-dafa", 100 + (int)me->query_int(1)*(jineng_exp_add+100)/100*xtint*me->query_exp_times()*flag*18/10);
	write(HIG"你的「葵花大法」进步了！\n" + NOR);
	me->start_busy(1);
    return 1;
}

