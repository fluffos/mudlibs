// zhu.c 九羽天诛
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


inherit F_SSERVER;

int perform(object me, object target)
{
	int i, extra, max;
	object weapon;

	if (!target ) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「九羽天诛」只能在战斗中对对手使用。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
//	if ( me->query_skill_mapped("force") != "bahuang-gong" )
//		return notify_fail("没有八荒六合唯我独尊功的催动无法使出「九羽天诛」！\n");
//	if ( me->query_skill_mapped("sword") != "tianyu-qijian" )
//		return notify_fail("你未使用天羽奇剑，无法使出「九羽天诛」！\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你必须在使用剑时才能使出「九羽天诛」！\n");
	if( (int)me->query_skill("tianyu-qijian", 1) < 500 )
		return notify_fail("你的天羽奇剑还不够娴熟，使不出「九羽天诛」。\n");
	if( (int)me->query_skill("bahuang-gong",1) < 500 )
		return notify_fail("你的内功等级不够，使不出「九羽天诛」。\n");
	if( (int)me->query("max_neili") < 200000 )
		return notify_fail("你现在内力修为太弱，使不出「九羽天诛」。\n");      
	if( (int)me->query("max_jingli") < 200000 )
		return notify_fail("你现在精力修为太弱，使不出「九羽天诛」。\n");   
	if( (int)me->query("neili") < (int)me->query_skill("tianyu-qijian", 1)*4 )
		return notify_fail("你现在真气太弱，使不出「九羽天诛」。\n"); 
	if( (int)me->query("jingli") < (int)me->query_skill("tianyu-qijian", 1) )
		return notify_fail("你现在精力太弱，使不出「九羽天诛」。\n"); 
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

	extra = me->query_skill("tianyu-qijian", 1)/15;
	if ( me->query_skill_mapped("force") != "bahuang-gong") extra -= (int)me->query_skill("tianyu-qijian", 1)/18;	//2018.9.5阿飞改，不使用本门特内则减益
	if ((string)weapon->query("id") == "tianyu jian") extra += (int)me->query_skill("tianyu-qijian", 1)/15;	//2018.3.25阿飞改，拿特殊武器有加成	
	max = me->query_skill("tianyu-qijian", 1)/600;		

	message_vision(HIR"\n只听一声宝剑破空的龙吟之声，$N手中的"+weapon->name()+HIR"顿时闪烁出耀眼的光芒，一股股寒气弥\n"+
	               "漫于周身。忽然$N招式徒然一快，使出一招「"HIW"九羽天诛"HIR"」，霎时间满天剑影铺天盖地，\n"+
	               "仿佛三九天的鹅毛大雪扑面而来，直压向$n的周身要害，速度更是快得惊人！\n"NOR, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	if (max < 1) max = 1;
	if (me->query("jm/lingjiu"))
	{
		if (max > 100+(int)me->query_temp("lianzhao_max_add")*4) max = 100+(int)me->query_temp("lianzhao_max_add")*4;
	} else 
	{
		if (max > 50+(int)me->query_temp("lianzhao_max_add")*2) max = 50+(int)me->query_temp("lianzhao_max_add")*2;
	}
	
//			me->add_temp("lianzhao", max);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
        me->add_temp("apply/strength", extra);
        me->add_temp("apply/attack", extra); 
		me->add_temp("apply/damage", extra);
		for ( i=0; i<max; i++ )
		{
	        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		}
		me->add("neili",-max*100);
		me->add("jingli",-max*10);    
        me->add_temp("apply/strength", -extra);
        me->add_temp("apply/attack", -extra);
		me->add_temp("apply/damage", -extra);
//		me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记	
		
        me->start_busy(1);
        return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}