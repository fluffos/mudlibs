// piaomiao.c 缥缈剑意
 
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>

inherit F_SSERVER;

int perform(object me, object target)
{
         string msg;
         int extra, damage,damage1,damage2,age,ap,dp;
		 object weapon;

	if( !target ) target = offensive_target(me); 
    if( !target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("缥缈剑只能在战斗中对对手使用。\n");
    if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
       return notify_fail("你必须使用武器才能使用「缥缈剑」！\n"); 
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n");    
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if(me->is_busy())
		return notify_fail("你现在没空！！\n");
	if( (int)me->query("max_neili") < 500000  ) 
		return notify_fail("你的内力不够。\n");
	if ((int)me->query("max_jingli")<1000000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你的精力不够。\n");	
	if( (int)me->query("neili") < 10000 ) 
		return notify_fail("你的内力不够。\n");
    if( !wizardp(me) &&(int)me->query_skill("tianyu-qijian", 1) < 1000 )
		return notify_fail("你的天羽奇剑等级不够!不能贯通使用！\n");
	if( !wizardp(me) &&(int)me->query_skill("liuyang-zhang", 1) < 1000 )
		return notify_fail("你的天山六阳掌等级不够!不能贯通使用！\n");
	if(!wizardp(me) && (int)me->query_skill("bahuang-gong", 1) < 1000 )
		return notify_fail("你的本门内功不够高!不能贯通使用！\n");
	if (me->query_skill_mapped("sword") != "tianyu-qijian")
		return notify_fail("你没正确激发该技能 。\n");
    if ( !wizardp(me) && me->query_skill_mapped("force") != "bahuang-gong")
        return notify_fail("不使用本门内功，如何使用本门绝学!\n");
	if (!(int)me->query("breakup"))
		return notify_fail("你任督二脉未通,无法使用「缥缈剑意」。\n"NOR);
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
    msg = HBWHT "$N贯通灵鹫宫武学，使出了灵鹫宫的绝学之精髓！\n" NOR;	   
    message_vision(msg, me, target);	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1
        message_vision(MAG"\n$N"+weapon->name()+MAG"微微晃动，当气势蓄至巅峰时，双眉耸竖，大步前跨，一股彻骨的剑气，立即潮涌而去。\n"NOR,me,target);
		age = 1;
		if (me->query("age")==60 || me->query("age")==120 || me->query("age")==180 || me->query("age")==240 || me->query("age")==300 || me->query("age")==360 || me->query("age")==420 || me->query("age")==480 || me->query("age")==540 || me->query("age")==600 || me->query("age")==660 || me->query("age")==720 || me->query("age")==780 || me->query("age")==840 || me->query("age")==900 || me->query("age")==960 ) 
			age = 60;

        extra = me->query_skill("tianyu-qijian", 1)/10 + me->query_skill("bahuang-gong", 1)/10;
	ap = me->query("xyzx_sys/level") + me->query_skill("tianyu-qijian", 1) +me->query_skill("liuyang-zhang", 1)+ me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
         me->add_temp("apply/strength", extra);
         me->add_temp("apply/attack", extra);
         me->add_temp("apply/damage", extra); 
         //  if (!target->is_busy() && random(3)==1)  target->start_busy(3);
           msg = HIC "$w"HIC"在$N用劲的指引下，忽似轻巧起来，破空之声反收至净尽，变成沉雄的呼啸，更增使人心寒胆落的威势！" NOR;  
           COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1,msg); 
           msg = HIC "$N挥剑起舞，一时剑气纵横，生出亦静亦动，静时有若波平如镜的大海，动时则似怒海激涛，变化莫测！" NOR;             
            COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1,msg);      
           msg = HIC "$N每一姿态都妙至毫巅，每一个动作都表现出人类体能的极限，既文静又激烈，形成惊天地泣鬼神的气势！" NOR; 
           COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1,msg);	
         me->add_temp("apply/strength", -extra);
         me->add_temp("apply/attack", -extra);
	     me->add_temp("apply/damage", -extra);
		me->add("neili", -1000);
		me->add("jingli", -2000);
		 
if ( (int)me->query_skill("tianyu-qijian", 1) > 2000 && me->query_skill("liuyang-zhang", 1)>2000)
{
		message_vision(HIW"\n突然间天空中一声巨响，一道闪电划破夜空劈在"+weapon->name()+HIW"上，$N挟雷电之威，向$n扑了过去。\n"NOR,me,target);
		damage1 = me->query_skill("tianyu-qijian",1) + me->query("jiali") + me->query_skill("sword", 1)+ me->query_skill("force") + me->query_skill("bahuang-gong",1)+ me->query_skill("unarmed")+ me->query_skill("liuyang-zhang",1);
		damage = damage1/3 + random(damage1/3);
		damage = damage*(100-target->query_meridian())/100;
	if (random(ap) > dp/3 )
	{
		me->add("neili", -1000);
		me->add("jingli", -2000);		
        target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);		
		message_vision(HIR"结果$n躲闪不及被$N攻了正着，" + weapon->name() + HIR"上的"HIC"电劲"HIR"乘机钻入$n体内。\n"NOR,me,target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		message_vision(HIR"$n轻蔑一笑，屈指一弹，正好击在" + weapon->name() + HIR"的剑脊，$N这一招落在空处。\n"NOR,me,target);
	}

}

if ( (int)me->query_skill("tianyu-qijian", 1) > 3000 && me->query_skill("liuyang-zhang", 1)>3000)
{	
	if (me->query("jm/lingjiu")) damage1 = me->query_skill("tianyu-qijian",1)*me->query("con",1)*3/2 + me->query_skill("liuyang-zhang",1)*me->query("con",1)*3/2+ me->query_skill("bahuang-gong",1)*me->query("per",1)*age + me->query("jiali") + me->query_skill("sword", 1)+ me->query_skill("force",1) + me->query_skill("unarmed",1);
	else damage1 = me->query_skill("tianyu-qijian",1)*me->query("con",1) + me->query_skill("liuyang-zhang",1)*me->query("con",1)+ me->query_skill("bahuang-gong",1)*me->query("per",1) + me->query("jiali") + me->query_skill("sword", 1)+ me->query_skill("force",1) + me->query_skill("unarmed",1);
	damage = damage1/3 + random(damage1/3) + target->query("qi")*4/100;
	damage = damage*(100-target->query_meridian())/100;
        me->add_temp("apply/strength", extra);
        me->add_temp("apply/attack", extra);
		weapon->unequip();
		damage2 = me->query_skill("zhemei-shou",1)+random( me->query_skill("liuyang-zhang",1));
		damage2 = damage2*(100-target->query_meridian())/100;
		target->receive_damage("qi",damage2,me);
		target->receive_wound("qi",damage2/2,me);
		msg = HIW"【弹 梅】\n"NOR;
        msg += YEL "$N微微一笑，左手向$n轻轻弹出，好像是要弹去梅花上面的露珠！\n" NOR;
		message_vision(msg, me, target, damage2, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage2 +"。\n" NOR);		
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"), 1);                                             
		damage2 = me->query_skill("zhemei-shou",1)+random( me->query_skill("liuyang-zhang",1));
		damage2 = damage2*(100-target->query_meridian())/100;
        target->receive_damage("qi",damage2,me);
		target->receive_wound("qi",damage2/2,me);
		msg = HIW"【落 雪】\n"NOR;
        msg += YEL "$N双手急挥，左右摇摆，幻出漫天梅花，飞雪似的向$n落来！\n" NOR;
		message_vision(msg, me, target, damage2, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage2 +"。\n" NOR);
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"), 2);
		damage2 = me->query_skill("zhemei-shou",1)+random( me->query_skill("liuyang-zhang",1));
		damage2 = damage2*(100-target->query_meridian())/100;
        target->receive_damage("qi",damage2,me);
		target->receive_wound("qi",damage2/2,me);
		msg = HIW"【散花香】\n"NOR;
        msg += YEL "$n突然闻到一股若有若无的香味，心猿意马之中$N的双手已向$p胸口拍来！\n" NOR;
        message_vision(msg, me, target, damage2, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage2 +"。\n" NOR);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"), 3);
        msg = HIR "$N双手幻出漫天手影，宛若朵朵梅花，将$n笼罩在一片梅海之中！\n"NOR;
		message_vision(msg, me, target);
		weapon->wield();
        me->add_temp("apply/strength", -extra);
        me->add_temp("apply/attack", -extra);
		me->add("neili", -1000);
		me->add("jingli", -2000);
	if (random(ap) > dp/3 )
	{
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"), 4);
		me->add("neili", -1000);
		me->add("jingli", -2000);
        target->receive_damage("qi",damage,me);  
		target->receive_wound("qi",damage/2,me); 		
//		target->apply_condition("no_enforce", 10);
		message_vision(HIB"$N突然之间返老还童，凝聚六十年功力击出一掌，$n被打的横飞出去，顿时上气不接下气。\n"NOR,me,target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		message_vision(HIB"$N运转八荒唯我独尊功，化水成冰，屈指一弹，$n只觉得的某处穴位一阵凉意，不知不觉中了一道生死符。\n"NOR,me,target);
		target->apply_condition("ss_poison", 30);
	}
}
	me->start_busy(1);
	return 1;
 }

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
} 