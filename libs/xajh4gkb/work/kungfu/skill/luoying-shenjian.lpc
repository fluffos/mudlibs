int valid_learn(object me) {
  object ob;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query_skill("bibo-shengong", 1) < 100)
    return notify_fail("你的碧波神功火候还不够。\n");
  if (me->query("family/family_name") != "桃花岛")
    return notify_fail("你不是桃花岛门人，无法学习本门技能。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够，不能练落英神剑。\n");
  if (!objectp(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  return 1;
}
int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}
