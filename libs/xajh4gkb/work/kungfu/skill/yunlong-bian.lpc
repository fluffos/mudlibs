int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("max_neili") < 10000 )
		return notify_fail("你的内力不足，没有办法练云龙鞭法, 多练些内力再来吧。\n");
	if (me->query("family/family_name")!="云龙门")
		return notify_fail("不加入云龙门，学不了本门技能。\n");	
    if ((int)me->query_skill("yunlong-shengong", 1) < 100)
		return notify_fail("你的云龙神功火候不够，无法学习本门技能。\n");	
	if ((int)me->query_skill("whip", 1) < 100)
		return notify_fail("你的鞭法基础太浅。\n");
	if ( !objectp(weapon = me->query_temp("weapon")) || ( string)weapon->query("skill_type") != "whip" )
		return notify_fail("你必须先找一条鞭子才能练鞭法。\n");
	if (me->query_skill("whip", 1) <=me->query_skill("yunlong-bian", 1))
		return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	return 1;
}

int practice_skill(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "whip")
	if ( !objectp(weapon = me->query_temp("secondary_weapon")) || ( string)weapon->query("skill_type") != "whip" )
		return notify_fail("你使用的武器不对。\n");
	if (me->query("family/family_name")!="云龙门")
		return notify_fail("不加入云龙门，练习不了本门技能。\n");				
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够练云龙鞭法。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 5);
	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

string perform_action_file(string action)
{
    return __DIR__"yunlong-bian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	string msg;
	int ap,dp, damage1,damage2,damage,liannum;
	object weapon1,weapon2;
	weapon1 = me->query_temp("weapon");
	weapon2 = victim->query_temp("weapon");
    ap = me->query_skill("yunlong-bian",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("yunlong-bian",1);
	damage2 = (int)me->query_skill("yunlong-bian",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("yunlong-shengong",1) < 100 || me->query_skill("yunlong-bian",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "yunlong-shengong") return 0;
	if (!objectp(weapon1 = me->query_temp("weapon")) || (string)weapon1->query("skill_type") != "whip") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIY "只见$N急速挥舞" + weapon1->name() + HIY"，转出无数个大小圈子，以阴柔之劲缠向对方！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		msg = HIG "$N顿悟"+me->query("cognize")+HIG"，手中" + weapon1->name() + HIG"如蛟龙出水，"NOR;
		if (objectp(weapon2 = victim->query_temp("weapon")))
		{
			msg += HIG "缠向"+weapon2->name()+HIG"，"NOR;
			if (random(3)==0)
			{
				msg += HIG "$n气运手臂用力一拽，" + weapon1->name() + HIG"却无法从"+weapon2->name()+HIG"的缠绕中脱开，情急之下只好放弃了手中的兵刃。\n" NOR;
				weapon2->unequip();
				weapon2->move(environment(victim));
//				victim->reset_action();
				message_vision(msg, victim,me );				
			}
			else
			{
				msg += HIG "$n气运手臂用力一拽，结果竟然脱臼了。\n"NOR;
				victim->receive_damage("jing", damage,me);
				victim->receive_wound("jing", damage/3,me);
				message_vision(msg, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
			}
		}
		else
		{
			msg += HIG "缠向$n手臂，$n运气一震，哪知$N内劲诡异至极，结果竟然皮开肉腚。\n"NOR;
			victim->receive_damage("jing", damage,me);
			victim->receive_wound("jing", damage/3,me);
			message_vision(msg, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		}
		me->add("jingli",-100);
		if (!victim->is_busy()) victim->start_busy(1);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/yunlong") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIM"$N融汇云龙门武学精髓，鞭化飞龙，鞭梢直点$n咽喉要害，$n连忙侧身躲避，结果点中$n右腰，$n身体一软，倒地不起。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}


