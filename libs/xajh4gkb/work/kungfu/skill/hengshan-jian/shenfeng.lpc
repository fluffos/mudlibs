//Cracked by Kafei
//hengshan.c 恒山神峰剑 by maco

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_DBASE;
inherit F_SSERVER;

int perform(object me, object target) {
  object weapon;
  int skill, ap, dp;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「恒山神峰」只能对战斗中的对手使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你手中无剑，如何能施展「恒山神峰」？\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->query_skill("hengshan-jian", 1) < 300)
    return notify_fail("你的恒山剑法造诣不足以使出「恒山神峰」！\n");
  if (me->query_skill("baiyun-xinfa", 1) < 300)
    return notify_fail("你的白云心法造诣不足以使出「恒山神峰」！\n");
  if (me->query("neili") < 1000)
    return notify_fail("你的内力不够施展「恒山神峰」！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  //	if (me->query_skill_mapped("sword") != "hengshan-jian")
  //		return notify_fail("你没正确激发该技能 。\n");
  //	if (me->query_skill_mapped("force") != "baiyun-xinfa")
  //		return notify_fail("你未使用白云心法。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  message_vision(HIW "\n$N使出「恒山神峰」，峰峦如聚，波涛如怒！\n" NOR, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1		
  skill = me->query_skill("hengshan-jian", 1) / 10;
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "hengshan-jian",
    1
  ) + me->query_skill("sword") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  if (random(ap) > dp / 3) {
    message_vision(
      HIG "\n但见寒光陡闪，$N手中" + weapon->query("name") + HIC "越使越快，有如恒山的高低不平的奇峰，正是" + HIR "「恒山神峰」" NOR + HIC "！\n" NOR,
      me,
      target
    );
    me->add_temp("apply/damage", skill);
    me->add_temp("apply/attack", skill);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add_temp("apply/damage", -skill);
    me->add_temp("apply/attack", -skill);
  } else {
    message_vision(HIW "\n但是$n严加戒备，全身门户，无不守备綦谨，难以奏效！\n" NOR, me, target);
  }
  me->add("neili", -300);
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
