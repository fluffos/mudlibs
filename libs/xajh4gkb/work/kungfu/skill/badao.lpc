string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

string query_parry_msg(string limb) {
  return parry_msg[random(sizeof(parry_msg))];
}

int practice_skill(object me) {
  return notify_fail("霸刀博大精深，无法简单的通过练习进步。\n");
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  string *desc;
  object weapon;
  int ap, dp, damage1, damage2, damage, liannum;
  ap = (me->query_str(1) + me->query_con(1)) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = (victim->query_str(1) + victim->query_con(1)) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  weapon = me->query_temp("weapon");
  damage1 = (int)me->query_skill("badao", 1);
  damage2 = (int)me->query_skill(
    "badao",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("badao", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "shenghuo-shengong") return 0;

  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade") return 0;

  desc = ({
    HIY "$N" HIY "纵身而起，举起手中" + weapon->name() + HIY "从天劈下，犹如一道闪电划向$n" HIY "。\n" NOR,
    HIC "$N" HIC "轻旋" + weapon->name() + HIC "，单刀直劈，招式简单之极，却刚猛无比。\n" NOR,
    HIR "$N" HIR "挥动手中" + weapon->name() + HIR "，顿时飞沙走石，夹杂着凌厉的刀势，将$n" HIR "笼罩。\n" NOR,
  });
  if (random(ap) > dp / 3 && me->query("jiali") > 0 && random(7) == 1) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(desc[random(sizeof(desc))], me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIR "$N展现" + me->query("cognize") + HIR "的力量，一时间刀光霸道无双！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/badao")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIR "$N顿悟霸者之密，招式势大力沉，$n战战兢兢，呼吸都停止了。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage) {
  object weapon;
  int j, ap, dp, damage1, damage2;
  weapon = me->query_temp("weapon");
  ap = (me->query_skill(
    "badao",
    1
  ) + me->query_skill(
    "martial-cognize",
    1
  )) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = (ob->query_skill(
    "force",
    1
  ) + ob->query_skill(
    "martial-cognize",
    1
  )) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("badao", 1);
  damage2 = (int)me->query_skill(
    "badao",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill("badao", 1) < 100) return damage;
  //	if ( me->query_skill_mapped("force") != "shenghuo-shengong") return 0;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade") return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    j = -(damage + random(damage));
    if (!ob->is_busy()) ob->start_busy(2);
    me->add("neili", -100);
    message_vision(HIG "$N" HIG "毫无留恋，顺势一刀，硬将$n" HIG "逼退。\n" NOR, me, ob);
    return j;
  }
  if (random(8) == 2 && random(ap) > dp / 4 && (int)me->query("breakup")) {
    j = -(damage + random(damage));
    me->add("jingli", -100);
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    message_vision(
      HIG "$N" HIG "不退不闪，" + me->query("cognize") + HIG "的力量爆发，连劈数刀，$n" HIG "惊骇之下，连忙收招。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(8) == 3 && random(ap) > dp / 4 && (int)me->query("jm/badao")) {
    j = -(damage + random(damage));
    me->add("neili", -100);
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    message_vision(
      HIG "$N" HIG "横刀向前，霸刀奥义斩出，举手反劈，竟将$n" HIG "招式化解 。\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
}

string perform_action_file(string action) {
  return __DIR__ "badao/" + action;
}
