int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_skill("dodge", 1) <= me->query_skill("huashan-shenfa", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  if (me->query("family/family_name") != "华山派")
    return notify_fail("你未加入华山派，学不了本派技能。\n");
  if ((int)me->query_skill("zixia-shengong", 1) < 100)
    return notify_fail("你的紫霞神功火候不够，无法学习本门身法。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");

  return 1;
}
string query_dodge_msg(object me, string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太差了，不能练华山身法。\n");
  if (me->query("family/family_name") != "华山派")
    return notify_fail("你未加入华山派，练不了本派技能。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "huashan-shenfa/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object me, object ob, int damage) {
  int j, ap, dp, damage2;
  ap = me->query_skill(
    "huashan-shenfa",
    1
  ) * me->query(
    "int",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "dodge",
    1
  ) * ob->query(
    "dex",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage2 = me->query_skill(
    "huashan-shenfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "zixia-shengong",
    1
  ) < 100 || me->query_skill("huashan-shenfa", 1) < 100) return damage;
  //	if ( me->query_skill_mapped("force") != "zixia-shengong") return damage;

  if (random(ap) > dp / 4 && random(8) == 1) {
    j = -(damage + random(damage));
    me->add("neili", -100);
    message_vision(HIG "$N陷入华山之险峻的意境，身形尽走偏锋，恰到好处的避开了$n的攻击。\n" NOR, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup")) {
    j = -(damage + random(damage));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N战斗中领悟" + me->query("cognize") + HIY "，走奇峰，跃险道，$n甫一出招就撞上$N一掌！\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/huashan")) {
    j = -(damage + random(damage));
    if (!ob->is_busy()) ob->start_busy(1);
    me->add("neili", -100);
    message_vision(HIB "$N融汇华山武学，将华山之险峻发挥的淋漓精致，$n出招变的极难！\n" NOR, me, ob);
    return j;
  }
}
