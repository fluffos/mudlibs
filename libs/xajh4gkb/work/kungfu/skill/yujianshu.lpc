string skill_menpai() {return "蜀山派";}				//门派区分：门派，江湖
string skill_yinyang() {return "中性";}				//阴阳区分：阳、阴、中性
string skill_zhenying() {return "中立";}			//阵营区分：正派、邪派、中立、通用
int damage_damage() {return 92;}	//外伤系数
int force_damage() {return 50;}		//内伤系数
