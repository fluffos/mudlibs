#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
  "只见$n一招「风满天」，身形陡然纵起，躲过了$N这一招。\n",
  "$n一式「樱花落」，身形晃动，向一旁飘出，避开了$N这一招。。\n",
  "$n使出「柳随风」，一个空心筋斗向后翻出，避开了$N的凌厉攻势。\n",
  "$n一招「过云龙」，身随意转，$N只觉眼前一花，$n已绕至$N的身后。\n",

});

int valid_enable(string usage) {
  return (usage == "dodge");
}
//2019-1-1阿飞新规划，技能代码完善
