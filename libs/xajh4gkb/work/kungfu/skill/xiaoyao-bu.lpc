string skill_pinji() { return "下乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "中立"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "新手盟"; }    //门派区分：门派，江湖
string skill_yinyang() { return "中性"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "通用"; }   //阵营区分：正派、邪派、中立、通用
//int damage_damage() {return 60;}	//外伤系数
//int force_damage() {return 60;}		//内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_skill("dodge", 1) <= me->query_skill("xiaoyao-bu", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  if (me->query("family/family_name") != "新手盟")
    return notify_fail("你并非新手盟弟子，无法学习本门武功。\n");
  if ((int)me->query_skill("xiaoyao-xinfa", 1) < 100)
    return notify_fail("你的逍遥心法不够，难以学习逍遥步。\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力修为太差了，不能学逍遥步。\n");
  return 1;
}
string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  return notify_fail("新手盟专为新手过渡，本门技能无法练习。\n");
}
string perform_action_file(string action) {
  return __DIR__ "xiaoyao-bu/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int ap, dp, j, damage2;

  ap = me->query_skill(
    "xiaoyao-bu",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "force",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage2 = me->query_skill(
    "xiaoyao-bu",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "xiaoyao-xinfa",
    1
  ) < 300 || me->query_skill("xiaoyao-bu", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force")!="xiaoyao-xinfa" ) return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = HIG "$N任凭江湖风浪起，我行我素我自己。随风飘飘天地任逍遥。\n" NOR;
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(msg, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N顿悟" + me->query("cognize") + HIY "，我自逍遥随风，随风吹入花丛中。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
}
