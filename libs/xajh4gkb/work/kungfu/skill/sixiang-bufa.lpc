int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("max_neili") < 5000 )
		return notify_fail("你的内力修为不够，没有办法学习四象步法。\n");
	if( (int)me->query_skill("lengyue-shengong") < 100 )
		return notify_fail("你的冷月神功修为不够，没有办法学习四象步法。\n");	
	if (me->query("family/family_name")!="胡苗世家" )
		return notify_fail("你不是关外胡家或中原苗家弟子，没法传授给你。\n");	
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int query_effect_dodge(object attacker, object me)
{
	int lvl;

	lvl = me->query_skill("sixiang-bufa", 1);
	if (lvl < 50)  return 0;
	if (lvl < 100) return 10;
	if (lvl < 150) return 20;
	if (lvl < 200) return 30;
	if (lvl < 250) return 40;
	return 50;
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("qi") < 70 )
		return notify_fail("你的体力太差了，不能练四象步法。\n");
	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力太差了，不能练习四象步法。\n");
	if (me->query("family/family_name")!="胡苗世家" )
		return notify_fail("你不是关外胡家或中原苗家弟子，没法练习。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");	
	me->receive_damage("qi", 58);
	me->add("neili", -65);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"sixiang-bufa/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;

	ap = me->query_skill("sixiang-bufa", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("unarmed",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("sixiang-bufa", 1);
	damage2 = me->query_skill("sixiang-bufa", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("lengyue-shengong",1) < 300 || me->query_skill("sixiang-bufa", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="lengyue-shengong" ) return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIG"$N脚踏四象八卦步，身形在东南西北变化莫测，闪开了对方的攻击！\n"NOR;
		if (!ob->is_busy()) ob->start_busy(1);
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，脚下生乾坤，由死门转生门，而$n则由生门走入死门。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/humiao") )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );
		message_vision(HIB"$N融汇胡苗两家绝学，左脚踏艮位，右脚踏震位，以四象之力震动八方！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
}
