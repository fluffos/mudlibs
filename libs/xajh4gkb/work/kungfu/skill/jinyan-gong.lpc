int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够，没有办法练七星换位。\n");
  if (me->query("family/family_name") != "全真教")
    return notify_fail("你不是全真教弟子，无法传授本教技能。\n");
  if ((int)me->query_skill(
    "tiangang-zhengqi",
    1
  ) < 100 && (int)me->query_skill("xiantian-qigong", 1) < 100)
    return notify_fail("你的本门内功火候不够，无法学习。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太差了，不能练金雁功。\n");
  if (me->query("family/family_name") != "全真教")
    return notify_fail("你不是全真教弟子，无法练习本教技能。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "jinyan-gong/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  int j, ap, dp, damage2;
  ap = me->query_skill(
    "jinyan-gong",
    1
  ) * me->query(
    "dex",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "dodge",
    1
  ) * ob->query(
    "int",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage2 = me->query_skill(
    "jinyan-gong",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if ((me->query_skill(
    "xiantian-qigong",
    1
  ) < 300 && me->query_skill(
    "tiangang-zhengqi",
    1
  ) < 300) || me->query_skill("jinyan-gong", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force") != "xiantian-qigong" ||  me->query_skill_mapped("force") != "tiangang-zhengqi" ) return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    message_vision(HIC "$N腾空而起，缩地成寸，一步踏出数丈远！$n顿时觉得$N愈来愈远，一会功夫就看不见踪影！\n" NOR, me, ob);
    me->add("neili", -100);
    j = -(damage + random(damage));
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup")) {
    j = -(damage / 2 + random(damage));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N顿悟" + me->query("cognize") + HIY "，一步飞跃，双臂展开，如金燕掠过，其势如虹，将$n划出一道伤口。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/quanzhen")) {
    j = -(damage + random(damage));
    if (!ob->is_busy()) ob->start_busy(1);
    me->add("neili", -100);
    message_vision(HIB "$N融汇全真教武学，脚步飞快，$n一招落空，顿时收招不及，跌了一跤！\n" NOR, me, ob);
    return j;
  }
}
