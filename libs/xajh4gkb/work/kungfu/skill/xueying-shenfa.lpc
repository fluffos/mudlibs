int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "血刀门")
    return notify_fail("你不是血刀门弟子，无法学习血影。\n");
  if ((int)me->query_skill("xuedao-xinfa", 1) < 100)
    return notify_fail("你的血刀心法不够，无法学习血影。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  return 1;
}

string query_dodge_msg(string limb) {
  object me, ob;
  mapping action;
  me = this_player();
  action = query_action(me, ob);

  return action["action"];
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太差了，不能练血影身法。\n");
  if (me->query("family/family_name") != "血刀门")
    return notify_fail("你不是血刀门弟子，看不清血影。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "xueying-shenfa/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int ap, dp, j, damage1, damage2;

  ap = me->query_skill(
    "xueying-shenfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "dodge",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = me->query_skill("xueying-shenfa", 1);
  damage2 = me->query_skill(
    "xueying-shenfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "xuedao-xinfa",
    1
  ) < 300 || me->query_skill("xueying-shenfa", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force")!="xuedao-xinfa" ) return damage;
  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = HIG "$N将血影身法发挥到极致，身影血气漫漫！\n" NOR;
    if (!ob->is_busy()) ob->start_busy(1);
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(msg, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N顿悟" + me->query("cognize") + HIY "，带起血雾，不一会迷漫开来，慢慢的将$n精气化作血雾。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/xuedao")) {
    j = -(damage + random(damage));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    message_vision(
      HIB "$N融汇血刀门武学精髓，四周血气茫茫，$n受到血气侵染，出手似乎越来越无力。\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
}
