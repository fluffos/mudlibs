int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}
//2019-1-1阿飞新规划，技能代码完善
string valid_combine() { return "yunlong-shou"; }  //互备技能
string skill_pinji() { return "下乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "中立"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "云龙门"; }    //门派区分：门派，江湖
string skill_yinyang() { return "中性"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "正派"; }   //阵营区分：正派、邪派、中立、通用
int damage_damage() { return 67; }  //外伤系数
int force_damage() { return 47; }  //内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练云龙爪必须空手。\n");
  if (me->query("family/family_name") != "云龙门")
    return notify_fail("不加入云龙门，学不了本门技能。\n");
  if ((int)me->query_skill("yunlong-shengong", 1) < 100)
    return notify_fail("你的云龙神功火候不够，无法学习本门技能。\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力太弱，无法练云龙爪。\n");
  if ((int)me->query_skill("unarmed", 1) < 100)
    return notify_fail("你的基本爪法火候不够，无法学云龙爪。\n");
  if (me->query_skill("unarmed", 1) <= me->query_skill("yunlong-zhua", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}


int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练云龙爪必须空手。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练云龙爪。\n");
  if (me->query("family/family_name") != "云龙门")
    return notify_fail("不加入云龙门，练习不了本门技能。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yunlong-zhua/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;

  ap = me->query_skill(
    "yunlong-zhua",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("yunlong-zhua", 1);
  damage2 = (int)me->query_skill(
    "yunlong-zhua",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "yunlong-shengong",
    1
  ) < 100 || me->query_skill("yunlong-zhua", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "yunlong-shengong") return 0;
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    victim->apply_condition("zhua_poison", 10);
    message_vision(
      HIR "只听$n" HIR "一声惨嚎，看来受到了云龙爪毒劲的干扰！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    me->add("jingli", -100);
    victim->apply_condition(
      "zhua_poison",
      random(me->query_skill("yunlong-zhua", 1) / 200) + 1 + victim->query_condition("zhua_poison")
    );
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，手臂伸展，左手聚成虎爪状！如云龙出渊，一把抓住$n的" + xue_name[random(sizeof(xue_name))] + HIG "。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/yunlong")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    victim->apply_condition(
      "zhua_poison",
      random(me->query_skill("yunlong-zhua", 1) / 200) + 1 + victim->query_condition("zhua_poison")
    );
    message_vision(
      HIM "$N融汇云龙门武学精髓，左爪探云，右爪隐于身下。窥得一个破绽，右爪化作一道金光抓住$n的" + xue_name[random(sizeof(xue_name))] + HIM "。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
