int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
    if ((int)me->query_skill("shayi-xinfa", 1) < 100)
		return notify_fail("你的杀意心法火候不够。\n");
    if (me->query("family/family_name")!="飞天御剑流")
		return notify_fail("你不是飞天门人，不能传授给你。\n");
	if (!me->query("jm/shushan"))
		return notify_fail(CYN"这蜀山之人常飞来飞去的，这岂不是蔑视我飞天门吗。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"要修炼我飞天门功夫，先得为我门探得蜀山派的飞剑秘密！\n"NOR);
	if ((int)me->query("family_score")<9)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);		
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	if (random(100)==1) me->add("score",-5);
    return 1;
}
string query_dodge_msg(string limb)
{
    object me, ob;
    mapping action;

    me = this_player();
    action = query_action(me, ob);

    return action["action"];
}
int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if( (int)me->query("qi") < 60 )
		return notify_fail("你的气力不够,不能修炼五行遁.\n");
    if (me->query("family/family_name")!="飞天御剑流")
		return notify_fail("你不是飞天门人，练习不了啊。\n");
	if (!me->query("jm/shushan"))
		return notify_fail(CYN"这蜀山之人常飞来飞去的，这岂不是蔑视我飞天门吗。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"要修炼我飞天门功夫，先得为我门探得蜀山派的飞剑秘密！\n"NOR);
	if ((int)me->query("family_score")<9)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
    me->receive_damage("qi", 30);
    return 1;
}
string perform_action_file(string action)
{
    return __DIR__"wuxing-dun/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;

	ap = me->query_skill("wuxing-dun", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("sword",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("wuxing-dun", 1);
	damage2 = me->query_skill("wuxing-dun", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("shayi-xinfa",1) < 300 || me->query_skill("wuxing-dun", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="shayi-xinfa" ) return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIG"$N脚踏五行，全身气息在金--木--水--火--土之间流转，顷刻之间在$n周围布下五行大阵！$n的攻击被幻影分担了一部分。\n"NOR;
		me->add("neili", -100 );
		if (!ob->is_busy()) ob->start_busy(1);
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，身化五行，真气在金木水火土转换，五行相克相生。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/feitian") )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );
		message_vision(HIB"$N融汇飞天御剑流武学精髓，身体遁出五行，从三界之外突然出现在$n身后，瞬时拍出一掌！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
}

