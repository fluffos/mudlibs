// sannong.c 梅花三弄

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int affect, extra, damage;
  int ap, dp;
  string msg;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("你没在战斗中呢！\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("你手持武器，如何使用「梅花三弄」绝技？\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query_skill("meihua-sannong", 1) < 1000)
    return notify_fail("你的梅花梅花三弄还不够纯熟，无法施展「梅花三弄」绝技。\n");
  if ((int)me->query_skill("wudie-xinjing", 1) < 1000)
    return notify_fail("你的舞蝶心经还不够纯熟，无法施展「梅花三弄」绝技。\n");
  if ((int)me->query_skill("wudie-bu", 1) < 1000)
    return notify_fail("你的舞蝶步还不够纯熟，无法施展「梅花三弄」绝技。\n");
  if ((int)me->query_skill("dieyi-jianfa", 1) < 1000)
    return notify_fail("你的蝶翼剑法还不够纯熟，无法施展「梅花三弄」绝技。\n");
  if (me->query_skill_mapped("force") != "wudie-xinjing")
    return notify_fail("你没激发内功 。\n");
  if (me->query_skill_mapped("unarmed") != "meihua-sannong")
    return notify_fail("你没正确激发该技能 。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着！\n");
  if (me->query("gender") != "女性")
    return notify_fail("只有身轻体柔才能施展「梅花三弄」绝技？\n");
  if ((int)me->query("max_jingli") < 300000)
    return notify_fail("你的精力修为还不够高。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够了。\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if (me->query("max_neili") < 500000)
    return notify_fail("你内力修为不够，无法使用「梅花三弄」绝技。\n");
  if (!(int)me->query("breakup"))
    return notify_fail("你任督二脉未通,无法使用「梅花三弄」！\n" NOR,);
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  if (me->query("gender") == "女性" && target->query("gender") == "男性") affect = 2;
  else affect = 1;
  extra = me->query_skill("meihua-sannong", 1) / 10;
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "meihua-sannong",
    1
  ) + me->query_skill("dieyi-jianfa", 1) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  message_vision(HBWHT "$N贯通舞蝶仙武学，使出了舞蝶仙的绝学之精髓！\n" NOR, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1	
  msg = HIY "\n$N对$n轻轻一笑，眼光之中流露出妩媚之意，施展出「梅花三弄」绝技。\n" NOR;
  msg += HIC "\n------梅花一弄戏风高------\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  damage = me->query_skill("meihua-sannong", 1) + me->query_skill("dieyi-jianfa", 1);
  damage = damage * affect / 3 + random(damage * affect / 3);
  damage = damage * (100 - target->query_meridian()) / 100;
  target->add("jingli", -damage);
  target->add("neili", -damage);
  me->add("neili", -1000);
  msg = HIW "$n身上落了几点梅花印记，似乎有鲜血溢出。\n" NOR;
  message_vision(msg, me, target);
  if (random(ap) > dp / 3) {
    damage = me->query_skill("meihua-sannong", 1) + me->query_skill("dieyi-jianfa", 1);
    damage = damage * affect / 3 + random(damage * affect / 3);
    damage = damage * (100 - target->query_meridian()) / 100;
    me->add("neili", -200);
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 2, me);
    //		if (!target->is_busy()) target->start_busy(5+random(10));		
    msg = HIY "\n$N忽然对$n轻轻一笑，眼光四处流动，所经过之处似乎充满了妩媚，$n不由得一呆。\n" NOR;
    message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
  } else {
    msg = HIW "不料$n定了定神，突然大喝一声，顿时把$N惊出一身冷汗。\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -100);
  }

  if (me->query_skill("meihua-sannong", 1) > 2000 && me->query_skill("dieyi-jianfa", 1) > 2000) {
    msg = HIG "\n◎◎◎◎◎◎梅花二弄迎春曲◎◎◎◎◎◎\n" NOR;
    message_vision(msg, me, target);
    damage = me->query_skill(
      "meihua-sannong",
      1
    ) * affect + me->query_skill(
      "dieyi-jianfa",
      1
    ) + me->query_skill("force") + me->query_skill("sword", 1) + me->query_skill("unarmed", 1);
    damage = damage * affect / 3 + random(damage * affect / 3);
    damage = damage * (100 - target->query_meridian()) / 100;
    me->add_temp("apply/attack", extra * 2);
    me->add_temp("apply/damage", extra * 2);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add_temp("apply/attack", -extra * 2);
    me->add_temp("apply/damage", -extra * 2);
    if (random(ap) > dp / 3) {
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      me->add("neili", -2000);
      me->add("jingli", -1000);
      target->add("neili", -damage);
      message_vision(
        CYN "\n但见$n大喝一声，想用雄浑的内力打破$N四周这妩媚的气氛！\n" + "结果$n只发出两、三招，就无法忍受$N妩媚的眼光了。\n" NOR,
        me,
        target,
        damage,
        HBWHT + HIM "气血伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    } else {
      msg = HIY "\n$N忽然对$n轻轻一笑，想施展「梅花三弄」绝技。\n" + HIM "谁知$n根本就没有上当。\n" NOR;
      message_vision(msg, me, target);
      me->add("neili", -1000);
    }
  }

  if (me->query_skill("meihua-sannong", 1) > 3000 && me->query_skill("dieyi-jianfa", 1) > 3000) {
    msg = HIM "\n★★★★★★梅花三弄唤群仙★★★★★★\n" NOR;
    message_vision(msg, me, target);
    if (me->query("jm/wudie")) damage = me->query_skill(
      "meihua-sannong",
      1
    ) * me->query(
      "per",
      1
    ) * 3 / 2 + me->query_skill(
      "dieyi-jianfa",
      1
    ) * me->query(
      "dex",
      1
    ) * 3 / 2 + me->query_skill(
      "wudie-xinjing",
      1
    ) * me->query(
      "int",
      1
    ) * 3 / 2 + me->query_skill(
      "wudie-bu",
      1
    ) * me->query(
      "per",
      1
    ) + me->query_skill("sword", 1) + me->query_skill("unarmed", 1) + me->query_skill("force", 1);
    else damage = me->query_skill(
      "meihua-sannong",
      1
    ) * me->query(
      "per",
      1
    ) + me->query_skill(
      "dieyi-jianfa",
      1
    ) * me->query(
      "dex",
      1
    ) + me->query_skill(
      "wudie-xinjing",
      1
    ) * me->query(
      "int",
      1
    ) + me->query_skill(
      "wudie-bu",
      1
    ) * me->query(
      "per",
      1
    ) / 2 + me->query_skill(
      "sword",
      1
    ) + me->query_skill("unarmed", 1) + me->query_skill("force", 1);

    me->add_temp("apply/attack", extra * 2);
    me->add_temp("apply/damage", extra * 2);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add_temp("apply/attack", -extra * 2);
    me->add_temp("apply/damage", -extra * 2);
    if (random(ap) > dp / 3) {
      damage = damage * affect / 4 + random(damage * affect / 4) + target->query("jing") * 4 / 100;
      damage = damage * (100 - target->query_meridian()) / 100;
      message_vision(
        HIB "\n$N舞姿飞快，仙裙带起阵阵香风，身姿婀娜，曼妙至极！\n" + "$n媚眼如丝，身心飘飘欲仙，手足舞蹈，似乎想扑入美女群中。\n" NOR,
        me,
        target
      );
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 3, me);
      if (random(4) == 1) {
        target->map_skill("unarmed");  //下特殊拳脚
        message_vision(RED "$n被$N舞姿吸引，放弃了出拳。\n" NOR, me, target);
      }
      me->add("neili", -3000);
      me->add("jingli", -1000);
      target->add("neili", -damage);
      message_vision(
        HIM "\n$n自惭形秽，顿时觉得如此容貌，不如死了算了，只好闭目等死！\n" NOR,
        me,
        target,
        damage,
        HBWHT + HIM "气血伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/3 +"。\n" NOR);
    } else {
      damage = damage * affect / 10 + random(damage * affect / 10) + target->query("jing") * 1 / 100;
      damage = damage * (100 - target->query_meridian()) / 100;
      me->add("neili", -damage);
      me->receive_damage("qi", damage, target);
      me->receive_wound("qi", damage / 2, target);
      msg = HIY "\n$n身法潇洒至极，搔首弄姿，信手拈花微笑。\n" + HIM "$N万花丛中过，雨露均沾，一时惹的$n娇笑连连。\n" NOR;
      message_vision(msg, target, me, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);
    }
  }
  me->start_busy(1);
  return 1;
}
void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
