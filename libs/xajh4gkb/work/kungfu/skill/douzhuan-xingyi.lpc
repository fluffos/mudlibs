	if (type==1) message_vision(msg, me, ob,damage,HBWHT+HIY"气血反伤"NOR);
	else if (type==2) message_vision(msg, me, ob,damage,HBWHT+HIY"精神反伤"NOR);
	else message_vision(msg, me, ob,damage,HBWHT+HIY"气血反伤"NOR);
}