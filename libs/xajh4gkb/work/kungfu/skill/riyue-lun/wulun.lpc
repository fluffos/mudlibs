
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

#define LIAN "「" HIW "五轮连转" NOR "」"

inherit F_SSERVER;

int perform(object me, object target)
{
	mixed combat_msg;
	object weapon;
	string  msg;
	int i, count, attack_time;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail(LIAN "只能对战斗中的对手使用。\n");
	if (! objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "hammer")
		return notify_fail("你所使用的武器不对，难以施展" LIAN "。\n");
    if(me->is_busy())
        return notify_fail("你现在正忙着！\n");
//	if (me->query_skill_mapped("hammer") != "riyue-lun")
//		return notify_fail("你没有激发日月轮法，难以施展" LIAN "。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if ((int)me->query_skill("riyue-lun", 1) < 300)
		return notify_fail("你日月轮法火候不足，难以施展" LIAN "。\n");
	if ((int)me->query_skill("longxiang", 1) < 300 && (int)me->query_skill("xiaowuxiang", 1) < 300)
		return notify_fail("你的本门内功火候不足，难以施展" LIAN "。\n");
	if ((int)me->query("max_neili") < 500000)
		return notify_fail("你的内力修为不足，难以施展" LIAN "。\n");
	if( (int)me->query("max_jingli") < 100000 )
		return notify_fail("你的精力修为还不够高。\n");
	if( (int)me->query("jingli") < (int)me->query_skill("riyue-lun", 1) )
		return notify_fail("你的精力不够了。\n");	
	if ((int)me->query("neili") < (int)me->query_skill("riyue-lun", 1)*4)
		return notify_fail("你现在的真气不足，难以施展" LIAN "。\n");
//	if ( me->query_skill_mapped("force") != "longxiang" && me->query_skill_mapped("force") != "xiaowuxiang")
//		return notify_fail("不使用本门内功，如何使用本门绝学!\n");	
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	combat_msg = me->query("env/no_combat_msg");
	if ( !intp(combat_msg) ) combat_msg = 1;
	msg = HIY "$N" HIY "嗔目大喝，施展出日月轮法「" HIW "五轮连转"
	      HIY "」神技，蓦地将手中" + weapon->name() + HIY "飞掷\n而出，幻作数"
	      "道光芒，相互盘旋着压向$n" HIY "，招术煞为精奇！\n" NOR;
	message_vision(msg, me, target);
	msg = HIY "$N纵跃退後，立时呜呜、嗡嗡、轰轰之声大作，金光闪闪，银光烁烁，五只轮子从五个不同方位飞袭出来！\n" NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	count = me->query_skill("riyue-lun", 1)/3;
	if ( me->query_skill_mapped("force") != "longxiang" && me->query_skill_mapped("force") != "xiaowuxiang") count += me->query_skill("riyue-lun", 1)/2;	//2018.9.5阿飞改，不使用本门特内则减益	
	if ( weapon->query("id") == "jin lun") count -= me->query_skill("riyue-lun", 1)/3; //2018.3.25阿飞改，拿特殊武器有加成
	me->add_temp("apply/attack", -count);
	me->add_temp("apply/damage", -count);
	me->add_temp("apply/strength", -count);
	attack_time = me->query_skill("riyue-lun", 1)/60;
	if(attack_time < 1) attack_time=1;
	if (me->query("jm/xueshan"))
	{
		if (attack_time > 100+(int)me->query_temp("lianzhao_max_add")*4) attack_time = 100+(int)me->query_temp("lianzhao_max_add")*4;	
	} else 
	{
		if (attack_time > 50+(int)me->query_temp("lianzhao_max_add")*2) attack_time = 50+(int)me->query_temp("lianzhao_max_add")*2;	
	}
	
	me->add_temp("lianzhao", attack_time);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害
	for (i = 0; i < attack_time; i++)
	{
		if (! me->is_fighting(target))
			break;

		if ( weapon->query("id") == "jin lun" && combat_msg<4)
		{
			switch ( random(5) )
			{
			case 0:
				msg = BLU  "锡轮回转！！ "WHT "突然间锡轮从日月轮中分离"
				      "开来，化作一道灰芒朝$n" WHT "砸"
				      "去。\n" NOR;
				break;
			case 1:
				msg = HIB  "铁轮回转！！ "HIR "突然间铁轮从日月轮中分离"
				      "开来，化作一道红芒朝$n" HIR "砸"
				      "去。\n" NOR;
				break;
			case 2:
				msg = YEL  "铜轮回转！！ "HIG "突然间铜轮从日月轮中分离"
				      "开来，化作一道黄芒朝$n" HIG "砸"
				      "去。\n" NOR;
				break;
			case 3:
				msg = HIC  "银轮回转！！ "HIW "突然间银轮从日月轮中分离"
				      "开来，化作一道银芒朝$n" HIW "砸"
				      "去。\n" NOR;
				break;
			default:
				msg = HIM  "金轮回转！！ "HIY "突然间金轮从日月轮中分离"
				      "开来，化作一道金芒朝$n" HIY "砸"
				      "去。\n" NOR;
				break;
			}
			COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		}
		else
			COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
	}
	me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记
	me->add("neili", -100*attack_time);
	me->add("jingli", -10*attack_time);
	me->add_temp("apply/attack", count);
	me->add_temp("apply/damage", count );
	me->add_temp("apply/strength", count);
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}
