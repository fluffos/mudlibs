// 圣火燎原 liaoyuan.c	

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

// 颜色
nosave string *ansi_arg = ({ RED, GRN, YEL, BLU, MAG, CYN, WHT, HIR, HIG, HIY, HIB, HIM, HIC, HIW });

int perform(object me, object target)
{
	object weapon,ob;
	int skill, times, i, max;
	string msg;

	if ( !target ) target = offensive_target(me);
	if ( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「圣火燎原」只能在战斗中使用。\n");
	if ( !objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword" )
		return notify_fail("「圣火燎原」必须用剑才能施展。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
//	if ( me->query_skill_mapped("sword") != "shenghuo-ling")
//         return notify_fail("你必须激发圣火令法才能使用「圣火燎原」！\n");       
	if ( (int)me->query_skill("shenghuo-ling", 1) < 300 )
		return notify_fail("你的「圣火令法」不够娴熟，不会使用「圣火燎原」。\n");
	if ( (int)me->query_skill("shenghuo-shengong", 1) < 300 && (int)me->query_skill("jiuyang-shengong",1) < 300)
		return notify_fail("你的圣火神功不够娴熟，不会使用「圣火燎原」。\n");
//	if ( !wizardp(me) && me->query_skill_mapped("force") != "shenghuo-shengong" && me->query_skill_mapped("force") !="jiuyang-shengong")
//		return notify_fail("不使用本门内功，如何使用本门绝学!\n"); 	
	if ((int)me->query("max_neili")<500000)								
		return notify_fail("你的内力修为不够。\n");
    if( (int)me->query("neili") < (int)me->query_skill("shenghuo-ling", 1)*4 )
        return notify_fail("你的真气不够。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

		
	max = sizeof(ansi_arg);
	msg = ansi_arg[random(max)]+"$N眼中射出一道青芒，飞身而前，手中圣火令相互一击,奇招怪式犹如燎原之火般向$n攻去！\n"NOR;
	message_vision(msg, me, target);	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	skill = me->query_skill("shenghuo-ling", 1)/3;
	if ( me->query_skill_mapped("force") != "shenghuo-shengong" && me->query_skill_mapped("force") !="jiuyang-shengong") skill += me->query_skill("shenghuo-ling", 1)/2;	//2018.9.5阿飞改，不使用本门特内则减益	
	if ((string)weapon->query("id") == "shenghuo ling") skill -= me->query_skill("shenghuo-ling", 1)/3; //2018.3.25阿飞改，拿特殊武器有加成
	times=(int)me->query_skill("shenghuo-ling", 1)/60;
	if(times < 1) times = 1;
	if (me->query("jm/mingjiao"))
	{
		if(times > 150+(int)me->query_temp("lianzhao_max_add")*4) times = 150+(int)me->query_temp("lianzhao_max_add")*4;
	} else 
	{
		if(times > 50+(int)me->query_temp("lianzhao_max_add")*2) times = 50+(int)me->query_temp("lianzhao_max_add")*2;
	}	
	
	me->add_temp("apply/attack", -skill);
	me->add_temp("apply/damage", -skill);
	me->add_temp("apply/strength", -skill);
	me->add_temp("lianzhao", times);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
	for ( i=0; i<times; i++ )
	{
		if ( me->query("neili") < 300 ) break;
		me->add("neili", -300);
		me->clean_up_enemy();                        	
		ob = me->select_opponent();
		if ( ob = me->select_opponent() )
		{
			COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 1);
		}
	}
	me->add_temp("apply/attack", skill);
	me->add_temp("apply/damage", skill);
	me->add_temp("apply/strength", skill);
	me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记	
	me->start_busy(1);
	
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}