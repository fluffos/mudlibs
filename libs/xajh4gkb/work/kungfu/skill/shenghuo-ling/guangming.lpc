// guangming.c 光明永照

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
#include "/kungfu/skill/eff_msg.h";
inherit F_SSERVER;
string *songs = ( {"五行之气调阴阳","损心伤肺摧肝肠","藏离精失意恍惚","三焦齐逆兮魂魄飞扬"});

string *xue_name = (
{
	"劳宫穴","膻中穴","曲池穴","关元穴","曲骨穴","中极穴","承浆穴","天突穴","百会穴",
	"幽门穴","章门穴","大横穴","紫宫穴","冷渊穴","天井穴","极泉穴","清灵穴","至阳穴",
});

string *limb=(
{
	"颈部","后心","右腿","头部","小腹","胸口","腰间","裆部","右肩","右臂","右脚",
});

int perform(object me, object target)
{
	object weapon;
	string msg,force_skill;
	int skill,skill1,damage;
	int ap,dp;
	string song;
	string name,limbs;
	song = songs[random(sizeof(songs))];
	
	if( !target) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("只能在战斗中对对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你没有装备武器。\n");
	if(me->is_busy())
		return notify_fail("你现在没空！！\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if( (int)me->query("max_neili") < 1000000  )
		return notify_fail("你的内力不够。\n");
	if ((int)me->query("max_jingli")<200000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你的精力不够。\n");	
	if( (int)me->query("neili") < 10000 )
		return notify_fail("你的内力不够。\n");
	if( !wizardp(me) &&(int)me->query_skill("qishang-quan", 1) < 1000 )
		return notify_fail("你的七伤拳不够!不能贯通使用！\n");
	if(!wizardp(me) && (int)me->query_skill("shenghuo-ling", 1) < 1000 )
		return notify_fail("你的圣火令不够高!不能贯通使用！\n");
	if((int)me->query_skill("jiuyang-shengong", 1) < 1000 && (int)me->query_skill("shenghuo-shengong", 1) < 1000 )
		return notify_fail("你的圣火内功似乎。。。。不够高！\n");
	if ( me->query_skill_mapped("force") != "jiuyang-shengong" && me->query_skill_mapped("force") != "shenghuo-shengong")
		return notify_fail("不使用本门神功，如何使用圣火绝学!\n");			
	if ( me->query_skill_mapped("sword") != "shenghuo-ling")
         return notify_fail("你必须激发圣火令法才能使用！\n"); 
	if (!(int)me->query("breakup"))
		return notify_fail("你任督二脉未通,无法使用「光明永照」。\n"NOR);
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HBWHT "$N贯通明教武学，使出了明教的绝学之精髓！\n" NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1
	skill = me->query_skill("shenghuo-ling", 1)/10 + me->query_skill("qishang-quan",1)/10;
	ap = me->query("xyzx_sys/level") + me->query_skill("shenghuo-ling", 1) + me->query_skill("sword") + me->query_skill("force") + me->query_skill("qishang-quan",1);
	dp = target->query("xyzx_sys/level") + target->query_skill("unarmed") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	force_skill=me->query_skill_mapped("force");
	skill1 = (int)me->query_skill(force_skill, 1);		
	
	message_vision(HIR "$N" HIR "默念九阳神功的口诀：\n他强由他强，清风拂山冈。他横任他横，明月照大江……\n刹那间只见$N" HIR "全身顿时浮现出一层刚猛的劲气，将$N"HIR "全全笼罩。\n" NOR, me);
	me->add_temp("apply/attack", skill);
	me->add_temp("apply/damage", skill);
	me->add_temp("apply/strength", skill);
	weapon = me->query_temp("weapon");
//	if (!target->is_busy() && random(3)==1)  target->start_busy(3);
	msg =  HIW  "$N大喝一声：「" + HIR "焚我残躯，熊熊圣火" + HIW"」，真气所至，顿时四周狂风大作，\n$n身子不觉一震！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg =  HIR  "$N口中长吟到：“"HIR"焚我残躯，熊熊圣火。生亦何欢，死亦何苦"HIC"？" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg =  HIY "$N口中长吟到：“"HIR"为善除恶，唯光明故。喜乐悲愁，皆归尘土"HIC"。" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg =  HIC "$N口中长吟到：“"HIR"怜我世人，忧患实多！怜我世人，忧患实多"HIC"！”\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	me->add_temp("apply/attack", -skill);
	me->add_temp("apply/damage", -skill);
	me->add_temp("apply/strength", -skill);
	me->add("neili", -1000);
	me->add("jingli", -1000);
	
if( me->query_skill("shenghuo-ling", 1) > 2000 && me->query_skill("qishang-quan", 1) > 2000)
{	
	msg = HIC"\n$N大吼一声："HIR"为善除恶，惟光明故，喜乐悲愁，皆归尘土"HIC"。"+weapon->query("name")+HIC"和人合二为一，\n带着漫天杀气扑向$n。\n"NOR;
	message_vision(msg, me, target);
	damage = (int)me->query_skill("sword",1) + (int)me->query_skill("shenghuo-ling",1) + skill1 + (int)me->query_skill("qishang-quan",1);

	if (random(ap)>dp/3)
	{
		damage = damage/2 + random(damage/2);
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		me->add("neili", -2000);
		me->add("jingli", -2000);		
		limbs= limb[random(sizeof(limb))];
		msg =CYN"$n只觉的所有退路都被这逼人的杀气笼罩，避无可避，不由大惊失色，登时眼前一花\n，"+weapon->query("name")+CYN"已从其"+limbs+"洞穿而出！\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		if(  me->query_skill("sougu",1 ) > 3000)
		{
			damage = damage/4 + random(damage/4);
			damage = damage*(100-target->query_meridian())/100;
			target->receive_damage("qi", damage,me);
			target->receive_wound("qi", damage/2,me);	
			me->add("neili", -1000);
			me->add("jingli", -1000);			
			name = xue_name[random(sizeof(xue_name))];
			msg = HIC"\n$N紧跟着上前一步，乘对方不备之际，左手变掌为鹰爪之势，\n自左向右抓向$n的"+name+"。\n"NOR;
			msg +=CYN"结果$n的"+name+"被抓个正着，全身不由自主的一颤，吐出一口鲜血。\n"NOR;
			message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人追加气血外伤为"+ damage/2 +"，内伤为"+ damage/4 +"。\n" NOR);
		}
	} else
	{
		damage = damage/2 + random(damage/2);
		damage = damage*(100-me->query_meridian())/100;
		me->add("neili", -1000);
		me->receive_damage("qi", damage,target);
		me->receive_wound("qi", damage/2,target);		
		msg = "只见$N身法加快，双手交错虚晃一招。而$n一招落空，反受其害！\n";
		message_vision(msg, target, me,damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}

}	
if( me->query_skill("shenghuo-ling", 1) > 3000 && me->query_skill("qishang-quan", 1) > 3000)
{	
	message_vision(HIR"\n突然$N眼射精光，朗声念出句似歌非歌、似诗非诗的拳诀：“"+song+"”，接着走上前去，砰的一拳击向$n！\n"NOR,me, target);
	if (me->query("jm/mingjiao")) damage = (int)me->query_skill("sword",1) + (int)me->query_skill("shenghuo-ling",1)*me->query("str",1)*3/2 + skill1*me->query("con",1)*3/2 + (int)me->query_skill("qishang-quan",1)*me->query("con",1)*3/2 + me->query_skill("unarmed",1) + me->query_skill("force") + me->query("jiali");
	else damage = (int)me->query_skill("sword",1) + (int)me->query_skill("shenghuo-ling",1)*me->query("str",1) + skill1*me->query("con",1) + (int)me->query_skill("qishang-quan",1)*me->query("con",1) + me->query_skill("unarmed",1) + me->query_skill("force") + me->query("jiali");
	damage = damage/3 + random(damage/3) + me->query("qi")*6/100;
	damage = damage*(100-target->query_meridian())/100;
	if (random(ap)>dp/3)
	{
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		me->add("neili", -2000);
		me->add("jingli", -2000);
		message_vision(HIW"在刚一触到$n的身体时，$N便暗暗发力，将隐藏在在拳内的七种力道送了过去！\n"NOR,me,target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法	
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		if(me->query("neili")*3/2 < target->query("neili"))
		{
			me->apply_condition("qishang_poison", 30);
			tell_object(me, HIR"你只觉"+target->name()+"体内内力极强，你暗藏在拳内的七种力道根本送不出去，被反击了回来！\n"NOR);
		}
		else
		{
			target->apply_condition("qishang_poison", 30);
			target->apply_condition("no_exert", 30);
			tell_object(target, HIW"你一晃眼，只见"+me->name()+"的拳已经打在$n的身上，跟着几股说不出的暗劲顺势传了过来！\n"NOR);
		}
	}
	else
	{
		me->add("neili", -1000);
		msg = "只见$p轻轻一转身，已经绕到了$P身后。而$N却因劲力打空不受控制，头脑眩晕！\n";
		message_vision(msg, me, target);
	}

}	
  me->start_busy(1);
	return 1;
}
void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}