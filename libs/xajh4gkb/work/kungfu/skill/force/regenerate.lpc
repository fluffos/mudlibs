// regenerate.c
//inherit SSERVER;
#include <skill.h>
int exert(object me, object target) {
  int n, q;
  int level, jibenforce, flag, jineng_exp_add;

  if (target != me)
    return notify_fail("你只能用内功恢复自己的精力。\n");
  if ((int)me->query("jing") >= (int)me->query("eff_jing"))
    return notify_fail("你现在精力充沛。\n");
  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("jingli") < 100)
    return notify_fail("你的精力不够。\n");
  if (!me->query_skill("force"))
    return notify_fail("你尚未学过内功心法。\n");
  if ((int)me->query_skill("force", 1) < 100)
    return notify_fail("你还是先学些呼吸心法的技巧！\n");
  if ((int)me->query("eff_jing") < (int)me->query("max_jing") / 2)
    return notify_fail("你的精神受伤过重，只怕一运内息便有生命危险！\n");
  if (me->query_condition("no_exert"))
    return notify_fail("你的丹田真气乱窜，无法运功平息。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢，哪有空运功？\n");
  //	if (me->query_temp("autolian"))
  //		return notify_fail("你正在发动自动连招！\n"); 	
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  if (me->query("xyhy_type") == 2) flag = 5 / 4;  //黄金会员打坐增加技能熟练度1.25倍
  else flag = 1;
  if (me->query_temp("jineng_exp_add")) jineng_exp_add = (int)me->query_temp("jineng_exp_add", 1);  //处于技能自练提升状态时
  else jineng_exp_add = 0;
  q = (int)me->query("eff_jing") - (int)me->query("jing");
  n = 100 * q / me->query_skill("force");
  level = (int)me->query("xyzx_sys/level");
  jibenforce = (int)me->query_skill("force", 1);

  if (n < 20) n = 20;
  if ((int)me->query("neili") < n) {
    q = q * (int)me->query("neili") / n;
    n = (int)me->query("neili");
  }
  me->add("neili", -n);
  me->receive_heal("jing", q);
  message_vision(HIG "$N深深吸了几口气，精神看起来好多了。\n" NOR, me);
  //	me->start_busy(1);	//吸气要不要设置busy还有待考虑
  if (jibenforce < (level + 300) * 4) me->improve_skill(
    "force",
    me->query_con() * flag * me->query(
      "con",
      1
    ) * me->query_exp_times() * (jineng_exp_add + 100) / 10000 + 100,
    0
  );
  return 1;
}
