// jingheal.c
#include <ansi.h>
#include <skill.h>
int heal_myself(object me)
{
	int flag,level,jibenforce,teshuforce,jineng_exp_add;
	int jingreceive=50,add_jing=10;
    string force_skill=me->query_skill_mapped("force");

    if (!stringp(force_skill))
        return notify_fail("你所学的内功中没有这项技能。\n");       
    if( me->is_fighting() )
        return notify_fail("战斗中运功疗伤？找死吗？\n"); 
	if( me->is_busy() )
		return notify_fail("你现在正忙着呢，哪有空运功？\n");	
//	if (me->query_temp("autolian"))
//		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
	if ((int)me->query_skill("force", 1) < 100)
		return notify_fail("你还是先学点基本内功吧。\n");
    if ((int)me->query_skill(force_skill, 1) < 100)
        return notify_fail("你的"+to_chinese(force_skill)+"修为还不够。\n");
	if( me->query_condition("no_force") )
		return notify_fail("你的丹田真气狂泻不止，浑身无力，如何能疗伤呢。\n");
    if( (int)me->query("neili") < 1000 )
        return notify_fail("你的真气不够。\n");
    if( (int)me->query("eff_jing") < (int)me->query("max_jing") *4/10 )
        return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");
    if( (int)me->query("eff_jing") >= (int)me->query("max_jing")  )
        return notify_fail("你现在不需要运功疗伤！\n");
	
	if( SKILL_D(force_skill)->jing_heal() ) jingreceive = SKILL_D(force_skill)->jing_heal();
	if(me->query("xyhy_type")==2) flag = 5/4;	//黄金会员打坐增加技能熟练度1.25倍
		else flag = 1;
	if (me->query_temp("jineng_exp_add")) jineng_exp_add = (int)me->query_temp("jineng_exp_add",1);	//处于技能自练提升状态时
	else jineng_exp_add = 0;		
	level = (int)me->query("xyzx_sys/level",1);
	jibenforce = (int)me->query_skill("force",1);
	teshuforce = (int)me->query_skill(force_skill,1);	
    write( HIW "你全身放松，坐下来开始运功疗伤。\n" NOR);
    message("vision", HIW + me->name() + "吐出一口瘀血，脸色看起来好多了。\n" NOR, environment(me), me);
	add_jing = 10 + ((int)me->query_skill("force",1)/3+(int)me->query_skill(force_skill, 1))*20*jingreceive/100 + (int)me->query("max_jing")/10*jingreceive/100;
	me->receive_curing("jing", add_jing );
    me->add("neili", -100);
    me->set("jiali", 0);
	me->set("jiajing", 0);
    me->start_busy(1);
    if (me->query_skill_mapped("force") && teshuforce<jibenforce && teshuforce<(level+300)*2) 
		me->improve_skill(force_skill, me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/125+100, 0);
/*	{
		if (force_skill=="taixuan-gong") 
		{
			if ((int)me->query_skill(force_skill, 1) >= 300) me->improve_skill(force_skill, me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/125+100, 0);
		}
		else if (force_skill=="jiuyang-shengong") 
		{
			if ((int)me->query_skill(force_skill, 1) >= 300) me->improve_skill(force_skill, me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/125+100, 0);
		}
		else if (force_skill=="jiuyin-zhenjing") 
		{
			if ((int)me->query_skill(force_skill, 1) >= 300) me->improve_skill(force_skill, me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/125+100, 0);
		}
		else 
			me->improve_skill(force_skill, me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/125+100, 0);
	}*/
	if (jibenforce<(level+100)*4) me->improve_skill("force", me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/300+100, 0);
    return 1;
}
//2018.6.25阿飞改，给其他人疗伤使用单独的功能
int heal_target(object me,object target)
{
	int flag,jineng_exp_add,level,jibenforce,teshuforce;
	int jingreceive=10,add_jing=10;
    string force_skill=me->query_skill_mapped("force");

	if (userp(me) && !wizardp(me))
		return notify_fail("给他人疗伤请使用更加强大的exert lifeheal。\n");		
    if( !target->is_character() || target->is_corpse() )
        return notify_fail("看清楚一点，那并不是活物。\n");
    if (!stringp(force_skill)) 
		return notify_fail("你所学的内功中没有这项技能。\n");
    if( me->is_fighting() || target->is_fighting())
        return notify_fail("战斗中无法运功疗伤！\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if( me->is_busy() )
		return notify_fail("你现在正忙着呢，哪有空运功？\n");
	if ((int)me->query_skill("force", 1) < 100)
		return notify_fail("你还是先学点基本内功吧。\n");
    if ((int)me->query_skill(force_skill, 1) < 100)
        return notify_fail("你的"+to_chinese(force_skill)+"修为还不够。\n");
	if( me->query_condition("no_force") )
		return notify_fail("你的丹田真气狂泻不止，浑身无力，如何能疗伤呢。\n");
	if( target->query_condition("no_force") )
		return notify_fail("对方的丹田真气错乱，一旦受到真气震荡，顷刻毙命。\n");
    if( (int)me->query("neili") < 1000 )
        return notify_fail("你的真气不够。\n");
    if( (int)me->query("max_neili") < 1000 )
        return notify_fail("你的内力修为不够。\n");
    if( target && (int)target->query("eff_jing") < (int)target->query("max_jing") / 3 )
        return notify_fail( target->name() + "已经受伤过重，经受不起你的真气震荡！\n");
    if( target && (int)target->query("eff_jing") == (int)target->query("max_jing")  )
        return notify_fail(target->name()+"现在不需要疗伤！\n");
	
	if( SKILL_D(force_skill)->jing_heal() ) jingreceive = SKILL_D(force_skill)->jing_heal();
	if(me->query("xyhy_type")==2) flag = 5/4;	//黄金会员打坐增加技能熟练度1.25倍
	else flag = 1;
	if (me->query_temp("jineng_exp_add")) jineng_exp_add = (int)me->query_temp("jineng_exp_add",1);	//处于技能自练提升状态时
	else jineng_exp_add = 0;		
	level = (int)me->query("xyzx_sys/level");
	jibenforce = (int)me->query_skill("force",1);
	teshuforce = (int)me->query_skill(force_skill,1);	
    message_vision( HIY "$N坐了下来运起内功，将手掌贴在$n背心，缓缓地将真气输入$n体内....\n\n"
           "过了不久，$N额头上冒出豆大的汗珠，$n吐出一口瘀血，脸色看起来红润多了。\n" NOR, me, target );
	add_jing = 10 + ((int)me->query_skill("force",1)/3+(int)me->query_skill(force_skill, 1))*20*jingreceive/100 + (int)target->query("max_jing")/10*jingreceive/100;
	target->receive_curing("jing", add_jing );
    me->add("neili", -150);
	me->set("jiali", 0);
	me->set("jiajing", 0);
	target->set("jiali", 0);
	target->set("jiajing", 0);
    me->start_busy(2);
    if (me->query_skill_mapped("force") && teshuforce<jibenforce && teshuforce<(level+300)*2) 
	{
		if (force_skill=="taixuan-gong") 
		{
			if ((int)me->query_skill(force_skill, 1) >= 300) me->improve_skill(force_skill, me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/100+100, 0);
		}
		else if (force_skill=="jiuyang-shengong") 
		{
			if ((int)me->query_skill(force_skill, 1) >= 300) me->improve_skill(force_skill, me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/125+100, 0);
		}
		else if (force_skill=="jiuyin-zhenjing") 
		{
			if ((int)me->query_skill(force_skill, 1) >= 300) me->improve_skill(force_skill, me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/125+100, 0);
		}
		else 
			me->improve_skill(force_skill, me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/100+100, 0);
	}
	if (jibenforce<(level+100)*4) me->improve_skill("force", me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/250+100, 0);
    return 1;
}
int exert(object me, object target)
{
    if( !target ||  target == me)
        return heal_myself(me);
    else
        return heal_target(me,target);
}

