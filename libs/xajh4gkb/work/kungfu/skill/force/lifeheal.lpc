// lifeheal.c
#include <ansi.h>
#include <skill.h>
int heal_target(object me, object target) {
  int flag, level, jibenforce, teshuforce, jineng_exp_add;
  int qireceive = 50, jingreceive = 50, add_qi = 10, add_jing = 10;
  string force_skill = me->query_skill_mapped("force");

  if (!target || !target->is_character() || target->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");
  if (!stringp(force_skill))
    return notify_fail("你所学的内功中没有这项技能。\n");
  if (me == target)
    return notify_fail("自己给自己做人工呼吸？你能做得到吗？\n");
  if (me->is_fighting() || target->is_fighting())
    return notify_fail("战斗中无法做人工呼吸！\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢，哪有空运功？\n");
  //	if (me->query_temp("autolian"))
  //		return notify_fail("你正在发动自动连招！\n"); 	
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
  if ((int)me->query_skill("force", 1) < 200)
    return notify_fail("你基本内功不够扎实，别害人性命了。\n");
  if ((int)me->query_skill(force_skill, 1) < 200)
    return notify_fail("你的" + to_chinese(force_skill) + "修为还不够。\n");
  if (me->query_condition("no_force"))
    return notify_fail("你的丹田真气狂泻不止，浑身无力，如何能疗伤呢。\n");
  if (target->query_condition("no_force"))
    return notify_fail("对方的丹田真气错乱，一旦受到真气震荡，顷刻毙命。\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的真气不够。\n");
  if ((int)target->query("eff_qi") >= (int)target->query("max_qi") && (int)target->query("eff_jing") >= (int)target->query("max_jing"))
    return notify_fail(target->name() + "现在很清醒，你想强行为" + (target->query("gender") == "女性" ? "她" : "他") + "做人工呼吸？恐怕会挨揍吧。\n");
  if ((int)target->query("eff_qi") < (int)target->query("max_qi") * 2 / 10 || (int)target->query("eff_jing") < (int)target->query("max_jing") * 2 / 10)
    return notify_fail(target->name() + "已经受伤过重，经受不起你的真气震荡！\n");
  if (!living(target))
    return notify_fail(target->name() + "现在都这样了，不需要你为" + (target->query("gender") == "女性" ? "她" : "他") + "做人工呼吸！你想趁人之危吗！\n");

  if (SKILL_D(force_skill)->qi_heal()) qireceive = SKILL_D(force_skill)->qi_heal();
  if (SKILL_D(force_skill)->jing_heal()) jingreceive = SKILL_D(force_skill)->jing_heal();
  if (me->query("xyhy_type") == 2) flag = 1.25;  //黄金会员打坐增加技能熟练度1.25倍
  else flag = 1;
  if (me->query_temp("jineng_exp_add")) jineng_exp_add = (int)me->query_temp("jineng_exp_add", 1);  //处于技能自练提升状态时
  else jineng_exp_add = 0;
  level = (int)me->query("xyzx_sys/level");
  jibenforce = (int)me->query_skill("force", 1);
  teshuforce = (int)me->query_skill(force_skill, 1);
  message_vision(HIY "$N坐了下来运起内功，深吸了一口气，嘴对着$n的嘴，缓缓地将真气输入$n体内....\n\n"
    "过了不久，$N额头上冒出豆大的汗珠，$n深深地吐出一口气，脸色看起来红润多了。\n" NOR,
    me, target);
  add_qi = 10 + ((int)me->query_skill(
    "force",
    1
  ) / 3 + (int)me->query_skill(
    force_skill,
    1
  )) * 20 * qireceive / 100 + (int)target->query("max_qi") / 10 * qireceive / 100;
  target->receive_curing("qi", add_qi);
  add_jing = 10 + ((int)me->query_skill(
    "force",
    1
  ) / 3 + (int)me->query_skill(
    force_skill,
    1
  )) * 20 * jingreceive / 100 + (int)target->query("max_jing") / 10 * jingreceive / 100;
  target->receive_curing("jing", add_jing);
  me->add("neili", -200);
  me->set("jiali", 0);
  me->set("jiajing", 0);
  target->set("jiali", 0);
  target->set("jiajing", 0);
  me->start_busy(2);
  if (me->query_skill_mapped("force") && teshuforce < jibenforce && teshuforce < (level + 300) * 2)
    me->improve_skill(
      force_skill,
      me->query_con() * flag * me->query(
        "con",
        1
      ) * me->query_exp_times() * (jineng_exp_add + 100) / 100 + 100,
      0
    );
  /*	{
		if (force_skill=="taixuan-gong") 
		{
			if ((int)me->query_skill(force_skill, 1) >= 300) me->improve_skill(force_skill, me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/100+100, 0);
		}
		else if (force_skill=="jiuyang-shengong") 
		{
			if ((int)me->query_skill(force_skill, 1) >= 300) me->improve_skill(force_skill, me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/125+100, 0);
		}
		else if (force_skill=="jiuyin-zhenjing") 
		{
			if ((int)me->query_skill(force_skill, 1) >= 300) me->improve_skill(force_skill, me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/125+100, 0);
		}
		else 
			me->improve_skill(force_skill, me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/100+100, 0);
	}*/
  if (jibenforce < (level + 100) * 4) me->improve_skill(
    "force",
    me->query_con() * flag * me->query(
      "con",
      1
    ) * me->query_exp_times() * (jineng_exp_add + 100) / 250 + 100,
    0
  );
  return 1;
}
int exert(object me, object target) {
  if (!target || target == me)
    return notify_fail("不能给自己续气！\n");
  else
    return heal_target(me, target);
}
