// recover.c
//inherit SSERVER;
#include <skill.h>
int exert(object me, object target)
{
    int n, q,flag,jineng_exp_add,level,jibenforce;
    if (me != target)
        return notify_fail("你只能用内功恢复自己的精力。\n");
    if (userp(me) && !wizardp(me))
        return notify_fail("这个功能只有NPC才能使用。\n");
	if( me->query_condition("no_exert") )
		return notify_fail("你的丹田真气乱窜，无法运功平息。\n");
    if ((int)me->query("neili") < 20)
        return notify_fail("你的内力不够。\n");
    q = (int)me->query("max_jingli") - (int)me->query("jingli");
    if (q < 10)
        return notify_fail("你现在精力充沛。\n");
	if(!me->query_skill("force"))
		return notify_fail("你尚未学过内功心法。\n");   

	if(me->query("xyhy_type")==2) flag = 5/4;	//黄金会员打坐增加技能熟练度1.25倍
		else flag = 1;
	if (me->query_temp("jineng_exp_add")) jineng_exp_add = (int)me->query_temp("jineng_exp_add",1);	//处于技能自练提升状态时
	else jineng_exp_add = 0;	
    n = 100 * q / me->query_skill("force");
    n = 100 * n / me->query_con();
	level = (int)me->query("xyzx_sys/level");
	jibenforce = (int)me->query_skill("force",1);
    if (n < 20) n = 20;
    if ((int)me->query("neili") < n) 
	{
        q = q * (int)me->query("neili") / n;
        n = (int)me->query("neili");
    }
    me->add("neili",-n);
    me->add("jingli", q);
    if(me->query("jingli")<me->query("max_jingli"))
    me->set("jingli",me->query("max_jingli"));
    
	message_vision("$N深深吸了几口气，感觉到又充满了活力。\n", me);
	if( me->is_fighting() ) me->start_busy(2);
	if (jibenforce<(level+100)*4) me->improve_skill("force", me->query_con()*flag*me->query("con",1)*me->query_exp_times()*(jineng_exp_add+100)/10000+100,0);
//	me->improve_skill("force", random(me->query_skill("force", 1)),0);
    return 1;
}
