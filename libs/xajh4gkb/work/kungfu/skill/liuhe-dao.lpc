int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力不够。\n");
	if (me->query("family/family_name")!="丐帮")
		return notify_fail("你不是丐帮弟子，无法学习本门技能。\n");	
	if (!me->query("jm/huashan"))
		return notify_fail(CYN"华山派之人多伪君子之流，近来常有华山弟子与我丐帮发生冲突。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"想要加入我丐帮，需得为我帮去查清华山派的秘密！\n"NOR);
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);		
    if ((int)me->query_skill("huntian-qigong", 1) < 100)		
        return notify_fail("你的浑天气功火候不够，无法学习六合刀法。\n");	
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");	
	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	if(level >= action[i]["lvl"])
		return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_skill("liuhe-dao",1) < 199)
		return notify_fail("此项技能只能大于二百级时能学习。\n");
	if (me->query("family/family_name")!="丐帮")
		return notify_fail("你不是丐帮弟子，无法练习本门技能。\n");	
	if (!me->query("jm/huashan"))
		return notify_fail(CYN"华山派之人多伪君子之流，近来常有华山弟子与我丐帮发生冲突。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"想要加入我丐帮，需得为我帮去查清华山派的秘密！\n"NOR);
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");	
	if ((int)me->query("jing") < 100)
		return notify_fail("你的精力不够练此武功。\n");
	if ((int)me->query("qi") < 100)
		return notify_fail("你的体力不够练此武功。\n");
	if ((int)me->query("neili") < 100)
		return notify_fail("你的内力不够练此武功。\n");
	me->receive_damage("qi", 50);
	me->receive_damage("jing", 50);
	me->add("neili", -50);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"liuhe-dao/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{	
	int ap,dp,damage1,damage2,damage,liannum;
	object weapon;
	weapon = me->query_temp("weapon");
	ap =  me->query_skill("liuhe-dao",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	damage1 = (int)me->query_skill("liuhe-dao",1);
	damage2 = (int)me->query_skill("liuhe-dao",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("huntian-qigong",1) < 100 || me->query_skill("liuhe-dao",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "huntian-qigong") return 0;
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		message_vision(HIC"$N发挥六合刀法的精要，$n只觉一片刀光袭来，已是被刀气所伤！。\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，手中" + weapon->name() + HIG "朴实无比，$n难以取巧，招招硬拼。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/gaibang") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(2);
		message_vision(HIM"$N洞融汇丐帮武功精髓，刀走六合，招式精妙，一挑一打，一拨一转，$n左跳右蹦，手忙脚乱。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}

}
