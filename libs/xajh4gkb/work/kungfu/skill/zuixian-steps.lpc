int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("max_neili") < 5000 )
		return notify_fail("你的内力不够，没有办法练醉仙望月步。\n");
	if (me->query("family/family_name")!="蜀山派")
		return notify_fail("你不是蜀山弟子，无法学习醉仙望月步。\n");
    if ((int)me->query_skill("shushan-force", 1) < 100)
		return notify_fail("你的蜀山内功火候不够，无法学习醉仙望月步。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	
	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("qi") < 30 || (int)me->query("neili") < 30 )
		return notify_fail("你的气或内力不够，不能练醉仙望月步。\n");
	if (me->query("family/family_name")!="蜀山派")
		return notify_fail("你不是蜀山弟子，无法练习醉仙望月步。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	me->receive_damage("qi", 30);
	me->add("neili", -3);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"zuixian-steps/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;

	ap = me->query_skill("zuixian-steps", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("parry",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("zuixian-steps", 1);
	damage2 = me->query_skill("zuixian-steps", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("shushan-force",1) < 300 || me->query_skill("zuixian-steps", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="shushan-force" ) return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIG"$N醉眼朦胧，脚步东倒西歪的，看似不可能，实则一摇一晃间就闪开了$n的攻击！\n"NOR;
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，如太白醉酒，人生得意须尽欢，奔流到海不复回。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/shushan") )
	{
		j = -(damage+random(damage));
		me->add("neili", -100 );
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		if (!ob->is_busy()) ob->start_busy(1);
		message_vision(HIB"$N融汇蜀山派武学精髓，脚下离火冲天剑，上可入天，下可入地，瞬息九万七千里！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
}

