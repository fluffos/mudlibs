int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ( me->query("int",1) < 25 )
		return notify_fail("琴棋书画乃是极其风雅之事，" +RANK_D->query_respect(me)+" 似乎太过于俗气了些。\n");
    if ((int)me->query_skill("force", 1) < 100)
        return notify_fail("你的内功心法火候不够。\n");
    if ((int)me->query("max_neili") < 10000)
        return notify_fail("你的内力太弱。\n");
    if( (int)me->query_skill("art", 1) < 300 )
        return notify_fail("你的琴棋书画还不到家！\n");
    if( (int)me->query_skill("music", 1) > (int)me->query_skill("art", 1) )
        return notify_fail("学习声乐要以琴棋书画为基础！\n");
	if ((int)me->query("score",1) < 10000)
		return notify_fail("琴棋书画需要体验人间百态，一看你就知道阅历不丰。\n");
	if (random(100)==1) me->add("score",-10);	
    return 1;
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ( me->query("int",1) < 25 )
		return notify_fail("琴棋书画乃是极其风雅之事，" +RANK_D->query_respect(me)+" 似乎太过于俗气了些。\n");
	if ((int)me->query("qi") < 100)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 100)
		return notify_fail("你的内力不够。\n");
	if( (int)me->query_skill("art", 1) < 500 )
		return notify_fail("你的琴棋书画还不到家，不能自行研究！\n");
    if( (int)me->query_skill("music", 1) > (int)me->query_skill("art", 1) )
         return notify_fail("学习棋道要以琴棋书画为基础！\n");

	me->receive_damage("qi", 50);
	return 1;
}

mapping query_action(object me, object weapon)
{
	if (( (int)me->query_skill("unarmed", 1) >= 500 ) 
	&& ( (int)me->query_skill("music", 1) >= 500 )
	&& ( (int)me->query("neili") >= 500 )
    && random(8)==0 
	&& me->query("jiali")>100 ) 
	{
		return ([
		"action": HIG"$N左手拇指食指虚捻，右手轻挥，空气中骤生"+(order[random(13)])+"「变商」"HIG"之音，一轮音波击向$n。"NOR,
		"attack":	300,
		"parry":	300,
		"dodge":	300,
		"damage":	300,
		"force":	300,
		"damage_type": "内伤"
		]);
	}
	return action[random(sizeof(action))];
} 

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;
	string name;
	name = xue_name[random(sizeof(xue_name))];
    ap = me->query_skill("music",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("music",1);
	damage2 = (int)me->query_skill("music",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("music",1)<100) return 0;
	if (objectp(me->query_temp("weapon")) ) return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		if (!victim->is_busy()) victim->start_busy(2);
		message_vision(BLU "只听一阵淳厚的弦音从$N" BLU "处传来，$n" HIY "『" + name + "』" NOR + BLU "顿时受震，两耳轰鸣，全身真气乱窜不止！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，手指随意拨弄琴弦，$n" HIY "『" + name + "』" NOR + HIG "真气顿时错乱，不由自主吐出一口精血。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/qqsh") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIM"$N融汇琴棋书画精髓，取出玉箫，吹奏一曲将军令，$n霎时如被雷击，张口喷出一道鲜血。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string name;
	int ap,dp,j,damage1,damage2;
	name = xue_name[random(sizeof(xue_name))];
	ap = me->query_skill("music", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("force",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("music", 1);
	damage2 = me->query_skill("music", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (objectp(me->query_temp("weapon")) ) return damage;
	if ( me->query_skill("music", 1) < 300) return damage;
//	if ( me->query_skill_mapped("force") != "yijing-force") return 0;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
		me->add("eff_qi",damage1);
		if (me->query("eff_qi")> me->query("max_qi") )me->set("eff_qi",me->query("max_qi"));
		me->add("eff_jing",damage1);
		if (me->query("eff_jing")> me->query("max_jing") )me->set("eff_jing",me->query("max_jing"));
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(HIG"$N心神合一，琴弈相通，弈道的"+(order[random(13)])+"「得算篇」"NOR"历历在目，身形骤然轻巧起来。\n"NOR, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		if (!ob->is_busy()) ob->start_busy(1);
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，双手划过琴弦，琴音诈起，$n" HIY "『" + name + "』" NOR + HIY "一痛，招式刹那终止，真气反噬回来。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/qqsh") )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );
		message_vision(HIB"$N融汇琴棋书画精髓，提气汇聚丹田，突然“拙”的一声，$n被击飞数丈远，狂喷鲜血！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
}


string perform_action_file(string action)
{
    return __DIR__"music/" + action;
}