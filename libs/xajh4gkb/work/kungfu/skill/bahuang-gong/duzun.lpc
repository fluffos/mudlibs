// transfer.c

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int exert(object me, object target) {
  int ap, dp, damage;

  if (target == me || !target) {
    me->clean_up_enemy();
    target = me->select_opponent();
  }
  if (!me->is_fighting(target))
    return notify_fail("「唯我独尊」只能对战斗中的对手使用。\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if ((int)me->query_skill("bahuang-gong", 1) < 500)
    return notify_fail("你的八荒六合唯我独尊功不够熟练。\n");
  if (me->query_skill_mapped("force") != "bahuang-gong")
    return notify_fail(HIC "你未激发八荒六合唯我独尊功!\n" NOR);
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的真气不足。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("max_neili") < 200000)
    return notify_fail("你的真气不足。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  message_vision(HIC "$N运转八荒六合唯我独尊功，脸色青红交替，浑身气息捉摸不定。\n", me, target);
  ap = me->query("xyzx_sys/level") + me->query_skill("bahuang-gong", 1) + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("force");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1		

  if (random(ap) > dp / 3) {
    message_vision(HIR "$N与$n拼了一掌，八荒内劲侵入$n筋脉，$N唯我独尊霸气测漏。\n", me, target);
    damage = random(target->query("age")) * me->query_skill("bahuang-gong", 1) / 20 + 10;
    damage = damage * (100 - target->query_meridian()) / 100;
    target->receive_wound("qi", damage, me);
    target->receive_wound("qi", damage / 2, me);
    message_vision(
      HIW "$n被八荒功真气侵入，全身不受控制，身体缩小，身心受到重创！\n",
      me,
      target,
      damage,
      HBWHT + HIM "气血伤害" NOR
    );  //2018.10.2阿飞改，优化化学伤害显示的写法
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
  } else {
    message_vision(HIR "$n受到$N内力一震，觉得一股热气突然从丹田涌了上来，真气逆行。\n", target, me);
    damage = random(me->query("age")) * me->query_skill("bahuang-gong", 1) / 20 + 10;
    damage = damage * (100 - me->query_meridian()) / 100;
    me->receive_wound("qi", damage, target);
    me->receive_wound("qi", damage / 2, target);
    message_vision(
      HIW "$n强行运转八荒六合唯我独尊功，将真气散入全身，顿时返老还童，身形变为幼童模样，身心重创！\n",
      target,
      me,
      damage,
      HBWHT + HIM "气血伤害" NOR
    );  //2018.10.2阿飞改，优化化学伤害显示的写法
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
  }
  me->add("neili", -500);
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
