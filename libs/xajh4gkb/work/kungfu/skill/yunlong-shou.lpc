int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练云龙手必须空手。\n");
  if (me->query("family/family_name") != "云龙门")
    return notify_fail("不加入云龙门，学不了本门技能。\n");
  if ((int)me->query_skill("yunlong-shengong", 1) < 300)
    return notify_fail("你的云龙神功火候不够，无法学习本门技能。\n");
  if ((int)me->query_skill("force", 1) < 300)
    return notify_fail("你的基本内功火候不够，无法学云龙手。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练云龙手。\n");
  if ((int)me->query_skill("unarmed", 1) < 300)
    return notify_fail("你的基本手法火候不够，无法学云龙手。\n");
  if ((int)me->query("str", 1) < 30)
    return notify_fail("云龙手看似灵巧，实则皆是重手，以你的资质恐怕难以练习。\n");
  //	if (2*(int)me->query_skill("yunlong-xinfa",1) <(int)me->query_skill("yunlong-shou",1))
  //		return notify_fail("你的云龙心法火候不够，无法继续学云龙手。\n");
  if (me->query_skill("unarmed", 1) <= me->query_skill("yunlong-shou", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"])
      return action[i - 1]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}


int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练云龙手。\n");
  if (me->query("family/family_name") != "云龙门")
    return notify_fail("不加入云龙门，练习不了本门技能。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yunlong-shou/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;

  ap = me->query_skill(
    "yunlong-shou",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("yunlong-shou", 1);
  damage2 = (int)me->query_skill(
    "yunlong-shou",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "yunlong-shengong",
    1
  ) < 100 || me->query_skill("yunlong-shou", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "yunlong-shengong") return 0;
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIR "咯嘣“一声，顿时$n" HIR "一声惨嚎，手臂骨头断成几节！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    me->add("jingli", -100);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，心之所往，招之所至，只听“咔嚓”一声，$n软软的倒了下去。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/yunlong")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(HIM "$N融汇云龙门武学精髓，执子之手，断汝之臂。\n" NOR, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    return;
  }
}
