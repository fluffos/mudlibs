//langzi-sword.c 	浪子三招	下乘武学100~300
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;
mapping *action = ({
([  "action":"$N将手中$w握紧，暴喝一声，不顾$n的凌厉攻击，刺向$n的头顶",
		"attack":	100,
		"parry":	100,
		"dodge":	100,
		"damage":	100,
		"force":	100,
    "lvl" : 0,  
    "damage_type" : "刺伤"
     ]),
([  "action":"$N手中$w一抖将$n的攻势化去，紧跟着反身一剑刺向$n",
		"attack":	200,
		"parry":	200,
		"dodge":	200,
		"damage":	200,
		"force":	200,
    "lvl" : 200, 
    "damage_type" : "刺伤"
    ]),
([  "action":"$n使出最后杀着，怎知$N也使出了最后绝技手中$w向$n对刺过去",
		"attack":	300,
		"parry":	300,
		"dodge":	300,
		"damage":	300,
		"force":	300,
    "lvl" : 500,
      "damage_type":"刺伤",
  ]),
});
int valid_enable(string usage) { return usage == "sword" || usage=="parry"; }
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "juehu-shou"; }		//互备技能
string skill_pinji() {return "下乘";}				//品级区分：上乘、中乘、下乘
string skill_xingbie() {return "通用";}				//性别区分：男性、女性、无性、通用
string skill_zhengxie() {return "中立";}			//正邪区分：正道、邪道、中立
string skill_menpai() {return "通吃帮";}				//门派区分：门派，江湖
string skill_yinyang() {return "中性";}				//阴阳区分：阳、阴、中性
string skill_zhenying() {return "中立";}			//阵营区分：正派、邪派、中立、通用
int damage_damage() {return 62;}	//外伤系数
int force_damage() {return 43;}		//内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{ 
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query_skill("fanyun-force", 1) < 300 && (int)me->query_skill("damo-force", 1) < 300)	
		return notify_fail("你的本门内功火候不够，无法浪子三招。\n");
	if (me->query("family/family_name")!="通吃帮")
		return notify_fail("你不是通吃帮弟子，无法学习本门技能。\n");		
	if (me->query_skill("sword",1) <= me->query_skill("langzi-sword",1))
		return notify_fail("你的基础不够，无法领会更高深的技巧！\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
    return 1;
}
string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	if(level >= action[i]["lvl"])
		return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
    object ob;
	
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
    if( (int)me->query("qi") < 50 ||  (int)me->query("neili") < 35 )
        return notify_fail("你的内力或气不够，没有办法练习浪子三招。\n");
    if (me->query("family/family_name")!="通吃帮")
	return notify_fail("你不是通吃帮弟子，无法练习本门技能。\n");			
    if (!objectp(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    if (!objectp(ob = me->query_temp("secondary_weapon")) || (string)ob->query("skill_type") != "sword")
        return notify_fail("你装备的武器不对。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");	
    me->receive_damage("qi", 30);
    me->add("neili", -20);

   write("你按著所学练了一遍浪子三招。\n");
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"langzi-sword/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	object weapon;
	int ap,dp,damage1,damage2,damage,liannum;
	int flag = 1;
	damage1 = (int)me->query_skill("langzi-sword",1);
	damage2 = (int)me->query_skill("langzi-sword",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	ap = me->query_skill("langzi-sword",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	weapon = me->query_temp("weapon");
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if ( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
	if ( me->query_skill("fanyun-force",1) < 100 && me->query_skill("damo-force",1) < 100)	 return 0;
//	if ( me->query_skill_mapped("force") != "fanyun-force" && me->query_skill_mapped("force") != "damo-force" ) return 0;	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return 0;
	
	if (me->query_skill_mapped("force") == "damo-force") flag = 2;	
	if(me->query("jiali") > 0 && random(ap) > dp/3 && random(7)==1 )
	{
		damage = (damage1*flag+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);	
		me->add("neili", -100);
		message_vision(HIW "$N形骸浪荡，出手放荡不羁，霸气侧漏！$n被$N的霸气伤的体无完肤！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2*flag+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，今朝有酒今朝醉，手中" + weapon->name() + HIG "犹如生了眼睛一般，直刺$n后背。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/tongchi") )
	{
		damage = ((damage1*flag+damage2*flag)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIM"$N洞悉通吃帮武学之谜，脚下进退自如，挥剑带着莫名的气息，$n只好后退一步。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}



