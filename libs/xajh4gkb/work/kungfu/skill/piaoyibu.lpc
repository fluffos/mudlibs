// piaoyibu.c
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
        "$n一个「银鹭渡海」，跃起数尺，躲过了$N这一招。\n",
        "$n身形向后一纵，使出一招「玉兔落尘」，避过了$N的攻击。\n",
        "$n使出「锦鲤穿沙」，恰好躲过了$N的攻势。\n",
        "$n一招「灵狐幻遁」，姿态美妙地躲了开去。\n"
});

int valid_enable(string usage)
{
	return (usage == "dodge");
}
//2019-1-1阿飞新规划，技能代码完善
