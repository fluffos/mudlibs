//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query_skill("zhenfeng-xinfa", 1) < 200)
		return notify_fail("你的「震风心法」火候不够，无法学「飘逸步法」。\n");
	if (me->query("family/family_name")!="圣剑魔宫")
		return notify_fail("你不是圣剑魔宫传人，无法学习飘逸步法。\n");					
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力太弱，无法练「飘逸步法」。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");		
	return 1;
}


string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("qi") < 40 )
		return notify_fail("你的体力太差了，不能练飘逸步法。\n");
	if (me->query("family/family_name")!="圣剑魔宫")
		return notify_fail("你不是圣剑魔宫传人，无法练习飘逸步法。\n");				
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 30);
	return 1;
}
string perform_action_file(string action)
{
	return __DIR__"piaoyibu/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	int ap,dp,j,damage2;

	ap = me->query_skill("piaoyibu", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("sword",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage2 = me->query_skill("piaoyibu", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("zhenfeng-xinfa",1) < 300 || me->query_skill("piaoyibu", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="zhenfeng-xinfa" ) return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(HIG"$N脚踏天、地、人三元方位，飘飘乎在三者之间随意流转！\n"NOR, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，脚踏三元连续变幻方位，$n紧随其后，然不知就里，精神大损。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/shengjian") )
	{
		j = -(damage/3+random(damage/3));
		if (!ob->is_busy()) ob->start_busy(2);
		me->add("neili", -100 );
		message_vision(HIB"$N融汇圣剑魔宫武学精髓，身形突然加快，人如影，身无形，$n急忙撤招防守！\n"NOR, me, ob);
		return j;
	}
}
