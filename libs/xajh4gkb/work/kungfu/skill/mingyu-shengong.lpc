int valid_learn(object me) {
  mapping skl;
  string *sname;
  int i;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "移花宫")
    return notify_fail("你不是移花宫弟子不能使用冥雨神功。\n 要是让两位宫主知道了你可惨了。\n");
  if (me->query("gender") != "女性")
    return notify_fail("移花宫主最讨厌男人,让她知道了可不得了！\n");
  if ((int)me->query("con", 1) < 25)
    return notify_fail("你的根骨太差了，没法冥雨神功。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  skl = this_player()->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "xixing-dafa") continue;
    if (sname[i] == "yijing-force") continue;
    if (sname[i] == "mingyu-shengong") continue;
    if (SKILL_D(sname[i])->valid_enable("force"))
      return notify_fail("你不先散了别派内功，怎能学冥雨神功？！\n");
  }
  return 1;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int ap, dp, j, damage1, damage2;

  ap = me->query_skill(
    "mingyu-shengong",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "force",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = me->query_skill("mingyu-shengong", 1);
  damage2 = me->query_skill(
    "mingyu-shengong",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill("mingyu-shengong", 1) < 300) return damage;
  if (me->query_skill_mapped("force") != "mingyu-shengong") return damage;

  if (random(8) == 0 && random(ap) > dp / 3) {
    msg = HIB "$N" HIB "运起冥雨神功！！全身的伤口一瞬间止住了鲜血！\n" NOR;
    me->add("neili", -100);
    j = -(damage / 3 + random(damage / 3));
    me->add("eff_jing", damage1);
    if (me->query("eff_jing") > me->query("max_jing")) me->set("eff_jing", me->query("max_jing"));
    me->add("jing", damage1);
    if (me->query("jing") > me->query("eff_jing")) me->set("jing", me->query("eff_jing"));
    me->add("eff_qi", damage1);
    if (me->query("eff_qi") > me->query("max_qi")) me->set("eff_qi", me->query("max_qi"));
    me->add("qi", damage1);
    if (me->query("qi") > me->query("eff_qi")) me->set("qi", me->query("eff_qi"));
    message_vision(msg, me, ob);
    return j;
  }
  if (random(8) == 1 && random(ap) > dp / 3) {
    msg = HIB "一股寒气优似冰箭，循着手臂，迅速无伦的射入$n的胸膛\n" NOR;
    ob->apply_condition("cold_poison", 20);
    me->add("neili", -100);
    j = -(damage / 3 + random(damage / 3));
    message_vision(msg, me, ob);
    return j;
  }
  if (random(ap) > dp / 3 && random(8) == 2 && (int)me->query("breakup") > 1) {
    msg = HIR "$N" HIR "顿悟" + me->query("cognize") + HIR "，默念冥雨神功总诀，收敛内劲，承下$n" + HIR "这一招，$n" HIR "只觉犹如进入绵绵长河中，一股柔劲透了过来。\n" NOR;
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(msg, me, ob, damage2, HBWHT + HIY "精神反伤" NOR);
    return j;
  }
  if (random(ap) > dp / 3 && random(8) == 3 && (int)me->query("jm/yihua")) {
    msg = HIR "$N融汇移花宫内功精髓" HIR "微微一笑，浑若无事的接下了$n" HIR "这一招，纯阴之劲随之而起，反击回去。\n" NOR;
    j = -(damage / 3 + random(damage / 3));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    message_vision(msg, me, ob, damage1, HBWHT + HIY "气血反伤" NOR);
    return j;
  }
  if (random(8) == 4 && random(ap) > dp / 3) {
    msg = HIR "$n" HIR "一招击中$n" HIR "上身，可却犹如击在棉花上一般，力道顿时消失得无影无踪。\n" NOR;
    ob->apply_condition("ice_poison", 20);
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(msg, me, ob);
    return j;
  }
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int ap, dp, damage1, damage2, damage, liannum;

  ap = me->query_skill(
    "mingyu-shengong",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "force",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("mingyu-shengong", 1);
  damage2 = (int)me->query_skill(
    "mingyu-shengong",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("mingyu-shengong", 1) < 100) return 0;
  if (me->query_skill_mapped("force") != "mingyu-shengong") return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIM "$N冥雨神功的潜力发挥了出来，突然间$n" HIR "只感喉咙一甜，喷出一口鲜血！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    victim->apply_condition(
      "ice_poison",
      (me->query_skill("mingyu-shengong", 1)) / 100 + 1 + victim->query_condition("ice_poison")
    );
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，只见$N" HIR "冥雨神功内劲自体内迸发，一股柔劲随招式而荡漾，摧毁了$n" HIR "的真元！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/yihua")) {
    me->add("neili", -100);
    COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), 1);
    COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), 1);
    victim->apply_condition(
      "cold_poison",
      (me->query_skill("mingyu-shengong", 1)) / 100 + 1 + victim->query_condition("cold_poison")
    );
    message_vision(HIM "$N领悟移花宫精髓，前招将落，后招已至，前后两招形如一式，此起彼伏，连绵不绝！\n" NOR, me, victim);
    return;
  }
}


int query_effect_parry(object attacker, object me) {
  int lvl;

  lvl = me->query_skill("mingyu-shengong", 1);
  if (lvl < 150) return 0;
  if (lvl < 200) return 70;
  if (lvl < 250) return 80;
  if (lvl < 300) return 90;
  if (lvl < 350) return 100;
  if (lvl < 400) return 110;
  return 120;
}

int practice_skill(object me) {
  return notify_fail("冥雨神功只能用学(learn)的来增加熟练度。\n");
}

string perform_action_file(string action) {
  return __DIR__ "mingyu-shengong/" + action;
}

string exert_function_file(string action) {
  return __DIR__ "mingyu-shengong/" + action;
}

void skill_improved(object me) {
  int lvl, layer;

  lvl = me->query_skill("mingyu-shengong", 1);
  layer = lvl / 90;

  if ((lvl % 90) == 0 && layer > 9) {
    tell_object(me, HIY "你的冥雨神功又进了一层。\n" NOR);
  } else if ((lvl % 90) == 0) {
    tell_object(me, HIY "你炼成了第" + chinese_number(layer) + "层的冥雨神功。\n" NOR);
  }
}

