string query_parry_msg(object me,object weapon)
{
    object my_weapon;

    if (!(my_weapon=me->query_temp("weapon"))){
    	if (!(my_weapon=me->query_temp("secondary_weapon")))
		  return "";
     }else{
	    if (!valid_enable(my_weapon->query("skill_type"))){
    		if (!(my_weapon=me->query_temp("secondary_weapon")))
				  return "";
			else			
			    if (!valid_enable(my_weapon->query("skill_type")))
				  return "";
	    }
	}
    if (weapon)
    	return parry_msg[random(sizeof(parry_msg))];
	else
	    return parry_msg2[random(sizeof(parry_msg2))];
}

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if (me->query("family/family_name")!="华山派" || me->query("family/master_id")!="feng qingyang")
        return notify_fail("独孤九剑只能向华山风清扬学习。\n");
    if ((int)me->query("max_neili") < 100000)
        return notify_fail("你的内力不够。\n");
    if (me->query_skill("sword", 1) <=me->query_skill("dugu-jiujian", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    if ((int)me->query("int",1) < 30)
        return notify_fail("以你的悟性难以领悟独孤剑意。\n");	
    if ((int)me->query_skill("sword", 1) < 5000)	
        return notify_fail("你的基础剑法不够，难以领会独孤求败的寂寞。\n");	
    if ((int)me->query_skill("dugu-jiujian",1) > 300)
        return notify_fail("这套剑法我就教到这儿，以后就要靠你自己练了。\n");
	if ((int)me->query("score",1) < 10000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(10)==1) me->add("score",-10);
    return 1;
}
mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}
int practice_skill(object me)
{
    return notify_fail("独孤九剑只能通过「"+RED+"总诀式"+NOR+"」来演练。\n");
}
string perform_action_file(string action)
{
    return __DIR__"dugu-jiujian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{	
	int ap,dp,damage1,damage2,damage,liannum;
	object weapon1,weapon2;
	weapon1 = me->query_temp("weapon");
	weapon2 = victim->query_temp("weapon");
	ap = me->query_skill("dugu-jiujian",1) * me->query("int",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1) * victim->query("dex",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;	
	damage1 = (int)me->query_skill("dugu-jiujian",1) + (int)me->query_skill("sword",1)/10;
	damage2 = (int)me->query_skill("dugu-jiujian",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if ( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
	if ( me->query_skill("dugu-jiujian",1) < 100) return 0;
//	if ( me->query_skill_mapped("force") != "shenghuo-shengong") return 0;
	if (!objectp(weapon1 = me->query_temp("weapon")) || (string)weapon1->query("skill_type") != "sword") return 0;

	if( random(ap) > dp/3 && me->query("jiali")>0 && random(7)==0 && objectp(weapon2 = victim->query_temp("weapon")))
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		if(random(2)==0)
		{
			weapon2->unequip();			
			weapon2->move(environment(victim));
			me->add("neili", -100);
			return HIY "只见$N窥见$n招式的破绽，挥舞" + weapon1->name() + HIY"，正好一剑击在$n破绽所在，$n情急之下只好放弃了手中的" + weapon2->name() +HIY"！\n" NOR;
		}
		else
		{
			me->add("neili",-100);
			victim->add("neili", -damage );
			return HIB "$n天赋异禀，招式随意变换，对手中的"+weapon2->name()+HIB"掌控自如，一收一放之间，$N无从下手。\n" NOR;
		}
	}
	if( random(ap) > dp/3 && me->query("jiali")>0 && random(7)==1) 
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIR "$N" HIC "使出独孤九剑之「破掌式」, 将劲力聚在剑尖，企图以意使剑！ $n顿时觉得眼前一花，手心一凉，手掌中心多了个血窟窿！\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		victim->add("neili", -damage);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，潜运独孤九剑「破气式」，运气贯剑使其由利返钝，毫无花俏地直刺$n的丹田！$n顿时觉得眼前一花，气海穴上微微一痛！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/dugu") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(2);
		message_vision(HIR "$N" HIR "洞悉独孤九剑之无招胜有招，眼中尽是$n的破绽，举剑一刺！$n飙出一道血箭！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}	
	if( random(ap) > dp/3 && me->query("jiali")>0 && random(7)==4)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->map_skill("parry");	//下特殊招架
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIR "$N" HIC "使出独孤九剑之「破招式」, 随手一剑击在$n的破绽，$n一时半会难以招架！\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage)
{
	int j,ap,dp,damage1,damage2;
	object weapon1,weapon2;
	weapon1 = me->query_temp("weapon");
	weapon2 = ob->query_temp("weapon");
	ap = me->query_skill("dugu-jiujian", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("unarmed", 1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("dugu-jiujian", 1);
	damage2 = me->query_skill("dugu-jiujian", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if (damage <10) damage=10;
	if ( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if ( me->query_skill("dugu-jiujian",1) < 100) return damage;
	if (!objectp(weapon1 = me->query_temp("weapon")) || (string)weapon1->query("skill_type") != "sword") return damage;
	if ( random(ap)>dp/4 && random(8)==1 )
	{
		j = -(damage+random(damage));
		if (!ob->is_busy()) ob->start_busy(2);
		me->add("neili", -100 );
		message_vision(HIY"只见$n招式用老，$N一眼识破，抬手间击在$n下招未发之处，$n只好变招！\n"NOR, me, ob);
		return j;
	}
	if ( random(ap)>dp/4 && random(8)==2 && (int)me->query("breakup") >1 )
	{
		j = -damage;
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIG "$n一招甫出，但见$N提剑平端，其"+me->query("cognize")+HIG"的剑意隐忍待发，$n心神一震，正好撞在$N剑尖。\n" NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if ( random(ap)>dp/4 && random(8)==3 && (int)me->query("jm/dugu") )
	{
		j = -(damage/2+random(damage));
		if (objectp(weapon2 = ob->query_temp("weapon")))
		{
			ob->map_skill(weapon2->query("skill_type"));
		} 
		else 
		{
			ob->map_skill("hand");
			ob->map_skill("strike");
			ob->map_skill("cuff");
			ob->map_skill("claw");
			ob->map_skill("unarmed");
			ob->map_skill("finger");
		}
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );
		message_vision(HIG "$N顿悟独孤九剑之无招境界，随手一剑，蕴涵「总决式」剑意，$n变化数招仍难以出招。\n" NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
}