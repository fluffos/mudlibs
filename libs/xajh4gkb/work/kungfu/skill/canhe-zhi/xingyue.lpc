// jinshe-jianfa perform
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
        string msg;
        int i, extra, max;

	if( !target ) target = offensive_target(me);
	if( !target || !me->is_fighting(target) )
		return notify_fail("「星月连环」只能在战斗中对对手使用。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
//	if ( me->query_skill_mapped("force") != "shenyuan-gong" )
//		return notify_fail("没有神元功的催动无法使出「星月连环」！\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (objectp(me->query_temp("weapon")))
		return notify_fail("你必须空手才能使用参合指的「星月连环」。\n");
//	if (me->query_skill_mapped("unarmed") != "canhe-zhi")
//		return notify_fail("你现在没有准备使用参合指。\n");	
	if(me->query_skill("canhe-zhi", 1) < 500 )
		return notify_fail("你的参合指还不够娴熟，使不出「星月连环」。\n");
	if(me->query_skill("douzhuan-xingyi", 1) < 500 )
		return notify_fail("你的斗转星移还不够娴熟，使不出「星月连环」。\n");
	if( (int)me->query_skill("shenyuan-gong",1) < 500 )
		return notify_fail("你的本门内功等级不够，使不出「星月连环」。\n");
	if( (int)me->query("max_neili") < 500000 )
		return notify_fail("你内力修为不足，使不出「星月连环」。\n");      
	if( (int)me->query("max_jingli") < 500000 )
		return notify_fail("你精力修为不足，使不出「星月连环」。\n");  
	if( (int)me->query("neili") < me->query_skill("canhe-zhi", 1)*4)
		return notify_fail("你现在真气太弱，使不出「星月连环」。\n"); 
	if( (int)me->query("jingli") < me->query_skill("canhe-zhi", 1)*2 )
		return notify_fail("你现在精力太弱，使不出「星月连环」。\n"); 
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = BLU"\n$N十指急弹，无形进气连绵不绝，一指接一指的攻向$n。\n\n"NOR;
	message_vision(msg, me, target);
	max = me->query_skill("canhe-zhi", 1)/60;
	extra = me->query_skill("canhe-zhi", 1)/3;	
	if ( me->query_skill_mapped("force") != "shenyuan-gong" ) extra += me->query_skill("canhe-zhi", 1)/2;	//2018.9.5阿飞改，不使用本门特内则减益
//	if ((string)weapon->query("id") == "xing yue") skill -= (int)me->query_skill("canhe-zhi", 1)/3;	 //2018.3.25阿飞改，拿特殊武器有加成	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	
	me->add_temp("apply/strength", -extra);
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);		
	if (max < 1) max = 1;
	if (me->query("jm/murong")) 
	{
		if (max > 150+(int)me->query_temp("lianzhao_max_add")*4) max = 150+(int)me->query_temp("lianzhao_max_add")*4;
	} else 
	{
		if (max > 50+(int)me->query_temp("lianzhao_max_add")*2) max = 50+(int)me->query_temp("lianzhao_max_add")*2;
	}

		me->add_temp("lianzhao", max);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
		for ( i=0; i<max; i++ )
		{
	        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		}
 
		me->add("neili",-max*200);
		me->add("jingli",-max*10);    
        me->add_temp("apply/strength", extra);
        me->add_temp("apply/attack", extra);
		me->add_temp("apply/damage", extra);
		me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记		
        me->start_busy(1);
        return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}