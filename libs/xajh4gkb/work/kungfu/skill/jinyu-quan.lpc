int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if ((int)me->query_skill("kumu-shengong",1) < 100)
		return notify_fail("你的枯木神功火候不够，无法练金玉拳。\n");
    if (me->query("family/family_name")!="大理段家")
		return notify_fail("你不是大理段家弟子，无法学习大理段家技能。\n");
	if (!me->query("jm/xiaoyao"))
		return notify_fail(CYN"大理段家唯有第十六代皇帝因获得逍遥派无上机缘，才最终将六脉贯通。\n"+CYN"这位"+RANK_D->query_respect(me)+CYN"是否应该先去逍遥派游历一番？\n"NOR);	
	if ((int)me->query("family_score")<7)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);			
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练金玉拳必须空手。\n");
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力太弱，无法练金玉拳。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	return 1;
}
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练金玉拳。\n");
    if (me->query("family/family_name")!="大理段家")
		return notify_fail("你不是大理段家弟子，偷学大理武功会被通缉。\n");
	if (!me->query("jm/xiaoyao"))
		return notify_fail(CYN"大理段家唯有第十六代皇帝因获得逍遥派无上机缘，才最终将六脉贯通。\n"+CYN"这位"+RANK_D->query_respect(me)+CYN"是否应该先去逍遥派游历一番？\n"NOR);	
	if ((int)me->query("family_score")<7)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	me->receive_damage("qi", 30);
	me->add("neili", -10);
	return 1;
}


mixed hit_ob(object me, object victim, int damage_bonus)
{
	int ap,dp,damage1,damage2,damage,liannum;
	ap = (int) me->query("con",1) * (int) me->query_skill("jinyu-quan",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = (int) victim->query("con",1) * (int) me->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	damage1 = (int) me->query_skill("jinyu-quan",1);  
	damage2 = (int)me->query_skill("jinyu-quan",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if (objectp(me->query_temp("weapon"))) return 0;
	if ( me->query_skill("kumu-shengong",1) < 100 || me->query_skill("jinyu-quan",1) < 100) return 0;
//	if ( me->query_skill_mapped("force") != "kumu-shengong") return 0;

	if (random(7) == 1 && random(ap) > dp/3 && me->query("jiali")>0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili", -100 );
		if (!victim->is_busy()) victim->start_busy(1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		message_vision(HIY"$N使出一招 「金玉其外，败絮其中」，$n以为这招中看不中用，结果$N虚则实之实则虚之，$n如中败絮！。\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，双拳连环击出，将$n击的后退数步。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/dali") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(2);
		message_vision(HIC "$N领悟大理段氏武功精髓，双拳金光闪闪，$n只觉得眼前一片星星！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}


string perform_action_file(string action)	
{
return __DIR__"jinyu-quan/" + action;	
}


