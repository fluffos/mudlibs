#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;

int valid_enable(string usage)
{
	return usage == "force";
}
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "juehu-shou"; }		//互备技能
string skill_pinji() {return "中乘";}				//品级区分：上乘、中乘、下乘
string skill_xingbie() {return "女性";}				//性别区分：男性、女性、无性、通用
string skill_zhengxie() {return "中立";}			//正邪区分：正道、邪道、中立
string skill_menpai() {return "峨嵋派";}				//门派区分：门派，江湖
string skill_yinyang() {return "中性";}				//阴阳区分：阳、阴、中性
string skill_zhenying() {return "正派";}			//阵营区分：正派、邪派、中立、通用
//int damage_damage() {return 60;}	//外伤系数
//int force_damage() {return 60;}		//内伤系数
int qi_heal() {return 65;}		//内功疗气系数
int jing_heal() {return 50;}		//内功疗精系数
int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
    mapping skl;	
    string *sname;	
    int i;	
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if ( (me->query("family/family_name") != "峨嵋派"))
        return notify_fail("你不是峨嵋弟子，怎能修习临济十二庄。\n");
    if ( me->query("gender") == "无性" )
        return notify_fail("你无根无性，阴阳不调，难以领会纯正、高深的佛门内功心法。\n");
	if ( me->query("gender") != "女性" )
		return notify_fail("临济十二庄只有女人能学！\n");
    if ((int)me->query_skill("force", 1) < 100)
        return notify_fail("你的基本内功火候还不够，无法领会临济十二庄。\n");
	if ((int)me->query("con",1) < 25)
		return notify_fail("你的根骨不够。\n");
	if ((int)me->query("per",1) < 25)
		return notify_fail("修行临济十二庄能驻颜，既然你天生嘴歪眼斜，又何必修炼呢。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	
	skl = this_player()->query_skills();	
	sname  = keys(skl);	
	for (i=0;i<sizeof(skl);i++){	
        if (sname[i]=="yijing-force") continue;	
        if (sname[i]=="linji-zhuang") continue;	
        if (sname[i]=="xixing-dafa") continue;			
        if( SKILL_D(sname[i])->valid_enable("force") )	
	         return notify_fail("你不先散了别派内功，怎能学临济十二庄？！\n");
	}
	return 1;
}

string exert_function_file(string func)
{
	return __DIR__"linji-zhuang/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage1,damage2,damage,liannum;
	damage1 = (int)me->query_skill("linji-zhuang",1);
	damage2 = (int)me->query_skill("linji-zhuang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	ap = me->query_skill("linji-zhuang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("linji-zhuang",1) < 100) return 0;
	if ( me->query_skill_mapped("force") != "linji-zhuang") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		message_vision(HIB "$N发挥出"+HIR+"临济十二庄"NOR HIB"的精髓，摧毁了$n的真元！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，真气走十二庄，过神桥，化天地，击碎了$n丹元。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/emei") )
	{
		damage = ((damage1+damage2)/2)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		me->add("eff_qi",damage);
		if (me->query("eff_qi")>me->query("max_qi")) me->set("eff_qi",me->query("max_qi"));
		me->add("qi",damage);
		if (me->query("qi")>me->query("eff_qi")) me->set("qi",me->query("eff_qi"));
		message_vision(HIM"$N贯通峨嵋派内功精髓，引天地二气入体，受到的伤势恢复了不少。\n" NOR, me,victim);
		return ;
	}

}

