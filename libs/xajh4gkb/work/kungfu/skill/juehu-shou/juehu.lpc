// juehu.c 三阴绝户手「绝户」perform
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int damage, ap, dp;
  string msg;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("神功伤敌只能对战斗中的对手使用。\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能使用「绝户」神功！\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if ((int)me->query_skill("juehu-shou", 1) < 500)
    return notify_fail("你的虎爪绝户手不够娴熟，不会使用「绝户」神功\n");
  if ((int)me->query_skill("yinyun-ziqi", 1) < 500)
    return notify_fail("你的氤氲紫气不够高，不能用「绝户」神功伤敌。\n");
  //	if ( !wizardp(me) && me->query_skill_mapped("force") != "yinyun-ziqi")
  //		return notify_fail(HIC"不使用氤氲紫气，不能使用绝户手!\n"NOR);			
  if ((int)me->query("neili") < 1000)
    return notify_fail("你现在内力太弱，不能使出「绝户」招式。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够！\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为太差！\n");
  if ((int)me->query("max_jingli") < 100000)
    return notify_fail("你的精力修为太差！\n");
  if ((int)me->query_condition("libie"))
    return notify_fail("你元气大伤，现在没有能力使出「绝户」招式。\n");
  //	if (me->query_skill_mapped("unarmed") != "juehu-shou")
  //		return notify_fail("你没正确激发该技能 。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  msg = BLU "$N默运神功，脸色白得吓人，突然使出虎爪绝户手的最后一击「绝户」，企图当场把$n废于掌下。\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1		
  damage = (int)me->query_skill("juehu-shou", 1) * 5 + me->query_skill("force");
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "juehu-shou",
    1
  ) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  if (random(ap) > dp / 3) {
    if (target->query("gender") == "男性") {
      damage = damage / 2 + random(damage / 2);
      damage = damage * (100 - target->query_meridian()) / 100;
      target->receive_damage("jing", damage, me);
      target->receive_wound("jing", damage / 2, me);
      me->add("neili", -300);
      me->add("jingli", -300);
      msg = RED "结果$N一击命中，$n只感到下体一阵刺痛，体内精元不断外泄，顿时觉的四肢无力，两腿不停颤抖。\n" NOR;
      message_vision(msg, me, target, damage, HBWHT + HIM "精神伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);			
      target->apply_condition("libie", (int)target->query("age") + 1);
      me->apply_condition("yyz_damage", (int)me->query("age") + 1);
      target->set("gender", "无性");
      target->set("genderbak", "男性");
      if (target->query("max_jingli") > 100) target->add("max_jingli", -(10 + random(20)));
      if (me->query("max_jingli") > 100) me->add("max_jingli", -(10 + random(20)));
      message_vision(HIW "$n突然觉的丹田内的精元已流失迨尽，心里一阵难过，知道自己有一段时间不能行欢做乐了!\n" NOR, me, target);
    } else if (target->query("gender") == "女性") {
      me->add("neili", -1000);
      me->add("jingli", -(int)me->query("jingli"));
      message_vision(HIW "$n被你一击命中，不禁既羞又怒，竟对一女流之辈也用此阴毒招数！\n" NOR, me, target);
    } else {
      damage = damage / 4 + random(damage / 4);
      damage = damage * (100 - target->query_meridian()) / 100;
      target->receive_damage("jing", damage, me);
      target->receive_wound("jing", damage / 3, me);
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己精神的外伤为"+ damage/2 +"，内伤为"+ damage/4 +"。\n" NOR);	
      message_vision(
        HIW "$N虽然击中$n的要害，但感觉受力甚轻，似乎已无要害可言!\n" NOR,
        me,
        target,
        damage,
        HBWHT + HIM "精神伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法
    }
    if (!target->is_killing(me)) target->kill_ob(me);
    if (!me->is_killing(target)) me->kill_ob(target);
  } else {
    me->add("neili", -1000);
    me->add("jingli", -(int)me->query("jingli") / 2);
    msg = CYN "可是$p看破了$P的狠毒企图，向旁跳开数步，躲开了$P的凌厉一击！\n" NOR;
    message_vision(msg, me, target);
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
