int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query("family/family_name")!="明教")
		return notify_fail("不加入明教恐怕不能传授这门轻功。\n");	
	if (!me->query("jm/shashou"))
		return notify_fail(CYN"我明教替朱家打的天下，到头来飞鸟尽、良弓藏！这朱洪武视我明教如洪水猛兽，居然成立杀手楼来暗杀我教高手！\n"CYN"这位"+RANK_D->query_respect(me)+CYN"欲扬我明教威名，需得查明杀手楼的秘密！\n"NOR);
	if ((int)me->query("family_score")<7)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
    if ((int)me->query_skill("shenghuo-shengong", 1) < 100)
		return notify_fail("你的圣火神功不够，学不了本教技能。\n");	
    if (me->query_skill("dodge", 1) <=me->query_skill("qingyunwu", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
    return 1;
}

string query_dodge_msg(string limb)
{
	object me, ob;
	mapping action;

	me = this_player();
	action = query_action(me, ob);

	return action["action"];
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query("family/family_name")!="明教")
		return notify_fail("不加入明教恐怕不能练习这门轻功。\n");
	if (!me->query("jm/shashou"))
		return notify_fail(CYN"我明教替朱家打的天下，到头来飞鸟尽、良弓藏！这朱洪武视我明教如洪水猛兽，居然成立杀手楼来暗杀我教高手！\n"CYN"这位"+RANK_D->query_respect(me)+CYN"欲扬我明教威名，需得查明杀手楼的秘密！\n"NOR);
	if ((int)me->query("family_score")<7)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if( (int)me->query("qi") < 45 )
		return notify_fail("你的体力太差了，不能青云舞。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");		
	me->receive_damage("qi", 35);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"qingyunwu/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;

	ap = me->query_skill("qingfu-shenfa", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("sword",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("qingfu-shenfa", 1);
	damage2 = me->query_skill("qingfu-shenfa", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if ((me->query_skill("shenghuo-shengong",1) < 300 && me->query_skill("jiuyang-shengong",1) < 300) || me->query_skill("qingfu-shenfa", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="shenghuo-shengong" && me->query_skill_mapped("force")!="jiuyang-shengong") return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIB"$N踏青云而直上，若流风之回雪，飘飘乎不沾染红尘。\n"NOR;
		if (!ob->is_busy()) ob->start_busy(1);
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，身化青云直上，指点江山，激扬文字，一股清气满乾坤。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/mingjiao") )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );
		if (!ob->is_busy()) ob->start_busy(1);
		message_vision(HIB"$N融汇明教武学精髓，随风化作青云，转瞬及至，携风雷之疾，将$n击飞！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
}

