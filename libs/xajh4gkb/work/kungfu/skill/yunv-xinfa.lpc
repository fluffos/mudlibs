// yunv-xinfa.c 玉女心法
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;

int valid_enable(string usage) {
  return usage == "force";
}
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "juehu-shou"; }		//互备技能
string skill_pinji() { return "下乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "中立"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "古墓派"; }    //门派区分：门派，江湖
string skill_yinyang() { return "阴"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "正派"; }   //阵营区分：正派、邪派、中立、通用
//int damage_damage() {return 60;}	//外伤系数
//int force_damage() {return 60;}		//内伤系数
int qi_heal() { return 55; }  //内功疗气系数
int jing_heal() { return 45; }  //内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  mapping skl;
  string *sname;
  int i;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("gender") == "无性")
    return notify_fail("你无根无性，阴阳难调，不能修习玉女心法。\n");
  if ((int)me->query_skill("force", 1) < 100)
    return notify_fail("你的基本内功火候还不够。\n");
  if (me->query("family/family_name") != "古墓派")
    return notify_fail("你不是古墓派弟子，无法学习玉女心法。\n");
  if ((int)me->query_skill("force", 1) <= (int)me->query_skill("yunv-xinfa", 1))
    return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
  if (!me->query("jm/quanzhen"))
    return notify_fail(CYN "我古墓派祖师与全真教重阳真人恩怨纠葛，可惜最终未能修成正果。我古墓弟子都得先去全真门下修行一段时间方可入门。\n" NOR);
  if ((int)me->query("family_score") < 6)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");

  skl = this_player()->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "yijing-force") continue;
    if (sname[i] == "yunv-xinfa") continue;
    if (sname[i] == "yunv-xinjing") continue;
    if (sname[i] == "xixing-dafa") continue;
    if (SKILL_D(sname[i])->valid_enable("force"))
      return notify_fail("你不先散了别派内功，怎能学玉女心法？！\n");
  }
  return 1;
}

int practice_skill(object me) {
  return notify_fail("玉女心法只能用学(learn)来增加熟练度。\n");
}

string exert_function_file(string func) {
  return __DIR__ "yunv-xinfa/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int ap, dp, damage1, damage2, damage, liannum;

  ap = me->query_skill(
    "yunv-xinfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "force",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("yunv-xinfa", 1);
  damage2 = (int)me->query_skill(
    "yunv-xinfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("yunv-xinfa", 1) < 100) return 0;
  if (me->query_skill_mapped("force") != "yunv-xinfa") return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIB "$N发挥出" + HIR + "玉女心法" NOR HIB "的精髓，摧毁了$n的真元！！！！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，心若冰清，身如玉女，一道阴柔的内劲摧毁了$n精气神。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/gumu")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIM "$N融汇古墓派武功精髓，默运玉女玄功，一道柔劲摧毁了$n真元。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}


mapping exercise_msg(object me) {
  return ([
    "status_msg": "姿态悠雅，神态清冷。\n",
    "start_my_msg": "轻轻的吸一口气，闭上眼睛，运起玉女心法，内息在脉络中开始运转。\n",
    "start_other_msg": me->name() + "神态突然开始变的清冷无比，可是姿势又变的悠雅异常。\n",
    "heal_my_msg": "轻轻的吸一口气，闭上眼睛，运起玉女心法，内息运转于脉络之中，开始调理内伤。\n",
    "heal_other_msg": me->name() + "神态突然开始变的清冷无比，可是姿势又显得悠雅异常，犹似一朵白莲花盛开。\n",
    "halt_msg": "内息一转，迅速收气，停止了内息的运转。\n",
    "end_my_msg": "慢慢收气，归入丹田，睁开眼睛，轻轻的吐了一口气。\n",
    "end_other_msg": "只见" + me->name() + "睁开眼睛，轻轻的吐出了一口气，神态恢复自然。\n",
    "hover_my_msg": "将玉女心法运转完毕，收功站起，身轻如燕。\n",
    "hover_other_msg": me->name() + "指拈如意，轻轻地吐了口气，收功站起，姿态优雅。\n",
  ]);
}
