int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me) 
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query("family/family_name")!="杀手楼")
		return notify_fail("你不是本门中人，无法领悟本门技能的精髓。\n");
	if ((int)me->query_skill("wuji-shengong", 1) < 100)
		return notify_fail("你的无极神功火候不够，学习不归步法会走上不归路。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query("family/family_name")!="杀手楼")
		return notify_fail("你想死吗！居然敢偷练杀手楼武功。\n");	
	if( (int)me->query("qi") < 30 )
	    return notify_fail("你的体力太差了，不能练不归步法。\n");
	if (me->query_skill("bugui-bufa", 1) < 30)
		 return notify_fail("你的不归步法太低了，无法自行练习。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 10);
	me->receive_damage("qi", 20);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"bugui-bufa/" + action;
}

	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage)
{
	int j,ap,dp,damage1,damage2;
	ap = me->query_skill("bugui-bufa", 1) * me->query("int",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("dodge", 1) * ob->query("dex",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = (int)me->query_skill("bugui-bufa",1);
	damage2 = (int)me->query_skill("bugui-bufa",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if (damage <10) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("wuji-shengong",1) < 300 || me->query_skill("bugui-bufa", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="wuji-shengong" ) return damage;	

	if ( random(ap) > dp/4 && random(8)==1)
	{
		j = -(damage+random(damage)); 
		me->add("neili", -100 );
		ob->add("neili", -(me->query("jiali") +1000) );
		if (!ob->is_busy()) ob->start_busy(2);
        message_vision(HIG"一入杀手楼，天涯不归路。不归路望归人，何处不断肠！\n"NOR, me, ob);		
		return j;        
	}  
	if ( random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage+random(damage)); 
		me->add("jingli", -100 );
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);		
        message_vision(HIG"$N一步踏出，"+me->query("cognize")+HIG"爆发，见血不归！\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;        
	}
	if ( random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/shashou"))
	{
		j = -(damage+random(damage)); 
		me->add("neili", -100 );
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
        message_vision(HIG"$N贯通杀手楼武功之精髓，身之所在，$n之不归处！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;        
	}	
}
