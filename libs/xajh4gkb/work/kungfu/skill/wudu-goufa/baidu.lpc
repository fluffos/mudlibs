// baidu.c 百毒缠身

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra,ap,dp,i,attack_time;
	object weapon,weapon2;
	
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("五毒钩法只能对战斗中的对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
//	if ( me->query_skill_mapped("sword") != "wudu-goufa")
//         return notify_fail("你必须激发五毒钩法才能使用「百毒缠身」！\n");  
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	 
	if( (int)me->query_skill("wudu-shengong", 1) < 500 )
		return notify_fail("你的五毒神功不够熟练！\n");	 
    if( (int)me->query_skill("wudu-goufa", 1) < 500 )      	
		return notify_fail("你的五毒钩法不够娴熟，不能用「百毒缠身」。\n");
//	if ( !wizardp(me) && me->query_skill_mapped("force") != "wudu-shengong")
//		return notify_fail("不使用本门内功，如何使用本门绝学!\n");		
	if ((int)me->query("max_neili") < 200000)								
		return notify_fail("你的内力修为不够。\n");
	if ((int)me->query("max_jingli") < 10000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");		
    if( (int)me->query("neili") < (int)me->query_skill("wudu-goufa", 1)*4 )
        return notify_fail("你的真气不够。\n");
 	if( me->is_busy() )
		return notify_fail("你现在正忙着呢，哪有空运功？\n");  
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	ap = me->query("xyzx_sys/level") + me->query_skill("wudu-goufa", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	extra = me->query_skill("wudu-goufa",1)/15; 
	if ( me->query_skill_mapped("force") != "wudu-shengong") extra -= (int)me->query_skill("wudu-goufa", 1)/18;	//2018.9.5阿飞改，不使用本门特内则减益
	if ((string)weapon->query("id") == "jinfeng gou") extra += (int)me->query_skill("wudu-goufa", 1)/15;	 //2018.3.25阿飞改，拿特殊武器有加成	
	msg = HIR  "$N不知道从哪里掏出来一堆毒虫，手中的"+ weapon->name() +" 一挑，一只毒虫附着在剑上，闪电般的冲向$n！" NOR;
    message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	attack_time = me->query_skill("wudu-goufa",1)/600;
	if(attack_time<1) attack_time=1;
	if (me->query("jm/wudu"))
	{
		if(attack_time>100+(int)me->query_temp("lianzhao_max_add")*4) attack_time=100+(int)me->query_temp("lianzhao_max_add")*4;
	} else 
	{
		if(attack_time>50+(int)me->query_temp("lianzhao_max_add")*2) attack_time=50+(int)me->query_temp("lianzhao_max_add")*2;
	}	
	
//		me->add_temp("lianzhao", attack_time);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害
	me->add_temp("apply/attack", extra);	
	me->add_temp("apply/strength", extra);
	me->add_temp("apply/damage", extra); 	
	for(i=0;i < attack_time;i++)
	{
	msg = HIY "$N剑光连闪，毒虫一只接一只的扑来！\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
	}
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/strength", -extra);
	me->add_temp("apply/damage", -extra); 
//	me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记
	me->add("neili", -(100*attack_time));

if (objectp(weapon2 = target->query_temp("weapon")))	
{
	message_vision(HIR "\n$N虚晃一招，手中"+ weapon->query("name")+"忽的一沉，钩尖已搭在$n的"+ weapon2->query("name")+HIR"上！\n" NOR,me,target);
	if(random(ap) > dp/3)
	{
		msg = HIR "只见$N顺势一绞，低喝一声：“撒手！”$n只觉得虎口一阵巨痛，\n手中"+weapon->query("name")+HIR"当啷一声掉在地上！\n" NOR;
		message_vision(msg,me,target);
		weapon2->unequip();
		weapon2->move(environment(me));
		
		msg = "$N哈哈一笑，得理不饶人，招招进逼！\n" NOR;
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
		msg = "$N哈哈一笑，得理不饶人，再进一招！\n" NOR;
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
		msg = "$N哈哈一笑，得理不饶人，最后一招！\n" NOR;
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
		me->add("jingli", -500);

	} else
	{
		msg = HIY "可是$n早有准备，急忙收招跳开！\n" NOR;
		message_vision(msg, me,target);
	}	
}	
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}