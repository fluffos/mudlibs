int valid_learn(object me) {
  object weapon;
  int lvl = (int)me->query_skill("chixin-bianfa", 1);
  int t = 1, j;
  if (lvl <= 100)
    for (j = 1; j < lvl / 10; j++)
      t *= 2;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");						
  if (me->query("gender") != "女性")
    return notify_fail("你又不是女人练什么痴心鞭法？\n");
  if (me->query("family/family_name") != "痴心妄想门")
    return notify_fail("非本门亲传弟子无法学习。\n");
  if ((int)me->query("int", 1) < 25)
    return notify_fail("我痴心门的女子俱是聪慧之人，你的资质不行。\n");
  if ((int)me->query("dex", 1) < 25)
    return notify_fail("我派轻功对身法的要求较高，你看起来笨手笨脚的。\n");
  if ((int)me->query_skill("wangran-xinfa", 1) < 100)
    return notify_fail("你的本门内功不够，无法学习痴心鞭法。\n");
  if (lvl <= 100) {
    if (lvl > 10 && (int)me->query("shen") < t * 100)
      return notify_fail("你的侠义正气太低了。\n");
  } else {
    if ((int)me->query("shen") < (51200 + (lvl - 100) * 1000))
      return notify_fail("你的侠义正气太低了。\n");
  }
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不足，没有办法练痴心鞭法, 多练些内力再来吧。\n");
  if ((int)me->query_skill("whip", 1) < 100)
    return notify_fail("你的基本鞭法火候太浅。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "whip")
    return notify_fail("你必须先找一条鞭子才能练鞭法。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}


string query_skill_name(int level) {
  int i;
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"])
      return action[i - 1]["skill_name"];
}

int practice_skill(object me) {
  int skill;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "痴心妄想门")
    return notify_fail("非本门亲传弟子无法练习其精要。\n");
  if (me->query("gender") != "女性")
    return notify_fail("你又不是女人练什么痴心鞭法？\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 50)
    return notify_fail("你的内力不够练痴心鞭法！\n");
  if (skill > 100 && me->query("shen") < 1)
    return notify_fail("这种武功当得行侠义事。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("qi", 40);
  me->add("neili", -30);
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon1, weapon2;
  ap = me->query(
    "str",
    1
  ) * me->query_skill(
    "chixin-bianfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query(
    "dex",
    1
  ) * victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("chixin-bianfa", 1);
  damage2 = (int)me->query_skill(
    "chixin-bianfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "wangran-xinfa",
    1
  ) < 100 || me->query_skill("chixin-bianfa", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "wangran-xinfa") return 0;	
  if (!objectp(weapon1 = me->query_temp("weapon")) || (string)weapon1->query("skill_type") != "whip") return 0;

  if (random(ap) > dp / 3 && random(7) == 0 && objectp(weapon2 = victim->query_temp("weapon"))) {
    weapon2->unequip();
    weapon2->move(me);
    victim->apply_condition("no_equip", 20);
    return WHT "$N挥舞手中" + weapon1->name() + WHT "卷向$n, " WHT "$n顿时觉得眼前一花，手腕一麻，" + weapon2->name() + WHT "脱手而出！\n" NOR;
  }
  if (random(ap) > dp / 3 && random(7) == 1 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIR "只听到「" HIY "" BLINK "嗤啦" NOR "" HIR "」一声轻响，$w" HIR "竟然陷入皮肉！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(2);
    message_vision(
      HIC "$N挥舞手中" + weapon1->name() + HIC "，招式挥洒的镜花水月般，" + me->query("cognize") + HIC "的力量如情丝搬卷向$n。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/chixin")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIG "$N灵机一动，将痴心门武功精髓融入" + weapon1->name() + HIC "中，隐隐有流光闪烁。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}

mapping query_action(object me, object target, object weapon) {
  if (random(me->query_skill(
    "chixin-bianfa",
    1
  )) > 399 && me->query("neili") > 300 && random(7) == 0) {
    me->add("neili", -150);
    return ([
      "action": "" HIG "忽然$N顿悟灵机，把痴心鞭法使得如行云流水，手中$w" HIG "如银蛇乱舞\n"
      "$n" HIG "只见眼前一片昏暗，顿时心神大乱，只觉得鞭影铺天盖地的向自己缠来。\n" NOR "",
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
      "damage_type": "缠伤" ]);
  }

  return action[random(sizeof(action))];
}

string perform_action_file(string action) {
  return __DIR__ "chixin-bianfa/" + action;
}
