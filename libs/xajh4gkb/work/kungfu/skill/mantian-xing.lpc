int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query("family/family_name")!="梅庄")
		return notify_fail("你不加入本门，无法学习本门技能。\n");	
    if (me->query_skill("wuzheng-xinfa",1)<100)
        return notify_fail("你的本门内功基础不够。\n");		
    if ((int)me->query_skill("throwing", 1) < 200)
		return notify_fail("你的基本暗器火候不够，无法学满天星。\n");
    if ((int)me->query_skill("dodge", 1) < 200)
		return notify_fail("你的轻功火候不够，无法领悟满天星。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
    return 1;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
    if(level >= action[i]["lvl"])
		return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing")
		return notify_fail("你使用的武器不对。\n");
 	if (me->query("family/family_name")!="梅庄")
		return notify_fail("你不加入本门，无法学习本门技能。\n");	
    if (me->query_skill("wuzheng-xinfa",1)<100)
        return notify_fail("你的本门内功基础不够。\n");	  
    if ((int)me->query("qi") < 30)
		return notify_fail("你的体力太低了。\n");
    if ((int)me->query("neili") < 30)
		return notify_fail("你的内力不够练满天星。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
    me->receive_damage("qi", 30);
	return 1;
}

string perform_action_file(string action)
{
    return __DIR__"mantian-xing/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;
	object weapon;
	weapon = me->query_temp("weapon");
    ap = me->query_skill("mantian-xing",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("mantian-xing",1);
	damage2 = (int)me->query_skill("mantian-xing",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("wuzheng-xinfa",1) < 100 || me->query_skill("mantian-xing",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "wuzheng-xinfa") return 0;
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		message_vision(HIR "$N突然掏出黑、白两枚棋子，一前一后弹出！$n挡开了第一个，但挡不住第二个。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，手中" + weapon->name() + HIG "激射，$n只觉数点寒星扑面而来。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/meizhuang") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		victim->apply_condition("anqi_poison", random(7) + 1 + victim->query_condition("anqi_poison"));
		message_vision(HIM"$N洞悉梅庄武学之谜，随手一挥，黑白两道光芒一闪而过，$n一声大叫，身上已是破了两个洞。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

