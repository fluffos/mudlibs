int valid_learn(object me) {
  object ob;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 5000)
    return notify_fail("你的内力不够，没有办法练华山剑法。\n");
  if ((int)me->query("con", 1) < 25)
    return notify_fail("气宗剑法讲究以气御剑，以你这根骨恐怕不行。\n");
  if ((int)me->query_skill("zixia-shengong", 1) < 100)
    return notify_fail("你的紫霞神功火候不够，无法学习本门身法。\n");
  if (me->query("family/family_name") != "华山派")
    return notify_fail("你未加入华山派，学不了本派技能。\n");
  if (!objectp(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}
//2019-1-1阿飞新规划，技能代码完善
string valid_combine() { return "kuangfeng-jian"; }  //互备技能
string skill_pinji() { return "下乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "中立"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "华山派"; }    //门派区分：门派，江湖
string skill_yinyang() { return "中性"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "正派"; }   //阵营区分：正派、邪派、中立、通用
int damage_damage() { return 42; }  //外伤系数
int force_damage() { return 47; }  //内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon")) || (string)weapon->query("skill_type") != "sword")
      return notify_fail("你使用的武器不对。\n");
  if (me->query("family/family_name") != "华山派")
    return notify_fail("你未加入华山派，练不了本派技能。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练华山剑法。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "huashan-jianfa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon;
  weapon = me->query_temp("weapon");
  ap = me->query_skill(
    "huashan-jianfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("huashan-jianfa", 1);
  damage2 = (int)me->query_skill(
    "huashan-jianfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "zixia-shengong",
    1
  ) < 100 || me->query_skill("huashan-jianfa", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "zixia-shengong") return 0;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIR "$N" HIR "运起紫霞神功，一剑攻出，剑气横飞，$n双眼一花，不知如何是好！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，剑随意走，手中" + weapon->name() + HIG "犹如生了眼睛一般，随意挥出几剑，$n双眼一花，不知如何是好。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/huashan")) {
    me->add("neili", -100);
    COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), 1);
    COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), 1);
    message_vision(HIM "$N洞悉华山派武学精髓，使出华山派绝技「剑掌双绝」，连出两招！\n" NOR, me, victim);
    return;
  }
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int ap, dp, j, damage1, damage2;
  object weapon;
  weapon = me->query_temp("weapon");
  ap = me->query_skill(
    "huashan-jianfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "sword",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = me->query_skill("huashan-jianfa", 1);
  damage2 = me->query_skill(
    "huashan-jianfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return damage;
  if (me->query_skill(
    "zixia-shengong",
    1
  ) < 300 || me->query_skill("huashan-jianfa", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force")!="zixia-shengong" ) return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = YEL "$N机缘巧合，获得华山思过崖石洞中的失传已久的剑招，剑走偏锋，一招击中$n的破绽。$n真气运行淤塞，出手顿时一滞，力道减轻了不少！\n" NOR;
    if (!ob->is_busy()) ob->start_busy(1);
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(msg, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N顿悟" + me->query("cognize") + HIY "，依据华山之险避开了$n这一招，趁势攻入$n间隙。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/huashan")) {
    j = -(damage / 3 + random(damage / 3));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    message_vision(
      HIB "$N明悟华山武学精髓，剑招加快，在$n下一招未出将出时，反击一剑！\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
}
