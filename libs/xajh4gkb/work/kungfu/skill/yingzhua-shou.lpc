int valid_enable(string usage) { return usage == "hand" || usage == "unarmed" || usage == "parry"; }
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "fengyun-shou"; }		//互备技能
string skill_pinji() { return "中乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "中立"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "明教"; }    //门派区分：门派，江湖
string skill_yinyang() { return "中性"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "邪派"; }   //阵营区分：正派、邪派、中立、通用
int damage_damage() { return 72; }  //外伤系数
int force_damage() { return 40; }  //内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练鹰手必须空手。\n");
  if (me->query("family/family_name") != "明教")
    return notify_fail("你不是明教弟子，学不了鹰王的独门绝技。\n");
  if (!me->query("jm/shashou"))
    return notify_fail(CYN "我明教替朱家打的天下，到头来飞鸟尽、良弓藏！这朱洪武视我明教如洪水猛兽，居然成立杀手楼来暗杀我教高手！\n" CYN "这位" + RANK_D->query_respect(me) + CYN "欲扬我明教威名，需得查明杀手楼的秘密！\n" NOR);
  if ((int)me->query("family_score") < 7)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if ((int)me->query_skill("unarmed", 1) < 200)
    return notify_fail("你的基本功太差劲了，无法学鹰爪手。\n");
  if ((int)me->query_skill("shenghuo-shengong", 1) < 100)
    return notify_fail("你的圣火神功还不到家，无法学鹰爪手。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练鹰爪手。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "明教")
    return notify_fail("你不是明教弟子，练习不了鹰抓手。\n");
  if (!me->query("jm/shashou"))
    return notify_fail(CYN "我明教替朱家打的天下，到头来飞鸟尽、良弓藏！这朱洪武视我明教如洪水猛兽，居然成立杀手楼来暗杀我教高手！\n" CYN "这位" + RANK_D->query_respect(me) + CYN "欲扬我明教威名，需得查明杀手楼的秘密！\n" NOR);
  if ((int)me->query("family_score") < 7)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练鹰爪手。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yingzhua-shou/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;

  ap = me->query_skill(
    "yingzhua-shou",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("yingzhua-shou", 1);
  damage2 = (int)me->query_skill(
    "yingzhua-shou",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if ((me->query_skill(
    "shenghuo-shengong",
    1
  ) < 100 && me->query_skill(
    "jiuyang-shengong",
    1
  ) < 100) || me->query_skill("yingzhua-shou", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "shenghuo-shengong" && me->query_skill_mapped("force") != "jiuyang-shengong") return 0;
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIY "$N双爪连环抓向$n的背心，咔嚓一声，$n被抓了一个血洞。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，五指如钩，身形跃起，只听“刺啦”一声，$n前胸被抓出一道血痕。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/mingjiao")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIM "$N融会明教武学精髓，手臂突然暴长，扣住$n肩关节，一扭，“咔嚓”一声，$n左臂鲜血淋淋。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
