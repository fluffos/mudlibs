// feng.c 风起云涌

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;

int perform(object me, object target) {
  mixed combat_msg;
  string msg;
  object weapon;
  int i, att, extra;
  int ap, dp;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("你不在战斗中！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "spear")
    return notify_fail("你手中无枪，如何使得出风起云涌？\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (me->query_skill("zhenfeng-xinfa", 1) < 300)
    return notify_fail("你的内功火候未到，无法驾驭风起云涌！\n");
  if (me->query_skill("spear", 1) < 500)
    return notify_fail("你基本枪法修为不够，无法施展风起云涌！\n");
  if ((int)me->query_skill("zhenfeng-qiangfa", 1) < 300)
    return notify_fail("你震风枪法修为不够，无法施展风起云涌！\n");
  //	if( me->query_skill_mapped("force") != "zhenfeng-xinfa")
  //		return notify_fail("你所用的内功与风起云涌气路相悖！\n");
  //	if (me->query_skill_mapped("spear") != "zhenfeng-qiangfa")
  //		return notify_fail("你没正确激发该技能 。\n");
  if (me->query("neili") <= (int)me->query_skill("zhenfeng-qiangfa", 1) * 4)
    return notify_fail("你的内力不够使用风起云涌！\n");
  if (me->query("jingli") <= (int)me->query_skill("zhenfeng-qiangfa", 1) * 4)
    return notify_fail("你的精神太差，无法使用风起云涌！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  combat_msg = me->query("env/no_combat_msg");
  if (!intp(combat_msg)) combat_msg = 1;
  msg = HIR "大风起兮云飞扬！$N枪随云动，卷起长风，顿时风云四起！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "zhenfeng-qiangfa",
    1
  ) + me->query_skill("spear") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  extra = (int)me->query_skill("zhenfeng-qiangfa", 1) / 15;
  if (me->query_skill_mapped("force") != "zhenfeng-xinfa") extra -= (int)me->query_skill(
    "zhenfeng-qiangfa",
    1
  ) / 18;  //2018.9.5阿飞改，不使用本门特内则减益
  if ((string)weapon->query("id") == "zhenfeng qiang") extra += (int)me->query_skill(
    "zhenfeng-qiangfa",
    1
  ) / 15;  //2018.3.25阿飞改，拿特殊武器有加成	
  att = (int)me->query_skill("zhenfeng-qiangfa", 1) / 60;
  if (att < 1) att = 1;
  if (me->query("jm/shengjian")) {
    if (att > 100 + (int)me->query_temp("lianzhao_max_add") * 4) att = 100 + (int)me->query_temp("lianzhao_max_add") * 4;
  } else {
    if (att > 50 + (int)me->query_temp("lianzhao_max_add") * 2) att = 50 + (int)me->query_temp("lianzhao_max_add") * 2;
  }

  if (random(ap) > dp / 4) {
    me->add_temp("lianzhao", att);  //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害 
    me->add_temp("apply/attack", extra);
    me->add_temp("apply/damage", extra);
    me->add_temp("apply/strength", extra);
    for (i = 0; i < att; i++) {
      if (combat_msg < 4) {
        msg = HIR "划然长啸，草木震动，山鸣谷应，风起云涌。\n" NOR;
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
      } else
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    }
    me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记	
    me->add_temp("apply/attack", -extra);
    me->add_temp("apply/damage", -extra);
    me->add_temp("apply/strength", -extra);
    me->add("neili", -100 * att);
    me->add("jingli", -100 * att);
  } else {
    message_vision(RED "可是$n身如泰山，$N的剑招无力撼动。\n" NOR, me, target);
    me->add("neili", -100);
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
