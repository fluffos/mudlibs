#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	int damage,ap,dp,extra;
	string msg,wn;
	object weapon;

	if (!target ) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「柔情媚影」只能对战斗中的对手使用。\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail(RED"开什么玩笑，没装备剑就想使「柔情媚影」？\n"NOR);
    if(me->is_busy())
        return notify_fail("你现在正忙着！\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if ((int)me->query_skill("yifeng-jian", 1) < 1000 )
		return notify_fail(WHT"你的移风剑法不够娴熟，还使不出「柔情媚影」。\n"NOR);
	if ((int)me->query_skill("mingyu-shengong", 1) < 1000 )
		return notify_fail(WHT"你的冥雨神功不够娴熟，还使不出「柔情媚影」。\n"NOR);
	if ((int)me->query_skill("yihua-jiemu", 1) < 1000 )
		return notify_fail(WHT"你的移花接木不够娴熟，还使不出「柔情媚影」。\n"NOR);	
	if ((int)me->query_skill("sword", 1) < 1000 )
		return notify_fail(WHT"你的剑法基础不够，还妄想使出「柔情媚影」？\n"NOR);
	if ((int)me->query_skill("force", 1) < 1000 )
		return notify_fail(RED"你的内功基础不够，耍不出「柔情媚影」。\n"NOR);
	if ((int)me->query_skill("dodge", 1) < 1000 )
		return notify_fail(RED"你的轻功基础不够，领悟不到「柔情媚影」。\n"NOR);
	if ((int)me->query("max_neili")<300000)
		return notify_fail(RED"你的内力修为不足，无法发挥「柔情媚影」的威力。\n"NOR);
	if ((int)me->query("neili")<10000)	
		return notify_fail(HIC"你现在内力不够，没能将「柔情媚影」使完！\n"NOR);
	if ((int)me->query("max_jingli")<300000)
		return notify_fail(RED"你的精力修为不足，无法发挥「柔情媚影」的威力。\n"NOR);
	if ((int)me->query("jingli")<10000)	
		return notify_fail(HIC"你现在精力不够，没能将「柔情媚影」使完！\n"NOR);
	 if ( me->query_skill_mapped("force") != "mingyu-shengong")
        return notify_fail("你必须激发冥雨神功才能使用「柔情媚影」！\n"); 	
	if (me->query_skill_mapped("sword") != "yifeng-jian")
		return notify_fail("你必须使用移风剑法。\n");
	if (me->query_skill_mapped("dodge") != "yihua-jiemu" && me->query_skill_mapped("parry") != "yihua-jiemu")
		return notify_fail("你必须使用移花接木。\n");
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用[" HIR "柔情媚影" NOR "]\n"NOR); 
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	message_vision(HBWHT "$N贯通移花宫武学，使出了移花宫的绝学之精髓！\n" NOR, me, target);	 
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1	 
	wn = weapon->name();
	ap = me->query("xyzx_sys/level") + me->query_skill("yifeng-jian", 1)+me->query_skill("yihua-jiemu",1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	extra = me->query_skill("yifeng-jian", 1)/10+me->query_skill("yihua-jiemu",1)/10;
	msg = HIC "\n$N" HIC "陡然间姿态万千，身法飘逸，犹如一个婀娜"
	      "多姿的女子在随歌漫舞一样。\n但是$N手中" + wn + HIC "却"
	      "跟随着身体轻盈地晃动，看似毫无章法，却又像是隐藏着厉"
	      "害的招式。\n" NOR;
	message_vision(msg, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
	if (random(ap)>dp/3)
	{		
		//if (!target->is_busy()) target->start_busy(random(3));
		damage = (int)me->query_skill("yifeng-jian",1)+(int)me->query_skill("mingyu-shengong",1)*2;
		damage = damage/3 + random(damage/3);
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		me->add("neili", -1000);
		me->add("jingli", -1000);
		msg = HIY"$n看到$N这一剑妙到毫巅，全然无法抵挡，一愣神之间已经被这一剑刺得鲜血飞溅！\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		msg = CYN "可是$n" CYN "看出了$N" CYN "这招乃虚招，顿时一丝不乱，镇定自若。\n" NOR;
		message_vision(msg, me, target);
		me->add("neili", -500);
	}
		
if (me->query_skill("yifeng-jian",1)>2000 && me->query_skill("yihua-jiemu",1)>2000)
{	
    message_vision(WHT"〖"HIY"琼楼玉宇"WHT"〗\n\n"HIG"只见$N分光劲势再抖，像蛟龙出海，大鹏展翅，先是一团光芒，光芒蓦然爆开，化作一片光雨，漫天遍地向$n刺来！\n" NOR, me, target);
	msg = HIM "$N" HIM "将内力全灌入剑身，呼的一剑，当头直劈。\n" NOR;
	message_vision(msg, me, target);
	me->add_temp("apply/attack",extra);
	me->add_temp("apply/damage",extra);	
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
	me->add_temp("apply/attack",-extra);
	me->add_temp("apply/damage",-extra);	
	damage = (int)me->query_skill("yifeng-jian",1)*2+(int)me->query_skill("yihua-jiemu",1)*2+(int)me->query_skill("mingyu-shengong",1)*2;
	damage = damage/3 + random(damage/3);
	damage = damage*(100-target->query_meridian())/100;
	if (random(ap)>dp/3)
	{
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		me->add("neili", -2000);
		me->add("jingli", -2000);
		msg = HIR "$n" HIR "不知此招之强，招架之下竟被$N" HIR "这一剑震得口吐鲜血，连连倒退。\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		msg = CYN "$n" CYN "身在空中，不及变招，只能挥出一招，正击中$N"CYN "剑上，略一借力，飘然避去。\n" NOR;
		message_vision(msg, me, target);			   
		me->add("neili", -200);
	}
}	
	
if (me->query_skill("yifeng-jian",1)>3000 && me->query_skill("yihua-jiemu",1)>3000)
{
		message_vision(HIW "\n$N" HIW "娇喝一声，手中" + weapon->name() + HIW "随即不停舞动，如巨浪般卷"
                        "出，正是冥雨神功绝技「" HIM "冰河倒挂" HIW "」\n，突然" + weapon->name() + HIW 
                        "幻出的冰河激射出四路袭向$n，势不可挡．\n" NOR, me, target); 
		msg = HIM "\n$N" HIM "圈转" + weapon->name() + HIM "，剑势灵动，招招直指要害，剑光如网，铺天盖地。\n" NOR;	
		message_vision(msg, me, target);
		me->add_temp("apply/attack",extra*2);
		me->add_temp("apply/damage",extra*2);
		COMBAT_D->do_attack(target, target, target->query_temp("weapon"), 0);
		me->add_temp("apply/attack",-extra*2);
		me->add_temp("apply/damage",-extra*2);	
		
	if (me->query("jm/yihua")) damage = (int)me->query_skill("yifeng-jian",1)*me->query("per",1)*3/2+(int)me->query_skill("yihua-jiemu",1)*me->query("dex",1)*3/2+(int)me->query_skill("mingyu-shengong",1)*me->query("con",1)*3/2+me->query("xyzx_sys/level") + me->query_skill("yifeng-jian", 1)+me->query_skill("yihua-jiemu",1) + me->query_skill("sword",1) + me->query_skill("force",1)+me->query_skill("dodge",1)+me->query_dex()/5;
	else damage = (int)me->query_skill("yifeng-jian",1)*me->query("per",1)+(int)me->query_skill("yihua-jiemu",1)*me->query("dex",1)+(int)me->query_skill("mingyu-shengong",1)*me->query("con",1)+me->query("xyzx_sys/level") + me->query_skill("yifeng-jian", 1)+me->query_skill("yihua-jiemu",1) + me->query_skill("sword",1) + me->query_skill("force",1)+me->query_skill("dodge",1)+me->query_dex()/10;
	
	if (random(ap)>dp/3)
	{
		damage = damage/3 + random(damage/3) + target->query("qi")*3/100;
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		me->add("neili", -3000);
		me->add("jingli", -3000);
		msg = HIR "此招来势当真快极，$n" HIR "哪里来得及闪避招架？只见$N" HIR "剑光闪过，$n"HIR "混身霎时鲜血淋漓！\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);								   
	} else
	{
		damage = damage/9 + random(damage/9) + target->query("qi")*1/100;
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		me->add("neili", -1000);
		msg = HIR "$n" HIR "慌乱出招，却都只击到残影，"HIR "身上也同时多处中招．\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);
	}

}	
	me->start_busy(1);
	return 1;
}


void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}