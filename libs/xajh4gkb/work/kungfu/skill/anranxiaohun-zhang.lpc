int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query("family/family_name")!="古墓派")
		return notify_fail("你不是本门中人，无法领悟本门技能的精髓。\n");
	if(!me->query("couple/have_couple"))
		return notify_fail("你还没有所爱的人，不能领会其中的精要！\n");
	if ((int)me->query_skill("anranxiaohun-zhang", 1) > 3000)
		return notify_fail("上乘武学只能教到这里了，以后要靠自己勤加修习领悟。\n");
	if (me->query("gender") != "男性")
		return notify_fail("你体会不到男人思念一个人的心情。\n");
	if (!me->query("jm/quanzhen"))
		return notify_fail(CYN"我古墓派祖师与全真教重阳真人恩怨纠葛，可惜最终未能修成正果。我古墓弟子都得先去全真门下修行一段时间方可入门。\n"NOR);	
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);		
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练黯然消魂掌必须空手。\n");
	if ((int)me->query("max_neili") < 300000)
		return notify_fail("你的内力太弱，无法练黯然消魂掌。\n");
	if ((int)me->query("str",1)< 30)
		return notify_fail("你的根骨太弱，无法练黯然消魂掌。\n");
	if (me->query_skill("yunv-xinfa", 1) < 300 && me->query_skill("yunv-xinjing", 1) < 300)
		return notify_fail("你的内功心法不够，无法领会其中的精要！\n");
	if ((int)me->query("score",1) < 10000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	if (random(10)==1) me->add("score",-10);
	return 1;
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query("family/family_name")!="古墓派")
		return notify_fail("你不是本门中人，如何学到本门高深技能，我要告诉掌门去。\n");
	if (!me->query("jm/quanzhen"))
		return notify_fail(CYN"我古墓派祖师与全真教重阳真人恩怨纠葛，可惜最终未能修成正果。我古墓弟子都得先去全真门下修行一段时间方可入门。\n"NOR);	
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);		
	if (me->query_skill("yunv-xinfa", 1) < 300 && me->query_skill("yunv-xinjing", 1) < 300)
		return notify_fail("你的内功心法不够，无法领会其中的精要！\n");
	if ((int)me->query("qi") < 30)
		return notify_fail("你的体力太低了。\n");
	if (me->query_skill("unarmed", 1) <= me->query_skill("anranxiaohun-zhang",1))
		return notify_fail("你的基础不够，无法练习黯然消魂掌。\n");
	if (me->query("gender") != "男性")
		return notify_fail("你体会不到男人思念一个人的心情。\n");	
	if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练黯然消魂掌。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 25);
	me->add("neili", -30);
	return 1;
}

string query_skill_name(int level)
{
	int i = sizeof(action);
	while (i--)
		if(level > action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int level;
	string msg;
	level = (int) me->query_skill("anranxiaohun-zhang",1);

			switch(random(3))
			{
			case 0:
				msg = HIC"$N心下万念俱灰，没精打采的挥袖卷出，拍出一掌，只听得噗的一声，这一掌正好击向$n肩头"NOR;
				break;
			case 1:
				msg = HIY"$N心下万念俱灰，没精打采的挥袖卷出，拍出一掌，只听得噗的一声，这一掌正好击向$n肩头"NOR;
				break;
			case 2:
				msg = HIR"紧跟着$N踢出一脚。这一脚发出时恍恍惚惚，隐隐约约，若有若无。砰的一响，向$n胸口袭去"NOR;
				break;
			default:
				msg = HIC"$N心下万念俱灰，没精打采的挥袖卷出，拍出一掌，只听得噗的一声，这一掌正好击向$n肩头"NOR;
				break;
			}

			if (me->query_temp("anran")
			&& me->query("jiali") >= 50
			&& random(20) >= 15
			&& me->query_skill("yunv-xinfa",1)>100)
			{
				return ([
            "action":msg,
			"attack":	1000,
			"parry":	1000,
			"dodge":	1000,
			"damage":	1000,
			"force":	1000,
            "lvl" : 	500,
            "weapon" : random(2)?"黯然掌掌风":"黯然掌掌力",
            "damage_type" : random(2)?"瘀伤":"割伤",
				        ]);
			}
			if (level >= 300 && random(20) > 4
			&& me->query("jiali") >= 50
			&& me->query_skill("yunv-xinfa",1)>300)
			{
				return ([
            "action":msg,
			"attack":	1000,
			"parry":	1000,
			"dodge":	1000,
			"damage":	1000,
			"force":	1000,
            "lvl" : 	500,
            "weapon" : random(2)?"掌风":"黯然掌力",
            "damage_type" : "割伤",
				        ]);
			}

	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点		
}



mixed hit_ob(object me, object victim, int damage_bonus)
{
	string msg;
	int ap,dp,ap1,dp1,damage1,damage2,damage,liannum;
	ap = (me->query_str(1)+me->query_con(1))*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = (victim->query_str(1)+victim->query_con(1))*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	damage1 = (int)me->query_skill("anranxiaohun-zhang",1);
	damage2 = (int)me->query_skill("anranxiaohun-zhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	ap1 = me->query_skill("anranxiaohun-zhang", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp1 = victim->query_skill("dodge",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( (me->query_skill("yunv-xinfa",1) < 100 && me->query_skill("yunv-xinjing",1) < 100) ||  me->query_skill("anranxiaohun-zhang",1) < 100) return 0;
//	if ( me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") == "yunv-xinjing") return 0;
	if (objectp(me->query_temp("weapon"))) return 0;

	if( random(7)==1 && random(ap1) > dp1/8 && me->query("jiali") >0)
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		switch(random(3))
		{
		case 0 :
			msg = YEL"$N抬头向天，浑若不见，呼的一掌向头顶空空拍出，手掌斜下，掌力化成弧形，四散落下！\n"NOR;
			msg += HIR"结果$n被这一招「杞人忧天」带得别说挣扎，竟连站定脚步也是不能。\n"NOR;
			break;
		case 1 :
			msg = HIB"$N右手云袖飘动，宛若流水，左掌却重滞之极，便似带着几千斤泥沙一般！\n"NOR;
			msg += HIR"结果$n被这一招「拖泥带水」带得犹如身陷洪涛巨浪，跌跌撞撞。\n"NOR;
			break;
		case 2 :
			msg = HIG"突然间$N手足齐动，左掌右袖、双足头锤、连得胸背腰腹尽皆有招式发出！\n"NOR;
			msg += HIR"结果$n被这一招「无中生有」带得自身全然身不由主的境地。\n"NOR;
			break;
		}
		victim->apply_condition("xiangsi",20);
		me->add("neili", -100 );
		victim->add("neili", -damage );
		victim->add("jingli", -damage );
		if (!victim->is_busy()) victim->start_busy(2);
		message_vision(msg, me,victim);
		return ;
	}
	if( random(ap) > dp/3 && random(7)==2 && me->query("jiali") >0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100 );
		message_vision(HIR "只听到“哇”的一声，$n喷出了一大口鲜血！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;					
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==3 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N心下万念俱灰，心头涌起无限哀思，"+me->query("cognize")+HIG"的力量随手而出！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==4 && (int)me->query("jm/gumu") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIR "$N一掌击出，顿时恍恍惚惚，隐隐约约，恰好是古墓武功的精妙所在。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int j,damage1,damage2, ap,dp;

	damage1 = (int)me->query_skill("anranxiaohun-zhang",1);
	damage2 = (int)me->query_skill("anranxiaohun-zhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	ap = me->query_skill("anranxiaohun-zhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("parry",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	if (damage <10)  damage=10;
	if (objectp(me->query_temp("weapon"))) return damage;
    if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if ( (me->query_skill("yunv-xinfa",1) < 100 && me->query_skill("yunv-xinjing",1) < 100) ||  me->query_skill("anranxiaohun-zhang",1) < 100) return damage;
//	if ( me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") == "yunv-xinjing") return damage;

	if (random(8)==1 && random(ap)>dp/4 )
	{
		msg = HIC"$N"+HIC+"满场游走，招断意连，绵绵不绝，一招未毕，二招至！\n" NOR;
		j = -(damage+random(damage));
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );
		message_vision(msg, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
	if (random(8)==2 && random(ap)>dp/4 && (int)me->query("breakup")>1 )
	{
		msg = HIC"$N见招拆招，脸现寂寞之情，"+me->query("cognize")+HIC"的力量爆发，随手一掌反击在$n的招式间隙！\n" NOR;
		j = -(damage+random(damage));
		me->add("jingli", -100 );		
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		message_vision(msg, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if (random(8)==3 && random(ap)>dp/4 && (int)me->query("jm/gumu"))
	{
		msg = HIC"$N洞悉古墓武功轻灵之精义，随意一掌架住了$n的必杀之招！\n" NOR;
		j = -(damage+random(damage));
		me->add("neili", -100 );		
		if (!ob->is_busy()) ob->start_busy(1);
		message_vision(msg, me, ob);
		return j;
	}
}

string perform_action_file(string action)
{
	return __DIR__"anranxiaohun-zhang/" + action;
}


string query_description()
{
	return
	    "杨过自和小龙女在绝情谷断肠崖前分手，不久便由神雕带着在海潮之中练功，"
	    "数年之后，除了内功循序渐进之外，别的无可再练，心中整日价思念小龙女，"
	    "渐渐的形销骨立，了无生趣。一日在海滨悄然良久，百无聊赖之中随意拳打脚"
	    "踢，其时他内功火候已到，一出手竟具极大威力，轻轻一掌，将海滩上一只大"
	    "海龟的背壳打得粉碎。他由此深思，创出了一套完整的掌法，出手与寻常武功"
	    "大异，厉害之处，全在内力，一共是一十七招。他生平受过不少武学名家的指"
	    "点，自全真教学得玄门正宗内功的口诀，自小龙女学得【玉女心经】，在古墓"
	    "中见到【九阴真经】，欧阳锋以蛤蟆功和逆转经脉，洪七公与黄蓉授以打狗棒"
	    "法，黄药师授以弹指神通和玉箫剑法，除了一阳指之外，东邪、西毒、北丐、"
	    "中神通的武学无所不窥，而古墓派的武学又于五大高人之外别创蹊径，此时融"
	    "会贯通，已是卓然成家。只因他单剩一臂，是以不在招数变化取胜，反而故意"
	    "与武学通理相反。他将这套掌尘定名为“黯然销魂掌”，取的是江淹【别赋】"
	    "中那一句“黯然销魂者，唯别而已矣”之意。";
}
