string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}
int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的内力不够。\n");
  //	if (((int)me->query_skill("kuihua-feiying", 1)+100) < (int)me->query_skill("kuihua-dafa", 1))
  //		return notify_fail("你的葵花飞影术太低了。\n");
  if ((int)me->query_skill("kuihua-xinfa", 1) < 100)
    return notify_fail("你的葵花心法太低了。\n");
  if (me->query("family/family_name") != "日月神教")
    return notify_fail("不加入日月神教，学不了东方不败的技能。\n");
  if ((int)me->query("dex", 1) < 30)
    return notify_fail("天下武功，唯快不破。\n");
  if ((int)me->query_skill("pixie-jian", 1) < 300)
    return notify_fail("你的「辟邪剑法」火候太浅。\n");
  if ((string)me->query("gender") == "女性")
    return notify_fail("自古就没有女子可以使用.\n");
  if ((string)me->query("gender") == "男性")
    return notify_fail("欲练神功，必先自宫，欲使神功，快快进宫.\n");
  if ((string)me->query("genderbak") == "男性")
    return notify_fail("你个假太监，赶紧去割了.\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");

  return 1;
}
int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("jing") < 40)
    return notify_fail("你的体力太差了，不能练习葵花飞影术。\n");
  if (me->query("family/family_name") != "日月神教")
    return notify_fail("不加入日月神教，练不了东方不败的技能。\n");
  if ((string)me->query("gender") == "女性")
    return notify_fail("自古就没有女子可以使用.\n");
  if ((string)me->query("gender") == "男性")
    return notify_fail("欲练神功，必先自宫，欲使神功，快快进宫.\n");
  if ((string)me->query("genderbak") == "男性")
    return notify_fail("你个假太监，赶紧去割了.\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->receive_damage("jing", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "kuihua-feiying/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  int j, ap, dp, damage1, damage2;
  ap = me->query_skill(
    "kuihua-feiying",
    1
  ) * me->query(
    "dex",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "dodge",
    1
  ) * ob->query(
    "con",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = me->query_skill("kuihua-feiying", 1) + me->query_skill("kuihua-xinfa", 1);
  damage2 = (me->query_skill(
    "kuihua-feiying",
    1
  ) + me->query_skill(
    "kuihua-xinfa",
    1
  )) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "kuihua-feiying",
    1
  ) < 100 || me->query_skill("kuihua-xinfa", 1) < 100) return damage;
  //	if (me->query_skill_mapped("force")!="kuihua-xinfa" ) return damage;

  if (me->is_busy() && random(6) == 0 && me->query_skill_mapped("force") == "kuihua-xinfa") {
    me->start_busy(1);
    me->add("neili", -100);
    j = -(damage / 3 + random(damage / 3));
    message_vision(HIC "$N阴阴一笑，默运葵花心法，僵硬的身子轻柔起来!\n" NOR, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 1) {
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    j = -(damage + random(damage / 3));
    message_vision(
      HIC "$N身形变的模糊起来，只见一道影子绕着$n飞快的奔走，不一会飚出几道鲜血。\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage + random(damage));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIG "$N进入" + me->query("cognize") + HIG "，一颦一笑都充满阴柔之力，充分发挥出女人柔软身段，一扭就闪开了$n的招式！。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/riyue")) {
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    message_vision(
      HIB "$N领悟日月神教武学，大笑三声！萝莉有三好：身轻，体柔，易推倒！\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
}
