int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("空手方能练习美女拳法。\n");
	if (me->query("gender") != "女性") 
		return notify_fail("你不是美女，无法体会美女拳法的精要。\n");
	if (me->query("family/family_name")!="古墓派")
		return notify_fail("你不是古墓中人，无法学习本门技能。\n");	
	if (!me->query("jm/quanzhen"))
		return notify_fail(CYN"我古墓派祖师与全真教重阳真人恩怨纠葛，可惜最终未能修成正果。我古墓弟子都得先去全真门下修行一段时间方可入门。\n"NOR);	
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);				
	if ((int)me->query_skill("yunv-xinjing", 1) < 100 && (int)me->query_skill("yunv-xinfa", 1) < 100)			
		return notify_fail("玉女心经领悟不够，无法修习美女拳法。\n");
	if ((int)me->query_skill("dodge", 1) < 200)
		return notify_fail("你的轻功太差，无法练美女拳法。\n");
	if ((int)me->query("per", 1) < 25)
		return notify_fail("美女拳法，顾名思义是美女才能练的。\n");	
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("qi") < 30)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练美女拳法了。\n");
	if (me->query("family/family_name")!="古墓派")
		return notify_fail("你不是古墓中人，无法练习本门技能。\n");	
	if (!me->query("jm/quanzhen"))
		return notify_fail(CYN"我古墓派祖师与全真教重阳真人恩怨纠葛，可惜最终未能修成正果。我古墓弟子都得先去全真门下修行一段时间方可入门。\n"NOR);	
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if ( me->query("gender") != "女性" )
		return notify_fail("你又不是美女，怎么可能练的了美女拳法？\n");	
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 25);
	me->add("neili", -5);
	return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;

    ap = me->query_skill("meinv-quanfa",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("meinv-quanfa",1);
	damage2 = (int)me->query_skill("meinv-quanfa",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( ((int)me->query_skill("yunv-xinjing", 1) < 100 && (int)me->query_skill("yunv-xinfa", 1) < 100 && (int)me->query_skill("jiuyin-zhenjing",1) < 100) || (int)me->query_skill("meinv-quanfa",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "yunv-xinjing" && me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") != "jiuyin-zhenjing") return 0;
	if (objectp( me->query_temp("weapon")) ) return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(CYN"$n受$N的感染，呆在原处，两眼发直，一动不动，不知觉的吐了一口鲜血。\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，悄退数步，右手支颐，左手轻轻挥出，长叹一声，脸现寂寥之意。\n"NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/gumu") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIM"$N融汇古墓派武功精髓，神情冰冷，一颦一笑莫可名状。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

string perform_action_file(string action)	
{
	return __DIR__"meinv-quanfa/" + action;	
}
