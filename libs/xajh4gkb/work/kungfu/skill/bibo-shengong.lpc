#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;
int valid_enable(string usage) { return usage=="force"; }
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "juehu-shou"; }		//互备技能
string skill_pinji() {return "中乘";}				//品级区分：上乘、中乘、下乘
string skill_xingbie() {return "通用";}				//性别区分：男性、女性、无性、通用
string skill_zhengxie() {return "中立";}			//正邪区分：正道、邪道、中立
string skill_menpai() {return "桃花岛";}				//门派区分：门派，江湖
string skill_yinyang() {return "中性";}				//阴阳区分：阳、阴、中性
string skill_zhenying() {return "中立";}			//阵营区分：正派、邪派、中立、通用
//int damage_damage() {return 60;}	//外伤系数
//int force_damage() {return 60;}		//内伤系数
int qi_heal() {return 41;}		//内功疗气系数
int jing_heal() {return 55;}		//内功疗精系数
int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
    mapping skl;
    string *sname;
    int i;
	int lvl = (int)me->query_skill("bibo-shengong", 1);
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ( me->query("gender") == "无性" && lvl > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的碧波神功。\n");
    if (me->query("family/family_name")!="桃花岛")
		return notify_fail("你不加入本门，无法传授本门技能的精髓。\n");			
    if (me->query_skill("force",1)<100)
        return notify_fail("你的基本内功基础不够，怎能学碧波神功。\n");
    if (me->query_skill("force",1)<=lvl)
        return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
    skl = this_player()->query_skills();
    sname  = keys(skl);
    for (i=0;i<sizeof(skl);i++){
        if (sname[i]=="yijing-force") continue;
        if (sname[i]=="xixing-dafa") continue;
        if (sname[i]=="bibo-shengong") continue;
            if( SKILL_D(sname[i])->valid_enable("force") )
            return notify_fail("你不先散了别派内功，怎能学碧波神功？！\n");
    }
    return 1;
}
int practice_skill(object me)
{
    return notify_fail("碧波神功只能用学的，或是从运用(exert)中增加熟练度。\n");
}
string exert_function_file(string func)
{
    return __DIR__"bibo-shengong/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage1,damage2,damage,liannum;
	damage1 = (int)me->query_skill("bibo-shengong",1);
	damage2 = (int)me->query_skill("bibo-shengong",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	ap = me->query_skill("bibo-shengong",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if ( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
	if ( me->query_skill("bibo-shengong",1) < 100)	 return 0;
	if ( me->query_skill_mapped("force") != "bibo-shengong") return 0;	

	if ( random(ap) > dp/3 && random(7)==1 && me->query("jiali") > 0) 
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100 );
		message_vision(HIB "$N提气长啸一声，发挥出"+HIR+"碧波神功"NOR HIB"的精髓，碧浪一波一波摧毁了$n的真元！！！！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIR "$N长啸一声，"+me->query("cognize")+HIR"的力量如波涛般滚滚而来，势不可挡。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/taohua") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIR "$N凝神静气，突然领悟桃花岛武学精髓，波涛声乍起。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

mapping exercise_msg(object me)
{
	return ([
		"status_msg" : "面容肃穆，静坐如渊岳，沐轻风而不惊" NOR,
		"start_my_msg" : "盘腿坐下，双目微闭，双手掌心相向成虚握太极，天人合一，练气入虚。\n",
		"start_other_msg" : me->name() + "盘腿坐下，双目微闭，双手掌心相向成虚握太极。轻风吹过，" + me->name() + "身上的衣袍竟然不为所动。\n",
		"heal_my_msg" : "凝神静气，内息随悠扬箫声在全身游走，恰似碧海浪涛般冲击受损被封经脉。\n",
		"heal_other_msg" : me->name()+"脸色渐渐变得舒缓，箫声亦随之急转直下，渐不可闻。\n",		
		"halt_msg" :  "长长的吸了一口气，周身风浪渐渐平息，站了起来。\n",
		"end_my_msg" : "将内息又运了一个小周天，缓缓导入丹田，双臂一震，站了起来。\n",
		"end_other_msg" : me->name() + "的脸上红光乍现，又立刻隐去。随即双臂一震，站了起来。\n",
		"hover_my_msg" : "内息运转一周天，箫声募然高亢渐而消失，人随之站起，猛地吐出一口淤血。\n"NOR,
		"hover_other_msg" : me->name()+"停止吹奏，箫声骤然竭止，回转气息，疗伤完毕，站了起来。\n"NOR,
	]);
}