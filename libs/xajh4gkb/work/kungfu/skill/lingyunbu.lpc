
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit SKILL;
string *dodge_msg = ({
    "$n身子一晃，脚踏无常方位，轻轻巧巧的躲开了$N凌厉无比的攻击。\n",
    "$n对$N的攻击视而不见，直到$N的招式近身才不慌不忙的向左迈出一步，竟然毫发无伤。\n",
    "只见$n左踏五行位置，右踩太白虚浮，身形潇洒如园中散步般躲开了$N一招又一招。\n"
});
int valid_enable(string usage) { return (usage == "dodge"); }
//2019-1-1阿飞新规划，技能代码完善
