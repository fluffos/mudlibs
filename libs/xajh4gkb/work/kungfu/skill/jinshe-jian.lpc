mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	object ob;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("qi") < 300 || (int)me->query("neili") < 150 )
		return notify_fail("你的内力或气不够，没有办法练习金蛇剑法。\n");
	if( !(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword" )
		return notify_fail("你必须先找一把剑才能练剑法。\n");
	if ( (int)me->query_skill("jinshe-jian",1) < 200)
		return notify_fail("你按着所学练了一遍金蛇剑法，似乎没有任何长进。\n");
//	if ((int)me->query_skill("taixuan-gong", 1) < 100 )
//		return notify_fail("你的太玄功火候不够，无法练习金蛇剑。\n");		
	me->receive_damage("qi", 30);
	me->add("neili", -15);
	write("你按著所学练了一遍金蛇剑法。\n");
	return 1;
}


string *parry_msg = (
{
	"$n不退反进，气走周天，手中的利剑狠狠磕开了$N的$w。\n",
	"$n回剑自守，架住了$N的$w。\n",
	"$n手中的长剑化作千百把，护住了全身。\n",
	"$n手中的利剑自上削下，几乎将$N的$w削成两段。\n",
});

string *unarmed_parry_msg = (
{
	"$n使动手中剑，在身前布起了一道铜墙铁壁，封住了$N的攻势。\n",
	"$n一抖手中的利剑，护住了全身。\n",
	"$n将剑往地上一刺，长剑反弹起来，刚好直刺$N的双臂。\n",
	"$n举剑静立，一股内力从剑梢透出，逼开了$N。\n",
});

string query_parry_msg(object weapon)
{
	if( weapon )
		return parry_msg[random(sizeof(parry_msg))];
	else
		return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string action)
{
	return __DIR__"jinshe-jian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	object weapon;
	int ap, dp,damage1,damage2,damage,liannum;
	weapon = me->query_temp("weapon");
	ap = (me->query_skill("sword",1) +  me->query_skill("jinshe-jian",1))*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = (victim->query_skill("dodge",1) + victim->query_skill("parry",1))*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	damage1 = (int)me->query_skill("jinshe-jian",1);
	damage2 = (int)me->query_skill("jinshe-jian",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if ( me->query("jingli") < 100 || me->query("neili") < 100 || damage_bonus < 100) return 0;
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return 0;
	if (me->query_skill("jinshe-jian",1) < 300 ) return 0;
//	if ( me->query_skill_mapped("force") != "yijing-force") return 0;
	if ((string)weapon->query("id") != "jinshe jian") damage1 *=2;
	
	if (random(ap) > dp/3 && random(7)==1 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		message_vision(HIW "$N剑锋一转，手中" + weapon->name() + HIW"犹如灵蛇般地舞动着，竟将$n" HIW "周身缠绕，$n一道血箭飚出！！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(2);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，手中" + weapon->name() + HIG "化作一条金蛇，突然射向$n，$n急忙收招。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/jinshe") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIM"$N参悟金蛇剑秘密，手中" + weapon->name() + HIC "突然分裂成无数碎片，将$n割的体无完肤。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}
