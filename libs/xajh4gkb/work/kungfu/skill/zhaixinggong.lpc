int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{ 
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query_skill("dodge", 1) <=me->query_skill("zhaixinggong", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    if (me->query("family/family_name")!="星宿派")
		return notify_fail("你不是星宿门人，无法学习摘星功。\n");	
    if ((int)me->query_skill("huagong-dafa", 1) < 100)
		return notify_fail("你的化功大法火候不够，无法学习摘星功。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
    return 1;
}
string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("qi") < 40 )
		return notify_fail("你的体力太差了，不能练摘星功。\n");
	if (me->query("family/family_name")!="星宿派")
		return notify_fail("你不是星宿门人，无法练习摘星功。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");		
	me->receive_damage("qi", 30);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"zhaixinggong/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;

	ap = me->query_skill("zhaixinggong", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("parry",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("zhaixinggong", 1);
	damage2 = me->query_skill("zhaixinggong", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("huagong-dafa",1) < 300 || me->query_skill("zhaixinggong", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="huagong-dafa" ) return damage;
	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIG"$N欲上高楼摘星星，欧耶！摘到一个亮晶晶送给你！$n一时兴奋的忘了攻击。\n"NOR;
		me->add("neili", -100 );
		j = -(damage+random(damage));
		if (!ob->is_busy()) ob->start_busy(1);
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，脚步飞快如流星赶月，顺势探出双指，刺中了$n双目。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/xingxiu") )
	{
		j = -(damage+random(damage));
		me->add("neili", -100 );
		ob->add("neili", -(damage1+damage2) );
		ob->add("jingli", -(damage1+damage2) );
		message_vision(HIB"$N融汇星宿派武学精髓，$n似乎感到丹元如泥牛入海，消失无踪！\n"NOR, me, ob);
		return j;
	}
}
