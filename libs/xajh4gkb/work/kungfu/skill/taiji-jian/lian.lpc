// tie@fengyun

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
	mixed combat_msg;
	string msg;
	int extra;
	int i, attack_time;
	object weapon;
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("太极剑法「连」字诀只能对战斗中的对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
//	if ( me->query_skill_mapped("sword") != "taiji-jian")
//         return notify_fail("你必须激发太极剑法才能使用「连」字诀！\n");
 	if( me->is_busy() )
		return notify_fail("你正忙着呢！\n");  
	if ((int)me->query("max_neili")<200000)								
		return notify_fail("你的内力修为不够。\n");
	if ((int)me->query("max_jingli")<200000)								
		return notify_fail("你的精力修为不够。\n");	
	if( (int)me->query("neili") < 1000  ) 		
		return notify_fail("你的内力不够。\n");
	if( (int)me->query("jingli") < 1000  ) 		
		return notify_fail("你的内力不够。\n");
	if( (int)me->query_skill("taiji-jian", 1) < 300 )
		return notify_fail("你的太极剑法不够娴熟，不能用「连」字诀。\n");
	if( (int)me->query_skill("taiji-shengong", 1) < 300 )
		return notify_fail("你的太极神功太浅，别做梦了。\n");	
//	if ( !wizardp(me) && me->query_skill_mapped("force") != "taiji-shengong")
//		return notify_fail(HIC"不使用本门内功，如何使用本门绝学!\n"NOR);	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");	
		
	combat_msg = me->query("env/no_combat_msg");
	if ( !intp(combat_msg) ) combat_msg = 1;
	extra = me->query_skill("taiji-jian",1)/3;
	if( me->query_skill_mapped("force") != "taiji-shengong" ) extra += me->query_skill("taiji-jian", 1)/2;	//2018.9.5阿飞改，不使用本门特内则减益
	if ((string)weapon->query("id") == "zhenwu jian") extra -= me->query_skill("taiji-jian", 1)/3; //2018.3.25阿飞改，拿特殊武器有加成
	me->add_temp("apply/attack", -extra);	
	me->add_temp("apply/damage", -extra);
	 me->add_temp("apply/strength", -extra);
    msg = HIR  "$N使出［太极剑法］中的「连」字诀，手中的"+ weapon->name() +" 一招连着一招画起圈来，闪电般的击向$n！" NOR;	
    message_vision(msg, me, target);	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1

	msg =  HIW "剑光一闪，消失．．．．\n" NOR;
	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
	attack_time = me->query_skill("taiji-jian",1)/60;
	if(attack_time < 1 ) attack_time = 1;
	if (me->query("jm/wudang"))
	{
		if (attack_time > 150) attack_time = 150;
	} else 
	{
		if (attack_time > 50) attack_time = 50;
	}
	
	me->add_temp("lianzhao", attack_time);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
	for(i=0;i<attack_time;i++)
	{
		if (combat_msg<4)
		{
			msg = HIY "$N用剑画了一个圈，一剑又连了上来！\n" NOR;
			COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
		}
		else
			COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR);
	}

	me->add_temp("apply/attack", extra);
	me->add_temp("apply/damage", extra);
	 me->add_temp("apply/strength", extra);
	me->add("neili", - 100 * attack_time);
	me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记	
	 me->start_busy(3);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}