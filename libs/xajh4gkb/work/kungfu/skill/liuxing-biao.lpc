int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力不够。\n");
	if ((int)me->query_skill("biyun-xinfa", 1) < 200)
		return notify_fail("你的碧云心法火候太浅。\n");
    if (me->query("family/family_name")!="唐门")
		return notify_fail("你不是唐门中人，无法学习本门技能。\n");	
	if (!me->query("jm/huanhua"))
		return notify_fail(CYN"这神州结义萧秋水好大的胆子，竟敢强闯我唐门禁地！\n"CYN"这位"+RANK_D->query_respect(me)+CYN"欲入我唐门，需得去浣花派为唐门了结此段恩怨！\n"NOR);
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);		
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	return 1;

}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing")
		return notify_fail("你使用的武器不对。\n");
	if (me->query("family/family_name")!="唐门")
		return notify_fail("你不是唐门中人，无法练习本门技能。\n");	
	if (!me->query("jm/huanhua"))
		return notify_fail(CYN"这神州结义萧秋水好大的胆子，竟敢强闯我唐门禁地！\n"CYN"这位"+RANK_D->query_respect(me)+CYN"欲入我唐门，需得去浣花派为唐门了结此段恩怨！\n"NOR);
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);			
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够，练不了流星赶月镖。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 30);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"liuxing-biao/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap, dp,damage1,damage2,damage,liannum;
	object weapon;
	weapon = me->query_temp("weapon");
    ap = (int)me->query_skill("liuxing-biao",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
    dp = (int)victim->query_skill("dodge",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	damage1 = (int)me->query_skill("liuxing-biao",1);
	damage2 = (int)me->query_skill("liuxing-biao",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("biyun-xinfa",1) < 100 || me->query_skill("liuxing-biao",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "biyun-xinfa") return 0;
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		message_vision(HIR "$N使出流星赶月绝技，两支飞镖一前一后！$n没想到后发先至，手忙脚乱，只躲过了其中一只！！\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，手中" + weapon->name() + HIG "如流星赶月般，一个接一个，一道血光从$n身上飞出。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/tangmen") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		victim->apply_condition(du[random(sizeof(du))], 25);
		message_vision(HIM"$N贯通唐门武功精髓，手中" + weapon->name() + HIM "爆发一道月华，只一闪，$n大叫一声，伤口已是留出一道黑血。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}	

}




