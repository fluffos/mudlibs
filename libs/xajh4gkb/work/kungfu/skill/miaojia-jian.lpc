int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	 if (me->query("family/family_name")!="胡苗世家" )
		return notify_fail("你不是关外胡家或中原苗家弟子，没法传授给你。\n");
	if ( (int)me->query("int", 1) < 25 )        	
		return notify_fail("你的悟性不够，恐怕学不了苗家剑法。\n");
    if ((int)me->query("max_neili") < 10000)
        return notify_fail("你的内力修为不够。\n");
    if ((int)me->query_skill("lengyue-shengong") < 100)
        return notify_fail("你的冷月神功火候太浅。\n");
    if ((int)me->query_skill("sword", 1) < 500)
        return notify_fail("你的基本剑法火候不够，无法学习苗家剑法。\n");
/*	if ((int)me->query_skill("sixiang-bufa", 1) < 120)
        return notify_fail("你的四象步法火候不够，无法学习苗家剑法。\n");
    if ((int)me->query_skill("tianchang-strike", 1) < 120)
        return notify_fail("你的天偿掌法火候不够，无法学习苗家剑法。\n");
    if ((int)me->query_skill("hujia-quan", 1) < 120)
        return notify_fail("你的胡家拳法火候不够，无法学习苗家剑法。\n");*/
    if ((int)me->query_skill("sword", 1) < (int)me->query_skill("miaojia-jian", 1))
        return notify_fail("你的基本剑法水平有限，无法领会更高深的苗家剑法。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	if(level >= action[i]["lvl"])
		return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
	object weapon;
		
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query("family/family_name")!="胡苗世家" )
		return notify_fail("你不是关外胡家或中原苗家弟子，没法练习。\n");
//	if ((int)me->query_skill("daojian-guizhen", 1))
//		return notify_fail("你已经将苗家剑法和胡家刀法二者合一了。\n");
	if ( ! objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力目前没有办法练习苗家剑法。\n");
	if ((int)me->query("neili") < 100)
		return notify_fail("你的内力不够，无法练习苗家剑法。\n");
    if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");    
	me->receive_damage("qi", 53);
	me->add("neili", -84);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"miaojia-jian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;
	object weapon;
	weapon = me->query_temp("weapon");
    ap = me->query_skill("miaojia-jian",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("miaojia-jian",1);
	damage2 = (int)me->query_skill("miaojia-jian",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("lengyue-shengong",1) < 100 || me->query_skill("miaojia-jian",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "lengyue-shengong") return 0;
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		message_vision(HIR "霎时只见剑芒一闪，一股鲜血从$n胸前射出。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，手中" + weapon->name() + HIG "划过一道寒月，$n只觉得剑光一闪，身上飚出一道鲜血。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/humiao") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIM"$N贯通胡苗两家绝学，以剑使出刀招，$n错不及防，被割掉了一块肉。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}
