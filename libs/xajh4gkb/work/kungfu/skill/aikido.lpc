int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query_skill("shayi-xinfa", 1) < 100)
		return notify_fail("你的杀意心法火候不够。\n");
	if (me->query("family/family_name")!="飞天御剑流")
		return notify_fail("你不是本门中人，如何学到本门高深技能，我要告诉掌门去。\n");
	if (!me->query("jm/shushan"))
		return notify_fail(CYN"这蜀山之人常飞来飞去的，这岂不是蔑视我飞天门吗。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"要修炼我飞天门功夫，先得为我门探得蜀山派的飞剑秘密！\n"NOR);
	if ((int)me->query("family_score")<9)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if( (int)me->query("qi") < 80 )
		return notify_fail("你的体力不够了，休息一下再练吧。\n");
	if( (int)me->query("neili") < 50 )
		return notify_fail("你的内力不够了，休息一下再练吧。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");		
	me->receive_damage("qi", 40);
	me->add("neili", -30);
	return 1;
}

 
string *parry_msg = ({
        "$n就势一滚，双手一撑地，全身弹出$N的$w的攻击范围。\n",
});

string *unarmed_parry_msg = ({
        "$n就势一滚，双手一撑地，全身弹出$N的攻击范围。\n",
});

string query_parry_msg(object weapon)
{
	if( weapon )
		return parry_msg[random(sizeof(parry_msg))];
	else
		return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}


string perform_action_file(string action)
{
    return __DIR__"aikido/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage1,damage2,damage,liannum;
	string msg;
	ap  = me->query_skill("aikido", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	damage1 = (int)me->query_skill("aikido",1);
	damage2 = (int)me->query_skill("aikido",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("shayi-xinfa",1) < 100 || me->query_skill("aikido",1) < 100)	 return 0;
//	if ( me->query_skill_mapped("force") != "shayi-xinfa") return 0;
	if (objectp(me->query_temp("weapon"))) return 0;

	if ( random(ap) > dp/3 && random(7)==1 && me->query("jiali") >0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		msg = HIR"「二重劲!」$N以极快速的连击,在第一击后,$n没产生抵抗力时给予第二击! "NOR;
		switch( random(3) ) 
		{
			case 0:
				msg += HIR"「隔空击物!」。$N将二重劲的威力传至远方攻击的$n,用以弥补远距离攻击的不足 。\n"NOR;
				break;
			case 1:
				msg += HIR"「喷射火焰!」。$N胃装油袋,用火石制的假牙点火喷出火焰,$n被极大的火焰打中!! \n"NOR;
				break;
			case 2:
				msg += HIR"「仙鹤飞腿!」。$N使出丑鬼直接传授的拳法之一踢向$n! 这踢法已独创一格!!\n"NOR;
				break;
		}
		me->add("neili", -100 );
		if (!victim->is_busy()) victim->start_busy(1);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(msg, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N双臂凝聚"+me->query("cognize")+HIG"的力量，从不可思议之处击中$n。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/feitian") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		if (!victim->is_busy()) victim->start_busy(1);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIR "$N杀意四起，招招蕴涵飞天门的精髓，将$n击的连连后退。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}