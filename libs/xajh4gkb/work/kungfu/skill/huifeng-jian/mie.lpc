// feng.c 峰回路转

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	string msg;
	int i, attack_time,damage,ap,dp,extra;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("「灭绝式」只能对战斗中的对手使用。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
    if((int)me->query_skill("linji-zhuang",1)<300)
        return notify_fail("你的临济十二庄不够深厚，不能使用「灭绝式」。\n");	
    if( (int)me->query_skill("huifeng-jian", 1) < 300 )      	
         return notify_fail("你的回风拂柳剑不够娴熟，不会使用「灭绝式」。\n");
	if( (int)me->query("max_jingli") < 200000  )
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < (int)me->query_skill("huifeng-jian", 1)*4 )
		return notify_fail("你的精力不够。\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的内力不够。\n");
//	if ( me->query_skill_mapped("force") != "linji-zhuang")	
//		return notify_fail(RED"你未激发临济十二庄，不能施展「灭绝式」。\n"NOR);	
//	if (me->query_skill_mapped("sword") != "huifeng-jian")
//		return notify_fail("你没正确激发该技能 。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
        msg = HIY "$N使出峨嵋回风拂柳剑「灭绝式」，剑招连绵不绝。\n";
		message_vision(msg, me, target);
	extra = me->query_skill("huifeng-jian",1)/12;
	if ( me->query_skill_mapped("force")!="linji-zhuang" ) extra -= me->query_skill("huifeng-jian", 1)/15;	//2018.9.5阿飞改，不使用本门特内则减益
	if ((string)weapon->query("id") == "yitian jian") extra += (int)me->query_skill("huifeng-jian", 1)/12;	//2018.3.25阿飞改，拿特殊武器有加成		
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1		
	ap = me->query("xyzx_sys/level") + me->query_skill("huifeng-jian", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	attack_time = (int)me->query_skill("huifeng-jian", 1) / 600;	
	if(attack_time < 1) attack_time = 1;
	if (me->query("jm/emei")) 
	{
		if (attack_time > 100+(int)me->query_temp("lianzhao_max_add")*4) attack_time= 100+(int)me->query_temp("lianzhao_max_add")*4;
	} else 
	{
		if (attack_time > 50+(int)me->query_temp("lianzhao_max_add")*2) attack_time= 50+(int)me->query_temp("lianzhao_max_add")*2;
	}	

	if( random(ap) > dp/4 )
	{
//		me->add_temp("lianzhao", attack_time);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害		
		msg = CYN " 结果$n被$N攻了个措手不及！\n" NOR;
		message_vision(msg, me, target);
		me->add_temp("apply/attack", extra);	
		me->add_temp("apply/damage", extra);
		me->add_temp("apply/strength", extra);	
		for(i = 0; i < attack_time; i++)
		{
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
		}
		me->add_temp("apply/attack", -extra);	
		me->add_temp("apply/damage", -extra);
		me->add_temp("apply/strength", -extra);
		me->add("jingli", -100*attack_time);
//		me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记		
	}
	else
	{
		msg = "可是$n看破了$N的企图，并没有上当。\n" NOR;
		message_vision(msg, me, target);
	}
	msg = HIC "$N手中长剑剑芒跃动，剑光暴长，幻出死亡的色彩，剑尖渐\n"NOR;
	msg += HIC"渐逼近$n，$n看到漫天剑光，抽身后跃，只这一刹，漫天剑\n"NOR;
	msg += HIC"影化为一剑直刺$n前胸，快捷无伦，只有一剑！\n"NOR;
	message_vision(msg, me, target);
	if (random(ap)>dp/3)
	{
		damage = me->query_skill("huifeng-jian", 1)*3 +  me->query_skill("sword", 1) +  me->query_skill("force");
		damage = damage/2 + random(damage/2);
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("jing", damage,me);
		target->receive_wound("jing", damage/2,me);
		msg = HIC"$n根本没法躲避，一式「回风拂柳剑」的绝招「灭剑」端端正\n"NOR;
		msg += HIC"正扎进在$n胸口！$n一低头，看长剑自胸口拔出！\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
		me->add("jingli", -500);
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		msg = HIY"可是$n轻轻一笑，侧身右转，伸出两指，正弹在$N的剑上，长\n"NOR;
		msg += HIY"剑在$n身侧划过，毫发无伤。\n"NOR;
		message_vision(msg, me, target);
		me->add("jingli", -100);
	}	
	if(!target->is_fighting(me)) target->fight_ob(me);
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}