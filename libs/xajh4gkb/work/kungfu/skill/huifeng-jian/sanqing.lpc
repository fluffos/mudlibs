// sanqing.c 一剑化三清
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	object weapon;
	string msg;
	int extra;
	int damage,damage1;
	int ap,dp;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「一剑化三清」只能对战斗中的对手使用。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("开始时必须拿着一把剑！\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
	if (me->is_busy())
		return notify_fail("你现在没空！！\n");
	if( (int)me->query("max_neili") < 100000  )
		return notify_fail("你的内力修为不够。\n");
	if( (int)me->query("neili") < 10000 )
		return notify_fail("你的内力不够。\n");
	if( (int)me->query("max_jingli") < 1000000  )
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你的精力不够。\n");
	if(!wizardp(me) && (int)me->query_skill("huifeng-jian", 1) < 1000 )
		return notify_fail("你的回风剑不够高!不能贯通使用！\n");
	if(!wizardp(me) && (int)me->query_skill("jinding-zhang", 1) < 1000 )
		return notify_fail("你的金顶掌不够高!不能贯通使用！\n");
	if(!wizardp(me) && (int)me->query_skill("linji-zhuang", 1) < 1000 )
		return notify_fail("你的本门内功不够高!不能贯通使用！\n");
	if (me->query_skill_mapped("sword") != "huifeng-jian")
		return notify_fail("你没正确激发该技能 。\n");
	if ( !wizardp(me) && me->query_skill_mapped("force") != "linji-zhuang")
		return notify_fail("不使用本门内功，如何使用本门绝学!\n");
	if (!wizardp(me) && !(int)me->query("breakup") )
		return notify_fail("你任督二脉未通,无法使用「一剑化三清」。\n"NOR);	
    if (target && !living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HBWHT "$N贯通峨嵋派武学，使出了峨嵋派的绝学之精髓！\n" NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1	
//	if (!target->is_busy() && random(3)==1)  target->start_busy(5);
	extra = me->query_skill("huifeng-jian",1)/10 + me->query_skill("linji-zhuang",1)/10;
	damage1 = me->query_skill("huifeng-jian",1) + me->query_skill("linji-zhuang",1) + me->query_skill("jinding-zhang",1);
	ap = me->query("xyzx_sys/level") + me->query_skill("huifeng-jian", 1) +me->query_skill("jinding-zhang",1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	msg = YEL "$N使出回风拂柳剑绝技「一剑化三清」，一招连环三剑，手中的"+ weapon->name() +"闪电般攻出第一剑！" NOR;
	message_vision(msg, me, target);

	me->add_temp("apply/attack", extra);
	me->add_temp("apply/damage", extra);
	msg = HIY "只见$N右手一抖，"+ weapon->name()+ HIY"划向$n的左肩！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

	if (random(ap) > dp/3 )
	{
		msg = HIW "第一道剑气"+HIR+"击向$n周身，$n只觉得全身气脉通道阻塞，真气立受干挠！\n"NOR;
		message_vision(msg, me, target);
//		if( !target->is_busy() ) target->start_busy(3);
//		target->apply_condition("no_perform", 10);
		
	}
	msg =  HIW "$N凌空一劈，"+ weapon->name()+ GRN"削向$n的右肩！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

	if (random(ap)> dp/3  )
	{
		damage = damage1/2 + random(damage1/2);
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("jing",damage,me);
		target->receive_wound("jing",damage/2,me);	
		msg = HIC "第二道剑气"+HIM+"扫中$n的身上,$n只觉得全身一阵急痛！\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	msg = CYN "$N长啸一声，聚功力于左手，使出剑法的最高境界--灭剑，朝$n的胸前劈去！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

	if (random(ap) > dp/3 )
	{
		damage = damage1/2 + random(damage1/2);
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("jing",damage,me);
		target->receive_wound("jing",damage/2,me);	
		target->add("neili",-damage);	
		msg = MAG "最后一道剑气"+HIB+"扫中$n的章门穴,$n只觉得全身内力提不起来了！\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	me->add_temp("apply/attack", - extra);
	me->add_temp("apply/damage", - extra);
	me->add("jingli", -1000);
	
if(me->query_skill("huifeng-jian",1) > 2000 && (int)me->query_skill("jinding-zhang", 1) > 2000 )
{	
	msg = YEL "$N手中长剑剑芒跃动，剑光暴长，幻出死亡的色彩，剑尖渐渐逼近$n，\n"NOR;
	msg += YEL"$n看到漫天剑光，抽身后跃，只这一刹，漫天剑影化为一剑直刺$n前胸，"NOR;
	message_vision(msg, me, target);
	damage1 = me->query_skill("huifeng-jian",1)*3 + me->query_skill("lingji-zhuang",1)*3 + me->query_skill("sword",1);
	if( weapon = target->query_temp("weapon") )
	{
		if( random(ap) > dp/3 )
		{
			msg = HIM"\n$n只觉得浑身一热，手掌虎口巨痛，手中" + target->query_temp("weapon")->query("name") + "脱手而出。\n" NOR;
			message_vision(msg, me, target);
			target->query_temp("weapon")->move(environment(target));
		}
		else
		{
			msg = HIY"\n$n危急中突然伏地翻滚而出，避过了这致命一击，已吓得脸色苍白！\n" NOR;
			message_vision(msg, me, target);
			message_vision(HIW "但$N飘身而起，使出峨嵋绝技「灭剑」心法，顿时剑意空灵飘逸，似万千柳絮飞舞，又如和风阵阵拂过。$n惊骇之下，顿时出招散乱，无从招架！\n" NOR, me, target);
		}
	}
	else
	{
		if (random(ap)>dp/3) 
		{
			damage = damage1/3 + random(damage1/3);
			damage = damage*(100-target->query_meridian())/100;
			target->receive_damage("jing", damage,me);
			target->receive_wound("jing", damage/2,me);
			msg = HIR"\n结果只听见几声喀喀轻响，一剑穿心,$n一声惨叫，像滩软泥般塌了下去！！\n"NOR;
			message_vision(msg, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage/2 +"，内伤为"+ damage +"。\n" NOR);
		}
		else
		{
			damage = damage1/2 + random(damage1);
			damage = damage*(100-target->query_meridian())/100;
			target->receive_damage("jing",damage,me);
			target->receive_wound("jing",damage/2,me);
			message_vision(HIW "但$N飘身而起，使出峨嵋绝技「灭剑」心法，顿时剑意空灵飘逸而，似万千柳絮飞舞，又如和风阵阵拂过。$n虽已加倍提防，但仍感攻势频频收挫。\n" NOR, me, target);
			msg = HIY"\n$n危急中突然伏地翻滚而出，避过了这致命一击，已吓得脸色苍白！\n" NOR;
			message_vision(msg, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage*2 +"，内伤为"+ damage +"。\n" NOR);
		}
		me->add("jingli", -1000);		
	}
}	
if((int)me->query_skill("huifeng-jian",1) > 3000 && (int)me->query_skill("jinding-zhang",1) > 3000 )
{
	msg = HIY "\n$N突然间全身骨骼中发出劈劈拍拍的轻微爆裂之声，炒豆般的响声未绝，右掌已向$n胸口击去。\n\n"NOR;
	msg += HIG"这一掌是峨嵋派的绝学，叫做“佛光普照”。这“佛光普照”的掌法便只一招，而且这\n";
	msg += HIG"一招也无其他变化，招式平平淡淡，一成不变，可是其威力之生，就在于以峨嵋派绝顶\n";
	msg += HIG"内功作为根基。一掌既出，内力如排山倒海一般袭来，敌人挡无可挡，避无可避。\n\n";
	message_vision(msg, me, target);
	if (me->query("jm/emei")) damage1 = me->query_skill("huifeng-jian",1)*me->query("int",1)*3/2 + me->query_skill("linji-zhuang",1)*me->query("con",1)*3/2 + me->query_skill("jinding-zhang",1)*me->query("per",1)*3/2 + me->query_skill("sword",1) + me->query_skill("force",1) + me->query_skill("unarmed",1) + me->query("jiali");
	else damage1 = me->query_skill("huifeng-jian",1)*me->query("int",1) + me->query_skill("linji-zhuang",1)*me->query("con",1) + me->query_skill("jinding-zhang",1)*me->query("per",1) + me->query_skill("sword",1) + me->query_skill("force",1) + me->query_skill("unarmed",1) + me->query("jiali");
	if( random(ap)>dp/2 )  
	{
		damage = damage1/3 + random(damage1/3) + target->query("jing")*5/100;
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("jing", damage,me);
		target->receive_wound("jing", damage/2,me);
		me->add("neili", -1000);		
		msg += HIR"猛听得砰然一声大响，$N已打中在$p胸口.\n"NOR;
		msg += RED"只听一声巨响，$n全身骨骼碎裂，竟被这排山倒海般的一击将身子打成了两截。\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else if( random(ap)>dp/3 ) 
	{
		damage = damage1/3 + random(damage1/3) + target->query("jing")*4/100;
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("jing", damage,me);
		target->receive_wound("jing", damage/3,me);
		me->add("jingli", -1000);		
		msg = HIY"$p眼看这一招来势汹汹，知道难于对付，连忙发力抵抗，猛听得砰然一声大响，$N已打中在$p胸口.\n"NOR;
		msg += RED"$n身子便如一捆稻草般，在空中平平的飞了出去，重重摔在地下，口中鲜血狂喷．\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/3 +"。\n" NOR);
	}
	else if( random(ap)>dp/4 ) 
	{
		damage = damage1/4 + random(damage1/4) + target->query("jing")*3/100;
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("jing", damage,  me);
		target->receive_wound("jing", damage/3, me);
		me->add("jingli", -1000);
		target->add( "neili", -damage );		
		msg = HIM"$p眼看这一招来势汹汹，慌忙使出本门身法，向侧跃出数丈，可是这佛光普照蕴藏峨眉内家上乘内功，\n"NOR;
		msg += "方圆数丈都被神功所震撼，$p只觉得后心一震，已被劈空掌力所伤.\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage/2 +"，内伤为"+ damage/3 +"。\n" NOR);
	}
	else
	{
		damage = damage1/5 + random(damage1/5);
		damage = damage*(100-target->query_meridian())/100;
		me->add("jingli", -500 );
		target->add( "neili", -damage );		
		msg = HIC"$n眼看这一招来势汹汹，使出本门身法，向後跃出数丈，\n\n"NOR;
		msg += HIW"$N这一招乃是使上了全力，丝毫不留余地。没想到全无用处，不觉脸如死灰，手掌微微发抖。\n" NOR;
		message_vision(msg, me, target);		
	}
}
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}