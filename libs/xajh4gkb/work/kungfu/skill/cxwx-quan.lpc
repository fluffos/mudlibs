int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练痴心妄想拳必须空手。\n");
    if (me->query("family/family_name")!="痴心妄想门")
		return notify_fail("你不是本门中人，无法领悟本门技能的精髓。\n");	
	if ((int)me->query_skill("wangran-xinfa", 1) < 100)
		return notify_fail("你的枉然心法不够，无法学习痴心妄想拳。\n");
	if ((int)me->query("max_neili") < 10000)
        return notify_fail("你的内力太弱，无法练痴心妄想拳。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int ap,dp,damage1,damage2,damage,liannum;
	ap = me->query("str",1) * me->query_skill("cxwx-quan", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query("int",1) * victim->query_skill("dodge", 1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	damage1 = (int)me->query_skill("cxwx-quan",1);
	damage2 = (int)me->query_skill("cxwx-quan",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if ( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
	if ( me->query_skill("wangran-xinfa",1) < 100 || me->query_skill("cxwx-quan",1) < 100) return 0;
//	if ( me->query_skill_mapped("force") != "wangran-xinfa") return 0;	
	if (objectp(me->query_temp("weapon"))) return 0;

	if( random(ap) > dp/3 && random(7)==1 && me->query("jiali")>0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100 );
		message_vision(HIR "只听到「"HIY""BLINK"砰"NOR""HIR"」的一声闷哼，$n"HIR"胸口深深的凹陷下去！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N白日做梦，梦中出拳，居然发挥出"+me->query("cognize")+HIG"的力量，$n闷哼一声吐出一口血。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/chixin") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIC "$N将痴心妄想门的精髓融入拳中，出招之际如梦一般空灵。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

mapping query_action(object me, object target, object weapon)
{
	if (random(me->query_skill("cxwx-quan",1)) > 399 && me->query("neili") > 300 && random(7)==0 )
	{
		me->add("neili", -150);
		return ([
			"action": ""HIG"忽然$N灵光闪现，双拳交叉乱舞，每一拳都出现在不可思议的位置。\n"
					"$n"HIG"顿时手忙脚乱，无数拳点落在身上，让$N一顿乱拳打的找不着北。\n"NOR,
			"attack":	300,
			"parry":	300,
			"dodge":	300,
			"damage":	300,
			"force":	300,
			"damage_type": "内伤"]);

		if (!target->is_busy()) target->start_busy(2);			
	}
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if (me->query("family/family_name")!="痴心妄想门")
		return notify_fail("你不是本门中人，无法练习本门技能的精髓。\n");
	if ((int)me->query("qi") < 40)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 10)
        return notify_fail("你的内力不够了！休息一下再练吧。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
        me->receive_damage("qi", 30);
        me->add("neili", -5);
        return 1;
}
string perform_action_file(string action)
{
	return __DIR__"cxwx-quan/" + action;
}
