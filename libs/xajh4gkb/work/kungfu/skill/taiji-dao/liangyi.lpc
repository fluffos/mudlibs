// tie@fengyun
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
	int extra,damage,damage1;
	int me_qi,me_jing,ob_qi,ob_jing;
	object weapon;
		
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「太极生两仪」只能对战斗中的对手使用。\n");
	if( me->is_busy() )
		return notify_fail("你正忙着呢！\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if( (int)me->query("max_neili") < 200000 )
		return notify_fail("你的内力修为不够！\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的内力不够！\n");
	if ((int)me->query("max_jingli")<100000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");		
    if((int)me->query_skill("taiji-shengong",1)<500)
        return notify_fail("你的太极神功不够深厚，不能使用「太极生两仪」。\n");	
	if((int)me->query_skill("taiji-dao",1) < 500)
		return notify_fail("你的「太极刀法」还不到家，无法使用「太极生两仪」！\n");
//	if ( !wizardp(me) && me->query_skill_mapped("force") != "taiji-shengong")
//		return notify_fail("不使用本门内功，如何使用本门绝学!\n"); 
//	if ( !wizardp(me) && me->query_skill_mapped("blade") != "taiji-dao")
//		return notify_fail("你没使用太极刀!\n"); 
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	extra = me->query_skill("taiji-dao",1)+me->query_skill("taiji-quan",1)+me->query_skill("taiji-shengong",1);
	weapon = me->query_temp("weapon");
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	message_vision(HIG"脚踏太极，右手持刀，动静由心，一张一弛，一阴一阳。" NOR, me, target);

	message_vision(HIR  "阳极！\n\n"HIY"天地不仁，以万物为刍狗，是故损不足而奉有余。" NOR, me, target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1);
	if (me->query("qi") < target->query("qi")) 
	{
		damage = extra/2 + random(extra/2);
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("qi",damage,me);	
		target->receive_wound("qi",damage/2,me);
		message_vision(HIW"阴阳之侯烈，变化之由表，死生之兆章。故有余而补不足。" NOR, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);	
	}
	else
	{
		damage = extra/2 + random(extra/2);
		damage = damage*(100-me->query_meridian())/100;
		me->receive_damage("qi",damage,target);
		me->receive_wound("qi",damage/2,target);
		message_vision(HIW"天将降大任于斯人也，故苦其心志，劳其筋骨，饿其体肤。" NOR, target, me, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);	
	}
if((int)me->query_skill("taiji-dao",1) > 1500)
{	
	message_vision(HIR  "阴极！\n\n"HIY"圣人不仁，以百姓为刍狗，是故同天地常在。" NOR, me, target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1);
	if (me->query("jing") < target->query("jing")) 
	{
		damage = extra/2 + random(extra/2);
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("jing",damage,me);	
		target->receive_wound("jing",damage/2,me);
		message_vision(HIW"天公在上，土伯在下，翻手为云，覆手为雨，一刀分之！" NOR, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);	
	}
	else
	{
		damage = extra/2 + random(extra/2);
		damage = damage*(100-me->query_meridian())/100;
		me->receive_damage("jing",damage,target);
		me->receive_wound("jing",damage/2,target);
		message_vision(HIW"阴阳反转，乾坤颠倒！" NOR, target, me, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);	
	}	
}	
if((int)me->query_skill("taiji-dao",1) > 3000)
{
	message_vision(HIR  "两仪！\n\n"HIY"是故圣人不出，天地大乱。无极化太极，太极生两仪，而人道自立。" NOR, me, target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1);
	me_qi = me->query("max_qi") - me->query("qi");
	me_jing = me->query("max_jing") - me->query("jing");
	ob_qi = target->query("max_qi") - target->query("qi");
	ob_jing = target->query("max_jing") - target->query("jing");
	if (me_qi < 1) me_qi = 1;
	if (me_jing < 1) me_jing = 1;
	if (ob_qi < 1) ob_qi = 1;
	if (ob_jing < 1) ob_jing = 1;
	if ( me_qi > ob_qi )
	{
		damage1 = me_qi - ob_qi;
		damage1 = damage1/5 + random(damage1/5);
		damage1 = damage1*(100-target->query_meridian())/100;
		me->add("qi",damage1);
		target->receive_damage("qi",damage1,me);	
		target->receive_wound("qi",damage1/2,me);	
		message_vision(HIC"他强由他强，清风拂山岗。" NOR, me, target, damage1, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage1 +"，内伤为"+ damage1/2 +"，恢复自己气血"+ damage1 +"。\n" NOR);				
	}
	else if ( me_qi < ob_qi )
	{
		damage1 = ob_qi - me_qi;
		damage1 = damage1/5 + random(damage1/5);
		damage1 = damage1*(100-me->query_meridian())/100;
		target->add("qi",damage1);
		me->receive_damage("qi",damage1,target);	
		me->receive_wound("qi",damage1,target);	
		message_vision(HIW"损有余而补不足！" NOR, target, me, damage1, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage1 +"，内伤为"+ damage1/2 +"，恢复敌人气血"+ damage1 +"。\n" NOR);	
	}
	else
	{
		me->add("qi",me_qi/3);
		target->add("qi",ob_qi/3);
		message_vision(HIM  "\n"HIY"圣人出，而天道立，普渡众生。" NOR, me, target);
	}

	if ( me_jing > ob_jing )
	{
		damage1 = me_jing - ob_jing;
		damage1 = damage1/5 + random(damage1/5);
		damage1 = damage1*(100-target->query_meridian())/100;
		me->add("jing",damage1);
		target->receive_damage("jing",damage1,me);	
		target->receive_wound("jing",damage1/2,me);	
		message_vision(HIW"圣人，让精气回流，循环于三脉七轮，解脱生死轮回。" NOR, me, target, damage1, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage1 +"，内伤为"+ damage1/2 +"，恢复自己气血"+ damage1 +"。\n" NOR);				
	}
	else if ( me_jing < ob_jing )
	{
		damage1 = ob_jing - me_jing;
		damage1 = damage1/5 + random(damage1/5);
		damage1 = damage1*(100-me->query_meridian())/100;
		target->add("jing",damage1);
		me->receive_damage("jing",damage1,target);	
		me->receive_wound("jing",damage1/2,target);	
		message_vision(HIW"凡夫让精气外泄，轮回与生死。" NOR, target, me, damage1, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage1 +"，内伤为"+ damage1/2 +"，恢复敌人气血"+ damage1 +"。\n" NOR);	
	}
	else
	{
		me->add("jing",me_jing/3);
		target->add("jing",ob_jing/3);
		message_vision(HIM  "\n"HIY"圣人出，而人道立，普渡众生。" NOR, me, target);	
	}	
}
	me->add("neili",-500);
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}