int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

string query_parry_msg(string limb) {
  return parry_msg[random(sizeof(parry_msg))];
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me) {
  return notify_fail("乾坤大挪移只能通过读 <乾坤大挪移心法>提高。\n");
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "明教")
    return notify_fail("凡练成乾坤大挪移第七层心法必然是我明教中人。。。。\n");
  if ((int)me->query_skill("qiankundanuoyi", 1) < 250)
    return notify_fail("乾坤大挪移只能通过读<<乾坤大挪移>>心法提高。\n");
  if (!me->query("jm/shashou"))
    return notify_fail(CYN "我明教替朱家打的天下，到头来飞鸟尽、良弓藏！这朱洪武视我明教如洪水猛兽，居然成立杀手楼来暗杀我教高手！\n" CYN "这位" + RANK_D->query_respect(me) + CYN "欲扬我明教威名，需得查明杀手楼的秘密！\n" NOR);
  if ((int)me->query("family_score") < 7)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  return 1;
}


string perform_action_file(string action) {
  return __DIR__ "qiankundanuoyi/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int ap, dp, j, damage1, damage2, damage3;

  ap = me->query_skill(
    "qiankundanuoyi",
    1
  ) * me->query(
    "dex",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "dodge",
    1
  ) * ob->query(
    "str",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = me->query_skill("qiankundanuoyi", 1);
  damage2 = me->query_skill(
    "qiankundanuoyi",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  damage3 = (me->query("max_qi") - me->query("eff_qi")) / 5;
  if (damage3 < 10) damage3 = 10;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if ((me->query_skill(
    "shenghuo-shengong",
    1
  ) < 300 && me->query_skill(
    "jiuyang-shengong",
    1
  ) < 300) || me->query_skill("qiankundanuoyi", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force")!="shenghuo-shengong" && me->query_skill_mapped("force")!="jiuyang-shengong") return damage;

  if (me->is_busy() && random(6) == 0 && me->query_skill_mapped("force") == "jiuyang-shengong") {
    me->add("neili", -100);
    me->start_busy(1);
    j = -(damage / 2 + random(damage / 2));
    message_vision(HIY "$N以九阳神功为根基，催动乾坤大挪移心法，似乎淤塞的穴道被挪开了！\n" NOR, me, ob);
    return j;
  }
  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = HIB "$N运起乾坤大挪移心法，周身内劲流转，将$n的内劲反弹回去！\n" NOR;
    me->add("neili", -100);
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    message_vision(msg, me, ob, damage1, HBWHT + HIY "气血反伤" NOR);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    if (!ob->is_busy()) ob->start_busy(1);
    message_vision(
      HIC "$N顿悟" + me->query("cognize") + HIC "，突然间大喝一声，将所积蓄的十余掌的力道归并成为一掌迅急拍向$n。便如一座大湖在山洪爆发时储满了洪水，猛地里湖堤崩决，洪水急冲而出！\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/mingjiao")) {
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    if (!ob->is_busy()) ob->start_busy(1);
    message_vision(
      HIB "$N融汇明教武学精髓，$N将乾坤大挪移第七层心法施展出来，顿将先前所积蓄的十余道力量归并为一掌，朝$n" HIM "疾拍而出，只听$n一声惨叫，将$N返回的力道受了个十足，全身喀嚓喀嚓一阵脆响，腕骨、臂骨、肩骨、肋骨竟然一齐折断！\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
  if (random(8) == 4 && random(ap) > dp / 4) {
    msg = HIB "$N运转乾坤大挪移，将之前受到的伤势积累起来！待乾坤大挪移运行七周天，顿时将积累的伤势如洪水决堤般使将出来，$n当场成为一团血肉模糊，惨不可言。\n" NOR;
    if (!ob->is_busy()) ob->start_busy(1);
    me->add("neili", -100);
    j = -(damage / 3 + random(damage / 3));
    me->add("eff_qi", damage3);
    me->add("qi", damage3);
    if (me->query("eff_qi") > me->query("max_qi")) me->set("eff_qi", me->query("max_qi"));
    if (me->query("qi") > me->query("eff_qi")) me->set("qi", me->query("eff_qi"));
    ob->receive_damage("qi", damage3, me);
    ob->receive_wound("qi", damage3 / 2, me);
    message_vision(msg, me, ob, damage3, HBWHT + HIY "气血反伤" NOR);
    return j;
  }
}
