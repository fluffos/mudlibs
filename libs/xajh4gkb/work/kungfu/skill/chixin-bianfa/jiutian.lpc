// This program is a part of NT MudLIB
// jiutian.c  凤舞九天

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;

string name() {
  return "凤舞九天";
}

int perform(object me, object target) {
  object weapon, weapon1;
  int extra, damage;
  int ap, dp;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail(HIW "「凤舞九天」只能在战斗中使用。\n" NOR);
  if (me->query_skill_mapped("force") != "wangran-xinfa")
    return notify_fail(HIW "你所用得内功心法不对，无法跃起身形。\n" NOR);
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || weapon->query("skill_type") != "whip")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query_skill("wangran-xinfa", 1) < 1000)
    return notify_fail(HIW "你的内功修为未到，无法施展「凤舞九天」。\n" NOR);
  if ((int)me->query_skill("chixin-bianfa", 1) < 1000)
    return notify_fail(HIW "你的痴心鞭法修为还不够，尚未领悟到「凤舞九天」。\n" NOR);
  if ((int)me->query_skill("shuiyue", 1) < 1000)
    return notify_fail(HIW "你的镜花水月步修为还不够，尚未领悟到「凤舞九天」。\n" NOR);
  if (me->query("max_jingli") < 1000000)
    return notify_fail(HIW "你的内力修为不足，劲力不足以施展「凤舞九天」！\n" NOR);
  if (me->query_skill_mapped("whip") != "chixin-bianfa")
    return notify_fail("你必须激发该技能！\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的真气不够。\n");
  if (me->query("jingli") < 10000)
    return notify_fail(HIW "你现在内力不够，劲力不足以施展「凤舞九天」！\n" NOR);
  if (!(int)me->query("breakup"))
    return notify_fail("你任督二脉未通,无法使用「凤舞九天」。\n" NOR);
  if (target && !living(target))
    return notify_fail(HIW "对方都已经这样了，还舞给谁看啊！\n" NOR);
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  message_vision(HBWHT "$N贯通痴心武学，使出了痴心门的绝学之精髓！\n" NOR, me, target);
  message_vision(HIM "$N双臂展开，腾空而起，大喝一声【凤舞九天】！！！\n" NOR, me);
  message_vision(
    MAG "$N向后纵身一跃，翩翩起舞，手中的" NOR + weapon->name() + NOR + MAG "响起阵阵凤鸣，舞姿奇诡莫测，变化无端，宛如凤凰一般刹是好看。\n\n" NOR,
    me,
    target
  );
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1	

  /*	if (me->query("family/family_name") == "痴心妄想门")	//非本门派弟子使用本门技能，则技能效果削一半
	{
		ap = me->query("xyzx_sys/level") + me->query_skill("chixin-bianfa", 1) + me->query_skill("whip") + me->query_skill("force");
	}
	else
	{
		ap = me->query("xyzx_sys/level") + (me->query_skill("chixin-bianfa", 1) + me->query_skill("whip") + me->query_skill("force"))/2;
	}*/
  extra = (int)me->query_skill("chixin-bianfa", 1) / 10;
  damage = me->query_skill(
    "chixin-bianfa",
    1
  ) + me->query_skill("shuiyue", 1) + (int)me->query_skill("wangran-xinfa", 1);
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "chixin-bianfa",
    1
  ) + me->query_skill("shuiyue", 1) + me->query_skill("whip") + me->query_skill("dodge");
  dp = target->query("xyzx_sys/level") + target->query_skill("force") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  message_vision(HIR "突然$n一个失神，被$N的动作所吸引，顿感心旷神怡，心猿意马，被$N的舞姿迷的神魂颠倒！\n\n" NOR, me, target);
  me->add("jingli", -200);

  if (random(ap) > dp / 3) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    damage = damage / 3 + random(damage / 3);
    damage = damage * (100 - target->query_meridian()) / 100;
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 3, me);
    me->add("jingli", -1000);
    //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/3 +"。\n" NOR);
    message_vision(
      HIR "$N舞步轻盈灵巧，" HIB "动作如凤凰展翅，" HIM "如同一只蜻蜓点在你的心田！\n" NOR,
      me,
      target,
      damage,
      HBWHT + HIM "气血伤害" NOR
    );  //2018.10.2阿飞改，优化化学伤害显示的写法
  } else {
    message_vision(CYN "可$n似心有灵犀，一指点出，" HIW "$N眉头微皱，只觉得$n这一指无从招架。\n" NOR, me, target);
    me->add("jingli", -200);
  }

  if (target->query_temp("weapon")) {
    weapon1 = target->query_temp("weapon");
    if (random(ap) > dp / 3) {
      me->add("jingli", -200);
      message_vision(HIW "$n手指一松，" NOR + weapon1->name() + NOR HIW "险些脱手！\n" NOR, me, target);
    } else {
      message_vision(HIW "$n手上一松，不由自主的丢下了" NOR + weapon1->name() + NOR HIW "！\n" NOR, me, target);
      me->add("jingli", -500);
      weapon1->unequip();
      weapon1->move(environment(target));
      //				target->reset_action();
      target->apply_condition("no_equip", 20);
    }
  }

  if ((int)me->query_skill(
    "chixin-bianfa",
    1
  ) > 2000 && (int)me->query_skill("shuiyue", 1) > 2000) {
    damage = me->query_skill(
      "chixin-bianfa",
      1
    ) + me->query_skill("shuiyue", 1) + (int)me->query_skill("wangran-xinfa", 1);
    damage = damage / 3 + random(damage / 3);
    damage = damage * (100 - target->query_meridian()) / 100;
    if (random(ap) > dp / 3) {
      me->add("jingli", -1000);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 3, me);
      message_vision(
        HIR "仿佛兮若轻云之蔽月，$N" HIB "飘飘兮若流风之回雪，" HIM "无颜者伤人，有情者自伤！\n" NOR,
        me,
        target,
        damage,
        HBWHT + HIM "气血伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法		
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/3 +"。\n" NOR);
      me->add_temp("apply/attack", extra);
      me->add_temp("apply/damage", extra);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      me->add_temp("apply/attack", -extra);
      me->add_temp("apply/damage", -extra);
    } else {
      if (me->query("jm/chixin")) {
        target->receive_damage("jing", damage, me);
        target->receive_wound("jing", damage / 3, me);
        message_vision(
          YEL "月上柳梢头............人约黄昏后。\n" NOR,
          me,
          target,
          damage,
          HBWHT + HIM "精神伤害" NOR
        );  //2018.10.2阿飞改，优化化学伤害显示的写法
        //				if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/3 +"。\n" NOR);
      }
      message_vision(CYN "可$n看破你的企图" HIR "大喝一声：任你强横霸道，我自岿然不动。\n" NOR, me, target);
      me->add("jingli", -500);
    }
  }


  if ((int)me->query_skill(
    "chixin-bianfa",
    1
  ) > 3000 && (int)me->query_skill("shuiyue", 1) > 3000) {
    if (me->query("jm/chixin"))
      damage = me->query_skill(
        "chixin-bianfa",
        1
      ) * me->query(
        "int",
        1
      ) / 30 + me->query_skill(
        "shuiyue",
        1
      ) * me->query(
        "dex",
        1
      ) / 30 + me->query_skill(
        "dodge",
        1
      ) + me->query_skill(
        "wangran-xinfa",
        1
      ) * me->query("per", 1) / 20 + me->query_skill("whip", 1);
    else damage = me->query_skill(
      "chixin-bianfa",
      1
    ) * me->query(
      "int",
      1
    ) / 50 + me->query_skill(
      "shuiyue",
      1
    ) * me->query(
      "dex",
      1
    ) / 50 + me->query_skill(
      "dodge",
      1
    ) + me->query_skill("wangran-xinfa", 1) * me->query("per", 1) / 50 + me->query_skill("whip", 1);
    damage = damage / 5 + random(damage / 5);
    damage = damage * (100 - target->query_meridian()) / 100;
    if (random(ap) > dp / 3) {
      message_vision(HIR "凤舞天下惊，席卷万里，$N" HIB "一朝云起时，舞破苍穹。\n" NOR, me, target);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 3, me);
      message_vision(
        HIC "疑是银河落九天！" RED "凤舞，鞭影，人翩跹！" HIM "龙腾，云散，入黄泉！ \n" NOR,
        me,
        target,
        damage,
        HBWHT + HIM "气血伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法			
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/3 +"。\n" NOR);
      target->apply_condition("no_force", 20);
      target->apply_condition("no_enforce", 20);
      target->set("jiali", 0);
      target->set("jiajing", 0);
      me->add("jingli", -1000);
      me->add_temp("apply/attack", extra);
      me->add_temp("apply/damage", extra);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      me->add_temp("apply/attack", -extra);
      me->add_temp("apply/damage", -extra);
    } else {
      if (me->query("jm/chixin")) {
        target->receive_damage("jing", damage, me);
        target->receive_wound("jing", damage / 3, me);
        message_vision(
          YEL "月上柳梢头............人约黄昏后。\n" NOR,
          me,
          target,
          damage,
          HBWHT + HIM "精神伤害" NOR
        );  //2018.10.2阿飞改，优化化学伤害显示的写法
        //				if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/3 +"。\n" NOR);
      }
      message_vision(CYN "$n大笑起来：移山倒海，游龙戏凤！------小道尔！！！\n" NOR, me, target);
      me->add("jingli", -500);
    }
  }



  if ((int)me->query_skill(
    "chixin-bianfa",
    1
  ) > 4000 && (int)me->query_skill("shuiyue", 1) > 4000) {
    if (me->query("jm/chixin"))
      damage = me->query_skill(
        "chixin-bianfa",
        1
      ) * me->query(
        "int",
        1
      ) * 3 / 20 + me->query_skill(
        "shuiyue",
        1
      ) * me->query(
        "dex",
        1
      ) * 3 / 20 + me->query_skill(
        "wangran-xinfa",
        1
      ) * me->query(
        "per",
        1
      ) * 3 / 20 + me->query_skill(
        "whip",
        1
      ) + me->query_skill("force", 1) + me->query_skill("dodge", 1);
    else damage = me->query_skill(
      "chixin-bianfa",
      1
    ) * me->query(
      "int",
      1
    ) / 10 + me->query_skill(
      "shuiyue",
      1
    ) * me->query(
      "dex",
      1
    ) / 10 + me->query_skill(
      "wangran-xinfa",
      1
    ) * me->query(
      "per",
      1
    ) / 10 + me->query_skill("whip", 1) + me->query_skill("force", 1) + me->query_skill("dodge", 1);
    damage = damage / 3 + random(damage / 3) + target->query("qi") * 1 / 100;
    damage = damage * (100 - target->query_meridian()) / 100;
    if (random(ap) > dp / 3) {
      message_vision(HIR "    北 方 有 佳 人 ！ \n" NOR, me, target);
      message_vision(HIB "        绝 而 独 立 ！ \n" NOR, me, target);
      message_vision(HIY "            一 顾 倾 人 城 ！ \n" NOR, me, target);
      message_vision(HIC "                再 顾 倾 人 国 ！ \n" NOR, me, target);
      message_vision(HIG "                    宁不知 倾城 与 倾国！  \n" NOR, me, target);
      message_vision(HIM "                        佳 人 难 再 得！ \n" NOR, me, target);

      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      message_vision(YEL "情到深处有情殇。\n" NOR, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
      target->apply_condition("no_perform", 20);
      me->add("jingli", -2000);
      me->add_temp("apply/attack", extra);
      me->add_temp("apply/damage", extra);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      me->add_temp("apply/attack", -extra);
      me->add_temp("apply/damage", -extra);
    } else {
      if (me->query("jm/chixin")) {
        damage = me->query_skill(
          "chixin-bianfa",
          1
        ) * me->query(
          "int",
          1
        ) / 30 + me->query_skill(
          "shuiyue",
          1
        ) * me->query(
          "dex",
          1
        ) / 30 + (int)me->query_skill(
          "wangran-xinfa",
          1
        ) * me->query("per", 1) / 30 + me->query_skill("whip", 1);
        damage = damage / 5 + random(damage / 5);
        damage = damage * (100 - target->query_meridian()) / 100;
        target->receive_damage("jing", damage, me);
        target->receive_wound("jing", damage / 3, me);
        //				if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/3 +"。\n" NOR);
        message_vision(
          YEL "月上柳梢头............人约黄昏后。\n" NOR,
          me,
          target,
          damage,
          HBWHT + HIM "精神伤害" NOR
        );  //2018.10.2阿飞改，优化化学伤害显示的写法
      }
      message_vision(RED "就看$n收敛心神，心如明镜，全神贯注，并未被$N的舞姿所迷。\n" NOR, me, target);
      me->add("jingli", -1000);
    }
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
