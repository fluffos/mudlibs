int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  //	if ( me->query("gender") != "女性")
  //		return notify_fail("相传移风剑法乃女娲所创,从无男子练习!\n");
  if ((int)me->query("per", 1) < 25)
    return notify_fail("我移花宫俱是英俊美貌之人，怎么能教你这种污浊之人功夫呢。\n");
  if (me->query("family/family_name") != "移花宫")
    return notify_fail("你不是移花宫弟子，无法学习。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("mingyu-shengong", 1) < 100)
    return notify_fail("你的冥雨神功火候太浅。\n");
  if ((int)me->query_skill("yifeng-jian", 1) >= (int)me->query_skill("sword", 1))
    return notify_fail("你的基础不够.\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon;
  weapon = me->query_temp("weapon");
  ap = me->query_skill(
    "yifeng-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("yifeng-jian", 1);
  damage2 = (int)me->query_skill(
    "yifeng-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "mingyu-shengong",
    1
  ) < 100 || me->query_skill("yifeng-jian", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "mingyu-shengong") return 0;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return 0;

  if (random(7) == 0 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      RED "$N的移风剑法已初有小成,每出一剑都带着强烈" HIR "剑气" HIW "扑向$n！！！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      WHT "$N剑带魅影，移风剑法的精髓在无形中表露无遗，登时$n全身血液顿时沸腾！！！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，灵台光闪，瞬间领悟到移风剑法精髓，随手一剑妙到毫颠！！！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/yihua")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIM "$N融会移花宫武学精髓，达到人剑合一的境界，随手数道剑气分刺$n数处大穴！！！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(7) == 4 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      CYN "$N的移风剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}


/*	//2017.12.31阿飞改，移风剑改成正常自练方式
int practice_skill(object me)
{
    return notify_fail("移风剑法只能通过「"+HIC+"舞字决"+NOR+"」来演练。\n");
}
*/
int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("jingli") < 1000 || (int)me->query("neili") < 1000)
    return notify_fail("你的内力或精力不够，没有办法练习移风剑法！\n");
  if (me->query("family/family_name") != "移花宫")
    return notify_fail("你还是先入了日月神教再来练习。\n");
  if ((int)me->query_skill("yifeng-jian", 1) < 200)
    return notify_fail("你对移风剑理解不够透彻！\n");
  if ((int)me->query_skill("yifeng-jian", 1) > (int)me->query_skill("sword", 1))
    return notify_fail("你的剑法不够精湛！\n");
  if ((int)me->query_skill("mingyu-shengong", 1) < 200)
    return notify_fail("你对冥雨神功不了解，如何能练的了移风剑！\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->add("neili", -100);
  me->add("jingli", -100);
  write("你按著所学练了一遍移风剑。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yifeng-jian/" + action;
}
