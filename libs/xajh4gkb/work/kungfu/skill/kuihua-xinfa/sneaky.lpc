// kuihua-xinfa (protect)
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
void remove_effect(object me, int amount);
int exert(object me, object target)
{
    int skill;
	
    if( target != me ) 
        return notify_fail("葵花心法只能对自己使用。\n");
    if( (int)me->query("neili") < 1000  ) 
        return notify_fail("你的内力不够。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够了。\n");	
    if( (int)me->query("max_neili") < 100000  ) 
        return notify_fail("你的内力修为不足。\n");
	if( (int)me->query("max_jingli") < 100000 )
		return notify_fail("你的精力修为不足。\n");
    if ((int)me->query_temp("apply/shade_vision"))
        return notify_fail("你已经在葵花隐身中了。\n");
	if ( me->query_temp("powerup") )
		return notify_fail("你已经在运内功护体中了。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if ( me->query_skill_mapped("force") != "kuihua-xinfa")
		return notify_fail(HIC"不使用本门内功，如何使用本门绝学!\n"NOR);
	if ( (string)me->query("gender")=="女性" )
		return notify_fail("自古就没有女子可以使用.\n");
	if ( (string)me->query("gender")=="男性" )
		return notify_fail("欲练神功，必先自宫，欲使神功，快快进宫.\n");
	if ( (string)me->query("genderbak")=="男性" )
		return notify_fail("你个假太监，赶紧去割了.\n");	
	if (me->query_skill("kuihua-xinfa",1)<500) 
		return notify_fail("你的葵花心法还不够娴熟。\n");
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用「葵花心法]隐身。\n"NOR); 
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
    skill = (int)me->query_skill("kuihua-xinfa", 1)/15+(int)me->query_skill("force", 1)/40;
    message_vision( HIW "$N微一凝神，运起葵花心法，整个人如同被烟雾笼罩一般，漂忽不定，鬼魅至极。\n" NOR, me);
    me->add("neili",-100);
	me->add("jingli",-100);
	me->add_temp("apply/dexerity", skill*15/10);
	me->add_temp("apply/intelligence", skill*8/10);
	me->add_temp("apply/damage",skill*12/10);
	me->add_temp("apply/dodge",skill*10);
	me->add_temp("apply/attack", skill*7);
	me->add_temp("apply/sword",skill*10);
	me->add_temp("apply/armor", skill*8);
	me->set_temp("apply/shade_vision",1);
	me->set_temp("powerup", 1);
    me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill :), skill);
	me->start_busy(1);
    return 1;
}
void remove_effect(object me, int amount)
{
    if (!me) return;
	if ( (int)me->query_temp("powerup") )
	{
		me->add_temp("apply/dexerity", -amount*15/10);
		me->add_temp("apply/intelligence", -amount*8/10);
		me->add_temp("apply/damage",-amount*12/10);
		me->add_temp("apply/dodge",-amount*10);
		me->add_temp("apply/attack", -amount*7);		
		me->add_temp("apply/sword",-amount*10);
		me->add_temp("apply/armor", -amount*8);
		me->delete_temp("apply/shade_vision");
		me->delete_temp("powerup");
		tell_object(me, HIG"你的葵花心法运行完毕，全身忽的一顿，现出整个身形。\n"NOR);
	}
}
