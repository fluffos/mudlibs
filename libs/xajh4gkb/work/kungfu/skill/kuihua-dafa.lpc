mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

string perform_action_file(string action) {
  return __DIR__ "kuihua-dafa/" + action;
}

int query_effect_parry(object attacker, object me) {
  int lvl;
  if (!objectp(me->query_temp("weapon")))
    return 0;

  lvl = me->query_skill("kuihua-dafa", 1);
  if (lvl < 80) return 0;
  if (lvl < 200) return 50;
  if (lvl < 280) return 80;
  if (lvl < 350) return 100;
  return 120;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  object weapon;
  string name;
  int ap, dp, damage1, damage2, damage, liannum;

  weapon = me->query_temp("weapon");
  ap = (int)me->query(
    "xyzx_sys/level",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = (int)victim->query(
    "xyzx_sys/level",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("kuihua-dafa", 1);
  damage2 = (int)me->query_skill(
    "kuihua-dafa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("jingli") < 100 || me->query("neili") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("kuihua-xinfa", 1) < 100 || me->query_skill("kuihua-dafa", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "kuihua-xinfa") return 0;

  if (objectp(weapon = me->query_temp("weapon")))
    name = "手中" + weapon->name();
  else
    name = "双掌";

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIW "霎时间只见$N" HIW "身子猛摆，顿时化分为无数身影，" + name + HIW "宛若流星般分从不同的方位同时刺向$n" HIW "！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，阴阴一笑，" + name + HIG "犹如生了眼睛一般，紧贴着$n而来，$n顿时飞出一道血箭。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/riyue")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIR "只听「嗤」一声，一缕血丝从$n被刺的针孔处喷出！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }

}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  object weapon;
  int j, ap, dp, damage1, damage2, maxnei;
  weapon = me->query_temp("weapon");
  ap = (int)me->query(
    "xyzx_sys/level",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = (int)ob->query(
    "xyzx_sys/level",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("kuihua-dafa", 1);
  damage2 = (int)me->query_skill(
    "kuihua-dafa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  maxnei = (int)me->query("max_neili");
  if (me->query("jm/riyue")) maxnei = (int)me->query("max_neili") * 2;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "kuihua-xinfa",
    1
  ) < 100 || me->query_skill("kuihua-dafa", 1) < 100) return damage;
  //	if ( me->query_skill_mapped("force") != "kuihua-xinfa") return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    me->add("neili", -100);
    j = -(damage + random(damage));
    if (me->query("neili") < maxnei) me->add("neili", damage1);
    if (ob->query("neili") > damage1) ob->add("neili", -damage1);
    message_vision(HIC "$N" HIC "一声冷笑！吸星大法！！！" HIC "$n" HIC "全身功力如流水般源源不绝地吸入$N的身体！\n" NOR, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage + random(damage));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIW "$N顿悟" + me->query("cognize") + HIW "，$n" HIW "眼睛一花，$N" HIW "已没了踪影。突然$N" HIW "从身后拍了一下$n" HIW "的头，轻轻跃开。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/riyue")) {
    j = -(damage / 3 + random(damage / 3));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    message_vision(
      HIW "$N融会日月神教武学精髓，身形突然加快，$n" HIW "眼前一花，似乎见到$N" HIW "身形一晃，但随即又见$N" HIW "回到原地，却似从未离开。\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 4) {
    j = -(damage / 3 + random(damage / 3));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    message_vision(
      HIW "$N" HIW "尖啸一声，忽然身子一转已不见了踪影，$n只觉耳边风声不断，但随即又见$N" HIW "回到了原地。\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 5) {
    j = -(damage / 3 + random(damage / 3));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    if (!ob->is_busy()) ob->start_busy(1);
    message_vision(
      HIW "忽然间，只见$N" HIW "腰枝一摆，顿时出现无数个$N" HIW "的影子，$n" HIW "却无法辨别出$N" HIW "的方位。\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
}

