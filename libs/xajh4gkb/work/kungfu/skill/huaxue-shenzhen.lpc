int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "血河派")
    return notify_fail("你未加入血河派，无法学习本门技能。\n");
  if (!me->query("jm/xuantian"))
    return notify_fail(CYN "我血河派第十一代掌门欧阳驼于六十年前失踪，江湖上流传的摧心掌似乎与我派有关。\n" CYN "这位" + RANK_D->query_respect(me) + CYN "可否先为我派去玄天派探听其秘密，将来必有回报。\n" NOR);
  if ((int)me->query("family_score") < 8)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if (me->query_skill("throwing", 1) <= me->query_skill("huaxue-shenzhen", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧！\n");
  if ((int)me->query_skill("yiqiguan-riyue", 1) < 100)
    return notify_fail("你的一气贯日月火候太浅。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  object ob;

  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 50 || (int)me->query("neili") < 35)
    return notify_fail("你的内力或气不够，没有办法练习化血神针。\n");
  if (me->query("family/family_name") != "血河派")
    return notify_fail("你未加入血河派，无法练习本门技能。\n");
  if (!me->query("jm/xuantian"))
    return notify_fail(CYN "我血河派第十一代掌门欧阳驼于六十年前失踪，江湖上流传的摧心掌似乎与我派有关。\n" CYN "这位" + RANK_D->query_respect(me) + CYN "可否先为我派去玄天派探听其秘密，将来必有回报。\n" NOR);
  if ((int)me->query("family_score") < 8)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if (!objectp(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "throwing")
    if (!objectp(ob = me->query_temp("secondary_weapon")) || (string)ob->query("skill_type") != "throwing")
      return notify_fail("你装备的武器不对。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -20);
  me->add_temp("pratice_throwing", 1);
  if (me->query_temp("pratice_throwing") > me->query_skill("huaxue-shenzhen", 1) / 20) {
    if ((int)ob->query_amount() == 1) {
      ob->unequip();
      tell_object(me, BOLD "\n你的" + ob->query("name") + "用完了！\n\n" + NOR);
    }
    ob->add_amount(-1);
    me->delete_temp("pratice_throwing");
  }
  write("你按著所学练了一遍化血神针。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "huaxue-shenzhen/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  object weapon;
  int ap, dp, damage1, damage2, damage, liannum;
  int flag = 1;
  weapon = me->query_temp("weapon");
  ap = (int)me->query(
    "con",
    1
  ) * (int)me->query_skill(
    "huaxue-shenzhen",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = (int)victim->query(
    "dex",
    1
  ) * (int)me->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("huaxue-shenzhen", 1);
  damage2 = (int)me->query_skill(
    "huaxue-shenzhen",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing") return 0;
  if ((me->query_skill(
    "huaxue-dafa",
    1
  ) < 200 && me->query_skill(
    "yiqiguan-riyue",
    1
  ) < 200 && me->query_skill(
    "longmen-shengong",
    1
  ) < 100) || me->query_skill("huaxue-shenzhen", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "huaxue-dafa" && me->query_skill_mapped("force") != "yiqiguan-riyue" && me->query_skill_mapped("force") != "longmen-shengong") return 0;

  if (me->query_skill_mapped("force") == "longmen-shengong") flag = 2;
  if (me->query_skill_mapped("force") == "huaxue-dafa") flag = 3;
  if (me->query_skill_mapped("force") == "yiqiguan-riyue") flag = 1;
  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 * flag + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_wound("qi", damage, me);
    victim->receive_damage("qi", damage / 3, me);
    victim->apply_condition("wuxing_poison", 10 * flag);
    message_vision(
      HIY "$N屈指一弹，一道血丝飞出。$n感觉似被蚊子咬了一下，不一会，感觉浑身热血沸腾！。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 * flag + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIB "$N衣袖一挥，" + me->query("cognize") + HIB "力量化作一根飞针，射向$n。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/xuehe")) {
    damage = ((damage1 * flag + damage2 * flag) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->add("neili", -damage);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIC "$N领悟血河派武学精髓，内力灌注在" + weapon->name() + HIC "上，$n甫一接触就被化掉了不少气血。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}


