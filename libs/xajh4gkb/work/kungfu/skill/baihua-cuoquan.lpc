int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "benlei-shou"; }		//互备技能
string skill_pinji() { return "中乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "中立"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "红花会"; }    //门派区分：门派，江湖
string skill_yinyang() { return "中性"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "正派"; }   //阵营区分：正派、邪派、中立、通用
int damage_damage() { return 45; }  //外伤系数
int force_damage() { return 56; }  //内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练百花错拳必须空手。\n");
  if (me->query("family/family_name") != "红花会")
    return notify_fail("你不是本门中人，无法学习本门技能。\n");
  if ((int)me->query_skill("honghua-shengong", 1) < 100)
    return notify_fail("你的红花神功火候不够，无法学百花拳。\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力太弱，无法练百花错拳。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "红花会")
    return notify_fail("你不是本门中人，如何学到本门高深技能，我要告诉掌门去。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练百花错拳必须空手。\n");
  if ((int)me->query_skill("honghua-shengong", 1) < 100)
    return notify_fail("你的红花神功火候不够，无法练百花拳。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 50)
    return notify_fail("你的内力不够练百花拳。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 35);
  me->add("neili", -20);
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"])
      return action[i - 1]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

string perform_action_file(string action) {
  return __DIR__ "baihua-cuoquan/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage1, damage2, damage, liannum;
  ap = (int)me->query_skill(
    "baihua-cuoquan",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "unarmed",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("baihua-cuoquan", 1);
  damage2 = (int)me->query_skill(
    "baihua-cuoquan",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "honghua-shengong",
    1
  ) < 100 || me->query_skill("baihua-cuoquan", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "honghua-shengong") return 0;
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIY "$N稳扎马步，吐气开声 双拳锤向$n几处大穴！$n吐出一口鲜血！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIR "$N顿悟" + me->query("cognize") + HIR "，$n一招攻入$N破绽，哪知$N这一招只是虚招，随即被$N击中。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/honghua")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(HIR "$N洞悟红花会武学精髓，双拳交错，虚实相交。\n" NOR, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    return;
  }
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int j, ap, dp, damage2;
  ap = me->query_skill(
    "baihua-cuoquan",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "parry",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage2 = (int)me->query_skill(
    "baihua-cuoquan",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "honghua-shengong",
    1
  ) < 100 || me->query_skill("baihua-cuoquan", 1) < 100) return damage;
  //	if ( me->query_skill_mapped("force") != "honghua-shengong") return damage;
  if (objectp(me->query_temp("weapon"))) return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = HIB "\n$N错拳错着，恰好躲过了$n的一小半力道！\n" NOR;
    me->add("neili", -100);
    j = -(damage / 3 + random(damage / 2));
    message_vision(msg, me, ob);
    return j;
  }
  if (random(8) == 2 && random(ap) > dp / 4 && (int)me->query("breakup") > 1) {
    msg = HIC "$N" + me->query("cognize") + HIC "的力量爆发，双拳错乱，身形一闪，双手同时攻向$n。\n" NOR;
    j = -(damage / 2 + random(damage));
    me->add("jingli", -100);
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    if (!ob->is_busy()) ob->start_busy(2);
    message_vision(msg, me, ob, damage2, HBWHT + HIY "精神反伤" NOR);
    return j;
  }
  if (random(8) == 3 && random(ap) > dp / 4 && (int)me->query("jm/honghua")) {
    msg = YEL "$N面对$n的攻势，施出红花会不传之秘「月移花影」，$n感到双眼一花，尽然不能动了！\n" NOR;
    j = -(damage / 2 + random(damage));
    me->add("neili", -100);
    if (!ob->is_busy()) ob->start_busy(2);
    message_vision(msg, me, ob);
    return j;
  }
}
