int valid_learn(object me) {
  object weapon;
  int lvl = (int)me->query_skill("wangxiang-fufa", 1);
  int t = 1, j;
  if (lvl <= 100)
    for (j = 1; j < lvl / 10; j++)
      t *= 2;

  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");			
  //	if ( me->query("gender") != "男性" )
  //		return notify_fail("你又不是男人练什么妄想斧法？\n");
  if (me->query("family/family_name") != "痴心妄想门")
    return notify_fail("非本门亲授弟子无法学习。\n");
  if ((int)me->query_skill("wangran-xinfa", 1) < 100)
    return notify_fail("你的枉然心法火候不够，无法学习。\n");
  if (lvl <= 100) {
    if (lvl > 10 && (int)me->query("shen") < t * 100)
      return notify_fail("你的侠义正气太低了。\n");
  } else {
    if ((int)me->query("shen") < (51200 + (lvl - 100) * 1000))
      return notify_fail("你的侠义正气太低了。\n");
  }
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不足，没有办法练妄想斧法, 多练些内力再来吧。\n");
  if ((int)me->query_skill("axe", 1) < 100)
    return notify_fail("你的基本斧法火候太浅。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "axe")
    return notify_fail("你必须先找一柄斧头才能练斧法。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}


string query_skill_name(int level) {
  int i;
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"])
      return action[i - 1]["skill_name"];
}

int practice_skill(object me) {
  int skill;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query("family/family_name") != "痴心妄想门")
    return notify_fail("非本门亲授弟子无法练习。\n");
  //	if ( me->query("gender") != "男性" )
  //		return notify_fail("你又不是男人练什么妄想斧法？\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 50)
    return notify_fail("你的内力不够练妄想斧法！\n");
  if (skill > 100 && me->query("shen") < 1)
    return notify_fail("这种武功当得行侠义事。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("qi", 40);
  me->add("neili", -30);
  return 1;
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon;
  weapon = me->query_temp("weapon");
  ap = me->query_skill(
    "wangxiang-fufa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("wangxiang-fufa", 1);
  damage2 = (int)me->query_skill(
    "wangxiang-fufa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "wangran-xinfa",
    1
  ) < 100 || me->query_skill("wangxiang-fufa", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "wangran-xinfa") return 0;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "axe") return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIR "只听到「" HIY "" BLINK "砰" NOR "" HIR "」的一声巨响，$w" HIR "竟然深深陷入皮肉！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，手中" + weapon->name() + HIG "连攻三下，“当当当”三声，$n溅出一片鲜血。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/chixin")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIM "$N融汇痴心妄想门武功精髓，一道犀利的斧光似将$n劈为两半，$n无处可逃，结果喷出一口鲜血。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
mapping query_action(object me, object target, object weapon) {
  if (random(me->query_skill(
    "wangxiang-fufa",
    1
  )) > 300 && me->query("neili") > 300 && random(7) == 0 && me->query("jiali") > 100 && me->query_temp("powerup")) {
    me->add("neili", -150);
    return ([
      "action": "" HIB "忽然$N两眼寒光四射，手中$w" HIB "耍得天花乱坠。\n"
      "$n" HIB "心乱如麻，只觉得自己似乎已经无处可逃，眼看一片杀气照向自己。\n" NOR "",
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "damage_type": "劈伤" ]);

    if (!target->is_busy()) target->start_busy(1);
  }

  return action[random(sizeof(action))];
}
string perform_action_file(string action) {
  return __DIR__ "wangxiang-fufa/" + action;
}
