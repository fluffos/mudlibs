// jinshe-jianfa perform
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;

int perform(object me, object target)
{
        string msg,force_skill;
        int i, skill, max;
		int flag,damage,mapforce,extra;
		int ap,dp;		
		flag = 1;

	if ( !target ) target = offensive_target(me);
	if ( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「千手观音」只能在战斗中使用。\n");
	if (objectp(me->query_temp("weapon")))
		return notify_fail("你必须空手才能使用如来千叶手的「千手观音」。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
    if (me->query_skill("qianye-shou", 1) < 1000 )
        return notify_fail("你的如来千叶手还不够娴熟，使不出「千手观音」。\n");
    if (me->query_skill("sanhua-zhang", 1) < 1000 )
        return notify_fail("你的散花掌还不够娴熟，使不出「千手观音」。\n");	
    if (me->query_skill("cibei-dao", 1) < 1000 )
        return notify_fail("你的慈悲刀法还不够娴熟，使不出「千手观音」。\n");	
    if ((int)me->query_skill("hunyuan-yiqi",1) < 1000  && (int)me->query_skill("yijinjing",1) < 1000 )
        return notify_fail("你的佛门内功的修为不够, 不能使用这一绝技 !\n");
	if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi") 
		return notify_fail("你未使用佛门内功, 不能使用这一绝技 !\n");  
	if (me->query_skill_mapped("unarmed") != "qianye-shou")
		return notify_fail("你没正确激发该技能 。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
    if ( (int)me->query("max_neili") < 1000000 )
        return notify_fail("你现在内力修为太弱，使不出「千手观音」。\n");      
    if ( (int)me->query("neili") < 10000 )
        return notify_fail("你现在真气太弱，使不出「千手观音」。\n"); 
    if ( (int)me->query("max_jingli") < 1000000 )
        return notify_fail("你现在精力修为太弱，使不出「千手观音」。\n");      
    if ( (int)me->query("jingli") < 10000 )
        return notify_fail("你现在精力太弱，使不出「千手观音」。\n"); 
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用[" HIR "千手观音" NOR "]\n"NOR); 
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
        skill = me->query_skill("qianye-shou", 1)/10;
		max = me->query_skill("qianye-shou", 1)/600; 
	force_skill=me->query_skill_mapped("force");
	mapforce = (int)me->query_skill(force_skill, 1);		
	if (me->query_skill_mapped("force") == "yijing-force" ) flag = 1;
	if (me->query_skill_mapped("force") == "hunyuan-yiqi" ) flag = 2;
	if (me->query_skill_mapped("force") == "damo-force" ) flag = 3;	
	if (me->query_skill_mapped("force") == "yijinjing" ) flag = 4;
	ap = me->query("xyzx_sys/level") + me->query_skill("qianye-shou", 1)+me->query_skill("cibei-dao",1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	extra = me->query_skill("qianye-shou",1)/10+me->query_skill("buddhism",1)/10;
	message_vision(HBWHT "$N贯通少林派武学，使出了少林派的绝学之精髓！\n" NOR, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1	
        me->add_temp("apply/strength", skill);
        me->add_temp("apply/attack", skill); 
		me->add_temp("apply/damage", skill);
        msg = BLU"\n$N双手突然幻化万千，仿佛孔雀开屏！顿时无数手影向$n击来。\n"NOR;
        message_vision(msg, me, target);
		if (max < 1) max = 1;
		if (max > 9) max = 9;
//			me->add_temp("lianzhao", max);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
		for ( i=0; i<max; i++ )
		{
	        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		}
 
		me->add("neili",-max*200);  
        me->add_temp("apply/strength", -skill);
        me->add_temp("apply/attack", -skill);
		me->add_temp("apply/damage", -skill);
//		me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记		       
      //  if (!target->is_busy()) target->start_busy(random(3));
		
		
if(me->query_skill("qianye-shou",1)>2000 && me->query_skill("cibei-dao",1)>2000 && me->query_skill("sanhua-zhang",1)>2000)
{
	damage = me->query_skill("qianye-shou", 1)*flag + me->query_skill("cibei-dao",1)*flag + me->query_skill("sanhua-zhang",1)*flag + mapforce*flag+ me->query_skill("force",1)+ me->query_skill("unarmed",1)+me->query_skill("blade",1);
			
	message_vision(HIR "$N千手归一，合于胸前，化掌为刀！\n" NOR, me, target);
	message_vision(HIC "$N怒目圆睁，大喝一声：孽障，还不束手就擒！\n" NOR, me, target);
	if (random(ap) >dp/3)
	{
		damage = damage/3 + random(damage/3);
		damage = damage*(100-target->query_meridian())/100;
		message_vision(HIW "一念成佛！\n" NOR, me, target);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		message_vision(HIM "一怒成魔！\n" NOR, me, target);
		COMBAT_D->do_attack(target, target, target->query_temp("weapon"));

		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		target->add("neili",-damage);
		me->add("neili",-2000);
		me->add("jingli",-2000);
		message_vision(HIB "$n已被千手观音打的晕头转向，这一记掌刀无法抵挡！\n" NOR, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (!target->is_busy()) target->start_busy(3);			
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	} else
	{
		damage = damage/5 + random(damage/5);
		damage = damage*(100-target->query_meridian())/100;
		COMBAT_D->do_attack(target, me, target->query_temp("weapon"));
		me->receive_damage("qi", damage,target);
		me->receive_wound("qi", damage/3,target);
		target->add("neili",-1000);
		me->add("neili",-damage/2);
		message_vision(HIR "$N冥顽不化，邪念丛生，一掌击向$n心口！\n" NOR, target, me, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage/2 +"，内伤为"+ damage/3 +"。\n" NOR);
	}	
}	
		
if(me->query_skill("qianye-shou",1)>3000 && me->query_skill("cibei-dao",1)>3000 && me->query_skill("sanhua-zhang",1)>3000)
{
	if (me->query("jm/shaolin")) damage = mapforce*me->query("con",1)*3/2+me->query_skill("qianye-shou", 1)*me->query("dex",1)*3/2 + me->query_skill("cibei-dao",1)*me->query("dex",1)*3/2+me->query_skill("sanhua-zhang",1)*me->query("con",1)*3/2 + me->query_skill("force") + me->query_skill("blade",1) + me->query_skill("unarmed",1)+me->query_skill("qianye-shou", 1)*flag + me->query_skill("cibei-dao",1)*flag + me->query_skill("sanhua-zhang",1)*flag + mapforce*flag;
	else damage = mapforce*me->query("con",1)+me->query_skill("qianye-shou", 1)*me->query("dex",1) + me->query_skill("cibei-dao",1)*me->query("dex",1)+me->query_skill("sanhua-zhang",1)*me->query("con",1) + me->query_skill("force") + me->query_skill("blade",1) + me->query_skill("unarmed",1)+me->query_skill("qianye-shou", 1)*flag + me->query_skill("cibei-dao",1)*flag + me->query_skill("sanhua-zhang",1)*flag + mapforce*flag;
	message_vision(HIR "$N眼中流出血泪，神情悲苍至极！\n" NOR, me, target);
	message_vision(HIC "$n杀戮成性，难以渡化！$N只好使出佛门六字真言！\n" NOR, me, target);
	if (random(ap) >dp/3)
	{
			damage = damage/3 + random(damage/3) + target->query("jing")*6/100;
			damage = damage*(100-target->query_meridian())/100;
			message_vision(HIW "------唵------！\n" NOR, me, target);
			message_vision(HIC "------------嘛------------！\n" NOR, me, target);
			message_vision(HIR "------------------呢------------------！\n" NOR, me, target);
			message_vision(HIB "------------------------叭------------------------！\n" NOR, me, target);
			message_vision(HIY "------------------------------弥------------------------------！\n" NOR, me, target);
			message_vision(HIM "------------------------------------吽------------------------------------！\n" NOR, me, target);
			target->apply_condition("no_enforce", 20);
			target->apply_condition("no_exert", 20);
        me->add_temp("apply/attack",extra*2);
        me->add_temp("apply/damage",extra*2);			
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->add_temp("apply/attack",-extra*2);
        me->add_temp("apply/damage",-extra*2);			
			target->receive_damage("qi", damage,me);
			target->receive_wound("qi", damage/2,me);		
			target->add("neili",-damage);
			if (target->query("max_neili")>100) target->add("max_neili",-(1+random(20)));
			if (target->query("max_jingli")>100) target->add("max_jingli",-(1+random(20)));
			me->add("neili",-3000);
			me->add("jingli",-3000);
//			if (!target->is_busy()) target->start_busy(3);
			message_vision(HIB "$n被佛光笼罩，强行净化满身杀气，顿时全身功力大减！\n" NOR, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	} else
	{
			damage = damage/10 + random(damage/10) + target->query("jing")*2/100;
			damage = damage*(100-target->query_meridian())/100;
			message_vision(HIR "$n盘腿坐下，全神贯注的运转全身功力，抵抗佛门真言！\n" NOR, me, target);
			target->receive_damage("qi", damage,me);
			target->receive_wound("qi", damage/2,me);
			target->add("neili",-damage);
			me->add("neili",-damage);
			message_vision(HIY "$n杀气冲天，无视佛祖慈悲之心！\n"HIY"然佛门亦有降魔之法，$n难以逃脱千手观音的五指山。\n" NOR, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);
	}	
}		
	me->start_busy(1);		
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}