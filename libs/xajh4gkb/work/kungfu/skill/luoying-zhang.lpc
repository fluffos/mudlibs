int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练落英神剑掌必须空手。\n");
    if (me->query("family/family_name")!="桃花岛")
		return notify_fail("你不是桃花岛弟子，无法学习本门技能。\n");	
	if ((int)me->query_skill("bibo-shengong", 1) < 100)
		return notify_fail("你的碧波神功火候不够，无法学落英神剑掌。\n");
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力太弱，无法练落英神剑掌。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("qi") < 30)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练落英神剑掌。\n");
    if (me->query("family/family_name")!="桃花岛")
		return notify_fail("你不是桃花岛弟子，无法练习本门技能。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");	
	me->receive_damage("qi", 20);
	me->add("neili", -1);
	return 1;
}
string perform_action_file(string action)
{
	return __DIR__"luoying-zhang/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;
    ap = me->query_skill("luoying-zhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("bibo-shengong",1);
	damage2 = (int)me->query_skill("luoying-zhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("bibo-shengong",1) < 100 || me->query_skill("luoying-zhang",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "bibo-shengong") return 0;
	if (objectp(me->query_temp("weapon")) ) return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIR "$N脚踏五行，施展开落英神剑掌，落英缤纷，$n被桃花迷住了双眼，顿时被打的如桃花般灿烂！！\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，踏五行，转乾坤，掌中带桃花，$n双眼一花，不知如何是好。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/taohua") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIM"$N融汇桃花岛绝技，出掌如桃花缤纷，$n眼花缭乱，结果鲜血狂奔。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;
	ap = me->query_skill("luoying-zhang", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("sword",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("luoying-zhang", 1);
	damage2 = me->query_skill("luoying-zhang", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (objectp(me->query_temp("weapon"))) return damage;
	if (me->query_skill("bibo-shengong",1) < 300 || me->query_skill("luoying-zhang", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="bibo-shengong" ) return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIC"$n出招时，$N脚踏五行，$n心头一乱，一时失去$N踪影！\n"NOR;
		if (!ob->is_busy()) ob->start_busy(1);
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，掌力带起桃花，$n心神一震。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/taohua") )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );
		message_vision(HIB"$N洞悉桃花岛武学精髓，一掌快过一掌，$n被掌风扫中！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
}