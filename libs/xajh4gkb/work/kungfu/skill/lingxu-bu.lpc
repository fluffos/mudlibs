// lingxu-bu 凌虚步
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$n一式「" + HIG "雪地莲花" NOR + "」，身子掣忽一转，$N只觉的眼前一花，失去了目标。\n",
    "dodge": 40
  ]),
  ([ "action": "$n一式「" + YEL "一狐冲天" NOR + "」，双脚点地，身子突然拔高了丈许，缓缓飘落在$N身后。\n",
    "dodge": 60
  ]),
  ([ "action": "$n一式「" + CYN "移行幻影" NOR + "」，身行一晃，顿时无数条身影一下子出现在$N的面前。\n",
    "dodge": 80
  ]),
  ([ "action": "$n一式「" + RED "狡兔三窟" NOR + "」，飘然向后一退，躲开$N的凌厉攻势。\n",
    "dodge": 100
  ]),
  ([ "action": "$n一式「" + HIG "烟雨飘渺" NOR + "」，身体急转，化为一道白光，虚幻不定的出现在$N的周围。\n",
    "dodge": 120
  ])
});

mapping query_action(object me, object weapon) {
  int zhaoshu, level;

  zhaoshu = sizeof(action);
  level = (int)me->query_skill("shaolin-shenfa");

  if (level < 120)
    zhaoshu--;

  if (level < 80)
    zhaoshu--;

  if (level < 40)
    zhaoshu--;

  return action[random(zhaoshu)];
}
int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query_skill("hanbing-zhenqi", 1) < 100)
    return notify_fail("不学会寒冰真气，学不了凌虚步。\n");
  if (me->query("family/family_name") != "嵩山派")
    return notify_fail("你不是嵩山派弟子，无法学习本门技能。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  return 1;
}
int valid_enable(string usage) {
  return usage == "dodge";
}
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "juehu-shou"; }		//互备技能
string skill_pinji() { return "下乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "中立"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "嵩山派"; }    //门派区分：门派，江湖
string skill_yinyang() { return "中性"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "正派"; }   //阵营区分：正派、邪派、中立、通用
//int damage_damage() {return 60;}	//外伤系数
//int force_damage() {return 60;}		//内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

string query_dodge_msg(string limb) {
  object me, ob;
  mapping action;

  me = this_player();
  action = query_action(me, ob);

  return action["action"];
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太差了，不能练凌虚步。\n");
  if (me->query("family/family_name") != "嵩山派")
    return notify_fail("你不是嵩山派弟子，无法练习本门技能。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "lingxu-bu/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  int j, ap, dp, damage2;
  ap = me->query_skill(
    "lingxu-bu",
    1
  ) * me->query(
    "dex",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "dodge",
    1
  ) * ob->query(
    "dex",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage2 = me->query_skill(
    "lingxu-bu",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "hanbing-zhenqi",
    1
  ) < 300 || me->query_skill("lingxu-bu", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force")!="hanbing-zhenqi" ) return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(HIG "$N凌空虚踏，身形半隐半现，$n的招式十有八九落在了虚空之中！\n" NOR, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage + random(damage));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N顿悟" + me->query("cognize") + HIY "，身形跨越虚空，突然出现在$n后侧，趁势攻入$n间隙。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/songshan")) {
    j = -(damage / 3 + random(damage / 3));
    me->add("neili", -100);
    if (!ob->is_busy()) ob->start_busy(2);
    message_vision(HIB "$N融汇嵩山武学精髓，一步飞踏虚空，$n只觉一道影子飞过！\n" NOR, me, ob);
    return j;
  }
}
