// fenghuang.c 凤凰护体
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_CLEAN_UP;
void remove_effect(object me, int amount);

int exert(object me, object target)
{
	int skill;

	if( target != me )
		return notify_fail("你只能用五毒神功提升自己的战斗力。\n");
	if( (int)me->query("max_neili") < 500000 )
		return notify_fail("你的内力不够。\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的内力不够。\n");
	if( (int)me->query_temp("jincanhuti") )
		return notify_fail("你现在仍处于金蚕护身之中。\n");
    if (me->query_skill("wudu-shengong",1) < 2000)
		return notify_fail("你的五毒神功还不够娴熟。\n");
	if (me->query_skill_mapped("force") != "wudu-shengong")
        return notify_fail("你现在使用的内功无法施展「金蚕护身」！\n");
	if (!wizardp(me) && !(int)me->query("breakup") )
		return notify_fail("你任督二脉未通,无法使用「金蚕护身」。\n"NOR);	
	if ( time() - me->query_temp("fenghuang_time") < 600 )
        return notify_fail("「金蚕护身」尚在调息之中，静待片刻方可！！\n");
	skill = me->query_skill("wudu-shengong");
	me->add("neili", -1000);
	
	message_vision( HIR"$N拿出一只金蚕蛊，运起五毒神功，只见蛊虫钻入体内，却在体外形成一道无形蚕茧！\n" NOR, me);
	me->set_temp("jincanhuti", 1);
	me->set_temp("fenghuang_time",time());
    me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill :), 300);

	return 1;
}

void remove_effect(object me, int amount)
{
	if (!me) return;
	if ( (int)me->query_temp("jincanhuti") )
	{
		me->delete_temp("jincanhuti");
		tell_object(me, "「金蚕护体」的光泽渐渐变暗，直到一点点的消失了。\n");
	}
}
int help(object me)
{
	write(HIM"\n五毒神功之「金蚕护体」："NOR"\n");
	write(@HELP
	五毒教的技能，“神蚕九变，化茧重生”，对自己施展，
	重伤后能立即复活并恢复气血和精神。
	
	要求：五毒神功等级 2000 以上；
		  最大内力 500000 以上。
HELP
	);
	return 1;
}