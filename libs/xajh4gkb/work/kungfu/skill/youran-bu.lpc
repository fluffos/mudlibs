int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_skill("dodge", 1) <=me->query_skill("youran-bu", 1))
		return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	if (me->query("family/family_name")!="血河派")
		return notify_fail("你不加入血河派，恐怕学不了血河派技能。\n");	
	if (!me->query("jm/xuantian"))
		return notify_fail(CYN"我血河派第十一代掌门欧阳驼于六十年前失踪，江湖上流传的摧心掌似乎与我派有关。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否先为我派去玄天派探听其秘密，将来必有回报。\n"NOR);
	if ((int)me->query("family_score")<8)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if ((int)me->query_skill("huaxue-dafa", 1) < 100 && (int)me->query_skill("yiriguan-riyue", 1) < 100 && (int)me->query_skill("longmen-shengong", 1) < 100)
		return notify_fail("你的本门内功火候不够，无法学习悠然步。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
    return 1;
}
string query_dodge_msg(object me,string limb)
{
	if (me) me->set_temp("fight/dodge",(random(me->query_skill("youran-bu",1))+me->query_skill("youran-bu",1)));
		return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("qi") < 40 )
		return notify_fail("你的体力太差了，不能练悠然来往。\n");
	if (me->query("family/family_name")!="血河派")
		return notify_fail("你不加入血河派，恐怕练习不了血河派技能。\n");	
	if (!me->query("jm/xuantian"))
		return notify_fail(CYN"我血河派第十一代掌门欧阳驼于六十年前失踪，江湖上流传的摧心掌似乎与我派有关。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否先为我派去玄天派探听其秘密，将来必有回报。\n"NOR);
	if ((int)me->query("family_score")<8)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 30);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"youran-bu/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;

	ap = me->query_skill("youran-bu", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("parry",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("youran-bu", 1);
	damage2 = me->query_skill("youran-bu", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if ((me->query_skill("huaxue-dafa",1) < 300 && me->query_skill("yiqiguan-riyue",1) < 300 && me->query_skill("longmen-shengong",1) < 300) || me->query_skill("youran-bu", 1) < 300) return damage;
//	if (me->query_skill_mapped("force") == "huaxue-dafa" || me->query_skill_mapped("force") == "yiqiguan-riyue" || me->query_skill_mapped("force") == "longmen-shengong") return damage;
	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIG"$N辣轻躯以鹤立，若将飞而未翔。悠然而往，悠然而来而已矣。\n"NOR;
		me->add("neili", -100 );
		if (!ob->is_busy()) ob->start_busy(1);
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，鸢飞戾天者，望峰息心；经纶世务者，窥谷忘反。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/xuehe") )
	{
		j = -(damage+random(damage));
		me->add("neili", -100 );
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		message_vision(HIB"$N融汇血河派武学精髓，身形将展未展，以不变应万变，后发制人！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
}
