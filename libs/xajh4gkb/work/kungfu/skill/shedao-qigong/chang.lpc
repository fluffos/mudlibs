#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int damage, damage1;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("唱仙法只能在战斗中使用。\n");
  if (environment(me)->query("no_fight"))
    return notify_fail("在这里不能攻击他人。\n");
  if ((int)me->query_skill("shedao-qigong", 1) < 300)
    return notify_fail("你的蛇岛奇功不够娴熟，不会使用惊魂唱。\n");
  if ((int)me->query_skill("shenlong-xinfa", 1) < 300)
    return notify_fail("你的神龙心法不够娴熟，不会使用惊魂唱。\n");
  if (!wizardp(me) && me->query_skill_mapped("force") != "shenlong-xinfa")
    return notify_fail("不使用本门内功，如何使用本门绝学!\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query("max_jingli") < 200000)
    return notify_fail("你的精力修为不够。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你已经唱得精疲力竭,精力不够了。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你已经唱得精疲力竭,内力不够了。\n");
  //	if( (int)me->query_temp("chang") >=-20  )        //取消前奏                 	
  //  	return notify_fail("你必须先唱起前奏，协调自己的音律。\n");
  if (me->query("neili") / 2 + random(me->query("neili") / 2) < (int)target->query("neili") / 3)
    return notify_fail("敌人的内力比你高出太多,伤不了！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  //	me->delete_temp("chang");     	
  me->add("neili", -500);
  me->add("jingli", -500);


  message_vision(HIR "只听$N口中念念有词，顷刻之间武功大进！惊魂唱，唱惊魂！\n" NOR, me);
  message_vision(HIR "只听$N口中念念有词，顷刻之间内力大涨！\n" NOR, me);
  message_vision(HIY "$N深深地吸一囗气，忽然仰天长啸，高声狂叫：不死神龙，唯我不败！\n" NOR, me);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1

  if (target->query_skill_mapped("force") == "yunv-xinjing" || target->query_skill_mapped("force") == "wudie-xinjing") {
    if (target->query_skill(
      "wudie-xinjing",
      1
    ) >= 1000 || (target->query_skill(
      "yunv-xinjing",
      1
    ) > 1000 && !((int)target->query("make_loves") || (int)target->query("couple/couple_id"))))
      return notify_fail("你等邪魔歪道,岂能伤得了我玉女门人!");
  }
  if (target->query_skill("shedao-qigong", 1) > me->query_skill("shedao-qigong", 1)) {
    if (target->query_skill("shedao-qigong", 1) >= 2000 && random(100) < 50)
      return notify_fail("" + target->query("name") + "回身淡淡一笑," + RANK_D->query_respect(me) + "既有如此雅兴,合奏一曲<笑傲江湖>如何?");
    else if (target->query_skill("shedao-qigong", 1) >= 1000 && random(100) < 15)
      return notify_fail("" + target->query("name") + "回身淡淡一笑," + RANK_D->query_respect(me) + "既有如此雅兴,合奏一曲<笑傲江湖>如何?");
    else if (random(100) < 10)
      return notify_fail("" + target->query("name") + "回身淡淡一笑," + RANK_D->query_respect(me) + "既有如此雅兴,合奏一曲<笑傲江湖>如何?");
  }

  damage = ((int)me->query("neili") - (int)target->query("neili")) / 100;
  if (damage > 0) {
    damage = damage / 3 + random(damage / 3);
    damage = damage * (100 - target->query_meridian()) / 100;
    target->receive_wound("jing", damage, me);
    target->receive_damage("jing", damage / 2, me);
    message_vision(
      HIR "$N只觉脑中一阵剧痛，金星乱冒，犹如有万条金龙在眼前舞动。\n" NOR,
      me,
      target,
      damage,
      HBWHT + HIM "精神伤害" NOR
    );  //2018.10.2阿飞改，优化化学伤害显示的写法
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
  } else {
    damage1 = (int)me->query("jing") / 100 + random((int)me->query("jing") / 100);
    damage1 = damage1 * (100 - me->query_meridian()) / 100;
    message_vision(HIR "$n大怒道：破锣嗓子，急着投胎吗！$n心头火起，大吼一声，$N只觉得眼冒金星。\n" NOR, target);
    me->receive_wound("jing", damage1, target);
    me->receive_damage("jing", damage1 / 2, target);
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    message_vision(
      HIR "$n受到$N的大喝，只觉脑中微痛，似乎受了一点轻伤。\n" NOR,
      target,
      me,
      damage1,
      HBWHT + HIM "精神伤害" NOR
    );  //2018.10.2阿飞改，优化化学伤害显示的写法
  }
  if (!target->is_killing(me)) target->kill_ob(me);
  if (!me->is_killing(target->query("id"))) me->fight_ob(target);
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
