mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap, dp, damage1,damage2,damage,liannum;
	ap = (int) me->query_skill("hamagong",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp= (int) victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	damage1= (int) me->query_skill("hamagong",1);
	damage2= (int) me->query_skill("hamagong",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if ( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
	if ( me->query_skill("hamagong",1) < 100) return 0;	
	if ( me->query_skill_mapped("force") != "hamagong") return 0;	

 	if (me->is_busy() && random(6)==0 && random(ap) > dp/3)
	{
		me->start_busy(1);
		me->add("neili", -100 );
		return HIC "$N默运蛤蟆功，经脉逆转，堵塞的穴位一气贯通！\n"NOR;			
	} 	
	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0 )
	{
		me->add("neili", -100 );
		victim->apply_condition("snake_poison",20);
		victim->apply_condition("chanchu_poison",20);
		victim->apply_condition("qx_snake_poison",20);
		if (!victim->is_busy()) victim->start_busy(2);	
		return HIR "$N倒转经脉，身形一变，一口毒气对着$n吐出!$n头一昏，不知所措 ！\n"NOR;
	}
	if (random(7)==2 && random(ap) > dp/3 && me->query("jiajing") > 0 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli", -100 );
		victim->receive_damage("jing", damage ,me);
		victim->receive_wound("jing", damage/3 ,me);
		message_vision(HIR "$N顿悟"+me->query("cognize")+HIR"，倒转经脉对着$n张口一咬！$n伤口一凉，鲜血喷出！\n"NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}

	if( random(ap) > dp/3 && random(7)==3 && me->query("jiali") > 0 && (int)me->query("jm/baituo") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili", -100 );
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		message_vision(WHT "$n" WHT "硬承下$N" WHT "一掌，哪知其中蕴藏白驼山精义，霎时全身一颤，经脉受震，喷出一口鲜血！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if ( random(ap) > dp/3 && random(7)==4 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
        me->add("neili", -100);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		message_vision(HIM "$n喘息未定，又觉一股劲风扑面而来，吐出了一大口鲜血！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

string exert_function_file(string func)
{
	return __DIR__"hamagong/" + func;
}

mapping exercise_msg(object me)
{
	return ([
		"status_msg" : "用头支在地上，双脚并拢，撑向天空。",
		"start_my_msg" : "倒转身体，以头支地，双脚并拢，撑向天空，运起蛤蟆功逆转心法疗伤。\n"NOR,
		"start_other_msg" : me->name()+"倒运气息，真气逆走，感觉伤势大有起色。\n"NOR,
		"heal_my_msg" : "脸色阴沉，头下脚上倒立着，周身上下散布着一股黑气。\n"NOR,
		"heal_other_msg" : me->name()+"感到全身真气通畅无阻，怪叫一声，猛得跃起。\n"NOR,
		"halt_msg" : "像蛤蟆一样怪叫一声，突然跃起，趴于地上，腮帮一呼一吸。\n",
		"end_my_msg" : "正在逆转真气疗伤，突然感到真气乱窜，吓出一身冷汗，只能停了下来。\n",
		"end_other_msg": me->name()+"猛然睁开双眼，缓缓站起，但脸色更加阴沉。\n",
		"hover_my_msg" : "将逆走的真气压回丹田，双脚着地，站了起来。\n",
		"hover_other_msg" : me->name() +"将黑气吸回体内，站了起来，伤势似乎看上好了不少。\n",
        ]);
}
