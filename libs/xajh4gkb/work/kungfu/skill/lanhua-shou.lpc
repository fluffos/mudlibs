int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail(HIC "练兰花拂穴手必须空手。\n" NOR);
  if (me->query("gender") != "女性")
    return notify_fail("兰花拂穴手只能女子习学！\n");
  if ((int)me->query_skill("bibo-shengong", 1) < 300)
    return notify_fail("你的碧波神功火候不够，无法学兰花拂穴手。\n");
  if (me->query("family/family_name") != "桃花岛")
    return notify_fail("你不是东邪亲传弟子，无法学习东邪独门技能。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练兰花拂穴手。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}


int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("gender") != "女性")
    return notify_fail("兰花拂穴手只能女子习学！\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了，无法练兰花拂穴手。\n");
  if (me->query("family/family_name") != "桃花岛")
    return notify_fail("你不是东邪亲传弟子，偷练东邪独门技能是作死的行为。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("qi", 25);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "lanhua-shou/" + action;
}

mapping query_action(object me, object weapon) {
  int level;
  string xue;

  level = (int)me->query_skill("lanhua-shou", 1);
  xue = xuedao[random(sizeof(xuedao))];

  if (random(level) > 200 && me->query("jiali") > 100 && me->query("neili") >= 600 && random(10) == 1) {

    return ([
      "action": HIC "忽见$N" + (random(2) ? "右" : "左") + "手手掌五指分开，形如兰花，姿态曼妙难言，出手优雅，气度闲逸，望之轻描淡写，行若无事地拂向$n的" + xue + "" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "damage_type": "内伤" ]);
  }

  if (random(level) > 300 && me->query("jiali") > 100 && me->query("neili") >= 600 && random(10) == 2) {

    return ([
      "action": HIC "$N淡然一笑，出手若春兰葳蕤，晓风过林，似慢实快，若重还轻拂向$n的" + xue + "，已深得快、准、奇、清四字要诀" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "damage_type": "内伤" ]);
  }

  if (random(level) > 400 && me->query("jiali") > 100 && me->query("neili") >= 600 && random(10) == 3) {

    return ([
      "action": HIR "$N双手交叠，使出“兰花手双手式”，形状便如兰花新蕾初放，于轻风中微微摇摆。$n看得有些发呆，却蓦然发现$N的十指已拂到面前！" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "damage_type": "擦伤" ]);
  }

  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  string xue;
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon2;

  weapon2 = victim->query_temp("weapon");
  ap = (me->query_skill(
    "lanhua-shou",
    1
  ) + me->query_skill(
    "qimen-wuxing",
    1
  ) + me->query_skill(
    "bibo-shengong",
    1
  )) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = (victim->query_skill(
    "force",
    1
  ) + victim->query_skill(
    "parry",
    1
  )) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("lanhua-shou", 1);
  damage2 = (int)me->query_skill(
    "lanhua-shou",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  xue = xuedao[random(sizeof(xuedao))];
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("bibo-shengong", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "bibo-shengong") return 0;	
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(7) == 1 && me->query("jiali") > 0 && random(ap) > dp / 3) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIR "$N施展开奇门五行，$n心神一乱，被打中" + xue + "。结果鲜血狂奔！！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(2);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，兰花指轻抚$n的" + xue + "，$n只觉得全身巨痛，真气在经脉里四处乱窜，一时竟然无法控制！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/taohua")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(2);
    message_vision(
      HIR "$N使出桃花岛绝技「如意兰花手」，$n被$N拂中了" + xue + "，只觉得一阵钻心的疼痛，真气不由得一滞！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(7) == 4 && me->query("jiali") > 0 && random(ap) > dp / 3) {
    damage = ((damage1 + damage2) / 2) * (liannum + 20) / (20 * liannum + 1);
    switch (random(3)) {
      case 0:
        if (weapon2) {
          weapon2->unwield();
          weapon2->move(environment(victim));
          victim->add("neili", -damage);
          return CYN "$n被落叶式拂中了「" HIR + xue + CYN "」，手一麻，" + weapon2->query("name") + CYN "把持不住，掉在地上。\n" NOR;
        } else {
          victim->add("neili", -damage);
          return CYN "$n被落叶式拂中了「" HIR + xue + CYN "」，手一麻，丹田也受到了振荡！\n" NOR;
        }
        break;
      case 1:
        victim->add_temp("apply/dexerity", -damage / 5);
        victim->add_temp("apply/strength", -damage / 5);
        victim->add_temp("apply/constitution", -damage / 5);
        victim->add_temp("apply/intelligence", -damage / 5);
        return CYN "$n被舞蝶式连续拂中了任脉诸穴，战力大减！\n" NOR;
        break;
      case 2:
        if (weapon2) {
          victim->map_skill(weapon2->query("skill_type"));
        } else {
          victim->map_skill("hand");
          victim->map_skill("strike");
          victim->map_skill("cuff");
          victim->map_skill("claw");
          victim->map_skill("unarmed");
          victim->map_skill("finger");
        }
        return CYN "$n被擒拿式拂中了「" HIR + xue + CYN "」，武功的特殊威力无法施展出来。\n" NOR;
        break;
    }
  }
}
