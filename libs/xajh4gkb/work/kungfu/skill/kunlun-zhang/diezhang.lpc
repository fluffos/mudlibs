// diezhang.c 昆山叠掌
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
#include "/kungfu/skill/eff_msg.h";

int perform(object me, object target) {
  mixed combat_msg;
  string msg, *limbs;
  int i, damage, skill1, skill2;
  int count, ap, dp;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「昆山叠掌」只能在战斗中对对手使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("只有空手才能施展「昆山叠掌」。\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
  //	if( me->query_skill_mapped("unarmed") != "kunlun-zhang" )
  //		return notify_fail("你没有用昆仑掌法。\n");
  if ((int)me->query_skill("kunlun-zhang", 1) < 500)
    return notify_fail("你的掌法不够娴熟，不会使用「昆山叠掌」。\n");
  if ((int)me->query_skill("xuantian-wuji", 1) < 500)
    return notify_fail("你的玄天无极功等级不够，不能使用「昆山叠掌」。\n");
  //	if(me->query_skill_mapped("force") != "xuantian-wuji" )
  //		return notify_fail("你没有用玄天无极。\n");
  if ((int)me->query("max_neili", 1) < 200000)
    return notify_fail("你内力修为不够，不能使用「昆山叠掌」。\n");
  if ((int)me->query("neili", 1) < (int)me->query_skill("kunlun-zhang", 1) * 4)
    return notify_fail("你现在的内力施展不了那么多招。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够了。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  combat_msg = me->query("env/no_combat_msg");
  if (!intp(combat_msg)) combat_msg = 1;
  count = (int)me->query_skill("kunlun-zhang", 1) / 600;
  if (count < 1) count = 1;
  if (me->query("jm/kunlun")) {
    if (count > 100 + (int)me->query_temp("lianzhao_max_add") * 4) count = 100 + (int)me->query_temp("lianzhao_max_add") * 4;
  } else {
    if (count > 50 + (int)me->query_temp("lianzhao_max_add") * 2) count = 50 + (int)me->query_temp("lianzhao_max_add") * 2;
  }
  skill1 = (int)me->query_skill("kunlun-zhang", 1);
  skill2 = (int)me->query_skill("xuantian-wuji", 1);
  message_vision(
    HIG "$N深吸一口气，大喝一声，连续击出" HIW + chinese_number(count) + HIG "掌，后招推着前招，掌力叠合在一起扑向$n！\n\n" NOR,
    me,
    target
  );
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1

  ap = me->query("xyzx_sys/level") + me->query_skill(
    "kunlun-zhang",
    1
  ) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  limbs = target->query("limbs");
  for (i = 0; i < count; i++) {
    if (random(ap) > dp / 3) {
      if (combat_msg < 4) message_vision(
        replace_string(
          HIG + SKILL_D("kunlun-zhang")->query_action(me, me->query_temp("weapon"))["action"],
          "$l",
          limbs[random(sizeof(limbs))]
        ) + "！\n" NOR,
        me,
        target
      );
      damage = skill2 * 2 + random(skill1 * 2);
      damage = damage * (100 - target->query_meridian()) / 100;
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 3, me);
      me->add("neili", -100);
      msg = HIY "\n$N调集全身内力，如同海浪般，沿着手少阴心经冲击$n的经脉，第" HIW + chinese_number(i) + HIG "重浪。\n" NOR;
      message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/3 +"。\n" NOR);
    } else {
      me->add("neili", -200);
      msg = HIY "\n$n身型急速后退，顺着掌风就势一跳，躲开了这攻击。\n" NOR;
      message_vision(msg, me, target);
    }
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
