int valid_learn(object me) {
  object ob;

  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力修为不够，没有办法练泰山剑法。\n");
  if ((int)me->query("str", 1) < 30)
    return notify_fail("泰山派剑法讲究大开大合，以你的臂力恐怕难以舞动。\n");
  if (me->query("family/family_name") != "泰山派")
    return notify_fail("你不是泰山弟子，无法学习。\n");
  if ((int)me->query_skill("panshi-shengong", 1) < 100)
    return notify_fail("你的「磐石神功」火候不够，无法学习泰山剑法。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  if (!objectp(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  return 1;
}
int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 40 || (int)me->query("neili") < 30)
    return notify_fail("你的内力或气不够，没法练习泰山剑法。\n");
  if (me->query("family/family_name") != "泰山派")
    return notify_fail("你不是泰山弟子，无法练习。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 35);
  me->add("neili", -20);
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"])
      return action[i - 1]["skill_name"];
}
mapping query_action(object me, object weapon) {
  int level = (int)me->query_skill("taishan-jianfa", 1);
  if (random(level) > 300 && random(15) == 1 && me->query("jiali") > 100) {
    return ([
      "action": HIY "$N左手计算已毕，$w" + HIY "出招，正是泰山派剑法中最高深的绝艺「岱宗如何」，这一剑算准了$n的一切应变後着，实是威力无俦，博大精深" NOR,
      "attack": 300,
      "parry": 300,
      "dodge": 300,
      "damage": 300,
      "force": 300,
      //	"post_action": (: ruhe :),	
      "damage_type": "刺伤" ]);
  }
  if (random(level) > 300 && random(15) == 2 && me->query("jiali") > 100) {
    return ([
      "action": YEL "$N$w" + YEL "倏地向$n刺出，连连出剑，每一剑的剑招皆苍然有古意，招数古朴，内藏奇变，正是「五大夫剑」" NOR,
      "attack": 300,
      "parry": 300,
      "dodge": 300,
      "damage": 300,
      "force": 300,
      "skill_name": "五大夫剑",
      //	"post_action": (: ruhe :),	
      "damage_type": "刺伤" ]);
  }

  if (random(level) > 300 && random(15) == 3 && me->query("jiali") > 100) {
    me->add("neili", -10);
    return ([
      "action": HIC "$N陡然向$n连环三剑，$w" + HIC "使得犹似行云流水，大有善御者驾轻车而行熟路之意，将「快活三」剑招发挥得淋漓尽致" NOR,
      "attack": 300,
      "parry": 300,
      "dodge": 300,
      "damage": 300,
      "force": 300,
      "skill_name": "快活三",
      //	"post_action": (: ruhe :),	
      "damage_type": "刺伤" ]);
  }

  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点

}


