// shangxin.c 伤心小箭
 
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
 
inherit F_SSERVER;

int perform(object me, object target)
{
        string msg,force_skill;
        object weapon;
        int skill1, skill2, skill3,skill;
		int flag,ap,dp,damage,addqi,extra;
		flag = 1;
		addqi = 0;
  
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「伤心小箭」只能在战斗中使用。\n");
    if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing")
        return notify_fail("不使箭怎么能使「伤心小箭」？\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
    if(me->is_busy())
        return notify_fail("你现在正忙着！\n");
	if ((int)me->query("max_neili") < 500000)								
		return notify_fail("你的内力修为不够。\n");
	if ((int)me->query("max_jingli") < 1000000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你的精力不够。\n");		
    if( (int)me->query("neili") < 10000 )
        return notify_fail("你现在的内力不足！\n");
    if( me->query_skill_mapped("throwing") != "youren-jian") 
        return notify_fail("你没有激发游刃箭，无法使用「伤心小箭」！\n");	
	if ((int)me->query_skill("huaxue-dafa", 1) < 1000 && (int)me->query_skill("yiriguan-riyue", 1) < 1000 && (int)me->query_skill("longmen-shengong", 1) < 1000)
		return notify_fail("你的本门内功火候不够，恐怕无法使用绝技。\n");	
	if ( me->query_skill_mapped("force") != "huaxue-dafa" && me->query_skill_mapped("force") != "yiqiguan-riyue" && me->query_skill_mapped("force") != "longmen-shengong") 
		return notify_fail("你未使用本门内功，如何能使用本门绝技。\n");
    if( me->query_skill("youren-jian",1) < 1000 )
        return notify_fail("你游刃箭的修为不够，不能使用「伤心小箭」! \n");
    if( me->query_skill("yudi-bian",1) < 1000)
        return notify_fail("你余地鞭不够，不能使用「伤心小箭」! \n"); 
    if( me->query_skill("jieniu-dao",1) < 1000)
        return notify_fail("你的解牛刀太差，不能使用「伤心小箭」! \n");
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用[" HIR "伤心小箭" NOR "]\n"NOR); 
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

        skill1 = me->query_skill("youren-jian",1);
        skill2 = me->query_skill("yudi-bian",1);
        skill3 = me->query_skill("jieniu-dao",1);	
	extra = me->query_skill("youren-jian",1)/5+me->query_skill("yudi-bian",1)/15+me->query_skill("jieniu-dao",1)/15;		
	message_vision(HBWHT "$N贯通血河车武学，使出了血河车的绝学之精髓！\n" NOR, me, target);	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1	
        msg = HIW "\n$N融汇贯通血河车的三大绝学，使出了伤绝天下的「伤心小箭」！无人不受伤，无人不心伤！。\n\n"NOR;
        message_vision(msg, me, target);

	force_skill=me->query_skill_mapped("force");
	skill = (int)me->query_skill(force_skill, 1);		
		if (me->query_skill_mapped("force")=="huaxue-dafa") flag = 1;
		if (me->query_skill_mapped("force")=="longmen-shengong") flag = 3;
		if (me->query_skill_mapped("force")=="yiqiguan-riyue") flag = 2;
	ap = me->query("xyzx_sys/level") + me->query_skill("youren-jian", 1)+me->query_skill("yudi-bian",1)+me->query_skill("jieniu-dao",1) + me->query_skill("throwing") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	message_vision(HIB "庖丁为文惠君解牛，手之所触，肩之所倚，足之所履，膝之所踦， 砉然向然，奏刀騞然，莫不中音。！\n" NOR, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
	message_vision(HIY "彼节者有闲，而刀刃者无厚；以无厚入有闲，恢恢乎其於游刃必有馀地矣。！\n" NOR, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
	message_vision(HIR "人取小，我取大，人视近，我视远，人动而愈纷，我静而自正，人束手无策，我游刃有馀。！\n" NOR, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
	damage = me->query_skill("youren-jian",1)*flag + me->query_skill("yudi-bian",1)*flag + me->query_skill("jieniu-dao",1)*flag;
	damage = damage/2 + random(damage/2);
	damage = damage*(100-target->query_meridian())/100;
	target->receive_damage("jing", damage,me);
	target->receive_wound("jing", damage/2,me);
	message_vision(HIW"吾生也有涯，而知也无涯。以有涯随无涯，殆己！\n" NOR, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);	
if(skill1 > 2000 && skill2 > 2000 && skill3 > 2000)	
{
	damage = me->query_skill("youren-jian",1)*flag + me->query_skill("yudi-bian",1)*flag + me->query_skill("jieniu-dao",1)*flag + me->query_skill("force")+me->query_skill("throwing")+me->query_skill("whip")+me->query_skill("blade");
	
	message_vision(HIB "$N以自身精血为引，使出了【伤人之箭】！\n" NOR, me, target);
	me->add_temp("apply/attack", extra);
	me->add_temp("apply/attack", extra);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/attack", -extra);	
	if (random(ap)>dp/3)
	{
		damage = damage/3 + random(damage/3);
		damage = damage*(100-target->query_meridian())/100;
		message_vision(HIG "$N眉头一皱，一滴血花凝聚指头，似情人的心！\n" NOR, me, target);
		target->receive_damage("jing", damage,me);
		target->receive_wound("jing", damage/2,me);
		target->add("neili", -damage);
		target->apply_condition("no_enforce", 20);
		me->add("neili",-2000);		
		message_vision(BLU "$n感到一股无形血气，无声无息的袭来！\n" NOR, me, target);
		message_vision(HIW "$n受到血气侵入，一时半会难以使用内力！\n" NOR, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		damage = damage/9 + random(damage/9);
		damage = damage*(100-me->query_meridian())/100;
		me->add("neili",-500);
		me->receive_damage("jing", damage,target);
		me->receive_wound("jing", damage/2,target);
		message_vision(HIM "$N轻蔑的笑了笑，此等雕虫小技也敢班门弄斧！屈指一弹，反弹回去\n" NOR, target, me, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);
	}
}		
		
if(skill1 > 3000 && skill2 > 3000 && skill3 > 3000)	
{
	if (me->query("jm/xuehe")) damage = me->query_skill("youren-jian",1)*me->query("int",1)*3/2 + me->query_skill("yudi-bian",1)*me->query("int",1)*3/2 + me->query_skill("jieniu-dao",1)*me->query("int",1)*3/2+skill*me->query("con",1)*3/2 + me->query_skill("blade",1) + me->query_skill("throwing",1) + me->query_skill("whip",1)+me->query_skill("force",1)+me->query_skill("youren-jian",1)*flag + me->query_skill("yudi-bian",1)*flag + me->query_skill("jieniu-dao",1)*flag;
	else damage = me->query_skill("youren-jian",1)*me->query("int",1) + me->query_skill("yudi-bian",1)*me->query("int",1) + me->query_skill("jieniu-dao",1)*me->query("int",1)+skill*me->query("con",1) + me->query_skill("blade",1) + me->query_skill("throwing",1) + me->query_skill("whip",1)+me->query_skill("force",1)+me->query_skill("youren-jian",1)*flag + me->query_skill("yudi-bian",1)*flag + me->query_skill("jieniu-dao",1)*flag;
	
	message_vision(HIB "$N神情伤心至极，满天箭意似乎悲痛不已，无人不伤心------------【伤心小箭】！\n" NOR, me, target);
	me->add_temp("apply/attack", extra*2);
	me->add_temp("apply/attack", extra*2);	
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
	me->add_temp("apply/attack", -extra*2);
	me->add_temp("apply/attack", -extra*2);	
	if (random(ap)>dp/3)
	{
		damage = damage/4 + random(damage/4) + me->query("jing")*6/100;
		damage = damage*(100-target->query_meridian())/100;
		message_vision(HIG "今乃伤心百年之际，兴哀无情之地，意者无乃知哀之可有，而未识情之可无乎！\n" NOR, me, target);
		message_vision(BLU "伤心千古， 秦淮 一片明月！平林漠漠烟如织，寒山一带伤心碧！\n" NOR, me, target);
		target->receive_damage("jing", damage,me);
		target->receive_wound("jing", damage/2,me);
		target->add("neili", -damage);		
		me->add("neili",-3000);
		message_vision(HIW "$n忆起心中悲痛之处，莫名哀伤！不多时，已是吐血不止！\n" NOR, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		damage = damage/10 + random(damage/10) + me->query("jing")*1/100;
		damage = damage*(100-target->query_meridian())/100;
		message_vision(HIM "人皆有伤心之事，伤心之时！回首碧空无际，空引睇，但满眼芙蓉黄菊伤心丽！\n" NOR, me, target);
		message_vision(HIW "情到浓时人自醉， 爱到深处伤心时！情人的心，伤心的箭！\n" NOR, me, target);
		me->add("neili",-1000);
		target->receive_damage("jing", damage,me);
		target->receive_wound("jing", damage/2,me);
		message_vision(HIB "然伤心过后有情痴，情断天涯情亦深！人伤、心伤、情亦伤，伤心事、忘情、追忆！\n" NOR, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);
		if(target->query("eff_qi") < target->query("max_qi")) 
		{
			addqi = (target->query("eff_qi")-target->query("max_qi"))/3;
			target->add("eff_qi",addqi);
			target->add("qi",addqi);
			message_vision(HIW "酒不醉人人自醉，色不迷人人自迷，情到深处有情痴！\n" NOR, me, target);
		}
	}
}			
		
	me->start_busy(1);		
	return 1;
}

    
void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}