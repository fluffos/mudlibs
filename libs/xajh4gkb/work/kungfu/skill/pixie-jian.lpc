string query_parry_msg(object me, object weapon) {
  string msg;
  object my_weapon;

  if (!(my_weapon = me->query_temp("weapon"))) {
    if (!(my_weapon = me->query_temp("secondary_weapon")))
      return "";
  } else {
    if (!valid_enable(my_weapon->query("skill_type"))) {
      if (!(my_weapon = me->query_temp("secondary_weapon")))
        return "";
      else if (!valid_enable(my_weapon->query("skill_type")))
        return "";
    }
  }
  if (weapon)
    msg = weapon_vs_weapon_msg[random(sizeof(weapon_vs_weapon_msg))];
  else
    msg = unarmed_vs_weapon_msg[random(sizeof(unarmed_vs_weapon_msg))];
  msg = replace_string(msg, "$i", my_weapon->name());
  return msg;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}
string query_dodge_msg(object me, string limb) {
  me->set_temp("fight/dodge", 2 * me->query_skill("pixie-jian", 1));
  return dodge_msg[random(sizeof(dodge_msg))];
}
int valid_learn(object me) {
  return notify_fail("辟邪剑法只能通过研习《葵花宝典》来学习。\n");
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("jingli") < 1000 || (int)me->query("neili") < 1000)
    return notify_fail("你的内力或精力不够，没有办法练习辟邪剑法！\n");
  if (me->query("family/family_name") != "日月神教")
    return notify_fail("你还是先入了日月神教再来练习。\n");
  if ((string)me->query("gender") == "女性")
    return notify_fail("自古就没有女子可以使用.\n");
  if ((string)me->query("gender") == "男性")
    return notify_fail("欲练神功，必先自宫，欲使神功，快快进宫.\n");
  if ((string)me->query("genderbak") == "男性")
    return notify_fail("你个假太监，赶紧去割了.\n");
  if ((int)me->query_skill("pixie-jian", 1) < 2000)
    return notify_fail("你对辟邪剑法理解不够深刻，又从何练起！\n");
  if ((int)me->query_skill("pixie-jian", 1) > (int)me->query_skill("sword", 1))
    return notify_fail("你的剑法不够精湛！\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->add("neili", -100);
  me->add("jingli", -100);
  write("你按著所学练了一遍辟邪剑法。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "pixie-jian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon;
  weapon = me->query_temp("weapon");
  ap = me->query_skill(
    "pixie-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("pixie-jian", 1);
  damage2 = (int)me->query_skill(
    "pixie-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("pixie-jian", 1) < 100) return 0;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    if (me->query_skill_mapped("force") == "kuihua-xinfa") victim->add("jingli", -damage);
    message_vision(
      HIR "天下武功，唯快不破！只听“噗嗤”一声，$n被剑气割了一道伤口！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    if (me->query_skill_mapped("force") == "kuihua-xinfa") victim->add("jingli", -damage);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，剑随意走，手中" + weapon->name() + HIG "一挥，七八道人影攻向$n，将$n割裂成数块。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/riyue")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    if (me->query_skill_mapped("force") == "kuihua-xinfa") victim->add("jingli", -damage);
    message_vision(
      HIM "$N贯通日月神教武学精髓，一时间出剑快如鬼魅，$n连中数剑，鲜血淋漓。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}


//2018.9.5 阿飞改，重新启动自动连招
void do_interlink(object me, object victim) {
  int extra, max_enemy, max_att, i, j;
  object *enemy, weapon;

  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return;
  if (me->query_skill_mapped("sword") != "pixie-jian") return;
  //	if (me->query_skill_mapped("force") != "kuihua-xinfa") return;
  if ((int)me->query_skill("pixie-jian", 1) < 600) return;
  if (me->query("neili") < (int)me->query_skill("pixie-jian", 1) * 2) return;
  if (me->query_temp("autolian")) return;
  if (me->query_temp("cooldown")) return;
  //	if ( (string)me->query("gender")!="无性" || (string)me->query("genderbak")=="男性") return;
  if (me->is_busy()) return;
  if (me->query("auto_lian")) return;  //自动连招开关，使用auto命令来设置

  if ((int)me->query_skill("pixie-jian", 1) > 600) {
    enemy = me->query_enemy();
    if (!(max_enemy = sizeof(enemy))) return;
    if (playerp(me) && !me->query("xy_huiyuan")) return;
    max_att = ((int)me->query_skill("pixie-jian", 1) - 300) / (60 * max_enemy);
    if (me->query("jm/riyue")) {
      if (max_att * max_enemy > 150 + (int)me->query_temp("lianzhao_max_add") * 4) max_att = (150 + (int)me->query_temp("lianzhao_max_add") * 4) / max_enemy;
    } else {
      if (max_att * max_enemy > 50 + (int)me->query_temp("lianzhao_max_add") * 2) max_att = (50 + (int)me->query_temp("lianzhao_max_add") * 2) / max_enemy;
    }
    if (max_att < 1) max_att = 1;
    message_vision(MAG "$N身如鬼魅，手中" + weapon->name() + "一挥，无数剑影连绵不绝。\n" NOR, me);
    me->set_temp("autolian", 1);  //2017.3.3阿飞改，添加自动连招标记
    call_out("del_autolian", 3, me);
    me->add_temp("lianzhao", max_att);  //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
    extra = me->query_skill("pixie-jian", 1) / 3;
    if (me->query_skill_mapped("force") == "kuihua-xinfa") extra -= me->query_skill(
      "kuihua-xinfa",
      1
    ) / 5;  //2018.9.5阿飞改，不使用本门特内则减益，使用对应特内有加成
    if ((string)weapon->query("id") == "xiuhua zhen") extra = -me->query_skill("pixie-jian", 1) / 3;  //2018.3.25阿飞改，拿特殊武器有加成
    me->add_temp("apply/attack", -extra);
    me->add_temp("apply/damage", -extra);
    me->add_temp("apply/strength", -extra);
    for (i = 0; i < max_enemy; i++) {
      if (!objectp(enemy[i])) continue;

      for (j = 0; j < max_att; j++) {
        if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword" || me->query_skill_mapped("sword") != "pixie-jian") break;  //防止使用辟邪自动连后更换其他技能，终止自动连
        if (me->query_temp("cooldown")) break;  //防止使用辟邪自动连后使用其他pfm，终止自动连						
        if ((me->is_fighting(enemy[i]) || enemy[i]->is_fighting(me)) && enemy[i]->query("eff_qi") > 0) {
          if (environment(me) == environment(enemy[i])) {
            COMBAT_D->do_attack(me, enemy[i], me->query_temp("weapon"), TYPE_REGULAR);
          }
        } else
          break;
      }
    }
    me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记	
    me->add_temp("apply/attack", extra);
    me->add_temp("apply/damage", extra);
    me->add_temp("apply/strength", extra);
    me->add("neili", -20 * max_att);
  }
}
int is_interlink() {
  return 1;
}
void del_autolian(object me) {
  if (!objectp(me)) return;
  if (me->query_temp("autolian")) me->delete_temp("autolian");
}
