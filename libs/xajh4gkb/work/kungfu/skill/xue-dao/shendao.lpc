
// shendao.c  血刀「祭血神刀」

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	int damage,ap,dp,skill;
	string msg;
	object weapon;

	if (!target ) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「祭血神刀」只能对战斗中的对手使用。\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
		return notify_fail(RED"装备刀才能使用「祭血神刀」？\n"NOR);
    if (me->is_busy())
        return notify_fail("你现在正忙着！\n");
	if ((int)me->query_skill("xue-dao", 1) < 500 )
		return notify_fail(WHT"你血刀刀法不够娴熟，使不出「祭血神刀」。\n"NOR);
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
//	if(!( me->query_temp("weapon")->id("xblade")))
//		return notify_fail(WHT"你必须手持血刀，才能使出「祭血神刀」。\n"NOR);
	if ((int)me->query_skill("xuedao-xinfa", 1) < 500 )
		return notify_fail(RED"你血刀心法火候不够，使不出「祭血神刀」。\n"NOR);
	if ((int)me->query("max_neili") < 200000)
		return notify_fail(RED"你内力修为不足，无法运足内力。\n"NOR);
	if ((int)me->query("neili") < 1000)	
		return notify_fail(HIC"你现在内力不够，没能将「祭血神刀」使完！\n"NOR);
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");		
//	if(me->query_skill_mapped("force")!="xuedao-xinfa")
//		return notify_fail("你未使用血刀心法，如何能使用血刀。\n");
//	if (me->query_skill_mapped("blade") != "xue-dao")
//		return notify_fail("你没正确激发该技能 。\n");
	if ((int)me->query("shen") > -10000)	
		return notify_fail(HIC"非邪恶之徒，不能使用「祭血神刀」！\n"NOR);
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

	skill=me->query_skill("xue-dao",1)/10;		
	ap = me->query("xyzx_sys/level") + me->query_skill("xue-dao", 1) + me->query_skill("blade") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	msg = HIC "$N右手持刀向左肩一勒，一阵血珠溅满刀面，紧接着右臂抡出，一片血光裹住刀影向$n当头劈落。\n\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	if ( random(ap) > dp/3 )
	{
		damage = -(int)me->query("shen")/100000+me->query_skill("xue-dao",1)/2+me->query_skill("xuedao-xinfa",1)/2;
		if (damage < 100) damage = 100;
		if (damage > 500000) damage = 500000;		
		if ( me->query_skill_mapped("force") == "xuedao-xinfa") damage += damage/5;	//2018.9.5阿飞改，不使用本门特内则减益，使用对应特内有加成
		if ((string)weapon->query("id") == "xblade") {damage += damage/5;}	//2018.3.25阿飞改，拿特殊武器有加成
		damage = damage*(100-target->query_meridian())/100;
		me->add("neili", -500);
		me->add("jingli", -500);
		target->add("neili",-damage);
		//if (!target->is_busy()) target->start_busy(random(3));
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/3,me);
		msg = HIR"\n$n疾忙侧身避让，但血刀疾闪，只觉眼前一阵血红，刀刃劈面而下，鲜血飞溅，惨声大嚎！\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/3 +"。\n" NOR);
	}
	else
	{
		msg = HIY"可是$n侧身避让，不荒不忙，躲过了$N的血刀。\n"NOR;
		message_vision(msg, me, target);
		me->add("neili", -200);
	}

    me->add("neili", -400);
    msg = HIC"$N手中的刀，血光一闪！你只觉眼前一红"NOR;
	message_vision(msg, me, target); 	
        me->add_temp("apply/strength", skill);
        me->add_temp("apply/damage", skill);		
	msg = RED  "<<<>>>血光一现！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = RED  "<<<<<>>>>>刀山血海！！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = RED  "<<<<<<>>>>>>血海深仇！！！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = RED  "<<<<<<<>>>>>>>血流成河！！！！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = RED  "<<<<<<<<>>>>>>>>血影狂刀！！！！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        me->add_temp("apply/strength", -skill);
        me->add_temp("apply/damage", -skill);
	
	if(!target->is_fighting(me)) target->fight_ob(me);
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}