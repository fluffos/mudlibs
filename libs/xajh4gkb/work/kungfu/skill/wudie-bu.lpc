//int force_damage() {return 60;}		//内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if (me->query("family/family_name")!="舞蝶仙")
		return notify_fail("你不是舞蝶仙传人，不能传授给你。\n");	
	if ( (int)me->query("per",1) < 25  )
		return notify_fail("舞蝶步如同蝴蝶翩翩起舞，以你的身姿恐怕只是毛毛虫吧。\n");
	if ((int)me->query_skill("wudie-xinjing", 1) < 100)
		return notify_fail("你的舞蝶心经火候不够，无法学习舞蝶步。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
    if ( me->query("gender") != "女性")
        return notify_fail("舞蝶步法明显只能女子学习。\n");	
    return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if( (int)me->query("qi") < 45 )
		return notify_fail("你的体力太差了，不能练舞蝶步。\n");
    if (me->query("family/family_name")!="舞蝶仙")
		return notify_fail("你不是舞蝶仙传人，练习不了舞蝶步。\n");	
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
    if ( me->query("gender") != "女性")
        return notify_fail("舞蝶步法明显只有女子才能练习。\n");		
	me->receive_damage("qi", 35);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"wudie-bu/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;

	ap = me->query_skill("wudie-bu", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("sword",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("wudie-bu", 1);
	damage2 = me->query_skill("wudie-bu", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("wudie-xinjing",1) < 300 || me->query_skill("wudie-bu", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="wudie-xinjing" ) return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIG"$N战斗中穿花弄蝶，伴随蝴蝶翩翩起舞，$n被舞姿迷住，一时放弃了攻击。\n"NOR;
		if (!ob->is_busy()) ob->start_busy(1);
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，身体轻灵，化作蝴蝶，蝶翼带气剑气，“嗤”的一声，将$n割开了一道口子。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/wudie") )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );
		message_vision(HIB"$N明悟舞蝶仙精髓，身姿轻盈，随着$n攻势而起，随遇随安，待$n收招，以迅雷之势发出一道剑气！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
}
