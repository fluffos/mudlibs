#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

#define DANG "「" HIW "神威浩荡" NOR "」"

inherit F_SSERVER;


int perform(object me, object target)
{
	object weapon, cloth;
	int ap, dp, damage, wp, cl;
	string msg;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail(DANG "只能对战斗中的对手使用。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
	if (objectp(me->query_temp("weapon")))
		return notify_fail(DANG "只能空手施展。\n");
	if ((int)me->query_skill("xiantian-qigong", 1) < 300 && (int)me->query_skill("tiangang-zhengqi", 1) < 300)
		return notify_fail("你对全真教内功不甚了解，难以施展" DANG "。\n");
	if ((int)me->query_skill("haotian-zhang", 1) < 300)
		return notify_fail("你的昊天掌修为不够，难以施展" DANG "。\n");	
	if ((int)me->query_skill("jinyan-gong", 1) < 300)
		return notify_fail("你的金雁功修为不够，难以施展" DANG "。\n");	
	if(me->is_busy())
		return notify_fail("你现在正忙。\n");
	if (me->query("max_neili") < 100000)
		return notify_fail("你的内力修为不足，难以施展" DANG "。\n");
//	if (me->query_skill_mapped("unarmed") != "haotian-zhang")
//		return notify_fail("你没有激发先天功为拳脚，难以施展" DANG "。\n");
//	if( me->query_skill_mapped("force",1) != "xiantian-qigong" && me->query_skill_mapped("unarmed") != "tiangang-zhengqi")	
//		return notify_fail("你不使用先天内功，无法使用本门绝技！\n");
	if (me->query("neili") < 1000)
		return notify_fail("你现在的真气不足，难以施展" DANG "。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HIW "只见$N" HIW "双目精光四射，双掌陡然一振，将体内积蓄的"
	      "昊天掌力云贯推出，顿时呼啸\n声大作，昊天掌力层层叠叠，宛如"
	      "涛浪般涌向$n" HIW "。\n" NOR;
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	ap = me->query("xyzx_sys/level") + me->query_skill("haotian-zhang", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	damage = me->query("xyzx_sys/level") + me->query_skill("haotian-zhang", 1) + me->query_skill("unarmed") + me->query_skill("force");
	damage = damage/2 + random(damage/2);
	damage = damage*(100-target->query_meridian())/100;
	if (random(ap) > dp/3)
	{

		if (me->query("max_neili") > target->query("max_neili"))
		{
			damage *=2;
			target->receive_damage("jing",damage,me);
			target->receive_wound("jing",damage/2,me);
			me->add("neili",-300);	
			msg = HIR "便在$n" HIR "微微一愣间，$N" HIR "罡风已然及体，$p" HIR "一声哀嚎，全身骼络尽数断裂。\n"NOR;
			msg += RED" $n受伤过重，已经有如风中残烛，随时都可能断气。\n"NOR;
			message_vision(msg, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage*2 +"，内伤为"+ damage +"。\n" NOR);
		}
		else
		{
			target->receive_damage("qi",damage,me);
			target->receive_wound("qi",damage/2,me);
			me->add("neili", -150);
//			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
			msg =   HIR "$N" HIR "的罡劲登时瓦解了$n" HIR "的护体真气，$p" HIR "真元受损，接连喷出数口鲜血。\n" NOR;
			message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法

			if (objectp(weapon = target->query_temp("weapon")) && random(10)==0)
			{
				wp = weapon->name();
				msg = HIW "只听“锵”的一声脆响，$n" HIW "手"
				       "中的" + wp + HIW "在$N" HIW "内力激荡"
				       "下应声而碎，脱手跌落在地上。\n" NOR;
				message_vision(msg, me, target);
				me->add("neili", -150);
//				weapon->set("consistence", 0);	//这代码什么作用？
				weapon->unequip();
				weapon->move(environment(target));
				weapon->set("name", "断掉的" + weapon->query("name"));
				weapon->set("item_old_value", weapon->query("value"));
				weapon->set("value", 0);
				weapon->set("backold_weapon_prop", weapon->query("weapon_prop"));
				weapon->set("weapon_prop", 0);
			}
			else if (objectp(cloth = target->query_temp("armor/armor")) && random(10)==0)
				{
					cl = cloth->name();
					msg = HIW "只听“轰”的一声闷响，$n" HIW "身"
					       "着的" + cl + HIW "在$N" HIW "内力激荡"
					       "下应声而裂，化成一块块碎片。\n" NOR;
					message_vision(msg, me, target);
					me->add("neili", -150);
//					cloth->set("consistence", 0);	//这代码什么作用？
					cloth->unequip();
					cloth->move(environment(target));
					cloth->set("name", "破碎的" + cloth->query("name"));
					cloth->set("item_old_value", cloth->query("value"));
					cloth->set("value", 0);
					cloth->set("backold_armor_prop", cloth->query("armor_prop"));
					cloth->set("armor_prop", 0);
				}
				else if (objectp(cloth = target->query_temp("armor/cloth")) && random(10)==0)
					{
						cl = cloth->name();
						msg = HIW "只听“轰”的一声闷响，$n" HIW "身"
						       "着的" + cl + HIW "在$N" HIW "内力激荡"
						       "下应声而碎，化成一块块碎片。\n" NOR;
						message_vision(msg, me, target);
						me->add("neili", -150);
//						cloth->set("consistence", 0);	//这代码什么作用？
					cloth->unequip();
					cloth->move(environment(target));
					cloth->set("name", "破碎的" + cloth->query("name"));
					cloth->set("item_old_value", cloth->query("value"));
					cloth->set("value", 0);
					cloth->set("backold_armor_prop", cloth->query("armor_prop"));
					cloth->set("armor_prop", 0);
					}
		}
	}
	else
	{
		me->add("neili", -120);
		msg = CYN "可是$p" CYN "知道$P" CYN "这招的厉害，不敢硬接，当即斜跃躲避开来。\n" NOR;
		message_vision(msg, me, target);
	}

	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}