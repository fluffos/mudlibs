#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	string msg;
	int flag,damage,ap,dp;
	flag = 1;
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「我心化云龙」只能对战斗中的对手使用。\n");
	if (objectp(me->query_temp("weapon")))
		return notify_fail("你必须空手才能使用「我心化云龙」。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
    if(me->is_busy())
        return notify_fail("你现在正忙着！\n");
	if( (int)me->query_skill("yunlong-shengong", 1) < 1000 )	
		return notify_fail("你的本门神功不够娴熟，无法施展云龙抓。\n");
	if( (int)me->query_skill("yunlong-zhua", 1) < 1000 )
		return notify_fail("你的云龙爪不够娴熟，不会使用「我心化云龙」。\n");
	if( (int)me->query_skill("yunlong-shou", 1) < 1000 )
		return notify_fail("你的云龙手不够娴熟，不会使用「我心化云龙」。\n");
	if( (int)me->query_skill("yunlong-jian", 1) < 1000 )
		return notify_fail("你的云龙剑不够娴熟，不会使用「我心化云龙」。\n");	
	if ((int)me->query("max_neili") < 200000)
		return notify_fail("你的内力修为不足，难以施展「我心化云龙」。\n");
	if ((int)me->query("neili") < 10000)
		return notify_fail("你的内力不够，无法使用「我心化云龙」。\n");	
	if ((int)me->query("max_jingli") < 500000)
		return notify_fail("你的精力修为不足，难以施展「我心化云龙」。\n");
	if ((int)me->query("jingli") < 10000)
		return notify_fail("你的精力不够，无法使用「我心化云龙」。\n");	
	if (me->query_skill_mapped("force") != "yunlong-shengong" )
		return notify_fail("不使用本门内功，如何能使用本门绝技。\n");
	if (me->query_skill_mapped("unarmed") != "yunlong-shou")
		return notify_fail("你没正确激发该技能 。\n");
	if (!(int)me->query("breakup"))
		return notify_fail("你任督二脉未通,无法使用[" HIR "我心化云龙" NOR "]\n"NOR); 
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	message_vision(HBWHT "$N贯通云龙门武学，使出了云龙门的绝学之精髓！\n" NOR, me, target);	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1
	ap = me->query("xyzx_sys/level") + me->query_skill("yunlong-shou", 1)+me->query_skill("yunlong-jian",1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	msg = HIB "$N不知道从哪里学来韦爵爷的下流招数，使出了美人三招，招招抓向$n的咪咪！\n"NOR;
	message_vision(msg, me, target);
	
	msg = HIY "$N左手抓向$n的咪咪！\n"NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
	msg = HIY "$N一个转身，右手又抓向$n的咪咪！\n"NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
	msg = HIY "$N直扑过来，双手再次抓向$n的咪咪！\n"NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
	
	if( random(ap) > dp/3 )
	{
		if ( me->query("gender") == "男性" && target->query("gender") == "女性") flag = 3;
		if ( me->query("gender") == "女性" && target->query("gender") == "男性") flag = 1;
		damage = me->query_skill("yunlong-shou",1)*flag +me->query_skill("yunlong-shengong",1) +me->query_skill("yunlong-zhua",1)*flag;
		damage = damage/2 + random(damage/2);
		damage = damage*(100-target->query_meridian())/100;
        target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);
		target->apply_condition("no_force", 10);
		me->add("neili", -500);
		me->add("jingli", -1000);
		msg = HIW "$n被抓中咪咪，满面通红，嗔骂道：好一个下流胚子！。\n" NOR;
		msg += HIM "$n似乎被抓中了乳交穴！一时娇喘不已，媚骨销魂！。\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		damage = me->query_skill("yunlong-shou",1)+me->query_skill("yunlong-zhua",1);
		damage = damage/2 + random(damage/2);
		damage = damage*(100-target->query_meridian())/100;
		me->add("neili",-300);
        me->receive_damage("qi",damage,target);
		me->receive_wound("qi",damage/2,target);		
		msg = HIC "我是女汉子，我是平胸我怕谁。反手就是几巴掌扇了过去，打的$n晕头转向！\n" NOR;
		message_vision(msg, target, me, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}

	
	
if (me->query_skill("yunlong-shou",1)>2000 && me->query_skill("yunlong-jian",1)>2000)
{
	if ( me->query("gender") == "男性" && target->query("gender") == "女性") flag = 3;
	if ( me->query("gender") == "女性" && target->query("gender") == "男性") flag = 1;
	msg = HIB "$N神情突然大变，从淫笑变为肃穆！周围红叶纷飞！\n"NOR;
	msg += HIB "$N舞动红叶，身姿娇柔，盘旋而起，全身扭动起来，似乎有衣物飘出！\n"NOR;
	message_vision(msg, me, target);
	if( random(ap) > dp/3 )
	{
		damage = me->query_skill("yunlong-shou",1)*flag +me->query_skill("yunlong-zhua",1)*flag+ me->query_skill("yunlong-jian",1) + me->query_skill("yunlong-shengong",1) +me->query_skill("yunlong-shenfa",1) +me->query_skill("unarmed",1);
		damage = damage/3 + random(damage/3);
		damage = damage*(100-target->query_meridian())/100;
        target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);
		target->apply_condition("no_equip", 20);
		me->add("neili", -2000);
		me->add("jingli", -3000);
		msg = HIW "$n被舞姿吸引，跟着一起舞动起来，形似神不似！。\n" NOR;
		msg += HIM "$n心智糜烂，忘乎所以，似乎想脱衣服！。\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		damage = me->query_skill("yunlong-shou",1) + me->query_skill("yunlong-jian",1) + me->query_skill("yunlong-shengong",1);
		damage = damage/3 + random(damage/3);
		damage = damage*(100-me->query_meridian())/100;
		me->add("neili",-1000);
		me->add("jingli", -1000);
        me->receive_damage("qi",damage,target);
		me->receive_wound("qi",damage/2,target);	
		me->apply_condition("no_equip", 20);		
		msg = HIC "$n视红粉如骷髅，一掌拍了过去，一切幻象如云烟！\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}

}


if (me->query_skill("yunlong-shou",1)>3000 && me->query_skill("yunlong-jian",1)>3000)
{
	if ( me->query("gender") == "男性" && target->query("gender") == "女性") flag = 10;
	if ( me->query("gender") == "女性" && target->query("gender") == "男性") flag = 1;
	msg = HIB "突然一阵龙吟，$N化为盘龙，腾空而起！\n"NOR;
	msg += HIB "$N高唱道：红叶舞秋山，我心化云龙！龙遨九天风云变，敢叫青天换日月！\n"NOR;
	message_vision(msg, me, target);
	if( random(ap) > dp/3 )
	{
		if (me->query("jm/yunlong")) damage = me->query_skill("yunlong-shou",1)*me->query("str",1)*3/20 + me->query_skill("yunlong-jian",1)*me->query("str",1)*3/20 + me->query_skill("yunlong-shengong",1)*me->query("str",1)*3/20 +me->query_skill("yunlong-shenfa",1) +me->query_skill("unarmed",1)+me->query_skill("sword",1)+me->query_skill("force",1)+me->query_skill("yunlong-shou",1)*flag +me->query_skill("yunlong-zhua",1)*flag;
		else damage = me->query_skill("yunlong-shou",1)*me->query("str",1)/10 + me->query_skill("yunlong-jian",1)*me->query("str",1)/10 + me->query_skill("yunlong-shengong",1)*me->query("str",1)/10 +me->query_skill("yunlong-shenfa",1) +me->query_skill("unarmed",1)+me->query_skill("sword",1)+me->query_skill("force",1)+me->query_skill("yunlong-shou",1)*flag +me->query_skill("yunlong-zhua",1)*flag;
		damage = damage/3 + random(damage/3) + target->query("qi")*1/100;
		damage = damage*(100-target->query_meridian())/100;
		if (random(4)==1) 
		{
			target->map_skill("unarmed");	//下特殊拳脚
			message_vision(RED"$n被抓中咪咪，满脸通红，使不开拳脚。\n"NOR,me, target);
		}
        target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);
		me->add("neili", -3000);
		me->add("jingli", -3000);
		msg = HIW "$N化作云龙，翻云倒雾，试图改天换地！一招「万里一点红」向$n击来。\n" NOR;
		msg += HIM "$n如被雷击，眉心一点红！身体摇摇欲坠。。\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		damage = me->query_skill("yunlong-shou",1)*me->query("str",1)/10 + me->query_skill("yunlong-jian",1) +me->query_skill("yunlong-shenfa",1) +me->query_skill("unarmed",1);
		damage = damage/3 + random(damage/3);
		damage = damage*(100-target->query_meridian())/100;
		me->add("neili",-1000);
		me->add("jingli", -1000);
        target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);		
		msg = HIC "$n大吼一声：真龙面前，是条龙也得给老子趴着！！！\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
		
}
	me->start_busy(1);	
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}