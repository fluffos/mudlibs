int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query("family/family_name") != "胡苗世家")
    return notify_fail("你不是关外胡家或中原苗家弟子，没法传授给你。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练天偿掌法必须空手。\n");
  if ((int)me->query_skill("lengyue-shengong", 1) < 100)
    return notify_fail("你的冷月神功火候不够，无法练天偿掌法。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力修为太弱，无法练天偿掌法。\n");
  if ((int)me->query_skill("unarmed", 1) < 100)
    return notify_fail("你的基本拳脚火候不够，无法练习天偿掌法。\n");
  if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("tianchang-zhang", 1))
    return notify_fail("你的基本拳脚水平有限，无法领会更高深天偿掌法。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");

  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query("family/family_name") != "胡苗世家")
    return notify_fail("你不是关外胡家或中原苗家弟子，没法练习。\n");
  if ((int)me->query("qi") < 70)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 70)
    return notify_fail("你的内力不够练天偿掌法。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("qi", 55);
  me->add("neili", -62);

  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "tianchang-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;

  ap = me->query_skill(
    "tianchang-zhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("tianchang-zhang", 1);
  damage2 = (int)me->query_skill(
    "tianchang-zhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "lengyue-shengong",
    1
  ) < 100 || me->query_skill("tianchang-zhang", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "lengyue-shengong") return 0;
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIR "只听“噗” “嚓” “刺” “咻”几声，$n后退几步，嘴角溢出一丝鲜血。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，一式『日月同辉』，借天之力，将$n击飞。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/humiao")) {
    me->add("neili", -100);
    COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_REGULAR);
    COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIM "$N贯通胡苗两家武学，左手金光，右手冷月，接连两招将$n夹击其中。\n" NOR, me, victim);
    return;
  }
}
