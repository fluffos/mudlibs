// suck.c
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int exert(object me, object target) {
  int ap, dp, damage;
  if (target == me)
    target = offensive_target(me);
  if (!objectp(target) || target->query("id") == "mu ren")
    return notify_fail("你要吸取谁的内力？\n");
  //	if ( me->query_temp("sucked") )
  //		return notify_fail("你刚刚吸取过内力！\n");
  if ((int)me->query_skill("xixing-dafa", 1) < 300)
    return notify_fail("你的吸星大法功力不够，不能吸取对方的内力！n");
  if (me->query_skill_mapped("force") != "xixing-dafa")
    return notify_fail("你没有使用吸星大法。\n");
  if (me->query_temp("apply/shade_vision"))
    return notify_fail("你都隐身了，还想吸取别人气血？这不太合适吧。\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
  //    if ( me->query("gender") == "无性")
  //        return notify_fail("你无根无性，阴阳不调，难以使用吸星大法。\n");	
  if ((int)me->query("neili", 1) < 1000)
    return notify_fail("你的内力不够，不能使用吸星大法。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if ((int)target->query("max_neili") <= 0)
    return notify_fail(target->name() + "没有任何内力！\n");
  if ((int)target->query("no_suck"))
    return notify_fail(target->name() + "没有任何内力！\n");
  if ((int)target->query("qi") < 100 || (int)target->query("jing") < 100 || !living(target))
    return notify_fail(target->name() + "已经濒临死亡，你已经无法从他体内吸取任何精血了！\n");
  if (me->is_busy()) return notify_fail("你正忙着呢。\n");
  if (me->query(
    "qi",
    1
  ) > me->query("max_qi", 1) * 2 || me->query("jing", 1) > me->query("max_jing", 1) * 2)
    return notify_fail("你只觉全身气血澎湃已是难以控制，似乎无法吸纳更多的精血。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
  //	 if ( !me->query("xy_huiyuan") && target->query("id") == "nai niu" && domain_file(base_name(environment(me))) == "party" )
  //		return notify_fail(HIY"帮会中奶牛只提供给注册会员使用，你无法吸取。\n"NOR);

  message_vision(HIY "$N手臂猛地长出正抓在$n右手腕上。突然之间，$n猛觉右腕“内关”“外关”两处穴道中精气源源外泄！\n\n" NOR, me, target);
  me->add("neili", -100);
  me->add("jingli", -100);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  if (living(target)) {
    me->kill_ob(target);
    if (!target->is_killing(me)) target->kill_ob(me);
  }
  ap = me->query("xyzx_sys/level") + me->query_skill("xixing-dafa", 1) + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("force");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  if (random(ap) > dp / 3) {
    tell_object(target, HIR "你只觉得手腕上“内关”“外关”两处穴道便如开了两个大缺口，立时全身精气急泻而出，有如河水决堤，再也难以堵截！\n" NOR);
    damage = (int)me->query_skill("xixing-dafa", 1) + target->query("jiali");
    damage = damage / 2 + random(damage / 2);
    target->receive_damage("qi", damage, me);
    target->receive_damage("jing", damage, me);
    tell_object(me, HIG "你觉得" + target->name() + "的精血(" + damage + ")自手掌源源不绝地流了进来。\n" NOR);
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，精神外伤为"+ damage +"。\n" NOR);
  } else {
    message_vision(HIY "可是$p看破了$P的企图，机灵地闪了开去。\n" NOR, me, target);
  }
  me->start_busy(1);
  return 1;
}
void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
