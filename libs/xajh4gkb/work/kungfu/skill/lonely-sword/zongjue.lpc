//独孤九剑之总诀式 zongjue.c	
// by godzilla 99.03.06

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon,weapon2;
	int skill,damage,ap,dp,busy_time;	
	string msg;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「总决式」只能在战斗中使用。\n"); 	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("「 总决式 」必须用剑才能施展。\n"); 
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if( (int)me->query_skill("lonely-sword", 1) < 100 )     	
		return notify_fail("你的「 独孤九剑 」不够娴熟，不会使用「总决式」。\n");   
//	if (me->query_skill_mapped("sword") != "lonely-sword")
//		return notify_fail("你没正确激发该技能 。\n");  	
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够了。\n");	
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的内力不够了。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	damage = me->query_skill("sword",1) +  (int)me->query_skill("lonely-sword", 1)*5;	
	skill = me->query_skill("lonely-sword",1);  
	ap = me->query("xyzx_sys/level") + me->query_skill("lonely-sword", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	busy_time = (30*skill)/(skill+2000);
	if( stringp(target->query("inborn")) && (string)target->query("inborn")==YEL"冷静"NOR) busy_time = (30*skill)/(skill+2000)*7/10;
	msg = HIC "$N孤独百年，领悟问魂归处，弹指间信手挥出,「独孤九剑」总诀式信手挥出，剑影闪动"+weapon->name() +""HIC"直直击向$n。\n" NOR;
	message_vision(msg, me, target);  
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	damage = damage/2 + random(damage/2);
	damage = damage*(100-target->query_meridian())/100;
if ( random(ap) > dp/3) 
{                   		     	 	        
	msg = HIC "$N神游虚外,已然忘我,手中" + weapon->name() + HIC "自然而然随意击划,剑式变幻九剑诀连绵递出！\n" NOR;      	
	message_vision(msg, me, target);	
	msg = HIR"倒剑式！\n"NOR;	
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
	msg = HIY"逆剑式！\n"NOR;	
        message_vision(msg, me, target);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);	
	msg = HIC"落剑式！\n"NOR;       	
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
	msg = HIG"摇剑式！\n"NOR;               	
		message_vision(msg, me, target);	
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);	
	msg = HIM"荡剑式！\n"NOR;       	
		message_vision(msg, me, target);	
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);	
	msg = CYN"浪剑式！\n"NOR;       	
		message_vision(msg, me, target);	
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);	
	msg = RED"挫剑式！\n"NOR;       	
		message_vision(msg, me, target);	
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);	
	msg = HIB"离剑式！\n"NOR;	
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
	msg = HIW"剑气式！\n"NOR;	
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
	target->receive_damage("jing", damage,me);         	
	target->receive_wound("jing", damage/2,me);              	
	me->add("jingli", -1000);
	msg = HIR "$N随手几招向$n刺来,一看只下尽全是刺向$n武功的弱点，$n心中一慌.....不由的发出的怪叫声。！\n"NOR; 
	message_vision(msg, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	if (objectp(weapon2 = target->query_temp("weapon")) )	
	{
//		weapon2->move(me);
		weapon2->unequip();
		weapon2->move(environment(me));
		me->add("jingli", -100);
		message_vision(HIW"$n莫明其妙，百思不解为何$N随意一剑竟能如此神妙，只好放弃"NOR+weapon2->name()+NOR HIW"！\n" NOR, me, target);
	} else
	{    		
		target->add("jingli",-damage );
		if (!target->query_temp("block_msg")) 
		{
			target->set_temp("block_msg/all",1);	//致盲
			call_out("tuwu_end", 5+busy_time, me, target);
			message_vision(	HIR "$N手中的剑发出无数道的剑气，一道一道的剑气向$n刺去！$n两眼一黑，$n啥也看不见了！！\n" NOR, me, target);
		}
		me->add("jingli", -1000);
	}	

}
else 
{                	
	msg = HIG "$n情急智生，向后一跳...逃出了剑气的范围。\n" NOR;                 	
	message_vision(msg, me, target);	
	me->add("jingli", -200);
}
	me->start_busy(1);
	return 1;
}

void tuwu_end(object me, object target)
{
	if ( !target ) return;
	target->delete_temp("block_msg/all");
    message_vision("$N抹了抹满脸的"HIR"鲜血"NOR"，终于睁开了眼。\n", target);	
	tell_object(target, HIR"你终于抹掉了满脸的鲜血，看到了周围的情景。\n"NOR);
	return;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}