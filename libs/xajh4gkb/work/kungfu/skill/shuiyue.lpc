int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "痴心妄想门")
    return notify_fail("你不是痴心门人，无法学习。\n");
  if ((int)me->query("dex", 1) < 25)
    return notify_fail("我派轻功对身法的要求较高，你看起来笨手笨脚的。\n");
  if ((int)me->query_skill("wangran-xinfa", 1) < 100)
    return notify_fail("你的枉然心法火候不够，无法学习镜花水月。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  return 1;
}


string perform_action_file(string action) {
  return __DIR__ "shuiyue/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int ap, dp, j, damage1, damage2;

  ap = me->query_skill(
    "shuiyue",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "sword",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = me->query_skill("shuiyue", 1);
  damage2 = me->query_skill(
    "shuiyue",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "wangran-xinfa",
    1
  ) < 300 || me->query_skill("shuiyue", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force")!="wangran-xinfa" ) return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = HIC "$N使出镜花水月精髓，幻化出一片幻影，$n的攻击大部分打在$N的影子上！\n" NOR;
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(msg, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N顿悟" + me->query("cognize") + HIY "，身形化作一片幻影，$n一击不中正待变招，哪知$N招式已至，硬受一招，口吐鲜血。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/chixin")) {
    j = -(damage / 3 + random(damage / 3));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    message_vision(
      HIB "$N领悟痴心妄想的精髓，幻化出一片幻影，$n似乎击中的$N的数个幻影！待$N身形现身，已是中招。\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
}
