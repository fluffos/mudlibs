int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query_skill("dodge", 1) <=me->query_skill("shaolin-shenfa", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    if (me->query("family/family_name")!="少林派")
		return notify_fail("你不是佛门中人，无法学习少林绝技。\n");	
	if (!me->query("jm/songshan"))
		return notify_fail(CYN"这嵩山派与我寺同处一山，欲夺取武林盟主之位，我少林表示不服。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否先为我少林潜入嵩山派夺取其秘密？我寺将来必有厚报。\n"NOR);
	if ((int)me->query("family_score")<10)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我寺功夫恐怕不能传授于你。\n"NOR);	
    if ((int)me->query_skill("hunyuan-yiqi", 1) < 100 && (int)me->query_skill("yijinjing", 1) < 100 )
		return notify_fail("你的少林内功火候不够，无法学习少林武技。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
    return 1;
}
string query_dodge_msg(object me,string limb)
{
	me->set_temp("fight/dodge",me->query_skill("shaolin-shenfa",1)*3/2);
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if( (int)me->query("qi") < 40 )
        return notify_fail("你的体力太差了，不能练少林身法。\n");
    if (me->query("family/family_name")!="少林派")
		return notify_fail("你不是佛门中人，偷练少林绝技会走火入魔。\n");	
	if (!me->query("jm/songshan"))
		return notify_fail(CYN"这嵩山派与我寺同处一山，欲夺取武林盟主之位，我少林表示不服。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否先为我少林潜入嵩山派夺取其秘密？我寺将来必有厚报。\n"NOR);
	if ((int)me->query("family_score")<10)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我寺功夫恐怕不能传授于你。\n"NOR);		
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");	
    me->receive_damage("qi", 30);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"shaolin-shenfa/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;
	damage1 = me->query_skill("shaolin-shenfa", 1);
	ap = me->query_skill("shaolin-shenfa", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("sword",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage2 = me->query_skill("shaolin-shenfa", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if ((me->query_skill("yiing-force",1) < 300 && me->query_skill("damo-force",1) < 300 && me->query_skill("hunyuan-yiqi",1) < 300 && me->query_skill("yijinjing",1) < 300) || me->query_skill("shaolin-shenfa", 1) < 300) return damage;
//	if (me->query_skill_mapped("force") != "yijing-force" && me->query_skill_mapped("force") != "damo-force" && me->query_skill_mapped("force") != "hunyuan-yiqi" && me->query_skill_mapped("force") != "yijinjing") return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIG"少林强则国强，少林富则国富，少林自由则国自由。我为少林，则我自由！\n"NOR;
		if (!ob->is_busy()) ob->start_busy(1);
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，双足一点，一式「"+HIG+"一苇渡江"+HIY+"」眨眼侵入$n身边，使出沾衣十八贴将$n撞飞。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/shaolin") )
	{
		j = -(damage+random(damage));
		me->add("neili", -100 );
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		if (!ob->is_busy()) ob->start_busy(1);
		message_vision(HIB"人不风流枉少年，然一入佛门，皆为空！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
}
