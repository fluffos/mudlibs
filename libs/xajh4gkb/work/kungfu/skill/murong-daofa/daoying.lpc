#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int skill1, skill2, skill3;
  string msg;
  object weapon;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("刀影掌只能对战斗中的对手使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢，哪有空运功？\n");
  if ((int)me->query_skill("murong-daofa", 1) < 300)
    return notify_fail("你的刀法还未练成，不能使用刀影掌！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你手里没有刀，无法使用刀影掌！\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query_skill("xingyi-zhang", 1) < 300)
    return notify_fail("你的掌法还未练成，不能使用刀影掌！\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你现在内力不足，不能使用刀影掌！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够了。\n");
  if ((int)me->query_skill("shenyuan-gong", 1) < 300)
    return notify_fail("你的神元功火候太浅。\n");
  //	if ( !wizardp(me) && me->query_skill_mapped("force") != "shenyuan-gong")
  //		return notify_fail("不使用本门内功，如何使用本门绝学!\n"); 
  //	if ( !wizardp(me) && me->query_skill_mapped("blade") != "murong-daofa")
  //		return notify_fail("你未使用慕容刀法，如何使用本门绝学!\n"); 
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  msg = HIC "$N刀中夹杂掌影，掌中夹杂刀光，使出慕容刀法的刀影掌，刀光掌影虚虚实实。 \n" NOR;
  message_vision(msg, me, target);
  skill1 = me->query_skill("douzhuan-xingyi", 1) / 5;
  skill2 = me->query_skill("murong-daofa", 1) / 10;
  skill3 = me->query_skill("xingyi-zhang", 1) / 10;
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  me->add("neili", -300);
  me->add("jingli", -100);
  me->add_temp("apply/strength", skill3);
  me->add_temp("apply/attack", skill2);
  me->add_temp("apply/damage", skill1);
  msg = YEL "\n$N大吼一声使出刀影掌，掌随刀走，刀光中夹杂着阵阵掌风一起奔向$n！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = YEL "$N弃刀换掌，身形飞转！\n" NOR;
  weapon->unequip();
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = YEL "$N弃掌换刀，身形飞转！\n" NOR;
  weapon->wield();
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->add_temp("apply/strength", -skill3);
  me->add_temp("apply/attack", -skill2);
  me->add_temp("apply/damage", -skill1);
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
