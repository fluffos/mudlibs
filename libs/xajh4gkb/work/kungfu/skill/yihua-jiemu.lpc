int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if( (int)me->query("qi") < 40 )
        return notify_fail("你的体力太差了，不能练移花接木。\n");
    if ((int)me->query_skill("mingyu-shengong", 1) < 300)
        return notify_fail("你的冥雨神功火候太浅，不能练移花接木。\n");
	if (me->query("family/family_name")!="移花宫")
		return notify_fail("你不是移花宫弟子，偷学移花接木？宫主知道了你就完了！！。\n"); 
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n"); 
    me->receive_damage("qi", 30);
    return 1;
}
int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ( !wizardp(this_player()) && (me->query("family/family_name") != "移花宫"))
		return notify_fail("移花接木博大精深, 非移花宫弟子不传。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
//	if ( me->query("gender") != "女性")
//		return notify_fail("移花接木乃移花宫宫主所创,向来不传男子。\n");
    if( (int)me->query("dex",1) < 25 )
        return notify_fail("你的身法太差了，不能练移花接木。\n");
	if ((int)me->query_skill("mingyu-shengong", 1) < 300)
		return notify_fail("你的冥雨神功还不到家怎么能学移花接木呢？\n");
	if ((int)me->query_skill("force", 1) < 500)
		return notify_fail("就这么点基本内功还想学移花接木？\n");
	if ((int)me->query("max_neili", 1) < 100000)
		return notify_fail("就这么点内力还想学移花接木？\n");
	if ((int)me->query_skill("dodge", 1) < (int)me->query_skill("yihua-jimu", 1))
		return notify_fail("你的基本轻功火候还不够，小心走火入魔！\n");
	if ((int)me->query("score",1) < 10000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(100)==1) me->add("score",-10);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"yihua-jiemu/"  + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2,maxnei;
	object weapon2;
	weapon2 = ob->query_temp("weapon");
	ap = me->query_skill("yihua-jiemu", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("parry",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("yihua-jiemu", 1);
	damage2 = me->query_skill("yihua-jiemu", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	maxnei = me->query("max_neili");
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("mingyu-shengong",1) < 300 || me->query_skill("yihua-jiemu", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="mingyu-shengong" ) return damage;
	if ((int)me->query("jm/yihua") ) maxnei = me->query("max_neili")*2;
	if ( random(6) == 0 && me->is_busy() && me->query_skill_mapped("force")=="mingyu-shengong" )
	{
        msg = HIC"$N暗运移花接木，本来忙乱的动作快了起来!\n"NOR;
		me->add("neili", -100 );
		j = -(damage/3+random(damage/3));
		me->start_busy(1);
		message_vision(msg, me, ob);
		return j;
	}
	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIC"$N运起冥雨神功 全身内力爆发，浮现出一层阴柔的劲气！！\n"NOR;
		if (!ob->is_busy()) ob->start_busy(1);
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，周身衣衫鼓荡，使用移花接木的巧劲将$n力道转移回去！！\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/yihua") )
	{
		msg = HIB"$N融汇移花宫武学精髓，"NOR;
		if (objectp(weapon2 = ob->query_temp("weapon")))
		{
			msg += msg_weapon[random(sizeof(msg_weapon))];
			if(random(3)==0)
			{
				msg += HIW"结果$n一个抵挡不住，手中"+weapon2->name()+HIW"脱手飞出！\n"NOR;
				weapon2->unequip();
				weapon2->move(environment(ob));
				message_vision(msg, me, ob);
			}
			else
			{
				msg += HIW"$n手中"+weapon2->name()+HIW"立于前方，$N的力道卸在"+weapon2->name()+HIW"上，将$n震的吐出一口鲜血！\n"NOR;
				ob->receive_damage("qi",damage1,me);
				ob->receive_wound("qi",damage1/2,me);
				message_vision(msg, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
			}
		}
		else
		{
			msg += msg_unarmed[random(sizeof(msg_unarmed))];
			ob->receive_damage("qi",damage1,me);
			ob->receive_wound("qi",damage1/2,me);
			msg += "结果$n喷出一口鲜血！\n"NOR;
			message_vision(msg, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		}
		j = -(damage/3+random(damage/3));
		me->add("neili", -100 );
		return j;
	}
	if ( random(8) == 4 )
	{
        msg = RED"$N运起冥雨神功，全身内力源源不断的涌出，身上的伤好了很多！\n"NOR;
		me->add("neili", -100 );
		j = -(damage/3+random(damage/3));
		if (me->query("neili") < maxnei) me->add("neili",damage1+damage2);
		me->add("eff_qi",damage1+damage2);
		if (me->query("eff_qi")>me->query("max_qi")) me->set("eff_qi",me->query("max_qi"));
		me->add("qi",damage1+damage2);
		if (me->query("qi")>me->query("eff_qi")) me->set("qi",me->query("eff_qi"));
		message_vision(msg, me, ob);
		return j;
	}
}

