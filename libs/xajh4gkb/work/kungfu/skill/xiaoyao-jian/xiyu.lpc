// xian.c  「细雨」
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  object weapon;
  int damage, ap, dp, skill;
  string msg;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「细雨」只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着！\n");
  if ((int)me->query_skill("xiaoyao-jian", 1) < 300)
    return notify_fail("你的逍遥剑法不够娴熟，不会使用「细雨」。\n");
  if ((int)me->query_skill("xiaoyao-xinfa", 1) < 300)
    return notify_fail("你的逍遥心法不够高，无法使用「细雨」。\n");
  // 	if ( !wizardp(me) && me->query_skill_mapped("force") != "xiaoyao-xinfa")
  //		return notify_fail("不使用本门内功，如何使用本门绝学!\n"); 	
  //	if (me->query_skill_mapped("sword") != "xiaoyao-jian")
  //		return notify_fail("你没正确激发该技能 。\n");	
  if ((int)me->query("neili") < 1000)
    return notify_fail("你现在内力太弱，不能使用「细雨」。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你现在精力太弱，不能使用「细雨」。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  skill = me->query_skill("xiaoyao-jian", 1) / 10;
  msg = CYN "$N将手中的" + weapon->name() + "轻轻一抖，洒出一片细雨，斜风细雨不须归。\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "xiaoyao-jian",
    1
  ) + me->query_skill("sword") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  damage = (int)me->query_skill("xiaoyao-xinfa", 1) + (int)me->query_skill("xiaoyao-jianfa", 1);
  damage = damage / 2 + random(damage / 2);
  damage = damage * (100 - target->query_meridian()) / 100;
  if (random(ap) > dp / 3) {
    me->add_temp("apply/damage", skill);
    me->add_temp("apply/attack", skill);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add_temp("apply/damage", -skill);
    me->add_temp("apply/attack", -skill);

    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 2, me);
    me->add("neili", -300);
    me->add("jingli", -300);
    msg = HIR "只见$N手中剑光挥洒出一片细雨，飘飘洒洒，点点滴滴，将$n笼罩。\n$n只觉微雨拂面，似凉风吹过，吹出一道道血花！！\n" NOR;
    message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
  } else {
    msg = CYN "$n急运真元，轻喝一声，将细雨吹向一边。\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -100);
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
