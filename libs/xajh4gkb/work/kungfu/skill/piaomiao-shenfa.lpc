int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query_skill("dodge", 1) <=me->query_skill("piaomiao-shenfa", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    if (me->query("family/family_name")!="通吃帮")
		return notify_fail("你未加入通吃帮，不能学习本帮技能。\n");	
    if (me->query("dex",1)<30)
		return notify_fail("我通吃帮逃命功夫天下第一，以你的资质恐怕逃不掉。\n");	
    if ((int)me->query_skill("fanyun-force", 1) < 300 && (int)me->query_skill("damo-force", 1) < 300)
		return notify_fail("你的本门内功火候不够，无法学习缥缈身法。\n");	
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	if (random(100)==1) me->add("score",-5);	
    return 1;
}
string query_dodge_msg(object me,string limb)
{
	me->set_temp("fight/dodge",2*me->query_skill("piaomiao-shenfa",1));
	return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("qi") < 40 )
		return notify_fail("你的体力太差了，不能飘渺身法。\n");
    if (me->query("family/family_name")!="通吃帮")
		return notify_fail("你未加入本帮，不能领悟缥缈之意。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");			
	me->receive_damage("qi", 30);
	return 1;
}

string perform_action_file(string action)
{
    return __DIR__"piaomiao-shenfa/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	int ap,dp,j,damage2;

	ap = me->query_skill("piaomiao-shenfa", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("sword",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage2 = me->query_skill("piaomiao-shenfa", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (((int)me->query_skill("fanyun-force", 1) < 300 && (int)me->query_skill("damo-force", 1) < 300) || me->query_skill("piaomiao-shenfa", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="fanyun-force" && me->query_skill_mapped("force")!="damo-force") return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(HIG"$N战斗中突然领悟「缥缈」意境！身形转动写意至极，一个跨步轻松避开了$n的攻击。\n"NOR, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，脚步飞快，转瞬移到$n后背，趁势击出一掌，将$n打了个趔趄。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/tongchi") )
	{
		j = -(damage/3+random(damage/3));
		me->add("neili", -100 );
		if (!ob->is_busy()) ob->start_busy(2);
		message_vision(HIB"$N融汇通吃帮武学精髓，身法顿时渺如云烟，$n一时难以捉摸，攻势变慢！\n"NOR, me, ob);
		return j;
	}
}
