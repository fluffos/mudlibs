#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, damage;
  object weapon;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("" HIR "［" HIW "轻风细雨温柔剑" HIR "］" NOR "只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail(RED "你总得拿把剑吧？\n" NOR);
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query_skill("wenrou-jian", 1) < 300)
    return notify_fail("你的清风细雨温柔剑还不够纯熟！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的真气不够。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  //	if (me->query_skill_mapped("sword") != "wenrou-jian")
  //		return notify_fail("你没正确激发该技能 。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  extra = me->query_skill("wenrou-jian", 1);
  damage = extra + random(extra);
  damage = damage * (100 - target->query_meridian()) / 100;
  message_vision(
    HIW "$N手中的" NOR + weapon->name() + HIW "一出鞘，就化做一道光华击向$n" HIW "，一道弧形的光华：灿烂、辉煌、美丽。\n" + HIG "光华在闪动、变幻、高高在上，轻云飘忽，\n" NOR,
    me,
    target
  );
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  msg = HIG "$n只觉得这道光华彷佛就在自己眉睫间，却又不能确定它在那里？它的变化，几乎已超越了人类能力的极限，几乎已令人无法置信。\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "可是它确实在那里，而且无处不在。可是就在$n" HIY "已确定它存在时，它忽然又不见了。\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = WHT "又奇迹般忽然出现，又奇迹般忽然消失。\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "所有的动作和变化，都已在一刹那间完成，终止。就像是流星，却又像是闪电，却又比流星和闪电更接近奇迹。因为催动这变化的力量，是由$N发出来的。\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  target->receive_damage("qi", damage, me);
  target->receive_wound("qi", damage / 2, me);
  message_vision(HIM "纵然柔情缱绻，终要咫尺天涯，\n" NOR, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
  if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
    me,
    HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
  );
  //	if (!target->is_busy()) target->start_busy(1+random(2));
  me->add("neili", -100);
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
