// tiannan-step.c 天南步法
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
  "只见$n一招「旱地拔葱」，身体向上笔直地纵起丈余，躲过了$N这一招。\n",
  "$n一个「雨燕归巢」，向后纵出数丈之远，避开了$N的凌厉攻势。\n",
  "$n使出「破土而出」，向一旁飘然纵出，轻轻着地。\n"
  "但是$n身形飘忽，一招「无中生有」轻轻一纵，早已避开。\n",
  "$n身随意转，一招「乘风而去」倏地往一旁挪开了三尺，避过了这一招。\n",
  "可是$n侧身一让，一招「鲧化大鹏」$N这一招扑了个空。\n",
  "却见$n足不点地，一招「青云直上」往旁窜开数尺，躲了开去。\n",
  "$n身形微晃，一招「凤翔九天」有惊无险地避开了$N这一招。\n"
});

int valid_enable(string usage) { return (usage == "dodge"); }
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "juehu-shou"; }		//互备技能
string skill_pinji() { return "下乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "中立"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "大理段家"; }    //门派区分：门派，江湖
string skill_yinyang() { return "中性"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "中立"; }   //阵营区分：正派、邪派、中立、通用
//int damage_damage() {return 60;}	//外伤系数
//int force_damage() {return 60;}		//内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query("family/family_name") != "大理段家")
    return notify_fail("你不是大理段家弟子，无法学习大理段家技能。\n");
  if (!me->query("jm/xiaoyao"))
    return notify_fail(CYN "大理段家唯有第十六代皇帝因获得逍遥派无上机缘，才最终将六脉贯通。\n" + CYN "这位" + RANK_D->query_respect(me) + CYN "是否应该先去逍遥派游历一番？\n" NOR);
  if ((int)me->query("family_score") < 7)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if (me->query_skill("dodge", 1) <= me->query_skill("tiannan-step", 1))
    return notify_fail("你的基本轻功基础不够，无法领会更高深的技巧。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  return 1;

}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "大理段家")
    return notify_fail("你不是大理段家弟子，无法练习大理段家技能。\n");
  if (!me->query("jm/xiaoyao"))
    return notify_fail(CYN "大理段家唯有第十六代皇帝因获得逍遥派无上机缘，才最终将六脉贯通。\n" + CYN "这位" + RANK_D->query_respect(me) + CYN "是否应该先去逍遥派游历一番？\n" NOR);
  if ((int)me->query("family_score") < 7)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太差了，不能练段氏身法。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  return 1;
}


string perform_action_file(string action) {
  return __DIR__ "tiannan-step/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int ap, dp, j, damage2;

  ap = me->query_skill(
    "tiannan-step",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "unarmed",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage2 = me->query_skill(
    "tiannan-step",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "kumu-shengong",
    1
  ) < 300 || me->query_skill("tiannan-step", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force")!="kumu-shengong" ) return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = HIG "$N身子一转，化风而去，轻轻一纵已是数丈远。\n" NOR;
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(msg, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N顿悟" + me->query("cognize") + HIY "，一步跃出，已是天南海北，待$n招式用老，旋即踏了回来。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/dali")) {
    j = -(damage + random(damage));
    if (!ob->is_busy()) ob->start_busy(1);
    me->add("neili", -100);
    message_vision(HIB "$N融汇大理段氏武学精髓，身法加快，将$n招式带入天涯，$n顿时手忙脚乱！\n" NOR, me, ob);
    return j;
  }
}
