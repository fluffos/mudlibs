// jianzhang.c  
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	mixed combat_msg;
	object weapon;
	string msg;
	int i, count,skill;
	
	if (!target ) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「桃花飞舞」只能在战斗中使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("手中无剑怎能使出「桃花飞舞」？\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if ( me->query_skill("bibo-shengong",1) < 500 ) 
		return notify_fail("你的碧波神功等级不够, 不能使用「桃花飞舞」！\n");
	if ( (int)me->query_skill("yuxiao-jianfa", 1) < 500 ) 
		return notify_fail("你的玉箫剑法等级不够, 不能使用「桃花飞舞」！\n");
//	if( me->query_skill_mapped("sword") != "yuxiao-jianfa" )
//	    return notify_fail("你没有激发玉箫剑法。\n");
//	if( me->query_skill_mapped("force") != "bibo-shengong")
//		return notify_fail("不使用本门内功，如何能使用本门绝技！\n");
	if ((int)me->query("max_neili") < 100000)								
		return notify_fail("你的内力修为不够。\n");
	if ((int)me->query("max_jingli") < 100000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < (int)me->query_skill("yuxiao-jianfa", 1)*4 )
		return notify_fail("你的精力不够。\n");		
	if ( me->query("neili") < (int)me->query_skill("yuxiao-jianfa", 1)*4 ) 
		return notify_fail("你的内力不够，无法运用「桃花飞舞」！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

	combat_msg = me->query("env/no_combat_msg");
	if ( !intp(combat_msg) ) combat_msg = 1;
	message_vision(HBMAG"$N使出桃花岛绝技「桃花飞舞」，身法陡然加快。落英缤纷！\n\n"NOR, me,target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	skill = me->query_skill("yuxiao-jianfa", 1)/3;
	if (me->query_skill_mapped("force") != "bibo-shengong" ) skill += (int)me->query_skill("yuxiao-jianfa", 1)/2;	//2018.9.5阿飞改，不使用本门特内则减益	
	if ((string)weapon->query("id") == "biyu xiao") skill -= me->query_skill("yuxiao-jianfa", 1)/3; //2018.3.25阿飞改，拿特殊武器有加成
	count = me->query_skill("yuxiao-jianfa", 1)/60;
	if(count < 1 ) count = 1;
	if (me->query("jm/taohua"))
	{
		if(count > 100+(int)me->query_temp("lianzhao_max_add")*4 ) count = 100+(int)me->query_temp("lianzhao_max_add")*4;
	} else 
	{
		if(count > 50+(int)me->query_temp("lianzhao_max_add")*2 ) count = 50+(int)me->query_temp("lianzhao_max_add")*2;
	}	

		me->add_temp("apply/strength", -skill);
        me->add_temp("apply/attack", -skill);
		me->add_temp("apply/damage", -skill); 
		me->add_temp("lianzhao", count);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
	for ( i=0; i<count; i++ )
	{
		if (combat_msg<4)
		{
			switch ( random(6) )
			{
				case 0: msg = HIM"人面桃花！\n" NOR;
					break;
				case 1: msg = HIR"万花齐落！\n" NOR;
					break;
				case 2: msg = HIY"漫天花雨！\n" NOR;
					break;
				case 3: msg = HIC"落花无意！\n" NOR;
					break;
				case 4: msg = HIG"百花齐放！\n" NOR;
					break;
				case 5: msg = HIB"花落无痕！\n" NOR;
					break;
			}
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		}
		else
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_REGULAR);
	}
		me->add_temp("apply/strength", skill);
        me->add_temp("apply/attack", skill);
		me->add_temp("apply/damage", skill); 
	me->add("neili", -100*count);
	me->add("jingli", -100*count);	
	me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}