int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("max_neili") < 5000 )
		return notify_fail("你的内力不够，没有办法练七星换位。\n");
	if (me->query("family/family_name")!="全真教")
		return notify_fail("你不是全真教弟子，无法传授本教技能。\n");	
    if ((int)me->query_skill("tiangang-zhengqi", 1) < 100 && (int)me->query_skill("xiantian-qigong", 1) < 100)
		return notify_fail("你的本门内功火候不够，无法学习。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}
string query_parry_msg(string limb)
{
	return parry_msg[random(sizeof(parry_msg))];
}
int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("qi") < 30 ||	(int)me->query("neili") < 3 )
		return notify_fail("你的气或内力不够，不能练七星换位。\n");
	if (me->query("family/family_name")!="全真教")
		return notify_fail("你不是全真教弟子，无法练习本教技能。\n");	
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");	
	me->receive_damage("qi", 30);
	me->add("neili", -3);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"qixing-huanwei/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage2;

	ap = me->query_skill("qixing-huanwei", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("sword",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage2 = me->query_skill("qixing-huanwei", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if ((me->query_skill("xiantian-qigong",1) < 300 && me->query_skill("tiangang-zhengqi",1) < 300) || me->query_skill("qixing-huanwei", 1) < 300) return damage;
//	if (me->query_skill_mapped("force") != "xiantian-qigong" &&  me->query_skill_mapped("force") != "tiangang-zhengqi" ) return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIC"$N脚踏七星，身法来去自如！$n招式十有八九落空！\n"NOR;
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，脚踏七星，天枢辗转到达摇光，$n一收招却发现一股力道从摇光直达天枢，顿时喷出一口鲜血。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/quanzhen") )
	{
		j = -(damage/3+random(damage/3));
		if (!ob->is_busy()) ob->start_busy(2);
		me->add("neili", -100 );
		message_vision(HIB"$N贯通全真教七星阵法，摇光，开阳，玉衡，天权，天玑，天璇，天枢，瞬间达到，$n招式转换不及，真气一时错乱！\n"NOR, me, ob);
		return j;
	}
}
