mapping query_action(object me, object weapon) {
  int level = (int)me->query_skill("tiezhang-zhangfa", 1);

  if (random(level) > 300 && me->query_temp("powerup") && me->query("neili") > 300 && me->query("jiali") > 100) {
    me->add("neili", -100);
    return ([
      "action": HIR "$N突然大吼一声，身行疾飞而起，猛向$n直扑而下，空气中暴出“呜”的一声刺耳尖啸。" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "damage_type": "瘀伤"
    ]);
  }
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}


int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练铁掌掌法必须空手。\n");
  if ((int)me->query_skill("guiyuan-tunafa", 1) < 300)
    return notify_fail("你的归元吐呐法火候不够，无法练铁掌掌法。\n");
  if (me->query("family/family_name") != "铁掌帮")
    return notify_fail("你未加入铁掌山，不能传授镇帮绝技。\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为不够，无法练铁掌掌法");
  if ((int)me->query("str", 1) < 30)
    return notify_fail("铁掌掌法乃一等一的刚猛掌法，以你的臂力恐怕难以发挥其威力。");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}


int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query("jing") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 8)
    return notify_fail("你的内力不够练铁掌掌法。\n");
  if (me->query("family/family_name") != "铁掌帮")
    return notify_fail("你未加入铁掌山，怎么能偷练该帮镇帮绝技呢。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->receive_damage("jing", 20);
  me->add("neili", -5);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "tiezhang-zhangfa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  string msg;
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon2;

  weapon2 = victim->query_temp("weapon");
  ap = me->query_skill(
    "tiezhang-zhangfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("tiezhang-zhangfa", 1);
  damage2 = (int)me->query_skill(
    "tiezhang-zhangfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "guiyuan-tunafa",
    1
  ) < 100 || me->query_skill("tiezhang-zhangfa", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "guiyuan-tunafa") return 0;
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(HIW "碰! $n被掌风扫中！口角上吐出血丝....\n" NOR, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    if (objectp(weapon2 = victim->query_temp("weapon"))) {
      msg = HIY "$N顿悟" + me->query("cognize") + HIY "，运掌如刀，连击三十六下，" NOR;
      if (random(3) == 0) {
        msg += HIY "只听见「当」地一声，$n手中的" + weapon2->name() + "被刀气震落到地上！\n" NOR;
        weapon2->unequip();
        weapon2->move(environment(victim));
        //				victim->reset_action();
        message_vision(msg, me, victim);
      } else {
        msg += HIY "可是$n稳如泰山，纹丝不动！只是被自己掌力反震的吐了一口血而已！" NOR;
        victim->receive_damage("jing", damage, me);
        victim->receive_wound("jing", damage / 3, me);
        message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤精" NOR);
      }
    } else {
      msg = HIY "$N顿悟" + me->query("cognize") + HIY "，掌气化刀，将$n透体而过，一道血痕从$n身上显现。" NOR;
      victim->receive_damage("jing", damage, me);
      victim->receive_wound("jing", damage / 3, me);
      message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤精" NOR);
    }
    me->add("jingli", -100);
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/tiezhang")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIM "$N融汇铁掌帮武学精髓，掌心火热，不一会手掌通红，拍在$n胸膛，留下一道深深的掌印，$n口中溢血。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
