int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ( me->query("int",1) < 25 )
		return notify_fail("琴棋书画乃是极其风雅之事，" +RANK_D->query_respect(me)+" 似乎太过于俗气了些。\n");
	if ((int)me->query_skill("force", 1) < 100)
		return notify_fail("你的内功心法火候不够。\n");
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力太弱。\n");
	if( (int)me->query_skill("art", 1) < 300 )
		return notify_fail("你的琴棋书画还不到家！\n");
    if( (int)me->query_skill("qidao", 1) > (int)me->query_skill("art", 1) )
         return notify_fail("学习棋道要以琴棋书画为基础！\n");
	if ((int)me->query("score",1) < 10000)
		return notify_fail("琴棋书画需要体验人间百态，一看你就知道阅历不丰。\n");
	if (random(100)==1) me->add("score",-10);	
	return 1;
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ( me->query("int",1) < 25 )
		return notify_fail("琴棋书画乃是极其风雅之事，" +RANK_D->query_respect(me)+" 似乎太过于俗气了些。\n");
	if ((int)me->query("qi") < 100)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 100)
		return notify_fail("你的内力不够。\n");
	if( (int)me->query_skill("art", 1) < 500 )
		return notify_fail("你的琴棋书画还不到家，不能自行研究！\n");
    if( (int)me->query_skill("qidao", 1) > (int)me->query_skill("art", 1) )
         return notify_fail("学习棋道要以琴棋书画为基础！\n");

	me->receive_damage("qi", 50);
	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;
	string name;
	name = xue_name[random(sizeof(xue_name))];
    ap = me->query_skill("qidao",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("qidao",1);
	damage2 = (int)me->query_skill("qidao",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("qidao",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "xuntian-wuji") return 0;
	if (objectp(me->query_temp("weapon")) ) return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(WHT"\n$N身侧的玉色光芒忽如蝶翼般片片飞向$n，$n只觉" HIY "『" + name + "』" NOR + WHT "中一阵灼痛。\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，将内力凝为一线，攻入$n"+HIG"的体内。\n"NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/kunlun") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIM"$N贯通昆仑三圣琴棋剑之谜，以棋子发出剑气，纵横十九道。将$n分割成八十一块。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;
	string name;
	name = xue_name[random(sizeof(xue_name))];
	ap = me->query_skill("qidao", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("sword",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("qidao", 1);
	damage2 = me->query_skill("qidao", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (objectp(me->query_temp("weapon")) ) return damage;
	if (me->query_skill("qidao", 1) < 300) return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIG"$N心神合一，琴弈相通，弈道的"+(order[random(13)])+"「得算篇」"HIG"历历在目，身形骤然轻巧起来。\n"NOR;
		me->add("eff_qi", damage1);
		me->add("qi", damage1);
		if (me->query("eff_qi")> me->query("max_qi") ) me->set("eff_qi",me->query("max_qi"));
		if (me->query("qi")> me->query("eff_qi") ) me->set("qi",me->query("eff_qi"));
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，以星空为棋盘，以众生为棋子，弹指一挥间，击中$n的" + name + "。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/kunlun") )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );
		if (!ob->is_busy()) ob->start_busy(1);
		message_vision(HIB"$N贯通昆仑派琴棋剑精髓，手执黑白二棋，阴阳二气交缠，死生之道也！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
}



string perform_action_file(string action)
{
	return __DIR__"qidao/" + action;
}