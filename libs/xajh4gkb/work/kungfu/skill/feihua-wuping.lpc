int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query("family/family_name") != "浣花剑派")
    return notify_fail("你不加入浣花剑派，无法学习本门技能。\n");
  if ((int)me->query_skill("guiyuan-dafa", 1) < 150)
    return notify_fail("你的归元大法火侯太浅。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  return 1;
}
string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "浣花剑派")
    return notify_fail("你不加入浣花剑派，无法练习本门技能。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力太差了，练不了飞花无凭。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "feihua-wuping/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage) {
  int j, ap, dp, damage2;
  ap = me->query_skill(
    "feihua-wuping",
    1
  ) * me->query(
    "int",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "dodge",
    1
  ) * ob->query(
    "dex",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage2 = me->query_skill(
    "feihua-wuping",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "guiyuan-dafa",
    1
  ) < 300 || me->query_skill("feihua-wuping", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force")!="guiyuan-dafa" ) return damage;

  if (random(ap) > dp / 4 && random(8) == 1) {
    message_vision(HIG "$N发挥出「乱花丛中过，片叶不粘衣」的境界，轻松闪过$n的招式。\n" NOR, me, ob);
    j = -(damage + random(damage));
    me->add("neili", -100);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage / 3 + random(damage / 3));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N于乱花丛中领悟" + me->query("cognize") + HIY "，闪转之间飞花似箭！\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/huanhua")) {
    j = -(damage + random(damage));
    if (!ob->is_busy()) ob->start_busy(1);
    me->add("neili", -100);
    message_vision(HIB "$N洞彻浣花武学精髓，脚步飞快，带起一片红花！\n" NOR, me, ob);
    return j;
  }
}
