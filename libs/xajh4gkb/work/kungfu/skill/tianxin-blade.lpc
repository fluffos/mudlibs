int valid_learn(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
    if (!objectp(weapon = me->query_temp("secondary_weapon")) || (string)weapon->query("skill_type") != "blade")
      return notify_fail("你还是先找把刀来吧。\n");
  if ((int)me->query("str", 1) < 25)
    return notify_fail("你的手无缚鸡之力，拿不了刀。\n");
  if ((int)me->query("max_neili") < 20000)
    return notify_fail("你的内力不够。\n");
  if (me->query_skill("blade", 1) <= me->query_skill("tianxin-blade", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  if ((int)me->query_skill("lingyuan-xinfa", 1) < 100)
    return notify_fail("你的灵元心法火候太浅。\n");
  if (me->query("family/family_name") != "玄天派")
    return notify_fail("你不是玄天派弟子，没法学习。\n");
  //	if (me->query("family/master_id")!="wuming laoren")
  //		return notify_fail("天行刀法乃是无名老人的得意武功，你只能找他学习。\n");
  //	if ((int)me->query_skill("tianxin-blade",1) > 3000)
  //		return notify_fail("这套刀法我就教此处，你今后在这套刀法上的成就就要看你自己了。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}


mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  string msg;
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon1, weapon2;
  weapon1 = me->query_temp("weapon");
  weapon2 = victim->query_temp("weapon");
  ap = me->query_skill(
    "tianxin-blade",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("tianxin-blade", 1);
  damage2 = (int)me->query_skill(
    "tianxin-blade",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "lingyuan-xinfa",
    1
  ) < 100 || me->query_skill("tianxin-blade", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "lingyuan-xinfa") return 0;
  if (!objectp(weapon1 = me->query_temp("weapon")) || (string)weapon1->query("skill_type") != "blade") return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      WHT "$N体内的灵元心法的刚劲与刀招中发出的天行刀意融合为一，化做一股混元真力震碎了$n的心脉！！！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    if (objectp(weapon2 = victim->query_temp("weapon"))) {
      msg = HIY "$N顿悟" + me->query("cognize") + HIY "，只见手中" + weapon1->name() + HIY "" HIY "如风火轮一般，一刀连着一刀将对方的" + weapon2->name() + HIY "劈的火星直冒！" NOR;
      if (random(3) == 0) {
        msg += HIY "只听“乒”的一声巨响，" + weapon2->name() + HIY "被" + weapon1->name() + HIY "从$n手中直劈成两段。\n" NOR;
        weapon2->unequip();
        weapon2->move(environment(victim));
        weapon2->set("name", "断掉的" + weapon2->query("name"));
        weapon2->set("item_old_value", weapon2->query("value"));
        weapon2->set("value", 0);
        weapon2->set("backold_weapon_prop", weapon2->query("weapon_prop"));
        weapon2->set("weapon_prop", 0);
        //				weapon2->set("long", "一把断掉的武器，从中断开，破口整齐，看来是被绝顶高手一刀劈开的。\n");
        //				victim->reset_action();
        message_vision(msg, me, victim);
      } else {
        msg += HIY "$n暗运卸字决，" + weapon2->name() + "" HIY "顺着方向快速旋转数下，将" + weapon1->name() + "" HIY "上的真劲全数卸去，只是略受轻伤。\n" NOR;
        victim->receive_damage("jing", damage, me);
        victim->receive_wound("jing", damage / 3, me);
        message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤精" NOR);
      }
    } else {
      msg = HIY "$N顿悟" + me->query("cognize") + HIY "，暗暗运功将灵元心法的柔劲混入天行刀法阴柔的刀气内攻向$n！！" NOR;
      victim->receive_damage("jing", damage, me);
      victim->receive_wound("jing", damage / 3, me);
      message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤精" NOR);
    }
    me->add("jingli", -100);
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/xuantian")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIM "$N融汇玄天派武学精髓，天行刀已入返璞归真境界，随意一招带出无数劲气扑向$n！！！！！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}

/*	//2017.12.31阿飞改，改成正常自练方式
int practice_skill(object me)
{
    return notify_fail("天行刀法只能通过「"+HIC+"天马行空式"+NOR+"」来提升。\n");
}
*/
int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("jingli") < 1000 || (int)me->query("neili") < 1000)
    return notify_fail("你的内力或精力不够，没有办法练习天行刀！\n");
  if (me->query("family/family_name") != "玄天派")
    return notify_fail("你还是先入了日月神教再来练习。\n");
  if ((int)me->query_skill("tianxin-blade", 1) < 200)
    return notify_fail("你对天行刀不甚了解吧！\n");
  if ((int)me->query_skill("tianxin-blade", 1) > (int)me->query_skill("blade", 1))
    return notify_fail("你的刀法不够精湛！\n");
  if ((int)me->query_skill("lingyuan-xinfa", 1) < 200)
    return notify_fail("你对玄天派的内功不了解，如何能练的了天行刀！\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->add("neili", -100);
  me->add("jingli", -100);
  write("你按著所学练了一遍天行刀。\n");
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "tianxin-blade/" + action;
}
