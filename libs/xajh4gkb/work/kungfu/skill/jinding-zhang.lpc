int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练金顶绵掌必须空手。\n");
	if ((int)me->query("con",1) < 25)
		return notify_fail("你的根骨不够。\n");
	if ((int)me->query_skill("linji-zhuang", 1) < 200)
		return notify_fail("你的临济庄心法火候不够，不能练金顶绵掌。\n");
    if (me->query("family/family_name")!="峨嵋派")
		return notify_fail("你未加入峨嵋派，无法学习本门技能。\n");		
	if ((int)me->query("max_neili") < 100000)
		return notify_fail("你的内力太弱，无法练金顶绵掌。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	if (random(100)==1) me->add("score",-5);
	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i-1]["lvl"])
			return action[i-1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int level;
	level = (int) me->query_skill("jinding-zhang",1);

	if( random(7)==1 && random(level) > 300 && me->query("jiali")>100)
	{
		return ([
		"action" : "$N双掌合十，化为点点掌影，一招"+(order[random(13)])+"「佛光普照」"NOR"铺天盖地的掌影如疾风骤雨般袭向$n"NOR,
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,
		"skill_name" : "佛光普照",
		"damage_type" : "内伤" ]);
	}
	
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("qi") < 30)
		return notify_fail("你的体力太低了。\n");
    if (me->query("family/family_name")!="峨嵋派")
		return notify_fail("偷练峨嵋派绝技，遇到老尼姑会倒大霉。\n");		
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 20);
	return 1;
}
string perform_action_file(string action)
{
	return __DIR__"jinding-zhang/"+ action;
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	int j,ap,dp,damage1,damage2;
	ap = (int) me->query_skill("jinding-zhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;	
	dp = (int) ob->query_skill("unarmed",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = (int) me->query_skill("linji-zhuang",1);
	damage2 = (int) me->query_skill("linji-zhuang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (objectp(me->query_temp("weapon"))) return damage;
	if (me->query_skill("linji-zhuang",1) < 300 || me->query_skill("jinding-zhang", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="linji-zhuang" ) return damage;

	if (random(8)==1 && random(ap)>=dp/4 )
	{
		j = -(damage/3+random(damage/3));
		me->add("eff_qi", damage2);
		me->add("qi", damage2);
		if (me->query("eff_qi")> me->query("max_qi") ) me->set("eff_qi",me->query("max_qi"));
		if (me->query("qi")> me->query("eff_qi") ) me->set("qi",me->query("eff_qi"));
		me->add("neili", -100);
		message_vision(HIG"$N五心向天，运行日月二庄，益气升阳，益阴潜阳，升降反正，天地二气交泰于身，恢复了些活力！\n"NOR, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，日月二庄流转，佛光灌顶，将$n的招式反弹回去。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/emei") )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );
		message_vision(HIB"$N明悟峨嵋派武功精髓，阴阳二气交泰，震的$n吐出一口鲜血！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
}

mixed hit_ob(object me, object victim, int damage_bonus)
{	
	int ap,dp,damage1,damage2,damage,liannum;
	ap = me->query_skill("huifeng-jian",1)*me->query("con",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*me->query("int",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	damage1 = (int)me->query_skill("jinding-zhang",1);
	damage2 = (int)me->query_skill("jinding-zhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if (objectp(me->query_temp("weapon"))) return 0;
	if ( me->query_skill("linji-zhuang",1) < 100 || me->query_skill("jinding-zhang",1) < 100) return 0;
//	if ( me->query_skill_mapped("force") != "linji-zhuang") return 0;
	
	if( random(7)==1 && random(ap) > dp/3 && me->query("jiali")>0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili", -100 );		
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		message_vision(HIR "$n受到金顶绵掌的内劲侵蚀！似乎骨头化为粉末！\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，一式“佛光普照”，将$n轰的眼冒金星。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/emei") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIC "$N领悟峨嵋武功精髓，宝相庄严，掌力化作“卍”，$n喷出一大口鲜血！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}