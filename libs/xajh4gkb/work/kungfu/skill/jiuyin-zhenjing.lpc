// jiuyin-zhenjing.c 九阴真经	上乘武学400~1000
// By Hop
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "juehu-shou"; }		//互备技能
string skill_pinji() {return "上乘";}				//品级区分：上乘、中乘、下乘
string skill_xingbie() {return "女性";}				//性别区分：男性、女性、无性、通用
string skill_zhengxie() {return "中立";}			//正邪区分：正道、邪道、中立
string skill_menpai() {return "江湖";}				//门派区分：门派，江湖
string skill_yinyang() {return "阴";}				//阴阳区分：阳、阴、中性
string skill_zhenying() {return "通用";}			//阵营区分：正派、邪派、中立、通用
//int damage_damage() {return 60;}	//外伤系数
//int force_damage() {return 60;}		//内伤系数
int qi_heal() {return 60;}		//内功疗气系数
int jing_heal() {return 100;}		//内功疗精系数
int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
    mapping skl;
    string *sname;
    int i;
    int lvl = (int)me->query_skill("jiuyin-zhenjing", 1);
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if ( me->query("gender") == "无性" )
        return notify_fail("你无根无性，阴阳不调，难以领会高深的九阴真经。\n");
    if ( me->query("gender") != "女性")
        return notify_fail("九阴真经需要阴柔体质，不适合你学。\n");		
	if(me->query("couple") || me->query("make_loves"))
		return notify_fail("你精气已失，不能领悟九阴真经的奥妙之处。\n");
	if (me->query("family/master_id") != "huang shang")
		return notify_fail("九阴真经只能拜道家宗师黄裳学习。\n");
    if (me->query_skill("force",1) <=lvl)
        return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
    if (me->query_skill("force",1)<500)
        return notify_fail("你的基本内功基础不够，怎能学九阴真经。\n");
	if ((int)me->query_skill("jiuyin-zhenjing", 1) < 300)
		return notify_fail("九阴真经的开篇总纲必须先从道藏典籍中领悟。\n");
	if ((int)me->query_skill("jiuyin-zhenjing", 1) > 3000)
		return notify_fail("上乘武学只能教到这里了，以后要靠自己勤加修习领悟。\n");
	if ((int)me->query("score",1) < 10000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");

    skl = this_player()->query_skills();
    sname  = keys(skl);
    for (i=0;i<sizeof(skl);i++){
        if (sname[i]=="jiuyin-zhenjing") continue;
        if (sname[i]=="yijing-force") continue;
        if (sname[i]=="xixing-dafa") continue;		
            if( SKILL_D(sname[i])->valid_enable("force") )
            return notify_fail("你不先散了别派内功，怎能学九阴真经？！\n");
    }
	if (random(10)==1) me->add("score",-10);	
    return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	string msg;
	object armor;
	int ap,dp,damage1,damage2,damage,liannum;
	ap = me->query_skill("jiuyin-zhenjing",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	damage1 = (int)me->query_skill("jiuyin-zhenjing",1);
	damage2 = (int)me->query_skill("jiuyin-zhenjing",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	armor = victim->query_temp("armor/finger");
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if ( me->query("couple") || me->query("make_loves") || me->query("gender") != "女性") return 0;
    if( me->query("jingli") < 100 || me->query("neili") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("jiuyin-zhenjing",1) < 100) return 0;
	if ( me->query_skill_mapped("force") != "jiuyin-zhenjing") return 0;	
 
	if( random(ap) > dp/12 && random(7)==1 )
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		msg = HIR"$N阴阴地笑了几声，$n忽然感觉到$N一股阴柔的内力侵入体内！$n面容扭曲吐出一口鲜血！\n" NOR;
		if(objectp(armor) && armor->query("id") == "tianmo jie")
		{
			damage /= 5;
			msg += HIR "$n的天魔戒削弱了$N九阴真经的伤害！！！！\n" NOR;
		}
		victim->apply_condition("no_enforce", 10);	
		victim->receive_damage("jing", damage ,me);
		victim->receive_wound("jing", damage/3 ,me);
		victim->add("neili", -(int)me->query("jiali"));	
		me->add("neili",-100);
		message_vision(msg, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return;
	}
	if( random(ap) > dp/12 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		msg = HIG"$N运转九阴神功，进入"+me->query("cognize")+HIG"，阴柔内劲化作螺旋劲攻入$n经脉！\n" NOR;
		if(objectp(armor) && armor->query("id") == "tianmo jie")
		{
			damage /= 5;
			msg += HIR "$n的天魔戒削弱了$N九阴真经的伤害！！！！\n" NOR;
		}
		victim->apply_condition("no_force", 10);
		me->add("jingli",-100);
		victim->add("jingli", -damage);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(msg, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/12 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/jiuyin") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		msg = HIR"$N将九阴真经练至高深处，奇招妙式信手而出，一时将$n打的鲜血横飞！\n" NOR;
		if(objectp(armor) && armor->query("id") == "tianmo jie")
		{
			damage /= 5;
			msg += HIR "$n的天魔戒削弱了$N九阴真经的伤害！！！！\n" NOR;
		}
		victim->apply_condition("no_exert", 10);
		me->add("neili",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(msg, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
}
int practice_skill(object me)
{
    return notify_fail("九阴真经只能用学(learn)的来增加熟练度。\n");
}
string exert_function_file(string func)
{
    return __DIR__"jiuyin-zhenjing/" + func;
}

