int valid_learn(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query("family/family_name")!="血河派")
		return notify_fail("你不加入血河派，恐怕学不了血河派技能。\n");	
	if (!me->query("jm/xuantian"))
		return notify_fail(CYN"我血河派第十一代掌门欧阳驼于六十年前失踪，江湖上流传的摧心掌似乎与我派有关。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否先为我派去玄天派探听其秘密，将来必有回报。\n"NOR);
	if ((int)me->query("family_score")<8)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
    if ((int)me->query_skill("huaxue-dafa", 1) < 100 && (int)me->query_skill("yiriguan-riyue", 1) < 100 && (int)me->query_skill("longmen-shengong", 1) < 100)
		return notify_fail("你的本门内功火候不够，无法学习本门绝技。\n");
	if ( !objectp(weapon = me->query_temp("weapon")) || ( string)weapon->query("skill_type") != "whip" )
		return notify_fail("你必须先找一条长鞭才能练鞭法。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");	
	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	if(level >= action[i]["lvl"])
		return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "whip")
		return notify_fail("你使用的武器不对。\n");
	if (me->query("family/family_name")!="血河派")
		return notify_fail("你不加入血河派，恐怕练习不了血河派技能。\n");	
	if (!me->query("jm/xuantian"))
		return notify_fail(CYN"我血河派第十一代掌门欧阳驼于六十年前失踪，江湖上流传的摧心掌似乎与我派有关。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否先为我派去玄天派探听其秘密，将来必有回报。\n"NOR);
	if ((int)me->query("family_score")<8)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);			
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够练余地鞭法。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 15);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"yudi-bian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;
	int flag = 1;
	object weapon;
	weapon = me->query_temp("weapon");
    ap = me->query_skill("youren-jian",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("youren-jian",1);
	damage2 = (int)me->query_skill("youren-jian",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( (me->query_skill("huaxue-dafa",1)<200 &&  me->query_skill("yiqiguan-riyue",1)<200 && me->query_skill("longmen-shengong",1)<100) || me->query_skill("youren-jian",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "huaxue-dafa" && me->query_skill_mapped("force") != "yiqiguan-riyue" && me->query_skill_mapped("force") != "longmen-shengong") return 0;
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "whip") return 0;
	if ( me->query_skill_mapped("force") == "longmen-shengong" ) flag =3;
	if ( me->query_skill_mapped("force") == "huaxue-dafa" ) flag =1;
	if ( me->query_skill_mapped("force") == "yiqiguan-riyue" ) flag =2;
	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIY"$N手持长鞭，甩的啪啪作响！一个鞭影闪过，$n脖子被缠住了。\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，手腕轻轻一旋，" + weapon->name() + HIG "套出一个圆圈，“刺啦”一声，缠住了$n右臂。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/xuehe") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIM"$N融会血河派武学精髓，" + weapon->name() + HIM "进退自如，一招一式留有余地，一招未使老，旋即变招，连绵不绝。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

