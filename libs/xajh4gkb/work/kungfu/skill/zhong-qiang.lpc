  ([ "action": "$N双手一别，尽力前伸，使出一招「中平无敌」，手中$w平平直出，刺向$n的$l",
    "attack": 100,
    "parry": 100,
    "dodge": 100,
    "damage": 100,
    "force": 100,
    "lvl": 0,
    "skill_name": "中平无敌",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w盘旋回转，风响阵阵，屈身下蹲，反手一招「夜叉探海」自下向$n的$l刺去",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "lvl": 0,
    "skill_name": "夜叉探海",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N举起$w，抖出一朵枪花，一招「灵蛇出洞」向$n分心扎去",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "lvl": 0,
    "skill_name": "灵蛇出洞",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一招「反身拿枪」，手中$w划个小圈消去$n的后招，而后$w微抬，指向$n的$l",
    "attack": 300,
