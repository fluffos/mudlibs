int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练飞雪映梅掌必须空手。\n");
    if (me->query("family/family_name")!="凌霄城")
		return notify_fail("你未加入凌霄城，学不了。\n");	
    if ((int)me->query_skill("bingxue-xinfa", 1) < 100)
		return notify_fail("你的冰雪心法不够。\n");	
	if ((int)me->query("max_neili") < 10000)
        return notify_fail("你的内力太弱，无法练习。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("qi") < 40)
		return notify_fail("你的体力太低了。\n");
	if (me->query("family/family_name")!="凌霄城")
		return notify_fail("你未加入凌霄城，还敢练习城主独门技能！。\n");				
	if ((int)me->query("neili") < 10)
		return notify_fail("你的内力不够了！休息一下再练吧。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	me->receive_damage("qi", 10);
	me->add("neili", -5);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"snow-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;

    ap = me->query_skill("snow-zhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("snow-zhang",1);
	damage2 = (int)me->query_skill("snow-zhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("bingxue-xinfa",1) < 100 || me->query_skill("snow-zhang",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "bingxue-xinfa") return 0;
	if (objectp( me->query_temp("weapon")) ) return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		victim->apply_condition("ice_poison", (me->query_skill("bingxue-xinfa"))/300 + victim->query_condition("ice_poison"));
		message_vision(HIW "$n只觉得伤口一寒,一股寒气似冰箭一样的串进$n的全身。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，双掌如穿花一般，带着梅花香气，于漫天飞雪中击中了$n胸口。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/lingxiao") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		victim->apply_condition("rose_poison", (me->query_skill("snow-zhang"))/100 +1+ victim->query_condition("rose_poison"));
		message_vision(HIM"$N领悟凌霄城武学精髓，双掌突然绽放，一股香气扑面而来，$n大叫一声，吐出一口鲜血。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

