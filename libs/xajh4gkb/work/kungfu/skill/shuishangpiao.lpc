//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法学习。\n");
  if (me->query("family/family_name") != "铁掌帮")
    return notify_fail("你不是铁掌山弟子，无法学习水上漂。\n");
  if ((int)me->query_skill("guiyuan-tunafa", 1) < 100)
    return notify_fail("你的归元吐纳法不够，无法学习。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  return 1;
}
string query_dodge_msg(object me, string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("jing") < 40)
    return notify_fail("你的体力太差了，不能练水上漂。\n");
  if (me->query("family/family_name") != "铁掌帮")
    return notify_fail("你不是铁掌山弟子，无法练习。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->receive_damage("jing", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "shuishangpiao/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int ap, dp, j, damage1, damage2;

  ap = me->query_skill(
    "shuishangpiao",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "sword",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = me->query_skill("shuishangpiao", 1);
  damage2 = me->query_skill(
    "shuishangpiao",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "guiyuan-tunafa",
    1
  ) < 300 || me->query_skill("shuishangpiao", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force")!="guiyuan-tunafa" ) return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = HIG "$N提起全身真气，身体顿时变轻了，一个鲤鱼翻身，顿时避开了要害！\n" NOR;
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(msg, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N顿悟" + me->query("cognize") + HIY "，脚下踢出一道水花，$n一声闷哼。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/tiezhang")) {
    j = -(damage / 3 + random(damage / 3));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    message_vision(
      HIB "$N贯通铁掌帮绝技，施展铁掌水上漂，脚下飞快，掌势紧随其后！\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
}
