int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练七伤拳必须空手。\n");
  if ((int)me->query_skill(
    "jiuyang-shengong",
    1
  ) < 100 && (int)me->query_skill("shenghuo-shengong", 1) < 100)
    return notify_fail("你的九阳神功火候不够，无法学七伤拳。\n");
  if ((int)me->query("max_neili") < 500000)
    return notify_fail("你的内力太弱，无法练七伤拳。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

void skill_improved(object me) {
  int skill;
  skill = me->query_skill("jiuyang-shengong", 1);
  if (me->query("max_neili") < skill * 200 && skill < 1000) {
    switch (random(7)) {
      case 0:
        tell_object(me, HIR "你肩头云门穴突然一阵轻微隐痛，是肺脉伤了！\n" NOR);
        me->add("neili", -random(10000));
        break;
      case 3:
        tell_object(me, HIR "你上臂青灵穴突然一时麻痒难当，是心脉伤了！\n" NOR);
        me->receive_wound("qi", 10 + random(300));
        break;
      case 4:
        tell_object(me, HIR "你突然觉得体内阴阳二气串行金木水火土五行，无法抑制了！\n" NOR);
        me->receive_wound("jing", 10 + random(100));
        break;
    }
  }
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query_skill(
    "jiuyang-shengong",
    1
  ) < 100 && (int)me->query_skill("shenghuo-shengong", 1) < 100)
    return notify_fail("你的九阳神功火候不够，无法学七伤拳。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练七伤拳。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "qishang-quan/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;

  ap = me->query_skill(
    "qishang-quan",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("qishang-quan", 1);
  damage2 = (int)me->query_skill(
    "qishang-quan",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if ((me->query_skill(
    "shenghuo-shengong",
    1
  ) < 100 && me->query_skill(
    "jiuyang-shengong",
    1
  ) < 100) || me->query_skill("qishang-quan", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "shenghuo-shengong" && me->query_skill_mapped("force") != "jiuyang-shengong") return 0;
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    if (victim->query("neili") / 2 < me->query("neili"))
      victim->apply_condition("qishang_poison", 30 + victim->query_condition("qishang_poison"));
    else me->apply_condition("qishang_poison", 5 + victim->query_condition("qishang_poison"));
    message_vision(
      HIR "$N拳头上七道光芒一闪，$n顿时觉得七道内力侵入经脉之中！！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，$n被一拳打中，七脉皆伤！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/mingjiao")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIM "$N贯通明教武学精髓，七道拳劲，一道强过一道，将$n全身经脉击碎。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int ap, dp, j, damage1, damage2;

  ap = me->query_skill(
    "qishang-quan",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "sword",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = me->query_skill("qishang-quan", 1);
  damage2 = me->query_skill(
    "qishang-quan",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if ((me->query_skill(
    "shenghuo-shengong",
    1
  ) < 100 && me->query_skill(
    "jiuyang-shengong",
    1
  ) < 100) || me->query_skill("qishang-quan", 1) < 100) return damage;
  //	if ( me->query_skill_mapped("force") != "shenghuo-shengong" && me->query_skill_mapped("force") != "jiuyang-shengong") return damage;
  if (objectp(me->query_temp("weapon"))) return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = HIC "$N运起九阳内劲 全身内力爆发，浮现出一层刚猛的劲气！一者伤，七者皆伤！\n" NOR;
    if (!ob->is_busy()) ob->start_busy(1);
    me->add("neili", -100);
    j = -(damage + random(damage));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    message_vision(msg, me, ob, damage1, HBWHT + HIY "气血反伤" NOR);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N顿悟" + me->query("cognize") + HIY "，内劲连绵不绝，七道内劲连环冲击$n经脉。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/mingjiao")) {
    j = -(damage / 3 + random(damage / 3));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    message_vision(
      HIB "$N明悟明教武学精髓，一拳化七拳，将$n招式尽数反击回去！\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
}
