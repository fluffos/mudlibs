mapping query_action(object me, object weapon)
{
    if (random(20) > 15
    && me->query_skill("shenghuo-ling",1) > 500
    && me->query("neili") > 300 
    && (string)weapon->query("id") == "shenghuo ling" ) 
	{
        me->add("neili", -100);
        return ([
      "action": "$N眼中射出一道青芒，飞身而前，手中圣火令相互一击，铮的一响，$n心神一荡，身子从半空中直堕下来，但觉腰胁中一阵疼痛，已被$N踢中了一脚。砰的一下，$N的圣火令却又击中了$n的$l",
		"attack":	1000,
		"parry":	1000,
		"dodge":	1000,
		"damage":	1000,
		"force":	1000,
      "damage_type": "刺伤"]);
    }
    return action[random(sizeof(action))];
}

int valid_learn(object me)
{
	int lvl = (int)me->query_skill("qiankun-danuoyi", 1);
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ( me->query("gender") == "无性" && lvl > 49)
		return notify_fail("你先天不足，再学下去难免走火入魔。\n");
	if ((int)me->query("str",1) < 30)
		return notify_fail("圣火令乃玄铁铸造，没有足够的臂力恐怕舞不起来？\n");
	if ((int)me->query("max_neili") < 100000)
		return notify_fail("就这么点内力还想学圣火令法？\n");
    if (me->query("family/family_name")!="明教")
		return notify_fail("你不是明教弟子，无法学习圣火令。\n");	
	if (!me->query("jm/shashou"))
		return notify_fail(CYN"我明教替朱家打的天下，到头来飞鸟尽、良弓藏！这朱洪武视我明教如洪水猛兽，居然成立杀手楼来暗杀我教高手！\n"CYN"这位"+RANK_D->query_respect(me)+CYN"欲扬我明教威名，需得查明杀手楼的秘密！\n"NOR);
	if ((int)me->query("family_score")<7)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);		
	if (me->query_skill("shenghuo-shengong", 1) < 300 )	
		return notify_fail("你的圣火神功火候还不够，学不了圣火令法！\n");
	if ((int)me->query_skill("shenghuo-ling", 1) > 3000)
		return notify_fail("上乘武学只能教到这里了，以后要靠自己勤加修习领悟。\n");		
	if ((int)me->query("score",1) < 10000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	if (random(10)==1) me->add("score",-10);	
        return 1;
}

int practice_skill(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
    if (me->query("family/family_name")!="明教")
		return notify_fail("你不是明教弟子，无法练习圣火令。\n");	
	if (!me->query("jm/shashou"))
		return notify_fail(CYN"我明教替朱家打的天下，到头来飞鸟尽、良弓藏！这朱洪武视我明教如洪水猛兽，居然成立杀手楼来暗杀我教高手！\n"CYN"这位"+RANK_D->query_respect(me)+CYN"欲扬我明教威名，需得查明杀手楼的秘密！\n"NOR);
	if ((int)me->query("family_score")<7)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);					
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够练圣火令法。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");		
	me->receive_damage("qi", 40);
	return 1;
}



string perform_action_file(string action)
{
	return __DIR__"shenghuo-ling/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;
	object weapon;
	weapon = me->query_temp("weapon");
    ap = me->query_skill("shenghuo-ling",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("shenghuo-ling",1);
	damage2 = (int)me->query_skill("shenghuo-ling",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( ( me->query_skill("shenghuo-shengong",1) < 100 && me->query_skill("jiuyang-shengong",1) < 100) || me->query_skill("shenghuo-ling",1)<100) return 0;
//	if (me->query_skill_mapped("force") != "shenghuo-shengong" && me->query_skill_mapped("force") != "jiuyang-shengong") return 0;
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		message_vision(HIY"$N掏出两把圣火令，相互交击，身形突然加快，向$n欺身而上。\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，手中" + weapon->name() + HIG "犹如生了眼睛一般，随意挥出几剑，$n发现这招无法招架，只好运起内功硬挨了这一剑！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/mingjiao") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIM"$N融汇明教武学精髓，手中" + weapon->name() + HIM "一震，只听“咣当”一声，两道剑气飞出，“噗嗤”一声，$n一道血光乍现。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}
