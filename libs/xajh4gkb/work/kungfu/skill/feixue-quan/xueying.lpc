#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	int damage,flag;
	int ap,dp;
	string msg;
	flag = 1;
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「"+HIR"满天血影"NOR+"」只能对战斗中的对手使用。\n");
    if(me->is_busy())
        return notify_fail("你现在正忙着！\n");
	if( (int)me->query_skill("feixue-quan", 1) < 500 )
		return notify_fail("你的飞血拳不够熟练，不会使用「满天血影」。\n");
	if ((int)me->query_skill("huaxue-dafa", 1) < 300 && (int)me->query_skill("yiqiguan-riyue", 1) < 300 && (int)me->query_skill("longmen-shengong", 1) < 300)
		return notify_fail("你的内功心法的修为不够, 不能使用这一绝技 !\n");
//	if ( me->query_skill_mapped("force") != "huaxue-dafa" && me->query_skill_mapped("force") != "yiqiguan-riyue" && me->query_skill_mapped("force") != "longmen-shengong") 
//		return notify_fail("你未使用本门内功，如何能使用本门绝技。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
	if((int)me->query_skill("unarmed",1) < 1000)
		return notify_fail("你的基本拳脚的修为不够, 不能使用这一绝技 !\n");
	if( (int)me->query("max_neili") < 100000 )
		return notify_fail("你的内力修为还不够高。\n");
	if( objectp(me->query_temp("weapon")))
		return notify_fail("你先放下手中的武器再说吧？！\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if ((int)me->query("neili")<1000)	
		return notify_fail(HIC"你现在内力不够，没能将「满天血影」使完！\n"NOR);
//	if (me->query_skill_mapped("unarmed") != "feixue-quan")
//		return notify_fail("你没正确激发该技能 。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg  = HIR"只见$N双目赤红，全身衣襟无动，口中长啸一声，\n"NOR;
	msg += HIR"$N把内力注入双臂，猛地一动，双臂血花爆射，\n"NOR;
	msg += HIR"顿时只见空气中血雾弥漫，双眼难开，随即又听见\n"NOR;
	msg += HIR"$N骨骼 噼里啪啦 一阵爆响，双臂顺着喷出的血舞，\n"NOR;
	msg += HIR"使劲一推，刹那间一座丈来高的血墙拔地而起，\n"NOR;
	msg += HIR"接而带着排山倒海之势向$n涌去！\n"NOR;
	message_vision(msg, me, target);
	ap = me->query("xyzx_sys/level") + me->query_skill("feixue-quan", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	if (random(ap)>dp/3)
	{
		if (me->query_skill_mapped("force")=="huaxue-dafa") flag = 5;
		if (me->query_skill_mapped("force")=="longmen-shengong") flag = 3;
		if (me->query_skill_mapped("force")=="yiqiguan-riyue") flag = 2;

		damage = me->query_skill("feixue-quan",1)*flag + me->query_skill("force") + me->query_skill("unarmed",1);
		damage = damage/3 + random(damage/3);
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		msg = HIG"$n见状连忙提运内力，双臂猛地推出，顿时"+HIW"掌风"NOR+""+HIG"汹涌澎湃!\n"NOR;
		msg += HIG"没想到强大的气流竟然对"+HIR"血墙"NOR+""+HIG"丝毫没影响，\n"NOR;
		msg += HIG"刹那间$n就被"+HIR"血墙"NOR+""+HIG"吞没。\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
		me->add("neili", -500);
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		msg = HIY"$n浑然不放在眼里，衣袖轻轻一拂，便将血墙熄灭。\n"NOR;
		message_vision(msg, me, target);
		me->add("neili", -100);
	}
	
	me->start_busy(1);
	if(!target->is_fighting(me)) target->fight_ob(me);
	if(userp(target)) target->fight_ob(me);
	else if( !target->is_killing(me) ) target->kill_ob(me);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}