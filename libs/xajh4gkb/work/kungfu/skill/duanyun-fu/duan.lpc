//duan.c -夺命三斧之「断云斩」
// Modified by Venus Oct.1997
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  object weapon;
  string msg;
  int i, extra, max;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("你只能对战斗中的对手使用「断云斩」。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "axe")
    return notify_fail("你使用的武器不对。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query_skill("duanyun-fu", 1) < 300)
    return notify_fail("你目前断云斧功力不够，还使不出「断云斩」。\n");
  if ((int)me->query_skill("guiyuan-tunafa", 1) < 300)
    return notify_fail("你目前归元吐纳法功力不够，还使不出「断云斩」。\n");
  //    if (me->query_skill_mapped("force") != "guiyuan-tunafa")
  //        return notify_fail("不使用本门内功，如何能使用本门绝技。\n");	
  if (me->is_busy())
    return notify_fail("你现在正忙着呢，哪有空运功？\n");
  if ((int)me->query("neili") < me->query_skill("duanyun-fu", 1) * 4)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为不够。\n");
  //	if (me->query_skill_mapped("axe") != "duanyun-fu")
  //		return notify_fail("你没正确激发该技能 。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  extra = me->query_skill("duanyun-fu", 1) / 15;
  if (me->query_skill_mapped("force") != "guiyuan-tunafa") extra -= (int)me->query_skill(
    "duanyun-fu",
    1
  ) / 18;  //2018.9.5阿飞改，不使用本门特内则减益
  if ((string)weapon->query("id") == "duanyun fu") extra += me->query_skill("duanyun-fu", 1) / 15;  //2018.3.25阿飞改，拿特殊武器有加成
  max = me->query_skill("duanyun-fu", 1) / 600;
  msg = HIC "$N突然暴喝一声，将手中巨斧斜向上举起，然后在半空中划出一道又一道圆弧，随即径直斜下斩向$n！这一瞬间，$n只觉得呼吸都停止了！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1	
  me->add_temp("apply/damage", extra);
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/strength", extra);
  if (max < 1) max = 1;
  if (me->query("jm/tiezhang")) {
    if (max > 100 + (int)me->query_temp("lianzhao_max_add") * 4) max = 100 + (int)me->query_temp("lianzhao_max_add") * 4;
  } else {
    if (max > 50 + (int)me->query_temp("lianzhao_max_add") * 2) max = 50 + (int)me->query_temp("lianzhao_max_add") * 2;
  }

  me->add_temp("lianzhao", max);  //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
  for (i = 0; i < max; i++) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }
  me->add_temp("apply/damage", -extra);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/strength", -extra);
  me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记
  me->add("neili", -max * 100);
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
