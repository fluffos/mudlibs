// yunkai.c 云开雾阖

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	string msg;
	int skill, ap, dp, qi_wound,damage,busy_time;

/*	if (! target)
	{
		me->clean_up_enemy();
		target = me->select_opponent();
	}*/	//换个写法

    if (!target ) target = offensive_target(me);
	if( !target ||	!target->is_character() ||	!me->is_fighting(target) )
		return notify_fail("「云开雾阖」只能对战斗中的对手使用。\n");
	if (objectp(me->query_temp("weapon")))
		return notify_fail("你使用了武器不能用掌法。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if( me->query_skill("fanyun-zhang",1) < 300)
		return notify_fail("你的「翻云掌」等级不够, 不能使用「云开雾阖」！\n");
    if((int)me->query_skill("wuji-shengong",1)<300)
        return notify_fail("你的无极神功不够深厚，不能使用「无情无义」。\n");	
	if( me->query("neili") < 1000 )
		return notify_fail("你的内力不够，无法运用「云开雾阖」！\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");		
	if( me->query("max_neili") < 100000 )
		return notify_fail("你的内力修为不够，无法运用「云开雾阖」！\n");
//	if ( !wizardp(me) && me->query_skill_mapped("force") != "wuji-shengong")
//		return notify_fail("不使用本门内功，如何使用本门绝学!\n"); 
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (target && target->is_busy())
		return notify_fail("目前对方正自顾不暇，放胆攻击吧。\n");
	if ( target && target->query_temp("busy_mianyi") )	//冲穴成功后免疫busy，2017.9.29阿飞添加
		return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
//	if (me->query_skill_mapped("unarmed") != "fanyun-zhang")
//		return notify_fail("你没正确激发该技能 。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HIC "$N潜运「云开雾阖」，双掌挟着阵阵的风雷之声向$n击去。\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	skill = me->query_skill("fanyun-zhang",1);
	ap = me->query("xyzx_sys/level") + me->query_skill("fanyun-zhang", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	busy_time = (30*skill)/(skill+2000);
	if( stringp(target->query("inborn")) && (string)target->query("inborn")==YEL"冷静"NOR) busy_time = (30*skill)/(skill+2000)*7/10;
	if( random(ap) > dp/3 )
	{
		if(userp(me)) me->add("neili",-100);
		qi_wound = 100 + skill*2 + me->query_skill("unarmed")*2;
		damage = qi_wound/2 + random(qi_wound/2);
		damage = damage*(100-target->query_meridian())/100;
		target->add("neili", -damage);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/3,me);
		msg = HIG "$n只觉得胸前一阵剧痛，“哇”的一声喷出一口鲜血！\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"。\n" NOR);		
		target->start_busy(5+busy_time);
		tell_object(target, HIY"你陷入忙乱之中，一时无法动弹。\n"NOR);
	}
	else
	{
		msg = HIG "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n"NOR;
		message_vision(msg, me, target);
		if(userp(me)) me->add("neili",-100);
	}
	
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}