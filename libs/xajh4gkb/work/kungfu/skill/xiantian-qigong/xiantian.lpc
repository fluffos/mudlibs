// xiantian.c 先天功

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
//inherit F_CLEAN_UP;
int check_fight(object me);
void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill;

  if (target != me)
    return notify_fail("你只能用先天功来提升自己的战斗力。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够！\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为太差！\n");
  if ((int)me->query("max_jingli") < 100000)
    return notify_fail("你的精力修为太差！\n");
  if (me->query_skill_mapped("force") != "xiantian-qigong")
    return notify_fail("你没正确激发该技能 。\n");
  if ((int)me->query_skill("xiantian-qigong", 1) < 500)
    return notify_fail("你的先天功等级不够。\n");
  if (!(int)me->query("breakup"))
    return notify_fail("你任督二脉未通,无法使用[" + HIR + "「先天纯阳」" + NOR + "]\n" NOR,);
  if (me->query_temp("xiantian"))
    return notify_fail("你已经在运用先天护体中了。\n");
  if (me->query_temp("powerup"))
    return notify_fail("你已经在运内功护体中了。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  me->set_temp("powerup", 1);
  me->set_temp("xiantian", 1);
  skill = (int)me->query_skill("xiantian-qigong", 1) / 15 + (int)me->query_skill("force", 1) / 40;
  me->add("neili", -200);
  me->add("jingli", -200);
  message_vision(HIR "$N" HIR "默念先天功的口诀："
    "天地子时一阳生，人身气质合乎天地，故子时元阳亦生。"
    "内阳生，外物即举，无念无欲，。\n刹那间只见$N"
    HIR "八脉俱通，气就神交，任督自转。\n" NOR, me);

  me->add_temp("apply/intelligence", skill * 8 / 10);
  me->add_temp("apply/constitution", skill * 12 / 10);
  me->add_temp("apply/dexerity", skill * 9 / 10);
  me->add_temp("apply/damage", skill * 10 / 10);
  me->add_temp("apply/force", skill * 8);
  me->add_temp("apply/parry", skill * 12);
  me->add_temp("apply/unarmed", skill * 9);
  me->add_temp("apply/armor", skill * 14);
  check_fight(me);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill :), skill);

  me->start_busy(1);
  return 1;
}

int check_fight(object me) {
  if (!me || !(int)me->query_temp("xiantian")) return 0;
  if (me && !living(me)) return 0;
  if (me->query("qi") < 1 || me->query("eff_qi") < 1) return 0;  //解决 气血为负数 不晕不死的bug
  if (me->query("jing") < 1 || me->query("eff_jing") < 1) return 0;

  if (living(me)
    && me->is_fighting() && me->query("neili") > 500
    && me->query_skill_mapped("force") == "xiantian-qigong") {
    if (me->query("qi") < (int)me->query("max_qi")) {
      message_vision(HIR "$N运起先天功，身上的伤好了很多!\n" NOR, me);
      me->add("neili", -200);
      me->add(
        "eff_qi",
        me->query_skill("xiantian-qigong", 1) * me->query("con", 1) / 2 + me->query("max_qi") / 50
      );
      if (me->query("eff_qi") > me->query("max_qi")) me->set("eff_qi", me->query("max_qi"));
      me->add(
        "qi",
        me->query_skill("xiantian-qigong", 1) * me->query("con", 1) / 2 + me->query("max_qi") / 50
      );
      if (me->query("qi") > me->query("eff_qi")) me->set("qi", me->query("eff_qi"));
    }
    if (me->query("jing") < (int)me->query("max_jing")) {
      message_vision(HIR "$N运起先天功，身上的伤好了很多!\n" NOR, me);
      me->add("neili", -200);
      me->add(
        "eff_jing",
        me->query_skill("xiantian-qigong", 1) * me->query("con", 1) / 2 + me->query("max_jing") / 50
      );
      if (me->query("eff_jing") > me->query("max_jing")) me->set("eff_jing", me->query("max_jing"));
      me->add(
        "jing",
        me->query_skill("xiantian-qigong", 1) * me->query("con", 1) / 2 + me->query("max_jing") / 50
      );
      if (me->query("jing") > me->query("eff_jing")) me->set("jing", me->query("eff_jing"));
    }

  }
  call_out("check_fight", 5, me);
  return 1;
}

void remove_effect(object me, int amount) {
  if (!me) return;
  if ((int)me->query_temp("powerup")) {
    me->delete_temp("xiantian");
    me->delete_temp("powerup");
    me->add_temp("apply/intelligence", -amount * 8 / 10);
    me->add_temp("apply/constitution", -amount * 12 / 10);
    me->add_temp("apply/dexerity", -amount * 9 / 10);
    me->add_temp("apply/damage", -amount * 10 / 10);
    me->add_temp("apply/force", -amount * 8);
    me->add_temp("apply/parry", -amount * 12);
    me->add_temp("apply/unarmed", -amount * 9);
    me->add_temp("apply/armor", -amount * 14);
    tell_object(me, "你的先天功运行完毕，将内力收回丹田。\n");
  }
}
