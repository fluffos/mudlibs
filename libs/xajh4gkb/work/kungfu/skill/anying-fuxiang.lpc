int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query_skill("bibo-shengong", 1) < 100)
    return notify_fail("你的碧波神功不够熟练。\n");
  if (me->query("family/family_name") != "桃花岛")
    return notify_fail("你不是本门中人，无法领悟本门技能的精髓。\n");
  if (me->query_skill("dodge", 1) <= me->query_skill("anying-fuxiang", 1))
    return notify_fail("你的基本轻功基础不够，无法领会更高深的技巧。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  return 1;

}
string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "桃花岛")
    return notify_fail("你不是本门中人，如何学到本门高深技能，我要告诉掌门去。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太差了，不能练暗影浮香。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("qi", 10);

  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "anying-fuxiang/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage) {
  int j, ap, dp, damage2;
  ap = me->query_skill(
    "anying-fuxiang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "dodge",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage2 = (int)me->query_skill(
    "anying-fuxiang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "bibo-shengong",
    1
  ) < 300 || me->query_skill("anying-fuxiang", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force")!="bibo-shengong" ) return damage;

  if (random(ap) > dp / 4 && random(8) == 1) {
    j = -(damage + random(damage));
    me->add("neili", -100);
    message_vision(HIG "$N举头望明月，低头轻吟：人约黄昏后，月上柳梢头！\n" NOR, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage + random(damage));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N脚下" + me->query("cognize") + HIY "挥洒，疏影横斜水清浅，暗香浮动月黄昏！\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/taohua")) {
    j = -(damage + random(damage));
    if (!ob->is_busy()) ob->start_busy(1);
    me->add("neili", -100);
    message_vision(HIB "$N明悟桃花岛武学之精髓，脚下生香，$n只觉得四周桃花纷飞！\n" NOR, me, ob);
    return j;
  }
}
