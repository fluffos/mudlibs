int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "juehu-shou"; }		//互备技能
string skill_pinji() { return "中乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "中立"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "通吃帮"; }    //门派区分：门派，江湖
string skill_yinyang() { return "阳"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "中立"; }   //阵营区分：正派、邪派、中立、通用
int damage_damage() { return 65; }  //外伤系数
int force_damage() { return 44; }  //内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon")) || (string)weapon->query("skill_type") != "sword")
      return notify_fail("你必须先找把剑才能学孤星剑法。\n");
  if (me->query("family/family_name") != "通吃帮")
    return notify_fail("你未加入通吃帮，无法学习本门技能。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("fanyun-force", 1) < 100 && (int)me->query_skill("damo-force", 1) < 100)
    return notify_fail("你的本门内功不够，无法学孤星剑法。\n");
  if (me->query_skill("sword", 1) <= me->query_skill("guxing-sword", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}
int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon")) || (string)weapon->query("skill_type") != "sword")
      return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练孤星剑法。\n");
  if (me->query("family/family_name") != "通吃帮")
    return notify_fail("你未加入通吃帮，无法练习本门技能。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "guxing-sword/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage1, damage2, damage, liannum;
  int flag = 1;
  object weapon;
  weapon = me->query_temp("weapon");
  damage1 = (int)me->query_skill("guxing-sword", 1);
  damage2 = (int)me->query_skill(
    "guxing-sword",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  ap = me->query_skill(
    "guxing-sword",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if ((me->query_skill(
    "fanyun-force",
    1
  ) < 100 && me->query_skill(
    "damo-force",
    1
  ) < 100) || me->query_skill("guxing-sword", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "fanyun-force" && me->query_skill_mapped("force") != "damo-force" ) return 0;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return 0;
  if (me->query_skill_mapped("force") == "fanyun-force") flag = 1;
  if (me->query_skill_mapped("force") == "damo-force") flag = 2;

  if (me->query("jiali") > 0 && random(ap) > dp / 3 && random(7) == 1) {
    damage = (damage1 * flag + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIW "只见一片星光闪耀，$n被亮瞎了眼，胸口被刺了一个五角星形！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 * flag + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIG "$N一剑击出，带起一片星光，" + me->query("cognize") + HIG "的力量充斥其中，$n只觉得数点寒芒袭来。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/tongchi")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIC "$N融汇通吃帮绝学，剑光隐没于星空之中，突然刺中$n右腕。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
