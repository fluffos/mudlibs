int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }
//2019-1-1阿飞新规划，技能代码完善
string valid_combine() { return "shenghuo-jian"; }  //互备技能
string skill_pinji() { return "中乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "中立"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "明教"; }    //门派区分：门派，江湖
string skill_yinyang() { return "阳"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "邪派"; }   //阵营区分：正派、邪派、中立、通用
int damage_damage() { return 69; }  //外伤系数
int force_damage() { return 52; }  //内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("con", 1) < 30)
    return notify_fail("熊熊烈火，燃我焚躯。以你的体质恐怕会烧成灰。\n");
  if ((int)me->query_skill("shenghuo-shengong", 1) < 100)
    return notify_fail("你的圣火神功太浅。\n");
  if (me->query("family/family_name") != "明教")
    return notify_fail("你不是明教中人，无法学习本教技能。\n");
  if (!me->query("jm/shashou"))
    return notify_fail(CYN "我明教替朱家打的天下，到头来飞鸟尽、良弓藏！这朱洪武视我明教如洪水猛兽，居然成立杀手楼来暗杀我教高手！\n" CYN "这位" + RANK_D->query_respect(me) + CYN "欲扬我明教威名，需得查明杀手楼的秘密！\n" NOR);
  if ((int)me->query("family_score") < 7)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");

  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练烈火剑。\n");
  if (me->query("family/family_name") != "明教")
    return notify_fail("你不是明教中人，无法练习本教技能。\n");
  if (!me->query("jm/shashou"))
    return notify_fail(CYN "我明教替朱家打的天下，到头来飞鸟尽、良弓藏！这朱洪武视我明教如洪水猛兽，居然成立杀手楼来暗杀我教高手！\n" CYN "这位" + RANK_D->query_respect(me) + CYN "欲扬我明教威名，需得查明杀手楼的秘密！\n" NOR);
  if ((int)me->query("family_score") < 7)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 35);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "liehuo-jian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon, armor;
  weapon = me->query_temp("weapon");
  damage1 = (int)me->query_skill("liehuo-jian", 1);
  damage2 = (int)me->query_skill(
    "liehuo-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  ap = (int)me->query(
    "str",
    1
  ) * (int)me->query_skill(
    "liehuo-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = (int)victim->query(
    "con",
    1
  ) * (int)victim->query_skill(
    "force",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "shenghuo-shengong",
    1
  ) < 100 || me->query_skill("liehuo-jian", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "shenghuo-shengong") return 0;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      CYN "$N提起全身真元，剑身燃烧起来，隐隐火光闪烁。$n一个不小心，被$N剑上烈火灼伤！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，手中" + weapon->name() + HIG "随手一挥，一道火光直冲$n而去。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/mingjiao")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIM "$N融汇明教武学精髓，手中" + weapon->name() + HIM "燃其熊熊火焰，火焰四射。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    if (objectp(armor = victim->query_temp("armor/cloth")) && armor->query("armor_prop/armor") < 2000) {
      message_vision(
        HIY "只见$n四周火焰熊熊，" + armor->name() + HIY "温度越来越高，竟然着火起来，不一会烧为灰烬！\n" NOR,
        me,
        victim
      );
      armor->unequip();
      armor->move(environment(victim));
      armor->set("name", "破碎的" + armor->query("name"));
      armor->set("item_old_value", armor->query("value"));
      armor->set("value", 0);
      armor->set("backold_armor_prop", armor->query("armor_prop"));
      armor->set("armor_prop", 0);
      //			victim->reset_action();
    }
    return;
  }

}
