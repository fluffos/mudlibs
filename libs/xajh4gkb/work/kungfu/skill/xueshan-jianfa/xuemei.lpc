//雪梅笑
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;

int perform(object me) {
  string msg;
  object weapon, target;
  int ap, dp, qi_wound, damage;
  int i, attack_time, extra;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail(HIC "只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("max_neili") < 500000)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query("max_jingli") < 300000)
    return notify_fail("你的精力修为不够。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query_skill("xueshan-jianfa", 1) < 1000)
    return notify_fail("你的雪山剑法不够熟练!不能贯通使用！\n");
  if ((int)me->query_skill("jinwu-blade", 1) < 1000)
    return notify_fail("你的金乌刀法不够熟练!不能贯通使用！\n");
  if ((int)me->query_skill("bingxue-xinfa", 1) < 1000)
    return notify_fail("你的冰雪心法等级太低!不能贯通使用！\n");
  if (me->query_skill_mapped("sword") != "xueshan-jianfa")
    return notify_fail("你没正确激发该技能 。\n");
  if (me->query_skill_mapped("force") != "bingxue-xinfa")
    return notify_fail("不使用本门内功，如何使用本门绝学!\n");
  if (!(int)me->query("breakup"))
    return notify_fail("你任督二脉未通,无法使用「雪梅笑」。\n" NOR);
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  msg = WHT "$N贯通凌霄城武学，使出了凌霄城的绝学之精髓！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1		
  //  if (!target->is_busy() && random(3)==1)  target->start_busy(3);
  extra = me->query_skill("xueshan-jianfa", 1) / 10 + me->query_skill("jinwu-blade", 1) / 10;
  attack_time = random((int)me->query_skill("xueshan-jianfa", 1) / 600);
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "xueshan-jianfa",
    1
  ) + me->query_skill("jinwu-blade", 1) + me->query_skill("sword") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  if (attack_time < 1) attack_time = 1;
  if (attack_time > 9) attack_time = 9;
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  me->add_temp("apply/strength", extra);
  for (i = 0; i < attack_time; i++) {
    msg = HIW "$N在漫漫雪花中，一技梅花刺了出来！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  me->add("neili", -1000);
  me->add("jingli", -1000);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->add_temp("apply/strength", -extra);
  msg = HIW "$N长啸一声,使出「万梅飘零」,手中兵器疾卷,掀起万朵雪花向前铺天盖地的撒去。\n"
    "在白茫茫的一片中,忽然出现万朵梅花形剑花,穿透雪幕,朝四面八方狂射而出。\n" NOR;
  message_vision(msg, me, target);

  if ((int)me->query_skill(
    "xueshan-jianfa",
    1
  ) > 2000 && me->query_skill("jinwu-blade", 1) > 2000) {
    qi_wound = me->query("xyzx_sys/level") + me->query_skill(
      "xueshan-jianfa",
      1
    ) + me->query_skill(
      "jinwu-blade",
      1
    ) + me->query_skill("sword") + me->query_skill("blade") + me->query_skill("force");
    if (qi_wound < 100) qi_wound = 100;
    damage = qi_wound / 3 + random(qi_wound / 3);
    damage = damage * (100 - target->query_meridian()) / 100;
    if (random(ap) > dp / 3) {
      me->add("neili", -2000);
      me->add("jingli", -2000);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      msg = HIC "无数梅花光华,幻出道道剑气,将$n全身上下罩得严严实实。$n身在其中,\n"
        "只觉剑光束束,在自己身上丝丝划过,一时全身剧痛,鲜血飞溅得到处都是。如同凌迟之刑,\n"
        "惨不堪言。\n" NOR;
      message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    } else {
      msg = "可是$n轻捷地往旁边一闪，避过了这一剑。\n" NOR;
      message_vision(msg, me, target);
    }

  }
  if ((int)me->query_skill(
    "xueshan-jianfa",
    1
  ) > 3000 && me->query_skill("jinwu-blade", 1) > 3000) {
    if (me->query("jm/lingxiao")) qi_wound = (int)me->query_skill(
      "xueshan-jianfa",
      1
    ) * me->query(
      "dex",
      1
    ) * 3 / 2 + (int)me->query_skill(
      "bingxue-xinfa",
      1
    ) * me->query(
      "con",
      1
    ) * 3 / 2 + (int)me->query_skill(
      "jinwu-blade",
      1
    ) * me->query(
      "dex",
      1
    ) * 3 / 2 + (int)me->query_skill(
      "sword",
      1
    ) + (int)me->query_skill("blade", 1) + (int)me->query_skill("force", 1);
    else qi_wound = (int)me->query_skill(
      "xueshan-jianfa",
      1
    ) * me->query(
      "dex",
      1
    ) + (int)me->query_skill(
      "bingxue-xinfa",
      1
    ) * me->query(
      "con",
      1
    ) + (int)me->query_skill(
      "jinwu-blade",
      1
    ) * me->query(
      "dex",
      1
    ) + (int)me->query_skill(
      "sword",
      1
    ) + (int)me->query_skill("blade", 1) + (int)me->query_skill("force", 1);
    damage = qi_wound / 3 + random(qi_wound / 3) + target->query("qi") * 4 / 100;
    damage = damage * (100 - target->query_meridian()) / 100;
    msg = HIC "$N回剑旋舞，剑势不断加快，剑气呼啸四散，如片片雪花遇风，飘然而出。\n形成一个雪花形旋涡，将$n裹在内里。\n";
    message_vision(msg, me, target);
    if (random(ap) > dp / 3) {
      me->add("neili", -3000);
      me->add("jingli", -3000);
      target->apply_condition("cold_poison", 50 + target->query_condition("cold_poison"));
      if (random(4) == 1) {
        target->map_skill("dodge");  //下特殊轻功
        message_vision(RED "无数雪花将$n笼罩，风雪交加中难以施展身法。\n" NOR, me, target);
      }
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      msg = HIG "$n只觉得四周压力越来越大，道道暗流缠绕周身，几乎动弹不得。\n" NOR;
      message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    } else {
      msg = HIR "可是$n运足内力，雪花顿时全部溶解，一片不剩，脱出重围。\n" NOR;
      message_vision(msg, me, target);
    }

    msg = HIY "$N一抖手中长剑，一式" HIW "「雪花六出」" NOR + HIY "，连续刺出六剑，剑剑快如流星，\n幻成雪花六点，带起一阵寒飚向前疾飘而去。\n" NOR;
    message_vision(msg, me, target);
    me->add_temp("apply/attack", extra * 2);
    me->add_temp("apply/damage", extra * 2);
    me->add_temp("apply/strength", extra * 2);
    msg = HIW "天雪九点！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIW "老枝横斜！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIW "暗香疏影！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIW "岭上双梅！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIW "梅雪争春！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIW "暗影浮香！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    me->add_temp("apply/damage", -extra * 2);
    me->add_temp("apply/attack", -extra * 2);
    me->add_temp("apply/strength", -extra * 2);
    me->add("neili", -1000);
    me->add("jingli", -1000);
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
