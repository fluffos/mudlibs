int valid_enable(string usage) { return usage=="axe" ||  usage=="parry"; }      
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "juehu-shou"; }		//互备技能
string skill_pinji() {return "下乘";}				//品级区分：上乘、中乘、下乘
string skill_xingbie() {return "通用";}				//性别区分：男性、女性、无性、通用
string skill_zhengxie() {return "中立";}			//正邪区分：正道、邪道、中立
string skill_menpai() {return "铁掌帮";}				//门派区分：门派，江湖
string skill_yinyang() {return "阳";}				//阴阳区分：阳、阴、中性
string skill_zhenying() {return "邪派";}			//阵营区分：正派、邪派、中立、通用
int damage_damage() {return 64;}	//外伤系数
int force_damage() {return 45;}		//内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query("family/family_name")!="铁掌帮")
		return notify_fail("你不是铁掌山弟子，无法领悟本门技能的精髓。\n");
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力太弱，无法练断云斧。\n");
	if ((int)me->query_skill("guiyuan-tunafa", 1) < 100)	
		return notify_fail("你的归元吐呐法火候不够，无法学断云斧。\n");	
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
    return 1;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
    if(level >= action[i]["lvl"])
		return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
    if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "axe")
		return notify_fail("你使用的武器不对。\n");    
    if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太低了。\n");
    if (me->query("family/family_name")!="铁掌帮")
		return notify_fail("你不是铁掌山弟子，无法领悟本门技能的精髓。\n");
    if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练断云斧。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 25);
	return 1;
}
string perform_action_file(string action)
{
    return __DIR__"duanyun-fu/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage1,damage2,damage,liannum;
	object weapon1,weapon2;
	ap = me->query_skill("duanyun-fu",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	weapon1 = me->query_temp("weapon");
	weapon2 = victim->query_temp("weapon");
	damage1 = (int)me->query_skill("duanyun-fu",1);
	damage2 = (int)me->query_skill("duanyun-fu",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if ( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
	if ( me->query_skill("guiyuan-tunafa",1) < 100 || me->query_skill("duanyun-fu",1) < 100)	 return 0;
//	if ( me->query_skill_mapped("force") != "guiyuan-tunafa") return 0;
	if (!objectp(weapon1 = me->query_temp("weapon")) || (string)weapon1->query("skill_type") != "sword") return 0;

	if( objectp(weapon2=victim->query_temp("weapon")) && random(ap) > dp/3 && me->query("jiali")>0 && random(7)==0 ) 
	{
		me->add("neili",-100);
		weapon2->unequip();
		weapon2->move(environment(victim));
		return HIW "$N挥舞斧头，使出“砸”字决，只听见「当」"NOR"地一声，$n手中的" + weapon2->name() + "被劈落在地上！\n" NOR;
	}
	if( random(ap) > dp/3 && me->query("jiali")>0 && random(7)==1) 
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		message_vision(HIW "只听 “刺啦” 的一声! $n以为被斧头劈成了两半！万幸，只是被削掉了一块肉！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，一斧快过一斧，接连攻向$n，$n应接不暇连连后退。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/tiezhang") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		if( objectp(weapon2=victim->query_temp("weapon")) && random(3)==1 )
		{
			weapon2->unequip();
			weapon2->move(environment(victim));
			weapon2->set("name", "断掉的"+weapon2->query("name"));
			weapon2->set("item_old_value", weapon2->query("value"));
			weapon2->set("value", 0);
			weapon2->set("backold_weapon_prop", weapon2->query("weapon_prop"));
			weapon2->set("weapon_prop", 0);
			me->add("neili", -100 );
//			me->kill_ob(victim);
//			if( !victim->is_killing(me) ) victim->kill_ob(me);
			message_vision(HIY "$N挥舞斧头，使出铁掌帮的绝技【断云】，只听见「咔嚓」"NOR"地一声，$n手中的" + weapon2->name() + HIY"被砍为两截！\n"NOR, me,victim);
		}
		else
		{
			me->add("neili",-100);
			victim->receive_damage("qi", damage,me);
			victim->receive_wound("qi", damage/3,me);
			message_vision(HIC "$N顿悟铁掌帮武功精髓，使出“轰”字决，只听「砰」的一声，斧头轰在$n身上。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		}
		return ;
	} 
       
}