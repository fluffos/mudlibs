mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int valid_learn(object me) {
  return notify_fail("八部龙女剑只能通过解密五岳派来得到。\n");

}
int practice_skill(object me) {
  return notify_fail("八部龙女剑只能通过演练八部飞天来提高。\n");
}

string perform_action_file(string action) {
  return __DIR__ "babulongnv-jian/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  object weapon1, weapon2;
  int ap, dp, damage1, damage2, damage, liannum;

  weapon1 = me->query_temp("weapon");
  weapon2 = victim->query_temp("weapon");
  damage1 = (int)me->query_skill("babulongnv-jian", 1);
  damage2 = (int)me->query_skill(
    "babulongnv-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  ap = me->query_skill(
    "babulongnv-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "dodge",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("babulongnv-jian", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "shenghuo-shengong") return 0;
  if (!objectp(weapon1 = me->query_temp("weapon")) || (string)weapon1->query("skill_type") != "sword") return 0;

  if (me->query("jiali") > 0 && random(7) == 1 && random(ap) > dp / 3) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    if (objectp(weapon2 = victim->query_temp("weapon"))) {
      me->add("neili", -100);
      victim->add("neili", -damage);
      weapon2->unequip();
      weapon2->move(environment(victim));
      if (me->query_skill_mapped("force") == "zixia-shengong") victim->apply_condition(
        "no_exert",
        20
      );
      if (me->query_skill_mapped("force") == "hanbing-zhenqi") victim->apply_condition(
        "cold_poison",
        20
      );
      if (me->query_skill_mapped("force") == "baiyun-xinfa") victim->apply_condition(
        "no_enforce",
        20
      );
      if (me->query_skill_mapped("force") == "panshi-shengong") victim->apply_condition(
        "no_force",
        20
      );
      if (me->query_skill_mapped("force") == "zhenyue-jue") victim->apply_condition(
        "no_perform",
        10
      );
      message_vision(
        HIR "\n$n只觉得手中" + weapon2->name() + HIR "被八股不同的力道牵引环流，一个把持不定，脱手飞出！\n" NOR,
        me,
        victim
      );
      return;
    } else {
      me->add("neili", -100);
      victim->add("neili", -damage);
      if (!victim->is_busy()) victim->start_busy(2);
      if (me->query_skill_mapped("force") == "zixia-shengong") victim->apply_condition(
        "no_exert",
        20
      );
      if (me->query_skill_mapped("force") == "hanbing-zhenqi") victim->apply_condition(
        "cold_poison",
        20
      );
      if (me->query_skill_mapped("force") == "baiyun-xinfa") victim->apply_condition(
        "no_enforce",
        20
      );
      if (me->query_skill_mapped("force") == "panshi-shengong") victim->apply_condition(
        "no_force",
        20
      );
      if (me->query_skill_mapped("force") == "zhenyue-jue") victim->apply_condition(
        "no_perform",
        10
      );
      message_vision(
        HIY "$N眼见这八招似乎毫无章法，但不知$n是否有更厉害的后招，手中" + weapon1->name() + HIY "连劈带刺，以进为退，破解了$n的绝杀！\n" NOR,
        me,
        victim
      );
      return;
    }
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIM "$N飞身跃起，" + weapon1->name() + HIM "化作八部天龙，" + me->query("cognize") + HIM "的力量爆发，刺向$n要害！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/babu")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(HIR "$N洞察五岳形胜，一剑挥出，夹杂着八部奥义。\n" NOR, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    return;
  }
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage) {
  object weapon;
  int j, neili, neili1, ap, dp, damage2;
  weapon = me->query_temp("weapon");
  neili = me->query("neili");
  neili1 = ob->query("neili");
  ap = me->query_skill(
    "babulongnv-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "parry",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage2 = (int)me->query_skill(
    "babulongnv-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill("babulongnv-jian", 1) < 100) return damage;
  //	if ( me->query_skill_mapped("force") != "shenghuo-shengong") return 0;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return damage;

  if (random(ap) > dp / 4 && random(8) == 1) {
    if (neili >= neili1) {
      message_vision(HIY "结果$n的力道被$N手中" + weapon->name() + HIY "一挡一挑，卸在了一旁!\n" NOR, me, ob);
      j = -(damage * 3 + random(damage * 3));
      me->add("neili", -100);
    } else if (neili < random(neili1) + damage && neili * 2 > random(neili1) + damage) {
      message_vision(HIY "结果$n的力道被$N手中" + weapon->name() + HIY "一圈，卸掉了一半!\n" NOR, me, ob);
      j = -(damage * 2 + random(damage * 2));
      me->add("neili", -100);
    } else {
      message_vision(HIY "$N手中" + weapon->name() + HIY "回挡，卸掉了$n一小半的力道!\n" NOR, me, ob);
      j = -(damage + random(damage));
      me->add("neili", -100);
    }
    return j;
  }
  if (random(8) == 2 && random(ap) > dp / 4 && (int)me->query("breakup") > 1) {
    j = -(damage + random(damage));
    me->add("jingli", -100);
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    message_vision(
      HIC "$N脚踏五岳，一时豪情万丈，" + me->query("cognize") + HIC "的力量爆发，反手一剑刺向$n！\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(8) == 3 && random(ap) > dp / 4 && (int)me->query("jm/babu")) {
    j = -(damage + random(damage));
    me->add("neili", -100);
    if (!ob->is_busy()) ob->start_busy(1);
    message_vision(HIG "$N览遍五月风光，洞悉五岳八部之精髓，挥剑时隐隐有龙女风采，$n一时错乱不已！\n" NOR, me, ob);
    return j;
  }
}
