// tianmo-shengong.c 天魔神功
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "tianmo-jian"; }		//互备技能
string skill_pinji() {return "中乘";}				//品级区分：上乘、中乘、下乘
string skill_xingbie() {return "通用";}				//性别区分：男性、女性、无性、通用
string skill_zhengxie() {return "邪道";}			//正邪区分：正道、邪道、中立
string skill_menpai() {return "日月神教";}				//门派区分：门派，江湖
string skill_yinyang() {return "阴";}				//阴阳区分：阳、阴、中性
string skill_zhenying() {return "邪派";}			//阵营区分：正派、邪派、中立、通用
//int damage_damage() {return 85;}	//外伤系数
//int force_damage() {return 58;}		//内伤系数
int qi_heal() {return 63;}		//内功疗气系数
int jing_heal() {return 43;}		//内功疗精系数
int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
	mapping skl;
	string *sname;
	int i;
		
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
    if (me->query("family/family_name")!="日月神教")
		return notify_fail("你不是本门中人，无法学习本门技能。\n");
	if ((int)me->query("con", 1) < 30)
		return notify_fail("你的根骨不适合学习天魔神功。\n");
	if ((int)me->query_skill("force", 1) < 100 || (int)me->query_skill("force", 1) < (int)me->query_skill("tianmo-shengong", 1))
		return notify_fail("你的基本内功火候不足，不能学天魔神功。\n");
	if ((int)me->query("shen") > -50000)
		return notify_fail("学天魔神功，要心狠手辣，奸恶歹毒，你可做得不够呀！\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	
	skl = this_player()->query_skills();
	sname  = keys(skl);
	for (i=0;i<sizeof(skl);i++)
	{
        if (sname[i]=="tianmo-shengong") continue;
        if (sname[i]=="xixing-dafa") continue;
        if (sname[i]=="yijing-force") continue;
		if( SKILL_D(sname[i])->valid_enable("force") )
            return notify_fail("你不先散了别派内功，怎能学北冥神功？！\n");
	}
	if (random(100)==1) me->add("score",-5);
	return 1;
}

int practice_skill(object me)
{
	return notify_fail("天魔神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"tianmo-shengong/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp, damage1,damage2,damage,liannum;

    ap = me->query_skill("tianmo-quan",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("tianmo-shengong",1);
	damage2 = (int)me->query_skill("tianmo-shengong",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("tianmo-shengong",1) < 100 ) return 0;
	if ( me->query_skill_mapped("force") != "tianmo-shengong") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		message_vision(HIB "$N发挥出"+HIR+"天魔神功"NOR HIB"的吸星大法，吸走了$n的精血！！！！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，默运天魔解体大法，真气翻腾，气势威宏，摧毁了$n经脉。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/riyue") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->add("neili",-damage);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIM"$N领悟日月神教魔功精髓，一声冷笑! 隔空吸功！$n全身气血如流水般源源不绝地吸入$N的身体！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}


