#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

#define JUE "「" HIR "绝情斩" NOR "」"

inherit F_SSERVER;


int perform(object me, object target) {
  int damage, i, extra;
  string msg;
  object weapon;
  int ap, dp;

  if (!target) target = offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail(JUE "只能在战斗中对对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对！\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
  if ((int)me->query_skill("badao", 1) < 1000)
    return notify_fail("你霸刀火候不足，无法施展" JUE "。\n");
  if ((int)me->query_skill("force", 1) < 1000)
    return notify_fail("你基本内功修为不够，无法施展" JUE "。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够。\n");
  if (me->query("neili") < 10000)
    return notify_fail("你现在真气不够，无法施展" JUE "！\n");
  if (me->query("max_neili") < 200000)
    return notify_fail("你现在内力修为不够，无法施展" JUE "！\n");
  //	if (me->query_skill_mapped("blade") != "badao")
  //		return notify_fail("你没有激发霸刀，无法使用" JUE "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (target && !living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  me->add("neili", -3000);
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "badao",
    1
  ) + me->query_skill("blade") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  extra = me->query_skill("badao", 1) / 10;
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1	

  message_vision(
    HIC "$N" HIC "负刀而立，猛然间，刀锋一转，一股强劲的刀气奔腾而出，犹如龙卷风般呼啸而至，将$n" HIC "笼罩。\n" NOR,
    me,
    target
  );
  if (random(ap) > dp / 3) {
    message_vision(
      HIY "$N挥动起手中" + weapon->name() + HIY "，一股强劲的气流自全身涌向" + weapon->name() + HIY "，顿时，刀气四溢，杀气腾腾。\n" NOR,
      me,
      target
    );
    me->add_temp("apply/damage", extra);
    me->add_temp("apply/attack", extra);
    for (i = 0; i < 6; i++) {
      if (!me->is_fighting(target))
        break;
      COMBAT_D->do_attack(me, target, weapon, 0);
    }
    me->add_temp("apply/damage", -extra);
    me->add_temp("apply/attack", -extra);
  } else {
    msg = CYN "可是$N" CYN "看破了$n" CYN "的企图，镇定逾恒，全神应对自如。\n" NOR;
    message_vision(msg, target, me);
  }

  message_vision(HIW "\n$N" HIW "一声长叹，似乎看尽凡尘沧桑，事态万千，持刀而立，遥望天际 ……\n\n", me, target);
  // 第一刀
  msg = HIY "$N踏步向前，施展出绝情斩之「一刀入魔」，" + weapon->name() + HIY "顺势劈过，狂风骤起，大地回归黑暗 ……\n" NOR;
  message_vision(msg, me, target);
  if (random(ap) > dp / 4) {
    damage = ap / 4 + random(dp / 4);
    damage = damage * (100 - target->query_meridian()) / 100;
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 2, me);
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    msg = HIR "$n惊魂未定，竟然不知躲避，被$N一刀劈过，刀气如体，口吐鲜血，接连后退。\n" NOR;
    message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
  } else {
    msg = CYN "$N飞身一跃，滚在一边。\n" NOR;
    message_vision(msg, target, me);
  }

  // 第二刀
  msg = HIY "\n$N轻叹，猛然间，手臂一挥，一式绝情斩之「人间炼狱」已然使出，" + weapon->name() + HIY "长鸣一声"
    "，划破黑暗，吹吸间，一道炽热的白光卷向$n" HIY "，周围空气令人窒息。\n" NOR;
  message_vision(msg, me, target);
  if (random(ap) > dp / 3) {
    damage = ap / 3 + random(dp / 3);
    damage = damage * (100 - target->query_meridian()) / 100;
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 2, me);
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    msg = HIR "$n惊魂未定，竟然不知躲避，被$N一刀劈过，刀气如体，口吐鲜血，接连后退。\n" NOR;
    message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
  } else {
    msg = CYN "$N胡乱施展招式，竟将这招化解。\n" NOR;
    message_vision(msg, target, me);
  }

  // 第三刀
  msg = HIY "\n$N双眼一红，力量大增，猛然怒呵一声，飞天而起，一式绝情斩之「雄霸天下」，但见天地又重归黑暗，似乎整个尘世已经"
    "坠入无间地狱般，令人再无半点生念，突然，四周充斥着鬼哭狼嚎的巨响，$N" HIY "却早已没了踪影。\n" NOR;
  message_vision(msg, me, target);
  if (random(ap) > dp / 2) {
    damage = ap / 2 + random(dp / 2);
    damage = damage * (100 - target->query_meridian()) / 100;
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 2, me);
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    msg = HIR "$n惊魂未定，竟然不知躲避，被$N一刀劈过，刀气如体，口吐鲜血，接连后退。\n" NOR;
    message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
  } else {
    msg = CYN "$N收摄心神，小心应对，竟将此招化解与无形。\n" NOR;
    message_vision(msg, target, me);
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
