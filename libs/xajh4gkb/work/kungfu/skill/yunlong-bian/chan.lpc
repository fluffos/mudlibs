// chan.c 云龙鞭法 缠字诀
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  object weapon;
  string msg;
  int skill, ap, dp, busy_time;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("牵制攻击只能对战斗中的对手使用。\n");
  if ((int)me->query_skill("yunlong-bian", 1) < 300)
    return notify_fail("你的「云龙鞭法」功力太浅，使不了「缠」字诀！\n");
  if ((int)me->query_skill("yunlong-shengong", 1) < 300)
    return notify_fail("你的「云龙神功」功力太浅，使不了「缠」字诀！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的真气不够。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || weapon->query("skill_type") != "whip")
    return notify_fail("你使用的武器不对。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着！\n");
  if (target && target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧!\n");
  if (target && target->query_temp("busy_mianyi"))  //冲穴成功后免疫busy，2017.9.29阿飞添加
    return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
  //	if ( !wizardp(me) && me->query_skill_mapped("force") != "yunlong-shengong")
  //		return notify_fail("不使用本门内功，如何使用本门绝学!\n"); 	
  //	if (me->query_skill_mapped("whip") != "yunlong-bian")
  //		return notify_fail("你没正确激发该技能 。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  skill = (int)me->query_skill("yunlong-bian", 1);
  msg = CYN "$N使出云龙鞭法「缠」字诀，连挥长鞭企图把$n的全身缠住。\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "yunlong-bian",
    1
  ) + me->query_skill("whip") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  busy_time = (30 * skill) / (skill + 2000);
  if (stringp(target->query("inborn")) && (string)target->query("inborn") == YEL "冷静" NOR) busy_time = (30 * skill) / (skill + 2000) * 7 / 10;
  if (random(ap) > dp / 3) {
    msg = "结果$p被$P攻了个措手不及!\n" NOR;
    message_vision(msg, me, target);
    target->start_busy(busy_time + 5);
    tell_object(target, HIY "你陷入忙乱之中，一时无法动弹。\n" NOR);
  } else {
    msg = "可是$p看破了$P的企图，并没有上当。\n" NOR;
    message_vision(msg, me, target);
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
