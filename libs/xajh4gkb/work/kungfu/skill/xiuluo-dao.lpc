int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
    object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
		return notify_fail("你必须要先弄把刀来。\n");
	if (me->query("family/family_name")!="少林派")
		return notify_fail("你不是佛门中人，无法学习少林绝技。\n");	
	if (!me->query("jm/songshan"))
		return notify_fail(CYN"这嵩山派与我寺同处一山，欲夺取武林盟主之位，我少林表示不服。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否先为我少林潜入嵩山派夺取其秘密？我寺将来必有厚报。\n"NOR);
	if ((int)me->query("family_score")<10)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我寺功夫恐怕不能传授于你。\n"NOR);	
    if ((int)me->query("max_neili") < 10000)
        return notify_fail("你的内力不够。\n");
    if (me->query_skill("blade", 1) <=me->query_skill("xiuluo-dao", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    if ((int)me->query_skill("hunyuan-yiqi", 1) < 100 && (int)me->query_skill("yijinjing", 1) < 100 )
		return notify_fail("你的少林内功火候不够，无法学习少林武技。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");	
	if (random(100)==1) me->add("score",-5);
    return 1;
}
string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	if(level >= action[i]["lvl"])
		return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}
int practice_skill(object me)
{
    object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
	if (!objectp(weapon = me->query_temp("secondary_weapon")) || (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");
	if (me->query("family/family_name")!="少林派")
		return notify_fail("你不是佛门中人，偷练少林绝技会走火入魔。\n");	
	if (!me->query("jm/songshan"))
		return notify_fail(CYN"这嵩山派与我寺同处一山，欲夺取武林盟主之位，我少林表示不服。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否先为我少林潜入嵩山派夺取其秘密？我寺将来必有厚报。\n"NOR);
	if ((int)me->query("family_score")<10)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我寺功夫恐怕不能传授于你。\n"NOR);		
    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够练修罗刀。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");	
    me->receive_damage("qi", 35);
    return 1;
}


string perform_action_file(string action)
{
	return __DIR__"xiuluo-dao/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	object weapon;	
	int ap,dp,skill1,skill2,skill3,skill4,damage1,damage2,damage,liannum;
	int flag = 1;
	weapon = me->query_temp("weapon");
    ap = (int)me->query_skill("xiuluo-dao",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
    dp = (int)victim->query_skill("unarmed",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	skill1 = (int) me->query_skill("yijing-force",1);
	skill2 = (int) me->query_skill("hunyuan-yiqi",1);
	skill3 = (int) me->query_skill("yijinjing",1);	
	skill4 = (int) me->query_skill("damo-force",1);
	damage1 = (int) me->query_skill("xiuluo-dao",1);
	damage2 = (int) me->query_skill("xiuluo-dao",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ((skill1 < 300 && skill2 < 200 && skill3 < 100 && skill4 < 200) || (int)me->query_skill("xiuluo-dao",1)<100) return 0;
//	if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi" && me->query_skill_mapped("force") != "yijing-force" && me->query_skill_mapped("force") != "damo-force") return 0;
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade") return 0;
	
	if (me->query_skill_mapped("force") == "yijinjing" ) flag = 4;
	if (me->query_skill_mapped("force") == "hunyuan-yiqi" ) flag = 2;
	if (me->query_skill_mapped("force") == "yijing-force" ) flag = 1;
	if (me->query_skill_mapped("force") == "damo-force" ) flag = 2;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		message_vision(HIR"$N身法加快，只见刀光乱舞，$n被砍了无数刀，遍体鳞伤！\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，手中" + weapon->name() + HIG "杀气四起，凄厉之声大作，似乎要将$n辟入地狱。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/shaolin") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIM"$N融汇少林武功精髓，手中" + weapon->name() + HIM "连劈数刀，疾风骤雨般将$n砍的鲜血淋漓！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}	

}
