int valid_learn(object me) {
  object ob;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力不够，没有办法练三才剑法。\n");
  if ((int)me->query("dex", 1) < 25)
    return notify_fail("你的身法太差，无法练「三才剑法」。\n");
  if ((int)me->query("int", 1) < 25)
    return notify_fail("你的悟性太差，无法练「三才剑法」。\n");
  if ((int)me->query_skill("zhenfeng-xinfa", 1) < 300)
    return notify_fail("你的「震风心法」火候不够，无法学「三才剑法」。\n");
  if ((int)me->query_skill("piaoyibu", 1) < 300)
    return notify_fail("你的「飘逸步法」火候不够，无法学「三才剑法」。\n");
  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  if (me->query("family/family_name") != "圣剑魔宫")
    return notify_fail("你不是圣剑魔宫传人，无法学习三才剑法。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}
