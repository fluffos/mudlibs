int valid_learn(object me)
{   
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	   
	if ( me->query("gender") != "女性" )
		return notify_fail("你又不是玉女，怎么可能练的了玉女剑法？\n");
	if (me->query("family/family_name")!="古墓派")
		return notify_fail("你不是古墓派弟子，无法学习玉女素心剑。\n");
	if (!me->query("jm/quanzhen"))
		return notify_fail(CYN"我古墓派祖师与全真教重阳真人恩怨纠葛，可惜最终未能修成正果。我古墓弟子都得先去全真门下修行一段时间方可入门。\n"NOR);	
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的内力不够。\n");
	if (me->query_skill("yunv-shenfa",1)<100)
		return notify_fail("你的玉女身法修为不够。\n");	
	if (me->query_skill("yunv-jianfa", 1) >= me->query_skill("sword",1))
		return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	if (me->query_skill("yunv-xinjing",1)<100 && me->query_skill("yunv-xinfa",1)<100)			
		return notify_fail("你的玉心法功力不够。\n");
	if ((int)me->query("dex", 1) < 30)
		return notify_fail("我古墓派女子剑法无不是轻盈灵动，你这资质恐怕练不了。\n");	
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	if (random(100)==1) me->add("score",-5);		
	return 1;
}

string query_skill_name(int level)
{
	int i = sizeof(action);

	while (i--)
	if(level > action[i]["lvl"])
		return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
	if (me->query("family/family_name")!="古墓派")
		return notify_fail("你不是古墓派弟子，无法练习玉女素心剑。\n");
	if (!me->query("jm/quanzhen"))
		return notify_fail(CYN"我古墓派祖师与全真教重阳真人恩怨纠葛，可惜最终未能修成正果。我古墓弟子都得先去全真门下修行一段时间方可入门。\n"NOR);	
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if ( me->query("gender") != "女性" )
		return notify_fail("你又不是玉女，怎么可能练的了玉女剑法？\n");
	if ((int)me->query("neili") < 10)
		return notify_fail("你的内力不够练玉女剑法。\n");
	if ((int)me->query("qi") < 40)
		return notify_fail("你的体力不够练玉女剑法。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 25);
	me->add("neili", -5);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"yunv-jianfa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;
	object weapon;
	weapon = me->query_temp("weapon");
    ap = me->query_skill("yunv-jianfa",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("yunv-jianfa",1);
	damage2 = (int)me->query_skill("yunv-jianfa",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( (me->query_skill("yunv-xinfa",1) < 100 && me->query_skill("yunv-xinjing",1) < 100 && me->query_skill("jiuyin-zhenjing",1) < 100) || me->query_skill("yunv-jianfa",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") != "yunv-xinjing" && me->query_skill_mapped("force") != "jiuyin-zhenjing") return 0;
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		message_vision(HIR "只见$N剑光一闪，一股鲜血从$n被割裂的伤口喷出！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，手中" + weapon->name() + HIG "如影相随，人似清风，影随$n周身，身形飘飘中剑光熠熠生辉！。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/gumu") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIM"$N融汇古墓派武学精髓，心如止水！连绵剑气划过了$n的胸口，结果鲜血狂奔。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}


