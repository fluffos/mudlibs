int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	 
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练昆仑掌必须空手。\n");
  if ((int)me->query_skill("xuantian-wuji", 1) < 300)
    return notify_fail("你的玄天无极功火候不够，无法练昆仑掌。\n");
  if (me->query("family/family_name") != "昆仑派")
    return notify_fail("你不是昆仑弟子，无法学习本门技能。\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为不够，无法练昆仑掌。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");			
  if (me->query("family/family_name") != "昆仑派")
    return notify_fail("你不是昆仑弟子，无法练习本门技能。\n");
  if ((int)me->query("jing") < 50)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练昆仑掌。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  me->receive_damage("jing", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "kunlun-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage1, damage2, damage, liannum;
  ap = (int)me->query(
    "str",
    1
  ) * (int)me->query_skill(
    "kunlun-zhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = (int)victim->query(
    "con",
    1
  ) * (int)me->query_skill(
    "force",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("kunlun-zhang", 1);
  damage2 = (int)me->query_skill(
    "kunlun-zhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "xuantian-wuji",
    1
  ) < 100 || me->query_skill("kunlun-zhang", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "xuantian-wuji") return 0;
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIY "$N运转玄天无极神功，双掌一阴一阳，左掌发红，右掌发白！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，$n被阴阳无极之力影响，身法越来越慢，一个闪避不急中了一掌！。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/kunlun")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIM "$N参悟昆仑绝技，掌力突然浑厚无比，一掌拍出，巍峨磅礴。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
