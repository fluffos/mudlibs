// biyun-xinfa.c 碧云心法
// cleansword
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;

int valid_enable(string usage)
{
	return usage == "force";
}
//2019-1-1阿飞新规划，技能代码完善
