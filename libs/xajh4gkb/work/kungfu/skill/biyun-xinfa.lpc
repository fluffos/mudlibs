{
  return ([
        "status_msg" : "双目微闭，周围落叶环绕。\n" ,
        "start_my_msg" : "双臂做环抱装，周身落叶随风起舞，环绕在周身。\n",
        "start_other_msg" :  me->name() + "双臂做环抱装，周身落叶随风起舞，环绕在周身。\n",
        "heal_my_msg" : "全身衣服鼓起，周围有旋风刮起，落叶随风起舞，愈演愈烈，逐渐将周身环绕在内。\n",
        "heal_other_msg" :  me->name() + "全身衣服鼓起"+ me->name() + "周身落叶飞舞，愈演愈烈，将"+ me->name() + "全身都遮没了。\n",
        "halt_msg" :  "长出一口气，将内息急速退了回去，站了起来，周围一地落叶。\n",
        "end_my_msg" : "睁开双眼，缓缓站起，周围落叶突然失去支撑，落了一地。\n",
        "end_other_msg" : me->name()+"睁开双眼，缓缓站起，周围落叶突然失去支撑，落了一地。\n",		
        "hover_my_msg" : "全身骨节爆响，落叶风随云转。过了良久，风声渐止，云停叶落。\n",
        "hover_other_msg" : "只听得"+me->name()+"全身骨节爆响，落叶风随云转。过了良久，风声渐止，云停叶落。\n",	
    ]);
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage1,damage2,damage,liannum;
	damage1 = (int)me->query_skill("biyun-xinfa",1);
	damage2 = (int)me->query_skill("biyun-xinfa",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	ap = me->query_skill("biyun-xinfa",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if ( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
	if ( me->query_skill("biyun-xinfa",1) < 100) return 0;
	if ( me->query_skill_mapped("force") != "biyun-xinfa") return 0;	

	if ( random(ap) > dp/3 && random(7)==1 && me->query("jiali") > 0) 
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100 );
		message_vision(HIB "$N运转"+HIR+"碧云心法"NOR HIB"的精髓，摧毁了$n的真元！！！！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIR "$N长出一口气，"+me->query("cognize")+HIR"的力量将四周落叶吹起，环绕在周身。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/tangmen") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIR "$N融汇唐门武功之精华，一股内劲悄然侵入$n丹田。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}