#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;
int perform(object me, object target)
{
	string msg;
	int flag,skill,busy_time;
	int ap,dp;
	flag = 1;
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("悲痛莫明只能对战斗中的对手使用。\n");
	if( me->is_busy() )
		return notify_fail("你现在正忙着呢，哪有空运功？\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if( target && target->is_busy() )
		return notify_fail(target->name() + "已经不能动了！\n");
	if ( target && target->query_temp("busy_mianyi") )	//冲穴成功后免疫busy，2017.9.29阿飞添加
		return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
	if( me->query_temp("weapon"))
		return notify_fail("你先放下手中的武器再说吧？！\n");
	if( (int)me->query_skill("damo-force", 1) < 300 && (int)me->query_skill("fanyun-force", 1) < 300 )	
		return notify_fail("你的本门神功不够娴熟，无法施展大悲掌。\n");
	if( (int)me->query_skill("dabei-zhang", 1) < 300 )
		return notify_fail("你的大悲掌不够娴熟，不会使用「悲痛莫明」。\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的内力不够，无法使用「悲痛莫明」。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if( (int)me->query("max_neili") < 10000 )
		return notify_fail("你的内力修为不足，无法使用「悲痛莫明」。\n");	
//	if(me->query_skill_mapped("force") != "fanyun-force" && me->query_skill_mapped("force") != "damo-force")
//		return notify_fail("不使用本门内功，如何能使用本门绝技。\n");
//	if (me->query_skill_mapped("unarmed") != "dabei-zhang")
//		return notify_fail("你没正确激发该技能 。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	if (me->query_skill_mapped("force") == "damo-force") flag = 2;
	if (me->query_skill_mapped("force") == "fanyun-force") flag = 1;
	msg = HIB "$N脸上露出一丝悲痛的神情，和手念了一声阿弥陀佛,\n"NOR;
	msg += HIB "双手缓缓的推出，看似平常的一招，可是看不出一丝\n"NOR;
	msg += HIW "破绽，此招正是大悲掌最后绝技「悲痛莫明」。\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	skill = (int)me->query_skill("dabei-zhang", 1);
	ap = me->query("xyzx_sys/level") + me->query_skill("dabei-zhang", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	busy_time = (30*skill)/(skill+2000);
	if( stringp(target->query("inborn")) && (string)target->query("inborn")==YEL"冷静"NOR) busy_time = (30*skill)/(skill+2000)*7/10;
	if( random(ap) > dp/3 )
	{
		msg = HIW "$p企图突破$N的攻击范围，但是被$N的掌风避的毫无退路。\n" NOR;
		message_vision(msg, me, target);
		target->start_busy(busy_time+3*flag);
		tell_object(target, HIY"你陷入忙乱之中，一时无法动弹。\n"NOR);
//		target->apply_condition("no_enforce", 10*flag);
		me->add("neili", -500);
	}
	else
	{
		me->add("neili",-300);
		msg = HIC "$n一眼看出了$N的破绽，躲了过去。\n" NOR;
		message_vision(msg, me, target);
	}
	
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}