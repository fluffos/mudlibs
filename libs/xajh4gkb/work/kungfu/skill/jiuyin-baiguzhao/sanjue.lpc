// sanjue 九阴三绝爪

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;

int perform(object me, object target)
{
	int skill,damage,damage1,ap,dp;
	string msg;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) ) 
		return notify_fail("「九阴三绝爪」只能在战斗中使用。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if (objectp(me->query_temp("weapon")))
		return notify_fail("你拿着武器怎么能使用「九阴三绝爪」！\n");
	if ( (int)me->query_skill("jiuyin-zhenjing",1) < 1000 )
		return notify_fail("你的九阴真经还不够娴熟，使不出「九阴三绝爪」绝技。\n");
	if ( (int)me->query_skill("jiuyin-baiguzhao", 1) < 1000 )
		return notify_fail("你的九阴白骨爪还不够娴熟，使不出「九阴三绝爪」绝技。\n");
//	if ( me->query_skill_mapped("force") != "jiuyin-zhenjing")
//         return notify_fail("你必须激发九阴真经才能使用「摧筋破骨」！\n"); 
//	if ( me->query_skill_mapped("unarmed") != "jiuyin-baiguzhao" )
//		return notify_fail("你现在无法使用「九阴三绝爪」！\n");
	if ( (int)me->query("max_neili") < 500000 )
		return notify_fail("你现在内力不够深厚，使不出「九阴三绝爪」。\n");
	if ( (int)me->query("max_jingli") < 500000 )
		return notify_fail("你现在精力修为太差，使不出「九阴三绝爪」。\n");
	if ( (int)me->query("neili") < 10000 )
		return notify_fail("你现在真气太弱，使不出「九阴三绝爪」。\n");
	if ( (int)me->query("jingli") < 10000 )
		return notify_fail("你现在精神糜钝，使不出「九阴三绝爪」。\n");
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用[" HIR "九阴三绝爪" NOR "]\n"NOR); 
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

	message_vision(HIR"\n$N手臂突然伸长，向$n抓去！\n"NOR,me,target);
	message_vision(RED"\n$N所使的似乎是江湖中驰名的阴毒功夫九阴白骨爪，但是招数光明正大，威力强极！\n"NOR,me,target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1	
	ap = me->query("xyzx_sys/level") + me->query_skill("jiuyin-baiguzhao", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	skill = (int)me->query_skill("jiuyin-baiguzhao", 1)/10+(int)me->query_skill("jiuyin-zhenjing", 1)/10;
	me->add_temp("apply/strength",skill);
	me->add_temp("apply/dexerity",skill);
	me->add_temp("apply/attack", skill);
	me->add_temp("apply/damage", skill);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
	me->add_temp("apply/damage", -skill);
	me->add_temp("apply/attack", -skill);
	me->add_temp("apply/strength",-skill);
	me->add_temp("apply/dexerity",-skill);
	me->add("neili", -1000);
	
if ( (int)me->query_skill("jiuyin-baiguzhao", 1) > 2000 )	
{
	msg = HIB "\n$N一声怪啸，绕着$n急转数圈，而后施展出「摧筋破骨」，双爪齐出，直插$n前胸。\n"NOR;
	message_vision(msg, me, target);
	if ( random(ap) > dp/3 )
	{
		damage = me->query_skill("jiuyin-baiguzhao",1)*me->query("int",1) + me->query_skill("jiuyin-zhenjing",1)*me->query("int",1) + me->query_skill("force",1) + me->query_skill("unarmed",1);
		damage = damage/9 + random(damage/9);
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("jing",damage,me);
		target->receive_wound("jing",damage/2,me);
		me->add("neili", - 2000);
		me->add("jingli", - 2000);
		msg = HIR"$N已在$n前胸留下了五个整整齐齐的指洞！$n只觉胸口巨痛，鲜血狂喷而出！！！\n"NOR;
		msg += HIR"\n结果只听见几声喀喀轻响，$n一声惨叫，像滩软泥般塌了下去！！\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		msg = HIY"$N只觉$n内力浑厚，双爪竟不能惯胸而入。\n" NOR;
		message_vision(msg, me, target);
	}
}

if ( (int)me->query_skill("jiuyin-baiguzhao", 1) > 3000 )	
{	
    msg = HIC "$N突然将双掌变爪合于胸前，然后象风车般急转数圈，而后施展出「亡魂一击」，双爪向外一翻，随后绕着$n疾转数圈，又回到原地。\n"NOR;
	message_vision(msg, me, target);
	damage = me->query_skill("jiuyin-baiguzhao",1)*me->query("int",1)/3 + me->query_skill("jiuyin-zhenjing",1)*me->query("int",1)/3 + me->query_skill("force",1) + me->query_skill("unarmed",1);
	damage1 = target->query("max_qi") - target->query("eff_qi");
	if (damage1<100) damage1 = 100;
	if (damage1>500000) damage1 = 500000;
	damage = damage/5 + random(damage/5)+damage1/15;
	damage = damage*(100-target->query_meridian())/100;
    if (random(ap)>dp/3 )
    {
        target->receive_damage("jing", damage, me);
        target->receive_wound("jing", damage/2, me);
		me->add("neili", - 2000);
		me->add("jingli", - 2000);
		msg = HIC"原来$N已在$n头顶留下了五个整整齐齐的指洞！$n只觉得头顶一阵麻痒，就软软地歪在一边了。厉害！！！\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    } else
    {
        msg = HIY"可是$n看破了$N的企图，闪身护头躲在了一边。\n"NOR;
		message_vision(msg, me, target);
    }
}

if ( (int)me->query_skill("jiuyin-baiguzhao", 1) > 4000 )	
{
    msg = HIC "$N一声怪啸，绕着$n急转数圈，而后施展出「摧筋破骨」，双爪齐出，直插$n前胸。\n"NOR;
	message_vision(msg, me, target);
	damage = me->query_skill("jiuyin-baiguzhao",1)*me->query("int",1) + me->query_skill("jiuyin-zhenjing",1)*me->query("int",1) + me->query_skill("force",1) + me->query_skill("unarmed",1);
	damage1 = target->query("max_qi") - target->query("eff_qi");
	if (damage1<100) damage1 = 100;
	if (damage1>1000000) damage1 = 1000000;
	damage = damage/3 + random(damage/3)+damage1/10;
	damage = damage*(100-target->query_meridian())/100;
	if (random(ap) > dp/3)
	{
		if (me->query("neili") > target->query("neili"))
		{
			target->receive_damage("jing", damage, me);
			target->receive_wound("jing", damage/2, me);                         
			target->apply_condition("jy_poison",30);
			me->add("neili", - 2000);
			me->add("jingli", - 2000);
			msg = HIR"$N已在$n前胸留下了五个整整齐齐的指洞！$n只觉胸口巨痛，鲜血狂喷而出！！！\n"NOR;
			message_vision(msg, me, target, damage, HBWHT+HIM"精神伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		} 
		else 
		{
			target->receive_damage("qi", damage, me);
			target->receive_wound("qi", damage/2, me);                         
			me->add("neili", - 1000);
			me->add("jingli", - 1000);
			msg = HIY"$N只觉$n内力浑厚！双爪竟不能惯胸而入,只在$n胸前留下了一道血痕！！！\n"NOR;
			message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		} 
		if (!target->query_condition("no_perform") )
		{
			target->apply_condition("no_perform", 20);
			message_vision( HIC"\n$n被$N刺中穴道，手腕酥麻无力，运转失灵，难以施展外功。\n" NOR, me, target);
		}
	} 
	else
	{
		msg = HIY"可是$n早有防备，不慌不忙,卸开了$N的双爪。\n"NOR;
		message_vision(msg, me, target);
	}
}

	
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}