int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练伏魔掌必须空手。\n");
  if (me->query("family/family_name") != "蜀山派")
    return notify_fail("你不是蜀山中人，无法学习本门技能。\n");
  if ((int)me->query_skill("shushan-force", 1) < 100)
    return notify_fail("你的蜀山内功火候不够，无法学习伏魔掌。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "juehu-shou"; }		//互备技能
string skill_pinji() { return "中乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "正道"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "蜀山派"; }    //门派区分：门派，江湖
string skill_yinyang() { return "中性"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "中立"; }   //阵营区分：正派、邪派、中立、通用
int damage_damage() { return 66; }  //外伤系数
int force_damage() { return 47; }  //内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("jing") < 30)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("neili") < 10)
    return notify_fail("你的内力不够了。\n");
  if (me->query("family/family_name") != "蜀山派")
    return notify_fail("你不是蜀山中人，无法练习门技能。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);

  return 1;
}
string perform_action_file(string func) {
  return __DIR__ "fumozhang/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage1, damage2, damage, liannum;
  damage1 = (int)me->query_skill("fumozhang", 1);
  damage2 = (int)me->query_skill(
    "fumozhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  ap = me->query_skill(
    "fumozhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "force",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("shushan-force", 1) < 100 || me->query_skill("fumozhang", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "shushan-force") return 0;	
  if (objectp(me->query_temp("weapon"))) return 0;

  if (me->query("jiali") > 0 && random(ap) > dp / 3 && random(7) == 1) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    me->add("neili", -100);
    message_vision(
      HIR "$N大吼一声：御剑伏魔！$n被声波震的两眼发花！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIG "$N嘿嘿一笑，发挥出" + me->query("cognize") + HIG "力量，双臂突然变长，一掌印在$n胸口。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/shushan")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(2);
    message_vision(
      HIC "$N融汇蜀山派武学精髓，身形突然变快，双掌佛光大盛，探入$n怀中。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
