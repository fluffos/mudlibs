    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "neili": 80,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左掌划一半圆，一式" HIR "「铁血丹心」" NOR "，右掌斜穿而出，疾拍$n的胸前大穴",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "neili": 70,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一式" HIM "「荡尽群魔」" NOR "，右掌上引，左掌由后而上一个甩劈，斩向$n的$l",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "neili": 60,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左掌护胸，右拳凝劲后发，一式" HIY "「横空出世」" NOR "，缓缓推向$n的$l",
    "attack": 400,
    "parry": 400,
    "dodge": 400,
    "damage": 400,
    "force": 400,
    "neili": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一式" HIG "「力拔千钧」" NOR "，全身飞速旋转，双掌一前一后，猛地拍向$n的胸口",
    "attack": 500,
    "parry": 500,
    "dodge": 500,
    "damage": 500,
    "force": 500,
    "neili": 90,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N合掌抱球，猛吸一口气，一式" HIW "「群魔伏首」" NOR "，双掌疾推向$n的肩头",
    "attack": 600,
    "parry": 600,
    "dodge": 600,
    "damage": 600,
    "force": 600,
    "neili": 60,
