int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "姑苏慕容")
    return notify_fail("你不是慕容弟子，无法学习。\n");
  if (!me->query("jm/taohua"))
    return notify_fail(CYN "听闻桃花岛主的弹指神通独步江湖，慕容氏的参合指比之如何？\n" CYN "这位" + RANK_D->query_respect(me) + CYN "要想学慕容家功夫，恐怕需要先研习桃花岛主的独门绝技！\n" NOR);
  if ((int)me->query("family_score") < 7)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if ((int)me->query_skill("shenyuan-gong", 1) < 100)
    return notify_fail("你的神元功火候不够，无法学习。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  return 1;
}


mapping query_action(object me, object weapon) {
  int zhaoshu, level;

  zhaoshu = sizeof(action);
  level = (int)me->query_skill("yanling-shenfa");

  if (level < 80) zhaoshu--;
  if (level < 60) zhaoshu--;
  if (level < 40) zhaoshu--;
  return action[random(zhaoshu)];
}
string query_dodge_msg(string limb) {
  object me, ob;
  mapping action;

  me = this_player();
  action = query_action(me, ob);

  return action["action"];
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("jing") < 40)
    return notify_fail("你的精力太差了，不能练燕灵身法。\n");
  if (me->query("family/family_name") != "姑苏慕容")
    return notify_fail("偷练慕容世家的武功你得罪不起。\n");
  if (!me->query("jm/taohua"))
    return notify_fail(CYN "听闻桃花岛主的弹指神通独步江湖，慕容氏的参合指比之如何？\n" CYN "这位" + RANK_D->query_respect(me) + CYN "要想学慕容家功夫，恐怕需要先研习桃花岛主的独门绝技！\n" NOR);
  if ((int)me->query("family_score") < 7)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("jing", 30);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "yanling-shenfa/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int ap, dp, j, damage2;

  ap = me->query_skill(
    "yanling-shenfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "sword",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage2 = me->query_skill(
    "yanling-shenfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "shenyuan-gong",
    1
  ) < 300 || me->query_skill("yanling-shenfa", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force")!="shenyuan-gong" ) return damage;
  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = HIG "$N化身雨燕，速度突然加快，如燕子之轻灵，万法不粘身！。\n" NOR;
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(msg, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage / 3 + random(damage / 3));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N顿悟" + me->query("cognize") + HIY "，身如燕子穿云，斜斜的插入$n出招间隙，攻其不备。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/murong")) {
    j = -(damage + random(damage));
    me->add("neili", -100);
    if (!ob->is_busy()) ob->start_busy(1);
    message_vision(HIB "$N融汇慕容世家武学精髓，忽然感到$N身轻如燕，使出的招式如击棉絮，无从受力！！\n" NOR, me, ob);
    return j;
  }
}
