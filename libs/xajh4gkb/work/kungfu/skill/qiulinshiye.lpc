int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "唐门")
    return notify_fail("你不是唐门弟子，无法学习本门技能。\n");
  if (!me->query("jm/huanhua"))
    return notify_fail(CYN "这神州结义萧秋水好大的胆子，竟敢强闯我唐门禁地！\n" CYN "这位" + RANK_D->query_respect(me) + CYN "欲入我唐门，需得去浣花派为唐门了结此段恩怨！\n" NOR);
  if ((int)me->query("family_score") < 6)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if ((int)me->query_skill("biyun-xinfa", 1) < 100)
    return notify_fail("你的碧云心法不够，无法学习本门技能。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太差了，不能练秋林拾叶。\n");
  if (me->query("family/family_name") != "唐门")
    return notify_fail("你不是唐门弟子，无法练习本门技能。\n");
  if (!me->query("jm/huanhua"))
    return notify_fail(CYN "这神州结义萧秋水好大的胆子，竟敢强闯我唐门禁地！\n" CYN "这位" + RANK_D->query_respect(me) + CYN "欲入我唐门，需得去浣花派为唐门了结此段恩怨！\n" NOR);
  if ((int)me->query("family_score") < 6)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "qiulinshiye/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int ap, dp, j, damage2;

  ap = me->query_skill(
    "qiulinshiye",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "sword",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage2 = me->query_skill(
    "qiulinshiye",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill(
    "biyun-xinfa",
    1
  ) < 300 || me->query_skill("qiulinshiye", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force")!="biyun-xinfa" ) return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = HIG "$N随意的扔出几片枫叶，轻而易举的就挡住了$n的攻击！\n" NOR;
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(msg, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage / 3 + random(damage / 3));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N顿悟" + me->query("cognize") + HIY "，提起碧云心法，顿时层林尽染，满地秋叶。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/tangmen")) {
    j = -(damage + random(damage));
    if (!ob->is_busy()) ob->start_busy(1);
    me->add("neili", -100);
    ob->apply_condition(du[random(sizeof(du))], 15);
    message_vision(HIB "$N融汇唐门武学精髓，挥袖间，一丝丝碧绿毒气慢慢升起，$n越斗越无力，四肢酸软！\n" NOR, me, ob);
    return j;
  }
}
