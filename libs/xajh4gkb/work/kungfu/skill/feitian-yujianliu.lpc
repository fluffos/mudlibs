int valid_learn(object me)
{
    object ob;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if( (int)me->query("max_neili") < 10000 )
        return notify_fail("你的内力不够，没有办法练飞天御剑流。\n");
	if ((int)me->query_skill("shayi-xinfa", 1) < 100)
		return notify_fail("你的杀意心法火候不够。\n");
	if (me->query("family/family_name")!="飞天御剑流")
		return notify_fail("你不加入飞天门，无法学习本门技能。\n");
	if (!me->query("jm/shushan"))
		return notify_fail(CYN"这蜀山之人常飞来飞去的，这岂不是蔑视我飞天门吗。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"要修炼我飞天门功夫，先得为我门探得蜀山派的飞剑秘密！\n"NOR);
	if ((int)me->query("family_score")<9)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if ((int)me->query_skill("feitian-yujianliu", 1) > (int)me->query_skill("huoxinliu-jianfa", 1))
		return notify_fail("你的神谷活心流火候不够，无法学。\n");
	if( (string)me->query_skill_mapped("force")!= "shayi-xinfa")
        return notify_fail("飞天御剑流必须配合杀意心法才能练。\n");
	if( !(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "blade" )
        return notify_fail("你必须先找一把刀才能练飞天御剑流。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	if (random(100)==1) me->add("score",-5);
    return 1;
}

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }
