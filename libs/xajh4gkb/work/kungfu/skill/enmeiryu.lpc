mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

string perform_action_file(string action) {
  return __DIR__ "enmeiryu/" + action;
}
int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练陆奥圆明流拳术必须空手。\n");
  if ((int)me->query_skill("aikido", 1) < (int)me->query_skill("enmeiryu", 1))
    return notify_fail("你的空手道火候不够，无法学。\n");
  if ((int)me->query_skill("xuanhualiu-quanfa", 1) < 100)
    return notify_fail("你的喧哗流拳法火候不够，无法学。\n");
  if ((int)me->query_skill("shayi-xinfa", 1) < 100)
    return notify_fail("你的杀意心法火候不够，无法学。\n");
  if (me->query("family/family_name") != "飞天御剑流")
    return notify_fail("你不是飞天门人，无法领悟本门技能的精髓。\n");
  if (!me->query("jm/shushan"))
    return notify_fail(CYN "这蜀山之人常飞来飞去的，这岂不是蔑视我飞天门吗。\n" CYN "这位" + RANK_D->query_respect(me) + CYN "要修炼我飞天门功夫，先得为我门探得蜀山派的飞剑秘密！\n" NOR);
  if ((int)me->query("family_score") < 9)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练陆奥圆明流拳术。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "飞天御剑流")
    return notify_fail("你不是飞天门人，无法领悟本门技能的精髓。\n");
  if (!me->query("jm/shushan"))
    return notify_fail(CYN "这蜀山之人常飞来飞去的，这岂不是蔑视我飞天门吗。\n" CYN "这位" + RANK_D->query_respect(me) + CYN "要修炼我飞天门功夫，先得为我门探得蜀山派的飞剑秘密！\n" NOR);
  if ((int)me->query("family_score") < 9)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if ((int)me->query("qi") < 70)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 70)
    return notify_fail("你的内力不够练陆奥圆明流拳术。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("qi", 60);
  me->add("neili", -60);
  return 1;

}
mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  string msg;
  int ap, dp, damage1, damage2, damage, liannum;
  ap = ((int)me->query_skill(
    "enmeiryu",
    1
  ) + (int)me->query_skill(
    "shayi",
    1
  )) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = (int)victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("enmeiryu", 1) + (int)me->query_skill("shayi", 1);
  damage2 = ((int)me->query_skill(
    "enmeiryu",
    1
  ) + (int)me->query_skill(
    "shayi",
    1
  )) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("shayi-xinfa", 1) < 100 || me->query_skill("enmeiryu", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "shayi-xinfa") return 0;	
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(ap) > dp / 3 && random(7) == 1 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    msg = HIR "「二重劲!」$N以极快速的连击,在第一击后,$n没产生抵抗力时给予第二击! \n" NOR;
    if (random(3) == 0) msg += HIR "「隔空击物!」。$N将二重劲的威力传至远方攻击的$n,用以弥补远距离攻击的不足 。\n" NOR;
    if (random(3) == 1) msg += HIR "「喷射火焰!」。$N胃装油袋,用火石制的假牙点火喷出火焰,$n被极大的火焰打中!! \n" NOR;
    if (random(3) == 2) msg += HIR "「仙鹤飞腿!」。$N使出丑鬼直接传授的拳法之一踢向$n! 这踢法已独创一格!!\n" NOR;
    me->add("neili", -100);
    if (!victim->is_busy()) victim->start_busy(1 + random(2));
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    return;
  }
  if (random(7) == 2 && random(ap) > dp / 3 && me->query("jiajing") > 0 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      RED "$N顿悟" + me->query("cognize") + RED "，发动忍术顿时隐身。突然虚空中一拳击出，只见$n$l上鲜血直流，已被无形拳劲切了开来!\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/feitian")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIC "$N融汇飞天门忍者流派的绝学精髓，不动则已，动则必中。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
