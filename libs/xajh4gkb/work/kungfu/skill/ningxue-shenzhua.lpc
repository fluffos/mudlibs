int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  return notify_fail("凝血神抓没法教授。\n");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("jing") < 100)
    return notify_fail("你的精力不够练此武功。\n");
  if ((int)me->query("qi") < 100)
    return notify_fail("你的体力不够练此武功。\n");
  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够练此武功。\n");
  me->receive_damage("qi", 10);
  me->receive_damage("jing", 10);
  me->add("neili", -10);

  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "ningxue-shenzhua/" + action;
}

string *parry_msg = ({
  "只听见" + (order[random(13)]) + "「锵」" NOR "一声，被$p格开了。\n",
  "结果" + (order[random(13)]) + "「当」" NOR "地一声被$p挡开了。\n",
  "但是被$n用手中$v架开。\n",
  "但是$n身子一侧，用手中$v格开。\n",
});

string *unarmed_parry_msg = ({
  "但是被$p格开了。\n",
  "结果被$p挡开了。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;
  string name;
  name = xue_name[random(sizeof(xue_name))];
  ap = me->query_skill(
    "ningxue-shenzhua",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("ningxue-shenzhua", 1);
  damage2 = (int)me->query_skill(
    "ningxue-shenzhua",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("ningxue-shenzhua", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "yijing-force") return 0;
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    victim->apply_condition("zhua_poison", 10);
    message_vision(
      HIR "$N左手聚成虎爪状! 「凝血神抓」一把抓住$n的" + (order[random(sizeof(order))]) + "" + name + "" HIR "，$n痛的倒地乱滚。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，双爪接连挥出，$n展开步法闪避，仍被抓中了" + (order[random(sizeof(order))]) + "" + name + "" HIG "，顿时闷哼 一声。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/yunlong")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    victim->apply_condition("zhua_poison", 10);
    message_vision(
      HIM "$N洞悉云龙门武功精髓，将内力凝聚爪上，一股血气溢出，$n伤口血流不止，奇痒无比。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  int ap, dp, j, damage1, damage2;
  string name;
  name = xue_name[random(sizeof(xue_name))];
  ap = me->query_skill(
    "ningxue-shenzhua",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "sword",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = me->query_skill("ningxue-shenzhua", 1);
  damage2 = me->query_skill(
    "ningxue-shenzhua",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (objectp(me->query_temp("weapon"))) return damage;
  //	if ( me->query_skill_mapped("force") != "yijing-force") return damage;
  if (me->query_skill("ningxue-shenzhua", 1) < 300) return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    if (!ob->is_busy()) ob->start_busy(1);
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(
      HIR "$N" + HIR + "$N左手聚成虎爪状! 一把抓住$n的" + (order[random(sizeof(order))]) + "" + name + "，真气运行迟滞。\n" NOR,
      me,
      ob
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIY "$N顿悟" + me->query("cognize") + HIY "，趁$n招式落空之时，突然五指张开，抓中$n" + (order[random(sizeof(order))]) + "" + name + "，经脉顿时痉挛。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/yunlong")) {
    j = -(damage / 3 + random(damage / 3));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    message_vision(
      HIB "$N融汇云龙门武功精髓，突然探出一爪，$n" + (order[random(sizeof(order))]) + "" + name + "被击中，攻击力顿时弱了不少！\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
}
