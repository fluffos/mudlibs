// hui.c 挥斥方遒

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


inherit F_SSERVER;

int perform(object me, object target) {
  string msg;
  object weapon, weapon2;
  int skill, ap, dp, damage, busy_time;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「弹指神通」只能在战斗中使用。\n");
  if (objectp(weapon = me->query_temp("weapon")) && objectp(weapon = me->query_temp("secondary_weapon")))
    return notify_fail("你必须空出一个手才能使用「弹指神通」。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->query_skill("tanzhi-shentong", 1) < 500)
    return notify_fail("你的弹指神通等级不够, 不能使用「弹指神通」！\n");
  if (me->query_skill("bibo-shengong", 1) < 500)
    return notify_fail("你的碧波神功等级不够, 不能使用「弹指神通」！\n");
  if (me->query("neili") < 1000)
    return notify_fail("你的内力不够，无法运用「弹指神通」！\n");
  if (me->query("jingli") < 1000)
    return notify_fail("你的精力不够，无法运用「弹指神通」！\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query("max_jingli") < 100000)
    return notify_fail("你的精力修为不够。\n");
  //	if( me->query_skill_mapped("force") != "bibo-shengong")
  //		return notify_fail("不使用碧波神功，如何能使用「弹指神通」！\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢，哪有空运功？\n");
  if (target && target->is_busy())
    return notify_fail("目前对方正自顾不暇，放胆攻击吧吧\n");
  if (target && target->query_temp("busy_mianyi"))  //冲穴成功后免疫busy，2017.9.29阿飞添加
    return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
  //	if (me->query_skill_mapped("unarmed") != "tanzhi-shentong")
  //		return notify_fail("你没有激发弹指神通。\n");	
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  msg = HIC "$N使出弹指神通之「挥斥方遒」, 顿时眼内精光暴射，\n";
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "tanzhi-shentong",
    1
  ) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  skill = me->query_skill("tanzhi-shentong", 1);
  busy_time = (30 * skill) / (skill + 2000);
  if (stringp(target->query("inborn")) && (string)target->query("inborn") == YEL "冷静" NOR) busy_time = (30 * skill) / (skill + 2000) * 7 / 10;
  if (random(ap) > dp / 3) {
    me->add("neili", -100);
    me->add("jingli", -300);
    damage = skill + random(skill);
    damage = damage * (100 - target->query_meridian()) / 100;
    target->add("neili", -damage * 2);
    target->receive_damage("jing", damage, me);
    target->receive_wound("jing", damage / 2, me);
    msg = "$n只觉得眼前一花，气海穴上微微一痛，全身真气狂泄而出！\n" NOR;
    message_vision(msg, me, target, damage, HBWHT + HIM "精神伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法		
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);		
    target->start_busy(5 + busy_time);
    tell_object(target, HIY "你陷入忙乱之中，一时无法动弹。\n" NOR);
  } else {
    msg = "可是$n的看破了$N的企图，立刻采取守势，使$P的「挥斥方遒」没有起到作用。\n" NOR;
    message_vision(msg, me, target);
  }

  msg = HIC "$N使出弹指神通之「弹指惊雷」, 顿时眼内精光暴射，\n";
  message_vision(msg, me, target);
  if (random(ap) > dp / 3) {
    msg = "$n只觉得眼前一花，气海穴上微微一痛，全身真气狂泄而出！\n";
    if (objectp(weapon2 = target->query_temp("weapon"))) {
      msg += "同时手腕一麻，手中";
      msg += weapon2->name();
      msg += "脱手而出！\n" NOR;
      weapon2->unequip();
      weapon2->move(environment(me));
    }
    me->add("neili", -100);
    me->add("jingli", -300);
    damage = skill + random(skill);
    damage = damage * (100 - target->query_meridian()) / 100;
    target->add("neili", -damage * 2);
    target->receive_damage("jing", damage, me);
    target->receive_wound("jing", damage / 2, me);
    message_vision(msg, me, target, damage, HBWHT + HIM "精神伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"，杀内力"+ damage*2 +"。\n" NOR);
    //		COMBAT_D->report_status(target);	//这代码什么作用？
  } else {
    msg = "可是$n的看破了$N的企图，立刻采取守势，使$P的「弹指惊雷」没有起到作用。\n" NOR;
    message_vision(msg, me, target);
  }

  if (!target->is_fighting(me)) target->fight_ob(me);
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
