int valid_enable(string usage) {
  return usage == "parry" || usage == "unarmed" || usage == "strike";
}
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "xuanfeng-tui"; }		//互备技能
string skill_pinji() { return "中乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "中立"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "杀手楼"; }    //门派区分：门派，江湖
string skill_yinyang() { return "阳"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "邪派"; }   //阵营区分：正派、邪派、中立、通用
int damage_damage() { return 51; }  //外伤系数
int force_damage() { return 65; }  //内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练排云掌必须空手。\n");
  if (me->query("family/family_name") != "杀手楼")
    return notify_fail("你不加入杀手楼，无法学习排云掌。\n");
  if ((int)me->query_skill("wuji-shengong", 1) < 300)
    return notify_fail("你的无极神功火候不够，无法学排云掌。\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力太弱，无法练排云掌。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 40)
    return notify_fail("你的内力不够练排云掌。\n");
  if (me->query("family/family_name") != "杀手楼")
    return notify_fail("你不是杀手楼中人，偷练杀手楼绝技是活腻了吧。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "fanyun-zhang/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage1, damage2, damage, liannum;
  damage1 = (int)me->query_skill("fanyun-zhang", 1);
  damage2 = (int)me->query_skill(
    "fanyun-zhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  ap = me->query_skill(
    "fanyun-zhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "wuji-shengong",
    1
  ) < 100 || me->query_skill("fanyun-zhang", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "wuji-shengong") return 0;	
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(ap) > dp / 3 && random(7) == 1 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIR "只听一声“咔嚓”的一声，$n被$N的排云掌打断了几根肋骨！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIG "$N突然领悟" + me->query("cognize") + HIG "，其掌力如排山倒海，$n倒飞而去。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/shashou")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIC "$N贯通杀手楼武功精髓，以三分归元气使出排云掌，如风卷残云吹过$n。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
