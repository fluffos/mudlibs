// powerup.c
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_CLEAN_UP;
void remove_effect(object me, int amount);
int exert(object me, object target) {
  int skill;

  if (target != me)
    return notify_fail("你只能提升自己的战斗力。\n");
  if (me->query_skill_mapped("force") != "hamagong")
    return notify_fail("你未使用特殊内功。\n");
  if ((int)me->query_skill("hamagong", 1) < 300)
    return notify_fail("你的蛤蟆功修为还不够。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query_temp("powerup"))
    return notify_fail("你已经在运功中了。\n");
  if (me->query_condition("no_force"))
    return notify_fail("你的丹田真气狂泻不止，浑身无力。\n");
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成，等会在用内功！\n");
  //	if (me->query_temp("autolian"))
  //		return notify_fail("你正在发动自动连招！\n"); 	
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
  skill = (int)me->query_skill("hamagong", 1) / 15 + (int)me->query_skill("force", 1) / 40;
  me->add("neili", -100);
  me->add("jingli", -100);

  message_vision(HIR "$N长啸一声，真气激发，蛤蟆功流转全身，只见一股轻烟笼罩周身。\n" NOR, me);
  me->add_temp("apply/constitution", skill * 10 / 10);
  me->add_temp("apply/damage", skill * 15 / 10);
  me->add_temp("apply/strength", skill * 20 / 10);
  me->add_temp("apply/dodge", -skill * 4);
  me->add_temp("apply/parry", skill * 8);
  me->add_temp("apply/armor", skill * 2);
  tell_object(me, HIG "你的战斗属性临时提高了！\n" NOR);
  me->set_temp("powerup", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill :), skill);

  me->start_busy(1);
  return 1;
}

void remove_effect(object me, int amount) {
  if (!me) return;
  if ((int)me->query_temp("powerup")) {
    me->add_temp("apply/constitution", -amount * 10 / 10);
    me->add_temp("apply/damage", -amount * 15 / 10);
    me->add_temp("apply/strength", -amount * 20 / 10);
    me->add_temp("apply/dodge", amount * 4);
    me->add_temp("apply/parry", -amount * 8);
    me->add_temp("apply/armor", -amount * 2);
    me->delete_temp("powerup");
    tell_object(me, HIG "你将全身内力缓缓收回丹田，真气恢复平静。\n" NOR);
  }
}
