int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("force", 1) < 300)
    return notify_fail("你的内功火候太浅。\n");
  if ((int)me->query_skill("spear", 1) <= 500)
    return notify_fail("你的基本枪法火候不足，难以领悟燎原枪法。\n");
  if ((int)me->query_skill("liaoyuan-spear", 1) > 3000)
    return notify_fail("这项技能只能教到这里了，以后要靠你自己领悟。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(10) == 1) me->add("score", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "liaoyuan-spear/" + action;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}


mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  string msg;
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon1, weapon2;
  weapon1 = me->query_temp("weapon");
  ap = me->query_skill(
    "liaoyuan-spear",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("liaoyuan-spear", 1);
  damage2 = (int)me->query_skill(
    "liaoyuan-spear",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("liaoyuan-spear", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "yijing-force") return 0;
  if (!objectp(weapon1 = me->query_temp("weapon")) || (string)weapon1->query("skill_type") != "spear") return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    if (!victim->is_busy()) victim->start_busy(1);
    victim->apply_condition("fire_poison", 10 + victim->query_condition("fire_poison"));
    message_vision(
      HIR "$n越斗越害怕，被$N带得招式渐见涩滞！！$n突然哇的一声，吐出一口火热鲜血。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    if (objectp(weapon2 = victim->query_temp("weapon"))) {
      msg = HIM "$N顿悟" + me->query("cognize") + HIG "，持枪斜引，" + weapon1->name() + HIM "平搭在$n的" + weapon2->name() + HIM "背脊上，劲力传出，" + weapon2->name() + HIM "登时一沉！" NOR;
      if (random(3) == 0) {
        msg += HIR "$n招式渐见涩滞，只觉得手中" + weapon2->name() + HIR "不断的在增加重量，一个把持不定，脱手飞出！\n" NOR;
        weapon2->unequip();
        weapon2->move(environment(victim));
        message_vision(msg, me, victim);
      } else {
        msg += HIY "$n一招使出，真力运得不足，被" + weapon1->name() + HIY "带着连转几个圈子，手中" + weapon2->name() + HIY "一震，险些脱手！\n";
        victim->receive_damage("jing", damage, me);
        victim->receive_wound("jing", damage / 3, me);
        if (!victim->is_busy()) victim->start_busy(1);
        message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤精" NOR);
      }
    } else {
      msg = HIY "$N顿悟" + me->query("cognize") + HIG "，收枪于背后，气势一往无前，提枪直刺，$n心生惧意，略一迟疑便被" + weapon1->name() + HIY "带入挨打之局！\n";
      victim->receive_damage("jing", damage, me);
      victim->receive_wound("jing", damage / 3, me);
      if (!victim->is_busy()) victim->start_busy(1);
      message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤精" NOR);
    }
    me->add("jingli", -100);
    return;
  }
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int ap, dp, j, damage1, damage2;
  object weapon;
  weapon = me->query_temp("weapon");
  ap = me->query_skill(
    "liaoyuan-spear",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "sword",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = me->query_skill("liaoyuan-spear", 1);
  damage2 = me->query_skill(
    "liaoyuan-spear",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "spear") return damage;
  if (me->query_skill("liaoyuan-spear", 1) < 300) return damage;
  //	if ( me->query_skill_mapped("force") != "yijing-force") return 0;

  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = YEL "$N容颜冷如冰雪！将丈二红枪插在身旁，负手而立！精电般的眼神望着$n，闪电般的一枪与$n硬碰硬，将$n的招式反击回去。\n" NOR;
    if (!ob->is_busy()) ob->start_busy(1);
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(msg, me, ob, damage1, HBWHT + HIY "气血反伤" NOR);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 1);
    me->add("jingli", -100);
    message_vision(
      HIY "$N顿悟" + me->query("cognize") + HIY "，丈二红枪暴涨，幻出千百道的红色枪影，有若燎原之火，往$n烧去。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }

}


int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query_skill("spear", 1) <= 150)
    return notify_fail("你的基本枪法火候不足，难以领悟燎原枪法。\n");
  if ((int)me->query_skill("liaoyuan-spear", 1) <= 200)
    return notify_fail("你起码要先学会燎原枪法的基本枪式吧。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "spear")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jing") < 70)
    return notify_fail("你的体力不够练燎原枪法。\n");
  if ((int)me->query("neili") < 40)
    return notify_fail("你的内力不够练燎原枪法。\n");

  me->receive_damage("jing", 30);
  me->add("neili", -10);

  return 1;
}

int help(object me) {
  write(HIC "\n燎原枪法：" NOR "\n");
  write(@HELP
	燎原枪法为邪灵厉若海所创。一往无前、全力以赴，能给予使用者澎湃无比的信心。
	天下最威猛、惊天骇地的盖世枪法，共分为「五十势」、「三十击」和「二十针」，
	所以又称「燎原百击」。已臻超凡脱俗的至境，使出时丈二红枪暴涨，幻出千百道的
	红色枪影，有若燎原之火，往对手烧去。其中所谓「二十针」，就是一套专针对人身
	穴道而创的枪法，诡异莫测，细腻处若绣花之针，远非一般江湖“打穴”的功夫可比；
	「三十击」则是一整套招式，不出手则已，一出手便是连环而去，绵绵不绝，最适合
	以寡敌众；「五十势」是五十个单独的枪势，适用于不同的情况，特别是其中的「无
	枪势」——收枪于背后，将所有气机收藏，再突然刺出，攻敌之不防。
	
HELP
  );
  return 1;
}
