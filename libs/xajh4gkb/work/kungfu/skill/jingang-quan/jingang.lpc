// jingsng.c 金刚拳 大金刚神通

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;

int perform(object me, object target) {
  string msg;
  int ap, dp, damage, skill;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「大金刚神通」只能在战斗中使用。\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("你先放下手中的武器再说吧？！\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够！\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为太差！\n");
  if ((int)me->query("max_jingli") < 100000)
    return notify_fail("你的精力修为太差！\n");
  if ((int)me->query_skill("hunyuan-yiqi", 1) < 300 && (int)me->query_skill("yijinjing", 1) < 300)
    return notify_fail("你的佛门内功的修为不够, 不能使用这一绝技 !\n");
  if ((int)me->query_skill("jingang-quan", 1) < 300)
    return notify_fail("你的拳法还不到家，无法使用大金刚神通！\n");
  //   if( me->query_skill_mapped("unarmed") != "jingang-quan") 
  //       return notify_fail("你没有激发金刚拳，无法使用大金刚神通！\n");
  // 	if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi" ) 
  //		return notify_fail("你未使用佛门内功, 不能使用这一绝技 !\n");  
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  msg = HIY "$N使出大金刚拳的绝技「大金刚神通」，全身肌肉爆起，衣服炸开，力量灌注全身！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1	
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "jingang-quan",
    1
  ) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  skill = (int)me->query_skill("jingang-quan", 1) / 10;
  if (random(ap) > dp / 3) {
    msg = HIR "$N拼尽毕生功力使出了大金刚拳的终极绝技, 全身骨骼一阵爆响, 欲与敌人同归于尽!\n" NOR;
    message_vision(msg, me, target);
    if (me->query("eff_qi") < me->query("max_qi")) {
      damage = (int)me->query_skill(
        "jingang-quan",
        1
      ) + (me->query("max_qi") - me->query("eff_qi")) / 2;
      damage = damage / 2 + random(damage / 2);
      damage = damage * (100 - target->query_meridian()) / 100;
      if (damage < 100) damage = 100;
      if (damage > 500000) damage = 500000;
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      msg = HIR "$n见来势凶猛，只好与$N硬拼一掌。\n" NOR;
      message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
      //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
    } else {
      me->add_temp("apply/strength", skill * 5);
      me->add_temp("apply/dexerity", -skill * 5);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      me->add_temp("apply/strength", -skill * 5);
      me->add_temp("apply/dexerity", skill * 5);
    }
    me->add("neili", -300);
    me->add("jingli", -300);
  } else {
    damage = (int)me->query_skill(
      "jingang-quan",
      1
    ) + (int)me->query_skill("unarmed", 1) + (int)me->query_skill("force");
    damage = damage / 2 + random(damage / 2);
    damage = damage * (100 - me->query_meridian()) / 100;
    me->receive_damage("qi", damage, target);
    me->receive_wound("qi", damage / 2, target);
    me->add("neili", -300);
    me->add("jingli", -300);
    msg = HIR "$n用尽了最后一点气力, 喷出一口鲜血, 一头栽倒在地!\n" NOR;
    message_vision(msg, target, me, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
