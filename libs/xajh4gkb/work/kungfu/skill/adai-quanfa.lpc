int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
/*	if ( !objectp(weapon = me->query_temp("weapon")) || ( string)weapon->query("skill_type") != "whip" )
	if ( !objectp(weapon = me->query_temp("secondary_weapon")) || ( string)weapon->query("skill_type") != "whip" )
		return notify_fail("你必须先找一条鞭子才能练鞭法。\n");	*/
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练阿呆拳法必须空手。\n");
	if(!me->query("couple/have_couple")) 
		return notify_fail("你还没有所爱的人，不能领会其中的精要！\n");
    if (me->query_skill("adai-quanfa", 1) >= 300)
        return notify_fail("高深的阿呆拳法需自己勤加修习领悟。\n");
    if ((int)me->query("max_neili") < 30000)	
		return notify_fail("你的内力太弱，无法练阿呆拳法。\n");
	if ((int)me->query_str()< 40)
		return notify_fail("你的臂力太弱，无法练阿呆拳法。\n");	
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(100)==1) me->add("score",-5);
	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("qi") < 30)
		return notify_fail("你的体力太低了。\n");
	if (me->query_skill("unarmed", 1) <= me->query_skill("adai-quanfa",1))
		return notify_fail("你的基础不够，无法练习阿呆拳法。\n");
	if ((int)me->query("neili") < 200)
		return notify_fail("你的内力不够练阿呆拳法。\n");
	me->receive_damage("qi", 25);
	me->add("neili", -30);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	string msg;
	int ap,dp,damage1,damage2,damage,liannum;
	ap = (me->query_str(1) + me->query_con(1))*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = (victim->query_str(1) + victim->query_con(1))*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	damage1 = (int)me->query_skill("adai-quanfa",1);
	damage2 = (int)me->query_skill("adai-quanfa",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if ( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
	if (  me->query_skill("adai-quanfa",1) < 100) return 0;
	if (objectp(me->query_temp("weapon"))) return 0;
//	if ( me->query_skill_mapped("force") != "shenghuo-shengong") return 0;

	if( random(ap) > dp/3 && me->query("jiali")>0 && random(7)==1) 
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
//		damage = (damage1+damage_bonus)*(liannum*20+1)/((20+liannum)*liannum);
		msg = HIR "只听到“哦..哦”的两声，"+ victim->name()+HIR"身体软软的倒了下去！\n" NOR;
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIW"测试专用：特效气血伤害中damage1="+damage1+"，damage_bonus="+damage_bonus+"。\n"NOR, me,victim);
//		message_vision(msg, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
//		return HIR "只听到“哦..哦”的两声，"+ victim->name()+HIR"身体软软的倒了下去！\n" NOR;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
//		damage = (damage2+damage_bonus)*(liannum*20+1)/((20+liannum)*liannum);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N呆头呆脑的击处一拳，竟然发挥出"+me->query("cognize")+HIG"的力量，将$n打的口土鲜血。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/42book") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
//		damage = ((damage1+damage2)/2+damage_bonus)*(liannum*20+1)/((20+liannum)*liannum);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIC "$N洞悟阿呆拳法的精妙所在，一拳击出，将$n打的呆头呆脑。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int j,damage1,damage2, ap,dp;

	damage1 = (int)me->query_skill("adai-quanfa",1);
	damage2 = (int)me->query_skill("adai-quanfa",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	ap = me->query_skill("adai-quanfa",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("parry",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	if (damage <10)  damage=10;
	if (objectp(me->query_temp("weapon"))) return damage;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("adai-quanfa",1) < 300 ) return damage;
//	if ( me->query_skill_mapped("force") != "shenghuo-shengong") return 0;

	if (random(8)==1 && random(ap)>dp/4 )
	{
		msg = HIY"$N目光呆滞，出招全凭本能，哪知恰好$n跌入怀中，一时抱个正着！\n" NOR;
		j = -(damage+random(damage));  			
		ob->apply_condition("xiangsi",20);
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );		
		message_vision(msg, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
	if (random(8)==2 && random(ap)>dp/4 && (int)me->query("breakup") )
	{
		msg = HIC"$N眼中泛起淫光，出拳之际"+me->query("cognize")+HIC"的力量爆发，随手就将$n圈入怀中！\n" NOR;
		j = -(damage+random(damage));
		me->add("jingli", -100 );		
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		message_vision(msg, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if (random(8)==3 && random(ap)>dp/4 && (int)me->query("jm/adai") )
	{
		msg = HIG"$N洞悉淫王之王至高无上的精神，身形如饿狼扑食，将$n扑倒在身下！\n" NOR;
		j = -(damage+random(damage));
		me->add("neili", -100 );		
		if (!ob->is_busy()) ob->start_busy(1);
		message_vision(msg, me, ob);
		return j;
	}
}
string perform_action_file(string action)
{
	return __DIR__"adai-quanfa/" + action;
}
