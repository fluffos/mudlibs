int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练昊天掌必须空手。\n");
  if (me->query("family/family_name") != "全真教")
    return notify_fail("你未加入全真教，无法学习本门技能。\n");
  if ((int)me->query_skill(
    "xiantian-qigong",
    1
  ) < 100 && (int)me->query_skill("tiangang-zhengqi", 1) < 100)
    return notify_fail("你的内功火候不够，无法学昊天掌。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练昊天掌。\n");
  if (me->query("family/family_name") != "全真教")
    return notify_fail("你未加入全真教，无法练习昊天掌。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "haotian-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage1, damage2, damage, liannum;
  int flag = 1;
  ap = (int)me->query(
    "dex",
    1
  ) * (int)me->query_skill(
    "haotian-zhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = (int)victim->query(
    "str",
    1
  ) * (int)me->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("haotian-zhang", 1);
  damage2 = (int)me->query_skill(
    "haotian-zhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (damage_bonus < 100) return 0;
  if ((me->query_skill(
    "tiangang-zhengqi",
    1
  ) < 100 && me->query_skill(
    "xiantian-qigong",
    1
  ) < 100) || me->query_skill("haotian-zhang", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "tiangang-zhengqi" && me->query_skill_mapped("force") != "xiantian-qigong" ) return 0;
  if (objectp(me->query_temp("weapon"))) return 0;
  if (me->query_skill_mapped("force") == "tiangang-zhengqi") flag = 1;
  if (me->query_skill_mapped("force") == "xiantian-qigong") flag = 2;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIY "$N 双掌蕴含先天内劲，$n与你对了一掌，只感觉五内俱焚，不禁吐出一口鲜血！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIG "$N先天罡气爆发，携着" + me->query("cognize") + HIG "的力量，将$n震的吐血。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/quanzhen")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIC "$N贯通全真教精深内功，一缕先天真气刺入$n丹田。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
