//yihun.c

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int exert(object me, object target) {
  int damage, damage1, skill, times, i;
  int ap, dp;
  string msg;

  if (target == me || !target) {
    me->clean_up_enemy();
    target = me->select_opponent();
  }
  if (!me->is_fighting(target))
    return notify_fail("「移魂大法」只能对战斗中的对手使用。\n");
  if (environment(me)->query("citybiwu"))
    return notify_fail("这里不准打架。\n");
  if (environment(me)->query("no_fight"))
    return notify_fail("这里不准打架。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query_skill("jiuyin-zhenjing", 1) < 1000)
    return notify_fail("你的九阴真经修为太低了，无法使用移魂大法。\n");
  if (me->query_skill_mapped("force") != "jiuyin-zhenjing")
    return notify_fail("你未使用九阴真经，无法使用移魂大法。\n");
  if (!me->query("jm/jiuyin"))
    return notify_fail("你还没有领悟九阴真经的精髓，无法使用移魂大法。\n");
  if ((int)me->query_skill("taoism", 1) < 1000)
    return notify_fail("以你目前的道学修为来看，还不足以运用移魂大法！\n");
  if (target && !living(target))
    return notify_fail("对方都晕了，还怎么移魂啊。\n");
  if (me->query("max_neili") < 200000)
    return notify_fail("你的内力修为不够运用移魂大法所需！\n");
  if (me->query("max_jingli") < 200000)
    return notify_fail("你的精力修为不够运用移魂大法所需！\n");
  if (me->query("neili") < 10000)
    return notify_fail("你的内力不够运用移魂大法所需！\n");
  if (me->query("jingli") < 10000)
    return notify_fail("你的精力不够运用移魂大法所需！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  ap = me->query("xyzx_sys/level") + me->query_skill("jiuyin-zhenjing", 1);
  dp = target->query("xyzx_sys/level");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  skill = (int)me->query_skill("jiuyin-zhenjing", 1) / 10;
  times = (int)me->query_skill("jiuyin-zhenjing", 1) / 600;
  if (times < 1) times = 1;
  if (times > 9) times = 9;
  msg = HIW "$N眼神莹然有光，脸上突然开始做出各样奇怪的表情。\n";
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1	
  if (random(ap) > dp / 3) {
    damage = (int)me->query_skill("jiuyin-zhenjing", 1) * 5;
    damage1 = (me->query("max_qi") - me->query("eff_qi")) / 5 + (target->query("max_jing") - target->query("eff_jing")) / 5;
    if (damage1 < 100) damage1 = 100;
    if (damage1 > 200000) damage1 = 200000;
    damage = damage / 2 + random(damage1 / 2);
    damage = damage * (100 - target->query_meridian()) / 100;
    if (damage < 100) damage = 100;
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 2, me);
    me->add("neili", -500);
    me->add("jingli", -500);
    msg = "$n看了看$N，却不知不觉的学起$N的表情。\n" NOR;
    msg += CYN "\n$N猛然做出向自己攻击的动作，$n立刻向自己发疯似的攻击起来，出手越来越重！\n\n" NOR;
    message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    target->add_temp("apply/strength", skill);
    target->add_temp("apply/parry", -skill * 5);
    target->add_temp("apply/dodge", -skill * 5);
    target->add_temp("apply/dexerity", -skill * 5);
    target->add_temp("apply/armor", -skill * 5);
    for (i = 0; i < times; i++) {
      COMBAT_D->do_attack(target, target, target->query_temp("weapon"));
      me->add("neili", -200);
      me->add("jingli", -200);
    }
    target->add_temp("apply/strength", -skill);
    target->add_temp("apply/parry", skill * 5);
    target->add_temp("apply/dodge", skill * 5);
    target->add_temp("apply/dexerity", skill * 5);
    target->add_temp("apply/armor", skill * 5);
  } else {
    msg = HIY "不管$N怎么变化表情，$n总是冷冷的无动于衷。\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -500);
  }

  if (!me->is_fighting(target)) me->fight_ob(target);
  if (!target->is_fighting(me)) target->fight_ob(me);

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
