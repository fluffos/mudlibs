// fuxue.c 拈花指 「拈花拂穴」
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int skill, ap, dp, busy_time;

  if (!target) target = offensive_target(me);
  if (!target) return notify_fail("你想点谁的穴位？\n");
  if (!target->is_character() || target->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");
  if ((int)me->query_skill("hunyuan-yiqi", 1) < 300 && (int)me->query_skill("yijinjing", 1) < 300)
    return notify_fail("你佛门内功修为不够，不能使用拈花拂穴!\n");
  // 	if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi" ) 
  //		return notify_fail("你未使用佛门内功, 不能使用这一绝技 !\n"); 	
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query_skill("nianhua-zhi", 1) < 300)
    return notify_fail("你的基本功修为不够,目前还不能使用拈花拂穴绝技!\n");
  //	if (me->query_skill_mapped("unarmed") != "nianhua-zhi")
  //		return notify_fail("你没正确激发该技能 。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够了。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的内力不够, 不能使用拈花拂穴! \n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (target && target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");
  if (target && target->query_temp("busy_mianyi"))  //冲穴成功后免疫busy，2017.9.29阿飞添加
    return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  message("vision", CYN "你似乎听到一声似有似无的“嗤嗤”的声音！\n\n" NOR, environment(me), ({ me }));
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  tell_object(me, "你使出拈花拂穴绝招，暗运内力，指端射出一股劲气直点" + target->name() + "的要穴！\n\n" NOR);
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "nianhua-zhi",
    1
  ) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  skill = (int)me->query_skill("nianhua-zhi", 1);
  busy_time = (30 * skill) / (skill + 2000);
  if (stringp(target->query("inborn")) && (string)target->query("inborn") == YEL "冷静" NOR) busy_time = (30 * skill) / (skill + 2000) * 7 / 10;
  if (random(ap) > dp / 3) {
    tell_object(target, HIW "你突然间觉得浑身上下不听使唤，动弹不得！\n" NOR);
    message(
      "vision",
      CYN "只见" + target->name() + "突然间神色大变，动弹不得！\n\n" NOR,
      environment(me),
      ({ target })
    );
    target->start_busy(5 + busy_time);
    tell_object(target, HIY "你陷入忙乱之中，一时无法动弹。\n" NOR);
    me->add("neili", -300);
    me->add("jingli", -300);
  } else {
    message(
      "vision",
      CYN + target->name() + "好象突然觉得有一股劲气向自己的要穴射了过来，不及细想闪了一闪。\n" NOR,
      environment(me),
      ({ target })
    );
    tell_object(target, CYN "你好象突然觉得有一股劲气向自己的要穴射了过来，不及细想闪了一闪。\n" NOR);
  }
  message_vision(CYN "$n从劲气来向看到原来是$N在点自己的穴位，不禁大怒：敢暗算我，看招！\n" NOR, me, target);
  me->fight_ob(target);
  if (target->query("shen") < -10000) target->kill_ob(me);
  else target->fight_ob(me);
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
