// made by lks

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int exert(object me, object target) {
  int damage, skill, ap, dp, busy_time;
  string msg;

  if (target == me || !target) {
    me->clean_up_enemy();
    target = me->select_opponent();
  }
  if (!me->is_fighting(target))
    return notify_fail("「冰封诀」只能对战斗中的对手使用。\n");
  if ((int)me->query_skill("force", 1) < 1000)
    return notify_fail("你的内功底子太薄，不能使用。\n");
  if (!wizardp(me) && me->query_skill_mapped("force") != "hanbing-zhenqi")
    return notify_fail(HIC "不使用本门内功，如何使用本门绝学!\n" NOR);
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
  if ((int)me->query_skill("hanbing-zhenqi", 1) < 300)
    return notify_fail("你的寒冰真气不够熟练。\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为还不够高。\n");
  if ((int)me->query("max_jingli") < 100000)
    return notify_fail("你的精力修为还不够高。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够了。\n");
  if ((int)me->query("neili", 1) < 1000)
    return notify_fail("你现在内力太弱，不能使用「冰封诀」。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着！\n");
  if (target && target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧!\n");
  if (target && target->query_temp("busy_mianyi"))  //冲穴成功后免疫busy，2017.9.29阿飞添加
    return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  msg = HIC "$N气运丹田，寒气经膻中穴行走至劳宫穴，双掌猛的向$n拍去。\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1		
  skill = (int)me->query_skill("hanbing-zhenqi", 1);
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "hanbing-zhenqi",
    1
  ) + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("force");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  busy_time = (30 * skill) / (skill + 2000);
  if (stringp(target->query("inborn")) && (string)target->query("inborn") == YEL "冷静" NOR) busy_time = (30 * skill) / (skill + 2000) * 7 / 10;
  if (random(ap) > dp / 3) {
    target->start_busy(busy_time + 5);
    damage = (int)me->query_skill("force", 1) + (int)me->query_skill("hanbing-zhenqi", 1);
    damage = damage / 2 + random(damage / 2);
    damage = damage * (100 - target->query_meridian()) / 100;
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 3, me);
    me->add("neili", -500);
    target->set_temp("snow/freeze", 1);
    call_out("snow_end", 5 + busy_time, me, target);
    msg = WHT "$n与$N二人四掌相交，顿时只觉人如一股寒气自劳宫穴袭来，不一会肌肤冰冷，脏腑血液已若坚冰！\n" NOR;
    message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
    tell_object(target, HIY "你陷入忙乱之中，一时无法动弹。\n" NOR);
    //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/3 +"。\n" NOR);
  } else {
    msg = YEL "可是$p识得寒冰真气厉害，后退一步避开了这一掌。\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -100);
  }
  message_vision(msg, me, target);
  me->start_busy(1);
  return 1;
}
void snow_end(object me, object target) {
  if (!objectp(target)) return;
  target->delete_temp("snow/freeze");
  tell_object(target, HIR "你打了个冷颤，浑身血液渐渐恢复热血。\n" NOR);
  return;
}
void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
