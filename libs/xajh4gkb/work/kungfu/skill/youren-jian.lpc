int valid_learn(object me) {
  object ob;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_skill("throwing", 1) < 300)
    return notify_fail("你的基本暗器还不够纯熟。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够，挥不动暗器！\n");
  if ((int)me->query("int", 1) < 30)
    return notify_fail("你悟性太差，无法领悟游刃箭的终极绝技伤心小箭！\n");
  if (me->query("family/family_name") != "血河派")
    return notify_fail("你不加入血河派，恐怕学不了血河派技能。\n");
  if (!me->query("jm/xuantian"))
    return notify_fail(CYN "我血河派第十一代掌门欧阳驼于六十年前失踪，江湖上流传的摧心掌似乎与我派有关。\n" CYN "这位" + RANK_D->query_respect(me) + CYN "可否先为我派去玄天派探听其秘密，将来必有回报。\n" NOR);
  if ((int)me->query("family_score") < 8)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if ((int)me->query_skill(
    "huaxue-dafa",
    1
  ) < 100 && (int)me->query_skill(
    "yiriguan-riyue",
    1
  ) < 100 && (int)me->query_skill("longmen-shengong", 1) < 100)
    return notify_fail("你的本门内功火候不够，无法学习本门绝技。\n");
  if (!objectp(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "throwing")
    return notify_fail("手中无箭怎能领悟所学？\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

int valid_enable(string usage) {
  return (usage == "throwing" || usage == "parry");
}
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "juehu-shou"; }		//互备技能
string skill_pinji() { return "下乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "中立"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "血河派"; }    //门派区分：门派，江湖
string skill_yinyang() { return "中性"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "邪派"; }   //阵营区分：正派、邪派、中立、通用
int damage_damage() { return 40; }  //外伤系数
int force_damage() { return 73; }  //内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing")
    return notify_fail("没有箭如何练？\n");
  if (me->query("family/family_name") != "血河派")
    return notify_fail("你不加入血河派，恐怕练习不了血河派技能。\n");
  if (!me->query("jm/xuantian"))
    return notify_fail(CYN "我血河派第十一代掌门欧阳驼于六十年前失踪，江湖上流传的摧心掌似乎与我派有关。\n" CYN "这位" + RANK_D->query_respect(me) + CYN "可否先为我派去玄天派探听其秘密，将来必有回报。\n" NOR);
  if ((int)me->query("family_score") < 8)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if ((int)me->query("qi") < 40 || (int)me->query("neili") < 10)
    return notify_fail("你的体力不足，挥不动弓！\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 20);
  me->add("neili", -5);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "youren-jian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;
  int flag = 1;
  object weapon;
  weapon = me->query_temp("weapon");
  ap = me->query_skill(
    "youren-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("youren-jian", 1);
  damage2 = (int)me->query_skill(
    "youren-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if ((me->query_skill(
    "huaxue-dafa",
    1
  ) < 200 && me->query_skill(
    "yiqiguan-riyue",
    1
  ) < 200 && me->query_skill(
    "longmen-shengong",
    1
  ) < 100) || me->query_skill("youren-jian", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "huaxue-dafa" && me->query_skill_mapped("force") != "yiqiguan-riyue" && me->query_skill_mapped("force") != "longmen-shengong") return 0;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing") return 0;
  if (me->query_skill_mapped("force") == "longmen-shengong") flag = 3;
  if (me->query_skill_mapped("force") == "huaxue-dafa") flag = 1;
  if (me->query_skill_mapped("force") == "yiqiguan-riyue") flag = 2;
  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 * flag + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIY "$N体会到情人离别之苦，使出伤心一箭，伤人，伤心！。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 * flag + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，低头垂吟，手中" + weapon->name() + HIG "如情人的箭，离别的心。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/xuehe")) {
    damage = ((damage1 * flag + damage2 * flag) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIM "$N融会血河派武学精髓，以己身为弦，以七情为箭，" + weapon->name() + HIM "如流星般射向$n。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
