"只震得$n胸内腹中，有如五脏一齐翻转！\n",
"抢先反震，将$n震得脸如白纸，全无血色！\n",
"震得$n心肺欲裂，腾腾腾连退数步！\n",
"功力已布满全身，将$n的力量反震回去！\n",
"震得$n天旋地转，腾腾腾连退七八步！\n",
"和$n一撞，只震的$p胸口气血翻涌！\n",
"$n便如撞在一堵棉花作面，钢铁为里的厚墙上一般，震退数步！\n",
"$n刚碰到$P，突然身子一震，登时飞了出去！\n",
});

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2,maxnei;
	object weapon2;
	weapon2 = ob->query_temp("weapon");
	ap = me->query_skill("yijinjing", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("parry",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("yijinjing", 1);
	damage2 = me->query_skill("yijinjing", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	maxnei = me->query("max_neili");
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("yijinjing", 1) < 300) return damage;
	if (me->query_skill_mapped("force")!="yijinjing" ) return damage;
	if ((int)me->query("jm/shaolin") ) maxnei = me->query("max_neili")*2;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIR"$N身上生出一股反震之力，结果$n的劲力被反震回去！\n"NOR;
		me->add("neili", -100 );
		j = -(damage+random(damage));
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		message_vision(msg, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		if (!ob->is_busy()) ob->start_busy(1);
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，身上金刚不坏体神功随心而起，$n的劲力被$N一招震碎！\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/shaolin") )
	{
		msg = HIB"$N融汇少林寺武学精髓，金刚不坏体神功随心而起，好似有一堵无形的墙在$n面前阻挡着，"NOR;
		if (objectp(weapon2 = ob->query_temp("weapon")))
		{
			if(random(3)==0)
			{
				msg += HIB"结果$N身上生出一股反震之力，$n只觉虎口一热，" + weapon2->name() + HIB"顿时脱手而出，飞出丈外！\n"NOR;
				weapon2->unequip();
				weapon2->move(environment(ob));
				message_vision(msg, me, ob);
			}
			else
			{
				msg += HIB"结果$n一下子被反弹开来，震得$n手臂发麻！！\n"NOR;
				ob->receive_damage("qi",damage1,me);
				ob->receive_wound("qi",damage1/2,me);
				message_vision(msg, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
			}
		}
		else
		{
			ob->receive_damage("qi",damage1,me);
			ob->receive_wound("qi",damage1/2,me);
			msg += HIB"结果$n不能前进一丝一毫！\n"NOR;
			message_vision(msg, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		}
		j = -(damage/3+random(damage/3));
		if (!ob->is_busy()) ob->start_busy(1);
		me->add("neili", -100 );
		return j;
	}
	if ( random(8) == 4 )
	{
        msg = RED"$N运起少林易筋经，易经伐髓，全身内力源源不断的涌出，身上的伤好了很多！\n"NOR;
		me->add("neili", -100 );
		j = -(damage/3+random(damage/3));
		if (me->query("neili") < maxnei) me->add("neili",damage1+damage2);
		me->add("eff_qi",damage1+damage2);
		if (me->query("eff_qi")>me->query("max_qi")) me->set("eff_qi",me->query("max_qi"));
		me->add("qi",damage1+damage2);
		if (me->query("qi")>me->query("eff_qi")) me->set("qi",me->query("eff_qi"));
		message_vision(msg, me, ob);
		return j;
	}
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp, damage1,damage2,damage,maxnei,liannum;

    ap = me->query_skill("yijinjing",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("yijinjing",1);
	damage2 = (int)me->query_skill("yijinjing",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	maxnei = me->query("max_neili");
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("yijinjing",1)<100) return 0;
	if ( me->query_skill_mapped("force") != "yijinjing") return 0;
	if ((int)me->query("jm/shaolin") ) maxnei = me->query("max_neili")*2;
	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		message_vision(HIB "$N发挥出"+HIR+"少林易筋经"NOR HIB"的真髓，混元真气摧毁了$n的精元！！！！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，深吸一口气，随着招式缓缓推出，$n如中雷击，吐出一口精血。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/shaolin") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		if (me->query("neili") < maxnei) me->add("neili",damage);
		me->add("eff_qi",damage);
		if (me->query("eff_qi")>me->query("max_qi")) me->set("eff_qi",me->query("max_qi"));
		me->add("qi",damage);
		if (me->query("qi")>me->query("eff_qi")) me->set("qi",me->query("eff_qi"));
		message_vision(HIM"$N融汇少林寺武学精髓，运转少林易筋经，十二周天循环，内力源源不绝，脸色红润不少。\n" NOR, me,victim);
		return ;
	}
}
string exert_function_file(string func)
{
	return __DIR__"yijinjing/" + func;
}
