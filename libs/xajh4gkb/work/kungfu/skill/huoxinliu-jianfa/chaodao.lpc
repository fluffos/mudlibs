// suodi.c 飞天御剑流.抄刃止刃

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  mixed combat_msg;
  object weapon;
  string msg;
  int i, attack_time, extra;
  int ap, dp;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("飞天御剑流.抄刃止刃只能对战斗中的对手使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query_skill("shayi-xinfa", 1) < 300)
    return notify_fail("你的杀意心法火候不够。\n");
  //	if( me->query_skill_mapped("force") != "shayi-xinfa" )
  //		return notify_fail("你所用的并非杀意心法，没法凝聚杀意，用不了本门绝技！\n");
  //	if (me->query_skill_mapped("blade") != "huoxinliu-jianfa")
  //		return notify_fail("你没正确激发该技能 。\n");
  if ((int)me->query_skill("huoxinliu-jianfa", 1) < 300)
    return notify_fail("你的神谷活心流的修为不够, 不能使用这一绝技 !\n");
  if ((int)me->query_skill("blade") < 1000)
    return notify_fail("你的刀法修为不够， 目前不能使用! \n");
  //	if( userp(me) && !me->query("feitian/chaodao"))
  //		return notify_fail("你只听说过,但不会用「抄刃止刃」！\n");
  if ((int)me->query("neili") < (int)me->query_skill("huoxinliu-jianfa", 1) * 4)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("max_neili") < 200000)
    return notify_fail("你的内力修为太差。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  combat_msg = me->query("env/no_combat_msg");
  if (!intp(combat_msg)) combat_msg = 1;
  msg = HIW "$N双手交叉，以手背抵挡$n的武器，使出了这至高防御止刃术。\n";
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1	
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "huoxinliu-jianfa",
    1
  ) + me->query_skill("sword") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  extra = me->query_skill("huoxinliu-jianfa", 1) / 15;
  if (me->query_skill_mapped("force") != "shayi-xinfa") extra -= me->query_skill(
    "huoxinliu-jianfa",
    1
  ) / 18;  //2018.9.5阿飞改，不使用本门特内则减益
  if ((string)weapon->query("id") == "long ya") extra += me->query_skill(
    "huoxinliu-jianfa",
    1
  ) / 15;  //2018.3.25阿飞改，拿特殊武器有加成	
  attack_time = (int)me->query_skill("huoxinliu-jianfa", 1) / 60;
  if (attack_time < 1) attack_time = 1;
  if (me->query("jm/feitian")) {
    if (attack_time > 150 + (int)me->query_temp("lianzhao_max_add") * 4) attack_time = 150 + (int)me->query_temp("lianzhao_max_add") * 4;
  } else {
    if (attack_time > 50 + (int)me->query_temp("lianzhao_max_add") * 2) attack_time = 50 + (int)me->query_temp("lianzhao_max_add") * 2;
  }

  if (random(ap) > dp / 4) {
    me->add_temp("lianzhao", attack_time);  //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
    me->add_temp("apply/attack", extra);
    me->add_temp("apply/damage", extra);
    me->add_temp("apply/strength", extra);
    for (i = 0; i < attack_time; i++) {
      if (combat_msg < 4) {
        msg = HIM "$N以刀柄刺对手怀内,使出了至高攻击抄刃术！\n" NOR;
        COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
      } else
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    }
    me->add("neili", -100 * attack_time);
    me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记
    me->add_temp("apply/attack", -extra);
    me->add_temp("apply/damage", -extra);
    me->add_temp("apply/strength", -extra);
  } else {
    msg = HIC "可是$n看破了$N的企图，收回了手中的武器。\n" NOR NOR;
    message_vision(msg, me, target);
  }
  if (!target->is_fighting(me)) target->fight_ob(me);
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
