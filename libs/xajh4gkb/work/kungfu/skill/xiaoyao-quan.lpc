    "force": 100,
    "lvl": 0,
    "damage_type": "内伤"
  ]),
  ([ "action": "$N左拳虚握，右拳快如闪电般打向$n的$l，正是一招「飞流直泻」",
    "attack": 100,
    "parry": 100,
    "dodge": 100,
    "damage": 100,
    "force": 100,
    "lvl": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使招「风雨归人」，双拳交错，忽又分开，引内劲打向$n的$l",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
