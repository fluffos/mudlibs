int valid_learn(object me) {
  mapping skl;
  string *sname;
  int i;
  int lvl = (int)me->query_skill("hanbing-zhenqi", 1);
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query("gender") == "无性" && lvl > 49)
    return notify_fail("你无根无性，阴阳不调，难以领会高深的寒冰真气。\n");
  if (!wizardp(me) && me->query("family/family_name") != "嵩山派")
    return notify_fail("你不拜在嵩山派门下恐怕学不了这项技能。\n");
  //	if(!wizardp(me) && me->query("family/master_id") != "zuo lengchan" )
  //		return notify_fail("寒冰真气是左冷禅独门技能，不是左盟主嫡传弟子是不可能传授的。\n");	
  if (me->query_skill("force", 1) <= lvl)
    return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
  if (me->query_skill("force", 1) < 300)
    return notify_fail("你的基本内功基础不够，怎能学寒冰真气。\n");
  if ((int)me->query("con", 1) < 25)
    return notify_fail("以你的资质，练寒冰真气恐怕会冻成冰棍。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");

  skl = this_player()->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "hanbing-zhenqi") continue;
    if (sname[i] == "xixing-dafa") continue;
    if (sname[i] == "yijing-force") continue;
    if (sname[i] == "zixia-shengong") continue;
    if (SKILL_D(sname[i])->valid_enable("force"))
      return notify_fail("你不先散了别派内功，怎能学寒冰真气？！\n");
  }
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

int practice_skill(object me) {
  return notify_fail("寒冰真气只能靠学(learn)来提高。\n");

}

string exert_function_file(string func) {
  return __DIR__ "hanbing-zhenqi/" + func;
}

mapping exercise_msg(object me) {
  return ([
    "status_msg": "脸上寒气浮现，隐隐有微光流动。" NOR,
    "start_my_msg": "手捏剑诀，将寒冰真气提起在体内慢慢转动。\n",
    "start_other_msg": me->name() + "摆了个盘膝打坐的姿势，全身笼罩在一片寒气之中。\n",
    "heal_my_msg": "运起寒冰真气，开始缓缓运气疗伤。\n" NOR,
    "heal_other_msg": me->name() + "内息一停，却见伤势已经全好了。”\n" NOR,
    "halt_msg": "双眼一睁，极速压下内息站了起来。\n",
    "end_my_msg": "将寒冰真气按周天之势搬运了一周，感觉精神充沛多了。\n" NOR,
    "end_other_msg": "只见" + me->name() + "缓缓睁开双眼站起，浑身散发出一股冰冷的寒气。\n" NOR,
    "hover_my_msg": "满面寒霜，双手轻轻一推，一股寒风吹起。良久，雪花纷飞。\n",
    "hover_other_msg": me->name() + "双手轻轻一推，一股寒风吹起。良久，雪花纷飞。\n",
  ]);
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  int j, ap, dp, damage1, damage2;
  damage1 = me->query_skill("hanbing-zhenqi", 1);
  damage2 = me->query_skill(
    "hanbing-zhenqi",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  ap = me->query_skill(
    "hanbing-zhenqi",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "force",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill("hanbing-zhenqi", 1) < 300) return damage;
  if (me->query_skill_mapped("force") != "hanbing-zhenqi") return damage;
  if (random(ap) > dp / 4 && me->query("neili") > 100 && random(8) == 0) {
    j = -(damage + random(damage));
    me->add("neili", -100);
    ob->apply_condition("cold_poison", ob->query_condition("cold_poison") + 5);
    message_vision(HIW "$n刚接触到$N，就象碰到了冰块一样，连忙收手，却已是全身蒙上了一层白雾，寒气入侵！\n" NOR, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && me->query("neili") > 100 && random(8) == 1) {
    j = -(damage + random(damage));
    me->add("neili", -100);
    if (!ob->is_busy()) ob->start_busy(1);
    ob->apply_condition("cold_poison", ob->query_condition("cold_poison") + 5);
    message_vision(HIW "猛然$n大叫一声急忙收手，全身已经被冷得直打寒战，难以呼吸！！\n" NOR, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && me->query("jingli") > 100 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -(damage + random(damage));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    ob->apply_condition("cold_poison", ob->query_condition("cold_poison") + 5);
    message_vision(
      HIG "$N启动" + me->query("cognize") + HIG "，真气极寒，只见$n身上已经结上了一层薄霜！\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && me->query("neili") > 100 && random(8) == 3 && (int)me->query("jm/songshan")) {
    j = -(damage + random(damage));
    if (!ob->is_busy()) ob->start_busy(2);
    me->add("neili", -100);
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    ob->apply_condition("cold_poison", ob->query_condition("cold_poison") + 5);
    message_vision(
      HIW "谁知刚一接触到$N，便有一股极寒之气冲来，慌得$n急忙收劲抽手！\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int ap, dp, damage1, damage2, damage, liannum;
  damage1 = (int)me->query_skill("hanbing-zhenqi", 1);
  damage2 = (int)me->query_skill(
    "hanbing-zhenqi",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  ap = me->query_skill(
    "hanbing-zhenqi",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "force",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("hanbing-zhenqi", 1) < 100) return 0;
  if (me->query_skill_mapped("force") != "hanbing-zhenqi") return 0;

  if (random(ap) > dp / 3 && random(7) == 1 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    if (!victim->is_busy()) victim->start_busy(1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    victim->apply_condition("cold_poison", victim->query_condition("cold_poison") + 5);
    message_vision(
      HIB "$N一招一式都蕴含" + HIR + "寒冰真气" NOR HIB "的精髓，寒冰真气冻结了$n的真元！！！！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    victim->apply_condition("cold_poison", victim->query_condition("cold_poison") + 5);
    message_vision(
      HIG "$N越战越勇，渐渐步入" + me->query("cognize") + HIG "，真气越来越寒冷，不一会将$n冻住。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/songshan")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    victim->apply_condition("cold_poison", victim->query_condition("cold_poison") + 5);
    message_vision(
      HIC "$N贯通嵩山派武学，嵩阳之火与寒冰之冷交融在一起，$n陷入寒热交替，难受至极。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
