// 如来神掌
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

void remove_effect(object me, int amount);

int perform(object me, object target) {
  int skill, ap, dp, damage, damage1;
  string msg;

  if (!target) target = offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("只能在战斗中使用。\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能使用「如来神掌」！\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢，哪有空运功？\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
  if ((int)me->query("max_neili") < 1000000)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("max_jingli") < 200000)
    return notify_fail("你的精力修为不够。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query_skill("tiezhang-zhangfa", 1) < 1000)
    return notify_fail("你的铁掌掌法还不够娴熟，使不出「如来神掌」来。\n");
  if ((int)me->query_skill("shuishangpiao", 1) < 1000)
    return notify_fail("你的铁掌水上漂等级不够，使不出「如来神掌」来。\n");
  if ((int)me->query_skill("guiyuan-tunafa", 1) < 1000)
    return notify_fail("你的归元土吐纳法等级还不够，使不出「如来神掌」绝技。\n");
  if (me->query_skill_mapped("force") != "guiyuan-tunafa")
    return notify_fail("不使用本门内功，如何能使用本门绝技。\n");
  if (me->query_skill_mapped("unarmed") != "tiezhang-zhangfa")
    return notify_fail("你未使用铁掌无法使用「如来神掌」！\n");
  if (!(int)me->query("breakup"))
    return notify_fail("你任督二脉未通,无法使用「如来神掌」！\n" NOR);
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  message_vision(HBWHT "$N贯通铁掌帮武学，使出了铁掌帮的绝学之精髓！\n" NOR, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1		
  skill = me->query_skill("tiezhang-zhangfa", 1) / 10;
  damage1 = me->query_skill(
    "tiezhang-zhangfa",
    1
  ) + me->query_skill("force") + me->query_skill("guiyuan-tunafa", 1);
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "tiezhang-zhangfa",
    1
  ) + me->query_skill("shuishangpiao", 1) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  message_vision(YEL "$N突然面色苍白，双手颤抖，随即两眼神光一闪，一双手掌颜色变的雪白，发出一种奇怪的光芒！\n" NOR, me, target);
  message_vision(
    HIY "$N" HIY "聚气于掌，施展铁掌掌法的「" HIR "铁掌降龙" HIY "」绝技，连续三掌朝$n" HIY "挥去。\n" NOR,
    me,
    target
  );
  message_vision(HIC "三层掌力，一浪接一浪，$n难以抵挡，只好硬拼！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  damage = damage1 / 5 + random(damage1 / 5);
  damage = damage * (100 - target->query_meridian()) / 100;
  target->receive_damage("qi", damage, me);
  target->receive_wound("qi", damage / 2, me);
  message_vision(HIW "$N第一层掌力......一重劲碎筋骨！\n" NOR, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
  //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);		

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  damage = damage1 / 4 + random(damage1 / 4);
  damage = damage * (100 - target->query_meridian()) / 100;
  target->receive_damage("qi", damage, me);
  target->receive_wound("qi", damage / 2, me);
  message_vision(HIW "$N第二层掌力......二重劲断经脉！\n" NOR, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
  //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);		

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  damage = damage1 / 3 + random(damage1 / 3);
  damage = damage * (100 - target->query_meridian()) / 100;
  target->receive_damage("qi", damage, me);
  target->receive_wound("qi", damage / 2, me);
  message_vision(HIW "$N第三层掌力......三重劲鬼神灭！\n" NOR, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
  //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);		
  message_vision(HIB "$n经脉受到$N强大的内力冲击，部分经脉承受不住，寸寸断裂！\n" NOR, me, target);
  message_vision(HIR "$n只觉得精神恍忽，眼前一黑，“哇”的一声，连续喷出三口鲜血！\n" NOR, me, target);
  me->add("neili", -1000);

  if (me->query_skill("shuishangpiao", 1) > 2000 && me->query_skill("tiezhang-zhangfa", 1) > 2000) {
    damage1 = me->query_skill(
      "tiezhang-zhangfa",
      1
    ) * 2 + me->query_skill(
      "shuishangpiao",
      1
    ) + me->query_skill("force") + me->query_skill("unarmed") + me->query_skill("dodge") + me->query("jiali");

    if (random(ap) > dp / 3) {
      damage = damage1 / 2 + random(damage1 / 2);
      damage = damage * (100 - target->query_meridian()) / 100;
      message_vision(HIW "$N一声暴喝，掌气凝聚，化作一柄开天大斧！\n" NOR, me, target);
      message_vision(HIG "$N以內气凝聚的开天辟地斧，劈开云层，如泰山压顶般直冲$n头顶而来！\n" NOR, me, target);
      message_vision(HIB "$n发现根本就无从闪避，只好使出浑身解数奋力招架！\n" NOR, me, target);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      me->add("neili", -2000);
      message_vision(
        HIC "$n避开了死亡的危险，但是仍是深受重伤，五脏六腑被掌刀击伤！\n" NOR,
        me,
        target,
        damage,
        HBWHT + HIM "气血伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法
      //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，精神的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);	
    } else {
      damage = damage1 / 6 + random(damage1 / 6);
      damage = damage * (100 - me->query_meridian()) / 100;
      message_vision(CYN "$n力拔山兮气盖世！以霸王举鼎的气势，击散了$N的掌气汇聚的斧头！\n" NOR, me, target);
      me->receive_damage("qi", damage, target);
      me->receive_wound("qi", damage / 2, target);
      me->add("neili", -1000);
      message_vision(HIM "$n受到掌力反噬，呕血三升！\n" NOR, target, me, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法	
      //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);	
    }
  }

  if (me->query_skill("shuishangpiao", 1) > 3000 && me->query_skill("tiezhang-zhangfa", 1) > 3000) {
    if (me->query("jm/tiezhang")) damage1 = me->query_skill(
      "tiezhang-zhangfa",
      1
    ) * me->query(
      "str",
      1
    ) * 3 / 20 + me->query_skill(
      "guiyuan-tunafa",
      1
    ) * me->query(
      "str",
      1
    ) * 3 / 20 + me->query_skill(
      "shuishangpiao",
      1
    ) * me->query(
      "str",
      1
    ) * 3 / 20 + me->query_skill(
      "force",
      1
    ) + me->query_skill("unarmed", 1) + me->query_skill("dodge", 1) + me->query("jiali");
    else damage1 = me->query_skill(
      "tiezhang-zhangfa",
      1
    ) * me->query(
      "str",
      1
    ) / 10 + me->query_skill(
      "guiyuan-tunafa",
      1
    ) * me->query(
      "str",
      1
    ) / 10 + me->query_skill(
      "shuishangpiao",
      1
    ) * me->query(
      "str",
      1
    ) / 10 + me->query_skill(
      "force",
      1
    ) + me->query_skill("unarmed", 1) + me->query_skill("dodge", 1) + me->query("jiali");

    if (random(ap) > dp / 3) {
      damage = damage1 / 3 + random(damage1 / 3) + target->query("qi") * 1 / 100;
      damage = damage * (100 - target->query_meridian()) / 100;
      message_vision(HIW "$N融汇贯通铁掌帮数门绝技，最后领悟了一招从天而降的掌法------【如来神掌】！\n" NOR, me, target);
      message_vision(HIY "$N背负盘古斧，盘漆而坐，右手竖立胸前，宝象庄严！\n" NOR, me, target);
      me->add_temp("apply/attack", skill);
      me->add_temp("apply/damage", skill);
      msg = HIM "\n          如 \n" NOR;
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), msg);
      msg = HIM "\n          来\n" NOR;
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), msg);
      msg = HIM "\n          神\n" NOR;
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), msg);
      msg = HIM "\n          掌\n" NOR;
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), msg);
      me->add_temp("apply/attack", -skill);
      me->add_temp("apply/damage", -skill);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      target->add("neili", -damage);
      target->add("jingli", -damage);
      if (random(4) == 1) {
        target->map_skill("force");  //下特殊内功
        message_vision(HIC "$n气息紊乱，一时忘了施展内功。\n" NOR, me, target);
      }
      me->add("neili", -3000);
      message_vision(HIW "$n被铺天盖地的掌力透体而过！顿时神色大变，忽白忽红！最后嘶哑的问了一句：这是什么掌法？\n" NOR, me, target);
      message_vision(
        HIR "$N傲然道：······如······来······神······掌······！$n轰然倒地！\n" NOR,
        me,
        target,
        damage,
        HBWHT + HIM "气血伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法
      //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);	
    } else {
      damage = damage1 / 9 + random(damage1 / 9);
      damage = damage * (100 - me->query_meridian()) / 100;
      message_vision(CYN "$n内力深厚，三花聚顶！真气于头顶化作三朵佛莲，最后拖住了如来法相！\n" NOR, me, target);
      message_vision(
        HIM "$n击破了$N的如来神掌，正沾沾自喜！没想到如来拔出背后的斧头，挥手一斧，横断铁掌山！$n被斧气割伤，鲜血蹦出！\n" NOR,
        me,
        target
      );
      me->receive_damage("qi", damage, target);
      me->receive_wound("qi", damage / 2, target);
      me->add("neili", -damage);
      me->add("jingli", -damage);
      message_vision(
        HIC "$n耗尽毕生功力使出的【如来神掌】如击棉絮，全身劲气流失，内力大损！\n" NOR,
        target,
        me,
        damage,
        HBWHT + HIM "气血伤害" NOR
      );  //2018.10.2阿飞改，优化化学伤害显示的写法
      //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);	
    }
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
