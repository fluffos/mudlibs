// tie@fengyun

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	string msg;
	int extra, i, v, attack_time,ap,dp,damage1,damage;
	object weapon2;
	
	if ( !target ) target = offensive_target(me);
	if ( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("铁掌降龙只能对战斗中的对手使用。\n"); 
	if( objectp(me->query_temp("weapon")) )
		return notify_fail("「铁掌降龙」只能空手使用。\n");	
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if ( (int)me->query_skill("tiezhang-zhangfa", 1) < 500 )
		return notify_fail("你的铁掌掌法不够娴熟，不能用铁掌降龙。\n");
//    if (me->query_skill_mapped("force") != "guiyuan-tunafa")
//        return notify_fail("不使用本门内功，如何能使用本门绝技。\n");	
//	if( me->query_skill_mapped("unarmed") != "tiezhang-zhangfa" && me->query_skill_mapped("strike") != "tiezhang-zhangfa")
//	    return notify_fail("你没有用铁掌掌法。\n");
	if ( (int)me->query_skill("guiyuan-tunafa", 1) < 500 )
	    return notify_fail("你的归元吐纳法不够娴熟，不能使用铁掌降龙。\n");
	if( me->is_busy() )
		return notify_fail("你现在正忙着呢，哪有空运功？\n");
	if ((int)me->query("max_neili") < 500000)								
		return notify_fail("你的内力修为不够。\n");
	if ((int)me->query("max_jingli") < 200000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < (int)me->query_skill("tiezhang-zhangfa", 1)*4 )
		return notify_fail("你的精力不够。\n");		
    if( (int)me->query("neili") < (int)me->query_skill("tiezhang-zhangfa", 1)*4 )
        return notify_fail("你的真气不够。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	damage1 = (int)me->query_skill("guiyuan-tunafa",1) + (int)me->query_skill("tiezhang-zhangfa", 1);		
	extra = me->query_skill("tiezhang-zhangfa", 1)/3 ;
	if ( me->query_skill_mapped("force") != "guiyuan-tunafa") extra += (int)me->query_skill("tiezhang-zhangfa", 1)/2;	//2018.9.5阿飞改，不使用本门特内则减益
//	if ((string)weapon->query("id") == "tie zhang") extra -= (int)me->query_skill("tiezhang-zhangfa", 1)/3;	 //2018.3.25阿飞改，拿特殊武器有加成
	ap = me->query("xyzx_sys/level") + me->query_skill("tiezhang-zhangfa", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	attack_time = me->query_skill("tiezhang-zhangfa", 1) / 60;	
	msg = HIY"\n$N运起［归元吐纳法］，同时使出［铁掌降龙］一阵一阵的掌力，如潮水般的击向$n！\n\n" NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	v = 1;	
	msg = HIW "第一层掌力，．．．．\n" NOR;
	message_vision(msg, me, target);
	if ( attack_time < 1) attack_time = 1;
	if (me->query("jm/tiezhang"))
	{
		if ( attack_time > 100+(int)me->query_temp("lianzhao_max_add")*4) attack_time = 100+(int)me->query_temp("lianzhao_max_add")*4;
	} else 
	{
		if ( attack_time > 50+(int)me->query_temp("lianzhao_max_add")*2) attack_time = 50+(int)me->query_temp("lianzhao_max_add")*2;
	}	
	
	me->add_temp("lianzhao", attack_time);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害
	me->add_temp("apply/attack", -extra);	
	me->add_temp("apply/damage", -extra);
	me->add_temp("apply/strength", -extra);
	for ( i=0; i<attack_time; i++ )
	{
		if ( i>4 && !(i%5) )
		{
			v++;
			msg = HIC "$N身形突转，又是连续五掌拍出第"+chinese_number(v)+"层掌力！\n" NOR;
			message_vision(msg, me, target);
			if( random(ap) > dp/3) 
			{		
				damage = damage1/4 + random(damage1/4);
				damage = damage*(100-target->query_meridian())/100;
				target->receive_damage("qi", damage,me);
				target->receive_wound("qi", damage/2,me);		
				msg = HIR"\n$n一声闷哼，像滩软泥般塌了下去！！\n"NOR;
				message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//				if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
			}
		}
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR);
	}
	me->add_temp("apply/attack", extra);
	me->add_temp("apply/damage", extra);
	me->add_temp("apply/strength", extra);
	me->add("neili", - 100 * attack_time);
	me->add("jingli", - 100 * attack_time);
	me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记
	
		msg = HIY "\n没想到$N忽然仰天大喝一声“天 雷 气”，双掌如风车般连环击出，一阵热浪随掌势狂飙而出，势不可挡！\n"NOR;
		message_vision(msg, me, target);			
		if( objectp(weapon2 = target->query_temp("weapon")) )
		{
			if( random(ap) > dp/3 ) 
			{  
				msg = HIM"\n$p只觉得浑身一热，手掌虎口巨痛，手中"+ weapon2->query("name") + "脱手而出。\n" NOR;
				message_vision(msg, me, target);
				weapon2->unequip();
				weapon2->move(environment(target));
			} 
			else 
			{
				msg = HIY"\n$p危急中突然伏地翻滚而出，避过了这致命一击，已吓得脸色苍白！\n" NOR;
				message_vision(msg, me, target);
			}
		}
		else
		{
			if( random(ap) > dp/3) 
			{		
				damage = damage1/2 + random(damage1/2);
				damage = damage*(100-target->query_meridian())/100;
				target->receive_damage("qi", damage,me);
				target->receive_wound("qi", damage/2,me);		
				msg = HIR"\n结果只听见几声喀喀轻响，$n一声惨叫，像滩软泥般塌了下去！！\n"NOR;
				message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//				if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
			} else 
			{
				msg = HIY"\n$p危急中突然伏地翻滚而出，避过了这致命一击，已吓得脸色苍白！\n" NOR;
				message_vision(msg, me, target);
			}
		}
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}