string skill_pinji() { return "下乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "邪道"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "日月神教"; }    //门派区分：门派，江湖
string skill_yinyang() { return "阴"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "邪派"; }   //阵营区分：正派、邪派、中立、通用
int damage_damage() { return 62; }  //外伤系数
int force_damage() { return 46; }  //内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "日月神教")
    return notify_fail("你不是本门中人，无法学习本门技能。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练天魔拳必须空手。\n");
  if ((int)me->query_skill("tianmo-shengong", 1) < 100)
    return notify_fail("你的天魔神功火候不够，无法练天魔拳。\n");
  if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("tianmo-quan", 1))
    return notify_fail("你的拳脚基础太差。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练天魔拳");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  return 1;
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query("qi") < 100)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够练天魔拳。\n");
  if (me->query("family/family_name") != "日月神教")
    return notify_fail("你不是日月神教弟子，不能练习本门武功。\n");
  if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("tianmo-quan", 1))
    return notify_fail("你的拳脚基础太差。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -5);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "tianmo-quan/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;

  ap = me->query_skill(
    "tianmo-quan",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("tianmo-quan", 1);
  damage2 = (int)me->query_skill(
    "tianmo-quan",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "tianmo-shengong",
    1
  ) < 100 || me->query_skill("tianmo-quan", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "tianmo-shengong") return 0;
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIR "霎时间只见$N幻化数道魔影，宛若流星般分从不同的方位同时攻向$n。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，默运天魔解体大法，双拳魔气翻腾，$n一着不慎，被击的血气翻涌。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/riyue")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->add("neili", -damage / 2);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIM "$N领悟日月神教魔功精髓，一声冷笑! 隔空吸功！$n全身气血如流水般源源不绝地吸入$N的身体！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
