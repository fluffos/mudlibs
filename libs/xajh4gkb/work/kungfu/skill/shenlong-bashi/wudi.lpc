// wudi.c 神龙无敌

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;
int perform(object me, object target)
{
	int extra,damage,ap,dp;
	string msg;

	if( !target ) target = offensive_target(me);
    if( !target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("只能对战斗中的对手使用。\n");
	if( environment(me)->query("no_fight") )
		return notify_fail("这里不能攻击别人! \n");
    if (objectp(me->query_temp("weapon")))
        return notify_fail("神龙无敌只能空手使用。\n");	
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if(me->is_busy())
		return notify_fail("你现在没空！！\n");
	if( (int)me->query("max_neili") < 500000  ) 
		return notify_fail("你的内力不够。\n");
	if( (int)me->query("max_jingli") < 500000  ) 
		return notify_fail("你的精力不够。\n");	
	if( (int)me->query("neili") < 10000 ) 
		return notify_fail("你的内力不够。\n");
	if( (int)me->query("jingli") < 10000 ) 
		return notify_fail("你的精力不够。\n");
    if( !wizardp(me) &&(int)me->query_skill("shenlong-bashi", 1) < 1000 )
		return notify_fail("你的神龙八式等级不够!不能使用神龙无敌！\n");
	if(!wizardp(me) && (int)me->query_skill("shedao-qigong", 1) < 1000 )
		return notify_fail("你的蛇岛奇功等级不够!不能使用神龙无敌！\n");
	if(!wizardp(me) && (int)me->query_skill("shenlong-xinfa", 1) < 1000 )
		return notify_fail("你的神龙心法等级不够!不能使用神龙无敌！\n");
	if (me->query_skill_mapped("unarmed") != "shenlong-bashi")
		return notify_fail("你没正确激发该技能 。\n");
    if ( !wizardp(me) && me->query_skill_mapped("force") != "shenlong-xinfa")
        return notify_fail("不使用本门内功，如何使用本门绝学!\n");
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用[神龙无敌]\n"NOR); 
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
    msg = HBWHT "$N贯通神龙岛武学，使出了神龙岛的绝学之精髓！\n" NOR;
    message_vision(msg, me, target); 
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1
	ap = me->query("xyzx_sys/level") + me->query_skill("shenlong-bashi", 1)+me->query_skill("shedao-qigong",1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	extra = me->query_skill("shedao-qigong",1)/10 + me->query_skill("shenlong-bashi",1)/10;
	
	me->add_temp("apply/attack",extra);
	me->add_temp("apply/damage",extra);
        msg = HIY "$N使出神龙岛的绝技魔蛇舞!\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
        msg = HIR "$N仰天长啸，高声狂叫：不死神龙，唯我不败！\n" NOR;		
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
        msg = HIG "$N洪教主神通广大，我教战无不胜，攻无不克，无坚不摧，无敌不破！\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
        msg = HIW "$N叫道：洪教主神通护佑，众弟子勇气百倍，以一当百，以百当万。\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
        msg = HIC "$N叫道：我弟子杀敌护教，洪教主亲加提拔，升任圣职。\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
        msg = HIB "$N叫道：我教弟子护教而死，同升天堂！。\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
        msg = YEL "$N叫道：洪教主神目如电，烛照四方。。\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);

		me->add_temp("apply/attack",-extra);
        me->add_temp("apply/damage",-extra);
		me->add("neili",-1000);
		me->add("jingli",-1000);
		
if( (int)me->query_skill("shenlong-bashi", 1) > 2000 && me->query_skill("shedao-qigong",1)>2000 )
{
		msg = MAG "$N掌出如风轻轻落在$n肩头上。\n"NOR;
		message_vision(msg, me, target);
		damage = (int)me->query_skill("shenlong-bashi",1) + me->query_skill("staff") +me->query_skill("force") + (int)me->query_skill("shedao-qigong",1)+(int)me->query_skill("shenlong-xinfa",1);
    if( random(ap) > dp/3 ) 
	{
		damage = damage/3 + random(damage/3);
		damage = damage*(100-target->query_meridian())/100;
        target->apply_condition("snake_poison",30);
        target->apply_condition("cold_poison",30);
		target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);
		me->add("neili",-1000);
		me->add("jingli",-1000);		
		msg = MAG "结果只听扑的一声，$p被$P一掌拍中！\n" NOR;
		msg += MAG "$p只觉得全身暖洋洋的，感到有点轻飘无力轻。\n" NOR;
		msg += HIB "忽然一股寒气优似冰箭，循着手臂，迅速无伦的射入$p胸膛\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	 else 
	{
		msg = CYN"可是$p急忙闪在一旁，躲了开去。\n" NOR;
		message_vision(msg, me, target);
	}
}	


if( (int)me->query_skill("shenlong-bashi", 1) > 3000 && me->query_skill("shedao-qigong", 1) > 3000 )
{	
	msg = HIR "$N口中念念有词，顷刻之间武功大进，高高跃起，$P手中巨毒的蛇血，向$n全身喷去!\n";
	message_vision(msg, me, target);
	if (me->query("jm/shenlong")) damage = (int)me->query_skill("shenlong-bashi",1) + (int)me->query_skill("shedao-qigong",1)*me->query("str",1)/3+(int)me->query_skill("shenlong-xinfa",1);
	else damage = (int)me->query_skill("shenlong-bashi",1) + (int)me->query_skill("shedao-qigong",1)*me->query("str",1)/4+(int)me->query_skill("shenlong-xinfa",1);	
    if (random(ap) >dp/3 )
    {
	damage = damage/4 + random(damage/4);
	damage = damage*(100-target->query_meridian())/100;
	target->receive_damage("qi",damage,me);
	target->receive_wound("qi",damage/2,me);
	me->add("neili",-2000);
	me->add("jingli",-2000);		
	msg = MAG "结果$p被巨毒的蛇血喷中\n" NOR;
	msg += HIR "$p只闻到一阵头昏，口中吐出一大口鲜血。\n" NOR;
	msg += HIC "$p金星乱冒，犹如有万条金龙在眼前舞动。。\n" NOR;
	message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	
        msg = HIW "第一道毒气"+HIR+"击中$n右身，！\n"NOR;   
        message_vision(msg, me, target);
        target->apply_condition("snake_poison",30);
                
        msg = HIC "第二道毒气"+HIM+"扫中$n的左身！\n"NOR;   
        message_vision(msg, me, target);
        target->apply_condition("wugong_poison",30);
                
        msg = MAG "最后一道毒气"+HIB+"扫中$n的上身!\n"NOR;   
        message_vision(msg, me, target);
        target->apply_condition("chanchu_poison",30);
	} else 
	{
		msg = CYN"可是$p急忙闪在一旁，躲了开去。\n" NOR;
		message_vision(msg, me, target);
	}
}

if( (int)me->query_skill("shenlong-bashi", 1) > 4000 && me->query_skill("shedao-qigong", 1) > 4000)
{
	msg = HIR "$N高声喊道：众志齐心可成城，威震天下无比伦！\n";
	message_vision(msg, me, target);
	if (me->query("jm/shenlong")) damage = (int)me->query_skill("shenlong-bashi",1)*me->query("str",1)*3/2 + (int)me->query_skill("shedao-qigong",1)*me->query("str",1)*3/2+(int)me->query_skill("shenlong-xinfa",1)*me->query("str",1)*3/2 + me->query_skill("staff") +me->query_skill("force") + target->query_skill("force");
	else damage = (int)me->query_skill("shenlong-bashi",1)*me->query("str",1) + (int)me->query_skill("shedao-qigong",1)*me->query("str",1)+(int)me->query_skill("shenlong-xinfa",1)*me->query("str",1) + me->query_skill("staff") +me->query_skill("force") + target->query_skill("force");
	
	if (random(ap) >dp/3 )
	{
		damage =random(damage/3)+damage/3 + target->query("jing")*4/100;
		damage = damage*(100-target->query_meridian())/100;
        target->receive_damage("qi",damage,me);
        target->receive_wound("qi",damage/2,me);
		target->apply_condition("xuanming_poison",30);
		if (random(4)==1) 
		{
			target->map_skill("dodge");	//下特殊轻功
			message_vision(RED"神龙不败，有我无敌。在神龙巡天时，$n不得动弹分毫。\n"NOR,me, target);
		}
		me->add("neili",-3000);
		me->add("jingli",-3000);
		msg = HIR "$n如中雷击，眼冒金星，顿时全身萎靡不振！\n";
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	} else 
	{
		damage =random(damage/10)+damage/10 + target->query("jing")*1/100;
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);
		target->apply_condition("ill_fashao",30);
		target->apply_condition("ill_kesou",30);
		target->apply_condition("ill_shanghan",30);
		target->apply_condition("ill_zhongshu",30);
		target->apply_condition("ill_dongshang",30);
		me->add("neili",-1000);
		msg = RED "$n全身身中数道毒气"+HIR+"口中吐出几口鲜血!\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);
	}      	
}
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}