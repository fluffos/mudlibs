//int force_damage() {return 60;}		//内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
    if (me->query_skill("dodge", 1) <=me->query_skill("tiyunzong", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	if (me->query("family/family_name")!="武当派")
		return notify_fail("你未加入武当派，没法学习。\n");	
	if (!me->query("jm/kunlun"))
		return notify_fail(CYN"我武当弟子与昆仑一派恩怨纠缠三代人，三代白发魔女皆与昆仑有关。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否去昆仑山为我派了解此段恩怨？\n"NOR);
	if ((int)me->query("family_score")<7)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
    if ((int)me->query_skill("taiji-shengong", 1) < 100)
		return notify_fail("你的太极神功不足，学不了武当技能。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
    return 1;
}
string query_dodge_msg(object me,string limb)
{
        if (me) me->set_temp("fight/dodge",random(2*me->query_skill("tiyunzong",1)));
        return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if( (int)me->query("qi") < 40 )
		return notify_fail("你的体力太差了，不能练梯云纵。\n");
	if (me->query("family/family_name")!="武当派")
		return notify_fail("你未加入武当派，练习不了。\n");	
	if (!me->query("jm/kunlun"))
		return notify_fail(CYN"我武当弟子与昆仑一派恩怨纠缠三代人，三代白发魔女皆与昆仑有关。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否去昆仑山为我派了解此段恩怨？\n"NOR);
	if ((int)me->query("family_score")<7)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);		
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 30);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"tiyunzong/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;

	ap = me->query_skill("tiyunzong", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("sword",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("tiyunzong", 1);
	damage2 = me->query_skill("tiyunzong", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if ( (me->query_skill("taiji-shengong",1) < 100 && me->query_skill("yinyun-ziqi",1) < 100) || me->query_skill("tiyunzong",1)<100) return damage;
//	if ( me->query_skill_mapped("force") != "taiji-shengong" && me->query_skill_mapped("force") != "yinyun-ziqi") return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
		msg = HIB"$N腾空拔地而起，虚空中连踏三步，$n一个招式落空，顿时真气迟滞。\n"NOR;
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		msg = HIY"$N顿悟"+me->query("cognize")+HIY"，身体沿着阴阳分割线而行，将$n的刚劲转化为柔劲反弹回去！\n"NOR;
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(msg, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/wudang") )
	{
		msg =HIC"$N融汇武当派精髓，脚底阴阳图浮现，足不沾地，浑厚真元化作阴阳二气，荡漾周身，将$n真元化为混沌！"NOR;
		j = -(damage+random(damage));
		me->add("neili", -100 );
		ob->add("neili", -damage1 );
		ob->add("jingli", -damage1 );
		message_vision(msg, me, ob);
		return j;
	}
}
