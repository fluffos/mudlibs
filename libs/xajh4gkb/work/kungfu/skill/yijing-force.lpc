{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
//    if (me->query("family/family_name")!="少林派")
//		return notify_fail("你不是佛门中人，无法学习易筋内功。\n");	
	if ((int)me->query_skill("force", 1) <= (int)me->query_skill("yijing-force", 1) )
		return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
/*	if (!me->query("jm/songshan"))
		return notify_fail(CYN"这嵩山派与我寺同处一山，欲夺取武林盟主之位，我少林表示不服。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否先为我少林潜入嵩山派夺取其秘密？我寺将来必有厚报。\n"NOR);
	if ((int)me->query("family_score")<10)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我寺功夫恐怕不能传授于你。\n"NOR);	*/
		
	return 1;
}

int practice_skill(object me)
{
    return notify_fail("易筋神功只能用学(learn)的来增加熟练度。\n");
}
string exert_function_file(string func)
{
    return __DIR__"yijing-force/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp, damage1,damage2,damage,liannum;

    ap = me->query_skill("yijing-force",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("yijing-force",1);
	damage2 = (int)me->query_skill("yijing-force",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("yijing-force",1)<100) return 0;
	if ( me->query_skill_mapped("force") != "yijing-force") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		message_vision(HIR "易筋洗髓，乃天下内功之基石，大道至简也。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，深吸一口气，随着招式缓缓推出，$n如中雷击，吐出一口精血。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/shaolin") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIM"$N融汇少林寺武学精髓，默运少林正宗易经心法，内力厚重，将$n击退一步。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}


