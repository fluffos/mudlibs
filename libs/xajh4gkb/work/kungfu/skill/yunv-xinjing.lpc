int valid_learn(object me)
{
	mapping skl;
	string *sname;
	int i;
	int lvl = (int)me->query_skill("yunv-xinjing", 1);
	
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_skill("yunv-xinjing",1)<120)
		return notify_fail("玉女心经只能靠领悟和研习。\n");
	if ( me->query("gender") == "无性" && lvl > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的玉女心经神功。\n");
	if ( me->query("gender") != "女性" )
		return notify_fail("玉女心经是古墓派至高无上的内功，非玉女不可学！\n");	
	if (me->query("family/family_name")!="古墓派")
		return notify_fail("你不是古墓派弟子，无法学习玉女心经。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
    if ((int)me->query_skill("force",1)<=(int)me->query_skill("yunv-xinjing", 1))
        return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
	if (!me->query("jm/quanzhen"))
		return notify_fail(CYN"我古墓派祖师与全真教重阳真人恩怨纠葛，可惜最终未能修成正果。我古墓弟子都得先去全真门下修行一段时间方可入门。\n"NOR);	
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	
	skl = this_player()->query_skills();
	sname  = keys(skl);
	for (i=0; i<sizeof(skl); i++)
	{
		if (sname[i]=="yijing-force") continue;
		if (sname[i]=="yunv-xinjing") continue;
		if (sname[i]=="yunv-xinfa") continue;
		if (sname[i]=="jiuyin-zhenjing") continue;
		if (sname[i]=="xixing-dafa") continue;
		if( SKILL_D(sname[i])->valid_enable("force") )
			return notify_fail("你不先散了别派内功，怎能学玉女心经？！\n");
	}
	if (random(100)==1) me->add("score",-5);		
	return 1;
}

int practice_skill(object me)
{
	return notify_fail("玉女心经只能靠领悟和研习。\n");
}

string exert_function_file(string func)
{
	return __DIR__"yunv-xinjing/" + func;
}

mapping exercise_msg(object me)
{
  return ([
    "status_msg" : "冰清玉洁，神态清冷。\n",
    "start_my_msg" : "轻轻的吸一口气，闭上眼睛，运起玉女心经，内息在脉络中开始运转，肌肤变得如羊脂般洁白。\n",
    "start_other_msg" : me->name()+"神态开始变的清冷无比，可是脸色又偷着桃李般娇羞。\n",
    "heal_my_msg" : "轻轻的吸一口气，闭上眼睛，运起玉女心经，内息运转于脉络之中，神态变得不可侵犯。\n",
	"heal_other_msg" :  me->name() + "神态突然开始变的清冷无比，身姿渐渐轻盈无双，舞动起来犹似一朵白莲盛开。\n",
	"halt_msg" : "内息一转，迅速收气，停止了内息的运转。\n",
    "end_my_msg" : "慢慢收气，归入丹田，睁开眼睛，轻轻的吐了一口气。\n",
    "end_other_msg" :  "只见"+me->name()+"睁开眼睛，轻轻的吐出了一口气，神态恢复自然。\n",
    "hover_my_msg" : "将玉女心经运转完毕，收功站起，浑身晶莹透彻。\n",
    "hover_other_msg" : me->name() + "指拈如意，轻轻地吐了口气，收功站起，姿态优雅。\n",	
	]);
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp, damage1,damage2,damage,liannum;

    ap = me->query_skill("yunv-xinjing",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("yunv-xinjing",1);
	damage2 = (int)me->query_skill("yunv-xinjing",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("yunv-xinjing",1)<100) return 0;
	if ( me->query_skill_mapped("force") != "yunv-xinjing") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		message_vision(HIB "$N发挥出"+HIR+"玉女心经"NOR HIB"的精髓，摧毁了$n的真元！！！！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，心若冰清，身如玉女，一道阴柔的内劲摧毁了$n精气神。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/gumu") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIM"$N融汇古墓派武功精髓，默运玉女玄功，一道柔劲摧毁了$n真元。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}
