int valid_learn(object me)
{
	mapping skl;
	string *sname;
	int i, nb, nf, nh, ns;
	nb = (int)me->query_skill("buddhism", 1);
	nf = (int)me->query_skill("force", 1);
	nh = (int)me->query_skill("hunyuan-yiqi", 1);
	ns = (int)me->query("guilty");
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
//	if ( me->query("marry") )
//		return notify_fail("你已经破了色戒，无法再学习混元一气功！\n");
//	if ( me->query("gender") != "男性" )
//		return notify_fail("你非童男之体，不能练习混元一气功。\n");
    if (me->query("family/family_name")!="少林派")
		return notify_fail("你不是佛门中人，无法学习本门技能。\n");	
	if ( nb < 100 && nb <= nh )
		return notify_fail("你的禅宗心法修为不够，无法领会更高深的混元一气功。\n");
	if ( nf < 100)
		return notify_fail("你的基本内功火候还不够，无法领会混元一气功。\n");
	if ( ns > 0 )
		return notify_fail("你屡犯僧家数戒，无法领会更高深的混元一气功。\n");
	if (nf <= nh )
		return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
	if (!me->query("jm/songshan"))
		return notify_fail(CYN"这嵩山派与我寺同处一山，欲夺取武林盟主之位，我少林表示不服。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否先为我少林潜入嵩山派夺取其秘密？我寺将来必有厚报。\n"NOR);
	if ((int)me->query("family_score")<10)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我寺功夫恐怕不能传授于你。\n"NOR);	
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");	
		
	skl = me->query_skills();
	sname  = keys(skl);
	for (i=0; i<sizeof(skl); i++)
	{
		if (sname[i]=="hunyuan-yiqi") continue;
		if (sname[i]=="yijing-force") continue;
		if (sname[i]=="yijinjing") continue;
		if (sname[i]=="damo-force") continue;		
		if (sname[i]=="xixing-dafa") continue;
		if( SKILL_D(sname[i])->valid_enable("force") )
			return notify_fail("你不先散了别派内功，怎能学混元一气功？！\n");
	}
	return 1;
}

int practice_skill(object me)
{
	return notify_fail("混元一气功只能用学(learn)的来增加熟练度。\n");
}
string exert_function_file(string func)
{
	return __DIR__"hunyuan-yiqi/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage1,damage2,damage,liannum;
	damage1 = (int)me->query_skill("hunyuan-yiqi",1);
	damage2 = (int)me->query_skill("hunyuan-yiqi",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	ap = me->query_skill("hunyuan-yiqi",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("hunyuan-yiqi",1) < 100 ) return 0;
	if ( me->query_skill_mapped("force") != "hunyuan-yiqi") return 0;
	if ( random(ap) > dp/3 && random(7)==1 && me->query("jiali") > 0) 
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100 );
		message_vision(HIB "$N发挥出"+HIR+"混元一气"NOR HIB"的真髓，混元内劲摧毁了$n的真元！！！！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N大吼一声，"+me->query("cognize")+HIG"的力量夹杂在混元真气中，击中了$n的天池穴。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/shaolin") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIC "$N领悟少林气功的精髓，“啄”的一声，一口混元气侵入$n丹田。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}


mapping exercise_msg(object me)
{
  return ([
        "status_msg" : "脸上红光隐现，气象庄严。\n" ,
        "start_my_msg" : "盘膝而坐，成五心向天的姿势，排除一切杂念，内息顺经脉缓缓流动。\n",
        "start_other_msg" :  me->name() + "五心向天，一会工夫，从口鼻处缓缓吐出白气，白气越吐越浓，渐渐笼罩了全身。\n",
        "heal_my_msg" : "盘膝而坐，五心向天，开始运功疗伤。\n",
        "heal_other_msg" :  me->name() + "五心向天，口鼻吐出云雾，伤口竟也渗出丝丝白气！\n",
        "halt_msg" :  "长出一口气，将内息急速退了回去，站了起来。\n",
        "end_my_msg" : "将内息走了个小周天，流回丹田，收功站了起来。\n",
        "end_other_msg" : "只见笼罩"+me->name() + "的白气渐渐消散，又从口鼻处吸了回去。\n",		
        "hover_my_msg" : "将内息走了个小周天，流回丹田，顿觉伤势恢复了许多。\n",
        "hover_other_msg" : "只见笼罩"+me->name() + "的白气渐渐消散，神完气足地站了起来，伤口白雾也随之消失不见。\n",	
    ]);
}
