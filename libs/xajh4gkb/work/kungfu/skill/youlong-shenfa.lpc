//int force_damage() {return 60;}		//内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me) 
{ 
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query("family/family_name")!="红花会")
		return notify_fail("你不加入红花会，会中之人对你不信任啊。\n");	
	if ((int)me->query_skill("honghua-shengong",1)<100)
		return notify_fail("你的红花神功火候不够，无法学游龙身法。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	return 1;	
}
string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("qi") < 40 )
		return notify_fail("你的体力太差了，不能练游龙身法。\n");
	if (me->query("family/family_name")!="红花会")
		return notify_fail("你不加入红花会，怎么可能练习的了游龙身法呢。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");				
	me->receive_damage("qi", 30);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"youlong-shenfa/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;

	ap = me->query_skill("youlong-shenfa", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("parry",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("youlong-shenfa", 1);
	damage2 = me->query_skill("youlong-shenfa", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("honghua-shengong",1) < 300 || me->query_skill("youlong-shenfa", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="honghua-shengong" ) return damage;
	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIG"$N身法突然加快，全身内力浑然一体，如龙游四海变的不可捉摸。\n"NOR;
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，身如游龙，惊若翩鸿，荡开$n招式，趁势直攻。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/honghua") )
	{
		j = -(damage+random(damage));
		me->add("neili", -100 );
		ob->add("neili", -damage1 );
		if (!ob->is_busy()) ob->start_busy(1);
		message_vision(HIB"$N融汇红花会武学精髓，$n似乎感到招式泥牛入海，如击棉絮，无从受力！\n"NOR, me, ob);
		return j;
	}
}

