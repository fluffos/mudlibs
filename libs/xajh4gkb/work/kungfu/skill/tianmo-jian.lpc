int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "日月神教")
    return notify_fail("你不是本门中人，无法学习本门技能。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("tianmo-shengong", 1) < 500)
    return notify_fail("你的天魔神功火候太浅。\n");
  if ((int)me->query_skill("sword", 1) < (int)me->query_skill("tianmo-jian", 1))
    return notify_fail("你的剑法基础太差。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon;
  weapon = me->query_temp("weapon");
  ap = me->query_skill(
    "tianmo-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("tianmo-jian", 1);
  damage2 = (int)me->query_skill(
    "tianmo-jian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "tianmo-shengong",
    1
  ) < 100 || me->query_skill("tianmo-jian", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "tianmo-shengong") return 0;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIR "霎时间只见剑光一闪，$N顿时化分为无数剑影，宛若流星般分从不同的方位同时攻向$n。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，默运天魔解体大法，剑气暴涨，只见$n一着不慎，血冒三丈。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/riyue")) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->add("neili", -damage / 3);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIM "$N领悟日月神教魔功精髓，一声冷笑! 隔空吸功！$n全身气血如流水般源源不绝地吸入$N的身体！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}


int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练天魔剑法。\n");
  if (me->query("family/family_name") != "日月神教")
    return notify_fail("你不是日月神教弟子，不能练习本门武功。\n");
  if ((int)me->query_skill("sword", 1) < (int)me->query_skill("tianmo-jian", 1))
    return notify_fail("你的剑法基础太差。\n");
  if (me->query("camp") != "邪派")
    return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 25);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "tianmo-jian/" + action;
}
