//「舞蝶心经」之「蝶翼断金」
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int exert(object me, object target) {
  string msg;
  object weapon2;
  int skill, ap, dp, damage;

  if (target == me || !target) {
    me->clean_up_enemy();
    target = me->select_opponent();
  }
  if (!me->is_fighting(target))
    return notify_fail("「蝶翼断金」只能对战斗中的对手使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着！\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
  if (me->query_skill("wudie-xinjing", 1) < 300)
    return notify_fail("你的「舞蝶心经」等级不够, 不能使用「蝶翼断金」！\n");
  if (!wizardp(me) && me->query_skill_mapped("force") != "wudie-xinjing")
    return notify_fail(HIC "不使用本门内功，如何使用本门绝学!\n" NOR);
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query("max_jingli") < 100000)
    return notify_fail("你的精力修为不够。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的内力不够，无法运用「蝶翼断金」！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  skill = me->query_skill("wudie-xinjing", 1);
  msg = HIY "$N微一凝神，运起「舞蝶心经」之「蝶翼断金」，一道金光射向$n。\n";
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  damage = skill + random(skill);
  damage = damage * (100 - target->query_meridian()) / 100;
  ap = me->query("xyzx_sys/level") + me->query_skill("wudie-xinjing", 1) + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("force");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  if (random(ap) > dp / 3) {
    if (objectp(weapon2 = target->query_temp("weapon"))) {
      if (userp(me)) me->add("neili", -400);
      msg = HIR "$n顿时觉得眼前一道金光闪过手中" NOR;
      msg += weapon2->name();
      msg += HIR "已经断成两节！\n" NOR;
      message_vision(msg, me, target);
      if (!target->is_killing(me)) target->kill_ob(me);
      weapon2->unequip();
      weapon2->move(environment(target));
      weapon2->set("name", "断掉的" + weapon2->query("name"));
      weapon2->set("item_old_value", weapon2->query("value"));
      weapon2->set("value", 0);
      weapon2->set("backold_weapon_prop", weapon2->query("weapon_prop"));
      weapon2->set("weapon_prop", 0);
      //				target->reset_action();		//这代码什么作用？		
    }
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 2, me);
    msg = HIW "舞蝶翩翩飞，蝶翼虽薄，亦可断筋。\n" NOR;
    message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
    //				if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
  } else {
    if (userp(me)) me->add("neili", -100);
    msg = "可是$n看破了$N的剑路，气贯丹田，浑身真气金光一闪，使$N的「蝶翼断金」没有起到作用。\n" NOR;
    message_vision(msg, me, target);
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
