mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	return notify_fail("龙之力量是龙族技能，不是人类可以练习的。\n");
}
int valid_learn(object me)
{
	return notify_fail("龙之力量是龙族技能，不是人类可以学习的。\n");
 }

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}
string perform_action_file(string action)
{
	return __DIR__"dragon/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap, dp,damage1,damage2,damage,liannum;
    ap = (int) me->query_skill("dragon",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
    dp = (int) victim->query_skill("dodge",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	damage1 = (int)me->query_skill("dragon",1);
	damage2 = (int)me->query_skill("dragon",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if ( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
	if ( me->query_skill("dragon",1) < 300)	 return 0;
	if (objectp(me->query_temp("weapon"))) return 0;
//	if ( me->query_skill_mapped("force") != "shenghuo-shengong") return 0;

	if (random(7)==1 && me->query("jiali") > 0 && random(ap) > dp/3)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili", -100 );
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		victim->apply_condition(du[random(sizeof(du))], 25);
		message_vision(HIR BLINK "$N张口一吐，一股腥臭的气息扑来！！$n躲闪不及，被熏了个七晕八素！！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
 	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup") )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG BLINK "$N神龙摆尾，叠加"+me->query("cognize")+HIG"的力量重重的击在$n身上！！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
}

int ob_hit(object ob, object me, int damage)
{
    int damage1,damage2, ap,dp,j;
	damage1 = (int) me->query_skill("dragon",1);
    damage2 = (int) me->query_skill("dragon",1)*(me->query("breakup")*me->query("breakup")*20+100)/100;
	ap = (int) me->query_skill("dragon",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
    dp = (int) ob->query_skill("unarmed",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
    if( damage < 10 ) damage =10;
    if ( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if ( me->query_skill("dragon",1) < 300)	 return damage;
	if (objectp(me->query_temp("weapon"))) return damage;
//	if ( me->query_skill_mapped("force") != "shenghuo-shengong") return 0;

	if (random(8)==1 && random(ap) > dp/4 )
    {
		j = -damage/3;
        me->add("neili",-100);
		ob->apply_condition(du[random(sizeof(du))], 25);
        message_vision( HIC"$n一招击中$N，正沾沾自喜，哪知道$N张口吐出龙息，顿时被熏的晕头转向！！\n"NOR, me, ob);		
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup") )
	{
		j = -(damage+random(damage));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N见$n来势汹汹，往前一步，紧接着"+me->query("cognize")+HIY"的力量爆发，一式神龙摆尾返身击中$n！\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);	
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/mofa") )
	{
		j = -(damage+random(damage));
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );
		message_vision(HIY"$N洞悉魔法本质，口诵一道咒语，一股莫名的气息凝聚，突然一道火球击中$n！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);	
		return j;
	}
}