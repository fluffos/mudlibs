int valid_enable(string usage) { return usage == "parry" || usage == "unarmed"; }
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "adai-quanfa"; }		//互备技能
string skill_pinji() { return "中乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "邪道"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "武当派"; }    //门派区分：门派，江湖
string skill_yinyang() { return "阴"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "正派"; }   //阵营区分：正派、邪派、中立、通用
int damage_damage() { return 76; }  //外伤系数
int force_damage() { return 42; }  //内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练三阴绝户手必须空手。\n");
  if ((int)me->query_skill("yinyun-ziqi", 1) < 300)
    return notify_fail("你的氤氲紫气火候不够，无法学三阴绝户手。\n");
  if (me->query("family/family_name") != "武当派")
    return notify_fail("你不是武当弟子，不能传授这种阴毒技能。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练三阴绝户手。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("jing") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练三阴绝户手。\n");
  if (me->query("family/family_name") != "武当派")
    return notify_fail("你不是武当弟子，不能练习这门阴毒技能。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  me->receive_damage("jing", 25);
  me->add("shen", -10);
  me->add("neili", -10);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "juehu-shou/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  string msg;
  int ap, dp, damage1, damage2, damage, liannum;
  ap = (me->query("xyzx_sys/level") + me->query_skill(
    "juehu-shou",
    1
  )) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = (victim->query("xyzx_sys/level") + victim->query_skill(
    "unarmed",
    1
  )) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("juehu-shou", 1) + me->query_skill("yinyun-ziqi", 1);
  damage2 = ((int)me->query_skill(
    "juehu-shou",
    1
  ) + me->query_skill(
    "yinyun-ziqi",
    1
  )) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("jingli") < 100 || me->query("neili") < 100 || damage_bonus < 100) return 0;
  if ((me->query_skill(
    "taiji-shengong",
    1
  ) < 100 && me->query_skill(
    "yinyun-ziqi",
    1
  ) < 100) || me->query_skill("juehu-shou", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "taiji-shengong" && me->query_skill_mapped("force") != "yinyun-ziqi" ) return 0;
  if (objectp(me->query_temp("weapon"))) return 0;
  if (me->query_skill_mapped("force") == "yinyun-ziqi") damage2 *= 2;

  if (random(7) == 1 && me->query("jiali") > 0 && random(ap) > dp / 3) {
    msg = HIR "$N咬破舌尖，运起全身功力向$n下身抓去。。。" NOR;
    me->add("neili", -100);
    if (victim->query("gender") == "男性") {
      damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
      victim->receive_damage("qi", damage, me);
      victim->receive_wound("qi", damage / 3, me);
      if (me->query_skill_mapped("force") == "yinyun-ziqi" && random(3) == 0) {
        victim->add("neili", -damage);
        victim->set("gender", "无性");
        victim->set("genderbak", "男性");
        msg += HIW "$n突然觉的下体一凉，疼的大叫起来。。。随后大哭起来。。。没了！没了！\n" NOR;
        if (!me->is_killing(victim)) me->kill_ob(victim);
        if (!victim->is_killing(me)) victim->kill_ob(me);
      } else
        msg += HIW "$n被你一击命中，疼的大叫起来！\n" NOR;
      message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    } else if (victim->query("gender") == "女性") {
      damage = ((damage1 + damage_bonus) / 3) * (liannum + 20) / (20 * liannum + 1);
      victim->receive_damage("qi", damage, me);
      victim->receive_wound("qi", damage / 3, me);
      msg += HIW "$n被你一击命中，不禁既羞又怒，$N竟对一女流之辈也用此下流招数！\n" NOR;
      message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    } else {
      msg += HIW "$n被你一击命中，不禁大笑道：哈哈，无鸡鸡一身轻！\n" NOR;
      message_vision(msg, me, victim);
    }
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    msg = HIR "$N顿悟" + me->query("cognize") + HIR "，淫荡一笑，五指突然抓向$n隐秘部位......" NOR;
    me->add("jingli", -100);
    if (victim->query("gender") == "男性") {
      damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
      victim->receive_damage("jing", damage, me);
      victim->receive_wound("jing", damage / 3, me);
      if (me->query_skill_mapped("force") == "yinyun-ziqi" && random(3) == 1) {
        victim->add("jingli", -damage);
        victim->set("gender", "无性");
        victim->set("genderbak", "男性");
        msg += HIW "$n突然觉的下体一凉，疼的大叫起来。。。随后大哭起来。。。没了！没了！\n" NOR;
        if (!me->is_killing(victim)) me->kill_ob(victim);
        if (!victim->is_killing(me)) victim->kill_ob(me);
      } else
        msg += HIW "$n被你一击命中，疼的大叫起来！\n" NOR;
      message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤精" NOR);
    } else if (victim->query("gender") == "女性") {
      damage = ((damage2 + damage_bonus) / 3) * (liannum + 20) / (20 * liannum + 1);
      victim->receive_damage("jing", damage, me);
      victim->receive_wound("jing", damage / 3, me);
      msg += HIW "$n被你一击命中，不禁既羞又怒，$N竟对一女流之辈也用此下流招数！\n" NOR;
      message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤精" NOR);
    } else {
      msg += HIW "$n被你一击命中，不禁大笑道：哈哈，无鸡鸡一身轻！\n" NOR;
      message_vision(msg, me, victim);
    }
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/wudang")) {
    msg = HIR "$N融汇武当派武功精髓，出招光明正大，明目张胆的抓向$n下三路......" NOR;
    me->add("neili", -100);
    if (victim->query("gender") == "男性") {
      damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
      victim->receive_damage("qi", damage, me);
      victim->receive_wound("qi", damage / 3, me);
      if (me->query_skill_mapped("force") == "yinyun-ziqi" && random(3) == 2) {
        victim->add("neili", -damage);
        victim->set("gender", "无性");
        victim->set("genderbak", "男性");
        msg += HIW "$n突然觉的下体一凉，疼的大叫起来。。。随后大哭起来。。。没了！没了！\n" NOR;
        if (!me->is_killing(victim)) me->kill_ob(victim);
        if (!victim->is_killing(me)) victim->kill_ob(me);
      } else
        msg += HIW "$n被你一击命中，疼的大叫起来！\n" NOR;
      message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    } else if (victim->query("gender") == "女性") {
      damage = (((damage1 + damage2) / 2 + damage_bonus) / 3) * (liannum + 20) / (20 * liannum + 1);
      victim->receive_damage("qi", damage, me);
      victim->receive_wound("qi", damage / 3, me);
      msg += HIW "$n被你一击命中，不禁既羞又怒，$N竟对一女流之辈也用此下流招数！\n" NOR;
      message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    } else {
      msg += HIW "$n被你一击命中，不禁大笑道：哈哈，无鸡鸡一身轻！\n" NOR;
      message_vision(msg, me, victim);
    }
    return;
  }
}
