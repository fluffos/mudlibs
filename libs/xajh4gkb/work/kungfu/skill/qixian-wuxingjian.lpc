int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query("family/family_name")!="梅庄")
		return notify_fail("你不加入本门，无法学习本门技能。\n");	
    if (me->query_skill("wuzheng-xinfa",1)<300)
        return notify_fail("你的本门内功基础不够。\n");	
	if( me->query("con",1)<30 )
		return notify_fail("七弦无形剑对内功要求极高，只有根骨极佳之人才能修炼！\n");	
	if( me->query("max_neili")<200000 )
		return notify_fail("你的内力太弱，无法修炼七弦无形剑。\n");
	if ((int)me->query_skill("unarmed", 1) < 1000)
		return notify_fail("你的基本拳脚火候不够，无法修炼七弦无形剑。\n");
	if ((int)me->query_skill("sword", 1) < 1000)
		return notify_fail("你的基本剑法火候不够，无法修炼七弦无形剑。\n");
	if ((int)me->query_skill("force", 1) < (int)me->query_skill("qixian-wuxingjian", 1))
		return notify_fail("你的内功修为有限，无法领会更高深的七弦无形剑。\n");
	if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("qixian-wuxingjian", 1))
		return notify_fail("你的基本拳脚水平有限，无法领会更高深的七弦无形剑。\n");
	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("qixian-wuxingjian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的七弦无形剑。\n");
	if ((int)me->query_skill("qixian-wuxingjian", 1) > 3000)
		return notify_fail("上乘武学只能教到这里了，以后要靠自己勤加修习领悟。\n");				
	if ((int)me->query("score",1) < 10000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	if (random(10)==1) me->add("score",-10);	
        return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action_unarmed)-1; i >= 0; i--)
	if(level >= action_unarmed[i]["lvl"])
		return action_unarmed[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	if (!weapon) return action_unarmed[random(sizeof(action_unarmed))];	//2017.9.4阿飞改，将招式简单点	        
	else return action_sword[random(sizeof(action_sword))];	//2017.9.4阿飞改，将招式简单点  
}

int practice_skill(object me)
{
	if (!wizardp(me))
		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query("family/family_name")!="梅庄")
		return notify_fail("你不加入本门，无法学习本门技能。\n");	
    if (me->query_skill("wuzheng-xinfa",1)<100)
        return notify_fail("你的本门内功基础不够。\n");		
	if( me->query("qi")<70 )
		return notify_fail("你的体力不够练七弦无形剑！\n");
	if( me->query("neili")<120 )
		return notify_fail("你的内力不够练七弦无形剑！\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 60);
	me->add("neili", -100);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	string name;
	int ap,dp, damage1,damage2,damage,liannum;
	object weapon;
	weapon = me->query_temp("weapon");
    ap = me->query_skill("qixian-wuxingjian",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("qixian-wuxingjian",1);
	damage2 = (int)me->query_skill("qixian-wuxingjian",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	name = xue_name[random(sizeof(xue_name))];
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("wuzhen-xinfa",1) < 100 || me->query_skill("qixian-wuxingjian",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "wuzhen-xinfa") return 0;
	if (objectp(weapon = me->query_temp("weapon")) && (string)weapon->query("skill_type") != "sword") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIW "只听一阵淳厚的弦音从$N" HIW "处传来，$n" HIY "『" + name + "』" NOR + HIW "顿时受震，两耳轰鸣，全身真气乱窜不止！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，一曲阳关白雪响起，$n听得心神不定，只感呼吸不畅，鼓膜轰鸣，目不视物，几欲晕倒。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/meizhuang") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIM"$N融汇梅庄武学精髓，一曲高山流水响起，$n忽然觉得一阵迷乱，连忙运了一口气，才清醒过来。。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

