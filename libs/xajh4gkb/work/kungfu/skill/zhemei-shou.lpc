int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练天山折梅手必须空手。\n");
  if (me->query("family/family_name") != "逍遥派" && me->query("family/family_name") != "灵鹫宫")
    return notify_fail("你不是逍遥传人或灵鹫宫弟子，无法学习折梅手。\n");
  if ((int)me->query("int", 1) < 25)
    return notify_fail("以你的悟性恐怕难以领悟折梅手。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练天山折梅手。\n");
  if ((int)me->query_skill(
    "beiming-shengong",
    1
  ) < 300 && (int)me->query_skill(
    "bahuang-gong",
    1
  ) < 300 && (int)me->query_skill("xiaowuxiang", 1) < 300)
    return notify_fail("你的逍遥门内功火候不够，无法学习折梅手。\n");
  if (me->query_skill("unarmed", 1) <= me->query_skill("zhemei-shou", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练天山折梅手必须空手。\n");
  if (me->query("family/family_name") != "逍遥派" && me->query("family/family_name") != "灵鹫宫")
    return notify_fail("你不是逍遥传人或灵鹫宫弟子，无法练习折梅手。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练天山折梅手。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -10);
  return 1;
}

mapping query_action(object me, object weapon) {
  int level = (int)me->query_skill("zhemei-shou", 1);

  if (random(level) > 300 && random(20) == 1 && me->query("jiali") > 100) {

    return ([
      "action": HIC "$N右手一弯，掌上凝聚阴柔之力，无声无息劈向$n的「至阳穴」，跟着左拳猛击而出，击向$n胸口的「膻中穴」" NOR,
      "damage_type": "内伤",
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
    ]);
  }
  if (random(level) > 300 && random(20) == 2 && me->query("jiali") > 100) {
    return ([
      "action": HIG "$N左手袍袖一拂，激出一股内劲，袖力中夹着掌力，一前一后击向$n" NOR,
      "damage_type": "内伤",
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
    ]);
  }
  if (random(level) > 300 && random(20) == 3 && me->query("jiali") > 100) {
    return ([
      "action": HIB "$N手腕转了个小圈，既快且准，三只手指搭上$n手腕，大拇指和小指跟着便即收拢，扣住$n脉门，$n顿时动弹不得" NOR,
      "damage_type": "瘀伤",
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
    ]);
  }
  if (random(level) > 300 && random(20) == 4 && me->query("jiali") > 100) {
    return ([
      "action": HIW "$N双手连抓，使出「天山折梅手」的高深武功，抓中带扣，扣中夹掌，连攻$n的命门大穴" NOR,
      "damage_type": "瘀伤",
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
    ]);


  }
  if (random(level) > 300 && random(20) == 5 && me->query("jiali") > 100 && me->query_temp("powerup")) {
    return ([
      "action": HIR "这时$N内力生发，将「逍遥」二字发挥得淋漓尽致，姿势优雅美观，潇洒如意\n"
      "然而逍遥派武学的诸般狠辣招数自然而然的也使了出来，所使招数渐趋阴险刻毒\n"
      "$N招招凶险，皆攻向$n要害，直欲致$n死得惨酷无比" NOR,
      "damage_type": "瘀伤",
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
    ]);

  }
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

string perform_action_file(string action) {
  return __DIR__ "zhemei-shou/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  string msg;
  int ap, dp, damage1, damage2, damage, maxnei, liannum;

  ap = ((int)me->query_skill(
    "beiming-shengong",
    1
  ) + (int)me->query_skill(
    "bahuang-gong",
    1
  )) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = (int)victim->query_skill(
    "force",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("zhemei-shou", 1);
  damage2 = (int)me->query_skill(
    "zhemei-shou",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  maxnei = me->query("max_neili");
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if ((me->query_skill(
    "bahuang-gong",
    1
  ) < 100 && me->query_skill(
    "beiming-shengong",
    1
  ) < 100 && me->query_skill(
    "xiaowuxiang",
    1
  ) < 100) || me->query_skill("zhemei-shou", 1) < 100) return 0;
  //	if (me->query_skill_mapped("force") != "beiming-shengong" && me->query_skill_mapped("force") != "bahuang-gong" && me->query_skill_mapped("force") != "xiaowuxiang") return 0;
  if (objectp(me->query_temp("weapon"))) return 0;
  if (me->query("jm/xiaoyao")) maxnei = (int)me->query("max_neili") * 2;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    msg = HIR "$n" HIR "的一只手臂，被$N用力弯折！疼痛难忍！" NOR;
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    if (me->query_skill_mapped("force") == "bahuang-gong") {
      victim->apply_condition("ss_poison", 10 + victim->query_condition("ss_poison"));
      msg += HIW "$n只觉得身上一寒，竟然中了一道生死符！\n" NOR;
    }
    if (me->query_skill_mapped("force") == "beiming-shengong") {
      if (victim->query("neili") > damage) victim->add("neili", -damage);
      if (me->query("neili") < maxnei) me->add("neili", damage);
      msg += HIW "$n只觉得全身真元如流水般源源不绝地流入$N的身体。\n" NOR;
    }
    if (me->query_skill_mapped("force") == "xiaowuxiang") {
      if (victim->query("jingli") > damage) victim->add("jingli", -damage);
      msg += HIW "$n只觉得一股内力似乎要将自己化为无形。\n" NOR;
    }
    message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    msg = HIG "$N顿悟" + me->query("cognize") + HIG "，使出「天山折梅手」的折梅绝技，连攻$n的命门大穴！\n" NOR;
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (me->query_skill_mapped("force") == "bahuang-gong") {
      victim->apply_condition("ss_poison", 10 + victim->query_condition("ss_poison"));
      msg += HIG "$n只觉得身上一寒，竟然中了一道生死符！\n" NOR;
    }
    if (me->query_skill_mapped("force") == "beiming-shengong") {
      if (victim->query("neili") > damage) victim->add("neili", -damage);
      if (me->query("neili") < maxnei) me->add("neili", damage);
      msg += HIG "$n只觉得全身真元如流水般源源不绝地流入$N的身体。\n" NOR;
    }
    if (me->query_skill_mapped("force") == "xiaowuxiang") {
      if (victim->query("jingli") > damage) victim->add("jingli", -damage);
      msg += HIG "$n只觉得一股内力似乎要将自己化为无形。\n" NOR;
    }
    message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤精" NOR);
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/xiaoyao")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    msg = HIM "$N融汇逍遥武学精髓，将「逍遥」二字发挥得淋漓尽致，姿势优雅美观！\n" NOR;
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    if (me->query_skill_mapped("force") == "bahuang-gong") {
      victim->apply_condition("ss_poison", 10 + victim->query_condition("ss_poison"));
      msg += HIM "$n只觉得身上一寒，竟然中了一道生死符！\n" NOR;
    }
    if (me->query_skill_mapped("force") == "beiming-shengong") {
      if (victim->query("neili") > damage) victim->add("neili", -damage);
      if (me->query("neili") < maxnei) me->add("neili", damage);
      msg += HIM "$n只觉得全身真元如流水般源源不绝地流入$N的身体。\n" NOR;
    }
    if (me->query_skill_mapped("force") == "xiaowuxiang") {
      if (victim->query("jingli") > damage) victim->add("jingli", -damage);
      msg += HIM "$n只觉得一股内力似乎要将自己化为无形。\n" NOR;
    }
    message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    return;
  }

}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int j, ap, dp, damage1, damage2, maxnei;
  ap = (int)me->query_skill(
    "zhemei-shou",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = (int)ob->query_skill(
    "unarmed",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("zhemei-shou", 1);
  damage2 = (int)me->query_skill(
    "zhemei-shou",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  maxnei = (int)me->query("max_neili");

  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if ((me->query_skill(
    "bahuang-gong",
    1
  ) < 100 && me->query_skill(
    "beiming-shengong",
    1
  ) < 100 && me->query_skill(
    "xiaowuxiang",
    1
  ) < 100) || me->query_skill("zhemei-shou", 1) < 100) return damage;
  //	if (me->query_skill_mapped("force") != "beiming-shengong" && me->query_skill_mapped("force") != "bahuang-gong" && me->query_skill_mapped("force") != "xiaowuxiang") return damage;
  if (objectp(me->query_temp("weapon"))) return damage;
  if (me->query("jm/xiaoyao")) maxnei = (int)me->query("max_neili") * 2;

  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = HIY "$N手掌微微弯曲，从意向不到的位置，击中$n的手腕。\n" NOR;
    if (!ob->is_busy()) ob->start_busy(2);
    me->add("neili", -100);
    j = -(damage + random(damage));
    if (me->query_skill_mapped("force") == "beiming-shengong") {
      if (ob->query("neili") > damage1) ob->add("neili", -(damage1 + damage2));
      if (me->query("neili") < maxnei) me->add("neili", damage1 + damage2);
      msg += HIY "$n只觉得全身真元如流水般源源不绝地流入$N的身体。\n" NOR;
    }
    message_vision(msg, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    msg = HIB "顿悟" + me->query("cognize") + HIG "，小而无形，无形无迹，无相无我！\n" NOR;
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    if (me->query_skill_mapped("force") == "xiaowuxiang") {
      if (ob->query("jingli") > damage1) ob->add("jingli", -damage1);
      msg += HIB "$n只觉得一股内力似乎要将自己化为无形。\n" NOR;
    }
    message_vision(msg, me, ob, damage2, HBWHT + HIY "精神反伤" NOR);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/xiaoyao")) {
    msg = HIC "$N融汇逍遥派武学精髓，千万里江山如画，谁能踏雪寻梅！\n" NOR;
    j = -(damage / 3 + random(damage / 3));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    if (me->query_skill_mapped("force") == "bahuang-gong") {
      ob->apply_condition("ss_poison", 10 + ob->query_condition("ss_poison"));
      msg += HIC "$n只觉得身上一寒，竟然中了一道生死符！\n" NOR;
    }
    message_vision(msg, me, ob, damage1, HBWHT + HIY "气血反伤" NOR);
    return j;
  }

}
