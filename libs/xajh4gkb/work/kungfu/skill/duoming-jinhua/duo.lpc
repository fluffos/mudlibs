// duo.c 金花夺命

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  object weapon, weapon2;
  string msg;
  int skill, damage, iduo;
  int ap, dp;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「金花夺命」只有在战斗中施用。\n");
  if (!objectp(weapon2 = me->query_temp("weapon")) || (string)weapon2->query("skill_type") != "throwing")
    return notify_fail("你使用的武器不对。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  //	if ( !wizardp(me) && me->query_skill_mapped("force") != "shenghuo-shengong" && me->query_skill_mapped("force") !="jiuyang-shengong")
  //		return notify_fail("不使用本门内功，如何使用本门绝学!\n"); 
  //	if (me->query_skill_mapped("throwing") != "duoming-jinhua")
  //		return notify_fail("你没正确激发该技能 。\n");
  if (target && target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧ⅵ\n");
  if ((int)me->query_skill(
    "shenghuo-shengong",
    1
  ) < 300 && (int)me->query_skill("jiuyang-shengong", 1) < 300)
    return notify_fail("你的圣火神功火候不够。\n");
  if ((int)me->query_skill("duoming-jinhua", 1) < 300)
    return notify_fail("你的夺命金花不够娴熟，使不出「金花夺命」。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力欠佳。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  msg = HIY "$N使出「金花夺命」，连递数个鬼魅般的金花击向$n的手腕。\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1	
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "duoming-jinhua",
    1
  ) + me->query_skill("throwing") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  skill = (int)me->query_skill("duoming-jinhua", 1);
  if ((string)weapon2->query("id") == "shenghuo ling") iduo = 4;
  else iduo = 3;
  damage = skill * iduo;
  if (random(ap) > dp / iduo) {
    msg = HIR "$n顿时觉得手腕一麻，胸口一痛，";
    if (objectp(weapon = target->query_temp("weapon"))) {
      msg += "手中" + weapon->name() + "竟然不易而飞！已被$N的夺命镖击落在地！\n";
      weapon->unequip();
      //			weapon->move(environment(me)); 	//武器被夺走
      weapon->move(me);    //武器掉地上				
    }
    damage = damage / 2 + random(damage / 2);
    damage = damage * (100 - target->query_meridian()) / 100;
    target->receive_damage("jing", damage, me);
    target->receive_wound("jing", damage / 2, me);
    msg += "细看时，胸口居然还有一个小洞！\n" NOR;
    message_vision(msg, me, target, damage, HBWHT + HIM "精神伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
  } else {
    msg = "可是$p看破了$P的企图，并没有上当。\n" NOR;
    message_vision(msg, me, target);
  }
  me->add("neili", -300);
  me->add("jingli", -300);
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
