int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query("gender") != "女性")
    return notify_fail("你又不是女人练不了五罗轻烟掌？\n");
  if ((int)me->query("dex", 1) < 30)
    return notify_fail("五罗轻烟掌需要身体轻盈才能练习。\n");
  if ((int)me->query("int", 1) < 30)
    return notify_fail("你笨头笨脑的领会不了五罗轻烟掌。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练五罗轻烟掌必须空手。\n");
  if ((int)me->query_skill("kumu-shengong", 1) < 200)
    return notify_fail("你的枯木神功太弱，无法练五罗轻烟掌。\n");
  if (me->query("family/family_name") != "大理段家")
    return notify_fail("你不是大理段家弟子，不能传授给你。\n");
  if (!me->query("jm/xiaoyao"))
    return notify_fail(CYN "大理段家唯有第十六代皇帝因获得逍遥派无上机缘，才最终将六脉贯通。\n" + CYN "这位" + RANK_D->query_respect(me) + CYN "是否应该先去逍遥派游历一番？\n" NOR);
  if ((int)me->query("family_score") < 7)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练五罗轻烟掌。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query("gender") != "女性")
    return notify_fail("你又不是女人练不了五罗轻烟掌？\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练五罗轻烟掌。\n");
  if (me->query("family/family_name") != "大理段家")
    return notify_fail("这是大理段家不传之密，你一个外人怎么能够练习呢。\n");
  if (!me->query("jm/xiaoyao"))
    return notify_fail(CYN "大理段家唯有第十六代皇帝因获得逍遥派无上机缘，才最终将六脉贯通。\n" + CYN "这位" + RANK_D->query_respect(me) + CYN "是否应该先去逍遥派游历一番？\n" NOR);
  if ((int)me->query("family_score") < 7)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;

  ap = me->query_skill(
    "wuluo-zhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("wuluo-zhang", 1);
  damage2 = (int)me->query_skill(
    "wuluo-zhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "kumu-shengong",
    1
  ) < 100 || me->query_skill("wuluo-zhang", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "kumu-shengong") return 0;
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIY "$N越战越猛，双掌逐渐笼罩在烟雾之中，$n越发难以看见$N的掌式，不知不觉间已中了好几掌。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，情难消，恨难平，楼台尽在烟雨中。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/dali")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIM "$N融汇大理段氏武学精髓，双掌带着雾气，朦朦胧胧，挥手即是南国。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}


string perform_action_file(string action) {
  return __DIR__ "wuluo-zhang/" + action;
}
