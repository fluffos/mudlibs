int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("学大悲掌必须空手。\n");
    if (me->query("family/family_name")!="通吃帮")
		return notify_fail("你未加入通吃帮，无法领悟本门技能的精髓。\n");	
    if ((int)me->query("max_neili") < 10000)
        return notify_fail("你的内力太弱，无法练大悲掌。\n");
    if (me->query_skill("unarmed", 1) <=me->query_skill("dabei-zhang", 1))
        return notify_fail("你的掌法基础不够，无法领会更高深的技巧。\n");
	if ((int)me->query_skill("fanyun-force", 1) < 100 && (int)me->query_skill("damo-force", 1) < 100)		
        return notify_fail("你的本门内功太低，无法钻研更高深的大悲掌。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	if (random(100)==1) me->add("score",-5);
       return 1;
}
string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练大悲掌必须空手。\n");
	if (me->query("family/family_name")!="通吃帮")
		return notify_fail("你未加入通吃帮，无法练习大悲掌。\n");	
    if ((int)me->query("qi") < 30)
        return notify_fail("你的体力太低了。\n");
    if ((int)me->query("neili") < 20)
        return notify_fail("你的内力不够练大悲掌。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
    me->receive_damage("qi", 25);
    me->add("neili", -5);
    return 1;
}

string perform_action_file(string action)
{
	return __DIR__"dabei-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int flag = 1;	
	int ap,dp,damage1,damage2,damage,liannum;
	damage1 = (int)me->query_skill("dabei-zhang",1);
	damage2 = (int)me->query_skill("dabei-zhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	ap = me->query_skill("dabei-zhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if ( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
	if ( (me->query_skill("fanyun-force",1) < 100 && me->query_skill("damo-force",1) < 100) || me->query_skill("dabei-zhang",1) < 100) return 0;
//	if ( me->query_skill_mapped("force") != "fanyun-force" && me->query_skill_mapped("force") != "damo-force") return 0;	
	if (objectp(me->query_temp("weapon"))) return 0;
	if (me->query_skill_mapped("force") == "damo-force") flag = 2;

	if(me->query("jiali") > 0 && random(ap) > dp/3 && random(7)==1 )
	{
		damage = (damage1*flag+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100 );
		message_vision(HIW "$N神情悲苦，愁容满面！$n被$N的悲伤之气感染，顿时吐出一口淤血！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2*flag+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N脸现慈悲之色，出掌间隐隐有"+me->query("cognize")+HIG"力量，$n心绪被夺，精神受损。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/tongchi") )
	{
		damage = ((damage1*flag+damage2*flag)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIC "$N对通吃帮武功精髓洞若观火，出掌之际，脸色悲痛莫名。$n一招不慎，被击中胸口。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}