mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}


int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练五毒神掌必须空手。\n");
	if (me->query("family/family_name")!="古墓派")
		return notify_fail("你不是古墓弟子，不能传授给你。\n");
	if (!me->query("jm/quanzhen"))
		return notify_fail(CYN"我古墓派祖师与全真教重阳真人恩怨纠葛，可惜最终未能修成正果。我古墓弟子都得先去全真门下修行一段时间方可入门。\n"NOR);	
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if ((int)me->query_skill("yunv-xinfa", 1) < 100 && (int)me->query_skill("yunv-xinjing", 1) < 100)		
		return notify_fail("你的玉女心法火候不够，无法学习五毒神掌。\n");
	if ((int)me->query("max_neili") < 60)
		return notify_fail("你的内力太弱，无法练五毒神掌");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	if (random(100)==1) me->add("score",-5);		
	return 1;
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if ((int)me->query("qi") < 30)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 8)
		return notify_fail("你的内力不够练五毒神掌。\n");
	if (me->query("family/family_name")!="古墓派")
		return notify_fail("你不是古墓弟子，不能练习五毒神掌。\n");
	if (!me->query("jm/quanzhen"))
		return notify_fail(CYN"我古墓派祖师与全真教重阳真人恩怨纠葛，可惜最终未能修成正果。我古墓弟子都得先去全真门下修行一段时间方可入门。\n"NOR);	
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if (me->query("camp")!="正派")	
		return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 30);
	me->add("neili", -5);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;

    ap = me->query_skill("wudu-shenzhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("wudu-shenzhang",1);
	damage2 = (int)me->query_skill("wudu-shenzhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( (me->query_skill("yunv-xinfa",1) < 100 && me->query_skill("yunv-xinjing",1) < 100 && me->query_skill("jiuyin-zhenjing",1) < 100) || me->query_skill("wudu-shenzhang",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") != "yunv-xinjing" && me->query_skill_mapped("force") != "jiuyin-zhenjing") return 0;
	if (objectp(me->query_temp("weapon")) ) return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIB "你听到「砰」一声巨响，"+victim->name()+"像泄气的皮球缓缓的瘫倒！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		victim->apply_condition("wuduz_poison", (me->query_skill("wudu-shenzhang",1)/100) + 1 +victim->query_condition("wuduz_poison"));
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，掌心乌黑，印在$n身上，$n只觉得一股奇诡之毒迅速蔓延至全身。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/gumu") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		victim->apply_condition("yufeng_poison", (me->query_skill("wudu-shenzhang",1)/100) + 1 +victim->query_condition("yufeng_poison"));
		message_vision(HIM"$N贯通古墓派武学精髓，突然掏出一根冰魄银针向你射来！------$n大叫一声：“哎呀，不好！此针有毒！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

string perform_action_file(string action)
{
	return __DIR__"wudu-shenzhang/" + action;
}

