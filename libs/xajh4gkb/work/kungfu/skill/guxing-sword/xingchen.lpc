#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	string msg,force_skill;
	int skill,damage,huifu,flag;
	int ap,dp;
	flag = 1;
	
	if (!target ) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「星沉地动」只能在战斗中使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if((int)me->query_skill("sword",1) < 2000)
		return notify_fail("你的基本剑法的火候还不到家, 不能使用这一绝技 !\n");
	if((int)me->query_skill("guxing-sword",1) < 1000)
		return notify_fail("你的孤星剑法的火候还不到家, 不能使用这一绝技 !\n");
	if((int)me->query_skill("piaomiao-shenfa",1) < 1000)
		return notify_fail("你的缥缈身法的火候还不到家, 不能使用这一绝技 !\n");
	if((int)me->query_skill("dabei-zhang",1) < 1000)
		return notify_fail("你的大悲掌的火候还不到家, 不能使用这一绝技 !\n");	
	if(me->query_skill_mapped("sword") != "guxing-sword")
		return notify_fail("你没有使用孤星剑法, 不能使用这一绝技 !\n");
	if(me->query_skill_mapped("dodge") != "piaomiao-shenfa")
		return notify_fail("你没有使用缥缈身法, 不能使用这一绝技 !\n");	
	if( (int)me->query_skill("damo-force", 1) < 1000 && (int)me->query_skill("fanyun-force", 1) < 1000 )	
		return notify_fail("你的本门神功不够娴熟，无法施展「星沉地动」。\n");	
	if(me->query_skill_mapped("force") != "fanyun-force" && me->query_skill_mapped("force") != "damo-force")
		return notify_fail("不使用本门内功，如何能使用本门绝技。\n");	
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你的精神欠佳！\n");
	if( (int)me->query("max_neili") < 500000 )
		return notify_fail("你的精力修为不够！\n");
	if( (int)me->query("neili") < 10000 )
		return notify_fail("你的内力不够。\n");
	if( me->is_busy() )
		return notify_fail("你现在正忙着呢，哪有空运功？\n");
	if (!(int)me->query("breakup"))
		return notify_fail("你任督二脉未通,无法使用「星沉地动」！\n"NOR); 
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	if (me->query_skill_mapped("force") == "damo-force") flag = 2;
	if (me->query_skill_mapped("force") == "fanyun-force") flag = 1;	

	
	message_vision(HBWHT "$N贯通通吃帮武学，使出了通吃帮的绝学之精髓！\n" NOR, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1
	force_skill = me->query_skill_mapped("force");	
	skill = me->query_skill(force_skill,1);
	damage = me->query_skill("guxing-sword",1) + me->query_skill("dabei-zhang",1) + me->query_skill("piaomiao-shenfa",1);
	damage = damage*flag/3 + random(damage*flag/3);
	damage = damage*(100-target->query_meridian())/100;
	ap = me->query("xyzx_sys/level") + me->query_skill("guxing-sword", 1) + me->query_skill("piaomiao-shenfa",1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	msg = YEL "\n$N微微一皱眉头，潇洒从容的使出孤星剑法中的最后杀招「星沉地动」！\n" NOR;
	msg += HIG "\n顿时地动山摇，天空中落下无数星辰！\n" NOR;
	message_vision(msg, me,target);	

	msg = HIR "\n$N剑上金色光芒一闪···············「金星」出击！\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIC "\n$N剑上青色光芒一闪···············「木星」出击！\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIB "\n$N剑上蓝色光芒一闪···············「水星」出击！\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = RED "\n$N剑上红色光芒一闪···············「火星」出击！\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIY "\n$N剑上黄色光芒一闪···············「土星」出击！\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	
	target->receive_damage("qi", damage,me);
	target->receive_wound("qi", damage/2,me);
	me->add("jingli",-1000);
	msg = HIG "\n$n被星辰砸的晕头转向，找不着北，浑身伤痕累累！\n" NOR;
	message_vision(msg, me,target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	
if(me->query_skill("guxing-sword",1) > 2000 && me->query_skill("piaomiao-shenfa",1) > 2000)	
{
	damage = me->query_skill("guxing-sword",1)*flag + me->query_skill("dabei-zhang",1)*flag + me->query_skill("piaomiao-shenfa",1)+ me->query_skill("unarmed",1) + me->query_skill("force") + me->query_skill("sword",1);
	damage = damage/3 + random(damage/3);
	damage = damage*(100-target->query_meridian())/100;
	message_vision(HIB "$N汇聚五星之力，召唤出毁灭星光！\n" NOR, me, target);
	if (random(ap)>dp/3)
	{
		message_vision(HIG "$N剑光一指，大吼一声：去吧，毁灭一切！\n" NOR, me, target);
		message_vision(BLU "$n只见天空突然降下无数陨石和星辰，根本就无从躲闪！\n" NOR, me, target);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		target->add("jingli", -damage);	
		target->apply_condition("no_force", 6*flag);
		me->add("jingli",-2000);
		message_vision(HIW "$n被化作星辰的剑气透体而过，数处大穴似乎被剑气淤塞，一时提不起真气！\n" NOR, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		message_vision(HIM "$n将身法发挥到极致，居然躲开了绝大部分星辰！\n" NOR, me, target);
		me->add("jingli",-1000);
	}
}
	
if(me->query_skill("guxing-sword",1) > 3000 && me->query_skill("piaomiao-shenfa",1) > 3000)	
{
	if (me->query("jm/tongchi")) damage = me->query_skill("guxing-sword",1)*me->query("dex",1)*3/20 + me->query_skill("dabei-zhang",1)*me->query("dex",1)*3/20+ me->query_skill("unarmed",1) + me->query_skill("force")+ me->query_skill("piaomiao-shenfa",1)*me->query("dex",1)*3/20 + me->query_skill("sword",1)+skill*me->query("dex",1)*3/20;
	else damage = me->query_skill("guxing-sword",1)*me->query("dex",1)/10 + me->query_skill("dabei-zhang",1)*me->query("dex",1)/10+ me->query_skill("unarmed",1) + me->query_skill("force")+ me->query_skill("piaomiao-shenfa",1)*me->query("dex",1)/10 + me->query_skill("sword",1)+skill*me->query("dex",1)/10;
	damage = damage/3 + random(damage/3) + target->query("jing")*1/100;
	if (me->query("shen")>100000 && target->query("shen")<-100000) damage = damage+target->query("jing")*1/100;
	if (me->query("shen")<-100000 && target->query("shen")>100000) damage = damage/2;
	damage = damage*(100-target->query_meridian())/100;
	message_vision(HIB "$N面露慈悲之气，佛曰：你不下地狱，谁下地狱！\n" NOR, me, target);
	if (random(ap)>dp/3)
	{
		message_vision(HIG "$N对$n说到：去吧！地狱十八层为你打开！\n" NOR, me, target);
		message_vision(HIM
		"\n    佛佛佛佛佛佛佛佛佛佛                佛      \n" 
		"\n                      佛                佛      \n"
		"\n                      佛                佛      \n"
		"\n                      佛                佛      \n"
		"\n                      佛                佛      \n"
		"\n                      佛                佛      \n"
		"\n                      佛                佛      \n"
		"\n    佛佛佛佛佛佛佛佛佛佛佛佛佛佛佛佛佛佛佛      \n"
		"\n    佛                佛                        \n"		
		"\n    佛                佛                        \n"
		"\n    佛                佛                        \n"
		"\n    佛                佛                        \n"
		"\n    佛                佛                        \n"
		"\n    佛                佛                        \n"
		"\n    佛                佛佛佛佛佛佛佛佛佛佛      \n"NOR, me, target);	
		message_vision(BLU "漫天似有大道之音：放下屠刀，立地成佛！苦海无涯，回头是岸！\n" NOR, me, target);
		message_vision(HIY "$n大吼道：我不入地狱，谁入地狱！\n" NOR, me, target);

		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/3,me);	
		target->add("jingli", -damage);
		target->apply_condition("no_exert", 6*flag);
		me->add("jingli",-3000);
		message_vision(HIR "佛光转瞬间化作一把巨剑，穿透$n，$n鲜血狂喷！一时半会无法呼吸！\n" NOR, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/3 +"。\n" NOR);
	}
	else
	{
		message_vision(HIG "$n大笑三声：命由己造，相由心生，世间万物皆是化相，心不动，万物皆不动，心不变，万物皆不变！\n" NOR, me, target);
		if ( target->query("eff_qi") < target->query("max_qi") )
		{
			huifu = (target->query("max_qi") - target->query("eff_qi"))/3;
			target->add("eff_qi",huifu);
			target->add("qi",huifu);
			message_vision(HIG "$N说：救人一命胜造七级浮屠！\n" NOR, me, target);
//			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人恢复气血"+ huifu +"，回复内伤"+ huifu +"。\n" NOR);
		}
		message_vision(HIW "$n看破虚妄，直透本心，接住了$N这一招！\n" NOR, me, target);
		me->add("jingli",-1000);
	}
}	
	me->start_busy(1);	
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}