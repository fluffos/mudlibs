int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query_skill("dodge", 1) <=me->query_skill("yueying-wubu", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	if (me->query("family/family_name")!="灵鹫宫")
		return notify_fail("你不加入灵鹫宫，恐怕学不了月影舞步。\n");	
    if ((int)me->query_skill("bahuang-gong", 1) < 100)
		return notify_fail("你的本门内功不足，学不了月影舞步。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
    return 1;
}
string query_dodge_msg(object me,string limb)
{
	me->set_temp("fight/dodge",(me->query_skill("yueying-wubu",1)+random(me->query_skill("yueying-wubu",1))/2));
	return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if( (int)me->query("qi") < 45 )
        return notify_fail("你的体力太差了，不能练月隐舞步。\n");
	if (me->query("family/family_name")!="灵鹫宫")
		return notify_fail("你不加入灵鹫宫，被童姥知道了恐怕会有性命之危。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
    me->receive_damage("qi", 35);
    return 1;
}


string perform_action_file(string action)
{
	return __DIR__"yueying-wubu/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;

	ap = me->query_skill("yueying-wubu", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("parry",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("yueying-wubu", 1);
	damage2 = me->query_skill("yueying-wubu", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("bahuang-gong",1) < 300 || me->query_skill("yueying-wubu", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="bahuang-gong" ) return damage;
	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIB"$N突然身形灵动，舞步空灵，越发飘逸起来！\n"NOR;
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，月下舞影，独望兰舟，相顾无言！\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/lingjiu") )
	{
		j = -(damage+random(damage));
		me->add("neili", -100 );
		ob->add("neili", -damage1 );
		if (!ob->is_busy()) ob->start_busy(2);
		message_vision(HIB"$N融汇灵鹫宫武学精髓，身姿灵气袭人，$n不知如何是好，只好放弃了这一招！\n"NOR, me, ob);
		return j;
	}
}
