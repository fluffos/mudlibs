mapping query_action(object me, object weapon) {
  int level;
  level = (int)me->query_skill("ittouryu", 1);

  if (random(10) == 1 && random(level) > 100 && me->query("jiali") > 100) {
    return ([
      "action": RED "" + (order[random(13)]) + "「  牙突一式! 」" NOR "" + HIY "$N突然加速！刺出后水平横扫,追击躲闪的$n!" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "skill_name": "牙突一式!",
      "damage_type": "刺伤" ]);
  }
  if (random(10) == 2 && random(level) > 200 && me->query("jiali") > 100) {
    return ([
      "action": HIR "" + (order[random(13)]) + "「  牙突二式! 」" NOR "" + HIY "$N突然加速！刀举头上,刺出后向$n运动劈下! " NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "skill_name": "牙突二式!",
      "damage_type": "刺伤" ]);
  }
  if (random(10) == 3 && random(level) > 300 && me->query("jiali") > 100) {
    return ([
      "action": HIM "" + (order[random(13)]) + "「  牙突三式! 」" NOR "" + HIY "$N突然加速！由下刺上,对跃起的$n使出牙突,这是是对空的招式！" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "skill_name": "牙突三式!",
      "damage_type": "刺伤" ]);
  }
  if (random(10) == 4 && random(level) > 400 && me->query("jiali") > 100) {
    return ([
      "action": HIW "" + (order[random(13)]) + "「  牙突四式! 」" NOR "" + HIY "$N在离$n极近距离猛的将刀刺出,威力巨大,这乃是一招必杀技 ！" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "skill_name": "牙突四式!",
      "damage_type": "刺伤" ]);
  }

  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点

}

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }
//2019-1-1阿飞新规划，技能代码完善
string valid_combine() { return "feitian-yujianliu"; }  //互备技能
