string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "邪道"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "飞天御剑流"; }    //门派区分：门派，江湖
string skill_yinyang() { return "中性"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "中立"; }   //阵营区分：正派、邪派、中立、通用
int damage_damage() { return 72; }  //外伤系数
int force_damage() { return 56; }  //内伤系数
