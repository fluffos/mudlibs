string perform_action_file(string action) {
  return __DIR__ "ittouryu/" + action;
}
int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "飞天御剑流")
    return notify_fail("你不是飞天门人，无法学习本门技能。\n");
  if (!me->query("jm/shushan"))
    return notify_fail(CYN "这蜀山之人常飞来飞去的，这岂不是蔑视我飞天门吗。\n" CYN "这位" + RANK_D->query_respect(me) + CYN "要修炼我飞天门功夫，先得为我门探得蜀山派的飞剑秘密！\n" NOR);
  if ((int)me->query("family_score") < 9)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if ((int)me->query_skill("xuanhualiu-quanfa", 1) < 100)
    return notify_fail("你的喧哗流拳法火候不够，无法学。\n");
  if ((int)me->query_skill("shayi-xinfa", 1) < 100)
    return notify_fail("你的杀意心法火候不够，无法学。\n");
  if ((int)me->query_skill("ninjitsu", 1) < 100)
    return notify_fail("你的忍术火候不够，无法学。\n");
  if ((int)me->query_skill("enmeiryu", 1) < 100)
    return notify_fail("你的陆奥圆明流拳术火候不够，无法学。\n");
  if ((int)me->query("max_neili") < 50000)
    return notify_fail("你的内力太弱，无法练一刀流剑术。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query_skill("shayi-xinfa", 1) < 30)
    return notify_fail("你的杀意心法火候不够。\n");
  if (me->query("family/family_name") != "飞天御剑流")
    return notify_fail("你不是飞天门人，无法练习本门技能。\n");
  if (!me->query("jm/shushan"))
    return notify_fail(CYN "这蜀山之人常飞来飞去的，这岂不是蔑视我飞天门吗。\n" CYN "这位" + RANK_D->query_respect(me) + CYN "要修炼我飞天门功夫，先得为我门探得蜀山派的飞剑秘密！\n" NOR);
  if ((int)me->query("family_score") < 9)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if ((int)me->query("qi") < 70)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 70)
    return notify_fail("你的内力不够练一刀流剑术。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("qi", 60);
  me->add("neili", -60);
  return 1;

}
mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  object weapon;
  int ap, dp, damage1, damage2, damage, liannum;
  string msg;
  weapon = me->query_temp("weapon");
  ap = me->query_skill(
    "ittouryu",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("ittouryu", 1);
  damage2 = (int)me->query_skill(
    "ittouryu",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("shayi-xinfa", 1) < 100 || me->query_skill("ittouryu", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "shayi-xinfa") return 0;	
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade") return 0;

  if (random(ap) > dp / 3 && random(7) == 1 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    msg = HIR "「百鬼袭！！ 」" + HIM "$N御技如神，杀气冲天！\n" NOR;
    if (random(7) == 0) msg = HIC "「百鬼冲！！」" + HIY "$N御技如神，杀气冲天！。\n" NOR;
    if (random(7) == 1) msg = HIM "「百鬼碎！！」" + HIY "$N御技如神，杀气冲天！ \n" NOR;
    if (random(7) == 2) msg = HIC "「百鬼突！！」" + HIW "$N御技如神，杀气冲天！\n" NOR;
    if (random(7) == 3) msg = HIG "「百鬼坠！！」" + HIW "$N御技如神，杀气冲天！\n" NOR;
    if (random(7) == 4) msg = HIW "「百鬼斩！！」" + HIY "$N御技如神，杀气冲天！ \n" NOR;
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，身形隐于黑暗之中，突然" + weapon->name() + HIG "一闪，$n应声倒地。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/feitian")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIM "$N领悟飞天门武功精髓，招式大开大合，夜空中突然一道闪光，$n大叫一声，鲜血飞溅。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
