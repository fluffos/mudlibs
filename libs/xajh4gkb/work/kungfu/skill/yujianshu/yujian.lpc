#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	object weapon;
	int damage,ap,dp,skill;
	string msg;

	if (! target) target = me->select_opponent();
	if (! target || !target->is_character() || ! me->is_fighting(target))
		return notify_fail("御剑伏魔只能对战斗中的对手使用。\n");
	if( !objectp(weapon = me->query_temp("weapon")) ||  weapon->query("skill_type") != "sword" )
		return notify_fail("你使用的武器不对。\n");
//	if ( playerp(me) && me->query("family/family_name") != "蜀山派" ) 
//		return notify_fail("不是蜀山的不能用「御剑伏魔」！\n");
//	if ( playerp(me) && me->query("shushan/jinsheng_perform") != 1 ) 
//		return notify_fail("你还没领会「御剑今生」！\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if ((int)me->query_skill("yujianshu", 1) < 1000)
		return notify_fail("你的御剑术尚达不到「御剑伏魔」的境界。\n");
	if ((int)me->query_skill("fumozhang", 1) < 1000)
		return notify_fail("你的伏魔掌尚达不到「御剑伏魔」的境界。\n");
	if ((int)me->query_skill("shushan-force",1) < 1000)
		return notify_fail("你的蜀山内功火候尚达不到「御剑伏魔」的境界。\n");
	if( me->query("max_neili") < 1000000 )
		return notify_fail("你的内力修为太弱，无法灵活的御驾内力。\n");
	if( me->query("neili") < 10000 )
		return notify_fail("你现在内力不够。\n");
	if ((int)me->query("max_jingli") < 1000000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你的精力不够。\n");		
	if ( me->query_skill_mapped("force") != "shushan-force" )
		return notify_fail("你不使用本门内功，如何能使用本门绝技！\n");	
	if (me->query_skill_mapped("sword") != "yujianshu")
		return notify_fail("你没正确激发该技能 。\n");	
	if (!(int)me->query("breakup"))
		return notify_fail("你任督二脉未通,无法使用[" HIR "御剑伏魔" NOR "]\n"); 
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	message_vision(HBWHT "$N贯通蜀山剑派武学，使出了蜀山剑派的绝学之精髓！\n" NOR, me, target);	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1	
	msg = HIW "\n$N" HIW "一声巨喝，聚气入腕，只听破空声一响，手中"
	      + weapon->name() + HIW "携着隐隐风雷之劲向$n" HIW "澎湃贯"
	      "\n出，疾若电闪，势如雷霆。\n" NOR;
	message_vision(msg, me, target);
	ap = me->query("xyzx_sys/level") + me->query_skill("yujianshu", 1) +me->query_skill("fumozhang",1)+ me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	damage = me->query_skill("shushan-force", 1) + me->query_skill("fumozhang",1) + me->query_skill("yujianshu", 1);
	damage = damage/2 + random(damage/2);
	damage = damage*(100-target->query_meridian())/100;
	skill = me->query_skill("fumozhang",1)/10 + me->query_skill("yujianshu", 1)/10;
        me->add_temp("apply/damage", skill);
        me->add_temp("apply/attack", skill); 	
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->add_temp("apply/damage", -skill);
        me->add_temp("apply/attack", -skill); 	
		me->add("neili", -1000);
		me->add("jingli", -1000);
				
	if (random(ap) > dp/3)
	{
		me->add("neili", -1000);
		me->add("jingli", -1000);
		target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);	
		msg =  HIR "$n" HIR "看到$N" HIR "这气拔千钧的一击，竟不知如何招架，登时受了重创！\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		msg = CYN "可是$p" CYN "看破了$P" CYN "的企图，斜跃避开。\n" NOR;
		message_vision(msg, me, target);
		me->add("neili", -300);
	}
	message_vision(HIC"\n$N口中默念御剑口诀，手中长剑顿时间霞光四射，一招「御剑伏魔」直斩$n！\n\n"NOR,me,target);
	if ( random(ap) > dp/3 )
	{    

		damage = (int)me->query_skill("yujianshu", 1)+random((int)me->query("max_qi"))*1/100;
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("qi", damage, me);
		target->receive_wound("qi", damage/2, me);
		me->add("neili", -1000);
		me->add("jingli", -1000);		
		message_vision(HIC"\n$N长啸：伏魔天地间，御剑任逍遥！！！\n\n"NOR,me,target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	} else
	{
		message_vision(HIB"\n$n看清$N招式来处，轻轻一跳，避开了这一剑！！！\n\n"NOR, me, target);
	}
	
	
if (me->query_skill("yujianshu",1)>2000 && me->query_skill("fumozhang",1)>2000)
{
	message_vision( CYN"\n$N手腕晃动如疾风，以砍断三千尺飞流的速度，直逼$n！\n"NOR, me, target);	
	damage = (me->query_skill("sword")+me->query_skill("songhe-sword",1)+me->query("jiali")+target->query_skill("sword"))*2 + random((int)target->query("qi"))*1/100;
	damage = damage/3 + random(damage/3);
	damage = damage*(100-target->query_meridian())/100;
	if ( random(ap) > dp/3 ) 
	{	
		me->add("neili", -1000);
		me->add("jingli", -1000);		
		target->receive_damage("qi", damage, me);
		target->receive_wound("qi", damage/2, me);
		message_vision(CYN"结果$n被$N的「断水无痕」拦腰而过！\n"NOR, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}  
	else 
	{
		message_vision(HIW"但是被$n躲开了。\n"NOR, me, target);
	}
	
	msg =  HIW "你运转内力，仰天一声清啸，剑在空中盘旋了一圈，又飞回了你的手中。！\n" NOR;
	message_vision(msg, me, target);
	damage = (int)me->query_skill("shushan-force", 1) +me->query_skill("fumozhang",1)+ (int)me->query_skill("force", 1) + (int)me->query_skill("sword", 1) + (int)me->query_skill("yujianshu", 1);
	damage = damage/3 + random(damage/3);
	damage = damage*(100-target->query_meridian())/100;
	if (random(ap) > dp/3)
	{
		me->add("neili", -1000);
		me->add("jingli", -1000);
		target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);	
		msg = HIW "\n$N" HIW "手中御剑凌驾如飞，宛若游龙，灵转千变，一道道凌厉剑气疾射而出。\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		msg = HIW "你剑至中途，可怎奈被$n击中风府穴，内息不稳，只好停止御剑。\n" NOR;
		message_vision(msg, me, target);
		me->add("neili", -300);
	}	
}

if (me->query_skill("yujianshu",1)>3000 && me->query_skill("fumozhang",1)>3000)
{
	message_vision(HIB"\n$N眼见不敌，想起了访宁桥上那首诗，心中默念：",me,target);
	message_vision(HIG"\n\n所有的这一切都只有等待来生了......",me,target);
	message_vision(HIB"\n\n$N一念及此，身形与手中长剑化为一体直射$n～～～～～ \n\n"NOR,me,target);	
	if ( random(ap) > dp/3 ) 
	{
		me->add("neili", -1000);
		me->add("jingli", -1000);
		message_vision(HIB"\n\n$n不料$N如此决绝，竟然呆立当场，瞬间一道蓝光已在$n身上当胸穿过！！！\n"NOR, target ,me);
		if ( random(5)==0 ) 
		{
			message_vision(HIR"\n\n半空中传来一声长叹：地绝他也，天绝我也～～～～～ \n\n"NOR,me,target);
//			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人和自己造成了昏迷。\n" NOR);
			target->unconcious(me);
			me->unconcious(target);
			return 1;	//这里其实应该加个return 1的，昏迷之后理应中断PFM
		}
		else
		{
			damage = ap + random(dp);
			damage = damage*(100-target->query_meridian())/100;
			target->receive_damage("qi", damage, me);
			target->receive_wound("qi", damage/2, me);
			message_vision(HIR"\n\n$N长啸：有酒任逍遥，无酒亦逍遥！ \n\n"NOR,me,target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		}
	} else
	{
		message_vision(HIB"\n$n一见情势不妙，拼命向后纵越，竟然在狼狈不堪之际侥幸地躲过了这拼命的一式！！！\n\n"NOR, me, target);
	}	
}

if (me->query_skill("yujianshu",1)>4000 && me->query_skill("fumozhang",1)>4000)
{
		msg = HIR "御剑乘风来，除魔天地间，有酒乐逍遥，无酒我亦颠，一饮尽江河，再饮吞日月，千杯醉不倒，唯我酒剑仙。\n" NOR;
		message_vision(msg, me, target);
		if (me->query("jm/shushan")) damage = (int)me->query_skill("sword", 1) + (int)me->query_skill("force", 1) + (int)me->query_skill("parry", 1) + (int)me->query_skill("fumozhang", 1)*me->query("con",1)*3/2 + (int)me->query_skill("shushan-force", 1)*me->query("con",1)*3/2 + (int)me->query_skill("yujianshu", 1)*me->query("int",1)*3/2 + (int)me->query_skill("songhe-sword", 1)*me->query("int",1)/2;
		else damage = (int)me->query_skill("sword", 1) + (int)me->query_skill("force", 1) + (int)me->query_skill("parry", 1) + (int)me->query_skill("fumozhang", 1)*me->query("con",1) + (int)me->query_skill("shushan-force", 1)*me->query("con",1) + (int)me->query_skill("yujianshu", 1)*me->query("int",1);
		
	if (random(ap) > dp/3)
	{
		damage = damage/3 + random(damage/3) + target->query("qi")*4/100;
		damage = damage*(100-target->query_meridian())/100;
		me->add("neili", -2000);
		me->add("jingli", -2000);
		target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);
		target->add("neili",-damage/2);
		msg= HIR "只听「嗤啦」一声，" HIW "无形剑气" NOR +HIR "竟在$n" HIR "上身刺出一个血洞，数股血柱疾射而出！\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		damage = damage/9 + random(damage/9) + target->query("qi")*1/100;
		damage = damage*(100-target->query_meridian())/100;
		target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);
		me->receive_damage("qi",damage,target);
		me->receive_wound("qi",damage/3,target);
		me->add("neili", -1000);
		me->add("jingli", -1000);
		msg = CYN "可是$N" CYN "看破了$n" CYN "的企图，斜跃避开，反手劈出一掌。\n" NOR;
		message_vision(msg, target, me, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
		msg = RED "然而$N" CYN "以意御剑，剑身再次急转而回，$n见摆脱不了，只好硬拼一招。\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法	
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"，对自己气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);
	}
}
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}