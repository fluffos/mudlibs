int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练擒拿手必须空手。\n");
	return 1;
}


mapping query_action(object me, object weapon)
{
	object victim;
	string bw;
        
	if( !victim && me->is_fighting() ) victim = offensive_target(me);    
	bw = buwei[random(sizeof(buwei))];
	if (me && victim)
	{
        if ((int) me->query_skill("qinnashou",1) > 1000 
		&& me->query("neili") > 300
        && random(me->query("xyzx_sys/level")) > victim->query("xyzx_sys/level")/3                   
		&& random(7)==0
        && me->query_skill_mapped("parry") == "qinnashou"
        && me->query_skill_mapped("unarmed") == "qinnashou"
        && !me->is_busy()
        && !victim->is_busy()
        && !me->query_temp("weapon")) 
		{
                me->add("neili", -50);
                message_vision(HIC"$N用擒拿技斗然间抓住了$n的"+bw+"!\n"NOR,me,victim);
                message_vision(GRN"$n退避不及，被$N擒拿住"+bw+",行动不免迟缓下来。\n"NOR,victim,me);
                if (!victim->is_busy()) victim->start_busy(1);
        }
	}
    return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_skill("qinnashou",1) < 99)
		return notify_fail("此项技能只能大于一百级时能学习。\n");
	if ((int)me->query("jing") < 100)
		return notify_fail("你的精力不够练此武功。\n");
	if ((int)me->query("qi") < 100)
		return notify_fail("你的体力不够练此武功。\n");
	if ((int)me->query("neili") < 100)
		return notify_fail("你的内力不够练此武功。\n");
	me->receive_damage("qi", 50);
	me->receive_damage("jing", 50);
	me->add("neili", -50);
	return 1;
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;
	string name;
	name = buwei[random(sizeof(buwei))];
    ap = me->query_skill("qinnashou",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("qinnashou",1);
	damage2 = (int)me->query_skill("qinnashou",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("qinnashou",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "yijing-force") return 0;
	if (objectp(me->query_temp("weapon")) ) return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIY"$N双手连环出招，$n闪避不及被擒拿住"+name+",咔嚓一声，关键脱臼了！\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，用擒拿技斗然间抓住了$n的"+name+"。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}

}


string perform_action_file(string action)
{
	return __DIR__"qinnashou/" + action;
}