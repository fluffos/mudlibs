// tian.c 天旋地转
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{        
	int skill,damage,busy_time;
	int ap,dp;
	string msg;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("天旋地转只能用在对手身上。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if( target && target->is_busy() )
		return notify_fail("对方现在已经忙的晕头转向了！\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if ( target && target->query_temp("busy_mianyi") )	//冲穴成功后免疫busy，2017.9.29阿飞添加
		return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");		
	if( (int)me->query_skill("cxwx-quan", 1) < 300 )
		return notify_fail("你的痴心妄想拳还不够娴熟，不能使敌人天旋地转。\n");
	if( (int)me->query_skill("wangran-xinfa", 1) < 300 )
		return notify_fail("你的妄然心法不够娴熟，不能使敌人天旋地转。\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的内力不够了。\n");
	if( (int)me->query("max_neili") < 10000 )
		return notify_fail("你的内力修为不足。\n");	
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够了。\n");
	if( (int)me->query("max_jingli") < 10000 )
		return notify_fail("你的精力修为不足。\n");		
//	if ( me->query_skill_mapped("unarmed")!="cxwx-quan" ) 
//		return notify_fail("你没有正确激发该技能！\n");			
//	if ( me->query_skill_mapped("force") != "wangran-xinfa")
//		return notify_fail("你必须激发妄然心法才能使用「天旋地转」！\n"); 	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HIR "$N拳中夹着一股"HIY"罡气"HIR"，一招“"HIB"天旋地转"HIR"”奋力击向$n。\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	
	skill = (int)me->query_skill("cxwx-quan", 1);
	damage = me->query_skill("cxwx-quan", 1);
	damage = damage/2 + random(damage/2);
	damage = damage*(100-target->query_meridian())/100;
	ap = me->query("xyzx_sys/level") + me->query_skill("cxwx-quan", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	busy_time = (30*skill)/(skill+2000);
	if( stringp(target->query("inborn")) && (string)target->query("inborn")==YEL"冷静"NOR) busy_time = (30*skill)/(skill+2000)*7/10;
		if( random(ap)>dp/3)
		{
			target->start_busy(5+busy_time);
            target->receive_damage("qi",damage,me);
			target->receive_wound("qi",damage/2,me);
			tell_object(target, HIY"你陷入忙乱之中，一时无法动弹。\n"NOR);		
            msg =  HIW" 结果$p被$P攻了个正着！\n" NOR;
			message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
        } 
		else 
       {
            msg = MAG "可是$p眼见不妙，早早的躲了开去。\n" NOR;
			message_vision(msg, me, target);
        }
        me->add("neili",-300);
		me->add("jingli",-300);
		me->start_busy(1);
        return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}