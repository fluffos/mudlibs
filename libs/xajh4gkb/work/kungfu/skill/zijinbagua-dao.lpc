int perform_level() { return 300; }  //PFM最低使用级别

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀，才能练刀法。\n");
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力不够练这门刀法，还是先休息休息吧。\n");
  me->receive_damage("qi", 40);
  return 1;
}

string *parry_msg = ({
  "$n使出一招「快意图恩仇」，用手中的$w急削$N的五指。\n",
  "$n左脚踏前一步，一招「春风吹斜柳」，手中的$w从侧面飘向$N之必救。\n",
  "$n手中的$v一抖，挽出一片刀花，一招「晚春怜夕阳」，撒向$N的全身。\n",
  "$n微退一步，手中的$w划出一条圆弧，一招「春眠不知哓」，将$N的全身围住。\n",
});

string *unarmed_parry_msg = ({
  "$n使出一招「快意图恩仇」，用手中的$w急削$N的五指。\n",
  "$n左脚踏前一步，一招「春风吹斜柳」，手中的$w从侧面飘向$N之必救。\n",
  "$n手中的$w一抖，挽出一片刀花，一招「晚春怜夕阳」，撒向$N的全身。\n",
  "$n微退一步，手中的$w划出一条圆弧，一招「春眠不知哓」，将$N的全身围住。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string action) {
  return __DIR__ "zijinbagua-dao/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon;
  weapon = me->query_temp("weapon");
  ap = me->query_skill(
    "zijinbagua-dao",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("zijinbagua-dao", 1);
  damage2 = (int)me->query_skill(
    "zijinbagua-dao",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("zijinbagua-dao", 1) < 100) return 0;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade") return 0;
  //	if ( me->query_skill_mapped("force") != "yijing-force") return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIR "$N脚踏八卦，刀随身走，$n一个不慎，被割了一道血口！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，手中" + weapon->name() + HIG "金光闪闪，刀身一翻，金光耀眼，$n双眼看不清来势，只觉得右臂一痛。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/humiao")) {
    me->add("neili", -100);
    COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), 1);
    COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), 1);
    message_vision(HIM "$N融汇胡家武学精髓，使出胡家刀绝技「夜战八方藏刀式」，身法陡然加快！\n" NOR, me, victim);
    return;
  }
}
