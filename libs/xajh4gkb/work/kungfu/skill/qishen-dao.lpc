int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if ((int)me->query("max_neili") < 100000)
        return notify_fail("你的内力不够。\n");
	if ((int)me->query_skill("blade", 1) < 1000)
        return notify_fail("你的基本刀法火候太浅。\n");
    if (me->query("family/family_name")!="杀手楼")
		return notify_fail("你未加入杀手楼，不能传授楼主高深功夫。\n");	
    if ((int)me->query_skill("wuji-shengong", 1) < 300)
		return notify_fail("你的无极神功火候不够，无法学习本门技能。\n");
	if ((int)me->query_skill("qishen-dao", 1) > 3000)
		return notify_fail("上乘武学只能教到这里了，以后要靠自己勤加修习领悟。\n");		
	if ((int)me->query("str",1) < 30)
		return notify_fail("你的臂力不够，难以练习泣神刀。\n");  
	if ((int)me->query("score",1) < 10000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	if (random(10)==1) me->add("score",-10);	
        return 1;
}
mapping query_action(object me, object weapon)
{
	int zhaoshu, level;
	zhaoshu = sizeof(action)-1;
	level = (int) me->query_skill("qishen-dao",1);
	if (level < 600 ) zhaoshu--;
	if (level < 500 ) zhaoshu--;
	if (level < 400 ) zhaoshu--; 
	if (level < 300 ) zhaoshu--;
	if (level < 200 ) zhaoshu--;
	if (level < 100 ) zhaoshu--;
	return action[random(zhaoshu)];
}
int practice_skill(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");
	if (me->query("family/family_name")!="杀手楼")
		return notify_fail("你未加入杀手楼，不能练习楼主高深功夫。\n");					
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够练泣神刀。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");		
	me->receive_damage("qi", 40);
	return 1;
}
string perform_action_file(string action)
{
	return __DIR__"qishen-dao/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;
	object weapon;
	weapon = me->query_temp("weapon");
    ap = me->query_skill("qishen-dao",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("qishen-dao",1);
	damage2 = (int)me->query_skill("qishen-dao",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("wuji-shengong",1) < 100 || me->query_skill("qishen-dao",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "wuji-shengong") return 0;
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		message_vision(HIR "只听$n一声鬼哭狼嚎，被$N的无极神刀击中三阴穴！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		if (!victim->is_busy()) victim->start_busy(1);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，一股死神的气息迎风而起，诡异一斩，$n似乎感觉到什么离体而去。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/shashou") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIM"$N融汇杀手楼武功精髓，招招致命，$n顿时陷入生死两忙之地。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}
