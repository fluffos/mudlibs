inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }
//2019-1-1阿飞新规划，技能代码完善
//string valid_combine() { return "juehu-shou"; }		//互备技能
string skill_pinji() {return "下乘";}				//品级区分：上乘、中乘、下乘
string skill_xingbie() {return "通用";}				//性别区分：男性、女性、无性、通用
string skill_zhengxie() {return "中立";}			//正邪区分：正道、邪道、中立
string skill_menpai() {return "凌霄城";}				//门派区分：门派，江湖
string skill_yinyang() {return "阴";}				//阴阳区分：阳、阴、中性
string skill_zhenying() {return "中立";}			//阵营区分：正派、邪派、中立、通用
//int damage_damage() {return 60;}	//外伤系数
//int force_damage() {return 60;}		//内伤系数
int qi_heal() {return 43;}		//内功疗气系数
int jing_heal() {return 46;}		//内功疗精系数
int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
	mapping skl;
	string *sname;
    int i;	
    skl = me->query_skills();
    sname = keys(skl);
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if ( me->query("gender") == "无性" && me->query_skill("bingxue-xinfa",1) > 49) 	
        return notify_fail("你无根无性，阴阳不调，难以领会高深的冰雪心法。\n");	
    if ((int)me->query_skill("force", 1) < 100)
        return notify_fail("你的基本内功火候还不够，还不能学习冰雪心法。\n");
    if( (int)me->query("max_neili") < 10000 )
        return notify_fail("你的内力不够，没有办法修炼冰雪心法。\n"); 
    if( (int)me->query("con",1) < 25 )
        return notify_fail("以你这体质恐怕不适合修习这种内功吧。\n"); 	
    if (me->query("family/family_name")!="凌霄城")
		return notify_fail("你没住在雪山之巅，无法领悟冰雪的境界。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	
        for (i=0;i<sizeof(skl);i++){	
            if (sname[i]=="bingxue-xinfa") continue;	
            if (sname[i]=="yijing-force") continue;	
			if (sname[i]=="xixing-dafa") continue;
        if( SKILL_D(sname[i])->valid_enable("force") )	
            return notify_fail("你不先散了别派内功，怎能学冰雪心法？！\n");
}
        return 1;
}

int practice_skill(object me)
{
	return notify_fail("冰雪心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"bingxue-xinfa/" + func;
}

mapping exercise_msg(object me)
{
  return ([
    "status_msg" : "脸上寒气浮现，隐隐有微光流动。" NOR,
    "start_my_msg" : "手捏剑诀，将冰雪真气提起在体内慢慢转动。\n",
    "start_other_msg" : me->name()+"摆了个盘膝打坐的姿势，周围顿时急速冷却下来。\n",
    "heal_my_msg" : "运起冰雪心法，开始运气疗伤。\n"NOR,
    "heal_other_msg" :  me->name()+"将冰雪之气集于伤处，运功疗伤，顿时一层薄冰笼罩在"+me->name()+"面上。\n"NOR,	
	"halt_msg" :  "长长的吸了一口气，周围雾气消散，站了起来。\n",
    "end_my_msg" : "将冰雪心法按周天之势搬运完毕，精神抖擞。\n"NOR,
    "end_other_msg" : "只见"+me->name()+"睁开双眼，慢慢站起，似乎由内而外散发出冰寒之气。\n"NOR,
    "hover_my_msg" : "慢慢吐气，身上笼罩的薄冰渐渐融化为蒸气，周围空气也渐渐升温，你收回了冰雪真气。\n",
    "hover_other_msg" : me->name()+"慢慢吐气，站了起来，身上笼罩的薄冰渐渐融化为蒸气，周围空气也渐渐升温。\n",
    ]);
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage1,damage2,damage,liannum;
	damage1 = (int)me->query_skill("bingxue-xinfa",1);
	damage2 = (int)me->query_skill("bingxue-xinfa",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	ap = me->query_skill("bingxue-xinfa",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if ( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
	if ( me->query_skill("bingxue-xinfa",1) < 100) return 0;
	if ( me->query_skill_mapped("force") != "bingxue-xinfa") return 0;
	if ( random(ap) > dp/3 && random(7)==1 && me->query("jiali") > 0) 
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100 );
		victim->apply_condition("ice_poison", me->query_skill("bingxue-xinfa",1)/100 + victim->query_condition("ice_poison"));
		message_vision(HIB "$N发挥出"+HIR+"冰雪心法"NOR HIB"的寒冰诀,摧毁了$n的真元！！！！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		victim->apply_condition("ice_poison", me->query_skill("bingxue-xinfa",1)/100 + victim->query_condition("ice_poison"));
		message_vision(HIR "$N冰心玉洁，发挥出"+me->query("cognize")+HIR"的力量，真气似寒非寒。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/lingxiao") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		victim->apply_condition("ice_poison", me->query_skill("bingxue-xinfa",1)/100 + victim->query_condition("ice_poison"));
		message_vision(HIR "$N融汇凌霄城内功之精髓，顿时四周冰雪飞舞。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}