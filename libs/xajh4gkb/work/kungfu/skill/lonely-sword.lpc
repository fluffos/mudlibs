int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}
//2019-1-1阿飞新规划，技能代码完善
string valid_combine() { return "lonely-sword"; }  //互备技能
string skill_pinji() { return "上乘"; }    //品级区分：上乘、中乘、下乘
string skill_xingbie() { return "通用"; }    //性别区分：男性、女性、无性、通用
string skill_zhengxie() { return "中立"; }   //正邪区分：正道、邪道、中立
string skill_menpai() { return "江湖"; }    //门派区分：门派，江湖
string skill_yinyang() { return "中性"; }    //阴阳区分：阳、阴、中性
string skill_zhenying() { return "通用"; }   //阵营区分：正派、邪派、中立、通用
int damage_damage() { return 95; }  //外伤系数
int force_damage() { return 55; }  //内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() { return 100; }  //自练级别
int practice_add() { return 100; }  //自练效率
int perform_level() { return 300; }  //PFM最低使用级别

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

string query_parry_msg(string limb) {
  return parry_msg[random(sizeof(parry_msg))];
}

int valid_learn(object me) {
  object ob;
  mapping myfam;
  myfam = (mapping)me->query("family");

  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (!myfam || myfam["family_name"] != "圣剑魔宫" || myfam["master_id"] != "a fei")
    return notify_fail("独孤九剑只有向圣剑魔宫阿飞学习。\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力不够，没有办法练独孤九剑。\n");
  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  if ((int)me->query("int", 1) < 30)
    return notify_fail("以你的悟性难以领悟独孤剑意。\n");
  if ((int)me->query_skill("lonely-sword", 1) > 300)
    return notify_fail("这套剑法我就教到这儿，以后就要靠你自己练了。\n");
  if ((int)me->query_skill("sword", 1) < 5000)
    return notify_fail("你的基础剑法不够深厚，无法支持独孤剑意。\n");
  if ((int)me->query("score", 1) < 10000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(10) == 1) me->add("score", -10);
  return 1;
}

int practice_skill(object me) {
  return notify_fail("独孤九剑只能通过" + (order[random(13)]) + "「问魂式」" NOR "来演练。\n");
}
string perform_action_file(string action) {
  return __DIR__ "lonely-sword/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon1, weapon2;
  weapon1 = me->query_temp("weapon");
  weapon2 = victim->query_temp("weapon");
  ap = me->query_skill(
    "lonely-sword",
    1
  ) * me->query(
    "int",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * victim->query(
    "dex",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("lonely-sword", 1) + (int)me->query_skill("sword", 1) / 10;
  damage2 = (int)me->query_skill(
    "lonely-sword",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill("lonely-sword", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "yijing-force") return 0;
  if (!objectp(weapon1 = me->query_temp("weapon")) || (string)weapon1->query("skill_type") != "sword") return 0;

  if (random(ap) > dp / 3 && me->query("jiali") > 0 && random(7) == 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(2);
    message_vision(
      HIC "$N眼见避无可避，只好提剑乱刺一通，居然恰好刺中$n的破绽，$n顿时手足无措，不知如何是好！" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && me->query("jiali") > 0 && random(7) == 1) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    victim->map_skill("dodge");  //下特殊轻功
    message_vision(
      HIC "$N突然举剑一刺，剑招随便无章，却莫明奇妙地突破了$n的攻势，大出$n意料！$n大吃一惊，竟然忘了闪避！" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    victim->add("neili", -damage2);
    victim->map_skill("parry");  //下特殊招架
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，举剑反攻，后发先至地刺向$n，不仅把$n招术封死，更进一步发出攻击！$n难以看清剑招来势,竟然忘了招架！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/dugu")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    victim->map_skill("unarmed");  //下特殊拳脚
    message_vision(
      HIC "$N提剑回刺，落点正是$n的破绽，$n不得不撤招严守，顿时手忙脚乱，慌乱不堪，竟然忘了使用拳脚！" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && me->query("jiali") > 0 && random(7) == 4) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    if (objectp(weapon2 = me->query_temp("weapon"))) victim->map_skill(weapon2->query("skill_type"));  //下特殊兵器
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIC "$N一转剑势，剑招源源而出，连续攻向$n周身大穴！$n只觉得气海穴一痛，浑身真气一泻而出！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }

}


//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  int j, ap, dp, damage1, damage2;
  object weapon;
  weapon = me->query_temp("weapon");
  ap = me->query_skill(
    "dugu-jiujian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "unarmed",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = me->query_skill("dugu-jiujian", 1);
  damage2 = me->query_skill(
    "dugu-jiujian",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (me->query_skill("dugu-jiujian", 1) < 100) return damage;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return damage;
  if (random(ap) > dp / 4 && random(8) == 1) {
    j = -(damage + random(damage));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    message_vision(
      HIW "$N身子摇摇欲坠，行动不便，知道这一招无可躲避，当即挺剑刺出，后发先至，噗的一声刺向$n的咽喉。\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    j = -damage / 2;
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "剑意，但见$n甫一出招，就窥破$n破绽，提剑平端，$n不及变招就撞在$N剑上。\n" NOR,
      me,
      ob,
      damage2,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/dugu")) {
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    message_vision(
      HIW "$N领悟独孤剑意，出招于$n未出之前，$n连变数招难以出手，真气顿时错乱，一口鲜血喷出。\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "气血反伤" NOR
    );
    return j;
  }
}
