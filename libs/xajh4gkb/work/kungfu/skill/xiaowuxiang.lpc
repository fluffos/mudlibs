  return ([
    "status_msg": "口中禅唱入耳，宝象庄严。\n",
    "start_my_msg": "盘膝坐下，双手合十，口诵佛祖真言，周身佛光隐现。\n",
    "start_other_msg": me->name() + "盘膝坐下，双手合十，口诵佛祖真言，周身佛光隐现。\n",
    "heal_my_msg": "口吐佛祖真言，缭绕不散，周身佛光隐现，背后如来法相渐渐清晰。\n",
    "heal_other_msg": me->name() + "口吐佛祖真言，缭绕不散，周身佛光隐现，背后如来法相渐渐清晰。\n",
    "halt_msg": "长出一口气，将内息急速退了回去，站了起来。\n",
    "end_my_msg": "睁开双眼，缓缓站起，周围佛光汇聚丹田。\n",
    "end_other_msg": me->name() + "周身佛光不断汇聚丹田，待法相入体，" + me->name() + "睁开双眼，缓缓站起。\n",
    "hover_my_msg": "佛祖真言铮铮入耳，佛光逐渐清晰。过了良久，如来法相入体，佛光也渐渐淡了。\n",
    "hover_other_msg": me->name() + "只觉佛祖真言铮铮入耳，佛光逐渐清晰。过了良久，如来法相入体，佛光也渐渐淡了。\n",
  ]);
}
