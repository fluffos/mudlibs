int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query("family/family_name")!="梅庄")
		return notify_fail("你不是梅庄弟子，不能传授给你。\n");	
	if ((int)me->query_skill("wuzheng-xinfa", 1) < 100)
		return notify_fail("你的无争心法火候太浅。\n");
    if (me->query_skill("dodge", 1) <=me->query_skill("yaoming-dodge", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
    return 1;
}
string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query("family/family_name")!="梅庄")
		return notify_fail("你不是梅庄弟子，不能传授给你。\n");		
    if( (int)me->query("qi") < 60 )
        return notify_fail("你的体力太差了，不能练杳冥身法。\n");
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
    me->receive_damage("qi", 60);
    return 1;
}


string perform_action_file(string action)
{
    return __DIR__"yaoming-dodge/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage2;

	ap = me->query_skill("yaoming-dodge", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("sword",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage2 = me->query_skill("yaoming-dodge", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("wuzheng-xinfa",1) < 300 || me->query_skill("yaoming-dodge", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="wuzheng-xinfa" ) return damage;
	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIC"$N身法突然加快，登时幻化出千条人影！$n的招式都击在了影子身上！\n"NOR;
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，身似闪电，人如拓弦箭矢，直刺$n。\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/meizhuang") )
	{
		j = -(damage+random(damage));
		me->add("neili", -100 );
		if (!ob->is_busy()) ob->start_busy(2);
		message_vision(HIB"$N融汇梅庄武学精髓，身如旋风，不见动作，闪至$n身后，$n急忙转身，结果手忙脚乱！！\n"NOR, me, ob);
		return j;
	}
}
