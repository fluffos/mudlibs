// nuoyi.c 乾坤大挪移大法
// by King 97.05
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int i, damage, ap, dp, count, extra;
  string msg;
  object weapon;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("乾坤大挪移只能对战斗中的对手使用。\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("乾坤大挪移只能空手使用。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query_skill("qiankundanuoyi", 1) < 500)
    return notify_fail("你的乾坤大挪移不够高，小心走火入魔！\n");
  if ((int)me->query_skill(
    "shenghuo-shengong",
    1
  ) < 300 && (int)me->query_skill("jiuyang-shengong", 1) < 300)
    return notify_fail("似乎。。。。内功。。。。！\n");
  //	if (me->query_skill_mapped("force") != "shenghuo-shengong" && me->query_skill_mapped("force") != "jiuyang-shengong")
  //		return notify_fail("没有内功支持就想用大挪移，我看你还是去搬砖吧。\n");	
  if (me->query_skill_mapped("parry") != "qiankundanuoyi")
    return notify_fail("乾坤大挪移只能在招架上使用 。\n");
  if (objectp(weapon = target->query_temp("weapon")) && (string)weapon->query("skill_type") == "throwing")
    return notify_fail("对方使用暗器，似乎挪移不了吧。\n");
  if ((int)me->query("neili", 1) < (int)me->query_skill("qiankundanuoyi", 1) * 4)
    return notify_fail("你现在内力太弱，不能使用乾坤大挪移大法。\n");
  if ((int)me->query("jingli", 1) < (int)me->query_skill("qiankundanuoyi", 1) * 4)
    return notify_fail("你现在内力太弱，不能使用乾坤大挪移大法。\n");
  if (me->is_busy())
    return notify_fail("你的动作还没有完成，不能发功。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  ap = (int)me->query_skill("qiankundanuoyi", 1) + (int)me->query_skill("parry", 1);
  dp = (int)target->query_skill("parry", 1);
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  extra = (int)me->query_skill("qiankundanuoyi", 1) / 10;
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1	

  message_vision(CYN "$N默运神功，使出乾坤挪移大法，试图将$n的内力全数反击回去！。\n" NOR, me, target);
  if (random(me->query("neili", 1)) > target->query("neili", 1) / 3) {
    damage = (int)me->query_skill(
      "qiankundanuoyi",
      1
    ) * 5 + target->query_str() / 100 + target->query("jiali");
    damage = damage / 2 + random(damage / 2);
    damage = damage * (100 - target->query_meridian()) / 100;
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 3, me);
    me->add("neili", -1000);
    if (damage < 1000)
      msg = HIY "结果$n受到$N的内力反震，闷哼一声。\n" NOR;
    else if (damage < 10000)
      msg = HIY "结果$n被$N以内力反震，「嘿」地一声退了两步。\n" NOR;
    else if (damage < 100000)
      msg = RED "结果$n被$N以内力一震，胸口有如受到一记重锤，连退了五六步！\n" NOR;
    else
      msg = HIR "结果$n被$N的内力一震，眼前一黑，象一捆稻草一样飞出去好几丈远！\n" NOR;
    message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/3 +"。\n" NOR);               

  } else {
    msg = CYN "可是$n内力深厚，丝毫不为所动。\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -100);
  }

  message_vision(BLU "$N暗运乾坤大挪移「挪移」诀，企图要把对方下一招的反转回去！。\n" NOR, me, target);
  if (random(ap) > dp / 3) {
    message_vision(HIR "\n" + target->name() + "忽然如中魔一般，招招击向自己！\n" NOR, me, target);
    count = (int)me->query_skill("qiankundanuoyi", 1) / 600;
    if (count < 1) count = 1;
    if (count > 6) count = 6;
    for (i = 0; i < count; i++) {
      target->add_temp("apply/parry", -extra * 5);
      target->add_temp("apply/dodge", -extra * 5);
      msg = CYN "$n身不由己，一招击向自己！\n" NOR;
      COMBAT_D->do_attack(target, target, target->query_temp("weapon"), TYPE_REGULAR, msg);
      target->add_temp("apply/parry", extra * 5);
      target->add_temp("apply/dodge", extra * 5);
      me->add("neili", -100);
      me->add("jingli", -100);
    }
  } else {
    message_vision(CYN "\n" + target->name() + "定神一看，原来是" + me->name() + "在捣鬼！\n" NOR, me, target);
    message_vision(
      HIW "\n" + target->name() + "经验老到，将计就计！" + me->name() + "不知就里，一招攻向自己。\n" NOR,
      me,
      target
    );
    me->add_temp("apply/parry", -extra * 10);
    me->add_temp("apply/dodge", -extra * 10);
    COMBAT_D->do_attack(me, me, me->query_temp("weapon"));
    me->add_temp("apply/parry", extra * 10);
    me->add_temp("apply/dodge", extra * 10);
  }
  me->start_busy(1);
  return 1;
}


void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
