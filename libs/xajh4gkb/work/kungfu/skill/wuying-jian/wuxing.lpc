// hama.c 少林无影剑

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

#include "/kungfu/skill/eff_msg.h";

int perform(object me, object target)
{
	int damage, flag,ap,dp,mapforce,extra;
	string msg,force_skill;
	object weapon;
	flag = 1;
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) || !living(target) )
		return notify_fail("破体无形剑只能对战斗中的对手使用。\n");
	if( (int)me->query_skill("wuying-jian", 1) < 1000 )
		return notify_fail("你的少林无影剑还不够熟练，不能使用破体无形剑对敌！\n");
	if( (int)me->query_skill("banruo-zhang", 1) < 1000 )
		return notify_fail("你的般若掌还不够熟练，不能使用破体剑气对敌！\n");	
	if( (int)me->query_skill("jingang-quan", 1) < 1000 )
		return notify_fail("你的大力金刚拳还不够熟练，不能使用破体剑气对敌！\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail(RED"装备剑才能使用「破体无形剑」!\n"NOR);
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
    if ((int)me->query_skill("hunyuan-yiqi",1) < 1000 && (int)me->query_skill("yijinjing",1) < 1000 )
        return  notify_fail("你佛门内功修为不够，不能使用这一绝技!\n");
  	if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi") 
		return notify_fail("你未使用佛门内功, 不能使用这一绝技 !\n"); 
	if (me->query_skill_mapped("sword") != "wuying-jian")
		return notify_fail("你没正确激发该技能 。\n");
	if( (int)me->query("max_neili") < 1000000 )
		return notify_fail("你现在内力不足，使不出少林无影剑的绝招！\n");
	if( (int)me->query("neili") < 10000 )
		return notify_fail("你现在内力不足，使不出少林无影剑的绝招！\n");
	if ((int)me->query("max_jingli") < 300000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你的精力不够。\n");	
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用[" HIR "破体无形剑" NOR "]\n"NOR); 
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
			
	force_skill=me->query_skill_mapped("force");
	mapforce = (int)me->query_skill(force_skill, 1);	
	if (me->query_skill_mapped("force") == "yijing-force" ) flag = 1;
	if (me->query_skill_mapped("force") == "hunyuan-yiqi" ) flag = 2;
	if (me->query_skill_mapped("force") == "damo-force" ) flag = 3;	
	if (me->query_skill_mapped("force") == "yijinjing" ) flag = 4;
	
	message_vision(HBWHT "$N贯通少林派武学，使出了少林派的绝学之精髓！\n" NOR, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1
	
	ap = me->query("xyzx_sys/level") + me->query_skill("wuying-jian", 1) +me->query_skill("banruo-zhang", 1)+ me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	extra = me->query_skill("wuying-jian", 1)/10 +me->query_skill("banruo-zhang", 1)/10 + me->query_skill("jingang-quan", 1)/10;
	msg = RED "\n$N扔掉手上的武嚣，喃喃说道：放下屠刀，立地成佛！顿时全身破体无形剑气直逼$n而去！\n"NOR;
	message_vision(msg, me, target);
	weapon->unequip();
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	weapon->wield();
	
	msg = HIG "$N身行突变，瞬间犹如分出无数身影闪电般的向$n攻去！\n"NOR;
	message_vision(msg, me, target);	
	msg = HIR"来字决！\n"NOR;
	message_vision(msg, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
	msg = HIY"去字决！\n"NOR;
	message_vision(msg, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
	msg = HIG"若字决！\n"NOR;
	message_vision(msg, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
	msg = HIB"无字决！\n"NOR;
	message_vision(msg, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
	msg = HIW"形字决！\n"NOR;
	message_vision(msg, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
	me->add("neili", -1000);
	me->add("jingli", -1000);	
	
	if (random(ap)>dp/3)
	{
		me->add("neili", -1000);
		me->add("jingli", -1000);
		damage = (int)me->query_skill("wuying-jian", 1)*flag +(int)me->query_skill("banruo-zhang", 1)*flag;
		damage = damage/3 + random(damage/3);
		damage = damage*(100-target->query_meridian())/100;
//		if(me->query("neili") > target->query("neili")*2 ) damage += random(damage);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		msg = HIY "\n一声轻响，好似凉风吹过，忽然间$n血冒三丈，已是被剑气所伤！\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		me->add("neili", -500);
		msg = HIY"你但觉一股微风扑面而来，风势虽然不劲，然已逼得自己呼吸不畅，知道不妙，连忙跃开数尺。\n" NOR;
		message_vision(msg, me, target);
	}



if (me->query_skill("wuying-jian", 1) > 2000 && me->query_skill("banruo-zhang", 1) > 2000 && me->query_skill("jingang-quan", 1) > 2000)
{
	msg = HIC "\n$N左掌劲力未消，右掌也跟着推出，功力相叠，「破体无形剑」掌风排山倒海般涌向$n！\n"NOR;
	message_vision(msg, me, target);
		damage = (int)me->query_skill("wuying-jian", 1)*flag +(int)me->query_skill("jingang-quan", 1)*flag+ (int)me->query_skill("banruo-zhang", 1)*flag+mapforce*flag + (int)me->query_skill("unarmed",1)+ (int)me->query_skill("force",1) + (int)me->query_skill("sword",1) ;
		damage = damage/3 + random(damage/3);
		damage = damage*(100-target->query_meridian())/100;
		weapon->unequip();
        me->add_temp("apply/attack", extra);
		me->add_temp("apply/damage", extra);	
		msg = HIB "破体无形剑！\n"NOR;
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
		msg = HIC "罗汉般若掌！\n"NOR;
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
		msg = HIM "大力金刚拳！\n"NOR;
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
        me->add_temp("apply/attack", -extra);
		me->add_temp("apply/damage", -extra);
		weapon->wield();	
		me->add("neili", -1000);
		me->add("jingli", -1000);	
	if (random(ap)>dp/3)
	{
		me->add("neili", -2000);
		me->add("jingli", -2000);
//		if(me->query("neili") > target->query("neili")*2 ) damage += random(damage);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		msg = HIY "\n一声轻响，好似凉风吹过，忽然间$n血冒三丈，已是被剑气所伤！\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		me->add("neili", -500);
		msg =HIY"你喘息未定，又觉一股劲风扑面而来，连忙跃开数尺，狼狈地避开。\n" NOR;
		message_vision(msg, me, target);
	}
}


if (me->query_skill("wuying-jian", 1) > 3000 && me->query_skill("banruo-zhang", 1) > 3000 && me->query_skill("jingang-quan", 1) > 3000)
{
	msg = HIG "\n$N微微一笑，双掌相并向前推出，看不出有什么力量，但$n连同身前方圆三丈全在「破体无形剑」劲力笼罩之下！\n"NOR;
	message_vision(msg, me, target);
		if (me->query("jm/shaolin")) damage = me->query_skill("jingang-quan", 1)*me->query("str",1)*3/2 + me->query_skill("wuying-jian", 1)*me->query("con",1)*3/2 +me->query_skill("banruo-zhang", 1)*me->query("str",1)*3/2+mapforce*me->query("con",1)*3/2+ me->query_skill("sword",1)+ me->query_skill("unarmed",1)+me->query_skill("force",1)+(int)me->query_skill("wuying-jian", 1)*flag +(int)me->query_skill("jingang-quan", 1)*flag+ (int)me->query_skill("banruo-zhang", 1)*flag+mapforce*flag;
		else damage = me->query_skill("jingang-quan", 1)*me->query("str",1) + me->query_skill("wuying-jian", 1)*me->query("con",1) +me->query_skill("banruo-zhang", 1)*me->query("str",1)+mapforce*me->query("con",1)+ me->query_skill("sword",1)+ me->query_skill("unarmed",1)+me->query_skill("force",1)+(int)me->query_skill("wuying-jian", 1)*flag +(int)me->query_skill("jingang-quan", 1)*flag+ (int)me->query_skill("banruo-zhang", 1)*flag+mapforce*flag;
		
	if (random(ap)>dp/3)
	{
		damage = damage/3 + random(damage/3) + target->query("qi")*6/100;
		damage = damage*(100-target->query_meridian())/100;
		me->add("neili", -3000);
		me->add("jingli", -3000);
//		if(me->query("neili") > target->query("neili")*2 ) damage += random(damage);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		msg = HIY "\n一声轻响，好似凉风吹过，忽然间$n血冒三丈，已是被剑气所伤！\n"NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		damage = damage/9 + random(damage/9) + target->query("qi")*2/100;
		damage = damage*(100-target->query_meridian())/100;
		me->add("neili", -500);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		msg = HIY"你用尽全身力量向右一纵一滚，摇摇欲倒地站了起来，但总算躲开了这致命的一击！\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);
	}
}

	me->start_busy(1);	
	return 1;
}


void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}
