// 定魂 子母针特殊技

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	string msg;
	int skill,ap,dp,neili_wound,damage,busy_time;
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「子母连环针」只能对战斗中的对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing")
		return notify_fail("你使用的武器不对。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if( me->is_busy() )
		return notify_fail("你现在正忙着呢，哪有空运功？\n");
	if( target && target->is_busy() )
		return notify_fail(target->name() + "已经神志恍惚，放胆攻击吧.\n");
	if ( target && target->query_temp("busy_mianyi") )	//冲穴成功后免疫busy，2017.9.29阿飞添加
		return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
	if( (int)me->query_skill("zimu-zhen", 1) < 500 )
		return notify_fail("你的子母针法不够娴熟，不会使用「子母连环针」。\n");
	if( me->query_skill("biyun-xinfa",1) < 500 )
		return notify_fail("你的碧云心法不够纯熟, 不能使用「子母连环针」！\n");	
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");		
    if( (int)me->query("neili") < 1000 )
        return notify_fail("你的真气不够。\n");	
//	if ( me->query_skill_mapped("force") != "biyun-xinfa" )
//		return notify_fail("你不使用本门内功，如何能使用本门绝技！\n");	
//	if (me->query_skill_mapped("throwing") != "zimu-zhen")
//		return notify_fail("你没正确激发该技能 。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	skill = (int)me->query_skill("zimu-zhen", 1);
	ap = me->query("xyzx_sys/level") + me->query_skill("zimu-zhen", 1) + me->query_skill("throwing") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	busy_time = (30*skill)/(skill+2000);
	if( stringp(target->query("inborn")) && (string)target->query("inborn")==YEL"冷静"NOR) busy_time = (30*skill)/(skill+2000)*7/10;
	msg = HIG "$N双目突然泛过怪异绿光,中指在不易察觉间微微一动,一点银星悄无声息打向$n眉心,另一点暗光无声无息打向$n丹田。\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	msg = HIG "$N中指微微一动，一只「定魂针」悄无声息打向$n眉心。\n"NOR;
	message_vision(msg, me, target);	
	if( random(ap) > dp/3 )
	{
		me->add("neili",-300);
		me->add("jingli",-300);
		msg = HIR " 结果$p被$P的「定魂针」打个正着，瞬间神志开始迷糊起来！\n" NOR;
		message_vision(msg, me, target);
		target->start_busy( 5+busy_time );
		tell_object(target, HIY"你陷入忙乱之中，一时无法动弹。\n"NOR);
	}
	else
	{
		msg = "可是$p在千钧一发之间闪身躲过了这一击。\n" NOR;
		message_vision(msg, me, target);
	}

	msg = HIY "$N并指入刀，指缝间夹着三枚暗器,潜运内力，一式「破气针」，直奔$n的上、中、下丹田打去。\n";
	message_vision(msg, me, target);
	if( random(ap) > dp/3 )
	{
		me->add("neili",-300);
		me->add("jingli",-300);
		neili_wound = 500 + skill*2 + random(skill*10) + me->query("jiali")*5;
		damage = neili_wound/3;
		damage = damage*(100-target->query_meridian())/100;
		target->add("neili", -neili_wound);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		msg = "$N「破气针」正中目标, $n顿时觉得丹田上一阵刺痛，\n";
		msg += "全身真气狂泄而出！\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);

	}
	else
	{
		if(userp(me)) me->add("neili",-100);
		msg = "可是$n瞬间反应过来，腾挪跳跃，躲过了这次重创。\n"NOR;
		message_vision(msg, me, target);
	}
	
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}