int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练参合指必须空手。\n");
    if (me->query("family/family_name")!="姑苏慕容")
		return notify_fail("你不是慕容世家的弟子，无法领悟本门技能的精髓。\n");
	if (!me->query("jm/taohua"))
		return notify_fail(CYN"听闻桃花岛主的弹指神通独步江湖，慕容氏的参合指比之如何？\n"CYN"这位"+RANK_D->query_respect(me)+CYN"要想学慕容家功夫，恐怕需要先研习桃花岛主的独门绝技！\n"NOR);
	if ((int)me->query("family_score")<7)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if ((int)me->query_skill("shenyuan-gong", 1) < 500)
		return notify_fail("你的神元功火候不够，无法学参合指。\n");
	if ((int)me->query_skill("canhe-zhi", 1) > 3000)
		return notify_fail("上乘武学只能教到这里了，以后要靠自己勤加修习领悟。\n");
	if ((int)me->query("int", 1) < 30)
		return notify_fail("你的悟性不够，无法学参合指。\n");
	if ((int)me->query("max_neili") < 100000)
		return notify_fail("你的内力太弱，无法练参合指。\n");
	if ((int)me->query("score",1) < 10000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	if (random(10)==1) me->add("score",-10);
	return 1;
}

string query_skill_name(int level)
{
	int i = sizeof(action);

	while (i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int level,skill;
	level = (int) me->query_skill("canhe-zhi",1);
	skill = (int) me->query_skill("parry",1);
	if (random(10)==1 && me->query("jiali") >= 50 && random(level) > 200 && random(skill)>200)
	{
		return ([
            "action": HIY "$N默运神元神功，指风轻飘飘地点向$n，一股内劲无声无息的绕向$n周身大穴！"NOR,
			"attack":	800,
			"parry":	800,
			"dodge":	800,
			"damage":	800,
			"force":	800,
            "damage_type": "内伤"]);
	}
	if (random(10)==2 && me->query("jiali") >= 50 && random(level) > 200 && random(skill)>200)
	{
		return ([
            "action": HIY "$N指风犀利，似一道无形剑气，将$n笼罩于内！$n只见眼前剑光闪动，茫然不知所措。"NOR,
			"attack":	800,
			"parry":	800,
			"dodge":	800,
			"damage":	800,
			"force":	800,
            "damage_type": "刺伤"]);
	}
	
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}
int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("jingli") < 10000)
		return notify_fail("你的精力太低了。\n");
	if ((int)me->query("neili") < 10000)
		return notify_fail("你的内力不够练参合指。\n");
    if (me->query("family/family_name")!="姑苏慕容")
		return notify_fail("你一个外人，竟敢偷练慕容世家的绝技！\n");	
	if (!me->query("jm/taohua"))
		return notify_fail(CYN"听闻桃花岛主的弹指神通独步江湖，慕容氏的参合指比之如何？\n"CYN"这位"+RANK_D->query_respect(me)+CYN"要想学慕容家功夫，恐怕需要先研习桃花岛主的独门绝技！\n"NOR);
	if ((int)me->query("family_score")<7)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);		
	if ((int)me->query_skill("shenyuan-gong", 1) < 500)
		return notify_fail("你的神元功不够，无法练习参合指。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	me->add("neili", -100);
	me->add("jingli", -100);
	return 1;
}
string perform_action_file(string action)
{
	return __DIR__"canhe-zhi/" + action;
}

mixed hit_ob(object me, object victim,int damage_bonus)
{
	int ap,dp,sp,damage1,damage2,damage,liannum;
	string name;
	
	name = xue_name[random(sizeof(xue_name))];
	damage1 = (int)me->query_skill("canhe-zhi",1);
	damage2 = (int)me->query_skill("canhe-zhi",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	ap = me->query_skill("canhe-zhi",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("force",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	sp = victim->query_skill("unarmed",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if ( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
	if ( me->query_skill("shenyuan-gong",1) < 100 || me->query_skill("canhe-zhi",1) < 100)	 return 0;
//	if ( me->query_skill_mapped("force") != "shenyuan-gong") return 0;
	if (objectp(me->query_temp("weapon"))) return 0;

	if( random(ap)>dp/3 && random(7)==1 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili", -100);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		message_vision(HIY "只听一声惨嚎，一股鲜血从$n被参合指劲气扫中的伤口喷出！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;		
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIR "$N双指急弹，发挥出"+me->query("cognize")+HIR"的力量，连续点向$n的「" HIR + name + HIW "」。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}	
	if (random(7)==3 && random(ap) > sp/3 && me->query("jiali") > 0 && (int)me->query("jm/murong"))
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili", -100 );
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		victim->add("neili", -damage);
		if (victim->query("neili") < 0) victim->set("neili", 0);
		message_vision(HIW "$N悟透慕容世家绝学，指风轻飘飘地点向$n，一股内劲无声无息的绕向$n周身大穴！\n" HIW "$n只觉全身一麻，已被一招点中「" HIR + name + HIW "」！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int j,ap,dp,damage1,damage2;
	ap = (int)me->query_skill("canhe-zhi",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp= (int)ob->query_skill("parry",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1= (int)me->query_skill("canhe-zhi",1);
	damage2= (int)me->query_skill("canhe-zhi",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if (damage <10) damage=10;
    if ( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if ( me->query_skill("shenyuan-gong",1) < 100 || me->query_skill("canhe-zhi",1) < 100) return damage;
//	if ( me->query_skill_mapped("force") != "shenyuan-gong") return damage;
	if (objectp(me->query_temp("weapon"))) return damage;

	if (random(8)==1 && random(ap)>dp/4 )
	{
		msg = HIC"$N凝神运气向$n猛攻快打，使出的招数好似$n的成名绝技，把$n的招数化于无行！\n"NOR;
		j = -damage/2;
		me->add("neili", -100 );
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1)
	{
		msg = HIC"$N发挥出"+me->query("cognize")+HIC"的招式，$n这招莫名其妙的在中途转了方向，直奔自己袭来！"NOR;
		j = -(damage+random(damage));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(msg, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/murong"))
	{
		msg = HIC"$N贯通慕容世家的以彼之道，$n这招莫名其妙的在中途转了方向，直奔自己袭来！"NOR;
		j = -(damage+random(damage));
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );
		message_vision(msg, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}	
}