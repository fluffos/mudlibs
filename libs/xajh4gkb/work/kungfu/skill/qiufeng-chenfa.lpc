int valid_learn(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力不足，没有办法练秋风尘法, 多练些内力再来吧。\n");
  if ((int)me->query_skill("force", 1) < 200)
    return notify_fail("你的基本气功火候太浅。\n");
  if ((int)me->query_skill("yunv-xinfa", 1) < 100 && (int)me->query_skill("yunv-xinjing", 1) < 100)
    return notify_fail("你的玉女心法火候不够，无法学习本门技能。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "whip")
    if (!objectp(weapon = me->query_temp("secondary_weapon")) || (string)weapon->query("skill_type") != "whip")
      return notify_fail("你必须先找一条拂尘才能练尘法。\n");
  if (me->query("family/family_name") != "古墓派")
    return notify_fail("你未加入古墓派，不能学习本门高深功夫。\n");
  if (!me->query("jm/quanzhen"))
    return notify_fail(CYN "我古墓派祖师与全真教重阳真人恩怨纠葛，可惜最终未能修成正果。我古墓弟子都得先去全真门下修行一段时间方可入门。\n" NOR);
  if ((int)me->query("family_score") < 6)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if (me->query_skill("whip", 1) <= me->query_skill("qiufeng-chenfa", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "whip")
    if (!objectp(weapon = me->query_temp("secondary_weapon")) || (string)weapon->query("skill_type") != "whip")
      return notify_fail("你使用的武器不对。\n");
  if (me->query("family/family_name") != "古墓派")
    return notify_fail("你未加入古墓派，不能练习本门高深功夫。\n");
  if (!me->query("jm/quanzhen"))
    return notify_fail(CYN "我古墓派祖师与全真教重阳真人恩怨纠葛，可惜最终未能修成正果。我古墓弟子都得先去全真门下修行一段时间方可入门。\n" NOR);
  if ((int)me->query("family_score") < 6)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练秋风尘法。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 35);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "qiufeng-chenfa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  string msg;
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon1, weapon2;
  weapon1 = me->query_temp("weapon");
  weapon2 = victim->query_temp("weapon");
  ap = me->query_skill(
    "qiufeng-chenfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("qiufeng-chenfa", 1);
  damage2 = (int)me->query_skill(
    "qiufeng-chenfa",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if ((me->query_skill(
    "yunv-xinfa",
    1
  ) < 100 && me->query_skill(
    "yunv-xinjing",
    1
  ) < 100 && me->query_skill(
    "jiuyin-zhenjing",
    1
  ) < 100) || me->query_skill("qiufeng-chenfa", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") == "yunv-xinjing" && me->query_skill_mapped("force") != "jiuyin-zhenjing") return 0;
  if (!objectp(weapon1 = me->query_temp("weapon")) || (string)weapon1->query("skill_type") != "whip") return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIY "$n一个不慎，被" + weapon1->name() + HIY "缠住了脖子，气息不畅，吐了一口鲜血。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，只见$N挥舞" + weapon1->name() + HIG "，如天女散花漫天飞舞，以阴柔之劲缠住了$n的脖子。。。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/gumu")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    msg = HIW "$N融汇古墓派武功精髓，挥舞" + weapon1->name() + HIW "如天女散花，漫天银丝飞舞，" NOR;
    if (objectp(weapon2 = victim->query_temp("weapon"))) {
      msg += HIW "以阴柔之劲缠住了$n的" + weapon2->name() + HIW "！" NOR;
      if (random(10) > 3) {
        msg += HIW "$n气运手臂用力一拽，却无法从" + weapon1->name() + HIW "的缠绕中脱开，手上被割裂了一道口子。\n" NOR;
        victim->receive_damage("qi", damage, me);
        victim->receive_wound("qi", damage / 3, me);
        message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
      } else {
        msg += HIW "$n情急之下只好放弃了手中的" + weapon2->name() + HIW "。\n" NOR;
        weapon2->unequip();
        weapon2->move(environment(me));
        message_vision(msg, me, victim);
      }
    } else {
      msg += HIW "$n一阵迷茫，被鞭稍点中了手腕。\n" NOR;
      victim->receive_damage("qi", damage, me);
      victim->receive_wound("qi", damage / 3, me);
      message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    }
    me->add("neili", -100);
    return;
  }
}
