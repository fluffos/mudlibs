#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#define XUE "「" HIW "漫天飞雪" NOR "」"
inherit F_SSERVER;

int perform(object me, object target)
{
	string msg;
	object weapon;
	int i, count,level;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail(XUE "只能对战斗中的对手使用。\n");
	if( me->is_busy() )
		return notify_fail("( 你上一个动作还没有完成。)\n");
	if (!objectp(weapon = me->query_temp("weapon")) || ((string)weapon->query("skill_type") != "sword" && (string)weapon->query("skill_type") != "blade" ))
		return notify_fail("你所使用的武器不对，难以施展" XUE "。\n");	
	if ( ((string)weapon->query("skill_type") == "sword" && me->query_skill_mapped("sword") != "daojian-guizhen")
		&& ((string)weapon->query("skill_type") != "blade" && me->query_skill_mapped("blade") != "daojian-guizhen"))
		return notify_fail("你没有正确激发刀剑归真，难以施展" XUE "。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if (me->query_skill("daojian-guizhen", 1) < 500)
		return notify_fail("你的剑归真等级不够，难以施展" XUE "。\n");
	if (me->query_skill("lengyue-shengong", 1) < 500)
		return notify_fail("你的冷月神功等级不够，难以施展" XUE "。\n");
//	if (me->query_skill_mapped("force")!="lengyue-shengong") 
//		return notify_fail("你没有使用冷月神功吧！。\n");
	if (me->query("neili") < me->query_skill("daojian-guizhen", 1)*4)
		return notify_fail("你现在的真气不够，难以施展" XUE "。\n");
	if (me->query("max_neili") < 500000)
		return notify_fail("你内力修为不够，难以施展" XUE "。\n");	
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	level = me->query_skill("daojian-guizhen", 1)/15;
	if (me->query_skill_mapped("force") != "lengyue-shengong" ) level -= me->query_skill("daojian-guizhen", 1)/18;	//2018.9.5阿飞改，不使用本门特内则减益
	if ((string)weapon->query("id") == "lengyue baodao" || (string)weapon->query("id") == "chuangwang baodao") level += me->query_skill("daojian-guizhen", 1)/15; //2018.3.25阿飞改，拿特殊武器有加成	
	msg = HIW "$N" HIW "手中" + weapon->name() + HIW "蓦地一抖"
	      "，将「" NOR + WHT "胡家刀法" HIW "」并「" NOR + WHT
	      "苗家剑法" HIW "」连环施出。霎时寒\n光点点，雪花纷飞，犹如夜陨"
	      "划空，铺天盖地罩向$n" HIW "，正是一招「" HIW "漫天飞雪" HIW "」。\n" NOR;
	message_vision(msg, me, target);	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	
	me->add_temp("apply/damage", level);
	me->add_temp("apply/attack", level); 
	me->add_temp("apply/strength", level);	
	count = me->query_skill("daojian-guizhen", 1)/600;
	if(count<1) count=1;
	if (me->query("jm/humiao")) 
	{
		if(count>100+(int)me->query_temp("lianzhao_max_add")*4) count=100+(int)me->query_temp("lianzhao_max_add")*4;
	} else 
	{
		if(count>50+(int)me->query_temp("lianzhao_max_add")*2) count=50+(int)me->query_temp("lianzhao_max_add")*2;
	}	
	
//		me->add_temp("lianzhao", count);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
	for (i = 0; i < count; i++)
	{
		COMBAT_D->do_attack(me, target, weapon, 0);
	}
//	me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记
	me->add("neili", -(200*count));
	me->add_temp("apply/damage", -level);
	me->add_temp("apply/attack", -level); 
	me->add_temp("apply/strength", -level);
	me->start_busy(1);

	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}