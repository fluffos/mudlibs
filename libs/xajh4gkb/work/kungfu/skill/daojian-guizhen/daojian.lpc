// daojian.c 「刀剑合一」
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me)
{
	string msg;
	object weapon;
	int jing_cost,xtint,jineng_exp_add;
	int flag;
	xtint = me->query("int",1);
	jing_cost = me->query_skill("daojian-guizhen",1);

	if( environment(me)->query("no_fight") )
		return notify_fail("这里是是非之地，不可久留，别练功了，快走吧！\n");	
	if( me->is_fighting() )
		return notify_fail("「刀剑合一」不能在战斗中演练。\n");
    if(me->is_busy())
        return notify_fail("你现在正忙着！\n");
	if (!objectp(weapon = me->query_temp("weapon")) || ((string)weapon->query("skill_type") != "blade" && (string)weapon->query("skill_type") != "sword"))
		return notify_fail("你必须先去找一把刀或剑。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if (me->query_temp("apply/shade_vision")) 
		return notify_fail("纳尼！隐身了还想使用刀剑合一？也不怕看不见砍到自己！！。\n"); 		
	if( me->query_skill("daojian-guizhen",1) < 100)
		return notify_fail("你的刀剑归真等级不够, 不能演练「刀剑合一」！\n");
	if( (int)me->query_skill("lengyue-shengong", 1) < 300 )
		return notify_fail("你的冷月神功不够熟练。\n");	
	if( (int)me->query_skill("hujia-dao", 1) < 300 )
		return notify_fail("你的胡家刀法不够熟练。\n");	
	if( (int)me->query_skill("miaojia-jian", 1) < 300 )
		return notify_fail("你的苗家剑法不够熟练。\n");	
	if ( !wizardp(me) && (string)me->query("family/family_name") != "胡苗世家")
		return notify_fail("「刀剑合一」只有胡家或苗家传人才能使用。\n");
//	if ( !wizardp(me) && me->query_skill_mapped("force") != "lengyue-shengong")
//		return notify_fail("不使用本门内功，如何使用本门绝学!\n");
	if (me->query_skill_mapped("blade") != "daojian-guizhen" && me->query_skill_mapped("sword") != "daojian-guizhen")
		return notify_fail("你没使用刀剑归真。\n");
	if ((int)me->query("max_neili")<100000)								
		return notify_fail("你的内力修为不够。\n");
	if ((int)me->query("max_jingli")<100000)								
		return notify_fail("你的精力修为不够。\n");
	if( me->query("neili") < jing_cost )
		return notify_fail("你的内力不够，没有力气演练「刀剑合一」！\n");
	if (me->query_skill("blade",1)<= (int)me->query_skill("daojian-guizhen",1) || me->query_skill("sword",1)<= (int)me->query_skill("daojian-guizhen",1))
		return notify_fail("你的刀法或剑法基础不够，无法通过演练「刀剑合一」提高刀剑归真的技巧！\n");
	if (me->query_skill("hujia-dao",1)<= (int)me->query_skill("daojian-guizhen",1) || me->query_skill("miaojia-jian",1)<= (int)me->query_skill("daojian-guizhen",1))
		return notify_fail("你的胡家刀法或苗家剑法基础不够，无法通过演练「刀剑合一」提高刀剑归真的技巧！\n");
	if (me->query_skill("daojian-guizhen",1)>(me->query("xyzx_sys/level")+300)*2)
		return notify_fail("你的实战能力不够，无法领悟更高深的技巧！\n");
	if( me->query("jingli") < jing_cost )
		return notify_fail("你现在太累了，无法集中精神演练「刀剑合一」！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HIC "$N将手中" + weapon->name() + HIC "一分，使出「刀剑合一」，凌空发出一道剑光，落地又成一道刀芒。\n" + NOR;
	message_vision(msg, me);
	
	if(me->query("xyhy_type")==2) flag = 5/4;	//2016.6.20阿飞改，黄金会员自练速度为1.25倍
	else flag = 1;
	if (me->query_temp("jineng_exp_add")) jineng_exp_add = (int)me->query_temp("jineng_exp_add",1);	//处于技能自练提升状态时
	else jineng_exp_add = 0;	
	me->add("neili", -jing_cost);
    me->add("jingli", -jing_cost);

	me->improve_skill("daojian-guizhen", 100 + (int)me->query_int(1)*(jineng_exp_add+100)/100*xtint*me->query_exp_times()*flag*18/10);
	msg = MAG"$P的「刀剑归真」进步了！\n"NOR;
	me->start_busy(1);
	message_vision(msg, me);
	return 1;
}

