//guizhen.c  刀剑归真

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
#define GUIZHEN "「" HIR "刀剑归真" NOR "」"
inherit F_SSERVER;

int perform(object me, object target)
{
	string  msg;
	object weapon;
	int ap, dp, damage,level;


	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail(GUIZHEN "只能对战斗中的对手使用。\n");
	if( me->is_busy() )
		return notify_fail("( 你上一个动作还没有完成，不能施用绝招。)\n");
	if (!objectp(weapon = me->query_temp("weapon")) || ((string)weapon->query("skill_type") != "sword" && (string)weapon->query("skill_type") != "blade" ))
		return notify_fail("你所使用的武器不对，难以施展" GUIZHEN "。\n");
	if ( ((string)weapon->query("skill_type") == "sword" && me->query_skill_mapped("sword") != "daojian-guizhen")
	        && ((string)weapon->query("skill_type") != "blade" && me->query_skill_mapped("blade") != "daojian-guizhen"))
		return notify_fail("你没有激发刀剑归真，难以施展" GUIZHEN "。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if (me->query_skill("daojian-guizhen", 1) < 1000)
		return notify_fail("你的刀剑归真等级不够，难以施展" GUIZHEN "。\n");
	if (me->query_skill("hujia-dao", 1) < 1000)
		return notify_fail("你的胡家刀法等级不够，难以施展" GUIZHEN "。\n");
	if (me->query_skill("miaojia-jian", 1) < 1000)
		return notify_fail("你的苗家剑法等级不够，难以施展" GUIZHEN "。\n");	
	if (me->query_skill("lengyue-shengong", 1) < 1000)
		return notify_fail("你的苗家剑等级不够，难以施展" GUIZHEN "。\n");
	if (me->query_skill_mapped("force")!="lengyue-shengong") 
		return notify_fail("你没有使用冷月神功吧！。\n");	
	if (me->query("max_neili") < 500000)
		return notify_fail("你内力修为不够，难以施展" GUIZHEN "。\n");	
	if (me->query("neili") < 10000)
		return notify_fail("你现在的真气不够，难以施展" GUIZHEN "。\n");
	if (me->query("max_jingli") < 500000)
		return notify_fail("你精力修为不够，难以施展" GUIZHEN "。\n");	
	if (me->query("jingli") < 10000)
		return notify_fail("你现在精神萎靡，难以施展" GUIZHEN "。\n");
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
	if (!(int)me->query("breakup"))
		return notify_fail("你任督二脉未通,无法使用「刀剑归真」。\n"NOR);	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	message_vision(HBWHT "$N贯通胡苗两家武学，使出了胡苗两家的绝学之精髓！\n" NOR, me, target);	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	ap = me->query("xyzx_sys/level") + me->query_skill("daojian-guizhen", 1) + me->query_skill("lengyue-shengong", 1) + me->query_skill("blade") + me->query_skill("sword");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	level = me->query_skill("daojian-guizhen",1)/10;
	msg = HIR "$N突然刀剑互易、颠倒刚柔，刀又是剑，剑又是刀，或变或不变，幻出一片刀光剑影，教$n难以捉摸，正是刀剑的终极杀招「" HIR "刀剑七重天" HIY "」！\n"  NOR;
	msg += HIY "$N" HIY "将" + weapon->name() + HIY "横置于胸前，运转出「" HIR "刀剑七重天" HIY "」功力，内劲如海啸般爆发。\n" NOR;
	message_vision(msg, me, target);
	me->add("neili", -1000);
	me->add("jingli", -1000);
        me->add_temp("apply/damage", level);
        me->add_temp("apply/attack", level); 	
	msg = HIY "      一重天！      \n" NOR;
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);
	msg = HIC "      二重天！      \n" NOR;
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);
	msg = HIB "      三重天！      \n" NOR;
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);
	msg = HIW "      四重天！      \n" NOR;
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);
	msg = HIG "      五重天！      \n" NOR;
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);
	msg = HIR "      六重天！      \n" NOR;
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);
	msg = HIM "      七重天！      \n" NOR;
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);	
        me->add_temp("apply/damage", -level);
        me->add_temp("apply/attack", -level); 
		
if (me->query_skill("daojian-guizhen",1)>2000)
{
	msg = HIY "$N手中武器寒气逼人，刀身撕裂空气，片片雪花飘落，竟然凝出「雪域苍狼」四个字！霎时间，四个字散去，变成千百万的碎粒飞射进$n的身体。\n" NOR;
	message_vision(msg, me, target);
	damage = me->query_skill("sword",1)+me->query_skill("blade",1)+me->query_skill("force",1)+me->query_skill("daojian-guizhen",1)+me->query_skill("lengyue-shengong",1);
	if (random(ap) > dp/3)
	{
		damage = damage/2 + random(damage/2);
		damage = damage*(100-target->query_meridian())/100;
		me->add("neili", -1000);
		me->add("jingli", -1000);
		target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);		
		msg = HIR "$n" HIR "见$N" HIR "杀气大涨，不禁心生惧意，招架顿时散乱，全然不成章理。\n" NOR;
		msg += HIM "只见$n一声惨叫，全身上下给射出数不清的血洞，鲜血汹涌喷出！" + "\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		msg = HIG "$n" HIG "见$N" HIG "杀气大涨，丝毫不敢大意，急忙收敛心神，努力不受干扰。\n" NOR;
		message_vision(msg, me, target);
	}

}	


if (me->query_skill("daojian-guizhen",1)>3000)
{	
		msg = HIW "$N脸色凝重，手中宝剑寒气逼人，剑气撕裂空气，周围忽起阵阵杀机，温度骤降，片片雪花飘落，剑未至气先及，$n如堕冰窖，眉毛都蒙上了薄薄白霜！只见$N一声怒嚎,“千里冰封”，冰气剑茫挟着漫天风雪，以雷霆之势扑向$n,天地为之变色！\n"  NOR;
		message_vision(msg,me,target);
	if (random(ap) > dp/3)
	{
		if (me->query("jm/humiao")) damage = me->query_skill("sword",1)+me->query_skill("blade",1)+me->query_skill("force",1)+me->query_skill("daojian-guizhen",1)*me->query("int",1)*3/2+me->query_skill("miaojia-jian",1)*me->query("int",1)*3/2 +me->query_skill("hujia-dao",1)*me->query("str",1)*3/2+ me->query_skill("lengyue-shengong",1)*me->query("int",1)*3/2;
		else damage = me->query_skill("sword",1)+me->query_skill("blade",1)+me->query_skill("force",1)+me->query_skill("daojian-guizhen",1)*me->query("int",1)+me->query_skill("miaojia-jian",1)*me->query("int",1) +me->query_skill("hujia-dao",1)*me->query("str",1)+ me->query_skill("lengyue-shengong",1)*me->query("int",1);	
		damage = damage/3 + random(damage/3) + target->query("qi")*4/100;
		damage = damage*(100-target->query_meridian())/100;
		me->add("neili", -2000);
		me->add("jingli", -2000);
		target->apply_condition("no_force", 10);
		if (random(4)==1) 
		{
			target->map_skill("sword");	//下特殊剑法
			target->map_skill("blade");	//下特殊刀法
			message_vision(RED"刀剑一出，万剑臣服，万刀寂然。\n"NOR,me, target);
		}
		target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);			
		msg = HIC "\n突然间$N" HIC "身形一展，右手" + weapon->name() + HIC "忽地一振，凌空卷出一道半弧，直劈$n" HIC "而去。\n" NOR;
		msg +=HIM "$n已然冻僵，哪能闪避，$N的寒气剑茫顿时透体而入，口中鲜血狂喷，连退数步。" + "\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		damage = me->query_skill("sword",1)+me->query_skill("blade",1)+me->query_skill("force",1)+me->query_skill("daojian-guizhen",1)*me->query("int",1)/2+me->query_skill("lengyue-shengong",1);
		damage = damage/4 + random(damage/4);
		damage = damage*(100-target->query_meridian())/100;
		me->add("neili", -1000);
		me->add("jingli", -1000);
		target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);		
		msg = HIB "$N左手支颐，武器轻轻挥出，长叹一声，脸现寂寥之意，正是一招“胡笳十八拍”。" + "\n" + NOR;
		msg += HIG "\n接着$N" HIG "又将左手" + weapon->name() + HIG "朝$n" HIG "平平递出，招式看似简单，却蕴藏着极大的杀着。\n" NOR;
		msg += HIR "$n" HIR "只觉眼花缭乱，全然无法洞察先机，$N" HIR "一招命中，射出一柱鲜血。\n" NOR;
		message_vision(msg, me, target, damage, HBWHT+HIM"气血伤害"NOR);	//2018.10.2阿飞改，优化化学伤害显示的写法
	//	if (!target->is_busy()) target->start_busy(3);		
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
}
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}