int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练混元掌必须空手。\n");
  if ((int)me->query_skill("zixia-shengong", 1) < 200)
    return notify_fail("你的紫霞神功火候不够，无法学混元掌。\n");
  if (me->query("family/family_name") != "华山派")
    return notify_fail("你未加入华山派，无法学习本门技能。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练混元掌。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int level, skill;
  level = (int)me->query_skill("hunyuan-zhang", 1);
  skill = (int)me->query_skill("zixia-shengong", 1);
  if (random(level) > 300 && random(skill) > 200 && me->query("jiali") > 100 && random(10) == 1) {

    return ([
      "action": WHT "$N大喝一声，上下左右连续砍出数掌，但见掌风霍霍,犹如千把钢刀向$n袭去。" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "damage_type": "割伤" ]);
  }
  if (random(level) > 300 && random(skill) > 200 && me->query("jiali") > 100 && random(10) == 2) {
    return ([
      "action": WHT "$N双掌幻化一片掌影，将$n笼罩于内！$n眼前一花，顿时不知所措。" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "damage_type": "内伤" ]);
  }
  if (random(level) > 300 && random(skill) > 200 && me->query("jiali") > 100 && random(10) == 3) {
    return ([
      "action": WHT "$N面色凝重，双掌轻飘飘地拍向$n，一股排山倒海的内劲无声息的向$n胸口撞去！" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "damage_type": "内伤" ]);
  }

  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点

}
int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 40)
    return notify_fail("你的内力不够练混元掌。\n");
  if (me->query("family/family_name") != "华山派")
    return notify_fail("你未加入华山派，无法练习混元掌。\n");
  if (me->query("camp") != "正派")
    return notify_fail("你需要加入正派阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "hunyuan-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage1, damage2, damage, liannum;
  damage1 = (int)me->query_skill("hunyuan-zhang", 1);
  damage2 = (int)me->query_skill(
    "hunyuan-zhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  ap = me->query_skill(
    "hunyuan-zhang",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "force",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (objectp(me->query_temp("weapon"))) return 0;
  if (me->query_skill(
    "zixia-shengong",
    1
  ) < 100 || me->query_skill("hunyuan-zhang", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "zixia-shengong") return 0;

  if (me->query("jiali") > 0 && random(ap) > dp / 3 && random(7) == 1) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    message_vision(
      HIR "只听$n一声闷哼，被$N的混元掌力击中，劲气入体，吐了一口鲜血！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，运气于掌，重重的拍向$n。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/huashan")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("neili", -100);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    message_vision(
      HIC "$N领悟华山绝技，掌力蕴含混元之力，$n不识得其威力，与你硬拼一掌，结果被震的口吐鲜血。\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
