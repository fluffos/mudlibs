//kuang.c 狂风快剑
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
void attack_1();
void attack_2();
void attack_3();
void finish();
int perform(object me, object target) {
  string msg;
  object weapon;
  int extra;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("［狂风快剑］只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你现在无法使用狂风快剑。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if ((int)me->query_skill("kuangfeng-jian", 1) < 300)
    return notify_fail("你的狂风快剑还不够娴熟。\n");
  if ((int)me->query_skill("zixia-shengong", 1) < 300)
    return notify_fail("你的本门内功还不到家，无法使用本门绝技！\n");
  //	if (me->query_skill_mapped("force") != "zixia-shengong" )
  //		return notify_fail("你没使用本门内功！\n");
  //	if (me->query_skill_mapped("sword") != "kuangfeng-jian" )
  //		return notify_fail("你没使用狂风剑法！\n");
  if (me->query("neili") < 1000)
    return notify_fail("你的内力不够。\n");
  if (me->query("jing") < 1000)
    return notify_fail("你的精不够。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");


  msg = HIG "$N仰天一声清啸，斜行而前，" + weapon->name() + HIG "横削直击，迅捷无比，未到五六招，剑势中已发出隐隐风声。\n" NOR;
  message_vision(msg, me, target);
  extra = me->query_skill("kuangfeng-jian", 1) / 10 + me->query_skill("zixia-shengong", 1) / 10;
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);

  me->add("jingli", -300);

  if (me->query_skill("kuangfeng-jian", 1) > 1000) {
    message_vision(HIG "\n$N剑招一剑快似一剑，所激起的风声也越来越强！\n" NOR, me, target);
    me->add("apply/attack", extra / 2);
    me->add("apply/parry", extra / 2);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    me->add("apply/attack", -extra / 2);
    me->add("apply/parry", -extra / 2);
    me->add("jingli", -100);
  }
  if (me->query_skill("kuangfeng-jian", 1) > 1500) {
    message_vision(HIG "\n$N剑锋上所发出的一股劲气渐渐扩展！\n" NOR, me, target);
    me->add("apply/attack", extra);
    me->add("apply/parry", extra);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    me->add("apply/attack", -extra);
    me->add("apply/parry", -extra);
    me->add("jingli", -100);
  }
  if (me->query_skill("kuangfeng-jian", 1) > 2000) {
    message_vision(HIG "\n旁观众人只觉寒气逼人，脸上、手上被疾风刮得隐隐生疼，不由自主的后退！\n" NOR, me, target);
    me->add("apply/attack", extra * 2);
    me->add("apply/parry", extra * 2);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    me->add("apply/attack", -extra * 2);
    me->add("apply/parry", -extra * 2);
    me->add("jingli", -100);
  }
  if (me->query_skill("kuangfeng-jian", 1) > 2500) {
    message_vision(HIG "\n附近众人身上的衣带被剑气逼得向外飘扬，剑上所发的风声尚有渐渐增大之势。！\n" NOR, me, target);
    me->add("apply/attack", extra * 3);
    me->add("apply/parry", extra * 3);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    me->add("apply/attack", -extra * 3);
    me->add("apply/parry", -extra * 3);
    me->add("jingli", -100);
  }
  if (me->query_skill("kuangfeng-jian", 1) > 3000) {
    message_vision(HIG "旁观众人不由自主的后退，围在相斗两人身周的圈子渐渐扩大！\n" NOR, me, target);
    me->add("apply/attack", extra * 4);
    me->add("apply/parry", extra * 4);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    me->add("apply/attack", -extra * 4);
    me->add("apply/parry", -extra * 4);
    me->add("jingli", -100);
  }
  message_vision(HIY "$N这“狂风快剑”委实快极，一百零八招片刻间便已使完。\n" NOR, me);
  me->start_busy(1);
  return 1;
}


void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
