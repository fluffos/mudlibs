// tie@fengyun

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int i, attack_time, extra, ap, dp, damage;
  object weapon;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「辟邪」只能对战斗中的对手使用。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((string)me->query("gender") == "女性")
    return notify_fail("自古就没有女子可以使用.\n");
  if ((string)me->query("gender") == "男性")
    return notify_fail("欲练神功，必先自宫，欲使神功，快快进宫.\n");
  if ((string)me->query("genderbak") == "男性")
    return notify_fail("你个假太监，赶紧去割了.\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  //    if ( me->query_skill_mapped("sword") != "pixie-jian")
  //        return notify_fail("你必须激发辟邪剑法才能使用「辟邪」！\n");      
  if ((int)me->query_skill("pixie-jian", 1) < 300)
    return notify_fail("你的辟邪剑法不够娴熟，不能用「辟邪」。\n");
  if ((int)me->query("neili") < (int)me->query_skill("pixie-jian", 1) * 4)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够了。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  ap = me->query("xyzx_sys/level") + me->query_skill(
    "pixie-jian",
    1
  ) + me->query_skill("sword") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  extra = me->query_skill("pixie-jian", 1) / 3;
  if (me->query_skill_mapped("force") == "kuihua-xinfa") extra -= me->query_skill(
    "kuihua-xinfa",
    1
  ) / 5;  //2018.9.5阿飞改，不使用本门特内则减益，使用对应特内有加成
  if ((string)weapon->query("id") == "xiuhua zhen") extra -= me->query_skill("pixie-jian", 1) / 3;  //2018.3.25阿飞改，拿特殊武器有加成
  msg = HIR "$N身影变的模糊起来，使出辟邪剑法的「辟邪」，手中的" + weapon->name() + " 一剑连着一剑，闪电般的击向$n！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  attack_time = me->query_skill("pixie-jian", 1) / 60;
  if (attack_time < 1) attack_time = 1;
  if (me->query("jm/riyue")) {
    if (attack_time > 100 + (int)me->query_temp("lianzhao_max_add") * 4) attack_time = 100 + (int)me->query_temp("lianzhao_max_add") * 4;
  } else {
    if (attack_time > 50 + (int)me->query_temp("lianzhao_max_add") * 2) attack_time = 50 + (int)me->query_temp("lianzhao_max_add") * 2;
  }

  me->add_temp("lianzhao", attack_time);  //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->add_temp("apply/strength", -extra);
  for (i = 0; i < attack_time; i++) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  }
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  me->add_temp("apply/strength", extra);
  me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记
  me->add("neili", -(100 * attack_time));

  msg = HIW "$N" HIW "一声冷哼，双眸间透出一丝寒气，" + weapon->name() + HIW "化作千百根相似，幻出死亡的色彩！\n" NOR;
  message_vision(msg, me, target);
  if (random(ap) > dp / 3) {
    damage = ap / 2 + random(ap / 2) + me->query_skill("pixie-jian", 1);
    damage = damage * (100 - target->query_meridian()) / 100;
    target->add("neili", -damage);
    msg = HIR "$n" HIR "只觉眼前寒芒一闪而过，随即气海穴一阵刺痛，陡然间一提真气，竟发现周身力道竟似涣散一般，全然无法控制。\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -200);
  } else {
    msg = CYN "$n" CYN "大惊之下全然无法招架，急忙抽身急退数尺，躲开了这一招。\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -100);
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
