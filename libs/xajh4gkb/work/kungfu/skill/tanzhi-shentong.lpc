int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练弹指神通必须空手。\n");
  if (me->query("family/family_name") != "桃花岛")
    return notify_fail("你不是东邪传人，无法学习。\n");
  if ((int)me->query_skill("bibo-shengong", 1) < 300)
    return notify_fail("你的碧波神功火候不够，无法学弹指神通。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练弹指神通。\n");
  if ((int)me->query("con", 1) < 25)
    return notify_fail("你的根骨太差，无法练弹指神通。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int level;
  string xue;

  level = (int)me->query_skill("tanzhi-shentong", 1);
  xue = xuedao[random(sizeof(xuedao))];

  if (random(level) > 300 && me->query_temp("powerup") && random(15) > 9 && me->query("jiali") > 100 && me->query("neili") >= 500) {
    me->add("neili", -100);
    return ([
      "action": HIG "$N身子滴溜溜的打了半个圈子，丹田中提一口真气，青芒犹似长蛇般伸缩不定，蓦地真气突盛，刺向$n的" + xue + "" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "weapon": HIG "指气" NOR,
      "damage_type": "内伤"
    ]);
  }
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力不够，休息一下再练吧。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练弹指神通。\n");
  if (me->query("family/family_name") != "桃花岛")
    return notify_fail("偷练东邪的武功会被打死的。\n");
  if (me->query("camp") != "中立")
    return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "tanzhi-shentong/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  string msg, name1, name2, name3;
  int ap, dp, damage1, damage2, damage, liannum;
  object weapon2;
  name1 = xue_name1[random(sizeof(xue_name1))];
  name2 = xue_name2[random(sizeof(xue_name2))];
  name3 = xue_name3[random(sizeof(xue_name3))];
  weapon2 = victim->query_temp("weapon");
  ap = me->query_skill(
    "tanzhi-shentong",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = victim->query_skill(
    "parry",
    1
  ) * (victim->query("breakup") + victim->query("breakup") * victim->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("tanzhi-shentong", 1);
  damage2 = (int)me->query_skill(
    "tanzhi-shentong",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (me->query_temp("lianzhao") >= 1) liannum = me->query_temp("lianzhao");
  else liannum = 1;
  if (me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
  if (me->query_skill(
    "bibo-shengong",
    1
  ) < 100 || me->query_skill("tanzhi-shentong", 1) < 100) return 0;
  //	if ( me->query_skill_mapped("force") != "bibo-shengong") return 0;
  if (objectp(me->query_temp("weapon"))) return 0;

  if (random(7) == 1 && random(ap) > dp / 3 && me->query("jiali") > 0) {
    damage = (damage1 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    victim->receive_damage("qi", damage, me);
    victim->receive_wound("qi", damage / 3, me);
    me->add("neili", -100);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIR "$N施展弹指神通绝技，只听噗嗤一声，$n被$N点中了「" HIC + name1 + HIR "」，内息大乱！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiajing") > 0 && random(7) == 2 && (int)me->query("breakup") > 1) {
    damage = (damage2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    me->add("jingli", -100);
    victim->receive_damage("jing", damage, me);
    victim->receive_wound("jing", damage / 3, me);
    if (!victim->is_busy()) victim->start_busy(1);
    message_vision(
      HIG "$N顿悟" + me->query("cognize") + HIG "，$N手指微动，又点中了$n的「" HIC + name2 + HIG "」！$n只觉得头微微晕眩，精神不能集中！\n" NOR,
      me,
      victim,
      damage,
      HBWHT + HIR "特效伤精" NOR
    );
    return;
  }
  if (random(ap) > dp / 3 && (int)me->query("jiali") > 0 && random(7) == 3 && (int)me->query("jm/taohua")) {
    damage = ((damage1 + damage2) / 2 + damage_bonus) * (liannum + 20) / (20 * liannum + 1);
    msg = HIM "$N融汇桃花岛武学精髓，反手再点向$n的「" HIC + name3 + HIM "」！" NOR;
    if (objectp(weapon2 = victim->query_temp("weapon"))) {
      if (random(3) == 0) {
        msg += HIM "$n虎口一热，" + weapon2->name() + HIR "飞出数丈！\n" NOR;
        weapon2->unequip();
        weapon2->move(environment(victim));
        message_vision(msg, me, victim);
      } else {
        msg += HIM "$n「" HIC + name3 + HIM "」一痛，顿感真气涣散几欲晕厥！\n" NOR;
        victim->receive_damage("qi", damage, me);
        victim->receive_wound("qi", damage / 3, me);
        message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
      }
    } else {
      msg += HIM "霎那间$n只见寒芒一闪，$N食指已钻入胸堂半尺，指劲顿时破体而入。\n" NOR;
      victim->receive_damage("qi", damage, me);
      victim->receive_wound("qi", damage / 3, me);
      message_vision(msg, me, victim, damage, HBWHT + HIR "特效伤气" NOR);
    }
    me->add("neili", -100);
    return;
  }
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg, name1, name2, name3;
  int ap, dp, j, damage1, damage2;
  name1 = xue_name1[random(sizeof(xue_name1))];
  name2 = xue_name2[random(sizeof(xue_name2))];
  name3 = xue_name3[random(sizeof(xue_name3))];
  ap = me->query_skill(
    "tanzhi-shentong",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  dp = ob->query_skill(
    "sword",
    1
  ) * (ob->query("breakup") + ob->query("breakup") * ob->query("breakup") + 100) / 100;
  damage1 = me->query_skill("tanzhi-shentong", 1);
  damage2 = me->query_skill(
    "tanzhi-shentong",
    1
  ) * (me->query("breakup") + me->query("breakup") * me->query("breakup") + 100) / 100;
  if (damage < 10) damage = 10;
  if (me->query("neili") < 100 || me->query("jingli") < 100) return damage;
  if (objectp(me->query_temp("weapon"))) return damage;
  if (me->query_skill(
    "bibo-shengong",
    1
  ) < 300 || me->query_skill("tanzhi-shentong", 1) < 300) return damage;
  //	if (me->query_skill_mapped("force")!="bibo-shengong" ) return damage;

  if (random(8) == 1 && random(ap) > dp / 4) {
    msg = HBMAG "$N危急中，伸出手指弹向$n的「" HBRED + name1 + HBMAG "」！结果把$n一些力道转移开去。\n" NOR;
    if (!ob->is_busy()) ob->start_busy(1);
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(msg, me, ob);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 2 && (int)me->query("breakup") > 1) {
    msg = YEL "$N顿悟" + me->query("cognize") + HIY "，百忙中抽出手指来，使出弹指神通向$n的「" HIC + name2 + YEL "」弹去！$n胸口气血翻腾，似乎受到轻微的内伤！\n" NOR;
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("jing", damage2, me);
    ob->receive_wound("jing", damage2 / 2, me);
    me->add("jingli", -100);
    message_vision(msg, me, ob, damage2, HBWHT + HIY "精神反伤" NOR);
    return j;
  }
  if (random(ap) > dp / 4 && random(8) == 3 && (int)me->query("jm/taohua")) {
    msg = HIB "$N贯通桃花岛绝技，突然伸指，连点$n的「" RED + name3 + HIB "」！只听“嗤嗤”之声连响，无数道劲风从四面八方袭向$n。\n" NOR;
    j = -(damage / 2 + random(damage / 2));
    ob->receive_damage("qi", damage1, me);
    ob->receive_wound("qi", damage1 / 2, me);
    me->add("neili", -100);
    message_vision(msg, me, ob, damage1, HBWHT + HIY "气血反伤" NOR);
    return j;
  }
}
