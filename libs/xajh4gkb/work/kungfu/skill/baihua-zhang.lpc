string skill_pinji() {return "中乘";}				//品级区分：上乘、中乘、下乘
string skill_xingbie() {return "通用";}				//性别区分：男性、女性、无性、通用
string skill_zhengxie() {return "中立";}			//正邪区分：正道、邪道、中立
string skill_menpai() {return "南海派";}				//门派区分：门派，江湖
string skill_yinyang() {return "中性";}				//阴阳区分：阳、阴、中性
string skill_zhenying() {return "中立";}			//阵营区分：正派、邪派、中立、通用
int damage_damage() {return 44;}	//外伤系数
int force_damage() {return 55;}		//内伤系数
//int qi_heal() {return 50;}		//内功疗气系数
//int jing_heal() {return 50;}		//内功疗精系数
int practice_level() {return 100;}	//自练级别
int practice_add() {return 100;}	//自练效率
int perform_level() {return 300;}	//PFM最低使用级别

mapping query_action(object me, object target, object weapon)
{
	if (random(me->query_skill("baihua-zhang",1)) > 300 && me->query("neili") > 200 && random(7)==0 )
	{
		me->add("neili", -150);
		return ([
        "action": ""HIB"忽然$N使出「百花齐放」，瞬息之间无数拳影向$n击来。\n"
        "$n"HIG"只看见眼前很多花朵绽放，顿时明白了花儿为什么那样红。\n"NOR"",
		"attack":	300,
		"parry":	300,
		"dodge":	300,
		"damage":	300,
		"force":	300,
        "damage_type": "内伤"]);
		
	}
	
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");
    if (me->query("family/family_name")!="白云庵" && me->query("family/family_name")!="南海派")
		return notify_fail("你不是本门中人，如何学到本门高深技能，我要告诉掌门去。\n");		
	if ((int)me->query_skill("bitao-shengong", 1) < 100)
		return notify_fail("你的碧涛神功火候不够，无法练习百花掌。\n");	
	if( (int)me->query("jing") < 30)
		return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
	if( (int)me->query("qi") < 30 )
		return notify_fail("你现在手足酸软，休息一下再练吧。\n");
	if( (int)me->query("neili") < 40 )
		return notify_fail("你的内力不够了。\n");
//	if( (string)me->query("gender") != "女性" )
//		return notify_fail("百花掌是只有女子才能练的武功。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	me->receive_damage("qi", 30);
	me->add("neili", -10);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"baihua-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int ap,dp,damage1,damage2,damage,liannum;
	ap = me->query("int",1) * me->query_skill("baihua-zhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query("int",1) * victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
	damage1 = (int)me->query_skill("baihua-zhang",1);
	damage2 = (int)me->query_skill("baihua-zhang",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
    if ( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100) return 0;
	if ( me->query_skill("bitao-shengong",1) < 100 || me->query_skill("baihua-zhang",1) < 100)	 return 0;
//	if ( me->query_skill_mapped("force") != "bitao-shengong") return 0;	
	if (objectp(me->query_temp("weapon"))) return 0;

	if( random(ap) > dp/3 && random(7)==1 && me->query("jiali")>0 ) 
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili",-100);
		message_vision(HIR "然玫瑰虽好，但越好看的花越伤人！\n"NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;		
    }
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIR "$N掌随花飞，"+me->query("cognize")+HIR"幻化出百朵鲜花怒放！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/nanhai") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		if (!victim->is_busy()) victim->start_busy(2);
		message_vision(HIR "$N挥掌间，无不是南海派武功之精髓，百花齐放，将$n围住。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}	
}


