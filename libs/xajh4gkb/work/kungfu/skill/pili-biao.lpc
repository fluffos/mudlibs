int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力不够。\n");
	if ((int)me->query_skill("biyun-xinfa", 1) < 100)
		return notify_fail("你的碧云心法火候太浅。\n");
	if ((int)me->query_skill("biye-wu", 1) < 100)
		return notify_fail("你的碧叶随风舞火候太浅。\n");
    if (me->query("family/family_name")!="唐门")
		return notify_fail("你不加入唐门，不能传授唐门高深的暗器功夫。\n");		
	if (!me->query("jm/huanhua"))
		return notify_fail(CYN"这神州结义萧秋水好大的胆子，竟敢强闯我唐门禁地！\n"CYN"这位"+RANK_D->query_respect(me)+CYN"欲入我唐门，需得去浣花派为唐门了结此段恩怨！\n"NOR);
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	return 1;
		
}


string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	if(level >= action[i]["lvl"])
		return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing")
		return notify_fail("你使用的武器不对。\n");
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够，练不了霹雳镖。\n");
    if (me->query("family/family_name")!="唐门")
		return notify_fail("你不加入唐门，不能领悟暗器的精髓。\n");		
	if (!me->query("jm/huanhua"))
		return notify_fail(CYN"这神州结义萧秋水好大的胆子，竟敢强闯我唐门禁地！\n"CYN"这位"+RANK_D->query_respect(me)+CYN"欲入我唐门，需得去浣花派为唐门了结此段恩怨！\n"NOR);
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);	
	if (me->query("camp")!="邪派")	
		return notify_fail("你需要加入邪派阵营，才能修练该武功。\n");
	me->receive_damage("qi", 30);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, damage1,damage2,damage,liannum;
	object weapon;
	weapon = me->query_temp("weapon");
    ap = me->query_skill("pili-biao",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = victim->query_skill("parry",1)*(victim->query("breakup")+victim->query("breakup")*victim->query("breakup")+100)/100;
    damage1= (int) me->query_skill("pili-biao",1);
	damage2 = (int)me->query_skill("pili-biao",1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( me->query_temp("lianzhao")>=1) liannum=me->query_temp("lianzhao");
	else liannum =1;
	if( me->query("neili") < 100 || me->query("jingli") < 100 || damage_bonus < 100 ) return 0;
	if ( me->query_skill("biyun-xinfa",1) < 100 || me->query_skill("pili-biao",1)<100) return 0;
//	if ( me->query_skill_mapped("force") != "biyun-xinfa") return 0;
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing") return 0;

	if (random(7)==1 && random(ap) > dp/3 && me->query("jiali") > 0)
	{
		damage = (damage1+damage_bonus)*(liannum+20)/(20*liannum+1);
		victim->receive_damage("qi", damage ,me);
		victim->receive_wound("qi", damage/3 ,me);
		me->add("neili", -100);
		victim->apply_condition(du[random(sizeof(du))], 25);
		message_vision(HIR "$n随手就接住了这一只飞镖，正沾沾自喜！没想到居然爆炸开来，顿时被炸了个绿头黑脸！！\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
        return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiajing")>0 && random(7)==2 && (int)me->query("breakup")>1 )
	{
		damage = (damage2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("jingli",-100);
		victim->receive_damage("jing", damage,me);
		victim->receive_wound("jing", damage/3,me);
		message_vision(HIG "$N顿悟"+me->query("cognize")+HIG"，手中" + weapon->name() + HIG "如霹雳闪电般激射，只听$n一声痛叫，身上飚出一道血箭。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
	if( random(ap) > dp/3 && (int)me->query("jiali")>0 && random(7)==3 && (int)me->query("jm/tangmen") )
	{
		damage = ((damage1+damage2)/2+damage_bonus)*(liannum+20)/(20*liannum+1);
		me->add("neili",-100);
		victim->receive_damage("qi", damage,me);
		victim->receive_wound("qi", damage/3,me);
		message_vision(HIM"$N融汇唐门武学精髓，衣袖一挥，数点寒芒一闪而过，到$n眼前时爆炸开来，$n满脸鲜血。\n" NOR, me,victim,damage,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}

string perform_action_file(string action)
{
	return __DIR__"pili-biao/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage2;
	object weapon;
	weapon = me->query_temp("weapon");
	ap = me->query_skill("pili-biao", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("sword",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage2 = me->query_skill("pili-biao", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing") return damage;
	if (me->query_skill("biyun-xinfa",1) < 300 || me->query_skill("pili-biao", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="biyun-xinfa" ) return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIC"$N窥得一个间隙，反手一弹，一道寒芒射向$n，$n只好收招。\n"NOR;
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N发挥"+me->query("cognize")+HIY"力量，战斗良久，$n出招时，突然所用的内力随着伤口流出！\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/tangmen") )
	{
		j = -(damage/3+random(damage/3));
		me->add("neili", -100 );
		ob->apply_condition(du[random(sizeof(du))], 25);
		message_vision(HIB"$N贯通唐门武学精髓，默运碧云心法，将毒气注入" + weapon->name() + HIB "之中！\n"NOR, me, ob);
		return j;
	}
}
