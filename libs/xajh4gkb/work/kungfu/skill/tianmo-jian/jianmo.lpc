#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, i, count, attack_time, ap, dp, damage;
  object weapon;
  string *order = ({ "关元穴", "檀中穴", "肩井穴", "太阳穴", "气海穴", "百汇穴", "腹结穴", "涌泉穴", "大椎穴" });

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("［剑魔］只能对战斗中的对手使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你手中没有装备剑类武器！\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query("max_neili") < 500000)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query("max_jingli") < 500000)
    return notify_fail("你的精力修为不够。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的真气不够。\n");
  if ((int)me->query_skill("tianmo-shengong", 1) < 1000)
    return notify_fail("你的天魔神功不够娴熟！\n");
  if ((int)me->query_skill("tianmo-jian", 1) < 1000)
    return notify_fail("你的天魔剑不够娴熟！\n");
  //   	if (me->query_skill_mapped("sword") != "tianmo-jian")
  //		return notify_fail("你没正确激发该技能 。\n");
  //	if(me->query_skill_mapped("force") != "tianmo-shengong" )
  //		return notify_fail("不使用本门内功，如何能使用本门绝技。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  ap = me->query("xyzx_sys/level") + me->query_skill(
    "tianmo-jian",
    1
  ) + me->query_skill("sword") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  extra = me->query_skill("tianmo-jian", 1) / 10;
  count = me->query_skill("tianmo-jian", 1) / 600;
  msg = HIR "$N使出［天魔神剑］中的无上绝技－－剑魔！" + weapon->name() + "划着奇异的弧线，急斩$n！" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  if (count > 8) count = 8;
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  for (i = 0; i < count; i++) {
    msg = CYN "第" + (i + 1) + "剑！$N御技如神，剑气纵横！\n" NOR;
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
    me->add("neili", -30);
  }
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->add("neili", -1000);
  me->add("jingli", -1000);

  if ((int)me->query_skill("tianmo-jian", 1) > 2000) {
    msg = HIW "$N" HIW "一振手中" + weapon->name() + HIW "，挽出数朵剑花，层层涌向$n" HIW "，犹如潮水，一浪高过一浪。\n" NOR;
    message_vision(msg, me, target);
    if (random(ap) > dp / 3) {
      message_vision(HIR "$n" HIR "顿时只觉得头晕目眩，天旋地转，一时难以招架。\n" NOR, me, target);
      attack_time = 1 + random(me->query_skill("tianmo-jian", 1) / 600);
    } else {
      message_vision(HIC "$n" HIC "见$N" HIC "剑势汹涌，急忙凝神抵挡，不为所困。\n" NOR, me, target);
      attack_time = 3;
    }
    for (i = 0; i < attack_time; i++) {
      if (!me->is_fighting(target))
        break;
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
      damage = me->query_skill(
        "tianmo-jian",
        1
      ) / 3 + random(me->query_skill("tianmo-jian", 1) / 2);
      damage = damage * (100 - target->query_meridian()) / 100;
      target->receive_wound("qi", damage, me);
      target->receive_damage("qi", damage / 2, me);
      me->add("neili", -100);
      me->add("jingli", -100);
      msg = RED "$n惊叫一声，" + HIY + (order[random(7)]) + NOR + RED + "部位血花飞溅,\n" NOR;
      message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法	
      //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);

    }

    msg = YEL "\n\n只见$N双目一滞，面上闪过一阵异彩，身法突然加快，如影随形，蹂身而上！\n" NOR;
    msg += YEL "随着一声凄厉的长啸，$N手中宝剑绽开朵朵剑花，猛地罩向$n全身各处命门大穴！\n\n" NOR;
    message_vision(msg, me, target);
    if (random(ap) > dp / 3) {
      me->add("neili", -1000);
      me->add("jingli", -1000);
      damage = me->query_skill(
        "tianmo-jian",
        1
      ) / 2 + random(me->query_skill("tianmo-jian", 1) / 2);
      damage = damage * (100 - target->query_meridian()) / 100;
      switch (random(2)) {
        case 1:
          {
            target->receive_wound("qi", damage, me);
            target->receive_damage("qi", damage / 2, me);
            msg = RED "$n惊叫一声，" + HIY + (order[random(7)]) + NOR + RED + "部位血花飞溅,\n" NOR;
            message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法			
            //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
            break;
          }
        default:
          {
            target->receive_wound("jing", damage, me);
            target->receive_damage("jing", damage / 2, me);
            msg = RED "$n惊叫一声，" + HIY + (order[random(7)]) + NOR + RED + "部位血花飞溅,\n" NOR;
            message_vision(msg, me, target, damage, HBWHT + HIM "精神伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法	
            //			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
          }
      }
    } else {
      msg = CYN "$p冷笑一声，身形虚晃几下闪了开去！\n" NOR;
      message_vision(msg, me, target);
    }
  }

  if ((int)me->query_skill("tianmo-jian", 1) > 3000) {
    message_vision(HIR "\n\n $N捧剑在手，怪异的面容上一片肃穆，口中大喝一声：" NOR, me);
    message_vision(
      HIR "\n －" + HIM "奇" + HIR "－" + HIY "浓" + HIR "－" + BLU "嘉" + HIR "－" + HIG "嘉" + HIR "－" + WHT "普" + HIR "－\n" NOR,
      me,
      target
    );
    msg = MAG "\n$N" + MAG "眼神中充满魔意，手中的魔剑在空中飞舞！\n" + CYN "远处传来一连串铃声，铃声由远而近，一群怪鸟拥着一团火焰在铃声中翩翩舞来。" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = WHT "\n美丽的怪鸟，" + HIG "有孔雀的翎，" + BLU "有蝙蝠的翅，" + BLK "有燕子的剪尾，" + HIY "有蜜蜂的毒针，" + HIC "半边的翅是兀鹰，\n"
      +BLU "半边的翅是蝙蝠，" + HIG "半边的羽毛是孔雀，" + HIR "半边的羽毛是凤凰。\n" + HIW "蝙蝠的伞翼漆黑，燕子的剪尾乌亮，孔雀的翎毛辉煌，凤凰的羽毛瑰丽。\n" + HIM "每一种颜色都是配合得这样鲜明，不寻常的美，不寻常的怪。\n"
      +HIG "每一只鸟的脖子上都挂着一个铃。铃声怪异，仿佛要慑人的魂魄。\n" NOR;
    message_vision(msg, me, target);
    if (random(ap) > dp / 3) {
      me->add("neili", -1000);
      me->add("jingli", -1000);
      damage = me->query_skill("tianmo-jian", 1) / 2 + random(me->query_skill("tianmo-jian", 1));
      damage = damage * (100 - target->query_meridian()) / 100;
      target->receive_damage("jing", damage, me);
      target->receive_wound("jing", damage / 2, me);
      msg = HIR "\n$n" + HIR "的魂魄并未被铃声慑掉，但是看" + HIR "$n" + HIR "那副样子，却已像神智不清，失魂落魄！\n" NOR;
      message_vision(msg, me, target, damage, HBWHT + HIM "精神伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
      //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    } else {
      msg = CYN "\n$n" + CYN "定了定心神，没有被眼前的假相迷惑，但仍然呆立当场！\n" NOR;
      message_vision(msg, me, target);
    }

    msg = HIC "\n一阵奇异的乐声突然在冰火风雾中响起，十万神魔右手握剑，左手竖起了食指，面容更肃穆。\n" + BLINK RED "剑光忽一闪！\n" NOR;
    message_vision(msg, me, target);
    if (random(ap) > dp / 3) {
      msg = MAG "\n$N" + MAG "突然消失，" + MAG "冰火风雾中赫然出现了十万把$w！" NOR;
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
      msg = MAG "\n新月般的$w" + MAG "闪耀着妖异的光芒！\n" + MAG "剑在十万神魔的手中，它们捧剑在手，仰首上望，怪异的面容之上一片肃穆。" NOR;
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
      msg = HIC "十万把$w" + HIC "一起割在十万只食指之上，十万滴魔血从剑光中飞出，从魔指中飞出！" NOR;
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
      msg = HIG "\n九万八千六百八十七滴魔血滴成了一只" + HIR "血鹦鹉" + HIG "在$n" + HIG "周围盘旋！！" NOR;
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

      me->add("neili", -1000);
      me->add("jingli", -1000);
      damage = me->query_skill("tianmo-jian", 1) / 2 + random(me->query_skill("tianmo-jian", 1));
      damage = damage * (100 - target->query_meridian()) / 100;
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      msg = YEL "\n\n$N身体突然飞速旋转，化作一阵狂飚，手中" + weapon->query("name") + "挑起漫天魔影，其快无比地向着$n扑去！\n" NOR;
      msg += HIY "$n大惊失色，奋力挣脱，但终究没有逃出天魔剑气的范围。！\n" NOR;
      msg += RED "$n眼前一暗，刹那间已被$N刺中" + HIY + (order[random(7)]) + NOR + RED + "，嘴角溢出几缕鲜血！\n\n\n" NOR;
      message_vision(msg, me, target, damage, HBWHT + HIM "气血伤害" NOR);  //2018.10.2阿飞改，优化化学伤害显示的写法
      //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    } else {
      msg = YEL "可是$p看破了$P的企图，身形一晃闪了开去。\n\n\n" NOR;
      message_vision(msg, me, target);
    }
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
