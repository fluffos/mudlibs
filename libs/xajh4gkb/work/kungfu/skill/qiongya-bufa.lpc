string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}
int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
//	if (me->query("gender") != "女性")
//		return notify_fail("这种步法需要纯阴之质才能习练!\n");
	if (me->query("family/family_name")!="白云庵" && me->query("family/family_name")!="南海派")
		return notify_fail("你不是南海传人，无法学习本门技能。\n");	
    if ((int)me->query_skill("bitao-shengong", 1) < 100)
		return notify_fail("你的碧涛神功火候不够，无法学习琼崖步法。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");
	
    return 1;
}
int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
//	if (me->query("gender") != "女性")
//		return notify_fail("这种步法需要纯阴之质才能习练!\n");
    if (me->query("family/family_name")!="白云庵" && me->query("family/family_name")!="南海派")
		return notify_fail("你不是南海传人，无法练习本门技能。\n");				
	if( (int)me->query("qi") < 30 || (int)me->query("neili") < 30 )
		return notify_fail("你的气或内力不够，不能练琼崖身法。\n");
	if (me->query("camp")!="中立")	
		return notify_fail("你需要加入中立阵营，才能修练该武功。\n");	
	me->receive_damage("qi", 30);
	me->add("neili", -10);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"qiongya-bufa/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int ap,dp,j,damage1,damage2;
	ap = me->query_skill("qiongya-bufa", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	dp = ob->query_skill("sword",1)*(ob->query("breakup")+ob->query("breakup")*ob->query("breakup")+100)/100;
	damage1 = me->query_skill("qiongya-bufa", 1);
	damage2 = me->query_skill("qiongya-bufa", 1)*(me->query("breakup")+me->query("breakup")*me->query("breakup")+100)/100;
	if( damage < 10 ) damage=10;
	if( me->query("neili") < 100 || me->query("jingli") < 100 ) return damage;
	if (me->query_skill("bitao-shengong",1) < 300 || me->query_skill("qiongya-bufa", 1) < 300) return damage;
//	if (me->query_skill_mapped("force")!="bitao-shengong" ) return damage;

	if ( random(8) == 1 && random(ap) > dp/4 )
	{
        msg = HIC"$N不见有任何动作，只是身子一晃一转，$n就发现与$N的距离似天涯海角般远，结果$n的力道被躲过了一大半！\n"NOR;
		me->add("neili", -100 );
		j = -(damage+random(damage));
		message_vision(msg, me, ob);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==2 && (int)me->query("breakup")>1 )
	{
		j = -(damage/2+random(damage/2));
		ob->receive_damage("jing",damage2,me);
		ob->receive_wound("jing",damage2/2,me);
		me->add("jingli", -100 );
		message_vision(HIY"$N顿悟"+me->query("cognize")+HIY"，$n只觉眼前一花，不见了对手的身影！再看对方已至身后，及至转身已是砂锅大的拳头迎面而来！\n"NOR, me, ob,damage2,HBWHT+HIY"精神反伤"NOR);
		return j;
	}
	if(random(ap) > dp/4 && random(8)==3 && (int)me->query("jm/nanhai") )
	{
		j = -(damage/3+random(damage/3));
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage1/2,me);
		me->add("neili", -100 );
		message_vision(HIB"$N洞彻南海派武学精髓，一步踏出，天涯海角亦近在眼前，趁$n间不容发之际，攻出一招！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	}
}

