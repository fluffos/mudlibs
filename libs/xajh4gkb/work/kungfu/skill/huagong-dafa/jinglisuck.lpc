
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;

int exert(object me, object target)
{
	int ap,dp,max_suck,skill,huiyuan,addtime,jingnei_max_add;
	skill = (int)me->query_skill("huagong-dafa",1);	
	
	if ( target == me ) target = offensive_target(me);
	if( !objectp(target) || environment(me)!=environment(target)||target->query("id") == "mu ren"|| target->query("id") == "tong ren")
		return notify_fail("你要吸谁的精力？\n");
	if( wiz_level(target)>0 || (int)target->query("max_jingli") <= 0 || (int)target->query("no_suck"))
		return notify_fail( target->name() + "没有任何精力！\n");
	if ( target->query("age") < 18)
		return notify_fail("小孩子能有什么精力?\n");
	if( objectp(me->query_temp("weapon")) )
		return notify_fail("你必须空手才能施用化功大法！\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
	if (me->query_temp("apply/shade_vision")) 
		return notify_fail("隐身之后还想吸取别人精力？你以为你是神仙吗。\n"); 
	if( (int)me->query_skill("huagong-dafa",1) < 300 || me->query("max_jingli") > skill*4000 )
		return notify_fail("你的化功大法功力不够，不能吸取对方的精力！n");
	if( (int)me->query("jingli",1) < 1000 )
		return notify_fail("你的内力不够，不能使用化功大法。\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的内力不够。\n");
	if( (int)target->query("max_jingli") < 1000 || (int)target->query("jingli") < 1000 || !living(target))
		return notify_fail( target->name() + "已经精力涣散，你已经无法从他体内吸取任何精力了！\n");
	if (me->query_skill_mapped("force") != "huagong-dafa")
		return notify_fail("你没正确激发该技能 。\n");	
	if(me->is_busy()) 
		return notify_fail("你现在正忙着吸取精力！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");	
//	if(!me->query("xy_huiyuan") && me->query("max_jingli") >=330000)
//		return notify_fail(HIY"只有会员才能吸取33万以上精力。\n"NOR);
//	if ( !me->query("xy_huiyuan") && target->query("id") == "nai niu" && domain_file(base_name(environment(me))) == "party" )
//		return notify_fail(HIY"帮会中奶牛只提供给注册会员使用，你无法吸取。\n"NOR);
	if(me->query("xyhy_type")==2) huiyuan = 5/4;	//黄金会员打坐增加技能熟练度1.25倍
		else huiyuan = 1;
	if ( me->query_exp_times() > 1 ) addtime = 2;
		else addtime = 1;
	if (me->query_temp("jingnei_max_add")) jingnei_max_add = (int)me->query_temp("jingnei_max_add",1);	//处于技能自练提升状态时	
	else jingnei_max_add = 0;	
	message_vision( HIR "$N全身骨节爆响，双臂暴长数尺，掌缘猛地向$n的天灵拍了下去！\n\n" NOR,me, target );
	me->add("neili", -100);
	me->add("jingli", -100);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 6, me);	//CD写法1	
	if ( living(target) )
	{
		me->kill_ob(target);
		target->kill_ob(me);
	}
	ap = me->query("xyzx_sys/level") + me->query_skill("huagong-dafa", 1) + me->query_skill("zhaixinggong",1) + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("force");
	ap = ap*((int)me->query("breakup")+(int)me->query("breakup")*(int)me->query("breakup")+100)/100;
	dp = dp*((int)target->query("breakup")+(int)target->query("breakup")*(int)target->query("breakup")+100)/100;
	if ( random(ap) > dp/3 )
	{
        tell_object(target, HIR "你只觉天顶骨裂，全身功力贯脑而出，如融雪般消失得无影无踪！\n" NOR);
 	
		if((int)me->query("max_jingli")<(int)target->query("max_jingli")) max_suck = (int)me->query_skill("huagong-dafa",1)/70+1;  
		else max_suck = (int)me->query_skill("huagong-dafa",1)/105+1;  
		if (userp(target)) max_suck/=4;		//吸玩家减少
		max_suck = max_suck*huiyuan*addtime*(jingnei_max_add+100)/100;
		if ( target->query("max_jingli") < max_suck ) max_suck = target->query("max_jingli");		
		target->add("max_jingli",  -max_suck );
		target->add("jingli",  -max_suck );
		me->add("max_jingli", max_suck);  
		me->add("jingli", -max_suck);		
		if ( target->query("max_jingli") <1 ) target->set("max_jingli",0);
		if ( me->query("jingli") <1 ) me->set("jingli",0);		
		if (me->query_skill("huagong-dafa",1)<me->query_skill("force",1) && me->query_skill("huagong-dafa",1)<(me->query("xyzx_sys/level")+300)*2) 
			me->improve_skill("huagong-dafa", me->query("con",1)*10+10, 0);	
		tell_object(me, HIG "你觉得" + target->name() + "的丹元("+max_suck+")自手掌源源不绝地流了进来。\n" NOR);			
//		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招吸取敌人上限精力"+ max_suck +"，杀精力"+ max_suck +"。\n" NOR);		
	}
	else
	{   
		message_vision(HIY "可是$p看破了$P的企图，机灵地闪了开去。\n" NOR, me, target);
	}
	me->start_busy(1);
	return 1;
}
void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}


