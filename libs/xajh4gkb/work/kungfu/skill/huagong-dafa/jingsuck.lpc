// jingsuck.c
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int exert(object me, object target) {
  int ap, dp, damage1, damage;

  if (target == me) target = offensive_target(me);
  if (!objectp(target) || target->query("id") == "mu ren")
    return notify_fail("你要吸取谁的精神？\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着！\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能施用化功大法吸人精力！\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
  if (me->query_temp("apply/shade_vision"))
    return notify_fail("隐身之后还想吸精？做人不能太无耻。\n");
  if ((int)me->query_skill("huagong-dafa", 1) < 300)
    return notify_fail("你的化功大法功力不够，不能吸取对方的精神。\n");
  if ((int)me->query("jingli", 1) < 1000)
    return notify_fail("你的精力不够，不能使用化功大法。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的内力不够。\n");
  if ((int)target->query("jing") < 1000 || !living(target))
    return notify_fail(target->name() + "已经精神涣散，你已经无法从他体内吸取精力了！\n");
  if (me->query("jing", 1) > me->query("max_jing", 1) * 2)
    return notify_fail("你只觉精神饱满，似乎不需要再吸取更多的精神了。\n");
  if (me->query_skill_mapped("force") != "huagong-dafa")
    return notify_fail("你没正确激发该技能 。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
  //	if ( !me->query("xy_huiyuan") && target->query("id") == "nai niu" && domain_file(base_name(environment(me))) == "party" )
  //		return notify_fail(HIY"帮会中奶牛只提供给注册会员使用，你无法吸取。\n"NOR);

  message_vision(HIR "$N突然神秘的一笑，双掌一前一後对准$n的太阳穴拍了过来！\n\n" NOR, me, target);
  me->add("jingli", -100);
  me->add("jingli", -100);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1	
  if (living(target)) {
    me->kill_ob(target);
    if (!target->is_killing(me)) target->kill_ob(me);
  }
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "huagong-dafa",
    1
  ) + me->query_skill("zhaixinggong", 1) + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("force");
  ap = ap * ((int)me->query("breakup") + (int)me->query("breakup") * (int)me->query("breakup") + 100) / 100;
  dp = dp * ((int)target->query("breakup") + (int)target->query("breakup") * (int)target->query("breakup") + 100) / 100;
  damage1 = (int)me->query_skill("huagong-dafa", 1) + target->query("jiali");
  damage = damage1 / 2 + random(damage1 / 2);
  if (random(ap) > dp / 3) {
    tell_object(target, HIR "你猛觉额角两侧如针刺般剧痛，神志迷困，头脑中一片空白！\n" NOR);
    target->receive_damage("jing", damage, me);
    target->receive_wound("jing", damage / 2, me);
    me->add("jing", damage);
    me->add("eff_jing", damage / 2);
    if (target->query("jingli") > damage) target->add("jingli", -damage);
    me->add("jingli", damage);
    if (me->query("eff_jing") > me->query("max_jing")) me->set("eff_jing", me->query("max_jing"));
    if (me->query("jing") > me->query("eff_jing")) me->set("jing", me->query("eff_jing"));
    tell_object(me, HIG "你觉得" + target->name() + "的精力(" + damage + ")自手掌源源不绝地流了进来。\n" NOR);
    //		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
  } else {
    message_vision(HIY "可是$p看破了$P的企图，机灵地闪了开去。\n" NOR, me, target);
  }
  me->start_busy(1);
  return 1;
}
void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
