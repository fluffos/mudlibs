#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string family_zhan();
int quanzhen_qizi();
int nanhai_shenni();
void create() {
  int jibie;
  jibie = 8000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("黄药师", ({ "huang yaoshi", "huang", "yaoshi" }));
  set("nickname", HIY "东邪" NOR);
  set("gender", "男性");
  set("age", 42);
  set("long",
    "他就是桃花岛主。行事好恶全由己心，因此被人称作「东邪」。\n");
  set("attitude", "peaceful");

  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("chat_chance", 1);
  set("chat_msg", ({
    "黄药师叹了口气道：“唉 …… 蓉儿这苦命的孩子，从小就没了娘 ……”\n",
    "黄药师低头沉思，悠然不语。\n",
  }));
  set("inquiry", ([
    "黄蓉": "你敢直称我女儿的闺名？ \n",
    "九阴真经": "如果你能帮我取得真经上册，我一定重重谢你。\n",
    "全真七子": (: quanzhen_qizi :),
    "南海神尼": (: nanhai_shenni :),
    "门派战争": (: family_zhan :),
  ]));


  set("combat_exp", 600000000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("finger", 500 + jibie / 3 + random(jibie / 5));
  set_skill("count", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));  // 读书识字
  set_skill("luoying-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lanhua-shou", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yuxiao-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("bibo-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tanzhi-shentong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xuanfeng-tui", 500 + jibie / 3 + random(jibie / 5));
  set_skill("anying-fuxiang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("luoying-shenjian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qimen-wuxing", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "bibo-shengong");
  map_skill("unarmed", "luoying-zhang");
  map_skill("dodge", "anying-fuxiang");
  map_skill("finger", "tanzhi-shentong");
  map_skill("parry", "xuanfeng-tui");
  map_skill("sword", "yuxiao-jianfa");

  create_family("桃花岛", 1, "岛主");

  setup();

  carry_object(__DIR__ "obj/yuxiao")->wield();
  carry_object(__DIR__ "obj/bupao")->wear();
  carry_object("/clone/book/jiuyin2");
  carry_object("d/taohua/obj/xiang");

}
#include "/quest/haojie/family_zhan.h"
void attempt_apprentice(object ob) {
  if (ob->query("int", 1) < 25) {
    command("say 蠢得要死，滚吧！");
    return;
  }
  if (ob->query("con", 1) < 25) {
    command("say 你这体质恐怕难以练习桃花岛的高深功夫！");
    return;
  }
  if ((int)ob->query("score", 1) > 100000) {
    message_vision("黄老邪道：老子最看不惯你这种虚名之人！\n", ob);
    return;
  }
  if ((int)ob->query_skill("bibo-shengong", 1) < 1000) {
    command("say 你的本门内功心法太低了,还是努努力先提高一下吧!");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，如何能与天下五绝的弟子争锋。");
    return;
  }
  if ((int)ob->query("shen") > 100000 || (int)ob->query("shen") < -100000) {
    command("say 我桃花岛与世隔绝，向来不与您这种成名人物打交道，您请回吧！");
    return;
  }
  command("say 很好，很好。");
  command("recruit " + ob->query("id"));
}
int accept_object(object who, object ob) {

  if ((string)ob->query("id") == "jiuyin zhenjing1") {
    if (who->query("family/family_name") == "桃花岛" && who->query("family/master_id") == "huang yaoshi") {
      who->set_temp("jm_taohua1", 1);
      message_vision("黄药师看了看$N送来的秘籍，拍了拍你的头，面露温笑说道：\n"
        "" + RANK_D->query_respect(who) + "资质上佳，或可将我桃花岛众多绝学融会贯通。\n", who);
      return 1;
    } else {
      if (!(int)who->query_temp("tmark/黄")) who->set_temp("tmark/黄", 0);
      message_vision("黄药师看了看$N送来的秘籍，点了点头，说道：\n"
        "难得你将真经送回。你送我的东西我就收下了。\n"
        "作为补偿,你可以从我这里学点功夫。\n", who);
      who->add_temp("tmark/黄", 120);
      return 1;
    }
  }
  return 0;
}
int prevent_learn(object me, string skill) {
  if ((int)me->query_temp("tmark/黄") && me->query("family/family_name") != "桃花岛") {
    if (!(int)me->query_temp("tmark/黄"))
      return 1;
    else
      return 0;
  } else return ::prevent_learn(me, skill);
}
int recognize_apprentice(object ob) {
  mapping myfam;
  myfam = (mapping)ob->query("family");
  if (mapp(myfam))
    if (myfam["family_name"] == "桃花岛") return 1;
  if ((int)ob->query_temp("tmark/黄") == 1)
    message_vision("黄药师看了看$N，说道：咱们现在是谁也不欠谁,\n"
      "你不要再找我学习技艺了。\n", ob);
  if (!(int)ob->query_temp("tmark/黄")) return 0;
  ob->add_temp("tmark/黄", -1);
  return 1;
}
//桃花岛解密-挑战北斗七星阵
int quanzhen_qizi() {
  object me, obj;
  me = this_player();
  obj = present("taohua ling", me);
  if (obj && me->query_temp("jm_taohua1") && me->query_temp("jm_taohua2") && (string)me->query("family/family_name") == "桃花岛") {
    message_vision(HIB "黄药师说道：老道士本事倒是不错，可他七个弟子全是沽名钓誉之辈！\n" NOR, me);
    message_vision(HIB "黄药师大笑道：这全真七子大言不惭，自以为是，你可替为师去破了他北斗七星阵！\n" NOR, me);
    me->set_temp("jm_taohua3", 1);
  } else {
    message_vision(YEL "黄药师冷哼一声！！\n", me);
    message_vision(YEL "黄药师看了你一眼道：全真七子迂腐不堪，学不到老道士的真传。\n" NOR, me);
    message_vision(YEL "黄药师说道：北斗七星阵不是你能破解的！\n" NOR, me);
  }

  return 1;
}
//桃花岛解密-挑战南海神尼
int nanhai_shenni() {
  object me, obj;
  me = this_player();
  obj = present("taohua ling", me);
  if (obj && me->query_temp("jm_taohua1") && me->query_temp("jm_taohua2") && (string)me->query("family/family_name") == "桃花岛") {
    message_vision(HIC "黄药师说道：昔日龙女侠在绝情崖留字，随南海神尼医治情花之毒！\n" NOR, me);
    message_vision(HIC "黄药师说道：南海神尼自绝情崖昙花一现，江湖中再也没有踪迹！\n" NOR, me);
    message_vision(HIC "黄药师说道：神雕大侠浪迹江湖，一直在寻找南海神尼，探听龙女侠下落，可歌可泣！\n" NOR, me);
    message_vision(HIC "黄药师说道：" + RANK_D->query_respect(me) + "若遇到南海神尼，可代我东海桃花岛拜访神尼！\n" NOR, me);
    me->set_temp("jm_taohua4", 1);
  } else {
    message_vision(YEL "黄药师看了你一眼道：南海神尼？。\n" NOR, me);
    message_vision(YEL "黄药师说道：我久居东海，从未听闻南海神尼，你该不会是在骗我吧！\n", me);
  }

  return 1;
}
//全真教解密-挑战天下五绝
int accept_fight(object ob) {
  object me = this_object();

  if (!ob->query_temp("jm_quanzhen2")) return 1;
  remove_call_out("checking");
  call_out("checking", 1, me, ob);
  if (ob->query_temp("jm_quanzhen2")) ob->set_temp("jm_fight", 1);
  return 1;
}
int checking(object me, object ob) {
  int my_max_qi, his_max_qi;
  my_max_qi = me->query("max_qi");
  his_max_qi = ob->query("max_qi");

  if (!present(ob, environment())) return 1;
  if (((int)ob->query("qi") * 100 / his_max_qi) < 50 && ob->query("family/master_id") == "wang chongyang" && ob->query_temp("jm_quanzhen2")) {
    message_vision("黄药师哈哈一笑，那终南山的老道士倒是有几分水平，不过你嘛就差得远了！\n", ob);
    //		ob->delete_temp("jm_quanzhen2");
    ob->delete_temp("jm_fight");
    return 1;
  }
  if (((int)me->query("eff_qi") * 100 / my_max_qi) < 40 && ob->query("family/master_id") == "wang chongyang" && ob->query_temp("jm_quanzhen2")) {
    message_vision("黄药师笑道：这位" + RANK_D->query_respect(ob) + "跟我玩阴的？\n", ob);
    message_vision("黄药师哼一声：老夫向来明人不做暗事！\n", ob);
    //		ob->delete_temp("jm_quanzhen2");
    ob->delete_temp("jm_fight");
    if (random(5) == 1) ob->die();
    return 1;
  }
  if (((int)me->query("qi") * 100 / my_max_qi) <= 50 && ((int)me->query("eff_qi") * 100 / my_max_qi) >= 40 && ob->query("family/master_id") == "wang chongyang" && ob->query_temp("jm_quanzhen2")) {
    command("say 青出於蓝胜於蓝，不愧是重阳真人嫡传弟子！\n");
    message_vision("黄药师微微一笑道：长江后浪推前浪，一代新人换旧人。\n", ob);
    //		ob->delete_temp("jm_quanzhen2");
    ob->delete_temp("jm_fight");
    ob->set_temp("jm_quanzhen_dongxie", 1);
    return 1;
  }
  if (me->is_fighting()) {
    call_out("checking", 3, me, ob);
    return 1;
  }
  return 1;
}
