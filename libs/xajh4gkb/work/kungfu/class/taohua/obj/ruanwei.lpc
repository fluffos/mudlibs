//软猬甲-名器
#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create()
{
    set_name(BLK "软猬甲" NOR, ({ "ruanwei jia","ruanwei","jia", }) );
    set_weight(1000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "件");
		set("icon", "10088");
        set("armor_type", "cloth");
        set("value",1000000);
		set("armor_prop/unarmed", 10);
		set("armor_prop/parry", 10);
		set("armor_prop/dodge", 5);
		set("armor_prop/armor", 600);
    }
}
int query_autoload() { return 1; }
