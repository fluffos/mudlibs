// rong.c 黄蓉
inherit NPC;
inherit F_MASTER;
string ask_chicken();
int gai_jiuyin();
void create() {
  int jibie;
  jibie = 3000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("黄蓉", ({ "huang rong", "huang", "rong" }));
  set("title", "桃花岛主独生爱女");
  set("gender", "女性");
  set("age", 18);
  set("long",
    "这是桃花岛主的独生女儿。由于岛主夫人早死，岛主对这个女儿备加疼爱。\n"
    "她生性跳脱飞扬，喜欢四处乱跑。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("combat_exp", 583200);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("bibo-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("luoying-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("anying-fuxiang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("luoying-shenjian", 500 + jibie / 3 + random(jibie / 5));

  map_skill("force", "bibo-shengong");
  map_skill("unarmed", "luoying-zhang");
  map_skill("dodge", "anying-fuxiang");
  map_skill("sword", "luoying-shenjian");

  create_family("桃花岛", 2, "弟子");
  set("inquiry", ([
    "叫化鸡": (: ask_chicken :),
    "伪九阴真经": (: gai_jiuyin :)
  ]));
  setup();
  carry_object(__DIR__ "obj/ruanwei")->wear();
  carry_object(__DIR__ "obj/shudai")->wear();
}
void init() {
  object ob;
  mapping myfam;

  ::init();
  add_action("do_kiss", "kiss");
  if (interactive(ob = this_player()) && !is_fighting()) {
    myfam = (mapping)ob->query("family");
    if ((!myfam || myfam["family_name"] != "桃花岛") &&
      (!wizardp(ob))) {
      remove_call_out("saying");
      call_out("saying", 2, ob);
    }
  }
}
int do_kiss(string arg) {
  object ob;
  ob = this_player();
  if (!arg || !id(arg))
    return 0;

  if ((string)ob->query("gender") == "男性")
    command("say 救命啊！救命啊！" + ob->query("name") + "要非礼我！\n");
  else
    message_vision("\n黄蓉对$N笑道：“好姐姐不要这样，我怕痒！”\n", ob);
  return 0;
}
void saying(object ob) {
  if (!ob || environment(ob) != environment())
    return;
  if ((string)ob->query("gender") == "男性")
    message_vision("\n黄蓉面现惊奇之色，打量了$N一眼，说到：“你是什么人，"
      "竟敢乱闯我的闺房？\n再不滚出去，看我怎么整你！”\n", ob);
  else
    message_vision("\n黄蓉看了看$N，说到：“好久没生人来过了，"
      "不知这位姐姐可有我靖哥哥的消息？\n", ob);
}
void attempt_apprentice(object ob) {
  command("say 我年纪这么小就收徒弟，岂不让人笑掉大牙！");
}
string ask_chicken() {
  if (this_player()->query_temp("marks/鸡1", 1))
    return "你这个人怎么这么烦？老说车轱辘话！\n";
  else {
    say("蓉儿神往地说：叫化鸡可是杭州著名特产，我爹当年费了好大的劲才搞到了制作\n"
      "它的秘方。你问它来干什么？\n");
    this_player()->set_temp("marks/鸡1", 1);
    return "你可以出去了。\n";
  }
}

int gai_jiuyin() {
  object me, ob;

  ob = this_object();
  me = this_player();

  if (me->query_temp("jm/baituo1")) {
    message_vision(HIB "老毒物把大师傅打伤了，逼问靖哥哥九阴真经，这可如何是好呢？\n" NOR, me);
    message_vision(HIB "黄蓉眼珠子一转，嘻嘻一笑，喊道：靖哥哥有办法了！” \n" NOR, me);
    message_vision(HIB "靖哥哥：咋们把这九阴真经东改一条，西颠倒一下，以老毒物的功力，也不至于走火入魔！” \n" NOR, me);
    command("say 好了，你可以把九阴真经交给我了，我给你改一改吧。\n");
    me->set_temp("jm/baituo2", 1);
  } else {
    message_vision(HIC "什么！九阴真经！快给我看看！我好给靖哥哥和师傅练习！” \n" NOR, me);
    message_vision(HIC "你没有九阴真经，居然敢骗我！我得给你点苦头吃吃！” \n" NOR, me);
    message_vision(HIC "你的九阴真经来路不明，谁知道是真是假！看来得让你知道本姑娘的厉害！” \n" NOR, me);
    message_vision(HIM "黄蓉掏出一只绿油油的叫花鸡扔给你，你顿时只觉得腥味扑鼻。。。。\n", me);
    me->apply_condition("snake_poison", 30);
    me->unconcious();
  }

  return 1;
}

int accept_object(object me, object ob) {
  //	ob = this_object();
  //	me = this_player(); 
  if ((string)ob->query("id") == "jiuyin zhenjing") {
    if (me->query_temp("jm/baituo2") && me->query("shen") > 1000000) {
      message_vision(HIC "黄蓉说道：稍等片刻，我去与靖哥哥将这本秘籍的文字给改一改......\n", me);
      message_vision(HIC "黄蓉说道：听说老毒物当年败给重阳真人后，就一直谋算这本九阴真经!!!!!!!!!\n", me);
      message_vision(HIC "黄蓉说道：好了，这本《九阴真经》靖哥哥已经改动好了，就交给你吧！！！\n", me);
      message_vision(CYN "黄蓉说道：这本伪九阴真经内容真真假假，你切记不可修炼，拿去找老毒物指点吧！！！>\n", me);

      ob = new("/clone/book/jiuyin3.lpc");
      ob->set("owner", me->query("id"));  //设定识别
      ob->move(this_player());
      me->set_temp("jm/baituo3", 1);
      return 1;
    } else {
      message_vision(HIR "黄蓉惊喜的看了看$N送来的经书，说道：多谢了，靖哥哥说你面目憎恶，一看就不是好人！这本书还是让靖哥哥与大师傅保管吧。\n", me);
      return 1;
    }
  }

  return 0;
}
