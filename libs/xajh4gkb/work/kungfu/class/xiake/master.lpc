// sample master.c code
// xiake island master.c
inherit NPC;
inherit F_MASTER;
void consider();
void create()
{
	int jibie;
	jibie = 8000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 1); 
    set_name("龙亦凡", ({"island master", "long", "master"}));
    set("nickname", "不败神龙");
    set("gender", "男性");
    set("age", 80);
    set("long", 
        "这难道就是传说中的侠客岛岛主龙亦凡吗？\n他看上去跟一般的中年人无异，可是他已有百岁高龄。\n");
    set("attitude", "peaceful");
    
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("kar", 30);
	set("per", 30);
	set("npcbiaoji",1);
    
    set("combat_exp", 100000000);
    
    set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("taixuan-gong", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("literate", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));	
    
	map_skill("force", "taixuan-gong");
	map_skill("unarmed", "taixuan-gong");
	map_skill("dodge", "taixuan-gong");
	map_skill("parry", "taixuan-gong");
    
    setup();
}
    
