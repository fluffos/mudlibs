inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int do_look(string target);
string ask_zhen();
void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", -1);
  set_name("洪凌波", ({ "hong ling bo", "hong" }));
  set("long",
    "她肤色白润 ，双颊晕红，两眼水汪汪的。让人看了还想看。\n");
  set("gender", "女性");
  set("age", 17);
  set("attitude", "heroism");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("combat_exp", 1000000);
  set("score", 8500);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunv-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("meinv-quanfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wudu-shenzhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qiufeng-chenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("whip", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunv-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("throwing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));

  map_skill("force", "yunv-xinfa");
  map_skill("unarmed", "wudu-shenzhang");
  map_skill("dodge", "yunv-shenfa");
  map_skill("parry", "wudu-shenzhang");
  map_skill("whip", "qiufeng-chenfa");
  set("inquiry", ([
    "李莫愁": "那是我师傅，不该问的别问，小心我宰了你。",
    "林朝英": "那是我的师祖，不该你问的你别问，小心我宰了你。",

  ]));

  create_family("古墓派", 6, "弟子");
  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();

}
