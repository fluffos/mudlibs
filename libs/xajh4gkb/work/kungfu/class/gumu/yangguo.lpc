#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;
inherit F_MASTER;
int do_kill(object me, object dest);
void create() {
  int jibie;
  jibie = 7000;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("杨过", ({ "yang guo", "yang" }));
  set("nickname", HIG "神雕大侠" NOR);
  set("gender", "男性");
  set("age", 30);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("long", "他是一位高大的男子，相貌俊秀。\n" +
    "一只长袖空空如也，显是断了一臂，尽管如此，\n" +
    "仍然掩不住他迷人的风采。\n");
  set("combat_exp", 5000000);
  set("score", 10000);

  set("attitude", "peaceful");

  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("anranxiaohun-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("quanzhen-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunv-xinfa", 500 + jibie / 3 + random(jibie / 5));
  //	set_skill("yunv-xinjing", 500+jibie/3+random(jibie/5));	
  set_skill("yunv-shenfa", 500 + jibie / 3 + random(jibie / 5));
  map_skill("sword", "quanzhen-jianfa");
  map_skill("force", "yunv-xinfa");
  map_skill("parry", "anranxiaohun-zhang");
  map_skill("unarmed", "anranxiaohun-zhang");
  map_skill("dodge", "yunv-shenfa");

  set("inquiry", ([
    "小龙女": "她就在小屋里。\n",
  ]));
  create_family("古墓派", 3, "弟子");
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  add_money("gold", 2);
}


int do_kill(object me, object dest) {
  if (objectp(dest) && present(dest, environment(me))
    && !environment(me)->query("no_fight")) {
    message_vision(HIR "$N对$n说道：我一见邪派高手就生气。"
      +RANK_D->query_rude(dest) + "，纳命来！\n" NOR, me, dest);
    me->set_leader(dest);
    me->kill_ob(dest);
    dest->fight_ob(me);

    call_out("checking", 0, me, dest);
  } else
    call_out("waiting", 1, me, dest);

  return 1;
}
