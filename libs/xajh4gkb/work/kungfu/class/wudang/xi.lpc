// xi.c 张松溪
inherit NPC;
void create()
{
	int jibie;
	jibie = 2000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 1); 
    set_name("张松溪", ({ "zhang songxi", "zhang" }));
    set("nickname", "武当四侠");
    set("long", 
        "他就是张三丰的四弟子张松溪。\n"
        "一个身材矮小，满脸精悍之色的汉子，因精明能干，以足智多谋著称。\n");
    set("gender", "男性");
    set("age", 40);
    set("attitude", "peaceful");

	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("kar", 30);
	set("per", 30);
	set("npcbiaoji",1);
    set("combat_exp", 1500000);
    set("score", 60000);
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("taiji-shengong", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("tiyunzong", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("taiji-quan", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("sword", 500+jibie/3+random(jibie/5));
    set_skill("taiji-jian", 500+jibie/3+random(jibie/5));
    set_skill("taoism", 500+jibie/3+random(jibie/5));
    set_skill("literate", 500+jibie/3+random(jibie/5));
    map_skill("force", "taiji-shengong");
    map_skill("dodge", "tiyunzong");
    map_skill("unarmed", "taiji-quan");
    map_skill("parry", "taiji-jian");
    map_skill("sword", "taiji-jian");
    create_family("武当派", 3, "弟子");
    setup();
    carry_object("/clone/weapon/changjian")->wield();
    carry_object("/d/wudang/obj/whitecloth")->wear();
}
