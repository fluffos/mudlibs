// famu.c 伐木
inherit NPC;
void create()
{
	int jibie;
	jibie = 150;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 1); 
    set_name("伐木道长", ({ "famu daozhang", "famu" }));
    set("long", 
        "他是武当山的伐木道长, 专为庙中提供木材。\n");
    set("gender", "男性");
    set("age", 30);
    set("attitude", "peaceful");
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("kar", 30);
	set("per", 30);
	set("npcbiaoji",1);
    set("combat_exp", 5000);
    set("score", 1000);
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("blade", 500+jibie/3+random(jibie/5));
    set_skill("taiji-dao", 500+jibie/3+random(jibie/5));
    set_skill("taoism", 500+jibie/3+random(jibie/5));
    map_skill("parry", "taiji-dao");
    map_skill("blade", "taiji-dao");
    create_family("武当派", 7, "弟子");
    setup();
    carry_object("/clone/weapon/gangdao")->wield();
    carry_object("//clone/cloth/hic_cloth")->wear();
}
