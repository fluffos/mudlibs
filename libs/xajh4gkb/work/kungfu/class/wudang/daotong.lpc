// daotong.c 道童
inherit NPC;
void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("道童", ({ "dao tong", "daotong", "tong" }));
  set("long",
    "他是武当山的小道童。\n");
  set("gender", "男性");
  set("age", 16);
  set("attitude", "peaceful");

  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("combat_exp", 2000);
  set("score", 1000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_temp("apply/attack", 15);
  set_temp("apply/defense", 15);
  set_temp("apply/damage", 5);
  create_family("武当派", 10, "弟子");
  setup();

  carry_object("/d/wudang/obj/greyrobe")->wear();
  carry_object("/d/obj/quest/chai");
}
