// zhang.c 张三丰
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string family_zhan();
int ask_zhenwuzhen();
int ask_pojian();
int ask_taiji();
void create()
{
	int jibie;
	jibie = 9000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 1); 
    set_name("张三丰", ({ "zhang sanfeng", "zhang" }));
    set("nickname", HIG "邋遢真人" NOR);
    set("long", 
        "他就是武当派开山鼻祖、当今武林的泰山北斗张三丰真人。\n"
        "身穿一件污秽的灰色道袍，不修边幅。\n"
        "身材高大，年满百岁，满脸红光，须眉皆白。\n");
    set("gender", "男性");
    set("age", 100);
    set("attitude", "peaceful");
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("kar", 30);
	set("per", 30);
	set("npcbiaoji",1);
    set("score", 500000);
    set("combat_exp", 516637500);
		
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("taiji-shengong", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("tiyunzong", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("taiji-quan", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("sword", 500+jibie/3+random(jibie/5));
    set_skill("taiji-jian", 500+jibie/3+random(jibie/5));
    set_skill("blade", 500+jibie/3+random(jibie/5));
    set_skill("taiji-dao", 500+jibie/3+random(jibie/5));
    set_skill("taoism", 500+jibie/3+random(jibie/5));
    set_skill("literate", 500+jibie/3+random(jibie/5));
    set_skill("yinyun-ziqi", 500+jibie/3+random(jibie/5));	
    map_skill("force", "taiji-shengong");
    map_skill("dodge", "tiyunzong");
    map_skill("unarmed", "taiji-quan");
    map_skill("parry", "taiji-jian");
    map_skill("sword", "taiji-jian");
    map_skill("blade", "taiji-dao");
    create_family("武当派", 1, "开山祖师");
    set("class", "taoist");

	set("inquiry",([
                   "真武七截阵"   : (: ask_zhenwuzhen :),
				   "破剑式" :(: ask_pojian :),
				   "太极无极" :(: ask_taiji :),
				   "门派战争" :(: family_zhan :),
	               ]));	
	
    setup();
    carry_object("/clone/weapon/changjian")->wield();
    carry_object("/d/wudang/obj/greyrobe")->wear();
}
#include "/quest/haojie/family_zhan.h"
void attempt_apprentice(object ob)
{
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，没办法领悟老道的太极精髓。");
        command("say 是否应该去江湖中多加磨炼。");
		return ;
    }		 	
    if ((int)ob->query_skill("taiji-shengong", 1) < 1000) 
	{
        command("say 我武当派乃内家武功，最重视内功心法。"); 
        command("say " + RANK_D->query_respect(ob) + 
            "是否还应该在太极神功上多下点功夫？");
        return;
    }
    if ((int)ob->query("shen") < 10000000) 
	{
        command("say 学武之人，德义为先，功夫的高低倒还在其次，未练武，要先学做人。");
        command("say 在德行方面，" + RANK_D->query_respect(ob) +
            "是否还做得不够？");
        return;
    }
    if (ob->query("int",1) < 30) 
	{
        command("say 我武当派武功全从道藏悟出。");
        command("say 太极要能达到炉火纯青之境，悟性却是半点也马虎不得。");
        return;
    }
    if (ob->query("con",1) < 30) 
	{
        command("say 我武当派内功最重根骨。");
        return;
    }
    command("chat 哈哈哈哈！！！！");
    command("chat 想不到老道在垂死之年，又觅得一个可塑之才，真是可喜可贺。");
    command("recruit " + ob->query("id"));
	return;
}

int ask_zhenwuzhen()
{
	object me;
	me = this_player();
	
	if ( me->query_temp("jm_wudang4") && me->query_temp("jm_wudang5") && (string)me->query("family/family_name") == "武当派" && me->query("family/master_id")=="zhang sanfeng")
	{
		message_vision(HIB"张三丰说道：真武七截阵实乃一套剑阵，若二人合力，则攻守妆备，威力大暗。\n""若三人同使，比二人同使的威力又强一倍。\n""四人相当于八位高手，五人相当于十六位，六人相当于三十二位，七人相当于六十四位当世一流高手同时出手。\n" NOR,me);
		message_vision(HIB"张三丰说道：天将降大任于斯人也，必先苦其心志劳其筋骨。\n""若你能通过真武七截阵的考验，我或许可以将一项重任交给你。\n" NOR,me);
		me->set_temp("jm_wudang6",1);
	}
	else 
	{
		message_vision(YEL"张三丰说道：真武七截阵是从真武神像座前的龟、蛇二山山势演化而来，决非一人之力能同时施为。\n", me);	
	}
	
	return 1;
}

int ask_pojian()
{
	object me;
	me = this_player();
	
	if ( me->query_temp("jm_wudang7") && (string)me->query("family/family_name") == "武当派" && me->query("family/master_id")=="zhang sanfeng")
	{
		message_vision(HIB"张三丰笑着说道：想不到"+ RANK_D->query_respect(me) +"威武不凡，我派后继有人。\n" NOR,me);
		message_vision(HIB"张三丰说道：昔年我与那剑宗风清扬比武，他使用了一招破剑式，结果真武剑丢了。\n" NOR,me);
		message_vision(HIB"张三丰说道："+ RANK_D->query_respect(me) +"入我武当学艺多年，今日可去与那风清扬比划一番，扬我武当威名。\n" NOR,me);
		me->set_temp("jm_wudang8",1);
	}
	else 
	{
		message_vision(YEL"张三丰说道：破剑式号称破尽天下剑法，我看未必吧。\n", me);	
	}
	
	return 1;
}

int ask_taiji()
{
	object me;
	me = this_player();
	
	if ( me->query_temp("jm_wudang9") && (string)me->query("family/family_name") == "武当派" && me->query("family/master_id")=="zhang sanfeng")
	{
		message_vision(HIB"张三丰说道：无极万物之始，动则无极生太极，静则太极而无极。是故易有太极，是生两仪。\n" NOR,me);
		message_vision(HIB"张三丰说道：旭日朝升之时，阴阳割昏晓，混沌分两极。\n" NOR,me);
		message_vision(HIB"张三丰说道：武当金顶，旭日初升，紫气东来。你可以去此地参悟太极大道。\n" NOR,me);
		me->set_temp("jm_wudang10",1);
	}
	else 
	{
		message_vision(YEL"张三丰说道：在太极之上而不为高；在六极之下而不为深；先天地而不为久；长于上古而不为老。\n", me);	
	}
	
	return 1;
}