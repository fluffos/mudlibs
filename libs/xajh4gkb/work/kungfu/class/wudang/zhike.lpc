// zhike.c 知客
inherit NPC;
void create() {
  int jibie;
  jibie = 150;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 1);
  set_name("知客道长", ({ "zhike daozhang", "zhike" }));
  set("long",
    "他是武当山的知客道长。\n");
  set("gender", "男性");
  set("age", 30);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("combat_exp", 5000);
  set("score", 1000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taiji-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taoism", 500 + jibie / 3 + random(jibie / 5));
  map_skill("parry", "taiji-jian");
  map_skill("sword", "taiji-jian");
  create_family("武当派", 7, "弟子");
  setup();
  carry_object("/d/wudang/obj/greenrobe")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}
