// mo.c 莫声谷
inherit NPC;
void create()
{
	int jibie;
	jibie = 2000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 1); 
    set_name("莫声谷", ({ "mo shenggu", "mo" }));
    set("nickname", "武当七侠");
    set("long", 
        "他就是张三丰的七弟子莫声谷。\n"
        "他看起来二十多岁，显得稚气未脱。\n"
        "但也是江湖中行侠仗义，声明远播的侠客。\n");
    set("gender", "男性");
    set("age", 40);
    set("attitude", "peaceful");

	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("kar", 30);
	set("per", 30);
	set("npcbiaoji",1);
    set("combat_exp", 1100000);
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("taiji-shengong", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("tiyunzong", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("taiji-quan", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("sword", 500+jibie/3+random(jibie/5));
    set_skill("taiji-jian", 500+jibie/3+random(jibie/5));
    set_skill("literate", 500+jibie/3+random(jibie/5));
    map_skill("force", "taiji-shengong");
    map_skill("dodge", "tiyunzong");
    map_skill("unarmed", "taiji-quan");
    map_skill("parry", "taiji-jian");
    map_skill("sword", "taiji-jian");
    create_family("武当派", 3, "弟子");
    setup();
    carry_object("/clone/weapon/changjian")->wield();
    carry_object("/d/wudang/obj/whiterobe")->wear();
}
