// song.c 宋远桥
inherit NPC;
int ask_xuanming();
void create() {
  int jibie;
  jibie = 2000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 1);
  set_name("张翠山", ({ "zhang cuishan", "zhang" }));
  set("nickname", "武当五侠");
  set("long",
    "他就是张三丰的五弟子、武当七侠之中的张翠山。\n"
    "身穿一件干干净净的白色道袍。\n");
  set("gender", "男性");
  set("age", 31);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("combat_exp", 150000);
  set("score", 60000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taiji-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tiyunzong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taiji-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taiji-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "taiji-shengong");
  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-quan");
  map_skill("parry", "taiji-quan");
  map_skill("sword", "taiji-jian");
  create_family("武当派", 3, "弟子");
  set("inquiry", ([
    "玄冥二老": (: ask_xuanming :),
  ]));

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/wudang/obj/whiterobe")->wear();
}

int ask_xuanming() {
  object me;
  me = this_player();

  if (me->query_temp("jm_wudang2") && (string)me->query("family/family_name") == "武当派") {
    message_vision(HIB "张翠山说道：可怜无忌孩儿深中玄冥寒毒，这玄冥二老实在可恶。\n" NOR, me);
    message_vision(HIB "张翠山说道：我武当弟子，定要为翠山报此之仇。 \n" NOR, me);
    message_vision(HIB "张翠山说道：最近听闻江南出了一座绿柳山庄，你可去探访一番。 \n" NOR, me);
    me->set_temp("jm_wudang3", 1);
  } else {
    message_vision(YEL "张翠山说道：这玄冥二老的玄冥神掌极其歹毒，人人得而诛之。\n", me);
  }

  return 1;
}
