// hong.c 洪七公
inherit NPC;
inherit F_MASTER;
string family_zhan();
int ask_xianglong();

void create()
{
	int jibie;
	jibie = 8000;
//	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
    set("shen_type", 1); 
    set_name("洪七公", ({"hong qigong", "hong", "qigong"}));
    set("nickname", HIW "九指神丐" NOR);
    set("gender", "男性");
    set("age", 75);
    set("long", 
        "他就是丐帮第十七任帮主，号称“北丐”的洪七公老爷子。\n");
    set("attitude", "peaceful");
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
	set("kar", 30);
	set("per", 30);
	set("npcbiaoji",1);
   set("combat_exp", 30000000+random(70000000));	
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("huntian-qigong",500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("xianglong-zhang", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("xiaoyaoyou", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("club", 500+jibie/3+random(jibie/5));
    set_skill("dagou-bang", 500+jibie/3+random(jibie/5));
    set_skill("begging", 500+jibie/3+random(jibie/5));
    set_skill("checking", 500+jibie/3+random(jibie/5));         
    set_skill("blade", 500+jibie/3+random(jibie/5));  
    set_skill("liuhe-dao", 500+jibie/3+random(jibie/5));  	
    map_skill("force", "huntian-qigong");
    map_skill("unarmed", "xianglong-zhang");
    map_skill("dodge", "xiaoyaoyou");
    map_skill("parry", "xianglong-zhang");
    map_skill("club", "dagou-bang");
	map_skill("blade","liuhe-dao");
    
    create_family("丐帮", 17, "帮主");
	 set("chat_chance", 1);
    set("chat_msg", ({
        "洪七公叹了口气道：“唉……何时能再吃到蓉儿做的「叫化鸡」啊……”\n",
        "洪七公说道：“俗话说「吃在江南」，所以老叫化特地跑来扬州看看。”\n",
        "洪七公喃喃道：“我们丐帮的「降龙十八掌」是天下最霸道的掌法。”\n",
    }));
    set("chat_chance_combat", 80);
    set("chat_msg_combat", ({
         (: command("unwield yuzhu zhang") :),
    }) );
    set("inquiry", ([
        "打狗棍法" : "打狗棍法的秘密就藏在玉竹杖中。\n",
        "丐帮" : "东北西北东西北。\n",
        "拜师" : "你可以去东城门找我帮总舵的鲁有脚，拜他为师。\n",
		"降龙掌法" :(: ask_xianglong :),
		"门派战争" :(: family_zhan :),
    ]));

    setup();
    
    carry_object(__DIR__"obj/yuzhu_zhang")->wield();
    carry_object("/clone/cloth/pcloth")->wear();
}
#include "/quest/haojie/family_zhan.h"
void attempt_apprentice(object ob)
{
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
		command("say 依我看" + RANK_D->query_respect(ob) + "的经验太低了，收你为衣钵传人将来会丢老叫花的面子。");
		return ;
    }
	if ((int)ob->query_skill("huntian-qigong",1)<1000)
    {
		command("say 这位" + RANK_D->query_respect(ob) + "对我丐帮的内功似乎领悟不够啊。");
		return ;
    }
	if ((int)ob->query("score",1)<100000)
    {
		message_vision("洪七公疑惑的看着你说道：你对我派似乎不够忠诚？\n",ob);
		return ;
    }
    if ((int)ob->query("str",1) < 30 ) 
	{
        command("say 当叫化子起码要有气力打的了狗，依我看" + RANK_D->query_respect(ob) + "的资质似乎不适合当叫化子？");
        return;
    }
    if ((int)ob->query("int",1) < 30 ) 
	{
        command("say 依我看以" + RANK_D->query_respect(ob) + "的悟性恐怕难以将打狗棒法练到深处。");
        return;
    }
    if (mapp(ob->query("family")) && (string)ob->query("family/family_name") != "丐帮") 
	{
        command("say " + RANK_D->query_respect(ob) + "既然已有名师指点，何必又来拜老叫化呢？");
        return;
    }
    command("recruit " + ob->query("id"));
    if((string)ob->query("class") != "beggar")
        ob->set("class", "beggar");
    
}
int accept_object(object who, object ob)
{
    object ob_yzz;
    if (ob->query("food_supply") <= 0)
        return 0;
    if ((string)ob->query("name") != "叫化鸡") {
        command("say 老叫化对" + (string)ob->query("name") + "没什么兴趣……");
        return 0;
    }
/*   if (query("food") >= max_food_capacity() - ob->query("food_supply")) {
        command("say 老叫化现在饱得很。");
        return 0;
    }*/
    command("say 啊……这正是我想吃的叫化鸡呀！");
    command("eat ji");
    command("say 想不到你小小年纪，心思却很细，就跟当年的蓉儿一样！");
    if ((string)who->query("family/family_name") != "丐帮") 
	{
        command("say " + RANK_D->query_respect(who) + "你还呆在这里干什么？");
        return 1;
    }
    if( who->query_temp("marks/鸡4") )
    {
		ob_yzz = new("/kungfu/class/gaibang/obj/yuzhu_zhang.lpc");
        ob_yzz->move(who);
        write("这根竹杖跟随我多年了，就送给你作见面礼吧，你可以拿去参详打狗棍法的奥义。");
		who->set_temp("jm_gaibang1",1);
        return 1;
    }
    else
    {
        write("不过你来得不是时候，玉竹杖已经给别人了。");
        return 1;
    }
    return 1;
}


int ask_xianglong()
{
	object me,ob;
	me = this_player();
	ob = this_object();
	
	if ( me->query_temp("jm_gaibang/ouyangfeng") && me->query_temp("jm_gaibang/qiuqianren") && (string)me->query("family/family_name") == "丐帮")
	{
		message_vision(HIB"洪七公说道：很好！这位"+RANK_D->query_respect(me)+"为江湖弘扬正气。\n" NOR,me);
		message_vision(HIC"洪七公大笑道：降龙掌以刚猛见长，若能习得后续的降龙十式，则刚柔兼济！” \n" NOR,me);
		me->set_temp("jm_gaibang3",1);
		return 1;
	}
	else 
	{
		message_vision(YEL"洪七公说到：这铁掌帮的裘千仞为非作歹，有损上官老帮主的威名......\n", me);	
		message_vision(YEL"洪七公说道：这西毒欧阳锋与我有一段恩怨未了......” \n" NOR,me);		
		message_vision(YEL"洪七公笑道：这位"+RANK_D->query_respect(me)+"要想得授降龙十式，恐怕得为我丐帮做点事情” \n" NOR,me);
		return 1;		
	}
	
	return 1;
}

//全真教解密-挑战天下五绝
int accept_fight(object ob)
{
    object me  = this_object();
    
    if ( !ob->query_temp("jm_quanzhen2") ) return 1;
    remove_call_out("checking");
    call_out("checking", 1, me, ob);   
	if ( ob->query_temp("jm_quanzhen2") ) ob->set_temp("jm_fight",1);
    return 1;
}
int checking(object me, object ob)
{
    int my_max_qi, his_max_qi;
    my_max_qi  = me->query("max_qi");
    his_max_qi = ob->query("max_qi");

    if ( !present(ob, environment()) ) return 1; 
    if (( (int)ob->query("qi")*100 / his_max_qi) < 50 && ob->query("family/master_id")=="wang chongyang" && ob->query_temp("jm_quanzhen2")) 
    {
		message_vision("洪七公笑道，这位" + RANK_D->query_respect(ob) + "分明没有学到重阳真人的真本事啊，还是再多练几年吧！\n", ob);
//		ob->delete_temp("jm_quanzhen2");
		ob->delete_temp("jm_fight");
        return 1;
    }	
    if ( ((int)me->query("eff_qi")*100 / my_max_qi) < 40 && ob->query("family/master_id")=="wang chongyang" && ob->query_temp("jm_quanzhen2")) 
    {
        message_vision("洪七公怒道：切磋武艺点到为止，你怎可下此黑手！\n", ob);
//		ob->delete_temp("jm_quanzhen2");
		ob->delete_temp("jm_fight");
        return 1;
    }	
    if (((int)me->query("qi")*100 / my_max_qi) <= 50 && ((int)me->query("eff_qi")*100 / my_max_qi) >= 40 && ob->query("family/master_id")=="wang chongyang" && ob->query_temp("jm_quanzhen2")) 
    {
        command("say 青出於蓝胜於蓝，不愧是重阳真人嫡传弟子！\n");
        message_vision("洪七公一笑道：长江后浪推前浪，一代新人换旧人。\n", ob);
//		ob->delete_temp("jm_quanzhen2");
        ob->set_temp("jm_quanzhen_beigai",1);
		ob->delete_temp("jm_fight");
        return 1;
    }
    if (me->is_fighting()) 
    {
        call_out("checking",3, me, ob);
		return 1;
    }	
    return 1;  
}