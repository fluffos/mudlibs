//玉竹杖-名器
#include <ansi.h>
#include <weapon.h>

inherit CLUB;

void create()
{
	set_name("玉竹杖", ({"yuzhu zhang", "zhu", "stick"}));
	set_weight(5000);

	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("long", "一根泛着淡淡青光的竹杖，乃丐帮帮主信物。\n");
		set("value", 10000);
		set("material", "bamboo");
		set("wield_msg", "$N抽出一根青光闪闪的竹杖抓在手中。\n");
		set("unwield_msg", "$N把手中的玉竹杖插回腰中。\n");
		set("weapon_prop/dodge", 10);	
		set("weapon_prop/intelligence", 10);	
		set("weapon_prop/dexerity", 10);
		set("weapon_prop/parry", 10);		
		set("weapon_prop/club", 30);	
	}
	init_club(420,2);	
	setup();
}	
int query_autoload() { return 1; }
