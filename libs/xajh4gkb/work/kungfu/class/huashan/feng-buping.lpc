// feng-buping.c  封不平
inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create() {
  int jibie;
  jibie = 4000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 1);
  set_name("封不平", ({ "feng buping", "feng" }));
  set("nickname", YEL "狂风快剑" NOR);
  set("gender", "男性");
  set("class", "swordsman");
  set("title", "华山剑宗第十二代弟子");
  set("age", 45);
  set("long",
    "封不平是华山剑宗第一高手，满脸戾气一张黄焦焦的面皮。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("combat_exp", 1000000);
  set("apprentice_available", 3);

  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huashan-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zixia-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huashan-zhangfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huashan-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("kuangfeng-blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("kuangfeng-jian", 500 + jibie / 3 + random(jibie / 5));
  map_skill("sword", "kuangfeng-jian");
  map_skill("parry", "kuangfeng-jian");
  map_skill("force", "zixia-shengong");
  map_skill("unarmed", "huashan-zhangfa");
  map_skill("dodge", "huashan-shenfa");

  create_family("华山派", 12, "弟子");
  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob) {
  if (query("apprentice_available")) {
    if (find_call_out("do_recruit") != -1)
      command("say 慢著，一个一个来。");
    else
      call_out("do_recruit", 2, ob);
  } else {
    command("say 老夫今天已经收了三个弟子，不想再收徒了。");
  }
}

void do_recruit(object ob) {
  if ((int)ob->query_skill("huashan-jianfa", 1) < 1000) {
    command("say 我看" + RANK_D->query_respect(ob) + "的华山剑法还没学到家吧。");
    return;
  }
  if ((int)ob->query("con", 1) < 25) {
    command("say 我华山气宗以内功为主，依我看" + RANK_D->query_respect(ob) + "的根骨不适合学我华山内功。");
    return;
  }
  if ((int)ob->query("dex", 1) < 25) {
    command("say 我华山剑宗以剑法为主，依我看" + RANK_D->query_respect(ob) + "的身法似乎不适合学我华山派剑法？");
    return;
  }

  command("say 好，好，好，很好。");
  command("recruit " + ob->query("id"));
  return;
}

int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("title", "华山剑宗第十四代弟子");
  //                ob->set("class", "huashan");
  add("apprentice_availavble", -1);
}
void reset() {
  //        delete_temp("learned");
  set("apprentice_available", 3);
}
