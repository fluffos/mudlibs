// masteryue.c
inherit NPC;
inherit F_MASTER;
string family_zhan();
int ask_sanxian();
void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", -1); 
        set_name("岳不群", ({ "yue buqun", "master", "yue" }) );
        set("title", "华山派现任掌门");
        set("nickname", "君子剑");        
        set("gender", "男性");
        set("age", 40);
        set("long",
 "他就是华山派的现任掌门人，江湖上人称“君子剑”的岳不群。他看上去\n"
 "是个和善的中年人，对人总是彬彬有礼，很有一代宗师的风范。\n" );
      
	set("attitude", "peaceful");
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
	set("kar", 30);
	set("per", 30);
	set("npcbiaoji",1);
    set("rank_info/respect", "岳掌门");
	set("combat_exp", 10000000);

	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("blade", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("strike", 500+jibie/3+random(jibie/5));
	set_skill("zixia-shengong", 500+jibie/3+random(jibie/5));
	set_skill("poyu-quan", 500+jibie/3+random(jibie/5));
	set_skill("fanliangyi-dao", 500+jibie/3+random(jibie/5));
	set_skill("huashan-jianfa", 500+jibie/3+random(jibie/5));
	set_skill("hunyuan-zhang", 500+jibie/3+random(jibie/5));
    set_skill("huashan-shenfa",500+jibie/3+random(jibie/5));
    set_skill("huashan-zhangfa",500+jibie/3+random(jibie/5));	
	set_skill("literate", 500+jibie/3+random(jibie/5));
	set_skill("pixie-jian", 500+jibie/3+random(jibie/5));		
	map_skill("unarmed", "huashan-zhangfa");
	map_skill("force", "zixia-shengong");
    map_skill("dodge", "pixie-jian");
    map_skill("parry", "huashan-jianfa");
	map_skill("blade", "fanliangyi-dao");
	map_skill("sword", "pixie-jian");
	map_skill("strike", "hunyuan-zhang");
    create_family("华山派", 12, "掌门人");
/*
	set("inquiry", ([
		"紫霞秘籍": "对不起，你来晚了，紫霞秘籍并不在我这里。\n",
		"辟邪剑谱": "你问辟邪剑谱,那是歪门邪道的武功，问来干什么。\n",
		"手令": "手令，你想进我的书房偷东西吗，抓贼啊。"
	]) );  */	
    set("inquiry", ([
		"夺命连环三仙剑" :(: ask_sanxian :),
		"门派战争" :(: family_zhan :),
    ]) );
		
    setup();
    carry_object("//clone/cloth/long_cloth")->wear();
    carry_object("/clone/weapon/changjian")->wield();
}
#include "/quest/haojie/family_zhan.h"
void attempt_apprentice(object ob)
{
	if( (int)ob->query("con",1) < 25 )
    {
        command("say 我华山气宗以内功为主，依我看"+RANK_D->query_respect(ob)+"的根骨不适合学我华山内功。");
		return;
    }
    if ((int)ob->query("dex",1) < 25) {
        command("say 我华山剑宗以剑法为主，依我看" + RANK_D->query_respect(ob) + "的身法似乎不适合学我华山派剑法？");
        return;
    }
    if ((int)ob->query_skill("zixia-shengong",1) < 1000)
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的华山内功还没学到家吧。");
        return;
    }	
	if ((int)ob->query("score",1)<50000)
    {
		message_vision("岳不群阴阴的看着你说道：你对我派似乎不够忠诚？\n",ob);
		return ;
    }
	if( (string)ob->query("gender") == "女性" )
	{
		command("say 我不收女弟子的，姑娘还是另访名师吧。");
		return;
	}
                
	command("nod");
	command("say " + RANK_D->query_respect(ob) + "日后必成大器 ！\n");                
	command("recruit " + ob->query("id") );
	return;
}
void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "swordsman");
}

int ask_sanxian()
{
	object me,ob;
	me = this_player();
	ob = this_object();
	
	if ( me->query_temp("jm_huashan1") && me->query_temp("jm_huashan2") && (string)me->query("family/family_name") == "华山派")
	{
		message_vision(HIB"岳不群说道：很好！这位"+RANK_D->query_respect(me)+"为我派立下大功。\n" NOR,me);
		message_vision(HIB"岳不群大笑道：这次五岳会盟必能夺得五岳盟主，我派一统江湖指日可待！” \n" NOR,me);
		message_vision(HIC"岳不群说道：三十年前，我五岳派在华山论剑，被魔教偷袭！我派众多高手死于后山，或许留下了什么......” \n" NOR,me);
		message_vision(HIC"岳不群说道：看在"+RANK_D->query_respect(me)+"的忠心下，告诉你一点三仙剑的秘密，剩下的我就不清楚了。。。。。。” \n" NOR,me);
		message_vision(HIC"岳不群说道：这位"+RANK_D->query_respect(me)+"去我派后山看看吧，或许能有所收获。” \n" NOR,me);
		me->set_temp("jm_huashan3",1);
	}
	else 
	{
		message_vision(YEL"岳不群嘿嘿一笑！！！\n", me);	
		message_vision(YEL"岳不群摇头道：这位"+RANK_D->query_respect(me)+"你我交情并不深啊！” \n" NOR,me);		
		message_vision(YEL"岳不群说道：吾平生有两大心愿，若你能为我完成，或许我可告诉你点什么！” \n" NOR,me);
		return 1;		
	}
	
	return 1;
}

int accept_object(object me, object ob)
{

	if ( (string)ob->query("id") =="kuihua baodian2" )
	{
            if ( (string)me->query("family/family_name") == "华山派" && me->query("id")==ob->query("owner"))
			{
				message_vision("$N对$n说道：昔日从林家弄来的辟邪剑谱似乎并不完整，然来关键之处在于此！\n", this_object(),me);
                message_vision("$N对$n说道：不错不错，这位"+RANK_D->query_respect(me)+"果然与我有缘......\n", this_object(),me);
				message_vision("$N对$n说道：若我练成此完整的辟邪剑法剑法，必能夺得五岳盟主之位！！！\n", this_object(),me);
                message_vision("$N对$n说道：嵩山左冷禅欲吞并五岳派！！！\n"+"这位"+RANK_D->query_respect(me)+"若能为我铲除此劲敌，我将允许你去我华山派思过崖参悟华山前辈的剑法。\n", this_object(),me);
				me->set_temp("jm_huashan1",1);
				return 1;
            } else
			{
                message_vision("$N对$n说道：多谢这位"+RANK_D->query_respect(me)+"，这本剑谱我就笑纳了。\n",this_object(),me);
				return 1;
			}
	}

	return 0;
}