// jingxuan.c 静玄
// create by host dec,11
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  int jibie;
  jibie = 3000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 1);
  set_name("静玄", ({ "jing xuan", "jing", "xuan" }));
  set("long",
    "她是峨嵋派大师姐，跟随灭绝师太二十余载，峨嵋派的基本功夫已尽得所传。\n");
  set("gender", "女性");
  set("age", 40);
  set("attitude", "peaceful");
  set("nickname", HIY "大师姐" NOR);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("combat_exp", 3850000);
  set("score", 100000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("strike", 500 + jibie / 3 + random(jibie / 5));
  set_skill("linji-zhuang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jinding-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huifeng-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yanxing-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tiangang-zhi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhutian-bu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yugalism", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dushi-jiren", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("dodge", "zhutian-bu");
  map_skill("parry", "huifeng-jian");
  map_skill("sword", "huifeng-jian");
  map_skill("force", "linji-zhuang");
  map_skill("unarmed", "tiangang-zhi");
  map_skill("blade", "yanxing-dao");
  prepare_skill("strike", "jinding-zhang");
  prepare_skill("unarmed", "tiangang-zhi");

  create_family("峨嵋派", 4, "弟子");
  set("class", "bonze");
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}

void attempt_apprentice(object ob) {

  object me;
  me = this_player();

  if ((string)ob->query("gender") != "女性") {
    command("say 我怎么能够收男子为徒呢？");
    return;
  }
  if (ob->query("family/family_name") != "峨嵋派") {
    command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
    return;
  }
  if ((int)ob->query("shen") < 0) {
    command("say 我峨嵋乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) + "是否还做得不够？");
    return;
  }
  if ((int)ob->query_skill("linji-zhuang", 1) < 500) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我峨嵋内功似乎领会的不够。");
    return;
  }
  if ((int)ob->query_skill("huifeng-jian", 1) < 500) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我峨嵋剑法似乎领会的不够。");
    return;
  }
  if ((string)me->query("class") == "bonze") {
    command("nod");
    command("recruit " + ob->query("id"));
  } else {
    command("say 阿弥陀佛！善哉！善哉！施主若真心皈依我佛，可去静心那里受戒。\n");
    return;
  }

}
