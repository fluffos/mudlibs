// miejue.c 灭绝
// create by host dec,12

inherit NPC;
inherit F_MASTER;
string family_zhan();
int ask_tulongdao();
int ask_dachengfojing();

void create() {
  int jibie;
  jibie = 6000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 1);
  set_name("灭绝", ({ "mie jue", "mie", "jue" }));
  set("long",
    "她是一位白发苍苍的老尼，是峨嵋派第三代掌门，她脸上冷冰冰，毫无表情。\n");

  set("gender", "女性");
  set("age", 60);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("combat_exp", 20000000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("finger", 500 + jibie / 3 + random(jibie / 5));
  set_skill("linji-zhuang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jinding-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huifeng-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yanxing-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tiangang-zhi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhutian-bu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yugalism", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dushi-jiren", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("dodge", "zhutian-bu");
  map_skill("parry", "huifeng-jian");
  map_skill("sword", "huifeng-jian");
  map_skill("force", "linji-zhuang");
  map_skill("unarmed", "jinding-zhang");
  map_skill("blade", "yanxing-dao");
  map_skill("finger", "tiangang-zhi");

  set("inquiry", ([
    "屠龙刀": (: ask_tulongdao :),
    "大乘佛经": (: ask_dachengfojing :),
    "门派战争": (: family_zhan :),
  ]));

  create_family("峨嵋派", 3, "掌门");
  set("class", "bonze");
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  //        carry_object("/clone/weapon/changjian")->wield();
  //        carry_object("/d/emei/obj/yitian-jian")->wield();
  carry_object("/clone/weapon/yitian")->wield();
}
#include "/quest/haojie/family_zhan.h"
void attempt_apprentice(object ob) {

  string *prename = ({ "静" });
  string name, new_name;
  if ((string)ob->query("gender") != "女性") {
    command("say 我怎么能够收男子为徒呢？");
    return;
  }
  if ((string)ob->query("class") != "bonze") {
    command("say 阿弥陀佛！善哉！善哉！施主若真心皈依我佛，可去静心那里受戒。");
    return;
  }
  if ((int)ob->query("shen") < 0) {
    command("say 我峨嵋乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) + "是否还做得不够？");
    return;
  }
  if (ob->query("married")) {
    command("say 入我门者，最忌妄动尘缘！" + RANK_D->query_respect(ob) + "还是请回吧！");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    command("say 是否应该去江湖中多加磨炼。");
    return;
  }
  if (ob->query_skill("linji-zhuang", 1) < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我峨嵋内功似乎领会的不够。");
    command("say 是否应该多在这上面下点功夫。");
    return;
  }
  if (ob->query_skill("huifeng-jian", 1) < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我峨嵋剑法似乎领会的不够。");
    command("say 是否应该多在这上面下点功夫。");
    return;
  }
  if ((int)ob->query("score", 1) < 100000) {
    message_vision("灭绝师太疑惑的看着你说道：你对我派似乎不够忠诚？\n", ob);
    return;
  }
  if (ob->query("int", 1) < 25) {
    command("sigh");
    command("say 这位" + RANK_D->query_respect(ob) + "恐怕悟性差了一点。");
    command("say 不过尚大有潜力，还是先回去磨练磨练。");
    return;
  }
  if (ob->query("con", 1) < 25) {
    command("sigh");
    command("say 这位" + RANK_D->query_respect(ob) + "恐怕根骨差了一点。");
    command("say 不过尚大有潜力，还是先回去磨练磨练。");
    return;
  }
  if (ob->query("per", 1) < 25) {
    command("sigh");
    command("say 这位" + RANK_D->query_respect(ob) + "长得是否过于抽象。");
    command("say 我看还是先去洗洗再来吧。");
    return;
  }
  name = ob->query("name");
  new_name = prename[random(sizeof(prename))] + name[2..3];
  ob->set("name", new_name);
  command("smile");
  command("say 从今以后你的法名叫做" + new_name + "。");
  command("recruit " + ob->query("id"));
  return;
}

int accept_object(object me, object ob) {
  if ((string)ob->query("id") == "tulong dao") {
    if ((string)me->query("family/family_name") == "峨嵋派" && me->query("family/master_id") == "mie jue" && me->query_temp("jm_emei1")) {
      message_vision(HIC "武林至尊，宝刀屠龙，号令天下，莫敢不从，倚天不出，谁与争锋！\n", this_object(), me);
      message_vision(
        HIC "灭绝师太拍了拍这位" + RANK_D->query_respect(me) + "，微微笑道：吾徒果然天人之姿，为我派夺回屠龙宝刀。\n",
        this_object(),
        me
      );
      message_vision(
        HIC "灭绝师太说道：我峨嵋派与明教一向水火不容，前有杨逍掳我派弟子纪晓芙，后有张无忌纠缠我派周芷若，此乃奇耻大辱！\n",
        this_object(),
        me
      );
      message_vision(HIC "灭绝师太说道：谁若能铲除明教，可去我派佛塔研习大乘佛经。\n", this_object(), me);
      me->set_temp("jm_emei2", 1);
      return 1;
    } else {
      message_vision(
        HIY "$N对$n说道：多谢这位" + RANK_D->query_respect(me) + "，这屠龙刀我就笑纳了。\n",
        this_object(),
        me
      );
      return 1;
    }
  }
  if ((string)ob->query("id") == "yangxiao rentou" && me->query("id") == ob->query("owner")) {
    if ((string)me->query("family/family_name") == "峨嵋派" && me->query("family/master_id") == "mie jue" && me->query_temp("jm_emei2")) {
      message_vision("$N对$n说道：哈哈哈！这杨逍狗贼，总算有今日。\n", this_object(), me);
      message_vision("$N对$n说道：吾徒果然有本事，今日为我派报此一仇.........\n", this_object(), me);
      message_vision(
        "$N对$n说道：这位" + RANK_D->query_respect(me) + "若能再铲除明教教主.........\n",
        this_object(),
        me
      );
      me->set_temp("jm_emei3", 1);
      return 1;
    } else {
      message_vision("$N对$n说道：这明教作恶多端，总算是报应不爽。\n", this_object(), me);
      return 1;
    }
  }
  if ((string)ob->query("id") == "zhangwuji rentou" && me->query("id") == ob->query("owner")) {
    if ((string)me->query("family/family_name") == "峨嵋派" && me->query("family/master_id") == "mie jue" && me->query_temp("jm_emei2")) {
      message_vision("$N对$n说道：哈哈哈！这张无忌多次纠缠我教周芷若，始乱终弃，鼠辈！！！\n", this_object(), me);
      message_vision("$N对$n说道：吾徒果然本领高强，必能将我峨嵋发扬光大。\n", this_object(), me);
      message_vision(
        "$N对$n说道：这位" + RANK_D->query_respect(me) + "今日铲除明教教主，为武林除害。\n",
        this_object(),
        me
      );
      me->set_temp("jm_emei4", 1);
      return 1;
    } else {
      message_vision("$N对$n说道：这明教作恶多端，总算是报应不爽。\n", this_object(), me);
      return 1;
    }
  }
  return 0;
}

int ask_tulongdao() {
  object me, ob;
  me = this_player();
  ob = this_object();

  if ((string)me->query("family/family_name") == "峨嵋派") {
    message_vision(HIB "武林至尊，宝刀屠龙，号令天下，莫敢不从，倚天不出，谁与争锋！\n" NOR, me);
    message_vision(HIB "灭绝师太说道：我派祖师一直流传着倚天剑屠龙刀的秘密，据说藏着绝世武学！” \n" NOR, me);
    message_vision(HIB "灭绝师太说道：这位" + RANK_D->query_respect(me) + "可否替老身取来屠龙刀？” \n" NOR, me);
    me->set_temp("jm_emei1", 1);
  } else {
    message_vision(YEL "灭绝师太冷哼一声道：这位" + RANK_D->query_respect(me) + "是想觊觎我派倚天剑吧！” \n" NOR, me);
  }

  return 1;
}
int ask_dachengfojing() {
  object me, ob;
  me = this_player();
  ob = this_object();

  if ((string)me->query("family/family_name") == "峨嵋派" && me->query("family/master_id") == "mie jue" && me->query_temp("jm_emei2") && me->query_temp("jm_emei3") && me->query_temp("jm_emei4")) {
    message_vision(HIB "武林至尊，宝刀屠龙，号令天下，莫敢不从，倚天不出，谁与争锋！\n" NOR, me);
    message_vision(
      HIB "灭绝师太说道：这位" + RANK_D->query_respect(me) + "铲除了明教，为我派报仇雪恨，此乃大功一件。” \n" NOR,
      me
    );
    message_vision(HIB "灭绝师太说道：这位" + RANK_D->query_respect(me) + "可去我派大悲塔参阅大乘佛经。” \n" NOR, me);
    me->set_temp("jm_emei5", 1);
  } else {
    message_vision(
      YEL "灭绝师太冷哼一声道：这位" + RANK_D->query_respect(me) + "对我派毫无贡献，还想参阅大乘佛经！！！” \n" NOR,
      me
    );
  }

  return 1;
}
