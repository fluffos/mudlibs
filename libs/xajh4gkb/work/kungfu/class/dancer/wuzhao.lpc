// master.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_posui();

void create() {
  int jibie;
  jibie = 10000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name(HIC "武曌" NOR, ({ "wu zhao", "", "dancer" }));
  set("title", HIG "战神殿传人" NOR);
  set("nickname", HIR "女帝" NOR);
  set("gender", "女性");
  set("age", 42);
  set("long", "「女帝」武曌是唯一将《道心种魔大法》修成道胎魔种之人，将两种极端归一，故能压制圣门和魔门，从而成就帝位。\n");
  set("attitude", "peaceful");
  set("class", "dancer");
  set("apprentice_available", 10);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("no_dun", 1);

  set("combat_exp", 150000000);
  set("chat_chance_combat", 5);
  set("chat_msg_combat", ({
    "看朱成碧思纷纷，憔悴支离为忆君。不信比来长下泪，开箱验取石榴裙。\n",
    "九玄眷命，三圣基隆。奉承先旨，明台毕功。 宗祀展敬，冀表深衷。永昌帝业，式播淳风。\n",
    "羲农首出，轩昊膺期。唐虞继踵，汤禹乘时。天下光宅，海内雍熙。上玄降鉴，方建隆基。\n",
    "神功不测兮运阴阳，包藏万宇兮孕八荒。天符既出兮帝业昌，愿临明祀兮降祯祥。\n",
  }));
  set("inquiry", ([
    "破碎虚空": (: ask_posui :),
  ]));

  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("whip", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shuiyue", 500 + jibie / 3 + random(jibie / 5));
  set_skill("cxwx-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wangran-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("chixin-bianfa", 500 + jibie / 3 + random(jibie / 5));
  map_skill("dodge", "shuiyue");
  map_skill("unarmed", "cxwx-quan");
  map_skill("force", "wangran-xinfa");
  map_skill("whip", "chixin-bianfa");
  map_skill("parry", "chixin-bianfa");
  create_family("战神殿", 10, "传人");

  setup();
  carry_object("/clone/cloth/snake_sandal")->wear();
  carry_object("/clone/weapon/lanyue")->wield();
}
#include "/kungfu/class/dancer/wuzhao-posui.h"
