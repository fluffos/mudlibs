// master.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_tianren();

void create() {
  int jibie;
  jibie = 8000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name(HIM "师妃暄" NOR, ({ "shi feixuan", "feixuan", "dancer" }));
  set("title", HIY "慈航静斋传人" NOR);
  set("nickname", HIC "出尘仙子" NOR);
  set("gender", "女性");
  set("age", 22);
  set("long", "师妃暄乃慈航静斋的圣女、唯一传人，绝世美女，清丽如仙子，与其相处均感受到似乎有氤氲仙气缭绕，谈吐优雅，智计超乎常人。\n");
  set("attitude", "peaceful");
  set("class", "dancer");
  set("apprentice_available", 10);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("no_dun", 1);

  set("combat_exp", 150000000);
  set("chat_chance_combat", 5);
  set("chat_msg_combat", ({
    "我不是曾爱上你，而是直至此刻仍感到我们在深深热恋着，那是一种永恒深刻纯粹精神的爱恋滋味，永远伴随着我。\n",
    "假若子陵能把分离视作相聚，失正是得，妃暄将可无牵无挂，探窥天道，否则不如放弃清修，长伴君旁，免受相思的折磨。\n",
    "妃暄不是要和你分出胜负，而是分出生死，你若狠不下杀妃暄的心，根本没当皇帝的资格！\n",
    "巴蜀的命运，就由妃暄的色空剑和少帅的井中月决定如何！\n",
  }));
  set("inquiry", ([
    "天人之道": (: ask_tianren :),
  ]));

  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("throwing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("whip", 500 + jibie / 3 + random(jibie / 5));
  set_skill("snow-step", 500 + jibie / 3 + random(jibie / 5));
  set_skill("snow-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("bingxue-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("snow-whip", 500 + jibie / 3 + random(jibie / 5));
  map_skill("dodge", "snow-step");
  map_skill("unarmed", "snow-zhang");
  map_skill("force", "bingxue-xinfa");
  map_skill("whip", "snow-whip");
  create_family("慈航静斋", 10, "传人");

  setup();
  carry_object("/clone/cloth/snake_sandal")->wear();
}
#include "/kungfu/class/dancer/feixuan-tianren.h"
