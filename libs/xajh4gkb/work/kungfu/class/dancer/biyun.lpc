// master.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_xiantian();

void create() {
  int jibie;
  jibie = 6000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name(HIB "碧云" NOR, ({ "bi yun", "biyun", "dancer" }));
  set("title", HIC "焚静山庄传人" NOR);
  set("nickname", HIR "回音仙子" NOR);
  set("gender", "女性");
  set("age", 22);
  set("long", "碧云是一个十分出色的美女，她弹的一手琵琶更是闻名千里，许多\n"
    "王侯子弟，富商豪客都为她天下无双的美貌与琴艺倾倒。\n");
  set("attitude", "peaceful");
  set("class", "dancer");
  set("apprentice_available", 10);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("no_dun", 1);

  set("combat_exp", 150000000);
  set("chat_chance_combat", 5);
  set("chat_msg_combat", ({
    "碧云嫣然一笑，一个转身迳自舞了起来，对眼前这场恶斗似乎全不放在心上。\n",
    "碧云脚步轻移，翩翩地转了几个圈，回眸一笑。\n",
    "碧云用手扶了扶自己的发簪，像是怕被对手碰歪似地。\n",
    "碧云笑嘻嘻地拾起地上一片从" HIM "魔鞭翩珑" NOR
    "上落下的花瓣。\n",
  }));
  set("inquiry", ([
    "先天意境": (: ask_xiantian :),
  ]));

  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("throwing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("whip", 500 + jibie / 3 + random(jibie / 5));
  set_skill("snow-step", 500 + jibie / 3 + random(jibie / 5));
  set_skill("snow-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("bingxue-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("snow-whip", 500 + jibie / 3 + random(jibie / 5));
  map_skill("dodge", "snow-step");
  map_skill("unarmed", "snow-zhang");
  map_skill("force", "bingxue-xinfa");
  map_skill("whip", "snow-whip");
  create_family("焚静山庄", 10, "传人");

  setup();
  carry_object("/clone/cloth/snake_sandal")->wear();
}
#include "/kungfu/class/dancer/biyun-xiantian.h"
