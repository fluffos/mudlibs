//li.c
inherit NPC;
inherit F_MASTER;

void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
    set("shen_type", -1);	
    set_name("欧阳烈", ({ "ouyang lie","ouyang","lie"}) );
    set("gender", "男性" );
    set("age", 45);
    set("long", "欧阳锋的兄长，为争夺白驼山主之位，死于欧阳锋之手。\n");
    set("attitude", "peaceful");
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
	set("kar", 30);
	set("per", 30);
	set("npcbiaoji",1);
	set("combat_exp", 25000000);
    set_skill("literate", 500+jibie/2+random(jibie/5));		
    set_skill("force", 500+jibie*2+random(jibie/5));
    set_skill("unarmed", 500+jibie*2+random(jibie/5));
    set_skill("dodge", 500+jibie*2+random(jibie/5));
    set_skill("parry", 500+jibie*2+random(jibie/5));
    set_skill("staff", 500+jibie*2+random(jibie/5));
    set_skill("hamagong", 500+jibie/2+random(jibie/5));
    set_skill("chanchu-bufa",500+jibie/2+random(jibie/5));
    set_skill("training",500+jibie/2+random(jibie/5));	
    set_skill("shexing-diaoshou",500+jibie/2+random(jibie/5));
    set_skill("lingshe-zhangfa",500+jibie/2+random(jibie/5));	
    map_skill("force", "hamagong");
    map_skill("dodge", "chanchu-bufa");
    map_skill("unarmed", "shexing-diaoshou");
    map_skill("parry", "lingshe-zhangfa");
    map_skill("staff", "lingshe-zhangfa");
    create_family("白驼山派",2,"护法");
    set("chat_chance", 2);
    set("chat_msg", ({
        "欧阳烈凶狠的说道: 没想到欧阳锋趁我练功之际，竟然行那苟且之事...\n",
        "欧阳烈低声道：那克儿还不知道是谁的种呢...\n",
        "欧阳烈低声道：迟早有一天，定要将那欧阳锋不得好死。\n",
    }) );
    setup();
    carry_object("/clone/weapon/lingshezhang")->wield();
    carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	if ((int)ob->query("xyzx_sys/level")<500)
    {
		message_vision("欧阳烈对你笑道：你的实战经验太低了,我还不能收你！\n",ob);
		return ;
    }	
	if ((int)ob->query_skill("hamagong",1)<300)
    {
		message_vision("欧阳烈对你笑道：我派武功以蛤蟆功为根基，你先打好基础再来！\n",ob);
		return ;
    }	
	if ((int)ob->query("con",1)<25)
    {
		message_vision("欧阳烈对你笑道：我派武功最重根骨，你体质太差了！\n",ob);
		return ;
    }
	command("say 好吧，我收下你。\n");
    command("recruit "+ob->query("id"));
    return;
}
