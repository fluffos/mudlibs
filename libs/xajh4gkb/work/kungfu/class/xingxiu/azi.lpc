// azi.c 阿紫
inherit NPC;
inherit F_MASTER;
int ask_shenmu();
void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", -1);
  set_name("阿紫", ({ "azi" }));
  set("nickname", "星宿派小师妹");
  set("long",
    "她就是丁春秋弟子阿紫。\n"
    "她容颜俏丽，可眼神中总是透出一股邪气。\n");
  set("gender", "女性");
  set("age", 15);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("combat_exp", 60000);
  set("score", 10000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huagong-dafa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhaixinggong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("chousui-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "huagong-dafa");
  map_skill("dodge", "zhaixinggong");
  map_skill("unarmed", "chousui-zhang");
  map_skill("parry", "tianshan-zhang");
  create_family("星宿派", 3, "弟子");
  set("inquiry", ([
    "神木王鼎": (: ask_shenmu :),
  ]));
  setup();
  carry_object("/d/xingxiu/obj/xxqingxin-san");
  carry_object("/d/xingxiu/obj/xxqingxin-san");
  carry_object("/clone/cloth/cloth")->wear();
}
void attempt_apprentice(object ob) {
  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
}

int ask_shenmu() {
  object me;
  me = this_player();
  if ((string)me->query("family/family_name") == "星宿派" && me->query("family/master_id") == "ding chunqiu" && me->query_temp("jm_xingxiu1")) {
    me->set_temp("jm_xingxiu2", 1);
    message_vision(HIG "阿紫笑嘻嘻道：丁老怪这老不死的，竟然还想打我的主意。\n" NOR, me);
    message_vision(HIG "阿紫嘿嘿一笑：神木王鼎我自然是放在最安全的地方了。\n" NOR, me);
    message_vision(HIG "阿紫笑嘻嘻道：" + RANK_D->query_respect(me) + "你就算杀了我，也拿不到神木王鼎。\n" NOR, me);
    message_vision(HIG "阿紫笑嘻嘻道：这天下间唯有我姐夫能保护我。\n" NOR, me);
  } else {
    message_vision(HIY "阿紫笑嘻嘻道：神木王鼎？那可是师傅的宝贝，我那能见得着。\n" NOR, me);
  }
  return 1;
}
