// ding.c 丁春秋
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string family_zhan();
string ask_xiaoyao();
string ask_sanbao();
void create()
{
	int jibie;
	jibie = 5000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", -1); 
    set_name("丁春秋", ({ "ding chunqiu", "ding" }));
    set("nickname", HIR "星宿老怪" NOR);
    set("long", 
        "他就是星宿派开山祖师、令正派人士深恶痛绝的星宿老怪丁春秋。\n"
        "可是他看起来形貌清奇，仙风道骨。\n");
    set("gender", "男性");
    set("age", 60);
//	set("attitude", "friendly")
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("kar", 30);
	set("per", 30);
	set("npcbiaoji",1);
    set("score", 400000);
    set("combat_exp", 30380000);
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("huagong-dafa", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("zhaixinggong", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("chousui-zhang", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("staff", 500+jibie/3+random(jibie/5));
    set_skill("tianshan-zhang", 500+jibie/3+random(jibie/5));
    set_skill("literate", 500+jibie/3+random(jibie/5));
    map_skill("force", "huagong-dafa");
    map_skill("dodge", "zhaixinggong");
    map_skill("unarmed", "chousui-zhang");
    map_skill("parry", "tianshan-zhang");
    map_skill("staff", "tianshan-zhang");
    create_family("星宿派", 1, "开山祖师");
    set("inquiry", ([
		"逍遥派":(:ask_xiaoyao:),
		"星宿三宝":(:ask_sanbao:),	
		"门派战争" :(: family_zhan :),	
    ]) );
    setup();
	carry_object("/clone/weapon/gangzhang")->wield();
    carry_object("/clone/cloth/cloth")->wear();
}
#include "/quest/haojie/family_zhan.h"
void init()
{
	add_action("do_flatter", "flatter");
}
void attempt_apprentice(object me)
{
	if ((int)me->query("betrayer")) 
	{
		command("say 我越看你越象是来卧底的。");
		return;
	}
	if ((int)me->query("con",1)<30) 
	{
		command("say 你这体质如何能学我的独门内功。");
		return;
	}
	if ((int)me->query("score",1)<50000)
    {
		message_vision("丁春秋疑惑的看着你说道：你对我派似乎不够忠诚？\n",me);
		return ;
    }		
	if( me->query_temp("pending/flatter") ) 
	{
		command("say 你如此不把老仙放在眼里，老仙怎会收你？");
		return;
	} else 
	{
		command("say 我星宿老仙比起古往今来的圣人怎么样啊？");
		message_vision("星宿老怪微闭双眼，手捻长须，一付等人拍马(flatter)的样子。\n",
		this_player());
		me->set_temp("pending/flatter", 1);
	}
}
int do_flatter(string arg)
{
	if( !this_player()->query_temp("pending/flatter") ) return 0;
	if (this_player()->query("con",1)<30) return notify_fail("你根骨这么差，老仙不会收你的。\n");		
	if( !arg ) return notify_fail("你说老仙什么？\n");

	this_player()->set_temp("pending/flatter", 0);
	message_vision("$N大声说道：" + arg + "\n", this_player());
	if( strsrch(arg, "星宿老仙") >=0 && (strsrch(arg, "德配天地") >=0 || strsrch(arg, "威震寰宇") >=0 || strsrch(arg, "古今无比") >=0 )) 
	{
		command("smile");
		command("say 这还差不多。\n");
		command("recruit " + this_player()->query("id"));
	} else 
	{
		command("say 你如此不把老仙放在眼里，老仙怎会收你？");
	}
	return 1;
}
int recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) ) add("apprentice_available", -1);
}
string ask_xiaoyao()
{
	object ob;
	ob=this_player();
	if (ob->query("family/family_name") == "星宿派" && ob->query("family/master_id")=="ding chunqiu" && ob->query_temp("jm_xingxiu3"))
    {
		command("sigh");
		ob->set_temp("jm_xingxiu4",1);
		return "逍遥派哪些弟子个个不学无术，明明我武功最高，可师傅就是不将掌门指环传给我，徒儿若有心，去替为师夺来。";
    }
	return "江湖上绝少有人知道逍遥派，但逍遥派武学博大精深。";	
}
string ask_sanbao()
{
	object ob;
	ob=this_player();
	if (ob->query("family/family_name") == "星宿派" )
    {
		command("sigh");
		ob->set_temp("jm_xingxiu1",1);
		return "星宿三宝就是神木王鼎、柔丝锁、三笑逍遥散。可如今柔丝锁不知下落，神木王鼎被阿紫那小贱人盗走。";
    }
	return "小子，你想打我星宿派注意？";	
}
int accept_object(object me, object ob)
{
	if ( (string)ob->query("id") =="shenmu wangding" )
	{
		if ( (string)me->query("family/family_name") == "星宿派" && me->query("family/master_id")=="ding chunqiu" && me->query("id")==ob->query("owner") )
		{
			message_vision(HIC"丁春秋笑道：哈哈哈，阿紫那小贱人必将让其求生不得求死不能。\n"NOR, this_object(),me);
			message_vision(HIC"丁春秋笑道："+RANK_D->query_respect(me)+"我一看你就觉得资质非凡，必能在江湖中扬我星宿派威名。\n"NOR, this_object(),me);
			me->set_temp("jm_xingxiu_shenmu",1);
			if (me->query_temp("jm_xingxiu_rousi") && me->query_temp("jm_xingxiu2")) 
			{
				message_vision(HIG"丁春秋说道：这位"+RANK_D->query_respect(me)+"替为师夺回星宿三宝，吾心大悦！！！\n"NOR, this_object(),me);
				me->set_temp("jm_xingxiu3",1);
			}
		} else
		{
			message_vision("丁春秋大怒道：是不是你盗走了我的神木王鼎？。\n",this_object(),me);
		}
		return 1;
	}	
	if ( (string)ob->query("id") =="rousi suo" )
	{
		if ( (string)me->query("family/family_name") == "星宿派" && me->query("family/master_id")=="ding chunqiu" && me->query("id")==ob->query("owner") )
		{
			message_vision(HIC"丁春秋笑道："+RANK_D->query_respect(me)+"做的不错，我星宿派丢失多年的柔丝锁总算拿回来了。\n"NOR, this_object(),me);
			message_vision(HIC"丁春秋笑道：这柔丝锁乃天山雪蚕丝编织而成，坚韧异常。\n"NOR, this_object(),me);
			me->set_temp("jm_xingxiu_rousi",1);
			if (me->query_temp("jm_xingxiu_shenmu") && me->query_temp("jm_xingxiu1")) 
			{
				message_vision(HIG"丁春秋说道：这位"+RANK_D->query_respect(me)+"替为师夺回星宿三宝，吾心大悦！！！\n"NOR, this_object(),me);
				me->set_temp("jm_xingxiu3",1);
			}
		} else
		{
			message_vision("丁春秋大怒道：是不是你盗走了我星宿派的柔丝锁？。\n",this_object(),me);
		}
		return 1;
	}	
	if ( (string)ob->query("id") =="qibao zhihuan" )
	{
		if ( (string)me->query("family/family_name") == "星宿派" && me->query("family/master_id")=="ding chunqiu" && me->query("id")==ob->query("owner") )
		{
			message_vision(HIC"丁春秋笑道：哈哈哈，这七宝指环本来就应该传给我。\n"NOR, this_object(),me);
			message_vision(HIC"丁春秋笑道：我定要去逍遥派走一趟，带着这掌门之物，定要让逍遥派众人俯首称臣。\n"NOR, this_object(),me);
			if (me->query_temp("jm_xingxiu4")) 
			{
				message_vision(HIG"丁春秋说道：吾徒深得我心，可去我星宿派的逍遥洞中参悟毒功！！！\n"NOR, this_object(),me);
				me->set_temp("jm_xingxiu5",1);
			}
			message_vision(HIC"丁春秋笑道：我星宿派将一统江湖，威震武林。\n"NOR, this_object(),me);
		} else
		{
			message_vision("$N对$n说道：这位"+RANK_D->query_respect(me)+"，这指环我就笑纳了。\n",this_object(),me);
		}
		return 1;
	}	
	return 0;
}
void die()
{
    object me;        
    me = query_temp("last_damage_from");
	if (me && (string)me->query("family/family_name") == "灵鹫宫" && me->query("family/master_id")=="tong lao" && me->query_temp("jm_lingjiu1"))
	{//灵鹫宫解密
		tell_room(environment(this_player()), "丁春秋惊恐道：吾师父无崖子还未死吗？\n");
		tell_room(environment(this_player()), "丁春秋气息微弱，然竟然濒死之际还使出三笑逍遥散.....．\n");
		tell_room(environment(this_player()), "丁春秋发出一道毒气后，内功反噬，毒发身亡。\n");
		me->set_temp("jm_lingjiu2",1);
		me->apply_condition("sanxiao_poison",20);
	}
	if (me && (string)me->query("family/family_name") == "逍遥派" && me->query_temp("jm_xiaoyao1"))
	{//逍遥派解密
		tell_room(environment(this_player()), "丁春秋惊恐道：吾师父无崖子还未死吗？\n");
		tell_room(environment(this_player()), "丁春秋气息微弱，呻吟道：师傅为何不将逍遥掌门传给我.....．\n");
		tell_room(environment(this_player()), "丁春秋哀嚎一声，化功大法反噬，全身功力散尽身亡。\n");
		me->set_temp("jm_xiaoyao2",1);
	}
	if (me && (string)me->query("family/family_name") == "姑苏慕容" && (int)me->query_temp("jm_murong4"))
	{//姑苏慕容解密
		tell_room(environment(this_player()), "你大笑一声道：作恶多端，当有此报，以毒攻毒，必受恶果。\n");
		tell_room(environment(this_player()), "丁春秋脸现诡异之色，似有笑意，不一会，大笑三声，戛然而止，倒地气绝。\n");
		me->set_temp("jm_murong7",1);
	}
	::die();
}