#include <ansi.h>
inherit NPC;

void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("苗若兰", ({ "miao ruolan", "miao", "ruolan" }));
  set("gender", "女性");
  set("title", "苗人凤千金");
  set("age", 17);
  set("long", @LONG
一位衣着秀丽的少女，长得美丽动人。她就是
苗人凤之女苗若兰。
LONG);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("combat_exp", 10000);
  set("score", 20000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lengyue-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sixiang-bufa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("miaojia-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianchang-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "lengyue-shengong");
  map_skill("dodge", "sixiang-bufa");
  map_skill("sword", "miaojia-jian");
  map_skill("parry", "miaojia-jian");
  map_skill("unarmed", "tianchang-zhang");

  set("inquiry", ([
    "苗家剑谱": "剑谱一向是我爹爹收着的，你去问他好了。",
    "胡一刀": "胡伯伯是我爹爹一生中最敬佩的人，可是…唉……",
    "胡斐": "你是说胡大哥？…唉…他已经回辽东了。",
  ]));
  create_family("胡苗世家", 3, "苗家千金");
  //        create_family("中原苗家", 3, "千金");

  setup();

  carry_object("/d/city/npc/cloth/zi-dress")->wear();
  add_money("silver", 20);
}


void attempt_apprentice(object ob) {
  if (ob->query("family/master_id") == "hu fei") {
    command("say 哎呀，胡大哥的弟子我如何能收呢。");
    return;
  }
  command("say 嘻嘻，我就收下你吧。\n");
  command("recruit " + ob->query("id"));
  return;
}
