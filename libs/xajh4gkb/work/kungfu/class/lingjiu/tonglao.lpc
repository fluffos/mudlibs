// /NPC tonglao.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string family_zhan();
int ask_wuyazi();
int ask_huaxiang();

void create()
{
	int jibie;
	jibie = 7000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 0); 
    set_name("天山童姥", ({ "tong lao", "tong", "lao" }));
    set("long",
        "她就是「灵鹫宫」的开山祖师.\n"+
        "乍一看似乎是个八、九岁的女子,可神情却是老气横秋.\n"+
        "双目如电,炯炯有神,向你瞧来时,自有一股凌人的威严.\n");
    set("title", "灵鹫宫主人");
    set("gender", "女性");
    set("age", 96);
    set("nickname", HIR "唯我独尊" NOR);
    set("attitude", "peaceful");
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
	set("kar", 30);
	set("per", 30);
	set("npcbiaoji",1);
     set("combat_exp", 90000000);

    set("score", 200000);
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("sword",500+jibie/3+random(jibie/5));
    set_skill("zhemei-shou",500+jibie/3+random(jibie/5));
    set_skill("liuyang-zhang",500+jibie/3+random(jibie/5));
    set_skill("tianyu-qijian",500+jibie/3+random(jibie/5));
    set_skill("yueying-wubu",500+jibie/3+random(jibie/5));
    set_skill("bahuang-gong", 500+jibie/3+random(jibie/5));
    map_skill("force", "bahuang-gong");
    map_skill("dodge", "yueying-wubu");
    map_skill("unarmed", "liuyang-zhang");
    map_skill("parry", "liuyang-zhang");
    map_skill("sword", "tianyu-qijian");
    create_family("灵鹫宫",1, "开山祖师");
	
	set("inquiry",([
				   "无崖子" :(: ask_wuyazi :),
				   "画像" :(: ask_huaxiang :),
				   "门派战争" :(: family_zhan :),
	               ]));
				   
    setup();
    carry_object("/d/lingjiu/obj/qingyi")->wear();
    carry_object("/d/lingjiu/obj/doupeng")->wear();
    carry_object("/clone/weapon/changjian")->wield();
}
#include "/quest/haojie/family_zhan.h"
void attempt_apprentice(object ob)
{
   
   if ((string)ob->query("gender")!="女性")
    {
        command("say 你找死啊!");
        return;
    }
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
		return ;
    }	
	if ((int)ob->query_skill("bahuang-gong", 1) < 1000) 
    {
        command("say " + RANK_D->query_respect(ob) + "是否还应该多练练八荒六合唯我独尊功？");
        return;
    }
	if ((int)ob->query_skill("liuyang-zhang", 1) < 1000) 
    {
        command("say 我的生死符不是那么好领悟的，你先将其基础打好了再来吧？");
        return;
    }
	if ((int)ob->query("score",1)<100000)
    {
		message_vision("童姥大怒道：你对我派似乎不够忠诚？\n",ob);
		return ;
    }	
	if (ob->query("con",1) < 30) 
	{
        command("say 本门功法极为难练,你的根骨似乎不够.");
        return;
	}
	if (ob->query("per",1) < 25) 
	{
        command("say 长得这么丑，如何能修炼八荒六合唯我独尊功！！！");
        return;
	}
   command("recruit " + ob->query("id"));
	if((string)ob->query("class") != "dancer") ob->set("class", "dancer");
   return;
}

int ask_wuyazi()
{
	object me,ob;
	me = this_player();
	ob = this_object();
	
	if (me->name() == "李秋水" || me->name(1) == "李秋水"|| me->query("family/master_id")=="li qiushui")
	{	
		message_vision(YEL"天山童姥大怒道：李秋水这个贱人，抢我师弟！！！ \n" NOR,me);	
		ob->kill_ob(me);
		me->fight_ob(ob);
		return 1;
	}		
	if ( me->query("family/master_id")=="tong lao" && (string)me->query("family/family_name") == "灵鹫宫" )
	{
		message_vision(HIC"童姥微微一笑道：那是我师弟，当年我们三人同在天山学艺。\n" NOR,me);
		message_vision(HIC"童姥说道：我师弟风度闲雅于琴棋书画、医卜星象无所不通！ \n" NOR,me);
		message_vision(HIC"童姥说道：师弟本可与我双宿双飞，可恨那李秋水竟勾引师弟生下了孩子！ \n" NOR,me);
		message_vision(HIC"童姥说道：李秋水那贱人水性杨花，竟勾引那狗贼丁春秋，导致师弟被丁春秋暗算跌落悬崖！ \n" NOR,me);
		message_vision(HIC"童姥说道：自此之后，师弟再也没有音讯！ \n" NOR,me);
		me->set_temp("jm_lingjiu1",1);
	}
	else 
	{	
		message_vision(YEL"\n自嘲末尽千情万缘已皆愁。\n"NOR
			YEL"\n曲终人散发花鬓白红颜殁。\n"NOR
			YEL"\n烛残未觉与日争辉徒消瘦。\n"NOR
			YEL"\n当泪干血隐狂涌白雪纷飞都成空。 \n" NOR,me);
	}
	
	return 1;
}

int ask_huaxiang()
{
	object me,ob;
	me = this_player();
	ob = this_object();
	
	if (me->name() == "李秋水" || me->name(1) == "李秋水"|| me->query("family/master_id")=="li qiushui")
	{	
		message_vision(YEL"天山童姥大怒道：李秋水这个贱人，抢我师弟！！！ \n" NOR,me);	
		ob->kill_ob(me);
		me->fight_ob(ob);
		return 1;
	}		
	if ( me->query("family/master_id")=="tong lao" && (string)me->query("family/family_name") == "灵鹫宫" && me->query_temp("jm_lingjiu2") && me->query_temp("jm_lingjiu3"))
	{//逍遥派解密
		message_vision(HIB"童姥哈哈一笑道：好徒儿，给吾师报的大仇。\n" NOR,me);
		message_vision(HIB"童姥说道：可恨师弟无崖子竟与李秋水有一孩子！ \n" NOR,me);
		message_vision(HIB"童姥说道：听闻无崖子师弟留一画像，乃师弟毕生最爱之人！ \n" NOR,me);
		me->set_temp("jm_lingjiu4",1);
	}
	else 
	{	
		message_vision(YEL"\n童姥说道：吾师弟无崖子为恶徒丁春秋所害，杳无音信。 \n" NOR,me);
		message_vision(YEL"\n童姥说道：李秋水那贱人害我永远处于童颜之身，定当让其生不如死。 \n" NOR,me);
	}
	
	return 1;
}

int accept_object(object me, object ob)
{
	object monk, room;
	if(!( room = find_object("/d/lingjiu/biguan")) ) room = load_object("/d/lingjiu/biguan");
	monk = present("tong lao", room);
	if ( (string)ob->query("id") =="hua xiang" )
	{
		if ( (string)me->query("family/family_name") == "灵鹫宫" && me->query("family/master_id")=="tong lao" && me->query("id")==ob->query("owner") )
		{
			message_vision("童姥说道：不错不错，这位"+RANK_D->query_respect(me)+"解我一段心结......\n", this_object(),me);
			message_vision("童姥大笑道：师弟，让我看看你究竟爱的是谁！\n", this_object(),me);
			message_vision("童姥打开画像，凝视良久，大笑起来！！！\n", this_object(),me);
			message_vision("童姥大笑道：画中之人不是你...画中之人不是你...画中之人不是你！！！\n", this_object(),me);
			if (me->query_temp("jm_lingjiu6")) 
			{
				message_vision("童姥说道：画中之人不是她，也不是我，没想到师弟居然爱的是她！！！\n", this_object(),me);
				message_vision("童姥童姥心愿了结，然示意无比，默默的说道：我灵鹫宫后殿石窟之中，有数百年前旧主人遗下的石壁图像，你去参详吧！！！\n", this_object(),me);
				me->set_temp("jm_lingjiu7",1);
			}
			return 1;
		} else
		{
			message_vision("$N对$n说道：多谢这位"+RANK_D->query_respect(me)+"，这本画像我就收起来了。\n",this_object(),me);
			return 1;
		}
	}
	if ( (string)ob->query("id") =="qibao zhihuan" )
	{//逍遥派解密
		if ( (string)me->query("family/family_name") == "逍遥派" && me->query("family/master_id")=="wuya zi" && me->query("id")==ob->query("owner") )
		{
			message_vision(HIC"童姥笑道：我多次找师弟想要这七宝指环戴戴，可师弟总是不给我。\n"NOR, this_object(),me);
			message_vision(HIC"你说道：听说无崖子祖师与那李秋水有一女儿，如今成为曼陀罗山庄主人...\n"NOR, this_object(),me);
			message_vision(HIC"你未察觉到童姥的脸色大变，还在絮絮叨叨的说着无崖子的故事。\n"NOR, this_object(),me);
			message_vision(HIC"童姥阴阴的笑道："+RANK_D->query_respect(me)+"说的是真的吗？我怎么未曾听闻师弟的这些风流韵事！！！\n"NOR, this_object(),me);
			if (me->query_temp("jm_xiaoyao5")) 
			{
				message_vision(HIG"童姥说道：师弟当年所爱之人必然是我，岂会看上那李秋水！！！\n"NOR, this_object(),me);
				me->set_temp("jm_xiaoyao6",1);
			}
			message_vision(HIG"童姥听你说的火起，大怒道：小子，你是想污蔑师弟吗！今日让你知道生死符的厉害！\n"NOR, this_object(),me);
			room->delete("exits");
			if (!me->is_busy()) me->start_busy(1);
			if (monk) monk->kill_ob(me);
			call_out("do_back", 60, me );
			return 1;
		} else
		{
			message_vision("$N对$n说道：多谢这位"+RANK_D->query_respect(me)+"，这本画像我就收起来了。\n",this_object(),me);
			return 1;
		}
	}	
	return 0;
}
int do_back(object me)
{
	object monk, room;
	if(!( room = find_object("/d/lingjiu/biguan")) ) room = load_object("/d/lingjiu/biguan");
	monk = present("tong lao", room);
	room->set("exits/south", "/d/lingjiu/men3");
	return 1;
}
