// /NPC gongzhu.c

#include <ansi.h>

inherit NPC;
inherit F_MASTER;
string family_zhan();
int ask_jiangfeng();
int ask_yannantian();
int ask_baodian();
void create() {
  int jibie;
  jibie = 7000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", -1);
  set_name("邀月", ({ "yao yue", "yao", "yue" }));
  set("long",
    "她就是「移花宫」的开山祖师.\n" +
    "她用薄薄的面纱蒙着脸,可是透过那块面纱你仍然依稀可见\n" +
    "她面色煞白,以不是人间所人看见的,你不由得多看了一眼.\n");
  set("title", "移花宫大宫主");
  set("gender", "女性");
  set("age", 36);
  set("nickname", HIR "杀尽天下负心汉" NOR);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("score", 2000000);
  set("combat_exp", 600000000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jueqing-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("mingyu-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yifeng-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yihua-jiemu", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "mingyu-shengong");
  map_skill("unarmed", "jueqing-zhang");
  map_skill("dodge", "yihua-jiemu");
  map_skill("parry", "yihua-jiemu");
  map_skill("sword", "yifeng-jian");
  create_family("移花宫", 1, "邀月宫主");
  set("inquiry", ([
    "江枫": (: ask_jiangfeng :),
    "燕南天": (: ask_yannantian :),
    "神水宝典": (: ask_baodian :),
    "门派战争": (: family_zhan :),
  ]));
  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/yihua/obj/jinlvyi")->wear();

}
#include "/quest/haojie/family_zhan.h"
void attempt_apprentice(object ob) {

  if ((string)ob->query("gender") != "女性") {
    command("chat* heihei");
    command("chat 我这一生最恨的就是男人,你去死吧!");
    kill_ob(this_player());
    command("perform yifeng");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，我的门下不收无用之人。");
    return;
  }
  if ((int)ob->query_skill("dodge", 1) < 1000) {
    command("say " + RANK_D->query_respect(ob) + "你的身法不够!");
    return;
  }
  if ((int)ob->query_skill("mingyu-shengong", 1) < 1000) {
    command("say " + RANK_D->query_respect(ob) + "是否还应该多练练冥雨神功？");
    return;
  }
  if ((int)ob->query_skill("yifeng-jian", 1) < 1000) {
    command("say " + RANK_D->query_respect(ob) + "是否还应该多练练移风剑法？");
    return;
  }
  if (ob->query("per", 1) < 25) {
    command("say 凭你这模样还想拜我为师.");
    return;
  }
  if (ob->query("con",) < 25) {
    command("say 本门功法极为难练,你的根骨似乎不够.");
    return;
  }
  if (ob->query("dex",) < 25) {
    command("say 本门功法移花接木最注重身法.");
    return;
  }
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "chuanren") ob->set("class", "chuanren");
  return;
}

void init() {
  object ob;

  ::init();
  ob = this_player();
  if (interactive(ob) && (!ob->query("gender") || ob->query("gender") != "女性")) {
    command("heihei");
    command("say 我平生最讨厌男人！你竟然来送死，好吧，我就成全了你！\n");
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
    command("perform yifeng");
  } else if (ob->query("gender") == "女性") {
    command("smile");
    command("say 好在你不是男人不然你会死得很惨。");
  }
}

int ask_jiangfeng() {
  object me;
  me = this_player();
  if ((string)me->query("family/family_name") == "移花宫" && me->query("family/master_id") == "yao yue") {
    me->set_temp("jm_yihua1", 1);
    message_vision(HIB "邀月愤恨的说道：是我不够美丽吗？是我武功不够高吗？为什么玉郎宁愿与我的婢女私通，却不爱我。\n" NOR, me);
    message_vision(HIB "邀月冷哼一声：必定是那小贱婢勾引我的玉郎，竟然还生下两个孩子。\n" NOR, me);
    message_vision(HIB "邀月说道：我最恨别人背叛我了，你去将他们全杀了。\n" NOR, me);
  } else
    message_vision(
      HIM "江枫俱有「绝世风采」，是一位「倚马斜桥、一掷千金的风流公子」，被称为「天下第一美男子」，\n" + "「世上绝没有一个少女能抵挡江枫的微微一笑」，「江枫的笑，可令少女的心粉碎」。\n" NOR,
      me
    );
  return 1;
}
int ask_yannantian() {
  object me;
  me = this_player();
  if ((string)me->query("family/family_name") == "移花宫" && me->query("family/master_id") == "yao yue") {
    message_vision(
      HIM "江湖中有耳朵的人，绝无一人没有听见过「玉郎」江枫和燕南天这两人的名字；\n" + "江湖中有眼睛的人，也绝无一人不想瞧瞧江枫的绝世风采和燕南天的绝代神剑；\n" + "只因为任何人都知道，世上绝没有一个少女能抵挡江枫的微微一笑，也绝没有一个英雄能抵挡燕南天的轻轻一剑！\n" NOR,
      me
    );
    if (me->query_temp("jm_yihua1") && !me->query_temp("jm_yihua2")) {
      message_vision(HIB "邀月冷哼一声：你连我移花宫的叛徒都铲除不了。\n" NOR, me);
      return 1;
    }
    if (me->query_temp("jm_yihua1") && !me->query_temp("jm_yihua3")) {
      message_vision(HIB "邀月冷哼一声：那江玉郎竟然与我婢女私通，你还不去杀了他。\n" NOR, me);
      return 1;
    }
    if (me->query_temp("jm_yihua1") && !me->query_temp("jm_yihua4")) {
      message_vision(HIB "邀月冷哼一声：花无缺虽然在移花宫长大，但贱人的孩子必须得死。\n" NOR, me);
      return 1;
    }
    if (me->query_temp("jm_yihua1") && !me->query_temp("jm_yihua5")) {
      message_vision(HIB "邀月冷哼一声：原本留着他以后兄弟相残，没想到如此奸猾。\n" NOR, me);
      return 1;
    }
    if (me->query_temp("jm_yihua2") && me->query_temp("jm_yihua3") && me->query_temp("jm_yihua4") && me->query_temp("jm_yihua5")) {
      me->set_temp("jm_yihua6", 1);
      message_vision(HIB "邀月冷哼一声：燕南天号称天下第一大侠，可以与江枫结拜，难道我不如他。\n" NOR, me);
      message_vision(HIB "邀月冷哼一声：这天下男子我见的多了，能入眼我无非这二人。\n" NOR, me);
      message_vision(HIB "邀月冷哼一声：顺我者昌逆我者亡。\n" NOR, me);
      message_vision(HIB "邀月说道：你去替我杀了那燕南天。\n" NOR, me);
      return 1;
    }
  } else
    message_vision(
      HIM "江湖中有耳朵的人，绝无一人没有听见过「玉郎」江枫和燕南天这两人的名字；\n" + "江湖中有眼睛的人，也绝无一人不想瞧瞧江枫的绝世风采和燕南天的绝代神剑；\n" + "只因为任何人都知道，世上绝没有一个少女能抵挡江枫的微微一笑，也绝没有一个英雄能抵挡燕南天的轻轻一剑！\n" NOR,
      me
    );
  return 1;
}
int ask_baodian() {
  object me, obj;
  me = this_player();
  if ((string)me->query("family/family_name") == "移花宫" && me->query("family/master_id") == "yao yue" && me->query_temp("jm_yihua7")) {
    message_vision(HIB "邀月说道：难道我不够美吗，为什么江枫背叛我，那燕南天亦与我作对。\n" NOR, me);
    message_vision(HIB "邀月大笑道：背叛我的人要死，与我作对的人也要死。\n" NOR, me);
    message_vision(HIB "邀月大笑道：以神水宝典为根基，修炼明玉功，若能破而后立，可将其修炼到第九层巅峰，从而可达到无极修罗，易筋涅盘，淡梦逍遥的境界。\n" NOR, me);
    me->set_temp("jm_yihua8", 1);
    message_vision(HIB "邀月说道：这本宝典你可以拿去参阅一天，一天后必须交还。\n" NOR, me);
    obj = new("/clone/book/shenshuibaodian");
    obj->set("owner", me->query("id"));  //设定识别
    obj->move(me);
  } else
    message_vision(HIY "移花宫的明玉功和移花接玉均出自神水宝典。\n" NOR, me);
  return 1;
}
