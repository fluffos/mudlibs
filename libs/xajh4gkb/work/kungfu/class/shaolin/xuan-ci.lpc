// Npc: /kungfu/class/shaolin/xuan-ci.c
// Date: YZC 96/01/19
inherit NPC;
inherit F_MASTER;
int ask_luohan();
void create() {
  int jibie;
  jibie = 4000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("玄慈大师", ({
    "xuanci dashi",
    "xuanci",
    "dashi",
  }));
  set("long",
    "他是一位白须白眉的老僧，身穿一袭金丝绣红袈裟。\n"
    "他身材略显佝偻，但却满面红光，目蕴慈笑，显得神完气足。\n"
  );
  set("nickname", "少林寺方丈");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");
  set("age", 70);

  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("combat_exp", 1100000);
  set("score", 800000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("nianhua-zhi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sanhua-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("fengyun-shou", 500 + jibie / 3 + random(jibie / 5));
  set_skill("longzhua-gong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("buddhism", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("unarmed", "longzhua-gong");
  map_skill("parry", "nianhua-zhi");

  create_family("少林派", 36, "弟子");

  set("inquiry", ([
    "罗汉阵": (: ask_luohan :),
  ]));
  setup();
  carry_object("/d/shaolin/obj/xuan-cloth")->wear();
}
void attempt_apprentice(object ob) {
  object me;
  mapping ob_fam, my_fam;
  string name;
  me = this_object();
  my_fam = me->query("family");
  name = ob->query("name");
  if (!(ob_fam = ob->query("family")) || ob_fam["family_name"] != "少林派") {
    command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
    return;
  }
  if ((string)ob->query("class") != "bonze" && ob_fam["family_name"] == "少林派") {
    command("say " + RANK_D->query_respect(ob) + "是俗家弟子，不能在寺内学艺。");
    return;
  }
  if (ob_fam["generation"] <= my_fam["generation"]) {
    command("say " + RANK_D->query_respect(ob) + "，贫僧哪里敢当 !");
    return;
  }
  if (ob_fam["generation"] == (my_fam["generation"] + 1) && name[0..1] == "澄") {
    command("say " + ob_fam["master_name"] + "的徒弟怎麽跑到我这儿来了，哈哈哈 !");
    command("recruit " + ob->query("id"));
  } else {
    command("say " + RANK_D->query_respect(ob) + "，你辈份不合，不能越级拜师。");
    return;
  }
  return;
}

int ask_luohan() {
  object me;
  me = this_player();

  if ((string)me->query("family/family_name") == "少林派" && (int)me->query("family/generation") <= 36 && me->query_temp("jm_shaolin4") && me->query_temp("jm_shaolin5")) {
    message_vision(HIB "玄慈大师说道：当年误信他人之言，以致铸成大错，一直痛苦万分。\n" NOR, me);
    message_vision(HIB "玄慈大师说道：如今" + RANK_D->query_respect(me) + "了结这段往事，总算是可以放下了。\n" NOR, me);
    message_vision(
      HIB "玄慈大师说道：" + RANK_D->query_respect(me) + "若能通过罗汉大阵考验，自可去达摩洞中寻访少林祖师。\n" NOR,
      me
    );
    me->set_temp("jm_shaolin6", 1);
  } else {
    message_vision(HIY "玄慈大师说道：罗汉大阵乃少林寺护寺阵法，九人可成阵，九阵可成大阵。\n" NOR, me);
  }
  return 1;
}
