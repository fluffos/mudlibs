// FanYao.c
// pal 1997.05.09

#include "ansi.h"

inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;

string ask_me();

void create() {
  int jibie;
  jibie = 4000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("范遥", ({ "fan yao", "fan", "yao", }));
  set("long",
    "他是一位带发修行的头陀，身穿白布长袍。\n"
    "他的脸上七七八八的全是伤疤，简直看不出本来面目了。\n"
  );

  set("title", HIG "明教" HIR "光明右使" NOR);
  set("level", 11);
  set("gender", "男性");
  set("attitude", "peaceful");
  set("class", "bonze");
  create_family("明教", 35, "弟子");
  set("age", 38);

  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("combat_exp", 5000000);
  set("score", 800000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("strike", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sanhua-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("longzhua-gong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("fengyun-shou", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("strike", "sanhua-zhang");
  map_skill("unarmed", "longzhua-gong");
  map_skill("parry", "fengyun-shou");

  set("inquiry", ([
    "光明圣火阵": (: ask_me :)
  ]));



  setup();

  carry_object("/d/mingjiao/obj/baipao")->wear();
}
