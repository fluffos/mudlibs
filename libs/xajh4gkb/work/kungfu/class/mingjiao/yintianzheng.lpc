// YinTianZheng.c
// pal 1997.05.09

#include "ansi.h"

inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;

void create() {
  int jibie;
  jibie = 4000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("殷天正", ({ "yin tianzheng", "yin", "tianzheng", }));
  set("long",
    "他是一位身材魁梧的秃老者，身穿一件白色长袍。\n"
    "他长眉胜雪，垂下眼角，鼻子钩曲，犹如鹰嘴。\n"
  );

  set("title", HIG "明教" HIW "白眉鹰王" NOR);
  set("level", 9);
  set("gender", "男性");
  set("attitude", "peaceful");
  create_family("明教", 36, "弟子");
  set("age", 72);

  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("combat_exp", 900000);
  set("score", 1000000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hand", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shenghuo-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qingfu-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sougu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yingzhua-shou", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "shenghuo-shengong");
  map_skill("hand", "yingzhua-shou");
  map_skill("unarmed", "sougu");
  map_skill("parry", "sougu");
  map_skill("dodge", "qingfu-shenfa");
  prepare_skill("unarmed", "sougu");


  setup();

  carry_object("/d/mingjiao/obj/baipao")->wear();
}
