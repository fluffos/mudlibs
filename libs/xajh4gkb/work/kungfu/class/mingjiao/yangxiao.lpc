#include "ansi.h"

inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;

string ask_me();
string ask_ling();

void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 0); 
    set_name("杨逍", ({"yang xiao","yang","xiao",}));
	set("long",
        "他是一位中年书生，身穿白布长袍。\n"
        "他相貌俊雅，只是双眉略向下垂，嘴边露出几条深深的皱纹，不免略带衰老凄苦\n"
        "之相。他不言不动，神色漠然，似乎心驰远方，正在想什么事情。\n"
	);

	set("title",HIG "明教" HIR "光明左使" NOR);
	set("level",11);
	set("gender", "男性");
	set("attitude", "peaceful");
	create_family("明教",35,"弟子");
	set("age", 42);

    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
	set("kar", 30);
	set("per", 30);
	set("npcbiaoji",1);
	set("combat_exp", 4000000);
	set("score", 800000);

	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("literate", 500+jibie/3+random(jibie/5));

	set_skill("shenghuo-shengong", 500+jibie/3+random(jibie/5));
	set_skill("hunyuan-yiqi", 500+jibie/3+random(jibie/5));
	set_skill("qiankundanuoyi",500+jibie/3+random(jibie/5));
	set_skill("shenghuo-jian", 500+jibie/3+random(jibie/5));
	set_skill("shenghuo-quan", 500+jibie/3+random(jibie/5));
	set_skill("qingfu-shenfa", 500+jibie/3+random(jibie/5));
	set_skill("longzhua-gong", 500+jibie/3+random(jibie/5));
	map_skill("force", "shenghuo-shengong");
	map_skill("dodge", "qingfu-shenfa");
	map_skill("unarmed", "shenghuo-quan");
	map_skill("sword", "shenghuo-jian");
	map_skill("parry", "qiankundanuoyi");

	prepare_skill("unarmed", "longzhua-gong");
	prepare_skill("unarmed", "shenghuo-quan");

	set("inquiry", 
	([
        	"光明圣火阵"	: (: ask_me :),
        	"铁焰令"     	: (: ask_ling :)
	]));

	setup();

        carry_object("/d/mingjiao/obj/baipao")->wear();
}
