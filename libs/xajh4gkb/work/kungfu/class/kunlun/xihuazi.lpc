// xihuazic by wyz
inherit NPC;
inherit F_MASTER;
void create()
{
	int jibie;
	jibie = 1000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 0); 
        set_name("西华子", ({ "xihua zi", "zi", "xihua" }) );
        set("gender", "男性");
        set("age", 29);
        set("long",
         "他就是昆仑派的大师兄，为人好打抱不平，嫉恶如仇。
他长得矮矮胖胖的。\n");        
        set("attitude", "peaceful");
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
	set("kar", 30);
	set("per", 30);
	set("npcbiaoji",1);
        set("rank_info/respect", "大师兄");        
        set("combat_exp",685900);
 
        set_skill("unarmed", 500+jibie/3+random(jibie/5)); 
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));		
        set_skill("literate",500+jibie/3+random(jibie/5));	
        set_skill("finger",500+jibie/3+random(jibie/5));		
        set_skill("xuantian-wuji", 500+jibie/3+random(jibie/5));
        set_skill("xunlei-sword", 500+jibie/3+random(jibie/5));
        set_skill("liangyi-jian", 500+jibie/3+random(jibie/5));		
        set_skill("kunlun-zhang",500+jibie/3+random(jibie/5));
        set_skill("kunlun-shenfa", 500+jibie/3+random(jibie/5));
   
        map_skill("dodge", "kunlun-shenfa");
        map_skill("force", "xuantian-wuji");
        map_skill("unarmed","kunlun-zhang");
        map_skill("parry", "liangyi-jian");
        map_skill("sword", "liangyi-jian");

 

    create_family("昆仑派", 15, "大师兄");
    setup();
    carry_object("//clone/cloth/long_cloth")->wear();
    carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob)
{
	if( (string)ob->query("gender") != "男性" )
	{        
		command("say 我不收女弟子，姑娘去找四娘吧。");
		return;
	}
    command("say 好吧，我就收下你了，以后要多为昆仑派出力啊。");
    command("recruit " + ob->query("id"));
	return;
 }
