// masteryue.c
inherit NPC;
inherit F_MASTER;
string family_zhan();
void create() {
  int jibie;
  jibie = 4000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("何太冲", ({ "he taichong", "master he", "master", "he" }));
  set("title", YEL "昆仑掌门" NOR);
  set("gender", "男性");
  set("age", 42);
  set("long",
    "他就是昆仑派掌门何太冲。他看上去是个和善的中年人，对人总是彬彬有礼，很有一代宗师的风范。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("npcbiaoji", 1);
  set("rank_info/respect", "何掌门");
  set("combat_exp", 3300000);

  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("finger", 500 + jibie / 3 + random(jibie / 5));
  set_skill("throwing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xuantian-wuji", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xunlei-sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("liangyi-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("kunlun-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("kunlun-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("mantianhuayu", 500 + jibie / 3 + random(jibie / 5));
  map_skill("throwing", "mantianhuayu");
  map_skill("dodge", "kunlun-shenfa");
  map_skill("force", "xuantian-wuji");
  map_skill("unarmed", "kunlun-zhang");
  map_skill("parry", "liangyi-jian");
  map_skill("sword", "liangyi-jian");

  set("inquiry", ([
    "何足道": "那是本派祖师爷。\n",
    "何三圣": "那是本派祖师爷。\n",
    "五姑": "那是我的小妾。唉，不过现在病了。\n",
    "班淑娴": "嘘！别那么大声。\n",
    "门派战争": (: family_zhan :),
  ]));

  set("chat_chance", 5);
  set("chat_msg", ({
    "何太冲叹道：五姑的病越来越重了，唉 . . . \n",
    "何太冲说道：谁帮我治好五姑的病，我一定重谢他。\n",
  }));



  create_family("昆仑派", 14, "掌门");
  setup();
  carry_object("//clone/cloth/long_cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}
#include "/quest/haojie/family_zhan.h"
void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if ((string)this_player()->query("family/family_name") != "昆仑派") {
    switch (random(3)) {
      case 0:
        say("何太冲笑咪咪地说道：这位" + RANK_D->query_respect(ob)
          + "，到我昆仑派来有何贵干。\n");
        break;
      case 1:
        say("何太冲搓了搓手，说道：这位" + RANK_D->query_respect(ob)
          + "可是来自中原？可认识什么名医？\n");
        break;
      case 2:
        say("何太冲拱了拱手，说道：这位" + RANK_D->query_respect(ob)
          + "可曾学过医术？\n");
        break;
    }
  } else {
    switch (random(2)) {
      case 0:
        say("何太冲搓了搓手，说道：乖徒儿，你可是来自中原？可认识什么名医？\n");
        break;
      case 1:
        say("何太冲尴尬地笑道：乖徒儿，你可曾学过医术？\n");
        break;
    }
  }
}
void attempt_apprentice(object ob) {
  if ((string)ob->query("gender") != "男性") {
    command("say 我不收女弟子的，姑娘去找掌门夫人吧。");
    return;
  }
  if ((int)ob->query("int", 1) < 25) {
    command("say " + RANK_D->query_respect(ob) + "看起来呆头呆脑的，恐怕难以将我昆仑武功修炼到高深处！");
    return;
  }
  if ((int)ob->query("score", 1) < 10000) {
    message_vision("何太冲疑惑的看着你说道：你对我派似乎不够忠诚？\n", ob);
    return;
  }
  if ((int)ob->query_skill("xuantian-wuji", 1) < 500) {
    command("say " + RANK_D->query_respect(ob) + "是否还应该多练练内功心法？");
    return;
  }
  command("recruit " + ob->query("id"));
  return;
}
void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "swordsman");
}
