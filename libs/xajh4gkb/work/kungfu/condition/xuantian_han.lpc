// ill_fashao.c

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

string name() { return "xuantian_han"; }

int min_qi_needed() { return 10; }

int update_condition(object me, int duration)
{
    if( duration < 1 ) return 0;
    if( !living(me) ) 
	{
        message("vision", me->name() + "痛苦地哼了一声。\n", environment(me), me);
    }
	else 
	{
        tell_object(me, HIB "忽然一阵寒气自丹田的而起，逐步渗透到四肢白赅，透出阵阵寒意。。\n" NOR );
        message("vision", me->name() + "痛苦的呻吟了一声，脸上竟笼罩了一股薄薄的寒霜。。\n"NOR, environment(me), me);
    }

    me->receive_damage("qi",100 + random(me->query("max_qi")/100));
    me->receive_damage("jing", 100+random(me->query("max_jing")/100));
    me->receive_wound("qi",100 + random(me->query("max_qi")/100));
    me->receive_wound("jing", 100+random(me->query("max_jing")/100));
//  if (!me->is_busy()) me->start_busy(3);
	if( stringp(me->query("body")) && (string)me->query("body")==RED"厄难毒体"NOR) me->apply_condition("xuantian_han", duration - duration);
	else me->apply_condition("xuantian_han", duration - 1);

    me->set_temp("die_for","中玄天寒毒");
    me->delete_temp("last_damage_from");
    if( duration < 1 ) return 0;
    return CND_CONTINUE;
}

string query_type(object me)
{
       return "poison";
}
