// by star  98.12.4
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
	if( duration < 1 ) return 0;
    if( !living(me) ) 
	{
        message("vision", me->name() + "满面布满了蜘蛛黑纹。\n", environment(me), me);
    }
	else 
	{
        tell_object(me, HIG "你中的蜘蛛毒发作了！\n" NOR );
        message("vision", me->name() + HIW"脸色发紫，浑身布满了黑色纹路，似乎有黑色丝线缠绕。\n"NOR, environment(me), me);
    }       
    me->receive_damage("qi",100 + random(me->query("max_qi")/100));
    me->receive_damage("jing", 100+random(me->query("max_jing")/100));
    me->receive_wound("qi",100 + random(me->query("max_qi")/100));
    me->receive_wound("jing", 100+random(me->query("max_jing")/100));
	if( stringp(me->query("body")) && (string)me->query("body")==RED"厄难毒体"NOR) me->apply_condition("zhizhu_poison", duration - duration);
	else me->apply_condition("zhizhu_poison", duration - 1);
	
//    if (!me->is_busy()) me->start_busy(3);
    me->set_temp("die_for","中蜘蛛毒");
    me->delete_temp("last_damage_from");
   if( duration < 1 ) return 0;
   return CND_CONTINUE;
}

string query_type(object me)
{
       return "poison";
}
