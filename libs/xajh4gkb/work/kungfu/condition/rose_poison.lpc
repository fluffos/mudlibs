// rose_poison.c
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration) {
  if (duration < 1) return 0;
  if (!living(me)) {
    message("vision", me->name() + "满脸通红，痛苦地哼了一声。\n", environment(me), me);
  } else {
    tell_object(me, HIG "你中的" HIR "火玫瑰毒" HIG "发作了！\n" NOR);
    message("vision", me->name() + "面上通红，浑身燥热无比，呼出的空气带有火热之气。\n", environment(me), me);
  }

  me->receive_damage("qi", 100 + random(me->query("max_qi") / 100));
  me->receive_damage("jing", 100 + random(me->query("max_jing") / 100));
  me->receive_wound("qi", 100 + random(me->query("max_qi") / 100));
  me->receive_wound("jing", 100 + random(me->query("max_jing") / 100));
  if (stringp(me->query("body")) && (string)me->query("body") == RED "厄难毒体" NOR) me->apply_condition(
    "rose_poison",
    duration - duration
  );
  else me->apply_condition("rose_poison", duration - 1);

  me->set_temp("die_for", "中火玫瑰毒毒");
  me->delete_temp("last_damage_from");
  if (duration < 1) return 0;
  return CND_CONTINUE;
  //  return 1;	
}

string query_type(object me) {
  return "poison";
}
