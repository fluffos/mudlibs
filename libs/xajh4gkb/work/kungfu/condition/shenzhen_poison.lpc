#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
    if( duration < 1 ) return 0;
    if( !living(me) ) 
	{
        message("vision", me->name() + "痛苦地哼了一声。\n", environment(me), me);
    }
	else 
	{
        tell_object(me, HIR "你感觉到呼吸困难，非常难受！\n" NOR );
        message("vision", me->name() + "忽然脸色苍白，豆大的汗珠从额头渗出。\n", environment(me), me);
    }
    me->receive_damage("qi",100 + random(me->query("max_qi")/100));
    me->receive_damage("jing", 100+random(me->query("max_jing")/100));
    me->receive_wound("qi",100 + random(me->query("max_qi")/100));
    me->receive_wound("jing", 100+random(me->query("max_jing")/100));
	if( stringp(me->query("body")) && (string)me->query("body")==RED"厄难毒体"NOR) me->apply_condition("shenzhen_poison", duration - duration);
	else me->apply_condition("shenzhen_poison", duration - 1);

    me->set_temp("die_for","中神针毒");
    me->delete_temp("last_damage_from");
    if( duration < 1 ) return 0;
	return CND_CONTINUE;
//  return 1;
}

string query_type(object me)
{
       return "poison";
}
