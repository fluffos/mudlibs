// scorpion_poison.c

#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
    if( duration < 1 ) return 0;
    if( !living(me) ) 
	{
        message("vision", me->name() + "浑身肿胀的不行了。\n", environment(me), me);
    }
	else 
	{
        tell_object(me, "你浑身水肿严重，快找解药吧，否则会死的。\n");
        message("vision", me->name() + "浑身肿胀如球，赶紧找大夫看看吧，再这样拖下去恐怕有生命之危。\n", environment(me), me);
    }	
    me->receive_damage("qi",100 + random(me->query("max_qi")/100));
    me->receive_damage("jing", 100+random(me->query("max_jing")/100));
    me->receive_wound("qi",100 + random(me->query("max_qi")/100));
    me->receive_wound("jing", 100+random(me->query("max_jing")/100));
	if( stringp(me->query("body")) && (string)me->query("body")==RED"厄难毒体"NOR) me->apply_condition("scorpion_poison", duration - duration);
	else me->apply_condition("scorpion_poison", duration - 1);

    me->set_temp("die_for","得水肿病");
    me->delete_temp("last_damage_from");
    if( duration < 1 ) return 0;
	return CND_CONTINUE;
//  return 1;
}

string query_type(object me)
{
       return "poison";
}
