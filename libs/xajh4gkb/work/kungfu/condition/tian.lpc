#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration) {
  /*    if( duration > limit &&  living(me) ) 
	{
        me->unconcious();
        return 0;
    } else if( !living(me) ) 
	{
        message("vision", me->name() + "打了个隔，不过依然烂醉如泥。\n", environment(me), me);
    } else if( duration > limit/2 ) 
	{
        tell_object(me, "你觉得脑中昏昏沉沉，身子轻飘飘地，大概是醉了。\n");
        message("vision", me->name() + "摇头晃脑地站都站不稳，显然是喝醉了。\n", environment(me), me);
        me->receive_damage("jing", 10);
    } else if( duration > limit/4 ) 
	{
        tell_object(me, "你觉得一阵酒意上冲，眼皮有些沉重了。\n");
        message("vision", me->name() + "脸上已经略显酒意了。\n", environment(me), me);
        me->receive_healing("jing", 10);
        me->receive_healing("qi", 15);
    }*/
  if (duration < 1) return 0;
  if (!living(me)) {
    message("vision", me->name() + "醉的不省人事。\n", environment(me), me);
  } else {
    tell_object(me, "你觉得脑中昏昏沉沉，身子轻飘飘地，大概是醉了。\n");
    message("vision", me->name() + "摇头晃脑地站都站不稳，显然是喝醉了。\n", environment(me), me);
  }
  me->receive_damage("qi", 100 + random(me->query("max_qi") / 100));
  me->receive_damage("jing", 100 + random(me->query("max_jing") / 100));
  me->receive_wound("qi", 100 + random(me->query("max_qi") / 100));
  me->receive_wound("jing", 100 + random(me->query("max_jing") / 100));
  if (stringp(me->query("body")) && (string)me->query("body") == RED "厄难毒体" NOR) me->apply_condition(
    "tian",
    duration - duration
  );
  else me->apply_condition("tian", duration - 1);

  me->set_temp("die_for", "酒精中毒");
  me->delete_temp("last_damage_from");
  if (duration < 1) return 0;
  return CND_CONTINUE;
  //     return 1;
}

string query_type(object me) {
  return "poison";
}
