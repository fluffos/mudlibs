//Cracked by Roath
#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

string* xuedao = ({
        "胸口膻中",
        "头顶百会",
        "面庞迎香",
        "足底涌泉",
        "手心劳宫",
        "两鬓太阳",
});


int update_condition(object me, int duration)
{
	if( !living(me) ) 
	{
     	message_vision(me->name() + "身体一阵颤抖，痛苦地哼了一声。\n", environment(me), me);
   	}
   	else 
	{
   		if (me->query("family/family_name")=="星宿派" && me->query_skill("huagong-dafa")) 
		{
            tell_object(me, HIW"你突然觉得一阵寒气袭来，忙运用化功大法抵御。\n"NOR);
		    message("vision", me->name() + "的身子突然晃了两晃，脸上泛起一阵惨白之色。\n",environment(me), me);	                    		   	   		    
   		    me->apply_condition("sanpoison", duration - random(5)); 
			if( duration < 1 ) 
			{
			message_vision(HIG"$N运了运气，发现体内的寒毒已经荡然无存。"NOR,me);	
			return 0;
			}			
   		} 
		else 
		{	 		
      		    tell_object(me, HIW"你突然间觉得"+xuedao[random(sizeof(xuedao))]+"一阵刺痛，眼前一阵黑，一阵明，胸中一阵郁闷。\n" NOR );
      		    message("vision", me->name() + "的身子突然晃了两晃，脸上泛起一阵惨白之色。\n",environment(me), me);	                    		   	
   	    }
   	}
    me->receive_damage("qi",100 + random(me->query("max_qi")/100));
    me->receive_damage("jing", 100+random(me->query("max_jing")/100));
    me->receive_wound("qi",100 + random(me->query("max_qi")/100));
    me->receive_wound("jing", 100+random(me->query("max_jing")/100));
	if( stringp(me->query("body")) && (string)me->query("body")==RED"厄难毒体"NOR) me->apply_condition("sanpoison", duration - duration);
	else me->apply_condition("sanpoison", duration - 1);

    me->set_temp("die_for","中寒冰毒");
    me->delete_temp("last_damage_from");	
   	if( duration < 1 ) 	 return 0; 	
   return CND_CONTINUE;
}

string query_type(object me)
{
       return "poison";
}
