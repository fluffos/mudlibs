//by diabio
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
    if( duration < 1 ) return 0;
    if( !living(me) ) 
	{
        message("vision", me->name() + "痛苦地哼了一声。\n", environment(me), me);
    }
	else 
	{
        tell_object(me, "你忽然间鼻涕眼泪忍不住流了下来，心中非常的难受，好象要吃些什么才好。\n");
        message("vision", me->name() + "忽然脸色发黑，鼻涕从鼻子中直往下流。\n", environment(me), me);
    }
    me->receive_damage("qi",100 + random(me->query("max_qi")/100));
    me->receive_damage("jing", 100+random(me->query("max_jing")/100));
    me->receive_wound("qi",100 + random(me->query("max_qi")/100));
    me->receive_wound("jing", 100+random(me->query("max_jing")/100));
	if( stringp(me->query("body")) && (string)me->query("body")==RED"厄难毒体"NOR) me->apply_condition("xhlq_poison", duration - duration);
	else me->apply_condition("xhlq_poison", duration - 1);

    me->set_temp("die_for","中血河戾气");
    me->delete_temp("last_damage_from");
	if( duration < 1 ) return 0;
	return CND_CONTINUE;
}

string query_type(object me)
{
       return "poison";
}
