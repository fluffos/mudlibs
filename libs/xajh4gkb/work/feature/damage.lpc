// 如果需要 削弱某个连招， 直接在 连招 的文件里 添加


#include <dbase.h>
#include <login.h>
#include <move.h>
#define PVP_DAMAGE_SCALE        5
#define PVP_WOUND_SCALE         10

inherit F_TOMUD;
private nosave int counter=0;
int ghost = 0;

int is_ghost()
{
	return ghost;
}

varargs void die(int);

varargs int receive_damage(string type, int damage, object who)
{
	int val;
	
	if( damage < 0 )
	{
		damage = 0;
		error("F_DAMAGE: 伤害值为负值。\n");
	}

	if( type!="jing" && type!="qi" )
		error("F_DAMAGE: 伤害种类错误( 只能是 jing, qi 其中之一 )。\n");

	val = (int)query(type) - damage;

	if( val >= 0 )
		set(type, val);
	else
		set( type, -1 );

	set_heart_beat(1);
	//有些技能的perform代码的receive_damage函数没指定第三个参数，即没指定伤害实施者
	if(!objectp(who))
		who = query_temp("last_perform_by");
	delete_temp("last_perform_by");
	if( objectp(who) )
	{
		set_temp("last_damage_from", who);

		if ( who->query("env/myhp_show") && !who->query("xieyi/zmud") )
			tell_object(who, my_hp(who, this_object()));
	}

	if ( damage > 0 && query("env/myhp_show") && !query("xieyi/zmud") )
		tell_object(this_object(), my_hp(this_object(), who));
	
	return damage;
}

varargs int receive_wound(string type, int damage, object who)
{
	int val;

	if( type!="jing" && type!="qi" )
		error("F_DAMAGE: 伤害种类错误( 只能是 jing, qi 其中之一 )。\n");

	val = (int)query("eff_" + type) - damage;

	if( val >= 0 )
		set("eff_" + type, val);
	else
	{
		set( "eff_" + type, -1 );
		val = -1;
	}

	if( (int)query(type) > val )
		set(type, val);

	set_heart_beat(1);
	//2016.6.5阿飞添加这行代码，之前没有这行代码，会导致目标为0时出现Bug
	if(!objectp(who))
		who = query_temp("last_perform_by");
	delete_temp("last_perform_by");

	if( objectp(who) )
	{
		set_temp("last_damage_from", who);

		if ( who->query("env/myhp_show") && !who->query("xieyi/zmud") )
			tell_object(who, my_hp(who, this_object()));
	}

	if ( damage > 0 && query("env/myhp_show") && !query("xieyi/zmud") )
		tell_object(this_object(), my_hp(this_object(), who));
	
	return damage;
}

int receive_heal(string type, int heal)
{
	int val;

	if( heal < 0 )
		error("F_DAMAGE: 恢复值为负值。\n");

	if( type!="jing" && type!="qi" )
		error("F_DAMAGE: 恢复种类错误( 只能是 jing, qi 其中之一 )。\n");

	val = (int)query(type) + heal;

	if( val > (int)query("eff_" + type) )
		set(type, (int)query("eff_" + type));
	else
		set( type, val );

	if ( query("env/myhp_show") && !query("xieyi/zmud") )
		tell_object(this_object(), my_hp(this_object()));

	return heal;
}

int receive_curing(string type, int heal)
{
	int max, val;

	if( heal < 0 )
		error("F_DAMAGE: 恢复值为负值。\n");

	if( type!="jing" && type!="qi" )
		error("F_DAMAGE: 恢复种类错误( 只能是 jing, qi 其中之一 )。\n");

	val = (int)query("eff_" + type);
	max = (int)query("max_" + type);

	if( val + heal > max )
	{
		set("eff_" + type, max);

		if ( query("env/myhp_show") && !query("xieyi/zmud") )
			tell_object(this_object(), my_hp(this_object()));

		return max - val;
	}
	else
	{
		set( "eff_" + type, val + heal);

		if ( query("env/myhp_show") && !query("xieyi/zmud") )
			tell_object(this_object(), my_hp(this_object()));

		return heal;
	}
}

void unconcious()
{
	object defeater,me;
	int time;
	me = this_object();

	if( !living(this_object()) )
		return;

	if( wizardp(this_object()) && query("env/immortal") )
		return;

//2018.9.13阿飞改 添加金蚕护体效果
/*    if( me->query_temp("jincanhuti"))
    {
        me->remove_all_killer();//解除所有仇恨
        all_inventory(environment(me))->remove_killer(me);//解除仇恨
        me->dismiss_team();//解除团队战斗仇恨		
		me->clear_condition();
		if (me->is_busy()) me->interrupt_me();
		me->delete_temp("jincanhuti");
		me->move("/d/wudujiao/tree.lpc");
		me->set("qi", me->query("max_qi"));
		me->set("eff_qi", me->query("max_qi"));
		me->set("jing", me->query("max_jing"));
		me->set("eff_jing", me->query("max_jing"));
		me->set("neili", me->query("max_neili"));
		me->set("jingli", me->query("max_jingli"));
        message_vision(HIR "\n「神蚕九变，化茧重生」,突然间，$N体外无形蚕茧显现出白色光芒，将$N包裹在内！\n" NOR, me);
        return;
    }
*/
	if (is_ghost())
	{
		die();
		return;
	}

	if ( !userp(this_object()) )
	{
		if ( function_exists("do_deposit", this_object()) || function_exists("do_sell", this_object()) )
		{
			this_object()->set("no_put", 1);
		}
	}

	if( objectp(defeater = query_temp("last_damage_from")) )
		COMBAT_D->winner_reward(defeater, this_object());

	this_object()->remove_all_enemy();
	set("hunmi",1);
	message("system", HIR "\n你的眼前一黑，接著什么也不知道了....\n\n" NOR,this_object());
	this_object()->disable_player(" <昏迷不醒>");
	set("jingli", 0);
	set("neili", 0);
	set("jing", 0);
	set("qi", 0);

	if ( query("env/myhp_show") && !query("xieyi/zmud") )
		tell_object(this_object(), my_hp(this_object()));

	set_temp("block_msg/all",1);
	COMBAT_D->announce(this_object(), "unconcious");

	//昏迷时间
	time = random(100 - this_object()->query_con()) + 20;
	if ( time > 90 ) time = 90;
	if ( time < 1 ) time = 1;
	call_out("revive",time);
}

varargs void revive(int quiet)
{
	remove_call_out("revive");
	this_object()->enable_player();

	if (userp(this_object()))
	{
		delete("no_get");
		delete("no_get_from");
	}

	if ( !query_temp("block_msg/all") )
		set_temp("block_msg/all", 1);

	while( environment()->is_character() || environment()->is_container())
		this_object()->move(environment(environment()));

	//如果是在武庙和武林大会场则销毁该NPC
	if(!userp(this_object()))
	{
		if( file_name(environment()) == "/d/wizard/fightroom2"
		        || file_name(environment()) == "/d/city/wumiao"
		        || file_name(environment()) == "/d/wizard/fightroom3" )
			destruct(this_object());
	}

	if ( !objectp(this_object()) ) return;

	if( !quiet )
	{
		COMBAT_D->announce(this_object(), "revive");
		set("hunmi",0);
		delete_temp("block_msg");
		message_vision(HIY "\n慢慢地$N终于又有了知觉....\n\n"NOR,this_object() );
		delete_temp("last_unconcious_from");
	}

	if ( this_object()->query_temp("temp_no_die") )
		this_object()->delete_temp("temp_no_die");//清除擂台不死参数

	if ( !this_object()->is_busy() )
		this_object()->start_busy(1);//增加Busy

	if ( query_temp("block_msg/all") )
		delete_temp("block_msg");

	if ( query("env/myhp_show") && !query("xieyi/zmud") )
		tell_object(this_object(), my_hp(this_object()));
}

varargs void die(int flag)
{
	object corpse, killer, victim, me;
	int add_exp,add_pot,add_sco,renwu_exp_add=0;
	mapping quest,my;

	if( !living(this_object()) ) revive(1);
	me = this_object();
	if( wizardp(this_object()) && query("env/immortal") ) 
	{
        command("full");
        message_vision(HIW"\n$N哈哈大笑三声：我是无敌模式，怎么可能死！\n\n" NOR, this_object());
        return;
    }
	my = this_object()->query_entire_dbase();
//2018.9.13阿飞改 添加金蚕护体效果
    if( me->query_temp("jincanhuti"))
    {
        me->remove_all_killer();//解除所有仇恨
        all_inventory(environment(me))->remove_killer(me);//解除仇恨
        me->dismiss_team();//解除团队战斗仇恨		
		me->clear_condition();
		if (me->is_busy()) me->interrupt_me();
		me->delete_temp("jincanhuti");
		me->delete_temp("last_unconcious_from");
		me->delete_temp("die_for");
		if( playerp(me) ) me->move("/d/wudujiao/tree.lpc");
		me->set("qi", me->query("max_qi"));
		me->set("eff_qi", me->query("max_qi"));
		me->set("jing", me->query("max_jing"));
		me->set("eff_jing", me->query("max_jing"));
		me->set("neili", me->query("max_neili"));
		me->set("jingli", me->query("max_jingli"));
        message_vision(HIR "\n「神蚕九变，化茧重生」,突然间，$N体外无形蚕茧显现出白色光芒，将$N包裹在内！\n" NOR, me);
        return;
    }
	if( my["no_die_dan"]>= 1 )
    {
        message_vision(HIW"\n$N身上突然闪烁出圣洁的白光，然后身影随着白光一点点的消失了！\n\n" NOR, this_object());
        this_object()->remove_all_killer();//解除所有仇恨
        all_inventory(environment(this_object()))->remove_killer(this_object());//解除仇恨
        this_object()->dismiss_team();//解除团队战斗仇恨
		this_object()->clear_condition();
        if (this_object()->is_busy()) this_object()->interrupt_me();
		this_object()->delete_temp("last_unconcious_from");
		this_object()->delete_temp("die_for");
        if( playerp(this_object()) ) this_object()->move("/d/city2/wenmiao.lpc");
        my["no_die_dan"] -= 1;		
        if (this_object()->query("no_die_dan") < 1) this_object()->delete("no_die_dan");		
        my["jing"]   = my["eff_jing"]   = my["max_jing"];
        my["jingli"] = my["eff_jingli"] = my["max_jingli"];
        my["qi"]     = my["eff_qi"]     = my["max_qi"];
        my["neili"]  = my["max_neili"];
        my["food"]   = this_object()->max_food_capacity();
        my["water"]  = this_object()->max_water_capacity();
        return;
    }
	// 擂台比试不死
	if ( playerp(this_object()) )
	{
		//擂台比武不死
		if ( !flag
		        && !this_object()->query_condition("killer")
		        && (this_object()->query_temp("temp_no_die")
		            || file_name(environment(this_object())) == "/d/wizard/fightroom2"
		            || file_name(environment(this_object())) == "/d/wizard/fightroom3") )//改回原来的，在擂台这个地方不死
		{
			if(this_object()->query("qi") < 0)
				this_object()->set("qi",0);

			if(this_object()->query("eff_qi") < 0)
				this_object()->set("eff_qi",0);

			if(this_object()->query("jing") < 0)
				this_object()->set("jing",0);

			if(this_object()->query("eff_jing") < 0)
				this_object()->set("eff_jing",0);

			if ( query("env/myhp_show") && !query("xieyi/zmud") )
				tell_object(this_object(), my_hp(this_object()));
			return;
		}
	}

	if (objectp(previous_object()))
		if( !SECURITY_D->valid_set( this_object(), previous_object()) )
			return;

	if ( !playerp(this_object()) )
	{//2018-11-25阿飞改，不太清楚有商人属性的为什么死亡不留尸体
		if ( function_exists("do_deposit", this_object()) || function_exists("do_sell", this_object()) )
		{
			message_vision(HIW"\n$N缓缓倒了下去，既沉入地下消失不见....\n\n" NOR, this_object());
			destruct(this_object());
			return;
		}
	}


	if ( playerp(this_object()) && this_object()->is_ghost() )
	{
		message_vision(HIC "死人没有办法再死一次。\n" NOR, this_object());
		message_vision(HIG "$N的魂魄回到了阴间。\n" NOR, this_object());
		this_object()->set("jing", 1);
		this_object()->set("eff_jing", 1);
		this_object()->set("qi", 1);
		this_object()->set("eff_qi", 1);
		this_object()->set("neili", 0);
		this_object()->set("jingli", 0);
        this_object()->clear_condition();
        this_object()->remove_all_killer();//解除所有仇恨
        all_inventory(environment(this_object()))->remove_killer(this_object());//解除仇恨
        this_object()->dismiss_team();//解除团队战斗仇恨
		if (this_object()->is_busy()) this_object()->interrupt_me();
		if(!environment(this_object()) || strsrch(base_name(environment(this_object())),"/d/death/")!=0)
			this_object()->move("/d/death/gate");
		return;
	}

	COMBAT_D->announce(this_object(), "dead");
	victim = this_object();

	if ( !objectp(killer = query_temp("last_damage_from")) )
		killer = query_temp("last_unconcious_from");

	if( objectp(killer) )
	{
		set_temp("my_killer", killer->query("id"));

		if ( !playerp(victim) && playerp(killer) && mapp(quest = killer->query("quest")) )
		{
			if ( quest["quest_type"] == "杀" && quest["quest"]==victim->short() )
			{	//朱半仙杀NPC任务在这里控制
				if( quest["task_time"] >  time() )
				{
					if (killer->query_temp("renwu_exp_add")) renwu_exp_add = (int)killer->query_temp("renwu_exp_add",1);	//处于任务经验提升状态时
					command("smile");
					add_exp = (quest["diff"]*10000+10000)*(renwu_exp_add+100)/100;
					add_exp *= 100;
					if( (killer->query_temp("quest_count")%8) ) add_exp*=2;
					tell_object(killer, sprintf(HIR"恭喜你！你又完成了一项任务！\n你获得了%s点战斗经验！\n", chinese_number(add_exp*killer->query_exp_times())) );
					killer->add("combat_exp", add_exp);
					add_pot = (quest["diff"]*10000+10000)*(renwu_exp_add+100)/100;
					add_pot *= 5000;
					if( (killer->query_temp("quest_count")%8) ) add_pot*=2;
					tell_object(killer, sprintf(YEL"%s点潜能！\n"NOR,chinese_number(add_pot)) );
					killer->add("potential",add_pot);
					add_sco=(quest["diff"]*10+10)*(renwu_exp_add+100)/100;
					add_sco *= 100;
					if( (killer->query_temp("quest_count")%8) ) add_sco*=2;
					tell_object(killer,sprintf(RED"江湖阅历增加了%s点!\n"NOR,chinese_number(add_sco)) );
					killer->add("score",add_sco);
					killer->delete("quest");
					killer->add("renwu/banxian_renwu",1);
					//2018.4.28阿飞添加  国庆节活动--朱半贤任务10次
					if ((int)killer->query("jieri_gift/guoqing")) killer->add_temp("guoqing/banxian",1);
					if ((int)killer->query_temp("guoqing/banxian")>=10 )
					{
						killer->set_temp("guoqing/banxian",10);
						tell_object(killer, HIW"你在国庆节期间，实践市民精神争做文明职工，勤勉可嘉！\n"NOR);
					}
				}
				else
				{
					killer->set("quest_failed",(int)killer->query("quest/task_time") + (int)killer->query("quest/time"));

					if( time() >= killer->query("quest_failed") )
					{
						killer->delete_temp("quest_count");
						killer->delete("quest_failed");
					}

					tell_object(killer, YEL"你没有在规定时间完成你的任务，你的任务失败了！\n"NOR);
					killer->delete_temp("count");
					killer->delete("quest");
				}
			}
			else
				COMBAT_D->killer_reward(killer, this_object());
		}
		else
			COMBAT_D->killer_reward(killer, this_object());		//显示这里有bug
	}		
	else
		COMBAT_D->die_for(this_object());

	if ( objectp(corpse = CHAR_D->make_corpse(this_object(), killer)) )
		corpse->move(environment());

	this_object()->remove_all_killer();//解除所有仇恨
	all_inventory(environment())->remove_killer(this_object());//解除仇恨
	this_object()->dismiss_team();//解除团队战斗仇恨
	this_object()->clear_condition(1);//清除中毒状态
	if (this_object()->is_busy()) this_object()->interrupt_me();
	if( playerp(this_object()) )
	{
		set("jing", 1);
		set("neili", 0);
		set("jingli", 0);
		set("eff_jing", 1);
		set("qi", 1);
		set("eff_qi", 1);
		ghost = 1;
		delete_temp("last_unconcious_from");
		delete_temp("die_for");
		this_object()->move(DEATH_ROOM);
		DEATH_ROOM->start_death(this_object());//不知道这个函数是干嘛用的，系统里也找不到这个函数

		if ( query("env/myhp_show") && !query("xieyi/zmud") )
			tell_object(this_object(), my_hp(this_object()));
	}
	else
		destruct(this_object());
}

void reincarnate()
{
	if ( !ghost )
		return;

	ghost = 0;
	set("eff_jing", query("max_jing"));
	this_object()->start_busy(0);
	set("eff_qi", query("max_qi"));
	UPDATE_D->check_user(this_object());
	if ( query("env/myhp_show") && !query("xieyi/zmud") )
		tell_object(this_object(), my_hp(this_object()));
}

int max_food_capacity()
{
	return query_weight() / 50;
}

int max_water_capacity()
{
	return query_weight() / 50;
}

int heal_up()
{
	int update_flag;
	mapping my;
	object me;
	me = this_object();

	if ( ghost && userp(this_object()) )
	{
		set("eff_qi",1);

		if ( query("env/myhp_show") && !query("xieyi/zmud") )
			tell_object(this_object(), my_hp(this_object()));

		return -1;
	}

	if ( environment() )
		if (environment()->query("freeze"))
			return -1;

	update_flag = 0;
	my = query_entire_dbase();

	counter++;
	if( my["water"] > 0 && counter >= 10 )
	{
		my["water"] -= 10;
		update_flag++;
	}

	if( my["food"] > 0 && counter >= 10 )
	{
		my["food"] -= 10;
		update_flag++;
	}

	if(counter>=10) counter=0;

	if ( userp(me) )
	{
		if( my["water"] < 1 || my["food"] < 1 )
		{
			if (my["jing"] > 0)
				my["jing"] -= my["max_jing"]/10;

			if ( living(me) )
			{
				if ( my["food"] < 1 )
					tell_object(this_object(),YEL "你已经饿得头晕眼花了！\n" NOR);

				if ( my["water"] < 1 )
					tell_object(this_object(),YEL "你已经渴得喉咙都快冒出烟来了！\n" NOR);
			}
			else
				me->set_temp("die_for","饿");

			if ( query("env/myhp_show") && !query("xieyi/zmud") )
				tell_object(this_object(), my_hp(this_object()));

			return update_flag;
		}
	}

	if( userp(me) && me->is_fighting())
		return -1;

	my["jing"] += me->query_con() / 3 + my["max_jingli"] / 10;

	if( my["jing"] >= my["eff_jing"] )
	{
		my["jing"] = my["eff_jing"];

		if( my["eff_jing"] < my["max_jing"] )
		{
			my["eff_jing"] ++;
			update_flag++;
		}
	}
	else update_flag++;

	my["qi"] += me->query_con()  / 3 + my["max_neili"] / 10;

	if( my["qi"] >= my["eff_qi"] )
	{
		my["qi"] = my["eff_qi"];

		if( my["eff_qi"] < my["max_qi"] )
		{
			my["eff_qi"] ++;
			update_flag++;
		}
	}
	else update_flag++;

	if( my["max_jingli"] && my["jingli"] < my["max_jingli"] )
	{
		if (userp(me))
			my["jingli"] += (int)me->query_skill("taoism", 1) / 2;
		else
			my["jingli"] += my["max_jingli"] / 5;

		if( my["jingli"] > my["max_jingli"] )
			my["jingli"] = my["max_jingli"];

		update_flag++;
	}

	if( my["max_neili"] && my["neili"] < my["max_neili"] )
	{
		my["neili"] += (int)me->query_skill("force", 1) / 2;

		if( my["neili"] > my["max_neili"] )
			my["neili"] = my["max_neili"];

		update_flag++;
	}

	if ( query("env/myhp_show") && !query("xieyi/zmud") )
		tell_object(this_object(), my_hp(this_object()));

	return update_flag;
}
