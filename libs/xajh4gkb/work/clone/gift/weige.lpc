// longhu.c 龙虎丹
//星星(lywin)2000/4/22

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
	set_name(HIR"龙虎丹"NOR, ({"longhu dan", "dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "粒");
		set("long", "这是一粒男士梦寐以求的龙虎丹，据说吃了能一夜七次郎。\n");
		set("value", 100000);
	}
	setup();
}

int do_eat(string arg)
{
object me = this_player();		
object ob;		
	if (!id(arg))
	return notify_fail("你要吃什么？\n");
if( !objectp(ob = present(arg, me)) )
return notify_fail("什么?\n");			

	this_player()->add("jingli", 10000);
	this_player()->add("neili",10000);
	message_vision("$N吃下一棵龙虎丹，只觉得自己精神亢奋无比 !\n", this_player());
	destruct(this_object());
	return 1;
}

