// 封妖符--增加雷峰塔次数

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_use", "use");
}

void create()
{
	set_name(HIR"封妖符"NOR, ({"fengyao fu", "fu"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "张");
		set("long", "这是法海禅师炼制的封妖符纸，使用(use)后获得进入雷峰塔一次机会。\n");
		set("value", 1000000);
	}
	setup();
}

int do_use(string arg)
{
	object me = this_player();		
	object ob;		
	if (!id(arg))
		return notify_fail("你要用什么？\n");
	if( !objectp(ob = present(arg, me)) )
		return notify_fail("什么?\n");			

	this_player()->delete("day_leifengta_timecd");
	message_vision("$N将封妖符贴在身上，获得法海金光护体，可以进入雷峰塔历练一次。\n", this_player());
	destruct(this_object());
	return 1;
}

