//zongzi  粽子

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIR "九转金丹" NOR, ({ "jiuzhuan jindan", "jindan" }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "这是太上老君炼制的无上仙丹，无任何副作用效果，据说吃了能易筋洗髓，提升人的资质。\n");
                set("value", 10000000);
                set("unit", "颗");
        }
}

void init()
{
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	int add_gift;
	if (!id(arg))
		return notify_fail("你要吃什么？\n");
	if ( this_player()->query("id")!=this_object()->query("owner") )
	{
		tell_object(this_player(), "哼！这是毛主席奖励给你的九转金丹吗？\n");
		this_player()->set_temp("fandongpai",1);
		return 1;
	}
	if (this_player()->query("gift/jiuzhuan") >= 5)
	{
		message_vision("$N眨眨眼。\n", this_player());
		tell_object(this_player(), "你觉得这药没啥味道，还不如花生好吃。\n");
		destruct(this_object());
		return 1;
	}
	add_gift = (100000+random(50000))*(int)this_player()->query("jieri_gift/guoqing");
	if (random(2)==0) this_player()->add("max_neili",add_gift);
	else this_player()->add("max_jingli",add_gift);
	switch (random(6))
	{
		case 0:this_player()->add("str",1);break;
		case 1:this_player()->add("int",1);break;
		case 2:this_player()->add("con",1);break;
		case 3:this_player()->add("dex",1);break;
		case 4:this_player()->add("per",1);break;
		case 5:this_player()->add("kar",1);break;
	}
	this_player()->add("gift/jiuzhuan", 1);
	this_player()->set("jieri_gift/maozhuxi_laodong",1);
	this_player()->set("jieri_gift/maozhuxi_duanwu",1);
	this_player()->delete("jm/maozhuxi_laodong_1");
	this_player()->delete("jm/maozhuxi_duanwu_1");
	message_vision("$N狼吞虎咽地将" + this_object()->name() + "吃了下去。\n", this_player());
	tell_object(this_player(), HIG "你浑身发热，丹田内力直冲奇经八脉，开启了一道人体宝藏之门。\n"NOR);
	destruct(this_object());
	return 1;
}
