// lingzhi.c 千年灵芝
//星星(lywin)2000/4/22

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
	set_name(HIR"测试丹"NOR, ({"ceshi dan", "dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "棵");
		set("long", "这是一棵游戏测试丹药。\n");
		set("value", 10000);
	}
	setup();
}

int do_eat(string arg)
{
	object me = this_player();		
	object ob;		
	if (!id(arg))
		return notify_fail("你要吃什么？\n");
	if( !objectp(ob = present(arg, me)) )
		return notify_fail("什么?\n");			

	this_player()->set("xyzx_sys/level", 5000);
	this_player()->set("potential",10000000000);
	this_player()->set("max_neili",5000000);
	this_player()->set("max_jingli",5000000);
	this_player()->set("more_money",5000);
	this_player()->set("score",100000000);
	this_player()->set_skill("literate",10000);
	this_player()->set_skill("force",10000);
	this_player()->set_skill("unarmed",10000);
	this_player()->set_skill("dodge",10000);
	this_player()->set_skill("parry",10000);
	this_player()->set("breakup",1);
	message_vision("$N吃下一棵测试丹，只觉得自己实力暴涨。\n", this_player());
	destruct(this_object());
	return 1;
}

