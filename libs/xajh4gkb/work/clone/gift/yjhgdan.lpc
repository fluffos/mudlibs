//易筋换骨丹

#include <ansi.h>
inherit ITEM;

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIM "易筋换骨丹" NOR, ({ "yijinhuangu dan", "dan" }));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗绿色的丹丸，据说吃了可以脱胎换骨，跌入地狱。\n");
    set("value", 20000000000);
    set("no_sell", 1);
    //	set("no_drop",1);
  }
}

int do_eat(string arg) {
  string *skills;
  mapping all_skills;
  int i, level;
  if (!id(arg))
    return notify_fail("你要吃什么药？\n");

  level = this_player()->query("xyzx_sys/level") / 2;
  if (level > 0) this_player()->set("xyzx_sys/level", level);
  this_player()->delete("family");
  this_player()->delete("title");
  this_player()->delete("camp");
  this_player()->delete("genderbak");
  if ((string)this_player()->query("gender") == "无性") this_player()->set("gender", "男性");
  this_player()->delete("family_score");
  this_player()->delete("jm");
  all_skills = this_player()->query_skills();
  skills = keys(all_skills);
  for (i = 0; i < sizeof(skills); i++) {
    this_player()->delete_skill(skills[i]);
  }
  message_vision(HIB "$N吃下一颗易筋换骨丹，顿时浑身经脉错乱，好半天才恢复过来。\n", this_player());
  message_vision(HIY "$N痛心疾首，发现等级降低一半，技能全部忘记了。\n", this_player());
  destruct(this_object());
  return 1;
}

int query_autoload() { return 1; }
