// lingzhi.c 千年灵芝
//星星(lywin)2000/4/22

#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIY "境界修正丹" NOR, ({ "jingjie dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "棵");
    set("long", "这是一棵境界修真丹，用于修正玩家的武学修为水平。\n");
    set("value", 1000000000);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();
  object ob;
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (!objectp(ob = present(arg, me)))
    return notify_fail("什么?\n");

  if (!(int)me->query("breakup", 1)) me->set("cognize", "凡人");
  if ((int)me->query("breakup", 1) == 1) me->set("cognize", HIC "后天境界" NOR);
  if ((int)me->query("breakup", 1) == 2) me->set("cognize", HIG "先天意境" NOR);
  if ((int)me->query("breakup", 1) == 3) me->set("cognize", HIM "天人之道" NOR);
  if ((int)me->query("breakup", 1) == 4) me->set("cognize", HIR "破碎虚空" NOR);
  if ((int)me->query("breakup", 1) >= 1) {
    me->set("jingmai/renmai", 1); me->set("jingmai/dumai", 1);
  }
  if ((int)me->query("breakup", 1) >= 2) {
    me->set("jingmai/chongmai", 1); me->set("jingmai/daimai", 1);
  }
  if ((int)me->query("breakup", 1) >= 3) {
    me->set("jingmai/yinqiaomai", 1); me->set("jingmai/yangqiaomai", 1);
  }
  if ((int)me->query("breakup", 1) >= 4) {
    me->set("jingmai/yinweimai", 1); me->set("jingmai/yangweimai", 1);
  }
  message_vision("$N吃下一棵境界修正丹，在江湖中的武学修为得到了修正。\n", this_player());
  destruct(this_object());
  return 1;
}
