//真武剑--名器
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIC "真武剑" NOR, ({ "zhenwu jian", "zwsword", "sword" }));
  set_weight(7000);
  set("owner", "张三丰");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是武当镇山之宝的真武宝剑。\n");
    set("value", 15000000);
    set("icon", "10017");
    set("weapon_prop/karma", 10);
    set("weapon_prop/dodge", 10);
    set("weapon_prop/force", 20);
    set("weapon_prop/constitution", 10);
    set("weapon_prop/sword", 40);
    set("material", "steel");
    set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
    set("task", 1);
    set("no_put_in", 1);
  }
  init_sword(500, 2);
  setup();
}
int query_autoload() { return 1; }
