//无根丹

#include <ansi.h>
inherit ITEM;

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIG "无根丹" NOR, ({ "wugen dan", "dan" }));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗红色的丹丸，据说吃了可以让某种无根人士体会到妙不可言的意境。\n");
    set("value", 10000000000);
    set("no_sell", 1);
    //	set("no_drop",1);
  }
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么药？\n");
  if ((string)this_player()->query("gender") == "女性")
    return notify_fail("你是女人，难道还想长出男人的东西？\n");
  if ((string)this_player()->query("gender") == "男性") {
    message_vision(HIB "$N吃下一颗无根丹，然而......苦不堪言......你连忙吐了出来。\n", this_player());
    message_vision(HIY "$N低头一看，然来长在身上，只是没有雄起而已，你吓的一身冷汗...\n", this_player());
    destruct(this_object());
    return 1;
  }
  if ((string)this_player()->query("gender") == "无性") {
    if ((string)this_player()->query("genderbak") == "男性") {
      message_vision(HIB "$N吃下一颗无根丹，顿时......下体发热......你一时惊喜不已。\n", this_player());
      message_vision(HIY "$N哈哈大笑，满面流涕，喜极而泣，终于又可以体验到做男人挺好。\n", this_player());
      this_player()->set("gender", "男性");
      this_player()->delete("genderbak");
      destruct(this_object());
      return 1;
    } else {
      message_vision(HIC "$N吃下一颗无根丹，然而......没有任何反应......。\n", this_player());
      message_vision(HIC "$N叹了口气，罢了罢了。\n", this_player());
      destruct(this_object());
      return 1;
    }
  }

  return 1;
}

int query_autoload() { return 1; }
