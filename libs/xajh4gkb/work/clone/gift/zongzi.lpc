//zongzi  粽子

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIM "粽子" NOR, ({ "zong zi", "zongzi" }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "使用粽叶包裹糯米蒸制而成的粽子，是中华民族传统节庆食物，据说有神奇的效果。\n");
                set("value", 10000000);
                set("unit", "颗");
        }
}

void init()
{
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	int add_gift;
	if (! id(arg))
		return notify_fail("你要吃什么？\n");
	if ( this_player()->query("id")!=this_object()->query("owner") )
	{
		tell_object(this_player(), "哼！这是毛主席奖励给你的粽子吗？\n");
		this_player()->set_temp("pantou",1);
		return 1;
	}
	add_gift = (20+200000/((int)this_player()->query("xyzx_sys/level",1)+1000))*(int)this_player()->query("jieri_gift/duanwu");
	this_player()->add("xyzx_sys/level",add_gift);
	message_vision("$N狼吞虎咽地将" + this_object()->name() + "吃了下去。\n", this_player());
	tell_object(this_player(), HIG "你浑身发热，小宇宙爆发，实力大涨。\n");
	destruct(this_object());
	return 1;
}
