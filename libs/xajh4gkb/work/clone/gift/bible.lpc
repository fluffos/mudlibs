// bible.c

inherit ITEM;
#include <ansi.h>
void create()
{
	set_name(YEL"圣经"NOR, ({ "bible"}));
	set_weight(600);
	set("task",1);
	set("owner","教父");
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long",
			"这是一本圣经，上面写了一些教义。\n"
			);
		set("value", 1000000);
		set("material", "paper");
		set("skill", ([
			"name":	"qimen-wuxing",		// name of the skill
//			"exp_required":	0,		// minimum combat experience required
//			"literate_required":10,		// to learn this skill.
			"jing_cost":300,			// gin cost every time study this
			"difficulty":100,		// the base int to learn this skill
			"max_skill":1000,		// the maximum level you can learn
//			"min_skill": 100,
		]) );
	}
	setup();
}
int query_autoload() { return 1; }	
