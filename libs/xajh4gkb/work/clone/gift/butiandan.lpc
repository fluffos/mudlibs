// shenliwan.c 神力丸

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIR "补天丹" NOR, ({ "butian dan", "dan" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗五彩的补天丹，据说由女娲灵气所化，可以弥补先天残缺之人的遗憾，故名补天。\n");
    set("value", 10000000000);
    set("no_sell", 1);
    set("unit", "颗");
  }
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me, ob;
  int xiantian;
  me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (!objectp(ob = present(arg, me)))
    return notify_fail("什么?\n");

  xiantian = (int)me->query(
    "str",
    1
  ) + (int)me->query("int", 1) + (int)me->query("con", 1) + (int)me->query("dex", 1);
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() + "。\n", me);
  if (xiantian > 120) {
    message_vision(HIB "$N连忙吐了出来，发现这丹苦若黄连。\n" NOR, me);
    tell_object(me, HIR "上天之德，补有缺憾之人。\n" NOR);
    me->set("butian", 1);
  } else if (me->query("butian")) {
    message_vision(HIB "$N眨眨眼，感觉啥味道也没有。\n" NOR, me);
    tell_object(me, HIM "人之一生，极少之人虽有先天缺失，但上天之德，亦唯有一次。\n" NOR);
  } else if (random(10) == 0) {
    tell_object(me, HIC "不过你觉得好像没什么作用，或许需再吃一颗。\n" NOR);
  } else {
    tell_object(me, HIR "你吃下一颗补天丹，顿时浑身如沐春风。\n" NOR);
    me->delete("gift");
    me->delete("liandan");
    me->set("butian", 1);
    me->set("str", 20);
    me->set("con", 20);
    me->set("int", 20);
    me->set("dex", 20);
    me->set("kar", 30);
    me->set("per", 30);
  }

  destruct(this_object());
  return 1;
}
