// jiuyang2.c
inherit ITEM;
inherit F_UNIQUE;
void setup() {}
void init() {
  add_action("do_canwu", "canwu");
}
void create() {
  set_name("「九阳真经」第二卷", ({ "jiuyang zhenjing2", "jiuyang2", "zhenjing2" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这是一本薄薄的经书，只因油布包得紧密，虽长期藏在猿腹之中，书页仍然完好无损。\n"
      "书面上写著几个弯弯曲曲的文字，他一个也不识得，翻开来一看，四本书中尽是这些怪\n"
      "文，但每一行之间，却以蝇头小楷写满了中国文字。可以参悟（canwu）。\n",);
    set("value", 0);
    set("material", "paper");
    /*                set("skill", ([
                        "name"        : "jiuyang-shengong",
                        "exp_required":  1000,
                        "jing_cost"   :  40,
                        "difficulty"  :  30,
                        "max_skill"   :  200,
                        "min_skill"   :  100 
                ]) );*/
  }
}

int do_canwu(string arg) {
  object me = this_player();
  object where = environment(me);
  object ob = this_object();
  int i, pxlevel, neili_lost;
  mapping skl;
  string *sname;

  if (!(arg == "jiuyang zhenjing2" || arg == "zhenjing2")) return 0;
  if (!objectp(ob = present(arg, me)))
    return notify_fail("你要读什么?\n");
  if (where->query("pigging")) {
    write("你还是专心拱猪吧！\n");
    return 1;
  }
  if (me->is_busy()) {
    write("你现在正忙着呢。\n");
    return 1;
  }
  if (me->is_fighting()) {
    write("你无法在战斗中专心下来研读新知！\n");
    return 1;
  }
  if (!id(arg)) {
    write("你要读什么？\n");
    return 1;
  }
  if (me->query("id") != ob->query("owner")) {
    write("这本武林秘籍是你的吗？\n");
    return 1;
  }
  if (me->query("gender") != "男性") {
    write("九阳神功需要阳刚之气，不适合你学。\n");
    return 1;
  }
  if (me->query("couple") || me->query("make_loves")) {
    write("你精气已泄，不能领悟九阳神功的奥妙之处。\n");
    return 1;
  }
  if ((int)me->query_skill("literate", 1) < 2000) {
    write("你大字不识得几个，如何能读这深奥的道藏典籍。\n");
    return 1;
  }
  if ((int)me->query_skill("force", 1) < 2000) {
    write("你研读了一会儿，但是发现上面所说的对你而言都太深奥了。\n");
    return 1;
  }
  message("vision", me->name() + "正专心地研读道藏典籍。\n", environment(me), me);
  if ((int)me->query("jing") < 15) {
    write("你现在过于疲倦，无法专心下来参悟典籍。\n");
    return 1;
  }
  neili_lost = 50;
  if ((int)me->query("neili") < neili_lost) {
    write("你内力不够，无法钻研这么高深的武功。\n");
    return 1;
  }
  pxlevel = me->query_skill("jiuyang-shengong", 1);
  if ((int)me->query("combat_exp") < (int)pxlevel * pxlevel * pxlevel / 10) {
    write("你的实战经验不足，再怎么读也没用。\n");
    return 1;
  }
  if (me->query_skill("jiuyang-shengong", 1) < 100) {
    write("你研读了一会儿，但是发现上面所说的对你而言都太深奥了，没有学到任何东西。\n");
    return 1;
  }
  if (me->query_skill("jiuyang-shengong", 1) > 200) {
    write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
    write("你已经读完了《九阳真经》，经文裂成碎片，化作一个个符文烙印在你的心中。\n");
    destruct(ob);
    return 1;
  }
  if (me->query_skill("jiuyang-shengong", 1) <= 200) {
    skl = me->query_skills();
    sname = keys(skl);
    for (i = 0; i < sizeof(skl); i++) {
      if (sname[i] == "jiuyang-shengong") continue;
      if (sname[i] == "yijing-force") continue;
      if (sname[i] == "xixing-dafa") continue;
      if (SKILL_D(sname[i])->valid_enable("force"))
        return notify_fail("你不先散了别派内功，怎能修炼九阳神功？！\n");
    }
    me->add("neili", -neili_lost);
    me->start_busy(1);
    write("你研读九阳真经，颇有心得。\n");
    write("你坐下来，长舒一口气，他强由他强，清风拂山岗。\n");
    me->improve_skill(
      "jiuyang-shengong",
      (int)me->query_skill("literate", 1) * me->query("int", 1) / 10 + 10
    );
    return 1;
  }
  if (!me->query_skill("jiuyang-shengong", 1)) {
    write("                   《九阳真经》阅读指南\n"
      "\n   只有纯阳体质之人，方可修习九阳神功！\n");
  }

  return 1;
}
int query_autoload() { return 1; }
