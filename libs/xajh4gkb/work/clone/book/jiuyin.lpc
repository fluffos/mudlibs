
#include <ansi.h>; 
inherit ITEM;
inherit F_UNIQUE;
void setup()
{}
void init()
{
	add_action("do_canwu", "canwu");
}
void create()
{
	set_name("九阴真经", ({ "jiuyin zhenjing","zhenjing", }));
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long",
			"这是一本用薄绢写成的书。上书：“道藏典籍”。书皮泛黄，看来已经保存很久了\n"
			"由皇家图书管理员黄裳整理而成，其蕴含了某种内功修行之法（canwu）。\n",);
		set("value", 0);
		set("material", "silk");
/*		set("skill", ([
				"name":"jiuyin-zhenjing",
				"exp_required":100000,
				"jing_cost":  40,
				"difficulty": 20,
				"max_skill":  200
			]) );*/
	}
}
int do_canwu(string arg)
{
	object me = this_player();
	object where = environment(me);
	object ob = this_object();
	int i,pxlevel,neili_lost;
	mapping skl;
	string *sname;
	
	if (!(arg=="jiuyin zhenjing" || arg == "zhenjing")) return 0;
	if( !objectp(ob = present(arg, me)) )	
		return notify_fail("你要读什么?\n");	
	if (where->query("pigging"))
	{
		write("你还是专心拱猪吧！\n");
		return 1;
	}
	if (me->is_busy()) 
	{
		write("你现在正忙着呢。\n");
		return 1;
	}
	if( me->is_fighting() ) 
	{
		write("你无法在战斗中专心下来研读新知！\n");
		return 1;
	}
	if (!id(arg)) 
	{	
		write("你要读什么？\n");
		return 1;
	}
	if ( me->query("gender") != "女性")
	{
		write("九阴真经需要阴柔体质，不适合你学。\n");
		return 1;		
	}
	if(me->query("couple") || me->query("make_loves"))
	{
		write("你元气已失，不能领悟九阴真经的奥妙之处。\n");
		return 1;		
	}	
	if( (int)me->query_skill("literate", 1)<2000 )
	{
		write("你大字不识得几个，如何能读这深奥的道藏典籍。\n");
		return 1;
	}
	if( (int)me->query_skill("force",1) < 2000 )
	{
		write("你研读了一会儿，但是发现上面所说的对你而言都太深奥了。\n");
		return 1;
	}	
	message("vision", me->name() + "正专心地研读道藏典籍。\n", environment(me), me);
	if( (int)me->query("jing") < 15 ) 
	{
		write("你现在过于疲倦，无法专心下来参悟典籍。\n");
		return 1;
	}
	neili_lost = 50;
	if( (int)me->query("neili") < neili_lost) 
	{
		write("你内力不够，无法钻研这么高深的武功。\n");
		return 1;
	}
	pxlevel = me->query_skill("jiuyin-zhenjing", 1);
	if( (int)me->query("combat_exp") < (int)pxlevel*pxlevel*pxlevel/10 ) 
	{
		write("你的实战经验不足，再怎么读也没用。\n");
		return 1;
	}
	if( me->query_skill("jiuyin-zhenjing", 1) > 400)
	{
		write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
		write("你已经读完了《九阴真经》，经文裂成碎片，化作一个个符文烙印在你的心中。\n");
		destruct(ob);	
		return 1;
	}
	if (me->query_skill("jiuyin-zhenjing", 1)<=400)
	{	
			skl = me->query_skills();
			sname  = keys(skl);
			for (i=0;i<sizeof(skl);i++)
			{
				if (sname[i]=="jiuyin-zhenjing") continue;
				if (sname[i]=="yijing-force") continue;
				if (sname[i]=="xixing-dafa") continue;	
				if( SKILL_D(sname[i])->valid_enable("force") )
					return notify_fail("你不先散了别派内功，怎能修炼九阴真经？！\n");
			}
			me->add("neili", -neili_lost);
			me->start_busy(1);
			write("你研读道藏典籍，颇有心得。\n");
			write("你坐下来，长舒一口气，把逆转的内力缓缓汇入丹田。\n");
			me->improve_skill("jiuyin-zhenjing", (int)me->query_skill("literate", 1)*me->query("int",1)/10+10);
			return 1;
	}	
	if( !me->query_skill("jiuyin-zhenjing", 1) ) 
	{
		write("                   《九阴真经》阅读指南\n"
				"\n   只有纯阴体质之人，方可修习九阴真经！\n");
	}	

	return 1;
}
int query_autoload() { return 1; }      