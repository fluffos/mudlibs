// guoguo
inherit ITEM;
inherit F_SAVE;

#define BOOK_LIFECIRCLE 432000  //5天
void create() {
  set_name("破旧琴谱", ({ "qinpu", "book" }));
  set_weight(600);
  set("unit", "本");
  set("value", 1000);
  set("long", "一本又破又旧的琴谱。\n");
  set("material", "paper");
  set("xyzx_save_item", 1);
  set("owner_id", 1);
  set("no_sell", 1);
  set("skill", ([
    "name": "fadai-qigong",
    "exp_required": 100,
    "jing_cost": 10,
    "difficulty": 10,
    "max_skill": 1
  ]));
}

void init() {
  if (environment() == this_player()) {
    add_action("do_study", "study");
  }
}

int do_study(string arg) {
  object obj = this_object();
  object me = this_player();
  int time = query("create_time");
  if ((time() - time) > BOOK_LIFECIRCLE) {
    tell_object(me, HIW "你身上的破旧琴谱实在禁不起你的多次翻阅，完全破碎了。\n" NOR);
    destruct(obj);
    return 1;
  }
  return 0;
}
