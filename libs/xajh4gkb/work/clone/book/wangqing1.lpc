inherit ITEM;
inherit F_UNIQUE;

void init()
{
	add_action("do_canwu", "canwu");
}  
void create()
{
        set_name("忘情天书上册", ({ "wangqing tianshu1","tianshu1", }));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
             set("long",
        "这是一本古色古香的书卷。上书：“忘情天书”。\n"
        "书页泛黄，看来已经保存很久了。\n",
        );
                set("value", 0);
                set("material", "silk");
                set("skill", ([
                        "name":       "art",
        "exp_required":100000,
                        "jing_cost":  40,
                        "difficulty": 20,
                        "max_skill":  200
                ]) );
        }
}

int do_canwu(string arg)
{
        object me = this_player();
        object where = environment(me);
        object ob = this_object();
		string msg;
        int zhuihun, lvl;
        int cost;

        if (arg != "wangqing tianshu1")
                return notify_fail("你要参悟什么？\n");
		if( where->query("no_fight") )
				return notify_fail("大庭广众之下参悟绝世武学不怕被人打劫吗？。\n");
        if (where->query("pigging"))
                return notify_fail("你还是专心拱猪吧！\n");
        if (me->is_busy())
                return notify_fail("你现在正忙着呢。\n");
        if( me->is_fighting() )
                return notify_fail("你无法在战斗中专心下来参悟真经！\n");
        if (!id(arg) || !objectp(ob = present(arg, me)))
                return notify_fail("你要参悟什么？\n");
		if ( me->query("id")!=ob->query("owner"))
			return notify_fail("这本武林秘籍是你的吗？\n");			
        if ((string)me->query("gender") == "无性" )
                return notify_fail("你无根无性不足，再参悟下去恐怕经脉俱断！\n");
        if( (int)me->query_skill("literate", 1)<1000 )
                return notify_fail("你是个文盲，先学点文化(literate)吧。\n");
        if( (int)me->query_skill("biyun-xinfa", 1)<1000 )
                return notify_fail("你没有碧云心法做根坻，恐怕有走火入魔之危！\n");
        if( (int)me->query_skill("zhuihun-biao", 1)<2000 )
                return notify_fail("你的追魂镖不够娴熟，就算参悟也无法领悟观音泪！\n");
//        if( (int)me->query_skill("dagou-bang", 1)<2000 )
//                return notify_fail("你的打狗棒法练的不到家，没法参悟玉竹杖的秘密！\n");
        if ((int)me->query_skill("force", 1) < 2000)
                return notify_fail("忘情天书最注重内功修为，没有精湛的内功支持难以修行！\n");
//		if (me->query_skill_mapped("unarmed") != "xianglong-zhang")
//				return notify_fail("你没准备好降龙掌法吧，这如何参悟呢。\n");
//		if (me->query_skill_mapped("club") != "dagou-bang")
//				return notify_fail("你没准备好打狗棍法吧，这如何参悟呢。\n");			
//		if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("id") != "yuzhu zhang")
//				return notify_fail("你手里似乎没有玉竹杖啊，这如何能参悟打狗降龙呢！\n");	
        if ((int)me->query("max_neili", 1) < 100000)
                return notify_fail("你内力修为太差了，无法进入忘情境界。\n");
        if ((int)me->query("max_jingli", 1) < 100000)
                return notify_fail("你精力修为太差了，无法进入忘情状态。\n");
        if( !me->query_temp("jm/tangmen5") )
                return notify_fail("你未得到萧秋水的指点，如何能参悟忘情天书！\n");				
        if( me->query("jm/tangmen") )
                return notify_fail("你已经完全领悟了这本忘情天书上的内容了！\n");
			
        if( (int)me->query("neili") < 1000 || (int)me->query("jingli") < 1000) 
		{
                write( CYN"忽然，你觉得内息一乱，知道不好！顿时内力不受控制，全身经脉紊乱，眼前一黑！！！\n"NOR);
//				me->add("xyzx_sys/level",-1);
                me->unconcious();
                return 1;
        }

        zhuihun = me->query_skill("zhuihun-biao", 1);
        cost = zhuihun/10;
        if( cost < 100) cost = 100;
        lvl = random((int)me->query_skill("zhuihun-biao", 1))/100;
        if( lvl < 1) lvl = 1;

        message_vision("你右掌竖立胸前，眼眸闪烁佛光，身后幻化出" + lvl + "道光影。\n", me);
		me->start_busy(1);
        me->add("jingli", -cost);
        me->add("neili", -cost);
		if (random(100000)<(int)me->query("kar",1))
		{
			message_vision(HIR"突然你灵光一闪，双手合十，身后佛光凝聚成一道宝相庄严的佛像，如南海观音，紧接着大慈大悲的观音挥手洒出一滴眼泪，如流星般灿烂，一刹那瞬间称为永恒。\n"NOR, me);
			message_vision(HIR"。恭喜你参悟忘情天书，领悟了唐门的绝技观音泪！\n"NOR, me);
			message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，参悟忘情天书，居然领悟了唐门的绝世暗器观音泪！\n"NOR,users() );
			me->set("jm/tangmen",1);
			me->add("family_score",1);
			destruct(ob);
		}
		else
		{
			switch ( random(8) )
			{
			case 0: msg = HIB"如是我闻。一五九时。佛住有卫华国园。心得自在。皆于无量铸华光一五九时三菩提心不退转。\n" NOR;
					break;
			case 1: msg = GRN"一者。不得作天王。二者。帝吾。三者。模王。四者。转轮圣王。五者。佛身。\n" NOR;
					break;
			case 2: msg = YEL"天龙八部。人与非人。皆遥见此隆女成佛。普为时会人天说法。\n" NOR;
					break;
			case 3: msg = BLU"大智德勇健。 化度无量众。 今此铸大会。 及我皆已见。 \n" NOR;
					break;
			case 4: msg = MAG"物极必反，亢必有悔。以极阳之势，待强弩之末，有悔得吉，彼吝得凶。\n" NOR;
					break;
			case 5: msg = CYN"若有所不空，应当有所空，不空尚不得，何况得于空？\n" NOR;
					break;
			case 6: msg = WHT"凡人见不空，亦复见于空，不见见无见，是实名涅盘。\n" NOR;
					break;
			case 7: msg = HIR"不二安隐门，能破诸邪见；诸佛所行处，是名无我法。\n" NOR;
					break;				
			}
			message_vision(msg, me);
		}
		
        return 1;
}


int query_autoload() { return 1; }      