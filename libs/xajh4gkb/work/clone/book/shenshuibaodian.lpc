inherit ITEM;
inherit F_UNIQUE;

void init() {
  add_action("do_canwu", "canwu");
}
void create() {
  set_name("神水宝典", ({ "shenshui baodian", "baodian", }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "页");
    set("long",
      "这是一本用薄绢写成的经文。上书：“神水宝典”。\n"
      "书页泛黄，看来已经保存很久了，据说可以参悟（canwu）。\n",
    );
    set("no_drop", "武功秘籍可不能随便丢弃！\n");
    set("no_give", "这样东西不能随便给人。\n");
    set("value", 0);
    set("material", "silk");
    set("skill", ([
      "name": "mingyu-shengong",
      "exp_required": 100000,
      "jing_cost": 40,
      "difficulty": 20,
      "max_skill": 200
    ]));
  }
}

int do_canwu(string arg) {
  object me = this_player();
  object where = environment(me);
  object ob, cloth;
  string msg;
  int mingyugong, lvl;
  int cost;
  ob = this_object();

  if (arg != "shenshui baodian")
    return notify_fail("你要参悟什么？\n");
  if (where->query("no_fight"))
    return notify_fail("大庭广众之下参悟绝世武学不怕被人打劫吗？。\n");
  if (where->query("pigging"))
    return notify_fail("你还是专心拱猪吧！\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (me->is_fighting())
    return notify_fail("你无法在战斗中专心下来参悟真经！\n");
  if (!id(arg) || !objectp(ob = present(arg, me)))
    return notify_fail("你要参悟什么？\n");
  if (me->query("id") != ob->query("owner"))
    return notify_fail("这本武林秘籍是你的吗？\n");
  if ((string)me->query("gender") == "无性")
    return notify_fail("你无根无性不足，再参悟下去恐怕经脉俱断！\n");
  if ((int)me->query_skill("literate", 1) < 1000)
    return notify_fail("你是个文盲，先学点文化(literate)吧。\n");
  if ((int)me->query_skill("mingyu-shengong", 1) < 1000)
    return notify_fail("你没有明玉神功做根坻，恐怕有走火入魔之危！\n");
  if ((int)me->query_skill("yihua-jiemu", 1) < 2000)
    return notify_fail("你没有移花接木做根坻，恐怕有走火入魔之危！\n");
  if ((int)me->query_skill("force", 1) < 2000)
    return notify_fail("就这么点内功基础，恐怕会受到内力反噬！\n");
  if (objectp(cloth = me->query_temp("armor/cloth")))
    return notify_fail("修炼明玉神功最好是脱光了，否则受衣物阻隔，热力难以散发！\n");
  if ((int)me->query("max_neili", 1) < 100000)
    return notify_fail("你内力修为太差了，无法催动内力进入奇经八脉。\n");
  if ((int)me->query("max_jingli", 1) < 100000)
    return notify_fail("你精力修为太差了，无法进入顿悟状态。\n");
  if (!me->query_temp("jm_yihua8"))
    return notify_fail("你未得到邀月的指点，难以掌握明玉神功的诀窍！\n");
  if (me->query("jm/yihua"))
    return notify_fail("你已经将明玉神功修炼到第九重巅峰了！\n");

  if ((int)me->query("neili") < 1000 || (int)me->query("jingli") < 1000) {
    write(CYN "忽然，你觉得内息一乱，知道不好！顿时内力不受控制，全身经脉紊乱，眼前一黑！！！\n" NOR);
    //		me->add("xyzx_sys/level",-1);
    me->unconcious();
    return 1;
  }

  mingyugong = me->query_skill("mingyu-shengong", 1);
  cost = mingyugong / 10;
  if (cost < 100) cost = 100;
  lvl = mingyugong / 100;
  if (lvl < 1) lvl = 1;

  message_vision(
    HIG "你运转明玉神功，肌肤越来越透明，体内的真气会形成 " + HIR + chinese_number(lvl) + HIG + " 股漩涡吸力。\n" NOR,
    me
  );
  me->start_busy(1);
  me->add("jingli", -cost);
  me->add("neili", -cost);
  if (random(100000) < (int)me->query("kar", 1)) {
    message_vision(HIC "移花一开，生死你猜。明玉在手，青春我有。\n" NOR, me);
    message_vision(HIC "恭喜你破而后立，练成了明玉功第九层！\n" NOR, me);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，参悟神水宝典，一身修为已经达到无极修罗，易筋涅盘，淡梦逍遥的境界！\n" NOR,
      users()
    );
    me->set("jm/yihua", 1);
    me->add("family_score", 1);
  } else {
    switch (random(9)) {
      case 0: msg = RED "神水宝典第一层：弱水三千情独钟，繁花碧落生死共。\n" NOR;
      break;
      case 1: msg = GRN "神水宝典第二层：天门中断楚江开，碧水东流至此回。\n" NOR;
      break;
      case 2: msg = YEL "神水宝典第三层：白日地中出，黄河天外来。\n" NOR;
      break;
      case 3: msg = BLU "神水宝典第四层：不知江月待何人，但见长江送流水。\n" NOR;
      break;
      case 4: msg = MAG "神水宝典第五层：山无陵，江水为竭。冬雷震震，夏雨雪。\n" NOR;
      break;
      case 5: msg = CYN "神水宝典第六层：庭下如积水空明，水中藻、荇交横，盖竹柏影也。\n" NOR;
      break;
      case 6: msg = WHT "神水宝典第七层：美人如花隔云端！上有青冥之长天，下有渌水之波澜。。\n" NOR;
      break;
      case 7: msg = HIR "神水宝典第八层：无人无我，物我两忘，太上忘情。\n" NOR;
      break;
      case 8: msg = HIG "神水宝典第九层：天水明玉，枯木化石，四照阴阳，花神降世。\n" NOR;
      break;
    }
    message_vision(msg, me);
  }

  return 1;
}


int query_autoload() { return 1; }
