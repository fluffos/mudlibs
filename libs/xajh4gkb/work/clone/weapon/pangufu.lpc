//盘古开天斧-神兵
#include <weapon.h>
#include <ansi.h>
inherit AXE;

void create()
{
	set_name(HIY"盘古"+HIR"开天"+HIG"斧"NOR, ({ "pangu kaitian fu", "pangu fu","kaitian fu","axe" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("weapon_prop/unarmed", 40);
		set("weapon_prop/strength", 50);
		set("weapon_prop/constitution", 30);
		set("weapon_prop/karma", 50);
		set("weapon_prop/force", 30);
		set("weapon_prop/blade", 20);
		set("weapon_prop/axe", 50);
		set("no_get","怀璧其罪，这种宝物不是你的就不要去捡。\n");
		set("no_give","至宝，自己用都还来不及，如何能送人。\n");
		set("no_put","神器光芒四射，会刺破一切。\n");
		set("no_drop","这种上古神器得到了就是你的机缘，如何能轻易丢弃呢。\n");	
		set("unit", "把");
		set("value", 100000);
		set("icon", "10019");
		set("material", "iron");
		set("long", HIW"盘古氏所有，可有开天辟地、破碎虚空之功，列于上古十大神器首位。\n"NOR);
		set("wield_msg", HIC"$N从背后拿出大斧，双手握住斧柄，用力一挥，一股开天辟地之力充斥斧刃。\n"NOR);
		set("unwield_msg",HIC"$N完成开天辟地大业，不知把神斧扔在哪一天，自顾逍遥外游去了。\n"NOR);
	}

	init_axe(1200,1);
	setup();
}

int query_autoload() { return 1; }
mixed hit_ob(object me, object victim, int damage_bonus)
{
	int damage1,damage2;
	if( damage_bonus < 100 || this_object()->query("weapon_prop/damage")<100) return 0;
	damage1 = damage_bonus+this_object()->query("weapon_prop/damage")*5;
	damage2 = damage_bonus/2+this_object()->query("weapon_prop/damage");
	if( random(5)==1 ) 
	{
		damage1 += random(damage1);
		damage2 += random(damage2);
		victim->receive_damage("qi",damage1,me);
		victim->receive_wound("qi",damage2,me);
		message_vision(HIY"盘古"+HIR"开天"+HIG"斧"HIC"爆发出开天辟地的神力，一道夺目的光芒贯穿洪荒！\n" NOR, me, victim,damage1,HBWHT+HIR"特效伤气"NOR);
		return ;
	}
}
int move(mixed dest)
{
	if(! userp(dest)) return ::move(dest);
	if( ::move(dest)==0) return 0;
	if (dest->query_temp("god_weapon")!=this_object()->query("id"))
	{
		message("rumor",HIM"【江湖传奇】"+ HIY"据说上古神器之首"+ this_object()->query("name")+HIY"被"+ dest->query("name")+"("+dest->query("id")+")拿到手了！\n"NOR,users());
		dest->set_temp("god_weapon",this_object()->query("id"));
	}
	return 1;
}
