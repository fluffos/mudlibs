//鱼肠剑--名器
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
	set_name(HIW"鱼肠"NOR, ({ "yu chang", "yuchang","sword" }));
	set_weight(6000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把普通的小匕首。用来暗算别人比较合适。\n");
		set("value", 2000);
		set("weapon_prop/sword", 30);
		set("weapon_prop/parry", 10);
		set("weapon_prop/dexerity", 20);
		set("weapon_prop/karma", 10);		
		set("weapon_prop/dodge", 10);		
		set("material", "steel");
		set("wield_msg", "$N从兜里掏出一把$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n放会兜里。\n");
	}
	init_sword(450,2);
	setup();
}
int query_autoload() { return 1; }
