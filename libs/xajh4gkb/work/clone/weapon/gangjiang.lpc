//钢杖--普通
#include <ansi.h>
#include <weapon.h>
inherit STAFF;
void create() {
  set_name("钢桨", ({ "gangjiang", "staff" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是一根粗重的钢桨。\n");
    set("value", 1500);
    set("rigidity", 100);
    set("material", "steel");
    set("wield_msg", "$N抽出一根$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回腰间。\n");
  }
  init_staff(120, 2);
  setup();
}

int query_autoload() { return 1; }
