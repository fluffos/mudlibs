//皮鞭--普通
#include <ansi.h>
#include <weapon.h>
inherit WHIP;

void create()
{
	set_name( "皮鞭", ({ "pi bian","whip" ,"bian" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("value", 500);
		set("material", "skin");
		set("wield_msg", "$N从腰间抽出一条$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n束在腰间。\n");
	}
	init_whip(60,2);
	setup();
}
int query_autoload() { return 1; }
