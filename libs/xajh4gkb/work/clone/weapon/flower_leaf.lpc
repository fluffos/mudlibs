//花瓣--普通
#include <weapon.h>
#include <ansi.h>
inherit THROWING;
 
void create()
{
	set_name(RED+"花瓣"+NOR, ({ "flower leaf","leaf", "hua ban" }) );	
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "新鲜的玫瑰花的花瓣，上面还挂这晶莹的露珠。\n");
		set("unit", "把");
		set("value", 0);
		set("base_unit", "片");
		set("base_weight", 1);
		set("base_value", 0);
//		set("damage", 10);		//没必要在这里定义攻击力了
	}
	set_amount(150);
	init_throwing(50,2);
	setup();
}
int query_autoload() { return 1; }
