//月痕--神兵
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
	set_name(HIW"月"+HIC"痕"NOR, ({ "yue hen","jian", "sword" }) );
	set_weight(8000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("weapon_prop/dexerity", 30);
		set("weapon_prop/strength", 30);
		set("weapon_prop/constitution", 30);
		set("weapon_prop/dodge", 50);
		set("weapon_prop/force", 50);
		set("weapon_prop/sword", 50);
		set("weapon_prop/parry", 50);
		set("no_get",1);
		set("no_give",1);
		set("no_drop",1);
		set("no_put",1);
		set("no_sell",1);
//		set("badao", 1);
		set("icon", "10019");
		set("unit", "把");
		set("value", 20000000); 
		set("material", "steel");
		set("long", "一把月型软剑，据说是碧云才女纪嫣然的随身佩剑，据说这把剑还有个美丽的传说，其中蕴藏着神秘的力量。\n");   
		set("wield_msg", HIR"$N低吟一声,嫦娥应悔偷灵药 碧海青天夜夜心.一声脆响,$N手里无声无息的多了把月型软剑.\n"NOR);
		set("wield_msg", HIR"$N低吟一声...\n"            
			HIM"嫦娥应悔偷灵药 碧海青天夜夜心\n"           
			HIC"一道道月光不断向$N手中聚集...光亮越来越强,让人不能直视,天上明月如同共鸣般也发出强烈的光芒\n"              
			HIY"$N的手上忽地发出眩目的光芒...,$N手里已多了把闪耀着月光的"HIC"软剑.\n"NOR);              
} 
	init_sword(1000,1);
	setup();
}
int query_autoload() { return 1; }   
