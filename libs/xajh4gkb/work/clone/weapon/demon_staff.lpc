//霰血天魔杵（黑白无常专用）--神兵
#include <ansi.h>
#include <weapon.h>
inherit STAFF;
void create() {
  set_name(RED "霰 血 天 魔 杵" NOR, ({ "demon staff", "staff" }));
  set_weight(400000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把暗红色、两丈多长的巨杵。\n");
    set("material", "crimson gold");
    set("weapon_prop/karma", 20);
    set("weapon_prop/personality", 20);
    set("weapon_prop/intelligence", 20);
    set("weapon_prop/strength", 20);
    set("weapon_prop/dexerity", 20);
    set("weapon_prop/constitution", 20);
    set("weapon_prop/dodge", 50);
    set("weapon_prop/force", 50);
    set("weapon_prop/staff", 50);
    set("weapon_prop/parry", 50);
    set("value", 20000000);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
  }
  init_staff(1000, 1);
  setup();
}
int query_autoload() { return 1; }
//void owner_is_killed() {destruct(this_object());} 

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 100 || this_object()->query("weapon_prop/damage") < 100) return 0;
  if (random(5) == 1) {
    victim->receive_damage(
      "qi",
      (damage_bonus + this_object()->query("weapon_prop/damage") * 5),
      me
    );
    victim->receive_wound(
      "qi",
      (damage_bonus / 2 + this_object()->query("weapon_prop/damage")),
      me
    );
    victim->receive_damage(
      "jing",
      (damage_bonus + this_object()->query("weapon_prop/damage") * 5),
      me
    );
    victim->receive_wound(
      "jing",
      (damage_bonus / 2 + this_object()->query("weapon_prop/damage")),
      me
    );
    return HIB "黑白无常突然从霰血天魔杵中冲了出来，勾魂之镰直奔你头颅！\n" NOR;
  }
}
int move(mixed dest) {
  if (!userp(dest)) return ::move(dest);
  if (::move(dest) == 0) return 0;
  if (dest->query_temp("god_weapon") != this_object()->query("id")) {
    message(
      "rumor",
      HIR "【江湖传奇】" + HIC "据说神兵" + this_object()->query("name") + HIC "被" + dest->query("name") + "(" + dest->query("id") + ")拿到手了！\n" NOR,
      users()
    );
    dest->set_temp("god_weapon", this_object()->query("id"));
  }
  return 1;
}
