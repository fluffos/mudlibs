//飞蝗石--普通
#include <weapon.h>
#include <ansi.h>
inherit THROWING;

void create() {
  set_name("飞蝗石", ({ "feihuangshi", "shi" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一把,只有半寸来长的小刀。\n");
    set("unit", "堆");
    set("base_unit", "颗");
    set("base_weight", 200);
    set("base_value", 1);
    set("value", 100);
    //		set("damage", 10);		//没必要在这里定义攻击力了
  }
  set_amount(100);
  init_throwing(80, 2);
  setup();
}
void set_amount(int amount) {
  if (amount > 500) amount = 500;
  ::set_amount(amount);
}

int query_autoload() { return 1; }
