//伏羲琴-神兵
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
	set_name(HIR"伏羲琴"NOR, ({ "fuxi qin", "qin" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("weapon_prop/parry", 40);
		set("weapon_prop/intelligence", 35);
		set("weapon_prop/constitution", 25);
		set("weapon_prop/karma", 50);
		set("weapon_prop/force", 30);
		set("weapon_prop/personality", 20);
		set("weapon_prop/sword", 50);
		set("no_get","怀璧其罪，这种宝物不是你的就不要去捡。\n");
		set("no_give","至宝，自己用都还来不及，如何能送人。\n");
		set("no_put","神器光芒四射，会刺破一切。\n");
		set("no_drop","这种上古神器得到了就是你的机缘，如何能轻易丢弃呢。\n");	
		set("unit", "把");
		set("value", 100000);
		set("icon", "10019");
		set("material", "iron");
		set("long", HIW"以玉石加天丝所制出之乐器，泛着温柔的白色光芒，其琴音能使人心感到宁静祥和，据说拥有能支配万物心灵之神祕力量。\n"NOR);
		set("wield_msg", HIC"一道扣人心弦的月光闪烁，$N在身前摆放一具古筝。\n"NOR);
		set("unwield_msg",HIC"$N弹奏一曲，将古筝收了起来。\n"NOR);
	}

	init_sword(700,1);
	setup();
}

int query_autoload() { return 1; }
mixed hit_ob(object me, object victim, int damage_bonus)
{
	if( damage_bonus < 100 || this_object()->query("weapon_prop/damage")<100) return 0;
	if( random(5)==1 ) 
	{
		if (!victim->is_busy()) victim->start_busy(3);
		return HIC"$N中指轻挑琴弦，“峥”的一声，$n只觉得心灵不受控制，无法动弹！\n" NOR;
	}
}
int move(mixed dest)
{
	if(! userp(dest)) return ::move(dest);
	if( ::move(dest)==0) return 0;
	if (dest->query_temp("god_weapon")!=this_object()->query("id"))
	{
		message("rumor",HIM"【江湖传奇】"+ HIY"据说上古神器"+ this_object()->query("name")+HIY"被"+ dest->query("name")+"("+dest->query("id")+")拿到手了！\n"NOR,users());
		dest->set_temp("god_weapon",this_object()->query("id"));
	}
	return 1;
}
