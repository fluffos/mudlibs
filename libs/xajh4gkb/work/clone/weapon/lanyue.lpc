//揽月摘星-神兵
#include <weapon.h>
#include <ansi.h>
inherit WHIP;

void create()
{
	set_name(HIC"揽月"HIB"摘星"NOR, ({ "lanyue zhaixing", "lanyue","zhaixing","whip" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("weapon_prop/strength", 20);
		set("weapon_prop/intelligence", 50);
		set("weapon_prop/dexerity", 50);
		set("weapon_prop/force", 30);
		set("weapon_prop/dodge", 40);
		set("weapon_prop/whip", 50);
		set("weapon_prop/parry", 20);
		set("no_get","怀璧其罪，这种宝物不是你的就不要去捡。\n");
		set("no_give","至宝，自己用都还来不及，如何能送人。\n");
		set("no_put","神器光芒四射，会刺破一切。\n");
		set("no_drop","这种上古神器得到了就是你的机缘，如何能轻易丢弃呢。\n");	
		set("unit", "条");
		set("value", 100000);
		set("icon", "10019");
		set("material", "iron");
		set("long", HIY"三垣为画布，此鞭为软毫，可清夜起舞，拟为漫天星宿平添花鸟虫鱼。\n"NOR);
		set("wield_msg", HIC"翩若惊鸿，婉若游龙，仿佛兮若轻云之蔽月，飘飖兮若流风之回雪。\n"NOR);
		set("unwield_msg",HIC"凌波微步，罗袜生尘。体恤飞服，飘忽若神\n"NOR);
	}

	init_whip(900,1);
	setup();
}

int query_autoload() { return 1; }
mixed hit_ob(object me, object victim, int damage_bonus)
{
	int damage1,damage2;
	if( damage_bonus < 100 || this_object()->query("weapon_prop/damage")<100) return 0;
	damage1 = damage_bonus+this_object()->query("weapon_prop/damage")*5;
	damage2 = damage_bonus/2+this_object()->query("weapon_prop/damage");
	if( random(5)==1 ) 
	{
		damage1 += random(damage1);
		damage2 += random(damage2);
		victim->receive_damage("jing",damage1,me);
		victim->receive_wound("jing",damage2,me);
		if (!victim->is_busy()) victim->start_busy(3);
		message_vision("悼良会之永绝兮，哀一逝而异乡。\n" NOR, me, victim,damage1,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
}
int move(mixed dest)
{
	if(! userp(dest)) return ::move(dest);
	if( ::move(dest)==0) return 0;
	if (dest->query_temp("god_weapon")!=this_object()->query("id"))
	{
		message("rumor",HIM"【江湖传奇】"+ HIY"据说嫦娥仙子的护身仙器"+ this_object()->query("name")+HIY"被"+ dest->query("name")+"("+dest->query("id")+")拿到手了！\n"NOR,users());
		dest->set_temp("god_weapon",this_object()->query("id"));
	}
	return 1;
}
