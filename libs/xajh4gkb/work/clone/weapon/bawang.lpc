//霸王枪--名器
#include <weapon.h>
#include <ansi.h>
inherit SPEAR;

void create()
{
	set_name(HIG"霸王"+HIC"枪"NOR, ({ "bawang qiang","bawang","spear" }));
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("weapon_prop/karma", 10);
		set("weapon_prop/constitution", 10);
		set("weapon_prop/strength", 10);
		set("weapon_prop/spear", 30);
		set("weapon_prop/dodge", 5);	
		set("unit", "杆");
		set("icon", "10039");
		set("long", "这是一根白缨长钢枪，长可丈二，枪头隐隐透出寒光。\n");
		set("value", 1500000);
		set("rigidity",100);
		set("material", "steel");
		set("wield_msg", "$N掣出一杆根$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n反别身后。\n");
	}
  	init_spear(500,1);
	setup();
}
int query_autoload() { return 1; }		
