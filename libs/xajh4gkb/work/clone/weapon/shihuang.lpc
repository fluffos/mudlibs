//弑皇-神兵
#include <weapon.h>
#include <ansi.h>
inherit SPEAR;

void create() {
  set_name(HIR "弑皇" NOR, ({ "shihuang spear", "shihuang", "spear" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("weapon_prop/intelligence", 10);
    set("weapon_prop/strength", 40);
    set("weapon_prop/constitution", 30);
    set("weapon_prop/dodge", 20);
    set("weapon_prop/force", 30);
    set("weapon_prop/spear", 50);
    set("weapon_prop/parry", 20);
    set("no_get", "怀璧其罪，这种宝物不是你的就不要去捡。\n");
    set("no_give", "至宝，自己用都还来不及，如何能送人。\n");
    set("no_put", "神器光芒四射，会刺破一切。\n");
    set("no_drop", "这种上古神器得到了就是你的机缘，如何能轻易丢弃呢。\n");
    set("unit", "把");
    set("value", 100000);
    set("icon", "10019");
    set("material", "iron");
    set("long", HIY "炎黄之战，杀怨之气俱归此兵。黄帝得胜，以此兵祭祀天地，誓曰：若治下三界失靖、四海不宁，则天下之人皆可持此兵取吾之首级！\n" NOR);
    set("wield_msg", HIC "我最怜君中宵舞，道“男儿到死心如铁”。看试手，补天裂。\n" NOR);
    set("unwield_msg", HIC "少年侠气，交结五都雄。肝胆洞，毛发耸。立谈中。死生同。一诺千金重。不请长缨，系取天骄种，枪啸西风。\n" NOR);
  }

  init_spear(1100, 1);
  setup();
}

int query_autoload() { return 1; }
mixed hit_ob(object me, object victim, int damage_bonus) {
  int damage1, damage2;
  if (damage_bonus < 100 || this_object()->query("weapon_prop/damage") < 100) return 0;
  damage1 = damage_bonus + this_object()->query("weapon_prop/damage") * 5;
  damage2 = damage_bonus / 2 + this_object()->query("weapon_prop/damage") * 2;
  if (random(5) == 1) {
    damage1 += random(damage1);
    damage2 += random(damage2);
    victim->receive_damage("qi", damage1, me);
    victim->receive_wound("qi", damage2, me);
    message_vision(
      "醒掌天下权，醉卧美人膝，五千年风华烟雨，是非成败转头空！\n" NOR,
      me,
      victim,
      damage1,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
int move(mixed dest) {
  if (!userp(dest)) return ::move(dest);
  if (::move(dest) == 0) return 0;
  if (dest->query_temp("god_weapon") != this_object()->query("id")) {
    message(
      "rumor",
      HIM "【江湖传奇】" + HIY "据说炎帝的神兵" + this_object()->query("name") + HIY "被" + dest->query("name") + "(" + dest->query("id") + ")拿到手了！\n" NOR,
      users()
    );
    dest->set_temp("god_weapon", this_object()->query("id"));
  }
  return 1;
}
