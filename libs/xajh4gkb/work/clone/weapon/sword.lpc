//精铁剑--普通
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
	set_name("精铁剑", ({ "jingtie jian", "sword", "jian" }));
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄普通的精铁打造的长剑，一般的剑客都配带此剑。\n");
		set("value", 20000);
		set("material", "steel");
		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
	}
	init_sword(150,2);
	setup();
}
