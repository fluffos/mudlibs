//刑天舞干戚-神兵
#include <weapon.h>
#include <ansi.h>
inherit STAFF;

void create()
{
	set_name(HIY"刑天"HIM"舞"HIR"干戚"NOR, ({ "xingtian wu ganqi", "ganqi","xingtian","staff" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("weapon_prop/dodge", 20);
		set("weapon_prop/strength", 50);
		set("weapon_prop/constitution", 50);
		set("weapon_prop/karma", 30);
		set("weapon_prop/force", 30);
		set("weapon_prop/staff", 50);
		set("weapon_prop/parry", 20);
		set("no_get","怀璧其罪，这种宝物不是你的就不要去捡。\n");
		set("no_give","至宝，自己用都还来不及，如何能送人。\n");
		set("no_put","神器光芒四射，会刺破一切。\n");
		set("no_drop","这种上古神器得到了就是你的机缘，如何能轻易丢弃呢。\n");	
		set("unit", "根");
		set("value", 100000);
		set("icon", "10019");
		set("material", "iron");
		set("long", HIY"刑天与帝争神，身首异处，碧血零落，干缺戚残；后人冶于一炉乃得神兵。\n"NOR);
		set("wield_msg", HIC"刑天舞干戚，猛志固常在。长戚舞处，风云雷动，碧波流转，巨盾透体而出，其鸣呜咽，如英雄泣。\n"NOR);
		set("unwield_msg",HIC"同物既无虑，化去不复悔。徒设在昔心，良辰讵可待。\n"NOR);
	}

	init_staff(1000,1);
	setup();
}

int query_autoload() { return 1; }
mixed hit_ob(object me, object victim, int damage_bonus)
{
	int damage1,damage2;
	if( damage_bonus < 100 || this_object()->query("weapon_prop/damage")<100) return 0;
	damage1 = damage_bonus+this_object()->query("weapon_prop/damage")*5;
	damage2 = damage_bonus*5+this_object()->query("weapon_prop/damage")*50;
	if( random(5)==1 ) 
	{
		damage1 += random(damage1);
		damage2 += random(damage2);
		victim->receive_damage("jing",damage1,me);
		victim->add("jingli",-damage2);
		message_vision("$N以乳为目，以脐为口，操干戚以舞，刑天舞干戚，猛志固常在。\n" NOR, me, victim,damage1,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
}
int move(mixed dest)
{
	if(! userp(dest)) return ::move(dest);
	if( ::move(dest)==0) return 0;
	if (dest->query_temp("god_weapon")!=this_object()->query("id"))
	{
		message("rumor",HIM"【江湖传奇】"+ HIY"据说刑天所化的神器"+ this_object()->query("name")+HIY"被"+ dest->query("name")+"("+dest->query("id")+")拿到手了！\n"NOR,users());
		dest->set_temp("god_weapon",this_object()->query("id"));
	}
	return 1;
}
