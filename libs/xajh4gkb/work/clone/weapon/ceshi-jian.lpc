// longsword.c 长剑

#include <weapon.h>
inherit SWORD;

void create()
{
	set_name("测试专用剑", ({ "ceshi jian" }));
	set_weight(1000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄普通的玄铁剑，一般的剑客都配带此剑。\n");
		set("value", 0);
		set("material", "steel");
		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
		set("weapon_prop/strength", 1000); 
		set("weapon_prop/dexerity", 1000);
		set("weapon_prop/constitution", 1000);
		set("weapon_prop/intelligence", 1000);	
	}
	init_sword(1000,2);
	setup();
}

int wield()
{
	if (!wizardp(this_player()))
		return notify_fail("这是巫师测试专用剑，你无法佩戴。\n");
    if (::wield())
	{
		this_player()->add_temp("fight_exp_add", 10);	//穿上后附加战斗经验提升效果
		this_player()->add_temp("renwu_exp_add", 10);	//穿上后附加战斗经验提升效果
		this_player()->add_temp("jineng_exp_add", 10);	//穿上后附加战斗经验提升效果
		return 1;
    } else
		return 0;
}
int unequip()
{
    if (::unequip())
	{  	
		this_player()->add_temp("fight_exp_add", -10);
		this_player()->add_temp("renwu_exp_add", -10);
		this_player()->add_temp("jineng_exp_add", -10);
		return 1;
    } else
		return 0;
}
