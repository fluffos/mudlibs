//醍醐灌顶-神兵
#include <weapon.h>
#include <ansi.h>
inherit CLUB;

void create() {
  set_name(HIG "醍醐灌顶" NOR, ({ "tihu guanding", "tihu", "club" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("weapon_prop/unarmed", 20);
    set("weapon_prop/strength", 40);
    set("weapon_prop/intelligence", 30);
    set("weapon_prop/karma", 30);
    set("weapon_prop/force", 30);
    set("weapon_prop/club", 50);
    set("weapon_prop/dodge", 20);
    set("no_get", "怀璧其罪，这种宝物不是你的就不要去捡。\n");
    set("no_give", "至宝，自己用都还来不及，如何能送人。\n");
    set("no_put", "神器光芒四射，会刺破一切。\n");
    set("no_drop", "这种上古神器得到了就是你的机缘，如何能轻易丢弃呢。\n");
    set("unit", "根");
    set("value", 100000);
    set("icon", "10019");
    set("material", "iron");
    set("long", HIY "天地未分时，混沌有异树，亿万年长成，亿万年花开，亿万年结果，果落化为醍醐。\n" NOR);
    set("wield_msg", HIC "醉向醍醐惊自醒，与君清耳听松湍。持此棍者洞悉天地，与万物同息。\n" NOR);
    set("unwield_msg", HIC "菩提本无树，明镜亦非台。本来无一物，何处惹尘埃！\n" NOR);
  }

  init_club(1000, 1);
  setup();
}

int query_autoload() { return 1; }
mixed hit_ob(object me, object victim, int damage_bonus) {
  int damage1, damage2;
  if (damage_bonus < 100 || this_object()->query("weapon_prop/damage") < 100) return 0;
  damage1 = damage_bonus + this_object()->query("weapon_prop/damage") * 5;
  damage2 = damage_bonus / 2 + this_object()->query("weapon_prop/damage") * 2;
  if (random(5) == 1) {
    damage1 += random(damage1);
    damage2 += random(damage2);
    victim->receive_damage("qi", damage1, me);
    victim->receive_wound("qi", damage2, me);
    message_vision(
      "花开一生笑颜多，生来一株愁为何。当繁华落尽，梦入禅声。\n" NOR,
      me,
      victim,
      damage1,
      HBWHT + HIR "特效伤气" NOR
    );
    return;
  }
}
int move(mixed dest) {
  if (!userp(dest)) return ::move(dest);
  if (::move(dest) == 0) return 0;
  if (dest->query_temp("god_weapon") != this_object()->query("id")) {
    message(
      "rumor",
      HIM "【江湖传奇】" + HIY "据说菩提树所化的神兵" + this_object()->query("name") + HIY "被" + dest->query("name") + "(" + dest->query("id") + ")拿到手了！\n" NOR,
      users()
    );
    dest->set_temp("god_weapon", this_object()->query("id"));
  }
  return 1;
}
