//离别钩--名器
#include <weapon.h>
#include <ansi.h>
inherit THROWING;

void create() {
  set_name(HIC "离别钩" NOR, ({ "libie gou", "throwing" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("weapon_prop/strength", 15);
    set("weapon_prop/throwing", 30);
    set("weapon_prop/dexerity", 10);
    set("weapon_prop/dodge", 10);
    set("weapon_prop/parry", 10);
    set("no_get", "怀璧其罪，这种宝物不是你的就不要去捡。\n");
    set("no_give", "至宝，自己用都还来不及，如何能送人。\n");
    set("no_put", "名器锋芒外漏，会刺破一切。\n");
    set("no_drop", "这种名震天下的武器得到了就是你的机缘，如何能轻易丢弃呢。\n");
    set("unit", "把");
    set("value", 100);
    set("base_unit", "柄");
    set("base_weight", 20);
    set("base_value", 10);
    set("material", "iron");
    set("throwing_num_max", 1);  //2018.10.8阿飞改，暗器中的名器与神器设置为无限数量
    set("long", HIW "你用离别钩，只不过为了要相聚。\n" NOR);
    set("wield_msg", HIC "没有人知道它从何处而来，见过它的人都已经和这个世界离别了！\n" NOR);
    set("unwield_msg", HIC "这柄钩，无论钩住什么都会造成离别。\n" NOR);
  }
  set_amount(1);
  init_throwing(550, 2);
  setup();
}

int query_autoload() { return 1; }
