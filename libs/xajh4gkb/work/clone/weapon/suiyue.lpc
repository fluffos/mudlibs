//碎岳-神兵
#include <weapon.h>
#include <ansi.h>
inherit HAMMER;

void create()
{
	set_name(HIM"碎岳"NOR, ({ "suiyue chui", "suiyue","hammer" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("weapon_prop/dodge", 20);
		set("weapon_prop/strength", 50);
		set("weapon_prop/constitution", 30);
		set("weapon_prop/unarmed", 30);
		set("weapon_prop/force", 30);
		set("weapon_prop/hammer", 50);
		set("weapon_prop/parry", 20);
		set("no_get","怀璧其罪，这种宝物不是你的就不要去捡。\n");
		set("no_give","至宝，自己用都还来不及，如何能送人。\n");
		set("no_put","神器光芒四射，会刺破一切。\n");
		set("no_drop","这种上古神器得到了就是你的机缘，如何能轻易丢弃呢。\n");	
		set("unit", "把");
		set("value", 100000);
		set("icon", "10019");
		set("material", "iron");
		set("long", HIY"水神共工至宝，内收九曲黄河，出则天地齐喑，奔涛如雷。共工怒触不周山，后为黄帝所得。\n"NOR);
		set("wield_msg", HIC"嘘为风雨，吹为雷电，舞之铿锵如鸣金铁，邪魔宵小望之丧魂。\n"NOR);
		set("unwield_msg",HIC"共工怒触不周山，天柱折地维绝，水潦尘埃俱归东南。\n"NOR);
	}

	init_hammer(1100,1);
	setup();
}

int query_autoload() { return 1; }
mixed hit_ob(object me, object victim, int damage_bonus)
{
	int damage1,damage2;
	if( damage_bonus < 100 || this_object()->query("weapon_prop/damage")<100) return 0;
	damage1 = damage_bonus+this_object()->query("weapon_prop/damage")*5;
	damage2 = damage_bonus/2+this_object()->query("weapon_prop/damage")*2;
	if( random(5)==1 ) 
	{
		damage1 += random(damage1);
		damage2 += random(damage2);
		victim->receive_damage("jing",damage1,me);
		victim->receive_wound("jing",damage2,me);
		message_vision("共工氏与颛顼争为帝，怒而触不周之山，折天柱，绝地维，故天倾西北，日月星辰就焉；地不满东南，故百川水潦归焉。\n" NOR, me, victim,damage1,HBWHT+HIR"特效伤精"NOR);
		return ;
	}
}
int move(mixed dest)
{
	if(! userp(dest)) return ::move(dest);
	if( ::move(dest)==0) return 0;
	if (dest->query_temp("god_weapon")!=this_object()->query("id"))
	{
		message("rumor",HIM"【江湖传奇】"+ HIY"据说水神共工的神兵"+ this_object()->query("name")+HIY"被"+ dest->query("name")+"("+dest->query("id")+")拿到手了！\n"NOR,users());
		dest->set_temp("god_weapon",this_object()->query("id"));
	}
	return 1;
}
