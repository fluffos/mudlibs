//女娲石-神兵
#include <weapon.h>
#include <ansi.h>
inherit THROWING;

void create()
{
	set_name(HIM"女娲石"NOR, ({ "nvwa shi", "shi", "throwing" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("weapon_prop/dexerity", 30);
		set("weapon_prop/intelligence", 30);
		set("weapon_prop/constitution", 30);
		set("weapon_prop/karma", 50);
		set("weapon_prop/force", 50);
		set("weapon_prop/personality", 10);
		set("weapon_prop/throwing", 50);
		set("no_get","怀璧其罪，这种宝物不是你的就不要去捡。\n");
		set("no_give","至宝，自己用都还来不及，如何能送人。\n");
		set("no_put","神器光芒四射，会刺破一切。\n");
		set("no_drop","这种上古神器得到了就是你的机缘，如何能轻易丢弃呢。\n");	
		set("unit", "颗");
		set("value", 10000);
		set("base_unit", "颗");
		set("base_weight", 20);
		set("base_value", 10);
		set("material", "iron");
		set("throwing_num_max",1);	//2018.10.8阿飞改，暗器中的名器与神器设置为无限数量
		set("long", HIW"人类之母女娲，捏土造人、炼石补天，并帮人族收伏许多妖魔，自古为神州人民景仰。\n相传女娲曾为了救自己病故之爱女，将自己万年修为贯注于一颗昔日补天所余的五彩玉石上，\n自此该灵石就具有特别之力。\n"NOR);
		set("wield_msg", HIC"一阵五色光芒闪耀，$N手里凝聚了一颗五色石。\n"NOR);
		set("unwield_msg",HIC"$N低叹一声，五色光芒散入地下。\n"NOR);
	}
	set_amount(1);
	init_throwing(800,1);
	setup();
}

int query_autoload() { return 1; }
mixed hit_ob(object me, object victim, int damage_bonus)
{
	int add_qi,add_jing;
	if( damage_bonus < 100 || this_object()->query("weapon_prop/damage")<100) return 0;
	if( random(5)==1 ) 
	{
		if(me->query("eff_qi")<me->query("max_qi"))
		{
			add_qi = (me->query("max_qi")-me->query("eff_qi"))/5+this_object()->query("weapon_prop/damage")*me->query("con",1);
			if (add_qi > me->query("max_qi")-me->query("eff_qi")) add_qi = me->query("max_qi")-me->query("eff_qi");
			me->add("eff_qi",add_qi);
		}
		if(me->query("eff_jing")<me->query("max_jing"))
		{
			add_jing = (me->query("max_jing")-me->query("eff_jing"))/5+this_object()->query("weapon_prop/damage")*me->query("con",1);
			if (add_jing > me->query("max_jing")-me->query("eff_jing")) add_jing = me->query("max_jing")-me->query("eff_jing");
			me->add("eff_jing",add_jing);
		}		
		return HIC"女娲石发出微弱的五色光芒，光芒柔和的笼罩在$N身上，$N感觉到浑身暖洋洋，精神大振！\n" NOR;
	}
}
int move(mixed dest)
{
	if(! userp(dest)) return ::move(dest);
	if( ::move(dest)==0) return 0;
	if (dest->query_temp("god_weapon")!=this_object()->query("id"))
	{
		message("rumor",HIM"【江湖传奇】"+ HIY"据说上古神器之"+ this_object()->query("name")+HIY"被"+ dest->query("name")+"("+dest->query("id")+")拿到手了！\n"NOR,users());
		dest->set_temp("god_weapon",this_object()->query("id"));
	}
	return 1;
}
