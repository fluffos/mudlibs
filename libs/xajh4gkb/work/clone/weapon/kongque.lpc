//孔雀翎--名器
#include <weapon.h>
#include <ansi.h>
inherit THROWING;
 
void create()
{
	set_name(HIG"孔雀翎"NOR, ({ "kongque ling","kongque" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是个由纯金铸成、闪闪发光的圆筒。\n");
		set("wield_msg", HIC"据说孔雀翎发出来时，美丽得就像孔雀开屏一样，辉煌灿烂，然而，就在你被这种惊人的生灵感动得目瞪神迷时，它已经要了你的性命。！\n"NOR);
		set("unwield_msg",HIC"孔雀翎象征的是自信，唯有相信自己，方能战胜一切。\n"NOR);	
//		set("unequip_msg",HIC"孔雀翎象征的是自信，唯有相信自己，方能战胜一切。\n"NOR);	//这种写法不知道行不行
		set("unit", "扎");
		set("base_unit", "把");
		set("base_weight", 5);
		set("base_value", 10);
		set("material", "iron");
		set("weapon_prop/dexerity", 10);
		set("weapon_prop/throwing", 20);
		set("weapon_prop/dodge", 10);
		set("weapon_prop/intelligence", 10);
		set("weapon_prop/parry", 10);
		set("throwing_num_max",1);	//2018.10.8阿飞改，暗器中的名器与神器设置为无限数量
		set("no_get","怀璧其罪，这种宝物不是你的就不要去捡。\n");
		set("no_give","至宝，自己用都还来不及，如何能送人。\n");
		set("no_put","名器锋芒外漏，会刺破一切。\n");
		set("no_drop","这种名震天下的武器得到了就是你的机缘，如何能轻易丢弃呢。\n");		
		set("value",100);
//		set("damage", 10);		//没必要在这里定义攻击力了
	}
	set_amount(1);
	init_throwing(450,2);
	setup();
}

int query_autoload() { return 1; }
