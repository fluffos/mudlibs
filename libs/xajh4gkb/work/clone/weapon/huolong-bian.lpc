//火龙鞭--神兵
#include <weapon.h>
#include <ansi.h>
inherit WHIP;

void create() {
  set_name(HIR "火" + HIY "龙" + HIB "鞭" NOR, ({ "huolong bian", "bian" }));
  set_weight(6000);
  //	set("flag",2);	//2018.10.7阿飞改，这个是设置武器为单手，2为单手，1为双手，其实在下面设置就可以了
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("weapon_prop/karma", 20);
    set("weapon_prop/intelligence", 15);
    set("weapon_prop/strength", 15);
    set("weapon_prop/whip", 50);
    set("weapon_prop/constitution", 20);
    set("weapon_prop/dexerity", 35);
    set("weapon_prop/dodge", 10);
    set("rigidity", 1000);
    set("value", 20000000);
    set("no_give", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_sell", 1);
    set("unit", "条");
    set("long", "这是一条由火龙筋和雪蚕丝绞成的长鞭，把柄为千年寒玉雕镌而成。\n");
    set("material", "leather");
    set("wield_msg", HIY "半空中忽然传来阵阵清越的龙吟和尖锐的鬼啸之声............\n"
      HIC "一" HIR "红" HIC "一" HIW "白" HIC "两条巨龙相互绞扭，忽兀落在$N的手中,一声霹雳，巨龙化作一条长鞭。\n" NOR);
    set("unwield_msg", HIC "一阵霹雳之声过后，$N手中的$n" HIC "忽然不见了。\n" NOR);
  }
  init_whip(800, 1);
  setup();
}
//void owner_is_killed() { destruct(this_object()); }
int query_autoload() { return 1; }
