//xuanjing.c
inherit ITEM;
void create()
{
        set_name(HIY "醉月玄晶"NOR, ({"zuiyue xuanjing"}));
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long","这是一块非常罕见的材料，蕴含着超凡的力量。熔炼(ronglian)到装备里，具有神奇的效果。\n");
                set("value", 10000);
                set("material", "bamboo");
              }
}
int query_autoload() { return 1; }

void init()
{
    if ( environment() == this_player() )
		add_action("do_ronglian", "ronglian");
}

int do_ronglian(string arg)
{
	object me, ob, obj;
	string str, item;

	me = this_player();
	ob = this_object();	
	
	if ( environment(ob) != me )
		return 0;	
	if ( !arg )
		return notify_fail("你要将醉月玄晶熔炼到什么？\n");	
	if ( sscanf(arg, "%s to %s", str, item) != 2 )
		return notify_fail("指令格式：ronglian 醉月玄晶英文名 to 装备英文名\n");	
	if ( !objectp(ob = present(str, me)) || !function_exists("do_ronglian", ob) )
		return notify_fail("指令格式：ronglian 醉月玄晶英文名 to 装备英文名\n");	
	if ( !objectp(obj = present(item, me)) && !objectp(ob = present(arg, me)))
		return notify_fail("你身上没有这样东西。\n");	
	if ( !obj->query("armor_prop/armor") && !obj->query("weapon_prop/damage") )
		return notify_fail("你只能将醉月玄晶熔炼到武器或防具。\n");		
    if ( obj->query("equipped") )
		return notify_fail("你必须解除对这件物品的装备才能熔炼醉月玄晶。\n");
    if ( obj->query("xyzx_sys/bind_type") ==1 )
		return notify_fail("这件装备已经被绑定了，还绑定什么。\n");
    if ( obj->query("bianren") )
		return notify_fail("这是用珍稀材料锻造的装备，不需要熔炼醉月玄晶了。\n");
//	if ( obj->query("no_tie") || obj->query("no_zm"))                                      
//		return notify_fail("这种装备不能熔炼。\n");  
	if ( obj->is_character() )
		return notify_fail("你要将醉月玄晶熔炼到什么？？\n");
	
	if ( obj->query("armor_prop/armor") || obj->query("weapon_prop/damage") && !obj->query("xyzx_sys/bind_type",1) && !obj->query("xyzx_sys/bind_type",2))
	{
		message_vision(HIM"$N将醉月玄晶熔炼到" + obj->query("name") + HIM"上，" + obj->query("name") + HIM"被绑定了。\n"NOR, me);	
		obj->set("owner_id", 1);
		obj->set("xyzx_sys/bind_type", 1);
		obj->set("xyzx_save_item", 1);
		destruct(ob);
		return 1; 
	}	
}	 