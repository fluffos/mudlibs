// chuji_box.c
inherit ITEM;
#include <ansi.h>
void create() {
  set_name(HIB "大隐宝箱" NOR, ({ "dybox" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是系统奖励的" + this_object()->query("name") + ",使用(open dybox)打开看看!\n");
    set("unit", "个");
    set("value", 1000000);
  }
}
void init() {
  if (environment() == this_player())
    add_action("do_open", "open dybox", 1);
}
//打开宝箱的函数
int do_open() {
  int i;
  object ob;
  string *box = ({
    "/clone/suit/zhenying/zhongli3/dayin-armor", "/clone/suit/zhenying/zhongli3/dayin-boots", "/clone/suit/zhenying/zhongli3/dayin-cloth", "/clone/suit/zhenying/zhongli3/dayin-hands", "/clone/suit/zhenying/zhongli3/dayin-head", "/clone/suit/zhenying/zhongli3/dayin-neck", "/clone/suit/zhenying/zhongli3/dayin-pants", "/clone/suit/zhenying/zhongli3/dayin-ring", "/clone/suit/zhenying/zhongli3/dayin-shield", "/clone/suit/zhenying/zhongli3/dayin-surcoat", "/clone/suit/zhenying/zhongli3/dayin-waist", "/clone/suit/zhenying/zhongli3/dayin-wrists", "/clone/suit/zhenying/zhongli3/dayin-briefs", "/clone/suit/zhenying/zhongli3/dayin-brassiere",
  });

  object me = this_player();
  if (me->is_busy()) {
    write("你上一个动作未完成！\n");
    return 1;
  }
  if (me->is_fighting()) {
    write("战斗中开宝箱？挨宰呀？\n");
    return 1;
  }
  message_vision(HIG "$N轻轻打开了[" + this_object()->query("name") + "]的盖子,宝箱华为一阵金色光华！\n" NOR, me);
  i = random((int)sizeof(box));
  ob = new(box[i]);
  tell_object(me, "" HIY "**************************************************************\n");
  tell_object(
    me,
    "" HIR "<恭喜>: " NOR " 你从[" + this_object()->query("name") + "]中得到了...一" + ob->query("unit") + HIY + "<< " + ob->query("name") + HIY + " >>" + NOR + "\n"
  );
  tell_object(me, "" HIY "**************************************************************\n");
  ob->move(me);
  destruct(this_object());
  return 1;
}
int query_autoload() {
  return 1;
}
