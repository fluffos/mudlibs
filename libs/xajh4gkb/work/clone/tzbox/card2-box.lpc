// chuji_box.c
inherit ITEM;
#include <ansi.h>
void create()
{
        set_name(GRN"精英令牌宝箱"NOR,({"jylpbox"}));
        set_weight(500);
        
        if( clonep() )
                set_default_object(__FILE__);
        else
       {
            set("long",
                "这是系统奖励的"+this_object()->query("name")+",使用(open jylpbox)打开看看!\n");
        set("unit","个");
        set("value", 1000000);
            
        }
}
void init()
{
    if (environment()==this_player())
    add_action("do_open","open jylpbox",1);
}
//打开宝箱的函数
int do_open()
{
   int i;
   object ob; 
   string *box=
({
"/clone/suit/menpai/card2/menpai1","/clone/suit/menpai/card2/menpai2","/clone/suit/menpai/card2/menpai3","/clone/suit/menpai/card2/menpai4","/clone/suit/menpai/card2/menpai5","/clone/suit/menpai/card2/menpai6","/clone/suit/menpai/card2/menpai7","/clone/suit/menpai/card2/menpai8","/clone/suit/menpai/card2/menpai9","/clone/suit/menpai/card2/menpai10","/clone/suit/menpai/card2/menpai11","/clone/suit/menpai/card2/menpai12","/clone/suit/menpai/card2/menpai13","/clone/suit/menpai/card2/menpai14","/clone/suit/menpai/card2/menpai15","/clone/suit/menpai/card2/menpai16","/clone/suit/menpai/card2/menpai17","/clone/suit/menpai/card2/menpai18","/clone/suit/menpai/card2/menpai19","/clone/suit/menpai/card2/menpai20","/clone/suit/menpai/card2/menpai21","/clone/suit/menpai/card2/menpai22","/clone/suit/menpai/card2/menpai23","/clone/suit/menpai/card2/menpai24","/clone/suit/menpai/card2/menpai25","/clone/suit/menpai/card2/menpai26","/clone/suit/menpai/card2/menpai27","/clone/suit/menpai/card2/menpai28","/clone/suit/menpai/card2/menpai29","/clone/suit/menpai/card2/menpai30","/clone/suit/menpai/card2/menpai31","/clone/suit/menpai/card2/menpai32","/clone/suit/menpai/card2/menpai33","/clone/suit/menpai/card2/menpai34","/clone/suit/menpai/card2/menpai35","/clone/suit/menpai/card2/menpai36","/clone/suit/menpai/card2/menpai37","/clone/suit/menpai/card2/menpai38","/clone/suit/menpai/card2/menpai39","/clone/suit/menpai/card2/menpai40","/clone/suit/menpai/card2/menpai41","/clone/suit/menpai/card2/menpai42","/clone/suit/menpai/card2/menpai43","/clone/suit/menpai/card2/menpai44","/clone/suit/menpai/card2/menpai45",
});
  
    object me = this_player();
        if (me->is_busy())
              { write("你上一个动作未完成！\n"); return 1;}
        if( me->is_fighting() )
              { write("战斗中开宝箱？挨宰呀？\n"); return 1;}
       
    message_vision(HIG"$N轻轻打开了["+this_object()->query("name")+"]的盖子,宝箱华为一阵金色光华！\n"NOR,me);
    i=random((int)sizeof(box));
    ob = new(box[i]);
	tell_object(me,""HIY"**************************************************************\n");
	tell_object(me,""HIR"<恭喜>: "NOR" 你从["+this_object()->query("name")+"]中得到了...一"+ob->query("unit")+HIY+"<< "+ob->query("name")+HIY+" >>"+NOR+"\n");
	tell_object(me,""HIY"**************************************************************\n");
    ob->move(me); 
    destruct(this_object());
	return 1;
}
int query_autoload()
{
	return 1;
}