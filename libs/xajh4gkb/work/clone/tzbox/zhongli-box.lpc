// chuji_box.c
inherit ITEM;
#include <ansi.h>
void create() {
  set_name(HIY "无极宝箱" NOR, ({ "wjbox" }));
  set_weight(500);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "这是系统奖励的" + this_object()->query("name") + ",使用(open wjbox)打开看看!\n");
    set("unit", "个");
    set("value", 1000000);

  }
}
void init() {
  if (environment() == this_player())
    add_action("do_open", "open wjbox", 1);
}
//打开宝箱的函数
int do_open() {
  int i, pinji;
  object ob;
  string *box = ({
    "/clone/suit/zhenying/zhongli/wuji-armor", "/clone/suit/zhenying/zhongli/wuji-boots", "/clone/suit/zhenying/zhongli/wuji-cloth", "/clone/suit/zhenying/zhongli/wuji-hands", "/clone/suit/zhenying/zhongli/wuji-head", "/clone/suit/zhenying/zhongli/wuji-neck",
    "/clone/suit/zhenying/zhongli/wuji-pants", "/clone/suit/zhenying/zhongli/wuji-ring", "/clone/suit/zhenying/zhongli/wuji-shield", "/clone/suit/zhenying/zhongli/wuji-surcoat", "/clone/suit/zhenying/zhongli/wuji-waist", "/clone/suit/zhenying/zhongli/wuji-wrists",
    "/clone/suit/zhenying/zhongli/wuji-briefs", "/clone/suit/zhenying/zhongli/wuji-brassiere",
  });

  object me = this_player();
  if (me->is_busy()) {
    write("你上一个动作未完成！\n"); return 1;
  }
  if (me->is_fighting()) {
    write("战斗中开宝箱？挨宰呀？\n"); return 1;
  }

  message_vision(HIG "$N轻轻打开了[" + this_object()->query("name") + "]的盖子,宝箱华为一阵金色光华！\n" NOR, me);
  i = random((int)sizeof(box));

  ob = new(box[i]);
  pinji = (int)this_object()->query("xyzx_item/pinji");
  if (pinji == 1) {
    ob->set("xyzx_item/pinji", 1);
    ob->set("name", HIC "☆" NOR + ob->name(1));
  } else if (pinji == 2) {
    ob->set("xyzx_item/pinji", 2);
    ob->set("name", HIG "☆☆" NOR + ob->name(1));
  } else if (pinji == 3) {
    ob->set("xyzx_item/pinji", 3);
    ob->set("name", HIB "☆☆☆" NOR + ob->name(1));
  } else if (pinji == 4) {
    ob->set("xyzx_item/pinji", 4);
    ob->set("name", HIM "★" NOR + ob->name(1));
  } else if (pinji == 5) {
    ob->set("xyzx_item/pinji", 5);
    ob->set("name", HIR "★★" NOR + ob->name(1));
  } else if (pinji == 6) {
    ob->set("xyzx_item/pinji", 6);
    ob->set("name", HIY "★★★" NOR + ob->name(1));
  } else {
    ob->set("xyzx_item/pinji", 0);
  }
  ob->set("suit_eff/dexerity", 100 + 50 * pinji);
  ob->set("suit_eff/intelligence", 100 + 50 * pinji);
  ob->set("suit_eff/constitution", 100 + 50 * pinji);
  ob->set("suit_eff/strength", 100 + 50 * pinji);
  ob->set("suit_eff/karma", 100 + 50 * pinji);
  ob->set("suit_eff/personality", 100 + 50 * pinji);
  ob->set("suit_eff/armor", 1000 + 100 * pinji);
  tell_object(me, "" HIY "**************************************************************\n");
  tell_object(
    me,
    "" HIR "<恭喜>: " NOR " 你从[" + this_object()->query("name") + "]中得到了...一" + ob->query("unit") + HIY + "<< " + ob->query("name") + HIY + " >>" + NOR + "\n"
  );
  tell_object(me, "" HIY "**************************************************************\n");
  ob->move(me);
  destruct(this_object());
  return 1;
}
int query_autoload() {
  return 1;
}
