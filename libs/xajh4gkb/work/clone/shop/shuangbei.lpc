inherit ITEM;


void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIM"双倍丹"NOR, ({"shuangbei dan", "dan"}));
		set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "这是一颗黑呼呼的药丸，可以大幅度提高你的江湖效率。\n");
				set("value", 0);
				set("jianghu_money", 50);
				set("no_sell",1);
//				set("no_drop",1);
				set("unit", "颗");
        }
		setup();
}
int do_eat(string arg)
{
	string now_time, my_time;
	
	if (!id(arg))
		return notify_fail("你要吃什么药？\n");
//	if(this_player()->query("id")==query("value"))
//		return notify_fail("这棵丹不是你练的,你吃个什么劲。\n");
	now_time = CHINESE_D->chinese_time(11, ctime(time()));
	my_time = this_player()->query("get_exp_time");
	if ( !my_time ) my_time = "";	
 	if ((int)this_player()->query("exp_jiacheng") >= (int)time())
	{
		message_vision("$N眨眨眼。\n", this_player());
		tell_object(this_player(), "你觉得这药没啥味道，还不如花生好吃。\n");
	}
	else
	{
		tell_object(this_player(), HIG "你拿起双倍丹吃了下去，获得了天神的祝福，你在江湖中无论做什么事情都事半功倍。\n" NOR);
		this_player()->set("exp_jiacheng",time()+3600*24);
		this_player()->set("get_exp_time", now_time);
		message("channel:chat", HIM"【镜花水月】：听说"HIW+this_player()->query("name")+HIM"豪情万丈，随手吃下一颗双倍丹，开始了一天的双倍效率。\n"NOR,users() );
		message_vision(HIW"$N吃下一颗双倍丹，一天双倍经验时间开始计时.....！\n"NOR,this_player());
		log_file("cmds/Add_exp", sprintf("%s(%s) 吃下一颗双倍丹，获得一天的双倍时间 on %s\n",this_player()->query("name"),this_player()->query("id"),CHINESE_D->chinese_time(5,ctime(time()))) );
	}		
	destruct(this_object());
	return 1;
}

