inherit ITEM;


void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIW"还魂丹"NOR, ({"huanhun dan", "dan"}));
		set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "这是一颗黑呼呼的药丸，据说可以起死回生。\n");
				set("value", 0);
				set("jianghu_money", 10);
				set("no_sell",1);
//				set("no_drop",1);
				set("unit", "颗");
        }
		setup();
}
