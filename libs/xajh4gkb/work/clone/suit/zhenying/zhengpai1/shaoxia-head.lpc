// 少侠套装：头盔

#include <armor.h>
#include <ansi.h>
inherit HEAD;
inherit F_ITEM_MAKE;
#include <item_gn.h>

void create()
{
	int pj, lvl, armor;
	mapping mp1,mp2;
	mp1 = item_temp[random(sizeof(item_temp))];
	mp2 = apply_temp[random(sizeof(apply_temp))];
	pj = random( (int) sizeof(armor_shuxing) );  //由于动态装备的属性只有7种了所以这里要改	
//	pj = random( (int) (sizeof(armor_shuxing) / get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "MAX_RANDOM_JIE")) );
//	lvl = random(get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "ITEM_CLOTH_MAX_LEVEL"))+1;
	lvl = 1;
	armor = lvl * 100;
	armor = armor + random(armor);
	if ( !armor || armor < 100 ) armor = 1+random(99);
	
	set_name(HIC"少侠头盔"NOR, ({ "shaoxia toukui","toukui", "head" }) );
	set("long", "传说中的少侠套装之一，为正派一星套装。\n");
	set_weight(300 + (random(pj) * 100) + (random(lvl) * 100));
	set("value", 6000000);	
	set("armor_prop/level", lvl);	//初始等级
	get_item_shuxing("armor", pj, lvl, 1);
	set("armor_prop/armor", armor);
	set("unit", "件");	
	set("icon", "10077");	
	set("material", "gem");
	set("owner_id",1);	
//	set("dtzb",1); //添加判定,非副本装备无法强化
	set("xyzx_save_item", 1);	
	set("xyzx_sys/bind_type", 0);		
	set("xyzx_item/pinji", 1);
	set("camp","正派");
	if (random(2)==1) set("item_temp",mp1);
	else set("apply_temp",mp2);
//	set("taozhuang",21);
//	set("max_level", 30);	
 //---------------------------------------------------------------
              //套装参数
    set("suit",HIC"少侠套装"NOR);  //套装名称
    set("suit_lvl", 1);             //套装等级
    set("suit_count",12);           //套装部件数量
              //套装各部件
    set("suit_mod/armor","少侠铠甲");
    set("suit_mod/boots","少侠靴子");
    set("suit_mod/pants","少侠裤子");
    set("suit_mod/hands","少侠护手");
    set("suit_mod/head","少侠头盔");
    set("suit_mod/neck","少侠项链");
    set("suit_mod/cloth","少侠上衣");
    set("suit_mod/ring","少侠戒指");
    set("suit_mod/shield","少侠盾牌");
    set("suit_mod/surcoat","少侠披风");
    set("suit_mod/waist","少侠腰带");
	set("suit_mod/wrists","少侠护腕");
	set("suit_mod/briefs","少侠内裤");
	set("suit_mod/brassiere","少侠胸罩");		
	//套装全部附加天赋效果  
	set("suit_eff/dexerity", 150); 
	set("suit_eff/intelligence", 150);  
	set("suit_eff/constitution", 150);  
	set("suit_eff/strength", 150); 
	set("suit_eff/karma", 150); 	
	set("suit_eff/personality", 150); 
	set("suit_eff/armor", 1200);
    //套装全部附加技能效果     
	set("suit_eff_skill/force", 1000);
 //---------------------------------------------------------------
	setup(1);
}

int wear()
{
	
	if (this_player()->query("camp")!="正派")
		return notify_fail("你不是正派阵营弟子，无法穿戴少侠套装。\n");
    if (::wear())
	{
		if (query("item_temp")) this_player()->add_temp(query("item_temp"), 1);
		if (query("apply_temp")) this_player()->add_temp(query("apply_temp"), 20);
		return 1;
    } else
		return 0;
}
int unequip()
{
    if (::unequip())
	{  	
		if (query("item_temp")) this_player()->add_temp(query("item_temp"), -1);
		if (query("apply_temp")) this_player()->add_temp(query("apply_temp"), -20);
		return 1;
    } else
		return 0;
}
