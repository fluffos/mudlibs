// 玄武套装：项链

#include <armor.h>
#include <ansi.h>
inherit NECK;
inherit F_ITEM_MAKE;
#include <item_gn.h>

void create() {
  int pj, lvl, armor;
  mapping mp1, mp2;
  mp1 = item_temp[random(sizeof(item_temp))];
  mp2 = apply_temp[random(sizeof(apply_temp))];
  pj = random((int)sizeof(armor_shuxing));  //由于动态装备的属性只有7种了所以这里要改	
  //	pj = random( (int) (sizeof(armor_shuxing) / get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "MAX_RANDOM_JIE")) );
  //	lvl = random(get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "ITEM_CLOTH_MAX_LEVEL"))+1;
  lvl = 1;
  armor = lvl * 100;
  armor = armor + random(armor);
  if (!armor || armor < 100) armor = 1 + random(99);

  set_name(HIM "玄武项链" RED " " HIR "七璜珠玉" NOR, ({ "xuanwu xianglian", "xianglian", "neck" }));
  set("long", "以七个天珠以及天丝编制而成的坠子。集天地之灵气，能给予佩戴者吉祥如意。属于传说中的玄武套装。\n");
  set_weight(300 + (random(pj) * 100) + (random(lvl) * 100));
  set("value", 6000000);
  set("armor_prop/level", lvl);  //初始等级
  get_item_shuxing("armor", pj, lvl, 1);
  set("armor_prop/armor", armor);
  set("unit", "件");
  set("icon", "10077");
  set("material", "gem");
  set("owner_id", 1);
  //	set("dtzb",1); //添加判定,非副本装备无法强化
  set("xyzx_save_item", 1);
  set("xyzx_sys/bind_type", 0);
  set("xyzx_item/pinji", 0);
  set("camp", "正派");
  if (random(2) == 1) set("item_temp", mp1);
  else set("apply_temp", mp2);
  //	set("taozhuang",21);
  //	set("max_level", 30);	
  //---------------------------------------------------------------
  //套装参数
  set("suit", HIM "玄武套装" NOR);  //套装名称
  set("suit_lvl", 1);             //套装等级
  set("suit_count", 12);           //套装部件数量
  //套装各部件
  set("suit_mod/armor", "五彩凤翅");
  set("suit_mod/boots", "辟尘分光");
  set("suit_mod/pants", "回风舞雪");
  set("suit_mod/hands", "七彩玲珑");
  set("suit_mod/head", "鸾羽九凤");
  set("suit_mod/neck", "七璜珠玉");
  set("suit_mod/cloth", "飞天羽衣");
  set("suit_mod/ring", "九曜光华");
  set("suit_mod/shield", "凤羽流苏");
  set("suit_mod/surcoat", "碧霞彩云");
  set("suit_mod/waist", "磐龙凤翔");
  set("suit_mod/wrists", "金水菩提");
  set("suit_mod/brassiere", "仙黛尔");
  set("suit_mod/briefs", "混天绫");
  //套装全部附加天赋效果  
  set("suit_eff/dexerity", 100);
  set("suit_eff/intelligence", 100);
  set("suit_eff/constitution", 100);
  set("suit_eff/strength", 100);
  set("suit_eff/karma", 100);
  set("suit_eff/personality", 100);
  set("suit_eff/armor", 1000);
  //套装全部附加技能效果     
  set("suit_eff_skill/force", 1000);
  //	set("suit_eff_skill/huagong-dafa", 1000);
  //	set("suit_eff_skill/beiming-shengong", 1000);
  //	set("suit_eff_skill/xixing-dafa", 1000);

  //---------------------------------------------------------------
  setup(1);
}

int wear() {

  if (this_player()->query("camp") != "正派")
    return notify_fail("你不是正派阵营弟子，无法穿戴玄武套装。\n");
  if (::wear()) {
    if (query("item_temp")) {
      this_player()->add_temp(query("item_temp"), 1);
      //			if (query("item_temp")=="fight_exp_add") tell_object(this_player(),HIG"你对战斗经验的感悟提高了！\n"NOR);
      //			if (query("item_temp")=="renwu_exp_add") tell_object(this_player(),HIG"你对做任务更加顺心了！\n"NOR);
      //			if (query("item_temp")=="jineng_exp_add") tell_object(this_player(),HIG"你对技能练习更加得心应手！\n"NOR);
      //			if (query("item_temp")=="lianzhao_max_add") tell_object(this_player(),HIG"你对连招的运用更加随心所欲！\n"NOR);
      //			if (query("item_temp")=="damage_max_add") tell_object(this_player(),HIG"你对敌方的伤害提高了！\n"NOR);
      //			if (query("item_temp")=="armor_max_add") tell_object(this_player(),HIG"你对防御的领悟更上一层楼！\n"NOR);
      //			if (query("item_temp")=="dam_max_add") tell_object(this_player(),HIG"你对一招一式有独特的理解！\n"NOR);
      //			if (query("item_temp")=="wupin_max_add") tell_object(this_player(),HIG"你时来运转，似乎运气变好了！\n"NOR);
      //			if (query("item_temp")=="jingnei_max_add") tell_object(this_player(),HIG"你对炼精化气、练气还神的修炼有了更深的见解！\n"NOR);
    }
    if (query("apply_temp")) {
      this_player()->add_temp(query("apply_temp"), 20);
      //			if (query("apply_temp")=="apply/attack") tell_object(this_player(),HIG"你的命中提高了！\n"NOR);
      //			if (query("apply_temp")=="apply/damage") tell_object(this_player(),HIG"你的攻击力提高了！\n"NOR);
      //			if (query("apply_temp")=="apply/dodge") tell_object(this_player(),HIG"你的闪避提高了！\n"NOR);
      //			if (query("apply_temp")=="apply/parry") tell_object(this_player(),HIG"你的招架提高了！\n"NOR);
      //			if (query("apply_temp")=="apply/strength") tell_object(this_player(),HIG"你的力量提高了！\n"NOR);
      //			if (query("apply_temp")=="apply/dexerity") tell_object(this_player(),HIG"你的身法提高了！\n"NOR);
      //			if (query("apply_temp")=="apply/constitution") tell_object(this_player(),HIG"你的根骨提高了！\n"NOR);
      //			if (query("apply_temp")=="apply/intelligence") tell_object(this_player(),HIG"你的悟性提高了！\n"NOR);
      //			if (query("apply_temp")=="apply/armor") tell_object(this_player(),HIG"你的防御提高了！\n"NOR);
    }
    return 1;
  } else
    return 0;
}
int unequip() {
  if (::unequip()) {
    if (query("item_temp")) this_player()->add_temp(query("item_temp"), -1);
    if (query("apply_temp")) this_player()->add_temp(query("apply_temp"), -20);
    return 1;
  } else
    return 0;
}
