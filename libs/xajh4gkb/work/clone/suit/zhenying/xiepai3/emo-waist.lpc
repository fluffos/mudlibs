// 恶魔套装：腰带

#include <armor.h>
#include <ansi.h>
inherit WAIST;
inherit F_ITEM_MAKE;
#include <item_gn.h>

void create()
{
	int pj, lvl, armor;
	mapping mp1,mp2;
	mp1 = item_temp[random(sizeof(item_temp))];
	mp2 = apply_temp[random(sizeof(apply_temp))];
	pj = random( (int) sizeof(armor_shuxing) );  //由于动态装备的属性只有7种了所以这里要改	
//	pj = random( (int) (sizeof(armor_shuxing) / get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "MAX_RANDOM_JIE")) );
//	lvl = random(get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "ITEM_CLOTH_MAX_LEVEL"))+1;
	lvl = 1;
	armor = lvl * 100;
	armor = armor + random(armor);
	if ( !armor || armor < 100 ) armor = 1+random(99);
	
	set_name(HIB"恶魔腰带"NOR, ({ "emo yaodai","yaodai", "waist" }) );
	set("long", "传说中的恶魔套装之一，为邪派三星套装。\n");
	set_weight(300 + (random(pj) * 100) + (random(lvl) * 100));
	set("value", 6000000);	
	set("armor_prop/level", lvl);	//初始等级
	get_item_shuxing("armor", pj, lvl, 1);
	set("armor_prop/armor", armor);
	set("unit", "件");	
	set("icon", "10077");	
	set("material", "gem");
	set("owner_id",1);	
//	set("dtzb",1); //添加判定,非副本装备无法强化
	set("xyzx_save_item", 1);	
	set("xyzx_sys/bind_type", 0);		
	set("xyzx_item/pinji", 3);
	set("camp","邪派");
	if (random(2)==1) set("item_temp",mp1);
	else set("apply_temp",mp2);
//	set("taozhuang",21);
//	set("max_level", 30);	
 //---------------------------------------------------------------
              //套装参数
    set("suit",HIB"恶魔套装"NOR);  //套装名称
    set("suit_lvl", 3);             //套装等级
    set("suit_count",12);           //套装部件数量
              //套装各部件
    set("suit_mod/armor","恶魔铠甲");
    set("suit_mod/boots","恶魔靴子");
    set("suit_mod/pants","恶魔裤子");
    set("suit_mod/hands","恶魔护手");
    set("suit_mod/head","恶魔头盔");
    set("suit_mod/neck","恶魔项链");
    set("suit_mod/cloth","恶魔上衣");
    set("suit_mod/ring","恶魔戒指");
    set("suit_mod/shield","恶魔盾牌");
    set("suit_mod/surcoat","恶魔披风");
    set("suit_mod/waist","恶魔腰带");
	set("suit_mod/wrists","恶魔护腕");
	set("suit_mod/briefs","恶魔内裤");
	set("suit_mod/brassiere","恶魔胸罩");		
	//套装全部附加天赋效果  
	set("suit_eff/dexerity", 250);
	set("suit_eff/intelligence", 250);
	set("suit_eff/constitution", 250);
	set("suit_eff/strength", 250);
	set("suit_eff/karma", 250);
	set("suit_eff/personality", 250);
	set("suit_eff/armor", 1600);
    //套装全部附加技能效果   
	set("suit_eff_skill/unarmed", 1000);
 //---------------------------------------------------------------
	setup(1);
}

int wear()
{
	
	if (this_player()->query("camp")!="邪派")
		return notify_fail("你不是邪派阵营弟子，无法穿戴恶魔套装。\n");
    if (::wear())
	{
		if (query("item_temp")) this_player()->add_temp(query("item_temp"), 1);
		if (query("apply_temp")) this_player()->add_temp(query("apply_temp"), 20);
		return 1;
    } else
		return 0;
}
int unequip()
{
    if (::unequip())
	{  	
		if (query("item_temp")) this_player()->add_temp(query("item_temp"), -1);
		if (query("apply_temp")) this_player()->add_temp(query("apply_temp"), -20);
		return 1;
    } else
		return 0;
}
