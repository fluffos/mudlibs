// 邪神套装：盾牌

#include <armor.h>
#include <ansi.h>
inherit SHIELD;
inherit F_ITEM_MAKE;
#include <item_gn.h>

void create() {
  int pj, lvl, armor;
  mapping mp1, mp2;
  mp1 = item_temp[random(sizeof(item_temp))];
  mp2 = apply_temp[random(sizeof(apply_temp))];
  pj = random((int)sizeof(armor_shuxing));  //由于动态装备的属性只有7种了所以这里要改	
  //	pj = random( (int) (sizeof(armor_shuxing) / get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "MAX_RANDOM_JIE")) );
  //	lvl = random(get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "ITEM_CLOTH_MAX_LEVEL"))+1;
  lvl = 1;
  armor = lvl * 100;
  armor = armor + random(armor);
  if (!armor || armor < 100) armor = 1 + random(99);

  set_name(HIR "邪神盾牌" NOR, ({ "xieshen dun", "dun", "shield" }));
  set("long", "传说中的邪神套装之一，为邪派二金套装。\n");
  set_weight(300 + (random(pj) * 100) + (random(lvl) * 100));
  set("value", 6000000);
  set("armor_prop/level", lvl);  //初始等级
  get_item_shuxing("armor", pj, lvl, 1);
  set("armor_prop/armor", armor);
  set("unit", "件");
  set("icon", "10077");
  set("material", "gem");
  set("owner_id", 1);
  //	set("dtzb",1); //添加判定,非副本装备无法强化
  set("xyzx_save_item", 1);
  set("xyzx_sys/bind_type", 0);
  set("xyzx_item/pinji", 5);
  set("camp", "邪派");
  if (random(2) == 1) set("item_temp", mp1);
  else set("apply_temp", mp2);
  //	set("taozhuang",21);
  //	set("max_level", 30);	
  //---------------------------------------------------------------
  //套装参数
  set("suit", HIR "邪神套装" NOR);  //套装名称
  set("suit_lvl", 5);             //套装等级
  set("suit_count", 12);           //套装部件数量
  //套装各部件
  set("suit_mod/armor", "邪神铠甲");
  set("suit_mod/boots", "邪神靴子");
  set("suit_mod/pants", "邪神裤子");
  set("suit_mod/hands", "邪神护手");
  set("suit_mod/head", "邪神头盔");
  set("suit_mod/neck", "邪神项链");
  set("suit_mod/cloth", "邪神上衣");
  set("suit_mod/ring", "邪神戒指");
  set("suit_mod/shield", "邪神盾牌");
  set("suit_mod/surcoat", "邪神披风");
  set("suit_mod/waist", "邪神腰带");
  set("suit_mod/wrists", "邪神护腕");
  set("suit_mod/briefs", "邪神内裤");
  set("suit_mod/brassiere", "邪神胸罩");
  //套装全部附加天赋效果  
  set("suit_eff/dexerity", 350);
  set("suit_eff/intelligence", 350);
  set("suit_eff/constitution", 350);
  set("suit_eff/strength", 350);
  set("suit_eff/karma", 350);
  set("suit_eff/personality", 350);
  set("suit_eff/armor", 2000);
  //套装全部附加技能效果     
  set("suit_eff_skill/unarmed", 1000);
  //---------------------------------------------------------------
  setup(1);
}

int wear() {

  if (this_player()->query("camp") != "邪派")
    return notify_fail("你不是邪派阵营弟子，无法穿戴邪神套装。\n");
  if (::wear()) {
    if (query("item_temp")) this_player()->add_temp(query("item_temp"), 1);
    if (query("apply_temp")) this_player()->add_temp(query("apply_temp"), 20);
    return 1;
  } else
    return 0;
}
int unequip() {
  if (::unequip()) {
    if (query("item_temp")) this_player()->add_temp(query("item_temp"), -1);
    if (query("apply_temp")) this_player()->add_temp(query("apply_temp"), -20);
    return 1;
  } else
    return 0;
}
