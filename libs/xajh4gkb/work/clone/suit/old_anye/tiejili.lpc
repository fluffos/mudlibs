// tielianzi.c
#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create()
{
        set_name(HIW"铁蒺藜"NOR, ({ "tie jili", "throwing" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
				set("xyzx_item/pinji", 1);
				set("owner_id",1);
				set("taozhuang",11);
				set("max_level", 1);
				set("xyzx_save_item", 1);
				set("xyzx_sys/bind_type", 0);		
				set("weapon_prop/strength", 10000);
				set("weapon_prop/intelligence", 10000);	
				set("weapon_prop/constitution", 10000);	
				set("weapon_prop/dexerity", 10000);	
				set("weapon_prop/karma", 10000);
				set("weapon_prop/personality", 10000);	
				set("no_tie",1); //添加判定,暗器不能贴符
                set("unit", "些");
                set("value", 0);
                set("base_unit", "颗");
                set("base_weight", 10);
                set("base_value", 10);
                set("material", "iron");
                set("long", HIW"普通暗器，但是蕴含不可思议之力。\n"NOR);
                set("wield_msg", HIC"$N微微一抖，一些铁蒺藜夹在双指之间，隐忍待发！\n"NOR);
                set("unwield_msg",HIC"$N无声无息，手指间的铁蒺藜笼入袖里。\n"NOR);
        }
        set_amount(10000);
        init_throwing(10000);
        setup();
}
int hit_ob(object me,object victim,int damage_bonus)
{
victim->apply_condition("wuxing_poison", 20);
//if( !victim->is_busy() ) victim->start_busy(1);
return damage_bonus;
}
int query_autoload() { return 1; }