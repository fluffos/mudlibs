// 神之套装：护手

#include <armor.h>
#include <ansi.h>
inherit HANDS;
inherit F_ITEM_MAKE;


void create() {
  int pj, lvl, pj2, lvl2;

  pj = 15;
  lvl = 1;
  pj2 = 5;
  lvl2 = 4;

  set_name(HIR "神之护手" NOR, ({ "shenzhi hushou", "hushou", "hands" }));
  set("long", "盘古开天后，鸿蒙紫气聚集，凝盘古精魄，渡九天神雷之劫而成。属于传说中的神境套装。\n");
  set_weight(500);
  set("value", 10000000);
  set("armor_prop/level", 1);  //初始等级
  //	get_item_shuxing("armor", pj, lvl, 1);
  get_item_gongneng("armor", pj2, lvl2, 1);
  set("armor_prop/armor", 300);
  set("armor_prop/strength", 35);
  set("armor_prop/intelligence", 35);
  set("armor_prop/constitution", 35);
  set("armor_prop/dexerity", 35);
  set("armor_prop/karma", 35);
  set("armor_prop/personality", 35);
  set("armor_prop/unarmed", 35);
  set("armor_prop/force", 35);
  set("armor_prop/dodge", 35);
  set("armor_prop/parry", 35);
  set("unit", "件");
  set("icon", "10077");
  set("material", "gem");
  set("owner_id", 1);
  //	set("dtzb",1); //添加判定,非副本装备无法强化
  set("xyzx_save_item", 1);
  set("xyzx_sys/bind_type", 0);
  set("xyzx_item/pinji", 6);

  set("cognize", HIR "神境" NOR);
  //	set("taozhuang",21);
  //	set("max_level", 30);	
  //---------------------------------------------------------------
  //套装参数
  set("suit", BLK "神之套装" NOR);  //套装名称
  set("suit_lvl", 6);             //套装等级
  set("suit_count", 12);           //套装部件数量
  //套装各部件
  set("suit_mod/armor", "神之铠甲");
  set("suit_mod/boots", "神之战靴");
  set("suit_mod/pants", "神之裤子");
  set("suit_mod/hands", "神之护手");
  set("suit_mod/head", "神之头盔");
  set("suit_mod/neck", "神之项链");
  set("suit_mod/cloth", "神之战衣");
  set("suit_mod/ring", "神之戒指");
  set("suit_mod/shield", "神之盾甲");
  set("suit_mod/surcoat", "神之披风");
  set("suit_mod/waist", "神之腰带");
  set("suit_mod/wrists", "神之护腕");
  set("suit_mod/briefs", "神之内裤");
  set("suit_mod/brassiere", "神之胸罩");
  set("suit_mod/card", "神之令牌");
  //套装全部附加天赋效果  
  set("suit_eff/dexerity", 500);
  set("suit_eff/intelligence", 500);
  set("suit_eff/constitution", 500);
  set("suit_eff/strength", 500);
  set("suit_eff/karma", 500);
  set("suit_eff/personality", 500);
  set("suit_eff/armor", 2000);
  //套装全部附加技能效果     
  set("suit_eff_skill/unarmed", 1000);
  set("suit_eff_skill/force", 1000);
  set("suit_eff_skill/dodge", 1000);
  set("suit_eff_skill/parry", 1000);

  //---------------------------------------------------------------
  setup(1);
}
