// 破碎套装：戒指

#include <armor.h>
#include <ansi.h>
inherit FINGER;
inherit F_ITEM_MAKE;
#include <item_gn.h>

void create() {
  //	int pj, lvl, armor;
  mapping mp1, mp2;
  mp1 = item_temp[random(sizeof(item_temp))];
  mp2 = apply_temp[random(sizeof(apply_temp))];
  //	pj = random( (int) sizeof(armor_shuxing) );  //由于动态装备的属性只有7种了所以这里要改	
  //	pj = random( (int) (sizeof(armor_shuxing) / get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "MAX_RANDOM_JIE")) );
  //	lvl = random(get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "ITEM_CLOTH_MAX_LEVEL"))+1;
  //	lvl = 1;
  //	armor = lvl * 100;
  //	armor = armor + random(armor);
  //	if ( !armor || armor < 100 ) armor = 1+random(99);

  set_name(HIR "破碎戒指" NOR, ({ "posui jiezhi", "jiezhi", "ring" }));
  set("long", "采女娲补天之石，以九重天火焚烧，历经九九八十一天而成。属于传说中的破碎境界套装。\n");
  set_weight(500);
  set("value", 10000000);
  set("armor_prop/level", 1);  //初始等级
  //	get_item_shuxing("armor", pj, lvl, 1);
  set("armor_prop/armor", 200);
  set("armor_prop/strength", 30);
  set("armor_prop/intelligence", 30);
  set("armor_prop/constitution", 30);
  set("armor_prop/dexerity", 30);
  set("armor_prop/karma", 30);
  set("armor_prop/personality", 30);
  set("armor_prop/unarmed", 30);
  set("armor_prop/force", 30);
  set("armor_prop/dodge", 30);
  set("armor_prop/parry", 30);
  set("unit", "件");
  set("icon", "10077");
  set("material", "gem");
  set("owner_id", 1);
  //	set("dtzb",1); //添加判定,非副本装备无法强化
  set("xyzx_save_item", 1);
  set("xyzx_sys/bind_type", 0);
  set("xyzx_item/pinji", 6);

  if (random(2) == 1) set("item_temp", mp1);
  else set("apply_temp", mp2);
  //	set("taozhuang",21);
  //	set("max_level", 30);	
  //---------------------------------------------------------------
  //套装参数
  set("suit", BLK "破碎套装" NOR);  //套装名称
  set("suit_lvl", 6);             //套装等级
  set("suit_count", 12);           //套装部件数量
  //套装各部件
  set("suit_mod/armor", "破碎铠甲");
  set("suit_mod/boots", "破碎战靴");
  set("suit_mod/pants", "破碎裤子");
  set("suit_mod/hands", "破碎护手");
  set("suit_mod/head", "破碎头盔");
  set("suit_mod/neck", "破碎项链");
  set("suit_mod/cloth", "破碎战衣");
  set("suit_mod/ring", "破碎戒指");
  set("suit_mod/shield", "破碎盾甲");
  set("suit_mod/surcoat", "破碎披风");
  set("suit_mod/waist", "破碎腰带");
  set("suit_mod/wrists", "破碎护腕");
  set("suit_mod/briefs", "破碎内裤");
  set("suit_mod/brassiere", "破碎胸罩");
  set("suit_mod/card", "破碎令牌");
  //套装全部附加天赋效果  
  set("suit_eff/dexerity", 400);
  set("suit_eff/intelligence", 400);
  set("suit_eff/constitution", 400);
  set("suit_eff/strength", 400);
  set("suit_eff/karma", 400);
  set("suit_eff/personality", 400);
  set("suit_eff/armor", 2000);
  //套装全部附加技能效果     
  set("suit_eff_skill/unarmed", 1000);
  set("suit_eff_skill/force", 1000);
  set("suit_eff_skill/dodge", 1000);
  set("suit_eff_skill/parry", 1000);

  //---------------------------------------------------------------
  setup(1);
}

int wear() {
  if ((int)this_player()->query(
    "breakup",
    1
  ) < 4 || (string)this_player()->query("cognize") != HIR "破碎虚空" NOR)
    return notify_fail("你的武学修为未达到破碎境界，无法穿戴破碎套装。\n");
  if (::wear()) {
    if (query("item_temp")) this_player()->add_temp(query("item_temp"), 1);
    if (query("apply_temp")) this_player()->add_temp(query("apply_temp"), 20);
    return 1;
  } else
    return 0;
}
int unequip() {
  if (::unequip()) {
    if (query("item_temp")) this_player()->add_temp(query("item_temp"), -1);
    if (query("apply_temp")) this_player()->add_temp(query("apply_temp"), -20);
    return 1;
  } else
    return 0;
}
