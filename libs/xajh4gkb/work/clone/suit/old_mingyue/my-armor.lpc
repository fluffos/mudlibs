//明月套装-铠甲

#include <armor.h>
#include <ansi.h>

inherit ARMOR;
inherit F_ITEM_MAKE;

void create()
{
	int pj, lvl, armor;

	pj = random( (int) sizeof(armor_shuxing) );  //由于动态装备的属性只有7种了所以这里要改		
	lvl = random(get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "ITEM_CLOTH_MAX_LEVEL"))+1;
	armor = lvl * 100/2;
	armor = armor + random(armor);
	if ( !armor || armor < 100 ) armor = 1+random(99);
	
	set_name(HIW"明月铠甲"NOR, ({ "mingyue kai","kai", "armor" }) );
	set("long", "珍珠如明月，盈盈有辉光；故名为明月铠，属于传说中的明月套装中的一件。\n");
	set_weight(300 + (random(pj) * 100) + (random(lvl) * 100));
	set("value", 6000000);	
//	set("armor_prop/level", lvl);	//初始设定为0级
	set("armor_prop/level", 0);
	get_item_shuxing("armor", pj, lvl, 1);
	set("armor_prop/armor", armor);
	set("unit", "件");	
	set("icon", "10077");	
	set("material", "gem");
	set("owner_id",1);	
	set("dtzb",1); //添加判定,非副本装备无法强化
	set("xyzx_save_item", 1);	
	set("xyzx_sys/bind_type", 0);		
	set("xyzx_item/pinji", 1);
	set("taozhuang",21);
	set("max_level", 30);	
 //---------------------------------------------------------------
              //套装参数
    set("suit",HIW"明月套装"NOR);  //套装名称
    set("suit_lvl", 1);             //套装等级
    set("suit_count",10);           //套装部件数量
              //套装各部件
    set("suit_mod/armor","明月铠甲");
    set("suit_mod/boots","明月长靴");
    set("suit_mod/pants","明月长裤");
    set("suit_mod/hand","明月护手");
    set("suit_mod/head","明月头盔");
    set("suit_mod/neck","明月项链");
    set("suit_mod/cloth","明月长衫");
    set("suit_mod/ring","明月戒指");
    set("suit_mod/shield","明月盾牌");
    set("suit_mod/surcoat","明月披风");
    set("suit_mod/waist","明月腰带");
	set("suit_mod/wrists","明月护腕");
	//套装全部附加天赋效果  
	set("suit_eff/dexerity", 10000); 
	set("suit_eff/intelligence", 10000);  
	set("suit_eff/constitution", 10000);  
	set("suit_eff/strength", 10000); 
	set("suit_eff/armor", 10000); 
//	set("suit_eff/karma", 10000); 	
//	set("suit_eff/personality", 10000); 
    //套装全部附加技能效果     
//	set("suit_eff_skill/huagong-dafa", 1000);
//	set("suit_eff_skill/beiming-shengong", 1000);
//	set("suit_eff_skill/xixing-dafa", 1000);
	
 //---------------------------------------------------------------
	setup(1);
}