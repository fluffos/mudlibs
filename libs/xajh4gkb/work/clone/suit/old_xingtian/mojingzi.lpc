// tielianzi.c
#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create()
{
        set_name(GRN"魔睛子"NOR, ({ "mo jingzi", "throwing" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
				set("xyzx_item/pinji", 2);
				set("owner_id",1);
				set("taozhuang",12);
				set("max_level", 1);
				set("xyzx_save_item", 1);
				set("xyzx_sys/bind_type", 0);		
				set("weapon_prop/strength", 15000);
				set("weapon_prop/intelligence", 15000);	
				set("weapon_prop/constitution", 15000);	
				set("weapon_prop/dexerity", 15000);	
				set("weapon_prop/karma", 15000);
				set("weapon_prop/personality", 15000);
				set("no_tie",1); //添加判定,暗器不能贴符
                set("unit", "些");
                set("value", 0);
                set("base_unit", "颗");
                set("base_weight", 10);
                set("base_value", 15);
                set("material", "iron");
                set("long", HIW"魔王妖王所用的邪恶暗器，会自己追被攻击人。\n"NOR);
                set("wield_msg", HIC"$N微微一抖，一些魔睛子夹在双指之间，仿佛魔王之眼！\n"NOR);
                set("unwield_msg",HIC"$N无声无息，手指间的魔睛子笼入袖里。\n"NOR);
        }
        set_amount(10000);
        init_throwing(15000);
        setup();
}
int hit_ob(object me,object victim,int damage_bonus)
{
victim->apply_condition("wuxing_poison", 20);
victim->apply_condition("emerald_poison", 20);
//if( !victim->is_busy() ) victim->start_busy(1);
return damage_bonus;
}
int query_autoload() { return 1; }