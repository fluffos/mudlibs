//门派令牌
#include <armor.h>
#include <ansi.h>

inherit CARD;
inherit F_ITEM_MAKE;

void create()
{
	int pj, lvl, armor;

	pj = random( (int) sizeof(armor_shuxing) );  //由于动态装备的属性只有7种了所以这里要改		
//	lvl = random(get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "ITEM_CLOTH_MAX_LEVEL"))+1+random(2);
	lvl = 1+random(6);
	armor = lvl * 100/2;
	armor = armor + random(armor);
	if ( !armor || armor < 100 ) armor = 1+random(99);
	
	set_name(HIM"峨嵋派长老弟子令牌"NOR, ({ "emei zhanglao lingpai","menpai lingpai","lingpai" }) );
	set("long", "这是峨嵋派长老弟子的身份象征，行走江湖必戴之物。\n");
	set_weight(300 + (random(pj) * 100) + (random(lvl) * 100));
	set("value", 5000000);	
	set("armor_prop/level", lvl);	//初始等级
	get_item_shuxing("armor", pj, lvl, 1);
	set("armor_prop/armor", armor);
	set("unit", "件");	
	set("icon", "10077");	
	set("material", "card");
	set("owner_id",1);	
//	set("dtzb",1); //添加判定,非副本装备无法强化
	set("xyzx_save_item", 1);	
	set("xyzx_sys/bind_type", 0);		
	set("xyzx_item/pinji", 4);
//	set("taozhuang",22);
//	set("max_level", 35);	
	set("menpai","峨嵋派");
	set("item_temp","wupin_max_add");	
	setup(1);
}
//2018.10.15阿飞改，门派令更换新的写法
int wear()
{
	if (this_player()->query("family/family_name")!="峨嵋派")
		return notify_fail("你不是峨嵋派弟子，无法佩戴峨嵋派令牌。\n");
	if ( this_player()->query_skill_mapped("force") != "linji-zhuang" )
		return notify_fail("你不使用临济十二庄，无法发挥门派令牌的作用。\n");
    if (::wear())
	{
		if (query("item_temp")) this_player()->add_temp(query("item_temp"), 5);
		if (query("apply_temp")) this_player()->add_temp(query("apply_temp"), 100);
		return 1;
    } else
		return 0;
}
int unequip()
{
    if (::unequip())
	{  	
		if (query("item_temp")) this_player()->add_temp(query("item_temp"), -5);
		if (query("apply_temp")) this_player()->add_temp(query("apply_temp"), -100);
		return 1;
    } else
		return 0;
}
