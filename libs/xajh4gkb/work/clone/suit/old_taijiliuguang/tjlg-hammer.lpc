//第3版装备系统

#include <weapon.h>
#include <ansi.h>

inherit HAMMER;
inherit F_ITEM_MAKE;

void create()
{
	int pj, lvl, damage, item_type;	
	pj = random( (int) sizeof(weapon_shuxing) );  //由于动态装备的属性只有7种了所以这里要改
	lvl = random(get_system_config(DATA_CONFIG_DIR "weapon.h", "ITEM_WEAPON_MAX_LEVEL"))+1;	
	damage = lvl * 100/2;
	damage = damage + random(damage);
	if ( !damage || damage < 100 ) damage = 1+random(99);
//	item_type = 1 + random(2);//单双手随机
	item_type = 2; //指定为单手
	
	set_name(RED "太极流光锤" NOR, ({ "taijiliuguang chui","chui", "hammer"}));
	set_weight(3000 + (random(pj) * 100) + (random(lvl) * 100));
	set("value", 10000000);	
//	set("weapon_prop/level", lvl);	//初始设定为0级
	set("weapon_prop/level", 0);
	get_item_shuxing("weapon", pj, lvl, 1);	
	set("unit", "柄");
	set("icon", "10068");
	set("material", "steel");
	set("owner_id",1);
	set("dtzb",1); //添加判定,非副本装备无法强化
	set("xyzx_save_item", 1);
	set("xyzx_sys/bind_type", 0);
	set("xyzx_item/pinji", 5);
	set("taozhuang",15);
	set("max_level", 50);
	set("long", "天地之道，以阴阳二气造化万物，日月、风雨，刚柔、动静莫不合此道也。此番水火相逢，相生相克，有大神通。\n");	
	set("wield_msg", HIR"一声脆响,$N手里无声无息的多了把紫金大锤.\n"NOR);
	set("unwield_msg", HIC"$N手中阴阳二气流转，将手中的$n插回后腰。\n");        	
	 

	init_hammer(damage, item_type, 1);
	setup();
}
int query_autoload() { return 1; }
