#include <armor.h>
#include <ansi.h>

inherit MEDAL;
void create()
{
	set_name(HIY"战斗勋章"NOR, ({ "zhandou xunzhang","xunzhang", "medal" }) );
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "传说中神奇的战斗勋章，可以提高战斗时获得的经验值。\n");
		set("material", "medal");
		set("unit", "件");
		set("icon", "10069");
		set("value", 10000000);
		set("armor_prop/unarmed", 200);
		set("armor_prop/force", 200);
		set("armor_prop/dodge", 200);
		set("armor_prop/parry", 200);
		set("armor_prop/strength", 200);		
		set("armor_prop/strength", 200);
		set("armor_prop/intelligence", 200);	
		set("armor_prop/constitution", 200);	
		set("armor_prop/dexerity", 200);	
		set("armor_prop/karma", 200);
		set("armor_prop/personality", 200);	
		set("armor_prop/armor", 1000);
		set("xyzx_item/pinji", 6);
		set("xyzx_save_item", 1);
		set("xyzx_sys/bind_type", 0);	
//		set("no_steal",1);
//		set("no_put",1);
//		set("no_get",1);
//		set("no_beg",1);
//		set("no_jie", 1);	//不能贴符
//		set("no_tie",1);	//不能贴符
//		set("no_zm",1);		//不能镶嵌动态宝石
//		set("no_give", 1);		//勋章不能送人
//		set("no_drop", 1);		//勋章不能丢弃
//		set("xyzx_sys/no_give", 1);		//勋章绑定后也不能送人
//		set("dtzb",1); //添加判定,非副本装备无法强化
		set("wear_msg", CYN "只见光芒四射,$N热情洋溢的将一个霞光万道的$n"CYN"挂在左胸口。\n" NOR);
		set("remove_msg", GRN "$N轻轻的一挥手，$n"GRN"幻化成一片霞雾逐渐消失不见。\n" NOR);
		set("item_temp","fight_exp_add");
	}
	setup();
}
int query_autoload() { return 1; }

int wear()
{
    if (::wear())
	{
		if (query("item_temp")) this_player()->add_temp(query("item_temp"), 10);
		if (query("apply_temp")) this_player()->add_temp(query("apply_temp"), 200);
		return 1;
    }else
		return 0;
}
int unequip()
{
    if (::unequip())
	{  	
		if (query("item_temp")) this_player()->add_temp(query("item_temp"), -10);
		if (query("apply_temp")) this_player()->add_temp(query("apply_temp"), -200);
		return 1;
    }else
		return 0;
}