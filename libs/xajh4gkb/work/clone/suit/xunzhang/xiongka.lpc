#include <armor.h>
#include <ansi.h>

inherit CARD;
void create()
{
	set_name(YEL"荣誉胸卡"NOR, ({ "rongyu xiongka", "xiongka","card" }));
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "传说中神奇的荣誉胸卡，奖励给特殊贡献人员，拥有各种神奇的效果。\n");
		set("material", "card");
		set("unit", "件");
		set("value", 10000000);
		set("armor_prop/unarmed", 200);
		set("armor_prop/force", 200);
		set("armor_prop/dodge", 200);
		set("armor_prop/parry", 200);
		set("armor_prop/strength", 200);		
		set("armor_prop/strength", 200);
		set("armor_prop/intelligence", 200);	
		set("armor_prop/constitution", 200);	
		set("armor_prop/dexerity", 200);	
		set("armor_prop/karma", 200);
		set("armor_prop/personality", 200);	
		set("armor_prop/armor", 1000);
		set("xyzx_item/pinji", 6);
		set("xyzx_save_item", 1);
		set("xyzx_sys/bind_type", 0);	
//		set("no_steal",1);
//		set("no_put",1);
//		set("no_get",1);
//		set("no_beg",1);
//		set("no_jie", 1);	//不能贴符
//		set("no_tie",1);	//不能贴符
//		set("no_zm",1);		//不能镶嵌动态宝石
//		set("no_give", 1);		//勋章不能送人
//		set("no_drop", 1);		//勋章不能丢弃
//		set("xyzx_sys/no_give", 1);		//勋章绑定后也不能送人
		set("wear_msg", CYN "只见光芒四射,$N热情洋溢的将一个霞光万道的$n"CYN"挂在右胸口。\n" NOR);
		set("remove_msg", GRN "$N轻轻的一挥手，$n"GRN"幻化成一片霞雾逐渐消失不见。\n" NOR);
	}
	setup();
}
int query_autoload() { return 1; }

int wear()
{
    if (::wear())
	{
		this_player()->add_temp("fight_exp_add", 10);	//穿上后附加战斗经验提升10%效果
		this_player()->add_temp("renwu_exp_add", 10);	//穿上后附加任务经验提升10%效果
		this_player()->add_temp("jineng_exp_add", 10);	//穿上后技能自练经验提升10%效果
		this_player()->add_temp("lianzhao_max_add", 10);	//穿上后连招数量上限提高20-40
		this_player()->add_temp("damage_max_add", 10);	//穿上后普攻产生的伤害提高30%
		this_player()->add_temp("armor_max_add", 10);	//穿上后防御效果提高50%
		this_player()->add_temp("dam_max_add", 10);	//穿上后招式效果提高30%
		this_player()->add_temp("wupin_max_add", 10);	//穿上后获取物品几率提升10%效果
		this_player()->add_temp("jingnei_max_add", 10);	//穿上后获取精力内力提升10%效果
		return 1;
    } else
		return 0;
}
int unequip()
{
    if (::unequip())
	{  	
		this_player()->add_temp("fight_exp_add", -10);
		this_player()->add_temp("renwu_exp_add", -10);
		this_player()->add_temp("jineng_exp_add", -10);
		this_player()->add_temp("lianzhao_max_add", -10);
		this_player()->add_temp("damage_max_add", -10);
		this_player()->add_temp("armor_max_add", -10);
		this_player()->add_temp("dam_max_add", -10);
		this_player()->add_temp("wupin_max_add", -10);
		this_player()->add_temp("jingnei_max_add", -10);
		return 1;
    } else
		return 0;
}