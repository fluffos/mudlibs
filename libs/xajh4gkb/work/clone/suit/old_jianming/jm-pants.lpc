// 剑茗套装：裤子

#include <armor.h>
#include <ansi.h>
#define ITEM_LEVEL 1

inherit PANTS;
inherit F_ITEM_MAKE;
//#include <item_sx.h>

void create()
{
	string *item;
	int i, max;

	item = keys(armor_shuxing);
	max = sizeof(item);
	for ( i=0; i < max; i++ )
	{
		set("armor_prop/"+item[i], ITEM_LEVEL * 100);   // 设置常规属性
	}
	set_name(YEL"剑茗长裤"NOR, ({ "jianming kuzi","kuzi", "pants" }) );
	set("long", "这是一条非常精致华丽的护腿，属于传说中的剑茗套装中的一件。\n");
	set_weight(300 + (random(max) * 100) + (random(ITEM_LEVEL) * 100));
	set("value", 5000000 + (random(max + ITEM_LEVEL) * 1000000));
	set("armor_prop/level", ITEM_LEVEL);	
	set("material", "steel");
	set("xyzx_item/pinji", 3);
	set("owner_id",1);
	set("taozhuang",3);
	set("max_level", 30);
	set("xyzx_save_item", 1);
	set("xyzx_sys/bind_type", 0);
	set("unit", "条");
	set("icon", "10083");
 //---------------------------------------------------------------
              //套装参数
    set("suit",YEL"剑茗套装"NOR);  //套装名称
    set("suit_lvl", 3);             //套装等级
    set("suit_count",10);           //套装部件数量
              //套装各部件
    set("suit_mod/armor","剑茗铠甲");
    set("suit_mod/boots","剑茗长靴");
    set("suit_mod/pants","剑茗长裤");
    set("suit_mod/hand","剑茗护手");
    set("suit_mod/head","剑茗头盔");
    set("suit_mod/neck","剑茗项链");
    set("suit_mod/cloth","剑茗长衫");
    set("suit_mod/ring","剑茗戒指");
    set("suit_mod/shield","剑茗盾牌");
    set("suit_mod/surcoat","剑茗披风");
    set("suit_mod/waist","剑茗腰带");
	set("suit_mod/wrists","剑茗护腕");
	//套装全部附加天赋效果  
	set("suit_eff/dexerity", 3000); 
	set("suit_eff/intelligence", 3000);  
	set("suit_eff/constitution", 3000);  
	set("suit_eff/strength", 3000); 
	set("suit_eff/armor", 200000);  
    //套装全部附加技能效果     
	set("suit_eff_skill/taoism", 1000);
                
 //---------------------------------------------------------------
	setup(1);
}
int wear()
{
    if (::wear()){
        this_player()->add("max_jing", 500000);
		this_player()->add("max_qi", 500000);
         return 1;
    }else
    return 0;
}
int unequip()
{
    if (::unequip()){  
        this_player()->add("max_jing", -500000);	
	    this_player()->add("max_qi", -500000);
    return 1;
    }else
     return 0;
}