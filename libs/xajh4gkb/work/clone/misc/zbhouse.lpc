//by guoguo

inherit ITEM;
#define MAX_ZB 100
private mapping all_zb=([ ]);
void create()
{
        set_name("装备仓库", ({"zhuangbeicangku"}));
        set("total_zhuangbei",0);
}

int do_save(string arg)
{
    return save_object(arg);
}

int do_load(string arg)
{
    return restore_object(arg);
}

mapping get_all_zb()
{
    return all_zb;
}

int add_zb(object ob)
{
    int i;
    string idx;
    if(!objectp(ob))
	return 0;
    if(!mapp(all_zb))
	all_zb=([ ]);
    for(i=0;i<MAX_ZB;i++)
    {
	idx=sprintf("%3d",i);
	if(undefinedp(all_zb[idx]))
	{
	    all_zb[idx]=([
		    "dbase" : ob->query_entire_dbase(),
		    "my_id" : ob->parse_command_id_list(),
		    "base_name" : base_name(ob)
		    ]);
	    return 1;
	}
    }
    return 0;
}

object qu_zb(int index)
{
    string idx;
    object zb;
    string bn;
    mapping tmp,db;
    string *myid;
    string *keys;
    int i,sz;
    idx=sprintf("%3d",index);
    if(undefinedp(all_zb[idx]))
	return 0;
    tmp = all_zb[idx];
    if(undefinedp(tmp["dbase"]) || undefinedp(tmp["my_id"]) || undefinedp(tmp["base_name"]))
	return 0;
    db = tmp["dbase"];
    myid = tmp["my_id"];
    bn = tmp["base_name"];
    if(!mapp(db) || sizeof(myid)==0 || sizeof(bn)==0)
	return 0;
    zb = new(bn);
    if(!zb || !objectp(zb))
	return 0;
    zb->delete("female_only");
    keys = keys(db);
    sz = sizeof(keys);
    for(i=0;i<sz;i++)
    {
	zb->set(keys[i],db[keys[i]]);
    }
    zb->set_name(db["name"],myid);
    map_delete(all_zb,idx);
    return zb;
}
