#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "养精丹" NOR, ({ "yangjing dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "粒");
    set("value", 2000);
  }
  setup();
}

int init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me = this_player();

  if (!(arg)) return notify_fail("你要吃什么？\n");
  if (me->is_busy())
    return notify_fail("别急，慢慢吃，小心别噎着了。\n");
  message_vision("$N吃下一粒" + name() + "。\n", me);
  if ((int)me->query("eff_jing") == (int)me->query("max_jing"))
    return notify_fail("你现在不需要用养精丹。\n");
  else {
    me->receive_curing("jing", 10 + (int)me->query("max_jing") / 100);  //2016.5.23阿飞改，更改金疮药的疗效
    message_vision("$N吃下一包养精丹，精神看起来好多了。\n", me);
    me->start_busy(1);
    destruct(this_object());
    return 1;
  }
}

int query_autoload() { return 1; }
