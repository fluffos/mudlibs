//长袍-普通
#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name("长袍", ({ "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 120);
  }
  setup();
}

int query_autoload() { return 1; }
