//战斗装甲--精良
#include <armor.h>
inherit ARMOR;
void create()
{
	set_name("战斗装甲", ({ "battle armor", "armor" }) );
	set_weight(50000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "gold");
		set("value", 9000);
		set("armor_prop/armor", 500);
		set("armor_prop/dodge", 10);
	}
	setup();
}
int query_autoload() { return 1; }