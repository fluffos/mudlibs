//测试专用衣-巫师专用
#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name("测试专用衣", ({ "ceshi yi" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("icon", "10001");
    set("unit", "件");
    set("long", "这是一件普通的大衣，老百姓家常之物。\n");
    set("material", "cloth");
    set("value", 0);
    set("armor_prop/strength", 100);
    set("armor_prop/dexerity", 100);
    set("armor_prop/intelligence", 100000);
    set("armor_prop/constitution", 100);
    set("armor_prop/armor", 5000);
  }
  setup();
}
int query_autoload() { return 1; }
void owner_is_killed() { destruct(this_object()); }

