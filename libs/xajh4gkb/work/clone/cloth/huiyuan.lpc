//炎龙艳霞衣--神器
#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name(HIY "炎" HIG "龙" HIB "艳" HIM "霞" HIC "衣" NOR, ({ "yanxia yi", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "传说中炎龙天翼所化的霞衣。\n");
    set("material", "cloth");
    //		set("owner_id",1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("unit", "件");
    set("armor_type", "cloth");
    set("armor_prop/personality", 10);
    set("armor_prop/karma", 10);
    set("armor_prop/intelligence", 10);
    set("armor_prop/constitution", 10);
    set("armor_prop/dexerity", 10);
    set("armor_prop/strength", 10);
    set("value", 12000000);
    set("armor_prop/armor", 1500);
    set(
      "wear_msg",
      CYN "$N穿上一件$n," CYN "浑身闪耀" HIM "七彩光华，" HIB "$N顿觉" HIC "艳光四射，" HIY "引无数英豪" GRN "尽折腰。\n" NOR
    );
    set("remove_msg", GRN "华光顿敛，$N把$n轻轻地脱了下来。\n" NOR);
  }
  setup();
}
int query_autoload() { return 1; }
//void owner_is_killed() {destruct(this_object());} 

int move(mixed dest) {
  if (!userp(dest)) return ::move(dest);
  if (::move(dest) == 0) return 0;
  if (dest->query_temp("god_armor") != this_object()->query("id")) {
    message(
      "rumor",
      HIR "【江湖传奇】" + HIG "据说炎龙天翼所化的神器" + this_object()->query("name") + HIG "被" + dest->query("name") + "(" + dest->query("id") + ")拿到手了！\n" NOR,
      users()
    );
    dest->set_temp("god_armor", this_object()->query("id"));
  }
  return 1;
}
//2017.4.15阿飞改,神器附加特殊效果
int ob_hit(object ob, object me, int damage) {
  int j, damage1, damage2;
  damage1 = this_object()->query("armor_prop/armor") * 3;
  damage2 = this_object()->query("armor_prop/armor");
  if (random(5) == 1) {
    damage1 += random(damage1);
    damage2 += random(damage2);
    ob->receive_damage("jing", damage1, me);
    ob->receive_wound("jing", damage2, me);
    j = -(damage / 3 + random(damage / 3));
    message_vision(
      HIM "$N内力流转，注入" + this_object()->query("name") + HIM "之中，$n刚一接触，便受到真气反噬！\n" NOR,
      me,
      ob,
      damage1,
      HBWHT + HIY "精神反伤" NOR
    );
    return j;
  }
}

int wear() {
  if (!userp(this_player())) return ::wear();
  //	if ( !wizardp(this_player()) && userp(this_player()))
  //		return notify_fail(HIW"神器蒙尘，暂时不是你能使用的，等待巫师调整。\n"NOR);
  if (stringp(this_player()->query_temp("wear_god_armor")) && (string)this_player()->query_temp("wear_god_armor") != this_object()->query("id"))
    return notify_fail(HIW "神器傲娇，岂能与其他神器共事一主。\n" NOR);
  if (::wear()) {
    if (userp(this_player())) this_player()->set_temp("wear_god_armor", this_object()->query("id"));
    return 1;
  }
  return 0;
}
