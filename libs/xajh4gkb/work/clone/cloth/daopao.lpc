//青色道袍-普通
#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name("青色道袍", ({ "qingse daopao", "cloth", "dao pao" }));
  set_weight(4500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这是件洗了发白的青色道袍。\n");
    set("material", "cloth");
    set("armor_prop/armor", 120);
  }
  setup();
}
int query_autoload() { return 1; }
