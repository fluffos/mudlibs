//布衣-普通
#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create()
{
	set_name("布衣", ({ "cloth" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("icon","10001");
		set("unit", "件");
		set("long", "一件很普通的布衣。\n");
		set("material", "cloth");
		set("value", 0);
		set("armor_prop/armor", 100);
	}
	setup();
}
int query_autoload() { return 1; }
