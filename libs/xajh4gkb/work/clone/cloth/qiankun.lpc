//乾坤宝甲--神器
#include <armor.h>
#include <ansi.h>	
inherit ARMOR;	
void create()	
{	
	set_name(HIC "乾"YEL"坤"HIM"宝甲" NOR,({ "qiankun baojia","baojia","armor", }) ); 	
	set_weight(5000);	
	if( clonep() )	
		set_default_object(__FILE__);	
	else	
	{	
		set("unit", "件");	
		set("long", "一件玄奇的软甲,据说是天地间灵气凝结而成,。\n");	
		set("material", "copper");	
		set("value",10000000);	
		set("armor_type", "armor");
		set("no_get",1);
		set("no_give",1);
		set("no_drop",1);
		set("no_put", 1);	
//		set("no_get", "这样东西不能离开那儿。\n");	
//		set("no_drop", "这样东西不能离开你。\n");                           	
		set("armor_prop/armor", 1200);	
		set("armor_prop/dodge", 10);	
		set("armor_prop/force", 10);	
		set("armor_prop/unarmed", 20);	
		set("armor_prop/sword", 20);	
		set("armor_prop/blade", 20);
		set("armor_prop/constitution", 10);
		set("wear_msg", YEL "$N双手一抖，一件玄黄色软甲迎风展开轻飘飘地落在了$N的肩上,"GRN"$N的身影在$n"GRN"天蓝色云气里变得模糊不清。\n" NOR);	
		set("remove_msg", YEL "$N凝神聚气伸手凭空一挥，$n"YEL"如风般飘起落入$N手中,$N的身形逐渐变得清晰。\n" NOR);	
	}	
	setup();	
}	
int query_autoload() { return 1; }	
//void owner_is_killed() {destruct(this_object());} 

int move(mixed dest)
{
	if(! userp(dest)) return ::move(dest);
	if( ::move(dest)==0) return 0;
	if (dest->query_temp("god_armor")!=this_object()->query("id"))
	{
		message("rumor",HIR"【江湖传奇】"+ HIG"据说八卦阵汇集天地灵气蕴养的神器"+ this_object()->query("name")+HIG"被"+ dest->query("name")+"("+dest->query("id")+")拿到手了！\n"NOR,users());
		dest->set_temp("god_armor",this_object()->query("id"));
	}
	return 1;
}
//2017.4.15阿飞改,神器附加特殊效果
int ob_hit(object ob, object me, int damage)
{	
	int j,damage1,damage2;
	damage1 = this_object()->query("armor_prop/armor")*3;
	damage2 = this_object()->query("armor_prop/armor");
	if( random(5)==1 )
	{	
		damage1 += random(damage1);
		damage2 += random(damage2);
		ob->receive_damage("qi",damage1,me);
		ob->receive_wound("qi",damage2,me);
		j = -(damage/2+random(damage/2));
		message_vision(HIM"$N内力流转，注入"+ this_object()->query("name")+HIM"之中，$n刚一接触，便受到真气反噬！\n"NOR, me, ob,damage1,HBWHT+HIY"气血反伤"NOR);
		return j;
	} 			      
}

int wear()
{
	if(!userp(this_player())) return ::wear();
//	if ( !wizardp(this_player()) && userp(this_player()))
//		return notify_fail(HIW"神器蒙尘，暂时不是你能使用的，等待巫师调整。\n"NOR);
	if ( stringp(this_player()->query_temp("wear_god_armor")) && (string)this_player()->query_temp("wear_god_armor")!= this_object()->query("id") )
		return notify_fail(HIW"神器傲娇，岂能与其他神器共事一主。\n"NOR);		
	if (::wear())
	{
		if (userp(this_player())) this_player()->set_temp("wear_god_armor",this_object()->query("id"));
		return 1;
	}
	return 0;
}