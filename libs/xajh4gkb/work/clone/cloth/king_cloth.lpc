//黄锦锻 -普通
#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create()
{
	set_name(YEL "黄锦缎" NOR, ({ "cloth" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "cloth");
		set("armor_prop/armor", 200);
	}
	setup();
}
int query_autoload() { return 1; }