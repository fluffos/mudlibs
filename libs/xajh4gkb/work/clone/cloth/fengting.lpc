//风霆云巾--名器
#include <armor.h>
#include <ansi.h>
inherit WRISTS;
//inherit EQUIP;	//这个类型有错误吧

void create() {
  set_name(HIY "风霆云巾" NOR, ({ "fengting yunjin", "fengting", "yunjing", "hat" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 5000000);
    set("material", "cloth");
    set("armor_type", "wrists");
    set("armor_prop/axe", 20);
    set("armor_prop/spear", 20);
    set("armor_prop/dodge", 5);
    set("armor_prop/armor", 600);
    set("wear_msg", "$N戴上一顶$n，雷光环绕手臂。\n");
    set("remove_msg", "$N将$n脱了下来，雷霆退散。\n");
  }
  setup();
}
int query_autoload() { return 1; }

