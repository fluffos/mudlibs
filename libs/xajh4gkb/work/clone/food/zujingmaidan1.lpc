// shenliwan.c 福缘丹

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "通脉丹-足太阴脾经" NOR, ({ "tongmai dan", "dan" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗七彩的通脉丹，据说吃了可以打通十二正经的足太阴脾经。\n");
    set("value", 10000000);
    set("unit", "颗");
  }
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me = this_player();
  object ob;

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (!objectp(ob = present(arg, me)))
    return notify_fail("什么?\n");

  message_vision(
    "$N一仰脖，吃下了一颗" + this_object()->name() + "，盘膝坐下运转全身内力，顺着足太阴脾经而行，冲击各处穴位......\n",
    me
  );
  if (me->query("jingmai/ztypjing")) {
    message_vision("$N眨眨眼。\n", me);
    tell_object(me, "你真气运行通畅，足太阴脾经已经打通了，白白浪费了一颗丹药。\n");
  } else if (me->query("eff_qi") < me->query("max_qi") || me->query("qi") < me->query("max_qi") || me->query("eff_jing") < me->query("max_jing") || me->query("jing") < me->query("max_jing")) {
    tell_object(me, "你提起全身真气冲击着足太阴脾经，正在紧要关头，哪知旧伤发作，真气从伤口一泻千里，你喷出一口精血，哎！\n");
    me->receive_damage("jing", 100 + me->query("max_jing") / 2);
    me->receive_wound("jing", 100 + me->query("max_jing") / 2);
  } else if (random(100) >= 20) {
    tell_object(me, "你浑身豆大的汗珠直冒，苦痛无比，已是忍受不住，吐出一口鲜血，险些昏死过去，哎，功亏一篑！\n");
    me->receive_damage("qi", 100 + me->query("max_qi") / 2);
    me->receive_wound("qi", 100 + me->query("max_qi") / 2);
    if (me->query("xyzx_sys/level", 1) > 10) me->add("xyzx_sys/level", -10);
  } else {
    tell_object(
      me,
      HIR "你提起全身真气，一浪接一浪冲击着足太阴脾经，咬紧牙关，一鼓作气。\n不一会身体通泰，全身毫毛如同吃了人参果张开，你起身长啸一声，足太阴脾经打通了。\n" NOR
    );
    me->set("jingmai/ztypjing", 1);
    //		message("party", HIM"【十二正经】"+HIG"听说 "+me->name(1)+HIG"("+me->query("id")+HIG") 吃下一颗" + this_object()->name() +HIG"，打通了足太阴脾经。\n"NOR,users() );
    message(
      "channel:chat",
      HIM "【十二正经】" + HIG "听说 " + me->name(1) + HIG "(" + me->query("id") + HIG ") 吃下一颗" + this_object()->name() + HIG "，打通了足太阴脾经。\n" NOR,
      users()
    );
  }

  destruct(this_object());
  return 1;
}
