//朱半仙
#include <ansi.h>
#include <localtime.h>
inherit NPC;
int give_quest();
void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("朱半仙", ({ "zhu banxian", "zhu", "halfgod", "banxian" }));
  set("gender", "男性");
  set("age", 56);
  set("long", "朱半仙是个神经兮兮的老家伙。\n");
  set("no_die", 1);
  set("env/wimpy", 70);
  set_skill("unarmed", 500 + jibie * 2 + random(jibie / 5));
  set_skill("force", 500 + jibie * 2 + random(jibie / 5));
  set_skill("sword", 500 + jibie * 2 + random(jibie / 5));
  set_skill("dodge", 500 + jibie * 2 + random(jibie / 5));
  set_skill("parry", 500 + jibie * 2 + random(jibie / 5));
  set_skill("qinnashou", 500 + jibie / 2 + random(jibie / 5));
  set_skill("yijing-force", 500 + jibie / 2 + random(jibie / 5));
  set_skill("wenrou-jian", 500 + jibie / 2 + random(jibie / 5));
  set_skill("shenxing-baibian", 500 + jibie / 2 + random(jibie / 5));
  map_skill("force", "yijing-force");
  map_skill("unarmed", "qinnashou");
  map_skill("parry", "wenrou-jian");
  map_skill("sword", "wenrou-jian");
  map_skill("dodge", "shenxing-baibian");

  set_temp("apply/attack", 200);
  set_temp("apply/defense", 200);
  set_temp("apply/armor", 200);
  set_temp("apply/dodge", 200);
  set("inquiry", ([
    "任务": (: give_quest :),
  ]));
  setup();
  set("water", max_water_capacity());
  set("food", max_food_capacity());
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();

}


string time_period(int timep) {
  int t, d, h, m, s;
  string time;
  t = timep;

  s = t % 60;
  t /= 60;
  m = t % 60;
  t /= 60;
  h = t % 24;
  t /= 24;
  d = t;

  if (d)
    time = chinese_number(d) + "天";
  else
    time = "";
  if (h)
    time += chinese_number(h) + "小时";
  if (m)
    time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";
  return " 在" + time + "内,";
}


int give_quest() {
  object me, *ob;
  int i, j, num, combatexp;
  string tag;
  mixed *local;
  mapping quest = ([]);
  string *levels = ({
    "1000",
    "3000",
    "5000",
    "10000",
    "20000",
    "50000",
    "100000",
    "150000",
    "200000",
    "250000",
    "300000",
    "400000",
    "500000",
    "1000000",
    "2000000",
  });
  me = this_player();
  combatexp = (int)(me->query("combat_exp"));
  local = localtime(time());
  if ((quest = me->query("quest"))) {
    if (((int)me->query("quest/task_time")) > time()) {
      message_vision("$N看了$p一眼: " + RANK_D->query_respect(me) + "似乎还有任务在身吧？\n", this_object(), me);
      return 0;
    } else {
      me->set("quest_failed", (int)me->query("quest/task_time") + random(150) + 30);
      me->delete("quest");
    }
  }
  if (time() >= me->query("quest_failed")) {
    me->delete_temp("quest_count");
    me->delete("quest_failed");
  }
  if (me->query("quest_failed")) {
    message_vision("$N对$n哼了一声: 上次的任务都完成不了，再问我就杀了你！\n", this_object(), me);
    return 1;
  }
  if (local[LT_MDAY] == (int)me->query("day_zhu_timecd"))  //每天
  {
    message_vision(HIR "$N看了$n一眼: 老夫每日只发布一次任务，今日你我机缘已尽！\n" NOR, this_object(), me);
    return 1;
  }
  for (j = sizeof(levels) - 1; j >= 0; j--) {
    if (atoi(levels[j]) <= combatexp) {
      num = random(j);
      break;
    }
  }


  tag = levels[num];
  while (1) {
    if (random(10) > 5) {
      quest = QUEST_D(tag)->query_quest();
      if (!mapp(quest)) return 0;
      //			quest["time"]=quest["diff"]*(random(50)+50);	//换个写法吧
      quest["time"] = random(600) + 600;
      tag = time_period(quest["time"]);
      command("whisper " + me->query("id") + tag + "帮我找『" + quest["quest"] + "』。\n");
      me->set("quest", quest);
      me->set("quest/quest_type", "寻");
      me->set("quest/diff", random(4) + 2);
      me->set("quest/task_time", (int)time() + (int)quest["time"]);
      me->add_temp("quest_count", 1);
      me->set("day_zhu_timecd", local[LT_MDAY]);
      return 1;
    } else {
      ob = livings();
      for (j = 0; j < sizeof(ob); j++) {
        i = random(sizeof(ob));
        if (ob[i]->query("combat_exp") <= combatexp + 10) {
          if (!environment(ob[i])) continue;
          if (userp(ob[i]) || !living(ob[i])) continue;
          if (environment(ob[i])->query("no_fight")) continue;
          if (ob[i]->query("no_die")) continue;
          if (sscanf(base_name(ob[i]), "/u/%*s")) continue;
          me->set("quest/time", random(600) + 600);
          tag = time_period(me->query("quest/time"));
          command("whisper " + me->query("id") + tag + "杀了" + ob[i]->short() + "。\n");
          me->set("quest/quest", ob[i]->short());
          me->set("quest/quest_type", "杀");
          me->set("quest/diff", random(4) + 2);
          me->set("quest/task_time", (int)time() + me->query("quest/time"));
          me->add_temp("quest_count", 1);
          me->set("day_zhu_timecd", local[LT_MDAY]);
          return 1;
        }
      }
      continue;
    }
  }


}


int accept_object(object me, object obj) {
  mapping quest, target;
  object home;
  int add_exp, add_pot, add_sco, renwu_exp_add;
  int failed_time;

  if (time() < me->query("quest_failed") || mapp(quest = me->query("quest"))) {
    if (obj->query("money_id") && obj->value() >= 1000000) {
      failed_time = random(50) + 30;
      tell_object(me, HIR "朱半仙脸色一变，不悦的说道：半仙交给你的任务竟敢不想完成！\n" NOR);
      tell_object(
        me,
        HIR "朱半仙嘿嘿一笑！！！老夫掐指一算，这位" + RANK_D->query_respect(me) + "今日必有牢狱之灾......！\n" NOR
      );
      //			me->set("quest_failed",(int)time() + failed_time);
      me->delete("quest");
      me->delete("quest_failed");
      //			tell_object(me, HIC"朱半仙连忙看了看四周，将金子收进袖中，不悦的说道：此乃铜臭之物，我老人家向来是高风亮节！\n不过嘛，"+RANK_D->query_respect(me)+"如此有诚意，那么我就替你易天改卦一次。嗯...你可以再过"+chinese_number(failed_time)+"秒时间，再来我这里领取新的任务。\n"NOR);
      me->set_temp("summon_time", time());
      me->move("/d/city/jianyu");
      //2018.5.27阿飞改，朱半仙任务不允许取消
      /*			command("say 好吧！"+me->name()+"，上次的任务就算了！");
			me->delete("quest_failed");
			me->delete("quest");
//			me->apply_condition("zhujob_busy",5);
			me->start_busy(5);	*/
      return 1;
    }
  }
  if (!mapp(quest)) {
    command("say 我对" + obj->name() + CYN + "不感兴趣。");
    return 0;
  }
  if (quest["quest_type"] != "寻") {
    say(CYN + this_object()->name() + "摇了摇头：" + RANK_D->query_respect(me) + "的任务不是拍我的马屁！\n" NOR);
    return 0;
  }


  target = quest["quest"];
  if (target != obj->name()) {
    command("say 这不是我想要的东西。");
    return 0;
  }
  if (!home = find_object(query("startroom"))) home = load_object(query("startroom"));
  if (environment() != home) {
    command("say 我现在正忙着呢！等我回去再说吧！");
    return 0;
  }
  renwu_exp_add = 0;
  if (me->query_temp("renwu_exp_add")) renwu_exp_add = (int)me->query_temp("renwu_exp_add", 1);  //处于任务经验提升状态时	
  if (quest["task_time"] > time()) {
    add_exp = (quest["diff"] * 10000 + 10000) * (renwu_exp_add + 100) / 100;
    add_exp *= 100;
    if (!(me->query_temp("quest_count") % 8)) add_exp *= 2;
    command("smile");
    tell_object(me, sprintf(WHT "你圆满完成了你的任务:\n你获得了%s点战斗经验！", chinese_number(add_exp)));
    me->add("combat_exp", add_exp);
    add_pot = (quest["diff"] * 10000 + 10000) * (renwu_exp_add + 100) / 100;
    add_pot *= 5000;
    if (!(me->query_temp("quest_count") % 8)) add_pot *= 2;
    tell_object(me, sprintf(HIY "\n%s点潜能！\n" NOR, chinese_number(add_pot)));
    me->add("potential", add_pot);
    add_sco = (quest["diff"] * 10 + 10) * (renwu_exp_add + 100) / 100;
    add_sco *= 100;
    tell_object(me, sprintf(YEL "江湖阅历增加了%s点！\n" NOR, chinese_number(add_sco)));
    me->add("score", add_sco);
    me->delete("quest");
    me->add("renwu/banxian_renwu", 1);
    //2018.4.28阿飞添加  国庆节活动--朱半贤任务10次
    //朱半仙杀NPC任务在feature/damage文件里控制
    if ((int)me->query("jieri_gift/guoqing")) me->add_temp("guoqing/banxian", 1);
    if ((int)me->query_temp("guoqing/banxian") >= 10) {
      me->set_temp("guoqing/banxian", 10);
      tell_object(me, HIW "你在国庆节期间，实践市民精神争做文明职工，勤勉可嘉！\n" NOR);
    }

    return 1;
  } else {
    me->set("quest_failed", (int)me->query("quest/task_time") + (int)me->query("quest/time"));
    if (time() >= me->query("quest_failed")) {
      me->delete_temp("quest_count");
      me->delete("quest_failed");
    }
    message_vision(CYN + "$N很生气地对$n说道：这么点儿事都办不好，真没用！\n" + NOR, this_object(), me);
    me->delete("quest");

    return 1;
  }
}
