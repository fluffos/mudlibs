//头盔--普通

#include <armor.h>
#include <ansi.h>
inherit HEAD;

void create() {
  set_name("头盔", ({ "helmet", "toukui" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "steel");
    set("unit", "顶");
    set("long", "这是一顶铁质的头盔，用以保护头部。\n");
    set("value", 1500);
    set("armor_prop/armor", 150);
  }
  setup();
}
int query_autoload() { return 1; }
