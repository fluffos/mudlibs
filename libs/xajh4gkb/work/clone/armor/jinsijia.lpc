//金丝甲--精良
#include <ansi.h>
#include <armor.h>
inherit CLOTH;

void create()
{
	set_name( HIY"金丝甲"NOR, ({ "jinsi jia", "jia"}) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 30000);
		set("material", "leather");
		set("armor_prop/armor", 400);
	}
	setup();
}

int query_autoload() { return 1; }