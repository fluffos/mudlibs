//  songyang 宋扬

inherit NPC;
string random_name();

void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("宋扬", ({ "song yang" }));
  //	set("nickname", "");
  set("long",
    "一个行走江湖的独角大盗，一身轻功有所造脂。\n");
  set("gender", "男性");
  set("age", 35);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 25);
  set("int", 20);
  set("con", 25);
  set("dex", 27);

  set("max_qi", 1500);
  set("max_jing", 1200);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiali", 100);
  set("combat_exp", 500000);
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: perform_action, "strike.sanhua" :),
  }));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));


  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("strike", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sanhua-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shnfa");
  map_skill("strike", "sanhua-zhang");
  map_skill("parry", "sanhua-zhang");
  prepare_skill("strike", "sanhua-zhang");

  setup();
  carry_object("/clone/cloth/cloth")->wear();
  add_money("silver", 50);
}
#include "/quest/guanfu/npc/npc.h"
