// hau 花五梅
inherit NPC;
string random_name();
 
void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("花五梅", ({"hua jianying"}));
//	set("nickname", "");
	set("long", 
        "有着一个好听的名字，可惜功夫平平，还时常打劫一些路客。\n");
	set("gender", "男性");
	set("age", random(10) + 25);
	set("attitude", "peaceful");
    set("shen_type", -1);	
	set("str", 25);
	set("int", 20);
	set("con", 25);
	set("dex", 27);
	
	set("max_qi", 500);
	set("max_jing", 400);
	set("neili", 700);
	set("max_neili", 700);
	set("jiali", 10);
	set("combat_exp", 75000 + random(40000)); 
	 
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("strike", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("literate", 500+jibie/3+random(jibie/5));
 
        setup(); 
        carry_object("/clone/cloth/cloth")->wear();
  	add_money("silver", 50);
}
#include "/quest/guanfu/npc/npc.h"
