// xu 徐长老
 
inherit NPC;
string random_name();
 
void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("徐长老", ({"xu zhanglao"}));
	set("nickname", "丐帮叛徒");
	set("long", 
        "丐帮的叛徒，据说丐帮弟子正在四处打探他的踪迹。\n");
	set("gender", "男性");
	set("age", 66);
	set("attitude", "peaceful");
    set("shen_type", -1);	
	set("str", 28);
	set("int", 20);
	set("con", 25);
	set("dex", 27);
	
	set("max_qi", 1500);
	set("max_jing", 1500);
	set("neili", 1800);
	set("max_neili", 1800);
	set("jiali", 100);
	set("combat_exp", 850000); 
	set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                (: perform_action, "force.powerup" :),
         })); 
         set_skill("force", 500+jibie/3+random(jibie/5));
         set_skill("huntian-qigong", 500+jibie/3+random(jibie/5));
         set_skill("dodge", 500+jibie/3+random(jibie/5));
  

        set_skill("xiaoyaoyou", 500+jibie/3+random(jibie/5));
        set_skill("unarmed", 500+jibie/3+random(jibie/5));
        set_skill("taizu-quan", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("liuhe-dao", 500+jibie/3+random(jibie/5));
        set_skill("blade", 500+jibie/3+random(jibie/5));
        map_skill("force", "huntian-qigong");
        map_skill("dodge", "xiaoyaoyou");
        map_skill("blade", "liuhe-dao");
        map_skill("unarmed", "taizu-quan");
  	map_skill("parry", "liuhe-dao");
  	prepare_skill("unarmed", "taizu-quan");
 
        setup(); 
        carry_object("/clone/cloth/cloth")->wear();
        carry_object(__DIR__"blade")->wield(); 
        add_money("gold", 3);
}
#include "/quest/guanfu/npc/npc.h"
