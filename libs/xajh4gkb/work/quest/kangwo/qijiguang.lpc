void create() {
  int jibie;
  jibie = 6000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set_name("戚继光", ({ "qi jiguang", "qi", "jiguang" }));
  set("nickname", HIY "抗倭名将" NOR);
  set("gender", "男性");
  set("age", 41);
  set("long",
    "他是明朝抗倭名将，杰出的军事家、书法家、诗人、民族英雄。\n");
  set("attitude", "friendly");
  set_max_encumbrance(100000000);
  set("xy_shoucheng", 1);
  set("no_suck", 1);
  set("end_boss", 1);
  set("per", 20);
  set("str", 30000);
  set("int", 20);
  set("con", 30000);
  set("dex", 30000);
  set("no_get", 1);
  set("no_put", 1);
  set_temp("no_get", 1);
  set_temp("no_kill", 1);
  set("chat_chance", 1);
  set("chat_msg", ({
    "戚继光叹了口气道：“倭寇时常侵扰我大宋沿海，然而宋室皇族却毫不重视，哎....\n",
    "戚继光说道：“大宋软弱啊，可苦了这沿海百姓......\n",
  }));

  set("inquiry", ([
    "抗倭": (: ask_newjob :),
    "功劳": (: job_over :),
  ]));

  set("qi", 3000000);
  set("eff_qi", 3000000);
  set("max_qi", 3000000);
  set("jing", 3000000);
  set("eff_jing", 3000000);
  set("max_jing", 3000000);
  set("neili", 300000000);
  set("max_neili", 24000);
  set("max_jingli", 50000);
  set("jingli", 300000);

  set("combat_exp", 2100000000);
  set("score", 200000);
  set_skill("force", 1000 + jibie / 3 + random(jibie / 5));
  set_skill("huntian-qigong", 1000 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 1000 + jibie / 3 + random(jibie / 5));
  set_skill("xianglong-zhang", 1000 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 1000 + jibie / 3 + random(jibie / 5));
  set_skill("xiaoyaoyou", 1000 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 1000 + jibie / 3 + random(jibie / 5));
  set_skill("spear", 1000 + jibie / 3 + random(jibie / 5));
  set_skill("yuejia-qiang", 1000 + jibie / 3 + random(jibie / 5));
  map_skill("force", "huntian-qigong");
  map_skill("unarmed", "xianglong-zhang");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("parry", "xianglong-zhang");
  map_skill("spear", "yuejia-qiang");

  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/bawang")->wield();
}

void init() {
  add_action("job_over", "task");
}

string ask_newjob() {
  object *ene;
  object me = this_player();
  //	object *usr;
  //	string str;	
  //	int i,ip_cnt;

  if (is_fighting()) {
    ene = query_enemy();
    if (sizeof(ene) > 1) return "“请" + RANK_D->query_respect(me) + "稍等片刻，我先和这" + sizeof(ene) + "位高手切磋几下！”\n";
    if (sizeof(ene) == 1) return "“请" + RANK_D->query_respect(me) + "稍等片刻，我先和" + ene[0]->name() + "切磋几下！”\n";
  }
  if (me->query_temp("mark/job_shadi") > 0)
    return "这位" + me->query("name") + "(" + me->query("id") + ")不是已有任务了吗！\n";
  if (me->is_busy())
    return "这位" + me->query("name") + "(" + me->query("id") + ")你现在正忙着呢！\n";
  if ((int)me->query_skill("force", 1) < 100)
    return "抗倭是件危险工作，我看这位" + me->query("name") + "(" + me->query("id") + ")的基本内功不足！\n";
  if ((int)me->query_condition("jobshadi_failed"))
    return "这位" + me->query("name") + "(" + me->query("id") + ")逃跑失败了还来见我......你还是别领任务的为好！\n";
  if ((int)me->query_condition("jobshadi_limit") > 1)
    return "这位" + me->query("name") + "(" + me->query("id") + ")不是正做着吗，你快点回你的岗位上去！\n";
  if (me->query("xyzx_sys/level") >= 100000)
    return (HIR "你已经不能再从抗倭任务中积累更多的经验，雾中楼那里可能需要人手你可以去试试。\n" NOR);
  if (me->query("xyzx_sys/level") < 100)
    return (HIR "以这位" + me->query("name") + "(" + me->query("id") + ")目前的能力还无法担任抗倭重任。\n" NOR);
  //	if ((int)me->query_condition("guojob2_busy"))
  //		return "现在日本人正在攻城！！这位"+me->query("name")+"("+me->query("id")+")等会再来！\n";
  //2018.6.12阿飞增加IP管制，暂时放开IP管制，排查服务器卡的原因
  /*	usr = get_all_user();
	str=query_ip_number(me);
	ip_cnt=0;
	for(i=0; i<sizeof(usr); i++)
	{
		if (str==query_ip_number(usr[i]) && usr[i]->query_temp("ip_qijob")) ip_cnt++;
	}
	if ( ip_cnt >= 3 ) 
		return (HIC"这个IP上抗倭的玩家太多了，别占那么多茅坑啊，会卡爆的！\n"NOR);	
*/
  if (random(5) == 0) message("channel:chat", HIC "【江南告急】" GRN + "有消息说：倭寇马上要侵犯泉州了！\n" NOR, users());
  me->set_temp("qi_job", 1);
  me->set_temp("ip_qijob", 1);
  switch (random(4)) {
    case 0:
      me->set_temp("mark/job_shadi", 1);
      me->set_temp("carry_location", "northgate1");
      me->apply_condition("guojob2_busy", 5);
      return (HIR "现在倭寇侵犯江南，这位" + me->query("name") + "(" + me->query("id") + ")去玄武内门帮助宋军抵抗倭寇吧。\n" NOR);
      break;
    case 1:
      me->set_temp("mark/job_shadi", 2);
      me->set_temp("carry_location", "eastgate1");
      me->apply_condition("guojob2_busy", 5);
      return (HIR "现在倭寇侵犯江南，这位" + me->query("name") + "(" + me->query("id") + ")去青龙内门帮助宋军抵抗倭寇吧。\n" NOR);
      break;
    case 2:
      me->set_temp("mark/job_shadi", 3);
      me->set_temp("carry_location", "southgate1");
      me->apply_condition("guojob2_busy", 5);
      return (HIR "现在日本倭寇侵犯江南，这位" + me->query("name") + "(" + me->query("id") + ")去朱雀内门帮助宋军抵抗倭寇吧。\n" NOR);
      break;
    case 3:
      me->set_temp("mark/job_shadi", 4);
      me->set_temp("carry_location", "westgate1");
      me->apply_condition("guojob2_busy", 5);
      return (HIR "现在倭寇侵犯江南，这位" + me->query("name") + "(" + me->query("id") + ")去白虎内门帮助宋军抵抗倭寇吧。\n" NOR);
      break;
  }
}

int job_over() {
  int job_pot, job_exp, job_sco, renwu_exp_add;
  int k1, flag, xingyun;
  object me = this_player();
  object room, badguy;
  //	object baoshi;

  renwu_exp_add = 0;
  if (me->query_temp("renwu_exp_add")) renwu_exp_add = (int)me->query_temp("renwu_exp_add", 1);  //处于任务经验提升状态时

  if (me->query_temp("guo_job") == 1) {
    message_vision(CYN "$N瞧了$n一眼：呵呵，你是想糊弄本官吗。\n", this_object(), me);
    return 1;
  }
  if (me->query_temp("help_killed") > 0) {
    message_vision(
      CYN "$N拍了拍$n的肩膀说道：这位" + me->query("name") + "(" + me->query("id") + ")为国杀敌，不错不错！\n" NOR,
      this_object(),
      me
    );
    job_exp = ((int)me->query_temp("killed_mgb")) * (120000 + random(100000) + me->query("xyzx_sys/level") * 20) * (renwu_exp_add + 100) / 100;
    if (job_exp > 1000000000) job_exp = 1000000000;
    if (job_exp < 10000) job_exp = 10000;
    job_pot = job_exp / 10;
    job_sco = (200 + random(200)) * (renwu_exp_add + 100) / 100;
    me->add("combat_exp", job_exp);
    me->add("potential", job_pot);
    me->add("score", job_sco);
    tell_object(
      me,
      "你被奖励了" + HIW + chinese_number(job_exp * me->query_exp_times()) + NOR "点经验值和" + HIW + chinese_number(job_pot) + NOR "点潜能和" + HIW + chinese_number(job_sco) + NOR "点江湖阅历。\n"
    );
    tell_object(
      me,
      "你本次得到了" + job_exp * me->query_exp_times() + "点经验和" + job_pot + "点潜能和" + job_sco + "点阅历\n"
    );
    me->add("renwu/quanzhou_kangwo", 1);
    me->delete_temp("killed_mgb");
    me->delete_temp("job_over");
    me->delete_temp("mark/job_shadi");
    me->delete_temp("help_killed");
    me->delete_temp("start_job");
    me->delete_temp("qi_job");
    me->start_busy(3);
    me->apply_condition("guojob2_busy", 1);
    return 1;
  }

  if (me->query_temp("mark/job_shadi") == 0) {
    message_vision(CYN "$N瞧了$n一眼：没任务还什么完成不完成。\n", this_object(), me);
    //		me->delete_temp("killed_mgb");
    me->delete_temp("start_job");
    return 1;
  }

  if (me->query_temp("job_over") == 0) {
    message_vision(CYN "$N瞧了$n一眼：任务还没完成，还不赶快回到你的岗位上去。\n" NOR, this_object(), me);
    //		me->delete_temp("killed_mgb");
    me->delete_temp("start_job");
    return 1;
  }

  if (me->query_temp("killed_mgb") < 2) {
    message_vision(CYN "$N瞧了$n一眼：你杀了几个敌人，你还来领赏？还不赶快回到你的岗位上去。\n" NOR, this_object(), me);
    //		me->delete_temp("killed_mgb");
    me->delete_temp("job_over");
    me->delete_temp("start_job");
    return 1;
  }

  message_vision(
    CYN "$N对$n说道：这位" + me->query("name") + "(" + me->query("id") + ")辛苦了，去休息一下吧！\n" NOR,
    this_object(),
    me
  );
  job_exp = ((int)me->query_temp("killed_mgb")) * (120000 + random(100000) + me->query("xyzx_sys/level") * 20) * (renwu_exp_add + 100) / 100;
  if (job_exp > 10000000000) job_exp = 10000000000;
  if (job_exp < 100000) job_exp = 100000;
  job_pot = job_exp / 10;
  job_sco = (200 + random(200)) * (renwu_exp_add + 100) / 100;
  me->apply_condition("guojob2_busy", 1);
  me->add("combat_exp", job_exp);
  me->add("potential", job_pot);
  me->add("score", job_sco);
  tell_object(
    me,
    "你被奖励了" + HIW + chinese_number(job_exp * me->query_exp_times()) + NOR "点经验值和" + HIW + chinese_number(job_pot) + NOR "点潜能和" + HIW + chinese_number(job_sco) + NOR "点江湖阅历。\n"
  );
  tell_object(
    me,
    "你本次得到了" + job_exp * me->query_exp_times() + "点经验和" + job_pot + "点潜能和" + job_sco + "点阅历\n"
  );
  me->add("renwu/quanzhou_kangwo", 1);
  me->delete_temp("job_over");
  me->delete_temp("mark/job_shadi");
  me->delete_temp("start_job");
  me->delete_temp("killed_mgb");
  me->delete_temp("qi_job");
  me->start_busy(3);
  flag = 1;
  xingyun = 0;
  if (me->query("xyhy_type") == 2) flag = 5 / 4;
  if (me->query_temp("wupin_max_add")) xingyun = (int)me->query_temp("wupin_max_add", 1);  //处于幸运状态时
  k1 = 150 * flag * (100 + xingyun) / 100;  //物品爆率
  //2018.3.20阿飞改，第4版不爆下列装备
  /*	if ( 1000 < k1 )
	{
		if (random(4)==0)
		{
			baoshi = new("/clone/tzbox/one-box");
		} else if (random(4)==1)
		{
			baoshi = new("/clone/tzbox/wp1-box");
		} else if (random(4)==2)
		{
			baoshi = new("/clone/map/obj/youhua-fu");
		} else
		{
			baoshi = new(random_item2[random(sizeof(random_item2))]);
		}
		tell_object(me, "你获得了一"+baoshi->query("unit")+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR"。\n");	
		message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在"HIR"抗倭任务"HIM"时奖励了 "HIM+baoshi->query("unit")+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
		baoshi->move(me);
	}
*/

  if (random(40) == 0) {
    message("channel:chat", HIB "【泉州战报】" HIW + "一队宋军伤兵，退到了泉州城中心附近!\n" NOR, users());
    if (objectp(room = load_object("/d/quanzhou/nanmen")) &&
      objectp(badguy = new("/quest/kangwo/menggu/songbing")))
      badguy->move(room);
    room = load_object("/d/quanzhou/beimen");
    badguy = new("/quest/kangwo/menggu/songbing");
    badguy->move(room);
    room = load_object("/d/quanzhou/xijie");
    badguy = new("/quest/kangwo/menggu/songbing");
    badguy->move(room);
  } else if (random(40) == 1) {
    message("channel:chat", HIB "【泉州战报】" HIW + "一队倭寇精兵，冲进了泉州城附近!\n" NOR, users());
    if (objectp(room = load_object("/d/quanzhou/qzroad5")) &&
      objectp(badguy = new("/quest/kangwo/menggu/mengu2")))
      badguy->move(room);
    room = load_object("/d/quanzhou/qzroad4");
    badguy = new("/quest/kangwo/menggu/mengu2");
    badguy->move(room);
    room = load_object("/d/quanzhou/qzroad3");
    badguy = new("/quest/kangwo/menggu/mengu2");
    badguy->move(room);
    room = load_object("/d/quanzhou/huangye");
    badguy = new("/quest/kangwo/menggu/mengu3");
    badguy->move(room);
  } else if (random(40) == 2) {
    message("channel:chat", HIB "【泉州战报】" HIW + "一大队倭寇武士，冲进了泉州城附近!\n" NOR, users());
    if (objectp(room = load_object("/d/quanzhou/qzroad5")) &&
      objectp(badguy = new("/quest/kangwo/menggu/mengu1")))
      badguy->move(room);
    room = load_object("/d/quanzhou/qzroad4");
    badguy = new("/quest/kangwo/menggu/mengu1");
    badguy->move(room);
    room = load_object("/d/quanzhou/qzroad3");
    badguy = new("/quest/kangwo/menggu/mengu1");
    badguy->move(room);
    room = load_object("/d/quanzhou/qzroad2");
    badguy = new("/quest/kangwo/menggu/mengu1");
    badguy->move(room);
    room = load_object("/d/quanzhou/qzroad1");
    badguy = new("/quest/kangwo/menggu/mengu1");
    badguy->move(room);
    room = load_object("/d/quanzhou/huangye");
    badguy = new("/quest/kangwo/menggu/mengu1");
    badguy->move(room);
  } else if (random(40) == 3) {
    message("channel:chat", HIB "【泉州战报】" HIW + "有几名倭寇奸细，混进了泉州城附近!\n" NOR, users());
    if (objectp(room = load_object("/d/quanzhou/haigang")) &&
      objectp(badguy = new("/quest/kangwo/menggu/mengu4")))
      badguy->move(room);
    room = load_object("/d/quanzhou/jxnanmen");
    badguy = new("/quest/kangwo/menggu/mengu4");
    badguy->move(room);
  }

  return 1;
}

string ask_newover() {
  object me;
  me = this_player();
  if (me->query_condition("jobshadi_limit") <= 1)
    return "你没有领任务,跑这里瞎嚷嚷什麽?";
  me->clear_condition("jobshadi_limit");
  me->add("combat_exp", -100 + random(20));
  me->apply_condition("jobshadi_failed", 10);
  me->delete_temp("mark/job_shadi");
  me->delete_temp("carry_location");
  me->delete_temp("job_over");
  me->delete_temp("start_job");
  return "没关系,下次继续努力 。";
}
