// pi.c 裨将 玄武内门
#include <ansi.h>
inherit NPC;


void create() {
  int jibie;
  jibie = 150;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 1);
  set_name("裨将", ({ "pi jiang", "pi", "jiang" }));
  set("gender", "男性");
  set("age", random(10) + 30);
  set("str", 25);
  set("dex", 16);
  set("long", "这是一个大宋年轻将领，满脸征尘。\n");
  set("combat_exp", 45000);
  set("attitude", "peaceful");
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/armor", 50);
  set_temp("apply/damage", 30);
  set("neili", 400);
  set("max_neili", 400);
  set("jiali", 10);

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/armor/tiejia")->wear();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  int killer;
  if (!ob || environment(ob) != environment()) return;
  if (ob->query_temp("job_over") == 1) {
    say("裨将拱手说道：这位" + ob->query("name") + "(" + ob->query("id") + ")你已经可以回去复命了。\n");
    return;
  }
  killer = (int)ob->query_temp("help_killed") + (int)ob->query_temp("killed_mgb");
  if (random(killer) >= 10) {
    say("裨将拱手说道：这位" + ob->query("name") + "(" + ob->query("id") + ")杀敌有功，可以回去复命了。\n");
    ob->set_temp("job_over", 1);
    return;
  }
  if (ob->query_temp("start_job") == 1) {
    say("裨将皱了皱眉：这位" + RANK_D->query_respect(ob) + "，你还是安心抗倭吧。\n");
  } else if (ob->query_temp("mark/job_shadi") == 1) {
    say("裨将拱手说道：这位" + RANK_D->query_respect(ob) + "，你来得正是时候，日本倭寇已经快攻上城了。\n");
    ob->apply_condition("jobshadi_limit", 5 + random(5));
    ob->set_temp("start_job", 1);
    ob->set_temp("where", environment(ob));
    call_out("to_rob", 10, ob);
  }
}

void to_rob(object ob) {
  object *target, robber, room;
  if (!ob) return;
  target = users();
  room = environment(ob);
  if (ob->query_temp("start_job") == 0)
    return;
  if (environment(ob)->query("short") == "玄武内门") {
    robber = new(__DIR__ "robber1");
    robber->do_change(ob);
    robber->move(room);
    message_vision(HIR "突然城下爬上来一个倭寇兵士。\n" NOR, ob);
    robber->kill_ob(ob);
    ob->kill_ob(robber);
  }
}


//2018.2.28阿飞改，添加不死代码，防止任务NPC被捣乱
void unconcious() {
  reincarnate();
  set("eff_qi", query("max_qi"));
  set("qi", query("max_qi"));
  set("eff_jing", query("max_jing"));
  set("jing", query("max_jing"));
  set("neili", query("max_neili"));
  set("jingli", query("max_jingli"));
  say(HIM "裨将笑着说：保卫泉州，人人有责！宋皇特赦我等免死金牌。\n" NOR);
  command("hehe");
}
void die() {
  unconcious();
}
