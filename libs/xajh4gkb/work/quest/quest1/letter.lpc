
inherit ITEM;

void create()
{
	set_name("信件", ({"xin jian", "letter"}));
	set("long","这是驿卒托付你的信件。\n");
	set("unit", "封");
	set("weight", 5);
//	set("no_drop", 1);
	set("no_get", 1);

	setup();
}
void owner_is_killed() { destruct(this_object()); }
int query_autoload() { return 1; }
void init()
{
	add_action("do_give", "give");
}

int do_give(string arg)
{
	object me,ob;
	string obj,target;
	int exp,pot,sco,huiyuan,addtime,renwu_exp_add;
	if(!arg || arg==" ") return 0;
	if (sscanf(arg,"%s to %s", obj, target)!=2 )
	if(sscanf(arg,"%s %s", target, obj) !=2 )       
	return 0;
	if(!id(obj) )   return 0;

	me = this_player();

	if(!ob = present(target,environment(me)) ) 
	{
		tell_object(me,"你想要把信交给谁？\n");
		return 1;
	}
	if( ob->query("name") != query("owner"))
	{
		tell_object(me, "你不能把信交给这个人。\n");
		return 1;
	}
	if(!living(ob) ) 
	{
		tell_object(me,ob->query("name")+"已经无法收下这样东西了。\n");
		return 1;
	}
	if(me->query("xyhy_type")==2) huiyuan = 5/4;	//黄金会员打坐增加技能熟练度1.25倍
		else huiyuan = 1;
	if ( me->query_exp_times() > 1 ) addtime = 2;
		else addtime = 1;	
	if (me->query_temp("renwu_exp_add")) renwu_exp_add = (int)me->query_temp("renwu_exp_add",1);	//处于任务经验提升状态时
		else renwu_exp_add = 0;	
	message("vision",me->name()+"拿出一封信交给了" + ob->name() + "。\n", environment(me),({ me, ob }));
	if((int)time() > me->query_temp( "xin_quest/task_time" ) ) 
	{
		tell_object(me,ob->name()+"拿起信看了看，生气地瞪了你一眼。\n");
		tell_object(me, "你没有及时把信送到" + ob->query("name") + "的手中，你的任务失败了！\n");
	} else 
	{
		tell_object(me,ob->name()+"说道：多谢，多谢！\n");
		tell_object(me, "你成功地把信送到了" + ob->name() + "的手中。\n");
		exp = (me->query_temp("xin_quest/exp"))*huiyuan*addtime*(renwu_exp_add+100)/100;
		pot = (me->query_temp("xin_quest/pot"))*huiyuan*addtime*(renwu_exp_add+100)/100;
		sco = (me->query_temp("xin_quest/sco"))*huiyuan*addtime*(renwu_exp_add+100)/100;
		me->add("combat_exp", exp);
		me->add("potential",pot);
		me->add("score", sco);
		tell_object(me, sprintf(WHT"你获得了%s点战斗经验！\n"NOR, chinese_number(exp)) );
		tell_object(me, sprintf(WHT"%s点潜能\n"NOR, chinese_number(pot)) );
		tell_object(me, sprintf(WHT"%s点阅历\n"NOR, chinese_number(sco)) );
		me->add("renwu/duzhai_songxin",1);
//2018.4.28阿飞添加  五一劳动节活动--运镖任务10次
		if ((int)me->query("jieri_gift/laodong")==1) me->add_temp("laodong/songxin",1);
		if ((int)me->query_temp("laodong/songxin")>=10 )
		{
			me->set_temp("laodong/songxin",10);
			tell_object(me, HIW"你在五一劳动节期间，爱岗敬业争创一流，勤勉可嘉！\n"NOR);
		}
		me->delete_temp("xin_quest");
	}
	me->receive_damage("qi", 30);
	me->receive_damage("jing", 30);
	destruct(this_object());
	return 1;
}