#include <ansi.h>
#define QUEST_SHA "/quest/quest1/quest"
inherit NPC;
inherit F_MASTER;
int time_period(int timep, object me);
int give_quest();
void create()
{
	int jibie;
	jibie = 100;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
	set_name("杜窄", ({ "du zhai", "post","officer" }) );
	set("long",
                "杜窄担任泰山镇的驿使已经有十几年了，虽然期间有几次升迁的\n"
                "机会，但是他都因为舍不得离开而放弃了，这次应阿飞的邀请，\n"
                "终于走出死宅，来到这里当驿站使长，阿飞对他很是感激。\n");
	set("gender", "男性");
	set("title", "驿使");
	set("attitude", "friendly");
	set("class", "bonze");
	set("age", 20);
	set("shen_type", 0);
	set("str", 20);
	set("int", 20);
	set("con", 20);
	set("dex", 20);
	set("max_qi", 4500);
	set("max_jing", 3000);
	set("neili", 2500);
	set("max_neili", 2500);
	set("jiali", 50);
	set("combat_exp", 30000000);
	set("score", 10000);
	set("env/wimpy", 10000);
	set("inquiry", ([
               "送信" :(: give_quest :),
        ]) );
	set("no_get", 1);

	set_skill("force", 100+jibie/5+random(jibie/10));
	set_skill("dodge", 100+jibie/5+random(jibie/10));
	set_skill("unarmed", 100+jibie/5+random(jibie/10));
	set_skill("parry", 100+jibie/5+random(jibie/10));
	setup();
	carry_object("/clone/cloth/cloth")->wear();
}


int give_quest()
{
	mapping quest ;
	object me,letter;
	int timep;

	me = this_player();
	if((int)me->query("xyzx_sys/level",1) >= 100000)
	{
		message_vision("杜窄对$N说：您已是武林高手了，这种小事怎敢劳您大驾？！\n",me);
		return 1;
	}
	if(me->query_temp("xin_quest"))
	{
		if( ((int)me->query_temp("xin_quest/task_time")) >  (int)time() )
		{
			tell_object(me,"你现在的任务是把信送给"+me->query_temp("xin_quest/name")+"\n");
			message_vision("杜窄对$N说：你得把信帮我送到呀。\n", me);
			return 1;
		}
	}

	message_vision(HIG"杜窄对$N说：你来得正好，我这儿刚好有一批信件要送出去。\n"NOR,me);

	quest = QUEST_SHA->query_quest();
	timep = quest["time"];
	time_period(timep, me);
	tell_object(me, "把信送给『" + quest["quest"] + "』你的任务就完成了。\n" NOR);
	message_vision("$N给了$n一封信。\n",this_object(),me);
	letter = new("/quest/quest1/letter");
	letter->set("owner",quest["quest"]);
	letter->move(me);
	me->set_temp("xin_quest", 1);	
	me->set_temp("xin_quest/name", quest["quest"]);
	me->set_temp("xin_quest/exp", quest["exp_bonus"]*100);
	me->set_temp("xin_quest/pot", quest["pot_bonus"]*100);
	me->set_temp("xin_quest/sco", quest["score"]);
	me->set_temp("xin_quest/task_time", (int)time() + timep);
	return 1;
}

int time_period(int timep, object me)
{
	int t, d, h, m, s;
	string time;
	t = timep;
	s = t % 60;             t /= 60;
	m = t % 60;             t /= 60;
	h = t % 24;             t /= 24;
	d = t;

	if(d) time = chinese_number(d) + "天";
	else time = "";
	if(h) time += chinese_number(h) + "小时";
	if(m) time += chinese_number(m) + "分";
	time += chinese_number(s) + "秒";

	tell_object(me, HIW "杜窄说道：\n在" + time + "内");
	return 1;
}

