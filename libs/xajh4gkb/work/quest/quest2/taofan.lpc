// rentou.c

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIG"扬州逃犯"NOR, ({"yangzhou taofan", "taofan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("value", 0);
				set("long", "他就是扬州知府正在追捕的逃犯。\n");
        }
        setup();
}


int query_autoload() { return 1; }