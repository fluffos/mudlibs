inherit NPC;
string *first_name = ({ "郑","王","张","陈","金","姑苏","钱","孙","李","周","吴","刘","林" });
string *first_id = ({"zhen","wang","zhang","chen","jin","gusu","qian","sun","li","zhou","wu","liu","lin",});
string *name_boy = ({ "志","忠","良","大","彦","勇","元","华","宏","孝","雄","龙","明","文","武","斌","来","胜","进","铭","彬","东","伟" });
string *boy_id = ({"zhi","zhong","liang","da","yan","yong","yuan","hua","hong","xiao","xiong","long","ming","wen","wu","bin","lai","sheng","jin","ming","bing","dong","wei",});
string *name_girl = ({ "英","媚","珍","华","盈","小","红","婷","娴","宛","妙","娟","如","絮","妲","妮","妹","姑","芳","芬","香" });
string *girl_id = ({"ying","mei","zhen","hua","yin","xiao","hong","ting","xian","wan","miao","juan","ru","xu","da","ni","mei","gu","fang","fen","xiang",});
void create()
{
	string name, id;
	int jibie,index,index1,index2;

	index = random(sizeof(first_name));	
	name = first_name[index];
	id = first_id[index];
	jibie = 200;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
	if (random(2)==1)
	{
		set("gender", "男性");		
		index1 = random(sizeof(name_boy));
		index2 = random(sizeof(name_boy));
		name += name_boy[index1];
		id += " "+boy_id[index1];
		name += name_boy[index2];
		id += boy_id[index2];
	} else
	{
		set("gender", "女性");		
		index1 = random(sizeof(name_girl));
		index2 = random(sizeof(name_girl));
		name += name_girl[index1];
		id += " "+girl_id[index1];
		name += name_girl[index2];
		id += girl_id[index2];
	}

	set_name(name, ({ id, "taofan", "zei" }) );
	set("age", random(30)+14);
	set("long", name+"朝廷钦犯，一脸凶煞之相，刚从扬州监狱逃出来。\n"); 
	set("title", "衙门逃犯");
    set("attitude", "heroism");
    set("class", "taoist");
    set("str", 21);
    set("con", 30);
    set("int", 27);
	set("quest_zhuibu_yamen", 1);
    set("dex", 23);
    set("max_qi", 1200);
    set("max_jing", 500);
    set("neili", 4000);
    set("max_neili", 2000);
	set("no_suck",1);
    set("jiali", 60);
    set("shen_type", -1);
    set("no_suck",1);
    set("env/wimpy", 70);
    set_temp("apply/attack",  10);
    set_temp("apply/defense", 20);
    set("combat_exp", 200000);
    set_skill("force", 100+jibie/5+random(jibie)/10); 
    set_skill("unarmed", 100+jibie/5+random(jibie)/10);
    set_skill("sword", 100+jibie/5+random(jibie)/10);
    set_skill("dodge", 100+jibie/5+random(jibie)/10);
    set_skill("parry", 100+jibie/5+random(jibie)/10);
    set_skill("taiji-quan", 100+jibie/5+random(jibie)/10); 
    set_skill("taiji-jian", 100+jibie/5+random(jibie)/10); 
    set_skill("taiji-shengong", 100+jibie/5+random(jibie)/10); 
    set_skill("tiyunzong", 100+jibie/5+random(jibie)/10);
    map_skill("force", "taiji-shengong");
    map_skill("unarmed","taiji-quan");
    map_skill("parry", "taiji-quan");
    map_skill("sword", "taiji-jian");
    map_skill("dodge", "tiyunzong");
    set("chat_chance", 8);
    set("chat_msg", ({
        (: random_move :)
    }) );
    setup();
    carry_object("/clone/weapon/gangjian")->wield();
    carry_object("/clone/cloth/cloth")->wear();
    add_money("silver",20);
        
}
void init()
{
    object ob, me;
    me = this_object();
    ob = this_player();
    ::init();
	::init();	
	// 怪物必须是可以动作的，并只针对玩家
	if ( !objectp(ob) || !living(me) || !playerp(ob) ) return;
    // 见面就打
	me->kill_ob(ob);
}

void die()
{
    object ob, me;        
    me = query_temp("last_damage_from");
	if (me && me->query_temp("zhuibu_renwu") && me->query_temp("zhuibu_renwu/quest_id")==this_object()->query("id"))
	{//雪山寺解密
        ob = new("/quest/quest2/taofan");
//		ob->set("name","朝廷逃犯");
//		ob->set("id",this_object()->query("id"));
		ob->set_name("钦犯 "+this_object()->query("name"), ({ this_object()->query("id"), "taofan" }) );
        ob->move(environment(this_object()));
		me->set_temp("zhuibu_renwu/num",3+random(6));
	}

	::die();
}