#include "where.h"


string ask_job()
{ 
  object  ob, me,obj;
  int exp,i;
  mapping target;
  string str;
  ob=this_player();
  me=this_object();
  exp=ob->query("combat_exp");
	if (interactive(ob) && (int)ob->query_condition("huang_mission"))  
		return "这位"+ob->query("name")+"("+ob->query("id")+")，你上一次的任务还没完成!";
	if (interactive(ob) && (int)ob->query_condition("huang_busy"))  
		return "这位"+ob->query("name")+"("+ob->query("id")+")，现在我可没有给你的任务，等会再来吧。\n";
	if ( time() - ob->query_temp("huang_cd") < 20 )
		return "这位"+ob->query("name")+"("+ob->query("id")+")，你还是休息会再领取任务吧。\n";
	if(exp<=100000)     
		return "这位"+ob->query("name")+"("+ob->query("id")+")，你的武功太差了,等练强了再来吧。\n";
    
	target = wheres[random(sizeof(wheres))];
    for(i=100;i*i*i/10<=exp;i++);//i=maxpot
	//obj=new(__DIR__"killer1");
	if(random(10)>7)
	{obj=new(__DIR__"skiller"+sprintf("%d",random(3)+1));
	 i=i+10+random(10);
	 obj->do_copy(ob,i);
	 obj->set("title",HIR"江南一霸"NOR);
	 ob->set_temp("huang_job_super",1);
	}
	else
	{ obj=new(__DIR__"killer");
	  i=i-random(10);
	  obj->do_copy(ob,i);
	}
	obj->move(target["weizhi"]);
	obj->set_temp("must_killby",ob->query("id")); 
    ob->set_temp("huang_job_target", target["chinese"]);//where
    ob->apply_condition("huang_mission",20);
	ob->set_temp("huang_cd",time()); //2018.6.17阿飞改，添加黄蓉任务CD，其他哪种CD有漏洞
	command("nod");
	str="这位"+ob->query("name")+"("+ob->query("id")+")，我掐指算出有人在『"+target["chinese"]+"』一带行凶作恶。";
	command("say "+str);
    return "这位"+ob->query("name")+"("+ob->query("id")+")，你去巡视一下。";
	
}

int accept_object(object who, object ob,object me)
{
        if ( ob->query("id") != "corpse") {
                command("say 你给我这个干吗?");
                return 0;
        }
        if ( !who->query_temp("huang_job_target") ) {
                command("say 好啊！不过你得先申请任务。");
                return 0;
        }
	       	if (ob->query_temp("must_killby")!= who->query("id")
			||ob->query("victim_user")||who->query_temp("huang_given") )
		{       command("shake");
                command("say 你杀错人了。");
                return 0;
        } 

  /*      if ( ob->query("kill_by") != who) {
                command("say 这个任务似乎不是你自己完成的吧？");
                return 0;
        }
*/      who->set_temp("huang_given",1);
        call_out("destroying", 1, ob);
        call_out("ok", 1, who);
        return 1;
}

void ok(object who)
{
        int exp,pot,sco,renwu_exp_add,count,i;
        if (!who) return;
        command("pat" + who->query("id"));
        command("say 做的好，加油干!");
		renwu_exp_add = 0;
		if (who->query_temp("renwu_exp_add")) renwu_exp_add = (int)who->query_temp("renwu_exp_add",1);	//处于任务经验提升状态时		
        if(!who->query_temp("huang_job_count"))
		who->set_temp("huang_job_count",1);
        else
		who->add_temp("huang_job_count",1);        
		count=who->query_temp("huang_job_count");
		for(i=0;i*i<count;i++);
		exp=(20000+i*((int)who->query("xyzx_sys/level", 1))*5)*who->query_exp_times()*(renwu_exp_add+100)/100;
        if(who->query_temp("huang_job_super"))
        {
		exp+=100000;
		who->delete_temp("huang_job_super");
		}
		pot=exp/10+random(10000);
		sco=30*(renwu_exp_add+100)/100;
        who->add("combat_exp",exp);
		who->add("potential",pot);
		who->add("score",sco);
        who->clear_condition("huang_mission");
		who->delete_temp("huang_job_target");
        who->delete_temp("huang_given");
		who->apply_condition("huang_busy",3+random(4));
		
        tell_object(who,HIW"你被奖励了：" + chinese_number(exp) + "点实战经验，" +chinese_number(pot) + "点潜能，"+chinese_number(sco) + "点阅历。\n"+NOR);
		tell_object(who,"你本次得到了："+ exp +"点实战经验，"+ pot +"点潜能，"+ sco +"点阅历。\n"+NOR);
		who->add("renwu/huang_jiaofei",1);
//2018.5.28阿飞添加  端午节活动--剿匪任务10次
		if ((int)who->query("jieri_gift/duanwu")==1) who->add_temp("duanwu/jiaofei",1);
		if ((int)who->query_temp("duanwu/jiaofei")>=10 )
		{
			who->set_temp("duanwu/jiaofei",10);
			tell_object(who, HIW"你在端午节期间，缉拿盗匪保境安民，勤勉可嘉！\n"NOR);
		}		
        return;
}


void destroying(object obj)
{
        destruct(obj);
        return;
}

string ask_fangqi()
{
         object me;
         me = this_player();
         if(!me->query_temp("huang_job_target"))
         return "你没有领任务,跑这里瞎嚷嚷什麽?";
         me->add("combat_exp",-80+random(20));
       //me->apply_condition("huang_busy",4+random(4));
         me->delete_temp("huang_job_target");
	     return "没关系,下次继续努力 。";
}

string ask_gonglao(object who)
{
  object me;
  int i;
           
  me = this_player();
  if(!me->query_temp("huang_job_count"))
  i=0;
  else 
  i =(int)me->query_temp("huang_job_count"); 
  message_vision(CYN"$N对$n说道:你已经完成了" + chinese_number(i) + "次任务。\n"NOR,who,me);
  return "继续努力吧！";
}
