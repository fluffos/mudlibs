#include <ansi.h> 
inherit NPC;
 
void create()
{
	int jibie;
	jibie = 120;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
    set("shen_type", -1);
	set_name("土匪", ({ "tu fei","fei"}));
	set("gender", "男性");
	set("age", 66);
	set("attitude", "peaceful");

	set("str", 30);
	set("int", 30);
	set("con", 25);
	set("dex", 27);
	
	set("max_qi", 2500);
	set("max_jing", 2500);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jingli", 3000);
	set("max_jingli", 3000);
	set("jiali", 100);
	set("combat_exp", 10000);

         set_skill("force", 500+jibie/3+random(jibie/5));
         set_skill("canhe-zhi", 500+jibie/3+random(jibie/5));
         set_skill("dodge", 500+jibie/3+random(jibie/5));
         set_skill("murong-jianfa", 500+jibie/3+random(jibie/5));
         set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("yanling-shenfa", 500+jibie/3+random(jibie/5));
        set_skill("unarmed", 500+jibie/3+random(jibie/5));
        set_skill("shenyuan-gong", 500+jibie/3+random(jibie/5));
        set_skill("literate", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
		set_skill("douzhuan-xingyi", 500+jibie/3+random(jibie/5));

        map_skill("force", "shenyuan-gong");
        map_skill("dodge", "yanling-shenfa");
        map_skill("unarmed", "canhe-zhi");
        map_skill("sword", "murong-jianfa");
		map_skill("parry", "douzhuan-xingyi");
        set_temp("apply/attack", 20);
        set_temp("apply/defense",50);
        set_temp("apply/armor", 50);
        set_temp("apply/damage", 220);
 
 
        setup(); 
        carry_object("/clone/cloth/cloth")->wear();
        carry_object("/clone/weapon/changjian")->wield(); 
        add_money("gold", 1);
}
#include "killer.h"
