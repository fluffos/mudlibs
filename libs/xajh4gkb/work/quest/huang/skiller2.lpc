#include <ansi.h>

inherit NPC;

void create() {
  int jibie;
  jibie = 120;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22????NPC??	
  set("shen_type", -1);
  set_name("强盗", ({ "robber" }));

  set("gender", "男性");
  set("age", 56);
  set("attitude", "peaceful");

  set("str", 35);
  set("int", 20);
  set("con", 35);
  set("dex", 27);

  set("max_qi", 2500);
  set("max_jing", 2500);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jingli", 3000);
  set("max_jingli", 3000);
  set("jiali", 120);
  set("combat_exp", 10000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jingang-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xiuluo-dao", 500 + jibie / 3 + random(jibie / 5));



  map_skill("parry", "xiuluo-dao");
  map_skill("blade", "xiuluo-dao");
  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("unarmed", "jingang-quan");
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 50);
  set_temp("apply/armor", 50);
  set_temp("apply/damage", 220);


  setup();
  carry_object("/clone/weapon/gangdao")->wield();
  carry_object("/clone/cloth/cloth")->wear();
  add_money("gold", 1);
}
#include "killer.h"
