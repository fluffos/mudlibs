#include <ansi.h>
inherit NPC;

int do_copy(object me,int flag);
int do_back(object me);

void create()
{        
	string weapon;
	int jibie;
	jibie = 120;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
    set("shen_type", -1);	

        set_name("土匪", ({ "tu fei","fei"}));
        set("gender", "男性");
        set("age", random(20) + 25);
        set("str", 23);
        set("con", 26);
        set("int", 20);
        set("dex", 23);
        set("long", "一个满脸横肉的家伙。\n");
		set("max_qi", 1500);
		set("max_jing", 1500);
		set("neili", 3000);
		set("max_neili", 3000);
		set("jingli", 3000);
		set("max_jingli", 3000);
		set("jiali", 100);
        set("combat_exp", 80000 + random(40000)); 
        set("attitude", "friendly");
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("unarmed", 500+jibie/3+random(jibie/5));
        set_skill("blade", 500+jibie/3+random(jibie/5));
        set_skill("taizu-quan", 500+jibie/3+random(jibie/5));
        set_skill("qingmang-jian", 500+jibie/3+random(jibie/5)); 
        set_skill("wind-blade", 500+jibie/3+random(jibie/5));
		set_skill("yijing-force", 500+jibie/3+random(jibie/5));
		set_skill("shenxing-baibian", 500+jibie/3+random(jibie/5));
        map_skill("blade", "wind-blade");
        map_skill("parry", "taizu-quan");	
        map_skill("dodge", "shenxing-baibian");
        map_skill("sword", "qingmang-jian");
        map_skill("unarmed", "taizu-quan");
		map_skill("force", "yijing-force");
       
        set_temp("apply/attack", 20);
        set_temp("apply/defense",50);
        set_temp("apply/armor", 50);
        set_temp("apply/damage", 220);


        set("max_qi", 450); 
        set("eff_jingli", 400); 
        set("neili", 700); 
        set("max_neili", 700);
        set("jiali", 30);
        weapon = random(2)?"/clone/weapon/gangdao":"/clone/weapon/gangjian";
        setup();
        carry_object(weapon)->wield();
        carry_object("/clone/cloth/cloth")->wear();
}

#include "killer.h"