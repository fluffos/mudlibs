#include <ansi.h>
inherit NPC;
string do_quest();

void create() {
  int jibie;
  jibie = 1000;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("郭旭", ({ "guo xu", "guo" }));
  set("gender", "男性");
  set("nickname", "长风镖局");
  set("age", 31);
  set("long", "他是长风镖局的少局主郭旭，江湖上他的朋友甚多，所以出镖都很安全。\n");
  set("str", 29);
  set("dex", 26);
  set("con", 24);
  set("int", 22);
  set("per", 38);
  set("shen", 7500);
  set("max_qi", 2000);
  set("max_jing", 2000);
  set("neili", 2000);
  set("max_neili", 2000);
  set("combat_exp", 1000000);
  set_skill("blade", 100 + jibie / 5 + random(jibie) / 10);
  set_skill("zixia-shengong", 100 + jibie / 5 + random(jibie) / 10);
  set_skill("fanliangyi-dao", 100 + jibie / 5 + random(jibie) / 10);
  map_skill("blade", "fanliangyi-dao");

  set("inquiry", ([
    "保镖": (: do_quest :),
  ]));

  setup();
  carry_object("/clone/weapon/gangdao")->wield();
  carry_object("/clone/cloth/cloth")->wear();
  add_money("gold", 20);
}

//新的运镖任务
string chinese_time(int t) {
  int d, h, m, s;
  string time;

  s = t % 60;
  t /= 60;
  m = t % 60;
  t /= 60;
  h = t % 24;
  t /= 24;
  d = t;

  if (d) time = chinese_number(d) + "天";
  else time = "";
  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";
  return time;
}

string do_quest() {
  mapping target = ([
    "ben yin": "天龙寺主持 本因",
    "chen jinnan": "云龙门开山祖师「英雄无敌」陈近南",
    "chen mapo": "麻婆豆腐创始人「豆腐西施」陈麻婆",
    "ding chunqiu": "星宿派开山祖师「星宿老怪」丁春秋",
    "guan anji": "茶馆老板「关夫子」关安基",
    "hong antong": "神龙教教主 洪安通",
    "huang yaoshi": "桃花岛主「东邪」黄药师",
    "jia laoliu": "当铺老板 贾老六",
    "jiang baisheng": "亲兵队长 江百胜",
    "jian zhanglao": "丐帮九袋长老「执法长老」简长老",
    "lazhang huofo": "活佛 拉章活佛",
    "li defa": "药铺老板 李得发",
    "li lishi": "屠宰场老板 李力世",
    "li mochou": "「赤练仙子」李莫愁",
    "lu youjiao": "丐帮九袋长老「掌棒龙头」鲁有脚",
    "mo yixin": "药铺老板 莫一心",
    "ouyang feng": "老毒物「西毒」欧阳锋",
    "ouye zi": "「赤心剑胆」欧冶子",
    "ping yizhi": "药铺老板 平一指",
    "post officer": "驿长杜宽",
    "shi wei": "侍卫",
    "song yuanqiao": "武当派第二代弟子「武当首侠」宋远桥",
    "tai jian": "太监",
    "tang nan": "当铺老板 唐楠",
    "wei yixiao": "明教青翼蝠王 韦一笑",
    "wu liuqi": "天地会洪顺堂香主「铁丐」吴六奇",
    "xuan zhen": "云龙门第二代弟子 玄真道长",
    "xu zhu": "灵鹫宫掌门人「梦郎」虚竹",
    "you xun": "「滑不留手」游讯",
    "yuan chanshi": "昭觉寺主持 圆觉禅师",
    "yue buqun": "华山派现任掌门「君子剑」岳不群",
    "yu lianzhou": "武当派第二代弟子「武当二侠」俞莲舟",
    "zhaixing zi": "星宿派第二代弟子「星宿派大师兄」摘星子",
    "zhang sanfeng": "武当派开山祖师「邋遢真人」张三丰",
    "zhang wuji": "明教教主 张无忌",
  ]);

  int ran, t, time;
  string *str;
  object ob, who, home;

  ob = this_object();

  if (!home = find_object(ob->query("startroom")))
    home = load_object(ob->query("startroom"));
  if (environment(ob) != home) {
    return ("我现在正忙着呢！等我回去再说吧！");
  }

  who = this_player();
  if (who->query("xyzx_sys/level") >= 100000)
    return (HIR "你已经不能通过运镖来进行磨练了，可以去试试守城。\n" NOR);
  if (who->query("xyzx_sys/level") < 100)
    return (HIR "以你目前的实力还不能让我放心，你还是先去试试打鸟吧。\n" NOR);

  t = time() - who->query("biao_start");
  time = who->query("biao_time");

  if (t <= time || who->query_temp("biaoyin_ob"))
    return RANK_D->query_respect(who) + "似乎还有任务在身吧？\n";
  if (t > time && t < (time + 300)) {
    if (ob = present("biao yin", who)) destruct(ob);
    who->set("biao_failed", 1);
  }
  if (t >= (time + 300)) who->delete("biao_failed");
  if (who->query("biao_failed")) {
    command("hehe " + who->query("id"));
    return this_player()->name() + "，看来你的名气不太好，我看还是不适宜运镖了。\n";
  }

  t = (20 + random(20)) * 10;
  str = keys(target);
  ran = random(sizeof(str));
  ob = new("/clone/misc/biaoyin2");
  ob->set("target", str[ran]);
  who->set("biao_start", time());
  who->set("biao_time", t);
  who->set_temp("biaoyin_ob", ob);  // 用来清除的
  ob->move(who);
  return (who->name(1) + "(" + who->query("id") + ")，你来得正好，现在有一趟镖运往" + target[str[ran]] + "的手里。\n" + "你还有" + chinese_time(t) + "的时间。路上要注意安全，不可有差错！\n");
}
int accept_object(object me, object obj) {
  object biaoyin;
  if (obj->query("money_id") && obj->value() >= 100000) {
    command("say 好吧！" + me->name() + "，上次的任务就算了！");
    me->delete("biao_start");
    me->delete("biao_time");
    if (objectp(biaoyin = me->query_temp("biaoyin_ob"))) {
      biaoyin->remove_robber();
      destruct(biaoyin);
    }
    me->delete_temp("biaoyin_ob");
    return 1;
  } else
    command("say ...喂....喂...！" + me->name() + "，要真有心孝敬老哥我，也该拿出点诚意来才行啊！");
  return 0;
}
