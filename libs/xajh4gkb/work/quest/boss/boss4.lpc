void create() {
  int i, index, jibie, num;
  mapping mp;
  string *basic = ({
    "poison",
    "force",
    "dodge",
    "parry",
    "unarmed",
    "hand",
    "finger",
    "strike",
    "magic",
    "spells",
    "cuff",
    "claw",
    "taoism",
    "sword",
    "blade",
    "club",
    "staff",
    "hammer",
    "throwing",
    "axe",
    "whip",
    "dagger",
    "spear",
    "fork",
    "stick"
  });
  index = random(sizeof(menpai));
  mp = menpai[index];
  jibie = 3000;
  num = random(sizeof(name_boss));
  seteuid(getuid());
  if (!query("id_set", 1)) {
    set_name(order[random(sizeof(order))] + name_boss[num] + NOR, ({ id_boss[num] }));
    set("id_set", 1);
  }
  set("title", HIM "一代霸主" NOR);
  set("gender", "男性");
  set("icon", "30006");
  set("age", random(30) + 20);
  set("long", "华夏历史上的著名皇帝，具有丰功伟绩，于历史时空中穿越重生，携带重宝。\n");
  set("attitude", "aggressive");
  set("class", "huangzu");
  //	set("is_boss", 1);	
  //	set("end_boss", 1);
  set("env/wimpy", 20);
  set("shen_type", 0);
  set("xyzx_sys/level", jibie * 9 / 10 + random(jibie * 2 / 10));  //2016.5.22阿飞调整NPC属性
  create_family("皇族", 1, "皇帝");

  if (!query("wugong", 1)) {
    if (mp["gender"]) set("gender", mp["gender"]);
    /*		if (mp["family"]) 
		{
			set("famile/family_name",mp["family"]);
			set("famile/generation",100);
		}*/
    if (mp["family"]) create_family(mp["family"], 100, "皇帝");
    for (i = 0; i < sizeof(keys(mp)); i++) {
      if (keys(mp)[i] == "knowledge") set_skill(
        mp[keys(mp)[i]],
        500 + jibie / 2 + random(jibie / 2)
      );
      if (member_array(keys(mp)[i], basic) != -1) {
        set_skill(keys(mp)[i], 500 + jibie * 2 + random(jibie / 2));
        set_skill(mp[keys(mp)[i]], 500 + jibie / 2 + random(jibie / 2));
        map_skill(keys(mp)[i], mp[keys(mp)[i]]);
      }
    }
    set("wugong", 1);
  }

  set("chat_chance", 5);
  set("chat_msg", ({
    (: random_move :)
  }));

  setup();
  if (!query("wuqi", 1)) {
    if (mp["weapon"]) carry_object(mp["weapon"])->wield();
    set("wuqi", 1);
  }
  carry_object("/clone/cloth/hanbing-jia")->wear();
  add_money("gold", 10 + random(jibie / 2));
}

void init() {
  object ob, me;
  //	object get_ob;
  //	int i, maxjing, maxqi, level, is_time;
  //	mapping skill_status, map_status, hp_status;
  //  string *sname, *mname;

  me = this_object();
  ob = this_player();

  // 怪物必须是可以动作的，并只针对玩家
  if (!objectp(ob) || !living(me) || !playerp(ob)) return;
  // 见面就杀
  me->kill_ob(ob);
  // 拦路
  add_action("do_go", "go");
  // 跟随
  command("follow " + ob->query("id"));
  /*
	// 战斗中不复制
	if ( sizeof(me->query_enemy()) > 1 
		&& (is_time=me->query_temp("copy_ob_time")) 
		&& is_time < time() )
		return;
	// 只复制>1000级玩家状态
	if ( ob->query("xyzx_sys/level") < 1000000 ) return;//2016.5.27阿飞改，以后怪不再复制玩家了	
	// 获得玩家总等级
	level = ob->query("xyzx_sys/level");
	// 只复制最高等级玩家
	if ( me->query_temp("kill_ob_lvl") > level ) return;
	// 防止重复复制同一人
	if ( objectp(get_ob=me->query_temp("fight_killer_id")) && get_ob==ob ) return;
	//__________________标记目前复制状况___________________
	me->set_temp("fight_killer_id", ob);
	me->set_temp("kill_ob_lvl", level);
	me->set_temp("copy_ob_time", time()+3);
	//______________________标记结束_______________________
	//______________________状态拷贝___________________
    hp_status = ob->query_entire_dbase();
    me->set("str", hp_status["str"]);
    me->set("int", hp_status["int"]);
    me->set("con", hp_status["con"]);
    me->set("dex", hp_status["dex"]);
	maxqi = hp_status["max_qi"] * 3;
	if ( maxqi < 2000000 ) maxjing = 2000000;
    me->set("max_qi", maxqi);
	me->set("eff_qi",  maxqi);
    me->set("qi",  maxqi);
	maxjing = hp_status["max_jing"] * 3;
	if ( maxjing < 1000000 ) maxjing = 1000000;
    me->set("max_jing",  maxjing);
    me->set("eff_jing",  maxjing);
    me->set("jing",      maxjing);
    me->set("max_neili", hp_status["max_neili"] * 3);
    me->set("neili",     hp_status["max_neili"] * 4);
    me->set("max_jingli", hp_status["max_jingli"]);
    me->set("jingli",     hp_status["max_jingli"] * 3);
	me->command("jiali max");
	if ( me->query("jiali") < hp_status["jiali"] )
		me->set("jiali", (int)hp_status["jiali"]);
	
	//__________________________等级相关参数拷贝_____________________________
    me->set("xyzx_sys/level", ob->query("xyzx_sys/level") * 11 / 10);
    me->set("xyzx_sys/jingzhun", ob->query("xyzx_sys/jingzhun") * 11 / 10);
    me->set("xyzx_sys/minjie", ob->query("xyzx_sys/minjie") * 11 / 10);
    me->set("xyzx_sys/lingxing", ob->query("xyzx_sys/lingxing") * 11 / 10);
    me->set("xyzx_sys/fanying", ob->query("xyzx_sys/fanying") * 11 / 10);
	//______________________拷贝完成___________________
    // 没有可拷贝的技能
	if ( !(skill_status = ob->query_skills()) ) return;
	//_________________________拷贝技能________________________
	sname  = keys(skill_status);
    for(i=0; i<sizeof(skill_status); i++)
	{
		me->set_skill(sname[i], skill_status[sname[i]]);
    }
	//______________________技能拷贝完成_______________________
    // 没有可拷贝的激发技能
	if ( !(map_status = ob->query_skill_map()) ) return;
    //______________________卸除激发技能___________________
    me->map_skill("unarmed");
    me->map_skill("dodge");
    me->map_skill("parry");
	me->map_skill("sword");
	me->map_skill("force");
	me->map_skill("blade");
	//______________________卸除完毕________________________
	//_____________________拷贝技能激发状态___________________
	mname  = keys(map_status);
    for(i=0; i<sizeof(map_status); i++) 
	{
		me->map_skill(mname[i], map_status[mname[i]]);
    }
	//______________________技能激发拷贝完毕__________________
*/
}

void die() {
  object ob, me, corpse, baoshi, env;
  string room, name;
  int m, k1, k2, k3;
  int flag, xingyun;
  xingyun = 0;
  flag = 1;
  ob = this_object();

  // 先绑定到打晕的对象上
  if (!objectp(me = ob->query_temp("last_unconcious_from")))
    me = ob->query_temp("last_damage_from");  // 绑定到最后伤害对象

    if (!objectp(me)  // 未成功绑定
    || !objectp(env = environment(ob))
      || !stringp(room = env->query("short"))) {
      ::die();
      return;
    }

  if (me) {
    m = 1500000 + random(1500000);

    if (interactive(me)) {
      message_vision(
        HIG "\n$N杀死了 " + ob->name(1) + HIG " ，奖励了 " HIM + (m * me->query_exp_times()) + HIG " 点经验和 " HIY + (m / 10) + HIG " 潜能。\n" NOR,
        me
      );
      me->add("combat_exp", m);
      me->add("potential", m / 10);
      me->add("score", 300, 1);
      tell_object(me, HIM "恭喜你获得江湖币4个！\n" NOR);
      me->add("jianghu_money", 4);
      if (me->query("xyhy_type") == 2) flag = 5 / 4;
      if (me->query_temp("wupin_max_add")) xingyun = (int)me->query_temp("wupin_max_add", 1);  //处于幸运状态时
    }
  }

  if (objectp(corpse = CHAR_D->make_corpse(ob, me)))
    corpse->move(environment(ob));
  // 绑定到对象，冷冻一分钟
  corpse->set("valid_get_from", me->query("id"));

  k1 = 100 * flag;  //装备爆率
  k2 = 200 * flag;  //强化符爆率
  k3 = 50 * flag;  //宝石爆率
  //2018.3.20阿飞改，第4版不爆下列装备
  /*		if ( objectp(me) && objectp(ob) && 1000 < k1*(100+xingyun)/100 )
		{						
			if (random(2)==0) 
			{
				baoshi = new("/clone/tzbox/three-box");
			} else
			{
				baoshi = new("/clone/tzbox/wp3-box");
			}
			name = baoshi->name(1);		
            message_vision(HIG"\n$N在 "HIY+ob->name(1)+" 的尸体上发现了 "HIW+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,  me);	//2016.6.15阿飞改，增加显示物品的id		
		    message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "HIM+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
			baoshi->move(corpse);
		}
		if ( objectp(me) && objectp(ob) && 1000 < k2*(100+xingyun)/100 )
		{						
			baoshi = new("/clone/map/obj/fumo-fu");			
			name = baoshi->name(1);		
            message_vision(HIG"\n$N在 "HIY+ob->name(1)+" 的尸体上发现了 "HIW+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,  me);	//2016.6.15阿飞改，增加显示物品的id		
//		    message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "HIM+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
			baoshi->move(corpse);
		}
		if ( objectp(me) && objectp(ob) && 1000 < k3*(100+xingyun)/100 )
		{						
			baoshi = new(random_item2[random(sizeof(random_item2))]);	
			name = baoshi->name(1);		
            message_vision(HIG"\n$N在 "HIY+ob->name(1)+" 的尸体上发现了 "HIW+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,  me);	//2016.6.15阿飞改，增加显示物品的id		
//		    message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "HIM+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
			baoshi->move(corpse);
		}*/
  if (objectp(me) && objectp(ob)) {
    if (random(2) == 1) {
      baoshi = new("/clone/suit/menpai/card3/menpai" + (1 + random(45)));
      name = baoshi->name(1);
      message_vision(
        HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
        me
      );
      message(
        "party",
        HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " HIM + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
        users()
      );  //2016.6.15阿飞改，增加显示物品的id
      baoshi->move(corpse);
    } else {
      if (random(3) == 0) {
        switch (random(3)) {
          case 0: baoshi = new("/clone/tzbox/xiepai1-box");
          break;
          case 1: baoshi = new("/clone/tzbox/zhengpai1-box");
          break;
          case 2: baoshi = new("/clone/tzbox/zhongli1-box");
          break;
        }
      } else {
        switch (random(3)) {
          case 0: baoshi = new("/clone/tzbox/xiepai2-box");
          break;
          case 1: baoshi = new("/clone/tzbox/zhengpai2-box");
          break;
          case 2: baoshi = new("/clone/tzbox/zhongli2-box");
          break;
        }
      }
      name = baoshi->name(1);
      message_vision(
        HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
        me
      );
      message(
        "party",
        HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " HIM + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
        users()
      );  //2016.6.15阿飞改，增加显示物品的id
      baoshi->move(corpse);
    }
  }
  if (objectp(me) && objectp(ob) && random(100000) < (1500 * (100 + xingyun) / 100)) {
    baoshi = new(random_item3[random(sizeof(random_item3))]);
    name = baoshi->name(1);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id		
    message(
      "party",
      HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " HIM + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      users()
    );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }
  COMBAT_D->announce(ob, "dead");
  destruct(ob);
  return;
}


int do_go(string arg) {
  object me, ob, *killer;

  me = this_object();
  ob = this_player();

  if (!objectp(ob)) return 0;

  killer = ob->query_enemy();

  if (playerp(ob) && arrayp(killer) && sizeof(killer) > 3 && random(10) <= 5) {
    message_vision(YEL "$N见势不好，转身要走，被$n" + YEL + "一把拦在面前。本皇在此，不给朕跪拜还想走？没那么容易！\n" NOR, ob, me);
    if (!ob->is_busy()) ob->start_busy(1);
    return 1;
  }

  return 0;
}
