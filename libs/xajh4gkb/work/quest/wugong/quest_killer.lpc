void create() {
  string id1, id2, idf1, idf2;
  string name1, name2;
  int i, jibie, index, index1, index2;
  object me = this_player();
  mapping mp;
  string *basic = ({ "dodge", "unarmed", "force", "parry", "finger", "hand",
    "strike", "taoism", "club", "staff", "fork", "hammer",
    "blade", "cuff", "axe", "sword", "whip", "dagger",
    "throwing", "claw", "poison"
  });
  index = random(sizeof(menpai));
  mp = menpai[index];
  index1 = random(sizeof(first_name));
  index2 = random(sizeof(first_name));
  name1 = first_name[index1]["name"];
  name2 = first_name[index2]["name"];
  id1 = first_name[index1]["id"];
  id2 = first_name[index2]["id"];
  idf1 = id1;
  idf2 = id2;
  index1 = random(sizeof(second_name1));
  index2 = random(sizeof(second_name2));
  name1 += second_name1[index1]["name"];
  name2 += second_name2[index2]["name"];
  id1 += " " + second_name1[index1]["id"];
  id2 += " " + second_name2[index2]["id"];

  index1 = random(sizeof(third_name1));
  index2 = random(sizeof(third_name2));
  name1 += third_name1[index1]["name"];
  name2 += third_name2[index2]["name"];
  id1 += third_name1[index1]["id"];
  id2 += third_name2[index2]["id"];

  set_name(name1, ({ id1, idf1 }));
  if (mp["gender"]) set("gender", mp["gender"]);
  if (query("gender") == "女性") set_name(name2, ({ id2, idf2 }));
  if (mp["family"]) create_family(mp["family"], 100, "弟子");
  set("title", HIB "杀人狂魔" NOR);

  jibie = 100;
  jibie = me->query("xyzx_sys/level");
  if (jibie > 10000) jibie = 10000;
  if (jibie < 100) jibie = 100;
  for (i = 0; i < sizeof(keys(mp)); i++) {
    if (member_array(keys(mp)[i], basic) != -1) {
      set_skill(keys(mp)[i], 500 + jibie * 2 + random(jibie / 2));
      set_skill(mp[keys(mp)[i]], 500 + jibie / 2 + random(jibie / 2));
      map_skill(keys(mp)[i], mp[keys(mp)[i]]);
    }
  }

  set("str", 30 + random(10));
  set("con", 30 + random(10));
  set("dex", 30 + random(10));
  set("int", 30 + random(10));

  set("xyzx_sys/level", jibie);
  set("max_neili", 1500000);
  set("neili", 1500000);
  set("max_jingli", 1500000);
  set("jingli", 1500000);
  set("jiali", jibie / 3);
  set("max_qi", query("max_neili") / 4);
  set("eff_qi", query("max_qi"));
  set("qi", query("max_qi"));
  set("max_jing", query("max_jingli") / 4);
  set("eff_jing", query("max_jing"));
  set("jing", query("max_jing"));
  set("combat_exp", 10000000);

  setup();
  if (mp["weapon"]) carry_object(mp["weapon"])->wield();
  carry_object("/clone/cloth/hanbing-jia")->wear();
}

void init() {
  object ob, killer;
  //	mapping quest;

  killer = this_object();
  ob = this_player();
  //	quest = (__DIR__"where")->query_quest(); //添加逃离
  if (!this_object()->query("killer"))
    return;

  if (ob->query("id") == killer->query("killer") && ob->query_temp("day_wugong_quest/have_task")) {
    killer->fight_ob(ob);
    ob->fight_ob(killer);
    COMBAT_D->do_attack(killer, ob, killer->query_temp("weapon"));
    message_vision(HIB "$n一看到$N, 不由分说，抄出家伙给你一击后，立马溜之大吉！\n" NOR, ob, killer);
    ob->set_temp("day_wugong_quest/inquiry", 1);
    ob->set_temp("day_wugong_quest/family_name2", killer->query("family/family_name"));
    killer->command("halt");
    //		killer->move(quest["place"]);
    //		write(HIC"远处传来"+killer->query("name")+"("+killer->query("id")+")"+"的狂笑声：有种就来『"+quest["short"]+"』找我吧。\n"NOR);		
    call_out("killer_time", 1, killer);
  } else {
    message_vision(HIB "$n不屑地朝$N说道: “原来就是你一直在妨碍老子杀人！人我早杀完了，\n"
      + "你就来收尸吧，不过就不知道谁能帮你收尸了！” \n" NOR, ob, killer);
    command("heihei " + ob->query("id"));
    killer->kill_ob(ob);
    ob->kill_ob(killer);
  }

}

void killer_time(object killer) {
  if (!objectp(killer)) return;
  message_vision(
    HIY "" + killer->query("name") + "(" + killer->query("id") + ")" "狞笑了几声：今天心情好，本大爷就放过你，不陪你玩了。说罢，一个筋斗跳出战圈，不知去向。\n" NOR,
    killer
  );
  destruct(killer);
  return;
}
