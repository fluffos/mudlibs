#include <ansi.h>
inherit NPC;


string *stdskillclass = ({ "unarmed", "dodge", "force", "blade" });

string *moonskillclass = ({ "jiuyin-baiguzhao", "shenxing-baibian",
  "jiuyin-zhenjing", "wuhu-duanmendao" });

string *fangcunskillclass = ({ "nianhua-zhi", "shaolin-shenfa",
  "yijinjing", "cibei-dao" });

string *putuoskillclass = ({ "taiji-quan", "tiyunzong",
  "taiji-shengong", "taiji-dao" });

string *hellskillclass = ({ "qishang-quan", "qiankundanuoyi",
  "jiuyang-shengong", "wind-blade" });

string *longgongskillclass = ({ "kongming-quan", "shenxing-baibian",
  "taixuan-gong", "zijinbagua-dao" });

string *xueshanskillclass = ({ "haotian-zhang", "jinyan-gong",
  "xiantian-qigong", "kuangfeng-blade" });

string *wudidongskillclass = ({ "tianmo-quan", "wuxue-shenfa",
  "tianmo-shengong", "tianmo-dao" });



int set_std_skills(int level, object ob) {
  ob->set_skill("unarmed", level * 3 / 2);
  ob->set_skill("dodge", level * 3 / 2);
  ob->set_skill("parry", level * 3 / 2);
  ob->set_sklll("literate", level * 3 / 2);
  ob->set_skill("force", level * 3 / 2);
}

int set_guai_skills(int level, object ob, string *str) {
  int i;
  for (i = 0; i < 4; i++) {
    ob->set_skill(str[i], level);
    ob->map_skill(stdskillclass[i], str[i]);
  }
}
int set_moon_guai(int level, object ob) {
  set_guai_skills(level, ob, moonskillclass);
  ob->set("gender", "男性");
  ob->set_skill("blade", level * 3 / 2);
  ob->set_skill("wuhu-duanmendao", level);
  ob->map_skill("blade", "wuhu-duanmendao");
  ob->set("chat_msg_combat", ({
    (: perform_action, "blade.duan" :),
  }));
}
int carry_moon_weapon() {
  carry_object("/clone/weapon/hanbing-dao")->wield();
  carry_object("/clone/cloth/hanbing-jia")->wear();
}

