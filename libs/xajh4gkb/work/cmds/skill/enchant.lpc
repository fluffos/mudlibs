
inherit F_CLEAN_UP;
int help(object me);
int main(object me, string arg)
{
	int pts;
	string force_skill = me->query_skill_mapped("force");
	if( !arg || ((arg != "max" && arg!="none") && !sscanf(arg, "%d", pts))) 
		return help(me);
    if (!stringp(force_skill))
        return notify_fail("你未使用特殊内功。\n");
	if ((int)me->query_skill(force_skill, 1) < 100)
		return notify_fail("你的内功修为不够。\n");
	if( me->query_condition("no_enforce") )
		return notify_fail("你丹田被破，暂时不能使用精力。\n");
	if( arg=="none" || me->query("jingli") < me->query("jiajing") )   //2019.9.18阿飞改，当精力耗光了时会自动卸掉加精		
		me->delete("jiajing");
	else 
	{
		if (arg=="max")
			pts=(int)me->query_skill("force") / 2;
		else
		if( pts < 0 || pts > (int)me->query_skill("force") / 2 )
			pts=(int)me->query_skill("force") / 2;
		me->set("jiajing", pts);
	}
	write("Ok.\n");
	return 1;
}
int help (object me)
{
        write(@HELP
指令格式: enchant <使用几点精力>|none|max

这个指令让你指定每次击中敌人时，要发出几点精力伤敌。
enchant none 则表示你不使用精力。 
enchant max 则表示你使用最大的精力。 
See Also: enable
HELP
        );
        return 1;
}
