// tongmai.c	//打坐

#include <skill.h>
inherit F_CLEAN_UP;
int tongmai(object me);
int halt_tongmai(object me);
string *order = ({""HIY"", ""HIG"", ""RED"", ""MAG"", ""YEL"", ""HIC"", ""HIW"", ""HIR"",""HIB"", ""CYN"",""WHT"",""HIM"",""BLU""});
string *jingmai_name =(
{
	"手太阴肺经","手厥阴心包经","手少阴心经","手阳明大肠经","手少阳三焦经","手太阳小肠经","足太阴脾经","足厥阴肝经","足少阴肾经","足阳明胃经","足少阳胆经","足太阳膀胱经","任脉","督脉","冲脉","带脉","阴跷脉","阳跷脉","阴维脉","阳维脉",
});
string *jingmai_id =(
{
	"styfjing","sjyxbjing","ssyxjing","symdcjing","ssysjjing","styxcjing","ztypjing","zjygjing","zsysjing","zymwjing","zsydjing","ztypgjing","renmai","dumai","chongmai","daimai","yinqiaomai","yangqiaomai","yinweimai","yangweimai",
});
int main(object me, string arg)
{
	mapping msg;
	mapping jingmai;
	string force_skill=me->query_skill_mapped("force");
	object where;
	int jingmai_num,k;
	
	seteuid(getuid());
	where = environment(me);
	jingmai = me->query_jingmai();
	jingmai_num = sizeof(jingmai);
	k = random(sizeof(jingmai_name));
	if (where->query("pigging"))
		return notify_fail("你还是专心拱猪吧！\n");
	if (me->is_busy() || me->query_temp("pending/tongmai"))
		return notify_fail("你现在正忙着呢。\n");
    if( environment(me)->query("no_fight") )
        return notify_fail("这里是是非之地，不可久留，别练功了，快走吧！\n");
	if( me->is_fighting() || !living(me))
		return notify_fail("战斗中不能练内功，会走火入魔。\n");
	if( me->query_condition("no_enforce") )
		return notify_fail("你丹田被破，如能呼吸吐纳呢。\n");
	if (userp(me) && !wizardp(me))
		return notify_fail("只有NPC才能使用该功能。\n");
    if (!stringp(force_skill))
        return notify_fail("你所学的内功中没有这项技能。\n");
	if ((int)me->query_skill("force",1)<1000)
		return notify_fail("你还是先学些呼吸心法的技巧！\n");
    if ((int)me->query_skill(force_skill, 1) < 500)
        return notify_fail("你的"+to_chinese(force_skill)+"修为还不够。\n");
	if( (int)me->query("max_neili") < 10000 )
		return notify_fail("你现在的内力修为不够。\n");
	if( (int)me->query("max_jingli") < 10000 )
		return notify_fail("你现在精力修为不够！\n");
	if( (int)me->query("neili") < 100 )
		return notify_fail("你现在的内力太少了，无法产生内息运行全身经脉。\n");
	if( (int)me->query("jingli") < 100 )
		return notify_fail("你现在精力不够，无法控制内息的流动！\n");
	if( (int)me->query("qi") < (int)me->query("max_qi")*9/10 )
		return notify_fail("你现在的气血不足，恐怕有走火入魔之危。\n");
	if( (int)me->query("jing") < (int)me->query("max_jing")*9/10 )
		return notify_fail("你现在的精神欠佳，恐怕有走火入魔之危。\n");
	if (jingmai_num > 12 )
		return notify_fail("你已无法通过运功通脉来打通人体十二正经和奇经八脉了！\n");
//	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
//		return notify_fail("你处于技能冷却状态中，休息一会吧。\n");	
//2018.2.6阿飞改，换成那种花样打坐方式	
	if (force_skill && msg = SKILL_D(force_skill)->exercise_msg(me)) 
	{
		write(HIC"你聚起全身真气，开始冲击"HIM+jingmai_name[k]+HIC"。\n"NOR);
		write((order[random(13)])+("\n你"+msg["status_msg"])+ "\n"NOR);
		write((order[random(13)])+("\n你"+msg["start_my_msg"])+ "\n"NOR);
		message_vision((order[random(13)])+(msg["start_other_msg"]) + "\n"NOR,environment(me),({me}));
	} else  
	{
		write(HIC"你聚起全身真气，开始冲击"HIM+jingmai_name[k]+HIC"。\n"NOR);
		write(HIR"你盘膝坐下，一股"HIW"内息"HIR"开始在体内经脉流动。\n"NOR);
		message_vision(me->name()+"盘膝坐下，内力开始在体内经脉流动。\n"NOR,me);
	}
	me->set_temp("pending/tongmai", 1);
	me->set_temp("pending/tongmai_k", k);
	me->set_temp("tongmai_time", 8+random(12));
	me->start_busy((: tongmai :), (:halt_tongmai:));
	return 1;
}
int tongmai(object me)
{
	mapping msg;
	string force_skill=me->query_skill_mapped("force");
	int tongmai_time = (int)me->query_temp("tongmai_time");
	int k = (int)me->query_temp("pending/tongmai_k");
	object where = environment(me);
    //if (!interactive(me) && !me->query("lixian/biguan") && playerp(me) ) return 0; // 解决npc无法打坐恢复内力
	if (tongmai_time < 1) return 0;
	if(where->query("xuanbing") || where->query("hanyuchuang")) me->set_temp("tongmai_time", tongmai_time -= 2);
	else me->set_temp("tongmai_time", tongmai_time -= 1);
	if (tongmai_time > 0) return 1;

//	tongmai_time = 0;	
//2018.2.6阿飞改，换成那种花样打坐方式	
	if (force_skill && msg = SKILL_D(force_skill)->exercise_msg(me)) 
	{
		write((order[random(13)])+ ("\n你" + msg["end_my_msg"])+ NOR);
		if (!me->query("env/no_fight_msg"))
		{
			message_vision((order[random(13)])+(msg["end_other_msg"]) + NOR,environment(me),({me}));
			tell_object(me, HIY"你运功通脉完毕，深深呼了口气，站了起来。\n"NOR);
		} else 
		{
			message_vision((order[random(13)])+(msg["start_my_msg"]) + NOR, me);
			tell_object(me, HIY"你运功通脉完毕，深深呼了口气，站了起来。\n"NOR);	
		}		
	} else  
	{
		if (!me->query("env/no_fight_msg")) 
			message_vision(HIY"$N运功通脉完毕，深深呼了口气，站了起来。\n"NOR, me);
		else
			tell_object(me, HIY"你运功通脉完毕，深深呼了口气，站了起来。\n"NOR);
	}
	me->set_temp("pending/tongmai", 0);
	if (random(1000)<2)
	{
		if(me->query("jingmai/"+jingmai_id[k]))
			write(HIG"你真气运行通畅，然来"HIM+jingmai_name[k]+HIG"早已经打通了。\n"NOR);
		else
		{
			me->set("jingmai/"+jingmai_id[k], 1);
			write(HIG"你咬紧牙关，一鼓作气，真气顺着"HIM+jingmai_name[k]+HIG"贯通各处穴位。\n"NOR);
			message("channel:chat", HIY"【镜花水月】"+HIM"听说"+me->name(1)+HIG"("+me->query("id")+HIM") 经过勤修苦练，终于打通了"HIG+jingmai_name[k]+HIM"，窥视到了无上的武学境界！\n"NOR,users() );	
		}
		me->delete_temp("pending/tongmai_k");
		return 0;
	} 
	else 
	{
		write(HIG"你行功一周天，然而未能打通"HIM+jingmai_name[k]+HIG"！\n"NOR);
		me->delete_temp("pending/tongmai_k");
		return 0;
	}
}
int halt_tongmai(object me)
{
	me->set_temp("pending/tongmai", 0);
	me->delete_temp("pending/tongmai_k");
	return 1;
}
int help(object me)
{
        write(@HELP
指令格式 : tongmai 
运气练功，控制体内的气在各经脉间流动，打通经脉穴位，挖掘人体潜力。
HELP
        );
        return 1;
}
