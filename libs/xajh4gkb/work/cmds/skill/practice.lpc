// ----/cmds/skill/practice.c ----

// practice.c   	
#include <skill.h>
inherit F_CLEAN_UP;
int help(object me);


int main(object me, string arg) {
  object where = environment(me);
  string skillname, skill_name;
  int dushu, skill, skill_basic, skill_add, is_int, times, jineng_exp_add, huiyuan, flag;
  seteuid(getuid());

  if (where->query("pigging"))
    return notify_fail("你还是专心拱猪吧！\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (environment(me)->query("no_fight"))
    return notify_fail("这里是是非之地，不可久留，别练功了，快走吧！\n");
  if (me->is_fighting())
    return notify_fail("你已经在战斗中了，学一点实战经验吧。\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，休息一会吧。\n");
  if (!arg) return (__DIR__ "enable")->main(me, arg);
  if ((sscanf(arg, "%s %d", arg, times) != 2))
    return notify_fail("指令格式：practice|lian <技能种类> <次数>\n");
  if (times < 1 || times >= 50)
    return notify_fail("练习次数必须大于一次，但不能超过五十次。\n");
  if (!arg) return help(me);
  if (!stringp(skillname = me->query_skill_mapped(arg)) || arg == "parry")
    return notify_fail("你只能练习用 enable 指定的特殊技能。\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的真气不够。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("potential") < 10000)
    return notify_fail("你的潜能不够。\n");

  if (me->query("xyhy_type") == 2) huiyuan = 5 / 4;  //2016.6.20阿飞改，黄金会员自练速度为1.25倍
  else huiyuan = 1;
  if (me->query_temp("jineng_exp_add")) jineng_exp_add = (int)me->query_temp("jineng_exp_add", 1);  //处于技能自练提升状态时	
  else jineng_exp_add = 0;
  if (SKILL_D(skillname)->practice_add()) flag = SKILL_D(skillname)->practice_add();  //技能自练效率系数
  else flag = 100;
  dushu = me->query_skill("literate", 1);
  skill_basic = me->query_skill(arg, 1);
  skill = me->query_skill(skillname, 1);
  is_int = me->query("int", 1) * me->query("int", 1) * me->query("int", 1) / 3;
  skill_add = (skill_basic / 2 + skill + is_int + dushu) * 12 / 10 * flag / 100 * me->query_exp_times() * (jineng_exp_add + 100) / 100;
  if (stringp(me->query("body")) && (string)me->query("body") == HIM "先天道胎" NOR) skill_add += skill_add / 10;

  if (skill < 100)
    return notify_fail("你好像还没有学过这项技能吧？最好先去请教别人。\n");
  if (skill_basic < 100)
    return notify_fail("你对这方面的技能还是一窍不通，最好从先从基本学起。\n");
  if (skill_basic <= skill)
    return notify_fail("你的基本功火候未到，必须先打好基础才能继续提高。\n");
  if (skill > (me->query("xyzx_sys/level") + 300) * 2)
    return notify_fail("你的实战能力不足，难以领会更高深的境界。\n");

  notify_fail("你试着练习" + to_chinese(skillname) + "，但是并没有任何进步。\n");

  if (SKILL_D(skillname)->practice_skill(me)) {
    //		me->improve_skill(skillname, times*(skill_add/10 +10)*huiyuan, skill_basic > skill? 0: 1);	//原是除5
    //		me->improve_skill(skillname, times*(skill_add/30 +10)*huiyuan, 0);	//后面的那个不知道什么意思
    me->improve_skill(skillname, times * (skill_add / 30 + 10) * huiyuan);

    if (!me->query("env/block_lian_msg") && skill_name = SKILL_D(skillname)->query_skill_name(random(skill) / 25))
      printf(HIW "你试着练习" + to_chinese(skillname) + "，对「%s」这一招似乎有些心得。\n" NOR, skill_name);
    else
      printf(HIW "你试着练习" + to_chinese(skillname) + "，似乎有些心得。\n" NOR);
    me->add("neili", -100 * times);
    me->add("jingli", -100 * times);
    me->add("potential", -10 * times);
    me->start_busy(1);
    //write( HIY "你的" + to_chinese(skillname) + "进步了！\n" NOR);
    return 1;
  } else
    return 0;
}

int help(object me) {
  write(@TEXT
指令格式：practice|lian <技能种类> <次数>
这个指令让你练习某个种类的技能，这个技能必须是经过 enable 的专业技能。
如果你对这方面的基本技能够高，可以经由练习直接升级，而且升级的上限只跟
你基本技能的等级有关，换句话说，勤加练习是使你的所学「青出于蓝胜于蓝」
的唯一途径，当然，在这之前你必须从实际运用中获得足够的经验以提升你的基
本技能。
TEXT
  );
  return 1;
}
