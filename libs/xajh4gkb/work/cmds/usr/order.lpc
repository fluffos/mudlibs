#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string dest, msg;
	object ob,obj;

	if( !arg || sscanf(arg, "%s to kill %s", dest, msg)!=2 )
		return notify_fail("你要干什么？\n"); 
	ob = present(dest, environment(me));
	obj = present(msg,environment(me));
	if( !ob || !ob->is_character() )
		return notify_fail("你要命令谁？\n");
	if ( ob == me )
		return notify_fail("你要命令自己？\n");
	if (!obj || !obj->is_character() )
		return notify_fail("这里没有这个人。\n");
	else 
			{ob ->kill_ob(obj);
  write(ob->name()+"对"+obj->name()+"喝道：贱货，今日不是你死就是我活！\n");}
return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : order <人物> to kill <对象>
 
这个指令让你命令某人杀别人。

HELP
    );
    return 1;
}