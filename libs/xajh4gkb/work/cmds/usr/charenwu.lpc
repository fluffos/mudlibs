
#include <ansi.h>
#include <combat.h>
#include <liebiao.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
	string msg;
	
	seteuid(getuid());
	if(!arg)
		ob = me;
	else if (wizardp(me))
	{
		ob = present(arg, environment(me));
		if (!ob)
			ob = find_player(arg);
		if (!ob)
			ob = find_living(arg);
		if (!ob)
			return notify_fail("你要察看谁的状态？\n");
		if( !ob->is_character() || ob->is_corpse() )
			return notify_fail("你不会连" + ob->query("name") + "的状态都想看吧？。\n");
	}
	else
		return notify_fail("只有巫师能察看别人的状态。\n");

	msg = (ob==me ? HIR"你" : HIR+ob->name()) + HIR"目前各种江湖任务次数：\n"NOR;
	msg += HIC"\n打工厂："+(int)ob->query("renwu/dagong_work")+" 次\n"NOR;
	msg += HIC"\n新手打鸟："+(int)ob->query("renwu/daniao_renwu")+" 次\n"NOR;
	msg += HIC"\n白驼山寻物："+(int)ob->query("renwu/baituo_xunwu")+" 次\n"NOR;
	msg += HIC"\n官府追捕："+(int)ob->query("renwu/zhuibu_renwu")+" 次\n"NOR;
	msg += HIC"\n平一指分药："+(int)ob->query("renwu/ping_fenyao")+" 次\n"NOR;
	msg += HIC"\n杜宽送信："+(int)ob->query("renwu/dukuan_songxin")+" 次\n"NOR;
	msg += HIC"\n杜窄送信："+(int)ob->query("renwu/duzhai_songxin")+" 次\n"NOR;
	msg += HIC"\n林震南运镖："+(int)ob->query("renwu/lin_yunbiao")+" 次\n"NOR;
	msg += HIC"\n郭旭运镖："+(int)ob->query("renwu/guoxu_yunbiao")+" 次\n"NOR;
	msg += HIC"\n黄蓉剿匪："+(int)ob->query("renwu/huang_jiaofei")+" 次\n"NOR;
	msg += HIC"\n襄阳锻造："+(int)ob->query("renwu/xiangyang_duanzao")+" 次\n"NOR;
	msg += HIC"\n襄阳守城："+(int)ob->query("renwu/xiangyang_shoucheng")+" 次\n"NOR;
	msg += HIC"\n泉州抗倭："+(int)ob->query("renwu/quanzhou_kangwo")+" 次\n"NOR;
	msg += HIC"\n泉州贩盐："+(int)ob->query("renwu/quanzhou_fanyan")+" 次\n"NOR;
	msg += HIC"\n雾中楼杀手："+(int)ob->query("renwu/wu_kill")+" 次\n"NOR;
	msg += HIC"\n开封后勤："+(int)ob->query("renwu/kaifeng_houqin")+" 次\n"NOR;
	msg += HIC"\n武功考核："+(int)ob->query("renwu/wugong_kaohe")+" 次\n"NOR;
	msg += HIC"\n朱半仙任务："+(int)ob->query("renwu/banxian_renwu")+" 次\n"NOR;
	msg += HIC"\n黄金十二宫："+(int)ob->query("renwu/huangjingong_tiaozhan")+" 次\n"NOR;
	msg += HIC"\n门派战争："+(int)ob->query("renwu/family_zhanzheng")+" 次\n"NOR;
	message_vision( msg,me);

	return 1;
}

int help(object me)	
{	
write(@HELP	
指令格式 : charenwu 	
这个指令可以让你知道你的江湖任务次数。
HELP	
);
return 1;	
}	
