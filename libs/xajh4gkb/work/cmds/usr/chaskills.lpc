
#include <ansi.h>
#include <skill.h>
#include <liebiao.h>
inherit F_CLEAN_UP;

mapping valid_types = ([
	"unarmed":	"拳脚",
	"axe":		"斧法",
	"sword":	"剑法",
	"blade":	"刀法",
	"stick":	"棒法",
	"staff":	"杖法",
	"spear":	"枪法",
	"fork":		"叉法",
	"club" :	"棍法",
	"throwing":	"暗器",
	"force":	"内功",
	"parry":	"招架",
	"hammer":	"锤法",
	"dodge":	"轻功",
	"magic":	"法术",
	"spells":	"咒文",	
	"taoism":	"道学心法",
	"literate":	"读书写字",
//	"move":		"行动",
//	"array":	"阵法",
	"whip":		"鞭法",
	"poison":	"毒功",
	"finger":	"指法",
	"hand":		"手法",
	"cuff":		"拳法",
	"claw":		"爪法",
	"strike":	"掌法",

]);

int main(object me, string arg)
{
	string *skill,msg,name;
	int i;

	if( !arg || arg=="?" || arg=="/?" )
		return notify_fail("指令格式：chaskills  <技能>\n");
	if (file_size(SKILL_D(arg) + ".lpc") <= 0)
		return notify_fail("没听说过有这种武功。\n");
	if (!wizardp(me) && !(int)me->query_skill(arg, 1))
		return notify_fail("你未学会这项技能吧。\n");

	skill = keys(valid_types);
	name = "";
	for (i=0; i<sizeof(skill); i++)
	{
		if( SKILL_D(arg)->valid_enable(skill[i]) )
			name += ""+valid_types[skill[i]]+" ";
	}
	

	msg = HIM"\n"+to_chinese(arg)+" 功能如下：\n"NOR;
//	if( SKILL_D(arg)->valid_enable() )
		msg += HIG"\n武功用途："+name+"\n"NOR;
	if( SKILL_D(arg)->skill_pinji() )
		msg += HIG"\n武功品级："+SKILL_D(arg)->skill_pinji()+"\n"NOR;
	if( SKILL_D(arg)->skill_xingbie() )
		msg += HIG"\n性别侧重："+SKILL_D(arg)->skill_xingbie()+"\n"NOR;
	if( SKILL_D(arg)->skill_zhengxie() )
		msg += HIG"\n正邪侧重："+SKILL_D(arg)->skill_zhengxie()+"\n"NOR;
	if( SKILL_D(arg)->skill_yinyang() )
		msg += HIG"\n阴阳侧重："+SKILL_D(arg)->skill_yinyang()+"\n"NOR;
	if( SKILL_D(arg)->skill_zhenying() )
		msg += HIG"\n武功阵营："+SKILL_D(arg)->skill_zhenying()+"\n"NOR;
	if( SKILL_D(arg)->skill_menpai() )
		msg += HIG"\n武功门派："+SKILL_D(arg)->skill_menpai()+"\n"NOR;
	if( SKILL_D(arg)->valid_combine() )
		msg += HIG"\n互备技能："+to_chinese(SKILL_D(arg)->valid_combine())+"\n"NOR;	
	if( SKILL_D(arg)->qi_heal() )
		msg += HIC"\n气血治疗系数："+SKILL_D(arg)->qi_heal()+"%\n"NOR;
	if( SKILL_D(arg)->jing_heal() )
		msg += HIC"\n精气治疗系数："+SKILL_D(arg)->jing_heal()+"%\n"NOR;
	if( SKILL_D(arg)->damage_damage() )
		msg += HIC"\n外攻伤害系数："+SKILL_D(arg)->damage_damage()+"%\n"NOR;
	if( SKILL_D(arg)->force_damage() )
		msg += HIC"\n内攻伤害系数："+SKILL_D(arg)->force_damage()+"%\n"NOR;
	if( SKILL_D(arg)->practice_add() )
		msg += HIC"\n自练效率系数："+SKILL_D(arg)->practice_add()+"%\n"NOR;	
	if( SKILL_D(arg)->practice_level() )
		msg += HIC"\n自练最低等级："+SKILL_D(arg)->practice_level()+"\n"NOR;
	if( SKILL_D(arg)->perform_level() )
		msg += HIC"\n绝招最低等级："+SKILL_D(arg)->perform_level()+"\n"NOR;
	message_vision( msg,me);
	return 1;
}

int help(object me)	
{	
write(@HELP	
指令格式 : chaskills <技能>
这个指令可以让你知道技能的参数。
HELP	
);
return 1;	
}	
