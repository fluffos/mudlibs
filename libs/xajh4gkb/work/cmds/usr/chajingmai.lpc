#include <ansi.h>
#include <combat.h>
#include <liebiao.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  string msg;

  seteuid(getuid());
  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob)
      ob = find_player(arg);
    if (!ob)
      ob = find_living(arg);
    if (!ob)
      return notify_fail("你要察看谁的经脉修行状态？\n");
    if (!ob->is_character() || ob->is_corpse())
      return notify_fail("你不会连" + ob->query("name") + "的经脉修行状态都想看吧？。\n");
  } else
    return notify_fail("只有巫师能察看别人的经脉修行状态。\n");

  msg = "\n" + (ob == me ? HIR "你" : HIR + ob->name()) + HIR "的目前经脉修行状态： 化学减伤" + ob->query_meridian() + "% \n" NOR;
  msg += HIC "\n手太阴肺经：    " + (ob->query("jingmai/styfjing") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n手厥阴心包经：  " + (ob->query("jingmai/sjyxbjing") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n手少阴心经：    " + (ob->query("jingmai/ssyxjing") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n手阳明大肠经：  " + (ob->query("jingmai/symdcjing") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n手少阳三焦经：  " + (ob->query("jingmai/ssysjjing") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n手太阳小肠经：  " + (ob->query("jingmai/styxcjing") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n足太阴脾经：    " + (ob->query("jingmai/ztypjing") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n足厥阴肝经：    " + (ob->query("jingmai/zjygjing") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n足少阴肾经：    " + (ob->query("jingmai/zsysjing") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n足阳明胃经：    " + (ob->query("jingmai/zymwjing") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n足少阳胆经：    " + (ob->query("jingmai/zsydjing") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n足太阳膀胱经：  " + (ob->query("jingmai/ztypgjing") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n任脉：          " + (ob->query("jingmai/renmai") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n督脉：          " + (ob->query("jingmai/dumai") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n冲脉：          " + (ob->query("jingmai/chongmai") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n带脉：          " + (ob->query("jingmai/daimai") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n阴跷脉：        " + (ob->query("jingmai/yinqiaomai") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n阳跷脉：        " + (ob->query("jingmai/yangqiaomai") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n阴维脉：        " + (ob->query("jingmai/yinweimai") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  msg += HIC "\n阳维脉：        " + (ob->query("jingmai/yangweimai") == 1 ? HIR "打通" : "未打通") + " \n" NOR;
  message_vision(msg, me);

  return 1;
}

int help(object me) {
  write(@HELP	
指令格式 : charenwu 	
这个指令可以让你知道你的江湖任务次数。
HELP
  );
  return 1;
}
