// test.c
inherit F_CLEAN_UP;
#include <ansi.h>

string get_con_name(string coni)
{
	string name;
	
	switch (coni)
	{	
		case "dali"	: name = "大理段家"; break;		
		case "feitian"	: name = "飞天御剑流"; break;
		case "gaibang"	: name = "丐帮"; break;
		case "murong"	: name = "姑苏慕容"; break;		
		case "mingjiao"	: name = "明教"; break;
		case "shaolin"	: name = "少林派"; break;
		case "gumu"	: name = "古墓派"; break;
		case "tangmen"	: name = "唐门"; break;
		case "wudang"	: name = "武当派"; break;
		case "xuehe"	: name = "血河派"; break;
		case "baituo"	: name = "白驼山派"; break;
		case "nanhai"	: name = "南海派"; break;
		case "chixin"	: name = "痴心妄想门"; break;
		case "emei"	: name = "峨嵋派"; break;
		case "humiao"	: name = "胡苗世家"; break;
		case "honghua"	: name = "红花会"; break;
		case "huashan"	: name = "华山派"; break;
		case "huanhua"	: name = "浣花派"; break;
		case "kunlun"	: name = "昆仑派"; break;
		case "lingjiu"	: name = "灵鹫宫"; break;
		case "lingxiao"	: name = "凌霄城"; break;
		case "meizhuang"	: name = "梅庄"; break;
		case "quanzhen"	: name = "全真教"; break;
		case "riyue"	: name = "日月神教"; break;
		case "shashou"	: name = "杀手楼"; break;
		case "shenlong"	: name = "神龙教"; break;
		case "shengjian"	: name = "圣剑魔宫"; break;
		case "shushan"	: name = "蜀山派"; break;
		case "songshan"	: name = "嵩山派"; break;
		case "taohua"	: name = "桃花岛"; break;
		case "tiezhang"	: name = "铁掌帮"; break;
		case "tongchi"	: name = "通吃帮"; break;
		case "wudu"	: name = "五毒教"; break;
		case "wudie"	: name = "舞蝶仙"; break;
		case "xiaoyao"	: name = "逍遥派"; break;
		case "xingxiu"	: name = "星宿派"; break;
		case "xuantian"	: name = "玄天派"; break;
		case "xueshan"	: name = "雪山寺"; break;
		case "yihua"	: name = "移花宫"; break;
		case "yunlong"	: name = "云龙门"; break;
		case "taishan"	: name = "泰山派"; break;
		case "hengshan"	: name = "恒山派"; break;
		case "henshan"	: name = "衡山派"; break;
		case "xuedao"	: name = "血刀门"; break;
		case "qingcheng"	: name = "青城派"; break;
		case "jinshe"	: name = "金蛇剑法"; break;
		case "wuming"	: name = "无名剑法"; break;
		case "dugu"	: name = "独孤九剑"; break;
		case "xiaoli"	: name = "小李飞刀"; break;
		case "taixuan"	: name = "太玄功"; break;
		case "babu"	: name = "八部龙女剑"; break;
		case "jiuyang"	: name = "九阳神功"; break;
		case "jiuyin"	: name = "九阴真经"; break;
		case "42book"	: name = "四十二章经"; break;
		case "leiting"	: name = "雷霆斧法"; break;
		default			: name = "不详"; break;
	}
	
	return name;
}

int main(object me,string arg)
{
	object tar;
	int i, ci;
	string msg, coni, conn;
	mapping cons;

	if (!userp(me)) return 0;
	seteuid(getuid(me));

	if (!arg) tar = me;
	else if (!objectp(tar = present(arg, environment(me)))) 
	{
		if (wizardp(me) ) 
		{
			if (!tar) tar = LOGIN_D->find_body(arg);
			if (!tar) tar = find_living(arg);
			if (!tar) return notify_fail("你要察看谁的解密状态？\n");
			if (wiz_level(me) < wiz_level(tar))
				return notify_fail("你要察看谁的解密状态？\n");
		}
	}

	if (!wizardp(me) && me!=tar)
		return notify_fail("你要察看谁的解密状态？\n");
	if (tar->is_corpse() || !tar->is_character())
		return notify_fail("那不是活物耶！\n");

	msg = (tar!=me?tar->name(1):"你")+"的解密状态：\n";
	msg += "─────────────\n"
" 解密类型 次数\n"
"─────────────\n";

		cons = (mapping)tar->query("jm");
		for ( i=0; i<sizeof(cons); i++ )
		{
			coni = keys(cons)[i];
			conn = get_con_name(coni);
			ci = cons[coni];
			msg += sprintf(YEL"%-21s%-10s\n"NOR,""+conn+"",""+ci+"");
		}

		msg += "─────────────\n";

		tell_object(me, msg);
	
	return 1;

}

int help(object me)
{
        write(@HELP
指令格式： jiemi
           jiemi <对象名称>             (巫师专用)

这个指令可以显示你的解密状态。

HELP
        );
        return 1;
}
