#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  string rep;

  seteuid(getuid(me));

  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
  } else
    return notify_fail("只有巫师能察看别人的状态。\n");
  rep = "\n";
  rep += "┌──────────────┬─────────┐\n";
  rep += sprintf("│生产技能总表                │  相应技能经验值  │\n");
  rep += "├──────────────┴─────────┤\n";
  rep += sprintf("│挖矿技术                    │        " + ob->query("work_skill/wakuang") + "\n");
  rep += "├──────────────┴─────────┤\n";
  rep += sprintf("│务农技术                    │        " + ob->query("work_skill/wunon") + "\n");
  rep += "├──────────────┴─────────┤\n";
  rep += sprintf("│捕鱼技术                    │        " + ob->query("work_skill/buyu") + "\n");
  rep += "├──────────────┴─────────┤\n";
  rep += sprintf("│打猎技术                    │        " + ob->query("work_skill/dalie") + "\n");
  rep += "├──────────────┴─────────┤\n";
  rep += sprintf("│酿酒技术                    │        " + ob->query("work_skill/zaojiu") + "\n");
  rep += "├──────────────┴─────────┤\n";
  rep += sprintf("│烧菜技术                    │        " + ob->query("work_skill/shaocai") + "\n");
  rep += "├──────────────┴─────────┤\n";
  rep += sprintf("│烧肉技术                    │        " + ob->query("work_skill/shaorou") + "\n");
  rep += "├──────────────┴─────────┤\n";
  rep += sprintf("│烧鱼技术                    │        " + ob->query("work_skill/shaoyu") + "\n");
  /*	rep+= "├──────────────┴─────────┤\n";
	rep+= sprintf("│造剑技术                    │        " + ob->query("work_skill/zhujian") + "\n");	
	rep+= "├──────────────┴─────────┤\n";
	rep+= sprintf("│造刀技术                    │        " + ob->query("work_skill/zhudao") + "\n");	
	rep+= "├──────────────┴─────────┤\n";
	rep+= sprintf("│造板指技术                  │        " + ob->query("work_skill/zhubanzi") + "\n");	
	rep+= "├──────────────┴─────────┤\n";
	rep+= sprintf("│造盔甲技术                  │        " + ob->query("work_skill/zhujia") + "\n");*/
  rep += "└──────────────┴─────────┘\n\n";
  write(rep);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : skills2
           skills2 <对象名称>                   (巫师专用)
这个指令用来查看你的生产技能列表 	

HELP
  );
  return 1;
}
