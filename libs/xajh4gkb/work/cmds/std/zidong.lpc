// hubo.c
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  //	if (!wizardp(me))
  //		return notify_fail("互搏这个功能还是先封了吧，感觉有问题。\n");		
  if (!arg)
    return notify_fail(HIW "请使用zidong yes/no的方式设置战斗中是否自动出连。\n" NOR);
  if (arg == "no") {
    me->set("auto_lian", 1);
    message_vision(HIY "$N静心息气，从物我两忘状态回过神来，关闭了自动连招。\n" NOR, me);
  } else if (arg == "yes") {
    me->delete("auto_lian");
    message_vision(HIY "$N平心静气，物我两忘，开启了自动连招！\n" NOR, me);
  } else {
    return notify_fail(HIW "请使用zidong yes/no的方式设置战斗中是否自动出连。\n" NOR);
  }

  return 1;
}



int help(object me) {
  write(@HELP
指令格式 : zidong yes/no
这个指令可以让你设置是否使用自动连招。
HELP
  );
  return 1;
}
