// test.c
inherit F_CLEAN_UP;
#include <ansi.h>

string get_con_name(string coni)
{
	string name;
	
	switch (coni)
	{	
		case "str"	: name = "臂力丹(bili dan)"; break;		
		case "int"	: name = "悟性丹(wuxing dan)"; break;
		case "con"	: name = "根骨丹(gengu dan)"; break;
		case "dex"	: name = "身法丹(shenfa dan)"; break;		
		case "per"	: name = "养颜丹(yangyan dan)"; break;
		case "shenliwan"	: name = "神力丸(shenli wan)"; break;
		case "xiandan"	: name = "仙丹(int dan)"; break;
		case "xisuidan"	: name = "洗髓丹(xisui dan)"; break;
		case "unknowdan"	: name = "仙丹(dex dan)"; break;
		case "perwan"	: name = "美容丸(meili wan)"; break;
		case "karwan"	: name = "福缘丹(fu wan)"; break;
		case "jiuzhuan"	: name = "九转金丹"; break;
		case "wumuyishu"	: name = "武穆遗书"; break;
		default			: name = "不详"; break;
	}
	
	return name;
}

int main(object me,string arg)
{
	object tar;
	int i, ci;
	string msg, coni, conn;
	mapping cons1,cons2;

	if (!userp(me)) return 0;
	seteuid(getuid(me));

	if (!arg) tar = me;
	else if (!objectp(tar = present(arg, environment(me)))) 
	{
		if (wizardp(me) ) 
		{
			if (!tar) tar = LOGIN_D->find_body(arg);
			if (!tar) tar = find_living(arg);
			if (!tar) return notify_fail("你要察看谁的先天丹药状态？\n");
			if (wiz_level(me) < wiz_level(tar))
				return notify_fail("你要察看谁的先天丹药状态？\n");
		}
	}

	if (!wizardp(me) && me!=tar)
		return notify_fail("你要察看谁的先天丹药状态？\n");
	if (tar->is_corpse() || !tar->is_character())
		return notify_fail("那不是活物耶！\n");

	msg = (tar!=me?tar->name(1):"你")+"的先天丹药状态：\n";
	msg += "─────────────\n"
" 先天丹药 次数\n"
"─────────────\n";

		cons1 = (mapping)tar->query("gift");
		for ( i=0; i<sizeof(cons1); i++ )
		{
			coni = keys(cons1)[i];
			conn = get_con_name(coni);
			ci = cons1[coni];
			msg += sprintf(YEL"%-21s%-10s\n"NOR,""+conn+"",""+ci+"");
		}
		cons2 = (mapping)tar->query("liandan");
		for ( i=0; i<sizeof(cons2); i++ )
		{
			coni = keys(cons2)[i];
			conn = get_con_name(coni);
			ci = cons2[coni];
			msg += sprintf(YEL"%-21s%-10s\n"NOR,""+conn+"",""+ci+"");
		}
		msg += "─────────────\n";

		tell_object(me, msg);
	
	return 1;

}

int help(object me)
{
        write(@HELP
指令格式： jiemi
           jiemi <对象名称>             (巫师专用)

这个指令可以显示你的先天丹药状态。

HELP
        );
        return 1;
}
