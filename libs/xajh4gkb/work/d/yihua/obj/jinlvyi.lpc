//金缕衣-名器
#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name(HIM "金缕衣" NOR, ({ "jinlv yi", "cloth", "yi" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这是件质量上佳的金缕衣，它是由天使使用金片金丝亲手缝制的，全身金光闪闪。\n");
    set("wear_msg", HIY "劝君莫惜金缕衣，劝君须惜少年时。。\n" NOR);
    set("remove_msg", HIY "有花堪折直须折，莫待无花空折枝。\n" NOR);
    set("material", "cloth");
    set("value", 5000000);
    set("armor_prop/karma", 10);
    set("armor_prop/personality", 10);
    set("armor_prop/dodge", 10);
    set("armor_prop/armor", 600);
  }
  setup();
}
int query_autoload() { return 1; }
