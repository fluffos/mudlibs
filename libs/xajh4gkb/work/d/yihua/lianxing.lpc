// ROOM : lianxin.c
inherit ROOM;
void create() {
  set("short", "涟星宫");
  set("long", @LONG
这是邀月宫主休息的地方，只见一个身材奇好,貌美如花的女子站立在
花丛中,她就是武功奇高,身份神秘的移花宫大宫主。以前因为她的姐姐邀月
宫主被燕南天抛弃所以她非常恨男人，如果你是男人最好不要接近她。
LONG
  );
  set("exits", ([
    "east": __DIR__ "changlang1",
    "southeast": __DIR__ "woshi",
  ]));
  set("objects", ([
    "/kungfu/class/yihua/lianxing": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  object ob;

  ob = present("lian xing", environment(me));
  if (dir == "southeast") {
    if (ob && (string)me->query("gender") != "女性")
      return notify_fail("那边是姐姐的卧室，姐姐最讨厌男人了，你切莫进去！\n");
  }
  return ::valid_leave(me, dir);
}
