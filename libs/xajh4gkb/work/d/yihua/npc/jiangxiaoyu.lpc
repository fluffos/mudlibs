// huawuque.c
#include <ansi.h>
inherit NPC;

void create() {
  int jibie;
  jibie = 4000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("江小鱼", ({ "jiang xiaoyu", "jiang", "xiaoyu" }));
  set("long",
    "江小鱼从小在「恶人谷」长大，为人聪明绝顶、冷静乐观，沉着应变。\n" +
    "他的骗术更是一流，许多社会经验比他丰富许多的老江湖，都被他这个初出茅庐的小毛头耍得团团转。\n" +
    "实乃天下无双鬼灵精。\n");
  set("gender", "男性");
  set("title", HIG "「小魔星」" NOR);
  set("age", 24);
  set("attitude", "friendly");
  set("combat_exp", 8000000);
  set("shen_type", 0);
  set("str", 180);
  set("dex", 180);
  set("con", 180);
  set("int", 180);
  set("qi", 30000);
  set("max_qi", 30000);
  set("jing", 50000);
  set("max_jing", 5000);
  set("neili", 1000000);
  set("max_neili", 20000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jueqing-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("mingyu-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yihua-jiemu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yifeng-jian", 500 + jibie / 3 + random(jibie / 5));
  map_skill("unarmed", "jueqing-zhang");
  map_skill("force", "mingyu-shengong");
  map_skill("dodge", "yihua-jiemu");
  map_skill("parry", "yihua-jiemu");
  map_skill("sword", "yifeng-jian");
  set("chat_chance", 5);
  set("chat_msg", ({
    "小鱼儿笑嘻嘻说道：对付女人的法子，我总算知道了，你只要能打动她的心，她就会\n" + "像马一样乖乖地被你骑着，你要她往东，她就往东，要她往西，她就往西。\n",
    "小鱼儿大笑道：我也许是个坏蛋，但却绝不是孬种。别人想要我于什么都容易，但谁也休想叫我求饶。\n",
    "小鱼儿笑了笑道：一个人若是决心要走，谁也拉不住他的。\n",
  }));

  setup();
  carry_object("/d/yihua/obj/jinlvyi")->wear();
  carry_object("/clone/weapon/changjian")->wield();
  add_money("gold", 15);

}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  say("小鱼儿一见有人进来笑嘻嘻的说道：" + RANK_D->query_respect(ob)
    + "，你一个人来到恶人谷恐怕很危险啊。\n");
}

void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "移花宫" && me->query_temp("jm_yihua1") && me->query("family/master_id") == "yao yue") {  //移花宫解密
    tell_room(
      environment(this_player()),
      "小鱼儿动也不动，淡淡道：幸好我的心已被狗吃了，我真该谢谢那条狗，否则男人的心若被女人捏在手里，倒真不如被狗吃了算了。\n"
    );
    tell_room(environment(this_player()), "小鱼儿突然觉得心里甜了起来，全身飘飘然，就好像一跤跌进成堆的棉花糖里。\n");
    tell_room(environment(this_player()), "小鱼儿的心，火一般燃烧起来。\n");
    me->set_temp("jm_yihua5", 1);
  }
  ::die();
}
