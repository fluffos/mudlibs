//江枫
#include <ansi.h>
inherit NPC;

void create()
{
	int jibie;
	jibie = 7000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 0); 
	set_name("燕南天", ({ "yan nantian", "yan", "nantian"}));
	set("long",
	    "他被誉为「天下第一大侠」、「天下第一神剑」。 \n"+
	    "他是一位上无愧于天，下无愧于人的大英雄，平生从未做过一件见不得人的事，\n"+
	    "这样前不见古人，后不见来者的绝代英雄，恨他之人纵然要骂他也不知该如何骂起。\n"+
		"他为人心地善良、重情重义，只是性子又强又拗，不过也因此他才是江湖中最有男人气概的男子汉。\n");
	set("title", HIC"天下第一大侠"NOR);
	set("gender", "男性");
	set("age", 25);
	set("nickname", HIR "剑神" NOR);
	set("shen_type",1);
	set("attitude", "peaceful");
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("per", 40);
	set("kar", 30);
	set("qi", 40000);
	set("max_qi", 40000);
	set("jing", 20000);
    set("max_jing", 5000);
    set("neili", 1000000);
    set("max_neili", 20000);
	set("combat_exp", 30000000);
	set("score", 200000);
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("sword",500+jibie/3+random(jibie/5));
	set_skill("literate",500+jibie/3+random(jibie/5));
	set_skill("jueqing-zhang",500+jibie/3+random(jibie/5));
	set_skill("mingyu-shengong",500+jibie/3+random(jibie/5));
	set_skill("yifeng-jian",500+jibie/3+random(jibie/5));
	set_skill("yihua-jiemu",500+jibie/3+random(jibie/5));
	map_skill("unarmed", "jueqing-zhang");
	map_skill("force", "mingyu-shengong");
	map_skill("dodge", "yihua-jiemu");
	map_skill("parry", "yihua-jiemu");
	map_skill("sword","yifeng-jian");

	setup();
    carry_object("/clone/cloth/long_cloth")->wear();
	carry_object("/clone/weapon/changjian")->wield();
}

void die()
{
    object me;        
    me = query_temp("last_damage_from");
	if (me && (string)me->query("family/family_name") == "移花宫" && me->query_temp("jm_yihua6") && me->query("family/master_id")=="yao yue")
	{//移花宫解密
		tell_room(environment(this_player()), "世上只知嫁衣神功这种功夫取的乃是「为他人作嫁衣裳」之意，绝不可练，因为练成之后必须把功力转注他人，不然要日日夜夜受它的煎熬，可大家却不知另有一种秘诀却能练成真正的嫁衣神功！\n");
		tell_room(environment(this_player()), "其实嫁衣的本意是女人最美不过出嫁时，披挂嫁衣之女，此刻除去旧衣而穿新衣，犹如再世为人，需要放弃现在的生活环境而进入到新的生活环境中去。\n");
		tell_room(environment(this_player()), "舍得舍得，有舍才有得，这就是禅宗顿悟。\n");
		me->set_temp("jm_yihua7",1);
	}	
	::die();
}