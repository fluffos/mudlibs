//江枫
#include <ansi.h>
inherit NPC;

void create()
{
	int jibie;
	jibie = 3000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 0); 
	set_name("江枫", ({ "jiang feng", "jiang"}));
	set("long",
	    "他是千百年来江湖中最著名的美男子。陌上人如玉，公子世无双。 \n"+
	    "世上绝没有一个少女能抵挡江枫的微微一笑，江枫的笑，可令少女的心粉碎。\n"+
	    "他在夕阳下笑着，连夕阳都似失却了颜色。\n"+
		"江枫的笑哪怕是穿着粗俗的衣衫依旧可以让夕阳失去颜色。\n"+
		"让人自愧不如心神皆醉的风度气质、让少女能折断腰肢无法拒绝的迷人眼睛，\n"+
		"让万物失色的倾天下之笑，这就是豪富世家的公子江枫所具备的独一无二绝世风采。\n");
	set("title", HIC"天下第一美男子"NOR);
	set("gender", "男性");
	set("age", 25);
	set("nickname", HIR "玉郎" NOR);
	set("shen_type",1);
	set("attitude", "peaceful");
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("per", 40);
	set("kar", 30);
	set("qi", 40000);
	set("max_qi", 40000);
	set("jing", 20000);
    set("max_jing", 5000);
    set("neili", 1000000);
    set("max_neili", 20000);
	set("combat_exp", 30000000);
	set("score", 200000);
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("sword",500+jibie/3+random(jibie/5));
	set_skill("literate",500+jibie/3+random(jibie/5));
	set_skill("jueqing-zhang",500+jibie/3+random(jibie/5));
	set_skill("mingyu-shengong",500+jibie/3+random(jibie/5));
	set_skill("yifeng-jian",500+jibie/3+random(jibie/5));
	set_skill("yihua-jiemu",500+jibie/3+random(jibie/5));
	map_skill("unarmed", "jueqing-zhang");
	map_skill("force", "mingyu-shengong");
	map_skill("dodge", "yihua-jiemu");
	map_skill("parry", "yihua-jiemu");
	map_skill("sword","yifeng-jian");

	setup();
    carry_object("/clone/cloth/long_cloth")->wear();
	carry_object("/clone/weapon/changjian")->wield();
	add_money("gold",200);
}

void die()
{
    object me;        
    me = query_temp("last_damage_from");
	if (me && (string)me->query("family/family_name") == "移花宫" && me->query_temp("jm_yihua1") && me->query("family/master_id")=="yao yue")
	{//移花宫解密
		tell_room(environment(this_player()), "江枫咬牙道：好，你若要问我，我就告诉你，邀月她是一团火，一块冰，一柄剑，她甚至可说是鬼，是神，但绝不是人，而花月奴……\n"+"她却是人，活生生的人，她不但对我好，而且也了解我的心，世上只有她一人是爱我的心，我的灵魂，而不是爱我这张脸！？\n");
		tell_room(environment(this_player()), "江枫狂笑道：你们自以为了不起！你们自以为能主宰一切，但只要我死了，便可和月奴在一起，你们能阻挡得了么？\n");
		tell_room(environment(this_player()), "狂笑声中，江枫突然在地上滚了两滚，俯身在地，狂笑渐渐微弱．终于沉寂。\n");
		me->set_temp("jm_yihua3",1);
	}	
	::die();
}