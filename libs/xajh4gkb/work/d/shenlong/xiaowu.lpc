#include <ansi.h>
inherit ROOM;
string* books = ({
    "/clone/book/book-bamboo",
    "/clone/book/book-paper",
    "/clone/book/book-silk",
    "/clone/book/book-stone",
    "/clone/book/book-iron",
    "/clone/book/quanpu",
    "/clone/book/dujing_1",

});
void create()
{
    set("short", "小屋");
    set("long", @LONG
一进小屋,只见墙上挂满了无数名贵的字画.书架（shujia）上也堆满了
平时难得一见的各种各样的书籍.一个相貌英武的中年文士正对
着一幅字画唉声叹气.
LONG
    );
    set("exits", ([
        "south" : __DIR__"kongdi",
    ]));
    set("objects", ([
        "/d/shenlong/npc/lu": 1,
		"/d/obj/quest/chai2": 1,
        books[random(sizeof(books))] : 1,
        books[random(sizeof(books))] : 1,
    ]));
    set("outdoors", "shenlong");
    setup();
   replace_program(ROOM); 
}

void init()
{
	add_action("do_push","push");
}

int do_push(string arg)
{
	object me=this_player();

	if( !arg || arg!="shujia")
	{
		write("你要推什么呀。\n");
		return 1;
	}

	if (!me->query_temp("jm_shenlong5") || me->query("family/family_name") != "神龙教" || me->query("family/master_id") != "hong antong")
		return notify_fail(HIR"陆高轩说道：这位" + RANK_D->query_respect(me) + "好象没有得到洪教主的允许吧？\n");
	
	message_vision("$N在书架前站定，深吸一口气，两手紧握住书架。\n", me);
	if(me->query("xyzx_sys/level") >= 2000 && me->query_skill("force",1)>=2000 && me->query("max_neili")>1000000 )
	{
		message_vision(HIC"$N丹田一运气，猛的一推，只见书架之后，露出一条长长的甬道。\n", me);
		set("exits/enter", "/d/shenlong/neiwu");
		remove_call_out("close");
		call_out("close",5, this_object());
	}
	else
	{
		message_vision("$N丹田一运气，猛的一推，书架却纹丝不动，$N被一股力量反震。\n", me);
		me->unconcious();
	}
	return 1;
}
void close(object room)
{
	message("visoin", "书架自动又合上了。\n", room);
	room->delete("exits/enter");
}