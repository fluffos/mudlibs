// shu-sheng.c
inherit NPC;
void create()
{
	int jibie;
	jibie = 60;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
    set_name("书生", ({ "shu sheng", "sheng" }) );
    set("gender", "男性" );
    set("age", 22);
    set("int", 28);
    set("long",
        "这是个饱读诗书，却手无搏鸡之力的年轻书生。\n");
    set("attitude", "peaceful");
    set_skill("literate", 700);
    set("class","scholar");
    setup();
    carry_object("/clone/cloth/cloth")->wear();
}
