// Room: /d/taishan/.c
// Date: CSWORD 96/03/25
inherit ROOM;
void create()
{
    set("short", "岱宗坊");
    set("long", @LONG
位于泰安县城以北约一里，此处是登泰山的入口。相传当年碧
霞元君被姜子牙戏弄，诱她投掷绣花鞋以定泰山地界，结果碧霞元
君只能把绣花鞋从山顶掷到此处。从此泰山便以此为起点。
LONG
    );
    set("exits", ([
        "northup" : __DIR__"baihe",
        "south" : __DIR__"yidao3",
    ]));
    set("objects",([
		"/quest/quest1/yishi" : 1,
    ]));	
    set("outdoors", "taishan");
    setup();
    replace_program(ROOM);
}

void init()
{
    add_action("do_tianfu", "tianfu");
    add_action("do_tizhi", "tizhi");
}
int do_tianfu(string arg)
{
    object me;
    me = this_player();
    if ( !arg || arg !="天赋")
        return notify_fail("什么？\n");
	if(!wizardp(me))
        return notify_fail("你想作死吗？\n");
	switch ( random(9) )
	{
		case 0: me->set("inborn",BLU"精准"NOR);
			break;
		case 1: me->set("inborn",HIC"敏捷"NOR);
			break;
		case 2: me->set("inborn",HIG"灵动"NOR);
			break;
		case 3: me->set("inborn",HIY"铁壁"NOR);
			break;
		case 4: me->set("inborn",HIB"猛攻"NOR);
			break;
		case 5: me->set("inborn",HIM"强壮"NOR);
			break;
		case 6: me->set("inborn",HIR"鹰眼"NOR);
			break;
		case 7: me->set("inborn",YEL"冷静"NOR);
			break;
		case 8: me->set("inborn",CYN"专注"NOR);
			break;			
	}
    write(HIR"恭喜你觉醒天赋："+me->query("inborn")+HIR"。\n"NOR);
    return 1;
}
int do_tizhi(string arg)
{
    object me;
    me = this_player();
    if ( !arg || arg !="体质")
        return notify_fail("什么？\n");
	if(!wizardp(me))
        return notify_fail("你想作死吗？\n");
	switch ( random(7) )
	{
		case 0: if(me->query("gender")=="女性") me->set("body",HIM"姹女媚体"NOR);
				else
				{
					if(random(2)==0) me->set("body",HIR"玄阳龙体"NOR);
					else me->set("body",CYN"阴阳魔胎"NOR);
				}
			break;
		case 1: me->set("body",HIC"太阴灵体"NOR);
			break;
		case 2: me->set("body",HIG"苍天霸体"NOR);
			break;
		case 3: me->set("body",HIY"太上仙体"NOR);
			break;
		case 4: me->set("body",HIB"幽冥邪胎"NOR);
			break;
		case 5: me->set("body",HIM"先天道胎"NOR);
			break;
		case 6: me->set("body",RED"厄难毒体"NOR);
			break;		
	}
    write(HIR"恭喜你获得体质："+me->query("body")+HIR"。\n"NOR);
    return 1;
}