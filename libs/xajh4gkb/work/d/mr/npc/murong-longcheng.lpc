
inherit NPC;
inherit F_MASTER;

void create()
{
	int jibie;
	jibie = 8000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name(HIW"慕容龙城"NOR,({"murong longcheng","murong","longcheng"}));
	set("title","慕容氏族长");
	set("nick",HIC"斗转星移"NOR);
	set("long",  "他是一位武学奇才，独创“斗转星移”绝技，纵横江湖，当世无敌。\n");
	set("age", 57);
	set("attitude", "peaceful");
	set("shen_type", 0);
	set("str", 40);
	set("int", 40);
	set("con", 40);
	set("dex", 40);
	set("max_qi", 4500);
	set("max_jing", 4500);
	set("neili", 4500);
	set("max_neili", 4500);
	set("wuyongjiali", 0);
	set("combat_exp", 20000000);
	set("score", 50000);                
	set_skill("unarmed",500+jibie*2+random(jibie/2));
	set_skill("dodge",500+jibie*2+random(jibie/2));
	set_skill("force", 500+jibie*2+random(jibie/2));
	set_skill("canhe-zhi", 500+jibie*2+random(jibie/2));
	set_skill("murong-jianfa",500+jibie*2+random(jibie/2));       
	set_skill("shenyuan-gong", 500+jibie*2+random(jibie/2));
	set_skill("yanling-shenfa", 500+jibie*2+random(jibie/2));
	set_skill("douzhuan-xingyi", 500+jibie*2+random(jibie/2));
	set_skill("parry", 500+jibie*2+random(jibie/2));
	set_skill("sword", 500+jibie*2+random(jibie/2));
	set_skill("literate", 500+jibie*2+random(jibie/2));
	set_skill("murong-daofa", 500+jibie*2+random(jibie/2));
	set_skill("blade",500+jibie*2+random(jibie/2));
	set_skill("xingyi-zhang",500+jibie*2+random(jibie/2));
	map_skill("blade", "murong-daofa");
	map_skill("unarmed", "canhe-zhi");
	map_skill("force", "shenyuan-gong");
	map_skill("dodge", "yanling-shenfa");
	map_skill("parry", "douzhuan-xingyi");
	map_skill("sword", "murong-jianfa");
	create_family("姑苏慕容",5,"族长");
	
	setup();
	carry_object("/clone/weapon/gangjian")->wield();
}


void attempt_apprentice(object ob)
{
	if (ob->query_skill("parry", 1) < 1000) 
	{
		command("say 我姑苏慕容以彼之道、还施彼身对招架要求甚高，小兄弟似乎不宜学习。");
		command("say " + RANK_D->query_respect(ob) + "的功力不够，还是请回吧。");
		return;
	}
	if (ob->query("int", 1) < 30) 
	{
		command("say 我姑苏慕容以彼之道、还施彼身没有一定的悟性是难以领会的。");
		return;
	}	
	if (ob->query("dex", 1) < 30) 
	{
		command("say 我姑苏慕容斗转星移靠的就是身法，以你这种资质难以学会。");
		return;
	}	
	if (ob->query("score",1) < 100000) 
	{
		command("say 我慕容世家肩负燕国重任，你看起来想大宋奸细？");
		return;
	}	
	if ((int)ob->query("xyzx_sys/level",1)<1000)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
        command("say 是否应该去江湖中多加磨炼。");
		return ;
    }
	if (ob->query_skill("shenyuan-gong", 1) < 1000) 
	{
		command("say 我姑苏慕容以彼之道、还施彼身对内功心法要求甚高，小兄弟似乎不宜学习。");
		command("say " + RANK_D->query_respect(ob) + "的功力不够，还是请回吧。");
		return;
	}
	if (ob->query_skill("douzhuan-xingyi", 1) < 1000) 
	{
		command("say 我姑苏慕容以斗转星移名震天下，我看你还未练到家吧。");
		command("say " + RANK_D->query_respect(ob) + "对我慕容家武学只是练了个皮毛，还是请回吧。");
		return;
	}
	command("say 罢了，看你还是个学武的料，我就收下你吧！");
	command("say 苍天在上，让我姑苏慕容又得一良材，为复兴我大燕多了一份力量。");
	command("chat# 朗声说道：老夫我又收一良材，大燕兴复指日可待啦！");
	command("chat* haha"); 
	command("recruit " + ob->query("id"));
	ob->set("title","以彼之道 还施彼身");
	
//	command("say 武功学的再高也不能复兴大燕，收徒何用。");
//	command("say 我不收徒的，你去江南姑苏慕容家看看吧。");
}

void kill_ob(object me)
{
	if(!this_player())
	{
		::kill_ob(me);
		return;
	}
	if(this_player()->query("family/family_name") == "姑苏慕容" && this_player()->query_temp("jm_murong9"))
	{
		command("say 你可要小心了，拿出你毕生功力来杀我，唯有生死之间方能领悟以彼之道还施彼身的精髓。\n");
		::kill_ob(me);
	}
}
void die()
{
    object ob, me;        
    ob = this_object();
    me = query_temp("last_damage_from");
	if (me && me->query("family/family_name") == "姑苏慕容" && me->query_temp("jm_murong9") && !me->query("jm/murong"))
	{ 
		message_vision(HIG"慕容龙城说道：你不必难过，要想领悟斗转星移的精髓，只能在生死一线之间领悟。\n", this_object());
		me->set("jm/murong",1);
		me->add("family_score",1);
		message_vision(HIG"你在生死一线中你体会到了以彼之道还施彼身的精髓。\n", this_object());
		message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，在长白山雪山之巅与慕容龙城的决斗之中，于生死一线之间领悟到了以彼之道还施彼身的精髓！\n"NOR,users() );
	}
	::die();
}