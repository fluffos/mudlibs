//碧玉刀-名器

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
        set_name("碧玉刀",({ "biyu dao", "biyu", "dao", "blade" }) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 100000);
                set("treasure",1);
                set("material", "steel");
                set("long", "这是把镶着七颗翡翠的宝刀，乃江湖七种武器之一，象征着诚实。\n"+"刀身上隐隐的透出碧玉之光，当真锋利无比。\n");
                set("wield_msg", HIC "只听见「嗡」地一声，壁光闪现，$N将腰间解下的$n抖得笔直。\n" NOR);
                set("unwield_msg", HIC "碧玉刀幻作一道碧玉之光，「唰」地飞入刀鞘。\n" NOR);
//                set("unequip_msg", HIC "碧玉剑幻作一道碧玉之光，「唰」地飞入剑鞘。\n" NOR);
		set("weapon_prop/force", 20);
		set("weapon_prop/blade", 30);
		set("weapon_prop/dodge", 10);
		set("weapon_prop/unarmed", 20);
		set("weapon_prop/parry", 10);
        }
		init_blade(500,2);
        setup();
}
int query_autoload() { return 1; }
