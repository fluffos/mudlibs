// update beyond
inherit ITEM;
#include <ansi.h>
void create() {
  set_name(HIW "画像" NOR, ({ "hua xiang" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "这是一卷画像，上面画有一女子，温婉动人、恬静淡泊、与世无争的柔情女子。\n");
    set("value", 0);
    set("no_get", 1);
    set("no_drop", 1);
    set("material", "paper");
  }
  setup();
}
int query_autoload() { return 1; }
