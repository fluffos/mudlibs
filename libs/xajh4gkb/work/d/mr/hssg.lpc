#include <ansi.h>
#include <room.h>
#include <skill.h>
inherit ROOM;
void create()
{
         set("short","还施水阁");
         set("long",
"这就是举世闻名的姑苏慕容的还施水阁，这里据说有很多武林人事向\n"
"往以久的武功。只见墙上有一个书架子(shujia)，上面摆满了各种武籍。\n"
);
         set("exits",([
             "south" : __DIR__"jiabi",
]));
         set("item_desc", ([
             "shujia" : "书架上各个门派的武功秘籍(miji)，你忍不住想拿起一本就翻看起来。\n",
]));
}

int init()
{
        add_action("do_kan","kan");  
        add_action("do_kan","du");
        add_action("do_kan","yandu");
        add_action("do_kan","lingwu");
        add_action("do_kan","study");
}

int do_kan(string arg)
{         
	object me;
	int flag,xtdex,jineng_exp_add;
	me = this_player();

    if ( !living(this_player()) || arg != "miji" )
		return 0;
	if (me->is_busy())
		return notify_fail("你现在正忙着呢！\n");
	if (me->query("family/master_name")!="慕容复" && me->query("family/master_name")!="慕容博" && me->query("family/master_name")!="慕容龙城")
        return notify_fail("你不是慕容家嫡系弟子，如何能进入这还施水阁，我看你是奸细吧。\n");
    if ( (int)me->query_skill("literate", 1) < 1000)
        return notify_fail("你是个文盲，先学点文化(literate)再领悟斗转星移吧。\n");
    if ( (int)me->query_skill("parry", 1) < 1000 )
		return notify_fail("凭你现在的招架功夫，无法领悟斗转星移这么高深的武功。\n");
    if ((int)me->query_skill("douzhuan-xingyi", 1) < 450)
        return notify_fail("你看了半天书架上的武功秘籍，结果对你来说太深奥了！\n");
//	if ((int)me->query_skill("douzhuan-xingyi", 1) > 5000)
//		return notify_fail("恭喜恭喜！你已经融会贯通了斗转星移的绝妙之处！\n");
    if( (int)me->query_skill("douzhuan-xingyi", 1)>(me->query("xyzx_sys/level")+100)*2 )
        return notify_fail("你的实战经验不够，无法领悟更高深的斗转星移！\n");

    if ( (int)me->query("jing")<30)
	{
		me->receive_damage("jing", 10);
        write("你太累了，已经没有力气来领悟斗转星移了！\n");              
        return 1;
	}
	xtdex = (int)me->query("dex",1);

	if(me->query("xyhy_type")==2) flag = 5/4;	//2016.6.20阿飞改，黄金会员自练速度为1.25倍
	else flag = 1;
	if (me->query_temp("jineng_exp_add")) jineng_exp_add = (int)me->query_temp("jineng_exp_add",1);	//处于技能自练提升状态时
	else jineng_exp_add = 0;	
	
	me->start_busy(1);
	me->receive_damage("jing", random(50));
	message_vision("$N正在低头沉思有关斗转星移的种种疑难。\n", me);  
	write("你静静地钻研各家门派的武功秘籍，冥冥之中你的斗转星移又进了一步。\n");  
	me->improve_skill("douzhuan-xingyi", 100 + (int)me->query_skill("parry",1)/5*(jineng_exp_add+100)/100*xtdex*flag*12/10);		
	return 1;
}
