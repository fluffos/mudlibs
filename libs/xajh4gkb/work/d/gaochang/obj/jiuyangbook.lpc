inherit ITEM;
void create() {
  set_name("楞伽经", ({ "lengqie jing", "shu", "book" }));
  set_weight(50);
  set("no_drop", "这样东西不能离开你。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "     这是一册佛经。经文夹缝中写着一些字迹模糊的字句，似乎提到一些呼吸方法什麽的。\n");
    set("value", 500);
    set("material", "silk");
    set("skill", ([
      "name": "buddhism",     // name of the skill
      "exp_required": 0,      // minimum combat experience required
      "jing_cost": 20,     // jing cost every time study this
      "difficulty": 20,     // the base int to learn this skill
      "max_skill": 200      // the maximum level you can learn
    ]));

  }
}
void init() {
  if (this_player() == environment()) {
    add_action("do_study", "study");
    add_action("do_study", "du");
  }
}
int do_study(string arg) {
  int nf, nh, skl_level;
  object me;
  me = this_player();
  if (!arg || arg != "jiafeng")
    return notify_fail("你要读什么？\n");
  if (me->is_busy()) {
    tell_object(me, "你现在正忙着呢。\n");
    return 1;
  }
  /*	if ( me->query("couple") || me->query("make_loves"))
	{	
        tell_object(me,"你已经破了色戒，无法再学习易经！\n");
        return 1;
    }
    if ( me->query("gender") != "男性" )
	{
        tell_object(me,"你非童男之体，不能学习易经内功。\n");
        return 1;
    }*/
  skl_level = me->query_skill("yijing-force", 1);
  if ((int)me->query("combat_exp") < (int)skl_level * skl_level * skl_level / 20) {
    write("你的实战经验不足，再怎么读也没用。\n");
    return 1;
  }

  nf = (int)me->query_skill("force", 1);
  nh = (int)me->query_skill("yijing-force", 1);
  if (nf < 100) {
    tell_object(me, "你的基本内功火候还不够，无法领会易经。\n");
    return 1;
  }
  if (nh > 100 && nh > nf / 4) {
    tell_object(me, "这本书只能学到这里为止了，绝世武学还是要靠自己参悟。\n");
    return 1;
  }

  if (me->is_fighter()) {
    tell_object(me, "战斗中无法阅读新知！\n");
    return 1;
  }
  if (me->query("jing") > 20) {
    me->receive_damage("jing", 20);
    me->improve_skill("yijing-force", (me->query_skill("yijing-force") + me->query_int(1)));
  }
  message_vision("$N正在专心研读易经心法。\n", me);
  return 1;
}
int query_autoload() { return 1; }
