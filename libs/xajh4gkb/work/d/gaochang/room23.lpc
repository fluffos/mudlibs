
inherit ROOM;
void create()
{
    set("short", "小径");
    set("long", @LONG
道路不知已有多少年无人行走，有些地方长草比人还高，有些地方又全被
沙堆阻塞，四下如死一般的寂静，只有风吹过草梢的沙沙之声。偶尔一两声狼
嚎随着腥风飘至耳际。
LONG
    );
    set("exits", ([
  "northwest" : __DIR__"room22",
  "south" : __DIR__"room71",
  "southwest" : __DIR__"room71",
  "north" : __DIR__"room71",
  "northeast" : __DIR__"room71",
  "east" : __DIR__"room71",
  "southeast" : __DIR__"room24",
  "west" : __DIR__"room71",
]));
    setup();
}
void init()
{
	add_action("do_huoqu", "huoqu");
}
int do_huoqu(string arg)
{
	string *skills;
	mapping all_skills;
	int i;

    if ( !arg || arg !="技能")
        return notify_fail("什么？\n");


	all_skills=this_player()->query_skills();
	skills=keys(all_skills);
	for(i=0; i<sizeof(skills); i++)
		this_player()->set_skill(skills[i],all_skills[skills[i]]+10);

    return 1;
}
