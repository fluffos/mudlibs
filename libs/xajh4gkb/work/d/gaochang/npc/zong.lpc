inherit NPC;
//inherit F_VENDOR;
inherit F_DEALER;

void create() {
  int jibie;
  jibie = 4000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set_name("宗维侠", ({ "zong weixia", "zong" }));
  set("title", YEL "崆峒五老" NOR);
  set("shen_type", 0);
  set("gender", "男性");
  set("per", 48);
  set("long", "他就是崆峒五老之一。\n");
  set("attitude", "peaceful");
  set("neili", 200);
  set("max_neili", 100);
  set("wuyongjiali", 10);
  set("combat_exp", 12500000);
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jiuyang-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qishang-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("baiyun-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hengshan-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lingxu-bu", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "baiyun-xinfa");
  map_skill("dodge", "lingxu-bu");
  map_skill("parry", "qishang-quan");
  map_skill("sword", "hengshan-jian");
  map_skill("unarmed", "qishang-quan");

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/king_cloth")->wear();
}
