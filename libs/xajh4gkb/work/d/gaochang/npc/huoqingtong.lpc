//蝶舞门解密
int ask_kasili()
{
	object me;
	me = this_player();
	
	if ((string)me->query("family/family_name") == "舞蝶仙" && (string)me->query("family/master_id")=="qiong yadie" && (int)me->query_temp("jm_wudie1"))
	{
		message_vision(HIG"霍青桐说道：那是我族香香公主，回族人民心中的圣洁的天使。\n" NOR,me);
		message_vision(HIG"霍青桐说道：陈家洛...哎...不要提她了。\n" NOR,me);
		message_vision(HIG"霍青桐说道：没想到陈家洛为了光复汉人江山，竟将喀丝丽送给乾隆作交易！\n" NOR,me);
		message_vision(HIG"霍青桐说道：我现在只想看见陈家洛和乾隆的人头！\n" NOR,me);
		me->set_temp("jm_wudie2",1);
	}
	else 
	{		
		message_vision(YEL"霍青桐说道：喀丝丽是我的妹妹，天真烂漫，善良仁爱，纯洁无暇！\n" NOR,me);	
	}
	
	return 1;
}
int accept_object(object me, object ob)
{
	if ( (string)ob->query("id") =="chenjialuo rentou" )
	{
		if ( (string)me->query("family/family_name") == "舞蝶仙" && (string)me->query("family/master_id")=="qiong yadie" && me->query("id")==ob->query("owner") && (int)me->query_temp("jm_wudie2"))
		{
			message_vision(HIC"霍青桐说道：这陈家洛！我不想再提了。\n"NOR, me);
			message_vision(HIC"霍青桐痛哭道：喀丝丽之仇不可不报！！！\n"NOR, me);
			message_vision(HIC"霍青桐说道：恩怨纠缠，如云烟过眼，只留满地伤。\n"NOR, me);
			me->set_temp("jm_wudie3",1);
			if ((int)me->query_temp("jm_wudie4")) 
			{
				message_vision(HIC"霍青桐说道：喀丝丽大仇今日得报，是是非非我已经不想再提了，你回去吧。\n"NOR, me);
				me->set_temp("jm_wudie5",1);
			}
			return 1;
		} else
		{
			message_vision(HIC"霍青桐大怒道：那是我爱慕之人......\n"NOR,me);
			return 1;
		}
	}
	if ( (string)ob->query("id") =="qianlong rentou" )
	{
		if ( (string)me->query("family/family_name") == "舞蝶仙" && (string)me->query("family/master_id")=="qiong yadie" && me->query("id")==ob->query("owner") && (int)me->query_temp("jm_wudie2"))
		{
			message_vision(HIC"霍青桐说道：中原皇帝，俱是好色之徒。\n"NOR, me);
			message_vision(HIC"霍青桐说道：我族宁为玉碎，也不会将喀丝丽作为交易！\n"NOR, me);
			message_vision(HIC"霍青桐说道：好！好！好！。\n"NOR, me);
			me->set_temp("jm_wudie4",1);
			if ((int)me->query_temp("jm_wudie3")) 
			{
				message_vision(HIC"霍青桐说道：喀丝丽大仇今日得报，是是非非我已经不想再提了，你回去吧。\n"NOR, me);
				me->set_temp("jm_wudie5",1);
			}
			return 1;
		} else
		{
			message_vision(HIC"霍青桐笑道：皇帝死了...死的好...\n"NOR,me);
			return 1;
		}
	}
	return 0;
}