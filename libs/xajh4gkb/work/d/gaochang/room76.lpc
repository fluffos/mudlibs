inherit ROOM;
void create() {
  set("short", "山谷");
  set("long", @LONG
这是一处山谷出口，谷中芳草鲜美，落英缤纷，一层淡淡的薄
雾，混合着青青的草香，弥漫在空气之中。偶尔的一两声鸟鸣，愈发
地显出幽静来。林边有一石山，山边立有一石碑，上书“恶人谷”。
然来江湖上最可怕的地方居然就在这里。
LONG
  );

  set("exits", ([
    "out": __DIR__ "room75",
    "enter": __DIR__ "room77",
  ]));
  set("outdoors", "kunlun");
  set("item_desc", ([
    "石碑": "恶人谷，恶人谷，一入此谷，永不受苦。\n",
  ]));
  setup();
}
