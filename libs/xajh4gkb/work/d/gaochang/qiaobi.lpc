// Room: /d/huashan/lianhua.c

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "峭壁");
  set("long", @LONG
行到了一座大山之侧，只见半山腰里峭壁之上，生着两朵海碗般大的奇花，
花瓣碧绿，四周都是积雪，白中映碧，加上夕阳金光映照，娇艳华美，奇丽万状。
闻到幽幽甜香，从峭壁上飘将下来，那花离地约有二十余丈，仍然如此芬芳馥郁，
足见花香之浓。瞧那峭壁，但见峨然耸立，气象森严。昔日昆仑祖师在此创立了
昆仑一脉绝学，你可以在这里试着参悟（canwu）一番，看能否领悟到什么。
LONG
  );
  set("exits", ([
  ]));
  set("no_clean_up", 0);
  set("outdoors", "hangzhou");

  setup();
}


//昆仑派解密
void init() {
  add_action("do_canwu", "canwu");
}

int do_canwu(string arg) {
  object me = this_player();
  int ap;

  string *poem = ({
    "突然滴溜溜的转身，一招" HIG "「天山雪飘」" NOR "，掌影飞舞",
    "剑芒吞吐，幻若灵蛇，右手使出一式" HIB "「云含吞吐」" NOR "，剑势曼妙",
    "手中长剑锵啷啷长吟一声，一式「" + BLU + "神雕找食" + NOR + "」，头上脚下洒攻而下，攻势之疾，无以伦比",
    "错步上前，使出「" + RED + "银雨飞花" + NOR + "」，手中长剑登时剑芒暴射，宛如漫天瑞雪",
    "掌风激荡，双掌错落，来势神妙无方，一招" HIM "「日入空山」" NOR "，飘忽若神",
    "摆出一张古筝，铮铮琮琮弹了几声，只听得曲调平和，洋洋洒洒，颇有佳意。",
    "雅兴大发，竟弹起曲子来，你只觉得时而金戈铁马、大漠平沙。。。",
    "摆出一张棋盘，只觉棋面布局尽在筹幄只之中，无密可研。",
    "雅兴大发，竟打起棋谱来，对外界仿佛不闻不问，一副莫测高深的模样。",
    "你摆出一张棋盘，研究起围棋来，只觉得心平气和，很快就仿佛入定了。",
    "摆出一张古筝，弹了起来，时而小桥流水、几户人家。。。万般气象，你心情顿时宁静了许多。",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫参悟哦.....\n");
  if (me->is_fighting())
    return notify_fail("你静不下心来，还能参悟呢.....\n");
  if (me->query("family/family_name") != "昆仑派")
    return notify_fail("你不是昆仑弟子，如何能参悟昆仑师祖的心得？？？\n");
  if ((int)me->query_skill("literate", 1) < 5000)
    return notify_fail("你一脸茫然，有不少文字似乎不认识。\n");
  if ((int)me->query_skill("art", 1) < 2000)
    return notify_fail("你的艺术修养不够，难以领会昆仑三圣意境。\n");
  if ((int)me->query_skill("qidao", 1) < 2000)
    return notify_fail("你摆出棋盘，还未走得几手，已是十面埋伏。\n");
  if ((int)me->query_skill("sword", 1) < 5000)
    return notify_fail("以你的剑道修养，恐怕难以领会昆仑剑法的精妙。\n");
  if ((int)me->query_skill("xunlei-sword", 1) < 2000)
    return notify_fail("你随手使出一剑，然而难以达到疾如风雷如电的境界。\n");
  if ((int)me->query_skill("liangyi-jian", 1) < 2000)
    return notify_fail("你脚踏八卦，剑走两仪，似乎不够娴熟。\n");
  if ((int)me->query_skill("xuantian-wuji", 1) < 1000)
    return notify_fail("你对昆仑内功修炼不到家。\n");
  if (me->query("neili") < 1000)
    return notify_fail("你累的不轻，还是先休息一会儿吧。\n");
  if (me->query("jm/kunlun"))
    return notify_fail("你已经完全领悟了昆仑派的武学精髓。\n");
  if (!me->query_temp("jm_kunlun7"))
    return notify_fail("你未得到昆仑三圣的指点。\n");

  ap = me->query("kar", 1);
  message_vision(
    "$N一会儿" + poem[random(sizeof(poem))] + "，\n然后" + poem[random(sizeof(poem))] + "\n",
    me
  );
  tell_object(me, HIW "你于宁静中体会昆仑巍峨，于山风中领略昆仑之厚重......\n" NOR);
  me->improve_skill("sword", 50 + random(10));
  me->add("neili", -100);
  me->start_busy(1);

  if (random(100000) < ap) {
    me->set("jm/kunlun", 1);
    me->add("family_score", 1);
    tell_object(me, HIR "恭喜你领悟了昆仑派的武学精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，掉入昆仑山悬崖侥幸未死，在昆仑山峭壁中领悟了昆仑派的绝世武功！\n" NOR,
      users()
    );
  }
  return 1;
}
