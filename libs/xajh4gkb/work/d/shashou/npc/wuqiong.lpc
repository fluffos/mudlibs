// wuqiong.c  伍穷

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  int jibie;
  jibie = 4000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("伍穷", ({ "wu qiong", "wu" }));
  set("nickname", HIB "败刀" NOR);
  set("long",
    "这时个长满胡须的男子，身披青色长衫，外表看似个平凡的汉子。\n"
    "但眉目之间散发着一股挺拔之气，整个人就象一头猛虎。\n");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "heroism");
  set("shen_type", 1);
  set("str", 28);
  set("int", 28);
  set("con", 28);
  set("dex", 28);

  set("max_qi", 1500000);
  set("max_jing", 1000000);
  set("neili", 10000000);
  set("max_neili", 3000);
  set("wuyongjiali", 20000);
  set("combat_exp", 1200000000);
  set("score", 70000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuji-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("bugui-bufa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("liujue-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));

  map_skill("force", "wuji-shengong");
  map_skill("dodge", "bugui-bufa");
  map_skill("parry", "liujue-dao");
  map_skill("blade", "liujue-dao");

  create_family("杀手楼", 2, "大杀手");

  set("chat_chance_combat", 300);
  set("chat_msg_combat", ({
    (: perform_action, "blade.wuqin" :),
    (: exert_function, "recover" :),
  }));

  setup();
  carry_object("/clone/weapon/blade")->wield();
  carry_object("/d/wudang/obj/greyrobe")->wear();

}

void attempt_apprentice(object ob) {
  if ((int)ob->query("combat_exp") < 100000000) {
    command("say 杀手是提着脑袋过日子的事，所以江湖经验一定要丰富。");
    return;
  }
  if ((int)ob->query("str", 1) < 30) {
    command("say 杀手楼的功夫都是一击毙命，所以招式势大力沉，你这体格明显使不出来。");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 500) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，如何杀的了江湖高手。");
    return;
  }
  if (ob->query_skill("wuji-shengong", 1) < 500) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我杀手楼的内功掌握不够精通。");
    command("say 是否应该多在这上面下点功夫。");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "shashou") ob->set("class", "shashou");
  return;
}
