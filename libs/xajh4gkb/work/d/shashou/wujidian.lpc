// hupan.c
#include <room.h>
inherit ROOM;

string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});

void create() {
  set("short", "无极殿");
  set("long", @LONG
这里是杀手楼的无极殿，殿内立着四根盘龙柱，四周摆放着不少书架，
书架上摆放着不少古卷，或许收藏着什么秘籍。杀手楼历代楼主会经常
来这里博览群书（liulan)，或许能领悟到什么。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "down": __DIR__ "yilou.lpc",
  ]));
  //        set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_liulan", "liulan");
}

int do_liulan(string arg) {
  object me = this_player();

  string *poem = ({
    "你翻出一本书，居然是庄子的《逍遥游》：北冥有鱼，其名为鲲。鲲之大，不知其几千里也；化而为鸟，其名为鹏。鹏之背，不知其几千里也...",
    "你翻出一本书，赫然印着《道德经》：道可道，非常道；名可名，非常名。无名，万物之始，有名，万物之母。",
    "你翻出一本书，发现是《易筋经》：一曰清虚，一曰脱换。能清虚则无障，能脱换则无碍。无碍无障，始可入定出定矣。知乎此，则进道有其基矣。所云清虚者，洗髓是也；脱换者，易筋是也。",
    "你翻出一本书，没想到只是一本普通的《论语》。",
    "你翻出一本书，然而是本无字天书，你随手就放了回去。",
    "你翻出一本书，竟然画着不少......你看的津津有味。",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫浏览群书......\n");
  if (!me->query_temp("jm_shashou5"))
    return notify_fail("你未得到楼主的许可吧。\n");
  if (me->query("jm/shashou"))
    return notify_fail("你已经完全领悟了惊天一剑的精髓，不需要在这领悟了。\n");
  if (me->query("family/family_name") != "杀手楼")
    return notify_fail("不是杀手楼的弟子，是如何进入此地的？\n");

  if (me->query_skill("wuji-shengong", 1) < 1000) {
    tell_object(me, "你的无极神功.......\n");
    return 1;
  }
  if (me->query_skill("qingyi-jian", 1) < 2000) {
    tell_object(me, "你的情义剑法.......\n");
    return 1;
  }
  if (me->query_skill("wushuang-jian", 1) < 2000) {
    tell_object(me, "你的无双剑法.......\n");
    return 1;
  }
  if (me->query("jingli") < 1000) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }

  tell_object(me, HIW "你拿起一本书册，翻阅起来......\n" NOR);
  message_vision("" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -500);
  me->start_busy(2);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/shashou", 1);
    me->add("family_score", 1);
    tell_object(me, HIB "你突然醒悟道：" HIY "原来情义无双剑可以有此等威力" HIR "！\n" NOR);
    tell_object(me, HIB "恭喜你融汇贯通了杀手楼武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在无极殿居然领悟了杀手楼的惊天一剑！\n" NOR,
      users()
    );
  }
  return 1;
}
