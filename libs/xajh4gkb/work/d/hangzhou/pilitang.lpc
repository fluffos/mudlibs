#include <room.h>
inherit ROOM;
void create()
{
        set("short", "霹雳堂");
        set("long", @LONG
这里是赫赫有名的【霹雳堂】，以火药闻名大江南北，富可敌国。
霹雳堂占地面积极广，经过几代家主经营，开辟了火药、炸药、
暗器、毒药、机关等分堂。
LONG);
        set("exits", ([
			"west"     : __DIR__"maojiabu",
        ]));
        set("objects", ([
            "/d/tangmen/npc/leizhentian" : 1,
        ]));
        set("outdoors", "hangzhou");
//        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
