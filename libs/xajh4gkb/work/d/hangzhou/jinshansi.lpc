#include <room.h>
inherit ROOM;
void create() {
  set("short", "金山寺");
  set("long", @LONG
金山寺乃得到高僧法海修行之地，法海修炼成仙，被封为道德法师。
由于白蛇与许仙人妖相恋，导致水漫金山造成人间惨剧。法海下山抓妖，
建雷峰塔镇妖。民间将这一神话故事与杭州西湖神话相联系，形成了完
整而优美的民间故事《白蛇传》。许仙被囚和《水漫金山》故事的流传，
使金山寺名播四海。
LONG);
  set("exits", ([
    "down": __DIR__ "xizhaoshan",
    //			"enter"   : "/d/leifengta/leifengta",
  ]));
  set("objects", ([
    "/d/leifengta/npc/fahai": 1,
    "/d/leifengta/npc/xiaoqing": 1,
    "/d/leifengta/npc/xuxian": 1,
    "/d/leifengta/npc/seng1": 1,
    "/d/leifengta/npc/seng2": 1,
  ]));
  set("outdoors", "hangzhou");
  set("no_clean_up", 0);
  setup();
}
