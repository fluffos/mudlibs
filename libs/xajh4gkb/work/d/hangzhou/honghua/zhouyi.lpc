// zhouyi.c 周绮
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("周绮", ({ "zhou yi", "zhou","yi" }));
	set("title", HIC "铁胆庄"HIM"大小姐" NOR);
	set("nickname", HIB "俏李逵" NOR);
	set("long", 
"这是铁胆庄的大小姐，周仲英的宝贝女儿。她性格豪迈，颇
有乃父之风，爱管闲事，好打不平，西北武林中人送了她个
外号，叫做“俏李逵”。\n");
	set("gender", "女性");
	set("class", "fighter");
	set("age", 17);
	set("attitude", "friendly");
	set("shen_type", 1);
	set("per", 25);
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	
	set("max_qi", 1800);
	set("max_jing", 1400);
	set("neili", 1600);
	set("max_neili", 1600);
	set("wuyongjiali", 60);
	set("combat_exp", 70000);

	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("blade", 500+jibie/3+random(jibie/5));
	set_skill("cibei-dao", 500+jibie/3+random(jibie/5));
	set_skill("hunyuan-yiqi", 500+jibie/3+random(jibie/5));
	set_skill("shaolin-shenfa", 500+jibie/3+random(jibie/5));
	set_skill("jingang-quan", 500+jibie/3+random(jibie/5));

	map_skill("dodge", "shaolin-shenfa");
	map_skill("force", "hunyuan-yiqi");
	map_skill("blade", "cibei-dao");
	map_skill("unarmed", "jingang-quan");
	map_skill("parry", "cibei-dao");

	set("env/wimpy", 20);
	create_family("少林派", 51, "俗家弟子");
 	setup();
	carry_object("/clone/cloth/jinduan")->wear();
	carry_object("/clone/weapon/gangdao")->wield();
}

