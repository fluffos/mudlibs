// jiang.c 蒋四根

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
	int jibie;
	jibie = 1000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("蒋四根", ({ "jiang sigen", "jiang","sigen" }));
	set("title", HIR "红花会"HIG"十三当家" NOR);
	set("nickname", HIY "铜头鳄鱼" NOR);
	set("long", "铜头鳄鱼蒋四根在会中坐第十三把交椅，兵器是铁桨。\n");
	set("gender", "男性");
	set("class", "fighter");
	set("age", 21);
	set("attitude", "friendly");
	set("shen_type", 1);
	set("per", 20);
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	
	set("max_qi", 1100);
	set("max_jing", 800);
	set("neili", 1000);
	set("max_neili", 1000);
	set("wuyongjiali", 100);
	set("combat_exp", 150000);

	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("club", 500+jibie/3+random(jibie/5));
	set_skill("houquan", 500+jibie/3+random(jibie/5));
	set_skill("yunlong-shengong", 500+jibie/3+random(jibie/5));
	set_skill("zui-gun", 500+jibie/3+random(jibie/5));
	set_skill("yunlong-shenfa", 500+jibie/3+random(jibie/5));

	map_skill("dodge", "yunlong-shenfa");
	map_skill("force", "yunlong-shengong");
	map_skill("unarmed", "houquan");
	map_skill("club", "zui-gun");
	map_skill("parry", "zui-gun");
	set("env/wimpy", 20);

 	setup();
	carry_object("/clone/cloth/cloth")->wear();
	carry_object(__DIR__"obj/tiejiang")->wield();
}

