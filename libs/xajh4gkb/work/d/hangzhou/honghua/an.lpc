// meng.c 安健刚

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("安健刚", ({ "an jiangang", "an","jiangang" }));
	set("nickname", HIY "独角虎" NOR);
	set("long", 
"他是铁胆周仲英的二弟子，对师父始终忠心不二。\n");
	set("gender", "男性");
	set("class", "fighter");
	set("age", 25);
	set("attitude", "friendly");
	set("shen_type", 1);
	set("per", 20);
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	
	set("max_qi", 1000);
	set("max_jing", 500);
	set("neili", 500);
	set("max_neili", 500);
	set("wuyongjiali", 50);
	set("combat_exp", 50000);

	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("throwing", 500+jibie/3+random(jibie/5));
	set_skill("mantian-xing", 500+jibie/3+random(jibie/5));
	set_skill("hunyuan-yiqi", 500+jibie/3+random(jibie/5));
	set_skill("shaolin-shenfa", 500+jibie/3+random(jibie/5));
	set_skill("jingang-quan", 500+jibie/3+random(jibie/5));

	map_skill("dodge", "shaolin-shenfa");
	map_skill("force", "hunyuan-yiqi");
	map_skill("throwing", "mantian-xing");
	map_skill("unarmed", "jingang-quan");
	map_skill("parry", "jingang-quan");

	set("env/wimpy", 20);
	create_family("少林派", 52, "俗家弟子");
 	setup();
	carry_object("/clone/cloth/cloth")->wear();
	carry_object(__DIR__"obj/tiedan")->wield();
}

