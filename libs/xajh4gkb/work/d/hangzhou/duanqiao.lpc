// duanqiao.c
// Date: Nov.1997 by Venus
#include <room.h>
inherit ROOM;
void create()
{
        set("short", "断桥");
        set("long", @LONG
断桥正好在外湖和里湖的分水点上。这里亭轩错落，掩映在绿树佳荫之下。
“山明水秀轩扉启，落日渔歌过里湖”，就是描述这里傍晚的景色。在断桥
上可浏览环湖诸山和湖中诸岛的风光。每当雪後，站在桥头，只见一切都被
覆上白雪，玉琢银楼的湖山风貌就是西湖十景之一的“断桥残雪”。民间神
话“白蛇传”中的白娘娘和许仙就在这里相会的。
    断桥亦乃情断之处，不少痴男怨女在此相会，然则缘起缘灭，断情人
情断断桥。若已断情，一跳解千愁（jump down）。
LONG);
        set("exits", ([
            "northeast" : __DIR__"road9",
            "west"      : __DIR__"baiti",
 //       "east" :"/d/yunhe/matou4",
        ]));
        set("objects", ([
            __DIR__"npc/poorman" : 1,
            "/d/dali/npc/luxiaojia" : 1,

        ]));
//        set("no_clean_up", 0);
        set("outdoors", "hangzhou");
        setup();
        replace_program(ROOM);
}

void init()
{
   add_action("do_jump","jump");
}
int do_jump (string arg)
{
  
	object who = this_player();
    if( !arg || arg=="" ) return 0;
    if( arg != "down" )
		return notify_fail("你想要跳湖自杀？年纪轻轻的别想不开啊？\n"); 

	message_vision("$N神情哀痛，向前一跃……\n",who);	
	if ((int)who->query_skill("dodge",1)>2000 && (int)who->query("xyzx_sys/level")>2000)
	{
		if (random(10)==1)
		{
			message("rumor", HIR"【谣言四起】某人："HIW"听说" + who->query("name") + "情断断桥，脚下一滑掉入了西湖之中。。。。\n"NOR, users() );
			who->die();
			return 1;			
		}
		else
		{
			message_vision ("$N从断桥上跳了下来，往事如烟，回想起前世种种。\n",who);	
			message_vision ("$N命不该绝，跳入西湖之中，被湖水卷入地下暗流，冲到一个溶洞之中。\n",who);	
			who->unconcious();
			who->move("/d/hangzhou/rongdong");
		}
	}
	else
	{
		message("rumor", HIR"【谣言四起】某人："HIW"听说" + who->query("name") + "情断断桥，一时想不开纵身跳入了西湖之中。。。。\n"NOR, users() );
		who->die();
		return 1;
	}
 
  return 1;
}