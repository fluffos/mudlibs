inherit ITEM;
void create()
{
        set_name(HIC"渔网"NOR, ({ "yu wang"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一张渔网\n");
                set("unit", "张"); 
                set("no_get",1);
                set("no_drop",1);             
                set("no_put",1);
                set("no_give",1);   
                set("value",100000);
        }
    setup();
}

