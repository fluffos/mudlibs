// longjun.c

#include <ansi.h>

inherit NPC;

void create()
{
	int jibie;
	jibie = 1000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("龙骏", ({ "long jun", "long", "jun"}) );
	set("title", "御前侍卫");
	set("gender", "男性");
	set("age", 32);
	set("long","龙骏是大内高手，一手喂毒暗器，少有其匹。\n");
	set("combat_exp", 300000);
    set("shen_type", -1);
	set("attitude", "heroism");

	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("throwing", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("mantian-xing", 500+jibie/3+random(jibie/5));
	set_skill("shaolin-shenfa", 500+jibie/3+random(jibie/5));
	map_skill("throwing", "mantian-xing");
	map_skill("parry", "mantian-xing");
	map_skill("dodge", "shaolin-shenfa");

	setup();
        carry_object("/clone/armor/tiejia")->wear();
        carry_object("clone/weapon/jili")->wield();

	add_money("silver", 10);
}
