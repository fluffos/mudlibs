// qianlong.c

#include <ansi.h>

inherit NPC;

void create()
{
	int jibie;
	jibie = 6000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("乾隆皇帝", ({ "qian long", "qianlong","huangdi"}) );
	set("title", "清高宗");
	set("gender", "男性");
	set("age", 43);
	set("per", 24);
    set("no_get",1);
	set("long","乾隆皇帝姓爱新觉罗，名弘历，是大清入关后第四位在位皇帝，生平号称有十大武功，自称“十全老人”。\n");
	set("combat_exp", 80000000);
	set_skill("literate", 500+jibie*2+random(jibie/5));
	set_skill("blade", 500+jibie*2+random(jibie/5));
	set_skill("force", 500+jibie*2+random(jibie/5));
	set_skill("unarmed", 500+jibie*2+random(jibie/5));
	set_skill("dodge", 500+jibie*2+random(jibie/5));
	set_skill("parry", 500+jibie*2+random(jibie/5));
	set_skill("shaolin-shenfa", 500+jibie/2+random(jibie/5));
	set_skill("cibei-dao", 500+jibie/2+random(jibie/5));
	set_skill("yijinjing", 500+jibie/2+random(jibie/5));
	set_skill("qianye-shou",500+jibie/2+random(jibie/5));
	set_skill("sanhua-zhang",500+jibie/2+random(jibie/5));
	map_skill("force", "yijinjing");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("parry", "qianye-shou");
	map_skill("unarmed", "qianye-shou");		
	set("attitude", "piece");
	setup();
	carry_object("/clone/cloth/cloth")->wear();
	add_money("gold", 1000);
}
void init()
{
	add_action("do_kneel", "kneel");
}
/*
void kill_ob(object ob)
{
	ob->remove_killer(this_object());
	remove_killer(ob);
	message_vision("$N沮丧地发现乾隆皇帝根本不理会作战请求。\n", ob);
}
*/
int do_kneel()
{
	int i;
	object *chen, me = this_player();

	if ( objectp(present("chen jialuo", environment(me))))
	{
		message_vision("$N正想给乾隆皇帝请安，却被陈家洛一把拦住：鞑子的鹰犬，不要脸的奴才，纳命来吧！\n\n", me);
		chen = all_inventory(environment(me));
		for(i=0; i<sizeof(chen); i++)
		{
			if( chen[i] -> query("id") == "chen jialuo") chen[i]->kill_ob(me);
		}
	}
	message_vision("$N恭恭敬敬地跪了下来，磕头道：奴才"+me->query("name")+"救驾来迟，皇上恕奴才死罪！\n\n", me);
	if( me->query("combat_exp") < 150000 )
	{
		message_vision("$n看着$N，哼了一声：你胆敢欺君冒功！凭你这点能耐也想挑了红花会？！\n\n", me, this_object() );
		message_vision("$n飞起一脚，踢得$N丫手丫脚滚下六和塔去了。\n\n", me, this_object() );
		me->move("/d/hangzhou/liuheta");
		tell_object(me, HIR"你从塔顶被一脚踢了下来，好疼！还受了伤。\n"NOR);
		message("vision", HIR"只见" + me->query("name") + "从塔顶上扑通一声跌了下来，躺在地上半天爬不起来！\n"NOR, environment(me), me);
		me->receive_wound("qi", 100);
		if ((int)me->query("xyzx_sys/level")>100) me->add("xyzx_sys/level", -1);
		return 1;
	}
	if( me->query("marks/qianlong") )
	{
		message_vision("$n看着$N，哼了一声，没理$N。\n\n", me, this_object() );
	}
	else
	{
		message_vision("$n看着$N说道：免了！看在你救驾有功，免你死罪，朕自有封赏。\n\n", me, this_object() );
		me->set("marks/qianlong", "1");
		me->add("combat_exp", 1000000);
		message_vision("$n赏完了$N就逃回宫了。\n\n", me, this_object() );
		destruct(this_object());
	}
	return 1;
}

void die()
{
    object ob, me;        
    me = query_temp("last_damage_from");
	if (me && (string)me->query("family/family_name") == "红花会" && me->query_temp("jm_honghua1"))
	{ 
        ob = new("d/hangzhou/obj/rentou");
		ob->set("owner",me->query("id"));	//设定识别
        ob->move(environment(this_object()));
		ob->set("long", "大清乾隆皇帝，看起来英明神武，只是，目前已经没有了头颅。\n");
		tell_room(environment(this_player()), "乾隆惨嚎一声，倒在地上，头颅已然不见了．\n");
	}
	if (me && (string)me->query("family/family_name") == "舞蝶仙" && me->query_temp("jm_wudie2"))
	{ 
        ob = new("d/hangzhou/obj/rentou");
		ob->set("owner",me->query("id"));	//设定识别
        ob->move(environment(this_object()));
		ob->set("long", "大清乾隆皇帝，看起来英明神武，只是，目前已经没有了头颅。\n");
		tell_room(environment(this_player()), "乾隆惨嚎一声，倒在地上，头颅已然不见了．\n");
	}	
	::die();
}