// poorman.c

inherit NPC;

void create()
{
	int jibie;
	jibie = 100;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
        set_name("穷汉", ({ "poor man", "man" }) );
        set("gender", "男性" );
        set("age", 33);
        set("long", "一个骨瘦如柴，满脸菜色的穷汉。\n");
        set("attitude", "friendly");
        set("combat_exp", 250);
        set("shen", 30);
        set("shen_type", 1);
        set("str", 20);
        set("dex", 18);
        set("con", 17);
        set("int", 13);
        setup();
        set("chat_chance", 15);
        set("chat_msg", ({
"穷汉懒洋洋地打了个哈欠。\n",
"穷汉伸手捉住了身上的虱子，骂道：老子身上没几两肉，全叫你们给咬了。 \n",
                (: random_move :)
        }) );
        carry_object("clone/cloth/cloth")->wear();
}

