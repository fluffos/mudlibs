// sister.c 
// LOTS 1998/10/29

inherit NPC;
//inherit F_SKILL;

void create() {
  int jibie;
  jibie = 300;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set_name("包新月", ({ "bao xinyue", "bao", "xinyue" }));
  set("long",
    "她就是包大人的大小姐,据说她能掌上飞.\n"
    "据说她曾经在武当门下学过剑法。\n");

  set("title", "京城第一美");
  set("nickname", "赛飞燕");
  set("gender", "女性");
  set("age", 18);
  set("shen_type", 1);

  set("neili", 13000);
  set("max_neili", 13000);
  set("max_qi", 12000);
  set("max_jing", 1200);
  set("wuyongjiali", 10);
  set("per", 28);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taiji-jian", 500 + jibie / 3 + random(jibie / 5));
  map_skill("sword", "taiji-jian");
  map_skill("parry", "taiji-jian");

  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);
  set_temp("apply/damage", 15);

  set("combat_exp", 100000);

  setup();
  carry_object("clone/cloth/jinduan")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}
