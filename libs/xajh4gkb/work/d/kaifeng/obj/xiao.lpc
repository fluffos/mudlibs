//魔刀-名器

#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create()
{
	set_name(HIB"小楼一夜听春雨"NOR, ({ "mo dao","dao", "blade" }) );
	set_weight(1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value", 0);
		set("material", "gold");
		set("long", "它就是传说中的'圆月弯刀'.\n");
		set("wield_msg", "$N唰的抽出一把$n，只听一声叹息，不知何人，小楼一夜听春雨\n");
		set("unequip_msg", "$N将手中的$n插入腰间的刀鞘，渐渐雨住风停。\n");
		set("shaolin",1);
		set("weapon_prop/constitution", 10);
		set("weapon_prop/blade", 50);
		set("weapon_prop/dodge", 10);
		set("weapon_prop/intelligence", 10);
		set("weapon_prop/parry", 10);			
	}
	init_blade(550,2);
	setup();
}

int query_autoload() { return 1; }
