// npc: /d/city/npc/wei.c
// Jay 5/15/96
inherit NPC;
void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set_name("韦小宝", ({ "wei xiaobao", "xiaobao", "wei" }));
  set("gender", "女性");
  set("title", "小桂子");
  set("age", 42);
  set("long", "扬州妓女韦春花之子。\n");
  set("str", 25);
  set("dex", 25);
  set("con", 25);
  set("int", 25);
  set("shen_type", 1);
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set("combat_exp", 25000);
  set("max_qi", 300);
  set("max_jing", 100);
  set("neili", 500);
  set("max_neili", 500);
  set("attitude", "friendly");

  setup();
  set("chat_chance", 5);
  set("chat_msg", ({
    "韦小宝得意地说道：阿珂小娘子，来亲一个。\n",
    "韦小宝怒骂道：现在的世界太不成话，儿子打老子……\n",
    "韦小宝说道：客店打烊了，这位客官不要往里头走了。\n",
  }));

  add_money("gold", 2);
  carry_object("/clone/cloth/cloth")->wear();
}
