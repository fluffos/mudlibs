inherit NPC;
inherit F_MASTER;
void create() {
  int jibie;
  jibie = 1000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("神照上人", ({
    "shen zhao",
    "shen",
    "zhao",
  }));
  set("long",
    "他是一位秃顶老僧，身穿一袭红色镶边袈裟。他身材略高，\n"
    "太阳穴微凸，双目炯炯有神。\n"
  );
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");
  set("age", 50);
  set("shen_type", 0);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("max_qi", 450);
  set("max_jing", 300);
  set("neili", 600);
  set("max_neili", 600);
  set("wuyongjiali", 50);
  set("combat_exp", 50000);
  set("score", 100);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jingang-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("staff", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("buddhism", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("unarmed", "jingang-quan");
  setup();
  carry_object("/d/shaolin/obj/hui-cloth")->wear();
}
