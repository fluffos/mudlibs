// Room: /city2/tiananmen.c
#include <room.h>
inherit ROOM;

string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});

void create() {
  set("short", "天安门城楼");
  set("long",
    "这里就是天安门城楼，红色的城墙给人以庄严肃穆之感，再往
北就是皇宫了。皇宫正门前有座小桥，一条护城河绕城而过。越过
小桥向北望去，紫禁城的轮廓益发显得雄伟高大。一条笔直的大道
横贯东西，东边是东长安街，西边是西长安街。南边是雄伟壮阔的
天安门广场，在城楼前有一座金水桥，据说游人很多。城楼上挂着
毛主席相框，凭楼远眺，新中国风大气磅礴。\n" HIC "
    国庆节期间可以在这里可以缅怀（mianhuai）革命先烈们
的英雄事迹，牢记革命战士用鲜血和生命开拓的和平年代。\n" HIC "
    劳动节期间可以在这里可以打扫（dasao）天安门城楼，感
受革命先烈艰苦奋斗精神。\n" HIC "
    端午节期间可以在这里可以纪念（jinian）爱国诗人屈原，悼念
其爱国精神和感人诗词。\n" NOR
  );
  set("exits", ([
    "down": "/d/city2/tian_anm",
  ]));
  set("objects", ([
    "/d/city2/npc/weibing": 1,
  ]));
  set("outdoors", "city2");
  setup();
  replace_program(ROOM);
}

void init() {
  add_action("do_mianhuai", "mianhuai");
  add_action("do_dasao", "dasao");
  add_action("do_jinian", "jinian");
}

//2017.9.25阿飞添加，国庆节活动，涉及到clone/npc/halfgod，feature/damage，d/city/npc/cheng，clone/misc/biaoyin2三个文件
int do_mianhuai(string arg) {
  object me = this_player();
  object obj;
  string *poem = ({
    "\n独立寒秋，湘江北去，橘子洲头。\n看万山红遍，层林尽染；\n漫江碧透，百舸争流。\n鹰击长空，鱼翔浅底，\n万类霜天竞自由。\n怅寥廓，问苍茫大地，谁主沉浮？\n\n携来百侣曾游，\n忆往昔峥嵘岁月稠。\n恰同学少年，风华正茂；\n书生意气，挥斥方遒。\n指点江山，激扬文字，\n粪土当年万户侯。\n曾记否，到中流击水，浪遏飞舟！\n",
    "\n北国风光，千里冰封，万里雪飘。\n望长城内外，惟馀莽莽；大河上下，顿失滔滔。\n山舞银蛇，原驰蜡象，欲与天公试比高。\n须晴日，看红妆素裹，分外妖娆。\n\n江山如此多娇，\n引无数英雄竞折腰。\n惜秦皇汉武，略输文采；唐宗宋祖，稍逊风骚。\n一代天骄，成吉思汗，只识弯弓射大雕。\n俱往矣，数风流人物，还看今朝。\n",
    "\n茫茫九派流中国，\n沉沉一线穿南北。\n烟雨莽苍苍，\n龟蛇锁大江。\n黄鹤知何去？\n剩有游人处。\n把酒酹滔滔，\n心潮逐浪高！\n",
    "\n西风烈，长空雁叫霜晨月。\n霜晨月，马蹄声碎，喇叭声咽。\n雄关漫道真如铁，\n而今迈步从头越。\n从头越，苍山如海，残阳如血。\n",
    "\n天高云淡，望断南飞雁。\n不到长城非好汉，\n屈指行程二万。\n六盘山上高峰，\n红旗漫卷西风。\n今日长缨在手，\n何时缚住苍龙？\n",
    "\n钟山风雨起苍黄，\n百万雄师过大江。\n虎踞龙盘今胜昔，\n天翻地覆慨而慷。\n宜将剩勇追穷寇，\n不可沽名学霸王。\n天若有情天亦老，\n人间正道是沧桑。\n",
    "\n才饮长沙水，又食武昌鱼。\n万里长江横渡，极目楚天舒。\n不管风吹浪打，\n胜似闲庭信步，\n今日得宽馀。\n子在川上曰：\n逝者如斯夫！\n风樯动，龟蛇静，起宏图。\n一桥飞架南北，\n天堑变通途。\n更立西江石壁，截断巫山云雨，高峡出平湖。\n神女应无恙，当惊世界殊。\n",
    "\n横空出世，莽昆仑，阅尽人间春色。\n飞起玉龙三百万，搅得周天寒彻。\n夏日消溶，江河横溢，人或为鱼鳖。\n千秋功罪，谁人曾与评说？\n而今我谓昆仑：不要这高，不要这多雪。\n安得倚天抽宝剑，把汝裁为三截？\n一截遗欧，一截赠美，一截还东国。\n太平世界，环球同此凉热。\n",
  });

  if (!wizardp(me))
    return notify_fail("今天不是国庆节，用不着来此纪念毛主席。\n");
  if (me->is_fighting())
    return notify_fail("纪念毛主席是非常严肃的事情，岂能打架呢。\n");
  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫缅怀毛主席哦.....\n");
  if (me->query_temp("cooldown"))
    return notify_fail("你在天安门城楼缅怀毛主席居然三心二意.....\n");
  if ((int)me->query("jieri_gift/guoqing") != 1)  //若连续开几年，则改这里
    return notify_fail("你得先领取国庆节礼物,不然谁知道你是不是在庆祝中华呢。\n");
  if ((int)me->query("jieri_gift/maozhuxi_guoqing") == 1)  //若连续开几年，则改这里
    return notify_fail("你在国庆节期间，举国同庆纪念毛主席时，情真意切，获得了毛主席的心得。\n");
  if ((int)me->query_temp("guoqing/banxian") < 10)
    return notify_fail("值此国庆佳节.....先去与朱半仙探讨人生吧。\n");
  if ((int)me->query_temp("guoqing/zhuibu") < 10)
    return notify_fail("值此国庆佳节.....先去替扬州知府追捕一些逃犯吧。\n");
  if ((int)me->query_temp("guoqing/yunbiao") < 10)
    return notify_fail("值此国庆佳节.....先去长风镖局郭旭护送一些镖银吧。\n");

  tell_object(me, HIY "你站在天安门城楼仰望毛主席画像，深深的陷入毛主席的英雄事迹之中......\n" NOR);
  message_vision(
    HIC "$N饮水思源，回首毛主席的革命事迹与英雄赞歌：\n" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n" NOR,
    me
  );
  me->start_busy(5);

  if (random(1000) < 200) {
    me->set("jieri_gift/maozhuxi_guoqing", 1);  //若连续开几年，则改这里
    obj = new("/clone/gift/jiuzhuan");
    obj->set("owner", me->query("id"));  //设定识别		
    obj->move(me);
    tell_object(me, HIG "你在国庆节期间，怀着无比敬仰之情纪念毛主席时，情真意切，获得了毛主席奖励的九转金丹！\n" NOR);
    message(
      "channel:chat",
      CYN "【举国同庆】" GRN + "听说" + me->query("name") + "在国庆节期间，前往天安门城楼纪念毛主席时，情真意切，获得了毛主席奖励的九转金丹！\n" NOR,
      users()
    );
  } else if (random(1000) > 800) {
    me->set_temp("fandongpai", 1);
    tell_object(me, HIG "纳尼！在这举国同庆的日子里，众人都在深情的纪念毛主席，你居然心怀不轨......\n" NOR);
    me->move("/d/city2/tian_anm");
    me->unconcious();
  } else if (random(1000) > 990) {
    me->set_temp("fandongpai", 1);
    me->delete_temp("guoqing/banxian");
    me->delete_temp("guoqing/zhuibu");
    me->delete_temp("guoqing/yunbiao");
    tell_object(me, HIG "纳尼！在这举国同庆的日子里，众人都在深情的纪念毛主席，你居然制造恐怖事件......\n" NOR);
    me->move("/d/city2/tian_anm");
    me->unconcious();
  }
  return 1;
}

//2018.4.28阿飞添加，劳动节活动，涉及到d/city/npc/ping，d/city/obj/letter，clone/misc/biaoyin1三个文件
int do_dasao(string arg) {
  object me = this_player();
  int add_gift;
  string *poem = ({
    "\n锄禾日当午，汗滴禾下土。\n谁知盘中餐，粒粒皆辛苦。\n",
    "\n昼出耘田夜绩麻，村庄儿女各当家。\n童孙未解供耕织，也傍桑阴学种瓜。\n",
    "\n春种一粒粟，秋收万颗子。\n四海无闲田，农夫犹饿死。\n",
    "\n尝闻秦地西风雨，为问西风早晚回。\n白发老农如鹤立，麦场高处望云开。\n",
    "\n敢将十指夸针巧，不把双眉斗画长。\n苦恨年年压金线，为他人做嫁衣裳。\n",
    "\n绿遍山原白满川，子规声里雨如烟。\n乡村四月闲人少，才了蚕桑又插田。\n",
    "\n江上往来人，但爱鲈鱼美。\n君看一叶舟，出没风波里。\n",
    "\n马美在奔跑，人美在勤劳。\n念此私自愧，尽日不能忘。\n",
    "\n田家少闲月，五月人倍忙。\n夜来南风起，小麦覆陇黄。\n",
    "\n种豆南山下，草盛豆苗稀。 \n晨兴理荒秽，带月荷锄归。\n道狭草木长，夕露沾我衣。\n衣沾不足惜，但使愿无违。\n",
  });

  //	if (!wizardp(me))
  //		return notify_fail("今天不是劳动节，用不着来此打扫天安门城楼。\n");	
  if (me->is_fighting())
    return notify_fail("打扫天安门城楼需要严肃认真，岂能在此打架。\n");
  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫打扫天安门城楼哦.....\n");
  if (me->query_temp("cooldown"))
    return notify_fail("你打扫天安门城楼时居然三心二意.....\n");
  if ((int)me->query("jieri_gift/laodong") != 2)  //若连续开几年，则改这里
    return notify_fail("你得先领取劳动节礼物,不然谁知道你是不是在认真劳动呢。\n");
  if ((int)me->query("jieri_gift/maozhuxi_laodong") == 2)  //若连续开几年，则改这里
    return notify_fail("你在劳动节期间，认真的打扫天安门城楼，获得了毛主席的嘉奖。\n");
  if ((int)me->query_temp("laodong/yunbiao") < 10)
    return notify_fail("你不积极劳动.....先去帮福威镖局林震南送几趟镖吧。\n");
  if ((int)me->query_temp("laodong/songxin") < 10)
    return notify_fail("你不积极劳动.....先去替驿长杜宽送一些信吧。\n");
  if ((int)me->query_temp("laodong/fenyao") < 10)
    return notify_fail("你不积极劳动.....先去帮平一指分拣药材吧。\n");

  tell_object(me, HIY "你站在天安门城楼回想起革命先烈的艰苦奋斗精神，不自觉的开始认真的打扫天安门城楼......\n" NOR);
  message_vision(
    HIC "$N饮水思源，回首革命工人在一穷二白的土地上艰苦奋斗：\n" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n" NOR,
    me
  );
  me->start_busy(5);
  add_gift = (100000 + random(50000)) * (int)me->query("jieri_gift/laodong");
  if (random(1000) < 200) {
    me->set("jieri_gift/maozhuxi_laodong", 2);  //若连续开几年，则改这里
    if (random(2) == 0) me->add("max_neili", add_gift);
    else me->add("max_jingli", add_gift);

    tell_object(me, HIG "你在劳动节期间，弘扬劳模精神，艰苦奋斗，勇于奉献，获得了毛主席的嘉奖！\n" NOR);
    message(
      "channel:chat",
      CYN "【举国同庆】" GRN + "听说" + me->query("name") + "在劳动节期间，前往天安门打扫城楼，认真仔细，爱岗敬业，获得了毛主席的嘉奖！\n" NOR,
      users()
    );
  } else if (random(1000) > 800) {
    me->set_temp("laogaifan", 1);
    tell_object(me, HIG "在这劳动的日子里，大家都在认真打扫城楼，你居然懒懒散散......\n" NOR);
    me->move("/d/city2/tian_anm");
    me->unconcious();
  } else if (random(1000) > 990) {
    me->set_temp("laogaifan", 1);
    me->delete_temp("laodong/yunbiao");
    me->delete_temp("laodong/songxin");
    me->delete_temp("laodong/fenyao");
    tell_object(me, HIG "纳尼！在这举国同庆的日子里，众人都在认真的打扫天安门城楼，你居然偷奸耍滑......\n" NOR);
    me->move("/d/city2/tian_anm");
    me->unconcious();
  }

  return 1;
}

//2018.5.28阿飞添加，端午节活动，涉及到d/xiangyang/npc/tiejiang，quest/huang/huangjobhy，inherit/char/sell_salt三个文件
int do_jinian(string arg) {
  object me = this_player();
  object obj;
  string *poem = ({
    "\n桂棹兮兰桨，击空明月兮溯流光。渺渺兮予怀，望美人兮天一方。\n",
    "\n入不言兮出不辞， 乘回风兮载云旗。 悲莫悲兮生别离， 乐莫乐兮新相知。\n",
    "\n民生各有所乐兮，余独好修以为常。虽体解吾犹未变兮，岂余心之可惩。\n",
    "\n诚既勇兮又以武，终刚强兮不可凌。身既死兮神以灵，子魂魄兮为鬼雄。\n",
    "\n袅袅兮秋风，洞庭波兮木叶下。\n",
    "\n路漫漫其修远兮，吾将上下而求索。\n",
    "\n朝饮木兰之坠露兮，夕餐秋菊之落英 。\n",
    "\n举世皆浊我独清，众人皆醉我独醒 。\n",
    "\n国无人莫我知兮，又何怀乎故都！既莫足与为美政兮，吾将从彭咸之所居！\n",
    "\n天何所沓？十二焉分？日月安属？列星安陈？出自汤谷，次于蒙汜。\n",
  });

  if (!wizardp(me))
    return notify_fail("今天不是端午节，用不着来此纪念屈原。\n");
  if (me->is_fighting())
    return notify_fail("纪念需要严肃认真，岂能在此打架。\n");
  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫纪念屈原啊.....\n");
  if (me->query_temp("cooldown"))
    return notify_fail("你纪念屈原时居然三心二意.....\n");
  if ((int)me->query("jieri_gift/duanwu") != 1)  //若连续开几年，则改这里
    return notify_fail("你得先领取端午节礼物,不然谁知道你是不是要过端午呢。\n");
  if ((int)me->query("jieri_gift/maozhuxi_duanwu") == 1)  //若连续开几年，则改这里
    return notify_fail("你在端午节期间，庄严的纪念屈原，获得了毛主席亲手包的粽子。\n");
  if ((int)me->query_temp("duanwu/duanzao") < 10)
    return notify_fail("纪念屈原.....额...你先去帮襄阳铁匠锻造一些兵甲吧。\n");
  if ((int)me->query_temp("duanwu/jiaofei") < 10)
    return notify_fail("纪念屈原.....额...你先去替黄帮主剿灭土匪吧。\n");
  if ((int)me->query_temp("duanwu/fanyan") < 10)
    return notify_fail("纪念屈原.....额...你先去给各地盐商贩一些青盐吧。\n");

  tell_object(me, HIY "你站在天安门城楼，看着天安门广场龙舟飞舞，读着屈原的诗词，爱国之情油然而生......\n" NOR);
  message_vision(
    HIC "$N忧国忧民，在这民族节日里，迎端午，赛龙舟，忆大夫九死无悔，怀屈原浩然正气：\n" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n" NOR,
    me
  );
  me->start_busy(5);

  if (random(1000) < 200) {
    me->set("jieri_gift/maozhuxi_duanwu", 1);  //若连续开几年，则改这里
    obj = new("/clone/gift/zongzi");
    obj->set("owner", me->query("id"));  //设定识别		
    obj->move(me);
    tell_object(me, HIG "你在端午节期间，赛龙舟，忆屈原，精诚所至，获得了毛主席亲手包的粽子！\n" NOR);
    message(
      "channel:chat",
      CYN "【举国同庆】" GRN + "听说" + me->query("name") + "在端午节期间，于天安门城楼纪念屈原，精诚动天地，忠义感明神，获得了毛主席亲手包的粽子！\n" NOR,
      users()
    );
  } else if (random(1000) > 800) {
    me->set_temp("pantou", 1);
    tell_object(me, HIG "在端午节期间，大家都在认真忆屈原、赛龙舟、包粽子，你居然吊儿郎当......\n" NOR);
    me->move("/d/city2/tian_anm");
    me->unconcious();
  } else if (random(1000) > 990) {
    me->set_temp("pantou", 1);
    me->delete_temp("duanwu/duanzao");
    me->delete_temp("duanwu/jiaofei");
    me->delete_temp("duanwu/fanyan");
    tell_object(me, HIG "纳尼！在这举国同庆的日子里，众人都在忆屈原、赛龙舟、包粽子，你居然作奸犯科......\n" NOR);
    me->move("/d/city2/tian_anm");
    me->unconcious();
  }

  return 1;
}
