inherit ROOM;
string *books = ({
  "/d/city2/obj/yljing",
  "/d/city2/obj/yljing1",
  "/d/city2/obj/yljing2",
  "/clone/book/book-bamboo",
  "/clone/book/book-paper",
  "/clone/book/book-silk",
  "/clone/book/book-stone",
  "/clone/book/book-iron",
  "/clone/book/quanpu",
  "/clone/book/dujing_1",
});
void create() {
  set("short", "侧厅");
  set("long", @LONG
这里是侧厅，靠墙是一排书架（shujia)，摆满了各种拳谱、书籍。墙角有一张木床。
天地会总舵主陈近南常常在这里读书、休息。
LONG
  );
  set("exits", ([
    "west": __DIR__ "dating",
  ]));
  set("sleep_room", 1);
  set("objects", ([
    books[random(sizeof(books))]: 1,
    books[random(sizeof(books))]: 1,
    books[random(sizeof(books))]: 1,
    books[random(sizeof(books))]: 1,
  ]));
  setup();
  replace_program(ROOM);
}

void init() {
  add_action("do_push", "push");
}

int do_push(string arg) {
  object me = this_player();

  if (!arg || arg != "shujia") {
    write("你要推什么呀。\n");
    return 1;
  }
  if (me->query("family/family_name") == "云龙门") {
    if (!me->query_temp("jm_yunlong3") || me->query("family/master_id") != "chen jinnan")
      return notify_fail(HIR "天地会弟子突然出现说道：这位" + RANK_D->query_respect(me) + "好象没有得到云龙门陈总舵主的允许吧？\n");
  } else if (me->query("family/family_name") == "红花会") {
    if (!me->query_temp("jm_honghua3") || me->query("family/master_id") != "chen jialuo")
      return notify_fail(HIR "天地会弟子突然出现说道：这位" + RANK_D->query_respect(me) + "好象没有得到红花会陈总舵主的允许吧？\n");
  } else {
    return notify_fail(HIR "天地会弟子突然出现说道：这位" + RANK_D->query_respect(me) + "好象没有得到天地会陈总舵主的允许吧？\n");
  }

  message_vision("$N在书架前站定，深吸一口气，两手紧握住书架。\n", me);
  if (me->query("xyzx_sys/level") >= 2000 && me->query_skill(
    "force",
    1
  ) >= 2000 && me->query("max_neili") > 1000000) {
    message_vision(HIC "$N丹田一运气，猛的一推，只见书架之后，露出一条长长的甬道。\n", me);
    set("exits/east", "/d/city2/mishi");
    remove_call_out("close");
    call_out("close", 5, this_object());
  } else {
    message_vision("$N丹田一运气，猛的一推，书架却纹丝不动，$N被一股力量反震。\n", me);
    me->unconcious();
  }
  return 1;
}
void close(object room) {
  message("visoin", "书架自动又合上了。\n", room);
  room->delete("exits/east");
}
