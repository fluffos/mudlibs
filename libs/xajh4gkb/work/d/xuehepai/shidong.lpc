// by mayue

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "地下石洞");
  set("long", @LONG
这里是地下河的一处石洞，似乎是人为开凿出来的，四周没有任何出路。
急流水声不时传来。石壁(shibi)似乎微微发光，镶嵌着点点荧光石，外
面是急流，看似平静，实则暗流汹涌。
LONG
  );

  set("exits", ([

  ]));
  set("objects", ([
    "d/xuehepai/npc/gui": 1,
  ]));

  setup();
}

void init() {
  add_action("do_break", "break");
}
int do_break(string arg) {
  object me, monk, room;
  me = this_player();
  if (!arg || arg != "shibi") {
    write("不要随便打碎别人的东西！\n");
    return 1;
  }
  if (!(room = find_object("/d/xuehepai/shidong"))) room = load_object("/d/xuehepai/shidong");
  monk = present("gui wuyin", room);
  message_vision("$N走到石壁前，全身内力汇聚双掌，运劲向石壁拍了过去。\n", me);
  if ((int)me->query("neili") < 2000) {
    message_vision("结果只听一声闷哼，$N被石壁的反弹力震得眼前一黑....\n", me);
    me->unconcious();
    return 1;
  }
  if (me->query("family/family_name") == "血河派" && me->query_temp("jm_xuehe6")) {
    message_vision("$N只听一声轰响，石壁被击穿了，原来下面是一条地下河！\n", me);
    set("exits/enter", __DIR__ "xuehe");
    me->add("neili", -2000);
    remove_call_out("close");
    call_out("close", 5, this_object());
  } else {
    message_vision(HIG "归无隐冷冷的看着你，脸色阴沉！\n" "没有我的允许，任何人不得进入血河！\n" NOR, me);
    if (monk) monk->kill_ob(me);
  }
  return 1;
}
void close(object room) {
  message("vision", "石洞忽然掉下来一块巨石，将洞口封了个严严实实。\n", room);
  room->delete("exits/enter");
}
