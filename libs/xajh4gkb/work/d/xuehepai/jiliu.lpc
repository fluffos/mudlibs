inherit ROOM;
#include <ansi.h>
int do_yun(string arg);
void create()
{
        set("short","急流");
        set("long",@LONG
你已经掉进了这个危险的龙门急流，强大的水流冲击着你的身体。
由于形成了旋涡，一不小心就会被旋涡撕成碎片。可是这大自然的力量
又好象提示你去克服它，利用它。
LONG );
        set("exits",([
//              "enter" : __DIR__"mishi",
        ]));
		
        set("outdoors","龙门");
        set("class","血河派");
//        set("no_clean_up"， 0);
        setup();
}

void init()
{
	add_action("do_yun","lingwu");
	add_action("do_jump","jump");
	add_action("do_qian","qian");
}

int do_yun(string arg)
{
	object me;
	int skills;

	me=this_player();
	skills=me->query_skill("longmen-shengong",1);
        
	if (!arg  || arg!="龙门神功")
		return notify_fail("你要领悟什么武功？\n");
	if( skills>(me->query("xyzx_sys/level")+300)*2 )
		return notify_fail("你的经验不够，不能继续领悟。\n");
	if (skills>me->query_skill("force",1))
		return notify_fail("你的基础内功不够深厚。\n");
	if (me->query_skill("yiqiguan-riyue",1)<1000)
		return notify_fail("你的一气贯日月还未练到高深之处，无法领悟。\n");	
	if (skills>2000)
		return notify_fail("你的龙门神功深不可测了。\n");
	if (me->query("qi")<1000 || me->query("jingli")<1000)
		return notify_fail("你的气色太差了，还领悟个啥？\n");
			
	message_vision(HIY"$N将龙门神功运满全身，放松肌体，任由急流冲刷。\n"NOR,me);
	message_vision(HIY"$N将急流的旋涡劲纳入体内，身随意转，随着旋涡流一起旋转。\n"NOR,me);
	tell_object(me,"你对龙门神功有了更进一步的领悟。\n");
	me->improve_skill("longmen-shengong",100*me->query("int",1));
	me->add("qi",-150);
	me->add("jingli",-180);
	return 1;
}

int do_jump(string arg)
{
	object me;
	me=this_player();

	if (!arg && arg!="out" && arg!="enter")
		return notify_fail("你要往哪跳？\n");
	if (me->query_skill("longmen-shengong",1)<150)
		return notify_fail("你的龙门神功修为还不够。\n");

	if ( arg=="out")
	{
		message_vision("$N纵身一跃，运气于足底，踩着旋涡飞了出去！\n",me);
		me->move(__DIR__"tanbian");
		message_vision("只见$N突然从深潭底冒了出来！\n",me);
		return 1;		
	}
	if ( arg=="enter")
	{
		message_vision("$N纵身一跃，猛的扎入漩涡中去！\n",me);
		if (me->query("neili")<1000000 || me->query("max_neili")<1000000 || me->query_skill("longmen-shengong",1)<1000 || me->query_skill_mapped("force") != "longmen-shengong")
		{
			message_vision("你运起全身内力抵抗激流漩涡，但是或许内力不足，也许龙门神功。。。。\n",me);
			me->die();
			message("channel:rumor",HIY"【惨死】"HIB"传闻"+me->query("name")+"跳入龙门急流中，被急流冲得死无全尸！\n"NOR,users());
			return 1;
		}
		me->move(__DIR__"mishi");
		message_vision("只见$N突然从急流中冒了出来，发现竟然被冲到一处地下暗室！\n",me);
		return 1;		
	}
	return 1;
}

int do_qian(string arg)
{
	object me;
	me=this_player();

	if (!arg && arg!="down")
		return notify_fail("你要在哪里潜水？\n");
	
	message_vision("$N纵身一跃，潜入急流旋涡而去！\n",me);	
	if (me->query("neili")<1000000 || me->query("max_neili")<1000000 || me->query_skill("longmen-shengong",1)<1000 || me->query_skill_mapped("force") != "longmen-shengong")
	{
		message_vision("你运起全身内力抵抗激流漩涡，但是或许内力不足，也许龙门神功。。。。\n",me);
		message("channel:rumor",HIY"【惨死】"HIB"传闻"+me->query("name")+"潜入龙门急流中，被急流冲得死无全尸！\n"NOR,users());
		me->die();
		return 1;
	}			
	
	message_vision("只见$N被地下暗流冲的晕头转向，连忙运转龙门神功急流的旋涡劲纳入体内！\n",me);
	message_vision("$N被卷入地下急流中，突然被某坚硬之物撞的眼冒金星，顿时眼前一黑！\n",me);
	me->move(__DIR__"shidong");
	me->unconcious();
	return 1;
}