// made by lks

#include <ansi.h>

inherit NPC;
inherit F_MASTER;
#include "ouyang.h"
string ask_putuo();

void create()
{
	int jibie;
	jibie = 5000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("欧阳独",({"ouyang du","ouyang"}));
	set("nickname",HIR"血影神掌"NOR);
	set("gender","男性");
	set("int",30);  
	set("con",30);
	set("str",30);
	set("dex",30);
	set("bac",40);
	set("age",40);
	set("attitude","peaceful");
	set("combat_exp",12000000);
	set("kill",1000);
	set("long","其人秉性刚烈，脸狠心慈，是个极端快意恩仇的人，无论好坏，他都不畏惧，更不屈服，\n他的才气可谓惊才羡艳，算得上“震古烁今，并世无双”八个字！\n" );
	set("neili",50000);
	set("jingli",30000);
	set("max_neili",50000);
	set("max_jingli",30000);
	set_skill("literate",500+jibie/3+random(jibie/5));
	set_skill("unarmed",500+jibie/3+random(jibie/5));
	set_skill("parry",500+jibie/3+random(jibie/5));
	set_skill("dodge",500+jibie/3+random(jibie/5));
	set_skill("sword",500+jibie/3+random(jibie/5));
	set_skill("force",500+jibie/3+random(jibie/5));
	set_skill("taoism",500+jibie/3+random(jibie/5));
	set_skill("throwing",500+jibie/3+random(jibie/5));
	set_skill("yiqiguan-riyue",500+jibie/3+random(jibie/5));
	set_skill("youran-bu",500+jibie/3+random(jibie/5));
	set_skill("feixue-quan",500+jibie/3+random(jibie/5));
	set_skill("huaxue-shenzhen",500+jibie/3+random(jibie/5));
	set_skill("tianhe-jian",500+jibie/3+random(jibie/5));
	set_skill("huaxue-dafa",500+jibie/3+random(jibie/5));
	map_skill("force","huaxue-dafa");
	map_skill("dodge","youran-bu");
	map_skill("throwing","huaxue-shenzhen");
	map_skill("sword","tianhe-jian");
	map_skill("unarmed","feixue-quan");
	map_skill("parry","tianhe-jian");

	set("inquiry", ([
        "普陀山之战" : (: ask_putuo :),
    ]));
	create_family("血河派",11,"掌门");
	setup();
	carry_object("/d/xuehepai/obj/cloth5")->wear();
	carry_object("/d/xuehepai/obj/arrow")->wield();   
	carry_object("/clone/weapon/gangjian")->wield();
}

string ask_putuo()
{
    mapping fam;
    
    if (!(fam = this_player()->query("family")) || fam["family_name"] != "血河派")
        return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？";
	
	this_player()->set_temp("jm_xuehe1",1);
    return "五十年前，武林十二门派好手于普陀山伏击我，此乃深仇大恨。\n凡我血河派弟子，当屠尽嵩山派、衡山派。";
}