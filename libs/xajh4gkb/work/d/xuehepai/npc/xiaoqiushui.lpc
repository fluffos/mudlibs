#include <ansi.h>
inherit NPC;

void create() {
  int jibie;
  jibie = 8000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("萧秋水", ({ "xiao qiushui", "xiao" }));
  set("nickname", HIR "神州结义" NOR);
  set("gender", "男性");
  set("int", 30);
  set("con", 30);
  set("str", 30);
  set("dex", 30);
  set("bac", 40);
  set("age", 60);
  set("attitude", "friendly");
  set("combat_exp", 120000000);
  set("kill", 1000);
  set("long", "老年时期的萧秋水，武功已经大乘。\n");
  set("neili", 5000);
  set("jingli", 3000);
  set("max_neili", 5000);
  set("max_jingli", 3000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuji-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("bugui-bufa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wushuang-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qingyi-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("fanyun-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qishen-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "wuji-shengong");
  map_skill("dodge", "bugui-bufa");
  map_skill("parry", "wushuang-jian");
  map_skill("sword", "qingyi-jian");
  map_skill("unarmed", "fanyun-zhang");
  map_skill("blade", "qishen-dao");
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/d/huanhua/obj/changge")->wield();
}

void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "血河派" && me->query_temp("jm_xuehe2")) {
    tell_room(environment(this_player()), "萧秋水叹息道：没想到血河派竟然又出现了绝世天才，难道江湖又将腥风血雨吗？\n");
    tell_room(environment(this_player()), "萧秋水气血衰败，死了.....．\n");
    me->set_temp("jm_xuehe5", 1);
  }
  ::die();
}
