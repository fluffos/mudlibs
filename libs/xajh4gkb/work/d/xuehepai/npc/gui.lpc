#include <ansi.h>

inherit NPC;
inherit F_MASTER;
#include "gui.h"
int ask_xuehe();

void create() {
  int jibie;
  jibie = 9000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("归无隐", ({ "gui wuyin", "gui" }));
  set("nickname", HIR "血手屠龙" NOR);
  set("gender", "男性");
  set("int", 30);
  set("con", 30);
  set("str", 30);
  set("dex", 30);
  set("bac", 40);
  set("age", 40);
  set("attitude", "friendly");
  set("combat_exp", 120000000);
  set("kill", 1000);
  set("long", "是个口吃的人，脸貌丑陋,所以不容见人。\n");
  set("neili", 5000);
  set("jingli", 3000);
  set("max_neili", 5000);
  set("max_jingli", 3000);
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("whip", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taoism", 500 + jibie / 3 + random(jibie / 5));
  set_skill("throwing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yiqiguan-riyue", 500 + jibie / 3 + random(jibie / 5));
  set_skill("youren-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jieniu-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yudi-bian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("youran-bu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("feixue-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huaxue-shenzhen", 500 + jibie / 3 + random(jibie / 5));
  set_skill("longmen-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianhe-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huaxue-dafa", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "longmen-shengong");
  map_skill("blade", "jieniu-dao");
  map_skill("dodge", "youran-bu");
  map_skill("throwing", "youren-jian");
  map_skill("whip", "yudi-bian");
  map_skill("sword", "tianhe-jian");
  map_skill("unarmed", "feixue-quan");
  map_skill("parry", "tianhe-jian");
  set("inquiry", ([
    "血河": (: ask_xuehe :),
  ]));
  create_family("血河派", 10, "掌门");
  setup();
  carry_object("/d/xuehepai/obj/cloth6")->wear();
  carry_object("/clone/weapon/libiegou")->wield();
  carry_object("/clone/weapon/gangjian")->wield();
}

int ask_xuehe() {
  object me;
  me = this_player();

  if (me->query_temp("jm_xuehe3") && me->query_temp("jm_xuehe4") && me->query_temp("jm_xuehe5") && (string)me->query("family/family_name") == "血河派") {
    message_vision(HIB "归无隐说道：我血河派开创于血河，血河之水可提升血河派武功威力。\n" NOR, me);
    message_vision(HIB "归无隐说道：凡血河弟子，若武功登峰造极，为我派立下大功后，方可入血河修炼！” \n" NOR, me);
    message_vision(HIC "归无隐说道：血河就在本处石洞下面，将石壁击碎后可进入。\n" NOR, me);
    me->set_temp("jm_xuehe6", 1);
  } else {
    message_vision(YEL "归无隐冷冷地说道：血河是我派的根基，岂是你能探听的！\n" NOR, me);
    return 1;
  }

  return 1;
}
