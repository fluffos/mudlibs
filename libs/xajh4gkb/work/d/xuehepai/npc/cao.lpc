#include <ansi.h>

inherit NPC;
inherit F_MASTER;
#include "xiao.h"
#include "cloth.h"
#include "caojob.h"

int ask_me();


void create()
{
	int jibie;
	jibie = 1000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name("曹大悲",({"cao dabei","cao"}));
        set("nickname",RED"血雾纷飞"NOR);
	set("gender","男性");
       set("shen_type",0);
	set("int",30);	
	set("con",30);
	set("str",30);
	set("dex",30);
	set("bac",40);
        set("book",1);
        set("age",30);
	set("attitude","peaceful");
        set("combat_exp",5000000);
        set("shen",1000);
	set("long",
"英俊潇洒,但始终看不破一个情字，最后也殉情了。\n"
	);
        set("neili",20000);
        set("jingli",18000);
        set("max_neili",20000);
        set("max_jingli",18000);
        set_skill("yiqiguan-riyue",500+jibie/3+random(jibie/5));
        set_skill("literate",500+jibie/3+random(jibie/5));
        set_skill("cuff",500+jibie/3+random(jibie/5));
        set_skill("parry",500+jibie/3+random(jibie/5));
        set_skill("dodge",500+jibie/3+random(jibie/5));
        set_skill("youran-bu",500+jibie/3+random(jibie/5));
        set_skill("tianhe-jian",500+jibie/3+random(jibie/5));
        set_skill("sword",500+jibie/3+random(jibie/5));
        set_skill("force",500+jibie/3+random(jibie/5));
        set_skill("throwing",500+jibie/3+random(jibie/5));
        set_skill("huaxue-shenzhen",500+jibie/3+random(jibie/5));
        set_skill("taoism",500+jibie/3+random(jibie/5));
        set_skill("feixue-quan",500+jibie/3+random(jibie/5));
        set_skill("huaxue-dafa",500+jibie/3+random(jibie/5));
        map_skill("force","huaxue-dafa");
        map_skill("dodge","youran-bu");
        map_skill("cuff","feixue-quan");
        map_skill("throwing","huaxue-shenzhen");
        map_skill("sword","tianhe-jian");
        prepare_skill("cuff","feixue-quan");
	
       create_family("血河派",14,"弟子");
	setup();
	carry_object("/d/xuehepai/obj/cloth2")->wear();

       set("inquiry",([
              "秘籍" : (: ask_me :),
       ]));	
}

int ask_me()
{
           object ob;

           object me=this_player();

           if (!me->query("family") || me->query("family/family_name")!="血河派")
           {
                  command("say 你与本派并无瓜葛，此话从何说起？");
                  return 1;
           }
            if (!query("book"))
            {
                 command("say 秘籍已经被拿走了。");
                 return 1;
            }
                  command("say 好吧，这几本书你拿去好好研究一下。");
                   set("book",0);
                   if (me->query("combat_exp")>100000) {
                  ob=new("/d/xuehepai/obj/miji");
                  ob->move(me);
                   }				
                  return 1;
}

