// Room: /d/mingjiao/xuantianshi.c
inherit ROOM;
string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});
void create() {
  set("short", "血河");
  set("long", @LONG
这里是血河派的地下暗河，河水呈现暗红色，自盛长风发现这里之后，
在此地开创了血河派，传至第十代掌门归无隐后，血河派威势渐嚣，
天下正派，已难匹敌。在这里可以利用血河之水，将血河派武功融为
一体(ronghui)。
LONG);
  set("exits", ([
    "out": __DIR__ "shidong",
  ]));

  set("outdoors", "mingjiao");
  setup();
}

void init() {
  add_action("do_ronghui", "ronghui");
}


int do_ronghui(string arg) {
  object me = this_player();

  string *poem = ({
    "这一式「云绕巫山」或许可以接一招「忘情」...",
    "这一式「披襟当风」或许可以接一招「顺天」...",
    "这一式「千水一流」或许可以接「赤日炎炎」...",
    "这一式「雪花太山」或许可以接「石破天惊」...",
    "这一式「山水飘摇」或许可以接「开道斩蛇」...",
    "这一式「天河飞遁」或许可以接「旁敲侧击」...",
    "这一式「星摇斗晃」或许可以接「汉将当关」...",
    "这一式「观澜瀑剑」或许可以接「游刃有余」...",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫融汇血河武功。\n");
  if (!me->query_temp("jm_xuehe6"))
    return notify_fail("你未得到归无隐的许可。\n");
  if (me->query("jm/xuehe"))
    return notify_fail("你已经完全将血河派武功融会贯通了。\n");
  if (me->query("family/family_name") != "血河派")
    return notify_fail("不是血河派弟子，没办法利用血河之水？\n");

  if (me->query_skill("huaxue-dafa", 1) < 1000) {
    tell_object(me, "你的化血大法.......\n");
    return 1;
  }
  if (me->query_skill("yiqiguan-riyue", 1) < 1000) {
    tell_object(me, "你的一气贯日月.......\n");
    return 1;
  }
  if (me->query_skill("longmen-shengong", 1) < 1000) {
    tell_object(me, "你的龙门神功.......\n");
    return 1;
  }
  if (me->query_skill("tianhe-jian", 1) < 2000) {
    tell_object(me, "你的天河剑法.......\n");
    return 1;
  }
  if (me->query_skill("feixue-quan", 1) < 2000) {
    tell_object(me, "你的飞血拳.......\n");
    return 1;
  }
  if (me->query_skill("huaxue-shenzhen", 1) < 2000) {
    tell_object(me, "你的化血神针.......\n");
    return 1;
  }
  if (me->query("jingli") < 1000) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }

  tell_object(me, HIW "你盘坐于血河之中，试图将各种招式融会贯通......\n" NOR);
  message_vision("" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -500);
  me->start_busy(2);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/xuehe", 1);
    me->add("family_score", 1);
    tell_object(me, HIB "你突然醒悟道：" HIY "原来血河浩荡可以发挥如此之大的威力" HIR "！\n" NOR);
    tell_object(me, HIB "恭喜你融汇贯通了血河派武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在血河派地下血河将血河派武功融会贯通！\n" NOR,
      users()
    );
  }
  return 1;
}
