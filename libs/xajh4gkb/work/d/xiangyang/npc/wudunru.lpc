// wudunlu.c

#include <ansi.h>

inherit NPC;
void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("武敦儒", ({"wu dunru", "wu", "dunru"}));
	set("title", HIY"郭靖大弟子"NOR);
	set("gender", "男性");
	set("age", 23);
	set("long", "他是郭靖大弟子，相貌和蔼，一天到晚笑呵呵的。\n");
 	set("attitude", "peaceful");
	
	set("per", 24);
	set("str", 20);
	set("int", 20);
	set("con", 30);
	set("dex", 25);

	set("inquiry", ([
		"黄蓉" : "那是我师母。\n",
		"郭靖" : "那是我师父。\n",
	]));

	set("qi", 1000);
	set("max_qi", 1000);
	set("jing", 500);
	set("max_jing", 500);
	set("neili", 1000);
	set("max_neili", 1000);
	
	set("combat_exp", 180000);
	set("score", 20000);
	 
	set_skill("force", 500+jibie/3+random(jibie/5));			// 基本内功
	set_skill("huntian-qigong", 500+jibie/3+random(jibie/5));	// 混天气功
	set_skill("unarmed", 500+jibie/3+random(jibie/5));		// 基本拳脚
	set_skill("xianglong-zhang", 500+jibie/3+random(jibie/5));	// 降龙十八掌
	set_skill("dodge", 500+jibie/3+random(jibie/5));			// 基本躲闪
	set_skill("xiaoyaoyou", 500+jibie/3+random(jibie/5));		// 逍遥游
	set_skill("parry", 500+jibie/3+random(jibie/5));			// 基本招架
	
	map_skill("force", "huntian-qigong");
	map_skill("unarmed", "xianglong-zhang");
	map_skill("dodge", "xiaoyaoyou");
	map_skill("parry", "xianglong-zhang");
	
	setup();
	
	carry_object("/clone/cloth/cloth")->wear();
}

