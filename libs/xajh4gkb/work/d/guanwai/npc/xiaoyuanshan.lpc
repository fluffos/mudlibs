// xiaoyuanshan.c

#include <ansi.h>

inherit NPC;

void create()
{
	int jibie;
	jibie = 6000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
	set_name("萧远山", ({"xiao yuanshan", "xiao", "yuanshan"}));
	set("gender", "男性");
	set("nickname",HIB"黑衣僧"NOR);
	set("age", 28);
	set("long", 
		"他就是丐帮前任帮主萧峰的父亲，潜伏少林数十年了。\n"
		"他身穿一件普通的黑僧袍，腰间用一条麻绳随便一系。\n"
		"他身高六尺有余，体格十分魁梧，长有一张线条粗旷、十\n"
		"分男性化的脸庞，双目如电，炯炯有神。\n");
	set("attitude", "peaceful");
	set("str", 45);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("qi", 4000);
	set("max_qi", 4000);
	set("jing", 1500);
	set("max_jing", 1500);
	set("neili", 4000);
	set("max_neili", 4000);
	set("wuyongjiali", 100);
	set("combat_exp", 180000);
	set("score", 20000);
	set_skill("force", 500+jibie/3+random(jibie/5));             // 基本内功
	set_skill("hunyuan-yiqi", 500+jibie/3+random(jibie/5));      // 混天气功
	set_skill("unarmed", 500+jibie/3+random(jibie/5));           // 基本拳脚
	set_skill("jingang-quan", 500+jibie/3+random(jibie/5));      // 降龙十八掌
	set_skill("dodge", 500+jibie/3+random(jibie/5));      	     // 基本躲闪
	set_skill("shaolin-shenfa", 500+jibie/3+random(jibie/5));    // 逍遥游
	set_skill("parry", 500+jibie/3+random(jibie/5));             // 基本招架
	map_skill("force", "hunyuan-yiqi");
	map_skill("unarmed", "jingang-quan");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("parry", "jingang-quan");
	
	setup();
	carry_object("/clone/cloth/cloth")->wear();
}

void die()
{
    object me;        
    me = query_temp("last_damage_from");

	if (me && (string)me->query("family/family_name") == "少林派" && (int)me->query_temp("jm_shaolin3"))
	{
		tell_room(environment(this_player()), HIC"你对萧远山说道：三十年来施主在少林寺盗走数门武功，然而不修佛法，\n""我观施主手太阳明经隐隐作痛，如今戾气侵入心脉，若不放手，不日将走火入魔。\n""萧远山说道：罢了，如今我儿已经名震天下，我这就遁入空门。\n"NOR);
		me->set_temp("jm_shaolin5",1);
	}	
	::die();
}