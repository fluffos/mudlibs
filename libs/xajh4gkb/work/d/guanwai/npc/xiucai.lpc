// xiucai.c

inherit NPC;

void create()
{
	int jibie;
	jibie = 100;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
	set_name("落第秀才", ({ "xiu cai" }) );
	set("gender", "男性" );
	set("age", 26);
	set("int", 28);
	set("long",
		"这是个饱读诗书，却手无搏鸡之力的落第秀才。\n");

	set("attitude", "peaceful");
	set_skill("literate", 40);
	setup();
}

