// hufei.c
#include <ansi.h>;
inherit NPC;

void create()
{
	int jibie;
	jibie = 5000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
	set_name("胡一刀", ({"hu yidao", "hu"}));
	set("gender", "男性");
	set("title", "关外刀王"); 
	set("age", 25);
	set("long", 
		"他就是名震关外的胡一刀，胡家掌门人。\n");
	set("attitude", "peaceful");
	set("str", 45);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("chat_chance", 20);

//	create_family("关外胡家", 3, "传人");
//	create_family("中原苗家", 3, "友人"); 	
	create_family("胡苗世家", 2, "胡家传人");    
	set("max_qi", 350000);	
	set("max_jing", 150000);	
	set("neili", 3000000);	
	set("max_neili", 3000);
	set("wuyongjiali", 500);	
	set("combat_exp", 190000000);	
	set("score", 20000);
	 
	set_skill("force", 500+jibie/3+random(jibie/5));             // 基本内功	
	set_skill("hujia-dao", 500+jibie/3+random(jibie/5));       // 胡家刀法          	
	set_skill("blade", 500+jibie/3+random(jibie/5));             // 基本刀法	
	set_skill("lengyue-shengong", 500+jibie/3+random(jibie/5));      // 冷月神功	
	set_skill("dodge", 500+jibie/3+random(jibie/5));             // 基本躲闪	
	set_skill("sixiang-bufa", 500+jibie/3+random(jibie/5));    // 四象步法	
	set_skill("parry", 500+jibie/3+random(jibie/5));             // 基本招架	
	set_skill("unarmed", 500+jibie/3+random(jibie/5));  
	set_skill("tianchang-zhang", 500+jibie/3+random(jibie/5));           		
	map_skill("force", "lengyue-shengong");
	map_skill("blade", "hujia-dao");	
	map_skill("dodge", "sixiang-bufa");
	map_skill("parry", "hujia-dao");
	map_skill("unarmed", "tianchang-zhang");

	setup();
	carry_object(__DIR__"obj/cwbdao")->wield();
	carry_object("/clone/cloth/cloth")->wear();
}


void attempt_apprentice(object ob)
{
	if ((int)ob->query("str",1)<25)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"臂力太差了，恐怕学不了我胡家刀法。");
		return ;
    } 
	if ((int)ob->query("int",1)<25)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"悟性太差了。");
		return ;
    }
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
		return ;
    }
    if ( ob->query_skill("hujia-dao",1) < 1000 )
	{
		command("say 这位"+RANK_D->query_respect(ob)+"对我胡家的家传刀法练的还不够熟练。");
		return ;
	}
	command("say 好吧，我收下你。\n");
    command("recruit "+ob->query("id"));
    return;
}

