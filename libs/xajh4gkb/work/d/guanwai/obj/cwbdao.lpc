//闯王宝刀-名器
#include <weapon.h>
#include <armor.h>
inherit BLADE;

void create() {
  set_name(HIC "闯王宝刀" NOR, ({ "chuangwang baodao", "baodao", "blade", "dao" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 1000000);
    set("material", "iron");
    set("long", "这是闯王所使用过的刀，上面刻有几行小字。\n");
    set("wield_msg", "一道白光，$n已在$N手中，只觉青光四射，寒气透骨，不禁机伶伶的打个冷战。\n");
    set("unwield_msg", "$N将$n插回腰间，华光顿敛，天地间只闻龙鸣。\n");
    set("weapon_prop/dodge", 5);
    set("weapon_prop/unarmed", 10);
    set("weapon_prop/strength", 10);
    set("weapon_prop/blade", 30);
    set("weapon_prop/parry", 10);
  }
  init_blade(500, 2);
  setup();
}
int query_autoload() { return 1; }
