inherit NPC;
#include <ansi.h>
void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set_name(HIC "侍女" NOR, ({ "shinv" }));
  set("gender", "女性");
  set("title", HIG "满脸媚笑" NOR);
  set("age", 18);
  set("long",
    "一个满脸媚笑的侍女\n");
  set("combat_exp", 500000);
  set("attitude", "friendly");
  set("per", 30);

  set_skill("unarmed", 205);
  set_skill("force", 205);
  set_skill("dodge", 205);
  set_skill("parry", 205);


  setup();
  carry_object("/d/dali/npc/obj/halfcloth")->wear();
}
