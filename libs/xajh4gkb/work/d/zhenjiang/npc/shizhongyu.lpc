inherit NPC;
#include <ansi.h>
void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
	set_name(HIY"石中玉"NOR, ({ "shi zhongyu","zhongyu","shi" }) );
	set("gender", "男性");
	set("age", 20);
	set("long", "他大约二十多岁，穿着一身华丽的衣服，一身的英气四射，眼珠子滴溜溜的乱转。\n");
	set("attitude", "peaceful");
	set("str", 250);
	set("int", 35);
	set("con", 25);
	set("dex", 250);
	set("qi", 200000);
	set("max_qi", 20000);
	set("jing", 10000);
	set("max_jing", 10000);
	set("neili", 400000);
	set("max_neili", 20000);
	set("wuyongjiali", 1000);
	set("combat_exp", 3000000);
	set("score", 30000);

	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("literate", 500+jibie/3+random(jibie/5));
	set_skill("xueshan-jianfa", 500+jibie/3+random(jibie/5));	
	set_skill("bingxue-xinfa", 500+jibie/3+random(jibie/5));
	set_skill("snow-zhang", 500+jibie/3+random(jibie/5));
	set_skill("snow-step", 500+jibie/3+random(jibie/5));

	map_skill("sword", "xueshan-jianfa");	
	map_skill("parry", "xueshan-jianfa");	
	map_skill("force", "bingxue-xinfa");
	map_skill("unarmed", "snow-zhang");
	map_skill("dodge", "snow-step");
	set("chat_chance", 10);
	set("chat_msg", ({
                "\n石中玉说道: 叮叮当当，好久没来看我了。\n",
                "\n石中玉叹道: 也不知道我的叮当怎么样了。\n",
                "\n石中玉说道: 长乐帮虽然逍遥快活，可就是不能出去...\n",
                "\n石中玉说道: 唉，谁能帮我杀了外面的老头，整天看守着我！\n",
	}));
	set("inquiry", ([
                "丁当" :  "\n那是一个可爱的小姑娘。\n",
                "阿绣" :  "\n呀！嘘！不要给别人说看见过我...\n",
                "石破天" : "\n那小子听说与我长的一模一样。\n",
	]) );
		
	setup();
	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/cloth/cloth")->wear();
}

void die()
{
    object ob, me;        
    me = query_temp("last_damage_from");
	if (me && me->query("family/master_id") == "bai zizai" && me->query_temp("jm_lingxiao2"))
	{ 
        ob = new("d/zhenjiang/obj/rentou");
		ob->set("owner",me->query("id"));	//设定识别
        ob->move(environment(this_object()));
		ob->set("long", "玄素庄石清之子，风流倜傥，因企图玷污凌霄城小公主而逃亡江南，贪图享乐，成为长乐帮帮主。\n看起来英俊潇洒，只是，目前已经没有了头颅。\n");
		tell_room(environment(this_player()), "石中玉惨嚎一声，倒在地上，头颅已然不见了．\n");
	}
	::die();
}