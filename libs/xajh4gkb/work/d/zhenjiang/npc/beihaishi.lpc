// huawuque.c
#include <ansi.h>
inherit NPC;

void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name(HIC "贝海石" NOR, ({ "bei haishi", "haishi" }));
  set("title", HIY "病大夫" NOR);
  set("long",
    "这是长乐帮的军师，但身体不是很好，经常咳嗽。\n" +
    "为人精明，极工心计，老谋深算，江湖上都叫他贝大夫。\n");
  set("gender", "男性");
  set("age", 48);
  set("combat_exp", 50000000);
  set("shen_type", 1);
  set("str", 180);
  set("dex", 180);
  set("con", 180);
  set("int", 180);
  set("attitude", "peaceful");
  set("qi", 30000);
  set("max_qi", 30000);
  set("jing", 50000);
  set("max_jing", 5000);
  set("neili", 1000000);
  set("max_neili", 20000);
  set("wuyongjiali", 500);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xuantian-zhi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taixuan-gong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuming-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shenxing-baibian", 500 + jibie / 3 + random(jibie / 5));

  map_skill("unarmed", "xuantian-zhi");
  map_skill("force", "taixuan-gong");
  map_skill("dodge", "shenxing-baibian");
  map_skill("parry", "xuantian-zhi");
  map_skill("sword", "wuming-jianfa");

  create_family("长乐帮", 2, "军师");

  set("chat_chance", 20);
  set("chat_msg", ({
    "贝海石叹口气说道：这十年之期的赏善罚恶令又快要到了，如何是好啊！哎\n",
    "贝海石低头微微说道：司徒老帮主已有多年不见踪影了！\n",
    "贝海石阵阵咳嗽道：我们这新帮主，一段时间傻乎乎的，一段时间奸猾无比，真是判若两人！\n",
  }));

  setup();
  carry_object("/clone/cloth/changpao")->wear();
  carry_object("/clone/weapon/changjian")->wield();

}

void init() {
  object ob;

  ob = this_player();

  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  say("贝海石一见有人进来，笑呵呵的说：" + RANK_D->query_respect(ob)
    + "，你是什么人怎么跑到这里来了，这里是我长乐帮，你还是速速离开！\n");
}
