inherit ROOM;

void create() {
  set("short", HIY "天山之巅" NOR);
  set("long", @LONG
这里就是天山山脉的顶峰了，传闻虚无缥缈的战神殿就在此峰，但是
数百年来从未有人能找到。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "enter": __DIR__ "zhanshendian",
    "southdown": __DIR__ "tianshan",
  ]));
  set("outdoors", "zhenjiang");
  set("no_ansuan", 1);
  set("no_fight", 1);
  setup();
  replace_program(ROOM);
}

int valid_leave(object me, string dir) {
  if (dir == "enter") {
    if (!me->query_temp("posui_tiaozhan"))
      return notify_fail(HIR "你未得到「女帝」武曌的指点，远远的看到战神殿，但是就是找不到入口！\n" NOR);
  }
  return ::valid_leave(me, dir);
}
