#include <room.h>
inherit ROOM;
void create() {
  set("short", "后院");
  set("long", @LONG
这是长乐帮的后院。四周有不少房间，是给本帮帮主休息之地。
房间隐隐有少女嬉笑之声，偶尔琴音响起。
LONG
  );
  set("exits", ([
    "south": __DIR__ "dating",
  ]));
  set("objects", ([
    __DIR__ "npc/shizhongyu": 1,
    __DIR__ "npc/shijian": 1,
    __DIR__ "npc/shinv": 2,
  ]));
  setup();
  replace_program(ROOM);
}
