inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "南岭群山");
  set("long", @LONG
这里就是云深不知处的南岭群山了。山峰连绵不绝，山脉深处似有龙吟虎啸之声，
偶尔有修道之人御兽飞行，一闪而没。江湖流传几百年前的武林圣地慈航静斋隐
于此山脉之中。
LONG);
  set("no_ansuan", 1);
  set("exits", ([
    "east": __FILE__,
    "north": __FILE__,
    "south": __FILE__,
    "west": __FILE__,
    "northwest": __FILE__,
    "northeast": __FILE__,
    "southeast": __FILE__,
    "southup": __FILE__,
    "northup": __FILE__,
    "westup": __FILE__,
    "eastup": __FILE__,
    "eastdown": __FILE__,
    "westdown": __FILE__,
    "northdown": __FILE__,
    "southdown": __FILE__,
    "southwest": __FILE__,
    "down": __FILE__,
    "up": __FILE__,
  ]));
  set("outdoors", "zhenjiang");
  set("no_clean_up", 0);
  setup();
}

void init() {
  object ob = this_player();
  ob->receive_damage("qi", 25);
  ob->receive_wound("qi", 25);
  message_vision(HIW "松下问童子，言师采药去。只在此山中，云深不知处。\n" NOR, ob);
}
int valid_leave(object me, string dir) {
  int tiandao_num;
  tiandao_num = 20;
  if (dir == "northup") me->add_temp("nlmigong/steps", 1);
  if (dir == "southdown") me->add_temp("nlmigong/steps", -1);
  if (dir == "down") me->add_temp("nlmigong/steps", -1);
  if (dir == "southdown") me->add_temp("nlmigong/steps", 1);
  if (dir == "northdown") me->add_temp("nlmigong/steps", -1);
  if (dir == "westdown") me->add_temp("nlmigong/steps", -1);
  if (dir == "eastdown") me->add_temp("nlmigong/steps", -1);
  if (dir == "up") me->add_temp("nlmigong/steps", 1);
  if (dir == "south") me->add_temp("nlmigong/steps", 1);
  if (dir == "north") me->add_temp("nlmigong/steps", 1);
  if (me->query_temp("nlmigong/steps") == tiandao_num) {
    me->move(__DIR__ "shanlu6");
    me->delete_temp("nlmigong/steps");
    return notify_fail("你咬紧牙关艰难前行，突然眼前一座直立山峰高耸，原来这里竟然是.....。\n");
  }
  if (me->query_temp("nlmigong/steps") == -tiandao_num) {
    me->move(__DIR__ "shanlu5");
    me->delete_temp("nlmigong/steps");
    return notify_fail("你咬紧牙关艰难前行，没想到转了一圈又回到原地.....。\n");
  }
  return ::valid_leave(me, dir);
}
