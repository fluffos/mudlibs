inherit ROOM;

void create()
{
      set("short","江边小路");
      set("long",@LONG
这里已经到了江边 ，由于潮湿的空气使得路面非常湿滑，行人都放
慢脚步，以免跌到。你向远处眺望，隐隐约约可以看到一条大江跨立
在山川之中，真是太美了。你恨不得立刻能看到它的庐山真面目。
LONG);

      set("exits",([ /* sizeof() == 1 */
          "north"  : __DIR__"xiaolu2",
          "south" : "/d/xiakedao/xkroad1",
		  "west" : "/d/longquan/dong1",
      ]));
      set("outdoors", "zhenjiang");

      setup();
      replace_program(ROOM);
}

