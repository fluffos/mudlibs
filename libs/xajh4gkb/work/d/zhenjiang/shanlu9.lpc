inherit ROOM;

void create() {
  set("short", "桃花林");
  set("long", @LONG
这里是一片桃林，受群山环抱，一年四季桃花纷飞，实乃人间仙境。
四大圣地之一的焚静山庄就位于桃花林中。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "enter": __DIR__ "fenjingshanzhuang",
    "southdown": __DIR__ "qinling",
  ]));
  set("outdoors", "zhenjiang");
  set("no_ansuan", 1);
  set("no_fight", 1);
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "enter") {
    if (!me->query_temp("xiantian_tiaozhan"))
      return notify_fail(HIR "你未得到「回音仙子」碧云的指点，远远的看到焚静山庄，但是就是找不到入口！\n" NOR);
  }
  return ::valid_leave(me, dir);
}
