inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "秦岭山脉");
  set("long", @LONG
这里就是云深不知处的秦岭山脉了。山峰连绵不绝，山脉深处似有龙吟虎啸之声，
偶尔有修道之人御兽飞行，一闪而没。江湖流传几百年前的武林圣地焚静山庄最后
归隐于此山脉之中。
LONG);
  set("no_ansuan", 1);
  set("exits", ([
    "east": __FILE__,
    "north": __FILE__,
    "south": __FILE__,
    "west": __FILE__,
    "northwest": __FILE__,
    "northeast": __FILE__,
    "southeast": __FILE__,
    "southup": __FILE__,
    "northup": __FILE__,
    "westup": __FILE__,
    "eastup": __FILE__,
    "eastdown": __FILE__,
    "westdown": __FILE__,
    "northdown": __FILE__,
    "southdown": __FILE__,
    "southwest": __FILE__,
    "down": __FILE__,
    "up": __FILE__,
  ]));
  set("outdoors", "zhenjiang");
  set("no_clean_up", 0);
  setup();
}

void init() {
  object ob = this_player();
  ob->receive_damage("qi", 25);
  ob->receive_wound("qi", 25);
  message_vision(HIW "横看成岭侧成峰，远近高低各不同，不识秦岭真面目，只缘身在此山中。\n" NOR, ob);
}
int valid_leave(object me, string dir) {
  int tiandao_num;
  tiandao_num = 20;
  if (dir == "northup") me->add_temp("qlmigong/steps", 1);
  if (dir == "southdown") me->add_temp("qlmigong/steps", -1);
  if (dir == "down") me->add_temp("qlmigong/steps", -1);
  if (dir == "southdown") me->add_temp("qlmigong/steps", 1);
  if (dir == "northdown") me->add_temp("qlmigong/steps", -1);
  if (dir == "westdown") me->add_temp("qlmigong/steps", -1);
  if (dir == "eastdown") me->add_temp("qlmigong/steps", -1);
  if (dir == "up") me->add_temp("qlmigong/steps", 1);
  if (dir == "south") me->add_temp("qlmigong/steps", 1);
  if (dir == "north") me->add_temp("qlmigong/steps", 1);
  if (me->query_temp("qlmigong/steps") == tiandao_num) {
    me->move(__DIR__ "shanlu9");
    me->delete_temp("qlmigong/steps");
    return notify_fail("你咬紧牙关艰难前行，突然眼前豁然开朗，一片梨花正盛放，原来这里竟然是.....。\n");
  }
  if (me->query_temp("qlmigong/steps") == -tiandao_num) {
    me->move(__DIR__ "shanlu3");
    me->delete_temp("qlmigong/steps");
    return notify_fail("你咬紧牙关艰难前行，没想到转了一圈又回到原地.....。\n");
  }
  return ::valid_leave(me, dir);
}
