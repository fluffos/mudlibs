inherit ROOM;

void create() {
  set("short", HIY "帝踏峰" NOR);
  set("long", @LONG
这里就是南岭深处的一座山峰「帝踏峰」，据闻「地尼」在此山悟道，
破碎虚空而去，传下《慈航剑典》十三篇。慈航静斋每隔百年，其传
人入世修行，匡扶正义，隐为白道武林之首。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "enter": __DIR__ "cihangjingzhai",
    "southdown": __DIR__ "nanling",
  ]));
  set("outdoors", "zhenjiang");
  set("no_ansuan", 1);
  set("no_fight", 1);
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "enter") {
    if (!me->query_temp("tianren_tiaozhan"))
      return notify_fail(HIR "你未得到「出尘仙子」师妃暄的指点，远远的看到慈航静斋，但是就是找不到入口！\n" NOR);
  }
  return ::valid_leave(me, dir);
}
