#include <ansi.h>
inherit ROOM;
void create()
{
    set("short", "长乐帮大厅");
    set("long", 
"这里是长乐帮的大厅。整个大厅十分宽阔。厅中挂满了各种\n"
"名家的书法真迹。但最显眼的则是正中挂的一幅对联：\n\n"
   
BLU "            劝君莫惜金缕衣，劝君须惜少年时。\n"
    "            有花堪折直须折，莫待无花空折枝。\n\n"
NOR
"字体遒劲挺拔，气势宏伟。\n"
);
	set("exits", ([
		"north" : __DIR__"houyuan",
		"south" : __DIR__"damen",
		]));
	set("objects", ([
        "/d/zhenjiang/npc/beihaishi" : 1,
		]) );    
    set("outdoors", "zhenjiang");
    setup();  
    replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
        object ob=present("bei haishi", environment(me));
        if (ob && living(ob) )
		{
            if (dir == "north" ) 
				return notify_fail("贝海石呵呵一笑道：后院乃我帮帮主休息之地，外人不可进入。\n");
        }
        return ::valid_leave(me, dir);
}
