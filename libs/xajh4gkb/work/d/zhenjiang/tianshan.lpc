inherit ROOM;
#include <ansi.h>
void create()
{
	set("short","天山山脉");
	set("long",@LONG
这里就是常年笼罩在积雪中的天山了。放眼望去，四周白茫茫一片，也不知多少，
年不化的积雪堆积成一座座山峰，罕无人迹，在这里行走，极容易引发雪崩。
LONG);
	set("no_ansuan", 1);
	set("exits", ([
		"east" :  __FILE__,
		"north" :  __FILE__,
		"south" :  __FILE__,
		"west" :  __FILE__,
		"northwest" :  __FILE__,
		"northeast" :  __FILE__, 
		"southeast" :  __FILE__,
		"southup" :  __FILE__,
		"northup" :  __FILE__,
		"westup" :  __FILE__,
		"eastup" :  __FILE__,
		"eastdown" :  __FILE__,
		"westdown" :  __FILE__,
		"northdown" :  __FILE__,                	
		"southdown" :  __FILE__,
		"southwest" :  __FILE__,
		"down" : __FILE__,
		"up" : __FILE__,
        ]));
	set("outdoors", "zhenjiang");
	set("no_clean_up", 0);
	setup();
}

void init()
{
	object ob=this_player();
	ob->receive_damage("qi", 25);
	ob->receive_wound("qi",  25);
	message_vision(HIW"天山雪云常不开，千峰万岭雪崔嵬。\n"NOR,ob);	
}
int valid_leave(object me, string dir)
{
	int tiandao_num;    	
	tiandao_num = 20;	
	if ( dir == "northup") me->add_temp("tsmigong/steps",1); 	
	if ( dir == "southdown") me->add_temp("tsmigong/steps",-1);	
	if ( dir == "down") me->add_temp("tsmigong/steps",-1);	
	if ( dir == "southdown") me->add_temp("tsmigong/steps",1);	
	if ( dir == "northdown") me->add_temp("tsmigong/steps",-1);	
	if ( dir == "westdown") me->add_temp("tsmigong/steps",-1);	
	if ( dir == "eastdown") me->add_temp("tsmigong/steps",-1);	
	if ( dir == "up") me->add_temp("tsmigong/steps",1);	
	if ( dir == "south") me->add_temp("tsmigong/steps",1);	
	if ( dir == "north") me->add_temp("tsmigong/steps",1);	
	if (me->query_temp("tsmigong/steps") == tiandao_num )	
	{  
		me->move(__DIR__"shanlu8");
		me->delete_temp("tsmigong/steps");
		return notify_fail("你咬紧牙关艰难前行，历经千辛万苦，没想到居然达到了山顶.....。\n");	
	}
	if (me->query_temp("tsmigong/steps") == -tiandao_num )	
	{  
		me->move(__DIR__"shanlu7");
		me->delete_temp("tsmigong/steps");
		return notify_fail("你咬紧牙关艰难前行，没想到转了一圈又回到原地.....。\n");	
	}
	return ::valid_leave(me,dir);
}
