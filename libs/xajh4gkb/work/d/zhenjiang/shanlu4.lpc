inherit ROOM;

void create()
{
      set("short","山中小路");
      set("long",@LONG
这里已经到了南岭山脉，群山渺渺。其峰隐于云雾之中，隐隐约约的
能看见半山腰。风林阵阵，偶尔有虎啸声。传闻有绝世高手隐于山林，
故能降服飞禽猛兽，令其不得下山侵扰百姓。
LONG);

      set("exits",([ /* sizeof() == 1 */
          "northup"  : __DIR__"shanlu5",
          "southdown" : __DIR__"shanlu1",
      ]));
      set("outdoors", "zhenjiang");

      setup();
      replace_program(ROOM);
}

