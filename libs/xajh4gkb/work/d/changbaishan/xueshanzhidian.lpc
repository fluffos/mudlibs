// wenhua.c
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "雪山之巅");
	set("long", @LONG
    这里是长白山瀑布源头，乃大兴安岭山脉之顶。白雪茫茫，万物凋零。
鲜卑一族起源于此，十六国时期，鲜卑各部落趁中原混乱不堪，建立慕容
氏诸燕、西秦、南凉、代国等国家。到了隋唐时期，鲜卑作为民族实体和
政权实体融入到其他民族中，逐渐消亡。在五代末期，慕容龙城独创“斗转
星移”绝技，纵横江湖，当世无敌，之后慕容氏其世代传承的“以彼之道，还
施彼身”的斗转星移武功绝技，威震江湖。可惜可叹慕容龙城武功虽强，但
赵匡胤领先一步建立大宋，大势所趋，燕国无法逆势而行，最后郁郁善终。
慕容氏一族自此迁入江南苏州，之后姑苏慕容氏便世代传承。
LONG
	);
	set("no_ansuan", 1);
	set("outdoors", "cbs");
	set("exits", ([
	]));
	set("objects",([
			"/d/mr/npc/murong-longcheng":1,
		]));	
	set("no_clean_up", 0);

	setup();
}

void init()
{	
	add_action("do_fly", "fly");
	add_action("do_conjure", "conjure");
	add_action("do_jump", "jump");
}

int do_fly(string arg)
{
    object me;
    me = this_player();

	message_vision(HIR"雪山之巅大雪积压数万年，在这里剑御剑飞行很容易引发雪崩。\n"NOR, me );
	message_vision(HIC"雪山之巅只有高手才能上来，既然上来了，那就只能依靠自身实力下去(jump down)。\n"NOR, me );
	return 1;    
}  

int do_conjure(string arg)
{
    object me;
    me = this_player();

        message_vision(HIR"雪山之巅大雪积压数万年，在这里使用道家神通很容易引发雪崩。\n"NOR, me );
		message_vision(HIC"雪山之巅只有高手才能上来，既然上来了，那就只能依靠自身实力下去(jump down)。\n"NOR, me );
        return 1;   
}  

int do_jump(string arg)
{
    object me;
    me = this_player();
	if( !arg || arg=="" ) return 0;
    if( arg=="down" ) 
    {
        if (me->query_skill("dodge", 1) >= 5000)
		{
			message_vision("$N浑身颤抖着，于凛冽寒风中，向前一跃……\n",me);
            me->move("/d/changbaishan/tianchi");
			me->unconcious();
		} else
		{
			message("rumor", HIR"【谣言四起】某人："HIW"听说" + me->query("name") + "一失足成千古恨，从雪山之巅跳了下来。。。。\n"NOR, users() );
			me->die();
			return 1;			
		}

        return 1;
    }
} 
 