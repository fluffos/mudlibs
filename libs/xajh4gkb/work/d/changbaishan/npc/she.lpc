
inherit NPC;

void create()
{
	int jibie;
	jibie = 20;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
   set_name("蛇",({ "she"}) );
        set("race", "野兽" );
        set("combat_exp",20000);
     set("long", "这是一条蛇。\n");
	 set("verbs",({"bite"}));
     set("attitude","aggressive");
     set("limbs",({"头","尾巴","七寸"}));
  setup();

}

