#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "长白瀑布");
  set("long", @LONG
由于山大坡陡，水势湍急，一眼望去，象一架斜立的天梯。瀑布口
有一巨石，将瀑布分为两股。瀑布状如白练，从天而降，雷霆万钧，如
玉龙扑向谷底，其景象蔚为壮观。急流跌水，瀑布下形成深约二十丈的
水潭。从这里攀登，可以达到大兴安岭山脉之巅，哪里万年被雪覆盖，
冰峰成山，大雪纷飞，非武林高手切莫上去(jump up)。
LONG);

  set("exits", ([
    "northup": __DIR__ "baiyun-feng",
    "southdown": __DIR__ "shanlu2",
    "eastup": __DIR__ "shanlu6",
    "westup": __DIR__ "longmen-feng",
    //  "up":__DIR__"xueshanzhidian",
  ]));
  set("outdoors", "cbs");

  set("valid_startroom", 1);
  setup();

}
//2018.9.23阿飞改，为避免大清宝图的问题，改成jump up方式
/*int valid_leave(object me, string dir)
{
    if( dir == "up") 
	{ 
        if (me->query("xyzx_sys/level",1)<1000)
            return notify_fail("以你的实力，还是别上去了，小心被狂风吹下来摔死。\n");  
    }
    return ::valid_leave(me, dir);
}
*/
void init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object me = this_player();
  if (!arg || arg == "") return 0;
  if (arg == "up") {
    if (me->query("xyzx_sys/level", 1) > 1000 && me->query_skill("dodge", 1) > 2000) {
      message_vision(HIG "你仗剑飞跃瀑布，脚下连踏七星，总算是达到那雪山之巅，放眼望去，天池雪茫茫。\n" NOR, me);
      me->move("/d/changbaishan/xueshanzhidian");
    } else {
      message_vision(HIW "你一跃而起，迎头一道瀑布落下，将你砸的晕头转向，掉入天池之中淹个半死......\n" NOR, me);
      me->move("/d/changbaishan/tianchi");
      me->unconcious();
    }
    return 1;
  } else
    return notify_fail(HIY "这里是大瀑布，别乱跳，小心掉进去淹死了。\n" NOR);
}
