// Room: /d/taohuacun/taohua1.c

inherit ROOM;
string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});
void create() {
  set("short", "桃花林");
  set("long",
    "这是一片烂漫的桃花林，满山遍野的桃树枝上，开着桃红的桃花。\n"
    "桃花上头，飞满了细细嗡嗡的不甘寂寞的蜜蜂。脚下是一条不宽也\n"
    "不窄的林间小道，道边是密密丛丛的嫩草和争奇斗艳的小花。\n\n"

    BLU "              桃花影落飞神剑\n"
    "              碧海潮生按玉箫\n\n"
    NOR
    "东海桃花岛实乃世外桃源，源自东晋陶渊明，在此开创桃花源记。\n"
    "世人在此逐渐开创种种武学，后东邪黄药师定居于此，桃花岛遂\n"
    "扬名天下。传闻在此可以从桃花源记中领悟(yanjiu)出绝世武学。\n"
  );
  set("outdoors", "city");
  //	set("no_clean_up", 0);

  set("exits", ([
    "north": __DIR__ "taohua2",
    "east": "/d/taohua/haitan",
  ]));
  set("objects", ([
    "/d/wudang/npc/bee": 1,
  ]));
  setup();
}

void init() {
  add_action("do_yanjiu", "yanjiu");
}


int do_yanjiu(string arg) {
  object weapon, me = this_player();

  string *poem = ({
    "晋太元中，武陵人捕鱼为业。缘溪行，忘路之远近。忽逢桃花林，夹岸数百步，中无杂树，芳草鲜美，落英缤纷，渔人甚异之，复前行，欲穷其林。",
    "林尽水源，便得一山，山有小口，仿佛若有光。便舍船，从口入。初极狭，才通人。复行数十步，豁然开朗。",
    "土地平旷，屋舍俨然，有良田美池桑竹之属。阡陌交通，鸡犬相闻。其中往来种作，男女衣着，悉如外人。黄发垂髫，并怡然自乐。",
    "见渔人，乃大惊，问所从来。具答之。便要还家，设酒杀鸡作食。",
    "村中闻有此人，咸来问讯。自云先世避秦时乱，率妻子邑人来此绝境，不复出焉，遂与外人间隔。",
    "问今是何世，乃不知有汉，无论魏晋。",
    "此人一一为具言所闻，皆叹惋。余人各复延至其家，皆出酒食。",
    "停数日，辞去。此中人语云：“不足为外人道也”。",
    "既出，得其船，便扶向路，处处志之。及郡下，诣太守，说如此。太守即遣人随其往，寻向所志，遂迷，不复得路。",
    "南阳刘子骥，高尚士也，闻之，欣然规往。未果，寻病终，后遂无问津者。",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫参悟桃花源记。\n");
  if (!me->query_temp("jm_taohua5"))
    return notify_fail("你未破解全真教的天罡北斗阵法。\n");
  if (!me->query_temp("jm_taohua6"))
    return notify_fail("你未探访到南海神尼之踪迹。\n");
  if (me->query("jm/taohua"))
    return notify_fail("你已经完全领悟了桃花源记的意境，自此桃花岛武学融会贯通，不需要在这领悟了。\n");
  if (me->query("family/family_name") != "桃花岛")
    return notify_fail("不是桃花岛传人，如何能参悟桃花源记？\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword" || (string)weapon->query("id") != "biyu xiao")
    return notify_fail("你不拿碧玉箫，如何能体会世外桃源意境？\n");

  if (me->query_skill("bibo-shengong", 1) < 1000) {
    tell_object(me, "你的碧波神功.......\n");
    return 1;
  }
  if (me->query_skill("yuxiao-jianfa", 1) < 2000) {
    tell_object(me, "你的玉箫剑法.......\n");
    return 1;
  }
  if (me->query_skill("luoying-zhang", 1) < 2000) {
    tell_object(me, "你的落英掌法.......\n");
    return 1;
  }
  if (me->query_skill("luoying-shenjian", 1) < 2000) {
    tell_object(me, "你的落英神剑.......\n");
    return 1;
  }
  if (me->query_skill("tanzhi-shentong", 1) < 2000) {
    tell_object(me, "你的弹指神通.......\n");
    return 1;
  }
  if (me->query_skill("qimen-wuxing", 1) < 2000) {
    tell_object(me, "你的奇门五行.......\n");
    return 1;
  }
  if (me->query("jingli") < 1000) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }

  tell_object(me, HIW "你一边舞剑，一边低吟桃花源记......\n" NOR);
  message_vision("" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -500);
  me->start_busy(2);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/taohua", 1);
    me->add("family_score", 1);
    tell_object(me, HIB "你突然醒悟道：" HIY "原来心有灵犀一点通可以有此等威力" HIR "！\n" NOR);
    tell_object(me, HIB "恭喜你融汇贯通了桃花岛武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在桃花林居然参悟桃花源记，将桃花岛武学融会贯通！\n" NOR,
      users()
    );
  }
  return 1;
}
