//inherit NPC;
inherit NPC;
inherit F_MASTER;
void consider();
void create() {
  int jibie;
  jibie = 3000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("陆乘风", ({ "lu chengfeng", "lu", "cheng" }));
  set("gender", "男性");
  set("age", 30);
  set("long",
    "这是桃花岛主的早期弟子之一。由于以前桃花岛曾有两个弟子。\n"
    "判逃，黄药师一怒之下累及无辜，将众弟子的脚筋全部挑断！\n");
  set("attitude", "peaceful");
  set("str", 20);
  set("int", 29);
  set("con", 25);
  set("dex", 27);
  set("qi", 1000);
  set("max_qi", 1000);
  set("jing", 1000);
  set("max_qi", 1000);
  set("neili", 2000);
  set("max_neili", 2000);
  set("wuyongjiali", 50);
  set("combat_exp", 200000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("bibo-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("luoying-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("anying-fuxiang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yuxiao-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qimen-wuxing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("luoying-shenjian", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "bibo-shengong");
  map_skill("unarmed", "luoying-zhang");
  map_skill("dodge", "anying-fuxiang");
  map_skill("sword", "yuxiao-jianfa");
  map_skill("parry", "luoying-shenjian");
  create_family("桃花岛", 2, "弟子");
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob) {
  if (ob->query("int", 1) < 25) {
    command("say 嗯......我桃花岛的弟子必须天资聪明，我看你的资质似乎不适合练我桃花岛的武功？\n");
    return;
  }
  if (ob->query("con", 1) < 25) {
    command("say 我桃花岛内功尤以根骨为重，可惜我身为大弟子，始终难以将师门武功发扬光大。");
    return;
  }
  if (ob->query_skill("bibo-shengong", 1) < 300) {
    command("say 你似乎对本派内功不够娴熟？\n");
    return;
  }
  command("nod");
  command("say 桃花影落飞神剑，碧海潮生按玉箫！\n");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "scholar") ob->set("class", "scholar");
  return;
}

void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "古墓派" && (int)me->query_temp("jm_gumu1")) {  //古墓派解密
    tell_room(environment(this_player()), "桃花影落飞神剑，碧海潮生按玉箫！\n");
    tell_room(environment(this_player()), "情之一字，最是伤人......\n");
    me->set_temp("jm_gumu2", 1);
  }
  ::die();
}
