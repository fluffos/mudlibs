// yuxiao.c
#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create() {
  set_name("碧玉萧", ({ "biyu xiao", "yu xiao", "yuxiao", "xiao" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "支");
    set("long", "一支碧玉做成的长萧，看上去晶莹温润。武林中人经常以萧代剑。\n");
    set("value", 10000000);
    set("flag", 2);
    set("material", "bamboo");
    set("wield_msg", "$N大袖一挥，手中已多了一支晶莹温润的碧玉萧。\n");
    set("unwield_msg", "$N手中碧玉萧一转，眨眼间碧玉萧已然不见影踪。\n");
    set("weapon_prop/dexerity", 10);
    set("weapon_prop/sword", 20);
    set("weapon_prop/dodge", 10);
    set("weapon_prop/intelligence", 10);
    set("weapon_prop/parry", 10);
  }
  init_sword(400, 2);
  setup();
}
int query_autoload() { return 1; }
