// sanjiaodian.c

#include <room.h>
inherit ROOM;
void create() {
  set("short", "三教殿");
  set("long", @LONG
这里是全寺最高处的三教殿，也是悬空寺最大的殿宇。三层九脊，
全部由每根插入崖石的木梁承受，真是“公输天巧”，古今奇迹。
你站在殿外，感觉凉风袭人，山崖下云海缥缈，仿佛人间仙境。
远处晨钟轻敲，寂静之音如若大道吟诵，让人心旷神怡。你似乎
想化作飞鸟在林中滑翔(jump down)，感受翠绿山风醉人的气息。
LONG);
  set("exits", ([ /* sizeof() == 4 */
    "down": __DIR__ "xuankong1",
  ]));
  set("no_clean_up", 0);
  set("coor/x", 0);
  set("coor/y", 3180);
  set("coor/z", 40);
  setup();
}



void init() {
  add_action("do_jump", "jump");
}


int do_jump(string arg) {

  object who = this_player();

  if (!arg || arg == "") return 0;
  if (arg != "down")
    return notify_fail("你想要跳崖自杀？这么想不开啊？\n");

  if (who->query("family/family_name") == "恒山派" && (int)who->query_skill(
    "hengshan-jian",
    1
  ) > 2000 && (int)who->query_skill(
    "dodge",
    1
  ) > 2000 && (int)who->query("xyzx_sys/level") > 2000) {
    message_vision("$N浑身颤抖着，向前一跃……\n", who);
    message_vision("$N从悬崖上跳了下来，双手乱抓，总算是抓到一根藤蔓，差一点吓死。\n", who);
    who->unconcious();
    who->move("/d/hengshan/cuiping2");
  } else {
    message(
      "rumor",
      HIR "【谣言四起】某人：" HIW "听说" + who->query("name") + "万念俱灰，纵身跳入了悬崖之中。。。。\n" NOR,
      users()
    );
    who->die();
    return 1;
  }

  return 1;
}
