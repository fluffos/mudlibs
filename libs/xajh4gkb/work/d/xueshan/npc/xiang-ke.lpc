// xiang-ke.c 进香客
inherit NPC;
void create()
{
    int value;
    value = random(10);
    set_name("进香客", ({ "jinxiang ke", "ke", "guest" }));
    set("gender", "男性");
    set("age", 14 + value * 3 );
    set("combat_exp", 500 + 5 * value);
    set("shen_type", 0);
	set("xyzx_sys/level", 50+random(50));	//2016.5.22阿飞调整NPC属性
    setup();
    add_money("silver", 1 + value);
}
