// Room: /d/wudie/cdt.c
// This is a room made by roommaker. write by Xyx.

inherit ROOM;
string *order = ( {""HIY"", ""HIG"", ""RED"", ""MAG"", ""YEL"", ""HIC"", ""HIW"", ""HIR"",""HIB"", ""CYN"",""WHT"",""HIM"",""BLU""});
void create()
{
	set("short", "琅嬛福地");
	set("long", 

"琅嬛福地为道教第二十七福地，称“琅嬛福地”或“无为神化洞天”。因长\n"
"寿仙人彭祖第三子魏王子骞与虞冲大夫在此炼丹飞升,又称“魏虞洞天”。\n"
"洞天十分宽阔，正前方有一巨大石壁，光滑如镜，旁边一道瀑布，其源头\n"
"不知何方，石壁下方一潭清泉，石壁上偶尔似有仙人舞剑。山峭之间别有\n"
"洞天，留有不少石刻，乃逍遥子以高深内力刻画，记载着逍遥一派的起源。\n"
"历代逍遥派掌门均会来此领悟逍遥之道(canwu)。\n"
"亦有不少后人在此地留下诗歌（read)。\n\n\n"
BLU "                琅  嬛  福  地\n\n"
BLU "                无  量  洞  天\n\n"
NOR
);
	

	set("exits", ([ /* sizeof() == 2 */
			"out" : __DIR__"tongmen",
		]));
	set("no_clean_up", 0);


	setup();
	replace_program(ROOM);
}

void init()
{
	add_action("do_canwu", "canwu");
	add_action("do_read", "read");
}
int do_read(string arg)
{
  object me=this_player();
  string *poem = ({
		"弹指一挥间，悲悲喜喜，修炼了千年，霓裳羽衣。",
		"穿越琅嬛福地，笙箫已千年，一曲诉不尽，琴瑟和鸣。",
		"勾勒一瞬间，生生死死，顿悟了千年，胭脂旖旎。",
		"穿梭琅嬛福地书画已千年，一纸写不尽，笔墨和嫣。",
		"无字天书载太多仙凡故事，携一缕清风，在政通人和中。",
		"无字天书凿太多乾坤故事，揽一轮明月，在政通人和中。",
		"琅嬛福地，飘渺欲仙，宫观阙宇兮，长啸仰天。",
		"琅嬛福地，缱绻若仙，亭台楼阁兮，长吟望天。",
		"穿越政和，在宫观阙宇，长啸仰天，修炼千年。",
		"穿梭政和，在亭台楼阁，长吟望天，顿悟千年。",
		"一曲诉不尽红尘的悲喜，一纸写不尽生命的轮回。",
		"只愿身在这“宁静致远”的琅嬛福地，昼夜与清风相伴，朝暮与日月为友。",
		"细数花开花落，静看云卷云舒。",
		});

	if(me->is_busy() )
		return notify_fail("你现在忙着呢，哪有功夫读无量玉璧上的诗...\n");

	if((int)me->query_skill("literate",1)<1000 )
		return notify_fail("你还看不懂上面的诗。\n");
   
	if(me->query("jing") < 100)
	{
        tell_object(me,"你还是先休息一会儿吧。\n");     
        return 1;
	}
	message_vision("$N仔细的读着无量玉璧上的诗："+(order[random(13)])+"" + poem[random(sizeof(poem))] + "\n", me);
	me->add("jing",-50);
	me->improve_skill("literate", 50+random(10));
	me->start_busy(1);

	return 1;
}
int do_canwu(string arg)
{
  object me=this_player();

	string *poem = ({
		"北冥有鱼，其名为鲲。鲲之大，不知其几千里也；化而为鸟，其名为鹏。",
		"鹏之背，不知其几千里也；怒而飞，其翼若垂天之云。是鸟也，海运则将徙于南冥。南冥者，天池也。",
		"鹏之徙于南冥也，水击三千里，抟扶摇而上者九万里，去以六月息者也。",
		"故曰：至人无己，神人无功，圣人无名。",
		"若夫乘天地之正，而御六气之辩，以游无穷者，彼且恶乎待哉？",
		"天之苍苍，其正色邪？其远而无所至极邪？其视下也，亦若是则已矣。",
		"且夫水之积也不厚，则其负大舟也无力。覆杯水于坳堂之上，则芥为之舟，置杯焉则胶，水浅而舟大也。",
		"我决起而飞，抢榆枋而止，时则不至，而控于地而已矣，奚以之九万里而南为？",
		"彼且奚适也？我腾跃而上，不过数仞而下，翱翔蓬蒿之间，此亦飞之至也。而彼且奚适也？",
		"穷发之北，有冥海者，天池也。",
		"有鱼焉，其广数千里，未有知其修者，其名为鲲。",
		"有鸟焉，其名为鹏，背若泰山，翼若垂天之云，抟扶摇羊角而上者九万里，绝云气，负青天，然后图南，且适南冥也。",
		});

    if(me->is_busy() )
        return notify_fail("你现在忙着呢，哪有功夫参悟逍遥游。\n");
    if(!me->query_temp("jm_xiaoyao9") )
        return notify_fail("你未得到无崖子的指点，无从入门。\n");	
    if(me->query("jm/xiaoyao")) 
		return notify_fail("你已经完全领悟了逍遥游的精髓，不需要在这领悟了。\n");		
    if((string)me->query("family/family_name") != "逍遥派" || (string)me->query("family/master_id")!="wuya zi")
		return notify_fail("不是逍遥派传人，如何能参悟逍遥游？\n");	
	
	if (me->query_skill("beiming-shengong",1) < 1000)
	{
        tell_object(me,"你的北冥神功.......\n"); 
        return 1;
	}
	if (me->query_skill("lingboweibu",1) < 2000)
	{
        tell_object(me,"你的凌波微步.......\n"); 
        return 1;
	}
	if (me->query_skill("zhemei-shou",1) < 2000)
	{
        tell_object(me,"你的折梅手.......\n"); 
        return 1;
	}	
    if(me->query("jingli") < 1000)
	{
        tell_object(me,"你还是先休息一会儿吧。\n");     
        return 1;
	}
	
	tell_object(me,HIW"你端坐于无量玉璧前，盘膝冥想......\n"NOR);
	message_vision(""+(order[random(13)])+"" + poem[random(sizeof(poem))] + "\n", me);
	me->add("jingli",-500);
	me->start_busy(2);

    if( random(100000) < me->query("kar",1) )
	{
        tell_object(me,HIB"你突然醒悟道："HIY"原来逍遥如意可以有此等威力"HIR"！\n"NOR);
		tell_object(me,HIB"恭喜你领悟了逍遥游的意境！\n"NOR);
		me->set("jm/xiaoyao",1);
		me->add("family_score",1);
		tell_object(me,HIB"恭喜你融汇贯通了逍遥派的武学精髓！\n"NOR);
		message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，在无量山的琅嬛福地，参悟逍遥游，领悟了逍遥之道！\n"NOR,users() );
	}
	return 1;
}             
