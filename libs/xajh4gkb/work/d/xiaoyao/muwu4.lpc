inherit ROOM;
void create()
{
        set("short", "木屋");
        set("long", @LONG
这里是一间不大的木头屋子，但是麻雀虽小，五藏俱全，屋子中只是疏
疏落落地摆着几件家具，所以也不显得怎么小。房里房外种植着许多花
花草草，清香扑面。
LONG
        );
       set("exits", ([
               "east" : __DIR__"mubanlu",
       ]));
