// qingcaop.c
#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "珍珑棋局");
  set("long", @LONG
这里是青草坪大树之巅，逍遥派祖师在此摆有一棋局，据说百年来无人能
破解。聪辩先生广发武林贴，邀请各路人士来此破解，有缘人或许能得到
逍遥派的机缘。
LONG
  );
  set("exits", ([
    "down": __DIR__ "qingcaop",
  ]));
  set("outdoors", "xiaoyao");

  set("no_clean_up", 0);
  setup();
  //        replace_program(ROOM);
}
