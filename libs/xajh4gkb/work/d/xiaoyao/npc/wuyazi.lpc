// wuyazi.c 无崖子
// shilling 97.2

inherit NPC;
inherit F_MASTER;
int ask_huaxiang();
int ask_xiaoyaoyou();
void create()
{
	int jibie;
	jibie = 7000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("无崖子", ({ "wuya zi", "wuya","zi" }));
	set("title", "逍遥派掌门");
	set("long", 
               "他就是逍遥派掌门、但是因为逍遥派属于一个在江湖中\n"
               "的秘密教派，所以他在江湖中不是很多人知道，但其实他的\n"
               "功夫却是。。。。他年满七旬，满脸红光，须眉皆白。\n");
	set("gender", "男性");
	set("age", 75);
	set("shen_type", 0);
	set("str", 40);
	set("int", 40);
	set("con", 40);
	set("dex", 40);
	set("per", 40);
	set("class", "taoist");	       
/*	set("max_qi", 2005500);
	set("max_jing", 1553000);
	set("neili", 3000000);
	set("max_neili", 3000000);
	set("jingli", 200000);
	set("max_jingli", 100000);
	set("wuyongjiali", 5100);
	set("score", 200000);	*/
	set("combat_exp", 15000000);
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("beiming-shengong", 500+jibie/3+random(jibie/5)); 
	set_skill("dodge", 500+jibie/3+random(jibie/5));   
	set_skill("lingboweibu", 500+jibie/3+random(jibie/5));   
	set_skill("unarmed", 500+jibie/3+random(jibie/5));    
	set_skill("liuyang-zhang", 500+jibie/3+random(jibie/5));   
	set_skill("parry", 500+jibie/3+random(jibie/5));   
	set_skill("blade", 500+jibie/3+random(jibie/5));   
	set_skill("ruyi-dao", 500+jibie/3+random(jibie/5));   
	set_skill("zhemei-shou", 500+jibie/3+random(jibie/5));   
	set_skill("hand", 500+jibie/3+random(jibie/5));
	set_skill("literate", 500+jibie/3+random(jibie/5));
	set_skill("art", 500+jibie/3+random(jibie/5));
	map_skill("force", "beiming-shengong");
	map_skill("dodge", "lingboweibu");
	map_skill("unarmed", "liuyang-zhang");
	map_skill("hand", "zhemei-shou");
	map_skill("parry", "zhemei-shou");
	map_skill("blade", "ruyi-dao");
	set("zhangmen_zhihuan", 1);
	create_family("逍遥派", 3, "掌门");
	set("inquiry",([
			"画像" :(: ask_huaxiang :),
			"逍遥游" :(: ask_xiaoyaoyou :),
		]));
	setup();
	carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
       if ((int)ob->query_skill("beiming-shengong", 1) < 1000) 
	   {
               command("say 我逍遥派内功的源泉来自于北冥神功的心法。"); 
               command("say " + RANK_D->query_respect(ob) +  "的北冥神功是否还应该有所提高啊？");
               return;
       }
       if ((int)ob->query_skill("lingboweibu", 1) < 1000) 
	   {
               command("say 我逍遥派身法精妙无比，逍遥意境体现的淋漓尽致。"); 
               command("say " + RANK_D->query_respect(ob) +  "的凌波微步是否还应该有所提高啊？");
               return;
       }
	if (ob->query("family/family_name")!="逍遥派")
	{
        command("say 你不是我派弟子，是如何进来此地的 ？！\n");
        command("say 护法何在！来人！将此人拖出去砍了！\n");
		return ;		
	}
		
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
        command("say 是否应该去江湖中多加磨炼。");
		return ;
    }
       if (ob->query("int",1) < 25) {
               command("say 我逍遥派武功最重视“逍遥”二字。");
               command("say 而何谓“逍遥”，这只能靠你自己去领悟。");
               command("say 但是" + RANK_D->query_respect(ob) + "的悟性似乎还有待提高啊。");
               return;
       }
       if (ob->query("dex",1) < 25) {
               command("say 我逍遥派武功最重视“逍遥”二字。");
               command("say 而何谓“逍遥”，这只能靠你自己去领悟。");
               command("say 但是" + RANK_D->query_respect(ob) + "的身法似乎还有待提高啊。");
               return;
       }
       command("smile");
       command("say 想不到在这世上竟然还有人可以继承我的逍遥心法！");
       command("recruit " + ob->query("id"));
       ob->set("title","逍遥派传人");
	   return;
}

int ask_huaxiang()
{
	object me,obj;
	me = this_player();
			
	if ( me->query("family/master_id")=="tong lao" && (string)me->query("family/family_name") == "灵鹫宫" && me->query_temp("jm_lingjiu4"))
	{//灵鹫宫解密
		message_vision(HIB"无崖子说道：然来是巫行云师姐托你来的啊，何苦呢。\n" NOR,me);
		message_vision(HIB"无崖子说道：师姐与师妹本乃我最亲之人，没想到因为我最后竟酿此大祸，吾实乃无言再见二人！ \n" NOR,me);
		message_vision(HIB"无崖子说道：吾与师妹李秋水有一女，自隐居于此后已是多年未见！ \n" NOR,me);
		me->set_temp("jm_lingjiu5",1);
	}
	else if ( (string)me->query("family/family_name") == "逍遥派" && me->query_temp("jm_xiaoyao4"))
	{//逍遥派解密
		message_vision(HIC"无崖子说道：我与巫行云、李秋水同在逍遥派学艺，我一直将她们视作亲人。\n" NOR,me);
		message_vision(HIC"无崖子说道：问世间情为何物...一言难尽...\n...巫行云...李秋水...李沧海！ \n" NOR,me);
		message_vision(HIC"无崖子说道：吾本钟情于李秋水之妹，然而却与李秋水诞有一女，四人恩怨纠葛了一辈子！ \n" NOR,me);
		message_vision(HIC"无崖子说道：既然你破解了珍珑棋局，那必然与我逍遥派有缘，我的心愿或许能了结了。 \n" NOR,me);
		message_vision(HIC"无崖子说道：行云师姐一直想要这七宝指环，你替我转交给她吧！ \n" NOR,me);
		if (query("zhangmen_zhihuan") < 1) message_vision(HIC"无崖子说道：你来晚了，七宝指环我已经交给其他人了！ \n" NOR,me);
		else
		{
			add("zhangmen_zhihuan", -1);
			obj = new("/d/xiaoyao/obj/zhihuan");
			obj->set("owner",me->query("id"));	//设定识别
			obj->move(me);
			message_vision(HIY"无崖子说道：这七宝指环就交给你了，请务必转交给巫行云师姐！ \n" NOR,me);
		}		
		message_vision(HIC"无崖子说道：我与秋水师妹的女儿如今下落不明，你去探听下落，并转告李秋水吧！ \n" NOR,me);
		me->set_temp("jm_xiaoyao5",1);
	}	
	else 
	{	
		message_vision(YEL"\n无崖子说道：画像之人乃我心中挚爱，然爱恨纠葛皆因于此。 \n" NOR,me);
	}
	
	return 1;
}
//逍遥派解密
int ask_xiaoyaoyou()
{
	object me;
	me = this_player();
			
	if ( (string)me->query("family/family_name") == "逍遥派" && me->query_temp("jm_xiaoyao6") && me->query_temp("jm_xiaoyao8"))
	{
		message_vision(HIG"无崖子说道：北冥有鱼，其名为鲲。鲲之大，不知其几千里也；化而为鸟，其名为鹏。鹏之背，不知其几千里也。！ \n" NOR,me);
		message_vision(HIG"无崖子说道：《逍遥游》是《庄子》的首篇，我派武功俱出自于此！ \n" NOR,me);
		message_vision(HIG"无崖子说道："+RANK_D->query_respect(me)+"今日解我心愿，可去无量山琅嬛福地参悟我派绝学。\n" NOR,me);
		me->set_temp("jm_xiaoyao9",1);
	}
	else 
	{	
		message_vision(HIC"\n无崖子说道：逍遥游乃追求一种绝对自由的人生观，只有忘却物我的界限，达到无己、无功、无名的境界，无所依凭而游于无穷，才是真正的“逍遥游”。 \n" NOR,me);
	}
	
	return 1;
}
void die()
{
    object obj, me;        
    me = query_temp("last_damage_from");
	if (me && me->query("family/master_id") == "ding chunqiu" && me->query_temp("jm_xingxiu4"))
	{ 
        obj = new("d/xiaoyao/obj/zhihuan");
		obj->set("owner",me->query("id"));	//设定识别
        obj->move(me);
		tell_room(environment(this_player()), "无崖子毒发攻心，脸现怪异之色，突然大笑三声，戛然而止，倒在地上，死了...\n");
		message_vision("你从无崖子尸体上搜出一个指环，偷偷的戴在大拇指上，把玩了一会又取了下来。\n",me);
	}
	::die();
}