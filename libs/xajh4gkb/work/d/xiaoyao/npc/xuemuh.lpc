//xuemuh.c 薛慕华
// shilling 97.2
inherit NPC;
inherit F_MASTER;
//void attempt_apprentice(object ob);
int ask_me();
void create() {
  int jibie;
  jibie = 1000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("薛慕华", ({ "xue muhua", "xue" }));
  set("long",
    "他就是号称阎王敌的神医——薛慕华，据说他精通医理，可以起死回生。\n");
  set("gender", "男性");
  set("title", "逍遥派“函谷八友”");
  set("nickname", "阎王敌薛神医");
  set("age", 50);
  set("attitude", "peaceful");
  set("str", 25);
  set("int", 27);
  set("con", 25);
  set("dex", 25);
  set("inquiry", ([
    "疗伤": (: ask_me :),
  ]));
  set("max_qi", 1500);
  set("max_jing", 600);
  set("neili", 3000);
  set("max_neili", 3000);
  set("wuyongjiali", 60);
  set("combat_exp", 150000);
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("ruyi-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lingboweibu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("beiming-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhemei-shou", 500 + jibie / 3 + random(jibie / 5));
  map_skill("unarmed", "zhemei-shou");
  map_skill("parry", "zhemei-shou");
  map_skill("dodge", "lingboweibu");
  map_skill("force", "beiming-shengong");
  map_skill("blade", "ruyi-dao");
  create_family("逍遥派", 5, "弟子");
  set("title", "逍遥派“函谷八友”");
  set("nickname", "神医");
  setup();
  carry_object("clone/cloth/cloth")->wear();
  carry_object("clone/weapon/blade")->wield();
}
void attempt_apprentice(object ob) {
  command("say 好吧，我就收下你了，以后要多为逍遥派出力啊。");
  command("recruit " + ob->query("id"));
  ob->set("class", "xiaoyao");
  return;
}
int ask_me() {
  object ob;
  ob = this_player();
  if (ob->query("family/family_name") != "逍遥派")
    return notify_fail("你不是我派弟子，我不可以为你疗伤。\n");
  if ((int)ob->query("eff_qi") == (int)ob->query("max_qi")) {
    command("?" + ob->query("id"));
    command("say 你没有受任何伤啊？\n");
    return 1;
  } else {
    message_vision("薛慕华喂$N服下一颗药丸,然后盘膝坐下，双掌贴着$N的背心。\n", ob);
    remove_call_out("huifu");
    call_out("huifu", 2, ob);
    return 1;
  }
}

int huifu(object ob) {
  ob->set("eff_qi", (int)ob->query("max_qi"));
  ob->set("eff_jing", (int)ob->query("max_jing"));
  message_vision("大约过了一盅茶的时份，薛慕华慢慢地站了起来。\n", ob);
  command("say 你的伤势已经全好了,可以走啦。\n");
  return 1;
}
