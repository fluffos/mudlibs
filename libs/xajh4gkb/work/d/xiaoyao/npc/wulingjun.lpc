// kanggl.c
// shilling 97.2
inherit NPC;
//inherit F_MASTER;
#include <ansi.h>

void create() {
  int jibie;
  jibie = 2000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("吴领军", ({ "wu lingjun", "wu" }));
  set("long",
    "只见他高额凸颡，容貌奇古，笑眯眯的脸色\n"
    "极为和谟，手里拿着画笔，真在专心作画。\n");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("str", 28);
  set("int", 28);
  set("con", 28);
  set("dex", 38);
  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 1000);
  set("max_neili", 1000);
  set("wuyongjiali", 60);
  set("combat_exp", 200000);
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("art", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("ruyi-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lingboweibu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("beiming-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhemei-shou", 500 + jibie / 3 + random(jibie / 5));
  map_skill("unarmed", "zhemei-shou");
  map_skill("parry", "zhemei-shou");
  map_skill("dodge", "lingboweibu");
  map_skill("force", "beiming-shengong");
  map_skill("blade", "ruyi-dao");
  create_family("逍遥派", 5, "弟子");
  set("title", "逍遥派“函谷八友”");
  set("nickname", "画狂");
  setup();
  carry_object("clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("int", 1) < 25) {
    command("shake" + ob->query("id"));
    command("say " + RANK_D->query_respect(ob) + "以你的悟性恐怕难以领会我逍遥派武学精妙之处？");
    return;
  }
  if (ob->query("family/family_name") != "逍遥派") {
    command("say 你先去找薛慕华拜师吧 ？！\n");
    return;
  }
  if ((int)ob->query_skill("beiming-shengong", 1) < 300) {
    command("say 我逍遥派内功的源泉来自于北冥神功的心法。");
    command("say " + RANK_D->query_respect(ob) + "的北冥神功是否还应该有所提高啊？");
    return;
  }
  command("say 好吧，我就收下你了，今后要多加努力啊！");
  command("recruit " + ob->query("id"));
  ob->set("class", "xiaoyao");
  return;
}
