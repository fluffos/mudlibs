// tongmen.c
// by shilling 97.2
inherit ROOM;
void create() {
  set("short", "铜门");
  set("long", @LONG
这是一个月形的铜门(tongmen)，门旁的壁上凿着“琅环福地”四个大字。
LONG
  );
  set("exits", ([
    "south": __DIR__ "shiji3",
    "west": __DIR__ "fangjian3",
  ]));
  setup();
}

void init() {
  add_action("do_open", "open");
  add_action("do_open", "push");
}

int do_open(string arg) {

  if (!arg || arg != "tongmen")
    return notify_fail("你乱推什么？\n");

  message_vision("$N运足力气，推动铜门，只见铜门缓缓的打开了，露出了一方奇异的天地。\n", this_player());
  set("exits/enter", __DIR__ "langhuan");
  remove_call_out("close");
  call_out("close", 5, this_object());

  return 1;
}

void close(object room) {
  message("vision", "铜门又'嘎嘎'地自动关上了。\n", room);
  room->delete("exits/enter");
}
