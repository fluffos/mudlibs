//七宝指环-名器
#include <armor.h>
#include <ansi.h>
inherit FINGER;
void create()
{
	set_name(HIG"七宝指环"NOR, ({ "qibao zhihuan", "zhihuan", "ring" }));
	set("weight", 500);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("value", 10000000);
		set("material", "gold");
		set("armor_prop/constitution", 10);
		set("armor_prop/intelligence", 10);
		set("armor_prop/force", 10);		
		set("armor_prop/armor", 700);
	}
	setup();
}	
int query_autoload() { return 1; }
