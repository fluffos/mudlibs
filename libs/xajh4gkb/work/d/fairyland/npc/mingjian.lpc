// zhu-changling.c 

#include <ansi.h>
inherit NPC;

void create()
{
	int jibie;
	jibie = 5000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name(HIC"名剑"NOR, ({"ming jian"}));
	set("title", HIR"名剑山庄庄主"NOR);
	set("gender", "男性");
	create_family("名剑山庄", 5, "庄主");
	set("age", 45);
	set("shen_type", 0);
	set("combat_exp", 70000000);
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("literate", 500+jibie/3+random(jibie/5));
	set_skill("tianmo-shengong", 500+jibie/3+random(jibie/5));
	set_skill("tianmo-jian", 500+jibie/3+random(jibie/5));
	set_skill("wuxue-shenfa", 500+jibie/3+random(jibie/5));
	set_skill("tianmo-quan", 500+jibie/3+random(jibie/5));
    map_skill("force", "tianmo-shengong");
    map_skill("dodge", "wuxue-shenfa");
    map_skill("parry", "tianmo-jian");
    map_skill("unarmed", "tianmo-quan");
    map_skill("sword", "tianmo-jian");	
	set_temp("apply/attack", 40);
	set_temp("apply/defense", 40);
	set_temp("apply/damage", 10);
	set("no_get",1);
	setup();
	carry_object("/clone/weapon/longyin")->wield();
    carry_object("/clone/cloth/long_cloth")->wear();	
	add_money("gold", 50);
}

void die()
{
    object ob, me;        
    me = query_temp("last_damage_from");
	if (me && (string)me->query("family/family_name") == "杀手楼" && me->query_temp("jm_shashou1"))
	{ 
        ob = new("d/fairyland/obj/rentou1");
		ob->set("owner",me->query("id"));	//设定识别
        ob->move(environment(this_object()));
		ob->set("long", "江湖三大高手之一，名剑山庄庄主，看起来风流倜傥，只是，目前已经没有了头颅。\n");
		tell_room(environment(this_player()), "名剑惨嚎一声，倒在地上，头颅已然不见了．\n");
	}
	::die();
}