#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIR "名剑山庄" NOR);
  set("long", @LONG
这是一座颇大的庄子。一眼看去就知道此间主人是当地的富豪，在昆仑山
中有这么大的一座山庄确实非常少见。据说，此间主人乃江湖三大高手之一，
所以路过之人也不敢随意的进入，当以江湖之礼求见。
LONG);
  set("exits", ([
    "southdown": __DIR__ "xiaolu",
  ]));
  set("objects", ([
    __DIR__ "npc/mingjian": 1,
    __DIR__ "npc/hengdao": 1,
    __DIR__ "npc/xiaosanshao": 1,
  ]));
  set("outdoors", "昆仑山");
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
