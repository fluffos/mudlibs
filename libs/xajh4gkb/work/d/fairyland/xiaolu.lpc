inherit ROOM;
void create() {
  set("short", "山路");
  set("long", @LONG
这是一条昆仑山上到处可见的山路。只是这里已随处可见梅树，梅花盛开
时到处一片火红，花香飘溢。北面山上就是赫赫有名的名剑山庄。
LONG);
  set("exits", ([
    "southdown": __DIR__ "conglin2",
    "northup": __DIR__ "mjszhuang",
  ]));
  set("outdoors", "昆仑山");
  set("no_clean_up", 0);

  setup();
}
