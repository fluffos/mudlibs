// dongkou.c By River 98/09

inherit ROOM;
#include <ansi.h>
string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});

void create() {
  set("short", HIY "金顶" NOR);
  set("long", @LONG
武当金顶建在众峰拱托、直插云霄的武当最高峰——天柱峰的绝顶上。
千层楼阁空中起，万叠云山足下环。每逢旭日初升，阴阳一线之间。
在这里可以参悟（canwu）武当太极两仪大道。
LONG
  );

  set("exits", ([
    "down": __DIR__ "chaotian",
  ]));

  set("outdoors", "武当");

  setup();
}

void init() {
  add_action("do_canwu", "canwu");
}


int do_canwu(string arg) {
  object me = this_player();

  string *poem = ({
    "大道，在太极之上而不为高；在六极之下而不为深；先天地而不为久；长于上古而不为老。",
    "易有太极，是生两仪。两仪生四象，四象生八卦。",
    "太极谓天地未分之前，元气混而为一，即是太初、太一也。",
    "四十九数合而未分，是象太极也。今分而为二，以象两仪矣。",
    "盖易者，天用地之数……浑天象也；玄者，地承天之数……盖天象也。",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫参悟太极。\n");
  if (!me->query_temp("jm_wudang10"))
    return notify_fail("你未得到张真人的指点，没办法参悟太极之道。\n");
  if (me->query("jm/wudang"))
    return notify_fail("你已经完全参透了这太极而无极的境界，不需要在这领悟了。\n");
  if (me->query("family/family_name") != "武当派")
    return notify_fail("不是武当派传人，如何能进入这金顶的？\n");

  if (me->query_skill("taiji-shengong", 1) < 1000 && me->query_skill("yinyun-ziqi", 1) < 1000) {
    tell_object(me, "你的太极内功.......\n");
    return 1;
  }
  if (me->query_skill("taiji-jian", 1) < 2000) {
    tell_object(me, "你的太极剑法.......\n");
    return 1;
  }
  if (me->query_skill("taiji-quan", 1) < 2000) {
    tell_object(me, "你的太极拳.......\n");
    return 1;
  }
  if (me->query("jingli") < 1000) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }

  tell_object(me, HIW "你脚踏太极，双手划圆，神韵优雅，时快时慢，似松非松......\n" NOR);
  message_vision("" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -500);
  me->start_busy(2);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/wudang", 1);
    me->add("family_score", 1);
    tell_object(me, HIB "你突然醒悟道：" HIY "原来太极竟然有如此的威力" HIR "！\n" NOR);
    tell_object(me, HIB "恭喜你融汇贯通了武当派武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在武当山金顶领悟了太极而无极之意，将武当派武功融会贯通！\n" NOR,
      users()
    );
  }
  return 1;
}
