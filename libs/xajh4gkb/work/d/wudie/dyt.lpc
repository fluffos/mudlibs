// Room: /d/wudie/dyt.c
// This is a room made by roommaker. write by Xyx.

inherit ROOM;
string *order = ( {""HIY"", ""HIG"", ""RED"", ""MAG"", ""YEL"", ""HIC"", ""HIW"", ""HIR"",""HIB"", ""CYN"",""WHT"",""HIM"",""BLU""});
void create()
{
        set("short", "蝶翼堂");
        set("long", @LONG
这里是一处平地，是琼雅蝶练剑的地方，因为彩碟快要死的时候都
会飞到这里来，死后就留下它那翅膀。微风吹过，片片彩碟的翅膀
随风起舞，琼雅蝶就是在这里练成了旷世绝学---蝶翼剑法。你或许
在这里能领悟（lianxi）蝶翼剑法的精髓。
LONG
);
        set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"pjt",
  "south" : __DIR__"cdt",
]));
        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}

void init()
{
	add_action("do_lianxi", "lianxi");
}
int do_lianxi(string arg)
{
  object weapon,me=this_player();

	string *poem = ({
		"山青绿水花满地，舞蝶群群伴君行。遥视彩云落人间，确见花蝶满园香。",
		"借问此何时？蝴蝶飞南园。流波恋旧浦，行云思故山。",
		"穿花蛱蝶深深见，点水蜻蜓款款飞。传语风光共流转，暂时相伴莫相违。",
		"蝴蝶不传千里梦，子规叫断三更月。听声声枕上劝人归， 归难得。",
		"青陵台畔日光斜，万古贞魂绮莫霞。莫讶韩凭为蛱蝶，等闲飞上别枝花。",
		"迷离蝶树千蝴蝶，衔尾如缨拂翠恬。 不到蝶泉谁肯信，幢影幡盖蝶庄严。",
		});

    if(me->is_busy() )
        return notify_fail("你现在忙着呢，哪有功夫参悟蝶翼剑法。\n");
    if(!me->query_temp("jm_wudie6") )
        return notify_fail("你未得到舞蝶仙的指点，但凭自己恐怕领悟不了。\n");	
    if(me->query_temp("jm_wudie_dieyi") )
        return notify_fail("你练习蝶翼剑法，已经达到了蝶舞飞满花的神韵。\n");
    if(me->query("jm/wudie")) 
		return notify_fail("你已经完全领悟了蝶舞门的精髓，不需要在这领悟了。\n");		
    if((string)me->query("family/family_name") != "舞蝶仙" || (string)me->query("family/master_id")!="qiong yadie")
		return notify_fail("不是舞蝶仙传人，如何能参悟蝶翼剑法？\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword" || (string)weapon->query("id") != "die jian")
		return notify_fail("你不拿蝶剑，恐怕体会不了彩蝶起舞的意境。\n");
	
	if (me->query_skill("wudie-xinjing",1) < 1000)
	{
        tell_object(me,"你的舞蝶心经.......\n"); 
        return 1;
	}
	if (me->query_skill("dieyi-jianfa",1) < 2000)
	{
        tell_object(me,"你的蝶翼剑法.......\n"); 
        return 1;
	}
	if (me->query_skill("wudie-bu",1) < 2000)
	{
        tell_object(me,"你的舞蝶步法.......\n"); 
        return 1;
	}	
    if(me->query("jingli") < 1000)
	{
        tell_object(me,"你还是先休息一会儿吧。\n");     
        return 1;
	}
	
	tell_object(me,HIW"你站在群蝶之间，翩翩舞剑......\n"NOR);
	message_vision(""+(order[random(13)])+"" + poem[random(sizeof(poem))] + "\n", me);
	me->add("jingli",-500);
	me->start_busy(2);

    if( random(100000) < me->query("kar",1) )
	{
        me->set_temp("jm_wudie_dieyi",1);
        tell_object(me,HIB"你突然醒悟道："HIY"原来蝶舞飞满花可以有此等威力"HIR"！\n"NOR);
		tell_object(me,HIB"恭喜你领悟了蝶翼剑法的精髓！\n"NOR);
		if ((int)me->query_temp("jm_wudie_meihua"))
		{
			me->set("jm/wudie",1);
			me->add("family_score",1);
			tell_object(me,HIB"恭喜你融汇贯通了蝶舞门的武学精髓！\n"NOR);
			message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，在蝶翼堂练习蝶翼剑法，将蝶舞门武学融会贯通！\n"NOR,users() );		
		}
	}
	return 1;
}             
