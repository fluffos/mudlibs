//凤凰琴-名器

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIM "凤凰琴" NOR, ({ "fenghuang qin", "qin" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("value", 40000);
    set("material", "steel");
    set("long", "相传这便是当年司马相如与卓文君弹奏凤求凰用的古琴，象征着琴瑟和鸣。\n");
    set("wield_msg", HIY "$N伸手轻轻一挥,一张古琴琴便已出现在$N手中，其音瑟瑟.\n" NOR);
    set("unwield_msg", HIY "$N十指一拂，琴声曳然而止。$N收起凤凰琴，放进背着的包袱里。\n" NOR);
    set("unequip_msg", HIY "你十指一拂，琴声曳然而止。你收起凤凰琴，放进背着的包袱里。.\n" NOR);
    set("weapon_prop/dexerity", 10);
    set("weapon_prop/sword", 20);
    set("weapon_prop/dodge", 5);
    set("weapon_prop/intelligence", 10);
    set("weapon_prop/parry", 10);
  }
  init_sword(400, 2);
  setup();
}

int query_autoload() { return 1; }
