//舞蝶仙衣-名器
#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name(HIM "舞蝶仙衣" NOR, ({ "wudie cloth", "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("wear_msg", HIM "昨夜星辰昨夜风，画楼西畔桂堂东。身无彩凤双飞翼，心有灵犀一点通。\n" NOR);
    set("remove_msg", HIY "锦瑟无端五十弦，一弦一柱思华年。庄生晓梦迷蝴蝶，望帝春心托杜鹃。\n" NOR);
    set("value", 5000000);
    set("armor_prop/dexerity", 10);
    set("armor_prop/personality", 10);
    set("armor_prop/dodge", 10);
    set("armor_prop/armor", 600);
  }
  setup();
}
int query_autoload() { return 1; }
