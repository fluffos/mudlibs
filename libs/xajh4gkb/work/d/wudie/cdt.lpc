// Room: /d/wudie/cdt.c
// This is a room made by roommaker. write by Xyx.

inherit ROOM;
string *order = ( {""HIY"", ""HIG"", ""RED"", ""MAG"", ""YEL"", ""HIC"", ""HIW"", ""HIR"",""HIB"", ""CYN"",""WHT"",""HIM"",""BLU""});
void create()
{
	set("short", "彩蝶堂");
	set("long", @LONG
这就是艳蝶堂了，这里什么也没有，只是墙上挂着一副画，画着一
美丽女子，相传就是香香公主，画上还题了一首陈家洛为了祭香香公主
的诗：“浩浩愁，茫茫劫，短歌终，明月缺。郁郁佳城，中有碧血。碧
亦有时尽，血亦有时灭，一缕香魂无断绝！是耶非耶？化为蝴蝶。”
红尘自有痴情者，莫笑痴情太痴狂！若非一番寒彻骨，那得梅花扑鼻香！
你或许可以从画像中领悟（yanzou）到什么。
LONG
);
	set("noon", "正午时分堂外花香散近来，配合堂里彩蝶的装饰给人脱俗的感觉。");
	set("morning", "早晨的空气清新阳光洒满大地，小鸟在枝头鸣唱。");
	set("sunrise", "此时的太阳一悄悄挂在东方天际，金色的阳光透过窗户射了进来。");
	set("dawn", "黎明前堂里没有人影。蜡烛已经燃尽看不太清堂里的装饰。");
	set("midnight", "闪闪烛光拌着深夜的来到，静静的毫无声响。");
	set("night", "夜晚浓浓花香拌着悦耳琴音让人忘记俗世里的一切。");
	set("evening", "傍晚的花香特别浓，随香望去堂外花园万只蝴蝶偏偏起舞。");
	set("afternoon", "午后的阳光懒懒的散进堂内洒在你的身上柔柔的暖暖的。");	
	
	set("exits", ([ /* sizeof() == 2 */
			"east" : __DIR__"wdt",
			"north" : __DIR__"dyt",
		]));
	set("no_clean_up", 0);


	setup();
	replace_program(ROOM);
}

void init()
{
	add_action("do_yanzou", "yanzou");
}
int do_yanzou(string arg)
{
  object me=this_player();

	string *poem = ({
		"问世间情为何物？直教人生死相许。看人间多少故事，最销魂梅花三弄！",
		"红尘自有痴情者，莫笑痴情太痴狂！若非一番寒彻骨，那得梅花扑鼻香！",
		"梅花一弄断人肠，梅花二弄费思量。梅花三弄风波起，云烟深处水茫茫！",
		"梅花一弄、弄清风；梅花二弄、弄飞雪；梅花三弄、弄光影；暗香浮动、水清清。",
		});

    if(me->is_busy() )
        return notify_fail("你现在忙着呢，哪有功夫参悟蝶翼剑法。\n");
    if(!me->query_temp("jm_wudie7") )
        return notify_fail("你未得到舞蝶仙的指点，但凭自己恐怕领悟不了。\n");	
    if(me->query_temp("jm_wudie_meihua") )
        return notify_fail("你演奏梅花三弄，完全领悟了三弄之境。\n");
    if(me->query("jm/wudie")) 
		return notify_fail("你已经完全领悟了蝶舞门的精髓，不需要在这领悟了。\n");		
    if((string)me->query("family/family_name") != "舞蝶仙" || (string)me->query("family/master_id")!="qiong yadie")
		return notify_fail("不是舞蝶仙传人，如何能参悟蝶翼剑法？\n");	
	
	if (me->query_skill("wudie-xinjing",1) < 1000)
	{
        tell_object(me,"你的舞蝶心经.......\n"); 
        return 1;
	}
	if (me->query_skill("meihua-sannong",1) < 2000)
	{
        tell_object(me,"你的梅花三弄.......\n"); 
        return 1;
	}
	if (me->query_skill("wudie-bu",1) < 2000)
	{
        tell_object(me,"你的舞蝶步法.......\n"); 
        return 1;
	}	
    if(me->query("jingli") < 1000)
	{
        tell_object(me,"你还是先休息一会儿吧。\n");     
        return 1;
	}
	
	tell_object(me,HIW"你吹奏梅花三弄笛曲，一缕香魂唤来无数彩蝶......\n"NOR);
	message_vision(""+(order[random(13)])+"" + poem[random(sizeof(poem))] + "\n", me);
	me->add("jingli",-500);
	me->start_busy(2);

    if( random(100000) < me->query("kar",1) )
	{
        me->set_temp("jm_wudie_meihua",1);
        tell_object(me,HIB"你突然醒悟道："HIY"原来梅花三弄可以有此等威力"HIR"！\n"NOR);
		tell_object(me,HIB"恭喜你领悟了梅花三弄的精髓！\n"NOR);
		if ((int)me->query_temp("jm_wudie_dieyi"))
		{
			me->set("jm/wudie",1);
			me->add("family_score",1);
			tell_object(me,HIB"恭喜你融汇贯通了蝶舞门的武学精髓！\n"NOR);
			message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，在彩蝶堂演奏梅花三弄，将蝶舞门武学融会贯通！\n"NOR,users() );		
		}
	}
	return 1;
}             
