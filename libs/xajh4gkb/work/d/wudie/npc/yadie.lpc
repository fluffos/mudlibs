#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_dieqing();
int ask_xiang();
int ask_dieyi();
int ask_meihua();
void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("琼雅蝶", ({ "qiong yadie", "qiong" }));
  set("long", "舞蝶仙传人，由于琼山与世隔绝已无从得知其来历。\n");
  create_family("舞蝶仙", 7, "掌门人");
  set("title", HIG "舞" HIM "蝶" HIR "仙" NOR);
  set("attitude", "peaceful");
  set("age", 35);
  set("gender", "女性");
  set("shen_type", 1);
  set("chat_chance", 1);
  //	set("no_drop",1);
  set("con", 30);
  set("dex", 30);
  set("int", 30);
  set("str", 30);
  set("per", 40);
  set("ker", 40);
  set("qi", 400000);
  set("max_qi", 400000);
  set("jing", 10000);
  set("max_jing", 10000);
  set("jingli", 10000);
  set("max_jingli", 10000);
  set("neili", 300000);
  set("max_neili", 300000);
  set("wuyongjiali", 100);
  set("combat_exp", 100000000);
  set_skill("hand", 500 + jibie / 3 + random(jibie / 5));
  set_skill("art", 500 + jibie / 3 + random(jibie / 5));
  set_skill("music", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taoism", 500 + jibie / 3 + random(jibie / 5));
  set_skill("meihua-sannong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dieyi-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wudie-xinjing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wudie-bu", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "wudie-xinjing");
  map_skill("dodge", "wudie-bu");
  map_skill("parry", "dieyi-jianfa");
  map_skill("sword", "dieyi-jianfa");
  map_skill("hand", "music");
  map_skill("unarmed", "meihua-sannong");

  set("inquiry", ([
    "蝶翼剑法": (: ask_dieyi :),
    "梅花三弄": (: ask_meihua :),
    "蝶青": (: ask_dieqing :),
    "香香公主": (: ask_xiang :),
  ]));

  setup();
  carry_object("d/wudie/obj/dieyi")->wear();
  carry_object("d/wudie/obj/jian")->wield();
  carry_object("d/wudie/obj/fenghuangqin");
}
void attempt_apprentice(object who) {
  if (who->query("gender") != "女性") {
    command("say 臭男人！想上来送死吗？");
    return;
  }

  if ((int)who->query("per", 1) < 25) {
    command("say 我舞碟琼山只收容色超群的女子！\n");
    return;
  }
  if ((int)who->query("int", 1) < 25) {
    command("say 我舞碟琼山只收悟性超群的女子！\n");
    return;
  }
  if ((int)who->query("dex", 1) < 25) {
    command("say 我舞碟琼山只收身姿轻盈的女子！\n");
    return;
  }
  if ((int)who->query_skill("wudie-xinjing", 1) < 1000) {
    command("say 你对我蝶舞琼山的内功心法不够娴熟！\n");
    return;
  }
  command("say 好吧！孩子，就收下你了！\n");
  command("say 舞碟琼山与世隔绝！我如果我发现你和俗世有什么瓜葛就要严处。。。\n");
  command("recruit " + who->query("id"));
  return;

}
void init() {
  ::init();
  add_action("do_learn", "learn");
  add_action("do_learn", "xuexi");
}

int do_learn() {
  object who;
  who = this_player();
  if (who->query("shen") > 1000 || who->query("shen") < -1000) {
    command("say 你的神似乎不对！先自己检点一下！");
    return 1;
  }
}

int ask_dieqing() {
  if (this_player()->query_temp("book_4") == 2) {
    if (random(2) == 0) {
      command("sigh " + this_player()->query("id"));
      command("tell " + this_player()->query("id") + " 你是说蝶青？。。。\n哎！她是几年前我派的逆徒。。。打着我山庄的旗号到处为非作歹！\n如果你能把杀了，我一定重谢！\n 听说他和邪派高手混在一起。");
      this_player()->set_temp("book_4", 30);
    } else {
      command("tell " + this_player()->query("id") + " 你是说蝶青？。。。\n哎！她是我爱徒弟！几年前为师派他下山追查天书下落。。。\n可是她一去无归，不知生死。");
      this_player()->set_temp("book_4", 31);
    }
  } else {
    command("say 你找死！");
    this_object()->kill_ob(this_player());
  }
}
//蝶舞门解密
int ask_xiang() {
  object me;
  me = this_player();

  if ((string)me->query("family/family_name") == "舞蝶仙" && (string)me->query("family/master_id") == "qiong yadie") {
    message_vision(HIG "琼雅蝶说道：我派彩蝶堂挂着一幅画像，据说是香香公主。\n" NOR, me);
    message_vision(HIG "琼雅蝶说道：香香公主的纯洁爱情可悲可泣，死后一缕香魂化作碧玉。\n" NOR, me);
    message_vision(HIG "琼雅蝶说道：你可以去找香香公主的姐姐探听其下落！\n" NOR, me);
    me->set_temp("jm_wudie1", 1);
  } else {
    message_vision(YEL "琼雅蝶说道：香香公主是回族人民心中的神圣的女神，然而天妒红颜！\n" NOR, me);
  }

  return 1;
}
int ask_dieyi() {
  object me;
  me = this_player();

  if ((string)me->query("family/family_name") == "舞蝶仙" && (string)me->query("family/master_id") == "qiong yadie" && (int)me->query_temp("jm_wudie5")) {
    message_vision(HIG "琼雅蝶说道：蝶翼剑法是我在蝶翼堂领悟的。\n" NOR, me);
    message_vision(HIG "琼雅蝶说道：山青绿水花满地，舞蝶群群伴君行。遥视彩云落人间，确见花蝶满园香。\n" NOR, me);
    message_vision(HIG "琼雅蝶说道：你只能去蝶翼堂才能领悟彩蝶起舞的意境！\n" NOR, me);
    me->set_temp("jm_wudie6", 1);
  } else {
    message_vision(YEL "琼雅蝶说道：蝶翼剑法唯女性弟子才能学，我派弟子中当数蝶青剑法最好！！\n" NOR, me);
  }

  return 1;
}
int ask_meihua() {
  object me;
  me = this_player();

  if ((string)me->query("family/family_name") == "舞蝶仙" && (string)me->query("family/master_id") == "qiong yadie" && (int)me->query_temp("jm_wudie5")) {
    message_vision(HIG "琼雅蝶说道：梅花三弄由我派祖师自香香公主画像中领悟的。\n" NOR, me);
    message_vision(HIG "琼雅蝶说道：梅花一弄断人肠，梅花二弄费思量。梅花三弄风波起，云烟深处水茫茫！\n" NOR, me);
    message_vision(HIG "琼雅蝶说道：至今我都无法领悟梅花三弄的最高意境，或许你可以去彩蝶堂参悟！\n" NOR, me);
    me->set_temp("jm_wudie7", 1);
  } else {
    message_vision(YEL "琼雅蝶说道：梅花三弄出自一本神奇秘谱，唯女子才能练习！\n" NOR, me);
  }

  return 1;
}
int accept_object(object who, object ob) {
  object book;
  if ((int)who->query_temp("book_4") == 44) {
    if ((string)ob->query("name") == "蝶青的尸体") {
      message_vision("琼雅蝶仔细辨认了一下$N送来的尸体苦笑道：\n"
        "呵！呵！呵！多谢你为本庄除去叛徒，这本书是感谢你的。\n", who);
      destruct(ob);
      book = new("/clone/book/unarmedbook");
      book->move(this_player());
      command("rumor " + this_player()->query("name") + "得到一本无字天书！");
      return 0;
    }
  }
}
