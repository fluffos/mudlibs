// xiang.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

//int ask_kill();

void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("向问天", ({ "xiang wentian", "xiang" }));
  set("nickname", HIR "天王老子" NOR);
  set("gender", "男性");
  set("title", "日月神教光明右使");
  set("long", "他就是日月神教的光明右使。为人极为豪爽。\n");
  set("age", 45);
  set("shen_type", 0);
  set("attitude", "peaceful");
  set("str", 21);
  set("per", 28);
  set("int", 30);
  set("con", 26);
  set("dex", 30);
  set("chat_chance", 1);
  set("inquiry", ([
    "杨莲亭": "这种人，该杀！\n",
    //     "东方不败" : (: ask_kill() :),
    "任我行": "教主被困，已历十年......\n",
  ]));
  set("qi", 4000);
  set("max_qi", 4000);
  set("jing", 1000);
  set("max_jing", 1000);
  set("neili", 3500);
  set("max_neili", 3500);
  set("wuyongjiali", 350);

  set("combat_exp", 45000000);
  set("score", 0);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianmo-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuxue-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianmo-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianmo-jian", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "tianmo-shengong");
  map_skill("dodge", "wuxue-shenfa");
  map_skill("parry", "tianmo-jian");
  map_skill("unarmed", "tianmo-quan");
  map_skill("sword", "tianmo-jian");

  create_family("日月神教", 2, "光明右使");

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("clone/cloth/cloth")->wear();
}

int recognize_apprentice(object me) {
  command("say 我现在有事要办，没时间指点你修为。");
  return 1;
}

void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "梅庄" && me->query_temp("jm_meizhuang5")) {
    tell_room(environment(this_player()), "向问天说道：任教主已失踪十年之久，最近查到似乎被关在西湖湖底！！！\n");
    tell_room(environment(this_player()), "向问天骂道：梅庄四友受东方之命，在西湖湖畔看押我神教教主，待我救出教主，必屠了梅庄！！！\n");
    tell_room(environment(this_player()), "向问天惨嚎一声，倒在地上，两腿一蹬，死了.....．\n");
    me->set_temp("jm_meizhuang6", 1);
  }
  ::die();
}
