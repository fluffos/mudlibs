// huangzhong-gong.c
inherit NPC;
inherit F_MASTER;
int ask_meizhuang();
int ask_qixian();
void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name("黄钟公", ({ "huangzhong gong", "gong" }));
        set("title", "梅庄大庄主");
        set("long",
                "他就是梅庄四位庄主排行第一的黄钟公。\n"
                "身穿一件干干净净的黄色长袍。\n"
                "他已年愈六旬，身材中等，面容和蔼可亲。\n");
        set("gender", "男性");
        set("age", 62);
        set("class", "scholar");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 28);
        set("int", 28);
        set("con", 28);
        set("dex", 28);

        set("max_qi", 1000);
        set("max_jing", 1000);
        set("neili", 1000);
        set("max_neili", 1000);
        set("wuyongjiali", 100);
        set("combat_exp", 500000);
        set("shen", 15000);
        set("score", 60000);
		set("meizhuang_jienan",1);
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("wuzheng-xinfa", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("yaoming-dodge", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("wuyun-jianfa", 500+jibie/3+random(jibie/5));
        set_skill("literate", 500+jibie/3+random(jibie/5));
		set_skill("unarmed", 500+jibie/3+random(jibie/5));
		set_skill("qixian-wuxingjian", 500+jibie/3+random(jibie/5));
		set_skill("wuying-shenquan", 500+jibie/3+random(jibie/5));
		map_skill("unarmed", "qixian-wuxingjian");
        map_skill("force", "wuzheng-xinfa");
        map_skill("dodge", "yaoming-dodge");
        map_skill("parry", "qixian-wuxingjian");
        map_skill("sword", "qixian-wuxingjian");
		
        create_family("梅庄", 1, "大庄主");
        set("inquiry", ([
                "梅庄劫难" : (: ask_meizhuang :),
				"七弦无形剑" : (: ask_qixian :),
        ]));		
		
        setup();
		carry_object("/d/meizhuang/obj/qin")->wield();
		carry_object("/d/meizhuang/npc/obj/heiyi")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("wuzheng-xinfa",1) < 1000) {
                command("say 在我梅庄的内功上，" + RANK_D->query_respect(ob) +
                        "是否还应该多下点功夫？");
                return;
        }
        if ((int)ob->query_skill("force",1) < 1000) {
                command("say 你的基本内功不够娴熟。");
                return;
        }
        if ((int)ob->query("max_neili") < 100000) {

                command("say 你的内力不够深厚。");
                return;
        }		
        if ((int)ob->query("con",1) < 30) {

                command("say 七弦无形剑全靠内功，没有优秀的根骨是练不成的。");
                return;
        }		
        command("say 好吧，在下就收下你了。");
        command("recruit " + ob->query("id"));
		return;
}

int accept_object(object me, object ob)
{

	if ( (string)ob->query("id") =="guang ling san" )
	{
            if ( (string)me->query("family/family_name") == "梅庄" && me->query("id")==ob->query("owner"))
			{
				message_vision("$N对$n说道：这居然是竹林七贤嵇康临终时弹奏的广陵散！！！\n", this_object(),me);
                message_vision("$N对$n大笑道：不错不错，这位"+RANK_D->query_respect(me)+"解我一段心结......\n", this_object(),me);
				message_vision("$N对$n说道：若你能完成我们四兄弟的心愿，或许可以解开我梅庄的一段恩怨！！！\n", this_object(),me);
				me->set_temp("jm_meizhuang1",1);
                return 1;
            } else
			{
                message_vision("$N对$n说道：多谢这位"+RANK_D->query_respect(me)+"，这本琴谱我就笑纳了。\n",this_object(),me);
                return 1;
			}
	}
	return 0;
}

int ask_meizhuang()
{
	object me,ob,room1,monk1,room2,monk2;
	me = this_player();
	ob = this_object();
	
	if ( me->query_temp("jm_meizhuang1") && me->query_temp("jm_meizhuang2") && me->query_temp("jm_meizhuang3") && me->query_temp("jm_meizhuang4") && (string)me->query("family/family_name") == "梅庄")
	{
		if(this_object()->query("meizhuang_jienan") < 1) 
			return notify_fail("已经有人来解决梅庄劫难了，这位"+RANK_D->query_respect(me)+"可静候片刻。\n");
		message_vision(HIB"黄钟公说道：这位"+RANK_D->query_respect(me)+"为我梅庄四友达成了毕生心愿。\n" NOR,me);
		message_vision(HIB"黄钟公说道：现如今，日月神教东方教主不问教中之事，导致昔日任教主一脉有死灰复燃之势！” \n" NOR,me);
		message_vision(HIC"黄钟公说道：听闻最近神教向右使频繁出没我梅庄附近。。。。。我梅庄可能要大祸临头了。” \n" NOR,me);
		message_vision(HIC"黄钟公说道：这位"+RANK_D->query_respect(me)+"可否为我兄弟四人解此劫难？” \n" NOR,me);
		me->set_temp("jm_meizhuang5",1);
		if(!( room1 = find_object("/d/meizhuang/tianjing")) ) room1 = load_object("/d/meizhuang/tianjing");
		monk1 = new("/d/meizhuang/npc/linghu.lpc");
		monk1->move(room1);
		if(!( room2 = find_object("/d/meizhuang/xiaolu")) ) room2 = load_object("/d/meizhuang/xiaolu");
		monk2 = new("/d/meizhuang/npc/xiang.lpc");
		monk2->move(room2);
		this_object()->set("meizhuang_jienan", 0);
	}
	else 
	{
		message_vision(YEL"黄钟公说道：我兄弟四人本为日月神教中人，然而两任教主均威福自用，导致本教日益凋零，于是我四人闲居西湖，钻研琴棋书画。” \n" NOR,me);
		message_vision(YEL"黄钟公说道：我四人于琴棋书画各有所得，若这位"+RANK_D->query_respect(me)+"能达成我四人心愿，或许可获得我梅庄机缘。\n", me);	
	}
	
	return 1;
}

int ask_qixian()
{
	object me,ob;
	me = this_player();
	ob = this_object();
	
	if ( me->query_temp("jm_meizhuang6") && me->query_temp("jm_meizhuang7") && (string)me->query("family/family_name") == "梅庄")
	{
		message_vision(HIB"黄钟公说道：这位"+RANK_D->query_respect(me)+"为我梅庄解除了此次劫难。\n" NOR,me);
		message_vision(HIB"黄钟公说道：如今江湖是非日益加剧，我梅庄处境艰难，我梅庄绝学恐怕会断失传承！” \n" NOR,me);
		message_vision(HIC"黄钟公说道：我梅庄起源于西湖湖畔，这位"+RANK_D->query_respect(me)+"可去此地领悟我梅庄武功精髓。” \n" NOR,me);
		me->set_temp("jm_meizhuang8",1);
	}
	else 
	{
		message_vision(YEL"黄钟公摇头笑道：我梅庄四友隐居于此，不问世事。” \n" NOR,me);
		message_vision(YEL"黄钟公说道：这位"+RANK_D->query_respect(me)+"与我梅庄机缘未到。\n", me);	
	}
	
	return 1;
}