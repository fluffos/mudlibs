// tubi-weng.c
inherit NPC;
inherit F_MASTER;

void create()
{
	int jibie;
	jibie = 2000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name("秃笔翁", ({ "tubi weng", "weng" }));
        set("title", "梅庄三庄主");
        set("long",
                "他就是梅庄四位庄主排行第三的秃笔翁。\n"
                "身穿一件干干净净的白色长袍。\n"
                "他已年愈五旬，身材矮小，顶上光光, 一看就知道是个极易动怒的人。\n");
        set("gender", "男性");
        set("age", 52);
        set("class", "scholar");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 28);
        set("int", 28);
        set("con", 28);
        set("dex", 28);

        set("max_qi", 2000);
        set("max_jing", 2000);
        set("neili", 2000);
        set("max_neili", 2000);
        set("wuyongjiali", 80);
        set("combat_exp", 1000000);
        set("shen", 15000);
        set("score", 60000);

        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("wuzheng-xinfa", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("yaoming-dodge", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("club", 500+jibie/3+random(jibie/5));
        set_skill("shigu-bifa", 500+jibie/3+random(jibie/5));
        set_skill("literate", 500+jibie/3+random(jibie/5));
		set_skill("unarmed", 500+jibie/3+random(jibie/5));
		set_skill("wuying-shenquan", 500+jibie/3+random(jibie/5));
		map_skill("unarmed", "wuying-shenquan");
        map_skill("force", "wuzheng-xinfa");
        map_skill("dodge", "yaoming-dodge");
        map_skill("parry", "shigu-bifa");
        map_skill("club", "shigu-bifa");

        create_family("梅庄", 3, "三庄主");

        setup();
        carry_object("/d/meizhuang/npc/obj/qingyi")->wear();
        carry_object(__DIR__"obj/panguan-bi")->wield();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("wuzheng-xinfa",1) < 300) {
                command("say 在我梅庄的内功上，" + RANK_D->query_respect(ob) +
                        "是否还应该多下点功夫？");
                return;
        }
        command("say 好吧，在下就收下你了。");
        command("recruit " + ob->query("id"));
		return;
}

int accept_object(object me, object ob)
{

	if ( (string)ob->query("id") =="shuai yi tie" )
	{
            if ( (string)me->query("family/family_name") == "梅庄" && me->query("id")==ob->query("owner"))
			{
				message_vision("$N对$n说道：这居然是草圣张旭的真迹！！！\n", this_object(),me);
                message_vision("$N对$n大笑道：不错不错，这位"+RANK_D->query_respect(me)+"解我一段心结......\n", this_object(),me);
				message_vision("$N对$n说道：若你能完成我们四兄弟的心愿，或许可以解开我梅庄的一段恩怨！！！\n", this_object(),me);
				me->set_temp("jm_meizhuang3",1);
                return 1;
            } else
			{
                message_vision("$N对$n说道：多谢这位"+RANK_D->query_respect(me)+"，这本字帖我就笑纳了。\n",this_object(),me);
                return 1;
			}
	}
	return 0;
}