// danqing-sheng.c 
inherit NPC;
inherit F_MASTER;

string ask_me();

void create() {
  int jibie;
  jibie = 1000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("丹青生", ({ "danqing sheng", "sheng" }));
  set("title", "梅庄四庄主");
  set("long",
    "他就是梅庄四位庄主排行第四的丹青生。\n"
    "身穿一件干干净净的青色长袍。\n"
    "他已年愈四旬，身材瘦长，满脸红光。恬淡冲和，沉默寡言。\n");
  set("gender", "男性");
  set("age", 40);
  set("class", "scholar");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 28);
  set("int", 28);
  set("con", 28);
  set("dex", 28);

  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 2000);
  set("max_neili", 2000);
  set("wuyongjiali", 50);
  set("combat_exp", 300000);
  set("shen", 15000);
  set("score", 60000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuzheng-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yaoming-dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuyun-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuying-shenquan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("mantian-xing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("throwing", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "wuzheng-xinfa");
  map_skill("dodge", "yaoming-dodge");
  map_skill("parry", "wuyun-jianfa");
  map_skill("sword", "wuyun-jianfa");
  map_skill("unarmed", "wuying-shenquan");
  map_skill("throwing", "mantian-xing");

  create_family("梅庄", 4, "四庄主");

  set("inquiry", ([
    "令牌": (: ask_me :),
  ]));

  set("item_count", 1);

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/meizhuang/npc/obj/qingyi")->wear();

}

void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < 0) {
    command("say 我梅庄虽然不是什么名门正派, 但择徒也极为严格。");
    command("say 在品行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if ((int)ob->query_skill("wuzheng-xinfa", 1) < 300) {
    command("say 在我梅庄的内功上，" + RANK_D->query_respect(ob) +
      "是否还应该多下点功夫？");
    return;
  }
  command("say 好吧，在下就收下你了。");
  command("recruit " + ob->query("id"));
  return;
}

string ask_me() {
  mapping fam;
  object ob;

  if (!(fam = this_player()->query("family")) || fam["family_name"] != "梅庄")
    return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？";
  if (query("item_count") < 1)
    return "你来晚了，梅花令牌不在此处。";
  add("item_count", -1);
  ob = new(__DIR__ "obj/lingpai");
  ob->move(this_player());
  return "好吧，这块梅花令牌就交给你保管了。";
}

int accept_object(object me, object ob) {

  if ((string)ob->query("id") == "xi shan xing lv tu") {
    if ((string)me->query("family/family_name") == "梅庄" && me->query("id") == ob->query("owner")) {
      message_vision("$N对$n说道：这居然是范宽的真迹！！！\n", this_object(), me);
      message_vision(
        "$N对$n大笑道：不错不错，这位" + RANK_D->query_respect(me) + "解我一段心结......\n",
        this_object(),
        me
      );
      message_vision("$N对$n说道：若你能完成我们四兄弟的心愿，或许可以解开我梅庄的一段恩怨！！！\n", this_object(), me);
      me->set_temp("jm_meizhuang4", 1);
      return 1;
    } else {
      message_vision(
        "$N对$n说道：多谢这位" + RANK_D->query_respect(me) + "，这本山水画我就笑纳了。\n",
        this_object(),
        me
      );
      return 1;
    }
  }
  return 0;
}
