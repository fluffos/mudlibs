// linghu.c 令狐冲

inherit NPC;

void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("令狐冲", ({ "ling huchong", "ling", "huchong" }));
  set("nickname", "大师兄");
  set("long", "令弧冲身材较瘦，长的浓眉阔眼，气宇暄昂，他在同门中排行老大，\n"
    "是华山派年轻一代中的顶尖好手。\n");
  set("gender", "男性");
  set("age", 28);
  set("attitude", "peaceful");

  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("qi", 2800000);
  set("max_qi", 2800000);
  set("jing", 1600000);
  set("max_jing", 1600000);
  set("neili", 24000000);
  set("max_neili", 7000000);
  set("wuyongjiali", 16000);
  set("combat_exp", 40000000);


  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zixia-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huashan-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dugu-jiujian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huashan-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huashan-zhangfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "zixia-shengong");
  map_skill("dodge", "huashan-shenfa");
  map_skill("parry", "dugu-jiujian");
  map_skill("sword", "dugu-jiujian");
  map_skill("unarmed", "huashan-zhangfa");

  create_family("华山派", 13, "弟子");
  set("chat_chance", 10);
  set("chat_msg", ({
    "令狐冲低声道: 向大哥怎么还未到呢......\n",
    "令狐冲叹道：盈盈托我来这里救出她父亲。\n",
  }));
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}

int recognize_apprentice(object me) {
  command("say 我与向大哥有正事在忙，不要来打扰我。");
  return 1;
}

void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "梅庄" && me->query_temp("jm_meizhuang5")) {
    tell_room(environment(this_player()), "令狐冲说道：向大哥说好与我一起来这里救出盈盈的父亲！！！\n");
    tell_room(environment(this_player()), "令狐冲说道：这百木园松林阵阵，不知道向大哥进来了没有！！！\n");
    tell_room(environment(this_player()), "令狐冲惨嚎一声，倒在地上，两腿一蹬，死了.....．\n");
    me->set_temp("jm_meizhuang7", 1);
  }
  ::die();
}
