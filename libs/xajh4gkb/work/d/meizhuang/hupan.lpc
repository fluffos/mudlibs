// hupan.c
#include <room.h>
inherit ROOM;

string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});

void create() {
  set("short", "西湖湖畔");
  set("long", @LONG
顺着西湖一直走过去，你欣赏着湖边的杨柳，不知不觉地已经走
到西湖与南湖的交界，这里有一条蜿蜒的小路向前延伸着，隐隐
约约可以看到一座庄园，你不禁想走过去看看那里是什么地方。
昔日梅庄创建者在此弹奏瑶琴，微风、垂柳、琴音，交相呼应，
自此顿悟出七弦无形剑气，或许你在此可以弹奏(tanzou)一番，
能领悟到什么。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": "/d/quanzhou/nanhu1",
    "north": __DIR__ "xiaolu.lpc",
  ]));
  //        set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_tanzou", "tanzou");
}

int do_tanzou(string arg) {
  object me = this_player();

  string *poem = ({
    "双手轻轻舞弄，叮叮咚咚，你发现这曲子颇有奥妙之处",
    "忽然眼中精光四射，一招「星河气旋」，一股淳厚无比的剑气从琴弦上激射而出",
    "双目微闭，单手在琴弦上轻轻拨动，顿时只听“啵啵啵”破空之声连续不断，数股破体无形剑气激射而出",
    "一声暴喝，陡然间十指一并箕张，顿时琴音铮铮大响，连绵不断的无形剑气澎湃射出",
    "一声冷哼，以内劲催动，激荡出无形琴音，铮然大响，只听“啵”的一声破空之响，一束无形剑气如奔雷之势而出",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫练剑......\n");
  if (!me->query_temp("jm_meizhuang8"))
    return notify_fail("梅庄目前大难临头，你还有心思在这里弹琴？\n");
  if (me->query("jm/meizhuang"))
    return notify_fail("你已经完全领悟了七弦无形剑的精髓，不需要在这领悟了。\n");
  if (!present(
    "jiaowei qin",
    this_player()
  ) && !present(
    "yanyu qin",
    this_player()
  ) && !present(
    "yao qin",
    this_player()
  ) && !present("fenghuang qin", this_player()) && !present("fuxi qin", this_player()))
    return notify_fail("你必须手持琴，才能弹奏！\n");
  if (me->query("family/family_name") != "梅庄")
    return notify_fail("不是梅庄的弟子，恐怕是对牛弹琴。\n");

  if (me->query_skill("wuzheng-xinfa", 1) < 1000) {
    tell_object(me, "你的内功似乎差了点.......\n");
    return 1;
  }
  if (me->query_skill("wuyun-jianfa", 1) < 2000) {
    tell_object(me, "你对音律五蕴了解的不够.......\n");
    return 1;
  }
  if (me->query_skill("qixian-wuxingjian", 1) < 2000) {
    tell_object(me, "你对七弦琴剑了解的不够.......\n");
    return 1;
  }
  if (me->query("jingli") < 1000) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }

  tell_object(me, HIW "你站在西湖湖畔，凉风拂面，绿树成荫，心旷神怡，情不自禁的摆出瑶琴弹奏起来......\n" NOR);
  message_vision("你" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -500);
  me->start_busy(2);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/meizhuang", 1);
    me->add("family_score", 1);
    tell_object(me, HIB "你突然醒悟道：" HIY "原来七弦无形剑可以有此等威力" HIR "！\n" NOR);
    tell_object(me, HIB "恭喜你融汇贯通了梅庄武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在西湖湖畔居然领悟了梅庄的七弦无形剑气！\n" NOR,
      users()
    );
  }
  return 1;
}
