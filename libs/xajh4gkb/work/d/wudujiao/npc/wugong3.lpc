// by victori
inherit NPC;
#include "duchong.h"
#include <ansi.h>

void create() {
  int jibie = 2000;
  set_name("阴山天蜈", ({ "wu gong" }));
  set("race", "野兽");
  set("long", "一条三寸多长，长有一双翅膀的剧毒蜈蚣。\n");
  set("age", 10000);
  set("attitude", "peaceful");
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set("max_jing", 2500);
  set("max_qi", 2500);
  set("neili", 2000);
  set("max_neili", 4000);
  set("neili", 2000);
  set("wuyongjiali", 200);

  set_skill("force", 500 + jibie * 2 + random(jibie / 5));
  set_skill("dodge", 500 + jibie * 2 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie * 2 + random(jibie / 5));
  set_skill("parry", 500 + jibie * 2 + random(jibie / 5));
  set_skill("biyun-xinfa", 500 + jibie / 2 + random(jibie / 5));
  set_skill("qiulinshiye", 500 + jibie / 2 + random(jibie / 5));
  set_skill("biye-wu", 500 + jibie / 2 + random(jibie / 5));
  map_skill("force", "biyun-xinfa");
  map_skill("dodge", "qiulinshiye");
  map_skill("parry", "biye-wu");
  map_skill("unarmed", "biye-wu");

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));

  set_temp("apply/attack", 300);
  set_temp("apply/defense", 200);
  set_temp("apply/armor", 300);
  add_temp("apply/damage", 200);

  set("combat_exp", 5000000 + random(100) * 100000);

  set_weight(5000);

  setup();
}
