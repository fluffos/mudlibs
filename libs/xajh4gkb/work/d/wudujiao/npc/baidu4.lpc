// by victori
inherit NPC;
#include <ansi.h>

string *first_name = ({ "五毒", "长螯", "双头", "花斑" });
string *name_words = ({ "蝎子" });
void create() {
  int jibie = 100;
  string name;
  name = first_name[random(sizeof(first_name))];
  name += name_words[random(sizeof(name_words))];
  set_name(name, ({ "xie zi" }));
  set("race", "野兽");
  set("long", "一条半尺来长，鬼头鬼脑的小蝎子。\n");
  set("age", 100);
  set("attitude", "peaceful");

  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set("max_jing", 200);
  set("max_qi", 800);

  set_skill("force", 500 + jibie * 2 + random(jibie / 5));
  set_skill("dodge", 500 + jibie * 2 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie * 2 + random(jibie / 5));
  set_skill("parry", 500 + jibie * 2 + random(jibie / 5));
  set_skill("huagong-dafa", 500 + jibie / 2 + random(jibie / 5));
  set_skill("chousui-zhang", 500 + jibie / 2 + random(jibie / 5));
  set_skill("zhaixinggong", 500 + jibie / 2 + random(jibie / 5));
  map_skill("force", "huagong-dafa");
  map_skill("dodge", "zhaixinggong");
  map_skill("parry", "chousui-zhang");
  map_skill("unarmed", "chousui-zhang");

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));

  set_temp("apply/attack", 150);
  set_temp("apply/defense", 150);
  set_temp("apply/armor", 50);

  set("combat_exp", 100000 + random(40) * 10000);

  set_weight(500000);
  setup();
}
void init() {
  object me, ob;
  add_action("do_xun", "xun");
  //       object me,ob;
  //        ::init();
  if (interactive(me = this_player())) {
    if (!(ob = present("xionghuang", this_player()))) {
      remove_call_out("kill_ob");
      call_out("kill_ob", 1, me);
    }
  }
  ::init();
}
int do_xun(string arg) {
  object me, who;
  int who_exp, me_exp;
  me = this_object();
  who = this_player();
  if (!arg || (arg != "xie zi"))
    return notify_fail("你要驯服什么？\n");
  if (me->is_fighting())
    return notify_fail("这只蝎子正在战斗。\n");
  if ((string)who->query("family/family_name") != "五毒教")
    return notify_fail("什么？\n");
  who_exp = who->query("xyzx_sys/level", 1);
  me_exp = me->query("xyzx_sys/level", 1);
  if (who_exp < (me_exp * me_exp + 100) / (me_exp + 5000))
    return notify_fail(me->name() + "斜眼瞟了你一眼，就你这种实力还想驯服我？\n");

  message_vision("$N对$n一阵怪啸：大胆，还不驯服更待何时？\n\n", who, me);
  message_vision("$N勃然大怒道：咱们谁驯谁还不一定哪。\n冲上来和$n扭打到一起。\n", me, who);
  me->kill_ob(who);
  who->kill_ob(me);
  COMBAT_D->do_attack(me, who, query_temp("weapon"));
  me->set("owner", who->query("id"));
  return 1;
}

void die() {
  string owner, name;
  object owner_ob;
  object ob;
  owner = query("owner");
  if (owner) owner_ob = find_player(owner);
  if (owner_ob && (object)query_temp("last_damage_from") == owner_ob) {
    message_vision("$N趴在地上，一动也不敢动了。\n", this_object());
    ob = new(__DIR__ "xiezi1.lpc");
    ob->move(environment(owner_ob));
    ob->set_leader(owner_ob);
    ob->set("host_id", owner_ob->query("id"));
    name = this_object()->query("name");
    ob->set_name(name, ({ "xie zi" }));
    destruct(this_object());

    return;
  } else {
    message_vision("$N倒在地上，死了！\n", this_object());
    ob = new(__DIR__ "obj/xiezidu.lpc");
    ob->move(environment(this_object()));
    destruct(this_object());
  }
  //     return 1;
  //	::die();
}

int hit_ob(object me, object ob, int damage) {
  if ((string)ob->query("family/family_name") != "五毒教") {
    ob->apply_condition("xiezi_poison", 20
      +(int)ob->query_condition("xiezi_poison"));
    tell_object(ob, HIG "你觉得被咬中的地方一阵麻木！\n" NOR);
  }
}
