// by victori
inherit NPC;
#include "duchong.h"
#include <ansi.h>


void create()
{
	int jibie = 1000;
	set_name("吸血蜘蛛",({"zhi zhu"}));
	set("race", "野兽");
	set("long", "一只拳头大小，全身绿毛的毒蜘蛛。\n");
	set("age", 100);
	set("attitude", "peaceful");
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set("max_jing", 1500);
	set("max_qi", 1500);
	set("wuyongjiali",50);
	set("max_neili",1500);	
	set("neili",1500);

    set_skill("force", 500+jibie*2+random(jibie/5));
    set_skill("dodge", 500+jibie*2+random(jibie/5));
    set_skill("unarmed", 500+jibie*2+random(jibie/5));
    set_skill("parry", 500+jibie*2+random(jibie/5));
    set_skill("wudu-shengong",500+jibie/2+random(jibie/5));
    set_skill("wudu-yanluobu", 500+jibie/2+random(jibie/5));
    set_skill("qianzhu-wandushou", 500+jibie/2+random(jibie/5));
    map_skill("force", "wudu-shengong");
    map_skill("dodge", "wudu-yanluobu");
    map_skill("parry", "qianzhu-wandushou");
    map_skill("unarmed", "qianzhu-wandushou");

	set("limbs", ({ "头部", "身体", "长腿" }) );
	set("verbs", ({ "bite" }) );

	set_temp("apply/attack", 150);
	set_temp("apply/defense", 150);
	set_temp("apply/armor", 150);
	set_temp("apply/damage", 100);

	set("combat_exp", 1000000+random(40)*100000);
 
	set_weight(5000);
	setup();
}
