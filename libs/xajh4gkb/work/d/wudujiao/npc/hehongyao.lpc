// 何红药

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_xiaxueyi();
void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("何红药", ({ "he hongyao", "he" }));
	set("nickname", HIG "疤面丐婆" NOR);
	set("long",@LONG
他就是五毒教的长老，教主的姑姑何红药。随然是教主的长辈，但功夫却是一块跟
上代教主学的。据说她曾经被立为教主继承人，但后来犯下大错，所以被罚到此处
看守圣地，以赎前罪。她穿着一身破旧的衣衫，满脸疤痕，长得骨瘦如柴，双目中
满是怨毒之色。
LONG
        );
	set("title","五毒教长老");
	set("gender", "女性");
	set("age", 45);
	set("shen_type", -1);
	set("str", 30);
	set("int", 40);
	set("con", 30);
	set("dex", 30);
	set("max_qi", 7000);
	set("max_jing", 4000);
	set("neili", 4000);
	set("max_neili", 4000);
	set("wuyongjiali", 100);
	set("combat_exp", 15000000);
	set("score", 500000);
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("wudu-shengong", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("wudu-yanluobu", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("qianzhu-wandushou", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("wudu-goufa", 500+jibie/3+random(jibie/5));
	set_skill("duji", 500+jibie/3+random(jibie/5));
	set_skill("literate", 500+jibie/3+random(jibie/5));
	map_skill("force", "wudu-shengong");
	map_skill("dodge", "wudu-yanluobu");
	map_skill("unarmed", "qianzhu-wandushou");
	map_skill("parry", "wudu-goufa");
	map_skill("sword", "wudu-goufa");
	create_family("五毒教", 10, "长老");
	set("inquiry", ([
                "夏雪宜": (: ask_xiaxueyi :),
         ]) );
	setup();
	carry_object(__DIR__"obj/jiandao")->wield();
	carry_object("/clone/cloth/cloth")->wear();
	carry_object(__DIR__"obj/wuxing");
	add_money("gold",10);
}

void attempt_apprentice(object ob)
{
	if ((string)ob->query("gender") == "无性") 
	{
		command("say 这位公公不要开玩笑了。");
		command("say 这位" + RANK_D->query_respect(ob) + "还是快去伺候皇上吧！");
		return;
	}

	if ((int)ob->query("shen") > -500000) 
	{
		command("say 做我五毒教弟子必须心狠手辣。");
		command("say 这位" + RANK_D->query_respect(ob) + "心慈手软，可惜与我教没有缘分啊！");
		return;
	}
	
	if ((string)ob->query("family/family_name") != "五毒教")
	{
		command("say 这位" + RANK_D->query_respect(ob) +"不是本教弟子，还是请回吧！");
		return;
	}
	if ((int)ob->query_skill("duji", 1) < 500) 
	{
		command("say 我五毒教弟子以毒杀人，修习毒技是首要的。");
		command("say 这位" + RANK_D->query_respect(ob) + "是否还应该多多钻研本门的绝学？");
		return;
	}
	if ((int)ob->query_skill("wudu-shengong", 1) < 500) 
	{
		command("say 你的五毒神功还学的不够啊。");
		return;
	}
	if ((int)ob->query("con",1)<30)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"体质太差了，还是去江湖上历练吧。");
        command("say 以你的根骨难以运转五毒教的心法。");
		return ;
    }
	command("say 嘿嘿嘿嘿！！！！！");
	command("say 该当我五毒教发扬光大，称霸武林指日可待了。");
	command("recruit " + ob->query("id"));
	ob->set("class", "none");
	ob->set("title",HIY"五毒教护法"NOR);
	return;
}

//五毒教解密
int ask_xiaxueyi()
{
	object me;
	me = this_player();
	
	if ((string)me->query("family/family_name") == "五毒教")
	{
		message_vision(HIG"何红药说道：这个负心汉！当年他欲盗取本教毒物，差点中毒身亡。\n" NOR,me);
		message_vision(HIG"何红药说道：怎奈这负心人以甜言蜜语欺骗我，竟然始乱终弃！\n" NOR,me);
		message_vision(HIG"何红药说道：我为他盗取本教三宝，没想到他只是在利用我！害我受这万蛇噬咬之苦！\n" NOR,me);
		message_vision(HIG"何红药说道：凡我教弟子，必当要其求生不能，求死不得！\n" NOR,me);
		me->set_temp("jm_wudu1",1);
		return 1;
	}
	else 
	{		
		message_vision(YEL"何红药大怒道：这负心人，必将其千刀万剐！\n" NOR,me);	
		return 1;
	}
	
	return 1;
}
int accept_object(object me, object ob)
{
	if ( (string)ob->query("id") =="xiaxueyi rentou" )
	{
		if ( (string)me->query("family/family_name") == "五毒教" && me->query("id")==ob->query("owner") && (int)me->query_temp("jm_wudu1"))
		{
			message_vision(HIC"何红药一会笑一会哭道：这负心人不得好死！\n"NOR, me);
			message_vision(HIC"何红药说道：我必杀尽天下负心人！！！\n"NOR, me);
			message_vision(HIC"何红药自此之后心性大变，五毒教的事看来只能去找教主了。\n"NOR, me);
			me->set_temp("jm_wudu2",1);
			return 1;
		} else
		{
			message_vision(HIC"何红药怀疑的看了看你道：这负心汉是你杀的吗？\n"NOR,me);
			return 1;
		}
	}

	return 0;
}