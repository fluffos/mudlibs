#include <room.h>
#include <ansi.h>

inherit ROOM;


void create() {
  set("short", "五级副本");
  set("long", @LONG
    这里就是冥府的入口处，再往前就是地狱了，但觉到处阴森恐怖,
令人脊背阵阵发麻，汗毛直竖。
LONG);
  set("no_fight", "1");
  set("no_steal", "1");
  set("no_sleep_room", "1");
  set("exits", ([
    "east": "/d/automap5/fuben" + (1 + random(300)),
  ]));
  //	set("no_clean_up", 0);
  setup();
}
int valid_leave(object me, string dir) {
  object *inv;
  //	object *usr;
  //	string str;		
  int sizeinv;
  //	int i,ip_cnt;	

  if (dir == "east") {
    if (me->query("xyzx_sys/level") < 3000)
      return notify_fail(HIC "就平你这点微末功夫不是去送死吗！\n" NOR);
    if (me->query("xyzx_sys/level") > 40000)
      return notify_fail(HIC "你都已经名动江湖了，再来这里不合适吧！\n" NOR);
    if (present("buzhen xiang", me))
      return notify_fail("你带着布阵箱进地狱冥府想做什么？\n");
    if (present("zhu lou", me))
      return notify_fail("你带着竹篓进地狱冥府想做什么？\n");
    //2018.6.12阿飞增加IP管制，暂时放开IP管制，排查服务器卡的原因
    /*		usr = get_all_user();
		str=query_ip_number(me);
		ip_cnt=0;
		for(i=0; i<sizeof(usr); i++)
		{
			if (str==query_ip_number(usr[i]) && usr[i]->query_temp("fuben_five")) ip_cnt++;
		}
		if ( ip_cnt >= 3 )
			return notify_fail("这个IP进入副本的玩家太多了，给其他人留条活路吧！\n");
*/
    inv = all_inventory(me);
    sizeinv = sizeof(inv);
    while (sizeinv--) {
      if (inv[sizeinv]->is_character())
        return notify_fail(HIG "你想给里面的怪物送点心去？\n" NOR);
    }
    me->set_temp("fuben_five", 1);
  }

  return ::valid_leave(me, dir);
}
