//by diabio
inherit ITEM;
#include <ansi.h>
void create()
{
	set_name("飞天御剑流宝典", ({ "bao dian", "book" }));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("no_drop", "武功秘籍可不能随便丢弃！\n");
        set("no_give", "这样东西不能随便给人。\n");
		set("unit", "本");
		set("long", "飞天御剑流的不传之书，你可以试着翻阅（fanyue）。\n");
		set("value", 0);
		set("material", "paper");
		}
}


void init()
{
	add_action("do_study","fanyue");
	add_action("do_study","fanyue");
}

int do_study(string arg)
{
	object me,ob,where;
	me = this_player();
	where = environment(me);
	ob = this_object();
	
	if (!arg="bao dian" || !arg="book")
	{
        tell_object(me,"你要读什么？\n");       
        return 1;
	}
	if( where->query("no_fight") )
	{
        tell_object(me,"大庭广众之下翻阅飞天御剑流宝典，不怕被人打劫吗？\n");       
        return 1;
	}		
	if (where->query("pigging"))
	{
        tell_object(me,"还是专心拱猪吧......\n");       
        return 1;
	}
	if (!id(arg) || !objectp(ob = present(arg, me)))
	{
        tell_object(me,"你要翻看什么！\n"); 
        return 1;			
	}
	if(me->is_busy() )
	{
        tell_object(me,"你现在正忙着呢，还是休息一会吧......\n");       
        return 1;
	}	
	message_vision("$N边看边用手指蘸点唾沫，一页一页地翻看着飞天御剑流宝典,嘴巴还忍不住的吧唧吧唧的砸了几下\n",me);
	me->add("jingli",-1000);
	me->add("neili",-1000);	
	me->apply_condition("yapian_poison",(int)me->query_condition("yapian_poison")+10);
	me->start_busy(1);
	if (!me->query_temp("yapian"))
	{
		me->set_temp("yapian",1);
		remove_call_out("yapian_poison");
		call_out("yapian_poison", 40);		
	}	
	
	if ( me->query("id")!=ob->query("owner"))
	{
        tell_object(me,"这本武林秘籍是你的吗？\n"); 
        return 1;			
	}		
	if( me->is_fighting() )
	{
        tell_object(me,"战斗中如何能翻阅飞天御剑流宝典！\n"); 
        return 1;			
	}
	if( (int)me->query_skill("literate", 1)<5000 )
	{
        tell_object(me,"日文......就你这点文学水平，你认识吗？\n"); 
        return 1;			
	}
	if( (int)me->query_skill("shayi-xinfa", 1)<1000 )
	{
        tell_object(me,"你杀意心法不足，小心走火入魔！\n"); 
        return 1;			
	}
	if( (int)me->query_skill("feitian-yujianliu", 1)<2000 )
	{
        tell_object(me,"你的飞天御剑流修为不足，根本没法领悟这等武学至理。\n"); 
        return 1;			
	}		
	if( (int)me->query_skill("ittouryu", 1)<2000 )
	{
        tell_object(me,"你的一刀流修为不足，根本没法领悟这等武学至理。\n"); 
        return 1;			
	}	
	if( (int)me->query_skill("xuanhualiu-quanfa", 1)<2000 )
	{
        tell_object(me,"你的喧哗流拳法修为不足，根本没法领悟这等武学至理。\n"); 
        return 1;			
	}	
	if( (int)me->query_skill("wuxing-dun", 1)<2000 )
	{
        tell_object(me,"你的五行遁修为不足，根本没法领悟这等武学至理。\n"); 
        return 1;			
	}	
	if( !me->query("feitian/tianxiang") )
	{
        tell_object(me,"你还未领悟天翔龙闪。\n"); 
        return 1;			
	}	
	if( !me->query("feitian/jiu") )
	{
        tell_object(me,"你还未领悟九头龙闪。\n"); 
        return 1;			
	}	
	if( !me->query("feitian/chaodao") )
	{
        tell_object(me,"你还未领悟抄刀。\n"); 
        return 1;			
	}	
	if( !me->query("feitian/sanchong") )
	{
        tell_object(me,"你还未领悟三重劲。\n"); 
        return 1;			
	}	
	if( (int)me->query("neili") < 1000 || (int)me->query("jingli") < 1000) 
	{
		write( CYN"忽然，你觉得内息一乱，知道不好！顿时内力不受控制，全身经脉紊乱，眼前一黑！！！\n"NOR);
		me->unconcious();
		return 1;
	}	
    if(me->query("jm/feitian")) 
	{
        tell_object(me,"你已经完全领悟了飞天御剑流的精髓，不需要在研究这本宝典了。\n");       
        return 1;
	}	
	
    if( random(100000) < me->query("kar",1) )
	{
        me->set("jm/feitian",1);
		me->add("family_score",1);
        tell_object(me,HIG"你突然醒悟道："HIY"原来飞天御剑流可以有此等威力"HIR"！\n"NOR);
		tell_object(me,HIG"恭喜你融汇贯通了飞天御剑流武功的精髓！\n"NOR);
		message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，研读飞天御剑流宝典居然领悟了飞天门的终极奥义！\n"NOR,users() );
	}
	return 1;
}

int yapian_poison()
{
	message("chat", HIY"【道场】"HIC"神古活心流道场突然传来一阵喧闹声：“不好了，御剑流宝典不见了!\n"NOR,users());
	call_out("mi_tan",10);
	return 1;
}

int mi_tan()
{
	message("chat", HIY"【飞天御剑流】"HIC"比古清十郎正在叫弟子绯村剑心去调查事情经过。\n"NOR,users());
	call_out("zi_bai",10);
	return 1;
}

int zi_bai()
{
	message("chat", HIY"【药铺】"HIC"高和惠急道:“那怎么得了，那可是我以前被人逼迫做鸦片时用来垫锅底的，上面有"HIR"鸦片毒。\n"
	+HIC"左之助骂道：你是怎么搞的，不是叫你放好的吗？现在那位只怕.....\n"NOR,users());
	call_out("zi_bai2",10);
	return 1;
}

int zi_bai2()
{
	message("chat", HIY"【飞天御剑流】"HIC"某人深深叹了口气，真可怜啊！\n"NOR,users());
	call_out("zi_bai3",10);
	return 1;
}
int zi_bai3()
{
	message("chat", HIY"【梁上君子】"HIB+ this_player()->query("name") +HIC"“啊”地大叫一声，真是.T.M.D.说完口吐白白沫，昏了过去。\n"NOR,users());
	this_player()->delete_temp("yapian",1);
	return 1;
}
