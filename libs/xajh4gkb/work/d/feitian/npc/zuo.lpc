#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  int jibie;
  jibie = 1000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("相乐左之助", ({ "zuo zhizu", "xiangle" }));
  set("nickname", HIW "斩左" NOR);
  set("gender", "男性");
  set("long",
    " 这就是人称斩左的左之助了，在他衣服后面印了一个大大的恶字。\n");
  set("age", 23);
  set("dex", 43);
  set("str", 45);
  set("per", 43);
  set("combat_exp", 3200000);
  /*	set("max_neili",24000);
	set("neili",24000);
	set("max_qi",14000);
	set("eff_qi",14000);
	set("qi",14000);
	set("max_jingli",14000);
	set("jingli",14000);
	set("eff_jing",14000);
	set("jing",4000);*/

  set_skill("shayi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuxing-dun", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xuanhualiu-quanfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shayi-xinfa", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "shayi-xinfa");
  map_skill("unarmed", "xuanhualiu-quanfa");
  map_skill("parry", "xuanhualiu-quanfa");
  map_skill("dodge", "wuxing-dun");

  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/cloth/cloth")->wear();
}
