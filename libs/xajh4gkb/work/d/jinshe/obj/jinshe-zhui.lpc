//金蛇锥-名器

#include <weapon.h>
#include <ansi.h>
inherit THROWING;

void create() {
  set_name(YEL "金蛇锥" NOR, ({ "jinshe zhui", "zhui" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "金蛇锥是黄金所铸，灿烂生光。长约二寸八分，打成昂首吐舌的蛇形，蛇舌尖端分成双叉，每一叉都是一个倒刺。\n");
    set("unit", "把");
    set("value", 1000);
    set("base_unit", "枚");
    set("base_weight", 30);
    set("base_value", 10);
    set("weapon_prop/strength", 15);
    set("weapon_prop/throwing", 30);
    set("weapon_prop/dexerity", 10);
    set("weapon_prop/dodge", 10);
    set("weapon_prop/parry", 10);
    set("no_get", 1);
    set("no_give", 1);
    set("no_put", 1);
    set("no_drop", 1);
    //		set("throwing_num_max",1);	//2018.10.8阿飞改，暗器中的名器与神器设置为无限数量
  }
  set_amount(500);
  init_throwing(500, 2);
  setup();
}
int query_autoload() { return 1; }
