// by HAPP@YSZZ

inherit ROOM;

void create() {
  set("short", "黄金圣殿");
  set("long",
    @LONG
     p                  p         p
    /\     p      p    /\        /\
   /__\   /\_____/\   /__\      /__\
   |. |_=_|. . . .|_=_=_=_=_=_=_|. |
   |. |. .|  ___  |. . . . . . .|. |    雅典娜与此执法。
   |. |   | |   | |             |. |
 __|__|___|_|___|_|_____________|__|__
/          /   /                      \


LONG);

  set("exits", ([
    "down": __DIR__ "topalace3",
  ]));

  set("objects",
    ([  //sizeof() == 1
    //			__DIR__"npc/yadianna" : 1,    	
    ]));
  set("outdoors", "12gong");
  setup();
}

void init() {
  object me = this_player();
  if (userp(me) && !me->query_temp("day_12gong/tiaozhan")) {
    message_vision(HIY "虚空中传来一道空灵的声音：下界凡人，未得奥林神山召唤，不得进入黄金十二宫！\n" NOR, me);
    me->move("/d/city3/guangchang");
  }
}
