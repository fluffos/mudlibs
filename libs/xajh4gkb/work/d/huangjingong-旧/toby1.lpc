// by HAPP@YSZZ

inherit ROOM;

void create ()
{
        set ("short", "山路");
        set ("long", @LONG

这是走向白羊宫的路上，只见前面可以看到美丽的白羊宫耸立在奥林
匹亚峰上！
LONG);


        set("exits", ([
			"southup"    :       __DIR__"toby2",
        ]));

        set("objects", 
        ([ //sizeof() == 1
//                   __DIR__"npc/cike" : 1,	
        ]));
		set("outdoors", "12gong");
        setup();
}

void init()
{
    object me=this_player();
	if(userp(me) && !me->query_temp("day_12gong/tiaozhan") )
	{
		message_vision(HIY"虚空中传来一道空灵的声音：下界凡人，未得奥林神山召唤，不得进入黄金十二宫！\n"NOR,me);
		me->move("/d/city3/guangchang");
	}
}