inherit NPC;
 
void create()
{
	int jibie;
	jibie = 12000;
	set_name("阿布罗狄", ({"shuang yu","Aphrodite"}));
	set("long", "守护双鱼宫黄金圣斗士。号称“与天地争辉”的唯美圣斗士，他与巨蟹座一样，明明清楚知道教皇的所作所为，而甘愿臣服。亦是杀死瞬的师傅仙王座·亚路比奥尼的真凶。在冥界里的最后生命中罕见地向阿瞬道别。在冥界为了击穿叹息之墙而逝去，为雅典娜献身。\n");
	set("gender","男性");
	set("title", "【"+HIY"黄金圣斗士"+NOR"】");
	set("age",37);
	set("attitude", "peaceful");
	set("con",30);
	set("per",30);
	set("str",25);
	set("int",35);
	set("combat_exp",120000000);
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
	set("chat_chance",20);
	set("chat_msg", ({
			"阿布罗狄说道：不知何时能再见到雅典娜！\n"   
        }));
	set("jm/yihua",1);
	set("jm/dugu",1);
	set_skill("literate", 500+jibie*2+(jibie/2));
	set_skill("dodge", 500+jibie*2+(jibie/2));
	set_skill("force", 500+jibie*2+(jibie/2));
	set_skill("parry", 500+jibie*2+(jibie/2));
	set_skill("unarmed", 500+jibie*2+(jibie/2));
	set_skill("sword", 500+jibie*2+(jibie/2));
    set_skill("mingyu-shengong", 500+jibie/2+(jibie/2));
    set_skill("dugu-jiujian",500+jibie/2+(jibie/2));
    set_skill("lonely-sword",500+jibie/2+(jibie/2));
	set_skill("jueqing-zhang",500+jibie/2+(jibie/2));
    set_skill("yihua-jiemu",500+jibie/2+(jibie/2));
	set_skill("yifeng-jian",500+jibie/2+(jibie/2));
    map_skill("force", "linji-zhuang");
    map_skill("dodge", "yihua-jiemu");
    map_skill("unarmed", "jueqing-zhang");
    map_skill("parry", "lonely-sword");
    map_skill("sword", "dugu-jiujian");
	setup();
	carry_object("/d/huangjingong/obj/sy_cloth")->wear();
	carry_object("/d/huangjingong/obj/westsword")->wield();
}

void die()
{
    object me,monk,room;        
    me = query_temp("last_damage_from");
	if (me && me->query_temp("day_12gong/tiaozhan"))
	{
		tell_room(environment(this_player()), "好大的胆子,竟敢来刺杀【女神】雅典娜！！！\n");
		tell_room(environment(this_player()), "恨啊.....．\n");
		me->set_temp("day_12gong/winer",1);
		me->set_temp("day_12gong/winer12",1);
		message("chat",HIY+"【黄金十二宫】"HIY"阿布罗狄:"+me->name()+HIY"已经强闯过我双鱼宫，此人要刺杀女神雅典娜，大家全力截住他！\n"NOR,users());
		if(!( room = find_object("/d/huangjingong/palace")) ) room = load_object("/d/huangjingong/palace");
		if( objectp(monk = present("athena", room) ))
		{
			destruct(monk);
			monk = new("/d/huangjingong/npc/yadianna.lpc");
			monk->move(room);
		}
		else
		{
			monk = new("/d/huangjingong/npc/yadianna.lpc");
			monk->move(room);
		}
	}
	::die();
}
