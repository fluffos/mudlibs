inherit NPC;
 
void create()
{
	int jibie;
	jibie = 3000;
	set_name("撒加", ({"shuang zi","saga"}));
	set("long", "守护双子宫的黄金圣斗士，加隆之兄长，教皇候选人之一。十三年前囚禁了罪大恶极的加隆，但在加隆的诱使下，刺杀了前教皇，并冒名担任 教皇，拥有双重性格，一面既善良而又得人心，而另一面则充满邪恶。善良时像神般受人景仰，邪恶时又如同恶魔，是最具人性的悲剧角色。 \n");
	set("gender","男性");
	set("title", "【"+HIY"黄金圣斗士"+NOR"】");
	set("age",37);
	set("attitude", "peaceful");
	set("con",30);
	set("per",30);
	set("str",25);
	set("int",35);
	set("combat_exp",30000000);
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
	set("chat_chance",20);
	set("chat_msg", ({
			"撒加说道：不知何时能再见到雅典娜！\n"   
        }));
	set("jm/kunlun",1);
	set_skill("dodge", 500+jibie*2+(jibie/2));
	set_skill("force", 500+jibie*2+(jibie/2));
	set_skill("parry", 500+jibie*2+(jibie/2));
	set_skill("unarmed", 500+jibie*2+(jibie/2));
	set_skill("sword", 500+jibie*2+(jibie/2));
	set_skill("literate", 500+jibie*2+(jibie/2));
	set_skill("art", 500+jibie/2+(jibie/2));
    set_skill("xuantian-wuji", 500+jibie/2+(jibie/2));
    set_skill("kunlun-shenfa",500+jibie/2+(jibie/2));
    set_skill("kunlun-zhang",500+jibie/2+(jibie/2));
    set_skill("liangyi-jian",500+jibie/2+(jibie/2));
	set_skill("xunlei-sword",500+jibie/2+(jibie/2));	
    map_skill("force", "guiyuan-dafa");
    map_skill("dodge", "kunlun-shenfa");
    map_skill("unarmed", "kunlun-zhang");
    map_skill("parry", "xunlei-sword");
    map_skill("sword", "liangyi-jian");

	setup();
	carry_object("/d/huangjingong/obj/shz_cloth")->wear();
	carry_object("/d/huangjingong/obj/westsword")->wield();
}

void die()
{
    object me,monk,room;        
    me = query_temp("last_damage_from");
	if (me && me->query_temp("day_12gong/tiaozhan"))
	{
		tell_room(environment(this_player()), "好大的胆子,竟敢来刺杀【女神】雅典娜！！！\n");
		tell_room(environment(this_player()), "恨啊.....．\n");
		me->set_temp("day_12gong/winer",1);
		me->set_temp("day_12gong/winer3",1);
		message("chat",HIM+"【黄金十二宫】"HIY"撒加:"+me->name()+HIY"已经强闯过我双子宫，此人要刺杀女神雅典娜，大家全力截住他！\n"NOR,users());
		if(!( room = find_object("/d/huangjingong/juxie")) ) room = load_object("/d/huangjingong/juxie");
		if( objectp(monk = present("ju xie", room) ))
		{
			destruct(monk);
			monk = new("/d/huangjingong/npc/juxie.lpc");
			monk->move(room);
		}
		else
		{
			monk = new("/d/huangjingong/npc/juxie.lpc");
			monk->move(room);
		}
	}
	::die();
}
