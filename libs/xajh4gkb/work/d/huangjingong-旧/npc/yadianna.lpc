int gold_shiergong();
inherit NPC;

void create() {
  int jibie;
  jibie = 15000;
  set_name("雅典娜", ({ "athena" }));
  set("long", "雅典娜与赫斯提亚、阿尔忒弥斯被视为奥林匹斯山上的三处女神。初民最早把她作为霁色初开的境界崇拜，代表处女和纯洁的光明。\n");
  set("gender", "男性");
  set("title", "【" + HIR "智慧女神" + NOR "】");
  set("age", 37);
  set("attitude", "peaceful");
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 150000000);
  set("jm/baituo", 1);
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
  set_skill("literate", 500 + jibie * 2 + (jibie / 2));
  set_skill("dodge", 500 + jibie * 2 + (jibie / 2));
  set_skill("force", 500 + jibie * 2 + (jibie / 2));
  set_skill("parry", 500 + jibie * 2 + (jibie / 2));
  set_skill("unarmed", 500 + jibie * 2 + (jibie / 2));
  set_skill("sword", 500 + jibie * 2 + (jibie / 2));
  set_skill("staff", 500 + jibie * 2 + (jibie / 2));
  set_skill("hamagong", 500 + jibie / 2 + (jibie / 2));
  set_skill("chanchu-bufa", 500 + jibie / 2 + (jibie / 2));
  set_skill("training", 500 + jibie / 2 + (jibie / 2));
  set_skill("shexing-diaoshou", 500 + jibie / 2 + (jibie / 2));
  set_skill("lingshe-zhangfa", 500 + jibie / 2 + (jibie / 2));
  map_skill("force", "hamagong");
  map_skill("dodge", "chanchu-bufa");
  map_skill("unarmed", "shexing-diaoshou");
  map_skill("parry", "lingshe-zhangfa");
  map_skill("staff", "lingshe-zhangfa");
  set("inquiry", ([
    "黄金十二宫": (: gold_shiergong :),
  ]));

  setup();
  carry_object("/d/huangjingong/obj/gold_cloth")->wear();
  carry_object("/d/huangjingong/obj/rose")->wear();
  carry_object("/d/huangjingong/obj/armor")->wear();
  carry_object("/d/huangjingong/obj/pifeng")->wear();
  carry_object("/d/huangjingong/obj/shield")->wear();
  carry_object("/d/huangjingong/obj/staff")->wield();
}

int gold_shiergong() {
  string name;
  object me, baoshi, monk, room;
  int add_exp, add_pot, add_sco, renwu_exp_add;
  me = this_player();

  if (!me->query_temp("day_12gong/tiaozhan") || !me->query_temp("day_12gong/winer")) {
    write(HIW "你是怎么上到这里来的？我不想见你。\n" NOR);
    me->delete_temp("day_12gong");
    me->move("/d/city3/guangchang");
    destruct(this_object());
    return 1;
  }

  if (me->query_temp("day_12gong/tiaozhan") && me->query_temp("day_12gong/winer")) {
    write(HIM "雅典娜面露微笑，点头赞许道：不错，不错，能战胜黄金圣斗士，果然实力了得！\n" NOR, me);
    if (me->query_temp("renwu_exp_add")) renwu_exp_add = (int)me->query_temp("renwu_exp_add", 1);
    add_exp = me->query_temp("day_12gong/winer1") + me->query_temp("day_12gong/winer2") + me->query_temp("day_12gong/winer3") + me->query_temp("day_12gong/winer4") + me->query_temp("day_12gong/winer5") + me->query_temp("day_12gong/winer6") + me->query_temp("day_12gong/winer7") + me->query_temp("day_12gong/winer8") + me->query_temp("day_12gong/winer9") + me->query_temp("day_12gong/winer10") + me->query_temp("day_12gong/winer11") + me->query_temp("day_12gong/winer12");
    tell_object(me, sprintf(WHT "你战胜黄金圣斗士，获得了雅典娜的奖励:\n你的实战等级提高了%s级！", chinese_number(add_exp)));
    me->add("xyzx_sys/level", add_exp);
    add_pot = (add_exp * 5000000) * (renwu_exp_add + 100) / 100;
    tell_object(me, sprintf(HIY "获得了%s点潜能！\n" NOR, chinese_number(add_pot)));
    me->add("potential", add_pot);
    add_sco = (add_exp * 5000) * (renwu_exp_add + 100) / 100;
    tell_object(me, sprintf(YEL "江湖阅历增加了%s点！\n" NOR, chinese_number(add_sco)));
    me->add("score", add_sco);

    if (add_exp >= 12) {
      switch (random(3)) {
        case 0: baoshi = new("/clone/tzbox/xiepai-box");
        break;
        case 1: baoshi = new("/clone/tzbox/zhengpai-box");
        break;
        case 2: baoshi = new("/clone/tzbox/zhongli-box");
        break;
      }
      name = baoshi->name(1);
      switch (random(6)) {
        case 1:
          baoshi->set("xyzx_item/pinji", 1);
          baoshi->set("name", HIW "☆" NOR + name);
          break;
        case 2:
          baoshi->set("xyzx_item/pinji", 2);
          baoshi->set("name", GRN "☆☆" NOR + name);
          break;
        case 3:
          baoshi->set("xyzx_item/pinji", 3);
          baoshi->set("name", HIB "☆☆☆" NOR + name);
          break;
        case 4:
          baoshi->set("xyzx_item/pinji", 4);
          baoshi->set("name", HIM "★" NOR + name);
          break;
        case 5:
          baoshi->set("xyzx_item/pinji", 5);
          baoshi->set("name", HIR "★★" NOR + name);
          break;
        default:
          baoshi->set("xyzx_item/pinji", 0);
          break;
      }
      write(HIM "雅典娜面露微笑的说道：你连胜十二黄金圣斗士，这是额外给你的奖励！\n" NOR, me);
      tell_object(me, YEL "你获得了 " + baoshi->name(1) + "(" + baoshi->query("id") + ")。！\n" NOR);
      baoshi->move(me);
      message(
        "party",
        HIM "【黄金十二宫】" + HIC "听说 " + me->name(1) + HIC " 通过了黄金十二宫的挑战，获得了雅典娜奖励的 " + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
        users()
      );
    }
    if (!(room = find_object("/d/dali/guangchang"))) room = load_object("/d/dali/guangchang");
    if (objectp(monk = present("hades", room))) {
      destruct(monk);
      monk = new("/d/huangjingong/npc/hadisi.lpc");
      monk->move(room);
    } else {
      monk = new("/d/huangjingong/npc/hadisi.lpc");
      monk->move(room);
    }

    me->delete_temp("day_12gong");
    me->move("/d/city3/guangchang");
    destruct(this_object());
    return 1;
  }
}

void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && me->query_temp("day_12gong/tiaozhan")) {
    tell_room(environment(this_player()), "好大的胆子,竟敢来刺杀【女神】雅典娜！！！\n");
    tell_room(environment(this_player()), "恨啊.....．\n");
    me->set_temp("day_12gong/winer", 1);
    me->set_temp("day_12gong/winer13", 3);
    message(
      "chat",
      HIM + "【黄金十二宫】" HIY "雅典娜:" + me->name() + HIY "摧毁了黄金十二宫，神殿即将崩塌！冥界将笼罩大地，世界一片黑暗！\n" NOR,
      users()
    );
  }
  ::die();
}
