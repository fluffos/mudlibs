inherit NPC;

void create() {
  int jibie;
  jibie = 8000;
  set_name("米罗", ({ "tian xie", "milo" }));
  set(
    "long",
    "守护天蝎宫的黄金圣斗士。十二位黄金圣斗士中天蝎座米罗的性格最接近普通人，他给人印象最深的就是笑容。不论是面对多舛的命运还是强大的敌人，米罗总是用笑容来掩盖内心的痛苦和愤怒。和穆那种优雅淡然的微笑不同，米罗的笑带着几分嘲讽和挑衅，他从不把任何人放在眼里，即使面对神，他也是一副玩世不恭的表情。这样的米罗亲切如邻家男孩，因此动漫迷称他为圣斗士中的阳光少年，而他特有的招牌微笑也是动画片中最经典的笑容之一。米罗相信通过努力终究会取得成功，他的绝技“腥红毒针”，刺中时，像被蝎子咬了一口，剧痛难挡，一共有十五发，最后一发是“ANTARES”。是投降还是死，“腥红毒针”十五发击中前会给敌人充分的考虑时间。因为米罗独特的性格，经常在第十五发点中真央点放过对手。十二宫之战中念及冰河的勇气放其通过。冥斗士进犯时更是以深红毒针为免罪符，认同了重返圣域的加隆。最后因哈迪斯所设下的结界，被削弱了90%的力量，而败于冥界三巨头之一天猛星·拉达曼迪斯手下。在冥界为了击穿叹息之墙而逝去，为雅典娜献身。\n"
  );
  set("gender", "男性");
  set("title", "【" + HIY "黄金圣斗士" + NOR "】");
  set("age", 37);
  set("attitude", "peaceful");
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 80000000);
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
  set("chat_chance", 20);
  set("chat_msg", ({
    "米罗说道：不知何时能再见到雅典娜！\n"
  }));
  set("jm/tongchi", 1);
  set_skill("dodge", 500 + jibie * 2 + (jibie / 2));
  set_skill("force", 500 + jibie * 2 + (jibie / 2));
  set_skill("parry", 500 + jibie * 2 + (jibie / 2));
  set_skill("unarmed", 500 + jibie * 2 + (jibie / 2));
  set_skill("sword", 500 + jibie * 2 + (jibie / 2));
  set_skill("literate", 500 + jibie * 2 + (jibie / 2));
  set_skill("damo-force", 500 + jibie / 2 + (jibie / 2));
  set_skill("guxing-sword", 500 + jibie / 2 + (jibie / 2));
  set_skill("dabei-zhang", 500 + jibie / 2 + (jibie / 2));
  set_skill("langzi-sword", 500 + jibie / 2 + (jibie / 2));
  set_skill("piaomiao-shenfa", 500 + jibie / 2 + (jibie / 2));
  map_skill("force", "damo-force");
  map_skill("dodge", "piaomiao-shenfa");
  map_skill("unarmed", "dabei-zhang");
  map_skill("parry", "langzi-sword");
  map_skill("sword", "guxing-sword");

  setup();
  carry_object("/d/huangjingong/obj/tx_cloth")->wear();
  carry_object("/d/huangjingong/obj/westsword")->wield();
}

void die() {
  object me, monk, room;
  me = query_temp("last_damage_from");
  if (me && me->query_temp("day_12gong/tiaozhan")) {
    tell_room(environment(this_player()), "好大的胆子,竟敢来刺杀【女神】雅典娜！！！\n");
    tell_room(environment(this_player()), "恨啊.....．\n");
    me->set_temp("day_12gong/winer", 1);
    me->set_temp("day_12gong/winer8", 1);
    message(
      "chat",
      HIM + "【黄金十二宫】" HIY "米罗:" + me->name() + HIY "已经强闯过我天蝎宫，此人要刺杀女神雅典娜，大家全力截住他！\n" NOR,
      users()
    );
    if (!(room = find_object("/d/huangjingong/renma"))) room = load_object("/d/huangjingong/renma");
    if (objectp(monk = present("she shou", room))) {
      destruct(monk);
      monk = new("/d/huangjingong/npc/renma.lpc");
      monk->move(room);
    } else {
      monk = new("/d/huangjingong/npc/renma.lpc");
      monk->move(room);
    }
  }
  ::die();
}
