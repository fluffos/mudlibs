inherit NPC;
 
void create()
{
	int jibie;
	jibie = 11000;
	set_name("卡妙", ({"shui ping","camus"}));
	set("long", "守护水瓶宫黄金圣斗士。被称为水和冰的魔术师，是圣斗士中的智者，早就知道教皇真面目，为了冰河而牺牲，漫画版为白鸟座 冰河的师傅；动画版则是水晶圣斗士的师傅，冰河的师公。因不想冰河牵涉入这场战斗，在天秤宫把冰河冰封。后来于水瓶宫与冰河决战，目睹冰河的成长后含笑而逝。在冥王篇中与撒加及修罗上演圣斗士版无间道，后在冥界为了击穿叹息之墙而逝去，为雅典娜献身。\n");
	set("gender","男性");
	set("title", "【"+HIY"黄金圣斗士"+NOR"】");
	set("age",37);
	set("attitude", "peaceful");
	set("con",30);
	set("per",30);
	set("str",25);
	set("int",35);
	set("combat_exp",110000000);
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
	set("chat_chance",20);
	set("chat_msg", ({
			"卡妙说道：不知何时能再见到雅典娜！\n"   
        }));
	set("jm/emei",1);
	set_skill("dodge", 500+jibie*2+(jibie/2));
	set_skill("force", 500+jibie*2+(jibie/2));
	set_skill("parry", 500+jibie*2+(jibie/2));
	set_skill("unarmed", 500+jibie*2+(jibie/2));
	set_skill("sword", 500+jibie*2+(jibie/2));
	set_skill("literate", 500+jibie*2+(jibie/2));
    set_skill("linji-zhuang", 500+jibie/2+(jibie/2));
    set_skill("huifeng-jian",500+jibie/2+(jibie/2));
    set_skill("jinding-zhang",500+jibie/2+(jibie/2));
	set_skill("tiangang-zhi",500+jibie/2+(jibie/2));
    set_skill("zhutian-bu",500+jibie/2+(jibie/2));
    map_skill("force", "linji-zhuang");
    map_skill("dodge", "zhutian-bu");
    map_skill("unarmed", "tiangang-zhi");
    map_skill("parry", "jinding-zhang");
    map_skill("sword", "huifeng-jian");

	setup();
	carry_object("/d/huangjingong/obj/sp_cloth")->wear();
	carry_object("/d/huangjingong/obj/westsword")->wield();
}

void die()
{
    object me,monk,room;        
    me = query_temp("last_damage_from");
	if (me && me->query_temp("day_12gong/tiaozhan"))
	{
		tell_room(environment(this_player()), "好大的胆子,竟敢来刺杀【女神】雅典娜！！！\n");
		tell_room(environment(this_player()), "恨啊.....．\n");
		me->set_temp("day_12gong/winer",1);
		me->set_temp("day_12gong/winer11",1);
		message("chat",HIM+"【黄金十二宫】"HIY"卡妙:"+me->name()+HIY"已经强闯过我水瓶宫，此人要刺杀女神雅典娜，大家全力截住他！\n"NOR,users());
		if(!( room = find_object("/d/huangjingong/shuangyu")) ) room = load_object("/d/huangjingong/shuangyu");
		if( objectp(monk = present("shuang yu", room) ))
		{
			destruct(monk);
			monk = new("/d/huangjingong/npc/shuangyu.lpc");
			monk->move(room);
		}
		else
		{
			monk = new("/d/huangjingong/npc/shuangyu.lpc");
			monk->move(room);
		}
	}
	::die();
}
