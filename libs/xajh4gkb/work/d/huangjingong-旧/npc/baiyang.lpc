inherit NPC;
 
void create()
{
	int jibie;
	jibie = 1000;
	set_name("穆", ({"bai yang","mu"}));
	set("long", "守护白羊宫黄金圣斗士，在世黄金圣斗士中唯一有能力修复圣衣的人，念力极高，可在一定空间中穿梭，是前任教皇 史昂的弟子。穆的淡紫色长发、柔软的面目和他始终淡泊优雅的笑容常常给人一种极度沉静而强大的感觉，但穆的念力是黄金圣斗士中最强的。十三年前撒加之乱后穆隐居帕米尔高原，拒绝服从圣域和教皇。在黄道十二宫之战中，第一宫的穆帮助星矢、紫龙、冰河、瞬修复了青铜圣衣，告知星矢等人领悟第七感的意义。冥界十二宫之战中，穆面对昔日恩师史昂，不惜违逆师命，杀迪斯马斯克、阿布罗狄，阻撒加、卡妙、修罗，灭冥斗士:地妖星·蝴蝶·巴比隆。冥王篇中因冥结界的弱化而惨败于冥界三巨头之一天猛星·拉达曼迪斯手下。在冥界为了击穿叹息之墙而逝去，为雅典娜献身。 \n");
	set("gender","男性");
	set("title", "【"+HIY"黄金圣斗士"+NOR"】");
	set("age",37);
	set("attitude", "peaceful");
	set("con",30);
	set("per",30);
	set("str",25);
	set("int",35);
	set("combat_exp",10000000);
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
	set("chat_chance",20);
	set("chat_msg", ({
			"穆说道：不知何时能再见到雅典娜！\n"   
        }));
	set("jm/songshan",1);
	set_skill("dodge", 500+jibie*2+(jibie/2));
	set_skill("force", 500+jibie*2+(jibie/2));
	set_skill("parry", 500+jibie*2+(jibie/2));
	set_skill("unarmed", 500+jibie*2+(jibie/2));
	set_skill("sword", 500+jibie*2+(jibie/2));
	set_skill("literate", 500+jibie*2+(jibie/2));
    set_skill("hanbing-zhenqi", 500+jibie/2+(jibie/2));
    set_skill("lingxu-bu",500+jibie/2+(jibie/2));
    set_skill("songyang-zhang",500+jibie/2+(jibie/2));
    set_skill("songshan-jian",500+jibie/2+(jibie/2));	
    map_skill("force", "hanbing-zhenqi");
    map_skill("dodge", "lingxu-bu");
    map_skill("unarmed", "songyang-zhang");
    map_skill("parry", "songyang-zhang");
    map_skill("sword", "songshan-jian");

	setup();
	carry_object("/d/huangjingong/obj/by_cloth")->wear();
	carry_object("/d/huangjingong/obj/westsword")->wield();
}

void die()
{
    object me,monk,room;        
    me = query_temp("last_damage_from");
	if (me && me->query_temp("day_12gong/tiaozhan"))
	{
		tell_room(environment(this_player()), "好大的胆子,竟敢来刺杀【女神】雅典娜！！！\n");
		tell_room(environment(this_player()), "恨啊.....．\n");
		me->set_temp("day_12gong/winer",1);
		me->set_temp("day_12gong/winer1",1);
		message("chat",HIM+"【黄金十二宫】"HIY"穆:"+me->name()+HIY"已经强闯过我白羊宫，此人要刺杀女神雅典娜，大家全力截住他！\n"NOR,users());
		if(!( room = find_object("/d/huangjingong/jinniu")) ) room = load_object("/d/huangjingong/jinniu");
		if( objectp(monk = present("jin niu", room) ))
		{
			destruct(monk);
			monk = new("/d/huangjingong/npc/jinniu.lpc");
			monk->move(room);
		}
		else
		{
			monk = new("/d/huangjingong/npc/jinniu.lpc");
			monk->move(room);
		}
	}
	::die();
}
