inherit NPC;
 
void create()
{
	int jibie;
	jibie = 7000;
	set_name("童虎", ({"tian chen","tonghu",}));
	set("long", "受所有人尊敬，是其他所有黄金圣斗士的老师，亦是紫龙的老师，实力之强属于超一流水平，是243年前的圣战唯二的存活者之一。天秤座圣衣有十二件兵器，童虎也是唯二被或许使用兵器作战的圣斗士之一。天秤座圣衣据称天下无敌，粉碎七洋之柱犹如探囊取物一样容易，黄金兵器之强使海斗士斯基拉依奥被粉碎，可见恐怖至极。童虎本人也不轻易使用兵器作战。他的杀伤力相当于十二名黄金圣斗士的合力一击。童虎受女神的指示在中国庐山五老峰看管冥王哈迪斯的一百零八位魔星的封印。处于一种半休眠状态，每年心脏只跳十万次，相当于一个正常人一天心脏跳动的次数。在五老峰坐了243年的童虎只相当于过了243天。在冥王篇中，和复活的白羊座·史昂大战，不分胜负，激烈交战后双双消失。在冥界为了击穿叹息之墙而逝去，为雅典娜献身。 \n");
	set("gender","男性");
	set("title", "【"+HIY"黄金圣斗士"+NOR"】");
	set("age",37);
	set("attitude", "peaceful");
	set("con",30);
	set("per",30);
	set("str",25);
	set("int",35);
	set("combat_exp",70000000);
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
	set("chat_chance",20);
	set("chat_msg", ({
			"童虎说道：不知何时能再见到雅典娜！\n"   
        }));
	set("jm/tiezhang",1);
	set_skill("dodge", 500+jibie*2+(jibie/2));
	set_skill("force", 500+jibie*2+(jibie/2));
	set_skill("parry", 500+jibie*2+(jibie/2));
	set_skill("unarmed", 500+jibie*2+(jibie/2));
	set_skill("sword", 500+jibie*2+(jibie/2));
	set_skill("literate", 500+jibie*2+(jibie/2));
    set_skill("guiyuan-tunafa", 500+jibie/2+(jibie/2));
    set_skill("shuishangpiao",500+jibie/2+(jibie/2));
    set_skill("tiezhang-zhangfa",500+jibie/2+(jibie/2));
    set_skill("yueying-wubu",500+jibie/2+(jibie/2));
    map_skill("force", "guiyuan-tunafa");
    map_skill("dodge", "shuishangpiao");
    map_skill("unarmed", "tiezhang-zhangfa");
    map_skill("parry", "tiezhang-zhangfa");

	setup();
	carry_object("/d/huangjingong/obj/tc_cloth")->wear();
}

void die()
{
    object me,monk,room;        
    me = query_temp("last_damage_from");
	if (me && me->query_temp("day_12gong/tiaozhan"))
	{
		tell_room(environment(this_player()), "好大的胆子,竟敢来刺杀【女神】雅典娜！！！\n");
		tell_room(environment(this_player()), "恨啊.....．\n");
		me->set_temp("day_12gong/winer",1);
		me->set_temp("day_12gong/winer7",1);
		message("chat",HIM+"【黄金十二宫】"HIY"童虎:"+me->name()+HIY"已经强闯过我天秤宫，此人要刺杀女神雅典娜，大家全力截住他！\n"NOR,users());
		if(!( room = find_object("/d/huangjingong/tianxie")) ) room = load_object("/d/huangjingong/tianxie");
		if( objectp(monk = present("tian xie", room) ))
		{
			destruct(monk);
			monk = new("/d/huangjingong/npc/tianxie.lpc");
			monk->move(room);
		}
		else
		{
			monk = new("/d/huangjingong/npc/tianxie.lpc");
			monk->move(room);
		}
	}
	::die();
}
