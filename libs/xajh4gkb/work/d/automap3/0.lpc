#include <room.h>
#include <ansi.h>

inherit ROOM;


void create()
{
	set("short", "三级副本");
	set("long", @LONG
   这里是迷雾森林的入口处，再往前面就是传说中的险恶之地迷雾森林了，来
到了这里就意味着再也没有退路。只有在不断的战斗中，才能提高自己的实
战能力。
LONG);
	set("no_fight", "1");
	set("no_steal", "1");
	set("no_sleep_room", "1");
	set("exits", ([
		"east" : "/d/automap3/fuben"+(1+random(500)),	                          	
		]));
//	set("no_clean_up", 0);
	setup();
}
int valid_leave(object me, string dir)
{
	object *inv;
//	object *usr;
//	string str;		
	int sizeinv;
//	int i,ip_cnt;	
	
	if (dir =="east")
	{    
		if ( me->query("xyzx_sys/level") < 1000)       	
			return notify_fail(HIC"就平你这点微末功夫不是去送死吗！\n"NOR);
		if ( me->query("xyzx_sys/level") > 20000)       	
			return notify_fail(HIC"你都已经名动江湖了，再来这里不合适吧！\n"NOR);	
		if (present("buzhen xiang",me))
			return notify_fail("你带着布阵箱进迷雾森林想做什么？\n");
		if (present("zhu lou",me))
			return notify_fail("你带着竹篓进迷雾森林想做什么？\n");
//2018.6.12阿飞增加IP管制，暂时放开IP管制，排查服务器卡的原因
/*		usr = get_all_user();
		str=query_ip_number(me);
		ip_cnt=0;
		for(i=0; i<sizeof(usr); i++)
		{
			if (str==query_ip_number(usr[i]) && usr[i]->query_temp("fuben_three")) ip_cnt++;
		}
		if ( ip_cnt >= 3 )
			return notify_fail("这个IP进入副本的玩家太多了，给其他人留条活路吧！\n");
*/		
		inv=all_inventory(me);
		sizeinv=sizeof(inv);
		while (sizeinv--)
		{
       		if (inv[sizeinv]->is_character())  
     			return notify_fail(HIG"你想给里面的怪物送点心去？\n"NOR);      		
		}
		me->set_temp("fuben_three", 1);
	}

	return ::valid_leave(me, dir);
}
