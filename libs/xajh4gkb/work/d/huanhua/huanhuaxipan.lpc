// jianshi.c 剑室
// by chenww

inherit ROOM;

void create() {
  set("short", "浣花溪畔");
  set("long", @LONG
小溪从一座廊桥下淌过，河面顿时变得宽阔，南来的溪流也汇聚于此，形成小湖泊。
白色鹅卵石布满了斜坡的河堤，三两顽童嬉戏其上，白天鹅依然昂首悠游碧波上。东
去的流水陡然从大岩石上跌落，便成了小小的瀑布，为满眼的绿色添了生动和情趣。
	武林名宿萧栖梧曾在此地创立浣花剑法，以一式天下有雪饮誉江湖，艺成名就之后，
于浣花溪畔建立基业，广收弟子，号称「浣花剑派」。此乃萧家发源之地，你可以在此
感悟（lianjian）浣花剑法的孤寂意境。
LONG
  );

  set("outdoors", "huanhua");
  set("exits", ([
    "north": __DIR__ "jiashan",
  ]));
  /*  	//这一堆代码有啥用？
	set("coor/x",80);
	set("coor/y",-50);
	set("coor/z",0);
	set("coor/x",80);
	set("coor/y",-50);
	set("coor/z",0);
	set("coor/x",80);
	set("coor/y",-50);
	set("coor/z",0);
	set("coor/x",80);
	set("coor/y",-50);
	set("coor/z",0);	
*/
  setup();

}


void init() {
  add_action("do_lianjian", "lianjian");
}

int do_lianjian(string arg) {
  object me = this_player();

  string *poem = ({
    "使出一招「" HIM "天际长江" NOR "」，江水连绵，浩浩荡荡...",
    "使出一招「" HIG "紫气万象" NOR "」，晨曦初升，紫气浩荡几万里...",
    "使出一招「" HIB "花雨点点" NOR "」，微风、细雨、落花如流水...",
    "使出一招「" HIY "花落无凭" NOR "」，落花有意，流水无情...",
    "使出一招「" HIB "天下有雪" NOR "」，生亦何欢，死亦何患，千年万年，白驹过隙。",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫练剑......\n");
  if (!me->query_temp("jm_huanhua3"))
    return notify_fail("你未完成萧西楼的遗愿，如何能静下心来练剑！\n");
  if (!me->query_temp("jm_huanhua5"))
    return notify_fail("你未解决萧家与唐门的恩怨，如何能静下心来练剑！\n");
  if (me->query("jm/huanhua"))
    return notify_fail("你已经完全领悟了浣花剑派的精髓，不需要在这领悟了。\n");
  if (me->query("family/family_name") != "浣花剑派")
    return notify_fail("不是浣花剑派的弟子竟敢再此练剑？小心萧家人追杀你。\n");

  if (me->query_skill("guiyuan-dafa", 1) < 1000) {
    tell_object(me, "你的内功似乎差了点.......\n");
    return 1;
  }
  if (me->query_skill("huanhua-jian", 1) < 2000) {
    tell_object(me, "你的剑法似乎差了点.......\n");
    return 1;
  }
  if (me->query_skill("feihua-wuping", 1) < 2000) {
    tell_object(me, "以你的轻功，恐怕会掉水里吧.......\n");
    return 1;
  }
  if (me->query("jingli") < 1000) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }

  tell_object(me, HIW "你站在浣花溪畔，凉风拂面，绿树成荫，心旷神怡，你尝试着练习了下......\n" NOR);
  message_vision("$N" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -500);
  me->start_busy(1);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/huanhua", 1);
    me->add("family_score", 1);
    tell_object(me, HIB "你突然醒悟道：" HIY "原来浣花剑法可以有此等威力" HIR "！\n" NOR);
    tell_object(me, HIB "恭喜你融汇贯通了浣花剑派武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在浣花溪畔居然领悟了浣花剑派的天下有雪！\n" NOR,
      users()
    );
  }
  return 1;
}
