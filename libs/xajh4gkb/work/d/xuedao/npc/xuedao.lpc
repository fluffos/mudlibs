#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name("血刀老祖", ({ "xuedao laozu", "xue dao", "laozu" }));
        set("long",@LONG
这喇嘛身着黄袍，年纪极老，尖头削耳，脸上都是皱纹。他就是血刀门第四代掌门。
LONG
        );
        set("title",HIR"血刀门第四代掌门"NOR);
        set("gender", "男性");
        set("age", 85);
        set("attitude", "peaceful");
        set("shen_type", -1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("max_qi", 3000000);
        set("max_jing", 1000000);
        set("neili", 10000000);
        set("max_neili", 200000);
        set("wuyongjiali", 15000);

        set("combat_exp", 580000000);
        set("score", 180000);

        set_skill("lamaism", 500+jibie/3+random(jibie/5));
        set_skill("literate", 500+jibie/3+random(jibie/5));
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("blade", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("xuedao-xinfa", 500+jibie/3+random(jibie/5));
        set_skill("xueying-shenfa", 500+jibie/3+random(jibie/5));
        set_skill("dashou-yin", 500+jibie/3+random(jibie/5));
        set_skill("mingwang-jian", 500+jibie/3+random(jibie/5));
        set_skill("xue-dao", 500+jibie/3+random(jibie/5));

        map_skill("force", "xuedao-xinfa");
        map_skill("dodge", "xueying-shenfa");
        map_skill("unarmed", "dashou-yin");
        map_skill("parry", "xue-dao");
        map_skill("blade", "xue-dao");
        map_skill("sword", "mingwang-jian");
        set("chat_chance_combat", 20);  
        set("chat_msg_combat", ({
                (: command("unwield flood blade") :),
                (: command("wield flood blade") :),
        }) );

        create_family("血刀门", 4, "掌门");
        set("class", "bonze");
			
        setup();
        carry_object("/d/xueshan/obj/y-jiasha")->wear();
        carry_object("/d/xueshan/obj/xblade")->wield();
//    carry_object("/d/xueshan/npc/obj/xblade")->wield();	

        add_money("gold",2);
}



