//叶孤城
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int ask_feixian();
void create() {
  int jibie;
  jibie = 9000;
  //	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
  set_name(HIR "叶孤城" NOR, ({ "ye gucheng", "gucheng" }));
  set("long", "白云城主叶孤城为当今天下武功真正能达到巅峰的六人之一，其「天外飞仙」如青天白云无瑕无垢。\n");
  set("title", YEL "白云城主" NOR);
  set("gender", "男性");
  set("age", 46);
  set("attitude", "peaceful");
  //       set("class","nigu");
  set("per", 30);
  set("int", 30);
  set("max_qi", 3000000);
  set("max_jing", 3000000);
  set("max_jingli", 300000);
  set("neili", 3000000);
  set("max_neili", 3000000);
  set("combat_exp", 580000000);

  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("feixian-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("bitao-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("baihua-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qiongya-bufa", 500 + jibie / 3 + random(jibie / 5));
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "bitao-shengong");
  map_skill("sword", "feixian-jian");
  map_skill("parry", "feixian-jian");
  map_skill("dodge", "qiongya-bufa");

  create_family("南海派", 1, "掌门");
  //		create_family("白云庵", 1, "先祖");
  set("inquiry", ([ "天外飞仙": (: ask_feixian :), ]));
  setup();
  carry_object("/d/hainan/obj/bai_cloth")->wear();
  carry_object("/d/hainan/obj/feihong")->wield();
  add_money("gold.lpc", 100);
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    message_vision("叶孤城对你笑道：你的实战经验太低了,我还不能收你！\n", ob);
    return;
  }
  if ((int)ob->query("int", 1) < 30) {
    command("shake");
    command("say 以我看这位" + RANK_D->query_respect(ob) + "的悟性不够，不适合学我这一派武功.\n");
    return;
  }
  if ((int)ob->query_skill("bitao-shengong", 1) < 1000) {
    command("shake");
    command("say 以我看这位" + RANK_D->query_respect(ob) + "对本门内功心法不够娴熟。\n");
    return;
  }
  if ((int)ob->query_skill("feixian-jian", 1) < 1000) {
    command("shake");
    command("say 以我看这位" + RANK_D->query_respect(ob) + "的飞仙剑法不够娴熟。\n");
    return;
  }
  command("pat " + ob->query("id"));
  command("say 好，希望" + RANK_D->query_respect(ob) + "多加努力，把我们海南一派发扬光大。\n");
  command("recruit " + ob->query("id"));
  return;
}

int ask_feixian() {
  object ob;
  ob = this_player();

  if (ob->query("family/master_id") == "ye gucheng") {
    if ((int)ob->query_skill("feixian-jian", 1) > 2000) {
      tell_object(ob, HIC "叶孤城说道：天外飞仙乃白云城最高剑决，如要学会需和我以命相拼才行，你如想清楚了再说吧！\n" NOR);
      tell_object(ob, HIC "叶孤城说道：如果你考虑好了，就来紫禁之巅吧！\n" NOR);
      this_object()->move("/d/huanggong/zijin");
      ob->set_temp("jm/nanhai1", 1);
    } else {
      tell_object(ob, "叶孤城说道：天外飞仙乃白云城最高剑决，以你当前的水平，不是我的对手！\n");
    }
  } else {
    tell_object(ob, "叶孤城说道：天外飞仙的秘密只传给我的嫡传弟子！\n");
    return 1;
  }

  return 1;
}

void kill_ob(object me) {
  if (!this_player()) {
    ::kill_ob(me);
    return;
  }
  if (this_player()->query("family/master_id") == "ye gucheng" && this_player()->query_temp("jm/nanhai1")) {
    command("say 你可要小心了，拿出你必生功力来杀我。\n");
    this_player()->set_temp("jm/nanhai2", 1);
    ::kill_ob(me);
  }
}
void die() {
  object ob, me;
  ob = this_object();
  me = query_temp("last_damage_from");
  if (me && me->query("family/master_id") == "ye gucheng" && me->query_temp("jm/nanhai2") && !me->query("jm/nanhai")) {
    message_vision(HIG "叶孤城说道：你不必难过，要想领悟天外飞仙的精髓，只能在生死一线之间领悟。。\n", this_object());
    me->set("jm/nanhai", 1);
    me->add("family_score", 1);
    message_vision(HIG "你在生死一线中你体会到了天外飞仙的精髓。\n", this_object());
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在皇宫紫禁之巅与叶孤城的决斗之中，于生死一线之间领悟到了天外飞仙的精髓！\n" NOR,
      users()
    );
  }
  ::die();
}
