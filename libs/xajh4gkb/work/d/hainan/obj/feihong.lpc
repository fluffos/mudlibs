//叶孤城佩剑  飞虹-名器

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  set_name(HIY HIW "飞虹" NOR, ({ "fei hong", "sword" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 100000);
    set("material", "ice");
    set("long", "这是一柄四尺来长的古剑，剑鞘上金丝镶着两个字“飞虹”。整个剑身隐隐发出一层青气，剑未出鞘，已可见其不凡。\n");
    set("wield_msg", HIY "$N“唰”的一声抽出$n" + HIY + "挽了个剑花，但见寒芒吞吐，电闪星飞。....$N不由得从心底升起一股凌云豪气。\n" NOR);
    set("unwield_msg", HIW "飞虹剑" HIY "幻作一道白光，「唰」地飞入剑鞘。\n" NOR);
    set("weapon_prop/strength", 10);
    set("weapon_prop/sword", 30);
    set("weapon_prop/dexerity", 10);
    set("weapon_prop/dodge", 10);
    set("weapon_prop/intelligence", 10);
  }
  init_sword(500, 2);
  setup();
}

int query_autoload() { return 1; }
