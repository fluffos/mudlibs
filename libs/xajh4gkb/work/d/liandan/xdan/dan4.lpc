inherit ITEM;
void create()
{
        set_name(HIR"肾宝"NOR, ({ "shen bao","bao"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {       
           set("unit", "颗"); 
  //              set("no_get",1);
  //              set("no_drop",1);             
  //              set("no_put",1);
  //              set("no_give",1);   
                set("value",10000000);	
        }
    setup();
}
void init()
{
    if (environment()==this_player())
        add_action("do_eat", "eat");
}
int do_eat(string arg)
{
  object me = this_player();
    
  if (arg!="bao" && arg!="shen bao")   return 0;
  if(me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

//  if(me->query("id")==query("value"))
//  return notify_fail("这棵丹不是你练的,你吃个什么劲。\n");
    
me->add("combat_exp",50000);
me->add("max_jingli",100+random(100));  message_vision(HIB"$N拿起肾宝吃了下去,感觉自己的精力有所增加,恢复了男人本色!!!\n"NOR,me);
       destruct(this_object());
       return 1;
}

