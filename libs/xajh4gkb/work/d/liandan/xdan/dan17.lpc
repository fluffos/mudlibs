void create() {
  set_name(HIY "养颜丹" NOR, ({ "yangyan dan", "dan" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗金黄色的丹丸，略微能闻到些许香气，据说可以增加先天容貌。\n");
    //		set("drug_type", "补品");
    //		set("no_get",1);
    //		set("no_drop",1);             
    //		set("no_put",1);
    //		set("no_give",1);   
    set("value", 10000000);
  }

  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_eat", "eat");
}
int do_eat(string arg) {
  object me = this_player();
  if (arg != "dan" && arg != "yangyan dan") return 0;
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  //	if(me->query("id")==query("value"))
  //		return notify_fail("这棵丹不是你练的,你吃个什么劲。\n");
  if (me->query("per") >= 35)
    return notify_fail("养颜丹只能提高到35，过了就不能吃了。\n");

  if (me->query("liandan/per") >= 5) {
    message_vision("$N眨眨眼。\n", me);
    tell_object(me, "你觉得这药没啥味道，还不如花生好吃。\n");
  } else {
    tell_object(me, HIG "你轻轻掰开一颗养颜丹送入嘴中，脸上突然奇痒无比...\n 也不知道过了多久，脸上竟蜕了一层皮下来......\n" NOR);
    me->add("per", 1);
    me->add("liandan/per", 1);
  }

  destruct(this_object());
  return 1;
}
