inherit ITEM;
void create()
{
        set_name(HIW"血气丹"NOR, ({ "xueqi dan","dan"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一颗血气丹,不知道有什么用!\n");
                set("unit", "颗"); 
 //               set("no_get",1);
 //               set("no_drop",1);             
//                set("no_put",1);
//                set("no_give",1);   
                set("value",10000000);
        }
    setup();
}
void init()
{
    if (environment()==this_player())
        add_action("do_eat", "eat");
}
int do_eat(string arg)
{
  object me = this_player();

  if(!id(arg)) return 0;
 
//  if(me->query("id")== query("value"))
//  return notify_fail("这棵血气丹不是你练的,你吃个什么劲。\n");
    
		me->add("combat_exp",50000);
	me->set("food", 2*me->max_food_capacity());
	me->set("water",2*me->max_water_capacity());
        me->set("eff_jing",me->query("max_jing"));
        me->set("jing",me->query("max_jing"));
        me->set("eff_qi",me->query("max_qi"));
        me->set("qi",me->query("max_qi"));    
  message_vision(HIR"$N拿起血气丹吃了下去,感觉全身精力充沛!!!!!\n"NOR,me);
       destruct(this_object());
       return 1;
}

