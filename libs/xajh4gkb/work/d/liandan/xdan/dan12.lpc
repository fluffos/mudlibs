inherit ITEM;
#include <ansi.h>
void init()
{
        add_action("do_eat", "eat");
}
void create()
{
    set_name(HIB "八卦丸" NOR, ({"bagua wan", "wan"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit", "颗");
		set("long", "相传为太上老君在八卦炼丹炉炼制九转金丹时的残药，不知道有什么效果。\n");
  //              set("no_get",1);
  //              set("no_drop",1);             
  //              set("no_put",1);
  //              set("no_give",1);   
                set("value",10000000);

        }	

        setup();
}
int do_eat(string arg)
{
    if (!id(arg))  return notify_fail("你要吃什么？\n");
//  if(this_player()->query("id")==query("value"))
//  return notify_fail("这棵丹不是你练的,你吃个什么劲。\n");

   this_player()->set_skill("force",this_player()->query_skill("parry",1) + 1 ); 
   message_vision(HIC "$N吞下八卦丸，四肢血脉运行加快，不一会你感觉到全身关节灵活了不少。\n" NOR,this_player() );
    destruct(this_object());
    return 1;
}

