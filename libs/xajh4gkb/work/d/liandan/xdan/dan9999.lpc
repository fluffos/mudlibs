inherit ITEM;
void create()
{
        set_name(HIB"龙丹"NOR, ({ "dragon dan" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","听说这个丹的功效和龙元的功效一样,不知道是不是真的!\n");
                set("unit", "颗");
  //              set("no_get",1);
  //              set("no_drop",1);             
  //              set("no_put",1);
  //              set("no_give",1);   
                set("value",10000000);
        }
        setup();
}

void init()
{
	if(this_player()==environment())
	add_action("do_eat","eat");
}

int do_eat()
{
	string theskill;
	int thelevel = 0;
	mapping skl, lrn, map;
	string *sname, *mapped;
	int i;

	skl = this_player()->query_skills(); 

//  if(this_player()->query("id")==query("value"))
//  return notify_fail("这棵丹不是你练的,你吃个什么劲。\n");
	if(!sizeof(skl)) 
	{
		write( "你目前并没有学会任何技能。\n");
		return 1;
	}
	sname  = sort_array( keys(skl), (: strcmp :) );

	map = this_player()->query_skill_map();
	if( mapp(map) ) mapped = values(map);
	if( !mapped ) mapped = ({});

	lrn = this_player()->query_learned();
	if( !mapp(lrn) ) lrn = ([]);

	for(i=0; i<sizeof(skl); i++) 
	{
		if(skl[sname[i]] > thelevel)
		{
			theskill = sname[i];
			thelevel = skl[sname[i]];
		} 
	}
	this_player()->set_skill(theskill, (int)thelevel+1);
	message_vision(HIG"$N的"+to_chinese(theskill)+"提升了一级。\n"NOR, this_player());
	destruct(this_object());
	return 1;
}

