// Room: /d/emei/baota6.c 峨嵋派 宝塔6

#include <room.h>
inherit ROOM;
void create() {
  set("short", "宝塔六层");
  set("long", @LONG
这里是大悲塔的六层，脚下铺着厚厚的石板，八角形的墙身上则有四扇
木窗向四面敞开，向外望去可以看到生长茂密的楠树，偶尔几只飞燕掠过树
林飞上了碧蓝的天空。转身过去，可以看到墙壁(wall)上刻有大段的经文。
你可以试着阅读经文（yuedu）。往上看去，圆行的顶盖，上挂了一口古钟。
LONG
  );

  set("exits", ([
    "down": __DIR__ "baota5",
  ]));
  set("item_desc", ([
    "wall": @WALL
大乘佛经第六卷：
佛言。吾视王侯之位。如过隙尘。视金玉之宝。如瓦砾。视纨素之服。如敝帛。
视大千界。如一诃子。视阿耨池水。如涂足油。视方便门。如化宝聚。视无上乘。
如梦金帛。视佛道。如眼前华。视禅定。如须弥柱。视涅盘。如昼夕寤。视倒正。
如六龙舞。视平等。如一真地。视兴化。如四时木。
WALL
  ]));

  setup();
}
void init() {
  add_action("do_yuedu", "yuedu");
}

int do_yuedu(string arg) {
  object me = this_player();
  int cost;

  string *poem = ({
    "" HIM "世尊成道已，作是思惟，离欲寂静，是最为胜。" NOR "",
    "" HIG "住大禅定，降诸魔道，於鹿野苑中。转四谛法轮，求佛进止，世尊教敕。" NOR "",
    "" HIB "佛言：辞亲出家，识心达本，解无为法。名曰沙门。" NOR "",
    "" HIY "常行二百五十戒，进止清净，为四真道行，成阿罗汉。阿罗汉者，能飞行变化，旷劫寿命，住动天地。" NOR "",
    "" HIB "佛言：大怀爱欲，不见道者。譬如澄水，致手搅之。众人共临，无有睹其影者。" NOR "",
    "" HIC "人以爱欲交错，心中浊兴，故不见道。汝等沙门，当舍爱欲，爱欲垢尽，道可见矣。" NOR "",
    "" HIR "佛言：夫为道者，犹木在水。寻流而行，不触两岸。不为人取，不为鬼神所遮，不为洄流所住，亦不腐败。吾保此木，决定入海。" NOR "",
    "" HIY "学道之人，不为情欲所惑，不为众邪所娆。精进无为，吾保此人，必得道矣。" NOR "",
    "" HIW "佛言：如人锻铁，去滓成器，器即精好。学道之人，去心垢染，行即清净矣。" NOR "",
    "" HIG "沙门行道，无如磨牛。身虽行道，心道不行，心道若行，何用行道。" NOR "",
    "" HIC "夫为道者，如牛负重。行深泥中，疲极不敢。左右顾视，出离淤泥，乃可苏息。" NOR "",
    "" HIM "佛言：吾视王侯之位，如过隙尘。视金玉之宝，如瓦砾。视纨素之服，如敝帛。" NOR "",
    "" HIR "视大千界，如一诃子。视阿耨池水，如涂足油。视方便门，如化宝聚。视无上乘，如梦金帛。" NOR "",
    "" HIW "视佛道，如眼前华。视禅定，如须弥柱。视涅盘，如昼夕寤。视倒正，如六龙舞。视平等，如一真地。" NOR "",
  });

  if (!arg || (arg != "wall"))
    return notify_fail("你要阅读什么？\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (me->query("shen") < (me->query_skill("linji-zhuang", 1)) * 1000)
    return notify_fail("我佛慈悲，从善去恶！研读佛经要有足够的善行。\n");
  if (me->query("xyzx_sys/level", 1) < 2000)
    return notify_fail("你的经验不足！先多多磨练磨练吧。\n");
  if (me->query_skill("literate", 1) < 1000)
    return notify_fail("以你现在的文学修为，还无法看得懂墙壁上的经文！\n");
  if (me->query_skill("buddhism", 1) < 1000)
    return notify_fail("以你现在的禅宗修为，还无法看得懂墙壁上的经文！\n");
  if (me->query_skill("yugalism", 1) < 1000)
    return notify_fail("以你现在的大乘佛法修为，还无法看得懂墙壁上的经文！\n");
  if (me->query_skill("mahayana", 1) < 1000)
    return notify_fail("以你现在的大乘涅槃修为，还无法看得懂墙壁上的经文！\n");
  if (me->query_skill("dushi-jiren", 1) < 1000)
    return notify_fail("以你现在的渡世济人修为，还无法看得懂墙壁上的经文！\n");
  if (me->query_skill("linji-zhuang", 1) < 1000)
    return notify_fail("以你现在的临济十二庄修为，还无法看得懂墙壁上的经文！\n");
  if (me->query_skill("huifeng-jian", 1) < 2000)
    return notify_fail("以你现在的回风落雁剑修为，还无法看得懂墙壁上的经文！\n");
  if (me->query_skill("jinding-zhang", 1) < 2000)
    return notify_fail("以你现在的金顶掌修为，还无法看得懂墙壁上的经文！\n");
  if (me->query_skill("zhutian-bu", 1) < 2000)
    return notify_fail("以你现在的天罡指修为，还无法看得懂墙壁上的经文！\n");
  if (me->query("jingli") < (int)me->query_skill("huifeng-jian", 1))
    return notify_fail("你已经读的精疲力竭，需要休息一下了！\n");
  if (me->query("family/family_name") != "峨嵋派" || (string)me->query("class") != "bonze")
    return notify_fail("来了峨嵋不入佛门，如何能参悟佛经。\n");
  if (!me->query_temp("jm_emei5"))
    return notify_fail("你未完成峨嵋派的心愿，擅自潜入宝塔参悟佛经，被灭绝师太发现了恐怕会震怒！\n");
  if (me->query("jm/emei"))
    return notify_fail("你已经完全领悟了峨嵋派的佛法精髓，没必须在这里参悟了！\n");

  cost = (int)me->query_skill("huifeng-jian", 1);
  message_vision("$N开始认真的阅读起墙壁上的经文。\n", me);
  message_vision("大乘佛经曰：" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -cost);
  me->start_busy(1);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/emei", 1);
    me->add("family_score", 1);
    tell_object(me, HIG "你突然醒悟道：" HIY "原来回风落雁剑可以有此等威力" HIR "！\n" NOR);
    tell_object(me, HIG "恭喜你融汇贯通了峨眉武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在峨嵋派大悲塔参悟大乘佛经居然领悟了峨嵋派的终极奥义！\n" NOR,
      users()
    );
  }
  return 1;
}
