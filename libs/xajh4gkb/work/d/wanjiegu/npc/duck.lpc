
inherit NPC;

void create()
{
	int jibie;
	jibie = 4;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
        set_name("野鸭", ({ "duck" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一只到处乱跑的鸭子\n");
        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );
        set_skill("dodge", 50);
        set("combat_exp", 500);
        setup();
}
