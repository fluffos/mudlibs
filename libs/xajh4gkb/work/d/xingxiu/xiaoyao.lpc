// Xiaoyao.c:  the sleeping room for Xingxiu
// Jay May 13, 96
inherit ROOM;
string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});
void create() {
  set("short", "逍遥洞");
  set("long", @LONG
这是一个粗糙的石洞，里面铺了几张臭哄哄的草垫子。垫子旁边
是一些破酒罐子。洞壁(wall)上有些字迹。这些破罐子似乎是用来
练习某种毒功的，你可以尝试看看(liandu)。
LONG
  );
  set("sleep_room", "1");
  set("no_fight", "1");
  set("exits", ([
    "out": __DIR__ "xxh6",
  ]));
  set("item_desc", ([
    "wall": "星宿淫贼人人得而株之！\n",
  ]));
  setup();
}

void init() {
  add_action("do_liandu", "liandu");
}


int do_liandu(string arg) {
  object me = this_player();

  string *poem = ({
    "断肠草...吻葛...朝阳草...大茶药...虎狼草",
    "鹤顶红...梭葛草...大炮叶...黄花苦晚藤...黄猛菜",
    "绝情花...发冷藤...藤黄...葫蔓藤...大鸡苦蔓",
    "三足蜘蛛...金线蜈蚣...墨玉蟾蜍...铁线蛇...九尾蝎",
    "七星海棠...雪莲花...碧玉葫芦...龙涎草...火龙胆",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫修炼毒功。\n");
  if (!me->query_temp("jm_xingxiu5"))
    return notify_fail("你未得到丁老怪的指点，贸然炼毒恐怕容易毒发攻心啊。\n");
  if (me->query("jm/xingxiu"))
    return notify_fail("你已经完全领悟了桃花源记的意境，自此桃花岛武学融会贯通，不需要在这领悟了。\n");
  if (me->query("family/family_name") != "星宿派")
    return notify_fail("不是星宿派传人，如何能进入这逍遥洞来快活呢？\n");

  if (me->query_skill("huagong-dafa", 1) < 1000) {
    tell_object(me, "你的化功大法.......\n");
    return 1;
  }
  if (me->query_skill("chousui-zhang", 1) < 2000) {
    tell_object(me, "你的抽髓掌法.......\n");
    return 1;
  }
  if (me->query_skill("zhaixinggong", 1) < 2000) {
    tell_object(me, "你的摘星功.......\n");
    return 1;
  }
  if (me->query("jingli") < 1000) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }

  tell_object(me, HIW "你运转化功大法，拿出一种毒药，吸取其毒力......\n" NOR);
  message_vision("" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -500);
  me->start_busy(2);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/xingxiu", 1);
    me->add("family_score", 1);
    tell_object(me, HIB "你突然醒悟道：" HIY "原来抽髓掌的毒功竟然可以如此霸道" HIR "！\n" NOR);
    tell_object(me, HIB "恭喜你融汇贯通了星宿派武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在星宿逍遥洞炼制百毒，居然练成了毒仙炎！\n" NOR,
      users()
    );
  }
  return 1;
}
