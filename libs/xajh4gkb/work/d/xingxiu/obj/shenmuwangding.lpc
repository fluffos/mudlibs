// item: /d/xingxiu/npc/obj/fire.c
// Jay 3/17/96
inherit ITEM;
void create() {
  set_name(HIB "神木王鼎" NOR, ({ "shenmu wangding", "ding" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是星宿三宝之首，乃丁春秋修炼化功大法之物。\n");
    set("unit", "只");
    set("value", 1000000);
  }
}
int query_autoload() { return 1; }
