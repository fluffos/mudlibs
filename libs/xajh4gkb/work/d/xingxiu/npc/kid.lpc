// kid.c
inherit NPC;
void create()
{
	int jibie;
	jibie = 30;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
    set_name("小孩",({ "kid" }) );
        set("gender", "男性" );
        set("age", 7);
        set("long", "这是个维吾尔族小孩子。\n");
        set("combat_exp", 50);
    set("shen_type", 1);
    set("str", 11);
    set("dex", 11);
    set("con", 11);
    set("int", 11);
        set("attitude", "friendly");
        setup();
    carry_object("d/xingxiu/obj/wcloth")->wear();
}
