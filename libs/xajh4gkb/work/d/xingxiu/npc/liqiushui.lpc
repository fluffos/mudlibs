// /NPC liqiushui.c
#include <ansi.h>
inherit NPC;

void create()
{
	int jibie;
	jibie = 7000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 0); 
    set_name("李秋水", ({ "li qiushui", "qiushui", "li" }));
    set("long",
        "她本是逍遥子的三弟子，与巫行云、无崖子同门为师.\n"+
        "眉目甚美，声音甚是轻柔婉转，身形苗条婀娜，轻风动裾，飘飘若仙.\n"+
        "然同门三人爱恨纠葛，因爱成恨.\n");
    set("title", "西夏太妃");
    set("gender", "女性");
    set("age", 96);
    set("attitude", "peaceful");
    set("str", 90);
    set("int", 65);
    set("con", 60);
    set("dex", 250);
    set("qi", 2000000);
    set("max_qi", 2000000);
    set("jing", 2000000);
    set("max_jing", 2000000);
    set("jingli", 300000);
    set("max_jingli", 300000);
    set("neili", 3000000);
    set("max_neili", 700000);
    set("wuyongjiali", 15000);
     set("combat_exp", 90000000);

    set("score", 200000);
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("sword",500+jibie/3+random(jibie/5));
    set_skill("zhemei-shou",500+jibie/3+random(jibie/5));
    set_skill("liuyang-zhang",500+jibie/3+random(jibie/5));
    set_skill("mingwang-jian",500+jibie/3+random(jibie/5));
    set_skill("shenkong-xing",500+jibie/3+random(jibie/5));
    set_skill("xiaowuxiang", 500+jibie/3+random(jibie/5));
    map_skill("force", "xiaowuxiang");
    map_skill("dodge", "shenkong-xing");
    map_skill("unarmed", "zhemei-shou");
    map_skill("parry", "liuyang-zhang");
    map_skill("sword", "mingwang-jian");
 //   create_family("灵鹫宫",1, "开山祖师");
				   
    setup();
    carry_object("/d/lingjiu/obj/qingyi")->wear();
    carry_object("/d/lingjiu/obj/doupeng")->wear();
    carry_object("/clone/weapon/changjian")->wield();
}

//灵鹫宫解密
void die()
{
    object me;        
    me = query_temp("last_damage_from");
	if (me && (string)me->query("family/family_name") == "灵鹫宫" && me->query("family/master_id")=="tong lao" && me->query_temp("jm_lingjiu1"))
	{
		tell_room(environment(this_player()), "李秋水大笑道：巫行云修炼那八荒功永远也不可能与师兄在一起了。\n");
		tell_room(environment(this_player()), "李秋水怒道：这辈子我当杀尽灵鹫宫中人.....．\n");
		tell_room(environment(this_player()), "李秋水恶斗一番后，力竭而死......回光返照之际，喃喃自语道：师兄，你究竟爱过我没有？\n");
		me->set_temp("jm_lingjiu3",1);
	}
	::die();
}
//逍遥派解密
int accept_object(object me, object ob)
{
	object monk, room;
	if(!( room = find_object("/d/xingxiu/tianyahaige")) ) room = load_object("/d/xingxiu/tianyahaige");
	monk = present("li qiushui", room);
	if ( (string)ob->query("id") =="hua xiang" )
	{
		if ( (string)me->query("family/family_name") == "逍遥派" && me->query("family/master_id")=="wuya zi" && me->query("id")==ob->query("owner") )
		{
			message_vision(HIC"李秋水笑道：师兄始终还是爱我多一点。\n"NOR, this_object(),me);
			message_vision(HIC"李秋水盯着画像看了一会，脸色愈发暗了下来，一时阴晴不定...\n"NOR, this_object(),me);
			message_vision(HIC"不一会，李秋水将画像撕成粉碎......\n"NOR, this_object(),me);
			if (me->query_temp("jm_xiaoyao7")) 
			{
				message_vision(HIG"李秋水神情大变，一会哭一会笑！！！\n"NOR, this_object(),me);
				me->set_temp("jm_xiaoyao8",1);
			}
			message_vision(HIC"李秋水突然拔出长剑大怒道："+RANK_D->query_respect(me)+"，今日我想杀人！！！\n"NOR, this_object(),me);
			room->delete("exits");
			if (!me->is_busy()) me->start_busy(1);
			if (monk) monk->kill_ob(me);
			call_out("do_back", 60, me );
			return 1;
		} else
		{
			message_vision("$N对$n说道：多谢这位"+RANK_D->query_respect(me)+"，这本画像我就收起来了。\n",this_object(),me);
			return 1;
		}
	}	
	return 0;
}
int do_back(object me)
{
	object monk, room;
	if(!( room = find_object("/d/xingxiu/tianyahaige")) ) room = load_object("/d/xingxiu/tianyahaige");
	monk = present("li qiushui", room);
	room->set("exits/southeast", "/d/xingxiu/tianroad6");
	return 1;
}
