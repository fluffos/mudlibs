// Room: /city/mingren.c
// YZC 1995/12/04 

#include <room.h>

inherit ROOM;
string look_shu();

void create()
{
	set("short", "名人堂");
	set("long", @LONG
这里就是江湖行一百的名人堂。在这里供奉的有大侠，也有魔头，	
也有不是大侠不是魔头的玩家。无论是哪一位，都曾冠绝一时，都有
一个长长而惊心动魄的故事，每一个故事都曾很深远地影响了一代甚
至两三代玩家。
    虽然他们都曾经轰轰烈烈掀起满江湖的风雨，如今，他们再也不
会在江湖出现了。他们都已经退出江湖，但他们的侠影魔踪很长时间
以后仍是一个传说。在这里，你可以选择加入（正派、邪派、中立）
三大阵营，再现英雄们的昔日荣光。
指令格式：join|jiaru <正派/邪派/中立>。

	天下风云出我辈， 一入江湖岁月催； 
	皇图霸业谈笑间， 不胜人生一场醉。 
	提剑跨骑挥鬼雨， 白骨如山鸟惊飞; 
	尘事如潮人如水， 只叹江湖几人回。
	
LONG );

set("no_fight", "1");      	
	set("no_steal", "1");
	set("no_beg", "1");
	set("no_sleep_room", "1");
	set("no_clean_up", 0);

	set("exits", ([
"down" : __DIR__"shijian",	
	]));
	set("objects", ([
		"/d/npc/bai" : 1,               	
//		"/quest/fyue" : 1,    //2018.5.27阿飞改，换个位置                   	
	]));
	setup();
	replace_program(ROOM); 
}

void init()
{
	add_action("do_join","join");
	add_action("do_join","jiaru");
}

int do_join(string arg)
{
	object me=this_player();

	if( !arg || (arg!="正派" && arg!="邪派" && arg!="中立"))
	{
		write(HIY"指令格式：join|jiaru <正派/邪派/中立>。\n"NOR);
		return 1;
	}
	if( me->query("camp"))
	{
		tell_object(me,HIR"你已经加入阵营了，难道你想叛投敌方？\n"NOR);
		return 1;
	}	
	if(me && arg=="正派")
	{
		tell_object(me,HIC"你对行侠仗义的江湖生活十分向往，想也不想就加入了正派。\n"NOR);
		me->set("camp","正派");
	}
	if(me && arg=="邪派")
	{
		tell_object(me,HIC"你立志成为人人害怕的大魔头，不假思索就加入了邪派。\n"NOR);
		me->set("camp","邪派");
	}
	if(me && arg=="中立")
	{
		tell_object(me,HIC"你对江湖上打打杀杀日子十分厌倦，还是做一个游戏人间的中立派吧。\n"NOR);
		me->set("camp","中立");
	}		

	return 1;
}