int do_zhu(string arg)
{
	object me,obj;
	int w_level;
	me = this_player();
	w_level = (int)me->query("weapon/lv");
	
	if(!me->query("weapon/make") )
		return notify_fail("你都没有造兵器，重铸什么！\n");

	if ( !me->query_temp("rename/重铸兵器", 1) )
	{
		command("heihei");
		command("say 想重新打造武器，先去找个极品材料来，没有？别来烦我。");
		return 1;
	}
	if( !arg )
		return notify_fail("天神阿飞认真的说：把你现在的兵器给我看看。\n");
	message("vision",me->name()+"对天神阿飞轻声说了几句。\n",environment(me), ({me}) );
	
    switch (arg) 
	{
	case "my sword" :
		obj=present("my sword",me);
		if (!obj) return notify_fail("你是作死吗，竟敢糊弄天神！\n");
		if(obj->query("equipped")) return notify_fail("你正装备着呢！\n");
		me->delete("weapon");
		me->delete("diablo/sword");
		destruct(obj);
		me->add("score",w_level*(w_level-1)/2*100+100);
		me->add("potential",w_level*(w_level-1)/2*10000+10000);
        message("vision","我已经把你的武器销毁了，并返还了锻造武器的阅历和潜能，你可以找欧冶子重新打造一把武器。\n",me);
        break;
	case "my blade" :
		obj=present("my blade",me);
		if (!obj) return notify_fail("你是作死吗，竟敢糊弄天神！\n");
		if(obj->query("equipped")) return notify_fail("你正装备着呢！\n");
		me->delete("weapon");
		me->delete("diablo/blade");
		destruct(obj);
		me->add("score",w_level*(w_level-1)/2*100+100);
		me->add("potential",w_level*(w_level-1)/2*10000+10000);
        message("vision","我已经把你的武器销毁了，并返还了锻造武器的阅历和潜能，你可以找欧冶子重新打造一把武器。\n",me);
        break;
	case "my club" :
		obj=present("my club",me);
		if (!obj) return notify_fail("你是作死吗，竟敢糊弄天神！\n");
		if(obj->query("equipped")) return notify_fail("你正装备着呢！\n");
		me->delete("weapon");
		me->delete("diablo/club");
		destruct(obj);
		me->add("score",w_level*(w_level-1)/2*100+100);
		me->add("potential",w_level*(w_level-1)/2*10000+10000);
        message("vision","我已经把你的武器销毁了，并返还了锻造武器的阅历和潜能，你可以找欧冶子重新打造一把武器。\n",me);
        break;
	case "my staff" :
		obj=present("my staff",me);
		if (!obj) return notify_fail("你是作死吗，竟敢糊弄天神！\n");
		if(obj->query("equipped")) return notify_fail("你正装备着呢！\n");
		me->delete("weapon");
		me->delete("diablo/staff");
		destruct(obj);
		me->add("score",w_level*(w_level-1)/2*100+100);
		me->add("potential",w_level*(w_level-1)/2*10000+10000);
        message("vision","我已经把你的武器销毁了，并返还了锻造武器的阅历和潜能，你可以找欧冶子重新打造一把武器。\n",me);
        break;
	case "my whip" :
		obj=present("my whip",me);
		if (!obj) return notify_fail("你是作死吗，竟敢糊弄天神！\n");
		if(obj->query("equipped")) return notify_fail("你正装备着呢！\n");
		me->delete("weapon");
		me->delete("diablo/whip");
		destruct(obj);
		me->add("score",w_level*(w_level-1)/2*100+100);
		me->add("potential",w_level*(w_level-1)/2*10000+10000);
        message("vision","我已经把你的武器销毁了，并返还了锻造武器的阅历和潜能，你可以找欧冶子重新打造一把武器。\n",me);
        break;
	case "my axe" :
		obj=present("my axe",me);
		if (!obj) return notify_fail("你是作死吗，竟敢糊弄天神！\n");
		if(obj->query("equipped")) return notify_fail("你正装备着呢！\n");
		me->delete("weapon");
		me->delete("diablo/axe");
		destruct(obj);
		me->add("score",w_level*(w_level-1)/2*100+100);
		me->add("potential",w_level*(w_level-1)/2*10000+10000);
        message("vision","我已经把你的武器销毁了，并返还了锻造武器的阅历和潜能，你可以找欧冶子重新打造一把武器。\n",me);
        break;
	case "my hammer" :
		obj=present("my hammer",me);
		if (!obj) return notify_fail("你是作死吗，竟敢糊弄天神！\n");
		if(obj->query("equipped")) return notify_fail("你正装备着呢！\n");
		me->delete("weapon");
		me->delete("diablo/hammer");
		destruct(obj);
		me->add("score",w_level*(w_level-1)/2*100+100);
		me->add("potential",w_level*(w_level-1)/2*10000+10000);
        message("vision","我已经把你的武器销毁了，并返还了锻造武器的阅历和潜能，你可以找欧冶子重新打造一把武器。\n",me);
        break;
	case "my spear" :
		obj=present("my spear",me);
		if (!obj) return notify_fail("你是作死吗，竟敢糊弄天神！\n");
		if(obj->query("equipped")) return notify_fail("你正装备着呢！\n");
		me->delete("weapon");
		me->delete("diablo/spear");
		destruct(obj);
		me->add("score",w_level*(w_level-1)/2*100+100);
		me->add("potential",w_level*(w_level-1)/2*10000+10000);
        message("vision","我已经把你的武器销毁了，并返还了锻造武器的阅历和潜能，你可以找欧冶子重新打造一把武器。\n",me);
        break;
	case "my fork" :
		obj=present("my fork",me);
		if (!obj) return notify_fail("你是作死吗，竟敢糊弄天神！\n");
		if(obj->query("equipped")) return notify_fail("你正装备着呢！\n");
		me->delete("weapon");
		me->delete("diablo/fork");
		destruct(obj);
		me->add("score",w_level*(w_level-1)/2*100+100);
		me->add("potential",w_level*(w_level-1)/2*10000+10000);
        message("vision","我已经把你的武器销毁了，并返还了锻造武器的阅历和潜能，你可以找欧冶子重新打造一把武器。\n",me);
        break;
	case "my dagger" :
		obj=present("my dagger",me);
		if (!obj) return notify_fail("你是作死吗，竟敢糊弄天神！\n");
		if(obj->query("equipped")) return notify_fail("你正装备着呢！\n");
		me->delete("weapon");
		me->delete("diablo/dagger");
		destruct(obj);
		me->add("score",w_level*(w_level-1)/2*100+100);
		me->add("potential",w_level*(w_level-1)/2*10000+10000);
        message("vision","我已经把你的武器销毁了，并返还了锻造武器的阅历和潜能，你可以找欧冶子重新打造一把武器。\n",me);
        break;
	default :
        message_vision(HIC "天神阿飞一脸狐疑：什么兵器？\n" NOR,me);
        return notify_fail("天神阿飞仔细的说：此事不可儿戏，请慎重!!\n");
		break;
    }
    me->save();

    return 1;
}

int accept_object(object who, object ob)
{
	if ( ob->query("id")!="zuiyue xuanjing" )
	{
		command("say 这玩艺我可没啥兴趣！");
		return 0;
	}	
	command("say 好东西，有了这个东西，我可以替你销毁自练兵器，并返还阅历和潜能！");
	who->set_temp("rename/重铸兵器", 1);
	return 1;
}