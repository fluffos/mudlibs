string ask_rename()
{
	object ob=this_player();
    write(HIC"我这儿可以重铸自练武器，请将你的自练武器给我一观。\n"NOR);       
    return "这位"+RANK_D->query_respect(ob)+"是否确定要重铸武器？决定了告诉我(show)。\n";
}

