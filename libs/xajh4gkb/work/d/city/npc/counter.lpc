// d/city/npc/counter 
inherit NPC;
#include <ansi.h>
inherit F_MASTER;

string ask_shengri();
string ask_rename();
//string ask_suit();
void create()
{
	int jibie;
	jibie = 10000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
	set_name(HIW"天神阿飞"NOR, ( { "afei tianshen", "afei", "tianshen"}));
	set("title", HIY"天下无敌"NOR);
	set("nickname", HIC"开天辟地"NOR);
	set("str", 37);
	set("gender", "男性");
	set("age", 23);
	set("per",30);
	set("long","传说中江湖中最有钱的人，谁也不知道他的钱都从哪儿来的，只知道江湖上很多人都在偷偷的摩拳擦掌地打听他的消息，却从来不愿意透露原因，甚至从来没有人承认自己见过他。\n");
	set("no_get",1);
	set("no_suck",1);
	set("attitude", "friendly");
	set("max_qi",100000000);
	set("combat_exp",500000000+random(300000000));
//	set("xyzx_sys/level", 3000000000);
	set("max_jing",100000000);
	set("neili", 50000000);
	set("max_neili", 50000000);
	set_skill("qimen-wuxing", 1000+jibie/3+random(jibie/5));
	set_skill("qufeng", 1000+jibie/3+random(jibie/5));
	set_skill("art", 1000+jibie/3+random(jibie/5));
	set_skill("taoism", 1000+jibie/3+random(jibie/5));
	set_skill("force", 1000+jibie/3+random(jibie/5));
	set_skill("dodge", 1000+jibie/3+random(jibie/5));
	set_skill("sword", 1000+jibie/3+random(jibie/5));
	set_skill("parry", 1000+jibie/3+random(jibie/5));
	set_skill("unarmed", 1000+jibie/3+random(jibie/5));
	set_skill("lonely-sword", 1000+jibie/3+random(jibie/5));
	set_skill("dugu-jiujian", 1000+jibie/3+random(jibie/5));
	set_skill("jiuyin-baiguzhao", 1000+jibie/3+random(jibie/5));
	set_skill("jiuyin-zhenjing",1000+jibie/3+random(jibie/5));
	set_skill("shenxing-baibian",10000+jibie/3+random(jibie/5));
//	set_skill("king-of-dragon", 1000+jibie/3+random(jibie/5));	
	map_skill("sword", "lonely-sword");
	map_skill("parry", "dugu-jiujian");
	map_skill("force", "jiuyin-zhenjing");
	map_skill("dodge", "shenxing-baibian");
	map_skill("unarmed", "jiuyin-baiguzhao");

	set("inquiry", ([
                    "生日" : (: ask_shengri :),
					"重铸兵器":(:ask_rename:),
//					"门派套装":(:ask_suit:),
	                ]));

	setup();
	carry_object("/clone/weapon/fyue")->wield();
	carry_object("/d/automap6/obj/jia1")->wear();
}


string ask_shengri()
{
	int birthday,answer;
    object me;
    me=this_player();

	if(me->query("more_money")<10) 
	{
		message_vision(CYN"$N说道：这可是得罪东方MM的冒风险的事儿，阁下的“诚意”似乎不够吧。。。\n"NOR,me);
		message_vision("$N摇了摇头，道：“愚不可及.....”说完伸手一指$n。\n",me);
		me->unconcious();
	}
	else
	{
		me->add("more_money",-10);
		birthday=me->query("birthday");
		answer=birthday%90+10;
		message_vision(HIC"阿飞天神沉吟了一下，说：据说东方MM最近的幸运数字是"+CHINESE_D->chinese_number(answer)+"了，八成没错。 \n"NOR ,me);
		message_vision(YEL"阿飞天神高兴地拍了拍"+this_player()->name()+"的头，你可得记好了。 \n" ,me);
		command("heihei");
		command("smash");
	}
	return "今天这事可千万别告诉东方MM。\n";
}



