// guanjia.c 财主管家
inherit NPC;
void create()
{
	int jibie;
	jibie = 100;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
	set_name("管家", ({ "guan jia", "guan" }));
	set("gender", "男性");
	set("age", 65);
	set("combat_exp", 7500);
        set_skill("unarmed", 500+jibie/3+random(jibie/5));
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_temp("apply/attack", 30);
        set_temp("apply/defense", 40);
	set("shen_type", -1);
	setup();
	carry_object("/clone/cloth/changpao")->wear();
       add_money("silver",50);
}
	
