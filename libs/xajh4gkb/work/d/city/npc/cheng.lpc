// cheng.c 程药发

#include <ansi.h>
inherit NPC;

int do_zhuibu();

void create() {
  int jibie;
  jibie = 300;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set_name("程药发", ({ "cheng yaofa", "cheng" }));
  set("title", "扬州知府");
  set("gender", "男性");
  set("age", 43);
  set("str", 40);
  set("dex", 20);
  set("long", "他就是程药发，扬州现任知府。\n");
  set("combat_exp", 30000);
  set("shen_type", 0);
  set("attitude", "heroism");
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/armor", 50);
  set_temp("apply/damage", 15);
  set("neili", 500);
  set("max_neili", 500);
  set("wuyongjiali", 10);
  set("inquiry", ([
    "追捕": (: do_zhuibu :),
  ]));

  setup();
  carry_object("clone/weapon/gangjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}

int do_zhuibu() {
  string *quest_short = ({
    "南阳 汉水南岸",
    "南阳 汉水北岸",
    "北京 西长安街",
    "南阳 汝州城",
    "北京 西门",
    "华山村 东村口",
    "华山村 碎石路",
    "泉州 海港",
    "泉州 北门",
    "泉州 武夷山路",
    "泉州 嘉兴南门",
    "扬州 南大街",
    "泰山 岱宗坊",
    "泰山 一天门",
    "泰山 石经峪",
    "北京 海港",
    "星宿海 六盘山",
    "星宿海 丝绸之路",
    "武当 黄土路",
    "星宿海 天山脚下",
    "星宿海 北疆小镇",
    "星宿海 赛马场",
    "华山 玉女峰",
    "华山 镇岳宫",
    "华山 猢狲愁",
    "华山 青柯坪",
    "华山 玉泉院",
  });
  string *quest_place = ({
    "/d/nanyang/hanshui1",
    "/d/nanyang/hanshui2",
    "/d/city2/xichang1",
    "/d/nanyang/ruzhou",
    "/d/city2/ximen",
    "/d/village/eexit",
    "/d/village/eroad2",
    "/d/quanzhou/haigang",
    "/d/quanzhou/beimen",
    "/d/quanzhou/qzroad5",
    "/d/quanzhou/jxnanmen",
    "/d/city/nandajie1",
    "/d/taishan/daizong",
    "/d/taishan/yitian",
    "/d/taishan/shijin",
    "/d/city2/haigang",
    "/d/xingxiu/xxroad3",
    "/d/xingxiu/silk1",
    "/d/wudang/wdroad7",
    "/d/xingxiu/shanjiao",
    "/d/xingxiu/beijiang",
    "/d/xingxiu/saimachang",
    "/d/huashan/yunu",
    "/d/huashan/zhenyue",
    "/d/huashan/husun",
    "/d/huashan/qingke",
    "/d/huashan/yuquan",
  });

  object obj, ob = this_player();
  int exp, index;
  exp = ob->query("xyzx_sys/level", 1);
  index = random(sizeof(quest_short));

  if (environment(this_object())->query("short") != "衙门正厅")
    return notify_fail("这里不是衙门，你有事回衙门再说吧？");
  if (ob->is_busy() || ob->query_temp("pending/exercising"))
    return notify_fail("你现在正忙着呢。\n");
  if (ob->query_condition("in_zhuibu"))
    return notify_fail("你不是己经在追捕了吗？ 如果你不想干，就放弃吧。\n");

  if (exp < 100000) {
    if (exp > 5000) obj = new("/quest/quest2/dawang");
    else if (exp > 2000) obj = new("/quest/quest2/qinfan");
    else if (exp > 1000) obj = new("/quest/quest2/dadao");
    else if (exp > 300) obj = new("/quest/quest2/zei");
    else if (exp > 1) obj = new("/quest/quest2/thief");
    else {
      command("pat " + ob->query("id"));
      message_vision("程药发说道：你年纪还小，大人的事怎么能做呢？\n", ob);
      return 1;
    }
    obj->set("no_dun", 1);
    obj->move(quest_place[index]);
    ob->start_busy(1);
    ob->set("oldtitle", ob->query("title"));
    ob->set("title", HIY "扬州衙门捕快" NOR);
    ob->set_temp("zhuibu_renwu", 1);
    ob->set_temp("zhuibu_renwu/quest_id", obj->query("id"));
    ob->set_temp("zhuibu_renwu/quest_name", obj->query("name"));
    message_vision(YEL "$N已被委任为衙门捕快。\n" NOR, ob);
    remove_call_out("destrory");
    call_out("destrory", 150, obj);
    message_vision(
      "程药发说道：" + obj->short() + "从扬州监狱逃跑，听闻其踪迹在【" + quest_short[index] + "】出现，速去将其追捕归案，时间久了可不行！\n",
      ob
    );
    return 1;
  } else {
    message_vision("程药发说道：这种小事怎敢劳您大驾？\n", ob);
    return 1;
  }
}

int accept_object(object me, object obj) {
  int exp, pot, addtime, huiyuan, renwu_exp_add;
  if (!me || environment(me) != environment()) return 0;
  if (!objectp(obj)) return 0;
  if (!present(obj, me)) { say("你没有这件东西。\n"); return 0; }

  if (me->query("xyhy_type") == 2) huiyuan = 5 / 4;  //黄金会员打坐增加技能熟练度1.25倍
  else huiyuan = 1;
  if (me->query_exp_times() > 1) addtime = 2;  //双倍经验
  else addtime = 1;
  if (me->query_temp("renwu_exp_add")) renwu_exp_add = (int)me->query_temp("renwu_exp_add", 1);  //处于任务经验提升状态时	

  if (me->query_temp("zhuibu_renwu")) {
    if (obj->query("id") == me->query_temp("zhuibu_renwu/quest_id")) {
      command("nod");
      command("say 很好很好，这是你的奖赏。\n");
      me->set("title", me->query("oldtitle"));
      exp = (me->query_temp("zhuibu_renwu/num") * 5000 + random(10000)) * addtime * huiyuan * (renwu_exp_add + 100) / 100;
      pot = (me->query_temp("zhuibu_renwu/num") * 1000 + random(2000)) * addtime * huiyuan * (renwu_exp_add + 100) / 100;
      me->add("combat_exp", exp);
      me->add("potential", pot);
      tell_object(me, sprintf("你得到了%s点经验，%s点潜能。\n", chinese_number(exp), chinese_number(pot)));
      me->delete("oldtitle");
      me->delete_temp("zhuibu_renwu");
      me->add("renwu/zhuibu_renwu", 1);
      //2018.4.28阿飞添加  国庆节活动--扬州知府追捕任务10次
      if ((int)me->query("jieri_gift/guoqing")) me->add_temp("guoqing/zhuibu", 1);
      if ((int)me->query_temp("guoqing/zhuibu") >= 10) {
        me->set_temp("guoqing/zhuibu", 10);
        tell_object(me, HIW "你在国庆节期间，维护治安发扬为人无服务精神，乃众人楷模！\n" NOR);
      }
      return 1;
    } else {
      command("heng");
      command("say 想滥竽充数，来人啦，给我打！\n");
      message_vision("四周衙役凶神恶刹般拥过来，围住你一顿痛打......\n", me);
      me->set("title", me->query("oldtitle"));
      me->delete("oldtitle");
      me->delete_temp("zhuibu_renwu");
      me->set_temp("summon_time", time());
      me->move("/d/city/jianyu");
      return 0;
    }
  } else {
    command("say 你好象还没什么任务吧，\n");
    return 0;
  }
}

void destrory(object ob) {
  destruct(ob);
  return;
}
