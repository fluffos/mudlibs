// yingying.c 崔莺莺
inherit NPC;
void create() {
  int jibie;
  jibie = 60;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set_name("崔莺莺", ({ "cui yingying", "cui", "ying" }));
  set("long", "她长得极美，尤其是那对眼睛，媚得直可以勾人魂魄。\n");
  set("title", "财主女儿");
  set("gender", "女性");
  set("age", 17);
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/damage", 5);
  set("combat_exp", 20000);
  set("shen_type", 1);
  setup();
  carry_object("clone/cloth/necklace")->wear();
  carry_object("clone/cloth/pink_cloth")->wear();
}
