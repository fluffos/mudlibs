// guigong.c
inherit NPC;

void create()
{
	int jibie;
	jibie = 100;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
        set_name("龟公", ({ "gui gong", "gui", "gong" }));
        set("gender", "男性");
        set("age", 25);

        set("long", "一个满脸狠肉的汉子，在丽春院日子久了，养的白白肥肥。\n");
        set("combat_exp", 30000);
        set("shen_type", 0);
        set_skill("unarmed", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set("chat_msg", ({
             "小娘皮，来了这里就乖乖地侍侯大爷们吧。",
             "想跑？跑到天涯海角都给你追回来！",
             "哼！你们这些小贱人，活该！",
        }) );
        setup();
        carry_object("clone/cloth/cloth")->wear();
}
