// by guoguo
inherit ROOM;

#include <item_sx.h>
#define MAX_LEVEL       6
#define SAVER   "/clone/misc/warehousenew"

void create()
{
    set("short","符纸仓库");
    set("long","这里是免费存放符纸的仓库，仓库的一面墙上贴着一张告示("HIW"gaoshi"NOR")\n");
    set("no_fight",1);
    set("no_steal",1);
    set("no_magic",1);
    set("no_sleep_room", "1");
    set("exits", ([
        "west" : __DIR__"openmarket",
      ]));

    set("item_desc", ([
                "gaoshi": @TEXT
                查看自己的存货：list、cha、check

                存货：cun
                        存入全部：cun all
                        存入一个：cun <符纸中文或英文名>    或者    cun <级数>

                取货：qu
                        qu <级数>
						
				符纸分类：优化符（零级），强化符（一级），附魔符（二级），灵魂符（三级），混沌符（四级），
						绑定符（五级），解绑符（六级）。


TEXT
                ]) );
    setup();
}

void init()
{
    add_action("do_list","list");
    add_action("do_list","cha");
    add_action("do_list","check");
//    add_action("do_list","查");
    add_action("do_cun","cun");
//    add_action("do_cun","存");
    add_action("do_qu","qu");
//    add_action("do_qu","取");
    add_action("do_zhuan","zhuan");
}

int do_list(string arg)
{
    object me = this_player();
    string myid = me->query("id");
    object saver;
    string filename,tmp,tmp2,user;
    int *allfu,i;

    if(arg && sizeof(arg)>0 && wizhood(me)=="(boss)")
    {
        filename = "/data/warehousenew/"+arg[0..0]+"/"+arg+__SAVE_EXTENSION__;
        user=arg;
    }
    else
    {
        filename = "/data/warehousenew/"+myid[0..0]+"/"+myid+__SAVE_EXTENSION__;
        user="你";
    }

    if(file_size(filename) == -1)
    {
        printf(user+"没在仓库里存放任何东西。\n");
        return 1;
    }
    saver = new(SAVER);
    if(!saver || !objectp(saver))
    {
        write(HIW"物件仓库创建失败。\n");
        return 1;
    }
    saver->do_load(filename);
    allfu=saver->get_youhuafu_data();
    write(user+"的符纸：\n\n");

    for(i=0;i<sizeof(allfu);i++)
    {
        tmp2=chinese_number(i);
        while(sizeof(tmp2)<6)
            tmp2="  "+tmp2;
        tmp=sprintf(YEL"%s级：%10d张\t\t"NOR,tmp2,allfu[i]);
        write(tmp);
		write("\n");
    }

    write("\n\n");
    destruct(saver);
    return 1;
}

int is_number(string arg)
{
    int i,len;
    len = sizeof(arg);
    if(len==0)
        return 0;
    for(i=0;i<len;i++)
    {
        if(arg[i]<'0' || arg[i]>'9')
            return 0;
    }
    return 1;
}
object query_present_fu(string arg)
{
    object me = this_player();
    object obj = present(arg,me);
    object *objs;
    int i,ji=0;
//	int len;	//2017.3.7阿飞记录  服务器测试有问题，该值没有定义
    string name,bnm;
    if(objectp(obj) && (base_name(obj) == "/clone/map/obj/bangding-fu" &&
                base_name(obj) == "/clone/map/obj/jiebang-fu" &&
				base_name(obj) == "/clone/map/obj/youhua-fu" &&
				base_name(obj) == "/clone/map/obj/qianghua-fu" &&
				base_name(obj) == "/clone/map/obj/fumo-fu" &&
				base_name(obj) == "/clone/map/obj/linghun-fu" &&
                base_name(obj) == "/clone/map/obj/hundun-fu"))
        return obj;
    if(sizeof(arg)<=2 && is_number(arg))
    {
        ji=atoi(arg);
        if(ji<0 || ji > MAX_LEVEL)
            return 0;
        objs = all_inventory(me);
        for(i=0;i<sizeof(objs);i++)
        {
            obj = objs[i];
            bnm = base_name(obj);
            if(bnm != "/clone/map/obj/bangding-fu" &&
                    bnm != "/clone/map/obj/jiebang-fu" &&
					bnm != "/clone/map/obj/youhua-fu" &&
					bnm != "/clone/map/obj/qianghua-fu" &&
					bnm != "/clone/map/obj/fumo-fu" &&
					bnm != "/clone/map/obj/linghun-fu" &&
                    bnm != "/clone/map/obj/hundun-fu")
                continue;
            if(obj->query("xyzx_item_level") == ji)
                return obj;
        }
    }
    else
    {
        objs = all_inventory(me);
        for(i=0;i<sizeof(objs);i++)
        {
            obj = objs[i];
            bnm = base_name(obj);
            if(bnm != "/clone/map/obj/bangding-fu" &&
                    bnm != "/clone/map/obj/jiebang-fu" &&
					bnm != "/clone/map/obj/youhua-fu" &&
					bnm != "/clone/map/obj/qianghua-fu" &&
					bnm != "/clone/map/obj/fumo-fu" &&
					bnm != "/clone/map/obj/linghun-fu" &&
                    bnm != "/clone/map/obj/hundun-fu")
                continue;
            name = filter_color(obj->query("name"));
            if(name == arg || obj->id(arg))
                return obj;
        }
    }
    return 0;
}


void save_youhuafu(object saver,string funame)
{
    object fu;
    int* allfu,ji;
    fu = query_present_fu(funame);
    if(!objectp(fu))
    {
        write("你身上没有这个东西。\n");
        return;
    }
    ji = fu->query("xyzx_item_level");
    allfu = saver->get_youhuafu_data();
    allfu[ji] = allfu[ji]+1;
    write("你把一张"+fu->query("name")+"存到仓库里。\n");
    destruct(fu);
}

void save_all_youhuafu(object saver)
{
    object me = this_player();
    object *objs,obj;
    int i,ji,n=0;
//	int idx,amount,total,jie;	//2017.3.7阿飞记录  服务器测试有问题，该值没有定义
    int *allfu;
    string bnm;
    allfu = saver->get_youhuafu_data();
    objs = all_inventory(me);
    for(i=0;i<sizeof(objs);i++)
    {
        obj = objs[i];
        bnm = base_name(obj);
            if(bnm != "/clone/map/obj/bangding-fu" &&
                    bnm != "/clone/map/obj/jiebang-fu" &&
					bnm != "/clone/map/obj/youhua-fu" &&
					bnm != "/clone/map/obj/qianghua-fu" &&
					bnm != "/clone/map/obj/fumo-fu" &&
					bnm != "/clone/map/obj/linghun-fu" &&
                    bnm != "/clone/map/obj/hundun-fu")
                continue;
        ji = obj->query("xyzx_item_level");
        allfu[ji] = allfu[ji]+1;
        write("你把一张"+obj->query("name")+"存到仓库里。\n");
        destruct(obj);
        n++;
    }
    if(n==0)
        write("你身上没有符纸。\n");
}

int do_cun(string arg)
{
    object me = this_player();
    string myid = me->query("id");
    object saver;
    string filename = "/data/warehousenew/"+myid[0..0]+"/"+myid+__SAVE_EXTENSION__;

    if(!arg || arg == "")
    {
        write("使用方法请look gaoshi\n");
        return 1;
    }

    saver = new(SAVER);
    if(!saver || !objectp(saver))
    {
        write(HIW"物件仓库创建失败。\n");
        return 1;
    }
    if(file_size("/data/warehousenew") != -2) mkdir("/data/warehousenew");
    if(file_size("/data/warehousenew/"+myid[0..0]) != -2)
        mkdir("/data/warehousenew/"+myid[0..0]);
    saver->do_load(filename);
    if(arg == "all")
        save_all_youhuafu(saver);
    else
        save_youhuafu(saver,arg);
    saver->do_save(filename);
    destruct(saver);
    return 1;
}

int do_qu(string arg)
{
    object me = this_player();
    string myid = me->query("id");
    object saver,fu;
    int* allfu;
    int ji=0,ok=0;
    string filename = "/data/warehousenew/"+myid[0..0]+"/"+myid+__SAVE_EXTENSION__;

    if(!arg || !is_number(arg))
    {
        write("使用方法请look gaoshi\n");
        return 1;
    }

    ji=atoi(arg);
    if(ji<0 || ji > MAX_LEVEL)
    {
        write("只能是0~6级别的符\n");
        return 1;
    }
    if(file_size(filename) == -1)
    {
        write("仓库里没有任何符纸。\n");
        return 1;
    }
    saver = new(SAVER);
    if(!saver || !objectp(saver))
    {
        write(HIW"物件仓库创建失败。\n");
        return 1;
    }
	
    saver->do_load(filename);
    allfu=saver->get_youhuafu_data();
    if(allfu[ji]>0)
    {	       
        allfu[ji] = allfu[ji]-1;
        if (ji==0) fu = new("/clone/map/obj/youhua-fu");
		if (ji==1) fu = new("/clone/map/obj/qianghua-fu");
		if (ji==2) fu = new("/clone/map/obj/fumo-fu");
		if (ji==3) fu = new("/clone/map/obj/linghun-fu");
		if (ji==4) fu = new("/clone/map/obj/hundun-fu");
		if (ji==5) fu = new("/clone/map/obj/bangding-fu");
		if (ji==6) fu = new("/clone/map/obj/jiebang-fu");
		fu->set("xyzx_item_level",ji);
        write("你从仓库里取出一张"+fu->query("name")+"\n");
        fu->move(me);
        ok=1;	
	}
	else
		printf("你的仓库里没有%s级符纸。\n",chinese_number(ji));
			

    if(ok==1)
        saver->do_save(filename);
    destruct(saver);
    return 1;
}
