// main.c 陈家洛

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

int ask_fanqing();
string ask_ling();
int count = 1;

void create() {
  int jibie;
  jibie = 4000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("陈家洛", ({ "chen jialuo", "chen", "jialuo" }));
  set("nickname", HIR "落花神剑" NOR);
  set("long",
    "他就是天下闻名的红花会的总舵主陈家洛\n"
    "身穿一件干干净净的青色长袍。\n"
    "他看起来二十来岁，身材瘦长，背上一把长剑令人不寒而粟\n");
  set("gender", "男性");
  create_family("红花会", 1, "总舵主");
  set("age", 22);
  set("shen_type", 1);
  set("str", 28);
  set("int", 28);
  set("con", 28);
  set("dex", 28);
  set("max_qi", 500000);
  set("max_jing", 150000);
  set("neili", 5000000);
  set("max_neili", 5000);
  set("wuyongjiali", 15000);
  set("combat_exp", 1500000000);
  set("score", 700000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("honghua-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("youlong-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("baihua-cuoquan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("luohua-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "honghua-shengong");
  map_skill("dodge", "youlong-shenfa");
  map_skill("unarmed", "baihua-cuoquan");
  map_skill("parry", "luohua-jian");
  map_skill("sword", "luohua-jian");

  set("inquiry", ([
    "红花会": "\n我红花会乃天下第一大帮，专与清狗作对，哈...哈......\n",
    "反清复明": (: ask_fanqing :),
  ]));

  set("chat_chance", 10);         // 随机动作概率 10%
  set("chat_msg", ({
    "陈家洛叹了一口气道：唉....想不到乾隆竟是我兄弟，这可如何是好？\n",
    "陈家洛恨声说道：我们汉人的江山，一定要从满清手中夺回来\n",
    "陈家洛说道：这位兄弟，可要加入我们红花会吗？\n",
    "陈家洛说道：你敢惹我，追到天涯海角我都要杀了你！\n",
  }));

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/wudang/obj/greyrobe")->wear();

}

void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < 500000) {
    command("say 红花会中皆是敢作敢当的好汉子，你这小贼也想混进来么？");
    command("say 想要加入红花会" + RANK_D->query_respect(ob) + "你先去杀几个清狗再说！");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，难以承担我会反清复明的重任。");
    return;
  }
  if ((int)ob->query("int", 1) < 30) {
    command("say 这位" + RANK_D->query_respect(ob) + "的悟性太差了，恐怕难以领悟红花十三剑。");
    return;
  }
  if (ob->query_skill("honghua-shengong", 1) < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "对红花会的入门内功似乎领会的不够。");
    return;
  }
  command("say 在下对" + RANK_D->query_respect(ob) + "已是神交已久，从今而后咱们就是一家人了！");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "taoist") ob->set("class", "taoist");
  return;
}

void init() {
  object ob;

  ::init();
  ob = this_player();
  if ((int)ob->query("shen") < -1000 && ob->query("family/master_id") == "chen jialuo") {
    command("chat " + ob->query("name") + "!你这等邪恶奸诈之徒，我岂能仍是你的师傅。\n");
    //		command("expell "+ ob->query("id"));
    //		ob->add("betrayer", 1);
    //		this_player()->set("title","红花会" + RED + "弃徒" NOR);
  }
  add_action("do_say", "say");
}

int do_say(string arg) {

  if (!arg || arg == "") return 0;
  if (arg == "青叶红花白莲藕") {
    write("陈家洛说道：天下英雄是一家\n");
    message("vision", "原来是自家弟兄，不知有何见教？\n", this_player());
    set("inquiry", ([
      "红花令": (: ask_ling :),
      "红花会": "\n我红花会乃天下第一大帮，专与清狗作对，哈...哈......\n",
      "反清复明": (: ask_fanqing :),
    ]));
  }
}

string ask_ling() {
  object ob, me, obj;
  if (count == 0) return "红花令已经传出去了！\n";
  message_vision(HIR "陈家洛说道：“想要红花令吗？，先接我三招！\n" NOR, this_player());
  ob = this_object();
  me = this_player();
  ob->add_temp("apply/strength", 10000);
  ob->add_temp("apply/attack", 10000);
  me->add_temp("apply/parry", -10000);
  me->add_temp("apply/dodge", -10000);
  COMBAT_D->do_attack(ob, me, query_temp("weapon"));
  COMBAT_D->do_attack(ob, me, query_temp("weapon"));
  COMBAT_D->do_attack(ob, me, query_temp("weapon"));
  ob->add_temp("apply/strength", -10000);
  ob->add_temp("apply/attack", -10000);
  me->add_temp("apply/parry", 10000);
  me->add_temp("apply/dodge", 10000);
  me->set_temp("fighter", 1);  //这个可能是其他任务的标记
  ob->fight_ob(me);
  me->fight_ob(ob);
  command("halt");

  if (((int)me->query("qi") * 100 / (int)me->query("max_qi")) >= 30) {
    obj = new("/d/honghua/obj/honghua-ling");
    obj->move(this_player());
    me->set_temp("jm_honghua1", 1);
    count = 0;
    message_vision(HIY "陈家洛交给$N一支红花令!\n" NOR, me);
    return "好，这支红花令兄弟你要好好保管！\n";
  } else {
    return "你这样武功怎能掌管红花令？";
  }
}

int ask_fanqing() {
  object me, ob;
  me = this_player();
  ob = this_object();

  if ((string)me->query("family/family_name") == "红花会" && me->query_temp("jm_honghua2")) {
    message_vision(HIB "陈家洛说道：这位" + RANK_D->query_respect(me) + "忠勇可嘉，当为我辈之楷模。\n" NOR, me);
    message_vision(HIC "陈家洛仰天大笑：这乾隆狗贼，终于有此报应。。。。。。” \n" NOR, me);
    message_vision(
      HIW "陈家洛说道：这位" + RANK_D->query_respect(me) + "为红花会立下大功，可去天地会密室看看，或许能领悟到什么。” \n" NOR,
      me
    );
    me->set_temp("jm_honghua3", 1);
  } else {
    message_vision(YEL "陈家洛冷哼一声！！！我会弟子反清复明，当前仆后继......若你能取来乾隆狗头......\n", me);
    message_vision(HIB "陈家洛说道：这位" + RANK_D->query_respect(me) + "若想铲除乾隆，可向我申请红花令。\n" NOR, me);
  }

  return 1;
}

int accept_object(object me, object ob) {
  if ((string)ob->query("id") == "qianlong rentou") {
    if ((int)me->query_temp("jm_honghua1") && me->query("family/master_id") == "chen jialuo" && me->query("id") == ob->query("owner")) {
      message_vision("$N对$n说道：哈哈哈！这狗皇帝杀我会中之人，总算是死掉了。\n", this_object(), me);
      message_vision("$N对$n说道：今日铲除了满清皇帝，我汉人当自强。\n", this_object(), me);
      message_vision("$N对$n说道：吾徒果然有本事，也不枉会中之人苦心教导.........\n", this_object(), me);
      me->set_temp("jm_honghua2", 1);
      return 1;
    } else {
      message_vision("$N对$n说道：这乾隆狗贼多次屠杀汉人，迟早都是要死的。\n", this_object(), me);
      return 1;
    }
  }
  return 0;
}

void die() {
  object me, ob;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "神龙教" && me->query_temp("jm_shenlong1")) {
    tell_room(environment(this_player()), "洪安通说道：今日剿灭天地会余孽，必能取得小皇帝的信任！！！\n");
    tell_room(environment(this_player()), "陈家洛醒悟道：狗贼，你居然投靠了鞑子皇帝！！！\n");
    tell_room(environment(this_player()), "陈家洛惨嚎一声，倒在地上，口吐鲜血，死不瞑目.....．\n");
    me->set_temp("jm_shenlong3", 1);
  }
  if (me && (string)me->query("family/family_name") == "舞蝶仙" && me->query_temp("jm_wudie2")) {
    ob = new("d/honghua/obj/rentou");
    ob->set("owner", me->query("id"));  //设定识别
    ob->move(environment(this_object()));
    ob->set("long", "红花会总舵主，看起来英俊潇洒，只是，目前已经没有了头颅。\n");
    tell_room(environment(this_player()), "陈家洛倒在地上，头颅已然不见了．\n");
  }
  ::die();
}
