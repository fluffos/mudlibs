// wen-tailai.c 文泰来
inherit NPC;
inherit F_MASTER;
#include <ansi.h>

string ask_me();

void create()

{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
    set_name("文泰来", ({ "wen tailai", "wen" }));
    set("nickname", HIM"奔雷手"NOR);
    set("long", 
                "他是红花会的四哥文泰来，\n"
        "身穿一件极为合体的青色长衫，\n"
        "他年纪好像在三十上下，身材十分槐梧，双手青筋突出，布满了老茧.\n");
        set("gender", "男性");
        create_family("红花会", 4, "弟子");
        set("age", 32);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 28);
        set("int", 28);
        set("con", 28);
        set("dex", 28);

        set("max_qi", 2000);
        set("max_jing", 1500);
        set("neili", 2400);
        set("max_neili", 2400);
        set("wuyongjiali", 100);
        set("combat_exp",800000);
        set("score", 100000);

        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("honghua-shengong", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("youlong-shenfa", 500+jibie/3+random(jibie/5));
        set_skill("unarmed", 500+jibie/3+random(jibie/5));
        set_skill("baihua-cuoquan", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("luohua-jian", 500+jibie/3+random(jibie/5));
        set_skill("literate", 500+jibie/3+random(jibie/5));

        map_skill("force", "honghua-shengong");
        map_skill("dodge", "youlong-shenfa");
        map_skill("unarmed", "baihua-cuoquan");
        map_skill("parry", "luohua-jian");
        map_skill("sword", "luohua-jian");

    setup();
	carry_object("/clone/weapon/changjian")->wield();
    carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
    {
        if ((int)ob->query("shen") < 5000)
    {
        command("say 我红花会收徒极严");
        command("say 这位" + RANK_D->query_respect(ob) +
            "平时还要多做一些行侠仗义之事！");
        return;
    }

       command("say 好，你这个年青人还不错，我收下你了！");
        command("recruit " + ob->query("id"));
        if( (string)ob->query("class") != "yishi") ob->set("class", "yishi");
		return;
}