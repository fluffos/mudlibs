// Room: /d/songshan/fengchangtai.c
// Last Modified by Winder on Jul. 15 2001

inherit ROOM;

void create() {
  set("short", "封禅台");
  set("long", @LONG
峻极封禅台由大麻石所建，每块大石都凿得极是平整。地势甚为宽
阔。这里独立天心，万峰在下，云开日朗，纤翳不生。极目北望，可遥
见成皋玉门，黄河有如一线，西向隐隐见到洛阳伊阙，东南都是叠叠重
山。云海之中似有一悬空平台隐现，此等美景，让人遐想连篇，忍不住
跳了过去(jump down)。
LONG);
  set("exits", ([
    "eastdown": __DIR__ "shandao8",
  ]));
  set("objects", ([
    __DIR__ "npc/bo": 1,
    __DIR__ "npc/sha": 1,
    __DIR__ "master/master": 1,
  ]));
  set("outdoors", "songshan");
  set("coor/x", -30);
  set("coor/y", 850);
  set("coor/z", 90);
  setup();
}



void init() {
  add_action("do_jump", "jump");
}


int do_jump(string arg) {

  object who = this_player();

  if (!arg || arg == "") return 0;
  if (arg != "down")
    return notify_fail("你想要跳崖自杀？这么想不开啊？\n");

  if (who->query("family/family_name") == "嵩山派" && (int)who->query_skill(
    "songshan-jian",
    1
  ) > 2000 && (int)who->query_skill(
    "dodge",
    1
  ) > 2000 && (int)who->query("xyzx_sys/level") > 2000) {
    message_vision("$N浑身颤抖着，向前一跃……\n", who);
    message_vision("$N从悬崖上跳了下来，双臂张开迎风飘翔，差一点吓死。\n", who);
    who->unconcious();
    who->move("/d/songshan/yuetai");
  } else {
    message(
      "rumor",
      HIR "【谣言四起】某人：" HIW "听说" + who->query("name") + "万念俱灰，纵身跳入了悬崖之中。。。。\n" NOR,
      users()
    );
    who->die();
    return 1;
  }

  return 1;
}
