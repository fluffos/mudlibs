// shi.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("史登达", ({ "shi dengda", "dengda", "shi" }));
  set("nickname", HIG "千丈松" NOR);
  set("gender", "男性");
  set("class", "swordsman");
  set("age", 25);
  set("attitude", "peaceful");
  set("str", 26);
  set("con", 30);
  set("dex", 30);
  set("int", 28);
  set("neili", 1000);
  set("max_neili", 1000);
  set("wuyongjiali", 30);
  set("max_qi", 1000);
  set("max_jing", 800);
  set("combat_exp", 200000);
  set("shen_type", -1);

  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("songshan-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("songyang-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hanbing-zhenqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lingxu-bu", 500 + jibie / 3 + random(jibie / 5));
  map_skill("unarmed", "songyang-zhang");
  map_skill("sword", "songshan-jian");
  map_skill("parry", "songshan-jian");
  map_skill("dodge", "lingxu-bu");
  map_skill("force", "hanbing-zhenqi");

  create_family("嵩山派", 15, "弟子");
  set("chat_chance_combat", 60);

  setup();

  carry_object("d/songshan/obj/kuojian")->wield();
  carry_object("d/songshan/obj/yellow-cloth")->wear();
}
