//七星剑-名器
#include <weapon.h>
#include <ansi.h>
inherit SWORD;


void create()
{
   set_name(HIC"七星剑"NOR, ({ "qixing sword", "jian", "sword" }) );
   set_weight(8000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "把");
     set("icon", "10084");
     set("value", 1000000);
     set("material", "steel");
     set("long", "这是一把锋利的钨金剑，上面画着天罡北斗七星，因此名曰“七星剑”，是重阳真人的佩剑。\n");
     set("wield_msg", "一道青光闪过，$N手中已多了把$n。\n");
     set("unwield_msg", "$N放下手中的$n。\n");
		set("weapon_prop/dexerity", 10);
		set("weapon_prop/sword", 30);
		set("weapon_prop/dodge", 10);
		set("weapon_prop/intelligence", 5);
		set("weapon_prop/parry", 10);	 
   }
	init_sword(420,2);	
   setup();
}

int query_autoload() { return 1; }	
