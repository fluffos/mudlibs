//麒麟甲-名器
#include <ansi.h>
#include <armor.h>
inherit ARMOR;
void create() {
  set_name(HIR "麒麟甲" NOR, ({ "qilinjia" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("icon", "10092");
    set("material", "cloth");
    set("for_create_cloth", 1);
    set("base_armor", 20);
    set("armor_prop/karma", 10);
    set("armor_prop/constitution", 10);
    set("armor_prop/force", 10);
    set("armor_prop/armor", 800);
    set("long", "一块麒麟的披甲。\n");
    set("max_enchant", 3);
    set("value", 10000000);
  }
  setup();
}

int query_autoload() { return 1; }
