//zhaozhijing.c  赵志敬 

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_me();

void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("赵志敬", ({ "zhao zhijing", "zhao", "zhijing" }));
  set("master", "王处一");
  set("gender", "男性");
  set("age", 30);
  set("long",
    "他容貌不算俊，但却十分英挺，高高的个子，体格很健壮。\n"
    "他是王处一最得意的第子，也是全真教第三代中较出色的一个。\n");
  set("attitude", "peaceful");
  set("class", "taoist");

  set("str", 21);
  set("int", 19);
  set("con", 21);
  set("dex", 19);
  set("per", 20);
  set("chat_chance", 1);
  set("chat_msg", ({
    "赵志敬说道：“杨过这小王八蛋差点害死我，活死人墓的玉蜂真厉害。”\n",
    "赵志敬喃喃道：“我一定要成为全真教掌教”。\n",
    "赵志敬喃喃道：“尹师弟的那点心思，嘿嘿，当我不知道呀。。。”\n",
  }));

  set("qi", 850);
  set("max_qi", 850);
  set("jing", 850);
  set("max_jing", 850);
  set("neili", 800);
  set("max_neili", 800);
  set("wuyongjiali", 50);

  set("combat_exp", 800000);
  set("score", 80000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));             // 基本内功
  set_skill("tiangang-zhengqi", 500 + jibie / 3 + random(jibie / 5));    //天罡正气
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));           // 基本拳脚
  set_skill("haotian-zhang", 500 + jibie / 3 + random(jibie / 5));     //空明拳 
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));              // 基本躲闪
  set_skill("qixing-huanwei", 500 + jibie / 3 + random(jibie / 5));        //七星换位
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));             // 基本招架
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));             // 基本剑法
  set_skill("quanzhen-jianfa", 500 + jibie / 3 + random(jibie / 5));        //天罡剑法 
  set_skill("taoism", 500 + jibie / 3 + random(jibie / 5));           //道学心法  
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));           //读书写字
  set_skill("qixing-array", 500 + jibie / 3 + random(jibie / 5));

  map_skill("force", "tiangang-zhengqi");
  map_skill("unarmed", "haotian-zhang");
  map_skill("dodge", "qixing-huanwei");
  map_skill("parry", "quanzhen-jianfa");
  map_skill("sword", "quanzhen-jianfa");

  create_family("全真教", 3, "第子");
  set("inquiry", ([
    "天罡北斗阵": (: ask_me :),
  ]));
  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/quanzhen/obj/greenrobe")->wear();
}
#include "/d/quanzhen/npc/zhao-qixing.h"
//下面代码也可以全部放进.h文件里
void init() {
  object ob;
  add_action("do_decide", "decide");
  ::init();
  ob = this_player();
  if (ob->query("family/master_id") == "master zhao" && ob->query_temp("warn_time") < time())
    if ((ob->query("PKS") > ob->query("kar") && (int)ob->query("shen") <= -100) || (ob->query("PKS") < ob->query("kar") && (int)ob->query("shen") <= -10000)) {
      ob->add("hao_warning", 1);
      ob->set_temp("warn_time", time() + 300);
      command("heng " + ob->query("id"));
      command("say 你如再在江湖杀人越货，胡作非为，莫怪为师没有警告于你！");
    }
  if ((int)ob->query("hao_warning") > 3) {
    command("chat " + HIR + ob->query("name") + "杀人越货胡作非为，有辱师门，从今以后不再是全真教的弟子。\n" NOR);
    command("expell " + ob->query("id"));
    this_player()->set("title", "全真教" + RED + "弃徒" NOR);
    ob->delete("hao_warning");
  }
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < 0) {
    command("say 我全真教乃是堂堂名门正派，" + RANK_D->query_respect(ob) + "的品德实在令人怀疑。");
    command("say " + RANK_D->query_respect(ob) + "还是先回去多做点善事吧。");
    return;
  }
  command("smile");
  command("say 好吧，我就收下你了，你可要好好光大我全真教！");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "taoist") ob->set("class", "taoist");
  if (this_player()->query("age") < 20) {
    if ((string)this_player()->query("gender") != "女性")
      this_player()->set("title", "全真教道童");
    else
      this_player()->set("title", "全真教小道姑");
  } else {
    if ((string)this_player()->query("gender") != "女性")
      this_player()->set("title", "全真教道士");
    else
      this_player()->set("title", "全真教道姑");
  }
}

void unconcious() {
  object me = this_player();
  message_vision(HIW "\n$N冷笑一声：“叫你知道我全真剑阵的厉害。”说完头也不回的向上跑去。\n\n" NOR, this_object());
  command("sneer");
  me->set_temp("qz/闯", 1);
  destruct(this_object());
}
