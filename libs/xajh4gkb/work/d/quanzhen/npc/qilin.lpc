// huo-chan.c

inherit NPC;

void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name(HIR "火麒麟" NOR, ({ "huo qilin", "qilin" }));
  set("race", "野兽");
  set("age", 100);
  set("long", "一只昂首挺胸，通体金黄的麒麟。\n");
  set("attitude", "aggressive");
  set("max_qi", 9000);
  set("qi", 9000);
  set("jing", 3000);
  set("max_jing", 3000);
  set("str", 300);
  set("cor", 200);

  set("limbs", ({ "头部", "身体", "前脚", "后脚" }));
  set("verbs", ({ "bite", "claw" }));


  set("chat_msg_combat", ({
    (: this_object(), "random_move" :),
    "金麒麟突然向你喷出了一口大火！\n",
  }));
  set_skill("dodge", 500 + jibie * 2 + random(jibie / 5));
  set_skill("force", 500 + jibie * 2 + random(jibie / 5));
  set_skill("parry", 500 + jibie * 2 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie * 2 + random(jibie / 5));
  set_skill("spells", 500 + jibie * 2 + random(jibie / 5));
  set_skill("dragon", 500 + jibie / 2 + random(jibie / 5));
  set_skill("taixuan-gong", 500 + jibie / 2 + random(jibie / 5));
  map_skill("unarmed", "dragon");
  map_skill("dodge", "dragon");
  map_skill("parry", "dragon");
  map_skill("force", "taixuan-gong");
  set_temp("apply/attack", 300);
  set_temp("apply/damage", 300);
  set_temp("apply/armor", 250);

  setup();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) &&
    random(ob->query_kar() + ob->query_per()) < 30) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
  }
}
void die() {
  object ob;
  message_vision("$N惨叫一声，死了！\n", this_object());
  ob = new("d/quanzhen/obj/qilinjia.lpc");
  ob->move(environment(this_object()));
  destruct(this_object());
}
