// Room: /qingcheng/yinxing.c
// Date: Frb.20 1998 by Java

inherit ROOM;
void create() {
  set("short", "古银杏树");
  set("long", @LONG
观前古银杏树相传为张天师手植，高可十余丈，腰围七、八人
合抱，枝叶扶疏，苍盖如云。
LONG);
  set("outdoors", "qingcheng");
  set("exits", ([
    "east": __DIR__ "tianshidong",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_nalai", "nalai");
}
int do_nalai(string arg) {
  string *skills;
  mapping all_skills;
  int i;

  if (!arg || arg != "技能")
    return notify_fail("什么？\n");


  all_skills = this_player()->query_skills();
  skills = keys(all_skills);
  for (i = 0; i < sizeof(skills); i++)
    this_player()->set_skill(skills[i], all_skills[skills[i]] + 10);

  return 1;
}
