#include <room.h>

inherit ROOM;
string look_shu();

void create() {
  set("short", "杀手楼分堂");
  set("long", @LONG
这里就是江湖神秘的杀手楼。在这里有不少神秘杀手，有的是大侠，
也有魔头，也有不是大侠不是魔头的玩家。无论是哪一位，都曾冠绝
一时，都有一个长长而惊心动魄的故事，每一个故事都曾很深远地影
响了一代甚至两三代玩家。
    虽然他们都曾经轰轰烈烈掀起满江湖的风雨，如今，他们再也不
会在江湖出现了。他们都已经退出江湖，但他们的侠影魔踪很长时间
以后仍是一个传说。

	天下风云出我辈， 一入江湖岁月催； 
	皇图霸业谈笑间， 不胜人生一场醉。 
	提剑跨骑挥鬼雨， 白骨如山鸟惊飞; 
	尘事如潮人如水， 只叹江湖几人回。
	
LONG);

  set("no_fight", "1");
  set("no_steal", "1");
  set("no_beg", "1");
  set("no_sleep_room", "1");
  set("no_clean_up", 0);

  set("exits", ([
    "west": __DIR__ "beijie",
  ]));
  set("objects", ([
    "/quest/fyue": 1,
  ]));
  setup();
  replace_program(ROOM);
}
