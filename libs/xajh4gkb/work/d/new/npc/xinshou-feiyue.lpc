// NPC meijian.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void greeting(object);
void init();
void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("绯月", ({ "xinshou feiyue" }));
  set("long",
    "这是风流倜傥的一代魔头, 杀气冲天，\n" +
    "江湖人士十分畏惧，曾力压数代人无法抬头。\n" +
    "如今绯月退隐江湖，专职陪练江湖菜鸟。\n");
  set("gender", "男性");
  set("title", "新手盟第四代盟主");
  set("nickname", HIC "新手教练" NOR);
  set("age", 18);
  set("attitude", "peaceful");
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  set("per", 27);
  set("qi", 1000);
  set("max_qi", 1000);
  set("jing", 500);
  set("max_jing", 500);
  set("neili", 1000);
  set("max_neili", 1000);
  set("wuyongjiali", 20);
  set("combat_exp", 1000000);
  set("score", 10000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xiaoyao-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xiaoyao-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xiaoyao-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xiaoyao-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xiaoyao-bu", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "xiaoyao-xinfa");
  map_skill("dodge", "xiaoyao-bu");
  map_skill("unarmed", "xiaoyao-quan");
  map_skill("parry", "xiaoyao-quan");
  map_skill("sword", "xiaoyao-jian");
  map_skill("blade", "xiaoyao-dao");

  create_family("新手盟", 4, "教练");
  set("chat_chance", 5);
  set("chat_msg", ({
    "新手教练绯月哈哈一笑道: 大江东去，浪淘尽，千古风流人物。\n",
    "新手教练绯月说道：来来来，小弟子们我们切磋一番，好好练功，总有一天能成为一代魔头。\n",
    "新手教练绯月说道：江湖新人可入我新手盟过渡一段时间！\n",
  }));
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/gangjian")->wield();
  carry_object("/clone/weapon/gangdao")->wield();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("xyzx_sys/level", 1) > 1000) {
    message_vision("新手教练绯月瞪着你看了半天,说道：阁下已是成名人物，何必来我新手盟呢！\n", ob);
    return;
  }

  message_vision("新手教练绯月垂目沉思片刻, 说道：“好吧, 我就收下你了。”\n", ob);
  command("recruit " + ob->query("id"));

  return;

}
