// tang.c 唐老太太

#include <ansi.h>

inherit NPC;
inherit F_MASTER;
string ask_me();
int ask_guanyinlei();
void create() {
  int jibie;
  jibie = 7000;
  //	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
  set_name("唐老太太", ({ "tang laotai", "tang" }));
  set("nickname", HIW "霹雳夫人" NOR);
  set("long",
    "她就是唐门第六代掌门唐老太太，在她的经营下，\n"
    "唐门在江湖中声名更加显赫。\n"
    "她大约七十有余，一头银发，红光满面。\n");
  set("gender", "女性");
  set("age", 70);
  set("attitude", "peaceful");
  set("shen_type", 0);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 1500000);
  set("max_jing", 500000);
  set("neili", 15000000);
  set("max_neili", 1500);
  set("wuyongjiali", 100000);
  set("combat_exp", 1000000000);
  set("score", 600000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("biyun-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qiulinshiye", 500 + jibie / 3 + random(jibie / 5));
  set_skill("strike", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("biye-wu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("throwing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zimu-zhen", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("duoming-biao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhuihun-biao", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "biyun-xinfa");
  map_skill("dodge", "qiulinshiye");
  map_skill("strike", "biye-wu");
  map_skill("unarmed", "biye-wu");
  map_skill("parry", "zimu-zhen");
  map_skill("throwing", "zhuihun-biao");

  create_family("唐门", 6, "掌门");
  set("class", "tangmen");

  set("inquiry",
    ([
      "大闹唐门": (: ask_me :),
      "观音泪": (: ask_guanyinlei :)
    ]));

  setup();
  add_money("zimuzhen", 300);
  carry_object("/d/tangmen/obj/zimuzhen")->wield();
  carry_object("/d/tangmen/obj/shujin")->wear();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("biyun-xinfa", 1) < 1000) {
    command("say 唐门虽然以暗器为主，但还是要辅以内力。");
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在碧云心法上多下点功夫？");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    command("say 是否应该去江湖中多加磨炼。");
    return;
  }
  if (ob->query("dex", 1) < 30) {
    command("say 唐门历来注重弟子的身法资质。");
    command("say 本派功夫要能熟练运用，必须要身手灵敏，身轻如燕，身法差了是不行的。");
    command("say " + RANK_D->query_respect(ob) + "的身法还大有潜力可挖，还是请回吧。");
    return;
  }
  if (ob->query("int", 1) < 30) {
    command("say 唐门暗器要想练到高深之处，悟性差了是不行的。");
    return;
  }
  if ((int)ob->query_skill("biye-wu", 1) < 1000) {
    command("say 你的碧叶随风舞火候太浅。");
    return 0;
  }
  if ((int)ob->query_skill("qiulinshiye", 1) < 1000) {
    command("say 你的本门轻功火候太浅。");
    return 0;
  }
  /*	
	if ((int)ob->query_skill("pili-biao", 1) < 1000)
	{
		command("say 你的霹雳镖火候太浅。");
		return 0;
	}
	if ((int)ob->query_skill("liuxing-biao", 1) < 1000)
	{
		command("say 你的流星赶月镖火候太浅。");
		return 0;
	}
	if ((int)ob->query_skill("zhuihun-biao", 1) < 1000)
	{
		command("say 你的追魂夺命镖火候太浅。");
		return 0;
	}
*/
  command("say 哈哈哈哈！！！！");
  command("say 唐门又多了一个得力人才，真是可喜可贺。");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "tangmen")
    ob->set("class", "tangmen");
}
string ask_me() {
  object me;
  me = this_player();
  if (me->query_temp("marks/闹")) {
    command("say 你想帮唐方那个死丫头打探消息吗？看我不劈了你");
    command("hit " + me->query("id"));
    return "看来老太婆非得教训你一下不可。\n";
  }
  if (me->query_temp("marks/萧")) {
    command("angry " + this_player()->query("id"));
    command("say 难道你想像萧秋水一样来个大闹唐门吗？\n");
    command("heng " + this_player()->query("id"));
    command("say 唐方那个死丫头！\n");
    this_player()->set_temp("marks/闹", 1);
    me->delete_temp("marks/萧");
    return "萧秋水已被我关起来了！她别想再见到这个混小子了！\n";
  } else {
    return "瓜娃子，你说啥子？老太婆听不懂哦！\n";
  }
}


int ask_guanyinlei() {
  object me, ob;
  object anqi;
  me = this_player();
  ob = this_object();


  if (me->query("xyzx_sys/level") > 1000 && me->query("family/master_id") == "tang laotai") {
    message_vision(HIB "观音有泪，泪中生苦！” \n" NOR, me);
    message_vision(HIB "观音泪自唐三老祖之后，再也无人练成！” \n" NOR, me);
    message_vision(HIC "听说江湖中又流落了几种唐门的绝世暗器，你去找来我看看。” \n" NOR, me);
    me->set_temp("jm/tangmen1", 1);
    if (present("libie gou", me)) {
      anqi = present("libie gou", me);
      anqi->delete("no_give");
      anqi->delete("no_put");
      anqi->delete("no_get");
      anqi->delete("no_drop");
    }
    if (present("kongque ling", me)) {
      anqi = present("kongque ling", me);
      anqi->delete("no_give");
      anqi->delete("no_put");
      anqi->delete("no_get");
      anqi->delete("no_drop");
    }
    if (present("baoyulihua zhen", me)) {
      anqi = present("baoyulihua zhen", me);
      anqi->delete("no_give");
      anqi->delete("no_put");
      anqi->delete("no_get");
      anqi->delete("no_drop");
    }
    if (present("cun jin", me)) {
      anqi = present("cun jin", me);
      anqi->delete("no_give");
      anqi->delete("no_put");
      anqi->delete("no_get");
      anqi->delete("no_drop");
    }
  } else {
    message_vision(YEL "唐老太太眯眼一笑：这位" + RANK_D->query_respect(me) + "我认识你吗！” \n" NOR, me);
    message_vision(YEL "这位" + RANK_D->query_respect(me) + "似乎。。。。！” \n" NOR, me);
    message_vision(YEL "这是我唐门至高无上的秘密，且是一般人能打听的！！！\n", me);
    return 1;
  }

  return 1;
}

int accept_object(object me, object ob) {
  if ((string)ob->query("id") == "libie gou") {
    if ((int)me->query_temp("jm/tangmen1") && me->query("family/master_id") == "tang laotai") {
      me->set_temp("jm_tangmen/离别", 1);
      message_vision("$N对$n说道：稍等片刻，待我将这" HIR "离别钩" NOR "仔细观察......\n", this_object(), me);
      message_vision("$N对$n说道：这竟然是我唐门暗器的仿品！！！\n", this_object(), me);
      message_vision("$N对$n说道：看来江湖中人都已经忘记了唐门的威严！！！\n", this_object(), me);
      message_vision("$N对$n说道：观音泪为唐门的终极暗器绝技，自唐三之后已经失传很久了。>\n", this_object(), me);
      message_vision("$N对$n说道：据说观音泪的真正秘密在忘情天书中，但忘情天书从未有人修炼成功！\n", this_object(), me);
      message_vision("$N对$n说道：听说萧秋水曾经得到过忘情天书，可恨这贼子始终不交出来！\n", this_object(), me);
      message_vision(HIC "$N对$n说道：江南霹雳堂雷震天多次想吞并我唐门火药堂，是可忍孰不可忍！\n" NOR, this_object(), me);
      if ((int)me->query_temp("jm_tangmen/离别") || (int)me->query_temp("jm_tangmen/孔雀") || (int)me->query_temp("jm_tangmen/暴雨") || (int)me->query_temp("jm_tangmen/寸金")) me->set_temp(
        "jm/tangmen2",
        1
      );
      return 1;
    } else {
      message_vision("$N对$n说道：多谢了，这把暗器就暂时由我来保管吧！我唐门已不问江湖之事很久了。\n", this_object(), me);
      return 1;
    }
  }
  if ((string)ob->query("id") == "kongque ling") {
    if ((int)me->query_temp("jm/tangmen1") && me->query("family/master_id") == "tang laotai") {
      me->set_temp("jm_tangmen/孔雀", 1);
      message_vision("$N对$n说道：稍等片刻，待我将这" HIR "孔雀翎" NOR "仔细观察......\n", this_object(), me);
      message_vision("$N对$n说道：这竟然是我唐门暗器的仿品！！！\n", this_object(), me);
      message_vision("$N对$n说道：看来江湖中人都已经忘记了唐门的威严！！！\n", this_object(), me);
      message_vision("$N对$n说道：观音泪为唐门的终极暗器绝技，自唐三之后已经失传很久了。>\n", this_object(), me);
      message_vision("$N对$n说道：据说观音泪的真正秘密在忘情天书中，但忘情天书从未有人修炼成功！\n", this_object(), me);
      message_vision("$N对$n说道：听说萧秋水曾经得到过忘情天书，可恨这贼子始终不交出来！\n", this_object(), me);
      message_vision(HIC "$N对$n说道：江南霹雳堂雷震天多次想吞并我唐门火药堂，是可忍孰不可忍！\n" NOR, this_object(), me);
      if ((int)me->query_temp("jm_tangmen/离别") || (int)me->query_temp("jm_tangmen/孔雀") || (int)me->query_temp("jm_tangmen/暴雨") || (int)me->query_temp("jm_tangmen/寸金")) me->set_temp(
        "jm/tangmen2",
        1
      );
      return 1;
    } else {
      message_vision("$N对$n说道：多谢了，这把暗器就暂时由我来保管吧！我唐门已不问江湖之事很久了。\n", this_object(), me);
      return 1;
    }
  }
  if ((string)ob->query("id") == "baoyulihua zhen") {
    if ((int)me->query_temp("jm/tangmen1") && me->query("family/master_id") == "tang laotai") {
      me->set_temp("jm_tangmen/暴雨", 1);
      message_vision("$N对$n说道：稍等片刻，待我将这" HIR "暴雨梨花针" NOR "仔细观察......\n", this_object(), me);
      message_vision("$N对$n说道：这竟然是我唐门暗器的仿品！！！\n", this_object(), me);
      message_vision("$N对$n说道：看来江湖中人都已经忘记了唐门的威严！！！\n", this_object(), me);
      message_vision("$N对$n说道：观音泪为唐门的终极暗器绝技，自唐三之后已经失传很久了。>\n", this_object(), me);
      message_vision("$N对$n说道：据说观音泪的真正秘密在忘情天书中，但忘情天书从未有人修炼成功！\n", this_object(), me);
      message_vision("$N对$n说道：听说萧秋水曾经得到过忘情天书，可恨这贼子始终不交出来！\n", this_object(), me);
      message_vision(HIC "$N对$n说道：江南霹雳堂雷震天多次想吞并我唐门火药堂，是可忍孰不可忍！\n" NOR, this_object(), me);
      if ((int)me->query_temp("jm_tangmen/离别") || (int)me->query_temp("jm_tangmen/孔雀") || (int)me->query_temp("jm_tangmen/暴雨") || (int)me->query_temp("jm_tangmen/寸金")) me->set_temp(
        "jm/tangmen2",
        1
      );
      return 1;
    } else {
      message_vision("$N对$n说道：多谢了，这把暗器就暂时由我来保管吧！我唐门已不问江湖之事很久了。\n", this_object(), me);
      return 1;
    }
  }
  if ((string)ob->query("id") == "cun jin") {
    if ((int)me->query_temp("jm/tangmen1") && me->query("family/master_id") == "tang laotai") {
      me->set_temp("jm_tangmen/寸金", 1);
      message_vision("$N对$n说道：稍等片刻，待我将这" HIR "一寸光阴一寸" NOR "金仔细观察......\n", this_object(), me);
      message_vision("$N对$n说道：这竟然是我唐门暗器的仿品！！！\n", this_object(), me);
      message_vision("$N对$n说道：看来江湖中人都已经忘记了唐门的威严！！！\n", this_object(), me);
      message_vision("$N对$n说道：观音泪为唐门的终极暗器绝技，自唐三之后已经失传很久了。>\n", this_object(), me);
      message_vision("$N对$n说道：据说观音泪的真正秘密在忘情天书中，但忘情天书从未有人修炼成功！\n", this_object(), me);
      message_vision("$N对$n说道：听说萧秋水曾经得到过忘情天书，可恨这贼子始终不交出来！\n", this_object(), me);
      message_vision(HIC "$N对$n说道：江南霹雳堂雷震天多次想吞并我唐门火药堂，是可忍孰不可忍！\n" NOR, this_object(), me);
      if ((int)me->query_temp("jm_tangmen/离别") || (int)me->query_temp("jm_tangmen/孔雀") || (int)me->query_temp("jm_tangmen/暴雨") || (int)me->query_temp("jm_tangmen/寸金")) me->set_temp(
        "jm/tangmen2",
        1
      );
      return 1;
    } else {
      message_vision("$N对$n说道：多谢了，这把暗器就暂时由我来保管吧！我唐门已不问江湖之事很久了。\n", this_object(), me);
      return 1;
    }
  }

  return 0;
}

void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "浣花剑派" && me->query_temp("jm_huanhua4")) {
    tell_room(environment(this_player()), "唐老太太大怒道：萧家小儿，目中无人，竟敢大闹我唐门！！！\n");
    tell_room(environment(this_player()), "唐老太太口吐鲜血，说道：萧秋水这小子什么都好，就是爱管闲事！！！\n");
    tell_room(
      environment(this_player()),
      "唐老太太声音越来越低：我死之后，唐方...就...托付...给...萧...秋水...了......一带豪杰死了.....．\n"
    );
    if (me->query_temp("jm_huanhua3")) tell_object(
      me,
      HIM "萧西楼对你说道：这位" + RANK_D->query_respect(me) + "有恩我萧家，可去萧家发源地浣花溪畔感悟。\n" NOR
    );
    me->set_temp("jm_huanhua5", 1);
  }
  ::die();
}
