// xiao qiushui.c 萧秋水

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

string ask_me();
int ask_wangqing();

void create() {
  int jibie;
  jibie = 4000;
  //	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
  set_name("萧秋水", ({ "xiao qiushui", "xiao" }));
  set("nickname", HIY "大侠" NOR);
  set("long",
    "原来他就是与唐方痴心相恋，为了唐方大闹唐门的萧秋水。\n"
    "他在江湖上行侠仗义，侠名远播，人称“大侠”。\n"
    "他大约二十有余，虽然受尽折磨，仍然带着一身傲气。\n");
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 28);
  set("int", 30);
  set("con", 30);
  set("dex", 32);

  set("max_qi", 300000);
  set("max_jing", 150000);
  set("neili", 5000000);
  set("max_neili", 3000);
  set("wuyongjiali", 5000);
  set("combat_exp", 500000000);
  set("score", 700000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("biyun-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qiulinshiye", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("biye-wu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuzhan-mei", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));

  map_skill("force", "biyun-xinfa");
  map_skill("dodge", "qiulinshiye");
  map_skill("unarmed", "biye-wu");
  map_skill("parry", "wuzhan-mei");
  map_skill("sword", "wuzhan-mei");
  create_family("唐门", 7, "弟子");
  set("class", "tangmen");


  set("chat_chance_combat", 200);
  set("chat_msg_combat", ({
    (: perform_action, "sword.yumei" :),
    (: perform_action, "sword.wumei" :),
    (: perform_action, "unarmed.huimeng" :),
    (: exert_function, "recover" :),
  }));
  set("inquiry",
    ([
      "唐方": (: ask_me :),
      "忘情天书": (: ask_wangqing :)
    ]));
  set("yu_count", 1);

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}
void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("biyun-xinfa", 1) < 1000) {
    command("say 唐门虽然以暗器为主，但还是要辅以内力。");
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在碧云心法上多下点功夫？");
    return;
  }
  if (ob->query("dex", 1) < 30) {
    command("say 唐门历来注重弟子的身法资质。");
    command("say 本派功夫要能熟练运用，必须要身手灵敏，身轻如燕，身法差了是不行的。");
    command("say " + RANK_D->query_respect(ob) + "的身法还大有潜力可挖，还是请回吧。");
    return;
  }
  if (ob->query("int", 1) < 30) {
    command("say 唐门的暗器要想练到高深之处，悟性差了是不行的。");
    return;
  }
  command("say 看在唐方姑娘份上，我收下你了。");
  command("recruit " + ob->query("id"));
}
string ask_me() {
  object ob;
  object me;
  me = this_player();
  if (query("yu_count") < 1) {
    return "是唐方叫你来见我的？可惜我的玉佩已经交给别人了。\n";
  }
  command("touch " + this_player()->query("id"));
  command("say 是唐方叫你来见我的？\n");
  command("sigh");
  command("say 自从当日大闹唐门之后，我就和唐方生死相隔了。\n");
  ob = new("/d/tangmen/obj/yupei");
  ob->move(this_player());
  message_vision("$N交给$n一块玉佩。\n", me, ob);
  add("yu_count", -1);
  return "你把这块玉佩交给唐方吧。\n";

}

int ask_wangqing() {
  object ob;
  ob = this_player();
  if (ob->query("family/family_name") == "唐门" && ob->query("family/master_id") == "tang laotai" && ob->query_temp("jm/tangmen3")) {
    tell_object(ob, "萧秋水说道：忘情天书只有通晓琴棋书画、诗歌乐理、至情至性、武学天赋极高之人才可学会！\n");
    tell_object(ob, "萧秋水说道：你是唐门弟子，除非杀了我，否则不可能将其中的秘密告诉你！\n");
    ob->set_temp("jm/tangmen4", 1);
  } else {
    tell_object(ob, "萧秋水说道：你打听的事情我好无印象！\n");
  }
  return 1;
}


void die() {
  object me, biaoshi;
  me = query_temp("last_damage_from");
  if (me && me->query("family/family_name") == "唐门" && me->query("family/master_id") == "tang laotai" && me->query_temp("jm/tangmen4")) {
    message_vision("\n萧秋水道：哼！唐老太爷为了获得忘情天书，将我关在这地牢，除非杀了我，否则休想获得。\n", me, this_object());
    message_vision("\n萧秋水道：“总算解脱了，被困于此，终生与唐方不得相见，时至今日，总算破茧重生。\n", me, this_object());
    message_vision("\n萧秋水道：“观音泪的秘密就在这一册忘情天书，就送给你了。\n", this_object());
    message_vision("\n恭喜你获得了萧秋水的指点，你可以去参悟忘情天书。能否参悟观音泪的秘密全靠机缘。\n", me, this_object());
    me->set_temp("jm/tangmen5", 1);
    biaoshi = new("/clone/book/wangqing1.lpc");
    biaoshi->set("owner", me->query("id"));  //设定识别
    biaoshi->move(me);
  }
  ::die();
}
