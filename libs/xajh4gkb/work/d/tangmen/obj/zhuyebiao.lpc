// zhuyebiao.c
#include <ansi.h>
#include <weapon.h>
inherit THROWING;

void create() {
  set_name("竹叶镖", ({ "zhuye biao", "biao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一把形如竹叶的飞镖。\n");
    set("unit", "些");
    set("base_value", 1);
    set("material", "steel");
    set("base_unit", "枚");
    set("base_weight", 5);
  }
  set_amount(300);
  init_throwing(80, 2);
  setup();
}
