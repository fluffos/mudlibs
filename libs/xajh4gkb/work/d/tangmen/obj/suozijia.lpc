// suozijia.c 琐子甲
#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create() {
  set_name("锁子甲", ({ "armor" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("icon", "10086");
    set("material", "steel");
    set("value", 2000);
    set("armor_prop/armor", 350);
  }
  setup();
}
