// zimuzhen.c
#include <ansi.h>
#include <weapon.h>
inherit THROWING;

void create() {
  set_name("子母飞针", ({ "zimu zhen", "zhen" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一根细若柔丝的银针。\n");
    set("unit", "些");
    set("base_value", 1);
    set("material", "steel");
    set("base_unit", "根");
    set("base_weight", 10);
    set("wield_msg", HIC "你装备了一些子母飞针。！\n" NOR);
    set("unwield_msg", HIC "你将子母飞针收入袖中。\n" NOR);
  }
  set_amount(250);
  init_throwing(300, 2);
  setup();
}
