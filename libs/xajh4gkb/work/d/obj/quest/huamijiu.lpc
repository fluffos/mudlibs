inherit ITEM;
#include "task.h"
void create()
{
        set_name("五宝花蜜酒", ({"huami jiu", "jiu"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "采用五种毒物酿造而成的药酒。\n");
                set("unit", "瓶");
                set("owner_name",MAG"蓝凤凰"NOR);
                set("owner_id","lan fonghuang");
        }
}
