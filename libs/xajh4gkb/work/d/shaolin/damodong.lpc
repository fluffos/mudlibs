// Room: /d/shaolin/damodong.c
// Date: YZC 96/01/19
inherit ROOM;
string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});
void create() {
  set("short", "达摩洞");
  set("long", @LONG
这里是达摩古洞。五百年前南天竺僧人菩提达摩来到少林寺，见
此风水宝地，就住下来广罗弟子，传授禅宗，开创少林寺佛教禅宗千
年不败之基。达摩祖师常在此面壁悟道，一坐十年，壁间隐隐似仍可
看到他面壁时的打坐姿态。除地上的几块竹片外，洞中空无一物。
LONG
  );
  set("exits", ([
    "out": __DIR__ "qfdian",
  ]));
  set("objects", ([
    "clone/book/book-bamboo": 1,
    CLASS_D("shaolin") + "/damo": 1,
  ]));
  setup();
}
void init() {
  object me = this_player();
  if ((int)me->query_temp("bamboo/count") == 14 && (int)me->query_skill(
    "dodge",
    1
  ) >= 30 && (int)me->query_skill("dodge", 1) <= 1000 && present("bamboo", me)) {
    me->receive_damage("jing", 20);
    me->improve_skill("dodge", me->query_int());
    me->delete_temp("bamboo/count");
  }
  add_action("do_mianbi", "面壁");
  add_action("do_mianbi", "mianbi");
}
int do_mianbi() {
  object me = this_player();
  string *poem = ({
    "夫入道多途，要而言之，不出二种。一是理入；二是行入。",
    "理入者，谓藉教悟宗，深信含生同一真性，但为客尘妄想所覆，不能显了。",
    "若也舍妄归真，凝住壁观，无自无他，凡圣等一，坚住不移，更不随于文教，此即与理冥符，无有分别，寂然无为，名理入也。",
    "行入者，谓四行。其余诸行悉入此中。何等四耶？一报冤行；二随缘行；三无所求行；四称法行。",
    "云何名报冤行：谓修道行人，若受苦时，当自念言我从往昔无数劫中，弃本从末，流浪诸有，多起怨憎，违害无限，今虽无犯，是我宿殃恶业果熟，非天非人所与，甘心忍受，都无冤诉。",
    "经云：逢苦不忧，何心故，识达故，此心生时，与理相应，体冤进道，故说言报冤行。",
    "二随缘行者：众生无我，并缘业所转，苦乐齐受，皆从缘生。若得胜报荣誉等事，是我过去宿因所感。",
    "今方得之，缘尽还无，何喜之有。得失从缘，心无增减，喜风不动，冥顺于道。是故说言随缘行也。",
    "三无所求行者：世人常迷，处处贪著，名之为求。智者悟真，理将俗反，安心无为，行随运转。",
    "万有斯空，无所愿乐。功德黑暗，常相随逐。三界无安，犹如火宅，有身皆苦，谁得常安？了达此处，息想无求。",
    "经云：“有求皆苦，无求乃乐。”故知无求，真为道行，是名无所求行也。",
    "四称法行者：性净理体，目之为法，言解此理，众相斯空，无染无著，无此无彼。",
    "经云：“法无众生，离众生垢故；法无有我，离我垢故。”智者若能信解此理，应当称法而行。",
    "法体无悭，于身命财，行檀施舍，心无悭惜，达解三空，不倚不著，但为去垢，感化众生，亦无化相，此为自行，复能利他，亦能庄严菩提之道。",
    "檀施既尔，余五亦然。除妄修真，行于六度，而无所行，是为称法行也。",
  });

  if (me->is_busy()) return notify_fail("你面对着达摩洞後半边的石壁跌坐静思......\n");
  if (me->is_fighting()) return notify_fail("你现在能坐下来面壁么？\n");
  if (me->query_temp("jm_shaolin9")) {
    if (me->query("jm/shaolin"))
      return notify_fail("你已经融汇贯通了少林十八绝技的精髓了，不需要在这领悟了。\n");
    if (me->query("family/family_name") != "少林派")
      return notify_fail("你不是少林弟子，如何能在达摩洞中面壁？\n");
    if ((int)me->query("family/generation") > 36)
      return notify_fail("你在少林寺中辈分太低，恐怕没有资格在这里面壁吧。\n");
    if (me->query_skill(
      "hunyuan-yiqi",
      1
    ) < 1000 && me->query_skill(
      "yijinjing",
      1
    ) < 1000 && me->query_skill(
      "damo-force",
      1
    ) < 1000 && me->query_skill("yijing-force", 1) < 1000)
      return notify_fail("你的佛门内功不够深厚。\n");
    if (me->query_skill("buddhism", 1) < 2000)
      return notify_fail("要练佛门武功，需得先修行佛法。\n");
    if (me->query_skill("banruo-zhang", 1) < 2000)
      return notify_fail("少林十八绝技-般若掌，你还修炼到家。\n");
    if (me->query_skill("cibei-dao", 1) < 2000)
      return notify_fail("少林十八绝技-慈悲刀，你还修炼到家。\n");
    if (me->query_skill("damo-jian", 1) < 2000)
      return notify_fail("少林十八绝技-达摩剑，你还修炼到家。\n");
    if (me->query_skill("fengyun-shou", 1) < 2000)
      return notify_fail("少林十八绝技-风云手，你还修炼到家。\n");
    if (me->query_skill("fumo-jian", 1) < 2000)
      return notify_fail("少林十八绝技-伏魔剑，你还修炼到家。\n");
    if (me->query_skill("jingang-quan", 1) < 2000)
      return notify_fail("少林十八绝技-金刚拳，你还修炼到家。\n");
    if (me->query_skill("longzhua-gong", 1) < 2000)
      return notify_fail("少林十八绝技-龙爪功，你还修炼到家。\n");
    if (me->query_skill("luohan-quan", 1) < 2000)
      return notify_fail("少林十八绝技-罗汉拳，你还修炼到家。\n");
    if (me->query_skill("nianhua-zhi", 1) < 2000)
      return notify_fail("少林十八绝技-拈花指，你还修炼到家。\n");
    if (me->query_skill("pudu-zhang", 1) < 2000)
      return notify_fail("少林十八绝技-普渡杖，你还修炼到家。\n");
    if (me->query_skill("qianye-shou", 1) < 2000)
      return notify_fail("少林十八绝技-千叶手，你还修炼到家。\n");
    if (me->query_skill("sanhua-zhang", 1) < 2000)
      return notify_fail("少林十八绝技-散花掌，你还修炼到家。\n");
    if (me->query_skill("weituo-gun", 1) < 2000)
      return notify_fail("少林十八绝技-韦陀棍，你还修炼到家。\n");
    if (me->query_skill("wuchang-zhang", 1) < 2000)
      return notify_fail("少林十八绝技-无常杖，你还修炼到家。\n");
    if (me->query_skill("xiuluo-dao", 1) < 2000)
      return notify_fail("少林十八绝技-修罗刀，你还修炼到家。\n");
    if (me->query_skill("yingzhua-gong", 1) < 2000)
      return notify_fail("少林十八绝技-鹰抓功，你还修炼到家。\n");
    if (me->query_skill("yizhi-chan", 1) < 2000)
      return notify_fail("少林十八绝技-一指禅，你还修炼到家。\n");
    if (me->query_skill("zui-gun", 1) < 2000)
      return notify_fail("少林十八绝技-醉棍，你还修炼到家。\n");
    if (me->query("jingli") < 1000)
      return notify_fail("你太累了，先休息会吧。\n");

    tell_object(me, HIW "你盘坐于此，面对前面刻有佛文的石壁冥思......\n" NOR);
    message_vision("" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n", me);
    me->add("jingli", -500);
    me->start_busy(2);

    if (random(100000) < me->query("kar", 1)) {
      me->set("jm/shaolin", 1);
      me->add("family_score", 1);
      tell_object(me, HIB "你突然醒悟道：" HIY "原来佛门武技威力如此之大" HIR "！\n" NOR);
      tell_object(me, HIB "恭喜你融汇贯通了少林派武功的精髓！\n" NOR);
      message(
        "channel:chat",
        HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在少林寺达摩洞中面壁多年，将少林七十二绝技融会贯通！\n" NOR,
        users()
      );
    }
    return 1;
  } else {
    if ((int)me->query_skill("buddhism", 1) > 200) {
      message_vision("$N面对着达摩洞後半边的石壁跌坐静思，良久，似有所悟。\n", me);
      me->start_busy(3);
      if (me->query("shen") > 0) {
        if (me->query("shen") - (int)me->query_skill("buddhism", 1) * 2 < 0)
          me->set("shen", 0);
        else
          me->add("shen", -(int)me->query_skill("buddhism", 1) * 2);
      } else {
        if (me->query("shen") + (int)me->query_skill("buddhism", 1) * 2 < 0)
          me->set("shen", 0);
        else
          me->add("shen", (int)me->query_skill("buddhism", 1) * 2);
      }
      return 1;
    } else {
      message_vision("$N面对着达摩洞後半边的石壁跌坐静思，良久，累得腰酸腿痛。\n", me);
      me->start_busy(3);
      return 1;
    }
  }
}
