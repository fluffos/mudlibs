// Npc: /d/shaolin/npc/saodi-seng.c
// Date: YZC 96/01/19
inherit NPC;
void my_move();
int ask_daoshu();
void create() {
  int jibie;
  jibie = 8000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("扫地僧", ({ "saodi seng", "saodi", "seng", }));
  set("long", "这是一位专职负责塔楼清埽工作的寺内杂役僧人。\n");
  set("gender", "男性");
  set("attitude", "peaceful");
  set("class", "bonze");
  set("chat_chance", 5);
  set("chat_msg", ({
    (: this_object(), "my_move" :),
    "扫地僧喃喃自语：这几天也真怪，大半夜的楼上总有猫叫声！\n",
  }));
  set("age", 35);
  set("shen_type", 0);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("max_qi", 300);
  set("max_jing", 150);
  set("neili", 100);
  set("max_neili", 100);
  set("combat_exp", 5000);
  set("score", 100);
  set_skill("buddhism", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jiuyang-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qianye-shou", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sanhua-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("cibei-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "hunyuan-yiqi");
  map_skill("unarmed", "qianye-shou");
  map_skill("parry", "sanhua-zhang");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("blade", "cibei-dao");
  create_family("少林派", 30, "弟子");
  set("inquiry", ([
    "藏经阁": (: ask_daoshu :),
  ]));
  setup();
  carry_object("/d/shaolin/obj/cloth")->wear();
}

void my_move() {
  int value;

  value = random(10);

  if (value > 6) {
    command("say 还一大堆活没干完呢，我得赶紧了。\n");
    command("sigh");
    command("up");
  } else if (value < 4) {
    command("say 还一大堆活没干完呢，我得赶紧了。\n");
    command("sigh");
    command("down");
  }
}

int ask_daoshu() {
  object me;
  me = this_player();

  if ((string)me->query("family/family_name") == "少林派" && (int)me->query("family/generation") <= 36 && me->query_temp("jm_shaolin2")) {
    message_vision(HIB "扫地僧说道：三十年前有两位施主，先后自藏经阁盗走了大力金刚掌、拈花指、无相劫指、伏魔杖法......” \n" NOR, me);
    message_vision(HIB "扫地僧说道：然而二位只知练功，不修佛法，如今恐有走火入魔之势。\n" NOR, me);
    message_vision(HIB "扫地僧说道：" + RANK_D->query_respect(me) + "身为少林弟子，理当去渡化此二人。\n" NOR, me);
    me->set_temp("jm_shaolin3", 1);
  } else {
    message_vision(HIB "扫地僧说道：藏经阁乃少林寺藏书之地，哪里有高僧守护。\n" NOR, me);
  }
  return 1;
}
