// xiang-ke.c 进香客
inherit NPC;
void create()
{
	int jibie,value;
	jibie = 100;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性

    value = random(10);
    set_name("进香客", ({ "jinxiang ke", "ke", "guest" }));
    set("gender", "男性");
    set("age", 14 + value * 3 );
    set("combat_exp", 500 + 5 * value);
    set("shen_type", 0);
    setup();
    add_money("silver", 1 + value);
}
