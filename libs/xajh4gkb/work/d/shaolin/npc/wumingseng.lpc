// 无名僧人
// modified by Jay 4/7/96

#include <ansi.h>

inherit NPC;

int ask_hongye();
int ask_jiasha();
int ask_zhaoshi();

void create()
{
	int jibie;
	jibie = 8000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
	set_name("无名僧人", ({ "wuming sengren", "sengren" }));
	set("gender", "无性");
	set("age", 45);
	set("long", "他是少林寺的一位无名僧人，隐居少林多年。\n");
	set("combat_exp", 30000000);
	set("shen_type", 0);
	set("max_neili", 1000000);
	set("max_jingli", 1000000);
	set("max_qi", 200000);	
	set("max_jing", 200000);		
	set("wuyongjiali", 10);
	set("per",19);
	set("no_get",1);
	
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("kuihua-xinfa", 500+jibie/3+random(jibie/5));
	set_skill("pixie-jian", 500+jibie/3+random(jibie/5));
	set_skill("pixie-sword", 500+jibie/3+random(jibie/5));
	map_skill("force", "kuihua-xinfa");
	map_skill("sword", "pixie-sword");
	map_skill("dodge", "pixie-jian");
	map_skill("parry", "pixie-sword");

    set("chat_chance", 20);
    set("chat_msg", ({
        "欲练神功，引刀自宫；炼丹服药，内外齐通。\n",
        "今练气之道，不外存想导引，渺渺太虚，天地分清浊而生人，人之练气，不外练虚灵而涤荡昏浊，气者命之主，形者体之用。\n",
        "天地可逆转，人亦有男女互化之道，此中之道，切切不可轻传。\n",
		"修炼此功，当先养心，令心不起杂念，超然于物外方可，若心存杂念，不但无功，反而有性命之忧。\n",
        (: random_move :)
    }) );	
	
	set("inquiry", ([
		"红叶禅师" : (: ask_hongye :),
		"袈裟" : (: ask_jiasha:),
		"武学" : (: ask_zhaoshi:),
		]) );

	setup();
	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/cloth/long_cloth")->wear();
}

int ask_hongye()
{
	say("无名僧人神志不清，迷迷糊糊道：欲练神功，引刀自宫。若不自宫，功起热生。\n"
		"热从身起，身燃而生。由下窜上，燥乱不定。即便热止，身伤不止。自宫以后，真气自生。\n"
		"汇入丹田，无有制碍。气生之法，思色是苦。厌苦舍离，以达性静。性静以后，手若拈花。\n"
		"气绕任脉诸穴，方汇丹田。气成之后，人若新生，妙及无比。\n"
		"再配性淡之食草，如木耳、草菇、冬瓜、薯类等，练药而食。\n"
		"此功一成，出手如雷。招式何用？随手一招，敌不及防，即是杀招。\n");
	write(HIW"听闻红叶禅师曾去过五行洞......\n"NOR);
	this_player()->set_temp("marks/红叶1", 1);
	return 1;
}

int ask_jiasha()
{
	int p1, p2, p3, p4;
	
	if ((int)this_player()->query_temp("passwd_shaolin")) 
	{
		say("无名僧人神志不清，似乎未明白你说的什么。\n");
	}
	else if ( (int)this_player()->query_temp("marks/红叶1") ) 
	{
		say("无名僧人双眼突然精光一闪，瞬间又浑浊不堪，似乎想起来什么，又摇摇头，转身走了。\n");
		write("无名僧人默默的念叨，听闻少林寺一直流传着");
		p1=random(4)+1;
		p2=random(4)+1;
		p3=random(4)+1;
		p4=random(4)+1;
		this_player()->set_temp("passwd_shaolin",p1*1000+p2*100+p3*10+p4);
		write(CHINESE_D->chinese_number(p1)+"千"+CHINESE_D->chinese_number(p2)+
			"百"+CHINESE_D->chinese_number(p3)+"十"+CHINESE_D->chinese_number(p4));
		write("种\n武功招式，却从未有人能解其中奥秘。\n");
	}
	else 
	{
		message("vision",
			HIY "无名僧人勃然大怒，喝道：你也想窥视这种害人之物？！我跟你拼了！\n"
			NOR, environment(), this_object() );
		kill_ob(this_player());
	}

	this_player()->delete_temp("marks/红叶1");
	return 1;
}

int ask_zhaoshi()
{
	int p, p1, p2, p3, p4;
	
	if ( !(p=(int)this_player()->query_temp("passwd_shaolin")) ) 
	{
		say("无名僧人垂头不语，来来回回的在寺内游荡......\n");
	}
	else 
	{
		write("无名僧人默默的念叨，听闻少林寺一直流传着");
		p1=(int)p/1000;
		p2=(int)(p-p1*1000)/100;
		p3=(int)(p-p1*1000-p2*100)/10;
		p4=(int)(p-p1*1000-p2*100-p3*10);
		write(CHINESE_D->chinese_number(p1)+"千"+CHINESE_D->chinese_number(p2)+
			"百"+CHINESE_D->chinese_number(p3)+"十"+CHINESE_D->chinese_number(p4));
		write("种\n武功招式，却从未有人能解其中奥秘。\n");
	}
	
	return 1;
}

