// Room: /d/shaolin/cjlou1.c
// Date: YZC 96/01/19
inherit ROOM;
string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});

void create() {
  set("short", "藏经阁二楼");
  set("long", @LONG
千余年来少林寺执中原武林之牛耳，自达摩老祖以下，历代
人材辈出。其中有不少高僧遗著留存，汇集至今，终成名震天下
的少林七十二绝艺。少林精华，尽集于此。二楼四面开窗，确保
通风。中间排列着五排大书架(shujia)。四周则陈列矮几，以供阅读。几
位老僧手执经卷，正在闭目凝思。
LONG
  );
  set("exits", ([
    "down": __DIR__ "cjlou",
  ]));

  set("objects", ([
    CLASS_D("shaolin") + "/hui-zhen": 1,
    "d/shaolin/npc/jueyuan": 1,
    "d/shaolin/obj/wuji1": 1,
    "d/shaolin/obj/wuji2": 1,
    "d/shaolin/obj/wuji3": 1,
  ]));
  setup();
}
int valid_leave(object me, string dir) {
  object ob;
  if (present("huizhen zunzhe", environment(me)))
    if (present("shaolin wuji", me)
      || objectp(ob = present("corpse", me)) && present("shaolin wuji", ob)) {
      if (dir == "down") {
        return notify_fail("慧真说道: 武功秘籍只许在藏经阁内研习，不得携带外出 !\n");
      }
    }
  return ::valid_leave(me, dir);
}


void init() {
  add_action("do_fan", "fan");
}

int do_fan(string arg) {
  object ob, obj, room;
  object me = this_player();

  string *poem = ({
    "你从书架上翻出一本书，居然是本《般若波罗蜜多心经》。",
    "你从书架上翻出一本书，赫然印着《金刚般若波罗蜜经》",
    "你从书架上翻出一本书，发现是本《妙法莲华经》",
    "你从书架上翻出一本书，没想到只是一本《大方广佛华严经》",
    "你从书架上翻出一本书，然而是本无字经书。",
    "你从书架上翻出一本书，竟然画着不少......你看的津津有味。",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫偷东西......\n");
  if (!arg || arg != "shujia")
    return notify_fail("你要翻什么......\n");
  //	if(!me->query_temp("jm_tongchi1") && !me->query_temp("jm_murong1"))
  //		return notify_fail("你未得到通吃小霸王或阿朱的指点，面对这些经书完全无从下手。\n");
  if ((int)me->query_temp("jm_tongchi2"))
    return notify_fail("你已经拿到了达摩心法了，赶紧走吧。\n");
  if ((int)me->query_temp("jm_murong2"))
    return notify_fail("你已经拿到了易筋经了，赶紧走吧。\n");
  if (me->query("jingli") < 1000) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }
  if (!(room = find_object("/d/shaolin/cjlou1"))) room = load_object("/d/shaolin/cjlou1");
  message_vision("" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n", me);
  tell_object(me, HIW "你翻看了一眼......扔了。\n" NOR);
  me->add("jingli", -500);
  me->start_busy(2);
  if (present("huizhen zunzhe", room)) {
    ob = present("huizhen zunzhe", room);
    command("say 大胆狂徒，竟敢闯入藏经阁盗书，看招!\n");
    room->delete("exits");
    call_out("do_back", 60, me);
    ob->kill_ob(this_player());
    COMBAT_D->do_attack(ob, this_player(), ob->query_temp("weapon"));
    return 1;
  }
  if (present("jueyuan chanshi", room)) {
    ob = present("jueyuan chanshi", room);
    command("say 这位施主，大摇大摆的来藏经阁盗取经书，是将老衲不放在眼里吗！\n");
    room->delete("exits");
    call_out("do_back", 60, me);
    ob->kill_ob(this_player());
    COMBAT_D->do_attack(ob, this_player(), ob->query_temp("weapon"));
    return 1;
  }
  if (random(2000) < me->query("kar", 1)) {
    if (me->query_temp("jm_tongchi1") && me->query("family/family_name") == "通吃帮") {
      me->set_temp("jm_tongchi2", 1);
      obj = new("/d/shaolin/obj/bojuan");
      obj->set("owner", me->query("id"));  //设定识别
      obj->move(me);
      tell_object(me, HIB "你将藏经楼的书籍翻的一片狼藉，经书散乱的到处都是！\n" NOR);
      tell_object(me, HIB "你越发焦躁起来，随手扔掉了一卷经书，书页散开，飘落一张古色古香帛卷！\n" NOR);
      tell_object(me, HIB "你捡起来一看，竟然是某种内功的呼吸吐纳之法！\n" "你惊喜不已，这或许就是达摩老祖开创的某种内功心法。\n" NOR);
      message(
        "channel:chat",
        HIC "【江湖传言】" HIY + "传言" + me->query("name") + "奉通吃小霸王之命，在少林寺藏经楼盗走了达摩心法！\n" NOR,
        users()
      );
    } else if (me->query_temp("jm_murong1") && me->query("family/family_name") == "姑苏慕容") {
      me->set_temp("jm_murong2", 1);
      obj = new("/d/shaolin/obj/jingshu");
      obj->set("owner", me->query("id"));  //设定识别
      obj->move(me);
      tell_object(me, HIB "你将藏经楼的书籍翻的一片狼藉，经书散乱的到处都是！\n" NOR);
      tell_object(me, HIB "你越发焦躁起来，随手扔掉了一卷经书，书页散开，你斜眼一瞥，发现画着一些打坐图像！\n" NOR);
      tell_object(me, HIB "你连忙捡起来仔细观看，这竟然是某种极为高深内功的行功路线！\n" "你惊喜不已，这或许就是少林寺正宗的易筋经心法。\n" NOR);
      message(
        "channel:chat",
        HIC "【江湖传言】" HIY + "传言" + me->query("name") + "潜入少林寺藏经楼，盗走了少林至高无上的易筋经！\n" NOR,
        users()
      );
    } else
      tell_object(me, HIY "你将藏经楼的经书翻遍了，或许你未得到高人指点，一无所获！\n" NOR);
  }
  return 1;
}

int do_back(object me) {
  object monk, room;
  if (!(room = find_object("/d/shaolin/cjlou1"))) room = load_object("/d/shaolin/cjlou1");
  monk = present("jueyuan chanshi", room);
  room->set("exits/down", "/d/shaolin/cjlou");
  return 1;
}
