////白万剑
#include <ansi.h>
inherit NPC;
int ask_baizizai();
void create() {
  int jibie;
  jibie = 2000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("白万剑", ({ "bai wanjian", "bai" }));
  set("nickname", HIC "气寒西北" NOR);
  set("gender", "男性");
  set("age", 30);
  set("long",
    "白万剑是雪山派掌门人威德先生白自在的长子，他\n"
    "们师兄弟均以“万”字排行，他名字居然叫到白万剑,\n"
    "足见剑法之高.他外号气寒西北,与‘风火神龙’封万\n"
    "里合称‘雪山双杰’。\n");
  set("attitude", "peaceful");

  set("str", 30);
  set("con", 30);
  set("int", 30);
  set("dex", 30);
  set("per", 30);
  set("neili", 23000);
  set("max_neili", 23000);
  set("jing", 6000);
  set("max_jing", 6000);
  set("qi", 6000);
  set("max_qi", 6000);
  set("wuyongjiali", 80);
  set("combat_exp", 2500000);
  set("score", 50000);
  set("shen_type", 1);
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lingxiao-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xueshan-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("bingxue-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("snow-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("snow-step", 500 + jibie / 3 + random(jibie / 5));

  map_skill("sword", "xueshan-jianfa");
  map_skill("parry", "xueshan-jianfa");
  map_skill("force", "bingxue-xinfa");
  map_skill("unarmed", "snow-zhang");
  map_skill("dodge", "snow-step");
  set("inquiry", ([
    "白自在": (: ask_baizizai :),
    "掌门": "你想拜见老爷子吗？但他闭关面壁,你得找成师叔要到玉牌,才能见到他。",
    "玉牌": "寒玉牌乃我门中重宝,只有凭它,才能进入监狱。",
  ]));

  create_family("凌霄城", 6, "弟子");

  setup();
  carry_object("/d/lingxiao/obj/baihongjian.lpc")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}
void attempt_apprentice(object ob) {
  if (ob->query("con", 1) < 25) {
    command("say 你这种体质,不宜学雪山内功！");
    return;
  }
  if ((int)ob->query_skill("bingxue-xinfa", 1) < 300) {
    command("say 你的本门内功心法太低了,还是努努力先提高一下吧!");
    return;
  }
  if ((int)ob->query_skill("xueshan-jianfa", 1) < 300) {
    command("say 你的本门剑法太低了,还是先找你原来的师父提高吧!");
    return;
  }
  if ((int)ob->query_skill("sword", 1) < 500) {
    command("say 你的基本剑法太低了,还是先提高基本功吧!");
    return;
  }
  if ((int)ob->query("shen") < 100000) {
    command("say 学剑须先正身，你做到了吗?");
    return;
  }

  command("say 很好，很好。");
  command("recruit " + ob->query("id"));
  return;
}

int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("title", "凌霄城第七代弟子");
}

int ask_baizizai() {
  object me, ob;
  me = this_player();
  ob = this_object();
  if ((int)me->query_temp("jm_lingxiao3") && (string)me->query("family/family_name") == "凌霄城" && me->query("family/master_id") == "bai zizai") {
    message_vision(HIB "白万剑说道：哎，因石中玉这小子，掌门最近性情大变，脾气暴躁，封师兄竟因此丢了胳膊！\n" NOR, me);
    message_vision(HIB "白万剑说道：掌门练功走火入魔，时常伤人，不得已只好将其关在本派地下监狱！\n" NOR, me);
    message_vision(HIB "白万剑说道：若有人能击败掌门，或许能将其骄狂之心......\n" NOR, me);
    me->set_temp("jm_lingxiao4", 1);
  } else {
    message_vision(YEL "摘星，星照八千豪情；\n揽月，月映万里烽烟；\n落云，云安四海升平。\n" NOR, me);
    message_vision(YEL "白万剑摇头道：这位" + RANK_D->query_respect(me) + "与我凌霄城并无渊源！” \n" NOR, me);
    message_vision(YEL "白万剑说道：掌门的名讳也是你能随便叫的！” \n" NOR, me);
    return 1;
  }

  return 1;
}
