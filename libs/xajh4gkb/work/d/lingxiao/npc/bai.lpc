//白自在
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
	int jibie;
	jibie = 5000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name("白自在",({"bai zizai","bai"}));
        set("nickname", HIC"威德先生"NOR);
        set("gender", "男性");
        set("age", 55);
        set("long", 
             "他就是雪山剑派的掌门人，习武成性，自认为天下武功第一,\n"
             "他大约五十多岁，精明能干，嫉恶如仇，性如烈火。\n");
        set("attitude", "peaceful");
        set("str", 35);
        set("con", 35);
        set("int", 30);
        set("dex", 30);
        set("per", 25);
        set("neili", 24000);
        set("max_neili", 9000);	
        set("jing", 8000);
        set("max_jing", 8000);
        set("qi", 8000);
        set("max_qi", 8000);
        set("wuyongjiali", 100);
        set("combat_exp", 3000000);
        set("shen_type", 1);
        set("score", 100000);

        set_skill("unarmed", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("literate", 500+jibie/3+random(jibie/5));
		set_skill("lingxiao-jian", 500+jibie/3+random(jibie/5));	
        set_skill("xueshan-jianfa", 500+jibie/3+random(jibie/5));	
        set_skill("bingxue-xinfa", 500+jibie/3+random(jibie/5));
        set_skill("snow-zhang", 500+jibie/3+random(jibie/5));
        set_skill("snow-step", 500+jibie/3+random(jibie/5));

        map_skill("sword", "xueshan-jianfa");	
        map_skill("parry", "xueshan-jianfa");	
        map_skill("force", "bingxue-xinfa");
        map_skill("unarmed", "snow-zhang");
        map_skill("dodge", "snow-step");

        create_family("凌霄城", 4, "掌门");
        set("inquiry", ([
            "石中玉"   : "如果让我逮到这个小王八蛋,我非剥了他的皮不可。",
        ]) );
		
        setup();      
        carry_object("/d/lingxiao/obj/icesword")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}
void attempt_apprentice(object ob)
{
    if (ob->query("con",1) < 25) {
        command("say 以你这种体质,也好意思来找我！");
                return;
    }
    if (ob->query("dex",1) < 25) {
        command("say 笨手笨脚的,也好意思来找我！");
                return;
    }	
    if ((int)ob->query_skill("bingxue-xinfa",1) < 1000 ) {
        command("say 你的本门内功心法太低了,还是努努力先提高一下吧!");
                return;
    } 
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
        command("say 是否应该去江湖中多加磨炼。");
		return ;
    }	
    if ((int)ob->query("shen") < 50000 ) {
         command("say 我威德先生乃堂堂正人君子，怎能收你。"); 
                return;
    } 
    if ((int)ob->query("max_neili") < 100000 ) {
         command("say 你内力不足，怎能领悟我神功的精妙。"); 
                return;
    }
if ((int)ob->query_skill("xueshan-jianfa",1) < 1000 ) { 	
        command("say 你的本门剑法太低了,还是先找你原来的师父提高吧!"); 
                return;
    }
    if ((int)ob->query_skill("sword",1) < 1000 ) {  
        command("say 你的基本剑法太低了,还是先提高基本功吧!"); 
                return; 
    }
    command("say 很好，很好,老子今天心情好,就收下你吧。");
    command("say 这个城老子没心情管了，你就先帮我管着吧。");
    command("recruit " + ob->query("id"));
	return;
} 

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) ) 
        ob->set("title", HIW"凌霄城城主"NOR); 
}

void kill_ob(object me)
{
	if(!this_player())
	{
		::kill_ob(me);
		return;
	}
	if ((int)this_player()->query_temp("jm_lingxiao4") && (string)this_player()->query("family/family_name")=="凌霄城" && this_player()->query("family/master_id")=="bai zizai" )
	{
		command("say 你可要小心了，老夫内功天下第一、轻功天下第一、剑法天下第一。\n");
		this_player()->set_temp("jm_lingxiao5",1);
		::kill_ob(me);
	}
}
void die()
{
    object ob, me;        
    ob = this_object();
    me = query_temp("last_damage_from");
	if (me && me->query("family/master_id") == "bai zizai" && me->query_temp("jm_lingxiao5"))
	{ 
		message_vision(HIG"白自在说道：老夫悔悟已晚，人外有人，天外有天。哎，因我之故，凌霄城人心惶惶。\n", this_object(),me);
		me->set_temp("jm_lingxiao6",1);
		message_vision(HIG"白自在说道：梅花香自苦寒来，宝剑锋从磨砺出。\n", this_object(),me);
		message_vision(HIG"白自在说道：听说本派祖师在云海石观云霞渺邈，一朝顿悟，自此开创了凌霄城。\n", this_object(),me);
		message_vision(HIG"白自在说道：可惜后辈弟子资质驽钝，未能领悟到本门精髓，或许你可以去参悟一番。\n", this_object(),me);
	}
	::die();
}