//封万里
#include <ansi.h>
inherit NPC;
int ask_shizhongyu();
void create() {
  int jibie;
  jibie = 2000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("封万里", ({ "feng wanli", "feng" }));
  set("nickname", HIR "风火神龙" NOR);
  set("gender", "男性");
  set("age", 20);
  set("long",
    "他是凌霄城第六代弟子封万里,是第六代弟子中出类拔萃\n"
    "的人物,其剑法刚猛迅捷，如狂风，如烈火，得了个风火\n"
    "神龙的外号。但不知为何,他少了一只手臂,眼中全是愤怒\n"
    "悔恨之色。\n");
  set("attitude", "peaceful");
  set("str", 25);
  set("con", 30);
  set("int", 24);
  set("dex", 30);
  set("neili", 2000);
  set("max_neili", 2000);
  set("jing", 1500);
  set("max_jing", 1500);
  set("qi", 2500);
  set("max_qi", 2500);
  set("wuyongjiali", 80);
  set("combat_exp", 250000);
  set("shen_type", 1);
  set("score", 50000);
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xueshan-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("bingxue-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("snow-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("snow-step", 500 + jibie / 3 + random(jibie / 5));
  map_skill("sword", "xueshan-jianfa");
  map_skill("parry", "xueshan-jianfa");
  map_skill("force", "bingxue-xinfa");
  map_skill("unarmed", "snow-zhang");
  map_skill("dodge", "snow-step");

  create_family("凌霄城", 6, "弟子");


  set("inquiry", ([
    "石中玉": (: ask_shizhongyu :),
  ]));

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}
void attempt_apprentice(object ob) {
  if (ob->query("con", 1) < 25) {
    command("say 你这种体质,不宜学雪山内功！");
    return;
  }
  if ((int)ob->query_skill("bingxue-xinfa", 1) < 300) {
    command("say 你的本门内功心法太低了,还是努努力先提高一下吧!");
    return;
  }
  if ((int)ob->query_skill("xueshan-jianfa", 1) < 300) {
    command("say 你的本门剑法太低了,还是先找你原来的师父提高吧!");
    return;
  }
  if ((int)ob->query("shen") < 100000) {
    command("say 学剑须先正身，你做到了吗?");
    return;
  }

  if ((int)ob->query_skill("sword", 1) < 500) {
    command("say 你的基本剑法太低了,还是先提高基本功吧!");
    return;
  }

  command("say 很好，很好。");
  command("recruit " + ob->query("id"));
  return;
}

int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("title", "凌霄城第七代弟子");
}

int ask_shizhongyu() {
  object me, ob;
  me = this_player();
  ob = this_object();
  if ((int)me->query_temp("jm_lingxiao1") && (string)me->query("family/family_name") == "凌霄城" && me->query("family/master_id") == "bai zizai") {
    message_vision(HIB "封万里说道：石中玉这狗贼，竟敢企图玷污我凌霄城小公主！我定要将其千刀万剐！\n" NOR, me);
    message_vision(HIB "封万里说道：我恨啊！我这条手臂就是为此事而断！若抓到这小杂种，必大卸八块！\n" NOR, me);
    message_vision(HIB "封万里说道：掌门震怒！派遣凌霄城弟子下山捉拿石中玉，听闻其成了长乐帮帮主......\n" NOR, me);
    message_vision(
      HIB "封万里说道：这位" + RANK_D->query_respect(me) + "，若你能取来石中玉人头，我凌霄城必有厚报！” \n" NOR,
      me
    );
    me->set_temp("jm_lingxiao2", 1);
  } else {
    message_vision(YEL "封万里说道：石中玉啊，他是玄清庄石清之子！！！\n", me);
    message_vision(YEL "封万里摇头道：这位" + RANK_D->query_respect(me) + "你我交情并不深啊！” \n" NOR, me);
    message_vision(YEL "封万里说道：石中玉在我凌霄城学艺，甚是顽皮！” \n" NOR, me);
    return 1;
  }

  return 1;
}

int accept_object(object me, object ob) {
  if ((string)ob->query("id") == "zhongyu rentou" && me->query("id") == ob->query("owner")) {
    if ((int)me->query_temp("jm_lingxiao2")) {
      message_vision("封万里说道：哈哈哈！这石中玉小子，总算是死掉了。\n", this_object(), me);
      message_vision("封万里说道：我断臂之仇，总算出了口恶气。\n", this_object(), me);
      message_vision("封万里叹气道：哎！掌门因此事，精神大变，你去找白师兄吧......\n", this_object(), me);
      me->set_temp("jm_lingxiao3", 1);
      return 1;
    } else {
      message_vision("封万里说道：石中玉这狗贼，如此大逆不道，迟早都是要死的。\n", this_object(), me);
      return 1;
    }
  }
  return 0;
}
