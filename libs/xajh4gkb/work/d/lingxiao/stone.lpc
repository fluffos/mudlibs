inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "云海石");
  set("long", @LONG
这里放着一座硕大的石头(stone)。是白自在从雪山绝谷中找到的奇
石，上面云气缭绕，布满了奇形怪状的花纹。听说在要下雨的时
候，还会散发出不同形状的云雾，缭绕四周，经久不散，是白自
在最喜欢来赏玩的宝物。你可以试着在此冥想(think)，看看能否
领悟到什么。
LONG);
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "meiroad2",
  ]));
  set("item_desc", ([
    "stone": "这是块布满了云气花纹的大石,凝望着它，只见一团团云雾似乎在不断向前推涌，直如意欲破石飞出。\n",
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_think", "think");
}

int do_think(string arg) {
  object me, weapon;
  string *poem = ({
    HIM "明月出天山，苍茫云海间。长风几万里，吹度玉门关。" NOR,
    HIY "摘星，星照八千豪情；揽月，月映万里烽烟；落云，云安四海升平。" NOR,
    HIG "梅花香自苦寒来，宝剑锋从磨砺出。" NOR,
    HIC "郡北无双岳，南滇第一峰。四时光皎洁，万古势龙从。" NOR,
    HIB "绝顶星河转，危巅日月通。寒威千里望，玉立雪山崇。" NOR,
    HIR "半岭皑皑花缀景，一潭洌洌水飞琼。沧桑演绎轮回转，我自岿然任尔横。" NOR,
    HIW "千里黄云白日曛，北风吹雁雪纷纷。" NOR,
    HIY "缓逐烟波起，如妒柳绵飘。故临飞阁度，欲入回陂销。" NOR,
    HIC "尽日看云首不回，无心都大似无才。可怜光彩一片玉，万里晴天何处来？" NOR,
  });
  me = this_player();
  if (!arg || (arg != "stone"))
    return notify_fail("你要参悟什么？\n");
  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫观云海茫茫...\n");
  if (me->query("family/family_name") != "凌霄城" || me->query("family/master_id") != "bai zizai")
    return notify_fail("你非掌门嫡传弟子，如何能在此参悟本门高深武学！\n");
  if (me->query_skill("lingxiao-jian", 1) < 2000)
    return notify_fail("你的凌霄剑太低，恐怕也是白费功夫。\n");
  if (me->query_skill("xueshan-jianfa", 1) < 2000)
    return notify_fail("你的雪山剑法太低，恐怕也是白费功夫。\n");
  if (me->query_skill("snow-zhang", 1) < 2000)
    return notify_fail("你的飞雪映梅掌太低，恐怕也是白费功夫。\n");
  if (me->query_skill("snow-step", 1) < 2000)
    return notify_fail("你的梅雪飘香步太低，在这里观海小心掉下去了啊。\n");
  if (me->query_skill("bingxue-xinfa", 1) < 1000)
    return notify_fail("你的冰雪心法太低，这里经常雪花纷飞，小心冻着了。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword" || (string)weapon->query("id") == "ice sword")
    return notify_fail("你不拿冰雪之剑，恐怕是白费功夫！\n");
  if (!me->query_temp("jm_lingxiao6"))
    return notify_fail("凌霄城现在人心惶惶，你还是先去解决凌霄城的麻烦吧。\n");
  if (me->query("jm/lingxiao"))
    return notify_fail("你已经领悟了凌霄城武功精髓了，这里对你来说已无堪大用。\n");
  if (me->query("jingli") < 1000)
    return notify_fail("你疲惫难堪，还是休息会吧。\n");

  tell_object(me, HIW "你面对着云海石上的云气花纹冥思苦想，感悟这云海茫茫的意境......\n" NOR);
  message_vision("$N于云海中感受梅花的香气，一边舞剑，低吟道：" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -1000);
  me->start_busy(1);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/lingxiao", 1);
    me->add("family_score", 1);
    tell_object(me, HIG "你突然醒悟道：" HIY "原来雪山剑法可以有此等威力" HIR "！\n" NOR);
    tell_object(me, HIG "恭喜你融汇贯通了凌霄城武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在凌霄城云海石居然领悟了凌霄城的雪梅笑！\n" NOR,
      users()
    );
    return 1;
  }
  return 1;
}
