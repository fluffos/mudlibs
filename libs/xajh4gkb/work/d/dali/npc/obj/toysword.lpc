//魔剑阿飞的佩剑--名器
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
	set_name( HIR "魔剑" NOR, ({ "rusty sword","mojian","jian" }) );
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("weapon_prop/dodge", 5);	
		set("weapon_prop/sword", 50);
		set("weapon_prop/force", 10);
		set("weapon_prop/dexerity", 15);
		set("weapon_prop/parry", 10);
		set("unit", "把");
		set("long", "这是一把绑着一块木头的锈铁片，黑漆漆的，看起来像个玩具．\n");
		set("value", 15000000);
		set("material", "steel");
		set("wield_msg", "$N把别在腰间$n拔出握在手中。\n");
		set("unwield_msg", "$N将手中的$n插入腰间。\n");
	}
	init_sword(580,2);	
	setup();
}
int query_autoload() { return 1; }		
