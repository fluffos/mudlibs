#include <ansi.h>
inherit NPC;

void create()
{
	int jibie;
	jibie = 5000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
	set_name("林仙儿", ({ "lin xianer","lin" }) );
	set("title", HIR "武林第一美人" NOR);
	set("gender", "女性" );
	set("age", 22);
	set("str", 10);
	set("per", 30);
	set("long", @LONG
两弯似戚非戚笼烟眉，一双似喜非喜含情目．
行动如弱柳扶风，闲静似娇花照水．
LONG
);
	set("combat_exp", 10000000);
	set("shen_type", 0);
	set("attitude", "friendly");
        set("chat_chance", 1);
        set("chat_msg", ({
"林仙儿又意无意地撩起长裙，向你露出她那双白如羊脂的细足．\n",
"林仙儿似乎怕热，拎起领口扇了扇，半边雪白的坚挺的胸膛尽收眼底．\n",
"林仙儿向你笑了笑，又满眼愤毒的瞥了阿飞一眼．\n",
        }) );
    set_skill("unarmed", 500+jibie/3+random(jibie/5));	
	set_skill("hand", 500+jibie/3+random(jibie/5));	
    set_skill("force", 500+jibie/3+random(jibie/5));	
    set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("literate", 500+jibie/3+random(jibie/5));
	set_skill("art", 500+jibie/3+random(jibie/5));	
	set_skill("wangran-xinfa", 500+jibie/3+random(jibie/5)); 
	set_skill("wenrou-jian", 500+jibie/3+random(jibie/5)); 
	set_skill("music", 500+jibie/3+random(jibie/5));
	set_skill("shuiyue", 500+jibie/3+random(jibie/5)); 
	map_skill("force", "wangran-xinfa");
	map_skill("unarmed", "music");
	map_skill("parry", "music");
	map_skill("dodge", "shuiyue");
	map_skill("hand", "music");
	map_skill("sword", "wenrou-jian");
	
	setup();
	carry_object(__DIR__"obj/sskirt")->wear();
	carry_object("/clone/weapon/yuenv")->wield();
}

int accept_fight(object me)
{
	command("say 小女子哪里是您的对手？");
	return 0;
}

void die()
{
    object me;        
    me = query_temp("last_damage_from");
	if (me && (string)me->query("family/family_name") == "圣剑魔宫" && (me->query("family/master_id")=="a fei" || me->query("family/master_id")=="jing wuming") && me->query_temp("jm_shengjian1"))
	{
		tell_room(environment(this_player()), "林仙儿终之前，方才醒悟，自己最爱的人是阿飞！！！\n");
		tell_room(environment(this_player()), "林仙儿弥留之际，发现这个世间唯一可以相信的人只有阿飞，将自己的大女儿上官小仙交由阿飞抚养。\n");
		tell_room(environment(this_player()), "林仙儿的气息渐渐的......一代美人......可悲、可怜、可叹！\n");
		me->set_temp("jm_shengjian2",1);
	}
	::die();
}