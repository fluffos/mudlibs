inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int ask_shenshi();
int ask_dugu();
void create() {
  int jibie;
  jibie = 9000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set_name("阿飞", ({ "a fei" }));
  set("gender", "男性");
  set("title", HIG "情为何物" NOR);
  set("class", "jianxia");
  set("age", 20);
  set("int", 30);
  set("per", 30);
  set("int", 30);
  set("long", "天下剑神－－－阿飞\n");
  set("shen_type", 1);
  set("force_factor", 200);
  set("nickname", RED "魔剑" NOR);
  //	set("no_suck",1);
  //	set("is_boss", 1);
  set("combat_exp", 150000000);

  set("max_neili", 100000000);
  set("neili", 150000000);
  set("max_jingli", 500000);
  set("jingli", 400000);
  set("max_jing", 50000000);
  set("max_qi", 100000000);
  set("shen", 300000000);
  set("wuyongjiali", 50000);

  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("spear", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhenfeng-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lonely-sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("piaoyibu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhentian-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhenfeng-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhenfeng-qiangfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("three-sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qimen-wuxing", 500 + jibie / 3 + random(jibie / 5));
  map_skill("dodge", "piaoyibu");
  map_skill("unarmed", "zhentian-quan");
  map_skill("sword", "lonely-sword");
  map_skill("parry", "lonely-sword");
  map_skill("force", "zhenfeng-xinfa");
  map_skill("spear", "zhenfeng-qiangfa");
  create_family("圣剑魔宫", 5, "掌门");
  set("inquiry", ([
    "阿飞身世": (: ask_shenshi :),
    "三才剑": "天地人三剑唯有在切磋决斗之中才能领悟。\n",
    "独孤九剑": (: ask_dugu :),
  ]));
  setup();
  carry_object("clone/cloth/cloth")->wear();
  carry_object(__DIR__ "obj/toysword")->wield();
}
/*
int accept_fight(object me)
{
        command("grin");
        command("say 我的剑是用来杀人的，不是用来比划着玩的．");
        return 0;
}
*/
void init() {
  add_action("do_killing", "kill");
}

int do_killing(string arg) {

  object player, victim;
  string name;
  player = this_player();
  if (!arg) return 0;
  if (objectp(victim = present(arg, environment(this_object()))) && living(victim)) {
    name = (string)victim->name();
    if ((string)name == "林仙儿") {
      message_vision("$N冷笑一声道：我看你活得太长了。\n", this_object());
      this_object()->kill_ob(player);
      player->kill_ob(this_object());
      return 1;
    }
  }
  return 0;
}
void attempt_apprentice(object ob) {
  if ((int)ob->query("shen", 1) < 150000000) {
    command("say 我的剑法只传侠义人士，你在德行方面还做得不够吧。");
    return;
  }
  if ((int)ob->query("int", 1) < 30) {
    command("say 我的剑法非悟性高绝者不可学。");
    return;
  }
  if ((int)ob->query("dex", 1) < 25) {
    command("say 我的剑法最注重身法。");
    return;
  }
  if ((int)ob->query_skill("zhenfeng-xinfa", 1) < 1000) {
    command("say 你对本门内功不甚了解，还是多加练习再来吧。");
    return;
  }
  command("say 好吧，我就破例收下你了，以后要多多行侠仗义。");
  command("chat 我的绝世剑法终有传人了，武林中又多了位行侠仗义的大侠。哈哈.....");
  command("recruit " + ob->query("id"));
  ob->set("class", "jianxia");
  return;
}

int accept_fight(object ob) {
  object me = this_object();

  if (!ob->query_temp("jm_shengjian2") || !ob->query_temp("jm_shengjian3")) return 1;
  remove_call_out("checking");
  call_out("checking", 1, me, ob);
  if (ob->query_temp("jm_shengjian2") || ob->query_temp("jm_shengjian3")) ob->set_temp(
    "jm_fight",
    1
  );
  return 1;
}
int checking(object me, object ob) {
  int my_max_qi, his_max_qi;
  my_max_qi = me->query("max_qi");
  his_max_qi = ob->query("max_qi");

  if (!objectp(me)) return 1;
  if (!present(ob, environment(me))) return 1;
  if (me->is_busy() && me->query_busy() > 5) {
    message_vision("阿飞笑道，只是切磋武艺而已，用得着使用这种点穴功夫吗！！！\n", ob);
    return 1;
  }
  if (ob->query("family/master_id") != "a fei" && ob->query("family/master_id") != "jing wuming") {
    message_vision("阿飞笑道：你未得到左手剑或快剑传承，恐怕与我切磋领悟不到什么！！！\n", ob);
    return 1;
  }
  if (ob->query_skill("zhenfeng-xinfa") < 1000 || ob->query_skill("three-sword") < 2000 || ob->query_skill("piaoyibu") < 2000) {
    message_vision("阿飞笑道：以你的武功，恐怕是难以理解三才变化！！！\n", ob);
    return 1;
  }
  if (ob->query("jm/shengjian")) {
    message_vision("阿飞说道：你已经完全参悟了天地人三才的奥妙，没必要再继续打下去了！！！\n", ob);
    return 1;
  }
  if (!ob->query_temp("jm_shengjian2") || !ob->query_temp("jm_shengjian3")) {
    message_vision("阿飞说道：我平生两大恨事！！！\n", ob);
    return 1;
  }
  if (((int)ob->query("qi") * 100 / his_max_qi) < 50 && ob->query_temp("jm_shengjian2") && ob->query_temp("jm_shengjian3")) {
    message_vision("阿飞笑道，这位" + RANK_D->query_respect(ob) + "剑法恐怕还不到出师的时候吧......\n", ob);
    //		ob->delete_temp("jm_shengjian2");
    //		ob->delete_temp("jm_shengjian3");
    ob->delete_temp("jm_fight");
    return 1;
  }
  if (((int)me->query("qi") * 100 / my_max_qi) < 50 || ((int)me->query("eff_qi") * 100 / my_max_qi) < 40 && ob->query_temp("jm_shengjian2") && ob->query_temp("jm_shengjian3")) {
    command("say 青出於蓝胜於蓝，你已经获得了快剑的传承！\n");
    message_vision("阿飞露出笑容道：圣剑一脉的传承，如今你已经掌握了，但仍需谨记；颠峰过后佳境必下，极乐之欢必不长久。。\n", ob);
    message_vision(HIG "你在与魔剑阿飞的决战中，体会到了天地人三剑的精髓。\n", ob);
    ob->delete_temp("jm_shengjian2");
    ob->delete_temp("jm_shengjian3");
    ob->delete_temp("jm_fight");
    ob->set("jm/shengjian", 1);
    ob->add("family_score", 1);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + ob->query("name") + "天纵奇才，在与阿飞的决斗之中，于生死一线之间领悟到了【天·地·人】三剑的精髓！\n" NOR,
      users()
    );
    return 1;
  }
  if (me->is_fighting()) {
    call_out("checking", 3, me, ob);
    return 1;
  }
  return 1;
}

int ask_shenshi() {
  object me = this_player();

  if ((string)me->query("family/family_name") == "圣剑魔宫" && (me->query("family/master_id") == "a fei" || me->query("family/master_id") == "jing wuming")) {
    message_vision(HIB "阿飞微微一叹道：我母亲很早就过世了，据说二十年前与天下第一名侠沈浪相遇后，自此恩怨纠缠了一辈子。\n" NOR, me);
    message_vision(HIB "阿飞说道：我初入江湖，结识了一代大侠小李探花！” \n" NOR, me);
    message_vision(HIC "阿飞看了看身边的林仙儿，神情悲苦，又爱又恨。。。。。。” \n" NOR, me);
    message_vision(HIC "阿飞说道：我这一生，最敬重的是大哥李寻欢，最爱的是林仙儿，伤我最深的人也是林仙儿。。。。。” \n" NOR, me);
    message_vision(HIC "阿飞说道：如果这位" + RANK_D->query_respect(me) + "能为我解此平生恨事，我将指点你三才迷津” \n" NOR, me);
    me->set_temp("jm_shengjian1", 1);
  } else {
    message_vision(YEL "阿飞冷冷的说道：我的身世也是你能随便打听的！！！\n", me);
    message_vision(YEL "阿飞冷哼道：我平生两大恨事！！！” \n" NOR, me);
    message_vision(YEL "阿飞说道：金钱帮上官金虹作恶多端......天下第一美人蛇蝎心肠......可恨！” \n" NOR, me);
  }

  return 1;
}
int ask_dugu() {
  object me = this_player();

  if ((int)me->query("shen") >= 100000000) {
    message_vision(HIB "阿飞说道：当年风大侠曾得到独孤大侠的指点,你不防去问问他。\n" NOR, me);
    me->set_temp("jm_dugu_afei", 1);
  } else if ((int)me->query("shen") >= 0) {
    message_vision(YEL "阿飞说道：你的德行恐怕还不够！\n", me);
  } else {
    message_vision(YEL "阿飞冷冷的说道：独孤前辈的剑法岂能传授给你这种奸邪小人！\n", me);
  }

  return 1;
}
