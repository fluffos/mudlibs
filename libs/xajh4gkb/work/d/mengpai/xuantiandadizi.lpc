  ob->delete("party/party_name");
  ob->delete("party/rank");
  ob->set("party/party_name", YEL + "第" + chinese_number(me->query("generation")) + "代" + NOR);
  ob->set("party/rank", YEL + "玄天大弟子" + NOR);

  me->set(
    "short",
