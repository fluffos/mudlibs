// meng-zhu.c 武林盟主
// colored the title of 武林盟主(player) ,   ReyGod, 1/15/1997
#include <ansi.h>
#ifndef NPCDATA
#define NPCDATA "/data/npc/"
#endif
#define MENGZHU NPCDATA + "xuantian-dadizi"
inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;
inherit F_SAVE;
string query_save_file() {
  return MENGZHU;
}

int rm_file() {
  seteuid(getuid());
  rm(query_save_file() + __SAVE_EXTENSION__);
  destruct(this_object());
  return 1;
}

void create() {
  int jibie;
  jibie = 1000;
  seteuid(getuid());
  if (!restore()) {
    set_name(HIC "刀行天" NOR, ({ "xuantian dadizi", "dadizi" }));
    set("title", YEL "玄天大弟子" NOR);
    set("gender", "男性");
    set("age", 40);
    set("long", "他就是雄踞武林，号令玄天，威风赫赫的当代玄天大弟子。\n");
    set("attitude", "heroism");
    set("generation", 0);
    set("winner", "NONE");
    set("no_get", 1);  //设置不能背走
    set("str", 25);
    set("con", 25);
    set("int", 25);
    set("dex", 25);
    set("max_qi", 50000);
    set("eff_qi", 50000);
    set("qi", 50000);
    set("max_jing", 3000);
    set("jing", 3000);
    set("neili", 150000);
    set("max_neili", 50000);
    set("wuyongjiali", 100);
    set("shen_type", 1 - random(3));
    set("no_clean_up", 1);
    set("combat_exp", 1500000000);
    set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
    set_skill("force", 500 + jibie * 2 + random(jibie / 5));
    set_skill("unarmed", 500 + jibie * 2 + random(jibie / 5));
    set_skill("blade", 500 + jibie * 2 + random(jibie / 5));
    set_skill("parry", 500 + jibie * 2 + random(jibie / 5));
    set_skill("dodge", 500 + jibie * 2 + random(jibie / 5));
    set_skill("lingyuan-xinfa", 500 + jibie / 2 + random(jibie / 5));
    set_skill("lingyunbu", 500 + jibie / 2 + random(jibie / 5));
    set_skill("cuixin-zhang", 500 + jibie / 2 + random(jibie / 5));
    set_skill("tianxin-blade", 500 + jibie / 2 + random(jibie / 5));
    set_skill("art", 500 + jibie / 2 + random(jibie / 5));
    set_skill("qimen-wuxing", 500 + jibie / 2 + random(jibie / 5));

    map_skill("blade", "tianxin-blade");
    map_skill("dodge", "lingyunbu");
    map_skill("parry", "tianxin-blade");
    map_skill("force", "lingyuan-xinfa");
    map_skill("unarmed", "cuixin-zhang");
    create_family("玄天派", 20, "大弟子");
    //    set("my_weapon", "/clone/weapon/changjian");
    //    set("my_armor", "/clone/cloth/cloth");
    setup();
    add_money("gangbiao", 1000);
    carry_object("/clone/weapon/hanbing-dao")->wield();
    carry_object("/clone/cloth/hanbing-jia")->wear();
  } else {
    set("id", "dadizi");
    if (!query("name"))
      set_name("刀行天", ({ "xuantian dadizi", "dadizi" }));
    else
      set_name(query("name"), ({ "xuantian dadizi", "dadizi" }));
    setup();
    if (this_object()->query("my_weapon")) carry_object(this_object()->query("my_weapon"))->wield();
    if (this_object()->query("my_armor")) carry_object(this_object()->query("my_armor"))->wear();
    UPDATE_D->check_user(this_object());
  }
  set("no_suck", 1);
  set("chat_chance", 20);
  set("chat_msg", ({
    (: random_move :)
  }));
}
void init() {
  object me = this_object();
  object ob = this_player();
  if (base_name(environment()) != me->query("startroom")) return;
  if (me->query("winner") == ob->query("id")
    && me->query("age") <= ob->query("age")
    && time() - me->query("recover") > 60) {
    ob->set("eff_jing", ob->query("max_jing"));
    ob->set("jing", ob->query("max_jing"));
    ob->set("eff_qi", ob->query("max_qi"));
    ob->set("qi", ob->query("max_qi"));
    if (ob->query("neili") < ob->query("max_neili"))
      ob->set("neili", ob->query("max_neili"));
    if (ob->query("jingli") < ob->query("max_jingli"))
      ob->set("jingli", ob->query("max_jingli"));
    me->set("recover", time());
  }
  add_action("do_recopy", "recopy");
  //add_action("do_recover", "recover");      	//2016.6.8阿飞改，关闭泰山像的读取功能
  add_action("do_kill", "kill");
  // 怪物必须是可以动作的，并只针对玩家
  if (!objectp(ob) || !living(me) || !playerp(ob)) return;
  // 见面就杀
  //me->kill_ob(ob);	//这条表示见人就杀
  call_out("just_kill", 1, me, ob);  //这条表示执行上述定义的just_kill这一段
}
int just_kill(object guai, object player) {
  int kill = 0;
  if (player->query("family/family_name") == "玄天派") {
    guai->command("haha");
    guai->command("say 小子，见了门派大师兄还不问好，有大师兄在，谁敢欺负你！！！");
  } else {
    if (random(100) >= 50) {
      guai->command("haha");
      guai->command("say 江湖任逍遥，快意了恩仇，我派弟子当我行我素！！！");
    } else {
      guai->command("say 小子，你当着大爷的道了，老子想杀人就杀人！！！");
      kill = 1;
    }
  }
  if (kill == 1) {
    if (!objectp(guai) || !objectp(player)) return 1;
    if (environment(guai) != environment(player)) return 1;
    guai->kill_ob(player);
    player->fight_ob(guai);
  }
  return 1;
}
int do_kill(string arg) {
  if (!this_object()->id(arg)) return 0;
  command("say 你想谋害本门大弟子，当真是吃了熊心豹子胆了！！");
  this_object()->kill_ob(this_player());
  return 1;
}
int accept_fight(object ob) {
  object home;
  object me = this_object();

  if (time() - ob->query("birthday", 1) <= 3600 * 24 * 10) {
    command("say 你还是新手，恐怕还无法担此大任。\n");
    return 0;
  }
  if (ob->query("family/family_name") != "玄天派") {
    command("say 你不是玄天弟子，如何能挑战我呢。\n");
    return 0;
  }
  if (!ob->query("xyzx_sys/level") || ob->query("xyzx_sys/level") < 100) {
    command("say 你的等级过低，还无法担此大任。\n");
    return 0;
  }

  if (me->query("winner") == ob->query("id")) {
    command("say 你跟你自己打什么架？！\n");
    return 0;
  }
  if (wizardp(this_player())) {
    command("say 巫师不能抢大弟子之位！\n");
    return 0;
  }
  if (!home = find_object(me->query("startroom")))
    home = load_object(me->query("startroom"));
  if (environment(me) != home) {
    command("say 我现在正忙着呢！等我回去再说吧！\n");
    return 0;
  }
  if (me->is_fighting() || me->query("fighting")) {
    command("say 已经有人正在挑战大弟子了！\n");
    return 0;
  }
  me->set("eff_qi", me->query("max_qi"));
  me->set("qi", me->query("max_qi"));
  me->set("jing", me->query("max_jing"));
  me->set("neili", me->query("max_neili") * 2);
  remove_call_out("checking");
  call_out("checking", 1, me, ob);

  return 1;
}
int checking(object me, object ob) {
  int my_max_qi, his_max_qi;
  object *enemy = me->query_enemy();
  if (sizeof(enemy) > 1) return 1;
  if (!ob) return 1;
  my_max_qi = me->query("max_qi");
  his_max_qi = ob->query("max_qi");
  if (me->is_fighting()) {
    if ((me->query("qi") * 100 / my_max_qi) <= 80)
      command("exert recover");
    call_out("checking", 1, me, ob);
    return 1;
  }
  if (!present(ob, environment())) return 1;
  if (((int)me->query("qi") * 100 / my_max_qi) <= 50) {
    if (!living(me)) me->revive();
    command("say 果然厉害，恭喜你成为当代玄天大弟子！\n");
    command("chat 哈哈哈，到底是长江後浪推前浪，一代新人换旧人！\n");
    command("chat 恭喜" + ob->query("name") + "被推举为当代玄天大弟子！\n");
    me->set("fighting", 1);
    remove_call_out("do_copy");
    call_out("do_copy", 1, me, ob);
    return 1;
  }
  if (((int)ob->query("qi") * 100 / his_max_qi) < 50) {
    command("say 看来" + RANK_D->query_respect(ob) +
      "还得多加练习，方能在当今武林中出人头地 !\n");
    return 1;
  }
  return 1;
}
