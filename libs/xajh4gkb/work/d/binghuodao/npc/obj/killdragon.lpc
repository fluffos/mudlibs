//屠龙刀--名器
#include <ansi.h>
#include <weapon.h>
inherit BLADE;

void create()
{
	set_name(CYN "屠龙刀" NOR,({"tulong dao","dao"}));
	set_weight(50000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("icon", "10037");
		set("long", "此刀为郭靖黄蓉夫妇打造，是天下神兵。\n");	
		set("material", "steel");
//  	set("no_drop", "如此宝贵的武器再世难求啊。\n");
//		set("no_give", "送人？亏你想的出来！\n");	
//   	set("no_put", "珍惜它吧。\n");
		set("value",10000000);
		set("weapon_prop/strength", 20);
		set("weapon_prop/karma", 10);
		set("weapon_prop/dodge", 5);
		set("weapon_prop/blade", 40);
		set("weapon_prop/parry", 5);
		set("wield_msg", CYN "屠龙刀跃出刀鞘 ，放射出璀璨的毫光，天地为之变色。\n" NOR);
		set("unwield_msg", CYN "$N手中剑光渐渐暗淡，天幕渐渐焕出光芒。\n" NOR);
	}
	init_blade(550,2);	
	setup();
}
int query_autoload() { return 1; }	
