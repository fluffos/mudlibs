// cloth.c
//
// This is the basic equip for players just login.

inherit ITEM;
#include <ansi.h>

void create() {
  set_name("木筏", ({ "mufa" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "skin");
    set("value", 10000);
  }
  setup();
}
