inherit NPC;
void create()
{
	int jibie;
	jibie = 500;
//	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
    set_name("玄天弟子", ({ "men wei","men","wei"}) );
    set("gender", "男性" );
    set("age", 15);
    set("long", "无名老人收养的乞儿，寒真视为养子。\n");
    set("attitude", "peaceful");
    set("shen_type", -1);
    set("nickname", HIC "铁手"HIW"童子" NOR);
    set("str", 110);
    set("int", 90);
    set("con", 90);
    set("dex", 90);
    set("per", 25);
    set("max_qi", 6500000);
    set("max_jing", 150000);
    set("jing",15000);
    set("neili", 2000000);
    set("max_neili", 100000);
    set("wuyongjiali",1900);
    set("combat_exp", 30000000);
	set("score", 20); 
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("blade",500+jibie/3+random(jibie/5));
 // set_skill("yijing-force",500+jibie/3+random(jibie/5));  2016.5.26阿飞改，灵元心法改为玄天派内功
    set_skill("lingyuan-xinfa",500+jibie/3+random(jibie/5));	
    set_skill("lingyunbu", 500+jibie/3+random(jibie/5));
    set_skill("cuixin-zhang", 500+jibie/3+random(jibie/5));
    set_skill("tianxin-blade", 500+jibie/3+random(jibie/5));
    map_skill("force", "lingyuan-xinfa");
    map_skill("dodge", "lingyunbu");
    map_skill("parry", "cuixin-zhang");
    map_skill("unarmed", "cuixin-zhang");
    map_skill("blade", "tianxin-blade");
    create_family("玄天派",3,"弟子");
	setup();

    carry_object("/d/xuantian/obj/cloth")->wear();
    carry_object("/d/xuantian/obj/blade")->wield();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query("kar") < 22) {
                command("shake");
                command("say "+RANK_D->query_respect(ob)+"看上去不像福缘深厚之人。");
                return;
                  } 

     command("recruit "+ob->query("id"));
     return;
}