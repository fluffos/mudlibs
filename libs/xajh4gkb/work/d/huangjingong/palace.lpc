// by HAPP@YSZZ

inherit ROOM;

void create() {
  set("short", "黄金圣殿");
  set("long",
    @LONG
     p                  p         p
    /\     p      p    /\        /\
   /__\   /\_____/\   /__\      /__\
   |. |_=_|. . . .|_=_=_=_=_=_=_|. |
   |. |. .|  ___  |. . . . . . .|. |    雅典娜与此执法。
   |. |   | |   | |             |. |
 __|__|___|_|___|_|_____________|__|__
/          /   /                      \


LONG);

  set("exits", ([
    //			"down"  :       __DIR__"topalace3",
  ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/yadianna": 1,
    ]));
  set("outdoors", "12gong");
  setup();
}

int do_check(object me) {
  object where = this_object();
  object *obj;
  int i;
  obj = deep_inventory(where);
  if (!sizeof(obj)) return 0;
  for (i = 0; i < sizeof(obj); i++) {
    if (obj[i] == me) continue;
    if (userp(obj[i]))
      return 1;
  }
  return 0;
}
void init() {
  object monk, ob = this_player();
  if (userp(ob) && (!ob->query_temp("day_12gong/tiaozhan") || !ob->query_temp("day_12gong/winer") || (int)ob->query_temp("apply/damage") < 0)) {
    message_vision(HIY "虚空中传来一道空灵的声音：下界凡人，未得奥林神山召唤，不得进入黄金十二宫！\n" NOR, ob);
    ob->move("/d/city3/guangchang");
    return;
  }
  if (userp(ob) && (int)do_check(ob)) {
    message_vision("下界凡人，黄金圣斗士正在战斗中，你稍后再来！\n", ob);
    ob->move("/d/huangjingong/topalace3");
    return;
  }
  if (userp(ob) && ob->query_temp("day_12gong/tiaozhan") && ob->query_temp("day_12gong/winer")) {
    if (!objectp(monk = present("athena", environment(ob)))) {
      monk = new("/d/huangjingong/npc/yadianna.lpc");
      monk->move(environment(ob));
    }
    return;
  }
}
