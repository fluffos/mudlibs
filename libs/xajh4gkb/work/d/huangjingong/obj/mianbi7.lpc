//腊八粥，面壁双倍
inherit ITEM;

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "七星腊八粥" NOR, ({ "laba zhou", "zhou" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是以断肠蚀骨腐心草为主药熬制的腊八粥，十年才开一次花，食此粥后在侠客岛石洞参悟武功事半功倍。\n");
    set("value", 0);
    //		set("jianghu_money", 50);
    set("no_sell", 1);
    set("pinji", 7);
    //		set("no_drop",1);
    set("unit", "碗");
  }
  setup();
}
int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if ((int)this_player()->query("mianbi_add_time") >= (int)time()) {
    message_vision("$N端起腊八粥咕噜咕噜喝了下去。\n", this_player());
    tell_object(this_player(), "你觉得这碗粥没啥味道，还不如喝白开水呢。\n");
  } else {
    tell_object(this_player(), HIG "你吃下一碗腊八粥，顿然间只觉的灵台清明......。\n" NOR);
    this_player()->set("mianbi_add_time", (int)time() + this_object()->query("pinji") * 3600);
    message(
      "channel:chat",
      HIM "【镜花水月】：听说" HIW + this_player()->query("name") + HIM "豪情万丈，喝下一碗" + this_object()->query("name") + HIM "，开始了" + this_object()->query("pinji") + "小时的面壁加速。\n" NOR,
      users()
    );
    message_vision(
      HIW "$N喝下一碗" + this_object()->query("name") + HIW "，" + this_object()->query("pinji") + "小时侠客岛面壁加速时间开始计时.....！\n" NOR,
      this_player()
    );
    log_file(
      "cmds/Add_exp",
      sprintf(
        "%s(%s) 喝下一碗" + this_object()->query("name") + "，获得" + this_object()->query("pinji") + "小时侠客岛面壁加速时间 on %s\n",
        this_player()->query("name"),
        this_player()->query("id"),
        CHINESE_D->chinese_time(5, ctime(time()))
      )
    );
  }
  destruct(this_object());
  return 1;
}
