#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIM "女神圣衣" NOR, ({ "nvshen shengyi" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "智慧女神雅典娜的圣衣，拥有神奇的力量。\n");
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("value", 100000);
    set("material", "steel");
    set("armor_prop/armor", 500);
  }
  setup();
}
int query_autoload() { return 1; }
