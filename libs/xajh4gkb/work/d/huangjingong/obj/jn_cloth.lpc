#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name("金牛圣衣", ({ "jinniu shengyi", "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "steel");
    set("armor_prop/armor", 400);
  }
  setup();
}

int query_autoload() { return 1; }
