inherit NPC;
 
void create()
{
	int jibie;
	jibie = 5000;
	set_name("艾奥里亚", ({"shi zi","aiolia"}));
	set("long", "守护狮子宫黄金圣斗士，懂得多种光速拳，被称为“黄金狮子”。人马座·艾奥罗斯的弟弟，以勇猛刚强著称，极富正义与勇气，并一心想洗去兄长的污名。最初不承认纱织，在艾奥里斯的射手座黄金圣衣的肯定下向纱织发誓效忠。黄道十二宫中被双子座撒加用 “幻胧魔皇拳”所操纵，在狮子宫与星矢对战。幸有卡西欧士的牺牲，最后恢复清醒。冥界一战，一人杀六名冥斗士，用光速拳打败地伏星·蚯蚓·拉美。在冥王篇中最后因冥结界被弱化而败于冥界三巨头之一 天猛星·拉达曼迪斯手下。在叹息之墙前与哥哥相聚。在冥界为了击穿叹息之墙而逝去，为雅典娜献身。 \n");
	set("gender","男性");
	set("title", "【"+HIY"黄金圣斗士"+NOR"】");
	set("age",37);
	set("attitude", "peaceful");
	set("con",30);
	set("per",30);
	set("str",25);
	set("int",35);
	set("combat_exp",50000000);
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
	set("chat_chance",20);
	set("chat_msg", ({
			"艾奥里亚说道：不知何时能再见到雅典娜！\n"   
        }));
	set("jm/shengjian",1);
	set_skill("dodge", 500+jibie*2+(jibie/2));
	set_skill("force", 500+jibie*2+(jibie/2));
	set_skill("parry", 500+jibie*2+(jibie/2));
	set_skill("unarmed", 500+jibie*2+(jibie/2));
	set_skill("sword", 500+jibie*2+(jibie/2));
	set_skill("literate", 500+jibie*2+(jibie/2));
    set_skill("zhenfeng-xinfa", 500+jibie/2+(jibie/2));
    set_skill("qimen-wuxing",500+jibie/2+(jibie/2));
    set_skill("three-sword",500+jibie/2+(jibie/2));
    set_skill("zhentian-quan",500+jibie/2+(jibie/2));
	set_skill("piaoyibu",500+jibie/2+(jibie/2));
    map_skill("force", "zhenfeng-xinfa");
    map_skill("dodge", "piaoyibu");
    map_skill("unarmed", "zhentian-quan");
    map_skill("parry", "three-sword");
    map_skill("sword", "three-sword");

	setup();
	carry_object("/d/huangjingong/obj/sz_cloth")->wear();
	carry_object("/d/huangjingong/obj/westsword")->wield();
}

void just_kill(object guai,object player)
{
	if(!objectp(guai)||!objectp(player)) return ;
	if(environment(guai) != environment(player)) return ;
	if( environment(player)->query("no_fight") ) return ;
	if (!player->query_temp("day_12gong/tiaozhan"))
	{
		message_vision("下界凡人，未得奥林神山召唤，不得进入黄金十二宫！\n",player,guai);
		player->move("/d/city3/guangchang");
		return ;
	}
	else
	{
		if (!player->query_temp("day_12gong/winer5"))
		{
			message_vision("艾奥里亚冷声道：想见雅典娜，先过我这一关再说！\n",player,guai);
			guai->kill_ob(player);
			player->kill_ob(guai);
			return ;
		}
		else
		{
			message_vision("艾奥里亚微笑道：你已经通过我这一关了，赶紧往上走吧！\n",player,guai);
			player->move("/d/huangjingong/sz2sn1");
			return ;
		}
	}	

    return ;
}
void init()
{
	object ob, me;
    
	me = this_object();
    ob = this_player();

	// 怪物必须是可以动作的，并只针对玩家
	if ( !objectp(ob) || !living(me) || !playerp(ob) ) return;
	// 见面就杀
	//me->kill_ob(ob);	//这条表示见人就杀
	call_out("just_kill",1,me,ob);	//这条表示执行上述定义的just_kill这一段
}

void die()
{
    object me;        
    me = query_temp("last_damage_from");
	if (me && me->query_temp("day_12gong/tiaozhan"))
	{
		tell_room(environment(this_player()), "好大的胆子,竟敢来刺杀【女神】雅典娜！！！\n");
		tell_room(environment(this_player()), "恨啊.....．\n");
		me->set_temp("day_12gong/winer",1);
		me->set_temp("day_12gong/winer5",1);
		message("chat",HIM+"【黄金十二宫】"HIY"艾奥里亚:"+me->name()+HIY"已经强闯过我狮子宫，此人要刺杀女神雅典娜，大家全力截住他！\n"NOR,users());
		me->move("/d/huangjingong/sz2sn1");
	}
	::die();
}
