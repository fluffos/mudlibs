inherit NPC;

void create() {
  int jibie;
  jibie = 10000;
  set_name("修罗", ({ "mo jie", "shura" }));
  set(
    "long",
    "守护山羊宫黄金圣斗士，被喻为“最忠于雅典娜的圣斗士”，他的必杀技“Excalibur”有着可以将大地劈开的力量，其双手与双脚的破坏力，在黄金圣斗士中数一数二。在漫画版中，他与双鱼座、巨蟹座都是“力量就是正义”的信奉者；但在动画版中，他是在萨卡谋杀前教皇及暗杀雅典娜时，误信撒加的谎言，而在不知情的状况下追杀射手座·艾俄洛斯。在知道沙织就是雅典娜的真相之后，牺牲自己救回天龙座·紫龙，并把圣剑传授给他。在冥王篇中与撒加及卡妙一起为了将女神神圣衣秘密告诉雅典娜而闯十二宫，后在冥界为了击穿叹息之墙而逝去，为雅典娜献身。\n"
  );
  set("gender", "男性");
  set("title", "【" + HIY "黄金圣斗士" + NOR "】");
  set("age", 37);
  set("attitude", "peaceful");
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 100000000);
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
  set("chat_chance", 20);
  set("chat_msg", ({
    "修罗说道：不知何时能再见到雅典娜！\n"
  }));
  set("jm/nanhai", 1);
  set_skill("dodge", 500 + jibie * 2 + (jibie / 2));
  set_skill("force", 500 + jibie * 2 + (jibie / 2));
  set_skill("parry", 500 + jibie * 2 + (jibie / 2));
  set_skill("unarmed", 500 + jibie * 2 + (jibie / 2));
  set_skill("sword", 500 + jibie * 2 + (jibie / 2));
  set_skill("literate", 500 + jibie * 2 + (jibie / 2));
  set_skill("bitao-shengong", 500 + jibie / 2 + (jibie / 2));
  set_skill("feixian-jian", 500 + jibie / 2 + (jibie / 2));
  set_skill("baihua-zhang", 500 + jibie / 2 + (jibie / 2));
  set_skill("qiongya-bufa", 500 + jibie / 2 + (jibie / 2));
  map_skill("force", "bitao-shengong");
  map_skill("dodge", "qiongya-bufa");
  map_skill("unarmed", "baihua-zhang");
  map_skill("parry", "feixian-jian");
  map_skill("sword", "feixian-jian");

  setup();
  carry_object("/d/huangjingong/obj/mj_cloth")->wear();
  carry_object("/d/huangjingong/obj/westsword")->wield();
}

void just_kill(object guai, object player) {
  if (!objectp(guai) || !objectp(player)) return;
  if (environment(guai) != environment(player)) return;
  if (environment(player)->query("no_fight")) return;
  if (!player->query_temp("day_12gong/tiaozhan")) {
    message_vision("下界凡人，未得奥林神山召唤，不得进入黄金十二宫！\n", player, guai);
    player->move("/d/city3/guangchang");
    return;
  } else {
    if (!player->query_temp("day_12gong/winer10")) {
      message_vision("修罗冷声道：想见雅典娜，先过我这一关再说！\n", player, guai);
      guai->kill_ob(player);
      player->kill_ob(guai);
      return;
    } else {
      message_vision("修罗微笑道：你已经通过我这一关了，赶紧往上走吧！\n", player, guai);
      player->move("/d/huangjingong/mj2bp1");
      return;
    }
  }

  return;
}
void init() {
  object ob, me;

  me = this_object();
  ob = this_player();

  // 怪物必须是可以动作的，并只针对玩家
  if (!objectp(ob) || !living(me) || !playerp(ob)) return;
  // 见面就杀
  //me->kill_ob(ob);	//这条表示见人就杀
  call_out("just_kill", 1, me, ob);  //这条表示执行上述定义的just_kill这一段
}

void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && me->query_temp("day_12gong/tiaozhan")) {
    tell_room(environment(this_player()), "好大的胆子,竟敢来刺杀【女神】雅典娜！！！\n");
    tell_room(environment(this_player()), "恨啊.....．\n");
    me->set_temp("day_12gong/winer", 1);
    me->set_temp("day_12gong/winer10", 1);
    message(
      "chat",
      HIM + "【黄金十二宫】" HIY "修罗:" + me->name() + HIY "已经强闯过我山羊宫，此人要刺杀女神雅典娜，大家全力截住他！\n" NOR,
      users()
    );
    me->move("/d/huangjingong/mj2bp1");
  }
  ::die();
}
