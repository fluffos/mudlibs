inherit NPC;

void create() {
  int jibie;
  jibie = 2000;
  set_name("阿鲁迪巴", ({ "jin niu", " aldebaran" }));
  set(
    "long",
    "守护金牛宫黄金圣斗士，因体形巨大，被称为“黄金野牛”。是所有黄金圣斗士中长得最高大威武的一个，也是十二宫中最勇猛的人，为人最豪爽，头脑虽然不太灵活，但实力不凡。十二宫之战中因佩服星矢等人的勇气，遂建议“只要折下其圣衣的牛角，就可以让他们通过金牛宫”。性格豪迈，但多次被新敌人北欧神斗士 开阳星 黑虎 史特及 大羚鼯星 巴特、海将军 海魔女 苏兰特及冥斗士 地暗星 尼奥比突袭击败，可以说他是一个容易被敌人攻击的唯一对象。于冥界十二宫被冥斗士缪偷袭致死。在冥界为了击穿叹息之墙而逝去，为雅典娜献身。\n"
  );
  set("gender", "男性");
  set("title", "【" + HIY "黄金圣斗士" + NOR "】");
  set("attitude", "peaceful");
  set("age", 37);
  set("con", 30);
  set("per", 20);
  set("str", 30);
  set("int", 35);
  set("combat_exp", 20000000);
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
  set("chat_chance", 20);
  set("chat_msg", ({
    "阿鲁迪巴说道：不知何时能再见到雅典娜！\n"
  }));
  set("jm/huanhua", 1);
  set_skill("dodge", 500 + jibie * 2 + (jibie / 2));
  set_skill("force", 500 + jibie * 2 + (jibie / 2));
  set_skill("parry", 500 + jibie * 2 + (jibie / 2));
  set_skill("unarmed", 500 + jibie * 2 + (jibie / 2));
  set_skill("sword", 500 + jibie * 2 + (jibie / 2));
  set_skill("literate", 500 + jibie * 2 + (jibie / 2));
  set_skill("guiyuan-dafa", 500 + jibie / 2 + (jibie / 2));
  set_skill("feihua-wuping", 500 + jibie / 2 + (jibie / 2));
  set_skill("tiexian-quan", 500 + jibie / 2 + (jibie / 2));
  set_skill("huanhua-jian", 500 + jibie / 2 + (jibie / 2));
  map_skill("force", "guiyuan-dafa");
  map_skill("dodge", "lingxu-bu");
  map_skill("unarmed", "tiexian-quan");
  map_skill("parry", "tiexian-quan");
  map_skill("sword", "huanhua-jian");

  setup();
  carry_object("/d/huangjingong/obj/jn_cloth")->wear();
  carry_object("/d/huangjingong/obj/westsword")->wield();
}

void just_kill(object guai, object player) {
  if (!objectp(guai) || !objectp(player)) return;
  if (environment(guai) != environment(player)) return;
  if (environment(player)->query("no_fight")) return;
  if (!player->query_temp("day_12gong/tiaozhan")) {
    message_vision("下界凡人，未得奥林神山召唤，不得进入黄金十二宫！\n", player, guai);
    player->move("/d/city3/guangchang");
    return;
  } else {
    if (!player->query_temp("day_12gong/winer2")) {
      message_vision("阿鲁迪巴冷声道：想见雅典娜，先过我这一关再说！\n", player, guai);
      guai->kill_ob(player);
      player->kill_ob(guai);
      return;
    } else {
      message_vision("阿鲁迪巴微笑道：你已经通过我这一关了，赶紧往上走吧！\n", player, guai);
      player->move("/d/huangjingong/jn2sz1");
      return;
    }
  }

  return;
}
void init() {
  object ob, me;

  me = this_object();
  ob = this_player();

  // 怪物必须是可以动作的，并只针对玩家
  if (!objectp(ob) || !living(me) || !playerp(ob)) return;
  // 见面就杀
  //me->kill_ob(ob);	//这条表示见人就杀
  call_out("just_kill", 1, me, ob);  //这条表示执行上述定义的just_kill这一段
}

void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && me->query_temp("day_12gong/tiaozhan")) {
    tell_room(environment(this_player()), "好大的胆子,竟敢来刺杀【女神】雅典娜！！！\n");
    tell_room(environment(this_player()), "恨啊.....．\n");
    me->set_temp("day_12gong/winer", 1);
    me->set_temp("day_12gong/winer2", 1);
    message(
      "chat",
      HIM + "【黄金十二宫】" HIY "阿鲁迪巴:" + me->name() + HIY "已经强闯过我金牛宫，此人要刺杀女神雅典娜，大家全力截住他！\n" NOR,
      users()
    );
    me->move("/d/huangjingong/jn2sz1");
  }
  ::die();
}
