inherit NPC;
 
void create()
{
	int jibie;
	jibie = 6000;
	set_name("沙加", ({"chu nv","shaga"}));
	set("long", "守护处女宫的黄金圣斗士，是佛祖释迦牟尼的转生。最早领悟并能够自力不依靠女神雅典娜之血觉醒一瞬间第八感，因此被誉为“力量最接近神的人”。平日靠紧闭双眼牺牲视觉的处女座独有修行法来修行小宇宙。\n");
	set("gender","女性");
	set("title", "【"+HIY"黄金圣斗士"+NOR"】");
	set("age",37);
	set("attitude", "peaceful");
	set("con",30);
	set("per",30);
	set("str",25);
	set("int",35);
	set("combat_exp",60000000);
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
	set("chat_chance",20);
	set("chat_msg", ({
			"沙加说道：不知何时能再见到雅典娜！\n"   
        }));
	set("jm/lingjiu",1);
	set_skill("dodge", 500+jibie*2+(jibie/2));
	set_skill("force", 500+jibie*2+(jibie/2));
	set_skill("parry", 500+jibie*2+(jibie/2));
	set_skill("unarmed", 500+jibie*2+(jibie/2));
	set_skill("sword", 500+jibie*2+(jibie/2));
	set_skill("literate", 500+jibie*2+(jibie/2));
    set_skill("bahuang-gong", 500+jibie/2+(jibie/2));
    set_skill("tianyu-qijian",500+jibie/2+(jibie/2));
    set_skill("liuyang-zhang",500+jibie/2+(jibie/2));
    set_skill("yueying-wubu",500+jibie/2+(jibie/2));
    map_skill("force", "bahuang-gong");
    map_skill("dodge", "yueying-wubu");
    map_skill("unarmed", "liuyang-zhang");
    map_skill("parry", "liuyang-zhang");
    map_skill("sword", "tianyu-qijian");

	setup();
	carry_object("/d/huangjingong/obj/cv_cloth")->wear();
	carry_object("/d/huangjingong/obj/westsword")->wield();
}

void just_kill(object guai,object player)
{
	if(!objectp(guai)||!objectp(player)) return ;
	if(environment(guai) != environment(player)) return ;
	if( environment(player)->query("no_fight") ) return ;
	if (!player->query_temp("day_12gong/tiaozhan"))
	{
		message_vision("下界凡人，未得奥林神山召唤，不得进入黄金十二宫！\n",player,guai);
		player->move("/d/city3/guangchang");
		return ;
	}
	else
	{
		if (!player->query_temp("day_12gong/winer6"))
		{
			message_vision("沙加冷声道：想见雅典娜，先过我这一关再说！\n",player,guai);
			guai->kill_ob(player);
			player->kill_ob(guai);
			return ;
		}
		else
		{
			message_vision("沙加微笑道：你已经通过我这一关了，赶紧往上走吧！\n",player,guai);
			player->move("/d/huangjingong/cn2tc1");
			return ;
		}
	}	

    return ;
}
void init()
{
	object ob, me;
    
	me = this_object();
    ob = this_player();

	// 怪物必须是可以动作的，并只针对玩家
	if ( !objectp(ob) || !living(me) || !playerp(ob) ) return;
	// 见面就杀
	//me->kill_ob(ob);	//这条表示见人就杀
	call_out("just_kill",1,me,ob);	//这条表示执行上述定义的just_kill这一段
}

void die()
{
    object me;        
    me = query_temp("last_damage_from");
	if (me && me->query_temp("day_12gong/tiaozhan"))
	{
		tell_room(environment(this_player()), "好大的胆子,竟敢来刺杀【女神】雅典娜！！！\n");
		tell_room(environment(this_player()), "恨啊.....．\n");
		me->set_temp("day_12gong/winer",1);
		me->set_temp("day_12gong/winer6",1);
		message("chat",HIM+"【黄金十二宫】"HIY"沙加:"+me->name()+HIY"已经强闯过我处女宫，此人要刺杀女神雅典娜，大家全力截住他！\n"NOR,users());
		me->move("/d/huangjingong/cn2tc1");
	}
	::die();
}
