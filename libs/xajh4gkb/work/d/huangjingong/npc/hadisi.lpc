#include <localtime.h>
inherit NPC;
int mingjie_zhizhan();
void create() {
  int jibie;
  jibie = 10000;
  set_name("哈迪斯", ({ "hades" }));
  set("long", "哈迪斯是古希腊神话中的冥界之王，同时还是掌管瘟疫的神。\n");
  set("gender", "男性");
  set("title", "【" + HIY "冥王" + NOR "】");
  set("age", 37);
  set("attitude", "peaceful");
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("no_get", 1);
  set("combat_exp", 150000000);
  set("jm/mingjiao", 1);
  set("xyzx_sys/level", jibie + random(jibie / 5));  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
  set_skill("literate", 500 + jibie * 2 + (jibie / 2));
  set_skill("dodge", 500 + jibie * 2 + (jibie / 2));
  set_skill("force", 500 + jibie * 2 + (jibie / 2));
  set_skill("parry", 500 + jibie * 2 + (jibie / 2));
  set_skill("unarmed", 500 + jibie * 2 + (jibie / 2));
  set_skill("spear", 500 + jibie * 2 + (jibie / 2));
  set_skill("sword", 500 + jibie * 2 + (jibie / 2));
  set_skill("finger", 500 + jibie * 2 + (jibie / 2));
  set_skill("jiuyang-shengong", 500 + jibie / 2 + (jibie / 2));
  set_skill("qiankundanuoyi", 500 + jibie / 2 + (jibie / 2));
  set_skill("qingyunwu", 500 + jibie / 2 + (jibie / 2));
  set_skill("qishang-quan", 500 + jibie / 2 + (jibie / 2));
  set_skill("liaoyuan-spear", 500 + jibie / 2 + (jibie / 2));
  set_skill("shenghuo-ling", 500 + jibie / 2 + (jibie / 2));
  set_skill("xuantian-zhi", 500 + jibie / 2 + (jibie / 2));
  map_skill("force", "jiuyang-shengong");
  map_skill("dodge", "qingyunwu");
  map_skill("unarmed", "qishang-quan");
  map_skill("parry", "qiankundanuoyi");
  map_skill("spear", "liaoyuan-spear");
  map_skill("sword", "shenghuo-ling");
  map_skill("finger", "xuantian-zhi");

  set("inquiry", ([
    "冥界之战": (: mingjie_zhizhan :),
  ]));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: command("heihei") :),
    (: command("wield spear") :),
    (: command("unwield spear") :),
    (: command("wield sword") :),
    (: command("unwield sword") :),
  }));

  setup();
  carry_object("/d/huangjingong/obj/mingjie_cloth")->wear();
  carry_object("/d/huangjingong/obj/rose")->wear();
  carry_object("/d/huangjingong/obj/armor")->wear();
  carry_object("/d/huangjingong/obj/pifeng")->wear();
  carry_object("/d/huangjingong/obj/shield")->wear();
  carry_object("/clone/weapon/shihuang")->wield();
  carry_object("/d/songshan/obj/zhanlu-jian");
}

int mingjie_zhizhan() {
  object me, baoshi;
  int add_exp, add_pot, add_sco, renwu_exp_add;
  mixed *local;
  local = localtime(time());
  me = this_player();

  if (me->query("xyzx_sys/level") < 300) {
    write(HIW "哈迪斯冷笑道：就你这点实力也敢打黄金十二宫的主意？\n" NOR);
    return 1;
  }
  if (!me->query_temp("day_12gong/tiaozhan")) {
    if (local[LT_MDAY] == (int)me->query("day_12gong_timecd"))  //每天
    {
      write(HIR "哈迪斯看了你一眼: 黄金十二宫每天只开启一次，你没有机会了！\n" NOR);
      return 1;
    }
    if (me->query_temp("day_12gong/winer")) {
      write(HIW "哈迪斯冷冷的说道：你明显是雅典娜的奸细！\n" NOR);
      me->delete_temp("day_12gong/winer");
      return 1;
    }
    if (!me->query_temp("day_12gong/winer")) {
      write(HIC "哈迪斯冰冷的说道：冥界将席卷大地，你去将黄金十二宫铲除！\n" NOR);
      message(
        "party",
        HIM "【黄金十二宫】" + HIG "听说 " + me->name(1) + HIG "(" + me->query("id") + HIG ") 开始挑战黄金十二宫。\n" NOR,
        users()
      );
      me->set_temp("day_12gong/tiaozhan", 1);
      me->move("/d/huangjingong/toby1");
      return 1;
    }
  } else {
    if (local[LT_MDAY] == (int)me->query("day_12gong_timecd"))  //每天
    {
      write(HIR "哈迪斯看了你一眼: 黄金十二宫每天只开启一次，你只有一次击破的机会！\n" NOR);
      return 1;
    }
    if (!me->query_temp("day_12gong/winer")) {
      write(HIW "哈迪斯冷冷的说道：你个渣渣，连个最普通的黄金圣斗士都赢不了，要你何用！\n" NOR);
      me->delete_temp("day_12gong");
      return 1;
    }
    if (me->query_temp("day_12gong/winer")) {
      write(HIB "哈迪斯冷冷的说道：不错，不错，能摧毁黄金十二宫，果然实力了得！\n" NOR, me);
      if (me->query_temp("renwu_exp_add")) renwu_exp_add = (int)me->query_temp("renwu_exp_add", 1);
      add_exp = me->query_temp("day_12gong/winer1") + me->query_temp("day_12gong/winer2") + me->query_temp("day_12gong/winer3") + me->query_temp("day_12gong/winer4") + me->query_temp("day_12gong/winer5") + me->query_temp("day_12gong/winer6") + me->query_temp("day_12gong/winer7") + me->query_temp("day_12gong/winer8") + me->query_temp("day_12gong/winer9") + me->query_temp("day_12gong/winer10") + me->query_temp("day_12gong/winer11") + me->query_temp("day_12gong/winer12") + me->query_temp("day_12gong/winer13");
      if (add_exp > 12) tell_object(
        me,
        sprintf(WHT "你毁灭黄金十二宫，封印了雅典娜，获得了哈迪斯的奖励:\n你的实战等级提高了%s级！\n" NOR, chinese_number(add_exp))
      );
      else tell_object(
        me,
        sprintf(
          WHT "你毁灭" + chinese_number(add_exp) + "道黄金宫，获得了哈迪斯的奖励:\n你的实战等级提高了%s级！\n" NOR,
          chinese_number(add_exp)
        )
      );
      me->add("xyzx_sys/level", add_exp);
      add_pot = (add_exp * 2000000) * (renwu_exp_add + 100) / 100;
      tell_object(me, sprintf(HIY "\n获得了%s点潜能！\n" NOR, chinese_number(add_pot)));
      me->add("potential", add_pot);
      add_sco = (add_exp * 1000) * (renwu_exp_add + 100) / 100;
      tell_object(me, sprintf(YEL "江湖阅历增加了%s点！\n" NOR, chinese_number(add_sco)));
      me->add("score", add_sco);
      me->set("day_12gong_timecd", local[LT_MDAY]);
      if (add_exp > 12) {
        baoshi = new("/d/huangjingong/obj/mianbi");
        baoshi->move(me);
        message_vision(
          HIG "\n$N在圣战中摧毁了黄金十二宫，封印了雅典娜，冥王哈迪斯特奖励你 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
          me
        );
        message(
          "party",
          HIM "【黄金十二宫】" + HIG " " + me->name(1) + HIG " 实力超群，摧毁了黄金十二宫，封印了雅典娜，获得冥王哈迪斯奖励的 " HIM + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
          users()
        );
      } else {
        if (random(4) == 0) {
          baoshi = new("/d/huangjingong/obj/mianbi" + add_exp);
          baoshi->move(me);
          message_vision(
            HIG "\n$N在圣战中击败" + chinese_number(add_exp) + "位黄金圣斗士，额外获得了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
            me
          );
          message(
            "party",
            HIM "【黄金十二宫】" + HIM "听说 " HIG + me->name(1) + HIM " 在圣战中击败了" + chinese_number(add_exp) + "位黄金圣斗士，虽未能打倒雅典娜，但也获得了冥王哈迪斯奖励的 " HIM + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
            users()
          );
        } else
          message(
            "party",
            HIM "【黄金十二宫】" + HIG " " HIG + me->name(1) + HIG " 实力不菲，战胜了" + chinese_number(add_exp) + "位黄金圣斗士，虽未能打倒雅典娜，但也获得冥王哈迪斯的奖励。\n" NOR,
            users()
          );
      }

      me->delete_temp("day_12gong");
      me->add("renwu/huangjingong_tiaozhan", 1);
      return 1;
    }
  }
}
