inherit NPC;

void create() {
  int jibie;
  jibie = 4000;
  set_name("迪斯马斯克", ({ "ju xie", "death Mask" }));
  set(
    "long",
    "守护巨蟹宫黄金圣斗士。信奉“力量就是正义”，外出做任务时，常常不顾及是否会伤及无辜，出手狠烈，所以巨蟹宫内满布死人的颜面。他明知教皇的邪恶行为而甘愿臣服。被愤怒的天龙座·紫龙打入冥界。无论在电影版“真红少年传说”及冥王十二宫编，他仍然死不悔改。但在冥界为了击穿叹息之墙而逝去，为雅典娜献身。 \n"
  );
  set("gender", "男性");
  set("title", "【" + HIY "黄金圣斗士" + NOR "】");
  set("age", 37);
  set("attitude", "peaceful");
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 40000000);
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
  set("chat_chance", 20);
  set("chat_msg", ({
    "迪斯马斯克说道：不知何时能再见到雅典娜！\n"
  }));
  set("jm/meizhuang", 1);
  set_skill("dodge", 500 + jibie * 2 + (jibie / 2));
  set_skill("force", 500 + jibie * 2 + (jibie / 2));
  set_skill("parry", 500 + jibie * 2 + (jibie / 2));
  set_skill("unarmed", 500 + jibie * 2 + (jibie / 2));
  set_skill("sword", 500 + jibie * 2 + (jibie / 2));
  set_skill("literate", 500 + jibie * 2 + (jibie / 2));
  set_skill("wuzheng-xinfa", 500 + jibie / 2 + (jibie / 2));
  set_skill("yaoming-dodge", 500 + jibie / 2 + (jibie / 2));
  set_skill("wuyun-jianfa", 500 + jibie / 2 + (jibie / 2));
  set_skill("qixian-wuxingjian", 500 + jibie / 2 + (jibie / 2));
  set_skill("wuying-shenquan", 500 + jibie / 2 + (jibie / 2));
  map_skill("force", "wuzheng-xinfa");
  map_skill("dodge", "yaoming-dodge");
  map_skill("unarmed", "wuying-shenquan");
  map_skill("parry", "wuyun-jianfa");
  map_skill("sword", "qixian-wuxingjian");

  setup();
  carry_object("/d/huangjingong/obj/jx_cloth")->wear();
  carry_object("/d/huangjingong/obj/westsword")->wield();
}

void just_kill(object guai, object player) {
  if (!objectp(guai) || !objectp(player)) return;
  if (environment(guai) != environment(player)) return;
  if (environment(player)->query("no_fight")) return;
  if (!player->query_temp("day_12gong/tiaozhan")) {
    message_vision("下界凡人，未得奥林神山召唤，不得进入黄金十二宫！\n", player, guai);
    player->move("/d/city3/guangchang");
    return;
  } else {
    if (!player->query_temp("day_12gong/winer4")) {
      message_vision("迪斯马斯克冷声道：想见雅典娜，先过我这一关再说！\n", player, guai);
      guai->kill_ob(player);
      player->kill_ob(guai);
      return;
    } else {
      message_vision("迪斯马斯克微笑道：你已经通过我这一关了，赶紧往上走吧！\n", player, guai);
      player->move("/d/huangjingong/jx2sz1");
      return;
    }
  }

  return;
}
void init() {
  object ob, me;

  me = this_object();
  ob = this_player();

  // 怪物必须是可以动作的，并只针对玩家
  if (!objectp(ob) || !living(me) || !playerp(ob)) return;
  // 见面就杀
  //me->kill_ob(ob);	//这条表示见人就杀
  call_out("just_kill", 1, me, ob);  //这条表示执行上述定义的just_kill这一段
}

void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && me->query_temp("day_12gong/tiaozhan")) {
    tell_room(environment(this_player()), "好大的胆子,竟敢来刺杀【女神】雅典娜！！！\n");
    tell_room(environment(this_player()), "恨啊.....．\n");
    me->set_temp("day_12gong/winer", 1);
    me->set_temp("day_12gong/winer4", 1);
    message(
      "chat",
      HIM + "【黄金十二宫】" HIY "迪斯马斯克:" + me->name() + HIY "已经强闯过我巨蟹宫，此人要刺杀女神雅典娜，大家全力截住他！\n" NOR,
      users()
    );
    me->move("/d/huangjingong/jx2sz1");
  }
  ::die();
}
