// qqren.c 上官剑南

inherit NPC;
inherit F_MASTER;
int qingli_menhu();
int wumu_yishu();
void create()
{
	int jibie;
	jibie = 6000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("上官剑南", ( { "shangguan jiannan", "shangguan", "jiannan"}));
	set("nickname", "铁掌水上漂");
	set("long",
	    "这位上官帮主乃是一位侠义之士，铁掌帮自他接任后，力加整顿，多行侠\n"
	    "义之事，不过数年声势大振，在江湖上侵寻已可以与北方的丐帮分庭抗礼了。只是后来忽\n"
	    "然消声匿迹，不知所踪了。\n");
	set("gender", "男性");
	set("age", 80);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 45);
	set("int", 40);
	set("con", 48);
	set("dex", 44);

	set("max_qi", 1500000);
	set("max_jingli", 500000);
	set("jingli", 500000);
	set("max_jing", 1000000);
	set("neili", 15000000);
	set("max_neili", 1000);
	set("wuyongjiali", 50000);
	set("combat_exp", 1500000000);
	set("score", 500000);

	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("guiyuan-tunafa", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("shuishangpiao", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("tiezhang-zhangfa", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("literate", 500+jibie/3+random(jibie/5));
	set_skill("tiexue-hammer",500+jibie/3+random(jibie/5));
	set_skill("duanyun-fu", 500+jibie/3+random(jibie/5));
	set_skill("axe", 500+jibie/3+random(jibie/5));
	set_skill("hammer", 500+jibie/3+random(jibie/5));
	map_skill("force", "guiyuan-tunafa");
	map_skill("dodge", "shuishangpiao");
	map_skill("unarmed", "tiezhang-zhangfa");
	map_skill("parry", "tiezhang-zhangfa");
	map_skill("hammer", "tiexue-hammer");
	map_skill("axe", "duanyun-fu");
	
	create_family("铁掌帮", 13, "帮主");
	set("inquiry", ([
                    "清理门户" : (: qingli_menhu :),
					"武穆遗书" : (: wumu_yishu :),
	                ]));
	setup();
	carry_object("d/tiezhang/obj/black-cloth")->wear();
}

void attempt_apprentice(object ob)
{
	if (ob->query("gender") != "男性")
	{
		command("say 女子也要练铁掌吗？");
		return ;
	}
	if ((int)ob->query("shen") < 100000)
	{
		command("hehe");
		command("say 我上官剑南可不收心地不纯的人做徒弟。");
		return;
	}
	if ((int)ob->query("score") < 10000)
	{
		command("hehe");
		command("say 我上官剑南可不收不忠不义之人。");
		return;
	}
	if ((int)ob->query("str",1) < 30)
	{
		command("hehe");
		command("say 我铁掌帮的武功最注重臂力。");
		return;
	}
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
        command("say 是否应该去江湖中多加磨炼。");
		return ;
    }		 
	if ( ob->query_skill("guiyuan-tunafa",1) < 1000 )
	{
		command("say 这位"+RANK_D->query_respect(ob)+"对我铁掌帮内功似乎领会的不够。");
		command("say 是否应该多在这上面下点功夫。");
		return ;
	}
	command("say 好吧，我就收下你了。希望你苦练铁掌神功，将之发扬光大。");
	command("recruit " + ob->query("id"));
	return;
}

int recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
		add("apprentice_available", -1);
}

//铁掌帮解密
int qingli_menhu()
{
	object me;
	me = this_player();
	
	if ((string)me->query("family/family_name") == "铁掌帮" && me->query("family/master_id")=="shangguan jiannan" && (int)me->query_temp("jm_tiezhang3") && (int)me->query_temp("jm_tiezhang4"))
	{
		message_vision(HIC"上官剑南说道：当年奸臣当道，岳飞遭害，韩世忠被削除兵权，落职闲住！\n"
					"我领着一批兄弟在荆襄一带落草，后来入了铁掌帮。虽然身在草莽，却是念念不忘卫国杀敌、恢复故土。\n"
					"岂知南宋朝廷畏惧金人，对铁掌帮一伙义士非但不加奖助，反而派兵围剿。\n"
					"铁掌帮毕竟人少势弱，终于被打破山寨。\n"
					"铁掌帮本是忠义之士，没想到传给裘千仞后，为了那天下第一虚名，做下诸多恶事。\n" NOR,me);
		message_vision(HIC"上官剑南说道：吾徒可替为师清理门户，重整铁掌帮！\n" NOR,me);
		me->set_temp("jm_tiezhang5",1);
	}
	else 
	{
		message_vision(YEL"上官剑南说道：铁掌帮为忠义之帮，何来恶人需要清理？\n" NOR,me);
		message_vision(YEL"官剑南说道："+ RANK_D->query_respect(me) +"是不是对我帮有所误会？\n", me);
	}	
	return 1;
}
int wumu_yishu()
{
	object me;
	me = this_player();
	
	if ((string)me->query("family/family_name") == "铁掌帮" && me->query("family/master_id")=="shangguan jiannan" && (int)me->query_temp("jm_tiezhang6"))
	{
		message_vision(HIC"上官剑南说道：当年我带领铁掌帮众人，救助岳武穆。\n"
				"可恨奸臣当道，最终只护得岳元帅的遗书，就在铁掌山的某处洞穴中。\n" NOR,me);
		message_vision(HIC"上官剑南说道：若你能找回岳元帅的遗书，我可指点你铁掌的终极奥义！\n" NOR,me);
		me->set_temp("jm_tiezhang7",1);
	}
	else 
	{
		message_vision(YEL"上官剑南说道：武穆遗书？没听说过。\n" NOR,me);
		message_vision(YEL"官剑南怀疑的看了看你道："+ RANK_D->query_respect(me) +"是不是有什么企图？\n", me);
	}	
	return 1;
}
int accept_object(object me, object ob)
{

	if ( (string)ob->query("id") =="wumu yishu" )
	{
		if ((string)me->query("family/family_name") == "铁掌帮" && me->query("family/master_id")=="shangguan jiannan" && (int)me->query_temp("jm_tiezhang7") && me->query("id")==ob->query("owner"))
		{
			message_vision(HIC"上官剑南对你说道：哎！若有岳武穆，恐怕破碎山河早已收复。\n"NOR, me);
			message_vision(HIC"上官剑南对你说道：不错不错，这就是岳元帅的遗留之物。\n"NOR, me);
			message_vision(HIC"上官剑南对你说道：我铁掌帮今日就交给你了，尔当牢记忠义，重振铁掌帮！！！\n"NOR, me);
			message_vision(HIC"上官剑南对你说道：在我铁掌山最高的的中指峰，留有一道如来神掌，至今无人能够练成。\n"NOR, me);
			me->set_temp("jm_tiezhang8",1);
			return 1;
		} else
		{
			message_vision(HIY"上官剑南对你说道：多谢这位"+RANK_D->query_respect(me)+"，这本书卷我就笑纳了。\n"NOR,me);
			return 1;
		}
	}
	return 0;
}