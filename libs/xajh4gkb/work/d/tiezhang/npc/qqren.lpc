// qqren.c 裘千仞

inherit NPC;
inherit F_MASTER;
int tiezhang_henshan();
int huashan_lunjian();
int ask_shangguan();

void create() {
  int jibie;
  jibie = 4000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("裘千仞", ({ "qiu qianren", "qiu", "qianren", "ren" }));
  set("nickname", "铁掌水上漂");
  set("long",
    "他就是威震川湘的铁掌帮的帮主-铁掌水上漂裘千仞。\n"
    "他是一个白须老头，身穿黄葛短衫，右手挥着一把大蒲扇。\n");
  set("gender", "男性");
  set("age", 60);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 35);
  set("int", 30);
  set("con", 28);
  set("dex", 35);

  set("max_qi", 400000);
  set("max_jing", 300000);
  set("neili", 5000000);
  set("max_neili", 4000);
  set("wuyongjiali", 5000);
  set("combat_exp", 500000000);
  set("score", 400000);
  set_skill("hammer", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tiexue-hammer", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("guiyuan-tunafa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shuishangpiao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tiezhang-zhangfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("axe", 500 + jibie / 3 + random(jibie / 5));
  set_skill("duanyun-fu", 500 + jibie / 3 + random(jibie / 5));
  map_skill("hammer", "tiexue-hammer");
  map_skill("axe", "duanyun-fu");
  map_skill("force", "guiyuan-tunafa");
  map_skill("dodge", "shuishangpiao");
  map_skill("unarmed", "tiezhang-zhangfa");
  map_skill("parry", "tiezhang-zhangfa");

  create_family("铁掌帮", 14, "帮主");
  set("chat_chance", 2);
  set("chat_msg", ({
    "这里就是铁掌帮的总坛所在，你如没事，不要四处乱走，免招杀身之祸！！！\n",
  }));
  set("inquiry", ([
    "铁掌歼衡山": (: tiezhang_henshan :),
    "华山论剑": (: huashan_lunjian :),
    "上官剑南": (: ask_shangguan :),
  ]));

  setup();
  carry_object("d/tiezhang/obj/black-cloth")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("gender") != "男性") {
    command("say 女子也要练铁掌吗？");
    return;
  }
  if ((int)ob->query("shen") > -10000) {
    command("hehe");
    command("say 我裘千仞可不收心慈手软的人做徒弟。");
    return;
  }
  if ((int)ob->query("score") < 2000) {
    command("hehe");
    command("say 我看你对本帮不够忠诚啊。");
    return;
  }
  if ((int)ob->query("str", 1) < 30) {
    command("hehe");
    command("say 我铁掌帮的武功最注重臂力。");
    return;
  }
  if (ob->query_skill("guiyuan-tunafa", 1) < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我铁掌帮内功似乎领会的不够。");
    command("say 是否应该多在这上面下点功夫。");
    return;
  }
  command("say 好吧，我就收下你了。希望你苦练铁掌神功，将之发扬光大。");
  command("recruit " + ob->query("id"));
  return;
}

int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    add("apprentice_available", -1);
}
int ask_shangguan() {
  say("他是我师父。我在十三岁那年曾救过他，之后他感恩图报，将全\n"
    "身武功倾囊相受。可惜十年前，他在湖北遭人围攻而死！唉！\n");
  return 1;
}

//铁掌帮解密
int tiezhang_henshan() {
  object me;
  me = this_player();

  if ((string)me->query("family/family_name") == "铁掌帮") {
    message_vision(HIC "裘千仞说道：我铁掌帮当年在湘西办事，将衡山派打的一蹶不振，自此衡山派落入三流门派！\n" NOR, me);
    message_vision(
      HIC "裘千仞说道：" + RANK_D->query_respect(me) + "若想再现铁掌神威，可效仿当年“铁掌歼衡山”的事迹！\n" NOR,
      me
    );
    me->set_temp("jm_tiezhang1", 1);
  } else {
    message_vision(YEL "裘千仞哈哈一笑道：铁掌歼衡山乃本帮辉煌事迹。\n" NOR, me);
    message_vision(YEL "裘千仞说道：我帮铁掌乃天下数一数二的功夫，" + RANK_D->query_respect(me) + "是否想入我帮来！\n", me);
    return 1;
  }
  return 1;
}
int huashan_lunjian() {
  object me;
  me = this_player();

  if ((string)me->query("family/family_name") == "铁掌帮") {
    message_vision(HIG "裘千仞说道：当年第一次华山论剑，我的铁掌尚未练好，自知不是那臭道士的对手！\n" NOR, me);
    message_vision(HIG "裘千仞说道：第二次华山论剑，可恨那杨过坏我好事！\n" NOR, me);
    message_vision(HIG "裘千仞说道：昔年为了争那天下第一虚名，做下诸多错事！\n" NOR, me);
    message_vision(HIG "裘千仞说道：如今往事重提，诸般种种如过往云烟！\n他日受一灯大师点化，放下虚名，法号慈恩。\n" NOR, me);
    message_vision(HIG "裘千仞说道：" + RANK_D->query_respect(me) + "可代表我铁掌帮与那独臂大侠杨过较量一番！\n" NOR, me);
    me->set_temp("jm_tiezhang2", 1);
  } else {
    message_vision(YEL "裘千仞哈哈一笑道：华山论剑，我铁掌帮必将扬名天下。\n" NOR, me);
    message_vision(YEL "裘千仞说道：我隐居在铁掌峰下闭门苦练铁掌神功，今日出山，必能名震天下！\n", me);
    return 1;
  }
  return 1;
}
//丐帮解密，铁掌帮解密
void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "丐帮") {
    tell_room(environment(this_player()), "裘千仞大喝道：臭叫花子还想与我较量掌法！！！\n");
    tell_room(environment(this_player()), "铁掌镇乾坤！！！\n");
    tell_room(environment(this_player()), "裘千仞掌力反噬，脸上一会黑一会红，不一会死了.....．\n");
    me->set_temp("jm_gaibang/qiuqianren", 1);
  }
  if (me && (string)me->query("family/family_name") == "铁掌帮" && me->query("family/master_id") == "shangguan jiannan" && (int)me->query_temp("jm_tiezhang5")) {
    tell_room(environment(this_player()), "裘千仞说道：师傅当年将铁掌帮交给我，可我被天下第一的虚名迷住！！！\n");
    tell_room(environment(this_player()), "没想到报应不爽！！！\n");
    tell_room(environment(this_player()), "裘千仞掌力反噬，脸上一会黑一会红，不一会死了.....．\n");
    me->set_temp("jm_tiezhang6", 1);
  }
  ::die();
}
