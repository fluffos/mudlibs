inherit ROOM;
string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});
void create() {
  set("short", "中指峰");
  set("long", @LONG
    这里就是铁掌山的最高峰--中指峰。由于山势太高，峰顶仍存有
大量的积雪，白雪皑皑，在阳光的照射下，泛起一片耀眼的银光。纵目远
眺，湘西几百里景色尽收眼底，泸溪，辰溪如两条玉带，从山下缓缓流过
。远处那条白色的亮线，就是湘西的大江--沅江。
武林相传，有一种超凡入圣而又空前绝后的武功如来神掌，只有一式，但
威力霸道绝伦。据说铁掌帮的掌法就是一代奇人火云邪神观摩中指峰创立
的。历代铁掌帮高手均来此地参悟（canwu），试图能领悟如来神掌。
LONG);
  set("exits", ([ /* sizeof() == 1 */
    "southdown": __DIR__ "shanlu-9",
  ]));
  set("no_clean_up", 0);

  setup();
}


void init() {
  add_action("do_canwu", "canwu");
}

int do_canwu(string arg) {
  object me = this_player();

  string *poem = ({
    "岱宗夫如何？齐鲁青未了。造化钟神秀，阴阳割昏晓。荡胸生曾云，决眦入归鸟。会当凌绝顶，一览众山小。",
    "虚空落泉千仞直，雷奔入江不暂息。今古长如白练飞，一条界破青山色。",
    "挂席几千里，名山都未逢。泊舟浔阳郭，始见香炉峰。尝读远公传，永怀尘外踪。东林精舍近，日暮空闻钟。",
    "横看成岭侧成峰，远近高低各不同。不识庐山真面目，只缘身在此山中。",
    "一杯酒，问何似，身后名？人间万事，毫发常重泰山轻。悲莫悲生离别，乐莫乐新相识，儿女古今情。富贵非吾事，归与白鸥盟。",
    "万丈红泉落，迢迢半紫氛。奔流下杂树，洒落出重云。日照虹霓似，天清风雨闻。灵山多秀色，空水共氤氲。",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫参悟铁掌绝技。\n");
  if (!me->query_temp("jm_tiezhang8"))
    return notify_fail("你未得到上官帮主的指点，恐怕参悟不到什么。\n");
  if (me->query("jm/tiezhang"))
    return notify_fail("你已经领悟了如来神掌了，没必要再浪费精力。\n");
  if (me->query("family/family_name") != "铁掌帮")
    return notify_fail("不是铁掌帮传人，恐怕没法参悟铁掌绝技？\n");

  if (me->query_skill("guiyuan-tunafa", 1) < 1000) {
    tell_object(me, "你的归元吐纳法.......\n");
    return 1;
  }
  if (me->query_skill("tiezhang-zhangfa", 1) < 2000) {
    tell_object(me, "你的铁掌掌法.......\n");
    return 1;
  }
  if (me->query_skill("shuishangpiao", 1) < 2000) {
    tell_object(me, "你的水上漂.......\n");
    return 1;
  }
  if (me->query("jingli") < 1000) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }

  tell_object(me, HIW "你呼呼有声，演练着铁掌掌法......\n" NOR);
  message_vision("" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -500);
  me->start_busy(2);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/tiezhang", 1);
    me->add("family_score", 1);
    tell_object(me, HIB "你突然醒悟道：" HIY "原来铁掌十式归一可演练出如来神掌" HIR "！\n" NOR);
    tell_object(me, HIB "恭喜你融汇贯通了铁掌帮武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在中指峰演练铁掌，将铁掌十式融汇贯通，领悟出如来神掌绝技！\n" NOR,
      users()
    );
  }
  return 1;
}
