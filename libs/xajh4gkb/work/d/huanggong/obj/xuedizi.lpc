// 血滴子-名器
#include <ansi.h>
#include <weapon.h>
inherit THROWING;

void create() {
  set_name(HIR "血滴子" NOR, ({ "xuedi zi", "xuedi" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "乌黑的一柄兵器，似乎沾染了许多江湖英雄的鲜血，暗暗透出一股血腥的味。\n");
    set("value", 1000);
    set("material", "leather");
    set("wield_msg", "$N暗暗冷笑，抽身反手，撒出一件乌黑兵器。\n");
    set("unwield_msg", "$N暗自一声冷哼，不屑地收回血滴子。\n");
    set("throwing_num_max", 1);  //2018.10.8阿飞改，暗器中的名器与神器设置为无限数量
    set("no_get", 1);
    set("no_give", 1);
    set("no_put", 1);
    set("no_drop", 1);
    set("base_unit", "柄");
    set("base_weight", 20);
    set("base_value", 10);
    set("weapon_prop/unarmed", 15);
    set("weapon_prop/throwing", 30);
    set("weapon_prop/dexerity", 10);
    set("weapon_prop/dodge", 10);
    set("weapon_prop/parry", 10);
  }
  set_amount(1);
  init_throwing(450, 2);
  setup();
}
int query_autoload() { return 1; }
