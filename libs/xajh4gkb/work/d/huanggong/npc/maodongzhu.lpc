void die()
{
    object me;        
    me = query_temp("last_damage_from");
	if (me && (string)me->query("family/family_name") == "神龙教" && me->query_temp("jm_shenlong1"))
	{
		tell_room(environment(this_player()), "洪安通冷哼一声：这毛东珠拿了四十二章经竟敢不上交，死有余辜！！！\n");
		tell_room(environment(this_player()), "毛东珠大喊：教主，饶命！！！\n");
		tell_room(environment(this_player()), "毛东珠惨嚎一声，倒在地上，死了.....．\n");
		me->set_temp("jm_shenlong4",1);
	}
	::die();
}