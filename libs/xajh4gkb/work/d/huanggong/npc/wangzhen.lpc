// zuo.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
	int jibie;
	jibie = 5000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("王振", ( { "wang zhen", "wang" }) );
	set("title", HIY"太监总管"NOR);
	set("gender", "无性");
	set("class", "taijian");
	set("age", 55);
	set("attitude", "peaceful");
	set("str", 30);
	set("con", 30);
	set("dex", 30);
	set("int", 28);
	set("neili", 2240000);
	set("max_neili", 224000);
	set("wuyongjiali", 11230);
	set("max_qi",1200000);
	set("max_jing",521200);
	set("combat_exp", 8000000);
	set("shen_type", 0);
	set_skill("literate", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("kuihua-xinfa", 500+jibie/3+random(jibie/5));
	set_skill("pixie-jian", 500+jibie/3+random(jibie/5));
	set_skill("qinnashou", 500+jibie/3+random(jibie/5));
	map_skill("unarmed", "qinnashou");
	map_skill("sword", "pixie-jian");
	map_skill("parry", "pixie-jian");
	map_skill("dodge", "pixie-jian");
	map_skill("force", "kuihua-xinfa");

	setup();
	carry_object("d/songshan/obj/kuojian")->wield();
	carry_object("d/songshan/obj/yellow-cloth")->wear();
}


void die()
{
    object me;        
    me = query_temp("last_damage_from");
	if (me && (string)me->query("family/family_name") == "通吃帮" && me->query_temp("jm_tongchi3"))
	{
		tell_room(environment(this_player()), "土木堡之变实乃昏君所为！！！\n");
		tell_room(environment(this_player()), "瓦剌逐渐壮大，本朝当前国力强盛，理当先发制人！！！\n");
		tell_room(environment(this_player()), "然以优势之兵，却败的如此之残......王振头一歪，死了。\n");
		me->set_temp("jm_tongchi4",1);
	}
	::die();
}