// wenhua.c
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "紫禁之巅");
	set("long", @LONG
    这里是紫禁之塔的顶层，高耸入云。在塔颠可以眺望紫禁城的风光。
曾经白云城主叶孤城与西门吹雪在此地决战，引无数江湖人物尽折腰。
自此之后，紫禁之巅就成为江湖中高手决战之地。实力不够者切莫上来。
LONG
	);
	set("no_ansuan", 1);
	set("outdoors", "huanggong");
	set("exits", ([
	]));
//	set("no_clean_up", 0);

	setup();
}

void init()
{	
	add_action("do_fly", "fly");
	add_action("do_conjure", "conjure");
	add_action("do_jump", "jump");
}

int do_fly(string arg)
{
    object me;
    me = this_player();

	message_vision(HIR"紫禁之巅剑气弥漫，在这里御剑飞行很容易出事故。\n"NOR, me );
	message_vision(HIC"紫禁之巅只有高手才能上来，既然上来了，那就只能依靠自身实力下去(jump down)。\n"NOR, me );
	return 1;    
}  

int do_conjure(string arg)
{
    object me;
    me = this_player();

	message_vision(HIR"紫禁之巅剑气弥漫，在这里使用道家神通很容易出事故。\n"NOR, me );
	message_vision(HIC"紫禁之巅只有高手才能上来，既然上来了，那就只能依靠自身实力下去(jump down)。\n"NOR, me );
	return 1;   
}  

int do_jump(string arg)
{
    object me;
    me = this_player();
	if( !arg || arg=="" ) return 0;
    if( arg=="down" ) 
    {
        if (me->query_skill("dodge", 1) >= 5000)
		{
			message_vision("$N浑身颤抖着，向前一跃……\n",me);
            me->move("/d/huanggong/dianwai");
			me->unconcious();
		} else
		{
			message("rumor", HIR"【谣言四起】某人："HIW"听说" + me->query("name") + "一失足成千古恨，从紫禁之巅跳了下来。。。。\n"NOR, users() );
			me->die();
			return 1;			
		}

        return 1;
    }
} 
 