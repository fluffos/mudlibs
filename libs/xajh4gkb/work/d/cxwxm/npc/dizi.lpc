// dizi.c 
// marry 8.13

inherit NPC;
#include <ansi.h>

void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set_name("守门弟子", ({ "di zi", "di" }));
  set("long",
    "一个面带微笑，和蔼可亲的人\n");
  set("gender", "男性");
  set("jihao", 1);
  set("age", 18);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);

  set("max_qi", 5000);
  set("max_jing", 200);
  set("neili", 3000);
  set("max_neili", 3000);
  set("wuyongjiali", 0);
  set("combat_exp", 100000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wangran-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("cxwx-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("axe", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wangxiang-fufa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shuiyue", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));

  map_skill("force", "wangran-xinfa");
  map_skill("axe", "wangxiang-fufa");
  map_skill("parry", "wangxiang-fufa");
  map_skill("dodge", "shuiyue");
  map_skill("unarmed", "cxwx-quan");

  create_family("痴心妄想门", 8, "弟子");
  setup();
  carry_object("/d/cxwxm/obj/cloth")->wear();
  carry_object("/d/cxwxm/obj/axe")->wield();


}
