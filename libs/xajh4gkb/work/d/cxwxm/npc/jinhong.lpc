//yahuan.c
inherit NPC;
#include <ansi.h>
void create()
{
	int jibie;
	jibie = 7000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
	set_name("上官金虹", ({ "shangguan jinhong","jinhong" }) );
	set("gender", "男性" );
	set("attitude", "peaceful");
	set("age", 45);
	set("long", "金钱帮帮主，曾叱咤风云几十年，作恶多端。\n");
	set("title", HIG "金钱帮帮主" NOR);
	set("shen_type", -1);
	set("combat_exp", 100000000);
    set("max_neili",10000000);  	
    set("neili",15000000);  	
    set("max_jingli",500000);  	 	
    set("jingli",400000);  	
    set("max_jing",50000000);  	
    set("max_qi",100000000);  	
    set("shen",-3000000);
    set("wuyongjiali",50000);  	
	set("str", 30);
	set("dex", 30);
	set("con", 30);
	set("int", 30);
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("blade", 500+jibie/3+random(jibie/5));
	set_skill("literate", 500+jibie/3+random(jibie/5));
	set_skill("hunyuan-yiqi", 500+jibie/3+random(jibie/5));
	set_skill("cibei-dao", 500+jibie/3+random(jibie/5));
	set_skill("sanhua-zhang", 500+jibie/3+random(jibie/5));
	set_skill("qianye-shou", 500+jibie/3+random(jibie/5));
	set_skill("shaolin-shenfa", 500+jibie/3+random(jibie/5));
    map_skill("dodge", "shaolin-shenfa");
    map_skill("unarmed", "qianye-shou");
    map_skill("blade", "cibei-dao");
    map_skill("parry", "sanhua-zhang");
	map_skill("force", "hunyuan-yiqi");
	
	setup();
	carry_object("/clone/cloth/cloth")->wear();
       
}

void die()
{
    object me;        
    me = query_temp("last_damage_from");
	if (me && (string)me->query("family/family_name") == "圣剑魔宫" && (me->query("family/master_id")=="a fei" || me->query("family/master_id")=="jing wuming") && me->query_temp("jm_shengjian1"))
	{
		tell_room(environment(this_player()), "金钱落地，人头不保！！！金钱帮一夜之间，席卷天下，然皇图霸业亦是笑谈中。\n");
		tell_room(environment(this_player()), "上官有环，环在心，心中有欲，欲乃权，权乱天下，天下动风云，风云出我辈，我辈仰天歌，歌为笑皇图，皇图亦是空......一世枭雄名，名可留千古，千古我自悲。\n");
		tell_room(environment(this_player()), "一世枭雄上官金虹，死了.....．\n");
		me->set_temp("jm_shengjian3",1);
	}
	::die();
}