//marry 8.13
#include <weapon.h>

#include <ansi.h>

inherit AXE;

void create() {
  set_name(HIR "鬼斧" NOR, ({ "guifu", "axe" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 1000000);
    set("material", "blacksteel");
    set("long", "别看它尺寸巨大、其貌不扬，但却是痴心妄想门开山始祖用上古玄铁铸成的鬼斧。\n");
    set("wield_msg", "$N从背后拔出一柄亮晃晃$n握在手中　\n");
    set("unequip_msg", "$N将手中的$n插在背后。　\n");
    //              set("no_get",1); 
    //              set("no_drop",1); 
    //              set("no_give",1); 
    set("weapon_prop/dodge", 5);
    set("weapon_prop/dexerity", 10);
    set("weapon_prop/constitution", 10);
    set("weapon_prop/axe", 40);
    set("weapon_prop/force", 10);
  }


  init_axe(500, 2);
  setup();
}
int query_autoload() { return 1; }
