  "d/longquan/non/eat1",
  "d/longquan/non/eat2",
  "d/longquan/non/eat3",
  "d/longquan/non/eat4",
  "d/longquan/non/eat5"
});
string *kuang4 = ({
  "d/longquan/non/eat1",
  "d/longquan/non/eat2",
  "d/longquan/non/eat3",
  "d/longquan/non/eat4",
  "d/longquan/non/eat5",
  "d/longquan/non/eat6"
});
string *kuang5 = ({
  "d/longquan/non/eat1",
  "d/longquan/non/eat2",
  "d/longquan/non/eat3",
  "d/longquan/non/eat4",
  "d/longquan/non/eat5",
  "d/longquan/non/eat6",
  "d/longquan/non/eat7"
});
string *kuang6 = ({
  "d/longquan/non/eat1",
  "d/longquan/non/eat2",
  "d/longquan/non/eat3",
  "d/longquan/non/eat4",
  "d/longquan/non/eat5",
  "d/longquan/non/eat6",
  "d/longquan/non/eat7",
  "d/longquan/non/eat8"
});
string *kuang7 = ({
  "d/longquan/non/eat1",
  "d/longquan/non/eat2",
  "d/longquan/non/eat3",
  "d/longquan/non/eat4",
  "d/longquan/non/eat5",
  "d/longquan/non/eat6",
  "d/longquan/non/eat7",
  "d/longquan/non/eat8",
  "d/longquan/non/eat9"
});

void init() {
  add_action("do_zhongtian", "zhongtian");
}


void create() {
  set_name("农田", ({ "non tian", "tian" }));
  set_weight(500000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("no_drop", "不要乱丢，这东西打到人痛！\n");
    set("no_put", 1);
    set("no_get:", 1);
    set("long", "这是一块很好的农田，你可以用（zhongtian）来试试你的运气如何。\n");
  }
  setup();
}

int do_zhongtian() {
  object me = this_player();
  object obj;
  if (me->is_busy())
    return notify_fail("你现在很忙！不能种田！\n");
  if ((me->query("xyzx_sys/level") < 1000)) {
    tell_object(me, "你的经验不足！\n");
    return 1;
  }
  if (!(obj = present("chu tou", me))) {
    tell_object(me, "没锄头你用啥子种田。\n");
    return 1;
  }
  if ((me->query("jing") < 30)) {
    tell_object(me, "你的精力不能集中，不可以种田！\n");
    return 1;
  }
  if ((me->query("qi") < 50)) {
    tell_object(me, "你的身体状态太差，不能种田！\n");
    return 1;
  }
  if ((int)me->query_condition("skill2_busy")) {
    tell_object(me, "你刚刚才干过活,要休息一会了！\n");
    return 1;
  }

  message_vision(HIC "$N挥动锄头开始在田里挖了起来。\n" NOR, me);
  me->add("jing", -20);
  me->add("qi", -30);
  me->add("combat_exp", 20 + random(30));
  me->add("potential", 15 + random(15));
  me->apply_condition("skill2_busy", 1 + random(3));
  me->start_busy(4);
  call_out("zhongtian", 4, me);
  me->stop_busy();
  return 1;
}

int zhongtian(object me) {
  object ob, obj;
  obj = present("chu tou", me);
  if (random(20) < 5) {
    message_vision(HIG "$N突然听到『咔嚓一声』，锄头碰到一块石头，火星四溅，断了！\n" NOR, me);
    destruct(obj);
    return 1;
  }
  if (random(7) < 5) {
    message_vision(CYN "一阵耕作之后，$N什么也没收获到。\n" NOR, me);
    return 1;
  } else if ((int)me->query("work_skill/wunon") > 700) {
    message_vision(HIR "$N熟练的在田里干了一会，不一会儿就有了不错的收成。\n" NOR, me);
    me->add("work_skill/wunon", 1);
    if (random(100) < 2) {
      ob = new("clone/food/shoujingmaidan1");
      message(
        "channel:chat",
        HIR "【龙泉镇】" + HIM "听说 " HIG + me->name(1) + HIM " 在龙泉镇辛勤耕种，在田地里居然发现了 " HIM + ob->name(1) + "(" + ob->query("id") + ")。\n" NOR,
        users()
      );  //2016.6.15阿飞改，增加显示物品的id
    } else {
      ob = new(kuang7[random(9)]);
    }
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work_skill/wunon") > 600) {
    message_vision(HIR "$N熟练的在田里干了一会，不一会儿就有了较好的收成。\n" NOR, me);
    me->add("work_skill/wunon", 1);
    ob = new(kuang6[random(8)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work_skill/wunon") > 500) {
    message_vision(HIY "$N熟练的在田里干了一会，不一会儿就有了好的收成。\n" NOR, me);
    me->add("work_skill/wunon", 1);
    ob = new(kuang5[random(7)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work_skill/wunon") > 400) {
    message_vision(HIY "$N熟练的在田里干了一会，不一会儿就有了收成。\n" NOR, me);
    me->add("work_skill/wunon", 1);
    ob = new(kuang4[random(6)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work_skill/wunon") > 300) {
    message_vision(HIY "$N在田里干了一会，有了收成。\n" NOR, me);
    me->add("work_skill/wunon", 1);
    ob = new(kuang3[random(5)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work_skill/wunon") > 200) {
    message_vision(HIY "$N在田里干了一会，好长时间才有了收成。\n" NOR, me);
    me->add("work_skill/wunon", 1);
    ob = new(kuang2[random(4)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work_skill/wunon") > 100) {
    message_vision(HIY "$N在农田中锄来锄去，好不容易有了收成。\n" NOR, me);
    me->add("work_skill/wunon", 1);
    ob = new(kuang1[random(3)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else {
    message_vision(HIG "$N干了半天，终于有了一点收成。\n" NOR, me);
    me->add("work_skill/wunon", 1);
    ob = new(__DIR__ "eat1");
    ob->move(me);
    destruct(this_object());
  }
  return 1;
}
