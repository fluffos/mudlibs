// ying-kuang.c 矿脉
// 星星lywin 2000/8/27

#include <ansi.h>
inherit ITEM;  

string *kuang1=({"/d/longquan/kuang/tong-kuang","/d/longquan/kuang/tie-kuang"});
string *kuang2=({"/d/longquan/kuang/tong-kuang","/d/longquan/kuang/tie-kuang","/d/longquan/kuang/ying-kuang"});
string *kuang3=({"/d/longquan/kuang/tong-kuang","/d/longquan/kuang/tie-kuang","/d/longquan/kuang/ying-kuang","/d/longquan/kuang/jing-kuang"});
string *kuang4=({"/d/longquan/kuang/tong-kuang","/d/longquan/kuang/tie-kuang","/d/longquan/kuang/ying-kuang","/d/longquan/kuang/jing-kuang","/d/longquan/kuang/xuantie-kuang"});
string *kuang5=({"/d/longquan/kuang/tong-kuang","/d/longquan/kuang/tie-kuang","/d/longquan/kuang/ying-kuang","/d/longquan/kuang/jing-kuang","/d/longquan/kuang/xuantie-kuang","/d/longquan/kuang/hantie-kuang1"});
string *kuang6=({"/d/longquan/kuang/tong-kuang","/d/longquan/kuang/tie-kuang","/d/longquan/kuang/ying-kuang","/d/longquan/kuang/jing-kuang","/d/longquan/kuang/xuantie-kuang","/d/longquan/kuang/hantie-kuang1","/d/longquan/kuang/hantie-kuang2"});
string *kuang7=({"/d/longquan/kuang/tong-kuang","/d/longquan/kuang/tie-kuang","/d/longquan/kuang/ying-kuang","/d/longquan/kuang/jing-kuang","/d/longquan/kuang/xuantie-kuang","/d/longquan/kuang/hantie-kuang1","/d/longquan/kuang/hantie-kuang2","/d/longquan/kuang/hantie-kuang3"});
void init()
{
	add_action("do_wakuang", "wakuang");
}


void create() 
{
	set_name("矿脉",({"kuang mai", "mai"}));
	set_weight(500000000);
	if ( clonep() )
		set_default_object(__FILE__);
	else 
	{
		set("unit", "块");
		set("no_drop","不要乱丢，这东西打到人痛！\n");
		set("no_put",1);
		set("no_get:",1);
		set("long", "这是一条很好的矿脉，你可以用（wakuang）来试试你的运气如何。\n");
	}
	setup();
}

int do_wakuang()
{
	object me=this_player();
	object obj;
	if( me->is_busy() ) 
		return notify_fail("你现在很忙！不能挖矿！\n");
	if ((me->query("xyzx_sys/level") < 1000))
	{  
		tell_object(me,"你的经验不足！\n");
		return 1;
	}
	if ( !(obj = present("tie gao", me)) )
	{
		tell_object(me,"没铁镐你挖的动矿山吗。\n");
		return 1;
	}
	if ((me->query("jing") < 30))
	{  
		tell_object(me,"你的精力不能集中，不可以挖矿石！\n");
		return 1;
	}
	if ((me->query("qi") < 50 ))
	{
		tell_object(me,"你的身体状态太差，不能挖矿石！\n");
		return 1;
	}
	if ((int)me->query_condition("skill2_busy"))  
	{
		tell_object(me,"你刚刚才干过活,要休息一会了！\n");
		return 1;
	}

	message_vision(HIC"$N挥动铁镐开始在地上挖了起来。\n"NOR,me);
	me->add("jing",-20);
	me->add("qi",-30);
	me->add("combat_exp",40+random(20));
	me->add("potential",20+random(5));
	me->apply_condition("skill2_busy",1+random(3));
	me->start_busy(6);   
	call_out("wakuang",5,me);
	me->stop_busy();
	return 1;
}

int wakuang(object me)
{
	object ob,obj;   
	obj = present("tie gao", me);
	if ( random(20)<5 ) 
	{
		message_vision(HIG"$N突然听到『铛的一声』，铁镐折断了！\n"NOR, me);
		destruct(obj);
		return 1;
	}
	if (random(7)<5)
	{
		message_vision(CYN"一阵挖掘之后，$N什么也没挖到。\n"NOR,me);
		return 1;
	}
	else if ((int)me->query("work_skill/wakuang") > 700 )
	{
		message_vision(HIR"$N熟练的在矿脉中找来查去，不一会儿就找出一块上好矿石。\n"NOR,me); 
		me->add("work_skill/wakuang",1);
		if(random(100)<2)
		{
			ob=new("clone/food/zujingmaidan1");
			message("channel:chat", HIR"【龙泉镇】"+HIM"听说 "HIG+me->name(1)+HIM" 在龙泉镇艰苦挖矿，在矿脉深处居然发现了 "HIM+ob->name(1)+"("+ob->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
		}
		else
		{
			ob=new(kuang7[random(8)]);
		}
		ob->move(me);
		destruct(this_object());
		return 1;
	}
	else if ((int)me->query("work_skill/wakuang") > 600 )
	{
		message_vision(HIR"$N熟练的在矿脉中翻来覆去，不一会儿就找出一块好矿石。\n"NOR,me); 
		me->add("work_skill/wakuang",1);
		ob=new(kuang6[random(7)]);
		ob->move(me);
		destruct(this_object());
		return 1;
	}
	else if ((int)me->query("work_skill/wakuang") > 500 )
	{
		message_vision(HIY"$N熟练的在矿脉中找来查去，不一会儿就找出一块好矿石。\n"NOR,me); 
		me->add("work_skill/wakuang",1);
		ob=new(kuang5[random(6)]);
		ob->move(me);
		destruct(this_object());
		return 1;
	}
	else if ((int)me->query("work_skill/wakuang") > 400 )
	{
		message_vision(HIY"$N熟练的在矿脉中摸来摸去，不一会儿就找出一块好矿石。\n"NOR,me); 
		me->add("work_skill/wakuang",1);
		ob=new(kuang4[random(5)]);
		ob->move(me);
		destruct(this_object());
		return 1;
	}       
	else if ((int)me->query("work_skill/wakuang") > 300 )
	{
		message_vision(HIY"$N在矿脉中翻来覆去，找出一块好矿石。\n"NOR,me); 
		me->add("work_skill/wakuang",1);
		ob=new(kuang3[random(4)]);
		ob->move(me);
		destruct(this_object());
		return 1;
	}
	else if ((int)me->query("work_skill/wakuang") > 200 )
	{
		message_vision(HIY"$N在矿脉中找来查去，好久才找出一块矿石。\n"NOR,me); 
		me->add("work_skill/wakuang",1);
		ob=new(kuang2[random(3)]);
		ob->move(me);
		destruct(this_object());
		return 1;
	}
	else if ((int)me->query("work_skill/wakuang") > 100 )
	{
		message_vision(HIY"$N在矿脉中摸来摸去，好不容易找出一块矿石。\n"NOR,me); 
		me->add("work_skill/wakuang",1);
		ob=new(kuang1[random(2)]);
		ob->move(me);
		destruct(this_object());
		return 1;
	}
	else
	{ 
		message_vision(HIG"$N找了半天，终于发现其中一块石头是矿石。\n"NOR,me); 
		me->add("work_skill/wakuang",1);
		ob = new( __DIR__ "tong-kuang");
		ob->move(me);
		destruct(this_object());
	}
	return 1;
}
