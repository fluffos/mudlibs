    set("unit", "块");
//		set("no_drop","不要乱丢，这东西打到人痛！\n");
//		set("no_get",1);
//		set("no_give",1);
//		set("no_steal",1);
//		set("no_put",1);
        set( "value", 900 + random( 700 ) );
        set( "food_remaining", 20 );
        set( "food_supply", 50 );
}

int query_autoload() { return 1; }