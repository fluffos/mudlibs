// zhujia.c 铸甲房
// 星星lywin 2000/9/2 

#include <ansi.h>
inherit ROOM;
int do_penren(string arg);

void create() {
  set("short", "龙泉酒店海鲜房");
  set("long", @LONG
这是一间龙泉酒店海鲜房！四周都是乱七八糟的海鲜，人们
把捕到的的海鲜在这儿烧好以后就是各种上好的菜。
LONG
  );

  set("exits", ([
    "north": __DIR__ "jiujia",
  ]));
  set("no_fight", 1);
  set("no_beg", 1);
  set("no_steal", 1);
  setup();
}

void init() {
  add_action("do_penren", "shaoyu");
}

int do_penren(object ob) {
  object me, ob1;
  int b1;
  me = this_player();

  if (!(ob = present("yu1", me)) &&
    !(ob = present("yu2", me)) &&
    !(ob = present("yu3", me)) &&
    !(ob = present("yu4", me)) &&
    !(ob = present("yu5", me)) &&
    !(ob = present("yu6", me)) &&
    !(ob = present("yu7", me)) &&
    !(ob = present("yu8", me)) &&
    !(ob = present("yu9", me)))
    return notify_fail("你身上没有材料，如何做菜？\n");
  if ((me->query("xyzx_sys/level") < 1000))
    return notify_fail("你的经验不够，无法做菜。\n");
  if ((int)me->query("jing") < 100)
    return notify_fail("你的精力不足，无法做菜。\n");
  if (me->is_busy())
    return notify_fail("你现在很忙！不能做菜！\n");
  if (ob->query("ownmake"))
    return notify_fail("这是自造的武器！\n");
  if (ob->is_character() || ob->is_corpse())
    return notify_fail("看清楚一点，那不是做菜的材料。\n");
  if (userp(ob))
    return notify_fail("看清楚一点，那不是做菜的材料。\n");
  if ((int)me->query("qi") < 100)
    return notify_fail("你的体力不足，无法做菜。\n");
  if ((int)me->query("neili") < 150)
    return notify_fail("你的内力不足，无法做菜。\n");

  message_vision(HIY "$N先将海鲜放进锅中炒了起来。\n" NOR, me);
  message_vision(HIY "接着$N再拿出各种调料开始烧菜。\n" NOR, me);
  message_vision(HIY "不一会儿！一盘烧好的海鲜摆在了$N的面前。\n" NOR, me);
  message_vision(HIY "$N的经验和潜能增加了。\n" NOR, me);
  me->add("combat_exp", 20 + random(30));
  me->add("potential", 15 + random(15));
  me->add("jing", -30);
  me->add("qi", -30);
  me->add("neili", -30);
  me->start_busy(5);
  b1 = me->query("work_skill/shaoyu");
  if (ob->query("name") == "小红鱼") {
    destruct(ob);
    ob1 = new(__DIR__ "eat/cai2");
    ob1->set_name(GRN + me->name() + "烧的红烧鱼" + NOR, ({ "cai1", "haixian" }));
    ob1->set("value", 1000);
    ob1->move(me);
    me->add("work_skill/shaoyu", 1);
    return 1;
  }
  if (ob->query("name") == "小黄鱼") {
    destruct(ob);
    if (b1 < 100) {
      me->add("work_skill/shaoyu", 1);
      message_vision(HIY "由于你烹饪技术太低，菜根本不能吃！\n" NOR, me);
      return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
    }
    ob1 = new(__DIR__ "eat/cai2");
    ob1->set_name(CYN + me->name() + "烧的小黄鱼汤" + NOR, ({ "cai2", "haixian" }));
    ob1->set("value", 2000);
    ob1->move(me);
    me->add("work_skill/shaoyu", 1);
    return 1;
  }
  if (ob->query("name") == "大黄鱼") {
    destruct(ob);
    if (b1 < 200) {
      me->add("work_skill/shaoyu", 1);
      message_vision(HIY "由于你烹饪技术太低，菜根本不能吃！\n" NOR, me);
      return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
    }
    ob1 = new(__DIR__ "eat/cai2");
    ob1->set_name(HIW + me->name() + "烧的红烧大黄鱼" + NOR, ({ "cai3", "haixian" }));
    ob1->set("value", 3000);
    ob1->move(me);
    me->add("work_skill/shaoyu", 1);
    return 1;
  }
  if (ob->query("name") == "尤鱼") {
    destruct(ob);
    if (b1 < 300) {
      me->add("work_skill/shaoyu", 1);
      message_vision(HIY "由于你烹饪技术太低，菜根本不能吃！\n" NOR, me);
      return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
    }
    ob1 = new(__DIR__ "eat/cai2");
    ob1->set_name(HIY + me->name() + "炒的干煸尤鱼" + NOR, ({ "cai4", "haixian" }));
    ob1->set("value", 5000);
    ob1->move(me);
    me->add("work_skill/shaoyu", 1);
    return 1;
  }
  if (ob->query("name") == RED "对虾" NOR) {
    destruct(ob);
    if (b1 < 400) {
      me->add("work_skill/shaoyu", 1);
      message_vision(HIY "由于你烹饪技术太低，菜根本不能吃！\n" NOR, me);
      return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
    }
    ob1 = new(__DIR__ "eat/cai2");
    ob1->set_name(WHT + me->name() + "炒的蒸对虾" + NOR, ({ "cai5", "haixian" }));
    ob1->set("value", 8000);
    ob1->move(me);
    me->add("work_skill/shaoyu", 1);
    return 1;
  }
  if (ob->query("name") == HIC "海鳝" NOR) {
    destruct(ob);
    if (b1 < 500) {
      me->add("work_skill/shaoyu", 1);
      message_vision(HIY "由于你烹饪技术太低，菜根本不能吃！\n" NOR, me);
      return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
    }
    ob1 = new(__DIR__ "eat/cai2");
    ob1->set_name(HIG + me->name() + "做的梁溪脆鳝" + NOR, ({ "cai6", "haixian" }));
    ob1->set("value", 10000);
    ob1->move(me);
    me->add("work_skill/shaoyu", 1);
    return 1;
  }
  if (ob->query("name") == CYN "海参" NOR) {
    destruct(ob);
    if (b1 < 600) {
      me->add("work_skill/shaoyu", 1);
      message_vision(HIY "由于你烹饪技术太低，菜根本不能吃！\n" NOR, me);
      return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
    }
    ob1 = new(__DIR__ "eat/cai2");
    ob1->set_name(HIR + me->name() + "做的海参青蟹" + NOR, ({ "cai7", "haixian" }));
    ob1->set("value", 12000);
    ob1->move(me);
    me->add("work_skill/shaoyu", 1);
    return 1;
  }

  if (ob->query("name") == HIM "螃蟹" NOR) {
    destruct(ob);
    if (b1 < 700) {
      me->add("work_skill/shaoyu", 1);
      message_vision(HIY "由于你烹饪技术太低，菜根本不能吃！\n" NOR, me);
      return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
    }
    ob1 = new(__DIR__ "eat/cai2");
    ob1->set_name(HIM + me->name() + "做的油煎螃蟹" + NOR, ({ "cai8", "haixian" }));
    ob1->set("value", 20000);
    ob1->move(me);
    me->add("work_skill/shaoyu", 1);
    return 1;
  }
  if (ob->query("name") == HIR "百年龟" NOR) {
    destruct(ob);
    if (b1 < 800) {
      me->add("work_skill/shaoyu", 1);
      message_vision(HIY "由于你烹饪技术太低，菜根本不能吃！\n" NOR, me);
      return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
    }
    if (random(100) < 15) {
      ob1 = new("clone/food/shoujingmaidan6");
      message(
        "channel:chat",
        HIR "【龙泉酒店】" + HIM "听说 " HIG + me->name(1) + HIM " 在龙泉酒店使用百年龟做出了 " HIM + ob1->name(1) + "(" + ob1->query("id") + ")。\n" NOR,
        users()
      );  //2016.6.15阿飞改，增加显示物品的id
    } else {
      ob1 = new(__DIR__ "eat/cai2");
      ob1->set_name(HIR + me->name() + "做的百年乌龟汤" + NOR, ({ "cai9", "haixian" }));
      ob1->set("value", 20000);
    }
    ob1->move(me);
    me->add("work_skill/shaoyu", 1);
    return 1;
  }
}
