// longsword.c 长鞭

#include <weapon.h>
inherit WHIP;

void create()
{
	set_name("牛筋鞭", ({ "niujin bian", "bian","whip" }));
	set_weight(500);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄普通的牛筋鞭，由水牛筋编织而成。\n");
		set("value", 200000);
		set("material", "leather");
		set("wield_msg", "$N「唰」的一声抖出一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n卷回腰间。\n");
	}
	init_whip(300);
	setup();
}
