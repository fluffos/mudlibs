// zhujia.c 铸甲房
// 星星lywin 2000/9/2 

#include <ansi.h>
inherit ROOM;
int do_penren(string arg);

 void create()
{
	set("short", "龙泉酒店素食房");
	set("long", @LONG
这是一间龙泉酒店素食房！四周都是乱七八糟的素食，人们
把种出的的蔬菜在这儿烧好以后就是各种上好的菜。
LONG
        );

	set("exits", ([
			"west" : __DIR__"jiujia",
        ]));
	set("no_fight",1);
	set("no_beg",1);
	set("no_steal",1);
	setup();
}

void init()
{
	add_action("do_penren","shaocai");
}

int do_penren(object ob)
{
	object me,ob1;
	int b1;
	me = this_player();

	if (!(ob = present("big cabbage", me)) &&
	!(ob = present("carrot", me)) &&
	!(ob = present("small cabbage", me)) &&
	!(ob = present("bai he", me)) &&
	!(ob = present("mao sun", me)) &&
	!(ob = present("ya li", me)) &&
	!(ob = present("tao zi", me)) &&
	!(ob = present("xi gua", me)) &&
	!(ob = present("renshen guo", me)) )
		return notify_fail("你身上没有材料，如何做菜？\n");
	if ((me->query("xyzx_sys/level") < 1000))
		return notify_fail("你的经验不够，无法做菜。\n");
	if ( (int)me->query("jing")<100)
		return notify_fail("你的精力不足，无法做菜。\n");
	if( me->is_busy() )
		return notify_fail("你现在很忙！不能做菜！\n");
	if( ob->query("ownmake") )
		return notify_fail("这是自造的武器！\n");
	if( ob->is_character() || ob->is_corpse() )
		return notify_fail("看清楚一点，那不是做菜的材料。\n");
	if( userp(ob))
		return notify_fail("看清楚一点，那不是做菜的材料。\n");
	if ( (int)me->query("qi")<100)
		return notify_fail("你的体力不足，无法做菜。\n");
	if ( (int)me->query("neili")<150)
		return notify_fail("你的内力不足，无法做菜。\n");

	message_vision(HIY"$N先将蔬菜放进锅中炒了起来。\n"NOR,me); 
	message_vision(HIY"接着$N再拿出各种调料开始烧菜。\n"NOR,me); 
	message_vision(HIY"不一会儿！一盘烧好的小菜摆在了$N的面前。\n"NOR,me); 
	message_vision(HIY"$N的经验和潜能增加了。\n"NOR,me); 
	me->add("combat_exp",20+random(30));
	me->add("potential",20+random(15));
	me->add("jing",-20);
	me->add("qi",-20);
	me->add("neili",-20);
	me->start_busy(5); 
	b1 = me->query("work_skill/shaocai");
	if ( ob->query("name") =="大青菜" )
	{
		destruct(ob);             
		ob1=new(__DIR__"eat/cai1");
		ob1->set_name(GRN + me->name()+"烧的炒青菜"+NOR,({"cai1","sucai"}));
		ob1->set("value", 1000);
		ob1->move(me);
		me->add("work_skill/shaocai", 1);       
		return 1;
	}
	if ( ob->query("name") =="胡萝卜" )
	{
		destruct(ob);             
		if ( b1 < 100 ) 
		{
			me->add("work_skill/shaocai",1);
			message_vision(HIY"由于你烹饪技术太低，菜根本不能吃！\n"NOR,me); 
			return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
		}
		ob1=new(__DIR__"eat/cai1");
		ob1->set_name(CYN + me->name()+"烧的东北炒萝卜"+NOR,({"cai2","sucai"}));
		ob1->set("value", 2000);
		ob1->move(me);
		me->add("work_skill/shaocai", 1);       
		return 1;
	}
	if ( ob->query("name") =="小白菜" )
	{
		destruct(ob);             
		if ( b1 < 200 )
		{
			me->add("work_skill/shaocai",1);
			message_vision(HIY"由于你烹饪技术太低，菜根本不能吃！\n"NOR,me); 
			return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
		}
		ob1=new(__DIR__"eat/cai1");
		ob1->set_name(HIW + me->name()+"烧的炒白菜"+NOR,({"cai3","sucai"}));
		ob1->set("value", 3000);
		ob1->move(me);
		me->add("work_skill/shaocai", 1);       
		return 1;
	}
	if ( ob->query("name") =="百合" )
	{
		destruct(ob);             
		if ( b1 < 300 )
		{
			me->add("work_skill/shaocai",1);
			message_vision(HIY"由于你烹饪技术太低，菜根本不能吃！\n"NOR,me); 
			return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
		}
		ob1=new(__DIR__"eat/cai1");
		ob1->set_name(HIY + me->name()+"炒的绿叶百合"+NOR,({"cai4","sucai"}));
		ob1->set("value", 5000);
		ob1->move(me);
		me->add("work_skill/shaocai", 1);       
		return 1;
	}
	if ( ob->query("name") ==GRN"毛笋"NOR )
	{
		destruct(ob);             
		if ( b1 < 400 )
		{
			me->add("work_skill/shaocai",1);
			message_vision(HIY"由于你烹饪技术太低，菜根本不能吃！\n"NOR,me); 
			return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
		}
		ob1=new(__DIR__"eat/cai1");
		ob1->set_name(WHT + me->name()+"炒的四川毛笋"+NOR,({"cai5","sucai"}));
		ob1->set("value", 8000);
		ob1->move(me);
		me->add("work_skill/shaocai", 1);       
		return 1;
	}
	if ( ob->query("name") ==HIY"鸭梨"NOR )
	{
		destruct(ob);             
		if ( b1 < 500 )
		{
			me->add("work_skill/shaocai",1);
			message_vision(HIY"由于你烹饪技术太低，菜根本不能吃！\n"NOR,me); 
			return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
		}
		ob1=new(__DIR__"eat/cai1");
		ob1->set_name(HIG + me->name()+"做的鸭梨拼盘"+NOR,({"cai6","sucai"}));
		ob1->set("value", 10000);
		ob1->move(me);
		me->add("work_skill/shaocai", 1);       
		return 1;
	}
	if ( ob->query("name") ==GRN"西瓜"NOR )
	{
		destruct(ob);             
		if ( b1 < 600 )
		{
			me->add("work_skill/shaocai",1);
			message_vision(HIY"由于你烹饪技术太低，菜根本不能吃！\n"NOR,me); 
			return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
		}
		ob1=new(__DIR__"eat/cai1");
		ob1->set_name(HIR + me->name()+"做的西瓜拼盘"+NOR,({"cai7","sucai"}));
		ob1->set("value", 12000);
		ob1->move(me);
		me->add("work_skill/shaocai", 1);       
		return 1;
	}
	if ( ob->query("name") ==HIM"桃子"NOR )
	{
		destruct(ob);             
		if ( b1 < 700 )
		{
			me->add("work_skill/shaocai",1);
			message_vision(HIY"由于你烹饪技术太低，菜根本不能吃！\n"NOR,me); 
			return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
		}
		ob1=new(__DIR__"eat/cai1");
		ob1->set_name(HIR + me->name()+"做的桃子拼盘"+NOR,({"cai8","sucai"}));
		ob1->set("value", 20000);
		ob1->move(me);
		me->add("work_skill/shaocai", 1);       
		return 1;
	}
	if ( ob->query("name") ==HIR"人参果"NOR )
	{
		destruct(ob);             
		if ( b1 < 800 )
		{
			me->add("work_skill/shaocai",1);
			message_vision(HIY"由于你烹饪技术太低，菜根本不能吃！\n"NOR,me); 
			return notify_fail("由于你烹饪技术太低，菜根本不能吃！\n");
		}
		if(random(100)<15)
		{
			ob1=new("clone/food/shoujingmaidan4");
			message("channel:chat", HIR"【龙泉酒店】"+HIM"听说 "HIG+me->name(1)+HIM" 在龙泉酒店使用人参果做出了 "HIM+ob1->name(1)+"("+ob1->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
		}
		else
		{
			ob1=new(__DIR__"eat/cai1");
			ob1->set_name(HIR + me->name()+"做的人参果拼盘"+NOR,({"cai9","sucai"}));
			ob1->set("value", 20000);			
		}
		ob1->move(me);
		me->add("work_skill/shaocai", 1);       
		return 1;
	}
} 

