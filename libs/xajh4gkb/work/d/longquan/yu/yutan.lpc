  "d/longquan/yu/eat1",
  "d/longquan/yu/eat2",
  "d/longquan/yu/eat3",
  "d/longquan/yu/eat4",
  "d/longquan/yu/eat5"
});
string *kuang4 = ({
  "d/longquan/yu/eat1",
  "d/longquan/yu/eat2",
  "d/longquan/yu/eat3",
  "d/longquan/yu/eat4",
  "d/longquan/yu/eat5",
  "d/longquan/yu/eat6"
});
string *kuang5 = ({
  "d/longquan/yu/eat1",
  "d/longquan/yu/eat2",
  "d/longquan/yu/eat3",
  "d/longquan/yu/eat4",
  "d/longquan/yu/eat5",
