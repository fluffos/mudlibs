void init() {
  add_action("do_zaojiu", "zaojiu");
}


void create() {
  set_name("造酒场", ({ "zaojiuchang", "chang" }));
  set_weight(500000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "座");
    set("no_drop", "不要乱丢，这东西打到人痛！\n");
    set("no_put", 1);
    set("no_get:", 1);
    set("long", "这是一块很好的造酒场，你可以用（zaojiu）来试试你的运气如何。\n");
  }
  setup();
}

int do_zaojiu() {
  object me = this_player();

  if (me->is_busy())
    return notify_fail("你现在很忙！不能造酒！\n");
  if ((me->query("xyzx_sys/level") < 1000)) {
    tell_object(me, "你的经验不足！\n");
    return 1;
  }
  if ((me->query("jing") < 30)) {
    tell_object(me, "你的精力不能集中，不可以造酒！\n");
    return 1;
  }
  if ((me->query("qi") < 50)) {
    tell_object(me, "你的身体状态太差，不能造酒！\n");
    return 1;
  }
  if ((int)me->query_condition("skill2_busy")) {
    tell_object(me, "你刚刚才干过活,要休息一会了！\n");
    return 1;
  }

  message_vision(HIC "$N拿起造酒工具开始在造酒场里造酒。\n" NOR, me);
  me->add("jing", -40);
  me->add("qi", -50);
  me->add("combat_exp", 20 + random(30));
  me->add("potential", 15 + random(15));
  me->apply_condition("skill2_busy", 1 + random(3));
  me->start_busy(6);
  call_out("zaojiu", 5, me);
  me->stop_busy();
  return 1;
}

int zaojiu(object me) {
  object ob;

  if (random(7) < 5) {
    message_vision(CYN "一阵劳动之后，$N什么酒也没造出。\n" NOR, me);
    return 1;
  } else if ((int)me->query("work_skill/zaojiu") > 700) {
    message_vision(HIR "$N熟练的在造酒场做了一会，不一会儿就有了不错的收获。\n" NOR, me);
    me->add("work_skill/zaojiu", 1);
    if (random(100) < 2) {
      ob = new("clone/food/zujingmaidan2");
      message(
        "channel:chat",
        HIR "【龙泉酒坊】" + HIM "听说 " HIG + me->name(1) + HIM " 在龙泉酒坊酿造美酒，没想到居然制作出了 " HIM + ob->name(1) + "(" + ob->query("id") + ")。\n" NOR,
        users()
      );  //2016.6.15阿飞改，增加显示物品的id
    } else {
      ob = new(kuang7[random(9)]);
    }
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work_skill/zaojiu") > 600) {
    message_vision(HIR "$N熟练的在造酒场做了一会，不一会儿就有了好的收获。\n" NOR, me);
    me->add("work_skill/zaojiu", 1);
    ob = new(kuang6[random(8)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work_skill/zaojiu") > 500) {
    message_vision(HIY "$N熟练的在造酒场里干了一会，不一会儿就有了好的收获。\n" NOR, me);
    me->add("work_skill/zaojiu", 1);
    ob = new(kuang5[random(7)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work_skill/zaojiu") > 400) {
    message_vision(HIY "$N熟练的在造酒场里干了一会，不一会儿就有了收获。\n" NOR, me);
    me->add("work_skill/zaojiu", 1);
    ob = new(kuang4[random(6)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work_skill/zaojiu") > 300) {
    message_vision(HIY "$N在造酒场里干了一会，有了收获。\n" NOR, me);
    me->add("work_skill/zaojiu", 1);
    ob = new(kuang3[random(5)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work_skill/zaojiu") > 200) {
    message_vision(HIY "$N在造酒场里干了一会，好长时间才有了收获。\n" NOR, me);
    me->add("work_skill/zaojiu", 1);
    ob = new(kuang2[random(4)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work_skill/zaojiu") > 100) {
    message_vision(HIY "$N在造酒场中跑来跑去，好不容易有了收获。\n" NOR, me);
    me->add("work_skill/zaojiu", 1);
    ob = new(kuang1[random(3)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else {
    message_vision(HIG "$N造了半天的酒，终于有了一点收获。\n" NOR, me);
    me->add("work_skill/zaojiu", 1);
    ob = new(__DIR__ "eat1");
    ob->move(me);
    destruct(this_object());
  }
  return 1;
}
