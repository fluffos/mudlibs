// xiaofeng.c 萧峰(乔峰)
#include <ansi.h>
inherit NPC;
int check_skills(object ob);
int waiting(object me, object dest);
int checking(object me, object dest);
int do_back(object me);
int do_kill(object me, object dest);
void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("萧峰", ({ "xiao feng", "xiao", "feng" }));
  set("gender", "男性");
  set("nickname", HIB "铁掌降龙" NOR);
  set("age", 28);
  set("long",
    "他就是丐帮前任帮主，因被发现是契丹人而众叛亲离。\n"
    "在江湖上与燕子坞的慕荣复并称为「北乔峰，南慕荣」。\n"
    "他身穿一件普通的粗布褂子，腰间用一条麻绳随便一系。\n"
    "他身高六尺有余，体格十分魁梧，长有一张线条粗旷、十\n"
    "分男性化的脸庞，双目如电，炯炯有神。\n");
  set("attitude", "peaceful");
  set("str", 45);
  set("int", 30);
  set("con", 30);
  set("per", 19);
  set("dex", 30);
  set("chat_chance", 1);
  set("chat_msg", ({
    "萧峰叹了口气道：“唉……想不到我萧峰大好男儿，居然被马夫人这样一个女子所骗！\n",
    "萧峰喃喃道：“我们丐帮的「降龙十八掌」是天下最霸道的掌法。”\n",
    "萧峰喃喃道：“我实则负阿朱太多了，这阿紫又年幼无知，如何是好。”\n",
    (: random_move :),
  }));
  set("inquiry", ([
    "降龙十八掌": "据说降龙十八掌的真正秘密与屠龙刀倚天剑似乎有关系。\n",
    "丐帮": "东北西北东西北。\n",
    "拜师": "你可以去东城门的丐帮总舵拜鲁有脚。\n",
  ]));
  /*    set("qi", 4000);
    set("max_qi", 4000);
    set("jing", 1500);
    set("max_jing", 1500);
    set("neili", 40000);
    set("max_neili", 4000);
    set("wuyongjiali", 100);
    */
  set("combat_exp", 100000000);
  set("shen_type", 1);
  set("jm/gaibang", 1);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));             // 基本内功
  set_skill("huntian-qigong", 500 + jibie / 3 + random(jibie / 5));    // 混天气功
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));           // 基本拳脚
  set_skill("xianglong-zhang", 500 + jibie / 3 + random(jibie / 5));   // 降龙十八掌
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));             // 基本躲闪
  set_skill("xiaoyaoyou", 500 + jibie / 3 + random(jibie / 5));        // 逍遥游
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));             // 基本招架
  set_skill("begging", 500 + jibie / 3 + random(jibie / 5));            // 叫化绝活
  set_skill("checking", 500 + jibie / 3 + random(jibie / 5));           // 道听途说
  map_skill("force", "huntian-qigong");
  map_skill("unarmed", "xianglong-zhang");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("parry", "xianglong-zhang");

  setup();
  carry_object("/clone/cloth/linen")->wear();
}
void init() {
  object ob = this_player();
  object me = this_object();
  ::init();
  if (!is_killing(ob->query("id")) && living(me)) {
    remove_call_out("check_skills");
    call_out("check_skills", 1, ob);
  }
}
int check_skills(object ob) {
  mapping skl;
  object me;
  string *sname;
  int i, counter, ob_shen;
  if (!ob || environment(ob) != environment()) return 1;
  me = this_object();
  skl = ob->query_skills();
  if (!mapp(skl)) return 1;
  sname = sort_array(keys(skl), (: strcmp :));
  ob_shen = (int)ob->query("shen");
  counter = 0;
  for (i = 0; i < sizeof(skl); i++) {
    if (skl[sname[i]] >= 100)
      counter++;
  }
  if ((counter >= 3) && (ob_shen < -5000)) {
    me->set_leader(ob);

    if (!environment(me)->query("no_fight")) {
      call_out("do_kill", 1, me, ob);
      return 1;
    } else {
      call_out("waiting", 0, me, ob);
      return 1;
    }
  }
  return 1;
}
int do_kill(object me, object dest) {
  if (!me || !dest) return 1;
  if (objectp(dest) && present(dest, environment(me)) && !environment(me)->query("no_fight")) {
    message_vision(HIR "$N对$n说道：老子一见邪派高手就生气。" + RANK_D->query_rude(dest) + "，纳命来！\n" NOR, me, dest);
    me->set_leader(dest);
    me->kill_ob(dest);
    dest->fight_ob(me);
    call_out("checking", 0, me, dest);
  } else
    call_out("waiting", 1, me, dest);

  return 1;
}
int waiting(object me, object dest) {
  if (objectp(dest)) {
    if (dest->is_ghost()) {
      call_out("do_back", 1, me);
      return 1;
    } else if (me->is_fighting() && present(dest, environment(me))) {
      call_out("checking", 0, me);
      return 1;
    } else if (living(me) && !environment(dest)->query("no_fight")) {
      call_out("checking", 0, me);
      return 1;
    }
  }

  remove_call_out("waiting");
  call_out("waiting", 60, me);
  return 1;
}
int checking(object me, object dest) {
  object ob;
  string str;
  if (!me || !dest) return 1;
  str = dest->name(1);
  if (me->is_fighting()) {
    call_out("checking", 1, me);
    return 1;
  }
  if (objectp(ob = present("corpse", environment(me))))
    if (ob->query("victim_name") == str) {
      call_out("do_back", 1, me);
      return 1;
    }

  call_out("waiting", 0, me, dest);
  return 1;
}
int do_back(object me) {
  me->move("/d/city/dongdajie2");
  me->set("combat_exp", 1000000);
  message("vision", "萧峰走了过来，拍了拍身上的尘土，微微一笑说道：又除了一个坏蛋。\n", environment(), me);
  me->set_leader(0);
  return 1;
}

int accept_object(object me, object ob) {

  if ((string)ob->query("id") == "yitian jian") {
    message_vision("$N对$n说道：听说武林至尊，宝刀屠龙，倚天不出，谁与争锋！似乎这句箴言流传很久了，难道有什么秘密？\n", this_object(), me);
    message_vision("$N对$n说道：这把倚天剑看起来也就是锋利无比，似乎并无出奇之处？容我细细研究。\n", this_object(), me);
    message_vision("$N对$n说道：如果你能再找到屠龙刀的话，或许有可能解开这其中的秘密.........\n", this_object(), me);
    me->set_temp("tmark/yitian", 1);
    return 1;
  }
  if ((string)ob->query("id") == "tulong dao") {
    message_vision("$N对$n说道：听说武林至尊，宝刀屠龙，倚天不出，谁与争锋！似乎这句箴言流传很久了，难道有什么秘密？\n", this_object(), me);
    message_vision("$N对$n说道：这把屠龙刀看起来也就是厚重朴实，似乎并无出奇之处？容我细细研究。\n", this_object(), me);
    message_vision("$N对$n说道：如果你能再找到倚天剑的话，或许有可能解开这其中的秘密.........\n", this_object(), me);
    me->set_temp("tmark/tulong", 1);
    return 1;
  }
  if ((string)ob->query("id") == "xuantie jian") {
    if ((int)me->query_temp("tmark/yitian") && (int)me->query_temp("tmark/tulong") && (string)me->query("family/family_name") == "丐帮") {
      message_vision("$N对$n说道：稍等片刻，我将这三把绝世武器细细研究一番......\n", this_object(), me);
      message_vision("$N对$n说道：哈哈哈!!!!!!!!!然来如此！！！这倚天剑屠龙刀的内部居然是空的！！！\n", this_object(), me);
      message_vision("$N对$n说道：然来倚天剑屠龙刀均出自于玄铁重剑，将内力注入倚天剑屠龙刀之中，互砍之后会断掉！！！\n", this_object(), me);
      message_vision(
        "只见萧峰气运丹田，左手倚天剑，右手屠龙刀，猛然相碰！“咔嚓”一声，倚天剑屠龙刀断为两截，断痕处露出一道缝隙。>\n",
        this_object(),
        me
      );
      message_vision("$N对$n说道：这一页降龙秘籍你就拿去研究吧，希望你能将丐帮发扬光大，我已不想再涉入江湖是非了！\n", this_object(), me);
      ob = new("/clone/book/xianglong.lpc");
      ob->set("owner", me->query("id"));  //设定识别
      ob->move(this_player());
      me->set_temp("jm_gaibang2", 1);
      return 1;
    } else {
      message_vision("$N对$n说道：多谢了，这把宝剑就暂时由我来保管吧！匹夫无罪怀璧其罪啊！若流入江湖必将引起一场浩劫。\n", this_object(), me);
      return 1;
    }
  }

  return 0;
}
void die() {
  object obj, me;
  me = query_temp("last_damage_from");
  if (me && me->query("family/master_id") == "ding chunqiu" && me->query_temp("jm_xingxiu2")) {  //星宿派解密
    obj = new("d/xingxiu/obj/shenmuwangding");
    obj->set("owner", me->query("id"));  //设定识别
    obj->move(me);
    tell_room(environment(this_player()), "萧峰毒发攻心，脸现怪异之色，突然大笑三声，戛然而止，倒在地上，死了...\n");
    message_vision("你从萧峰尸体上搜出一个神木王鼎，偷偷的藏在袖中。\n", me);
  }
  if (me && (string)me->query("family/family_name") == "姑苏慕容" && (int)me->query_temp("jm_murong4")) {  //姑苏慕容解密
    tell_room(environment(this_player()), "你大笑一声道：北乔峰也不过如此，如何能位于南慕容之前...\n");
    me->set_temp("jm_murong5", 1);
  }
  ::die();
}
