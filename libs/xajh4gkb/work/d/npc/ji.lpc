//2018-11-25阿飞改，取消纪嫣然商人功能
inherit NPC;
//inherit F_DEALER;

void create()
{
	int jibie;
	jibie = 10000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name(HIG"纪嫣然"NOR, ({ "ji yanran", "ji" }));	
	set("title", HIC"碧云才女"NOR);	
	set("shen_type", 0);	
	set("gender", "女性");	
	set("age", 23);	
	set("long", "江南才女。\n");	
	set("no_get", 1);
	set("no_put", 1);
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
	set("per", 30);
	set("kar", 30);
	set("max_neili", 1100000);
	set("neili", 1100000);
	set("max_jingli", 1100000);
	set("jingli", 1100000);
	set("jm/yihua", 1);
	set_skill("unarmed", 500+jibie/2+random(jibie/3));
	set_skill("force", 500+jibie/2+random(jibie/3));
	set_skill("parry", 500+jibie/2+random(jibie/3));
	set_skill("dodge", 500+jibie/2+random(jibie/3));
	set_skill("sword", 500+jibie/2+random(jibie/3));
	set_skill("literate", 500+jibie/2+random(jibie/3));
	set_skill("mingyu-shengong", 500+jibie/2+random(jibie/3));
	set_skill("yifeng-jian", 500+jibie/2+random(jibie/3));
	set_skill("yihua-jiemu", 500+jibie/2+random(jibie/3));
	set_skill("jueqing-zhang", 500+jibie/2+random(jibie/3));
    map_skill("force", "mingyu-shengong");
    map_skill("dodge", "yihua-jiemu");
    map_skill("unarmed", "jueqing-zhang");
    map_skill("parry", "yihua-jiemu");
    map_skill("sword", "yifeng-jian");
	set("combat_exp", 100000000);	
	set("attitude", "friendly");
/*	set("vendor_goods", ({
		"/d/city/obj/sleepbag",	
		"/clone/drug/jinchuang",	
		"/clone/drug/yangjing",	
		}));*/
	set("chat_chance_combat", 20);	
    set("chat_msg_combat", ({
        (: command("wield sword") :),
        (: command("unwield sword") :),
    }) );
				   
	setup();
	carry_object("/d/city/npc/cloth/zi-dress.lpc");
	carry_object("/clone/cloth/huiyuan")->wear();
	carry_object("/clone/weapon/yuenv")->wield();
}
