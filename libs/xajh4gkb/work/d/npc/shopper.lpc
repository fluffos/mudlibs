// shopper.商城
inherit NPC;
void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}

void create() {
  int jibie;
  jibie = 10000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name(HIR "马云" NOR, ({ "ma yun", "shangcheng" }));
  set("title", HIC "江湖商城" NOR);
  set("gender", "男性");
  set("age", 35);
  set("long", "一代奇才，武林中的不败神话，无所不知，无所不能，功盖宇内。\n");
  set("attitude", "peaceful");
  set("str", 100);
  set("int", 100);
  set("con", 100);
  set("dex", 100);
  set("breakup", 1);
  set("neili", 15000000);
  set("max_neili", 5000);
  set("wuyongjiali", 50000);
  set("max_jingli", 50000);
  set("jingli", 100000);
  set("max_qi", 3500000);
  set("max_jing", 3500000);
  set("combat_exp", 1500000000);
  set("jm/taixuan", 1);
  set("jm/dugu", 1);
  set_skill("sword", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("dodge", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("parry", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("unarmed", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("force", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("taixuan-gong", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("dugu-jiujian", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("lonely-sword", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("qufeng", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("qimen-wuxing", 1000 + jibie / 5 + random(jibie / 10));
  map_skill("dodge", "taixuan-gong");
  map_skill("force", "taixuan-gong");
  map_skill("unarmed", "taixuan-gong");
  map_skill("parry", "lonely-sword");
  map_skill("sword", "dugu-jiujian");

  set("shopping_goods", ({
    "clone/shop/huanhun",
    "clone/shop/karwan",
    "clone/shop/perwan",
    "clone/shop/shenliwan",
    "clone/shop/unknowdan",
    "clone/shop/xiandan",
    "clone/shop/xisuidan",
    "clone/shop/huantong",
    "clone/shop/bili",
    "clone/shop/wuxing",
    "clone/shop/gengu",
    "clone/shop/shenfa",
    "clone/shop/yangyan",
    "clone/shop/shuangbei",
  }));
  setup();
  carry_object("/d/lingxiao/obj/ganjiang")->wield();
  carry_object("/clone/cloth/tianmojie")->wear();
  carry_object("/d/city/npc/cloth/feature")->wear();
  carry_object("/clone/cloth/battle_armor")->wear();
}
//2018.9.14阿飞改，增加一个商城系统
string value_string(int jianghu_money) {
  if (jianghu_money < 1) jianghu_money = 1;
  return jianghu_money + "江湖币";
}
int do_list() {
  string *goods;
  object *inv;
  int i;
  if (!living(this_object())) return 0;
  inv = all_inventory(this_object());
  if (!sizeof(inv) && !arrayp(goods = query("shopping_goods")))
    return notify_fail("目前没有可以卖的东西。\n");

  if (arrayp(goods = query("shopping_goods")) && sizeof(goods)) {
    printf("你可以向%s购买下列物品：\n", query("name"));
    printf(NOR YEL "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n" NOR);
    for (i = 0; i < sizeof(goods); i++) {
      printf(
        "  %-" + (30 + color_len(goods[i]->short())) + "s%s每%s %s\n",
        goods[i]->short(),
        HIY + ":℡ " + NOR,
        goods[i]->query("unit"),
        value_string(goods[i]->query("jianghu_money"))
      );
    }
    printf(NOR YEL "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n" NOR);
    return 1;
  } else
    return notify_fail(HIW "商城目前还没开业呢。\n" NOR);
  return 1;
}
int do_buy(string arg) {
  string *goods;
  object *inv, obj;
  int i;

  if (!living(this_object())) return 0;
  inv = all_inventory(this_object());

  if (!arg)
    return notify_fail("你要买什么东西？\n");
  if (!sizeof(inv) && !arrayp(goods = query("shopping_goods")))
    return notify_fail("目前没有可以卖的东西。\n");

  if (arrayp(goods = query("shopping_goods")) && sizeof(goods)) {
    if (member_array(arg, goods->query("id")) != -1) {
      for (i = 0; i < sizeof(goods); i++)
        if (arg == goods[i]->query("id")) obj = new(goods[i]);
      if ((int)this_player()->query("jianghu_money") && (int)this_player()->query("jianghu_money") >= (int)obj->query("jianghu_money")) {
        obj->move(this_player());
        this_player()->add("jianghu_money", -(int)obj->query("jianghu_money"));
        message_vision(
          HIG "$N向马云买下一" + obj->query("unit") + obj->query("name") + "。\n" NOR,
          this_player()
        );
      } else {
        return notify_fail(HIW "你的江湖币不够。\n" NOR);
      }

    } else {
      return notify_fail(HIW "你买的东西，马云也没有啊。\n" NOR);
    }
  } else
    return notify_fail(HIW "我看你是来找事的吧。\n" NOR);
  return 1;
}
