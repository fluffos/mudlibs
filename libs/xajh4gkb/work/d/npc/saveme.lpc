//wizer.c
#include <ansi.h>
#include <login.h>

inherit NPC;
inherit F_MASTER;
void create() {
  int jibie;
  jibie = 8000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性

  set_name("大魔道士--雅薇丝", ({ "ya weisi", "wizer" }));
  set("age", 3500);
  set("long", @STORY
一个穿著玄甲,带著面纱看不清面貌的神秘女子,传说她已经活了数	
千年的岁月,而且从没有人见过她的真面目,在面纱之下的面孔究竟
是如何呢??这是许多人所好奇的,是天使??还是魔鬼??
不知何故,在多年前她来到这个寒潭,并就此定居了下来,她的善心是	
全江湖人所共知的,不论你有什堋病痛,只要来找她(saveme),她就会	
帮你医治,要记得多多利用喔!!
STORY);

  set("chat_chance", 15);
  set("chat_msg", ({
    "大魔道士--雅薇丝闭上眼睛冥思．\n",
    "大魔道士--雅薇丝说道:沉睡在时空中的神秘力量....\n",
    "大魔道士--雅薇丝说道:现在藉著最美丽的创世女神的能力....\n",
    "大魔道士--雅薇丝说道:给予所有黑暗,愚蠢的一切...,平等地毁灭吧!!...\n",
  }));

  set("gender", "女性");
  set("combat_exp", 1500000000);
  set("max_neili", 1500);
  set("neili", 1500000);
  set("jingli", 1500000);
  set("max_jingli", 1500);
  set("max_qi", 150000);
  set("max_jing", 350000);
  set("wuyongjiali", 1500);
  set("jm/shaolin", 1);
  set_skill("unarmed", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("dodge", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("parry", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("sword", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("force", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("buddhism", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("literate", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("hunyuan-yiqi", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("wuying-jian", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("jingang-quan", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("banruo-zhang", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("yijinjing", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("shaolin-shenfa", 1000 + jibie / 5 + random(jibie / 10));
  map_skill("force", "yijinjing");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("parry", "banruo-zhang");
  map_skill("sword", "wuying-jian");
  map_skill("unarmed", "jingang-quan");

  setup();
  carry_object("clone/cloth/qiankun")->wear();
  carry_object("/clone/weapon/yixijian")->wield();
}

void init() {
  add_action("do_save_me", "saveme");
}

int do_save_me(object ob, string arg) {
  ob = this_player();
  if (ob->is_busy())
    return notify_fail("你上一个动作都未完成,对你施用法术不太好吧!\n");
  if (ob->is_fighting())
    return notify_fail("战斗中也想让我施用法术帮你恢复?这可是作弊行为哦!\n");

  ob->set("jing", ob->query("max_jing"));
  ob->set("qi", ob->query("max_qi"));
  ob->set("eff_qi", ob->query("max_qi"));
  ob->set("eff_jing", ob->query("max_jing"));
  ob->set("food", (int)ob->max_food_capacity());
  ob->set("water", (int)ob->max_water_capacity());
  ob->start_busy(3);
  message_vision(HIY "大魔道士--雅薇丝喃喃自语念道: 藉著水晶女神的力量...让这个受了伤的人回复吧!!\n" NOR, ob);
  message_vision(ob->query("name") + HIW "突然被一道光射中，觉的全身充满活力。\n" NOR, ob);
  return 1;
}

void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "少林派" && (int)me->query_temp("jm_shaolin8")) {  //少林派解密
    tell_room(environment(this_player()), "大魔道士--雅薇丝临死之际现出真身...\n");
    tell_room(environment(this_player()), "没想到居然是佛陀之身...然来这里镇压的是佛陀的心魔...\n");
    me->set_temp("jm_shaolin9", 1);
  }
  ::die();
}
