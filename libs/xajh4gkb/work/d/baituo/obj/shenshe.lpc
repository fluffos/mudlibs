//shenshe.c
inherit ITEM;
void create() {
  set_name("引路神蛇", ({ "shenshe" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一条有识路能力的神蛇，可以把主人带到白
		      驼山。(玩家键入gohome即可)\n");
    set("unit", "条");
    set("value", 0);
    set("no_drop", 1);
  }
}
void init() {
  if (!this_player()->is_ghost())
    add_action("do_gohome", "gohome");
}
int do_gohome() {
  object me = this_player();

  if (me->query("family/family_name") != "白驼山派")
    return notify_fail("你不是白驼山派弟子，「引路神蛇」不听你使唤。\n");
  if (me->over_encumbranced())
    return notify_fail("你的负荷过重，动弹不得。\n");
  if (me->is_busy())
    return notify_fail("你的动作还没有完成，不能移动。\n");
  if (environment(me)->query("no_fly"))
    return notify_fail("该房间不能使用「引路神蛇」。\n");
  if (me->is_fighting())
    return notify_fail("你处于战斗状态，如何能使用「引路神蛇」呢。\n");
  if (me->query_temp("cooldown"))
    return notify_fail("你刚用完技能，还是休息会吧。\n");

  message_vision("$N从怀中掏出「引路神蛇」，口里不知念了些什么，\n"
    + "就见「引路神蛇」吐吐芯子，一头扎入地道中，摇头摆尾地把$N往白驼山带去￣￣￣\n", me);
  me->move("/d/baituo/didao");
  call_out("yinlushenshe", 3, me);
  me->start_busy(3);
  return 1;
}

void yinlushenshe(object me) {
  tell_object(me, "你终于在引路神蛇的指引下，从白驼山地道钻了回来。\n\n");
  me->move("/d/baituo/damen");
}
