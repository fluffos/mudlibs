inherit ROOM;
string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});
void create() {
  set("short", "小茅屋");
  set("long", @LONG
小茅屋，屋顶茅草；巳被雨洗刷得泛白，古旧腐蚀不堪，屋前有一排栏
杆，田字窗。门前右上方，挂着一块匾仔细一看，字体歪歪斜斜，共写有
「通吃小筑」四字，刻划甚新，必是新造之物。而这些字，说它像乌龟爬
的，亦不为过，就像老鼠用尾巴沾上墨汁在桌上打转所留下来似的，怪里
怪气，无法想像。地板上刻有不少小字，虽然写的歪七八遭，但看起来似
乎很有深意，或许可以研究(yanjiu)一番。
LONG
  );
  set("exits", ([
    "east": __DIR__ "tingyuan",
  ]));
  set("objects", ([
  ]));
  setup();
  replace_program(ROOM);
}


void init() {
  add_action("do_yanjiu", "yanjiu");
}

int do_yanjiu(string arg) {
  object me = this_player();

  string *poem = ({
    "......犇......猋......囮......珄......甠......",
    "......竔......琞......悫......奡......弢......",
    "......骎......郬......両......屃......匰......",
    "......叧......厺......叓......叜......叞......",
    "......噧......囘......囙......囦......叾......",
    "......囬......圥......圱......屮......幷......",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫仔细研究地上的文字......\n");
  if (!me->query_temp("jm_tongchi5"))
    return notify_fail("你未得到通吃小霸王的口诀，没办法参悟这些文字。\n");
  if (me->query("jm/tongchi"))
    return notify_fail("你已经完全领悟了星辰地动绝技，不需要在这领悟了。\n");
  if (me->query("family/family_name") != "通吃帮")
    return notify_fail("不是通吃帮的弟子，小心小霸王砍人啊。\n");

  if (me->query_skill("fanyun-force", 1) < 1000 && me->query_skill("damo-force", 1) < 1000) {
    tell_object(me, "你的内功.......\n");
    return 1;
  }
  if (me->query_skill("guxing-sword", 1) < 2000) {
    tell_object(me, "你的孤星剑法.......\n");
    return 1;
  }
  if (me->query_skill("langzi-sword", 1) < 2000) {
    tell_object(me, "你的浪子剑法.......\n");
    return 1;
  }
  if (me->query_skill("piaomiao-shenfa", 1) < 2000) {
    tell_object(me, "你的缥缈身法.......\n");
    return 1;
  }
  if (me->query("jingli") < 1000) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }

  tell_object(me, HIW "你按照杨小邪的指点，将这些文字按照特别的顺序排列起来......你看的头昏脑涨。\n" NOR);
  message_vision("" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -500);
  me->start_busy(2);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/tongchi", 1);
    me->add("family_score", 1);
    tell_object(me, HIB "你突然醒悟道：" HIY "原来孤星剑法可以有此等威力" HIR "！\n" NOR);
    tell_object(me, HIB "恭喜你融汇贯通了通吃帮武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在通吃小筑居然领悟了通吃帮的星辰地动！\n" NOR,
      users()
    );
  }
  return 1;
}
