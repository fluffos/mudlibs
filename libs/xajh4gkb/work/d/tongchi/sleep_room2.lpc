inherit ROOM;
void create()
{
          set("short", "卧室");
        set("long", @LONG
通吃帮帮主杨小邪的卧室，房内的布置很平常，
墙角放着一张大床(bed)。
LONG
        );
        set("exits", ([
                   "east" : __DIR__"xiefj",
        ]));
        set("objects", ([
        ]));
        set("sleep_room", "1");
		set("obj_count" , 1);
        setup();
        replace_program(ROOM);
}

void init()
{
	add_action("do_search", "push");
	add_action("do_search", "move");
	add_action("do_search", "open");
}

int do_search(string arg)
{
	object me,obj;
	me = this_player();

	if( !arg || arg=="" ) return 0;

	if( arg=="bed" )
	{
		if( query("obj_count")>=1 ) 
		{
			write("你将床挪到一边，发现露出一个暗盒，里面似乎有本账册，不知道记得什么东西。\n");
			obj=new("/d/obj/quest/zhangben");
			obj->move(environment(me));
			set("obj_count", 0);     
			return 1;
		}
		else 
			return notify_fail("这里明显什么也没有，你在小霸王的床上想搜什么？\n");
	}
}