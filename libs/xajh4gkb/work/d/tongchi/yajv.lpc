inherit ROOM;
void create()
{
          set("short", "哑怪居");
        set("long", @LONG
哑怪居，通吃帮六怪之一哑怪郑无言的居所，哑怪由于不能言语，一般都呆在屋子里。
LONG
        );
        set("exits", ([
                  "west" : __DIR__"qinjv",
        ]));
        set("objects", ([
        "/d/tongchi/npc/yaguai":1,
        ]));
        setup();
        replace_program(ROOM);
}
