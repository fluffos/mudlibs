#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void greeting(object);
void init();
void create()
{
	int jibie;
	jibie = 1000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
          set_name("段克输", ({ "duan keshu", "duan"}));
          set("long","通吃帮六怪之一赌怪段克输\n");
        set("gender", "男性");
          set("age", 22); 
         set("nickname", HIR "赌怪" NOR);
          set("shen_type",0);
        set("attitude", "peaceful");

        set("str", 25);
        set("int", 25);
        set("con", 25);
        set("dex", 25);

        set("qi", 10000);
          set("max_qi", 7000);
         set("jing", 6000);
          set("max_jing", 6000);
          set("neili", 6000);
          set("max_neili", 6000);
        set("wuyongjiali", 200);

          set("combat_exp", 3200000);
        set("score", 10000);
          set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("sword",500+jibie/3+random(jibie/5));
         set_skill("unarmed",500+jibie/3+random(jibie/5));
        set_skill("dabei-zhang",500+jibie/3+random(jibie/5));
        set_skill("fanyun-force",500+jibie/3+random(jibie/5));
        set_skill("guxing-sword",500+jibie/3+random(jibie/5));
       set_skill("piaomiao-shenfa",500+jibie/3+random(jibie/5));

        map_skill("unarmed", "dabei-zhang");
        map_skill("force", "fanyun-force");
        map_skill("dodge", "piaomiao-shenfa");
        map_skill("parry", "dabei-zhang");
        map_skill("sword", "guxing-sword");

        prepare_skill("sword","guxing-sword");
          create_family("通吃帮",3,"弟子");
        setup();
    carry_object("/clone/cloth/cloth")->wear();
        carry_object("/clone/weapon/gangjian")->wield();
}

