#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int damo_xinfa();
int tongchi_xiaozhu();

void create() {
  int jibie;
  jibie = 6000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("杨小邪", ({ "yang xiaoxie", "yang" }));
  set("long", "他就是通吃帮帮主,小邪神-杨小邪\n");
  set("gender", "男性");
  set("age", 19);
  set("nickname", HIG "通吃小霸王" NOR);
  set("shen_type", 0);
  set("attitude", "peaceful");
  set("str", 65);
  set("int", 65);
  set("con", 65);
  set("dex", 65);
  set("kar", 65);
  set("qi", 40000);
  set("max_qi", 40000);
  set("neili", 8000);
  set("max_jing", 8000);
  set("neili", 9000);
  set("max_neili", 9000);
  set("wuyongjiali", 1000);
  set("combat_exp", 50000000);
  set("score", 10000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dabei-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("damo-force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("fanyun-force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("guxing-sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("langzi-sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("piaomiao-shenfa", 500 + jibie / 3 + random(jibie / 5));
  map_skill("unarmed", "dabei-zhang");
  map_skill("force", "damo-force");
  map_skill("dodge", "piaomiao-shenfa");
  map_skill("parry", "dabei-zhang");
  map_skill("sword", "langzi-sword");

  create_family("通吃帮", 1, "帮主");
  set("inquiry", ([
    "达摩心法": (: damo_xinfa :),
    "通吃小筑": (: tongchi_xiaozhu :),
  ]));

  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/gangjian")->wield();
}

void attempt_apprentice(object ob) {

  if ((string)ob->query("gender") == "无性") {
    command("say 这位公公不要开玩笑了。");
    command("say 这位" + RANK_D->query_respect(ob) + "还是快去伺候皇上吧！");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    command("say 是否应该去江湖中多加磨炼。");
    return;
  }
  if ((int)ob->query("dex", 1) < 30) {
    command("say 混江湖最重要的是能打则打，打不过就跑，你这身法恐怕跑不了吧。");
    return;
  }
  if ((int)ob->query_skill("fanyun-force", 1) < 1000) {
    command("say 你的翻云神功还学的不够啊。");
    return;
  }
  message(
    "vision",
    HIM "〖英雄传闻〗" NOR + ":" + HIR " 听说" HIW + ob->short() + NOR HIB "拜入通吃帮帮主杨小邪门下!\n" NOR,
    users()
  );
  command("recruit " + ob->query("id"));
  return;
}
//通吃帮解密
int damo_xinfa() {
  object me;
  me = this_player();

  if ((string)me->query("family/family_name") == "通吃帮") {
    message_vision(HIG "杨小邪说道：本帮当年救了大悲老人，临死之前，告知本帮一个秘密。！\n" NOR, me);
    message_vision(HIG "杨小邪说道：在少林寺藏经楼的书架中，暗藏着一本内功秘籍！\n" NOR, me);
    message_vision(HIG "杨小邪说道：若你能取来此秘籍，我将指点你通吃心得！\n" NOR, me);
    me->set_temp("jm_tongchi1", 1);
  } else {
    message_vision(YEL "杨小邪说道：这是少林寺达摩祖师的内功心法，我如何知晓！\n" NOR, me);
    message_vision(YEL "杨小邪嘿嘿一笑！！\n", me);
    message_vision(YEL "杨小邪说道：我看你是想污蔑本帮吧。\n" NOR, me);
    return 1;
  }

  return 1;
}
int tongchi_xiaozhu() {
  object me;
  me = this_player();

  if ((string)me->query("family/family_name") == "通吃帮" && me->query("family/master_id") == "yang xiaoxie" && (int)me->query_temp("jm_tongchi4")) {
    message_vision(HIG "杨小邪说道：" + RANK_D->query_respect(me) + "为我帮立下大功，我在通吃小筑留了一些文字！\n" NOR, me);
    message_vision(HIG "杨小邪说道：嘿嘿！要想参悟我留下的文字，若不得到我的口诀......你懂的。\n" NOR, me);
    message_vision(HIG "杨小邪在你耳边轻轻的说道：ㄓㄜㄞゅぬみ奤锕！你一脸懵逼！\n" NOR, me);
    message_vision(HIG "杨小邪说道：好了，你按照我传授的口诀，或许能在通吃小筑领悟到什么！\n" NOR, me);
    me->set_temp("jm_tongchi5", 1);
  } else {
    message_vision(YEL "杨小邪说道：那是我建的一栋茅草屋，你问这干什么？\n" NOR, me);
    message_vision(YEL "杨小邪嘿嘿一笑！！\n", me);
    message_vision(YEL "杨小邪说道：你于我帮无任何功劳，我是不会告诉你的。\n" NOR, me);
    return 1;
  }

  return 1;
}
int accept_object(object me, object ob) {
  if ((string)ob->query("id") == "bo juan") {
    if ((string)me->query("family/family_name") == "通吃帮" && me->query("id") == ob->query("owner") && (int)me->query_temp("jm_tongchi2")) {
      message_vision(HIC "$N对$n说道：当年大悲老人留下的遗言居然是真的！\n" NOR, me);
      message_vision(HIC "$N对$n说道：不错不错，这位" + RANK_D->query_respect(me) + "果然与我有缘......\n" NOR, me);
      message_vision(HIC "$N对$n说道：本帮又多出了一种内功心法，" + RANK_D->query_respect(me) + "功莫大焉！！！\n" NOR, me);
      message_vision(
        HIC "$N对$n说道：我派武功均刻写在通吃小筑！！！\n" + "当年土木堡之变，大太监王振卖国，这位" + RANK_D->query_respect(me) + "若能为我帮铲除此此人，或许我可以指点你一番。\n" NOR,
        me
      );
      me->set_temp("jm_tongchi3", 1);
      return 1;
    } else {
      message_vision(HIC "$N对$n说道：多谢这位" + RANK_D->query_respect(me) + "，这本秘籍我就笑纳了。\n" NOR, me);
      return 1;
    }
  }

  return 0;
}
