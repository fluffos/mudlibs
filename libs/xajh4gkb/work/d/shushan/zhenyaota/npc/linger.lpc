//Cracked by Roath
//Ansi 99.12
inherit NPC;
inherit F_MASTER;

void create() {
  int jibie;
  jibie = 8000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("赵灵儿", ({ "zhao linger", "linger" }));
  set("title", "女娲传人");
  set("long", "赵灵儿是女涡之后，当然是半人蛇。\n");
  set("gender", "女性");
  set("age", 15);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("kar", 30);
  set("per", 30);
  set("class", "xian");
  set("qi", 2000);
  set("max_qi", 2000);
  set("jing", 3000);
  set("max_jing", 3000);
  set("neili", 4000);
  set("max_neili", 2000);
  set("neili_factor", 60);
  set("combat_exp", 15000000);
  set("max_jingli", 2000);
  set("jingli", 2000);
  set("wuyongjiali", 2000);
  set_skill("unarmed", 500 + jibie * 2 + random(jibie / 5));
  set_skill("hand", 500 + jibie * 2 + random(jibie / 5));
  set_skill("whip", 500 + jibie * 2 + random(jibie / 5));
  set_skill("blade", 500 + jibie * 2 + random(jibie / 5));
  set_skill("dodge", 500 + jibie * 2 + random(jibie / 5));
  set_skill("parry", 500 + jibie * 2 + random(jibie / 5));
  set_skill("force", 500 + jibie * 2 + random(jibie / 5));
  set_skill("literate", 500 + jibie * 2 + random(jibie / 5));
  set_skill("longmen-shengong", 500 + jibie / 2 + random(jibie / 5));
  set_skill("music", 500 + jibie / 2 + random(jibie / 5));
  set_skill("throwing", 500 + jibie * 2 + random(jibie / 5));
  set_skill("art", 500 + jibie / 2 + random(jibie / 5));
  set_skill("youran-bu", 500 + jibie / 2 + random(jibie / 5));
  set_skill("yudi-bian", 500 + jibie / 2 + random(jibie / 5));
  set_skill("jieniu-dao", 500 + jibie / 2 + random(jibie / 5));
  set_skill("youren-jian", 500 + jibie / 2 + random(jibie / 5));
  map_skill("unarmed", "music");
  map_skill("hand", "music");
  map_skill("force", "longmen-shengong");
  map_skill("dodge", "youran-bu");
  map_skill("parry", "youren-jian");
  map_skill("throwing", "youren-jian");
  map_skill("whip", "yudi-bian");
  map_skill("blade", "jieniu-dao");
  set("inquiry", ([
    "李逍遥": "你能带我去找逍遥哥哥吗？！\n",
  ]));
  setup();

  carry_object("/clone/cloth/daogu-cloth")->wear();
  carry_object("/clone/cloth/dao-xie")->wear();
  carry_object("/d/kunlun/obj/jwqin");
  carry_object("/clone/weapon/nvwashi")->wield();
}

void init() {
  add_action("do_daying", "daying");
}

int do_daying(string arg) {
  object who = this_player();
  object me = this_object();
  if (who->query_temp("zhanyi/zhenyaota")) {
    command("say 你要救我几遍呢?");
  } else {
    if (me->query_temp("help_offer") != 0)
      return notify_fail("灵儿道：“" + who->query("name") + "已经答应我了！\n”");
    message_vision("$N答应赵灵儿！\n", this_player());
    command("jump " + who->query("id"));
    command("kiss " + who->query("id"));
    command("follow " + who->query("id"));
    command("say " + "那就拜托你啦！\n");
    me->set_temp("help_offer", who->query("name"));
    who->set_temp("shushan/zhanyi", 1);
  }
  return 1;
}
