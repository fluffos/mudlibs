//【蜀山剑派】dhxy-evil 2000.7.5
//lilong改于 2002.01.12
inherit NPC;
#include <ansi.h>
int do_report();
int do_linger();
void create()
{
	int jibie;
	jibie = 3000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("李逍遥", ({ "li xiaoyao", "li", "xiaoyao" }));
	set("title","蜀山剑派真传弟子");
	set("long", "李逍遥身材较瘦，长的浓眉阔眼，气宇暄昂。\n");
	set("gender", "男性");
	set("age", 18);
	set("class", "xiake");
	set("attitude", "peaceful");
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("per", 30);
	set("qi", 15000000);
	set("max_qi", 15000000);
	set("jing", 15000000);
	set("max_jing", 15000000);
	set("neili", 15000000);
	set("max_neili", 15000000);
	set("combat_exp", 2100000000);
	set("max_jingli", 15000000);
	set("jingli", 15000000);
	set("wuyongjiali",10000);

	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("fumozhang", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("canxin-jian", 500+jibie/3+random(jibie/5));
	set_skill("shushan-force", 500+jibie/3+random(jibie/5));
	set_skill("zuixian-steps",500+jibie/3+random(jibie/5));
	set_skill("literate",500+jibie/3+random(jibie/5));
	set_skill("taoism",500+jibie/3+random(jibie/5));
	map_skill("unarmed", "fumozhang");
	map_skill("force", "shushan-force");
	map_skill("dodge", "zuixian-steps");
	map_skill("parry", "canxin-jian");
	map_skill("sword", "canxin-jian");
	set("inquiry", ([
                "救出来了"    : (: do_report :),
				"赵灵儿"    : (: do_linger :),
        ]));
	setup();
	create_family("蜀山派", 3, "弟子");
	carry_object("/clone/cloth/dao-cloth")->wear();
	carry_object("/clone/weapon/gangjian")->wield();
}

void attempt_apprentice(object ob)
{
	if( (string)ob->query("family/family_name")!="蜀山派") 
	{
		command("shake");
		command("say 你是本派的吗？" + RANK_D->query_respect(ob) + "还是另寻他人吧！\n");
		return;		
	}
	if( (int)ob->query_skill("shushan-force", 1) < 500 ) 
	{
		command("say 这位" + RANK_D->query_respect(ob) + "你的蜀山内功这么差,你还是找追云子他们再练着吧!\n");
        command("sigh");
        return;
	}
	
	command("say 看在你诚心诚意的份上,我收你为徒!\n");
	command("recruit " + ob->query("id") );
	if((string)ob->query("class") != "xiake") ob->set("class", "xiake");
	ob->set("title", "蜀山派李逍遥弟子");
	return;
}
//2018.6.28阿飞改，换个写法更简洁
/*int recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) ) 
	{
		ob->set("class", "xiake");
		ob->set("title", "蜀山派李逍遥弟子");
	}
	return 0;
}*/

int do_linger()
{
    object ob=this_player();
    if(ob->query("family/family_name") == "蜀山派" )
    {
		ob->set_temp("jm_shushan5",1);
		command( "say 这位" + RANK_D->query_respect(ob) +"，能不能帮我救出灵儿！她被关进镇妖塔里了！\n");
    } else
		command("say 你又不是蜀山嫡传弟子的，无法担此重任！");
	return 1;
}
int do_report()
{
	int exp,pot,lev_add;
	object me = this_player();	
	exp = 5000000+random(5000000);
	pot = 2000000+random(2000000);
	lev_add = 20+200000/((int)me->query("xyzx_sys/level",1)+1000);
	if(me->query_temp("shushan/zhanyi") )
	{
		if(me->query_temp("jm_shushan5")) me->set_temp("jm_shushan6",1);
		me->set_temp("zhanyi/zhenyaota",1);
		me->delete_temp("shushan/zhanyi");
		me->add("combat_exp",exp);
		me->add("potential",pot);
		message_vision(HIC"〖"HIW"镇妖塔传讯"HIC"〗"HIY+me->query("name")+HIG"救出[1;37m镇妖塔[1;32m里的赵灵儿，受到奖励！[2;37;0m\n"NOR,me);
//		tell_object(me,"你赢得了50万点经验和10万点潜能\n");

		if (!(int)me->query("array/zhenyaota_exp"))
		{
			me->add("potential", 10000000);
			me->add("xyzx_sys/level", lev_add);
			me->set("array/zhenyaota_exp", 1);
			message("vision", HIR"恭喜你通过了蜀山镇妖塔的考验，你的实战能力提高了！\n"NOR,me);
		}
	} 
	else 
	{
		command("say 谢谢你！不能再麻烦你啦！");
	}
	return 1;
}



