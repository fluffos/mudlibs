//【蜀山剑派】dhxy-evil 2000.7.5

#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create() {
  set_name(
    HIG "七星" HIY "龙渊" HIM "剑" NOR,
    ({ "qixing longyuan jian", "qixing jian", "qixing", "jian", "sword" })
  );
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("icon", "10084");
    set("long", "一把带有七星的剑，看起来非常的华丽．\n");
    set("value", 10000);
    set("material", "crimsonsteel");
    set("wield_msg", "$N「唰」地一声抽出一把$n握在手中．\n");
    set("unwield_msg", "$N将手中的$n插入腰间，嘴角露出一丝笑意．\n");
    set("is_monitored", 1);
    set("weapon_prop/dexerity", 10);
    set("weapon_prop/sword", 40);
    set("weapon_prop/dodge", 10);
    set("weapon_prop/intelligence", 10);
    set("weapon_prop/parry", 10);
  }
  init_sword(500, 2);
  setup();
}

int query_autoload() { return 1; }
