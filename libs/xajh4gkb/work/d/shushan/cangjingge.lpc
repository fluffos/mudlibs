//【蜀山派】mhxy-yushu 2001/2
#include <ansi.h>
inherit ROOM;

string *order = ( {""HIY"", ""HIG"", ""RED"", ""MAG"", ""YEL"", ""HIC"", ""HIW"", ""HIR"",""HIB"", ""CYN"",""WHT"",""HIM"",""BLU""});
void create ()
{
  set ("short","藏经阁");
  set ("long", @LONG

蜀山剑派的藏经阁，东面有一个书架，上面有些关于武功类的书。
南面书架上放着关于内功和法术类的书。蜀山嫡传弟子，得到静虚
老祖指点后，可以在这里参阅(canyue)蜀山绝学。
LONG);

  set("exits", ([ 
  "west" : __DIR__"eastway4",
  ]));
  set("objects", ([
        __DIR__"obj/force_book"    : 1, 
		"/d/shushan/npc/daozhang" : 1,
  ]));
  setup();
}

void init()
{
	add_action("do_push", "push");
	add_action("do_canyue", "canyue");
}
int do_push(string arg)
{
	object me=this_player();
	if ((arg != "shujia" && arg != "书架") || !arg)
		return notify_fail("你要推什么？\n");
	if (me->is_busy()) return notify_fail("你忙着呢！\n");
	if (me->query("family/master_name") == "静虚老祖" && me->query("family/master_id") == "jingxu laozu")
	{
		message_vision(HIM"$N被一阵五彩光芒笼罩,到了另一个地方。\n"NOR, me);
		me->move(__DIR__"midao");
	}
	else 
	{
		tell_object (me,"你推书架干吗?\n");
	}
	return 1;
}

int do_canyue(string arg)
{
  object me=this_player();

  string *poem = ({
		"这卷竹简记录的似乎是蜀山最常见的御剑飞行术，是通过气而操纵剑凌空飞行，具有强大杀伤力。",
		"这卷竹简记录的似乎是应用咒语祈请神明、诅咒鬼蜮的方术。可以感通天帝，役使鬼神，达到除邪消灾、逢凶化吉的目的。",
		"这卷竹简记载的似乎是符箓。符箓是天神的文字，是传达天神意旨的符信，用它可以召神劾鬼，降妖镇魔。",
		"这卷竹简记录的居然是辟谷仙术。人食五谷杂粮，要在肠中积结成粪，产生秽气，阻碍成仙的道路。",
		"咦...这卷竹简记载的居然是蜀山御剑术，剑芒如雨直落，攻击全体，万剑诀。",
		"这卷竹简讲述的道理似乎是伏魔精要......伏魔天地间，御剑任逍遥......",
		});

    if(me->is_busy() )
        return notify_fail("你现在忙着呢，哪有功夫翻阅经文......\n");
    if(!me->query_temp("jm_shushan7") )
        return notify_fail("你未得到静虚老祖的指点，参阅经书是没用的。\n");	
    if(me->query("jm/shushan")) 
		return notify_fail("你已经完全领悟了御剑伏魔的精髓，不需要在这领悟了。\n");		
    if(me->query("family/family_name") != "蜀山派")
		return notify_fail("不是蜀山派的弟子，不能在这里翻阅经书！\n");	
		
	if (me->query_skill("shushan-force",1) < 1000)
	{
        tell_object(me,"你的蜀山心法.......\n"); 
        return 1;
	}
	if (me->query_skill("songhe-sword",1) < 2000)
	{
        tell_object(me,"你的松鹤剑法.......\n"); 
        return 1;
	}
	if (me->query_skill("yujianshu",1) < 2000)
	{
        tell_object(me,"你的御剑术.......\n"); 
        return 1;
	}
	if (me->query_skill("fumozhang",1) < 2000)
	{
        tell_object(me,"你的伏魔掌.......\n"); 
        return 1;
	}
    if(me->query("jingli") < 1000)
	{
        tell_object(me,"你还是先休息一会儿吧。\n");     
        return 1;
	}
	
	tell_object(me,HIW"你拿起一卷竹简，参阅起来......\n"NOR);
	message_vision(""+(order[random(13)])+"" + poem[random(sizeof(poem))] + "\n", me);
	me->add("jingli",-500);		
	me->start_busy(2);

    if( random(100000) < me->query("kar",1) )
	{
        me->set("jm/shushan",1);
		me->add("family_score",1);
        tell_object(me,HIB"你突然醒悟道："HIY"原来御剑术可以有此等威力"HIR"！\n"NOR);
		tell_object(me,HIB"恭喜你融汇贯通了蜀山派武功的精髓！\n"NOR);
		message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，在藏经阁居然领悟了蜀山派御剑伏魔的真谛！\n"NOR,users() );
	}
	return 1;
}             
