//jiansheng.c by yushu 2000.11
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_shenjian();
void create() {
  int jibie;
  jibie = 7000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("蜀山剑圣", ({ "shushan jiansheng", "jiansheng" }));
  set("title", "蜀山派剑法之圣");
  set("gender", "男性");
  set("age", 120);
  set("class", "xiake");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("rank_info/respect", "老师祖");
  set("per", 26);
  set("looking", "玉面多光润，苍髯颌下飘，金睛飞火焰，长目过眉梢。");
  set("jm/shushan", 1);
  set("int", 30);
  set("max_qi", 10000000);
  set("max_jing", 10000000);
  set("neili", 10000000);
  set("jingli", 10000000);
  set("max_neili", 10000000);
  set("max_jingli", 10000000);
  set("combat_exp", 2100000000);
  set("wuyongjiali", 30000);
  create_family("蜀山派", 2, "掌门");
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("fumozhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("songhe-sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shushan-force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zuixian-steps", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yujianshu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taoism", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "shushan-force");
  map_skill("sword", "songhe-sword");
  map_skill("parry", "yujianshu");
  map_skill("dodge", "zuixian-steps");
  map_skill("unarmed", "fumozhang");
  set("inquiry", ([
    "剑神": (: ask_shenjian :),
  ]));
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/d/shushan/obj/qixing")->wield();
}
int ask_shenjian() {
  object me;
  me = this_player();
  if ((string)me->query("family/family_name") == "蜀山派") {
    me->set_temp("jm_shushan3", 1);
    message_vision("$N对$n说道：十八年前太师叔姜清因与魔尊之女月柔霞相恋，结果魔教入侵导致蜀山劫难，自锁于天师洞中。！\n", me);
  } else {
    message_vision("$N对$n说道：你又不是蜀山嫡传弟子的，不可探听蜀山秘闻！！\n", me);
  }
  return 1;
}
void attempt_apprentice(object ob) {
  if ((string)ob->query("gender") != "男性") {
    command("shake");
    command("say 我只收男徒，这位" + RANK_D->query_respect(ob) + "还是去找酒剑仙吧。\n");
    return;
  }
  if ((string)ob->query("family/family_name") != "蜀山派") {
    command("shake");
    command("say 你是本派的吗？" + RANK_D->query_respect(ob) + "还是另寻他人吧！\n");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    command("say 是否应该去江湖中多加磨炼。");
    return;
  }
  if ((int)ob->query("int", 1) < 25) {
    command("say 你的悟性还不够，对我蜀山招术难以领悟。\n");
    return;
  }
  if ((int)ob->query("con", 1) < 25) {
    command("say 你的根骨还不够，对我蜀山功法难以领悟。\n");
    return;
  }
  if ((int)ob->query_skill("shushan-force", 1) < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "你的蜀山内功这么差,你还是找追云子他们再练着吧!\n");
    command("sigh");
    return;
  }
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，降妖除魔为蜀山争光。");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "xiake") ob->set("class", "xiake");
  ob->set("title", "蜀山剑圣嫡传第子");
  return;

}
