#include <ansi.h>
inherit NPC;
void create()
{
	int jibie;
	jibie = 100;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
  set_name("管家", ({ "guan jia"}) );
  set("gender", "男性");
  set("age", 40);
  set("combat_exp", 10000+random(1000));
  set("attitude", "heroism");
  set("str", 30);
  set("max_qi", 200);
set("max_jingli", 200);
set("max_neili", 200);
set("neili", 200);
set("jingli", 200);
  set("wuyongjiali", random(10)+15);
  set_skill("unarmed", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);
  set_skill("blade", 30);
  setup();
   carry_object("clone/cloth/cloth")->wear();
 carry_object("/clone/weapon/blade")->wield();
}

