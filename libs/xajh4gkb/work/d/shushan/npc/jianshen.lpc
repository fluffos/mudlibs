inherit NPC;
int check_fight(object npc, object me);
int accept_fight(object me);
int player_win(object me);
int player_lose(object me);
#include <ansi.h>
void create() {
  int jibie;
  jibie = 6000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("蜀山剑神", ({ "shushan jianshen", "jianshen" }));
  set("gender", "男性");
  set("age", 120);
  set("class", "xiake");
  set("attitude", "friendly");
  set("rank_info/respect", "老师祖");
  set("per", 26);
  set("looking", "玉面多光润，苍髯颌下飘，金睛飞火焰，长目过眉梢。");
  set("jm/shushan", 1);
  set("int", 30);
  set("max_qi", 10000000);
  set("max_jing", 10000000);
  set("neili", 10000000);
  set("jingli", 10000000);
  set("max_neili", 10000000);
  set("max_jingli", 10000000);
  set("combat_exp", 2100000000);
  set("wuyongjiali", 30000);

  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("fumozhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("songhe-sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shushan-force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zuixian-steps", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taoism", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "shushan-force");
  map_skill("sword", "songhe-sword");
  map_skill("parry", "songhe-sword");
  map_skill("dodge", "zuixian-steps");
  map_skill("unarmed", "fumozhang");

  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}

int accept_fight(object me) {
  remove_call_out("check_fight");
  call_out("check_fight", 1, this_object(), me);
  if (me->query_temp("jm_shushan3")) me->set_temp("jm_fight", 1);
  return 1;
}
int check_fight(object npc, object me) {
  if (npc->is_fighting()) {
    call_out("check_fight", 2, npc, me);
    return 1;
  }
  //	if (query_temp("last_opponent")!=me) return 1;
  if (!present(me, environment(npc))) return 1;
  if (npc->query("qi") * 100 / npc->query("max_qi") < 50 && me->query("qi") * 100 / me->query("max_qi") > 50 && npc->query("qi") * 100 / npc->query("max_qi") < me->query("qi") * 100 / me->query("max_qi"))
    call_out("player_win", 1, me);
  else call_out("player_lose", 1, me);

  return 1;
}

int player_win(object me) {
  //    this_object()->delete_temp("last_opponent");
  command("say 佩服!佩服!果然是习武之才。");
  if (me->query_temp("jm_shushan3")) {
    command("say 我就把剑神这个法术教给你把。");
    me->set_temp("jm_shushan4", 1);
  }
  me->delete_temp("jm_fight");
  command("say 后会有期！！！");
  me->move("d/shushan/cangjingge");
  return 1;
}

int player_lose(object me) {
  //    this_object()->delete_temp("last_opponent");
  command("say " + RANK_D->query_respect(me) + "不必气馁，再接再厉！");
  me->delete_temp("jm_fight");
  return 1;
}
