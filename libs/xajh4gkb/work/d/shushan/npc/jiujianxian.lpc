int ask_yujian()
{
    object ob=this_player();
    if(ob->query("family/family_name") == "蜀山派" )
    {
		ob->set_temp("jm_shushan1",1);
		command("say 我蜀山后山有一处飞瀑，据说在此可以练习御剑的技巧。");
    } else
		command("say 你又不是蜀山嫡传弟子的，谁管你！");
	return 1;
}