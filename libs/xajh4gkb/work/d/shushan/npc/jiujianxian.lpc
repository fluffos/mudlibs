//【蜀山派】mhxy-yushu 2001/2
// lilong alter 2002.01.19
inherit NPC;
#include <ansi.h>
//string ask_xiashan(object me);
//int ask_jiu();
int ask_yujian();
void create()
{
	int jibie;
	jibie = 6000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("酒剑仙", ({"jiu jianxian", "jianxian"}));
	set("title", HIC"醉道士"NOR);   
	set("long", "一人人送外号“酒剑仙”，行踪不定，或游历于名山大川之畔，或隐匿于街头闹市之中。\n");
	set("gender", "男性");
	set("age", 68);
	set("attitude", "peaceful");
	set("class", "xiake");
	set("str", 30);
	set("int", 30);
	set("per", 10);
	set("con", 30);
	set("max_qi", 10000000);
	set("max_jing", 10000000);
	set("neili", 10000000);
	set("jingli", 10000000);
	set("max_neili", 10000000);
	set("max_jingli", 10000000);
	set("combat_exp", 2100000000);
	set("wuyongjiali",30000);

	set_skill("shushan-force", 500+jibie/3+random(jibie/5));
	set_skill("yujianshu", 500+jibie/3+random(jibie/5));
	set_skill("fumozhang", 500+jibie/3+random(jibie/5)); 
	set_skill("zuixian-steps", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("literate",500+jibie/3+random(jibie/5));
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("taoism", 500+jibie/3+random(jibie/5));
	map_skill("dodge", "zuixian-steps");
	map_skill("parry", "yujianshu");
	map_skill("sword", "yujianshu");
	map_skill("force", "shushan-force");
	map_skill("unarmed","fumozhang");

	set("inquiry", ([
//			"下山": (: ask_xiashan :),
			"御剑": (: ask_yujian :),
		]) );
	create_family("蜀山派", 2, "传人");
	setup();
	carry_object("/clone/cloth/cloth")->wear();
	carry_object("/clone/weapon/changjian")->wield();
}

void attempt_apprentice(object ob)
{	
	if( (string)ob->query("family/family_name")!="蜀山派") 
	{
		command("shake");
		command("say 你是本派的吗？" + RANK_D->query_respect(ob) + "还是另寻他人吧！\n");
		return;		
	}
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
		command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
        command("say 是否应该去江湖中多加磨炼。");
		return ;
    }
	if( (int)ob->query_skill("force", 1) < 1000 ) 
	{
        command("say 这位" + RANK_D->query_respect(ob) + "你看你的猴样还来找我拜师? 你还是找追云子他们练着吧!\n");
		command("say 你这基本内功也太差了吧。");
		command("sigh");
		return;
	}
	if( (int)ob->query_skill("shushan-force", 1) < 1000 ) 
	{
		command("say 这位" + RANK_D->query_respect(ob) + "你的蜀山内功这么差,你还是找追云子他们再练着吧!\n");
        command("sigh");
        return;
	}
	if ((int)ob->query("int",1) < 25 ) 
	{
        command("say 你的悟性还不够，对我蜀山招术难以领悟。\n");
        return;
	}
	if ((int)ob->query("con",1) < 25 ) 
	{
        command("say 你的根骨还不够，对我蜀山功法难以领悟。\n");
        return;
	}
	command("haha");
	command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。");
	command("recruit " + ob->query("id") );
	if((string)ob->query("class") != "xiake") ob->set("class", "xiake");
	ob->set("title", "蜀山酒剑仙弟子");
	return;
}
