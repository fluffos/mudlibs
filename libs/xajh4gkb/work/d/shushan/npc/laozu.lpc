//【蜀山派】mhxy-yushu 2001/2
// lilong alter 2002.01.19
inherit NPC;
inherit F_MASTER;
int ask_back();
int ask_fumo();
#include <ansi.h>
void create()
{
	int jibie;
	jibie = 9000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("静虚老祖", ({"jingxu laozu","jingxu"}));
	set("title",HIC"蜀山派开山祖师"NOR);
	set("gender", "男性");
	set("age", 220);
	set("class", "xiake");
	set("attitude","peaceful");
	set("shen_type", 1);
	set("rank_info/respect", "老师祖");
	set("per", 26);
	set("looking", "玉面多光润，苍髯颌下飘，金睛飞火焰，长目过眉梢。");
	set("jm/shushan", 1);
	set("int", 30);
	set("max_qi", 30000000);
	set("max_jing", 30000000);
	set("neili", 30000000);
	set("jingli", 30000000);
	set("max_neili", 30000000);
	set("max_jingli", 30000000);
	set("combat_exp", 2100000000);
	set("wuyongjiali",100000);

	set_skill("literate", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("fumozhang", 500+jibie/3+random(jibie/5)); 
	set_skill("songhe-sword", 500+jibie/3+random(jibie/5));
	set_skill("yujianshu", 500+jibie/3+random(jibie/5));
	set_skill("shushan-force", 500+jibie/3+random(jibie/5));
	set_skill("sword",500+jibie/3+random(jibie/5));
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("zuixian-steps",500+jibie/3+random(jibie/5));
	set_skill("taoism",500+jibie/3+random(jibie/5));
	map_skill("force", "shushan-force");
	map_skill("sword", "yujianshu");
	map_skill("parry", "yujianshu");
	map_skill("dodge", "zuixian-steps");
	map_skill("unarmed","fumozhang");

	set("inquiry", ([
			"回去" : (: ask_back :),
			"御剑伏魔" : (: ask_fumo :),
		]) );
	create_family("蜀山派", 1, "祖师");
	setup();

	carry_object("/clone/cloth/cloth")->wear();
	carry_object("/d/shushan/obj/qixing")->wield();
   }

void attempt_apprentice(object ob)
{      
//ob=this_player();
	if( (string)ob->query("family/family_name")!="蜀山派") 
	{
		command("shake");
		command("say 你是本派的吗？" + RANK_D->query_respect(ob) + "还是另寻他人吧！\n");
		return;		
	}
	if ((int)ob->query("combat_exp") < 100000000 ) 
	{
        command("say 你的战斗经验还不够，对我的招法难以领悟。\n");
        return;
	}
	if ((int)ob->query("int",1) < 25 ) 
	{
        command("say 你的悟性还不够，对我蜀山招术难以领悟。\n");
        return;
	}
	if ((int)ob->query("con",1) < 25 ) 
	{
        command("say 你的根骨还不够，对我蜀山功法难以领悟。\n");
        return;
	}
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
        command("say 是否应该去江湖中多加磨炼。");
		return ;
    }		
	if( (int)ob->query_skill("shushan-force", 1) < 1000 ) 
	{
        command("say 这位" + RANK_D->query_respect(ob) + "你的蜀山内功还不到火候,你还是找剑圣他们练着吧!\n");
        command("sigh");
        return;
	}
	if( (int)ob->query_skill("zuixian-steps", 1) < 1000 ) 
	{
        command("say 这位" + RANK_D->query_respect(ob) + "你的醉仙望月步还不到火候,你还是找剑圣他们练着吧!\n");
        command("sigh");
        return;
	}
	command("smile");
	command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。");
	command("recruit " + ob->query("id") );
	if((string)ob->query("class") != "xiake") ob->set("class", "xiake");
	ob->set("title", "蜀山静虚老祖传人");
	return;
}
//2018.6.28阿飞改，换个写法更简洁
