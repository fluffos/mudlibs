{
	if( ::recruit_apprentice(ob) ) 
	{
		ob->set("class", "xiake");
		ob->set("title", "蜀山静虚老祖传人");
	}
	return 0;
}*/
int ask_back()
{
    object ob=this_player();
    if(ob->query("family/family_name") != "蜀山派")
    {
		command("say 你又不是蜀山派的，你问这个干吗！");
		return 1;
    }
    if(ob->query("family/master_name") == "静虚老祖" && ob->query("family/master_id") == "jingxu laozu")
    {
		command("say 你想出去啊！好吧!我送你出去!\n,say 下次进来时就不要那么麻烦了,去藏经阁(push 书架)就可以了。\n");
		ob->move("/d/shushan/cangjingge");
		return 1;
    }
}

int ask_fumo()
{
    object ob=this_player();
    if(ob->query("family/family_name") == "蜀山派" && ob->query_temp("jm_shushan2") && ob->query_temp("jm_shushan4") && ob->query_temp("jm_shushan6"))
    {
		ob->set_temp("jm_shushan7",1);
		command("say 我蜀山的藏经阁似乎记录有御剑伏魔的经文，我可以指点你一二，然后去藏经阁参阅其他秘籍，能否参悟就看你的资质了。");
    } else
		command("say 你目前还不到传授御剑伏魔的时候！");
	return 1;
}