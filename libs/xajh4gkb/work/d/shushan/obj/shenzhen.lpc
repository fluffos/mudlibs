#include <ansi.h>
#include <weapon.h>
inherit THROWING;
void create() {
  set_name("无影神针", ({ "wuying shenzhen", "shenzhen", "zhen" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("base_unit", "根");
    set("long", "一把细小的无影神针，好像带着剧毒。\n");
    set("base_weight", 5);
    set("base_value", 1);
    set("value", 0);
  }
  set_amount(100);
  init_throwing(200, 2);
  setup();
}
