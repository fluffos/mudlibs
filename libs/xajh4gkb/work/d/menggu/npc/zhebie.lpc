inherit NPC;
void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
   set_name("哲别",({"zhe bie"}));
   set("gender","男性");
   set("long","铁木真手下猛将之一,是郭靖的箭术师傅!\n");
   set("shen",25000);
   set("combat_exp",160000);
   set("title","神箭手");
   
set("age",35);
   set("kee",2000);
   set("max_kee",2000);
set("food",250);
set("water",250);
   set("neili",1500);
   set("max_neili",1500);
   set("force_factor",60);

   set_skill("dodge",500+jibie/3+random(jibie/5));
   set_skill("force",500+jibie/3+random(jibie/5));
   set_skill("parry",500+jibie/3+random(jibie/5));
   set_skill("unarmed",500+jibie/3+random(jibie/5));
	set_skill("spear", 500+jibie/3+random(jibie/5));
	set_skill("zhong-qiang", 500+jibie/3+random(jibie/5));
	map_skill("spear", "zhong-qiang");


   setup();
   add_money("silver",20);
carry_object("clone/cloth/cloth")->wear();
carry_object(__DIR__"obj/tieqiang")->wield();
}
