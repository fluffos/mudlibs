inherit NPC;
#include <ansi.h>
void create()
{
	int jibie;
	jibie = 8000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("铁木真",({"tie muzhen"}));
	set("gender","男性");
	set("long","铁木真是蒙古草原的英雄!\n");
	set("title",HIR"蒙古大汗"NOR);
	set("shen",25000);
	set("combat_exp",500000);
	set("age",45);
	set("neili",2500);
	set("max_neili",25000000);
//	set("force_factor",60);
	set_skill("dodge",500+jibie/3+random(jibie/5));
	set_skill("hand",500+jibie/3+random(jibie/5));
	set_skill("force",500+jibie/3+random(jibie/5));
	set_skill("parry",500+jibie/3+random(jibie/5));
	set_skill("unarmed",500+jibie/3+random(jibie/5));
	set_skill("blade", 500+jibie/3+random(jibie/5));
	set_skill("lingyuan-xinfa",500+jibie/3+random(jibie/5));	
	set_skill("lingyunbu",500+jibie/3+random(jibie/5));	
	set_skill("tianxin-blade",500+jibie/3+random(jibie/5));	
	set_skill("cuixin-zhang",500+jibie/3+random(jibie/5));	
	set_skill("qinnashou",500+jibie/3+random(jibie/5));	
	map_skill("parry", "tianxin-blade");
	map_skill("hand", "qinnashou");
	map_skill("blade", "tianxin-blade");
	map_skill("unarmed", "cuixin-zhang");
	map_skill("force", "lingyuan-xinfa");
	map_skill("dodge", "lingyunbu");
	setup();
	carry_object("clone/weapon/gangdao")->wield();
	carry_object("clone/cloth/cloth")->wear();
	add_money("gold",10);
}


int accept_object(object who, object ob)
{
	int i;

	if (!(int)who->query_temp("learn_timea")) who->set_temp("learn_timea", 0);
	if( !ob->query("money_id") ) return 0;		
	if(who->query_skill("qinnashou",1)<30)
		i=ob->value() / 50;
	else
	{
		if(who->query_skill("qinnashou",1)<60)
			i=ob->value() / 100;
		else
		{
			if(who->query_skill("qinnashou",1)<100)
				i=ob->value() / 150;
			else
				i=ob->value() / 300;
		}
	}
	
	message_vision("铁木真对$N说道：既然你诚心想学我的武功，我就成全成全你吧。\n",who);
	tell_object(who,"现在你可以向铁木真学习了。\n");
	who->add_temp("learn_timea",i);
	
	return 1;
}

int recognize_apprentice(object ob)
{
	if ((int)ob->query_temp("learn_timea") == 1 )
        message_vision("铁木真看了看$N，说道：你该学的已经学了,\n" "你不要再找我学习技艺了。\n", ob);	
	if(ob->query_skill("qinnashou",1) > 100) return 0;
	if(!(int)ob->query_temp("learn_timea")) return 0;
	ob->add_temp("learn_timea",-1);
	return 1;
}

void die()
{
    object  me;        
    me = query_temp("last_damage_from");
	if (me && me->query("family/master_id") == "zhang wuji" && me->query_temp("jm_mingjiao5"))
	{
		me->set_temp("jm_mingjiao6",1);
		tell_room(environment(this_player()), HIC"铁木真大笑道：宋人孱弱，我等当取而代之。\n"NOR);
		tell_room(environment(this_player()), HIC"铁木真气息微弱，呻吟道：长生天难道不在眷顾你的子明了吗。\n"NOR);
		tell_room(environment(this_player()), HIC"不一会，一代英雄铁木真死了。\n"NOR);
	}
	::die();
}
