inherit NPC;
void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("郭靖", ({ "guo jing" }));
  set("gender", "男性");
  set("long", "郭靖出生在蒙古,随江南六怪学艺!\n");
  set("shen", 50000);
  set("combat_exp", 100000);

  set("age", 17);
  set("kee", 900);
  set("max_kee", 900);
  set("food", 250);
  set("water", 250);
  set("neili", 500);
  set("max_neili", 500);
  set("force_factor", 30);

  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("spear", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhong-qiang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("whip", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));

  setup();
  add_money("silver", 20);
  carry_object("clone/cloth/cloth")->wear();
  carry_object(__DIR__ "obj/jindao")->wield();
}
