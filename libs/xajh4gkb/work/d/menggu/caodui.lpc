// Room: /d/menggu/caodui
inherit ROOM;

void create()
{
  set ("short", "大草堆");
  set ("long", @LONG
蒙古人一过炎夏，便割草堆积，冬日饲养牲口，烧火取暖，全凭干草，
是以草堆(caodui)往往比住人的蒙古包还大。一边是个简陋的小茅草屋.
LONG);

  set("outdoors", "menggu");
  set("exits", ([ /* sizeof() == 2 */
  "in" : __DIR__"maowu",
  "west" : __DIR__"byriver",
]));
	set("obj_count" , 1);
  setup();
  replace_program(ROOM);
}

void init()
{
	add_action("do_search", "sou");
	add_action("do_search", "chai");
	add_action("do_search", "open");
}

int do_search(string arg)
{
	object me,obj;
	me = this_player();

	if( !arg || arg=="" ) return 0;

	if( arg=="caodui" )
	{
		if( query("obj_count")>=1 ) 
		{
			write("你将草堆拆的到处都是，从里面找到了一个烟斗。\n");
			obj=new("/d/obj/quest/yandou");
			obj->move(environment(me));
			set("obj_count", 0);     
			return 1;
		}
		else 
			return notify_fail("草堆散乱无章，似乎被人搜过了。\n");
	}
}