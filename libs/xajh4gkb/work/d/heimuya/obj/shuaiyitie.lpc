inherit ITEM;

void create() {
  set_name("率意帖", ({ "shuai yi tie", "shuaiyi tie", "zitie" }));
  set("long", "这是唐朝著名书法家张旭所作草书帖，对于喜爱书法之人，算是无价之宝了。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("no_get", "那是无价之宝，对方连睡觉都揣在怀里的！\n");
    set("no_drop", "这可是无价之宝，你这么老大一个人，居然如此不识货？！\n");
    set("value", 1000000);
    set_weight(20);
    //		set("treasure", 1);
  }
  setup();
}
