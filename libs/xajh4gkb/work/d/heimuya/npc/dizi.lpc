// jiaotu.c 日月神教教徒
inherit NPC;
void create() {
  int age, jibie;
  age = 20 + random(10);
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("成德殿殿下弟子", ({ "dizi" }));
  set("gender", "男性");
  set("age", age);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set("apply/attack", 40);
  set("apply/defense", 40);
  set("apply/damage", 35);
  set("combat_exp", 5000 + age * 40);
  set("shen_type", 1);
  setup();
  add_money("silver", 10 + age / 10);
  carry_object("/clone/cloth/cloth")->wear();
}
void init() {
  object ob, me;
  ::init();
  ob = this_player();
  me = this_object();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob, me);
  }
}
void greeting(object ob, object me) {
  if (!ob || environment(ob) != environment(me)) return;
  switch (random(1)) {
    case 0:
      say("日月神教，日出东方，唯我不败。\n");
      break;

  }
}
