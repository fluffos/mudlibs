#include <ansi.h>
inherit NPC;
void reset();
int do_answer(string str);
void do_dest(object ob);
void do_give(object ob);
int ask_kuihua();

void create()
{
	int jibie;
	jibie = 8000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
    set_name("东方不败", ({"dongfang bubai", "dongfang"}));
    set("nickname", HIY "日月神教教主" NOR );
    set("gender", "无性");
    set("age", 46);
    set("shen_type", 0);
    set("long",
        "她就是日月神教教主。号称无人可敌，因此有一称号为「东方不败」。\n");
    set("attitude", "peaceful");
    set("str", 31);
    set("int", 80);
    set("con", 86);
    set("dex", 100);
    set("per",44);
//    set("no_magic",1);
    set("chat_chance", 1);
    set("chat_msg", ({
        "东方不败叹了口气道：“唉 …… 那任我行难道逃了出来吗?\n",
        }));
    set("inquiry", ([
        "辟邪剑谱" : "如果你能帮我取得葵花宝典招式篇，我一定重重谢你。\n",
              "线" : "就是柔丝索嘛，SIGH，笨蛋！\n",
		"葵花宝典" : (: ask_kuihua() :),
    ]));
    set("qi", 10000);
    set("max_qi", 10000);
    set("jing", 5000);
    set("max_jing", 5000);
    set("jingli", 10000);
    set("max_jingli", 10000);
    set("neili", 10000000);
    set("max_neili", 20000);
    set("wuyongjiali", 800);
    set("combat_exp", 82800000);

    set_skill("force", 500+jibie/3+random(jibie/5));              // 基本内功
    set_skill("dodge", 500+jibie/3+random(jibie/5));              // 基本躲闪
    set_skill("parry", 500+jibie/3+random(jibie/5));              // 基本招架
    set_skill("sword", 500+jibie/3+random(jibie/5));              // 基本剑法
    set_skill("pixie-jian", 500+jibie/3+random(jibie/5));         // PiXieJian
    set_skill("literate",500+jibie/3+random(jibie/5));           // 读书识字
    set_skill("kuihua-xinfa", 500+jibie/3+random(jibie/5));       // 葵花心法
	set_skill("unarmed", 500+jibie/3+random(jibie/5)); 
	set_skill("kuihua-dafa", 500+jibie/3+random(jibie/5)); 
	set_skill("kuihua-feiying", 500+jibie/3+random(jibie/5)); 
    map_skill("force"  , "kuihua-xinfa");
    map_skill("sword", "pixie-jian");
    map_skill("dodge"  , "kuihua-feiying");
    map_skill("parry"  , "kuihua-dafa");
	map_skill("unarmed"  , "kuihua-dafa");
//    set_temp("apply/shade_vision",1);
    create_family("日月神教", 1, "教主");


    setup();
    carry_object(__DIR__"obj/zhen")->wield();
    carry_object("/d/quanzhou/obj/xiuhua")->wield();
    carry_object(__DIR__"obj/hongchouxiaoshan")->wear();
}
void init()
{
    ::init();
    if (this_player()->query_temp("kill yang")){
          command("say 大胆狂徒，竟敢杀我爱夫，看招!\n");
          call_out("kill_ob", 0, this_player()); 
          this_player()->fight_ob(this_object());
          COMBAT_D->do_attack(this_object(), this_player(), query_temp("weapon"));
    }else
    add_action("do_answer","answer");
}
