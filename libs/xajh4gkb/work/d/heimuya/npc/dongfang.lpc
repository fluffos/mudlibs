int ask_kuihua()
{
	object me,ob;
	me = this_player();
	ob = this_object();

   message_vision(HIC "东方不败说道：葵花宝典散落江湖，若你能为我收集齐全，我可以告诉你一点葵花宝典的秘密。\n" NOR,this_player());
   me->set_temp("jm_riyue_dongfang1",1);
   return 1;
}

int accept_object(object who, object ob)
{
//解密日月神教
	if ((int)who->query_temp("jm_riyue_dongfang1") && (string)who->query("family/family_name") == "日月神教")
	{
        if ((string) ob->query("id") =="kuihua baodian1") 
		{
			if ( who->query("id")==ob->query("owner"))
			{			
                message_vision("东方不败看了看$N送来的秘籍，点了点头，说道：\n"+
                               "难得你将宝典1送回。这东西我就收下了。\n", who);
                who->set_temp("tmark/残本1", 1);
                return 1;
			} else
			{
                message_vision("$N对$n说道：多谢这位"+RANK_D->query_respect(who)+"，这本剑谱我就笑纳了。\n",this_object(),who);
                return 1;
			}
        }	
        if ((string) ob->query("id") =="kuihua baodian2") 
		{
			if ( who->query("id")==ob->query("owner"))
			{			
                message_vision("东方不败看了看$N送来的秘籍，点了点头，说道：\n"+
                               "难得你将宝典1送回。这东西我就收下了。\n", who);
                who->set_temp("tmark/残本2", 1);
                return 1;
			} else
			{
                message_vision("$N对$n说道：多谢这位"+RANK_D->query_respect(who)+"，这本剑谱我就笑纳了。\n",this_object(),who);
                return 1;
			}
        }
        if ((string) ob->query("id") =="kuihua baodian3") 
		{
			if ( who->query("id")==ob->query("owner"))
			{			
                message_vision("东方不败看了看$N送来的秘籍，点了点头，说道：\n"+
                               "难得你将宝典1送回。这东西我就收下了。\n", who);
                who->set_temp("tmark/残本3", 1);
                return 1;
			} else
			{
                message_vision("$N对$n说道：多谢这位"+RANK_D->query_respect(who)+"，这本剑谱我就笑纳了。\n",this_object(),who);
                return 1;
			}
        }
        if ((string) ob->query("id") =="kuihua baodian") 
		{
			if ((int)who->query_temp("tmark/残本1") && (int)who->query_temp("tmark/残本2") && (int)who->query_temp("tmark/残本3") /*&& who->query("id")==ob->query("owner")*/)
			{
                message_vision("东方不败看了看$N送来的葵花心法篇，点了点头，说道：很好！这位"+RANK_D->query_respect(who)+"给我送来完整的葵花宝典，总算了结夙愿。\n",who);
				message_vision("东方不败说道：葵花宝典实则为一对恩爱夫妻所著，其后因事反目，各自创出的半部宝典更是互相克制。\n",who);
				message_vision("东方不败说道：若你能去杭州断桥经历一番爱恨情仇，或许能对葵花宝典有所领悟。\n",who);
                who->set_temp("jm_riyue_dongfang2", 2);
                return 1;
			} else
			{
                message_vision("东方不败看了看$N送来的葵花宝典，点了点头，说道：你再不还回来，我可就要杀人了。\n",who);
                return 1;
			}
        }				
	}

//拿葵花心法篇	
        if ((string) ob->query("id") =="kuihua baodian1" || (string) ob->query("id") =="kuihua baodian2" || (string) ob->query("id") =="kuihua baodian3") 
		{
			if ( who->query("id")==ob->query("owner"))
			{
                message_vision("东方不败看了看$N送来的秘籍，点了点头，说道：\n"+
                               "难得你将宝典送回。你送我的东西我就收下了。\n"+
                               "不过我还差点线才能将这花绣完，你帮我找线回来。\n", who);
                who->set_temp("tmark/东", 1);
                return 1;
			} else
			{
                message_vision("$N对$n说道：多谢这位"+RANK_D->query_respect(who)+"，这本剑谱我就笑纳了。\n",this_object(),who);
                return 1;
			}
        }
        if ( (string) ob->query("id") =="rousi suo" ) 
		{
             if ((int)who->query_temp("tmark/东"))
			 {
                message_vision("东方不败看了看$N送来的柔丝索，点了点头，说道：很好！这位"+RANK_D->query_respect(who)+",\n看看我绣的这花手绢上有几朵花(answer)?\n",who);
                who->set_temp("tmark/东", 2);
                call_out("do_dest",10,who);
                return 1;
             } else
                message_vision("东方不败看了看$N送来的柔丝索，点了点头，说道：谢了。\n",who);
                return 1;
        }
        return 0;
}

mixed weapon_ob(object me,object victim,int damage)
{
      object weapon;
      if (!weapon=me->query_temp("weapon"))
      {
          weapon=new("/d/heimuya/npc/obj/zhen");
          weapon->move(me);
          command("wield zhen 1");
          weapon=new("/d/heimuya/npc/obj/zhen");
          weapon->move(me);
          command("wield zhen 1");
      }
      return 0;
}
int do_answer(string str)
{
      int i,j;
      object ob=this_player();
      object me=this_object();
      if (ob->query_temp("tmark/东")!=2)  return 0;
      if (!str || !sscanf(str,"%d",i)) return notify_fail("东方不败阴笑地看着你:快答呀!\n");
      message_vision("$N颤颤惊惊地答到："+CHINESE_D->chinese_number(i)+"朵花。\n",ob);
      ob->delete_temp("tmark/东");
      j=ob->query("birthday");
      j=j%90+10;
      if (i==j){
          message_vision("$N高兴地拍了拍$n的头，对，我就想绣"+CHINESE_D->chinese_number(i)+"朵花。\n",me,ob);
          call_out("do_give",1,ob);
      }else{
          message_vision("$N的脸色微变：看来你是瞎了眼，老娘就成全你吧！\n",me);
          me->kill_ob(ob);
          ob->fight_ob(me);
      }
      return 1;
}
void do_dest(object ob)
{
      object me=this_object();
      if( !ob || !ob->query_temp("tmark/东") ) return;
      ob->delete_temp("tmark/东");
      if ( environment(ob) != environment() ) return;

      message_vision("$N的目露凶光：支支唔唔的，看来你是瞧不起我绣的花手绢！\n",this_object());
      me->kill_ob(ob);
      ob->fight_ob(me);
}
void do_give(object ob)
{
	object obj;
	if( !ob || environment(ob) != environment() ) return;
	obj=new(__DIR__"obj/kuihua");
	obj->set("owner",ob->query("id"));
	if (!obj->move(ob)) destruct(obj);
	message_vision("$N给了$n一本"+obj->query("name")+"。\n",this_object(),ob);
	message("channel:chat", HIR"【谣言四起】"HIR + "听说"+ob->query("name")+"获得了东方不败的葵花宝典心法篇！\n"NOR,users() );	
	ob->add_temp("study_book", 1);
}

void reset()
{
    this_object()->remove_all_killer();
}

void attempt_apprentice(object ob)
{
    if (ob->query("int",1) < 25) 
	{
        command("say 悟性这么差，闪一边去！\n");
        return;
    }
    if (ob->query("dex",1) < 30) 
	{
        command("say 身法这么差，滚！\n");
        return;
    }
	if ((int)ob->query("score") < 100000  )
	{
		command("say 老子只收名声响亮的，你个小瘪三听都没听说过！");
		return;
	}
	if (ob->query("family/family_name")!="日月神教")
	{
		command("say 哪里来的江湖奸细，还不快滚！");
		return;
	}
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
        command("say 你就这点本事还想拜在我门下，滚！！！");
		return ;
    }		 
	if ((int)ob->query_skill("pixie-jian",1) < 1000 )
	{
		command("say 就你这点辟邪剑法，还想入老子的门下，滚！！！");
		return;
	}
	if ((int)ob->query_skill("kuihua-xinfa",1) < 1000 )
	{
		command("say 就你这点葵花心法，还想入老子的门下，滚！！！");
		return;
	}	
	if (ob->query("gender")!="无性" )
	{
		command("say 我看你是活腻了吧，老子只收太监!");
		return;
	}
	if ( ob->query("genderbak")=="男性" )
	{
		command("say 你个假太监，也敢来糊弄老娘。");
		return;
	}
	command("nod");
	command("say 哈哈哈！" + RANK_D->query_respect(ob) + "阴险下流，天生就是我门中人 ！\n");
	command("recruit " + ob->query("id") );
	return;
}

void die()
{
    object me;        
    me = query_temp("last_damage_from");
	if (me && (string)me->query("family/family_name") == "日月神教" && me->query_temp("jm_riyue_ren1"))
	{
		tell_room(environment(this_player()), "任教主修炼吸星大法走火入魔，特将其困于西湖湖底完善功法。\n");
		tell_room(environment(this_player()), "东方不败叹息一声，我从未觊觎教主之位，只是任教主走火入魔，行事张狂，东风实在不忍我教衰落。\n");
		tell_room(environment(this_player()), "时至今日，神教已是物是人非，东方自修炼葵花宝典以来，已是看透世间虚名.....．\n");
		me->set_temp("jm_riyue_ren2",1);
	}
	::die();
}