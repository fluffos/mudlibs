// qu.c
inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;

void greeting(object);
void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("曲洋", ({ "qu yang", "qu"}) );
	set("gender", "男性" );
	set("age", 45);
	set("long", "他就是日月神教十大长老之一，琴技天下无双。\n" );
	set("attitude", "peaceful");
	set("shen_type", 0);

    set("per", 20);
	set("str", 23);
	set("int", 23);
	set("con", 22);
	set("dex", 29);

	set("max_qi", 1000);
	set("max_jing",1000);
	set("neili", 300);
	set("max_neili", 300);
	set("combat_exp", 15000000);
	set("score", 30000);
	set("wuyongjiali",50);
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("throwing", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("sword",500+jibie/3+random(jibie/5));
	set_skill("tianmo-shengong",500+jibie/3+random(jibie/5));
	set_skill("wuxue-shenfa", 500+jibie/3+random(jibie/5));
	set_skill("tianmo-quan", 500+jibie/3+random(jibie/5));
	set_skill("tianmo-jian", 500+jibie/3+random(jibie/5));
	map_skill("force", "tianmo-shengong");
	map_skill("dodge", "wuxue-shenfa");
	map_skill("parry", "tianmo-jian");
	map_skill("unarmed", "tianmo-quan");
	map_skill("sword", "tianmo-jian");
	
	create_family("日月神教",3,"长老");

	setup();
	carry_object("/d/heimuya/npc/obj/yuxiao")->wield();
	carry_object("/d/heimuya/npc/obj/kuihuazhen")->wield();
	carry_object("/d/henshan/npc/obj/blackcloth")->wear();
}

void attempt_apprentice(object ob)
{
    if (ob->query("str",1) < 25) {
        command("say 我不收资质差的弟子，您请回吧！\n");
                return;
    }

    if ((int)ob->query("shen") >100000 || (int)ob->query ("shen") < -100000 ) {
        command("say 我黑木崖与世隔绝，向来不与您这种成名人物打交道，您请回吧！;\n");
                return;
        }
	command("nod");
    command("say 很好，很好，望你能将我日月神教发扬光大！。\n");
    command("recruit " + ob->query("id"));
	return;
}