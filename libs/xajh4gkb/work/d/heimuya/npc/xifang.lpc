// xifang.c
#include <ansi.h>
inherit NPC;

int ask_kuihua();

void create()
{
	int jibie;
	jibie = 8000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
    set_name("西方不败", ({"xifang bubai", "xifang"}));
    set("nickname", HIY "天下无敌" NOR );
    set("gender", "男性");
    set("age", 42);
	set("shen_type", 0);
    set("long",
        "她就是日月神教教主。号称无人可敌，因此有一称号为「西方不败」。\n");
    set("attitude", "peaceful");
    set("str", 31);
    set("int", 10);
    set("con", 26);
    set("dex", 200);
    set("chat_chance", 1);
    set("chat_msg", ({
 "西方不败叹了口气道：“唉 …… 那东方不败是谁呀，你们烦不烦啊！\n",
        }));
    set("qi", 1000);
    set("max_qi", 1000);
    set("jing", 500);
    set("max_jing", 500);
    set("jingli", 1000);
    set("max_jingli", 1000);
    set("neili", 50000);
    set("max_neili", 5000);
    set("wuyongjiali", 20);
    set("combat_exp", 12500000);
	set_skill("blade", 500+jibie/3+random(jibie/5));   
    set_skill("force", 500+jibie/3+random(jibie/5));            
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("throwing", 500+jibie/3+random(jibie/5));  
    set_skill("dodge", 500+jibie/3+random(jibie/5));             
    set_skill("parry", 500+jibie/3+random(jibie/5));            
    set_skill("sword", 500+jibie/3+random(jibie/5));  
    set_skill("xiaoli-feidao", 500+jibie/3+random(jibie/5));
    set_skill("tianmo-shengong", 500+jibie/3+random(jibie/5)); 	
    set_skill("tianmo-jian", 500+jibie/3+random(jibie/5));        
    set_skill("tianmo-quan",500+jibie/3+random(jibie/5));       
    set_skill("literate",500+jibie/3+random(jibie/5));           
    set_skill("tianmo-dao", 500+jibie/3+random(jibie/5));       
	set_skill("wuxue-shenfa", 500+jibie/3+random(jibie/5));
    map_skill("force", "tianmo-shengong");
    map_skill("throwing", "xiaoli-feidao");
    map_skill("sword", "tianmo-jian");
    map_skill("unarmed", "tianmo-quan");
    map_skill("dodge", "wuxue-shenfa");
    map_skill("parry", "tianmo-jian");
	map_skill("blade", "tianmo-dao");
    create_family("日月神教", 1, "教主");
    set("inquiry", ([
		"葵花宝典" : (: ask_kuihua() :),
    ]));

    setup();
    carry_object(__DIR__"obj/zhen")->wield();
//    carry_object("/clone/weapon/feidao")->wield();
	carry_object(__DIR__"obj/dadao")->wield();
    carry_object(__DIR__"obj/hongchouxiaoshan")->wear();
}

int ask_kuihua()
{
	object me,ob;
	me = this_player();
	ob = this_object();

   message_vision(HIC "西方不败说道：想问葵花宝典的秘密，先给老子找来魔刀、魔剑 、寒月斩。\n" NOR,this_player());
   me->set_temp("jm_riyue_xifang1",1);
   return 1;
}

void attempt_apprentice(object ob)
{
    if (ob->query("str",1) < 25) 
	{
        command("say 一点力气都没有，闪一边去！\n");
        return;
    }
    if (ob->query("con",1) < 30) 
	{
        command("say 体质这么差，滚！\n");
        return;
    }
	if ((int)ob->query("score") < 100000  )
	{
		command("say 老子只收名声响亮的，你个小瘪三听都没听说过！");
		return;
	}
	if (ob->query("family/family_name")!="日月神教")
	{
		command("say 哪里来的江湖奸细，还不快滚！");
		return;
	}
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
        command("say 你就这点本事还想拜在我门下，滚！！！");
		return ;
    }		 
	if ((int)ob->query_skill("kuihua-xinfa",1) < 1000 && (int)ob->query_skill("tianmo-shengong",1) < 1000)
	{
		command("say 就你这点葵花心法/天魔神功，还想入老子的门下，滚！！！");
		return;
	}	
/*	if (ob->query("gender")!="无性" )
	{
		command("say 我看你是活腻了吧，老子只收太监!");
		return;
	}
	if ( ob->query("genderbak")=="男性" )
	{
		command("say 你个假太监，也敢来糊弄老子。");
		return;
	}*/
	command("nod");
	command("say 哈哈哈！" + RANK_D->query_respect(ob) + "阴柔之气极重，天生就是我门中人 ！\n");
	command("recruit " + ob->query("id") );
	return;
}


int accept_object(object me, object ob)
{  
	if ((string) ob->query("id") =="rusty sword") 
	{	
		if ((int)me->query_temp("jm_riyue_xifang1") && (string)me->query("family/family_name") == "日月神教")	
		{
			message_vision("西方不败看了看$N送来的魔剑，点了点头，说道：\n"+
					"魔剑阿飞的佩剑，果然名不虚传。\n", me);
			me->set_temp("tmark/魔剑", 1);
			return 1;
		} else
		{
			message_vision("西方不败看了看$N送来的魔剑，说道：什么狗屁魔剑，我看也没什么特殊。\n"+
			"西方不败随手就将锈铁片给扔了。\n",this_object(),me);
			return 1;			
		}
	}	
	if ((string) ob->query("id") =="mo dao") 
	{	
		if ((int)me->query_temp("jm_riyue_xifang1") && (string)me->query("family/family_name") == "日月神教")	
		{
			message_vision("西方不败看了看$N送来的魔刀，点了点头，说道：\n"+
					"魔教的小楼一夜听春雨，果然煞气非凡。\n", me);
			me->set_temp("tmark/魔刀", 1);
			return 1;
		} else
		{
			message_vision("西方不败看了看$N送来的魔刀，说道：什么狗屁魔刀，我看也没什么特殊。\n"+
			"西方不败随手就将圆月弯刀给扔了。\n",this_object(),me);
			return 1;			
		}
	}
	if ((string) ob->query("id") =="hanyue blade") 
	{	
		if ((int)me->query_temp("jm_riyue_xifang1") && (string)me->query("family/family_name") == "日月神教")	
		{
			message_vision("西方不败看了看$N送来的寒月斩，点了点头，说道：\n"+
					"很好！寒月斩果然寒气逼人。\n", me);
			me->set_temp("tmark/寒月", 1);
			return 1;
		} else
		{
			message_vision("西方不败看了看$N送来的寒月斩，说道：什么狗屁寒月斩，我看也没什么特殊。\n"+
			"西方不败随手就将寒月斩给扔了。\n",this_object(),me);
			return 1;			
		}
	}
	if ((string) ob->query("id") =="kuihua baodian") 
	{
		if ((int)me->query_temp("jm_riyue_xifang1") && (string)me->query("family/family_name") == "日月神教")	//解密日月神教	
		{
			if ((int)me->query_temp("tmark/魔刀") && (int)me->query_temp("tmark/魔剑") && (int)me->query_temp("tmark/寒月") /*&& me->query("id")==ob->query("owner")*/ && (string)me->query("family/family_name") == "日月神教")
			{
				message_vision("西方不败回过神来，说道：哦，你是想问葵花宝典啊。\n",me);
				message_vision("西方不败说道：《葵花宝典》分为两半，一为乾部，一为坤部，江湖中亦有人将之称为“天书、地书”、“阴录、阳录”。\n",me);
				message_vision("西方不败说道：这种破书害人不浅，老子随手就扔在断桥下面了，还不知道能不能找得到呢。\n",me);
				me->set_temp("jm_riyue_xifang2", 1);
				me->delete_temp("tmark");
				return 1;
			} else
			{
				message_vision("西方不败看了看$N送来的葵花宝典，这种武功缺少某种关键之处，上下不通，我就收起来了。\n",me);
				return 1;
			}
		} else	//拿葵花残本3	
		{
			if ((int)me->query_temp("tmark/葵花1") && (int)me->query_temp("tmark/葵花2") /*&& me->query("id")==ob->query("owner")*/ && (string)me->query("family/family_name") == "日月神教")
			{
                message_vision("$N对$n说道：稍等片刻，我将这三本秘籍仔细参详一番......\n", this_object(),me);
				message_vision("$N对$n说道：修炼此武对人伤害极重，切莫为了呈一时之欢而痛苦一辈子!!!!!!!!!\n", this_object(),me);
                message_vision("$N对$n说道：好了，以我的武学修为，此剑法可以再上一层境界！！！\n", this_object(),me);
				message_vision("$N对$n说道：郑重的忠告你，这种武功虽威力极大，然毒害极深！！！切莫练之！！！>\n", this_object(),me);
				message_vision("$N对$n说道：这本剑谱就交给你了！练之前三思！！！\n", this_object(),me);
				message("channel:chat", HIR"【谣言四起】"HIR + "听说"+me->query("name")+"获得了西方不败的葵花宝典剑法篇！\n"NOR,users() );	
				ob = new("/d/heimuya/npc/obj/kuihua3");
				ob->set("owner",me->query("id"));	//设定识别
                ob->move(this_player());
                return 1;
			} else
			{
                message_vision("西方不败看了看$N送来的经书，说道：这种武学流毒江湖！还是交给我收起来吧。\n",this_object(),me);
                return 1;
			}
		}			
	}				
	
	
//拿葵花残本3	
	if ( (string) ob->query("id") =="kuihua baodian1" )
	{      
		if ( (string)me->query("family/family_name") == "日月神教" /*&& me->query("id")==ob->query("owner")*/)
		{
			message_vision("$N对$n说道：当年红叶禅师得到葵花宝典的下半部，为了避免葵花宝典为害江湖人士，特将其毁于五行洞中，为何又重现江湖？\n", this_object(),me);
			message_vision("$N对$n说道：既然你一心一意的想要当太监，那就成全你吧。\n", this_object(),me);
			message_vision("$N对$n说道：若你能找到辟邪剑谱的下册.........\n", this_object(),me);
			me->set_temp("tmark/葵花1", 1);  
			return 1;
		} else
		{
			message_vision("西方不败看了看$N送来的经书，说道：这种武学流毒江湖！还是交给我收起来吧。\n",this_object(),me);
			return 1;
		}
	}
	if ( (string) ob->query("id") =="kuihua baodian2" )
	{ 
		if ( (string)me->query("family/family_name") == "日月神教" /*&& me->query("id")==ob->query("owner")*/)
		{
			message_vision("$N对$n说道：没想当你为了当太监，居然冒死去了五行洞。\n", this_object(),me);
			message_vision("$N对$n说道：好吧，既然你吃了秤砣铁了心的想当太监，那么我就替你参详一下辟邪剑谱。\n", this_object(),me);
			message_vision("$N对$n说道：这两本剑谱似乎缺少了心法篇，如果你能找到葵花心法，或许我能参详出更高深的辟邪剑法。\n", this_object(),me);
			me->set_temp("tmark/葵花2", 1);  
			return 1;
		} else
		{
			message_vision("西方不败看了看$N送来的经书，说道：这种武学流毒江湖！还是交给我收起来吧。\n",this_object(),me);
			return 1;
		}
	}			

		return 0;
}