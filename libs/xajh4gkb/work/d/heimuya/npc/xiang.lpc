// xiang.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int ask_kill();

void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("向问天", ({ "xiang wentian", "xiang" }));
  set("nickname", HIR "天王老子" NOR);
  set("gender", "男性");
  set("title", "日月神教光明右使");
  set("long", "他就是日月神教的光明右使。为人极为豪爽。\n");
  set("age", 45);
  set("shen_type", 0);
  set("attitude", "peaceful");
  set("str", 21);
  set("per", 28);
  set("int", 30);
  set("con", 26);
  set("dex", 30);
  set("chat_chance", 1);
  set("inquiry", ([
    "杨莲亭": "这种人，该杀！\n",
    "东方不败": (: ask_kill() :),
    "任我行": "教主被困，已历十年......\n",
  ]));
  set("qi", 4000);
  set("max_qi", 4000);
  set("jing", 1000);
  set("max_jing", 1000);
  set("neili", 3500);
  set("max_neili", 3500);
  set("wuyongjiali", 350);

  set("combat_exp", 45000000);
  set("score", 0);
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianmo-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuxue-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianmo-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianmo-jian", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "tianmo-shengong");
  map_skill("dodge", "wuxue-shenfa");
  map_skill("parry", "tianmo-jian");
  map_skill("unarmed", "tianmo-quan");
  map_skill("sword", "tianmo-jian");

  create_family("日月神教", 2, "光明右使");

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("str", 1) < 25) {
    command("say 我不收资质差的弟子，您请回吧！\n");
    return;
  }
  if (ob->query("xyzx_sys/level", 1) < 1000) {
    command("say 我不收实力差的弟子，您请回吧！\n");
    return;
  }
  if ((int)ob->query("shen") > 100000 || (int)ob->query("shen") < -100000) {
    command("say 我黑木崖与世隔绝，向来不与您这种成名人物打交道，您请回吧！;\n");
    return;
  }
  command("nod");
  command("say 很好，很好，望你能将我日月神教发扬光大！。\n");
  command("recruit " + ob->query("id"));
}

int ask_kill() {
  object ob, me = this_player();

  command("tell " + this_player()->query("id") + " 你要去杀东方不败？\n");
  if ((string)me->query("family/family_name") == "日月神教") {
    message_vision(HIC "向问天对$N点了点头说：我助你一臂之力。\n" NOR, this_player());
    ob = new("/d/heimuya/npc/obj/card4");
    ob->move(me);
    me->set_temp("jm_riyue_ren1", 1);
    tell_object(me, "向问天从怀里摸出一块令牌塞到你的手上。\n");
  } else {
    message_vision(HIC "向问疑惑的看了看你：你该不会是东方不败派来的奸细吧。\n" NOR, this_player());
  }
  return 1;
}

void die() {
  object me, obj;
  me = query_temp("last_damage_from");
  if (me) {
    tell_room(environment(this_player()), "突然从向问天的尸体上掉出一本泛黄的帛卷！！！\n");
    obj = new("/d/heimuya/obj/shuaiyitie");
    obj->set("owner", me->query("id"));  //设定识别
    obj->move(me);
  }
  ::die();
}
