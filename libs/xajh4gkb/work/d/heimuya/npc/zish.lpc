inherit NPC;

void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("紫衫侍者", ({ "zishan shizhe", "shizhe", "zhe" }));
  set("gender", "男性");
  set("age", 18);
  set("class", "hemuya");
  set("combat_exp", 1000);
  set_skill("unarmed", 50);
  set_skill("dodge", 70);
  set_skill("force", 100);
  set("force", 300);
  set("max_force", 300);
  setup();
  carry_object(__DIR__ "obj/zichoush")->wear();
}
