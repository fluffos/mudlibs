// huangboliu.c
inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;
#include <ansi.h>;
void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("黄伯流", ({ "huang boliu","huang","boliu"}) );
	set("gender", "男性" );
	set("title", "日月神教风雷堂香主");
	set("nickname", HIW"银髯蛟"NOR);
	set("age", 85);
	set("long", "一部白须，直垂至胸，身材魁梧之极。\n");
set("attitude", "peaceful");	
	set("shen_type", 0);

	set("per", 21);
	set("str", 23);
	set("int", 23);
	set("con", 22);
	set("dex", 20);

	set("max_qi", 1000);
	set("max_jing",1000);
	set("neili", 1000);
	set("max_neili", 1000);
	set("combat_exp", 350000);
	set("wuyongjiali", 100);
	set("score", 30000);

	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("tianmo-shengong",500+jibie/3+random(jibie/5));
	set_skill("wuxue-shenfa", 500+jibie/3+random(jibie/5));
	set_skill("tianmo-quan", 500+jibie/3+random(jibie/5));
	map_skill("force", "tianmo-shengong");
	map_skill("dodge", "wuxue-shenfa");
	map_skill("parry", "tianmo-quan");
	map_skill("unarmed", "tianmo-quan");


	create_family("日月神教",6,"弟子 风雷堂香主");

	setup();
        carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{

    if ((int)ob->query("shen") >100000 || (int)ob->query ("shen") < -100000 ) {
        command("say 我黑木崖与世隔绝，向来不与您这种成名人物打交道，您请回吧！;\n");
                return;
        }
	command("nod");
    command("say 很好，很好，望你能将我日月神教发扬光大！。\n");
    command("recruit " + ob->query("id"));
}
