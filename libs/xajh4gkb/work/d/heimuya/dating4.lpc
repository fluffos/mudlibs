//ROM dating
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", "天香堂");
  set("long",
    "这是『日月神教』下第四大堂:天香堂的大厅，远远望去郁郁渺渺，好似不\n"
    "食人间烟火。堂梁上有一块匾(bian).\n"
  );

  set("exits", ([
    "west": __DIR__ "road1",
  ]));
  set("no_clean_up", 0);
  set("bian_ci", 3);
  set("item_desc", ([
    "bian": "上面写到：天香堂---日月神教圣姑住地。\n",
  ]));
  setup();

  replace_program(ROOM);
}

void init() {
  add_action("do_move", "push");
  add_action("do_move", "move");
}

int do_move(string arg) {
  object me;
  me = this_player();
  if (me->query_condition("killer")) return 0;
  if (!arg || arg == "") return 0;
  if (arg == "bian") {
    if (query("bian_ci") < 1)
      return notify_fail("哎呀，匾掉下来了摔碎了，赶紧走吧。\n");
    me->move(__DIR__ "tian1");
    add("bian_ci", -1);
    return 1;
  }
}
