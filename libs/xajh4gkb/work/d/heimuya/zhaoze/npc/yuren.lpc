//yuren.c
inherit NPC;
void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
    set_name(HIW "渔人" NOR, ({"yu ren"}));
    set("gender", "男性");
    set("age", 42);
    set("per", 18);
    set("long", 
        "他一张黑漆漆的锅底脸，虬髯满腮，根根如铁。\n");
    set("attitude", "peaceful");
    
    set("str", 251);
    set("int", 80);
    set("con", 86);
    set("dex", 140);
    set("chat_chance", 5);

    set("qi", 2000);
    set("max_qi", 2000);
    set("jing", 2000);
    set("max_jing", 2000);
    set("max_jingli", 1000);

    set("jingli", 1000);
    set("neili", 10000);
    set("max_neili", 1000);
    set("wuyongjiali", 300);
    
    set("combat_exp", 400000);
     
    set_skill("force", 500+jibie/3+random(jibie/5));             // 基本内功
    set_skill("tianshan-zhang", 500+jibie/3+random(jibie/5));
    set_skill("yiyang-zhi", 500+jibie/3+random(jibie/5));
    set_skill("yunlong-shengong", 500+jibie/3+random(jibie/5));
    set_skill("yunlong-shenfa", 500+jibie/3+random(jibie/5));
    set_skill("staff", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));           // 基本拳脚
    set_skill("dodge", 500+jibie/3+random(jibie/5));             // 基本躲闪
    set_skill("parry", 500+jibie/3+random(jibie/5));             // 基本招架
    
    map_skill("force"  , "yunlong-shengong");
    map_skill("unarmed", "yiyang-zhi");
    map_skill("dodge"  , "yunlong-shenfa");
    map_skill("parry"  , "tianshan-zhang");
    map_skill("staff"  , "tianshan-zhang");
    
    setup();
    carry_object("/clone/cloth/cloth")->wear();
    carry_object("/clone/weapon/gangjiang")->wield();   
	carry_object("/d/obj/quest/wang");
}

void die()
{
        object killer;
        if( objectp(killer = query_temp("last_damage_from")) )
                 killer->add_temp("kill_shi",1);
           ::die();
}

