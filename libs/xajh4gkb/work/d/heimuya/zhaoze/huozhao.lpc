// Room: /d/heimuya/zhaoze/huozhao.c
inherit ROOM;
int do_pull(string);
void create()
{
        set("short", "洪荒古泽");
        set("long", @LONG
你站在齐腰深的水里，周围是给烧得乌黑的古树和芦苇。前面有
一缺口，象是被一种巨大的动物经过所形成的。远处隐隐传来阵阵的
低沉的声音和热浪。据说大理古国的开创者曾在洪荒古泽里领悟到绝世武学，
不知道后来闻名江湖的六脉神剑与五罗轻烟掌是不是来自于此（lingwu）。
LONG
);
        set("exits", ([ 
  "southwest" : __DIR__"huozhao1",
]));

        setup();
}
void init()
{
        object me=this_player();
        add_action("do_pull", "pull");
		add_action("do_lingwu", "lingwu");
        if (random(me->query("kar"))<10){
            message_vision(RED "$N身子突然下沉... ...\n" NOR,me);
            me->set_temp("drop_zhaoze",1);
        }
}


int do_pull(string arg)
{
    object ob;
    object me = this_player(); 

    if (!arg)
        return notify_fail("你要拉谁？\n");

    if (!ob = present(arg,this_object()))
        return notify_fail("你要拉谁？\n");

    if (me->query_temp("drop_zhaoze"))
        return notify_fail("你自己都自身难保了，还想拉别人？\n");

    if (!ob->query_temp("drop_zhaoze"))
        return notify_fail(ob->name()+"不用你拉！\n");

    message_vision("你扯住$N的手，使劲把$n扯了上来。\n",me,ob);
    ob->delete_temp("drop_zhaoze");
    return 1;
}
int valid_leave(object me, string dir)
{
        if (dir=="south" && me->query_temp("drop_zhaoze")){
                message_vision("$N使劲挣扎一下，试图爬出泥潭.....\n",me);
                if (random(10)>5){   
                        me->apply_condition("scorpoin_poison",20);
                        tell_object(me,RED "\n你突然觉得脚被什么东西刺了一下... ...\n" NOR);
                }
                if (random(me->query_skill("dodge",1))>1000){
                        message_vision("$N身形一纵，跃出泥潭。\n",me);
                        return 1;
                }else{
                        message_vision("$N结果越陷越深！\n",me);
                        me->set_temp("die_for","陷进沼泽闷");
                        me->receive_wound("qi",200+random(me->query("max_qi")/100));
						me->receive_damage("qi",200+random(me->query("max_qi")/100));
                       return notify_fail("你陷入沼泽，动弹不得。\n");
                }
        }
        return 1;
}


int do_lingwu(string arg)
{
  object me=this_player();
 
  string *poem = ({
		"这道水痕，似乎是「"HIM"一阳指"NOR"」造成的，为什么会有这么大威力？",
		"这道泥泽，似乎是「"HIG"六阴鬼脉"NOR"」所造成的，似乎又有些不同。",
		"这道雨雾，似乎是「"HIB"五罗轻烟掌"NOR"」造成的，为什么.....？？难道因为某种内功？？？？？？",
		"这道微风，似乎是「"HIY"六脉神剑"NOR"」散发的剑气，怎样逆天的威力，如此可怕....",
		"「"HIB"烟雨蒙蒙"NOR"」么？？？？似乎五行流转，情意绵绵。为什么？",
		"「"HIB"龙飞凤舞"NOR"」么？？？？似乎一阴一阳，生死两茫茫。为什么？",
		});

    if(me->is_busy() )
        return notify_fail("你现在忙着呢，哪有功夫在沼泽中领悟东西...\n");
    if((int)me->query_skill("yiyang-zhi",1) < 2000 && (int)me->query_skill("wuluo-zhang",1) < 2000)
        return notify_fail("你运行了一道真气，却发现自己对某种武学领悟不够。\n");
    if((int)me->query_skill("liumai-shenjian",1) < 2000 && (int)me->query_skill("feifeng-whip",1) < 2000)
        return notify_fail("你运行了一道真气，却发现对某种招式难以理解。\n");
     if((int)me->query_skill("kumu-shengong",1) < 1000 )
        return notify_fail("你打坐了一会，似乎觉得内功似乎不对。\n");     
    if(me->query("family/family_name") != "大理段家")
		return notify_fail("你举目四望，只觉得洪荒气息铺面，难以静下心来？？？？？。\n"); 		
	if (me->query("family/master_id")!="yideng dashi")
		return notify_fail("举头三尺有神明，你摸了摸头，似乎缺少名师指点？？？\n"); 
    if(me->query("qi") < 1000)
		return notify_fail("你还是先休息一会儿吧。\n"); 
    if(!me->query_temp("jm_dali2")) 
		return notify_fail("你未得到一灯大师的指点，在这里没法领悟。\n"); 
    if(me->query("jm/dali")) 
		return notify_fail("你已经完全领悟了大理段家的武学精髓，不需要在这领悟了。\n"); 

	
	tell_object(me,HIW"你在雾气蒙蒙的沼泽之中，汲取洪荒之气......\n"NOR);
    message_vision("" + poem[random(sizeof(poem))] + "\n", me);
    me->add("qi",-1000);		
    me->start_busy(1);

	if( random(100000) < me->query("kar",1) )
    {
		if (me->query("gender")=="男性" )
		{
        tell_object(me,HIG"你突然醒悟道："HIY"原来一阳指还可以有此等威力"HIR"！\n"NOR);
		tell_object(me,HIG"恭喜你融汇贯通了大理段家武功的精髓！\n"NOR);
		message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，在洪荒古泽居然领悟了六脉神剑的终极奥义！\n"NOR,users() );
		}
		if (me->query("gender")=="女性" )
		{
        tell_object(me,HIG"你突然醒悟道："HIY"原来五罗轻烟掌还可以有此等威力"HIR"！\n"NOR);
		tell_object(me,HIG"恭喜你融汇贯通了大理段家武功的精髓！\n"NOR);
		message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，在洪荒古泽居然领悟了五罗轻烟掌的终极奥义！\n"NOR,users() );
		}
		me->set("jm/dali",1);
		me->add("family_score",1);
    }
    return 1;
}             

