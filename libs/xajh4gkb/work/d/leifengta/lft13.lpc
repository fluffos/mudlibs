// by HAPP@YSZZ

inherit ROOM;

void create() {
  set("short", "雷峰塔：第十三层");
  set("long", @LONG

这里就是雷峰塔，进入后顿显另有玄机，完全不像是只有十三层高的
样子。金山寺法海座下十三高僧坚守在此看押塔中的无数邪魔妖道。寺院内
不少游人与百姓在虞诚的上香祈祷，一时香烟寥寥，从远处看，寺中雷峰塔
宛若矗立于白云之上，阳光一出，由于佛光四射。

LONG);
  set("exits", ([
    "down": __DIR__ "lft12",
  ]));

  set("objects",
    ([
      __DIR__ "npc/xiaobai": 1,
    ]));
  set("no_ansuan", 1);
  set("outdoors", "leifengta");
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "down")
    return notify_fail(HIR "一入雷峰塔，生死两茫茫，只能上不能下！\n" NOR);
  return ::valid_leave(me, dir);
}
void init() {
  object ob = this_player();
  if (userp(ob)) {
    //		remove_call_out("tingliu_time13");
    call_out("tingliu_time13", 120, ob);
  }

  add_action("do_fly", "fly");
  add_action("do_conjure", "conjure");
  add_action("do_jump", "jump");
}

int do_fly(string arg) {
  object me;
  me = this_player();

  message_vision(HIR "雷峰塔内妖气弥漫，在这里御剑飞行很容易出事故。\n" NOR, me);
  message_vision(HIC "雷峰塔只有高手才能上来，既然上来了，那就只能依靠自身实力下去(jump down)。\n" NOR, me);
  return 1;
}

int do_conjure(string arg) {
  object me;
  me = this_player();

  message_vision(HIR "雷峰塔内妖气弥漫，在这里使用道家神通很容易出事故。\n" NOR, me);
  message_vision(HIC "雷峰塔只有高手才能上来，既然上来了，那就只能依靠自身实力下去(jump down)。\n" NOR, me);
  return 1;
}

int do_jump(string arg) {
  object me;
  me = this_player();
  if (!arg || arg == "") return 0;
  if (arg == "down") {
    if (me->query_skill("dodge", 1) >= 5000) {
      message_vision("$N浑身颤抖着，向前一跃……\n", me);
      me->move("/d/hangzhou/xizhaoshan");
      me->unconcious();
    } else {
      message(
        "rumor",
        HIR "【谣言四起】某人：" HIW "听说" + me->query("name") + "一失足成千古恨，从雷峰塔十三层跳了下来。。。。\n" NOR,
        users()
      );
      me->die();
      return 1;
    }

    return 1;
  }
}

void tingliu_time13(object ob) {
  object room;
  if (!objectp(ob)) return;
  if (!(room = find_object("/d/leifengta/lft13"))) room = load_object("/d/leifengta/lft13");
  if (environment(ob) != room) return;
  ob->move("/d/hangzhou/xizhaoshan");
  message_vision(HIC "法海在雷峰塔中法相显化，对着你喝到：雷峰塔乃封妖之地，速速离开！\n" NOR, ob);
  tell_object(ob, HIG "只见你一声惨叫，被一阵妖风扫落到雷峰塔外。\n" NOR);
  ob->unconcious();
  return;
}
