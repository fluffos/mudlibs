// by HAPP@YSZZ

inherit ROOM;

void create ()
{
	set ("short", "雷峰塔：第九层");
	set ("long", @LONG

这里就是雷峰塔，进入后顿显另有玄机，完全不像是只有十三层高的
样子。金山寺法海座下十三高僧坚守在此看押塔中的无数邪魔妖道。寺院内
不少游人与百姓在虞诚的上香祈祷，一时香烟寥寥，从远处看，寺中雷峰塔
宛若矗立于白云之上，阳光一出，由于佛光四射。

LONG);
	set("exits", ([
		"up"    :       __DIR__"lft10",
		"down"  :       __DIR__"lft8",
	]));

	set("objects", 
	([
		__DIR__"npc/zhujiuyin" : 1, 	
	]));
	set("no_ansuan",1);
	set("outdoors", "leifengta");
	setup();
}

int valid_leave(object me, string dir)
{
	if ( dir == "down" )
		return notify_fail(HIR"一入雷峰塔，生死两茫茫，只能上不能下！\n"NOR);
	if ( present("zhu jiuyin") && dir == "up" )
		return notify_fail(HIR"帝江冷笑一声：先过我这关再说！\n"NOR);
	return ::valid_leave(me, dir);
}

int do_check(object me)
{
	object where=this_object();
	object *obj;
	int i;
	obj=deep_inventory(where);
	if (!sizeof(obj))   return 0;
	for (i=0;i<sizeof(obj);i++)
	{
		if (obj[i]==me) continue;
		if (userp(obj[i]))
			return 1;
	}
	return 0;
}

void init()
{
	object monk,ob=this_player();
	
	if(userp(ob))
	{
//		remove_call_out("tingliu_time9");
		call_out("tingliu_time9", 120, ob);
		if(!ob->query_temp("day_lft/tiaozhan") || (int)ob->query_temp("apply/damage")<0)
		{
			message_vision(HIY"法海的法相显化：擅闯雷峰塔，永镇塔底！\n"NOR,ob);
			ob->move("/d/hangzhou/xizhaoshan");
			return;
		}		
	}
	if(userp(ob) && (int)do_check(ob))
	{
		message_vision(HIY"十二祖巫正在料理敌人，没空搭理你！\n"NOR,ob);
		ob->move(__DIR__"leifengta");
		return;
	}
	if(userp(ob) && ob->query_temp("day_lft/tiaozhan"))
	{
		if( !objectp(monk = present("zhu jiuyin", environment(ob)) ))
		{
			monk = new(__DIR__"npc/zhujiuyin");
			monk->move(environment(ob));
		}
		return;
	}
}

void tingliu_time9(object ob)
{
	object room;
	if ( !objectp(ob) ) return;
	if(!( room = find_object("/d/leifengta/lft9")) ) room = load_object("/d/leifengta/lft9");
	if(environment(ob)!=room) return;
	ob->move("/d/hangzhou/xizhaoshan");
	message_vision(HIC"法海在雷峰塔中法相显化，对着你喝到：雷峰塔乃封妖之地，速速离开！\n"NOR, ob);
	tell_object(ob, HIG"只见你一声惨叫，被一阵妖风扫落到雷峰塔外。\n"NOR);
	ob->unconcious();
	return;
}