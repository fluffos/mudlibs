#include <ansi.h>

inherit NPC;

void create() {
  int jibie = 8000;
  set_name(HIC "白素贞" NOR, ({ "bai suzhen", "xiaobai" }));
  set("gender", "女性");
  set("age", 36);
  set("long", NOR "她就是白蛇传中的白蛇，修炼八百年化为人身。\n" NOR);
  set("attitude", "peaceful");
  set("str", 30);
  set("con", 30);
  set("int", 30);
  set("dex", 30);
  set("per", 30);
  set("kar", 30);
  set("chat_chance", 10);
  set("chat_msg", ({
    "官人，你在哪里啊？\n",
    "可怜官人被那法海困在金山寺......\n",
  }));

  set("jm/xuantian", 1);
  set("xyzx_sys/level", jibie);
  set("combat_exp", 10000000);
  set_skill("blade", 500 + jibie * 2 + random(jibie / 5));
  set_skill("art", 500 + jibie * 2 + random(jibie / 5));
  set_skill("dodge", 500 + jibie * 2 + random(jibie / 5));
  set_skill("force", 500 + jibie * 2 + random(jibie / 5));
  set_skill("taoism", 500 + jibie * 2 + random(jibie / 5));
  set_skill("literate", 500 + jibie * 2 + random(jibie / 5));
  set_skill("parry", 500 + jibie * 2 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie * 2 + random(jibie / 5));
  set_skill("sword", 500 + jibie * 2 + random(jibie / 5));
  set_skill("qimen-wuxing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lingyuan-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianxin-blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("cuixin-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lingyunbu", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "lingyuan-xinfa");
  map_skill("dodge", "lingyunbu");
  map_skill("parry", "tianxin-blade");
  map_skill("blade", "tianxin-blade");
  map_skill("unarmed", "cuixin-zhang");
  set("inquiry", ([
    "许仙": "十年修得同船渡，百年修得共枕眠...\n" + NOR,
  ]));

  setup();
  carry_object("/clone/weapon/yehuo")->wield();
  carry_object("/clone/cloth/hiw_cloth")->wear();
}
