#include <ansi.h>

inherit NPC;

void create() {
  int jibie = 5000;
  set_name(HIW "许仙" NOR, ({ "xu xian", "xuxian" }));
  set("nickname", MAG "牧童" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", NOR "他就是白蛇传中的许仙，与白素贞结为夫妻。\n" NOR);
  set("attitude", "peaceful");
  set("str", 28);
  set("con", 29);
  set("int", 18);
  set("dex", 22);
  set("per", 23);

  set("xyzx_sys/level", jibie);
  set("combat_exp", 1000000);
  set_skill("buddhism", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qianye-shou", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sanhua-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("cibei-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "hunyuan-yiqi");
  map_skill("unarmed", "qianye-shou");
  map_skill("parry", "sanhua-zhang");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("blade", "cibei-dao");
  setup();
  carry_object("/d/shaolin/obj/cloth")->wear();
}
