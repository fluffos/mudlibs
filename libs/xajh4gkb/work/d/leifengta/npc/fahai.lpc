void create()
{
	int jibie=9000;
    set_name(HIR"法海禅师"NOR, ({ "fahai chanshi","fahai" }) );
    set("title", HIC "金山寺主持" NOR);
    set("nickname", MAG "道德法师" NOR);
    set("gender", "男性");
    set("age", 57);
    set("long", NOR"他就是金山寺的主持，修炼得道的高僧。\n"NOR);
    set("attitude", "peaceful");
    set("str", 30);
    set("con", 30);
    set("int", 30);
    set("dex", 30);
    set("per", 25);
	set("no_get",1);
    set("chat_chance", 1);
    set("chat_msg", ({
        (: command("xixi xiaoqing") :),
        (: command("grin xiaoqing") :),
    }) );
	set("jm/shaolin",1);
	set("jm/baituo",1);
    set("xyzx_sys/level", jibie);
    set("combat_exp", 10000000);
	set_skill("buddhism", 500+jibie/3+random(jibie/5));
    set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("staff", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("literate", 500+jibie/3+random(jibie/5));
	set_skill("training", 500+jibie/3+random(jibie/5));
    set_skill("hunyuan-yiqi", 500+jibie/3+random(jibie/5));
	set_skill("hamagong", 500+jibie/3+random(jibie/5));
	set_skill("qianye-shou", 500+jibie/3+random(jibie/5));
	set_skill("shexing-diaoshou", 500+jibie/3+random(jibie/5));
    set_skill("pudu-zhang", 500+jibie/3+random(jibie/5));
    set_skill("lingshe-zhangfa", 500+jibie/3+random(jibie/5));
	set_skill("chanchu-bufa", 500+jibie/3+random(jibie/5));
    map_skill("force", "hamagong");
    map_skill("unarmed",  "shexing-diaoshou");
    map_skill("parry", "qianye-shou");
    map_skill("dodge", "chanchu-bufa");
	map_skill("staff", "lingshe-zhangfa");
    set("inquiry", ([
//		"盘口"   : (: ask_pan :),
		"雷峰塔" :(: ask_leifengta :),
//		"怎么赌" : "我和每个成功登塔的高手签约，你如果失败了得付我们若干黄金，只要你钱庄里有存款。\n"+NOR,
//		"签约"   : "你想做歌星？唉，有足够的存款直接上去就行了，你输了我自己去取。\n"+NOR,
		"小青"   : "不就在我旁边吗..你都知道了？呃，是的，其实我们是得道高僧...\n"+NOR,
		"小白"   : "不就在我旁边吗..你都知道了？人妖不得相恋...\n"+NOR,
		"许仙"   : "哎，都是妖孽啊...\n"+NOR,
    ]));

    setup();
    carry_object("/d/shaolin/obj/jingang-zhao")->wear();
	carry_object("/clone/weapon/ganqi")->wield();
}

int ask_leifengta()
{
	object me;
	mixed *local;
	me = this_player();
	local = localtime(time());
	if ( local[LT_MDAY] == (int)me->query("day_leifengta_timecd"))	//每天
	{
		message_vision(HIR"法海看了你一眼: 你今天进入雷峰塔的次数已经耗尽了！\n"NOR, this_object(),me);
		me->delete_temp("day_lft");
		return 1;
	}
	
	if ( me->query("xyzx_sys/level") >= 5000)
	{
		if ( me->query_temp("day_lft/tiaozhan") )
		{
			message_vision(HIB"法海禅师说道：你似乎妖气入体，待老衲收了妖气再说。\n" NOR,me);
			me->delete_temp("day_lft");
			return 1;
		}
		else
		{
			message_vision(HIB"法海禅师说道：塔内妖物乃十二祖巫，"+RANK_D->query_respect(me)+"量力而行，切莫强上。\n" NOR,me);
			message("party", HIM"【雷峰塔】"+HIG"听说 "+me->name(1)+HIG"("+me->query("id")+HIG") 进入雷峰塔挑战十二祖巫。\n"NOR,users() );
			me->set_temp("day_lft/tiaozhan",1);
			me->set("day_leifengta_timecd", local[LT_MDAY]);
			me->move("/d/leifengta/leifengta");
			return 1;
		}
	}
	else 
	{
		message_vision(YEL"法海禅师说道：塔内妖物乃十二祖巫，实力非同小可！你还是不要乱闯\n" NOR,me);
		return 1;		
	}
	
	return 1;
}