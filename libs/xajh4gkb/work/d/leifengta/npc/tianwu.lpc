#include <ansi.h>
inherit NPC;
#include <mp_skills.h>

void create()
{
    int i,index,jibie;
	mapping mp;
	string *basic=({"poison","force","dodge","parry","unarmed","hand","finger","strike","magic","spells","cuff","claw","taoism","sword","blade","club","staff","hammer","throwing","axe","whip","dagger","spear","fork","stick"});
	index = random(sizeof(menpai));
	mp = menpai[index];	
	jibie = 10000;
	
	set_name("天吴", ({"tian wu","zuwu"}));
	set("long", "八首人面，虎身十尾，风之祖巫。\n");
	set("gender","男性");
	set("title", "【"+HIY"十二祖巫"+NOR"】");
	set("age",37);
	set("attitude", "aggressive");
	set("con",30);
	set("dex",30);
	set("str",30);
	set("int",30);
	set("no_suck",1);
	set("combat_exp",100000000);
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定
	set("chat_chance",10);
	set("chat_msg", ({
			"妖有妖道，人有人道，人妖不得相恋！\n"   
        }));

	if(!query("wugong",1))
	{
		if (mp["gender"]) set("gender",mp["gender"]);
		if (mp["family"]) create_family(mp["family"], 100, "传人");
		for (i=0; i<sizeof(keys(mp)); i++)
		{
			if (keys(mp)[i]=="knowledge") set_skill(mp[keys(mp)[i]],500+jibie/2+random(jibie/2));
			if (member_array(keys(mp)[i],basic)!=-1)
            {
				set_skill(keys(mp)[i],500+jibie*2+random(jibie/2));
				set_skill(mp[keys(mp)[i]],500+jibie/2+random(jibie/2));
				map_skill(keys(mp)[i],mp[keys(mp)[i]]);				
            }
		}
		set("wugong",1);
	}

	setup();
	if(!query("wuqi",1))
	{
		if (mp["weapon"]) carry_object(mp["weapon"])->wield();
		set("wuqi",1);
	}
    carry_object("/clone/cloth/hanbing-jia")->wear();
    add_money("gold", 100+random(jibie));
}

void just_kill(object guai,object player)
{
	if(!objectp(guai)||!objectp(player)) return ;
	if(environment(guai) != environment(player)) return ;
	if( environment(player)->query("no_fight") ) return ;
	if (!player->query_temp("day_lft/tiaozhan"))
	{
		message_vision("哪里来的人类！本妖已五百年不知肉味了！\n你吓得瑟瑟发抖，连忙使出法海给的挪移袈裟，“嗖”的一声，摔在夕照山下......\n"NOR,player,guai);
		player->move("/d/hangzhou/xizhaoshan");
		return ;
	}
	else
	{
		if (!player->query_temp("day_lft/winer10"))
		{
			message_vision(""+guai->query("name")+"冷声道：想见白素贞，先过我这一关再说吧！\n"NOR,player,guai);
			guai->kill_ob(player);
			player->kill_ob(guai);
			return ;
		}
		else
		{
			message_vision(""+guai->query("name")+"大怒道：你已经夺了我一甲子道行了，还不快滚！\n"NOR,player,guai);
			player->move("/d/leifengta/lft11");
			return ;
		}
	}	

    return ;
}
void init()
{
	object ob, me;
    
	me = this_object();
    ob = this_player();

	// 怪物必须是可以动作的，并只针对玩家
	if ( !objectp(ob) || !living(me) || !playerp(ob) ) return;
	// 见面就杀
	//me->kill_ob(ob);	//这条表示见人就杀
	call_out("just_kill",1,me,ob);	//这条表示执行上述定义的just_kill这一段
}

void die()
{
	object ob, me, corpse, baoshi, env;
	string room, name;
	int m,flag,xingyun;
	xingyun = 0;
	ob = this_object();
	flag = 1;

	// 先绑定到打晕的对象上
	if ( !objectp(me = ob->query_temp("last_unconcious_from")) )
		me = ob->query_temp("last_damage_from"); // 绑定到最后伤害对象

	if ( !objectp(me) // 未成功绑定
		|| !objectp(env=environment(ob)) 
		|| !stringp(room=env->query("short")) ) 
	{
		::die();
		return;
	}

	if ( me )
	{
		m = 10000000+random(10000000);
		
		if ( interactive(me) )
		{
			message("party", HIW"【"+room+"】"+HIG+me->name(1)+HIM" 杀死了 "+ob->name(1)+HIM" ，奖励了 "HIC+(me->query_exp_times()*m)+HIM" 点经验和 "HIY+(m/10)+HIM" 潜能。\n"NOR,users() );	
			me->add("combat_exp",m);
			me->add("potential",m / 10);
			me->set_temp("day_lft/winer",1);
			me->set_temp("day_lft/winer10",1);

			if ( me->query("xyhy_type") == 2 ) flag = 5/4;
			if (me->query_temp("wupin_max_add")) xingyun = (int)me->query_temp("wupin_max_add",1);	//处于幸运状态时
		}
	}
	
	if ( objectp(corpse = CHAR_D->make_corpse(ob, me)) )
		corpse->move(environment(ob));

	// 绑定到对象，冷冻一分钟
	corpse->set("valid_get_from", me->query("id"));

		if ( objectp(me) && objectp(ob) && random(100000) > (100000-4500*(100+xingyun)/100) )
		{						
			if (random(3)==0)
			{
				switch (random(3))
				{
					case 0: baoshi = new("/clone/tzbox/xiepai4-box");
						break;
					case 1: baoshi = new("/clone/tzbox/zhengpai4-box");
						break;
					case 2: baoshi = new("/clone/tzbox/zhongli4-box");
						break;
				}
			}
			else
			{
				switch (random(3))
				{
					case 0: baoshi = new("/clone/tzbox/xiepai5-box");
						break;
					case 1: baoshi = new("/clone/tzbox/zhengpai5-box");
						break;
					case 2: baoshi = new("/clone/tzbox/zhongli5-box");
						break;
				}
			}
			name = baoshi->name(1);
            message_vision(HIG"\n$N在 "HIY+ob->name(1)+" 的尸体上发现了 "HIW+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,  me);	
		    message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "HIM+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
			baoshi->move(corpse);
		}
		if ( objectp(me) && objectp(ob) && random(100000) < 1000*(100+xingyun)/100 )
		{						
			baoshi = new("/clone/tzbox/medal-box");	
			name = baoshi->name(1);		
            message_vision(HIG"\n$N在 "HIY+ob->name(1)+" 的尸体上发现了 "HIW+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,  me);	//2016.6.15阿飞改，增加显示物品的id		
		    message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "HIM+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
			baoshi->move(corpse);
		}
		if ( objectp(me) && objectp(ob) && random(100000) > (100000-(1000*(100+xingyun)/100)) )
		{						
			baoshi = new("/clone/tzbox/posui-box");	
			name = baoshi->name(1);		
            message_vision(HIG"\n$N在 "HIY+ob->name(1)+" 的尸体上发现了 "HIW+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,  me);	//2016.6.15阿飞改，增加显示物品的id		
		    message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "HIM+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
			baoshi->move(corpse);
		}
		
	COMBAT_D->announce(ob, "dead");
	destruct(ob);
	return;
}
