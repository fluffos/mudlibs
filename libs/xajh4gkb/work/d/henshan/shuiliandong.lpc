// shuiliandong.c
#include <room.h>
inherit ROOM;
void create() {
  set("short", "水帘洞");
  set("long", @LONG
    水帘洞在紫盖峰下，在吐雾和香炉两峰之间。紫盖峰之水经山涧汇
入紫盖仙洞中，深不可测，水满则溢，飞瀑高二十余丈，数叠垂帘，飘
泄而下，蔚为壮观。明张居正诗曰:  "误疑瀛海翻琼波，莫拟银河倒碧
流，自是湘妃深隐处，水晶帘挂五云头。" 以赞叹这衡山大四绝之一的
 "水帘洞之奇" 。
     八部龙女在花果山福地偶遇齐天大圣，自此遇到一生中
的天命之人，然世事难料，那猴头身负命运，红尘中情爱纠缠，龙女
最后将八部剑舞之密(jianwu)刻于洞中，历经十世轮回，最终大彻大悟。
据说凡人踏遍龙女足迹，领悟到其剑舞精髓后，方可将五岳各派剑法
融会贯通(ronghui)。
LONG);
  set("exits", ([ /* sizeof() == 4 */
    "out": __DIR__ "shanlu12",
    "west": __DIR__ "shanlu",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "henshan");
  setup();
  replace_program(ROOM);
}

//第5处解密
void init() {
  add_action("do_jianwu", "jianwu");
  add_action("do_ronghui", "ronghui");
}

int do_jianwu(string arg) {
  object me = this_player();
  int ap;

  string *poem = ({
    "这道剑痕，似乎是「" HIM "阿修罗灭世" NOR "」，为什么会有这么大威力？",
    "这道剑痕，似乎是八部龙女剑其中一招「" HIG "龙女成佛" NOR "」所造成的，似乎又有些不同。",
    "这道剑痕，「" HIB "夜叉渡佛" NOR "」为什么.....？？难道因为某种内功？？？？？？",
    "这道剑痕「" HIY "天王朝圣" NOR "」，怎样逆天的内力，如此可怕....",
    "「" HIB "迦楼罗飞天" NOR "」么？？？？似乎又有些不同。为什么？",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫舞剑哦.....\n");

  if ((int)me->query_skill("literate", 1) < 2000)
    return notify_fail("水帘洞中，一梦百年，百年舞剑，梦幻泡影，然一脸茫然，脑袋一片浆糊，始终无法领悟。\n");

  if ((int)me->query_skill("luoyan-jian", 1) < 2000)
    return notify_fail("水帘洞中，一梦百年，百年舞剑，梦幻泡影，或许本门剑法太低，完全不得要领。\n");

  if (me->query("family/family_name") != "衡山派")
    return notify_fail("水帘洞中，一梦百年，百年舞剑，梦幻泡影，这似乎是某个门派高手舞剑时留下的，到底是哪个门派呢？？？\n");

  if (me->query_skill("zhenyue-jue", 1) < 1000)
    return notify_fail("似乎......内功......也许.......镇岳......\n");

  if (me->query("neili") < 1000)
    return notify_fail("你累的不轻，还是先休息一会儿吧。\n");

  if (me->query_skill("babulongnv-jian", 1) >= 1)
    return notify_fail("你已经完全领悟了八部龙女剑了，没必要再舞剑了。\n");

  if (me->query("jm/babu"))
    return notify_fail("你已经完全领悟八部龙女剑的精髓。\n");

  if (me->query("jm_babu/henshan"))
    return notify_fail("你领悟了八部龙女留在衡山的精髓，至此你已经领悟了八部龙女留在五岳的全部精髓，可以去将这五处精髓融汇贯通了。\n");


  ap = me->query("per", 1) + me->query("kar", 1);
  message_vision("$N水帘洞中，一梦百年，百年舞剑，梦幻泡影：" + poem[random(sizeof(poem))] + "\n", me);
  me->add("neili", -100);
  tell_object(me, HIW "你仔细研究了水帘洞墙上的剑痕，尝试着练习了下......\n" NOR);
  me->improve_skill("literate", 50 + random(10));
  //	me->improve_skill("luoyan-jian", 50+random(10));
  me->start_busy(1);

  if (random(100000) < ap) {
    me->set("jm_babu/henshan", 1);
    tell_object(me, HIG "你突然醒悟道：" HIY "原来八部龙女剑可以有此等威力" HIR "！\n" NOR);
    tell_object(me, HIG "你对八部龙女剑的精髓有所领悟\n" NOR);
  }

  return 1;
}


int do_ronghui(string arg) {
  object me = this_player();
  int ap;

  string *poem = ({
    "这套「" HIM "玉女十九剑" NOR "」似乎应该这样使用？",
    "这套「" HIC "嵩阳十七式" NOR "」寒热交替，如此可怕....？",
    "这套「" HIG "一式落九雁" NOR "」貌似缺了什么，不是很连贯。",
    "这套「" HIB "泰山十八盘" NOR "」为什么.....？？难道气势不对？？",
    "这套「" HIY "百变千幻云雾十三式" NOR "」，如此变幻多端....",
    "这套「" HIR "华岳三神峰" NOR "」紫气浩荡？？难道因为某种内功？？",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫舞剑哦.....\n");
  if (me->query("jingli") < 1000)
    return notify_fail("你精力不足，还是先休息一会儿吧。\n");
  if (me->query("neili") < 1000)
    return notify_fail("你内力不足，还是先休息一会儿吧。\n");
  if (me->query_skill(
    "zixia-shengong",
    1
  ) < 1000 && me->query_skill(
    "hanbing-zhenqi",
    1
  ) < 1000 && me->query_skill(
    "baiyun-xinfa",
    1
  ) < 1000 && me->query_skill(
    "panshi-shengong",
    1
  ) < 1000 && me->query_skill("zhenyue-jue", 1) < 1000)
    return notify_fail("似乎......内功......也许.......紫气....寒气....白云....磐石....镇岳....\n");
  if ((int)me->query_skill("luoyan-jian", 1) < 2000
    || (int)me->query_skill("huashan-jianfa", 1) < 2000
    || (int)me->query_skill("taishan-jianfa", 1) < 2000
    || (int)me->query_skill("songshan-jian", 1) < 2000
    || (int)me->query_skill("hengshan-jian", 1) < 2000)
    return notify_fail("玉女......嵩阳......落雁.......云雾......日出......剑法......\n");
  if (me->query_skill("babulongnv-jian", 1) >= 100)
    return notify_fail("你已经领悟了八部龙女剑了，没必要再舞剑了。\n");
  if (me->query("jm/babu"))
    return notify_fail("你已经完全领悟八部龙女剑的精髓。\n");
  if (!me->query("jm_babu/huashan"))
    return notify_fail("你未领悟龙女留在华山的精髓。\n");
  if (!me->query("jm_babu/taishan"))
    return notify_fail("你未领悟龙女留在泰山的精髓。\n");
  if (!me->query("jm_babu/hengshan"))
    return notify_fail("你未领悟龙女留在恒山的精髓。\n");
  if (!me->query("jm_babu/songshan"))
    return notify_fail("你未领悟龙女留在嵩山的精髓。\n");
  if (!me->query("jm_babu/henshan"))
    return notify_fail("你未领悟龙女留在衡山的精髓。\n");

  ap = me->query("per", 1) + me->query("kar", 1);
  message_vision("$N水帘洞中，一梦千年，千年舞剑，梦幻泡影：" + poem[random(sizeof(poem))] + "\n", me);
  me->improve_skill("sword", 50 + random(10));
  me->add("jingli", -100);
  me->add("neili", -100);
  me->start_busy(1);

  if (random(100000) < ap) {
    me->set_skill("babulongnv-jian", 201);
    me->set("jm/babu", 1);
    me->delete("jm_babu");
    tell_object(me, HIR "恭喜你领悟了八部龙女剑！\n" NOR);
    message(
      "channel:chat",
      HIR "【天降奇才】" HIR + "听说" + me->query("name") + "天纵奇才，历经千辛万苦，在名山大川发现了龙女的足迹，最终在衡山水帘洞中领悟到八部龙女剑！\n" NOR,
      users()
    );
  }
  return 1;
}
