inherit ITEM;

void create() {
  set_name("广陵散", ({ "guang ling san", "guangling san", "qinpu" }));
  set("long", "这是据说已经失传了的广陵止息琴谱，对于爱琴之人，算是无价之宝了。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("no_get", "那是无价之宝，对方连睡觉都揣在怀里的！\n");
    set("no_drop", "这可是无价之宝，你这么老大一个人，居然如此不识货？！\n");
    set("value", 1000000);
    set_weight(20);
    //		set("treasure", 1);
  }
  setup();
}
