// lu.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("鲁连荣", ({ "lu lianrong", "lu", "lianrong" }));
  set("nickname", HIY "金眼雕" NOR);
  set("gender", "男性");
  set("class", "swordsman");
  set("age", 45);
  set("attitude", "peaceful");
  set("per", 13);
  set("str", 26);
  set("con", 30);
  set("dex", 30);
  set("int", 28);

  set("neili", 1400);
  set("max_neili", 1400);
  set("wuyongjiali", 30);
  set("max_qi", 1500);
  set("max_jing", 800);
  set("combat_exp", 600000);
  set("shen_type", 1);

  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("luoyan-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lingxu-bu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhenyue-jue", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "zhenyue-jue");
  map_skill("sword", "luoyan-jian");
  map_skill("parry", "luoyan-jian");
  map_skill("dodge", "lingxu-bu");

  create_family("衡山派", 15, "弟子");
  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}


void attempt_apprentice(object ob) {

  if ((int)ob->query("shen") < 10000) {
    command("say 我衡山派向来行侠仗义，您请回吧！");
    return;
  }

  command("nod");
  command("say " + RANK_D->query_respect(ob) + "资质不错，望你能将我衡山派发扬光大！\n");
  command("recruit " + ob->query("id"));
  return;
}
