// liujing.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name("刘菁", ({ "liu jing", "jing" }) );
        set("gender", "女性");
        set("class", "swordsman");
        set("long", "她是刘正风的女儿。\n");
        set("age", 17);
        set("attitude", "peaceful");
        set("per", 29);
        set("str", 26);
        set("con", 30);
        set("dex", 30);
        set("int", 28);

        set("neili", 500);
        set("max_neili", 500);
        set("wuyongjiali", 10);
        set("max_qi",700);
        set("max_jing",200);
        set("combat_exp", 100000);
        set("shen_type", 1);

        set_skill("unarmed", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("luoyan-jian", 500+jibie/3+random(jibie/5));
        set_skill("lingxu-bu", 500+jibie/3+random(jibie/5));
		set_skill("zhenyue-jue", 500+jibie/3+random(jibie/5));
		map_skill("force", "zhenyue-jue");
        map_skill("sword", "luoyan-jian");
        map_skill("parry", "luoyan-jian");
        map_skill("dodge", "lingxu-bu");

        create_family("衡山派", 15, "弟子");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/female1-cloth")->wear();
}

