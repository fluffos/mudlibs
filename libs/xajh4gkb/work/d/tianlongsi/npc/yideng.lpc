//yideng.c
inherit NPC;
inherit F_MASTER;
int checking(object me, object ob);
void create() {
  int jibie;
  jibie = 8000;
  //	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
  set_name("一灯", ({ "yideng dashi", "yideng", "dashi" }));
  set("nickname", HIY "南帝" NOR);
  set("gender", "男性");
  set("age", 42);
  set("long",
    "他面目慈祥，两道长长的白眉从眼角垂了下来。\n"
    "眉间虽隐含愁苦，但却有一番雍容高华的神色。\n");
  set("attitude", "peaceful");
  set("per", 32);
  set("class", "bonze");
  set("str", 50);
  set("int", 50);
  set("con", 50);
  set("dex", 50);
  set("chat_chance", 1);
  set("chat_msg", ({
    "一灯大师低头沉思，悠然不语。\n",
  }));

  set("qi", 350000);
  set("max_qi", 350000);
  set("jing", 350000);
  set("max_jing", 350000);
  set("max_jingli", 3000);
  set("shen_type", 1);
  set("jingli", 3000);
  set("neili", 13500000);
  set("max_neili", 13500);
  set("wuyongjiali", 300);

  set("combat_exp", 510000000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));             // 基本内功
  set_skill("kumu-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tiannan-step", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yiyang-zhi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));           // 基本拳脚
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));             // 基本躲闪
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));             // 基本招架
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));             // 基本剑法
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));           // 读书识字
  set_skill("duanjia-sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));

  map_skill("force", "kumu-shengong");
  map_skill("unarmed", "yiyang-zhi");
  map_skill("dodge", "tiannan-step");
  map_skill("sword", "duanjia-sword");
  map_skill("parry", "yiyang-zhi");

  create_family("大理段家", 17, "老国王");

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}

//全真教解密-挑战天下五绝
int accept_fight(object ob) {
  object me = this_object();

  if (!ob->query_temp("jm_quanzhen2")) return 1;
  remove_call_out("checking");
  call_out("checking", 1, me, ob);
  if (ob->query_temp("jm_quanzhen2")) ob->set_temp("jm_fight", 1);
  return 1;
}
int checking(object me, object ob) {
  int my_max_qi, his_max_qi;
  my_max_qi = me->query("max_qi");
  his_max_qi = ob->query("max_qi");

  if (!present(ob, environment())) return 1;
  if (((int)ob->query("qi") * 100 / his_max_qi) < 50 && ob->query("family/master_id") == "wang chongyang" && ob->query_temp("jm_quanzhen2")) {
    message_vision("一灯大师微微一唱：阿弥陀佛。当年华山论剑，重阳真人风采照人，其弟子倒也得其三分真传。\n", ob);
    //		ob->delete_temp("jm_quanzhen2");
    ob->delete_temp("jm_fight");
    return 1;
  }
  if (((int)me->query("eff_qi") * 100 / my_max_qi) < 40 && ob->query("family/master_id") == "wang chongyang" && ob->query_temp("jm_quanzhen2")) {
    message_vision("一灯大师笑道：出家人慈悲为怀，这位" + RANK_D->query_respect(ob) + "应该跟重阳真人多学学为人处世之道。\n", ob);
    //		ob->delete_temp("jm_quanzhen2");
    ob->delete_temp("jm_fight");
    return 1;
  }
  if (((int)me->query("qi") * 100 / my_max_qi) <= 50 && ((int)me->query("eff_qi") * 100 / my_max_qi) >= 40 && ob->query("family/master_id") == "wang chongyang" && ob->query_temp("jm_quanzhen2")) {
    command("say 青出於蓝胜於蓝，不愧是重阳真人嫡传弟子！\n");
    message_vision("一灯大师唱道：阿弥陀佛，长江后浪推前浪，一代新人换旧人。\n", ob);
    //		ob->delete_temp("jm_quanzhen2");
    ob->delete_temp("jm_fight");
    ob->set_temp("jm_quanzhen_nandi", 1);
    return 1;
  }
  if (me->is_fighting()) {
    call_out("checking", 3, me, ob);
    return 1;
  }
  return 1;
}
