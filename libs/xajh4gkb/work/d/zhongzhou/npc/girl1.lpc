inherit NPC;

void create()
{
	int jibie;
	jibie = 50;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
        set_name("少女", ({ "shao nv", "nv" }) );
        set("gender", "女性" );
        set("age", 17);
        set("shen_type", 1);
        set("combat_exp", 10000);
        set("str", 20);
        set("dex", 20);
        set("con", 20);
        set("int", 20);
        set("attitude", "peaceful");

        setup();
        carry_object("/clone/cloth/cloth")->wear();
        add_money("silver", 2);
}

