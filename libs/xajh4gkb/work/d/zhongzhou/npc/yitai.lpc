inherit NPC;

void create()
{
	int jibie;
	jibie = 100;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
        set_name("姨太太", ({ "yi taitai", "yi", "taitai"}) );
        set("gender", "女性" );
        set("age", 22);
        set("shen_type", -1);
        set("long", "她是周松天的姨太太，打扮得非常的妖艳。\n");

        set("combat_exp", 100);
        set("attitude", "peaceful");
        set_skill("unarmed", 10);
        set_skill("parry", 10);
        set_skill("dodge", 10);

        setup();
        add_money("silver", 1);
        carry_object("clone/cloth/pink_cloth")->wear();
        
}
