// xtj
// by dubei

#include <ansi.h>
#include <room.h>

inherit ROOM;
int do_jump(string arg);
int do_hit(string arg);

void create() {
  set("short", "山洪中");
  set("long", @LONG
这里是山洪只中，水流激荡，山洪从头顶轰隆轰隆的冲过，功力
稍弱的人，难以支撑过一柱香的时分。
LONG
  );

  set("outdoors", "xiangyang");
  set("no_clean_up", 0);

  setup();

}
void init() {
  add_action("do_jump", "jump");
  add_action("do_hit", "hit");
  add_action("do_hit", "ji");
}

int do_jump(string arg) {
  object me = this_player();

  if (me->is_busy()) return notify_fail("你正忙着呢！\n");
  if (arg != "anshang" && arg != "shore")
    return notify_fail("你要往哪里跳？\n");
  me->move(__DIR__ "pubu");
  message_vision("$N忽然从山洪中跃了出来，足步虚幌的落在了岸边。\n", me);
  return 1;
}


int do_hit(string arg) {
  object me = this_player();
  object weapon;
  int pot;
  pot = me->query_int();
  weapon = me->query_temp("weapon");

  if (me->is_busy() || me->is_fighting())
    return notify_fail("你正忙着呢！\n");

  if (arg != "flood" && arg != "hongshui") {
    write("你想做什么？\n");
    return 1;
  }
  //	if (me->query("gender") != "男性")
  //		return notify_fail("你的体质不适合练习玄铁剑法。\n");	
  if (!weapon || weapon->query("skill_type") != "sword") {
    write("你对着山洪拳打脚踢了一阵，感到劲疲力尽。\n");
    return 1;
  }
  if (me->query_skill("xuantie-jianfa", 1) <= 100 && weapon->query("id") != "xuantie jian") {
    write("你不用玄铁剑怎能领悟玄铁剑法呢？\n");
    return 1;
  }
  if (me->query_skill(
    "xuantie-jianfa",
    1
  ) > 100 && me->query_skill("xuantie-jianfa", 1) <= 200 && weapon->query("id") != "changjian") {
    write("你想进一步提高玄铁剑法的修为，要换一把普通的长剑了。\n");
    return 1;
  }
  if (me->query_skill(
    "xuantie-jianfa",
    1
  ) > 200 && me->query_skill("xuantie-jianfa", 1) <= 300 && weapon->query("id") != "mu jian") {
    write("你想更深一步提高玄铁剑法的修为，只能使用最平常的木剑了。\n");
    return 1;
  }
  if (me->query_skill(
    "xuantie-jianfa",
    1
  ) > 300 && me->query_skill("dugu-jiujian", 1) <= 50 && weapon->query("id") != "ziwei ruanjian") {
    write("你想领悟独孤九剑的基础剑式，只能使用紫薇软剑。\n");
    return 1;
  }
  if (me->query_skill(
    "xuantie-jianfa",
    1
  ) > 300 && me->query_skill(
    "dugu-jiujian",
    1
  ) > 50 && me->query_skill(
    "dugu-jiujian",
    1
  ) <= 100 && weapon->query("id") != "xuantie zhongjian") {
    write("你想要进一步领悟独孤九剑的基础剑式，需要使用玄铁重剑。\n");
    return 1;
  }
  if (me->query_skill(
    "xuantie-jianfa",
    1
  ) > 300 && me->query_skill(
    "dugu-jiujian",
    1
  ) > 100 && me->query_skill("dugu-jiujian", 1) <= 150 && weapon->query("id") != "mu jian") {
    write("你想要更深一步领悟独孤九剑的基础剑式，恐怕只能使用木剑了。\n");
    return 1;
  }

  if (me->query("neili") < 1000) {
    write("你的内力不足，无法继续练下去。\n");
    return 1;
  }
  if (me->query("qi") < 1000) {
    write("你已经不行了，无法继续练下去。\n");
    return 1;
  }
  if (me->query("jing") < 1000) {
    write("你精力不足，无法继续练下去。\n");
    return 1;
  }
  if (me->query_skill("xuantie-jianfa", 1) <= 50) {
    me->improve_skill("xuantie-jianfa", pot / 10);
    if (me->query_skill(
      "force",
      1
    ) < me->query("xyzx_sys/level") * 2) me->improve_skill("force", pot / 6);
    message_vision("$N用" + weapon->name() + "奋力击打着山洪，手中的" + weapon->name() + "发出了轻微的声响。\n", me);
    write("你似乎对于玄铁剑法的用力之道有所领悟。");
    me->receive_damage("qi", 100);
    me->add("neili", -100);
    me->add("jing", -100);
    return 1;
  } else if (me->query_skill("xuantie-jianfa", 1) <= 100) {
    me->improve_skill("xuantie-jianfa", pot / 10);
    if (me->query_skill(
      "force",
      1
    ) < me->query("xyzx_sys/level") * 2) me->improve_skill("force", pot / 4);
    message_vision("$N用" + weapon->name() + "奋力击打着山洪，手中的" + weapon->name() + "发出了嗤嗤的声响。\n", me);
    write("你似乎对于玄铁剑法的运用之道有所领悟。");
    me->receive_damage("qi", 100);
    me->add("neili", -100);
    me->add("jing", -100);
    return 1;
  } else if (me->query_skill("xuantie-jianfa", 1) <= 150) {
    me->improve_skill("xuantie-jianfa", pot * 2 / 10);
    if (me->query_skill(
      "force",
      1
    ) < me->query("xyzx_sys/level") * 2) me->improve_skill("force", pot / 5);
    message_vision("$N用" + weapon->name() + "奋力击打着山洪，手中的" + weapon->name() + "发出了刷刷的声响。\n", me);
    write("你似乎对于玄铁剑法的搏击之道有所领悟。");
    me->receive_damage("qi", 200);
    me->add("neili", -200);
    me->add("jing", -200);
    return 1;
  } else if (me->query_skill("xuantie-jianfa", 1) <= 200) {
    me->improve_skill("xuantie-jianfa", pot * 2 / 10);
    message_vision("$N用" + weapon->name() + "奋力击打着山洪，手中的" + weapon->name() + "发出轰隆隆的巨声。\n", me);
    write("你似乎对于玄铁剑法的内劲运用有所领悟。");
    me->receive_damage("qi", 200);
    me->add("neili", -200);
    me->add("jing", -200);
    return 1;
  } else if (me->query_skill("xuantie-jianfa", 1) <= 250) {
    me->improve_skill("xuantie-jianfa", pot * 3 / 10);
    message_vision("$N用" + weapon->name() + "奋力击打着山洪，手中的" + weapon->name() + "发出轰刷刷的声响。\n", me);
    write("你似乎对于玄铁剑法的精髓有所领悟。");
    me->receive_damage("qi", 300);
    me->add("neili", -300);
    me->add("jing", -300);
    return 1;
  } else if (me->query_skill("xuantie-jianfa", 1) <= 300) {
    me->improve_skill("xuantie-jianfa", pot * 3 / 10);
    message_vision("$N用" + weapon->name() + "奋力击打着山洪，手中的" + weapon->name() + "发出轰嗤嗤的声响。\n", me);
    write("你似乎对于玄铁剑法的御剑之道有所领悟。");
    me->receive_damage("qi", 300);
    me->add("neili", -300);
    me->add("jing", -300);
    return 1;
  } else if (me->query_skill(
    "xuantie-jianfa",
    1
  ) > 300 && me->query_skill("dugu-jiujian", 1) <= 50) {
    if (!me->query_temp("dugu/ziwei")) {
      message_vision("你并未得到独孤前辈在剑冢留下的轻剑剑意。\n", me);
      return 1;
    }
    me->improve_skill("dugu-jiujian", pot / 10);
    message_vision("$N用" + weapon->name() + "奋力击打着山洪，手中的" + weapon->name() + "寂然无声。\n", me);
    message_vision(HIY "「凌厉刚猛，无坚不摧，弱冠前以之与河朔群雄争锋。」\n" NOR, me);
    write("你似乎对于独孤九剑的总诀式有所领悟。");
    me->receive_damage("qi", 400);
    me->add("neili", -400);
    me->add("jing", -400);
    return 1;
  } else if (me->query_skill(
    "xuantie-jianfa",
    1
  ) > 300 && me->query_skill("dugu-jiujian", 1) <= 100) {
    if (!me->query_temp("dugu/xuantie")) {
      message_vision("你并未得到独孤前辈在剑冢留下的重剑剑意。\n", me);
      return 1;
    }
    me->improve_skill("dugu-jiujian", pot / 10);
    message_vision("$N用" + weapon->name() + "奋力击打着山洪，手中的" + weapon->name() + "寂然无声。\n", me);
    message_vision(HIY "「重剑无锋，大巧不工。四十岁前恃之横行天下。」\n" NOR, me);
    write("你似乎对于独孤九剑的总诀式有所领悟。");
    me->receive_damage("qi", 500);
    me->add("neili", -500);
    me->add("jing", -500);
    return 1;
  } else if (me->query_skill(
    "xuantie-jianfa",
    1
  ) > 300 && me->query_skill("dugu-jiujian", 1) <= 150) {
    me->improve_skill("dugu-jiujian", pot / 10);
    message_vision("$N用" + weapon->name() + "奋力击打着山洪，手中的" + weapon->name() + "寂然无声。\n", me);
    message_vision(HIY "「四十岁後，不滞於物，草木竹石均可为剑。自此精修，渐进於无剑胜有剑之境。」\n" NOR, me);
    write("你似乎对于独孤九剑的总诀式有所领悟。");
    me->receive_damage("qi", 600);
    me->add("neili", -600);
    me->add("jing", -600);
    return 1;
  } else if (me->query_skill(
    "xuantie-jianfa",
    1
  ) > 300 && me->query_skill("dugu-jiujian", 1) > 150) {
    me->set("jm_dugu/dugu1", 1);
    message_vision("$N用" + weapon->name() + "奋力击打着山洪，手中的" + weapon->name() + "寂然无声。\n", me);
    write("你已经无法再在这里领悟独孤前辈留下的绝世剑法了！\n");
    if (me->query("jm_dugu/dugu1") && me->query("jm_dugu/dugu2")) {
      me->delete("jm_dugu");
      me->set("jm/dugu", 1);
      tell_object(me, HIB "恭喜你融汇贯通了独孤九剑的精髓！\n" NOR);
      message(
        "channel:chat",
        HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，将独孤前辈的独孤九剑融会贯通！\n" NOR,
        users()
      );
    }
    return 1;
  }

}
