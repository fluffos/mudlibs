//袁承志
#include <ansi.h>
inherit NPC;

void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name(HIY "袁承志" NOR, ({ "yuan chengzhi", "yuan", "chengzhi" }));
  set("gender", "男性");
  set("shen_type", 1);
  set("qi", 1000000);
  set("eff_qi", 1000000);
  set("max_qi", 1000000);
  set("jing", 1000000);
  set("eff_jing", 1000000);
  set("combat_exp", 100000000);
  set_skill("literate", 500 + jibie * 2 + random(jibie / 5));
  set_skill("sword", 500 + jibie * 2 + random(jibie / 5));
  set_skill("force", 500 + jibie * 2 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie * 2 + random(jibie / 5));
  set_skill("dodge", 500 + jibie * 2 + random(jibie / 5));
  set_skill("parry", 500 + jibie * 2 + random(jibie / 5));
  set_skill("huashan-shenfa", 500 + jibie / 2 + random(jibie / 5));
  set_skill("huashan-jianfa", 500 + jibie / 2 + random(jibie / 5));
  set_skill("zixia-shengong", 500 + jibie / 2 + random(jibie / 5));
  set_skill("jinshe-zhang", 500 + jibie / 2 + random(jibie / 5));
  set_skill("jinshe-jian", 500 + jibie / 2 + random(jibie / 5));
  set_skill("hunyuan-zhang", 500 + jibie / 2 + random(jibie / 5));
  map_skill("force", "zixia-shengong");
  map_skill("dodge", "huashan-shenfa");
  map_skill("parry", "jinshe-zhang");
  map_skill("unarmed", "hunyuan-zhang");
  map_skill("sword", "jinshe-jian");

  setup();
  carry_object("//clone/cloth/long_cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
  add_money("gold", 10);
}


void die() {
  object me, obj;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "胡苗世家") {
    tell_room(environment(this_player()), "袁承志临说道：昔日闯王起事后，本意为民请命，可后来烧杀掠夺更甚于腐朽皇朝！！！\n");
    tell_room(environment(this_player()), "袁承志骂道：闯王手下也就那胡苗护卫还懂得事例，可叹其后人不分好歹！！！\n");
    tell_room(environment(this_player()), "袁承志惨嚎一声，倒在地上，抽搐了几下，两腿一蹬，死了.....．\n");
    me->set_temp("jm_humiao1", 1);
  }
  if (me && (string)me->query("family/family_name") == "五毒教" && me->query_temp("jm_wudu3")) {
    obj = new("d/sdxl/obj/rentou");
    obj->set("owner", me->query("id"));  //设定识别
    obj->move(environment(this_object()));
    obj->set("long", "袁崇焕的后人，一副忠厚老实的样子，只是，目前已经没有了头颅。\n");
    tell_room(environment(this_player()), "袁承志惨嚎一声，倒在地上，头颅已然不见了．\n");
  }
  ::die();
}
