//天蚕宝甲-名器
#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIY "天蚕宝甲" NOR, ({ "tiancan baojia", "baojia", "jia" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一件用天蚕丝制成的宝甲\n");
    set("icon", "10090");
    set("material", "cloth");
    set("unit", "件");
    set("value", 5000000);
    set("armor_prop/dodge", 10);
    set("armor_prop/dexerity", 10);
    set("armor_prop/constitution", 10);
    set("armor_prop/armor", 600);
  }
  setup();
}
int query_autoload() { return 1; }
