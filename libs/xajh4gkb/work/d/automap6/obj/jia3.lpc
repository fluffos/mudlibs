//千年火龙甲-神器
#include <armor.h>
#include <ansi.h>

inherit ARMOR;

void create()
{
	set_name(HIR"千年火龙甲"NOR, ({ "qiannian huolong jia","huolong jia", "jia" }));
	set_weight(2000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是一件千年火龙腹部的软鳞制成的宝甲。\n");
		set("material", "copper");
		set("unit", "件");
		set("icon", "10092");
        set("value",15000000);
		set("wear_msg", HIR "$N披上一件千年火龙甲，周身环绕着淡淡的红光。\n" NOR);
		set("remove_msg", HIR "$N将千年火龙甲卸下，小心翼翼的收在怀里。\n" NOR);
		set("no_get",1);
		set("no_give",1);
		set("no_drop",1);			
		set("no_put", 1);	                         	
		set("armor_prop/armor", 1200);	
		set("armor_prop/force", 20);	
		set("armor_prop/unarmed", 20);	
		set("armor_prop/sword", 10);	
		set("armor_prop/blade", 20);	
		set("armor_prop/parry", 10);	
		set("armor_prop/constitution", 10);
	
	}
	setup();
}
int query_autoload() { return 1; }	
//void owner_is_killed() {destruct(this_object());} 

int move(mixed dest)
{
	if(! userp(dest)) return ::move(dest);
	if( ::move(dest)==0) return 0;
	if (dest->query_temp("god_armor")!=this_object()->query("id"))
	{
		message("rumor",HIR"【江湖传奇】"+ HIG"据说火龙王耗毕生真元凝聚而成的神器"+ this_object()->query("name")+HIG"被"+ dest->query("name")+"("+dest->query("id")+")拿到手了！\n"NOR,users());
		dest->set_temp("god_armor",this_object()->query("id"));
	}
	return 1;
}
//2017.4.15阿飞改,神器附加特殊效果
int ob_hit(object ob, object me, int damage)
{	
	int j,damage1;
	damage1 = this_object()->query("armor_prop/armor")*5;
	if( random(5)==1 )
	{	
		me->add("eff_qi",damage1);
		if (me->query("eff_qi")>me->query("max_qi")) me->set("eff_qi",me->query("max_qi"));
		me->add("qi",damage1);
		if (me->query("qi")>me->query("eff_qi")) me->set("qi",me->query("eff_qi"));
		message_vision(HIM"$N内力流转，"+ this_object()->query("name")+HIM"中的龙气注入体内，伤势顿时好转！\n"NOR, me, ob);
		j = -(damage/3+random(damage/3));
		return j;
	} 			      
}

int wear()
{
	if(!userp(this_player())) return ::wear();
//	if ( !wizardp(this_player()) && userp(this_player()))
//		return notify_fail(HIW"神器蒙尘，暂时不是你能使用的，等待巫师调整。\n"NOR);
	if ( stringp(this_player()->query_temp("wear_god_armor")) && (string)this_player()->query_temp("wear_god_armor")!= this_object()->query("id") )
		return notify_fail(HIW"神器傲娇，岂能与其他神器共事一主。\n"NOR);		
	if (::wear())
	{
		if (userp(this_player())) this_player()->set_temp("wear_god_armor",this_object()->query("id"));
		return 1;
	}
	return 0;
}