void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie * 9 / 10 + random(jibie * 2 / 10));  //2016.5.22阿飞调整NPC属性
  set_name(HIR "千年火龙王" NOR, ({ "huolong wang", "long", "dragon" }));
  set("race", "野兽");
  set("long", "一条巨大的龙，嘴里喷着火，看到了你，向你扑了过来。它充斥着这整个洞穴，你顿觉空气的压抑，觉得它十分地可怕。\n");
  set("attitude", "aggressive");
  set("vendetta/authority", 1);
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set("max_fashufali", 100000);
  set("fashufali", 100000);
  set("no_get", 1);
  set("no_suck", 1);
  set("age", 999);
  set("shen_type", 0);
  set("intellgent", 1);
  set("pursuer", 1);
  //	set("end_boss", 1);
  set("env/wimpy", 40);
  set("shen_type", 0);

  set_skill("dodge", 500 + jibie * 2 + random(jibie / 5));
  set_skill("force", 500 + jibie * 2 + random(jibie / 5));
  set_skill("parry", 500 + jibie * 2 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie * 2 + random(jibie / 5));
  set_skill("spells", 500 + jibie * 2 + random(jibie / 5));
  set_skill("dragon", 500 + jibie / 2 + random(jibie / 5));
  set_skill("taixuan-gong", 500 + jibie / 2 + random(jibie / 5));
  map_skill("unarmed", "dragon");
  map_skill("dodge", "dragon");
  map_skill("parry", "dragon");
  map_skill("force", "taixuan-gong");
  /*	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		(: perform_action, "unarmed.penhuo" :),
		(: perform_action, "unarmed.tuwu" :),
		(: perform_action, "unarmed.yaoyao" :),
		}) );
*/
  setup();
  carry_object("/d/automap6/obj/longdan4");
}

void init() {
  object ob, me;

  me = this_object();
  ob = this_player();

  ::init();

  // 怪物必须是可以动作的，并只针对玩家
  if (!objectp(ob) || !living(me) || !playerp(ob)) return;
  // 见面就打
  me->kill_ob(ob);
  // 拦路
  add_action("do_go", "go");
  // 跟随
  //	command("follow "+ob->query("id"));

}

void die() {
  object ob, me, corpse, baoshi, env;
  string room;
  int m, k1, k2, k3, k4;
  int flag, xingyun;
  flag = 1;
  xingyun = 0;
  ob = this_object();

  // 先绑定到打晕的对象上
  if (!objectp(me = ob->query_temp("last_unconcious_from")))
    me = ob->query_temp("last_damage_from");  // 绑定到最后伤害对象
    if (!objectp(me)  // 未成功绑定
    || !objectp(env = environment(ob))
      || !stringp(room = env->query("short"))) {
      ::die();
      return;
    }

  if (me) {
    m = 5000000 + random(5000000);

    if (interactive(me)) {
      message_vision(
        HIG "\n你杀死了 " + ob->name(1) + HIG " ，奖励了 " HIY + (me->query_exp_times() * m) + HIG " 点经验和 " HIY + (m / 10) + HIG " 潜能。\n" NOR,
        me
      );
      message(
        "party",
        HIW "【" + room + "】" + HIG + me->name(1) + HIM " 杀死了 " + ob->name(1) + HIM " ，奖励了 " HIC + (m * me->query_exp_times()) + HIM " 点经验和 " HIY + (m / 10) + HIM " 潜能。\n" NOR,
        users()
      );
      me->add("combat_exp", m);
      me->add("potential", m / 10);
      if (me->query("xyhy_type") == 2) flag = 5 / 4;
      if (me->query_temp("wupin_max_add")) xingyun = (int)me->query_temp("wupin_max_add", 1);  //处于幸运状态时
    }
  }

  if (objectp(corpse = CHAR_D->make_corpse(ob, me)))
    corpse->move(environment(ob));

  k1 = 60 * flag;
  k2 = 450 * flag;
  k3 = 10 * flag;
  k4 = 5 * flag;

  if (objectp(me) && objectp(ob) && random(100) < k1 * (100 + xingyun) / 100) {
    baoshi = new("/clone/gem/gem2");
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id	
    if (baoshi->query("level") >= 7) message(
      "party",
      HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " + baoshi->name(1) + HIM "。\n" NOR,
      users()
    );
    baoshi->move(corpse);
  }
  if (objectp(me) && objectp(ob) && random(20000) < k2 * (100 + xingyun) / 100) {
    baoshi = new(random_item1[random(sizeof(random_item1))]);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id		
    message(
      "party",
      HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " HIM + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      users()
    );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }
  if (objectp(me) && objectp(ob) && random(100) < k3 * (100 + xingyun) / 100) {
    baoshi = new("/clone/item/zuiyue-xuanjing");
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id	
    message(
      "rumor",
      HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " + baoshi->name(1) + HIM "。\n" NOR,
      users()
    );
    baoshi->move(corpse);
  }
  if (objectp(me) && objectp(ob) && random(100) < k4 * (100 + xingyun) / 100) {
    switch (random(3)) {
      case 0: baoshi = new("/clone/gem/robe");
      break;
      case 1: baoshi = new("/clone/gem/ring" + random(10));
      break;
      case 2: baoshi = new("/d/automap6/obj/jia" + (1 + random(3)));
      break;
    }
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id	
    message(
      "party",
      HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " + baoshi->name(1) + HIM "。\n" NOR,
      users()
    );
    baoshi->move(corpse);
  }


  COMBAT_D->announce(ob, "dead");
  destruct(ob);
  return;
}


int do_go(string arg) {
  object me, ob, *killer;

  me = this_object();
  ob = this_player();

  if (!objectp(ob)) return 0;

  killer = ob->query_enemy();

  if (playerp(ob) && arrayp(killer) && sizeof(killer) > 3 && random(10) <= 5) {
    message_vision(YEL "$N见势不好，转身要走，被$n" + YEL + "一把拦在面前。背后拉我一票兄弟还想走？没那么容易！\n" NOR, ob, me);
    if (!ob->is_busy()) ob->start_busy(1);
    return 1;
  }

  return 0;
}
