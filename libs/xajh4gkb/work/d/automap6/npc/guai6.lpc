  "/quest/baoshi/baoshis/chengyu",
  "/quest/baoshi/baoshis/shuijing",
  "/quest/baoshi/baoshis/jinsha",
  "/quest/baoshi/baoshis/maoyan",
  "/quest/baoshi/baoshis/zuanshi",
  "/quest/baoshi/baoshis/god manao",
  "/quest/baoshi/baoshis/god feicui",
  "/quest/baoshi/baoshis/god chengyu",
  "/quest/baoshi/baoshis/god shuijing",
  "/quest/baoshi/baoshis/god jinsha",
  "/quest/baoshi/baoshis/god maoyan",
