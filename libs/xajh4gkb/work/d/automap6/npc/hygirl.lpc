inherit NPC;
#include <ansi.h>
inherit F_MASTER;
inherit F_DEALER;
inherit F_UNIQUE;
void greeting(object ob);
void create()
{
	int jibie;
	jibie = 5000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name(HIY"海洋天骄"NOR, ({"haiyang girl", "hygirl","girl"}));
	set("title", HIW"龙女"NOR);
	set("gender", "女性");
	set("age", 16);
	set("long",HIG "这是天神大人的侍女，十分乖巧，讨人喜爱。\n"NOR);
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("per", 30);
	set("qi", 50000);
	set("max_qi", 50000);
	set("jing", 30000);
	set("max_jing", 30000);
	set("neili", 90000);
	set("max_neili", 90000);
	set("wuyongjiali", 300);
	set("combat_exp", 10000000);
	set("score", 1000000);
	set_skill("force", 2000+jibie/3+random(jibie/5));
	set_skill("unarmed", 2000+jibie/3+random(jibie/5));	
	set_skill("dodge", 2000+jibie/3+random(jibie/5));	
	set_skill("parry", 2000+jibie/3+random(jibie/5));
	set_skill("sword", 2000+jibie/3+random(jibie/5));	
	set_skill("literate", 2000+jibie/3+random(jibie/5));	
	set_skill("yunshang-xinjing", 1000+jibie/3+random(jibie/5));
	set_skill("taixuan-gong", 1000+jibie/3+random(jibie/5));
	set_skill("qiankundanuoyi", 1000+jibie/3+random(jibie/5));
	set_skill("ai-sword", 1000+jibie/3+random(jibie/5));
	map_skill("force"  , "yunshang-xinjing");
	map_skill("unarmed", "taixuan-gong");
	map_skill("dodge"  , "qiankundanuoyi");
	map_skill("sword"  , "ai-sword") ;
	map_skill("parry"  , "qiankundanuoyi");

	create_family("天神", 2, "侍女");
	set("inquiry", ([       
		"天神" : "天神是我的主人!有关主人的事可以问我。 ",
		"主人" : "主人大概还在睡觉，有事找他可以post。",
	]) );  

	set("vendor_goods", ({
		"clone/drug/zhujingchan",		
//		"clone/gift/shenliwan",               	
//		"clone/gift/xiandan",                 	
//		"clone/gift/xisuidan",                 	
//		"clone/gift/jiejue",                 	
//		"clone/gift/xianhai",                 	
//		"clone/gift/xianxing",                 	
//		"clone/drug/yydan",                 	
//		"clone/gift/unknowdan", 
	}));

	setup();
	carry_object("/d/tiezhang/obj/ycj.lpc")->wield();
	carry_object("/d/wudie/obj/dieyi")->wear();
}
void init()
{
	object ob;
	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) 
	{
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_list", "list");
	add_action("do_buy", "buy");
}
void greeting(object ob)
{
	if (!ob || environment(ob) != environment()) return;
	if ((string)ob->query("id") == "afei")
	{
		command("jump cash");
		message_vision(HIM "\n海洋天骄高兴的说道：“主人您来拉。” \n"NOR, ob);
	}
	else
	{
		command("wanfu "+(string)ob->query("id"));
		message_vision(HIY"\n海洋天骄甜甜的说道：“"+RANK_D->query_respect(ob)+"欢迎光临本店。” \n"NOR, ob);
	}
}
void attempt_apprentice(object ob)
{
	command("say 想拜师？还是去问我主人天神吧！");
}


