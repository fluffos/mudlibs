//白虹剑-名器
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIW "白虹剑" NOR, ({ "baihong jian", "sword", "jian" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("treasure", 1);
    set("unit", "柄");
    set("icon", "10024");
    set("long", "这是一口削铁如泥的宝剑,是凌霄城镇派之宝。\n");
    set("value", 1000000);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄寒光闪闪的$n握在手中,刹时寒气四射。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
    set("weapon_prop/constitution", 10);
    set("weapon_prop/sword", 30);
    set("weapon_prop/dodge", 10);
    set("weapon_prop/force", 10);
    set("weapon_prop/personality", 10);
  }
  init_sword(450, 2);
  setup();
}
int query_autoload() { return 1; }
