//玄铁令-名器
#include <armor.h>
#include <ansi.h>
inherit NECK;

void create() {
  set_name(HIC "玄铁令" NOR, ({ "xuan tie", "xuan" }));
  set("long", "\n这是一块碧绿色的玉牌，莹洁光绿，真是一块好玉。\n" +
    "正面雕龙刻凤，正中写着玄铁两个大字。这便是江湖上传说的玄铁令。\n");
  set("weight", 300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("value", 15000000);
    set("material", "玉");
    //		set("female_only", 1);	//这代码表示女人专用
    set("armor_prop/karma", 10);
    set("armor_prop/constitution", 10);
    set("armor_prop/dodge", 10);
    set("armor_prop/armor", 800);
  }
  setup();
}
int query_autoload() { return 1; }

