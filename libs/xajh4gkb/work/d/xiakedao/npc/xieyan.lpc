///xieyan.c 谢烟客

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("谢烟客", ({ "xie yanke", "xie", "yanke" }));
  set("long", "他就是摩天崖的主人。看年纪大约五十多岁，\n"
    + "年轻时好武成兴，无比骄傲，自认为天下第一。\n");
  set("gender", "男性");
  set("age", 50);
  set("shen_type", 1);
  set("str", 300);
  set("int", 29);
  set("con", 30);
  set("dex", 280);

  set("qi", 100000);
  set("max_qi", 100000);
  set("jing", 10000);
  set("max_jing", 10000);
  set("neili", 550000);
  set("max_neili", 15000);
  set("wuyongjiali", 500);

  set("combat_exp", 150000000);
  set("score", 200000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("staff", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hamagong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("chanchu-bufa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lingshe-zhangfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("biye-wu", 500 + jibie / 3 + random(jibie / 5));

  map_skill("force", "hamagong");
  map_skill("dodge", "chanchu-bufa");
  map_skill("unarmed", "biye-wu");
  map_skill("parry", "lingshe-zhangfa");
  map_skill("staff", "lingshe-zhangfa");



  setup();
  carry_object("/clone/cloth/king_cloth")->wear();
  //       carry_object("/clone/weapon/gangzhang")->wield();
  add_money("gold", 20);
}
