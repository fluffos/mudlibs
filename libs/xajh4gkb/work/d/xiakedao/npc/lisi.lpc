// lisi.c 李四

inherit NPC;

void create()
{
	int jibie;
	jibie = 2000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name("李四", ({ "liu si", "liu" }));
        set("nickname", "侠客岛赏善罚恶使者");
        set("title", "冷面阎罗");
        set("long",
                "他就是江湖传闻中赏善罚恶使者之一。\n"
                "他大约二十多岁，精明能干，总是阴沉着脸。但却嫉恶如仇，性如烈火?n");
        set("gender", "男性");
        set("age", 25);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 300);
        set("int", 35);
        set("con", 27);
        set("dex", 280);

        set("liquiry", ([
                 "腊八粥":"\n去找龙岛主看看你的缘分吧。\n",
                 "石破天":"\n他是我的结拜兄弟呀，他也在这呢。\n",
                 "赏善罚恶令":"\n这是我们兄弟的信物。\n",
        ]) );

        set("max_qi", 200000);
        set("qi", 200000);
        set("max_jing", 20000);
        set("jing", 20000);
        set("neili", 300000);
        set("max_neili", 3000);
        set("wuyongjiali", 1000);
        set("combat_exp", 300000000);
        set("score", 60000);

        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("taiji-shengong", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("tiyunzong", 500+jibie/3+random(jibie/5));
        set_skill("unarmed", 500+jibie/3+random(jibie/5));
        set_skill("taiji-quan", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("taiji-jian", 500+jibie/3+random(jibie/5));
        set_skill("taoism", 500+jibie/3+random(jibie/5));
        set_skill("literate", 500+jibie/3+random(jibie/5));

        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-quan");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "taiji-jian");

        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/wudang/obj/whiterobe")->wear();
}

