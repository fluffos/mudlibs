// yangbuhui.c 

inherit NPC;

void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("小昭", ({ "xiao zhao", "xiaozhao"}));
	set("long", "她梳着两条羊角辫，容颜俏丽，神情天真无邪，她就是紫衫龙王黛绮丝和银叶先生韩千叶之女。\n");
	set("gender", "女性");
	set("age",15);
	set("attitude", "friendly");
	set("shen_type", 0);
	set("str", 25);
	set("int", 24);
	set("con", 28);
	set("dex", 26);
	set("per", 24);
	set("max_qi", 600);
	set("max_jing", 100);
	set("neili", 300);
	set("max_neili", 300);
	set("wuyongjiali", 30);
	set("combat_exp", 30000);
	set("shen",1000);
	set("score", 1000);
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("shenghuo-shengong", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("qingyunwu", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("shenghuo-quan", 500+jibie/3+random(jibie/5));
	set_skill("liehuo-jian", 500+jibie/3+random(jibie/5));
	map_skill("force", "shenghuo-shengong");
	map_skill("dodge", "qingyunwu");
	map_skill("sword", "liehuo-jian");
	map_skill("unarmed", "shenghuo-quan");
	map_skill("parry", "liehuo-jian");
	create_family("明教", 40, "弟子");
	setup();
	carry_object("/clone/cloth/cloth")->wear();
	carry_object("/clone/weapon/changjian")->wield();
}

void attempt_apprentice(object ob)
{
	command("say 就我这点功夫哪敢指导你，"+RANK_D->query_respect(ob)+ "还是去找我教其他高手吧。");
 }

