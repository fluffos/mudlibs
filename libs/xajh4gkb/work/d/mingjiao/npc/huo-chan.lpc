// huo-chan.c

#include <ansi.h>
inherit NPC;

void create()
{
	int jibie = 2000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name(RED"千年火蟾"NOR, ({ "huo chan", "chan" }) );
        set("race", "野兽");
        set("age", 100);
        set("long", "一只昂首挺胸，通体纯红，喷着火苗，“昂昂”直叫的蟾蜍。\n");
        set("attitude", "aggressive");
        
        set("str", 30);
        set("cor", 30);
    set_skill("force", 500+jibie*2+random(jibie/5));
    set_skill("dodge", 500+jibie*2+random(jibie/5));
    set_skill("unarmed", 500+jibie*2+random(jibie/5));
    set_skill("parry", 500+jibie*2+random(jibie/5));
    set_skill("hamagong",500+jibie/2+random(jibie/5));
    set_skill("chanchu-bufa", 500+jibie/2+random(jibie/5));
    set_skill("shexing-diaoshou", 500+jibie/2+random(jibie/5));
    map_skill("force", "hamagong");
    map_skill("dodge", "chanchu-bufa");
    map_skill("parry", "shexing-diaoshou");
    map_skill("unarmed", "shexing-diaoshou");
        set("limbs", ({ "头部", "身体", "前脚", "后脚" }) );
        set("verbs", ({ "bite", "claw" }) );

        set("age", 50);
       
        set("chat_msg_combat", ({
                (: this_object(), "random_move" :),
                "火蟾昂昂直叫：昂！昂！昂！昂！昂！昂！\n",
                "火蟾突然口吐大火，到处乱喷。\n"
        }) );
                
        set_temp("apply/attack", 45);
        set_temp("apply/damage", 30);
       set_temp("apply/armor", 5);

        setup();
}

void init()
{
        object ob;
        ::init();
        if (interactive(ob = this_player()) &&
                random(ob->query_kar() + ob->query_per()) < 30) {
                        remove_call_out("kill_ob");
                        call_out("kill_ob", 1, ob); 
        }       
}
void die()
{
        object ob;
        message_vision("$N昂一声，毙命了！\n", this_object());
          ob = new("/d/mingjiao/npc/obj/si-huochan.lpc");
        ob->move(environment(this_object()));
        destruct(this_object());
}

