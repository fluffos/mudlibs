void die() {
  object ob, me;
  me = query_temp("last_damage_from");
  if (me && me->query("family/master_id") == "mie jue" && me->query_temp("jm_emei2")) {
    ob = new("/d/mingjiao/obj/rentou2");
    ob->set("owner", me->query("id"));  //设定识别
    ob->move(environment(this_object()));
    ob->set("long", "明教教主，看起来英俊不凡，只是，目前已经没有了头颅。\n");
    tell_room(environment(this_player()), "张无忌神色安详，倒在地上，头颅已然不见了．\n");
  }
  ::die();
}
