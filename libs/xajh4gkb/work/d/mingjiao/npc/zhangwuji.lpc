// zhangwuji.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_ling();
int ask_shenghuo();
void create() {
  int jibie;
  jibie = 7000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("张无忌", ({ "zhang wuji", "zhang", "wuji" }));
  set("title", HIR "明教教主" NOR);
  set("long",
    "他，眼睛特别明亮！他，面容特别英俊！\n"
    "他满身充满了男性的阳刚之气！他就是明教的34代教主--张无忌。\n");
  set("gender", "男性");
  set("age", 25);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  /*   set("qi", 330050);
    set("max_qi", 330050);
    set("jing", 30050);
    set("max_jing", 30050);
    set("neili", 5000000);
    set("max_neili", 1000000);
    set("wuyongjiali", 22200);
    set("score", 455000);*/
  set("combat_exp", 129000000);
  set_skill("taiji-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qiankundanuoyi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shenghuo-ling", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shenghuo-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tiyunzong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jiuyang-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qishang-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taoism", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taiji-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qingyunwu", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "jiuyang-shengong");
  map_skill("unarmed", "qishang-quan");
  map_skill("parry", "qiankundanuoyi");
  map_skill("sword", "shenghuo-ling");
  map_skill("dodge", "qingyunwu");


  create_family("明教", 34, "弟子");

  set("inquiry", ([
    "姓名": "在下乃是这明教的34代帮主，张无忌。\n",
    "谢逊": "此乃在下的义父，你如能替我找到他，我定重重谢你! \n",
    "秘籍": "我本来最近写了一本九阳真气入门篇,却不知被我的书童弄哪儿去了.\n",
    "圣火令": (: ask_ling :),
    "圣火": (: ask_shenghuo :),
  ]));

  set("no_get", 1);
  set("book_count", 1);
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  set("chat_chance", 1);
  set("chat_msg", ({
    "张无忌仰天叹道：不知我那可怜的义父现在何处！！\n",
    "张无忌道：唉！赵敏！唉！芷若！\n",
  }));

}
int ask_ling() {
  object me;
  me = this_player();

  if ((string)me->query("family/family_name") == "明教" && me->query_temp("jm_mingjiao3")) {
    message_vision(HIB "张无忌说道：" + RANK_D->query_respect(me) + "解我明教危难，实乃我教大喜。\n" NOR, me);
    message_vision(HIB "张无忌说道：听闻波斯明教总坛来人寻找我教乾坤大挪移心法！可如今我教早已脱离波斯明教多年，可真让人为难啊” \n" NOR, me);
    me->set_temp("jm_mingjiao4", 1);
  } else {
    message_vision(YEL "张无忌说道：圣火令乃本教圣物。\n", me);
    return 1;
  }

  return 1;
}
int ask_shenghuo() {
  object me;
  me = this_player();

  if ((string)me->query("family/family_name") == "明教" && me->query_temp("jm_mingjiao6")) {
    message_vision(HIB "张无忌说道：" + RANK_D->query_respect(me) + "果然英雄了得，竟然能杀了蒙古大汗。\n" NOR, me);
    message_vision(HIB "张无忌说道：相传明教第三十代教主〖风舞柳影〗阿娜(Doll)为解明教之难，舍身在明教玄天石，或许你可以在哪里参悟明教教义。” \n" NOR, me);
    me->set_temp("jm_mingjiao7", 1);
  } else {
    message_vision(YEL "张无忌说道：焚我残躯，熊熊圣火，生亦何欢，死亦何苦。\n", me);
    return 1;
  }

  return 1;
}
void attempt_apprentice(object ob) {
  if ((int)ob->query("str", 1) < 30) {
    command("say 你的臂力太低了，不适合学习我的功夫。");
    return;
  }
  if ((int)ob->query("con", 1) < 30) {
    command("say 你的根骨太低了，不适合学习我的功夫。");
    return;
  }
  if ((int)ob->query("shen") < 1000000) {
    command("shake");
    command("say 你目露凶光，满脸阴鸷之气，非吾中意之人，你还是回去吧！");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，扛不起明教的大旗。");
    command("say 是否应该去江湖中多加磨炼。");
    return;
  }
  if ((int)ob->query_skill("force", 1) < 1000) {
    command("shake");
    command("say 我的九阳真气乃是以深厚的基本内功为基础的！");
    command("say 你的基本功还未练好，现在我没什么可以教你的！");
    command("sigh");
    return;
  }

  if ((int)ob->query_skill("shenghuo-shengong", 1) < 1000) {
    command("shake");
    command("say 我教武功博大精深！");
    command("say 你的入门内功功还未练好，现在我没什么可以教你的！");
    return;
  }
  if ((int)ob->query("max_neili", 1) < 100000) {
    command("shake");
    command("say 九阳真气是需要深厚的内力！");
    command("say 你的内力不足，现在我没什么可以教你的！");
    return;
  }
  if ((int)ob->query_skill("parry", 1) < 1000) {
    command("shake");
    command("say 我的武功神奇无比，你的招架不够！");
    command("say 你的基本功还未练好，现在我没什么可以教你的！");
    return;
  }
  if ((int)ob->query("score") < 50000) {
    command("say 你对本门的贡献还不够,还得努力呀！");
    return;
  }

  if (this_player()->query_temp("marks/义父")) {
    command("say 好吧，我就收下你了。");
    //		command("recruit " + ob->query("id"));
    //		ob->set("title","明教张教主得力弟子");
    this_player()->delete_temp("marks/义父");
    command("say 哈哈！ 我明教又得一良材，望你日后康扶正义，把我明教发扬光大。");
    command("recruit " + ob->query("id"));
    if ((string)ob->query("class") != "shizhe") ob->set("class", "shizhe");
    ob->set("title", HIW "明教教主嫡传弟子" NOR);
  } else {
    command("say 我平生只有一个义父能够孝敬，你能帮我探知他的下落吗。");
  }
  return;
}

int accept_object(object me, object ob) {
  if ((string)ob->query("id") == "jin mao") {
    tell_object(me, GRN "张无忌激动地说道：你找到我的义父了。\n" NOR);
    if (!me->query_temp("marks/义父")) me->set_temp("marks/义父", 1);
    remove_call_out("destrory");
    call_out("destrory", 1, ob);
    return 1;
  }

  if ((string)ob->query("id") == "yi xin") {
    if ((string)me->query("family/family_name") == "明教" && me->query("id") == ob->query("owner") && me->query_temp("jm_mingjiao1")) {
      message_vision(HIC "你将阳教主遗信交给了张无忌，说道：阳教主已于二十年前受成昆所害！\n", me);
      message_vision(HIC "张无忌说道：这位" + RANK_D->query_respect(me) + "为我教探得阳教主消息，我教上下均十分感激。\n", me);
      message_vision(
        HIC "张无忌说道：" + RANK_D->query_respect(me) + "为我教解开多年谜团，本欲指点你的修为，可如今六大派围攻光明顶！\n",
        me
      );
      message_vision(HIC "张无忌说道：若" + RANK_D->query_respect(me) + "能助我教击退六大派，可去我教总坛参悟圣火绝学。\n", me);
      me->set_temp("jm_mingjiao2", 1);
      return 1;
    } else {
      message_vision("张无忌疑惑的看着你说道：这恐怕是你伪造的吧？\n", me);
      return 1;
    }
  }

  if ((string)ob->query("id") == "shenghuo ling") {
    if ((string)me->query("family/family_name") == "明教" && me->query_temp("jm_mingjiao4")) {
      message_vision(HIC "你将圣火令交给了张无忌。\n", me);
      message_vision(HIC "张无忌说道：圣火令乃本教圣物，" + RANK_D->query_respect(me) + "又为我教立下大功。\n", me);
      message_vision(HIC "张无忌说道：我明教自第三十二代石教主，以驱逐胡奴为己任，/n" "若你为我的弟子，能杀了蒙古大汗，我或许可将明教交给你！\n", me);
      me->set_temp("jm_mingjiao5", 1);
      return 1;
    } else {
      message_vision("张无忌笑着说道：这是本教圣物，我还是收起来吧\n", me);
      return 1;
    }
  }
  return 0;
}

void destrory(object ob) {
  destruct(ob);
}

