string ask_yang()
{
	object me;
	me = this_player();
	
	if ( (string)me->query("family/family_name") == "明教")
	{
		me->set_temp("jm_mingjiao1",1);
		return HIC"阳教主已失踪多年，教内弟子打探多年也未能探得消息！\n"
		""+RANK_D->query_respect(me)+"若能寻得阳教主消息或者遗物，请务必交给张教主\n"NOR;	
	}
	else 
	{
		return HIY"那是我教第三十三代教主，武功威震天下。\n"NOR;
	}
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query("con",1) < 30) {
                command("say " + RANK_D->query_respect(ob) +
                        "体质欠佳，难学得我这一身武功。");
                return;
        }
       if ((string)ob->query("family/family_name")!="明教" ) {
                command("say " + RANK_D->query_respect(ob) + "若想拜入我派，你可以先去拜徐达。");
                return;
        }        

	if ((int)ob->query_skill("shenghuo-shengong") < 500) 
	{
        command("say 你对我明教圣火神功练习的不够娴熟。");
		return;
	}	  
        if ((int)ob->query("shen") < 5000) {
                command("say " + RANK_D->query_respect(ob) +
                        "有所不知，我平生最恨奸诈之人，你正气太低，我不能让你用明教武功害人。");
                return;
        }
        if ((int)ob->query("score") <= 5000) {
                command("say 这位" + RANK_D->query_respect(ob) +
                        "似乎对本教不够忠心，我还不能收你。");
                return;
        }
        command("say 哈哈！ 我明教又得一良材，望你日后康扶正义，把我明教发扬光大。");
        command("recruit " + ob->query("id"));
        if((string)ob->query("class") != "shizhe")
        ob->set("class", "shizhe");
        ob->set("title","明教光明左使属下教众");
}

void die()
{
    object ob, me;        
    me = query_temp("last_damage_from");
	if (me && me->query("family/master_id") == "mie jue" && me->query_temp("jm_emei2"))
	{ 
        ob = new("/d/mingjiao/obj/rentou1");
		ob->set("owner",me->query("id"));	//设定识别
        ob->move(environment(this_object()));
		ob->set("long", "明教光明左使，看起来英俊潇洒，只是，目前已经没有了头颅。\n");
		tell_room(environment(this_player()), "杨逍浑身鲜血，倒在地上，头颅已然不见了．\n");
	}
	::die();
}