// yangxiao.c 杨逍

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_juezhan();
string ask_yang();

void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("杨逍",({"yang xiao","yang","xiao"}));
	set("title","明教光明左使");
	set("title",RED"明教光明左使"NOR);
	set("long", 
                "他就是明教的光明左使。\n"
                "白色长袍的中年书生,相貌俊雅.只是双眉下垂,\n"
                "嘴边露出几条深深皱纹,不免略带衰老凄苦之相.\n"
                "他不言不动,神色漠然,似乎心弛远处,正在想什么事情.\n");
	set("age", 40);
	set("attitude", "peaceful");
	set("shen_type", 0);
	set("str", 22);
	set("int", 28);
	set("con", 12);
	set("dex", 20);
	set("per", 28);
	set("max_qi",3500);
	set("max_jing", 1000);
	set("neili", 3000);
	set("max_neili", 3000);
	set("wuyongjiali", 80);
	set("combat_exp", 9000000);
	set_skill("sword",500+jibie/3+random(jibie/5));
	set_skill("dodge",500+jibie/3+random(jibie/5));
	set_skill("unarmed",500+jibie/3+random(jibie/5)); 
	set_skill("literate",500+jibie/3+random(jibie/5));
	set_skill("force",500+jibie/3+random(jibie/5));
	set_skill("shenghuo-shengong",500+jibie/3+random(jibie/5));
	set_skill("qingyunwu", 500+jibie/3+random(jibie/5));
	set_skill("shenghuo-jian",500+jibie/3+random(jibie/5));
	set_skill("shenghuo-ling", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("bosi-guaizhao", 500+jibie/3+random(jibie/5));
	set_skill("qiankundanuoyi", 500+jibie/3+random(jibie/5));
	map_skill("dodge", "qingyunwu");
	map_skill("force","shenghuo-shengong");
	map_skill("sword","shenghuo-jian");
	map_skill("parry","qiankundanuoyi");
	map_skill("parry","bosi-guaizhao");
	create_family("明教",35,"使者");
 	set("inquiry", ([
		"决战光明顶" : (: ask_juezhan :),	
		"阳教主" : (: ask_yang :),
	]));       
	setup();
	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/cloth/cloth")->wear();
        
}
#include "/d/mingjiao/npc/juezhan-gmd.h"
