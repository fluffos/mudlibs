//凤尾箭-名器
#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create() {
  set_name(HIC "凤尾箭" NOR, ({ "fengwei jian", "arrow" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "束");
    set("value", 1000);
    set("base_unit", "支");
    set("base_weight", 10);
    set("base_value", 10);
    set("material", "iron");
    set("long", "凤尾箭连珠箭发，势道凶猛。\n");
    set("wield_msg", HIC "$N迅速地从箭袋中抽出一束凤尾箭，拉弦在手，就待发出！\n" NOR);
    set("unwield_msg", HIC "$N将手里剩下的凤尾箭放回箭袋中。\n" NOR);
    set("weapon_prop/dexerity", 10);
    set("weapon_prop/throwing", 30);
    set("weapon_prop/dodge", 5);
    set("weapon_prop/intelligence", 5);
    set("weapon_prop/parry", 5);
    set("no_get", 1);
    set("no_give", 1);
    set("no_put", 1);
    set("no_drop", 1);
    set("throwing_num_max", 1);  //2018.10.8阿飞改，暗器中的名器与神器设置为无限数量
  }
  set_amount(1);
  init_throwing(450, 2);
  setup();
}
int query_autoload() { return 1; }
