//倚天剑-名器，峨嵋派之物
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
    set_name("倚天剑", ({ "yitian jian", "yitian","jian" }) );
    set_weight(20000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        	set("unit", "柄");
		set("icon", "10016");
        	set("value", 50000);
//        	set("no_drop", "1");
        	set("material", "iron");
        	set("long", "这是天下第一利器，有“倚天不出，谁与争锋”之说。\n");
        	set("wield_msg","直如矫龙吞水，长虹冠日一般，$n已在$N手中，天地为之变色。\n");
        	set("unwield_msg", "$N将$n插回腰间，华光顿敛，天地间只闻龙鸣。\n");
		set("weapon_prop/sword", 50);
		set("weapon_prop/intelligence", 10);
		set("weapon_prop/dexerity", 10);
		set("weapon_prop/dodge", 10);
		set("weapon_prop/parry", 10);			
	}
	init_sword(550,2);	
	setup();
}
int query_autoload() { return 1; }
