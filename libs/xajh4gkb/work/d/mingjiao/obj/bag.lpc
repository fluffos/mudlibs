// bag.c
#include <ansi.h>;
inherit ITEM;

void create()
{
	set_name("油布包", ({ "bag", "bao" }));
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("long", "这是一个油布包裹。\n");
		set("value", 500);
		set("material", "cloth");
	}
	set("book_count", 1);
}

void init()
{
	if( this_player() == environment() )
	{
		add_action("do_open", "open");
		add_action("do_open", "unpack");
		add_action("do_open", "dakai");
	}
}

int do_open(string arg)
{
	object me, book;
	object where;
	me = this_player();
	if ( !arg )
	{
		return notify_fail("什么？\n");
	}
	if ( query("book_count") < 1)
	{
		return notify_fail("油布包里面什么也没有了。\n");
	}
//	if ( me->query("id")!=this_object()->query("owner") )
//		return notify_fail("这只是一个普通的油布包裹，你确定这是你的吗？。\n");
	if ( arg == "bag")
	{
		where = environment(me);
		message("chat", HIY"【镜花水月】"+HIM""+this_player()->query("name")+"找到九阳真经啦。\n"NOR, users());	
		message_vision("$N轻轻地把油布包来看时，里面原来是一本薄薄的经书，只因油布包得紧密，虽长期藏在猿腹之中，书页仍然完好无损。\n", me);
		book = new("/clone/book/jiuyang");
		book->set("owner",me->query("id"));	//设定识别
		book->move(me);
/*		book = new("/clone/book/jiuyang1");
		book->set("owner",me->query("id"));	//设定识别
		book->move(file_name(where));
		book = new("/clone/book/jiuyang2");
		book->set("owner",me->query("id"));	//设定识别
		book->move(file_name(where));
		book = new("/clone/book/jiuyang3");
		book->set("owner",me->query("id"));	//设定识别
		book->move(file_name(where));
		book = new("/clone/book/jiuyang4");
		book->set("owner",me->query("id"));	//设定识别
		book->move(file_name(where));*/
		add("book_count",-1);
		destruct(this_object());
	}
	return 1;
}
