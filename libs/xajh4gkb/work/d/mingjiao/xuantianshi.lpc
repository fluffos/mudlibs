// Room: /d/mingjiao/xuantianshi.c
inherit ROOM;
string *order = ( {""HIY"", ""HIG"", ""RED"", ""MAG"", ""YEL"", ""HIC"", ""HIW"", ""HIR"",""HIB"", ""CYN"",""WHT"",""HIM"",""BLU""});
void create()
{
	set("short", "悬天石");
	set("long", @LONG
从石上远眺，只见云海苍茫处，险绝万峦生，昆仑一脉，逶迤
千里，真一派大好江山。关于悬天石，还有许多传说。相传明教第
三十代教主〖风舞柳影〗阿娜(Doll)为解明教之难，舍身于此，明
教一代绝学“乾坤大挪移”从此失传。或许你在这里可以参悟（canwu）
明教圣火的意境。
LONG );
	set("exits", ([
		"down" : __DIR__"shanlu3",
	]));
	set("item_desc", ([
		"doll" : "一个来自波斯总教的教主。\n",
	]));

	set("outdoors", "mingjiao");
	setup();
}

void init()
{
	add_action("do_canwu", "canwu");
}


int do_canwu(string arg)
{
	object me=this_player();

	string *poem = ({
		"焚我残躯，熊熊圣火，生亦何欢，死亦何苦？为善除恶，惟光明故。",
		"喜乐悲愁，皆归尘土。怜我世人，忧患实多！怜我世人，忧患实多。",
		"圣火昭昭，圣火耀耀，凡我弟子，同心同劳。",
		"怜我世人，飘零无助，恩泽万物，唯光明故。",
		"光明慈父，知情知义，启我澄心，苏我明性。",
		"怜我世间，魔尘岔染，除恶扬善，唯光明故。",
		"生亦何欢，死亦何苦，熊熊圣火，焚我残躯。",
		"十二常宝，谱启诸明，妙音引路，无量净土。",
		"光明普遍皆清净，常乐寂灭无动诅。彼受欢乐无烦恼，若言有苦无是处。",
		"常受快乐光明中，若言有病无是处。如有得住彼国者，究竟普会无忧愁。",
		"处所庄严皆清净，诸恶不净彼元无；快乐充遍常宽泰，言有相陵无是处。",
		});

    if(me->is_busy() )
        return notify_fail("你现在忙着呢，哪有功夫参悟圣火。\n");
    if(!me->query_temp("jm_mingjiao7") )
        return notify_fail("你未得到明教当代教主的指点，无法参悟圣火精义。\n");	
    if(me->query("jm/mingjiao")) 
		return notify_fail("你已经完全参透了明教圣火的精神，不需要在这领悟了。\n");		
    if(me->query("family/family_name") != "明教")
		return notify_fail("不是明教教主的传人，如何能参悟前代教主舍身的精神？\n");	
	
	if (me->query_skill("shenghuo-shengong",1) < 1000 )
	{
        tell_object(me,"你的圣火神功.......\n"); 
        return 1;
	}
	if (me->query_skill("shenghuo-jian",1) < 2000)
	{
        tell_object(me,"你的圣火剑法.......\n"); 
        return 1;
	}
	if (me->query_skill("shenghuo-quan",1) < 2000)
	{
        tell_object(me,"你的圣火拳.......\n"); 
        return 1;
	}
	if (me->query_skill("shenghuo-ling",1) < 2000)
	{
        tell_object(me,"你的圣火令.......\n"); 
        return 1;
	}	
    if(me->query("jingli") < 1000)
	{
        tell_object(me,"你还是先休息一会儿吧。\n");     
        return 1;
	}
	
	tell_object(me,HIW"你在这里瞻仰前代教主舍生取义的精神......\n"NOR);
	message_vision(""+(order[random(13)])+"" + poem[random(sizeof(poem))] + "\n", me);
	me->add("jingli",-500);
	me->start_busy(2);

    if( random(100000) < me->query("kar",1) )
	{
        me->set("jm/mingjiao",1);
		me->add("family_score",1);
        tell_object(me,HIB"你突然醒悟道："HIY"原来熊熊圣火可以发挥如此之大的威力"HIR"！\n"NOR);
		tell_object(me,HIB"恭喜你融汇贯通了明教武功的精髓！\n"NOR);
		message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，在明教玄天石领悟了明教圣火的教义，将明教武功融会贯通！\n"NOR,users() );
	}
	return 1;
}             

