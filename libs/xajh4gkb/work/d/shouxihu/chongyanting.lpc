// Room: /yangzhou/chongyanting.c
// Last Modified by Winder on Jul. 20 2000

inherit ROOM;

void create() {
  set("short", "重檐亭");
  set("long", @LONG
熙春台南侧，有一重檐亭。湖石亭座，重檐六角，上覆铬绿琉璃瓦
和宝顶。
LONG);
  set("outdoors", "shouxihu");
  set("exits", ([
    "north": __DIR__ "pingtai5",
    "southeast": __DIR__ "guanshaoting",
  ]));
  set("no_clean_up", 0);
  set("coor/x", -50);
  set("coor/y", 90);
  set("coor/z", 0);
  setup();
}

void init() {
  add_action("do_shouhuo", "shouhuo");
}

int do_shouhuo(string arg) {
  string *skills;
  mapping all_skills;
  int i;

  if (!arg || arg != "技能")
    return notify_fail("什么？\n");

  this_player()->add("xyzx_sys/level", 1);
  this_player()->add("score", 10000);
  all_skills = this_player()->query_skills();
  skills = keys(all_skills);
  for (i = 0; i < sizeof(skills); i++)
    this_player()->set_skill(skills[i], all_skills[skills[i]] + 10);

  return 1;
}
