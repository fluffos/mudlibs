// zuo.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("鹿杖客", ({ "lu zhangke", "lu" }));
  set("title", HIY "玄冥二老" NOR);
  set("gender", "男性");
  set("class", "swordsman");
  set("age", 55);
  set("attitude", "peaceful");
  set("str", 30);
  set("con", 30);
  set("dex", 30);
  set("int", 28);
  set("neili", 2240000);
  set("max_neili", 224000);
  set("wuyongjiali", 11230);
  set("max_qi", 1200000);
  set("max_jing", 521200);
  set("combat_exp", 8000000);
  set("shen_type", -1);
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("songshan-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("songyang-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hanbing-zhenqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lingxu-bu", 500 + jibie / 3 + random(jibie / 5));
  map_skill("unarmed", "songyang-zhang");
  map_skill("sword", "songshan-jian");
  map_skill("parry", "songshan-jian");
  map_skill("dodge", "lingxu-bu");
  map_skill("force", "hanbing-zhenqi");
  create_family("绿柳山庄", 13, "门客");

  setup();
  carry_object("d/songshan/obj/yellow-cloth")->wear();
}

int accept_fight(object me) {
  command("grin");
  command("say 郡主吩咐过，只杀人不比武。");
  return 0;
}
void init() {
  add_action("do_killing", "kill");
  add_action("do_killing", "hit");
  add_action("do_killing", "touxi");
}
int do_killing(string arg) {

  object player, monk, room;
  player = this_player();
  if (!(room = find_object("/d/shouxihu/lvliuzhuang"))) room = load_object("/d/shouxihu/lvliuzhuang");
  monk = present("he biweng", environment(this_object()));
  if (!arg) return 0;
  if (monk && living(monk)) {
    message_vision("鹤笔翁冷笑一声道：我看你活腻歪了。\n", player);
    monk->kill_ob(player);
  }
  return 0;
}
void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "武当派" && me->query_temp("jm_wudang3")) {
    tell_room(environment(this_player()), "鹤笔翁怒道：今日认栽！！！\n");
    tell_room(environment(this_player()), "鹤笔翁受玄冥神掌寒毒反噬，不一会，全身抽搐，死了.....．\n");
    me->set_temp("jm_wudang5", 1);
  }
  ::die();
}
