inherit ROOM;

void create() {
  set("short", HIG "绿柳山庄" NOR);
  set("long", @LONG
这是一座颇大的庄子，庄内遍植杨柳，堤侧是盈盈西湖水。
一眼看去就知道此间主人是当地的富豪，据说，此间主人
也是武林中人，所以路过之人也不敢随意的进入，当以江
湖之礼求见。
LONG);
  set("outdoors", "shouxihu");
  set("objects", ([
    "/d/shouxihu/npc/lu": 1,
    "/d/shouxihu/npc/he": 1,
  ]));
  set("exits", ([
    "east": __DIR__ "changdi3",
  ]));
  set("coor/x", -30);
  set("coor/y", 110);
  set("coor/z", 0);
  setup();
}
