//xln.c 小龙女
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_book();
int ask_yunv();
void create()
{
	int jibie;
	jibie = 7000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
	set_name("林侍女", ({ "lin shinv", "shinv", "lin" }));
	set("title",HIC"林朝英侍女"NOR);
	set("long", "她还是个“憨态可掬，满脸稚气”的小姑娘，哪知后来竟成了小龙女的师父。\n");
	set("gender", "女性");
	set("age", 39);
	set("attitude", "peaceful");
	set("per", 40);
	set("str", 24);
	set("dex", 23);
	set("con", 20);
	set("int", 24);
	set("shen", 20000);	
	set("wuyongjiali", 13000);
	set("max_qi", 2500000);	
	set("max_jing", 1060000);
	set("neili", 3050000);    	
	set("max_neili", 750000);	
	set("combat_exp", 54000000);	
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("force", 500+jibie/3+random(jibie/5));	
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));	
	set_skill("whip", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));	
	set_skill("tianluo-diwang", 500+jibie/3+random(jibie/5));
	set_skill("meinv-quanfa", 500+jibie/3+random(jibie/5));			
	set_skill("yunv-shenfa", 500+jibie/3+random(jibie/5));
	set_skill("yinsuo-jinling", 500+jibie/3+random(jibie/5)); 
	set_skill("literate", 500+jibie/3+random(jibie/5));         
	set_skill("yunv-jianfa", 500+jibie/3+random(jibie/5));	
	set_skill("yunv-jian", 500+jibie/3+random(jibie/5));	
	set_skill("yunv-xinjing", 500+jibie/3+random(jibie/5));	
	set_skill("yunv-xinfa", 500+jibie/3+random(jibie/5));	
	set_skill("qufeng",500+jibie/3+random(jibie/5));
	map_skill("force", "yunv-xinjing");
	map_skill("dodge", "yunv-shenfa");
	map_skill("unarmed", "meinv-quanfa");
	map_skill("sword", "yunv-jian");
	map_skill("whip", "yinsuo-jinling");
	map_skill("parry", "yunv-jianfa");
	create_family("古墓派",2,"传人");
	set("book_count", 1);
	set("inquiry", ([
			"小龙女" : "当年还是婴儿的小龙女被遗弃在重阳宫外时，被孙婆婆捡了回来。",
			"李莫愁" : "李莫愁是我五十多岁时收的第一个徒儿，可惜不肯立下终身不出古墓的誓言。",
			"孙婆婆" : "收李莫愁的时候，顺带收容了年老仆妇孙婆婆，来照料自己师徒二人起居。",
			"玉女心经": (: ask_book :),
			"玉女图": (: ask_yunv :),
		])); 

	setup();
	carry_object("/clone/weapon/golden_sword")->wield();           	
	carry_object("/d/gumu/obj/yinsuo")->wield();
	carry_object("/d/gumu/obj/buxue1")->wear();
	carry_object("/d/gumu/obj/qun1")->wear(); 
}

void attempt_apprentice(object ob)
{
	mapping fam = ob->query("family");
	if (!fam || fam["family_name"] != "古墓派" )
	{
		command("say "+RANK_D->query_respect(ob)+"与本派素无来往，不知此话从何谈起？");
		return;
	}  
	if ((int)ob->query("xyzx_sys/level")<1000)
	{
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
        command("say 是否应该去江湖中多加磨炼。");
		return ;
	}		 				
	if((int)ob->query_skill("yunv-xinjing", 1) < 1000 && (int)ob->query_skill("yunv-xinfa", 1) < 1000) 
	{
		command("say 我古墓武功内功是基础。"); 
		command("say " + RANK_D->query_respect(ob)+"是否还应该先在内功上多下点功夫？");
		return;
	}  
	if((int)ob->query_skill("yunv-jianfa", 1) < 1000) 
	{
		command("say 你玉女剑法这么差，我教的你不一定学得会。"); 
		command("say "+RANK_D->query_respect(ob)+"是否还应该在玉女剑法上多下点功夫？");
		return;
	}
	if(ob->query("int",1) < 30) 
	{
		command("say 我的武功都要极高的悟性才能学会。");
		command("say 要能达到炉火纯青之境，体质什么的倒是无关紧要，悟性却是半点也马虎不得。");
		command("say 这位"+RANK_D->query_respect(ob)+"的悟性还大有潜力可挖，还是请回吧。");
		return;
	}
	if(ob->query("dex",1) < 30) 
	{
		command("say 我派武功对身法要求极高。");
		command("say 要能达到炉火纯青之境，身轻如燕是很有必要的。");
		return;
	}
	if((int)ob->query("per",1) < 25 ) 
	{
		command("say 我古墓派都是美女如云。");
		return;
	}			
	if(ob->query("gender") != "女性") 
	{
		command("say 我古墓派可只收女徒。");
		return;
	}
	command("say 嗯，看你还是个学武的料，我就收下你吧！");
	command("recruit " + ob->query("id"));
	ob->set("title","古墓传人");
	ob->set("class","sworder");
}

int ask_book()
{
	object me,shinv;
	object book;
	shinv=this_object();
	me=this_player();
	if ((string)me->query("family/family_name") != "古墓派" || (int)me->query("family/generation") > 4)
	{
		command("say 你并非古墓派高级弟子，这玉女心经不能交给你");
		return 1;
	}
	else 
	{
		if (shinv->query("book_count") < 1)
		{
			command("say 你来晚啦，玉女心经早被人拿走啦。");
			return 1;
		}
		else 
		{
			message_vision(CYN "林侍女微笑着从怀中取出玉女心经，交了给$N \n" NOR,me);
			book=new("/d/gumu/obj/book");
			book->set("owner",me->query("id"));
			book->move(me);
			shinv->add("book_count",-1);
			return 1;
		}
	}
	return 1;
}

int ask_yunv()
{
	object me;
	me = this_player();
	if ((string)me->query("family/family_name")== "古墓派" && (int)me->query_temp("jm_gumu9"))
	{
		message("vision", HIG "林侍女说道：小姐的武功均出自玉女图。\n"NOR, me );
		message("vision", HIG "林侍女说道：早年小姐从终南山得到了一卷图谱，在其中领悟了玉女心经和玉女剑法。\n"NOR, me );
		message("vision", HIG "林侍女说道：不过这玉女图如今不知所踪，或许你可以去终南山凹哪里看看。\n"NOR, me );
		me->set_temp("jm_gumu10",1);
	}
	else 
	{
		message("vision", HIC"林侍女说道：玉女图？我从未看见啊。\n"NOR, me );
	}
	return 1;
}