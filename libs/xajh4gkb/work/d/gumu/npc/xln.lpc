//xln.c 小龙女
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_suo();
string ask_zhen();
int ask_zushi(); 
void create()
{
	int jibie;
	jibie = 6000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
	set_name("小龙女", ({ "xiao longnv", "xiao", "longnv" }));
	set("title","古墓侠侣");
	set("nickname",HIC"玉女素心"NOR);
	set("long", "她清丽异常，但也许是长居古墓之故，面色略白。\n");
	set("gender", "女性");
	set("age", 39);
	set("couple/couple_id","yang guo");	
//	set("attitude", "friendly");	//这个友好性格会导致不接受切磋
	set("attitude", "peaceful");
	set("per", 40);
	set("str", 24);
	set("dex", 23);
	set("con", 20);
	set("int", 24);
	set("shen", 20000);	
	set("wuyongjiali", 13000);
	set("max_qi", 2500000);	
	set("max_jing", 1060000);
	set("neili", 3050000);    	
	set("max_neili", 750000);	
	set("combat_exp", 24000000);	
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("whip", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("tianluo-diwang", 500+jibie/3+random(jibie/5));
	set_skill("meinv-quanfa", 500+jibie/3+random(jibie/5));
	set_skill("yunv-shenfa", 500+jibie/3+random(jibie/5));
	set_skill("yinsuo-jinling", 500+jibie/3+random(jibie/5));
	set_skill("literate", 500+jibie/3+random(jibie/5));
	set_skill("yunv-jianfa", 500+jibie/3+random(jibie/5));
	set_skill("yunv-jian", 500+jibie/3+random(jibie/5));
	set_skill("yunv-xinjing", 500+jibie/3+random(jibie/5));
	set_skill("yunv-xinfa", 500+jibie/3+random(jibie/5));
	set_skill("qufeng",500+jibie/3+random(jibie/5));
	map_skill("force", "yunv-xinjing");
	map_skill("dodge", "yunv-shenfa");
	map_skill("unarmed", "meinv-quanfa");
	map_skill("sword", "yunv-jianfa");
	map_skill("whip", "yinsuo-jinling");
	map_skill("parry", "yunv-jian");
	create_family("古墓派",3,"女主人");

	set("inquiry", ([
			"杨过" : "过儿是我夫君，我知道他很爱我，可一直呆在这真怕他会闷。", 
			"李莫愁" : "她是我师姐，不过我已经派人去清理门户了。",            
			"钥匙" : "嗯....这我可记不清楚，好象是放在古墓里面了吧。",
			"银索" : (: ask_suo :),
			"玉蜂针" : (: ask_zhen :),
			"祖师婆婆" : (: ask_zushi :),
		])); 
	set("zhen_count", 2);
	
	setup();
	carry_object("/clone/weapon/golden_sword")->wield();           	
	carry_object("/d/gumu/obj/yinsuo")->wield();
	carry_object("/d/gumu/obj/buxue1")->wear();
	carry_object("/d/gumu/obj/qun1")->wear(); 
}

void attempt_apprentice(object ob)
{
	mapping fam = ob->query("family");
//	if (!fam || fam["family_name"] != "古墓派" || fam["generation"]!=5)	//没必要是5代弟子
	if (!fam || fam["family_name"] != "古墓派" )	
	{
		command("say "+RANK_D->query_respect(ob)+"与本派素无来往，不知此话从何谈起？");
		return;
	}  
	if ((int)ob->query("xyzx_sys/level")<1000)
	{
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
        command("say 是否应该去江湖中多加磨炼。");
		return ;
	}		 				
	if((int)ob->query_skill("yunv-xinjing", 1) < 1000 && (int)ob->query_skill("yunv-xinfa", 1) < 1000) 
	{
		command("say 我古墓武功内功是基础。"); 
		command("say " + RANK_D->query_respect(ob)+"是否还应该先在内功上多下点功夫？");
		return;
	}  
/*	if((int)ob->query_skill("yunv-jianfa", 1) < 1000) 
	{
		command("say 你玉女剑法这么差，我教的你不一定学得会。"); 
		command("say "+RANK_D->query_respect(ob)+"是否还应该在玉女剑法上多下点功夫？");
		return;
	}*/
	if(ob->query("int",1) < 30) 
	{
		command("say 我的武功都要极高的悟性才能学会。");
		command("say 要能达到炉火纯青之境，体质什么的倒是无关紧要，悟性却是半点也马虎不得。");
		command("say 这位"+RANK_D->query_respect(ob)+"的悟性还大有潜力可挖，还是请回吧。");
		return;
	}
	if(ob->query("dex",1) < 30) 
	{
		command("say 我派武功对身法要求极高。");
		command("say 要能达到炉火纯青之境，身轻如燕是很有必要的。");
		return;
	}
	if((int)ob->query("per",1) < 25 ) 
	{
		command("say 我古墓派都是美女如云。");
		return;
	}			
	if(ob->query("gender") != "女性") 
	{
		command("say 我可只收女徒，你去找我夫君试试吧。");
		return;
	}
	command("say 嗯，看你还是个学武的料，我就收下你吧！");
	command("recruit " + ob->query("id"));
	ob->set("title","古墓派神雕侠侣传人");
	ob->set("class","sworder");
}

string ask_suo()
{
	object ob = this_player();
	mapping fam = ob->query("family");
	if (!fam || fam["family_name"] != "古墓派" || ob->query("family/master_id") != "xiao longnv")
		return RANK_D->query_respect(ob)+"，我已经多年未用银索了，也不知道放在何处了。";
	if (ob->query_skill("yinsuo-jinling", 1) < 100)
		return "这位"+ RANK_D->query_respect(ob) +"，银索灵活异常，你是否应该把武功练高些？";
	ob->set_temp("marks/银索", 1);
	command("nod " + ob->query("id"));
	return "不错，银索就放在此屋中，你自个找找吧。";       
} 

string ask_zhen()
{
	mapping fam;
	object ob;

	if (!(fam = this_player()->query("family")) || fam["family_name"] != "古墓派" )
		return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？";
	if (query("zhen_count") < 1)
		return "我已经将玉蜂针已给了派去清理门户的人，你好好练功，以后有机会再去吧。";
	add("zhen_count", -1);
	ob = new("/d/gumu/obj/yfzhen.lpc");
	ob->move(this_player());
	return "你如此自愿为师门清理门户，不枉我平时一番栽培，这枚玉蜂针你就拿去吧。";
}

int ask_zushi()
{
	object me;
	me = this_player();
	if ((string)me->query("family/family_name")== "古墓派" && (int)me->query_temp("jm_gumu7"))
	{
		message("vision", HIG "小龙女说道：祖师婆婆对王重阳甚有情意，只不过婆婆心高气傲，始终不愿先行吐露情意。/n""怎奈那王重阳于邦国之仇总是难以忘怀，常说：「匈奴未灭，何以为家？」对林朝英的深情厚意，装痴乔呆，只作不知。\n"NOR, me );
		message("vision", HIG "小龙女说道：祖师婆婆只道王重阳瞧她不起，怨愤无已。两人本已化敌为友，后来却又因爱成仇，约在终南山上比武决胜，斗了几千招，始终难分胜败。\n"NOR, me );
		message("vision", HIG "小龙女说道：后来那王重阳在古墓不远处盖了全真观，出家为道士。两人恩怨纠缠了一辈子，却始终未能偿愿与之共偕连理，最後双方都落得郁郁而终。\n"NOR, me );
		message("vision", HIG "小龙女说道：自此我古墓派女子须点守宫砂，并立誓一生一世都不得离墓，若有不知此门规的男子愿为己而死，则可破誓下山。\n"NOR, me );
		message("vision", HIG "小龙女说道：祖师婆婆毕生所愿就是击败那王重阳，力压全真教。若你能完成婆婆心愿，可以去古墓深处找我师傅指点古墓武学。\n"NOR, me );
		me->set_temp("jm_gumu8",1);
	}
	else 
	{
		message("vision", HIC"小龙女说道：那是我派祖师，岂是你能问的！\n"NOR, me );
	}
	return 1;
}