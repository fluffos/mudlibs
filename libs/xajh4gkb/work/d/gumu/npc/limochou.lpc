#include <ansi.h>
inherit NPC;
int ask_heyuanjun();
int ask_luzhanyuan();
void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
	set_name("李莫愁", ({ "li mochou", "li", "mochou" }));
	set("long", "她生得极为美貌，但冰冷的目光让人不寒而立。\n");
	set("nickname", HIB"赤练仙子"NOR);
	set("gender", "女性");
	set("rank_info/respect", "道姑");
	create_family("古墓派", 3, "弟子");
	set("age", 27); 
	set("per", 28);        
	set("attitude","heroism");
	set("str", 22);
	set("dex", 23);
	set("con", 20);
	set("int", 23);
	set("wuyongjiali",30);
	set("combat_exp", 1000000);
	set("max_qi", 2500);
	set("max_jing", 1500);
	set("neili", 3000);
	set("max_neili", 3000);
	set("shen_type", -1);
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("throwing",500+jibie/3+random(jibie/5));
	set_skill("whip", 500+jibie/3+random(jibie/5));
	set_skill("wudu-shenzhang", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("wudu-shenzhang", 500+jibie/3+random(jibie/5));
	set_skill("yunv-shenfa", 500+jibie/3+random(jibie/5));
	set_skill("yunv-jianfa", 500+jibie/3+random(jibie/5));
	set_skill("yunv-xinfa", 500+jibie/3+random(jibie/5));
	set_skill("qiufeng-chenfa", 500+jibie/3+random(jibie/5));
	map_skill("force", "yunv-xinfa");
	map_skill("dodge", "yunv-shenfa");
	map_skill("unarmed", "wudu-shenzhang");
	map_skill("parry", "wudu-shenzhang");
	map_skill("sword", "yunv-jianfa");
	map_skill("whip", "qiufeng-chenfa");
//	prepare_skill("cuff", "wudu-shenzhang");
        
	set("inquiry", ([
            "name" : "站远点！",
            "here" : "我不是本地人，不知道。",
            "情" : "你如何能理解其中相思之苦、惆怅之意？",
            "陆展元" : (: ask_luzhanyuan :),
            "何沅君" : (: ask_heyuanjun :),
            "小龙女" : "那是我的师妹。你问她想干什么？",
            "林朝英" : "那是我的师祖，不该你问的你别问，小心我宰了你。",
		]) );
	set("chat_chance", 10);
	set("chat_msg", ({
            "李莫愁纵声而歌，音调凄婉，歌道：「问世间，情是何物，直教生死相许？」\n",
            "李莫愁歌道：「天南地北双飞客，老翅几回寒暑？」\n",
            "李莫愁唱道：「欢乐趣，离别苦，就中更有痴儿女。」\n",
            "李莫愁唱道：「君应有语，渺万里层云，千山暮雪，只影向谁去？」\n",
            "李莫愁词意悲切，声调更是哀怨，唱道：「横汾路，寂寞当年箫鼓。荒烟依旧平楚。」\n",
            "李莫愁歌道：「招魂些何嗟及，山鬼自啼风雨。」\n",
            "李莫愁唱道：「天也妒，未信兴，莺儿燕子俱黄土。」\n",
            "李莫愁唱道：「千秋万古，为留待骚人，狂歌痛饮，来访雁丘处。」\n",
        }) );
	setup();
	carry_object("/d/gumu/obj/zhen")->wield();
	carry_object("/d/wudang/obj/greenrobe")->wear();

}

void init()
{
	::init();
	add_action("do_look","look");
	add_action("do_look","hug");
	add_action("do_look","mo");
	add_action("do_look","18mo");
	add_action("do_look","kiss");
	add_action("do_look","lean");
	add_action("do_look","interest");
	add_action("do_look","flirt");
	add_action("do_look","pretty");
	add_action("do_look","love");
}

int ask_heyuanjun()
{
	object me;
	me = this_player();
	message("vision", HIR "李莫愁冷笑一声：『我这就送你去见她』！\n" "李莫愁决心杀死" + me->name() +"！\n"NOR, environment(), this_object() );
	kill_ob(this_player());
	return 1;
}
int ask_luzhanyuan()
{
	object me;
	me = this_player();
	if ((string)me->query("family/family_name")== "古墓派" )
	{
		message("vision", HIG "李莫愁说道：在哪个雨季，与陆展元相识相爱......不惜违背师命，反出古墓。谁知，陆展元竟移情何沅君！\n"NOR, me );
		message("vision", HIG "李莫愁说道：怪不得祖师立誓，一生一世都不得离墓，若有不知此门规的男子愿为己而死，则可破誓下山。！\n"NOR, me );
		message("vision", HIG "李莫愁说道：姓陆的都不是好东西，我定要杀光陆姓之人！\n"NOR, me );
		me->set_temp("jm_gumu1",1);
	}
	else 
	{
		message("vision", HIC"李莫愁冷笑一声：你问那个薄情的小畜生做什么？\n"NOR, me );
	}
	return 1;
}

int do_look(string target)
{
	object me;
 
	me = this_player();
	if (id(target)) 
	if ((string)me->query("gender") == "男性") 
	{
		message("vision",HIR "李莫愁大怒，喝道：我最恨你们这些薄情的臭男人！去死吧！\n""李莫愁决心杀死" + me->name() +"！\n"NOR, environment(), this_object() );
		command("throw " + me->query("id"));
		kill_ob(this_player());
	}
} 

void kill_ob(object me)
{     
	command("haha");
	command("throw " + me->query("id"));            
	::kill_ob(me);
}

//void unconcious()
void die()
{
	message_vision("$N轻声一笑，转身射出一枚银针，竟不回头察看，足底加劲，急奔出庙，穿入了桑林。\n",this_object());        
	command("sneer");
	destruct(this_object());
}

void attempt_apprentice(object ob)
{
	if (ob->query("gender")!="女性" )
	{
		command("say 我只收女弟子，男人都是负心人！！！");
		return;
	}
    if((int)ob->query_skill("yunv-xinjing", 1) < 300 && (int)ob->query_skill("yunv-xinfa", 1) < 300) 
	{
        command("say 我古墓武功内功是基础。"); 
        command("say " + RANK_D->query_respect(ob)+"是否还应该先在内功上多下点功夫？");
        return;
    } 	
    if((int)ob->query_skill("wudu-shenzhang", 1) < 300 ) 
	{
		command("say 你连我的看家本领都不会，我收你干什么！！"); 
		command("say " + RANK_D->query_respect(ob)+"是否还应该先多加练习五毒神掌？");
		return;
    } 
	if (ob->query("family/master_id")=="xiao longnv" || ob->query("family/master_id")=="yang bing")
	{
		command ("say 我最恨那贱人了，她的弟子见一个杀一个。");
		return;
	}
	command("nod");
	command("say " + RANK_D->query_respect(ob) + "我就收下你了，以后替我杀光天下负心人 ！\n");
	command("recruit " + ob->query("id") );
	return;
}

int accept_object(object me, object ob)
{
	if ( (string) ob->query("id") =="yunv jing" ) 
	{
		if ((int)me->query_temp("jm_gumu2") && (string)me->query("family/family_name") == "古墓派" && me->query("id")==ob->query("owner"))
		{
			message_vision("$N对$n说道：师傅为何不将玉女心经传给我。\n", this_object(),me);
			message_vision("$N对$n说道：待我修成玉女心经，必杀尽天下男人！！\n", this_object(),me);
			message_vision("\n伶仃数载，回首望旧台。落花映残阳，几寸白。饮风化如雪，裁出数缕秋裳。断发尽刺血。传入丹青，默许纸上容装。\n""\n千古长情，婉转曲终腔。何有意厢人，随潮涨。观尽尘间曼舞，残烛断，镜中霜。梦里伴风葬。只借笔根，断了谁的念想？\n", this_object(),me);
			message_vision("只见萧峰气运丹田，左手倚天剑，右手屠龙刀，猛然相碰！“咔嚓”一声，倚天剑屠龙刀断为两截，断痕处露出一道缝隙。>\n", this_object(),me);
			message_vision("问世间，情为何物？直教生死相许。红尘看破，此生愿长伴青灯古佛！\n", this_object(),me);
			me->set_temp("jm_gumu3",1);
			return 1;
		} else
		{
			message_vision("$N对$n说道：这是我古墓派正宗的内功心法，我还是收起来吧。\n",this_object(),me);
			return 1;
		}
	}

	return 0;
}