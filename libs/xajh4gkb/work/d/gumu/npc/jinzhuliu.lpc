//yang.c 杨过
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  int jibie;
  jibie = 3000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set_name("金逐流", ({ "jin zhuliu", "zhuliu", "jin" }));
  set("title", "「天下第一剑客」");
  set("long", "他就是名满天下的金逐流，为武学大师金世遗之子，剑法天下第一。\n");
  set("age", 35);
  set("shen", 1000000);
  set("per", 30);
  set("str", 28);
  set("int", 28);
  set("con", 30);
  set("dex", 29);
  set("max_qi", 3000000);
  set("couple/couple_id", "shi hongying");
  set("max_jing", 1000000);
  set("neili", 4000000);
  set("max_jingli", 200000);
  set("jingli", 1000000);
  set("max_neili", 600000);
  set("wuyongjiali", 30000);
  set("combat_exp", 150000000);
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunv-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xuantie-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("anranxiaohun-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianluo-diwang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunv-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "yunv-xinfa");
  map_skill("sword", "xuantie-jianfa");
  map_skill("dodge", "yunv-shenfa");
  map_skill("parry", "xuantie-jianfa");
  map_skill("unarmed", "anranxiaohun-zhang");
  /*		set("chat_chance_combat", 100);	
		set("chat_msg_combat", ({
			(: perform_action, "unarmed.xiaohun" :),
			(: perform_action, "unarmed.jingtao" :),
			(: perform_action, "unarmed.tuo" :),		
			(: perform_action, "sword.haichao" :),
			(: perform_action, "sword.xunlei" :),
			(: perform_action, "sword.hai" :),
			(: perform_action, "sword.qianjun" :),
		}));*/

  create_family("古墓派", 5, "玄铁剑传人");
  set("inquiry", ([
    "古墓派": "吾不曾听闻！据说师祖曾在古墓隐居。",
    "玄铁剑": "玄铁剑乃吾师祖昔日随身之物，此剑杀气甚重，吾无意让此剑重现江湖，故秘藏此剑于一处。",
    "史红英": "红英乃我爱妻，你问她做甚？",
  ]));

  setup();
  carry_object("/d/gumu/obj/buxue1")->wear();
  carry_object("/d/gumu/obj/xuantiejian")->wield();
  carry_object("/d/gumu/obj/pao1")->wear();
}

void attempt_apprentice(object ob) {
  mapping fam = ob->query("family");
  if (!fam || fam["family_name"] != "古墓派") {
    command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
    return;
  }
  if ((int)ob->query_skill(
    "yunv-xinjing",
    1
  ) < 200 && (int)ob->query_skill("yunv-xinfa", 1) < 200) {
    command("say 内功是古墓武功之基础。");
    command("say " + RANK_D->query_respect(ob) + "是否还应该先在内功上多下点功夫？");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 100) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    command("say 是否应该去江湖中多加磨炼。");
    return;
  }
  if ((int)ob->query("str", 1) < 25) {
    command("say 我的重剑剑法都要极高的臂力才能使用。");
    return;
  }
  if ((int)ob->query("con", 1) < 25) {
    command("say 黯然销魂首重内功，因此根骨非常重要。");
    return;
  }
  if ((int)ob->query("per", 1) < 25) {
    command("say 我古墓派无不是俊美之人。");
    return;
  }
  if (ob->query("gender") != "男性") {
    command("say 玄铁剑法可不是女子能舞动的。");
    return;
  }
  command("say 嗯，看你还是个学武的料，我就收下你吧！");
  command("recruit " + ob->query("id"));
  return;
}
