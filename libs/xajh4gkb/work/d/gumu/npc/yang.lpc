//yang.c 杨过
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_qinghua();
int ask_duanchang();
void create() {
  int jibie;
  jibie = 6000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set_name("杨过", ({ "yang guo", "yang", "guo" }));
  set("title", "古墓侠侣");
  set("nickname", HIY "神雕大侠" NOR);
  set("long", "他就是名满天下的杨过。虽断一臂但仍遮不去一脸的英雄豪气。\n");
  set("attitude", "peaceful");
  set("age", 35);
  set("shen", 1000000);
  set("per", 30);
  set("str", 28);
  set("int", 28);
  set("con", 30);
  set("dex", 29);
  set("max_qi", 3000000);
  set("couple/couple_id", "xiao longnv");
  set("max_jing", 1000000);
  set("neili", 4000000);
  set("max_jingli", 200000);
  set("jingli", 1000000);
  set("max_neili", 600000);
  set("wuyongjiali", 30000);
  set("combat_exp", 150000000);
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunv-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xuantie-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("anranxiaohun-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("quanzhen-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianluo-diwang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunv-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "yunv-xinfa");
  map_skill("sword", "xuantie-jianfa");
  map_skill("dodge", "yunv-shenfa");
  map_skill("parry", "xuantie-jianfa");
  map_skill("unarmed", "anranxiaohun-zhang");

  create_family("古墓派", 3, "男主人");
  set("inquiry", ([
    "古墓": "那日华山与众英雄诀别后和龙儿隐居于此已有数年，不闻世事，能与龙儿在此长伴一世，此身足矣！",
    "玄铁剑": "玄铁剑乃吾昔日随身之物，此剑杀气甚重，吾无意让此剑重现江湖，故秘藏此剑于一处。",
    "小龙女": "龙儿乃我爱妻，你问她做甚？",
    "情花之毒": (: ask_qinghua :),
    "断肠崖": (: ask_duanchang :),
  ]));

  setup();
  carry_object("/d/gumu/obj/buxue1")->wear();
  carry_object("/d/gumu/obj/xuantiejian")->wield();
  carry_object("/d/gumu/obj/pao1")->wear();
}

int ask_qinghua() {
  object me;
  me = this_player();
  if ((string)me->query("family/family_name") == "古墓派" && (int)me->query_temp("jm_gumu3")) {
    message("vision", HIG "杨过说道：姑姑中了情花之毒，非绝情丹不可解，哎...\n" NOR, me);
    message("vision", HIG "杨过说道：谁若能为姑姑解了此毒，我必有厚报！\n" NOR, me);
    me->set_temp("jm_gumu4", 1);
  } else {
    message("vision", HIC "杨过说道：那是害人的玩意，你问这个干什么？\n" NOR, me);
  }
  return 1;
}
int ask_duanchang() {
  object me;
  me = this_player();
  if ((string)me->query("family/family_name") == "古墓派" && (int)me->query_temp("jm_gumu5")) {
    message("vision", HIG "杨过说道：可惜绝情丹只有半颗，姑姑情花之毒未能全解。\n" NOR, me);
    message("vision", HIG "杨过说道：哎......\n" NOR, me);
    message("vision", HIG "杨过说道：有一日，姑姑不见了。我找遍终南山，只在断肠崖发现了姑姑留言。\n" NOR, me);
    me->set_temp("jm_gumu6", 1);
  } else {
    message("vision", HIC "杨过说道：那是害人的玩意，你问这个干什么？\n" NOR, me);
  }
  return 1;
}
void attempt_apprentice(object ob) {
  mapping fam = ob->query("family");
  //	if (!fam || fam["family_name"] != "古墓派" || fam["generation"]!=5)	//没必要是5代弟子
  if (!fam || fam["family_name"] != "古墓派") {
    command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
    return;
  }
  if ((int)ob->query_skill(
    "yunv-xinjing",
    1
  ) < 1000 && (int)ob->query_skill("yunv-xinfa", 1) < 1000) {
    command("say 内功是古墓武功之基础。");
    command("say " + RANK_D->query_respect(ob) + "是否还应该先在内功上多下点功夫？");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    command("say 是否应该去江湖中多加磨炼。");
    return;
  }
  if ((int)ob->query("str", 1) < 30) {
    command("say 我的重剑剑法都要极高的臂力才能使用。");
    return;
  }
  if ((int)ob->query("con", 1) < 30) {
    command("say 黯然销魂首重内功，因此根骨非常重要。");
    return;
  }
  if ((int)ob->query("per", 1) < 25) {
    command("say 我古墓派无不是俊美之人。");
    return;
  }
  if (ob->query("gender") != "男性") {
    command("say 我可只收男徒，你去找吾妻龙儿试试吧。");
    return;
  }
  command("say 嗯，看你还是个学武的料，我就收下你吧！");
  command("chat 古墓武功重现江湖，" + ob->name() + "可别让为师看走眼了！");
  command("chat* pat " + ob->query("id"));
  command("recruit " + ob->query("id"));
  ob->set("title", "古墓派神雕侠侣传人");
  ob->set("class", "sworder");
}

//铁掌帮-挑战杨过
int accept_fight(object ob) {
  object me = this_object();

  if (!ob->query_temp("jm_tiezhang2")) return 1;
  remove_call_out("checking");
  call_out("checking", 1, me, ob);
  if (ob->query_temp("jm_tiezhang2")) ob->set_temp("jm_fight", 1);
  return 1;
}
int checking(object me, object ob) {
  int my_max_qi, his_max_qi;
  my_max_qi = me->query("max_qi");
  his_max_qi = ob->query("max_qi");

  if (!present(ob, environment())) return 1;
  if (((int)ob->query("qi") * 100 / his_max_qi) < 50 && (string)ob->query("family/family_name") == "铁掌帮" && ob->query_temp("jm_tiezhang2")) {
    message_vision(HIY "杨过哈哈一笑，当年雪夜一战，裘千仞铁掌掌力确实威猛，不过你嘛还未得掌法三味！\n" NOR, ob);
    //		ob->delete_temp("jm_tiezhang2");
    ob->delete_temp("jm_fight");
    return 1;
  }
  if (((int)me->query("eff_qi") * 100 / my_max_qi) < 40 && (string)ob->query("family/family_name") == "铁掌帮" && ob->query_temp("jm_tiezhang2")) {
    message_vision(HIR "杨过师笑道：昔日铁掌帮裘千仞不修仁义，被洪老帮主呵斥，故此败北。\n" NOR, ob);
    message_vision(HIR "杨过说道：这位" + RANK_D->query_respect(ob) + "恐怕未能吸取裘千仞的教训！\n" NOR, ob);
    //		ob->delete_temp("jm_tiezhang2");
    ob->delete_temp("jm_fight");
    return 1;
  }
  if (((int)me->query("qi") * 100 / my_max_qi) <= 50 && ((int)me->query("eff_qi") * 100 / my_max_qi) >= 40 && (string)ob->query("family/family_name") == "铁掌帮" && ob->query_temp("jm_tiezhang2")) {
    command("say 铁掌震乾坤，果然不弱于人！\n");
    message_vision(HIC "杨过微微一笑道：如今我与姑姑团聚，这黯然销魂掌未能发挥黯然销魂意境，\n"
      "故敌不过铁掌。然我心愿达成，这虚名于我如浮云。\n" NOR, ob);
    ob->delete_temp("jm_tiezhang2");
    ob->delete_temp("jm_fight");
    ob->set_temp("jm_tiezhang4", 1);
    return 1;
  }
  if (me->is_fighting()) {
    call_out("checking", 3, me, ob);
    return 1;
  }
  return 1;
}

int accept_object(object me, object ob) {
  if ((string)ob->query("id") == "jueqing dan") {
    if ((int)me->query_temp("jm_gumu4") && (string)me->query("family/family_name") == "古墓派" && me->query("id") == ob->query("owner")) {
      message_vision(HIC "杨过说道：这颗黑不拉几，腥臭无比的东西能解情花之毒？\n" NOR, this_object(), me);
      message_vision(HIC "杨过说道：咦！这怎么是半颗？先给姑姑服下吧。\n" NOR, this_object(), me);
      message_vision(HIG "只见小龙女服下你送来的丹药，脸上一片潮红，吐出一口鲜血。\n" NOR, this_object(), me);
      message_vision(HIG "小龙女说道：体内之毒已去除大半，但丹田内仍残留余毒，恐怕是没有办法了。\n" NOR, this_object(), me);
      me->set_temp("jm_gumu5", 1);
      return 1;
    } else {
      message_vision(HIY "$N对$n说道：绝情丹？这是害人的东西吧，还是我收起来吧，免得流传出去了。\n" NOR, this_object(), me);
      return 1;
    }
  }
  if ((string)ob->query("id") == "hantan baiyu") {
    if ((int)me->query_temp("jm_gumu6") && (string)me->query("family/family_name") == "古墓派") {
      message_vision(HIC "杨过说道：没想到姑姑当年并不是跟随南海神尼而去，竟然是在这断肠崖下面生活了十六年！\n" NOR, this_object(), me);
      message_vision(HIC "杨过说道：十六年离别之苦。\n" NOR, this_object(), me);
      message_vision(
        HIM "问世间，情为何物？直教生死相许。天南地北双飞客，老翅几回寒暑。欢乐趣，离别苦，就中更有痴儿女。\n" NOR,
        this_object(),
        me
      );
      message_vision(HIG "小龙女说道：这十六年在寒潭谷底，依靠这种鱼，没想到情花之毒就慢慢的解了。\n" NOR, this_object(), me);
      message_vision(HIG "杨过说道：十六年终得团聚，不负如来不负卿。\n" NOR, this_object(), me);
      me->set_temp("jm_gumu7", 1);
      return 1;
    } else {
      message_vision(HIY "$N对$n说道：这是什么鱼？还是炖汤喝了吧。\n" NOR, this_object(), me);
      return 1;
    }
  }
  return 0;
}
