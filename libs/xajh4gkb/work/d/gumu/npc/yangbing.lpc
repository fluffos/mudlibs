//xln.c 小龙女
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  int jibie;
  jibie = 3000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set_name("杨冰", ({ "yang bing", "yang", "bing" }));
  set("title", "神雕后人");
  set("nickname", HIC "玉女冰心" NOR);
  set("long", "她清丽异常，身穿鹅黄色轻纱，如朦胧月色。\n");
  set("gender", "女性");
  set("age", 39);
  //	set("attitude", "friendly");	
  set("per", 40);
  set("str", 24);
  set("dex", 23);
  set("con", 20);
  set("int", 24);
  set("shen", 20000);
  set("wuyongjiali", 13000);
  set("max_qi", 2500000);
  set("max_jing", 1060000);
  set("neili", 3050000);
  set("max_neili", 750000);
  set("combat_exp", 24000000);
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("whip", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianluo-diwang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("meinv-quanfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunv-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yinsuo-jinling", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunv-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunv-xinjing", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "yunv-xinjing");
  map_skill("dodge", "yunv-shenfa");
  map_skill("unarmed", "meinv-quanfa");
  map_skill("sword", "yunv-jianfa");
  map_skill("parry", "yunv-jianfa");
  map_skill("whip", "yinsuo-jinling");
  create_family("古墓派", 5, "神雕后人");

  setup();
  carry_object("/clone/weapon/golden_sword")->wield();
  carry_object("/d/gumu/obj/yinsuo")->wield();
  carry_object("/d/gumu/obj/buxue1")->wear();
  carry_object("/d/gumu/obj/qun1")->wear();
}

void attempt_apprentice(object ob) {
  mapping fam = ob->query("family");
  if (!fam || fam["family_name"] != "古墓派") {
    command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
    return;
  }

  if ((int)ob->query_skill(
    "yunv-xinjing",
    1
  ) < 150 && (int)ob->query_skill("yunv-xinfa", 1) < 150) {
    command("say 我古墓武功内功是基础。");
    command("say " + RANK_D->query_respect(ob) + "是否还应该先在内功上多下点功夫？");
    return;
  }

  if (ob->query("int", 1) < 25) {
    command("say 我的武功都要极高的悟性才能学会。");
    command("say 要能达到炉火纯青之境，体质什么的倒是无关紧要，悟性却是半点也马虎不得。");
    command("say 这位" + RANK_D->query_respect(ob) + "的悟性还大有潜力可挖，还是请回吧。");
    return;
  }
  if (ob->query("dex", 1) < 25) {
    command("say 我派武功对身法要求极高。");
    command("say 要能达到炉火纯青之境，身轻如燕是很有必要的。");
    return;
  }
  if ((int)ob->query("per", 1) < 25) {
    command("say 我古墓派都是美女如云。");
    return;
  }
  if (ob->query("gender") != "女性") {
    command("say 我可只收女弟子。");
    return;
  }
  command("say 嗯，看你还是个学武的料，我就收下你吧！");
  command("recruit " + ob->query("id"));
  return;
}
