// dongkou.c By River 98/09

inherit ROOM;
#include <ansi.h>
string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});

void create() {
  set("short", HIY "终南山玉洞" NOR);
  set("long", @LONG
这是终南山活死人墓深处的一个玉洞，洞内全部由玉石构成，四周不知道是什么
人用神剑削成玉璧，洁白无瑕。玉璧刻有无数美女，栩栩如生。左侧刻有不少玉
女呼吸吐纳之图，右侧刻有不少玉女舞剑之图。在离洞口处，刻有文字“林朝英悟
剑于此”。然来古墓派创派祖师的武功俱出自于此。你可以尝试参悟（canwu），
或许能将古墓武功融会贯通。

LONG
  );

  set("exits", ([
    "out": __DIR__ "shanxia",
  ]));

  set("outdoors", "古墓");

  setup();
}

void init() {
  add_action("do_canwu", "canwu");
}


int do_canwu(string arg) {
  object me = this_player();

  string *poem = ({
    "第一式：拜别玄都：真晶射宇通神路，玉女合掌拜玄都。此去再演三千妙，何日行满返瑶台。",
    "第二式：瑶台演真：现金华，摩尼顶，玄光漠漠照大千。忽架长虹凌云渡，彩霞片片舞碧空。",
    "第三式：俯察三界：擎天一柱镇三界，武法通神演大罗。真武大道原非刹，慈悲在心拯迷途。",
    "第四式：金台承密：彤云散尽见玄珠，光影化银透九重。天地神炉幽微象，个中真意仔细研。",
    "第五式：玄音初显：混纯初开神水潮，璇玑停轮弄三弦。拨开云雾青天现，长教身心合此玄。",
    "第六式：闻音起舞：云鬓高高态宛约，踢尽花雨星斗横。从来无象从来静，天真和煦舞翩翩。",
    "第七式：朝真拜祖：此身本自庄严界，拜祖朝真见本原。金莲台上承密意，法雨欢腾洒大千。",
    "第八式：玉女扬波：劈开乾坤现此形，琴心三叠可返婴。今我初游三摩地，捧出光华列众真。",
    "第九式：玉女怀真：皓月一轮照西川，沦海回望万里平。琼阁仙山今何在，休认地乡是故乡。",
    "第十式：玉女临凡：含机藏尽势巍然，空中隐陈百万兵。古壁振然存宝录，群魔荡尽真主临。",
    "第十一式：月色清姿：天高云淡月色清，润我华身启我灵。　久照久寂成乾象，金质玉柱向中流。",
    "第十二式：沦海翻波：坎地弄潮春水生，仿佛海底现光明。只因浩气彻天地，破浪凌霄一羽轻。",
    "第十三式：玄音密律：九天渺渺起玄音，宛转悠扬印心田。此曲只应天上有，人间哪得几回闻。",
    "第十四式：一柱攀天：倒踢金冠破万关，气化上冲贯斗牛。海到尽头舟作岸，身登绝顶我为峰。",
    "第十五式：凤栖中宫：身住中宫作凤栖，守一抱元默默存。一粒丹砂藏世界，芥子虽小纳须弥。",
    "第十六式：心灯证吾：日月合壁光明地，心灯长照真光定。真处假我谁为主，真空漠然两相忘。",
    "第十七式：华光外现：昨霄红光透青霭，丹成剑气夜烛天。餐英漱玉浣凌带，雪撒琼花尽现华。",
    "第十八式：乳燕翻飞：谁持彩练当空舞，板桥功深燕穿云。疾飞恰似流星逝，从此超迈不同群。",
    "第十九式：紫阳显象：祥云五色聚英华，紫阳一指现刚威。曾经三界掌善恶，法乘天地退诸邪。",
    "第二十式：乘鸾跨凤：龙虎战罢潮水平，湛然照见大道机。同赏江天秋月白，跨凤乘鸾显高真。",
    "第二十一式：宝相呈真：神龙出水吐瑞珠，盘空飞举现此华。四夷宾服万神汇，三十六宫都是春。",
    "第二十二式：霓裳逍遥：日精月魄元贞道，中有神气专至柔。多少霓裳羽衣曲，唱尽仙歌乐逍遥。",
    "第二十三式：倒坐金莲：玉女倒坐金莲台，玄机错运颠倒颠。壶中天地长如醉，复看环中我是谁。",
    "第二十四式：元真证吾：肩挑明月跨莲坐，静听真吾说三生。上穷碧落星辰逝，下视红尘世界遥。",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫参悟玉女图。\n");
  if (!me->query_temp("jm_gumu10"))
    return notify_fail("你未得到林朝英侍女的指点，是如何进入到这玉女洞中的。\n");
  if (me->query("jm/gumu"))
    return notify_fail("你已经完全参透了这玉女图，自此古墓武学融会贯通，不需要在这领悟了。\n");
  if (me->query("family/family_name") != "古墓派")
    return notify_fail("不是古墓派传人，如何能进入这玉女洞中的？\n");

  if (me->query_skill("yunv-xinfa", 1) < 1000 && me->query_skill("yunv-xinjing", 1) < 1000) {
    tell_object(me, "你的玉女内功.......\n");
    return 1;
  }
  if (me->query_skill("yunv-shenfa", 1) < 2000) {
    tell_object(me, "你的玉女身法.......\n");
    return 1;
  }
  if (me->query("jingli") < 1000) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }

  tell_object(me, HIW "你按左侧玉女图默运玉女经，按右侧玉女图舞剑......\n" NOR);
  message_vision("" + (order[random(13)]) + "" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -500);
  me->start_busy(2);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/gumu", 1);
    me->add("family_score", 1);
    tell_object(me, HIB "你突然醒悟道：" HIY "原来玉女经如此的博大精深" HIR "！\n" NOR);
    tell_object(me, HIB "恭喜你融汇贯通了古墓派武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在终南山古墓玉洞参悟玉女图，将古墓派武功融会贯通！\n" NOR,
      users()
    );
  }
  return 1;
}
