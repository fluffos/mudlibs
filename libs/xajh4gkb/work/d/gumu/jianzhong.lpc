// jianzhong.c

inherit ROOM;
#include <ansi.h>
string jianzhong(object);
void create()
{
    set("short", HIW"剑冢"NOR);
    set("long", @LONG
搬开冢上石块，露出并列著的三柄长剑。在第一、第二两把剑之间，另有
一块长条石片。三柄剑和石片并列於一块大青石之上。  
LONG
        );   
    set("item_desc", ([
        "jianzhong" : (: jianzhong :),
    ]));
    setup();
}
string jianzhong(object me)
{
    object where = environment(me);
	if(where->query_temp("temp_bihua")<1)
    {
		me->set_temp("bi_hua",1);
        return  "你心中一动：「独孤前辈身具绝世武功，说不定留下甚麽剑经剑谱之类。」\n";
    }
    return "搬开冢上石块后，露出并列著的三柄长剑，在第一、第二两把剑之\n"+
"间，另有一块长条石片。三柄剑和石片并列於一块大青石之上。\n"+
"石上刻字：\n\n"+
"        弱 凌       误 紫       四 重       渐 草 四\n"+
"        冠 厉       伤 薇       十 剑       进 木 十\n"+
"        前 刚       义 软       岁 无       于 竹 岁\n"+
"        以 猛       不 剑       前 锋       无 石 後\n"+
"        之          祥          恃          剑 均\n"+
"        与 无          三       之 大       胜 可 不\n"+
"        河 坚       乃 十       横 巧       有 为 滞\n"+
"        朔 不       弃 岁       行 不       剑 剑 于\n"+
"        群 摧       之 前       天 工       之    物\n"+
"        雄          深 所       下          境 自\n"+
"        争          谷 用                      此\n"+
"        锋                                     精\n"+
"                                               修\n";

}
void init()
{
	add_action("do_think", "bihua");
	add_action("do_move", "move");
	add_action("do_tui", "tui");
}
int do_move(string arg)
{
	object me = this_player(),where = environment(me);

	if (me->is_busy() || me->is_fighting())	
		return notify_fail("你正忙着呢！\n");
	if (arg != "stone") 
	{
		write("你想做什么？\n");
		return 1;
	}

	message_vision("但见$N搬开石块，露出一块光滑的大青石。\n", me);
	if(!me->query_temp("bi_hua"))
	{
		message_vision("你试图搬开大青石，哪知一柄软剑弹出来，正插在你的胸口......\n",me);
		me->die();
		return 1;
	}
	where->set_temp("temp_ban", 1);
	message_vision("大青石上似乎有些图案，或许可以领悟到什么。\n", me);
}
int do_think(string arg)
{
	object me = this_player(),where = environment(me);
	object weapon;
	int pot;
	pot = me->query_int();
	weapon = me->query_temp("weapon");

	if (me->is_busy() || me->is_fighting())	
		return notify_fail("你正忙着呢！\n");
 
	if (arg != "qingshi" ) 
	{
		write("你想做什么？\n");
		return 1;
	}
	if(where->query_temp("temp_ban")<1)
        return notify_fail("大青石上面有不少石块呢，你看得清楚吗？\n");
	if ( !me->query_temp("jm_dugu_afei") || !me->query_temp("jm_dugu_feng"))
	{
		message_vision("你恐怕未得到风前辈和剑魔阿飞的指点吧。\n", me);
		return 1;
	}
	
	where->set_temp("temp_bihua", 1);
	message_vision("你手捻剑诀，对着青石若有所思。\n", me);

	if (!weapon || weapon->query("skill_type") != "sword")
	{        
		write("你对着大青石比划了一阵，感到劲疲力尽。\n");
		return 1;
	}
	if ( me->query_skill("lonely-sword",1)<=50 && weapon->query("id") != "ziwei ruanjian")
	{
		write("你想领悟独孤九剑的基础剑式，只能使用紫薇软剑。\n");
		return 1;
	}
	if ( me->query_skill("lonely-sword",1)>50 && me->query_skill("lonely-sword",1)<=100 && weapon->query("id") != "xuantie zhongjian")
	{
		write("你想要进一步领悟独孤九剑的基础剑式，需要使用玄铁重剑。\n");
		return 1;
	}
	if ( me->query_skill("lonely-sword",1)>100 && me->query_skill("lonely-sword",1)<=150 && weapon->query("id") != "mu jian")
	{
		write("你想要更深一步领悟独孤九剑的基础剑式，恐怕只能使用木剑了。\n");
		return 1;
	}
	
	if (me->query("neili") < 1000) 
	{
		write("你的内力不足，无法继续练下去。\n");
		return 1;
	}
	if (me->query("qi") < 1000) 
	{
		write("你已经不行了，无法继续练下去。\n");
		return 1;
	}
 	if (me->query("jing") < 1000) 
	{
		write("你精力不足，无法继续练下去。\n");
		return 1;
	}
	if ( me->query_skill("lonely-sword",1)<=50)
	{
		if(!me->query_temp("dugu/ziwei"))
		{
			message_vision("你并未得到独孤前辈在剑冢留下的轻剑剑意。\n",me);
			return 1;
		}
		me->improve_skill("lonely-sword", pot/10);
		message_vision("$N用"+weapon->name()+"按照大青石上的图案比划了一阵，手中的"+weapon->name()+"呼呼有声。\n",me);
		message_vision(HIY"「凌厉刚猛，无坚不摧，弱冠前以之与河朔群雄争锋。」\n"NOR,me);
		write("你从中领悟了一些独孤九剑的窍门。");
		me->receive_damage("qi", 400);
		me->add("neili", -400);
		me->add("jing",-400);
		return 1;
	}
	else if ( me->query_skill("lonely-sword",1)<=100)
	{
		if(!me->query_temp("dugu/xuantie"))
		{
			message_vision("你并未得到独孤前辈在剑冢留下的重剑剑意。\n",me);
			return 1;
		}
		me->improve_skill("lonely-sword", pot/10);
		message_vision("$N用"+weapon->name()+"按照大青石上的图案比划了一阵，手中的"+weapon->name()+"变化多端。\n",me);
		message_vision(HIY"「重剑无锋，大巧不工。四十岁前恃之横行天下。」\n"NOR,me);
		write("你从中领悟了一些独孤九剑的窍门。");
		me->receive_damage("qi", 500);
		me->add("neili", -500);
		me->add("jing",-500);
		return 1;
	}
	else if ( me->query_skill("lonely-sword",1)<=150)
	{
		me->improve_skill("lonely-sword", pot/10);
		message_vision("$N用"+weapon->name()+"按照大青石上的图案比划了一阵，手中的"+weapon->name()+"变幻莫测。\n",me);
		message_vision(HIY"「四十岁後，不滞於物，草木竹石均可为剑。自此精修，渐进於无剑胜有剑之境。」\n"NOR,me);
		write("你从中领悟了一些独孤九剑的窍门。");
		me->receive_damage("qi", 600);
		me->add("neili", -600);
		me->add("jing",-600);
		return 1;
	}
	else if ( me->query_skill("lonely-sword",1)>150)
	{
		me->set("jm_dugu/dugu2",1);
		message_vision("$N用"+weapon->name()+"按照大青石上的图案比划了一阵，手中的"+weapon->name()+"寂然无声。\n",me);
		write("大青石上的内容对你来说已经太肤浅，你已经无法再在这里领悟独孤前辈留下的绝世剑法了！\n");
		if(me->query("jm_dugu/dugu1") && me->query("jm_dugu/dugu2"))
		{
			me->delete("jm_dugu");
			me->set("jm/dugu",1);
			tell_object(me,HIB"恭喜你融汇贯通了独孤九剑的精髓！\n"NOR);
			message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，将独孤前辈的独孤九剑融会贯通！\n"NOR,users() );
		}		
		return 1;
	}
}
