//玄铁剑-名器

#include <weapon.h>
#include <ansi.h>

inherit SWORD;
inherit F_UNIQUE;

void create() {
  set_name(HIB "玄铁剑" NOR, ({ "xuantie jian", "xuantie", "jian", "sword" }));
  set_weight(35000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("icon", "10023");
    set("value", 1);
    set("unique", 1);
    set("rigidity", 8);
    set("material", "steel");
    set("weapon_prop/dodge", 5);
    set("weapon_prop/constitution", 10);
    set("weapon_prop/strength", 15);
    set("weapon_prop/sword", 50);
    set("weapon_prop/parry", 20);
    set("treasure", 1);
    set("wield_neili", 1500);
    set("wield_maxneili", 2000);
    set("wield_str", 28);
    set("wield_msg", HIB "$N嗡的一声从背后抽出玄铁重剑，但见寒气逼人，方圆之内轰然雷声滚滚，肃杀万分。\n" NOR);
    set("long", "此剑长七尺，由万年玄铁所铸，沉重无比，无锋无刃，却杀气森然，实乃天下第一神兵。\n");
    set("unwield_msg", HIB "$N将玄铁剑插回肩后，杀气顿减。\n" NOR);
  }
  init_sword(500, 2);
  setup();
}

int query_autoload() { return 1; }
