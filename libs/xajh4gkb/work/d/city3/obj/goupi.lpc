// goupi.c

#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("狗皮", ({ "gou pi", "pi" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("material", "fur");
		set("value", 300);

        }
        setup();
}

int query_autoload() { return 1; }