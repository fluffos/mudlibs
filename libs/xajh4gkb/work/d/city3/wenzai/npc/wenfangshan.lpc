//bye enter

#include <ansi.h>

inherit NPC;

void create() {
  int jibie;
  jibie = 3000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("温方山", ({ "wen fangshan", "wen" }));
  set("gender", "男性");
  set("title", "温家老三");
  set("age", 45);
  set("long",
    "这位便是温家老三：温方山。\n");
  set("combat_exp", 1000000);

  set("attitude", "heroism");

  set("str", 30);
  set("con", 25);
  set("int", 20);
  set("dex", 30);

  set("max_qi", 500);
  set("eff_qi", 500);
  set("qi", 500);
  set("max_jing", 200);
  set("jing", 200);
  set("neili", 500);
  set("max_neili", 500);
  set("wuyongjiali", 30);
  set("shen_type", 0);
  set("chat_chance", 15);
  set("inquiry", ([
    "金蛇郎君": "夏雪宜这个大淫贼，我一定要把他碎尸万断！",
    "温仪": "这个小丫头中了邪了，被我关了起来，我也是为她好啊。",
  ]));

  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);

  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuhu-duanmendao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taizu-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wenrou-jian", 500 + jibie / 3 + random(jibie / 5));
  map_skill("sword", "wenrou-jian");
  map_skill("blade", "wuhu-duanmendao");
  map_skill("unarmed", "taizu-quan");

  setup();

  carry_object("/clone/weapon/gangjian")->wield();
  carry_object("/clone/armor/tiejia")->wear();
}
