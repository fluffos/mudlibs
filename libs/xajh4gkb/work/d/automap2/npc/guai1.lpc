    me->set("qi",        (int)hp_status["max_qi"]);
    me->set("max_jing",  (int)hp_status["max_jing"]);
    me->set("eff_jing",  (int)hp_status["max_jing"]);
    me->set("jing",      (int)hp_status["max_jing"]);
    me->set("max_neili", (int)hp_status["max_neili"]);
