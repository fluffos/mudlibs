	if ( hp_status["combat_exp"] < 1500000000)
		me->set("combat_exp", (int)((hp_status["combat_exp"]/4)*5));
	else
		me->set("combat_exp", 2100000000);
	//____________________________状态复制完毕_____________________________
    // 没有技能可复制
	if ( !(skill_status = ob->query_skills()) ) return;
	
	sname = keys(skill_status);
    for ( i=0; i<sizeof(skill_status); i++ )
	{
		me->set_skill(sname[i], skill_status[sname[i]]);
    }
    // 没有激发技能可复制
	if ( !(map_status = ob->query_skill_map()) ) return;

	//卸除激发技能
    me->map_skill("unarmed");
    me->map_skill("dodge");
    me->map_skill("parry");
	me->map_skill("sword");
	me->map_skill("force");
	me->map_skill("blade");
    
	mname  = keys(map_status);
    for(i=0; i<sizeof(map_status); i++) 
	{
		me->map_skill(mname[i], map_status[mname[i]]);
    }
*/
}
//绿林强盗爆率  试练迷窟  10%几率爆1星、2星装备；5%几率爆强化符；5%几率爆X之光系列宝石
void die() {
  object ob, me, corpse, baoshi, env;
  string room, name;
  int m, k1, k2, k3;
  int flag, xingyun;
  flag = 1;
  xingyun = 0;
  ob = this_object();

  // 先绑定到打晕的对象上
  if (!objectp(me = ob->query_temp("last_unconcious_from")))
    me = ob->query_temp("last_damage_from");  // 绑定到最后伤害对象

    if (!objectp(me)  // 未成功绑定 
    || !objectp(env = environment(ob))
      || !stringp(room = env->query("short"))) {
      ::die();
      return;
    }

  if (me) {
    m = 500000 + random(500000);

    if (interactive(me)) {
      message_vision(
        HIG "\n$N杀死了 " + ob->name(1) + HIG " ，奖励了 " HIM + (me->query_exp_times() * m) + HIG " 点经验和 " HIY + (m / 10) + HIG " 潜能。\n" NOR,
        me
      );
      //message("party", HIG"【寂静之森】"+HIC+me->name(1)+HIW" 杀死了 "+ob->name(1)+HIW" ，奖励了 "HIM+(me->query_exp_times()*m)+HIW" 点经验和 "HIY+(m/10)+HIW" 潜能。\n"NOR,users() );	
      me->add("combat_exp", m, 1);
      me->add("potential", m / 10, 1);
      me->add("score", 20, 1);
      if (me->query("xyhy_type") == 2) flag = 5 / 4;
      if (me->query_temp("wupin_max_add")) xingyun = (int)me->query_temp("wupin_max_add", 1);  //处于幸运状态时
    }
  }

  if (objectp(corpse = CHAR_D->make_corpse(ob, me)))
    corpse->move(environment(ob));
  // 绑定到对象，冷冻一分钟
  corpse->set("valid_get_from", me->query("id"));

  k1 = 30 * flag;  //装备爆率
  k2 = 120 * flag;  //强化符爆率
  k3 = 30 * flag;  //宝石爆率
  //2018.3.20阿飞改，第4版不爆下列装备
  /*		if ( objectp(me) && objectp(ob) && 1000 < k1*(100+xingyun)/100 )
		{						
			if (random(2)==0) 
			{
				baoshi = new("/clone/tzbox/two-box");
			} else
			{
				baoshi = new("/clone/tzbox/wp2-box");
			}
			name = baoshi->name(1);		
            message_vision(HIG"\n$N在 "HIY+ob->name(1)+" 的尸体上发现了 "HIW+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,  me);	//2016.6.15阿飞改，增加显示物品的id		
		    message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "HIM+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
			baoshi->move(corpse);
		}
		if ( objectp(me) && objectp(ob) && 1000 < k2*(100+xingyun)/100 )
		{						
			baoshi = new("/clone/map/obj/qianghua-fu");			
			name = baoshi->name(1);		
            message_vision(HIG"\n$N在 "HIY+ob->name(1)+" 的尸体上发现了 "HIW+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,  me);	//2016.6.15阿飞改，增加显示物品的id		
//		    message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "HIM+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
			baoshi->move(corpse);
		}*/
  if (objectp(me) && objectp(ob) && random(20000) < k3 * (100 + xingyun) / 100) {
    baoshi = new(random_item1[random(sizeof(random_item1))]);
    name = baoshi->name(1);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id		
    message(
      "party",
      HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " HIM + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      users()
    );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }
  if (objectp(me) && objectp(ob) && random(100000) < 100 * (100 + xingyun) / 100) {
    baoshi = new("/clone/suit/menpai/card2/menpai" + (1 + random(45)));
    name = baoshi->name(1);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );
    message(
      "party",
      HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " HIM + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      users()
    );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }
  if (objectp(me) && objectp(ob) && random(100000) > (100000 - 100 * (100 + xingyun) / 100)) {
    if (random(3) == 0) {
      switch (random(3)) {
        case 0: baoshi = new("/clone/tzbox/xiepai0-box");
        break;
        case 1: baoshi = new("/clone/tzbox/zhengpai0-box");
        break;
        case 2: baoshi = new("/clone/tzbox/zhongli0-box");
        break;
      }
    } else {
      switch (random(3)) {
        case 0: baoshi = new("/clone/tzbox/xiepai1-box");
        break;
        case 1: baoshi = new("/clone/tzbox/zhengpai1-box");
        break;
        case 2: baoshi = new("/clone/tzbox/zhongli1-box");
        break;
      }
    }
    name = baoshi->name(1);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );
    message(
      "party",
      HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " HIM + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      users()
    );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }

  COMBAT_D->announce(ob, "dead");
  destruct(ob);
  return;
}

int do_go(string arg) {
  object me, ob, *killer;

  me = this_object();
  ob = this_player();

  if (!objectp(ob)) return 0;

  killer = ob->query_enemy();

  if (playerp(ob) && arrayp(killer) && sizeof(killer) > 3 && random(10) <= 5) {
    message_vision(YEL "$N见势不好，转身要走，被$n" + YEL + "一把拦在面前。背后拉我一票兄弟还想走？没那么容易！\n" NOR, ob, me);
    if (!ob->is_busy()) ob->start_busy(1);
    return 1;
  }

  return 0;
}
