void create() {
  int i, index, jibie;
  mapping mp;
  string *basic = ({
    "poison",
    "force",
    "dodge",
    "parry",
    "unarmed",
    "hand",
    "finger",
    "strike",
    "magic",
    "spells",
    "cuff",
    "claw",
    "taoism",
    "sword",
    "blade",
    "club",
    "staff",
    "hammer",
    "throwing",
    "axe",
    "whip",
    "dagger",
    "spear",
    "fork",
    "stick"
  });
  index = random(sizeof(menpai));
  mp = menpai[index];
  jibie = 1000;

  seteuid(getuid());
  set_name(HIG "绿林强盗" NOR, ({ "lvlin qiangdao", "lvlin", "qiangdao" }));
  set("title", HIY "绿林蛮汉" NOR);
  set("gender", "男性");
  set("icon", "30002");
  set("age", random(30) + 20);
  set("long", "活动在试炼迷窟的强盗，专打劫经由这里的人们做些无本生意。\n");
  set("attitude", "aggressive");
  set("class", "lvlin");
  set("no_suck", 1);
  //	set("no_zhineng", 1);
  set("env/wimpy", 10);
  set("shen_type", 0);
  set("xyzx_sys/level", jibie * 9 / 10 + random(jibie * 2 / 10));  //2016.5.22阿飞调整NPC属性
  create_family("绿林暴风盟", 3, "弟子");

  if (!query("wugong", 1)) {
    if (mp["gender"]) set("gender", mp["gender"]);
    /*		if (mp["family"]) 
		{
			set("famile/family_name",mp["family"]);
			set("famile/generation",100);
		}*/
    if (mp["family"]) create_family(mp["family"], 100, "弟子");
    for (i = 0; i < sizeof(keys(mp)); i++) {
      if (keys(mp)[i] == "knowledge") set_skill(
        mp[keys(mp)[i]],
        500 + jibie / 2 + random(jibie / 2)
      );
      if (member_array(keys(mp)[i], basic) != -1) {
        set_skill(keys(mp)[i], 500 + jibie * 2 + random(jibie / 2));
        set_skill(mp[keys(mp)[i]], 500 + jibie / 2 + random(jibie / 2));
        map_skill(keys(mp)[i], mp[keys(mp)[i]]);
      }
    }
    set("wugong", 1);
  }

  set("chat_chance", 3);
  set("chat_msg", ({
    (: random_move :)
  }));

  setup();
  if (!query("wuqi", 1)) {
    if (mp["weapon"]) carry_object(mp["weapon"])->wield();
    set("wuqi", 1);
  }
  carry_object("/clone/cloth/hanbing-jia")->wear();
  add_money("gold", 10 + random(jibie / 2));

}

void init() {
  object ob, me;
  //	object get_ob;
  //	int i, level, is_time;
  //	mapping skill_status, map_status, hp_status;
  //  string *sname, *mname;

  me = this_object();
  ob = this_player();

  // 怪物必须是可以动作的，并只针对玩家
  if (!objectp(ob) || !living(me) || !playerp(ob)) return;
  // 见面就杀
  me->kill_ob(ob);
  // 拦路
  add_action("do_go", "go");
  // 跟随
  command("follow " + ob->query("id"));
  /*
