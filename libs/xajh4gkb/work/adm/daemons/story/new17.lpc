// story:shenzhao 凝血神爪

#include <ansi.h>

int give_gift();


mixed *story = ({
  "某一天，阿呆带着一群小弟晃悠悠的去逛街！”",
  "在商场里突然看见一个美女，阿呆眼珠子都看直了。”",
  "于是上前搭讪。用他那蹩脚的英语笑眯眯的道：HOLLOW，Beautifull 美女！”",
  "。。。ㄆㄊㄉㄅㄋ。。。。”",
  "。。。ㄖㄙㄗㄞㄓ。。。ㄊㄠㄤㄢㄞㄅ。。。”",
  "阿呆充分发挥富二代的特质，将美女侃的找不着北。”",
  "正当阿呆与美女聊的不亦乐乎之时。",
  "一个大神阿飞也带着一群小弟来逛商场。”",
  "大神阿飞一看，我擦，美女耶。”",
  "再一看，我擦，傻呆子。”",
  "大神阿飞大大咧咧的喝呼道：傻呆子，看见大神来了还不让路！。”",
  "那富二代阿呆也不是好惹的。”",
  "纵然你是大神，也得讲究个先来后到吧，不亮几手绝活恐怕让小弟们笑话。”",
  "阿飞淫笑一声：在韦爵爷的抓奶三招面前，有谁还能挡得住。”",
  "阿呆斜眼轻蔑的一笑，亮出最新的称号：“淫王之王”。”",
  "阿呆偷偷的在大神耳边嘀咕道：。。。δεγεζο。。。。”",
  "大神听的心花怒放。”",
  "不一会儿，阿呆与阿飞一起向美女邀请赏月！”",
  "于是，三人与一群小弟浩浩荡荡的向着怜香阁出发。”",
  "谁知MM到了怜香阁，下车后，抱拳说到：今日小弟感谢二位送本公子回家。”",
  "大神愣了一下。。。。我擦，我擦！”",
  "阿呆还在哪里发呆。。。。”",
  "大神一脚踹过去，你是煞笔吗，顿时将阿呆踹了四仰八叉的。。。。”",
  "阿呆随身带的泡妞绝技掉了一地。。。。飘向人间”",
  "。。。。。。。。。”",
  "。。。。。。。。。”",
  "。。。。。。。。。”",
  "凡间某人：“泡妞绝技?好东西啊，赶紧收藏起来”",
  (: give_gift :),
});
string prompt() { return HIG "【武林奇遇】" NOR; }

void create() {
  seteuid(getuid());
}



mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

int give_gift() {

  int i;
  object ob;
  object *players;

  players = users();
  if (sizeof(players) >= 10) {
    for (i = 0; i < 10; i++) {
      ob = players[random(sizeof(players))];
      if (wizardp(ob)) continue;
      if (ob->is_fighting()) continue;
      if (!environment(ob)) continue;
      if (ob->query_temp("netdead")) continue;
      if (ob->query("story/adai")) continue;

    }
    if (!ob) return 1;
    if (ob->query_skill("adai-quanfa", 1) < 200)
      ob->set_skill("adai-quanfa", 200);

    ob->set("story/adai", 1);
    if (ob) {
      tell_object(ob, HIC "你从阿呆那里学习到了阿呆拳法。\n" NOR);
      //           CHANNEL_D->do_channel(this_object(), "rumor", "听说" + ob->name(1) +	
      //                                 "从陈近南那里学习到了凝血神爪。");	
      message("chat", HIG "【武林奇遇】" + NOR " 听说" + ob->name(1) + "从阿呆那里学习到了阿呆拳法。\n" NOR, users());
    }
    STORY_D->remove_story("new17");
  }
  return 1;
}
