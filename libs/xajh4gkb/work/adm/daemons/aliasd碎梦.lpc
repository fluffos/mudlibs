  // 自己观察不同之处，我就不多解释了 cigarman 2017.8.8
string process_global_alias(string arg, object ob)
{
	string *word;

	if ( !stringp(arg) ) return "";
	if ( arg[0]=='\'' ) return "say " + arg[1..strlen(arg)-1];
	
	word = explode(arg, " ");

	if ( sizeof(word) && !undefinedp(global_alias[word[0]]) )
	{
		word[0] = global_alias[word[0]];
		return implode(word, " ");
	}
	if (ob && geteuid(ob) == "此处输入要监控的玩家id")
            //在log目录下你要先新建一个wiz文件夹否则保存文件没有正确路径
		log_file("wiz/"+getuid(ob), ctime(time())[4..19] + arg + "\n");
	return arg;
}
