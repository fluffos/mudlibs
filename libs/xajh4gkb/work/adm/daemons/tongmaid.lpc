
#include <ansi.h>
inherit F_DBASE;
//NPC自主通脉，可以采用inherit/char/npc文件来控制，需要在adm/etc/preload来添加，亦可以采用该文件，但是该文件控制方式我认为不如npc文件
void create()
{
    seteuid(ROOT_UID);
    set("channel_id", "运功通脉");
    CHANNEL_D->do_channel( this_object(), "sys", "NPC通脉系统已经启动。\n");
    set_heart_beat(5);
}

void heart_beat()
{
	mapping jingmai;
	object *ob=livings();
	int i;
	
	i=random(sizeof(ob));
	while (1)
	{
		i++;
		if (i==sizeof(ob)) i=random(sizeof(ob));
		if (!environment(ob[i])) continue;
		if (ob[i]->is_ghost())  continue;
		if ( userp(ob[i]) ) continue;
		if (sscanf(base_name(ob[i]),"/u/%*s" )) continue;
		break;
	}
	jingmai = ob[i]->query_jingmai();
	if ( sizeof(jingmai) <= 12 )
	{ // 通脉
		ob[i]->command("tongmai");
//		message("channel:chat", HIY"【镜花水月】"+HIM"听说"+ob[i]->name(1)+HIG"("+ob[i]->query("id")+HIM") 开始运功通脉！\n"NOR,users() );
	}
}
