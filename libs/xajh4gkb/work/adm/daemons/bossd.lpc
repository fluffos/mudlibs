#include <ansi.h>
#include <localtime.h>
inherit F_DBASE;
int flag1;
int flag2;

string *dirs1 = ({
  "/d/city/guangchang",
  "/d/city2/tian_anm",
  "/d/city3/guangchang",
  "/d/dali/guangchang",
});
string *dirs2 = ({
  "/d/huashan/zhenyue",
  "/d/songshan/luyasi",
  "/d/taishan/shengxian",
  "/d/henshan/sansheng",
  "/d/hengshan/huixiantai",
  "/d/shouxihu/guanyindian",
});
string *worldguai = ({
  "/quest/boss/boss1",
  "/quest/boss/boss2",
  "/quest/boss/boss3",
  "/quest/boss/boss4",
  "/quest/boss/boss5",
  "/quest/boss/boss6",
  "/quest/boss/boss7",
});
string *qiyuguai = ({
  "/kungfu/class/dancer/biyun",
  "/kungfu/class/dancer/feixuan",
  "/kungfu/class/dancer/wuzhao",
});
void create() {
  seteuid(ROOT_UID);
  set("channel_id", "江湖奇遇");
  CHANNEL_D->do_channel(this_object(), "sys", "江湖奇遇系统已经启动。\n");
  set_heart_beat(10);
  flag1 = 0;
  flag2 = 0;
}

void heart_beat() {
  object worldboos, qiyunpc;
  string dir1, dir2;
  mixed *local;
  int time = time();
  worldboos = new(worldguai[random(sizeof(worldguai))]);
  dir1 = dirs1[random(sizeof(dirs1))];
  qiyunpc = new(qiyuguai[random(sizeof(qiyuguai))]);
  dir2 = dirs2[random(sizeof(dirs2))];
  local = localtime(time());
  //	if ( atoi(CHINESE_D->chinese_time(9,ctime(time()))) == 19 )	//这种写法也行，但是不如下面这种写法简洁
  if (local[LT_MIN] == 59 && local[LT_HOUR] == 19) {
    if (!flag1) {
      worldboos->move(dir1);
      flag1 = 1;
      message(
        "channel:chat",
        HIM "【时空穿越】某人：听说" + worldboos->query("name") + "(" + worldboos->query("id") + ")" HIM "穿越时空，重生在当今武林，携带皇族宝物出现在" + dir1->query("short") + HIM "附近！\n" NOR,
        users()
      );
      call_out("del_boss", 3600, worldboos);
    }
  } else flag1 = 0;
  if (local[LT_MIN] == 30 /*&& local[LT_SEC] == 30*/) {
    if (!flag2) {
      qiyunpc->move(dir2);
      flag2 = 1;
      message(
        "channel:chat",
        HIM "【江湖奇遇】某人：听说" + qiyunpc->short() + HIM "游历江湖，出现" + dir2->query("short") + HIM "附近，江湖人士若有武学境界的疑问，可向其请教！\n" NOR,
        users()
      );
      call_out("del_qiyu", 1800, qiyunpc);
    }
  } else flag2 = 0;
}
void del_boss(object worldboos) {
  if (worldboos) {
    message(
      "channel:chat",
      HIM "【江湖传言】某人：听说" + worldboos->query("name") + "(" + worldboos->query("id") + ")携带皇族宝物消失在熙攘的人群中....！\n" NOR,
      users()
    );
    destruct(worldboos);
  }
  flag1 = 0;
}
void del_qiyu(object qiyunpc) {
  if (qiyunpc) {
    message(
      "channel:chat",
      HIM "【江湖传言】某人：听说" + qiyunpc->short() + "在江湖中游历一番后归隐山林....\n" NOR,
      users()
    );
    destruct(qiyunpc);
  }
  flag2 = 0;
}
