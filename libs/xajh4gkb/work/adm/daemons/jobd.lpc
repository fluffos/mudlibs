void create()
{
	seteuid(getuid());
	set("channel_id", "任务精灵");
	set("id", "JOB");
	init_creat_job();
}
void init_creat_job()
{
	CHANNEL_D->do_channel( this_object(), "sys", "门派仇杀加载成功！");
	remove_call_out("get_job");
	call_out("get_job",600);
}
void get_job()
{
	object robot,killer1;
	mapping target;
	object room;
	int j,k;
	target = where[random(sizeof(where))];
	j = random(25)+1;	//取决于quest/haojie/jobnpc的数量
	robot = clone_object("/quest/haojie/jobnpc/"+j);
	if (robot->query("family/family_name") == target["party"])
	{
		j=random(25)+1;
		robot = clone_object("/quest/haojie/jobnpc/"+j);
	}
	if (robot->query("family/family_name") == target["party"])
	{
		j=random(25)+1;
		robot = clone_object("/quest/haojie/jobnpc/"+j);
	}

	if (robot->query("family/family_name") != target["party"])
	{
		message("channel:chat", HIC"\n【门派战争】"+robot->query("family/family_name") + ":众弟子听令!"NOR"。\n", users());
		message("channel:chat", HIC"\n【门派战争】"+robot->query("family/family_name") + ":顺我者生，逆我者亡!"NOR"。\n", users());
		message("channel:chat", HIC"\n【门派战争】"+robot->query("family/family_name") + ":" + target["party"]+"与我派做对，这一次誓必要消灭"+target["party"]+"!"NOR"。\n", users());
		log_file("fight/family_zhan", sprintf("门派战争：%s 攻打 %s on %s\n",robot->query("family/family_name")),target["party"]),CHINESE_D->chinese_time(5,ctime(time()))) );
		write_file(MPFILE,sprintf("%s", robot->query("family/family_name")),1);
		write_file(MPFILEA,sprintf("%s", target["party"]),1);

		remove_call_out("do_dest");
		call_out("do_dest",800,robot);
		for(k=0; k<=5; k++)
		{
			killer1=clone_object("/quest/haojie/jobnpc/"+j);
			killer1->set("hated",target["party"]);
			if( room = find_object(target["where"]+".lpc"))
			{
				CHANNEL_D->do_channel( this_object(), "sys","查找成功，目前"+killer1->query("name")+"在"+file_name(room)+"\n");
				killer1=clone_object("/quest/haojie/jobnpc/"+j);
				killer1->set("hated",target["party"]);
				killer1->move(room);
				killer1->random_move();
			}
			else if(room = load_object(target["where"]+".lpc"))
			{
				CHANNEL_D->do_channel( this_object(), "sys","查找成功，目前"+killer1->query("name")+"在"+file_name(room)+"\n");
				killer1=clone_object("/quest/haojie/jobnpc/"+j);
				killer1->set("hated",target["party"]);
				killer1->move(room);
				killer1->random_move();
			}
		}
	}
}

void do_dest(object robot)
{
    message("channel:chat", HIC"\n【门派战争】"/*+robot->query("family/family_name") +*/"：哼，这次就先放你们一马，下次一定杀得你们鸡犬不留！"NOR"。\n", users());
    destruct(robot);
    remove_call_out("get_job");
    call_out("get_job",3600);
}
