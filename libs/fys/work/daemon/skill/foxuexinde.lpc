// sword.c
#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }
void skill_improved(object me)
{
	if((int)me->query_skill("foxuexinde",1)==40)
	tell_object(me,HIC"你领悟了「天眼通」！(help tyt)\n"NOR);
	if((int)me->query_skill("foxuexinde",1)==60)
	tell_object(me,HIC"你领悟了「醍瑚灌顶」！(help thgd)\n"NOR);
	if((int)me->query_skill("foxuexinde",1)==100)
	tell_object(me,HIC"你领悟了「佛法无边」！(help ffwb)\n"NOR);
}
