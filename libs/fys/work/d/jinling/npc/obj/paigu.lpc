inherit ITEM;
inherit F_FOOD;
#include <ansi.h>

void create() {
  set_name(HIR "椒盐排骨" NOR, ({ "jiaoyan paigu", "paigu" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盘香喷喷的椒盐排骨。\n");
    set("unit", "盘");
    set("value", 3000);
    set("food_remaining", 10);
    set("food_supply", 50);
  }
}
