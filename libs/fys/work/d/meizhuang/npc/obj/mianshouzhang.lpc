// tieshou.c

#include <armor.h>

inherit "/std/weapon/unarmed.lpc";

void create()
{
	set_name("木棉手掌",({"mianshouzhang","mian shouzhang","shouzhang"}));
	set_weight(800);
	if( clonep() )
		set_default_object(__FILE__);
	else {
	set("material","linen");
	set("value",100);
	set("unit","双");
	}
	init_unarmed(5);
	setup();
}
