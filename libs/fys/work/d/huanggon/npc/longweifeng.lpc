#include <ansi.h>

inherit KZZNPC;
inherit F_VENDOR;
string query_save_file() { return DATA_DIR + "npc/龙威风"; }

void create() {
#include <kzznpc.h>
  set("vendor_goods", ([
    "diaopi": __DIR__ "obj/diaopi.lpc",
    "yupei": __DIR__ "obj/yupei.lpc",
    "shouzhuo": __DIR__ "obj/shouzhuo.lpc",
  ]));
  set("area_name", "京城聚宝阁");
  set("area_file", "/d/huanggon/jubaoge.lpc");
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/std/armor/yinjia")->wear();
  add_money("silver", 2);
}
void init() {
  ::init();
  add_action("do_vendor_list", "list");
}
