#include <ansi.h>

inherit KZZNPC;
inherit F_VENDOR;
string query_save_file() { return DATA_DIR + "npc/京千灵"; }

void create()
{
#include <kzznpc.h>
set("vendor_goods",([
"gongyugan":__DIR__"obj/gongyugan.lpc",
"jiangbaoniurou":__DIR__"obj/jiangbaoniurou.lpc",
"jijiaotang":__DIR__"obj/jijiaotang.lpc",
"qiguoji":__DIR__"obj/qiguoji.lpc",
"xiaren":__DIR__"obj/xiaren.lpc",
"zaoliuyupian":__DIR__"obj/zaoliuyupian.lpc",
"zhenjiangyaorou":__DIR__"obj/zhenjiangyaorou.lpc",
]));
set("area_name","京都全聚德");
set("area_file","/d/huanggon/quanjude.lpc");
	setup();
add_money("silver",2);
}
void init()
{
 ::init();
  add_action("do_vendor_list","list");
}