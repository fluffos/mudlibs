inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("紫砂壶", ({ "zisha hu", "hu" }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 300);
    set("max_liquid", 15);
  }
  set("liquid", ([
    "type": "water",
    "name": "普洱茶",
    "remaining": 15,
    "drunk_supply": 10,
  ]));
}
