// Room: /d/suzhou/tianlongge.c

inherit ROOM;
string do_desc();
void create()
{
	set("short", "天龙阁");
	set("long", @LONG
正对大门的是个书架，上面摆着不少书籍。房间两侧是几张半人来高的木桌，
几个小学童正摇头摆脑的高声念唱。一位长衫老者手持戒尺闭目养神，很是悠闲。
听说这位老者屡试不中之后心灰意懒，在家中教书渡日。
LONG
	);
	set("item_desc",([
		"书架" : (: do_desc :),
		"shujia" : (: do_desc :),
]));
	set("book",1);
	set("exits", ([ /* sizeof() == 1 */
		"west" :__DIR__"chengnanjie2",
]));
	set("objects",([
		__DIR__"npc/laoxiucai" :1,
]));
	set("no_clean_up", 0);

	setup();
}
string do_desc()
{
	object me;
	me=this_player();
	if(query("book")==1)	{
		tell_object(me,"书架上放着本“三字经”。\n");
		return "\n";
				}
	tell_object(me,"书架上空空如也！\n");
	return "\n";
}
void init()
{
	add_action("do_get","get");
}
int do_get(string str)
{ 
	string sco,dest;
	object me;
	me=this_player();
	if (!str) return 0;
	if( sscanf(str,"%s from %s",sco,dest)!=2)	{
	return 0;
		}
	if((sco!="book"&&sco!="三字经")||(dest!="书架"&&dest!="shujia"))	    {
		return 0;
		}
	if (query("book")==0)	{
		tell_object(me,"书架上的书已被人拿走了。\n");
		return 1;
				}
	message_vision("$N从书架上拿起一本“三字经”放于袋中。\n",me);
	set("book",0);
	clone_object(__DIR__"npc/obj/sanzijing")->move(me);
	return 1;
}
