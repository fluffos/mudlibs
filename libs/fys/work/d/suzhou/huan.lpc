// Room: /u/oldsix/room1/huan.c

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "湖岸");
  set("long", @LONG
湖面绿波荡漾，飘着一叶小舟，一个绿衫少女手执双桨，缓缓划水
而来，口中唱着小曲，听那曲子是：
		菡萏香连十顷陂，小姑贪戏采莲迟。
		晚来弄水船头滩，笑脱红裙裹鸭儿。
	歌声娇柔无邪，欢悦动心。湖边的柳树下荡着一叶[1;32m小船[2;37;0m。
LONG
  );
  set("objects", ([
    __DIR__ "npc/cui": 1,
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "baigongti",
  ]));
  set("item_desc", ([
    "小船": "一条小船(xiaochuan)，船中放着对桨。看样子你正好坐得下。\n"
    + "你想了想，不知该不该上去（shang）。\n",
    "xiaochuan": "一条小船(xiaochuan)，船中放着对桨。看样子你正好坐得下。\n"
    + "你想了想，不知该不该上去（shang）。\n",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "room1");
  set("chuilang_dest", "/d/suzhou/qinyun/huan_2.lpc");
  set("where", "湖中");
  setup();
}
void init() {
  add_action("do_shang", "shang");
}
int do_shang() {
  object me;
  me = this_player();
  message_vision(CYN "$N小心翼翼的踏上船头，正准备坐下来。\n"
    +RED "谁知脚下一个不稳，“扑通”一声翻入湖中。\n"
    +CYN "幸亏落水之处离湖岸不远，$N急忙爬上岸来。\n"
    + "但是全身都已湿透，狼狈不堪。\n" NOR, me);
  return 1;
}
