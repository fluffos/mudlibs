// daodejing-ii.c

inherit ITEM;

void create()
{
	set_name("太湖旅游图",({"taihu tu","tu","map"}));
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
	set("long",
"\n                  太湖旅游图\n"+
"－－－－－－－－－－－－－－－－－－－－－－\n"+
"                   陀曼山庄\n"+
"   ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"+
"   ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"+
"   ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"+
"   ~~~听香水榭~~~~~琴韵小筑~~~~~参合山庄~~~\n"+
"   ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"+
"   ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"+
"   ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"+
"   ________________________________________\n"+
"                     湖岸\n");
	set("no_drop",1);
		set("material", "paper");
	}
}
