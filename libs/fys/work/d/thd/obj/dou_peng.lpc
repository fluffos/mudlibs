// dou_peng.c
// 97.7.14 by Aug

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("斗篷", ({ "dou peng", "peng", "cloth" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 1000);
    set("long", "一件用上好的缎料制成的大色斗篷。\n");
    set("material", "cloth");
    set("armor_prop/armor", 5);
  }
  setup();
}
