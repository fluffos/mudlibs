//music  yangzhou's 隋炀帝陵

#include <room.h>
inherit ROOM;

void create() {
  set("short", "隋炀帝陵");
  set("long", @LONG
	这里就是隋炀帝的陵墓，一代昏君长眠于此，墓穴乱石成堆，杂草丛
生，只有一块满身伤痕的[33m墓碑[37m经年累月的默默守在风雪之中。这时，一阵寒风
迎面吹来，你看着四周无边的旷野，不禁打了个寒战，象是曾经丢失了什么。
这样的地方还是不要再来了，你暗自心想。

LONG
  );

  set("outdoors", "/d/yangzhou");
  set("no_fight", "1");
  set("no_steal", "1");
  set("no_sleep_room", "1");

  set("objects", ([
    //      __DIR__"obj/box" : 1,
  ]));

  set("exits", ([
    "east": __DIR__ "huangye1",
  ]));
  //       create_door("northwest", "竹门", "southeast", DOOR_CLOSED);
  setup();
}
