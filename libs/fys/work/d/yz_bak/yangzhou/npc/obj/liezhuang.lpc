//Mr.music yangzhou 猎装

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("猎装", ({ "lie zhuang", "liezhuang","cloth" }) );
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
                set("value", 600);
		set("material", "cloth");
		set("armor_prop/armor", 5);
		set("armor_prop/personality",2);
	}
	setup();
}
