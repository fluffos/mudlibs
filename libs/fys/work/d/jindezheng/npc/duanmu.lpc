inherit KZZNPC;
inherit F_VENDOR;

string query_save_file() { return DATA_DIR+"npc/端木良庸";}
void create()
{
#include <kzznpc.h>	
set("vendor_goods",([
"guijia":__DIR__"obj/guijia"
]));
	set("area_name","景德镇藏珍阁");
	set("area_file","/d/jindezheng/gudong-shop.lpc");

        setup();
carry_object("/obj/cloth")->wear();        
}
void init()
{
::init();
add_action("do_vendor_list","list");

}
