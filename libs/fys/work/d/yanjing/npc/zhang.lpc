inherit KZZNPC;
inherit F_VENDOR;

string query_save_file() { return DATA_DIR + "npc/张铁匠"; }
void create() {
#include <kzznpc.h>
  set("vendor_goods", ([
    "hammer": "/obj/weapon/hammer",
    "sword": "/obj/weapon/sword",
    "blade": "/obj/weapon/blade",
    "whip": "/obj/weapon/whip",
    "banfu": "/obj/weapon/banfu",
    "changdao": "/obj/weapon/changdao",
    "gandao": "/obj/weapon/gangdao",
  ]));
  set("area_name", "燕京铁匠铺");
  set("area_file", "/d/yanjing/tiejiang.lpc");
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/hammer")->wield();
  add_money("silver", 5);
}
void init() {
  ::init();
  add_action("do_vendor_list", "list");
}
