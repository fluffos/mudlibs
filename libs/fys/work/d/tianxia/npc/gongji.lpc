inherit NPC;

void create() {
  set_name("酉鸡", ({ "qiblets" }));
  set("race", "野兽");
  set("age", 6);
  set("long", "红冠金嘴,羽毛绚烂,双爪似铁。\n");

  set("str", 20);
  set("cor", 24);
  set("combat_exp", 75000);
  set("kee", 800);
  set("max_kee", 800);

  set("limbs", ({ "尖嘴", "身体", "爪子", "左翅", "右翅" }));
  set("verbs", ({ "bite", "claw" }));

  set_temp("apply/attack", 10);
  set_temp("apply/armor", 20);

  set("chat_chance", 5);
  set("chat_msg", ({
    "雄鸡振奋精神,抖动双翅,引颈长啸:喔~~~喔~~~喔~~~~.\n",
    "雄鸡努力地打鸣报晓,却听有人道:这瘟鸡,老半夜鬼叫.\n",
  }));

  setup();
}

void die() {
  message_vision("$N扑棱着翅膀扇了几下,飞不多高就掉下来,摔晕了.\n", this_object());
  new(__DIR__ "obj/yumao.lpc")->move(environment(this_object()));
  destruct(this_object());
  return;
}
