#include <ansi.h>
inherit ITEM;

void create()
{
	set_name(RED"麒麟石雕"NOR, ({ "shidiao" , "xiang"}) );
	set_weight(500000);
	set("no_get",1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "尊");
		set("long", "红色玛瑙雕刻而成的麒麟石雕，剔透玲珑.\n");
		set("value", 1);
             set("no_drop",1);
             set("no_put",1);
		set("material", "stone");
	}
setup();
}
