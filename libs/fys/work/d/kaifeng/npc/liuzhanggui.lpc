inherit KZZNPC;
inherit F_VENDOR;

string query_save_file() { return DATA_DIR + "npc/刘麻子"; }
void create()
{
#include <kzznpc.h>
	set("area_name","开封雅琪轩");
	set("area_file","/d/kaifeng/ciqi.lpc");
	set("vendor_goods",([
	"天目碗":__DIR__"obj/ciwan",
	"螺纹醢":__DIR__"obj/luowenhai",
	"碧波瓠":__DIR__"obj/bibohu",
]));
	setup();
	carry_object("/obj/std/armor/pijia")->wear();
	carry_object("/obj/std/armor/pixue")->wear();
}
void init()
{
	::init();
  add_action("do_vendor_list","list");
 }

