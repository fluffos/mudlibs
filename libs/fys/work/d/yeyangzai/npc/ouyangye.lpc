#include <ansi.h>
inherit KZZNPC;

string query_save_file() { return DATA_DIR + "npc/欧阳野"; }
void create()
{
#include <kzznpc.h>
	set("area_name","野羊寨");
	set("area_file","/d/yeyangzai/da.lpc");
	set("ziyuang","金矿");
	set("jizhi",100);
	set("kaifa",5);
	setup();
        carry_object("/d/yeyangzai/npc/obj/zijindao")->wield();
        carry_object("/d/yeyangzai/npc/obj/wujinfu")->wield();
        carry_object("/d/yeyangzai/npc/obj/jinsijia")->wear();
	add_money("gold",1);

}

#include <die.h>
