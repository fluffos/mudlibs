#include <ansi.h>
inherit NPC;

void create()
{
	set_name("野羊寨寨丁",({"zaiding"}));
        set("shen_type",-1);
	set("nickname","野羊寨");
	set("area","野羊寨");
	set("age",25);
	set_skill("dodge",60);
	set_skill("unarmed",60);
	set_skill("parry",60);
	set_skill("blade",60);
	set("max_force",600);set("force",600);
	set("combat_exp",60000);
        setup();
	carry_object("/obj/weapon/blade")->wield();
	add_money("silver",10);
	carry_object("/obj/cloth.lpc")->wear();
}
	
void init()
{
	object ob,area;
	area=new("/obj/area");
	area->create(query("area"));
	set("banghui",(string)area->query("banghui"));
	destruct(area);
	::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
	string banghui;
	if( !ob || environment(ob) != environment() ) return;
	banghui=(string) ob->query("banghui");
	if(! banghui || query("banghui")!=banghui)   {
		command("say 竟敢私闯野羊寨，我看你是不想活了！\n");
		command("guard north");
		kill_ob(ob);
		ob->fight_ob(this_object());
		return;
	}
}


