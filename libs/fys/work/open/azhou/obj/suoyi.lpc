//suoyi 蓑衣

#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("蓑衣", ({ "suoyi","yi","suo yi" }) );
        set_weight(6000);
        if( clonep() )
                set_default_object(__FILE__);
        else {

                set("material", "leather");
                set("value", 2000);
                set("unit", "件");
                set("armor_prop/armor", 200);
        }
        setup();

}

