// object.c

varargs int getoid(object ob) {
  int id;

  if (!ob) ob = previous_object();
  sscanf(file_name(ob), "%*s#%d", id);
  return id;
}

// Get the owner of a file.  Used by log_error() in master.c.
// BEFORE: matched "/u/%s/%s/%s" and returned the SECOND captured segment
// ("name", despite the misleading variable order dir/name/rest), i.e. the
// wizard's own subdirectory name (npc/obj/zjmaster/...) rather than the
// wizard's uid, for any file nested two or more levels under /u/<name>/
// -- which is the overwhelmingly common case for wizard-built content
// (npc/, obj/, room/ subdirs). log_error() then wrote to user_path() of
// that bogus "owner" (e.g. "/u/npc/"), a directory that never exists,
// aborting with "Wrong permissions ... No such file or directory" --
// reproduced live, crashing the FIRST-EVER compile of the start room's
// own NPCs on every fresh boot (see NOTES.md's deep functional test).
// AFTER: capture just the immediate name after /u/, regardless of depth,
// same as the already-correct fallback path used everywhere else in this
// file for /d/, /open/, /ftp/ (path[1]-style ownership).
string file_owner(string file) {
  string name, rest;

  if (file[0] != '/') {
    file = "/" + file;
  }
  if (sscanf(file, "/u/%s/%s", name, rest) == 2) {
    return name;
  }
  return 0;

}

// domain_file should return the domain associated with a given file.
string domain_file(string file) {
  string domain;

  if (sscanf(file, "/d/%s/%*s", domain))
    return domain;

  return ROOT_UID;
}

string creator_file(string file) {
  string *path;

  path = explode(file, "/") - ({ 0 });
  switch (path[0]) {
    case "adm":
      if (file == SIMUL_EFUN_OB) return "MudOS";
      else return ROOT_UID;
    case "cmds":
      return ROOT_UID;
    case "open":
      return "Test";
    case "u":
    case "ftp":
      if (this_player(1) && wizardp(this_player(1)))

        return getuid(this_player(1));
      // previous_object(0) is master object here.
      else if (previous_object(1))
        return geteuid(previous_object(1));
      return "User";
    case "www":
      if (path[1] == "cgi-bin")
        return ROOT_UID;
      // added by ammy to permit post
    case "d":
      return "Domain";
    case "obj":
      if (this_player(1))

        return getuid(this_player(1));
      // previous_object(0) is master object here.
      return "Domain";
    default:
      if (this_player(1))
        return getuid(this_player(1));
      else
        return "MudOS";

  }
}


// author_file should return the name of the author of a specific file.
string author_file(string file) {
  string name;

  if (sscanf(file, "/u/%*s/%s/%*s", name))
    return name;
  return ROOT_UID;
}

void destruct(object ob) {
  if (ob) {
    if (previous_object()) ob->remove(geteuid(previous_object()));
    else ob->remove(0);
    efun::destruct(ob);  //put this inside the if(ob). mon 8/19/97
  }
}

// added by xuy.
int living(object ob) {
  if (!ob) return 0;
  if (ob && ob->query_temp("disabled"))
    return 0;
  return efun::living(ob);
}
