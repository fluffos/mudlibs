        if (objectp(present("jian ke", environment(me))))
        return notify_fail("十本刃剑客横剑挡在面前：擅闯私人重地，这不是找死吗？\n");

        }

        return ::valid_leave(me, dir);
        }
        return ::valid_leave(me, dir);

}
