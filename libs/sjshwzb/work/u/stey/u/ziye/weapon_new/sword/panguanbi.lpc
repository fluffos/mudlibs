// blade.c
//add keenness by ziye 2001/3

#include <weapon.h>

inherit SWORD;

void create()
{
        set_name("判官笔", ({"panguanbi", "sword"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
              set("keenness", 0);
                set("value", 300);
                        set ("material", iron);
        }
        init_sword(20);
        setup();
}
