#/obj/mailbox.c
dbase (["id":"mailbox","name":"小小的信箱","no_drop":1,"no_give":1,"owner_id":"andytxs","long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","unit":"个","no_insert":1,])
mails ({(["to":"andytxs","from":"萧萧(xiao xiao)","time":1016928749,"status":"O","title":"萧萧：帐目结算","text":"你的店主(萧萧)任期结束，结余零文钱已存入你的户头。其中盈利零文钱，剩余预付金零文钱。",]),(["from":"孔方兄(kong fang)","to":"andytxs","time":1016994023,"status":"N","title":"孔方兄：帐目结算","text":"你的店主(孔方兄)任期结束，结余零文钱已存入你的户头。其中盈利零文钱，剩余预付金零文钱。",]),(["to":"andytxs","from":"净天(mofa)","time":1017031560,"status":"N","title":"mofa","text":"你能告诉我你的密码么?你把药铺能的好贵,我在的时候还可以改改还有你帮我练好了,我还要上学,你当你的人练行了",]),(["from":"赵有财(zhao youcai)","to":"andytxs","time":1017064174,"status":"N","title":"赵有财：帐目结算","text":"你的店主(赵有财)任期结束，结余五百二十八两黄金二十两银子已存入你的户头。其中盈利五百二十七两黄金二十两银子，剩余预付金一两黄金。",]),})
