// rankd.c

#include <ansi.h>

mapping wiz_rank = ([
	"(admin)": 		({ HIW " ぱ   " NOR, HIW " ぱ   " NOR }),
	"(arch)": 		({ HIY " ぱ   " NOR, HIY " ぱ   " NOR }),
	"(wizard)": 	({ HIG " ぱ   " NOR, HIG " ぱ   " NOR }),
	"(apprentice)":	({ HIC " ぱ   " NOR, HIC " ぱ   " NOR }),
]);

string query_rank(object ob)
{
	string level="";
	string guild="";
	if( ob->is_ghost() ) return HIB " 碍  活 " NOR;
	if( ob->query("class") ) guild=ob->query("class");
	if(ob->query("class_level")) level="-"+ob->query("class_level");
	if(ob->query("gender")=="┦")
	{
		if(wizhood(ob)!="(player)")
			return to_chinese("f_"+wizhood(ob));
		if(!ob->query("class_level"))
		  if(!ob->query("class")) return " キ  チ " NOR;
		    return to_chinese("f_"+guild+level);
	}
	else
	{
                write (wizhood(ob) + "\n");
		if(wizhood(ob)!="(player)")
			return to_chinese(wizhood(ob));
		if(!ob->query("class_level"))
		  if(!ob->query("class")) return " キ  チ " NOR;
		    return to_chinese(guild+level);
	}
}

// キ嘿癸よ
string query_respect(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/respect")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "┦":
			switch(ob->query("class")) {
			case "bonze":
				if( age < 18 ) return "畍び";
				else return "畍び";
				break;
			case "taoist":
				if( age < 18 ) return "﹉";
				else return "﹉";
				break;
			case "officer":
				return "";
				break;
			default:
				if( age < 18 ) return "﹉甉";
				else if( age < 50 ) return "﹉甉";
				else return "盋盋";
				break;
			}
		case "╧┦":
		default:
			switch(ob->query("class")) {
			case "bonze":
				if( age < 18 ) return "畍";
				else return "畍";
				break;
			case "taoist":
				if( age < 18 ) return "笵";
				else return "笵";
				break;
			case "officer":
					return "";
					break;
			case "fighter":
			case "swordsman":
				if( age < 18 ) return "ρ";
				else if( age < 50 ) return "Ё";
				else return "ρ玡晋";
				break;
			default:
				if( age < 20 ) return "";
				else if( age < 50 ) return "Ё";
				else return "ρ份";
				break;
			}
	}
}

// 驹嘿寄
string query_rude(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/rude")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "┦":
			switch(ob->query("class")) {
			case "bonze":
				return "搁ェ";
				break;
			case "taoist":
				return "Н";
				break;
			case "officer":
				return "绰ǐ";
				break;
			default:
				if( age < 30 ) return "解";
				else return "ρび盋";
				break;
			}
		case "╧┦":
		default:
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "╮苆";
				else return "ρ╮苆";
				break;
			case "taoist":
				return "惑";
				break;
			case "officer":
				return "绰ǐ";
				break;
			default:
				if( age < 20 ) return "矹";
				if( age < 50 ) return "搁";
				else return "ρでひ";
				break;
			}
	}
}

// キ︑嘿
string query_self(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/self")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "┦":
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "砲ェ";
				else return "ρェ";
				break;
			default:
				if( age < 30 ) return "";
				if( age >=30 && age < 50 ) return "ヽō";
				else return "ρō";
				break;
			}
		case "╧┦":
		default:
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "砲宫";
				else return "ρ";
				break;
			case "taoist":
				return "砲笵";
				break;
			default:
				if( age < 50 ) return "";
				else return "ρ繷";
				break;
			}
	}
}

// 驹矮︑嘿
string query_self_rude(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/self_rude")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "┦":
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "砲ェ";
				else return "ρェ";
				break;
			default:
				if( age < 30 ) return "セ﹉甉";
				else return "ρ甉";
				break;
			}
		case "╧┦":
		default:
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "㎝﹟и";
				else return "ρ㎝﹟и";
				break;
			case "taoist":
				return "セ";
				break;
			default:
				if( age < 50 ) return "份и";
				else return "ρ";
				break;
			}
	}
}
