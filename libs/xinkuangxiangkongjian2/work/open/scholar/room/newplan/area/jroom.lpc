inherit ROOM;

void create() {
  set("short", "[1;37m奇阵八卦[1;33m-阵心[0m");
  set("long", @LONG
  
你来到八卦阵的中心，看到眼前有一个看似眉目和善的人，
不过你细细一看，他却又充满杀气，看起来四乎对
你并不是有非常大的好感。你看到他身上的穿着
定睛一看才发现他身上竟有六韬奇略一书，你这时
才发现，原来眼前的这个人竟是有天下第一军师之称的
诸葛家后裔，诸葛邑昭!!
LONG);

  set("objects", ([ /* sizeof() == 1 */
    "/open/scholar/room/newplan/npc/juka_jone": 1,
  ]));
  set("light_up", 1);
  set("no_transmit", 1);
  set("no_magic", 1);
  set("exits", ([ /* sizeof() == 2 */
    "leave": __DIR__ "q1.lpc",
    "south": __DIR__ "room11.lpc",
  ]));

  setup();
}
int valid_leave(object me, string dir) {
  if (dir == "leave" && present("juka jone", environment(me))) {
    return notify_fail("你发觉有人挡在你面, 不让你过!!!\n");
  }
  return 1;
}
