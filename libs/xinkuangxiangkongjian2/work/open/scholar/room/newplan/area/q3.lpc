// Room: /u/s/sueplan/newplan/area/qroom2
inherit ROOM;

void create() {
  set("short", "[1;35m八卦阵[0m");
  set("long", @LONG
                    ■■■■■■

                        ■■■■■■

                        ■■    ■■

                        巽（风）

知悉太极生两仪，两仪生四象，四象生八卦，八八六十四化，
此乃中国易经之妙所在，诸葛孔明以此而立八卦阵，阵内变
化万千，易使人迷失于不自觉间。
你面前卷起不少的风沙, 请选出(move)你要走的方向
[1;37m方向有-玄, 元, 练, 支, 练玄, 练元, 支玄, 支元。[0m
LONG);

  set("no_auc", 1);
  set("no_transmit", 1);

  setup();
}
void init() {
  add_action("do_move", "move");
}
int do_move(string str) {
  object me = this_player();
  if (str == "玄") {
    me->move(__DIR__ "qt8.lpc");
    return 1;
  }
  if (str == "元") {
    me->move(__DIR__ "qt7.lpc");
    return 1;
  }
  if (str == "练") {
    me->move(__DIR__ "gr-2.lpc");
    return 1;
  }
  if (str == "支") {
    me->move(__DIR__ "qt6.lpc");
    return 1;
  }
  if (str == "练玄") {
    me->move(__DIR__ "qt5.lpc");
    return 1;
  }
  if (str == "练元") {
    me->move(__DIR__ "qt4.lpc");
    return 1;
  }
  if (str == "支玄") {
    me->move(__DIR__ "qt3.lpc");
    return 1;
  }
  if (str == "支元") {
    me->move(__DIR__ "qt2.lpc");
    return 1;
  }
}
