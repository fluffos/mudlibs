#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  string na;
  object me;
  me = this_player();
  na = (me->name(0));

  if (me)
    set_name(na + "[1;37m□玄武剑[0m", ({ "sword" }));
  else {
    set_name("[1;37m玄武剑[0m", ({ "sword" }));
  }
  seteuid(getuid());
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", @LONG

        上古神秘兵器之一的玄武剑

LONG);
    set("value", 12000);
    set("no_drop", 1);
    set("no_get", 1);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_auc", 1);
    set("material", "gem");
    set("wield_msg", "$N「唰”地一声抽出一把$n握在手中。\n");
  }
  init_sword(70);
  setup();
}

int query_autoload() { return 1; }
