#include <ansi.h>
inherit EQUIP;
void create()
{
 set_name(MAG "紫羽龙丝靴" NOR,({"dragon boots","boots"}));
        set_weight(2000);
        if ( clonep() )
                set_default_object(__FILE__);
        else{
                set("unit","双");
                set("value",4000);
 set("armor_prop/dodge",3);
 set("armor_prop/move",3);
                set("material","leather");
                set("armor_type","boots");
}
setup();
        }


