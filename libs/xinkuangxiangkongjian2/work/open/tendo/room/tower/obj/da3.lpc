#include <weapon.h>
#include <ansi.h>

inherit DAGGER;

void create() {
  string na;
  object me;
  me = this_player();
  na = (me->name(0));

  if (me)
    set_name(na + "[1;37m□[1;33m豹之匕[0m", ({ "dagger" }));
  else {
    set_name("[1;33m豹之匕[0m", ({ "dagger" }));
  }
  seteuid(getuid());
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", @LONG

        上古神秘兵器之一的～～豹之匕～～!!

LONG);
    set("value", 12000);
    set("no_drop", 1);
    set("no_get", 1);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_auc", 1);
    set("material", "steel");
    set("wield_msg", "$N从怀中摸出一把$n握在手中。\n");
  }
  init_dagger(60);
  setup();
}
int query_autoload() { return 1; }
