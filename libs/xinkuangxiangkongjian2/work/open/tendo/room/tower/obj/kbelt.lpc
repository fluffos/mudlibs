#include <ansi.h>
inherit EQUIP;
void create()
{
 set_name(HIY"紫羽龙丝腰带"NOR,({"dragon belt","belt"}));
 set_weight(100);
     if ( clonep() )
              set_default_object(__FILE__);
     else {
            set("unit", "付");
            set("armor_type", "waist");
            set("material", "leather");
            set("value", 4000);
            set("armor_prop/armor",5);
     }
}


