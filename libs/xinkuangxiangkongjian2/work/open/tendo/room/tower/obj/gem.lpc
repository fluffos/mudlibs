//翠玉
#include <command.h>
inherit ITEM;

void create() {
  set_name("[1;32m翠玉[0m", ({ "gem" }));
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", @LONG
        这是一块绿澄澄的翠玉!!你可以将它拿去给冶铸的大师, 
        翠玉做成的武器或是防具都是不错的!!
LONG);
    set("value", 800);
    set("material", "gem");
    set("no_sell", 1);
    set("no_auc", 1);
  }
}
