#include <ansi.h>
inherit ROOM;
void create ()
{
  set ("short", "[1;37m走道[0m");
  set ("long", @LONG
南边的门(door)似乎不同于之前所看到的那些门，比较起来，这一扇门似乎感
觉高贵了许多，看来住在这间房间的人应该是一个满重要的人吧。
LONG);

  set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/death" : 1,
]));
  set("item_desc", ([ /* sizeof() == 1 */
  "door" : "这扇门并没有把手可以转动，看来用普通的方法是打不开的。
",
]));
  set("exits", ([ /* sizeof() == 1 */
  "north" : __DIR__"b_r06",
]));

  setup();
}
void init()
{
add_action("do_pray","pray");
}
int do_pray(string arg)
{
object me;
me=this_player();
if(!arg||arg!="door")
return notify_fail("你要祈祷什么？\n");
if(me->query_temp("quest_corpse")!=2)
return notify_fail("你轻声的向大门祈祷，却什么是也没发生。\n");
else{
tell_object(me,"你似乎感觉的到有人在跟你道谢....\n\n");
message_vision(HIB"      $N的身体突然被一团蓝光包围住，整个人腾空消失了！！\n\n"NOR,me);
tell_object(me,"你穿过了门板，进入了房间内。\n");
me->move(__DIR__"b_q");
return 1;
}
}
