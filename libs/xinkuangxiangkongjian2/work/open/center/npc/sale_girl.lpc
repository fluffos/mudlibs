// /open/center/npc/vendor.c
#include <obj.h>
#include <ansi.h>
#include "/open/open.h"

inherit F_VENDOR;
string ask_test();
string ask_standby();

void create()
{
      set_name("卖火柴的小辣妹", ({ "sale girl", "girl" }) );
      set("nickname","[31m小辣椒[0m")

;
        set("gender", "女性" );
        set("age", 18);
        set("long", @LONG
  一个在狂想空间卖花卖了七年多的小女孩, 终于慢慢长大,
变成亭亭玉立的小辣妹, 喷火的身材异于寻常人，因此, 还
是经常被路过的有钱大爷欺负。由于没有玩家要跟她买花, 
她至今最大的心愿, 还是在这寒冷的冬天有一件衣服穿, 不
过, 没有衣服的话, 玩家会更高兴吧, 所以, 她只好一直在
FS卖花下去啰....
    最近她正在征求代替(standby)她卖花的好心人......

LONG);
        set("attitude", "friendly");
        set("rank_info/respect", "小妹妹");
        set("combat_exp",180);

        set("vendor_goods", ({
            CENTER_OBJ"torch",
            CENTER_OBJ"map",
        }) );

        set("chat_msg", 5);
        set("chat_msg", ({
           "小辣妹说道: 谁能给我衣服穿啊，好冷耶。\n",
           "小辣妹拉拉你的衣服,眼角闪着泪\光说道: 您能给我一件衣服吗?\n",
           "小辣妹可怜兮兮的说道: 冬令救济一下嘛!。\n",
           "小辣妹哀求地说道: 能不能代替(standby)我卖花啊？\n",
        }) );
set("inquiry",([
   "试炼印记" : (:ask_test:),
   "standby" : (: ask_standby :),
      ]));



        set("greeting_msg", ({
         "小辣妹说道: 好心的大爷小姐们，买把木头当材烧吧。\n",
         "小辣妹可怜兮兮的瞧着你: 这位好心的大爷小姐，伸伸援手救助我吧。\n",
         "小辣妹有气无力的说: 好心的大爷小姐，路过此地，难道见死不救吗?\n",
         "小辣妹哀求地说道: 能不能代替(standby)我卖花啊？\n",
        }) );
        setup();
}

int accept_object(object who, object ob)
{      
  object        me;

  seteuid(getuid());
  me = this_object();

  if (who->query("quests/sale_girl") == 0) {
    message_vision("小女孩说道: 谢谢$N赏赐。妹妹我无以为报，卖得的一百文钱"
        "以及卖剩的一把木头跟一张地图就当成回报，请您笑纳。\n",who);
    who->pay_player(100);
    who->set("quests/sale_girl",1);
    new(CENTER_OBJ"torch")->move(who);
    new(CENTER_OBJ"map")->move(who);
    who->save();
    return 1;
  }
  else {
    message_vision("小女孩说道: 谢谢$N赏赐。\n",who);
    return 1;
  }
}                                                                       

string ask_test()
{
 if(this_player()->query("quests/yan")==3)
 {
  if(this_player()->query("quests/sale_girl",1) && this_player()->query("quests/yantestmark1",1) && this_player()->query("quests/2ndtest",1))
  {
  int i;
  i=6+random(5);
  command("say 谢谢您的帮忙.我愿意将appo给我的印记传到你身上!\n");
  tell_object(this_player(),HIW"瞬间由卖火柴的小辣妹将手搭在你的肩上..你顿时觉得一股暖意由小辣妹的手中传过来\n"NOR);
  this_player()->set("quests/2ndtest",i);
  this_player()->set("quests/yantestmark2",1);
  return("最后一个印记在圣贤书手上,你可以去找他问问了\n");
  }
 else if (this_player()->query("quests/yantestmark2")>1)
  return ("我已经把印记给你了..你还要做什么\n");
 else
  return ("救助救助我..我就跟你说印记在哪\n");
 }
else
 return ("啥印记..你在说什么?\n");
}

string ask_standby()
{
  string *places = ({
    "/open/firedancer/t01.lpc",
    "/open/hall/way1.lpc",
    "/open/killer/room/r1.lpc",
    "/open/killer/room/ru3.lpc",
    "/open/marksman/room/shop.lpc",
    "/open/newhand/newhand.lpc",
    "/open/port/room/port.lpc",
    "/open/bonze/room/big.lpc",
    "/open/start/room/f1.lpc",
    "/open/tensan/room6.lpc",
    "/open/wu/room/luroom1.lpc",
    "/open/badman/room/s2.lpc",
    "/open/capital/room/r01.lpc",
    "/open/doctor/room/r4.lpc",
    "/open/gblade/room/c2.lpc",
    "/open/heaven/castle/room/n5.lpc",
    "/open/love/room/room2-14.lpc",
    "/open/mogi/castle/room10.lpc",
    "/open/mogi/village/room/room-07.lpc",
    "/open/prayer/room/happy.lpc",
    "/open/beggar/room/room01.lpc",
    "/open/center/room/r10.lpc",
    "/open/evil-area/e01.lpc",
    "/open/island/room/i1.lpc",
    "/open/magic-manor/manor04.lpc",
    "/open/mon/hole.lpc",
    "/open/ping/room/f2.lpc",
    "/open/snow/room/hole.lpc",
    "/open/tailong/room/d3.lpc",
    "/open/wind-rain/43.lpc",
    "/open/biau/room6.lpc",
    "/open/dancer/room/roome2.lpc",
    "/open/fire-hole/f-48.lpc",
    "/open/gsword/room/froad2.lpc",
    "/open/poison/room/room10.lpc",
    "/open/scholar/room/wind_s.lpc",
    "/open/soldier/room/r36.lpc",
    "/open/tendo/room/r3.lpc"
  });

  if (this_player()->query("standby") < 1) {
    this_player()->add("standby", 1);
    this_player()->move (places[random(sizeof (places))]);
    return "say 谢谢您的帮忙, 我愿意以身相许\!\n";
  }
  else {
    this_player()->move (places[random(sizeof (places))]);
    return "say 谢谢您的帮忙！\n";
  }
}
