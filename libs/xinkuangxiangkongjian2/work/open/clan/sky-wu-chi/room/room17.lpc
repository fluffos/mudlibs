inherit ROOM;
void create() {
	set( "short", "$HIB$【$HIC$圣  石  碑$HIB$】$NOR$" );
	set( "light_up", 1 );
	set( "exits", ([
		"D"         : "/open/clan/sky-wu-chi/room/room91.lpc",
		"Y"         : "/open/clan/sky-wu-chi/room/room60.lpc",
		"chome"     : "/open/clan/sky-wu-chi/room/hall",
		"Q"         : "/open/clan/sky-wu-chi/room/room48.lpc",
		"V"         : "/open/clan/sky-wu-chi/room/room64.lpc",
		"B"         : "/open/clan/sky-wu-chi/room/room19.lpc",
		"O"         : "/open/clan/sky-wu-chi/room/room93",
		"F"         : "/open/clan/sky-wu-chi/room/room34.lpc",
		"U"         : "/open/clan/sky-wu-chi/room/room65.lpc",
		"W"         : "/open/clan/sky-wu-chi/room/room63.lpc",
		"N"         : "/open/clan/sky-wu-chi/room/room47.lpc",
		"R"         : "/open/clan/sky-wu-chi/room/room37.lpc",
		"L"         : "/open/clan/sky-wu-chi/room/room55.lpc",
		"X"         : "/open/clan/sky-wu-chi/room/room62.lpc",
		"J"         : "/open/clan/sky-wu-chi/room/room58.lpc",
		"S"         : "/open/clan/sky-wu-chi/room/room36.lpc",
		"H"         : "/open/clan/sky-wu-chi/room/room26.lpc",
		"E"         : "/open/clan/sky-wu-chi/room/room29.lpc",
		"I"         : "/open/clan/sky-wu-chi/room/room92.lpc",
		"M"         : "/open/clan/sky-wu-chi/room/room51.lpc",
		"P"         : "/open/clan/sky-wu-chi/room/room43.lpc",
		"C"         : "/open/clan/sky-wu-chi/room/room35.lpc",
		"Z"         : "/open/clan/sky-wu-chi/room/room71.lpc",
		"G"         : "/open/clan/sky-wu-chi/room/room28.lpc",
		"K"         : "/open/clan/sky-wu-chi/room/room57.lpc",
		"T"         : "/open/clan/sky-wu-chi/room/room68.lpc",
		"A"         : "/open/clan/sky-wu-chi/room/room13.lpc",
	]) );
	set( "long", @LONG
相传,上古时代,因为天上的作乱人间,导致民不聊生,兵荒马乱,
这时有二十六位[0;1;34m□[1mj[1m□[1mt[1m□[1m□[0m为了抵抗天神的作弄,奋而群起抵抗,在
一位拥有妖刀的邪燕领导下,跟诸位天神大战,但还是不敌天上
的诸神这时众古圣者决定~~以牺牲自我,还换取狂想空间的和平,
在二十六道飞过天际时,天上众神被重创了...但古圣者也因放出
毕生的功力使他们化为灰烬...在邪燕的传人<[0;1;36m□[1mM[1m□[1m□[1m□[1mP[1m□[1mJ[0m>的奔走下
终于收集到了二十六位古圣者的遗骸....并且用毕生所学,化成了
二十六颗传送石...只要你诚心呼唤圣者之名...你便可以传送到
[0;1;33m□[1mt[1m□[1m□[1m□[1m□[1m□[1m□[0m去了....                                欣
LONG);
	setup();
	replace_program(ROOM);
}
