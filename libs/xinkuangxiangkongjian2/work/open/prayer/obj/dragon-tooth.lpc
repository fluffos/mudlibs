//黄甲金龙的锐齿()
#include <command.h>
inherit ITEM;

void create() {
  set_name("[33m黄甲金龙的锐齿[0m", ({ "dragon tooth", "tooth" }));
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是破邪洞窟中[33m黄甲金龙[0m的牙齿, 传闻[33m黄甲金龙[0m全身上下均具有龙的魔力。
          如果将牙齿拿去做成武器!? 那不就..........\n");
    set("value", 800);
    set("material", "bone");
    set("no_sell", 1);
    set("no_auc", 1);
  }
}
