inherit EQUIP;

void create() {
  set_name("[32m乾坤战斗靴[0m", ({ "boris boots", "boots" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "[31m圣火教[0m教主专用的战斗靴，以怪兽鳞甲精炼混织而成。\n");
    set("unit", "双");
    set("value", 50000);
    set("material", "leather");
    set("armor_type", "boots");
    set("wear_msg", "[36m穿上$n之后，$N的身体顿时受到九天之气的牵引，徐徐升起。[0m\n");
    set("armor_prop/move", 5);
    set("armor_prop/dodge", 5);
    set("armor_prop/armor", 5);
  }
  setup();
}
