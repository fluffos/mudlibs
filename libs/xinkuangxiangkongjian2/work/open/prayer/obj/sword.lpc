#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
        seteuid(getuid());
        set_name("[31m红炘剑[0m",({"red-sword","sword"}));
        set_weight(35000);
        if( clonep() )
        set_default_object(__FILE__);
        else {
        set("unit", "把");
        set("long",@LONG

	开阳门主秦忆诗的佩剑，一把以红铁打制的短剑，剑的两侧加上
	细细的锯齿，藉以提高杀伤力．同时这把剑也是玉女派掌门人的
	佩剑, 与天女散花剑法配合使用后, 威力倍增!!

LONG);
        set("value",12000);
        set("no_drop",1);
        set("no_sell",1);
        set("no_give",1);
        set("no_auc",1);

        set("material", "iron");
        set("wield_msg", "$N从剑鞘一拔出$n，[31m红光四射[0m。\n");
        set("unwield_msg", "$N用衣服将$n包了起来，其红色的豪光被布包给遮蔽了。\n");
        }
        init_sword(100);
        setup();
}                            
