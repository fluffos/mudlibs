#include <ansi.h>

inherit EQUIP;

void create()
{
        set_name("[32m乾坤战斗服[0m",({"boris-cloth","cloth"}) );
        set_weight(15000);
        if( clonep() )
                set_default_object(__FILE__);
else    {
        set("meterial","silk");
        set("unit","件");
        set("value", 200000);
        set("armor_type","cloth");
        set("wear_msg","[36m$N穿上了$n之后,只见[35m卦象如虹[36m,全身散发出雄浑的斗气!![0m\n");
        set("remove_msg","$N将$n脱下之后,雄浑的斗气慢慢地消散了!!\n");
        set("armor_prop/armor", 20);
        set("armor_prop/dodge", 5);
        set("armor_prop/unarmed", 15);
        set("armor_prop/stick", 15);
        set("armor_prop/force", 5);
        set("long","
西域特殊的织料再佐以血麒麟的鳞皮混合制成,前面绣有圣火教的圣火
图样,后面则是女娲娘娘的图象. 刀枪不入,水火不侵.是圣火教历代教主
的嫡传宝衣。\n");
        }
         setup();
}





