#include <weapon.h>
#include <ansi.h>

inherit STICK;

void create()
{
        seteuid(getuid());
        set_name("[33m龙形三节棍[0m",({"dragon-stick","stick"}));
        set_weight(15000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
        set("long","这是一柄钢制的三节棍，尾端部分则以黄甲金龙的骨头制成龙形，藉以提高攻击力．\n");

                set("value",30000);
                set("material", "steel");
        set("wield_msg", "$N从布包中抽出了$n，霎时间你觉得[36m龙强大的力量灌入了双臂[0m。\n");
        set("unwield_msg", "$N将$n放进腰间的布包 。\n");
        }
        init_stick(90);
        setup();
}                            