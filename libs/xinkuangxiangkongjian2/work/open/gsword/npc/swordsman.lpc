inherit NPC;

void create()
{
	set_name("守殿剑士", ({"swordsman"}));
	set("long","仙剑派守殿剑士,正恭恭敬敬的站在两旁.\n");
	set("gender","男性");
	set("combat_exp",12775);
        set("attitude","heroism");
	set("age",31);
	set("class","swordsman");
	set("score",1000);
	set("force",300);
	set("max_force",300);
	set("force_factor",4);
	set("str",30);
        set("cor", 30);
	set("per", 25);
	set("int", 30);
	set("cps",20);
	set("con", 30);
	set("spi", 15);
	set("kar", 30);
	set_skill("sword",50);
	set_skill("dodge",50);
	set_skill("parry",50);
	setup();
	carry_object("/obj/longsword.lpc")->wield();
}
 int accept_fight(object me)
  {
  if((int)me->query("combat_exp")<=2000)
  {
   command("say 去外面打动物啦!");
   return 0;
  }
  command("say 亮剑吧!");
  return 1;
  }
         
      
