#include <weapon.h>
#include <ansi.h>
#include <combat.h>
inherit SWORD;
object ob;
void create() {
  set_name("[1;31m连阳真剑[0m", ({ "sevensun_sword", "sword" }));
  set_weight(9000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",
      "据说此剑为轩辕剑仙的配剑，其剑身成透明，只见剑身上镶有七色宝珠
并有红色之圣痕文字，将此剑的神秘性又增加了一成。\n");
    set("value", 10);
    set("material", "crimsonsteel");
    set("rigidity", 200);
    set("no_auc", 1);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_put", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("wield_msg", "$N拔出$n,，瞬时剑身上的七色宝珠突然发出七色光华，使人精神为之一振。\n");
    set("unwield_msg", "$N将手中$n收回身后剑鞘，顿时七色灵光消失无踪。\n");
    set("weapon_prop/sword", 10);
  }
  init_sword(99);
  setup();
}
void init() {
  add_action("do_wield", "wield");
  add_action("do_unwield", "unwield");
}
int do_wield(string str) {
  ::wield();
  if (query("equipped")) {
    ob = this_player();
    message_vision("$N手握[1;37m仙剑[1;31m连阳[0m，只见七色圣光环绕在$N身边。\n", this_player());
    set_heart_beat(1);
  }
}
int do_unwield(string str) {
  if (query("equipped")) {
    message_vision("$N将仙剑连阳放下，七色圣光顿时消失无踪....\n", this_player());
    set_heart_beat(0);
  }
}
void heart_beat() {
  object *enemy;
  object victim;
  int i, j, sword;
  sword = ob->query_skill("sword", 1) / 5;
  if (!objectp(ob)) {
    set_heart_beat(0);
    return;
  }

  if (ob->is_fighting() && query("equipped")) {
    if (sword > random(100)) {
      message_vision(
        HIW "由于受到$N内力的召唤，藏身于圣剑七色宝珠中之七剑剑灵分别由剑中宝珠窜出\n并依$N的精神而摆\出仙剑剑阵之禁断八卦游龙阵只见\n" HIR "$N仰天长啸，催动八卦游龙阵使出惊世骇俗的仙剑剑阵至极绝招\n" NOR,
        ob
      );
      message_vision(HIW "\n\t\t‘" HIR "～禁～断～连～阳～七～诀～斩" HIW "’\n\n" NOR, ob);
      message_vision(HIR "此招一出，惊天动地，传说自仙剑创派以来从未被使用过!!\n" NOR, ob);
      message_vision(
        HIB "\n烈阳剑灵狂性骤起，口中喃喃有辞，使出仙剑禁断之连阳七诀第一式" HIW "‘" HIB "烈阳" HIW "’" HIB "!!\n" NOR,
        ob
      );
      message_vision(
        HIR "\n残阳剑灵狂性骤起，口中喃喃有辞，使出仙剑禁断之连阳七诀第二式" HIW "‘" HIR "残阳" HIW "’" HIR "!!\n" NOR,
        ob
      );
      message_vision(HIW "\n艳阳剑灵狂性骤起，口中喃喃有辞，使出仙剑禁断之连阳七诀第三式" HIW "‘艳阳’!!\n" NOR, ob);
      message_vision(
        HIM "\n暖阳剑灵狂性骤起，口中喃喃有辞，使出仙剑禁断之连阳七诀第四式" HIW "‘" HIM "暖阳" HIW "’" HIM "!!\n" NOR,
        ob
      );
      message_vision(
        HIC "\n冬阳剑灵狂性骤起，口中喃喃有辞，使出仙剑禁断之连阳七诀第五式" HIW "‘" HIC "冬阳" HIW "’" HIC "!!\n" NOR,
        ob
      );
      message_vision(
        HIG "\n朝阳剑灵狂性骤起，口中喃喃有辞，使出仙剑禁断之连阳七诀第六式" HIW "‘" HIG "朝阳" HIW "’" HIG "!!\n" NOR,
        ob
      );
      message_vision(
        HIY "\n夕阳剑灵狂性骤起，口中喃喃有辞，使出仙剑禁断之连阳七诀第七式" HIW "‘" HIY "夕阳" HIW "’" HIY "!!\n" NOR,
        ob
      );
      message_vision(
        HIW "\n七道剑虹同时激空而出，「七阳连天”在空中织成一道虹网！\n" HIG "而主阵的$N纵身一跃，凝气准备发出最后一式以完成这惊天地动的一击！\n" NOR,
        ob
      );
      message_vision(HIW "\n只见$N狂性骤起 ,大喝一声‘" HIR "剑影连阳，七阳连天’!!\n" NOR, ob);
      message_vision(HIW "$N的七阳连天气势澎礴，激发了先前仙剑禁断之连阳七诀的七股刚柔并济的剑虹\n只见虹气啸天，满天剑影，阵内敌人皆受重创\n" NOR, ob);

      enemy = ob->query_enemy();
      i = sizeof(enemy);
      for (j = 0; j < i; j++) {
        enemy[j]->receive_damage("kee", 500);
        enemy[j]->start_busy(2);

        COMBAT_D->report_status(enemy[j], 0);
      }
    }
  }
  return;
}
