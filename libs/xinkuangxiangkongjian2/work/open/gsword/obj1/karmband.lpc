#include <armor.h>
#include <ansi.h>
inherit ARMBANDS;
object me=this_player();
void create()
{
        set_name("[1;33m剑圣手甲[0m",({"kensai armband","armband"}) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit","件");
        set("value",0);
        set("long","不知名的材质制成..似乎专为剑客所做。\n");
set("wear_msg","$N穿上$n后，$n[1;36m散发出淡但蓝光。\n");
        set("material","steel");
        set("no_auc",1);
        set("no_sell",1);
        set("no_give",1);

        set("no_put",1);
        set("no_drop",1);
        set("no_get",1);
        }
        setup();
this_object()->set("armor_prop/sword",5);
this_object()->set("armor_prop/armor", 10);
this_object()->set("armor_prop/parry", 5);
this_object()->set("armor_prop/dodge", 5);
}
