#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create()
{
seteuid(getuid());
set_name("[1;31m魔剑[1;37m天殇[0m",({"Sad sword","sword"}));
set_weight(10000);
if( clonep() )
set_default_object(__FILE__);
else {
set("unit", "把");
set("value",20000);
set("material", "steel");
                set("wield_msg", "拿着$n,$N脸上诡异的笑了笑\n");
set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");  
set("weapon_prop/sword",10);                                                                              }
init_sword(99);
setup();

}
