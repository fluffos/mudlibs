#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", "[1;35m天璇楼[2;37;0m");
  set ("long", @LONG
这是七星塔中的第六层楼, 到达这里, 你一股倦意突然起来,
令你有心于而力不足的感觉, 心中有一丝丝想放弃的感觉, 突然
一阵笑声, 原来是楼主的笑声, 由于他刚领悟到更一层的武学,
看到你来到此地, 马上跑到你的身边, 邀你切磋。
LONG);

  set("exits", ([ /* sizeof() == 2 */
     "up" : "/open/mogi/forest/entrance",
  "out" : __DIR__"room12.lpc",
]));
  set("light_up", 1);
  set("objects", ([ /* sizeof() == 1 */
  "/open/gsword/star/npc/star3.lpc" : 1,
]));

  setup();
}
int valid_leave(object me, string dir)
{
if( dir=="up" && present("starman",environment(me)))
    if(!me->query_temp("allow_read",1))
   return notify_fail("你以为你能活得过去吗??"
+RANK_D->query_respect(me)+"你去死吧!\n");
return ::valid_leave(me,dir);
}
