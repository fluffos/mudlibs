// Room: /u/b/blue/room/star1.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "[1;34m天权楼[2;37;0m");
  set("long", @LONG
这是七星塔的第四层, 当你刚走到此楼, 突然有眼睛感到一阵
刺痛, 原来是此处的光线更加的强烈, 令你在此的休息了一会才慢
慢的好转起来, 此时你立刻望向四周, 而这的设计跟第三层楼一样
, 只不过周围摆放着星之装备, 原来所有七星塔中的装备, 是从这
生产出来的, 而楼梯口旁站到楼主, 楼主脸上充满着倦态, 原来他
刚在休息就被你的脚步声吵醒了。
LONG);

  set("exits", ([ /* sizeof() == 2 */
    "up": __DIR__ "room9.lpc",
    "out": __DIR__ "room8.lpc",
  ]));
  set("light_up", 1);
  set("objects", ([ /* sizeof() == 1 */
    "/open/gsword/star/npc/star4.lpc": 1,
  ]));

  setup();
}
int valid_leave(object me, string dir) {
  if (dir == "up" && present("starman", environment(me)))
    if (!me->query_temp("allow_read", 1))
      return notify_fail("你以为你能活得过去吗??"
        +RANK_D->query_respect(me) + "你去死吧!\n");
  return ::valid_leave(me, dir);
}
