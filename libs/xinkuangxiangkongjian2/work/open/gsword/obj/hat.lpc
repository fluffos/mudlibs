// kame_suit.c

inherit EQUIP;

void create()
{
        set_name("瓜皮小帽",({"little hat","hat"}) );
        set_weight(2500);
        if( clonep() )
		set_default_object(__FILE__);
	else {
        set("long","一顶瓜皮小帽.\n");
        set("unit","件");
        set("value", 350);
        set("material","cloth");
        set("armor_type","head");
	set("armor_prop/armor", 3);
	}
        setup();
}
