,HIR\"ψ  血  手  ψ\"NOR); set(\"long\",\"他是十大恶人之一，他全身上下散发着血红的光芒，杀气腾腾，让人退避三舍。\\n\"); set(\"title\",HIY\"十\"HIG\"大\"HIM\"恶\"HIC\"人\"NOR); set(\"gender\",\"男性\"); set(\"age\",38); set(\"str\",33); set(\"cor\",30); set(\"cps\",28); set(\"max_gin\", 20000); set(\"max_kee\", 20000); set(\"max_sen\", 20000); set(\"max_s_kee\",3000); //set(\"s_kee\",3000); set(\"sec_kee\",\"god\"); set(\"combat_exp\", 3500000); set(\"score\", 200000); set(\"bellicosity\",30000); set(\"max_atman\", 100); set(\"atman\", 100); set(\"max_force\", 20000); set(\"force_factor\", 30); set(\"force\", 40000); set(\"max_mana\", 100); set(\"mana\", 100); set(\"attitude\",\"aggressive\"); set_skill(\"dodge\", 100); set_skill(\"black-steps\",100); set_skill(\"force\", 100); set_skill(\"badforce\",100); set_skill(\"move\", 90); set_skill(\"parry\",100); set_skill(\"unarmed\",110); set_skill(\"badstrike\",100); map_skill(\"unarmed\", \"badstrike\"); map_skill(\"parry\", \"badstrike\"); map_skill(\"force\", \"badforce\"); map_skill(\"dodge\", \"black-steps\"); map_skill(\"move\", \"black-steps\"); set(\"chat_chance_combat\", 90); set(\"chat_msg_combat\", ({              (: perform_action, \"unarmed.evil-blade\" :), (: perform_action, \"unarmed.badroar\" :), (: do_heal() :),         }) ); set(\"chat_change\",50); set(\"chat_msg\", ({ (: random_move :), })); setup(); add_money(\"gold\",1000); carry_object(\"/open/wu/obj/figring\")->wield();}int accept_fight(object who){ who=this_player(); //可以这样用嘛??我没看过耶 command(\"say 你活太久了是吗？找我挑战····去死吧！\\n\"); // 帮你把color 去掉  似乎没有这种写法 command(\"cmd god_kee\"); return 1;}int accept_kill(object who){ who=this_player(); command(\"say 找死！哈···哈···哈···今日让你 死～ 个～ 够～\\n\"); kill_ob(who); command(\"cmd god_kee\"); return 1;}//以下的这一段你要干嘛咧...看不懂说.../*int change(object me){ set(\"chat_chance\",10); set(\"chat_msg\",({ (: this_object(),\"random_move\" :), }));{int exp;exp = 1.5 * me->query(\"combat_exp\");if( exp > 3500000)setup();return 1;}}*/ int do_heal(){ object mob = this_object(); if( mob->query_temp(\"heal\") < 3 ) {  if( (mob->query(\"kee\")*100 / mob->query(\"max_kee\")) < 30 )  {   mob->add(\"kee\",1000);   mob->add_temp(\"heal\", 1); message_vision(HIY\"$N拿出了天香丹,吃了下去，脸上看来又有了不少血气。\\n\"NOR,mob); //这边要加上$N 是指谁吧  } }}void die(){ message_vision(HIY\"我\"HIW\"～\"HIY\"不\"HIW\"～\"HIY\"甘\"HIW\"～\"HIY\"心\"HIW\"～\"HIR\"！！！\"HIG\"我十大恶人－\"HIR\"ψ  血  手  ψ\"HIB\"杜  杀  \"HIM\"只能活到今日了吗？\\n\"NOR); //你这边用message_vision() 我认为如果只是让这房间的player 看到用write() 就可以 destruct(\"figring\"); ::die();}","title":"to asia",]),(["time":943378561,"author":"祈晴娃娃(bss)","msg":"因为你写的用法错了,且错得蛮严重的,所以还是请你先去看看input_to的用法要看仔细喔,不然你这样不会成功\的..........给你自己去发现吧","title":"我觉得你还不会用input_to喔",]),(["time":943444139,"author":"宝贝雅雅(asia)","msg":"e#include <ansi.h>inherit NPC;int do_heal();void create(){set_name(HIB\"杜  杀\"NOR,({\"du sa\",\"sa\",\"du\"}));set(\"nickname\",HIR\"ψ  血  手  ψ\"NOR);set(\"long\",\"他是十大恶人之一，他全身上下散发着血红的光芒，杀气腾腾，让人退避三舍。\\n\");set(\"title\",HIY\"十\"HIG\"大\"HIM\"恶\"HIC\"人\"NOR);set(\"gender\",\"男性\");set(\"class\",\"fighter\");set(\"age\",38);set(\"str\",33);set(\"cor\",30);set(\"cps\",28);set(\"max_gin\", 20000);set(\"max_kee\", 20000); set(\"max_sen\", 20000);set(\"max_s_kee\",3000);set(\"sec_kee\",\"god\");set(\"combat_exp\", 3500000);set(\"score\", 200000);set(\"bellicosity\",30000);set(\"max_atman\", 100);set(\"atman\", 100);set(\"max_force\", 20000);set(\"force_factor\", 30);set(\"force\", 40000);set(\"max_mana\", 100);set(\"mana\", 100);set(\"attitude\",\"aggressive\");set_skill(\"dodge\", 100);set_skill(\"black-steps\",100);set_skill(\"force\", 100);set_skill(\"badforce\",100);set_skill(\"move\", 90);set_skill(\"parry\",100);set_skill(\"unarmed\",110); set_skill(\"badstrike\",100);map_skill(\"unarmed\", \"badstrike\");map_skill(\"parry\", \"badstrike\");map_skill(\"force\", \"badforce\");map_skill(\"dodge\", \"black-steps\");map_skill(\"move\", \"black-steps\");set(\"chat_chance_combat\", 90);set(\"chat_msg_combat\", ({ (: perform_action, \"unarmed.evil-blade\" :),(: perform_action, \"unarmed.badroar\" :),(: do_heal() :),}) );set(\"chat_change\",5);set(\"chat_msg\", ({(: random_move :),}));setup();add_money(\"gold\",1000);carry_object(\"/open/wu/obj/figring\")->wield();}int accept_fight(object me){me=this_player(); command(\"say 你活太久了是吗？找我挑战····去死吧！\\n\");call_out(\"change\",1,me);fight_ob(me);command(\"cmd god_kee\"); return 1;}int accept_kill(object me){me=this_player();command(\"say 找死！哈···哈···哈···今日让你 死～ 个～ 够～\\n\"); call_out(\"change\",1,me);kill_ob(me);command(\"cmd god_kee\");return 1;}int change(object me){object me = this_player();object mob = this_object();int exp;exp = me->query(\"combat_exp\");;if(exp > 3500000)mob->set(\"combat_exp\", (1.5 * exp));setup();return 1;}void heart_beat(){mapping exit;string *exit_name;object env, mob = this_object();int i;set_heart_beat(1);if( query(\"kee\") < 0)mob->die();if(mob->is_fighting() && (query(\"kee\")*100/query(\"max_kee\")< 15)  ){env = environment(mob);exit = env->query(\"exits\");exit_name = keys(exit);i = random(sizeof(exit_name));command(exit_name[i]);i = random(sizeof(exit_name));command(exit_name[i]);}if( mob->query_temp(\"heal\") < 3 ){if( (mob->query(\"kee\") * 100 / mob->query(\"max_kee\")) < 30 ){mob->receive_curing(\"kee\", 1000);mob->receive_heal(\"kee\", 1000);mob->add_temp(\"heal\", 1);message_vision(HIY\"$N拿出了\"HIR\"恶人神丹\"HIY\",吃了下去，脸上看来又有了不少血气。\\n\"NOR,mob);}}}void die(){message_vision(HIY\"我\"HIW\"～\"HIY\"不\"HIW\"～\"HIY\"甘\"HIW\"～\"HIY\"心\"HIW\"～\"HIR\"！！！\"HIG\"我十大恶人－\"HIR\"ψ  血  手  ψ\"HIB\"杜  杀  \"HIM\"只能活到今日了吗？\\n\"NOR);destruct(\"figring\");::die();}","title":"help me",]),(["time":943446123,"author":"布衣(marsden)","msg":"#include <ansi.h>inherit NPC;int do_heal();void create(){set_name(HIB\"杜  杀\"NOR,({\"du sa\",\"sa\",\"du\"}));set(\"nickname\",HIR\"ψ  血  手  ψ\"NOR);set(\"long\",\"他是十大恶人之一，他全身上下散发着血红的光芒，杀气腾腾，让人退避三舍\\n\");□set(\"title\",HIY\"十\"HIG\"大\"HIM\"恶\"HIC\"人\"NOR);set(\"gender\",\"男性\");set(\"class\",\"fighter\");set(\"age\",38);set(\"str\",33);set(\"cor\",30);set(\"cps\",28);set(\"max_gin\", 20000);set(\"max_kee\", 20000);set(\"max_sen\", 20000);set(\"max_s_kee\",3000);set(\"sec_kee\",\"god\");set(\"combat_exp\", 3500000);set(\"score\", 200000);set(\"bellicosity\",30000);set(\"max_atman\", 100);set(\"atman\", 100);set(\"max_force\", 20000);set(\"force_factor\", 30);set(\"force\", 40000);set(\"max_mana\", 100);set(\"mana\", 100);set(\"attitude\",\"aggressive\");set_skill(\"dodge\", 100);set_skill(\"black-steps\",100);set_skill(\"force\", 100);set_skill(\"badforce\",100);set_skill(\"move\", 90);set_skill(\"parry\",100);set_skill(\"unarmed\",110);set_skill(\"badstrike\",100);map_skill(\"unarmed\", \"badstrike\");map_skill(\"parry\", \"badstrike\");map_skill(\"force\", \"badforce\");map_skill(\"dodge\", \"black-steps\");map_skill(\"move\", \"black-steps\");set(\"chat_chance_combat\", 90);set(\"chat_msg_combat\", ({(: perform_action, \"unarmed.evil-blade\" :),(: perform_action, \"unarmed.badroar\" :),(: do_heal() :),}) );set(\"chat_change\",5);set(\"chat_msg\", ({(: random_move :),}));setup();add_money(\"gold\",1000);carry_object(\"/open/wu/obj/figring\")->wield();}int accept_fight(object me){me=this_player(); command(\"say 你活太久了是吗？找我挑战····去死吧！\\n\");call_out(\"change\",1,me); //call_out 常常伴随着remove_call_out 请help call_out()//fight_ob(me); command(\"cmd god_kee\"); return 1;}int accept_kill(object me){me=this_player();command(\"say 找死！哈···哈···哈···今日让你 死～ 个～ 够～\\n\"); call_out(\"change\",1,me);kill_ob(me);command(\"cmd god_kee\");return 1;}int change(object me){ me = this_player(); //前面已经宣告过object me 这边不用重复宣告object mob = this_object();int exp;exp = me->query(\"combat_exp\"); //这边多一个分号 我去掉了 以后请注意if(exp > 3500000)mob->set(\"combat_exp\", (1.5 * exp));//setup(); 这边不需要setup(); setup() 只需在主程式return 1;}// 定义这一个heart_beat() 用意在那??void heart_beat(){mapping exit;string *exit_name;object env, mob = this_object();int i;set_heart_beat(1);if( query(\"kee\") < 0)mob->die();if(mob->is_fighting() && (query(\"kee\")*100/query(\"max_kee\")< 15)  ){env = environment(mob);exit = env->query(\"exits\");exit_name = keys(exit);i = random(sizeof(exit_name));command(exit_name[i]);i = random(sizeof(exit_name));command(exit_name[i]);}if( mob->query_temp(\"heal\") < 3 ){if( (mob->query(\"kee\") * 100 / mob->query(\"max_kee\")) < 30 ){mob->receive_curing(\"kee\", 1000);mob->receive_heal(\"kee\", 1000);mob->add_temp(\"heal\", 1);message_vision(HIY\"$N拿出了\"HIR\"恶人神丹\"HIY\",吃了下去，脸上看来又有了不少血气□}}}void die(){message_vision(HIY\"我\"HIW\"～\"HIY\"不\"HIW\"～\"HIY\"甘\"HIW\"～\"HIY\"心\"HIW\"～\"HIR\"！！;destruct(\"figring\");::die();}// 前面不是有宣告一个int do_heal() 的函式 怎么都没看到定义le?","title":"reply",]),(["time":943473242,"author":"布衣(marsden)","msg":"你的du_sa我已经改完了你比较一下我们两个得code 看有没有什么不懂?以下#include <ansi.h>inherit NPC;void create(){ set_name(HIB\"杜  杀\"NOR,({\"du sa\",\"sa\",\"du\"})); set(\"nickname\",HIR\"ψ  血  手  ψ\"NOR); set(\"long\",\"他是十大恶人之一，他全身上下散发着血红的光芒，杀气腾腾\\n\"); set(\"title\",HIY\"十\"HIG\"大\"HIM\"恶\"HIC\"人\"NOR); set(\"gender\",\"男性\"); set(\"class\",\"fighter\"); set(\"age\",38); set(\"str\",33); set(\"cor\",30); set(\"cps\",28); set(\"max_gin\", 20000); set(\"max_kee\", 20000); set(\"max_sen\", 20000); set(\"max_s_kee\",3000); set(\"sec_kee\",\"god\"); set(\"combat_exp\", 3500000); set(\"score\", 200000); set(\"bellicosity\",30000); set(\"max_atman\", 100); set(\"atman\", 100); set(\"max_force\", 20000); set(\"force_factor\", 30); set(\"force\", 40000); set(\"max_mana\", 100); set(\"mana\", 100); set(\"attitude\",\"aggressive\"); set_skill(\"dodge\", 100); set_skill(\"black-steps\",100); set_skill(\"force\", 100); set_skill(\"badforce\",100); set_skill(\"move\", 90); set_skill(\"parry\",100); set_skill(\"unarmed\",110); set_skill(\"badstrike\",100); map_skill(\"unarmed\", \"badstrike\"); map_skill(\"parry\", \"badstrike\");map_skill(\"force\", \"badforce\"); map_skill(\"dodge\", \"black-steps\"); map_skill(\"move\", \"black-steps\"); set(\"chat_chance_combat\", 90); set(\"chat_msg_combat\", ({              (: perform_action, \"unarmed.evil-blade\" :),              (: perform_action, \"unarmed.badroar\" :),           }) ); set(\"chat_change\",5); set(\"chat_msg\", ({         (: random_move :), })); setup(); add_money(\"gold\",1000); carry_object(\"/open/wu/obj/figring\")->wield();}int accept_fight(object me){ me=this_player(); command(\"say 你活太久了是吗？找我挑战····去死吧！\\n\");fight_ob(me);  command(\"cmd god_kee\"); return 1;}int accept_kill(object me){ me=this_player(); command(\"say 找死！哈···哈···哈···今日让你 死～ 个～ 够～\\n\"); kill_ob(me); command(\"cmd god_kee\"); return 1;}void heart_beat(){ mapping exit; string *exit_name; object me,mob,env;  int i; me=this_player(); mob=this_object();   env = environment(mob); exit = env->query(\"exits\"); exit_name = keys(exit); i = random(sizeof(exit_name));  if(me->query(\"combat_exp\") > 3500000) {  mob->set_temp(\"combat_exp\", (1.5 * me->query(\"combat_exp\"))); } if(mob->is_fighting()&&(mob->query(\"kee\")*100/mob->query(\"max_kee\")< 15))  command(exit_name[i]); if((mob->query(\"kee\")*100/mob->query(\"max_kee\"))<30)  {  if(!mob->query_temp(\"heal\"))  {   mob->set_temp(\"heal\",0);  }  if(mob->query_temp(\"heal\")<4)  {   mob->add(\"kee\",1000);   mob->add_temp(\"heal\", 1); message_vision(HIY\"杜杀拿出了\"HIR\"恶人神丹\"HIY\"吃了下去，又有起色\\n\"NOR); } }  ::heart_beat();}void die(){message_vision(HIY\"我\"HIW\"～\"HIY\"不\"HIW\"～\"HIY\"甘\"HIW\"～\"HIY\"心\"HIW\"～\"HIR\"！！\\n\"NOR);destruct(\"figring\");::die();}","title":"to asia",]),(["time":943473338,"author":"布衣(marsden)","msg":"[0;32m: to asia -- 布衣