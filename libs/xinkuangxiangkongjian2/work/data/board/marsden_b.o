intf(\"你输入的联络电话为:%s\",tel); info[\"tel\"]=tel; printf(\"请输入联络住址:\\n\"); printf(\"若有多组联络住址，请用空格隔开。\\n\"); input_to(\"do_input_addr\",0); return 1;}int do_input_addr(string addr){ if(!addr) {  printf(\"请输入联络住址:\\n\");  printf(\"若有多组联络住址，请用空格隔开。\\n\");  input_to(\"do_input_addr\",0); }    printf(\"你输入的联络住址为:%s\\n\",addr); info[\"address\"]=addr; printf(\"请输入电子邮件帐号:\\n\"); printf(\"若无电子邮件帐号者，请依下列格式输入。\\n\"); printf(\"xxx@fs(xxx为使用者id，如tied@fs)\\n\"); printf(\"若有多组电子邮件帐号，请用空格隔开。\\n\"); input_to(\"do_input_email\",0); return 1;}int do_input_email(string email){ if(!email) {  printf(\"请输入电子邮件帐号:\\n\");  printf(\"若无电子邮件帐号者，请依下列格式输入。\\n\");  printf(\"xxx@fs(xxx为使用者id，如marsden@fs)\\n\");  printf(\"若有多组电子邮件帐号，请用空格隔开。\\n\");  input_to(\"do_input_email\",0); } printf(\"你输入的电子邮件帐号为:%s\\n\",email);  info[\"e-mail\"]=email; return 1;}int do_ask(string id){ if(!id) return notify_fail(\"请输入欲查询使用者ID。\\n\"); if(!data[id]) return notify_fail(\"无此使用者资料。\\n\"); printf(\"使用者(%s)的资料如下:\\n\",id); printf(\"----------------------------------------------------------\\n\"); printf(\"%O\\n\",data[id]); printf(\"----------------------------------------------------------\\n\"); return 1;}int do_del(string id){ if(!id) return notify_fail(\"请输入欲删除使用者ID。\\n\"); if(!data[id]) return notify_fail(\"无此使用者资料。\\n\"); map_delete(data,id); printf(\"使用者(%s)的资料已删除完毕。\\n\",id); this_object()->save(); return 1;}","title":"code",]),(["time":945063325,"author":"布衣(marsden)","msg":"搞懂bboard.c","title":"tomorrow work",]),(["time":945143992,"author":"祈晴娃娃(bss)","msg":"要的话就来看吧!!!其中有很多东西我觉得是你没有注意到的像是me and me_lv是要每次都要抓等等.","title":"你的那个room,我应该搞好了,在我的mud下/u/b/bss/server_room.c",]),(["time":945144088,"author":"祈晴娃娃(bss)","msg":"[0;32m: tomorrow work -- 布衣(marsden) 于 Dec 13: =============================================================: 搞懂bboard.c[2;37;0m[2;37;0m加油啰,我花了好多时间才看懂,你应该会比我快吧!!!以后如果你做的也可以像bboard.c的code里的一样,你就成功\啰!!!![2;37;0m","title":"Re: t