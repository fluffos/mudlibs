  set(\"item_desc\", ([ /* sizeof() == 1 */\"sign\" : \"这里是教皇的闺房  里面正坐着等待教皇回来的夫人    而夫人正狠狠的望着你..      似乎此地已不宜久留...速速离去吧...        教皇 剑如冰 留\\n\",    \"south\" : (: look_door,     \"south\" :),    ]));  create_door(\"south\", \"木雕门\", \"north\", DOOR_CLOSED);  setup();}void init(){   object me=this_player();   add_action(\"do_pass\",\"pass\");   if(!interactive(me)) return ;   if( me->query(\"allow_pass\") ==1 )    return ;   me->move(\"/open/clan/fire-1\");   tell_object(me,\"对不起，因为你没有得到教皇的允许\\\，你的良心不允许\\\你进入。\\n\\n\");}  然后call 剑如冰(id)->set(\"allow_pass\",1)  这样就可以了.....  只有帮主进的去...其他人不行...",]),(["author":"小雪球(babe)","time":904569573,"title":" Re: 给babe..","msg":"[32m: 给babe.. -- 清秀小帅衣(chan) 于 Aug 31: =============================================================: 皮皮的部份...先用成跟一般帮派的 room...: 让他们可以放eq..就先这样...: 麻烦一下[2;37;0m[2;37;0mok.. :>--～美丽天使心～[2;37;0m",]),(["author":"小雪球(babe)","time":904714115,"title":"信物","msg":"请大神开个会讨论一下吧..现在信物到底有哪些限制,规定啊?大家好像都不来逛这里.. :P--～美丽天使心～",]),(["author":"清秀小帅衣(chan)","time":904732282,"title":" Re: 信物","msg":"[32m: 信物 -- 小雪球(babe) 于 Sep  2: =============================================================: 请大神开个会讨论一下吧..: 现在信物到底有哪些限制,规定啊?: : 大家好像都不来逛这里.. :P: [2;37;0m先把..信物全部先跟以前一样好了..至于皮皮.....就改改...不要跟 acelan时的板本一样..普通一点....至于其他的部份..我们有空再来讨论[2;37;0m",]),(["author":"小雪球(babe)","time":904799325,"title":" Re: re 24","msg":"[32m: re 24 -- 八神苍月(cccc) 于 Aug 31: =============================================================: #include <room.h>: #include <ansi.h>: inherit ROOM;: void create(): {:     set(\"short\",HIR\"圣火教\"MAG\"幽兰谷\"NOR);:   set (\"long\",\":     只见此地白云在天，繁花遍地，清泉怪石，罗列其间，树旁还有块: 告示板(sign)，前方不远处亭台楼阁，错综有致．溪旁有位白衣少女，: 露着两只白的透明的小腿在戏水，见她有一头乌黑秀发，眉目如画，娇: 艳玉滴，玲珑的嘴唇，还有那双如秋月，如明星的眼波，令人自惭形秽: ，不敢平视．此人正是教主的夫人．: \");:   set(\"light_up\", 1);:   set(\"no_magic\", 1);:   set(\"no_taoist\",1);:   set(\"no_fight\", 1);:   set(\"exits\",([ m* sizeof() == 3 */:   \"south\" 