//whip.c

#include <weapon.h>

inherit STABBER;

int special_att();

void create() {
  object me = this_player();
  set_name("[1;33m御赐金笔[0m", ({ "golden pen", "pen", "golden" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "支");
    set("long", "这是当今圣上赐给杨书文尚书的金笔，感念他为国的辛劳。\n");
    set("value", 10000);
    set("material", "blacksteel");
  }
  init_stabber(80);
  me->set("chat_chance_combat", 10);
  me->set("chat_msg_combat", ({
    (: this_object(), "special_att" :),
  }));
  setup();
}

int special_att() {
  object me = this_player(), *enemy = me->query_enemy();
  int i = sizeof(enemy), j;
  string *busy_msg = ({
    "杨书文紧握[1;33m御赐金笔[1;31m着往你胸前一点，你突然觉得动作迟钝了起来!!\n",
    "杨书文用[1;33m御赐金笔[1;31m直刺你小腿，使你扑通一声，跌倒在地。\n",
    "杨书文将[1;33m御赐金笔[1;31m虚晃一招，趁机点了你手臂，你感到真气窒碍难行。\n"
  });
  int k = sizeof(busy_msg);
  j = random(i);
  tell_room(environment(me), "[1;33m突然间" + me->query("name") + "飞快的往" +
    enemy[j]->query("name") + "身上一点...[0m\n", enemy[j]);
  if (enemy[j] && living(enemy[j])) {
    tell_object(enemy[j], "[1;31m" + busy_msg[random(k)] + "[0m");
    enemy[j]->start_busy(random(3) + 1);
  }
}
