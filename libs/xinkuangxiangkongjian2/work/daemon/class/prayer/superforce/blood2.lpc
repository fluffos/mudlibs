#include <ansi.h>                                                               
inherit F_FUNCTION;                                                             
inherit SSERVER;                                                                
                                                                                
int perform(object me, object target)                                           
{
    object ob;
    int age=me->query("age",1);
    int lv1=me->query("functions/blood/level");
    int lv=me->query_skill("superforce",1);
    int hurt_value=lv1*age/4+lv*age/6;
  if( hurt_value > 2000) hurt_value=2000;
                                                                                
        if( !target ) target = offensive_target(me);                            
        if(!target) return notify_fail("你找不到敌人!!!\n");
                                                                                
        if( lv1 < 70 )
           return notify_fail("你的[31m血穹苍[0m练的不够纯熟，无法催运出[31m穹苍血球[0m，须70级。\n");      
        if( me->query_skill("superforce",1) < 220 )             
           return notify_fail("你浑天宝鉴心法的火侯尚未足够，须220级。\n");       
                                                                                
        if(!(ob=me->query_temp("weapon")))                                        
        {
            if(me->query_temp("secondary_weapon"))
            return   notify_fail("不空手怎么将[31m穹苍血球[0m聚于手上?\n");
        }
        if(ob=me->query_temp("weapon"))                                         
        {                                                                       
 if((string)ob->query("skill_type") != "unarmed")
            return   notify_fail("不空手怎么将[31m穹苍血球[0m聚于手上?\n");                      
        }                                                                     
        if(me->query("force")<500)                                            
            return notify_fail("你的内力不够。\n");              
        if(me->query("kee")<180)                                      
            return notify_fail("你的气不够。\n");
                                                                                
        if(!me->is_fighting(target))        
        {                                                                       
            tell_object(me,"[31m穹苍血球[0m唯在战斗中才能使用。\n");
            return 1;
        }                                                                       
        message_vision("\t\t$N体外[31m血红的气劲[0m随意而走,\n\t\t只见$N身旁的[31m血红色蒸气[0m越来越浓厚!!\n\t\t$N大喝一声,努力将气劲聚于手掌之上, 形成了一团\n\t\t直径寸许\的[31m血球[0m!!!\n\n",me,target);
        message_vision("$N运劲于双掌，使劲一推,[31m穹苍血球[0m朝敌人狂奔而去!\n",me,target);                 
                                                                                
        me->add("kee",-(hurt_value/20));
        me->add("force",-(hurt_value/4));
        if(70>random(100))
        {                                                                       
        message_vision("$n一见躲避已经无望，运起护身气劲硬接下这团[31m血球[0m，无奈[31m血穹苍气劲[0m太猛，护身气劲惨遭震碎，霎时高热的血焰焚烧$n的全身，血液好似被蒸发而出!\n",me,target);
        target->receive_damage("kee",hurt_value);
        target->add("force",-hurt_value/6);
        COMBAT_D->report_status(target);                                
        }                                                                       
        else                                                                    
        {                                                                         
        message_vision("$n以全身的内力组成气墙，与[0m血穹苍气劲[0m互斗，[砰]的一声，被震退数步，口吐鲜血。\n",me,target);                                                                            
        message_vision( NOR,me);                                        
        target->receive_damage("kee",hurt_value/10);
        target->add("force",-hurt_value/10);
        COMBAT_D->report_status(target);                                
        }                                                                        
        message_vision("[31m「穹苍血球”[0m使出后，$N内力大量耗损、[36m心坎穴[0m骤然剧痛，$N黯然跌坐在地\n",me,target); 
     me->start_busy(1);
        if(lv1 < 150) function_improved("blood",random(500));
        message_vision( NOR,me);                                                
        return 1;                                                               
}                                                                               
