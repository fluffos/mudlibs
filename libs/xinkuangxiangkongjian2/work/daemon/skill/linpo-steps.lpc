// linbo-steps.c
#include <ansi.h>
inherit SKILL;

string *dodge_msg =
({
"$n展开[1;36m‘凌波微步’[0m，左足跨出，既踏[1m「中孚”[0m，立转[1m「既济”[0m，[1;33m「神光离合，乍阴乍阳”[0m，斜斜的躲过$N。\n",
"只见$n施展[1;36m‘凌波微步’[0m，甫上[1m「泰”[0m位，一个转身，右脚踏上[1m「蛊”[0m位，[1;33m「体迅飞鹫，飘忽若神”[0m，反而绕到$N身后。\n",
"$n踏出[1;36m‘凌波微步’[0m，足下自然而然自[1m「井”[0m位斜行，踏到了[1m「讼”[0m位，[1;33m「涑轻躯以鹤立，若将飞而未翔”[0m，轻轻松松地躲过$N的招式。\n",
"$n使出[1;36m‘凌波微步’[0m，自[1m「豫”[0m位踏[1m「观”[0m位，[1;33m「翩若惊鸿，婉若游龙”[0m，闪身从$N身旁绕过。\n",
"$n展现[1;36m‘凌波微步’[0m，跟着斜踏[1m「蛊”[0m位，[1;33m「忽焉纵体，以遨以嘻”[0m，身子轻轻飘了开去。\n",
"$n斜踏[1;36m‘凌波微步’[0m，忽高忽低，有若[1;33m「髣佛兮若轻云之蔽月，飘飘兮若流风之回雪”[0m般。\n",
});

int valid_enable(string usage)
{
        return (usage=="dodge")||(usage=="move");
}

int valid_learn(object me)
{
        if(me->query_skill("literate",1)*2 <= me->query_skill("linpo-steps",1))
        {
          write("你的知识不足，无法体会凌波微步中易经六十四卦的精要变化。\n");
          return 0;
        }
        return 1;
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if((int)me->query("kee")<5)
                return notify_fail("你的气不够，不能练凌波微步。\n");
        me->receive_wound("kee",5);
        return 1;
}
/*希望能设计成考虑以下
1.出口的个数
2.敌人的exp和自己的exp
3.是否真的有使用linpo-steps在dodge and move上
*/
int can_flee(object me,int exit_number)
{
    object *enemy;
    int i,enemy_num,enemy_exp,me_exp,ratio;

    if(!me) return 0;
    if(!me->query("marks/linpo-steps")) return 0;
    if(me->query("force") <100) return 0;
    if(me->query_skill_mapped("dodge") != "linpo-steps" ||
       me->query_skill_mapped("move") != "linpo-steps") return 0;
    enemy=me->query_enemy();
   if(!sizeof(enemy)) return 0;
/*
    if(sizeof(enemy) <1){
     message_vision(
"$N忽然领悟"HIC"‘凌波微步’"NOR"的要旨所在，脚步作到"HIY"「动无常则，若危若安，进止难期，
若往若还”"NOR",霎时一片人影纷飞，让敌人头昏眼花\n",me);
     message_vision(HIM"$N"HIM"看准时机，使出凌波微步，逃离战圈!!\n"NOR,me);
     return 1;
    }
*/
    me_exp=me->query("combat_exp");
    enemy_exp=0;
    enemy_num=0;
    for(i=0;i<sizeof(enemy);i++){
      if(!enemy[i]) continue;
      if(enemy[i]->query("combat_exp") < (int)(me_exp*2/3)) continue;
      enemy_exp+=enemy[i]->query("combat_exp");
      enemy_num++;
    }
    if(!enemy_num){
     message_vision(
"$N忽然领悟"HIC"‘凌波微步’"NOR"的要旨所在，脚步作到"HIY"「动无常则，若危若安，进止难期，
若往若还”"NOR",霎时一片人影纷飞，让敌人头昏眼花\n",me);
     message_vision(HIM"$N"HIM"看准时机，使出凌波微步，逃离战圈!!\n"NOR,me);
     return 1;
    }
    enemy_exp/=enemy_num;
    if(exit_number >=4) ratio=100;
    if(exit_number ==3) ratio=82;
    if(exit_number ==2) ratio=66;
    if(exit_number ==1) ratio=50;
    if(exit_number ==0) return 0;
    if(!me->is_busy() && ratio > random(110) && me->query("kee")<=(me->query("max_kee")/3)) {
      if(enemy_exp < me_exp * 2){
       message_vision(
"$N 心中默念，将"HIC"‘凌波微步’"NOR"的六十四卦步法，自「明夷”起始，经「贲”
 、「既济”、「家人”，走了一大圈而至「旡妄”，终于顺利摆\脱敌人的纠缠。\n"NOR,me);
        message_vision(HIM"$N"HIM"看准时机，使出凌波微步，逃离战圈!!\n"NOR,me);
        me->add("force",-200);
        return 1;
      }
      else{
        if((100*me_exp/enemy_exp) > random(110)){
          me->add("force",-200);
       message_vision(
"$N 心中默念，将"HIC"‘凌波微步’"NOR"的六十四卦步法，自「明夷”起始，经「贲”
 、「既济”、「家人”，走了一大圈而至「旡妄”，终于顺利摆\脱敌人的纠缠。\n"NOR,me);
          message_vision(HIM"$N"HIM"看准时机，使出凌波微步，逃离战圈!!\n"NOR,me);
          return 1;
        }
      }
    }
    return 0;
}
