#pragma save_binary
// damage.c
#include <ansi.h>
#include <dbase.h>
#include <login.h>
#include <move.h>
#include <combat.h>

int ghost = 0;
int is_ghost() { return ghost; }
int hungryflag = 0;
//type=伤害类型(kee,gin,sen) damage=伤害数值,who=谁造成的伤害,what=功夫造成的伤害还是魔法造成的
//添加string what,主要是为了使魔法师使用魔法的威力大于战士使用魔法的威力
varargs int receive_damage(string type, int damage, object who,string what)
{
        int val,mx,vx,my,vy,xx,yy,attack_distance,exp,pot;

        int ap,dp;
        object weapon,me;
        mapping prepare;
        string attack_skill;
        
        if( damage < 0 ) error("F_DAMAGE: 伤害值为负值。\n");
        if( type!="gin" && type!="kee" && type!="sen" )
            error("F_DAMAGE: 伤害种类错误( 只能是 gin, kee, sen 其中之一 )。\n");

        if( objectp(who) &&
           !userp(this_object())&&
            environment(who) && 
           !environment(who)->query("no_death_penalty") )
        {

            set_temp("last_damage_from", who);
            me=this_object();
            prepare = me->query_skill_prepare();
            if (!prepare) prepare = ([]);

            if( objectp(weapon=me->query_temp("weapon")) )   
                 attack_skill = weapon->query("skill_type");
            else if ( sizeof(prepare) == 0) attack_skill = "unarmed";
            else if ( sizeof(prepare) == 1) attack_skill = (keys(prepare))[0];
            else if ( sizeof(prepare) == 2) 
                  attack_skill = (keys(prepare))[me->query_temp("action_flag")];
            dp=COMBAT_D->skill_power(me,attack_skill,SKILL_USAGE_ATTACK,0)+
            me->query("combat_exp")/4+ COMBAT_D->skill_power(me,"parry",SKILL_USAGE_DEFENSE,0)+
            COMBAT_D->skill_power(me,"dodge",SKILL_USAGE_DEFENSE,0);
            ap=who->query("combat_exp")/2+who->query("force")*10;
            if(ap<dp/2)
            {
                exp=random(damage*2);
                pot=random(damage/2+1);
                if(exp>5000) exp=5000; if(pot>500) pot=500;
                who->add("combat_exp",exp);
                who->add("potential",pot);
            }
            else if(ap<=dp&&random(6)>2)
            {//因为战斗速度减慢了。故获得经验的几率有所提高
                exp=random(damage*4)/2;
                if(exp>5000) exp=5000;
                who->add("combat_exp",exp);
                if(who->query("potential")-who->query("learned_points")<350)
                pot=random(damage/4+1);
                if(pot>500) pot =500;
                who->add("potential",pot);
            }
            else  if(ap>dp&&random(6)==1)
            {
                if(who->query("potential")-who->query("learned_points")<30)
                who->add("potential",random(damage/15+1)+1);
            }
         
	    }
        
        if(objectp(who))
        {
            weapon=who->query_temp("weapon");
            mx=this_object()->query_temp("map/x");
            my=this_object()->query_temp("map/y");
            vx=who->query_temp("map/x");
            vy=who->query_temp("map/y");
            xx=mx-vx;my=my-vy;
            //xx=vx-vy;yy=vx-vy;
            if(xx<0) xx*=-1; if(yy<0) yy*=-1;//me和victim近身
            if(objectp(weapon))
            {
                //远距离武器近身搏斗用,所造成的伤害为原来的4/5
                attack_distance=weapon->query("attack_distance");
                if(attack_distance>=2)//长武器
                {
                    if((xx==1&&yy==0)||(xx=0&&yy=1)||(xx==0&&yy==0))
                    {
                        damage=damage*4/5;
 					    //tell_object(find_player("rongg"),"近身\n");
                    }
                }
            }
            if(what)
            {
                
                if(who->query("occupation"))
                {
                    if(who->query("occupation")=="fighter"&&what=="magic")
                    {//战士使用魔法的威力只有魔法师的3/5
                        damage=damage*3/5;
                
                    }	
                    else if(who->query("occupation")=="enchanter"&&what=="physical")
                    {//魔法师使用肉搏攻击的威力只有战士的3/5
                        damage=damage*3/5;
                
                    }
                }
                else damage=damage*3/5;//没有职业的玩家,这个情况非常极端
            }
	    
	    }
	    if(query_temp("magic_armor"))
	    { //关于魔法盾
	         val=(int)query("atman")-damage/3;
	         if(val<=0)
	         {
	   	          val=0;
	   	          add_temp("magic_armor",-1);
	   	          if(!query("magic_armor"))
                         tell_object(this_object(),HIY"\n你的魔法盾消失了。\n"NOR);
             }
	         set("atman",val);	
        }     
	    else
	    {
         
            val = (int)query(type) - damage;
	        set(type, val);
	    }
        set_heart_beat(1);
        return damage;
}

varargs int receive_wound(string type, int damage, object who,string what)
{
        int val,mx,vx,my,vy,xx,yy,attack_distance;

        object weapon;


        if( damage < 0 ) error("F_DAMAGE: 伤害值为负值。\n");
        if( type!="gin" && type!="kee" && type!="sen" )
            error("F_DAMAGE: 伤害种类错误( 只能是 gin, kee, sen 其中之一 )。\n");

        if( objectp(who) ) 
        {
        	set_temp("last_damage_from", who);
            weapon=who->query_temp("weapon");
            mx=this_object()->query_temp("map/x");
            my=this_object()->query_temp("map/y");
            vx=who->query_temp("map/x");
            vy=who->query_temp("map/y");
            xx=mx-vx;my=my-vy;
            //xx=vx-vy;yy=vx-vy;
            if(xx<0) xx*=-1; if(yy<0) yy*=-1;//me和victim近身
            if(objectp(weapon))
            {
                //远距离武器近身搏斗用,所造成的伤害为原来的4/5
                attack_distance=weapon->query("attack_distance");
                if(attack_distance>=2)//长武器
                {
                    if((xx==1&&yy==1)||(xx==0&&yy==0))
                    {
                        damage=damage*4/5;
                    }
                }
            }

            if(what)
            {
                if(who->query("occupation"))
                {
                    if(who->query("occupation")=="fighter"&&what=="magic")
                    {//战士使用魔法的威力只有魔法师的3/5
                            damage=damage*3/5;
                    }	
                    else if(who->query("occupation")=="enchanter"&&what=="physical")
                    {//魔法师使用肉搏攻击的威力只有战士的3/5
                           damage=damage*3/5;
                    }
                }
                else damage=damage*3/5;//没有职业的玩家,这个情况非常极端
            }
    	
        }
        if(query_temp("magic_armor"))
    	{ //关于魔法盾
            val=(int)query("atman")-damage/2;
	        if(val<=0) 
	        {
	            val=0;
	   	        add_temp("magic_armor",-1);
	   	        if(!query("magic_armor"))
                     tell_object(this_object(),HIY"\n你的魔法盾消失了。\n"NOR);
	        }
	        set("atman",val);	
	    }
	    else
	    {


	         val = (int)query("eff_" + type) - damage;
             set("eff_" + type, val);
             if( (int)query(type) > val ) set(type, val);

        }
        set_heart_beat(1);
        return damage;
}

int receive_heal(string type, int heal)
{
    int val;

    if( heal < 0 ) error("F_DAMAGE: 恢复值为负值。\n");
    if( type!="gin" && type!="kee" && type!="sen" )
        error("F_DAMAGE: 恢复种类错误( 只能是 gin, kee, sen 其中之一 )。\n");

    val = (int)query(type) + heal;

    if( val > (int)query("eff_" + type) ) set(type, (int)query("eff_" + type));
    else set( type, val );

    return heal;
}

int receive_curing(string type, int heal)
{
    int max, val;

    if( heal < 0 ) error("F_DAMAGE: 恢复值为负值。\n");
    if( type!="gin" && type!="kee" && type!="sen" )
        error("F_DAMAGE: 恢复种类错误( 只能是 gin, kee, sen 其中之一 )。\n");

    val = (int)query("eff_" + type);
    max = (int)query("max_" + type);

    if( val + heal > max ) {
        set("eff_" + type, max);
        return max - val;
    } else {
        set( "eff_" + type, val + heal);
        return heal;
    }
}

void unconcious()
{
    object defeater;

    remove_call_out("revive");
    if( !living(this_object()) ) return;
    if( wizardp(this_object()) && query("env/immortal") ) return;

    if( objectp(defeater = query_temp("last_damage_from")) )
        COMBAT_D->winner_reward(defeater, this_object());
        COMBAT_D->loser_penalty(defeater, this_object());
    if( ! this_object()->query("possessed"))
    this_object()->remove_all_enemy();

    //Add by Junhot for XBTXIII
    //战斗中，在晕倒时解冻屏幕。
	if(this_object()->query_temp("FRELINE")==1) 
	{
	    this_object()->delete_temp("FRELINE");
	    tell_object(this_object(),ESC+"[r"+TOBOT(50));
	}

    message("system", HIR "\n你的眼前一黑，接著什麽也不知道了....\n\n" NOR,
        this_object());
    this_object()->disable_player(" <昏迷不醒>");
/*
        if(userp(this_object()))
        {
        this_object()->delete_temp("apply/short");
        this_object()->set_temp("apply/short",({this_object()->short()+HIR"<昏迷不醒>"NOR}));
        }
*/
    set("gin", 0);
    set("kee", 0);
    set("sen", 0);
    set_temp("block_msg/all", 1);
    set_temp("disable_command", 1);
    COMBAT_D->announce(this_object(), "unconcious");

    call_out("revive", random(50 - (int) this_object()->query_con()) + 10);
}

varargs void revive(int quiet)
{


        if( (int) this_object()->query("gin") < 0 ) this_object()->set("gin",0);
        if( (int) this_object()->query("kee") < 0 ) this_object()->set("kee",0);
        if( (int) this_object()->query("sen") < 0 ) this_object()->set("sen",0);
    if( !quiet ) {
        COMBAT_D->announce(this_object(), "revive");
        set_temp("block_msg/all", 0);
        delete_temp("disable_command");
//       this_object()->delete_temp("apply/short");
		message("system", HIY "\n慢慢地你终於又有了知觉....\n\n" NOR,this_object());
    } else
        set_temp("block_msg/all", 0);
        delete_temp("disable_command");
        this_object()->enable_player();
// 把这个循环移到最后。防止某些时候被mudos终止了循环。
    while( environment()->is_character() )
        this_object()->move(environment(environment()));
	    remove_call_out("revive");

}
void be_ghost(int flag)
{
    ghost = flag;
}
void die()
{
    object corpse, killer;

    if(previous_object(0)&&
       previous_object(0)!=this_object()&&
       userp(this_object())){
        log_file("nosave/call_die",
		sprintf("die()函数被%s调用,调用对象是%s,时间是%s\n",
		base_name(previous_object(0)),this_object()->query("id"),ctime(time())));

    }
    remove_call_out("revive");
    if( !living(this_object())||query_temp("disable_command") ) revive(1);
    if( wizardp(this_object()) && query("env/immortal") ) return;
    if( environment(this_object())->query("no_die") ) 
            {       environment(this_object())->die_in_here(this_object());
                    return;
            }

    COMBAT_D->announce(this_object(), "dead");
    if(userp(this_object()))
		{
	    set_temp("block_msg/all", 0);
    	this_object()->enable_player();
        this_object()->delete_temp("disable_command");
		}
    if( objectp(killer = query_temp("last_damage_from")) ) {
        set_temp("my_killer", killer->query("id"));
        set_temp("my_killer_name", killer->query("name"));
        REWARD_D->killer_reward(killer, this_object());
    }
    if(userp(this_object()))
    REWARD_D->victim_penalty(this_object());
    
    if( objectp(corpse = CHAR_D->make_corpse(this_object(), killer)) )
        corpse->move(environment());

    this_object()->remove_all_killer();
    all_inventory(environment())->remove_killer(this_object());

    this_object()->dismiss_team();
    if( userp(this_object()) ) {
        set("gin", 1);  set("eff_gin", 1);
        set("kee", 1);  set("eff_kee", 1);
        set("sen", 1);  set("eff_sen", 1);
        set("force",0);
        ghost = 1;
        this_object()->save();
        this_object()->move(DEATH_ROOM);
        DEATH_ROOM->start_death(this_object());
                this_object()->delete_temp("last_damage_from");
    } else
        destruct(this_object());

}

void reincarnate()
{
    ghost = 0;
    set("eff_gin", query("max_gin"));
    set("eff_kee", query("max_kee"));
    set("eff_sen", query("max_sen"));
}

int max_food_capacity() { return query_weight() / 200; }

int max_water_capacity() { return query_weight() / 200; }

int heal_up()
{
    int update_flag;
    mapping my;

    update_flag = 0;

    my = query_entire_dbase();

    if( my["water"] > 0 )//14岁无需为食物,饮水发愁
    {
    	 if(my["mud_age"]>=86400)    my["water"] -= 1;
    	 update_flag++;
    	 
    }
    if( my["food"] > 0 )
    {
    	 if(my["mud_age"]>=86400)    my["food"] -= 1;
    	 update_flag++; 
    }

    if (userp(this_object())&&my["potential"]-my["learned_points"]<0)
    this_object()->set("potential",my["learned_points"]);

    if( my["water"] < 1 && userp(this_object()) ) return update_flag;
//  if( my["food"] < 1 && userp(this_object()) ) return update_flag;
    if( this_object()->is_fighting() ) return 0;

    
    my["gin"] += my["spi"]  + my["atman"] / 10;
    if( my["gin"] >= my["eff_gin"] ) {
        my["gin"] = my["eff_gin"];
        if( my["eff_gin"] < my["max_gin"] ) { my["eff_gin"] ++; update_flag++; }
    } else update_flag++;

    my["kee"] += my["con"]  + my["force"] / 10;
    if( my["kee"] >= my["eff_kee"] ) {
        my["kee"] = my["eff_kee"];
        if( my["eff_kee"] < my["max_kee"] ) { my["eff_kee"] ++; update_flag++; }
    } else update_flag++;

    my["sen"] += my["int"]  + my["mana"] / 10;
    if( my["sen"] >= my["eff_sen"] ) {
        my["sen"] = my["eff_sen"];
        if( my["eff_sen"] < my["max_sen"] ) { my["eff_sen"] ++; update_flag++; }
    } else update_flag++;

    if( my["food"] < 1 && userp(this_object()) ) return update_flag;

    if( my["max_atman"] && my["atman"] < my["max_atman"] ) {
        my["atman"] += (int)this_object()->query_skill("magic", 1) / 2;
        if( my["atman"] > my["max_atman"] ) my["atman"] = my["max_atman"];
        update_flag++;
    }

    if( my["max_force"] && my["force"] < my["max_force"] ) {
        my["force"] += (int)this_object()->query_skill("force", 1) / 2;
        if( my["force"] > my["max_force"] ) my["force"] = my["max_force"];
        update_flag++;
    }

    if( my["max_mana"] && my["mana"] < my["max_mana"] ) {
        my["mana"] += (int)this_object()->query_skill("spells", 1) / 2;
        if( my["mana"] > my["max_mana"] ) my["mana"] = my["max_mana"];
        update_flag++;
    }
    hungryflag++;//饥饿标志.不用每次heal_up的时候都警告一下
    if(hungryflag>10&&!wizardp(this_object())){
    	hungryflag=0;
    	if(my["food"] <= 10)
    		tell_object(this_object(), HIY"你饿得头晕眼花，看来要赶快找点吃的了。\n"NOR);
    	if(my["water"] <= 10)
		tell_object(this_object(), HIY"你渴得喉咙冒烟，看来要赶快喝点什么了。\n"NOR);
        
    //  if(random(20)==1&&!this_object()->is_fightning()){
    //          message_vision("$N饿的晕了过去。\n");
    //          this_object()->unconcious();
    //    }
    }
    return update_flag;
}

