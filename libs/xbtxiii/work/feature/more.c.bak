#pragma save_binary
// more.c


#include <ansi.h>

void more(string cmd, string *text, int line)
{
	int i;

	switch(cmd) {
		case "":
			for(i=line + 23; line<sizeof(text) && line<i; line++)
				write(text[line] + "\n");
			if( line>=sizeof(text) ) return;
			break;
	case "b":
	line = line - 46;
	if(line<-22) return;
	for(i=line + 23; line < i;line++)
		write(text[line]+"\n");
	break;
		case "q":
			return;
	}
	printf(HIC"== 未完继续 " HIY "%d%%"HIC"== ("HIY"ENTER "NOR+HIC"继续下一页，"HIY"q"NOR+HIC"离开，"HIY"b"NOR+HIC"前一页)"NOR,
		(line*100/sizeof(text)) );
	input_to("more", text, line);
}

void start_more(string msg)
{
	if(sizeof(msg)==0){
	    printf("文件太大无法使用start_more()查看或着文件本身无内容\n");
	    return;
	}
	more("", explode(msg, "\n"), 0);
}
