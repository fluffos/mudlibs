#pragma save_binary

// finance.c

// can_afford() checks if this_object() can afford a price, it returns:
//
//      0:      cannot afford.
//      1:      can afford with proper money(coins).
//      2:      can afford, but don't have enough proper money(coins).
//
int can_afford(int amount)
{
        int total;
        object tencash,cash,gold, silver, coin;

        tencash = present("tenthousand-cash_money",this_object());
        cash = present("thousand-cash_money",this_object());
        gold = present("gold_money",this_object());
        silver = present("silver_money",this_object());
        coin = present("coin_money",this_object());

        total = 0;
        if( tencash) total += tencash->value();
        if( cash) total += cash->value();
        if( gold ) total += gold->value();
        if( silver ) total += silver->value();
        if( coin ) total += coin->value();

        if( total < amount ) return 0;

        else return 1;

        return 0;
}

int pay_money(int amount)
{
        int total,num;
        object tencash,cash,gold, silver, coin;
	if(amount<=0)
	    return 1;
        tencash = present("tenthousand-cash_money",this_object());
        cash = present("thousand-cash_money",this_object());
        gold = present("gold_money",this_object());
        silver = present("silver_money",this_object());
        coin = present("coin_money",this_object());

        total = 0;
	if( tencash) total += tencash->value();
     	if( cash) total += cash->value();
        if( gold ) total += gold->value();
        if( silver ) total += silver->value();
        if( coin ) total += coin->value();

        if( total < amount ) return 1;

	if(coin) {
		amount-=coin->query_amount();
		if(amount>=0) coin->set_amount(0);
		else { 
			coin->set_amount(-amount);
			amount=0;
		}
	}
	if((amount%100)>0){
		if(coin) num=coin->query_amount();
		else num=0;
		if(   (amount%100) > num ) {
			num+=100-(amount%100);
			amount+=100;
		} else num-=amount%100;
		if(coin) destruct(coin); 
		coin=new("/obj/money/coin");
		coin->move(this_object());
		coin->set_amount(num);
	}
	amount/=100;
	if(silver) {
		amount-=silver->query_amount();
		if(amount>=0) silver->set_amount(0);
		else { 
			silver->set_amount(-amount);
			amount=0;
		}
	}
	if((amount%100)>0){
		if(silver) num=silver->query_amount();
		else num=0;
		if(   (amount%100) > num ) {
			num+=100-(amount%100);
			amount+=100;
		} else num-=amount%100;
		if(silver) destruct(silver); 
		silver=new("/obj/money/silver");
		silver->move(this_object());
		silver->set_amount(num);
	}
	amount/=100;
	if(gold) {
		amount-=gold->query_amount();
		if(amount>=0) gold->set_amount(0);
		else { 
			gold->set_amount(-amount);
			amount=0;
		}
	}
	if(amount%10){
		if(gold) num=gold->query_amount();
		else num=0;
		if(   (amount%10) > num ) {
			num+=10-(amount%10);
			amount+=10;
		} else num-=amount%10;
		if(gold) destruct(gold); 
		gold=new("/obj/money/gold");
		gold->move(this_object());
		gold->set_amount(num);
	}
	amount/=10;
	if(cash) {
		amount-=cash->query_amount();
		if(amount>=0) cash->set_amount(0);
		else { 
			cash->set_amount(-amount);
			amount=0;
		}
	}
	if(amount%10){
		if(cash) num=cash->query_amount();
		else num=0;
		if(   (amount%10) > num ) {
			num+=10-(amount%10);
			amount+=10;
		} else num-=amount%10;
		if(cash) destruct(cash); 
		cash=new("/obj/money/thousand-cash");
		cash->move(this_object());
		cash->set_amount(num);
	}
	amount/=10;
	if(tencash) {
		tencash->add_amount(-amount);
		amount=0;
	}
    if( amount > 0 ) return -1;
	return 1;
}

