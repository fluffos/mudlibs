#pragma save_binary
#include <ansi.h>

// edit.c

int edit(function callback) {
  write("结束离开用" + FLASH + WHT + "." + NOR + "，取消输入用 " + FLASH + WHT + "~q" + NOR + "，使用内建列编辑器用" + FLASH + WHT + " ~e" + NOR + "。\n");
  write("—————————————————————————————\n");
  input_to("input_line", "", callback);
  return 1;
}

void input_line(string line, string text, function callback) {
  if (this_object()->query_temp("is_Big5")) text = LANGUAGE_D->Big52GB(text);
  if (line == ".") {
    (* callback)(text);
    return;
  } else if (line == "~q") {
    write("输入取消。\n");
    return;
  } else if (line == "~e") {} else
    text += line + "\n";
  input_to("input_line", text, callback);
}
