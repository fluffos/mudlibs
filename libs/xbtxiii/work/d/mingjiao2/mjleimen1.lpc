#include <room.h>
inherit ROOM;

void create()
{
    set("short", "门口");
    set("long",
"前面就是明教的“雷字门”了，这里是明教中西域弟子修炼的地\n"
"方。西域风俗大异中土，他们的生活习惯以及使用物品也与中土\n"
"迥异。\n"
);
    set("exits", ([
        "enter" : __DIR__"sushe",
        "northeast" : __DIR__"mjleimen",
    ]));
    set("no_clean_up", 0);
    set("outdoors", "mingjiao");
    setup();
    replace_program(ROOM);
}
