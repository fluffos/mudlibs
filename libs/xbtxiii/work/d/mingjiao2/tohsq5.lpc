//TOHSQ5.C

inherit ROOM;

void create() {
  set("short", "山路");
  set("long",
    "水声越来越大，山间充满了浓浓的水气。山路上，断裂的山隙中，\n"
    "都流出一道道细细的泉水，汇成一股澄碧的小溪，向山下蜿蜒流\n"
    "去。周围绿意荡漾，鸟语鹦声，如置身仙境。\n"
  );
  set("exits", ([
    "north": __DIR__ "tohsq6",
    "south": __DIR__ "tohsq4",
  ]));
  set("outdoors", "mingjiao");
  set("no_clean_up", 0);
  setup();
}
