//RJQMEN.C

inherit ROOM;

void create() {
  set("short", "侧门");
  set("long",
    "这是锐金旗的一个侧门，大概只容得下一个人进出，每个教众到\n"
    "此，都必须出示一张腰牌，才可进入。\n"
  );
  set("exits", ([
    "enter": __DIR__ "rjqyuan",
    "east": __DIR__ "torjq3",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "mingjiao");
  setup();
}
