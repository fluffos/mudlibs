//room: /d/mingjiao/qiandian.c
inherit ROOM;

void init();

void create() {
  set("short", "明教前殿");
  set("long",
    "你来到这里，放眼窗外望去，漫漫昆仑雪山，晶莹剔透，苍天浩\n"
    "浩，白云悠悠。东方沃野千里，楚天辽阔；西面高山巍巍，迤逦\n"
    "万里。这里就是叱咤武林八百年的明教总舵的前殿。\n"
  );
  set("exits", ([
    "east": __DIR__ "eastdian",
    "west": __DIR__ "westdian",
    "north": __DIR__ "dadian",
    "southdown": __DIR__ "square",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
