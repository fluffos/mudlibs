int valid_enable(string usage) { return usage=="unarmed" ||  usage=="parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练九阴白骨爪必须空手。\n");
    if ( (int)me->query_skill("sun-force",1) < 30 )
        return notify_fail("你的九阳神功火候不足，无法继续修习九阴白骨爪。\n");
    if ( (int)me->query_skill("sun-force",1) < (int)me->query_skill("jiuyin-strike",1) )
       return notify_fail("你还是先练习九阳神功吧，否则会走火入魔的。\n");
    if ((int)me->query("max_force") < 150)
        return notify_fail("你的内力太弱，无法修习九阴白骨爪。\n");
	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action); i > 0; i--)
		if(level >= action[i-1]["lvl"])
			return action[i-1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
    level = (int)me->query_skill("jiuyin-strike",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[random(i)];

}


int practice_skill(object me)
{
	if ((int)me->query("kee") < 30)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("force") < 20)
        return notify_fail("你的内力不够，无法练习九阴白骨爪。\n");
	me->receive_damage("kee", 30);
	me->add("force", -10);
	return 1;
}
void skill_improved(object me)
{
    if( (int)me->query_skill("jiuyin-strike",1) % 10 == 0 ) {
    tell_object(me,
      RED "\n你突然恶向胆边生，很想冲出去杀几个人。\n\n" NOR );
    me->add("bellicosity",800);
    }else
    me->add("bellicosity",100);
}
