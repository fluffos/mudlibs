//  ninemoon_book.c

inherit ITEM;

void create()
{
    set_name("九阴真经", ({ "jiuyin_book" }) );
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
                set("no_get",1);
                set("no_drop",1);
		set("long",
            "这是一本看起来很旧的书，封面上写着四个篆字：九阴真经。\n");
		set("value", 1000);
		set("material", "paper");
		set("skill", ([
            "name" :   "jiuyin-strike",
            "exp_required" : 100000,
											// to learn this skill.
            "sen_cost" : 60,
			"difficulty":	30,				// the base int to learn this skill
											// modify is gin_cost's (difficulty - int)*5%
			"max_skill":	100,				// the maximum level you can learn
			"min_skill":	0				// the maximum level you can learn
											// from this object.
		]) );
	}
}
int query_autoload() { return 1; }
