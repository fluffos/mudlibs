// ninesun_book.c

inherit ITEM;

void create() {
  set_name("九阳真经", ({ "jiuyang_book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("no_drop", 1);
    set("long",
      "一本破旧的小册子，只有几页，看起来平平常常的，没什么特别。\n");
    set("value", 1000);
    set("material", "paper");
    set("skill", ([
      "name": "sun-force",
      "exp_required": 50000,
      // to learn this skill.
      "sen_cost": 60,
      "difficulty": 30,    // the base int to learn this skill
      // modify is gin_cost's (difficulty - int)*5%
      "max_skill": 100,    // the maximum level you can learn
      "min_skill": 0    // the maximum level you can learn
      // from this object.
    ]));
  }
}
int query_autoload() { return 1; }
