//haitang.c


#include <ansi.h>

inherit NPC;

inherit F_MASTER;

void create() {
  set_name("铁海棠", ({ "tie haitang", "tie", "haitang" }));
  set("title", "普通百姓");
  set("nickname", HIC "天下第一剑" NOR);
  set("gender", "男性");
  set("age", 44);
  set("str", 27);
  set("cor", 30);
  set("cps", 27);
  set("int", 24);

  set("max_force", 1500);
  set("force", 1500);
  set("force_factor", 30);
  set("long",

    "铁海棠当年在京师名声赫赫，曾经仗着一把竹剑大败天下各大门派中的\n"
    "的剑术高手，因此得了个“天下第一剑”的美誉。\n");

  create_family("逍遥派", 1, "开山祖师");
  set("combat_exp", 1500000);
  set("score", 200000);

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword.counterattack" :),
    (: perform_action, "sword.swordjab" :),
    (: perform_action, "sword.powerfocus" :),
    (: perform_action, "sword.fakefault" :),
  }));

  set_skill("unarmed", 100);
  set_skill("parry", 120);
  set_skill("dodge", 100);
  set_skill("sword", 150);
  set_skill("force", 60);
  set_skill("literate", 60);

  set_skill("fonxanforce", 90);
  set_skill("fonxansword", 140);
  set_skill("celestrike", 100);
  set_skill("chaos-steps", 100);

  map_skill("unarmed", "celestrike");
  map_skill("force", "fonxanforce");
  map_skill("sword", "fonxansword");
  map_skill("parry", "fonxansword");
  map_skill("dodge", "chaos-steps");
  map_skill("move", "chaos-steps");

  set("chat_chance", 10);
  set("chat_msg", ({
    ( : this_object(), "random_move" : ),
    "铁海棠说道：这里是本楼重地，你不要乱走哦，出了事我可担当不起。\n",
    "铁海棠叹了口气，说道：老夫一身功夫，竟找不到一个传人，唉。。\n",
    "铁海棠说：这由我负责，你有问题可以问我。\n",
    "铁海棠叹了口气，说道：珍珑棋局很难破的，唉。。。\n",
  }));

  set("inquiry", ([
    "铁海棠": "在下铁海棠，奉楼主之命看守此地。",
    "name": "我就是铁海棠，阁下有问题尽管问我。",
    "here": "这里是金风细雨楼重地，你千万不可乱闯，否则会后悔的。",
    "珍珑棋局": "要破珍珑棋局必须找黑白子，你觉得运气不错吗？",
  ]));

  setup();
  carry_object("/d/chuenyu/obj/hengbing")->wield();
  carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object ob) {
  if (((int)ob->query("spi")
    < 25)
    || ((int)ob->query("kar")
      < 25)) {
    command("look " + ob->query("id"));
    command("sigh");
    command("say 这位" + RANK_D->query_respect(ob) +
      "缘分不够啊，可惜可惜，我看你还是回去吧。\n");
    return;
  }
  command("haha");
  command("say 很好，" + RANK_D->query_respect(ob) +
    "很有诚意，无奈老夫年事已高，无法传你功夫，\n"
    "也罢，看在你我有缘的份上，这就送你去见黑白子吧。\n");
  ob->set("marks/铁海棠", 1);
  ob->move("/d/jinfeng/blackroom");
}
