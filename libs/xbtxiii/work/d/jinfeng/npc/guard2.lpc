//guard2.c

inherit NPC;

void create() {
  set_name("丁白云", ({ "guard" }));
  set("title", "金风细雨楼门卫");
  set("nickname", "追风剑");
  set("gender", "男性");
  set("age", 22);
  set("long", @LONG
丁白云是这里的门卫，一手快剑在这一带很有名气。
LONG);
  set("combat_exp", 250000);

  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 10);
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("sword", 100);
  set_skill("six-chaos-sword", 100);
  set_skill("dodge", 100);

  map_skill("sword", "six-chaos-sword");
  map_skill("parry", "six-chaos-sword");
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wield();
}
