//ape.c----猿

inherit NPC;

void create() {
  set_name("大白猿", ({ "ape" }));
  set("long", "一只很大的白猿，正一边烦躁地跳动，一边发出怒吼。\n");

  set("race", "野兽");
  set("age", 100);
  set("attitude", "aggressive");

  set("max_gin", 300);
  set("max_kee", 1500);
  set("max_sen", 300);

  set("str", 30);
  set("cor", 70);
  set("spi", 20);
  set("int", 10);

  set("limbs", ({ "头部", "躯干", "尾巴" }));
  set("verbs", ({ "bite" }));

  set_temp("apply/attack", 30);
  set_temp("apply/damage", 10);
  set_temp("apply/armor", 50);
  set_temp("apply/dodge", 80);

  set("combat_exp", 230000);
  set("score", 1000);
  setup();
}


void die() {
  object killer, obj;

  killer = query_temp("last_damage_from");
  obj = new("/d/jinfeng/obj/ninesun_book");
  obj->move(this_object());
  return ::die();
}
