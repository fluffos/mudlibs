
// old woman.c ----老妇人

inherit NPC;

void create()
{
    set_name("老妇人", ({ "old woman","old","woman"}) );
    set("long","一个看起来十分朦胧的高大身影，浑身上下弥漫着逼人的杀气。");
    set("gender","女性" );
	set("age", 62);
    set("attitude","heroism");
	set("str", 20);
	set("cor", 26);
	set("cps", 26);
	set("per", 29);
      set("combat_exp",1500000);
      set("score", 1000);
      set_skill("dodge",100);
      set_skill("stormdance",100);
      set_skill("unarmed",120);
      set_skill("jiuyin-strike",120);
      map_skill("dodge","stormdance");
      map_skill("unarmed","jiuyin-strike");
      set("force", 1000);
      set("max_force", 800);
      set("force_factor", 10);

      setup();
      carry_object("/obj/cloth")->wear();
}

void init()
{
     object ob;
     ::init();
     if(interactive (ob = this_player()) && !is_fighting() ){
     remove_call_out("greeting");
     call_out("greeting",1,ob);
     }
}

void greeting (object ob)
{
     if( (int)ob->query("marks/book") == 0) {
     command("say 这地方你也敢来？去死吧！！！\n\n");
     kill_ob(ob);
     }
}

int accept_object(object me, object ob)
{
         object book;
         if( (string)ob->query("name") !="九阴真经") 
         {
         command("angry");
         command("say 拿这东西来戏弄我，想找死吗？\n");
         }
         else{
         command("sigh");
         say("这位" + RANK_D->query_respect(me) + "，难得你如此侠肝义胆，
老身感激不尽！也罢，老身无以为谢，
这本小册子你且收着，勿告他人，切记！\n\n");
         book = new("/d/jinfeng/obj/ninemoon_book");
         book->move(me);	
         me->set("marks/book",0);
// destruct(this_object());
      }
	return 1;	
}
