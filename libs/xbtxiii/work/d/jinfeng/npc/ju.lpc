//ju.c

inherit NPC;

#include <ansi.h>

void create() {
  set_name("小菊", ({ "xiao ju", "ju" }));
  set("long",
    "一位玉雪可爱的小姑娘，正对你一边眨眼睛，一边做鬼脸。\n"
  );
  set("title", "金风细雨楼侍女");
  set("nickname", HIC "菊花香满地" NOR);
  set("age", 14);
  set("gender", "女性");
  set("combat_exp", 250000);
  set("env/wimpy", 10);
  set("str", 28);
  set("cor", 28);
  set("cps", 28);
  set("pursuer", 1);
  set("inquiry", ([
    "name": "我就是梅兰竹菊四剑中最小的菊剑喽。",
    "here": "这里是金风细雨楼呀，你一定是来找我们楼主的吧。",
    "小菊": "小菊就是我呀，这名字是楼主取的。",
    "丁丁": "丁丁是我们这的总工程师，负责本楼的维护。",
    "jackii": "jackii就是丁丁呀，你不知道？",
  ]));
  set_skill("dodge", 70);
  set_skill("unarmed", 60);
  set_skill("parry", 70);
  set_skill("sword", 75);

  set_temp("apply/attack", 60);
  set_temp("apply/defense", 60);
  set_temp("apply/damage", 30);

  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/longsword")->wield();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player())) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  command("close door");
  say("小菊说道：请随手关门，谢谢！\n");
}
