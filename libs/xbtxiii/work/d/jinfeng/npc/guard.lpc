// guard.c

inherit NPC;

void create()
{
    set_name("丁清风", ({ "guard" }) );
    set("title", "金风细雨楼门卫");
    set("nickname" , "奔雷刀" );
    set("gender","男性");
    set("age",22);
   set("long",@LONG
丁清风是金风细雨楼的门卫，据说他的春风快意刀在这一带无人能敌。
LONG);
    set("combat_exp" , 250000);

    set("max_force",1000);
    set("force", 1000);
    set("force_factor",10);
    set_skill("unarmed",100);
    set_skill("parry",100);
    set_skill("blade",100);
    set_skill("spring-blade",100);
    set_skill("dodge",100);

    map_skill("blade","spring-blade");
    map_skill("parry","spring-blade");
	setup();
    carry_object("/obj/cloth")->wear();
    carry_object("/obj/weapon/blade")->wield();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
    switch( random(2) ) {
		case 0:
            say( "门卫微笑着对你说道：这位" + RANK_D->query_respect(ob)
                + "，欢迎光临金风细雨楼！ \n");
			break;
		case 1:
            say( "门卫看到你走过来，上前问道：这位" + RANK_D->query_respect(ob)
                + "，你知道皇上要招驸马的消息吗？\n");
			break;
	}
}
