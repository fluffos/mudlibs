//follower.c

inherit NPC;

void consider();

void create()
{
    set_name("接引弟子", ({ "follower" }) );
    set("title","金风细雨楼");
	set("age", 30);
	set("long",
        "接引弟子负责金风细雨楼的接待工作。\n");
	set("attitude", "peaceful");

	set("str", 26);
	set("cor", 30);
	set("int", 24);
	set("cps", 30);

    set("force",500);
    set("max_force",500);
	set("force_factor", 10);

    set("combat_exp",150000);
	set("score", 20000);

	set("chat_msg_combat", ({
         "接引弟子说道：大胆狂徒，敢在这里撒野，不想活了吗？\n",
		(: exert_function, "powerup" :),
		(: exert_function, "recover" :)
	}) );

	set_skill("unarmed", 60);
	set_skill("throwing", 40);
	set_skill("force", 60);
	set_skill("parry", 60);
	set_skill("dodge", 60);
	set_skill("literate", 60);
	set_skill("perception", 80);
        set_skill("celestrike",60);
	set_skill("stormdance", 50);
	set_skill("pyrobat-steps", 60);

         map_skill("unarmed","celestrike");
	map_skill("dodge", "pyrobat-steps");
	map_skill("move", "pyrobat-steps");


	setup();

	carry_object("/obj/cloth")->wear();
}

