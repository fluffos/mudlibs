// black_white.c

inherit NPC;
#include <ansi.h>

string *make_msg1 = ({
  HIY "黑白子将你给他的信打开仔细地看了一下。\n\n" NOR,
  HIY "然后黑白子转过头来注视着你，双眼精光四射。\n\n" NOR,
  HIY "终于，黑白子冲你点了点头，说道：不错，是我师弟的笔迹。\n\n" NOR,
  HIY "不过我看你江湖阅历尚浅，还是过两年再来吧。\n\n" NOR,
});

string *make_msg2 = ({
  HIY "黑白子将你给他的信仔细看了看，微笑着对你说道：\n\n" NOR,
  HIY "阁下天资聪颖，棋技不凡，就请看看这局棋的胜败如何？\n\n" NOR,
  HIY "说着，黑白子将桌子上的黑布掀了起来。\n\n" NOR,
  HIY "现在你可以看(see)了，祝你好运！\n\n" NOR,
});

void create() {
  set_name("黑白子", ({ "old player", "player" }));
  set("gender", "男性");
  set("age", 58);
  set("long", @TEXT
一个身着青衣的老者，背微微有点驼，老眼昏花，但
你发现当他看你的时候，似乎双目闪过一丝精光，随
即又恢复正常了。
他就是传说中曾经在京为官后来突然归隐的一个武林
前辈，据说棋技早已出神入化。
TEXT
  );
  set("combat_exp", 1000000);
  set_skill("unarmed", 130);
  set_skill("dodge", 80);
  set_skill("force", 70);
  //        set_skill("sun-force",85);
  set_skill("sword", 70);
  //        set_skill("jiuyin-strike",130);

  //        map_skill("unarmed", "jiuyin-strike");
  //        map_skill("force","sun-force");

  set("force", 3000);
  set("max_force", 2000);

  set("force_factor", 10);
  set("inquiry", ([
    "珍珑棋局": "就在这里，是我师傅留下的，多年来无一人能解，唉。。。\n",
    "九阳真经": "嗯....早在许多年前，就被人抢走了，据说在某个深山里出现过。\n",
  ]));

  setup();
  carry_object("/obj/cloth")->wear();

}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_look", "see");
  add_action("do_agree", "agree");
}

void greeting(object ob) {
  if ((int)ob->query("marks/铁海棠") == 0) {
    command("say 大胆狂徒，敢闯金风细雨楼禁地，走开！\n");
    ob->move("/d/jinfeng/jiguan");
  }
}

int do_agree(string arg) {
  object *inv, me, obj;
  int n;
  me = this_player();
  inv = all_inventory(me);
  n = sizeof(inv);
  while (n--) {
    if (inv[n]->query("name") == "九阴真经") {
      say("我已经给你一本密芨了，不要贪心喔！\n");
      return 1;
    }
  }
  tell_object(me, "阁下进得去，出得来，真英雄也，佩服佩服！\n");
  tell_object(me, "我这里有一本密芨，赠送于你，好自为之。\n");
  obj = new("/d/jinfeng/obj/book");
  obj->move(me);
  me->set("marks/book", 1);
  me->set("marks/铁海棠", 0);
  return 1;
}

int do_look() {
  object me;
  me = this_player();
  if ((int)me->query("sen") > 80) {
    tell_object(me, "你好奇地看向桌子上棋局，发现那竟是一副珍珑！\n");
    tell_object(me, "黑白双方杀得难解难分，真正到了一着决定胜负的时刻。\n");
    tell_object(me, "突然间你觉得天旋地转，脑海中一片空白！\n");
    me->set("sen", me->query("sen") - 80);
    return 1;
  }
  if ((int)me->query("sen") < 80) {
    tell_object(me, "你定定地看着棋局，只觉得一阵气血翻涌。\n");
    tell_object(me, "一个声音在你耳边说：活着真没劲，还是死了的好。\n");
    tell_object(me, "自杀了吧，快动手呀！动手。。动手。。\n");
    tell_object(me, "恍惚间，黑白子的声音传来：你解不开局中的谜，放弃了吧(agree)？\n");
    return 1;
  }
}

int accept_object(object who, object ob) {
  string objname;
  objname = (string)ob->name();

  if (objname != "推荐书") {
    command("smile");
    say(HIY "你我素无往来，怎好收阁下的东西？啊呀，多谢！\n" NOR);
    command("blush");
    return 1;
  }
  call_out("make_stage", 2, who, 0);
  return 1;
}
void make_stage(object who, int stage) {
  object obj;
  if ((int)who->query("combat_exp") < 100000) {
    tell_object(who, make_msg1[stage]);
    if (++stage < sizeof(make_msg1)) {
      call_out("make_stage", 2, who, stage);
      return;
    }
    who->move("/d/jinfeng/mishi");
  } else {
    tell_object(who, make_msg2[stage]);
    if (++stage < sizeof(make_msg2)) {
      call_out("make_stage", 2, who, stage);
      return;
    }
  }
}
