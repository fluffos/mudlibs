// mei.c

inherit NPC;

#include <ansi.h>

void create()
{
set_name("小梅" , ({"xiao mei","mei"}));
	set("long",
        "一位玉雪可爱的小姑娘，正对你一边眨眼睛，一边做鬼脸。\n"
        );
        set("title","金风细雨楼侍女");
        set("nickname", HIC "点点梅花为谁开" NOR);
        set("age",14);
        set("gender","女性");
	set("combat_exp", 250000);
	set("env/wimpy", 10);
	set("str", 28);
	set("cor", 28);
	set("cps", 28);
	set("pursuer", 1);
    set("chat_chance",8);
    set("chat_msg",({
       "小梅顽皮地对你做个鬼脸。\n",
       "小梅对你说道：写写留言版吧。\n",
       "小梅说：你一定认得我们楼主吧。\n",
       }) );
	set("inquiry", ([
        "name" : "你问我呀，我是梅兰竹菊四剑中的老大，就是梅剑啦。",
        "here" : "这里是金风细雨楼呀，你一定是来找我们楼主的吧。",
        "小梅" : "小梅就是我呀，这名字是楼主取的。",
        "丁丁" : "丁丁是这里的设计师，负责本楼的工程设计和维修。",
        "jackii" : "jackii就是丁丁呀，你不知道？",
	]) );
	set_skill("dodge", 70);
	set_skill("unarmed", 60);
	set_skill("parry", 70);
	set_skill("sword", 75);

	set_temp("apply/attack", 60);
	set_temp("apply/defense", 60);
	set_temp("apply/damage", 30);

	setup();
	carry_object("/obj/cloth")->wear();
	carry_object("/obj/longsword")->wield();
}
