// Room: /restroom.c

inherit ROOM;

void create()
{
	add_light(this_object(),1);
	set("coor",({-40,2870,10}));
	set("short", "休息室");
	set("long",
"你来到环境十分幽雅的休息室，这里是为那些在娱乐厅里玩累了\n"
"的朋友准备的，往沙发上一坐，满身的疲劳都会消失得无影无踪，\n"
"无比地舒服惬意。北面开了一扇大窗，通过它可以尽情欣赏京城\n"
"街景。\n"
);
	set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"yuleroom",
]));

	setup();
	replace_program(ROOM);
}
