// Room2 .c

#include <room.h>
inherit ROOM;


void create()
{
       add_light(this_object(),1);
	set("coor",({-40,2860,20}));
	set("short", "秘密通道入口");
       set("long",
"这是一间宽敞的房间，室内陈设却很简单，东面有一扇铜门，厚\n"
"重的门边站着两个身着绿衫的小姑娘，似乎担负着把守的重任。\n"
"西边是议事大厅。\n"
);
      set("no_fight", 1);
      set("no_magic",1);
      set("exits",([ /* sizeof() == 2 */
          "west" : __DIR__"yishiroom",
          "eastdown" : __DIR__"mishi",
        ]) );
        set("objects",([ /* sizeof() ==2 */
            "/d/jinfeng/npc/zhu" : 1,
            "/d/jinfeng/npc/ju" :1,
        ]) );

        create_door("eastdown","暗门","westup",DOOR_CLOSED);
        setup();
}
