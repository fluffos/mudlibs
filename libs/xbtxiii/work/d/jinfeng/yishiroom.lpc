//yishiroom.c----议事大厅
#include <room.h>

inherit ROOM;

void create()
{
        add_light(this_object(),1);
	set("coor",({-50,2860,20}));
	set("short","议事厅" );
		set("long",
"这里是议事大厅，中央放着两张太师椅，两边排着几列红木椅子，\n"
"厅中间一张巨大的桌子,上面摆着许多看起来象机密文件一样的\n"
"东西，正面的墙上挂了一幅猛虎下山图。东面是一个小房间，西\n"
"边有扇门(door)，楼下就是中央大客厅。\n"
);
        set("item_desc", ([
             "door" : ( : look_door,"west" : ),
            ]) );
        set("exits",([ /* sizeof() == 3 */
                "down" : __DIR__"keting",
                "west" : __DIR__"bedroom",
                 "east" : __DIR__"room2",
		]));

        create_door("west","侧门","east",DOOR_CLOSED);

		set("objects", ([
		]) );


		setup();
		set("no_clean_up", 0);

}

