// Room: /qiroom.c

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -40, 2840, 10 }));
  set("short", "棋室");
  set("long",
    "这里是切磋棋艺的好地方，南首摆着个棋盘，一个老者正坐在棋\n"
    "台旁边苦苦思索着，似乎并没有注意到你的到来。\n"
  );
  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "qinroom",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    "/d/jinfeng/npc/chess_player": 1,
  ]));
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
