// Room: /jiedairoom.c

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -50, 2860, 0 }));
  set("short", "接待室");
  set("long",
    "这里是金风细雨楼的接待室，负责招待来自各地的江湖朋友，南\n"
    "边的厢房是供来访的朋友歇息用的，楼上是可以容纳三百人的中\n"
    "央大客厅。\n"
  );
  set("objects", ([ /* sizeof() == 5 */
    __DIR__ "npc/warrior": 3,
  ]));

  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "room3",
    /*"west" : __DIR__"dingroom",*/
    "north": __DIR__ "gate",
    "up": __DIR__ "keting",
  ]));
  set("no_clean_up", 0);

  setup();
}
