#include <room.h>

inherit ROOM;

void create()
{
	set("short", "禁闭房");
	set("long",
"这间屋子很明亮，四壁空空如也，房间中央放着一张石桌，上面\n"
"蒙着一快很大的黑布，桌旁坐着一个老者，正对着桌上的黑布出\n"
"神，看到有人进来，也只是微微点头致意。黑布下一股杀气逼人\n"
"眉睫，你觉得心跳得更利害了。\n"
);
    set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"blackroom2",
]));

    set("objects", ([ /* sizeof() == 1 */
    "/d/jinfeng/npc/black_white" : 1,
    ]) );

    set("no_magic",1);

	set("no_clean_up", 0);

    create_door("south","牢门","north",DOOR_CLOSED);
    setup();
}
