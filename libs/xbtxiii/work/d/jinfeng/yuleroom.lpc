// Room: /yuleroom.c

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -40, 2860, 10 }));
  set("short", "娱乐室");
  set("long",
    "这是一间娱乐室，地上铺着从波斯运来的毛毯，四周的墙壁挂满\n"
    "了西洋油画，人物栩栩如生，景色变幻万千，让人流连忘返。室\n"
    "内布置考究，各种娱乐设施应有尽有。你坐下休息时，听到一阵\n"
    "优美的乐声从南面传来。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "restroom",
    "south": __DIR__ "qinroom",
    "west": __DIR__ "keting",
    "east": __DIR__ "zoulang1",
  ]));
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
