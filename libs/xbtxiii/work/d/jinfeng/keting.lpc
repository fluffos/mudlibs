// This room is made by dingding.

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -50, 2860, 10 }));
  set("short", "中央客厅");
  set("long",
    "这里是金风细雨楼的大客厅，厅中央一张八仙桌，两排整齐地排\n"
    "列着红木椅子。这里是平时举行大型会议的地方，有时也用来接\n"
    "待远方来的客人，一般都是金风楼主的好友或者武林大豪。正面\n"
    "的墙上挂着一幅关公的画像，旁边好象有首诗(poem)。\n"
  );

  set("item_desc", ([
    "poem": @TEXT
          今 古 英 雄 义 聚
          从 来 奸 邪 难 逃
TEXT
  ]));
  set("exits", ([ /* sizeof() == 3 */
    "east": __DIR__ "yuleroom",
    "up": __DIR__ "yishiroom",
    "down": __DIR__ "jiedairoom",
  ]));
  setup();
  replace_program(ROOM);
}
