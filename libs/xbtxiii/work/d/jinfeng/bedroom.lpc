// Room: bedroom.c

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	set("coor",({-60,2860,20}));
	set("short", "卧室");
	set("long",
"这是一间卧室，靠里面摆着一张床，挨床放着一个古香古色的檀\n"
"木桌(table)，桌上燃着一支檀香，桌子的旁边有个小立柜，你\n"
"注意到这个立柜似乎有些异样。\n"
);
    set("item_desc", ([
      "table" : @TEXT
一张看起来很平常的桌子，似乎没什么特别的。
TEXT
]) );
    set("exits", ([ /* sizeof() == 1 */
     "east" : __DIR__"yishiroom",
]) );
    create_door("east","侧门","west",DOOR_CLOSED);
    setup();
//    set("no_clean_up",0);
//    replace_program(ROOM);
}
int init()
{
   add_action("do_knock","knock");
   add_action("do_push","push");
}


int do_knock(string arg)
{
    object me;
    me=this_player();
    if(arg !="table" ){
       tell_object(me,"你要敲什么？\n");
       return 1;
          }
    tell_object(me,"你轻轻地敲了几下桌子。\n");
    tell_object(me,"你觉得桌边的小立柜(cabinet)似乎动了一下。\n");
    return 1;
}

int do_push( string arg)
{
    object me ;
    me=this_player();
    if(arg !="cabinet") {
    tell_object(me,"你要推什么？\n");
    return 1;
}
    tell_object(me,"你用力推了三下立柜，累得气喘吁吁。\n");
    tell_object(me,"只听轰隆一响，你掉了下去。\n");
    tell_room(environment(me),me->query("name") + "突然消失了！\n",me);
    me->move(__DIR__"mishi");
    return 1;
}
