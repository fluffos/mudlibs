// Room: /jiguan.c

#include <ansi.h>

inherit ROOM;

void create()
{
	set("coor",({-50,2880,-10}));
	set("short", "地下室");
	set("long",
"这里是金风细雨楼的地下室，四周的墙壁上有很多松油灯，柔和\n"
"的光线撒在你的身上，令你产生一种温暖的感觉。周围出奇地静，\n"
"除了自己的心跳声，你几乎什么也听不见。这里的出口很多，该\n"
"往哪儿走呢？\n"
);
	set("exits", ([ /* sizeof() == 5 */
  "north" : __DIR__"jiguan",
  "west" : __DIR__"jiguan",
  "south" : __DIR__"jiguan",
  "east" : __DIR__"jiguan",
]));
    set("objects", ([ /* sizeof() == 1 */
    __DIR__"obj/book" : 1,
    ]) );
	set("no_clean_up", 0);

//  set("no_magic",1);

	setup();
}

void init()
{
   add_action("do_get","get");
}

int die_me(object ob)
{
   int i;
   int damage;
   if( environment(ob) == this_object() )
   {
   message_vision( HIC "一张大网呼地一声飞过来，罩住了$N!\n" NOR, ob);
   message_vision( HIC "接着有无数支羽箭射向$N！\n" NOR ,ob);
   i = (int)ob->query("eff_kee");
   damage = random(100)+50;
   ob->set("eff_kee", (int)i-damage);
   i = (int)ob->query("kee");
   ob->set("kee",(int)i-damage);
   if(environment(ob) == this_object() )
   call_out("die_me",5,ob);
   }
   else

   return 1;
}

int do_get(string arg)
{
   string dir;
   object ob;
   if(!arg || arg == "") return 0;
   if(arg == "book"){
      write("你捡起一本九阴真经！\n");
   if(interactive((ob=this_player())) )
   remove_call_out("die_me");
   call_out("die_me",5,ob);
   return 1;
   }
}
