inherit ROOM;

void create() {
  set("coor", ({ -30, 2870, -10 }));
  set("short", "地下室");
  set("long",
    "这里是金风细雨楼的地下室，四周的墙壁上有很多松油灯，柔和\n"
    "的光线撒在你的身上，令你产生一种温暖的感觉。周围出奇地静，\n"
    "除了自己的心跳声，你几乎什么也听不见。这里的出口很多，该\n"
    "往哪儿走呢？\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "mishi3",
    "south": __DIR__ "mishi2",
    "west": __DIR__ "mishi4",
    "east": __DIR__ "mishi2",
  ]));
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
