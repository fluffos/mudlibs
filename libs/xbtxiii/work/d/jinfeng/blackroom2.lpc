// Room: blackroom2.c

#include <room.h>

inherit ROOM;

void create() {
  set("short", "黑暗房间");
  set("long", @LONG
这是一间非常阴暗的房间，空气中漂浮着一股说不出的味道，一
股凌厉的杀气扑面而来，压迫了你的呼吸，你有一种拔脚就逃的冲动
房间里有个神秘的朦胧身影在不停地走动。
LONG
  );

  set("objects", ([ /* sizeof() ==1 */
    __DIR__ "npc/old_woman": 1,
  ]));

  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "blackroom",
    "west": __DIR__ "mishi",
  ]));
  set("no_clean_up", 0);

  create_door("north", "牢门", "south", DOOR_CLOSED);
  setup();
}
