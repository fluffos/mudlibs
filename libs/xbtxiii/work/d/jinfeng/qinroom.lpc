// Room: /qinroom.c

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -40, 2850, 10 }));
  set("short", "琴房");
  set("long",
    "这是一间琴房，靠窗边一张桌子上放着一架瑶琴，边上还燃着一\n"
    "支檀香，一位天仙也似的美貌女子正在拂琴，叮叮咚咚，曲调悠\n"
    "扬，和谐悦耳，你凝神细听，发现她弹奏的曲子竟好象是“笑傲\n"
    "江湖”，不觉有些痴了。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "qiroom",
    "north": __DIR__ "yuleroom",
  ]));
  set("no_clean_up", 0);

  setup();
}
