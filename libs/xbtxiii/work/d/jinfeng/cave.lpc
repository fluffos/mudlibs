// cave.c -----洞穴

inherit ROOM;

int do_study(string arg);

void create()
{
	set("short", "神秘洞穴");
	set("long",
"洞内黑漆漆的，几乎什么都看不见，只是在一个角落里有两点红\n"
"光闪烁，凭你多年的经验，那一定是一双野兽的眼睛。这个地方\n"
"最好不要久留。\n"
);
	set("objects", ([
        __DIR__"npc/ape" : 1,
	]) ) ;

	set("no_magic", 1);
	setup();
}

void init()
{
    add_action("do_study","study");
}

int do_study (string arg)
{
	object* list;
	int i;

    if (arg != "jiuyang_book")
		return notify_fail ("你要用什么？\n");

	list = all_inventory(this_player());  
	i = sizeof(list);
	while (i--) {
        if (((string)list[i]->query("id")) == "jiuyang_book")
            message_vision("这里太暗，到外面去读书吧！\n",this_player());
            this_player()->move ("/d/oldpine/cliff1");
			return 1;
		}

    return notify_fail ("你身上没有九阳真经。\n");
}
