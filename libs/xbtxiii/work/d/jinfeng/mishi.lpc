// Room: /mishi.c

#include <room.h>

inherit ROOM;

void create()
{
	set("coor",({-30,2860,-10}));
	set("short", "密室");
	set("long",
"这是一个很神秘的房间，你多年的江湖经验告诉你：此地不可久\n"
"留！但是你心头突然涌起一个很动人的传说，好奇心使得你决定\n"
"不能就此离去，你只觉得一颗心咚咚地跳个不停。透过微弱的松\n"
"油灯光，你发现东面的墙壁上似乎有字(words)。\n"
);
    set("item_desc",([
     "words" : @TEXT
金风细雨楼重地，擅入者，杀无赦！
TEXT
]) );
	set("exits", ([ /* sizeof() == 1 */
  "north" : __DIR__"mishi2",
  "westup" : __DIR__"room2",
]));

    create_door("westup","暗门","eastdown",DOOR_CLOSED);
	setup();
}
