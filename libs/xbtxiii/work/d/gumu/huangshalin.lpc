#include <ansi.h>
inherit ROOM;

int do_move(string arg);

void create() {
  set("coor", ({ 910, -220, 340 }));
  set("short", "黄沙岭");
  set("long",
    "此处位於终南山西部。只见远处王曲原上，孤立着一座由荒沙堆\n"
    "积而成的山岭，波纹为奇特。据当地人说，这是在商朝，一位名\n"
    "叫陆亚仙的人，用法力遣来一股黄沙而成。往东是一片密林。\n"
  );
  set("outdoors", "gumu");
  set("exits", ([
    "east": __DIR__ "mumen",
  ]));
  setup();
}
