// shanlu10.c
// Java Oct.10 1998

inherit ROOM;

void create()
{
        set("coor",({1050,-100,160}));
	set("short", "山路");
        set("long",
"这是一条非常崎岖难行的山路，一路蜿蜒盘山ㄦ上，沿途均是葱\n"
"郁的古柏山林，蔚然森秀。在此处可眺望终南山的景色，只见山\n"
"险岭峻，山川毓秀，不少鸟ㄦ在枝头高声啼唱不绝。往东下是莲\n"
"花寺。往西上是一条山路。\n"
);
        set("outdoors", "gumu");
        set("exits", ([
                "westup"    : __DIR__"shulin9",
                "eastdown"  : __DIR__"jinliange",
        ]));

        setup();
        replace_program(ROOM);
}
