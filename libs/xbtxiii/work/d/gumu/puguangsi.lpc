// puguangsi.c
// Java Oct.10 1998

inherit ROOM;

void create() {
  set("coor", ({ 1150, -250, 80 }));
  set("short", "普光寺");
  set("long",
    "这是一个位於终南山下的小寺庙，庙门横额写着" 普 光 寺 "三个大字。由於此庙是上终南山的\n"
    "必经之路，大多数的游客都会在此落脚休息，也因此此处香火也颇为鼎盛。庙前的几株松树\n"
    "下，立着一块石碑(shibei)，几乎快被周围的长草给遮掩了。往西走是一条小路.\n"
  );
  set("outdoors", "gumu");
  set("exits", ([
    "west": __DIR__ "shanlu13",
  ]));

  setup();
}
