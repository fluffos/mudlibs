inherit ROOM;

void create()
{
        set("coor",({800,550,180}));
	set("short", "山道");
        set("long",
"此段山路是通往后山脚。往南上是一大片树林。往北下可以望见\n"
"一个较大的湖。\n"
);
        set("outdoors", "gumu");
        set("exits", ([
                "southup"   : __DIR__"shulin12",
                "northdown" : __DIR__"taiyi1",
        ]));

        setup();
        replace_program(ROOM);
}
