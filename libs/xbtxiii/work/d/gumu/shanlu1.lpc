// shanlu1.c
// Java Oct.10 1998

inherit ROOM;

void create()
{
        set("coor",({750,150,360}));
	set("short", "山路");
        set("long",
"这条山路盘终南山主峰而上，山路贴着石璧凿出，只容一人可过，\n"
"形势极为险峻。往远处望去。群山环绕，列於脚下，百里美景尽\n"
"收眼底，顿时令人豪气陡声，想要长啸一声。往南下是一片空地。\n"
"往北上就是终南山主峰。\n"
);
        set("outdoors", "gumu");
        set("exits", ([
                "southdown" : __DIR__"kongdi",
                "northup"   : __DIR__"zhufeng",
        ]));

        setup();
        replace_program(ROOM);
}
