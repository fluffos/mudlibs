// mishi8.c 密室
// Java Oct.10 1998

inherit ROOM;

void create()
{
        set("coor",({700,-500,240}));
	set("short", "密室");
        set("long",
"这里是古墓中的密室，四周密不透风，你只能借着墙上昏暗的灯\n"
"光来勉强分辨方向。墙是用整块的青石砌合起来的，接合的甚是\n"
"完美，你难以从中找出一丝缝隙。密室中摆放着一些简单的家居\n"
"用具，原来这是古墓派祖师林朝英的居室。\n"
);

        set("exits", ([
                "west" : __DIR__"mishi7",
                "out" : "/d/fy/fysquare",
        ]));

        set("objects", ([
                __DIR__"npc/lin" : 1,
        ]));

        setup();
        replace_program(ROOM);
}
