// shanlu7.c
// Java Oct.10 1998

inherit ROOM;

void create()
{
        set("coor",({850,200,260}));
	set("short", "山路");
        set("long",
"这是一条非常崎岖难行的山路，一路蜿蜒盘山ㄦ上，沿途均是葱\n"
"郁的古柏山林，蔚然森秀。在此处可眺望终南山的景色，只见山\n"
"险岭峻，山川毓秀，不少鸟ㄦ在枝头高声啼唱不绝。往北下是草\n"
"堂寺。往西上是一条山路。往东是一块广大的空地。往西北通往\n"
"后山下。\n"
);
        set("outdoors", "gumu");
        set("exits", ([
                "westup"     : __DIR__"shanlu6",
                "northdown"  : __DIR__"caotangsi",
                "northwest"  : __DIR__"shandao1",
                "eastdown"   : __DIR__"daxiaochang",
        ]));

        setup();
        replace_program(ROOM);
}
