// shulin4.c 树林
// Java Oct.10 1998

inherit ROOM;

void create() {
  set("coor", ({ 700, 50, 340 }));
  set("short", "小树林");
  set("long",
    "走在林中，你只闻铮铮琴声，一股淡淡白烟，带着极甜的花香，\n"
    "自密林深处传出。一群乳白色的蜜蜂在你身旁飞来飞去。不论往\n"
    "哪ㄦ走尽是茂密的树林。\n"
  );
  set("outdoors", "gumu");
  set("exits", ([
    "north": __DIR__ "kongdi",
    "south": __DIR__ "shulin0",
    "east": __DIR__ "shulin6",
    "west": __DIR__ "shulin5",
  ]));

  setup();
  replace_program(ROOM);
}
