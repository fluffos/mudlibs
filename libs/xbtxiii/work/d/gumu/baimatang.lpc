#include <ansi.h>
inherit ROOM;

int do_move(string arg);

void create() {
  set("coor", ({ 800, 150, 260 }));
  set("short", "白马潭");
  set("long",
    "这个潭为於终南山主峰一带，一条名叫库峪河的上游。潭边有一\n"
    "块比三间房子还要大的白石头，这石头中间低两头高，石头的前\n"
    "半截伸在水里，後半截留在岸上。由伸在水中的那半截石头下面\n"
    "还不时冒出一串串白沫，老远看去活似一匹腾空欲飞的烈马，因\n"
    "此当地人都叫此潭为白马潭。往北是一条崎岖的山路。\n"
  );
  set("outdoors", "gumu");
  set("exits", ([
    "northup": __DIR__ "shanlu6",
  ]));
  setup();
}
