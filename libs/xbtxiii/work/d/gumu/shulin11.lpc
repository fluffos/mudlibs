// shulin11.c
// Java Oct.10 1998

inherit ROOM;

void create()
{
        set("coor",({800,450,220}));
	set("short", "树林");
        set("long",
"这位於终南山间的一大片树林，生的颇为茂密。走在其间，只听\n"
"得脚下沙沙的落叶声，四周昏昏暗暗的，不时几道日光穿过浓密\n"
"的枝头，投射而下。偶而远处几声兽吼声，更添了一份神密感。\n"
"往北、南各有一条小径。\n"
);
        set("outdoors", "gumu");
        set("exits", ([
                "south"     : __DIR__"shulin10",
                "northdown" : __DIR__"shulin12",
        ]));
        setup();
        replace_program(ROOM);
}
