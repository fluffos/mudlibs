// shulin8.c 树林
// Java Oct.10 1998

inherit ROOM;

void create() {
  set("coor", ({ 950, -50, 180 }));
  set("short", "树林");
  set("long",
    "这位於终南山间的一大片树林，生的颇为茂密。走在其间，只听\n"
    "得脚下沙沙的落叶声，四周昏昏暗暗的，不时几道日光穿过浓密\n"
    "的枝头，投射而下。偶而远处几声兽吼声，更添了一份神密感。\n"
    "往西北和往东各有一条小径。\n"
  );
  set("outdoors", "gumu");
  set("exits", ([
    "northwest": __DIR__ "shenheyuan",
    "east": __DIR__ "baoziyan",
  ]));
  set("objects", ([
    "/d/quanzhen/npc/deer": 1,
  ]));
  setup();
  replace_program(ROOM);
}
