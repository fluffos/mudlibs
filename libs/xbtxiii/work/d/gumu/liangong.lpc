// liangong.c 练功室
// Java Oct.10 1998

inherit ROOM;

void create()
{
        set("coor",({550,-350,360}));
	set("short", "练功室");
        set("long",
"这座石室形状甚是奇特，前窄後宽，成为梯形，东边半圆，西边\n"
"却作三角形状，原来这是以前重阳祖师的练功室，前窄练掌，後\n"
"宽使拳，东圆研剑，西角发镖。\n"
);

        set("exits", ([
                "east" : __DIR__"zhengting",
                "north" : __DIR__"xiuxishi",
        ]));
        set("objects", ([
                "/d/shaolin/npc/mu-ren" : 5,
        ]));

        setup();
        replace_program(ROOM);
}
