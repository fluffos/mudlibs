// shulin1.c 树林
// Java Oct.10 1998

inherit ROOM;

void create() {
  set("coor", ({ 700, -50, 360 }));
  set("short", "小树林");
  set("long",
    "这是一片小树林，周围的树木都很高。间杂着一些叫不出名字的\n"
    "鲜花，五彩缤纷。你隐隐地有些担心起来：不会迷路了吧，转头\n"
    "间却看见东南边似乎有一条小路，隐藏在树丛之中。\n"
  );
  set("outdoors", "gumu");
  set("exits", ([
    "northdown": __DIR__ "shulin0",
    "southwest": __DIR__ "shulin2",
  ]));

  setup();
}
