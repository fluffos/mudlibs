#pragma save_binary
// guard.c

#include <ansi.h>
inherit NPC;

void create()
{
      set_name("封山弟子",({"guard"}) );
      set("gender","男性");
      set("age",25);
      set("long","他的皮肤是深褐色的，由于长期的风沙侵蚀，他才二十多
             岁，脸上已布满皱纹。\n");
      set("combat_exp",50000);
      set("attitude","friendly");
      set("str",30);
      set("cor",25);
      set("cps",26);
      set_skill("blade",70);
      set_skill("dodge",60);
      set_skill("parry",60);

      setup();

      carry_object("/d/snow/obj/blade")->wield();
      carry_object("/d/snow/obj/cloth")->wear();

}


