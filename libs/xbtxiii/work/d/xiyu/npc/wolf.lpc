#pragma save_binary
// crazy_dog.c

inherit NPC;

void create()
{
	set_name("沙狼", ({ "sand wolf", "wolf" }) );
	set("race", "野兽");
	set("age", 5);
	set("long", "一只瘦骨嶙峋的野狼，已经饿了很久, 一双绿眼正恶狠狠地瞪著你。\n");
	set("attitude", "aggressive");
	
	set("str", 26);
	set("cor", 30);

	set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );

	set("combat_exp", 150);

	set("chat_chance", 6);
	set("chat_msg", ({
		(: this_object(), "random_move" :),
	}) );
	
	set("chat_msg_combat", ({
		(: this_object(), "random_move" :),
		"野狼大声嚎叫：ㄠ～ㄨ～～， ㄠ～ㄨ～～.\n",
		"野狼跳了起来，张口就咬，急切地想找顿晚餐。\n"
	}) );
		
	set_temp("apply/attack", 15);
	set_temp("apply/damage", 6);
	set_temp("apply/armor", 1);

	setup();
}
