#pragma save_binary
// guard.c

#include <ansi.h>

inherit NPC;
mixed short(mixed arg);
mixed send_me(mixed arg);
mixed ditu_me(mixed arg);
int do_agree(string);
mixed send_me(mixed arg) {
  object me;
  me = this_player();
  add_action("do_agree", "agree");
  tell_object(me, "你愿意替我送信吗(agree)?\n");
  tell_room(environment(me), "啊," + me->query("name") + "愿意替我送信,真是太高兴了!\n");
  return 1;
}

mixed ditu_me(mixed arg) {
  object me, obj, *obb;
  int s;
  me = this_player();
  obj = new("/d/xiyu/obj/ditu");
  tell_object(me, "没有地图怎么能在沙漠里乱走,会迷路的.\n");
  obb = all_inventory(me);
  s = sizeof(obb);
  while (s--) {
    if (obb[s]->query("id") == "map") {
      say("你已经有了地图了,还要干吗!\n");
      return 1;
    }
  }
  tell_object(me, "地图给你,要保存好哦,丢了可就麻烦了\n");
  obj->move(me);
  return 1;
}

mixed shorty(mixed arg) {
  message_vision("$N也知道秘道,不过...嘿嘿...要走秘道吗(ok)?,可别吝惜钱哦!!\n");
  return 1;
}

void create() {
  set_name("嘉裕关城卫", ({ "guard" }));
  set("gender", "男性");
  set("age", 25);
  set("long", "他的皮肤是深褐色的，由于长期的风沙侵蚀，他才二十多
岁，脸上已布满皱纹。他在这里已经七年了,对这一带的
地形了如指掌.\n");
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("str", 30);
  set("cor", 25);
  set("cps", 26);
  set_skill("blade", 70);
  set_skill("dodge", 60);
  set_skill("parry", 60);

  set("inquiry", ([
    "妻子": "我妻子在雪亭镇,不知现在搬了没有\n",
    "wife": "我妻子在雪亭镇,不知现在搬了没有\n",
    "书信": (: send_me :),
    "letter": (: send_me :),
    "沙漠": (: ditu_me :),
    "desert": (: ditu_me :),
    "捷径": (: shorty :),
    "秘道": (: shorty :),
  ]));

  setup();

  carry_object("/d/snow/obj/blade")->wield();
  carry_object("/d/snow/obj/cloth")->wear();

}

void init() {
  object ob;

  ::init();

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_kill", "kill");
}

int do_agree(string arg) {
  object *obb, me, book, obj;
  int s;
  me = this_player();
  obb = all_inventory(me);
  s = sizeof(obb);
  while (s--) {
    if (obb[s]->query("id") == "letter") {
      say("快点把信送给我妻子吧!\n");
      return 1;
    }
  }
  tell_object(me, "信在这里,你一定要交给我妻子喏,谢谢\n");
  tell_room(environment(me), "信在这里,一定要交给我妻子喏,谢谢\n");
  obj = new("/d/xiyu/obj/letter");
  obj->move(me);
  return 1;
}

void greeting(object ob) {
  object me;
  me = this_player();
  if (ob->query("kar") == (random(20) + 10))
    say("卫兵满怀希望地说：这位" + RANK_D->query_respect(ob) + ",
能不能捎封信给我没过门的妻子?\n");
  return;
}

int accept_fight(object me) {
  me = this_player();
  if (me->query("combat_exp") < 10000) {
    say("军令如山，不能跟你们这些江湖人物比武过招。\n");
    return 1;
  } else {
    say("咦... 要打就真打吧，光是较量多没意思？\n");
    kill_ob(me);
    return 1;
  }
}

int do_kill(string arg) {
  object me;
  me = this_player();
  if (arg == "guard") {
    set_temp("apply/attack", 20);
    set_temp("apply/dodge", 20);
    set_temp("apply/parry", 20);
    set_temp("apply/damage", 20);
    kill_ob(me);
    return notify_fail("守城兵大叫：反了！反了！");
  }
  return 0;
}
