#pragma save_binary
//Room: /d/xiyu/caster.c

inherit ROOM;

void create() {

  set("short", "嘉裕关");
  set("long",
    "嘉裕关是西部重镇,人烟不算少，但由于长年征战,加上年深日久，\n"
    "面貌显得有点苍老.关上迎面矗立起一座两层高的箭楼，恶森森\n"
    "地压在古长城上，那块写着”西北第一关“的横匾就挂在箭楼高\n"
    "头，每个字都大如箩筐，把这座关塞烘染得越发雄壮.登上箭楼，\n"
    "但见北边莽莽苍苍是一望无际的沙漠，向南走就可到雪亭镇。\n"
  );
  set("exits", ([  /* sizeof()==2  */
    "southdown": __DIR__ "yroad2",
    "west": __DIR__ "yroad3",
  ]));
  set("objects", ([ /*"/d/xiyu/npc/guard2":3, */
    "/d/xiyu/npc/guard1": 4 ]));

  //   set("outdoors","xiyu");

  setup();
  replace_program(ROOM);
}

