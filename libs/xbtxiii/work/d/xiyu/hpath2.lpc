#pragma save_binary
// hpath2.c

inherit ROOM;

void create() {
  set("short", "山路");
  set("long",
    "这是天山的山路，四周古木参天。道路两边还可以看到一丝残雪，\n"
    "这里道路整整齐齐，似乎经常有人打扫。\n"
  );
  set("exits", ([ /*sizeof()==2*/
    "southdown": __DIR__ "hpath1",
    "westup": "/d/npc/m_weapon/bian1",
  ]));
  setup();
  replace_program(ROOM);
}
