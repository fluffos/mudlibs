#pragma save_binary
#include <obj.h>

inherit ROOM;

void create()
{
	set("short", "城隍庙");
	set("long",
"这是一间十分老旧的城隍庙，在你面前的神桌上供奉著一尊红脸\n"
"的城隍，庙虽老旧，但是神案四周已被香火薰成乌黑的颜色，显\n"
"示这里必定相当受到信徒的敬仰。\n"
);
	set("exits", ([ /* sizeof() == 2 */
		"south" : "/d/snow/eroad1",
		"west" : "/d/snow/square",
	]));
	set("no_fight", "1");
	set("objects", ([ /* sizeof() == 2 */
		OBJ_PAPER_SEAL : 2,
		"/d/snow/npc/keeper" : 1,
                "/d/shaolin/npc/qf" : 1,
	]));

	setup();
	replace_program(ROOM);
}
