#pragma save_binary
// inn.c

#include <room.h>

inherit ROOM;

void create() {
  set("short", "红花会登记处");
  set("long", @LONG
你现在正站在红花会登记处,在这里你可以加入红花会或脱离红花会.
在你边上做着一个中年男子,他是红花会的老管家,向他可以问到关于
红花会的具体情况.
LONG
  );

  set("exits", ([
    "west": "/d/red/red_gatedoor",
    "east": "/d/red/red_road1",
  ]));

  set("objects", ([
    "/d/red/npc/warrior": 2 ]));

  setup();

}


int valid_leave(object me, string arg) {
  string bangname;
  int i, j;
  object *ob;

  if (arg != "east")
    return 1;

  bangname = me->query("marks/帮派");
  if (bangname == "红花会") {
    return 1;
  }

  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (living(ob[i])) {
      bangname = ob[i]->query("marks/帮派");
      if (bangname == "红花会") {
        return 1;
        //                         return 0;
      }
    }
  }

  return 1;
}
