#pragma save_binary
// hpath2.c

inherit ROOM;

void create()
{
	set("short","一线天");
	set("long",
"来到了一线天.这里崖壁升耸,峡壑险邃,道路上铺着一层薄冰,一\n"
"阵风吹过,好象要把你卷下崖去,你不由得牢牢地抓住两旁的护绳.\n"
"天山派就在西边不远.\n"
);
	set("exits",([ /*sizeof()==2*/
	"west" :__DIR__"ladder1",
	"eastdown":__DIR__"hpath2",
	]));
	setup();
	replace_program(ROOM);
}
