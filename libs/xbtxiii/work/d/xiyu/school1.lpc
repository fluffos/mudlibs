#pragma save_binary
// Room: /d/snow/school1.c

#include <room.h>
#include <ansi.h>
#include <combat.h>

inherit ROOM;

void create() {
  set("short", "淳风武馆大门");
  set("long",
    "你现在正站在一间大宅院的入口，两只巨大的石狮镇守在大门的\n"
    "两侧，一阵阵吆喝与刀剑碰撞的声音从院子中传来，通过大门往\n"
    "东可以望见许多身穿灰衣的汉子正在操练。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": "/d/snow/mstreet1",
    "east": "/d/snow/school2",
  ]));
  set("outdoors", "snow");
  set("objects", ([
    "/d/snow/npc/guard": 1 ]));

  create_door("east", "红漆大门", "west", DOOR_CLOSED);

  setup();
}

int valid_leave(object me, string arg) {
  int i;
  object ob, obb, room;

  if (arg != "east")
    return 1;

  if ((string)me->query("family/family_name") != "天邪派") {
    return 1;
  }
  ob = this_object();
  room = environment(this_object());
  tell_object(me, "刘安禄对" + me->query("name") + "横了一眼,喝道:怎么,想硬闯.来人,拿下这天邪恶贼.\n");
  tell_room(room, "话音未落,立即从门后跳出几个恶狠狠的彪形大汉.\n");
  for (i = 0; i <= 4; i++) {
    obb = new("/d/xiyu/npc/guard2");
    obb->move(room);
    tell_room(room, "只见刘安禄手一挥,说道:上.几个大汉扑了上来.\n");
    obb->kill_ob(me);
  }
  return 1;
}
