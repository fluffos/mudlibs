#pragma save_binary
// Room: /d/snow/school2.c

#include <room.h>

inherit ROOM;

void create() {
  set("short", "淳风武馆教练场");
  set("long",
    "你现在正站在一个宽敞的教练场中，地上铺著黄色的细砂，许多\n"
    "人正在这里努力地操练著，北边是一间高大的兵器厅，往东则是\n"
    "武馆师父们休息的大厅。\n"
  );
  set("exits", ([ /* sizeof() == 3 */
    "north": "/d/snow/weapon_storage",
    "west": "/d/snow/school1",
    "east": "/d/snow/schoolhall",
  ]));
  set("objects", ([ /* sizeof() == 2 */
    "/d/snow/npc/trainee": 10,
    "/d/snow/npc/fist_trainer": 1,
  ]));
  set("outdoors", "snow");
  set("clean_up", 1);

  create_door("west", "红漆大门", "east", DOOR_CLOSED);
  setup();
}

int valid_leave(object me, string arg) {
  string bangname;
  int i, j;
  object *ob;

  if (arg != "east")
    return 1;

  bangname = me->query("marks/帮派");
  if (bangname == "红花会") {
    return 1;
  }

  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (living(ob[i])) {
      bangname = ob[i]->query("marks/帮派");
      if (bangname == "红花会") {
        return 1;
        //                         return 0;
      }
    }
  }

  return 1;
}
