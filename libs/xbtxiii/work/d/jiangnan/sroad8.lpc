#include <room.h>

inherit ROOM;

void create() {
  set("short", "黑松领岭下");
  set("long",
    "这是黑松领北,岭上强盗盘据，无数行人在此丧生。由于这是江\n"
    "南通往京城的必经之路，所以旅客没经此地无不小心翼翼，生怕\n"
    "落入强盗手里。一轮火红的太阳高高挂在天空上。\n"
  );

  set("exits", ([
    "southup": "/d/jiangnan/sroad9",
    "northeast": "/d/jiangnan/sroad7" ]));

  setup();
}
