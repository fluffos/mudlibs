#include <room.h>

inherit ROOM;

void create()
{
        set("coor",({0,350,0}));
	set("short", "华北驿道");
        set("long",
"这是一条青石铺地的大驿道.这是江南入京驿道，往北一直通向\n"
"京城。东北是一望无际的大平原，有许多农夫真正地里忙碌着。\n"
"往南通往是主城的大道，那里相当繁华。\n"
);

        set("exits", ([
                "south"          : "/d/jiangnan/sroad5",
                "north"        : "/d/jiangnan/sroad3" ]) );
	
        set("outdoors", "city");
       	setup();
}

