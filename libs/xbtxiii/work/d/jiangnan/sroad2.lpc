#include <room.h>
#include <roadbusy.h>

inherit ROOM;

void create()
{
        set("coor",({0,450,0}));
	set("short", "华北驿道");
        set("long",
"这是一条青石铺地的大驿道.这是江南入京驿道，往北一直通向\n"
"京城。东北是一望无际的大平原，有许多农夫真正地里忙碌着。\n"
"往北已经隐隐能看见京城了，你擦了擦额上的汗水，加紧了步伐。\n"
);

        set("exits", ([
                "south"          : "/d/jiangnan/sroad3",
                "north"        : "/d/jiangnan/sroad1" ]) );
	
        set("outdoors", "city");
       	setup();
}

