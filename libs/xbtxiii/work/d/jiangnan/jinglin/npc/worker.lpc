// worker.c

inherit NPC;

void create()
{
        set_name("采矿工", ({ "stone worker", "worker" }) );
        set("gender", "男性" );
        set("age", 32);
        set("long", "采矿工正在忙碌着，不时擦擦额上的汗水。\n");
        set("combat_exp", 500);
        set("attitude", "friendly");
        set_skill("unarmed", 10);
        set_skill("parry", 20);
	set_skill("dodge", 20);
	set_skill("throwing", 10);

        set("inquiry", ([
		"矿石" : "这是用来修建大观园的。", 
        ]) );

	setup();
	add_money("coin", 15);
        carry_object("/obj/cloth")->wear();
	 carry_object("/obj/weapon/hammer")->wield(); 
}


