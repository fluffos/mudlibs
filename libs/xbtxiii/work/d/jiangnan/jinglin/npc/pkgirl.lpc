// flowergirl.c

inherit NPC;

void create()
{
    set_name("捡石少女", ({ "girl" }) );
	set("gender", "女性" );
	set("age", 15);
	set("per", 30-random(15) );
        	set("long", 
        "捡石少女是金陵城居民的小孩，从小就经常采石矶来捡雨花石，\n"
        "贾母很喜欢她们，也教给她们了些基本武功，时间久了，这些少\n"
		"女的功夫还都不错。\n"
	);
    set("combat_exp", 1000);
	set("attitude", "friendly");
  set("chat_chance", 1);
       	set("chat_msg", ({
"顽皮的捡石少女向你扮个鬼脸。  *^G^* \n",
"捡石少女说道：你知道吗，好的雨花石可不容易捡到。\n",
"捡石少女望着天边的晚霞，双手托着香腮，说道：我好想去深大摘花。\n",
"捡石少女嘀咕着：听说深大的有好多花呢。\n",
       }) );

        	set("chat_chance_combat", 10);
        	set("chat_msg_combat", ({
"捡石少女秀眉微蹙，说道：你欺负我年纪小是吗？\n",
"捡石少女骂道：你这无赖，别死缠着我！\n",
        	}) );
	set("inquiry", ([
		"桂花" : "华中理工大学的桂花树比晚月庄多多了，你知道吗？",
	]) );

    set_skill("parry", 50);
    set_skill("dodge", 80);
    set_skill("unarmed", 70);

        set_skill("force", 15);
        set("force", 500);
        set("max_force", 500);
        set("force_factor", 0);

	setup();
        	carry_object("/u/cloud/obj/npc/girl/pink_cloth")->wear();
        	for(int i=1; i<=2; i++){
        	}
}


