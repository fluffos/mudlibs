// boater.c

inherit NPC;


void create()
{
        set_name("船夫", ({ "boater" }) );
        set("gender", "男性" );
        set("age", 30);
        set("long", "船夫的皮肤晒得黝黑，脸上的沧桑是多年摆渡的痕迹。\n");
	set("str", 27);
        set("combat_exp", 1500);
        set("attitude", "friendly");
	set("rank_info/respect", "船夫");
        set_skill("unarmed", 100);
        set_skill("parry", 50);
        set_skill("dodge", 30);
	set("chat_chance", 6);
        set("chat_msg",({      
	  "船夫喃喃自语着:长江的谁这么急，一不小心就会翻船。\n",
                "船夫对你说:我是靠这条长江生活的，过江的人多了我的日子就好过。\n",
        }) );      
        set("inquiry", ([
		"过江" : "过江啊，我是以次为生的，请付钱。",
		"摆渡" : "摆渡啊，我是以次为生的，请付钱。",
        ]) );

	setup();
	add_money("coin", 200);
        carry_object("/obj/cloth")->wear();
}


int accept_object(object who, object ob)
{
        if ( ob->value() < 100 ) {
                command("say 就这点钱，你想让我喝西北风啊？");
                command("drop all");
                return 1;
	        }
		else{
                tell_object(who,"船夫高兴地说:太好了，请上船吧! \n");
  		tell_object(who,"船夫将搭板靠到船上，动作非常熟练。 \n");
    		tell_room(environment(who),who->name()+"走上渡船，船离开了长江南岸.\n",who);  
                        who->move("/d/jiangnan/river/southriver");
                        return 1;
                	}
               
            
        return 1;
}




