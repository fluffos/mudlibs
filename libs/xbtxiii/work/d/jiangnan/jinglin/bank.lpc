// bank.c

inherit BANK;

void create()
{
	add_light(this_object(),1);
	set("coor",({0,-2740,0}));
	set("short", "金陵钱庄");
	set("long",
"这是一间素来不讲信用的钱庄，钱庄的老板倒是读过几年书，脑\n"
"筋很活络，你可以看到钱庄里里外外都打扫得乾乾净净，一个斯\n"
"文的年轻人坐在柜台后面，柜台上放著一块牌子(sign)，往南是\n"
"通往金陵街道的大门。\n"
);
	set("exits", ([ 
  "south" : "/d/jiangnan/jinglin/street9",
]));

	set("objects", ([
 		"/d/jiangnan/jinglin/npc/banker" : 1 ]) );






	set("item_desc", ([
		"sign": @TEXT
我们提供的服务有：

convert     兑换钱币，自点数目，出门后发现少钱概不负责。

TEXT
	]) );
	setup();
}
