inherit ROOM;


void create() {
  set("coor", ({ 50, -2700, 0 }));
  set("short", "金陵大街");
  set("long",
    "你现在正走在金陵城的大街上，北边就是金陵的北门了，隐约传\n"
    "来官兵搜查行人的吆喝声。在你的西边是金陵最有名的客栈，南\n"
    "来北往的行人路过这里都要进去休憩一下，饱餐一顿，喝几两金\n"
    "陵特产的佳酿，补补体力，为更远的路途作准备。东边有一间丰\n"
    "登当铺的分铺。\n"
  );
  set("outdoors", "jinglin");
  set("exits", ([ /* sizeof() == 2 */
    "north": "/d/jiangnan/jinglin/northdoor",
    "south": "/d/jiangnan/jinglin/street11",
    "west": "/d/jiangnan/jinglin/inn",
    "east": __DIR__ "dangpu",
  ]));

  set("objects", ([
    "/d/snow/npc/beggar": 1,
    "/d/snow/npc/scavenger": 1,
    "/d/snow/npc/drunk": 1, ]));
  create_door("east", "木雕门", "west", DOOR_CLOSED);
  set("no_clean_up", 0);

  setup();
}
