// inn.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
        add_light(this_object(),1);
        set("coor",({30,-2700,0}));
       set("my_point","金陵城");
        set("short", "金陵城客栈");
        set("long",
"你正站在金陵城北面的一家大客栈里，这家客栈是金陵城最负盛\n"
"名的一家，客栈是金陵城荣国府开的，在这儿专门招待远方来的\n"
"客人。在这儿你可以打听到许多有关荣、宁两府和大观园的传闻\n"
"轶事。除此之外，来自各地的旅人都喜欢聚集在这里交换旅途上\n"
"的见闻，你也可以在这里打听到许多有趣的消息。靠近门口的地\n"
"方有一块乌木雕成的招牌(sign)。\n"
);

        // This enables players to save this room as their startroom.
        set("valid_startroom", 1);

        set("item_desc", ([
                "sign": (: look_sign :),
                "door": (: look_door, "northwest" :),
        ]) );
        
        set("exits", ([
                "east"            : "/d/jiangnan/jinglin/street12",
        ]) );

//        set("no_fight", 1);
//        set("no_magic","1");
        set("objects", ([
                "/d/jiangnan/jinglin/npc/waiter" : 1, 
                "/d/biao/kehu" : 1, 
                 ]) );


        

        setup();

        
        
}

string look_sign(object me)
{
        if( wizardp(me) )
                return "招牌写著：金陵城客栈。旁边一排小字：庄思哑题。\n";
        else
                return "招牌写著：金陵城客栈。\n";
}

