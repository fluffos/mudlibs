// Room: /d/jiangnan/daguanyuan/trace6.c

#include <room.h>

inherit ROOM;

string look_sign(object me);
void create()
{
        set("coor",({25,-1050,0}));
	set("short", "长江渡口");
        set("long",
"这里长江南岸渡口，北面就是滔滔不绝的中华第一河长江，南面\n"
"隐隐可以看到金陵城北门，一个船夫坐在靠着岸边的渡船上，等\n"
"着顾客过江。\n"
);
set("exits", ([ /* sizeof() == 2 */
    	"south" : "/d/jiangnan/jinglin/trace1",
         "north" : "/d/yangzhou/trace1",
   ]));
  
        set("outdoors", "jinglin");
 set("objects",(["/d/jiangnan/jinglin/npc/boater":1])); 
        setup();
        
}


int valid_leave(object me, string dir)
{       object ob;
        object *inv;
        int i;
if (dir=="south."&&ob=present("soldier", this_object()))
{
if (ob->query("leader")==me->query("name")&&
    me->query("rank")==1) return 1;
else{
                inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)               
 {if (((inv[i]->query("targetid")) == me->query("id"))
        &&((string)(inv[i]->query("id")) == "token"))
        return 1;
 }              
return notify_fail(ob->name()+"向你嚷道：奉"+
ob->query("leader")+"之命封锁此路!没有通行证不得通过!\n");
    }
}
else return 1;  
}       
