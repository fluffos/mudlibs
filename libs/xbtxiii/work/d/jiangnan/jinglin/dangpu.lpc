// Room: /d/snow/hockshop.c

#include <room.h>

inherit HOCKSHOP;

void create()
{
    add_light(this_object(),1);
	set("coor",({70,-2700,0}));
	set("short", "丰登当铺");
	set("long",
"这是丰登当铺的金陵分铺，老旧的柜台上放著一张木牌(sign)，\n"
"屋里的光线不是很亮，往东的出口被一块蓝色布□遮著，上面有\n"
"「非请莫入」的字样，西边有一扇木雕门(door)通往大街。\n"
);
	set("item_desc", ([
		"sign": @TEXT
本当铺财力雄厚，童叟无欺，欢迎惠顾，绝对保密。
客倌可以在这里典当(pawn)、卖断(sell)各种货物，铜钱、银两、黄金、银票
一概通用。赎回货物用(retrieve)，申请乾坤袋用(apply bag)。
TEXT
	]) );
    set("rich",500000);
	set("exits", ([
        "west" : __DIR__"street12",
	]));

        set("objects", ([
                __DIR__"npc/hocker" : 1,
                 ]) );
	setup();

	create_door("west", "木雕门", "east", DOOR_CLOSED);
}
void init()
{
            ::init();
            add_action("do_close", "close");
}
int do_close()
{
    if(objectp(this_player()))
        this_player()->set_explore("south#7");
    return 0;
}
