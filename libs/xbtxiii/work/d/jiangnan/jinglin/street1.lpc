// Room: /d/jiangnan/daguanyuan/trace6.c

#include <room.h>

inherit ROOM;


void create() {
  add_light(this_object(), 1);
  set("coor", ({ -50, -2700, 0 }));
  set("short", "释仇亭");
  set("long",
    "这儿是宁、荣两府设的释仇亭，一块匾上写着：“当前世风日下，\n"
    "有许多武林人士视人命人儿戏。我们红楼派绝不允许有人在我们\n"
    "这里撒野，如果有谁杀了我们的人，他将面对着我们所有人的反\n"
    "击。但是俗话说'怨仇宜解不宜结，所以我们在此特设释仇亭，\n"
    "如果有人得罪了我们，只要在此缴纳一定金钱，就可以得到我们\n"
    "的原谅。”亭中座着一个管家，正在登记名字。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": "/d/jiangnan/jinglin/street7",
    //"north" : "/d/jiangnan/jinglin/street6",
    "west": "/d/jiangnan/jinglin/street2",
  ]));
  set("objects", ([
    "/d/jiangnan/daguanyuan/npc/waiter": 1,

  ]));
  set("no_fight", 1);
  set("no_magic", "1");
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
