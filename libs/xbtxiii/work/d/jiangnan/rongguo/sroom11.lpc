#include <room.h>

inherit ROOM;


void create()
{
        set("coor",({-190,-2610,10}));
	set("short", "荣禧堂堂屋");
        set("long",
"这是荣禧堂堂屋,铺着猩红洋毯，设有洋漆小几，一溜四张大椅，\n"
"都搭着银红撒花椅搭，两边又有一对高几.\n"
);
 set("exits", ([ /* sizeof() = 2 */
              	"north" : "/d/jiangnan/rongguo/sroom1",
       		
]));
 create_door("north","荣禧堂大门","south", DOOR_CLOSED);
        setup();
}
void init()
{
    if(objectp(this_player()))
        this_player()->set_explore("south#8");
}
