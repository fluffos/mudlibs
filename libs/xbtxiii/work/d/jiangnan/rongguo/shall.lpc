#include <room.h>

inherit ROOM;


void create() {
  add_light(this_object(), 1);
  set("coor", ({ -190, -2570, 0 }));
  set("short", "南大厅");
  set("long",
    "从东西穿堂往南是南大厅。往南便是仪门内大院落。\n"
  );
  set("exits", ([ /* sizeof() = 2 */
    "north": "/d/jiangnan/rongguo/trace6",
    "south": "/d/jiangnan/rongguo/syard",
  ]));

  create_door("south", "仪门", "north", DOOR_CLOSED);
  setup();
  replace_program(ROOM);
}
