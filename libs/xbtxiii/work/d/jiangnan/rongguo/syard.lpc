#include <room.h>

inherit ROOM;


void create() {
  add_light(this_object(), 1);
  set("coor", ({ -190, -2590, 0 }));
  set("short", "仪门内大院落");
  set("long",
    "从穿堂往南是南大厅。往南便是仪门内大院落。上面五降大正房，\n"
    "两边厢房鹿顶，耳门钻山，四通八达，轩昂壮丽，比各处不同。\n"
    "这是正室。\n"
  );
  set("exits", ([ /* sizeof() = 2 */
    "north": "/d/jiangnan/rongguo/shall",
    "southup": "/d/jiangnan/rongguo/sroom1",
    "east": "/d/jiangnan/rongguo/sroom2",
    "west": "/d/jiangnan/rongguo/trace7",

  ]));

  create_door("north", "仪门", "south", DOOR_CLOSED);
  //      create_door("east","东耳房门","west", DOOR_CLOSED);
  //      create_door("west","角门","east", DOOR_CLOSED);
  setup();
}
