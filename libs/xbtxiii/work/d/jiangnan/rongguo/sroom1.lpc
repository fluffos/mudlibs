inherit ROOM;


void create() {
  set("coor", ({ -190, -2600, 10 }));
  set("short", "荣禧堂");
  set("long",
    "走进堂屋，抬头迎面先见一个赤金九龙青地大匾，匾上写着斗大\n"
    "三个字，是“荣禧堂“；后有一行小字：“某年某月日书赐荣国\n"
    "公贾源”，又有“万几宸翰”之宝。大紫檀雕璃案上设着三尺多\n"
    "高青绿古铜鼎，悬着待漏随朝墨龙大画，一边是錾金彝，一边是\n"
    "玻璃盆，地下两溜十六张楠木圈椅。又有一副对联，乃是乌木联\n"
    "牌镶着錾金字迹，道是：座上珠玑昭日月，堂前璞檗焕烟霞。下\n"
    "面一行小字是：“世教弟勋袭东安郡王穆莳拜手书.\n"
  );
  set("exits", ([ /* sizeof() = 2 */
    "northdown": "/d/jiangnan/rongguo/syard",
    "south": "/d/jiangnan/rongguo/sroom11",

  ]));

  create_door("south", "荣禧堂大门", "north", DOOR_CLOSED);
  setup();
}
