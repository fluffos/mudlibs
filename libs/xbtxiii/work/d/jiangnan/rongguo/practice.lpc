    "东方的天空中。\n"
  );
  set("exits", ([ /* sizeof() = 2 */
    "east": "/d/jiangnan/rongguo/hall",
  ]));

  set("objects", ([ /* sizeof() == 2 */
    "/d/jiangnan/rongguo/npc/trainee": 3,
  ]));
  setup();
  replace_program(ROOM);
}
