#include <room.h>

inherit ROOM;


void create() {
  add_light(this_object(), 1);
  set("coor", ({ -200, -2600, 0 }));
  set("short", "荣国府");
  set("long",
    "来到荣国府大门，只见门前蹲着两个大石狮子,门前列坐着十来个华冠丽服之人,正门不开,\n"
    "只东西两角门有人出入.正门之上有一匾,匾上大书敕造荣国府五个大字.西面是红楼派的\n"
    "练功场。你可以听到阵阵吆喝声。\n"
  );
  set("exits", ([ /* sizeof() = 2 */
    "north": "/d/jiangnan/rongguo/trace5",
    "northwest": "/d/jiangnan/rongguo/trace1",
    "south": "/d/jiangnan/jinglin/street4",
    "west": "/d/jiangnan/rongguo/practice",
  ]));


  set("objects", ([
    "/d/jiangnan/rongguo/npc/guard": 2,
  ]));
