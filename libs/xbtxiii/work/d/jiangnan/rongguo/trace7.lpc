    "边是一个大影壁。\n"
  );
  set("exits", ([ /* sizeof() = 2 */
    "south": "/d/jiangnan/rongguo/trace8",
    "north": "/d/jiangnan/rongguo/fengshe",
    "west": "/d/jiangnan/rongguo/trace9",
