#include <room.h>

inherit ROOM;


void create() {
  add_light(this_object(), 1);
  set("coor", ({ -180, -2590, 0 }));
  set("short", "东耳房");
  set("long",
    "这是东耳房，是贾政和王夫人时常居坐宴息的地方.临窗大坑上\n"
    "铺着猩红洋毯，正面设着大红金钱蟒引枕，秋香色金钱蟒大条褥，\n"
    "两边设有一对梅花式洋漆小几，左边几上摆着文王鼎，鼎旁匙助\n"
    "香盒，右边几上摆着汝窟美人榍，里面插着时鲜花草。地下面西\n"
    "一溜四张大椅，都搭着银红撒花椅搭，两边又有一对高几.\n"
  );
  set("exits", ([ /* sizeof() = 2 */
    "west": "/d/jiangnan/rongguo/syard",
  ]));

  set("objects", ([
    "/daemon/class/reddream/master1": 1,
    "/daemon/class/reddream/jia-wife": 1 ]));
  set("clean_up", 1);
  //         create_door("west","东耳房门","east", DOOR_CLOSED);
  setup();
}
