// Room: /d/jiangnan/daguanyuan/hall.c

#include <room.h>

inherit ROOM;


void create() {
  add_light(this_object(), 1);
  set("coor", ({ -150, -2600, 0 }));
  set("short", "大观园");
  set("long",
    "这是大观园的正门，只见正门五间，上面筒瓦泥鳅脊，那门栏窗\n"
    "格都是细雕时新花样，并无朱粉涂饰。一色水磨群墙，下面白石\n"
    "台阶，凿成西番花样。左右一望，雪白粉墙。下面虎皮石砌成纹\n"
    "理，不落俗套，令人看上去非常舒服。里面不时传来阵阵欢笑声，\n"
    "你不禁想进去看看。\n"
  );
  set("outdoors", "jinglin");
  set("exits", ([ /* sizeof() = 2 */
    //    "north" : "/d/jiangnan/daguanyuan/trace1",
    "south": "/d/jiangnan/jinglin/street3",
  ]));
  set("objects", ([
    __DIR__ "npc/guard": 2,
  ]));

  set("outdoors", "daguanyuan");
  set("clean_up", 1);

  //        create_door("north", "大观园门内", "south", DOOR_CLOSED);
  setup();
  replace_program(ROOM);
}
