// Room: /d/jiangnan/daguanyuan/liaofeng.c

#include <room.h>

inherit ROOM;


void create() {
  set("short", "蘅芜院");
  set("long",
    "你步入蘅芜院内，忽迎面突出插天的大玲珑山石来，四面群绕各\n"
    "式石块，竟把里面所有房屋悉皆遮住。且一树花木也无，只见许\n"
    "多异草，或有牵藤的，或有引蔓的，或垂山岭，或穿石脚，甚至\n"
    "垂檐绕柱，萦砌盘阶，或如翠带飘摇，或如金绳蟠屈，或实若丹\n"
    "砂，或花如金桂，味香气馥，非凡花之可比。\n"
  );
  set("exits", ([ /* sizeof() = 3 */
    "northup": "/d/jiangnan/daguanyuan/hylang7",
    "east": "/d/jiangnan/daguanyuan/hgard1",
    "southup": "/d/jiangnan/daguanyuan/hylang5",
    "west": "/d/jiangnan/daguanyuan/trace21",
  ]));

  set("outdoors", "daguanyuan");
  set("clean_up", 1);

  create_door("west", "蘅芜院大门", "east", DOOR_CLOSED);
  setup();
}
