#include <room.h>

inherit ROOM;


void create() {
  set("short", "怡红院");
  set("long",
    "你到了怡红院，只见两边尽是游廊相结，院中点衬着几块山石，\n"
    "一边种几本芭蕉，那边是一树西府海棠，其势若伞，丝垂金缕，\n"
    "芭吐丹砂。\n"
  );
  set("exits", ([ /* sizeof() = 3 */
    "northup": "/d/jiangnan/daguanyuan/yylang7",
    "west": "/d/jiangnan/daguanyuan/ygard1",
    "southup": "/d/jiangnan/daguanyuan/yylang5",
    "east": "/d/jiangnan/daguanyuan/moondoor",
  ]));

  set("outdoors", "daguanyuan");
  set("clean_up", 1);

  create_door("east", "蘅芜院大门", "west", DOOR_CLOSED);
  setup();
  replace_program(ROOM);
}
