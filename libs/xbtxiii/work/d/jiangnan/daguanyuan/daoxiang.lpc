#include <room.h>

inherit ROOM;


void create()
{
        set("short", "稻香村");
        set("long",
"你步入稻香村，只见一带泥墙，墙上皆用稻茎掩护。有几百枝杏\n"
"花，如喷火蒸霞一般。里面数楹茅屋，外面却是桑、榆、槿各色\n"
"树稚新条，随其曲折，编就两溜青篱。篱外山坡之下，有一土井，\n"
"。下面分畦列亩，佳蔬菜花，一望无际。\n"
);
 set("exits", ([ /* sizeof() = 3 */
       	"east"  : "/d/jiangnan/daguanyuan/dgard1",
	"west"  : "/d/jiangnan/daguanyuan/trace30",
	
]));
      
        set("outdoors", "daguanyuan");
        set("clean_up",1);

        create_door("west", "稻香村大门", "east", DOOR_CLOSED);
        setup();
        replace_program(ROOM);
}




