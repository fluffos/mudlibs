#include <room.h>

inherit ROOM;


void create() {
  set("short", "小径");
  set("long",
    "这是一条小径。四周池水泛着微波，不时有银白色的小鱼蹿出水\n"
    "面.南面是芭蕉坞，西面是含芳阁,北面是花淑院。\n"
  );
  set("exits", ([ /* sizeof() = 2 */
    "south": "/d/jiangnan/daguanyuan/bajiao",
    "north": "/d/jiangnan/daguanyuan/huashu",
    "west": "/d/jiangnan/daguanyuan/hanfang",
  ]));

  create_door("west", "含芳阁大门", "east", DOOR_CLOSED);
  create_door("north", "花淑院大门", "south", DOOR_CLOSED);
  setup();
  replace_program(ROOM);
}
