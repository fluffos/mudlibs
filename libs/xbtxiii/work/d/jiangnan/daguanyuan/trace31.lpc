#include <room.h>

inherit ROOM;


void create() {
  set("short", "省亲别墅门前");
  set("long",
    "你来到省亲别墅门前，只见嵩阁巍峨，层楼高起，面面琳宫合抱，\n"
    "迢迢复道萦纡。青松拂檐，玉栏绕砌；金辉兽面，采焕狸头。\n"
  );
  set("exits", ([ /* sizeof() = 2 */
    "north": "/d/jiangnan/daguanyuan/trace21",
    "south": "/d/jiangnan/daguanyuan/shenqing",
  ]));
  create_door("south", "省亲别墅大门", "north", DOOR_CLOSED);
  setup();
  replace_program(ROOM);
}
