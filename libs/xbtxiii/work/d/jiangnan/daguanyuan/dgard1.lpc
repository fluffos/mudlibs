// Room: /d/jiangnan/daguanyuan/xiaogard.c

#include <room.h>

inherit ROOM;


void create() {
  set("short", "稻香村庭院");
  set("long",
    "你步入稻香村，只见一带泥墙，墙上皆用稻茎掩护。有几百枝杏\n"
    "花，如喷火蒸霞一般。里面数楹茅屋，外面却是桑、榆、槿各色\n"
    "树稚新条，随其曲折，编就两溜青篱。篱外山坡之下，有一土井，\n"
    "。下面分畦列亩，佳蔬菜花，一望无际。\n"
  );
  set("exits", ([ /* sizeof() = 3 */
    "east": "/d/jiangnan/daguanyuan/droom1",
    "south": "/d/jiangnan/daguanyuan/droom2",
    "north": "/d/jiangnan/daguanyuan/droom3",
    "west": "/d/jiangnan/daguanyuan/daoxiang",
  ]));
  set("outdoors", "daguanyuan");
  set("clean_up", 1);

  create_door("east", "稻香村大门", "west", DOOR_CLOSED);
  create_door("south", "南厢房门", "north", DOOR_CLOSED);
  create_door("north", "北厢房门", "south", DOOR_CLOSED);
  setup();
}
