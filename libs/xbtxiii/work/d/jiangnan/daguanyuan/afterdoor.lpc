// Room: /d/jiangnan/daguanyuan/trace6.c

#include <room.h>

inherit ROOM;


void create() {
  set("short", "后院");
  set("long",
    "这儿是大观园后院。院中满架蔷薇。前面是大山阻挡，没有明显\n"
    "的出路。但你可以试着绕过大山(circle).\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": "/d/jiangnan/daguanyuan/yhroom7",
  ]));

  setup();
  //        replace_program(ROOM);
}

void init() {
  add_action("do_circle", "circle");
}

int do_circle(string arg) {
  message_vision("$N在山脚下一转。\n", this_player());
  write("便是平坦大路，大门豁然出现在眼前。\n");
  this_player()->move("/d/jiangnan/daguanyuan/trace1");
  return 1;
}
