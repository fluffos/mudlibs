// poembook

inherit ITEM;

void create()
{
	set_name("诗稿", ({ "poembook" }));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long",
			"这是林黛玉一生心血写成的诗稿\n");
		set("value", 100000);
		set("master_id","NPC");
		set("material", "paper");
		set("skill", ([
			"name":	"literate",		// name of the skill
			"exp_required":	0,	// minimum combat experience required
			"literate_required":71,								// to learn this skill.
			"sen_cost":20,		// gin cost every time study this
			"difficulty":15,	// the base int to learn this skill
						// modify is gin_cost's (difficulty - int)*5%
			"max_skill":101		// the maximum level you can learn
											// from this object.
		]) );
	}
}
string query_autoload()
{
	object me,ob;
	ob=this_object();
	me=environment(ob);
if(ob->query("master_id")=="NPC" || ob->query("master_id")==me->query("id"))
	{
	ob->set("master_id",me->query("id"));
	return ob->query("master_id");
	}
else
	{return 0;}

}
void autoload(string arg)
{
	set("master_id",arg);
}

