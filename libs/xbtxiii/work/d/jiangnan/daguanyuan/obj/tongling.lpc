// tongling.c
//
#include <ansi.h>
#include <armor.h>

inherit NECK;
inherit F_AUTOLOAD;
inherit F_CLEAN_UP;


void create()
{
	set_name(HIG"通灵宝玉"NOR, ({"tongling-baoyu","baoyu"}) );
	set_weight(0);
    set("no_get",1);
	set("no_drop","这东西不能随便丢弃。\n\n");
	set("long",
		"通灵宝玉，正面写着：莫失莫忘，仙寿恒昌.\n"
		"再仔细玩看，似乎有其它作用 (info baoyu)。\n");
	if( clonep() )
			set_default_object(__FILE__);
	else
	{
		set("unit", "条");
		set("material", "cloth");
                set("armor_prop/personality",10);
                set("armor_prop/karma",10);
                set("armor_prop/composure",10);
                set("wear_msg","$N小心翼翼地把$n拿出来戴在脖子上。\n");
                set("unwear_msg","$N很小心地把$n从脖子上取下来。\n");
	}
}

void init()
{
        if( this_player()==environment() )
            add_action("do_info","info");
            add_action("do_pray","pray");
}

int do_info(string arg)
{
        if( !arg ) return notify_fail("你想知道什么? \n");
        write("使用 (pray 1) ，它会把你传送到雪亭镇饮风客栈。\n"
		"使用 (pray 2) ，它会把你传送到京城酒楼。\n"
		"使用 (pray 3) ，它会把你传送到金陵客栈。\n");
	
         return 1;
}

int do_pray(string arg)
{
      string name;
       name = (string)this_player()->query("name");

         if( !arg  ) return notify_fail("你要祈求什么? \n");
	else{
	  switch(arg){
	    case "1": 
         	 message_vision("$N双手合掌，闭目虔诚地祈祷。\n"
                 "颈上的通灵宝玉忽然泛出红光。 突然你觉得脚下轻飘飘地.... \n",this_player() );
        	 this_player()->receive_damage("sen",50);
        	 tell_room(environment(this_player()),
                name+"的身影化作一缕青烟消失了。\n",this_player() );
         	tell_room("/d/snow/inn",
                 name+"的身影在一股青烟中出现了。\n",this_player() );
         	this_player()->move("/d/snow/inn");
              	return 1;
	
	case "2":
			
         		message_vision("$N双手合掌，闭目虔诚地祈祷。\n"
            		 "颈上的通灵宝玉忽然泛出红光。 突然你觉得脚下轻飘飘地.... \n",this_player() );
         		this_player()->receive_damage("sen",50);
        		 tell_room(environment(this_player()),
                name+"的身影化作一缕青烟消失了。\n",this_player() );
         		tell_room("/d/snow/inn",
                 name+"的身影在一股青烟中出现了。\n",this_player() );
         		this_player()->move("/d/city/jiulou");
         		 
         		 return 1;
			
	case "3":
        			 message_vision("$N双手合掌，闭目虔诚地祈祷。\n"
           			  "颈上的通灵宝玉忽然泛出红光。 突然你觉得脚下轻飘飘地.... \n",this_player() );
         			this_player()->receive_damage("sen",50);
         			tell_room(environment(this_player()),
                name+"的身影化作一缕青烟消失了。\n",this_player() );
        			 tell_room("/d/snow/inn",
                 name+"的身影在一股青烟中出现了。\n",this_player() );
         			this_player()->move("/d/jiangnan/jinglin/inn");
          			
         			 return 1;
	}
	}
			
		
}



int query_autoload()
{
	return 1;
}


void owner_is_killed(object killer)
{

        if( !killer ) killer = environment();
        tell_room(environment(killer),
                HIY"\n你看到通灵宝玉掉在地上 ... \n"
                "啊 ... 它发出强烈的红光，刺得你睁不开眼\n"
                "忽然眼前一暗，你发觉通灵宝玉已经不见了。\n\n"NOR);
         destruct(this_object());
}

