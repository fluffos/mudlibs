// lingdaiyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("紫鹃", ({ "zi-juan" }));

  set("gender", "女性");
  set("age", 17);
  set("long",
    "她是林黛玉的丫鬟，是贾母派来服侍林黛玉的。\n");
  set("attitude", "peaceful");
  set("title", "林黛玉的丫鬟");

  set("str", 15);
  set("int", 30);
  set("spi", 30);
  set("per", 27);
  set("cps", 15);

  set("force", 800);
  set("max_force", 700);
  set("force_factor", 15);

  set("combat_exp", 9000);

  set_skill("unarmed", 50);
  set_skill("force", 70);
  set_skill("parry", 60);
  set_skill("dodge", 60);
  set_skill("literate", 80);
  set_skill("sword", 60);

  set_skill("stormdance", 80);
  set_skill("iceforce", 80);
  set_skill("tenderzhi", 70);

  map_skill("dodge", "stormdance");
  map_skill("force", "iceforce");
  map_skill("unarmed", "tenderzhi");

  set("inquiry", ([
    "林黛玉": "林姑娘啊，她身体不好，老是爱哭，我也跟着哭，呜呜...。",
  ]));

  setup();

  carry_object("/d/jiangnan/daguanyuan/obj/dress")->wear();
  carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("紫鹃你走进来，说：不要大声说话，林姑娘睡着了，不要吵醒了她。\n");
}

void die() {
  int i;
  object killer;

  if (objectp(killer = query_temp("last_damage_from")))
    killer->set("marks/dead", 1);

  ::die();

}
