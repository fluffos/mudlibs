// lingdaiyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("晴雯", ({ "qing-wen" }) );

        set("gender", "女性");
        set("age", 17);
        set("long",
                "她是贾宝玉的丫鬟，也是贾宝玉的得力丫鬟之一。\n");
        set("attitude", "peaceful");
        set("title", "贾宝玉的丫鬟");

        set("str", 15);
        set("int", 30);
        set("spi", 30);
        set("per", 27);
        set("cps", 15);

        set("force", 800);
        set("max_force", 700);
        set("force_factor", 15);

        set("combat_exp", 9000);

        set_skill("unarmed", 50);
        set_skill("force", 70);
        set_skill("parry", 60);
        set_skill("dodge", 60);
        set_skill("literate", 80);
        set_skill("sword", 60);



        create_family("红楼", 2, "弟子");
	set("inquiry", ([
                "贾宝玉" : "晴雯说“别提了，他是个混世魔王，我有时候也就故意气气他，嘻嘻。。。。",
                        ]) );    

        setup();
        
        carry_object("/d/jiangnan/daguanyuan/obj/dress")->wear();
        carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();

}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || !present(ob, environment(this_object())) ) return;
        say( "晴雯见你走进来，说：欢迎来大观园玩，但不要无理取闹哦。\n");
}

void die()
{
        int i;
        object killer;

        if(objectp(killer = query_temp("last_damage_from")))
            killer->set("marks/dead", 1);

        ::die();

}
