// lingdaiyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("贾迎春", ({ "jia-yingchun" }));

  set("gender", "女性");
  set("age", 18);
  set("long",
    "她生得肌肤微丰，身材合中，腮凝新荔，鼻腻峨脂，温柔沉默，观之可亲。\n");
  set("attitude", "peaceful");
  set("title", "紫菱洲");

  set("str", 20);
  set("int", 30);
  set("spi", 30);
  set("per", 28);
  set("cps", 25);

  set("force", 400);
  set("max_force", 400);
  set("force_factor", 10);

  set("combat_exp", 10000);

  set_skill("unarmed", 40);
  set_skill("force", 40);
  set_skill("parry", 40);
  set_skill("dodge", 50);
  set_skill("literate", 140);
  set_skill("sword", 30);



  create_family("红楼", 2, "弟子");
  /*	set("inquiry", ([
                "贾宝玉" : "唉，我已经很久没见他了，他真的不懂我的心吗？。",
                        ]) );    */

  setup();

  carry_object("/d/jiangnan/daguanyuan/obj/jiadress")->wear();
  carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("贾迎春说“我喜欢自己呆在房内，你不要来打扰我，请出去吧!'\n");
}

void die() {
  int i;
  object killer;

  if (objectp(killer = query_temp("last_damage_from")))
    killer->set("marks/dead", 1);

  ::die();

}
