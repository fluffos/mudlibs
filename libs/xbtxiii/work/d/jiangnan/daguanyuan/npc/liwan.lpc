// lingdaiyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("李纨", ({ "li-wan" }) );

        set("gender", "女性");
        set("age", 29);
        set("long",
                "她是王夫人的媳妇，年轻守寡，丈夫贾珠早丧。\n");
        set("attitude", "peaceful");
        set("title", "稻香老农");

        set("str", 20);
        set("int", 30);
        set("spi", 30);
        set("per", 28);
        set("cps", 15);

        set("force", 800);
        set("max_force", 800);
        set("force_factor",10);

        set("combat_exp", 100000);

        set_skill("unarmed", 80);
        set_skill("force", 80);
        set_skill("parry", 60);
        set_skill("dodge", 80);
        set_skill("literate", 100);
        set_skill("sword", 50);
/*
        set_skill("reddance", 80);
        set_skill("reddream-force", 80);
        set_skill("reddreamzhi", 90);

        map_skill("dodge", "reddance");
        map_skill("force", "reddream-force");
        map_skill("unarmed", "reddreamzhi");

*/
        create_family("红楼", 2, "弟子");
/*	set("inquiry", ([
                "贾宝玉" : "唉，我已经很久没见他了，他真的不懂我的心吗？。",
                        ]) );    */

        setup();
        
        carry_object("/d/jiangnan/daguanyuan/obj/jiadress")->wear();
        carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();

}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

 void greeting(object ob)
{
        if( !ob || !present(ob, environment(this_object())) ) return;
        say( "李纨你走进来，叹了口气说“丈夫早丧，我只好守着儿子过日子了!'\n");
} 
void die()
{
        int i;
        object killer;

        if(objectp(killer = query_temp("last_damage_from")))
            killer->set("marks/dead", 1);

        ::die();

}
