// lingdaiyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("薛宝钗", ({ "xue-baochai" }));

  set("gender", "女性");
  set("age", 16);
  set("long",
    "她是王夫人妹妹薛姨妈之女，国色天香，生得肌骨莹润，举止娴雅。\n");
  set("attitude", "peaceful");
  set("title", "蘅芜君");

  set("str", 10);
  set("int", 30);
  set("spi", 30);
  set("per", 30);
  set("cps", 20);

  set("force", 400);
  set("max_force", 400);
  set("force_factor", 10);

  set("combat_exp", 1500000);

  set_skill("unarmed", 40);
  set_skill("force", 40);
  set_skill("parry", 40);
  set_skill("dodge", 40);
  set_skill("literate", 150);
  set_skill("sword", 40);

  set_skill("stormdance", 50);
  set_skill("iceforce", 60);
  set_skill("tenderzhi", 50);

  map_skill("dodge", "stormdance");
  map_skill("force", "iceforce");
  map_skill("unarmed", "tenderzhi");

  set("inquiry", ([
    "贾宝玉": "宝玉啊，他有通灵宝玉，我有金钗，也不知道有没有联系。",
  ]));

  setup();

  carry_object("/d/jiangnan/daguanyuan/obj/jiadress")->wear();
  carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("我是在姨妈家做客的，同这里的姐妹玩的很开心!\n");
}

void die() {
  int i;
  object killer;

  if (objectp(killer = query_temp("last_damage_from")))
    killer->set("marks/dead", 1);

  ::die();

}
