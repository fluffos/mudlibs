
// lingdaiyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("史湘云", ({ "shi-xiangyun" }) );

        set("gender", "女性");
        set("age", 16);
        set("long",
                "她是贾母娘家的人，因为家里没人就住到荣国府来了，由于同薛宝钗最合得来，就与薛宝钗一起住在蘅芜院。\n");
        set("attitude", "peaceful");
        set("title", "枕霞旧友");

        set("str", 25);
        set("int", 30);
        set("spi", 30);
        set("per", 30);
        set("cps", 20);

        set("force", 400);
        set("max_force", 400);
        set("force_factor",10);

        set("combat_exp", 15000);

        set_skill("unarmed", 40);
        set_skill("force", 40);
        set_skill("parry", 40);
        set_skill("dodge", 40);
        set_skill("literate", 150);
        set_skill("sword", 40);



        create_family("红楼", 2, "弟子");
	set("inquiry", ([
                "贾宝玉" : "你说爱哥哥啊？我同他很合得来。",
                        ]) );    

        setup();
        
        carry_object("/d/jiangnan/daguanyuan/obj/jiadress")->wear();
        carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();

}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || !present(ob, environment(this_object())) ) return;
        say( "我是在大观园做客的，同这里的姐妹玩的很开心!\n");
}

void die()
{
        int i;
        object killer;

        if(objectp(killer = query_temp("last_damage_from")))
            killer->set("marks/dead", 1);

        ::die();

}
