// lingdaiyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("巧姐", ({ "qiao-jie" }) );

        set("gender", "女性");
        set("age", 10);
        set("long",
                "她是王熙凤的女儿。\n");
        set("attitude", "peaceful");
        set("title", "王熙凤女儿");

        set("str", 25);
        set("int", 30);
        set("spi", 30);
        set("per", 30);
        set("cps", 20);

        set("force", 400);
        set("max_force", 400);
        set("force_factor",10);

        set("combat_exp", 15000);

        set_skill("unarmed", 40);
        set_skill("force", 40);
        set_skill("parry", 40);
        set_skill("dodge", 40);
        set_skill("literate", 150);
        set_skill("sword", 40);

        set_skill("reddance", 50);
        set_skill("reddream-force", 60);
        set_skill("reddreamzhi", 50);

        map_skill("dodge", "reddance");
        map_skill("force", "reddream-force");
        map_skill("unarmed", "reddreamzhi");

        create_family("红楼", 3, "弟子");
    /*    set("inquiry", ([
                "贾宝玉" : "宝玉啊，他有通灵宝玉，我有金钗，也不知道有没有联系。",
                        ]) );    */

        setup();
        
        carry_object("/d/jiangnan/daguanyuan/obj/jiadress")->wear();
        carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();

}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

/* void greeting(object ob)
{
        if( !ob || !present(ob, environment(this_object())) ) return;
        say( "我是在姨妈家做客的，同这里的姐妹玩的很开心!\n");
} */

void die()
{
        int i;
        object killer;

        if(objectp(killer = query_temp("last_damage_from")))
            killer->set("marks/dead", 1);

        ::die();

}
