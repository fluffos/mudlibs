// lingdaiyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("贾探春", ({ "jia-tuanchun" }));

  set("gender", "女性");
  set("age", 16);
  set("long",
    "她生得削肩细腰，长挑身材，鸭蛋脸儿，俊眼修眉，顾盼神飞，文采
精华，见之忘俗。\n");
  set("attitude", "peaceful");
  set("title", "蕉下客");

  set("str", 20);
  set("int", 30);
  set("spi", 30);
  set("per", 30);
  set("cps", 25);

  set("force", 400);
  set("max_force", 400);
  set("force_factor", 10);

  set("combat_exp", 10000);

  set_skill("unarmed", 40);
  set_skill("force", 40);
  set_skill("parry", 40);
  set_skill("dodge", 50);
  set_skill("literate", 140);
  set_skill("sword", 30);



  create_family("红楼", 2, "弟子");
  /*	set("inquiry", ([
                "贾宝玉" : "唉，我已经很久没见他了，他真的不懂我的心吗？。",
                        ]) );    */

  setup();

  carry_object("/d/jiangnan/daguanyuan/obj/jiadress")->wear();
  carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("贾探春说“你见到了我的宝哥哥和林姐姐了吗？很久没开诗社了，应该开诗社了!'\n");
}

void die() {
  int i;
  object killer;

  if (objectp(killer = query_temp("last_damage_from")))
    killer->set("marks/dead", 1);

  ::die();

}
