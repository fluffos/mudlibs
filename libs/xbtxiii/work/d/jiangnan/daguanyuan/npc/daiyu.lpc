// lingdaiyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("林黛玉", ({ "ling-daiyu" }) );

        set("gender", "女性");
        set("age", 16);
        set("long",
                "她是贾母的外孙女，国色天香，两弯似蹙非蹙笼烟眉，一双似喜非喜含情目。\n"
                "态生两靥之愁，娇袭一身之病。泪光点点，娇喘微微。闲静似娇花照水，\n"
                "行动如弱柳扶风。心较比干多一窍，病如西子胜三分。\n");
        set("attitude", "peaceful");
        set("title", "潇湘妃子");

        set("str", 5);
        set("int", 30);
        set("spi", 100);
        set("per", 100);
        set("cps", 15);

        set("force", 300);
        set("max_force", 300);
        set("force_factor", 9);

        set("combat_exp", 11500);

        set_skill("unarmed", 30);
        set_skill("force", 30);
        set_skill("parry", 30);
        set_skill("dodge", 30);
        set_skill("literate", 150);
        set_skill("sword", 40);

        set_skill("stormdance", 50);
        set_skill("iceforce", 60);
        set_skill("tenderzhi", 50);

        map_skill("dodge", "stormdance");
        map_skill("force", "iceforce");
        map_skill("unarmed", "tenderzhi");

	set("inquiry", ([
                "贾宝玉" : "唉，我已经很久没见他了，他真的不懂我的心吗？。",
                        ]) );    

        setup();
        
        carry_object("/d/jiangnan/daguanyuan/obj/jiadress")->wear();
        carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();

}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 2, ob);
        }
}

void greeting(object ob)
{
        if( !ob || !present(ob, environment(this_object())) ) return;
        say( "林黛玉叹道：草木当春，花鲜叶茂，想我年纪尚小，便象三秋蒲柳。
             若是能随愿，或者渐渐的好来。不然只恐似那花柳残春，
	     怎禁得起风吹雨送!\n");
 
             
}

 int accept_object(object who, object ob)
{
     
     string objname;
 	objname = (string)ob->name();

       	if( objname != "西厢记") {
           command("smile");
            say ("这要送给我啊?! 我不喜欢。\n");
         // command("inn");
             return 1;
            }
     //  if ( ((int)ob->query("per")>=25)&& ((int)ob->query("kar")>=25) ){ 
      //    call_out( "make_stage", 2, who, 0 );
                                                
	    who->set_temp("baoyu/通灵宝玉", 1);  
            tell_object(who, "林黛玉很开心的翻开西厢记读了起来!\n\n");
            tell_object(who, "高兴地对你说:\n");
            tell_object(who, "『 真是一本好书，我很喜欢!』\n");
            tell_object(who, "你可以去找宝哥哥要一样东西哦! \n");
           
	/* return 1;
          }
          else {
             say ("林黛玉说：谢谢!你走吧，我要看书了! \n");
             return 1;
          }  */
          return 1;
}


void die()
{
        int i;
        object killer;

        if(objectp(killer = query_temp("last_damage_from")))
            killer->set("marks/dead", 1);

        ::die();

}
