// lingdaiyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("袭人", ({ "xi-ren" }));

  set("gender", "女性");
  set("age", 17);
  set("long",
    "她是贾宝玉的丫鬟，是贾宝玉的最宠爱的大丫鬟。\n");
  set("attitude", "peaceful");
  set("title", "贾宝玉的丫鬟");

  set("str", 15);
  set("int", 30);
  set("spi", 30);
  set("per", 30);
  set("cps", 15);

  set("force", 800);
  set("max_force", 700);
  set("force_factor", 15);

  set("combat_exp", 9000);

  set_skill("unarmed", 50);
  /*
        set_skill("force", 70);
        set_skill("parry", 60);
        set_skill("dodge", 60);
        set_skill("literate", 80);
        set_skill("sword", 60);

        set_skill("reddream-force", 80);
        set_skill("reddreamzhi", 70);

        map_skill("dodge", "reddance");
        map_skill("force", "reddream-force");
        map_skill("unarmed", "reddreamzhi");

        create_family("红楼", 2, "弟子");
*/
  set("inquiry", ([
    "贾宝玉": "他呀，就知道玩，不肯好好读书，我有时候也会故意气气他的。",
  ]));

  setup();

  carry_object("/d/jiangnan/daguanyuan/obj/dress")->wear();
  carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("袭人见你走进来，说：欢迎来我们这儿作客，但不要胡来哦!\n");
}

void die() {
  int i;
  object killer;

  if (objectp(killer = query_temp("last_damage_from")))
    killer->set("marks/dead", 1);

  ::die();

}
