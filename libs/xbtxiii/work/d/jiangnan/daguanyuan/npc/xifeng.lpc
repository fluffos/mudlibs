// lingdaiyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("王熙凤", ({ "wang-xifeng" }));

  set("gender", "女性");
  set("age", 22);
  set("long",
    "她是王夫人的媳妇，一双丹凤三角眼，两弯柳叶掉梢眉，身量苗条，\n"
    "体格风骚，粉面含春威不露，丹唇未启笑先闻。\n");
  set("attitude", "peaceful");
  set("title", "凤辣子");

  set("str", 20);
  set("int", 30);
  set("spi", 30);
  set("per", 30);
  set("cps", 20);

  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 20);

  set("combat_exp", 100000);

  set_skill("unarmed", 80);
  set_skill("force", 90);
  set_skill("parry", 60);
  set_skill("dodge", 80);
  set_skill("literate", 80);
  set_skill("sword", 50);

  set_skill("stormdance", 80);
  set_skill("iceforce", 80);
  set_skill("tenderzhi", 90);

  map_skill("dodge", "stormdance");
  map_skill("force", "iceforce");
  map_skill("unarmed", "tenderzhi");

  set("inquiry", ([
    "卖身契": "王熙凤说道：想替妙玉赎身啊？我也不一定能作主，不过。。。你应该明白我的意思，嘻嘻。",
  ]));

  setup();

  carry_object("/d/jiangnan/daguanyuan/obj/jiadress")->wear();
  carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("王熙凤叹了一口气说'唉，府里的事都要我管，真是累死人了!'\n");
}
int accept_object(object who, object ob) {

  if (ob->value() < 100000) {
    command("say 这点钱就想赎出妙玉？你也想得太天真了吧?\n");
    return 1;
  } else {
    if ((string)this_player()->query("gender") != "女性") {
      who->set_temp("sellself/卖身契", 1);
    } else {
      who->set_temp("sellself/卖身契", 2);
    }
    say("好了，这就是妙玉的卖身契，我现在就当着你的面撕掉了。你可以去找妙玉了。\n");
    return 1;
  }

  return 1;
}

void die() {
  int i;
  object killer;

  if (objectp(killer = query_temp("last_damage_from")))
    killer->set("marks/dead", 1);

  ::die();

}
