// lingdaiyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;
//inherit F_CLEAN_UP;

void create() {
  set_name("妙玉", ({ "miao-yu" }));

  set("gender", "女性");
  set("age", 16);
  set("long",
    "她原来是大家闺秀，因为家道沦落，不得已出家为尼。\n");
  set("attitude", "peaceful");
  set("title", "女尼");

  set("str", 25);
  set("int", 30);
  set("spi", 30);
  set("per", 30);
  set("cps", 20);

  set("force", 400);
  set("max_force", 400);
  set("force_factor", 10);

  set("combat_exp", 15000);

  set_skill("unarmed", 40);
  set_skill("force", 40);
  set_skill("parry", 40);
  set_skill("dodge", 40);
  set_skill("move", 100);
  set_skill("literate", 150);
  set_skill("sword", 40);



  create_family("红楼", 2, "弟子");
  set("inquiry", ([
    "还俗": "妙玉说：我是想还俗啊，可是我已经卖给了荣国府，如果你能要回我的卖身契，我就可以跟你走了。",
    "卖身契": "妙玉说：我的卖身契听说是王熙凤收藏着的。",
  ]));

  setup();

  carry_object("/d/jiangnan/daguanyuan/obj/jiadress")->wear();
  carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 2, ob);
  }
}

void greeting(object ob) {
  if ((int)query("cps") == 22) {
    say("妙玉高兴地说道：“这位" + RANK_D->query_respect(ob) + "辛苦了。\n");
    return;
  }
  if (((int)ob->query_temp("notnigu/还俗") == 1
    && (int)ob->query_temp("sellself/卖身契") == 2)) {
    object book;
    say("妙玉高兴地说道：“这位" + RANK_D->query_respect(ob)
      + "，多谢给我找回了卖身契，我从此就是你婢子了了。” \n");
    say("妙玉说道：“这本密籍是红楼派的宝书，就做为我们主仆的见面礼赠与你” \n");
    ob->set_temp("notnigu/还俗", 0);
    ob->set_temp("sellself/卖身契", 0);
    set("title", ob->query("name") + "的婢子");
    book = new("/d/jiangnan/daguanyuan/obj/redbook");
    book->move(ob);
    command("chat " +
      ob->query("name") + "已替我赎身，从今以后我就是他的婢子啦。\n");
    set("cps", 22);
    call_out("followhim", 20, ob);

  }
  if (((int)ob->query_temp("notnigu/还俗") == 1
    && (int)ob->query_temp("sellself/卖身契") == 1)) {
    object book;
    say("妙玉高兴地说道：“这位" + RANK_D->query_respect(ob)
      + "，多谢给我找回了卖身契，我从此就是你妻子了。” \n");
    say("妙玉说道：“这本密籍是红楼派的宝书，就做为我们夫妻分见面礼赠与你” \n");
    ob->set_temp("notnigu/还俗", 0);
    set("cps", 22);
    ob->set_temp("sellself/卖身契", 0);
    set("title", ob->query("name") + "的妻子");
    book = new("/d/jiangnan/daguanyuan/obj/redbook");
    book->move(ob);
    command("chat " + ob->query("name") + "已替我赎身,从今以后我就是他的妻子啦。\n");
    call_out("followhim", 20, ob);
  }

  if (((int)ob->query("per") >= 25)) {
    ob->set_temp("notnigu/还俗", 1);
    say("妙玉说：我多想回到以前的生活啊，只是现在做了尼姑，又没人帮我，我有什么办法呢？呜呜。。。!\n");

  }
}

void followhim(object ob) {
  object room;
  room = find_object("/d/jiangnan/daguanyuan/danroom");
  if (environment() == room)
    if (present(ob, environment())) {
      set_leader(ob);

    }
}


void die() {
  int i;
  object killer;

  if (objectp(killer = query_temp("last_damage_from")))
    killer->set("marks/dead", 1);

  ::die();

}
