// jiabaoyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("贾宝玉", ({ "jia-baoyu" }));

  set("gender", "男性");
  set("age", 17);
  set("long",
    "贾宝玉贾政和王夫人的二子。面如敷粉，唇若施脂，转盼
多情，语言若笑。天然一段风韵，全在眉梢；平生万种风情，
悉堆眼角。\n");
  set("attitude", "peaceful");
  set("title", "怡红公子");

  set("str", 20);
  set("int", 30);
  set("spi", 30);
  set("per", 30);
  set("cps", 20);

  set("force", 500);
  set("max_force", 500);
  set("force_factor", 10);

  set("combat_exp", 21500);

  set_skill("unarmed", 50);
  set_skill("force", 50);
  set_skill("parry", 50);
  set_skill("dodge", 50);
  set_skill("literate", 120);
  set_skill("sword", 50);

  set_skill("tiyunzong", 50);

  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "redstrike");

  create_family("红楼", 2, "弟子");
  set("inquiry", ([
    "林黛玉": "你问林妹妹啊？我这一生是非她莫娶的。",
    "林妹妹": "林妹妹啊？我这一生是非她莫娶的。",
  ]));

  setup();

  carry_object("/d/jiangnan/daguanyuan/obj/redcloth")->wear();
  carry_object("/d/jiangnan/daguanyuan/obj/redboot")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 2, ob);
  }
}

void greeting(object ob) {

  if (((int)ob->query_temp("baoyu/通灵宝玉") == 1
    && (int)ob->query_temp("xxbook/西厢记") == 1)) {
    object tongling;
    say("贾宝玉高兴地说道：“这位" + RANK_D->query_respect(ob)
      + "，多谢你把书给了林妹妹。” \n");
    say("贾宝玉说道：“这个通灵宝玉我看也不怎么样，就赠于" + RANK_D->query_respect(ob)
      + "。” \n");
    ob->set_temp("baoyu/通灵宝玉", 0);
    ob->set_temp("xxbook/西厢记", 0);
    tongling = new("/d/jiangnan/daguanyuan/obj/tongling");
    tongling->move(ob);
    destruct(this_object());
    return 0;
  }

  if (((int)ob->query("per") >= 25) && ((int)ob->query("kar") >= 25)) {
    ob->set_temp("xxbook/西厢记", 1);
    say("贾宝玉玉说道:怡红院后门外的小屋里有一本西厢记，麻烦你找出来送给林妹妹.\n");
    return 0;
  }

  if (!ob || !present(ob, environment(this_object()))) return;
  say("贾宝玉说:你有没有看见我的林妹妹啊？我真的好想她哦如果你见到她，
告诉她我马上就去看她。还有告诉她别再哭个不停了，要保重自己的身体。\n");

}

void die() {
  int i;
  object killer;

  if (objectp(killer = query_temp("last_damage_from")))
    killer->set("marks/dead", 1);

  ::die();

}
