// fisher.c

inherit NPC;

void create()
{
    set_name("大观园家丁", ({ "waiter" }) );
	set("gender", "男性" );
    set("age", 45);
       	set("long", @LONG 
一个精壮的汉子，偶尔抬头一看的眼神中精光大盛，很有可能
是江湖中人隐身于此。
LONG
);
         set("con",30);
         set("cor",30);
	set("attitude", "friendly");
        set("chat_chance", 2);
       	set("chat_msg", ({
"大观园家丁:这里可是大观园，不要乱走动。\n",
       }) );
         set("combat_exp",60000);

        set("chat_chance_combat", 10);
        set("chat_msg_combat", ({
"有种的去跟我家主人打，打我算什么英雄？！\n",
        }) );
	set("inquiry", ([
		"桂花" : "华中理工大学的桂花树比晚月庄多多了，你知道吗？",
	]) );

    set_skill("parry", 75);
    set_skill("dodge", 100);
    set_skill("unarmed", 150);
	set_skill("throwing", 150);

        set_skill("force", 15);
        set("force", 800);
        set("max_force", 800);
        set("force_factor", 0);

	setup();
    carry_object("/d/snow/obj/linen")->wear();
    carry_object("/u/cloud/obj/npc/butcher/skin_belt")->wear();
        add_money("silver", 10);

}
