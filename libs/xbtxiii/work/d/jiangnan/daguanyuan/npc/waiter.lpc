// wiater.c

inherit NPC;


void create() {
  set_name("管家", ({ "waiter" }));
  set("gender", "男性");
  set("age", 30);
  set("long", "管家的皮肤皮肤白嫩，虽然是一个下人，但也是保养的很好。\n");
  set("str", 27);
  set("combat_exp", 11500);
  set("attitude", "friendly");
  set("rank_info/respect", "管家");
  set_skill("unarmed", 100);
  set_skill("parry", 50);
  set_skill("dodge", 100);
  set("chat_chance", 6);
  set("chat_msg", ({
    "管家对你说:你是来参观大观园的吗？大观园很大，可别迷路哦。\n",
    "管家对你说:我想去趟扬州，可是又不认识路。   唉！\n",
  }));
  set("inquiry", ([
    "释仇": "释仇啊，只要付十两黄金就行了。",
  ]));

  setup();
  add_money("coin", 200);
  carry_object("/obj/cloth")->wear();
}



int accept_object(object who, object ob) {
  object map;
  if (ob->query("id") == "map3"
    && ob->query("material") == "copper") {
    map = new("/d/chaoting/jjf/obj/map4.lpc");
    map->move(who);
    call_out("todest", 1, ob);
    command("say 我这儿也有份地图，给你吧！\n");
    return 1;
  }


  if (ob->value() < 100000) {
    command("say 就这点钱，就想释仇？你也想得太天真了吧?\n");
    return 1;
  } else {
    who->set("marks/dead", 0);
    say("好了，我们之间的仇恨到此一笔勾销，希望你下次不要再胡来了!.\n");
    command("chat " +
      this_player()->query("name") + "已向红楼派道歉，以前的所有恩怨到此一笔勾销。\n");
    return 1;
  }

  return 1;
}


void todest(object ob) {
  destruct(ob);
}
