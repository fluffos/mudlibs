// lingdaiyu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("平儿", ({ "ping-er" }) );

        set("gender", "女性");
        set("age", 18);
        set("long",
                "她是王熙凤的侍女，是王熙凤的得力助手，荣国府的很多
		事情都是她经办的。\n");
        set("attitude", "peaceful");
        set("title", "王熙凤侍女");

        set("str", 15);
        set("int", 30);
        set("spi", 30);
        set("per", 27);
        set("cps", 15);

        set("force", 800);
        set("max_force", 700);
        set("force_factor", 15);

        set("combat_exp", 9000);

        set_skill("unarmed", 50);
        set_skill("force", 70);
        set_skill("parry", 60);
        set_skill("dodge", 60);
        set_skill("literate", 80);
        set_skill("sword", 60);

        set_skill("stormdance", 80);
        set_skill("iceforce", 80);
        set_skill("tenderzhi", 70);

        map_skill("dodge", "stormdance");
        map_skill("force", "iceforce");
        map_skill("unarmed", "tenderzhi");

	set("inquiry", ([
                "王熙凤" : "她是我的小姐，我是跟她一起到荣国府的。",
                        ]) );    

        setup();
        
        carry_object("/d/jiangnan/daguanyuan/obj/dress")->wear();
        carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();

}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || !present(ob, environment(this_object())) ) return;
        say( "平儿见你走进来，说：欢迎来我们这儿作客，但不要胡来哦!\n");
}

void die()
{
        int i;
        object killer;

        if(objectp(killer = query_temp("last_damage_from")))
            killer->set("marks/dead", 1);

        ::die();

}
