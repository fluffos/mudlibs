#include <room.h>

inherit ROOM;

void create()
{
        set("coor",({25,-750,0}));
	set("short", "扬州北门");
        set("long",
"这里扬州城的北门，一座高大的石牌楼上面刻著「扬州北门」四\n"
"个大字，一条大道往北穿过一片松树林，一直通向京城。门旁蹲\n"
"著两只石狮，扬州是长江北面的第一繁华城市，人来人往，熙熙\n"
"攘攘，煞是热闹。\n"
);

        set("outdoors", "yangzhou");
        set("exits", ([
                "south"          : "/d/yangzhou/beidajie2",
                "north"        : "/d/jiangnan/sroad12" ]) );
	 set("objects", ([
                "/d/yangzhou/npc/cityguard": 4,
                "/d/yangzhou/npc/garrison": 2,
        ]) );                         
	setup();
}

