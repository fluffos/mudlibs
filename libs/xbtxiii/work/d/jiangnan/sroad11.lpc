#include <room.h>
#include <roadbusy.h>

inherit ROOM;

void create()
{
        set("coor",({25,-650,0}));
	set("short", "江南驿道");
        set("long",
"这是一条青石铺地的大驿道.这是江南入京驿道，往北通往黑松\n"
"领。往南一直通向扬州。东北是一望无际的大平原，有许多农夫\n"
"真正地里忙碌着。往南就是扬州了，你擦擦额上的汗水，心理一\n"
"阵兴奋。脚步轻松了许多。\n"
);

        set("exits", ([
                "south"          : "/d/jiangnan/sroad12",
                "northwest"        : "/d/jiangnan/sroad10" ]) );
        set("outdoors", "yangzhou");
       	setup();
}

