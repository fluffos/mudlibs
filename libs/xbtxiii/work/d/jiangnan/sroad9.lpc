#include <room.h>

inherit ROOM;

void create()
{
        set("short", "黑松领");
        set("long",
"这是黑松领,岭上强盗盘据，无数行人在此丧生。由于这是江南\n"
"通往京城的必经之路，所以旅客没经此地无不小心翼翼，生怕落\n"
"入强盗手里。一轮火红的太阳高高挂在天空上。\n"
);

        set("exits", ([
                "southdown"          : "/d/jiangnan/sroad10",
                "northdown"        : "/d/jiangnan/sroad8" ]) );
	set("objects",(["/d/jiangnan/npc/gangster":2])); 
       	setup();
}

