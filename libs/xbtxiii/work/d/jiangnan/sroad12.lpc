#include <room.h>

inherit ROOM;

void create() {
  set("coor", ({ 25, -700, 0 }));
  set("short", "江南驿道");
  set("long",
    "这是一条青石铺地的大驿道.这是江南入京驿道，往北通往黑松\n"
    "领。往南一直通向扬州。东北是一望无际的大平原，有许多农夫\n"
    "真正地里忙碌着。往南就是扬州了，你擦擦额上的汗水，心理一\n"
    "阵兴奋。脚步轻松了许多。\n"
  );

  set("outdoors", "yangzhou");
  set("exits", ([
    "south": "/d/jiangnan/sroad13",
    "north": "/d/jiangnan/sroad11" ]));
  setup();
}

int valid_leave(object me, string dir) {
  object ob;
  object *inv;
  int i;
  if (dir == "south" && ob = present("soldier", this_object())) {
    if (ob->query("leader") == me->query("name") &&
      me->query("rank") == 1) return 1;
    else {
      inv = all_inventory(me);
      for (i = 0; i < sizeof(inv); i++) {
        if (((inv[i]->query("targetid")) == me->query("id"))
          && ((string)(inv[i]->query("id")) == "token"))
          return 1;
      }
      return notify_fail(ob->name() + "向你嚷道：奉" +
        ob->query("leader") + "之命封锁此路!没有通行证不得通过!\n");
    }
  } else return 1;
}
