// liumangtou.c

inherit NPC;

void create() {
  set_name("流氓头", ({ "liumang tou", "liumang", "liu" }));
  set("gender", "男性");
  set("age", 25);
  set("long", "他长得奸嘴猴腮的，一看就不像是个好人。\n");

  set("combat_exp", 7000);
  set("shen_type", -1);
  set("attitude", "peaceful");
  set("rank_info/respect", "流氓头");

  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}

int accept_object(object who, object ob) {
  if (ob->value() < 800) {
    command("say 就这点钱，你想让我喝西北风啊？");
    command("drop all");
    return 1;
  } else {
    tell_object(who, "    流氓头高兴地说:太好了，快上车。\n");
    tell_object(who, "    你慢慢地走上了马车。屁股还没有坐稳，马车就出发了。\n");
    if ((ob->value() >= 800) && (ob->value() < 1000))
      who->move("/d/city/northdoor");
    else if ((ob->value() >= 1000) && (ob->value() < 1200))
      who->move("/d/jiangnan/jinglin/inn");
    else who->move("/d/snow/postoffice");
    tell_object(who, "    经过长途跋涉，你来到了目的地。\n");
    return 1;
  }
  return 1;
}
