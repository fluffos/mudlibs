// Room: /city/qianzhuang.c
// YZC 1995/12/04 

inherit BANK;

int do_apply(string arg);

void create()
{
	set("short", "钱庄");
	set("long", @LONG
	这是一家老字号的钱庄，已有几百年的历史，在全国各地都有分店。它发
行的银票信誉非常好，通行全国。柜台上放著一块牌子(sign)。
LONG
	);

	set("exits", ([
		"east" : __DIR__"beidajie1",
	]));
        set("item_desc", ([
                "sign": @TEXT
这里是钱庄，目前我们提供的服务有：

convert     兑换钱币
apply card  申请信用卡

TEXT
        ]) );

	set("objects", ([
		__DIR__"npc/qian" : 1
	]));

	setup();
	
}

init()
{
::init();
add_action("do_apply","apply");
}

int do_apply(string arg)
{
object me,book,*ob;
int s;
me=this_player();
if (!arg) return 0;
if (arg!="card") return 0;
ob=all_inventory(me);
s=sizeof(ob);
while(s--)
	{
	if (!stringp(ob[s]->query("id"))) continue;
	if (ob[s]->query("id")=="account card")
		{
		tell_object(me,"你已经有金龙卡了!\n");
		return 1;
		}
	}
book=new("/obj/a_book.lpc");
book->set("master_id",me->query("id"));
book->set("rich",0);
book->move(me);
if (file_size(book->query_save_file()+SAVE_EXTENSION)>0) book->restore();
tell_object(me,"你忽然觉得腰包一鼓, 好象多了点什么.\n");
tell_room(this_object(),"钱庄老板把金龙卡递给"+me->query("name")+".\n",me);
return 1;
}
