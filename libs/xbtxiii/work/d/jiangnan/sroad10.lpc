#include <room.h>

inherit ROOM;

void create()
{
        set("coor",({0,-600,0}));
	set("short", "江南驿道");
        set("long",
"这是一条青石铺地的大驿道.这是江南入京驿道，往北的岭上是\n"
"黑松领，据说黑松领的强盗很利害，已经有无数旅客在此丧生。\n"
"往南一直通向扬州。东北是一望无际的大平原，有许多农夫真正\n"
"地里忙碌着。\n"
);

        set("outdoors", "yangzhou");
        set("exits", ([
                "southeast"          : "/d/jiangnan/sroad11",
//             "northup"        : "/d/jiangnan/sroad9" ,
             "north"        : "/d/manglin/edge4" ,
                                   ]) );
        set("objects", ([
                __DIR__"npc/yetu" : 3,
        ]));
        setup();
}

