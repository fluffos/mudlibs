#pragma save_binary
//guidecard.c
inherit ITEM;

void create()
{
	set_name("迷途知返", ({"guidecard"}) );
	set_weight(10);
	set("no_get",1);
	set("no_drop",1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("material", "paper");
	  }
	  set("map",([
		__DIR__"inn":"east",
		__DIR__"temple":"west",
		__DIR__"work":"west",
		__DIR__"bank":"east",
		__DIR__"postoffice":"east",
		__DIR__"eroad1":"west,
		__DIR__"eroad2":"southwest",
		__DIR__"eroad3":"southwest",
		__DIR__"guestroom":"north",
		__DIR__"hockshop":"west",
		__DIR__"hockshop2":"west",
		__DIR__"inn_2f":"down",
		__DIR__"innerhall":"west",
		__DIR__"inneryard":"west",
		__DIR__"nyard":"south",
		__DIR__"school":"north",
		__DIR__"school1":"west",
		__DIR__"school2":"west",
		__DIR__"schoolhall":"west",
		__DIR__"smithy":"east",
		__DIR__"tao":"southdown",
		__DIR__"weapon_storage":"south",
		"/d/waterfog/entrance":"south",
		"/d/waterfog/sroad1":"south",
		"/d/waterfog/sroad2":"south",
		"/d/waterfog/sroad3":"south",
		"/daemon/class/fighter/guildhall":"south",
	    ]));
}

