#pragma save_binary
// post_officer.c

inherit NPC;

string goto_where;

string send_mail();
string receive_mail();
void goto_1(object);
void goto_2(object);
void goto_3(object);
void goto_4(object);

void create() {
  set_name("杜宽", ({ "post officer", "officer" }));
  set("title", "雪亭驿长");
  set("gender", "男性");
  set("age", 43);
  set("long",
    "杜宽担任雪亭驿的驿长已经有十几年了  虽然期间有几次升迁的\n"
    "机会  但是他都因为舍不得离开这个小山村而放弃了  雪亭镇的\n"
    "居民对杜宽的风评相当不错  常常会来到驿站跟他聊天。\n");
  set("shen_type", 1);
  set("combat_exp", 800);
  set("attitude", "friendly");
  set("rank_info/respect", "驿长");
  set("inquiry", ([
    "驿站": "是啊... 这里就是雪亭驿  你要寄信吗  ",
    "寄信": (: send_mail :),
    "收信": (: receive_mail :),
  ]));
  set_skill("literate", 70);
  set_skill("dodge", 50);
  set_skill("unarmed", 40);
  setup();
  add_money("coin", 70);
}

string send_mail() {
  object mbox;

  if (this_player()->query_temp("mbox_ob"))
    return "你的信箱还在吧  用信箱就可以寄信了。\n";
  if (!environment()
    || base_name(environment()) != query("startroom"))
    return "真是抱歉  请您等一下到驿站来找我吧。\n";
  seteuid(getuid());
  mbox = new(MAILBOX_OB);
  mbox->move(this_player());
  command("chat 大家赶快来申请信箱啊！再不来可就没有了!!。");
  return "哦... 要寄信是吗  这是你的信箱  寄信的方法信箱上有说明。\n";
}

string receive_mail() {
  object mbox;

  if (this_player()->query_temp("mbox_ob"))
    return "你的信箱还在吧  你所有的信都在里面。\n";
  if (!environment()
    || base_name(environment()) != query("startroom"))
    return "真是抱歉  请您等一下到驿站来找我吧。\n";
  seteuid(getuid());
  mbox = new(MAILBOX_OB);
  mbox->move(this_player());
  return "好  待我找找....有了  你的信箱在这  慢慢看吧  不打搅你了。\n";
}

int accept_object(object who, object ob) {
  if (ob->value() < 100) {
    command("say 就这点钱，你想让我喝西北风啊？");
    //command("drop all");
    return 1;
  } else {
    tell_object(who, "杜宽高兴地说:太好了，请上车吧! \n");
    if ((ob->value() >= 100) && (ob->value() < 200)) goto_where = "/d/city/northdoor";
    else if ((ob->value() >= 100) && (ob->value() <= 200)) goto_where = "/d/yangzhou/guangchang";
    else goto_where = "/d/jiangnan/jinglin/inn";
    call_out("goto_1", 2, who);
    return 1;
  }


  return 1;
}

void goto_1(object ob) {
  tell_object(ob, "\n");
  tell_object(ob, "你慢慢地走上了马车。屁股还没有坐稳，马车就出发了。\n");
  call_out("goto_2", 2, ob);
  return;
}

void goto_2(object ob) {
  tell_object(ob, "\n");
  tell_object(ob, "马车在青石官道上行驶，平稳极了。虽然路边风景优美，但你却无暇观看。\n");
  tell_object(ob, "时有几匹快马，从来路赶上。你不由手里一紧，已抓紧剑梢。\n");
  tell_object(ob, "“防人之心不可无啊”！  \n");
  call_out("goto_3", 5, ob);
  return;
}

void goto_3(object ob) {
  tell_object(ob, "\n");
  tell_object(ob, "经过长途跋涉，你来到了目的地。\n");
  tell_object(ob, "\n");

  call_out("goto_4", 2, ob);
  return;
}

void goto_4(object ob) {
  ob->move(goto_where);
  return;
}
