void create() {
	string *surname=({"赵","钱","孙","李","周","吴","郑","王","林","郭",
			"冯","刘","彭",});
     set_name(surname[random(sizeof(surname))]+"巡捕", ({ "yamen police","yamen","police"}) );
       set("shen_type",1);
     set("gender", "男性" );
     set("age", 25);
     set("str", 45);
     set("cor", 50);
     set("cps", 35);
     set("int", 20);
     set("per", 20);
     set("kar", 15);
     set("long",@LONG
     四大名捕调教出来的高徒，个个身手矫健，强盗、山贼无不闻风丧胆。
LONG
);
     set("status","patrol");
        set("vendetta/japanese",1);
     set("CatchWho",0);
      set("combat_exp", 600000);
     set("attitude", "heroism");
     set("chat_chance_combat", 40);
     set("chat_msg_combat", ({
			    "巡捕说道：你想干什么? 还不跟我去县衙受审!?\n",
			    "巡捕说道：大胆! 居然敢当街拒捕! 想造反？\n",
			    "巡捕手中的刀越砍越快，让你应接不暇。\n",
			    "巡捕说道：别胡闹了，还是乖乖的跟我走吧。\n"
			    }) );
     set ("inquiry",([
		"bribery":
"说哪里话来，县太爷清贫廉正，我们作手下的岂能辱没他的名声？！\n"+
"收起你的钱吧！\n",
		"salary":
"哎，老爷俸银微薄，我们的年饷自然更少了......\n",
		"money":
"说实在的，我也想要钱。但要是让老爷知道了我收受贿赂(bribery)，\n不死也得扒层皮\n",
			]));
     set ("chat_chance",90);
     set ("chat_msg", ({
		      (:patrol:),
		      }) );
	 set("pursuer",1);
  set_skill("blade", 120);
   set_skill("parry", 120);
   set_skill("dodge", 120);
   set_skill("perception", 120);
   set_skill("pyrobat-steps", 120);
   set_skill("spring-blade", 120);
     map_skill("blade", "spring-blade");
     map_skill("dodge", "pyrobat-steps");
     direction=GO;
     setup();
     carry_object(__DIR__"obj/blade")->wield();
     carry_object(__DIR__"obj/police_cloth")->wear();
     carry_object(__DIR__"obj/guidecard");
     add_money("silver",30);
}

void init()
{
object catchwho,you,*npc;
object oldman,start_room;
int i,tmp;
seteuid(getuid());
catchwho=query("CatchWho");
you=this_player();
if (query("status")=="patrol")
   {
   if (!is_fighting()&&interactive(you)&&living(you))
      {
	  npc=all_inventory(environment());
	  i=sizeof(npc);
	  while (i--)
	    {
		if (npc[i]->query("id")=="gangster"&&!userp(npc[i]))
			{
			say(HIW "今儿是什么日子？\n"+"居然"+
				npc[i]->query("name")+
				"也敢在大街上溜哒！" NOR);
			npc[i]->remove_all_enemy();
			say("去死吧！！\n");
			EMOTE_D->do_emote( npc[i],"fear");
			kill_ob(npc[i]);
			npc[i]->kill_ob(this_object());
			}
		else if (npc[i]->query("title")=="野羊山寨二寨主"&&!userp(npc[i]))
			{
			say(HIR "哼，铁判官的手下败将！总有一天我们要荡平野羊山寨！\n" NOR);
			npc[i]->remove_all_enemy();
			EMOTE_D->do_emote( npc[i],"fear");
			kill_ob(npc[i]);
			}
		}
if (!you->query_temp("being_caught"))
	{
	if (you->query("marks/thief")&&random(10)<7)
	   {
	   say (HIR "闹了半天原来"+you->query("name")+
		"是个贼啊! 我走一趟吧!\n" NOR);
	you->remove_all_enemy();
   	you->add("crime_lv",THIEF*you->query("marks/thief"));
	   you->delete("marks/thief");
	   catchyou(you);
	   }
	else
	    if (you->query("marks/强盗")&&random(10)<9)
	       {
		you->remove_all_enemy();
	       message_vision("$N对着$n喝道：光天化日之下，你居然也敢行凶杀人？还不与我回去吃板子！\n"
		+"说罢，$N解下铁链套在$n的脖子上。\n",this_object(),you);
   		you->add("crime_lv",ROBBER*you->query("marks/强盗"));
	        you->delete("marks/强盗");
	       	catchyou(you);
		}
	}
	}
   }
else if (query("status")=="catching")
   {
   catchyou(catchwho);
   message_vision(HIR "只见$N突然从腰间解下一条铁链套在$n的脖子上。\n"NOR,
		this_object(),catchwho);
   }
else if (query("status")=="caught")
{
      if (objectp(catchwho=query("CatchWho")))
      	{
	    if (BigWay[file_name(environment())][direction]==0)
	 		{
			if (!objectp(start_room=find_object("/d/snow/yamen.lpc")))
				{
				call_other("/d/snow/yamen","???");
				start_room=find_object("/d/snow/yamen.lpc");
				}
	 		oldman=present("county magistrate",start_room);
		 	catchwho->move(start_room);
			catchwho->set_leader(0);
		 	tell_object(catchwho,"忽见一只大手将你凭空抓走!\n");
		 	tell_object(catchwho,query("name")+
			"说道: 老爷，人犯已带到，小人巡街去了。\n");
			oldman->settle_lawsuit(catchwho);
			catchwho->delete_temp("being_caught");
		 	if (query("callout"))
					{
					destruct(this_object());
					return;
					}
		 	set("CatchWho",0);
		 	direction=GO;
		 	set("status","patrol");
			}
   	 	}
}
add_action("do_go","go");
add_action("do_quit","quit");
add_action("accept_bribery","bribe");
add_action("do_follow","follow");
return;
}

void patrol()
{
int i,on_way;
object *content,start_room,catchwho,crime;
string *bigwayname,where,dir;
bigwayname=keys(BigWay);
where=file_name(environment());
write("in patrol\n");
for (i=0;i<sizeof(bigwayname);i++)
    {
    if (where==bigwayname[i])
       {
      on_way=1;
       break;
       }
    else on_way=0;
    }
if (on_way)
   {
   if (this_object()->query("status")=="patrol")
      {
      if (!BigWay[where][direction]) direction=1-direction;
      }
   else if (this_object()->query("status")=="catching")
      {
      catchyou(catchwho);
      message_vision(HIR "只见$N突然从腰间解下一条铁链套在$n的脖子上"NOR,
			this_object(),catchwho);
      }
   else if(query("status")=="caught")
	init();
  }
else
   {
   content=all_inventory(this_object());
   for (i=0;i<sizeof(content);i++)
       {
       if (content[i]->query("id")=="guidecard")
	   		{
	  		if (!stringp(dir=content[i]->query("map")[where]))
				{
				start_room=find_object("/d/snow/square.lpc");
				move(start_room);
				if (objectp(crime=query("CatchWho")))
					{
					if (userp(crime))
						crime->move(start_room);
					}
				}
		  	else mygo(dir);
			break;
	  		}
   		}
	return;
	}
mygo(BigWay[where][direction]);
}

void catchyou(object crime)
{
object ob;
ob=this_object();
while (environment(ob)!=environment(crime))
		   move(environment(crime));
crime->set_leader(ob);
set("CatchWho",crime);
set("status","caught");
crime->set_temp("being_caught",1);
command("chat "+this_player()->query("name")+"注意了! 罪人"+crime->query("name")+
	"正被捉拿归案, 不可步其后尘!!!\n");
direction=BACK;
return;
}

int mygo(string dir)
{
//GO_CMD->main(this_object(),dir);
command("go "+dir);
return 1;
}

int do_go(string arg)
{
object me;
me=this_player();
if (!me->query_temp("being_caught")) return 0;
tell_object(me, "嘿嘿, 还想往哪逃?!\n");
return 1;
}

int do_quit(string arg)
{
object me;
me=this_player();
if (!me->query_temp("being_caught")) return 0;
if (is_fighting()&&random(20)<16)
	{
	me->delete_temp("being_caught");
	set("status","patrol");
	set("CatchWho",0);
	if (query("callout")) destruct(this_object());
	return 0;
	}
message_vision(HIR "$N紧紧拎着$n的衣领, $n无法退出!\n" NOR, this_object(),me);
return 1;
}

void die()
{
object killer;
if (objectp(killer=query_temp("last_damage_from")))
	{
	killer->delete_temp("being_caught");
	killer->add("crime_lv",5);
	}
::die();
}

int accept_bribery(string arg)
{
object money_ob,me,ob;
string toid,money;
int amount,bv1,i;
me=this_player();
if(!(me->query_temp("being_caught"))) return 0;
if (!arg||sscanf(arg,"%s with %d %s",toid,amount,money)!=3) return 0;
if (!objectp(present(toid,environment())))
	return notify_fail("你要贿赂谁？\n");
money_ob=present(money+"_money",this_player());
if (!money_ob) return notify_fail("你身上没有这种货币。\n");
if( amount < 1 ) return notify_fail("货币使用至少要一个/每次。\n");
if( (int)money_ob->query_amount() < amount )
		return notify_fail("你身上没有那多" + money_ob->query("name") + "。\n");
bv1 = money_ob->query("base_value");
if( !bv1 ) return notify_fail("这种东西不值钱。\n");
if (bv1*amount>=100000)
	{
	write("这怎么好?......要是让老爷知道了......\n");
	write("不过盛情难却....我就收下了..\n");
	EMOTE_D->do_emote(this_object(),"grin",me->query("id"));
	ob=new(base_name(money_ob));
	ob->set_amount(amount);
	ob->move(this_object());
	money_ob->add_amount(-amount);
	me->delete_temp("being_caught");
	if (me->query("crime_lv")>3)
			me->add("crime_lv",-3);
	else me->delete("crime_lv");
	me->set_leader(0);
	set("status","patrol");
	set("CatchWho",0);
	direction=GO;
	return_home("/d/snow/yamen_gate.lpc");
	}
else
	{
	write("你这是什么意思?......谁稀罕你的钱?!\n");
	me->add("crime_lv",1);
	}
return 1;
}

int do_follow(string arg)
{
if (this_player()->query_temp("being_caught"))
	{
	write("乖乖地跟官爷走吧!\n");
	return 1;
	}
return 0;
}

void heart_beat()
{
	int wimpy_ratio, cnd_flag;
	mapping my;
	object ob;

	my = query_entire_dbase();

	if( my["eff_kee"] < 0 || my["eff_sen"] < 0 || my["eff_gin"] < 0) {
		remove_all_enemy();
		die();
		return;
	}

	if( my["kee"] < 0 || my["sen"] < 0 || my["gin"] < 0) {
		remove_all_enemy();
		if( !living(this_object()) ) die();
		else unconcious();
		return;
	}

	if( is_busy() ) {
		continue_action();
		return;
	} else {
		if( is_fighting()
		&&      intp(wimpy_ratio = (int)query("env/wimpy"))
		&&      wimpy_ratio > 0
		&&      (       my["kee"] * 100 / my["max_kee"] <= wimpy_ratio
			||      my["sen"] * 100 / my["max_sen"] <= wimpy_ratio
			||      my["gin"] * 100 / my["max_gin"] <= wimpy_ratio) )
			GO_CMD->do_flee(this_object());
		attack();
	}

		this_object()->chat();
		if( !this_object() ) return;

	if( tick--  ) return;
	else tick = 5 + random(10);

	if( !interactive(this_object()) ) return;
}

