#include <command.h>
#include <ansi.h>
#define THIEF 3
#define ROBBER 5
#define GO 0
#define BACK 1
inherit NPC;

void patrol();
void catchyou(object);
int mygo(string);
int do_go(string arg);
int do_quit(string arg);
int accept_bribery(string);
int do_follow(string );

int direction=GO;

mapping BigWay=([
		"/d/snow/yamen_gate":({"southeast",0}),
		"/d/snow/yamen_square":({"east","northwest"}),
