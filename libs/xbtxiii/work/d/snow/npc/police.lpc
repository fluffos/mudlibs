                "/d/snow/nroad7":({"east","west"}),
                "/d/snow/nroad6":({"east","west"}),
		"/d/snow/nroad3":({"east"}),
		"/d/snow/nroad1":({"east","west","north","south"}),
		"/d/snow/nroad0":({"east","west"}),
		"/d/snow/crossroad":({"south","west"}),
		"/d/snow/mstreet4":({"south","north"}),
*/
        "/d/snow/postoffice":({"east","west"}),
        "/d/snow/mstreet4":({"south","west"}),
		"/d/snow/mstreet3":({"south","north"}),
		"/d/snow/mstreet2":({"south","north"}),
		"/d/snow/mstreet1":({"south","north"}),
		"/d/snow/square":({"south","north"}),
		"/d/snow/sroad1":({"west","north"}),
		"/d/snow/sroad2":({"west","east"}),
		"/d/snow/sroad3":({"southwest","east"}),
		"/d/snow/sroad0":({"west","northeast"}),
		"/d/ustc/street1":({"north","east"}),
		"/d/snow/wroad2":({"northwest","south"}),
		"/d/snow/wroad1":({"northeast","southeast"}),
		"/d/snow/wroad0":({0,"southwest"}),
