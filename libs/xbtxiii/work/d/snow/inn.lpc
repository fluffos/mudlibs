#pragma save_binary
// void.c (re-created after Elon screwed it up on 07-24-95)

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("short", "最後乐园");
  set("long",
    "这里就是传说中的VOID--大神和巫师的最後乐园.你看到四周一\n"
    "片白茫茫的,不一会从虚无中冒出一只企鹅,递给你一罐「可口可\n"
    "乐」(tm),然後站在一旁很邪恶地笑著.又过了一会,一只北极熊\n"
    "走了过来,一掌拍扁了那只企鹅并从你手上抢走那瓶可乐,大笑三\n"
    "声後就从你眼前消失了.你摇摇头,这种地方还是不要待太久的好.\n"
  );
  set("exits", ([
    "out": "/d/fy/fysquare",
  ]));
  // i add a exit, because when some place wrong,players maybe be here,
  // they can't leave here, only wiz can help them.
  //if wiz is not in mud, maybe they will cry all day and all night.
  // By apollo 
  setup();
  replace_program(ROOM);
}
