inherit ROOM;

void create() {
  set("short", "白龙洞");
  set("long",
    "白龙洞据说是《白蛇传》中的白娘子修炼成仙之处。这里楠木参\n"
    "天，林荫夹道，株株秀挺俊拔，枝叶分披上捧，如两手拥佛，传\n"
    "为古时一高僧按《法华经》口诵一字，植树一株，共植六万九千\n"
    "七百七十七株，时称古德林。这里北上至万年庵，南下是清音阁。\n"
  );
  set("outdoors", "emei");
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "gudelin1",
    "west": __DIR__ "gudelin2",
    "northup": __DIR__ "wannianan",
    "southeast": __DIR__ "qingyinge",
  ]));
  set("no_clean_up", 0);
  setup();
}
