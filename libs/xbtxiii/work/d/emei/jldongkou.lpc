//Room: jldongkou.c 九老洞口
//Date: Oct. 2 1997 by That

inherit ROOM;

void create() {
  set("short", "九老洞口");
  set("long",
    "九老洞在仙峰寺外。传说远古时候，有九位仙叟住在这个洞里，\n"
    "不知他们生于何年，终于何年。轩辕皇帝访道于此，见一老叟，\n"
    "问曰：『有侣乎？』答曰：『九人』。这就是九老洞的来历。这\n"
    "个洞很深，很少有人进去，只有些人站在洞口谈笑呼叫（yell）。\n"
    "这里向西经九十九道拐到千佛庵，一路向北到莲花石。\n"
  );
  set("objects", ([
    __DIR__ "npc/little_monkey": 2,
  ]));
  set("outdoors", "emei");
  set("exits", ([ /* sizeof() == 1 */
    "enter": __DIR__ "jiulaodong",
    "northwest": __DIR__ "lianhuashi",
    "northeast": __DIR__ "jsjdg4",
  ]));
  //      set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_yell", "yell");
}

int do_yell(string arg) {
  object me;

  me = this_player();
  message_vision("$N站在洞口向里大叫：“0”\n", me);
  write("洞内传来一阵回声：“0～～～0～～～0～～～”\n");
  return 1;
}
