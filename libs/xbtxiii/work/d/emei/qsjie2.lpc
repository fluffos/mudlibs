inherit ROOM;

void create() {
  set("coor", ({ -600, -1500, 0 }));
  set("short", "青石阶");
  set("long",
    "已经是峨嵋山脚下了。南面一条通往峨嵋的青石阶，两旁绿树荫\n"
    "蔽，空气十分清新。西南方通向南诏的大理国。西边好象有人搭\n"
    "了个小草棚。\n"
  );
  set("outdoors", "emei");
  set("exits", ([ /* sizeof() == 1 */
    "northeast": __DIR__ "qsjie1",
    //          "southwest"  : "/d/dali/road1",
    "southup": __DIR__ "bgsgate",
    "west": __DIR__ "caopeng",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
