    "的农舍耕田，但路上行人很少，都匆匆赶路。\n"
  );
  set("outdoors", "emei");
  set("exits", ([
    "south": __DIR__ "qsjie1",
    "east": __DIR__ "xiaolu1",
  ]));
  set("no_clean_up", 0);
  setup();
}
