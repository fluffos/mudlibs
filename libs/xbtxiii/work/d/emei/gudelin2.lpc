inherit ROOM;
string look_shibei();

void create() {
  set("short", "古德林");
  set("long",
    "这是一片密密的楠木林，株株秀挺俊拔，枝叶分披上捧，如两手\n"
    "拥佛，据说有七万株之多，要是不熟悉地形很容易迷路。林中有\n"
    "一片空地，几只楠木桩排成梅花模样。\n"
  );
  set("outdoors", "emei");
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "bailongdong",
    "southeast": __DIR__ "gudelin1",
    "southwest": __DIR__ "gudelin1",
    "northeast": __DIR__ "gudelin1",
    "northwest": __DIR__ "gudelin1",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
