//Room: heilong1.c 黑龙江栈道
//Date: Oct. 2 1997 by That

inherit ROOM;

void create() {
  set("short", "黑龙江栈道");
  set("long",
    "黑龙江栈道沿黑龙江而建。这里一山中开，两崖并立，形成一道\n"
    "宽仅数尺，长达几百米的深峡——白云峡。黑龙江栈道就从狭窄\n"
    "的白云峡中转折穿过，架设在绝壁上。走在栈道上，只觉道窄人\n"
    "危；俯视深涧，急流飞旋，山静而觉动；仰观头顶，天光如隙，\n"
    "崖开而欲合。这就是天开画图的「一线天」。栈道南通千佛庵，\n"
    "北至清音阁。\n"
  );
  set("outdoors", "emei");
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "heilong2",
    "northeast": __DIR__ "qingyinge",
  ]));
  set("no_clean_up", 0);
  setup();
}
