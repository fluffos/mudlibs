#include <ansi.h>
inherit ROOM;
string look_gate();

void create() {
  set("short", "报国寺山门");
  set("long",
    "报国寺为峨嵋出入之门户。山门(gate)上有一块大匾。寺外苍楠\n"
    "环卫，翠柏掩映。由此一路向西上开始登峨嵋山，北面下山是一\n"
    "条弯弯的石阶路。\n"
  );
  set("outdoors", "emei");
  set("item_desc", ([
    "gate": (: look_gate :),
  ]));
  set("objects", ([
    __DIR__ + "npc/guest": 1,
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "northdown": __DIR__ "qsjie2",
    "west": __DIR__ "bgs",
  ]));
  //      set("no_clean_up", 0);
  setup();
}
string look_gate() {
  return HIR "　　　　　　　　≌≌≌≌≌≌≌≌≌≌≌≌≌≌≌≌≌\n"
    HIR "　　　　　　　　≌≌　　　　　　　　　　　　　≌≌\n"
    HIR "　　　　　　　　≌≌" HIY "     报　　国　　寺" HIR "   ≌≌\n"
    HIR "　　　　　　　　≌≌　　　　　　　　　　　　　≌≌\n"
    HIR "　　　　　　　　≌≌≌≌≌≌≌≌≌≌≌≌≌≌≌≌≌\n" NOR;
}
