#pragma save_binary
#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("coor", ({ 1700, 3800, 0 }));
  set("short", "晚月庄大门");
  set("long",
    "你来到了这个小径的尽头，一个有著朱红漆大门大宅院矗立在你\n"
    "的面前，门口挂著两串灯笼(lantern),上面写得有字，像这样一\n"
    "间豪华的大宅院出现在这样的乡间野外，使你觉得有些突兀，大\n"
    "宅的南边、东边都是茂密的林子，看来也没有其他的路。\n"
  );
  set("item_desc", ([
    "lantern": "灯笼上几个娟秀的字迹写著：\n"
    BRED HIW "晚霞西照人影依稀 \n月影高挂和风婉约 \n" NOR
  ]));

  set("exits", ([
    //	"northeast" :	__DIR__"sroad4",
    "east": "/u/cloud/latemoon/hall",
    "enter": __DIR__ "front_yard",
  ]));

  /*
	create_door ("east", "拱门", "west", DOOR_CLOSED);
*/

  set("outdoors", "latemoon");

  setup();
}
