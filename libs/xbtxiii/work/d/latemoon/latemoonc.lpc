#pragma save_binary
inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ 1500, 3800, 0 }));
  set("short", "大厅后院");
  set("long",
    "这是晚月庄后的小小庭院，面积似乎不大，但花木扶疏，举目四\n"
    "望，竟种满了无数梅花，婉约娟秀，别有一番滋味。清风徐来，\n"
    "梅花特有的清香弥漫在风中.....\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "latemoon5",
    "west": __DIR__ "latemoon7",
    "east": __DIR__ "latemoon1",
    "south": __DIR__ "latemoon4"

  ]));

  setup();
}
