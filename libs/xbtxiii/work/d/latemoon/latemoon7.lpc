#pragma save_binary

#include <room.h>
inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ 1450, 3800, 0 }));
  set("short", "后院走道");
  set("long",
    "你走在一条长廊上，两旁都是庭台堂庑，廊上弥漫著一股香郁的\n"
    "气息，长廊向东西方延伸而去。东边是后厅院子，西边有一间书\n"
    "房。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "latemoon8",
    "east": __DIR__ "latemoonc",
    "west": __DIR__ "latebook",

  ]));

  create_door("south", "石门", "north", DOOR_CLOSED);
  setup();
}
