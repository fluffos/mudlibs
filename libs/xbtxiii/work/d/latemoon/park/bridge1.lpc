#pragma save_binary
inherit ROOM;

void create() {
  set("coor", ({ 1600, 3400, 0 }));
  set("short", "沁芳桥");
  set("long",
    "你走至大桥前，见水如晶帘一般奔入，扶著藤栏过去，只见水上落花愈多，其水愈清，溶溶\n"
    "荡荡，曲折萦纡，池边两行垂柳，杂著桃、杏，遮天蔽日般，真无一些尘土。度过桥去则通\n"
    "往湖心亭。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "moonc",
    "south": __DIR__ "pavilion1",

  ]));

  setup();
  replace_program(ROOM);
}
