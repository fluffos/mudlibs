#pragma save_binary

#include <ansi.h>
inherit ROOM;

void create()
{
        set("coor",({1610,3200,0}));
	set("short",HIC"密室门外"NOR);
        set("long",
"一扇小小的木门将密室与外界隔绝开来了.晚月庄的密室挺多的。每个密室都有它们的作用\n"
"不知道里面的这个密室是用来干什么的呢？不过现在的门好象被锁死了！\n"
);    
        set("exits", ([
    "north" :__DIR__"moondoor",
        ]));
        setup();
}

void init()
{ 
        object me,meishan,master,room;
        me=this_player();
	room=find_object("/d/latemoon/park/room2");
if(!room)
        {
        tell_object(me,HIM"一阵阵奇怪的声音从小屋里传来。。。。。。。。。。。。。。\n"
              "想偷听吗?(overhear)\n"NOR);
        me->set_temp("recycle_time",3); 
        set("long","一扇小小的木门将密室与外界阁开了。晚月庄的密室挺多的。每个密室都有它们的作用\n"
               "不知道里面的这个密室是用来干什么的呢\n");
        add_action("do_overhear","overhear");
        add_action("do_peek","peek");
        add_action("do_open","open"); 
        }
else
	{
        meishan=present("meishan",room);
        master=present("master dancer",room);	
        if(meishan&&master)
            {
            tell_object(me,HIM"一阵阵奇怪的声音从小屋里传来。。。。。。。。。。。。。。\n"
                "想偷听吗?(overhear)\n"NOR);
            me->set_temp("recycle_time",3); 
            set("long","一扇小小的木门将密室与外界阁开了。晚月庄的密室挺多的。每个密室都有它们的作用\n"
                "不知道里面的这个密室是用来干什么的呢\n");
            add_action("do_overhear","overhear");
            add_action("do_peek","peek");
            add_action("do_open","open"); 
            }
	}
	return ;
}

int do_overhear()
{
        object me;
        me=this_player();
        message_vision(HIM"$N忍不住好奇，偷偷的将耳朵凑近门口...\n"NOR,me);
        tell_object(me,YEL"屋里面隐隐约约的传来令人脸红的喘息声，细听之下，好象是两\n"
                 "个女人的声音.\n"
                 "一个声音呻吟道。。。。。。。。。\n"NOR);
        remove_action("do_overhear","overhear");
        call_out("message",2,me);
        return 1;
}

int message(object me)
{
        int time;
        if(!objectp(me)) return 0;
        time=me->query_temp("recycle_time");
if(time>0)
        {
        tell_object(me,HIM"庄主。。。。。不要。。。。。不要。。。。\n"NOR);
        me->add_temp("recycle_time",-1);
        me->set_explore("north#5");
        call_out("message",3,me);
        }
else
        {
        me->delete_temp("recycle_time");
        tell_object(me,HIM"\n庄主。。。不要。。不要停！！！\n\n"
                  "另外一个声音呻吟道：美珊。。。你。。你的皮肤好光滑啊。。!!!\n"NOR);
        tell_object(me,HIM"还想偷看吗?(peek)\n"NOR);  
		me->set_temp("peek",1);
        }
}

int do_peek()
{
        object me;
        me=this_player();
if(me->query_temp("peek"))
		{
        message_vision(HIM"看来$N偷听还不过瘾,只见$N趴在门逢上朝里面看去....\n\n"NOR,me);
        tell_object(me,YEL"里面除了几张凳子和一张床什么也没有。你朝床上仔细\n"
                 "看去，哇！！！床上的情景差点没有让你喷鼻血.床上赤裸裸\n"
                 "的躺着两个女人，其中一个正是晚月庄庄主---蓝芷萍.两个人\n"
                 "正在翻云覆雨.好不热闹.\n"NOR);
        message_vision(HIM"$N看的面色通红，口水不知不觉的流了出来.\n"NOR,me);
        tell_object(me,HIW"一股热气从小腹升了起来。。。。。。\n"NOR);
        message_vision(HIM"不知道怎么回事,$N的身体好象起了异样的变化...........\n"NOR,me);
        tell_object(me,"想开门进去吗?(open)\n");
        remove_action("do_peek","peek"); 
		me->delete_temp("peek");
		me->set_temp("open",1);
        return 1;                                
		}
else
		return 0;
}

int do_open(string arg)
{
        object me;
        me=this_player();
if(me->query_temp("open"))
		{
		if(arg=="door"||arg=="men") 
        	{
        	message_vision("$N悄悄的轻轻推了推门，门竟然没有关,被推开了.\n",me);       
	        set("exits",([
    	        "enter" :  __DIR__"room2", 
                "north" :  __DIR__"moondoor", 
        	]));
	        remove_action("do_open","open");
			me->delete_temp("open");
    	    }
		else
             tell_object(me,"你想打开什么?\n");
        return 1;
		}
else
		return 0;
        
}

int valid_leave(object me, string dir)
{
        me=this_player();
if(dir=="enter")
        {
        message_vision("$N顺手将门关轻轻的关上了。\n",me);       
        delete("exits");
        set("exits", ([
                  "north" :__DIR__"moondoor",
        ]));
        }
        return 1;

}
