#pragma save_binary
inherit ROOM;

void create() {
  set("coor", ({ 1550, 3400, 0 }));
  set("short", "甬路");
  set("long",
    "桂花园的石子甬道是以不同颜色的细石砌成各种图案。路面的图案组成，全员是一个整体。\n"
    "但每幅图案又有独立的内容，总计花石子路上约有二百幅。沿路观赏，美不胜收。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "southeast": __DIR__ "paroad2",
    "north": __DIR__ "moon5",
    "west": __DIR__ "moroom",

  ]));

  setup();
}
