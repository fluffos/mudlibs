#pragma save_binary

#include <ansi.h>
inherit ROOM;

void create()
{
        set("coor",({1610,3180,0}));
	set("short",HIC"小屋"NOR);
        set("long",
"一个朴素的小屋，环顾四周，只见里面摆了几张凳子.还有一张床.奇怪的是床好大，可以容\n"
"纳好几个人，不知道为什么这么一个小屋子会有这么一张大床。\n"
);    
        set("exits",([
            "out"    :  __DIR__"room1",
        ]));
        set("objects",([
               "/daemon/class/dancer/master"  : 1,
               "/daemon/class/dancer/meishan" : 1,
        ])); 
        setup();
}

void init()
{
        object me;
        me =this_player();
        call_out("clone_npc",1,me);
} 
 

void clone_npc(object me)
{
        object master,meishan;
        master=present("master dancer",this_object());
        meishan=present("meishan",this_object());
if(!meishan)
        {
        meishan=new("/daemon/class/dancer/meishan");
        meishan->move(this_object()); 
        }
if(!master)
        {
        master=new("/daemon/class/dancer/master");
        master->move(this_object());
        }
        master->set("i_am_in_room2",1);
        master->kill_player(me);
}

