#pragma save_binary

inherit ROOM;

void create() {
  set("coor", ({ 1600, 3700, 0 }));
  set("short", "前院");
  set("long",
    "你走到前院，你看到几块山石，东面一处假山小池。其上植有藤萝、青芷，异草芬芳荔薛。\n"
    "池中几尾小鱼自在的游来游去。假山外隔著围篱，有一种山怀中的小花园的感觉。.\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": "/d/latemoon/front_yard",
    "south": __DIR__ "flower2",

  ]));
  set("outdoors", "latemoon");

  setup();
  replace_program(ROOM);
}
