#pragma save_binary
inherit ROOM;

void create() {
  set("coor", ({ 1650, 3400, 0 }));
  set("short", "长廊曲洞");
  set("long",
    "你走入一长廊曲洞，里头略略的有几点山石，种著芭蕉，你可以听到潺潺的流水声，这里是\n"
    "园内假山开凿的通道，蜿蜒盘□，从洞口向外望去，是一碧清的水池。顺著曲径走去，转了\n"
    "两个弯子，看见一座石板桥。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "moonc",
    "southeast": __DIR__ "bridge3",

  ]));

  setup();
  replace_program(ROOM);
}
