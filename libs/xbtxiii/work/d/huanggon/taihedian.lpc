#pragma save_binary
inherit ROOM;

void create()
{
        set("coor",({0,3011,0}));
        set("short", "太和殿");
        set("long",
"这里是太和殿。是皇帝日常召见大臣，处理国务的地方！这儿代\n"
"表着至高无上的帝权！！从此向南是清和殿，往北是后宫！\n"
);

        set("outdoors", "huanggon");
        set("exits", ([
      "south" : "/d/huanggon/qihedian",
  
        ]));
        set("objects", ([
                "/d/secret/secret1/npc/king":1,
                "/d/secret/secret1/npc/eunuch":1,
        ]));

       set_temp("light",1);
       set("no_fight",1);
       set("no_magic",1);
        setup();
}

