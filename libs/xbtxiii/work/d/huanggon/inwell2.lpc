#pragma save_binary
inherit ROOM;

void create()
{
    set("short", "水底");
	set("long",
"这是水井的水中，你觉得坚持不住了，就快要窒息了\n"
);
set("objects",([
   __DIR__"obj/token":1,
]));
        set("exits", ([ 
    "up" : __DIR__"inwell",
]));
	setup();
}

int clean_up(){return 0;}
int reset()
{
    if(!random(6)) delete_temp("objects");
    ::reset();
}
