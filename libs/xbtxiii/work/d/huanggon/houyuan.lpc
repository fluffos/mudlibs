#pragma save_binary
inherit ROOM;

void create() {
  set("coor", ({ -20, 3010, 0 }));
  set("short", "清和殿后院");
  set("long",
    "这里是清和殿后院。院里种着些青菜。墙角有一口水井(well)。\n"
    "站在水井边往下看，只觉深不见底，井壁上满是滑溜溜的青苔。\n"
    "一个轱辘吊着一根长绳，绳端系着一个木桶。东边是一条走廊，\n"
    "通往清和殿。\n"
  );
  set("outdoors", "huanggon");
  set("resource/water", 1);
  set("exits", ([
    "east": "/d/huanggon/zoulang1",
  ]));

  setup();
}
