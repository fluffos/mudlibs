#pragma save_binary
// Room: /d/snow/jiulou_2f.c

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -100, 3100, 10 }));
  set("short", "太白酒楼二楼");
  set("long",
    "你走上了太白酒楼的二楼，酒楼的雅座便设于此。大凡有来头的\n"
    "客人都到此饮酒作乐。在此经常可以遇上一些达官贵族，一些为\n"
    "做官的富家子弟就来此打进阶的消息。墙边有一道楼梯通往一楼\n"
    "的茶座。\n"
  );
  set("exits", ([
    "down": __DIR__ "jiulou",
  ]));

  /*        set("objects", ([
                __DIR__"npc/waiter":       1,
                ]));
*/
  setup();
}
