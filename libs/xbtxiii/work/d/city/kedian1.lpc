#pragma save_binary

inherit ROOM;

void create() {
  set("coor", ({ 50, 2850, 0 }));
  set("short", "客店");
  set("long",
    "这是一家价钱低廉的客店，因为地方偏僻，房客很少。不时有打\n"
    "斗之声从东南边传来。掌柜早不知躲哪儿去了，屋里见不到一个\n"
    "人。南边是后院，通往各厢房。\n"
  );
  set("no_sleep_room", 1);


  set("exits", ([
    "south": __DIR__ "kedian2",
    "northwest": __DIR__ "alley3",
  ]));
  setup();
}
