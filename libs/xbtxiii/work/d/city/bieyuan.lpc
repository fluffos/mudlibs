inherit ROOM;

void create()
{
        add_light(this_object(),1);
	set("coor",({-100,3350,0}));
	set("short","雪山别院");
        set("long",
"这里是雪山寺的分部，当年贡唐仓大喇嘛不远万里进京面圣，被\n"
"封为国师，就在此处宣扬佛法。\n"
);


        set("exits",([
    "south" : "/d/city/street14",
        ]));

        set("objects" , ([
 CLASS_D("xueshan") + "/guoshi" : 1 ,
        ]));

        setup();

}

int valid_leave(object me, string dir)
{
	if ( me->query("id") == "seng bing" &&  dir == "south" ) return 0;

	return ::valid_leave(me, dir);
}
