#pragma save_binary
// Room: /city2/huichuntang.c

inherit ROOM;

void create()
{
	add_light(this_object(),1);
	set("coor",({-100,3000,0}));
	set("short", "回春堂药店");
	set("long",
"这是一家药铺，一股浓浓的药味让你几欲窒息，那是从药柜上的\n"
"几百个小抽屉里散发出来的。一位老者在柜台后站着。柜台上贴\n"
"着一张发黄的广告(guanggao)。柜台后面往西是一间内室(neish\n"
"i)。\n"
);
	set("item_desc", ([
		"guanggao" : "本店出售以下药品：
金创药：\t五十两白银
其他神药与老板面议。\n",
	]));

	set("objects", ([
        __DIR__"npc/huoji2" : 1,
        __DIR__"npc/xutianch" : 1,
	]));

	set("exits", ([
   "east" : __DIR__"street4",
	]));

	setup();
}

