#pragma save_binary
// nroad3.c
#include <room.h>

inherit ROOM;

void create()
{
        set("coor",({0,3700,0}));
	set("short", "北驿道");
        set("long",
"这里是条宽阔的大道。路旁杂草茂盛，足有半人多高，躲在里面\n"
"肯定不会有人发现。远处可见一个小村庄和周围的稻田。往南是\n"
"京师，东北通往天驼关。\n"
);

        set("exits", ([
                "northwest"      : __DIR__"nroad4",
		"south"	 	 : __DIR__"nroad2" ]) );

/*        set("objects", ([
                "/u/cp/chater2" : 1, ]) );*/
        set("outdoors", "city");
        setup();
        replace_program(ROOM);
}

