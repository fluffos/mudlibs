#pragma save_binary
inherit ROOM;

void create()
{
	set("coor",({50,2870,0}));
	set("short", "杨柳胡同");
	set("long",
"街道上一个人也看不到。你突然有点害怕起来。东南边有一家棺\n"
"材店。西南边是一条黑漆漆的小巷，你不知道要不要继续向里走。\n"
"“还是往北回去吧，免得。。。。。。”，心底里一个声音不住\n"
"地对你说。\n"
);
        set("outdoors", "city2");

	set("exits", ([
		"north" : __DIR__"alley1",
		"southwest" : __DIR__"alley3",
	]));

	setup();
	replace_program(ROOM);
}

