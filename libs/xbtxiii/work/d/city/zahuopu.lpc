#pragma save_binary
inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -100, 2900, 0 }));
  set("short", "杂货铺");
  set("long",
    "这是一家杂货铺，大箱小箱堆满了一地，都是一些日常用品。胡\n"
    "掌柜懒洋洋地躺在一只躺椅上，招呼着过往行人。据说私底下他\n"
    "也卖一些贵重的东西。摊上立着一块招牌(zhaopai)。\n"
  );

  set("item_desc", ([
    "zhaopai": "请用 \"list\" 列出货物表，\"buy\" 向老板购物。\n",
  ]));
  set("exits", ([
    "east": __DIR__ "newstreet3",
  ]));
  set("objects", ([
    __DIR__ "npc/hu": 1,
  ]));

  setup();
  replace_program(ROOM);
}
