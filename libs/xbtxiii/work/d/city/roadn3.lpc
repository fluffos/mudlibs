#pragma save_binary
#include <roadbusy.h>

inherit ROOM;

void create() {
  set("coor", ({ 3400, 1500, 0 }));
  set("short", "大驿道");
  set("long",
    "你走在一条尘土飞扬的大驿道上。四周人来人往。挑担子的、行\n"
    "商的、赶着大车的马夫、上京赶考的书生，熙熙攘攘，非常热闹。\n"
    "不时还有两三骑快马从身边飞驰而过，扬起一路尘埃。道路两旁\n"
    "是整整齐齐的杨树林。\n"
  );

  set("exits", ([
    "south": __DIR__ "roadn2",
    "north": __DIR__ "roadn4",
  ]));
  set("objects", ([
  ]));
  set("outdoors", "city");
  setup();
  //        replace_program(ROOM);
}
