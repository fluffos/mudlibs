#pragma save_binary
// Room: /city2/tiananmen.c

#include <room.h>

inherit ROOM;


void create()
{
	set("short", "天安门");
	set("long",
"这里就是天安门广场，灰色的城墙给人以庄严肃穆之感，再往北\n"
"就是皇宫了。皇宫正门前有座小桥，一条护城河绕城而过。越过\n"
"小桥向北望去，紫禁城的轮廓益发显得雄伟高大。一条笔直的大\n"
"道横贯东西，东边是东长安街，西边是西长安街。南边是一条繁\n"
"华的大道，从那往下有一座天桥，据说游人很多。\n"
);

	set("exits", ([
    "south" : "/d/city/nandaj1",
 "north" : "/d/city/bridge",
  "west" : "/d/city/xichang1",
    "east" : "/d/city/dongcha1",
	]));
	set("objects", ([
		"/d/city/npc/bing" : 2,
	]));
   set("outdoors", "city");
	setup();
	replace_program(ROOM);
}

