#pragma save_binary
// Room: /city/yihongyuan.c

inherit ROOM;

void create()
{
	add_light(this_object(),1);
	set("coor",({100,2850,0}));
	set("short", "怡红院");
	set("long",
"你一走进来，一眼就看到大厅的墙上挂着一幅幅春宫图(tu)，一\n"
"下子就明白了这是什么地方。厅内到处张灯结彩，香气扑鼻。几\n"
"名打扮得妖里妖气的女人分站两旁对你发出媚笑。一个老鸨婆连\n"
"忙上前招呼客人。从楼上传来了阵阵打情骂俏的声音。\n"
);

	set("objects", ([
                __DIR__"npc/laobaopo" : 1,
	]));

	set("item_desc", ([
		"tu" :
"                                      Ο        Ο          Ο             
                                    ┌│        │          │
      ┌—Ο┌—  —┬——Ο        │┤      ┌┘          └┐
    —┘Ο—┘    ————Ο  Ο——┘│  Ο—┼┴—  Ο——┴┼


   Ο       Ο    ΟΟΟ                 Ο                  ○
   │       │    │├┼       ┌—Ο  ┌┼                  │
   ├ Ο┬┐┤    ├└┼┐   —┘Ο——┘┤          ○┬—┐┤
   │   ┘└│    │  │                 └            │  ││
	\n"]));
	set("exits", ([
          "south" : __DIR__"street10",
//    "north" : __DIR__"library",
	]));

	setup();
}

void init()
{
    if(this_player())
        this_player()->set_explore("north#35");
}
