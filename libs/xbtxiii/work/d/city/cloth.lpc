#pragma save_binary
// cloth.c
#include <ansi.h>
#include <room.h>
inherit ROOM;

string look_sign(object me);

void create()
{
        add_light(this_object(),1);
	set("coor",({-100,3200,0}));
	set("short", "四喜绸缎庄");
        set("long",
"四喜绸缎庄是京师中的一家刚刚开业的专营衣帽的商店。店内顾\n"
"客稀少，显得店铺空荡荡的。柜台上凌乱地摊着几匹绸缎。绸缎\n"
"庄的老板出去进货了，只有老板娘空守店铺。据说这家店铺很有\n"
"来历。一般的地痞也很少到店中闹事。店堂上挂有一块崭新的招\n"
"牌(sign)。\n"
);
        set("exits", ([
                "east"   :  __DIR__"street6" ]) );

        set("objects", ([
              __DIR__"npc/clother.lpc" : 1, ]) );

        set("item_desc", ([
                "sign": (: look_sign :),]) );

        setup();

}

string look_sign(object me)
{
        return RED"匾上三个大字：闯名堂\n"NOR;
}

