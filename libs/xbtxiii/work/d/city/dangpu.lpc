#pragma save_binary
// Room: /city2/dangpu.c

inherit HOCKSHOP;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ 150, 3350, 0 }));
  set("short", "当铺");
  set("long",
    "这是一家以买卖公平著称的当铺，一个五尺高的柜台挡在你的面\n"
    "前，柜台上摆着一个牌子(paizi)，柜台后坐着贾老板，一双精\n"
    "明的眼睛上上下下打量着你。\n"
  );
  set("no_beg", 1);
  set("rich", 500000);

  set("item_desc", ([
    "paizi": "\n公平交易\n",
  ]));
  set("objects", ([
    __DIR__ "npc/jia": 1,
  ]));
  set("exits", ([
    "south": __DIR__ "newstreet2",
  ]));

  setup();
}
