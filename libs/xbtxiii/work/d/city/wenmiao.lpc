#pragma save_binary

#include <room.h>
inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ 150, 2850, 0 }));
  set("short", "文庙");
  set("long",
    "这里是文庙正殿，内有孔夫子像。历代皇帝都懂得利用儒教思想\n"
    "来巩固自己的江山社稷，当朝皇帝自然也不例外。不论何人到此，\n"
    "都毕恭毕敬地上香礼拜。\n"
  );

  set("no_fight", 1);
  set("no_steal", "1");
  set("no_sleep_room", "1");

  set("objects", ([
    //          "/d/city/obj/box" : 1,
    "/d/taishan/npc/shu-sheng": 1,
  ]));

  set("exits", ([
    "south": __DIR__ "newstreet6",
  ]));
  setup();
}
