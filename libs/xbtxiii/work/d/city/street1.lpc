#pragma save_binary
// Room: /d/city/street1.c

inherit ROOM;

void create() {
  set("coor", ({ 50, 3200, 0 }));
  set("short", "京师东街");
  set("long",
    "这里是京师东街的北段。往北走有一个大院子，院里立着根老高\n"
    "老高的旗杆，上书一个斗大的「镖」字，隔很远就可以看见。镖\n"
    "局的生意似乎很好，人络绎不绝。西向是庄严的神武门。向南则\n"
    "去向尚书府和午门。\n"
  );
  set("exits", ([
    "east": __DIR__ "kangqing/kang1",
    "north": __DIR__ "biaoju",
    "south": __DIR__ "street2",
    "west": __DIR__ "shenwumen",
  ]));

  set("outdoors", "city");

  setup();
}
