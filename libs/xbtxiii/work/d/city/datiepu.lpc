#pragma save_binary

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -150, 3350, 0 }));
  set("short", "打铁铺");
  set("long",
    "这是一家简陋的打铁铺，中心摆着一个火炉，炉火把四周照得一\n"
    "片通红，你一走进去就感到浑身火热。墙角堆满了已完工和未完\n"
    "工的菜刀、铁锤、铁棍、匕首、盔甲等物。一位铁匠满头大汗挥\n"
    "舞着铁锤，专心致志地在打铁。\n"
  );

  set("exits", ([
    "south": __DIR__ "newstreet1",
  ]));
  set("objects", ([
    __DIR__ "npc/blacksmith": 1, ]));

  setup();
}
