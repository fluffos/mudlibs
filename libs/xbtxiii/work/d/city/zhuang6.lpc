#pragma save_binary
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "庄府大厅");
  set("long",
    "这是一间灵堂。堂上供了七八个牌位.看来一座灵堂上供的是一\n"
    "家死人.一阵阴风吹过,蜡烛突然灭了.\n"
  );

  set("exits", ([
    "west": "/d/city/zhuang5",
  ]));
  set("objects", ([
  ]));
  set("outdoors", "city");
  setup();
  replace_program(ROOM);
}
