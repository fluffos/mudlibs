#pragma save_binary
// westdoor2.c
#include <room.h>

inherit ROOM;

string look_notice();

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -200, 2800, 0 }));
  set("short", "京师西二门");
  set("long",
    "你来到京师的西二门，西二门虽不如京师的其他几个城门高大。\n"
    "但高高的城墙也非一般人所能攀越，城墙上贴着几张布告(notic\n"
    "e)。西边是城外，一直往西就可到达西岳华山。东边就是京师的\n"
    "街道了。\n"
  );

  set("item_desc", ([
    "notice": (: look_notice :),
  ]));

  set("exits", ([
    "out": __DIR__ "yiroad1",
    "east": __DIR__ "newstreet5" ]));

  set("objects", ([
    __DIR__ "npc/guard": 3, ]));

  setup();
}

string look_notice() {
  return "布告上写著：行人出入需缴纳一两白银。\n";
}

int valid_leave(object me, string dir) {
  if (!userp(me)) return 1;
  if (wizardp(me)) return 1; return 1;
  if (me->query("mud_age") <= 86400) return 1;
  //新玩家就不必阻挡了
  if (dir == "out" &&
    (!(string)me->query_temp("marks/京师")
      && (string)me->query("family/family_name") != "朝廷"
      && objectp(present("city guard", environment(me)))
      && living(present("city guard", environment(me)))
      && !wizardp(me)
      && !(string)me->query_temp("marks/令牌"))) {
    tell_object(me, "京师守城兵说道：没有官府通令，不能随意出入京师。\n");
    return notify_fail("出城方向的路被京师守城兵挡住了。\n");
  }

  if (me->query_temp("marks/令牌") || (string)me->query("family/family_name") == "朝廷") {
    ::valid_leave(me, dir);
    me->delete_temp("marks/令牌", 0);
    return 1;
  }
  if (me->query_temp("marks/京师")) {
    me->delete_temp("marks/京师");
    return ::valid_leave(me, dir);
  }

  return ::valid_leave(me, dir);
}
