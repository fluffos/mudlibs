#pragma save_binary


inherit ROOM;

void create()
{
	set("short", "西长安街");
	set("long",
"这是一条宽阔的青石板街道，向东西两头延伸。往西望去，长长\n"
"的街道看不到头。东边就是天安门。一阵阵喝采声不时从北边的\n"
"戏院传来。南边就是京城最著名的‘回春堂’药店。\n"
);
   set("outdoors", "city1");

	set("exits", ([
  "east" : "/d/city/tian_anm",
    "south" : "/d/city/huichunt",
   "west" : "/d/city/xichang2",
 "north" : "/d/city/xiyuan",
	]));
	set("objects", ([
		"/d/city2/npc/flowerg": 1,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
me->delete_temp("warned");
me->delete_temp("hastryup");
return ::valid_leave(me, dir);
}
