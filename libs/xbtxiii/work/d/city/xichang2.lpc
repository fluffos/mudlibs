  );
  set("outdoors", "city2");

  set("exits", ([
    "east": __DIR__ "xichang1",
    "south": __DIR__ "alley1",
    "west": "/d/city/eastdoor2",
    "north": __DIR__ "xidan",
  ]));

  setup();
}
