#pragma save_binary
// /d/city/biaoju

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ 50, 3250, 0 }));
  set("my_point", "京城");
  set("short", "振远总局");
  set("long",
    "你来到了振远总局里。镖局虽然不大，但在京师这块土地上，已\n"
    "无人不知其名。尤其是其总镖头，俨然是以京城武林领袖自居。\n"
  );

  set("exits", ([
    "south": __DIR__ "street1",
  ]));

  set("objects", ([
    __DIR__ "npc/chen": 1,
    "d/biao/kehu": 1,
  ]));

  setup();
  set("valid_startroom", 1);
}
