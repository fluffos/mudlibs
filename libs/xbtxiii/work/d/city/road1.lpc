#pragma save_binary

inherit ROOM;

void create() {
  set("coor", ({ 0, 3500, 0 }));
  set("short", "大驿道");
  set("long",
    "你走在一条尘土飞扬的大驿道上。四周人来人往。挑担子的、行\n"
    "商的、赶着大车的马夫、上京赶考的书生，熙熙攘攘，非常热闹。\n"
    "不时还有两三骑快马从身边飞驰而过，扬起一路尘埃。道路两旁\n"
    "是整整齐齐的杨树林。西边就是京城东门。东北方是一条小路。\n"
    "再住东就向海港去了.\n"
  );

  set("exits", ([
    //       "enter" : __DIR__"eastdoor1",
    "east": __DIR__ "road10",
    "northeast": __DIR__ "zhuang1",
  ]));

  set("objects", ([
    "/d/taishan/npc/tiao-fu": 1,
  ]));

  set("outdoors", "city2");
  setup();
}
