#pragma save_binary

inherit ROOM;

void create() {
  set("coor", ({ 4450, -800, 0 }));
  set("short", "大驿道");
  set("long",
    "你走在一条尘土飞扬的大驿道上。北上就是北京城。挑担子的、\n"
    "行商的、赶着大车的马夫、上京赶考的书生，熙熙攘攘，非常热\n"
    "闹。不时还有两三骑快马从身边飞驰而过，扬起一路尘埃。西边\n"
    "有个小摊，许多人在那里歇息。\n"
  );

  set("exits", ([
    "north": __DIR__ "road4",
    "south": __DIR__ "road9",
    "west": __DIR__ "xiaotan"
  ]));

  set("outdoors", "city2");
  setup();
}
