#pragma save_binary

#include <room.h>
inherit ROOM;

void create() {
  set("coor", ({ 130, 3120, -10 }));
  set("short", "东厂暗道");
  set("long", @LONG
这是一条暗道，是专为鳌拜从鳌府直接到东厂用的。
南边是一扇木门(door)。
LONG
  );

  set("exits", ([
    "southup": __DIR__ "aobai6",
    "northeast": __DIR__ "aobai11",
  ]));
  set("item_desc", ([
    "door": "这是一扇极厚的木门。\n",
  ]));

  create_door("southup", "木门", "northdown", DOOR_CLOSED);
  setup();
}
