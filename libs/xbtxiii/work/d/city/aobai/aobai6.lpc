  set("coor", ({ 130, 3100, 0 }));
  set("short", "鳌拜卧房");
  set("long", @LONG
	这是鳌拜的卧房。鳌拜躺在床上睡着了，粗声粗气地打着呼噜。
北边有一扇门(door)。
LONG
  );

  set("exits", ([
    "west": __DIR__ "aobai4",
