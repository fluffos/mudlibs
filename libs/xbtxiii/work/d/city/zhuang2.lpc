#pragma save_binary

inherit ROOM;

void create() {
  set("coor", ({ 50, 4050, 0 }));
  set("short", "小路");
  set("long",
    "你走在一条小路上。前面道路崎岖，行人很少。前方隐约有房屋\n"
    "可见.\n"
  );

  set("exits", ([
    "south": __DIR__ "zhuang1",
    //        "north" : __DIR__"zhuang3",
  ]));
  set("objects", ([
    "/d/wudang/npc/tufei1": 1,
  ]));

  set("outdoors", "city2");
  setup();
  replace_program(ROOM);
}
