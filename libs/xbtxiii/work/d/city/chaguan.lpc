#pragma save_binary
// Room: /city2/chaguan.c

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -100, 2850, 0 }));
  set("short", "高升茶馆");
  set("long",
    "你一走进来，就闻到一股茶香沁入心脾，精神为之一爽。几张八\n"
    "仙桌一字排开，坐满了客人，或高声谈笑，或交头接耳。你要想\n"
    "打听江湖掌故和谣言，这里是个好所在。\n"
  );
  set("resource/water", 1);

  set("exits", ([
    "south": __DIR__ "street13",
  ]));

  set("objects", ([
    __DIR__ "npc/guanfuzi": 1,
  ]));

  setup();
}
