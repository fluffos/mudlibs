// jiulou.c
//update by alvins on 07-06-99

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -100, 3100, 0 }));
  set("short", "太白酒楼");
  set("long",
    "你走到了一家大酒楼里。四周的装饰金壁辉煌，令人眼花缭乱，\n"
    "连餐具的做工也极讲究，不愧是京城的第一大酒楼。酒楼的菜肴\n"
    "是远近闻名的，在这经常可以看到一些达官贵族，据连当今皇上\n"
    "也曾微服来此以一饱口福。\n"
  );

  set("exits", ([
    "east": __DIR__ "street5",
    "up": __DIR__ "jiulou_2",
  ]));

  set("objects", ([
    //                 __DIR__"npc/waiter" :   1,
    __DIR__ "npc/hai": 1,
    __DIR__ "npc/xiaoguiz": 1,
    __DIR__ "npc/boss": 1,
  ]));
  set_temp("light", 1);
  setup();
}
