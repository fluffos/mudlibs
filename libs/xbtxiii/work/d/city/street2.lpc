#pragma save_binary
// Room: /d/city/street2.c

inherit ROOM;

void create()
{
        set("coor",({50,3100,0}));
	set("short", "京师东街");
        set("long",
"你走在京师东街的中段。这里夹在紫禁城城墙与尚书府院墙之间，\n"
"南向的道路通向午门和尚书府的大门，而北方不远处振远总局的\n"
"旗杆依稀可见，令人隐隐约约地感到一种杀气。\n"
);

	set("objects", ([
		__DIR__"npc/walker":	2,
		]) );

        set("exits", ([ 
        "east":    __DIR__"aobai/aobai2",
		"north":	__DIR__"street1",
		"south":	__DIR__"street3",
		]));

        set("outdoors", "city");

        setup();
        replace_program(ROOM);
}

