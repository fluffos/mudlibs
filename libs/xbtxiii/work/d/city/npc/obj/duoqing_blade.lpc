// wuqing_blade.lpc"
#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create() {
  set_name(HIW "无情刀" NOR, ({ "cool blade", "blade" }));
  set_weight(4500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "刀锋寒气逼人，发出异样的青光。\n");
    set("value", 24000);
    set("material", "异类金属");
    set("wield_msg", "$N「唰」地一声抽出一把寒气逼人的$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插入腰间的刀鞘。\n");
  }
  init_blade(45);
  setup();
}
