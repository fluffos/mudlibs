//huangbiaoma.c 黄骠马

#include <command.h>
#include <dbase.h>
#include <origin.h>
#include <ansi.h>

inherit NPC;

void create() {
  set_name(HIY "黄骠马" NOR, ({ "huang biao  ma", "ma" }));
  set("long", "一匹骏马，全身黄色，无一根杂毛。\n");
  set("race", "野兽");
  set("age", 5);
  set("attitude", "heroism");
  set("str", 30);
  set("dex", 35);
  set("con", 30);
  set("int", 18);
  set("shen", 1);
  set("combat_exp", 1000);
  setup();
}
