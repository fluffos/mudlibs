// weaponor.c
inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("万晓生", ({ "weaponor" }));
  set("title", "武器店掌柜");
  set("gender", "男性");
  set("age", 52);
  set("long", "万晓生是个须发皆白的老人，闯荡江湖已近五十年。\n");
  set("combat_exp", 120000);
  set("attitude", "friendly");
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("sword", 100);

  set("inquiry", ([
    "武器": "本店专卖各种长短兵器",
  ]));
  set("where", "city");
  set("vendor_goods", ([
    __DIR__ "obj/armor1": 6,
    __DIR__ "obj/rain_whip": 4,
    __DIR__ "obj/wuqing_sword": 8,
    __DIR__ "obj/duoqing_blade": 9,
    __DIR__ "obj/demon_staff": 3,
    "/obj/weapon/shield": 20,
    "/obj/weapon/sixhammer": 12,
    "/obj/weapon/thin_sword": 12,
    "/obj/weapon/dagger": 20,
    "/obj/weapon/spear/biyuqiang": 5,
    "/obj/weapon/spear/changqiang": 5,
    "/obj/weapon/spear/gangqiang": 25,
    "/obj/weapon/spear/jinqiang": 1,
    "/obj/weapon/spear/muqiang": 25,
    "/obj/weapon/spear/tieqiang": 25,
    "/obj/weapon/spear/tiespear": 10,
    "/obj/treasure/spear": 1,
  ]));

  setup();
  add_money("silver", 50);
  add_money("coin", 300);
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wield();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");


}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(4)) {
    case 0:
      say("万晓生道：这位"
        +RANK_D->query_respect(ob)
        + "，自个儿挑一件称手的兵器吧。\n");
      break;
    case 1:
      say("万晓生冷冷地说：客官请付现钞。\n");
      break;
    case 2:
      say("i..............\n");
      break;
  }
}
