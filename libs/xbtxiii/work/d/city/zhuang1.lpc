#pragma save_binary

inherit ROOM;

void create()
{
	set("coor",({50,4000,0}));
	set("short", "小路");
	set("long",
"你走在一条小路上。前面道路崎岖，行人很少。\n"
);

	set("exits", ([
 "southwest" : "/d/city/road1",
		"north" : __DIR__"zhuang2",
	]));
	set("objects", ([
		"/d/taishan/npc/seng-ren" : 1,
	]));

 	set("outdoors", "city2");
	setup();
	replace_program(ROOM);
}



