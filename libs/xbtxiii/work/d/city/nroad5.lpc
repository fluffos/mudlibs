#pragma save_binary
// nroad5.c
#include <room.h>
#include <roadbusy.h>

inherit ROOM;

void create() {
  set("coor", ({ -200, 3900, 0 }));
  set("short", "黄土大道");
  set("long",
    "你正走在一条黄土大道上。路上尘土飞扬，路旁稀疏几棵矮树。\n"
    "往南通往京师，东北是通往天驼关的大道。\n"
  );

  set("exits", ([
    "northwest": "/d/village/road2",
    "southeast": __DIR__ "nroad4" ]));

  /*        set("objects", ([
                "/u/cp/chater2" : 1, ]) );*/
  set("outdoors", "city");
  setup();
  //        replace_program(ROOM);
}
