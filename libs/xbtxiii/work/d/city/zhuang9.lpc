#pragma save_binary
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "小房间");
  set("long",
    "这是一个小房间,桌上点着蜡烛.房中只有一桌一床,陈设简单,却\n"
    "十分干净.床上铺着被褥.\n"
  );

  set("exits", ([
    "south": "/d/city/zhuang8",
  ]));
  set("objects", ([
    "/d/city/npc/shuanger": 1,
    "/d/city/npc/furen": 1,
  ]));
  set("outdoors", "city");
  setup();
}
