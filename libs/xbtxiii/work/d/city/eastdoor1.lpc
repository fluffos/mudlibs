#pragma save_binary
// eastdoor1.c
#include <room.h>

inherit ROOM;

string look_notice();

void create() {
  add_light(this_object(), 1);
  set("coor", ({ 200, 3300, 0 }));
  set("short", "京师东一门");
  set("long",
    "你来到京师的东一门。城门口十来个手持刀枪的士兵正在检查过\n"
    "往的行人。经常有一些富丽堂皇的大车缓缓驶入城来，那是京师\n"
    "的官宦人家出游归来。城墙上有一张陈旧的布告(notice)。东边\n"
    "是城外，风景如画。西边是京师的街道。\n"
  );

  set("item_desc", ([
    "notice": (: look_notice :),
  ]));

  set("exits", ([
    "west": "/d/city/newstreet2",
    //    "east": "/d/city2/xisi2",
    //      "out"   : "/d/city/road1",
  ]));

  set("objects", ([
    __DIR__ "npc/guard": 3, ]));

  setup();
}

string look_notice() {
  return "布告经风吹日晒，字迹已经不可分辨了。\n";
}
