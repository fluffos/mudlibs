#pragma save_binary
// nroad2.c
#include <room.h>
#include <roadbusy.h>

inherit ROOM;

void create() {
  set("coor", ({ 0, 3600, 0 }));
  set("short", "北驿道");
  set("long",
    "这是一条青石铺地的大驿道，地处京师的北郊。北方入京必经此\n"
    "地。往南走就可以到京师了。东北是连绵的群山。\n"
  );

  set("exits", ([
    "south": __DIR__ "nroad1",
    "north": __DIR__ "nroad3" ]));

  set("objects", ([
  ]));
  set("outdoors", "city");
  setup();
  //        replace_program(ROOM);
}
