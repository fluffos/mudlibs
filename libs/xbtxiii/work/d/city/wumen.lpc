#pragma save_binary
// /d/city/wumen
#include <room.h>

inherit ROOM;

void create() {
  set("coor", ({ 0, 2900, 0 }));
  set("short", "午门");
  set("long",
    "这里是京师的午门。午门进出紫禁城的要道，北面那庄严的大门\n"
    "(gate)后面便是神秘的紫禁城。大门的两侧放着一对石狮(statu\n"
    "e)，虎视眈眈地盯着来往的人群。南面是历年选武状元的校武场，\n"
    "也不知现在有没有人。东西向的街道围绕着紫禁城。\n"
  );

  set("exits", ([
    "east": __DIR__ "newstreet4",
    "west": __DIR__ "newstreet3",
    "south": __DIR__ "jiaowu",
    "north": __DIR__ "bridge1",
  ]));
  set("outdoors", "city");

  //	create_door("north", "铁门", "south", DOOR_CLOSED);

  setup();
}
