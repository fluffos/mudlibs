#pragma save_binary

inherit ROOM;

void create() {
  set("coor", ({ 60, 2840, 0 }));
  set("short", "东客房");
  set("long",
    "一进门，只见六个喇嘛手持戒刀，围着一白衣女尼拼命砍杀，只\n"
    "是给白衣女尼的袖力掌风逼住了，欺不近身。但那白衣女子头顶\n"
    "已冒出丝丝白气，显然已尽了全力。她只一条臂膀，再支持下去\n"
    "恐怕难以抵敌。地上斑斑点点都是血迹。\n"
  );

  set("exits", ([
    "west": __DIR__ "kedian2",
  ]));
  set("objects", ([
    "/d/city2/npc/dubi": 1,
    "/d/city2/npc/lama": 6,
  ]));

  setup();
}
