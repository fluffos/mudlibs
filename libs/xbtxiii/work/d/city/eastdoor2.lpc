#pragma save_binary
// eastdoor2.c
#include <room.h>

inherit ROOM;

string look_notice();

void create()
{
        add_light(this_object(),1);
	set("coor",({200,2800,0}));
	set("short", "京师东二门");
        set("long",
"这里是京师的东二门。城门上插着几面旗帜，标志了本门的守城\n"
"将领。城楼里坐着几个将军打扮的人，城墙上有一张刚刚粘贴上\n"
"去的布告(notice)，一群人正围着观看。东边是城外，西边是京\n"
"师的街道。\n"
);

        set("item_desc", ([
                "notice": (: look_notice :),
        ]) );

        set("exits", ([
           "out" : __DIR__"road5",
 "west"          : __DIR__"newstreet6" ]) );

        set("objects", ([
                __DIR__"npc/guard" : 3 ,]) );  

        setup();
}

string look_notice()
{
     return "布告上写著：辑拿要犯----於兰天武。\n";
}
int valid_leave(object me,string dir)
{                                       

        if (!userp(me))
        return 1;
        if (me->query("mud_age")<=86400) return 1;
        if ( dir=="out" &&
                ( !(string) me->query_temp("marks/京师")
                && (string) me->query("family/family_name")!="朝廷"
                && !wizardp(me)
                && objectp(present("city guard", environment(me))) 
                && living(present("city guard", environment(me))) 
                && !(string) me->query_temp("marks/令牌") ) ) {
                tell_object (me, "京师守城兵说道：没有官府通令，任何人不能出入京师。\n");
                return notify_fail("出城方向的路被京师守城兵挡住了。\n");
                }

        if (me->query_temp("marks/令牌")||(string) me->query("family/family_name")=="朝廷") {
                ::valid_leave(me,dir);
                me->delete_temp("marks/令牌");
                return 1;
                }
        if (me->query_temp("marks/京师")) {
                me->delete_temp("marks/京师", 0);
                return ::valid_leave(me,dir);
                }

        return ::valid_leave(me,dir);

}            

