#pragma save_binary
  // Room: /d/city/newstreet4.c

inherit ROOM;

void do_climb (string arg);

void create()
{
 set("coor",({50,2900,0}));
	set("short", "京师东街");
        set("long",
"这是京师东街的南段。东街都被掌管天下官印的尚书府占了一大\n"
"片据了，东边便是将军府的大门，北边则是尚书府高耸的围墙(w\n"
"all)，北去的道路一直通向振远总局。\n"
);
        set("exits", ([ 
          "east":     "/d/chaoting/jjf/jjf_0",
		"west":		__DIR__"wumen",
          "north":    __DIR__"street3",
  "south":    __DIR__"alley1",
		]));

	set("item_desc", ([
		"wall": (: "一段高高的院墙，但对轻功好的人爬上(climb)似非难事。\n" :),
		]) );

        set("outdoors", "city");

        setup();
}

void init ()
{
	add_action ("do_climb", "climb");
}

void do_climb (string arg)
{
	if ((arg == "wall") || (arg == "up") || (arg == "墙")) 
		this_player()->move(__DIR__"wall");
}
	
