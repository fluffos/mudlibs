#pragma save_binary
// southdoor.c
//change by alvins 
// 06-29-99
#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
        add_light(this_object(),1);
	set("coor",({0,2700,0}));
	set("short", "京师南门");
        set("long",
"这是京师的南门。高大的城门正上“京师南门”几个大字格外显\n"
"眼。城墙上贴着几张官家布告(notice)。西北方是京师的监狱，\n"
"关押着一些要犯，因此这里的官兵们也戒备森严。南边是城外，\n"
"不时走来几个赴京赶考的举子。北边就是京师，一个灯红酒绿的\n"
"地方。\n"
);

        set("item_desc", ([
                "sign": (: look_sign :),
                "door": (: look_door, "out" :), 
 ]) );

        set("exits", ([
                "north"            : __DIR__"street17",
                "out"          : "/d/jiangnan/sroad1" ]) );

        set("objects", ([
              __DIR__"npc/shisong":1,
                __DIR__"npc/guard" : 3, ]) );

        create_door("out", "城门", "enter");
        setup();
}

string look_sign(object me)
{
        me->set_explore("north#33");
       if( wizardp(me) )
                return "告示上写著：捉拿灵儿、阿泰。\n";
        else
                return "告示上隐约写著几个人名，但都模糊不可分辨了。\n";
}

int valid_leave(object me,string dir)
{                                       

        if (!userp(me))
        return 1;
       if (wizardp(me));        return 1;
        if (me->query("mud_age")<=86400) return 1;
        if ( dir=="out" &&
                ( !(string) me->query_temp("marks/京师")
                && (string) me->query("family/family_name")!="朝廷"
                && objectp(present("city guard", environment(me))) 
                && living(present("city guard", environment(me))) 
                && !(string) me->query_temp("marks/令牌") ) ) {
                tell_object (me,            "京师守城兵说道：没有官府通令，任何人不能出入京师。\n");
                 return notify_fail("出城方向的路被京师守城兵挡住了。\n");
                }
        if (me->query_temp("marks/令牌")||(string) me->query("family/family_name")=="朝廷"||wizardp(me)) {
                ::valid_leave(me,dir);
                me->delete_temp("marks/令牌");
                return 1;
                }
        if (me->query_temp("marks/京师")) {
                me->delete_temp("marks/京师", 0);
                return ::valid_leave(me,dir);
                }

        return ::valid_leave(me,dir);

}    
