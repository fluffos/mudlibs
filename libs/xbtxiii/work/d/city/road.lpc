#pragma save_binary

inherit ROOM;

void create()
{
	set("short", "大驿道");
	set("long",
"你走在一条尘土飞扬的大驿道上。四周人来人往。挑担子的、行\n"
"商的、赶着大车的马夫、上京赶考的书生，熙熙攘攘，非常热闹。\n"
"不时还有两三骑快马从身边飞驰而过，扬起一路尘埃。道路两旁\n"
"是整整齐齐的杨树林。从这里远远的就可以望见北京城。\n"
);

	set("exits", ([
		"northwest" : "/d/city2/road5",
		"southeast" : __DIR__"road7",
	]));
 	set("outdoors", "city2");
	setup();
	replace_program(ROOM);
}



