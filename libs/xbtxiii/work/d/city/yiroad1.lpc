#pragma save_binary

inherit ROOM;

void create() {
  set("coor", ({ -300, 2800, 0 }));
  set("short", "大驿道");
  set("long",
    "你走在一条尘土飞扬的大驿道上。四周人来人往。挑担子的、行\n"
    "商的、赶着大车的马夫、上京赶考的书生，熙熙攘攘，非常热闹。\n"
    "不时还有两三骑快马从身边飞驰而过，扬起一路尘埃。道路两旁\n"
    "是整整齐齐的杨树林。从东面就是京城。西南边通往华山。\n"
  );

  set("exits", ([
    "enter": __DIR__ "westdoor2",
    "west": __DIR__ "yiroad2",
  ]));

  set("objects", ([
  ]));

  set("outdoors", "city");
  setup();
}



int valid_leave(object me, string dir) {
  object ob;
  object *inv;
  int i;
  if (dir == "enter" && ob = present("soldier", this_object())) {
    if (ob->query("leader") == me->query("name") &&
      me->query("rank") == 1) return 1;
    else {
      inv = all_inventory(me);
      for (i = 0; i < sizeof(inv); i++) {
        if (((inv[i]->query("targetid")) == me->query("id"))
          && ((string)(inv[i]->query("id")) == "token"))
          return 1;
      }
      return notify_fail(ob->name() + "向你嚷道：奉" +
        ob->query("leader") + "之命封锁此路!没有通行证不得通过!\n");
    }
  } else return 1;
}
