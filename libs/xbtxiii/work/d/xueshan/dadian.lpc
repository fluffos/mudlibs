inherit ROOM;

void create() {
  add_light(this_object(), 1);
  add_light(this_object(), 1);
  set("coor", ({ -3600, -900, 200 }));
  set("short", "大殿");
  set("long",
    "这里是雪山寺的大殿，中央供奉着佛祖塑像。僧人们在念着经文。\n"
    "远来的香客们在这里虔诚地膜拜。大殿两侧都是侧殿。\n"
  );

  set("exits", ([
    "east": __DIR__ "cedian1",
    "west": __DIR__ "cedian2",
    "south": __DIR__ "guangchang",
  ]));
  set("objects", ([
    "/d/xueshan/npc/lazhang": 1,
    __DIR__ "npc/xiang-ke": 2,
  ]));

  set("valid_startroom", 1);

  setup();

  call_other("/obj/board/xueshan_b", "???");
}
int clean_up() { return 0; }
