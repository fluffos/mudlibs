#pragma save_binary
//      dating.c 大厅
//      Designed by secret (秘密)
//      97/04/09

inherit ROOM;

void create()
{
        add_light(this_object(),1);
	set("coor",({-3600,-900,210}));
	set("short","大厅");
        set("long",
"这里是寺内的大厅，几位有道的高僧在高声辩论。\n"
);

        set("exits",([
                "east" : __DIR__"zoulang1",
                "west" : __DIR__"zoulang2",
                "northeast" : __DIR__"chanshi",
                "northwest" : __DIR__"cangjingge",
        ]));
set("objects", ([
"/d/xueshan/npc/fawang":1,
]));

        setup();
        replace_program(ROOM);
}

