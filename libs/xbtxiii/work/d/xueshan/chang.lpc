inherit ROOM;

void create() {
  set("coor", ({ -3700, -950, 200 }));
  set("short", "练武场");
  set("long",
    "这里是雪山寺练武场，僧人门在此习武。\n"
  );

  set("outdoors", "xueshan");

  set("exits", ([
    "east": __DIR__ "guangchang",
    "west": __DIR__ "kufang",
    "north": __DIR__ "houyuan",
  ]));
  set("objects", ([
    "/d/xueshan/npc/gelunbu": 1,
    __DIR__ "npc/x_lama": 1,
  ]));

  setup();
  replace_program(ROOM);
}
