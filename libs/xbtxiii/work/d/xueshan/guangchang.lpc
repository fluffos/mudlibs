#pragma save_binary
//      guangchang.c 广场
//      Designed by secret (秘密)
//      97/04/09

inherit ROOM;

void create() {
  set("coor", ({ -3600, -950, 200 }));
  set("short", "广场");
  set("long",
    "这里是雪山寺内的广场。广场的北面就是依山而建的雪山寺大殿。\n"
    "寺内有一些手持僧棍的僧兵在巡逻。\n"
  );

  set("outdoors", "xueshan");

  set("exits", ([
    "south": __DIR__ "shanmen",
    "east": __DIR__ "xiaoyuan",
    "west": __DIR__ "chang",
    "north": __DIR__ "dadian",
  ]));

  set("objects", ([
    __DIR__ "npc/seng-bing1": 2,
  ]));

  setup();

}

int valid_leave(object me, string dir) {
  if (me->query("id") == "seng bing" && dir == "south") return 0;

  return ::valid_leave(me, dir);
}
