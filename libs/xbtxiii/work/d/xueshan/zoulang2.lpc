inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -3610, -900, 210 }));
  set("short", "走廊");
  set("long",
    "这里是雪山寺内的走廊。\n"
  );

  set("exits", ([
    "down": __DIR__ "cedian2",
    "east": __DIR__ "dating",
    "eastup": __DIR__ "zoulang3",
  ]));

  setup();
}
