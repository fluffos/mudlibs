inherit ROOM;


void create() {
  set("coor", ({ -3720, -950, 200 }));
  set("short", "库房");
  set("long",
    "这里是练武场旁边的小库房，房中有些备用的武器。\n"
  );

  set("exits", ([
    "east": __DIR__ "chang",
  ]));

  set("objects", ([
    "/d/village/obj/zhujian": random(3),
    "/d/xueshan/obj/mugun": random(3),
    "/d/xueshan/obj/falun": random(3),
    "/d/xueshan/obj/mu-chu": random(3),
    "/d/xueshan/obj/chu": 1,
  ]));


  setup();
}
