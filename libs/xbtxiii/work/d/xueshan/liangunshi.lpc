#pragma save_binary
//ROOM lianjianshi.c
inherit ROOM;

void create()
{
        set("coor",({-3800,-700,0}));
	set("short", "棍窠");
        set("long",
"这里是玄兵古洞造棍的地方。周围整齐的堆放着造棍用的原料，\n"
"一个年轻小伙手里拿着一本玄天棍法，正在仔细的研读着。看到\n"
"你走了过来，连忙放下手中的书，带着一脸纯真冲你憨憨的一笑，\n"
"脸不由又红了。\n"
);
        set("exits", ([
                "east" : "/d/secret/secret1/shenghu",
        ]));

  set("objects",(["/d/xueshan/npc/shigun" : 1,]));

        setup();
	replace_program(ROOM);
}
