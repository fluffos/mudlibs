inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -3590, -900, 210 }));
  set("short", "走廊");
  set("long",
    "这里是雪山寺内的走廊。\n"
  );

  set("exits", ([
    "down": __DIR__ "cedian1",
    "west": __DIR__ "dating",
    "westup": __DIR__ "zoulang3",
  ]));

  setup();
  replace_program(ROOM);
}
