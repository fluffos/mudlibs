#pragma save_binary
//      chufang.c 厨房
//      Designed by secret (秘密)
//      97/04/09

inherit ROOM;

void init();
int work();

void create()
{
        set("coor",({-3590,-930,200}));
	set("short","厨房");
        set("long",
"这里是雪山寺的厨房，新来的僧人可以在此打杂。房中醒目的位\n"
"置有一块牌子（paizi）。\n"
);

        set("item_desc",([
                "paizi" : "本厨房招收杂工。工作(work)一次付纹银一两。\n",
        ]));
        set("no_fight",1);
        set("no_steal",1);
        set("exits",([
                "south" : __DIR__"xiaoyuan",
        ]));


        setup();

}

void init()
{
	add_action("do_work","work");
}

int do_work()
{
	object me=this_player();
        object ob;

   if (me->query_temp("times")>50)
        return notify_fail("今天的活干完了，明天再来吧！\n");
 if(me->query("sen")<20)
   return notify_fail("你的神太虚弱，不能工作\n");
    me->add("sen",-20);
	message_vision("$N干了一些杂活，累得够呛。\n" , me);
    me->add_temp("times",1);

        ob=new("/obj/money/silver");
        ob->set_amount(1);
        ob->move(me);
	return 1;
}
