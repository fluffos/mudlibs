#pragma save_binary
//      zoulang3.c 走廊
//      Designed by secret (秘密)
//      97/04/09

inherit ROOM;

void create()
{
        add_light(this_object(),1);
	set("coor",({-3600,-900,220}));
	set("short","走廊");
        set("long",
"这里是雪山寺内的走廊。\n"
);

        set("exits",([
                "north" : __DIR__"neidian",
                "eastdown" : __DIR__"zoulang1",
                "westdown" : __DIR__"zoulang2",
        ]));

        setup();
        replace_program(ROOM);
}

