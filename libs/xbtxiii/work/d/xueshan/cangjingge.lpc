#pragma save_binary
//
// cangjingge.c 雪山藏经室
// by secret

inherit ROOM;

string *books = ({
  "/d/xueshan/obj/skin",
  "/d/xueshan/obj/jing",
  "/d/shaolin/obj/book-bamboo",
  "/d/shaolin/obj/book-silk",
  "/d/shaolin/obj/book-stone",
  "/d/shaolin/obj/book-iron",
});

void create() {
  set("coor", ({ -3610, -890, 210 }));
  set("short", "雪山藏经室");
  set("long",
    "这里是雪山寺的藏经室，靠墙是一排书架，摆满了各种拳谱、书\n"
    "籍。大多是当年掌门人鸠摩智翻译的佛经和从少林寺取来的武学\n"
    "典籍。\n"
  );

  set("exits", ([
    "southeast": __DIR__ "dating",
  ]));

  set("objects", ([
    books[random(sizeof(books))]: 1,
    books[random(sizeof(books))]: 1,
    books[random(sizeof(books))]: 1,
    "/d/xueshan/npc/daerba": 1,
  ]));

  setup();
  //    replace_program(ROOM);
}

int valid_leave(object me, string dir) {
  object ob;

  if (present("daerba huofo", environment(me)))
    if (present("skin", me)
      || objectp(ob = present("corpse", me)) && present("skin", ob)) {
      if (dir == "southeast") {
        return notify_fail("达而巴说道: 武功秘籍只许在藏经室内研习，不得携带外出 !\n");
      }
    }
  return ::valid_leave(me, dir);
}
