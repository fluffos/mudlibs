inherit ROOM;

void create() {
  set("coor", ({ -3590, -890, 220 }));
  set("short", "天台");
  set("long",
    "这里是雪山寺的高处。北边可见雄伟的大雪山，南边可以俯瞰美\n"
    "丽如镜的圣湖。\n"
  );

  set("exits", ([
    "west": __DIR__ "neidian",
  ]));

  setup();
  replace_program(ROOM);
}
