inherit ROOM;

void create()
{
        set("coor",({-3550,-850,0}));
	set("short","湖边小路");
        set("long",
"这是圣湖边的小路。\n"
);

        set("outdoors","xueshan");

        set("exits",([
                "south" : __DIR__"shanjiao",
                "north" : __DIR__"hubian3",
        ]));

        setup();
        replace_program(ROOM);
}
