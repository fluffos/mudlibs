inherit ROOM;

void create()
{
        set("coor",({-3550,-970,50}));
	set("short","山路");
        set("long",
"这是一条上山的小路。\n"
);

        set("outdoors","xueshan");

        set("exits",([
                "westup" : __DIR__"shanlu2",
                "northdown" : __DIR__"shanjiao",
        ]));

        setup();
        replace_program(ROOM);
}
