inherit ROOM;

void create()
{
        add_light(this_object(),1);
	set("coor",({-3600,-890,220}));
	set("short","内殿");
        set("long",
"这里是雪山寺的内殿，也是掌门人见客的地方。\n"
);

        set("exits",([
                "east" : __DIR__"tiantai",
                "west" : __DIR__"midao",
                "south" : __DIR__"zoulang3",
        ]));
      set("objects",([
"/d/xueshan/npc/jiumozhi":1
      ]));

        setup();
        replace_program(ROOM);
}

