inherit ROOM;

void create() {
  set("coor", ({ -3750, -500, 0 }));
  set("short", "客店");
  set("long",
    "这里是一个路边的小客店。来往的行人都在这里稍事休息。往东\n"
    "的路可以到达中原。\n"
  );

  set("valid_startroom", 1);

  set("exits", ([
    "east": __DIR__ "tulu2",
  ]));
  set("objects", ([
    "d/xueshan/npc/xiaoer2": 1
  ]));

  setup();
}
