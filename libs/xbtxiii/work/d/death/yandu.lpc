#pragma save_binary
// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "酆都狱");
        set("long",
"这里是“哭哭啼啼，凄凄惨惨，不忠不孝伤天理，佛口蛇心堕此\n"
"门”，这里关押的囚徒罪名比刚刚的又重了，酆都狱是用来关押\n"
"的，此类犯人实在太多，所以在此关押，受刑则送到下面的拔舌\n"
"狱。\n"
);
        set("exits", ([
		"up" : __DIR__"huokeng",
		"down" : __DIR__"bashe",
        ]) );
		setup();
        replace_program(ROOM);
}
 
