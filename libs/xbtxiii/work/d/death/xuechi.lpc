#pragma save_binary
// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "血池狱");
  set("long",
    "这里关押的都是“脱皮露骨，折臂断筋，也只为谋财害命，屠宰\n"
    "畜生堕千年”的恶徒，手上都沾满了他人的血，故阎王以血还血，\n"
    "将这等人浸泡于血池之中，每日受那血腥熏鼻之苦，日以继夜，\n"
    "痛苦难当。\n"
  );
  set("exits", ([
    "up": __DIR__ "daoshan",
    "down": __DIR__ "abi",
  ]));
  setup();
  replace_program(ROOM);
}
