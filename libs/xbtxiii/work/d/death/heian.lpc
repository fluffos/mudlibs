#pragma save_binary
// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "黑暗狱");
        set("long",
"这里毫无光亮，无数的囚徒将在这里呆上数十年或者更长，没有\n"
"一种恐惧比黑暗更能让人丛内心感到绝望了，所以通常这里的犯\n"
"人很少，一旦进来，想出去可很难，不过也正是这里，可以给他\n"
"们一个反省的机会。往下便是刀山狱了。\n"
);
        set("exits", ([
		"up" : __DIR__"youguo",
		"down" : __DIR__"daoshan",
        ]) );
		setup();
        replace_program(ROOM);
}
 
