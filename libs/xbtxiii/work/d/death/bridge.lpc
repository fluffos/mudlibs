    "而栗。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": "/d/death/road1",
    "south": "/d/death/gateway",
  ]));
  set("objects", ([
    //		__DIR__"npc/guizu": 2,
  ]));
