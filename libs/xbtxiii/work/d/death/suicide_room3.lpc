#pragma save_binary
// gate3.c
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIW "第十八层地狱" NOR);
  set("long",
    "这里就是著名的第十八层地狱，凡是能够来到这里的人。\n"
    "除了巫师，就是那些已经活腻了的，永世不得超生的人们。\n");
  set("no_fight", 1);
  set("no_magic", 1);
  set("objects", ([
    "/obj/npc/horse": 1
  ]));
  setup();
}
