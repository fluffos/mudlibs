#pragma save_binary
// /d/death/npc/horse.c 不知道为什么程序的最后一行总是会显示FAILED。虽然
// 确实将文件删除了。
// 天神的忠告：不要随便clone马面,负责造成的后果自负！
inherit NPC;
#include <ansi.h>

int rmhirdir(string dir);

void create()
{
        set_name("马面", ({ "horse" }) );
        set("long","一个样子长的像马的鬼。别看他样子难看。他可是\n"
            "第十八层地狱的狱长。拥有对鬼魂的生杀大权。\n");

        set("age", 5000);
        set("gender","中性");
        set("per",5);
        set("attitude", "friendly");
        setup();
}


void init()
{       
        object ob;
        ::init();
if( interactive(ob = this_player())
            && !is_fighting()) 
        {
        remove_call_out("greeting");
        call_out("greeting", 1,this_player());
        }
                add_action("do_rue","rue");
}

void greeting(object me)
{
if(userp(me)&&!wizardp(me)&&me->query_temp("PASSWORD")=="IS_RIGHT")
        {
        command("say 唉哟～　哟～　哟～　。又来了一个想不开的人儿啊！");
        command("say 你看见旁边那个大油锅没有，它是用来油炸来到这儿的人的。\n");
        command("say 您呆会儿，我刷刷锅，然后就。。。。嘿嘿～　～　～　。");
        message_vision(YEL"马面从腰里抽出刷子，边刷油锅边朝着$N奸笑。嘿嘿～　　～　　～　　。\n"NOR,me);
        me->set_temp("remainder_time",20);
        set("his_id_is",me->query("id")); 
        remove_call_out("greeting");
        call_out("do_suicide",5,me);
        }
else if(wizardp(me))
         message_vision(CYN"马面一见$N进来连忙点头哈腰说道：哎哟哟！什么风\n"
                 "把大人$N吹来了？里边请。里边请。\n"NOR,me); 
else 
        {
        command("say 这个地方有什么好玩的，滚！！！"); 
        message_vision("马面飞起一脚将$N踢的无影无踪!\n",me);
        me->move("/d/fy/fysquare");
        }
}


int do_suicide(object me)
{
        object link_ob;
                string id,bankfile;
        int time;
        time=me->query_temp("remainder_time"); 
if(me&&time>0)
        {
        tell_object(me,HIR"你--"+me->name()+"--,还剩下"+time+"秒的后悔时间。\n"NOR);
        tell_object(me,HIM"如果你后悔了，不想自杀了，请立即用(rue)命令结束自杀。\n"NOR);
        me->add_temp("remainder_time",-5);
        remove_action("do_rue","rue");
        add_action("do_rue","rue");
        call_out("do_suicide",5,me);
        }
else
        {
        link_ob = me->query_temp("link_ob");
        if( !link_ob ) return 0;
        message_vision(HIR"马面将油锅刷好了，接着，他领着$N的脖子将$N丢进了油锅。\n\n"
               "噼里啪啦～　　～　　～　　～　　～　　～　　～　　～　　～　　～\n\n"
               "空气中顿时弥漫着一种奇怪的味道。。。。。。。。。。。。。。。\n\n"NOR,me);
        tell_object(me,CYN"唉～　　～　　～　　　。死了也好，一了百了！以后有空来看看！！！\n"NOR);

        seteuid(getuid());
        id = me->query("id");
        log_file("nosave/SUICIDE",
                sprintf("%s commits a suicide on %s\n", geteuid(me), ctime(time())) );
        bankfile=DATA_DIR"bank/"+me->query("id")[0..0]+"/"+
                        me->query("id")+SAVE_EXTENSION;
        tell_object(bankfile);
        seteuid(getuid());
        if ( file_size(bankfile)>0 ) 
                rm( bankfile );
        rm( link_ob->query_save_file() + SAVE_EXTENSION );
        rm( me->query_save_file() + SAVE_EXTENSION );
            rm(DATA_DIR + "bag/" + me->query("id")[0..0] + "/" + me->query("id") + SAVE_EXTENSION);
        rm(DATA_DIR + "bank/" + me->query("id")[0..0] + "/" + me->query("id") + SAVE_EXTENSION);
        message("vision",HIR"-----"+me->name()+"("+id+")-----自杀了，以後你再也看不到这个人了。\n"NOR,users());

        seteuid(ROOT_UID);
        destruct(me);
        return 1;
        }
}

int do_rue()
{
        object me;
        me=this_player();
 
        remove_call_out("do_suicide");
if(me->query_temp("PASSWORD")=="IS_RIGHT")
                {
        message_vision(HIR"$N经过内心剧烈的思想斗争，终于在最后关头打消了自杀的念头!\n",me);
        command("say 什么？你不自杀跑这里来干什么啊？");
        command("say 我都已经把油锅刷好了，就等着抓你下锅呢！！！");
        command("say 气死我了！！！滚！！");
        message_vision("马面飞起一脚把$N踢的无影无踪。。。。。。\n"NOR,me);
        me->delete_temp("remainder_time");
        me->delete_temp("PASSWORD");
if(me->is_ghost())
                me->move("/d/death/hell");
else
        me->move("/d/fy/fysquare");
        remove_action("do_rue","rue");
        return 1;
                }
}
