#pragma save_binary
// gargoyle.c

#include <ansi.h>
#include <login.h>

inherit NPC;
mapping death_msg = ([
  "/d/death/road2": HIW "白无常说道：喂！新来的，跟我来。\n\n" NOR,
  "/d/death/road1": HIW "白无常说：你可别想着逃跑，不然到时无法转世可就只能做鬼了。\n\n" NOR,
  "/d/death/bridge": HIW "白无常说：千万别往河里跳，不然不知会些发生什么事。\n\n" NOR,
  "/d/death/gateway": HIW "白无常说：快点走，就要到了。\n\n" NOR,
  "/d/death/temple": HIW "阎罗王见你走过来，翻了翻桌上的一本像帐册的东西，说：\n"
  "“咦，你阳寿未尽，怎麽可能来到这里？白无常，把他送回去吧！”\n"
  "白无常应了一声，叹口气说：这一阵子不知怎么搞的，好多阳寿未尽的人都跑了过来。\n" NOR,
  "/d/death/hell": HIW "白无常一把把你推入冥海，你幌幌忽忽之间发觉自己已经回到阳间了\n\n" NOR,
]);
string *revive_loc = ({
  "/d/fy/church",
});


void create() {
  set_name("白无常", ({ "white gargoyle", "gargoyle" }));
  set("long",
    "白无常伸著长长的舌头瞪著你，死白脸上看不出任何喜怒哀乐。\n");
  set("attitude", "peaceful");
  set("chat_chance", 5);
  set("chat_msg", ({
    "白无常发出一阵像呻吟的声音，当他发现你正注视著他的时候，瞪了你一眼。\n",
    "白无常把长长的舌头伸出来，缓缓地舔了舔自己又白又长的手指。\n"
  }));
  set("age", 217);
  set("combat_exp", 50000);
  set("max_gin", 900);
  set("max_kee", 900);
  set("max_sen", 400);
  set_skill("dodge", 80);
  set_skill("unarmed", 80);
  setup();
  call_out("dest_me", 600);

}
int is_ghost() { return 1; }
void init() {
  ::init();
  if (query("lead") == this_player()) call_out("death_stage", 5, this_player());
  else
    //        destruct(this_object())
    ;
}

void death_stage(object ob) {
  string room;
  if (!ob || !present(ob)) return;
  room = file_name(environment(this_object()));
  if (!ob->is_ghost() || ob != query("lead")) return;
  tell_object(ob, death_msg[room]);
  if (room != "/d/death/hell") {
    call_out("force_me_go", 5, ob, room);
    command("go south");
    return;
  } else if (ob->is_ghost())
    ob->reincarnate();

  ob->move(revive_loc[random(sizeof(revive_loc))]);
  ob->set("startroom", base_name(environment(ob)));
  message("vision",
    "你忽然发现前面多了一个人影，不过那人影又好像已经在那里\n"
    "很久了，只是你一直没发觉。\n", environment(ob), ob);
  tell_room(environment(this_object()),
    "一股阴冷的浓雾突然出现，很快地包围了白无常\n");
  destruct(this_object());
}

void force_me_go(object me, string room) {
  if (!me) return;
  if (file_name(environment(me)) != room) return;
  tell_object(me, HIW "白无常在前面叫道：快点走吧，不然会误了时辰的。\n"
    HIW "你迷迷糊糊的向前走了过去。\n" NOR);
  me->move(environment(this_object()));
}
void dest_me() {
  destruct(this_object());
}
