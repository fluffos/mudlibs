#pragma save_binary
// /d/death/npc/horse.c

inherit NPC;
#include <ansi.h>
#include <command.h>

int rmhirdir(string dir);

void create() {
  set_name("马面", ({ "horse" }));
  set("long", "一个样子长的像马的鬼。别看他样子难看。他可是\n"
    "第十八层地狱的狱长。拥有对鬼魂的生杀大权。\n");

  set("age", 5000);
  set("gender", "中性");
  set("per", 5);
  setup();
}


void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player())
    && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1);
  }
}

void greeting() {
  object me;
  me = this_player();
  if (!wizardp(me) && me->query_temp("password") == "is_right") {
    command("sigh");
    command("say 既然你来到了这儿，以后就别想着出去了。");
    command("say 你看见旁边那个大油锅没有，它是用来炸来到这儿的人的。\n");
    set("his_id_is", me->query("id"));
    call_out("do_suicide", 1);
  } else if (wizardp(me))
    message_vision(CYN "马面一见$N进来连忙点头哈腰说道：哎哟哟！什么风把大人$N吹来了？\n"
      "里边请。里边请。\n", me);
}


int do_suicide() {
  object me;
  object link_ob;
  string name, file;
  me = this_player();
  //        me=find_player(query("his_id_is"));


  if (me) {
    command("say 他是" + me->name() + "");
    command("say 他是 " + query("his_id_is") + "");
  }
  link_ob = me->query_temp("link_ob");
  if (!link_ob) return 0;

  log_file("nosave/SUICIDE",
    sprintf("%s commits a suicide on %s\n", geteuid(me), ctime(time())));


  seteuid(getuid(me));

  name = me->query("id");
  LOGIN_D->cphirdir(
    DATA_DIR + "login/" + name[0..0] + "/" + name,
    "/suicide/login/" + name + time()
  );
  LOGIN_D->cphirdir(DATA_DIR + "user/" + name[0..0] + "/" + name, "/suicide/user/" + name + time());
  rmhirdir(DATA_DIR + "login/" + name[0..0] + "/" + name);
  rmhirdir(DATA_DIR + "user/" + name[0..0] + "/" + name);
  tell_room(environment(me), me->name() +
    "自杀了，以後你再也看不到这个人了。\n", ({ me }));
  //        destruct(me);
  return 1;

}


int rmhirdir(string dirstr) {
  string *dir;
  int i;
  dir = get_dir(dirstr + "/");
  for (i = 0; i < sizeof(dir); i++) {
    if (file_size(dirstr + "/" + dir[i]) == -2) {
      rmhirdir(dirstr + "/" + dir[i]);
      rmdir(dirstr + "/" + dir[i]);
    }
    rm(dirstr + "/" + dir[i]);
    return 1;
  }
  rmdir(dirstr);
  return 1;

}
