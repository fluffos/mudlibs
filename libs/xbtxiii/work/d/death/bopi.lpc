#pragma save_binary
// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "剥皮狱");
  set("long",
    "几只大钩子悬于半空，上悬数人，几个牛头，马面以极为熟练的\n"
    "手法在人犯头顶开口，然后灌入水银，旋即剥下一张完整的人皮，\n"
    "令人做呕，地府之酷刑，一至于斯，一牛头鬼似乎看穿了你的心\n"
    "思，淡然说道“十恶不赦之徒，非此不能降其心啊，地府之中，\n"
    "虽酷但自有公道”。话虽如此，你还是忍耐不住，向下面的磨捱\n"
    "狱走去。\n"
  );
  set("exits", ([
    "up": __DIR__ "bashe",
    "down": __DIR__ "moai",
  ]));
  setup();
  replace_program(ROOM);
}
