#pragma save_binary
// gate.c

#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
        set("short", HIR "十八层地狱门口" NOR);
        set("long",
"一扇厚厚的大门将第十八层地狱和外界分开了。大门的后面就是\n"
"著名的第十八层地狱！\n"
);
        set("exits", ([
                "east" : __DIR__"hell",
                
        ]) );

        setup();
}
 
void init()
{
        add_action("do_open","open");       

}


int do_open(string arg)
{
        object me;
        me=this_player();
if(arg=="door"||arg=="men"||arg=="大门") 
        {
        if(wizardp(me))
            {
            message_vision(CYN"\n$N双手一挥，通向第十八层地狱的大门立即被打开了。\n",me);
            set("exits",([
                        "east"  :   __DIR__"hell", 
                        "west"  :   __DIR__"suicide_room3",
            ]));
            }
        else
            {
            write("这扇大门是通向第十八层地狱的大门。走进大门里面就意味着自杀。\n"
                  "如果你真的想自杀。那么就请你输入自己的密码:");
            input_to("check_password", 1, me, 1);
            } 
        return 1;
        }
else
        return notify_fail("你要打开什么？\n");

}

int valid_leave(object me, string dir)
{
if(wizardp(me))
        {
        delete("exits/west");
        return 1;
        }
if(dir=="west"&&me->query_temp("PASSWORD")=="IS_RIGHT")
        {
        message_vision(HIR"$N决定自杀了！以后你们可能再也看不见这个人了！！！\n"NOR,me);
        delete("exits/west");
        remove_call_out("do_close_door");
        }
else if(dir=="west"&&me->query_temp("PASSWORD")!="IS_RIGHT")
        {
        return notify_fail(HIR"一阵莫名其妙的力量使你定在了原地，使你无法朝南边离去!\n"NOR);
        } 
        return 1;
}

private void check_password(string passwd, object me)
{
        object link_ob;
        string old_pass;
        string name;
        link_ob = me->query_temp("link_ob");
        old_pass = link_ob->query("password");
if( crypt(passwd, old_pass)!=old_pass ) 
                {
                write("密码错误！\n");
                return;
                }
        message_vision(CYN"\n只听咯吱～　　咯吱～　　的一阵响声。通向第十八层地狱\n"
               "的大门被"+me->name()+"打开了。\n",me);
        me->set_temp("PASSWORD","IS_RIGHT");
        set("exits",([
                     "east"  :   __DIR__"hell", 
                     "west"  :   __DIR__"suicide_room3",
        ]));
        call_out("do_close_door",10);
}

void do_close_door()
{
        this_object()->delete("exits");
        set("exits",([
                    "east"  :  __DIR__"hell",
        ]));
        message_vision("大门咯吱咯吱的关上了\n",this_player());

}

