#pragma save_binary
// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "抽肠狱");
  set("long",
    "这里似乎与别处又是不同，没有大刑具，所有的东西就是几把钩\n"
    "子和几把解牛刀，鬼卒熟练的用刀剖开肚子，钩子一钩，便是一\n"
    "声惨叫，听着这声音，头皮发麻的你发誓以后绝不做坏事了，遍\n"
    "地的肠子让人只做呕，但是心中又多了一分向善之心。这里往下\n"
    "便又是一种了。\n"
  );
  set("exits", ([
    "up": __DIR__ "tuoke",
    "down": __DIR__ "youguo",
  ]));
  setup();
}
