#pragma save_binary
// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "寒冰狱");
  set("long",
    "冰是昆仑山的千年寒冰，无数的犯人正赤身裸体的走在冰上，这\n"
    "里管得都是“垢面蓬头，愁眉皱眼，大斗小秤欺痴蠢，致使灾屯\n"
    "累自身”的奸商，用别人的损失换来自己的金银，结果仍是一无\n"
    "所有的在冰上走，对人用刑，地狱之法果然不同凡间。\n"
  );
  set("exits", ([
    "up": __DIR__ "chebeng",
    "down": __DIR__ "tuoke",
  ]));
  setup();
}
