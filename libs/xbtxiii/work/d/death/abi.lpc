#pragma save_binary
// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "阿鼻狱");
  set("long",
    "又名穿鼻狱，来到这里的人下世绝无转生为人的可能，这里的人\n"
    "都象牛一样，鼻孔被穿，无数牛头，马面牵之来回行走，不时以\n"
    "铜锤击身，钢鞭敲打，使其时刻警醒。再下面便是最后一层秤杆\n"
    "狱。\n"
  );
  set("exits", ([
    "up": __DIR__ "xuechi",
    "down": __DIR__ "banggan",
  ]));
  setup();
}
