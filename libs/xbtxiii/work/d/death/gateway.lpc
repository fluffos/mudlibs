#pragma save_binary
// Room: /d/death/gateway.c

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("short", "酆都城门");
  set("long",
    "你现在来到一座黑色城楼之前，城楼上刻著三个大字：酆都城。\n"
    "往北不远处是一座桥，桥上鬼影幢幢，但是却听不到半点声音，\n"
    "往南走进城楼只见一片黑漆漆的，只有少许暗红色的火光若隐若\n"
    "现地闪烁著。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": "/d/death/bridge",
    "south": "/d/death/temple",
  ]));
  set("objects", ([
    //		__DIR__"npc/bgargoyle": 1
  ]));
  set("no_magic", 1);

  setup();

}
