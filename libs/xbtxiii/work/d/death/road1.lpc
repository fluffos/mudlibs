#pragma save_binary
// Room: /d/death/road1.c

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("short", "鬼门大道");
  set("long",
    "你走在一条阴森森的路上,浓浓的雾环绕在你的四周,好像永远都\n"
    "不会散去似的.往南看去你勉强可以分辨出一个城楼的模样,往北\n"
    "隐约可以看到几盏灯笼,在浓雾中显得格外的诡异.\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": "/d/death/road2",
    "south": "/d/death/bridge",
  ]));
  set("no_magic", 1);

  setup();
  replace_program(ROOM);
}
