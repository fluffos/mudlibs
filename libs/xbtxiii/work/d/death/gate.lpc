// gate.c

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HIW "鬼门关" NOR);
  set("long",
    "这里就是著名的阴间入口「鬼门关」，在你面前矗立著一座高大\n"
    "的黑色城楼，许多亡魂正哭哭啼啼地列队前进，因为一进鬼门关\n"
    "就无法再回阳间了。\n"
  );
  set("exits", ([
    "north": __DIR__ "gateway",
    //		"south" : __DIR__"path",
  ]));
  set("objects", ([
    //		__DIR__"npc/wgargoyle":1
  ]));
  set_temp("light", 1);
  setup();
}
