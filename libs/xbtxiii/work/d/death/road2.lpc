#pragma save_binary
// Room: /d/death/road2.c
#include <ansi.h>
inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("short", "鬼门大道");
  set("long",
    "你走在一条阴森森的路上,浓浓的雾环绕在你的四周,好像永远都\n"
    "不会散去似的.整条路前後只看到零星的几盏灯笼........\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": "/d/death/road3",
    "south": "/d/death/road1",
  ]));

  set("no_fight", 1);
  set("no_magic", 1);
  setup();
}
void init() {
  object me, gargoyle;
  me = previous_object();
  me->delete_temp("shengsi");
  if (me->is_ghost() && userp(me)) {
    gargoyle = new(__DIR__ "npc/gargoyle");
    gargoyle->move(this_object());
    me->set_leader(gargoyle);
    gargoyle->set("lead", me);
    gargoyle->greet(me);
    gargoyle->move(this_object());
    me->set_explore("north#3");
  }
  return;
}
int valid_leave(object me, string dir) {
  if (dir == "north") {
    if (random(10) == 3) {
      tell_object(me, HIW "你漫无目的地走着.....一股阴冷的浓雾突然出现，很快地包围了你。\n" NOR);
      tell_object(me, HIW "......恍惚之间发觉自己已经回到了阳间。\n" NOR);
      me->reincarnate();
      me->move("/d/choyin/altar");  //阴阳两界的地方
      if (!me->is_ghost())
        message("vision",
          "你忽然发现前面多了一个人影，不过那人影又好像已经在那里\n"
          "很久了，只是你一直没发觉。\n", environment(me), me);
      else message("vision", "忽然一阵阴风刮过，你不禁打了个寒战，\n"
        "四下一看，却看不到有什么东西。", environment(me), me);
      return notify_fail("");
    } else {
      return notify_fail("你走著走著..... 发现四周景色居然都没有变....\n");
    }
  }
  return 1;
}
