#pragma save_binary
// /d/death/temple.c

#include <ansi.h>
inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("short", HIW "森罗殿" NOR);
  set("long",
    "这里就是赫赫有名的森罗殿，是阎罗王审判鬼魂的地方殿后则是\n"
    "十八层地狱，你似乎隐隐约约听见鬼的哭号之声从殿后传来。\n"
  );
  set("exits", ([
    "north": __DIR__ "gateway",
    "south": __DIR__ "hell",
  ]));
  set("objects", ([
    //                __DIR__"npc/hades":1
    //                __DIR__"npc/judge":1
  ]));
  set("no_magic", 1);
  setup();
  replace_program(ROOM);
}

int valid_leave(object me, string dir) {
  if (wizardp(me) || !userp(me)) return 1;

  if (dir == "north") {
    return notify_fail("一个空洞的声音在你耳边响起....\n" +
      "没有回头路了!\n");
  } else return 1;
}
