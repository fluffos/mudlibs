#pragma save_binary
// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "脱壳狱");
  set("long",
    "这里似乎和剥皮狱差不多，不过这里的犯人是皮肉和骨头分离，\n"
    "把活人变为骷髅，然后再把皮肉贴上去，循环往复，其间痛苦实\n"
    "在难以抵挡，许多囚犯经历这层以后变改邪归正，从此成为良善\n"
    "之徒。你看见了不少似曾相识的面孔。再往下会是什么呢？\n"
  );
  set("exits", ([
    "up": __DIR__ "hanbing",
    "down": __DIR__ "chouchang",
  ]));
  setup();
  replace_program(ROOM);
}
