#pragma save_binary
// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "吊筋狱");
  set("long",
    "这里是地狱的第一层，地狱共十八层，每三层关押同一类人犯，\n"
    "故实际关押六种犯人。这第一种三层关押的是“寂寂寥寥，烦烦\n"
    "恼恼，尽是生前作下千般业，死后通来受罪名”，在这吊筋狱中\n"
    "关押的皆是罪名较轻之人，受挑筋之苦，遍地血腥，呻吟声此起\n"
    "彼伏，几个鬼卒来回逡巡，再往下便是幽枉狱。\n"
  );
  set("exits", ([
    "up": __DIR__ "hell",
    "down": __DIR__ "yiuwang",
  ]));
  setup();
}
