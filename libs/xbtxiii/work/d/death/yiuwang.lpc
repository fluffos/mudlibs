#pragma save_binary
// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "幽枉狱");
  set("long",
    "这里不见血腥，也不闻呼声，这里的犯人全部被单独关押，寂寥\n"
    "无声，所有人之间无法交谈，一关就是数十年，几个鬼卒皆是天\n"
    "生哑人，亦不发语，所以一片寂静尤为可怕，较之吊筋狱更让人\n"
    "恐惧。下一层的火坑狱会怎样？\n"
  );
  set("exits", ([
    "up": __DIR__ "diaojin",
    "down": __DIR__ "huokeng",
  ]));
  setup();
}
