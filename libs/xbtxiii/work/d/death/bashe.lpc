#pragma save_binary
// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "拔舌狱");
  set("long",
    "自古以来奸恶之徒，不孝之人多爱搬弄是非，佛口蛇心，故设拔\n"
    "舌狱，以七寸长箝勾去舌头，使之口不能言，舌会复长，长而再\n"
    "拔，往复循环，直至犯人心胆皆丧，来世为人，便不敢再犯此业。\n"
    "再往下便是剥皮狱。\n"
  );
  set("exits", ([
    "up": __DIR__ "yandu",
    "down": __DIR__ "bopi",
  ]));
  setup();
}
