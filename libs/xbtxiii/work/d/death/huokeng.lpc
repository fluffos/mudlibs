#pragma save_binary
// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "火坑狱");
  set("long",
    "一进来，扑面的热气几乎让你昏了过去，火海之中，几个犯人正\n"
    "在来回穿梭，每过一次，浑身骨肉俱成焦炭，然后被鬼卒浇上神\n"
    "水后恢复原样，又拿着铁棒赶进火里。你不由得心胆俱焚，暗自\n"
    "庆幸生前未曾做下什么罪业。由此向下是酆都狱。\n"
  );
  set("exits", ([
    "up": __DIR__ "yiuwang",
    "down": __DIR__ "yandu",
  ]));
  setup();
  replace_program(ROOM);
}
