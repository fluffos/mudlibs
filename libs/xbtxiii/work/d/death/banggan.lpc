#pragma save_binary
// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "秤杆狱");
        set("long",
"此狱乃是公平所在，大凡罪犯最怕正义，用公平和正义去惩罚他\n"
"们，才是最让他们胆寒的，所以地藏特地设此一狱，无刑无罚，\n"
"但只教满腹正义之人讲书论课，宣天下至理，直至感化为止。到\n"
"此便再无刑狱。\n"
);
        set("exits", ([
		"up" : __DIR__"abi",
        ]) );
        set("objects", ([
                __DIR__"npc/ghost" : 5,
        ]) );
		setup();
        replace_program(ROOM);
}
 
