// Room: /d/ultimate/bedroom.c 小龙女的卧室。
#include <ansi.h>
inherit ROOM;

void create() {
  set("coor", ({ -3700, -850, -100 }));
  set("short", "简陋的卧室");
  set("long", "房中床榻桌椅惧全。全由粗木搭成。但见室右有榻。\n"
    "室中凌空拉着一条长绳，是他练轻功时睡卧所.窗前小\n"
    "小一几，是他读数写字之处。室左立着一个粗糙木橱，\n"
    "拉开橱门，只见橱中放着几件树皮结成的儿童衣衫。\n");
  set("exits", ([ /* sizeof() == 1 */
    "out": __DIR__ "stone_door",
  ]));
  set("objects", ([
    __DIR__ "npc/man1": 1,
    __DIR__ "npc/man3": 1,
    __DIR__ "npc/man4": 1,
    __DIR__ "npc/man5": 1,
    __DIR__ "npc/man6": 1,
  ]));
  set("no_magic", 1);
  setup();
}

int init() {
  object me;
  me = this_player();
  if (!wizardp(me))
    add_action("command", "");
}

int command(string arg) {
  object me, npc;
  string cmd, *cmds, *name;
  int i;

  me = this_player();
  cmd = query_verb();
  cmds = ({ "use", "cast", "tie", "dance", "home", "dancing", "attach", "pray" });
  name = ({ "tao yexian", "tao shixian", "tao genxian",
    "tao zhixian", "tao huaxian" });
  if (member_array(cmd, cmds) != -1)
    return 1;
  else if (cmd == "kill") {
    if (member_array(arg, name) != -1) {
      npc = present(arg, this_object());
      if (npc) {
        for (i = 0; i < 5; i++) {
          npc = present(name[i], this_object());
          if (npc) npc->kill_ob(me);
        }
        return 1;
      }
    }
    return 0;
  }

  else return 0;
}

int valid_leave(object me, string dir) {
  string msg;
  object npc;
  if (me->query_temp("皇帝的笑容/得到何首乌")) {
    msg = "$N正要离开。突然桃谷六仙之一的桃枝仙大叫:大哥!这么好的一个\n"
      "东西你就这么给他了？你同意我不同意。喂！桃干仙对$N大喊。你给\n"
      "站住。你要是可以接的住我三招我才同意你离开。说完立刻招呼了过来\n";
    message_vision(HIC + msg + NOR, me);
    npc = present("tao zhixian", this_object());
    if (npc->test_player(me) == 1)
      return 1;
    //接桃干仙三招。
    else return 0;
  }
  return 1;
}
