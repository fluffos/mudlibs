// Room: /d/ultimate/small_house.c

inherit ROOM;
#include <ansi.h>

void create() {
  set("coor", ({ -3700, -850, -100 }));
  set("short", "石室门口");
  set("long", "一堵厚厚的石门堵住了去路。要是没有钥匙的话就甭想进去。\n");
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "gu_di3",
    "enter": __DIR__ "room",
  ]));
  set("objects", ([
    __DIR__ "npc/man2": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (me->query_temp("皇帝的笑容/邀请进入"))
    return 1;

  else if (dir == "enter")
    return notify_fail("石门是关着的，从外面是无法打开的。\n");
  else return 1;
}
