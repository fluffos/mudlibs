// 桃谷六仙 二仙 桃干仙
// 负责测试暗号。
#include <ansi.h>

inherit NPC;

void create() {
  set_name("桃干仙", ({ "tao ganxian", "ganxian" }));
  set("gender", "男性");
  set("age", 42);
  set("str", 50);
  set("long", "\n桃谷六仙老二 桃干仙。\n");
  set("combat_exp", 2000000);
  set("attitude", "peaceful");

  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("qianye-shou", 200);
  set_skill("shaolin-shenfa", 200);
  set_skill("force", 200);
  set_skill("hunyuan-yiqi", 200);

  map_skill("parry", "qianye-shou");
  map_skill("unarmed", "qianye-shou");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("force", "hunyuan-yiqi");

  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/armor", 50);
  set_temp("apply/damage", 80);

  set("max_kee", 3000);
  set("kee", 3000);
  set("max_gin", 3000);
  set("gin", 3000);
  set("force_factor", 100);
  set("max_force", 4000);
  set("force", 4000);
  set("inquiry", ([
    "千年何首乌": "哦，那个东西在我大哥那里呢。。\n",
    "何首乌": "哦，那个东西在我大哥那里呢。。\n",
  ]));

  setup();
  carry_object("/obj/cloth")->wear();
  add_money("gold", 5);
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  remove_call_out("greeting");
  call_out("greeting", 1, ob);
  add_action("do_answer", "answer");
}

void greeting(object ob) {
  string msg;
  msg = "桃干仙看了看$N，忽然问$N：你来的路上看见了多少只蜜蜂？\n";
  message_vision(HIC + msg + NOR, ob);
  msg = "要回答他多少只吗？(answer)\n";
  tell_object(ob, HIC + msg + NOR);
  return;
}

int do_answer(string arg) {
  string msg;
  object me;
  int i, number;
  me = this_player();
  if (!arg)
    return notify_fail("喂，你到底想回答多少啊？\n");
  if (sscanf(arg, "%s", i) != 1)
    return notify_fail("喂，你到底知不知道暗号呢？不知道就别瞎说。\n");
  if (!intp(i))
    return notify_fail("喂，你到底知不知道暗号呢？不知道就别瞎说啊。\n");
  number = me->query_temp("皇帝的笑容/桃谷六仙的暗号");
  if (!number) {
    msg = "$N沉思片刻，随口说了一个数字" + arg + "\n"
      "桃干仙瞥了$N一眼：胡说八道。分明有五只蜜蜂\n";
    message_vision(HIC + msg + NOR, me);
    remove_action("do_answer", "answer");
    return 1;
  }
  if (i == number) {
    msg = "$N沉思片刻，随口说了一个数字" + arg + "\n"
      "桃干仙瞥了$N一眼：恩，你好聪明。看来你不是敌人。\n"
      "你进去吧。桃干仙把石门打开了。\n";
    message_vision(HIC + msg + NOR, me);
    remove_action("do_answer", "answer");
    me->delete_temp("皇帝的笑容");
    me->set_temp("皇帝的笑容/邀请进入", 1);
    return 1;
  } else if (i != number) {
    if (me->query_temp("皇帝的笑容/对暗号") >= 3) {
      msg = "桃干仙大怒，对$N骂到：他妈的。我看你小子有问题。去死吧。!\n";
      message_vision(HIC + msg + NOR, me);
      this_object()->kill_ob(me);
      remove_action("do_answer", "answer");
      return 1;
    }
    msg = "$N沉思片刻，随口说了一个数字" + arg + "\n"
      "桃干仙瞥了$N一眼：恩，你好好想想。我就在给你一次机会.\n";
    message_vision(HIC + msg + NOR, me);
    me->add_temp("皇帝的笑容/对暗号", 1);
    return 1;
  } else { remove_action("do_answer", "answer"); return 0; }
}
