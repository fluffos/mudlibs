// Room: /d/snow/deaprec.c

inherit ROOM;
#include <ansi.h>

void create()
{
        set("coor",({-3700,-800,-100}));
	set("short", "圣湖湖底");
		set("long","四周竟然是另外一翻天地。只见繁花青草，便如同一个\n"
    	 		   "极大的花园，然花影不动，幽谷无人。。十余丈外有几间茅屋\n");
        set("exits", ([ /* sizeof() == 2 */
  	    "south" : __DIR__"stone_door",
  	    "north": __DIR__"gu_di2",
  	]));
        setup();
}


int init()
{
	object me;
	me=this_player();
	call_out("greeting",1,me);
}	

int greeting(object me)
{
	string msg;
	msg =CYN"前面传来了微微的人语声。好象有人。\n"NOR;
	tell_object(me,msg);

}