// Room: /d/snow/deaprec.c

inherit ROOM;
#include <ansi.h>

void create() {
  set("coor", ({ -3700, -700, -100 }));
  set("short", "圣湖湖底");
  set("long", "四周竟然是另外一翻天地。只见繁花青草，便如同一个\n"
    "极大的花园，然花影不动，幽谷无人。。旁边有一个很深的水潭\n");
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "gu_di2",
  ]));
  set("objects", ([
    __DIR__ "npc/bee": 3,
  ]));
  setup();
}


int init() {
  add_action("do_dive", "dive");
}

int do_dive() {
  object me;
  me = this_player();
  message_vision("$N一个猛子朝水潭扎了进去。\n", me);
  me->move(__DIR__ "shuidi");
  return 1;
}
