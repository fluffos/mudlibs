// 太监
// 皇帝的心腹。秘密皇帝的笑容从他身上开始
#include <ansi.h>
inherit NPC;
int ask_me();
void create() {
  set_name("老太监", ({ "old eunuch" }));
  set("gender", "男性");
  set("age", 60);
  set("long", "他是皇帝身边的亲信太监。皇上有什么心事他都知道的一清二楚。\n");
  set("combat_exp", 100);
  set("str", 27);
  set("force", 200);
  set("max_force", 200);
  set("force_factor", 2);
  set("inquiry", ([
    "皇帝": (: ask_me :),
    "皇帝的心事": (: ask_me :),
    "皇帝": (: ask_me :),
    "皇上的心事": (: ask_me :),
  ]));
  setup();
  add_money("silver", 100);
  carry_object("/obj/cloth")->wear();
}
int init() {
  object me;
  me = this_player();
  if (me->query_temp("皇帝的笑容/得到减肥茶"))
    call_out("greeting", 1, me);
  ::init();
}

int greeting(object me) {
  string msg;
  msg = "太监看见你走了进来，悄悄对你说：你找到减肥茶了吗？\n"
    "如果找到了的话。就赶快交给皇上吧。皇上正发愁呢。\n";
  tell_object(me, HIC + msg + NOR);
  return 1;
}

int ask_me() {
  object me;
  string msg;
  int exp;
  me = this_player();
  exp = me->query("combat_exp");
  msg = "$N悄悄的向$n打听有关皇帝的事情\n";
  message_vision(HIC + msg + NOR, me, this_object());
  if (exp <= 800000) {
    tell_object(me, "太监瞪了你一眼。就凭你？一边呆着去。\n");
    return 1;
  }
  msg = "太监道:“这个。。。这个。。。啊！\n"
    "太监背转身去，嘿嘿地奸笑了两声：\n"
    "你是不是该。。。。。。意思意思呢？\n";
  message_vision(HIC + msg + NOR, me);
  me->set_temp("皇帝的笑容/问了太监", 1);
  return 1;
}

int accept_object(object me, object obj) {
  //	object obj;
  string msg;
  if (me->query_temp("皇帝的笑容/问了太监")) {
    if (obj->query("money_id")) {
      if (obj->value() < 100000) {
        msg = "老太监对$N哼了一声：说到：你当我是叫花子打发呀？这么少。\n"
          "不过算了。大爷我还是收下吧。\n";
        message_vision(HIC + msg + NOR, me);
        return 1;
      } else {
        msg = "太监一看黄金，两眼放光：\n"
          "太监悄悄的对$N说了一些话。\n";
        message_vision(msg, me);
        msg = "太监在你耳边悄悄说到：嘿嘿！告诉你吧，皇上最近正\n"
          "为皇后的身型而烦恼呢！但宫中御医又不晓得减肥的药\n"
          "方，听说此方为民间某人家传秘方或许你可以去找找！\n"
          "许久，太监自言自语：不知道她现在还在不在桥阴\n";
        tell_object(me, HIC + msg + NOR);
        me->delete_temp("皇帝的笑容/问了太监");
        me->set_temp("皇帝的笑容/去找美眉", 1);
        return 1;
      }
    } else return 0;
  }

  return 0;
}
