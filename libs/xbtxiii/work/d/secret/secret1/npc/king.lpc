#include <ansi.h>
inherit NPC;
int alert_gaoshou();
int give_allow();
int ask_me();
int ask_game();
string get_msg();
void create() {
  set_name("皇帝", ({ "emperor" }));
  set("gender", "男性");
  set("rank", 7);
  set("pursuer", 1);
  set("vendetta_mark", "authority");
  set("attitude", "heroism");
  set("int", 1);
  set("class", "officer");
  create_family("朝廷", 2, "皇帝");
  set("rank", 9);
  set("max_kee", 100000);
  set("max_atman", 1000);
  set("atman", 1000);
  set("max_sen", 100000);
  set("combat_exp", 200000);
  set("long",
    "当今天子,有无上的权力。\n"
  );
  set("no_arrest", 1);
  set_skill("move", 100);
  set_skill("dodge", 100);
  set_skill("leadership", 400);
  set_skill("sword", 100);
  set_skill("strategy", 400);
  set("inquiry", ([
    "封疆大吏": (: give_allow :),
    "心事": (: ask_me :),
    "烦恼": (: ask_me :),
    "皇后": (: ask_me :),
    "游戏规则": (: ask_game :),
    "规则": (: ask_game :),
  ]));

  set("chat_chance", 2);
  set("chat_msg", ({
    "天子悠悠叹了口气。唉～～～ \n",
    "皇上满面愁容，嘴里还不断嘟喃，“哎。。。皇后要是再苗条一点就好了\n"
    "视觉上的刺激一定很high!.\n",
    "天子似乎想到什么高兴的地方，皇上竟不自觉的笑了出来。嘻嘻～～～\n",
  }));

  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: alert_gaoshou :),
    (: alert_gaoshou :),
    (: alert_gaoshou :),
  }));


  setup();
  carry_object(__DIR__ "obj/sword")->wield();
  carry_object(__DIR__ "obj/cloth")->wear();
}

void init() {
  string msg;
  object me;
  me = this_player();
  ::init();
  if (!userp(me)) return;
  msg = HIW "" + me->query("name") + "慌忙跪倒叩头!\n" NOR;
  message_vision(msg, me);
  msg = HIW "吾皇万岁!万岁!万万岁!\n" NOR;
  message_vision(msg, me);
  msg = HIW "皇帝微微点了点头,说道:爱卿免礼,平身!\n" NOR;
  message_vision(msg, me);
  add_action("do_answer", "answer");
}

int do_answer(string arg) {
  object me, gold;
  string msg;
  int n1, n2, n3, n4, a, b, i, j;
  int *number, *n, amount, exp, point;
  me = this_player();
  if (!me->query_temp("皇帝的笑容/做游戏"))
    return 0;
  number = me->query_temp("皇帝的笑容/要猜测数字");
  if (!number || number == ({})) return 0;
  if (!arg) return notify_fail("是四个数字。中间有空格分开例如1 2 3 4 .明白了吗？\n");
  if (sscanf(arg, "%d%d%d%d", n1, n2, n3, n4) != 4) {
    msg = "皇帝微笑了一下。看来你的听力不是很好。是四位数字。\n";
    tell_object(me, HIC + msg + NOR);
    return 1;
  } else {
    a = 0;
    b = 0;  //显示累计。
    //用掉了一次机会。
    if (n1 != n2 && n2 != n3 && n3 != n4 &&
      (n1 >= 0 && n1 <= 9 && n2 >= 0 &&
        n2 <= 9 && n3 >= 0 && n3 <= 9 &&
        n4 >= 0 && n4 <= 9)) {
      me->add_temp("皇帝的笑容/数字游戏/剩余次数", -1);
      n = ({ n1, n2, n3, n4 });
      for (j = 0; j < 4; j++) {
        for (i = 0; i < 4; i++) {
          if (j == i) {
            if (n[j] == number[i])
              a++;
          } else {
            if (n[j] == number[i])
              b++;
          }
        }
      }
      if (me->query_temp("皇帝的笑容/数字游戏/剩余次数") > 0) {
        if (a == 4) {
          amount = 0;
          for (i = 0; i < 4; i++) {
            if (i == 0)
              amount += number[i] * 1000;
            if (i == 1)
              amount += number[i] * 100;
            if (i == 2)
              amount += number[i] * 10;
            if (i == 3)
              amount += number[i];
          }
          if (me->query("终极秘密/皇帝的笑容"))  //这个奖励只是一次性的。
          {
            amount = random(10);
            exp = random(10000);
            point = random(2000);
          } else {
            exp = 100000;
            point = 10000;
          }  //第一次完成的奖励很高。
          if (amount > 2000) amount = 2000;
          gold = new(GOLD_OB);
          gold->set_amount(amount);
          msg = "皇帝露出大喜的神色。爱卿果然厉害。不负众望。\n"
            "挽回了我泱泱大国的面子。好！既然如此。来人。\n"
            "赏赐$N黄金" + amount + "两\n";
          message_vision(HIC + msg + NOR, me);
          if (!gold->move(me))
            gold->move(environment(me));
          me->add("combat_exp", exp);
          me->add("potential", point);
          msg = "恭喜你完成了皇帝的笑容的任务\n"
            "你被奖励了" + exp + "的实战经验\n"
            +point + "的潜能\n";
          tell_object(me, HIW + msg + NOR);
          me->set("终极秘密/皇帝的笑容", 1);  //秘密集合。
          me->delete_temp("皇帝的笑容");
          return 1;
        } else {
          msg = "好的。这次你所猜的数字的情况是这个样子的。\n";
          msg += a + HIC "A" + b + HIM "B" + "\n" NOR;
          msg += "你还有" + me->query_temp("皇帝的笑容/数字游戏/剩余次数") + "次机会，加油。\n";
          tell_object(me, HIC + msg + NOR);
          return 1;
        }
      } else {
        msg = "很遗憾，你没有猜对。爱卿也不必难过。这里是200两黄金。\n";
        "爱卿拿去吧。\n";
        gold = new(GOLD_OB);
        gold->set_amount(200);
        if (!gold->move(me))
          gold->move(environment(me));
        me->set("终极秘密/皇帝的笑容", 1);  //秘密集合。
        me->delete_temp("皇帝的笑容");
        message_vision(HIC + msg + NOR, me);
        return 1;
      }
    } else {
      msg = "好的，既然你的听力如此之差，就让我再告诉你一次。\n"
        "是四位不重复的数字,并且每个数字在(0....9)之间\n"
        "记住了吗？重新来一次。\n";
      tell_object(me, HIC + msg + NOR);
      return 1;
    }
  }
}
int decide(string arg, object me) {
  string msg;
  object gold, sign;
  int i, j, *number;
  if (!arg) {
    msg = "不过我近来刚刚学会了一个小游戏，不知道爱卿有没有兴趣玩呀？\n"
      "请选择(yes/no/y/n)\n";
    tell_object(me, HIC + msg + NOR);
    input_to("decide", me);
  } else if (arg == "yes" || arg == "y") {
    msg = get_msg();
    tell_object(me, msg);
    msg = "如果你听明白了的话就回答我(answer)\n"
      "皇帝拿起毛笔在纸上写了4个数字。\n";
    tell_object(me, HIC + msg + NOR);
    number = ({});
    for (j = 0; j < 4; j++) {
      i = random(10);
      while (member_array(i, number) != -1) {
        i = random(10);
      }
      number += ({ i });
    }
    me->set_temp("皇帝的笑容/做游戏", 1);
    me->set_temp("皇帝的笑容/数字游戏/剩余次数", 8);
    me->set_temp("皇帝的笑容/要猜测数字", number);
  } else if (arg == "no" || arg == "n") {
    sign = new(__DIR__ "obj/jinpai");
    sign->move(me);
    if (me->query("终极秘密/皇帝的笑容")) {
      msg = "皇帝露出了满意的笑容。高高兴兴的拿着东西去后宫了。\n";
      "不过临走之前给了$N一个免死金牌\n";
      message_vision(HIC + msg + NOR, me);
      return 1;
    }
    gold = new(GOLD_OB);
    gold->set_amount(200);
    if (!gold->move(me));
    gold->move(environment(me));
    command("sigh");
    msg = this_object()->name() + "叹了口气：既然爱卿没有兴趣也罢。\n"
      "这点黄金和免死金牌是是赏赐与你的。你暂且退下吧。\n";
    message_vision(HIC + msg + NOR, me);
    me->delete_temp("皇帝的笑容");  //删除所有有关的暂时记录。
    me->set("终极秘密/皇帝的笑容", 1);  //秘密集合。
  } else {
    msg = "不过我近来刚刚学会了一个小游戏，不知道爱卿有没有兴趣玩呀？\n"
      "请选择(yes/no/y/n)\n";
    tell_object(me, HIC + msg + NOR);
    input_to("decide", me);
  }
  return 1;

}
int give_allow() {
  string msg;
  object me, zhi;
  me = this_player();
  if ((me->query("family/family_name") == "朝廷") && (me->query("rank") == 1)) {
    zhi = new(__DIR__ "obj/zhi");
    zhi->move(me);
    switch (random(5)) {
      case 0:
        me->set_temp("管辖地", "京城");
        break;
      case 1:
        me->set_temp("管辖地", "风云城");
        break;
      case 2:
        me->set_temp("管辖地", "扬州城");
        break;
      case 3:
        me->set_temp("管辖地", "金陵城");
        break;
      case 4:
        me->set_temp("管辖地", "倚云县");
        break;
    }
    this_player()->add("potential", -500);
    zhi->set("owner", this_player()->query("name"));
    zhi->set("long", "特旨:由" + me->query("name") +
      "接管" + me->query_temp("管辖地") + "防务!钦此!\n");
    msg = HIW "皇帝微微点了点头,说道:" + me->query("name") + "接旨!\n" NOR;
    message_vision(msg, me);
    msg = HIY "朕命你暂时接管" + me->query_temp("管辖地") + "之防务!钦此!\n" NOR;
    message_vision(msg, me);
    return 1;
  } else {
    msg = "尔有何资格做封疆大吏!还不退下!\n" NOR;
    message_vision(msg, me);
  }
  return 1;


}
int alert_gaoshou() {
  object gaoshou, me;
  int rank;
  me = this_object();
  rank = me->query("rank");
  if (me->query_temp("havecalled") > 6) return 1;
  //      if( !me->is_fighting() )
  //           return 1;   
  message_vision("$N纵声长啸,呼叫援兵。\n", me);
  me->receive_damage("sen", 20);
  me->add_temp("havecalled", 1);
  seteuid(getuid());
  gaoshou = new("/obj/npc/gaoshou");
  gaoshou->move(environment(me));
  gaoshou->set_temp("apply/damage", 400);
  gaoshou->invocation(me);
  return 1;
}

int accept_object(object me, object obj) {
  string msg;
  object sign;
  if (me->query_temp("皇帝的笑容/得到减肥茶")) {
    if (obj->query("皇帝的笑容/减肥茶")) {
      msg = "$N露出了惊喜的笑容。爱卿终于解除了我的一庄心事了。\n";
      message_vision(HIC + msg + NOR, me);
      if (me->query("终极秘密/皇帝的笑容")) {
        sign = new(__DIR__ "obj/jinpai");
        sign->move(me);
        msg = "这个东西赏赐与你。\n";
        tell_object(me, HIC + msg + NOR);
        me->delete_temp("皇帝的笑容");
        return 1;
      }
      msg = "不过我还有个难题，不知道爱卿能否帮忙解答。\n"
        "请选择(yes/no/y/n)\n";
      tell_object(me, HIC + msg + NOR);
      input_to("decide", me);
      return 1;
    } else return 0;
  } else {
    if (obj->query("皇帝的笑容/减肥茶")) {
      msg = "$N露出了惊喜的笑容。爱卿终于解除了我的一庄心事了。\n";
      message_vision(HIC + msg + NOR, me);
      sign = new(__DIR__ "obj/jinpai");
      sign->move(me);
      msg = "这个东西赏赐与你。\n";
      tell_object(me, HIC + msg + NOR);
      me->delete_temp("皇帝的笑容");
      return 1;
    } else return 0;
  }
  return 0;
}

int ask_me() {
  object me;
  string msg;
  me = this_player();
  msg = "皇上望了$N一眼，似乎有难言之隐。片刻。皇上叹了口气。唉～～～\n"
    "看来皇上难以启齿。\n";
  message_vision(HIC + msg + NOR, me);
  return 1;
}

int ask_game() {
  object me;
  string msg;
  me = this_player();
  msg = get_msg();
  tell_object(me, msg);
  return 1;
}
string get_msg() {
  string msg;
  msg = "我最近学的这个游戏的规则是这样的。你仔细听好了。\n"
    "我首先在纸上写一个" + HIC + FLASH + "没有重复" + NOR + "的四位数。(四个数字分别从0--9之间取值)\n"
    "然后你猜测我写的是什么数字。你有八次机会。每猜测一次。我会给你相\n"
    "关的提示。其中提示中的" + HIM + FLASH + "A" + NOR "表示数字的值和位置都对。\n"
    HIW + FLASH + "B" + NOR + "是表示除了猜对A的数字之外还有别的数字的值猜对了。但是\n"
    "其位置不对。例如：我写的数字是1 2 3 4，你第一次猜测是4 2 0 9。我会\n"
    "给你的提示是" + HIM + FLASH + "1A" + HIW + "1B" + NOR "提示的意思是说你猜测的数字之中\n"
    "有一个数字数值和位置都对了(2)，另外还有一个数字(4)和我写的数字里面\n"
    "某一个数字相等。但是位置不对。明白了吗？\n";
  return msg;
}
