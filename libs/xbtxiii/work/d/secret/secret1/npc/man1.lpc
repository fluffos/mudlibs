// 桃谷六仙 大仙 桃根仙
#include <ansi.h>

inherit NPC;
int ask_me();

void create() {
  set_name("桃根仙", ({ "tao genxian", "genxian" }));
  set("gender", "男性");
  set("age", 42);
  set("str", 50);
  set("long", "\n桃谷六仙老大 桃根仙。此人好酒\n");
  set("combat_exp", 2000000);
  set("attitude", "peaceful");
  set_temp("no_arrest", 1);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("qianye-shou", 200);
  set_skill("shaolin-shenfa", 200);
  set_skill("force", 200);
  set_skill("hunyuan-yiqi", 200);

  map_skill("parry", "qianye-shou");
  map_skill("unarmed", "qianye-shou");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("force", "hunyuan-yiqi");

  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/armor", 50);
  set_temp("apply/damage", 80);

  set("max_kee", 3000);
  set("kee", 3000);
  set("max_gin", 3000);
  set("gin", 3000);
  set("force_factor", 100);
  set("max_force", 4000);
  set("force", 4000);
  set("inquiry", ([
    "千年何首乌": (: ask_me :),
    "何首乌": (: ask_me :),
  ]));

  set("chat_chance", 2);
  set("chat_msg", ({
    "桃根仙悠悠叹了口气。唉～～～ \n",
    "桃根仙说道：要是有女儿红就好了。\n"
  }));


  setup();
  carry_object("/obj/cloth")->wear();
  add_money("gold", 5);
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  remove_call_out("greeting");
  call_out("greeting", 1, ob);
}

void greeting(object ob) {
  set_heart_beat(1);
  return;
}

int ask_me() {
  object me;
  string msg;
  me = this_player();
  if (me->query_temp("皇帝的笑容/得到何首乌")) {
    msg = "你要的东西不是已经给了你了吗？我可没有多的了。\n";
    message_vision(HIC + msg + NOR, me);
    return 1;
  } else {
    if (me->query_temp("皇帝的笑容/邀请进入"))  //得到何首乌之后九会删除
    {
      msg = "呵呵。桃根仙对着$N傻笑了几声。恩。你想得到这个东西吗？\n"
        "不过我总不能白给你吧？你总的表示表示吧？\n";
      message_vision(HIC + msg + NOR, me);
      return 1;
    }
    msg = "桃根仙奇怪的反问$N到：你怎么知道的？想打它的主义啊？没门。\n";
    message_vision(HIC + msg + NOR, me);
    return 1;
  }
}


int accept_object(object me, object ob) {
  object obj;
  string msg;
  if (me->query_temp("皇帝的笑容/邀请进入")) {
    if (ob->query("liquid") && ob->query("name") == "女儿红") {
      obj = new(__DIR__ "obj/heshouwu");
      obj->set("皇帝的笑容/何首乌", 1);
      obj->move(me);
      msg = "桃根仙大喜：呵呵，既然有酒，一切好说。反正我也欠\n"
        "阿拉木罕姑娘一个人情。这个东西我要来也没有用。给你\n"
        "算了。桃根仙给了$N一个" + obj->name() + "\n";
      message_vision(HIC + msg + NOR, me);
      me->delete_temp("皇帝的笑容");
      me->set_temp("皇帝的笑容/得到何首乌", 1);
      return 1;
    } else {
      msg = "呵呵，给我的吗？谢谢。\n";
      message_vision(HIC + msg + NOR, me);
      return 1;
    }
  } else {
    msg = "呵呵，给我的吗？谢谢。\n";
    message_vision(HIC + msg + NOR, me);
    return 1;
  }
}
