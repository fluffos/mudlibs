// 桃谷六仙 三仙 桃枝仙
#include <ansi.h>
#include <combat.h>

inherit NPC;
void create() {
  set_name("桃枝仙", ({ "tao zhixian", "zhixian" }));
  set("gender", "男性");
  set("age", 42);
  set("str", 50);
  set("long", "\n桃谷六仙老三 桃枝仙。\n");
  set("combat_exp", 2000000);
  set("attitude", "peaceful");
  set_temp("no_arrest", 1);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("qianye-shou", 200);
  set_skill("shaolin-shenfa", 200);
  set_skill("force", 200);
  set_skill("hunyuan-yiqi", 200);

  map_skill("parry", "qianye-shou");
  map_skill("unarmed", "qianye-shou");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("force", "hunyuan-yiqi");

  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/armor", 50);
  set_temp("apply/damage", 100);

  set("max_kee", 3000);
  set("kee", 3000);
  set("max_gin", 3000);
  set("gin", 3000);
  set("force_factor", 150);
  set("max_force", 5000);
  set("force", 4000);
  set("inquiry", ([
    "千年何首乌": "哦，那个东西在我大哥那里呢。。\n",
    "何首乌": "哦，那个东西在我大哥那里呢。。\n",
  ]));

  setup();
  carry_object("/obj/cloth")->wear();
  add_money("gold", 5);
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  remove_call_out("greeting");
  call_out("greeting", 1, ob);
}

void greeting(object ob) {}
// 玩家得到千年何首乌准备离开的时候对玩家武功的测试
int test_player(object player) {
  string msg;
  int i, kee;
  if (environment(player) == environment(this_object())) {
    for (i = 0; i < 3; i++)
      COMBAT_D->do_attack(this_object(), player, 0, 0, 0, 0, "no_test_attack");
    kee = player->query("kee");
    if (kee >= 0) {
      msg = "桃干仙哼了一声：算你走运。今天我就放过你。东西你拿走吧。\n";
      message_vision(HIC + msg + NOR, player);
      return 1;
    } else {
      msg = "桃枝仙冷冷的哼了一声。就凭你也想得到这玩意儿？真是自不量力。\n";
      message_vision(HIC + msg + NOR, player);
      return 0;
    }
  }
  return 2;
}
