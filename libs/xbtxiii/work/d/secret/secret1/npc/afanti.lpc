#include <ansi.h>
int ask_me();
inherit NPC;
void create() {
  set_name("阿凡提", ({ "afanti" }));
  set("gender", "男性");
  set("age", 48);
  set("long",
    "他头上包着头巾，长着向上翘的八字胡，最喜欢捉弄巴依、帮助穷人。他常"
    "给别人出谜语。\n");
  set("str", 25);
  set("con", 17);
  set("int", 15);
  set_skill("unarmed", 30);
  set_skill("dodge", 25);
  set_temp("apply/attack", 25);
  set_temp("apply/defense", 25);
  set("combat_exp", 2500);
  set("attitude", "peaceful");
  set("inquiry", ([
    "name": "我就是纳苏尔的阿凡提。",
    "here": "这里可真是个好地方。",
    "纳苏尔": "是我出生的地方。",
    "巴依": "他把我关在这里，有吃有喝，我就不走了。巴依是个坏蛋，愿胡大惩罚他。",
    "毛驴": "我的小毛驴在我到沙漠里骗巴依种金子时走丢了。",
    "驴": (: ask_me :),
    "小毛驴": (: ask_me :),
    "千年何首乌": (: ask_me :),
    "何首乌": (: ask_me :),
    "胡大": "就是真主。又名安拉或阿拉。",
    "真主": "真主至大，万物非主，唯有真主。穆罕默德是真主的使者。",
  ]));

  setup();
  set("chat_chance", 10);
  set("chat_msg", ({
    "阿凡提叹了口气：嗨，可惜我的驴。它去那里了？\n",
  }));
  //        carry_object(__DIR__"obj/wcloth")->wear();
  //         carry_object(__DIR__"obj/dongbula");
}

void init() {
  ::init();
  add_action("do_answer", "answer");
}

int ask_me() {
  object me, book;
  string msg;
  me = this_player();
  if (!me->query_temp("皇帝的笑容/完成阿凡提的任务")) {
    msg = "阿凡提显的有些愁眉苦脸，不太想回答$N的问题。\n";
    message_vision(HIC + msg + NOR, me);
    msg = "看来你想办法取得他的信任。\n";
    tell_object(me, HIC + msg + NOR);
    return 1;
  }
  msg = "我的小毛驴在我到沙漠里骗巴依种金子时走丢了。不过幸亏你帮忙找\n"
    "到了。好的：我立刻回答你的问题。\n";
  message_vision(HIC + msg + NOR, me);
  msg = "阿凡提悄悄告诉你：我知道有个人有千年何首乌。她就住在附近，\n"
    "名字叫阿拉木罕的姑娘，其人既贪玩又贪吃。近来她忽然想做什么武林\n"
    "高手。她托我找武功秘籍，近日我搜索到一本武功秘籍，不知道对她有\n"
    "没有用。我现在托不开身。你帮忙把这本武功秘籍交给她。如果她一高\n"
    "兴。说不定就把千年何首乌给你了。\n";
  tell_object(me, HIC + msg + NOR);
  book = new(__DIR__ "obj/book");
  book->set("皇帝的笑容/给阿拉木罕的书", 1);
  book->move(me);
  me->delete_temp("皇帝的笑容/完成阿凡提的任务");
  me->set_temp("皇帝的笑容/去找阿拉木罕", 1);
  return 1;
}

int accept_object(object me, object ob) {
  string msg;
  object gold;
  if (!me->query_temp("皇帝的笑容/去找阿凡提")) {
    if (ob->query("皇帝的笑容/阿凡提的小毛驴")) {
      msg = "阿凡提高兴的跳了起来。喊道：感谢真主。感谢阿拉。感谢你帮忙\n"
        "找到了我最亲密的伙伴---我的小毛驴。这是一点心意。谢了。\n";
      tell_object(me, HIC + msg + NOR);
      gold = new(GOLD_OB);
      gold->set_amount(1);
      gold->move(me);
      return 1;
    } else return 0;
  }
  if (ob->query("皇帝的笑容")) {
    if (ob->query("皇帝的笑容/阿凡提的小毛驴")) {
      msg = "阿凡提高兴的跳了起来。喊道：感谢真主。感谢阿拉。不过阿凡提\n"
        "立刻沮丧了起来。：我的小毛驴就快要断怎么办？要是没有天山雪\n"
        "莲的叶子它一定没有救了。我该如何是好？你能帮帮我吗？\n";
      tell_object(me, HIC + msg + NOR);
      me->set_temp("皇帝的笑容/给了阿凡提小毛驴", 1);
      return 1;
    } else if (ob->query("皇帝的笑容/天山雪莲的叶子")) {
      if (me->query_temp("皇帝的笑容/给了阿凡提小毛驴")) {
        msg = "阿凡提露出万分感谢的神情对$N说道：感谢你救了我的小毛驴\n"
          "为了感谢你我准备回答你提出的任何问题。只要我知道的。我\n"
          "一定如实回答你。\n";
        tell_object(me, HIC + msg + NOR);
        me->delete_temp("皇帝的笑容/给了阿凡提小毛驴");
        me->delete_temp("皇帝的笑容/给了采药人玉佩");
        me->set_temp("皇帝的笑容/完成阿凡提的任务", 1);
        me->set_temp("皇帝的笑容/去找阿拉木罕", 1);
        return 1;
      } else return notify_fail("我暂时还不需要这个东西。您还是自个用吧。\n");
    } else return 0;
  }

  else return 0;
}
