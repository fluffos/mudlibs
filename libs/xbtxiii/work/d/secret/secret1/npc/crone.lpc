#pragma save_binary
#include <ansi.h>
// crone.c

inherit NPC;
inherit F_VENDOR;
int ask_me();
int decide(string arg, object me);
void create() {
  set_name("乾瘪老太婆", ({ "crone" }));
  set("gender", "女性");
  set("age", 63);
  set("long",
    "这个老太婆怀中抱了个竹篓，似乎在卖什么东西，也许你可以跟她问问\n"
    "价钱？\n");
  set("attitude", "friendly");
  set("inquiry", ([
    "年龄": "老身今年六十有三啦。\n",
    "here": "这一带我可熟了。\n",
    "减肥茶": (: ask_me :),
    "秘方": (: ask_me :),
    "减肥": (: ask_me :),
  ]));

  //        set("where","north");
  set("vendor_goods", ([
    "/d/choyin/npc/obj/amulet": 10,
    "/d/choyin/npc/obj/red_guay": 10,
  ]));
  setup();
}

void init() {
  object me;
  me = this_player();
  ::init();
  add_action("do_vendor_list", "list");
  if (me->query_temp("皇帝的笑容")) {
    remove_call_out("greeting");
    call_out("greeting", 1, me);
    return;
  }
}

int greeting(object me) {
  string msg;
  object tea;
  if (me->query_temp("皇帝的笑容/得到何首乌")) {
    msg = "乾瘪老太婆一看见$N走了进来。连忙笑咪咪的对$N说\n"
      "我说这位" + RANK_D->query_respect(me) + "终于拿到我要的东\n"
      "西了？那就赶快给我，我马上就给您配药。\n";
    message_vision(HIC + msg + NOR, me);
    return 1;
  } else if (me->query_temp("皇帝的笑容/等待拿减肥茶")) {
    msg = "老太婆对$N微笑着：哎呀。我说您这么快就回来了呀？\n"
      "呵呵。您要的东西我已经给你配好了。您拿去吧。\n";
    message_vision(HIC + msg + NOR, me);
    msg = "您得到了减肥茶，胜利在望。加油！\n";
    tell_object(me, HIW + msg + NOR);
    tea = new(__DIR__ "obj/tea");
    tea->move(me);
    me->delete_temp("皇帝的笑容");
    me->set_temp("皇帝的笑容/得到减肥茶", 1);
    return 1;
  } else return 1;
}
int ask_me() {
  string msg;
  object me;
  me = this_player();
  if (!me->query_temp("皇帝的笑容/去找美眉")) {
    msg = "老太婆奇怪的望了望$N，现的非常犹豫。\n";
    message_vision(HIC + msg + NOR, me);
    return 1;
  }
  msg = "老太婆奇怪的问$N:你竟然知道我有这个秘方，那肯定\n"
    "是他告诉你的喽！这么多年了，看来这个死老头还是没\n"
    "忘记我啊！说着说着，老太婆竟然哭了起来！\n"
    "老太婆停止了哭泣，说道：“你想要这个秘方也行，但\n"
    "你要帮我做两件事!\n";
  message_vision(HIC + msg + NOR, me);
  msg = "你同意吗？(yes/y/no/n)\n";
  tell_object(me, msg);
  input_to("decide", me);
  return 1;
}

int decide(string arg, object me) {
  string msg;
  if (!arg) {
    msg = "你道是同不同意啊？(yes/y/no/n)\n";
    tell_object(me, HIC + msg + NOR);
    input_to("decide", me);
    return 1;
  } else if (arg == "yes" || arg == "y") {
    msg = "好，那第一件事就是帮我把康亲王杀了！你不明白吧！\n"
      "当年我和他都是康亲王家里的仆人，那时我和他风华正\n"
      "茂，有一次我洗澡的时候他突然闯了进来，烈火干柴，我\n"
      "就这样献给了他我的第一次！”听到这里，你再看看老太\n"
      "婆那乾瘪的皮肤，突然有种想吐的感觉，呕。。。。。。\n"
      "但老太婆并没注意你的举止，继续说了下去：“谁知这事\n"
      "被康亲王发现了，要把我浸猪笼，我俩便连夜出逃！虽然\n"
      "我逃了出来，但他还是被抓了回去，而且还被阉了送进宫里\n"
      "一切都是康亲王，我一定要报复他，我要你杀了他！并且提\n"
      "他的人头来见我。\n";
    tell_object(me, HIM + msg + NOR);
    me->set_temp("皇帝的笑容/去杀康亲王", 1);
    me->delete_temp("皇帝的笑容/去找美眉");
    return 1;
  } else if (arg == "no" || arg == "n") {
    msg = "既然这样，也就没什么好说的了！还是让神助你吧！\n";
    tell_object(me, HIC + msg + NOR);
    return 1;
  } else {
    msg = "你道是同不同意啊？(yes/y/no/n)\n";
    tell_object(me, HIC + msg + NOR);
    input_to("decide", me);
    return 1;
  }
}

int accept_object(object me, object obj) {
  string msg;
  object jade;
  if (me->query_temp("皇帝的笑容")) {
    if (obj->query("皇帝的笑容/康亲王的人头")) {
      me->delete_temp("皇帝的笑容/去杀康亲王");
      msg = "老太婆狠狠地踢了康亲王的头颅一脚，怒道：“奸贼，\n"
        "你也有今天！真是大快人心！”接着老太婆转过身来对\n"
        "你说：“好，接下来你帮我找药引，药名叫做千年何首\n"
        "乌，你要是没听过，就去找药农问问吧！不过他恐怕不\n"
        "会告诉你。这样吧，既然你帮我报了深仇大恨。这个东\n"
        "我就送与你，你拿着它去天山找一个采药人，他看到这个\n"
        "东西就因该会告诉你的了\n";
      tell_object(me, HIC + msg + NOR);
      jade = new(__DIR__ "obj/jade");
      jade->set("皇帝的笑容/去找采药人", 1);
      jade->move(me);
      msg = "\n你得到了" + jade->name() + "\n";
      tell_object(me, msg);
      return 1;
    } else if (obj->query("皇帝的笑容/何首乌")) {
      msg = "老太婆对$N傻笑了几声:您终于拿到配方了。好的。我这就\n"
        "帮您配药，不过我的这种秘方配起来比较麻烦。要过一段时间\n"
        "才能配好。您还是先出去溜达一圈回来。我配好了就立刻给你\n";
      message_vision(HIC + msg + NOR, me);
      me->delete_temp("皇帝的笑容");
      me->set_temp("皇帝的笑容/等待拿减肥茶", 1);
      return 1;
    } else return 0;
  } else return 0;

}
