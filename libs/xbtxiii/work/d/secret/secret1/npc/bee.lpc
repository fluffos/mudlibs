//bee.c

inherit NPC;
void create() {
  set_name("蜜蜂", ({ "bee" }));
  set("race", "野兽");
  set("age", 8);
  set("long", "这是一只蜜蜂，正忙着采蜜。\n");

  set("str", 10);
  set("limbs", ({ "头部", "身体", "翅膀", "尾巴" }));
  set("verbs", ({ "bite", "poke" }));

  set_temp("apply/attack", 33);
  set_temp("apply/armor", 20);


  setup();
}
