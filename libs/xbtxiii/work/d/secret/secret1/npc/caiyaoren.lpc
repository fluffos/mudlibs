#include <ansi.h>
#pragma save_binary
inherit NPC;
int ask_me();
void create()
{
        set_name("采药人", ({ "caiyao ren", "caiyao", "ren" }));
        set("gender", "男性");
        set("age", 30 + random(10));

        set("long", "一个辛苦工作的采药人。\n");
        set("attitude", "friendly");

        set("combat_exp", 1000);
        set("shen_type", 1);

        set_skill("unarmed", 20);
        set_skill("dodge", 20);
        set_skill("hammer", 20);
        set("apply/attack", 15);
        set("apply/defense", 15);
        set("apply/damage", 5);
	set("inquiry",([
	      "千年何首乌": (:ask_me:),
	      "何首乌": (:ask_me:),
	]));
        setup();
        add_money("coin", 50);
//        carry_object(__DIR__"obj/yaochu")->wield();
}

int ask_me()
{
	object me,leaf;
	string msg;
	me=this_player();
if(!me->query_temp("皇帝的笑容/给了采药人玉佩"))
	{
	msg="采药人面有难色。似乎不太想回答$N的问题\n";
	message_vision(msg,me);
	msg="采药人悄悄对你说，你要知道这个问题，除非你想办法让我相信你。\n";
	tell_object(me,HIC+msg+NOR);
	me->set_temp("皇帝的笑容/问了采药人",1);
	return 1;
	}
	msg="本来这里以前有很多的。不过近来少了。不过我的朋友智囊阿凡提\n"
	    "是个万事通。你还是去西域找他问问吧。这个东西给你。他见了这\n"
	    "东西之后自然会回答你的问题了。\n";
	tell_object(me,HIC+msg+NOR);
	msg="采药人边说边给了你几片天山雪莲的叶子。并且告诉你：他正为麻\n"
	    "烦发愁呢，你拿着这个东西给他他肯定会很高兴的。\n";
	tell_object(me,HIC+msg+NOR);
	leaf=new(__DIR__"obj/leaf");
	leaf->move(me);
	return 1;
}

int accept_object(object me,object obj)
{
	string msg;
	object leaf;
if(!me->query_temp("皇帝的笑容/问了采药人")) return 0;

if(obj->query("皇帝的笑容/去找采药人"))
	{
	msg="采药人接过"+obj->name()+"立刻露出惊喜的神色。高兴的叫道：莫非\n"
	    "她同意我的求婚了？太好了。采药人兴奋的对$N说道：太感激你了。如\n"
	    "果你有什么问题的话您就尽管问吧。只要我知道.一定为您解答。\n";
	message_vision(HIC+msg+NOR,me);
	if(me->query_temp("皇帝的笑容/问了采药人"))
	    {
	    msg="采药人忽然对你说：啊哈！您刚才问什么来着？对！对！对！是千年\n"
	       "何首乌的事情啊？您来的实在是不巧啊。这里以前本来是有很多的。\n"
	       "不过近来采的太多。差不多绝种了。你去问问我的好朋友智囊阿凡提\n"	
	       "吧。他是个万事通。住在西域。你拿着这个东西给他。他一定会很高兴\n"
	       "肯定会回答你问题的。\n";
	    tell_object(me,HIC+msg+NOR);
	    leaf=new(__DIR__"obj/leaf");
	    leaf->set("皇帝的笑容/天山雪莲的叶子",1);
	    leaf->move(me);
	    me->set_temp("皇帝的笑容/给了采药人玉佩",1);
	    me->set_temp("皇帝的笑容/去找阿凡提",1);
	    return 1;
	    }
	}
else return 0;
	return 0;
}