#include <ansi.h>
#pragma save_binary
inherit NPC;

int ask_me();

void create() {
  set_name("阿拉木罕", ({ "alamuhan", "ala", "muhan" }));
  set("long", "她身段不肥也不瘦。她的眉毛像弯月，她的眼睛很多情。\n");
  set("title", "牧羊姑娘");
  set("gender", "女性");
  set("age", 17);

  set_skill("unarmed", 20);
  set_skill("dodge", 40);
  set_skill("parry", 20);
  set_skill("whip", 50);

  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/damage", 5);

  set("combat_exp", 5000);
  set("attitude", "friendly");
  set("inquiry", ([
    "姑娘追": (: ask_me :),
    "赛马": (: ask_me :),
    "马": (: ask_me :),
  ]));

  setup();
  //        carry_object(__DIR__"obj/wcloth")->wear();
  //        carry_object(__DIR__"obj/changbian")->wield();
}

int init() {
  ::init();
  add_action("do_enjoy", "enjoy");
}

int ask_me() {
  if ((int)this_player()->query_temp("marks/马")) {
    say(
      "阿拉木罕对" + this_player()->name() + "说：你这孩子怎么老缠着本姑娘。\n");
    return 1;
  } else {
    say(
      "阿拉木罕看了" + this_player()->name() + "一眼，用不太标准的汉话说道：\n"
      "本姑娘在这里的鞭法也小有点儿名气，这位汉族" + RANK_D->query_respect(this_player()) + "\n"
      "想不想和我切搓几下?\n");
    this_player()->set_temp("marks/马1", 1);
    return 1;
  }
}

int accept_fight(object ob) {
  object me;

  me = this_object();

  if (ob->query_temp("marks/马1")) {
    say(ob->name() + "对阿拉木罕说：好吧，那"
      "我就同你切搓几招吧，点到为止。\n");
    remove_call_out("checking");
    call_out("checking", 0, me, ob);
    ob->delete_temp("marks/马1");
    return 1;
  } else
    return 0;
}

int checking(object me, object ob) {

  object horse;
  int my_max_kee, his_max_kee;
  my_max_kee = (int)me->query("max_kee");
  his_max_kee = (int)ob->query("max_kee");

  if (me->is_fighting()) {
    call_out("checking", 1, me, ob);
    return 1;
  }

  if (!present(ob, environment())) return 1;

  if (((int)me->query("kee") * 100 / my_max_kee) <= 50) {
    say(
      "阿拉木罕说：中原武学果然不一般，小女子十分佩服。\n"
      "送你一匹伊犁马略表寸心。\n"
    );
    horse = new("d/xingxiu/npc/obj/horse");
    horse->move(ob);
    ob->set_temp("marks/马", 1);
    message_vision("$N交给$n一匹马。\n", me, ob);
    return 1;
  }
  if (((int)ob->query("kee") * 100 / his_max_kee) < 50) {
    say(
      "阿拉木罕冲着" + ob->name() + "撇了撇嘴，说道：中原武学不过如此。\n"
    );
    message("vision",
      ob->name() + "对阿拉木罕恭恭敬敬地磕了一个头，离开赛马场。\n", environment(ob), ({ ob }));
    ob->move("/d/xingxiu/beijiang");
    message("vision",
      ob->name() + "从赛马场垂头丧气地走回来。\n", environment(ob), ({ ob }));
    return 1;
  }
  return 1;
}

int accept_object(object me, object ob) {
  string msg;
  object tool;
  int i;
  if (me->query_temp("皇帝的笑容/去找阿拉木罕")) {
    if (ob->query("皇帝的笑容/给阿拉木罕的书")) {
      msg = "$N高兴的笑了。对$N说：你怎么知道我要这样的东西呢？\n"
        "啊！对了。该不是那个阿凡提托你给我的吧。$N一听。连\n"
        "点了点头。$N有些不好意思的说：请问小姐是不是有千年\n"
        "何首乌啊？阿拉木罕反问$N：你怎么知道的？该不是又是\n"
        "阿凡提告诉你的吧？这个家伙！不过如果你要是可以给我\n"
        "一把名字叫妖刀狗屠的武器，我或许会考虑和你交换的。\n";
      message_vision(HIC + msg + NOR, me);
      me->delete_temp("皇帝的笑容/给阿拉木的书");
      me->set_temp("皇帝的笑容/去找妖刀狗屠", 1);
      return 1;
    }
    if (me->query_temp("皇帝的笑容/去找妖刀狗屠")) {
      if (ob->query("id") == "houndbane blade"
        && ob->query("material") == "crimsonsteel") {
        if (me->query("gender") == "男性") {
          msg = "阿拉木罕高兴得象个小孩子般蹦蹦跳跳：“真感激你啊！可是\n"
            "我要告诉你一件事你可千万别恼我，我其实一直都在利用你，\n"
            "我的何首乌一年前就吃了。我没什么东西给你，就只有这样报\n"
            "答你了。”阿拉木罕缓缓的靠在你身上，你感觉到阿拉木罕高\n"
            "耸而富有弹性的胸部，销魂的感觉从内心深处升起！\n"
            "enjoy吗？(yes/y/no/n)\n";
          tell_object(me, HIC + msg + NOR);
          me->set_temp("皇帝的笑容/接受阿拉木罕的挑逗", 1);
          input_to("do_enjoy", me);
          return 1;
        } else {
          msg = "阿拉木罕高兴得象个小孩子般蹦蹦跳跳：“真感激你啊！可是\n"
            "我要告诉你一件事你可千万别恼我，我其实一直都在利用你，\n"
            "我的何首乌一年前就吃了。不过我知道桃谷六仙他们有，年他\n"
            "们还欠我一个人情。你去找他们，他们可能会帮你的。他们现\n"
            "在住在雪山的圣湖湖底。这个东西给你。可能会对你有所帮助。\n";
          message_vision(HIC + msg + NOR, me);
          tool = new(__DIR__ "obj/shuikao");
          if (!tool->move(me))
            tool->move(environment(me));
          msg = "阿拉木罕给$N一个" + tool->name() + "。\n";
          message_vision(msg, me);
          i = random(10) + 1;
          msg = "对了，还忘了告诉你。他们通常不见外人。所以要有暗号\n"
            "他们会问你一些莫名其妙的问题。不过只要记住这个数字\n"
            "就行了。阿拉木罕悄悄告诉你：这个数字是" + i + "\n";
          tell_object(me, HIC + msg + NOR);
          me->set_temp("皇帝的笑容/桃谷六仙的暗号", i);
          return 1;
        }
      }
    }
  } else {
    msg = "阿拉木罕高兴的笑道：给我的吗？谢谢\n";
    message_vision(HIC + msg + NOR, me);
    return 1;
  }
}

int do_enjoy(string arg, object me) {
  string msg;
  object tool;
  int i;
  me = this_player();
  if (!arg) {
    msg = "你还犹豫什么？想就(yes/y)不想就(no/n).\n";
    tell_object(me, HIC + msg + NOR);
    input_to("do_enjoy", me);
    return 1;
  } else if (arg == "yes" || arg == "y") {
    msg = "$N冲上前去就要动手动脚。\n\n"
      "阿拉木罕脸色大变：“你果然不是什么好东西.\n"
      "死汉狗，看招。\n";
    message_vision(HIC + msg + NOR, me);
    this_object()->kill_ob(me);
    return 1;
  } else if (arg == "no" || arg == "n") {
    msg = "阿拉木罕停止了动作，瞪大了眼睛看着$N，“我还\n"
      "以为汉人都是坏人，看来汉人中也有英雄！虽然我的\n"
      "千年何首乌已经吃掉了。不过我知道桃谷六仙还有一颗\n"
      "当年他们还欠我一个人情。你去找他们，他们可能会帮\n"
      "你的。他们现在住在雪山的圣湖湖底。这个东西给你。\n"
      "可能会对你有所帮助。\n";
    message_vision(HIC + msg + NOR, me);
    tool = new(__DIR__ "obj/shuikao");
    if (!tool->move(me))
      tool->move(environment(me));
    msg = "阿拉木罕给$N一个" + tool->name() + "。\n";
    message_vision(msg, me);
    i = random(10) + 1;
    msg = "对了，还忘了告诉你。他们通常不见外人。所以要有暗号\n"
      "他们会问你一些莫名其妙的问题。不过只要记住这个数字\n"
      "就行了。阿拉木罕悄悄告诉你：这个数字是" + i + "\n";
    tell_object(me, HIC + msg + NOR);
    me->set_temp("皇帝的笑容/桃谷六仙的暗号", i);
    return 1;
  } else {
    msg = "你还犹豫什么？想就(yes/y)不想就(no/n).\n";
    tell_object(me, HIC + msg + NOR);
    input_to("do_enjoy", me);
    return 1;
  }

}
