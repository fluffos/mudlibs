inherit ITEM;
void create()
{
        set_name("康亲王的脑袋", ({ "head",}) );
        set_weight(100);
        if( clonep() )
        set_default_object(__FILE__);
        else {  set("long", "康亲王的脑袋。\n");
                set("value", 1);
                set("unit", "颗");
	        set("皇帝的笑容/康亲王的人头",1);
        }
        setup();
}
