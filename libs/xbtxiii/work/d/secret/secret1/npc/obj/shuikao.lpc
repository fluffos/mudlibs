#pragma save_binary
// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>
inherit CLOTH;
void create() {
  set_name("水靠", ({ "shuikao" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 50000);
    set("unit", "副");
    set("material", "cloth");
    set("armor_prop/armor", 20);
    set("皇帝的笑容/水靠", 1);
  }
  setup();
}
