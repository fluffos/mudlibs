#include <armor.h>
inherit CLOTH;
void create()
{
        set_name("九龙袍", ({ "robe",}) );
        set_weight(100);
        if( clonep() )
        set_default_object(__FILE__);
        else {  set("long", "这是当今圣上最喜爱的一件龙袍。\n");
                set("value", 1000000);
                set("unit", "件");
                set("material", "silk");
                set("armor_prop/armor", 120);
        }
        setup();
}
