#pragma save_binary
// 千年何首乌

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("千年何首乌", ({"he shou wu"}));
	set_weight(80);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一个何首乌。已经像个人型了。看来不是凡物。\n");
		set("unit", "个");
		set("value", 50000);
		set("food_remaining", 5);
		set("food_supply", 20);
	}
}
