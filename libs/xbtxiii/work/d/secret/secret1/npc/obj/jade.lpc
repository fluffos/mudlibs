#include <armor.h>
inherit HEAD;
void create() {
  set_name("玉佩", ({ "jade", }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一块玉佩，很显然是某人的定情信物。\n");
    set("value", 10000);
    set("unit", "块");
    set("皇帝的笑容/玉佩", 1);
    set("wear_msg", "$N将$n戴在耳朵上面。\n");
  }
  setup();
}
