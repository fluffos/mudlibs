#include <weapon.h>
inherit SWORD;
void create()
{       
        set_name("龙泉宝剑", ({ "sword" }) );
        set_weight(100);
        if( clonep() )
        set_default_object(__FILE__);
        else {          set("unit", "把");
        set("long", "这是当今圣上最喜爱的一把宝剑。\n");
        set("value", 1000000);
        set("material", "steel");
        set("wield_msg", "$N从剑鞘中抽出一把闪闪发光的$n握在手中。\n");
        set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
            }
        init_sword(120);
        setup();
}
