// red_dragon.c

inherit NPC;

void create() {
  set_name("红鳞火龙", ({ "firedragon", "dragon" }));
  set("long",
    "一只浑身长满红鳞的龙，\n");

  set("race", "野兽");
  set("age", 600);
  set("attitude", "aggressive");
  //       set("shen_type",-1);

  set_weight(60000);
  set("max_gin", 2000);
  set("max_kee", 2000);
  set("max_sen", 1200);

  set("str", 30);
  set("cor", 200);
  set("cps", 30);
  set("spi", 70);
  set("int", 20);
  set("limbs", ({ "头部", "身体", "前爪", "後爪", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set_temp("apply/attack", 150);
  set_temp("apply/dodge", 180);
  set_temp("apply/armor", 50);
  set_temp("apply/damage", 35);
  set_temp("apply/armor_vs_fire", 40);
  set("combat_exp", 1200000);
  setup();
}
void die() {
  object *players;
  int i;
  players = all_inventory(environment(this_object()));
  for (i = 0; i < sizeof(players); ++i) {
    players[i]->add("fealty", 80);
  }

  ::die();
}
