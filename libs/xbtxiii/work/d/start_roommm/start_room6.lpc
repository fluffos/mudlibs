#pragma save_binary
// start_room2.c 泥巴教程二 
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short",CYN"时空通道"NOR);
	set("long",
"四周放射着柔和的光芒，显得那么宁静。你和[1;35m蓝手指[2;\n"
"37;0m漫步前行。不知不觉来到了一个小小的客栈。\n"
);
	set("exits",([
		    "southwest"  :  __DIR__"start_room",
	]));
        set("objects", ([
                      "/d/fy/npc/teawaiter" : 1,
                        ]));
	set("room",4);
	set("no_fight",1);
        set_temp("light",1);
	set("no_magic",1);
	setup();
  
}



int valid_leave(object me,string dir)
{
	me->start_busy(2);
	return 1;
}
 
