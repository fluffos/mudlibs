#pragma save_binary
// start_room2.c 泥巴教程四
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", CYN "时空通道" NOR);
  set("long",
    "四周放射着柔和的光芒，显得那么宁静。你和[1;35m蓝手指[2;\n"
    "37;0m漫步前行。前面的道路似乎还很漫长，没有尽头。但是你\n"
    "希望就这样一直走下去，永没有尽头,但是前面出现了一丝亮光，\n"
    "就快要到尽头了。\n"
  );
  set("exits", ([
    "southeast": __DIR__ "start_room6",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set_temp("light", 1);
  set("room", 3);  //只是对__DIR__"npc/teacher"有用
  setup();

}

int valid_leave(object me, string dir) {
  me->start_busy(2);
  return 1;
}
