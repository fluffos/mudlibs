#pragma save_binary
// start_room1.c 泥巴教程 
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short",CYN"时空通道"NOR);
	set("long",
"这里是泥巴的时空通道，如果你出现在这里，说明你可能还是一\n"
"名新手。因此，非常有必要提供一些教程，帮助你对泥巴有所认\n"
"识。下面我们就开始我们的旅行吧。首先我们先熟悉一些最基本\n"
"的命令。例如:[36mgo[2;37;0m不言而喻[36mgo[2;37;0m的\n"
"意思就是走路。通常你会在你的屏幕的最下面一行看到类似的这\n"
"样一句话:[36m这里明显的出口是west、east、south和north。\n"
"[2;37;0m当你键入[36mgosouth或者south或者直接键入s[2;3\n"
"7;0m时，你就会朝南方走去。好吧，请你键入[36mgosouth或者\n"
"south或者直接键入s[2;37;0m离开这里，继续我们的旅程;你也\n"
"可以向下直接到泥巴世界的入口\n"
);
	set("no_fight",1);
        set_temp("light",1);
	set("no_magic",1);
	set("exits",([
                   "down" :"/d/start_room/start_room",
                     "south"  :  __DIR__"start_room2",
	]));
	setup();
  
}

 
void init()
{
  object user,silver;
  user=this_player();
  if(user->query_temp("apply/armor"))return ;
    if(user->query("gender")=="女性"){
      silver=new("/obj/skirt");
      silver->move(user);
      silver->wear();
      silver=new("/obj/shoe");
      silver->move(user);
      silver->wear();
    } else {
      silver=new("/obj/cloth");
      silver->move(user);
      silver->wear();
    }

}
