#pragma save_binary
// start_room.c 世界入口 
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", CYN "泥巴世界的入口" NOR);
  set("long",
    "这里是通向泥巴世界各地的入口。一台巨大的空间传送器竖立在\n"
    "你的面前。它可以将你传送到世界各地。如果你想立刻拜师，那\n"
    "么可以选择相应的入口，空间传送器可以立即将你传送到相应的\n"
    "师傅面前。如果你想先熟悉一下环境可以选择1入口。空间传送\n"
    "器回将你传送到风云城最出名的客栈---有一间客栈。1有一间客\n"
    "栈2官府3丐帮4晚月庄5雪山派6封山派7茅山派8华山派9武当派10\n"
    "天邪派11少林寺12星宿派13逍遥\n"
  );
  set("no_fight", 1);
  set("no_magic", 1);
  set_temp("light", 1);
  set("room", 5);  //只是对__DIR__"npc/teacher"有用
  set("exits", ([
    "1": "/d/fy/fqkhotel",
    "2": "/d/chaoting/xianya/cloudy_xianya",
    "3": "/d/yangzhou/pomiao",
    "4": "/d/latemoon/latemoon1",
    "5": "/d/xueshan/guangchang",
    "6": "/d/ny/schoolhall",
    "7": "/d/temple/temple1",
    "8": "/d/huashan/buwei1",
    "9": "/d/wudang/sanqingdian",
    "10": "/daemon/class/fighter/guildhall",
    "11": "/d/shaolin/guangchang1",
    "12": "/d/xingxiu/riyuedong",
    "13": "/d/xiaoyao/qingcaop",
  ]));
  setup();

}

void init() {
  object me, book, bag, *ob;
  int s, cardd, bagg;
  cardd = 0, bagg = 0;
  me = this_player();
  me->set("startroom", "/d/fy/fqkhotel");
  ob = all_inventory(me);
  s = sizeof(ob);
  while (s--) {
    if (!stringp(ob[s]->query("id"))) continue;
    if (ob[s]->query("id") == "account card") {
      cardd = 1;
    }
    if (ob[s]->query("id") == "qiankun bag") {
      bagg = 1;
    }
    if (cardd != 0 && bagg != 0) return;
  }
  if (cardd == 0) {
    book = new("/obj/a_book.lpc");
    book->set("master_id", me->query("id"));
    if (file_size(book->query_save_file() + ".o") > 0) book->restore();
    else book->set("rich", 0);
    book->move(me);
    book->save();
  }
  if (bagg == 0) {
    bag = new("/obj/superbag.lpc");
    bag->set("master_id", me->query("id"));
    if (file_size(bag->query_save_file() + ".o") > 0) bag->restore();
    else bag->set("notes", ({ /* sizeof() == 5 */
      ([ /* sizeof() == 3 */
        "amount": "0",
        "title": "钢刀",
        "msg": "/obj/weapon/blade",
      ]),
      ([ /* sizeof() == 3 */
        "amount": "0",
        "title": "长剑",
        "msg": "/obj/weapon/sword",
      ]),
      ([ /* sizeof() == 3 */
        "amount": "0",
        "title": "长鞭",
        "msg": "/obj/weapon/whip",
      ]),
      ([ /* sizeof() == 3 */
        "amount": "0",
        "title": "杖",
        "msg": "/obj/weapon/staff",
      ]),
      ([ /* sizeof() == 3 */
        "amount": "0",
        "title": "长枪",
        "msg": "/obj/weapon/spear",
      ]), }));
    bag->move(me);
    bag->save();
  }
  tell_object(me, "蓝手指给你了一个金龙卡和一个乾坤袋\n"
    "乾坤袋里面放了些东西。可以(checkbag)查看\n");
  return;
}
