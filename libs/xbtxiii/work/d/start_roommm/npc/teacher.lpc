#pragma save_binary
inherit NPC;
#include <ansi.h>
int do_buy(string);
int do_say(string);
int do_help(string);
int do_emote();
void create()
{
        set_name(HIM"蓝手指"NOR, ({ "blue_girl"}) );
        set("title",HIM "温柔体贴"NOR);
        set("gender", "女性" );
        set("age", 20);
        set("per",60);
        set("long", "蓝手指不仅容貌娇好，而且心地非常善良。热心助人。\n"
                    "让人着实喜欢。\n");
        set("combat_exp", 500);
        setup();
        carry_object("/obj/cloth")->wear();
}

int do_say(string arg)
{
        object me;
        me=this_player();
command("say hi");
        "/cmds/std/say"->main(me,arg);
        tell_object(me,HIM"蓝手指惊讶的望着你，脸上露出钦佩的神色说：你好聪明啊！！！一教就会。\n"NOR);
        remove_action("do_say","say");
        return 1;
}

int do_emote()
{
        object me;
        me=this_player();
if(query_verb()=="kiss"&&me->query("gender")=="男性")
        {
        tell_object(me,HIM"蓝手指的脸色绯红，蓝手指羞涩的说道：你好坏啊！\n"NOR);
        remove_action("do_emote","?");
        remove_action("do_emote","hehe");
        remove_action("do_emote","hi");
        remove_action("do_emote","kiss");
        }
else
        {
        tell_object(me,HIM"蓝手指脸上露出无限钦佩的神色说：你实在是太聪明了！！！\n"NOR);
        remove_action("do_emote","?");
        remove_action("do_emote","hehe");
        remove_action("do_emote","hi");
        remove_action("do_emote","kiss");
        }
        return 0;
}

int do_help(string arg)
{
        object me;
        me=this_player();
        "cmds/usr/help"->main(me,arg);
if(me->query("gender")=="男性")
        tell_object(me,HIM"蓝手指在你的耳边悄声说道：你好聪明啊！我喜欢你。\n"NOR);
else if(me->query("gender")=="女性")
        tell_object(me,HIM"蓝手指在你的耳边悄声说道：妹妹你好聪明啊！\n"NOR);
else
        tell_object(HIM"你实在是聪明绝顶！！！\n"NOR);
        remove_action("do_help","help");
        return 1;
}


int do_buy(string arg)
{
        object me;
        me=this_player();
        "cmds/std/buy"->main(me,arg);
if(me->query("gender")=="男性")
        tell_object(me,HIM"\n蓝手指轻轻吻了你一下。脸色绯红的对你说：你实在是聪明绝顶\n"NOR);
else if(me->query("gender")=="女性")
        tell_object(me,HIM"妹妹，我佩服你的不得了耶。。。。\n"NOR);
else
        tell_object(me,HIM"我佩服你的不得了耶。。。。\n"NOR);
        remove_action("do_buy","buy");
        return 1;
}
void message1(object me)
{
        string name=this_object()->name();
        tell_object(me,""+name+""HIM"温柔的对你说道：新手玩泥巴首先要熟悉基本的命令。\n"
              "下面是一些基本的聊天命令例如"NOR""CYN"say、tell、 whisper等等"NOR"\n"
           ""HIM"假如你键入"NOR""CYN"say 我是一名新手。"NOR""HIM"我就可以看见下面的话:""\n"NOR
           CYN""+me->name()+"说道:我是一名新手。\n"NOR);
        add_action("do_say","say");
}

void message2(object me)
{
        string name=this_object()->name();
        remove_action("do_say","say");
        tell_object(me,""+name+""HIM"继续温柔的对你说道：除了基本的聊天命令，还有另外一种指令"NOR"\n"
              ""HIM"我们称之为表情指令。例如"NOR""CYN"？、hehe、hi等等"NOR"。"HIM"用semote命令可以列出所有的emote。"NOR"\n"
              ""HIM"例如我键入"NOR""CYN"hehe"NOR" "HIM"你就可以看到"NOR""CYN"蓝手指傻傻的笑了两声：嘿嘿。。。: "NOR"\n"
              ""HIM"假如我键入"NOR""CYN"chat* hehe"NOR""HIM"这个世界的所有人就可以看到蓝手指傻傻的笑了两声：嘿嘿。"NOR"\n");
        me->start_busy(0);
        add_action("do_emote",({"?","hehe","hi","kiss"}));
        return;
}

void message3(object me)
{
        string name=this_object()->name();
        remove_action("do_emote","?");
        remove_action("do_emote","hehe");
        remove_action("do_emote","hi");
        remove_action("do_emote","kiss");
        tell_object(me,""+name+""HIM"继续温柔的对你说道：作为一名新手，应该经常使用"NOR""CYN"help"NOR""HIM"命令"NOR"\n"
              ""HIM"例如你键入"NOR""CYN"help"NOR""HIM"就可以得到更多的帮助。"NOR"\n"
              ""HIM"例如你键入"NOR""CYN"help cmds"NOR""HIM"就立即可以获得所有命令的帮助"NOR"\n");
        add_action("do_help","help");
        me->start_busy(0);
        return;
}


void message4(object me)
{
        object food;
        string name=this_object()->name();
        remove_action("do_help","help");
        tell_object(me,""+name+""HIM"说道：走了这么远的路，好累啊。我们在这间客栈歇息一下吧""\n"
                ""+name+""HIM"边说边擦了擦香汗。我们吃点东西再走吧。\n"
                "容不得你说话，"NOR""+name+""HIM"已经向店小二买了些吃的。喝的。"NOR"\n");
        food=new("/obj/example/teapot");
        food->move(this_object());
        food=new("/obj/example/chicken_leg");
        food->move(this_object());
        food=new("/obj/example/teapot");
        food->move(me);
        food=new("/obj/example/chicken_leg");
        food->move(me);

        tell_object(me,"\n"+name+"向店小二买了两碗茶和两个鸡腿。\n"
              ""+name+"给你了一碗茶和一个鸡腿。\n\n");
        me->start_busy(2);
        call_out("message6",1,me);
        return;
}


void message5(object me)
{
        object snot_rag;
        string name=this_object()->name();
        remove_action("do_buy","buy");
        command("sigh");
        tell_object(me,""+name+""HIM"露处淡淡的忧愁：小女子只能够送到这里了。""\n"
                "你还有什么不明白的地方可以向老玩家求教。切记。。切记。。\n\n"NOR
                ""+name+""CYN"幽幽道：有缘千里来相会，无缘对面不相识。\n"
                "小女子今天能够认识你，也是我的福分。我们有缘再见吧。\n"
                "这个手绢送给你。愿你珍重。。。\n"NOR);
        snot_rag=new(__DIR__"snot-rag");
        snot_rag->move(me);
        tell_object(me,""+name+"给你一个"+snot_rag->name()+"\n");
        tell_object(me,CYN"蓝手指依依不舍的离开了你。。。。。\n\n"
                 "你不禁唉～　　～　　～　　　\n"NOR);
        me->start_busy(0);
        destruct(this_object());
}


void message6(object me)
{
        string name=this_object()->name();
        tell_object(me,""+name+""HIM"边吃边说：所有的客栈和店铺都有东西卖。你可以用命令"NOR""CYN"list"NOR"\n"
              ""HIM"列出所有出售的货物。用"NOR""CYN"buy <某物> from <某人>"NOR""HIM"购买货物。"NOR"\n\n"
              ""+name+""HIM"吃完了东西，对你说：我们走吧。。。就快要到出口了\n\n"NOR);
        add_action("do_buy","buy");
        me->start_busy(0);
        return;
}
void dest_it()
{
        destruct(this_object());
}

void init()
{
        object me,room;
        me=this_player();
if(me==query("teach"))
        {
        room=environment(me);
        call_out("defer",2,me,room);
        }
}

void defer(object me,object room)
{
switch(room->query("room"))
        {
        case 1:
                this_object()->message1(me);
        break;
        case 2:
                this_object()->message2(me);
        break;
        case 3:
                this_object()->message3(me);
        break;
        case 4:
                this_object()->message4(me);
        break;
        case 5:
                 this_object()->message5(me);
        break;
        case 6:
                ;
        break;
        default:
                this_object()->dest_it(me);
        break;
        }
}

void greeting(object me) //由她所处的房间呼叫
{
        tell_object(me,CYN"蓝手指一见你进来，立刻迎了上来。仔细的将你打量了一翻。\n"
                 "蓝手指羞涩的笑道:原来你就是主人的贵客啊，主人吩咐过我。\n"
                 "后面的旅程由我来陪着你。我们还是边走边说吧。蓝手指说完话\n"
                 "一双明亮的大眼睛闪烁着望着你。\n"NOR);
}

