#pragma save_binary
// japanese.c
#include <ansi.h>
inherit NPC;
void create()
{       int i,c; 
        set_name("倭寇", ({ "japanese", }) );
        set("title",HIR"丧尽天良的强盗"NOR);
        set("long", "见人就杀，无恶不作的强盗！！\n");
        set("attitude", "aggressive");
        set("rank_info/respect","强盗");
        set("gender","男性");
        set("max_gin", 400);
        set("max_kee", 400);
        set("max_sen", 400);
        set("age",20+random(30));
        set("max_atman", 10000);
        set("atman", 10000);
        set("max_mana", 5000);
        set("mana", 5000);
        set("force",200);
        set("max_force",200);
        set("force_factor",random(3));
        set("per", 5);
        set("int", random(50)+10);
        set("spi", random(50)+10);
        set("str", random(30)+10);
        set("cor", random(50)+10);
        set("cps", random(50)+20);
        set("bellicosity",500+random(1000));
        set("combat_exp", 100+random(20000*sizeof(users())));

        set("chat_chance", 1);
        set("chat_msg_combat", ({
                name() + "喝道！八格亚路！！。。。\n"
        }) );
        set_skill("unarmed",20+random(2*sizeof(users())));
        set_skill("dodge",20+random(2*sizeof(users())));
        set_skill("parry",20+random(2*sizeof(users())));
        set_skill("sword",20+random(2*sizeof(users())));
        set_skill("blade",20+random(2*sizeof(users())));
        set_skill("dagger",20+random(2*sizeof(users())));
        set_skill("hammer",20+random(2*sizeof(users())));
        set_skill("whip",20+random(2*sizeof(users())));
        set_skill("staff",20+random(2*sizeof(users())));
        set_skill("axe",20+random(2*sizeof(users())));
        set_skill("force",20+random(2*sizeof(users())));
        setup();
        carry_object("/obj/cloth")->wear();
        c=random(8);
        switch (c)
        {
        case 0: break;
        case 1: carry_object("obj/weapon/dagger")->wield();break;
        case 2: carry_object("obj/weapon/longsword")->wield();break;
        case 3: carry_object("obj/weapon/blade")->wield();break;
        case 4: carry_object("obj/weapon/whip")->wield();break;
        case 5: carry_object("obj/weapon/stick")->wield();break;
        case 6: carry_object("obj/weapon/sixhammer")->wield();break;
        case 7: {
                for(i=0;i<20;i++) carry_object("obj/weapon/dart")->wield();
                break;
                }
        }
        add_money("silver",random(700)); 
}

void die()
{
 	object ob,map;
	if(random(5)==0) {
	map = new("/d/chaoting/jjf/obj/map1.lpc");//关于朝廷的七张地图的秘密
	map->move(this_object());
	}
 	if (objectp(ob = query_temp("last_damage_from"))&&random(10)>8){
 	 ob->add("fealty",20);
        ob->set_explore("north#7");
	}
	::die();
}
