#pragma save_binary
inherit ITEM;

int seteuid();
void create() {
  set_name("虎头兵符", ({ "bingfu" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");

    set("long", "有了这块兵符你才能，调动官兵！\n");

    set("value", 0);
    set("material", "copper");
  }
}
