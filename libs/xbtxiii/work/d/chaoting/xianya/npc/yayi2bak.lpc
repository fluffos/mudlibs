#pragma save_binary
// judge_guard.c
int back_home(string arg);

inherit NPC;

void create() {
  set_name("衙役", ({ "yayi" }));
  set("gender", "男性");
  set("shen_type", 1);
  set("age", 34);
  set("str", 18);
  set("cor", 18);
  set("cps", 21);
  set("int", 25);
  set("per", 27);
  set("long", @LONG
衙役是负责保护四五品官的,手底都很硬，没事最好别惹他们，
LONG
  );
  set("vendetta_mark", "officer");
  set("combat_exp", 50000);
  set("max_force", 300);
  set("force", 300);
  set("force_factor", 5);

  set("inquiry", ([
    "回去": (: back_home :),
    "滚": (: back_home :), ]));



  set("attitude", "heroism");
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "衙役说道：你当这里是什么地方，敢来这里骚扰？\n",
    "衙役说道：你要是再无理取闹，当心捕头把你抓去坐牢!\n",
    "衙役手中的刀越砍越快，让你应接不暇。\n",
    "衙役说道：衙门岂是你放肆的地方？！\n"
  }));

  set_skill("staff", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("move", 1000);

  set_skill("chaos-steps", 80);

  map_skill("dodge", "chaos-steps");

  setup();

  carry_object(__DIR__ "obj/stick")->wield();
  carry_object(__DIR__ "obj/cloth")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if ((string)ob->query("family/family_name") == "朝廷")
    if (ob->query_temp("follow") == 0)
      if (objectp(query_temp("followsb"))) {
        if (ob->query("rank") >= query_temp("followsb")->query("rank")
          || ob->query("rank") < 5 && ob->query("rank") > 4)
          return;
        set_leader(ob);
        command("protect " + ob->query("id"));
        query_temp("followsb")->set_temp("follow", 0);
        ob->set_temp("follow", 1);
        set_temp("followsb", ob);
      }
  if ((string)ob->query("family/family_name") == "朝廷")
    if (ob->query_temp("follow") == 0)
      if (!objectp(query_temp("followsb")))
        if (ob->query("rank") >= 6) {
          set_leader(ob);
          command("protect " + ob->query("id"));
          ob->set_temp("follow", 1);
          set_temp("followsb", ob);
        }
}
void die() {
  object map;
  if (objectp(query_temp("followsb")))
    query_temp("followsb")->add_temp("follow", -1);
  map = new("/open/tony/jjf/obj/map8.lpc");
  map->move(this_object());

  ::die();
}


int back_home(string arg) {
  if (this_player() != query_temp("followsb"))
    return 0;
  command("say 是!大人!");
  command("protect none");
  set_leader(0);
  query_temp("followsb")->set_temp("follow", 0);
  delete_temp("followsb");
  tell_room(environment(), name() + "急急忙忙回去了！\n");
  this_object()->move(this_object()->query("startroom"));
  return 1;
}
