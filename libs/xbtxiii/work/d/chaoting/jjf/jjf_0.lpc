#pragma save_binary
// /d/city/xiangguo/gate

inherit ROOM;

void create()
{
       set("coor",({100,2900,0}));
	set("short", "将军府大门");
        set("long", @LONG
你来到将军府的大门处。就会感到大将军在朝中的显赫地位,虽与
对面尚书府比起来，将军的府第显得有些寒酸,另但又有一种威严,令人
不寒而慑.府门正中牌匾上书六个大字「辅国大将军府」.
LONG
        );

        set("exits", ([
                   "north":       __DIR__"jjf_1",
                     "west":         "/d/city/newstreet4",
                ]));
     set("objects", ([ /* sizeof() == 1 */
      __DIR__"npc/jin_jun":  4,
]));
        set("outdoors", "city");

set_temp("light",1);
        setup();
}

int valid_leave(object me, string dir)
{
         object ob;
     int myrank;
  ob=this_player();
  myrank = this_player()->query("rank");
if((((string)ob->query("family/family_name") != "朝廷") 
|| (myrank>5))
&& dir == "north"
&& objectp(present("jin jun", environment(me))))
     return                    notify_fail("禁军喝道:朝廷五品官以下,不得入内!\n");
        return ::valid_leave(me, dir);
}
