#pragma save_binary
// Room: /open/tony/jjf/jjf_2.c
inherit ROOM;

void create()
{
    set("coor",({90,2940,0}));
	set("short", "西厢房");
        set("long", @LONG
屋内空空如野，连一张椅子都没有，会给人一种怪异的感觉,地板
好象有点儿潮湿。好象，这儿是完全不属将军府的另一个世界．
LONG
        );
     set("exits", ([ /* sizeof() == 1 */
"east" : __DIR__"jjf_4",
]));
        set("objects", ([ /* sizeof() == 0 */
                       
          __DIR__"jin_wei":  0,
]));
        set("no_clean_up", 0);

        setup();
}

void init()
{
        add_action("do_qiao", "qiao");
}
int do_qiao(string arg)
{
        object me, ob, weapon;
        me = this_player();

        if( !arg || arg!="地板" ) 
                return notify_fail("你要撬什么？\n");
                {
                if (!objectp(weapon = me->query_temp("weapon")))
                        return notify_fail("不用家伙恐怕不行吧！\n");
                message_vision("$N拔出兵刃，将一块地板撬起。\n",me);
              message("vision","下面出现一个密道! \n", environment(me));
                me->set_temp("marks/撬",1); 
               set("exits/down", __DIR__"secret_room");
                call_out("close_passage", 10);
                return 1;       
        }
        }


void close_passage()
{
        object room;

        if( !query("exits/down") ) return;
        message("vision", 
"地板忽然发出轧轧的声音，将向下的通道盖住了。\n",
                this_object() );
delete("exits/down");
}
