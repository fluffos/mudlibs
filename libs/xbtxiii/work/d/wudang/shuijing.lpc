#pragma save_binary
// Room: /city/chaguan.c
// YZC 1995/12/04 
//arnzh 97/1/23
#include <ansi.h>
inherit ROOM;

void create()
{
	set("coor",({-650,-900,2000}));
	set("short", "磨针井");
	set("long",
"你一走进来，就感到一阵凉意沁入心脾，精神为之一爽。地上坐\n"
"了几个客人，或高声谈笑，或交头接耳。中间有一口井，来往的\n"
"人，都在这里休息一下，装一些水。\n"
);
	set("resource/water", 1);

	set("exits", ([
		"east" : __DIR__"haohan",
	]));

	setup();
}

int init()
{
	add_action("do_dive",({"dive","跳","jump"}));
}


int do_dive(string arg)
{
	object me;
	me=this_player();
	if(!arg||!(arg=="井"||arg=="down"))	
	    return notify_fail("你要往那里跳呀？\n");
	message_vision("$N傻乎乎的朝井里跳了下去\n",me);
	me->move(__DIR__"jing");
	tell_object(me,HIR"直觉告诉你。此地不可久留。还是赶快离开为妙。\n"NOR);
	return 1;
}