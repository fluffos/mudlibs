inherit ROOM;

void create()
{
	set("coor",({-600,-840,2500}));
	set("short", "太子坡");
	set("long",
"在你的面前是一座高大的石坊，上面写着“玄武门”三个镏金大\n"
"字，由于年代久远，久经日晒雨淋，已经显得有些黯淡。再往上\n"
"是一间小吃店，此时已有几个人在吃饭或休息，往下则是一条石\n"
"阶路一直通到山下，西边是一座五层的道观，却是油漆新鲜，显\n"
"是刚建成不久。\n"
);
        set("outdoors", "wudang");

	set("exits", ([
                "west":__DIR__"fuzhen1",
		"southdown" : __DIR__"shijie42",
 		"northup" : __DIR__"xiaochidian",  
//   guangchang",
	]));
	setup();
	replace_program(ROOM);
}

