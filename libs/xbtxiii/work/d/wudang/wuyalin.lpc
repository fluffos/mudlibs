#pragma save_binary
// tyroad4.c 崎岖山路
// by Marz 

inherit ROOM;

#include "feng.h"

string* npcs = ({
        "guest",
        "tufei2",
        "guest",
        "xiao_tufei",
        "guest",
        "xiao_louluo",
});


void create()
{
	int i = random(sizeof(npcs));

	set("coor",({-650,-530,4200}));
	set("short", "乌鸦岭");
	set("long",
"这是武当的乌鸦岭，从前是一片乱葬岗，山路崎岖狭隘，一边是\n"
"峭壁，一边是悬崖。高高的天柱峰(feng)笼罩在云雾中，隐约可\n"
"见。可是身旁的进香客和游人都仔细地町着自己的脚下，不敢抬\n"
"头望一眼，惟恐一不小心摔下去。更有强人趁机打劫，行人无不\n"
"噤声闭气，只求快点敢路。\n"
);
	set("outdoors", "wudang");

	set("exits", ([
		"northup" : __DIR__"sanlao",
		"southdown" : __DIR__"nanyan",
	]));

    set("item_desc", ([
        "feng" : (:look_feng:),
    ]));
    
	set("objects", ([
	__DIR__"npc/"+npcs[i] : 1]));
                                    

	setup();
}

void init()
{
        add_action("look_feng", "look");
}
