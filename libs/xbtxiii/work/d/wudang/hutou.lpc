#pragma save_binary
// tyroad7.c 崎岖山路
// by Marz 

inherit ROOM;

#include "feng.h"

void create()
{
	set("coor",({-650,-440,4300}));
	set("short", "虎头岩");
	set("long",
"你走在虎头岩山路上，一边是峭壁，一边是悬崖。高高的天柱峰\n"
"(feng)笼罩在云雾中，隐约可见。可是身旁的进香客和游人都仔\n"
"细地町着自己的脚下，不敢抬头望一眼，惟恐一不小心摔下去。\n"
"更有强人趁机打劫，行人无不噤声闭气，只求快点敢路。\n"
);
	set("outdoors", "wudang");

	set("exits", ([
		"north" : __DIR__"chaotian",
		"southdown" : __DIR__"wulao",
	]));

    set("item_desc", ([
        "feng" : (:look_feng:),
    ]));

	setup();
}

void init()
{
        add_action("look_feng", "look");
}
