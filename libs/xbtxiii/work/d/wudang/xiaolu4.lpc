#pragma save_binary
// xiaolu4.c 小径
// by arnzh

inherit ROOM;

void create() {
  set("coor", ({ -550, -810, 2800 }));
  set("short", "小径");
  set("long",
    "你走在一条小径上，两旁是光秃秃的山壁，静悄悄听不到一丝动\n"
    "静。\n"
  );

  set("exits", ([
    "west": __DIR__ "xiaochidian",
    "east": __DIR__ "shiliang",
  ]));
  setup();
}
