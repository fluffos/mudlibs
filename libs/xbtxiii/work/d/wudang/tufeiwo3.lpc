#pragma save_binary
// tufeiwo3.c 小路尽头
// by Cleansword 1996/2/2

inherit ROOM;

void create() {
  set("coor", ({ -400, -1400, 100 }));
  set("short", "林中小路");
  set("long",
    "你走在一条僻静的林中小路上，两旁是阴森森的树林。只见左右\n"
    "前后，到处都是铺天盖地的松树林。几十丈高的大松树簇在一块，\n"
    "密实的枝叶象一蓬蓬巨伞般伸向天空，把阳光遮得丝毫也无。据\n"
    "说这里经常有土匪出没，不可久留。\n"
  );
  set("outdoors", "wudang");

  set("no_sleep_room", 1);

  set("exits", ([
    "west": __DIR__ "tufeiwo2",
  ]));

  set("objects", ([
    __DIR__ "npc/tufei1": 2,
    __DIR__ "npc/tufeitou": 1,
  ]));

  setup();
}
