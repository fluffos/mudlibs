#pragma save_binary
// wc.c 武当茅房
// by rongg
inherit ROOM;
#include <ansi.h>
void create() {
  set("coor", ({ -650, -180, 4300 }));
  set("short", "武当茅房");
  set("long",
    "这是武当的一个小茅房，除了一个马桶之外什么也没有了。\n"
  );

  set("exits", ([
    "south": __DIR__ "xiaoyuan",
  ]));
  set("no_fight", 1);
  set("no_clean_up", 1);
  //	create_door("south", "竹门", "north", DOOR_CLOSED);
  set("item_desc", ([
    "马桶": "一个陶瓷做的马桶，可以用来方便(egast)\n",
    "closestool": "一个陶瓷做的马桶，可以用来方便(egast)\n",
  ]));
  setup();
}

void init() {
  object me;
  me = this_player();
  add_action("do_egast", "egast");
  call_out("zhang_message", 1, me);
}

void zhang_message(object me) {
  object zhang;
  zhang = present("zhang sanfeng", environment(me));
  if (zhang && !userp(zhang)) {
    switch (random(5)) {
      case 0:
        message("vision", HIR "张三丰的脸憋的红红的，脸上露出痛苦的神色。。。。。\n" NOR
          CYN "张三丰后悔的喃喃道：唉～　　～　　～　，早知道就不吃那么多辣椒了。。\n"
          "张三丰边说边用劲，好象非常吃力。。。。。。\n" NOR, me);
        break;
      case 1:
        message("vision", CYN "张三丰叹了口气。唉～　　～　　～　　。。露出后悔的神色。\n" NOR, me);
        break;
      case 2:
        message("vision", CYN "张三丰脸色通红，好象使出了全身的力气。。。\n" NOR, me);
        break;
      case 3:
        message("vision", CYN "张三丰瞪了" + me->name() + "一眼，道：没有看见我在干什么吗?\n"
          "张三丰再也不理" + me->name() + "\n" NOR, me);
        break;
      case 4:
        message("vision", CYN "张三丰忽然深有感触的说：恩，辣椒好吃，但是现在就。。。唉～　　～　　～\n" NOR, me);
        break;
    }
  }
}
int do_egast() {
  object me;
  me = this_player();
  if (me->query("gender") == "女性")
    write("在这个地方？好象是男厕耶。。。\n", me);
  else if (me->query("gender") == "中性" || me->query("gender") == "无性")
    write("你就不怕暴露身份吗？还是小心些为妙。\n", me);
  else if (me->query_temp("egast") == "just_now")
    write("真是懒人屎尿多，你刚才不是已经方便过一次吗？才多久啊!又来？？？\n", me);
  else {
    message_vision("$N急急忙忙的除下裤子。就。。。。。。。\n", me);
    me->start_busy(11);
    me->set_temp("apply/short", ({ "" + me->short() + "<大便中>" }));
    me->set_temp("temp_times", 10);
    me->set_temp("egast", "just_now");
    call_out("message", 1, me);
  }
  return 1;
}

void message(object me) {
  message_vision("$N憋的脸红脖子粗的，四周弥漫着臭味。。。\n", me);
  me->add_temp("temp_times", -2);
  if (me->query_temp("temp_times") <= 0) {
    me->delete_temp("apply/short");
    message_vision("$N站了起来长长的舒了口起。。啊～　　～　　～。 。　。\n", me);
    me->add("kee", 20);
    me->add("sen", 20);
    me->add("gin", 20);
  } else
    call_out("message", 2, me);
}
