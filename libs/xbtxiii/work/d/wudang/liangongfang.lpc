#pragma save_binary
// /d/wudang/liangongfang.c 练功房
// By rongg

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "练功房");
        set("long",
"这里是练功房，武当弟子大都在这里练功。有几个武当弟子现在\n"
"正盘膝坐在上辛勤的练功。\n"
);
        set("exits", ([
                "west" : __DIR__"donglang2",
        ]));
        set("objects", ([
                "/d/village/obj/zhujian" : 4]));

        
        setup();
}

void init()
{
        add_action("do_practice","practice");
}

int do_practice()
{
         
        int t, d, h, m, s;
        object me,zhangsanfeng;
        me=this_player();
        t = uptime();
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;


if (m==20&&me->query("family/family_name")=="武当派")
       {
       message("vision",CYN"哈哈哈。。。一声大笑声突然从门口传来.\n"
               ""+me->name()+"连忙朝门外看去，发现大笑之人不是别人.\n"
               "正是武当派开山祖师，当今武林泰斗----张三丰。张三丰\n"NOR,me);
       zhangsanfeng=new("/daemon/class/wudang/zhangsanfeng");
       zhangsanfeng->move(environment(me));
       zhangsanfeng->come_in(me);//具体程序在/daemon/class/wudang/zhangsanfeng.c里面             
       remove_action("do_practice","practice");
       return 1;
       }
    
// 具体时间和具体书待定。       
}


