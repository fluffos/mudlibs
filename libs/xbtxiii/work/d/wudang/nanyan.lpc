#pragma save_binary
// tyroad2.c 石阶
// by Marz 

inherit ROOM;

void create()
{
	set("coor",({-650,-580,4150}));
	set("short", "南岩峰");
	set("long",
"这是一条宽大坚实的石阶路，不时地有进香客和游人从你的身边\n"
"走过。抬头西望，雄伟的三清殿顶浮现在香烟袅绕之中，巍峨壮\n"
"观；东边一条石阶通往山下，隐约可见远处桃花片片，赏心悦目。\n"
);
	set("outdoors", "wudang");

	set("exits", ([
		"west" : __DIR__"lameigt",
		"east" : __DIR__"tyroadct",
		"northup" : __DIR__"wuyalin",
	]));
	
//	set("objects", ([
//		__DIR__"npc/guest" : 1]));
		
	setup();
	replace_program(ROOM);
}

