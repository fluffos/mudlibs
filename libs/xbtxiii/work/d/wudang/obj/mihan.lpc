#pragma save_binary
// force_book.c 内功心法

inherit ITEM;

void create()
{
	set_name("密函", ({ "mihan", "letter" }));
	set_weight(1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "张");
		set("long", "你要的东西我藏在了山上的水井里面。\n"
		            "过一段时间我拿了送与你。从此我们\n"
		            "各不相欠。\n"
		            "武当少侠----宋青书\n");
		set("value", 500);
		set("material", "paper");
	}
}
