#pragma save_binary
// /d/wudang/langmei.c 桃园
// by Marz 

#include <room.h>
inherit ROOM;
#include "feng.h"
string *npcs = ({
  "little_monkey",
  "monkey",
  "little_monkey",
  "little_bee",
  "bee",
  "little_bee",
});

void do_tao();
int do_zhai(string arg);
void create() {
  int i = random(sizeof(npcs));

  set("short", "桃园");
  set("long",
    "眼前豁然开朗，你轻松地走在榔梅园的小路上。两边是桃树林(t\n"
    "ree)，树上盛开着粉红的桃花，红云一片，望不到边。不时有蜜\n"
    "蜂「嗡嗡」地飞过，消失在在花丛中；几只猴子在树上互相追逐\n"
    "着，叽叽喳喳地争抢桃子。远处是高高的天柱峰(feng)。\n"
  );
  set("outdoors", "wudang");

  set("exits", ([
    "east": __DIR__ "lameigt",
  ]));

  create_door("east", "竹门", "west", DOOR_CLOSED);
  set("item_desc", ([
    "feng": (: look_feng :),
    "tree":
    "这是一片桃林，上面结满了水蜜桃，引得人哈喇子都掉下来了。\n"
  ]));
  set("objects", ([
    //        CLASS_D("wudang") + "/shouyuan" : 1,
    __DIR__ "npc/" + npcs[i]: 1

  ]));
  set("taocount", 2);

  setup();
}
void init() {
  add_action("look_feng", "look");
  add_action("do_zhai", ({ "zhai", "pick", "cull" }));
}

int do_zhai(string arg) {
  object tao, ob;
  if (arg == "taozi" || arg == "tao" || arg == "peach") {
    if (query("taocount") > 0) {
      switch (random(3)) {
        case 0:
          message_vision("$N桃树上摘下一个熟透的水蜜桃。\n", this_player());
          tao = new(__DIR__ "obj/mitao");
          tao->move(this_player());
          add("taocount", -1);
          this_player()->start_busy(3);
          break;
        default:
          message_vision(CYN "一个蜂窝被捅破了\n" NOR, this_player());
          message_vision(CYN "一群拇指大的马蜂飞了出来\n" NOR, this_player());
          this_player()->set_explore("south#17");
          ob = new(__DIR__ "npc/wasp");
          ob->move(environment(this_player()));
          ob->kill_ob(this_player());
          break;
      }
    } else {
      this_object()->set("item_desc",
        ([
          "tree":
          "这是一片桃林，上面结满了水蜜桃，不过熟的桃子都已经被人摘光了。\n"
        ]));
      write("睁大你的双眼看清楚了？还有熟的桃子吗?\n", this_player());
      remove_call_out("do_tao");
      call_out("do_tao", 180);
    }
  } else return notify_fail("你要摘什么啊？\n");
  return 1;
}
void do_tao() {
  set("taocount", 2);
}
