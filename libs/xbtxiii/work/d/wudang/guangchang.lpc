#pragma save_binary
// guangchang.c 广场

inherit ROOM;

void create() {
  set("coor", ({ -600, -660, 4100 }));
  set("short", "武当广场");
  set("long",
    "这是一个由大石板铺成的广场，是武当弟子学习武功和互相切磋\n"
    "的地点。周围种满了梧桐树，一到秋天就是满地的落叶。一个年\n"
    "纪轻轻的道童正在打扫。北边是灵霄宫三清殿。\n"
  );
  set("outdoors", "wudang");

  set("exits", ([
    "southdown": __DIR__ "shijie62",
    "north": __DIR__ "sanqingdian",
    "west": __DIR__ "shijie7",
  ]));
  set("objects", ([
    CLASS_D("wudang") + "/daotong": 2,
    CLASS_D("wudang") + "/songqingshu": 1,
  ]));

  setup();
}
