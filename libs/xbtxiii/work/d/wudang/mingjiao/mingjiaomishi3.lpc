#pragma save_binary
//room: /d/wudang/mingjiaomishi3.c  明教密室
inherit ROOM;


void create() {
  set("coor", ({ -650, -1300, -30 }));
  set("short", "明教密室");
  set("long", "明教的密室是一个迷宫。明教教规规定。只有教主才有资格\n"
    "随意出入密室。\n");

  set("exits", ([
    "south": __DIR__ "mingjiaomishi4",
    "north": __DIR__ "mingjiaomishi2",
  ]));

  setup();
}

