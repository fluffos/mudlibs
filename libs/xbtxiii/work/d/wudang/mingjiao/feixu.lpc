#pragma save_binary
inherit ROOM;
#include <room.h>
string look_sign(object me);
void create() {
  set("coor", ({ -650, -1300, 0 }));
  set("short", "明教废墟");
  set("long", "明教自从教主阳顶天失踪之后四分五裂。经过几次大战。\n"
    "只剩下一片废墟。零零乱乱的到处都是石头\n");

  set("exits", ([
    "east": __DIR__ "gebitan5",

  ]));
  set("objects", ([
    __DIR__ "obj/crazy_man": 1,
  ]));
  set("item_desc", ([
    "stone": (: look_sign :),
    "石头": (: look_sign :),
  ]));

  set("outdoors", "wudang");
  setup();

}

string look_sign(object me) {

  me->set_explore("south#24");
  return "一块不是很大的石头。\n";

}




int init() {

  add_action("do_find", ({ "search", "find" }));
}

int do_find(string arg) {
  object me;
  me = this_player();
  if (!arg)
    return notify_fail("你想干什么？\n");
  if (arg == "石头" || arg == "stone") {
    if (random(me->query("kar")) >= 14) {
      message_vision("$N几经辛苦。终于在石头下面找到了一个小小的环。\n"
        "$N用手轻轻一拉。竟然发现了一个秘密通道的入口。\n", me);
      set("exits", ([
        "down": __DIR__ "mingjiaomishi1",
        "east": __DIR__ "gebitan5",
      ]));
    } else
      message_vision("$N反开石头找了半天。结果什么也没有发现\n", me);
    remove_action("do_find", "search");
    remove_action("do_find", "find");
  } else
    return notify_fail("你要干什么？\n");
  return 1;
}

