#pragma save_binary
//room: /d/wudang/entrance.c  明教密道入口
inherit ROOM;


void create() {
  set("coor", ({ -650, -1300, -30 }));
  set("short", "密道入口");
  set("long", "一扇大门当在了面前。大门好象是用某种坚硬的岩石作成的。\n"
    "要想打碎它。可是万万不能的。\n");

  set("exits", ([
    "north": __DIR__ "mingjiaomishi1",
  ]));

  setup();
}

int init() {
  add_action("open_door", ({ "open", "开" }));
}

int open_door(string arg) {
  object me;
  object *key;
  int i, temp;
  me = this_player();
  if (!arg)
    return notify_fail("你想开什么？\n");
  temp = 0;
  if (arg == "大门" || arg == "石门" || arg == "door") {
    key = all_inventory(me);
    for (i = 0; i < sizeof(key); i++) {
      if (key[i]->query("明教密室大门的钥匙")) {
        temp = 1;
        destruct(key[i]);
      } else
        continue;
    }
    if (temp == 1) {
      message_vision("$N拿出一把钥匙。将大门打开了\n", me);
      me->set_explore("south#25");
      set("exits", ([
        "enter": __DIR__ "mingjiaomishi2",
        "north": __DIR__ "mingjiaomishi1",
      ]));
    } else
      tell_object(me, "你绞尽脑汁。也无法打开大门\n");
  }
  return 1;
}
