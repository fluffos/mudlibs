#pragma save_binary
// 阳顶天的尸骨


inherit ITEM;

void create()
{
        set_name("一具干枯的骸骨", ({"skeleton"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "具");
                set("long","一具干枯的骸骨。\n");

				set("material", "sapphire");
                set("value",50);
                  set_max_encumbrance(4000000);

             }
		setup();
}

int is_container() { return 1; }
