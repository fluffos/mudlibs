#pragma save_binary
// 羊皮纸。


inherit ITEM;

void create() {
  set_name("羊皮纸", ({ "sheep_paper" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "一张发黄的羊皮纸。看样子年代非常久远了。上面写了一些\n"
      "怪异的文字。好象不是中土文字。\n");
    set("material", "sapphire");
    set("value", 50);
    set("杨逍/标记", "乾坤大挪移");
  }
}
