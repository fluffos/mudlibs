#pragma save_binary


inherit ITEM;

void create()
{
        set_name("生锈的钥匙", ({"key"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long","一把已经生锈的钥匙\n");
				set("material", "sapphire");
                set("value",50);
         set("明教密室大门的钥匙",1);
        
             }
		setup();
}
