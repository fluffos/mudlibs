#pragma save_binary
// kid.c

inherit NPC;

void create()
{
		set_name("发疯的老头",({ "crazy_man" }) );
        set("gender", "男性" );
        set("age", 63);
		set("long", "看样子他是愿明教教众，不知道为什么，他看上去疯疯癫癫的。\n");
		set("str", 17);
        set("con", 15);
        set("int", 17);
        set("combat_exp", 1000000);
		set("attitude", "aggresion");
		set_skill("unarmed",235);
		set_skill("dodge",235);
		set_skill("parry",235);
        setup();

        carry_object("obj/cloth")->wear();
		add_money("gold", 2);
}

void die()
{
        object key;
		key=new(__DIR__"key");
		key->move(this_object());
		::die();
}
