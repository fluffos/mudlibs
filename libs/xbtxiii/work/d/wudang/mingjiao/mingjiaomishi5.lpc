#pragma save_binary
//room: /d/wudang/mingjiaomishi5.c  明教密道入口

inherit ROOM;

string look_sign(object me);

void create()
{
        set("coor",({-650,-1300,-30}));
	set("short","明教密室");
        set("long", "按照的教规规定。只有教主才有资格随意出入密室。\n"
			"墙壁上写了几行小字。不知道是谁留下的？\n");

        set("exits",([
            "north" : __DIR__"mingjiaomishi4",
           ]));
		set("objects",([
			__DIR__"obj/skeleton":1,
            __DIR__"obj/sheep_paper":1,
		]));
        set("item_desc", ([
                "words": (: look_sign :),
                "小字": (: look_sign :),
        ]) );

       setup();
}

string look_sign(object me)
{

        me->set_explore("south#26");
  	 return "贱人成昆与夫人通奸被我撞见，不幸我正在练功，因此一怒之下走火入魔。\n"
			"望我门下弟子为我报仇血恨。\n";
}


