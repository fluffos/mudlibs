inherit ROOM;

void create()
{
        set("coor",({-650,-1300,-30}));
	set("short","密道入口");
        set("long", "里面 漆黑一片。一股恶臭从里面传了进来。\n"
					"四周阴森森的。好恐怖！\n");

        set("exits",([
            "south" : __DIR__"entrance",
            "up" : __DIR__"feixu",
           ]));

       setup();
}

