#pragma save_binary
// xiaolu2.c 林间小径
// by Xiang

#include <room.h>
inherit ROOM;

void create()
{
	set("coor",({-650,-250,4300}));
	set("short", "林间小径");
	set("long",
"你走在一条小径上，两旁种满了竹子，修篁森森，绿荫满地，除\n"
"了竹叶声和鸟鸣声，听不到别的动静。北面似乎有一座简陋的小\n"
"院。\n"
);

	set("exits", ([
		"north" : __DIR__"xiaoyuan.lpc",
		"south" : __DIR__"xiaolu1",
	]));
        set("outdoors", "wudang");
	create_door("north", "竹门", "south", DOOR_CLOSED);
	setup();
	replace_program(ROOM);
}

