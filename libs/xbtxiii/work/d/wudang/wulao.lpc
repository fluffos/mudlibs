#pragma save_binary
// tyroad6.c 崎岖山路
// by Marz 

inherit ROOM;

#include "feng.h"

string* npcs = ({
        "tufei2",
        "guest",
        "xiao_tufei",
        "guest",
        "xiao_louluo",
        "guest",
});

void create()
{
    int i = random(sizeof(npcs));

	set("coor",({-650,-480,4280}));
	set("short", "五老峰");
	set("long",
"你走在五老峰的山路上，一边是峭壁，一边是悬崖。高高的天柱\n"
"峰(feng)笼罩在云雾中，隐约可见。可是身旁的进香客和游人都\n"
"仔细地町着自己的脚下，不敢抬头望一眼，惟恐一不小心摔下去。\n"
"更有强人趁机打劫，行人无不噤声闭气，只求快点敢路。\n"
);
	set("outdoors", "wudang");

	set("exits", ([
		"northup" : __DIR__"hutou",
		"southdown" : __DIR__"sanlao",
	]));

    set("item_desc", ([
        "feng" : (:look_feng:),
    ]));

    set("objects", ([
    __DIR__"npc/"+npcs[i] : 2,
    ]));

	setup();
}

void init()
{
        add_action("look_feng", "look");

}
