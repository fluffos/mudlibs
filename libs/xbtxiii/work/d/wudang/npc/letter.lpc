#pragma save_binary
// letter.c

inherit ITEM;
#include <ansi.h>

void create() {
  set_name("信", ({ "letter" }));
  set_weight(100);
  set("receiving", "纪晓芙");  // 一个标记。 
  set("readed", 0);           // 没有被偷看过.
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "封");
    set("long", "这是一封殷梨亭写给纪晓芙的情书。\n"
      "不知道可不可以偷看(read)\n");
    set("material", "paper");
  }
}

void init() {
  add_action("do_read", "read");
}

int do_read(string arg) {
  if (arg != "letter")
    return notify_fail("你要看什么?");
  else {

    set("readed", 1);  // 交到纪晓芙手里时有用。


    message_vision(CYN "只见" + this_player()->query("name") + "看看四周无人，偷偷的将一封信拆开来\n
看了一遍\n" NOR, this_player());
    write(CYN "纪姑娘：我不知道怎么称呼你才好，虽然我们已经有了婚约，\n
但是我还没有正式娶你过门。所以只好称你纪姑娘。我。。。。我。。。\n
我第一次见到你就被你深深的迷恋主了我相信真的有一见钟情这样的\n
事情。自从我见到你之后，整个脑海里都是你的音容笑貌，挥之不去，\n
整天魂不守舍,茶饭不思.我知道，我已经深深的爱上了你。后来，经过\n
师傅的同意，由大师兄上门提亲,当我知道你答应了之后，我。。。我。。。\n
高兴的差一点没有昏到。我不断的喃喃自语：我是这个世界上最幸福的人。\n
现在我天天都盼着娶你过门的那一天。因为这一段时间因为事情繁忙，脱不\n
开身，只好以信来寄托我的相思之苦....\n
                        ————爱你的梨亭..\n" NOR);
  }
}
