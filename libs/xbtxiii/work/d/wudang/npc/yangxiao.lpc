#pragma save_binary
inherit NPC;
#include <ansi.h>

void create() {
  set_name("杨逍", ({ "yangxiao" }));
  set("title", "光明左使");
  set("nick", "明教护法");
  set("gender", "男性");
  set("age", 40);
  set("long", @LONG
他是一位中年书生，身穿白布长袍。他相貌俊雅，只是双眉
略向下垂，嘴边露出几条深深的皱纹不免略带衰老凄苦之相。
他不言不动，神色漠然.正在想什么事情。
LONG
  );
  set("combat_exp", 1000000);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("sword", 150);
  set_skill("damo-jian", 120);
  set_skill("jingang-quan", 150);
  set_skill("huntian-qigong", 100);
  set_skill("shenkong-xing", 100);
  set_skill("force", 100);
  map_skill("force", "huntian-qigong");
  map_skill("sword", "damo-jian");
  map_skill("dodge", "shenkong-xing");
  map_skill("unarmed", "jingang-quan");
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 30);
  setup();
  carry_object("/obj/weapon/sword/feijian")->wield();
  carry_object("/obj/cloth")->wear();
}

int accept_object(object me, object ob) {
  object buhui, obj;
  buhui = present("buhui", environment(this_object()));
  me = this_player();
  switch (ob->query("杨逍/标记")) {
    case "LING PAI":
      if (buhui) {
        command("say 这是我明教的信物，你怎么得到的？");
        message_vision(CYN "$N见状连忙回答道:这个令牌不是我的。\n"
          "是纪晓芙纪姑娘让交给我的，她让我帮忙带她的女儿来找\n"
          "一个叫杨逍的人.她说只要将这个令牌交给杨逍，他就会知\n"
          "道事情的一切了。纪姑娘还说,她给女儿起名叫不悔。\n"
          "杨逍大吃一惊,指着不悔问道：她就是晓芙的女儿不悔?\n"
          "$N连忙点头.........\n"
          "杨逍悲戚的喃喃道:晓芙，是我害了你.\n"
          "杨逍继续道:我不应该对你乱始乱终.咳！\n"
          "我答应你我一定要照顾好我们的女儿.\n\n"
          "杨逍对$N说到，这位" + RANK_D->query_respect(me) + "不远千里\n"
          "将女儿送到我这里，在下万分感谢。这点儿银子.\n"
          "权当在下的一点心意吧\n" NOR, me);
        tell_object(me, "你要还是不要?(yes/no)\n");
        add_action("give_him_silver", ({ "yes", "no" }));
        me->set_temp("decide_numbers", 1);
      } else {
        command("say 这是我明教的信物，你是怎么得来的？说！！！");
        command("say 我要收回了。这位" + RANK_D->query_respect(this_player()) + "请速速离开这里!!");
      }
      break;
    case "乾坤大挪移":
      if (me->query_temp("杨逍/帮我找教主")) {
        tell_object(me, CYN "好！原来是这样。如果你帮我杀了成昆那厮。我会给你一个\n"
          "意外的惊喜的。\n");
        me->set_temp("杨逍/帮我杀成昆", 1);
      } else {
        tell_object(me, CYN "这是什么东西？怎么会在你手里？是不是你杀了阳教主？\n" NOR);
        this_object()->kill_ob(me);
        me->kill_ob(this_object());
      }
      break;
    case "成昆":
      if (me->query_temp("杨逍/帮我杀成昆")) {
        tell_object(me, CYN "在下太感谢你替我杀了成昆这个恶贼！！！\n"
          "为了感激你。我告诉你一个秘密吧。绝世好剑－－倚天剑现在在\n"
          "灵蛇岛的金花婆婆手中。我这里有一张海图，对你也许有用\。你拿去吧!\n");
        obj = new(__DIR__ "obj/map_of_see");
        obj->move(me);
      } else {
        command("say 这是什么东西？");
        tell_object(me, "杨逍看了看你给他的" + ob->name() + "随手就扔了！\n");
      }
      break;
    default:
      {
        command("say 这是什么东西？");
        tell_object(me, "杨逍看了看你给他的" + ob->name() + "随手就扔了！\n");
      }
  }
  call_out("dest_obj", 1, ob);
  return 1;
}


int give_him_silver() {
  object me, obj;
  int numbers;
  me = this_player();
  numbers = me->query_temp("decide_numbers");
  if (query_verb() == "yes") {
    switch (numbers) {
      case 1:
        message_vision(CYN "杨逍笑道：好！如此爽快！！！\n" NOR, me);
        add_money("silver", random(200));
        break;
      case 2:
        message_vision(CYN "呵呵，小孩子不要太贪财哟！！！\n"
          "还是给你50两银子吧!!!\n" NOR, me);
        add_money("silver", 50);
        break;
      case 3:
        message_vision(CYN "呵呵，我身上那里有这么多钱啊？刚才我只是想试试\n"
          "你。唉～　　～　　～　　想不到你是如此贪心！！！\n"
          "算了！还是给你些钱吧\n" NOR, me);
        add_money("silver", 1);
        break;
      case 4:
        tell_object(me, CYN "那好。你听好了。\n"
          "我明教自宋朝年间创立。经三十二代教主苦心经营。\n"
          "传之三十三代教主阳顶天，更是威镇武林。不想十年前\n"
          "阳教主突然失踪，从此我明教四分五裂。现已不成样子。\n"
          "你能不能帮我找一下教主？\n" NOR);
        tell_object(me, "\n愿意帮忙吗？(yes/no)\n");
        me->add_temp("decide_numbers", 1);
        break;
      case 5:
        message_vision(CYN "好！！！我就喜欢你这样爽快的人！！！\n"
          "这个东西给你，也许会对你有所帮助的。\n"
          "只要帮我打听到教主的消息。我一定会重谢你！\n"
          "君子一言驷马难追！！！\n" NOR, me);
        break;
      default:
        message_vision("程序有些错误。我走了。你顺便问问rongg是怎么回事。ok?\n", me);
        break;
    }
    if (numbers <= 3)

      command("give " + me->query("id") + " silver");

    else if (numbers == 5) {
      obj = new(__DIR__ "obj/lingpai");
      obj->move(me);
      message_vision("杨逍给了$N一个令牌.\n", me);
      me->set_temp("杨逍/帮我找教主", 1);
      remove_action("give_him_silver", "yes");
      remove_action("give_him_silver", "no");
      me->delete_temp("decide_numbers");
    }
    if (numbers != 4)

      call_out("leave_here", 3, me);

  } else if (query_verb() == "no") {
    switch (numbers) {
      case 1:
        message_vision(CYN "杨逍笑道：嫌少？？？ １０两黄金够不够？\n", me);
        break;
      case 2:
        message_vision(CYN "呵呵，看来我小窥了这位" + RANK_D->query_respect(me) + "！！\n"
          "好吧。我还有５０两黄金，总够了吧!\n" NOR, me);
        break;
      case 3:
        message_vision(CYN "好！！！我杨某还没有见过这样淡薄名利的人！！！\n"
          "好，我杨逍就告诉你一件事情\n" NOR, me);
        tell_object(me, "愿意听吗？(yes/no)\n");
        break;
      case 5:
        message_vision(CYN "唉～　　～　　～　，不愿意听也罢了。我走了。\n" NOR, me);
        call_out("leave_here", 3, me);
        remove_action("give_him_silver", "yes");
        remove_action("give_him_silver", "no");
        break;
      case 4:
        ;
        break;
      default:
        message_vision("程序有些错误。我走了。你顺便问问rongg是怎么回事。ok?\n", me);
        remove_action("give_him_player", "yes");
        remove_action("give_him_player", "no");
        call_out("leave_here", 3, me);
        break;
    }
    me->add_temp("decide_numbers", 1);
    if (numbers <= 2)
      tell_object(me, "够不够?(yes/no)\n");
  }
  return 1;
}

void leave_here(object me) {
  object buhui;
  buhui = present("buhui", environment(this_object()));
  command("say 不悔，你过来，让啊爹好好看看你！！");
  command("say 我杨逍这一生最大的错误就是让晓芙离开了我，我好悔!!!!");
  command("say 此地不宜久留，不悔，我们走吧!");
  write("杨逍说完抱起不悔姑娘几个纵越转眼就不见了。");
  write("" + me->name() + "不禁有些怅然若失.咳，还是走吧...\n");
  me->delete_temp("decide_numbers");
  destruct(buhui);
  destruct(this_object());
}

int dest_obj(object ob) {
  destruct(ob);
}
