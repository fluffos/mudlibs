#pragma save_binary
// /d/wudang/npc/buhui.c小女孩不悔.相关人物 xiaofu.c
// By rongg

inherit NPC;
#include <ansi.h>
int ask_me();

void create() {
  set_name("不悔", ({ "buhui" }));
  set("title", "小女孩");
  set("gender", "女性");
  set("age", 14);
  set("butterfly", 0);  //初始化时环境中做没有蝴蝶处理.
  set("ask_me", 0);    //与任务有关。
  set("long", @TEXT
她叫不悔，是纪晓芙的私生女。她是个非常可爱的小女孩，整天无忧无虑的模样。
她现在正在捉蝴蝶，看着她那可爱的样子。人人都不禁被她吸引主了。
TEXT
  );
  set("combat_exp", 10);
  set("inquiry", ([
    "走": (: ask_me :),
    "跟我走": (: ask_me :),
    "你跟不跟我走": (: ask_me :),
    "找啊爹": (: ask_me :),
  ]));

  setup();
  carry_object("/obj/skirt")->wear();
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player())
    && !is_fighting()
    && this_object()->query("following_player") == 0)  // 玩家接到任务将她送往杨逍的路上不让她再说话.
  {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting() {
  int i;
  object butterfly;
  object *ob;
  ob = all_inventory(environment());

  this_object()->set("butterfly", 0);  //每次初始化都当蝴蝶不存在

  for (i = sizeof(ob) - 1; i >= 0; i--) {
    if (!ob[i]->is_character()
      || ob[i] == this_object()
      || ob[i]->is_corpse()
      || ob[i]->query("id") != "butterfly") continue;
    {
      this_object()->set("butterfly", 1);  //蝴蝶还在环境中存在.
      butterfly = ob[i];
    }
  }

  if (this_object()->query("butterfly") == 1) {
    switch (random(3)) {
      case 0:
        command("say 蝴蝶呀蝴蝶，你不要跑，停下来让我捉好吗？");
        command("say 别跑呀。。。。。。。。。");
        command("say 你再跑我可要生气啦。。");
        break;
      case 1:
        command("say 蝴蝶蝴蝶你别跑，我们一起玩儿，好吗？");
        command("smile");
        break;
      case 2:
        command("say 哈哈，这下看你还往那里跑!我可捉到你啦。。。");
        command("say 蝴蝶蝴蝶不要怕，我不会伤害你的耶。");
        message_vision("不悔捉住了一只蝴蝶\n", this_object());
        destruct(butterfly);
        this_object()->set("long", @LONG
她叫不悔，是纪晓芙的私生女。她是个非常可爱的小女孩，整天无忧无虑的模样。
她刚刚捉到了一只蝴蝶，玩的好开心。嘴里不住的喃喃道：蝴蝶呀蝴蝶，我不会
伤害你的耶.看着她那可爱的样子，人人的心里不禁都要涌上一股爱意.
LONG);
    }
  } else {
    command("sigh");
    command("say 蝴蝶呀蝴蝶，你们都跑到那里去了？我怎么找不到你们呀？");
    command("say 你们都出来陪我玩儿，好吗？");
    this_object()->set("long", @LONG
她叫不悔，是纪晓芙的私生女。她是个非常可爱的小女孩，整天无忧无虑的模样。
她现在正在捉蝴蝶，看着她那可爱的样子。人人都不禁被她吸引主了。
LONG);

  }
}

int ask_me() {
  object me;
  me = this_player();
  if (this_object()->query("his_name_is") == me->name()) {
    // 这个记号是由同一目录下的xiaofu.c所做的.
    command("say 妈妈走了，呜。。呜。。呜");
    command("say 我不跟你走！！！呜呜呜呜");
    write("看来不悔不想跟你走，想想办法吧!\n", me);
    set("ask_me", 1);
  } else
    command("say 这位" + RANK_D->query_respect(me) + "是谁呀？我好象不认识你耶!");
  return 1;
}


int accept_object(object who, object wing) {
  who = this_player();

  if (this_object()->query("ask_me") == 0)
    command("say 妈妈说，现在拐骗小孩子的坏人太多，不能随便要别人的东西。。。");
  else {
    if (query("his_name_is") == who->name()
      && wing->query("id") == "wing") {
      command("say 好漂亮的" + wing->query("name") + "啊!我好喜欢耶!");
      command("say 好吧,我就跟这位" + RANK_D->query_respect(who) + "走吧!");
      command("follow " + who->query("id") + "");
      //       destruct(wing);
      set("following_player", 1);
      return 1;
    } else if (this_object()->query("his_name_is") == who->name()) {
      command("say 这是什么呀？我不喜欢" + wing->query("name") + "");
      return 0;
    } else {
      command("say 你是谁呀？我好象不认识你呀？");
      command("say 妈妈，这位" + RANK_D->query_respect(who) + "要拐骗我..");
      return 0;
    }
  }
}


int accept_fight(object who) {


  switch (this_player()->query("age")) {
    case 14:
      command("say 妈妈对我说不让我和别人打架...");
      break;
    default:
      command("cry");
      command("say 妈妈。。。。呜呜。。" + RANK_D->query_rude(this_player()) + "" + this_player()->query("name") + "要欺负我，呜呜。。");
      break;
  }
  return 0;
}
