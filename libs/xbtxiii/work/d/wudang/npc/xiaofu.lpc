#pragma save_binary
// 纪晓芙
// 与之相关文件 /d/wudang/npc/obj/letter.c、clasp.c
// By rongg 1998.7.23.

inherit NPC;
#include <ansi.h>
int ask_me();
 
void create()
{
        set_name("纪晓芙", ({ "ji xiaofu","xiaofu","ji" }) );
        set("title", "峨眉派弟子");
        set("gender", "女性" );
        set("age", 27);
        set("per",60);
        set("long", @TEXT
峨眉派女弟子纪晓芙。不仅容貌娇好，而且心地非常善良。让人着实喜欢。
她现在站在武当山的山脚下，看样子想上山，但是非常踌躇.只见她自言
自语，不知道在说些什么。
TEXT
);
        set("combat_exp", 500000);
        set_skill("unarmed", 100);
        set_skill("dodge", 100);
        set_skill("sword", 100);
        set_skill("taiji-jian", 60);
        set_skill("iceforce", 100);
        set_skill("tiyunzong", 100);
        set_skill("force",100);
        map_skill("force","iceforce");
        map_skill("sword","taiji-jian");
        map_skill("dodge","tiyunzong");
        set("force", 7000);
        set("max_force", 7000);
        set("force_factor", 30);
        set_temp("apply/armor", 100);
        set("inquiry",([
                 "不悔"     :(:ask_me:),
                 "小女孩"   :(:ask_me:), 
                 "杨逍"     : "他？我。。。。我不认识他？你问这个干什么？",
                 "殷梨亭"   : "他。。。他是我的未婚夫。。。求求你不要再问了！！！",
                 ]));
        setup();
        carry_object("/obj/skirt")->wear();
}


int ask_me()
{
         object me,buhui;
         me=this_player();
         buhui=present("buhui",environment(this_object()));
if(buhui)
         {     
         command("shy");
         command("say 不瞒这位"+RANK_D->query_respect(me)+",这个小女孩子是我的女儿。她叫不悔..");
         message_vision(CYN"纪晓芙说着说着竟然两眼含泪,对"+me->query("name")+"说: 我想求\n"
                           "你一件事情？不知道你肯答应吗?(yes/no)\n"NOR,me);
         add_action("do_nod",({"yes","no"}));
         }
else 
         {
         message_vision(CYN"纪晓芙奇道：对呀，我女儿不悔刚才还在这里的.\n"
                           "糟啦！女儿不见啦。怎么办，我得赶快去找她....\n"NOR,me);
         write("纪晓芙匆匆忙忙的离开了，看样子是去找她的女儿去了...\n",me);
         destruct(this_object());           
         }
return 1;
}


int do_nod()
{
         string arg;
         object me,ling,buhui;
         me=this_player();
         buhui=present("buhui",environment(this_object()));
if (query_verb()=="yes")
          {
          command("say 这位"+RANK_D->query_respect(me)+"果然爽快..");
          message_vision(CYN"只见纪晓芙向正在旁边玩耍的小女孩招了招手，说道:不悔,过来..\n"
                            "小女孩连忙答应道:哎，妈妈叫我干什么呀？\n"
                            "小女孩蹦蹦跳跳的走了过来。\n"NOR,me);
          command("say 这就是小女不悔，拜托你将她带到光明顶交给杨逍杨左使.");
          command("say 这里有一个令牌，你给他，他就会知道怎么会事了。");
          ling=new(__DIR__"obj/lingpai");
          ling->move(this_object());
          command("give "+me->query("id")+" LING PAI");
          command("say 一切就拜托你了。");     
          buhui->set("his_name_is",""+me->name()+"");
//        请尽量不要在玩家身上做记号.
//        me->set("mark/不悔",1);         //答应带不悔去找杨逍。  
          remove_action("do_nod","yes");  // 一定要有两个remove,格式如下。
          remove_action("do_nod","no");   // 写成这样好象有错
          command("say 我要走了....");    // remove_action("do_no",({"yes","no"}));            
          write("纪晓芙说完话竟独自一人离开了\n");
          destruct(this_object()); 
          }              
else if(query_verb()=="no")  
          {
          command("sigh");
          command("say 既然你不肯帮忙就算了");
          command("say 唉。。。。我可怜的女儿。。妈对不起你。。");     
          }
return 1;  
}

int accept_object(object who,object oob)
{  
          object newobj;
          who=this_player();
if((string)oob->query("receiving")!="纪晓芙")  // 收信人!=纪晓芙。信上有注释.
        {                                     //相关文件/d/wudang/obj/letter.c  
        command("?");
        command("say 这东西好象不是我的耶。。。你还是交给它的主人吧!");
        command("hehe");
        return 0;
        }
else if(oob->query("readed")==1)  // 信上的标记. 1是表示已经被人偷看过了。
        {
        message_vision(CYN"纪晓芙接过信件仔细看了看。忽然大怒\n"NOR,who);
        command("angry "+who->query("id")+"");
        command("say 你师傅教过你私拆别人信件的吗？");
        command("say 别以为我不知道，哼，梨亭每次写信都会在里面放一根头发.");
        command("say 如果有人偷看，一定会不小心将它弄掉的。");
        command("say 看我不好好教训你一顿!!!");  
//      destruct(oob);
        call_out("teach_ob",2,who);
        return 1;  
        }
      else 
        {
        message_vision(CYN"纪晓芙接过信件，仔细看了一遍，忽然眼睛竟然湿润了\n"NOR,who);
        command("say 谢谢这位"+RANK_D->query_respect(who)+"，千辛万苦的送信给我。");
        command("say 我无以报答，这里是一点银子，不成敬意，您就收下吧");
        add_money("silver",50);
        command("give "+this_player()->query("id")+" silver");
        command("say 对了，麻烦你回去对他说我对不起他，只好下辈子在报答他了.");
        command("say 这个东西麻烦你还给他..");
        newobj=new(__DIR__"obj/clasp");
        newobj->move(this_object());
        command("give "+this_player()->query("id")+" clasp");
        command("say 叫他把我忘了吧!");
        call_out("leave_here",3,who);
        return 1;
        }
}
void teach_ob(object me)
{
        int age;
        age=me->query("age"); 
switch(age)
       {
       case 14:
          command("say 哼!....念你年龄尚小，本姑娘就姑且饶你一次，滚吧!!");
          break;
       case 15:
          command("say 本想教训你一顿，还是算了，下次定要你吃吃苦头!!滚!!!");
          break;
       default:
          command("say 偷看他人信件，该当何罪？");
          message_vision(CYN"只见纪晓芙杨起纤纤小手，狠狠的扇了"+this_player()->query("name")+"四个耳光!!!\n"
                         ""+me->name()+"被打的不知东南西北....\n"NOR,me);
          write(RED"上\n"NOR,me);
          write("纪晓芙扇了你一个耳光\n",me);
          write("你被打的晕头转向\n",me); 
          write(CYN"下\n"NOR,me);
          write("纪晓芙扇了你一个耳光\n",me);
          write("你被打的晕头转向\n",me);
          write(MAG"左\n"NOR,me);
          write("纪晓芙扇了你一个耳光\n",me);
          write("你被打的晕头转向\n",me);
          write(HIM"右\n"NOR,me);
          write("纪晓芙扇了你一个耳光\n",me);
          write("你被打的晕头转向\n",me);
          command("say 哼！！！！看你下次还敢不敢？？");
          me->unconcious();
          break;
     }
}


void leave_here(object me)
{ 
         object buhui;
         buhui=present("buhui",environment(this_object()));
if(buhui)                 
         {
         command("say 不悔，你过来..");
         message_vision(CYN"小女孩听到母亲叫她，立即蹦蹦跳跳的跑了过来:娘，你叫我呀?\n"
                           "纪晓芙说道:我们走吧 !\n"
                           "不悔问道：我们要去哪儿呀？\n"
                           "纪晓芙答道：去一个很远的地方..\n"
                           "纪晓芙牵着不悔的小手慢慢走了\n\n"NOR,me);
         message_vision("$N看着纪姑娘和不悔的背影,禁不住的感慨:好幸福啊....\n"
                 "随即又想:糟了,我怎么向殷六侠交代这件事呢?\n"
                 "$N想了半天,还是决定实话实说，将一切都告诉殷六侠...\n"
                 "唉。。。。可怜的殷六侠.................\n",me);
         destruct(buhui);
         destruct(this_object());
         }
else
         {
         command("say 我也该走了,谢谢"+me->name()+"给我送来这个消息...");
         command("say "+RANK_D->query_respect(me)+"多多保重!!!"); 
         message_vision("纪晓芙缓缓离开了.............\n",me);               
         destruct(this_object());  
         }
}  

