#pragma save_binary
// hair clasp

#include <armor.h>
inherit HEAD;
void create() {
  set_name("发簪", ({ "hair clasp", "clasp" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", @LONG
一个金子打造的发簪，拿在手中沉甸甸的，分量不轻.
上面镶了一颗不小的蓝宝石。看起来珍贵异常。
想必这个簪子是殷梨亭送给纪晓芙的定情信物。
LONG);
    set("material", "sapphire");
    set("value", 2000);
    set("armor_prop/armor", 1);
    setup();
  }


}
