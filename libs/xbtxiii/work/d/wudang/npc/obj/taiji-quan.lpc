#pragma save_binary
// /d/wudang/obj/book.c

inherit ITEM;

void create() {
  set_name("太极拳谱", ({ "book" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一本太极拳谱。上面记载了张三丰自创的太极拳的普通招数。\n");
    set("value", 1000);
    set("material", "paper");
    set("skill", ([
      "name": "taiji-quan",  //name of the skill
      "exp_required": 20000,  //minimum combat experience required
      "gin_cost": 20 + random(20),  // gin cost every time study this
      "difficulty": 30,  // the base int to learn this skill
      "max_skill": 80  // the maximum level you can learn
    ]));
  }
}
