#pragma save_binary
// paper.c
// 只有去灵蛇岛才有用
inherit ITEM;
#include <ansi.h>

void create() {
  set_name("海图", ({ "map_of_see" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "一张海图，上面记载着去灵蛇岛的航海线。\n");
    set("material", "paper");
    set("灵蛇岛的航海图", "YES");
  }
}
