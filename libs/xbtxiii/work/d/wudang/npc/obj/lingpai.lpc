#pragma save_binary
// lingpai.c 

inherit ITEM;

void create() {
  set_name("明教令牌", ({ "LING PAI" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "一块明教令牌，上面写着几个大字：凡我教众，见令牌如见教主。\n");
    set("material", "paper");
    set("杨逍/标记", "LING PAI");
  }
}
