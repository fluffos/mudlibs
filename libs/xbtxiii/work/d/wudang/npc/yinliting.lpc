#pragma save_binary
// /daemon/class/wudang/yin.c武当六侠 殷梨亭
// 与之相关文件 /obj/clasp.c、letter.c /npc/xiaofu.c
// By rongg

inherit NPC;
#include <ansi.h>
int ask_me();
int do_abuse(string);

void create() {
  set_name("殷梨亭", ({ "yin liting", "yin", "liting" }));
  set("nickname", CYN "武当六侠" NOR);
  set("long",
    "他就是张三丰的六弟子殷梨亭。\n"
    "他今年三十岁，精明能干，嫉恶如仇，性如烈火。\n");
  set("gender", "男性");
  set("age", 30);
  set("attitude", "peaceful");
  set("str", 30);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 10);
  set("combat_exp", 500000);

  set_skill("force", 80);
  set_skill("taiji-shengong", 60);
  set_skill("dodge", 80);
  set_skill("tiyunzong", 60);
  set_skill("unarmed", 80);
  set_skill("taiji-quan", 60);
  set_skill("parry", 80);
  set_skill("sword", 100);
  set_skill("taiji-jian", 100);

  map_skill("force", "taiji-shengong");
  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-quan");
  map_skill("parry", "taiji-jian");
  map_skill("sword", "taiji-jian");

  set("chat_chance_combat", 5);
  set("chat_msg_combat", ({
    (: perform_action, "sword.tian" :),
  }));

  create_family("武当派", 2, "弟子");
  set("inquiry", ([
    "纪晓芙": (: ask_me :),
    "晓芙": (: ask_me :),
    "纪姑娘": (: ask_me :),
  ]));
  setup();
  carry_object("/obj/weapon/changjian")->wield();
  carry_object("/d/wudang/obj/whiterobe")->wear();
}
void init()

{
  object ob;

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_abuse", ({ "abuse", "no" }));

}


void greeting(object ob) {

  if ((string)ob->query("family/family_name") != "武当派") {
    if (ob->query("shen") < -500000) {
      command("say 老子平生最恨魔教中人！！！");
      command("say 我发誓要见一个杀一个！！！");
      command("say 今天你碰上我，算你不走运!受死吧！！！");
      //       this_object()->kill_ob(ob);
    } else {
      command("say 这里是武当山， 你在这里瞎逛什么？");
      add_action("do_abuse", ({ "abuse", "no" }));
      command("say 再不滚，大爷我要生气了。滚！！！！\n");
      add_action("do_abuse", ({ "abuse", "no" }));
      tell_object(ob, "\n殷梨亭这么凶恶，你想骂他几句出出气吗？(abuse/no)\n");
      add_action("do_abuse", ({ "abuse", "no" }));
    }
  }

  else {
    if (ob->query("shen") <= -500000) {
      command("我平生最恨魔教中人，发誓要见一个杀一个");
      command("say 你身为武当弟子，怎么也身入魔道");
      command("say 即使是同门弟子，我也不会放过你，接招吧!!");
      //       this_object()->kill_ob(ob);
    } else if (ob->query("shen") < 0)
      command("say 师弟回来了，你小心堕入魔道啊！！");
    else
      command("say 师弟回来了，赶快去见师傅吧，他老人家想你想的紧呢!!");
  }

}

int do_abuse(string arg) {

  object me;
  me = this_player();
  if (query_verb() == "abuse") {
    if (arg == "yin liting" || arg == "liting") {
      message_vision(YEL "$N气愤不过，接口就骂了起来。哼!江湖上人称的武当六侠\n"
        "殷梨亭，威名远播,是个响当当的好汉。今天我看未必如此。。。\n"
        "堂堂一个男子汉，竟然连自己的未婚妻都保不住!\n"
        "绿帽都戴上很久了。还装做不知道。现在却在他人面前\n"
        "耍威风。哼。。。姓殷的！！！有本事去找魔教杨逍算帐去.\n"
        "哈。。。哈。。。。哈!!!\n\n"
        "$N的一番话，骂的殷梨亭脸色煞白............\n" NOR, me);

      command("say " + me->name() + ",好你个" + RANK_D->query_rude(me) + ",我。。我。。我。。。!");

      if (me->query("age") <= 16) {
        message_vision(CYN "殷梨亭强自压下心中怒火。。.\n" NOR, me);
        command("say 哼！要不是念你年龄尚小，老子早就一剑杀了你!");
        command("say 在我没有发火之前滚蛋!!!");
      } else if (me->query("shen") >= 5000) {
        message_vision(CYN "殷梨亭强自压下心中怒火。。.\n" NOR, me);
        command("say " + me->name() + ",念你和我乃江湖正道之人，今天我就放过你!!!");
        command("say 在我没有发火之前滚蛋!!!");
      } else {
        command("say " + me->name() + ",老子我今天不杀你誓不为人!!!");
        command("say 亮家伙吧!!!");
        this_object()->kill_ob(me);
      }
      remove_action("do_abuse", "abuse");
      remove_action("do_abuse", "no");
    } else write("你要辱骂谁呀？\n", me);
  }

  else if (query_verb() == "no") {
    message_vision(CYN "$N气的脸色煞白，小声说道:哼！妄称武当六侠.\n"
      "连自己的未婚妻都保不住，还装做没事一样。。。真不知羞!\n" NOR, me);
    command("say " + RANK_D->query_rude(me) + ",你在说什么？");
    message_vision(YEL "$N连忙摇头说道；我。。。我什么也没有说。。呵呵..\n" NOR, me);
    write("你不禁擦了擦额头的冷汗:幸亏他没有听见...\n", me);
    remove_action("do_abuse", "abuse");
    remove_action("do_abuse", "no");
  }

  return 1;
}


int ask_me() {
  command("shy");
  command("你是说纪晓芙纪姑娘吗？,她。。。不瞒这位" + RANK_D->query_respect(this_player()) + ",她是在下未过门的妻子.");
  command("say 不知道她现在身在何处。。我。。。我。。。心里实在是想念她..");
  command("say 这位" + RANK_D->query_respect(this_player()) + ",你能帮在下打探一下她的下落吗？");
  write("\n你愿意帮殷梨亭的忙吗?(yes/no)\n", this_player());
  add_action("do_nod", ({ "yes", "no" }));
  return 1;
}

int do_nod() {
  object me, newob;
  me = this_player();
  if (query_verb() == "yes") {
    message_vision(YEL "$N说道：既然殷大侠这么信任" + RANK_D->query_self(me) + "\n"
      "那" + RANK_D->query_self(me) + "一定不负所托.\n" NOR, me);
    command("say 既然这位" + RANK_D->query_respect(me) + "肯帮忙，在下真是万分感谢!!");
    command("shy");
    command("say 这封信麻烦你帮我转达给她.");
    newob = new(__DIR__ "obj/letter");
    newob->move(this_object());
    command("give " + me->query("id") + " letter");
    remove_action("do_nod", "yes");
    remove_action("do_nod", "no");
  } else if (query_verb() == "no") {
    command("sigh");
    command("say 既然这位" + RANK_D->query_respect(me) + "不肯帮忙，我也无话可说");
    command("say 晓芙。。。。。你在那里呢？？？？");
    remove_action("do_nod", "no");
  }
  return 1;
}


int accept_object(object me, object ob) {
  me = this_player();
  if (ob->query("id") == "hair clasp") {   //纪晓芙还给他的定情信物。
    command("say 咦？？？这个发簪是我送给晓芙姑娘的定情信物，怎么会在你手里呢？");
    command("say 快说!晓芙姑娘现在在那里？快说啊！！！");
    message_vision("$N见状，连忙说：这个发簪是纪姑娘让我转交给\n"
      "殷大侠的.她还说什么她对不起殷大侠，让殷大侠\n"
      "忘掉她吧。对了，她让我转告殷大侠，说她已经有了\n"
      "杨逍的女儿名字叫不悔.\n\n"
      "殷梨亭听的怒火中烧，扯着$N的脖子大声吼到:\n"
      "你说什么？她。。。她。。。已经有了杨逍这个狗贼的孽种？\n"
      "还叫不悔？哈~哈~哈~纪晓芙！！！算我殷梨亭瞎了眼！！！贱人！！！！！！！\n"
      "殷梨亭喊着喊着竟然大哭.杨逍！！！我一定要让你碎尸万断！！！！！！\n"
      "殷梨亭突然跪在地上:我殷梨亭今天发誓！从此和魔教势不两立！\n"
      "魔教中人我殷梨亭见一个杀一个!!!!!!!\n\n"
      "殷梨亭说完，头也不回的跑掉了。。。。。。\n\n"
      "$N呆呆的站在原地不知如何是好.......\n", me);
    call_out("leave", 1, me);
    return 1;
  } else {
    command("say 这是什么东西啊？我不要!");
    return 0;
  }
}


int leave(object me) {
  destruct(this_object());
}

int accept_fight(object me) {
  message_vision(CYN "$N大声喝道:久闻武当七侠威名远播,名震江湖\n
               今天" + RANK_D->query_self(me) + "特来求教,还望殷大侠赐教!\n" NOR, me);
  command("say 既然如此，那我也不客气了，这位" + RANK_D->query_respect(me) + " 请出招吧!");
  return 1;
}



void killed_enemy(object victim) {
  if (victim->query("shen") <= -5000) {
    command("say 哼！！！今天又杀了一个魔教中人，为武林除了一害!");
    command("say 我殷梨亭对天发誓：魔教中人，老子见一个杀一个！决不留情!!");
  } else {
    command("say 咳。。。这位" + RANK_D->query_respect(victim) + "何苦呢？为什么和在下过不去呢？");
    command("say 师傅。您老人家不要怪罪于我。");
    command("say 实在是这位" + RANK_D->query_respect(victim) + "苦苦相逼,我不得不出手..");
  }
}
