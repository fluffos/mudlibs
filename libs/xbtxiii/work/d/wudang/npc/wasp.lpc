#pragma save_binary
// /d/wudang/npc/wasp.c

inherit NPC;
#include <ansi.h>

void create()
{
	set_name("蚂蜂", ({"wasp"}) );
	set("race", "野兽");
	set("age", 8);
        set("time",0);
	set("long", "这是一只拇指大的黄蜂，可能因为蜂窝被人捅破了正在寻找仇人。\n");
	set("str", 40);
	set("limbs", ({ "头部","身体", "翅膀", "尾巴" }) );
	set("verbs", ({ "bite", "poke" }) );

	set_temp("apply/attack", 33);
	set_temp("apply/armor", 20);
        set("attitude", "aggressive");
        set("combat_exp", 500);
	
	setup();
}
 

void init()
{
call_out("leave_here",15);
}

int leave_here()
{
message_vision("蚂蜂翁翁的飞走了.\n",this_player());
destruct(this_object());
}
