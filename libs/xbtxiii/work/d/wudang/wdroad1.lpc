#pragma save_binary
// wdroad1.c
// by Xiang

inherit ROOM;

void create() {
  set("coor", ({ -380, -1250, 0 }));
  set("short", "青石大道");
  set("long",
    "你走在一条青石大道上，人来人往非常繁忙，不时地有人骑着马\n"
    "匆匆而过。大道两旁有一些小货摊，似乎是一处集市。东北边通\n"
    "向扬州城。\n"
  );
  set("outdoors", "wudang");

  set("exits", ([
    "south": __DIR__ "wdroad2",
    //       "northeast" : "/d/yangzhou/trace2",
    "east": "/d/manglin/edge1",
  ]));
  set("objects", ([
    __DIR__ "npc/yangxiao": 1,

  ]));

  setup();
  replace_program(ROOM);
}
