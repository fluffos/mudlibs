#pragma save_binary
// /d/wudang/shanmen.c 武当山门
// By rongg

#include <ansi.h>
inherit ROOM;

void create()
{
	set("coor",({-550,-1200,0}));
	set("short", "武当山门");
	set("long",
"你的面前是一座林木繁茂的高山，几座山峰在云雾中隐约可见，\n"
"一条石阶向山上延伸，走着几个进香客。石壁上写着“武当山”\n"
"三个大字，原来这就是天下闻名的武当山。武当山的风景真是美\n"
"丽如画，到处都是奇蜂，怪石，到处都是花花草草，鱼虫鸟兽，\n"
"好不热闹。\n"
);

        set("outdoors", "wudang");

	set("exits", ([
       "east"     : __DIR__"wdroad8",
       "westup"   : __DIR__"shijie11",
	            ]));
        set("objects", ([
                              __DIR__"npc/xiaofu" : 1,//纪晓芙
                              __DIR__"npc/buhui" :1,  //不悔
                              __DIR__"npc/butterfly" : 5,//蝴蝶
                       ]));
	setup();
	
}
void init()
{
        add_action("do_seize",({"zhua","抓","seize"}));
}


int do_seize(string arg)
{
        object wing,obj;

if(arg !="butterfly")
          return notify_fail("你要抓什么啊?");

if(!objectp(obj =present(arg,environment(this_player())))
        &&arg=="butterfly")
                return notify_fail("请睁大你的双眼！还有蝴蝶吗???");
   else
     {
     switch(random(3))
       {
         case 0:
            message_vision(""+this_player()->query("name")+"折腾了半天，一只蝴蝶也没有抓住,自己倒累个半死\n",this_player());
            break; 
         case 1:
           message_vision(""+this_player()->query("name")+"折腾了半天终于捉到了一只蝴蝶，却又跑掉了。\n",this_player());
             break;
          default :
              message_vision(""+this_player()->query("name")+"折腾了半天终于捉到了一只蝴蝶，却不小心弄死了。\n
只剩下一片蝴蝶的翅膀\n",this_player());
              obj->die();
              wing=new(__DIR__"obj/wing");
              wing->move(this_player()); 
              break; 
      }  
    if(this_player()->query("kee")>=50) 
        this_player()->add("kee",-50);
    else 
        {
        this_player()->unconcious();
        remove_action("do_seize","zhua");
        remove_action("do_seize","seize");
        }

   return 1; 
   }    
}    


