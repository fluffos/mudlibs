#pragma save_binary
// xiaolu1.c 林间小径
// by Xiang

inherit ROOM;

void create()
{
	set("coor",({-650,-310,4300}));
	set("short", "林间小径");
	set("long",
"你走在一条小径上，两旁种满了竹子，修篁森森，绿荫满地，除\n"
"了竹叶声和鸟鸣声，听不到别的动静。\n"
);

	set("exits", ([
		"north" : __DIR__"xiaolu2",
		"south" : __DIR__"zijincheng",
	]));
        set("outdoors", "wudang");
	setup();
	replace_program(ROOM);
}

