#pragma save_binary
// xiaoyuan.c 后山小院
// by rongg
#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  int t, d, h, m, s;
  object zhang, room;
  t = uptime();
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;
  add_light(this_object(), 1);
  set("coor", ({ -650, -200, 4300 }));
  set("short", "金殿");
  set("long",
    "这是后山的一座小院，布置简简单单，除了一床、一桌、一椅、\n"
    "一蒲团，再也没有别的什物。比较引人注目的是墙上挂着一把剑。\n"
    "这里就是武当开山祖师张三丰的练功所在。因为这里是张三丰常\n"
    "住的地方，人们把这里叫做金殿。\n"
  );

  set("no_clean_up", 1);
  set("exits", ([
    "south": __DIR__ "xiaolu2",
    "north": __DIR__ "wc",
  ]));
  set("objects", ([
    "/daemon/class/wudang/zhangsanfeng": 1 ]));
  create_door("south", "竹门", "north", DOOR_CLOSED);
  setup();
  zhang = find_living("zhang sanfeng");
  if (!zhang || !environment(zhang)) {
    if (m >= 0 && m < 20) {
      zhang = new("/daemon/class/wudang/zhangsanfeng");
      zhang->set("i_am_in_room", "chashi");
      zhang->set("short", "张三丰 (zhang sanfeng)" + HIR "<正在喝茶>" NOR + "");
      zhang->move(__DIR__ "chashi");
    } else if (m >= 20 && m < 40) {
      zhang = new("/daemon/class/wudang/zhangsanfeng");
      zhang->set("i_am_in_room", "wc");
      zhang->set("short", "张三丰 (zhang sanfeng)" + HIR "<正在大便>" NOR + "");
      zhang->move(__DIR__ "wc");
    } else if (m >= 40 && m < 59) {
      zhang = new("/daemon/class/wudang/zhangsanfeng");
      zhang->set("i_am_in_room", "xiaoyuan");
      zhang->delete("short");
      zhang->set("short", "张三丰 (zhang sanfeng)" + HIR "<正在练功>" NOR + "");
      zhang->move(__DIR__ "xiaoyuan");
    }

  }
}
void init() {
  object me, zhang;
  me = this_player();
  zhang = present("zhang sanfeng", environment(me));
  if (zhang && !userp(zhang))
    call_out("zhang_message", 1, me);
}

void zhang_message(object me) {
  object zhang;
  zhang = present("zhang sanfeng", environment(me));
  if (zhang && !userp(zhang)) {
    switch (random(5)) {
      case 0:
        message("vision", CYN "张三丰双拳虚抱，左手由下上挑，右手内合，凭空打去。。\n"
          "正是太极拳中的一招 「手挥琵琶」。。\n" NOR, me);
        break;
      case 1:
        message("vision", CYN "张三丰左脚一个弓箭步，右手上举向外撇出，正是一招 「闪通臂」\n" NOR, me);
        break;
      case 2:
        message("vision", CYN "张三丰低头沉思，象是遇到了什么功夫上的难题。片刻。他脸上浮出笑容。\n"
          "只见他双手握拳，向前向后划弧，一招 双峰贯耳 使得虎虎生风。。\n" NOR, me);
        break;
      case 3:
        message("vision", CYN "张三丰擦了擦额头上的汗水。。。。\n" NOR, me);
        break;
      case 4:
        message("vision", CYN "张三丰右手由钩变掌，双手掌心向上，右掌向前推出一招「高探马」\n" NOR, me);
        break;
    }
  }
}
