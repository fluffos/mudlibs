#pragma save_binary
// wdroad6.c 黄土路
// by Xiang

inherit ROOM;

void create()
{
	set("coor",({-400,-1200,0}));
	set("short", "黄土路");
	set("long",
"你走在一条尘土飞扬的黄土路上，两旁是阴森森的树林。这里是\n"
"湖北境界，据说经常有土匪出没，不可久留。\n"
);
        set("outdoors", "wudang");

	set("exits", ([
		"northeast" : __DIR__"wdroad5",
		"west" : __DIR__"wdroad7",
	]));

	setup();
	replace_program(ROOM);
}

