#pragma save_binary
// tyroad8.c 桃园小路
// by Marz 

inherit ROOM;

void create()
{
	set("short", "桃园小路");
	set("long",
"眼前豁然开朗，你轻松地走在桃园边的小路上。两边是桃树林，\n"
"树上盛开着粉红的桃花，红云一片，望不到边。不时有蜜蜂「嗡\n"
"嗡」地飞过，消失在在花丛中；几只猴子在树上互相追逐着，叽\n"
"叽喳喳地争抢桃子。这是武当山脚，西边有条陡峭的山路，通向\n"
"山顶。\n"
);
	set("outdoors", "wudang");

	set("exits", ([
		"westup" : __DIR__"tyroad7",
		"east" : __DIR__"tyroad9",
		"north" : __DIR__"tynroad",
		"south" : __DIR__"tysroad",
	]));

	setup();
}
