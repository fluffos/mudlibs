#pragma save_binary
// wdroad8.c 黄土路
// by Xiang

inherit ROOM;

void create() {
  set("coor", ({ -490, -1200, 0 }));
  set("short", "黄土路");
  set("long",
    "你走在一条尘土飞扬的黄土路上，两旁是阴森森的树林。西边是\n"
    "一座高山。\n"
  );
  set("outdoors", "wudang");

  set("exits", ([
    "east": __DIR__ "wdroad7",
    "west": __DIR__ "shanmen",
    "southwest": __DIR__ "mingjiao/gebitan1",
  ]));
  set("objects", ([
    __DIR__ "npc/yetu": 4 ]));

  setup();
}
