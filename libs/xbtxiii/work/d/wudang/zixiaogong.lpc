inherit ROOM;

void create() {
  set("coor", ({ -600, -750, 3600 }));
  set("short", "紫霄宫");
  set("long",
    "在你的面前是一座道观，上面写着“紫霄宫”三个朱红色的大字，\n"
    "由此往内就是武当的庙产了，现在进香的人明显少了，而穿不同\n"
    "服色的道士确不断进进出出，诵经的声音隐隐传来。\n"
  );
  set("outdoors", "wudang");

  set("exits", ([
    "southdown": __DIR__ "shibapan",
    "northup": __DIR__ "shijie61",
  ]));
  set("objects", ([
    CLASS_D("wudang") + "/zhike": 1 ]));
  setup();
  replace_program(ROOM);
}
