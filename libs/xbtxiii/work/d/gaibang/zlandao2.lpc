			"northeast" : __DIR__"undergb",
			"southwest" : __DIR__"zlandao1",	
	]));

	set("objects",([
		"/obj/food/jitui" : 3,
		"/obj/food/jiudai" : 1,
	]));

	setup();
	replace_program(ROOM);
}



