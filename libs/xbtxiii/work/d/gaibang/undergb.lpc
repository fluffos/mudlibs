#include <room.h>
inherit ROOM;




void create()
{
	set("coor",({200,-2050,-10}));
	set("short","破庙密室");
	set("long",
"这是丐帮重要密道之一。由此上往，可直达破庙。四周光线昏暗，\n"
"似乎有几个黑暗的洞口在你身边。脚下地上扔满了垃圾，踩上去\n"
"悉悉索索地响。\n"
);

	set("exits", ([
		"up" : "/d/yangzhou/pomiao",
		"southwest":__DIR__"zlandao2",
	]));

	setup();
	replace_program(ROOM);
}



