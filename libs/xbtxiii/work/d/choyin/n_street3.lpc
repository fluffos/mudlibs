inherit ROOM;

void create() {
  set("coor", ({ 3500, 3250, 0 }));
  set("short", "福林大街");
  set("long",
    "你现在正走在一条宽敞的大街上，街道往北边笔直地延伸，南边\n"
    "则是一个隆起的石台，你可以看见石台前有块石碑，上书「树王\n"
    "坟」三个大字，街道的东边和西边都是石板空地，围绕著树王坟\n"
    "成为一个圆环，许多小贩客商都聚集在这里交易买卖。\n"
  );
  set("exits", ([ /* sizeof() == 3 */
    "west": __DIR__ "nw_street",
    "north": __DIR__ "n_street2",
    "south": __DIR__ "tree_tomb",
  ]));
  set("objects", ([
    __DIR__ "npc/dumpling_seller": 1,
  ]));
  set("outdoors", "choyin");

  setup();
}
