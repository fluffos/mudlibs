#pragma save_binary
// grass.c

inherit ITEM;

void create()
{
        set_name("忘忧草", ({ "grass" }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "棵");
                set("long", "一棵醉人的忘忧草。\n");
                set("material", "paper");
                set("value", 100);
        }
        setup();
}
