"任守卫的工作，往下可以回到二楼。\n"
);
	set("exits", ([ /* sizeof() == 1 */
		"down" : __DIR__"hotel2",
	]));
	set("objects", ([
		__DIR__"npc/guard": 3
	]) );

	setup();
	replace_program(ROOM);
}
