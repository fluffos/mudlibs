inherit ROOM;

void create()
{
	add_light(this_object(),1);
	set("coor",({3520,3100,10}));
	set("short", "福林酒楼");
	set("long",
"这里是福林酒楼的客房，住的都是一些从外地来的富商大贾，为\n"
