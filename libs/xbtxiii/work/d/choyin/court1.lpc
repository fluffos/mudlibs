#pragma save_binary
// Room: /d/choyin/court1.c
#include <room.h>
inherit ROOM;

void create()
{
	set("coor",({3350,3070,0}));
	set("short", "县府衙门");
	set("long",
"这里是乔阴县府衙门的大门，就像你印象中的衙门一般，高大的\n"
"大门、两只巨大的石狮、以及一种令人为之肃然的气氛。门口有\n"
"一面大皮鼓(drum)，不用说，这当然是让百姓击鼓申冤用的，乔\n"
"阴县的知县据说是槐阳王的侄子，虽然算不上是包青天，不过倒\n"
"也没有听说过有什么贪赃枉法的劣迹。\n"
);
         set("item_desc", ([ /* sizeof() == 1 */
             "drum" : "\n  击鼓申冤   beat\n",
]));
        set("outdoors", "choyin");
	set("exits", ([ /* sizeof() == 1 */
		"south" : __DIR__"crossroad",
        ]));
	set("outdoors", "choyin");
	set("objects", ([
		__DIR__"npc/judge_gu.lpc" : 4,
//          __DIR__"npc/magistra.lpc" : 2 
	]) );

	setup();
//	replace_program(ROOM);
}


