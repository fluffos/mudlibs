inherit ROOM;

void create() {
  set("coor", ({ 3500, 3100, 0 }));
  set("short", "福林大街");
  set("long",
    "这里是乔阴县城的福林大街，东首一栋雕梁画栋，美仑美奂的华\n"
    "厦便是乔阴县最大的酒楼「福林楼」，不但乔阴县城的富商大贾\n"
    "常来此楼饮宴，就连方圆百里内的许多豪门巨绅也常常到这里喝\n"
    "酒，西边是一条宽敞的青石官道，通往县府衙门，街道往南则是\n"
    "热闹的南门广场。\n"
  );
  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "s_street3",
    "south": __DIR__ "s_street1",
    "east": __DIR__ "hotel1",
  ]));
  set("objects", ([
    "/d/choyin/npc/tea_vendor": 1,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "choyin");

  setup();
  replace_program(ROOM);
}
