inherit ROOM;

void create() {
  set("coor", ({ 3650, 3200, 0 }));
  set("short", "东城门");
  set("long",
    "这里乔阴县城的东门，一座高大的石牌楼上面刻著「东门」两个\n"
    "大字，东边一条土路青郁郁地通往南边的山上，石牌楼旁蹲著一\n"
    "只铁狮.与南北两城门相比,东门这一带显得比较冷清，偶见几个\n"
    "采药,砍柴之人由此出入。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "e_street1",
    "east": __DIR__ "solidpath1",
  ]));
  set("objects", ([
    __DIR__ "npc/cityguard": 2,
    __DIR__ "npc/ghost": 1,
  ]));
  set("outdoors", "choyin");

  setup();
  replace_program(ROOM);
}
