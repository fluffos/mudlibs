#pragma save_binary
#include <room.h>
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "寒谷");
  set("long",
    "两面皆为峭壁，光滑无物。一阵寒谷幽香，沁人心脾，却不知来\n"
    "自何方。。。寒谷正中有一棵神木(tree)，看来与众不同！！！\n"
  );
  set("item_desc", ([

    "tree":
    "这是一株千年神树，寻常人等休想砍(kan)动它.\n"

  ]));
  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "hollow1",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/serpent": 2,
  ]));
  setup();
}

void init() {
  add_action("do_kan", "kan");
}

int do_kan(string arg) {
  if (!arg || arg != "tree")
    return notify_fail("你要砍什么？\n");
  message_vision("$N拿起兵器，运功使劲砍千年神木....\n",
    this_player());
  if (random((int)this_player()->query("force")) < 500) {
    message_vision("\n$N砍了半天，神树一点伤痕也没有。。\n
", this_player());
    this_player()->set("force", 0);
  } else {
    message_vision("$N砍了半天，终于砍倒神树了\n",
      this_player());
    this_player()->add("force", -500);
    set("long", @LONG
两面皆为峭壁，光滑无物。一阵寒谷幽香，沁人心脾，却不知来自何方。。。
    寒谷正中有一棵神木的树桩。
LONG);
    set("item_desc", 0);
    remove_action("do_kan", "kan");
    new("/d/npc/m_weapon/tan/item/shenmu")->move(this_player());
  }
  return 1;
}
