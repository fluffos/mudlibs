#pragma save_binary
// Room: /d/choyin/hotel2.c

inherit ROOM;

void create()
{
	add_light(this_object(),1);
	set("coor",({3520,3100,5}));
	set("short", "福林酒楼");
	set("long",
"这里是福林酒楼的二楼雅座，这里的客人大多衣冠鲜明，若不是\n"
"富豪巨绅，便是秀才举人，使你不知不觉跟著斯文起来，从这里\n"
"可以眺望乔阴县城的市景，东边不远处隔著几栋建筑便是县府衙\n"
"门，南边是碧波荡漾的翠柳湖，湖对岸的雨桥庄在柳树间若隐若\n"
"现，东边许多民房，再过去便是一方方的稻田，北边可望见树王\n"
"坟的石台，以及乔阴县城北的建筑。你可以沿角落的方梯回到一\n"
"楼，或者到三楼的客房。\n"
);
	set("exits", ([ /* sizeof() == 2 */
		"up" : __DIR__"hotel3",
		"down" : __DIR__"hotel1",
	]));
	set("objects", ([
		__DIR__"npc/youngman": 1,
		__DIR__"npc/servant": 3
	]) );

	setup();
	replace_program(ROOM);
}
