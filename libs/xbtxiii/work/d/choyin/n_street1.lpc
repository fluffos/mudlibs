#pragma save_binary
// Room: /d/choyin/n_street1.c

inherit ROOM;

void create() {
  set("coor", ({ 3500, 3350, 0 }));
  set("short", "福林大街");
  set("long",
    "你现在正走在一条宽敞的街道上，这里是乔阴县城联通北门与南\n"
    "门的福林大街，街道两旁有做生意的，有做粗活的，这里的老百\n"
    "姓大多是老老实实的农人与工匠，街上卖的也多半是一些日用品，\n"
    "往东边是一条小巷子，南边的街道似乎比较热闹一些，北边则是\n"
    "北门。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "n_street2",
    "north": __DIR__ "n_gate",
  ]));
  set("objects", ([
    __DIR__ "npc/cake_vendor": 1,
    CLASS_D("beggar") + "/master": 1
  ]));
  set("outdoors", "choyin");

  setup();
  replace_program(ROOM);
}
