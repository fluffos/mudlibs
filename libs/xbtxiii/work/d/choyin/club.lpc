#pragma save_binary
// Room: /d/choyin/club.c
# include <room.h>
# include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "草堂");
	set("long",
"一间由白茅草搭成的草堂，室内仅有一竹榻，一矮几，四把竹椅\n"
"．堂前一幅拓片装裱精致，上书:书有未曾经我读事无不可对人\n"
"言矮几上摊有书卷(books)放着一支朱砂笔，一房歙砚竟题有岳\n"
"武穆藏，另几张上好生宣．\n"
);
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"yard.lpc",
  "east" : __DIR__"fence.lpc",
]));
        set("no_fight", 1);
        set("no_magic", "1");
        set("item_desc", ([
                "books" : @TEXT
几上的书信手而放，装帧古朴，竟是宋版书，还有几卷汉碑原拓。你按捺不住好奇心想拿
起来(scratch)仔细研究一番。
TEXT
]));     

        create_door("east", "柴门", "west" , DOOR_CLOSED);    

		setup();
}

void init()
{
   add_action("do_pray","pray");
   add_action("do_dance","dancing");
   add_action("do_home","home");
   add_action("do_tie","tie");
   add_action("do_scratch","scratch");
}

int do_dance(string arg)
{
     message_vision("也不知道隐士怎么弄的，$N无法跳出专注的舞步。\n",
                this_player());   
      return 1;
}               

int do_pray(string arg)
{
     message_vision("也不知道隐士怎么弄的，$N的玛瑙手镯不灵验了。\n",
                this_player());       
    return 1;
}               
int do_home(string arg)
{
          if(!wizardp(this_player())){
     message_vision("也不知道隐士怎么弄的，$N的神蛇走不出这里。\n",
                this_player());       
    return 1;
        }
        return;
}

int do_tie(string arg)
{
     message_vision("也不知道隐士怎么弄的，$N的捆仙绳不灵验了。\n",
                this_player());       
    return 1;
}
int do_scratch(string arg)
{ 
  object book;
  object ob;

  ob = this_player();

  if( !arg || arg!="books" ) 
  return 0;
  if( query("book")>=100 ) return notify_fail("这里的书都给人偷完了，你什么都没有拿到。\n"); 
  else
     { 
	  message_vision("$N乘人不备，抓起一本书藏入怀中。\n\n",
                this_player()); 

                add("book",1);
  	   switch( random(3) ) {
                case 0: book = new("/d/choyin/npc/obj/book1");
                        book ->move(ob);
						book->set("chaoyin","NO_GET");
                        break;
                case 1: book = new("/d/choyin/npc/obj/book1");
                        book ->move(ob);
						book->set("chaoyin","NO_GET");
                        break;
                case 2: book =new("/d/choyin/npc/obj/book2");
                        book ->move(ob);
						book->set("chaoyin","NO_GET");
                        break; 
 	                      }
	  }	
  return 1;
}


int valid_leave(object me, string dir)
{   
        object *obj;
		int i;
		obj=all_inventory(me);
for(i=0;i<sizeof(obj);i++)
		{
        if(obj[i]->query("id")=="book"&&obj[i]->query("chaoyin")=="NO_GET")
			{
			tell_object(me,HIC"你将"+obj[i]->name()+"放回原处.\n"NOR);	
        me->set_explore("north#17");
                        add("book",-1);
			destruct(obj[i]);
			}
		else continue;
		}
        tell_object(me, "你离开草堂!\n" NOR );
        return 1;
} 
