inherit ROOM;

void create() {
  set("coor", ({ 65, 4920, 10 }));
  set("short", "小路");
  set("long",
    "一条看来相当荒凉的小路,两旁杂草丛生,好像很久都没有人来过\n"
    "的样子.往南很远的地方可以看到村子的入口,往北的路似乎不是\n"
    "很明显.\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": "/d/green/path0",
    "south": "/d/green/path2",
  ]));
  set("outdoors", "green");

  setup();
  replace_program(ROOM);
}
