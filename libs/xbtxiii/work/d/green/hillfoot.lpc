inherit ROOM;

void create() {
  set("coor", ({ 300, 4750, 10 }));
  set("short", "野羊山脚");
  set("long",
    "这是野羊山的山脚，往北去就是野羊山。抬头仰望，只见山上树\n"
    "木郁郁葱葱。半山腰里似乎有一个山寨。山顶上有一个旗杆，上\n"
    "面飘摆着一面红色的锦缎大旗，旗面上隐隐约约写着几个大字，\n"
    "但因为距离太远看得不是十分清楚。路边有一块木牌(sign)，上\n"
    "面写了些字。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": "/d/ny/bforest/road2",
    "northup": __DIR__ "hpath1",
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
    "sign": "牌子上写道：
   奉乔阴府巡抚大人令：本府大小人等，有于野羊山匪徒私通者，立
斩不赦！有擒获通缉要犯淳于导者，赏黄金500两。擒获李火龙者赏黄
金100两，擒获刘三者，赏黄金50两。凡拿住其它大小头目，匪众，一
律赏纹银500两。
",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "snow");

  setup();
  replace_program(ROOM);
