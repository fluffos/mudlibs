#include <roadbusy.h>

inherit ROOM;

void create() {
  set("coor", ({ 300, 4760, 15 }));
  set("short", "山路");
  set("long",
    "这是一条羊肠小道，四面林木茂盛。前后一个人影都看不见。从\n"
    "树林深处不时传来奇怪的鸟叫声.\n"
  );
  set("exits", ([ /*sizeof()=2*/
    "southdown": __DIR__ "hillfoot",
    "northup": __DIR__ "hpath2",
  ]));
  setup();
  //        replace_program(ROOM);
}
