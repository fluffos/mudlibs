#pragma save_binary
// lei.c

inherit NPC;

void create() {
  set_name("雷猛", ({ "lei meng", "lei", "meng" }));
  set("title", "寨门护卫");
  set("gender", "男性");
  set("age", 35);
  set("long", "你看到一个剽悍的大块头, 正在恶狠狠地瞪着你.\n");
  set("str", 29);
  set("int", 14);
  set("combat_exp", 5000);
  set("attitude", "heroism");
  set_skill("unarmed", 150);
  set_skill("parry", 80);
  set_skill("dodge", 100);

  set("inquiry", ([
    "野羊山": "这里就是野羊山。",
    "进山寨": "想进山寨？先问问我的拳头答不答应！",
  ]));

  setup();
  add_money("silver", 10);
  add_money("coin", 500);
  carry_object("/obj/cloth")->wear();
  carry_object("/u/cloud/obj/npc/butcher/knife");
  carry_object("/u/cloud/obj/npc/butcher/skin_belt")->wear();
}

void init() {
  object ob;
}
