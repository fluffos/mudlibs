void die() {
  int i;
  object killer;
  object room;

  if (objectp(killer = query_temp("last_damage_from")))
    killer->set_temp("marks/杀雷", 1);
  if (room = find_object("/d/green/fortgate"))
    room->set("exits/north", "/d/green/fort1");
  else return;

  message("vision", "寨门吱呀呀地打开了......\n", room);
  ::die();
}
