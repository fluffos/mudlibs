#pragma save_binary
// gangster.c

inherit NPC;

string kill_passenger(object who);

void create()
{
     string *surname = ({"王","李","张","刘","唐","卜","杨","吴","蒋","龙"
,"林","陈","熊"});
	string *fname = ({"俊","杰","英","豪","辉","雄","远","开"});

   set_name((surname[random(13)])+"人"+(fname[random(8)]), ({ "blader" }) );
       set("title","野羊寨刀手");
	set("gender", "男性" );
        set("age", 27);
        set("str", 27);
        set("int", 12);
        set("per", 10);
        set("long", @LONG
这刀手满脸伤疤，虎背熊腰，一脸凶狠而霸道的样子。
LONG
);
        set("attitude", "heroism");

        set("combat_exp", 15000);

        set("inquiry", ([
                "买路钱": 
"看你也不象有钱的样子，大爷我只要十两金子意思一下。\n",
        ]) );

//        set("chat_chance_combat", 1);
//        set("chat_msg_combat", ({
//              "强盗显是以劫为生，刀刀冲要害而来。\n",
//              "强盗高喊：叫你人财两空。\n",
//        }) );

        set_skill("unarmed", 100);
        set_skill("blade", 60);
        set_skill("dodge", 100);
        set_skill("parry", 100);


        setup();

        add_money("silver", 10); 
        carry_object("/u/cloud/obj/npc/gangster/blade")->wield();
        carry_object("/obj/cloth")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( ob->query_temp("marks/杀雷") ) {
                kill_passenger(ob);
        ob->delete_temp("marks/杀雷");
        }
}


string kill_passenger(object who)
{
	object room;

	if(room = find_object("/d/green/fort1"))
		room->delete("exits/south");
//        set("pursuer", 1);
        set("attitude", "aggressive");
        set("chat_chance_combat", 15);
        set("chat_msg_combat", ({
                "\n",
                "刀手高喊：杀了雷猛，你休想活着出去。\n",
        }) );
        kill_ob(who);
        return 0;
}

int accept_fight(object me)
{
        command("say 竟敢太岁爷头上动土？纳命来！");
        command("grin");
        kill_passenger(me);
        return 1;
}

  void die()
{
  object room;
  room = find_object("/d/green/fort1");
    room->set("exits/south","/d/green/fortgate");
    ::die();
}
 
