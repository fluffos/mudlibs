// Room: /d/green/fortgate.c
#include <room.h>
inherit ROOM;
void create() {
  set("short", "寨门");
  set("long",
    "这是山寨的大门，门口有一个凶神恶煞的大汉。寨门紧闭，隐约\n"
    "听见寨子里人喊马嘶，一片喧哗。\n"
  );
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "fortgate",
  ]));
  set("objects", ([ /* sizeof() == 2 */
    __DIR__ "npc/guard": 5,
    __DIR__ "npc/lei": 1,
  ]));
  set("outdoors", "green");
  setup();
}

