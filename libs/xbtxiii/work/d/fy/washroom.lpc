"衣店微薄的收入维持生\n"
);
        set("exits", ([ /* sizeof() == 1 */
  "north" : __DIR__"ecloud3",
]));

        set("item_desc", ([
                "sign": @TEXT

现在正紧缺人手，急需雇佣一批短工来干活。
ｗｏｒｋ　开始工作。
TEXT
        ]) );
        set("objects", ([
//       __DIR__"npc/taipo" : 1,
                        ]) );
