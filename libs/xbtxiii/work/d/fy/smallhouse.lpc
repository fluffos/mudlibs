#pragma save_binary
// smallhouse.c madam.c(夫人)的家

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("coor", ({ -75, -10, 0 }));
  set("short", CYN "一间小屋" NOR);
  set("long",
    "一间很普通的屋子，屋子里的摆设却也颇讲究。墙上挂了几幅山\n"
    "水画，虽然不是出自名家之手。但也是韵味十足.看来此处的主\n"
    "人并非普通百姓..\n"
  );
  set("exits", ([
    "north": __DIR__ "xiaohutong",
  ]));
  setup();
  create_door("north", "小木门", "south", DOOR_CLOSED);

}
