#pragma save_binary
inherit ROOM;
void create() {
  add_light(this_object(), 1);
  set("coor", ({ 15, 95, 0 }));
  set("short", "镖局厢房");
  set("long",
    "房间里布置很简单，只有一张小床，一个小几，和几张方凳。窗\n"
    "台上放着一个磁杯，杯里插着几枝无名小花。房间虽不大，但是\n"
    "给人整洁舒适的感觉。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "ginhall",
  ]));
  set("objects", ([

    __DIR__ "npc/resting_biao": 2,
  ]));
  setup();
}
