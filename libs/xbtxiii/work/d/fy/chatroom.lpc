inherit ROOM;
string look_sign(object me);
void create()
{
        add_light(this_object(),1);
        set("coor",({0,10,100}));
        set("short", "雄霸天下聊天室");
        set("long",
"这里放着一张茶几，还有几张沙发，专门供闲的无聊的人在这里\n"
"侃大山。在这里面呆着是不会长岁数的。茶几上面放了一张小纸\n"
"条(paper).再往上面走就是著名的雄霸天下II的儿童乐园.\n"
);
    set("exits", ([ /* sizeof() == 4 */
                        "out":__DIR__"gameroom",
			"up":"/d/gameroom/center",//儿童乐园
                        "1":__DIR__"room/chatroom1",
                        "2":__DIR__"room/chatroom2",
                        "3":__DIR__"room/chatroom3",
                        "4":__DIR__"room/chatroom4",
                        "5":__DIR__"room/chatroom5",
        ]));
    set("item_desc", ([
        "paper": (: look_sign :),
        "纸条":     (:look_sign:),
        "小纸条":     (:look_sign:),    
    ]) );
    set("no_death_penalty",1);
    set("no_fight",1);
    set("no_magic",1);
    set("no_arrest",1);
    set("no_die",1);
    set("chat_room",1);
    set_temp("light",1);
    setup();
}

int init()
{
        add_action("do_command", ""); 
        add_action("do_apply","apply");
}

int do_apply(string arg)
{
        object me,env,chatroom;
        mapping room;
        me=this_player();       
if(!arg)
        {
        tell_object(me,"如果要申请一个机密室聊天的话要交20两黄金。\n");  
        tell_object(me,"申请手续办完之后你就是你所申请的机密室暂时的主人\n"
                                        "在那里你可以邀请(invite)别人加入你的聊天行列。\n"
                                        "同时也可以把你不喜欢的人逐出去(kickout)\n");
        return 1;
        }
        env=environment(me);
if( !mapp(room = env->query("exits")) || undefinedp(room[arg]) ) 
        {
        tell_object(me,"没有这间房间。请你指定一个房间。好吗？\n"
                                        " 例如：apply <房间代号>\n");
        return 1;
        }
        chatroom=room[arg];
if(!chatroom->query("chat_room"))
        {
        tell_object(me,"这间房间不是聊天室。\n");       
        return 1;
        }
if(chatroom->query("op_id"))
        {
        tell_object(me,"非常抱歉。你要申请的这间房间已经有人了。\n"
                        "如果你想加入他们的话可以让他们邀请(invite)你加入\n");
        
        return 1;
        }
if(!me->can_afford(200000))
        {
        tell_object(me,"如果申请一间房间的主人的话要20两黄金。\n"
                                        " 可惜你的钱不够。\n");
        return 1;
        }
        chatroom->set("op_id",me->query("id"));
        me->pay_money(200000);
        tell_object(me,"好的。你申请了这间房间。如果你要邀请别人。\n"
                                        "请进入房间用(invite <英文id>)来邀请别人进入\n"
                                        "你的房间。没有被邀请的人是无法进入你的房间的。\n"
                                        "祝你聊天聊的开心。\n");
        return 1;
}
int do_command()
{
        string *limit=({
                "study","pratice","read","selflearn","research","kill",
                "exert","cast","beg","perform","du","conj",
                "give","drop","do","to","steal",
                "use","check","","selflearn","research","kill",
                });
        if(member_array(query_verb(),limit)!=-1)
            return !wizardp(this_player());
        return 0;
}


int die_in_here(object me)
{
        if( userp(me) ) me->revive(1);
        CHANNEL_D->do_channel( this_object(), "rumor",
            sprintf("%s被口水淹死了。", me->name()) );
        message( "vision", me->name()+"脚下一个不稳，当场给气昏了。\n", environment(me), ({me}) );
        me->remove_all_killer();
        all_inventory(this_object())->remove_killer(me);
        me->dismiss_team();
        me->reincarnate();
        me->unconcious();
        return 1;
}
int valid_leave(object me, string dir)
{
        if(me->is_fighting()) return 0;
        return 1;
}

string look_sign(object me)
{
        return "可以申请(apply)房间作为单独的聊天室\n";
}

