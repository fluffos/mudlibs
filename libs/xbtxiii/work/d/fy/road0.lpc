#pragma save_binary
inherit ROOM;
void create()
{
        set("coor",({0,-200,0}));
	set("short", "南北大道");
        set("long",
"这是风云城的一条主要大道。它上穿白山黑水，直达松花江。下\n"
"接风云京都，再通江南海口。这条干线上商旅不绝。一条车痕向\n"
"南方和北方伸展。\n"
);
        set("exits", ([ 
  "north" : __DIR__"sgate",
  "south" : __DIR__"sroad1",
]));
        set("outdoors", "laowu");
        setup();
}
void init()
{
	add_action("do_go","go");

}

int do_go()
{
if(random(3)){
this_player()->move(this_object());
return 1;
}
}
int valid_leave(object me, string dir)
{       object ob;
        object *inv;
        int i;
if (dir=="north"&&ob=present("soldier", this_object()))
{
if (ob->query("leader")==me->query("name")&&
    me->query("rank")==1) return 1;
else{
                inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)               
 {if (((inv[i]->query("targetid")) == me->query("id"))
        &&((string)(inv[i]->query("id")) == "token"))
        return 1;
 }              
return notify_fail(ob->name()+"向你嚷道：奉"+
ob->query("leader")+"之命封锁此路!没有通行证不得通过!\n");
    }
}
else return 1;  
}       
