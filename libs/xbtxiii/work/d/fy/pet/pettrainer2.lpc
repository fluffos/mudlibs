// Tie@fy
#include <ansi.h>
inherit NPC;
void create() {
  set_name("高人", ({ "gaoren" }));
  set("gender", "男性");
  set("title", "半仙兽");
  set("age", 32);
  set("long", "一个得半道的老道士，对改善动物的体质别有妙技。(train)\n他还免费帮宠物洗杀气。(salute)\n");
  set("combat_exp", 5000);
  set("attitude", "friendly");
  setup();
  carry_object("/obj/cloth")->wear();

}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_train", "train");
  add_action("do_ponder", "salute");

}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(5)) {
    case 0:
      say("高人说道：这位" + RANK_D->query_respect(ob)
        + "，来陪我聊一聊？\n");
      break;
    case 1:
      say("高人笑道：这不，生意来了！\n");
      break;
    case 2:
      say("高人说道：这位" + RANK_D->query_respect(ob) + "与我有缘，我可以免费帮你的宠物洗杀气!\n");
      break;
  }
}

int do_train(string arg) {
  object me, pet;
  int cost;
  string which, which2, which3, save_file, id;
  me = this_player();
  id = me->query("id");
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if (!arg) return notify_fail("高人道：＂你要训练什么呀？＂\n");
  pet = present(arg, environment());
  if (!objectp(pet)) return notify_fail("高人道：＂你要训练什么呀？＂\n");
  save_file = pet->query_save_file();
  if (save_file != sprintf(DATA_DIR "pet/%c/%s", id[0], id + ".o"))
    return notify_fail("高人道：＂您训练的似乎不是你的宠物吧？＂\n");
  switch (random(3)) {
    case 0: which = "max_gin"; which2 = "eff_gin"; which3 = "gin"; break;
    case 1: which = "max_kee"; which2 = "eff_kee"; which3 = "kee"; break;
    case 2: which = "max_sen"; which2 = "eff_sen"; which3 = "sen"; break;
  }
  //okey we identified the target, now the cost:
  cost = (int)pet->query(which) / 10;
  cost *= cost;
  if (cost <= 0) cost = 10;
  tell_object(me, "cost is " + cost * 50 + "\n");
  if (!me->can_afford(cost * 50))
    return notify_fail("你没有那么多钱\n");
  me->pay_money(cost * 50);
  pet->add(which, 10);
  pet->set("sen", pet->query("max_sen"));
  pet->set("kee", pet->query("max_kee"));
  pet->set("gin", pet->query("max_gin"));
  pet->set("eff_gin", pet->query("max_gin"));
  pet->set("eff_kee", pet->query("max_kee"));
  pet->set("eff_sen", pet->query("max_sen"));
  //	pet->setup();
  pet->save();
  //	msg="这种小东西，你就交给我磨练磨练吧。\n"
  command("say 这就得了！\n");
  return 1;
}


int do_ponder(string arg) {
  object me, pet;
  string save_file, id;
  me = this_player();
  id = me->query("id");
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if (!arg) return notify_fail("高人道：＂你要训练什么呀？＂\n");
  pet = present(arg, environment());
  if (!objectp(pet)) return notify_fail("高人道：＂你要训练什么呀？＂\n");
  save_file = pet->query_save_file();
  if (save_file != sprintf(DATA_DIR "pet/%c/%s", id[0], id + ".o"))
    return notify_fail("高人道：＂您训练的似乎不是你的宠物吧？＂\n");
  if ((int)pet->query("sen") <= 10)
    return notify_fail("你宠物的神不够。\n");
  message_vision("高人将$N的宠物训练了一下。\n", me);
  pet->receive_damage("sen", 10);
  if ((int)pet->query("bellicosity") > 0)
    pet->add("bellicosity", -(random((int)me->query("kar")) + 7));
  message_vision("$N的宠物身上的杀孽之气似乎轻了。 \n", me);
  pet->save();
  return 1;
}
