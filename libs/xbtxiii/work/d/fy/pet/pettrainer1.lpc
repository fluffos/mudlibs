// Tie@fy
#include <ansi.h>
inherit NPC;
void create() {
  set_name("矮老头", ({ "airen" }));
  set("gender", "男性");
  set("title", "驯兽师");
  set("age", 32);
  set("long", "一个驯兽师，对驯服动物使它们更加听话很有一手。(train)\n");
  set("combat_exp", 5000);
  set("attitude", "friendly");
  setup();
  carry_object("/obj/cloth")->wear();

}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_train", "train");

}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(5)) {
    case 0:
      say("矮老头说道：这位" + RANK_D->query_respect(ob)
        + "，来陪我聊一聊？\n");
      break;
    case 1:
      say("矮老头笑道：这不，生意来了！\n");
      break;
  }
}

int do_train(string arg) {
  object me, pet;
  int cost;
  string id, save_file;
  me = this_player();
  id = me->query("id");
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if (!arg) return notify_fail("矮老头道：＂你要训练什么呀？＂\n");
  pet = present(arg, environment());
  if (!objectp(pet)) return notify_fail("高人道：＂你要训练什么呀？＂\n");
  save_file = pet->query_save_file();
  if (save_file != sprintf(DATA_DIR "pet/%c/%s", id[0], id + ".o"))
    return notify_fail("矮老头道：＂您训练的似乎不是你的宠物吧？＂\n");
  //保证所训练的东西是自己的宠物。
  cost = pet->query("obedience");
  if (cost >= 100)
    return notify_fail("矮老头：＂您的宠物现在这么听话你还不满意吗？＂\n");
  cost /= 4;
  if (cost <= 0) cost = 1;
  if (!me->can_afford(cost * 10000))  //4点驯服度一两黄金。并且累加.
    return notify_fail("你没有那么多钱\n");
  me->pay_money(cost * 10000);
  pet->add("obedience", 1);
  pet->save();
  command("say 这就得了！您的宠物在我的调教之下比以前听话了。\n");
  return 1;
}
