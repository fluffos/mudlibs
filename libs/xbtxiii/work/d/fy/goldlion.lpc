#pragma save_binary
inherit ROOM;
void create() {
  set("coor", ({ 5, 100, 0 }));
  set("short", "金狮镖局大院");
  set("long",
    "镖局大院里黑石铺地，大院右边零乱的放着一些大小不依的石锁，\n"
    "想必是镖局中的趟子手用来练臂力的。左侧则是碗口粗细一人多\n"
    "高的梅花桩。听说总镖头查猛原本是少林俗家弟子，后得高人指\n"
    "点，在轻功和掌法上都有颇深的造诣。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "nwind4",
    "east": __DIR__ "ghall",
    "north": __DIR__ "gcang",
    "south": __DIR__ "gkitchen",
  ]));
  set("objects", ([

    __DIR__ "npc/biaoshi": 1,
    __DIR__ "npc/biaoshi1": 1,
  ]));

  set("outdoors", "fengyun");
