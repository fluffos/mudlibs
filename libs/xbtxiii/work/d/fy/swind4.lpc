#pragma save_binary
inherit ROOM;
void create() {
  set("coor", ({ 0, -100, 0 }));
  set("short", "南风大街");
  set("long",
    "这里的街道宽敞而干净，汉白玉砌的路面被雨水冲得光明如镜，\n"
    "街道两侧的瓦房高大而宏伟，分明是巨富宅院。双人合抱的杨树\n"
    "十步一株，整齐的排在两边。西边的千金楼白天门可箩雀，但是\n"
    "到了晚上却是热闹非凡。千金楼为了方便客人，又在南风大街的\n"
    "对面开了一座千银当铺。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "swind5",
    "north": __DIR__ "swind3",
    "east": __DIR__ "qianyin",
    "west": __DIR__ "qianjin",
  ]));
  set("outdoors", "fengyun");
  setup();
}
