#pragma save_binary
inherit ROOM;
void create() {
  set("coor", ({ 75, 0, 0 }));
  set("short", "东云大路");
  set("long",
    "这里是风云城中三教九流，龙蛇混集之所。不管你是达官贵人，\n"
    "还是贩夫走卒，只要你身上有两钱儿，在这里就会受到热情的招\n"
    "呼。任何你不知道的事，在这里打听一下，都可以知道个八九不\n"
    "离十。整条街上有卖菜的，卖肉的，卖玩具的，卖艺的，卖药的.\n"
    "..，应有尽有。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "ecloud4",
    "west": __DIR__ "ecloud2",
    "north": __DIR__ "smithy",
    "south": __DIR__ "washroom",
  ]));
  set("objects", ([
    __DIR__ "npc/wanfan": 1,
  ]));

  set("outdoors", "fengyun");
  setup();
}
