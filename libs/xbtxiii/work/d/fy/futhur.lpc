#pragma save_binary
inherit ROOM;
void create() {
  add_light(this_object(), 1);
  set("coor", ({ -75, 5, 0 }));
  set("short", "红屋");
  set("long",
    "这是西城区唯一比较像样的建筑，但颜色很怪，一种血色干凝的\n"
    "暗红色。屋里更是鬼气森森。房子无窗，一盏油灯忽明忽暗。以\n"
    "太极八卦图为底的招牌上用篆体刻着四个字“生死已卜”，也是\n"
    "黯淡无光的红色。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "wcloud3",
  ]));
  set("objects", ([

    __DIR__ "npc/dashi": 1,
  ]));

  setup();
}
