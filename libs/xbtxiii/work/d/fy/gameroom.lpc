inherit ROOM;
int do_command();
void create() {
  set("coor", ({ 0, 0, 100 }));
  set("short", "雄霸天下比武场");
  set("long",
    "如今这里是推选天下武林第一高手之处，各路英雄如能技压群雄，\n"
    "比武夺魁，便能问鼎宝座，成为统领中原武林的领袖。此处更设\n"
    "立英雄榜，能上榜者均为当今武林中的一流高手，足以啸傲泥潭，\n"
    "光宗耀祖。高台上摆放着四张大汉白玉宝座，这里便是比武大会\n"
    "的裁判席。广场两边挂了一副对联(duilian).广场左右各侍立着\n"
    "两位白衣武士，两边都放着一长排虎皮交椅，这是给一些淡薄名\n"
    "利的前辈高手在此观战而准备的，正中则是一座比武的擂台。旁\n"
    "边有个转播台。可以通过它观望上面的赛事(rebroadcast)以武\n"
    "会友剑刀试横天九下州\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "up": __DIR__ "gamebox",
    "enter": __DIR__ "chatroom",
    "down": __DIR__ "fysquare",
    //            "west" : "/d/gameroom/lottery_room",
  ]));
  set("no_fight", 1);
  set_temp("light", 1);
  set("gaoshou", 1);
  set("no_magic", 1);
  set("no_die", 1);
  set("no_arrest", 1);
  set("no_death_penalty", 1);

  set("objects", ([
    "/d/taishan/npc/wei-shi1": 1,
    "/d/taishan/npc/wei-shi2": 1,
    "/d/taishan/npc/wei-shi3": 1,
  ]));

  setup();
}
void init() {
  add_action("do_command", "");
  add_action("do_rebroadcast", "rebroadcast");
}

int do_rebroadcast(string arg) {
  object me, npc, room, *hearer;
  me = this_player();
  room = find_object("/d/fy/gamebox");
  if (!room)
    return notify_fail("比武太台上面还没有赛事。\n");
  npc = present("eye wintne", room);  // 限定其为npc
  if (!npc) {
    npc = new(__DIR__ "npc/eyewintne");
    npc->move(room);
  }
  hearer = npc->query_temp("all_hearer");
  if (!arrayp(hearer)) hearer = ({});
  if (arg && arg == "none") {
    if (member_array(me, hearer) == -1)
      return notify_fail("你现在没有观看赛事啊\n");
    else {
      hearer -= ({ me });
      npc->set_temp("all_hearer", hearer);
      tell_object(me, "ok!\n");
    }
    return 1;
  }
  if (member_array(me, hearer) != -1)
    return notify_fail("你现在正在观看赛事\n");
  //      hearer-=({me});
  hearer += ({ me });
  npc->set_temp("all_hearer", hearer);
  tell_object(me, "转播正式开始。可以使用rebroadcast none 取消转播。\n");
  return 1;
}
int valid_leave(object me, string dir) {
  if (!userp(me) && dir == "enter")
    return 0;
  return 1;
}
int do_command() {
  string *limit = ({
    "study", "pratice", "read", "selflearn", "research", "kill",
    "exert", "cast", "beg", "perform", "du", "conj",
    "follow", "give", "get", "drop", "do", "to",
    "use", "check", "write", "selflearn", "research", "kill",
  });
  if (member_array(query_verb(), limit) != -1) {
    if (wizardp(this_player())) return 0;
    else return 1;
    //            return !wizardp(this_player());
  }
  return 0;
}
