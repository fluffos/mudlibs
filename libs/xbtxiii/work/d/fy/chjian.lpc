#pragma save_binary
inherit ROOM;
void create()
{
        add_light(this_object(),1);
	set("coor",({5,-45,0}));
	set("short", "忏悔间");
        set("long",
"一间只容一个人的小房间。房间的一面墙上有孔，这里的声音可\n"
"以很清晰的传到隔壁。房间里只有张小木凳和钉在墙上供人放东\n"
"西的木板。\n"
);
        set("exits", ([ /* sizeof() == 4 */
  "south" : __DIR__"church",
]));
        set("objects", ([
 
        __DIR__"npc/chantou" : 1,
                        ]) );

        set("no_fight",1);
        setup();
        replace_program(ROOM);
}
int init()
{
      add_action("do_perform","perform");
      add_action("do_perform","exert");
}
int do_perform()
{
      return 1;
}
