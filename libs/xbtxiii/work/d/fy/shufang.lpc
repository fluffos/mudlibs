//Room: /d/fy/

inherit GUANFU;
void create()
{
        add_light(this_object(),1);
        set("coor",({-90,-10,0}));
        set("short", "知府书房");
        set("long",
"这书室庭户虚敞，正中挂一幅名人山水。供一个古铜香炉，炉里\n"
"香烟飘渺。左边设一张湘妃竹榻，右边架上堆满若干图书。沿窗\n"
"一只几上，摆列文房四宝。窗外庭中种植许多花木，铺设得十分\n"
"清雅，凡朝廷命官都可在这发号令（ａｒｒｅｓｔ）。知府的桌\n"
"案上还有通缉人犯的名单（list)。\n"
);
        set("exits", ([ /* sizeof() == 4 */
                        "west" : __DIR__"govern",
                ]));

                set("objects", ([ /* sizeof() == 0 */
                        __DIR__"npc/yinzhenglian" :1,
                        "/d/chaoting/jjf/npc/shi_wei" :3,
                        "obj/npc/cashier" :1,
                ]));
        set("valid_startroom", 1);
        setup();
}
