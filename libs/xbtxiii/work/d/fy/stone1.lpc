#pragma save_binary
// Tie@fengyun
inherit ROOM;
void create() {
  set("coor", ({ 25, 5, 0 }));
  set("short", "阴暗石巷");
  set("long",
    "石巷散发着一种奇怪的霉腐味道．又加杂着一丝血腥．和干净宽\n"
    "敞的东云大路格格不入．一条又脏又臭的小河沟顺着巷侧缓缓流\n"
    "淌．上面还漂着染满着黑血的绷带．\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "ecloud1",
    "north": __DIR__ "stone2",
  ]));
  set("objects", ([
    __DIR__ "npc/scavenger": 1,
  ]));

  set("outdoors", "fengyun");
  setup();
}
