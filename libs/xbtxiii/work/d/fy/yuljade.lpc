#pragma save_binary
inherit ROOM;
void create() {
  add_light(this_object(), 1);
  set("coor", ({ -5, -25, 0 }));
  set("short", "玉龙珠宝店");
  set("long",
    "珠宝店的正中是块千年古玉雕成的祥龙，玉龙活灵活现，穿梭于\n"
    "祥云之中。龙嘴中含玉球，玉球有拳头大小，翠绿欲滴。龙眼半\n"
    "睁半闭。四周的墙上挂满了各种金玉制品和各种护身吉祥玉器。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "swind1",
  ]));
  set("objects", ([
    __DIR__ "npc/jadeowner": 1,
  ]));

  setup();
  replace_program(ROOM);
}
