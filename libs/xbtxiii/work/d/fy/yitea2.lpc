#pragma save_binary
inherit ROOM;
void create()
{
        add_light(this_object(),1);
	set("coor",({5,-75,5}));
	set("short", "一品居二楼");
        set("long",
"站在这里，打开小窗就可以看到对面银钩赌坊那闪亮，在风中摇\n"
"曳的银钩。再往远处看，便是一片梅林。梅林中露出一角小楼，\n"
"那正是小李飞刀昔日读书学剑的地方。梅林无恙，但仿佛比几年\n"
"前开的更胜了。\n"
);
        set("exits", ([ /* sizeof() == 4 */
  "down" :   __DIR__"yitea",
]));
        set("objects", ([
     "/d/fy/pet/petowner" : 1,
     "/d/fy/pet/pettrainer2" : 1,
                        ]) );

        setup();
        replace_program(ROOM);
}
