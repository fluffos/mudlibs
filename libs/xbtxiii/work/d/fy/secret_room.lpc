#pragma save_binary

inherit ROOM;

void create()
{
	object silver;
	set("coor",({10,105,-10}));
	set("short", "地下密室");
	set("long",
"这里是一间窄小的密室，你的面前只有一个破旧的小床跟一些乾\n"
"草。\n"
);

	set("objects", ([
		"/obj/money/silver": 1
	]) );

	setup();
	silver = present("silver",this_object());
	silver->set_amount(random(100)+100);	
	silver->set("name", "镖银");
}
void reset()
{
        delete("exits/up");
        ::reset();
}
void init()
{
    object me;
    if(objectp(me=this_player()))
        me->set_explore("north#0");
}
