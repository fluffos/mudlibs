#pragma save_binary

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -5, 125, 0 }));
  set("short", "薛记包子");
  set("long",
    "店里布置简陋，只有几张方桌和几张长凳。桌面油漆剥落，再也\n"
    "看不出它原来的颜色。肮脏而残破的碗筷零乱的散落在桌面上。\n"
    "墙角里还有几支脏稀稀的筷子，上面已结满了蜘蛛网。几只乌蝇\n"
    "在盲目的飞来飞去。。。\n"
  );
  set("exits", ([
    "east": __DIR__ "nwind5",
  ]));
  set("objects", ([
    __DIR__ "npc/lifeseller": 1,
  ]));
  setup();

}
void init() {
  if (this_player())
    this_player()->set_explore("north#49");
}
