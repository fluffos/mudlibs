#include <ansi.h>
inherit ROOM;
void create()
{
        add_light(this_object(),1);
	set("coor",({-25,5,0}));
	set("short", "探花诗台");
        set("long",
"风云中的老老少少大都有吟诗对词的雅好。只要稍有灵感，就会\n"
"带着笔墨到这里来酝酿，等到灵光乍现那霎那，奋笔急书，以求\n"
"千古名句。诗台正中朱笔入木狂草：[33m今日有酒今朝醉，哪\n"
"管它日剑割头！阿铁狂舞于酒后失意时。(吟诗作对chant)[37m\n"
);
        set("exits", ([ /* sizeof() == 4 */
  "south" : __DIR__"wcloud1",
]));
        set("objects", ([
         __DIR__"npc/poet" : 1,
                        ]) );
	set("no_death_penalty",1);
        setup();
//    call_other( "/obj/board/poem_b", "???" );
}
int init()
{
//        add_action("do_chant","chant");//cmds/usr/chant.c有了。并且我做了些变动
}

int do_chant()
{
	object me;
	string dir,poet;
        mixed *file;
        int i;
//        seteuid(getuid());
	me=this_player();
if(me->query("sen")<50)
	return notify_fail("你冥思苦想，脑子一片混乱。没有想出一言半语\n");
	me->receive_damage("sen", 50);
        me->set_explore("south#16");
        dir="/d/poem/";
        file = get_dir(dir, -1);
if( !sizeof(file) )
	tell_object(me,"开启文件错误。\n");
	i=sizeof(file);
	poet=read_file(dir+file[random(i)][0]);
	poet=replace_string(poet,"：","："HIG);
	poet=replace_string(poet,"\n","\n"HIC);
	message_vision(HIY"$N摇头晃脑，念诗一首。\n"NOR,me);
	message_vision(HIY+poet+NOR,me);
	return 1;
}
