inherit ROOM;
void create() {
  add_light(this_object(), 1);
  set("coor", ({ 125, 5, 0 }));
  set("short", "风云天骄门");
  set("my_point", "风云城");
  set("long",
    "这是一座古老而神圣的大理石门，大约建于百年前。门上斑斑点\n"
    "点，风化不堪。传说中是玉皇大帝临凡佳奖天下儿女英雄的地方，\n"
    "凡是被佳奖的英雄都成为不死之身。\n"
  );
  set("exits", ([
    "south": __DIR__ "ecloud5",
  ]));
  set("objects", ([
    "/d/biao/kehu": 1,
  ]));
  //        set("no_fight",1)
  set("no_magic", 1);
  setup();
  set("valid_startroom", 1);
}
