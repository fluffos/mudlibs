#pragma save_binary
inherit ROOM;
void create() {
  add_light(this_object(), 1);
  set("coor", ({ -25, -5, 0 }));
  set("short", "考场");
  set("long",
    "凡是有志于宦途的风云年青人都要在这里通过第一次考试。文武\n"
    "双全的前三名会被送入京都再试。每到一年一度的考季，这里就\n"
    "会人山人海，看热闹的比参考的还多。风云的老一辈大多是望子\n"
    "成龙，所以风云城每年都是人才辈出。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "wcloud1",
  ]));
  set("objects", ([

    __DIR__ "npc/kaoguan": 1,
    __DIR__ "npc/student": 3,
  ]));

  setup();
}
