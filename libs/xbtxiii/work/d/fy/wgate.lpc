#pragma save_binary
inherit ROOM;
void create() {
  set("coor", ({ -150, 0, 0 }));
  set("coor", ({ -300, 0, 0 }));
  set("short", "西城门");
  set("long",
    "西城门阁矮小而破旧，守城卫兵斜戴着红樱帽，搂着长枪在打瞌\n"
    "睡。也许因为西城区所住皆贫困撩倒之徒，这里的治安和卫生都\n"
    "不是很好。狂风掠过之时，满地垃圾随风飞舞，夜幕降临之后，\n"
    "惨号和狞笑声此起彼伏。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "west": "/u/quicksand/huangyie0",
    "east": __DIR__ "wcloud5",
    "up": "/d/fywall/wupgate",
  ]));
  set("objects", ([
    __DIR__ "npc/wind_solider": 2,
  ]));
  set("outdoors", "fengyun");
  setup();
}
int valid_leave(object me, string dir) {

  object ob;
  int i;
  if (userp(me)) {
    if (dir == "east" && ob = present("garrison", this_object())) {
      if (me->query_temp("weapon"))
        return notify_fail(ob->name() + "向你喝道：不可手持兵器入风云城！\n");
      else if (!me->query_temp("armor/cloth"))
        return notify_fail("" + ob->name() + "向你喝道：如此裸露身体。实在有伤风化。着装整齐方可入城 ！\n");
    }

    if (dir == "up" && ob = present("garrison", this_object())) {
      if (userp(me) && me->query("family/family_name") == "朝廷")
        return 1;
      else
        return notify_fail(ob->name() + "向你喝道：闲杂人等不可上登护城墙！\n");
    }

    return 1;
  } else return 1;
}
