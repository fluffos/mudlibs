#pragma save_binary
inherit ROOM;
void create()
{
        set("coor",({-125,0,0}));
	set("short", "西云大路");
        set("long",
"宽宽的黄土路向东西方向伸展，路边的茅屋矮小而破旧，街边的\n"
"垃圾散发着令人作呕的腐臭，路上的行人面黄肌瘦，被贫困的生\n"
"活拖得疲惫不堪。偶而有一两个面色红润之人，都掩鼻匆匆而过，\n"
"生怕沾上一点晦气。一股腥臭的腐肉味从北面的屠记肉铺散发出\n"
"来，浑杂着南首醉生小酒馆里劣酒的味道。\n"
);
        set("exits", ([ /* sizeof() == 4 */
  "north" : __DIR__"tuji",
  "south" : __DIR__"zuisheng",
  "west"  : __DIR__"wgate",
  "east"  : __DIR__"wcloud4",
]));

        set("outdoors", "fengyun");
        setup();
        replace_program(ROOM);
}
