#pragma save_binary
inherit ROOM;
void create() {
  add_light(this_object(), 1);
  add_action("do_kill", "kill");
  set("coor", ({ 5, -50, 0 }));
  set("short", "天主教堂");
  set("long",
    "这里的建筑别具一格，房顶特别高，成拱形，上面还有个巨大的\n"
    "十字架。房顶上又有满幅的浮雕。雕的是一些金发碧眼，背生翅\n"
    "膀的小天使。教堂正中的十字架上钉着一个全身是血，长发披面\n"
    "的塑像。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "swind2",
    "east": __DIR__ "tang3",
    "north": __DIR__ "chjian",
  ]));
  set("objects", ([
    __DIR__ "npc/priest": 1,
  ]));

  set("no_fight", 1);
  set("no_magic", 1);
  set("no_arrest", 1);
  //        set("no_sleep", 1);
  setup();
  //        replace_program(ROOM);
}
int init() {
  add_action("do_kill", "kill");
  add_action("do_perform", "perform");
  add_action("do_perform", "exert");
}
int do_kill() {
  return 1;
}
int do_perform() {
  return 1;
}
