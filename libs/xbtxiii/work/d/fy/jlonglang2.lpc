#pragma save_binary

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -10, 80, 0 }));
  set("short", "走廊");
  set("long",
    "一人多高，只容两人并行的檀香木走廊，廊中的两侧陈列着一些\n"
    "奇花异草。滚滚热气从走廊的一头冒出，将檀木地板打得又湿又\n"
    "滑，你几乎要扶着栏杆才不会滑倒。\n"
  );
  set("exits", ([
    "south": __DIR__ "jlonglang1",
    "west": __DIR__ "jlonglang3",
  ]));
  setup();

}
