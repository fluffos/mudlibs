#pragma save_binary
inherit ROOM;
void create() {
  set("short", "黄衣室");
  set("long",
    "黄衣警卫专门负责金钱帮总舵的安全。凡是来人，都要经过他们\n"
    "的检察。这里是他们轮班休息的所在。屋中有几张小床，几张小\n"
    "几。每张床头都有小钩，警卫们都把兵器挂在钩上，一伸手，他\n"
    "们就可以最快的速度拔出自己的兵刃。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "jting",
    "south": __DIR__ "jbang",
  ]));
  set("objects", ([

    //    __DIR__"npc/huangyi" : 3,
  ]));

  setup();
}
