inherit ROOM;
object *hearer;
void create() {
  set("coor", ({ 0, 0, 200 }));
  set("short", "雄霸天下比武台");
  set("long",
    "方方正正的高台，离地足足有三尺，而且是用洁白的大理石砌成\n"
    "的没有一点瑕疵。整个高台长宽各十五丈，既可以单打独斗，也\n"
    "可以群殴。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "down": __DIR__ "gameroom",
  ]));
  set("no_death_penalty", 1);
  set("no_die", 1);
  set("chat_room", 1);
  set("no_arrest", 1);
  set("objects", ([
    __DIR__ "npc/eyewintne": 1,
  ]));
  set("size/x", 7);
  set("size/y", 7);
  set("rebroadcastroom", "/d/fy/gameroom");
  set_temp("light", 1);
  setup();
}

int init() {
  //       add_action("do_quit","quit");
  this_player()->set("startroom", "/d/fy/gamebox");
  add_action("do_read", "read");
  add_action("do_study", "study");
  add_action("do_respirate", "respirate");
  add_action("do_meditate", "meditate");
  add_action("do_exert", "exert");
  add_action("do_exercise", "exercise");
}

int do_meditate() {
  return 1;
}
int do_respirate() {
  return 1;
}

int do_read() {
  return 1;
}
int do_study() {
  return 1;
}
int do_exert(string arg) {
  object me;
  me = this_player();
  if (!(arg && (arg == "powerup" || arg == "recover")))
    return 1;
}
int do_exercise() {
  return 1;
}


int do_quit() {
  object me;
  me = this_player();
  tell_object(me, "在这里退出？死了怎么办？！\n");
  return 1;
}


int die_in_here(object me) {
  object killer;
  if (userp(me)) me->revive(1);
  if (objectp(killer = me->query_temp("last_damage_from"))) {
    message_vision("$n将$N逼到台边，尽全力一招向$N攻去，$N脚下踏空，翻落台下。\n", me, killer);
  } else {
    message("vision", me->name() + "脚下一个不稳，顿时跌下台去。\n", environment(me), ({ me }));
    tell_object(me, "你脚下一个不稳，跌下台去。\n");
  }
  tell_room(__DIR__ "gameroom", me->name() + "从台上摔了下来。\n");
  me->remove_all_killer();
  all_inventory(this_object())->remove_killer(me);
  me->dismiss_team();
  me->reincarnate();
  me->move(__DIR__ "gameroom");
  me->unconcious();
  return 1;
}
int valid_leave(object me, string dir) {
  if (me->is_fighting()) return 0;
  return 1;
}
