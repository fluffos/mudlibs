    "一度的风云城大赛，凡是参赛的人都会到这儿来祭一次兵刃，以\n"
    "求好运。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "ecloud2",
  ]));
  set("objects", ([
    //        "/d/fengyun/npc/wangfuren" : 1,
  ]));
  setup();
  replace_program(ROOM);

}
