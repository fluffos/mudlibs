#pragma save_binary
inherit ROOM;
void create() {
  add_light(this_object(), 1);
  set("coor", ({ 100, 5, 0 }));
  set("short", "棉花坊");
  set("long",
    "每当天气渐冷，风云老少都会到这儿来将自己的冬衫，冬被弹一\n"
    "弹，这里的老板娘更善长补衣服，补出来的衣服又牢固而且不难\n"
    "看。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "ecloud4",
  ]));
  set("objects", ([
    __DIR__ "npc/repair_woman": 1,
  ]));

  set("no_fight", 1);
  setup();
  replace_program(ROOM);
}
