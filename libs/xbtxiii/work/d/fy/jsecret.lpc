#pragma save_binary
inherit ROOM;
void create() {
  set("short", "水牢");
  set("long",
    "肮脏恶臭的污水齐胸深，污水中钉着几根铁桩，桩上有精钢环，\n"
    "想必是来绑压犯人的。偶尔几个水泡冒上水面，混杂着血沫和已\n"
    "泡得发白发臭的断肢。还有几个桩上用生锈的铁链绑着几个面目\n"
    "狰狞的骷髅。一堆白白胖胖的蛆在欢快的爬进爬出。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "up": __DIR__ "tang3",
  ]));
  set("objects", ([
    // __DIR__"npc/xongyang": 1,
  ]));
  setup();
  replace_program(ROOM);
}
