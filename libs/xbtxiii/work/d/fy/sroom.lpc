#pragma save_binary
// Tie@fengyun
#include <room.h>
inherit ROOM;
void create() {
  set("coor", ({ 25, 15, 0 }));
  set("short", "堂屋");
  set("long",
    "屋子里潮湿而阴暗，屋子并不十分窄小，但只有一桌，一床，一\n"
    "凳．更显得四壁箫然，空洞寂寞．也衬得那一盏孤灯更昏黄暗淡\n"
    "．壁上的积尘未除，屋面上还结着蛛网．\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "stone2",
  ]));
  set("objects", ([
    "/obj/npc/nangong": 1,
    __DIR__ "obj/old_paper": 1,
    "/obj/npc/obj/shouze": 1,
  ]));
  set("valid_startroom", 1);

  setup();
  create_door("south", "窄门", "north", DOOR_CLOSED);

}
