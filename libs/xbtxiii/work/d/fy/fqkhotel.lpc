#pragma save_binary
inherit ROOM;
#include <ansi.h>
void create() {
  set("coor", ({ 5, -25, 0 }));
  set("coor", ({ 10, -50, 0 }));
  set("short", "有一间客栈");
  set("long",
    "前厅挂着一幅龙凤双飞的巨画。当门挂着对鸳鸯球。球上系着几\n"
    "个小小的黄铜风铃。微风掠过，风铃发出清脆悦耳的叮咚声。大\n"
    "门两侧挂着斗大的大红灯笼，上各书凤凰两字。朱门上横批一个\n"
    "“求”字。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "swind1",
    "up": __DIR__ "hotel",
  ]));
  set("objects", ([

    "/obj/npc/waiter": 1,
  ]));
  set("valid_startroom", 1);
  set_temp("light", 1);

  setup();
  call_other("/obj/board/common_b", "???");
}
int clean_up() { return 0; }
