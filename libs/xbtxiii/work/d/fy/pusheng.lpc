#pragma save_binary
inherit ROOM;
void create()
{
	add_light(this_object(),1);
	set("coor",({-5,-125,0}));
	set("short", "普生堂");
	set("long",
"普生堂本是一云游高僧路经风云城逗留时所设，高僧童心未泯，\n"
"有感此地风土人情，一留就是三年。亲授一弟子。高僧慧眼识珠，\n"
"此弟子乃人中之龙，不到三年已将僧人医术尽学。堂中悬匾一块：\n"
"[32m妙手回春[37m\n"
);
	
	set("exits", ([
		"east"    	: __DIR__"swind5",
		"north"		: __DIR__"yangsheng",
	]) );
	set("objects", ([
 		__DIR__"npc/hosowner" : 1,

			]) );
	setup();
        replace_program(ROOM);

}
