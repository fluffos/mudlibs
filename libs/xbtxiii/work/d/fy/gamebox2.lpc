inherit ROOM;
object *hearer;
#include <ansi.h>
void create()
{
        set("coor",({0,0,-200}));
        set("short", RED"暗黑武斗场"NOR);
        set("long",
"昏暗的地下角斗场，到处弥漫着血腥，三尺高的用白色岩石砌成\n"
"的圆台，不知渗透了多少以性命作赌注的亡命徒的鲜血。观众席\n"
"上黑压压挤满了两眼发红的赌徒，它们不停的叫着、吼着，他们\n"
"喜欢鲜血，喜欢看见鲜血从躯体中激射而出。\n"
);
    set("exits", ([ /* sizeof() == 4 */
                        "up":__DIR__"gameroom2",
        ]));
        set("no_arrest",1);
//        set("no_magic",1);
        set("objects", ([
        __DIR__"npc/eyewintne" : 1,
       ]) );

        set("rebroadcastroom","/d/fy/gameroom2");
        set_temp("light",1);
        setup();
}

int init()
{
        this_player()->set("startroom","/d/fy/gamebox");
        if (userp(this_player())&&!this_player()->query_temp("shengsi"))
                this_player()->move("/d/fy/gamebox");
        add_action("do_flee",({"cast","conjure"}));
        add_action("do_quit",({"pray","tie","home","dancing","fly","quit","surrender"}));
        add_action("do_read", "read"); 
        add_action("do_study", "study"); 
        add_action("do_respirate", "respirate"); 
        add_action("do_meditate", "meditate"); 
        add_action("do_exercise", "exercise"); 
        add_action("do_alert", ({"alert", "burn","drivesnake"})); 
}

int do_meditate()
{
      return 1;
}
int do_respirate()
{
      return 1;
}

int do_read()
{
      return 1;
}
int do_study()
{
      return 1;
}
int do_exercise()
{
      return 1;
}

int do_quit()
{
        object me;
        me=this_player();
        tell_object(me,"人在江湖，身不由己…………\n");
        return 1;
}


int do_flee(string arg)
{
        object me;
        me=this_player();
	if (arg == "flee"||arg=="drift sense")
        {
                tell_object(me,HIY"想逃么？？\n"NOR);
                return 1;
        }
        if (arg == "invocation" )
        {
                tell_object(me,HIY"想叫帮手？还是靠自己吧！\n"NOR);
                return 1;
        }
}

int do_alert()
{
        tell_object(this_player(),HIY"想叫帮手？还是靠自己吧！\n"NOR);
        return 1;
}

int valid_leave(object me, string dir)
{
        if(me->is_fighting()) return 0;
        me->delete_temp("shengsi");
        return 1;
}

