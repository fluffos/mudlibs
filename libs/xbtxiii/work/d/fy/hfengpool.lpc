#pragma save_binary

inherit ROOM;
#include <room.h>

void create()
{
        set("coor",({20,80,0}));
	set("short", "枫叶泉");
        set("long",
"风云城中的枫叶泉是方圆五百里最著名的一口温泉。水温适中，\n"
"泉水呈淡红,故而得名枫叶。它不但有去腐生肌的奇效，据说还\n"
"有延年益寿的妙用。武林第一美人林仙儿每天都以此泉水浣面（\n"
"ｗａｓｈ），来保持她如花似玉的容貌。\n"
);
        set("exits", ([
                "west" : __DIR__"hfenglang3",
        ]));
        set("objects", ([

                 __DIR__"npc/xianu": 2,
        ]) );
        set("outdoors", "fengyun");
        setup();
        create_door("west", "檀木门", "east", DOOR_CLOSED);

}

void init()
{
	add_action("do_jump", "wash");

}

int do_jump()
{
	object me;
	int wait;
	me = this_player();
	wait = random( 40 - (int)me->query("con")) * 2;
	if ( wait <= 20) wait = 21;
	message_vision("$N缓步走入泉水中．\n",me);
	tell_object(me,"你感到全身无比的舒泰．．\n");
	remove_call_out("curehimup");
	call_out("curehimup", wait, me);
return 1;
}

void curehimup(object me)
{
        int gin,kee,sen;
if(!objectp(me)) return ;
        gin=(int)me->query("max_gin");
        kee=(int)me->query("max_kee");
        sen=(int)me->query("max_sen");
if( me && environment(me) == this_object())
	{
    message_vision("$N的精气神恢复了！！\n", me);
    me->receive_curing("gin",gin/2);
    me->receive_curing("kee",kee/2);
    me->receive_curing("sen",sen/2);
    me->receive_heal("gin",gin);
    me->receive_heal("kee",kee);
    me->receive_heal("sen",sen);
    me->set_explore("north#1");
	}
return;
}

