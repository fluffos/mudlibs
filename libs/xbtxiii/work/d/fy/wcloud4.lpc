#pragma save_binary
inherit ROOM;
void create()
{
        set("coor",({-100,0,0}));
	set("short", "西云大路");
        set("long",
"宽宽的黄土路向东西方向伸展，路边的茅屋矮小而破旧，街边的\n"
"垃圾散发着令人作呕的腐臭，路上的行人面黄肌瘦，被贫困的生\n"
"活拖得疲惫不堪。偶而有一两个面色红润之人，都掩鼻匆匆而过，\n"
"生怕沾上一点晦气。大路南侧的花轿店店中迎门放着几定花轿，\n"
"大路北面的阿发木器店中黑漆漆一片，从这里根本看不到里面有\n"
"什么。\n"
);
        set("exits", ([ /* sizeof() == 4 */
  "north" : __DIR__"afa",
  "south" : __DIR__"ansheng",
  "west"  : __DIR__"wcloud5",
  "east"  : __DIR__"wcloud3",
]));

        set("outdoors", "fengyun");
        setup();
        replace_program(ROOM);
}
