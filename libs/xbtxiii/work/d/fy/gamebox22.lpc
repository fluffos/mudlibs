inherit ROOM;
#include <ansi.h>
void create() {
  set("coor", ({ 0, 0, -200 }));
  set("short", RED "选手休息室" NOR);
  set("long",
    "决斗前可以在这里休息片刻。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "enter": __DIR__ "gamebox2",
  ]));
  set("no_magic", 1);
  set_temp("light", 1);
  setup();
}

int init() {
  if (!this_player()->query_temp("shengsi"))
    this_player()->move("/d/fy/gamebox");
  add_action("do_quit", ({ "pray", "tie", "home", "dancing", "fly", "quit" }));
  add_action("do_flee", ({ "cast", "conjure" }));
}

int do_quit() {
  object me;
  me = this_player();
  tell_object(me, "你想逃避么？\n");
  return 1;
}

int do_cast(string arg) {
  object me;
  me = this_player();
  if (arg == "flee" || arg == "drift sense") {
    tell_object(me, HIY "想逃么？？\n" NOR);
    return 1;
  }
}
