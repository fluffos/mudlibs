#pragma save_binary
// Tie@fengyun
#include <room.h>

inherit ROOM;
void create()
{
        set("coor",({25,10,0}));
	set("short", "石巷尽头");
        set("long",
"石巷的尽头是一堵高墙，墙上有一道窄门．墙角有一狗洞，一条\n"
"脏稀稀的小河沟从狗洞中流出．时而不时的，一条条浸满血水的\n"
"绷带从狗洞中流出．\n"
);
        set("exits", ([ /* sizeof() == 4 */
  "south" : __DIR__"stone1",
  "north" : __DIR__"sroom",
]));

        set("outdoors", "fengyun");
        setup();
       create_door("north", "窄门", "south", DOOR_CLOSED);

}

