#pragma save_binary
inherit ROOM;
void create()
{
        add_light(this_object(),1);
        set("coor",({8,-50,0}));
        set("short", "化尸堂");
        set("long",
"别看外面的那个金发碧眼的老人长的慈眉目善。实际上那个家伙\n"
"背地里也不知道干了多少伤天害理的事情。为了毁尸灭迹，他专\n"
"门在这里做了一个棼尸堂。一股焦尸的恶臭弥漫了整个大厅（Ｓ\n"
"ＨＡＯ）。\n"
);
        set("exits", ([ /* sizeof() == 4 */
                    "west" : __DIR__"church",
]));
        setup();
}

void init()
{

        add_action("do_burn","shao");

}

int do_burn(string arg)
{
        object me;
        object tar;
        int score, pot;
        me = this_player();
        score = (int) me->query("combat_exp");
        pot = (int) me->query("potential");
        if( !arg || arg == "") 
                return notify_fail("你烧啥东西．\n");
        tar = present(arg, me);
        if( !tar) 
                return notify_fail("你身上没有这东西．\n");
        if( userp(tar))
                return notify_fail("你不可烧活的东西．\n");

        if( (tar->query("no_drop")))
                return notify_fail("这东西你也烧？真是暴潋天物．\n");

        if( tar->is_corpse())           
        {
                me->set("combat_exp", (int) score + 1);
                me->set("potential", (int) pot + 1);
                me->set_explore("south#13");
        }
        message_vision("$N将$n投入了青铜炉，$n转眼化为灰烬．\n", me, tar);
        tar->move(environment(me));
        destruct(tar);
        return 1;
}

