inherit ROOM;
#include <ansi.h>
int do_command();
void create() {
  set("coor", ({ 0, 0, -100 }));
  set("short", RED "暗黑武斗场观众席" NOR);
  set("long",
    "这里是暗黑武斗场的观众席。不知有多少人以自己的鲜血漆刷了\n"
    "场中的那个圆台。人类永远无法克服自身的欲望，由此不知导致\n"
    "了多少斗争，虽然不止是武力上的……但人类始终都是兽的一种，\n"
    "人类最原始的兽性常常在有意无意之间暴露出来，于是就有了暗\n"
    "黑武斗比赛的出现。站在这个比武场上的人，心中所想的，只是\n"
    "蹂躏对手、摧残对手、杀死对手，这样才能让他们自己得到满足，\n"
    "心理上，也许还有生理上……坐在这里观战的人，也是被本能所\n"
    "驱动。人类本身便是一种野蛮的生物，只要你在这里呆上片刻，\n"
    "也许你也会喜欢上这里，喜欢上那种毛孔收缩的感觉。生死无怨\n"
    "身人不在由江己湖\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "southdown": __DIR__ "gamebox21",
    "up": __DIR__ "fysquare",
  ]));
  set_temp("light", 1);
  set("gaoshou", 1);

  set("objects", ([
  ]));

  setup();
}
void init() {
  object me, npc, room, *hearer;
  add_action("do_command", "");
  me = this_player();
  room = find_object(__DIR__ "gamebox2");

  if (!room) {
    load_object("/d/fy/gamebox2");
    room = find_object(__DIR__ "gamebox2");
  }
  npc = present("eye wintne", room);  // 限定其为npc
  if (!npc) {
    npc = new(__DIR__ "npc/eyewintne");
    npc->move(room);
  }
  hearer = npc->query_temp("all_hearer");
  if (!arrayp(hearer)) hearer = ({});
  hearer += ({ me });
  npc->set_temp("all_hearer", hearer);
  return;
}
int valid_leave(object me, string dir) {
  if (!userp(me) && dir == "enter")
    return 0;
  return 1;
}
int do_command() {
  string *limit = ({
    "study", "pratice", "read", "selflearn", "research", "kill",
    "exert", "cast", "beg", "perform", "du", "conj",
    "follow", "give", "get", "drop", "do", "to",
    "use", "check", "write", "selflearn", "research",
  });
  if (member_array(query_verb(), limit) != -1) {
    if (wizardp(this_player())) return 0;
    else return 1;
  }
  return 0;
}
