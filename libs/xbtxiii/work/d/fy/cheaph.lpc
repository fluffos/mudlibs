inherit ROOM;
void create() {
  set("coor", ({ -75, -5, 0 }));
  set("short", "小胡同");
  set("long",
    "一条小小的胡同。有些阴暗。通常这里人迹罕见。两旁在了几棵\n"
    "杨柳。到是给这里增加了一点点活气。再向南边走是一间小小的\n"
    "房间\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "wcloud3",
    "south": __DIR__ "xiaohutong",
  ]));
  set("objects", ([
    __DIR__ "npc/madam": 1,
    __DIR__ "npc/playboy": 1,
  ]));

  set("outdoors", "fengyun");
  setup();
}
int clean_up() {
  return 0;
}
int reset() {
  if (query("Reset"))
    return 0;
  ::reset();
  set("Reset", 1);
}
