#pragma save_binary

inherit ROOM;

void create()
{
        add_light(this_object(),1);
	set("coor",({5,75,0}));
	set("short", "浣凰堂");
        set("long",
"四面的墙壁挂满了风干的花环，散发出醉人的香气。大堂的中央\n"
"是一个古色古香的青铜仙鹤，鹤嘴里面飘出袅袅青烟，沁人心脾。\n"
"大堂的右边是一个小小的柜台，台子的后面有一个木架，架子上\n"
"挂满了白毛巾。\n"
);
        set("exits", ([
                "west" : __DIR__"nwind3",
		"east" : __DIR__"hfenglang1",
        ]));
        set("objects", ([
    
             __DIR__"npc/showerboy": 1,
        ]) );
        setup();
        replace_program(ROOM);

}
