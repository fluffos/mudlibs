#include <ansi.h>
inherit ROOM;
string look_sign(object me);

void create()
{
        set("coor",({0,0,0}));
		set("short", "风云广场");
        set("long",
"风云城的风街和云路在这里呈十字交叉，宽阔的街道在这里形成\n"
"一个巨大的广场。广场的中央是方园约十丈的水池，池中有尾尾\n"
"金鱼在悠闲的漫游。金色的鱼鳞与碧绿的浮萍相互辉映，赏心悦\n"
"目。池水的中央是一条石柱，石柱上刻着一条九头龙。龙首向四\n"
"面伸展，宏伟壮观。每当雨天，潺潺雨珠涓涓涌出龙首，如情人\n"
"之泪，落断情肠。广场正中竖立着一面巨大的招牌(sign)\n"
);
        set("exits", ([ /* sizeof() == 4 */
		    "north" : __DIR__"nwind1",
  			"south" : __DIR__"swind1",
  			"east" : __DIR__"ecloud1",
  			"west" : __DIR__"wcloud1",
			"up" : __DIR__"gameroom",
                        "down" : __DIR__"gameroom2",
		]));
		
        set("no_fight",1);
	set("no_die",1);
        set("no_sleep",1);
        set_temp("light",1);
	set("no_magic",1);
        set("outdoors", "fengyun");
        set("resource/water",1);
		set("liquid/name","碧绿的水");
		set("liquid/type", "alcohol");
		set("liquid/drunk_apply",3);
        set("objects", ([
        __DIR__"npc/know_all" : 1,
//        "/cmds/adm/reclaim_man" : 1,// 此人负责清除无用变量
        __DIR__"npc/youxun" : 1,
        "/obj/npc/rubbish_man" : 1,
        __DIR__"npc/treasure_man" : 1,
       ]) );
 		set("item_desc",([	
        		"sign": (:look_sign:),
        ]));
        setup();
        // To "load" the board, don't ever "clone" a bulletin board.
        call_other( "/obj/board/fysquare_b", "???" );

}

void init()
{
    add_action("do_study","study");
    add_action("do_fillwater", "fillwater");
    add_action("do_exercise", ({"exercise","exert","practice","selflearn","drink","kill"}));
    add_action("do_heal",({"heal","疗伤","治疗"}));
}

int do_heal()
{
	object me;
	int exp;
	me=this_player();
	exp=me->query("combat_exp");
	if(exp>=40000)
    		return notify_fail("经验四万以上的高手还是去找医生吧。\n");
	else if(me->query_temp("use_heal_times")>=500)
        	return notify_fail("不准利用这个指令做机器人!\n");
	else{
		me->set("eff_kee",me->query("max_kee"));
    		me->set("eff_gin",me->query("max_gin"));
    		me->set("eff_sen",me->query("max_sen"));
    		me->set("kee",me->query("max_kee"));
    		me->set("gin",me->query("max_gin"));
    		me->set("sen",me->query("max_sen")); 
    		me->set_temp("use_heal_times",1); 
    		me->start_busy(8);
    		tell_object(me,"你浑身充满了力量。\n");
    		return 1;
        }
		
}
int do_study()
{
        write("请不要在这里学习！\n");
        return 1;
}
int do_exercise()
{
        return 1;
}

	
int do_fillwater(string arg)
{
        object *list, ob;
        int i, can_fillwater;

        if( !arg || arg=="" ) return 0;

        if( arg=="skin" || arg=="wineskin" ) {
                list = all_inventory(this_player());
                i = sizeof(list);
                can_fillwater = 0;
                while (i--) {
                  if (((string)list[i]->query("liquid/type") == "alcohol")
 || ((string)list[i]->query("liquid/type") == "water")         ) {
                        ob = list[i];
                        can_fillwater = 1;
                        ob->set("liquid", ([
                                "type": "water",
                                "name": "清水",
                                "remaining": 15,
                                "drunk_apply": 6,
                        ]) );
                        write("你从水池里装满了清水！ \n");
                        return 1;
                   }
                }
                if (can_fillwater ==0) {
                        write("你没有装水的东西啊....\n");
                        return 1;
                }
        }
        else {
                write("你要往什么东西里灌水？\n");
        }
        return 1;
}

int clean_up(){return 0;}

string look_sign(object me)
{
		return CYN"经验低于四万的新手可以在这里用(heal、治疗、疗伤)指令恢复\n"NOR;	
}
