#pragma save_binary
inherit ROOM;
void create() {
  set("coor", ({ 150, 0, 0 }));
  set("coor", ({ 300, 0, 0 }));
  set("short", "东城门");
  set("long",
    "风云东门高三丈，宽约二丈有余，尺许厚的城门上镶满了拳头般\n"
    "大小的柳钉。门洞长约四丈，大约每隔两个时辰就换官兵把守。\n"
    "洞侧帖满了悬赏捉拿之类的官府通谍。门洞西侧则是一条上城墙\n"
    "的窄梯。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": "/d/quanzhou/qzroad1.lpc",
    "west": __DIR__ "ecloud5",
    "up": "/d/fywall/eupgate",

  ]));
  set("objects", ([

    __DIR__ "npc/wind_solider": 2,
    __DIR__ "npc/cloud_solider": 2,
  ]));
  set("outdoors", "fengyun");
  setup();
}
int valid_leave(object me, string dir) {

  object ob;

  if (userp(me)) {
    if (dir == "west" && ob = present("garrison", this_object())) {
      if (me->query_temp("weapon"))
        return notify_fail(ob->name() + "向你喝道：不可手持兵器入风云城！\n");
      else if (!me->query_temp("armor/cloth"))
        return notify_fail("" + ob->name() + "向你喝道：如此裸露身体。实在有伤风化。着装整齐方可入城 ！\n");
    }
    if (dir == "up" && ob = present("garrison", this_object())) {
      if (userp(me) && me->query("family/family_name") == "朝廷")
        return 1;
      else
        return notify_fail(ob->name() + "向你喝道：闲杂人等不可上登护城墙！\n");
    }
    return 1;
  } else return 1;
}
