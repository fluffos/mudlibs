#pragma save_binary
inherit ROOM;
void create()
{
        set("coor",({0,50,0}));
	set("short", "北风大街");
        set("long",
"风街是风云城最热闹的两条街道之一。街道上人来人往，络绎不\n"
"绝。街道两旁店铺众多，生意兴隆。叫卖声、喝采声、和女人们\n"
"的娇笑声，声声入耳。糕点的甜味儿，酒菜的香味儿，和女人身\n"
"上的花粉味儿，不时的穿鼻入脑，给人以目眩头晕的感觉。大街\n"
"东侧的飘香花店和西侧的倾城胭脂店相映生辉。\n"
);
        set("exits", ([ /* sizeof() == 4 */
  "south" : __DIR__"nwind1",
  "north" : __DIR__"nwind3",
  "east" : __DIR__"pxhdian",
  "west" : __DIR__"qcyzdian",
]));
        set("outdoors", "fengyun");
        setup();
        replace_program(ROOM);
}
