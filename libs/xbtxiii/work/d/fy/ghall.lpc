#pragma save_binary
inherit ROOM;
#include <room.h>
string look_paper(object me);
void create() {
  add_light(this_object(), 1);
  set("coor", ({ 10, 100, 0 }));
  set("short", "金狮镖局大厅");
  set("long",
    "大红地毯，珍奇古玩，高悬字画，表明这里的主人不但性情豪爽，\n"
    "广交朋友，且非大字不识，目中无人之辈。上首一狮皮交椅，左\n"
    "右各明烛闪烁。一古木书案横于椅前，上面整齐的堆着一卷卷镖\n"
    "局压镖的货票。桌子上面压着一张纸(paper)\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "goldlion",
    "east": __DIR__ "ginhall",
    "north": __DIR__ "gmoney",
  ]));
  set("objects", ([
    "/d/biao/gmaster": 1,
  ]));
  set("item_desc", ([
    "paper": (: look_paper :),
  ]));

  setup();
  create_door("north", "铁门", "south", DOOR_CLOSED);

}

string look_paper(object me) {
  return "加入镖师队伍(join)\n领镖(yunbiao)\n";
}
