#pragma save_binary
inherit ROOM;
void create()
{
        add_light(this_object(),1);
	set("coor",({-100,-5,0}));
		set("short", "花轿店");
        set("long",
"天机老人几年前还是叱咤风云的显赫人物。不过近来淡出江湖。\n"
"遂在风云城开了一家花轿店。专门售卖花轿。不过这家伙道象是\n"
"个黑心商人。卖的花轿好贵。不过要结婚也没有办法.\n"
);

        set("exits", ([ /* sizeof() == 4 */
		  "north" : __DIR__"wcloud4",
		]));
        set("objects", ([
  
      __DIR__"npc/sedan_boss" : 1,
                        ]) );

        setup();
        replace_program(ROOM);
}
