#pragma save_binary
inherit ROOM;
void create() {
  set("coor", ({ 0, -75, 0 }));
  set("short", "南风大街");
  set("long",
    "这里的街道宽敞而干净，汉白玉砌的路面被雨水冲得光明如镜，\n"
    "街道两侧的瓦房高大而宏伟，分明是巨富宅院。双人合抱的杨树\n"
    "十步一株，整齐的排在两边。一个闪亮的银钩挂在大街西面一座\n"
    "巨宅的飞檐下，象征着风云城中最豪赌的银钩赌坊。银钩赌坊的\n"
    "对面则是一品居茶座。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "swind4",
    "north": __DIR__ "swind2",
    "east": __DIR__ "yitea",
    "west": __DIR__ "yingou",
  ]));
  set("outdoors", "fengyun");
  setup();
}
