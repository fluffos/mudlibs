#pragma save_binary
inherit ROOM;
void create() {
  add_light(this_object(), 1);
  set("coor", ({ 5, -75, 0 }));
  set("short", "一品居");
  set("long",
    "各地的名茶这里都有的卖。这里冲茶的水也是从枫叶泉专程汲来\n"
    "的。这里冲茶的壶更是名贵的紫砂壶。这里冲茶的方法也是最讲\n"
    "究的。每壶茶的第一杯是用来养壶的。所以这里冲出的茶都有一\n"
    "种纯厚的香气。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "swind3",
    "up": __DIR__ "yitea2",
  ]));
  set("objects", ([
    __DIR__ "npc/teawaiter": 1,
  ]));

  setup();
}
