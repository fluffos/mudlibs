inherit ROOM;
#include <ansi.h>
void create() {
  set("coor", ({ 0, 0, -200 }));
  set("short", RED "签约台" NOR);
  set("long",
    "生死书的签定台，一旦你在这里签下了生死书，你的生命就不再\n"
    "属于自己了……[1;31mqianshengsishuwith<id>[2;37;0m\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "northup": __DIR__ "gameroom2",
  ]));
  set_temp("light", 1);
  setup();
}

int init() {
  add_action("do_quit", "quit");
  add_action("do_read", "read");
  add_action("do_study", "study");
  add_action("do_respirate", "respirate");
  add_action("do_meditate", "meditate");
  add_action("do_exercise", "exercise");
  add_action("do_qian", "qian");
}

int do_meditate() {
  return 1;
}

int do_respirate() {
  return 1;
}

int do_read() {
  return 1;
}

int do_study() {
  return 1;
}

int do_exercise() {
  return 1;
}

int do_quit() {
  object me;
  me = this_player();
  tell_object(me, "你想逃避么？\n");
  return 1;
}

int do_qian(string arg) {
  string target;
  object me, ob, old_target;
  me = this_player();

  if (!arg || !sscanf(
    arg,
    "shengsishu with %s",
    target
  ) || !objectp(ob = present(target, environment(me))))
    return notify_fail("你想跟谁签生死书？\n");

  if (!ob->is_character())
    return notify_fail("看清楚一点，那并不是生物。\n");

  if (!living(ob))
    return notify_fail(ob->name() + "已经无法战斗了。\n");

  if (ob == me)
    return notify_fail("跟自己签生死书？你在开玩笑吧。\n");

  if (userp(ob) && (object)ob->query_temp("pending/shengsishu") != me) {
    message_vision("\n$N在生死书上签上了自己的名字！\n\n", me);
    if (objectp(old_target = me->query_temp("pending/shengsishu")))
      tell_object(old_target, HIY + me->name() + "取消了和你决斗的念头。\n" NOR);
    me->set_temp("pending/shengsishu", ob);
    tell_object(ob, HIY "如果你愿意和对方进行生死决斗，请你签生死书！\n" NOR);
    write(HIY "必须等对方同意才能进行决斗。\n" NOR);
    return 1;
  }

  message_vision("\n$N在生死书上签下了自己的名字！\n\n", me);

  message(
    "system",
    HIR + "【江湖恩怨】 " + me->query("name") + "决定于" + CHINESE_D->chinese_date(((time() - 14 * 365 * 24 * 60) * 60)) + "与" + ob->query("name") + "一决生死！\n" + NOR,
    users()
  );

  write_file(
    "/log/SHENGSI",
    sprintf(
      "%s(%s) 于 %s 与 %s(%s)签定生死书。\n",
      me->query("name"),
      me->query("id"),
      ctime(time()),
      ob->query("name"),
      ob->query("id")
    )
  );

  me->set_temp("shengsi", 1);
  me->move(__DIR__ "gamebox22");
  ob->set_temp("shengsi", 1);
  ob->move(__DIR__ "gamebox23");
  return 1;
}
