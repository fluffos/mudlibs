#pragma save_binary

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -5, 25, 0 }));
  set("short", "警世书局");
  set("long",
    "此间书局是风云城中卖书最多，最快的地方。这里的老板大有名\n"
    "气，听说是当今皇太子的老师。凡是京都出的新书，都被快马送\n"
    "到这里，然后刻板印刷。这里不但很多风骚文人喜欢的诗词，还\n"
    "卖一些粗浅的功夫书，供城中居民练来强身健体。\n"
  );
  set("exits", ([
    "east": __DIR__ "nwind1",
  ]));
  set("objects", ([
    __DIR__ "npc/bookseller": 1,
  ]));
  setup();
  replace_program(ROOM);

}
