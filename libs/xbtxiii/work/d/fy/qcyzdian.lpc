#pragma save_binary

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -5, 50, 0 }));
  set("short", "倾城胭脂店");
  set("long",
    "这里陈列着各式各样的胭脂，有从京都运来的，也有本地产的。\n"
    "胭脂鲜红似血,香气扑鼻。每当朝阳初升，阳光照入店内，映在\n"
    "胭脂上，给人一种耀眼的亮红。除了胭脂这里来卖刨花油，花粉\n"
    "袋。店老板听说就是当年江湖中有名的易容高手。\n"
  );
  set("exits", ([
    "east": __DIR__ "nwind2",
  ]));
  set("objects", ([
    __DIR__ "npc/makeupseller": 1,
    __DIR__ "npc/younggirl": 2,
  ]));
  setup();
  replace_program(ROOM);

}
