#pragma save_binary
// smallhouse.c madam.c(夫人)的家

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("coor", ({ -75, -8, 0 }));
  set("short", CYN "胡同的尽头" NOR);
  set("long",
    "有一间小小的房间就在这里。但是门好象被锁住了。看样子主人\n"
    "并不在家。\n"
  );

  set("exits", ([
    "south": __DIR__ "smallhouse",
    "north": __DIR__ "cheaph",
  ]));
  //        set("outdoors", "fengyun");

  setup();

  create_door("south", "小木门", "north", DOOR_CLOSED);
  //        replace_program(ROOM);


}
