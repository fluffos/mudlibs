#pragma save_binary
inherit ROOM;
int check_container(object ob);
void create() {
  add_light(this_object(), 1);
  set("coor", ({ -10, -100, 0 }));
  set("short", "千金楼");
  set("long",
    "此楼虽不在京都，但却是中原最有名的青楼。这里有最贵的酒，\n"
    "也是最好的酒；这里有最贵的女人，也是最有味儿的女人；这里\n"
    "有最贵的服务，也是最好的服务。红木舱板被擦的纹理并现。墙\n"
    "壁四周挂满了当地名人的书词提画。厅中一张大红地毯，足有五\n"
    "丈方圆。几个纱衣朦胧的妙龄少女正在随歌而舞。有到话：绛衣\n"
    "披拂露盈盈，淡染胭脂一朵轻。\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "qianjin",
  ]));

  set("no_fight", 1);
  set("no_magic", 1);
  set("NONPC", 1);
  set("objects", ([
    __DIR__ "npc/chick1": 1,
  ]));
  setup();
}
