#pragma save_binary
//paper.c

inherit ITEM;

void create() {
  set_name("发黄的旧纸", ({ "paper" }));
  set("long", "这是一张已经发黄的破旧纸片，上面写着这样的字\n\n"
    "给我钱，悄悄的告诉我他是谁，我找人帮你干掉他!!!\n"
    "另一面似乎有些字(read paper)。\n");
  set("unit", "张");
  set("task", 1);  // 并非task物品。只是防止垃圾清洁工清除而已
  set_weight(5);
  set("value", 5);
  setup();
}

void init() {
  add_action("do_read", "read");
}
int do_read(string target) {
  object me, *list;
  int i, k, temp;
  me = this_player();
  temp = 0;
  if (target == "paper") {
    list = users();
    i = sizeof(list);
    while (i--) {
      if (wizardp(list[i]))
        continue;
      if (list[i]->query("wanted") && list[i]->query("class") == "officer") {
        temp = 1;
        printf("悬赏" + chinese_number(list[i]->query("combat_exp") / 60 + list[i]->query("wanted/exp")) + "点经验和若干潜能、金钱暗杀" + list[i]->name(1) + " \n");
      }
    }
  } else return 0;
  me->set_explore("south#15");
  if (temp == 0) {
    tell_object(me, "现在还没有人被悬赏暗杀！\n");
    return 1;
  }
  return 1;
}
