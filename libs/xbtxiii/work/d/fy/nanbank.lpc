#pragma save_binary
// inn.c

inherit BANK;
int do_apply(string arg);


void create()
{
	add_light(this_object(),1);
	set("coor",({5,-125,0}));
	set("short", "南宫钱庄");
	set("long",
"中原南宫世家，家财万贯，产业不可胜数。此间钱庄黑匾红字，\n"
"正是南宫产业之一。南宫钱庄的银票信誉极好，大江南北都可兑\n"
"现。就是富可敌国的金钱帮，也难望其项背。钱庄中央有一红木\n"
"柜台，半人多高，上有牌（ｓｉｇｎ）一块。南宫钱庄\n"
);
	
	set("exits", ([
		"west"    	: __DIR__"swind5",
	]) );
        set("item_desc", ([
                "sign": @TEXT
这里是钱庄，目前我们提供的服务有：

convert     兑换钱币。
apply card  申请信用卡
TEXT
        ]) );


	set("objects", ([
	//	__DIR__"npc/bankowner" : 1,

			]) );


	setup();
}
void init()
{
::init();
add_action("do_apply","apply");
}

int do_apply(string arg)
{
object me,book,*ob;
int s;
me=this_player();
if (!arg) return 0;
if (arg!="card") return 0;
ob=all_inventory(me);
s=sizeof(ob);
while(s--)
        {
        if (!stringp(ob[s]->query("id"))) continue;
        if (ob[s]->query("id")=="account card")
                {
                tell_object(me,"你已经有金龙卡了!\n");
                return 1;
                }
        }
book=new("/obj/a_book.lpc");
book->set("master_id",me->query("id"));
book->set("rich",0);
book->move(me);
if (file_size(book->query_save_file()+".o")>0) book->restore();
tell_object(me,"你忽然觉得腰包一鼓, 好象多了点什么.\n");
tell_room(this_object(),"钱庄老板把金龙卡递给"+me->query("name")+".\n",me);
return 1;
}

