#pragma save_binary
// wine.c 为上一层目录/npc/下的madam.c所用。


inherit ITEM;

void create() {
  set_name("琥珀色酒杯", ({ "wine_cup" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一个琥珀色的酒杯，里面装满了红酒,一看酒色就知道是上等美酒\n");
    set("material", "sapphire");
    set("value", 50);
    set("max_liquid", 15);

  }
}
