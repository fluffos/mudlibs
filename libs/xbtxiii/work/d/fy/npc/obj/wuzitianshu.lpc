// 无字天书
#include <ansi.h>

inherit ITEM;
void create() {

  set_name(YEL "无字天书" NOR, ({ "wu_zi_tian_shu" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "一本发黄的书。不知道有什么作用。\n");
    set("value", 100);
    set("no_put_in", 1);
  }
  setup();
}


int init() {
  if (userp(environment(this_object())))
    add_action("do_study", "study");
}


int do_study(string arg) {

  object me;
  string skill;
  string *sname;
  mapping skills;
  me = this_player();
  if (arg == "wu_zi_tian_shu") {
    if (query("learned"))
      return 0;
    if (me->query_skill("literate", 1) <= 10) {
      tell_object("你认识的大字没有一箩。还是先读读书吧！\n");
      return 1;
    }
    tell_object(me, "你尝试着学习无字天书上面的内容。\n"
      "一阵灵光闪过。你好象悟到了些什么东西？\n"
      "无字天书化做一阵青烟消失的无影无踪了！\n");
    skills = me->query_skills();
    sname = keys(skills);
    skill = sname[random(sizeof(sname))];
    me->set_skill(skill, me->query_skill(skill, 1) + 1);
    tell_object(me, "你的" + to_chinese(skill) + "进步了。\n");
    set("learned", 1);
    call_out("dest_it", 0);
    return 1;
  }
}


int dest_it() {
  destruct(this_object());
}
