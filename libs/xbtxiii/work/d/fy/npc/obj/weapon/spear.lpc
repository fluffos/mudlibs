#pragma save_binary
// spear.c
#include <ansi.h>
#include <weapon.h>

inherit SPEAR;
inherit F_AUTOLOAD;

string query_autoload() { return query("weapon_prop/damage")+"/"+query("lost_prop"); }
void autoload(string param)
{
        int damage,lost;
		string cname;
        if( !sscanf(param, "%d/%d", damage,lost)==2 ) return;
        set("weapon_prop/damage",damage);
        set("lost_prop",lost);
	if(!environment()) return;
	cname=environment()->query("env/spear_name");
	 if(stringp(cname)) {
        	cname = replace_string(cname, "$BLK$", BLK);
	       	cname = replace_string(cname, "$RED$", RED);
        	cname = replace_string(cname, "$GRN$", GRN);
	        cname = replace_string(cname, "$YEL$", YEL);
        	cname = replace_string(cname, "$BLU$", BLU);
	        cname = replace_string(cname, "$MAG$", MAG);
        	cname = replace_string(cname, "$CYN$", CYN);
	        cname = replace_string(cname, "$WHT$", WHT);
        	cname = replace_string(cname, "$HIR$", HIR);
	        cname = replace_string(cname, "$HIG$", HIG);
        	cname = replace_string(cname, "$HIY$", HIY);
	        cname = replace_string(cname, "$HIB$", HIB);
	        cname = replace_string(cname, "$HIM$", HIM);
	        cname = replace_string(cname, "$HIC$", HIC);
	        cname = replace_string(cname, "$HIW$", HIW);
	        cname = replace_string(cname, "$NOR$", NOR);
	        cname += NOR;
		set("name",cname);
	}
	cname=environment()->query("env/spear_wield_msg");
	 if(stringp(cname)) {
        	cname = replace_string(cname, "$BLK$", BLK);
	       	cname = replace_string(cname, "$RED$", RED);
        	cname = replace_string(cname, "$GRN$", GRN);
	        cname = replace_string(cname, "$YEL$", YEL);
        	cname = replace_string(cname, "$BLU$", BLU);
	        cname = replace_string(cname, "$MAG$", MAG);
        	cname = replace_string(cname, "$CYN$", CYN);
	        cname = replace_string(cname, "$WHT$", WHT);
        	cname = replace_string(cname, "$HIR$", HIR);
	        cname = replace_string(cname, "$HIG$", HIG);
        	cname = replace_string(cname, "$HIY$", HIY);
	        cname = replace_string(cname, "$HIB$", HIB);
	        cname = replace_string(cname, "$HIM$", HIM);
	        cname = replace_string(cname, "$HIC$", HIC);
	        cname = replace_string(cname, "$HIW$", HIW);
	        cname = replace_string(cname, "$NOR$", NOR);
	        cname += NOR"\n";
		set("wield_msg",cname);
	}
	cname=environment()->query("env/spear_unwield_msg");
	 if(stringp(cname)) {
        	cname = replace_string(cname, "$BLK$", BLK);
	       	cname = replace_string(cname, "$RED$", RED);
        	cname = replace_string(cname, "$GRN$", GRN);
	        cname = replace_string(cname, "$YEL$", YEL);
        	cname = replace_string(cname, "$BLU$", BLU);
	        cname = replace_string(cname, "$MAG$", MAG);
        	cname = replace_string(cname, "$CYN$", CYN);
	        cname = replace_string(cname, "$WHT$", WHT);
        	cname = replace_string(cname, "$HIR$", HIR);
	        cname = replace_string(cname, "$HIG$", HIG);
        	cname = replace_string(cname, "$HIY$", HIY);
	        cname = replace_string(cname, "$HIB$", HIB);
	        cname = replace_string(cname, "$HIM$", HIM);
	        cname = replace_string(cname, "$HIC$", HIC);
	        cname = replace_string(cname, "$HIW$", HIW);
	        cname = replace_string(cname, "$NOR$", NOR);
	        cname += NOR"\n";
		set("unwield_msg",cname);
	}

}

void create()
{
        set_name("枪", ({ "my spear" }) );
	set_weight(15000);
    set("no_put_in",1);
  	set("value",5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "iron");
	}
    init_spear(40);
	setup();
}
