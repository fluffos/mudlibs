#pragma save_binary
// /open/rongg/npc/madam.c专用物件，没有其它用处。

#include <armor.h>
inherit WAIST;

void create()
{
        set_name("内裤", ({ "pants" }) );
        set("long","你自己的内裤有什么好看的？粉红色的.\n");
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("material", "cloth");
                set("armor_prop/armor", 1);
        }
        setup();
}

