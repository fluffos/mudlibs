#pragma save_binary
// hitter.c
// 恶少请来的打手。只是为教训玩家而做的。

inherit NPC;

void create() {
  set_name("打手", ({ "hitter" }));
  set("title", "气势凶凶的打手");
  set("gender", "男性");
  set("age", 30);
  set("long", "气势凶凶的打手，是恶少花钱雇来的。\n");

  set("combat_exp", 100000);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);

  setup();
  carry_object("/obj/cloth")->wear();
}
