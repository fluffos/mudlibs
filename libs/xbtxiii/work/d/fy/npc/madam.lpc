#pragma save_binary
// madam.c   和此人物相关密切的npc是同一目录下的playboy.c
// By rongg 1998.8.1.


#include <ansi.h>
inherit NPC;

int do_nod();
int do_enjoy(string arg);
int do_drinkk(string arg);
void create()
{
     set_name("少妇", ({"pretty woman"}));
     set("gender", "女性" );
     set("age", 22);
     set("cor", 100);
     set("per",100);
     set("long",
         "一个漂亮的少妇。生的如花似玉。尤其是那一双眼睛。\n"
         "晶莹透亮，非常迷人。简直人见人爱。\n");
     set("combat_exp", 100);
     set("attitude", "friendly");
     setup();
     carry_object("/obj/cloth")->wear();
}

void init()
{	
	object me;

	::init();
	if( interactive(me = this_player()) && !is_fighting() ) 
    {
        remove_call_out("greeting");
		call_out("greeting", 2,me);
		add_action("do_nod",({"yes","no"}));     
        add_action("do_enjoy",({"enjoy","refuse"})); 
		add_action("do_drinkk",({"drink","turndown"})); 			
    }
}




void greeting(object me) 
{ 
        object conspirator;//conspirator:同谋者
        conspirator = present("playboy", environment(this_object()));

	if(!conspirator||userp(conspirator)) //看看同谋者在不在环境中。
    {      
    	this_object()->set("long"," 一个漂亮的少妇。生的如花似玉。尤其是那一双眼睛。\n"
                       "晶莹透亮，非常迷人。简直人见人爱。\n"
                       "不过她不知道为什么会在这里站着..\n"); 
        return;
    }
    this_object()->set("long"," 一个漂亮的少妇。生的如花似玉。尤其是那一双眼睛。\n"
                      "晶莹透亮，非常迷人。简直人见人爱。可怜的她现在正在被一个恶少爷调戏..\n"); 

    message_vision(CYN"漂亮的少妇看见"+me->name()+"走了过来，立刻像碰见\n"
                     "了救命稻草一般，大声呼救...\n"NOR,me);
    command("say 他们。。。他们。。要强抢我回去做。。做小妾！");
    command("say 这位"+RANK_D->query_respect(me)+",求求你救救我!");
    command("say 快快将他们杀了！！！救救我！！！");       
}

void start_playact(object me) // 和同一个目录下的playboy.c文件相关。
{                    // 是由playboy.c所呼叫的。

        call_out("do_start",3,me);            
}

void do_start(object me)
{
          
        message_vision(HIM"漂亮的少妇哭哭啼啼的向$N道谢。\n"
                          "这位"+RANK_D->query_respect(me)+"赶快逃跑吧，呆会儿，他会叫打手来的.\n"
                          "我家离这里不远，如果"+RANK_D->query_respect(me)+"不嫌弃的话，\n"
                          "请到我家里,容小女子好好感谢恩公!!\n"NOR,me);
        command("say 不知道恩公愿意随小女子到我家里吗？");
        tell_object(me,HIM"\n夫人的好意，心领吗?(yes/no)?\n"NOR);
 
}


int do_nod()
{
    object me,playboy;
    me=this_player();
	if(!me->query_temp("kill_playboy"))		return 0;
	if(query_verb()=="yes")
    {

        command("say 小女子这就带恩公去我家。");
        message_vision(CYN"夫人带着$N匆匆忙忙离开了\n"NOR,me);
        this_object()->move("/d/fy/smallhouse");
        me->move("/d/fy/smallhouse");
        command("say "+RANK_D->query_respect(me)+",到了..");
        message_vision(CYN"夫人指着一所小房子说："+RANK_D->query_respect(me)+",这就是小女子的家了..\n"NOR,me); 

        remove_action("do_nod","yes");
        remove_action("do_nod","no");
		me->delete_temp("kill_playboy");
 		me->set_temp("Promise_come_your_home",1);
        call_out("do_playact",3,me);
    }
	else if(query_verb()=="no")
    {
    	message_vision(CYN"$N抱拳道：哼！"+RANK_D->query_self(me)+"一人做事一人当.\n"
               "我就在这里等着那个恶少爷，我还想再教训那个臭小子一顿.\n"
               "免得他以后还继续作恶多端!!!\n"NOR,me);
        command("say 既然恩公不去，小女子也不勉强，小女子再次感谢恩公的大恩大德!");
        command("say 他们快要来了，恩公也快逃跑吧!"); 
        message_vision("漂亮的少妇匆匆忙忙的离开了....\n",me);
    
     if(me->query("gender")=="男性")
        message_vision(HIM"$N望着少妇的背影不禁有些懊悔...唉。。。。\n"
                "$N忽然觉得自己笨的像只猪，竟然放过了这么一个好机会....\n"NOR,me); 
     else
        message_vision(HIM"$N叹了口气...咳。。。这是什么世道！！！\n"NOR,me); 
    
		me->delete_temp("kill_playboy");
        playboy=new(__DIR__"playboy");          
        playboy->move("/d/fy/smallhouse");
        playboy->set("i_teach_you",me->query("id"));//玩家的名字，恶少好找人。
        playboy->start_teach(me);//竟然不上当！只好找人教训他一顿了。
        destruct(this_object());
    }
	return 1; 
}

int do_playact(object me)
{  
        string gender;
        gender=me->query("gender"); 

        command("say 多谢这位"+RANK_D->query_respect(me)+",仗义出手, 救了小女子一命!");
        command("say 要不是"+RANK_D->query_respect(me)+"相救,小女子恐怕...恐怕已经....");
        command("say 请受小女子一拜!");
        message_vision(HIM"少妇说完盈盈拜倒,向$N道谢.\n"
                "$N连忙将少妇扶了起来说：您这真是折杀小人了.\n"
                 "区区小事,何足挂齿。再说，锄强扶弱，乃我学武之\n"
                 "人的本分..$N说完不禁有些得意：哈～　哈～　哈～　\n"NOR,me);
        call_out("deal_with_player",5,me);
}
void deal_with_player(object me)
{
        object wine;

        tell_object(me,"\n");

	if(me->query("gender")!="女性")
    {
        message_vision(HIM"少妇忽然脸色绯红,羞答答的向$N说道:我从小是个孤儿\n"
                "自幼父母双亡,孤苦伶仃，整天被人欺负。\n"
                "若承蒙"+RANK_D->query_respect(me)+"看的起，小女子愿意以身相许....\n"
                "少妇的声音越来越细，脸色早已红扑扑的,真是风情万种.\n\n"NOR,me);

        tell_object(me,HIM"夫人的情意，你愿意(enjoy)呢还是要拒绝(refuse)呢？\n"NOR);
    }

	else
    {
        message_vision(YEL"不满这位"+RANK_D->query_respect(me)+",小女子自幼父母双亡，我一个人生活在这个世上\n"
                            "经常被人欺负,今天"+RANK_D->query_respect(me)+"救了我，这一杯水酒是我敬"+RANK_D->query_respect(me)+"的.\n" 
                            "请姑娘您饮了,当是道谢酒.\n"NOR,me);
        wine=new(__DIR__"obj/wine");
        wine->move(this_object());
        command("give "+me->query("id")+" "+wine->query("id")+"");
        me->set_temp("Disapproation_enjoy",1);
        tell_object(me,HIM"夫人的好意，领情呢(drink),还是不领情呢(turndown)?\n"NOR);

    }
}


int do_enjoy(string arg)
{       
        object me,wine;
		me=this_player();	
	if(!me->query_temp("Promise_come_your_home"))		return 0;

	switch(query_verb())
    {
    	case "enjoy":	
        	if(arg=="pretty woman")
            {       
            	if(me->query("gender")=="男性")
            	{
            		message_vision(HIM"$N看着少妇那摄人心魄的面容，不禁神魂颠倒急急忙忙的上前\n"
                   "抱住少妇立刻就要动手动脚少妇嘤的一声,羞答答的说道: 既\n"
                   "然相公有意。实在是小女子的福分，但是相公别忙嘛，先喝了\n"
                   "这一杯酒嘛，就算我们的定情酒。。。\n"
                   "$N早就忍不住了，立刻将酒杯接过来，一饮而尽\n"
                   "$N色咪咪的说道：娘子。。这总可以啦吧。我们。。我们。。嘿嘿。。\n"NOR,me);
            		remove_action("do_enjoy","enjoy");
            		remove_action("do_enjoy","refuse"); 
	        		call_out("do_punish",5,me); // punish:惩罚  
            	}
	           else
	           {

           			message_vision(HIM"$N早看着少妇那双摄人心魄的眼睛，早已神魂颠倒。立刻冲上前\n"
                   "一把抱住少妇就要动手动脚。忽然！$N好象想起了什么事情，立刻\n"
                   "沮丧的松开了抱住少妇的手。默默的走到桌子前面默默的喝起了闷酒\n"
                   "少妇奇怪的看着$N。。。。。。。。。。。。。。。。。。。\n"NOR,me);
           			call_out("leave_here",5,me);
           		}
		   		me->delete_temp("Promise_come_your_home");
           	} 
         	else tell_object(me,"你想干什么啊???嘻嘻!!!\n");
         	break; 
    	
    	case "refuse":
        	message_vision(CYN"$N连忙起身抱拳,道：夫人这是那里的话,\n"
                "锄强扶弱乃我学武之人的本分,对了，时候不早了，我也该走了..\n"
                "$N说道:在下告辞了\n"
                "夫人连忙拦住$N,脸色红红的，羞涩的说道:既然相公乃正人君子.\n"
                "小女子也不好有什么奢望。只怪小女子没有这个福分。还请相公\n"
                "先喝了这杯水酒再上路也不迟啊!!!\n"NOR,me);
    	    wine=new(__DIR__"obj/wine");
        	wine->move(this_object());
        	command("give "+me->query("id")+" wine_cup");
        	message_vision(CYN"夫人羞答答的望着$N\n\n"NOR,me);
        	tell_object(me,HIM"夫人的好意，领情呢(drink),还是不领情呢(turndown)?\n"NOR);
        	remove_action("do_enjoy","enjoy");
        	remove_action("do_enjoy","refuse"); 
        	me->delete_temp("Promise_come_your_home");
	    	me->set_temp("Disapproation_enjoy",1);
    	break;     
    }
	return 1;     
}


int do_drinkk(string arg)
{
    object me;
    me=this_player();
	if(!me->query_temp("Disapproation_enjoy")) return 0;

	if(query_verb()=="drink")
    {
        if(arg=="wine_cup")
        {
           message_vision(CYN"$N接过酒杯说道:恭敬不如从命,夫人的好意，在下心领了.\n"
                   "说完将手中的酒一饮而尽.夫人笑道："+RANK_D->query_respect(me)+"果真豪爽,既然你要走\n"
                   "我也不强留，小女子这就带恩人出去..\n"
                   "$N刚抬起脚想出去。。谁知道。。。。。。。。。。。。。。。。\n"NOR,me);   
           remove_action("do_drink","drink");
           remove_action("do_drink","turndown");
		   me->delete_temp("Disapproation_enjoy");
           call_out("do_punish",3,me);
        }
        else 	tell_object(me,"你要喝什么？\n"); 
        return 1;
    }
    else if(query_verb()=="turndown") //死都不肯上当,只好叫人教训他一顿了!
    {
        message_vision(CYN"$N抱拳道：夫人的心意在下心领了，天色不早.\n"
                "在下还有要事在身恕在下无理，告辞了。夫人一听\n"
                "连忙拉住你的手说道；要是"+RANK_D->query_respect(me)+"连一杯水酒都不喝的话.\n"
                "真是叫小女子过意不去\n\n"NOR,me);        

    	if(me->query("gender")=="女性")
        {
        	message_vision(CYN"就在这个时候,一股淡淡的香气飘了进来.\n"
                "$N也毫不在意，还以为是夫人身上发出来的呢。\n"
                "忽然。。。。。。。。。。。。。。。。。。。。。。。。\n"NOR,me); 
        	remove_action("do_drink","drink");
        	remove_action("do_drink","turndown");
	    	me->delete_temp("Disapproation_enjoy");
        	call_out("do_punish",3,me);
        } 
    	else
        {         
        	message_vision(HIM"夫人说着说着竟然拉着$N的手向自己的酥胸按去!!!\n\n"
                "$N立刻窘的不知如何是好.........................\n\n"
                "$N窘迫的说道：夫。。。夫人，这。。。是。干什么。。么???\n"NOR,me);
        	remove_action("do_drink","drink");
        	remove_action("do_drink","turndown");
	    	me->delete_temp("Disapproation_enjoy");
        	call_out("do_kill_player",5,me);
        }
		return 1;

    }       
	return 0;
}

void do_kill_player(object me)
{   

       me->delete_temp("Disapproation_enjoy",1);	
       tell_object(me,"\n");
       message_vision(YEL"就在这个时候大门被人揣开了，一群人冲了进来。\n"
                 "其中一个人指着$N喝道：就是这个"+RANK_D->query_rude(me)+".\n"
                 "我早就见他鬼鬼祟祟，不是个好东西，果然在这里调戏良家妇女!\n"
                 "夫人这个时候忽然大声哭喊...........................\n"NOR,me);
        command("say 救命啊。。救命啊！！！"+me->name()+"要非礼我......!!!");
        command("say 大叔，大伯们。赶快救我呀！！！");
        command("say 大叔大伯们，打死这个畜生啊!!!!");
        message_vision("不由$N分说，一群人冲了进来噼里啪啦就打起来了...\n",me);
		call_out("ok_kill_him",3,me);
}

int ok_kill_him(object me)
{
		int i;
        object room,helper,gold,book;

	    room=environment(this_object());

	for(i=0;i<3;++i) 
    {
        helper=new(__DIR__"hitter");
        helper->set_skill("unarmed",me->query_skill("sword")*3);
        helper->set_skill("dodge",me->query_skill("dodge")*4); 
        helper->set("max_kee",me->query("max_kee")*2);
        helper->set("kee",this_object()->query("max_kee")*2);
        helper->move(environment(me));
        helper->set_leader(me);
		gold=new(GOLD_OB);
		gold->set_amount(5);
		gold->move(helper);
        if(!query("clone_a_book"))
          {
          book=new(__DIR__"obj/wuzitianshu");
          book->move(helper);
	  set("clone_a_book",1);
          }
        helper->kill_ob(me);
        me->fight_ob(helper);
        }    
        message_vision(YEL"$N急欲向人群解释清楚，谁料那个夫人早已不知去向....\n"NOR,me);
        destruct(this_object());
}


void do_punish(object me) 
{
       object cloth;
       object *obj;
       int i;        
       string gender;

       gender=me->query("gender"); 
     
      obj = all_inventory(me);
for(i=sizeof(obj)-1; i>=0; i--)
	   {
		if(obj[i]->query("money_id"))
			{
			destruct(obj[i]); continue;
			}
		if(obj[i]->query_autoload())
			continue;
       destruct(obj[i]);
	   }

       tell_object(me,CYN"你觉得一阵浓浓的睡意涌上心头,你不禁心头一惊...\n\n"
       				"朦胧之中好象有两个人在嘻嘻哈哈的说笑...\n\n"
       				"两个人的声音听起来好熟。。。。。。莫非..........\n\n"NOR);
if(gender=="女性")
       {          
        message_vision(CYN"女人音说道:嘻嘻，这个"+RANK_D->query_rude(me)+"简直是人头猪脑,\n"
             "老娘我略施小计，就将她弄晕了。。。哈哈哈\n"
             "男人淫笑道：哇，这个小妞还不错，不如。。。。。。\n"
             "男人继续道：不如夫人就赏给小的吧，看我怎么收拾她。。嘻嘻。。\n"
             "去你的，我们劫财不劫色，你要是敢动她一个手指头\n"
             "老娘非剪断你的那一条祸根不可。。\n"
             "女人继续道：赶快将她身上的东西搜光，然后拖出去.......\n\n"NOR,me);
        tell_object(me,HIM"你觉得好象一个男人的手摸了你一把\n"NOR);

        cloth = new("/obj/cloth");
        cloth->move(me);
        cloth->wear();
       }
else 
       {
       message_vision(CYN
             "女人说道:嘻嘻，这个"+RANK_D->query_rude(me)+"简直是人头猪脑,\n"
             "老娘我略施小计，就将他摆弄的团团转\n"
             "男人淫笑道：以夫人的国色天香,连我也要情不自禁的上当啊\n"
             "男人继续道：夫人，我今天演的戏够出色吧，哪个....夫人\n"
             "要不要给我一点补偿呢？恩???。。。。\n"
             "去你的，老娘的豆腐你都敢吃？小心我剪了你的祸根.\n"               
             "男人说道：这个家伙打的我好疼！老子宰了他出气!!!\n"
             "女人喝道：住手！我们只是劫财，不伤人命，将他的东西拿走\n"
             "女人继续道：赶快将他拖出去............................\n"NOR,me);
       cloth=new(__DIR__"obj/pants");//内裤
       cloth->move(me);
       cloth->wear();
       }

        me->unconcious();       
        me->move("/d/fy/fysquare");//具体地方待定。
        destruct(this_object());
}

void leave_here(object me)
{
        message_vision(YEL"突然，少妇像是发现了什么天大的秘密似的。惊叫了一声!\n",me);
        command("say 难道。。。难道相公你是。。。。。。。。。？？？？？？");
        message_vision(CYN"少妇的脸上立刻露出了鄙夷的神色。。。立刻起身朝外面走去。\n"
               "少妇边走边小声嘀咕：闹了半天原来是个"+me->query("gender")+"啊！嘻嘻。。。\n"
               "少妇继续道：算老娘我今天倒霉。。。。\n"
               "少妇说着说着竟很快的消失了。。\n"NOR,me);  
        tell_object(me,HIM"你不禁长长的叹了口气：唉～　　～　　～　　～　　～　　　　。\n");
        destruct(this_object());
}
