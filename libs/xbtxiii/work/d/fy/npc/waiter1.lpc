#ifndef NPCDATA
#define NPCDATA "/data/npc/"
#endif
#define WAITER NPCDATA + "waiter"
inherit NPC;
// inherit F_CLEAN_UP;
inherit F_SAVE;
inherit F_VENDOR;

#include <ansi.h>

void pay_him( object who, int amount);
int affordable(object who, int amount);
void do_check();

string query_save_file()
{
        return WAITER;
}
void create()
{

        seteuid(getuid());
        set_name( "店小二", ({ "waiter"}) );
        if(!restore())
        {        
        set("long","一个二十多岁的小伙子，非常热情。\n");
	set("gender", "男性" );
	set("attitude", "friendly");
	set("rank_info/respect", "小二哥");

    set("where","fy");
        set("no_clean_up",1);
	set("age", 25);
        }
	setup();
//	carry_object("/d/obj/kame_suit")->wear();
	set("vendor_goods", ([
		"/obj/example/wineskin" : 100,
        "/obj/example/teapot" : 100,
       __DIR__"obj/fruit" : 20,
		"/obj/example/dumpling" : 300,
		"/obj/example/chicken_leg" : 400,
                           ]) );

}

void init()
{	
	object ob,me;
        me=this_player();

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
if(!wizardp(me)) //巫师买东西不累计次数。
        add_action("do_buy","buy");               

}

void greeting(object ob)
{
        object me;
        me=this_player();
if( !ob || environment(ob) != environment() ) return;
       	switch( random(4) )
               {
		case 0:
			say( "店小二笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，进来喝杯茶，歇歇腿吧。\n");
			break;
		case 1:
			say( "店小二用脖子上的毛巾抹了抹手，说道：这位" + RANK_D->query_respect(ob)
				+ "，请进请进。\n");
			break;
		case 2:
			say( "店小二说道：这位" + RANK_D->query_respect(ob)
				+ "，进来喝几盅小店的红酒吧，这几天才从窖子里开封的哟。\n");
			break;
                case 3:
                        say( "店小二神秘的说道：这位"+RANK_D->query_respect(ob)+",在我们小店买东西\n"
                             "可是有好处的哟!!!\n");
                        break; 
        	}
}


int do_buy(string arg)
{
	int price, afford, change;
 	string item, targ;
	object ob,me,owner;
        me=this_player();

if(!arg || sscanf(arg, "%s from %s", item, targ)!=2 )
	return notify_fail("指令格式：buy <某物> from <某人>\n");

if( !objectp(owner = present(targ, environment(me))) )
	return notify_fail("你要跟谁买东西？\n");

if( userp(owner) ) {
	message_vision("$N想向$n购买「" + item + "」。\n", me, owner);
	return 1;
	}

if( (price = owner->buy_object(me, item)) < 1 )
	return notify_fail("对方好像没有你想要的东西。\n");

if( afford = affordable(me, price) ) 
    {
	pay_him(me, afford-price);
	owner->compelete_trade(me, item);
        do_check();
        return 1;
    }
else
	return notify_fail("你的钱不够。\n");
}



void pay_him(object who, int amount)

{
	object ob;
        object cash, tencash, gold, silver, coin;
        tencash = present("tenthousand-cash_money", who);
        cash = present("thousand-cash_money", who);
        gold = present("gold_money",who);
        silver = present("silver_money",who);
        coin = present("coin_money",who);
	if(tencash) destruct(tencash);
        if(cash) destruct(cash);
        if(gold) destruct(gold);
        if(silver) destruct(silver);
        if(coin) destruct(coin);


	if( amount < 1 ) amount = 1;
        if( amount/1000000 ) {
                ob = new(TECASH_OB);
                ob->set_amount(amount/1000000);
                ob->move(who);
                amount %= 1000000;
        }
        if( amount/100000 ) {
                ob = new(THCASH_OB);
                ob->set_amount(amount/100000);
                ob->move(who);
                amount %= 100000;
        }
	if( amount/10000 ) {
		ob = new(GOLD_OB);
		ob->set_amount(amount/10000);
		ob->move(who);
		amount %= 10000;
	}
        if( amount/100 ) {
                ob = new(SILVER_OB);
                ob->set_amount(amount/100);
                ob->move(who);
                amount %= 100;
        }
	if( amount ) {
		ob = new(COIN_OB);
		ob->set_amount(amount);
		ob->move(who);
	}
}


int affordable(object me, int amount)
{
        int total;
        object cash, tencash, gold, silver, coin;

        tencash = present("tenthousand-cash_money", me);
        cash = present("thousand-cash_money", me);
        gold = present("gold_money",me);
        silver = present("silver_money",me);
        coin = present("coin_money",me);

        total = 0;
        if( tencash) total += tencash->value();
        if( cash) total += cash->value();
        if( gold ) total += gold->value();
        if( silver ) total += silver->value();
        if( coin ) total += coin->value();

        if( total < amount ) return 0;

        return total;
}


void do_check()
{
        int i;
        object me,obj;        
        me=this_player();
        
        this_object()->add("shoppers",1);// 顾客积累的人数       
        save();

if (this_object()->query("shoppers")==10
        ||this_object()->query("shoppers")==100
        ||this_object()->query("shoppers")==500
        ||this_object()->query("shoppers")==1000
        ||this_object()->query("shoppers")==5000)
 {
 switch(this_object()->query("shoppers"))
        {
        case 10:    i=10;   break;
        case 100:   i=100;  break;
        case 500:   i=500;  break;
        case 1000:  i=1000; break;     
        case 5000:  i=5000; break;
        }     

        command("say 恭喜恭喜！！！，您是我们小店新开张以来第"+i+"位客人!!!");
        command("chat 恭喜"+me->name()+",他是我们小店开张以来的第"+i+"位客人!!!");
        command("chat 恭喜"+me->name()+"中了我们有奖购物大酬宾的大奖!!!"); 
        obj=new(__DIR__"obj/ticket");
        obj->set("shoppers",i);
        obj->set("really_ticket","yes");// 老板会以此为凭。
        obj->move(this_object());
        command("give "+me->query("id")+" "+obj->query("id")+""); 
       //玩家要凭借此物领奖!

        command("say 这是一张购物券，你凭此券可以到我们老板那里领取奖品!!!");                     
        command("say 这个东西可值钱啊，千万别搞丢了!!!");
        tell_object(me,"\n");
        message_vision("$N一听，立刻乐的嘴巴都合不上了。连忙说:祝你们的小店\n"
               "生意兴隆，财源广进,恭喜发财！恭喜发财!!!哈哈哈.....\n",me);
 }
else if(query("shoppers")==10000)
        {
        //这个奖品恐怕没有人会得到。呵呵。
        message("vision",HIC"店小二忽然大叫: 哇!!!哇!!!哇!!!恭喜恭喜！！！恭喜"+me->name()+"!!!\n"
               "恭喜"+me->name()+"成为我们小店新开张以来的第10000名顾客!!!\n"
               "为此！！！我们决定给"+me->name()+"频发超级大奖\n"NOR,users());
        obj=new(__DIR__"obj/ticket");
        obj->set("shoppers",10000);
        obj->set("really_ticket","yes");
        obj->move(this_object());
        this_object()->set("shoppers",0);//重新来过。
        command("give "+me->query("id")+" "+obj->query("id")+""); 
        command("say 这是一张购物券，你凭此券可以到我们老板那里领取奖品!!!");                     
        command("say 这个东西可值钱啊，千万别搞丢了!!!");
        tell_object(me,"\n");
        message_vision("$N一听，差点没有乐昏过去。连忙说:祝你们的小店\n"
               "生意兴隆，财源广进,恭喜发财！恭喜发财!!!哈哈哈.....\n",me);
        save();
        }                  
        remove_action("do_buy","buy");
}
