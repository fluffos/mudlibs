#pragma save_binary
// sedan_boss.c

int buy_sedan();

#include <ansi.h>

inherit NPC;

void create() {
  set_name(YEL "天机老人" NOR, ({ "old_man" }));
  set("title", "花轿店老板");
  set("gender", "男性");
  set("age", 43);
  set("long",
    "一位精明能干的老板，专门出售花轿\n");
  set("combat_exp", 500000);
  set("attitude", "friendly");
  set("inquiry", ([
    "花轿": (: buy_sedan :),
    "轿子": (: buy_sedan :),
  ]));
  set_skill("dodge", 100);
  set_skill("unarmed", 300);
  setup();
  carry_object("/obj/cloth")->wear();

  add_money("silver", 50);
}

int buy_sedan() {
  object husband, wife;
  string name;
  husband = this_player();
  if (husband->query("gender") != "男性") {
    tell_object(husband, "预定轿子的事情还是由你的丈夫来吧\n");
    return 1;
  }
  if (husband->query("MarrY")) {
    tell_object(husband, "你不是已经结过婚了吗？还要什么花轿啊？");
    return 1;
  }

  tell_object(husband, CYN "天机老人呵呵傻笑了两声：你的妻子是谁啊?\n");
  tell_object(husband, MAG "请输入你的未婚妻的英文名称:" NOR);
  input_to("find_your_wife", 1, husband);
  return 1;
}

int find_your_wife(string arg, object husband) {

  object wife;

  wife = find_living(arg);

  if (!wife)
    return notify_fail("你的未婚妻在那里？\n");
  else if (wife->query("gender") != "女性")
    return notify_fail("真是胡闹！你的老婆竟然不是女的？\n");
  else if (wife->query("MarrY"))
    return notify_fail("她已经结过婚了。还要雇佣什么轿子啊？");
  command("say 恭喜恭喜！你想预备什么样的轿子？");
  tell_object(husband, "我们这里的轿子有三种：\n"
    "1 二人小轿(需两个人抬)\n"
    "2 四人花轿(需四个人抬)\n"
    "3 八人大轿(需八个人抬)\n"
    "4 离开\n"
    "你想选择什么轿子去接你的新娘呢？(1,2,3,4)\n");
  input_to("my_choose", 1, husband, wife);
}

int my_choose(string arg, object husband, object wife) {
  int i, gold, number;
  object sedan;
  if (arg == "1") { gold = 200000; number = 2; } else if (arg == "2") { gold = 400000; number = 4; } else if (arg == "3") {
    gold = 800000; number = 8;
  } else if (arg == "4") { return 1; } else {
    tell_object(husband, "我们这里的轿子有三种：\n"
      "1 二人小轿(需两个人抬)\n"
      "2 四人花轿(需四个人抬)\n"
      "3 八人大轿(需八个人抬)\n"
      "4 离开\n"
      "你想选择什么轿子去接你的新娘呢？(1,2,3,4)\n");
    input_to("my_choose", 1, husband, wife);
    return 1;
  }
  if (!husband->can_afford(gold)) {
    tell_object(husband, "很可惜，你没有这么多钱！\n");
    return 1;
  } else {
    husband->pay_money(gold);
    sedan = new("/d/fy/npc/obj/sedan");
    sedan->set("max_numbers", number);  // 需要的轿夫人数。
    sedan->set("bridegroom", husband->query("id"));  // 新郎
    sedan->set("bride", wife->query("id"));  // 新娘
    sedan->move(environment(husband));
    command("say 呵呵，这是你的花轿。你带着他去迎接新娘吧！");
    return 1;
  }
}
