// poet.c 诗人 

#include <ansi.h>
inherit NPC;
create()
{
       set_name("大诗人",({"poet"}));
       set("title",HIM"才高八斗---学富五车"NOR);
       set("gender","男性");
       set("age",50);
       set("long","此人乃当代出名的大诗人，可谓才高八斗,学富五车.\n"
                  "此人诗词具佳，他经常吟诗作对，以此为乐.\n");        
       set("combat_exp",10000);
       set("max_force",200);        
       set("force",200);
       setup();
        add_money("silver",30);
       carry_object("/obj/cloth")->wear();
}


void init()
{
       object ob;
       ::init();
if( interactive(ob = this_player()) && !is_fighting() )
       {
       remove_call_out("greeting");
       call_out("greeting", 1, ob);
       }
}

int greeting(object me)
{

	string dir,poet;
        mixed *file;
        int i;
        dir="/d/poem/";
	message_vision(HIM""+this_object()->name()+"又开始念诗了。\n"NOR,me);
        file = get_dir(dir, -1);
if( !sizeof(file) )
	tell_object(me,"开启文件错误。\n");
	i=sizeof(file);
	poet=read_file(dir+file[random(i)][0]);
	poet=replace_string(poet,"：","："HIG);
	poet=replace_string(poet,"\n","\n"HIC);
	message_vision(HIY+poet+NOR,me);
	return 1;

}
