#pragma save_binary
//  /d/fy/npc/know-all.c 万事通
// By rongg 1998.8.31.
#include <ansi.h>
string get_file_name(string file);
inherit NPC;
string *msg_dunno = ({
	"$n摇摇头，说道：没听说过。\n",
	"$n睁大眼睛望著$N，显然不知道$P在说什麽。\n",
	"$n耸了耸肩，很抱歉地说：无可奉告。\n",
	"$n说道：嗯....这我可不清楚，你最好问问别人吧。\n",
	"$n想了一会儿，说道：对不起，你问的事我实在没有印象。\n"
});

void create()
{
        set_name("泥潭万事通",({"know-all"}));
        set("title",HIB"【包打听】"NOR);
        set("long","他就是著名的泥潭万事通。别看他长的丑陋无比。他对\n"
                   "这个泥巴里的人物可是非常了解。只要给他一个智慧果。\n"
                   "你就可以向他打探任何npc的所在地。另外。只要给他20两黄金\n"
                   "他就可以归还你的emote权利。\n");
        set("per",5);
        set("age",100);
        setup();       
        carry_object("/obj/cloth")->wear();        
}

void init()
{
        add_action("ask_me","ask"); 
}

int ask_me(string arg)
{
	string dest1,dest2,msg,name;
	object me,where,npc;
        me=this_player();

if(arg&&sscanf(arg, "%s about %s",dest1,dest2)==2&&dest1=="know-all"){
        message_vision(CYN"$N向万事通打探 ("+dest2+") 的下落。\n"NOR,me);
        if(me->query_temp("give_know-all_fruits")>0){     
            npc=find_living(dest2);
            if(npc&&!wizardp(npc)){
                if(userp(npc))
                    command("say 实在对不起，主人吩咐过我，不能告诉你玩家的位置！");
                else{
                    where=environment(npc);
                    if(where){
                        if(living(where))
	                    printf(CYN"万事通说道:%s(%s)现在在---%s---身上。\n"NOR,
                           (string)npc->name(),(string)npc->query("id"),(string)where->name());
                        else{
 	                    name=get_file_name(base_name(where));
 	                    if(name=="不知道那里") return 0;
 	                    else
 	                    printf(CYN"万事通说道：%s(%s)现在在 ---%s的%s--.\n"NOR,
        	 	    (string)npc->name(),
 	        	    (string)npc->query("id"),name,(string)where->query("short"));
  	    	        }
	                    me->add_temp("give_know-all_fruits",-1);
                    }else
                        command("say 实在对不起，我曾经见过这个人，但是我忘了他在那里了!");
                    // 曾经被载入内存，但是后来被杀，还没有重新被载入。
               } 
       }
       else
           command("say 实在对不起,我也不认识这个人！");
       }
    else
        command("say 我老了，如果没有智慧果吃，我就记不起来事情了.");
}else if(arg&&sscanf(arg, "%s about %s",dest1,dest2)==2&&dest1!="know-all")
    {
    npc=present(dest1,environment(me)); 
    
    if(!npc)
	return notify_fail("这里没有这个人。\n");

    if( !npc->is_character() ) {
	message_vision("$N对著$n自言自语....\n", me, npc);
	return 1;
	}

    if( !npc->query("can_speak") ) {
	message_vision("$N向$n打听有关『" + dest2 + "』的消息，但是$p显然听不懂人话。\n", me, npc);
	return 1;
	}

    if( !INQUIRY_D->parse_inquiry(me, npc, dest2) )
	message_vision("$N向$n打听有关『" + dest2 + "』的消息。\n", me, npc);

    if( userp(npc) ) return 1;
	if( !living(npc) ) {
		message_vision("但是很显然的，$n现在的状况没有办法给$N任何答覆。\n",
			me, npc);
		return 1;
	}

	if( msg = npc->query("inquiry/" + dest2) ) {
		if( stringp(msg) ) {
			message_vision( CYN "$N说道：" + msg + "\n" NOR, npc);
			return 1;
		}
	} else
		message_vision(msg_dunno[random(sizeof(msg_dunno))], me, npc);
    } 
else
     write("你要问谁什么事?\n",me);

return 1;
}

int accept_object(object me,object obj)
{
if(obj->name()=="智慧果"&&obj->query("really_fruit")=="yes")
        {
        command("say 呵呵，无功不受禄。你要打听谁就尽管问吧。");
        write("\n例子:ask know-all about xxx(英文id)\n",me);
        me->add_temp("give_know-all_fruits",1);
        call_out("destruct",2,obj);
        return 1;
        }        
else if(obj->query("money_id"))
		{
        if(obj->value()>=200000)
			{
			command("hehe");
			command("say 下次可要小心些啊。再次被剥夺了emote权利我也帮不了忙了！");	
			me->delete("is_robot");
			me->save();
			return 1;
			}
		else
			{
			command("say 20两黄金还你emote权利！");	
			return 0;
			}
		}
else
        return 0;
}

string get_file_name(string file)
{
	string name;
	name="";
if(strsrch(file,"baituo")>=0) name="白驮山";
if(strsrch(file,"canyon")>=0) name="黄石隘口";
if(strsrch(file,"choyin")>=0) name="乔阴县";
if(strsrch(file,"chuenyu")>=0) name="黑松阁";
if(strsrch(file,"city")>=0) name="京城";
if(strsrch(file,"city2")>=0) name="京城";
if(strsrch(file,"fy")>=0) name="风云城";
if(strsrch(file,"fywall")>=0) name="风云城墙";
if(strsrch(file,"gaibang")>=0) name="丐帮";
if(strsrch(file,"gameroom")>=0) name="扬州的游乐园";
if(strsrch(file,"goathill")>=0) name="宁远附近";
if(strsrch(file,"green")>=0) name="野羊山";
if(strsrch(file,"guanwai")>=0) name="关外";
if(strsrch(file,"gumu")>=0) name="古墓";
if(strsrch(file,"heimuya")>=0) name="黑幕崖";
if(strsrch(file,"huanggon")>=0) name="京城";
if(strsrch(file,"huashan")>=0) name="华山";
if(strsrch(file,"jiangnan")>=0) name="江南";
if(strsrch(file,"jinfeng")>=0) name="金风细雨楼";
if(strsrch(file,"lanruo")>=0) name="蓝若寺";
if(strsrch(file,"latemoon")>=0) name="晚月庄";
if(strsrch(file,"manglin")>=0) name="莽林";
if(strsrch(file,"mingjiao")>=0) name="明教";
if(strsrch(file,"ny")>=0) name="宁远";
if(strsrch(file,"oldpine")>=0) name="老松林";
if(strsrch(file,"sanyen")>=0) name="山烟寺";
if(strsrch(file,"quanzhen")>=0) name="全真教";
if(strsrch(file,"quanzhou")>=0) name="泉洲";
if(strsrch(file,"secret")>=0) name="";
if(strsrch(file,"shangshu")>=0) name="京城";
if(strsrch(file,"shaolin")>=0) name="少林寺";
if(strsrch(file,"quanzhen")>=0) name="全真教";
if(strsrch(file,"taishan")>=0) name="泰山";
if(strsrch(file,"temple")>=0) name="茅山";
if(strsrch(file,"village")>=0) name="天邪";
if(strsrch(file,"waterfog")>=0) name="全真教";
if(strsrch(file,"wudang")>=0) name="武当山";
if(strsrch(file,"xiangyang")>=0) name="襄阳城";
if(strsrch(file,"xingxiu")>=0) name="星宿";
if(strsrch(file,"xiyu")>=0) name="西域";
if(strsrch(file,"xueshan")>=0) name="雪山寺";
if(strsrch(file,"yangzhou")>=0) name="扬州";
if(strsrch(file,"zhaoze")>=0) name="西域";
if(name=="") return"不知道那里";
if(random(2)==1)
             return name;
else         return"不知道那里";
}

void destruct(object ob)
{
    destruct(ob);
}
