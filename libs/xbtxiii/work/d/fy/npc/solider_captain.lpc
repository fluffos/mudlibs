#pragma save_binary

#include <ansi.h>

inherit NPC;

void create() {
  set_name("风兵首领", ({ "captain" }));
  set("long", "此人是所有守城官兵的首领\n");
  set("attitude", "heroism");
  set("pursuer", 1);
  set("str", 27);
  set("cor", 26);
  set("cps", 25);
  set("combat_exp", 100000 + random(1000000));
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "风兵喝道：还不快放下武器束手就缚？\n",
    "风兵喝道：大胆刁民竟敢拒捕？反了！反了！\n"
  }));

  set_skill("unarmed", 70 + random(100));
  set_skill("spear", 70 + random(100));
  set_skill("parry", 70 + random(100));
  set_skill("dodge", 70 + random(100));
  set_skill("move", 100 + random(100));

  set_temp("apply/attack", 70);
  set_temp("apply/defense", 70);
  set_temp("apply/damage", 30 + random(200));
  set_temp("apply/armor", 70);
  set_temp("apply/move", 100);

  setup();

  carry_object(__DIR__ "obj/kiujia")->wear();
  carry_object(__DIR__ "obj/longdagger")->wield();
}

int init() {
  call_out("greeting", 1);
}

int greeting() {
  if (random(10) == 1) {
    command("say 要想解仇...........他妈的!给钱啊!他奶奶的..........");
    command("say 这年头弟兄们都快穷疯了..........");
  }
  return 1;
}
int accept_object(object who, object ob) {
  int i, j;
  object *npc;
  string *where, msg, temp;
  if ((int)ob->value() >= 500000) {
    say("风兵首领呵呵的笑道：好说，好说...\n");
    msg = HIC + this_object()->name() + "大声喝道:所有守城官兵听令,从今以后" + who->name() + "和我们无冤无仇,尔等不得为难!\n" NOR;
    message("vision", msg, users());
    who->delete("vendetta");
    who->remove_all_killer();
    this_object()->remove_killer(who);
    where = ({
      "/d/fy/npc/wind_solider",
      "/d/fy/npc/cloud_solider",
      "/d/fy/npc/captain",
      "/d/fy/npc/yayi1",
      "/d/chaoting/jjf/npc/jin_jun",
      "/d/chaoting/bingying/npc/bing2",
      "/d/chaoting/bingying/npc/bing",
      "/d/chaoting/xianya/npc/yayi",
      "/d/chaoting/xianya/npc/yayi1",
      "/d/chaoting/xianya/npc/yayi2",
      "/d/chaoting/xianya/npc/yayi3",
      "/d/jiangnan/jinglin/npc/cityguard",
      "/d/jiangnan/jinglin/npc/garrison",
      "/d/jiangnan/yangzhou/npc/garrison",
      "/d/jiangnan/yangzhou/npc/cityguard",
      "/d/choyin/npc/cityguard",
      "/d/yangzhou/npc/bing",
      "/d/yangzhou/npc/cityguard",
      "/d/yangzhou/npc/garrison",
    });

    /*             where=({
		"/d/fy/sgate",
		"/d/fy/egate" ,
		"/d/fy/wgate" ,
		"/d/fy/ngate" ,
		"/d/city/southdoor",
		"/d/city/eastdoor2",
		"/d/city/westdoor2",
		"/d/chaoting/jjf/jjf_0 ",
		"/d/city/northdoor",    
		"/d/city/eastdoor1 ", 
		"/d/city/westdoor1 ",
		"/d/jiangnan/jinglin/northdoor  ",
		"/u/cloud/dragonhill/nroad",
		"/d/choyin/n_gate      ",
		"/u/cloud/nwroad3      ",
		"/d/jiangnan/sroad13 ",
		"/d/yangzhou/southdoor",
		"/d/yangzhou/dongmen  ",
		"/d/yangzhou/ximen    ",
		"/d/yangzhou/bingyindamen",
             });
*/
    for (i = 0; i < sizeof(where); i++) {
      if (!npc = children(where[i])) continue;
      temp = "no_shout";
      for (j = 0; j < sizeof(npc); j++) {
        if (npc[j]->query("vendetta_mark") &&
          npc[j]->query("vendetta_mark") != "authority")
          continue;
        npc[j]->remove_killer(who);

        /*		    if(!find_object("/cmds/std/shout"))
		        load_object("/cmds/std/shout");
		    if(!find_object("/cmds/std/shout")){
		        msg="远远传来阵阵喊声:末将得令!";
		        message("vision",msg,users());
		    	continue;
		    }*/
        if (temp == "no_shout") {
          msg = "末将得令!从今以后不得为难" + who->name();
          "/cmds/std/shout.lpc"->main(npc[j], msg);
          temp = "shouted";
        }
        set_eval_limit(0);
      }

    }
    return 1;
  } else {
    say("风兵说道：这点钱还不够大爷喝酒的呢！\n");
    return 0;
  }
  return 0;
}
