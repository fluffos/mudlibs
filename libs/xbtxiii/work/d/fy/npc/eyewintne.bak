#pragma save_binary
#include <ansi.h>
#include <action.h>
#include <command.h>
#include <condition.h>
#include <dbase.h>
#include <move.h>
#include <name.h>
#include <skill.h>
#include <team.h>
#include <user.h>

inherit F_ACTION;
inherit F_ALIAS;
inherit F_COMMAND;
inherit F_CONDITION;
inherit F_DBASE;
inherit F_EDIT;
inherit F_FINANCE;
inherit F_MESSAGE;
inherit F_MORE;
inherit F_MOVE;
inherit F_NAME;
inherit F_TEAM;
inherit F_CLEAN_UP;

// Use a tick with longer period than heart beat to save cpu's work
 int tick;

// Use this function to identify if an object is a character.
//int is_character() { return 1; }

// setup: used to configure attributes that aren't known by this_object()
// at create() time such as living_name (and so can't be done in create()).
void setup()
{
	seteuid(getuid(this_object()));

	set_heart_beat(1);
	tick = 5 + random(10);
	enable_player();

}
void create()
{
	set_name("赛事广播者", ({ "eye wintne" }) );
	set("gender", "男性" );
	set("age", 25);
	set("long","赛事广播者。这个家伙是负责广播赛事的人。确切的说他不是一个人\n"
	           "它不是生物。你明白了么？算了。给你说你也不明白。\n");
	set("combat_exp", 50);
	set("attitude", "friendly");
	set("per",300000);
	set("no_shown",1);
	set("unit","个");
	set("no_get",1);
	setup();
}
int init()
{
}

int accept_fight(object who) {return 0;}
int return_home(object home) {return 0;}
void relay_message(string msgclass, string msg)
{
	object *hearer,room;
	int i;
	room=find_object("/d/fy/gameroom");
	if(!room) return ;
//	if(msgclass=="emote")return;
	msg=implode(explode(HIC"      "+msg,"\n"),"\n        "HIC)+"\n"NOR;
	hearer=query_temp("all_hearer");
	if(!arrayp(hearer)) hearer=({});
	for(i=0;i<sizeof(hearer);i++)
	    {
	    if(objectp(hearer[i]) &&environment(hearer[i])==room)
	        {
	        tell_object(hearer[i],""+msg);
	        }
	    else
		{
		hearer-=({hearer[i]});	
		set_temp("all_hearer",hearer);
		}
	    }

	return ; 
}
