// waiter.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("老裁缝", ({ "waiter" }));
  set("gender", "男性");
  set("age", 52);
  set("long",
    "这位老裁缝正笑咪咪地忙著，还不时的擦一擦自己的老花眼。\n");
  set("combat_exp", 5);
  set("attitude", "friendly");
  setup();
  carry_object("/obj/cloth")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_ding", "ding");
  add_action("do_update", "updatecloth");
  add_action("do_ding2", "ding2");
  add_action("do_update2", "updatebottle");

}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(5)) {
    case 0:
      say("老裁缝笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，进来订身衣服吧。\n");
      break;
    case 1:
      say("老裁缝愁眉苦脸说道：这位" + RANK_D->query_respect(ob)
        + "，你又胖又矮，这帮不了你。\n");
      break;
    case 2:
      say("老裁缝笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，进来定做个高级水袋吧。\n");
      break;

  }
}


int do_update(string arg) {
  object cloth, me;
  int i;

  me = this_player();
  if (!arg)
    return notify_fail("您要升级什么防具？\n");

  cloth = present(arg, me);
  if (!cloth)
    return notify_fail("你要升级什么防具???\n");
  if (!cloth->query("armor_type"))
    return notify_fail("我只会升级防具类的物品!!!\n");
  if (!cloth->query_autoload())
    return notify_fail("这样的防具好象不用升级了吧？\n");
  if (cloth->query("lost_prop") > 0)
    return notify_fail("去去去。先把你的" + cloth->name() + "修好了再来升级。\n");
  i = cloth->query("armor_prop/armor") + query("lost_prop") - 10;
  i++;
  if (i > 10)
    return notify_fail(CYN "老裁缝呵呵笑道:我能力有限。只能做到这个样子了。\n");
  if (!me->can_afford(i * 50000))
    return notify_fail("您这次升级所需费用为" + i * 5 + "两黄金，可惜你没有这么多钱!\n");
  me->pay_money(i * 50000);
  if (cloth->query("equipped"))
    cloth->unequip();
  cloth->add("armor_prop/armor", 1);
  write("您这次用于" + cloth->name() + "的升级费用为" + i * 5 + "两黄金。多谢光临！欢迎再来！！！");
  me->save();
}

int do_ding(string arg) {
  string ctype, cprop;
  object me, ob;
  int price, prop;
  string filename;
  me = this_player();
  if (!arg || sscanf(arg, "%s %s", ctype, cprop) != 2)
    return notify_fail("指令格式：ding <type> <color> <name> <English name>\n");
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if (me->query("potential") - me->query("learned_points") < 500)
    return notify_fail("你没有足够的潜能。\n");
  if (cprop == "麻布") { price = 5000; prop = 1; } else if (cprop == "棉布") {
    price = 10000; prop = 2;
  } else if (cprop == "绸缎") { price = 100000; prop = 4; } else if (cprop == "皮") {
    price = 50000; prop = 3;
  } else return notify_fail("小店可没有这种材料.\n");
  if (!me->can_afford(price))
    return notify_fail("你身上没那么多钱了。\n");
  switch (ctype) {
    case "hat":
      filename = sprintf(__DIR__ "obj/clothes/hat%d", prop);
      break;
    case "belt":
      filename = sprintf(__DIR__ "obj/clothes/belt%d", prop);
      break;
    case "boot":
      filename = sprintf(__DIR__ "obj/clothes/boot%d", prop);
      break;
    case "cloak":
      filename = sprintf(__DIR__ "obj/clothes/cloak%d", prop);
      break;
    case "cloth":
      filename = sprintf(__DIR__ "obj/clothes/cloth%d", prop);
      break;
    default:
      return notify_fail("这里不会做你要的东西．\n");
  }
  ob = new(filename);
  if (ob && ob->move(me)) {
    ob->autoload("10/0");
    me->pay_money(price);
    me->add("potential", -500);
    write("ＯＫ\n");
    return 1;
  }
  return 0;
}


int do_ding2(string arg) {
  string ctype1, ctype2;
  object me, ob;
  string filename;
  me = this_player();
  if (!arg || sscanf(arg, "%s %s", ctype1, ctype2) != 2)
    return notify_fail("指令格式：ding water bottle\n");
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if (!me->can_afford(80000))
    return notify_fail("定制一个高级水袋需要8两黄金,你身上没那么多钱了。\n");
  if (!me->query("marks/给了兽皮")) return notify_fail("定做水袋必须给我兽皮做原材料\n");
  filename = "/d/fy/npc/liquid/bottle.lpc";
  ob = new(filename);
  if (!ob) return notify_fail("高级水袋的文件出错了,快报告巫师吧\n");
  if (ob && ob->move(me)) {
    set_weight(700);
    ob->autoload("0/15/30");  //依次是当前剩余的水,最大容量,drunk_apply(喝一口,增加30点water)
    me->pay_money(80000);
    command("say 这个水袋你以后可要保存好了.");
    tell_object(me, "裁缝给了你一个水袋\n");
    tell_room("裁缝给了" + me->name() + "一个水袋\n", ({}));
    me->delete("marks/给了兽皮");
    return 1;
  }
  return 0;
}


int do_update2(string arg) {
  object bottle, me;
  int i;

  me = this_player();
  if (!arg || !(arg == "max_liquid" || arg == "drunk_apply"))
    return notify_fail("指令格式:updatebottle max_liquid或者updatebottle drunk_apply\n"
      "其中max_liquid是升级玉葫芦最大容量,drunk_apply是升级每喝一口水加的最大点数\n");

  bottle = present("water bottle", me);
  if (!bottle) return notify_fail("你要升级什么东西?我这里只负责升级玉葫芦(water bottle)\n");
  if (!bottle->query_autoload())
    return notify_fail("这样的东西不用升级了吧？\n");

  if (arg == "max_liquid") i = bottle->query("max_liquid") - 15;  //最初是15

  else if (arg == "drunk_apply") i = bottle->query("liquid/drunk_apply") - 30;  //最初是30

  i++;
  if (i < 0)
    return notify_fail("您的玉葫芦有错误。不能升级\n");
  if (i > 250)
    return notify_fail(CYN "张铁匠呵呵笑道:我能力有限。只能做到这个样子了。\n");
  if (!me->can_afford(i * 500))
    return notify_fail("您这次升级所需费用为" + i * 5 + "两白银，可惜你没有这么多钱!\n");
  me->pay_money(i * 500);
  if (arg == "max_liquid") bottle->add("max_liquid", 1);
  else if (arg == "drunk_apply") bottle->add("liquid/drunk_apply", 1);
  write("您这次用于" + bottle->name() + "的升级费用为" + i * 5 + "两白银。多谢光临！欢迎再来！！！\n");
  me->save();
  return 1;
}


int accept_object(object who, object ob) {
  string msg;
  if (ob->query("id") == "hide" && ob->query("name") == "兽皮") {
    msg = "裁缝仔细看了看手中的兽皮,满意的点了点头\n";
    tell_room(msg, ({}));
    command("say 这张兽皮确实不是普通的兽皮,我看可以用来做高级水袋");
    command("say 不过嘛,手工费还是要交的,8两黄金,如果你准备好了请(ding2 water bottle)");
    who->set("marks/给了兽皮", 1);  //这个标记在输入ding2 water bottle的时候会删除的
    return 1;

  } else {
    command("say 如果你想要定做高级水袋的话必须去搞到原材料");
    command("say 如果你已经给过我原材料了,那么请输入(ding2 water bottle)");
    return 0;
  }
  return 0;
}
