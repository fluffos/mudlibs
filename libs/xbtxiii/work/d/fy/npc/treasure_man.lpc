#pragma save_binary
// tea_waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("宝物商", ({ "treasure_man" }) );
        set("gender", "男性" );
        set("age", 40);
        set("long",
                "一个宝物商人．有各种各样的宝物出售。\n");
		set("combat_exp", 1000);
        set("max_force",200);
        set("force",200);
        set("attitude", "friendly");
        set("rank_info/respect", "老二哥");
         set("where","fy");

        set("vendor_goods", ([
                "/obj/wiz_cmds/flee":5,
                "/obj/wiz_cmds/invisibility":5,
                "/obj/wiz_cmds/fly":1,
                "/obj/wiz_cmds/repair":5,
                "/obj/wiz_cmds/halt":5,
                "/obj/wiz_cmds/hp":5,
                "/obj/wiz_cmds/skills":5,
        ]) );
        setup();
		carry_object("/obj/cloth")->wear();
}

void init()
{
        add_action("do_vendor_list", "list");
}
