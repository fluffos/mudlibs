#pragma save_binary
// jade gourd
// rongg@xbtxIII
#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;
inherit F_AUTOLOAD;

void create()
{
	set_name("高级水袋", ({ "water bottle" }) );
	set_weight(700);
	if( clonep() ) 
		set_default_object(__FILE__);
	else
	{ 
		set("long", "一个高级水袋,普普通通。\n");
		set("unit", "个");
		set("value", 500);
		set("max_liquid", 15);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "water",
		"name": "清水",
		"remaining": 15,
		"drunk_apply": 30,
	]) );
}



string query_autoload()
{//当前剩余的水                           最大水容量
	 return query("liquid/remaining")+"/"+query("max_liquid")+"/"+query("liquid/drunk_apply"); 
}
void autoload(string param)
{
        int eff_water,max_water,drunk_apply;
		string cname;
        if( !sscanf(param, "%d/%d/%d", eff_water,max_water,drunk_apply)==3 ) return;
        set("liquid/remaining",eff_water);      //当前葫芦里面剩余的水
        set("liquid/drunk_apply",drunk_apply);  //,喝一口增加的waiter点数
        set("max_liquid",max_water);            //,最大水容量
        if(!environment()) return;
		cname=environment()->query("env/bottle_name");
	 	if(stringp(cname)) {
        	cname = replace_string(cname, "$BLK$", BLK);
	       	cname = replace_string(cname, "$RED$", RED);
        	cname = replace_string(cname, "$GRN$", GRN);
	        cname = replace_string(cname, "$YEL$", YEL);
        	cname = replace_string(cname, "$BLU$", BLU);
	        cname = replace_string(cname, "$MAG$", MAG);
        	cname = replace_string(cname, "$CYN$", CYN);
	        cname = replace_string(cname, "$WHT$", WHT);
        	cname = replace_string(cname, "$HIR$", HIR);
	        cname = replace_string(cname, "$HIG$", HIG);
        	cname = replace_string(cname, "$HIY$", HIY);
	        cname = replace_string(cname, "$HIB$", HIB);
	        cname = replace_string(cname, "$HIM$", HIM);
	        cname = replace_string(cname, "$HIC$", HIC);
	        cname = replace_string(cname, "$HIW$", HIW);
	        cname = replace_string(cname, "$NOR$", NOR);
	        cname += NOR;
			set("name",cname);
		}

}

