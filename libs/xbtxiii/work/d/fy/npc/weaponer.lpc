#pragma save_binary

inherit NPC;
inherit F_VENDOR;
#include <ansi.h>
void create() {
  set_name("诸葛雷", ({ "zhuge" }));
  set("gender", "男性");
  set("age", 31);
  set("title", HIG "急风剑" NOR);
  set("long",
    "金狮镖局的大镖头，手底下还可以．\n");
  set("combat_exp", 500000);
  set("attitude", "friendly");
  set("per", 30);
  //     set("where","fy");
  set("vendor_goods", ([
    "/obj/weapon/whip": 20,
    "/obj/weapon/longsword": 20,
    "/obj/weapon/dart": 10,
    "/obj/weapon/shield": 10,
    "/obj/weapon/sixhammer": 10,
    "/obj/weapon/thin_sword": 10,
    "/obj/weapon/dagger.lpc": 10,
    "/obj/weapon/blade.lpc": 10,
    "/obj/weapon/spear/biyuqiang": 5,
    "/obj/weapon/spear/changqiang": 5,
    "/obj/weapon/spear/muqiang": 10,
    "/obj/weapon/spear/tieqiang": 10,
    "/obj/weapon/spear/tiespear": 10,
    __DIR__ "obj/1staff.lpc": 10,
    __DIR__ "obj/knife.lpc": 20,
    __DIR__ "obj/dual_ring.lpc": 10,
  ]));
  set_skill("sword", 50);
  set_skill("six-chaos-sword", 50);
  set_skill("pyrobat-steps", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  map_skill("dodge", "pyrobat-steps");
  map_skill("parry", "six-chaos-sword");
  map_skill("sword", "six-chaos-sword");
  setup();
  carry_object(__DIR__ "obj/jinzhuang")->wear();
  carry_object("/obj/longsword")->wield();
}
void init() {

  int t, d, h, m, s;
  t = uptime();
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;
  if (m >= 10 && m < 15)
    set("vendor_goods", ([
      "/obj/weapon/whip": 20,
      "/obj/weapon/longsword": 20,
      "/obj/weapon/dart": 10,
      "/obj/weapon/shield": 10,
      "/obj/weapon/sixhammer": 10,
      "/obj/weapon/thin_sword": 10,
      "/obj/weapon/dagger.lpc": 10,
      "/obj/weapon/blade.lpc": 10,
      "/obj/weapon/spear/biyuqiang": 5,
      "/obj/weapon/spear/changqiang": 5,
      "/obj/weapon/spear/gangqiang": 5,
      "/obj/weapon/spear/jinqiang": 1,
      "/obj/weapon/spear/muqiang": 10,
      "/obj/weapon/spear/tieqiang": 10,
      "/obj/weapon/spear/tiespear": 10,
      "/obj/weapon/spear/yinqiang": 1,
      __DIR__ "obj/1staff.lpc": 10,
      __DIR__ "obj/knife.lpc": 20,
      __DIR__ "obj/dual_ring.lpc": 10,
      "/obj/weapon/spear/gangqiang": 2,
      "/obj/weapon/spear/yinqiang": 2,
      "/obj/treasure/sword": 2,  // 三件比较好的武器。
      "/obj/treasure/spear": 2,
      "/obj/treasure/staff": 2,
      "/obj/weapon/sword/yue_nv_sword": 1,
      "/obj/weapon/sword/dragon_sword": 3,
      "/obj/weapon/sword/silver_sword": 3,
      "/obj/weapon/blade/kugudao": 1,
      "/obj/weapon/blade/gudingdao": 1,
      "/obj/weapon/whip/jueqingwhip": 2,
      "/obj/weapon/whip/wuchou": 2,


    ]));
  else
    set("vendor_goods", ([
      "/obj/weapon/whip": 20,
      "/obj/weapon/longsword": 20,
      "/obj/weapon/dart": 10,
      "/obj/weapon/shield": 10,
      "/obj/weapon/sixhammer": 10,
      "/obj/weapon/thin_sword": 10,
      "/obj/weapon/dagger.lpc": 10,
      "/obj/weapon/blade.lpc": 10,
      "/obj/weapon/spear/biyuqiang": 5,
      "/obj/weapon/spear/changqiang": 5,
      "/obj/weapon/spear/muqiang": 10,
      "/obj/weapon/spear/tieqiang": 10,
      "/obj/weapon/spear/tiespear": 10,
      __DIR__ "obj/1staff.lpc": 10,
      __DIR__ "obj/knife.lpc": 20,
      __DIR__ "obj/dual_ring.lpc": 10,
    ]));

  add_action("do_vendor_list", "list");
}
