#pragma save_binary
// playboy.c 相关人物:madam.c
// By rongg 1998.8.1.

#include <ansi.h>
inherit NPC;
int copy_your_skill(object me);
void create() {
  set_name("恶少", ({ "playboy" }));
  set("long", "当地出名的一个恶少爷，生性好色，天天在街上转悠。\n"
    "看他不住的东张西望，就知道他又在物色猎物。咳。。\n"
    "不知道哪家的女子又要遭殃了！\n");

  set("age", 22);
  set("gender", "男性");

  set("max_kee", 100000);
  set_skill("unarmed", 30);
  set_skill("xingxiu-duzhang", 30);
  set_skill("dodge", 30);
  map_skill("unarmed", "xingxiu-duzhang");
  set("combat_exp", 100);
  setup();
}

void init() {
  object me;

  ::init();
  if (interactive(me = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 3, me);
  }

  add_action("do_kill", "kill");
}

void greeting(object me) {
  object conspirator;  //conspirator:同谋者
  conspirator = present("pretty woman", environment(this_object()));
  if (!conspirator) {
    this_object()->set("long", "一个恶少站在这里，一对贼溜溜的眼睛四处东张西望\n"
      "不知道有在打谁的主义\n");
    return;
  }
  command("say " + RANK_D->query_rude(me) + "，你给我少管闲事!");
  command("say 你要是妨碍老子的好事，他奶奶的，老子非宰了你不可！！！");

}

int do_kill(string arg) {
  object me, conspirator;
  me = this_player();
  conspirator = present("pretty woman", environment(this_object()));
  if (arg == "playboy" && conspirator) {
    set_skill("unarmed", me->query_skill("unarmed") * 3);
    set_skill("dodge", me->query_skill("dodge") * 5);
    set("max_kee", 100000);
    set("kee", 100000);
    set("force", me->query("force"));
    // 费事立刻被人打死了，那样的话戏就没有办法继续了。       
    message_vision(CYN "$N大声喝道：光天化日之下，你这个" + RANK_D->query_rude(this_object()) + "\n"
      "竟然敢强抢民女!!!" + RANK_D->query_self_rude(me) + "实在看不过眼！去死吧！\n" NOR, me);
    message_vision(HIM "" + me->name() + "决定杀死" + this_object()->name() + ",承救面前的这位美人！\n" NOR, me);
    command("say 好你个" + RANK_D->query_rude(me) + ",敢太岁头上动土!看我怎么教训你!!!");
    me->kill_ob(this_object());
    this_object()->kill_ob(me);
    //call_out("leave_here",3,me); 
    return 1;
  } else if (arg == "pretty woman" && conspirator) {
    command("say 骂的！！！连老子看中的女人你都敢碰。真是吃了豹子胆了你!!!");
    command("say 尝尝老子的星宿毒掌!!!");
    this_object()->set_skill("xingxiu-duzhang", me->query_skill("unarmed"));
    map_skill("unarmed", "xingxiu-duzhang");
    this_object()->kill_ob(me);
    me->fight_ob(this_object());
    return 1;
  }
}

void leave_here(object me) {
  object conspirator;
  conspirator = present("pretty woman", environment(this_object()));
  command("say 好你个" + RANK_D->query_rude(me) + ",有种的你等着。老子叫人宰了你!");
  message("vision", CYN "恶少从地上爬了起来，狼狈的逃跑了。。。\n"
    "边跑还边骂骂咧咧:有种的给我等着....\n"
    "恶少跑远了还在喊道:" + me->name() + "...有种的你给我站在这里等着!!!\n" NOR, environment(me));
  me->set_temp("kill_playboy", 1);
  conspirator->start_playact(me);  //呼叫pretty woman
  destruct(this_object());

}


void start_teach(object me)  //此处是相同目录下的文件madam.c所呼叫的。
{
  call_out("go_player", 60, me);  //一分钟以后再和玩家算帐
}

int go_player(object me) {
  object *ob;
  object helper, helperr;
  if (me) {
    this_object()->move(environment(me));

    message_vision(HIR "刚才被打的恶少爷带着几个打手气势凶凶的走了过来\n" NOR, me);
    helper = new(__DIR__ "hitter");
    helperr = new(__DIR__ "hitter");
    helper->move(environment(this_object()));
    helperr->move(environment(this_object()));
    message_vision(CYN "恶少指着$N对打手喊道:小的们，就是他\n"
      "给我打呀！！！往死里打啊！！！！\n" NOR, me);
    message_vision(CYN "打手大声向" + me->name() + "喝道:你吃了豹子胆了你，竟然敢打我们少爷\n"
      "看你今天还往那里跑？老子非教训你一顿不可!!!\n" NOR, me);
    helper->kill_ob(me);
    helperr->kill_ob(me);
    this_object()->kill_ob(me);

    if (me->query("gender") == "女性") {
      command("say 小的们，下手轻一点！！！");
      command("hihi");
      command("say 抓活的！！！少爷我要亲自教训教训这个小娘子!");
    } else {
      message_vision(CYN "恶少和众打手边打" + me->name() + "还边骂骂咧咧：叫你他妈的撑英雄！\n"
        "叫你小子学英雄救美人!今天老子非好好教训你一顿不可！！！\n" NOR, me);
      message_vision("一群人说着说着就噼里啪啦的打了起来...........\n", me);
    }
  } else {
    move("/d/fy/fysquare");
    ob = all_inventory(environment());

    message("vision", "刚才被打的恶少爷带着几个打手气势凶凶的走了过来\n", ob);
    message("vision", CYN "他们东张西望，好象在找人\n" NOR, ob);
    command("say 奇怪了，刚才那个贱人跑哪里去了？");
    message("vision", CYN "众打手连忙附和道: 对啦。他一定是怕了我们少爷。哈~哈~哈~哈~哈\n" NOR, ob);
    command("ya");
    command("say 算他走运。临阵逃脱啦。。。。。");
    command("say 哈哈哈。老子心情高兴，我们一起去青楼泡妞去，我请客!!!");

    message("vision", "众打手轰然答应，连忙跟着恶少爷大腰大摆的走了。\n", ob);
    message("vision", HIM "恶少边走边唱:一摸呀，摸到姑娘的头发边。。。二摸呀，摸到.......\n", ob);
    call_out("leave", 5);
  }
}

void leave() {
  destruct(this_object());
}


int accept_fight(object who) {
  string msg;
  msg = "妈的,敢和老子打架?真他妈的太岁爷头上动土,看老子不收拾你\n";
  copy_your_skill(who);
  say(this_object()->name() + "骂道:" + msg);
  return 1;
}

int copy_your_skill(object who) {
  return 1;
}


void die() {
  object me;
  if (me = this_object()->query_temp("last_damage_from")) {
    if (present("pretty woman", environment(this_object())));
    {
      leave_here(me);  //赶快逃跑，呼叫leave_here()
      return;
    }
  }
  ::die();
}
