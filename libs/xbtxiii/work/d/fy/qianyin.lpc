#pragma save_binary
// inn.c

inherit HOCKSHOP;


void create() {
  add_light(this_object(), 1);
  set("coor", ({ 5, -100, 0 }));
  set("short", "千银当铺");
  set("long",
    "此当铺是南风大街对面的千金楼所设。以方便手头不宽的嫖客。\n"
    "千金楼的姑娘们也经常光顾这里，典当或是卖掉客人们高兴之余\n"
    "所赏赐的小玩意儿。此当铺虽然是千金楼所属，但却是童叟无欺。\n"
    "当铺挂有牌（ｓｉｇｎ）一块。\n"
  );

  set("exits", ([
    "west": __DIR__ "swind4",
  ]));
  set("item_desc", ([
    "sign": @TEXT
这里是钱庄，目前我们提供的服务有：

value       估价货物。
sell        卖断货物。
apply bag        申请乾坤袋

TEXT
  ]));


  set("objects", ([
    __DIR__ "npc/hockowner": 1,

  ]));

  set("rich", 800000);

  setup();
}
