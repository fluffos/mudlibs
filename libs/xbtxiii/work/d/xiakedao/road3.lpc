// /d/xiakedao/road3.c 侠客岛 山路3

inherit ROOM;
void create() {
  set("short", "山路");
  set("long",
    "这是通往山顶的小路，路旁杂草丛生，夹杂着一些不知名的野花。\n"
    "四周静悄悄地没有人声。你深深吸口气，一阵山野的芬芳直入心\n"
    "扉。\n"
  );
  set("outdoors", "xiakedao");
  set("exits", ([
    "northdown": __DIR__ "road2",
    "southup": __DIR__ "road4",
  ]));
  set("no_clean_up", 0);
  setup();
}
