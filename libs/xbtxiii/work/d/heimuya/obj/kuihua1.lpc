// kuihua.c 葵花宝典
// Jay 4/5/96

inherit ITEM;
void create()
{
          set_name("葵花宝典", ({ "kuihua baodian1", "baodian", "book"}));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long", "这就是武林第一秘籍《葵花宝典》，相传是一位宫中太监所作。\n");
                set("value", 50000);
                set("material", "paper");
       }
}
