inherit ROOM;

void create() {
  set("short", "圣姑堂");
  set("long",
    "这里是黑木崖的圣姑所在地“圣姑堂”。堂上无彩云罗,刹是漂\n"
    "亮.堂中一位妙龄女子,神彩奕奕.n"
  );
  set("exits", ([
    "east": __DIR__ "chitang",
  ]));
  set("objects", ([
    __DIR__ "npc/ren": 1,
    __DIR__ "npc/shinu": 2,
  ]));
  setup();
  replace_program(ROOM);
}
