//ROOM neishi.c
inherit ROOM;
void create() {
  set("short", "内室");
  set("long",
    "这里是女孩子的闺房，里面飘荡着幽幽清香。\n"
  );
  set("exits", ([
    "west": __DIR__ "xiaoshe",
  ]));

  setup();
}
void init() {
  add_action("do_search", "search");
}
int do_search()

{
  object *list, me, token;
  int i;
  me = this_player();
  list = all_inventory(me);
  i = sizeof(list);
  while (i--) {
    if (((string)list[i]->query("id")) == "xiuhua zhen")
      return notify_fail("忙活了半天，没有什么新的发现。\n");
  }
  if (random(me->query("kar") + 30) >= 35) {
    token = new(__DIR__ "npc/obj/zhen");
    token->move(me);
    message_vision("$N竟找到了一枚绣花针。\n", me);
    return 1;
  }
  return notify_fail("白忙了半天，一无所获。\n");
}
