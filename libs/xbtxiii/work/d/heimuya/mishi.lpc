#include <room.h>
#include <ansi.h>

inherit ROOM;
int do_break(string arg);

void create() {
  set("short", "秘室");
  set("long",
    "这是日月神教的密室，这里放着一本武林人士心仪以久的武林秘\n"
    "籍。\n"
  );

  set("exits", ([
    "enter": __DIR__ "mishi2",
    "down": __DIR__ "didao2",
  ]));
  set("objects", ([
    __DIR__ "obj/kuihua": 1,
  ]));
  setup();
}
