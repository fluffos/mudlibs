 // wooddragon.c

inherit NPC;

void create()
{
  set_name("黄鳞金龙", ({ "gold dragon","dragon" }) );
	set("long",
    "一只浑身长满黄鳞的龙，\n");

	set("race", "野兽");
	set("age", 600);
	set("attitude", "aggressive");

set_weight(75000);
  set("max_gin", 2500);
    set("max_kee", 9000);
      set("max_sen", 1200);

   set("str",30);
	set("cor", 200);
	set("cps", 30);
	set("spi", 70);
	set("int", 20);
        set("con",1000);
	set("limbs", ({ "头部", "身体", "前爪", "後爪", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );

      set_temp("apply/attack", 300);
    set_temp("apply/dodge", 350);
    set_temp("apply/armor", 300);
    set_temp("apply/damage", 20);
    set("combat_exp", 3000000);
	setup();
}
