#include <ansi.h>

inherit NPC;


void create()
{
        set_name("老朝奉", ({ "hockshop owner","owner","hocker" }) );
        set("title", "当铺老板");
        call_out("add_room_money",1,this_object());
        set("gender", "男性" );
        set("age", 35);

        set("str", 22);
        set("cor", 30);
        set("cps", 30);
        set("int", 26);
        set("per", 23);
        set("con", 24);
        set("spi", 30);
        set("kar", 25);

    set("where","fy");
        set("long","一个衣着光鲜的老朝奉。\n");          

        set("combat_exp", 200000);
        set("attitude", "friendly");
//        set("pursuer", 1);
        set("env/wimpy", 70);

        set("max_atman", 1000);         set("atman", 1000);             
set("atman_factor", 3);
        set("max_force", 1000);         set("force", 1000);             
set("force_factor", 3);
        set("max_mana", 1000);          set("mana", 1000);              
set("mana_factor", 3);

        set("chat_chance", 15 );
//        set("chat_msg", ({
//                (: random_move :),
//                (: exert_function, "powerfade" :),
//        }) );

        set("chat_chance_combat", 40);
   
        (: perform_action, "sword.counterattack" :),
        (: cast_spell, "drainerbolt" :),
        (: cast_spell, "feeblebolt" :),
        (: exert_function, "powerup" :),
        (: exert_function, "recover" :),

        set_skill("unarmed", 100);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("force", 100);
        set_skill("celestrike", 100);
        set_skill("celestial", 100);
//        set_skill("fonxansword", 100);
        set_skill("six-chaos-sword", 100);
        set_skill("chaos-steps", 100);
        set_skill("spells", 100);
        set_skill("necromancy", 100);

        map_skill("force", "celestial");
        map_skill("unarmed", "celestrike");
        map_skill("dodge", "chaos-steps");
        map_skill("sword", "fonxansword");
        map_skill("spells", "necromancy");
//        map_skill("sword", "fonxansword");
        
        setup();
        
        carry_object("/obj/longsword")->wield();
        carry_object("/obj/cloth")->wear();

        add_money("silver", 10);
}

int accept_fight(object me)
{
        command("say 咦... 要打就真打吧，光是较量多没意思？");
        command("grin");
        kill_ob(me);
        return 1;
}
 
void add_room_money(object me)
{
        int i;
        object room;
        room=environment(this_object());

        i=10000;
        if(room)
        {
        i+=room->query("rich");
        room->set("rich",i);
        return ;
        }
        else
        return;
}
int buy_object(object who, string arg)
{
        int i,index;
        object *inv, ob,storage;
        storage=environment(this_object())->query("storage_ob");

        if( !storage ) return 0;
        inv = filter_array( all_inventory(storage), (: $1->query("pawned_time") :));
        if( !sizeof(inv) ) return 0;

        if( sscanf(arg, "%s %d", arg, index) != 2 ) index = 1;
        index--;
        for(i=0; i<sizeof(inv); i++)
                if( inv[i]->id(arg) && !(index--)) break;

        if( i==sizeof(inv) )
             return 0;
        ob = inv[i];

        return ob->query("value")*2;
}
void compelete_trade(object who, string arg)
{
        int i,index;
        object *inv, ob,storage;

        storage=environment(this_object())->query("storage_ob");

        if( !storage ) return ;
        inv = filter_array( all_inventory(storage), (: $1->query("pawned_time") :));
        if( !sizeof(inv) ) return ;


        if( sscanf(arg, "%s %d", arg, index) != 2 ) index = 1;
        index--;
        for(i=0; i<sizeof(inv); i++)
                if( inv[i]->id(arg) && !(index--)) break;

        if( i==sizeof(inv) )
                return ;
        ob = inv[i];

        this_player()->start_busy(1);

        message_vision("$N掏出钱买下一" + ob->query("unit") + ob->name() + "。\n",
                this_player() );
        environment()->add("rich",ob->query("value")*2);
        ob->delete("pawned_time");
        ob->move(this_player());

        return ;
}

