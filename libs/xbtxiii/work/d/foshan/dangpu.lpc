#pragma save_binary
// inn.c

inherit HOCKSHOP;


void create() {
  add_light(this_object(), 1);
  //	set("coor",({150,-2775,0}));
  set("short", "英雄典当");
  set("long",
    "当铺里一张高高的柜台，柜台后面坐着当铺的朝奉。这家当铺是\n"
    "凤老爷所开，十多年来从没人来闹过事，朝奉也就很放心。柜台\n"
    "上挂着一个木牌子(paizi)。\n"
  );

  set("exits", ([
    "north": __DIR__ "westjie1",
  ]));
  set("item_desc", ([
    "sign": @TEXT
这里是钱庄，目前我们提供的服务有：

value       估价货物。
sell        卖断货物。

TEXT
  ]));


  set("objects", ([
    __DIR__ "npc/chaofeng": 1,
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "street5",
  ]));
  set("rich", 60000);

  setup();
}
