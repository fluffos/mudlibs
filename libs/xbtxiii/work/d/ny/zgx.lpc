#pragma save_binary
// mei_po.c
#include <ansi.h>

inherit NPC;

void create() {
  set_name("镇关西", ({ "zgx" }));
  set("title", "恶霸");
  set("gender", "男性");
  set("age", 43);
  set("cps", 10);
  set("str", 40);
  set("cor", 35);
  set("int", 15);
  set("spi", 5);
  set("per", 1);
  set("con", 20);
  set("kar", 18);
  set("long",
    "一位虎背熊腰的大块头\n");
  set("combat_exp", 10000);
  set("attitude", "friendly");
  set_skill("literate", 70);
  set_skill("dodge", 50);
  set_skill("unarmed", 200);
  set_skill("pyrobat-steps", 50);
  map_skill("dodge", "pyrobat-steps");
  setup();
  add_money("gold", 5);
}
