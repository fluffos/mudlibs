#pragma save_binary
// Room: /d/snow/happyinn2.c
#include <ansi.h>
inherit ROOM;
int mark_book;
void create()
{
	set("coor",({-40,4950,10}));
	set("short", "快活林西厢房");
	set("long",
"这是一间宽敞明亮的卧房，屋中有一张宽大的床，屋中的摆设虽\n"
"然很豪华，但是透出一股俗气。你总是觉得有一些古怪，但又看\n"
"不出来。\n"
);
	set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"happyinn0",
]));
	set("no_clean_up", 0);
	mark_book=1;
	setup();
}
void init()
{	object me;
	me=this_player();
    if(me->query_kar()>=15){
message_vision("$N突然看见墙角有道裂缝。请输入  search  来搜查。\n",me);
	add_action("do_search","search");}
	return;
}
int do_search(string arg)
{	object me,ob;
	me=this_player();
    if(me->query_kar()>8&&mark_book) {
	ob=new("/obj/book/parry_book");
message_vision("$N搜查墙角，在砖缝中发现一本“"+HIB"四两拨千斤指南"NOR+"”。\n",me);
        me->set_explore("north#22");
	ob->move(me);mark_book=0;}
	else message_vision("$N什么也没发现！\n",me);
	return 1;
}

