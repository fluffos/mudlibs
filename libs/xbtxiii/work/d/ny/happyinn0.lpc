inherit ROOM;

void create()
{
        add_light(this_object(),1);
	set("coor",({-20,4950,10}));
	set("short", "快活林酒店");
        set("long",
"你现在正站在快活林酒店的柜台旁，你环顾四周，只见一赤膊大\n"
"汉躺在藤椅上，他身边的保镖正在恶狠狠的看着你，靠墙的桌边\n"
"坐着几个江湖豪客，小二哥正忙着上菜；从这儿往东则是林间空\n"
"场了。\n"
);
        set("exits", ([ /* sizeof() = 2 */
        "west" : __DIR__"happyinn2",
        "east" : __DIR__"happyinn1",
 ]));
        set("objects", ([ /* sizeof() == 3 */
  "/d/ny/npc/zgx" : 1,
   "/d/ny/npc/room_guard" : 2,
  "/d/ny/npc/waiter" : 1,
]));
        set_temp("light",1);
        setup();
}
