#pragma save_binary
// Room: /d/snow/nroad4.c

inherit ROOM;
int do_mercy(string arg);
void create() {
  set("coor", ({ -40, 4870, 10 }));
  set("short", "小胡同");
  set("long",
    "你走到一个胡同里，西面是衙门，东面是堵土墙，这里是买卖人\n"
    "口的地方。\n"
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "yamen_square",
  ]));
  set("item_desc", ([
    "sign": @TEXT
卖身葬父，价格：１０两黄金。

mercy    同情施舍黄金。

TEXT
  ]));
  set("no_clean_up", 0);
  set("outdoor", "snow");
  set("objects", ([ /* sizeof() == 2 */
    "/d/snow/npc/poorgirl": 1,
  ]));
  setup();
}

void init() {
  add_action("do_mercy", "mercy");
}

int do_mercy(string arg) {
  object ob, me, girl, *sb;
  int price, i;
  me = this_player();
  girl = present("poor girl", this_object());
  if (!objectp(girl)) return 0;
  price = 100000;
  if (me->can_afford(price)) {
    me->pay_money(price, 0);
    message_vision("$N说道：“小妹妹，这些钱给你，赶快回家去吧！”\n", me);
    message_vision("说着，$N掏出一些金子给卖身女。。。\n", me);
    price = me->query_kar();
    if (objectp(present("jingang_book", me))) price = -727;
    if (random((17 - price) * 2) == 0) {
      seteuid(getuid());
      ob = new("/obj/book/jingang_book.lpc");
      ob->set("master_id", me->query("id"));
      ob->move(me);
      price = me->query_skill("essencemagic", 1);
      if (price++ < 10) me->set_skill("essencemagic", price);
      message_vision("卖身女将一本古书交给$N说：这是小女子家传至宝，\n
	希望能助您行走江湖。\n", me);
    }
    tell_room(environment(girl), "卖身女跪下磕头说：大恩不言谢，小女子这就去了。\n");
    tell_room(environment(girl), "卖身女走了。。。。。\n");
    destruct(girl);
  } else
    return notify_fail("你的钱不够。\n");
  return 1;
}
