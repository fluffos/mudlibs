// Room: /d/ustc/bforest/road1.c
#include <room.h>
#include <command.h>
inherit F_DBASE
inherit F_CLEAN_UP
inherit ROOM;

void create()
{
	set("short", "竹林");
	set("long", @LONG
这是一片茂密的竹林,一眼望不到头,你只觉得林中充满妖气,旁边有块
石头,上刻五个血红大字"汝葬身此地",四周多是竹子,你似乎是迷路了!
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
  "north" : "/d/ustc/bforest/road2",
  "south" : "/d/ustc/bforest/road2",
  "west" : "/d/ustc/bforest/road2",
  "east" : "/d/ustc/bforest/road4",
]));
	set("outdoors", "ustc");
        set("valid_startroom",1);
	setup();
}
void init()
{ object ob;
  add_action("do_quit","quit");
  if(interactive(ob=this_player()));
  ob->save();
}
