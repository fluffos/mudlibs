#pragma save_binary
// inn_2f.c

inherit ROOM;

void create()
{
    set("coor",({-20,4750,15}));
	set("short", "客栈二楼");
	set("long",
"你现在来到了客栈的二楼，这家客栈有个很奇怪的规矩，就是只\n"
"留宿名头够大的客人，如果你只是一个无名小卒，不论出再多银\n"
"两都租不到一间空房，墙边有一道楼梯通往一楼的茶座。\n"
);
	set("exits", ([
        "down" : __DIR__"inn" ]) );
	setup();
}
void init()
{
/*
   add_action("do_match", "match");
*/
}
int do_match(string arg)
{
object me;
me=this_player();
me->move("/d/player/square");
tell_object(me,"一道强光闪过之后,你发觉你来到了比武大会的赛场。\n");
return 1;
}
