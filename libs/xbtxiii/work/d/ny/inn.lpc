//inn.c
#include <room.h>

#include <ansi.h>
inherit ROOM;

string look_sign(object me);

void create()
{
	set("coor",({-20,4750,10}));
	set("short",CYN"有一间客栈"NOR);
	set("long",
"你现在正站在宁远南边的一家小客栈里，这家客栈虽小，却是方\n"
"圆五百里内最负盛名的一家，客栈的主人据说是一位云游四海的\n"
"仙人，如果你的福缘深厚的话，也许可以在这里遇到他。除此之\n"
"外，来自各地的旅人都喜欢聚集在这里交换旅途上的见闻，你也\n"
"可以在这里打听到许多有趣的消息。靠近门口的地方有一块乌木\n"
"雕成的招牌(sign)。西北边有一个红木门(door)，门上泛著一层\n"
"白色的光晕，一种令人感觉很有力量，又很柔和的光芒。\n"
);

	// This enables players to save this room as their startroom.
	set("valid_startroom", 1);

	set("item_desc", ([
		"sign": (: look_sign :),
		"door": (: look_door, "northwest" :),
	]) );
	
	set("exits", ([
        	"east"      : "/d/ny/square",
        	"up"        : "/d/ny/inn_2f",
		"northwest"	: "/d/wiz/entrance" ]) );

	set("objects", ([
        	"/d/snow/npc/trav_blade" : 2,
        	"/d/ny/npc/waiter" : 1,
		 ]) );


	create_door("northwest", "木门", "southeast", DOOR_CLOSED);

	set_temp("light",1);
	setup();

}

string look_sign(object me)
{
	if( wizardp(me) )
   return "招牌写著：有一间客栈。旁边一排小字：庄思哑题。\n";
	else
   return "招牌写著：有一间客栈。\n";
}
