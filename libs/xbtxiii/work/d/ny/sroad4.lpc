#pragma save_binary
// Room: /d/snow/sroad4.c

inherit ROOM;

void create() {
  set("short", "青石官道");
  set("long",
    "这是一条宽敞坚实的青石板大道，大道两旁种著整齐的花木，从\n"
    "这里往北通往水烟阁，往南则是衔接雪亭镇街道的路口。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": "/d/waterfog/sroad1",
    "south": "/d/ny/sroad3",
  ]));
  set("outdoors", "snow");

  setup();
  //  replace_program(ROOM);;
}
int valid_leave(object me, string dir) {
  if (dir == "north" && !wizardp(me))
    return notify_fail("那里施工中，请改道。\n");
  return ::valid_leave(me, dir);
}
