#pragma save_binary
// magic_armor2.c
#include <ansi.h>
#include <armor.h>
inherit ARMOR;
void create() {
  set_name(BLU "金刚战甲" NOR, ({ RED "magic armor", "armor" NOR }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "gold");
    set("armor_prop/armor", 60);
    set("armor_prop/dodge", 40);
  }
  set("no_get", 1);
  setup();
}
mixed hit_ob(object me) {
  if ((int)me->query("gin") < (int)me->query("max_gin") / 2)
    me->receive_heal("gin", (int)me->query("max_gin") / 10);
  if ((int)me->query("kee") < (int)me->query("max_kee") / 2)
    me->receive_heal("kee", (int)me->query("max_kee") / 10);
  if ((int)me->query("sen") < (int)me->query("max_sen") / 2)
    me->receive_heal("sen", (int)me->query("max_sen") / 10);

  return HIY
    "王□剑发出一股金色的罡气，流遍$N的全身。\n" NOR;
}
