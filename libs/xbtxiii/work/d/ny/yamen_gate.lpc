#pragma save_binary
// Room: /d/snow/yamen_gate.c

#include <room.h>
inherit ROOM;


void create()
{
	set("coor",({-60,4870,10}));
	set("short", "县衙大门");
	set("long",
"这里就是雪亭镇县衙大门,厚重的门边站着两个精神抖擞的衙役,\n"
"右手边放着一面硕大的牛皮鼓(drum).你是不是有什么想说的？\n"
"从这往南是金兰会,据说是德高望重的义士才能加入,而且门规森\n"
"严!\n"
);
	set("item_desc", ([ /* sizeof() == 1 */
  "drum" : "\n	击鼓申冤   beat\n",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/judge_guard" : 2,
]));
	set("outdoors", "snow");
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"yamen_yard",
    "southeast" : __DIR__"yamen_square",
  "south":"/d/jinlan/jinlan.lpc",
]));
    set("no_fight",0);
	create_door("west","厚重的铁门","east",DOOR_CLOSED);
	set("no_clean_up", 0 );
	setup();
}

void init()
{
if (this_player()->query_temp("have_beat_drum"))
		this_player()->delete_temp("have_beat_drum");
/*
add_action("do_beat","beat");
add_action("do_open","open");
add_action("do_go","go");
*/
}

int do_beat(string arg)
{
object me,waiter,yamen;
string go,open;
me=this_player();
if (!arg||(string)arg!="drum")
		return notify_fail("你要击打什么？\n");
if (me->query_temp("have_beat_drum"))
	return notify_fail("你已经敲过鼓了！\n");
me->set_temp("have_beat_drum",1);
if (!objectp(yamen=find_object("/d/snow/yamen.lpc")))
	{
	call_other("/d/snow/yamen.lpc","???");
	yamen=find_object("/d/snow/yamen.lpc");
	}
if (!objectp(waiter=present("magistrate waiter",yamen)))
	return notify_fail("Sorry, can't find waiter. Try again please\n");
if (!objectp(waiter->query_temp("pending/beat")))
	{
	waiter->set_temp("pending/beat",me);
	call_other(waiter,"greeting",me);
	me->delete_temp("have_beat_drum");
	}
else
	{
	me->delete_temp("have_beat_drum");
	write ("县太爷正在断案，请稍待。\n");
	}
return 1;
}

int do_open(string arg)
{
if (arg=="door")
	{
	write("这是县衙大门，不能闹着玩儿！\n");
	return 1;
	}
}

int do_go(string arg)
{
if (!arg) return 0;
if (arg=="west") { write("只见两个衙役把大棍一横, 喝道: 未经许可, 不得入内!\n");
		return 1;
		}
return 0;
}

