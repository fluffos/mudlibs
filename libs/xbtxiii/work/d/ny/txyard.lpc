inherit ROOM;

void create()
{
        set("coor",({-200,4750,10}));
	set("short", "水烟阁后院");
        set("long",
"你现在正站在一个宽敞的教练场中，地上铺著黄色的细砂，许多\n"
"人正在这里努力地操练著，北边是一间高大的兵器厅，往南则是\n"
"水烟阁。\n"
);
 set("exits", ([ /* sizeof() = 2 */
    "north" : "/d/ny/txgate",
    "southup" : "/d/waterfog/guildhall",
]));
        set("objects", ([ /* sizeof() == 2 */
    "/d/snow/npc/txtrainee" : 3,
    "/d/snow/npc/txtrainer" : 1,
]));
        set("outdoors", "snow");
        set("clean_up",1);

        create_door("north", "红漆大门", "south", DOOR_CLOSED);
        setup();
}
void init()
{
    if(this_player())
        this_player()->set_explore("north#21");
}
