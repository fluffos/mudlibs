#pragma save_binary
// Room: /d/snow/postoffice.c

inherit ROOM;

void create()
{
    add_light(this_object(),1);
	set("coor",({-20,4850,10}));
	set("short", "官府驿站");
	set("long",
"这里是负责宁远城官府文书跟军令往来的驿站，但是因为出了宁\n"
"远城往西北就是通往西域的一片无人居住的大沙漠，所以驿站来\n"
"往的人就少了，驿站的官员索性就开始接一些百姓的信件，一方\n"
"面打发时间，一方面也有点事做以免被上级裁撤。驿站大门口上\n"
"悬著一块木牌(sign)，上面写了些字。从这里向西可以达到衙前\n"
"的广场。\n"
);
	set("item_desc", ([ /* sizeof() == 1 */
  "sign" : "牌子上写道：
    奉乔阴府知县令喻，本驿著日起收发事宜扩及官员百姓上下人
等通办，官员及兵部该管军士、官府衙役免费，一般良民百姓书信
收费每通十文，收信免费，物品收费依份量大小另计，贵重细软倘
有遗失退费加五成赔偿，不得异议。

最新利民服务：长途马车出租。

终点                票价
京城                2  silvers

收款人 驿长杜宽
",
]));
	set("exits", ([ /* sizeof() == 1 */
        "east" : __DIR__"nroad2",
                "west" : __DIR__"yamen_square"
	]));
	set("objects", ([
        __DIR__"npc/post_officer" : 1 
	]) );

	setup();
}

int valid_leave(object me, string dir)
{
	object mbox;

    return 1;
	if( mbox = me->query_temp("mbox_ob") ) {
		tell_object(me, "你将信箱交回驿站。\n");
		destruct(mbox);
	}
	return 1;
}
