#pragma save_binary
//traveller.c
inherit NPC;

void create()
{
        set_name("旅客", ({ "traveller"}));
        if(random(10)<7)
            set("gender", "男性" );
        else
            set("gender", "女性" );
        set("age", 15+random(50));
        set("long",
                "这是一位来雪亭镇的外地旅客.\n");
        set("chat_chance", 0);
        set("chat_msg", ({
(:command("get all"):),
(:random_move:)
 }));
        set("combat_exp", 600+random(400));
        set("attitude", "friendly");
        set_skill("dodge", 50);
	set_skill("throwing",30);
        set_skill("unarmed", 40);
        setup();
        carry_object(__DIR__"obj/throwing_knife")->wield();
	carry_object("/obj/cloth")->wear();
        add_money("coin",30);
        set("score",5-random(10));
}
int heal_up()
{
     object obj;
     obj=all_inventory(this_object())[random(sizeof(all_inventory(this_object())))];
     if(random(5)>1) this_object()->random_move();
     if(random(6)<1) command("open door");
     if(random(6)<1) command("get all from corpse");
     if(random(3)<1) command("eat "+obj->query("id"));
     if(random(3)<1) command("drink "+obj->query("id"));

     if(random(60)<1)     this_object()->move("/d/snow/hockshop");
     if(random(60)<1)     this_object()->move("/d/yangzhou/guangchang");
     if(random(2)<1) command("sell "+obj->query("id"));
     if(obj->query("value")<1&&obj->value()<1)
       if(!obj->is_corpse())
         if(obj->query("id")!="throwing knife")
         if(obj->query("id")!="cloth")
           command("drop "+obj->query("id"));
   command("get all");
        return ::heal_up()+1;
}



