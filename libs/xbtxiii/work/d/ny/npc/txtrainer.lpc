#pragma save_binary
// trainer.c

#include <ansi.h>
inherit NPC;

void create() {
  string *fname = ({ "饭", "汤", "粥" });
  set_name("冯稀" + (fname[random(3)]), ({ "txtrainer", "feng" }));
  set("title", "剑法教练");
  set("gender", "男性");
  set("nickname", HIC "半剑有血" NOR);
  set("shen_type", -1);
  set("age", 30);
  set("str", 26);
  set("int", 14);
  set("long",
    "冯稀饭是个孔武有力的大块头，他正在训练他的弟子们习练「基本剑\n"
    "法」(sword)。\n"
  );
  set("bellicosity", random(1000));
  set("combat_exp", 10000);
  set("attitude", "heroism");

  set("force", 120);
  set("max_force", 120);
  set("force_factor", 1);

  set("inquiry", ([
    "here": "这里当然是水烟阁，不然还是哪里？\n",
    "name": "在下姓冯，名字就叫稀饭，人称“半剑有血”便是我。\n",
  ]));

  set_skill("unarmed", 50);
  set_skill("liuh-ken", 40);
  set_skill("sword", 80);
  set_skill("dodge", 80);
  setup();
  carry_object("/d/snow/npc/obj/bamboo_sword")->wield();
}

int recognize_apprentice(object ob) {
  if ((string)ob->query("family/family_name") == "天邪派") return 1;
  command("say 对不起，这位" + RANK_D->query_respect(ob) +
    "，您不是我们天邪弟子。");
  return notify_fail("冯稀饭不愿意教你剑法。\n");
}

int accept_fight(object me) {
  if ((string)me->query("family/family_name") == "天邪派") {
    command("nod");
    command("say 进招吧。");
    return 1;
  }
  command("say 师傅吩咐过，不许和来这里的客人过招。");
  return 0;
}
