#pragma save_binary
// herbalist.c
#include <ansi.h>
inherit NPC;

int pay_money(object who, int amount);
int check_money(object me, int amount);
mixed heal_me();

void create()
{
    set_name("林掌柜", ({ "herbalist" }) );
    set("title", "林家铺子");
        set("gender", "男性" );
        set("age", 54);
        set("long",
        "林掌柜是这附近相当有名的大善人，常常施舍草药给付不起药钱的穷人\n"
                "。此外他的医术也不错，年轻时曾经跟著山烟寺的玄智和尚学医，一般\n"
                "的伤寒小病直接问他开药吃比医生还灵。\n" );
        set("combat_exp", 130000);
        set("attitude", "friendly");
        set("inquiry", ([
                        "治伤": (: heal_me :),
                        "开药": (: heal_me :),
                "治病": (: heal_me :),
                "疗伤": (: heal_me :),
                "救命": (: heal_me :),
                "恢复": (: heal_me :),
                "解毒": 
"哎哟，你不说我倒忘了，过两天我一定去向玄智大师请教......\n",
        ]) );

        set_skill("literate", 70);
        set_skill("dodge", 100);
        set_skill("unarmed", 100);
        setup();
        carry_object("/obj/cloth")->wear();
        add_money("silver", 10);
}
mixed heal_me()
{
            int cost,damage_point,max_gin;
            int max_kee,max_sen,money;
                object me;
                me=this_player();

if (this_object()->is_fighting())
                return notify_fail("没看见有人要杀我吗?!\n");

                max_sen=me->query("sen");
                max_kee=me->query("kee");
                max_gin=me->query("gin");

if(me->query("eff_kee")>=max_kee
   &&me->query("eff_sen")>=max_sen
   &&me->query("eff_gin")>=max_gin)
                return notify_fail(CYN""+this_object()->name()+"笑道:你身体好好的，看什么病啊？\n"NOR);
else
                damage_point=((max_kee-me->query("eff_kee"))/max_kee
                                        +(max_sen-me->query("eff_sen"))/max_sen
                                        +(max_gin-me->query("eff_gin"))/max_gin)*100*30;
    if(me->can_afford(damage_point)<=0)
        
        return notify_fail("你没有这么多钱\n");

else
    me->pay_money(damage_point);

                return 1;
}

