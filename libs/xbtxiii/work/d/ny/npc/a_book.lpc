#pragma save_binary
// account_book.c

inherit ITEM;
inherit F_SAVE;

void create() {
  set_name("帐簿", ({ "account book", "account", "book" }));
  set("unit", "本");
  if (clonep())
    set_default_object(__FILE__);
  seteuid(getuid());
}


void init() {
  if (environment()->query("id") != "annihir" || userp(environment()))
    destruct(this_object());
  else {
    add_action("do_bank", "deposit");
    add_action("do_bank", "draw");
    add_action("do_query", "query");
  }
}

string query_save_file() {
  return DATA_DIR + "bank/" + this_player->id(0) + "/" + player->id();
}

string query_autoload() { return query("master_id"); }

int do_unseal(string arg) {
  int i;
  string guild_id, guild_name;

  set("guild_id", arg);
  if (restore()) {
    write("Ok.\n");
    return 1;
  } else {
    delete("guild_id");
    return notify_fail("没有这个门派。\n");
  }
}

if (file_size(query_save_file() + SAVE_EXTENSION) >= 0)
  restore();
return 1;
}
