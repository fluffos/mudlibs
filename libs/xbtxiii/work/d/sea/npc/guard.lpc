#pragma save_binary
// guard.c

inherit NPC;

void create() {
  set_name("卫兵", ({ "gate guard", "guard" }));
  set("title", "驿道");
  set("gender", "男性");
  set("age", 35);
  set("long", "你看到一个剽悍的大块头, 正在恶狠狠地瞪着你.\n");
  set("str", 29);
  set("int", 14);
  set("combat_exp", 5000 + random(1000));
  set("attitude", "heroism");
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);

  set("inquiry", ([
    "出海": "朝廷有令,任何人不得私自出海,你想干什么?!!。",
  ]));

  setup();
  add_money("silver", 10);
  add_money("coin", 500);
  carry_object("/obj/cloth")->wear();
}
