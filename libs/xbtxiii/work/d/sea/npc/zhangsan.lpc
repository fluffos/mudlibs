#pragma save_binary
// oldsailor.c

#include <ansi.h>
inherit NPC;

int do_ok(string);
mixed jiebai(mixed arg) {
  object me, obj, *obb;
  int s;
  me = this_player();
  s = random(6);
  if (s > 3) {
    add_action("do_ok", "ok");
    tell_object(me, "张三说道:你要和我接拜?嘿嘿......好好,来来来,我们撮土为香.(ok) \n");
    tell_object(me, "你跪了下来,和张三李四对天发誓:不求同年同月生....... \n");
    return 1;
  }
  tell_object(me, "张三说:你?别做梦了.哼........ \n");
  return 1;
}

int do_ok(string arg) {
  object me, *ob, bk;
  int i, money;
  me = this_player();
  bk = new("/d/sea/npc/obj/seamap");
  tell_object(me, "你跪了下来,和张三李四对天发誓:不求同年同月生....... \n");
  tell_room(environment(me), me->query("name") + "与张三李四跪在地上嘟哝了几句什么.\n.", me);
  tell_object(me, "如今你我三人都是兄弟了,自当有福..有难..我送你到一个地方. \n");
  tell_object(me, "你只觉得脚下一空,眼前一黑.......\n");
  tell_room(environment(me), me->query("name") + "突然不见了! \n", me);
  me->move("/d/sea/mishi");
  return 1;
}

void create() {
  set_name("张三", ({ "zhangsan" }));
  set("gender", "男性");
  set("age", 34);
  set("long", @LONG
他是一个胖乎乎的中年人,她正笑眯眯地看着你,不过你总觉得他的笑容
怪怪的,似乎充满了神秘的色彩.他的手里正拿着一个红色的大葫芦,不时拿起
起来喝上一口,又小心地盖上盖子.
LONG);
  set("attitude", "peaceful");

  set("str", 26);
  set("int", 24);

  set("combat_exp", 900000);

  set("chat_chance", 10);

  set("inquiry", ([
    "结拜": (: jiebai :),
  ]));

  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 20);

  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);

  setup();

  carry_object("/d/snow/obj/cloth")->wear();

}
