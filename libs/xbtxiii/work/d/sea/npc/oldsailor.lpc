#pragma save_binary
// oldsailor.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("老水手", ({ "oldsailor" }));
  set("gender", "男性");
  set("age", 54);
  set("long", @LONG
他是一名久经风浪的老水手,对这一带的海域他可是了如指掌,传说他的爷爷
"老狐狸"曾经跟随大虾陆小凤到海外寻找仙山,但一去就没再回来.如果你想
出海,找他可是找对人了.
LONG);
  set("attitude", "peaceful");

  set("str", 26);
  set("int", 24);

  set("combat_exp", 100000);

  set("chat_chance", 6);
  set("chat_msg", ({
    "老水手叹了口气,似乎回忆起当年海上的生活。\n",
    "老水手自言自语道：有了罗盘就可以出海了。\n",
  }));

  set("inquiry", ([
    "出海": "出海要有海图和罗盘。\n",
    "罗盘": "罗盘? 听说让神仙给收去了.你有吗?给我看看好吗?嘿嘿..\n",
    "海图": "你问这个喔....去问问阿牛的妈妈吧。\n",
  ]));

  set("force", 600);
  set("max_force", 600);
  set("force_factor", 5);

  set_skill("unarmed", 60);
  set_skill("parry", 60);
  set_skill("dodge", 50);

  setup();
  carry_object("/d/snow/obj/cloth")->wear();
  carry_object("/d/sea/npc/obj/sword")->wield();
}

int accept_object(object who, object ob) {
  if ((string)ob->query("id") != "luopan") {
    command("smile");
    command("say 谢谢你啦! \n");
    return 1;
  } else {
    tell_object(who, "老水手失声叫道:啊!罗盘!我终于可以出海了! \n");
    tell_object(who, "老水手警惕地看看四周,弯下腰将脚下的木板掀开.下面出现一个黑漆漆的暗道! \n");
    tell_object(who, "你走进暗道,咣!木板又重重关上了. \n");
    tell_room(environment(who), who->name() + "走进暗道,暗道门又关上了.\n", who);
    who->move("/d/sea/andao1");
    return 1;
  }
}
