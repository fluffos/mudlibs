#pragma save_binary
inherit ITEM;

void create()
{
        set_name("海图", ({ "seamap" }));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("long", "一张珍藏多年的海图，或许在出海时还有用。\n"
                            "  上面写着:\n"
                            "从火烧岛向南五次再向东四次可到侠客岛. \n"
                                        );
                set("value", 0);
                set("material", "copper");
        }
}

