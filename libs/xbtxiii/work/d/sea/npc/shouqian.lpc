#pragma save_binary
// oldwizard.c

inherit NPC;

void create() {
  set_name("神算子", ({ "oldwizard" }));
  set("gender", "男性");
  set("age", 54);
  set("long", @LONG
他是一名看签人,专门为讨海人看出海的凶吉,因为他妙算如神,所以大家
都尊称他为"神算子".但他也因此遭到倭寇的记恨,倭寇扬言要杀他全家,无奈
之下,他只好躲了起来.
LONG);
  set("attitude", "peaceful");

  set("str", 26);
  set("int", 24);

  set("combat_exp", 100000);

  set("chat_chance", 10);
  set("chat_msg", ({
    "神算子叹了口气,转过身去一言不发。\n",
  }));


  set("force", 600);
  set("max_force", 600);
  set("force_factor", 5);

  set_skill("unarmed", 60);
  set_skill("parry", 60);
  set_skill("dodge", 50);

  setup();

}

int accept_object(object who, object ob) {
  if (((string)ob->query("id") != "qian1") && ((string)ob->query("id") != "qian2"))
)
{
  command("thank");
  return 1;
}
if ((string)ob->query("id") = "qian1") {
  command("sigh");
  say("神算子低声说到:这位" + RANK_D->query_respect(who) + ",今天就别出海了,很危险啊! \n");
  return 1;
}
if ((string)ob->query("id") = "qian2") {
  command("smile");
  say("神算子高兴地说:这位" + RANK_D->query_reapect(who) + "这签不错,可以出海了,给你一面罗盘,一帆风顺哦! \n");
  obj = new("/d/sea/npc/obj/luopan");
  obj->move(who);
  return 1;
}
}
