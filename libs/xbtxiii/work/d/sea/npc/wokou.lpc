#pragma save_binary
// captain.c

#include <ansi.h>

inherit NPC;


void create() {
  set_name("倭寇", ({ "wokou" }));
  set("gender", "男性");
  set("age", 30);
  set("long",
    "他满脸横肉,一看就知道不是善类。\n");

  set("attitude", "aggressive");

  set("str", 27);
  set("int", 25);

  set("combat_exp", 20000);

  set("chat_chance", 6);
  set("chat_msg", ({
    "倭寇举着明晃晃的倭刀大叫道：去死吧!\n",
    "倭寇象野兽般地嚎了一声,冲了过来。\n",
  }));

  set("force", 700);
  set("max_force", 700);
  set("force_factor", 5);

  set_skill("dodge", 70);
  set_skill("sword", 70);
  set_skill("parry", 70);
  set_skill("force", 70);
  set_skill("unarmed", 65);

  setup();
  add_money("coin", 10);

  carry_object(__DIR__ "obj/sword")->wield();
}
