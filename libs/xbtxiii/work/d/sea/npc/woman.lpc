#pragma save_binary
// oldsailor.c
#include <ansi.h>
inherit NPC;

void do_agree(string);
mixed ask_me(mixed arg)
{
     object me,obj,*obb;
     int s;
     me=this_player();
     obb=all_inventory(me);
     s=sizeof(obb);
     while(s--){
           if(obb[s]->query("id")=="seamap")
            {
	      tell_object(me,"渔家大婶看了你一眼说:你已经有了海图,怎么还来找我? \n");
	      return 1;
            }
     }
     add_action("do_agree","agree");
     tell_object(me,"渔家大婶轻声说道:要海图?你得答应帮我找到我儿子. \n");
     tell_room(environment(me),"渔家大婶轻声的告诉"+me->query("name")+"些什么.\n,me ");
     return ("好吗?(agree) \n");
}

int do_agree(string arg)
{
object me,*ob,bk;
int i,money;
me=this_player();
bk=new("/d/sea/npc/obj/seamap");
tell_object(me,"这是我丈夫留下的海图,交给你吧,不过一定记得帮我找阿牛呀! \n");
tell_object(me,"你双手接过海图,用力点了点头. \n");
tell_room(environment(me),"渔家大婶将一样东西交给"+me->query("name")+". \n",me);
bk->move(me);
return 1;
}

void create()
{
	set_name("渔家大婶", ({ "woman" }) );
	set("gender", "女性");
	set("age", 54);
	set("long", @LONG
她是一个普通的渔家妇女,手里正拿着一个梭子在编织渔网,她不时抬起头
看看远方的海面,目光中流露出焦急的神色.她的丈夫去年刚刚死在倭寇的手里,
现在她和儿子阿牛相依为命.
LONG);
	set("attitude", "peaceful");

	set("str", 26);
	set("int", 24);

	set("combat_exp", 100000);
	
	set("chat_chance", 10);
	set("chat_msg",({
		"渔家大婶叹了口气,焦虑地说:怎么还没回来,真急死人了.唉。\n",
	}) );
	
	set("inquiry", ([
		"阿牛" : "他是我儿子,两天前出海后就一直没有回来,也不知...。\n",
		"海图" : (: ask_me :),
	]) );
	
	set("force", 600);
	set("max_force", 600);
	set("force_factor", 5);
	
	set_skill("unarmed", 60);
	set_skill("parry", 60);
	set_skill("dodge", 50);

	setup();
        
        carry_object("/d/snow/obj/cloth")->wear();

}
