#pragma save_binary
// oldsailor.c

#include <ansi.h>
inherit NPC;

void create() {
  set_name("李四", ({ "lisi" }));
  set("gender", "男性");
  set("age", 34);
  set("long", @LONG
他是一个干瘦的中年人,脸上阴沉沉的,两只眼睛木然地看着前方,看他的表情
怪怪的,似乎充满了神秘的色彩.他的手里也拿着一个大葫芦,但颜色是绿色的,
不时拿起起来喝上一口,又小心地盖上盖子.
LONG);
  set("attitude", "peaceful");

  set("str", 26);
  set("int", 24);

  set("combat_exp", 900000);


  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 20);

  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);

  setup();

  carry_object("/d/snow/obj/cloth")->wear();

}
