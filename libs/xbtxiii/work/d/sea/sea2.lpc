#pragma save_binary
// Room: /d/oldpine/pine1.c

inherit ROOM;

void create()
{
        set("short", "大海");
        set("long",
"远离了海岸,你已到了海中央,辽阔的大海上,风平浪静,晴空万里,\n"
"碧海无边,阳光直射在海面上,迸射出千万点碎金似的耀眼的闪光,\n"
"在海面上闪烁跳跃,照得你眼花缭乱.这儿离海岸已经远了,海边\n"
"的渔村早在视野中消失了.海浪的晃动已经使你头昏眼花,胃也一\n"
"阵阵的抽搐.\n"
);
        set("exits",([
             "west" : __DIR__"sea1",
             "east" : __DIR__"sea3",
]));
        set("outdoors", "oldpine");

        // Because setup() calls reset(), so we don't need initialize
        // our exits here.
        setup();
}

