// Room: /d/sea/cysea1.c

inherit ROOM;

void create() {
  set("short", "海面");
  set("long", @LONG
这里是一望无际的的大海,四处都是蔚兰色的海水,水天一色,但你无暇
看这景致,你的心里有点慌张,到底向哪儿走才对呢.你朝四面看看,但看来
并没有任何收获.
LONG
  );
  set("outdoors", "oldpine");

  // Because setup() calls reset(), so we don't need initialize
  // our exits here.
  setup();
}

void reset() {
  ::reset();
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "outsea1",
    "north": __DIR__ "fireland",
    "west": __DIR__ "fireland",
    "east": __DIR__ "fireland",
  ]));
}

int valid_leave(object me, string dir) {
  write("你实在弄不清楚方向....");
  switch (dir) {
    case "north": write("北边....北边是哪里呢？...."); break;
    case "east": write("东边....东边...."); break;
    case "south": write("南边....哪里是南边？...."); break;
    case "west": write("西边....嗯...."); break;
    default:
      write("该往哪里走呢....");
  }
  write("就是这个方向吧。\n");
  return 1;
}
