// Room: /d/sea/cysea1.c

inherit ROOM;

void create()
{
        set("short", "桃花丛");
        set("long", @LONG
满眼除了桃花还是桃花,尽管桃花依旧笑春风,但现在的你哪里有这闲情逸致
停下脚步来看看瞧瞧,乱花渐欲迷人眼,你好象真的被迷花了眼,怎样走出去?
你越来越紧张,到底往哪儿走才对呢?你朝四面看看.但除了满目的花叶招展外
还有一个小小的木桩,上面写着:桃花阵!!!
LONG
        );

        setup();
}

void reset()
{
        ::reset();
        set("exits", ([ /* sizeof() == 4 */
          "south" : __DIR__"thzhen2",
          "north" : __DIR__"thzhen2",
          "west" : __DIR__"thzhen2",
          "east" : __DIR__"thout1",
        ]));
}

int valid_leave(object me, string dir)
{
        write("你实在弄不清楚方向....");
        switch(dir) {
                case "north":   write("北边....北边是哪里呢？....");    break;
                case "east":    write("东边....东边....");      break;
                case "south":   write("南边....哪里是南边？....");      break;
                case "west":    write("西边....嗯....");        break;
                default:
                        write("该往哪里走呢....");
        }
        write("就是这个方向吧。\n");
        return 1;
}
