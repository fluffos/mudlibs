// Room: /d/sea/xkland
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "桃花岛");
  set("long", @LONG
远远看去是一片青绿和嫣红,而到了跟前终于看清楚了,青的是满岛的
叶,红的竟是满树满树的桃花!这当然就是以桃花闻名的桃花岛了.传说
这里原本是一座荒凉的小岛,在二百年前,武林中一个旷世高手因为为
情所累,伤感之下,心灰意冷,遂隐居于这里,他在岛上栽满了各种桃树,
将所有精力放在照顾桃花身上,每当春天到来时这里,岛上到处是桃花争艳
一派生机,后来人们就称这为桃花岛.现在岛上谁住的,没人知道,但附近的
渔民常常在月圆的夜里听到岛上传来悠扬却令人黯然的笛声,那些想探探
真情的人都再也没回来.你想去看看吗?
LONG
  );
  set("outdoors", "sea");
  set("exits", ([
    "west": __DIR__ "xkland",
  ]));
  // Because setup() calls reset(), so we don't need initialize
  // our exits here.
  setup();
}

int init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  object me;
  me = this_player();
  if (arg != "cliff") {
    tell_object(me, "你要爬什么? \n");
    return 1;
  }
  if (((int)me->query("gin") < 60) || ((int)me->query("sen") < 60) || ((int)me->query("kee") < 60)) {
    tell_object(me, "算了吧,你没体还要爬? \n");
    return 1;
  }
  tell_object(me, "你双手攀住山岩,费尽九牛二虎之力往上爬去. \n");
  tell_room(environment(me), me->query("name") + "笨手笨脚地往上爬去,看上去很危险! \n", me);
  tell_object(me, "终于到了悬崖顶上.\n");
  if ((int)me->query_skill("dodge", 1) < 50) {
    tell_object(me, "你向山崖下看了看,哇!不好!你只感觉脚下一滑.... \n");
    message_vision("..........呀..............................\n", me);
    message_vision(".................呀.......................\n", me);
    message_vision(".......................呀.................\n", me);
    message_vision("..............................呀..........\n", me);
    message_vision("...................................呀哈哈.\n", me);
    tell_object(me, "崩!!你重重地摔在地上,只感到屁股象裂成了几瓣.哈哈哈.\n");
    message_vision("突然天上象有什么掉了下来,咣!只见$N掉在地上...\n", me);
    me->add("sen", -50);
    me->add("kee", -50);
    me->add("gin", -50);
    return 1;
  }
  me->move("/d/sea/yading");
  return 1;
}
