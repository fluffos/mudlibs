#pragma save_binary
// Room: /d/sea/pine1.c

inherit ROOM;

void create() {
  set("coor", ({ 300, -900, 0 }));
  set("short", "松树林");
  set("long",
    "你现在正站在一个树林里，嗯....这是一个海边常见的松树林.\n"
    "松林里有一条弯弯曲曲的小路从西北延伸而上,你很想知道它通\n"
    "向哪儿...茂密的松树遮蔽了整个天空，使你连方向都弄不清楚，\n"
    "最好能在天黑之前赶紧找道路径出去吧。\n"
  );
  set("outdoors", "sea");
  set("exits", ([
    "northwest": __DIR__ "woods2",
    "east": __DIR__ "road2",
  ]));
  // Because setup() calls reset(), so we don't need initialize
  // our exits here.
  setup();
}
