#pragma save_binary
// Room: /d/sea/seaside.c
inherit ROOM;

void create()
{
        set("short", "出海口");
        set("long",
"眼前豁然一亮,出现在你眼前的是一望无际的大海,海浪扑打在岸\n"
"边的礁石上,溅起丈高的水花,将你的全身溅地湿漉漉的.远处那\n"
"是什么!?你揉揉眼睛,没错,那是一艘大海船(ship)!哇!!你高兴\n"
"地叫了一声.还等什么!快上船呀!\n"
);
        set("item_desc", ([
           "ship" :
           "一艘相当大的海船,或许只有它能抵御海上的风浪!(getup) \n",
           ]));  
        set("outdoors", "sea");
        set("exits",([
             "west" :__DIR__"andao4",
    //         "east" :__DIR__"sea1", 
]));
        // Because setup() calls reset(), so we don't need initialize
        // our exits here.
        setup();
}

int init()
{
 add_action("do_getup","getup");
}

int do_getup(string arg)
{
 if(!arg || arg=="")
   message_vision("你要干什么? \n",this_player());
 if (arg!="ship")
   message_vision("上什么? \n",this_player());
message_vision("$N费力地爬上海船,终于到了海面上. \n",this_player());
this_player()->move(__DIR__"sea1");
return 1;
}
