#pragma save_binary
// Room: /d/sea/xkland

inherit ROOM;

void create()
{
        set("short", "侠客岛前的海面");
        set("long",
"你已经又累又乏,加上一路上的狂风暴雨又使你不知喝了多少海\n"
"水你简直就要崩溃了,就在这时候,你看到前面不院处出现一个青\n"
"绿的小岛,这一下你临死的鱼见到水一般,一下子充满了活力.加\n"
"油!前面就是侠客岛了!\n"
);
        set("outdoors", "sea");
        set("exits",([
             "west" :__DIR__"outsea6",
             "east" :__DIR__"xkdao", 
]));
        // Because setup() calls reset(), so we don't need initialize
        // our exits here.
        setup();
}

