#pragma save_binary
// Room: /d/snow/yuchun.c

inherit ROOM;

void create()
{
        set("coor",({325,-950,0}));
	set("short", "小渔村");
        set("long",
"东海之滨的一个小渔村,虽然现在看上去已经破败不堪,但从残存\n"
"的断壁和林立的碑牌可以依稀想见当年的繁华.渔村里静悄悄的,\n"
"偶尔有一只癞皮狗追逐着野猫从你的面前飞奔而过,南面隐约传\n"
"来一两声的吆喝,北边则是一条用白色石条铺就的小路.路边晒着\n"
"新旧不一的渔网.\n"
);
        set("exits", ([ /* sizeof() == 2 */
  "east" : "/d/sea/seaside",
  "west" : "/d/sea/eroad5",
  "north" : "/d/sea/road1",
  "south" : "/d/sea/jiulou",
]));
        set("outdoors", "snow");

        setup();
        replace_program(ROOM);
}
