#pragma save_binary
// Room: /d/sea/seaside.c

inherit ROOM;

void create()
{
        set("coor",({375,-950,0}));
	set("short", "海滩");
        set("long",
"眼前是一片银色的沙滩,耳畔,海风轻轻地吹拂....天空是那样地\n"
"空气是那样地清新,你的胸襟也一下子变的开阔.海浪舔着海滩,\n"
"远处海鸥在欢快地歌唱!但是,海面上却看不到一叶帆影,只有几\n"
"艘残破的木船横在沙滩上.\n"
);
        set("outdoors", "sea");
        set("exits",([
             "west" :__DIR__"yuchun",
]));
        // Because setup() calls reset(), so we don't need initialize
        // our exits here.
        setup();
}

