#pragma save_binary
inherit ROOM;

void create() {
  set("coor", ({ 250, -850, -5 }));
  set("short", "暗道");
  set("long",
    "这里黑黑暗暗，几乎伸手不见五指。唯一的光亮来自墙上忽明忽\n"
    "暗的松油灯。迎面吹来的风在你耳边呜呜直响,你感到一阵紧张,\n"
    "是回头还是继续向前呢?\n"
  );
  set("exits", ([ /* sizeof() == 1 */
    "up": __DIR__ "mazhumiao",
  ]));
  set("objects", ([
    __DIR__ "npc/oldwizard": 1,
  ]));
  setup();
  replace_program(ROOM);
}
