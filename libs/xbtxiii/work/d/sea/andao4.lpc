#pragma save_binary
inherit ROOM;

void create() {
  set("short", "暗道");
  set("long",
    "这里是暗道的尽头，前面拐弯处,阳光透了进来,涛声越来越响,\n"
    "一阵水气扑打在脸上,你甚至听到了海鸥响亮的叫声,快走吧!去\n"
    "看看那乱石崩云,惊涛拍岸的景象吧!\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "port",
    "west": __DIR__ "andao3",
  ]));

  setup();
  replace_program(ROOM);
}
