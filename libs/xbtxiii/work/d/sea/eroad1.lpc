inherit ROOM;

void create() {
  set("coor", ({ 75, -950, 0 }));
  set("short", "荒凉驿道");
  set("long",
    "这是一条宽阔的驿道，路面上深深的车辙印表明这里曾经多么繁\n"
    "忙,但现在路的两边早已长满了荒草.路继续向东面延伸,仿佛没\n"
    "有尽头,不知道通向何处.往西则是通往扬州.路边立这一个牌子(\n"
    "sign)。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": "/d/sea/eroad2",
    "west": "/d/yangzhou/trace2",
  ]));
  set("outdoors", "snow");
  set("item_desc", ([
    "sign": "朝廷有令:
       因近年海上倭寇猖獗,为保本朝平安,任何人不得私自出海!
       民间收藏罗盘,海图等一律上交,如有违者,定严惩不殆!
",
  ]));
  set("objects", ([
    __DIR__ "npc/guard": 8
  ]));

  setup();
}
