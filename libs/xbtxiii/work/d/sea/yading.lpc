#pragma save_binary
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "悬崖顶上");
  set("long",
    "这里空荡荡的,大约有十丈见方,崖顶的泥土可能因为风吹日晒的\n"
    "缘故显得相当平整,这里的风相当大,每走一步都地相当小心,搞\n"
    "不好就会给吹下崖去,崖边坚强地生长着几棵榕树,看上去树皮却\n"
    "现得相当光滑.\n"
  );
  setup();
}

int init() {
  add_action("do_push", "push");
  add_action("do_climb", "climb");
}

int do_push(string arg) {
  object me;
  me = this_player();
  if (arg != "tree") {
    tell_object(me, "你要推什么?\n");
    return 1;
  }
  tell_object(me, "你用力推这大石头,头上冒出点点汗珠. \n");
  tell_object(me, "轰地一声!崖顶裂开一个大缝,你奋力艰难地挤了进去. \n");
  tell_room(environment(me), me->query("name") + "突然不见了! \n", me);
  me->move("/d/sea/mishi1");
  return 1;
}

int do_climb(string arg) {
  object me;
  me = this_player();
  if (arg != "down") {
    tell_object(me, "你要往哪儿爬? \n");
    return 1;
  }
  tell_object(me, "你费力而小心翼翼地爬下悬崖. \n");
  me->move("/d/sea/xkdao");
  return 1;
}
