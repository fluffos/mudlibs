#pragma save_binary
inherit ROOM;

void create() {
  set("short", "密室");
  set("long",
    "这里黑黑暗暗，几乎伸手不见五指。唯一的光亮来自墙上忽明忽\n"
    "暗的松油灯。墙上有一副石刻书法.迎面吹来的风在你耳边呜呜\n"
    "直响,你感到一阵紧张.\n"
  );
  set("objects", ([
    __DIR__ "npc/zhangsan": 1,
    __DIR__ "npc/lisi": 1,
  ]));
  set("exits", ([
    "west": __DIR__ "xkdao",
  ]));
  setup();
}
