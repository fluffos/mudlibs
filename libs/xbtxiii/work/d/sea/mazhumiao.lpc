#pragma save_binary
// Room: /d/sea/mazhumiao.c
#include <ansi.h>
#include <room.h>

inherit ROOM;
void create() {
  set("coor", ({ 250, -850, 0 }));
  set("short", "妈祖庙");
  set("long",
    "这是一座海边常见的妈祖庙,因为渔家人虔诚地相信海神妈祖能\n"
    "保佑他们出海平安,并给他们带来好的收获,所以尽管这些年来这\n"
    "里的生活已经由于战乱和倭寇的侵扰而艰辛了许多,但他们还是\n"
    "尽力献上最好的祭品.庙里的陈设很简单,除了供桌,签筒(qianto\n"
    "ng)外就没有其他东西了.但是,你的目光忍不住落在妈祖神像(sh\n"
    "enxiang)上.\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "southeast": "/d/sea/woods2",
  ]));
  set("item_desc", ([
    "qiantong": "这是一个渔民们用来占卜凶吉的签筒,你也可以试试看(qiuqian). \n",
    "shenxiang": "妈祖慈眉善目,她祥和地看着你,你不禁有跪下磕头的冲动.(ketou). \n",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_qiuqian", "qiuqian");
  add_action("do_ketou", "ketou");
}

int do_qiuqian() {
  object me;
  object obj, *iv;
  int s;
  me = this_player();
  iv = all_inventory(me);
  s = sizeof(iv);
  while (s--) {
    if ((iv[s]->query("id") == "qian1") || (iv[s]->query("id") == "qian2")) {
      tell_object(me, "你有了签牌还瞎摇什么? \n");
      return 1;
    }
  }
  message_vision("$N拿起签筒拼命地摇呀摇...嘣!终于跳出一支签来.$N将签牌捡了起来. \n", this_player());
  switch (random(5)) {
    case 0:
      obj = new("/d/sea/npc/obj/qian1");
      obj->move(me);
      break;
    case 1:
      obj = new("/d/sea/npc/obj/qian2");
      obj->move(me);
      break;
    case 2:
      obj = new("/d/sea/npc/obj/qian3");
      obj->move(me);
      break;
    case 3:
      obj = new("/d/sea/npc/obj/qian4");
      obj->move(me);
      break;
    case 4:
      obj = new("/d/sea/npc/obj/qian5");
      obj->move(me);
      break;
  }
  return 1;
}


void check_trigger() {
  object room;
  if ((int)query("trigger") == 3 && !query("exits/down")) {
    message("vision", "吱呀一声,地上出现了一个暗门,里面有向下的台阶,下面有什么? \n", this_object());
    set("exits/down", __DIR__ "anshi");
    if (room = find_object(__DIR__ "anshi")) {
      message("vision", "吱呀一声,头顶开了个门!亮光照了进来. \n", room);
      room->set("exits/up", __DIR__ "mazhumiao");
    }
    delete("trigger");
    call_out("close_passage", 5);
  }
}

void close_passage() {
  object room;
  if (!query("exits/down")) return;
  message("vision", "吱呀一声,暗门又关上了. \n", this_object());
  delete("exits/down");
}

int do_ketou() {
  object me;
  add("trigger", 1);
  message_vision("$N恭恭敬敬地跪了下来,磕了一个响亮的头.咚!头上起了个大包! \n", this_player());
  check_trigger();
  return 1;
}
