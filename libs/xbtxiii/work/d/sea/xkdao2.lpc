#pragma save_binary
// Room: /d/sea/xkland
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "侠客岛");
  set("long",
    "你终于踏上了向往已久的这个充满神秘和传奇色彩的小岛了,但\n"
    "现在你既没有心思追思当年大虾们在这儿的传说,也没有心情细\n"
    "细品味岛上的鸟语花香,也许是经过了多日的海上颠簸,你现在只\n"
    "觉得头晕目炫,摇摇晃晃看来你是晕岸了.侠客岛是一个不太大的\n"
    "小岛,但在这一带它可是除北面桃花岛外最大的小岛了.几百年前,\n"
    "有无数的武林高手应侠客岛岛主的要求上岛同研武学,所以武林\n"
    "中一直传说着这儿有许多的宝藏和武功秘籍.不过,这些都只是传\n"
    "说,即使是真的恐怕也要经过一番努力加上好运气了.在你面前的\n"
    "是一壁怪石嶙峋的山崖,你抬头看看，只感到一阵头晕目眩,看来\n"
    "要想上去是要有一身好轻功了.\n"
  );
  set("outdoors", "sea");
  set("exits", ([
    "west": __DIR__ "xkland",
  ]));
  // Because setup() calls reset(), so we don't need initialize
  // our exits here.
  setup();
}

int init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  object me;
  me = this_player();
  if (arg != "cliff") {
    tell_object(me, "你要爬什么? \n");
    return 1;
  }
  tell_object(me, "你双手攀住山岩,费尽九牛二虎之力往上爬去. \n");
  message_vision("$N笨手笨脚地向上爬去,身影渐渐变地越来越小. \n");
  // if((int)me->query("dodge",1)<50){
  tell_object(me, "你向山崖下看了看,哇!不好!你只感觉脚下一滑.... \n");
  // message_vision("呀........................................\n",me);
  // message_vision("....呀....................................\n",me);
  message_vision("..........呀..............................\n", me);
  message_vision(".................呀.......................\n", me);
  message_vision(".......................呀.................\n", me);
  message_vision("..............................呀..........\n", me);
  message_vision("...................................呀哈哈.\n", me);
  // tell_object(me,"崩!!你重重地摔在地上,只感到屁股象裂成了几瓣.哈哈哈.\n");
  message_vision("突然天上象有什么掉了下来,咣!只见$N掉在地上...\n", me);
  me->add("sen", -50);
  me->add("kee", -50);
  me->add("gin", -50);
  // return 1;
  //}
  me->move("/d/sea/andao1");
  return 1;
}
