#pragma save_binary
// Room: /d/oldpine/pine1.c

inherit ROOM;

void create() {
  set("short", "大海");
  set("long",
    "你终于来到了大海上,辽阔的大海上,风平浪静,晴空完里,碧海无\n"
    "边,强烈的阳光直射在海面上,迸射出千万点碎金似的耀眼的闪光,\n"
    "在海面上闪烁跳跃,照得你眼花缭乱.这儿离海岸已经有一段距离\n"
    "了,但还是可以看到海边的点点树影.别大意,前面的路还长着呢!\n"
  );
  set("exits", ([
    "west": __DIR__ "seaside",
    "east": __DIR__ "sea2",
  ]));
  set("outdoors", "oldpine");

  // Because setup() calls reset(), so we don't need initialize
  // our exits here.
  setup();
}
