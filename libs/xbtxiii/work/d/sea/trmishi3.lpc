#pragma save_binary
inherit ROOM;

void create() {
  set("short", "密室");
  set("long",
    "这里黑黑暗暗，几乎伸手不见五指。唯一的光亮来自墙上忽明忽\n"
    "暗的松油灯。你运足了目力向四周围看了看,发现正面的墙上有\n"
    "一副石刻书法,你可以(see).而其它三面都是大石砌成的石墙迎\n"
    "面吹来的风在你耳边呜呜直响,你感到一阵紧张..\n"
  );
  set("exits", ([
    "north": __DIR__ "trmishi2",
    "south": __DIR__ "trmishi4",
  ]));
  setup();
}


void init() {
  add_action("do_look", "see");
}

int do_look() {
  object xkx;
  object me;
  int my_for;
  me = this_player();
  if (((int)me->query("int") > 25) && ((int)me->query_skill(
    "literate",
    1
  ) < 1) && ((int)me->query_skill(
    "unarmed",
    1
  ) < 150) && ((int)me->query_skill("unarmed", 1) > 80)) {
    if ((int)me->query("sen") < 35) {
      tell_object(me, "你太累了! 休息休息吧! \n");
      return 1;
    }
    my_for = (int)me->query_skill("unarmed", 1);
    if (((my_for * my_for * my_for) / 10) > (int)me->query("combat_exp")) {
      tell_object(me, "也许是缺乏实战经验，你对石壁上的东西总是无法领会。\n",);
      return 1;
    }


    tell_object(me, "你觉得壁上的文字竟隐隐与徒手功夫技巧相应,你立刻精心研读一番.
                   你对徒手功夫有所心得.\n");
    me->improve_skill(
      "unarmed",
      (int)me->query_skill("unarmed", 1) + random((int)me->query_skill("unarmed", 1))
    );
    me->add("sen", -20);
    return 1;
  }

  else {
    tell_object(me, "十步杀一人,千里不留行. \n");
    return 1;
  }

}
