#pragma save_binary
// Room: /d/village/farmhouse1.c
#include <room.h>
inherit ROOM;

void create()
{
	set("coor",({300,-925,0}));
	set("short", "渔家小院");
	set("long",
"海滨的一户普通渔家,房屋虽然以有年头了,但却收拾得井井有条\n"
"干干净净,这的女主人一定相当勤劳能干,和别的渔家一样,院子\n"
"里晒着一些小鱼干,安静而详和的氛围让你感觉象回到了家.\n"
);
	set("objects", ([
            __DIR__"npc/woman" : 1,
 ]));
	set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"road1",
]));
       create_door("east","木柴门","west",DOOR_CLOSED);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
