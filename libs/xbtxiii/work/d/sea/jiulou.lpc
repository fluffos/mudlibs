#pragma save_binary
// jiulou.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
        set("coor",({325,-975,0}));
	set("short", "望海楼");
        set("long",
"你走到了一家酒楼里。四周的装饰早就褪色脱落了，但仅仅从名\n"
"字你已可想象昔日的辉煌,然而一切都有如过眼云烟,你不禁哀叹\n"
"世事的多变,这里的小二也无精打采,见你进来他连眼皮都没抬一\n"
"下,只是无力的挥了挥手.\n"
);

        set("exits", ([
                "north":	__DIR__"yuchun",
//		"up":		__DIR__"jiulou_2",
		]) );

        set("objects", ([
                __DIR__"npc/oldsailor" : 	1,
//		__DIR__"npc/boss":	1,
		]) );
        setup();
}


