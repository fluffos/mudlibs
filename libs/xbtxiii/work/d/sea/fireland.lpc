#pragma save_binary
// Room: /d/sea/seaside.c

inherit ROOM;

void create() {
  set("short", "火烧屿");
  set("long",
    "前面不远处出现一个小黑点,你心中一阵狂喜,那就是传说中的侠\n"
    "客岛?!可是当船驶近一看,你却大失所望.这只是一个小小的岛屿\n"
    "上面什么也没有,除了满岛的沙石杂草外.可能是因为岛上的沙石\n"
    "色泽暗红的缘故,临海的石崖上写着三个斗大字火烧屿.\n"
  );
  set("outdoors", "sea");
  set("exits", ([
    "west": __DIR__ "cysea2",
    "south": __DIR__ "cysea1",
    "east": __DIR__ "cysea2",
    "north": __DIR__ "sea3",
  ]));
  // Because setup() calls reset(), so we don't need initialize
  // our exits here.
  setup();
}
