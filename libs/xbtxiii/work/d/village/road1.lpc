inherit ROOM;

void create() {
  set("coor", ({ -300, 4050, 0 }));
  set("short", "黄土大道");
  set("long",
    "这条黄土大道很宽阔，足够供八架马车并驾齐驱，与异族交战时，\n"
    "大量军队从此经过，和平时期只有商人来来往往。这条大道向南\n"
    "通往京师，往北到天驼关。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "road2",
    "north": "/d/canyon/canyon7",
  ]));

  set("outdoors", "village");
  setup();
  replace_program(ROOM);
}
