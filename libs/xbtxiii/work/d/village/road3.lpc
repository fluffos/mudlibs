#pragma save_binary
// Room: /d/village/road3.c

inherit ROOM;

void create() {
  set("coor", ({ -350, 4000, 0 }));
  set("short", "青石小路");
  set("long",
    "这是一条通向一个村庄的青石小路。路口立着一个小牌子(table\n"
    "t)，牌子看起来经过长时间的日晒雨淋，已破烂不堪。东南向望\n"
    "去好像是片瓜地，绿油油的西瓜让你感觉更渴了。从这里往西就\n"
    "进了村子，向东到三叉路口。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "road4",
    "east": __DIR__ "road2",
  ]));
  set("outdoors", "city");
  set("item_desc", ([
    "tablet": "你勉强分辨出那上面模糊的字迹：傅家坡\n"
  ]));
  setup();
}
