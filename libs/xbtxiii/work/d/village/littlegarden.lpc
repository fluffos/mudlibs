#pragma save_binary
inherit ROOM;
#include <room.h>

void create()
{
        set("coor",({-450,4150,0}));
	set("short", "花园");
        set("long",
"这是刘老汉的小花园。花园里有很多美丽的花朵。刘老汉就是靠\n"
"卖花来维持生计的。现在正是花开的大好季节，有很多人在剪花。\n"
);
        set("exits", ([ /* sizeof() == 1 */
        "south" : __DIR__"road5",
	"north" : __DIR__"home",
        ]));
        create_door("north", "木门", "south", DOOR_CLOSED);
	
	set("objects", ([
        __DIR__"npc/flowergirl" : 2,
        ]) );
        set("outdoors", "village");
        setup();
}
                
