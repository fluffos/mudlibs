#pragma save_binary
// wdroad2.c
// by Xiang

inherit ROOM;

void create() {
  set("short", "青石大道");
  set("long",
    "你走在一条青石大道上，南边隐约可见到扬州城的城墙。北面一\n"
    "条土路通向山里。\n"
  );
  set("outdoors", "wudang");

  set("exits", ([
    "south": __DIR__ "hsroad1",
    "north": "/d/shaolin/yidao",
    "northwest": __DIR__ "hsroad3",
  ]));

  setup();
  replace_program(ROOM);
}
