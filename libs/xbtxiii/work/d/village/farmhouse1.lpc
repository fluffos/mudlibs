#pragma save_binary
// Room: /d/village/farmhouse1.c

inherit ROOM;

void create() {
  set("short", "农舍");
  set("long",
    "这间农舍内的摆设非常朴素，但十分井井有条。阳光顺着窗缝撒\n"
    "在屋角落里的纺车上，桌上摆着泥作的玩具，特别是那泥老虎捏\n"
    "的形态生动活泼，色彩逼真，旁边还摆着一把木刀，可能都是父\n"
    "亲作给小孩的玩具。一张大床的旁边还有一张小床。这屋的北面\n"
    "是农舍的后院，南边出了屋就是村里的青石小路。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "fmhousback.lpc",
    "south": __DIR__ "road4",
  ]));
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
