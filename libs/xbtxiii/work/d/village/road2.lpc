inherit ROOM;

void create() {
  set("coor", ({ -300, 4000, 0 }));
  set("short", "三叉路口");
  set("long",
    "这里已经离天驼关很远了，顺着黄土大道向南走，绿色渐渐多了\n"
    "起来，树木透着喜人的绿，放眼望去青山绿水，好一派关内景色，\n"
    "你能看到散落的房屋，农田和水塘。来往的旅客、商人、农民也\n"
    "多了。黄土大道向东南方向延伸，西面是进入一个村庄的小路。\n"
  );
  set("exits", ([ /* sizeof() == 3 */
    "southeast": "/d/city/nroad5",
    "north": __DIR__ "road1",
    "west": __DIR__ "road3",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/trader1": 1,
  ]));
  set("outdoors", "village");

  setup();
  replace_program(ROOM);
}
