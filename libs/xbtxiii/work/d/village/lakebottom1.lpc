inherit ROOM;

void create() {
  set("coor", ({ -600, 3950, -50 }));
  set("short", "水下岩洞");
  set("long",
    "这个岩洞中全都是冰，冰的色泽纯正洁白，很象是北极的玄冰，\n"
    "却不知怎么会在这里出现。四周气温极低，阵阵寒冷袭来，常人\n"
    "难以站立片刻。在玄冰上面长着发光的藻类植物，所以从入口看\n"
    "去非常明亮。刚才进入岩洞的入口处又迅速地结了一层薄冰，奇\n"
    "怪的是水压并没有把它压破。\n"
  );
  set("exits", ([ /* sizeof() == 1 */
    "westup": __DIR__ "lakebottom2",
  ]));

  setup();
}
