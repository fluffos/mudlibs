#pragma save_binary
// dragon.c

inherit NPC;

void create() {
  set_name("白鳞冰龙", ({ "icedragon", "dragon" }));
  set("long",
    "一只浑身长满白鳞的龙，\n");

  set("race", "野兽");
  set("gender", "雄性");
  set("age", 600);
  set("attitude", "aggressive");

  set("max_gin", 1300);
  set("max_kee", 2000);
  set("max_sen", 800);

  set_weight(65000);
  set("limbs", ({ "头部", "身体", "前爪", "後爪", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set_temp("apply/attack", 100);
  set_temp("apply/dodge", 120);
  set_temp("apply/armor", 50);
  set_temp("apply/damage", 40);
  set_temp("apply/armor_vs_fire", -40);

  set("combat_exp", 1500000);
  setup();
  add_money("gold", 3);


}
void die() {
  object players;
  players = query_temp("last_damage_from");
  if (objectp(players))
    players->add("fealty", 50);
  ::die();
}
