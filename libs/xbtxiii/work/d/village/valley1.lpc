// Room: /d/village/valley1.c

inherit ROOM;

void create() {
  set("coor", ({ -620, 3950, 0 }));
  set("short", "忘情谷外");
  set("long",
    "这里是忘情谷外的一条小路，向着南和北延伸。山岭上树木繁茂，\n"
    "绿草茵茵，东面是有名的玉螺湖，湖上水汽蒸腾，但这边岸上没\n"
    "有船，不能由此到湖上。隐隐约约地看的见错落有致的村庄农舍。\n"
    "西北是黑松山。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "valley2",
    "northwest": "d/chuenyu/sunnyroad",
  ]));
  set("outdoors", "village");

  setup();
  replace_program(ROOM);
}
