// transfer.c

#include <ansi.h>

inherit SSERVER;

int exert(object me, object target)
{
        int force;

        if( !target || target==me || !living(target) )
                return notify_fail("你要将真气传给谁？\n");

        if( (string)me->query_skill_mapped("force") != 
target->query_skill_mapped("force") )
                return notify_fail(target->name() + 
 "所使用的内功和你不同。\n");
        if((int)me->query("max_force")<=(int)target->query("max_force"))
                  return notify_fail(target->name() + 
 "的内力比你还强，你无法给他传功。\n");
/*
        if( (int)me->query("force") <= (int)me->query("max_force") )
                 return notify_fail("你的真气不足。\n");    
*/
        force = random(5);
        me->start_busy((force)*3);
        target->start_busy((force)*3);  
/*        me->add("max_force", -force );
        message_vision("$N将手掌贴在$n背心，运气将体内真气传送过去。\n", me,

target);
        target->add("max_force", force);
        write("Ok.\n");
        tell_object(target, HIY "你觉得一股热气从" + me->name() + 
 "的手掌传了过来。你的内力增加了!\n" NOR);
*/
        message_vision("$N坐下运功，决定将内力传给$n。\n", me, target);
      call_out("trans",force*3,me,target,force);
        return 1;
}
 
void trans(object me,object ob,int force)
{
        me->add("max_force", -force );
        message_vision("$N将手掌贴在$n背心，运气将体内真气传送过去。\n", me,ob);
        ob->add("max_force", force);
        tell_object(ob, HIY "你觉得一股热气从" + me->name() + 
 "的手掌传了过来。你的内力增加了!\n" NOR);
        return;
}
