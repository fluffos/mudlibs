inherit ROOM;

void create()
{
        set("short", "天山顶峰");
        set("long",
"这里是天山顶峰。从这里向周围望去，帕米尔高原的风光尽收眼\n"
"底。东面一条小路可以下山。\n"
);
        set("exits", ([
            "eastdown" : __DIR__"tianroad5",
        ]));
        set("objects", ([
               __DIR__"npc/snake" : 2, 
        ]));

        set("no_clean_up", 0);
        set("outdoors", "xingxiuhai");

        setup();
        replace_program(ROOM);
}

