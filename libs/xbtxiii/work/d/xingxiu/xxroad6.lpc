#pragma save_binary
// Room: /d/xingxiu/xxroad6.c

inherit ROOM;

void create()
{
        set("coor",({-3650,1320,250}));
	set("short", "山间平地");
        set("long",
"山间平地，地上是嫩绿的小草，周围布了几棵桦树，山边有一眼\n"
"清泉。\n"
);

        set("resource/water", 1);
        set("objects", ([
                __DIR__"npc/obj/yangrou.lpc" : 3]));


        set("exits", ([
  "south" : __DIR__"xxroad5",
]));

        set("no_clean_up", 0);
        set("outdoors", "xingxiuhai");

        setup();
}
void init()
{
    if(this_player())
        this_player()->set_explore("north#43");
}
