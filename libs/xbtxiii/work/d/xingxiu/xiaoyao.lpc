// Xiaoyao.c:  the sleeping room for Xingxiu
// Jay May 13, 96

inherit ROOM;

void create() {
  set("coor", ({ -3760, 1450, 100 }));
  set("short", "逍遥洞");
  set("long",
    "这是一个粗糙的石洞，里面铺了几张臭哄哄的草垫子。垫子旁边\n"
    "是一些破酒罐子。洞壁(wall)上有些字迹。\n"
  );

  add_light(this_object(), 1);
  set("sleep_room", "1");
  set("no_fight", "1");

  set("exits", ([
    "out": __DIR__ "xxh6",
  ]));

  set("item_desc", ([
    "wall": "星宿淫贼人人得而株之！\n",
  ]));
  setup();
}
