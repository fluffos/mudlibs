#pragma save_binary
// /d/xingxiu/house1.c
// Jay 3/26/96

inherit ROOM;

void create()
{
        set("coor",({-3030,1250,0}));
	set("short", "巴依家客厅");
        set("long",
"这是巴依家的客厅。地上铺着波斯地毯，木架上摆这中原的瓷器。\n"
"看得出这家的主人一定很有钱。\n"
);
        set("exits", ([ 
        "west" : __DIR__"house",
]));
        set("objects", ([
                "/d/secret/secret1/npc/afanti": 1 ]) );
        set("no_clean_up", 0);
        set("outdoors", "xingxiuhai");

        setup();
        replace_program(ROOM);
}


