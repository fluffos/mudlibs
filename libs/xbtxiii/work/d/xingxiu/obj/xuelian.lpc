#pragma save_binary
// medicine: xuelian.c
// Jay 3/18/96

inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name("天山雪莲", ({"xuelian", "lian", "lotus"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "支");
                set("long", "这是一支只有在寒冷的地方才能生长的雪莲。\n");
                set("value", 100);
        }
        setup();
}

int do_eat(string arg)
{
        object me;
        int kee;
        me=this_player();
        if (!id(arg))
                return notify_fail("你要吃什么？\n");
        if(!me->query_temp("xuelian")){
        kee=me->query("max_kee");
        me->add("max_kee",kee/10);
        me->add("eff_kee",kee/10);
        kee=me->query("max_gin");
        me->add("max_gin",kee/10);
        me->add("eff_gin",kee/10);
        kee=me->query("max_sen");
        me->add("max_sen",kee/10);
        me->add("eff_sen",kee/10);
       me->set_temp("xuelian",1);
        message_vision( "$N吃下一支天山雪莲，顿觉一股浩荡真气直涌上来，精，气,神大增...\n" , me);
       destruct(this_object());
       return 1;
       }else{ write("你不要太贪心哦，多吃无益！\n"); return 1; }
}
