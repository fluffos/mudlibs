// torch.c
inherit TORCH;

void create()
{
        set_name("火折", ({ "torch" }) );
    set("real_name","火折");
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一个火摺，可以用来照明(light)。\n");
		set("value", 50);
		set("unlight_msg", "这是一把火摺，可以用来照明(light)。\n");
		set("light_msg", "这是一把点着的火摺，用来照明的，不用了可以(unlight)。\n");
	}
	set("can_light",900);
	setup();
}

