#include <roadbusy.h>

inherit ROOM;

void create() {
  set("coor", ({ -3600, 1200, 150 }));
  set("short", "天山山路");
  set("long",
    "这里是天山东麓，山风从山上吹来，你冷得瑟瑟发抖。路边是一\n"
    "片草原。草原上一位牧羊人赶着一群羊。这里向东可以下山。北\n"
    "边传来阵阵猛兽的啸声。\n"
  );
  set("exits", ([
    "eastdown": __DIR__ "shanjiao",
    "north": __DIR__ "tianroad2",
    "westup": __DIR__ "tianroad3",
  ]));
  set("objects", ([
    __DIR__ "npc/herdsman": 1,
  ]));

  setup();
  //        replace_program(ROOM);
}
