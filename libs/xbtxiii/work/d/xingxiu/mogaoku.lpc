inherit ROOM;

// can put some book about budism here.

void create()
{
        set("coor",({-2880,1080,0}));
	set("short", "莫高窟");
        set("long",
"这里墙壁上绘制着与佛教相关的画面，有仙女飞天，还有反弹琵\n"
"琶。洞中还有很多佛像和经书。你被这些瑰丽的文化之宝惊呆了。\n"
);
        set("exits", ([ 
             "north" : __DIR__"yueerquan",
]));
        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}

