  set("coor", ({ -3600, 1450, 100 }));
  set("short", "星宿海");
  set("long",
    "这里是星宿海的尽头。因为附近有野羊出没，所以星宿派弟子常\n"
    "常在此烤羊肉串吃。当打不到野羊时，他们就抢山下牧人的羊。\n"
  );
  set("exits", ([
    "southeast": __DIR__ "xxh3",
    "southwest": __DIR__ "xxh4",
  ]));
  set("objects", ([
    __DIR__ "npc/boshou": 1,
    __DIR__ "npc/obj/yangrou.lpc": 2 ]));

  set("no_clean_up", 0);
  set("outdoors", "xingxiuhai");

  setup();

}
