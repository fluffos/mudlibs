#pragma save_binary
// Room: /d/xingxiu/jiayuguan.c
// Jay 3/17/96

inherit ROOM;

void create() {
  set("coor", ({ -2500, 1000, 0 }));
  set("short", "玉门关");
  set("long",
    "这是长城最西的关隘。岁月沧桑，仍掩不住它的风采。群山环抱\n"
    "之下，更显它的雄浑。由于西域安定，久无战事，边关守军已大\n"
    "为减少。一条大道向东延伸通向中原。出关向西，便是著名的“\n"
    "丝绸之路”。\n"
  );
  set("outdoors", "xingxiuhai");
  set("exits", ([
    "eastup": __DIR__ "xxroad3.lpc",
    "west": __DIR__ "silk1.lpc",
  ]));

  set("objects", ([
    __DIR__ "npc/wujiang": 1,
    __DIR__ "npc/bing": 2,
  ]));
  setup();
}

void init() {
  if (this_player())
    this_player()->set_explore("north#47");
}
