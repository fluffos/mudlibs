#pragma save_binary
// /d/xingxiu/silk2.c
// Jay 3/17/96
#include <roadbusy.h>

inherit ROOM;

void create() {
  set("coor", ({ -2700, 1000, 0 }));
  set("short", "丝绸之路");
  set("long",
    "这是一条中原和西域之间的商道。南面连绵的祁连山脉在阳光的\n"
    "照射下好像是一条玉带。东边是中原，西面则通往西域。\n"
  );
  set("outdoors", "xingxiuhai");

  set("exits", ([
    "east": __DIR__ "silk1",
    "northwest": __DIR__ "silk3",
  ]));

  setup();
  //        replace_program(ROOM);
}
