#pragma save_binary
// wdroad2.c
// by Xiang

inherit ROOM;

void create()
{
	set("coor",({-380,-1200,0}));
	set("short", "青石大道");
	set("long",
"你走在一条青石大道上，北边隐约可见到树林\n"
);
        set("outdoors", "wudang");

	set("exits", ([
		"south" : __DIR__"wdroad3",
		"north" : __DIR__"wdroad1",
	]));

	setup();
	replace_program(ROOM);
}

