inherit ROOM;

void create() {
  set("coor", ({ -380, -1150, 0 }));
  set("short", "青石大道");
  set("long",
    "你走在一条青石大道上，四周静悄悄的。\n"
  );
  set("outdoors", "wudang");

  set("exits", ([
    "south": __DIR__ "wdroad4",
    "north": __DIR__ "wdroad2",
  ]));

  setup();
}
