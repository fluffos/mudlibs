// xiaodao2.c
// shilling 97.2

inherit ROOM;

void create()
{
	set("short", "林间小道");
	set("long",
"这是一条长长的林间小道，从东边一直通到西边，一眼望去，看\n"
"不到路的尽头。两旁百花争艳。令人留连忘返。南边好象有香味\n"
"散发出来，北边是个兵器房。\n"
);
	set("exits", ([ /* sizeof() == 4 */
		"south" : __DIR__"shantang",
		"east" : __DIR__"xiaodao1",
		"west" : __DIR__"xiuxis",
		"north" : __DIR__"bingqif",
	]));
	set("no_clean_up", 0);
	set("outdoors", "xiaoyao");
	setup();
	replace_program(ROOM);
}
