inherit ROOM;

void create()
{
        set("short", "石室大门");
        set("long",
"穿多岩洞，突然之间，手碰到一个冷冰冰的圆物，原来是个门环，\n"
"门环的后面象是一扇铜铁铸成的大门，十分沉重。即使是臂力很\n"
"好的人，推它也觉得甚为吃力。\n"
);
	set("exits", ([
		"north" : __DIR__"shidong",
		"south" : __DIR__"yandong",
	]));
	set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}
