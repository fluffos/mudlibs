// liangong.c

inherit ROOM;

void create() {
  set("short", "石屋");
  set("long",
    "这是树林中的一间石屋，屋内显得什么清净和简朴，房间中并没\n"
    "有什么特别的摆设在这里，不会受到任何东西的骚扰，是个修炼\n"
    "内功的好地方。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "xiaodao4",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
