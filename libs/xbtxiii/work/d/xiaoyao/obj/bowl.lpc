#pragma save_binary
// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("水碗", ({ "wan", "bowl" }));

  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一个水碗，里面有什么呢？当然是水啦。\n");
    set("unit", "个");
    set("value", 20);
    set("max_liquid", 10);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("liquid", ([
    "type": "teawater",
    "name": "水",
    "remaining": 10,
    "drunk_apply": 30,
  ]));
}
