inherit ROOM;

void create()
{
	set("coor",({-400,-975,0}));
	set("short", "南大街");
	set("long",
"这里是襄阳城南大街的南头。南面就是朱雀内门，北边非常热闹。\n"
"东边是为襄阳城守军打制铠甲武器的兵器铺。十余年来，由于蒙\n"
"古军的侵犯，叮叮当当的打铁声音就一直响个不停。西面是襄阳\n"
"城的南兵营，隐隐能听见里面传来的兵士们的操练声。\n"
);
        set("outdoors", "xiangyang");
	set("no_clean_up", 0);

	set("exits", ([
		"east"  : __DIR__"tiejiangpu",
		"west"  : __DIR__"bingying3",
		"south" : __DIR__"southgate1",
		"north" : __DIR__"southjie2",
	]));
	setup();
	replace_program(ROOM);
}
