#pragma save_binary
inherit ROOM;
void create()
{
        set("coor",({-200,-875,0}));
        set("short", "官道");
        set("long",
"这是襄阳到扬州的一条主要大道。它的周围有少有民居，这是由\n"
"于襄阳长期受到蒙古的攻击的缘故！这条道上有一条车痕向东方\n"
"和西方伸展，这是军队留下来得！\n"
);
        set("exits", ([ 
  "east" : __DIR__"road1",
  "west" : __DIR__"eastgate2",
]));
        set("outdoors", "xiangyang");
        setup();
}
void init()
{
        add_action("do_go","go");

}

int do_go()
{
if(random(3)){
this_player()->move(this_object());
return 1;
}
}
int valid_leave(object me, string dir)
{       object ob;
        object *inv;
        int i;
if (dir=="east"&&ob=present("soldier", this_object()))
{
if (ob->query("leader")==me->query("name")&&
    me->query("rank")==1) return 1;
else{
                inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)               
 {if (((inv[i]->query("targetid")) == me->query("id"))
        &&((string)(inv[i]->query("id")) == "token"))
        return 1;
 }              
return notify_fail(ob->name()+"向你嚷道：奉"+
ob->query("leader")+"之命封锁此路!没有通行证不得通过!\n");
    }
}
else return 1;  
}       
