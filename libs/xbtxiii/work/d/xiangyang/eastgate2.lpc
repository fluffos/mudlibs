inherit ROOM;
#include <ansi.h>;

void create() {
  set("coor", ({ -250, -875, 0 }));
  set("short", "青龙外门");
  set("long",
    "这里是襄阳城的东城门，只见城门上方是三个大字。[1;32m青\n"
    "龙门[2;37;0m近年来蒙古屡次侵犯襄阳城，故这儿把守相当严\n"
    "密，一些官兵们正在盘查要离襄阳城的人。两边是很大的草地。\n"
  );
  set("outdoors", "xiangyang");

  set("exits", ([
    "west": __DIR__ "eastgate1",
    "east": __DIR__ "road",
  ]));
  set("objects", ([
    __DIR__ "npc/pi": 1,
    __DIR__ "npc/bing": 2,
  ]));
  setup();
  replace_program(ROOM);
}
