inherit ROOM;
#include <ansi.h>;

void create()
{
	set("coor",({-400,-750,0}));
	set("short", "玄武内门");
	set("long",
"这里是襄阳城的北城门的内城门，只见城门上方是三个大字。[\n"
"1;34m玄武门[2;37;0m近年来蒙古屡次侵犯襄阳城，故这儿把守\n"
"相当严密，一些官兵们正在盘查要离襄阳城的人。两边是上城头\n"
"的石阶，向南进入城区。\n"
);
        set("outdoors", "xiangyang");

	set("exits", ([
		"eastup" : __DIR__"walln1",
		"westup" : __DIR__"walln2",
		"south"  : __DIR__"northjie",
		"north"  : __DIR__"northgate2",
	]));
	set("objects", ([
		__DIR__"npc/pi"   : 1,
		__DIR__"npc/bing" : 2,
	]));
	setup();
	replace_program(ROOM);
}

