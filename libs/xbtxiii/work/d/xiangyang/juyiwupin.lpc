inherit ROOM;

void create() {
  set("coor", ({ -455, -975, 0 }));
  set("short", "物品房");
  set("long",
    "这是聚义馆的堆放各种各样物品的房间。郭靖的二弟子武修文正\n"
    "在这儿负责向有任务的新手分发各种物品。\n"
  );
  set("exits", ([
    "northwest": __DIR__ "juyihuayuan",
  ]));
  set("objects", ([
    __DIR__ "npc/wuxiuwen": 1,
  ]));
  setup();
  replace_program(ROOM);
}
