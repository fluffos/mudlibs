inherit ROOM;

void create()
{
	set("coor",({-400,-800,0}));
	set("short", "安抚使衙门");
	set("long",
"这是安抚使衙门的大门，铜皮包门似乎极为沉重，上面有两个明\n"
"晃晃的铜环；大门紧闭，里面却传出一阵阵嬉笑声，和门口的肃\n"
"杀很不协调。想来这个安抚使大人的日子还是过得蛮滋润的。\n"
);
        set("outdoors", "xiangyang");
	set("no_clean_up", 0);

	set("exits", ([
		"south" : __DIR__"anfupailou",
	]));
	setup();
	replace_program(ROOM);
}
