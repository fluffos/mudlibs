inherit ROOM;

void create()
{
	set("coor",({-385,-775,0}));
	set("short", "茶馆");
	set("long",
"你一走进来，就闻到一股茶香沁入心脾，精神为之一爽。几张八\n"
"仙桌一字排开，坐满了客人，或高声谈论战局，或交头接耳元兵\n"
"势大。你要想打听什么，恐怕不是时候。\n"
);
	set("resource/water", 1);
	set("no_clean_up", 0);
	set("exits", ([
		"west" : __DIR__"northjie",
	]));
	setup();
	replace_program(ROOM);
}

