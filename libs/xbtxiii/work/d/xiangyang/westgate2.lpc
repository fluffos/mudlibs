inherit ROOM;
#include <ansi.h>

void create()
{
	set("short", "白虎外门");
	set("long",
"这里是襄阳城的西城门，只见城门上方是三个大字。[1;37m白\n"
"虎门[2;37;0m近年来蒙古屡次侵犯襄阳城，故这儿把守相当严\n"
"密，一些官兵们正在盘查要离襄阳城的人。两边是很大的草地。\n"
);
	set("coor", ({ /* sizeof() == 3 */
  -550,
  -875,
  0
}));
	set("outdoors", "xiangyang");
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"qzroad1",
  "east" : __DIR__"westgate1",
]));
	set("objects", ([ /* sizeof() == 2 */
  __DIR__"npc/pi" : 1,
  __DIR__"npc/bing" : 2,
]));

	setup();
}
int valid_leave(object me, string dir)
{
if(!wizardp(me) && dir == "west")
    return notify_fail(HIY"那里还没有开放，我们会尽快弄好那里，sorry!\n"NOR);
        return ::valid_leave(me, dir);
}
