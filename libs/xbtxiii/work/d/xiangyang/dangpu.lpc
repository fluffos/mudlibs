#pragma save_binary
// inn.c

inherit HOCKSHOP;


void create() {
  add_light(this_object(), 1);
  set("coor", ({ -450, -900, 0 }));
  set("short", "当铺");
  set("long",
    "这是家远近闻名的当铺，三开间的门面，一块写着『邱航当铺』\n"
    "四个金字的黑匾，足足七尺高的紫檀木的柜台被磨得光可照人，\n"
    "你一进去就有一种压抑和悲怅的感觉，柜台后的老板邱航头也不\n"
    "抬的只顾拨拉着算盘。据街坊们说铁面当铺给的价还不算最坏，\n"
    "并且从不问货的来处，除了活人什么都收，所以生意很不错。当\n"
    "铺挂有牌（ｓｉｇｎ）一块。\n"
  );

  set("exits", ([
    "north": __DIR__ "westjie1",
  ]));
  set("item_desc", ([
    "sign": @TEXT
这里是钱庄，目前我们提供的服务有：

value       估价货物。
sell        卖断货物。

TEXT
  ]));


  set("objects", ([
    __DIR__ "npc/qiuhang": 1,
  ]));

  set("rich", 600000);

  setup();
}
