inherit ROOM;

void create() {
  set("coor", ({ -450, -775, 0 }));
  set("short", "新罗坊");
  set("long",
    "新罗坊，顾名思义是给新罗人住的地方，不过其实现在新罗已经\n"
    "被高丽所灭掉，这里应该叫做高丽坊的。可是大家已经习惯了，\n"
    "于是便还这么叫。这里住着许多高丽商人，也有些高丽的使臣进\n"
    "东京城路过襄阳，便也住在这里。这里的高丽商人总有很多很好\n"
    "的货物，大家都喜欢来买，于是这里就非常的热闹了。\n"
  );
  set("exits", ([
    "south": __DIR__ "northroad1",
  ]));
  set("objects", ([
    __DIR__ "npc/gaoli": 1,
  ]));
  setup();
}
