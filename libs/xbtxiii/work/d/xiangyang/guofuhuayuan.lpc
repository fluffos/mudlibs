inherit ROOM;

void create()
{
	set("coor",({-450,-775,0}));
	set("short", "郭府后花园");
	set("long",
"这里是郭府的后花园，园内假山林立，西边种着一些青竹，东边\n"
"是几棵枝叶茂盛的木笔花树。你一走进来，就闻到一阵阵清新的、\n"
"淡淡的花香。\n"
);
	set("exits", ([
		"east"  : __DIR__"guofuwoshi",
		"west"  : __DIR__"guofukefang",
		"south" : __DIR__"guofuting",
		"north" : __DIR__"guofushufang",
	]));
	set("objects", ([
		__DIR__"npc/huang" : 1,
	]));
	setup();
	replace_program(ROOM);
}

