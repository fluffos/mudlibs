#pragma save_binary
#include <roadbusy.h>

inherit ROOM;
void create()
{
        set("coor",({-195,-875,0}));
        set("short", "官道");
        set("long",
"这是襄阳到扬州的一条主要大道。它的周围有少有民居，这是由\n"
"于襄阳长期受到蒙古的攻击的缘故！这条道上有一条车痕向东方\n"
"和西方伸展，这是军队留下来得！\n"
);
        set("exits", ([ 
  "north" : __DIR__"road3",
  "west" : __DIR__"road1",
  "east" : __DIR__"road4",
]));
        set("outdoors", "xiangyang");
        setup();
}
void init()
{
        add_action("do_go","go");

}

int do_go()
{
if(random(3)){
this_player()->move(this_object());
return 1;
}
}
