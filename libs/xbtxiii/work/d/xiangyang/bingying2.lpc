inherit ROOM;

void create() {
  set("coor", ({ -300, -850, 0 }));
  set("short", "兵营");
  set("long",
    "这里是兵营，密密麻麻到处都是官兵，有的在武将的指挥下列队\n"
    "操练，有的独自在练功，有的坐着、躺着正在休息。南墙下坐着\n"
    "主帅，不动声色地寻视着四周。看到你进来，他们全都向你瞪大\n"
    "眼睛盯着你。\n"
  );
  set("item_desc", ([
    "dong": "\n",
  ]));

  set("exits", ([
    "south": __DIR__ "eastjie3",
  ]));
  set("objects", ([
    __DIR__ "npc/pian": 1,
    __DIR__ "npc/zuo": 1,
    __DIR__ "npc/bing": 2,
  ]));
  setup();
}
