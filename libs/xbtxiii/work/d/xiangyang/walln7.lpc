inherit ROOM;

void create() {
  set("coor", ({ -300, -750, 100 }));
  set("short", "北城头");
  set("long",
    "这里是襄阳的北城头。一些宋兵正在城头巡逻，一个牙将正在这\n"
    "儿负责接受各种守城材料，一些弓箭手正拈弓搭箭紧盯着城下的\n"
    "动静。\n"
  );
  set("outdoors", "xiangyang");

  set("exits", ([
    "southeast": __DIR__ "walle8",
    "westdown": __DIR__ "walln5",
  ]));
  set("objects", ([
    __DIR__ "npc/ya": 1,
    __DIR__ "npc/bing": 2,
  ]));
  setup();
  replace_program(ROOM);
}
