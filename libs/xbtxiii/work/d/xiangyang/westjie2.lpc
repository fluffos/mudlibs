inherit ROOM;

void create()
{
	set("coor",({-475,-875,0}));
	set("short", "西大街");
	set("long",
"这儿是很大的十字街口，北边是西内大街，南面是一座彩楼，楼\n"
"前高高的挂着一方大匾，上面用正楷写着“聚义馆”，落款“朱\n"
"子柳”。东边通向中央广场，西面可达白虎门。\n"
);
        set("outdoors", "xiangyang");
	set("no_clean_up", 0);

	set("exits", ([
		"east"  : __DIR__"westjie1",
		"west"  : __DIR__"westjie3",
		"south" : __DIR__"juyiyuan",
		"north" : __DIR__"westroad1",
	]));
	set("objects", ([
		__DIR__"npc/wusantong" : 1,
	]));
	setup();
	replace_program(ROOM);
}

