inherit ROOM;

void create() {
  set("coor", ({ -485, -825, 0 }));
  set("short", "书店");
  set("long",
    "这里的老板刚从南阳搬来，听说以前他曾在嵩山少林寺出过家，\n"
    "后不知什么原因又还了俗，专门卖书为生。只见书店面积很大，\n"
    "以前曾是一座勾栏。\n"
  );
  set("exits", ([
    "east": __DIR__ "westroad2",
  ]));
  set("objects", ([
    __DIR__ "npc/shudianboss": 1,
  ]));
  setup();
}
