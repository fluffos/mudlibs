inherit ROOM;

void create() {
  set("coor", ({ -385, -975, 0 }));
  set("short", "兵器铺");
  set("long",
    "这里原来是一家极其简陋的铁匠铺。近年来蒙古大军屡次进犯襄\n"
    "阳，这家铁匠铺被官府征用，作为官办作坊。目前规模很大，一\n"
    "般用来为襄阳守军打造铠甲、兵器等，近来因襄阳需筹备守城物\n"
    "资，奉郭夫人之命也生产一些铁钎、铁锤、伐木斧头等。只见几\n"
    "十个铁匠正叮叮当当地忙个不停。\n"
  );
  set("exits", ([
    "west": __DIR__ "southjie3",
  ]));
  set("objects", ([
    __DIR__ "npc/tiejiang": 1,
  ]));
  setup();
  replace_program(ROOM);
}
