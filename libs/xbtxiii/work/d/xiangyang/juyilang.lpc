inherit ROOM;

void create()
{
	set("coor",({-475,-925,0}));
	set("short", "水上走廊");
	set("long",
"这时一条笔直的走廊，廊下是一湖池水。湖水映着长长垂柳，碧\n"
"绿清澈，你能看见一些鱼在游来游去。南面就是一个大花园，圆\n"
"内东西两侧各有一排厢房。\n"
);
        set("outdoors", "xiangyang");
	set("no_clean_up", 0);

	set("exits", ([
		"south" : __DIR__"juyihuayuan",
		"north" : __DIR__"juyiyuan",
	]));
	setup();
	replace_program(ROOM);
}

