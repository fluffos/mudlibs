inherit ROOM;

void create() {
  set("coor", ({ -350, -800, 0 }));
  set("short", "北内大街");
  set("long",
    "这是一条用青石铺就的大道。只见北面不时的有马车飞奔而出，\n"
    "噢，北面是车行。向西就是丁字街口，东面也是一个大街口，你\n"
    "好象看到一条大街通向南面。南面是一堵上盖红色琉璃瓦的高墙，\n"
    "里面是襄阳守城大将王坚的府邸。\n"
  );
  set("outdoors", "xiangyang");

  set("no_clean_up", 0);
  set("exits", ([
    "east": __DIR__ "jiekou2",
    "west": __DIR__ "dingzi",
    "north": __DIR__ "majiu",
  ]));
  setup();
  replace_program(ROOM);
}
