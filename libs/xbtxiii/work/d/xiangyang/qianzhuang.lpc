#pragma save_binary
// inn.c

inherit BANK;
int do_apply(string arg);


void create() {
  add_light(this_object(), 1);
  set("coor", ({ -415, -925, 0 }));
  set("short", "钱庄");
  set("long",
    "这里是襄阳的钱庄，因为这里商业相当发达，各地的商号都和这\n"
    "里有银钱来往。钱庄里有很多人在存取钱，也有人在兑换银两。\n"
    "看着这么多的钱财滚来滚去，真是让人眼馋啊。但眼下大敌当前，\n"
    "全城一致抵御元兵。钱庄的业务由华山弟子接管，支援大侠郭靖\n"
    "和郭夫人。墙上贴着一个牌子(paizi)。\n"
  );

  set("exits", ([
    "west": __DIR__ "swind5",
  ]));
  set("item_desc", ([
    "paizi": @TEXT
     本钱庄提供以下服务：
      存钱        deposit
      取钱        draw
      钱币兑换    convert
      查帐        bankinfo
TEXT
  ]));


  set("no_fight", 1);
  set("exits", ([
    "east": __DIR__ "southjie1",
  ]));
  set("objects", ([
    __DIR__ "npc/huangzhen": 1,
  ]));

  setup();
}
void init() {
  ::init();
  add_action("do_apply", "apply");
}

int do_apply(string arg) {
  object me, book, *ob;
  int s;
  me = this_player();
  if (!arg) return 0;
  if (arg != "card") return 0;
  ob = all_inventory(me);
  s = sizeof(ob);
  while (s--) {
    if (!stringp(ob[s]->query("id"))) continue;
    if (ob[s]->query("id") == "account card") {
      tell_object(me, "你已经有金龙卡了!\n");
      return 1;
    }
  }
  book = new("/obj/a_book.lpc");
  book->set("master_id", me->query("id"));
  book->set("rich", 0);
  book->move(me);
  if (file_size(book->query_save_file() + ".o") > 0) book->restore();
  tell_object(me, "你忽然觉得腰包一鼓, 好象多了点什么.\n");
  tell_room(this_object(), "钱庄老板把金龙卡递给" + me->query("name") + ".\n", me);
  return 1;
}
