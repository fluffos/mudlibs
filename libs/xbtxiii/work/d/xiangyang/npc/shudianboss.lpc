// shudianboss.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("书店老板", ({ "shudian laoban", "boss" }));
  set("gender", "男性");
  set("age", 62);
  set("long", "一个让孩子们一见就觉得可亲的老翁。\n");
  set("combat_exp", 3000);
  set("str", 27);
  set("dex", 20);
  set("con", 17);
  set("int", 22);
  set("attitude", "friendly");
  set("vendor_goods", ([
    "/obj/book/parry_book": 10,
    "/obj/book/l_book1": 5,
    "/obj/book/l_book2": 5,
    "/obj/book/l_book3": 5,
    "/obj/book/magic_book1": 5,
    "/obj/book/magic_book2": 5,
    "/obj/book/spells_book1": 5,
    "/obj/book/spells_book2": 5,
    "/d/fy/npc/obj/book": 20,
  ]));
  setup();
  carry_object("/obj/misc/cloth")->wear();
  add_money("coin", 100);
}
/*void init()
{
        ::init();
//        add_action("do_buy", "buy");
        add_action("do_list", "list");
} */
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}
