// huoji. 药铺伙计

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("药铺伙计", ({ "yaopu huoji", "huoji" }));
  set("str", 20);
  set("gender", "男性");
  set("age", 18);
  set("long", "他是平神医从乡下招来帮忙的。\n");
  set("combat_exp", 250);
  set("attitude", "friendly");
  set("vendor_goods", ([
    __DIR__ "obj/jinchuang": 10,
    __DIR__ "obj/yangjing": 20,
    //		__DIR__"obj/wuchangdan":1,
    __DIR__ "obj/zhujingchan": 30,
    __DIR__ "obj/dust": 10,
    //		"/d/shenlong/obj/xionghuang",
  ]));

  setup();
  carry_object("/obj/cloth")->wear();
  add_money("coin", 100);
}

void init() {
  add_action("do_vendor_list", "list");
}
