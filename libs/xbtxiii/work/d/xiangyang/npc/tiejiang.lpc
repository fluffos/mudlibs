// tiejiang.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("铁匠", ({ "tiejiang", "smith" }));
	set("title", "铁匠铺老板");
	set("shen_type", 1);

	set("gender", "男性" );
	set("age", 33);
	set("long", "这位铁匠正在叮叮当当地打着铁，发现你在注视着他，就抬起头来微笑了一下。\n");

	set("combat_exp", 400);
	set("attitude", "friendly");
	set("vendor_goods",([
            "/obj/weapon/gangdao":5,
            "/obj/weapon/changjian":5,
//            "/obj/weapon/qimeigun":5,
            "/d/latemoon/npc/obj/whip": 5,
            "/obj/weapon/gangzhang":5,
            "/d/yangzhou/obj/tiejia":5,
	]));
	setup();
        carry_object("/obj/misc/cloth")->wear();
}

void init()
{
	object ob;

	::init();
	if(interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

