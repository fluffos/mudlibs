#include <ansi.h>
inherit TORCH;

void create() {
  set_name("火摺", ({ "fire" }));
  set("real_name", "火摺");
  set("long", "这是一个可以生火的火摺");
  set("unlight_msg", "这是一把火把，可以用来照明(light)。\n");
  set("light_msg", "这是一把点着的火把，用来照明的，不用了可以(unlight)\n");
  set_weight(50);
  set("value", 10);
  set("can_light", 900);
  setup();
}
