  );
  set("outdoors", "xiangyang");

  set("exits", ([
    "west": __DIR__ "jiekou2",
  ]));
  set("objects", ([
    __DIR__ "npc/kid": 2,
  ]));
  setup();
  replace_program(ROOM);
}
