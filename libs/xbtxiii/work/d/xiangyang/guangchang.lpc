inherit ROOM;

void create() {
  set("coor", ({ -950, -2300, 0 }));
  set("coor", ({ -950, -2300, 0 }));
  set("short", "中央广场");
  set("my_point", "襄阳城");
  set("long",
    "这里是襄阳的中央广场，铺着青石地面。东面通向青龙门，西面\n"
    "通向白虎门，南面直达朱雀门，远远地你可看到北面是襄阳安抚\n"
    "使衙门。近年来蒙古大军屡次攻打襄阳，官府为防止蒙古奸细混\n"
    "杂进来，已经不允许人们在此聚集。只见一队官兵在此往来巡逻，\n"
    "你还是快离开吧。\n"
  );
  set("outdoors", "xiangyang");
  set("item_desc", ([
    "dong": "\n",
  ]));

  set("exits", ([
    "east": __DIR__ "eastjie1",
    "west": __DIR__ "westjie1",
    "south": __DIR__ "southjie1",
    "north": __DIR__ "anfupailou",
  ]));
  set("objects", ([
    __DIR__ "npc/pian": 1,
    __DIR__ "npc/bing": 1,
    //                  "/d/biao/kehu" : 1,
  ]));
  setup();
  replace_program(ROOM);
}
