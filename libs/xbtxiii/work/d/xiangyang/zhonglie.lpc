inherit ROOM;

void create() {
  set("coor", ({ -315, -825, 0 }));
  set("short", "忠烈祠");
  set("long",
    "这里是襄阳城的忠烈祠，十余年来为保卫襄阳而牺牲的烈士遗骨\n"
    "都安葬在这里，每个有爱国心的好汉到这都会来祭奠一下忠魂。\n"
  );
  set("no_fight", 1);
  set("no_beg", 1);
  set("no_clean_up", 0);

  set("exits", ([
    "west": __DIR__ "eastroad2",
  ]));
  setup();
}
