inherit ROOM;

void create()
{
	set("coor",({-385,-925,0}));
	set("short", "学堂");
	set("long",
"这里是襄阳的学堂，窗明几净，一尘不染。一位庄重严肃的老先\n"
"生坐在太师椅上讲学。在他的两侧坐满了求学的学生。一张古意\n"
"盎然的书案放在老先生的前面，案上摆着几本翻开了的线装书籍。\n"
);
	set("exits", ([
		"west" : __DIR__"southjie1",
	]));
	set("objects", ([
		__DIR__"npc/laoxiansheng" : 1,
	]));
	setup();
	replace_program(ROOM);
}
