inherit ROOM;

void create() {
  set("coor", ({ -315, -850, 0 }));
  set("short", "福威镖局");
  set("my_point", "襄阳城");
  set("long",
    "你来到一座结构宏伟的建筑前，左右石坛上各插着一根两丈多高\n"
    "的旗杆，杆上青旗飘扬。右首旗子用金线绣着一头张牙舞爪的狮\n"
    "子，狮子上头有一只蝙蝠飞翔。左首旗子上写着“福威镖局襄阳\n"
    "分号”八个黑字，银钩铁划，刚劲非凡。入口排着两条长凳，几\n"
    "名镖头坐着把守。\n"
  );
  set("exits", ([
    "west": __DIR__ "eastroad1",
  ]));
  set("objects", ([
    __DIR__ "npc/biaotou": 2,
    "/d/biao/kehu": 1,
  ]));
  setup();
  replace_program(ROOM);
}
