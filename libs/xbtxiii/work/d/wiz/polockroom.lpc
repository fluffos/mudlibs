// Room: /d/wiz/courthouse.c

#include <ansi.h>
void test_me(object me);
inherit ROOM;

void create()
{
	add_light(this_object(),1);
	set("short", "监狱");
	set("long",
"[31m雄霸天下II唯一的一个监狱，能到这里来的人一定都是令\n"
"人头痛的角色。但是一到这里，别人的头就不痛了，你的头应该\n"
"开始痛了吧．．．你被关到这里的原因是你的潜能超过一百万。\n"
"你可以随时自己离开这里，但是如果你自己离开，潜能将会只剩\n"
"下十万。如果你等巫师来放你出去，可以保留多少潜能可以商量。\n"
"如果你是巫师，并要放这里的玩家出去，请直接用summon命令，\n"
"否则玩家会被扣掉潜能的。\n\n"
);
        set("exits", ([ /* sizeof() == 2 */
  "only10w" : "/d/fy/fysquare",
]));

	set("no_fight", 1);
        set("no_arrest", 1);
	set("no_magic", 1);
	set("no_spells", 1);
	setup();
}
void init()
{
        if(!wizardp(this_player())&&this_player()->query("imprison_time")>time()-547200)
	{
	"/cmds/std/look"->look_room(this_player(),this_object());
	this_player()->set("startroom", __FILE__);
        add_action("do_nothing", "");
	add_action("do_quit","quit");
	}
}	

int do_nothing()
{
write("监狱的生活真苦啊．．．．！\n");
return 1;
}

int do_quit()
{
"/cmds/usr/quit"->main(this_player(),"");
return 1;
}
int valid_leave(object me, string dir)
{
	me->set("startroom", "/d/fy/fysquare");
                        if((me->query("potential")-me->query("learned_points"))>100000)
                        {
                        me->set("potential",(me->query("learned_points")+100000));
                        }
	return 1;
}
