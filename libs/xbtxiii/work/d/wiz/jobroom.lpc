// Room: /d/wiz/jobroom.c

inherit ROOM;

void create()
{
	add_light(this_object(),1);
	set("short", "工作进度简报室");
	set("long",
"这里是巫师们报告自己工作进度的简报室，同时也是大巫师抓公\n"
"差的根据，如果你有工作做，最好常常到这里更新你的工作进度，\n"
"如果太久没有看到你的工作进度报告，大巫师们会以为以没事做\n"
"而指派工作给，要是你仍然不理，也有可能会被假设成已经放弃\n"
"巫师的工作而降回玩家身分。\n"
);
	set("exits", ([ /* sizeof() == 1 */
  "south" : "/d/wiz/hall1",
  "north" : "/d/wiz/court",
]));
	set("no_clean_up", 0);

	setup();
	call_other("/obj/board/wizard_j", "???");
}
int clean_up(){return 0;}
