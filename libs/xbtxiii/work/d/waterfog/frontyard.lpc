#pragma save_binary
// Room: /d/waterfog/frontyard.c

inherit ROOM;

void create()
{
	set("coor",({-200,4710,25}));
	set("short", "水烟阁前");
	set("long",
"你现在正站在一座高大的楼阁，水烟阁前，琉璃色的屋瓦和白玉\n"
"般的白石砖使得水烟阁在崇山峻岭中显得十分抢眼，这座楼阁最\n"
"早的主人据说是有「武术之神」称号的太阳神君「杞庸」，后来\n"
"被当作历代武林盟主的居所，可说是学武之人的朝圣地，一条白\n"
"石阶梯沿著山腰往南而下，水烟阁的大门就在你的北方。\n"
);
	set("exits", ([ /* sizeof() == 3 */
  "west" : "/d/waterfog/wpath1",
  "north" : "/d/waterfog/entrance",
  "southdown" : "/d/waterfog/stair5",
]));
	set("no_clean_up", 0);
	set("outdoors", "waterfog");

	setup();
	replace_program(ROOM);
}
