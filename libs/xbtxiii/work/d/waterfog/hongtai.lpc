#pragma save_binary
// Room: /d/waterfog/hongtai.c

inherit ROOM;

void do_jump(string);

void create()
{
    set("short", "虹台比武大会场地");
	set("long",
"你现在来到虹台比武场，场地中间立著一个两丈多高的擂台(tai)\n"
"，场地里人头涌涌，掌声四起，立马就能感受到会场的气氛。\n"
);
	set("item_desc", ([ /* sizeof() == 1 */
  "tai" : "比武用的擂台，你很有一种跳上去(jumpin)的冲动。
",
]));
	set("exits", ([ /* sizeof() == 1 */
  "north" : "/d/waterfog/swordtomb",
]));
	set("no_clean_up", 0);

	setup();
}
void init()
{       
add_action("do_jump", "jumpin");
}
void do_jump(string arg)
{
message_vision("$N纵身一跃，跳上擂台大声呼喊道：有种的上来跟我只抽。\n",
this_player());
return;
}
