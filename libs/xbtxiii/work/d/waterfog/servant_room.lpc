#pragma save_binary
// Room: /d/waterfog/servant_room.c

inherit ROOM;

void create()
{
        set("coor",({-215,4740,25}));
	set("short", "仆役卧室");
        set("long",
"这里是在水烟阁从事杂役的仆佣所住的卧室，房间相当宽敞，东\n"
"西向一张大通铺最少可以睡二、三十人，东首一张大炕(bed)是\n"
"冬天才用的，因为有不少仆役回家过冬，所以比床铺稍小，北边\n"
"开了几扇窗子，南边则是摆放仆役私物的橱柜。\n"
);
        set("exits", ([ /* sizeof() == 1 */
                "west" : __DIR__"storage",
]));

      set("item_desc", ([
                "bed": (: "这张床摆放在这儿已经有多年了，但奇怪的是上面竟然没有一丝灰尘。\n" :),
               ]) );
        setup();

//    replace_program(ROOM);
}
void init ()
{
        add_action ("do_search", "search");
}

int do_search (string arg)
{
         object tongling;
        if ((arg == "bed") || (arg == "床")) {
            message("vision", "你突然觉得脚下一松,原来你触动了机括。\n",
                  this_player());
                this_player()->move(__DIR__"midao");
        tongling = new("/d/waterfog/npc/obj/tongling");
         tongling->move(this_player()); 
            message("vision", "你从上面掉了下来,摔了个半死。\n",
                  this_player());
            return 1;
        }
}
     
