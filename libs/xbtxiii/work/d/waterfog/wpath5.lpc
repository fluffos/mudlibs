inherit ROOM;

void create() {
  set("short", "白石阶梯");
  set("long",
    "你现在走在一道依著山壁而建的白石阶梯上，通过西边不远处的\n"
    "葬剑亭，就是虹台的入口，东边和北边都是深不见底的深谷，隔\n"
    "著深谷，东北边的野羊山连著隐樵山、图云岭、破魔山、虎啸坡、\n"
    "沙牢山一直到大漠都是数百丈的高山，虹台地势虽不甚高，但是\n"
    "在三面深谷的环绕下，却自有一股群山朝拜的威严气象。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "southeast": "/d/waterfog/wpath4",
    "west": "/d/waterfog/swordtomb",
  ]));
  set("objects", ([
    __DIR__ "npc/guard2": 1,
  ]));
  set("outdoors", "waterfog");

  setup();
  replace_program(ROOM);
}
