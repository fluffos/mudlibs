#pragma save_binary
// guard.c

inherit NPC;

void create()
{
    set_name("发疯的武士", ({ "mad guard", "guard" }) );
	set("gender", "男性");
	set("age", 34);
	set("long", "这个人相貌十分魁梧。\n");

      set("bellicosity",10000);
        create_family("天邪派", 16, "弟子");
    set("combat_exp", 200000);
	set("score", 4000);

	set("str", 25);
	set("cor", 23);
	set("cps", 23);
	set("con", 27);

    set("force", 1000);
    set("max_force", 1000);
	set("max_force", 700);
    set("force_factor", 50);

	set("chat_chance_combat", 40);
	set("chat_msg_combat", ({
		(: exert_function, "recover" :),
        (: exert_function, "powerup" :),
        (: exert_function, "roar" :),
	}) );


        set("chat_chance", 20);
        set("chat_msg", ({
                (: random_move :),
        (: exert_function, "roar" :),
        }) );
	set_skill("force", 50);
	set_skill("unarmed", 60);
	set_skill("parry", 50);
	set_skill("dodge", 50);

	set_skill("celestial", 50);
	set_skill("celestrike", 50);
    set_skill("sword", 80);
    set_skill("six-chaos-sword", 80);

    map_skill("sword", "six-chaos-sword");
	map_skill("force", "celestial");
	map_skill("unarmed", "celestrike");

	setup();

    carry_object("/obj/longsword")->wield();
	carry_object(__DIR__"obj/guard_suit")->wear();
	carry_object(__DIR__"obj/leather_boot")->wear();
}
