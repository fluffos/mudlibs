#pragma save_binary
// Room: /d/waterfog/wpath3.c

inherit ROOM;

void create() {
  set("short", "白石阶梯");
  set("long",
    "你正走在一道白石阶梯上，这道阶梯依著山壁而建，东边隔著一\n"
    "个深不见底的山谷可以望见对面傲立在山巅之上的水烟阁，每当\n"
    "清晨山谷中的晨雾慢慢飘起，从这里可以看见水烟阁彷佛飘在云\n"
    "间，这就是水烟十景中的「飞天楼阁」，石阶沿著山壁从这里转\n"
    "往北方。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": "/d/waterfog/wpath4",
    "southwest": "/d/waterfog/wpath2",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "waterfog");

  setup();
}
