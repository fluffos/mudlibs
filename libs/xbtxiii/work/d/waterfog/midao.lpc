inherit ROOM;

void create()
{
        set("short", "天邪密室");
        set("long",
"这里是天邪派的密室。抬头你能看见的只有岩石，脚下是一条大\n"
"理石铺成的台阶，台阶蜿蜒向下，不远的尽头似乎有一点点亮光。\n"
"你的心不由得怦怦乱跳。\n"
);
        set("exits", ([ /* sizeof() == 2 */
        "north" : __DIR__"midao1",
  //"northup" : "/d/waterfog/stair2",
  //"southdown" : "/d/waterfog/sroad2",
]));
       // set("outdoors", "waterfog");

        setup();
       // replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
  if( dir=="north" && me->query("family/family_name")!="天邪派" && !wizardp(me))
                return notify_fail("！！非天邪弟子不得入内！！\n");
        return ::valid_leave(me, dir);
}


