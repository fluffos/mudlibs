#pragma save_binary
// change by alvins 10-08-99

inherit ROOM;
void create() {
  set("short", "火沼中心");
  set("long",
    "一潭黑水不停地冒着气泡，枯枝烂叶连同发黄的白骨足有尺厚。\n"
    "几块暗红色的狰狞巨石堆在黑水中央，上面布满了各种尸骸。潭\n"
    "水中漂浮着段段枯木，有些还散发着袅袅黑烟。\n"
  );
  set("exits", ([
    "west": __DIR__ "zhaoze4",
  ]));
  set("no_arrest", 1);
  setup();
}
int clean_up() {
  return 0;
}
int reset() {
  if (query("Reset"))
    return 0;
  if (!random(20)) {
    set("Reset", 1);
    set("objects", ([
      __DIR__ "npc/dragon": 1,
    ]));
  }
  ::reset();
}
