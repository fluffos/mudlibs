#pragma save_binary
#include <ansi.h>
#include <armor.h>
inherit F_AUTOLOAD;
inherit CLOTH;
void create()
{
	set_name( HIR "火龙赤皮" NOR, ({ "dragonskin" }));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long",
			"一块布满暗红色的鳞皮\n");
		set("value", 7000);
		set("material", "cloth");
		set("skill", ([
			"name": 		"force",	
			"exp_required":	500000,				
			"sen_cost":		50,				
			"difficulty":	30,		
			"max_skill":	150		
		]) );
		set("armor_prop/armor",50);
		}
	setup();
}
int query_autoload()
{
        return 1;
}
