#pragma save_binary
inherit ROOM;

void create() {
  set("coor", ({ -700, 4070, 50 }));
  set("short", "阳台");
  set("long",
    "这是一个小小的阳台。从这里你可以一直望到山脚。强劲的山风\n"
    "吹在你身上，让你感到份外的凉爽。真是一个好去处。\n"
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "bedroom",
  ]));
  set("objects", ([
    __DIR__ "npc/pigeon": 2,
  ]));

  set("outdoors", "chuenyu");
  setup();
}
