#pragma save_binary
inherit ROOM;

void create() {
  set("coor", ({ -690, 4100, 25 }));
  set("short", "地牢");
  set("long",
    "这里黑黑暗暗，几乎伸手不见五指。唯一的光亮来自墙上忽明忽\n"
    "暗的松油灯。地上和墙上布满了暗红色的血痕，散发出阵阵腥气。\n"
    "不断传来的哀嚎声在死沉的地牢里回荡，令人毛骨耸然。\n"
  );
  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "tunnel1",
    "west": __DIR__ "tunnel6",
    "east": __DIR__ "tortureroom",
  ]));

  setup();
  replace_program(ROOM);

}
