// Room: /d/taishan/road1
#include <roadbusy.h>

inherit ROOM;

void create() {
  set("short", "山路");
  set("long",
    "一条清幽的山路。路两旁是高大的古木。从远处不时传来几声不\n"
    "知是什么鸟类的鸣叫声。更加衬托出了宁静的气氛。往东是去泰\n"
    "山的路。而西边不远就是风光秀丽的嘉兴南湖羁勒\n"
  );
  set("exits", ([
    "east": __DIR__ "road2",
    "west": "/d/quanzhou/nanhu1",
  ]));
  set("outdoors", "taishan");
  setup();
  //        replace_program(ROOM);
}
