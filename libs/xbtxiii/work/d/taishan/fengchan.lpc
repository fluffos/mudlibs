inherit ROOM;

void create()
{
	set("short", "封禅台");
	set("long",
"如今这里是推选天下武林总盟主之处，各路英雄如能技压群雄，\n"
"比武夺魁，便能问鼎盟主宝座，成为统领中原武林的领袖。高\n"
"台上摆放着汉白玉宝座，盟主便在此坐堂议事。台上高高立着\n"
"一竿旗，上书：替天行道四个大字。盟主左右各侍立着两位白\n"
"衣武士，两边都放着一长排虎皮交椅，时常有武林前辈高手前\n"
"来参见盟主。\n"
);
	set("exits", ([
		"down" : __DIR__"yuhuang",
		"east" : __DIR__"xiayi",
		"west" : __DIR__"zhengqi",
	]));
	set("objects",([
                "/obj/npc/meng-zhu" : 1,
		__DIR__"npc/wei-shi1" : 4,
	]));
//        set("no_clean_up", 1);
        set("no_arrest", 1);
        set("no_magic",1); //解决一个机器人bug maybe 加
	set("outdoors", "taishan");
	setup();
}
int init()
{
        add_action("do_cast", ({"cast invocation","scribe","alert","drivesnake"})); 
}


int do_cast()
{
        write("比武争盟主是光明正大的，怎么可以叫帮手！\n");
        return 1;
}
