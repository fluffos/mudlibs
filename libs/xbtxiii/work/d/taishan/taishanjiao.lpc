inherit ROOM;

void create() {
  set("short", "泰山脚下");
  set("long",
    "泰山古称岱山，为五岳的东岳，为道教第二小洞天，向有五岳独\n"
    "尊之称誉，以泰山天下雄名闻域内。往北就到岱宗坊了。\n"
  );
  set("exits", ([
    "north": __DIR__ "daizong",
    "west": __DIR__ "road6",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "taishan");
  setup();
  replace_program(ROOM);
}
