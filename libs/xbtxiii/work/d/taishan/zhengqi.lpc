inherit ROOM;

void create()
{
	set("short", "正气厅");
	set("long",
"这里是封禅台右边的正气厅，武林盟罚恶使者平时不下山时，\n"
"通常都是在这里处置武林公案。上首正中放着把虎皮椅，罚恶使\n"
"者就坐在上面开堂审理。左右各侍立着几位红衣武士，看上去\n"
"杀气腾腾，令人凛然而生惧意。\n"
);
	set("exits", ([
		"east" : __DIR__"fengchan",
	]));
	set("objects",([
                "/obj/npc/fa-e" : 1,
		__DIR__"npc/wei-shi2" : 3,
	]));
//        set("no_clean_up", 1);
        set("no_arrest", 1);
        set("no_magic",1); //解决一个机器人bug maybe 加
	setup();
}

int init()
{
        add_action("do_cast", ({"scribe","alert","drivesnake"})); 
}

int do_cast()
{
        write("比武争罚恶使者是光明正大的，怎么可以叫帮手！\n");
        return 1;
}
