// Room: /d/taishan/road1
#include <roadbusy.h>

inherit ROOM;

void create() {
  set("short", "山路");
  set("long",
    "一条清幽的山路。路两旁是高大的古木。从远处不时传来几声不\n"
    "知是什么鸟类的鸣叫声。更加衬托出了宁静的气氛。再望东走就\n"
    "到泰山山脚了\n"
  );
  set("exits", ([
    "east": __DIR__ "taishanjiao",
    "west": __DIR__ "road5",
  ]));
  set("outdoors", "taishan");
  setup();
  //        replace_program(ROOM);
}
