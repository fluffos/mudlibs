int accept_object(object who, object ob) {
  object obn;
  if (!who || environment(who) != environment())
    return 0;
  if (!objectp(ob))
    return 0;
  if (!present(ob, who))
    return notify_fail("你没有这件东西。\n");
  if ((string)ob->query("name") != "开山立派令牌") {
    say("巫厨说道：“这件东西我不需要，你还是拿回去吧。”\n");
    return 0;
  }
  say("巫厨说道：“:好，你可以开山立派了。请输入 kai <新门派名>”\n");
  who->set_temp("pending/kaishan", 1);
  return 1;
}
int do_kai(string arg) {
  object me;
  me = this_player();
  if (!this_player()->query_temp("pending/kaishan"))
    return 0;
  if (!arg) return notify_fail("你不想开山立派吗？\n");
  this_player()->set_temp("pending/kaishan", 0);
  message_vision("$N正言道：创建" + arg + "\n", this_player());
  me->create_family(arg, 1, "掌门人");
  command("nod");
  command("chat 恭喜大侠" + me->query("name") + "创建" + arg);
}
