inherit ROOM;

void create() {
  set("short", "侠义厅");
  set("long",
    "这里是封禅台左边的侠义厅，武林盟赏善使者平时不下山时，\n"
    "通常都是在这里办理武林公案。上首正中放着把太师椅，赏善使\n"
    "者就坐在上面开堂审理。左右各侍立着几位红衣武士，看上去\n"
    "威风凛凛，自有一股庄严气象。\n"
  );
  set("exits", ([
    "west": __DIR__ "fengchan",
  ]));
  set("objects", ([
    "/obj/npc/shang-shan": 1,
    __DIR__ "npc/wei-shi2": 3,
  ]));
  //        set("no_clean_up", 1);
  set("no_arrest", 1);
  set("no_magic", 1);  //解决一个机器人bug maybe 加
  setup();
}
int init() {
  add_action("do_cast", ({ "scribe", "alert", "drivesnake" }));
}

int do_cast() {
  write("比武争赏善使者是光明正大的，怎么可以叫帮手！\n");
  return 1;
}
