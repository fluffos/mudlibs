#pragma save_binary

inherit NPC;

void create() {
  set_name("镖师", ({ "biaoshi", "bian" }));
  set("gender", "男性");
  set("运镖人", 1);
  set("age", 32);
  set("long", "这是一位高达六尺的镖师。\n");
  set("combat_exp", 50000);
  set("max_kee", 1000);
  set("attitude", "friendly");
  set_skill("hammer", 100);
  set_skill("dodge", 130);
  set_skill("move", 1500);
  set_skill("iron-cloth", 160);

  setup();
  add_money("silver", 50);
  carry_object("/d/fy/npc/obj/jinzhuang")->wear();
  carry_object("/d/fy/npc/obj/stonehammer")->wield();
}
