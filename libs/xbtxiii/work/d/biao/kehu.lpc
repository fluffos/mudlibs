void give_reward(object me);
int dest_all_the_obj(object me);
inherit NPC;
#include <ansi.h>

void create()
{       switch(random(6)+1)
        {
	        case 1:
        	set_name("富翁", ({ "fuweng"}) );
        	break;
        	case 2:
        	set_name("地主", ({ "dizhu"}) );
        	break;
        	case 3:
        	set_name("钱庄老板", ({ "boss"}) );
        	break;
        	case 4:
        	set_name("员外", ({ "yuanwai"}) );
	        break;
        	case 5:
        	set_name("大官", ({ "officer"}) );
        	break;
        	case 6:
        	set_name("太监", ({ "taijian"}) );
        	break;
        }
        set("gender", "男性" );
        set("age", 42);
        set("long", "这是一位金狮镖局的老客户了。\n");
        set("combat_exp", 50000);
        set("attitude", "friendly");
        set_skill("unarmed", 90);
        set_skill("dodge", 100);
        setup();
	carry_object("/obj/cloth")->wear();
        add_money("silver", random(15));
}
void init()
{
        set("my_point",environment(this_object())->query("my_point"));
        add_action("show_me","show");  
        add_action("finish_mission","finish");
        add_action("fail_mission","fail");
}

int show_me(string arg)
{
        object me,kehu,ob,biaotou,cart,room,*member;
        int i;
        kehu=this_object();
        me=this_player();
        room=environment();
	if (room->query("my_point") == "风云城"||room->query("my_point") == "京城"
   	||room->query("my_point") == "绮云镇"||room->query("my_point") == "宁远城"
   	||room->query("my_point") == "扬州城"||room->query("my_point") == "金陵城"
   	||room->query("my_point") == "泉州城"||room->query("my_point") == "襄阳城")
   	{
	    if (arg=="yaopai"||arg=="gold_yaopai")
	    {
		if(me->query_team()&&!me->is_team_leader())
		{
			command("say 别插嘴？叫你们队长过来和我说话.");
			return 1;
		}
       	        if(me->query("yunbiao/have_show"))
       	        {
	  	    command("say 镖车已经来了拉，还不去运！ \n");
          	    return 1;
          	}

        	if(me->query("yunbiao/start_point")!=kehu->query("my_point"))
            	    command("say 我这儿现在没有镖需要你们保，以后再来吧! \n");
        	else
        	{
            	    command("say 丢镖可是要赔双份的，一路小心。");
    	    	    say("一队镖车从内院驶出。\n");
	            ob=new(__DIR__"obj/cart");
    	            ob->move(environment());
        	    cart=ob;
	            cart->set("our_leader",me->query("id"));
		    cart->set("owner",me);
                    
                    biaotou=new(__DIR__"biaotou");
	            biaotou->move(environment());
    	            biaotou->set("cart",cart);
        	    biaotou->set_leader(me);
	            biaotou->set("our_leader",me->query("id"));
		    biaotou->set("owner",me);
                
        	    ob=new(__DIR__"obj/goods.lpc");
	            ob->set("our_leader",me->query("id"));
    	    	    biaotou->set("goods",ob);
        	    ob->move(cart);
        
  	            ob=new(__DIR__"biaoshi");
    	            ob->move(environment());
        	    ob->set_leader(biaotou);
	            ob->set_temp("protecting",cart);
    	            biaotou->set("biaoshi",ob);
		    ob->set("owner",me);        

	            ob=new(__DIR__"biaoshi1");
    	            ob->move(environment());
        	    ob->set_leader(biaotou);
	            ob->set_temp("protecting",cart);
    	            biaotou->set("biaoshi1",ob);
		    ob->set("owner",me);        

	            ob=new(__DIR__"biaoshi1");
    	            ob->move(environment());
        	    ob->set_leader(biaotou);
	            ob->set_temp("protecting",cart);
    	            biaotou->set("biaoshi2",ob);
		    ob->set("owner",me);        
		    if(pointerp(member=me->query_team()))
		    {
		    	for(i=0;i<sizeof(member);i++)
		    	{
		    		if(member[i]==me) continue;
		    		member[i]->delete("yunbiao/start_point");
		    		member[i]->set("yunbiao/have_show");
		    		member[i]->set_temp("protecting",cart);
		    	}	
		    }
	            me->delete("yunbiao/start_point");
    	            me->set("yunbiao/have_show",1);
		    me->set_temp("protecting",cart);

   		    return 1;   
      		}
           } else return notify_fail("你想拿什么东西给谁看？\n");
 	}
    	else        command("say 这里可不是交货的地方! \n");

}
int finish_mission()
{       
	object me,kehu,*member; 
    	int i, k,temp,j; 
        object *inv,*mine,*yours,room;        
 
        kehu=this_object();
        me=this_player();
        room=environment();
	temp=0;

	if (room->query("my_point") == "风云城"||room->query("my_point") == "京城"
	    ||room->query("my_point") == "绮云镇"||room->query("my_point") == "宁远城"
	    ||room->query("my_point") == "扬州城"||room->query("my_point") == "金陵城"
	    ||room->query("my_point") == "泉州城"||room->query("my_point") == "襄阳城")
	{
	        if(me->query_team())
	        {
	        	if(!me->is_team_leader())
	        	{
	        		command("say 不要多嘴,叫你们队长和我说话");
	        		return 1;
	        	}	
	        }
	        if(me->query("yunbiao/end_point")!=kehu->query("my_point"))
	        {
			command("say 这不是我要的镖,你搞错了！ \n");
        		return 1;
            	}

                inv=all_inventory(environment(me));        

            	for (i=0;i<sizeof(inv);i++)
            	{
	        	if(inv[i]->query("owner")==me
		   	&&inv[i]->query("标记/运镖的镖车"))
			{
		        	temp=1;
                        	set_temp("cart",inv[i]);
		        	break;// 镖车就在跟前
			}
			else continue;
	    	}

            	yours=all_inventory(me);
            	for (i=0;i<sizeof(yours);i++)
            	{
            		if(yours[i]->query("our_leader")==me->query("id")
                  	&& me->query("yunbiao/end_point")==kehu->query("my_point")
                  	&& yours[i]->query("value")>1000000)
                  	{
                    		if (yours[i]->query("fail")=="fail")
                    		{
                    			command("say 虽然东西你带来了，但只能算将功补过\n");
                        		me->delete("yunbiao/mission_gived");
                        		if(me->query_team())//这个时候队伍运镖失败
                        		{
                        		        member=me->query_team();
                        			for(j=0;j<sizeof(member);j++)
                        			{
                        				if(member[i]!=me)
                        					member[j]->delete("yunbiao/mission_gived");
                        			}
                        		}
                        		destruct(yours[i]);
                        		return 1;
                    		}
                 		give_reward(me);
                 		destruct(yours[i]);
                 		return 1;
                 	}
            	}
	    	if(temp==0)
	    	{
        		command("say 你怎么搞的，东西哪里去了？还不去找!");
			return 1;
	    	}
	    	else
	    	{
                	mine=all_inventory(query_temp("cart"));
                	temp=0;

                	for (k=0;k<sizeof(mine);k++)
                	{
	           		if(mine[k]&&mine[k]->query("标记/运镖货物"))
	           		{
  	           		// 货物在镖车上面
	              			command("open silver cart");
                      			command("get "+mine[k]->query("id")+" from silver cart");
                      			destruct(mine[k]);
		      			temp=1;
		      			break;
                   		}
	           		else continue;
 	        	}
	        	if(temp==0)
	        	{// 镖车里面没有货物。
	            		command("say 你怎么搞的，镖车带来了。货物呢？你这个笨蛋！");
                    		dest_all_the_obj(me);
	    	    		return 1;
	        	}
	        	else  // 运镖成功了。
		    	{
		    		command("say 干得好！呵呵！");
		    		give_reward(me);//这个函数里面已经对队员进行了奖励
		    		dest_all_the_obj(me);
		    		return 1;
	       		}
	    	}
		return 1;
        }		
        else
    	    command("say 这里可不是交货的地方! \n");
}

int dest_all_the_obj(object me)
{
	object *obj;
	int i;
	obj=all_inventory(environment(this_object()));
	for(i=0;i<sizeof(obj);++i)
	{
		if(obj[i]->query("owner")==me)
			destruct(obj[i]);
		else	continue;
	}
	return 1;
}

void give_reward(object me)
{
	int c,p,i;
	object *member;
	string end_point;
    	
    	c= 1075+random(375)+(random(30)+10)*(me->query_temp("longroad"))+(random(30)+30)*(me->query_temp("robber"));
	p= 375+random(75)+(random(5)+3)*(me->query_temp("longroad"))+(random(6)+4)*(me->query_temp("robber"));
    	p +=me->query("yunbiao/运镖连续成功");
    	c +=me->query("yunbiao/运镖连续成功")*10;
    	
	end_point=me->query("yunbiao/end_point");
    	if(pointerp(member=me->query_team()))
    	{
    		for(i=0;i<sizeof(member);i++)
    		{
		    	
		    	if(member[i]!=me)
		    	{
		    		if(!stringp(member[i]->query("yunbiao/end_point"))) continue;
		    		//if(member[i]->query("yunbiao/end_point")!=me->query("yunbiao/end_point"))
		    	        //	continue;
		    	        //member[i]曾经申请过运镖,并且失败了,此时member[i]没有奖励
		    	        
		    	        if(member[i]->query("yunbiao/end_point")!=end_point) continue;
		    		
		    		member[i]->delete_temp("robber");
    				member[i]->delete_temp("longroad");
      				member[i]->add("yunbiao/运镖成功",1);
				member[i]->add("yunbiao/运镖连续成功",1);
				if(member[i]->query("yunbiao/运镖连续成功")>49)
        			{
        				if(member[i]->query("kar")<15)	member[i]->add("kar",1);
        				member[i]->add("yunbiao/运镖连续成功",-50);
        				member[i]->add("combat_exp",c*10+random(member[i]->query("kar"))+random(member[i]->query("combat_exp"))/100);
        				member[i]->add("potential",p*10+random(member[i]->query("kar")));
        				member[i]->add("kar",1);
        				command("say 连续五十次运镖都不出事，你运气真好！\n");
        			}
        			member[i]->add("combat_exp",c);
				member[i]->add("potential",p);
        			member[i]->delete("yunbiao/end_point");
        			member[i]->delete("yunbiao/start_point");
        			member[i]->delete("yunbiao/mission_gived");
        			member[i]->delete("yunbiao/have_show");
				tell_object(member[i],HIW
   					"这是你第"+chinese_number(member[i]->query("运镖/运镖成功"))+"次运镖成功！\n"+
        				"你被奖励了：\n" +
        				chinese_number(c) + "点实战经验\n"+
        				chinese_number(p) + "点潜能\n"NOR);

		    	}
		    	else
		    	{
		    		me->delete_temp("robber");
    				me->delete_temp("longroad");
      				me->add("yunbiao/运镖成功",1);
				me->add("yunbiao/运镖连续成功",1);
				if(me->query("yunbiao/运镖连续成功")>49)
        			{
        				if(me->query("kar")<15)	me->add("kar",1);
        					me->add("yunbiao/运镖连续成功",-50);
        				me->add("combat_exp",c*10+random(me->query("kar"))+random(me->query("combat_exp"))/100);
        				me->add("potential",p*10+random(me->query("kar")));
        				me->add("kar",1);
        				command("say 连续五十次运镖都不出事，你运气真好！\n");
        			}
        			me->add("combat_exp",c);
				me->add("potential",p);
        			me->delete("yunbiao/end_point");
        			me->delete("yunbiao/start_point");
        			me->delete("yunbiao/mission_gived");
        			me->delete("yunbiao/have_show");
				tell_object(me,HIW
   					"这是您第"+chinese_number(me->query("运镖/运镖成功"))+"次运镖成功！\n"+
        				"你被奖励了：\n" +
        				chinese_number(c) + "点实战经验\n"+
        				chinese_number(p) + "点潜能\n"NOR);
			}
		}	
    		return ;
    	}
    	me->delete_temp("robber");
    	me->delete_temp("longroad");
      	me->add("yunbiao/运镖成功",1);
	me->add("yunbiao/运镖连续成功",1);
	
	if(me->query("yunbiao/运镖连续成功")>49)
        {
        	if(me->query("kar")<15)	me->add("kar",1);
        	me->add("yunbiao/运镖连续成功",-50);
        	me->add("combat_exp",c*10+random(me->query("kar"))+random(me->query("combat_exp"))/100);
        	me->add("potential",p*10+random(me->query("kar")));
        	me->add("kar",1);
        	command("say 连续五十次运镖都不出事，你运气真好！\n");
        }
        me->add("combat_exp",c);
	me->add("potential",p);
        me->delete("yunbiao/end_point");
        me->delete("yunbiao/start_point");
        me->delete("yunbiao/mission_gived");
        me->delete("yunbiao/have_show");
	tell_object(me,HIW
   		"这是你第"+chinese_number(me->query("运镖/运镖成功"))+"次运镖成功！\n"+
        	"你被奖励了：\n" +
        	chinese_number(c) + "点实战经验\n"+
        	chinese_number(p) + "点潜能\n"NOR);
	return ;
}

int fail_mission()
{
	object me,kehu,room,*member;
        int c,p,i;
	
	me=this_player();
	kehu=this_object();
	room=environment();
	if (room->query("my_point") == "风云城"||room->query("my_point") == "京城"
  	||room->query("my_point") == "绮云镇"||room->query("my_point") == "宁远城"
  	||room->query("my_point") == "扬州城"||room->query("my_point") == "金陵城"
  	||room->query("my_point") == "泉州城"||room->query("my_point") == "襄阳城")	    
  	{
  		if(me->query("yunbiao/end_point")!=kehu->query("my_point"))
        	{
        		command("say 我没让你保镖啊??! \n");
        		return 1;
        	}
  		if(me->query_team()&&!me->is_team_leader())
  		{
  		//队伍必须由队长输入失败指令,玩家也可以将队伍解散,然后来这里输入失败指令
			command("say 不要多嘴,叫你们队长过来");
  			return 1;
  		}
  		if((me->query("potential")-me->query("learnd_point"))<1)
        		command("say 你还是去加加潜能才来放弃，我怕你不够赔！ \n");
     		else
        	{  
        		if(pointerp(member=me->query_team()))
        		{
				c=2000+random(2000);
				p=600+random(500);  
				for(i=0;i<sizeof(member);i++)
				{
					member[i]->add("yunbiao/运镖成功",-1); 
        				member[i]->set("yunbiao/运镖连续成功",0);
        				member[i]->delete("yunbiao/end_point");
        				member[i]->delete("yunbiao/start_point");
        				member[i]->delete("yunbiao/mission_gived"); 
        				member[i]->delete("yunbiao/have_show");
       					member[i]->add("combat_exp",-c);         
					if (member[i]->query("potential")-member[i]->query("learned_points")>0)
						member[i]->add("potential",-p);
					else
						member[i]->set("potential",member[i]->query("learned_points"));
				//       me->add("potential",-p);
	            			tell_object(member[i],HIW
        	    				"你被惩罚了：\n" +
             					chinese_number(c) + "点实战经验\n"+
             					chinese_number(p) + "点潜能\n"NOR);        			
        			}
        		        command("say 混蛋!这么多人都会把镖搞丢!真没用!\n");
        		        return 1;
        		}
        		me->add("yunbiao/运镖成功",-1); 
        		me->set("yunbiao/运镖连续成功",0);
        		me->delete("yunbiao/end_point");
        		me->delete("yunbiao/start_point");
        		me->delete("yunbiao/mission_gived"); 
        		me->delete("yunbiao/have_show");
            		c=2000+random(2000);
            		p=600+random(500);  
       			me->add("combat_exp",-c);         
			if (me->query("potential")-me->query("learned_points")>0)
				me->add("potential",-p);
			else
				me->set("potential",me->query("learned_points"));
			//       me->add("potential",-p);
       
            		tell_object(me,HIW
            			"你被惩罚了：\n" +
             			chinese_number(c) + "点实战经验\n"+
             			chinese_number(p) + "点潜能\n"NOR);
        		command("say 你真让我失望，我去找查猛赔钱!\n");
        	}
   	}   
  	else
   	{
 		command("say 对不起！在这里我无法帮你查帐! \n");
   	}
   	return 1;
}       
