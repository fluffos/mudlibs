#pragma save_binary
#include <ansi.h>
inherit ITEM;
void create()
{
switch(random(6))
  {
    case 0:
    set_name("千年寒玉", ({ "hanyu" })); 
    break;
    case 1:
    set_name("夜明珠", ({ "pearl" })); 
    break;
    case 2:
    set_name("碧玉西瓜", ({ "yuxigua" })); 
    break;
    case 3:
    set_name("火红珊瑚", ({ "shanhu" })); 
    break;
    case 4:
    set_name("天蚕丝", ({ "chansi" })); 
    break;
    case 5:
    set_name("鱼肠剑", ({ "yuchang" })); 
    break;
    }
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
              set("unit", "件");
set("long",  "这是一个价值连城的宝物！\n");
                set("value", random(1000000)+1000000);
		set("标记/运镖货物",1);
        }
	
	setup();
}

