#pragma save_binary
#include <ansi.h>
inherit F_AUTOLOAD;             // /feature/autolaod.c
inherit ITEM;
int seteuid();
void create() {
  set_name("金腰牌", ({ "gold_yaopai" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这是一块证明你镖师身份的腰牌\n"
      "你用它可以查看你的运镖情况(check_me)\n");
    set("value", 100);
    set("no_get", 1);
    set("no_drop", 1);
    set("material", "gold");
  }
}

int init() {
  add_action("do_check", "check_me");
}

int do_check() {
  object me;
  int i, j;
  me = this_player();
  i = me->query("yunbiao/运镖成功");
  j = me->query("yunbiao/运镖连续成功");
  if (me->query("yunbiao/start_point"))
    tell_object(me, "你现在要去" + me->query("yunbiao/start_point") + "找货主接货!");
  if (me->query("yunbiao/end_point"))
    tell_object(me, "你现在的目的地是去" + me->query("yunbiao/end_point") + "交割货物!\n");
  tell_object(me, "你已经运了" + chinese_number(i) + "次镖\n"
    "你现在连续运镖成功的次数是" + chinese_number(j) + "次\n");
  return 1;

}

int query_autoload() {
  return 1;
}
