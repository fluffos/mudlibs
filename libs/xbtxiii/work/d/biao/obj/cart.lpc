#pragma save_binary

inherit ITEM;

void create() {
  set_name("镖车", ({ "silver cart", "cart" }));
  set_weight(300000);
  set("no_get", 1);
  set("标记/运镖的镖车", 1);  //货主要用它辨别真伪
  set_max_encumbrance(80000000);
  set("unit", "辆");
  set("long", "一辆黑漆漆的镖车，上面插着金狮镖旗。\n");
  set("closed", 1);
  set("value", 2000);

}

int is_container() { return 1; }

void init() {
  add_action("do_open", "open");
  add_action("do_steal", "steal");
  add_action("do_close", "close");
  add_action("do_get", "get");
  add_action("do_look", "look");
}

int do_get(string arg) {
  object me;
  string from;
  me = this_player();
  if (userp(me))
    if (!arg) return 0;
  if (sscanf(arg, "%s from %s", arg, from) == 2) {
    if (from == "cart" || from == "silver cart") {
      tell_object(me, "你不能从这里面拿取东西。\n");
      return 1;
    }
  }

}
int do_close(string arg) {
  object me, ob;
  me = this_player();
  ob = this_object();
  if (arg != "cart" && arg != "silver cart")
    return notify_fail("你要关上什么？\n");
  message_vision("$N把$n门关上了。\n", me, ob);
  ob->set("closed", 1);
  return 1;
}

int do_open(string arg) {
  object me, ob;

  if (arg != "cart" && arg != "silver cart")
    return notify_fail("你要打开什么？\n");
  me = this_player();
  if (objectp(ob = present("biaotou", environment())))
    return notify_fail(ob->name() + "瞪了你一眼，你要干什么！\n");
  this_object()->set("closed", 0);
  message_vision("$N将$n盖打开。\n", me, this_object());
  return 1;
}

int is_closed() {
  return ((int)this_object()->query("closed"));
}
int do_look(string arg) {

  if (arg == "cart" || arg == "silver cart") {
    write("一辆黑漆漆的镖车，上面插着金狮镖旗。\n");
    return 1;
  }
  return 0;
}
int do_steal(string arg) {
  string str;
  if (sscanf(arg, "%s from %s", str, arg) == 2) {
    if (arg == "cart" || arg == "silver cart") {
      write("这东西可偷不得！偷了你就得死！\n");
      return 1;
    }
    return 0;
  }
  return 0;
}
