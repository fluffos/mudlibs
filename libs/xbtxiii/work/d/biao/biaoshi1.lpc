#pragma save_binary

inherit NPC;

void create() {
  set_name("趟子手", ({ "tang", "zhi" }));
  set("gender", "男性");
  set("age", 32);
  set("long", "这是一位体态轻盈的趟子手。\n");
  set("max_kee", 1000);
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("运镖人", 1);
  set_skill("unarmed", 130);
  set_skill("dodge", 180);
  set_skill("move", 1500);

  setup();
  add_money("silver", 50);
  carry_object("/d/fy/npc/obj/jinzhuang")->wear();
}
