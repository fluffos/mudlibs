#pragma save_binary
inherit NPC;
object cart;
void be_protect();
void to_rob();
void to_get();
void to_steal();
void create() {
  //        object ob;
  set_name("李镖头", ({ "biaotou" }));
  set("gender", "男性");
  set("运镖人", 1);
  set("age", 35);
  set("combat_exp", 100000);
  set("no_get_goods", random(4));
  set("attitude", "friendly");
  set("per", 10);
  set("chat_chance", 15);
  set("chat_msg", ({
    "李镖头喝道：“闲杂人等闪开了。”\n",
    "李镖头喝道：“快走快走，别偷懒！”\n",
  }));
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    "李镖头大喊道：“不好了，有人劫镖了。”\n",
    (: be_protect :),
  }));
  set_temp("no_arrest", 1);  //不准抓他. 
  set("max_kee", 1500);
  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 30);
  set_skill("blade", 50);
  set_skill("wuhu-duanmendao", 50);
  set_skill("force", 120);
  set_skill("parry", 250);
  set_skill("dodge", 180);
  set_skill("move", 1500);
  map_skill("blade", "wuhu-duanmendao");
  map_skill("parry", "wuhu-duanmendao");
  setup();
  add_money("silver", 50);
  carry_object("/d/fy/npc/obj/jinzhuang")->wear();
  carry_object("/obj/weapon/blade")->wield();
  carry_object("/obj/example/wineskin");

}
void be_protect() {
  int i, j, flag;
  object *inv, *enemy;

  inv = all_inventory(environment());
  enemy = query_enemy();
  // if one of the protectors wants to kill... then heis out of the loop
  for (j = 0; j < sizeof(enemy); j++)
    enemy[j]->delete_temp("protecting");

  for (i = 0; i < sizeof(inv); i++)
    if (inv[i]->query_temp("protecting") == this_object()->query("cart")) {
      flag = 1;
      for (j = 0; j < sizeof(enemy); j++) {
        inv[i]->kill_ob(enemy[j]);
        enemy[j]->kill_ob(inv[i]);
      }
    }
  if (!flag) return;
  message_vision("$N喊道：“你们给我上！”\n", this_object());

}

int follow_me(object ob, string dir) {
  int i;
  if (is_busy() && query_leader() == ob) {
    tell_object(ob, "镖车太重，我们走不了这么快！\n");
    return 0;
  }

  i = ::follow_me(ob, dir);
  if (i) {
    this_object()->query("cart")->move(environment());
    message_vision("镖车隆隆驶了过来。\n", this_object());
    if (ob->query_temp("longroad") < 100) ob->add_temp("longroad", 1);
    if (random(20) == 1) call_out("trouble", 1);
    start_busy(4);
  } else return 0;
  return 1;
}

int trouble() {
  switch (random(3)) {
    case 0:
      to_rob();
      break;
    case 1:
      to_get();
      break;
    case 2:
      to_steal();
      break;
  }
  return 1;
}
void to_rob() {
  int i;
  object robber;
  object ob;
  message_vision("忽然间跳出一群劫匪！\n", this_object());
  ob = query("owner");
  for (i = 0; i <= random(5) + 1; i++) {
    robber = new(__DIR__ "gangster");
    robber->move(environment());
    robber->set("combat_exp", 200000 + random(800000));
    robber->add("combat_exp", ob->query("运镖/运镖连续成功") * (40000 - ob->query("kar") * random(1500)));
    robber->add_temp("apply/attack", ob->query("运镖/运镖连续成功") + random(100) - ob->query("kar") * 3);
    robber->add_temp("apply/dodge", ob->query("运镖/运镖连续成功"), random(100) - ob->query("kar") * 3);
    robber->kill_ob(this_object());
    this_object()->kill_ob(robber);
    robber->set_leader(this_object());
    if (ob->query_temp("robber") < 30) ob->add_temp("robber", 1);
  }
  be_protect();
}


void to_get() {
  object room, mask, goods;
  string file, *roomlines;
  if (query("no_get_goods")) return;
  tell_room(environment(this_object()), "忽然你似乎听到一阵嘿嘿的笑声！\n");
  tell_room(environment(this_object()), "一个蒙面人出现在你的面前！\n");
  tell_room(environment(this_object()), "你还没明白是怎么回事，蒙面人就消失了。\n");
  tell_room(environment(this_object()), "李镖头突然大声喊了起来：镖不见了！！\n");
  tell_room(environment(this_object()), "李镖头；大家快去把镖找回来！\n");
  mask = new("/d/biao/mmren");
  file = read_file("/task/room_location");
  roomlines = explode(file, "\n");
  room = load_object(roomlines[random(sizeof(roomlines))]);
  mask->set("long", "抢了" + query("our_leader") + "镖的蒙面强盗！！\n ");
  mask->move(room);
  goods = this_object()->query("goods");
  if (goods)
    goods->move(mask);

  if (objectp(this_object()->query("biaoshi")))
    destruct(this_object()->query("biaoshi"));
  if (objectp(this_object()->query("biaoshi1"))) destruct(this_object()->query("biaoshi1"));
  if (objectp(this_object()->query("biaoshi2"))) destruct(this_object()->query("biaoshi2"));
  destruct(query("cart"));
  call_out("dest_biaotou", 1, this_object());
}
void to_steal() {
  if (this_object()->query("no_get_goods") != 3) return;
  call_out("thief", 25, environment(this_object()));
  this_object()->set("no_get_goods", 4);
}
void thief(object obj) {
  object mask;
  mask = new("/open/tony/biao/thief");
  this_object()->query("goods")->move(mask);
  mask->move(obj);
}
void die() {
  object killer;
  killer = query_temp("last_damage_from");
  if (killer && !userp(killer))
    //                 destruct(this_object()->query("cart"));
    if (objectp(this_object()->query("biaoshi"))) destruct(this_object()->query("biaoshi"));
  if (objectp(this_object()->query("biaoshi1"))) destruct(this_object()->query("biaoshi1"));
  if (objectp(this_object()->query("biaoshi2"))) destruct(this_object()->query("biaoshi2"));
  if (objectp(killer)) {
    if (objectp(this_object()->query("goods")))
      this_object()->query("goods")->set("fail", "fail");
    command("chat 镖银被" + killer->name() + "抢走了！");
    message_vision("$N打开镖车，搬走了其中的镖银！\n", killer);
  }
  ::die();
}

int heal_up() {
  // 清除别人抛弃的镖车。
  object me;
  //        int time;
  ::heal_up();
  me = this_object()->query("owner");

  if (!me) {
    destruct(this_object()->query("cart"));
    if (objectp(this_object()->query("biaoshi")))
      destruct(this_object()->query("biaoshi"));
    if (objectp(this_object()->query("biaoshi1")))
      destruct(this_object()->query("biaoshi1"));
    if (objectp(this_object()->query("biaoshi2")))
      destruct(this_object()->query("biaoshi2"));
    call_out("dest_biaotou", 1, this_object());
  }
  return 1;

}
void dest_biaotou(object me) {
  destruct(me);
}
