#pragma save_binary
inherit NPC;

void create()
{
        set_name("劫匪", ({ "gangster"}) );
        set("gender", "男性" );
        set("age", 32);
        set("str",55);
        set("long", "这是一个杀人如麻的劫匪！！\n");
        set("max_kee", 500);
        set("attitude", "heroism");
        set("shen_type",-1);
        set("atman", 500);
        set("max_atman", 600);
        set("mana", 600);
        set("max_mana", 600);
        set("force", 700);
        set("max_force", 700);
        set("force_factor", 50);
        set_skill("unarmed",90);
        set_skill("move", 120);
        set_skill("dodge", 100);
        set_skill("blade",145);
        set_skill("spring-blade",110);
        map_skill("blade", "spring-blade");
        set("chat_chance", 5);
        set("chat_msg", ({
                "打劫啦！！要命还是要钱！\n",
        }) );
        
        setup();
        add_money("coin", random(20)+10);
        carry_object("/obj/cloth")->wear();
        carry_object("/obj/weapon/blade")->wield();
}
