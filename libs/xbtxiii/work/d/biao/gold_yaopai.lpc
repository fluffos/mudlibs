#pragma save_binary
#include <ansi.h>
inherit F_AUTOLOAD;             // /feature/autolaod.c
inherit ITEM;
int seteuid();
void create()
{
 set_name("金腰牌", ({ "gold_yaopai" }));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
              set("unit", "块");
set("long",  "这是一块证明你镖师身份的腰牌\n");
                set("value", 100);
                set("no_get",1);
                set("no_drop",1);
                set("material", "gold");
        }
}

int query_autoload()
{ 
return 1;
}


