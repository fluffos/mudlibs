#pragma save_binary
// dtz.c

inherit NPC;

void create() {
  set_name("蒙面人", ({ "maskman" }));
  set("gender", "男性");
  set("age", 32);
  set("long", "一个蒙面人.\n");

  set("combat_exp", 10000);
  set("no_arrest", 1);
  set("attitude", "heroism");
  set_skill("unarmed", 200);
  set_skill("move", 200);
  set("env/wimpy", 150);
  set_skill("parry", 200);
  set_skill("dodge", 200);
  set_skill("move", 200);
  set("chat_chance", 15);
  set("chat_msg", ({
    (: random_move :)
  }));

  setup();
  add_money("silver", 1);
  carry_object("/obj/cloth")->wear();

}
