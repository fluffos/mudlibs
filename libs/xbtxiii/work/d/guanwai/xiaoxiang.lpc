// /guanwai/xiaoxiang.c

inherit ROOM;

void create()
{
	set("short", "小巷");
	set("long",
"这是一个僻静幽深的小巷，四周寂静无声，一个人影也没有。长\n"
"长的石板路上落了一层厚厚的积雪，踩在脚下发出“咯吱”的响\n"
"声。小巷的尽头有一座土屋。\n"
);
	set("exits", ([
		"south" : __DIR__"tuwu",
		"east"  : __DIR__"beicheng",
	]));
	set("no_clean_up", 0);
	set("outdoors", "guanwai");
	setup();
	replace_program(ROOM);
}

