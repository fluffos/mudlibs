// /guanwai/xuedi2.c

inherit ROOM;

void create()
{
	set("short", "雪地");
	set("long",
"这里是一片白茫茫的雪地，一眼望不到边际。四周一个人影也没\n"
"有，厚厚的积雪踩起来发出咯吱的响声，大地上留下一串孤独的\n"
"脚印。寒冷的北风呼啸而过，吹得脸生痛。暗淡的太阳低悬在天\n"
"边，显得那么苍白。\n"
);
	set("exits", ([
		"east"       : __DIR__"xuedi3",
		"southwest"  : __DIR__"xuedi1",
	]));
	set("no_clean_up", 0);
	set("outdoors", "guanwai");
	setup();
//	replace_program(ROOM);
}
int valid_leave(object me, string dir)
{
	me->receive_damage("qi",30);
	me->receive_wound("qi",30);
	tell_object(me,"一股刺骨的寒风吹过，你只觉得浑身的血液都快被冻住了！\n");
	return 1;
}
