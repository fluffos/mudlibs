// /guanwai/tianchi1.c

inherit ROOM;

void create() {
  set("short", "白头山天池");
  set("long",
    "“天池在长白山巅中心点，群峰环抱，离地高约二十里，故名天\n"
    "池。”天池碧波盈盈，清澈湛蓝。湖周围峭壁百丈，峰影云影倒\n"
    "映其中，湖光山色、岚影云天十分诱人。湖岸周遭芳草茵茵，百\n"
    "花吐艳。古人诗云：“周迥八十里，峭壁立池边。水满疑天池，\n"
    "云低别有天。江山宜漫画，鹿逐结前缘。予卜携书隐，遨游慰晚\n"
    "年。”\n"
  );
  set("exits", ([
    "south": __DIR__ "tianchi2",
    "northup": __DIR__ "longmen",
    "westup": __DIR__ "baiyun",
    "eastup": __DIR__ "huagai",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "guanwai");
  setup();
}
