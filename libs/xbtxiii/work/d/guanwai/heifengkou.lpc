// /guanwai/xiaotianchi.c

inherit ROOM;

void create() {
  set("short", "黑风口");
  set("long",
    "这里是密林中的险恶之境周围是为茂密的松林，不见天光。林中\n"
    "传来野兽饥饿之极的嘶吼。四处有不知名的草菰和野果，可你一\n"
    "点也不敢尝尝。林木幽暗深邃，似乎暗藏杀机。你到了此处，心\n"
    "胆俱裂，只想快点离开。\n"
  );
  set("exits", ([
    "east": __DIR__ "xiaotianchi",
    "westdown": __DIR__ "milin3",
  ]));
  set("objects", ([
    __DIR__ "npc/bear": 1,
  ]));
  setup();
}
