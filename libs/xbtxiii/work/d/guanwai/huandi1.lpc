// /guanwai/huandi1.c

inherit ROOM;

void create() {
  set("short", "荒路");
  set("long",
    "这是城东的一条荒路，路旁杂乱的长着齐膝的荒草，远近荒无一\n"
    "人。两旁干枯的老树上落满了成群的乌鸦，凄凉的鸣叫声在荒野\n"
    "上远远传去，一派凄凉的景象。\n"
  );
  set("exits", ([
    "southwest": __DIR__ "dongcheng",
    "northeast": __DIR__ "huandi2",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "guanwai");
  setup();
  replace_program(ROOM);
}
