#pragma save_binary
// gangzhang.c 钢杖
#include <ansi.h>

#include <weapon.h>
inherit STAFF;

void create()
{
    set_name("蛇头玉杖", ({ "shetou zhang","zhang" }));
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "根");
        set("long", "这是一根翡翠绿色的玉杖，乃是一位高人给欧阳峰的武器。
杖上有两个可怖的蛇头，让人感觉到一丝丝寒气。\n");
		set("value", 5000);
		set("rigidity",100);
            set("material", "steel");
		set("wield_msg", "$N抽出一根$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回腰间。\n");
	}
  	init_staff(70);
	setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
                        int damage;  
if (me->query_skill_mapped("staff")!="lingshe-zhangfa") return;
                        damage = me->query("force")/20+1- victim->query_skill("literate",1);
if (me->query_skill_mapped("force")!="huagong-dafa") damage=damage+me->query("force")/20;
                        if(damage<1) damage=1;
                        victim->receive_damage("gin", damage);

     return HIR "蛇头杖上的蛇丝丝地吐着信，扰乱了$n的注意！\n" NOR;
}

