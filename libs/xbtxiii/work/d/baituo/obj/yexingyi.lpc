#pragma save_binary
//baipao.c
#include <armor.h>

inherit CLOTH;

void create()
{
    set_name("夜行衣", ({"yexing yi", "cloth"}) );
    set_weight(2000);
    if( clonep() )
       set_default_object(__FILE__);
    else {
	set("unit", "件");
        set("long", "这是件夜行人专用的夜行衣。\n");
	set("material", "cloth");
    set("armor_prop/armor", 20);
     set("armor_prop/dodge", 3);
        set("value",10000);
    }
    setup();
}
