#pragma save_binary
//shenshe.c
#include <ansi.h>
inherit ITEM;
void create()
{
	set_name("引路神蛇", ({ "shenshe"}));
	set_weight(100);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一条有识路能力的神蛇，可以把主人带到白
		      驼山。(玩家键入home即可)\n");
		set("unit", "条");
		set("value", 0);
                set("can_use", 10);
	}
}
void init()
{
 add_action("do_home","home");
}

int do_home()
{
    object me;
    me = this_player();
    if(me->is_fighting()||me->is_ghost())
        return notify_fail("你现在无法使用引路神蛇。\n");
   message_vision("$N从怀中掏出「引路神蛇」，口里不知念了些什么，\n
   就见「引路神蛇」吐吐芯子，摇头摆尾地把$N往白驼山带去￣￣￣\n",me);
   me->move("/d/baituo/damen");
   add("can_use",-1);
   if (query("can_use")==0)
   {
      tell_object(me,HIC"神蛇由于过度劳累而死去了。\n"NOR);
      destruct(this_object());
   }
   return 1;
}
