#pragma save_binary
// shedangao.c
inherit ITEM;
void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("蛇胆膏", ({ "shedan gao", "gao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这是珍贵补品『蛇胆膏』。\n");
    set("value", 100);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if ((me->query("max_jin") >= 350) || (me->query("max_kee") >= 450) || (me->query("max_sen") >= 450))
    return notify_fail("你吃『蛇胆膏』已无效用！\n");
  if (me->query("max_jin") < 250) {
    me->add("max_jin", 5);
    me->add("eff_jin", 5);
    me->add("jin", 9);
    me->add("max_kee", 5);
    me->add("eff_kee", 5);
    me->add("kee", 10);
    me->add("max_sen", 5);
    me->add("eff_sen", 5);
    me->add("sen", 5);
  } else {
    me->add("max_jin", 3);
    me->add("eff_jin", 3);
    me->add("jin", 5);
    me->add("max_kee", 3);
    me->add("eff_kee", 3);
    me->add("kee", 5);
    me->add("max_sen", 3);
    me->add("eff_sen", 3);
    me->add("sen", 5);
  }
  message_vision("$N吃下一块蛇胆膏，顿觉一股浩荡真气直涌上来，
	精，气大增...\n", me);
  destruct(this_object());
  return 1;
}
