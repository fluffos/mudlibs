#pragma save_binary
#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
void create() {
  set_name("记录编辑器", ({ "markedit" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一个巫师专用的记录编辑器！\n");
    //                set("no_get",1);
    //                set("no_drop",1);
    set("value", 5000);
    //                set("no_give",1);
  }
}
int init() {
  object me;
  me = this_player();
  add_action("do_mark", "mark");
}

int do_mark(string arg) {
  object ob;
  string obj, arg1, arg2, mark;
  int a;
  if (!arg) return notify_fail("例如: mark tiandi no_arrest 1 temp\n");
  if (sscanf(arg, "%s %s %d %s", obj, arg1, a, arg2) != 4)
    return notify_fail("例如: mark tiandi no_arrest 1 temp\n");
  ob = find_living(obj);
  if (!ob) return notify_fail("你要帮谁改什么记录？\n");
  if (!present(ob, environment(this_player())))
    return notify_fail("这里没有这个人！\n");
  if (!arg1) return notify_fail("你要在$n身上做什么记号？\n", ob);
  if (arg2 == "temp") {
    tell_object(this_player(), "你帮" + ob->name(1) + "设了" + arg1 + "临时记录为" + a + "！\n", ob);
    this_object()->set("domark", arg1);
    mark = this_object()->query("domark");
    ob->set_temp(mark, a);
    this_object()->delete("domark");
    return 1;
  }
  if (arg2 == "turn") {
    ob->set(arg1, a);
    write("你帮" + ob->name(1) + "设了" + arg1 + "记录为" + a + "！\n");
    return 1;
  }
  if (arg2 == "skill") {
    ob->set_skill(arg1, a);
    write("你帮" + ob->name(1) + "设了武功" + arg1 + "为" + a + "级！\n");
    return 1;
  }
  return notify_fail("例如: mark tiandi no_arrest 1 temp\n");
}
