#pragma save_binary
//wuqiku.c

inherit ROOM;

void create()
{
        set("coor",({-3680,980,60}));
	set("short", "武器库");
        set("long",
"这里是『白驼山』弟子的武器库，『白驼山』弟子可以到此拿取\n"
"练功用的各种武器。不过别派弟子是不允许进来的。\n"
);
        set("exits", ([
                "east" : __DIR__"yuanzi",
        ]));
    set("objects",([
        __DIR__"npc/shiwei" : 1,
      ]));
        setup();
        replace_program(ROOM);
}






