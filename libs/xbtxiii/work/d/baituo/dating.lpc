#pragma save_binary
//ROM dating

inherit ROOM;

void create() {
  set("coor", ({ -3650, 1000, 100 }));
  set("short", "大厅");
  set("long",
    "这是『白驼山庄』的大厅，内部摆设极尽豪华，当中一张黑色檀\n"
    "木条案，上面陈放着精美的花瓶和一些珍贵的瓷器，四壁挂满名\n"
    "家的字画。\n"
  );
  set("valid_startroom", 1);

  set("exits", ([
    "north": __DIR__ "liangong",
    "southdown": __DIR__ "yuanzi",
  ]));

  set("objects", ([
    __DIR__ "npc/ouyangfeng": 1,
    __DIR__ "npc/yahuan": 2,
  ]));
  setup();

  // "/clone/board/baituo_b"->foo();

}
