#pragma save_binary
// smith.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("铁匠", ({ "tiejiang", "smith" }));
	set("shen_type", 1);

        set("gender", "男性" );
        set("age", 33);
        set("long", "铁匠正用汗流浃背地打铁。\n");

        set("combat_exp", 500);
    set("where", "xiyu");
	set("attitude", "friendly");
        set("vendor_goods",([
          "/d/baituo/obj/dadao":10,
//                 "tiezhang":  "/d/baituo/obj/tiezhang",
        ]));

	setup();

}

void init()
{
        add_action("do_vendor_list", "list");
}

