#include <ansi.h>

inherit NPC;
inherit F_MASTER;

mixed change_master(mixed arg);
mixed change_master(mixed arg)

{
   object me;
   me = this_player();
   if( (string)me->query("family/family_name")!="白驼山派")
   {
   tell_object(me,"欧阳锋怒道:非我门弟子,我不能为你推荐,滚!.\n");
    return 1;
    }
if(me->query("combat_exp") <= 100000) {
tell_object(me,"欧阳锋对"+me->query("name")+"叹道:你的功夫还不够,再学多点才去拜老仙为师吧!\n");
   return 1;
   }
tell_object(me,"欧阳锋沉吟了一会,对"+me->query("name")+"说道:去吧.以后行走江湖时小心那些所谓的正人君子. \n");
  me->create_family("星宿派",3,"弟子");
   return 1;
}
void create()
{
	set_name("欧阳锋", ({ "ouyang feng", "ouyang", "feng" }));
	set("long", "他是白驼山庄主，号称“西毒”的欧阳锋。\n"
		   +"由于习练「九阴真经」走火入魔，已变得精\n"
		   +"神错乱，整日披头散发。\n");
	set("title", "老毒物");
	set("gender", "男性");
	set("age", 53);
	set("nickname", HIR "西毒" NOR);
	set("shen_type",-1);
	set("attitude", "peaceful");

	set("str", 30);
	set("int", 29);
	set("con", 30);

	set("kee", 2500);
	set("max_kee", 2500);
	set("gin", 900);
	set("max_gin", 900);
	set("force", 2000);
	set("max_force", 2000);
	set("force_factor", 50);

	set("combat_exp", 1500000);

	set_skill("force", 200);
	set_skill("unarmed", 150);
	set_skill("dodge", 150);
	set_skill("parry", 150);
	set_skill("staff", 150);
	set_skill("hamagong", 150);
	set_skill("chanchu-bufa", 150);
	set_skill("shexing-diaoshou", 150);
	set_skill("lingshe-zhangfa", 150);

	map_skill("force", "hamagong");
	map_skill("dodge", "chanchu-bufa");
	map_skill("unarmed", "shexing-diaoshou");
	map_skill("hand", "shexing-diaoshou");
	map_skill("parry", "lingshe-zhangfa");
	map_skill("staff", "lingshe-zhangfa");

        set("inquiry", ([
              "拜丁春秋" :(: change_master :),
              ]) );
//    create_family("白驼山派",1, "开山祖师");
        set("chat_chance",2);
        set("chat_msg",({
         "欧阳锋自言自语道：何日白驼山派才能重霸江湖呢…\n",
         "欧阳锋道：我儿欧阳克必能够重振白驼山派雄风！\n",
         "欧阳锋道：江湖险恶，困难重重哪！\n",
        }));
	setup();
    carry_object("/d/baituo/obj/shezhang")->wield();
    carry_object("/d/baituo/obj/chanchu_book");
    carry_object("/d/baituo/obj/yexingyi")->wear();
	add_money("silver",500);
 
}

void attempt_apprentice(object ob)
{
  if((int)ob->query("combat_exp")<100000)
        {
          message_vision("欧阳锋对$N笑道：你的经验太低了,我还不能收你！\n",ob);
	return ;
         }
   message_vision("欧阳锋拍拍$N的头，微微点了点头。\n",ob);
   command("recruit " + ob->query("id"));
   return;
}

