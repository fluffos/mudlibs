#pragma save_binary
// Room: /d/oldpine/cliff1.c
// jackii在此加了个山洞(97.3.24)

inherit ROOM;

void create() {
  set("coor", ({ 3600, 3900, 0 }));
  set("short", "山壁上的窄穴");
  set("long",
    "你现在正栖身在一个山壁上勉强足以容纳一个人休息的□穴中，\n"
    "从这里无论是要往上爬或往下爬都有一段不算短的距离，最好先\n"
    "歇一歇，喘口气再走，这时你注意到附近有一个山洞(hole)，里\n"
    "面发出一阵奇怪的声音。\n"
  );

  set("item_desc", ([
    "hole": @TEXT
一个看上去很大的洞口，大概可以爬进去，要试试吗？
TEXT
  ]));

  set("outdoors", "oldpine");

  setup();
}

void init() {
  add_action("do_climb", "climb");
  //        add_action("do_crawl","crawl");
}

int do_climb(string arg) {
  if (!arg || (arg != "up" && arg != "down"))
    return notify_fail("你要往上(up)爬还是往下爬(down)？\n");

  if (arg == "up") {
    message_vision("$N试了试脚边的岩石稳不稳，开始小心翼翼地往上攀爬。\n",
      this_player());
    this_player()->move(__DIR__ "cliffside");
  } else if (arg == "down") {
    message_vision("$N试了试脚边的岩石稳不稳，开始小心翼翼地往山涧中攀了下去。\n",
      this_player());
    this_player()->move(__DIR__ "riverbank1");
  }
  return 1;
}

int do_crawl(string arg) {
  object me;
  me = this_player();
  if (arg != "hole") return 0;
  message_vision("$N摒住呼吸，小心奕奕地沿着山洞向里爬去。\n", me);
  me->move("/u/j/jackii/cave");
  tell_room("/u/j/jackii/cave", me->name() + "从外面爬进来。\n");
  return 1;
}
