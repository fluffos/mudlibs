#pragma save_binary
// Room: /d/oldpine/riverbank1.c
#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("coor", ({ 3600, 3850, -10 }));
  set("short", "山涧之中");
  set("long",
    "你现在正站在一条山涧中的岩石上，几股泉水正从你脚边流过，\n"
    "水花溅得四处飞散，南边是一个深不见底的水潭(lake)，两边的\n"
    "山壁看起来又高又陡，看来要爬上岸边实在很不容易，你的北方\n"
    "有一座小石桥高高地跨过两边的山壁，可是桥的高度太高，即使\n"
    "是轻功绝顶的高手也跃不上去。\n"
  );
  set("item_desc", ([
    "lake": "这是一个死水潭，潭水已经发绿，散发出阵阵的腥味。
潭底深处有几个黑影晃动，你真想下去(dive)看看。\n"
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "riverbank2",
    "south": __DIR__ "lake",
    //     "swim":__DIR__"riverbuttom",/*by rong*/
  ]));
  set("outdoors", "oldpine");
  set("resource/water", 1);

  setup();
  //         replace_program(ROOM);
}
void init() {
  add_action("do_dive", "dive");
}
int do_dive(string arg) {
  object me, room;
  me = this_player();
  this_player()->move("/d/oldpine/riverbuttom");
  //  room=environment(this_object());
  message_vision("扑通一声，$N跳下臭熏熏的死水潭了，真傻。\n", me);
  // tell_room(room,"扑通一声，$N跳下臭熏熏的死水潭了，真傻。\n");
  return 1;
}
