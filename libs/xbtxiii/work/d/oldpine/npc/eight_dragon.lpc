#pragma save_binary
// tao_2.c

#include <ansi.h>
inherit NPC;

void create() {
  set_name(RED "八部天龙" NOR, ({ "dragon" }));
  set("gender", "女性");
  set("age", 3000);
  set("long", "一只非常可怕的怪兽!\n"
  );
  set("combat_exp", 5000000);
  set("max_kee", 5000);
  set("max_sen", 500);
  set("max_gin", 1000);
  set("str", 500);
  set("per", 100);
  set("force", 200);
  set("max_force", 250);
  set("force_factor", 5);
  set("atman", 1000);
  set("max_atman", 1000);

  set("mana", 1000);

  set("max_mana", 1000);
  set("mana_factor", 150);
  set("attitude", "aggressive");
  set("chat_chance", 25);

  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: command("say 好久没有吃到这么新鲜的人肉了！你来的正好！") :),
    (: command("say 看来想吃这人肉还真不容易。。") :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
  }));

  set_skill("magic", 100);
  set_skill("force", 100);
  set_skill("spells", 100);
  set_skill("unarmed", 150);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("gouyee", 100);

  set_skill("taoism", 50);
  set_skill("necromancy", 100);

  map_skill("spells", "necromancy");

  set_temp("apply/dodge", 500);
  set_temp("apply/armor", 100);
  setup();

  add_money("gold", 150);

}
int is_zombie() {
  return 1;
}
