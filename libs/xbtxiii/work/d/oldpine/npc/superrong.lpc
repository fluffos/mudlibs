#pragma save_binary
// tao_2.c

#include <ansi.h>
inherit NPC;

void create()
{
  set_name(HIY"火云邪神变态版"NOR, ({ "evilgod-turnsex" }) );
        set("gender", "男性");
     set("age",3000);
        set("long",
                
"这是因和蓉蓉相处久了而变成变态的火云邪神.\n"
);
       set("shen_type",-1);
  set("combat_exp", 2500000);
     set("score",200000);
   set("max_kee", 5000);
    set("max_sen", 500);
      set("max_gin", 1000);

    set("str",100);
        set("int", 10);
        set("cor", 30);
        set("cps", 30);
        set("spi", 20);
    set("per", 9);
	set("con", 30);
        set("pursuer", 1);
     set("force", 200);
    set("max_force", 250);
        set("force_factor", 5);

  set("atman", 1000);
  set("max_atman", 1000);

    set("mana", 1000);

    set("max_mana", 1000);
      set("mana_factor", 30);
	set("attitude","aggressive");
        set("chat_chance", 25);

        set("chat_chance_combat", 70);
        set("chat_msg_combat", ({
                (: command("say 好久没有吃到这么新鲜的人肉了！你来的正好！"):),
             	(: command("say 看来想吃这人肉还真不容易。。"):),
   (: command("火魔发出一阵怪叫：superapollo....!#!$@%"):),
		(: cast_spell, "drainerbolt" :),
                (: cast_spell, "netherbolt" :),
                (: cast_spell, "feeblebolt" :),
                (: cast_spell, "invocation" :),
                (: command("cast animate on corpse") :),
                (: command("cast animate on corpse") :),         
        }) );

      set_skill("magic", 100);
      set_skill("force", 100);
      set_skill("spells", 100);
    set_skill("unarmed",200);
      set_skill("parry", 150);
   set_skill("dodge",350);
      set_skill("gouyee", 100);

        set_skill("taoism", 50);
      set_skill("necromancy", 100);

        map_skill("spells", "necromancy");

      set_temp("apply/dodge", 100);
   set_temp("apply/armor", 100);
     set_temp("apply/armor", 100);
        setup();

        add_money("gold", 3);

}
int is_zombie()
{
	return 1;
}
