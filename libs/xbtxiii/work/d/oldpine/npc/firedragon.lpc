#pragma save_binary
 // red_dragon.c

inherit NPC;

void create()
{
set_name("红鳞火龙", ({ "firedragon","dragon" }) );
	set("long",
         "一只浑身长满红鳞的龙，\n");

	set("race", "野兽");
	set("age", 600);
	set("attitude", "aggressive");
//       set("shen_type",-1);

set_weight(60000);
    set("max_gin", 2000);
      set("max_kee", 3500);
      set("max_sen", 1200);

   set("str",30);
	set("cor", 200);
	set("cps", 30);
	set("spi", 70);
	set("int", 20);
        set("con",50);
	set("limbs", ({ "头部", "身体", "前爪", "後爪", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );

 set_temp("apply/attack", 150);
     set_temp("apply/dodge", 180);
     set_temp("apply/armor", 55);
          set_temp("apply/damage", 40);
        set_temp("apply/armor_vs_fire", 40);
      set("combat_exp", 2000000);
	setup();
        add_money("gold",5);
}
void die()
{
        object player;                
        player=query_temp("last_damage_from");
if(objectp(player))
        player->add("fealty",30);

                ::die();
}

