#pragma save_binary
// Room: /d/oldpine/riverbank2.c

inherit ROOM;

int do_climb(string arg);
void create() {
  set("coor", ({ 3600, 3900, -10 }));
  set("short", "山涧之中");
  set("long",
    "你现在正站在一条山涧中的岩石上，一座小石桥正高高地从你的\n"
    "头顶横跨过山涧两边的石壁(cliff)，一个瀑布就在你的北方不\n"
    "远处，从一处更高的悬崖上垂了下来。\n"
  );
  set("item_desc", ([
    "cliff":
    "这里的山壁比北边高度稍低了点，但是对凡人而言想要爬(climb)上去，"
    "还有一段差距的。\n"
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "north": "/d/oldpine/waterfall",
    "south": "/d/oldpine/riverbank1",
  ]));
  set("outdoors", "oldpine");
  set("resource/water", 1);

  setup();
}

void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  if (!arg || (arg != "up" && arg != "cliff"))
    return notify_fail("你要爬什么？\n");

  message_vision("$N试了试脚边的岩石稳不稳，开始小心翼翼地往上攀爬。\n",
    this_player());
  this_player()->move(__DIR__ "cliff1");

  return 1;
}
