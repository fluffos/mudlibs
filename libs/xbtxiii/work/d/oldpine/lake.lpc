inherit ROOM;

void create()
{
        set("coor",({3600,3800,-10}));
	set("short", "水潭");
        set("long",
"你现在正站在一个深不见底的水潭边上，从潭底不时有气泡冒上\n"
"来，散发著一股诡异的香味，水潭边长满了黄色叶子的怪草，四\n"
"周陡峭的山壁近乎直立，抬头只见一个半圆形的天空，唯一的出\n"
"路大概只有往北山泉流入水潭的缺口。\n"
);
        set("exits", ([ /* sizeof() == 1 */
  "north" : "/d/oldpine/riverbank1",
]));
        set("objects", ([ /* sizeof() == 1 */
  "/d/oldpine/npc/serpent" : 1,
]));
        set("resource/water", 1);
        setup();
        replace_program(ROOM);
}
