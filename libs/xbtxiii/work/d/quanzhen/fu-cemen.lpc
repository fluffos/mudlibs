// fu-cemen 富家侧门
// By Lgg,1998.10

inherit ROOM;

void create() {
  set("coor", ({ 1030, -300, 0 }));
  set("short", "富家侧门");
  set("long",
    "这里是一道小门，可能是由于怕进出不方便而修建的。门虽然小，\n"
    "但还修饰得人模人样，门上嵌着两个大铜环。几条大狼狗懒洋洋\n"
    "躺在门边，一看见有人进来就‘汪汪’地乱吠。出了门就是武功\n"
    "镇的南街了，进门后是富家的小院。\n"
  );
  set("exits", ([
    "northwest": __DIR__ "nanjie",
    "east": __DIR__ "fu-xiaoyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/wolfdog": 2,
  ]));
  setup();
}
