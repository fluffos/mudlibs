// ximen.c 西门
// By Lgg,1998.10

inherit ROOM;

void create() {
  set("coor", ({ 1150, -260, 0 }));
  set("coor", ({ 900, -260, 0 }));
  set("short", "西门");
  set("long",
    "这里是武功镇的西门，眼前城墙高耸，墙上的箭垛里好象还有人\n"
    "走来走去。阳光照来，城墙上闪过几道白光，似乎是兵器反射出\n"
    "的光。城门上题着‘西门’两个大字，门口站着一些官兵，正手\n"
    "持兵刃盘问着来往的行人们。从这里折而向北，就是终南山脚了。\n"
  );
  set("outdoors", "quanzhen");
  set("exits", ([
    "east": __DIR__ "xijie",
    "west": __DIR__ "guandao1",
    "northeast": __DIR__ "shanlu1",
  ]));

  set("objects", ([
    __DIR__ "npc/wujiang": 1,
    __DIR__ "npc/bing": 2,
  ]));
  setup();
}
