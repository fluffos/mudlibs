// Room: /d/quanzhen/jnroad8.c

inherit ROOM;

void create() {
  set("short", "莽林边缘");
  set("long",
    "四周古树参天，荆棘密布。浓密宽厚的树叶遮蔽了日月星辰，使\n"
    "人分不出昼夜。四下如死一般的寂静，只有风吹过树梢的沙沙之\n"
    "声。偶尔一两声虎啸狼嚎随着腥风飘至耳际。\n"
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "northeast": __DIR__ "jnroad7",
    "south": __DIR__ "jnroad9",
  ]));

  setup();
  replace_program(ROOM);
}
