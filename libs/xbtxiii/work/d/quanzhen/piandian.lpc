#include <ansi.h>
inherit ROOM;

void create() {
  set("coor", ({ 1200, 150, 340 }));
  set("short", "偏殿");
  set("long",
    "这里是大堂旁边的一个侧厅，也是接待重要客人的地方。厅不大，\n"
    "只摆放着一张桌子和几把椅子。桌上摆放着一盆青山隐隐的盆景，\n"
    "墙壁上挂着一些字画。\n"
  );
  set("exits", ([
    "east": __DIR__ "nairongdian",
    "west": __DIR__ "xianzhentang",
    "north": __DIR__ "datang2",
    "south": __DIR__ "guangning",
  ]));
  set("objects", ([
    __DIR__ "npc/shen": 1,
  ]));
  //        set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
