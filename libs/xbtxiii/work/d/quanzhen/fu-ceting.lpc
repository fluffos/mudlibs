// fu-ceting 侧厅
// By Lgg,1998.10

inherit ROOM;

void create() {
  set("coor", ({ 1070, -320, 0 }));
  set("short", "侧厅");
  set("long",
    "这是正堂旁边的一间小厅，本来是用作书房的，只是侯员外家实\n"
    "在找不出多少书来装点门面，所以就整治成了招待熟客的地方。\n"
    "厅中摆放着一张八仙桌和几把椅子，桌上刚沏好的茶还在冒着热\n"
    "气。\n"
  );
  set("exits", ([
    "west": __DIR__ "fu-datang",
    "north": __DIR__ "fu-huating",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
