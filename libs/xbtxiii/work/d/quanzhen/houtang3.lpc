#include <ansi.h>
inherit ROOM;

void create() {
  set("coor", ({ 1400, 200, 340 }));
  set("short", "后堂三进");
  set("long",
    "这里是全真教弟子演练武功的地方。全真教弟子众多，所以每逢\n"
    "每月的十五这天，就召集所有弟子来这里切磋武功，一方面检验\n"
    "弟子们的武功长进，另一方面选拔人才担任教中的重要职务。现\n"
    "在还不到演武的日子，堂中空无一人。\n"
  );
  //        set("no_clean_up", 0);
  set("exits", ([
    "east": __DIR__ "jingxiushi",
    "west": __DIR__ "houtang2",
    "northeast": __DIR__ "xiaohuayuan1",
  ]));
  set("objects", ([
    __DIR__ "npc/wangzhi": 1,
  ]));

  setup();
  replace_program(ROOM);
}
