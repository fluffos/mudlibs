// wuchang2.c 武场
// By Lgg,1998.10

#include <ansi.h>
inherit ROOM;

void create() {
  set("coor", ({ 1400, 100, 340 }));
  set("short", "武场");
  set("long",
    "这里是全真教的演武场，地下的青砖本来铺的整整齐齐，却不知\n"
    "道被谁踩出了几十个大大小小的凹坑。看的出来，这里成年累月\n"
    "的有弟子修炼掌法步法，天长日久，地下就踩出了凹坑。武场中\n"
    "央立着几个练功用的木人。\n"
  );
  set("outdoors", "quanzhen");
  set("exits", ([
    "north": __DIR__ "wuchang1",
    "east": __DIR__ "xiuxishi",
    "southeast": __DIR__ "shantang",
  ]));

  set("objects", ([
    __DIR__ "npc/mu-ren": 4,
  ]));

  setup();
  replace_program(ROOM);
}
