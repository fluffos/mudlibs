#include <ansi.h>
inherit ROOM;

void create()
{
        set("coor",({1350,300,340}));
	set("short", "禅房");
        set("long",
"这里是全真教弟子摆放兵器的禅房，地下杂乱地堆着一些剑，有\n"
"的已经锈纹斑斑了，有的还是锋利透亮，全真弟子练功的时候，\n"
"就到这里来挑选兵刃。\n"
);
        set("exits", ([
                "east" : __DIR__"chanfang2",
        ]));
        set("objects", ([
                __DIR__"npc/obj/gangjian" : random(3),
                __DIR__"npc/obj/gangdao" : random(2),
                __DIR__"npc/obj/tiejia" : random(2),
        ]));

        setup();
        replace_program(ROOM);
}
