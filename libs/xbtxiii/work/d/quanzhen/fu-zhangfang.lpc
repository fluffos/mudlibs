inherit ROOM;

void create() {
  set("coor", ({ 1040, -320, 0 }));
  set("short", "帐房");
  set("long",
    "这里是侯员外家的帐房。屋内青砖铺地，进门处横摆着一张桌子，\n"
    "一个管家正坐在桌后，小眼睛不住地跟着你转，好象又在打什么\n"
    "坏主意。\n"
  );
  set("exits", ([
    "east": __DIR__ "fu-datang",
  ]));
  set("objects", ([
    __DIR__ "npc/guanjia": 1,
  ]));

  setup();
  replace_program(ROOM);
}
