// fu-houyuan.c 后院
// By Lgg,1998.10

inherit ROOM;

void create() {
  set("coor", ({ 1050, -340, 0 }));
  set("short", "后院");
  set("long",
    "这里是后院。走到这里，花香味更加浓烈了。你仔细一看，东南\n"
    "边有一道圆形门，似乎花香是从那里传出来的。从这里再往南走，\n"
    "就是侯员外的卧室了。\n"
  );
  set("outdoors", "quanzhen");
  set("exits", ([
    "southeast": __DIR__ "houhuayuan",
    "north": __DIR__ "fu-datang",
    "south": __DIR__ "fu-woshi",
  ]));
  set("no_clean_up", 0);
  setup();
}
