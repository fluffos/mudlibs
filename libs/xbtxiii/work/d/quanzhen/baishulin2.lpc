// baishulin2.c 柏树林
// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("coor",({1040,-150,100}));
	set("short", "柏树林");
        set("long",
"你走进了柏树林的深处，脚下踩着厚厚的落叶，松松软软。这里\n"
"的光线非常阴暗，你几乎什么都看不清了。突然一只松鼠从你眼\n"
"前的树枝上猛地跳了过去，吓了你一跳。\n"
);
        set("outdoors", "quanzhen");
        set("exits", ([
                "northup" : __DIR__"baishulin4",
                "west" : __DIR__"baishulin1",
        ]));
        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}
