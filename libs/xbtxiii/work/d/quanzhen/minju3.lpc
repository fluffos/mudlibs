// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("coor",({890,-150,40}));
	set("short", "民居");
        set("long",
"这是一所乡间民居，桌椅都很旧了，而且看得出来是自己敲敲打\n"
"打给拼补下来的，不过擦拭得很干净。墙壁上斜倚着一支猎叉，\n"
"也许这家的主人还是个捕猎高手。\n"
);
        set("exits", ([
                "southeast" : __DIR__"guchang",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
