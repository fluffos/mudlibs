inherit ROOM;

void create() {
  set("coor", ({ 1550, 250, 340 }));
  set("short", "后山小路");
  set("long",
    "这里是后山上的小路。这条小路好象不是人工刻意修出来的，也\n"
    "许只是以前的采药人踩多了，现出这样一条小路来。\n"
  );
  set("outdoors", "quanzhen");
  set("exits", ([
    "northeast": __DIR__ "xiaolu2",
    "southwest": __DIR__ "houshan",
  ]));
  set("no_clean_up", 0);
  setup();
}
