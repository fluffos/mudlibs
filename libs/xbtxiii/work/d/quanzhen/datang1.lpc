#include <ansi.h>
inherit ROOM;

void create()
{
        set("coor",({1150,200,340}));
	set("short", "大堂一进");
        set("long",
"这里是大堂，是全真教接待客人的地方。堂很大，几十张桌椅一\n"
"字排开也丝毫不显拥挤。地下铺着整齐的青砖，几名道童正忙前\n"
"忙后地端茶送水招呼客人。\n"
);
        set("exits", ([
                "east" : __DIR__"datang2",
                "west" : __DIR__"damen",
                "north" : __DIR__"huizhentang",
                "south" : __DIR__"xianzhentang",
        ]));
        set("objects",([
               "/d/quanzhen/npc/daotong" : 3,
        ]));
        set("valid_startroom", 1);
        setup();
//        "obj/board/quanzhen_b"->foo();
}
