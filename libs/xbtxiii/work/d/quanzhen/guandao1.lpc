// guandao1.c 官道
// By Lgg,1998.10

inherit ROOM;

void create() {
  set("coor", ({ 1050, -260, 0 }));
  set("short", "官道");
  set("long",
    "这是一条大道，西面通往武功镇。道上的行人很多，大多是低着\n"
    "头自己赶自己的路。忽然在你的身后响起得得的马蹄声，不一会\n"
    "儿，几匹骏马从你身边飞驰而过，掠起了一片黄沙。\n"
  );
  set("outdoors", "quanzhen");
  set("exits", ([
    "west": __DIR__ "guandao2",
    "east": __DIR__ "ximen",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
