// minju2.c 民居
// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("coor",({950,-240,0}));
	set("short", "民居");
        set("long",
"这是一家用茅草搭的房屋，家徒四壁，屋角的米缸是空的，厨房\n"
"内的水缸也是空的。几个缺胳膊少腿的桌椅靠墙立着。看来主人\n"
"已经把所有能值钱的东西全都变卖了。\n"
);
        set("exits", ([
                "south" : __DIR__"xijie",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
