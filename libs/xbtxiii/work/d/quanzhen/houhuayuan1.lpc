// houhuayuan1.c 后花园
// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("coor",({1090,-350,0}));
	set("short", "后花园");
        set("long",
"这是一片荒废了的花园，本来这里有一片小池塘，养着一些金鱼\n"
"之类，现在池塘差不多也干涸了。池塘边立着一座假山，山上长\n"
"满了青苔，看来已经很久没有人来过了。\n"
);
        set("outdoors", "quanzhen");
        set("exits", ([
                "west" : __DIR__"houhuayuan",
        ]));
        set("objects", ([
                __DIR__"npc/wugui" : 1,
        ] ));

        setup();
        replace_program(ROOM);
}
