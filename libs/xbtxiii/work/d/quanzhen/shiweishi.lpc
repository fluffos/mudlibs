#include <ansi.h>
inherit ROOM;

void create()
{
        set("coor",({1200,300,340}));
	set("short", "事为室");
        set("long",
"这里是全真七子之首马钰的居室。房间很小，只摆放了一张床、\n"
"一张书桌和一把椅子。书桌上放着一本‘老子’，只看了一半，\n"
"床上被褥折叠得整整齐齐。\n"
);
        set("exits", ([
                "south" : __DIR__"cetang",
        ]));

        set("objects", ([
                __DIR__"npc/ma" : 1,
        ]));
        setup();
        replace_program(ROOM);
}
