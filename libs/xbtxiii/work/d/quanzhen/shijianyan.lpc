// shijianyan.c 试剑岩
// By Lgg,1998.10

inherit ROOM;

void create() {
  set("coor", ({ 1000, 200, 320 }));
  set("short", "试剑岩");
  set("long",
    "石阶旁立着一块大岩石，上面斑斑驳驳的尽是砍伤。这块大岩石\n"
    "便是全真教的试剑岩，天下的英雄来到这里，望着先辈们练剑时\n"
    "在岩石上的砍痕，无不肃然起敬。\n"
  );
  set("outdoors", "quanzhen");
  set("exits", ([
    "northdown": __DIR__ "shijie4",
    "southup": __DIR__ "shijie8",
    "east": __DIR__ "jiaobei",
  ]));
  set("objects", ([
    __DIR__ "npc/yin": 1,
    __DIR__ "npc/daotong": 2,
  ]));

  setup();
  replace_program(ROOM);
}
