// xiaolu12.c 后山小路
// By Lgg,1998.10

inherit ROOM;

void create() {
  set("coor", ({ 1650, 300, 340 }));
  set("short", "后山小路");
  set("long",
    "这里是后山上的小路。这条小路好象不是人工刻意修出来的，也\n"
    "许只是以前的采药人踩多了，现出这样一条小路来。走到这里，\n"
    "你好象迷路了。\n"
  );
  set("outdoors", "quanzhen");
  set("exits", ([
    "east": __FILE__,
    "west": __FILE__,
    "north": __DIR__ "xiaolu10",
    "south": __FILE__,
    "enter": __DIR__ "shandong",
  ]));
  set("no_clean_up", 0);
  setup();
}
