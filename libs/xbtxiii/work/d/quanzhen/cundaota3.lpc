#include <ansi.h>
inherit ROOM;

void create() {
  set("coor", ({ 1250, 300, 380 }));
  set("short", "存道塔三层");
  set("long",
    "这里是存道塔的三层，塔梯绕着塔内向塔顶延伸。这里空空如也，\n"
    "经书也许全被全真弟子们借去阅读了。\n"
  );
  set("exits", ([
    "westup": __DIR__ "cundaota4",
    "westdown": __DIR__ "cundaota2",
  ]));
  set("no_clean_up", 0);
  setup();
}
