// By Lgg,1998.10

#include <ansi.h>
inherit ROOM;

void create()
{
        set("coor",({1400,150,340}));
	set("short", "武场");
        set("long",
"这里是全真教的演武场，地下的青砖本来铺的整整齐齐，却不知\n"
"道被谁踩出了几十个大大小小的凹坑。看的出来，这里成年累月\n"
"的有弟子修炼掌法步法，天长日久，地下就踩出了凹坑。\n"
);
        set("outdoors", "quanzhen");
        set("exits", ([
                "south" : __DIR__"wuchang2",
                "north" : __DIR__"houtang2",
                "southeast" : __DIR__"xiuxishi",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
