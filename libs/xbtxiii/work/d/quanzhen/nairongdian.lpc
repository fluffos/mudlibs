#include <ansi.h>
inherit ROOM;

void create() {
  set("coor", ({ 1250, 150, 340 }));
  set("short", "乃容殿");
  set("long",
    "这里是大堂旁边的一个侧殿，也是接待重要客人的地方。殿不大，\n"
    "只摆放着一张桌子和几把椅子。桌上摆放着一盆青山隐隐的盆景，\n"
    "墙壁上挂着一些字画。\n"
  );
  set("exits", ([
    "south": __DIR__ "qingjing",
    "west": __DIR__ "piandian",
    "north": __DIR__ "datang3",
  ]));
  set("objects", ([
    __DIR__ "npc/cheng": 1,
  ]));
  //        set("no_clean_up", 0);
  setup();
}
