// jiulou1.c

inherit ROOM;

void create() {
  set("coor", ({ 1050, -200, 0 }));
  set("short", "酒楼");
  set("long",
    "这家酒楼是武功镇方圆百里内的唯一一家，不过连名字都没有。\n"
    "楼下布置简易，顾客多是匆匆的行人，买点包子、鸡腿、米酒就\n"
    "赶路去了。楼上是雅座。\n"
  );
  set("exits", ([
    "south": __DIR__ "beijie",
    "up": __DIR__ "jiulou2",
  ]));
  set("objects", ([
    __DIR__ "npc/xiaoer": 1,
  ]));

  setup();
  replace_program(ROOM);
}
