// cuipingfeng.c 翠屏峰顶
// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("coor",({1020,-190,140}));
	set("short", "翠屏峰顶");
        set("long",
"这里是翠屏峰的峰顶。翠屏峰是终南山的第一峰，也是最矮的一\n"
"个山峰。悬崖边建有一个小亭子，你走进亭中凭拦远望，远处的\n"
"山间白云漂浮缭绕，好象修筑着什么建筑，山景清丽，可惜被白\n"
"云尽遮住了。几个游客也在亭中歇脚，正啧啧赞美着此地美景。\n"
);
        set("outdoors", "quanzhen");
        set("exits", ([
                "southdown" : __DIR__"baishulin3",
        ]));
        set("objects",([
                __DIR__"npc/youke" : 2,
        ]));

        setup();
        replace_program(ROOM);
}
