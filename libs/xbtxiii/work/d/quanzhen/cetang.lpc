#include <ansi.h>
inherit ROOM;

void create()
{
        set("coor",({1200,250,340}));
	set("short", "侧堂");
        set("long",
"这里是大堂旁边的一个侧厅，也是接待重要客人的地方。厅不大，\n"
"只摆放着一张桌子和几把椅子。桌上摆放着一盆青松山石的盆景，\n"
"墙壁上挂着一些字画。\n"
);
        set("exits", ([
                "east" : __DIR__"guozhendian",
                "west" : __DIR__"huizhentang",
                "north" : __DIR__"shiweishi",
                "south" : __DIR__"datang2",
        ]));
        set("objects", ([
                __DIR__"npc/li" : 1,
        ]));

        setup();
        replace_program(ROOM);
}
