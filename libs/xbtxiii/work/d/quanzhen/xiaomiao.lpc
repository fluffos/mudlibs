// xiaomiao.c 土地庙
// By Lgg,1998.10

inherit ROOM;

void create() {
  set("coor", ({ 950, -280, 0 }));
  set("short", "土地庙");
  set("long",
    "这座庙宇原本是武功镇中的土地庙，不过因为很久没有修缮过，\n"
    "已经破烂不堪。土地爷的金身也只剩下了半截，供桌只剩下了三\n"
    "条腿，窗框已经全被下光了，被附近的贫苦百姓拿回家去生火取\n"
    "暖。这里平常是没有人来的，只有一些游手好闲的地痞流氓之类\n"
    "把这里当做了家。\n"
  );
  set("exits", ([
    "north": __DIR__ "xijie",
  ]));

  set("objects", ([
    __DIR__ "npc/dipi": 1,
  ]));

  setup();
}
