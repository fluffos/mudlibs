// yuzhengong.c 遇真宫
// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("coor",({1050,400,380}));
	set("short", "遇真宫");
        set("long",
"这里是重阳宫以前的旧址，是王重阳王真人参悟大道之前清修的\n"
"地方。后来手创全真教后，此地的布局实在太小，就将重阳宫迁\n"
"到东面山上，将此地重新改名为遇真宫，以纪念得道之意。这里\n"
"很久没有人来过了，桌椅上都积满了灰尘。\n"
);
        set("exits", ([
                "south" : __DIR__"fangzhenqiao",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
