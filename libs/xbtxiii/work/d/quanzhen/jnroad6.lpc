inherit ROOM;

void create() {
  set("short", "莽林深处");
  set("long",
    "放眼望去，树海茫茫，了无边际。浓密的树枝象一块厚实的地毯\n"
    "铺盖着整个大地。树上粗壮的树枝极力向四周伸展，只有风吹过\n"
    "树梢的沙沙之声。\n"
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "jnroad5",
    "south": __DIR__ "jnroad7",
  ]));

  setup();
  replace_program(ROOM);
}
