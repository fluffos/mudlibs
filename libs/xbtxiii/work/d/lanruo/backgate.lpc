inherit ROOM;

void create() {
  set("short", "兰若寺后门");
  set("long",
    "这里是兰若寺后门,一阵阵阴风向你吹来.使你不寒而粟,你总觉\n"
    "得有点什么可怕的事情会发生,但一时又说不出...所以还是万事\n"
    "小心为上.这里向西下坡是远近有名的恐怖客店-黑店,向东是兰\n"
    "若寺后院.\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "backyard",
    "westdown": __DIR__ "blackinn",
  ]));
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
