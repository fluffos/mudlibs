inherit ROOM;

void create() {
  set("short", "兰若寺大门");
  set("long",
    "这里是蓝若寺的大门，大门上被虫侵蚀的厉害，满是窟窿，一阵\n"
    "风吹过，门被吹的东摇西摆，眼看快要倒下的样子，看上去这间\n"
    "寺院应该是已经被人荒废了，不过里面好象隐约有敲木鱼的声音。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "lr_square",
    "eastdown": __DIR__ "lroad2",
  ]));
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
