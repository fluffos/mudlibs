inherit ROOM;

void create() {
  set("short", "小木桥");
  set("long",
    "这是一座座立在在水中的小木桥，桥身结构沉稳，在小木桥的两\n"
    "侧水草布满水面。这里往北走是湖边小路，向南就是风景优美的\n"
    "水中居。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "waterroom",
    "north": __DIR__ "lroad4",
  ]));
  set("no_clean_up", 0);

  setup();
}
