#include <ansi.h>
#include <room.h>

inherit ROOM;
int drop_him(object me);
void create()
{
        object ear, sna;
        set("short", "乱葬岗");
        set("long",
"你现在处在阴风阵阵的乱葬岗中，尸体的气味令人连气都透不出。\n"
"除了满耳呼呼的风声，你还隐约听见有什么在呼唤你，除了满地\n"
"白骨，还有蜘蛛、蜈蚣在你身旁，而且还有一些泥潭（ｅａｒｔ\n"
"ｈ）。这时能恨不得马上离开这个鬼地方。。。\n"
);
        set("exits", ([ 
 //       /* sizeof() == 2 */
  "east" : __DIR__"herohouse",
  "southwest" : __DIR__"blackinn",
   "down"   :  __DIR__"obj/quicksand",
         ]));


        set("objects", ([
                __DIR__"obj/earth" : 1,
                __DIR__"obj/skeleton" : 3,
                __DIR__"npc/shuyao" : 1,
       
                "obj/money/silver": 1,
        ]));

        set("outdoors", "quicksand");

        setup();
        ear = present("earth");
        sna = present("skeleton", this_object());
        sna->move(ear);
        sna = present("skeleton", this_object());
        sna->move(ear);
        sna = present("silver", this_object());
        sna->set_amount(5);
        sna->move(ear);

        
}

void init()
{       object ob;
        object jade;
        int water, food, bellicosity;
        if( interactive( ob = this_player()))
        {
        water = ob->query("water");
        food = ob->query("food");
        bellicosity = ob->query("bellicosity");
        water -= (random(4)+ 1) * water / 10;
        food -= (random(2)+ 1) * water / 10;
        bellicosity += random(10);
        ob->set("water", water);
        ob->set("food", food);
        ob->set("bellicosity", bellicosity);    
        if( !objectp(jade = present("jade", ob)))
        {
                if( random(300)< 2)               drop_him(ob);
        }
        else
        {
                if( random(1000)< 1)    drop_him(ob);
        }
        }
        add_action("do_pull", "pull");
        add_action("do_go","go");
}
int drop_him(object me)
{
        me->start_busy(1);
        call_out("dropnow", 1, me);
        return 1;

}
int dropnow(object me)
{
        message_vision(HIW"$N突然感到脚底软绵绵的，无处着力！", me);
        message_vision("$N大叫一声“不好！”，可是来不及了…\n", me);
        message_vision("$N已陷身泥潭之中！！\n"NOR, me); 
        me->move(__DIR__"quicksand");
        return 1;
}
        
int do_pull ( string arg)
{
        object me, who;
        object room;
        me = this_player();
        if ( !arg  ) return notify_fail("你要拉谁上来？\n");
        room = load_object(__DIR__"quicksand0");
        if(!objectp(who = present(arg, room)) ||  !living(who))
        return notify_fail("泥潭里没有这个人。\n");
         message_vision(HIW"$N用尽全身力量，将$n从泥潭中救了出来。\n"NOR, me,who);
        who->move(__FILE__);
        return 1;

}

int do_go()
{
 if(random(3))
   {
    this_player()->move(this_object());
    return 1;
   }
}

