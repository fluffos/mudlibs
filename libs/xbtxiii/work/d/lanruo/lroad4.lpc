    "中随风飘来一阵缥渺的歌声，婉转悠长。。。。\n"
  );
  set("exits", ([ /* sizeof() == 3 */
    "west": __DIR__ "ghost_forest",
    "south": __DIR__ "bridge",
    "north": __DIR__ "lroad1",
  ]));
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
