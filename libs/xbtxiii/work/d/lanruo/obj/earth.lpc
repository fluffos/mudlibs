#pragma save_binary

inherit ITEM;

void create()
{
        set_name("泥潭", ({ "earth" , "泥潭"}) );
        set_weight(500);
        set_max_encumbrance(8000000);
        set("no_get", 1);
        set("no_shown", 1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "滩");
                set("long", "泥潭里面露出了几根白骨。。。\n");
                set("value", 1);
        }
}

int is_container() { return 1; }

