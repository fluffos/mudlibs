#pragma save_binary
// bamboo_sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
        set_name("桃木剑", ({ "tao mu jian", "sword" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
		set("value", 20000);
                set("material", "bamboo");
                set("long", 
"这是一把桃木剑，是道士们用来做法用的\n");
                set("wield_msg", "$N拿出一把练剑用的$n，握在手中。\n");
                set("unequip_msg", "$N放下手中的$n。\n");
        }
        init_sword(10);
        setup();
}
 
