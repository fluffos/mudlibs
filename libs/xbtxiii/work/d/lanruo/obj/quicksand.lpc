//#pragma save_binary
// Room: /d/chuenyu/trap_castle.c
#include <ansi.h>
#include <room.h>

inherit ROOM;
int do_sanddrop(object me, object obj);
void create() {

  set("short", "泥潭");
  set("long", @LONG
你已经陷入泥潭之中，四周没有一点着力的地方。你一点点的向下落去。
除非有人拉(pull)你一把，想活着离开这里恐怕比登天还难。你似乎已经看
到黑白无常在向你招手。
LONG
  );

  set("NONPC", 1);
  setup();
}

void init() {
  object ob;
  if (interactive(ob = this_player())) {
    remove_call_out("sinking");
    call_out("sinking", 1, ob);
  }
}

int sinking(object ob)

{
  int i;
  int damage;
  if (ob && environment(ob) == this_object()) {
    message_vision(HIW "$N又在泥潭中陷深了一些！！", ob);
    message_vision("$N几乎在绝望中哭了出来！！\n" NOR, ob);
    damage = random(10) + 1;
    i = (int)ob->query("kee");
    ob->set("kee", (int)i - damage);
    if (environment(ob) == this_object())
      call_out("sinking", random(5) + 5, ob);
  } else

    return 1;
}
