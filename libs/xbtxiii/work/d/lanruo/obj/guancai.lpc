#pragma save_binary
inherit ITEM;

void create()
{
        set_name("棺材", ({ "guan cai" }) );
        set_weight(50000);
        set_max_encumbrance(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "口");
                set("long", "这是一口装尸体用的的棺材。\n");
                set("value", 1);
        }
}

int is_container() { return 1; }

