// Room: /d/lanruo/lr_room0.c

inherit ROOM;

void create() {
  set("short", "南厢房");
  set("long",
    "这里是一间破房间,四处布满蜘蛛网,很明显这里曾经很久没有人\n"
    "住过，这里似乎没有什么特别的地方。只有墙上贴着一副破旧的\n"
    "快要掉下来的对联（duilian），还有挂着一把桃木剑（sword）。\n"
    "这里往北走是蓝若寺的中心广场。\n"
  );
  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "lr_square",
  ]));
  set("item_desc", ([
    "sword": "铺满灰尘的桃木剑，看来好象并不属于这个地方。\n",
    "duilian": "
        蓝    深
        若    山
        和    老
        尚    道
        必    必
        胜    败
        ，    。
",
  ])); ;
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
