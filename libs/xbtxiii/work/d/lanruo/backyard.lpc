inherit ROOM;

void create() {
  set("short", "兰若寺后院");
  set("long",
    "这里是兰若寺后院,四处野草丛生,一点都不象一间院寺的后院,\n"
    "不时一阵阵阴风吹来，树叶随风飘扬，好象有生命似的。。。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "northeast": __DIR__ "way",
    "west": __DIR__ "backgate",
  ]));
  set("no_clean_up", 0);

  setup();
}
