inherit ROOM;

void create() {
  set("short", "走廊");
  set("long",
    "这里是一条长长的走廊，似乎好象没有尽头，不过好象没走两步，\n"
    "你又发觉他似乎很短。然后你就发现他的西南方是兰若寺后院，\n"
    "东北方是寺中空场。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "southeast": __DIR__ "lr_square",
    "southwest": __DIR__ "backyard",
  ]));
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
