// Room: /d/lanruo/lr_square.c

inherit ROOM;

void create() {
  set("short", "寺中空场");
  set("long",
    "你站在寺中空场上，听到敲打木鱼的声音从东边阵阵的传来，可\n"
    "是眼见这里却四处无人，或者说这里连一点人气。一阵阴风吹过，\n"
    "好象有人从你的身后经过。但你马上回头看时，却只有一片树叶\n"
    "刚刚掉在你身后的地上。这里是蓝若寺的中心地区有着通向各个\n"
    "地方的出口。\n"
  );
  set("exits", ([ /* sizeof() == 5 */
    "north": __DIR__ "lr_room1",
    "south": __DIR__ "lr_room0",
    "west": __DIR__ "lr_hall",
    "east": __DIR__ "gate",
    "northwest": __DIR__ "way",
  ]));
  set("no_clean_up", 0);

  setup();
}
