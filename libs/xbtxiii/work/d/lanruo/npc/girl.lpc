int do_enjoy()
{
object me,fox,young;
int maxgin,maxkee, maxsen;
        young=present("young",environment(this_object()));
        me = this_player();
message_vision("$N轻飘飘地向$n走过来，温柔的抚弄$n的黑发。。。\n",this_object(),me);
message_vision("你象没了半条命似的，精疲力竭。。。\n",me);        
message_vision("突然你发觉那个美女变成了一只狐精。。。\n",me);
message_vision("那个丫鬟不知所措，哇的一声哭着喊着跑掉了。\n",me); 
        maxgin = (int)me->query("max_gin");
        maxkee = (int)me->query("max_kee");
        maxsen = (int)me->query("max_sen");
        me->set("eff_gin", maxgin/2);
        me->set("gin", maxgin/2);
        me->set("eff_kee", maxkee/2);
        me->set("kee", maxkee/2);
        me->set("eff_sen", maxsen/2);
        me->set("sen", maxsen/2);
   
        fox = new("/d/lanruo/npc/fox");
        fox->move("/d/lanruo/waterroom");
        destruct(young);
        destruct(this_object());
        return 1;

}

