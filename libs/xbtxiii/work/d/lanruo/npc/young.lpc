#pragma save_binary
inherit NPC;

void create() {
  set_name("丫鬟", ({ "young", "servant" }));
  set("gender", "女性");
  set("age", 18);
  set("long", @TEXT
看起来有点心不在焉，悠悠
目光下好象有什么难言之隐。
TEXT
  );
  set("class", "dancer");
  set("combat_exp", 1000);
  set_skill("unarmed", 10);
  set_skill("dodge", 10);
  set_skill("force", 50);
  set("force", 200);
  set("max_force", 200);

  setup();
  carry_object("/d/latemoon/obj/skirt")->wear();
}
