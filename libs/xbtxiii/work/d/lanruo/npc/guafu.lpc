// hermit1.c
#include <ansi.h>
inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("黑寡妇", ({ "hei guafu", "guafu" }) );
        set("gender", "女性" );
        set("age", 43);
        set("long", "这个黑寡妇对你阴阴一笑，说道：热腾腾的人肉包子，来一笼吧？\n");
        set("combat_exp", 30);
        set("attitude", "friendly");
        set("where","city");
        set("vendor_goods", ([
             "/d/lanruo/obj/bao" : 10,
//                "/open/alvins/bao" : 30 ,
           ]) );
        set("chat_chance", 5);
        set("chat_msg", ({
                "黑寡妇阴阴道：人肉叉烧包！很新鲜的人肉做叉烧包哦！\n",
        
        }) );
        set("inquiry", ([
                "人肉叉烧包" : (: do_vendor_list :),
        ]) );
        setup();
}

void init()
{
        object ob;

        ob = this_player();
        
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        say("这个黑寡妇对你阴阴一笑，说道：" + RANK_D->query_respect(ob)
          +"热腾腾的人肉包子，来一笼吗？\n");
}

