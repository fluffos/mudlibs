//#pragma save_binary
// shadow.c
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("狐精", ({ "fox" }) );
        set("title", HIW "其丑无比" NOR);
        set("long",
                "一个的狐精，看起来令人恶心，不过 ....\n");
        set("age", 500);
        set("gender", "女性" );
        set("str", 44);
        set("cor", 37);
        set("max_gin", 400);
        set("max_kee", 600);
        set("max_sen", 400);

        set("combat_exp", 1000000);

        set("attitude", "aggressive");

        set_temp("apply/attack", 80);
        set_temp("apply/blade", 80);
        set_temp("apply/parry", 80);
        set_temp("apply/armor", 70);
        set_temp("apply/damage", 30);
        set_temp("apply/dodge", 70);
        set_temp("apply/armor_vs_force", 5000);

        setup();

//        carry_object("/d/obj/blade")->wield();
}

void init()
{
        string msg;
        object me;
        me = this_player();
        ::init();
if (!userp(me)) return;
        msg = CYN"我习惯在享受完后，把我的伴侣吃掉的。。嘿嘿。。不用怕，很快的。。\n" NOR;
        message_vision(msg, me) ;     
}

