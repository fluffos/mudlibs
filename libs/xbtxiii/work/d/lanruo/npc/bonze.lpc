//#pragma save_binary
// greeting_bonze.c
#include <ansi.h>
inherit NPC;
string inquiry_tai();
void create() {
  set_name("老和尚", ({ "bonze" }));
  set("gender", "男性");
  set("class", "bonze");
  set("age", 47);
  set("str", 26);
  set("cor", 22);
  set("cps", 26);
  set("int", 23);
  set("long",
    "这个老和尚脸色和蔼，总是让人有一种值得信赖的感觉。\n");
  set("combat_exp", 2000);
  set("attitude", "friendly");
  set("max_force", 300);
  set("force", 300);
  set("force_factor", 3);
  set_skill("force", 40);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_temp("toutai", 1);
  set("inquiry", ([
    "投胎": (: inquiry_tai :),
  ]));
  setup();
}

int accept_fight(object me) {
  command("say 阿弥陀佛！老衲武功低微，认输便是。\n");
  return 0;
}

void init() {
  object ob;

  ob = this_player();

  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  say("老和尚一见你就说道：" + RANK_D->query_respect(ob)
    + "这里多鬼怪出没，这位施主还是快点离开这里吧。。。\n");
}


string inquiry_tai() {
  object me = this_player();

  if (query_temp("toutai") == 1) {
    if (me->query_temp("gui") == 1) {
      command("say 这位" + RANK_D->query_respect(me) + "老衲也知道这个女鬼的一些身世，也挺可怜的，
     不过想助她投胎的方法老衲并不知道。可是老衲知道谁知道这个方法
     如果你愿意帮我做一件事，老衲就告诉你谁知道投胎的方法。。。
     不知施主是否肯答应我的要求。。(yes/no)\n");
      add_action("do_quest", ({ "yes", "no" }));
      set_temp("toutai", 0);
      me->delete_temp("gui");
      return "只要你帮我做完了事,我就会实现我的诺言。。.";
    } else {
      command("say 这位" + RANK_D->query_respect(me) + "你问这个干什么，我不会告诉你的。。。\n");
      return "你死了心吧！";
    }

  } else {
    command("say 这位" + RANK_D->query_respect(me) + "你问这个干什么，我不会告诉你的。。。\n");
    return "你死了心吧！";
  }


}


int do_quest()

{
  object me;
  me = this_player();

  if (query_verb() == "yes")

  {
    command("say 这位" + RANK_D->query_respect(me) + "太感谢您了。。事情是这样的：\n"
      "我曾经拥有一本易筋经的手抄本，可是被人盗走了，经过\n"
      "我多年的寻访，终于有一点眉目了，听说在宁远的一个商\n"
      "人的手中你想办法帮我拿回吧！"
      "\n");

    remove_action("do_nod", "yes");
    remove_action("do_nod", "no");


  } else if (query_verb() == "no") {
    command("sign");
    command("say 你不答应就算了，就此告辞。");
    destruct(this_object());
  }
  return 1;
}
