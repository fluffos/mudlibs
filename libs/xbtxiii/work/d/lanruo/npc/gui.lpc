// ghost.c

inherit NPC;

void create()
{
	set_name("孤魂野鬼", ({ "wandering ghost", "ghost" }) );
	set("age", 45);
	set("attitude","aggressive");
	set("str", 24);
	set("cor", 26);

	set_temp("apply/attack", random(2000));
	set_temp("apply/armor", random(2000));

	setup();
}

int is_ghost() { return 1; }
