// tao_2.c

inherit NPC;
#include <ansi.h>
void create() {
  set_name("千年树妖", ({ "shuyao", "shu", "yao" }));
  set("title", CYN "千年树妖" NOR);
  set("gender", "女性");
  set("age", 1000);
  set("long",

    "她就是兰若寺的猛鬼——千年树妖,这家伙可不简单，她的法力高强，\n"
    "她会种种变化，专门以此来诱惑别人，吸取他人精气，帮助她修行。\n"
  );
  set("combat_exp", 1500000);
  set("score", 300);

  set("str", 30);
  set("int", 10);
  set("cor", 30);
  set("cps", 30);
  set("spi", 20);
  set("per", 1);
  set("con", 30);
  set("pursuer", 1);

  set("gin", 2000);
  set("max_gin", 2000);
  set("sen", 2000);
  set("max_sen", 2000);
  set("max_kee", 2000);
  set("kee", 2000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 50);

  set("atman", 2000);
  set("max_atman", 2000);

  set("mana", 4000);
  set("max_mana", 4000);
  set("mana_factor", 100);
  set("attitude", "aggressive");
  set("chat_chance", 25);

  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: command("say 好久没有吃到这么新鲜的人肉了！你来的正好！") :),
    (: command("say 看来想吃这人肉还真不容易。。") :),
    (: command("千年树妖发出一阵怪叫：ソ々。～ぃ") :),
    (: cast_spell, "drainerbolt" :),
    (: cast_spell, "netherbolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "invocation" :),
    (: command("cast animate on corpse") :),
    (: command("cast animate on corpse") :),
  }));

  set_skill("magic", 200);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("scratching", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("gouyee", 150);

  set_skill("taoism", 150);
  set_skill("necromancy", 150);

  map_skill("spells", "necromancy");

  set_temp("apply/dodge", 30);
  set_temp("apply/armor", 30);

  setup();


}
int is_zombie() {
  return 1;
}
void die() {
  object killer;
  if (objectp(killer = query_temp("last_damage_from")))
    killer->add("shen", 1000);
  ::die();
}
int is_ghost() { return 1; }
