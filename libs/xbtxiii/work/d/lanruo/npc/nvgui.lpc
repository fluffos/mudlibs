//#pragma save_binary
//#pragma save_binary
// ghost.c
//#include <ansi.h>
inherit NPC;
string inquiry_shen();
string inquiry_tou();
void create()
{
        set_name("女鬼", ({ "ghost", "ghost" }) );
        set("age", 22);
        set("long", "一个可怜凄凄的女鬼。看见她这么\n"
        "可怜的样子，一定生前饱经风霜，身世可怜。。\n");
        set("gender", "女性" );
        set("shen_type", 1);
        set("str", 24);
        set("cor", 26);

        set("env/wimpy", 70);
        set_temp("apply/attack", 10);
        set_temp("apply/armor", 3);
        set("chat_chance",5);
        set("chat_msg", ({  "我死得好惨啊。。。呜呜。。。。\n",
                        (: random_move :),
           }) );

        set("inquiry",([
           "身世" : (: inquiry_shen :),
           "投胎" : (: inquiry_tou :),
           ]) );
        
        set_temp("tou",1);
        set_temp("shen",1);
        setup();

//        carry_object(__DIR__"obj/cloth_piece");


}

void init()
{
        object ob;

        ob = this_player();

        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        say("呜呜。。。。\n" + RANK_D->query_respect(ob)
          +"我死得好惨啊。。。\n");
}




string inquiry_shen()
{
        object me=this_player();
        if(query_temp("shen")==1)
            {
            command("say 这位"+ RANK_D->query_respect(me)+"，我是出来游玩时，客死异乡于此。。
            不知道为什么我没有投胎，反而成为游魂野鬼。。。呜呜。。");
            set_temp("shen",0);
            return "唉。。。";
            
            }
          else
            {
            command("say 这位"+ RANK_D->query_respect(me)+"你问这个干什么?\n");
            return "我不会告诉你的。。。！";
            }
        
        

       
}


string inquiry_tou()
{
        object me=this_player();

     if(query_temp("tou")==1)
        {
           if(query_temp("shen")==0)
            {
            command("say 这位"+ RANK_D->query_respect(me)+"，我其实也不知道，怎样才能
              使自己投胎的方法。。。我有一个不情之请，
              不知您是否能答应。。。(yes/no)\n"); 
            add_action("do_nod",({"yes","no"}));
            set_temp("tou",0);
            
            return "如果你答应的话，我一定会报答你的。。。";
            }
          else
            {
            command("say 这位"+ RANK_D->query_respect(me)+"你问这个干什么，我不会告诉你的。。。\n");
            return "你死了心吧！";
            }
        }
     else
         {
         command("say 这位"+ RANK_D->query_respect(me)+"你问这个干什么，我不会告诉你的。。。\n");
         return "你死了心吧！";
         }

}

int do_nod()

{
         object me;
         me=this_player();
      if (query_verb()=="yes")
         
          {
          command("say 这位"+RANK_D->query_respect(me)+"太感谢您了。。关于"
                   
                  "投胎的事，要麻烦你了。。。 \n");

          me->set_temp("gui",1);
          remove_action("do_nod","yes");  
          remove_action("do_nod","no");  
       
              
          }              
        else if(query_verb()=="no")  
          {
          command("sign");
          command("say 我这么可怜，你都不肯帮。。呜呜。。。");
          }
     
      
    return 1;  
}


int is_ghost() { return 1; }

