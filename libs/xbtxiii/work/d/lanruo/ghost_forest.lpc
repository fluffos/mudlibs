inherit ROOM;

void create()
{
        set("short", "猛鬼森林");
        set("long",
"这是一个阴森恐怖的森林，传说这里经常有猛鬼出没，一阵阵阴\n"
"风从四面八方吹来，不禁令人连连打寒颤。住在这里附近的人当\n"
"听到“猛鬼森林”使都会闻之色变，所以没有什么人敢进入这里。\n"
);
        set("exits", ([ /* sizeof() == 2 */
              "east":"/d/lanruo/ghost_forest2",
//              "east" : __DIR__"lroad4",
              "northwest" : __DIR__"blackinn",
]));    
        set("objects", ([ /* sizeof() == 1 */
        __DIR__"npc/gui" : 3,
]));
        
        
        set("no_clean_up", 0);

        setup();
//       replace_program(ROOM);
}

void init()
{
        add_action("do_go","go");

}

int do_go()
{
 if(random(3))
   {
    this_player()->move(this_object());
    return 1;
   }
}

