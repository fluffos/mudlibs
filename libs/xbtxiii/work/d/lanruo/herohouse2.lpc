// Room: /d/lanruo/herohouse.c
#include <room.h>

inherit ROOM;

void create() {
  set("short", "大厅");
  set("long",
    "这是一个内堂，四处灰尘乱飞。看来有好久没人住了。这里布置\n"
    "简陋而且朴素,看来原来住在这里的人不象富贵人家.环顾四方,\n"
    "只见有一个小门,但是当你回头时,你忘了门在你的哪个方向了,\n"
    "这里的向南是正气山庄.\n"
  );
  set("item_desc", ([
    "door": (: look_door, "northwest" :),
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "herohouse",
    "northwest": __DIR__ "herohouse3",
  ]));
  create_door("northwest", "木门", "southeast", DOOR_CLOSED);
  set("no_clean_up", 0);
  setup();
}
