// Room: /d/lanruo/blackinn.c

inherit ROOM;

void create()
{
        set("short", "黑店");
        set("long",
"这里是一间远近驰名的黑店,因为这里常常发生命案,所以当知道\n"
"黑店这个地方的人，一听到“黑店”时都会脸色惨白，并告诉你\n"
"不要去那里，眼看这里蜘蛛网满布，蜈蚣更在你身边四处爬行。\n"
"你再望望墙上，发觉有一张广告（paper）。这里往西北方是阴\n"
"深恐怖的乱葬岗，向东是经常有猛鬼出没的猛鬼森林。\n"
);
        set("exits", ([ /* sizeof() == 3 */
          "southeast" : __DIR__"ghost_forest",
          "northeast" : __DIR__"bury_area",
          "eastup" : __DIR__"backgate",
]));
 set("item_desc", ([
   "paper" : "这里的招牌美食：人肉叉烧包。\n",
]));
        set("objects", ([ /* sizeof() == 1 */
            __DIR__"npc/guafu" : 1,            
]));
        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}

