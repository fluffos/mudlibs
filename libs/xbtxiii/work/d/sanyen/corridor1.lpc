inherit ROOM;

void create()
{
	set("coor",({3460,3460,20}));
	set("short", "走廊");
	set("long",
"你正走在一条长廊上,两旁分别是流云轩及后殿的外墙,墙上画著\n"
"大慈大悲观世音菩萨救苦救难的事迹。长廊往东西两边延伸,西\n"
"边的尽是一间相当大的房屋。\n"
);
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"kitchen",
  "east" : __DIR__"corridor",
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
