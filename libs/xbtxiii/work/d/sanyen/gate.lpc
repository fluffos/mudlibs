inherit ROOM;

void create() {
  set("coor", ({ 3470, 3360, 20 }));
  set("short", "山烟寺山门");
  set("long",
    "这里是往山烟寺的山门，西边是一条穿过山腰的隧道，山烟寺在\n"
    "你的东北方不远，由于寺中的老方丈玄智和尚医术通神，不少受\n"
    "过恩惠的各地富豪将山烟寺修整得金碧辉煌，庄严雄伟，因此山\n"
    "烟寺规模虽然不及京城的白象禅院，但是名气却是大得多了。\n"
  );
  set("exits", ([ /* sizeof() == 3 */
    "west": "/d/sanyen/sroad2",
    "east": "/d/sanyen/front_yard",
    //	"south" : "/d/latemoon/sroad1"
  ]));
  set("objects", ([ /* sizeof() == 1 */
    "/d/sanyen/npc/greeting": 2,
  ]));
  set("outdoors", "sanyen");

  setup();
}
