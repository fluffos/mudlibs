#pragma save_binary
// Room: /shaolin/jiulou1.c
// YZC 1995/12/04 

inherit ROOM;

void create() {
  set("coor", ({ 4500, -1500, -10 }));
  set("short", "迎宾楼");
  set("long",
    "方圆数百里内提起迎宾楼可以说是无人不知，无人不晓。当年苏\n"
    "学士云游到此，对迎宾楼的素齐赞不绝口，欣然为其题匾，流下\n"
    "一段传遍海内的佳话，从此迎宾楼名声大震。楼下布置简易，顾\n"
    "客多是匆匆的行人，买点包子，鸡腿、米酒就赶路去了。楼上是\n"
    "雅座。\n"
  );

  set("exits", ([
    "east": __DIR__ "nanyang",
    "up": __DIR__ "jiulou2",
  ]));

  set("objects", ([
    "/d/city/npc/waiter": 1,
  ]));


  replace_program(ROOM);
}
