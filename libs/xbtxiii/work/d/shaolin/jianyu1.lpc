#pragma save_binary
// Room: /d/shaolin/jianyu1.c
// Date: YZC 96/02/06

#include <room.h>
inherit ROOM;




void create() {
  set("short", "监狱");
  set("long",
    "这里黑沉沉的，即无一丝光亮，也无半分声息。黑暗中依稀可以\n"
    "看到身边似乎有几个人影，看到你转过头去，他们立刻屏住呼吸，\n"
    "紧张地瞪着你。四壁摸上去冰凉，且极硬，似乎都是钢铁铸成，\n"
    "只有南北面各有一道小门，门上开了个巴掌大的洞，象是送饭用\n"
    "的。脚边有一堆东西踢上去克剌剌地散了开来，细看却是一具白\n"
    "得发亮的枯骨。\n"
  );

  set("exits", ([
    "north": __DIR__ "jianyu",
    "south": __DIR__ "andao1",
  ]));

  set("no_spells", 1);
  set("no_magic", "1");
  set("objects", ([
    "/d/shaolin/npc/yu-zu": 1,
  ]));
  create_door("south", "木门", "north", DOOR_CLOSED);
  setup();
  replace_program(ROOM);
}

void init() {
  add_action("do_pray", "pray");
  add_action("do_pray", "home");
  add_action("do_pray", "tie");
  add_action("do_pray", "dancing");
}
int do_pray(string arg) {
  object me;
  tell_object(me, "想用宝物逃跑？呵呵，没门！\n");
  return 1;
}
