#pragma save_binary
// Room: /d/shaolin/shulin8.c
// Date: YZC 96/01/19

inherit ROOM;




void create()
{
	set("short", "松树林");
	set("long",
"你眼前骤然一黑，朦胧中，只见左右前后，到处都是铺天盖地的\n"
"松树林。几十丈高的大松树簇在一块，密实的枝叶象一蓬蓬巨伞\n"
"般伸向天空，把阳光遮得丝毫也无。尺把厚的松针积在地上，一\n"
"脚踩下去，半天拔不出来。你似乎迷失了方向，象没头苍蝇般到\n"
"处乱闯。\n"
);

	set("exits", ([
        "west" : __DIR__"shulin10",
		"south" : __DIR__"shulin"+(random(10)+2),
        "east" : __DIR__"shulin11",
		"north" : __DIR__"shulin"+(random(10)+2),
	]));

	set("outdoors", "shaolin");
	setup();
	replace_program(ROOM);
}



