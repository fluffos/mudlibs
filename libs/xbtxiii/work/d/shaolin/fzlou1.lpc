#pragma save_binary
// Room: /d/shaolin/fzlou1.c
// Date: YZC 96/01/19
// Date: cleansword 96/02/24

inherit ROOM;




void create()
{
	set("coor",({4100,-680,30}));
	set("short", "茶室");
	set("long",
"这里是方丈待客的地方，靠墙左右两侧摆着一溜太师椅。北面墙\n"
"上挂了一付对联。墙角一几，放着几个茶壶。有个茶壶壶身上题\n"
"了“碧螺春”三个篆字，壶嘴热气腾腾，似乎是刚沏的新茶。往\n"
"北是方丈室。\n"
);

	set("exits", ([
		"north" : __DIR__"fzlou2",
		"down" : __DIR__"fzlou",
	]));

	set("objects",([
           __DIR__"npc/qing-le" : 1 ,
	]));

	setup();
}

int valid_leave(object me, string dir)
{
	int skill;

	skill = me->query_skill("buddhism", 1);
	if (!wizardp(me) && skill < 30)
	{
		if (dir == "north" )
		{
			return notify_fail("你资格不够，不能进入方丈室。\n");
		}
	}
	return ::valid_leave(me, dir);
}


