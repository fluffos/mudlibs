inherit ROOM;




void create() {
  set("coor", ({ 4100, -780, 0 }));
  set("short", "台阶");
  set("long",
    "穿过山门殿，面前三道平行的青石台阶通向前方的一个高台。台\n"
    "阶上精工镂刻着麒麟，玄龟，松鹤等瑞兽，形态逼真动人。高台\n"
    "正中方着个二人高的青铜大香炉，前面摆着个香台，几位香客正\n"
    "在虔诚谟拜。再往前就是天王殿。\n"
  );

  set("exits", ([
    "east": __DIR__ "beilin3",
    "south": __DIR__ "smdian",
    "west": __DIR__ "beilin1",
    "northup": __DIR__ "twdian",
  ]));

  set("outdoors", "shaolin");
  set("objects", ([
    __DIR__ "npc/xiang-ke": 1,
  ]));
  setup();
  replace_program(ROOM);
}
