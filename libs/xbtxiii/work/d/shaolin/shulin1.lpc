inherit ROOM;




void create() {
  set("short", "松树林");
  set("long",
    "这是一片松树林。几十丈高的大松树簇在一块，密实的枝叶象一\n"
    "蓬蓬巨伞般伸向天空，把阳光遮得丝毫也无。尺把厚的松针积在\n"
    "地上，一脚踩下去，半天拔不出来。\n"
  );

  set("exits", ([
    "east": __DIR__ "shulin" + (random(10) + 2),
    "south": __DIR__ "shulin" + (random(10) + 2),
    "west": __DIR__ "shulin2",
    "north": __DIR__ "shulin" + (random(10) + 2),
  ]));

  //      set("no_acc_drop",1);
  set("outdoors", "shaolin");
  set("objects", ([
    __DIR__ "obj/fake-gold": 1,
  ]));
  setup();
}
