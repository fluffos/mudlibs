#pragma save_binary
// Room: /d/shaolin/zhonglou6.c
// Date: YZC 96/01/19

inherit ROOM;




void create() {
  set("coor", ({ 4120, -750, 35 }));
  set("short", "钟楼六层");
  set("long",
    "沿窗洞吹进一阵阵凌厉的山风，寒意浸人。北望可见松林的尽头，\n"
    "少室山的顶峰处，有一片小小的平地，正中植着三棵巨松；又似\n"
    "乎有什么东西正闪闪发光。头顶上的楼板开了个大洞，挂下一口\n"
    "大钟。从这里只能看到巨钟的下边缘，内里黑洞洞的，什么也看\n"
    "不见。\n"
  );

  set("exits", ([
    "up": __DIR__ "zhonglou7",
    "down": __DIR__ "zhonglou5",
  ]));

  setup();
}
