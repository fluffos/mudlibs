inherit ROOM;




void create()
{
	set("coor",({4060,-680,25}));
	set("short", "走廊");
	set("long",
"这里是禅房走廊。走廊南侧的房顶倚着南面的高墙，另一侧凌空\n"
"架在几根细细的石柱上，倚在栏杆上，北望是一大片竹林，馨香\n"
"满怀，竹影摇曳，诗意顿上心头，别有一番韵趣。\n"
);

	set("exits", ([
		"east" : __DIR__"zoulang6",
		"north" : __DIR__"zhulin4",
		"southdown" : __DIR__"banruo9",
	]));

	setup();
	replace_program(ROOM);
}



