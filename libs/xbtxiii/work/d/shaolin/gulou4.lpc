inherit ROOM;




void create()
{
	set("coor",({4080,-750,25}));
	set("short", "鼓楼四层");
	set("long",
"到这里楼梯大概只能容一人上下，墙身也略薄了些。视线越过窗\n"
"棂，南边的练武场，罗汉堂，般若堂历历在目，不少僧人正汇集\n"
"在练武场上习武，吆喝声一阵阵传进耳鼓。北边的藏经楼，方丈\n"
"楼也尽露全貌。\n"
);

	set("exits", ([
		"up" : __DIR__"gulou5",
		"down" : __DIR__"gulou3",
	]));

	setup();
	replace_program(ROOM);
}



