#pragma save_binary
// steel-fox.c

#include <weapon.h>

inherit HAMMER;

void create()
{
        set_name("纯钢斧头", ({ "steel fox", "fox" }));
        set_weight(9000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 0);
                set("material", "iron");
                set("long", "这是一柄砍柴用的斧头(cut wood)。\n");
                set("wield_msg", "$N抽出一把$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n插回腰间。\n");
                set("shaolin",1);
        }
        init_hammer(0);
        setup();
}
