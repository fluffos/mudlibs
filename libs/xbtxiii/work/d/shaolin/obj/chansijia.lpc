#pragma save_binary
// chansi-jia.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(WHT "蚕丝宝甲" NOR, ({ "chansi jia", "jia" }));
  set_weight(200);
  //        set("no_get",1);
  set("no_drop", "这是百年难遇的宝物。\n\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一件金光闪闪的宝甲，通体用天山雪蚕丝织成，坚韧无比
刀剑不能伤。此宝甲由一前辈高手花了一生时间，历尽千辛万苦，才锤练而成，乃是无上降魔
法宝。\n");
    set("material", "cloth");
    set("unit", "件");
    set("value", 1000000);
    set("wear_msg", HIM "只听「哗」的一声，$N展开一件金光闪闪的宝甲披在身上。
瞬时间日月为之失色，瑞气千条，祥云朵朵，一派庄严气象。\n" NOR);
    set("remove_msg", HIY "$N将金刚罩从身上脱了下来，折叠成小小的一团。\n" NOR);
    set("armor_prop/armor", 1000);
  }
  setup();
}
