#pragma save_binary
// goldring.c 爱永远戒指
#include <armor.h>
#include <ansi.h>
inherit FINGER;
void create() {
  set_name(WHT "爱永远戒指" NOR, ({ "love ring", "ring" }));
  set("weight", 400);
  //        set("no_get",1);
  //        set("no_drop","这是你和LOVING的爱情见证。\n\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    //                set("value", 10);
    set("long", HIM "相传爱永远戒指有两个，是在天地出开时月老花无数心血打制而成。
得到这两枚戒指的相爱男女将生生世世，永不分离。
上面刻着你的爱人LOVING的名字。\n" NOR);
    set("material", "gold");
    set("wear_msg", HIM "只听「哗」的一声，$N将" WHT "爱永远戒指" HIM "戴在左手无名指上。
瞬时间日月为之失色，瑞气千条，祥云朵朵，一派庄严气象。
天空出现你爱人--loving的影像。\n" NOR);
    set("armor_prop/armor", 1);
  }
}

int query_autoload() {

  return 1;
}
