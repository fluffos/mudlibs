// Room: /d/shaolin/damodong.c
// Date: YZC 96/01/19

inherit ROOM;
int i;

void create() {
  set("short", "达摩洞");
  set("long",
    "这里是达摩古洞。五百年前南天竺僧人菩提达摩来到少林寺，见\n"
    "此风水宝地，就住下来广罗弟子，传授禅宗，开创少林寺佛教禅\n"
    "宗千年不败之基。达摩祖师常在此面壁悟道，一坐十年，壁间隐\n"
    "隐似仍可看到他面壁时的打坐姿态。除地上的几块竹片外，洞中\n"
    "空无一物。\n"
  );

  set("exits", ([
    "out": __DIR__ "bamboo14",
  ]));

  setup();
}

void init() {
  add_action("do_mianbi", "面壁");
  add_action("do_mianbi", "mianbi");
}

int do_mianbi() {
  object me = this_player();

  me->start_busy(2);
  message_vision("你开始面壁思过。\n", me);
  if ((int)me->query("sen") < 30) {
    me->unconcious();
    return 1;
  }
  me->receive_damage("sen", 15);
  if ((string)me->query("family/family_name") == "少林派"
    && (string)me->query("class") == "bonze"

    && (int)me->query("family/generation") <= 38) {
    i = i + 1;
    if (i == 10) {
      i = 1;
      message_vision("一个苍老的声音从石壁后传出：你都挺有恒心，进来吧！\n", me);
      message_vision("只听道一阵轰轰声，石壁缓缓的移开了。\n", me);
      set("exits/enter", __DIR__ "damo-mi");
      call_out("close_passage", 10);
    }
  }
  return 1;
}

void close_passage() {
  if (!query("exits/enter")) return;
  tell_room(this_object(), "只听道一阵轰轰声，石壁缓缓的将入口遮住了。\n");
  delete("exits/enter");
}
