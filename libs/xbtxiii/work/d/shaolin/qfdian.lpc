#pragma save_binary
// Room: /d/shaolin/qfdian.c
// Date: YZC 96/01/19

#include <room.h>
inherit ROOM;




void create()
{
	set("coor",({4100,-665,35}));
	set("short", "千佛殿");
	set("long",
"这是千佛殿。大殿入口是朱红格扇，七宝玲珑。内里供奉的西天\n"
"诸佛，计有八菩萨，四金刚，五百阿罗，三千揭谛，十一大曜，\n"
"十八伽蓝，以及众优婆塞，优婆夷等。直看得你眼花缭乱。边上\n"
"有道小木门。\n"
);

    set("valid_startroom", 1);
	set("exits", ([
		"southdown" : __DIR__"guangchang5",
        "northup" : __DIR__"bamboo1",
	]));

        set("outdoors", "shaolin");
	set("objects",([
             __DIR__"npc/qing-guan" : 1,
	]));

    create_door("northup","小木门","southdown",DOOR_CLOSED);

	setup();
}



void init()
{
    if(this_player())
        this_player()->set_explore("south#27");
}
