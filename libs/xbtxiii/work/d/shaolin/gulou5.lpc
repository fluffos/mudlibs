inherit ROOM;




void create() {
  set("coor", ({ 4080, -750, 30 }));
  set("short", "鼓楼五层");
  set("long",
    "一眼望去，只见蓝天白云，青山列列，令人将尘俗之气，顿为一\n"
    "一扫。南至前三殿，北到方丈楼，整个少林寺尽在眼底。北面竹\n"
    "林随风起伏，犹如一片竹海。东西面围绕全寺的是密密匝匝的松\n"
    "林，一眼往不到边。\n"
  );

  set("exits", ([
    "up": __DIR__ "gulou6",
    "down": __DIR__ "gulou4",
  ]));

  setup();
}
