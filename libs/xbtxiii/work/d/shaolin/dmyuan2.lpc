#pragma save_binary
// Room: /d/shaolin/dmyuan2.c
// Date: YZC 96/01/19

inherit ROOM;




void create()
{
	set("coor",({4105,-673,30}));
	set("short", "达摩院二楼");
	set("long",
"这是一座古朴的殿堂。西首的墙上挂满了各类武功图谱，不少白\n"
"须白眉的老僧们正端坐在图谱画轴之前，似乎在苦苦思索。南北\n"
"山墙是高及屋顶的大书架，走近细看，它们是各门各派的武功秘\n"
"笈，屋正中摆着几张矮几诃和几个团，几位老僧正在入定中。\n"
);

    set("valid_startroom", 1);
	set("exits", ([
		"down" : __DIR__"dmyuan",
	]));

	set("objects",([
               __DIR__"npc/xuan-bei" : 1 ,
		__DIR__"npc/xiao-bei" : 1,
	]));
	setup();
}



void init()
{
    if(this_player())
        this_player()->set_explore("south#28");
}
