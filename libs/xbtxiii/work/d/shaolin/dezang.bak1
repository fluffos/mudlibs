// Room: /d/snow/dezang.c

inherit ROOM;
int do_find ();
void create()
{
        set("short", "地藏殿");
        set("long", @LONG
地藏王菩萨神情庄重,凄苦,悲天悯人由此可见一斑.神像左手
中食两指斜指正上方,似乎有些奇怪.
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
  "southeast" : __DIR__"square5",
]));
        set("clean_up", 1);
//       set("objects", ([
//           __DIR__"damo-ling":1,
//]));
        set("outdoors", "shaolin");
        setup();
        replace_program(ROOM);
}

void init ()
{
        add_action ("do_find", "find");
}

int valid_leave(object me,string dir)
{
        if ( dir=="southeast" )
                tell_object(me, "总觉得有些不对劲,但$N又说不上来");

        return ::valid_leave(me,dir);
}

int do_find ()
{
        object *list, me,token; 
        int i;

        me = this_player ();

        list = all_inventory(me);
//        i = sizeof(list);
//        while (i--) {
//              if (((string)list[i]->query("id")) == "damo-ling")
//                        return notify_fail("忙活了半天，没有什么新的发现。\n");
//                }

        if (random(me->query("kar") + 30) >= 35) {
                token = new(__DIR__"damo-ling");
                token->move(me);
                message_vision("$N竟找到了一个达摩令。\n", me);
                return 1;
                }

        return notify_fail ("白忙了半天，一无所获。\n");
}
