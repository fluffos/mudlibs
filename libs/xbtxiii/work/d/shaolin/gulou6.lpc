inherit ROOM;




void create() {
  set("coor", ({ 4080, -750, 35 }));
  set("short", "鼓楼六层");
  set("long",
    "沿窗洞吹进一阵阵凌厉的山风，寒意浸人。北望可见松林的尽头，\n"
    "少室山的顶峰处，有一片小小的平地，正中植着三棵巨松；中间\n"
    "又似乎有什么东西正闪闪发光。楼上传来一阵阵沉闷的鼓声。\n"
  );

  set("exits", ([
    "up": __DIR__ "gulou7",
    "down": __DIR__ "gulou5",
  ]));

  setup();
}
