#pragma save_binary
// Room: /d/shaolin/twdian1.c
// Date: YZC 96/01/19

inherit ROOM;




void create() {
  set("short", "东侧殿");
  set("long",
    "这里是东侧殿。房间四周悬挂着达摩祖师、观音大士的画像，以\n"
    "及一些寺内元老的字画。地下散乱地放着许多蒲团，木鱼等。看\n"
    "来此处是本派弟子打坐修行之所。几位中年和尚手持数珠，正在\n"
    "喃喃念经。\n"
  );

  set("exits", ([
    "west": __DIR__ "twdian",
  ]));

  setup();
  replace_program(ROOM);
}
