inherit ROOM;




void create() {
  set("coor", ({ 4060, -665, 25 }));
  set("short", "竹林小道");
  set("long",
    "这是一条卵石铺成的小道，曲曲折折地通向前方。两边是密密的\n"
    "竹林。这里人迹罕至，惟闻足底叩击路面，有僧敲木鱼声；微风\n"
    "吹拂竹叶，又如簌簌禅唱。令人尘心为之一涤，真是绝佳的禅修\n"
    "所在。\n"
  );

  set("exits", ([
    "east": __DIR__ "hsyuan6",
    "south": __DIR__ "zhulin5",
  ]));

  set("outdoors", "shaolin");
  setup();
  replace_program(ROOM);
}
