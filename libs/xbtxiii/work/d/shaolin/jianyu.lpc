#pragma save_binary
// Room: /d/shaolin/jianyu.c
// Date: YZC 96/02/06

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "监狱");
  set("long",
    "这里黑沉沉的，即无一丝光亮，也无半分声息。黑暗中依稀可以\n"
    "看到身边似乎有几个人影，看到你转过头去，他们立刻屏住呼吸，\n"
    "紧张地瞪着你。四壁摸上去冰凉，且极硬，似乎都是钢铁铸成，\n"
    "只有南北面各有一道小门，门上开了个巴掌大的洞，象是送饭用\n"
    "的。脚边有一堆东西踢上去克剌剌地散了开来，细看却是一具白\n"
    "得发亮的枯骨。\n"
  );

  set("exits", ([
    "south": __DIR__ "jianyu1",
  ]));

  set("no_spells", 1);
  set("no_magic", 1);
  set("valid_startroom", 1);
  set("objects", ([
    __DIR__ "npc/qing-yuan": 1,
    //        "d/shaolin/obj/fojing1"+random(2) : 1,
  ]));
  setup();

}

void init() {
  object ob = this_player();

  if ((int)ob->query_condition("bonze_jail") <= 0) {
    message("vision",
      HIY "只听牢房铁门匡地一响，一个昏昏沉沉的家伙被扔了进来！\n\n" NOR,
      environment(ob), ob);

    tell_object(ob, "狱卒嘿嘿地笑着：今儿个你可落在我手里了...！\n");

    ob->set("startroom", "/d/shaolin/jianyu");
    ob->apply_condition("bonze_jail", 60);
  }
  add_action("do_pray", "pray");
  add_action("do_pray", "dancing");
  add_action("do_pray", "tie");
  add_action("do_pray", "home");
}
int do_pray(string arg) {
  object me;
  me = this_player();
  tell_object(me, "想用宝物逃跑？呵呵，没门！\n");
  return 1;
}
