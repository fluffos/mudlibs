#include <room.h>
inherit ROOM;

void create()
{
        set("short", "石阶");
        set("long",
"石阶上头是通向后殿的红漆大门(door),南边则是通向前殿的过\n"
"道。\n"
);
        set("exits", ([ /* sizeof() == 2 */
  "south" : "/d/shaolin/road2",
  "northup" : "/d/shaolin/houdian",
]));
        set("outdoors", "shaolin");
        create_door("northup", "红漆大门","southdown", DOOR_CLOSED);
        setup();
        replace_program(ROOM);
}

