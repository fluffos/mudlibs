#pragma save_binary
// Room: /d/shaolin/zoulang2.c
// Date: YZC 96/01/19

inherit ROOM;


string look_picture(object me);


void create() {
  set("coor", ({ 4080, -730, 20 }));
  set("short", "走廊");
  set("long",
    "这里是禅房走廊。房顶一侧支在南面的高墙上，另一侧凌空架在\n"
    "几根细细的石柱上。彩梁画栋，连顶棚也用彩漆绘满了各种飞天\n"
    "的图形，每幅画似乎都在诉说一个娓娓动人的佛经故事。南边墙\n"
    "上也画着一幅画(picture)。北望可以观赏僧众们练武的场面。\n"
  );

  set("exits", ([
    "west": __DIR__ "zoulang1",
    "east": __DIR__ "houdian",
    "north": __DIR__ "wuchang1",
  ]));

  set("item_desc", ([
    "picture": (: look_picture :),
  ]));
  setup();
}


string look_picture(object me) {
  me->set_explore("south#30");
  return "\n"
    "    ※※※※※※※※※※※※※※※※※※※※※※※※※※\n"
