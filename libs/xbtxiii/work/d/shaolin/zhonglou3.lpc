inherit ROOM;




void create() {
  set("coor", ({ 4120, -750, 20 }));
  set("short", "钟楼三层");
  set("long",
    "塔身往上似乎越来越窄，楼梯也渐为挤仄。扶手上不少朽坏处续\n"
    "接了新木，漆色也是新旧不同。从窗孔往外望，往北可以看到竹\n"
    "林中的藏经楼和方丈楼露出飞檐一角，往西则是后殿的屋顶，屋\n"
    "脊上塑了个大大的“佛”字。\n"
  );

  set("exits", ([
    "up": __DIR__ "zhonglou4",
    "down": __DIR__ "zhonglou2",
  ]));

  setup();
}
