#pragma save_binary
// Room: /shaolin/kedian2.c
// YZC 1995/12/04 

inherit ROOM;

void create()
{
	set("coor",({4600,-1500,0}));
	set("short", "客店二楼");
	set("long",
"这是一间很大的客房，陈设十分简陋。靠墙放了十几张小木床，\n"
"不少客人正和衣而卧，满屋子都是呼呼的打酣声。西边有张床是\n"
"空的，你蹑手蹑脚地走了过去。\n"
);

	set("sleep_room",1);

	set("exits", ([
		"down" : __DIR__"kedian1",
	]));

	setup();
}

int valid_leave(object me, string dir)
{

	if (dir == "down" ) me->delete_temp("rent_paid");

	return ::valid_leave(me, dir);
}
void init()
{
    if(this_player())
        this_player()->set_explore("south#39");
}
