inherit ROOM;




void create() {
  set("coor", ({ 4120, -750, 15 }));
  set("short", "钟楼二层");
  set("long",
    "每个楼层上都铺设了结实的木楼板，八角形的墙身上则开了四扇\n"
    "大窗。从窗孔看，墙体也是极为厚实。从这里往外眺望，可以看\n"
    "到围绕塔周的小园以及北边的竹林，随风飘来阵阵竹叶的清香。\n"
  );

  set("exits", ([
    "up": __DIR__ "zhonglou3",
    "down": __DIR__ "zhonglou1",
  ]));

  setup();
  replace_program(ROOM);
}
