inherit ROOM;




void create()
{
	set("short", "松树林");
	set("long",
"你眼前骤然一黑，朦胧中，只见左右前后，到处都是铺天盖地的\n"
"松树林。几十丈高的大松树簇在一块，密实的枝叶象一蓬蓬巨伞\n"
"般伸向天空，把阳光遮得丝毫也无。尺把厚的松针积在地上，一\n"
"脚踩下去，半天拔不出来。你似乎迷失了方向，象没头苍蝇般到\n"
"处乱闯。\n"
);

	set("exits", ([
		"east" : __DIR__"shulin"+(random(8)+6),
                "south" : __DIR__"shulin12",
		"west" : __DIR__"shulin"+(random(8)+6),
		"north" : __DIR__"shulin"+(random(8)+6),
	]));

        set("no_acc_drop",1);
	set("outdoors", "shaolin");
//    set("objects",([
//                CLASS_D("shaolin") + __DIR__"npc/seng-bing1" : 3,
//    ]));
	setup();
	replace_program(ROOM);
}



