#pragma save_binary
// Room: /d/shaolin/smdian1.c

inherit ROOM;
int do_qiao(string arg);
string look_mu();

void create()
{
        set("coor",({4110,-790,0}));
	set("short", "东侧殿");
        set("long",
"这里是东侧殿。房间四周悬挂着达摩祖师、观音大士的画像，以\n"
"及一些寺内元老的字画。地下散乱地放着许多蒲团，木鱼等。看\n"
"来此处是本派弟子打坐修行之所。几位年轻僧人正肃容入定，看\n"
"来已颇得禅宗三昧。你前面有个木鱼(muyu)。\n"
);
        set("exits", ([ /* sizeof() == 1 */
            "west" : __DIR__"smdian",
            ]) );
        set("item_desc",([
                "muyu"          :       (: look_mu :),
        ]));
        set("outdoors", "shaolin");

        setup();
}

void init()
{
        add_action("do_qiao","qiao");
}

int do_qiao(string arg)
{
     object me;

     me = this_player();
     if ( !arg || ( arg != "muyu" ) ) return notify_fail("你要敲什麽？\n");
     if((string)me->query("family/family_name") == "少林派")
      { if( !(present("muyu chui", me)))
          return notify_fail("你用什么敲？\n");
        if ((int)me->query("sen") < 30 || (int)me->query("gin") < 30)
        { me->unconcious();
          return 1;
        }        
        me->receive_damage("sen", 20);

        me->receive_damage("gin", 20);
                tell_room(this_object(),"你拿起木鱼槌对木鱼敲了下去，开始做功课了。\n");
        me->improve_skill("buddhism", 2*(int)me->query_skill("buddhism",1));
        return 1;
      }
     return 1;
}
string look_mu()
{
        return "这是给和尚练功课的，你可以敲(qiao)它。\n";
}
