#pragma save_binary
// Room: /d/shaolin/cjlou.c
// Date: YZC 96/01/19

inherit ROOM;




void create() {
  set("coor", ({ 4055, -670, 25 }));
  set("short", "藏经阁一楼");
  set("long",
    "不愧为中原佛法的总源，少林寺此处藏经之富，天下罕有其匹。\n"
    "这里都是密密麻麻，高及顶棚的书架，书架间仅有容身一人通行\n"
    "的空隙。几排大书架中间，间隔地放着数丈长的书桌。目光及处，\n"
    "你看到桌上放了几本佛经。\n"
  );

  set("exits", ([
    "east": __DIR__ "zhulin5",
    "up": __DIR__ "cjlou1",
  ]));

  set("objects", ([
    __DIR__ "npc/dao-yi": 1,
    "d/shaolin/obj/fojing1" + random(2): 1,

    //        "d/shaolin/obj/fojing2"+random(2) : 1,
  ]));
  setup();
}


int valid_leave(object me, string dir) {

  if (!present("letter", this_player())) {
    if (dir == "up") {
      return notify_fail("你未经许可，不能上二楼。\n");
    }
  }
  return ::valid_leave(me, dir);
}
