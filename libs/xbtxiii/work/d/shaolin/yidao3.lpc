#include <roadbusy.h>

inherit ROOM;




void create()
{
	set("coor",({4550,-1300,-10}));
	set("short", "大驿道");
	set("long",
"你走在一条尘土飞扬的大驿道上。四周人来人往。挑担子的行商，\n"
"赶着大车的马夫，上京赶考的书生，熙熙攘攘，非常热闹。不时\n"
"还有两三骑快马从身边飞驰而过，扬起一路尘埃。道路两旁是整\n"
"整齐齐的杨树林。\n"
);

	set("exits", ([
		"south" : __DIR__"nanyang",
		"north" : __DIR__"ruzhou",
	]));

	set("outdoors", "shaolin");
	setup();
//        replace_program(ROOM);
}



