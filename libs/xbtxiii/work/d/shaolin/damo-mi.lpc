#pragma save_binary
// Room: /d/shaolin/damo-mi.c
// Date: YZC 96/01/19

inherit ROOM; ;

void create() {
  set("short", "达摩洞密室"); ;
  set("long",
    "这里是达摩古洞的密洞。一位白眉白须的老僧正坐在地上打坐静\n"
    "思，难道他就是方丈所说的四位师叔祖之一，当年名动江湖的渡\n"
    "天圣僧吧。墙上有一块突出的石块，好象可以按下去。\n"
  ); ;
  set("objects", ([
    __DIR__ "npc/du-tian": 1,
  ])); ;
  setup(); ;
}

void init() {
  add_action("do_push", ({ "push", "press" })); ;
}

int do_push(string arg) {
  object me; ;

  me = this_player(); ;
  if (!arg || (arg != "stone")) return notify_fail("你要敲什麽？\n"); ;
  message_vision("只听道一阵轰轰声，石壁缓缓的移开了。\n", me); ;
  set("exits/out", __DIR__ "damodong"); ;
  call_out("close_passage", 5); ;

  return 1; ;
}

void close_passage() {
  object room; ;
  if (!query("exits/out")) return; ;
  tell_room(this_object(), "只听道一阵轰轰声，石壁缓缓的将入口遮住了。\n"); ;
  delete("exits/out"); ;
}
