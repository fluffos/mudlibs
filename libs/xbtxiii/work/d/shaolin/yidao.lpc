#pragma save_binary
// Room: /d/shaolin/yidao.c
// Date: YZC 96/01/19

inherit ROOM;




void create() {
  set("short", "大驿道");
  set("long",
    "你走在一条尘土飞扬的大驿道上。四周人来人往。挑担子的行商，\n"
    "赶着大车的马夫，上京赶考的书生，熙熙攘攘，非常热闹。不时\n"
    "还有两三骑快马从身边飞驰而过，扬起一路尘埃。马上的人个个\n"
    "身着劲装，衣甲鲜明，有的还随身佩带着刀剑。看来都是些些习\n"
    "武的江湖人。道路两旁是整整齐齐的杨树林。\n"
  );

  set("exits", ([
    "south": "/d/village/hsroad2",
    "north": __DIR__ "yidao1",
  ]));

  set("outdoors", "shaolin");
  setup();
  replace_program(ROOM);
}
