inherit ROOM;




void create()
{
	set("coor",({4000,-820,30}));
	set("short", "卧室");
	set("long",
"卧房里只有一张竹制的矮床上面铺了半破烂的篾席。席子上的一\n"
"角耷拉到地上。席腿边有一把断了的单刀。地上斑斑点点似乎是\n"
"好多天前留下的血迹。\n"
);

	set("exits", ([
		"south" : __DIR__"xiaowu",
	]));

	setup();
	replace_program(ROOM);
}



