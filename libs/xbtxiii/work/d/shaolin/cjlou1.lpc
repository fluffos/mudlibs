#pragma save_binary
// Room: /d/shaolin/cjlou1.c
// Date: YZC 96/01/19

inherit ROOM;




void create() {
  set("coor", ({ 4055, -670, 30 }));
  set("short", "藏经阁二楼");
  set("long",
    "千余年来少林寺执中原武林之牛耳，自达摩老祖以下，历代人材\n"
    "辈出。其中有不少高僧遗著留存，汇集至今，终成名震天下的少\n"
    "林七十二绝艺。少林精华，尽集于此。二楼四面开窗，确保通风。\n"
    "中间排列着五排大书架。四周则陈列矮几，以供阅读。几位老僧\n"
    "手执经卷，正在闭目凝思。\n"
  );

  set("exits", ([
    "down": __DIR__ "cjlou",
  ]));

  set("objects", ([
    __DIR__ "npc/hui-zhen1": 1,
    "d/shaolin/obj/wuji1": 1,
    "d/shaolin/obj/wuji2": 1,
    "d/shaolin/obj/wuji3": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  object ob;

  //    if ( present("huizhen zunzhe", environment(me)) )
  if (present("shaolin wuji", me)
    || objectp(ob = present("corpse", me)) && present("shaolin wuji", ob)) {
    if (dir == "down") {
      return notify_fail("武功秘籍只许在藏经阁内研习，不得携带外出 !\n");
    }
  }
  return ::valid_leave(me, dir);
}
