#pragma save_binary
// Npc: /d/shaolin/npc/waiter-seng2.c

inherit NPC;
inherit F_VENDOR;


void create() {
  set_name("侍僧", ({
    "shi seng",
    "shi",
    "seng",
  }));
  set("long",
    "这是位胖胖的中年僧人，大概是因为长年在饭厅的缘故，才如此发福的吧。\n"
  );


  set("gender", "男性");
  set("attitude", "peaceful");
  set("class", "bonze");

  set("age", 44);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("max_kee", 400);
  set("max_gin", 200);
  set("force", 100);
  set("max_force", 100);
  set("force_factor", 10);
  set("combat_exp", 2000);

  set_skill("force", 12);
  set_skill("dodge", 12);
  set_skill("unarmed", 12);
  set_skill("parry", 12);
  set("vendor_goods", ([
    "/d/shaolin/obj/jiaxin-biji": 10,
    "/d/shaolin/obj/liuli-qiezi": 10,
    "/d/shaolin/obj/mala-doufu": 10,
    "/d/shaolin/obj/mizhi-tianou": 10,
    "/d/shaolin/obj/qingshui-hulu": 10,
    "/d/shaolin/obj/shanhu-baicai": 10,
  ]));


  setup();

}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(2)) {
    case 0:
      say("侍僧笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，进来喝杯茶，歇歇腿吧。\n");
      break;
    case 1:
      say("侍僧用毛巾抹了抹靠门的一张桌子，说道：这位" + RANK_D->query_respect(ob)
        + "，请进请进。\n");
      break;
  }
}
