#pragma save_binary
// Npc: /kungfu/class/shaolin/qing-fa.c
// Date: YZC 96/01/19

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_for_join();
string ask_for_join();
mixed huansu(mixed arg);


mixed huansu(mixed arg) {
  mapping fam, skl;
  object me;
  string nname, *sname;
  int i;

  me = this_player();
  nname = (string)me->query("marks/old_name");
  if ((string)me->query("class") == "bonze") {
    skl = this_player()->query_skills();
    sname = sort_array(keys(skl), (: strcmp :));

    for (i = 0; i < sizeof(skl); i++) {
      if (skl[sname[i]] > 0) {
        say("大师如想还俗，就要放弃所有了。大师还是回去念佛吧。\n");
        return 1;
      }
    }
    me->set("title", "普通百姓");
    me->set("family", 0);
    me->set("class", 0);
    me->set("fealty", 0);
    me->set("name", nname);
    say("唉,人各有志,施主今后好自为知.\n");
    //   因为有人利用这个去拜N个师傅，所以将这个封掉
    //   还有，也把还俗当做叛师  
    me->add("betrayer", 1);
    //     me->set("no_apprentice",1);
    return 1;
  }
  say("施主何必拿老纳开玩笑呢!\n");
  return 1;
}

void create() {
  set_name("清法比丘", ({
    "qingfa biqiu",
    "qingfa",
    "biqiu",
  }));
  set("long",
    "他是一位体格强健的壮年僧人，他生得虎背熊腰，全身似乎蕴含\n"
    "着无穷劲力。他身穿一袭白布黑边袈裟，似乎身怀武艺。\n"
  );


  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("inquiry", ([
    "剃度": (: ask_for_join :),
    "出家": (: ask_for_join :),
    "还俗": (: huansu :)
  ]));

  set("age", 30);
  set("shen_type", 1);
  set("str", 25);
  set("int", 24);
  set("con", 50);
  //      set("dex", 21);
  set("max_kee", 450);
  set("max_gin", 200);
  set("force", 350);
  set("max_force", 350);
  set("force_factor", 30);
  set("combat_exp", 13000);
  set("score", 100);

  set_skill("force", 30);
  set_skill("hunyuan-yiqi", 30);
  set_skill("dodge", 50);
  set_skill("shaolin-shenfa", 50);
  set_skill("unarmed", 50);
  set_skill("jingang-quan", 50);
  set_skill("parry", 30);
  set_skill("buddhism", 30);
  set_skill("literate", 30);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("unarmed", "jingang-quan");
  map_skill("parry", "jingang-quan");

  create_family("少林派", 40, "弟子");
  set("title", HIW "少林" NOR HIY "僧人" NOR);

  setup();

  carry_object(__DIR__ "obj/qing-cloth")->wear();
}


void init() {
  add_action("do_kneel", "kneel");
}

string ask_for_join() {
  object me;

  me = this_player();

  if ((string)me->query("class") == "bonze")
    return "阿弥陀佛！你我同是出家人，何故跟贫僧开这等玩笑？\n";

  if ((string)me->query("gender") != "男性")
    return "阿弥陀佛！善哉！善哉！女施主若真心皈依我佛，可去后山庵里受戒。\n";

  me->set_temp("pending/join_bonze", 1);
  return "阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请跪下(kneel)受戒。\n";
}

int do_kneel() {
  object me = this_player();

  string *prename = ({ "虚", "空", "明", "净" });
  //       ({ "虚", "空", "明", "圆", "净", "悟", "法" });
  string name, new_name;

  if (!me->query_temp("pending/join_bonze"))
    return 0;

  message_vision(
    "$N双手合十，恭恭敬敬地跪了下来。\n\n"
    "$n伸出手掌，在$N头顶轻轻地摩挲了几下，将$N的头发尽数剃去。\n\n",
    me, this_object());
  name = me->query("name");
  new_name = prename[random(sizeof(prename))] + name[0..1];
  command("say 从今以后你的法名叫做" + new_name + "。");
  command("smile");
  if (!this_player()->query("marks/old_name")) me->set("marks/old_name", name);
  me->delete_temp("pending/join_bonze");
  me->set("name", new_name);
  me->set("class", "bonze");
  me->set("K_record", me->query("PKS") + me->query("MKS"));
  me->set("shen_record", me->query("sen"));
  me->set("sen", 0);
  if ((string)me->query("family/family_name") != "少林派") {
    me->set("title", HIY "游方和尚" NOR);
    return 1;
  }
  me->set("title", HIW "少林" NOR HIY "小沙弥" NOR);

  return 1;
}

