#pragma save_binary
#include <ansi.h>
inherit NPC;
inherit F_MASTER;


void create() {
  set_name("澄观", ({
    "chengguan luohan",
    "chengguan",
    "xianglong",
    "luohan",
  }));
  set("long",
    "他是一位须发花白的老僧，身穿一袭金边黑布袈裟。他身材瘦高，\n"
    "太阳穴高高鼓起，似乎身怀绝世武功。\n"
  );


  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 60);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  //	set("max_jing", 1000);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 100);
  set("combat_exp", 350000);
  set("score", 5000);

  set_skill("force", 140);
  set_skill("hunyuan-yiqi", 140);
  set_skill("dodge", 150);
  set_skill("shaolin-shenfa", 150);
  set_skill("unarmed", 150);
  set_skill("fengyun-shou", 150);
  set_skill("parry", 145);
  set_skill("buddhism", 140);
  set_skill("literate", 140);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("unarmed", "fengyun-shou");
  map_skill("parry", "fengyun-shou");

  //	prepare_skill("hand", "fengyun-shou");

  create_family("少林派", 37, "弟子");

  set("title", HIW "少林" CYN "降龙罗汉" NOR);
  setup();

  carry_object(__DIR__ "obj/cheng-cloth")->wear();
}


#include "/daemon/class/shaolin/cheng.h"
