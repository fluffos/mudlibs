#pragma save_binary
inherit ITEM;

int seteuid();
void create() {
  set_name("少林令符", ({ "lingfu" }));
  set_weight(100);
  set("no_drop", 1);
  set("no_get", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这是少林方丈签发的令符！\n");

    set("value", 0);
    set("material", "copper");
  }
}
