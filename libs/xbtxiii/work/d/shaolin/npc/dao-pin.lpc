    "刃，身穿一袭灰布镶边袈裟，似乎有一身武艺。\n"
  );


  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 40);
  set("shen_type", 1);
  set("str", 25);
  set("int", 18);
  set("con", 20);
  //	set("dex", 23);
  set("max_kee", 400);
  set("max_gin", 300);
  set("force", 450);
  set("max_force", 450);
  set("force_factor", 40);
  set("combat_exp", 110000);
  set("score", 100);

  set_skill("force", 80);
  set_skill("hunyuan-yiqi", 80);
  set_skill("dodge", 100);
  set_skill("shaolin-shenfa", 100);
  set_skill("unarmed", 100);
  set_skill("nianhua-zhi", 100);
  set_skill("blade", 100);
  set_skill("cibei-dao", 100);
  set_skill("parry", 100);
  set_skill("buddhism", 80);
  set_skill("literate", 80);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("unarmed", "nianhua-zhi");
  map_skill("blade", "cibei-dao");
  map_skill("parry", "cibei-dao");

  create_family("少林派", 39, "弟子");

  set("title", HIW "少林" HIB "武僧" NOR);
  setup();

  carry_object(__DIR__ "obj/jiedao")->wield();
  carry_object(__DIR__ "obj/dao-cloth")->wear();
