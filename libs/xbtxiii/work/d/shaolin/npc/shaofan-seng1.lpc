// Npc: /d/shaolin/npc/shaofan-seng1.c
// Date: YZC 96/01/19

inherit NPC;
string ask_me_1();
int accept_object(object ob, object obj);

int i;
void create() {
  set_name("烧饭僧", ({
    "shaofan seng",
    "shaofan",
    "seng",
  }));
  set("long",
    "这是位胖胖的中年僧人，大概是因为长年烧饭作菜的缘故，才如此发福的吧。\n"
  );


  set("gender", "男性");
  set("attitude", "peaceful");
  set("class", "bonze");

  set("age", 44);
  set("shen_type", 1);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("max_kee", 400);
  set("max_gin", 200);
  set("force", 100);
  set("max_force", 100);
  set("force_factor", 10);
  set("combat_exp", 2000);
  set("score", 100);

  set_skill("force", 12);
  set_skill("dodge", 12);
  set_skill("unarmed", 12);
  set_skill("parry", 12);

  set("inquiry", ([
    "惩罚": (: ask_me_1 :)
  ]));

  setup();
}

string ask_me_1() {
  mapping fam;
  object ob;

  if (!(fam = this_player()->query("family")) || fam["family_name"] != "少林派")
    return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？";

  if ((int)this_player()->query("guilty") > 0) {
    ob = new("/d/shaolin/obj/steel-fox");
    ob->move(this_player());
    return RANK_D->query_respect(this_player()) + "这是斧头，快到西山树林砍些柴，急用！！";
  }
  return RANK_D->query_respect(this_player()) + "你没有犯罪，问这干嘛！";
}

int accept_object(object ob, object obj) {
  object me;
  me = this_player();

  if (present("steel fox", me)) {
    if (obj->query("id") == "chaihuo")

    {
      i = i + 1;
      remove_call_out("destroying");
      call_out("destroying", 1, me, obj);
      if (i == 5) {
        i = 0;
        me->set("guilty", 0);
        obj = present("steel fox", me);
        destruct(obj);
        command("say 好了，柴火够了，你可以走了。");
        return 1;
      }
      command("say 就这么点柴，快，再去砍些柴来。");
      return 1;
    }
    command("say 你没有柴火，还不快去砍。");
  }
  return 1;

}

void destroying(object me, object obj) {
  destruct(obj);
  return;
}
