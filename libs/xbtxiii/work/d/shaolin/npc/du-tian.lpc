inherit NPC;
inherit F_MASTER;


void create() {
  set_name("渡天", ({
    "du tian",
    "du",
    "tian",
  }));
  set("long",
    "这是一个面颊深陷，瘦骨零丁的老僧，他脸色枯黄，如同一段枯木。\n"
    "他身材略显佝偻，但却满面红光，目蕴慈笑，显得神完气足。也不知\n"
    "他是少林第几代第子了。\n"
  );

  set("nickname", "少林长老");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 100);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("cor", 30);
  set("cps", 30);
  set("kar", 30);
  set("spi", 30);
  set("per", 30);

  set("max_kee", 2500);
  set("max_gin", 3000);
  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 200);
  set("combat_exp", 2000000);

  set_skill("hunyuan-yiqi", 200);
  set_skill("dodge", 200);
  set_skill("qianye-shou", 200);
  set_skill("jingang-quan", 200);
  set_skill("sanhua-zhang", 200);
  set_skill("longzhua-gong", 200);
  set_skill("yizhi-chan", 200);
  set_skill("xiuluo-dao", 200);
  set_skill("zui-gun", 200);
  set_skill("wuchang-zhang", 200);
  set_skill("fumo-jian", 200);
  set_skill("damo-jian", 200);
  set_skill("shaolin-shenfa", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("nianhua-zhi", 200);
  set_skill("sanhua-zhang", 200);
  set_skill("fengyun-shou", 200);
  set_skill("buddhism", 200);
  set_skill("literate", 200);
  set_skill("sword", 200);
  set_skill("blade", 200);
  set_skill("force", 200);
  set_skill("finger", 200);
  set_skill("staff", 200);
  set_skill("finger", 200);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("unarmed", "sanhua-zhang");
  map_skill("parry", "nianhua-zhi");
  map_skill("sword", "fumo-jian");
  map_skill("blade", "xiuluo-dao");
  map_skill("finger", "yizhi-chan");
  map_skill("staff", "zui-gun");
  map_skill("finger", "yizhi-chan");

  create_family("少林派", 35, "弟子");
  assign_apprentice("弟子", 1);
  set("title", HIW "少林" RED "圣僧" NOR);
  setup();

  carry_object(__DIR__ "obj/xuan-cloth")->wear();
}

void attempt_apprentice(object ob) {
  object me;
  mapping ob_fam, my_fam;
  string name, new_name;
  int i;

  me = this_object();
  my_fam = me->query("family");

  name = ob->query("name");

  if (!(ob_fam = ob->query("family")) || ob_fam["family_name"] != "少林派") {
    command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
    return;
  }

  if ((string)ob->query("class") != "bonze" && ob_fam["family_name"] == "少林派") {
    command("say " + RANK_D->query_respect(ob) + "是俗家弟子，不能在寺内学艺。");
    return;
  }

  if (ob_fam["generation"] <= my_fam["generation"]) {
    command("say " + RANK_D->query_respect(ob) + "，贫僧哪里敢当 !");
    return;
  }


  if (!(ob->query("luohan_winner"))) {
    command("say " + RANK_D->query_respect(ob) + "你的功力不够，练多几年吧！");
    return;
  }


  if ((int)ob->query_skill("buddhism", 1) < 180) {
    command("say " + RANK_D->query_respect(ob) + "你还是多念念佛吧！"); ;
    return;
  }


  if (ob_fam["generation"] == (my_fam["generation"] + 1)) {
    command("say 那就贫僧收你为关门第子!");
    new_name = "玄" + name[2..3];
    ob->set("name", new_name);
    command("say 从今以后你的法名叫做" + new_name + "，恭喜你荣升为少林六大神僧之一!");
    command("recruit " + ob->query("id"));
    ob->set("title", HIW "少林" HIR "神僧" NOR);
  } else {
    command("say " + RANK_D->query_respect(ob) + "，你辈份不合，不能越级拜师。");
    return;
  }

  return;
}
