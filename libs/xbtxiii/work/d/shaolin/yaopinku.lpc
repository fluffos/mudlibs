#include <room.h>
inherit ROOM;




void create() {
  set("coor", ({ 4145, -660, 25 }));
  set("short", "药品库");
  set("long",
    "这里是全寺僧侣领用药品的地方。房间里弭漫着股浓浓的药味。\n"
    "靠墙是一排排高及房顶的药柜，每个药柜都由上百个装药的小抽\n"
    "屉，上面贴满了密密麻麻的各种草头药名。东首墙边放着个巨大\n"
    "的暗红色杉木药柜，上面贴着个盖有方丈印签的大封条。一位中\n"
    "年僧人正来回忙碌着称量药品，熬药煎汤。\n"
  );

  set("exits", ([
    "south": __DIR__ "fangjuku",
  ]));

  set("objects", ([
    __DIR__ "npc/dao-xiang": 1,
  ]));

  setup();
}
