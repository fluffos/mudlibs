#pragma save_binary
// start_room2.c 泥巴教程二 
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short",CYN"时空通道"NOR);
	set("long",
"四周放射着柔和的光芒，显得那么宁静。你漫步前行。前面的道\n"
"路似乎还很漫长，没有尽头。\n"
);
	set("exits",([
		    "west"  :  __DIR__"start_room3",
	]));
	set("room",6);
	set("no_fight",1);
        set_temp("light",1);
	set("no_magic",1);
	setup();
  
}

void init()
{
	object girl,me;
	me=this_player();
if(interactive(me))
	{
	girl=new(__DIR__"npc/teacher");	
	girl->move(this_object());
	girl->set_skill("move",500);
	girl->set_leader(me);
	girl->set("teach",me);
	girl->greeting(me);
	}
	return;
}


int valid_leave(object me,string dir)
{
	me->start_busy(2);
	return 1;
}
 
