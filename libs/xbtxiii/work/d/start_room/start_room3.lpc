#pragma save_binary
// start_room2.c 泥巴教程三 
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", CYN "时空通道" NOR);
  set("long",
    "四周放射着柔和的光芒，显得那么宁静。你和蓝手指漫步前行。\n"
    "前面的道路似乎还很漫长，没有尽头。\n"
  );
  set("exits", ([
    "up": __DIR__ "start_room4",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set_temp("light", 1);
  set("room", 1);  //只是对__DIR__"npc/teacher"有用
  setup();

}

int valid_leave(object me, string dir) {
  me->start_busy(2);
  return 1;
}
