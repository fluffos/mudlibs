// Room: /d/ultimate/secret_house.c

inherit ROOM;
#include <ansi.h>

void create()
{
        set("short", "神秘的密室");
        set("long","四周都是石壁。非常光滑。\n"
        	   "再不离开这个鬼地方。恐怕之后憋死在这里！\n\n");
        set("exits", ([ /* sizeof() == 2 */
  	    "out" : __DIR__"gu_di3",
  		]));
        set("objects",([
            __DIR__"npc/xiaolongnv:1,
        ]));
        setup();
}

int init()
{
		object me;
		me=this_player();
		remove_call_out("greeting");
		call_out("greeting",1,me);
}		
int greeting(object me)
{
		int i,temp;
		object yangguo;
		object *npc;
		temp=0;
for(i=0;i<sizeof(all_inventory(this_object()));i++)
	    {
		if(npc[i]->query("id")=="yangguo"&&!userp(npc[i]))
			{
			npc[i]->thank_player(object me);
			temp=1;
			break;
			}
		else
			continue;
  	    }
if(temp=0)
		{
		yangguo=new(__DIR__"npc/yangguo");
		yangguo->move(this_object());
		yangguo->thank_player(object me);
		}
}