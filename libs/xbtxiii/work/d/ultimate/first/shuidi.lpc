// Room: /d/snow/deaprec.c

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "水潭潭底");
  set("long", "四周漆黑一片。什么也看不清楚。并且寒冷异常。\n"
    "再不离开这个鬼地方。恐怕之后憋死在这里！\n\n");
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "gu_di1",
    "north": __DIR__ "gu_di1",
    "east": __DIR__ "gu_di1",
    "west": __DIR__ "gu_di1",
  ]));
  setup();
}

int init() {
  object ob;
  if (interactive(ob = this_player())) {
    remove_call_out("greeting");
    call_out("greeting", 2, ob);
  }
  add_action("do_go", "go");
}

int greeting(object me) {
  string msg;
  if (!living(me) || environment(me) != this_object())
    return 1;
  msg = HIR "你渐渐的觉得呼吸困难。心中憋的难受。\n" NOR;
  tell_object(me, msg);
  me->add("kee", -100);
  call_out("greeting", 5, me);
}

int do_go() {
  object me;
  int i;
  me = this_player();
  i = random(8);
  if (i == 1) {
    tell_object(me, "你终于找到了出口。浮出了水面！\n");
    return 0;
  }
  if (i == 2) {
    tell_object(me, "你终于找到了出口。浮出了水面！\n");
    me->move(__DIR__ "shuitan");
    return 1;
  } else {
    me->move(this_object());
    if (me->query("kee") <= 100)
      me->unconcious();
    else
      me->add("kee", -50);
    return 1;
  }
}
