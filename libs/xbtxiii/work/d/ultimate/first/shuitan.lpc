// Room: /d/snow/deaprec.c

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "深水潭岸边");
  set("long", "深水潭岸边。由于中年不见阳光。这里显的比较昏暗\n"
    "水面什么也看不清楚。\n");
  set("item_desc", ([
    "水面": "水面黑漆漆的。浮力好象很大。稍微轻一些的东西\n"
    "恐怕都沉不下去。\n",

  ]));
  setup();
}

int init() {
  add_action("do_climb", "climb");
  add_action("do_dive", "dive");
}

int do_climb(string arg) {
  object me, rope, room;

  me = this_player();
  if (!arg)
    return notify_fail("你要往上爬(up)吗？\n");
  if (arg != "up")
    return notify_fail("这里只能向上爬了。\n");
  message_vision("$N拉着绳子慢慢的朝上面爬了上去。。\n", me);
  me->move(__DIR__ "jueqinggu");
  message_vision("$N从下面爬了上来。\n", me);
  room = environment(me);
  if (room->query("length")) {
    rope = new(__DIR__ "obj/long_vine");  // 把蔓藤还给玩家。
    rope->set("length", room->query("length"));
    rope->move(me);
    room->delete("bind_the_tree");  // 删除绑了蔓藤的记号。
    message_vision("$N顺手把绑在树上的蔓藤解了下来。\n", me);
  }
  return 1;

}

int do_dive() {
  object me;
  string msg;
  int weigh;
  me = this_player();
  msg = "$N一个猛子朝深水潭扎了下去。\n";
  message_vision(msg, me);
  weigh = me->query_encumbrance();
  if (weigh <= 100000)  // 没有这么重没有办法沉到水底。
    tell_object(me, "水的浮力太大了。不一会儿，你就有浮了上来。\n");
  else {
    me->move(__DIR__ "shuidi");
    tell_object(me, "几经辛苦。你终于潜到了水底。\n");
    tell_object(me, HIR "现在你只有一个念头：赶快找到出口。不然非憋死在这里不可！\n" NOR);
  }
  if (me->query("kee") <= 200)
    me->unconcious();
  else
    me->add("kee", -200);

  return 1;
}
