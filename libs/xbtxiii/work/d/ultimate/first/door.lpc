// Room: /d/ultimate/door.c 独孤求败生前居住密室的大门

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "密室门口");
  set("long", "四周漆黑一片。什么也看不清楚。并且寒冷异常。\n"
    "再不离开这个鬼地方。恐怕之后憋死在这里！\n\n");
  setup();
}


int init() {
  add_action("do_put", "put_in");
}

int do_put(string arg) {
  object me, sword;
  me = this_player();

  if (!arg)
    return notify_fail("你想把什么放进去？\n");
  else {
    sword = present(arg, me);
    if (!sword)
      return notify_fail("你身上没有这样东西！\n");
    if (!sword->query("标记/玄铁重剑"))
      return notify_fail("你把" + sword->name() + "往石壁的洞中插去。\n"
        "但是什么事情也没有发生！\n");
    message_vision(CYN "$N把手中的" + sword->name() + "往石壁的洞中插了进去。\n"
      "只听轰隆隆～　～　～　　　石门竟然自动打开了。\n"
      "只听喀嚓一声响。" + sword->name() + "竟然断为两节。\n" NOR);
    destruct(sword);
    me->reset_action();
    set("exits", ([
      "enter": "/obj/ultimate/room",
    ]));
  }
  return 1;
}
