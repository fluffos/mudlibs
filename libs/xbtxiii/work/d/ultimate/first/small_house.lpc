// Room: /d/ultimate/small_house.c

inherit ROOM;
#include <ansi.h>

void create()
{
        set("short", "简陋的茅草屋");
		set("long","只见屋中陈设简陋，但洁净异常，堂上只一桌一几，此外便\n"
                   "无别物，\n");
        		   	
        set("exits", ([ /* sizeof() == 2 */
  	    "out" : __DIR__"gu_di3",
  	    "enter": __DIR__"bedroom",
  		]));
        set("objects",([
            __DIR__"npc/xiaolongnv":1,
        ]));
        setup();
}

int init()
{
		object me;
		me=this_player();
        remove_call_out("greeting");
		call_out("greeting",1,me);
}		
int greeting(object me)
{
		int i,temp;
		object yangguo;
		object *npc;
		temp=0;
for(i=0;i<sizeof(all_inventory(this_object()));i++)
	    {
		if(npc[i]->query("id")=="yangguo"&&!userp(npc[i]))
			{
            npc[i]->thank_player(me);
			temp=1;
			break;
			}
		else
			continue;
  	    }
if(temp=0)
		{
		yangguo=new(__DIR__"npc/yangguo");
		yangguo->move(this_object());
        yangguo->thank_player(me);
		}
}
