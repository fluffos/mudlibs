// long vine


inherit ITEM;
void create() {
  set_name("蜜蜂的尸体", ({ "corpse" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "一只蜜蜂的尸体。上面刻着几个字。\n"
      "我在绝             情谷底\n");
    set("material", "sapphire");
    set("value", 10);
    set("标记/绝情谷的蜜蜂", 1);
    setup();
  }


}
