inherit NPC;
#include <ansi.h>
int ask_me();

void create() {
  set_name("杨过", ({ "yang guo", "yang" }));
  set("title", CYN "神雕大侠" NOR);
  set("gender", "男性");
  set("age", 35);
  set("long", "神雕大侠杨过。自从和爱妻小龙女失散之后一直闷闷不乐\n"
    "看他脸上淡淡的忧愁。就知道他还在思念着爱妻。\n");
  set("combat_exp", 5000000);
  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set_skill("hunyuan-yiqi", 300);
  set_skill("force", 300);

  map_skill("force", "hunyuan-yiqi");
  set("force", 7000);
  set("max_force", 7000);
  set("force_factor", 30);
  set("attitude", "friendly");
  set_temp("apply/armor", 100);
  set("inquiry", ([
    "小龙女": (: ask_me :),
  ]));
  setup();
}

int init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()
    && ob->query_temp("标记/杨过")) {
    ob->delete_temp("标记／杨过");
    remove_call_out("greeting");
    call_out("greeting", 2, ob);
  }


}

int greeting(object me) {
  object key, paper;
  string msg;
  msg = CYN "这位" + RANK_D->query_respect(me) + "侠义心肠在下十分佩服。\n"
    "若不是" + RANK_D->query_respect(me) + "帮忙。在下可能永远不能和爱妻\n"
    "向会。这个东西就送与你吧。我留着也没有用了。\n" NOR;
  message_vision(msg, me);
  msg = CYN "龙儿。。。我们走吧。\n"
    "小龙女幸福的靠在杨过的怀里。轻轻点了点头。\n" NOR
    HIR "杨过忽然纵声长啸：啊～　～　～　啸声中充满了喜悦。\n";
  message_vision(msg, me);
  msg = "杨过和小龙女正要离开。忽然。杨过好象想起了某些事情。\n";
  message_vision(msg, me);
  command("say 有一件事情。不知道你想不想知道？(yes/no)");
  input_to("tell_you_story", 1, me);


}

int tell_you_story(string arg, object me) {
  string msg;
  object obj;
  if (!arg)
    input_to("tell_you_story", 1, me);
  else if (arg == "yes" || arg == "y") {
    msg = CYN "这是十六年前的事情了。当时我因失去龙儿，痛不欲生。\n"
      "后来，我被雕兄救了一命。雕兄带我去到了剑魔独孤求败\n"
      "生前居住的地方。在那里我发现了一个关乎世人命运的事情。\n"
      "我十六年以来一直追查此事，但是至尽还没有头绪。\n"
      "现在的我已经和龙儿相聚。不想再过问世事。不知" + RANK_D->query_respect(me) + "" NOR;
    message_vision(msg, me);
    tell_object("你愿意吗？(yes/no)");
    input_to("do_nod", 1, me);
  } else {
    command("say 既然如此。也就罢了。为了感谢" + RANK_D->query_respect(me) + "出手相救");
    command("say 这颗蛇胆给你把。对你也许有些用处。");
    obj = new(__DIR__ "obj/she_dan");
    obj->move(me);
    tell_object(me, "杨过给你一颗蛇胆。\n");
  }

}

int do_nod(string arg, object me) {
  object sword, obj;
  if (!arg) {
    tell_object("\n你愿意吗?(yes/no)");
    input_to("do_nod", 1, me);
  }
  if (arg == "yes" || arg == "y") {
    command("say 好！既然如此，杨某谢过了。");
    command("say 这把重剑跟随我多年。就送给" + RANK_D->query_respect(me) + "吧。");
    obj = new(__DIR__ "obj/xuantie_sword");
    obj->move(me);
    tell_object(me, "杨过给你一把玄铁重剑。\n");
    message_vision(CYN "杨过如释负重。长长舒了口气。看了小龙女一眼：我们走吧？\n"
      "小龙女幸福的答应了。\n"
      "杨过拉着小龙女的手几个纵越，飘然而去。\n" NOR, me,);
    call_out("dest_it", 1);
  } else if (arg == "no" || arg == "n") {
    command("say 既然如此。也就罢了。为了感谢" + RANK_D->query_respect(me) + "出手相救");
    command("say 这颗蛇胆给你把。对你也许有些用处。");
    obj = new(__DIR__ "obj/she_dan");
    obj->move(me);
    tell_object(me, "杨过给你一颗蛇胆。\n");
  } else {
    tell_object("\n你愿意吗？(yes/no)");
    input_to("do_nod", 1, me);
  }
}


int dest_it() {
  object *npc;
  int i;
  for (i = 0; i < sizeof(all_inventory(environment(this_object()))); i++) {
    if (!living(npc[i]))
      continue;
    if (userp(npc[i]))
      continue;
    if (npc[i]->query("id") == "xiao long nv") {
      destruct(npc[i]);
      break;
    }
  }
  destruct(this_object());
}

int ask_me() {
  object me;
  string msg;
  me = this_player();
  msg = CYN "杨过悠悠的叹了口气。唉～　　～　　～　\n"
    "十六年前我和爱妻失散之后一直没有见到她。不知道她现在\n"
    "在那里。什么时候才可以相见啊？\n" NOR;
  message_vision(msg, me);
  return 1;
}

int accept_object(object me, object ob) {
  string msg;
  if (ob->query("标记/绝情谷的蜜蜂")) {
    msg = CYN "杨过接过$N的" + ob->name() + ",当他看到--我在绝情谷低--几个字\n"
      "的时候，竟然留下了热泪。自言自语道：姑姑是不会死的。姑姑是\n"
      "不会死的。我这就去绝情谷找他。这位" + RANK_D->query_respect(me)->query_respect(ob) + "。得罪。我先去了.\n"
      "杨过说完话。立刻飞奔而去。大雕也紧跟走了。\n";
    message_vision(msg, me);
    call_out("do_dest", 2);
    return 1;
  } else
    return 0;
}

int do_dest() {
  object bird;
  bird = present("roc", environment(this_object()));
  if (!userp(bird))
    destruct(bird);
  destruct(this_object());
}

int start_speek1(object me)  // 由绝情谷/d/ultimate/jueqinggu.c 调用。
{
  string msg;

  msg = CYN "杨过喃喃念道：十年生死两茫茫，不思量，自难忘。\n"
    "千里孤坟，无处话凄凉。纵使相逢应不识，尘满面，鬓如霜。\n" NOR;
  message_vision(msg, me);
  call_out("start_speek2", 5, me);
}

int start_speek2(object me) {
  string msg;
  command("sigh");
  msg = NOR "杨过说道:他是十年生死两茫茫，我和龙儿已相隔一十六年了。\n"
    "他尚有个孤坟，知道爱妻埋骨之所，而我却连妻子葬身何处也自不知。\n"
    "夜来幽梦忽还乡，小轩窗，正梳妆；相对无言，惟有泪千行！\n"
    "料想年年肠断处,明月夜，短松岗。\n"
    "唉～　～　～： 而我，而我，三日三夜不能合眼竟连梦也做不到一个！\n" NOR;
  message_vision(msg, me);
  call_out("start_speek3", 5, me);
}
int start_speek3(object me) {
  string msg;
  msg = YEL "杨过忽然开始纵声长啸：啊～　～　～　～　～\n" NOR
    "断肠崖上数百朵憔悴了的龙女花飞舞乱转，随着啸声飞舞着\n"
    CYN "杨过轻轻说道：当年你突然失踪，不知去向，我寻遍山前山后.\n"
    "找不到你，那时定是跃入了这万丈深谷之中，这十六年中，难道\n"
    "你不怕寂寞吗？\n" NOR;
  message_vision(msg, me);
  call_out("start_speek4", 5, me);

}

int start_speek4(object me) {
  string msg;
  msg = CYN "杨过双足一登，身子飞起，跃入了深谷之中。。。。。\n"
    "大雕惊叫了一声，但是已经来不及了。杨过已经向深渊坠落了下去。\n" NOR;
  message_vision(msg, me);
  tell_object(me, "你愿意下去吗？\n");
  me->set_temp("yangguo_dive_water", 1);  // 杨过从悬崖高出跳了下来。
  destruct(this_object());
}

int thank_player(object me)  // 由/d/ultimate/small_house.c调用
{

  string msg;
  msg = CYN "杨过看到$N走了进来。吃惊的望着$N。\n"
    "杨过喜道：想不到这位" + RANK_D->query_respect(me) + "如此侠义心肠。\n"
    "竟然如此关心我杨某。杨某实在感激。虽然我和爱妻重逢。\n"
    "但是现在周围都是悬崖峭壁。我们如何走的出去。我和爱妻\n"
    "可以终生留在此地。但是不能让" + RANK_D->query_respect(me) + "陪我们\n"
    "一辈子。\n"
    "$N连忙把刚才如何下来详细说了一遍。杨过听后大喜过望。三人决定\n"
    "冒险爬上去。\n" NOR;
  message_vision(me, msg);
  this_object()->delete("startroom");  //防止被系统清除。
  call_out("climb_up", 3, me);
}

int climb_up(object me) {
  string msg;
  object yangguo, xiaolongnv;

  yangguo = this_object();
  xiaolongnv = present("xiao long nv", environment(this_object()));

  xiaolongnv->delete("startroom");
  me->move("/d/ultimate/gu_di1");
  yangguo->move("/d/ultimate/gu_di1");
  xiaolongnv->move("/d/ultimate/gu_di1");
  tell_object(me, "一行三人来到了水潭旁边。");
  msg = HIR "杨过深情的望了小龙女一眼。\n";
  message_vision(msg, me);
  command("say 龙儿。拉紧我的手！");
  msg = "杨过和小龙女一个猛子扎了下去。\n";
  message_vision(msg, me);
  call_out("come_shuitan", 3, me, yangguo, xiaolongnv);
}

int come_shuitan(object me) {
  object room, xiaolongnv, yangguo;
  xiaolongnv->move("/d/ultimate/shuitan");
  yangguo->move("/d/ultimate/shuitan");
  me->move("/d/ultimate/shuitan");
  tell_object(me, "你奋力从水底潜了上来。杨过和小龙女早已经上来了。\n");
  tell_object(me, "杨过揽着小龙女奋力朝上面爬去。");
  xiaolongnv->move("/d/ultimate/jueqinggu");
  yangguo->move("/d/ultimate/jueqinggu");
  room = environment(yangguo);
  room->set("no_fight", 1);  // 防止有人在上面打架.
  tell_object(me, "杨过和小龙女已经安全上去了。你也该爬上去了(climb up)\n");
  me->set_temp("标记／杨过", 1);
  return 1;

}
