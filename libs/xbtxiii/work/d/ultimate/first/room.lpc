// Room: /obj/ultimate/room.c 独孤求败生前的密室。

#ifndef ROOMDATA
#define ROOMDATA "/data/room/"
#endif
#define ROOM ROOMDATA + "dugu_qiubai_room"
inherit F_SAVE;

#include <ansi.h>

string query_save_file()
{
        return ROOM;
}

inherit ROOM;
string look_words(object me);
void create()
{
        seteuid(getuid());
if(!restore())
        {
        set("short", "石头密室");
        set("long","四周全部都是石头，奇怪的是所有的石头都异常光滑。\n"
        	   "似乎是有人特意打磨过。仔细观察四周。似乎有些模模糊糊\n"
        	   "的字迹。\n");
        set("exits", ([ /* sizeof() == 2 */
  	    "out" : "/d/ultimate/first/door",
  	    ]));
		set("item_desc",([
            "words" :  (:look_words:),
            "字"  :  (:look_words:),
            "stone": "地面的一块石头有些奇怪。",
            "石头": "地面的石头有些奇怪。",
  	    set("first_stone",0);
  	    }
        setup();        
       
}

int init()
{
	add_action("do_find",({"find","search"}));
	add_action("do_cut",({"cut","dig","drug","挖");
}	


int do_find()
{
	object me;
	me=this_player();
	tell_object(me,"你仔细在地面观察。终于找到了一块特别的石头。\n"
			"可是试试挖一挖\n");
	remove_action("do_find","find");
	remove_action("do_find","search");
	return 1;
	
}
int do_cut(string arg)
{
	object weapon,first_stone;
if(!arg)
	return notify_fail("你要挖什么东西？\n");
if(arg=="stone"||arg=="石头")
	{
	weapon=me->query_temp("weapon");
	if(!weapon)
		return notify_fail("你想用手挖石头？佩服！佩服！实在是佩服！\n");
	if(weapon->query("weapon_prop/damage")<=60)
		return notify_fail("你尝试着用"+weapon->name()+"挖了挖。无奈"+weapon->name()+"\n"
				"太钝了。丝毫不起作用。换吧锋利一些的武器吧！\n");
	else
		{
		message_vision(CYN"$N奋力挖了几下石头，挖了一个小坑。\n");
		weapon->add("weapon_prop/damage",-random(3)-1);
		add("dig_numbers",1);
		}
	if(query("first_stone")<1)
		{
		if(query("dig_numbers")>=10)
			{
			message_vision("$N挖着挖着。一颗晶莹透亮的东西蹦了出来。\n");
			first_stone=new("/d/ultimate/obj/first_stone");
			first_stone->move(this_object());
			set("first_stone",1); // 已经被挖了出来。
			remove_action("do_cut","cut");
			remove_action("do_cut","dig");
			remove_action("do_cut","drug");
			remove_action("do_cut","挖");
			this_object()->save();
			}
		}
	else
		{
		if(query("dig_numbers")>=10)
			{
			message_vision("$N挖着挖着。挖开了一个小洞。不过里面的东西好象已经被人拿走了。\n");
			remove_action("do_cut","cut");
			remove_action("do_cut","dig");
			remove_action("do_cut","drug");
			remove_action("do_cut","挖");
			}		
		}
	}
	return 1;
}

string look_words(object me)
{
	return "还没有完工。稍等。呵呵。\n";
}