//  ninemoon_book.c

#include <ansi.h>
inherit ITEM;

void create() {
  set_name("九阴真经", ({ "jiuyin_book" }));
  set_weight(600);
  set("no_sell", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("long",
      "这是一本看起来很旧的书，封面上写着四个篆字：九阴真经。\n");
    set("value", 100000);
    set("material", "paper");
    set("skill", ([
      "name": "jiuyin-strike",
      "exp_required": 100000,
      // to learn this skill.
      "sen_cost": 60,
      "difficulty": 30,    // the base int to learn this skill
      // modify is gin_cost's (difficulty - int)*5%
      "max_skill": 100,    // the maximum level you can learn
      "min_skill": 0    // the maximum level you can learn
      // from this object.
    ]));
  }
}
init() {
  add_action("do_study", "study");
}

int do_study(string arg) {
  object me, ob;
  string skill;
  me = this_player();
  if (me != environment())
    return 0;
  if (arg != "jiuyin_book") return 0;
  if (stringp(skill = me->query_skill_mapped("force"))) {
    printf("你读了九阴真经,似乎有些心得。\n");
    me->improve_skill(skill, random(10));
    me->receive_damage("sen", me->query_skill(skill));
    if (random(100) < 1)
      message("channel:rumor",
        HIM "【谣言】某人：" + me->name() + "已经夺取了九阴真经，正在暗地里修行,大家快来抢啊！\n" NOR, users());
  } else printf("你没学到任何东西。\n");
  return 1;
}
