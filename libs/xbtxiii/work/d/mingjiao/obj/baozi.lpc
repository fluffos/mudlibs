// dumpling.c 包子

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("素馅小笼包", ({"baozi", "dumpling"}));
        set_weight(80);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一笼香喷喷的素馅包子，皮薄馅靓，让人垂涎欲滴。\n");
                set("unit", "笼");
                set("value", 25);
                set("food_remaining", 6);
                set("food_supply", 50);
       }
}
