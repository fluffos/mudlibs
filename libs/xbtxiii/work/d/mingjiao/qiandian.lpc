inherit ROOM;

void init();

void create()
{
        set("short","明教前殿");
        set("long",
"走进这里，突感一阵肃穆之意，殿中十分空旷，殿顶高悬一排金\n"
"灯，两旁是精壮的佩剑武士，剑气森严逼人，北边漏出一点灯光。\n"
"五个奇形怪状的人站在周围。\n"
);
        set("exits",([
            "north" : __DIR__"dadian",
            "east":__DIR__"piandian1",
            "west":__DIR__"piandian2",
            "south":__DIR__"menting",

           ]));
        set("objects",([

                        "/d/mingjiao/npc/zhoudian":1,
                        "/d/mingjiao/npc/pengyingyu":1,
                        "/d/mingjiao/npc/zhangzhong":1,
                        "/d/mingjiao/npc/shuobude":1,
                       "/d/mingjiao/npc/lengqian":1,
]));
         setup();
}
