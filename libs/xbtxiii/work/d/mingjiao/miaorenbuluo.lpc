//miaorenbuluo.c

inherit ROOM;

void create() {
  set("short", "苗人部落");
  set("long",
    "你眼前突然一亮，原来是走进了一个苗人部落。苗人们围坐在火\n"
    "堆边，面色虔诚，好象在作某种祭神仪式。几个巫士挥舞着木镗，\n"
    "口中念念有词。突然，他们好象发现了你。\n"
  );
  set("exits", ([
    "north": __DIR__ "westroad2",
    "south": "/d/npc/m_weapon/liandaoshi.lpc",
  ]));
  set("objects", ([
    "/d/mingjiao/npc/miaozuwushi": 4,
  ]));
  setup();
}
int valid_leave(object me, string dir) {

  if ((dir == "south") && objectp(present("wushi", environment(me))))
    return notify_fail("巫士拦住你喝道：%$%#*^&$^$^%^*%^$！\n");
  return ::valid_leave(me, dir);
}
