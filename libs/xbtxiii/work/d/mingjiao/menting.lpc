inherit ROOM;

void init();

void create()
{
        set("short","明教前厅");
        set("long",
"门厅正中是一堆燃烧的火焰（huo），这就是明教千年不灭的圣\n"
"火。火焰周围围坐着八个白袍武士。他们身上的白袍上印着血红\n"
"的火焰，手指曲成火焰的形状，正在低声吟唱着什么。\n"
);
        set("exits",([
            "north" : __DIR__"qiandian",
            "south" : __DIR__"dianmen",
           ]));
        set("objects",([
                        "/d/mingjiao/npc/wushi":8,
                                ]));
        setup();
}
