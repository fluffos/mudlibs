//room /d/mingjiao/dianmen.c
// pll 1998.4.1

inherit ROOM;

void init();

void create()
{
        set("short","圣殿大门");
        set("long",
"终于来到这期盼已久的圣地了。两扇刻着火焰的巨大石门立在你\n"
"的面前。那边就是明教的总坛，英雄的教主张无忌就在里面等着\n"
"自己！！！！非明教弟子不得入内！！\n"
);
        set("exits",([
            "north" : __DIR__"menting",
            "east" : __DIR__"lhqmen",
           ]));
        set("objects",([
                        "/d/mingjiao/npc/wushi":8,
                        ]));
        setup();
}
 
int valid_leave(object me, string dir)
{
  if( dir=="north" && me->query("family/family_name")!="明教")
                return notify_fail("！！非明教弟子不得入内！！\n");
        return ::valid_leave(me, dir);
}
