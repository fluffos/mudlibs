//TOHSQ4.C

inherit ROOM;

void create() {
  set("short", "山路");
  set("long",
    "山路到这里似乎变得宽阔了些。清新的山风扑面而来，令人精神\n"
    "顿为一爽。远处传来淙淙水声，渐行渐远。山壁上挂满了厚密的\n"
    "藤萝，随风轻轻摇弋。\n"
  );

  set("exits", ([
    "north": __DIR__ "tohsq5",
    "south": __DIR__ "tohsq2",
  ]));

  set("outdoors", "mingjiao");
  setup();
}
