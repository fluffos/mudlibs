#pragma save_binary

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "华山密室");
        set("long",
"这里是一间窄小的密室,好象很久没人来这呆过了。密室的墙壁\n"
"上画满了围棋棋谱。好象很深奥，你一点也看不懂。另一面墙上\n"
"刻了许多音律。都是些失传了的谱子。其中就有著名的广陵曲。\n"
);
        

        setup();
}



void pipe_notify()
{
        object ob;

        message("vision",
                "你听到一阵轧轧的轮盘绞动声，一块大石慢慢地被移开了。\n",
                this_object() );
        set("exits/west", __DIR__"yanfeng" );
        if( ob = find_object(__DIR__"yanfeng") )
                ob->set("exits/east", __FILE__);
}


void close(object room)
{
    message("vision","崖上忽然掉下来一块巨石，将洞口封了个严严实实。\n", room);
    room->delete("exits/west");
}