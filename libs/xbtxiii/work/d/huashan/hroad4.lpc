);
      set("exits", ([ /* sizeof() == 2 */
   "east" : __DIR__"hroad2",
   "north" : "/d/village/sexit",
   "southwest" : "/d/xingxiu/xxroad1",
]) );
      set("no_clean_up",0);

	      setup();
      replace_program(ROOM);
}
