#pragma save_binary
// Room: /d/snow/hroad1.c

inherit ROOM;

void create() {
  set("coor", ({ -700, 2500, 0 }));
  set("short", "黄土大道");
  set("long",
    "你一路往西行，正是秋高气爽，百草凋零，微风过面，略有寒意。\n"
    "路上时有满脸风尘的旅人行色匆匆地擦肩而过。偶尔有装饰华丽\n"
    "的马车从你身边经过，车帘起伏，隐约可闻幽香阵阵，环佩叮当。\n"
    "远处，山峦叠嶂，山脚零星散落着几处农家茅舍。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": "/d/huashan/hroad2",
    "east": "/d/city/yiroad4",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "snow");
  //	set("objects",(["/d/snow/npc/txtrainee": 3]));
  setup();
  replace_program(ROOM);
}
