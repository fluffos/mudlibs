#pragma save_binary
// husun.c
#include <roadbusy.h>

inherit ROOM;

void create() {
  set("coor", ({ -550, 2600, 300 }));
  set("short", "猢狲愁");
  set("long",
    "前面又是一处十分陡峭的山岭，上面有四只铁猿，盘踞台畔，据\n"
    "说以前从华山水帘洞出来的猿猴，每到这里就要返回去，连它们\n"
    "也感到难于超越，此岭因而得名。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "northdown": __DIR__ "laojun",
    "southup": __DIR__ "zhenyue",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "huashan");

  setup();
  //        replace_program(ROOM);
}
