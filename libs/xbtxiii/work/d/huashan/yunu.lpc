#pragma save_binary
// yunu.c

inherit ROOM;

void create() {
  set("coor", ({ -400, 2500, 600 }));
  set("short", "玉女峰");
  set("long",
    "这里是华山的中峰，玉女峰。玉女峰地势略为平缓，不似其它四\n"
    "峰般险峻，江湖上赫赫有名的华山剑派就在此处。西边有所小小\n"
    "的庙宇，那就是玉女祠了。东北面稀稀落落有十几间房子，是华\n"
    "山派的地方，闲杂游客最好别往那里去。\n"
  );
  set("exits", ([ /* sizeof() == 3 */
    "westdown": __DIR__ "zhenyue",
    "west": __DIR__ "yunuci",
    "south": __DIR__ "shanlu",
    "north": __DIR__ "square",
    "northeast": __DIR__ "xiaolu1",
    "southup": "/d/huashan/xiaojing",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("objects", ([
    __DIR__ "npc/lingshan": 1,
  ]));

  setup();
  replace_program(ROOM);
}
