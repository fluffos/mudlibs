#pragma save_binary
// Room: /huashan/jiulou1.c

inherit ROOM;

void create()
{
	add_light(this_object(),1);
	set("coor",({-450,2600,600}));
	set("short", "山顶小店");
	set("long",
"这里是华山山顶的一间小店，卖些简单的饮食，专门赚那些游客\n"
"的钱。\n"
);

	set("exits", ([
		"east" : __DIR__"square",
	]));

	set("objects", ([
        __DIR__"npc/xiaoer" : 1,
	]));

	setup();
	replace_program(ROOM);
}

