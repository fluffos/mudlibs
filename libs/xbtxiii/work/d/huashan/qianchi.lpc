#pragma save_binary
// qianchi.c

inherit ROOM;

void create() {
  set("coor", ({ -600, 2800, 100 }));
  set("short", "千尺幢");
  set("long",
    "前面有一斜如天垂石梯的山阶，这就是赫赫有名的千尺幢，千尺\n"
    "幢是依一陡峭岩脊的裂缝开凿而成，斜度约七十度，高约二十米，\n"
    "仅容一人上落。如果不是精气十足，还是不要冒险攀登的好。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "westdown": __DIR__ "qingke",
    "southup": __DIR__ "baichi",
  ]));

  set("objects", ([
    __DIR__ "npc/youke": 2,
  ]));

  set("no_clean_up", 0);
  set("outdoors", "huashan");

  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "southup") {
    me->add("gin", -30);
    me->add("kee", -30);
    me->add("sen", -30);
  }
  return 1;
}
