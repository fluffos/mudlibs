#pragma save_binary
// xiaojing.c

inherit ROOM;

void create() {
  set("coor", ({ -400, 2300, 800 }));
  set("short", "玉女蜂小径");
  set("long",
    "这里是玉女蜂后山的一条小径。路边长满了翠竹，每当微风拂过，\n"
    "竹叶便沙沙作响，显得分外的幽静。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "northdown": __DIR__ "yunu",
    "southup": __DIR__ "siguoya",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "huashan");

  setup();
}
