// buwei1.c

inherit ROOM;

int valid_leave();

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -400, 2650, 600 }));
  set("short", "客厅");
  set("long",
    "这是华山掌门岳不群的居所「有所不为轩」，此处是前厅，厅上\n"
    "挂着「正气堂」三字匾额。厅中很宽敞，却没什么摆设，靠墙放\n"
    "着两把交椅，这里是岳不群议事、授徒的地方，后面是寝室。\n"
  );

  set("valid_startroom", 1);

  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "square",
    "north": __DIR__ "buwei2",
  ]));

  set("objects", ([
    CLASS_D("huashan") + "/linghu": 1,
  ]));
  set_temp("light", 1);

  set("no_clean_up", 0);

  setup();
}

int valid_leave(object me, string dir) {
  if (dir != "north")
    return ::valid_leave(me, dir);

  if (dir == "north" && objectp(present("ling huchong", environment(me)))) {
    if ((me->query("family/family_name") == "华山派")) {
      if (me->query("family/master_id") == "ling huchong") {
        write("令狐冲侧身让开，说道：徒儿辛苦了，去里面休息休息吧。\n");
        return 1;
      }
      if (me->query("family/master_id") == "feng qingyang") {
        write("令狐冲面带微笑侧身让开，说道：师叔辛苦了，去里面休息休息吧。\n");
        return 1;
      }
      if (me->query("family/master_id") == "master yue-buqun") {
        if (me->query("gender") == "女性")
          write("师妹请进。呵呵。。。。\n");
        else
          write("师弟请进。。。。。\n");
        return 1;
      }
      if (wizardp(me)) {
        write("贵客架到。请进！！！请进！！！\n");
        return 1;
      }
    } else
      return notify_fail(
        "令狐冲喝道：后面是家师寝室，这位" + RANK_D->query_respect(me) + "请止步。\n");
  }
  return ::valid_leave(me, dir);
}
