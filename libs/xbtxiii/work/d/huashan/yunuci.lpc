// yunuci.c

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -450, 2500, 600 }));
  set("short", "玉女祠");
  set("long",
    "玉女祠里供奉的到底是哪位玉女，有许多不同的说法，现在所能\n"
    "看到的只一尊呆板的石像。祠中大石上有一处深陷，凹处积水清\n"
    "碧，这是玉女的洗脸盆，碧水终年不干。\n"
  );
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "yunu",
  ]));
  set("resource/water", 1);
  set_temp("light", 1);

  set("objects", ([
    CLASS_D("huashan") + "/yue-wife": 1,
    CLASS_D("huashan") + "/master": 1,
  ]));

  setup();
  call_other("/obj/board/huashan_b", "???");
}
int clean_up() { return 0; }
