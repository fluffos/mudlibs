#pragma save_binary
// qingke.c
#include <roadbusy.h>

inherit ROOM;

void create()
{
	set("coor",({-610,2800,50}));
	set("short", "青柯坪");
	set("long",
"走过崎岖的十八盘，穿过云门，就到了青柯坪。青柯坪是一山间\n"
"盆地，地势略为平坦。从这里开始，上山的路都是由原地凿出的\n"
"石阶。北壁下大石当路，此石叫做回心石，再上去山道奇险，游\n"
"客至此，就该回头了。远远望见一个小小石亭，便是赌棋亭了。\n"
"相传宋太祖与华夷先生曾弈棋于此，将华山作为赌注，宋太祖输\n"
"了，从此华山上的土地就不须缴纳钱粮。\n"
);
	set("exits", ([ /* sizeof() == 2 */
		"northdown" : __DIR__"shaluo",
		"eastup" : __DIR__"qianchi",
	]));
	set("no_clean_up", 0);
	set("outdoors", "huashan" );

	setup();
//        replace_program(ROOM);
}
 
