#pragma save_binary
// yuquan.c

inherit ROOM;

void create() {
  set("coor", ({ -620, 2780, 0 }));
  set("short", "玉泉院");
  set("long",
    "这里因屋后的玉泉而得名，是宋代陈希夷隐居的地方。周围生着\n"
    "十二株大龙藤，夭矫多姿，枝干中空，就如飞龙相似，相传是希\n"
    "夷先生陈抟老祖所植。\n"
  );

  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "path1",
  ]));

  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/teller": 1 ]));

  setup();
}
