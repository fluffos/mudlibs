// square.c

#include <ansi.h>
inherit ROOM;

void create()
{
	set("coor",({-400,2600,600}));
	set("short", "练武场");
	set("long",
"这里是华山派的练武场，通常有许多华山派弟子在此习武练剑，\n"
"所以不欢迎外人。而今，华山派不知为何举派离山而去，只留几\n"
"个弟子看家，他们似乎无心管那么多，就有些游客在此休息。北\n"
"边的房屋门上挂着一块匾，上书「有所不为轩」，东面是华山派\n"
"弟子存放兵器的地方。\n"
);
	set("exits", ([ /* sizeof() == 2 */
		"south" : __DIR__"yunu",
		"north" : __DIR__"buwei1",
		"east" : __DIR__"bingqifang",
		"west" : __DIR__"xiaodian",
	]));

	set("objects", ([ 
		__DIR__"npc/dayou" : 1,
	]));

	set("outdoors", "huashan" );

	setup();
}



void init()
{
        add_action("do_practice","practice");
}

int do_practice()
{
         
        int t, d, h, m, s;
        object me,fengqingyang;
        me=this_player();
        t = uptime();
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

if (m==1&&me->query("family/family_name")=="华山派")
       {
       message_vision(CYN"哈哈哈。。。一声大笑声突然从门口传来.$N连忙闻声看去.\n"
					  "发现大笑之人赫然是华山派早已不问世事的风清扬老前辈。\n"NOR,me);
       fengqingyang=new("/daemon/class/huashan/feng");
       fengqingyang->move(environment(me));
       fengqingyang->come_in(me);
       remove_action("do_practice","practice");
       return 1;
       }
}

