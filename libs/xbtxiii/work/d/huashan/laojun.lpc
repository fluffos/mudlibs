#pragma save_binary
// laojun.c

inherit ROOM;

void create()
{
	set("coor",({-550,2700,200}));
	set("short", "老君沟");
	set("long",
"爬过两个要命的悬崖，可在这里稍作歇息。老君沟是一条半里多\n"
"长的山沟，相传为太上老君所开，故名老君沟。\n"
);
	set("exits", ([ /* sizeof() == 2 */
		"westdown" : __DIR__"baichi",
		"southup" : __DIR__"husun",
	]));

	set("objects", ([ 
		__DIR__"npc/laodenuo" : 1,
	]));

	set("no_clean_up", 0);
	set("outdoors", "huashan" );

	setup();
	replace_program(ROOM);
}
