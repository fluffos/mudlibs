#pragma save_binary

inherit ROOM;

void create() {
  set("coor", ({ 2500, 3800, 0 }));
  set("short", "海港");
  set("long",
    "这里是从倚云出海的必经之地，据说从这里可以出海到蓬莱岛。\n"
  );

  set("exits", ([
    "west": "/u/cloud/eroad4",
  ]));

  set("objects", ([
    __DIR__ "npc/chuanfu": 1,
    "/d/chaoting/npc/japanese": 1,
  ]));

  set("outdoors", "snow");
  setup();
}
