#pragma save_binary
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "冰火岛");
  set("long",
    "这是一个荒芜的小岛，岛的东边是一片树林，西边则是一座活火\n"
    "山，正在冒着浓烟。岛的东北边是万年不化的玄冰，这种鬼地方\n"
    "还是少呆为妙。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "icefire2",
    "east": __DIR__ "icefire3",
  ]));
  set("objects", ([
    __DIR__ "npc/xiexun": 1,
  ]));
  set("no_arrest", 1);
  setup();
}
void init() {
  add_action("do_save", "save");
}
int do_save(string arg) {
  tell_object(this_player(), "在这种鬼地方存盘，还是免了吧！\n");
  return 1;
}
int clean_up() {
  return 0;
}
int reset() {
  if (query("Reset"))
    return 0;
  ::reset();
  set("Reset", 1);
}
