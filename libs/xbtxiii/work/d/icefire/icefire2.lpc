#pragma save_binary
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "冰火岛");
  set("long",
    "这是小岛上的冰窟，里面都是万年不化的玄冰，西边则是一座活\n"
    "火山，正在冒着浓烟。哇，好冷哟！这种鬼地方还是少呆为妙。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "icefire1",
  ]));
  set("objects", ([
  ]));
  set("no_arrest", 1);
  setup();
}
void init() {
  add_action("do_save", "save");
}
int do_save(string arg) {
  tell_object(this_player(), "在这种鬼地方存盘，还是免了吧！\n");
  return 1;
}
