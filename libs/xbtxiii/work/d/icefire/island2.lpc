#pragma save_binary
#include <ansi.h>
inherit ROOM;
 
void create()
{
        set("short", "灵蛇岛");
        set("long",
"这是一个神秘的小岛，岛上看来并没有受到人类的滋扰，到处是\n"
"各种奇异的花花草草，四周古树参天，枯藤交错，荆棘密布，浓\n"
"密宽厚的树叶遮蔽了日月星辰，使人分不出昼夜。四下如死一般\n"
"的寂静，只有风吹过树梢的沙沙之声。朝远方远眺，密林深处显\n"
"得更加幽深，平添了几分神秘的感觉。\n"
);
        set("exits", ([ /* sizeof() == 2 */
          "west":__DIR__"island3",
          "east":__DIR__"island1",
]));
        setup();
}
