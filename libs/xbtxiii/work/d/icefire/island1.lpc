#pragma save_binary
#include <ansi.h>
inherit ROOM;
 
void create()
{
        set("short", "灵蛇岛");
        set("long",
"这是荒芜的小岛东边的一片树林，西边则是一座活火山，正在冒\n"
"着浓烟。你看见海滩上有一个木筏(mufa)，似乎可以用它返回中\n"
"原。\n"
);   
        set("exits", ([ /* sizeof() == 2 */
          "west":__DIR__"island2",
]));
        set("item_desc", ([
                "mufa": @TEXT
这是一个木筏,上面放满了淡水和食物。
大概可以支持着回到中原。(hui zhongyuan)
TEXT        ]) );
        setup();
}
void init()
{
		add_action("do_back", "hui");
}
int do_back(string arg)
{
		object me;
		me=this_player();
		tell_object(me,"你跳上木筏，拼命的划向大海！\n");
		me->move(__DIR__"seaback");
		call_out("goto_home",15,me);
		return 1;
}
void goto_home(object me)
{
		tell_object(me,"你在海上不知偏流了多久，终于看到了陆地，于是你拼命的划向陆地！\n");
		me->move("/d/sea/seaside");
		tell_object(me,"又回到陆地了，太好了！不过你也累的半死了。\n");
		me->set("kee",0);
		me->set("gin",0);
		me->set("sen",0);
		me->set("force",0);
		me->set("atman",0);
		me->set("mana",0);
                me->set_explore("north#8");
}
