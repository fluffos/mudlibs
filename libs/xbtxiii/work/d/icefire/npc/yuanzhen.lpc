#pragma save_binary
#include <ansi.h>
inherit NPC;
inherit F_MASTER;


void create()
{
    set_name("圆真", ({"yuan zhen","yuan","zhen","yuanzhen"}));
	set("long",
		"他是一位须发花白的老僧，身穿一袭金边黑布袈裟。他身材瘦高，\n"
		"太阳穴高高鼓起，似乎身怀绝世武功。\n"
	);

	set("gender", "男性");
	set("class", "bonze");

	set("age", 60);
	set("str", 40);
	set("int", 25);
	set("con", 25);
	set("force", 1000);
	set("max_force", 1000);
    set("max_kee", 5000);
	set("force_factor", 100);
	set("combat_exp", 1550000);

	set_skill("force", 150);
	set_skill("hunyuan-yiqi", 150);
	set_skill("dodge", 150);
	set_skill("shaolin-shenfa", 150);
	set_skill("unarmed", 150);
	set_skill("nianhua-zhi", 150);
	set_skill("parry", 150);

	map_skill("force", "hunyuan-yiqi");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("unarmed", "nianhua-zhi");
	map_skill("parry", "nianhua-zhi");


	create_family("少林派", 36, "弟子");

    set("title",HIW"少林"CYN"圆字辈大师"NOR);
	setup();

    carry_object("/obj/cloth")->wear();
}

void die()
{
	object me,obj;
	me=query_temp("last_damage_from");
if(me&&userp(me)&&me->query_temp("杨逍/帮我杀成昆"))
	{
    message_vision("$N杀死了圆真，顺便将他的脑袋取了下来。\n",me);
	obj=new(__DIR__"obj/head");
	obj->move(me);
	me->set_temp("杀了圆真",1);
        me->set_explore("south#36");
	}	
	::die();
}
