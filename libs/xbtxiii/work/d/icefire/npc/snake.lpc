#pragma save_binary

inherit NPC;
void use_poison();

void create()
{
        set_name("响尾蛇", ({ "snake" }) );
        set("race", "野兽");
        set("age", 4);
        set("long", "一条剧毒的响尾蛇。\n");

        set("limbs", ({ "头部", "身体", "尾巴", "七寸" }) );
        set("verbs", ({ "bite" }) );
        set("attitude", "aggressive");
        set_skill("dodge", 50);
        set("combat_exp", 99);
	set("bellicosity", 300 );
        set("chat_chance", 20);
        set("chat_msg", ({
                (: random_move :),
        }) );

        set_temp("apply/attack",100);
        setup();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) ) {
                kill_ob(ob);
        }
}

