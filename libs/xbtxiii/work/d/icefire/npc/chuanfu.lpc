#pragma save_binary
// chuanfu.c 老船夫

#include <ansi.h>


inherit NPC;
int chu_hai();

void create() {
  set_name("老船夫", ({ "lao chuanfu", "chuanfu" }));
  set("gender", "男性");
  set("age", 56);
  set("long",
    "这是一个老船夫。饱经风霜的脸上透出一丝狡猾。他经常出海，据说以前曾经\n"
    "去过蓬莱岛。现在他拥有一艘大船可以出海。\n",
  );

  set("combat_exp", 1000000);

  set("eff_kee", 2000);
  set("kee", 2000);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 100);

  set_skill("force", 200);
  set_skill("unarmed", 400);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set("inquiry", ([

    "蓬莱岛": "蓬莱岛可是人间仙境，只是海上多风暴，去的话十有八九会船翻人亡，千万不能去！\n",
    "蓬莱": "蓬莱岛可是人间仙境，只是海上多风暴，去的话十有八九会船翻人亡，千万不能去！\n",
    "出海": (: chu_hai :),
    "灵蛇岛": "灵蛇岛啊？那地方我也听说过。不过我也不知道地方，除非有海图\n",
    "冰火岛": (: chu_hai :),

  ]));

  setup();
  carry_object("/obj/cloth")->wear();
}

int chu_hai() {
  object ob;
  ob = this_player();
  message_vision("老船夫上上下下打量了$N一下：什么！出海？你不要命了？！\n"
    "老船夫又想了一下：不过...如果给我二十两金子，或许可以考虑。\n"
    , ob);
  return 1;
}

int accept_object(object who, object ob) {
  object obj;
  if (ob->query("money_id") && ob->value() >= 200000) {
    message_vision("老船夫嘿嘿一笑，说：出海风险太大,这位" + RANK_D->query_respect(who) +
      "还是仔细考虑一下吧!\n", who);
    if (who->query("combat_exp") < 200000 || random(3) > 1) {
      message_vision("$N仔细考虑了一番，还是决定取消出海的打算了。\n", who);
      return 0;
    }
  } else if (ob->query("money_id") && ob->value() < 200000) {
    message_vision("老船夫皱眉对$N说：您给的也太少了吧？\n", who);
    return 1;
  } else if (ob->query("灵蛇岛的航海图") == "YES") {
    command("say 既然有去灵蛇岛的海图，那一切都好办。");
    command("say 上船吧！");
    call_out("come_to_snake_sea", 3, who, this_object());
    return 1;
  }


  message_vision("老船夫突然间出了神，好象想起了他的往事.\n", who);
  command("fear");
  command("say 这位客官，还是另找高明吧，我实在是不想去了。");
  message_vision("$N脸色一变，凶狠地说：你现在才说不去？不行，你去也得去，不去也得去！\n", who);
  message_vision("老船夫对$N说：好！既然这位" + RANK_D->query_respect(who) +
    "如此看得起我，\n那我也拼上这条破船，舍命陪君子便是！\n", who);
  this_player()->delete_temp("出海");
  message_vision("老船夫一招手，叫来几个年轻船夫。\n", who);
  message_vision("老船夫和$N上了船，一声「起锚」船就开走了......\n", who);
  obj = this_object();
  who->move("/d/icefire/dahai");
  obj->move("/d/icefire/dahai");
  tell_object(who, BLU "你在海上航行了很久很久.......\n" NOR);
  call_out("goto_dahai", 15, who, obj);
  return 1;

}

int come_to_snake_sea(object me, object obj) {
  me->move("/d/icefire/dahai");
  obj->move("/d/icefire/dahai");
  tell_object(me, "你在海上航行着...............\n");
  call_out("goto_snake", 10, me);
}

int goto_snake(object me) {
  me->move("/d/icefire/island1");
  tell_object(me, "没过多久，船就到了目的地。\n");
  this_object()->chuanfu_back(this_object());
}
void goto_dahai(object me, object obj) {
  tell_object(me, "忽然，海上掀起骇天巨浪。老船夫脸色大变，喝道：不好，起风暴了。"
    "\n只见一个巨浪打来，只听见豁嗤喇几声巨响，船身从中裂为两半\n"
    "你赶紧抱住一块木板，在海上漂浮......");
  me->move("/d/icefire/dahai1");
  call_out("chuanfu_back", 35, obj);
  if (random(3) > 0) call_out("goto_back", 15, me);
  else call_out("goto_icefire", 15, me);
}
void goto_back(object me) {
  tell_object(me, "你在海上不知漂流了多久，忽然看见远处似乎有个黑点，啊!陆地!!!\n");
  me->unconcious();
  me->set("force", 0);
  me->set("water", 0);
  me->set("food", 0);
  me->move("/d/sea/seaside");
  tell_room(environment(me), me->name(1) + "被海浪冲上海滩。\n");
}
void goto_icefire(object me) {
  tell_object(me, "你漫无目的的漂流着，只觉的周围的气温不断下降......好冷厄\n");
  tell_object(me, "你在海上不知漂流了多久，忽然看见远处似乎有个黑点，啊!陆地!!!\n"
    "你拼命向前划去\n");
  me->set("food", 0); me->set("water", 0);
  me->move("/d/icefire/icefire1");
  message_vision("$N漂到了冰火岛上......\n", me);

}
void chuanfu_back(object me) {
  me->move("/d/icefire/haigang");
}
