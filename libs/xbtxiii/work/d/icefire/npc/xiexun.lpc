#pragma save_binary
// XieXun.c
// pal 1997.05.09
// pll 1998.04.01

#include <ansi.h>

inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;

void create() {
  set_name("谢逊", ({ "xie xun", "xie", "xun", }));
  set("long",
    "他是一位身材魁伟异常的的老者，身穿一件白布长袍。\n"
    "他满头黄发，威风凛凛，真如天神一般，只是两只眼睛并不睁开。\n"
  );

  set("title", HIG "明教" HIY "金毛狮王" NOR);
  set("gender", "男性");
  set("attitude", "aggressive");
  set("chat_chance", 60);
  set("chat_msg", ({
    (: random_move :)
  }));

  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "成昆你这恶贼,拿命来！！\n",
  }));

  set("age", 63);
  set("str", 30);
  set("int", 30);
  set("con", 30);

  set("max_kee", 2000);
  set("max_gin", 1000);
  set("force", 5000);
  set("max_force", 4000);
  set("force_factor", 80);

  set("combat_exp", 1500000);

  set_skill("force", 260);
  set_skill("dodge", 160);
  set_skill("parry", 160);
  set_skill("blade", 150);
  set_skill("cibei-dao", 160);
  set_skill("unarmed", 160);
  set_skill("hunyuan-yiqi", 260);
  set_skill("shaolin-shenfa", 160);
  set_skill("qianye-shou", 170);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("unarmed", "qianye-shou");
  map_skill("parry", "cibei-dao");
  map_skill("blade", "cibei-dao");



  setup();

  carry_object("/d/mingjiao/obj/baipao")->wear();
  carry_unique(__DIR__ "obj/dragonblade", "/obj/weapon/blade")->wield();
}

void init() {
  object me, ob;
  me = this_object();
  ob = this_player();

  ::init();

  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, me, ob);
  }
}

