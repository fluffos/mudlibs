#pragma save_binary
//yitianjian.c
#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
    set_name("倚天剑", ({ "yitian jian", "yitian","jian" }) );
    set_weight(20000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        	set("unit", "柄");
            set("value", 1000000);
            set("material", "brass");
        	set("long", "这是天下第一利器，有“倚天不出，谁与争锋”之说。\n");
            set("wield_msg","$N举起$n，在空中挥舞了两下子。大声喝道：\n"
						CYN"\t\t武林至尊，宝刀屠龙。\n"
						HIR"\t\t号令天下，莫敢不丛。\n"
						HIW"\t\t倚天不出，谁与争锋？\n"NOR);
        	set("unwield_msg", "$N将$n插回腰间，华光顿敛，天地间只闻龙鸣。\n");
	}
        init_sword(200);
		setup();
}
void break_weapon()
{
    object book;
    book=new(__DIR__"jiuyinbook");
    book->move(environment());
    tell_room(environment(),"从倚天剑中跌出一卷薄绢\n");
    return;
}
