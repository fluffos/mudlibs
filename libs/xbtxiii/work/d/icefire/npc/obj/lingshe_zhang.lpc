#pragma save_binary
// 灵蛇拐杖。

#include <weapon.h>
#include <ansi.h>
inherit STAFF;

void create() {
  set_name(RED "灵蛇拐杖" NOR, ({ "lingshe_staff", "staff" }));

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "灵蛇拐杖非金非木，不知道是用什么东西打造的。坚硬异常。\n");
    set("value", 100000);
    set("material", "异类金属");
    set("wield_msg", "$N「唰」地一声从剑鞘里抽出一把$n握在手中。顿时周围充满了杀气!\n");
    set("unwield_msg", "周围的杀气消失了.却见$N将手中的$n插入腰间的剑鞘。\n");
    init_staff(100);
  }
  setup();

}
