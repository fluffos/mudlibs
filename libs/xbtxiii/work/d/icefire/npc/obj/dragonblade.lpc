#pragma save_binary
// houndbane.c

#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create() {
  set_name(GRN "屠龙刀" NOR, ({ "dragon blade", "blade" }));
  set_weight(17000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把乌沉沉的，非金非铁，不知是何物所制的大刀。\n"
      "据说此刀在手可以号令天下，无人敢不从。\n");
    set("value", 100000);
    set("material", "brass");
    set("wield_msg", "$N「飕」地一声抽出$n握在手中。\n"
      "喝道：武林至尊、宝刀屠龙。号令天下，莫敢不从。倚天不出，谁与争锋？\n");
    set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
  }

  init_blade(200);
  setup();
}
void break_weapon() {
  object book;
  book = new(__DIR__ "wumubook");
  book->move(environment());
  tell_room(environment(), "从" GRN "屠龙刀" NOR "中跌出一卷薄绢来\n");
  return;
}
