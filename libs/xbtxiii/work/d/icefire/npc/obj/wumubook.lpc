#pragma save_binary
//  ninemoon_book.c
inherit F_AUTOLOAD;
inherit ITEM;

void create()
{
    set_name("武穆遗书", ({ "wumu_book" }) );
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long",
            "这是一本岳飞所写的兵法书，里面记载了他的抗击金兵的经验。\n");
		set("value", 1000);
		set("no_drop","这么好的东西不能丢弃。\n");
		set("no_steal",1);
		set("material", "paper");
		set("skill", ([
            "name" :   "strategy",
            "exp_required" : 2000000,
											// to learn this skill.
            "sen_cost" : 60,
			"difficulty":	30,				// the base int to learn this skill
											// modify is gin_cost's (difficulty - int)*5%
			"max_skill":	190,				// the maximum level you can learn
			"min_skill":	0				// the maximum level you can learn
											// from this object.
		]) );
	}
}
int query_autoload()
{
        return 1;
}
