#pragma save_binary

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIR "血淋淋的头颅" NOR, ({ "head" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 1);
    set("material", "gold");
    set("杨逍/标记", "成昆");
  }
  setup();
}
