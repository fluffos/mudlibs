#pragma save_binary
#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;

void create()
{
	    set_name("金花婆婆", ({"jin hua po po", "po po","jin" , }));
        set("long",
        "她是一位身材矮小的老妇人，身穿一件灰色长袍。\n"
        "她长的非常丑陋，还弓着腰，不时的传来咳嗽声。\n"
        );

        set("title",HIY "金花婆婆" NOR);
        set("gender", "女性");
        set("attitude", "aggressive");
        set("chat_chance", 60);

        set("chat_chance_combat", 15);
        set("chat_msg_combat", ({
        "你也想来抢依天剑？！！那就让你常常依天剑的厉害！！！\n",
        }) );

        set("age", 63);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("per",5);

        set("max_kee", 5000);
        set("max_gin",5500);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 200);

        set("combat_exp", 1500000);
        set_skill("force", 150);
        set_skill("dodge", 225);
        set_skill("parry", 150);
        set_skill("unarmed", 225);
		set_skill("lingshe-zhangfa",150);
        set_skill("hunyuan-yiqi", 150);

        map_skill("force", "hunyuan-yiqi");
        map_skill("parry", "lingshe-zhangfa");
		map_skill("staff","lingshe-zhangfa");

        setup();

        carry_object("/obj/cloth")->wear();
        carry_unique(__DIR__"obj/lingshe_zhang","/obj/weapon/staff")->wield();
}

void init()
{
        object me,ob;
        me = this_object () ;
        ob = this_player () ;

     ::init();

        if( interactive(ob) && !is_fighting() )
        {
                remove_call_out("greeting");
                call_out("greeting", 1, me, ob);
        }
}

void die()
{
		object obj;
        obj=carry_unique(__DIR__"obj/yitianjian","/obj/weapon/sword");
        if(!environment(obj))
		obj->move(this_object());
		::die();
}
