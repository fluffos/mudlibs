#pragma save_binary
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "灵蛇岛");

  set("long",
    "小岛的中心。四周仍是古树参天，枯藤交错，荆棘密布，浓密宽\n"
    "厚的树叶遮蔽了日月星辰，使人分不出昼夜。其中有一棵树特别\n"
    "高.四下如死一般的寂静，只有风吹过树梢的沙沙之声。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "island2",
  ]));
  set("objects", ([
    __DIR__ "npc/jinhuapopo": 1,
    __DIR__ "npc/snake": 3,
  ]));
  set("no_arrest", 1);
  setup();
}
int clean_up() {
  return 0;
}
int reset() {
  if (query("Reset"))
    return 0;
  ::reset();
  set("Reset", 1);
}
