#pragma save_binary
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "冰火岛");
  set("long",
    "这是荒芜的小岛东边的一片树林，西边则是一座活火山，正在冒\n"
    "着浓烟。你看见海滩上有一个木筏(mufa)，似乎可以用它返回中\n"
    "原。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "icefire1",
  ]));
  set("objects", ([
  ]));
  set("item_desc", ([
    "mufa": @TEXT
这是一个木筏,上面放满了淡水和食物。
大概可以支持着回到中原。(hui zhongyuan)
TEXT ]));
  set("no_arrest", 1);
  setup();
}
void init() {
  add_action("do_save", "save");
  add_action("do_back", "hui");
}
int do_save(string arg) {
  tell_object(this_player(), "在这种鬼地方存盘，还是免了吧！\n");
  return 1;
}
int do_back(string arg) {
  object me;
  me = this_player();
  tell_object(me, "你跳上木筏，拼命的划向大海！\n");
  me->move(__DIR__ "seaback");
  call_out("goto_home", 15, me);
  return 1;
}
void goto_home(object me) {
  if (!objectp(me)) return;
  tell_object(me, "你在海上不知偏流了多久，终于看到了陆地，于是你拼命的划向陆地！\n");
  me->move("/d/sea/seaside");
  me->set_explore("north#9");
  tell_object(me, "又回到陆地了，太好了！\n");
}
