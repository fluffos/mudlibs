// red_road1.c

#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
	set("short", "前院道路");
	set("long",
"你现在正站在红花会前院的道路上,往西是红花会的登记所,东面\n"
"可以看见教众们来来往往,往北是红花会的练功房,往南则是娱乐\n"
"厅,时不时可传来男男女女嘻笑的声音.\n"
);

	set("exits", ([
		"east"    	: "/d/red/red_hall",
		"west"          : "/d/red/red_register",
		"north"		: "/d/red/red_exerciseroom",
		"south"		: "/d/red/red_relaxroom", ]) );

	setup();

}

