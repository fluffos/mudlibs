// inn.c

#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
set("short", "玩家比武场");
	set("long",
"这是玩家比武场,在这里你可以和玩家切磋武功,千万记住不可杀\n"
"死对方,违反者无罪，胜者可获得奖励，加油呀！\n"
);

	set("exits", ([
		"south"		: "/d/red/red_road2", ]) );

	setup();

}
