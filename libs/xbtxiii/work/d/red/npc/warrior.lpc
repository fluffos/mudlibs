// warrior.c

inherit NPC;

void consider();

void create()
{
	set_name("红花会武士", ({ "warrior" }) );

	set("age", 30);
	set("long",
		"红花会武士的职责是守卫红花会的门户。\n");
	set("attitude", "peaceful");

	set("str", 26);
	set("cor", 30);
	set("int", 24);
	set("cps", 30);

	set("force", 100);
	set("max_force", 100);
	set("force_factor", 10);

	set("combat_exp", 22000);
	set("score", 20000);

	set("chat_msg_combat", ({
		 "武士说道：不得乱闯红花会重地\n",
		(: exert_function, "powerup" :),
		(: exert_function, "recover" :)
	}) );

	set_skill("unarmed", 60);
	set_skill("throwing", 40);
	set_skill("force", 60);
	set_skill("parry", 60);
	set_skill("dodge", 60);
	set_skill("literate", 60);
	set_skill("perception", 80);
        set_skill("baihuastrike",60);
        set_skill("baihuaforce", 60);
	set_skill("stormdance", 50);
	set_skill("pyrobat-steps", 60);

        map_skill("force", "baihuaforce");
        map_skill("unarmed","baihuastrike");
	map_skill("dodge", "pyrobat-steps");
	map_skill("move", "pyrobat-steps");

        set("marks/帮派","红花会");
        set("marks/红花会","武士");

	setup();

	carry_object("/obj/cloth")->wear();
}

