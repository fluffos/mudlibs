// huizhu.c

#include <ansi.h>

inherit NPC;

string ask_me(object who);

void create() {
  set_name("红花会舵掷", ({ "red_head", "head" }));
  set("title", "坛主");
  set("gender", "男性");
  set("age", 26);
  set("str", 20);
  set("cor", 30);
  set("cps", 30);
  set("int", 11);
  set("long", "这是红花会门卫");
  set("combat_exp", 100000);
  set("attitude", "heroism");
  set("chat_msg_combat", ({
    "门卫说道：你当这里是什麽地方，敢来这里撒野？\n",
  }));

  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("blade", 100);
  set_skill("flower-blade", 40);

  map_skill("blade", "flower-blade");

  setup();

  carry_object(__DIR__ "obj/blade")->wield();
  carry_object("/obj/cloth")->wear();
}
