#include <ansi.h>

inherit NPC;

string ask_me(object who);

void create()
{
	set_name("红花会众", ({ "red_member", "member" }) );
	set("title", "会众");
	set("gender", "男性" );
	set("age", 26);
	set("str", 20);
	set("cor", 28);
	set("cps", 28);
	set("int", 11);
	set("long","这是红花会会众");
	set("combat_exp", 10000);
	set("attitude", "heroism");
	set("chat_msg_combat", ({
		"会众说道：你当这里是什麽地方，敢来这里撒野？\n",
	}) );

	set_skill("parry", 100);
	set_skill("dodge",100);
	set_skill("unarmed",100);
	

        setup();
	
	carry_object("/obj/cloth")->wear();
}
