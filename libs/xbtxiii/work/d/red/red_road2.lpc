// inn.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "后院道路");
	set("long",
"你现在正站在红花会后院的道路上,往西可以通往前院,东面就是\n"
"红花会的议事厅了,南北两边是红花会比武的场所,在这可以听见\n"
"丁丁当当的刀剑声.\n"
);

	set("exits", ([
//		"east"    	: "/d/red/red_hall",
		"west"		: "/d/red/red_hall",
		"north"		: "/d/red/red_fightroom1",
		"south"		: "/d/red/red_fightroom2", ]) );

	setup();

}

