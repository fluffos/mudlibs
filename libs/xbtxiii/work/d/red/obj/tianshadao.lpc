// moon_blade.c

#include <weapon.h>

inherit BLADE;

void create()
{
        set_name("天煞刀", ({ "tiansha blade", "blade" }) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",
                        
"这是一把寒光闪闪的利刃，显然是出自名家之手。刀柄上面镶着两颗珍珠，乃是陈家洛的成名武器。\n");
                        
                set("value", 180000);
                set("material", "steel");
                set("wield_msg", 
"只听见「飕」地一声，$N的手中已经多了一把$n。\n");
                set("unequip_msg", "$N将手中的$n插入腰间的剑鞘。\n");
        }
        init_blade(40);
        setup();
}
 
