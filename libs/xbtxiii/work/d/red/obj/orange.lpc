// orange.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("橘子汤", ({ "orange", "sour orange" }) );
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "这是一豌橘子熬成的汤。\n");
                set("unit", "豌");
                set("value", 80);
                set("max_liquid", 60);
        }

        set("liquid", ([
                "type": "water",
                "name": "橘子汁",
                "remaining": 60,
        ]) );
}

