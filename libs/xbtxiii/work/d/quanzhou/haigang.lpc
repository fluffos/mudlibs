#include <ansi.h>
inherit ROOM;

void create() {
  set("coor", ({ 750, -850, 0 }));
  set("short", "海港");
  set("long",
    "这里是出海的必经之地，正在施工中。\n"
  );

  set("item_desc", ([
    "chuan": "这是桃花岛对外联系的大船。上岛的客人或弟子只要\n"
    "上船(enter)就可以到桃花岛。\n",
  ]));
  set("exits", ([
    "west": __DIR__ "zhongxin",
  ]));

  set("objects", ([
    __DIR__ "npc/boy": 2,
    "/d/chaoting/npc/girl": 1,
  ]));

  set("outdoors", "quanzhou");
  setup();
}
