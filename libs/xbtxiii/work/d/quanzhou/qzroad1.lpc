#pragma save_binary
// Room: /d/quanzhou/qzroad1.c
// Date: Maay 7, 96   Jay

inherit ROOM;

void create() {
  set("coor", ({ 500, 0, 0 }));
  set("short", "山路");
  set("long",
    "你走在一条山路上。时值春日，路旁的山坡上开满了金黄色的油\n"
    "菜花。\n"
  );

  set("exits", ([
    //\    "west" : "/d/yangzhou/dongmen",
    "west": "/d/fy/egate",
    "south": __DIR__ "qzroad2",
    //               "north" : "/open/wander/whiteguang.lpc",
  ]));
  set("objects", ([
    //  "/open/wander/npc/seller" : 1,
  ]));

  set("no_fight", 1);
  set("no_magic", 1);
  set("outdoors", "quanzhou");
  setup();
}

int valid_leave(object me, string dir) {
  object ob;
  object *inv;
  int i;
  if (dir == "west" && ob = present("soldier", this_object())) {
    if (ob->query("leader") == me->query("name") &&
      me->query("rank") == 1) return 1;
    else {
      inv = all_inventory(me);
      for (i = 0; i < sizeof(inv); i++) {
        if (((inv[i]->query("targetid")) == me->query("id"))
          && ((string)(inv[i]->query("id")) == "token"))
          return 1;
      }
      return notify_fail(ob->name() + "向你嚷道：奉" +
        ob->query("leader") + "之命封锁此路!没有通行证不得通过!\n");
    }
  } else return 1;
}
