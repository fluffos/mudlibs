#include <room.h>

inherit ROOM;

void create()
{ 
       set("coor",({630,-780,-20}));
	set("short","密室房梁");
       set("long",
"你现在在密室的房梁上四下观瞧，周围都是些烂木头破砖瓦。突\n"
"然你瞟见犄角旮旯处有一件袈裟。\n"
);
        set("exits", ([
                "down" : __DIR__"mishi",
        ]));       
        set("objects", ([
                __DIR__"obj/jiasha" : 1,
                "/d/xingxiu/npc/snake" :1,
        ]));       

        setup();
}

