inherit ROOM;

void create() {
  set("coor", ({ 700, -850, 0 }));
  set("short", "城中心");
  set("long",
    "泉州是一个安静的港城。虽然这里是城中心，人们也只是脚步轻\n"
    "轻地过往，并不喧哗。东面是一个港口，从那里可以出海。西面\n"
    "有一条小巷。\n"
  );

  set("exits", ([
    "north": __DIR__ "beimen",
    "south": __DIR__ "nanmen",
    "east": __DIR__ "haigang",
    "west": __DIR__ "xijie",
  ]));

  set("outdoors", "quanzhou");
  setup();
}
