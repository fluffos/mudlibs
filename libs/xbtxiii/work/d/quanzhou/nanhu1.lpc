#pragma save_binary
// Room: /d/quanzhou/nanhu1.c
// Date: May 21, 96   Jay

inherit ROOM;

void create() {
  set("coor", ({ 850, -250, 0 }));
  set("short", "嘉兴南湖");
  set("long",
    "这里是烟波浩淼的南湖。湖上几只画舫在游荡，船上的游客和青\n"
    "楼女子在嘻笑。湖水很深，没有船是渡不过去的。但不知是谁在\n"
    "湖底钉了一些木桩。桩顶潜在水面之下一两寸的地方。即使是不\n"
    "懂轻功的人走上去也像是水上漂的样子。\n"
  );

  set("exits", ([
    "south": __DIR__ "yanyu",
    "northwest": __DIR__ "nanhu",
    "east": "/d/taishan/road1",  //去泰山
  ]));

  set("outdoors", "quanzhou");
  setup();
}
