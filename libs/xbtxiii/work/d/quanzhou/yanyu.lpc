inherit ROOM;

void create() {
  set("coor", ({ 850, -260, 0 }));
  set("short", "烟雨楼");
  set("long",
    "烟雨楼建在南湖中心的一个小岛上。南湖终年不断的水气把它笼\n"
    "罩得迷迷蒙蒙的。楼内是家饭店。店内正在装修楼梯。请勿上楼。\n"
  );

  set("exits", ([
    "north": __DIR__ "nanhu1",
  ]));

  set("outdoors", "quanzhou");
  set("objects", ([
    __DIR__ "npc/xiaoer": 1 ]));

  setup();
  replace_program(ROOM);
}
