inherit ROOM;

void create()
{
	set("coor",({500,-400,0}));
	set("short", "山路");
	set("long",
"你走在一条山路上。时值春日，路旁的山坡上开满了金黄色的油\n"
"菜花。\n"
);

	set("exits", ([
                "north" : __DIR__"qzroad2",
                "east" : __DIR__"qzroad4",
	]));

	set("outdoors", "quanzhou");
	setup();
	replace_program(ROOM);
}

