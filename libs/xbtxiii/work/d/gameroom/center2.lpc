#pragma save_binary
inherit ROOM;
void create() {
  set("short", "儿童乐园二楼");
  set("long",
    "欢迎光临儿童乐园，希望您在此玩的愉快。\n"
  );
  set("exits", ([
    "west": __DIR__ "lottery_room",
    "east": __DIR__ "duchang3",
    "north": __DIR__ "duchang4",
    "south": __DIR__ "chessroom",
    "down": __DIR__ "center",
    //        "up" :   __DIR__"center2",
  ]));


  setup();
}
