string look_sign(object me);
inherit ROOM;
#include <ansi.h>
void create() {
  add_light(this_object(), 1);
  set("short", "摇奖室");
  set("long",
    "房间里布置很简单，只有一张小床，一个小几，和几张方凳。窗\n"
    "台上放着一个磁杯，杯里插着几枝无名小花。房间虽不大，但是\n"
    "给人整洁舒适的感觉。屋子正中有个牌子.(sign)\n"
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "center2",
    //            "east" : "/d/fy/gameroom",
  ]));
  set("objects", ([
    "/obj/npc/lottery": 1,
  ]));
  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  set("no_fight", 1);
  setup();
}

string look_sign(object me) {
  return CYN "buy <号码1--8000> lottery from rong er\n"
    "一张彩票25两银子。\n"
    "领奖(lingjiang)、查询(demand)、购买(buy)\n"
    "购买格式有两种：buy <号码> lottery from rong er\n"
    "buy <号码> to <号码>lottery from rong er\n";
}
