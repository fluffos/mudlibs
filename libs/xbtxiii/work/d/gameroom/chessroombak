                else return "you_are_playing";
            }
            else if(room1==this_object())
  	        return "red-player";//红方在场
  	    else if(room2==this_object())
  	        return "green-player";//绿方在场
            else if(room1!=this_object()&&room2!=this_object())
                return "no-player";//没有人在场
