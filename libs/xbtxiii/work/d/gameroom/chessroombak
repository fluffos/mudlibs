                 }
                 if(y_temp<=-2){//是在y轴的负方向移动的。并且移动了2格以上。
                        for(i=y_start-1;i>y_end;i--){
	                   if(temp_board[x_start][i]==0) continue;
                           if(temp_board[x_start][i]!=0){
                               msg=replace_chess_string(temp_board[x_start][i]);
                               msg="你要移动的车被棋子挡住了。\n";
                               return msg;
                           }
