		     msg="士只能斜线移动一格，你该不是不知道吧？\n";	
		     return msg;
                 }
                 return "can-move";
            case R_SHUAI://要走的棋子是帅
            case G_SHUAI:
                 if((x_temp!=0&&y_temp!=0)||x_temp>1||x_temp<-1
                    ||y_temp>1||y_temp<-1){
                     msg="您的走法似乎违反了中国象棋规则。不必我告诉您规则了吧。\n";	
                     return msg;
                 }
                 if(x_end<7||y_end>5||y_end<3){
                     msg="恩～～～中国象棋的老帅似乎不允许出皇宫。\n"
