#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("魔术袍", ({ "magic cloth","cloth" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("armor_prop/armor", 10);
        }
        setup();
}
