inherit ROOM;

void create() {
  set("coor", ({ 75, -825, 0 }));
  set("short", "东大街");
  set("long",
    "你走在东大街上，踩着坚实的青石板地面。东边是东城门，可以\n"
    "听到守城官兵的吆喝声，与西边朗朗的读书声混杂在一起。北边\n"
    "是一家老字号的药铺，南边是打铁铺，叮叮当当的声音老远就能\n"
    "听到。\n"
  );
  set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "dongmen",
    "south": __DIR__ "datiepu",
    "west": __DIR__ "dongdajie1",
    "north": __DIR__ "yaopu",
  ]));

  set("objects", ([
    "/d/npc/xiaofeng": 1,
  ]));

  setup();
  replace_program(ROOM);
}
