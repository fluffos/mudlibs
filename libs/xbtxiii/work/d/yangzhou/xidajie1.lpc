inherit ROOM;

void create() {
  set("coor", ({ 0, -825, 0 }));
  set("short", "西大街");
  set("long",
    "这是一条宽阔的青石板街道，向东西两头延伸。西大街是衙门所\n"
    "在，行人稀少，静悄悄地很是冷清。东边是一个热闹的广场。南\n"
    "边是兵营。北边就是衙门了。\n"
  );
  set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "guangchang",
    "south": __DIR__ "bingyindamen",
    "west": __DIR__ "xidajie2",
    "north": __DIR__ "yamen",
  ]));

  setup();
}
