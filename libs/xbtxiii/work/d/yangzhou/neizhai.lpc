#pragma save_binary
// Room: /city/neizain.c
// YZC 1995/12/04 

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ 0, -810, 0 }));
  set("short", "内宅");
  set("long",
    "这里是衙门的内宅，住着知府的家眷。外人到此就该止步了。\n"
  );

  set("exits", ([
    "south": __DIR__ "ymzhengting",
  ]));
  set("objects", ([
    __DIR__ "npc/yuhuan": 1,
  ]));

  setup();
  replace_program(ROOM);
}
