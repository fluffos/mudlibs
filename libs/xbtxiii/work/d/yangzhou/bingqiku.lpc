#pragma save_binary
// Room: /city/bingqiku.c
// YZC 1995/12/04 

#include <room.h>
inherit ROOM;

void create() {
  set("coor", ({ 0, -840, 0 }));
  set("short", "兵器库");
  set("long",
    "这里是兵器库，到处银光闪闪，让人眼花缭乱。宝刀、宝剑、金\n"
    "箍棒，大刀、长剑、哨棒，短刀、短剑、短棍，各色各样的兵器\n"
    "应有尽有，你一时不知道挑什么好。\n"
  );

  set("exits", ([
    "north": __DIR__ "bingyin",
  ]));

  create_door("north", "铁门", "south", DOOR_CLOSED);
  setup();
}

void init() {
  if (objectp(this_player()))
    this_player()->set_explore("south#4");
}
