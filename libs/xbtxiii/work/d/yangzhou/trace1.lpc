#pragma save_binary
// Room: /d/jiangnan/daguanyuan/trace6.c

#include <room.h>

inherit ROOM;

string look_sign(object me);
void create()
{
        set("coor",({25,-1000,0}));
	set("short", "长江渡口");
        set("long",
"这里长江北岸渡口，南面就是滔滔不绝的中华第一河长江，北面\n"
"隐隐可以看到扬州城南门，一个船夫坐在靠着岸边的渡船上，等\n"
"着顾客过江。\n"
);
        set("outdoors", "yangzhou");
set("exits", ([ /* sizeof() == 2 */
    	"north" : "/d/yangzhou/trace2",
        "south" : "/d/jiangnan/jinglin/trace2",
   ]));
  
 set("objects",(["/d/jiangnan/yangzhou/npc/boater":1])); 
        setup();
        
}


int valid_leave(object me, string dir)
{       object ob;
        object *inv;
        int i;
if (dir=="north"&&ob=present("soldier", this_object()))
{
if (ob->query("leader")==me->query("name")&&
    me->query("rank")==1) return 1;
else{
                inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)               
 {if (((inv[i]->query("targetid")) == me->query("id"))
        &&((string)(inv[i]->query("id")) == "token"))
        return 1;
 }              
return notify_fail(ob->name()+"向你嚷道：奉"+
ob->query("leader")+"之命封锁此路!没有通行证不得通过!\n");
    }
}
else return 1;  
}       

