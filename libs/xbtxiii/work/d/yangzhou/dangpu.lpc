#include <room.h>
//inherit ROOM;
inherit HOCKSHOP;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ 30, -850, 0 }));
  set("short", "当铺");
  set("long",
    "这是一家以买卖公平著称的当铺，一个五尺高的柜台挡在你的面\n"
    "前，柜台上摆着一个牌子(paizi)，柜台后坐着唐老板，一双精\n"
    "明的眼睛上上下下打量着你。\n"
  );
  set("rich", 500000);

  set("item_desc", ([
    "paizi": "客倌可以在这里典当(pawn)、卖断(sell)各种货物，铜钱、银两、黄金、银票
一概通用。赎回货物用(retrieve)，申请乾坤袋用(apply bag)。\n"
  ]));
  set("objects", ([
    __DIR__ "npc/hocker": 1,
  ]));
  set("exits", ([
    "west": __DIR__ "nandajie1",
  ]));

  setup();
  //        replace_program(ROOM);
}
