inherit ROOM;

void create()
{
        add_light(this_object(),1);
	set("coor",({210,-2040,0}));
	set("short", "林间小屋");
        set("long",
"你走进了一间小屋。四周墙壁都由青竹篾编成，窗外是一望无际\n"
"的竹林。屋里的桌椅、床铺均为竹制。但一阵扑鼻而来的狗肉香\n"
"味，却显得与这清雅的气纷格格不入。\n"
);

        set("exits", ([ /* sizeof() == 1 */
        "west" : __DIR__"gbandao" ]));

	set("objects", ([
                CLASS_D("gaibang") + "/hong" : 1,
		__DIR__"obj/zhubang": 1,
		__DIR__"obj/gourou": 1,
		__DIR__"obj/jitui": 1
	]));

        set("valid_startroom", 1);
        set("no_clean_up", 0);
        setup();

//    "/obj/board/gaibang_r"->foo();
        call_other( "/obj/board/gaibang_r", "???" );
}

int clean_up(){return 0;}
