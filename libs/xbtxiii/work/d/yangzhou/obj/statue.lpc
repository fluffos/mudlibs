#pragma save_binary
// statue.c 雕像 纪念大虾coolguy &abroc

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "侠侣碑" NOR, ({ "statue", "bei" }));
  set_weight(3000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "座");
    set("long",
      "     这是一座普通的古旧青石石碑，上面用不同颜色的金文刻着这样一些文字：\n\n"
      "                      " HIR " 勿相忘\n\n"
      "                  " HIR " 南北侠侣剑气昂，\n\n"
      "                   珍爱互重意回肠。\n\n"
      "                   正道永存人间世，\n\n"
      "                   勉我后辈奋自强。\n\n"
      NOR "      北侠侠侣：\n"
      "           " HIR "剑" HIG "气" BLU "冲" YEL "天                  " MAG "再战江湖 coolguy\n"
      "           " HIW "serry from snow           " MAG "飘雪     serry\n\n"
      NOR "      南侠侠侣：\n"
      "           " WHT "我是一滴远方孤星的泪水    " HIC "萧寒水   arboc\n"
      "           " MAG "瞒 " BLU "天" HIC "过" RED "海                 " HIC "水上飘   fly\n\n"
      NOR "      下面一段描述已经模糊不清，显然年月已久，但是最后一行依稀可辩是：\n\n"
      "        " HIR "“侠侣乘鹤东去，不复还，勿相忘，神州" HIW "义" HIB "武" HIR "维扬。。。“\n\n" NOR);
    set("value", 1000);
    set("material", "gold");
    set("no_get", 1);
    set("amount", 1);
  }
  setup();
}


void init() {
  object ob;
  object me = this_player();
  if (random(5) == 1) {
    tell_object(me, HIY "\n忽然一道金光扑面而来，让你如沐春风。\n" NOR);
    me->set_explore("south#21");
  }
}
