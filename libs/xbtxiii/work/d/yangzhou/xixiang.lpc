#pragma save_binary
// Room: /city/xixiang.c
// YZC 1995/12/04 

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -35, -810, 0 }));
  set("short", "财主西厢");
  set("long",
    "这是财主小姐的闺房，一股幽香扑面而来。一张绣榻放在墙角，\n"
    "垂着细纱。小姐正躺在榻上，懒洋洋地一幅思春模样。看到你突\n"
    "然闯进来，惊呆了。\n"
  );

  set("exits", ([
    "east": __DIR__ "houyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/yingying": 1,
  ]));
  setup();
}
