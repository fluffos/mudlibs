inherit ROOM;

void create()
{
	set("coor",({5,-815,0}));
	set("short", "东厅");
	set("long",
"这里是衙门东厅，是知府招待客人的所在。厅中摆着一张杉木圆\n"
"桌和几张椅子，桌上是一套精致的宜兴瓷器。墙上挂着一幅中堂，\n"
"画的是猛虎下山，乃是知府的手笔。\n"
);

	set("exits", ([
		"west" : __DIR__"ymzhengting",
	]));

	setup();
	replace_program(ROOM);
}

