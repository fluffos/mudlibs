#pragma save_binary
// Room: /d/snow/herbshop1.c

inherit ROOM;

void create() {
  set("short", "密室");
  set("long",
    "这是一间光线阴暗的密室，从地上厚厚的灰尘看得出来这里很少\n"
    "有人出入，靠西边的地上放着一副脚镣，连着一条铁链镶在墙上，\n"
    "不知道是用来锁什麽人，南面的墙(wall)是用红杉木做的，跟另\n"
    "外三面的灰土墙比起来显得有些不寻常。\n"
  );
  set("no_clean_up", 0);


  set("exits", ([
    "east": __DIR__ "chuchang",
  ]));

  set("objects", ([
    CLASS_D("gaibang") + "/hong": 1,
  ]));
  setup();
}
