#pragma save_binary
// Room: /city/milin.c
#include <ansi.h>

inherit ROOM;
int mark_ban;

void create() {
  set("coor", ({ 210, -2060, 0 }));
  set("short", "青竹林");
  set("long",
    "这是一片茂密的青竹林，一走进来，你仿佛迷失了方向。\n"
  );

  set("exits", ([
    "east": __FILE__,
    "west": __DIR__ "ml7",
    "south": __DIR__ "dongmen",
    "north": __FILE__,
  ]));
  set("outdoors", "yangzhou");
  mark_ban = 1;
  set("no_clean_up", 0);
  setup();
}
void init() {
  object me;
  me = this_player();
  if (random(me->query("kar")) >= 20) {
    message_vision("$N突然看见似乎有根竹子与众不同。\n请输入 search 来仔细搜查。\n", me);
    add_action("do_search", "search");
  }
  return;
}
int do_search(string arg) {
  object me, ob;
  me = this_player();
  if (me->query("kar") > 20 && mark_ban) {
    ob = new("/d/npc/m_weapon/tan/item/hanzhu");
    message_vision("$N搜查竹林，终于发现一根" + HIR "寒丝羽竹" NOR + "。\n", me);
    ob->move(me); mark_ban = 0;
  } else message_vision("$N什么也没发现！\n", me);
  return 1;
}
