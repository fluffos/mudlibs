#pragma save_binary
// Room: /city/biaoju.c
// YZC 1995/12/04 

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -25, -830, 0 }));
  set("short", "福威镖局");
  set("long",
    "你来到一座结构宏伟的建筑前，左右石坛上各插着一根两丈多高\n"
    "的旗杆，杆上青旗飘扬。右首旗子用金线绣着一头张牙舞爪的狮\n"
    "子，狮子上头有一只蝙蝠飞翔。左首旗子上写着“福威镖局”四\n"
    "个黑字，银钩铁划，刚劲非凡。入口处排着两条长凳，几名镖头\n"
    "坐着把守。少镖头正跟他们说笑。\n"
  );

  set("exits", ([
    "south": __DIR__ "zhengting",
    "north": __DIR__ "xidajie2",
    "east": __DIR__ "school1",
  ]));

  set("objects", ([
    __DIR__ "npc/linpingzhi": 1,
    __DIR__ "npc/biaotou": 2,
  ]));

  setup();
  replace_program(ROOM);
}
