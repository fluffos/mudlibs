#pragma save_binary
// Room: /city/dayuan.c
// YZC 1995/12/04 

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ -25, -815, 0 }));
  set("short", "财主大院");
  set("long",
    "你走进大院，迎面是一个假山水池，池上摆着一块奇形怪状的石\n"
    "头，据说是当年花石纲的遗石。水池的两旁种满了花草。东边是\n"
    "一棵槐树，郁郁葱葱，遮盖了大半个院子，显得阴森恐怖。一条\n"
    "长廊走道通往后院，有几个家丁把守。\n"
  );

  set("exits", ([
    "north": __DIR__ "houyuan",
    "south": __DIR__ "caizhu",
  ]));
  set("objects", ([
    __DIR__ "npc/guanjia": 1,
    __DIR__ "npc/jiading": 2,
  ]));

  setup();
  replace_program(ROOM);
}
