// Room: /d/yangzhou/ymdongting.c

inherit GUANFU;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ 0, -2080, 0 }));
  set("short", "衙门正厅");
  set("long",
    "堂上东西有两根楹住，挂着一幅对联，但是你无心细看。正墙上\n"
    "悬挂一个横匾，上书“正大光明”四个金光闪闪的大字。知府正\n"
    "坐在文案后批阅文书，师爷随侍在后。在此朝廷官员可以(arres\n"
    "t)犯人。在知府桌案上还有一份名单（list）.\n"
  );

  set("exits", ([
    "east": __DIR__ "dongting",
    "west": __DIR__ "xiting",
    "north": __DIR__ "neizhai",
    "south": __DIR__ "yamen",
  ]));
  set("objects", ([
    __DIR__ "npc/cheng": 1,
    __DIR__ "npc/shiye": 1,
    "/d/chaoting/xianya/npc/yayi2.lpc": 2,
    "/d/chaoting/xianya/npc/yayi3.lpc": 2,
  ]));

  setup();
}
