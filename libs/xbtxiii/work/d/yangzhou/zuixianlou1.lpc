#pragma save_binary
// Room: /city/zuixianlou.c
// YZC 1995/12/04 

inherit ROOM;
int do_work(string arg);

void create() {
  add_light(this_object(), 1);
  set("coor", ({ 35, -775, 0 }));
  set("short", "醉仙楼");
  set("long",
    "方圆数百里内提起醉仙楼可以说是无人不知，无人不晓。当年苏\n"
    "学士云游到此，对醉仙楼的花雕酒赞不绝口，欣然为其题匾，流\n"
    "下一段传遍海内的佳话，从此醉仙楼名声大震。楼下布置简易，\n"
    "顾客多是匆匆的行人，买点包子、鸡腿、米酒就赶路去了。楼上\n"
    "是雅座。门口挂著一块牌子(sign)。\n"
  );

  set("exits", ([
    "west": __DIR__ "beidajie2",
    "up": __DIR__ "zuixianlou2",
  ]));

  set("objects", ([
    __DIR__ "npc/xiaoer2": 1,
  ]));

  set("item_desc", ([
    "sign": @TEXT
现在正紧缺人手，急需雇佣一批临时waiter。
work     开始工作。
TEXT
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  setup();
  //    replace_program(ROOM);
}
void init() {
  add_action("do_work", "work");
}
int do_work(string arg) {
  object ob;
  object me;
  me = this_player();
  if (me->query_temp("times") > 50)
    return notify_fail("今天的活干完了，明天再来吧！\n");
  if (me->query("gin") <= 29 || me->query("sen") <= 29) {
    message_vision("$N的神太低了,明天再来工作吧。\n", me);
    return 1;
  }
  message_vision("$N辛苦的工作终于结束了，可人也累的要死\n", me);
  me->add("gin", -30);
  me->add("sen", -30);
  me->add_temp("times", 1);
  ob = new("/obj/money/silver");
  ob->set_amount(1);
  ob->move(me);
  message_vision("老板对$N说：这是你的工钱。\n", me);
  return 1;
}
