#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
 add_light(this_object(),1);
	set("coor",({50,-815,5}));
	set("short", "先贤祠—玩家部");
        set("long",
"这里是纪念杰出玩家的地方。供奉在这里的无论是侠客还是魔头，\n"
"都曾经叱诧一时。抬头一张横匾，上书七个闪闪发光的金字：天\n"
"下谁人不识君\n"
);
        set("exits", ([ /* sizeof() == 2 */
         "up" : __DIR__"xxci2",
         "down" : __DIR__"shuyuan",
]));

     set("no_fight",1);
     setup();
}
int init()
{
	call_out("star_more",1,this_player());	
}

int star_more(object me)
{
	string msg;	
	msg="注：排名不分先后。按字母顺序。\n"
"普通百姓      [我是一滴远方孤星的泪水」        萧寒水(Arboc)     灵牌\n"
"萧寒水爱妻    [瞒天过海」                      水上飘(fly)       灵牌\n"
"普通百姓      [ 永远爱着飘雪(serry)]           再战江湖(coolguy) 灵牌\n"
"普通百姓      [再战江湖的爱妻 ]                飘雪(serry)       灵牌\n"
"普通百姓                                       我忘了(Toyou)     灵牌\n"
"普通百姓                                       勿忘我(Forme)   灵牌\n"
"飞天御剑流门主                               空明(trf)         灵牌\n"
"飞天御剑流——门房  [一生一世爱晓萱的孤独剑客] 洋洋(yangg)       灵牌\n"
"普通百姓      [同乐帮--大长老]                 高达(goda)        灵牌\n"     
"高达爱妻      [同乐帮--大长老夫人]             紫苑(aster)       灵牌\n"
"增增爱妻      [同乐帮--帮主]                   丽君(civ)         灵牌\n"
"普通百姓      [同乐帮--副帮主]                 中继站(diablao)   灵牌\n"
"中继站爱妻    [同乐帮--九天玄女]               蕾儿(gwang)       灵牌\n"
"普通百姓      [同乐帮--传功使(深爱LOVING)]     天煞(black)       灵牌\n"
"天煞爱妻      [停住你的爱]                     就要爱了吗(loving)灵牌\n"
"水晶鸟爱妻    [同乐帮--执法使(爱的影子)]       影子(silk)        灵牌\n"
"普通百姓      [同乐帮--御风堂堂主]             增增(happy)       灵牌\n"
"普通百姓      [同乐帮--驺雨堂堂主](第一任)     水晶鸟(hisity)    灵牌\n"
"普通百姓      [同乐帮--惊雷堂堂主]             山中人(fila)      灵牌\n"
"普通百姓      [同乐帮--狂电堂堂主]             鹰(tony)          灵牌\n"
"普通百姓      [同乐帮--驺雨堂堂主](第二任)     净空(lin)         灵牌\n";
        msg = replace_string(msg, "普通百姓", HIC+"普通百姓"+NOR);
//        msg = replace_string(msg, "[", YEL+"[");
//        msg = replace_string(msg, "]", "]"+NOR);
        msg = replace_string(msg, "灵牌", HIR+"灵牌"+NOR);
       		
	me->start_more(msg);
	return 1;
}	
