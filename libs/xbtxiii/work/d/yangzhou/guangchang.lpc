#pragma save_binary
// Room: /city/guangchang.c
// YZC 1995/12/04 

inherit ROOM;

void create() {
  add_light(this_object(), 1);
  set("coor", ({ 25, -825, 0 }));
  set("my_point", "扬州城");
  set("short", "中央广场");
  set("long",
    "这里是城市的正中心，一个很宽阔的广场，铺着青石地面。一些\n"
    "游手好闲的人在这里溜溜达达，经常有艺人在这里表演。中央有\n"
    "一棵大榕树，盘根错节，据传已有千年的树龄，是这座城市的历\n"
    "史见证。树干底部有一个很大的洞(shudong)。你可以看到北边\n"
    "有来自各地的行人来来往往，南面人声鼎沸，一派繁华景象，东\n"
    "边不时地传来朗朗的读书声，西边则见不到几个行人，一片肃静。\n"
    "那边有个招牌，不妨看看（sign）。\n"
  );
  set("no_sleep_room", 1);
  set("outdoors", "yangzhou");

  set("item_desc", ([
    "shudong": "这是一个黑不溜湫的大洞，里面不知道有些什么古怪。\n",
    "sign": "
最新利民服务：长途马车出租。

终点                票价
京城                 8  silvers
雪亭                12  silvers
金陵                10  silvers

收款人：liumangtou
",
  ]));

  set("exits", ([
    "east": __DIR__ "dongdajie1",
    "south": __DIR__ "nandajie1",
    "west": __DIR__ "xidajie1",
    "north": __DIR__ "beidajie1",
    //               "up" : "/d/gameroom/center",
  ]));

  set("objects", ([
    __DIR__ "npc/liumang": 2,
    __DIR__ "npc/liumangtou": 1,
    __DIR__ "obj/statue": 1,
    //       __DIR__"obj/fake-zi" : 1,
    "d/biao/kehu": 1,
  ]));

  setup();
}

void init() {
  add_action("do_enter", "enter");
  UPDATE_D->check_user(this_player());
}

int do_enter(string arg) {
  object me;
  me = this_player();

  if (!arg || arg == "") return 0;

  if (arg == "shudong") {
    message("vision",
      me->name() + "一弯腰往洞里走了进去。\n",
      environment(me), ({ me }));
    me->move("/d/gaibang/inhole");
    message("vision",
      me->name() + "从洞里走了进来。\n",
      environment(me), ({ me }));
    return 1;
  }
}
