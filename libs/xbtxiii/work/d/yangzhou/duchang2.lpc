inherit ROOM;

void create() {
  set("short", "赌场");
  set("long",
    "这里有四条走廊通向不同的房间。\n"
  );

  set("exits", ([
    "east": "/inherit/room/eproom",
    "west": "/inherit/room/wproom",
    "south": "/inherit/room/sproom",
    "north": "/inherit/room/nproom",
    "down": __DIR__ "duchang",
  ]));

  setup();
  replace_program(ROOM);
}
