#pragma save_binary
// Room: /city/qianzhuang.c
//By apollo
inherit BANK;
int do_apply(string);


void create()
{
	add_light(this_object(),1);
	set("coor",({20,-800,0}));
	set("short", "钱庄");
	set("long",
"这是一家老字号的钱庄，已有几百年的历史，在全国各地都有分\n"
"店。它发行的银票信誉非常好，通行全国。旁边有张告示（gaos\n"
"hi），不妨看看。\n"
);

	set("exits", ([
		"east" : __DIR__"beidajie1",
	]));

	set("objects", ([
		__DIR__"npc/qian" : 1
	]));
        
        set("item_desc", ([
                "gaoshi" : "

查看帐户    bankinfo
存    钱    deposit     <数量>  <货币种类>
取    钱    draw      <数量>  <货币种类>
兑换货币    convert <数量>  <货币种类> to <货币种类>
apply card  申请信用卡
"
        ]));

	setup();
}

void init()
{
::init();
add_action("do_apply","apply");
}

int do_apply(string arg)
{
object me,book,*ob;
int s;
me=this_player();
if (!arg) return 0;
if (arg!="card") return 0;
ob=all_inventory(me);
s=sizeof(ob);
while(s--)
        {
        if (!stringp(ob[s]->query("id"))) continue;
        if (ob[s]->query("id")=="account card")
                {
                tell_object(me,"你已经有金龙卡了!\n");
                return 1;
                }
        }
book=new("/obj/a_book.lpc");
book->set("master_id",me->query("id"));
book->set("rich",0);
book->move(me);
if (file_size(book->query_save_file()+".o")>0) book->restore();
tell_object(me,"你忽然觉得腰包一鼓, 好象多了点什么.\n");
tell_room(this_object(),"钱庄老板把金龙卡递给"+me->query("name")+".\n",me);
return 1;
}
