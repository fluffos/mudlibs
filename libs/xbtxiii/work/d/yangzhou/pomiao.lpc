#pragma save_binary
// Room: /city/pomiao.c

#include <room.h>
inherit ROOM;

void create()
{
	add_light(this_object(),1);
	set("coor",({200,-2050,0}));
	set("short", "土地庙");
	set("long",
"这是一间破破烂烂的土地庙，庙里破败不堪，土地神像推在一旁，\n"
"梁上地下也布满了灰尘。一看就知道已经很久没有人来清理过了。\n"
"正中放着个大香案，上面零乱地扔着几根吃剩下来的鸡骨头。也\n"
"许正是因为隐蔽的原因吧，据说丐帮江南分舵就被设在此处。香\n"
"案黑洞洞的，好象下边有个大洞(dong)。\n"
);

	set("valid_startroom", 1);
	set("exits", ([
		"south" : __DIR__"ml4",
		"enter" : __DIR__"gbandao",
	]));
	set("objects", ([
		CLASS_D("gaibang") + "/lu" : 1,
		CLASS_D("gaibang") + "/peng" : 1,
	]));

        set("item_desc", ([
                "dong" : "这是一个黑不溜湫的小洞，里面不知道有些什么古怪。\n"
]));

	create_door("enter", "小门", "out", DOOR_CLOSED);
	setup();

//    "/obj/board/gaibang_b"->foo();
        call_other( "/obj/board/gaibang_b", "???" );
}

void init()
{
        add_action("do_enter", "enter");
        add_action("do_enter", "zuan");
}

int do_enter(string arg)
{
	object me;
	mapping fam;

	me = this_player();

	if( !arg || arg=="" ) return 0;

	if( arg=="dong" )
	{
		if( (fam = me->query("family")) && fam["family_name"] == "丐帮" ) 
		{
			message("vision",
				me->name() + "运起丐帮缩骨功，一弯腰往香案下的洞里钻了进去。\n",
				environment(me), ({me}) );
			me->move("/d/gaibang/undergb");
                	message("vision",
				me->name() + "从洞里走了进来。\n",
                		environment(me), ({me}) );
			return 1;
		}
		else 
			return notify_fail("这么小的洞，你钻得进去吗？\n");
	}
}	

int clean_up(){return 0;}
