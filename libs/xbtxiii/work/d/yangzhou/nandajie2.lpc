#pragma save_binary
// Room: /city/nandajie2.c
// YZC 1995/12/04 
// CLEANSWORD 1996/2/2

inherit ROOM;

void create()
{
	set("coor",({25,-875,0}));
	set("short", "南大街");
	set("long",
"你走在一条繁华的街道上，向南北两头延伸。南边是南城门，北\n"
"边通往市中心，西边是一家顾客众多的茶馆，三教九流人士都在\n"
"那里谈天说地。东边一座两层的楼房传来阵阵浪笑，那就是天下\n"
"闻名的丽春院。\n"
);
        set("outdoors", "yangzhou");

	set("exits", ([
		"east" : __DIR__"lichunyuan",
		"south" : __DIR__"southdoor",
		"west" : __DIR__"chaguan",
		"north" : __DIR__"nandajie1",
	]));

        set("objects", ([
                CLASS_D("shaolin") + "/tuoboseng" : 1,
                "/d/npc/duanyu": 1,
        ]));

	setup();
}

int valid_leave(object me, string dir)
{
	if (dir == "east" && (int)me->query("age") < 18 && !wizardp(me))
		return notify_fail("小朋友不要到那种地方去！！\n");
	return 1;
}
