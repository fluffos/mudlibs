#pragma save_binary
// trainee.c

inherit NPC;

void create()
{
    set_name("镖局弟子", ({ "trainee" }) );
	set("gender", "男性" );
	set("age", 19);
	set("long", "你看到一位身材高大的汉子，正在辛苦地操练著。\n");
       set("cor",30);
       set("con",30);
       set("max_kee",250);
       set("max_force",250);
       set("force",250);
       set("kee",250);
	set("combat_exp", 500);
	setup();
    carry_object("/obj/cloth")->wear();
}
