#pragma save_binary
// banker.c
// originally coded by xiang
// 96-02-16 YZC fixed some math problem

inherit NPC;

void create() {
  set_name("钱眼开", ({ "qian yankai", "qian", "yankai" }));
  set("title", "钱庄老板");
  set("nickname", "铁公鸡");
  set("gender", "男性");
  set("age", 34);

  set("str", 22);
  set("int", 24);
  set("dex", 18);
  set("con", 18);

  set("kee", 500);
  set("max_kee", 500);
  set("gin", 100);
  set("max_gin", 100);
  set("shen", 0);

  set("combat_exp", 50000);
  set("shen_type", 1);
  set("attitude", "friendly");
  set("env/wimpy", 50);
  set("chat_chance", 2);
  set("chat_msg", ({
    "钱眼开骄傲的说道：本银号已经有上百年的历史，在江南可以说是第一家。\n",
    "钱眼开笑着说道：存钱无利息，取钱收十分之二的手续费，客官您看着办吧。\n"
    "钱眼开微微一笑：办理不同面额货币的兑换业务，但每次要收十分之一的手续费。\n"
  }));

  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/damage", 40);

  setup();
  add_money("silver", 10);
  carry_object("/obj/misc/cloth")->wear();
}
