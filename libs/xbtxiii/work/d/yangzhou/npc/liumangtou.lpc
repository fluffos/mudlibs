#pragma save_binary
// liumangtou.c

inherit NPC;

string goto_where;

void goto(object);

void create()
{
	set_name("流氓头", ({ "liumangtou" }));
	set("gender", "男性");
	set("age", 25);
	set("long", "他长得奸嘴猴腮的，一看就不像是个好人。\n");
	
	set("combat_exp", 7000);
	set("shen_type", -1);
	set("attitude", "peaceful");
        set("rank_info/respect","流氓头"); 
	
	set_skill("unarmed", 40);
	set_skill("dodge", 40);
	set_temp("apply/attack", 20);
	set_temp("apply/defense", 20);

	setup();
	carry_object(__DIR__"obj/cloth")->wear();
}

int accept_object(object who, object ob)
{
        if ( ob->value() < 800 ) {
                command("say 就这点钱，你想让我喝西北风啊？");
                command("drop all");
                return 1;
        }
	else {
                tell_object(who,"流氓头高兴地说:太好了，快上车。\n");
                if ((ob->value() >= 800) && (ob->value() < 1000))  
                   goto_where = "/d/city/northdoor";
                else if ((ob->value() >= 1000) && (ob->value() < 1200))  
                        goto_where = "/d/jiangnan/jinglin/inn";
                     else goto_where = "/d/snow/postoffice";
                tell_object(who,"你觉得天旋地转，如被卷入黑洞一般...\n");
                call_out("goto",3,who);
               return 1;
              }
        return 1;
}

void goto(object ob)
{
   ob->move(goto_where);
   return;
}

