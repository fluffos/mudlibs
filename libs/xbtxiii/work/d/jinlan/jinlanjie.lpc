//   This is a room of jinlanhuidian d/jinlan/jinlandian.c

#include <ansi.h>
#include <room.h>
#include <login.h>
inherit ROOM;
//int do_touch(string);
void create()
{
	set("coor",({-70,4840,10}));
	set("short", "金兰会接待室");
	set("long",
"这里是金兰会的接待室,这里窗明几净,和祥而安宁.正前方的墙\n"
"上是巨幅的<<清明上河图>>,两边各有一排红木椅子,是来宾就坐\n"
"的地方.边上有几个小茶几,上边放着一壶天山灵芝茶(tea)北面\n"
"墙上挂着一块镜子(mirror),镜子左边是一块议事板(board),右\n"
"边是一张入会须知(paper).边上还站着一个美丽的侍女.\n"
);
set("objects",([__DIR__"npc/shinv":1]));
set("exits", ([ /* sizeof() ==  2 */
"east":__DIR__"jinlandian",
//"south":__DIR__"jinlandian",
"south":__DIR__"jinlanoff",
]));
//     create_door("north","红漆大门","south",DOOR_CLOSED);
       set("valid_startroom", 1);     
       set("no_fight",1);
       set("no_magic",1);   
set("item_desc",([
"mirror":"这是面上古流传下来的灵台镜,可以照出你的修行!(see mirror)\n",
"paper":"凡加入本会者,需遵从本会会规的约束,如果还未看会规的请先看一下.
本会会规森严,要想加入(join)敬请三思\n"
]));
	setup();
}

void init(){
add_action("do_see","see");
add_action("do_join","join");
//add_action("do_go","go");
}

int do_see(string arg)
{
object me;
int batrayer;
int score;
me=this_player();
if(arg=="mirror"){
message_vision("$N探头在镜中照了一下,啊!还真的挺象的!\n",me);
batrayer=me->query("betrayer");
if (batrayer<0) batrayer=0;
score=me->query("score");
tell_object(me,"你叛师次数是:"+(string)batrayer+";\n你的综合评价是:"+(string)score+"\n");
return 1;
}
notify_fail("你想照什么?\n");
return 0;
}

int do_join(){
object me;
me=this_player();
if(me->query("jinlanpai")){
 notify_fail("你已经是本会会员了!\n");
 return 1;
}
if(me->query("marks/shenqing")){
	notify_fail("会长还没空看您的申请，请耐心等待。\n");
	return 1;
}
if(me->query("combat_exp")<100000){
tell_object(me,"侍女笑着对你说道:江湖险恶,您还是小心为是,先多学些武艺吧!\n");
return 1;
}
if(me->query("marks/帮派")) {
tell_object(me,"侍女微笑着说道:不好意思,您已经加入了"+me->query("marks/帮派")+"\n");
return 1;
}
tell_object(me,"侍女鼓掌道:很欢迎你加入本会,希望你能恪守会规,光大本会!\n请先到会长办公室填写申请书!\n");
me->set("jinlanjoin",1);
return 1;
}


int valid_leave(object me,string dir){
if (dir=="south"){
if(me->query("jinlanjoin")||me->query("jinlanpai")==2){
//message_vision("门卫立刻退到两旁,向$N行礼,面露喜色地说道:＂会长您回来了,快进屋休息一下吧!＂\n",me);
me->delete("jinlanjoin");
return 1;
}
else {
return notify_fail("使女微笑着对你说道:对不起,请不要乱闯本会禁地.\n");
return 0;
}
}
else return 1;
}
