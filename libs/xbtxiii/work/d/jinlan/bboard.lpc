// bboard.c

#include <ansi.h>

#define BOARD_CAPACITY query("capacity")

inherit ITEM;
inherit F_SAVE;
void getename(object ob, mapping note, string arg);
void comformit(object ob, mapping note, string arg);

void setup() {
  string loc;

  if (stringp(loc = query("location")))
    move(loc);
  set("no_get", 1);
  restore();
}

void init() {
  add_action("do_fill", "fill");
  add_action("do_read", "read");
  add_action("do_discard", "discard");
}

string query_save_file() {
  string id;

  if (!stringp(id = query("board_id"))) return 0;
  return DATA_DIR + "board/" + id;
}

string short() {
  mapping *notes;
  int i, unread, last_read_time;

  notes = query("notes");
  if (!pointerp(notes) || !sizeof(notes))
    return ::short() + " [ 没有任何申请表 ]";

  if (this_player()) {
    last_read_time = (int)this_player()->query("board_last_read/" + (string)query("board_id"));
    for (unread = 0, i = sizeof(notes) - 1; i >= 0; i--, unread++)
      if (notes[i]["time"] <= last_read_time) break;
  }
  if (this_player()->query("jinlanpai") == 2) {
    if (unread)
      return sprintf("%s [ %d 张申请表,%d 张未读 ]", ::short(), sizeof(notes), unread);
    else
      return sprintf("%s [ %d 张申请表]", ::short(), sizeof(notes));
  } else return sprintf("入会申请表(Table)\n");
}

string long() {
  mapping *notes;
  int i, last_time_read;
  string msg, myid;

  notes = query("notes");
  msg = query("long");
  if (this_player()->query("jinlanpai") == 2) {
    msg = msg + "申请表的方法请见 help table。\n";
  }
  if (!pointerp(notes) || !sizeof(notes)) return query("long");

  last_time_read = this_player()->query("board_last_read/" + (string)query("board_id"));

  if (this_player()->query("jinlanpai") == 2) {
    for (i = 0; i < sizeof(notes); i++)
      msg += sprintf("%s[%2d]" NOR "  %-40s %12s (%s)\n",
        (notes[i]["time"] > last_time_read ? HIY : ""),
        i + 1, notes[i]["title"], notes[i]["author"], ctime(notes[i]["time"])[0..15]);
  }
  return msg;
}

// This is the callback function to process the string returned from the
// editor defined in F_EDIT of player object.

int do_read(string arg) {
  int num;
  mapping *notes, last_read_time;
  string myid;
  if (this_player()->query("jinlanpai") < 2) {
    return 0;
  }

  last_read_time = this_player()->query("board_last_read");
  myid = query("board_id");
  notes = query("notes");

  if (!pointerp(notes) || !sizeof(notes))
    return notify_fail("申请表上目前没有任何内容\n");

  if (!arg) return notify_fail("指令格式：read <申请表编号>|new|next\n");
  if (arg == "new" || arg == "next") {
    if (!mapp(last_read_time) || undefinedp(last_read_time[myid]))
      num = 1;
    else
      for (num = 1; num <= sizeof(notes); num++)
        if (notes[num - 1]["time"] > last_read_time[myid]) break;

  } else if (!sscanf(arg, "%d", num))
    return notify_fail("你要读第几张申请表？\n");

  if (num < 1 || num > sizeof(notes))
    return notify_fail("没有这张申请表。\n");
  num--;
  this_player()->start_more(sprintf(
    "[%d] %-40s %s(%s)\n----------------------------------------------------------------------\n",
    num + 1, notes[num]["title"], notes[num]["author"], ctime(notes[num]["time"])[0..9])
    +notes[num]["msg"]);

  // Keep track which post we were reading last time.
  if (!mapp(last_read_time))
    this_player()->set("board_last_read", ([ myid: notes[num]["time"] ]));
  else if (undefinedp(last_read_time[myid]) || notes[num]["time"] > last_read_time[myid])
    last_read_time[myid] = notes[num]["time"];

  return 1;
}


int do_discard(string arg) {
  mapping *notes;
  int num;
  if (this_player()->query("jinlanpai") < 2) {
    return 0;
  }
  if (!arg || sscanf(arg, "%d", num) != 1)
    return notify_fail("指令格式：discard <申请表编号>\n");
  notes = query("notes");
  if (!arrayp(notes) || num < 1 || num > sizeof(notes))
    return notify_fail("没有这张申请表。\n");
  num--;
  /*	if( notes[num]["author"] != (string) this_player(1)->query("name")
	&&	(string)SECURITY_D->get_status(this_player(1)) != "(admin)" )
		return notify_fail("这个申请表不是你填写的。\n");*/

  if (num == 0) notes = notes[num + 1..sizeof(notes) - 1];
  else notes = notes[0..num - 1] + notes[num + 1..sizeof(notes) - 1];
  set("notes", notes);
  save();
  write("删除第 " + (num + 1) + " 号申请表....Ok。\n");
  return 1;
}


int do_fill(string arg) {
  object me;
  object table;
  mapping note;
  me = this_player();
  if (arg == "table") {
    write("请在申请表上填写您加入本会的目的!\n");
    note = allocate_mapping(4);
    note["title"] = "入会申请书";
    note["author"] = this_player()->query("name");
    note["time"] = time();
    note["msg"] = "申请加入者:" + me->query("id") + "\n姓      名:"
      +me->query("name") + "\n门      派:"
      +me->query("family/family_name") + "第" + (string)me->query("family/generation") + me->query("family/title") + "\n经  验  值:" + (string)me->query("combat_exp") + "\n";
    write(note["msg"]);
    note["msg"] = note["msg"] + "加入金兰会的目的:";
    write("您加入本会的目的:");
    input_to((: getename, me, note :));
    //	this_player()->edit( (: done_post, this_player(), note :) );
    return 1;

  }
}

void getename(object ob, mapping note, string arg) {
  string textstring;
  if (arg == "") {
    write("如果您要想加入本会,你必须填写目的!\n");
    write("您加入本会的目的:");
    input_to((: getename, ob, note :));
    return;
  }
  textstring = note["msg"];
  note["msg"] = textstring + arg;
  write("申请书已经填写完毕,要递交吗?(y/n)");
  input_to((: comformit, ob, note :));
}

void comformit(object ob, mapping note, string arg) {
  mapping *notes;

  if (arg != "y" && arg != "n") {
    write("申请书已经填写完毕,要递交吗?(y/n)");
    input_to((: comformit, ob, note :));
    return;
  }
  if (arg == "n") {
    write("你放弃了递交申请书.\n");
    return;
  } else {
    notes = query("notes");
    if (!pointerp(notes) || !sizeof(notes))
      notes = ({ note });
    else
      notes += ({ note });

    // Truncate the notes if maximum capacity exceeded.
    if (sizeof(notes) > BOARD_CAPACITY)
      notes = notes[BOARD_CAPACITY / 2..BOARD_CAPACITY];

    ob->set("marks/shenqing", 1);
    set("notes", notes);
    tell_object(ob, "申请书已经递交,静候消息把。\n");

    save();
    return;
  }
}
