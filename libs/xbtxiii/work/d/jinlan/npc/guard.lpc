// guard.c

#include <ansi.h>

inherit NPC;
void create() {
  string *surname = ({ "周", "王", "洪", "赵" });
  string *fname1 = ({ "龙", "虎", "威", "强" });
  set_name("金兰会门卫  " + (surname[random(4)]) + (fname1[random(4)]),
    ({ "guard" }));
  set("gender", "男性");
  set("age", 24);
  set("long",
    "门卫很严肃地站着,一动也不动\n");
  set("attitude", "friendly");
  set("str", 30);
  set("cor", 30);
  set("int", 30);
  set("cps", 30);
  set("water", 400);
  set("food", 400);

  set("force", 4000);
  set("max_force", 3400);
  set("force_factor", 30);

  set("combat_exp", 500000);

  set("chat_chance_combat", 80);
  set_skill("unarmed", 100);
  set_skill("sword", 100);
  set_skill("blade", 100);
  set_skill("throwing", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("literate", 100);
  set_skill("perception", 100);


  set("inquiry", ([
    "金兰会": "想加入金兰会吗?要求是很高的喔!",
  ]));

  setup();

  carry_object("/d/jinlan/obj/longsword")->wield();
  carry_object("/obj/cloth")->wear();
}

int accept_fight(object ob) {

  message_vision("门卫对$N说到道：＂会长训示:学武是为健身,不可恃强凌弱,与人交手!＂\n", ob);
  return 0;
}
