// xiaoke.c

inherit NPC;
inherit F_VENDOR;

string jinlanpai();
string jinlanling();

void create()
{
        
	set("long","侍女长得很漂亮，看上去很乖很乖的样子，现在正乖乖的站在一边.");
        set_name("小珂",({"xiaoke"}) );
        set("title", "金兰会的侍女");
        set("gender", "女性" );
        set("age", 12);
	set("str", 29);
	set("int", 30);
        set("combat_exp", 1250000);
        set("attitude", "friendly");
        set_skill("unarmed", 100);
        set_skill("parry", 80);
        set_skill("dodge",100);
        set_skill("sword",120);

        set("inquiry", ([
		"金兰牌" : (:jinlanpai:),
                "金兰令" : (:jinlanling:)
        ]) );

	setup();
	add_money("silver", 12);
	add_money("coin", 500);
        carry_object("/obj/cloth")->wear();
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
       object *inroom;
       string obid;
       string obname;
       int count;
       obid=(string)ob->query("id");
       obname=(string)ob->query("name");
       inroom=all_inventory(environment(ob));
       if( !ob || environment(ob) != environment() ) return;
	tell_object(inroom[count],"小珂看见"+obname+"走过来，赶紧给"+obname+"端去一杯茶，说道:
这位"+RANK_D->query_respect(ob)+",快坐下来歇一歇,喝杯天山灵芝茶。\n",ob); 
}

string jinlanpai()
{
	object jlpai;
	object ob;
	ob=this_player();
	if(ob->query("jinlanpai")==0) 
   		return "要加入了金兰会才会有金兰牌的\n";
	if(ob->query("jinlanpai")==1&&ob->query("marks/jinlan")==1)
		return "金兰牌不是在你身上吗?\n";
	if(ob->query("jinlanpai")==2)
 		return "金兰牌是什么会长怎么会不知道呢?\n";
	if(ob->query("jinlanpai")==1&&ob->query("marks/jinlan")==0){
		jlpai=new("/d/jinlan/obj/jinlanpai");
 		jlpai->move(ob);
		ob->set("marks/jinlan",1);
//		command("give token to"+ob->query("id"));
		write("小珂叹了口气,拿了一块金兰牌给你\n");
		return "唉,什么怎么不小心呢,把金兰牌也搞丢了,这块给你,可别再丢了 ";
	}
	if(ob->query("jinlanpai")==1&&ob->query("marks/jinlan")==2){
		jlpai=new("/d/jinlan/obj/jinlanpai");
 		jlpai->move(ob);
		ob->set("marks/jinlan",1);
//		command("give token to"+ob->query("id"));
		
return("小珂微笑着,拿了一块金兰牌给你,说道:\n看来会长很器重你啊,好好干吧!\n");
	}
	
}
string jinlanling()
{
	object jlling;
	object ob;
	ob=this_player();
	if(ob->query("jinlanpai")!=2) 
   		return "金兰令是在金兰会会长身上挂的信物\n";
	if(ob->query("jinlanpai")==2&&ob->query("marks/jinlan")==1)
		return "金兰令不是在你身上吗?\n";
	if(ob->query("jinlanpai")==2&&ob->query("marks/jinlan")==0){
		jlling=new("/d/jinlan/obj/jinlanling");
 		jlling->move(ob);
		ob->set("marks/jinlan",1);
//		command("give token to "+ob->query("id"));
return("小珂叹了口气,拿了一块金兰令给你\n唉,什么怎么不小心呢,把金兰令也搞丢了,这块给你,可别再丢了 ");
	}
}
		
