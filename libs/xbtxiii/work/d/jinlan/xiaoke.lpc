// xiaoke.c

inherit NPC;
inherit F_VENDOR;

int i;
void create()
{
        string *check 
= 
({"小珂长得很漂亮，看上去很乖很乖的样子，现在正乖乖的站在一边。\n","小珂长得很漂亮，看上去很乖很乖的样子，现在正忙着给阿珂整理房间。\n"});
        i=random(2);
        set_name("小珂",({"xiaoke"}) );
        set("title", "阿珂的侍女");
        set("gender", "女性" );
        set("age", 12);
        set("long", check[i]);
	set("str", 29);
	set("int", 30);
        set("combat_exp", 12500);
        set("attitude", "heroism");
        set_skill("unarmed", 100);
        set_skill("parry", 80);
        set_skill("dodge",100);
        set_skill("sword",120);

        set("inquiry", ([
		"阿珂" : "我家小姐啊，可是天下第一美女呢！你有没有见过?",
        ]) );

	setup();
	add_money("silver", 12);
	add_money("coin", 500);
        carry_object("/obj/cloth")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
       object *inroom;
       string obid;
       string obname;
       int count;
       obid=(string)ob->query("id");
       obname=(string)ob->query("name");
       inroom=all_inventory(environment(ob));
       if( !ob || environment(ob) != environment() ) return;
       if (obid=="ake"){
        for(count=0;count<sizeof(inroom);count++){
           if((string)inroom[count]->query("id")!="ake"){
                    
tell_object(inroom[count],"小珂看见阿珂走过来，赶紧迎了上去，说道：
 '小姐回来了！又一个人跑出去玩，也不带小珂...快坐下歇歇，我去给小姐端茶。'\n");
} else
                    tell_object(ob,"小珂看见你走过来，赶紧迎了上来，说道：
 '小姐回来了！又一个人跑出去玩，也不带小珂...快坐下歇歇，我去给你端茶。'\n");
}
}

else{
switch (i){
case 0:
for(count=0;count<sizeof(inroom);count++){
if ((string)inroom[count]->query("id")!=obid){                    
tell_object(inroom[count],"小珂看见"+obname+"走过来，赶紧给"+obname+"端去一杯茶，说道:
这位"+RANK_D->query_respect(ob)+",快坐下来歇一歇,喝杯天山灵芝茶。\n",ob); 
}
else{
tell_object(ob,"小珂看见你走过来，赶紧给你端来一杯茶，说道：
这位"+RANK_D->query_respect(ob)+",快坐下来歇一歇,喝杯天山灵芝茶。\n");
}
}
                        break;
                case 1:
                        say(
"小珂正忙着整理房间，一边嘟哝道：阿珂也正是的，象个大懒猫似的。\n");
                        break;
        }
}
}
