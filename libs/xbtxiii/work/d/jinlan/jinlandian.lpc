#include <ansi.h>
#include <room.h>
#include <login.h>
inherit ROOM;
//int do_touch(string);
int do_accept(string arj);
void create()
{
	set("coor",({-60,4840,10}));
	set("short", "金兰会前厅");
	set("long",
"你现在站在金兰会的前厅里,迎面高高悬挂着一块巨匾,匾上刻着\n"
"四个大字:浩然正气.正前方是两个虎皮大椅,想是首领的座椅.两\n"
"边各有一排红木椅子,中间铺着猩红地毯.旁边站着两列精神抖擞\n"
"的带刀卫士。正面墙上刻着一些字(words),好象是什么规章制度.\n"
);
//set("objects",([__DIR__"npc/wushi":4]));
set("exits", ([ /* sizeof() ==  2 */
"north":__DIR__"jinlan",
//"south":__DIR__"jinlandian",
"west":__DIR__"jinlanjie",
//"east":__DIR__"jinlanjan",
]));
       create_door("north","红漆大门","south",DOOR_CLOSED);
       set("valid_startroom", 1);     
       set("no_fight",1);
       set("no_magic",1);   
set("item_desc",(["words":@TEXT
                    会           规
=============================================================
1.行走江湖应扶困济贫,不得恃强凌弱,恣意妄为.
2.我会众皆为兄弟姐妹,应以诚相待,互帮互助,不可自相杀戮.
3.不得欺师灭祖!
4.不得以下犯上.
5.不可偷窃!
6.维护本会利益,弘扬本会精神.
7.凡我会众必须遵守本会规!违者逐出本会,不得再进我会之门.
8.本会规的修改权和解释权只属会长.
=============================================================
TEXT,
]));
	setup();
//        call_other("/obj/board/jinlan_b","???");
}

void init(){
add_action("do_accept","accept");
add_action("do_revoke","revoke");
}

int do_accept(string arg){
        object who; 
        object jlpai; 
        object me; 
        me=this_player(); 
	if (me->query("jinlanpai")!=2) return 0;
        if (!arg) return notify_fail("你要同意谁加入金兰会？\n"); 
        if (!objectp(who=present(arg,environment(me)))||!living(who))
	 return notify_fail("你要同意谁加入金兰会？\n"); 
	if(who->query("jinlanpai")) return notify_fail("他已经是本会会圆了.\n");
	if(!(who->query("marks/shenqing"))) {
	return notify_fail(who->query("name")+"没写申请书呢!\n");
	}
	who->delete("marks/shenqing");
	who->set("marks/jinlan",2);
	who->set("jinlanpai",1);
	who->set("marks/帮派","金兰会");
	who->set("marks/金兰会","会员");
	who->set_skill("array",200);
	who->set_skill("jinlanarray",50);
	who->map_skill("array","jinlanarray");
	message_vision("\n$N用手按住$n的百会，两人脸上都冒着白气......\n",me,who);
	tell_object(who,"\n你感到一股热流从百会流入，流遍奇经六脉，有一种说不出的惬意的\n");
	message_vision("\n过了一会儿，$N对$n说，按会中的贯例，新加入到我会的会员，都要先传
一些本门技能。至于以后你能有多少成就就看自己的修行了.\n",me,who);
	message_vision("\n$N大声的宣布:根据本会领导组织的审核,同意$n加入金兰会,\n请$n到秘书小姐处领取金兰牌!\n",me,who);
        
 message("vision",HIY"\n〖金兰通告〗会长"+me->name(1)+"宣布:"+who->query("name")+"从今天起加入金兰会，还望大家多多关照！\n   另外，敬请大家严格监督其行为！\n"NOR,users()); 
	{
                object link_ob;  
                seteuid(getuid()); 
                who->save(); 
                if(objectp(link_ob = who->query_temp("link_ob")) ){
                link_ob->save(); 
                }                
	}	
        return 1;   
}

int do_revoke(string arg){
        object who; 
        object jlpai; 
        object me,user,*ob_list; 
	string *sname;
	mapping skills; 
	int i,bandskill;
        me=this_player();
	if (me->query("jinlanpai")!=2) return 0;
        if (!arg) return notify_fail("你要把谁开除出金兰会？\n"); 
	who=find_player(arg);
	if(!who) who=find_living(arg);
        if( !who || !me->visible(who)) {
                arg = resolve_path(me->query("cwd"), arg); 
                ob_list = children(arg); 
                for(i=0; i<sizeof(ob_list); i++) {
                        if( !who = environment(ob_list[i]) ) continue; 
//                        printf("%O\n", ob ); 
                return 1;  
		}
        }
        if (!who)
	 return notify_fail("你要把谁开除出金兰会？\n"); 
	if(!who->query("jinlanpai")) return notify_fail("他不是本会会员了.\n");
	who->delete("jinlanpai");
	who->set("marks/jlrevoke",1);
	who->delete("marks/jinlan");
	who->delete("marks/帮派");
	who->delete("marks/金兰会");
	who->delete_skill("array");
	who->delete_skill("jinlanarray");
	skills=who->query_skills();
	if(sizeof(skills)){
	sname=sort_array(keys(skills),(:strcmp:));	
	for(i=0;i<sizeof(skills);i++){
		bandskill=skills[sname[i]]-skills[sname[i]]/50;
		who->set_skill(sname[i],bandskill);
	}
	}
	if(objectp(jlpai=present("jinlanpai",me))) destruct(jlpai); 
	{
                object link_ob;  
                seteuid(getuid()); 
                who->save(); 
                if(objectp(link_ob =who->query_temp("link_ob")) ){
                link_ob->save(); 
                }                
	}	
/*
	message_vision("\n$N用手按住$n的百会，两人脸上都冒着白气......\n",me,who);
	tell_object(who,"\n你感到一股热流从百会流入，流遍奇经六脉，有一种说不出的惬意的\n");
	message_vision("\n过了一会儿，$N对$n说，按会中的贯例，新加入到我会的会员，都要先传
	一些本门技能。至于以后你能有多少成就就看自己的修行了.\n",me,who);
	message_vision("\n$N大声的宣布:根据本会领导组织的审核,同意$n加入金兰会,\n请$n到秘书小姐处领取金兰牌!\n",me,who);
 */      
	// 	message("vision",HIY"\n〖金兰通告〗会长"+me->name(1)+"宣布:"+who->query("name")+"从今天起加入金兰会，还望大家多多关照！\n   另外，敬请大家严格监督其行为！\n"NOR,users()); 
        return 1;   
}


int valid_leave(object me,string dir){ 
if (dir=="east"){
		return notify_fail("金兰会禁地，不得乱闯.\n");  
	}
return 1;
}
