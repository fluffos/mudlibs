#include <ansi.h>

inherit F_CLEAN_UP;
do_jteam(string);
jiezhen(object, string);
show_member(obj);

int do_jteam(string arg) {
  object ob;
  object jlpai;
  object *t, *member;
  object me;
  int i, bonus;
  me = this_player();
  if (pointerp(t = me->query_team()))
    if (me->is_team_leader())
      member = me->query_team();
  if (!arg) {
    if (pointerp(t = me->query_team())) {
      if (sizeof(t) == 1) {
        me->dismiss_team();
        return notify_fail("你没有参加任何队伍！\n");
      }
      if (me->is_team_leader()) {
        write("你所带领的金兰阵中有:\n");
        member = me->query_team();
        for (i = 0; i < sizeof(member); i++) show_member(member[i]);
      } else {
        write("你目前处在的阵中有：\n");
        member = me->query_team();
        for (i = 0; i < sizeof(member); i++) show_member(member[i]);
      }
    } else return notify_fail("你目前还没有与人结阵.\n");

    return 1;
  }
  if (sscanf(arg, "with %s", arg) == 1) {
    if (!pointerp(t = me->query_team())) {

      jiezhen(me, arg);
      return 1;
    } else {
      if (me->is_team_leader()) {
        jiezhen(me, arg);
        return 1;
      } else return notify_fail("只有阵法阵主才能邀请人加入本阵.\n");
    }
  }

  if (arg == "dismiss") {
    if (!pointerp(t = me->query_team()))
      return notify_fail("你现在并没有参加任何队伍。\n");
    if (me->is_team_leader()) {
      member = me->query_team();
      message("team", me->name(1) + "将队伍解散了。\n", t, me);
      write("你将队伍解散了。\n");
      me->delete_temp("pending/jiezhen");
      if (me->query_temp("unmoveobj")) {
        object unmoveobj;
        unmoveobj = me->query_temp("unmoveobj");
        tell_object(unmoveobj, me->query("name") + "把队伍解散了,你自由了！\n");
        unmoveobj->delete_temp("unmove");
        me->delete_temp("unmoveobj");
      }
      for (i = 0; i < sizeof(member); i++) {
        bonus = (int)member[i]->query_temp("apply/team");
        member[i]->dismiss_team();
        if (me->query_temp("in_team")) {
          member[i]->add_temp("apply/attack", -bonus);
          member[i]->add_temp("apply/dodge", -bonus);
          member[i]->delete_temp("apply/team");
          member[i]->delete_temp("in_team");
        }
      }
    } else {
      if (me->query_temp("in_team"))
        return notify_fail("金兰阵已经发动，不得临阵脱逃！\n");
      message("team", me->name(1) + "决定脱离队伍。\n", t, me);
      write("你脱离了你的队伍。\n");
      member = me->query_team();

      if (sizeof(member) == 2) {
        if (member[0]->query_temp("unmoveobj")) {
          object unmoveobj;
          unmoveobj = member[0]->query_temp("unmoveobj");
          tell_object(unmoveobj, member[0]->query("name") + "的队伍解散了,你自由了！\n");
          unmoveobj->delete_temp("unmove");
          member[0]->delete_temp("unmoveobj");

        }
        me->delete_temp("in_team");
        me->dismiss_team();
        member[0]->dismiss_team();
        tell_object(member[0], "你的队员都离队了......\n");

      }
    }
    return 1;
  }
  if (sscanf(arg, "form %s", arg) == 1) {

    if (!pointerp(t = me->query_team()) || !me->is_team_leader())
      return notify_fail("你必须是一个队伍的领袖才能组织阵形。\n");
    if (sizeof(t) == 1) {
      me->dismiss_team();
      return notify_fail("你没有参加任何队伍！\n");
    }

    if (!SKILL_D(arg)->valid_enable("array"))
      return notify_fail("你必须把你的队伍用阵法来组织.\n");
    if (pointerp(t = me->query_team()) && me->is_team_leader()
      && me->query_temp("in_team"))
      return notify_fail("你已经把你的队伍结成金兰阵了!\n");
    //		printf("%d\n",(int)me->query_skill(arg));
    if ((int)me->query_skill(arg) < 15)
      return notify_fail("你尚未领悟这种阵形的奥妙。\n");
    for (i = 0; i < sizeof(member); i++)
      if ((int)member[i]->query_skill(arg) < 10)
        return notify_fail("这种阵法不如不组！\n");
    for (i = 0; i < sizeof(member); i++) {
      bonus = (int)(me->query_skill(arg, 1) +
        member[i]->query(arg, 1));
      member[i]->set_temp("apply/team", bonus);
      member[i]->add_temp("apply/attack", bonus);
      member[i]->add_temp("apply/dodge", bonus);
      member[i]->set_temp("in_team", 1);
    }
    return SKILL_D(arg)->form_array(me);
  }
  if (arg == "unform") {
    if (!pointerp(t = me->query_team()) || !me->is_team_leader())
      return notify_fail("你必须是一个队伍的领袖才能组织阵形。\n");
    if (pointerp(t = me->query_team()) && me->is_team_leader()
      && !me->query_temp("in_team"))
      return notify_fail("你还没有把你的队伍结成金兰阵呢!\n");
    if (sizeof(t) == 1) {
      me->dismiss_team();
      return notify_fail("你没有参加任何队伍！\n");
    }

    for (i = 0; i < sizeof(member); i++) {
      bonus = (int)member[i]->query_temp("apply/team");
      member[i]->add_temp("apply/attack", -bonus);
      member[i]->add_temp("apply/dodge", -bonus);
      member[i]->delete_temp("apply/team");
      member[i]->delete_temp("in_team");
    }
    message_vision(GRN "$N分付众人撤了金兰阵\n" NOR, me);
    return 1;
  }

  if (sscanf(arg, "kill %s", arg) == 1) {
    object obj;
    if (!pointerp(t = me->query_team()) || !me->is_team_leader())
      return notify_fail("你必须是一个队伍的领袖才能下达这个命令。\n");
    if (sizeof(t) == 1) {
      me->dismiss_team();
      return notify_fail("你没有参加任何队伍！\n");
    }

    if (!(obj = present(arg, environment(me)))
      || !living(obj))
      return notify_fail("你想杀死的对象在哪？\n");
    for (i = 0; i < sizeof(member); i++)
      if (obj == member[i])
        return notify_fail("你想杀死自己的同门兄弟么？\n");
    for (i = 0; i < sizeof(member); i++) {
      member[i]->kill_ob(obj);
      if (i > 0) tell_object(member[i], HIM + me->query("name") +
        "下令杀" + obj->query("name") + "，大家快点动手！\n" NOR);
    }
    return 1;
  }

  if (sscanf(arg, "unmove %s", arg) == 1) {
    object obj;
    if (!pointerp(t = me->query_team()))
      return notify_fail("你现在并没有和别人组成队伍。\n");
    if (sizeof(t) == 1) {
      me->dismiss_team();
      return notify_fail("你没有参加任何队伍！\n");
    }
    if (!me->is_team_leader()) return notify_fail("只有队伍的领袖可以下这个指令！\n");
    if (!(obj = present(arg, environment(me)))
      || !living(obj))
      return notify_fail("你要围住的人在哪儿呢？\n");
    obj->start_busy(3);
    message_vision("$N带领金兰会众把$n围在金兰阵中，$n不能动弹了。\n", me, obj);
    obj->set_temp("unmove", 1);
    me->set_temp("unmoveobj", obj);
    return 1;
  }

  if (sscanf(arg, "%s", arg) == 1) {
    if (!pointerp(t = me->query_team()))
      return notify_fail("你现在并没有和别人组成队伍。\n");
    if (sizeof(t) == 1) {
      me->dismiss_team();
      return notify_fail("你没有参加任何队伍！\n");
    }
    message("team", HIM "【队伍】" + me->name(1) + "："
      +arg + "\n" NOR, t);
    return 1;
  }

}

int jiezhen(object me, string arg) {
  object ob;
  object old_target;
  if (!objectp(ob = present(arg, environment(me)))) {
    return notify_fail("你想跟谁结阵呢？\n");
  }
  if (!ob->query("jinlanpai"))
    return notify_fail(ob->name() + "不是金兰会的人，不会金兰阵\n");

  if (!living(ob) || !ob->query("marks/jinlan"))
    return notify_fail(ob->name() + "已经没法和泥结阵了\n");
  if (ob == me)
    return notify_fail("没搞错吧，和自己结阵？\n");
  if (me->query_temp("in_team"))
    return notify_fail("你现在处于结阵状态中，不能与人结阵!\n");
  if ((object)ob->query_temp("pending/jiezhen") != me &&
    pointerp(ob->query_team()))
    return notify_fail(ob->query("name") + "现在正处于别的队伍中，不能与你结阵!\n");
  if ((object)ob->query_temp("pending/jiezhen") != me) {
    message_vision("\n$N对著$n说道：\n"
      +HIG + "结义金兰，同生共死！\n" + NOR
      +RANK_D->query_self(me)
      +me->name() + "，请问"
      +RANK_D->query_respect(ob) + "可愿意结伴同行？\n\n", me, ob);
    if (objectp(old_target = me->query_temp("pending/jiezhen")) && old_target != ob)
      tell_object(old_target, YEL + me->name() +
        "取消了和你结阵的念头\n" NOR);
    me->set_temp("pending/jiezhen", ob);

    tell_object(ob, YEL
      "如果你愿意和" + me->name() + "结阵，请你也对"
      +me->name() + "(" + (string)me->query("id") + ")" + "下一次 jt with指令。\n"
      NOR);
    write(YEL "由於对方是由玩家控制的人物，你必须等对方同意才能结阵同行\n" NOR);
    return 1;
  }
  ob->delete_temp("pending/jiezhen");
  me->delete_temp("pending/jiezhen");
  message_vision("\n$N对著$n说道：\n"
    +HIG + "结义金兰，同生共死！\n" + NOR
    +RANK_D->query_self(me)
    +me->name() + "，愿与"
    +RANK_D->query_respect(ob) +
    "共闯江湖\n\n", me, ob);
  ob->add_team_member(me);
  message_vision("$N决定参加$n的队伍。\n", me, ob);
  return 1;

}



int do_jinlan(string arg) {
  object *ob, *target;
  int i;
  object me;
  me = this_player();
  ob = users();
  i = sizeof(ob);
  while (i--) {
    if (ob[i]->query("marks/jinlan") == 1) {
      if (sizeof(target) == 0) {
        target = ({ ob[i] });
      } else {
        target += ({ ob[i] });
      }
    }
  }

  message("vision", YEL "【金兰会】" + me->name(1) + "：" + arg + "\n" NOR,
    target);
  return 1;
}

int do_jinlanacc(string arg) {
  object *ob;
  int i;
  object me;
  me = this_player();
  ob = users();
  message("vision", YEL "〖金兰通告〗 会长" + me->name(1) + "宣布：" + arg +
    "\n" NOR,
    ob);
  return 1;
}



string status_color(int current, int max);

show_member(object me) {
  mapping my;
  my = me->query_entire_dbase();

  printf(" 姓名：%20s  气 ：%s%4d/ %4d %s(%3d%%)" + NOR + " 经验： %s%d\n" NOR,
    me->query("name"),
    status_color(my["kee"], my["eff_kee"]), my["kee"], my["eff_kee"],
    status_color(my["eff_kee"], my["max_kee"]), my["eff_kee"] * 100 / my["max_kee"],
    HIM, my["combat_exp"]);
  return 1;
}

string status_color(int current, int max) {
  int percent;

  if (max > 0) percent = current * 100 / max;
  else percent = 100;
  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}
