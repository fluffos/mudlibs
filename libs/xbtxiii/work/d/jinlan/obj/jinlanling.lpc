// jinlanling.c
#include <ansi.h>
inherit ITEM;
inherit F_SAVE;
inherit F_AUTOLOAD;
inherit "/d/jinlan/obj/jteamfun";

void delete_waste();
void restore_waste();
int do_save(string);
//int do_load(string);
int do_jteam(string);
int jiezhen(object,string);
int save();

void create()
{
        set_name(HIR"金兰令"NOR, ({ "jinlan token","token","jinlanling" }) );
        set("unit", "块");
        set("long","这是金兰会会长身上带的信物,千万不要丢了

    
会长的金兰令在身上时才能使用金兰阵(Jt),金兰频道(Jinlan)和金兰通告频道(Jacc)。

金兰会阵法指令使用方法:
jt	         - 查看当前的金兰会队伍装况。
jt with <某人>   - 跟某人组成队伍. 必须要双方都同意加入才会生效。
jt dismiss       - 离开队伍. 若下此指令的是领队, 则整个队伍会解散。
jt <讯息>        - 跟队伍里其他的人谈话.
jt form <阵法>   - 如果队伍的领队学过阵法的话，可以将队伍中的成员组织成
                    某种阵形，组成阵形的状态只要领袖一移动就会解除。
jt unform        - 如果已经结阵的话，用该命令可以使阵法解除。 
jt unmove <某人> - 把敌人围困在金兰阵中，使他不能动弹。 
jt kill <某人>   - 组成剑阵后杀死敌人。

直接下 jt 指令时则会显示你目前是否有加入队伍及队员名单。

注: 1.jt 跟 follow 是独立的，你不需要 follow 队伍的领袖。
    2.在会中，只有身上带有金兰牌或金兰令的人才能使用和收听金兰通道。
    3.金兰通告频道不得乱用，只在有重要的金兰会消息要让所有玩家知道时用。
"
);



	if( clonep() )
		{
		set("master_id",this_player()->query("id"));
		set_default_object(__FILE__);
		}
	set("no_get",1);
	set("no_drop",1);
	seteuid(getuid());
}


void init()
{
	if( !environment()->is_character())
		{
		destruct(this_object());
		return;
		}
	if (environment()->query("id")!=query("master_id"))
		{
		destruct(this_object());
		return;
		}
	add_action("do_jteam","jt");
	add_action("do_jinlan","jinlan");
	add_action("do_jinlanacc","jacc");
}

string query_save_file() 
	{ 
	return DATA_DIR + "benny/jinlan/" +
				query("master_id")[0..0]+"/"+query("master_id"); }

string query_autoload() { return query("master_id"); }

void autoload(string name) 
	{
	set("master_id",name);
	restore();
	}
		

void owner_is_killed(object killer)
{
	if( !killer ) killer = environment();
	killer->set("marks/jinlanling",0);
	tell_room(environment(killer),	HIY"\n一道金光闪过,金兰守护神将金兰令收了回去。\n"NOR );
	destruct( this_object() );
	return;
}

