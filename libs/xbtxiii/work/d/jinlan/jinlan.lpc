//   This is a room of jinlanhui /d/jinlan/jinlan.c

#include <room.h>
inherit ROOM;
int do_touch(string);
void create() {
  add_light(this_object(), 1);
  set("coor", ({ -60, 4850, 10 }));
  set("short", "金兰会大门");
  set("long",
    "这是金兰会的大门,门口矗立着两只庄严雄伟的特大石狮子(lion)\n"
    ",大门紧闭着,门上两个虎头门环(menhuan),直瞪瞪的盯着你.抬\n"
    "头一看,门匾上龙飞凤舞的写着金兰会三个赤金大字.这一切都显\n"
    "示着此会在江湖上的煊赫地位.门口站着两个彪悍的门卫.\n"
  );
  set("objects", ([ "/d/jinlan/npc/guard": 2 ]));
  set("exits", ([ /* sizeof() ==  2 */
    "north": "/d/ny/yamen_gate",
    "south": __DIR__ "jinlandian",
  ]));
  create_door("south", "红漆大门", "north", DOOR_CLOSED);
  set("valid_startroom", 1);
  set(
    "item_desc",
    ([ "lion": "这是一对精雕细琢的青石狮子,两眼泛着青光,仿佛要把你吞噬下去!\n", "menhuan": "门环闪着金光,象是金子做的,你不禁想摸一下(touch)\n" ])
  );
  set("no_magic", 0);
  setup();
}

void init() {
  add_action("do_touch", "touch");
  //add_action("do_go","go");
}

int do_touch(string arg) {
  object me;
  me = this_player();
  if (arg == "menhuan") {
    message_vision("$N轻轻地摸了一下门环,啊!是48K真金的耶......\n$N心中一动,很想把它拽下来(draw).\n", me);
    add_action("do_draw", "draw");
    return 1;
  }
  notify_fail("你想碰什么?\n");
  return 0;
}

int do_draw(string arg) {
  object me;
  me = this_player();
  if (arg == "menhuan") {
    message_vision("$N拽住金门环,手上使力,象拔萝卜似的想把门环拽下来.....\n
忽然$N觉得四肢无力,内力源源外泄,@!$#%$@#^*&好象武功消失了.......\n
$N两腿一软,一屁股坐在地上,唉!不该起贪念的,悔之晚矣!!!\n", me);
    return 1;
  }
  notify_fail("你想拽什么?\n");
  return 0;
}

int valid_leave(object me, string arg) {
  if (arg == "south") {
    if (me->query("jinlanpai") == 2) {
      message_vision("门卫立刻退到两旁,向$N行礼,面露喜色地说道:＂会长您回来了,快进屋休息一下吧!＂\n", me);
      return 1;
    }
    if (me->query("jinlanpai") == 1) {
      message_vision("门卫笑着对$N说道:原来是本会" + me->query("name") + ",快请进\n", me);
      return 1;
    }
    message_vision("门卫笑着对$N说道:欢迎到金兰会做客,快快请进!\n", me);
    return 1;
  }
  return 1;
}
