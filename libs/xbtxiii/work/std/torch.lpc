#pragma save_binary
// combined_item.c

#include <dbase.h>
#include <name.h>

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;


void setup() {}

protected void destruct_me() {
  if (environment())
    tell_object(environment(), query("real_name") + "烧完了,于是你随手把它扔掉了。\n");
  destruct(this_object());
}


int do_light() {
  int time;
  time = query("can_light");
  call_out("destruct_me", time);
  set("start_light", time());
  set("value", 1);
  add_light(this_object(), 1);
  return 1;
}
int do_unlight() {
  int time;
  remove_call_out("destruct_me");
  time = time() - query("start_light");
  add_light(this_object(), -1);
  if (time > query("can_light")) call_out("destruct_me", 1);
  add("can_light", time);
  return 1;
}
