#pragma save_binary

// money.c

inherit COMBINED_ITEM;

int value() {
  float i;
  i = 1.0 * query_amount() * (int)query("base_value");
  if (i > 200000000) return 200000000;
  return to_int(i);
}

string query_autoload() { return query_amount() + ""; }

void autoload(string param) {
  int amt;

  if (!param) return;
  if (sscanf(param, "%d", amt) == 1)
    set_amount(amt);
}
