//BY RONGG@XBTX[雄霸天下II]
//魔法池继承文件
//设计思路:魔法池的任何发现者都可以通过沐浴(bathed)来使用由魔法池所提供的魔法,
//但是发现者每使用一次魔法，魔法池本身的魔法力量就会降低。故总会有使用完的一天.
//使用威力为 1/发现魔法池的玩家总数,这样做可以防止玩家随便泄露魔法池的地点
//以后的秘密如果不想一堆人都发现,应该参照这个思路
#include <ansi.h>
inherit ROOM;

int init() {
  add_action("do_bathed", "bathed");
}

int do_bathed() {
  object me;
  string msg;
  me = this_player();
  if (interactive(me) && !me->is_fighting()) {
    if (me->query_temp("TIMe")) return 1;
    msg = HIC "$N缓缓走入" + query("short") + ",开始沐浴.\n" NOR;
    message_vision(msg, me);
    me->set_temp("TIMe", 20);
    call_out("transfer_power", 20, me);
    return 1;
  } else return notify_fail("$N想走入" + query("short") + "沐浴,不过失败了.\n");

  return 1;
}

int transfer_power(object me) {
  string *persons, msg;
  int time;
  object m_skill;
  if (environment(me) && environment(me) != this_object()) return 1;
  time = (int)me->query_temp("TIMe");
  if (time <= 0) {
    msg = HIC "$N的身体微微发光,似乎充满了力量\n" NOR;
    message_vision(msg, me);
    msg = "你获得了这个魔法池的力量,以后可以使用由这个" + query("short") + "所提供的魔法\n"
      "以下是你以后可以使用的魔法,请仔细记住它的名称\n";
    m_skill = find_object("/daemon/magicpool/" + query("MAGIC_NAME"));
    if (!m_skill) m_skill = load_object("/daemon/magicpool/" + query("MAGIC_NAME"));

    if (!m_skill) {
      msg += "sorry,这个魔法巫师还没有完成.呵呵.\n";
      tell_object(me, msg);
      return 1;
    }
    persons = m_skill->query("PERSONS");
    if (!persons) persons = ({});
    if (member_array(me->query("id"), persons) == -1) {
      persons += ({ me->query("id") });
      m_skill->set("PERSONS", persons);
      m_skill->save();
    }

    msg += m_skill->help();  //魔法池提供的魔法里面都应该注明魔法名称和介绍.
    tell_object(me, msg + "\n" NOR);
    return 1;
  } else {
    time -= 5;
    me->set_temp("TIMe", time);
    msg = HIC "一股神秘的力量缓缓注入$N的身体\n" NOR;
    message_vision(msg, me);
    call_out("transfer_power", time, me);
    return 1;
  }
  return 1;
}
