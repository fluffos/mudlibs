#pragma save_binary
 
// equip.c

inherit ITEM;
inherit F_EQUIP;

void setup()
{
    mapping prop;
    return ;
    if( weight() < 6000 ) return ;
    if( mapp(prop=query("armor_prop")))
        { prop["dodge"]-= weight() / 6000;
          set("armor_prop",prop);
        }
    if( mapp(prop=query("weapon_prop")))
        { prop["dodge"]-= weight() / 6000;
          set("weapon_prop",prop);
        }
}
