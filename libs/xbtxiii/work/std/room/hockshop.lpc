// hockshop.c
#pragma save_binary
//sophos
//      add busy state for 1 sec at some critical codes.  1996-11-28

inherit ROOM;

object storage;

void remove()
{
        if( storage ) destruct(storage);
}

void setup()
{
        ::setup();
        seteuid(getuid());
        if( !storage ) {
                storage = new(__DIR__"hockshop_storage");
                storage->set("shop_ob", this_object());
                set("storage_ob", storage);
        }
}

void init()
{
        add_action("do_value", "value");
        add_action("do_sell", "sell");
        add_action("do_list", "list");
        add_action("do_buy", "buy");
        add_action("do_store", "store");
        add_action("do_apply","apply");
}

string value_string(int value)
{
        if( value < 1 ) value = 1;
        else if( value < 100 )
                return chinese_number(value) + "文钱";
        else
                return chinese_number(value/100) + "两"
                        + (value%100? "又" + chinese_number(value%100) + "文钱": "");
}

void pay_player(object who, int amount)
{
        object ob;

        if( amount < 1 ) amount = 1;
        if( amount/100 ) {
                ob = new(SILVER_OB);
                ob->set_amount(amount/100);
                ob->move(who);
                amount %= 100;
        }
        if( amount ) {
                ob = new(COIN_OB);
                ob->set_amount(amount);
                ob->move(who);
        }
}

int do_value(string arg)
{
        object ob;
        int value;

        if( !arg || !(ob = present(arg, this_player())) )
                return notify_fail("你要拿什么物品给当铺估价  \n");

        if( ob->query("money_id") )
                return notify_fail("这是「钱」  你没见过吗  \n");

        value = ob->query("value");
        if( !value ) printf("%s一文不值。\n", ob->query("name"));
        else 
                printf("%s价值%s。\n如果卖断(sell)  可以拿到%s。\n",
                        ob->query("name"), value_string(value),
                        value_string(value * 30 / 100), );

        return 1;
}

int do_sell(string arg)
{
        object ob;
    int value,rich;

    if( !(ob = present("hockshop owner", this_object())) )
        return notify_fail("老板不在,迟点再来吧。\n");
        if( !arg || !(ob = present(arg, this_player())) )
                return notify_fail("你要卖断什么物品  \n");

        if( ob->query("money_id") )        return notify_fail("你要卖「钱」  \n");
        value = ob->query("value");
        if( !value ) return notify_fail("这样东西不值钱。\n");

        if (ob->query("no_sell")) return notify_fail("这样东西不能卖。\n");


        if( this_player()->is_busy() )
                return notify_fail("请等一下，老板正给你算帐呢。\n" );
    if( value*3/10 >this_object()->query("rich") ) return notify_fail("当铺现在没那么多钱，你卖不掉。\n");

        this_player()->start_busy(1);
        message_vision("$N把身上的" + ob->query("name") + "卖掉。\n",
                this_player());

        pay_player(this_player(), value * 30 / 100);

        this_object()->add("rich",-value*3/10);
        if( storage ) {
                int s;

                // Make a simple storage management, when we have more goods in
                // storage, only keeps higher price goods.
//            s = sizeof(all_inventory(storage));
                if( value >= (200) ) {
                        ob->move(storage);
                }
                else destruct(ob);
        }
        else destruct(ob);

        return 1;
}


int do_list(string arg)
{
        object *inv;
        string msg;
        int i;

        if( !storage ) return notify_fail("当铺里现在没有货物。\n");
        inv = all_inventory(storage);
        if( !sizeof(inv) ) return notify_fail("当铺里现在没有货物。\n");

        msg = "当铺里现在有以下货物  \n  ";
        msg += implode( map_array(inv, (: sprintf("%-30s%s", $1->short(),
                value_string((int)$1->query("value") )) :)), "\n  ");
        msg += "\n";
        this_player()->start_more(msg);
        return 1;
}

int do_buy(string arg)
{
        int index;
        int i;
        object *inv, ob;

        if( !arg ) return notify_fail("你要买什么东西  \n");

        if( !storage ) return notify_fail("当铺里现在没有货物。\n");
        inv = all_inventory(storage);
        if( !sizeof(inv) ) return notify_fail("当铺里现在没有货物。\n  ");

        if( sscanf(arg, "%s %d", arg, index) != 2 ) index = 1;
        index--;
        for(i=0; i<sizeof(inv); i++)
                if( inv[i]->id(arg) && !(index--)) break;

        if( i==sizeof(inv) )
                return notify_fail("你要买什么东西  \n");
        ob = inv[i];

        if( (int)this_player()->can_afford((int)ob->query("value") ) != 1 )
                return notify_fail("你的(零)钱不够。\n");

        if( this_player()->is_busy() )
                return notify_fail("请等一下，老板正给你算帐呢。\n" );

        this_player()->start_busy(1);

        message_vision("$N掏出钱买下一" + ob->query("unit") + ob->name() + "。\n",
                this_player() );
        this_player()->pay_money((int)ob->query("value") );
        this_object()->add("rich",ob->query("value"));
        ob->delete("pawned_time");
        ob->move(this_player());

        return 1;
}

int do_store(string arg)
{
        if( !wizardp(this_player()) ) return 0;
        if( !storage ) return notify_fail("仓库物件不存在。\n");
        this_player()->move(storage);
        write("Ok.\n");
        return 1;
}

int do_apply(string arg)
{
object me,bag,*ob;
int s;
me=this_player();
if (!arg) return 0;
if (arg!="bag") return 0;
ob=all_inventory(me);
s=sizeof(ob);
while(s--)
        {
        if (!stringp(ob[s]->query("id"))) continue;
        if (ob[s]->query("id")=="qiankun bag")
                {
                tell_object(me,"你已经有乾坤袋了!\n");
                return 1;
                }
        }
bag=new("/obj/superbag.lpc");
bag->set("master_id",me->query("id"));
/*book->set("rich",0);*/
bag->move(me);
if (file_size(bag->query_save_file()+".o")>0) bag->restore();
tell_object(me,"你忽然觉得腰包一鼓, 好象多了点什么.\n");
tell_room(this_object(),"当铺老板把乾坤袋递给"+me->query("name")+".\n",me);
return 1;
}
