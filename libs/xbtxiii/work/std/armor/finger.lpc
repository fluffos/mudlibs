#include <ansi.h>
#include <armor.h>

inherit ITEM;

void setup()
{
        if( clonep(this_object()) ) return;

        set("armor_type", TYPE_FINGER);
        if( !query("armor_apply/dodge")
        &&      weight() > 3000 )
                set("armor_prop/dodge", - weight() / 3000 );
}
string type() { return "jewel"; }

int wear(int n)
{
        object owner;
        mapping armor_prop, applied_prop;
        string *apply, type;
        int i;
        string *finger;
        finger=({ "右手食指","右手中指","左手食指","左手中指",
                        "右手无名指","右手小指","左手无名指","左手小指"});
        // Only character object can wear armors.
        if( !(owner = environment())->is_character() ) return 0;

        // If already worn, just recognize it.
        if( query("equipped") ) return 1;

        // Check if we have "armor_prop" defined.
        if( !mapp(armor_prop = query("armor_prop")) )
                return notify_fail("你只能穿戴可当作护具的东西。\n");

        type = query("armor_type");
        for(i=0;i<10;i++){
                if( !owner->query_temp("armor/" + finger[i]) ){
                        type=finger[i];
                        break;
                        }
                if(i==7) return notify_fail("你手上已经戴满了戒指。\n");
                }
        if(n>0&&n<9&& !owner->query_temp("armor/" + finger[n-1]) )
              type=finger[n-1];
        owner->set_temp("armor/" + type, this_object());
        set("worn_finger",type);
        apply = keys(armor_prop);
        applied_prop = owner->query_temp("apply");
        if( !mapp(applied_prop) ) applied_prop = ([]);
        if(stringp(query("non_duplicate"))&&owner->query_temp(query("non_duplicate"))){
        }else {for(  i = 0; i<sizeof(apply); i++)
                   if( undefinedp(applied_prop[apply[i]]) )
                        applied_prop[apply[i]] = armor_prop[apply[i]];
                   else
                        applied_prop[apply[i]] += armor_prop[apply[i]];
                owner->set_temp("apply", applied_prop);
        }
        if(stringp(query("non_duplicate")))
                owner->add_temp(query("non_duplicate"),1);
        set("equipped", "worn");
        set("wear_msg",YEL "$N将$n戴在" + type + "上。\n" NOR);
        return 1;
}
int wield()
{
                return notify_fail("你只能装备可当作武器的东西。\n");
}
int unequip()
{
        object owner;
        mapping prop, applied_prop;
        string *apply, equipped;

        if( !objectp(owner = environment()) ) return 0;

        if( !stringp(equipped = query("equipped")) )
                return notify_fail("你目前并没有装备这样东西。\n");

        if( equipped=="worn" ) {
                owner->delete_temp("armor/" + (string)query("worn_finger") );
                prop = query("armor_prop");
        }

        apply = keys(prop);
        applied_prop = owner->query_temp("apply");
        if(stringp(query("non_duplicate"))&&(int)owner->query_temp(query("non_duplicate"))!=1){
        }else {for(int i = 0; i<sizeof(apply); i++)
                // To support array apply, we cannot add_temp() here.
                applied_prop[apply[i]] -= prop[apply[i]];
                owner->set_temp("apply", applied_prop);
        }
        if(stringp(query("non_duplicate")))
                owner->add_temp(query("non_duplicate"),-1);
        set("unequip_msg",YEL "$N将$n从"+query("worn_finger")+"取了下来。\n" NOR);

        delete("worn_finger");
        delete("equipped");
        return 1;
}

