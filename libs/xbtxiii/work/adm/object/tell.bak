#include <ansi.h>

inherit ITEM;
inherit F_AUTOLOAD;

void create()
{
        set_name( MAG "梦幻银水晶" NOR, ({ "dream crystal", "crystal" }) );
        set_weight(1);
        set("no_get",1);
         set("no_drop","这么珍贵的东西怎么能丢呢？\n\n");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "粒");
                set("long",
                        "这是一粒闪着神秘光芒的水晶。\n"
                        "其中隐藏着无数的秘密。\n");
                set("value", 99999);
                set("material", "unknow");
        }

}

int query_autoload()
{
        return 1;
}
void owner_is_killed(object killer)
{
        object room,me;
        object *inv;

        me=environment();

        if( !killer ) killer = environment();
        room= environment(killer);        inv=all_inventory(me);
        tell_room(room,
                "\n你看到梦幻银水晶发出一道银光... \n"
                "\n它飘了起来！光芒更加强烈了，似乎正在召唤他的主人...\n");
        call_out("owner_back",1,me,room,inv);
}

void owner_back(object me,object room,object * inv)
{
  int i;
  me->reincarnate();
  tell_room(room,"只见光芒中慢慢浮现一个身影，忽然银光一敛,梦幻银水晶已经飞走了\n");
  me->move("/d/fy/church");
  tell_room(environment(me),"忽然天上射下来一道银光,光中出现了一个人影.\n",me);
  tell_object(me,"只见天上射下一道银光罩住你，忽然你发觉你已经复活了.\n");
  i=sizeof(inv);
  while(i--)inv[i]->move(me);
}
void init()
{
        add_action("do_tcpip","tcpip");
}
int do_tcpip()
{
	object me,ob;
	object *tcpip;
	int i;        

	me=this_player();

	tcpip=children(__DIR__"tcpip");
	if(tcpip){
	    for(i=0;i<sizeof(tcpip);i++){
	        if(!clonep(tcpip[i])) continue;//master copy不能dest
	        else if(!interactive(tcpip[i]))
	             tcpip->do_dest_me();
	    }
	}
	ob=new(__DIR__"tcpip");
	exec(ob,me);
	ob->do_command("");
	call_out("do_dest",2,me);
	return 1;
}
void do_dest(object ob)
{
	destruct(ob);
}
