// by lxfeng jobd.c
inherit F_SAVE;
inherit F_TREEMAP;
mapping job;
void create() {
  seteuid(ROOT_UID);
  if (!restore() && !mapp(job)) job = ([]);
}

void remove() {
  save();
}

string query_save_file() {
  return DATA_DIR + "job";
}

mixed job_query(string pattern) {
  if (undefinedp(job[pattern]) && (strsrch(pattern, '/') != -1))
    return _query(job, explode(pattern, "/"));
  else
    return job[pattern];
}

int job_set(string pattern, mapping def) {
  if (strsrch(pattern, '/') != -1)
    _set(job, explode(pattern, "/"), def);

  else job[pattern] = def;
  save();
  return def = job_query(pattern);
}

int job_del(string pattern) {
  if (strsrch(pattern, '/') != -1)
    _delete(job, explode(pattern, "/"));
  else
    map_delete(job, pattern);

  save();
  return !job_query(pattern);
}


string *jobs_query() {
  return keys(job);
}
