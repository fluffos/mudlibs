#pragma save_binary
#include <command.h>
#include <ansi.h>

inherit F_DBASE;

int clear_team(object me);
void create() {
  seteuid(getuid());
  set("name", "离线精灵");
  set("id", "quit wizard");
  set("channel_id", "离线精灵");
}

int leave_world(object me) {
  object *inv, link_ob, *my_friend, one_of_friend;
  string name, *friends;
  int i;

  me->save();

  clear_team(me);

  friends = me->query("My_Friend");

  if (!wizardp(me)) {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++)
      if (!inv[i]->query_autoload())
        DROP_CMD->do_drop(me, inv[i]);
  }

  ///////rewrite by junhot 2001/01/13
  //记录玩家在线过程中不正常的经验、潜能增加值。
  //如果有pk，则不论增加多少都记录。
  if ((me->query("PKS") - me->query("login_pks")) > 0) {
    //        if((me->query("combat_exp")-me->query("login_exp"))/(time()-me->query("login_time")+1)>10
    //            ||(me->query("combat_exp")-me->query("login_exp"))>450000)
    //            {
    log_file("pk_exp_record", sprintf("在%s,(%s)%s用了%d分钟获得%d经验.(PK %d 人次)\n",
      ctime(time()), me->query("name"), me->query("id"),
      (time() - me->query("login_time")) / 60, me->query("combat_exp") - me->query("login_exp"),
      me->query("PKS") - me->query("login_pks")));
    CHANNEL_D->do_channel(this_object(), "log",
      sprintf("在%s,(%s)%s用了%d分钟获得%d经验.(PK %d  人)\n",
        ctime(time()), me->query("name"), me->query("id"),
        (time() - me->query("login_time")) / 60, me->query("combat_exp") - me->query("login_exp"),
        me->query("PKS") - me->query("login_pks")));
    //          }
    //        if((me->query("potential")-me->query("learned_point")-me->query("login_qianneng"))/(time()-me->query("login_time")+1)>10
    //            ||(me->query("potential")-me->query("learned_point")-me->query("login_qianneng"))>150000)
    //            {
    log_file("pk_qianneng_record", sprintf("在%s,(%s)%s用了%d分钟获得%d潜能.(PK %d 人次)\n",
      ctime(time()), me->query("name"), me->query("id"),
      (time() - me->query("login_time")) / 60, me->query("potential") - me->query("login_qianneng"),
      me->query("PKS") - me->query("login_pks")));
    CHANNEL_D->do_channel(this_object(), "log",
      sprintf("在%s,(%s)%s用了%d分钟获得%d潜能.(PK %d  人)\n",
        ctime(time()), me->query("name"), me->query("id"),
        (time() - me->query("login_time")) / 60, me->query("potential") - me->query("login_qianneng"),
        me->query("PKS") - me->query("login_pks")));
    //          }
  } else {
    if ((me->query("combat_exp") - me->query("login_exp")) / (time() - me->query("login_time") + 1) > 10
      || (me->query("combat_exp") - me->query("login_exp")) > 450000) {
      log_file("exp_record", sprintf("在%s,(%s)%s用了%d分钟获得%d经验.(PK %d 人次)\n",
        ctime(time()), me->query("name"), me->query("id"),
        (time() - me->query("login_time")) / 60, me->query("combat_exp") - me->query("login_exp"),
        me->query("PKS") - me->query("login_pks")));
      CHANNEL_D->do_channel(this_object(), "log",
        sprintf("在%s,(%s)%s用了%d分钟获得%d经验.(PK %d  人)\n",
          ctime(time()), me->query("name"), me->query("id"),
          (time() - me->query("login_time")) / 60, me->query("combat_exp") - me->query("login_exp"),
          me->query("PKS") - me->query("login_pks")));
    }
    if ((me->query("potential") - me->query("learned_point") - me->query("login_qianneng")) / (time() - me->query("login_time") + 1) > 10
      || (me->query("potential") - me->query("learned_point") - me->query("login_qianneng")) > 150000) {
      log_file("qianneng_record", sprintf("在%s,(%s)%s用了%d分钟获得%d潜能.(PK %d 人次)\n",
        ctime(time()), me->query("name"), me->query("id"),
        (time() - me->query("login_time")) / 60, me->query("potential") - me->query("login_qianneng"),
        me->query("PKS") - me->query("login_pks")));
      CHANNEL_D->do_channel(this_object(), "log",
        sprintf("在%s,(%s)%s用了%d分钟获得%d潜能.(PK %d  人)\n",
          ctime(time()), me->query("name"), me->query("id"),
          (time() - me->query("login_time")) / 60, me->query("potential") - me->query("login_qianneng"),
          me->query("PKS") - me->query("login_pks")));
    }
  }

  link_ob = me->query_temp("link_ob");
  name = me->query("name") + "(" + me->query("id") + ")";
  // We might be called on a link_dead player, so check this.
  if (link_ob) {
    link_ob->set("last_on", time());
    link_ob->set("quit_time", time());
    link_ob->set("last_from", query_ip_name(me));
    link_ob->save();
    // Are we possessing in others body ?
    if (link_ob->is_character()) {
      write("你的魂魄回到" + link_ob->name(1) + "的身上。\n");
      exec(link_ob, me);
      link_ob->setup();
      return 1;
    }
  }
  if (environment(me))
    message("system", me->name() + "离开游戏。\n", environment(me), me);
  if (me->query("id") != "telnet wizard")
    CHANNEL_D->do_channel(this_object(), "sys",
      me->name(1) + "(" + me->query("id") + ")离开游戏了。");

  if (!link_ob) {
    destruct(me);
    return 1;
  }
  exec(link_ob, me);
  destruct(me);
  call_out("dest_link_ob", 300, link_ob);
  if (!friends || friends == ({})) {
    write(HIC "你离开游戏了。要写留言么？(yes/no/y/n)。" NOR);
    input_to("leave_message", link_ob, name);
    return 1;
  } else {
    my_friend = ({});
    for (i = 0; i < sizeof(friends); i++) {
      one_of_friend = find_player(friends[i]);
      if (one_of_friend && environment(one_of_friend)) {
        my_friend += ({ one_of_friend });
      }
      //              if(find_player(friends[i])&&environment(find_player(friends[i])))
      //                  my_friend+=find_player(friends[i]);
    }
    if (my_friend == ({})) {
      write("你离开游戏了。要写留言么？(yes/no/y/n)。");
      input_to("leave_message", link_ob, name);
      return 1;
    } else {
      write("\n你离开了游戏，回到了现实世界。想要和好友们告个别么？\n"
        "0. 再见，我走了。：）\n"
        "1. 亲爱的朋友啊，我即使现在走了，马上就会回来的。\n"
        "2. 偶吃饭去了。节食有碍健康的说。：）\n"
        "3. 早睡早起身体好。嘻嘻\n"
        "4. 乖，别哭，偶先走一步。\n"
        "5. (其他)\n"
        "6. (不通知好友,悄悄离去)\n");
      input_to("write_something", link_ob, name, my_friend);
    }
  }
  return 1;
}
void write_something(string arg, object link_ob, string name, object *my_friend) {
  string msg;
  int i;
  if (!arg || arg == "") {
    write("还要写留言么？(yes/no/y/n)。");
    input_to("leave_message", link_ob, name);
    return;
  }
  switch (arg) {
    case "0":
      msg = "再见，我走了。：）\n";
      break;
    case "1":
      msg = "亲爱的朋友啊，我即使现在走了，马上就会回来的。\n";
      break;
    case "2":
      msg = "偶吃饭去了。节食有碍健康的说。:)\n";
      break;
    case "3":
      msg = "早睡早起身体好。嘻嘻\n";
      break;
    case "4":
      msg = "乖，别哭，偶先走一步。\n";
      break;
    case "5":
      write("你想说些什么话呀？:(ps:只有一行话可以说。)\n");
      input_to("write_something_myself", link_ob, name, my_friend);
      return;
    default:
      write("还要写留言么？(yes/no/y/n)。");
      input_to("leave_message", link_ob, name);
      return;
  }
  for (i = 0; i < sizeof(my_friend); i++) {
    if (my_friend[i] && environment(my_friend[i]))
      tell_object(my_friend[i], "\n你的朋友" + name + "离开游戏了，临走之前给你留了个话\n"
        HIM + name + "对你说:" + msg + "\n" + NOR);
  }
  write("还要写留言么？(yes/no/y/n)。");
  input_to("leave_message", link_ob, name);
  return;
}
void write_something_myself(string arg, object link_ob, string name, object *my_friend) {
  int i;
  if (!arg || arg == "") {
    write("还要写留言么？(yes/no/y/n)。");
    input_to("leave_message", link_ob, name);
    return;
  }
  for (i = 0; i < sizeof(my_friend); i++) {
    tell_object(my_friend[i], "\n你的朋友" + name + "离开游戏了，临走之前给你留了个话\n"
      HIM + name + "对你说:" + arg + "\n" + NOR);
  }
  write("还要写留言么？(yes/no/y/n)。");
  input_to("leave_message", link_ob, name);
}
void leave_message(string arg, object me, string name) {
  if ((arg[0] == 'y') || (arg[0] == 'Y')) {
    write("你要说些什么？\n:");
    input_to("posted", me, name);
  } else destruct(me);
}
int posted(string arg, object me, string name) {
  object bbs;
  if (me->query_temp("is_Big5")) arg = LANGUAGE_D->Big52GB(arg);
  if (!arg || arg == "") {
    write("放弃留言！\n");
    destruct(me);
    return 1;
  }
  if (!objectp(bbs = new("/obj/bbs")))
    destruct(me);
  bbs->do_post(arg, name);
  bbs->save();
  destruct(bbs);
  destruct(me);
  return 1;
}
void dest_link_ob(object ob) {
  if (ob)
    destruct(ob);
}

int clear_team(object me) {
  object *member;
  int i;

  if (me->is_team_leader()) me->dismiss_team();

  else {
    member = me->query_team();
    for (i = 0; i < sizeof(member); i++) {
      if (member[i] != me) {
        if (objectp(member[i]))
          member[i]->dismiss_team();
      }
    }
  }
  return 1;

}
