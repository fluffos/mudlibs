string query_save_file() {
  return PRIX;
}
void setup() {
  restore();
}
string objtype(object ob) {
  if (!objectp(ob)) return "no_obj";
  if (stringp(ob->type())) return ob->type();
  return "grocery";
}
void recover() {
  int i, j;
  string *area;
  area = keys(prix);
  for (i = 0; i < sizeof(area); i++) {
    prix[area[i]]["food"] -= (prix[area[i]]["food"] - price[area[i]]["food"]) / 10;
    prix[area[i]]["weapon"] -= (prix[area[i]]["weapon"] - price[area[i]]["weapon"]) / 10;
    prix[area[i]]["jewel"] -= (prix[area[i]]["jewel"] - price[area[i]]["jewel"]) / 10;
    prix[area[i]]["cloth"] -= (prix[area[i]]["cloth"] - price[area[i]]["cloth"]) / 10;
    prix[area[i]]["grocery"] -= (prix[area[i]]["grocery"] - price[area[i]]["grocery"]) / 10;
  }
  save();
}
int query_prix(string where, string type) {
  if (!where || !type) return 1000;
  if (undefinedp(prix[where]) || undefinedp(prix[where][type]))
    return 1000;
  if (prix[where][type] > supply[where][type] * 200) return 20000;
  return prix[where][type] * 100 / supply[where][type];
}
void sell_to_player(object seller, object ob) {
  string where, type;
  if (!stringp(where = seller->query("where"))) return;
  if (objtype(ob) == "no_obj") return;
  type = objtype(ob);
  prix[where][type] += ob->query("value") * query_prix(where, type) / 100;
  save();
}
int change_prix(string where, string type, int fee) {
  if (!where || !type) return 0;
  if (undefinedp(prix[where]) || undefinedp(prix[where][type]))
    return 0;
  prix[where][type] += fee;
  save();
  return prix[where][type];
}
