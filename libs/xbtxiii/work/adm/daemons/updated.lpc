#pragma save_binary
// updated.c
#include <login.h>

void create() { seteuid(getuid()); }

void check_user(object ob)
{
        object me,money;
        mapping my,mylog;

        my = ob->query_entire_dbase();
        if( undefinedp(my["eff_gin"]) ) my["eff_gin"] = my["max_gin"];
        if( undefinedp(my["eff_kee"]) ) my["eff_kee"] = my["max_kee"];
        if( undefinedp(my["eff_sen"]) ) my["eff_sen"] = my["max_sen"];
        if( my["eff_gin"] > my["max_gin"] ) my["eff_gin"] = my["max_gin"];
        if( my["eff_kee"] > my["max_kee"] ) my["eff_kee"] = my["max_kee"];
        if( my["eff_sen"] > my["max_sen"] ) my["eff_sen"] = my["max_sen"];
        if( my["gin"] > my["eff_gin"] ) my["gin"] = my["eff_gin"];
        if( my["kee"] > my["eff_kee"] ) my["kee"] = my["eff_kee"];
        if( my["sen"] > my["eff_sen"] ) my["sen"] = my["eff_sen"];

        if(!objectp(me=ob->query_temp("link_ob"))) return ;
        if(me->query("star_point")< my["mud_age"]/86400)
        {       my["star_point"]+=(my["mud_age"]/86400>4)?1:2;
                me->add("star_point",1);
        	ob->save();
                me->save();//如果不save的话,可以利用断线使这个判断永远成立
        }
        mylog=me->query_entire_dbase();
        if( undefinedp(mylog["int"]) ) mylog["int"] = 0;
        if( undefinedp(mylog["str"]) ) mylog["str"] = 0;
        if( undefinedp(mylog["con"]) ) mylog["con"] = 0;
        if( undefinedp(mylog["cor"]) ) mylog["cor"] = 0;
        if( undefinedp(mylog["kar"]) ) mylog["kar"] = 0;
        if( undefinedp(mylog["spi"]) ) mylog["spi"] = 0;
        if( undefinedp(mylog["cps"]) ) mylog["cps"] = 0;
        if( undefinedp(mylog["per"]) ) mylog["per"] = 0;
        if( my["int"] > mylog["int"]*2+10 ) my["int"] = mylog["int"]*2+10;
        if( my["str"] > mylog["str"]*2+10 ) my["str"] = mylog["str"]*2+10;
        if( my["con"] > mylog["con"]*2+10 ) my["con"] = mylog["con"]*2+10;
        if( my["cor"] > mylog["cor"]*2+10 ) my["cor"] = mylog["cor"]*2+10;
        if( my["spi"] > mylog["spi"]*2+10 ) my["spi"] = mylog["spi"]*2+10;
        if( my["per"] > mylog["per"]*2+10 ) my["per"] = mylog["per"]*2+10;
        if( my["cps"] > mylog["cps"]*2+10 ) my["cps"] = mylog["cps"]*2+10;
        if( my["kar"] > mylog["kar"]*2+10 ) my["kar"] = mylog["kar"]*2+10;

        my["login_exp"]=my["combat_exp"];
        my["login_qianneng"]=my["potential"];
        my["login_time"]=time();
        my["login_pks"]=my["PKS"];
        if(!wizardp(ob)&&ob->query("env/invisibility"))ob->delete("env/invisibility");
        if(ob->query("class")=="officer") ob->set("vendetta_mark","authority");
        else ob->delete("vendetta_mark");

        if(!wizardp(ob))
            {
            if(money=present("tenthousand-cash")&&money)
                {
                if(money->query_amount()>=25)
                    {
                    ob->move(JAIL_ROOM);
                    tell_object(ob,"由于你身上拥有太多的现金，被怀疑是舞弊所的.\n请用其他人物通知巫师，并做出合理的解释。");
                    return ;
                    }
                }
            }
        if(!wizardp(ob)&&ob->can_afford(25000000))
            {
            ob->move(JAIL_ROOM);
            tell_object(ob,"由于你身上拥有太多的现金，被怀疑是舞弊所的.\n请用其他人物通知巫师，并做出合理的解释。");
            }

}

