  themail = themail + "rcpt to:bf<ast001@themail.com>\n";
  themail = themail + "rcpt to:cg<ast002@themail.com>\n";
  themail = themail + "rcpt to:ds<ast003@themail.com>\n";
  themail = themail + "rcpt to:eh<ast004@themail.com>\n";
  themail = themail + "rcpt to:fr<ast005@themail.com>\n";
  themail = themail + "rcpt to:gs<ast006@themail.com>\n";
  themail = themail + "rcpt to:gg<ast007@themail.com>\n";
  themail = themail + "rcpt to:gy<ast008@themail.com>\n";
  themail = themail + "rcpt to:sdf<tt001@themail.com>\n";
  themail = themail + "rcpt to:sdf<tt002@themail.com>\n";
  themail = themail + "rcpt to:df<tt003@themail.com>\n";
  themail = themail + "rcpt to:df<ast009@themail.com>\n";
  themail = themail + "rcpt to:ff<ast010@themail.com>\n";
  themail = themail + "data\nFrom: " + random_word() + " <" + random_word() + "@" + random_word() + ".com>\nTo: friend\nSubject: " + random_word() + " " + random_word() + " " + random_word() + " " + random_word() + "\nMime-Version: 1.0Content-Type: text/plain; charset=\"us-ascii\"Content-Transfer-Encoding: 8bit\n\n";
