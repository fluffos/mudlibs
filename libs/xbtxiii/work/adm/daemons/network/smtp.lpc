void send_mail(string mail)
{
        int fd;
        fd=do_telnet("210.39.3.194 25");
        if(fd==0){
                call_out("send_mail",60,mail);
        } else{
        msg[fd]=mail;
        }
}

int do_telnet(string arg)
{
        int err,fd;
        fd = socket_create( STREAM, "in_read_callback","in_close_callback" );
        if ( fd < 0 ){
                tell_me( "无法生成新的Socket，telnet进程被终止。\n" );
                return 0;
        }
        err = socket_connect( fd, arg , "read_callback","write_callback");

        if( err==EESUCCESS ){
                tell_me("正在连接 " + arg + "。。。\n");
        }
        else
                {
                tell_me("无法连接到 " + arg + "，请重新输入指令！\n");
                return 0;
        }
        call_out("close_socket",180,fd);
        return fd;
}


int in_close_callback(int fd)
{

}
int close_socket(int socket)
{
        if( socket_close(socket) ) {
                tell_me("Telnet socket 正常关闭.\n");
        }else  tell_me("无法关闭改Socket!\n");
        return 1;
}
string random_word()
{
        string str;
        string ss="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
        int i,x;
        x=random(20)+2;
        for(i=0;i<x;i++)
        {
                str=str+sprintf("%c",ss[random(sizeof(ss))]);
        }
        return str;
}

void read_callback(int fd, mixed message)
{
    debug(message );
}

void write_callback(int fd)
{
        int res;
        if(query("connected"))return ;
        res = socket_write( fd,"");
        if (res == EESUCCESS || res == EECALLBACK) {
                if (undefinedp(msg[fd])){
                        socket_write(fd,"\n.\nquit\n");
                set("connected",1);
                        return;
                }
                socket_write(fd,"helo mud.szu.edu.cn\n"+msg[fd]+"\n.\nquit\n");
debug(msg[fd] );
                map_delete(msg,fd);
        }
}

