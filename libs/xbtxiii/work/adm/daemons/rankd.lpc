#include <ansi.h>

string query_rank(object ob)
{
        if( ob->is_ghost() ) return HIB "【 鬼  魂 】" NOR;
        switch(ob->query("gender")) {
        case "女性":
                switch(wizhood(ob)) {
                        case "(admin)":                 return HIW "【 女  神 】" NOR;
                        case "(arch)":                  return HIY "【 大魔女 】" NOR;
                        case "(wizard)":                return HIG "【 魔  女 】" NOR;
                        case "(apprentice)":            return HIC "【 小魔女 】" NOR;
                        case "(immortal)":              return HIC "【 仙  女 】" NOR;
                        default:
                if( ((int)ob->query("PKS") >= 80)&&(ob->query("combat_exp")<=1000000))
//                  ((int)ob->query("PKS") > (int)ob->query("MKS")/10) )
                    return HIR "【变态女杀人狂】" NOR;
                if( (int)ob->query("PKS") >60)
                    return HIR "【 女魔头 】" NOR;
                                if( (int)ob->query("thief") > 10 ) return "【 惯  窃 】";
                                switch(ob->query("class")) {
                                        case "bonze":           return "【 尼  姑 】";
                                        case "taoist":
                                        
                                                 if((int)ob->query("combat_exp")<250000) 
                                                        return HIY "【小 道 童】" NOR;
                                                 else if((int)ob->query("combat_exp")<1000000) 
                                                        return HIY "【 道  童 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<3000000) 
                                                        return HIY "【小 道 士】" NOR;
                                                 else if((int)ob->query("combat_exp")<4500000) 
                                                        return HIY "【 道  士 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<6000000) 
                                                        return HIY "【 道  长 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<8000000) 
                                                        return HIY "【 真  人 】" NOR;     
                                             else 
                                                        return HIY "【 天  师 】" NOR;
                                                 break;
                                        case "bandit":          return "【 女飞贼 】";
                                        case "guardman":        return "【 女镖师 】";
                                        case "dancer":
                                        
                                                 if((int)ob->query("combat_exp")<250000) 
                                                        return HIY "【 舞  童 】" NOR;
                                                 else if((int)ob->query("combat_exp")<1000000) 
                                                        return HIY "【 舞  婢 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<3500000) 
                                                        return HIY "【 舞  女 】" NOR;
                                                 else if((int)ob->query("combat_exp")<6000000) 
                                                        return HIY "【 舞  姬 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<8000000) 
                                                        return HIY "【 舞  仙 】" NOR;     
                                             else 
                                                        return HIY "【 舞  神 】" NOR;
                                                 break;

                                        case "scholar":        
                                                 if((int)ob->query("combat_exp")<250000) 
                                                        return HIM "【 书  童 】" NOR;
                                                 else if((int)ob->query("combat_exp")<1000000) 
                                                        return HIM "【 书  生 】" NOR;      
                                                 else if((int)ob->query("combat_exp")<2000000) 
                                                        return HIM "【 才  女 】" NOR;
                                                 else if((int)ob->query("combat_exp")<3000000) 
                                                        return HIM "【 女状元 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<4500000) 
                                                        return HIM "【 智  者 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<8000000) 
                                                        return HIM "【 先  知 】" NOR;     
                                                 else 
                                                        return HIM "【 圣  人 】" NOR;
                                                 break;
                                        
                                        case "officer":
                                                 if((int)ob->query("combat_exp")>=8000000)
                                                        return GRN "【 公　主 】" NOR;  

                                                 else if((int)ob->query("rank")==1)
                                                         return GRN "【 郡　主 】" NOR;  

                                                 else if((int)ob->query("rank")==2) 
                                                          return GRN "【 女公爵 】" NOR;
                                                 else if((int)ob->query("rank")==3) 
                                                          return GRN "【 女侯爵 】" NOR;  

                                                 else if((int)ob->query("rank")==4) 
                                                          return GRN "【 女伯爵 】" NOR;  

                                                 else if((int)ob->query("rank")==5) 
                                                          return GRN "【 女子爵 】" NOR;  

                                                 else if((int)ob->query("rank")==6) 
                                                          return GRN "【 参  将 】" NOR;     
                                                 else 
                                                        return GRN "【 小  校 】" NOR;
                                                 break;
                                        case "fighter":
                                        
                                                 if((int)ob->query("combat_exp")<250000) 
                                                        return HIY "【 武  者 】" NOR;
                                                 else if((int)ob->query("combat_exp")<1000000) 
                                                        return HIY "【 武  士 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<2000000) 
                                                        return HIY "【 武  师 】" NOR;
                                                 else if((int)ob->query("combat_exp")<3000000) 
                                                        return HIY "【 斗  士 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<4000000) 
