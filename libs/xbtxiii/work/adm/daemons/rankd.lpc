                                                 else if((int)ob->query("combat_exp")<5000000) 
                                                        return HIY "【 武  仙 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<6000000) 
                                                        return HIY "【 武  尊 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<8000000) 
                                                        return HIY "【 武  圣 】" NOR;     
                                             else 
                                                        return HIY "【 武  神 】" NOR;
                                                 break;

                                        case "swordsman":
                                                 if((int)ob->query("combat_exp")<250000) 
                                                        return HIC "【 剑  士 】" NOR;
                                                 else if((int)ob->query("combat_exp")<500000) 
                                                        return HIC "【 剑  客 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<1000000) 
                                                        return HIC "【 剑  侠 】" NOR;
                                                 else if((int)ob->query("combat_exp")<2000000) 
                                                        return HIC "【 剑  豪 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<3000000) 
                                                        return HIC "【 剑  痴 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<4000000) 
                                                        return HIC "【 剑  狂 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<5000000) 
                                                        return HIC "【 剑  魔 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<6000000) 
                                                        return HIC "【 剑  圣 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<8000000) 
                                                        return HIC "【 剑  神 】" NOR;     
                                                 else 
                                                        return HIC "【 天  剑 】" NOR;
                                                 break;
                                        case "alchemist":       return "【 方  士 】";
                                        case "shaman":          return "【 巫  医 】";
                                        
                                        
                                        case "xingxiu":
                                                 if((int)ob->query("combat_exp")<250000) 
