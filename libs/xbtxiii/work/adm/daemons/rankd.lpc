                                                 else if((int)ob->query("combat_exp")<2000000) 
                                                        return HIG "【 才  子 】" NOR;
                                                 else if((int)ob->query("combat_exp")<3000000) 
                                                        return HIG "【 状  元 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<4500000) 
                                                        return HIG "【 智  者 】" NOR;     
                                                 else if((int)ob->query("combat_exp")<8000000) 
                                                        return HIG "【 先  知 】" NOR;     
                                                 else 
                                                        return HIG "【 圣  人 】" NOR;
                                                 break;
                                        case "officer":
                         if((int)ob->query("combat_exp")>=8000000)
                            return GRN "【 摄政王 】" NOR;  
                                                 if((int)ob->query("rank")==1) 
