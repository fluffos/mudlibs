#pragma save_binary
#include <ansi.h>
inherit F_DBASE;
inherit F_CLEAN_UP;
object find_env(object ob);

mixed find_task_coor(string str);
nosave mapping task = ([]);
nosave string *task_file = ({
  "/task/mcyao",
  "/task/gold_hammer",
  "/task/afrji",
  "/task/gyin",
  "/task/xmdaofa",
  "/task/zwsword",
  "/task/hongbao",
  "/task/smwding",
  "/task/gtdqiao",
  "/task/yu_xiao",
  "/task/receipt",
  "/task/fonxansword",
  "/task/account_book",
  "/task/arring",
  "/task/washcloth",
  "/task/book",
  "/task/taoism",
  "/task/violet",
  "/task/lottery",
  "/task/flee",
  "/task/stormdance_book",
  "/task/lute",
  "/task/token",
  "/task/flag",
  "/task/shuaiyin",
  "/task/bead",
  "/task/bible",
  "/task/yi_jin_jing",
  "/task/cassock",
  "/task/dog_staff",
  "/task/mai_shen_qi",
  "/task/lime",
  "/task/di_qi",
  "/task/paper",
});
string *roomfile;
nosave object *npc, *ange, *room;
void create() {
  string file;
  file = read_file("/task/room_location");
  roomfile = explode(file, "\n");
  seteuid(getuid());
  set("channel_id", "使命精灵");
  set("no_clean_up", 1);

}
int query_coor(object ob) {
  object env;
  if (arrayp(ob->query("coor"))) return 1;
  if (objectp(env = environment(ob))) return query_coor(env);
  return 0;
}
object find_target() {
  string file;
  int i;
  object ob, cur_obj, *target, *inv;
  file = roomfile[random(sizeof(roomfile))];
  if (file_size(file + ".lpc") < 1) {
    "/adm/daemons/room"->delete_file(file);
    roomfile -= ({ file });
    return find_target();
  }
  ob = find_object(file);
  target = ({});
  if (ob)
    ob->reset();
  else if (catch(ob = load_object(file)) || !arrayp(ob->query("coor"))) {
    "/adm/daemons/room"->delete_file(file);
    roomfile -= ({ file });
    return find_target();
  }
  cur_obj = ob;
  if (cur_obj) {
    inv = all_inventory(cur_obj);
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->is_character() && !userp(inv[i]))
        target += ({ inv[i] });
      if (inv[i]->is_container()) target += ({ inv[i] });
    }
  }
  if (sizeof(target)) cur_obj = target[random(sizeof(target))];
  else if (random(5)) return find_target();
  return cur_obj;

}
void init_task() {

  call_out("send_task", 1);
}
void send_task() {
  int i, flag = 0;
  object obj, target;
  for (i = 0; i < sizeof(task_file); i++) {
    if (find_task_coor(task_file[i])) continue;
    obj = new(task_file[i]);
    obj->set_temp("task", 1);
    target = find_target();
    catch(flag = obj->move(target));
    CHANNEL_D->do_channel(
      this_object(),
      "log",
      HIR "" + obj->name() + "放在了" + (target->query("name") ? target->query("name") : target->query("short")) + "" NOR
    );
    if (flag) {
      task[task_file[i]] = ([
        "sent": 1,
        "obj": obj,
        "finish": 0,
      ]);
    } else {
      destruct(obj);
      i--;
    }
  }

}

void load_task() {
  call_out("init_task", 0);
}

mixed query_task(string str) {
  if (str) return task[str];
  return task;
}
int reset_task() {
  int i, flag = 0;
  for (i = 0; i < sizeof(task_file); i++)
    if (find_task_coor(task_file[i])) flag++;
  if (flag > 15) return 0;
  if (random(sizeof(users()) + 15) < 15) return 0;
  call_out("init_task", 0);
  return 1;
}
int resolve_task() {
  CHANNEL_D->do_channel(this_object(), "chat", HIR "一分钟后分解所有使命......" NOR);
  call_out("destruct_task", 60);
}
int destruct_task() {
  int i;
  for (i = 0; i < sizeof(task_file); i++)
    if (objectp(task[task_file[i]]["obj"]))
      destruct(task[task_file[i]]["obj"]);
  CHANNEL_D->do_channel(this_object(), "chat", HIR "现在使命分解完毕。" NOR);
  call_out("init_task", 0);
}
mixed query_locate(object ob) {
  object env;

  if (!objectp(ob)) return 1;
  if (arrayp(ob->query("coor"))) return ob->query("coor");
  if (objectp(env = environment(ob))) return query_locate(env);
  return 0;
}
mixed find_task_coor(string str) {
  object ob;
  if (!str) return 0;
  if (undefinedp(task[str])) return 0;
  if (task[str]["finish"]) return 0;
  if (!objectp(ob = task[str]["obj"])) return 0;
  return query_locate(ob);
}
int task_bonus(object me, object ob) {
  int exp, pot, score, task, i;
  object *member;
  task = me->query("TASK");

  exp = 500 + 20 * sizeof(users()) + (2000 / (task + 1000) - 1) * 400;
  pot = 60 + 2 * sizeof(users()) + (2000 / (task + 1000) - 1) * 60;
  score = 0;
  // 限制task可以做的个数，随着完成task的增加，得到的经验减少
  //当task>1000 2000/(task+1000)-1 < 0
  //经验高于1000w的公式的 基数 变少
  if (!ob->query("task") || !ob->query_temp("task")) return 0;
  //    if(me->query("combat_exp") <=600000) 
  //      return notify_fail("你的经验不足，不能完成这项使命！\n");
  if (me->query("combat_exp") >= 10000000 && me->query("TASK") >= 1000) {
    //经验都这么高了，还是别做了。呵呵。
    exp = 100 + 20 * sizeof(users()) + (2000 / (task + 1000) - 1) * 400;
    pot = 10 + 2 * sizeof(users()) + (2000 / (task + 1000) - 1) * 60;
    score = 0;
    if (exp < 0) exp = 0; if (pot < 0) pot = 0;
  }
  if (exp == 0 || pot == 0) {
    tell_object(me, HIY "你已经是一个顶尖task高手了，还是换换口味，做点别的吧!\n");
    me->add("TASK", -2);
  }
  if (ob->query_temp("task") == 2)  //这个task是由storyd产生的剧情task,所以奖励高一些,提高娱乐性吧
  {
    if (pointerp(member = me->query_team()))  //为了加强玩家之间的合作精神,队伍获得的经验大家都有份
    {
      for (i = 0; i < sizeof(member); i++) {
        if (member[i]->query("combat_exp") <= 10000000) {
          member[i]->add("combat_exp", 3 * exp);
          member[i]->add("potential", 3 * pot);
          member[i]->add("score", 3 * score);
          tell_object(me, "恭喜你！你的队伍完成了一项特殊的使命！\n");
          tell_object(me, HIW "你被奖励了：\n"
            +chinese_number(3 * exp) + "点实战经验\n"
            +chinese_number(3 * pot) + "点潜能\n" NOR);
        }
      }
    } else {
      me->add("combat_exp", 2 * exp);
      me->add("potential", 2 * pot);
      me->add("score", 2 * score);
      tell_object(me, "恭喜你！你完成了一项特殊的使命！\n");
      tell_object(me, HIW "你被奖励了：\n"
        +chinese_number(2 * exp) + "点实战经验\n"
        +chinese_number(2 * pot) + "点潜能\n" NOR);
      CHANNEL_D->do_channel(this_object(), "log", me->name(1) + "完成了" + ob->name());
    }
    destruct(ob);
    return 1;
  }
  //下面是完成的普通task,同样也分队伍完成和个人完成
  if (pointerp(member = me->query_team()))  //为了加强玩家之间的合作精神,队伍获得的经验大家都有份
  {
    for (i = 0; i < sizeof(member); i++) {
      if (member[i]->query("combat_exp") <= 10000000) {
        member[i]->add("combat_exp", 2 * exp);
        member[i]->add("potential", 2 * pot);
        member[i]->add("score", 2 * score);
        tell_object(me, "恭喜你！你的队伍完成了一项使命！\n");
        tell_object(me, HIW "你被奖励了：\n"
          +chinese_number(2 * exp) + "点实战经验\n"
          +chinese_number(2 * pot) + "点潜能\n" NOR);
      }
    }
  } else {
    me->add("combat_exp", exp);
    me->add("potential", pot);
    me->add("score", score);
    me->add("TASK", 1);
    tell_object(me, "恭喜你！你完成了一项使命！\n");
    tell_object(me, HIW "你被奖励了：\n"
      +chinese_number(exp) + "点实战经验\n"
      +chinese_number(pot) + "点潜能\n" NOR);
    CHANNEL_D->do_channel(this_object(), "log", me->name(1) + "完成了" + ob->name());
  }
  destruct(ob);
  return 1;
}

object find_env(object ob) {
  while (ob) {
    if (ob->query("coor")) return ob;
    else ob = environment(ob);
  }
  return ob;
}
