#pragma save_binary
#pragma save_binary
// weapond.c

#include <ansi.h>
#include <combat.h>

mapping material = ([
  "iron": 100,
  "steel": 120,
  "bamboo": 30,
  "blacksteel": 180,
  "crimsonsteel": 200,
  "brass": 280,
  "sapphire": 180,
  "wood": 40,
  "skin": 100,
  "leather": 80,
  "异类金属": 200,
  "crimson gold": 200,
]);

mapping weapon_actions = ([
  "slash": ([
    "damage_type": "割伤",
    "action": "$N挥动$w，斩向$n的$l",
    "parry": 20,
    "post_action": (: call_other, __FILE__, "break_weapon" :),
  ]),
  "slice": ([
    "damage_type": "砍伤",
    "action": "$N用$w往$n的$l砍去",
    "dodge": 20,
    "post_action": (: call_other, __FILE__, "break_weapon" :),
  ]),
  "chop": ([
    "damage_type": "劈伤",
    "action": "$N的$w朝著$n的$l劈将过去",
    "parry": -20,
    "post_action": (: call_other, __FILE__, "break_weapon" :),
  ]),
  "hack": ([
    "action": "$N挥舞$w，对准$n的$l一阵乱砍",
    "damage_type": "砍伤",
    "damage": 30,
    "dodge": 30,
    "post_action": (: call_other, __FILE__, "break_weapon" :),
  ]),
  "thrust": ([
    "damage_type": "刺伤",
    "action": "$N用$w往$n的$l刺去",
    "dodge": 15,
    "parry": -15,
    "post_action": (: call_other, __FILE__, "break_weapon" :),
  ]),
  "pierce": ([
    "action": "$N的$w往$n的$l狠狠地一捅",
    "damage_type": "刺伤",
    "dodge": -30,
    "parry": -30,
    "post_action": (: call_other, __FILE__, "break_weapon" :),
  ]),
  "whip": ([
    "action": "$N将$w一扬，往$n的$l抽去",
    "damage_type": "鞭伤",
    "dodge": -20,
    "parry": 30,
  ]),
  "impale": ([
    "action": "$N用$w往$n的$l直戳过去",
    "damage_type": "刺伤",
    "dodge": -10,
    "parry": -10,
    "post_action": (: call_other, __FILE__, "break_weapon" :),
  ]),
  "bash": ([
    "action": "$N挥舞$w，往$n的$l用力一□",
    "damage_type": "挫伤",
    "post_action": (: call_other, __FILE__, "break_weapon" :),
  ]),
  "crush": ([
    "action": "$N高高举起$w，往$n的$l当头砸下",
    "damage_type": "挫伤",
    "post_action": (: call_other, __FILE__, "break_weapon" :),
  ]),
  "slam": ([
    "action":
    "$N手握$w，眼露凶光，猛地对准$n的$l挥了过去",
    "damage_type": "挫伤",
    "post_action": (: call_other, __FILE__, "break_weapon" :),
  ]),
  "throw": ([
    "action": "$N将$w对准$n的$l射了过去",
    "damage_type": "刺伤",
    "post_action": (: call_other, __FILE__, "throw_weapon" :),
  ]),
]);

varargs mapping query_action() {
  string verb, *verbs;

  verbs = previous_object()->query("verbs");

  if (!pointerp(verbs)) return weapon_actions["hit"];
  else {
    verb = verbs[random(sizeof(verbs))];
    if (!undefinedp(weapon_actions[verb])) return weapon_actions[verb];
    else return weapon_actions["hit"];
  }
}

void throw_weapon(object me, object victim, object weapon, int damage) {
  if (objectp(weapon)) {
    if ((int)weapon->query_amount() == 1) {
      weapon->unequip();
      tell_object(me, "\n你的" + weapon->query("name") +
        "用完了！\n\n");
    }
    weapon->add_amount(-1);
  }
}
void break_weapon(object me, object victim, object weapon, int damage) {
  object ob;
  int wap, wdp, ap, dp;
  int flag;
  return;
  if (objectp(weapon)
    && damage == RESULT_PARRY
    && ob = victim->query_temp("weapon")) {
    wap = (int)weapon->weight() / 1000 + (int)weapon->query("weapon_prop/damage") + (int)me->query("str") + (int)me->query("force_factor");
    if (undefinedp(dp = material[ob->query("material")])) dp = 100;
    dp += (int)ob->weight() / 500 + (int)victim->query("force_factor") / 2;
    ap = (int)ob->weight() / 1000 + (int)ob->query("weapon_prop/damage") + (int)victim->query("str") + (int)victim->query("force_factor");
    if (undefinedp(dp = material[weapon->query("material")])) wdp = 100;
    wdp += (int)weapon->weight() / 500 + (int)me->query("force_factor") / 2;
    wap = random(wap);
    ap = random(ap);

    flag = 1;
    if (wap > dp) {
      if (weapon->query("skill_type") == "sword"
        || weapon->query("skill_type") == "blade")
        message_vision(HIW "只听见「当」地一声，$N手中的"
          +ob->name()
          + "已经砍成为两截！\n" NOR, victim);
      else message_vision(HIW
        "只听见「啪」地一声，$N手中的" + ob->name()
        + "已经断为两截！\n" NOR, victim);

      ob->unequip();
      ob->move(environment(victim));
      ob->set("name", "断掉的" + ob->query("name"));
      ob->set("value", (int)ob->query("value") / 10);
      ob->set("weapon_prop", 0);
      victim->reset_action();
      flag = 0;
      ob->break_weapon();
    }
    if (ap > wdp) {
      if (ob->query("skill_type") == "sword"
        || weapon->query("skill_type") == "blade")
        message_vision(HIW "只听见「当」地一声，$N手中的" + weapon->name()
          + "已经砍为两截！\n" NOR, me);
      else message_vision(HIW
        "只听见「啪」地一声，$N手中的" + weapon->name()
        + "已经断为两截！\n" NOR, me);

      weapon->unequip();
      weapon->move(environment(me));
      weapon->set("name", "断掉的" +
        weapon->query("name"));
      weapon->set("value", (int)weapon->query("value") / 10);
      weapon->set("weapon_prop", 0);
      me->reset_action();
      flag = 0;
      weapon->break_weapon();
    }
    if (flag) {
      message_vision("$N的" + weapon->name() + "和$n的" +
        ob->name() + "相击，冒出点点的火星。\n", me, victim);
    }
  }
}

void weapon_used(object me, object victim, object weapon, int damage) {
  object ob, *inv;
  int i, j, flag;
  if (damage == RESULT_PARRY &&
    objectp(ob = victim->query_temp("weapon"))) {
    if (random(ob->query("weapon_prop/damage")) < 2 &&
      ob->query("weapon_prop/damage") > 3) {
      ob->add("weapon_prop/damage", -1);
      if (random(ob->query("weapon_prop/damage") + 10000) < 10000)
        ob->add("lost_prop", 1);
      victim->add_temp("apply/damage", -1);
    }
    if (random(weapon->query("weapon_prop/damage")) < 2 &&
      weapon->query("weapon_prop/damage") > 3) {
      weapon->add("weapon_prop/damage", -1);
      weapon->add("lost_prop", 1);
      me->add_temp("apply/damage", -1);
    }
    flag = 1;
    if (weapon->query("weapon_prop/damage") >
      4 * ob->query("weapon_prop/damage")) {
      if (weapon->query("skill_type") == "sword"
        || weapon->query("skill_type") == "blade")
        message_vision(HIW "只听见「当」地一声，$N手中的"
          +ob->name()
          + "已经砍成为两截！\n" NOR, victim);
      else message_vision(HIW
        "只听见「啪」地一声，$N手中的" + ob->name()
        + "已经断为两截！\n" NOR, victim);

      ob->unequip();
      ob->move(environment(victim));
      ob->set("name", "断掉的" + ob->query("name"));
      ob->set("value", 0);
      ob->add("lost_prop", ob->query("weapon_prop/damage"));
      ob->set("weapon_prop", 0);
      victim->reset_action();
      flag = 0;
      ob->break_weapon();
    }
    if (weapon->query("weapon_prop/damage") * 4 <
      ob->query("weapon_prop/damage")) {
      if (ob->query("skill_type") == "sword"
        || weapon->query("skill_type") == "blade")
        message_vision(HIW "只听见「当」地一声，$N手中的" + weapon->name()
          + "已经砍为两截！\n" NOR, me);
      else message_vision(HIW
        "只听见「啪」地一声，$N手中的" + weapon->name()
        + "已经断为两截！\n" NOR, me);

      weapon->unequip();
      weapon->move(environment(me));
      weapon->set("name", "断掉的" +
        weapon->query("name"));
      weapon->set("value", 0);
      weapon->add("lost_prop", weapon->query("weapon_prop/damage"));
      weapon->set("weapon_prop", 0);
      me->reset_action();
      flag = 0;
      weapon->break_weapon();
    }
    if (flag) {
      message_vision("$N的" + weapon->name() + "和$n的" +
        ob->name() + "相击，冒出点点的火星。\n", me, victim);
    }
  }
  if (damage > 0) {
    if (random(weapon->query("weapon_prop/damage")) < 1 &&
      weapon->query("weapon_prop/damage") > 3) {
      weapon->add("weapon_prop/damage", -1);
      weapon->add("lost_prop", 1);
      me->add_temp("apply/damage", -1);
    }
    inv = all_inventory(victim);
    j = 0;
    flag = 0;
    for (i = 0; i < sizeof(inv); i++)
      if ((string)inv[i]->query("equipped") == "worn") j++;
    if (j == 0) return;
    flag = random(j);
    j = 0;
    for (i = 0; i < sizeof(inv); i++)
      if ((string)inv[i]->query("equipped") == "worn") {
        if (flag == j) ob = inv[i];
        j++;
      }
    if (ob->query("armor_prop/armor") > 1) {
      ob->add("armor_prop/armor", -1);
      ob->add("lost_prop", 1);
      victim->add_temp("apply/armor", -1);
      tell_object(victim, "你的" + ob->name() + "给打了窟窿.\n");
    }
  }
}
