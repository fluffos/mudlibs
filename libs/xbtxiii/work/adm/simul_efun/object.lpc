
// object.c

varargs int getoid(object ob)
{
        int id;

        if (!ob) ob = previous_object();
        sscanf(file_name(ob), "%*s#%d", id);
        return id;
}

// Get the owner of a file.  Used by log_error() in master.c.
string file_owner(string file)
{
    string name, rest ;

    if (file[0] != '/') {
        file = "/" + file;
    }
   if (sscanf(file, "/open/%s/%s", name, rest) == 2) {
        return name;
    }
    return 0;
}

// domain_file should return the domain associated with a given file.
string domain_file(string file)
{
        string domain;

        if( sscanf(file, "/d/%s/%*s", domain) )
                return capitalize(domain);

      if( sscanf(file, "/open/%*s") )
                return "Wizard";

        return ROOT_UID;
}

// creator_file should return the name of the creator of a specific file.
string creator_file(string file)
{
        string *path;

        path = explode(file, "/") - ({ 0 });
        if( !sizeof(path) ) return ROOT_UID;

        switch(path[0]) {
                case "adm":
                case "cmds":
                        return ROOT_UID;
                case "d":
                        return "Domain";
                case "u":
        return "Domain";
                case "open":
                      //if(sizeof(path)>2) return path[1];
                        return "Test";
                case "obj":
        return "Domain";
                case "daemon":
        return "Domain";
                default:
                      if( this_player(1) ) return getuid(this_player(1));
                      else  return "Mudlib";
        }
}

// author_file should return the name of the author of a specific file.
string author_file(string file)
{
        string name;
	if(!stringp(file)) return ROOT_UID;
      if( sscanf(file, "/open/%s/%*s", name) )
                return name;
        return ROOT_UID;
}

int living(object ob)
{
	if(ob->query_temp("disable_command")) return 0;
	return efun::living(ob);
}
void add_light(object ob,int light)
{
	if(!ob) return;
	ob->add_temp("light",light);
	if(environment(ob)) add_light(environment(ob),light);
}
varargs object snoop(object snooper, object snoopee )
{

        if(!snoopee) { efun::snoop(snooper);}
        else {	 
            if(previous_object()&&geteuid(previous_object())==ROOT_UID)
	        efun::snoop(snooper,snoopee);
	    }

}

varargs int exec(object to, object from )
{
        if(previous_object()&&geteuid(previous_object())==ROOT_UID)
        efun::exec(to,from);

}

varargs void shutdown(int how)
{
        if(previous_object()&&geteuid(previous_object())==ROOT_UID)
	        efun::shutdown(how);

}

varargs void destruct(object ob)
{
        if (ob) {
                if( previous_object() ) 
                      ob->remove( geteuid(previous_object()) );
                else ob->remove(0);
        }
        efun::destruct(ob);
}