#include <localtime.h>

private string * month_name=({
	"Jan","Feb","Mar","Apr","May","Jun",
	"Jul","Aug","Sep","Oct","Nov","Dec",
});

private string * week_name=({
	"Sun","Mon","Tue","Wed","Thu","Fri","Sat",
});

private int * days_a_month=({
	31,28,31,30,31,30,31,31,30,31,30,31,
});

int leap_year(int year)
{
	if (year%400==0)
	  return 1;
	if (year%100==0)
	  return 0;
	if (year%4==0)
	  return 1;
	return 0;
}

int days_a_year(int year)
{
	return 365+leap_year(year);
}

int month_to_int(string x)
{
	int i;
	i=member_array(x,month_name);
	if (i>=0)
	  return i+1;
	return 0;
}

int day_of_year(int year,int month,int day)
{
	int i,n;
	days_a_month[1]=28+leap_year(year);
	n=0;
	for(i=1;i<month;i++)
	  n+=days_a_month[i-1];
	n+=day-1;
	return n;
}

int day_of_week(int year,int day)
{
	int x,y;
	y=year-1;
	x=y;
	x+=y/4;
	x-=y/100;
	x+=y/400;
	x+=day;
	return x%7;
}

string time_string(int time)
{
  int day_of_week;
  int month;
  int day_of_month;
  int hour;
  int minute;
  int second;
  int year;
  string time_string;
  int j;
  if (time<0)
    time=0;
  year=1970;
  while (time>=(j=days_a_year(year)*86400))
  {
  	time-=j;
  	year++;
  }
  day_of_week=day_of_week(year,time/86400+1);
  days_a_month[1]=28+leap_year(year);
  month=1;
  while (month<=12&&time>=(j=days_a_month[month-1]*86400))
  {
	time-=j;
	month++;
  }
  day_of_month=time/86400+1;
  time%=86400;
  hour=time/3600;
  time%=3600;
  minute=time/60;
  time%=60;
  second=time;
  time_string=sprintf("%s, %d %s %d %02d:%02d:%02d GMT",
		      week_name[day_of_week],
		      day_of_month,
		      month_name[month-1],
		      year,
		      hour,
		      minute,
		      second);
  return time_string;
}

string localtime_string(int t)
{
   mixed*  lt;
   string  output;
   lt = localtime( t );

   output = sprintf("%s, %d %s %d %02d:%02d:%02d %s",
     week_name[ lt[LT_WDAY] ],  lt[LT_MDAY],month_name[ lt[LT_MON] ],lt[LT_YEAR],
     lt[LT_HOUR],lt[LT_MIN],lt[LT_SEC], lt[LT_ZONE]);
   return output;
}

int string_time(string x)
{
  string day_of_week;
  string month;
  int day_of_month;
  int hour;
  int minute;
  int second;
  int year;
  int t,i;
  if (!x)
    return 0;
  if (sscanf(x,"%s, %d %s %d %d:%d:%d GMT",
		      day_of_week,
		      day_of_month,
		      month,
		      year,
		      hour,
		      minute,
		      second)!=7)
  	return 0;
  t=second;
  t+=minute*60;
  t+=hour*3600;
  t+=day_of_year(year,month_to_int(month),day_of_month)*86400;
  for(i=1970;i<year;i++)
    t+=days_a_year(i)*86400;
  return t;
}

string short_time(int t)
{
	mixed * lt=localtime(t);
	return sprintf("%02d/%02d/%02d %02d:%02d:%02d",
		lt[LT_MON]+1,
		lt[LT_MDAY],
		lt[LT_YEAR],
		lt[LT_HOUR],
		lt[LT_MIN],
		lt[LT_SEC]
	);
}

int gametime(int t)
{
    if (!t)
      t=time();
    if (t<900000000)
      error("this system must be used after 01/01/1999.");
    return (t-900000000)*60;
}

