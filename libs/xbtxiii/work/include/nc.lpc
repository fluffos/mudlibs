// call.c
#include "ansi.h"
inherit F_CLEAN_UP;
void notice();

int main(object me, string arg) {
  if (!arg) {
    notice();
    return 1;
  } else
    remove_call_out("notice");
  return 1;

}

void notice() {
  int i;
  string line;
  line = SAVEC;
  for (i = 1; i < 5; i++) {
    line += TOPOINT(i, 70) + CLR_LINE;
  }


  line += TOPOINT(
    5,
    70
  ) + "重大" + TOPOINT(
    6,
    70
  ) + "更新" + TOPOINT(
    7,
    70
  ) + CLR_LINE + TOPOINT(
    7,
    71
  ) + "请" + TOPOINT(8, 70) + "参考" + TOPOINT(9, 70) + "帮助" + TOPOINT(40, 1);
  line += REST;
  remove_call_out("main");
  remove_call_out("notice");
  message("system", line, users());
  call_out("notice", 3, 0);
}
