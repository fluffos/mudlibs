#pragma save_binary
// park.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
        add_light(this_object(),1);
	add_light(this_object(),1);
	set("coor",({2200,3820,0}));
	set("short", "张家花园");
	set("long",
"你现在正站在张家花园里\n"
);
        set("exits", ([
                "south"          : "/u/cloud/eroad2" 
        ]) );
        set("objects", ([
                      "/u/cloud/npc/flower_worker":2,
                   ])); 
        setup();

}

