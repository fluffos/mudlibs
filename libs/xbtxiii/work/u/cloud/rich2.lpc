#pragma save_binary
// rich2.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create() {
  add_light(this_object(), 1);
  set("coor", ({ 2250, 3880, 0 }));
  set("short", "张百万家后院");
  set("long",
    "你现在正站在张百万家里靠近门口的地方有一块乌木雕成的招牌\n"
    "(sign)。\n"
  );
  set("exits", ([
    "south": "/u/cloud/rich1",
  ]));

  set("objects", ([
    "/u/cloud/npc/zhang": 1,
    "/u/cloud/npc/room_guard": 2,
  ]));
  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  setup();

}

string look_sign(object me) {
  return "招牌写著：非请莫入。\n";
}
