#pragma save_binary
// monky.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
        add_light(this_object(),1);
	set("coor",({2050,3780,0}));
	set("short", "斋院");
	set("long",
"你现在正站在斋院里靠近门口的地方有一块乌木雕成的招牌(sig\n"
"n)。\n"
);
        set("exits", ([
                "north"          : "/u/cloud/wroad2" ]) );

        set("item_desc", ([
                "sign": (: look_sign :),
        ]) );
        set("objects", ([
		"/u/cloud/npc/monk" : 1,
		"/d/snow/npc/beggar" : 2,
		"/obj/example/dumpling" : 1,
        "/obj/food/juzitang" : 2,
	]) );

        setup();

}

string look_sign(object me)
{
        return "招牌写著：善。\n";
}

