#pragma save_binary
// jiyuan2.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
        add_light(this_object(),1);
	set("coor",({2150,4220,5}));
	set("short", "怡红院二楼");
	set("long",
"这是怡红院的姑娘们陪客人们饮酒品茗，吟诗作赋的地方，甚是\n"
"幽雅。\n"
);
        set("exits", ([
                "down"  : "/u/cloud/jiyuan" ]) );

	set("objects", ([
                "/u/cloud/npc/girl" : 1,
	]) );

        setup();

}


