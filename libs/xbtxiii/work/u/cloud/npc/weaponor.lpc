#pragma save_binary
// weaponor.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("兵器贩子", ({ "weaponor" }) );
        set("title", "兵器屋");
        set("gender", "男性" );
        set("age", 32);
        set("long", "卖兵器的是个中年人，满脸伤疤。\n");
        set("combat_exp", 20000);
        set("attitude", "friendly");
        set_skill("unarmed", 100);
        set_skill("dodge", 100);
        set_skill("sword", 60);

        set("inquiry", ([
                "兵器屋" : "本店专卖各种长短兵器", 
        ]) );
//        set("where","north");

        set("vendor_goods", ([
			"/obj/weapon/dagger.lpc":10,
			"/obj/weapon/spear/muqiang":10,
			"/obj/weapon/blade":10,
			"/obj/weapon/thin_sword":10,
	   	    "/obj/weapon/sixhammer":10,
			"/obj/weapon/shield":10,
			"/obj/weapon/hongyingqiang":10,
			"/obj/weapon/dart":10,
			"/obj/weapon/longsword":10,
			"/obj/weapon/spear":20,
			"/obj/weapon/whip":10,
	        ]) );

        setup();
        add_money("silver", 50);
        add_money("coin", 300);
        carry_object("/obj/cloth")->wear();
        carry_object("/obj/weapon/longsword")->wield();
}

void init()
{
        object ob;
		int t, d, h, m, s;
        t = uptime();
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
if(m>=1&&m<3)
        set("vendor_goods", ([
			"/obj/weapon/dagger.lpc":10,
			"/obj/weapon/spear/muqiang":10,
			"/obj/weapon/blade":10,
			"/obj/weapon/thin_sword":10,
	   	    "/obj/weapon/sixhammer":10,
			"/obj/weapon/shield":10,
			"/obj/weapon/hongyingqiang":10,
			"/obj/weapon/dart":10,
			"/obj/weapon/longsword":10,
			"/obj/weapon/spear":20,
			"/obj/weapon/whip":10,
			"/obj/weapon/spear/gangqiang":2,
			"/obj/weapon/spear/yinqiang":2,
			"/obj/treasure/spear":1,
            "/obj/weapon/sword/yue_nv_sword":1,
            "/obj/weapon/sword/dragon_sword":3,
            "/obj/weapon/sword/silver_sword":3,
		]));	
else
        set("vendor_goods", ([
			"/obj/weapon/dagger.lpc":10,
			"/obj/weapon/spear/muqiang":10,
			"/obj/weapon/blade":10,
			"/obj/weapon/thin_sword":10,
	   	    "/obj/weapon/sixhammer":10,
			"/obj/weapon/shield":10,
			"/obj/weapon/hongyingqiang":10,
			"/obj/weapon/dart":10,
			"/obj/weapon/longsword":10,
			"/obj/weapon/spear":20,
			"/obj/weapon/whip":10,
	        ]) );

        add_action("do_vendor_list", "list");


}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) ) {
                case 0:
                        say( "兵器贩子道：这位"
                                + RANK_D->query_respect(ob)
                                + "，自个儿挑一件称手的兵器吧\n");
                        break;
                case 1:
                        say( "兵器贩子突然间出了神，好象想起了他的往事\n");
                        break;
				case 2:
						say("兵器贩子突然神秘的说，我们这里可是有好武器卖的哟！！\n");
						break;
        }
}
