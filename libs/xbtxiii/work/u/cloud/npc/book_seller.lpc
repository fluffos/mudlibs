void create()
{
        set_name("书店伙计", ({ "seller" }) );
        set("gender", "男性" );
        set("age", 22);
        set("long", "卖书的是个年轻小伙子，面带微笑。\n");
        set("combat_exp", 100000);
        set("attitude", "friendly");
        set_skill("unarmed", 80);
        set_skill("dodge", 80);
/*

        set("inquiry", ([
                "书局" : "这是晚月庄的产业，小的代为经营。", 
		"货物" : "这当然是卖书啦！一看(list)不就知道了。还问＠！＃￥！￥！",
		"私货" : (: sell_me :),
		"黑货" : (: sell_me :),
		"藏私" : (: sell_me :),
	      ]) );
*/

        set("vendor_goods", ([
"/obj/book/parry_book1":10,
 "/obj/book/l_book1":10,
 "/obj/book/l_book2":10,
 "/obj/book/l_book3":10,
"/obj/book/magic_book1":10,
"/obj/book/magic_book2":10,
"/obj/book/spells_book1":10,
"/obj/book/spells_book2":10,
	]) );

//        set("where","north");
        setup();
        add_money("gold", 1);
        add_money("coin", 300);
        carry_object("/obj/cloth")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");

}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) ) {
                case 0:
                        say( "书店伙计笑脸相迎，道：这位"
                                + RANK_D->query_respect(ob)
                                + "，要买什么？\n");
                        break;
                case 1:
                        say( "书店伙计正忙着整理书架\n");
                        break;
        }
}

