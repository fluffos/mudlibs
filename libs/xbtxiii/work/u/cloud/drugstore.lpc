#pragma save_binary
// drugstore.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create() {
  add_light(this_object(), 1);
  set("coor", ({ 2100, 3920, 0 }));
  set("short", "药店");
  set("long",
    "你现在正站在药店里靠近门口的地方有一块乌木雕成的招牌(sig\n"
    "n)。\n"
  );
  set("exits", ([
    "south": "/u/cloud/nroad1" ]));

  set("objects", ([
    "/u/cloud/npc/doctor": 1,
  ]));

  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  setup();

}

string look_sign(object me) {
  return "招牌写著：药。\n";
}
