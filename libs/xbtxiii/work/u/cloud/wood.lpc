// Room: /u/cloud/wood.c

inherit ROOM;
int do_cut(string arg);

int i;
void create()
{
        set("short", "西山树林");
        set("long",
"这里是西山树林。四周是参天古树，浓密的树叶盖住了天空。你\n"
"发现这里有许多人在砍柴，一捆捆的往家里背。咦！原来少林的\n"
"大和尚也在这里砍柴。\n"
);
        set("exits", ([ /* sizeof() == 1 */
            "eastdown" : __DIR__"nroad3",
            ]) );

        set("outdoors", "cloud");

        setup();
}

void init()
{
        add_action("do_cut","cut");
}

int do_cut(string arg)
{
     object me, ob;

     me = this_player();
     if ( !arg || ( arg != "wood" ) ) return notify_fail("你要砍什麽？\n");
     if((string)me->query("family/family_name") == "少林派")
      { if( !(present("steel fox", me)))
          return notify_fail("你用什么砍树？\n");
        if ((int)me->query("sen") < 30 || (int)me->query("gin") < 30
          || (int)me->query("kee") < 30)
        { me->unconcious();
          return 1;
        }        
        i=i+1;
        me->receive_damage("sen", 25);
        me->receive_damage("gin", 25);
        me->receive_damage("kee", 25);
        message_vision("$N吸了口气，举起斧头对一棵大树狠命的砍了下去。\n",me);
        if (i==1) return notify_fail("你感到双手发麻，虎口震裂。\n");
        if (i==2) return notify_fail("你感觉到砍进了一点，但还很浅。\n");
        if (i==3) return notify_fail("大树已开始摇晃了，你不由心中一喜。\n");
        if (i==4)
          { i=0;
            message_vision("哗！大树应声倒下，你已经满身大汗了\n",me);
            ob=new("/u/cloud/obj/chaihuo");
            ob->move("/u/cloud/wood");
            return notify_fail("你感到非常的疲倦，要休息一会了。\n"); 
          }
        return 1;
      }
     return 1;
}
