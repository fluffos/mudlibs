#pragma save_binary
// Room: /u/cloud/sunhill/northriver.c

inherit ROOM;

void cross_river(string arg);
void no_boat();

void create()
{
        set("short", "泓水北侧");
        set("long", @LONG
这里已靠近北岸，江水齐胸深，偶尔一个湍流卷过来，仿佛要将人
打入江底似的。
LONG
        );
        /*set("exits", ([  
  "north" : "/u/cloud/dukou",
  "south" : __DIR__"midriver",
]));*/
        set("outdoors", "cloud");

        setup();
        replace_program(ROOM);
}

void init()
{
        add_action("cross_river","cross");
}

void cross_river(string arg)
{
        if(!arg || arg ="") return 0;
        if(arg == "river") { 
          if( this_object()->query("marks/船夫") ) {
                set("exits/south", __DIR__"sunhill/midriver");
                call_out("no_boat", 5);
          }
        }
        else return 0; 
}

void no_boat()
{
        if( !query("exits/south") ) return;
        message("vision","小船驶向江南。\n", this_object() );
        delete("exits/south");
	this_object()->set("marks/船夫", 0);
}

