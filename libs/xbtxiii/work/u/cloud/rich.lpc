#pragma save_binary
// rich.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
        set("coor",({2250,3860,0}));
	set("short", "张百万家前厅");
	set("long",
"你现在正站在张百万家里靠近门口的地方有一块乌木雕成的招牌\n"
"(sign)。\n"
);
        set("exits", ([
                "south"          : "/u/cloud/eroad3", 

                 "north" :"/u/cloud/rich1",
                ]));
        set("outdoors","cloud");
        set("objects", ([
                 "/u/cloud/npc/room_waiter":2,
                 ]) );
        set("item_desc", ([
                "sign": (: look_sign :),
        ]) );

        setup();

}

string look_sign(object me)
{
        return "招牌写著：非请莫入。\n";
}

