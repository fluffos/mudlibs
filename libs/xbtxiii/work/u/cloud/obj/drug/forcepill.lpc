//keepill.c

inherit COMBINED_ITEM;

void create() {
  set_name("for丸", ({ "keepill" }));
  set("long",
    "这是一颗用来提气的回气丸，只要用一颗就可以\n"
    "提气20(eatpill keepill)！\n");
  set("value", 1000);
  set("unit", "颗");
  set("base_unit", "粒");
  set("base_weight", 1);
  set_amount(1);
}

void init() {
  if (this_player() == environment())
    add_action("do_eatpill", "eatpill");
  add_action("do_eatpill", "ep");
}

int do_eatpill(string arg) {
  //   object ob;


  //   if( !arg ) return notify_fail("你要用化尸粉溶解什麽东西？\n");
  //    if( !objectp(ob = present(arg, environment(this_player()))) )
  //            return notify_fail("这里没有这样东西。\n");
  //    if( living(ob) || !ob->id("corpse") )
  //            return notify_fail("化尸粉只能用来溶解尸体。\n");

  this_player()->add("max_force", 20);
  message_vision(
    "$N吃下一颗回气丸，气色好多了.\n", this_player());
  add_amount(-1);
  return 1;
}
