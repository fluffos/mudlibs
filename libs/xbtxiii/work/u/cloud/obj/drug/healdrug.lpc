//healdrug.c

inherit COMBINED_ITEM;

void create()
{
        set_name("金创药",({"healdrug"}));
        set("long",
                "这是一颗用来治疗跌打损伤的金创药，只要用一贴就可以\n"
                "提气40(apply),江湖中人常用它治伤 \n");
        set("value", 3000);
        set("unit", "颗");
        set("base_unit", "粒");
        set("base_weight", 1);
        set_amount(1);
}

void init()
{
        if( this_player()==environment() )
                add_action("do_apply", "apply");
		
}

int do_apply()
{
     //   object ob;


    //   if( !arg ) return notify_fail("你要用化尸粉溶解什麽东西？\n");
    //    if( !objectp(ob = present(arg, environment(this_player()))) )
    //            return notify_fail("这里没有这样东西。\n");
    //    if( living(ob) || !ob->id("corpse") )
    //            return notify_fail("化尸粉只能用来溶解尸体。\n");
    	this_player()->receive_curing("kee",40);
	
	    message_vision(
                "$N给自己敷上一剂金创药，气色好多了.\n",this_player());
        add_amount(-1);
        return 1;
}


