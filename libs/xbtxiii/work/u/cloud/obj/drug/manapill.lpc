//keepill.c

inherit COMBINED_ITEM;

void create()
{
        set_name("回转六神丸",({"senpill"}));
        set("long",
                "这是一颗用来提神的六神丸，只要用一颗就可以\n"
                "提20 神(bitepill senpill)！\n");
        set("value", 3000);
        set("unit", "颗");
        set("base_unit", "粒");
        set("base_weight", 1);
        set_amount(1);
}

void init()
{
        if( this_player()==environment() )
                add_action("do_bitepill", "bitepill");
		add_action("do_eatpill", "ep");
}

int do_bitepill(string arg, object me)
{
     //   object ob;


    //   if( !arg ) return notify_fail("你要用化尸粉溶解什麽东西？\n");
    //    if( !objectp(ob = present(arg, environment(this_player()))) )
    //            return notify_fail("这里没有这样东西。\n");
    //    if( living(ob) || !ob->id("corpse") )
    //            return notify_fail("化尸粉只能用来溶解尸体。\n");

me = this_player();
                //add busy checking here.   - sophos
                if( me->is_busy() )
                        return notify_fail("你想噎死呀，吃这么快！\n");
                me->start_busy(1);

       // this_player()->add("max_mana",20);
	this_player()->receive_heal("sen",20);	
	    message_vision(
                "$N吃下一颗六神丸，气色好多了.\n",this_player());
        add_amount(-1);
        return 1;
}

