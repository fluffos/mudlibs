//keepill.c
//sophos
//  add busy state for 1 sec when eeatpill.		1996-11-28
//  change price of keepill(5 to 20 gold);and modify the mistake of
//  addkee value.

inherit COMBINED_ITEM;

void create()
{
        set_name("回气丸",({"keepill"}));
        set("long",
                "这是一颗用来提气的回气丸，只要用一颗就可以\n"
                "提气20(eatpill keepill)！\n");
        set("value", 7500);
        set("unit", "颗");
        set("base_unit", "粒");
        set("base_weight", 1);
        set_amount(1);
}

void init()
{
        if( this_player()==environment() )
                add_action("do_eatpill", "eatpill");
		add_action("do_eatpill", "ep");
}

int do_eatpill()
{
	object	me;

	me = this_player();
		//add busy checking here.   - sophos
		if( me->is_busy() )
			return notify_fail("你想噎死呀，吃这么快！\n");
		me->start_busy(1);

    	this_player()->receive_heal("kee",20);
	
	    message_vision(
                "$N吃下一颗回气丸，气色好多了.\n",this_player());
        add_amount(-1);
        return 1;
}

