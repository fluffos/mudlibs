#pragma save_binary
// rich.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
        add_light(this_object(),1);
	set("coor",({2250,3870,0}));
	set("short", "张百万家正厅");
	set("long",
"你现在正站在张百万家正厅里靠近门口的地方有一块乌木雕成的\n"
"招牌(sign)。\n"
);
        set("exits", ([/* sizeof()== 2 */
              "south" : "/u/cloud/rich", 
                 "north" :"/u/cloud/rich2",
                ]) );

        set("objects", ([
                 "/u/cloud/npc/dashou":2,
                "/u/cloud/npc/dashou_head":1,  
                ]) );
        set("item_desc", ([
                "sign": (: look_sign :),
        ]) );

        setup();

}

string look_sign(object me)
{
        return "招牌写著：非请莫入。\n";
}

