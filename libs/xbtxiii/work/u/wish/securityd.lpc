#include <login.h>

mapping wiz_status = ([]);  //

string *wiz_levels = ({
  "(player)",
  "(immortal)",
  "(genie)",
  "(apprentice)",
  "(wizard)",
  "(angel)",
  "(arch)",
  "(sage)",
  "(admin)",
  "(boss)"
});

// A valid write attempt must pass 2 checks: your uid or status must not be
// "excluded" and must be "trusted" on that directory in order to write in 
// that directory. The directories containing the file is searched backward
// from the current directory to root. And exclude is checked prior than
// trusted.

mapping trusted_write = ([
  "/": ({ "Root", "(boss)", "(admin)" }),
  "log": ({ "(boss)" }),
  "data": ({ "(boss)" }),
  "cmds": ({ "(admin)" }),
  "adm": ({ "(admin)" }),
  "feature": ({ "(admin)" }),
  "u": ({ "(admin)", "(sage)", "(arch)", "(angel)", "(wizard)", "(apprentice)", "(genie)" }),
  "include": ({ "(sage)" }),
  "inherit": ({ "(sage)" }),
  "tmp": ({ "(arch)", "(sage)" }),
  "www": ({ "(arch)", "(sage)" }),
  "d": ({ "(arch)", "(sage)" }),
  "kungfu": ({ "(arch)", "(sage)" }),
  "hate": ({ "(angel)", "(arch)", "(sage)" }),
  "maxim": ({ "(angel)", "(arch)", "(sage)" }),
  "clone": ({ "(arch)", "(sage)" }),
  "cmds": ({ "(admin)" }),
  "obj": ({ "(arch)", "(sage)" }),
  "quest": ({ "(arch)", "(sage)" }),
  "task": ({ "(arch)", "(sage)" }),
  "doc": ({ "(genie)", "(apprentice)", "(wizard)", "(angel)", "(arch)", "(sage)" }),
  "hate": ({ "(wizard)", "(angel)", "(arch)", "(sage)" }),
]);

mapping exclude_write = ([
  "adm": ({ "(sage)" }),
  "data": ({ "(admin)" }),
  "log": ({ "(admin)" }),
]);
/*
已完成的设置：
A.综合写权限：
(限制向下逐级减少)
immortal无任何写权限！
apprentice,angel,wizard可以写自己的目录
arch可以写自己的目录，/d,/kungfu和/clone
sage可以写除/adm,/log,/data以外的所有目录
admin可以写除/log,/data以外的所有目录(这个暂时不限制)
B.综合读权限：
(限制向下逐级增加)
admin,sage,arch可以读所有目录(arch不能读/adm, /www)
wizard可以读/inherit,/include
angel可以读/d,/clone,/kungfu
apprentice只可以读/d
c.其余补充：
除了admin和sage，对于/u下的目录和文件，每个人只能读写自己的目录。
d.未完成的设想：
对/cmds也根据权限给予相对的read权限(类似于/u)
对ftpd的可读及可写权限也要做些相应改进
*/
mapping trusted_read = ([
  "/": ({
    "Root",
    "(boss)",
    "(admin)",
    "(sage)",
    "(arch)",
    "(angel)",
    "(wizard)",
    "(apprentice)",
    "(genie)"
  }),
  //意味这几个可以读/下所有没有被exclude_read包含的目录！
  "adm": ({ "(admin)" }),
  "feature": ({ "(arch)" }),
  "task": ({ "(arch)" }),
  "inherit": ({ "(arch)" }),
  "www": ({ "(arch)" }),
  "include": ({ "(arch)" }),
  "data": ({ "(sage)" }),
  "data/npc/boss": ({ "(player)" }),
  "hate": ({ "(wizard)" }),
  "quest": ({ "(arch)" }),
  "quest/poem": ({ "(player)" }),
  "maxim": ({ "(wizard)" }),
  "obj": ({ "(wizard)" }),
  "log": ({ "(arch)" }),
  "cmds": ({ "(sage)", "(arch)", "(wizard)", "(apprentice)", "(genie)" }),
  "cmds/adm": ({ "(admin)" }),
  "cmds/arch": ({ "(sage)", "(arch)" }),
  "cmds/ang": ({ "(sage)" }),
  "cmds/wiz": ({ "(wizard)" }),
  "cmds/app": ({ "(wizard)", "(apprentice)" }),
  "cmds/gen": ({ "(genie)" }),
  "cmds/imm": ({ "(wizard)", "(apprentice)" }),
  "adm/etc/wizlist": ({ "(player)" }),
  "doc/help": ({ "(player)" }),
  "d": ({ "(wizard)", "(player)", "City" }),  //Domain的字母必须有大写字母
  //"domain"为/d,/clone,/kungfu下的object的euid!
  "kungfu": ({ "(wizard)", "(player)", "Mudos" }),
  "kungfu/skill": ({ "(player)" }),  //不加也不会错，但是会有很多skill文件读失败
  "clone": ({ "(wizard)", "(angel)", "(player)", "Mudos" }),
  "adm/etc/wizlist": ({ "(player)" }),
  "data/ladder.txt": ({ "(player)" }),
  "doc": ({ "(player)" }),
  //因为每次update这个文件时，自己的权限被设为(player),所以设置为player可读。
]);

