	if(user->query("id")!="guest")
	  {
	   id_num=read_file("/data/system/iduser",1);
	   id_temp=atoi(id_num); id_temp=id_temp+1;
	   id_num=sprintf("%d",id_temp);
	   write_file("/data/system/iduser",id_num,1);
	   write("\n");
	   }
*/
}

object make_body(object ob)
{
	string err;
	object user,pre_obj;
    pre_obj=previous_object(0);
	if(pre_obj)
	{
            if(geteuid(pre_obj)!=ROOT_UID&&wizhood(pre_obj)!="admin" ) return 0;
	}
	

	if(stringp(ob->query("body"))) user = new(ob->query("body"));
	  else  user = new("/obj/user");
	if(!user) {
		write("现在可能有人正在修改使用者物件的程式，无法进行复制。\n");
		write(err+"\n");
		return 0;
	}
	seteuid(ob->query("id"));
	export_uid(user);
	export_uid(ob);
	seteuid(getuid());
	user->set("id", ob->query("id"));
	user->set_name( ob->query("name"), ({ ob->query("id")}) );
	return user;
}

protected int init_new_player(object user)
{
	user->set("title", "普通百姓");
	user->set("birthday", time() );
	user->set("potential", 200);
	user->set("combat_exp", 500);
	if(user->query("gender")=="男性") user->set("star_point",5);
	else user->set("star_point",5);
	if(user->query("gender")=="女性"){
	    user->set("combat_exp",800);
	    user->set("potential",200);
	}

	user->set("food", 2000);
	user->set("water", 2000);
	user->set_temp("light",1); // 新玩家视物不受影响
    user->set("channels", ({ "chat","rumor","shout","song" }) );
}

varargs void enter_world(object ob, object user, int silent)
{
	object silver,mailbox;
	string startroom,msg,*wrong_pass_ip;
	int i,j,ipcount,guest_count;
	object *usr,pre_obj;
    pre_obj=previous_object(0);
	if(pre_obj)
	{
            //tell_object(find_player("rongg"),wizhood(pre_obj)+pre_obj->query("id")+"\n");
            if(geteuid(pre_obj)!=ROOT_UID&&wizhood(pre_obj)!="admin" ) return ;
	}
	
	user->set_temp("link_ob", ob);
	ob->set_temp("body_ob", user);
	if(ob->query_temp("is_Big5")) user->set_temp("is_Big5",1);
	exec(user, ob);

	write("目前权限：" + wizhood(user) + "\n");
	user->setup();

	// In case of new player, we save them here right aftre setup 
	// compeleted.
	user->save();
	ob->save();


	ipcount = 0;
	usr = users();

	//禁止巫师学徒利和经验大于1000万的玩家从BBSNET登录,防止有巫师同时拥有玩家id和不遵守巫师手则	
	/*	for (i=0;i<sizeof(usr);i++) {
		    if ((query_ip_number(usr[i])==ADM_IP)&&(usr[i]->query("combat_exp")>=10000000)&&!wizardp(usr[i])) 
	    	 {
		  	write("雄霸天下II禁止千万高手利用BBSNET登录!请按任意键退出。\n");	   
		  	destruct(user);
		  	destruct(ob);
		  	return;	       
	     	}
		}	*/
	// by alvins 2000-12-21
	for (j=0;j<sizeof(usr);j++)
	{
    	if (wiz_level(usr[j]) >= wiz_level("(apprentice)")               
            &&query_ip_number(usr[j])==ADM_IP) 
	    {
			write("雄霸天下II禁止巫师利用BBSNET登录!请按任意键退出。\n");
		  	destruct(user);
		  	destruct(ob);
		  	return;	       
	     }
	}
	
	
	for (i=0;i<sizeof(usr);i++)
	{
//	    if( member_array(query_ip_number(ob), public_ip)==-1 ) continue;
		if ( query_ip_number(user)==query_ip_number(usr[i]) )
		{
	    	if(!wizardp(user)&&!wizardp(usr[i]))
				ipcount++;
	       	if (ipcount>=7&&( member_array(query_ip_number(ob), public_ip)==-1 ))
	       	{ 
		  		write("『雄霸天下III』禁止利用同一IP地址登录超过六个ID!\n");
		  		destruct(user);
		  		destruct(ob);
		  		return;
			}
        	if (ipcount>=10&&query_ip_number(ob)=="210.39.3.50") 
        	{
		  		write("『雄霸天下III』禁止用同一公共IP地址登录超过10个ID!\n");
		  		destruct(user);
				destruct(ob);
		  		return;
	    	} 
	 	}
	}

	for (i=0;i<sizeof(usr);i++)
	{
		if (usr[i]->query("id")=="guest")
		{
	    	guest_count++;
	       	if (guest_count>=7)
	       	{
		  		write("『雄霸天下III』禁止六个以上Guest同时在线!\n");
		  		destruct(user);
		  		destruct(ob);
		  		return;
	       	}
	    }
	}

	if(user->query("MY_ONLY_IP")&&ip_check&&
	   (string)query_ip_number(user)!=(string)user->query("MY_ONLY_IP"))
	{
		write("对不起，您的IP地址和设定的IP不一样，系统拒绝进入。\n请和天神联系解决。\n");
		wrong_pass_ip=ob->query("wrong_pass");
	    if(!wrong_pass_ip) wrong_pass_ip=({});
		wrong_pass_ip+=({"密码被IP"+query_ip_number(user)+"成功窃取"});
		ob->set("wrong_pass",wrong_pass_ip);
		ob->save();
		destruct(user);
		destruct(ob);
		return;
	}

	if( !silent )
	{
		write(read_file(MOTD));
		if( ob->query("new_mail") ) 
		{
            write( FLASH+GRN + "\n有人给你写信了看一下信箱吧...\n\n" + NOR);
			ob->set("new_mail", 0);
		}
        if(user->query("learned_points")<0) user->set("learned_points",0);
        if(user->query("potential")<0) user->set("potential",0);
        if((user->query("potential")-user->query("learned_points"))<0)
        	user->set("learned_points",user->query("potential"));
        if((user->query("potential")-user->query("learned_points"))>1000000)
        {
        	user->set("potential",(user->query("learned_points")+1000000));
            user->set("startroom","/d/wiz/polockroom.lpc");
        }
	//以上关于潜能限制由tiandi制作，防止负潜能的问题。00.12.15

        if(((user->query("combat_exp")/2+user->query("mud_age")) <= user->query("learned_points"))&&
           (user->query("combat_exp")>4000000)&&!wizardp(user))
        {
        	tell_object(user,HIR"【系统】你身上的数据被系统鉴别为非法数据。你被系统拒绝登陆。\n"NOR);
        	destruct(user);
		   	destruct(ob);
		   	return;
        }

		if( user->is_ghost() )
			startroom = DEATH_ROOM;
		else if( !stringp(startroom = user->query("startroom")) )
		{
			startroom = START_ROOM;
			user->set("startroom", YANGZHOU);
	    }

		if( !catch(load_object(startroom)) )
			user->move(startroom);
		else
		{
			user->move(START_ROOM);
			startroom = START_ROOM;
			user->set("startroom", YANGZHOU);
		}
/*
// 计算玩家登陆次数。
                user_count=user->query("login_count");
                tell_object(user,HIB"【系统】"CYN"欢迎光临,这是您第"+chinese_number(user_count)+"次光临雄霸天下Ⅱ。\n"NOR);
		user_count++;
		user->set("login_count",user_count);
*/
// 玩家排行榜
        if(!wizardp(user))
        	TOPTEN_D->topten_checkplayer(user);

		tell_room(startroom, user->query("name") + "连线进入这个世界。\n",({user}));
                if(file_size("/log/notice")>0){
                        write(CYN"     ≡≡≡≡≡≡≡≡≡≡≡≡"HIR"雄霸天下 III连线通知"NOR CYN"≡≡≡≡≡≡≡≡≡≡≡≡\n");
                        write("     "+read_file("/log/notice"));
                        write(CYN"     ≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡\n"NOR);        }
		for(i=0;i<sizeof(usr);i++)
		{
			if(member_array(usr[i]->query("id"),user->query("My_Friend")?user->query("My_Friend"):({}))!=-1)
			{
				if(!wizardp(usr[i]))			
				{
			 		tell_object(usr[i],HIB"【系统】"CYN"你的好友"+user->name()+" "+user->query("id")+"已经上站了!\n"NOR);
				   	tell_object(user,HIB"【系统】"CYN"你的好友"+usr[i]->name()+" "+usr[i]->query("id")+"已经在站上了！\n"NOR);
				}
			}
			else
				continue;
		}
	}
    if (wiz_level(user) != wiz_level("(admin)")) 	
		CHANNEL_D->do_channel( this_object(), "sys",
			sprintf("%s(%s)由%s连线进入。", user->name(), user->query("id"),query_ip_name(user)) );
	mailbox=new("/obj/mailbox"); //信箱
	if(mailbox)
		mailbox->move(user);
	if( member_array(user->query("name"), chinese_names)==-1 &&user->query("id")!="guest") 
	{
		chinese_names+=({user->query("name")});
		write_file("/data/chinese_names",(string)user->query("name")+"\n");
	}

    if(user->query("mud_age")<=0&&user->query("id")!="guest")
    {
		silver=new(SILVER_OB);
		silver->set_amount(20);
		silver->move(user);
	}
	if(user->query("mud_age")<=10800)
	{
	    silver=new("/obj/scroll");//瞬间移动卷轴
	    if(silver) silver->move(user);
	}
/*
        if(user->query("potential")>=300000&&!wizardp(user)) {
	   write("很抱歉，你身上的有不正常数据!请联系巫师解决。\n");	   
           user->move("/open/alvins/lockroom");  
	}

*/
	if(user->query("mud_age")<=21600) // 6小时
	{
		add_light(user,1); 
		call_out("watch_news",20,user->query("id"));
	} // 新玩家视物不受影响,同时强制多注意help文件 
	UPDATE_D->check_user(user);
	if(ob->query("last_from"))
	    tell_object(user,HIC"\n上次您从"+ob->query("last_from")+"连线进入。请您确认。\n"NOR);
	if(ob->query("wrong_pass"))
	{
	    wrong_pass_ip=ob->query("wrong_pass");
	    if(wrong_pass_ip==({}) ) return;
	    msg="";
	    for(i=0;i<sizeof(wrong_pass_ip);i++)
	    {
	        msg+=wrong_pass_ip[i]+"\n";
	    }
	    msg="您的id上次连线的时候曾经在下面的ip输入了错误的密码请您确认是否有人想盗用您的id\n"
	        +HBRED+msg+NOR;
	    tell_object(user,msg);
	    ob->set("wrong_pass",({}));
	}
	//if(stringp(user->query("id")))
	//    call_out("watch_news",10,user->query("id"));
	if( user->query("family/family_name")=="朝廷" &&
            (time() - user->query("guanfu/last_alert_time") >= 900 ||
             time() - user->query("guanfu/last_alert_time") <= 0 ))
    {
    	user->set("guanfu/can_alert",15);
        write("您的大内高手来保护你了！！\n");
    }	
	return ;
}

int watch_news(string id)
{
        object me;
        me=find_player(id);
        if(me&&environment(me))
        {
	    	"/cmds/usr/help"->main(me);//看看最新改动吧            
            return 1;
        }
        else return 1;
        return 1;
}
varargs void reconnect(object ob, object user, int silent)
{
	object room;
    object pre_obj;
    pre_obj=previous_object(0);
    if(pre_obj&&geteuid(pre_obj)!=ROOT_UID) return ;
	user->set_temp("link_ob", ob);
	ob->set_temp("body_ob", user);
	if(ob->query_temp("is_Big5")) { user->set_temp("is_Big5",1); }
	else user->delete_temp("is_Big5");
	if(!environment(user)) //看bbs的时候断线重连会没有环境
	   {
 	   user->enable_player();
	   enter_world(ob, user);
	   return ;
 	   }

	exec(user, ob);
	user->reconnect();
	
	if( !silent ) {
		tell_room(environment(user), user->query("name") + 
"重新连线回到这个世界。\n",
		({user}));
	}

	CHANNEL_D->do_channel( this_object(), "sys",
		sprintf("%s(%s)由%s重新连线进入。", user->query("name"), user->query("id"),
query_ip_name(user)) );
	user->enable_player();
	UPDATE_D->check_user(user);
	if(ob->query("last_from"))
	    tell_object(user,HIC"\n上次您从"+ob->query("last_from")+"连线进入。请您确认。\n"NOR);
        if(!user->is_fighting()){
            if(environment(user)){
        	room=environment(user);
        	if(room->init()){
        	    user->move(room);//为了解决断线之后add_action()失效的问题只好暂时这个样子.
                    return ;
                }
            }
        }
}

int check_legal_id(string id)
{
	int i;

	i = strlen(id);
	
	if( (strlen(id) < 3) || (strlen(id) > 10 ) ) {
		write("『雄霸天下III』对不起，你的英文名字必须是 3 到 10 个英文字母。\n");
		return 0;
	}
	while(i--)
		if( id[i]<'a' || id[i]>'z' ) {
			write("『雄霸天下III』对不起，你的英文名字只能用英文字母。\n");
			return 0;
		}

	return 1;
}

int check_legal_name(string name)
{
	int i;

	i = strlen(name);
	
	if( (strlen(name) < 2) || (strlen(name) > 12 ) ) {
		write("对不起，你的中文名字必须是 1 到 6 个中文字。\n");
		return 0;
	}
	while(i--) {
		if( name[i]<=' ' ) {
			write("对不起，你的中文名字不能用控制字元。\n");
			return 0;
		}
		if( i%2==0 && !is_chinese(name[i..<0]) ) {
			write("对不起，请您用「中文」取名字。\n");
			return 0;
		}
	}
	if( member_array(name, banned_name)!=-1 ) {
		write("对不起，这种名字会造成其他人的困扰。\n");
		return 0;
	}

	if( member_array(name, chinese_names)!=-1 ) {
		write("对不起，已经有人使用了这个中文名。\n");
		return 0;
	}
	return 1;
}

object find_body(string name)
{
	object ob, *body;

	if( objectp(ob = find_player(name)) )
		return ob;
	body = children(USER_OB);
	for(int i=0; i<sizeof(body); i++) {
	  ob=body[i];
	  if( clonep(ob) && getuid(ob) == name 
	    && ob->query("max_gin")>0 ) return ob;
	    //check max_gin to avoid damaged user object.
	}

	return 0;
}

int set_wizlock(int level)
{
	if( wiz_level(this_player(1)) <= level )
		return 0;
	if( geteuid(previous_object()) != ROOT_UID )
		return 0;
	wiz_lock_level = level;
	return 1;
}
void delete_temp_banned_site(string site)
{
    temp_banned_site-=({site});
}
void add_baneid(string id)
{
    banned_id+=({id});
}
void del_baneid(string id)
{
    banned_id-=({id});
}
void bane_site(string site)
{
    banned_site +=({site});
}
void unbane_site(string site)
{
    banned_site -=({site});
}
int query_max_player()
{
    return max_player;
}
void delete_chinese_name(string name)
{
	chinese_names-=({name});
}
int set_ip_check(int d)
{
    ip_check=d;
    return d;
}
