protected void choice_gift(string kind,string gender,mapping my)
{
	int i;
	string aph;
	aph="abcdefghijklmnopqrstuvwxyz";
	i=sizeof(aph);
	while(i--)
	   if(kind[0]==aph[i])break;
	my["spi"] = spi[i];
	my["kar"] = kar[i];
	my["con"] = con[i];
	my["cor"] = cor[i];
	my["str"] = str[i];
	my["per"] = per[i];
	my["int"]=intel[i];
	my["cps"] = cps[i];
}
void create() 
{
	string file;
	seteuid(getuid());
	set("channel_id", "连线精灵");
	if(file_size("/data/chinese_names")<1) return;
	file = read_file("/data/chinese_names");
	chinese_names = explode(file,"\n"); 

	if(file_size("/data/public_ip.data")<1) return;
	file = read_file("/data/public_ip.data");
	public_ip = explode(file,"\n"); 


}

void logon(object ob)
{
	object *usr;
	int i, wiz_cnt, ppl_cnt, login_cnt,user_num,ip_cnt;
	string ip;
//	string file_name_user;
	mixed file;
	
	usr = users();
	wiz_cnt = 0;
	if(max_player<sizeof(usr))max_player++;
	ppl_cnt = 0;
	login_cnt = 0;
	ip_cnt = 0;
	ip=query_ip_number(ob);
	for(i=0; i<sizeof(usr); i++) 
	{
		if( !environment(usr[i]) ) login_cnt++;
		else if( wizardp(usr[i])&&!usr[i]->query("no_shown") ) wiz_cnt++;
	    else 
	    {
	    	if(query_ip_number(usr[i])==ip) ip_cnt++;//相同ip累加
	    	ppl_cnt++;
	    }
	}

	cat(WELCOME);
        write(sprintf(HIC"         来自 %s 的朋友，您的地址目前共有 %d 个玩家在线。\n"NOR,query_ip_number(ob),ip_cnt ));
	write(sprintf("─────────────────────────────────────\n"));
        UPTIME_CMD->main();

//统计上站人次
//不用专门做个users和iduser的文件，这样做不好，经常要对硬盘进行写操作
//	user_num=read_file("/data/system/users",1);
//	i_user=atoi(user_num);
//	i=
//	printf("自二零零零年元月二十一起，"+MUD_NAME+"共有%s人次来访。\n",chinese_number(i_user)); 
//	i_user=i_user+1; 
//	user_num=sprintf("%d", i_user); 
//	write_file("/data/system/users",user_num,1);
//	user_num=read_file("/data/system/iduser",1);
//	i_user=atoi(user_num);
//	printf(MUD_NAME+"目前共有%s个注册玩家。\n",chinese_number(i_user)); 

//用下面的方法比较好./obj/login#1046832,其实下面的东西没有什么必要.
//	file_name_user=file_name(ob);
//但是好象有些问题，file_name()本身记数恐怕有点问题
//	i=sizeof(file_name_user);
//	printf("自二零零零年元月二十一起，"+MUD_NAME+"共有"+file_name_user[11..i]+"人次来访。\n",); 
//	vister=__DIR__"vister.lpc"->add_up();								   // /obj/login#
//	printf("自上次REBOOT起，"+MUD_NAME+"共有"+chinese_number(vister)+"人次来访。\n",); 
	user_num=0;
	//for(a---z)
	for(i=97;i<122;i++){
		file=get_dir("/data/login/"+sprintf("%c",i)+"/",-1);
		user_num+=sizeof(file);
		
	}
	printf("『"MUD_NAME"』" + "目前共有%s个注册玩家。\n",chinese_number(user_num)); 

	printf("『"MUD_NAME"』" + "目前共有 %d 位巫师、%d 位玩家在线上，以及 %d 位使用者尝试连线中。\n",
		wiz_cnt, ppl_cnt, login_cnt);

	if( member_array(query_ip_number(ob), banned_site)!=-1 ) {
		write("『雄霸天下III』对不起，你的IP地址被这个MUD禁止访问一段时间。\n请和天神联系解决。\n");
		destruct(ob);
		return ;
	}
	if( member_array(query_ip_number(ob), temp_banned_site)!=-1 ) {
                write("『雄霸天下III』由于您上次密码输入错误。请稍候再连线进入。\n");
		destruct(ob);
		return ;
	}
	write("『雄霸天下III』您的英文名字[游客请使用"HIR"Guest"NOR"进入]:");
	//if(!ob->query_temp("is_Big5")) write("\n狦ㄏノ琌BIG5絏叫块big5\n");
	input_to( (: get_id :), ob );
}

protected void get_id(string arg, object ob)
{


	arg = lower_case(arg);
	if(arg=="big5"){
		ob->set_temp("is_Big5",1);
		logon(ob);
		return;
	}
	
	if( !check_legal_id(arg)) {
		write("『雄霸天下III』您的英文名字[游客请使用"HIR"Guest"NOR"进入]:");
		input_to("get_id", ob);
		return;
	}

	if( member_array(arg, banned_id)!=-1 ) {
		write("对不起，你的ID被这个MUD封存了。\n请和天神联系解决\n");
		destruct(ob);
		 return 0;
	}

	
	if( (string)ob->set("id", arg) != arg ) {
		write("Failed setting user name.\n");
		destruct(ob);
		return;
	}

	if( arg=="guest" ) {
		ob->set("name","匆匆过客");
		ob->set("gender","男性");
		get_email("guest@none.xbtx", ob);
		return;

	} else if( file_size(ob->query_save_file()+".o" ) >= 0 ) {
		if( ob->restore() ) {
                        if(ob->query("quit_time")<time()&&ob->query("quit_time")+10>time()){
                                write("『雄霸天下III』你刚刚离开游戏，请在十秒后连入。\n");
				destruct(ob);
				return;
			}
			write("『雄霸天下III』请您输入密码：");
			input_to("get_passwd", 1, ob);
			return;
		}
		write("您的人物储存挡出了一些问题，请利用 guest 人物通知巫师处理。\n");
		destruct(ob);
		return;
	}

	write("『雄霸天下III』使用 " + (string)ob->query("id") + " 这个名字将会创造一个新的人物，您确定吗(y/n)？");
	input_to("confirm_id", ob);
}

protected void get_passwd(string pass, object ob)
{
	string id,*wrong_pass;
	object user;
	object bbs;

	write("\n");
	id=ob->query("id");
	if(!PASSWORD_D->main(id,"check",pass)) {
	    ob->add_temp("wrong_password",1);
            wrong_pass=ob->query("wrong_pass");
	    if(!wrong_pass) wrong_pass=({});
	    wrong_pass+=({query_ip_number(ob)});
	    ob->set("wrong_pass",wrong_pass);
	    ob->save();
	    if(ob->query_temp("wrong_password")>=3){
		write("『雄霸天下III』三次都输入错误。对不起!系统怀疑您在盗窃密码！\n");
		temp_banned_site+=({query_ip_number(ob)});
		call_out("delete_temp_banned_site",10,query_ip_number(ob));
		destruct(ob);
		return;
	    }
	    else{ 
                write("恩...密码输入错误。这样吧.我再给你"+
	              chinese_number(3-ob->query_temp("wrong_password"))
	              +"次机会,请重新输入一次密码：\n");
	        input_to("get_passwd", 1, ob);
	        return ;
	    }
	}
	// Check if we are already playing.
	user = find_body(ob->query("id"));
	if (user) {
		if( user->query_temp("netdead") ) {
			reconnect(ob, user);
			return;
		}
		
write("『雄霸天下III』您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)");
		input_to("confirm_relogin", ob, user);
		return;
	}


	if( objectp(user = make_body(ob)) ) {
		if( user->restore() ) {
			if(wizhood(user)&&wizhood(user)!="(player)")//玩家的id从那里进来的我认为没有必要记录了.
			log_file( "USAGE", sprintf("%s(%s) loggined from %s (%s)\n", 
				user->query("name"),user->query("id"),
				query_ip_name(ob), ctime(time()) ) );
			if(time()-(int)user->query("kickout_time") < 3600)
			{
			write("你现在没有进入『雄霸天下III』的权利，请一小时后再联线。\n");
			destruct(user);
			destruct(ob);
			return;
			}
			if(objectp(bbs=new("/obj/bbs"))){
			  write(bbs->long());
			  destruct(bbs);
			  write(HIY"请按回车键继续..."NOR);
			  }
			input_to("read_message",ob, user);
			return;
		} else {
			destruct(user);
		}
	}
	write("『雄霸天下III』请您重新创造这个人物。\n");
	confirm_id("y", ob);
}
protected void read_message(string arg,object ob,object user)
{
	enter_world(ob,user);
}

protected void confirm_relogin(string yn, object ob, object user)
{
	object old_link;

	if( yn=="" ) {
		
write("『雄霸天下III』您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)");
		input_to("confirm_relogin", ob, user);
		return;
	}       

	if( yn[0]!='y' && yn[0]!='Y' ) {
		write("好吧，欢迎下次再来。\n");
		destruct(ob);
		return;
	} else {
		tell_object(user, "有人从别处( " + query_ip_number(ob)
			+ " )连线取代你所控制的人物。\n");
			if(wizhood(user)&&wizhood(user)!="(player)")//玩家的id从那里进来的我认为没有必要记录了.
		log_file( "USAGE", sprintf("%s replaced by %s (%s)\n", 
user->query("name"),
			query_ip_name(ob), ctime(time()) ) );
	}

	// Kick out tho old player.
	old_link = user->query_temp("link_ob");
	if( old_link ) {
		exec(old_link, user);
		destruct(old_link);
	}

	reconnect(ob, user);    
}

protected void confirm_id(string yn, object ob)
{
	if( yn=="" ) {
		write("『雄霸天下III』使用这个名字将会创造一个新的人物，您确定吗(y/n)？");
		input_to("confirm_id", ob);
		return;
	}       

	if( yn[0]!='y' && yn[0]!='Y' ) {
		write("『雄霸天下III』好吧，那麽请重新输入您的英文名字：");
		input_to("get_id", ob);
		return;
	}

	write( @TEXT

请您想一个有气质，有个性，又不会太奇怪的中文名字，特别要提醒您
的是，本 mud 是一个以古中国与东方为背景的世界 ，请不要取一些不
雅或是容易造成他人困扰的名字，例如希特勒(hitler)类似的名字。
如果天神认为你的名字不雅，有权改变他或者杀档。
  ^^^^^^^^^^
(除了名字之外，本 mud 有许多取绰号、别称的设计，所以郑重建议您
 
 ★取一个比较像名字的中文名字★。)
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
请注意：切不可在名字中出现符号空格之类的东西。否则必严惩。
        还有范指的名称、NPC的名称和物件的名称也是不允许的
        (例如：他们，某人等)。

TEXT
	);
	write("您的中文名字：");
	input_to("get_name", ob);
}

protected void get_name(string arg, object ob)
{
	if(ob->query_temp("is_Big5")) arg=LANGUAGE_D->Big52GB(arg);
	if( !check_legal_name(arg) ) {
		write("您的中文名字：");
		input_to("get_name", ob);
		return;
	}

	printf("%O\n", ob);
	ob->set("name", arg);
	write("请设定您的密码：");
	input_to("new_password", 1, ob);
	return ;
}

protected void new_password(string pass, object ob)
{

	write("\n");
	if( strlen(pass)<5 ) {
		write("密码的长度至少要五个字元，请重设您的密码：");
		input_to("new_password", 1, ob);
		return;
	}
	write("请再输入一次您的密码，以确认您没记错：");
	input_to("confirm_password", 1, ob,pass);
}

protected void confirm_password(string pass, object ob,string old_pass)
{

	string id;
	write("\n");

	if(pass!=old_pass) {
		write("您两次输入的密码并不一样，请重新设定一次密码：");
		input_to("new_password", 1, ob);
		return;
	}

	id=ob->query("id");
	PASSWORD_D->main(id,"add",pass);
	write("您要扮演男性(m)的角色或女性(f)的角色？");
	input_to("get_gender", ob);
}

protected void get_gender(string gender, object ob)
{
	if( gender=="" ) {
		write("您要扮演男性(m)的角色或女性(f)的角色？");
		input_to("get_gender", ob);
		return;
	}

	if( gender[0]=='m' || gender[0]=='M' )
		ob->set("gender", "男性");
	else if( gender[0]=='f' || gender[0]=='F' )
		ob->set("gender", "女性" );
	else {
		write("对不起，您只能选择男性(m)或女性(f)的角色：");
		input_to("get_gender", ob);
		return;
	}

    write(HIR"注意：1.如果你输入了正确的email,那么以后万一你的帐号被盗用,巫师\n"
             "        可以将该帐户的密码更改,然后将更改后的密码发送到你输入的email中.\n"
             "      2.如果不输入正确的email地址，巫师将无法保证你的帐号的权益..\n"
             "        即万一该帐户被盗用,巫师不会应任何id的请求而更改密码\n" 
             "      3.这里输入的email不能再次更改.\n"
             "      4.这里输入的email不会显示给其他玩家\n"
             "      5.如果您认为确实没有必要填写真实email,请输入xx@xx.com\n"
             "        请\t慎\t重\t考\t虑\n"NOR);
    
	write("请输入您的电子邮件地址：");
	input_to("get_email",  ob);

}

protected void get_email(string email, object ob)
{
		string str1,str2;
		if(!email||(sscanf(email,"%s@%s",str1,str2)!=2)||strsrch(str2,".")==-1)
		{
			write("邮件地址格式错误,请重新输入您的电子邮件地址:\n");
			input_to("get_email",  ob);
			return ;
		}
		ob->set("email", email);
        write("\n请您选择您的人物的属性类别,有12种类型(A,B,C,D,E,F,G,H,I,J,K,L)\n");
        input_to("get_kind",ob);//选择人物类型
}

protected void get_kind(string kind, object ob)
{
	mapping my;
	write("\n");
	if( kind<"a"||kind>"l" ) {
		write("你只能在(A--L)中选择一种人物类型:");
		input_to("get_kind", ob);
		return;
	}
	write(@TEXT

一个人物的天赋对于他或她所修习的武艺息息相关。本游戏中的人物具有
以下八项天赋：

    膂力    悟性    根骨    胆识
    定力    灵性    福缘    容貌
你选择的人物将具有以下天赋
TEXT);
my = ([]);
choice_gift(kind,ob->query("gender"),my);
write(sprintf("\n膂力[%d]， 悟性[%d]， 根骨[%d]， 胆识[%d]
定力[%d]， 灵性[%d]， 福缘[%d]， 容貌[%d]\n",
		my["str"], my["int"], my["con"], my["cor"],
		my["cps"], my["spi"], my["kar"], my["per"]));
	write("\n您接受这种选择吗？[Y/N] [N]");
	input_to("get_gift", ob, my);
}


protected void get_gift(string yn, object ob, mapping my)
{
	object user;
	//int id_temp; string id_num;
	if (yn[0] != 'y' && yn[0] != 'Y') {
		write("\n请您重新选择你的人物类型：(A--L)");
		input_to("get_kind", ob);
		return;
	}
	
	ob->set("body", USER_OB);
	if( !objectp(user = make_body(ob)) )
		return;
	user->set("gender",ob->query("gender"));
	user->set("kind",ob->query("kind"));
	ob->set("str", my["str"]);
	ob->set("cor", my["cor"]);
	ob->set("con", my["con"]);
	ob->set("int", my["int"]);
	ob->set("cps", my["cps"]);
	ob->set("spi", my["spi"]);
	ob->set("per", my["per"]);
	ob->set("kar", my["kar"]);

	user->set("str", my["str"]);
	user->set("cor", my["cor"]);
	user->set("con", my["con"]);
	user->set("int", my["int"]);
	user->set("cps", my["cps"]);
	user->set("spi", my["spi"]);
	user->set("per", my["per"]);
	user->set("kar", my["kar"]);
	
	write("请您选择你的职业:魔法师(enchanter),武士(fighter)\n");
	input_to("get_occupation", ob, user);//选择职业
}
protected void get_occupation(string kind,object ob,object user)
{
	write("\n");
	if(!kind){
	    write("\n请您选择你的职业:魔法师(enchanter),武士(fighter)\n");
            input_to("get_occupation",ob,user);//选择职业
            return ;
	}
	if(kind=="e"||kind=="E"||kind=="enchanter"||kind=="魔法师"){
	    user->set("occupation","enchanter");
            write("\n请问您真的选择魔法师(enchanter)吗？(y/n)\n");
	    input_to("get_really",ob,user);//确认选择的职业
	    return ;
	}
	if(kind=="f"||kind=="F"||kind=="fighter"||kind=="武士"){
	    user->set("occupation","fighter");
            write("\n请问您真的选择武士(fighter)吗？(y/n)\n");
	    input_to("get_really",ob,user);//确认选择的职业
	    return ;
	
	}
        write("\n请您选择你的职业:魔法师(enchanter),武士(fighter)\n");
        input_to("get_occupation",ob,user);//选择职业
        return ;
}

protected void get_really(string kind,object ob,object user)
{
         if (kind[0] != 'y' && kind[0] != 'Y') {
                write("\n那好吧,请您重新选择你的职业:魔法师(enchanter),武士(fighter)\n");
		input_to("get_occupation", ob,user);
		return;
	 }
	if(user->query("id")!="guest")
	log_file( "USAGE", sprintf("%s was created from %s (%s)\n", 
		user->query("id"), query_ip_name(ob), ctime(time()) ) );
	init_new_player(user);
	enter_world(ob, user);
	
//统计注册人数
