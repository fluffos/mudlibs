inherit NPC;
inherit F_SAVE;
int do_clone(string arg)
{
        object user, obj=this_object(); 
        if(!arg)return 0;
        if( (string)obj->set("id", arg) != arg ) {
                write("Failed setting user name.\n");
                destruct(user);
                return 1;
        }
        if( file_size(obj->query_save_file() + __SAVE_EXTENSION__) >= 0 ) {
                if( obj->restore() ) {
        if( objectp(user = LOGIN_D->make_body(obj)) ) {
                if( user->restore() ) {
        write("uid："+getuid(user)+"\n");
        write("euid："+geteuid(user)+"\n");
        write("OK.\n");
        user->move(environment(this_player()));
        user->revive();
        return 1;
                }
        }
                }
        }
                write("读取失败.\n");
        return 1;
}

void init()
{
    add_action("do_clone", "flogin");

}
void create()
{
        ::create();
        set_name("玩家模拟器", ({ "login" }) );
        setup();
}
string query_save_file()
{
        string id;

        id = query("id", 1);
        if( !stringp(id) ) return 0;
        return sprintf(DATA_DIR "login/%c/%s", id[0], id);
        return 0;
}



