#include <armor.h>
inherit CLOTH;
void create() {
  set_name("进身衣", ({ "cloth" }));
  set("long", "这可不是一件普通的布衣。\n");
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  seteuid(getuid());
  setup();
}
void init() {
  add_action("do_possess", "poss");
}
int do_possess(string arg) {
  object ob;
  object me = this_player();

  if (!arg) return notify_fail("你要附身于谁身上？\n");
  ob = present(arg, environment(me));
  if (!ob || !living(ob))
    return notify_fail("这里没有这个生物。\n");

  if (ob->query_temp("body_ob"))
    return notify_fail(ob->name() + "已经被人附身过了。\n");
  LOGIN_D->enter_world(me, ob, 1);

  return 1;
}
