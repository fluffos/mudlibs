#pragma save_binary

inherit ROOM;

void create() {
  set("coor", ({ -2000, 0, 0 }));
  set("short", "荒野");
  set("long",
    "这是一个无边的沙砾地，山势到了这里突然间变的无影无踪。地\n"
    "气极干燥，连风都是暖的。地上的石砾发出一种暗红的颜色，就\n"
    "象是被鲜血染红的一样。一条布满车痕的官道向西方和东方伸展。\n"
  );
  set("exits", ([
    "east": __DIR__ "huangyie0",
    "west": __DIR__ "sandroad",
  ]));
  set("outdoors", "quicksand");
  set("objects", ([
    __DIR__ "npc/trader": 1,
  ]));

  setup();
}
