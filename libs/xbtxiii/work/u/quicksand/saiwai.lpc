#pragma save_binary

inherit ROOM;

void create()
{
        set("coor",({-2900,0,0}));
	set("short", "塞外风光");
        set("long",
"地势到这是豁然开朗，你的西边是一望无际的沙漠。狂风在呼哮，\n"
"漫天黄沙在飞舞，飞沙滚滚。沙砾打在你的身上，就像是苍穹怒\n"
"投下的冰雹。冥冥中仿佛已有种邪恶的力量，任何人随时都有可\n"
"能突然像野狗般死在沙砾上。\n"
);
        set("exits", ([ 
  "east" : __DIR__"oldgreatwall",
  "west" : __DIR__"saiwai2",
]));
        set("outdoors", "quicksand");
        set("objects", ([
                __DIR__"npc/trader3" : 2,
        ]) );
        setup();
}

