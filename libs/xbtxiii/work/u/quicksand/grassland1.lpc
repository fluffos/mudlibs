#pragma save_binary

inherit ROOM;

void create() {
  set("coor", ({ -4000, 0, 0 }));
  set("short", "草原");
  set("long",
    "这里是一望无际的大草原。绿色的草地美丽得就象晴朗的蓝天。\n"
    "草原上三三两两的羊群则是蓝天上飘浮的朵朵白云。远处的布达\n"
    "拉宫在骄阳下看来亮如纯银；到了夕阳西下时又变得灿烂如黄金。\n"
    "你也许从没想到，在塞外的边陲之地竟有如此美妙的地方，美得\n"
    "辉煌而神秘，美得令人迷惑，美得令人都醉了。\n"
  );
  set("exits", ([
    "west": __DIR__ "grassland2",
    "east": __DIR__ "grassland0",
  ]));
  set("outdoors", "guanwai");
  set("objects", ([
    __DIR__ "npc/sheepgirl": 1,
    __DIR__ "npc/sheep": 1,
  ]));
  setup();
}
