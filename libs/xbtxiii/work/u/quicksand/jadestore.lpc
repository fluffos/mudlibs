#pragma save_binary

inherit ROOM;

void create()
{
        set("coor",({-2500,200,0}));
	set("short", "珠宝店");
        set("long",
"这是一家破旧的小店。专门经营玉器，这里虽是穷乡僻壤，这家\n"
"小店的生意却特别好。也许是出塞的人都知到塞外险恶，想必凶\n"
"多吉少，都想买块玉来消消灾。\n"
);
        set("exits", ([ 
 "south" : __DIR__"saikou",
]));
        set("outdoors", "quicksand");
        set("objects", ([
                __DIR__"npc/jadeowner" : 1,
        ]) );

        setup();

}

void init()
{
    if(this_player())
        this_player()->set_explore("north#50");
}
