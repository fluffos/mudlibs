#pragma save_binary
#include <roadbusy.h>

inherit ROOM;

void create()
{
        set("coor",({-3800,0,0}));
	set("short", "山路");
        set("long",
"这是一条被人走出来的小山路，虽然不宽却是够一辆马车通行。\n"
"小路顺着山中较为平坦地带缓缓向西伸展。向南是一座高耸的绝\n"
"崖。\n"
);
        set("exits", ([ 
  "east" : __DIR__"mroad",
  "west" : __DIR__"grassland0",
  "south" : __DIR__"cliff",
]));
        set("outdoors", "quicksand");

        setup();
//        replace_program(ROOM);
}

