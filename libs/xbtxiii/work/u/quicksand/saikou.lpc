#pragma save_binary
#include <roadbusy.h>

inherit ROOM;

void create()
{
        set("coor",({-2500,0,0}));
	set("short", "塞口");
        set("long",
"这里是中原入西域的必经之路，大批的商人鸵队都一定要从这里\n"
"经过，形成了这里的畸形路容。向西你可以看到一段破旧的长城，\n"
"上面好象还有被土炮轰过的痕迹，向北是一家小店庄。\n"
);
        set("exits", ([ 
  "east" : __DIR__"sandroad",
  "west" : __DIR__"oldgreatwall",
 "north" : __DIR__"jadestore",

]));
        set("outdoors", "quicksand");
        set("objects", ([
                __DIR__"npc/trader" : 1,
                __DIR__"npc/trader2" : 1,
        ]) );

        setup();

}

