#pragma save_binary

inherit ROOM;

void create() {
  set("coor", ({ -3600, 0, 0 }));
  set("short", "山脚");
  set("long",
    "沙漠到了这里似乎已经被西边的山冈挡住了。无论狂风怎么吹，\n"
    "大漠也不向西扩展一步。这里虽然也是光秃秃的，可是已经不再\n"
    "有灼人的酷热。几株被风刮来的滚草已经在这里扎下根来。翻过\n"
    "这座山就是塞外人居住的地方。\n"
  );
  set("exits", ([
    "east": __DIR__ "desert10",
    "west": __DIR__ "mroad",
  ]));
  set("outdoors", "quicksand");

  setup();
}
