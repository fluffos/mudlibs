#pragma save_binary

#include <ansi.h>
inherit NPC;
int ask_map(object me);
void create()
{
        set_name("探险者", ({ "explore_man"}) );
        set("gender", "男性" );
        set("age", 35);
        set("long", "一个好象刚刚死里逃生的家伙，现在还惊魂未定。 \n");
        set("combat_exp", 1000000);
        set("per", 10);

                set("max_kee",1000);
                set("kee",1000);
                set("force",1000);
                set("max_force",1000);
                set("force_factor",10);


        	set_skill("parry", 150);
            	set_skill("dodge", 150);
                set_skill("chaos-steps",150);
                set_skill("unarmed",150);
                set_skill("taiji-quan",150);
                map_skill("unarmed","taiji-quan");
                map_skill("dodge","chaos-steps");
                map_skill("parry","taiji-quan");
        set("inquiry", ([
               "藏宝图" : (:ask_map:),
               "map"    : (:ask_map:),
        ]) );

            setup();
            add_money("gold", 10);
            carry_object("/obj/cloth")->wear();
}

void init()
{
                object me;
                me=this_player();
                call_out("greeting",1,me);                      
}

int greeting(object me)
{
                message_vision(CYN"探险者心有余辜的说道：这位"+RANK_D->query_respect(me)+"，你也要去沼泽啊寻找宝物啊？？？\n"
                                                "那里面可是万分危险啊！！！里面总共有5条怪兽。其中外面的4条是打不死的.\n"
                                                "一定要将最后的那条龙杀了才行。我刚才真是死里逃生啊！！！\n"NOR,me);
                tell_object(me,CYN"\n\n探险者说完，脸上露出了极度恐慌的神情。\n"NOR);
}

int ask_map(object me)
{
		object map;
		me = this_player();
                message_vision(CYN"探险者说道：这位"+RANK_D->query_respect(me)+"，你想要去沼泽啊寻找宝物啊？？？\n"
                                                "那里面可是万分危险啊！！！你要藏宝图啊？没问题！！\n"
                                                "反正我是再也不会去的了！这张藏宝图就送你了！！！\n"NOR,me);
		map = new(__DIR__"obj/map");
		map->move(me);
                tell_object(me,CYN"\n\n探险者说完，脸上露出了极度恐慌的神情。\n"NOR);
                return 1;
}