#pragma save_binary
inherit ITEM;

void create()
{
        set_name("地图", ({ "map" }));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("long", "一张破旧的藏宝图。\n"
                            "  上面写着:\n"
                            "宝物在西方红色怪物的身上。沙漠……\n"
                                        );
                set("value", 0);
                set("material", "copper");
        }
}
