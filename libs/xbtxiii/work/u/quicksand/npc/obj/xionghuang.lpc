#pragma save_binary
// dumpling.c 雄黄

inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name("雄黄", ({"xionghuang"}));
	set_weight(1);
	if (clonep())
		set_default_object(__FILE__);
	else {
        set("long", "一个雄黄，金黄色的。\n");
		set("unit", "个");
		set("value", 15);
		set("food_remaining", 1);
		set("food_supply", 20);
	}
}
