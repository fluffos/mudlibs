#pragma save_binary
// Room: /d/chuenyu/trap_castle.c
#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("coor", ({ -3100, 0, 0 }));
  set("short", "大漠风沙");
  set("long",
    "你现在处在酷热如烘炉的沙漠中，热的令人连气都透不出。除了\n"
    "满耳呼呼的风声，你什么也听不见；除了满眼滚滚的飞沙，你什\n"
    "么也看不见；天地间仿佛只剩下你一个人。你脚下缓缓而动的流\n"
    "沙给你如旅薄冰的感觉。\n"
  );
  set("exits", ([
    "west": __DIR__ "desert0",
    "east": __DIR__ "saiwai2",
  ]));
  set("item_desc", ([
    "sand": "缓缓流动的流沙就象一头待人而噬的巨兽，匍匐在你脚下。\n",
    "流沙": "缓缓流动的流沙就象一头待人而噬的巨兽，匍匐在你脚下。\n",
  ]));

  set("outdoors", "quicksand");

  setup();
}
