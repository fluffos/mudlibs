#pragma save_binary

inherit ROOM;

void create() {
  set("coor", ({ -2700, 0, 0 }));
  set("short", "破旧长城");
  set("long",
    "昔日雄伟的长城已面目全非，岁月和战争已几乎把它夷为平地。\n"
    "唯一仅存的一点废墟，都被历代英雄的鲜血染成暗红色。这里虽\n"
    "然是一片萧杀，却有几株小树从碎石的缝隙中挤出，给人以一线\n"
    "生机的感觉。\n"
  );
  set("exits", ([
    "east": __DIR__ "saikou",
    "west": __DIR__ "saiwai",
  ]));
  set("outdoors", "quicksand");

  setup();
  replace_program(ROOM);
}
