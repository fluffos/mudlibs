#pragma save_binary

inherit ROOM;

void create()
{
        set("coor",({-3700,0,0}));
	set("short", "山路");
        set("long",
"这是一条被人走出来的小山路，虽然不宽却是够一辆马车通行。\n"
"小路顺着山中较为平坦地带缓缓向西伸展。\n"
);
        set("exits", ([ 
  "east" : __DIR__"mfoot",
  "west" : __DIR__"mroad2",
]));
        set("outdoors", "quicksand");
        set("objects", ([
                __DIR__"npc/trader" : 2,
        ]) );

        setup();
}

