#pragma save_binary
#pragma save_binary
// magic_armor2.c
#include <ansi.h>
#include <armor.h>
inherit ARMOR;
void create() {
  set_name(BLU "金刚战甲" NOR, ({ RED "magic armor" NOR, RED "armor" NOR }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "gold");
    set("armor_prop/armor", 60);
  }
  set("no_get", 1);
  set("no_drop", 1);
  setup();
}
void owner_is_killed(object killer) {
  destruct(this_object());
}
