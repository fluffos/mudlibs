#pragma save_binary
#include <weapon.h>

inherit SWORD;

void create()
{
        set_name("烂银剑", ({"silver sword", "sword"}));
        set_weight(14000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "一把烂银打造的细剑，分量不轻．\n");
                set("value", 10000);
                set("material", "unknow");
                set("wield_msg",
"$N「唰」地一声抽出一把$n握在手中．\n");
                set("unwield_msg",
"$N将手中的$n插入腰间，嘴角露出一丝笑意．\n");
        set("weapon_prop/int", 2);

        }
        init_sword(50);
        setup();
}


