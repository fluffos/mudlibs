#pragma save_binary
#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
        set_name(HIG"越女剑"NOR, ({"yue_nv_sword", "sword"}));
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "一把淡绿色的细剑，弯弯曲曲的形状看起来似乎美女的蛇腰\n");
                set("value", 35000);
                set("material", "unknow");
                set("wield_msg",
"$N「唰」地一声抽出一把$n握在手中．\n");
                set("unwield_msg",
"$N将手中的$n插入腰间.\n");
        set("weapon_prop/int", 2);

        }
        init_sword(55);
        setup();
}


