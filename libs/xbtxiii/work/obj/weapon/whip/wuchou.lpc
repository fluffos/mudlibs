#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create() {
  set_name(HIM "彩绸" NOR, ({ "whip" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一条长长的彩绸，是用于舞蹈的道具\n");
    set("unit", "条");
    set("value", 10000);
    set("wield_msg", "$N左手轻扬，一条蓝色绸带忽地甩了出来\n");
    set("unwield_msg", "$N把手中$n缠回腰间．\n");
  }
  init_whip(50);
  setup();
}
