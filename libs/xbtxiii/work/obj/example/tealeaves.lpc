#pragma save_binary
// dagger.c : an example weapon

#include <weapon.h>

inherit DAGGER;

void create() {
  set_name("茶叶", ({ "tea leaves", "tea", "leaves" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把看起相当普通茶叶。\n");
    set("value", 50);
    set("material", "leaves");
  }
  init_dagger(1);
  //	init_hammer(1);
  // These properties are optional, if you don't set them, it will use the
  // default values.

  set("wield_msg", "$N从怀中摸出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n藏入怀中。\n");

  // The setup() is required.

  setup();
}
