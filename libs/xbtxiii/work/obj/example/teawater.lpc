#pragma save_binary
// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("茶水壶", ({ "teapot", "pot" }) );

	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个普通的大茶壶，大概装得四、五升的茶。\n");
		set("unit", "个");
		set("value", 20);
		set("max_liquid",10);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type":"teawater",
		"name":"茶水",
		"remaining":10,
		"drunk_apply":0,
	]) );
}
