#pragma save_binary
// /d/fy/obj/fruit.c 弥幻果 治疗玩家身上bug用的。
#include <ansi.h>

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("弥幻果", ({"guo"}));

        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long","这是一青色的弥幻果,它可以治疗玩家身上的疑难杂症但是如果身体没问题,吃了反而奇害无比!。\n");
                set("value",500);
                set("food_remaining", 1);
                set("food_supply", 1);
             }
             
}

int do_eat(string arg)
{

        object me;
//        string skill;
//        string *sname;
//        mapping skills;
        me=this_player();
        if(arg=="guo")

           {   
           	me->delete_temp("baxian");
                me->delete_temp("eight_chaos");
            }
}

