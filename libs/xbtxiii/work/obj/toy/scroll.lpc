#pragma save_binary
// cloth.c
//
// 供mud_age<=43200的玩家使用的

#include <ansi.h>
inherit ITEM;

void create()
{
	set_name(HBMAG"瞬间转移卷轴"NOR, ({ "fly scroll" }) );
	set_weight(1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
	     set("unit", "卷");
             set("1","/d/fy/fqkhotel");
             set("2","/d/chaoting/xianya/cloudy_xianya");
             set("3","/d/yangzhou/pomiao");
             set("4","/d/latemoon/latemoon1");
             set("5","/d/xueshan/guangchang");
             set("6","/d/ny/schoolhall");
             set("7","/d/temple/temple1");
             set("8","/d/huashan/buwei1");
             set("9","/d/wudang/sanqingdian");
             set("10","/daemon/class/fighter/guildhall");
             set("11","/d/shaolin/guangchang1");
             set("12","/d/xingxiu/riyuedong");
	     set("no_drop","这玩意儿都不要？您还是留着吧");
	     set("long","是可以使用"+HBMAG+MAG+"fly <号码>"+NOR+"来去您想要去的地方。以下是您可以去的地方:\n"
		"1  有一间客栈  2 官府     3 丐帮   4 晚月庄   5 雪山派\n"
		"6  封山派      7 茅山派   8 华山派 9 武当派  10 天邪派\n"
		"11 少林寺     12 星宿派\n");
	}
	setup();
}

int init()
{
	add_action("do_goto","fly");	
}


int do_goto(string arg)
{
	object me;
	int mud_age,i;
	string msg;	

	me=this_player();
	mud_age=me->query("mud_age");
	
	if(mud_age>43200){
	    tell_object(me,"您已经不需要这玩意儿了。\n");	
	    destruct(this_object());
	    return 1;
	}
	if(environment(me)
	  &&strsrch(file_name(environment(me)),"/d/start_room/")>0){
	    tell_object(me,"这里不能使用这个玩意儿。\n");
	    return 1;
	}  
	if(sscanf(arg,"%d",i)!=1 ){
	    tell_object(me,"请选择一个号码.例如:fly 1\n");
	    return 1;
	}
	if((int)i>12||(int)i<0){
	    tell_object(me,"没有这个地方可以去\n");
	    return 1;
	}
	remove_call_out("goto_room");
	msg=HBMAG+MAG+"$N双手防于眉间，开始准备瞬间移动。\n"NOR;
	call_out("goto_room",random(5)+1,me,i);
	return 1;
}

int goto_room(object me,object i)
{
	string msg;
	if(!me) return 1;
	msg=HBMAG+MAG+"一道柔和的蓝色光芒笼罩着$N,片刻之后$N消失的无影无踪.\n"NOR;
	message_vision(msg,me);
	if(me->move(query(i))) return 1;
	else{
	    tell_object(me,"你要去的那个地方可能出了问题。请通知巫师。谢谢\n");
	    return 1;
	}
	return 1;
}