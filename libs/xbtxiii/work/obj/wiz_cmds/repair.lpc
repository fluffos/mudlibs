#pragma save_binary
// repair.c

#include <ansi.h>
inherit ITEM;

string status_color(int current, int max);

void create() {
  set_name(MAG "修理卷轴" NOR, ({ "repair_scroll" }));
  set_weight(14000);
  set("long", "这是一个修理卷轴，可以用来修理防具和武器。\n");
  set("value", 20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("material", "unknow");
  }

  setup();
}

mixed new_use(object me, string arg) {
  int item_value, now_armor, lost_prop;
  int now_damage;
  object item;
  if (!arg)
    return "use repair_scroll to <item>\n";
  item = present(arg, me);
  if (!item)
    return "你没有这样东西啊？\n";
  if (me->is_fighting())
    return "你想死啊！！！战斗中敢修东西？？？\n";
  if (me->is_busy())
    return "你正忙着呢。\n";
  if (item->query("armor_type")) {
    now_armor = item->query("armor_prop/armor");
    lost_prop = item->query("lost_prop");
    if (lost_prop <= 0)
      return "你的" + item->name() + "好好的，修什么修啊？\n";
    item_value = item->query("value");
    if (item_value <= 100)
      return "这么烂的东西还要修？免了吧！！！\n";

    write("修好了！！！就像新的一样！！！\n", me);
    item->unequip();
    item->set("armor_prop/armor", lost_prop + now_armor);
    item->delete("lost_prop");
    return 1;
  } else if (item->query("skill_type")) {
    now_damage = item->query("weapon_prop/damage");
    lost_prop = item->query("lost_prop");
    if (lost_prop <= 0)
      return "你的" + item->name() + "好好的，修什么修啊？\n";
    item_value = item->query("value");
    if (item_value <= 100)
      return "这东西不值钱，没必要修。\n";

    item->unequip();
    item->set("weapon_prop/damage", lost_prop + now_damage);
    item->delete("lost_prop");
    write("修好了！！！就像新的一样！！！\n", me);
    return 1;
  } else
    return "这个卷轴修不了这个东西。\n";
}
