#pragma save_binary
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name( MAG "飞行卷轴" NOR, ({ "fly_scroll" }) );
        set_weight(14000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "卷");
                set("long",
                        "这是一个飞行卷轴，用它可以飞到任何生物的身边。\n");
                set("value", 50000);
                set("material", "unknow");
        }

}
mixed new_use(object me,string arg)
{
       object ob;
if(arg)
       {
       ob=find_living(arg);
       if (!ob) return "找不到这个生物。无法飞行。。。\n"; 
       if (ob==me)
          {
          destruct(this_object());
          return "你有病啊！！！\n";
          }
       if(wizardp(ob)) return "找不到这个生物。无法飞行。。。\n"; 
       message_vision(HIG"$N使用了一个飞行卷轴，立即化做一阵青光消失的无影无踪。\n"NOR,me);
       me->move(environment(ob));
       message("vision",YEL"一道青光闪过，"+me->name()+"出现在"+ob->name()+"的眼前。\n"NOR,environment(me));
       }
else 
       return "指令格式 use fly_scroll to <living>\n";
	return 1;
}
