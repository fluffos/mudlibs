// halt.c

#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(MAG"投降卷轴"NOR,({"halt_scroll"}));
        set_weight(14000);
        set("long","这是一个投降卷轴，可以用来向敌人投降。非常有用。\n");
        set("value",20000);
        if( clonep() )
            set_default_object(__FILE__);
        else
            {
            set("unit", "卷");
            set("material", "unknow");
            }

        setup();
}

mixed new_use(object me,string arg)
{
	int i;
	object *inv;

	if( !me->is_fighting() )
        return "你现在并没有在战斗。\n";
	inv=all_inventory(environment(me));
	me->remove_all_killer();
	for(i=0;i<sizeof(inv);i++)
		inv[i]->remove_killer(me);
    message_vision(HIY"$N使用了一个投降卷轴说：我不打了，停止了战斗。\n"NOR, me);
	return 1;
}
