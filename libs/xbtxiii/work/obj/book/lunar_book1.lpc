#pragma save_binary
// Lunar_book1.c

inherit ITEM;
inherit F_AUTOLOAD;
int do_study(string);
int study(object me, string arg) {
  object ob;
  mapping skill;
  int cost, exp;

  if (me->is_fighting())
    return notify_fail("你无法在战斗中专心下来研读新知！\n");

  if (!arg || !objectp(ob = present(arg, me)))
    return notify_fail("你要读什麽？\n");

  if (!mapp(skill = ob->query("skill")))
    return notify_fail("你无法从这样东西学到任何东西。\n");

  if (!me->query_skill("literate", 1))
    return notify_fail("你是个文盲，先学学读书识字(literate)吧。\n");

  message("vision", me->name() + "正专心地研读" + ob->name()
    + "。\n", environment(me), me);
  if (me->query_skill("literate", 1) < skill["literate_required"]) {
    write("你认字太少，再怎么读也没用。\n");
    return 1;
  }
  if ((int)me->query("combat_exp") < skill["exp_required"]) {
    write("你的实战经验不足，再怎麽读也没用。\n");
    return 1;
  }

  notify_fail("以你目前的能力，还没有办法学这个技能。\n");
  if (!SKILL_D(skill["name"])->valid_learn(me)) return 0;

  cost = skill["sen_cost"] + skill["sen_cost"] * (skill["difficulty"] - (int)me->query("int")) / 20;
  if ((int)me->query("sen") < cost) {
    write("你现在过於疲倦，无法专心下来研读新知。\n");
    return 1;
  }

  if (me->query_skill(skill["name"], 1) > skill["max_skill"]) {
    write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
    return 1;
  }

  me->receive_damage("sen", cost);

  if (!me->query_skill(skill["name"], 1))
    me->set_skill(skill["name"], 0);
  exp = (int)me->query("combat_exp") - skill["exp_required"];
  exp = (int)(exp / 10000);
  me->improve_skill(skill["name"], exp + (int)me->query_skill("literate", 1) / 5 + 1);
  write("你研读有关" + to_chinese(skill["name"]) + "的技巧，似乎有点心得。\n");
  return 1;
}
void create() {
  set_name("九阴真经(上卷)", ({ "Lunar_book1", "Lunar1" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这本旧书的纸张都已经泛黄了，上面似乎附着一种魔力！\n");
    set("value", 50);
    set("material", "paper");
    set("no_get", 1);
    set("no_drop", "这种武林密籍，怎能随便丢弃！？\n");
    set("master_id", "npc");
    set("skill", ([
      "name": "force",  // name of the skill
      "exp_required": 3000,    // minimum combat experience required
      "literate_required": 30,         // to learn this skill.
      "sen_cost": 20,    // gin cost every time study this
      "difficulty": 20,    // the base int to learn this skill
      "max_skill": 80    // the maximum level you can learn
    ]));
  }
}

init() {
  add_action("do_study", "study");
}

int do_study(string arg) {
  object me, ob;
  me = this_player();
  ob = this_object();
  if (me != environment())
    return 0;
  if (arg != "lunar1" && arg != "lunar_book1") return study(me, arg);
  if (me->query("id") == ob->query("master_id")) {
    write("你眼前一闪，九阴真经已然翻开了！\n");
    if (me->query("bellicosity") > 500) {
      write("你杀气太高，无法领悟九阴真经！\n");
      return 1;
    }
    study(me, arg);
  } else {
    write("你的手刚碰到书皮，九阴真经就化作一缕清烟消失了。。。\n");
    seteuid(getuid());
    destruct(ob);
  }
  return 1;
}

string query_autoload() {
  object me;
  me = this_object();
  return me->query("master_id");
}
void autoload(string arg) {
  set("master_id", arg);
}
