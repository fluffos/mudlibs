#pragma save_binary
// nine_swordbook.c

inherit ITEM;
inherit F_AUTOLOAD;
int do_study(string);
void create()
{
	set_name("独孤九剑之残篇", ({ "Lonely_sword_book","swordbook" }));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long",
			"这几张泛黄的旧纸，上面画着一些使剑的人形。\n");
		set("value",0);
		set("material", "paper");
		set("no_get",1);
		set("no_drop","这种武林密籍，怎能随便丢弃！？\n");
		set("master_id","NPC");
		set("skill", ([
			"name": 		"lonely-nine-sword",	// name of the skill
			"exp_required":	3000,				// minimum combat experience required
			"literate_required":30,				// to learn this skill.
			"sen_cost":		50,			// gin cost every time study this
			"difficulty":	30,				// the base int to learn this skill
			"max_skill":	30				// the maximum level you can learn
		]) );
            }
}
string query_autoload()
{
	object ob;
	ob=this_object();
	return ob->query("master_id");
}
void autoload(string arg)
{
	set("master_id",arg);
}
