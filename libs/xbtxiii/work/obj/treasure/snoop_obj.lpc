#include <ansi.h>
inherit F_MESSAGE;
inherit ITEM;
void aborsb_player(object me);
void create() {
  set_name("羊脂水净瓶的监视器", ({ "snoop_object" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long",
      "羊脂水净瓶的监视器，对人毫无用处。\n");
    set("no_drop", "你身上没有这样东西。\n");
    set("no_shown", 1);
    set("value", 0);
    set("material", "unknow");
  }

}
int init() {
  add_action("do_say", ({ "say", "tell", "wiz" }));
}

void start_working(object me, object player) {
  call_out("destrcut_it", 30);
}

int do_say(string arg) {
  object me, tell_player;
  string target, msg;
  me = environment(this_object());
  if (!arg) return 0;
  if (query_verb() == "tell" && sscanf(arg, "%s %s", target, msg) != 2) return 0;
  if (strsrch(arg, "?") >= 0 || strsrch(arg, "呢") >= 0
    || strsrch(arg, "嘛") >= 0
    || strsrch(arg, "哦") >= 0 || strsrch(arg, "唉") >= 0
    || strsrch(arg, "什么") >= 0 || strsrch(arg, "吗") >= 0
    || strsrch(arg, "恩") >= 0 || strsrch(arg, "本人在") >= 0
    || strsrch(arg, "我在这") >= 0 || strsrch(arg, "我在此") >= 0
    || strsrch(arg, "老子在") >= 0 || strsrch(arg, "老子我在") >= 0
    || strsrch(arg, "爷爷在") >= 0 || strsrch(arg, "爷爷我在") >= 0) {
    if (query_verb() == "tell") {
      tell_player = present(target, environment(environment(this_object())));
      if (tell_player == environment(this_object())
        && "cmds/std/tell"->main(me, arg) != 1)
        return 0;

    } else if (query_verb() == "say") "cmds/std/say"->main(me, arg);
    else if (query_verb() == "wiz")
      "/adm/daemons/channeld"->do_channel(me, "wiz", msg, 0);
    else return 0;
    this_object()->aborsb_player(me);
    return 1;
  } else
    return 0;
}

void aborsb_player(object me) {
  object bottle;
  bottle = query("bottle");
  if (environment(me) != environment(environment(query("bottle"))))
    return;
  tell_room(environment(me), me->name() + "忍不住应了一声。\n"
    "顷刻之间被吸到净水瓶里了\n", me);
  tell_object(me, "你不住应了一声。\n"
    "你觉得一阵轻飘飘的，身型越化越小，顷刻之间被吸到了羊脂水净瓶里。\n\n");
  me->move(bottle);
  bottle->set("close", 1);
  bottle->set("open", 0);
  me->set_temp("remain_time", 300);
  bottle->melt_player(me);
  destruct(this_object());
}

void destrcut_it() {
  destruct(this_object());
}
