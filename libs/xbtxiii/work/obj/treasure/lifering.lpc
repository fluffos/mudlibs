#pragma save_binary
// lifering.c 生命戒指

#include <armor.h>

inherit FINGER;

void create()
{
        set_name("生命戒指", ({ "life ring", "ring" }));
	set("weight", 400);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("value", 100000);
		set("material", "gold");
		set("armor_prop/armor", 1);
	}
	setup();
}	
int wear(int n)
{
    int i;
    i=::wear(n);
    if(i) environment()->add("max_kee",100);
    return i;
}
int unequip()
{
    int i;
    i=::unequip();
    if(i) environment()->add("max_kee",-100);
    return i;
}
