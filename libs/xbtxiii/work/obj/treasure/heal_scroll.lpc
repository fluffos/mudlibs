#pragma save_binary
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name( MAG "治疗卷轴" NOR, ({ "heal_scroll" }) );
        set_weight(14000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "卷");
                set("long",
                        "这是一个治疗卷轴，用它可以完全恢复玩家的力量。\n");
                set("value", 1);
                set("material", "unknow");
        }

}
mixed new_use(object me,string arg)
{
        int maxgin,maxkee,maxsen,maxforce,maxmana,maxatman;
        maxsen=me->query("max_sen");
        maxkee=me->query("max_kee");
        maxgin=me->query("max_gin");     
        maxforce=me->query("max_force");
        maxmana=me->query("max_mana");
        maxatman=me->query("max_atman");

        me->set("mana",maxmana);
        me->set("atman",maxatman);
        me->set("force",maxforce);
        me->set("sen",maxsen);
        me->set("gin",maxgin);
        me->set("kee",maxkee);
        me->set("eff_kee",maxkee);
        me->set("eff_gin",maxgin);
        me->set("eff_sen",maxsen);

        message_vision(CYN"$N祭起手中的卷轴，念了几句咒语。顿时，一道柔和的金光笼罩在$N的全身。\n"NOR,me);
        tell_object(me,"你感到全身舒畅，全身似乎充满了力量。。。\n");
        
	return 1;
}