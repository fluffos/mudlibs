#pragma save_binary
// teapot.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("茶壶", ({ "teapot" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个看上去谱普通通的大茶壶。\n");
    set("unit", "个");
    set("value", 300);
    set("max_liquid", 1000);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("liquid", ([
    "type": "water",
    "name": "龙井茶",
    "remaining": 1000,
    "drunk_apply": 0,
  ]));
}
