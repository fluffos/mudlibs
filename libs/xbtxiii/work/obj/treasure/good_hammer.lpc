#pragma save_binary
//金刚伏魔锤 。

#include <weapon.h>
#include <ansi.h>
inherit F_AUTOLOAD;
inherit HAMMER;

void create()
{
                set_name( YEL"金刚伏魔锤" NOR,({"jin gang chui","hammer"}));
        if( clonep() )
                set_default_object(__FILE__);
        else{
            set("unit", "柄");
    set("long", "金刚伏魔锤\n");

    set("value", 100000);
    set("material", "异类金属");
    set("wield_msg", "$N「嘿」地一声从背后摸出一柄闪亮的大锤!\n");
    set("unwield_msg", "$N将手中的$n放回背后。\n");
    init_hammer(120);
    }   
    setup();
        
}

int query_autoload()
{
        return 1;
}
