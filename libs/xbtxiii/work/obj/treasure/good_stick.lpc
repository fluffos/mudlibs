#pragma save_binary
// 绝情剑。

#include <weapon.h>
#include <ansi.h>
inherit F_AUTOLOAD;
inherit STAFF;

void create() {
  set_name(RED "朝天棍" NOR, ({ "chao tian stick", "stick", "gun" }));

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "\n");
    set("value", 100000);
    set("material", "异类金属");
    set("wield_msg", "$N　挥舞着手中的$n。横在胸前\n");
    set("unwield_msg", "$N将手中的$n放在地上。\n");
    init_staff(120);
  }
  setup();

}

int query_autoload() {
  return 1;
}
