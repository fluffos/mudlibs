#pragma save_binary
#include <ansi.h>

inherit ITEM;

void create() {
  set_name(MAG "变身卷轴" NOR, ({ "disguise_scroll" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("long",
      "这是一个变身的魔法卷轴。用它可以变成npc的模样。\n");
    set("value", 1);
    set("material", "unknow");
  }

}
mixed new_use(object me, string arg) {
  object ob;
  if (arg) {
    if (query("disguise") == "ok") return "你正在假扮着某人。\n";
    ob = present(arg, environment(me));
    if (!ob) return "找不到这个生物。\n";
    if (userp(ob)) return "你不能变成玩家的模样。\n";
    message_vision(YEL "$N祭起手中的卷轴,默念了几句咒语，$N立即变成了" + ob->name() + "的模样。。\n" NOR, me);
    me->set_temp("apply/name", ({ ob->name() }));
    me->set_temp("apply/id", ({ ob->query("id") }));
    me->set_temp("apply/short", ({ ob->short() }));
    me->se_temp("apply/long", ({ ob->long() }));
    me->set_temp("apply/gender", ({ ob->query("gender") }));
    me->set("age", ({ ob->query("age") }));
    set("disguise", "ok");
    call_out("remove_temp", 300, me);
    return "ok\n";
  } else {
    return "指令格式: use disguise_scroll to <living>\n";
  }
}

void remove_temp(object me) {
  me->delete_temp("apply/name");
  me->delete_temp("apply/id");
  me->delete_temp("apply/short");
  me->delete_temp("apply/long");
  me->delete_temp("apply/gender");
  write("你渐渐的恢复了真身。\n", me);
  tell_room(environment(me), "" + me->name() + "恢复了原来的样子。\n", ({ me }));
  destruct(this_object());
}
