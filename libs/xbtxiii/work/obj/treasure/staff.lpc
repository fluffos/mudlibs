#pragma save_binary
// staff.c 六阴追魂棍

#include <weapon.h>
#include <ansi.h>

inherit STAFF;

void create()
{
            set_name( HIR"六阴追魂棍" NOR,({ "zhuihun staff","staff" }));
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else{
                set("unit", "杆");
            set("long","一杆赤红色的长棍。分量不轻。拿在手里。沉甸甸的。一看就知道是杆好棍.\n");
        set("value", 100000);
        set("material", "异类金属");
        set("wield_msg", "$N甩了甩$n，挥舞了一个圈。把$n竖在胸前!\n");
        set("unwield_msg", "$N将手中的$n立在身后。\n");
            }
                init_staff(120);
        setup();
}

