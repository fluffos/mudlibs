#pragma save_binary
// 古剑长歌。

#include <weapon.h>
#include <ansi.h>
inherit F_AUTOLOAD;
inherit SWORD;

void create() {
  set_name(CYN "古剑长歌" NOR, ({ "gu jian chang ge", "sword" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把宝剑---古剑长歌。\n");
    set("value", 100000);
    set("material", "异类金属");
    set("wield_msg", "$N「唰」地一声从剑鞘里抽出一把$n握在手中。随手挥舞了几下。\n");
    set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
    init_sword(120);
  }
  setup();

}

int query_autoload() {
  return 1;
}
