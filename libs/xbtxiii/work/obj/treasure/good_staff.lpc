#pragma save_binary
// 金刚伏魔杖。

#include <weapon.h>
#include <ansi.h>
inherit F_AUTOLOAD;
inherit STAFF;

void create() {
  set_name(HIC "金刚伏魔杖" NOR, ({ "fu mo zhang", "staff", "zhang" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "一柄有粗有长的伏魔杖。\n");
    set("value", 100000);
    set("material", "异类金属");
    set("wield_msg", "$N「嘿」地一声轮起手中的$n.\n");
    set("unwield_msg", "$N将手中的$n放在地上。\n");
    init_staff(120);
  }
  setup();

}


int query_autoload() {
  return 1;
}
void owner_is_killed(object killer) {
  if (!killer) killer = environment();
  tell_room(environment(killer),
    "\n尸体中的" HIC "金刚伏魔杖" NOR "化成一道金光冲天而去！\n");
  destruct(this_object());
  return;
}
