#pragma save_binary
// spear.c 飞龙枪

#include <weapon.h>
#include <ansi.h>

inherit SPEAR;

void create()
{
            set_name( HIY"飞龙枪" NOR,({ "dragon_spear" }));
                set("no_drop",1);
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else{
                set("unit", "杆");
            set("long","一杆金黄色的长枪。分量不轻。拿在手里。沉甸甸的。一看就知道是杆好枪.\n");
        set("value", 150000);
        set("material", "异类金属");
        set("wield_msg", "$N「唰」地一声将飞龙枪亮了出来，横在胸前!\n");
        set("unwield_msg", "$N将手中的$n立在身后。\n");
            }
                init_spear(120);
        setup();
}

