#include <ansi.h>

//by rongg@XBTXII
inherit ITEM;

void create() {
  set_name(HIW "羊脂水净瓶" NOR, ({ "bottle" }));
  set_max_encumbrance(1000000);
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long",
      "一个白玉做的瓶子，发出晶莹闪亮的光芒。据说是开天辟地，混沌出开\n"
      "一个神仙在某处仙山摘的。用它呼叫某人的名字，如果对方回应，立刻\n"
      "会被吸收到里面。过的一时三刻，化为血水而死。\n\n"
      "具体作用如下:absorb sb 呼喊sb的名字，如对方答应，则将其收入瓶内。\n"
      "open:打开瓶子的盖子。close:盖上瓶盖。rock:摇晃瓶子，估计里面的人\n"
      "已经被腐化到了什么程度。\n\n");
    set("value", 0);
    set("material", "unknow");
  }

}

int init() {
  if (environment(this_object()) == this_player()) {
    add_action("do_absorb", "absorb");
    add_action("do_open", ({ "open", "close" }));
    add_action("do_rock", "rock");
  }
  if (environment(this_player()) == this_object()) {
    add_action("do_look", "look");
    add_action("do_out", "out");
    add_action("do_quit", "quit");
  }

}

int do_absorb(string arg) {
  object player, me, snoop_obj;
  string name1, name2;
  me = this_player();
  if (arg) {
    player = present(arg, environment(me));
    if (!player)
      return notify_fail("你身边没有这个人\n");
    else {
      if (me == player) return notify_fail("用suicide -f快些。\n");

      if (objectp(query("snoop_obj"))) destruct(query("snoop_obj"));
      remove_call_out("time_out");
      if (sizeof(all_inventory(this_object())) >= 1)
        return notify_fail("水净瓶里有人，装不下了。\n");
      name1 = me->name();
      name2 = player->name();
      tell_room(environment(me),
        CYN "" + name1 + "揭开手中的羊脂水净瓶的盖子，高举在手中口中高声叫道，" + name2 + "，\n" NOR,
        ({ me, player }));
      tell_object(player, CYN + name1 + "揭开手中的羊脂水净瓶的盖子,高举在手中向你大声叫道：" + name2 + "\n" NOR);
      write(CYN "你揭开手中羊脂水净瓶的盖子，高举在手中大声向" + name2 + "叫道：" + name2 + "。\n" NOR);
      set("the_absorb_player", player->query("id"));
      snoop_obj = new(__DIR__ "snoop_obj");
      snoop_obj->move(player);
      snoop_obj->set("bottle", this_object());
      set("snoop_obj", snoop_obj);
      snoop_obj->start_working(me, player);
      call_out("time_out", 30, me, player);
      return 1;
    }
  } else return notify_fail("你想将谁吸收到羊脂水净瓶里面来？\n");
}

int do_open(string arg) {
  object me;
  me = this_player();
  if (query_verb() == "open") {
    if (arg == "bottle") {
      if (sizeof(all_inventory(this_object())) <= 0)
        return notify_fail("你打开盖子朝里面看了看，里面什么也没有,然后就盖上盖子了。\n");
      else {
        message_vision(CYN "$N将手里的羊脂水净瓶的盖子揭开了。\n" NOR, me);
        tell_room(this_object(), me->name() + "将盖子打开了，你赶快逃出去吧(out)\n");
        this_object()->set("open", 1);
        this_object()->set("close", 0);
        return 1;
      }
    }
  } else if (query_verb() == "close") {
    if (arg == "bottle") {
      if (query("close") == 1)
        return notify_fail("瓶子本来就是盖着的。\n");
      else {
        message_vision(CYN "$N将手里的羊脂水净瓶里盖上了。\n", me);
        this_object()->set("open", 0);
        this_object()->set("close", 1);
        return 1;
      }
    }
  }
}

int do_rock() {
  object me, player;
  me = this_player();
  player = first_inventory(this_object());
  if (sizeof(all_inventory(this_object())) <= 0)
    return notify_fail("里面根本没人，你摇什么啊？\n");
  message_vision(CYN "$N拿起手中的羊脂水净瓶轻轻的摇晃了几下。然后贴在耳边听了听。\n" NOR, me);
  write(
    "里面的" + player->name() + "已经融化了大约十分之" + CHINESE_D->chinese_number(player->query_temp("percent")) + "\n",
    me
  );
  return 1;
}
int time_out(object me, object player) {
  message_vision(CYN "$N叫了$n半天，$n也没有答应\n" NOR, me, player);
  this_object()->delete("the_absorb_player");
  return 1;
}



int do_look(string arg) {

  if (!arg) {
    write("羊脂水净瓶内。\n"
      "四面是光滑洁白的白玉。瓶口就在你的头上，但是瓶口被封住了。\n"
      "要想出去，除非有人将瓶口打开。\n\n"
      "这里的唯一出口out也被盖子封死了。\n");
    return 1;
  }
}

int do_out() {
  object me;
  me = this_player();
  if (query("close") == 1)
    return notify_fail("瓶口被盖上了，怎么出去？\n");
  write("你从瓶子里爬了出来。身体渐渐恢复了原形。\n");
  remove_call_out("melt_player");
  me->delete_temp("percent");
  me->delele_temp("remain_time");
  me->move(environment(environment(this_object())));
  tell_room(environment(me),
    me->name() + "狼狈的从瓶子里爬了出来。身体渐渐恢复了原形。\n",
    ({ me }));
  return 1;
}

void melt_player(object poor_player) {
  int remain_time;
  remain_time = poor_player->query_temp("remain_time");
  remove_call_out("time_out");
  if (environment(poor_player) != this_object()) {
    remove_call_out("melt_player");
    set("open", 0);  //瓶子关了
    return;
  } else if (remain_time > 0 && poor_player->query_temp("percent") <= 10) {

    tell_object(poor_player, HIR "你觉得自己正在被融化。。。向死神靠近，你不禁急的快要哭了起来。\n" NOR);
    poor_player->add_temp("remain_time", -30);
    poor_player->add_temp("percent", 1);
    call_out("melt_player", 30, poor_player);
  } else {
    tell_object(poor_player, HIR "你觉得自己完全被融化了。。。死神已经来到了你的身旁。\n" NOR);
    poor_player->delete_temp("remain_time");
    poor_player->delete_temp("percent");
    poor_player->die();
    destruct(present("corpse", this_object()));
  }
  return;
}
int do_quit() {
  return notify_fail("你现在在瓶子里面，无法退出。\n");
}
