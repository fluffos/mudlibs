#pragma save_binary
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name( MAG "返老还童丹" NOR, ({ "rejuvenator" }) );
        set_weight(14000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "粒");
                set("long",
                        "这是一粒返老还童丹，用它可以返老还童。\n");
                set("value", 1);
                set("material", "unknow");
        }

}

void init()
{
if (userp(environment(this_object())))
        add_action("do_eat","eat");
}

int do_eat(string arg)
{
        object me;
        me=this_player();
if (arg==query("id"))
        {
        message_vision(CYN"$N一口将手中的返老还童丹吞进了肚子。。。\n"NOR,me);
        write("你只觉得一股热气直冲脑门。。。。。。。。。。。。。\n",me);
        if(me->query("age")>=15)
               me->add("mud_age",-86400);
        me->save();
        remove_action("do_eat","eat");
//        如果要玩家昏迷，那么一定要记得在昏迷之前remove掉action
//     不然不要dest掉玩家身上的物品。
//      如果一定要dest掉，那么就要remove掉前面action
//      天神的忠告。切记！！！切记！！！
//      如果给我发现有人的程序写成了将玩家昏迷，然后又没有
//      remove掉action.那么他一定将面临降职的危险。切记切记！！！！！
        me->unconcious();
        this_object()->dest_it();
        return 1;
        }
else return notify_fail("你要吃什么？\n");
}
int dest_it()
{
        destruct(this_object());
}
