#pragma save_binary
#include <ansi.h>

inherit ITEM;

void create() {
  set_name(MAG "天眼通魔法卷轴" NOR, ({ "chairvoyance" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("long",
      "这是一个天眼通魔法卷轴。用它可以看见你想看的人周围的一切。\n");
    set("value", 1);
    set("material", "unknow");
  }

}
mixed new_use(object me, string arg) {
  object ob, room;
  string name1, name2;
  if (arg) {
    ob = find_living(arg);
    if ((int)me->query("combat_exp") <= (int)ob->query("combat_exp"))
      return notify_fail("你不能查到该人的所在！\n");
    if (wizardp(ob)) return notify_fail("找不到这个生物。。\n");
    if (!ob || ob->query("env/invisibility") >= 1) return "找不到这个生物。。\n";
    if (ob == me) return "自己有什么好看的？";
    room = environment(ob);
    if (!room) return "找不到这个生物。。\n";
    message_vision(BLU "$N拿起手中的卷轴，念了几句咒语，$N手中的卷轴立即放出了蓝色光芒。\n" NOR, me);
    message("vision", BLU "在蓝色的光芒之中，你看到：\n" NOR, me);
    "/cmds/std/look"->look_room(me, environment(ob));
    message("vision", "你感到脖子发凉，黑暗处好像有双眼睛盯着你！\n", ob);
    message("vision", "你仔细地看了一下四周，却什么也没有！\n", ob);
  } else {
    return "指令格式: use chairvoyance to <living>\n";
  }
  return 1;
}
