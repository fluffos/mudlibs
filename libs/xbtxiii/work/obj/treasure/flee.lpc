#include <ansi.h>

inherit ITEM;

void create()
{
        set_name( MAG "瞬间移动卷轴" NOR, ({ "flee_scroll" }) );
        set_weight(14000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "卷");
                set("long",
                        "这是一个瞬间移动的卷轴，有了它不愁遇到强敌时逃不掉。\n");
                set("value", 1);
                set("material", "unknow");
        }

}
mixed new_use(object me,string arg)
{
	me->remove_all_enemy();
	message_vision(HIG"$N念了几句咒语，$N立刻化做一道青光消失的无影无踪。。\n"NOR,me);
	"/cmds/std/go"->do_flee(me);
	return 1;
}
