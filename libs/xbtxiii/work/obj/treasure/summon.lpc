#pragma save_binary
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name( MAG"抓人卷轴"NOR, ({ "summon_scroll" }) );
        set_weight(140);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "卷");
                set("long",
                        "这是一个抓人魔法卷轴。用它可以将任何人抓到你的身边。\n");
                set("value", 1);
                set("material", "unknow");
        }

}
mixed new_use(object me,string arg)
{
        object ob,room;
        string name1, name2;
if(arg)
        {
        ob = find_living(arg);
        if (!ob||ob->query("env/invisibility")>=1) return "找不到这个生物.\n";
        if (ob==me) return "抓自己？？？有病！！！";
        room=environment(ob);
        if (!room) return "找不到这个生物。。\n";
        message_vision(BLU"$N拿起手中的卷轴，念了几句咒语，$N手中的卷轴立即变成一只金色大鸟飞走了。\n"NOR,me);
        tell_room(environment(ob),HIY"天空中飞来一只金色大鸟将"+
                      (string)ob->name()+"叼了起来, 然後就飞走了.\n"NOR, ob);
        tell_object(ob,HIR"天空中飞来一只金色大鸟把叼走了, 你吓的眼前一阵黑....\n");
        ob->move(environment(me));
        tell_object(ob,".... 醒来时发现你已经到了一个陌生的地方.\n");
            tell_room(environment(ob),"瞬间金色大鸟飞了回来，嘴上还叼了一个人，原来是"+ob->name()+"\n",({me,ob}));
        }
else  
        {
        return "指令格式: use summon_scroll to <living>\n";
        }
       return 1;
}
