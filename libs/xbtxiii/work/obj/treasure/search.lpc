#pragma save_binary
#include <ansi.h>

inherit ITEM;

void create() {
  set_name(MAG "寻人卷轴" NOR, ({ "search_scroll" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("long",
      "这是一个寻人魔法卷轴。它可以告知生物的位置。\n");
    set("value", 1);
    set("material", "unknow");
  }

}
mixed new_use(object me, string arg) {
  object ob, room;
  string name1, name2, room_name;
  if (arg) {
    ob = find_player(arg);
    if (!ob || ob->query("env/invisibility") >= 1)
      ob = find_living(arg);
    if (!ob || ob->query("env/invisibility") >= 1) return "找不到这个生物.\n";
    room = environment(ob);
    if (!room) return "找不到这个生物。\n";
    name1 = (string)me->query("name");
    name2 = (string)ob->query("name");
    message_vision(YEL "$N祭起手中的卷轴,默念了几句咒语，$N手中的卷轴立即化做一只黄金鸟飞走了。\n" NOR, me);
    write(
      "\n黄金鸟传回了信息：" + name2 + " (" + ob->query("id") + ") 现在正在——" + room->query("short") + "——\n",
      me
    );
  } else {
    return "指令格式: use search_scroll to <living>\n";
  }
  return 1;
}
