#pragma save_binary
#include <ansi.h>

inherit ITEM;

void create() {
  set_name(MAG "闪电卷轴" NOR, ({ "lightning" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("long",
      "这是一个闪电魔法卷轴。可以用来召唤闪电，请小心使用。\n");
    set("value", 1);
    set("material", "unknow");
  }

}
mixed new_use(object me, string arg) {
  object ob;
  string name1, name2;

  if (!arg) return "指令格式: use lightning to <living>\n";
  ob = present(arg, environment(me));
  if (!ob) return "找不到这个生物.\n";
  if (!living(ob)) return "看清楚，这可不是活物!!\n";
  name1 = (string)me->query("name");
  name2 = (string)ob->query("name");
  tell_room(environment(me),
    name1 + "使用了一个闪电卷轴, 只见天上一道闪电不偏不倚地击中" + name2 + ", 将之化为一堆灰烬.\n",
    ({ me, ob }));
  tell_object(ob, name1 + "使用了一个闪电卷轴!, 只见天上一道闪电不偏不倚地击中你.\n");

  write("你使用了一个闪电卷轴 从天上降下一道闪电将" + name2 + "化作一堆灰烬.\n");
  write("哈～　　～哈　　～哈　　～。　　。　　　。 好爽!\n");
  environment(ob)->add("no_death_penalty", 1);
  ob->die();
  environment(me)->add("no_death_penalty", -1);
  return 1;
}
