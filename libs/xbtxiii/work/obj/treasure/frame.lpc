#pragma save_binary
#include <ansi.h>

inherit ITEM;

void create() {
  set_name(MAG "陷害卷轴" NOR, ({ "frame_scroll" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("long",
      "这是一个可以陷害他人的魔法卷轴。请小心使用。\n");
    set("value", 1);
    set("material", "unknow");
  }

}
mixed new_use(object me, string arg) {
  object ob;
  string name1, name2;

  if (arg) {
    ob = find_player(arg);
    if (!ob) return "这个玩家好象没有在线。.\n";
    if (ob == me) return "想陷害自己？？？有病！！！\n";
    if (ob->query("age") <= 14) return "他还小，你就放过他吧.\n";
    if (ob->is_ghost()) return "他已经死了，你就放过他吧。。\n";
    name1 = (string)me->query("name");
    name2 = (string)ob->query("name");
    tell_room(environment(me),
      name1 + "拿出了一卷卷轴，在卷轴上写了什么东西，然后念了几句咒语。\n"
      "一道蓝色的光芒朝天空中射去，片刻，天空中又恢复了平静，好象什么事情也没有发生。\n",
      ({ me, ob }));
    tell_object(ob, "只见天上一道蓝光不偏不倚地击中你。你被人陷害了。\n"
      "以后会发生你意想不到的事情。\n");

    write("你拿出了一卷卷轴，在卷轴上写上了" + name2 + "的名字，然后念了几句咒语。\n"
      "" + name1 + "被你陷害了。你不禁躲在一旁偷笑。。\n\n", me);
    write("哈～　　～哈　　～哈　　～。　　。　　　。 好爽!\n");
    switch (random(8)) {
      case 0:
        ob->apply_condition("snake_poison", 5 + ob->query_condition("snake_poison"));
        break;
      case 1:
        ob->apply_condition("drunk", 10 + ob->query_condition("drunk"));
        break;
      case 2:
        ob->apply_condition("ice_shock", 5 + ob->query_condition("ice_shock"));
        break;
      case 3:
        ob->apply_condition("killer", 500 + ob->query_condition("killer"));
        break;
      case 4:
        ob->apply_condition("rose_poison", 5 + ob->query_condition("rose_poison"));
        break;
      case 5:
        ob->apply_condition("ss_poison", 5 + ob->query_condition("ss_poison"));
        break;
      case 6:
        ob->apply_condition("xx_poison", 5 + ob->query_condition("xx_poison"));
        break;
      case 7:
        ob->apply_condition("slumber_drug", 5 + ob->query_condition("slumber_drug"));
        break;
    }
  } else {
    return "指令格式: use frame_scroll to <living>\n";
  }
  return 1;
}
