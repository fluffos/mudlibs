#include <ansi.h>

inherit ITEM;

void create()
{
        set_name( MAG "隐身卷轴" NOR, ({ "invisibility" }) );
        set_weight(14000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "卷");
                set("long",
                        "这是一个隐身魔法卷轴。可以使自己暂时隐身。\n");
                set("value", 1);
                set("material", "unknow");
        }

}
mixed new_use(object me,string arg)
{
if (query("use_it")=="ok")
       return "你已经在隐身当中了。\n";
       message_vision(CYN"$N祭起手中的卷轴，片刻之间，$N虚化的无影无踪了。\n"NOR,me);
       me->set("env/invisibility",1);
       set("use_it","ok");
       set("no_drop",1);
       call_out("remove_temp",300,me);
       return "ok!";
}

void remove_temp(object me)
{
       tell_room(environment(me),
       ""+me->name()+"突然不知道从那里冒了出来。\n",({me})); 
       write("你恢复了真身。\n",me);
       me->delete("env/invisibility");
       destruct(this_object());
}
