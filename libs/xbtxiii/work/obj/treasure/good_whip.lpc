#pragma save_binary
// 销魂鞭。

#include <weapon.h>
#include <ansi.h>
inherit F_AUTOLOAD;
inherit WHIP;

void create() {
  set_name(MAG "销魂鞭" NOR, ({ "xiao hun bian", "whip", "bian" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "一条长长的销魂鞭。\n");
    set("value", 100000);
    set("material", "异类金属");
    set("wield_msg", "只听　[啪～　]　的一声脆响。却见$N抽出了一条$n!\n");
    set("unwield_msg", "$N把$n绑在腰间。\n");
    init_whip(120);
  }
  setup();

}


int query_autoload() {
  return 1;
}
