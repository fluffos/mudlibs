#pragma save_binary
#include <ansi.h>

inherit ITEM;

void create() {
  set_name(MAG "火球卷轴" NOR, ({ "fire_ball" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("long",
      "这是一个火球魔法卷轴。请小心使用。\n");
    set("value", 1);
    set("material", "unknow");
  }

}
mixed new_use(object me, string arg) {
  int i;
  object ob;
  string name1, name2;
  if (arg) {
    ob = present(arg, environment(me));
    if (!ob) return "没有这个人。.\n";
    if (ob == me) return "想自杀？还是用suicide -f吧。。\n";
    name1 = (string)me->query("name");
    name2 = (string)ob->query("name");
    tell_room(environment(me),
      name1 + "拿出了一卷卷轴，念了几句咒语。顿时，一串金黄色的火球朝" + name2 + "射去。\n",
      ({ me, ob }));
    tell_object(ob, "" + name1 + "拿出了一卷卷轴，接着念了几句咒语。卷轴立即化做一串\n"
      "金色火球。金色火球从天上朝你飞了过来。\n");

    write("你拿出了一卷卷轴，念了几句咒语，卷轴立即化成一串火球朝" + name2 + "飞去。。\n", me);
    switch (random(2)) {
      case 0:
        tell_room(environment(me), YEL "" + name2 + "立即后跃，躲开了火球。。\n" NOR, ({ ob }));
        tell_object(ob, YEL "你立即后跃，躲开了火球。。。");
        break;
      case 1:
        tell_room(environment(me), YEL "" + name2 + "反应不及，立刻被烧了个焦头焦脸。空气中立即弥漫开了\n"
          "一种奇怪的烧焦的味道。\n" NOR, ({ ob }));
        tell_object(ob, YEL "你反应不及，立刻被烧了个焦头焦脸。。空气中立即弥漫开一种奇怪的烧焦的味道。\n" NOR);
        i = random(300);
        if (ob->query("kee") <= i)
          ob->unconcious();
        else ob->add("kee", -i);
        break;
    }
  } else
    return "指令格式: use fire_ball to <living>\n";
  return 1;
}
