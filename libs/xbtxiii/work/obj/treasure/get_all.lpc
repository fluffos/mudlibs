#pragma save_binary
#include <ansi.h>

inherit ITEM;

void create() {
  set_name(MAG "搜身卷轴" NOR, ({ "get_all" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("long",
      "这是一个搜身魔法卷轴。可以用来搜身(npc)，请小心使用。\n");
    set("value", 1);
    set("material", "unknow");
  }

}
mixed new_use(object me, string arg) {
  object ob;
  object *objects;
  int i, j;

  if (!arg) return "指令格式: use get_all to <living>\n";
  ob = present(arg, environment(me));
  if (!ob) return "找不到这个生物.\n";
  if (userp(ob))
    return "你不可以搜玩家的身！！！\n";
  objects = all_inventory(ob);
  j = sizeof(objects);
  if (j <= 0)
    return "" + ob->name() + "身上什么都没有!!!\n";
  for (i = 0; i < j; ++i) {
    if (objects[i]->query("no_get")) continue;
    objects[i]->move(me);
    message_vision(
      CYN "$N从" + ob->name() + "身上搜出一" + ob->query("unit") + "" + objects[i]->name() + "\n" NOR,
      me
    );
  }
  return 1;
}
