#pragma save_binary
// 相思刀。

#include <weapon.h>
#include <ansi.h>
inherit F_AUTOLOAD;
inherit BLADE;

void create()
{
                set_name(RED"相思刀"NOR,({"xiang si blade","blade"}));
        if(clonep())
                set_default_object(__FILE__);
        else{
             set("unit", "柄");
    set("long", "一柄相思刀\n");
    set("value", 100000);
    set("material", "异类金属");
    set("wield_msg", "$N「唰」地一声从刀鞘里抽出一把$n握在手中。\n");
    set("unwield_msg", "却见$N将手中的$n插入腰间的刀鞘。\n");
    init_blade(120);
    }   
    setup();
        
}

int query_autoload()
{
        return 1;
}
