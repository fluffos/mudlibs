#pragma save_binary
// 惊艳一枪。

#include <weapon.h>
#include <ansi.h>
inherit F_AUTOLOAD;
inherit SPEAR;

void create() {
  set_name(CYN "惊艳一枪" NOR, ({ "jing yan yi qiang", "spear" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "杆");
    set("long", "惊艳一枪。分量不轻。\n");
    set("value", 100000);
    set("material", "异类金属");
    set("wield_msg", "$N把$n挥舞到胸前!\n");
    set("unwield_msg", "$N将手中的$n立在背后。\n");
    init_spear(120);
  }
  setup();

}

int query_autoload() {
  return 1;
}
