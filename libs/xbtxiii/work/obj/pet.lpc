void die() {
  int i;
  object owner, *enemy;
  int gin, kee, sen, exp;
  string msg;
  set("deathstamp", time());
  exp = (int)query("combat_exp");
  gin = (int)query("max_gin");
  kee = (int)query("max_kee");
  sen = (int)query("max_sen");
  if (environment()->query("no_die")) return;
  if (environment()->query("no_death_penalty")) return;
  set("combat_exp", 97 * exp / 100);
  set("eff_kee", kee);
  set("eff_gin", gin);
  set("eff_sen", sen);
  set("kee", kee);
  set("gin", gin);
  set("sen", sen);
  this_object()->skill_death_penalty();  //和玩家的损失一样。
  if (query("obedience") >= 10)
    this_object()->add("obedience", -8);
  if (objectp(owner = query_temp("protecting"))) {
    enemy = query_enemy();
    i = sizeof(enemy);
    while (i--) {
      if (enemy[i] && living(enemy[i])) {
        owner->kill_ob(enemy[i]);
        enemy[i]->kill_ob(owner);
      }
    }

  }

  msg = "\n你的宠物被杀死了\n";
  if (owner && environment(owner)) tell_object(owner, HIR + msg + NOR);
  save();
  ::die();
}

int heal_up() {
  if (!objectp(this_object()->query_temp("protecting"))) {
    save();
    if (environment(this_object()))
      message_vision("$N一闪就不见了。\n", this_object());
    destruct(this_object());
    return 1;
  }

  set_heart_beat(1);
  return ::heal_up();
}

void init() {
  object me;
  me = this_player();
  if (me->query("id") == query("owner")) {
    add_action("do_order", "order");
    add_action("do_modify", "modify");
    add_action("do_gongji", "attack");
    add_action("do_teach", "teach");
    add_action("do_shape", "shape");
  }
  ::init();
}
int do_order(string arg) {
  int obedience;
  object me = this_player();
  if (!arg)
    return notify_fail("你想让你的宠物做什么动作？\n");
  if (me->query("sen") <= 5)
    me->unconcious();
  else me->add("sen", -5);
  obedience = query("obedience");
  if (random(100) < obedience) command("emote " + arg);
  else command("emote 很不情愿地哼了一声。");
  return 1;
}
int do_modify(string arg) {
  string item, msg;
  if (!arg || sscanf(arg, "%s %s", item, msg) != 2)
    return notify_fail("SYNTAX: modify 款项 内容\n");
  if (item == "flee") {
    set("env/wimpy", atoi(msg));
    write("ＯＫ\n");
    save();
    return 1;
  }


  if (CHINESE_D->check_control(msg))
    return notify_fail("描述不可有控制符！\n");
  if (!CHINESE_D->check_chinese(msg))
    return notify_fail("描述必需是中文！\n");
  if (CHINESE_D->check_space(msg))
    return notify_fail("描述必需不含空格！\n");
  if (CHINESE_D->check_return(msg))
    return notify_fail("描述必需不含回车键！\n");
  switch (item) {
    case "desc":
      if (CHINESE_D->check_length(msg) > 100)
        return notify_fail("描述太长！\n");
      set("long", msg + "\n");
      write("ＯＫ\n");
      save();
      return 1;
    case "nickname":
      if (CHINESE_D->check_length(msg) > 20)
        return notify_fail("描述太长！\n");
      set("nickname", msg);
      write("ＯＫ\n");
      save();
      return 1;
    case "title":
      if (CHINESE_D->check_length(msg) > 10)
        return notify_fail("描述太长！\n");
      set("title", msg);
      write("ＯＫ\n");
      save();
      return 1;
    case "arrive_msg":
      if (CHINESE_D->check_length(msg) > 30)
        return notify_fail("描述太长！\n");
      set("arrive_msg", msg);
      write("ＯＫ\n");
      save();
      return 1;
    case "leave_msg":
      if (CHINESE_D->check_length(msg) > 30)
        return notify_fail("描述太长！\n");
      set("leave_msg", msg);
      write("ＯＫ\n");
      save();
      return 1;

  }
  return notify_fail("你要修改什么？\n");

}
int do_gongji(string arg) {
  object me, obj;
  int time;
  me = this_player();
  if (environment(me)->query("no_fight"))
    return notify_fail("这里不准战斗。\n");

  if (!arg)
    return notify_fail("你想让你的宠物攻击谁？\n");

  if (!objectp(obj = present(arg, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (!obj->is_character() || obj->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");
  if (userp(obj) && !wizardp(me)) {
    time = (int)obj->query("mud_age");
    time /= 3600;
    if (time <= 8)     //mud age <= 8 hours
      return notify_fail("你连小孩子也要杀么?太心狠手辣了吧!\n");
    time = (int)me->query("mud_age");
    time /= 3600;
    if (time <= 1) return notify_fail("江湖险恶,小孩子还是谨慎为妙!\n");
  }
  if ((obj->name() == "匆匆过客") && userp(obj))
    return notify_fail("你的宠物没有被赋予攻击特殊玩家的权利。\n");
  if (obj->query_temp("netdead"))
    return notify_fail("你不能这样无耻的攻击断线的人.\n");
  if (obj->is_killing(this_object()))
    return notify_fail("你对" + this_object()->name() + "喊道：加油！加油！加油！\n");

  message_vision(
    sprintf("$N对$n一指，对%s命令道：＂上！＂\n", this_object()->name()), me, obj);
  if (me->query("sen") <= 5)
    me->unconcious();
  else me->add("sen", -5);
  if (query("sen") <= 10)
    this_object()->unconcious();
  else add("sen", -10);
  if (random(100) > query("obedience"))
    command("emote 很不情愿地哼了一声。");
  else kill_ob(obj);
  return 1;

}

int do_teach(string arg) {
  object me;
  int gin_cost, amount;
  int myskill, itskill;
  me = this_player();
  if (!myskill = me->query_skill(arg, 1))
    return notify_fail("这项技能你好象还不会呢！\n");
  if (arg != "unarmed" && arg != "move" && arg != "dodge")
    return notify_fail("它学不会这项技能的！\n");
  itskill = query_skill(arg, 1);
  if (myskill <= itskill)
    return notify_fail(name() + "以嘲笑的目光望着你。\n");
  if ((int)me->query("potential") - (int)me->query("learned_points") < 1)
    return notify_fail("你的潜能不够！\n");
  gin_cost = 100 / (int)query_int();
  if ((int)me->query("gin") < gin_cost)
    return notify_fail("你显然太累了没有办法教！\n");
  if ((int)query("gin") < 10 || (int)query("kee") < 10 || (int)query("sen") < 10)
    return notify_fail("你的宠物现在快要累死了！\n");
  me->receive_damage("gin", gin_cost);
  me->add("potential", -1);
  this_object()->add("gin", -1);
  amount = random((int)me->query_int() * (int)query_int()) + 1 + (int)me->query_int() * 2;
  message_vision(sprintf("$N不厌其烦地教$n「%s」。\n", to_chinese(arg)), me, this_object());
  if (random(30) > query("obedience"))
    command("emote 很不情愿地哼了一声。");
  else {
    this_object()->improve_skill(arg, amount);
    message_vision(sprintf("$N似乎真的学会了一些「%s」！\n", to_chinese(arg)), this_object());
    this_object()->save();
  }
  return 1;

}

string status_color(int current, int max) {
  int percent;

  if (max > 0) percent = current * 100 / max;
  else percent = 100;
  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}
int do_shape(string arg) {
  mapping my;
  //      string shape;
  int at_pt, pa_pt, do_pt;
  my = query_entire_dbase();
  printf("精：%s%3d/ %3d %s(%3d%%)" NOR "  气：%s%3d/ %3d %s(%3d%%)" NOR "  神：%s%3d/ %3d %s(%3d%%)\n" + NOR,
    status_color(my["gin"], my["eff_gin"]), my["gin"], my["eff_gin"],
    status_color(my["eff_gin"], my["max_gin"]), my["eff_gin"] * 100 / my["max_gin"],
    status_color(my["kee"], my["eff_kee"]), my["kee"], my["eff_kee"],
    status_color(my["eff_kee"], my["max_kee"]), my["eff_kee"] * 100 / my["max_kee"],
    status_color(my["sen"], my["eff_sen"]), my["sen"], my["eff_sen"],
    status_color(my["eff_sen"], my["max_sen"]), my["eff_sen"] * 100 / my["max_sen"]
  );
  printf("主人： %s\t\t经验： %d\t\t杀气： %d\n",
    my["owner"], my["combat_exp"], my["bellicosity"]
  );
  printf("才智： %d\t\t体质： %d\t\t体态： %d\n",
    query_int(), query_con(), query_per()
  );
  printf("凶性： %d\t\t力量： %d\t\t耐力： %d\n",
    query_cor(), query_str(), query("fle")
  );
  printf("速度： %d\t\t个性： %d\t\t定性： %d\n",
    query("agi"), query("tol"), query("dur")
  );
  at_pt = COMBAT_D->skill_power(this_object(), "unarmed", SKILL_USAGE_ATTACK);
  pa_pt = COMBAT_D->skill_power(this_object(), "unarmed", SKILL_USAGE_DEFENSE);
  do_pt = COMBAT_D->skill_power(this_object(), "dodge", SKILL_USAGE_DEFENSE);
  printf("攻击力： %d\t\t\t\t防御力： %d\n\n",
    at_pt + 1, pa_pt / 2 + do_pt / 2 + 1
  );
  printf("/cmds/usr/skills"->pet_skill(this_object()));
  return 1;
}
void unconcious() {
  die();
}

int accept_object(object me, object obj) {
  string msg;
  int food, water;
  if (me->query("id") != query("owner"))
    return 0;
  if (obj->query("food_supply")) {
    if (this_object()->query("food") > this_object()->max_food_capacity())
      return 0;
    food = obj->query("food_supply") * obj->query("food_remaining");
    this_object()->add("food", food);
    msg = "$N给了$n一" + obj->query("unit") + "" + obj->name() + "\n"
      "$n高兴的吃了起来。\n";
    message_vision(msg, me, this_object());
    return 1;
  } else if (obj->query("liquid/type")) {
    if (this_object()->query("water") > this_object()->max_water_capacity())
      return 0;
    if (obj->query("liquid/drunk_apply")) water = obj->query("liquid/remaining");
    water = obj->query("liquid/remaining") * obj->query("liquid/drunk_apply");
    this_object()->add("water", water);
    msg = "$N给了$n一" + obj->query("unit") + "" + obj->name() + "\n"
      "$n高兴的喝了起来。\n";
    message_vision(msg, me, this_object());
    return 1;
  }
  return 0;
}

void killed_enemy(object victim) {
  object owner;
  owner = this_object()->query_temp("protecting");
  if (!objectp(owner)) {
    save();
    if (environment(this_object()))
      message_vision("$N一闪就不见了。\n", this_object());
    destruct(this_object());
    return;
  }
  if (userp(victim)) {
    owner->add("PKS", 1);  //宠物杀人，帐算在主人身上
    owner->save();
  }
  return;

}
