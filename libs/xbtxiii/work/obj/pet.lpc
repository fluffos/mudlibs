#include <ansi.h>
#include <combat.h>
// #include <skill.h>

inherit NPC;
inherit F_SAVE;
// inherit F_SKILL;
inherit F_UNIQUE;
void create() {
  seteuid(getuid());
  set_name("宠物", ({ "pet" }));
  set("race", "野兽");
  if (!restore()) {
    set("age", 5);
    set("str", 10);
    set("cor", 5);
    set("int", 5);
    set("spi", 10);
    set("cps", 5);
    set("per", 5);
    set("con", 5);
    set("agi", 5);
    set("dur", 5);
    set("fle", 5);
    set("tol", 5);
    set("max_gin", 80);
    set("max_kee", 80);
    set("max_sen", 80);
    set("long", "一只小小小小宠物。\n");
    set("owner", "R");
    set("limbs", ({ "头部", "身体", "前心", "後背", "尾巴" }));
    set("verbs", ({ "bite", "claw" }));
    set("obedience", 2);
    set("combat_exp", 100);
  }
  setup();
}
string query_save_file() {
  string id;

  id = query("owner");
  if (!stringp(id)) return 0;
  return sprintf(DATA_DIR "pet/%c/%s", id[0], id + ".o");
}
