#pragma save_binary
// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
    set_name("橘子汤", ({ "juzitang" }) );
	set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        set("long", "一袋橘子汤。\n");
        set("unit", "袋");
		set("value", 20);
		set("max_liquid", 10);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "water",
        "name": "橘子汤",
		"remaining": 10,
		"drunk_apply": 6,
	]) );
}
