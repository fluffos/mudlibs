#pragma save_binary
// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("茶水壶", ({ "super teapot" }) );
	set_weight(15400);//按比例计算的
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个超级大的茶水壶。\n");
		set("unit", "个");
		set("value", 500);
		set("max_liquid", 15);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "water",
		"name": "茉莉花茶",
		"remaining": 1,
		"drunk_apply": 2000,
	]) );
}
