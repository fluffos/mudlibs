#pragma save_binary
// dumpling.c 包子

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("羊肉", ({ "yang rou" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一串香喷喷的羊肉。\n");
    set("unit", "串");
    set("value", 15);
    set("food_remaining", 3);
    set("food_supply", 20);
  }
}
