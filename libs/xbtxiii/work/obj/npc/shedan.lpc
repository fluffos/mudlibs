#pragma save_binary

inherit ITEM;

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("腹蛇胆", ({ "shedan", "dan" }));
  set("unit", "只");
  set("long", "这是一只绿莹莹的蝮蛇胆，是制备毒药的原料。\n");
  set("value", 800);
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  return notify_fail("你找死啊。\n");
}
