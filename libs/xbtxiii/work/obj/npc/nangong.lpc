#pragma save_binary
#pragma save_binary

// By Evilgod.

#include <ansi.h>

inherit NPC;
#ifndef NPCDATA
#define NPCDATA "/data/npc/"
#endif
#define PKMASTER NPCDATA + "shashou"
inherit F_CLEAN_UP;
inherit F_SAVE;

string query_save_file() {
  return PKMASTER;
}

void create() {
  seteuid(getuid());
  set_name("南宫无恨", ({ "nangong wuhen", "nengong", "wuhen" }));
  if (!restore()) {
    set("title", "无情楼楼主");
    set("long",
      "南宫无恨是无情楼的楼主，他专门替一些无能力自己报仇的人\n"
      "主持公道，同时也替人清除一些妨碍他人的武林败类，当然，\n"
      "为了维持无情楼的收支，你要付一些费用。\n");
    set("gender", "男性");
    set("no_clean_up", 1);

    // This is the initial apply for his race.              
    set("perm_apply", ([
      "attack": 25,
      "dodge": 25,
      "damage": 25,
    ]));
    set("pk_quest0", ([
      "wantedid": "none",
      "bonus": 999990000,
      "time": 1234567,
      "owner": "evilgod",
    ]));
    set("order", 1);

    set("age", 44);
    set("str", 40);
    set("cor", 24);
    set("cps", 18);
    set("per", 24);
    set("int", 42);

    set_skill("unarmed", 50);
    set_skill("dodge", 50);
    set_skill("force", 50);
    set_skill("parry", 50);
  }
  set("inquiry", ([
    "无情楼": "我的无情楼是天下最大的杀手组织，我看你也很有杀手的天分，\n"
    "不如也加入我们(join wuqinglou)\n",
    "杀手": "你是想加入我的组织(join wuqinglou)，还是要雇佣杀手\n",
    "加入": "你想要加入我的组织(join wuqinglou)，很好，很好。\n",
  ]));
  set_temp("apply", query("perm_apply"));
  setup();
  carry_object("/obj/cloth")->wear();
}


void reset() {

  seteuid(getuid(this_object()));

  save();
}


int accept_fight(object who) {
  say(CYN "南宫无恨摇摇头，说道：你不是我的对手，别自找死路了...\n" NOR);
  return 0;
}

void init() {
  ::init();
  add_action("get_pkquest", "want");
  add_action("list_pkquest", "list");
  add_action("report_quest", "report");
  add_action("do_join", "join");
}
int do_join(string arg) {
  object who, paper;
  who = this_player();
  if (who->query("wuqinglou"))
    return notify_fail("你已经是自己人了，不用再申请!!\n");
  if (arg != "wuqinglou" && arg != "无情楼") return 0;
  command("pat " + who->query("id"));
  command("say 很好，跟着我干，你绝对不会后悔。");
  command("say 这里是一份杀手守则，你要好好看看，对你有很大帮助。");
  carry_object(__DIR__ "obj/shouze");
  command("give " + who->query("id") + " shouze");
  who->set("wuqinglou", 1);
  return 1;
}
int list_pkquest(string arg) {
  string list;
  int i;

  if (query("order") == 0 || !this_player()->query("wuqinglou")) return 0;
  if (arg && !this_object()->id(arg)) return 0;
  printf("你可以申请以下的任务：\n");
  for (i = 0; i < query("order"); i++)
    printf("%d \t%s  \t\t：%d两黄金\n",
      i + 1, query(sprintf("pk_quest%d", i))["wantedid"],
      query(sprintf("pk_quest%d", i))["bonus"] / 10000);
  return 1;
}
int get_pkquest(string arg) {
  int k;
  object me, ob;
  me = this_player();

  if (!me->query("wuqinglou")) return 0;
  if (query("order") == 0) return 0;
  if (!arg || sscanf(arg, "%d", k) != 1) k = 1;
  if (k < 1 || k > query("order")) return 0;
  if (!arg) return notify_fail("你要领杀谁的任务?\n");
  me->set("pkquest", query(sprintf("pk_quest%d", k - 1))["wantedid"]);
  me->set("pknum", query(sprintf("pk_quest%d", k - 1))["time"]);
  me->delete("pkfinishquest");
  tell_object(me, "好，你尽快提他的人头来见我。\n");
  if (!objectp(present("skinmask", me)))
    if (objectp(ob = new(__DIR__ "obj/mask"))) {
      ob->move(me);
      command("say 为方便你完成任务，这个面罩给你。");
    }
  return 1;
}
int report_quest(string arg) {
  object me, ob;
  int i, flag;

  me = this_player();
  if (!me->query("pkquest") || !me->query("pkfinishquest")) {
    tell_object(me, "你说些什么，我听不懂。\n");
    return 1;
  }
  flag = 0;
  if (query("order") == 0) return 0;
  for (i = 0; i < query("order"); i++)
    if (query(sprintf("pk_quest%d", i))["wantedid"] == me->query("pkquest"))
      flag = i + 1; ;
  me->delete("pkquest");
  me->delete("pknum");
  me->delete("pkfinishquest");
  if (flag == 0) {
    tell_object(me, "南宫无恨摇摇头，叹口气说：你来的太慢了，金子都给别人拿走了\n");
    return 1;
  }
  command("smile");
  tell_object(me, "南宫无恨说：好，这是给你的金子。拿去吧！\n");
  ob = new(GOLD_OB);
  ob->set_amount(query(sprintf("pk_quest%d", flag - 1))["bonus"] / 10000);
  ob->move(me);
  set(sprintf("pk_quest%d", flag),
    query(sprintf("pk_quest%d", query("order"))));
  add("order", -1);
  reset();
  return 1;

}

int accept_object(object who, object ob) {
  who->add("pkmoney", ob->value());
  if (who->query("pkmoney") < 100000) {
    command("say 就这么点钱，怕不够用的......");
    return 1;
  }
  command("say 好，告诉我他是谁，我派最好的杀手去给你干掉他。");
  command("grin " + who->query("id") + "");
  return 1;
}
int relay_whisper(object who, string want) {
  int i, flag;
  if (!FINGER_D->acquire_login_ob(want))
    return command("say 谁啊？怎么好象没听说过有这个人。");
  i = query("order");
  flag = 0;
  while (i--)
    if (query(sprintf("pk_quest%d", i))["wantedid"] == want) flag = i + 1;
  if (!flag) {
    if (who->query("pkmoney") < 100000) {
      command("say 这么点钱就想要人的命？"); return 0;
    }
    set(sprintf("pk_quest%d", query("order")),
      ([ "wantedid": want,
        "bonus": who->query("pkmoney"),
        "time": time(),
        "owner": who->query("id"),
      ]));
    add("order", 1);
    command("chat* grin");
  } else {
    add(sprintf("pk_quest%d/bonus", flag - 1), who->query("pkmoney"));
    if (who->query("pkmoney") > 0)
      command("say 既然你也要杀他，那我会找个更好的人来干掉他。");
  }
  reset();
  who->delete("pkmoney");
  return 1;
}
