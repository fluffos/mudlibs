#pragma save_binary
#pragma save_binary
#include <ansi.h>
void backattack(object owner);
inherit NPC;
void create() {
  string *name = ({ "黄眉蛇", "乌梢蛇", "土公蛇", "火赤练蛇", "眼镜蛇", "银环蛇", "竹叶青", "五步蛇", "蝮蛇", "白花蛇", "花斑蛇" });
  set_name("" + name[random(11)] + "", ({ "snake" }));
  set("title", HIR "巨毒无比" NOR);
  set("long", "一条" + name() + ",脑袋成三角状，一看就知道它的毒性非常厉害。\n");
  set("age", 20);
  set("race", "野兽");
  set("str", 40);
  set("max_sen", 800);
  set("sen", 800);
  set("combat_exp", 500000);
  set("cor", 30);
  set("per", 5);
  set("limbs", ({ "头部", "七寸", "尾巴" }));
  set("verbs", ({ "bite" }));
  setup();
}

void invocation(object who) {
  object *enemy;
  object me;
  int skill, i;

  me = this_object();
  set("possessed", who);
  skill = who->query_skill("qu-she-shu", 1);

  me->set("owner", who);
  set_temp("apply/parry", 100 + skill);
  me->set_temp("apply/dodge", 100 + skill);
  me->set_temp("apply/unarmed", 100 + skill);
  i = skill / 2;
  set("combat_exp", 500000 + random(i * i * i));

  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      if (userp(enemy[i])) enemy[i]->fight_ob(this_object());
      else enemy[i]->kill_ob(this_object());
    }
  }
  set_leader(who);
}

void backattack(object owner) {
  int i;
  object *enemy;
  if (objectp(owner)) {
    enemy = all_inventory(environment());
    i = sizeof(enemy);
    while (i--) {
      if (enemy[i] && living(enemy[i])
        && enemy[i]->is_fighting(this_object())
        && enemy[i]->is_killing(this_object()->query("id"))
        && !enemy[i]->query_temp("disable_command")) {
        owner->kill_ob(enemy[i]);
        enemy[i]->kill_ob(owner);
      }
    }

  }

}


int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  object owner;
  message("vision", HIY + name() + "慢慢游走了。。\n" NOR,
    environment(), this_object());
  if (objectp(owner = this_object()->query("owner")))
    owner->add_temp("havecalled", -1);
  destruct(this_object());
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  message("vision", CYN "你觉得身体的某个部位一阵巨痛，仔细一看，原来被毒蛇咬中了。。\n" NOR, victim);
  victim->apply_condition("snake_poison", (int)victim->query_condition("snake_poison") + random(3));
}

void die() {
  object owner, shedan;
  owner = this_object()->query("owner");
  if (objectp(owner))
    owner->add_temp("havecalled", -1);
  backattack(owner);
  if (this_object()->query("name") == "蝮蛇") {
    shedan = new(__DIR__ "shedan");
    shedan->move(environment(this_object()));
  }
  ::die();
}
