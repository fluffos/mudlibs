#pragma save_binary
#ifndef NPCDATA
#define NPCDATA "/data/npc/"
#endif
#define GIFT NPCDATA + "GIFT"
inherit NPC;
inherit F_SAVE;

#include <ansi.h>

string query_save_file() {
  return GIFT;
}

void create() {

  set_name("蓉蓉", ({ "rongg" }));
  set("nickname", BMAG + HIC "礼物大使" NOR);
  if (!restore()) {
    set("str", 30000);
    set("gender", "女性");
    set("combat_exp", 50000000);
    set("str", 100000);
    set("per", 30);
    set("age", 20);
    set("long", "礼物大使!如果你说声“儿童节快乐”她就会给你礼物！\n");
  }
  setup();
  carry_object("/obj/skirt")->wear();
}

int init() {
  add_action("do_say", "say");
}
int do_say(string arg) {
  string temp_skill;
  string *skills, *persons, *ip;
  mapping sname;
  object gold, me, link;
  int j;
  me = this_player();

  if (arg == "儿童节快乐" || arg == "儿童节快乐！") {
    command("say hehe");
    command("say 祝" + me->name() + " " + me->query("id") + " 儿童节快乐！ ");
    if (me->query("mud_age") <= 43200) {
      tell_object(me, "你太小了。所以没有礼物派。呵呵\n");
      return 1;
    }
    if (me->query("mud_age") >= 172800) {
      tell_object(me, "你不是儿童了。所以没有礼物派。呵呵\n");
      return 1;
    }
    persons = query("persons");
    if (!persons) persons = ({});
    if (member_array(me->query("id"), persons) != -1)
      return 1;
    ip = query("ip");
    if (!ip) ip = ({});
    link = me->query_temp("link_ob");
    if (!link) return notify_fail("你这个人物的资料有些问题。\n");
    if (query_ip_number(link) != "172.21.24.100"
      && member_array(query_ip_number(link), ip) != -1)
      return 1;

    command("say 这是你的礼物。请收下！");
    gold = new(GOLD_OB);
    gold->set_amount(100);
    gold->move(me);
    tell_object(me, "天神送给了你100 两黄金!\n");
    persons += ({ me->query("id") });
    set("persons", persons);
    this_object()->save();
    sname = me->query_skills();
    if (!sname)
      return 1;
    skills = keys(sname);
    temp_skill = "force";
    for (j = 0; j < sizeof(skills); ++j) {
      if (me->query_skill(skills[j], 1) > me->query_skill(temp_skill, 1))
        temp_skill = skills[j];
      else continue;
    }
    me->set_skill(temp_skill, me->query_skill(temp_skill, 1) + 1);
    tell_object(me, "你的" + to_chinese(temp_skill) + "进步了。\n");
    return 1;
  } else return 0;
  return 1;
}
