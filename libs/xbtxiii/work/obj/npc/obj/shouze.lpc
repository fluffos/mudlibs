#pragma save_binary

inherit ITEM;
#include <ansi.h>

void create() {
  set_name("杀手守则", ({ "shouze" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "杀手守则。\n\n"
      "杀手可以在楼主旁边用以下指令\n"
      "list  :格式 list\n\t列出本楼已经收了定金的暗杀任务。\n"
      "want  :格式 want XX\n\t申请执行第XX号暗杀任务。\n"
      "report:格式 report\n\t向楼主报告暗杀任务执行成功。\n"
      "\n在申请任务时，可以得到一个蒙面的面罩，装备后可以掩饰身份.\n"
      "以方便你的行动。"
      "\n");
    set("material", "paper");
  }
}
