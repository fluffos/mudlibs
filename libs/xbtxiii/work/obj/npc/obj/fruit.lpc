#pragma save_binary
// /d/fy/obj/fruit.c 智慧果。泥潭万事通的东西。

inherit ITEM;
inherit F_FOOD;
void create()
{
        set_name("智慧果", ({"fruit"}));
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long","这是一青色的智慧果。听说吃了它可以使人变的更聪明。\n");
                set("really_fruit","yes");// 泥潭万事通接受它时会以此为证。
                set("value",100);
                set("food_remaining", 1);
                set("food_supply", 1);
             }
}

