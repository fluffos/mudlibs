#pragma save_binary
// ticket.c
// 此物件是店小二专用之物件。不得随便复制

inherit ITEM;
#include <ansi.h>

void create() {
  set_name("购物券", ({ "ticket" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "这是一张购物券。凭此购物券，可以在当铺里\n"
      "免费购物一次\n");
    set("material", "paper");
    set("value", 1);
  }
}
