#pragma save_binary
// golden_staff.c

#include <weapon.h>

inherit STAFF;

void create() {
  set_name("金刚杖", ({ "golden staff" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把闪闪发著金光的刚杖。\n");
    set("value", 3400);
    set("material", "gold");
  }
  init_staff(80);

  // These properties are optional, if you don't set them, it will use the
  // default values.

  set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n放在了背后。\n");

  // The setup() is required.

  setup();
}
