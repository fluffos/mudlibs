// #pragma save_binary
// boss.c 和此人物相关的物件和npc分别是/obj/和/npc/目录下的ticket.c waiter.c

inherit NPC;
#include <ansi.h>

void create() {
  set_name("小店老板", ({ "boss" }));
  set("gender", "男性");
  set("age", 50);
  set("long", "小店老板长的胖胖的，五十多岁的人早就发福了.\n"
    "肚子大的自己低头都看不见自己的脚。\n");
  setup();
  add_money("silver", 10);
  carry_object("/obj/cloth")->wear();
}

int accept_object(object me, object ob) {
  int i;
  object prize;
  me = this_player();
  if (ob->query("id") == "ticket" && ob->query("really_ticket") == "yes") {
    switch (ob->query("shoppers")) {
      case 10: i = 10; break;
      case 100: i = 100; break;
      case 500: i = 500; break;
      case 1000: i = 1000; break;
      case 5000: i = 5000; break;
      case 10000: i = 10000; break;
    }
    message_vision(CYN "小店老板接过$N手中的购物券说道:这不是我们小店的购物券吗?\n"
      "小店老板继续道:呵呵。我们小店开店已经有几十年了，算得上老字号了!\n"
      "为了感谢大家对我们小店的支持。我们举办了这一次有奖购物大酬宾活动\n"
      "决定重奖我们小店新开张之后第" + i + "名到我们小店购买货物的幸运儿.\n"
      "恭喜$N成为我们第" + i + "名顾客。这里是我们小店的奖品" + i + "两白银。请笑纳。\n" NOR, me);
    if (i < 1000) {
      this_object()->add_money("silver", i);
      command("give " + me->query("id") + " silver");
    } else {
      this_object()->add_money("thousand-cash", i / 1000);
      command("give " + me->query("id") + " cash");
    }
    if (i >= 10000) {
      tell_object(me, "以下是你可以选择的武器类型：\n"
        "1:  剑(sword)\n"
        "2:  刀(blade)\n"
        "3:  鞭(whip)\n"
        "4:  棍(stick)\n"
        "5:  杖(staff)\n"
        "6:  锤(hammer)\n"
        "7:  枪(spear)\n"
        "q:  不要\n");
      input_to("choose_weapon", 1, me);
      return 1;
    }
    switch (random(16)) {
      case 0:
        prize = new("/obj/treasure/lightning");
        break;
      case 1:
        prize = new("/obj/treasure/frame");
        break;
      case 2:
        prize = new("/obj/treasure/chairvoyance");
        break;
      case 3:
        prize = new("/obj/treasure/search");
        break;
      case 4:
        prize = new("/obj/treasure/fire_ball");
        break;
      case 5:
        prize = new("/obj/treasure/fly");
        break;
      case 6:
        prize = new("/obj/treasure/invisibility");
        break;
      case 7:
        prize = new("/obj/treasure/sword");
        break;
      case 8:
        prize = new("/obj/treasure/disguise");
        break;
      case 9:
        prize = new("/obj/treasure/rejuvenator");
        break;
      case 10:
        prize = new("/obj/treasure/heal_scroll");
        break;
      case 11:
        prize = new("/obj/treasure/teapot");
        break;
      case 12:
        prize = new("/obj/treasure/bottle");
        break;
      case 13:
        prize = new("/obj/treasure/spear");
        break;
      case 14:
        prize = new("/obj/treasure/get_all");
        break;
      case 15:
        prize = new("/obj/treasure/leg");
        break;
    }
    prize->move(me);
    message_vision(CYN "小店老板说道： 这个东西叫" + prize->name() + "，乃当年天神寄存在我这里的宝物。\n"
      "小店老板说道: 天神还嘱咐我，将宝物送于有缘人，现在我就将它转送给$N。\n"
      "小店老板说道: 天神还让我转告有缘人一句话:小心使用宝物，切记切记。。。\n" NOR, me);
    command("say 多谢光临!!!");
    return 1;
  } else {
    command("say 这位" + RANK_D->query_respect(me) + ",的好意在下心领了.");
    command("say 我不能接受您的礼物,谢了 !!!");
    return 0;
  }
}


int choose_weapon(string arg, object me) {
  object weapon;
  if (!arg) {
    input_to("choose_weapon", 1, me);
    return 1;
  }
  switch (arg) {
    case "1":
      weapon = new("/obj/treasure/good_sword");
      break;
    case "2":
      weapon = new("/obj/treasure/good_blade");
      break;
    case "3":
      weapon = new("/obj/treasure/good_whip");
      break;
    case "4":
      weapon = new("/obj/treasure/good_stick");
      break;
    case "5":
      weapon = new("/obj/treasure/good_staff");
      break;
    case "6":
      weapon = new("/obj/treasure/good_hammer");
    case "7":
      weapon = new("/obj/treasure/good_spear");
      break;
    case "q":
      tell_object(me, "你不要啊？不要就算了！\n");
      return 1;
    default:
      tell_object(me, "以下是你可以选择的武器类型：\n"
        "1:  剑(sword)\n"
        "2:  刀(blade)\n"
        "3:  鞭(whip)\n"
        "4:  棍(stick)\n"
        "5:  杖(staff)\n"
        "6:  锤(hammer)\n"
        "7:  枪(spear)\n"
        "q:  不要\n");
      input_to("choose_weapon", 1, me);
      return 1;
  }
  weapon->move(me);
  message_vision(CYN "小店老板说道： 这个东西叫" + weapon->name() + "，乃当年天神寄存在我这里的宝物。\n"
    "小店老板说道: 天神还嘱咐我，将宝物送于有缘人，现在我就将它转送给$N。\n"
    "小店老板说道: 天神还让我转告有缘人一句话:小心使用宝物，切记切记。。。\n" NOR, me);
  command("say 多谢光临!!!");
  return 1;
}
