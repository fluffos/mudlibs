#pragma save_binary
#pragma save_binary
#ifndef NPCDATA
#define NPCDATA "/data/npc/"
#endif
#define CASHIER NPCDATA + "cashier"
inherit NPC;
inherit F_SAVE;

#include <ansi.h>

string query_save_file()
{
        return CASHIER;
}
int ask_me();
int check_money(object me,int rank);

void create()
{
        seteuid(getuid());
        set_name("李莲英", ({ "li lianying","lianying","ying" }) );
     if(!restore())
                {
        set("title",CYN"大总管"NOR);
        set("gender", "男性" );
        set("age", 33);
        set("long", "此人掌管官府的财政收入。所有官府的人可以在他这里领取官饷\n");
        }        
        set("inquiry",([
                        "官饷":          (:ask_me:),
                        "wages":         (:ask_me:),    
                ]));
        setup();
        carry_object("/obj/cloth")->wear();
}

void init()
{
                object me;
                me=this_player();
if(userp(me))
                call_out("greeting",1,me);

}

void greeting(object me)
{
                command("say 这个月的官饷又快要发了!!!");

}

int ask_me()
{
                object me,silver;
                int rank,mud_age,wages;
                me=this_player();
                mud_age=me->query("mud_age");
                                rank=me->query("rank");
if(me->query("family/family_name")!="朝廷")
                {
                command("say 滚！！！你这个"+RANK_D->query_rude(me)+"老子没有工夫和你闲聊！！！");
                return 1;
                }
else
                command("say 你等一下，让我查查帐。。。。");
if((wages=check_money(me,rank))>0)
                {
                this_object()->set(me->query("id"),mud_age);
                command("say 恩。找到了，这是你的官饷。。。给你。。。");
                if(wages/100)
                      {
                      silver = new(GOLD_OB);
                      silver->set_amount(wages/100);
                          silver->move(me);                               
                      wages %= 100;   
                      }
                if(wages)
                      {
                      silver = new(SILVER_OB);
                      silver->set_amount(wages%100);
                      silver->move(me);       
                      }
                save();
                }
else
        command("say 你好象还不到时间领官饷吧。。。过一段时间再来吧！！！");
                return 1;
}
 
int check_money(object me,int rank)
{
                int wages,mud_age,last_time,month;
                mud_age=me->query("mud_age");
                last_time=this_object()->query(me->query("id"),last_time);

if((month=(mud_age-last_time))>7200)
                {
                month=month/7200;
                switch(rank)
                          {     
                          case 7:
                                wages=month*50;
                            break;              
                          case 6:
                                wages=month*70;
                            break;              
                          case 5:
                                wages=month*90;
                            break;              
                          case 4:
                                wages=month*110;
                            break;              
                          case 3:
                                wages=month*130;
                            break;              
                          case 2:
                                wages=month*150;
                            break;              
                          case 1:
                                wages=month*200;
                            break;              
                          default:
                                ;
                                break;    
                          }     
                return wages;
                }
else return -1;         
}

