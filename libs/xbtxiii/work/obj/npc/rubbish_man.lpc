#pragma save_binary
// 此人除了负责清除垃圾之外还要负责呼叫/obj/npc/lottery.c
#ifndef NPCDATA
#define NPCDATA "/data/npc/"
#endif
#define RUBBISH_MAN NPCDATA + "rubbish_man"
inherit NPC;
inherit F_SAVE;

#include <ansi.h>

string query_save_file()
{
        return RUBBISH_MAN;
}

string *roomfile;
void create()
{
        string file;
        set_name("垃圾清洁工",({"rubbish_man"}));
        if(!restore())
        {
        set("str",1);
        set("combat_exp",50000000);
        set("per",30);
        set("long","此人专门负责清理雄霸天下II里面玩家遗留下来的垃圾!\n");
        set("no_shown",1);
        set("last_time",time());
        }
        setup();               
        carry_object("/obj/cloth")->wear();
		file = read_file("/obj/npc/room_location");
        //if(!file) tell_object(find_player("rongg"),"can not find file");
        roomfile = explode(file,"\n"); 
        
}

int init()
{
        int time;
        time = time();
        ::init();
        if(!query_temp("start_work")){
            remove_call_out("do_work");
            call_out("do_work",1);
            set_temp("start_work",1);        
        }
        if(time>=query("last_time")&&time>=(query("last_time")+604800)) // 隔七天开一次奖
        {
            this_object()->set("last_time",time());
            call_out("rong_er",1); // 呼叫蓉儿开奖。
        }
        if(time<query("last_time"))   set("last_time",time);
}


int do_work()
{

        object *obj;
        object room;
        string file,*other_room;
        int i;
        remove_call_out("do_work");
        other_room=({"/d/fy/fysquare","/d/fy/gameroom","/d/fy/chatroom",
                     "/d/fy/chatroom1","/d/fy/chatroom2","/d/fy/chatroom3",
                     "/d/fy/chatroom4","/d/fy/chatroom5","/d/fy/gameroom2",
                     "/d/fy/gamebox21",
                     });
        file=roomfile[random(sizeof(roomfile))];
        room=find_object(file);
        if(!objectp(room))
        {
            file=other_room[random(sizeof(other_room))];
            room=find_object(file);
        }
        if(!objectp(room)){call_out("do_work",20); return 1;}
        
        obj=all_inventory(room);
        for(i=0;i<sizeof(obj);i++)
        {
        	if(obj[i]->query("id")=="silver cart"&&obj[i]->is_container())
        	{
        		if(!obj[i]->query("owner")||obj[i]->query("owner")==0)
        		{
            		// tell_object(find_player("rongg"),"我把"+obj[i]->name()+"删除了。\n");
                	destruct(obj[i]);
                	continue;        
            	};
        	}
        	if(obj[i]->query("task")) //使命物品
                continue;
        	if(obj[i]->query("money_id")) // 钱
                continue;
        	if(obj[i]->is_corpse()) // 尸体自己会消失
               continue;
        	if(obj[i]->query_autoload()) // 这种东西不能dest
                continue;
        	if(obj[i]->is_character()) 
                continue; //npc不清
        	if(obj[i]->is_container()) //容器不清
                continue;
        	if(obj[i]->query("board_id")) //留言版不能清
                continue;
			//tell_object(find_player("rongg"),"我把"+obj[i]->name()+"删除了。\n");
        	destruct(obj[i]);
        }
		reclaim_objects();//清除无用变量
        call_out("do_work",5);
       	if(random(50)==1)	this_object()->save();
       	return 1;
}

int rong_er()
{
    object rong;
    rong =find_living("rong er");
	if(!rong)
        rong=new("/obj/npc/lottery");
        rong->move("/d/gameroom/lottery_room");
        rong->start_work();
        this_object()->set("last_time",time());
        this_object()->save();
}
