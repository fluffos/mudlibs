#pragma save_binary
// shang-shan.c 赏善使者
// By L.G.

#ifndef NPCDATA
#define NPCDATA "/data/npc/"
#endif
#define SHIZHE NPCDATA + "shang-shan"

inherit NPC;
inherit F_UNIQUE;
inherit F_SAVE;

int reset_weapon(string type);
string query_save_file() {
  return SHIZHE;
}

void create() {
  object weapon;
  int damage1, damage2;

  seteuid(getuid());
  set_name("东方日", ({ "shangshan shizhe" }));
  if (!restore()) {
    set("title", "赏善使者");
    set("gender", "男性");
    set("age", 35);
    set("long", "一位笑容可掬的中年人，他就是乐善好施，爱贫如子的武林赏善使者。\n");
    set("attitude", "heroism");
    set("generation", 0);
    set("winner", "shizhe");

    set("str", 25);
    set("con", 25);
    set("int", 25);
    set("per", 25);

    set("max_kee", 3000);
    set("eff_kee", 3000);
    set("kee", 3000);
    set("max_gin", 3000);
    set("gin", 3000);
    set("force", 500);
    set("max_force", 500);
    set("force_factor", 30);

    set("combat_exp", 400000);

    set_skill("force", 90);
    set_skill("unarmed", 90);
    set_skill("sword", 90);
    set_skill("dodge", 90);
    set_skill("parry", 90);

    set("weapon", "/obj/weapon/sword/dragon_sword");
    set("armor", "/obj/cloth");

    setup();
    carry_object("/obj/weapon/sword/dragon_sword")->wield();
    carry_object("/obj/cloth")->wear();
  } else {

    set_name(query("name"), ({ "shizhe " + query("winner") }));
    setup();
    if (this_object()->query("armor")) carry_object(this_object()->query("armor"))->wear();
    if (this_object()->query("weapon")) {
      if (this_object()->query("weapon") == "no") return;
      weapon = new(this_object()->query("weapon"));
      damage1 = weapon->query("weapon_prop/damage");
      damage2 = query("apply_damage");
      if ((damage2 - damage1) >= 1) {
        this_object()->set_temp("apply/damage", damage2 - damage1);
      }
      weapon->move(this_object());
      weapon->wield();
    }
  }

}

void init() {
  add_action("do_recopy", "recopy");
  //	add_action("do_recover", "recover");
  add_action("do_kill", "kill");

}

int do_kill() {
  int i;
  object ob;
  command("say 你想谋害本使者，当真是自找死路！ 座下红衣武士何在！");
  message_vision("四周的红衣武士群起对$N发动攻击！\n", this_player());

  for (i = 0; i < 4; i++) {
    if (objectp(ob = present("wei shi " + (i + 1), environment(this_object()))))
      ob->kill_ob(this_player());
    else this_object()->kill_ob(this_player());
  }

  return 1;
}

int accept_fight(object ob) {
  object me, mengzhu, fae;
  string name1, name2;

  me = this_object();

  mengzhu = load_object("/obj/npc/meng-zhu");
  name1 = mengzhu->query("winner");
  destruct(mengzhu);

  if (this_player()->query("id") == name1) {
    tell_object(ob, "你已经是武林盟主，还要抢当赏善使者？！\n");
    return 0;
  }

  fae = load_object("/obj/npc/fa-e");
  name2 = fae->query("winner");
  destruct(fae);

  if (this_player()->query("id") == name2) {
    tell_object(ob, "你已经是罚恶使者，还要抢当赏善使者？！\n");
    return 0;
  }
  if (me->query("winner") == ob->query("id")) {
    tell_object(ob, "你跟你自己打什么架？！\n");
    return 0;
  }
  if (wizardp(this_player()))
    return 0;

  if (me->is_fighting()) {
    tell_object(ob, "已经有人正在挑战赏善使者！\n");
    return 0;
  }
  if (me->query_temp("have_fight") >= 3) {
    tell_object(ob, "赏善使者今天已经接受过三次挑战了，你等明天再来吧！\n");
    return 0;
  }
  me->add_temp("have_fight", 1);
  me->set("eff_kee", me->query("max_kee"));
  me->set("kee", me->query("max_kee"));
  me->set("gin", me->query("max_gin"));
  me->set("force", me->query("max_force"));

  remove_call_out("checking");
  call_out("checking", 1, me, ob);

  return 1;
}

int checking(object me, object ob) {

  int my_max_qi, his_max_qi;

  my_max_qi = me->query("max_kee");
  his_max_qi = ob->query("max_kee");

  if (me->query_temp("last_damage_from")
    && me->query_temp("last_damage_from") != ob)
    return 1;
  //自始至终只能单挑。别人帮忙不算

  if (me->is_fighting()) {
    if ((me->query("kee") * 100 / my_max_qi) <= 80)
      command("exert recover");
    call_out("checking", 1, me, ob);
    return 1;
  }

  if (!present(ob, environment())) return 1;

  if (((int)me->query("kee") * 100 / my_max_qi) <= 50) {
    command("say 佩服佩服，看来我的担子可以交卸了，恭喜你成为武林赏善使者！\n");
    command("chat 恭喜" + ob->query("name") + "被推举为现任武林赏善使者！\n");
    remove_call_out("do_copy");
    call_out("do_copy", 1, me, ob);
    return 1;
  }

  if (((int)ob->query("kee") * 100 / his_max_qi) < 50) {
    command("say 看来" + RANK_D->query_respect(ob) +
      "还得多加练习，方能在当今武林中有所作为 !\n");
    return 1;
  }

  return 1;
}

int do_copy(object me, object ob) {
  me->set("winner", ob->query("id"));
  me->add("generation", 1);

  me->set("name", ob->query("name"));
  me->set("title", "第" + chinese_number(me->query("generation")) + "代赏善使者");


  ob->delete_temp("apply/short");
  ob->set_temp("apply/short", ({ me->short() }));

  remove_call_out("do_clone");
  call_out("do_clone", 0, me, ob);

  return 1;
}

int do_recopy(object me, object ob) {
  me = this_object();
  ob = this_player();

  if (me->query("winner") != ob->query("id"))
    return notify_fail("你不是现任赏善使者！\n"); ;

  me->set("name", ob->query("name"));
  me->set("title", "第" + chinese_number(me->query("generation")) + "代赏善使者");

  ob->delete_temp("apply/short");
  ob->set_temp("apply/short", ({ me->short() }));

  remove_call_out("do_clone");
  call_out("do_clone", 0, me, ob);

  return 1;
}

int do_clone(object me, object ob) {
  object newnpc;
  mapping hp_status, skill_status, map_status, prepare_status;
  string *sname, *mname, *pname;
  int i, temp;

  seteuid(geteuid(me));

  /* delete and copy skills */

  if (mapp(skill_status = me->query_skills())) {
    skill_status = me->query_skills();
    sname = keys(skill_status);

    temp = sizeof(skill_status);
    for (i = 0; i < temp; i++) {
      me->delete_skill(sname[i]);
    }
  }

  if (mapp(skill_status = ob->query_skills())) {
    skill_status = ob->query_skills();
    sname = keys(skill_status);

    for (i = 0; i < sizeof(skill_status); i++) {
      me->set_skill(sname[i], skill_status[sname[i]]);
    }
  }

  /* delete and copy skill maps */

  if (mapp(map_status = me->query_skill_map())) {
    mname = keys(map_status);

    temp = sizeof(map_status);
    for (i = 0; i < temp; i++) {
      me->map_skill(mname[i]);
    }
  }

  if (mapp(map_status = ob->query_skill_map())) {
    mname = keys(map_status);

    for (i = 0; i < sizeof(map_status); i++) {
      me->map_skill(mname[i], map_status[mname[i]]);
    }
  }

  /* delete and copy skill prepares */

  if (mapp(prepare_status = me->query_skill_prepare())) {
    pname = keys(prepare_status);

    temp = sizeof(prepare_status);
    for (i = 0; i < temp; i++) {
      me->prepare_skill(pname[i]);
    }
  }

  if (mapp(prepare_status = ob->query_skill_prepare())) {
    pname = keys(prepare_status);

    for (i = 0; i < sizeof(prepare_status); i++) {
      me->prepare_skill(pname[i], prepare_status[pname[i]]);
    }
  }

  /* copy entire dbase values */

  hp_status = ob->query_entire_dbase();

  me->set("str", hp_status["str"]);
  me->set("int", hp_status["int"]);
  me->set("con", hp_status["con"]);
  me->set("per", hp_status["per"]);
  me->set("age", hp_status["age"]);

  me->set("max_kee", hp_status["max_kee"]);
  me->set("eff_kee", hp_status["eff_kee"]);
  me->set("kee", hp_status["kee"]);
  me->set("max_gin", hp_status["max_gin"]);
  me->set("eff_gin", hp_status["eff_gin"]);
  me->set("gin", hp_status["gin"]);
  me->set("max_force", hp_status["max_force"]);
  me->set("force", hp_status["force"]);
  me->set("force_factor", hp_status["force_factor"]);
  me->set("gender", hp_status["gender"]);
  me->set("combat_exp", hp_status["combat_exp"]);
  if (me->query("combat_exp") >= 5000000) me->set("combat_exp", 5000000);

  if (ob->query_temp("weapon"))
    reset_weapon(ob->query_temp("weapon")->query("skill_type"));
  else set("weapon", "no");
  me->set("apply_damage", ob->query_temp("apply/damage"));
  save();

  tell_object(ob, "状态储存完毕。\n");

  newnpc = new("/obj/npc/shang-shan");
  newnpc->move(environment(ob));
  destruct(me);

  return 1;
}

int reset_weapon(string type) {
  if (!type) set("weapon", "no");
  else {
    switch (type) {
      case "sword":
        set("weapon", "/obj/weapon/sword/dragon_sword");
        break;
      case "blade":
        set("weapon", "/obj/weapon/blade/kugudao");
        break;
      case "spear":
        set("weapon", "/obj/weapon/spear/jinqiang");
        break;
      case "whip":
        set("weapon", "/obj/weapon/whip/jueqingwhip");
        break;
      case "staff":
        set("weapon", "/obj/weapon/staff");
        break;
      case "staff":
        set("weapon", "/obj/weapon/staff");
        break;
      default:
        set("weapon", "/obj/weapon/changjian");
        break;
    }
  }
  return 1;
}


