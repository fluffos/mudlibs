// heaven_soldier.c

#include <ansi.h>

inherit NPC;

void create()
{

    set_name("大内高手", ({ "danei gaoshou", "gaoshou","danei" }) );
    set("long", "这是一位朝廷聘用的大内高手，专门负责暗中保护朝廷命官的安全\n");
	set("attitude", "friendly");

    set_skill("blade",10);
    set_skill("parry",10);
    set_skill("dodge",10);
    set_skill("tiyunzong-steps",10);
    set_skill("spring-blade",10);
    map_skill("parry", "spring-blade");
    map_skill("blade", "spring-blade");
    map_skill("dodge", "ziyunzong-steps");


	set("str", 40);
	set("cor", 30);
	set("cps", 25);
    set("max_force", 50);
    set("force_factor", 5);
    set("force", 50);

	set("chat_chance", 15);
	set("chat_msg_combat", ({
        name() + "喝道：反了！竟然想刺杀朝廷命官？\n"
	}) );
	setup();

    carry_object("/obj/cloth")->wear();
    carry_object(__DIR__"obj/blade")->wield();
}

int heal_up()
{
	if( environment() && !is_fighting() ) {
        call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
    object owner;
	message("vision",
        HIY + name() + "说道：奉大人召唤，现已完成保护的任务，就此告辞！\n"
        + name() + "纵身一跃，消失不见了。\n" NOR, environment(),
		this_object() );
  if(objectp(owner=this_object()->query("owner")))
  owner->add_temp("havecalled",-1);
	destruct(this_object());
}

void invocation(object who)
{
	int i;
	object *enemy;
    object me;
    int skill,skill0;

    me=this_object();
    skill=who->query_skill("leadership");
    skill0=who->query_skill("strategy");

	message("vision",
         "大内高手闻声赶到，喊道：竟敢刺杀朝廷命官！\n",
		environment(), this_object() );

    me->set("owner",who);
    me->set("max_kee",skill*5+skill0*5+200);
    me->set("eff_kee",skill*5+skill0*5+200);
    me->set("kee",skill*5+skill0*5+200);
    me->set("max_gin",skill*5+skill0*5+200);
    me->set("eff_gin",skill*5+skill0*5+200);
    me->set("gin",skill*5+skill0*5+200);
    me->set("max_sen",skill*3+skill0*3+100);
    me->set("eff_sen",skill*3+skill0*3+100);
    me->set("sen",skill*3+skill0*3+100);
    me->set("max_force",skill*4+skill0*4+100);
    me->set("force",skill*3+skill0*3+100);
    me->set("force_factor",skill/2+skill0/2);
    me->set_skill("blade",skill+skill0);
    me->set_skill("parry",skill+skill0);
    me->set_skill("dodge",skill+skill0);
    me->set_skill("force",skill+skill0);
    me->set_skill("spring-blade",skill+skill0);
    me->set_skill("tiyunzong-steps",skill+skill0);

    me->set("combat_exp",who->query("combat_exp")/2+random(who->query("combat_exp")/2));

	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			kill_ob(enemy[i]);
			if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
			else enemy[i]->kill_ob(this_object());
		}
	}
	set_leader(who);
}
void die()
{
    object owner;
  owner=this_object()->query("owner");
  owner->add_temp("havecalled",-1);
  ::die();
}
void killed_enemy(object victim)
{
    object me;
    me=this_object();
   if(objectp(me->query("owner"))&&!userp(victim))
                COMBAT_D->killer_reward(me->query("owner"), victim);
}
