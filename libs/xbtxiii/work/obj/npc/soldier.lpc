#pragma save_binary
// heaven_soldier.c

#include <ansi.h>

inherit NPC;

void create()
{
	string *order = ({"甲", "乙", "丙", "丁", "戊", "己", "庚", "辛", "壬", "癸"});
	set_name("天" + (order[random(10)]) + "神兵", ({ "heaven soldier", "soldier" }) );
	set("long", "这是一位来自天界的守护神，专门担任护法之责。\n");
	set("attitude", "friendly");
	set("per",15);
	set("str",30);
	set("max_gin", 1000);
	set("gin", 1000);
	set("kee", 1000);
	set("force", 1000);
	set("max_force", 1000);
	set("max_sen", 1000);
	set("sen", 1000);
	set("max_kee", 1000);
	set("max_sen", 1000);
	set("sen", 1000);

     	set("max_atman", 1000);
	set("atman", 1000);
	set("max_mana", 1000);
	set("mana", 1000);

	set("cor", 30);
	set("cps", 25);

	set("combat_exp", 300000);
	set_skill("sword", 10);
	set_skill("parry", 10);
	set_skill("dodge",10);
	set_skill("shaolin-shenfa",10);
        set_skill("staff",10);
	set_skill("zui-gun",10);

	map_skill("staff", "zui-gun");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("parry", "zui-gun");
	setup();

	carry_object(__DIR__"obj/golden_armor")->wear();
	carry_object(__DIR__"obj/golden_staff")->wield();
}

int heal_up()
{
	object player;
	player=query_temp("protecting");
	if( environment() 
	&& player
	&&player->is_fighting()
	&&environment(this_object())==environment(player) ) {
	return ::heal_up() + 1;
	}
	else call_out("leave", 1);
	return 1;

}

void leave()
{
	object player;
	message("vision",
		HIY + name() + "说道：末将奉法主召唤，现在已经完成护法任务，就此告辞！\n\n"
		+ name() + "化成一道金光，冲上天际消失不见了。\n" NOR, environment(),
		this_object() );
	player=query_temp("protecting");
	if(player) player->delete_temp("invocation");
	destruct(this_object());
}

void invocation(object me)
{
	command("protect "+me->query("id")+"");

}

void owner_is_killed(object killer)
{
        object player;	
	player=query_temp("protecting");
	if(player) player->delete_temp("invocation");
	::die();

}

