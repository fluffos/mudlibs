#pragma save_binary
// cloth.c
//
// 供mud_age<=64800的玩家使用的
// change by alvins 10-04-99
#include <ansi.h>
inherit ITEM;
int do_execration(object me, int i, string place);
int do_move(object me, string place);
void create() {
  set_name(HBBLU "移动法愿卷轴" NOR, ({ "fly scroll" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("place/1", "/d/fy/fqkhotel");
    set("place/2", "/d/chaoting/xianya/cloudy_xianya");
    set("place/3", "/d/yangzhou/pomiao");
    set("place/4", "/d/latemoon/latemoon1");
    set("place/5", "/d/xueshan/guangchang");
    set("place/6", "/d/ny/schoolhall");
    set("place/7", "/d/temple/temple1");
    set("place/8", "/d/huashan/buwei1");
    set("place/9", "/d/wudang/sanqingdian");
    set("place/10", "/daemon/class/fighter/guildhall");
    set("place/11", "/d/shaolin/guangchang1");
    set("place/12", "/d/xingxiu/riyuedong");
    set("no_drop", "这玩意儿都不要？您还是留着吧\n");
    set("long", "是可以使用" + HBBLU + "fly <号码>" + NOR + "来去您想要去的地方。以下是您可以去的地方:\n"
      "1  有一间客栈  2 官府     3 丐帮   4 晚月庄   5 雪山派\n"
      "6  封山派      7 茅山派   8 华山派 9 武当派  10 天邪派\n"
      "11 少林寺     12 星宿派\n");
  }
  setup();
}

int init() {
  add_action("do_goto", "fly");
}


int do_goto(string arg) {
  object me;
  int mud_age, exp, i;
  string msg;

  me = this_player();
  mud_age = me->query("mud_age");
  exp = me->query("combat_exp");

  if (mud_age > 14400) {  //4个小时
    tell_object(me, "多用无益,你还是自己走走吧。\n");
    remove_action("do_goto", "fly");
    destruct(this_object());
    return 1;
  }
  if (exp >= 40000) {
    tell_object(me, "您已经不需要这玩意儿了。\n");
    remove_action("do_goto", "fly");
    destruct(this_object());
    return 1;
  }
  if (environment(me)
    && strsrch(base_name(environment(me)), "start_room") > 0) {
    tell_object(me, "这里不能使用这个玩意儿。\n");
    return 1;
  }
  if (!arg || sscanf(arg, "%d", i) != 1) {
    tell_object(me, "请选择一个号码.例如:fly 1\n");
    return 1;
  }
  if ((int)i > 12 || (int)i <= 0) {
    tell_object(me, "没有这个地方可以去\n");
    return 1;
  }
  remove_call_out("do_execration");
  msg = "" + me->name() + "自言自语不知道在说些什麽。\n";
  tell_room(msg, ({ me }));
  tell_object(me, "你开始施展移动法愿......\n");
  call_out("do_execration", 2, me, 1, query("place/" + i));
  return 1;
}

int do_execration(object me, int i, string place) {
  string msg;
  remove_call_out("do_execration");
  switch (i) {
    case 1:
      msg = HIC "闪耀于夜空的星晨\n" NOR;
      break;
    case 2:
      msg = HIC "请指引我到达彼方之路途\n" NOR;
      break;
    case 3:
      msg = HIC "以黑夜之王,大气之精灵下令\n" NOR;
      break;
    case 4:
      msg = HIC "风啊！送我一程吧！\n" NOR;
      break;

    case 5:
      msg = HIC "移动法愿\n" NOR;
    default: break;
  }
  tell_object(me, msg);
  i++;
  if (i < 6 && i >= 0) call_out("do_execration", 1, me, i, place);
  else {
    call_out("do_move", 1, me, place);
    return 1;
  }
  return 1;
}



int do_move(object me, string place) {

  string msg;

  me->remove_all_enemy();
  msg = "$N开始施展移动法愿.....化做一道青光消失了\n";
  message_vision(msg, me);

  if (me->move(place)) {
    msg = "$N从青烟中缓缓出现......\n";
    message_vision(msg, me);
    return 1;
  } else {
    tell_object(me, "出问题了,赶快告诉巫师吧...\n");
    return 1;
  }
  return 1;
}
