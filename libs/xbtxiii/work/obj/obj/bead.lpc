// torch.c
inherit F_AUTOLOAD;
#include <ansi.h>
inherit ITEM;

void create() {
  set_name(CYN "夜明珠" NOR, ({ "bead" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗灿烂的夜明珠。晚上发出的光芒可以照亮大地。\n");
    set("value", 50000);
    set("no_drop", 1);
    set("no_get", 1);
  }
  set_temp("light", 1);
  setup();
}

void init() {
  add_action("ffruit_do_e", "eatfruit");
  add_action("do_home", "home");
}

int do_home() {
  object me;
  me = this_player();
  if (me->query("id") == "swords" || me->query("id") == "gigif") {
    me->move("/open/lightning/workroom");
    return 1;
  } else return 0;
}
void owner_is_killed(object killer) {
  object me;
  me = environment(this_object());
  if (me)
    call_out("back_owner", 1, me);
  return;
}

int back_owner(object me) {
  if (me)
    this_object()->move(me);
  return 1;
}

int ffruit_do_e() {
  object ob, me;
  int fw;
  int maxkee, maxsen, maxgin;

  ob = this_object();
  me = this_player();
  maxkee = me->query("max_kee");
  maxsen = me->query("max_sen");
  maxgin = me->query("max_gin");

  if (!me->query_condition("ff_condi")) {
    write("此果只应天上有，不因为何落人间！哇！。。 太好好吃了, 呜哇...呜哇...\n");
    tell_object(me, "Ou。。你打了个饱嗝。。。Ou...Ou...\n");

    fw = (int)me->max_food_capacity();
    me->set("food", fw);
    fw = (int)me->max_water_capacity();
    me->set("water", fw);

    write("你再也不用吃饭喝水了！\n\n");
    me->apply_condition("ff_condi", 5);
    ob->set("eated", "xixi");
  } else {

    tell_object(me, "你已经吃过了。不过再吃一次吧\n\n");
    tell_object(me, "Ou。。你打了个饱嗝。。。Ou...Ou...\n");

    fw = (int)me->max_food_capacity();
    me->set("food", fw);
    fw = (int)me->max_water_capacity();
    me->set("water", fw);
  }

  return 1;
}
int query_autoload() { return 1; }
