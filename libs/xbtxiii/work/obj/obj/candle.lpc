// candle.c

#include <ansi.h>
inherit TORCH;

void create() {
  set_name(HIW "蜡烛" NOR, ({ "candle" }));
  set("real_name", "蜡烛");
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是一根蜡烛，可以用来照明(light)。\n");
    set("value", 500);
    set("unlight_msg", "这是一根蜡烛，可以用来照明(light)。\n");
    set("light_msg", "这是一根点着的蜡烛，用来照明的，不用了可以(unlight)。\n");
  }
  set("can_light", 900);
  setup();
}
