// table

inherit ITEM;

void create()
{
	set_name("祭奠桌子", ({ "table" }) );
    set_max_encumbrance(800000);
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "张");
		set("long", "这是一张桌子。形状有些特别。是用来祭奠用的。\n"
					"上面可以摆放一些东西。(put)\n");
		set("value", 50000);
		set("祭奠桌子",1); //一个标记
	}
	setup();
}

int is_container() { return 1; }
