inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("猪头", ({ "zhu tou" }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗烤的焦黄的猪头。\n");
    set("unit", "颗");
    set("value", 20000);
    set("food_remaining", 30);
    set("food_supply", 30);
  }
}
