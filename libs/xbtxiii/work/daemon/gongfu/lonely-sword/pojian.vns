//pojian.c 「破剑式」
//made by deaner
#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        string msg;
        object target_w;
        target_w = target->query_temp("weapon");

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(HIC"你只能对战斗中的对手使用「破剑式」。\n"NOR);

        if( target->is_busy() )
                return notify_fail(target->name() + "目前正疲于招架，加紧攻击吧！\n");
    if( (int)me->query_skill("dugu-jiujian-sword", 1) < 80 )
        return notify_fail("你的独孤九剑不够娴熟，不能使用「破剑式」。\n");

    msg = CYN "$N举剑画弧，默潜出独孤九剑中的「破剑式」，“唰唰唰”连刺数剑，凌厉无匹，却无迹可循，$n不由骇然！\n";
    me->start_busy(2);

        if (target->query_temp("weapon") ||
           (string)target_w->query("skill_type") == "sword"){
        if( random(me->query("combat_exp")) >
                     (int)target->query("combat_exp")/4 ) {
    msg += "这招「破剑式」看似简单其实纷繁复杂，妙到巅毫，$p无法抵挡，面如死灰，只好放弃"+target_w->query("name")+"！\n" NOR;
                 target_w->unequip();
                 target_w->move(environment(target));
                 target->reset_action();
                 target->start_busy( (int)me->query_skill("dugu-jiujian-sword") / 20 );
    } else {
        msg += "$p使出浑身解术，才勉强接下$P这招「破剑式」！\n" NOR;
    }
    message_vision(msg, me, target);
    return 1;
        }
        return notify_fail(target->name() + "目前手中使的不是剑类兵刃，得用其他招式。\n");
}
