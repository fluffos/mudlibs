//pojian1.c 「破箭式」
//made by deaner
#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        string msg,*limbs;
        int i,size,damage;
        object target_w;
        target_w = target->query_temp("weapon");

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(HIC"你只能对战斗中的对手使用「破箭式」。\n"NOR);

        if( target->is_busy() )
                return notify_fail(target->name() + "目前正疲于招架，加紧攻击吧！\n");
    if( (int)me->query_skill("dugu-jiujian-sword", 1) < 80 )
        return notify_fail("你的独孤九剑不够娴熟，不能使用「破箭式」。\n");

    msg = CYN "$N施展出独孤九剑中的「破箭式」，剑势陡然变得奇幻莫测，只听得“叮叮当当”之声不绝，已将$n射来的"+target_w->query("name")+"尽数弹回！\n";
    me->start_busy(2);

        if (target->query_temp("weapon") ||
           (string)target_w->query("skill_type") == "throwing"){
        if( random(me->query("combat_exp")) >
                     (int)target->query("combat_exp")/4 ) {
    msg += "$p为这招「破箭式」赫得呆立当场，眼见"+target_w->query("name")+"回射向自己竟然不知躲避！\n" NOR;
                 target_w->unequip();
                 target_w->move(environment(target));
                 target->reset_action();
                 target->start_busy( (int)me->query_skill("dugu-jiujian-sword") / 20 );
        limbs=target->query("limbs");
        size=(int)(me->query_skill("dugu-jiujian-sword")/10);
        damage=random(size)+size;
        damage=damage+me->query_str()/3+random(me->query_temp("apply/damage"));
        for(i=0;i<=random(size);i++)
            {
            msg +="“嗤”，只见"+target_w->query("name")+"射入$p的"+limbs[random(sizeof(limbs))]+"！\n"NOR;
            message_vision(msg,me,target);
            target->receive_damage("qi",damage,me);
            target->receive_wound("qi",damage/3,me);
            }
        COMBAT_D->report_status(target);
    } else {
        msg += "$p狼狈不堪地俯跪在地，勉强躲开了$P这招「破箭式」！\n" NOR;
    }
    message_vision(msg, me, target);
    return 1;
        }
        return notify_fail(target->name() + "目前手中没有暗器，得用其他招式。\n");
}
