#pragma save_binary
// spattack.c

#include <ansi.h>

inherit SSERVER;
int conjure(object me, object target) {
  string msg;
  string msg1;
  string msg2;
  string msg3;
  string msg4;
  int damage, ap, dp, i;
  i = random(3);
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展咒术？\n");
  if (i == 0) {
    msg1 = "$N咬破手指，将鲜血向空中一洒，，，喝道：" + HIB "“神兵火龙，急急如律令，龙啸九天！！。。。打！！”" NOR + "\n
突然间，风起云涌，浓云密布，一条火龙从天而降向$n冲去。。\n";

    msg2 = "“轰”的一声，火龙从" + target->query("name") + "胸口洞穿而过。。。。\n";

    msg3 = "你只觉的口干舌燥，眼前金星乱冒。。。。\n";
    msg4 = "sen";
  }
  if (i == 1) {
    msg1 = "$N身形一转散作七处向$n连拍数掌，同时口中念道：\n" + HIY "
“天地法灵，驱鬼逐魔令！！！”" NOR + "\n
只见$N掌心飞出一串火球向$n射去。。。\n";

    msg2 = "只听“嗤嗤”声响，" + target->query("name") + "身上着起了大火。
	\n";

    msg3 = "你只觉的遍体剧痛，如入火坑。\n";
    msg4 = "sen";
  }
  if (i == 2) {
    msg1 = "$N手捻法诀，口中喃喃念道：\n" + HIR "
“日月齐光，风雷地动令！！”" NOR + "\n
突然间，地动山摇，狂风大作，无数大石向$n砸去。。";

    msg2 = "“砰砰砰”。。" + target->query("name") + "被砸的头破血流。。。。\n";

    msg3 = "“砰”。。你两眼一黑，险些昏了过去！\n";
    msg4 = "kee";
  }


  if ((int)me->query("atman") < 25)
    return notify_fail("你的灵力不够！\n");

  if ((int)me->query("gin") < 10)
    return notify_fail("你的精力没有办法有效集中！\n");
  me->add("atman", -25);

  if (random(me->query("max_atman")) < 50) {
    write("你失败了。\n");
    return 1;
  }
  msg = "\n";
  message_vision(msg1, me, target);
  ap = me->query_skill("kkmspower");
  ap = (ap * ap * ap / 4) * (int)me->query("gin") / 100;
  dp = target->query("combat_exp");
  if (random(ap + dp) > dp) {
    damage = (int)me->query("max_atman") / 20 + random((int)me->query("eff_gin") / 10);
    damage -= (int)target->query("max_atman") / 30 + random((int)me->query("eff_gin") / 15);
    if (target->is_ghost() || target->is_zombie()) damage = damage * 10;
    if (damage > 0) {
      target->receive_damage(msg4, damage, me);
      target->receive_wound(msg4, damage / 3, me);
      tell_room(environment(me), msg2, target);
      tell_object(target, msg3);
      me->improve_skill("kkmspower", 1, 1);
    } else {
      me->receive_damage("gin", 10);
      msg = "$N的法咒好象没有造成任何伤害！\n";
    }
  } else
    msg = "但是被$n躲开了。\n";
  message_vision(msg, me, target);

  if (damage > 0) COMBAT_D->report_status(target);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
    me->kill_ob(target);
  }

  me->start_busy(2);
  return 1;
}
