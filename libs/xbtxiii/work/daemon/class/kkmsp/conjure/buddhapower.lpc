#pragma save_binary
// astral_vision.c

#include <ansi.h>

inherit SSERVER;

int conjure(object me, object target) {
  object *ob;
  int i, skill, damage;
  if (me->query("gin") < 10)
    return notify_fail("你的精力不足！\n");
  if ((int)me->query("mana") < 50)
    return notify_fail("你的法力不够。\n");
  skill = me->query_skill("kkmspower");
  damage = 0;
  me->add("mana", -50);
  me->receive_damage("sen", 10);
  if (random(me->query("max_mana")) < 200) {
    tell_room(environment(me), me->query("name") + "念了几句咒，但什么也没发生...\n", me);
    tell_object(me, "你失败了。。\n");
    return 1;
  }
  message_vision(
    HIB "$N腾空而起，口中念道：" + HIY "无名无相，万佛归宗，菩提金身！！" NOR +
    "。\n", me);
  tell_room(environment(me), me->query("name") + "全身放射出刺眼的金光。。。\n");
  ob = all_inventory(environment(me));
  if (sizeof(ob) == 0) return 1;
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me || !(ob[i]->is_ghost() || ob[i]->is_zombie())) continue;
    damage = (int)(skill + (ob[i]->query("kee")) * (me->query("max_mana")) / (ob[i]->query("max_mana")) / 3);
    if (damage > 0) {
      ob[i]->receive_damage("sen", damage);
      ob[i]->receive_damage("kee", damage);
      ob[i]->receive_damage("gin", damage);
      ob[i]->receive_wound("sen", damage / 2);
      ob[i]->receive_wound("kee", damage / 2);
      ob[i]->receive_wound("gin", damage / 2);
      tell_room(environment(me), ob[i]->query("name") + "的全身冒出了屡屡清烟！\n", ob[i]);
      tell_object(ob[i], "你觉得浑身阵阵剧痛。。\n");
      if (!ob[i]->is_killing(me->query("id"))) ob[i]->kill_ob(me);
    }
  }
  if (me->is_fighting()) me->start_busy(4);
  return 1;
}
