#pragma save_binary
// haunt.c

#include <ansi.h>

inherit F_CLEAN_UP;

int scribe(object me, object sheet, string arg)
{
        object ob;
        if( me->is_fighting() ) return notify_fail("你正在战斗中！\n");
        
	if(me->query_temp("execration"))
		return notify_fail("你正在念咒。\n");
        if( (int)me->query("mana") < 20 ) 
        	return notify_fail("你的法力不够了！\n");


        message_vision("$N咬破中指,用鲜血在"+sheet->query("name")+"上画了一道僵尸追魂符.\n",me);
        ob=new("/obj/paper_seal");
        ob->set_name(YEL "僵尸追魂符" NOR, ({ "haunting sheet"}) 
);      
        ob->move(me);
        if(sheet->query_amount()>1){ sheet->add_amount(-1);}
        else destruct(sheet);
        me->receive_damage("sen", 10);
        me->add("mana", -10);

        me->start_busy(3);
        return 1;
}
