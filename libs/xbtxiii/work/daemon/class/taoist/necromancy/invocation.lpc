#pragma save_binary
// invocation.c

inherit SSERVER;

int cast(object me, object target) {
  int skill, sen, kee, gin;
  object soldier;
  skill = me->query_skill("spells");
  gin = me->query("max_gin");
  sen = me->query("max_sen");
  kee = me->query("max_kee");

  if (!skill || skill < 150)
    return notify_fail("你没有领悟这项魔法！\n");
  if (!me->query_skill_mapped("force") || me->query_skill_mapped("force") != "gouyee")
    return notify_fail("天兵召唤需要谷衣心法的配合方可使用。\n");

  if (!me->is_fighting())
    return notify_fail("只有战斗中才能召唤天将护法！\n");

  if (me->query_temp("execration"))
    return notify_fail("你正在念咒。\n");
  if (me->query_temp("invocation"))
    return notify_fail("你已经召唤了一个天将护法了。\n");
  if ((int)me->query("mana") < 50)
    return notify_fail("你的法力不够了！\n");

  if ((int)me->query("sen") < 80)
    return notify_fail("你的精神无法集中！\n");

  message_vision("$N喃喃地念了几句咒语。\n", me);

  me->add("mana", -80);
  me->receive_damage("sen", 60);

  if (random(me->query("max_mana")) < 50) {
    message("vision", "但是什麽也没有发生。\n", environment(me));
    return 1;
  }

  seteuid(getuid());
  soldier = new("/obj/npc/soldier");
  soldier->move(environment(me));

  soldier->set("sen", sen * 3 / 2);
  soldier->set("gin", gin * 3 / 2);
  soldier->set("kee", kee * 3 / 2);
  soldier->set("max_sen", sen * 3 / 2);
  soldier->set("max_gin", gin * 3 / 2);
  soldier->set("max_kee", kee * 3 / 2);


  soldier->set_skill("zui-gun", skill);
  soldier->set_skill("staff", skill);
  soldier->set_skill("shaolin-shenfa", skill / 2);
  soldier->set_skill("dodge", skill);
  soldier->set_skill("parry", skill);
  soldier->set("combat_exp", skill / 3 * (skill / 3) * (skill / 3));
  soldier->invocation(me);
  me->set_temp("invocation", 1);
  return 1;
}
