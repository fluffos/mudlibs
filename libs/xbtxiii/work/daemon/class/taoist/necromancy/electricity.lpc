// 雄霸天下II魔法技能标准范例。
// 参数说明
// set_temp("armor_vs_lightning",50)
// armor_vs_lightning // 对火系魔法的抵抗能力 +表示抵抗火系魔法 -表示抵抗水系魔法
// 两者不能共存。即无法同时抵抗水系魔法和火系魔法。如果生物可以抵抗水系魔法。
// 那么火系魔法将对他造成更大的伤害。
// armor_vs_lightning // 抵抗电系魔法的能力
// armor_vs_magic  // 抵抗魔法能力。对抗所以魔法 这个值不能设的太高。
// 通常这个值应该控制在 -100至+100 以内。以百分比来计算。负数表示此生物
// 惧怕此类魔法。正数反之。任何非特殊npc的抵抗系数不得超过-30至+30之间
// execration  表示正在念咒。
// 以后任何魔法都应此类为标准。不得再使用其他标记。以免混乱。
// fireball
// 1999.3.1 by rongg
// fireball.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg;
  int skill;
  skill = me->query_skill("spells");
  if (!skill || skill <= 40)
    return notify_fail("你没有学会如何使用闪电光束？\n");
  if (!me->query_skill_mapped("force") || me->query_skill_mapped("force") != "gouyee")
    return notify_fail("你尚未领悟这项法术的精髓。\n");
  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展闪电光束？\n");
  if (me->query_temp("execration"))
    return notify_fail("你正在念咒。\n");
  if ((int)me->query("mana") < 30)
    return notify_fail("你的法力不够！\n");
  if ((int)me->query("sen") < 10)
    return notify_fail("你的精神没有办法有效集中！\n");
  me->add("mana", -30);
  me->receive_damage("sen", 5);
  msg = "" + me->name() + "自言自语不知道在说些什麽。\n";
  message("vision", msg, environment(me), ({ me }));
  tell_object(me, "你开始施展魔法。片刻一束巨大闪电在你手中凝聚着...\n");
  call_out("do_hit", 4, me, target, skill);
  me->set_temp("execration", 1);
  return 1;
}
int do_hit(object me, object target, int skill) {

  string msg;
  int i, my_exp, your_exp, damage, vs_lightning, vs_magic, additional;  //附加伤害
  me->delete_temp("execration");
  if (!target || !environment(target) || environment(me) != environment(target)) {
    message_vision(YEL "$N把手一挥，一个巨大的闪电光束砸在地上！" NOR, me);
    return 1;
  } else if (environment(target)->query("no_fight")) {
    tell_object(me, "目标.现在处于禁止使用魔法的地区,你只好停止念咒，取消了闪电光束。\n");
    return 1;
  }

  else {
    msg = RED "$N手中聚起一个巨大的闪电光束朝$n丢去。\n" NOR;
    message_vision(msg, me, target);
    my_exp = me->query("combat_exp");
    your_exp = target->query("combat_exp");
    i = 85 - (your_exp - my_exp) / 200000;
    if (i > 100) i = 100;
    if (i < 0) i = 0;
    if (random(100) <= i) {
      msg = RED "结果闪电光束轰隆一声劈在$n身上，造成难以形容的伤害。\n" NOR;
      if (skill >= 140) skill = 140;
      damage = 60 + skill * 3 / 2;  // 闪电光束造成的伤害的最大值为200。
      additional = me->query_spi();
      additional = to_int(pow(additional * additional * additional, 0.41));
      if (additional > 1000) additional = 1000;
      // 和臂力的计算公式一样。突出茅山派灵力的作用。
      //   tell_object(me,"additional is "+additional+"\n");
      damage += additional;
      damage = damage * (1 + (my_exp / (your_exp + 1)) * 10 / 100);  // 这个是经验修正。
      if (damage > 1000) damage = 1000;
      vs_lightning = target->query_temp("apply/armor_vs_lightning");
      if (vs_lightning > 100) vs_lightning = 100;
      if (vs_lightning < -100) vs_lightning = -100;
      damage = damage * (100 - vs_lightning) / 100;  // 抵抗闪电系魔法修正
      vs_magic = target->query_temp("apply/armor_vs_magic");
      if (vs_magic > 100) vs_magic = 100;
      if (vs_magic < 0) vs_magic = 0;
      damage = damage * (100 - vs_magic) / 100;  // 抵抗魔法修正	    
      //   tell_object(me,"damage is "+damage+"\n");
      target->receive_damage("kee", damage, me, "magic");
      target->receive_wound("kee", damage / 2, me, "magic");
      COMBAT_D->report_status(target);
    } else msg = YEL "可惜丢偏了。\n" NOR;
    message_vision(msg, me, target);
  }
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
    me->kill_ob(target);
  }
  return 1;
}
