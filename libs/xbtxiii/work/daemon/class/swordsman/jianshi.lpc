#pragma save_binary
// master.c

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("封山剑士", ({ "jianshi" }) );
        set("nickname", "风雨双侠");
        set("gender", "男性" );
        set("shen_type", 1);
        set("age", 44);
        set("str", 27);
        set("cor", 30);
        set("cps", 27);
        set("int", 24);

        set("max_force", 1500);
        set("force", 1500);
        set("force_factor", 10);



        set("combat_exp", random(500000));
        set("score", 200000);

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword.counterattack" :),
		(: perform_action, "sword.swordjab" :),
		(: perform_action, "sword.powerfocus" :),
		(: perform_action, "sword.fakefault" :),
        }) );

          set_skill("unarmed",100);
        set_skill("parry", 120);
        set_skill("dodge", 80);
        set_skill("sword", 150);
   set_skill("force",100);
        set_skill("literate", 60);

     set_skill("fonxanforce",120);
        set_skill("fonxansword", 120);
          set_skill("liuh-ken",100);
        set_skill("chaos-steps", 100);
        set_skill("spider-array", 85);

        map_skill("unarmed", "liuh-ken");
        map_skill("force","fonxanforce");
        map_skill("sword", "fonxansword");
        map_skill("parry", "fonxansword");
        map_skill("dodge", "chaos-steps");
        map_skill("move","chaos-steps");
        set("inquiry", ([
        ]) );

        setup();
        carry_object(__DIR__"blackthorn")->wield();
        carry_object(__DIR__"silk_cloth")->wear();
}


void init()
{
object ob;

::init();
if( interactive(ob = this_player()) && !is_fighting() )
      {
remove_call_out("greeting");
call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
if( !ob || environment(ob) != environment() ) return;
 if((string)ob->query("family/family_name") == "天邪派")
  if( (int)ob->query("MKS") > 1000 )  
{
        command("say 好你个天邪弟子，又想来我封山武馆捣乱？");
      kill_ob(ob);
       }
      else {
message_vision("\n柳馆主看到$N闯进来，大喝一声：你这个恶魔，给我滚出去！\n\n", ob);
    ob->move("/d/snow/school2");
}
}
void attempt_apprentice(object ob)
{
        if( ((int)ob->query("cor") < 20) 
        ||      ((int)ob->query("cps") < 20)) {
                command("say 学剑之人必须胆大心细，依我看" + 
RANK_D->query_respect(ob) + "的资质似乎不宜？");
                return;
        }
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + 
"多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "swordsman");
}
 
