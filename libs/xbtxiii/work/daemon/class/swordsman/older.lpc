#pragma save_binary
// brother.c

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("柳恨萧", ({ "hengxiao" }));
  set("nickname", "飘香剑");
  set("gender", "男性");
  set("age", 34);
  set("str", 27);
  set("cor", 30);
  set("cps", 27);
  set("int", 24);

  set("max_force", 900);
  set("force", 900);
  set("force_factor", 5);

  set("rank_info/respect", "柳三叔");

  set("long",

    "柳恨萧是个相当高大的中年儒生，若不是听道武馆弟子叫他三叔,你\n"
    "大概猜不到眼前这个温文儒雅的中年人竟是淳风武馆的三馆主。\n");

  create_family("封山剑派", 13, "三师弟");
  set("combat_exp", 100000);
  set("score", 200000);

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword.counterattack" :),
    (: perform_action, "sword.swordjab" :),
    (: perform_action, "sword.powerfocus" :),
    (: perform_action, "sword.fakefault" :),
  }));

  set_skill("unarmed", 40);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("sword", 90);
  set_skill("force", 60);
  set_skill("literate", 60);

  set_skill("fonxanforce", 60);
  set_skill("fonxansword", 60);
  set_skill("liuh-ken", 60);
  set_skill("chaos-steps", 50);
  set_skill("spider-array", 85);

  map_skill("unarmed", "liuh-ken");
  map_skill("force", "fonxanforce");
  map_skill("sword", "fonxansword");
  map_skill("parry", "fonxansword");
  map_skill("dodge", "chaos-steps");
  map_skill("move", "chaos-steps");

  setup();
  carry_object(__DIR__ "blackthorn")->wield();
  carry_object(__DIR__ "silk_cloth")->wear();
}
