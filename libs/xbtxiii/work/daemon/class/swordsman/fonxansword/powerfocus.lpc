// powerfocus.c

#pragma optimize all

#include <ansi.h>

inherit SSERVER;
inherit F_DBASE;

int perform(object me, object target)
{
	string msg;
	mapping my;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("牵制攻击只能对战斗中的对手使用。\n");
	if((int)me->query("force") < 30 )
		return notify_fail("你内力不足,无法使用点字诀。\n");
	my = me->query_entire_dbase();
	if( !my["force_factor"] )
		return notify_fail("你尚未运劲于臂，又如何运劲于剑。\n");
	me->set_temp("perform/点",1);
	msg = CYN "$N使出封山剑法「点」字诀，剑尖一颤，显是蕴含着一股极强的内劲。\n" NOR;
//	printf("In swordjab:Who:%s:perform/点=%d\n", me->query("id"),me->query_temp("perform/点"));
	message_vision( msg, me, target);
	return 1;
}


