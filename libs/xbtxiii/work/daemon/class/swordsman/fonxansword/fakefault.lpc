// fakefault.c

// #pragma optimize all

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int delete_temp_fonxansword(object me);
int perform(object me, object target) {
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("牵制攻击只能对战斗中的对手使用。\n");
  if ((string)me->query_skill_mapped("force") != "fonxanforce")
    return notify_fail("封山剑法必须配合封山派内功才能使用。\n");

  if ((int)me->query("force") < 30)
    return notify_fail("你内力不足,无法使用缺字诀。\n");
  if (me->query_temp("fonxansword/fakefault"))
    return notify_fail("缺字诀还没有收招\n");
  me->add("force", -10);
  msg = CYN "$N使出封山剑法「缺」字诀，剑花一散，其中似有一破绽。\n";
  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 4) {
    target->add_busy(2);
    target->set_temp("guarding", 0);
    msg += "$n仓皇出招，结果被$P被迎头痛击！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    me->set_temp("fonxansword/fakefault", 1);
    call_out("delete_temp_fonxansword", 4, me);
  } else {
    msg += "可是$n看破了$P的企图，并未轻易出手。\n" NOR;
    message_vision(msg, me, target);
  }
  return 1;
}


int delete_temp_fonxansword(object me) {
  me->delete_temp("fonxansword/fakefault");
  return 1;
}
