// swordjab.c

// #pragma optimize all

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("牵制攻击只能对战斗中的对手使用。\n");
	if((int)me->query("force") < 30 )
		return notify_fail("你内力不足,无法使用逐字诀。\n");
	if( me->query_temp("perform/逐") !=1)
		return notify_fail("你尚未击中敌人，无法使用逐字诀。\n");
	me->add_damage("force",-30);
	target->set_temp("guarding",0);
        target->start_busy(2);
	me->start_busy(1);
	msg = CYN "$N使出封山剑法「逐」字诀，剑芒一长，连续攻出数剑，";
//	printf("In swordjab:Who:%s:perform/逐=%d\n", me->query("id"),me->query_temp("perform/逐"));
	if( random( me->query("combat_exp") ) > (int)target->query("combat_exp")/4  
	 && !me->query_temp("In/逐") )
	{
		msg += "结果$p被$P被连刺数剑！\n" NOR;
		message_vision(msg,me,target);
		me->set_temp("In/逐",1);
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK);
		me->set_temp("perform/逐",0);
	} else {
		msg += "可是$p看破了$P的企图，闪身避开。\n" NOR;
		me->set_temp("perform/逐",0);
		me->set_temp("In/逐",0);
		message_vision(msg,me,target);
	}
	return 1;
}


