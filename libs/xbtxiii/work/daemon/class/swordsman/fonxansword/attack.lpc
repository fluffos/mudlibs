#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  int level, temp;
  string msg;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("八阴追魂只能对战斗中的对手使用。\n");
  if (me->query_temp("eight_chaos") >= 1)
    return notify_fail("你现在正在施展这招。。。\n");

  level = me->query_skill("fonxansword", 1);

  if (level < 120 && level >= 100)
    temp = 7;
  else if (level < 100 && level >= 90)
    temp = 6;
  else if (level < 90 && level >= 80)
    temp = 5;
  else if (level < 70 && level >= 60)
    temp = 4;
  else if (level < 60 && level >= 50)
    temp = 3;
  else if (level < 50 && level >= 40)
    temp = 2;
  else if (level < 40 && level > 0)
    temp = 1;
  else
    temp = 8;
  me->set_temp("can_attacks", temp);
  me->set_temp("now_attacks", 1);
  me->set_temp("eight_chaos", 1);
  msg = HIW "$N神情庄重，毅然使出封山剑法中最后一招－－八阴追魂。。。\n" NOR;
  message_vision(msg, me, target);
  this_object()->agress(me, target);
  return 1;
}

int agress(object me, object target) {
  int j, attacked_times, attack_times, busy;
  string msg;
  if (!me || !objectp(me) || !target || !objectp(target)) return 1;
  attack_times = me->query_temp("can_attacks");
  attacked_times = me->query_temp("now_attacks");
  if (!target
    || environment(target) != environment(me)
    || target->query("kee") <= 0
    || me->query("kee") <= 0
    || me->query("sen") <= 0
    || me->query("gin") <= 0
    || !me->is_fighting()) {
    me->delete_temp("now_attacks");
    me->delete_temp("can_attacks");
    me->delete_temp("eight_chaos");
    me->start_busy(-100);
    return 1;
  }
  if (me->query_temp("weapon")) {
    if (attacked_times <= attack_times) {
      switch (attacked_times) {
        case 1:
          msg = HIW "第一招------魔火天焚\n" NOR;
          break;
        case 2:
          msg = HIW "第二招------魔王食飧\n" NOR;
          break;
        case 3:
          msg = HIW "第三招------魔吼天地\n" NOR;
          break;
        case 4:
          msg = HIW "第四招------魔弑森森\n" NOR;
          break;
        case 5:
          msg = HIW "第五招------乾坤尽魔\n" NOR;
          break;
        case 6:
          msg = HIW "第六招------魔高和寡\n" NOR;
          break;
        case 7:
          msg = HIW "第七招------魔海漭漭\n" NOR;
          break;
        case 8:
          msg = HIW "$N意气英发，使出天地动容的最后一招------璞宇浑魔\n" NOR;
          break;
      }
      message_vision(msg, me, target);
      for (j = 1; j <= attacked_times; ++j) {
        message_vision(HIR "\t\t第～　　" + j + "　　～　　剑。。。\n" NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        if (!target
          || environment(target) != environment(me)
          || target->query("kee") <= 0
          || me->query("kee") <= 0
          || me->query("sen") <= 0
          || me->query("gin") <= 0) {
          me->delete_temp("now_attacks");
          me->delete_temp("can_attacks");
          me->delete_temp("eight_chaos");
          me->start_busy(-100);
          return 1;
        }
      }
      switch (attacked_times) {
        case 1: busy = 1; break;
        case 2: busy = 1; break;
        case 3: busy = 2; break;
        case 4: busy = 3; break;
        case 5: busy = 3; break;
        case 6: busy = 4; break;
        case 7: busy = 6; break;
        case 8: busy = 8; break;
        default: busy = 0; break;
      }
      me->start_busy(busy);
      call_out("agress", busy, me, target);
      me->add_temp("now_attacks", 1);
      return 1;
    } else {
      me->delete_temp("now_attacks");
      me->delete_temp("can_attacks");
      me->delete_temp("eight_chaos");
      me->start_busy(-100);
      return 1;
    }
  } else {
    me->delete_temp("now_attacks");
    me->delete_temp("can_attacks");
    me->delete_temp("eight_chaos");
    me->start_busy(-100);
    return 1;
  }
}
