#pragma save_binary
// master.c

inherit NPC;
inherit F_MASTER;
inherit F_QUEST;

void create()
{
        set_name("柳淳风", ({ "master swordsman", "swordsman", "master" }) );
        set("nickname", "风雨双侠");
        set("gender", "男性" );
        set("shen_type", 1);
        set("age", 44);
        set("str", 27);
        set("cor", 30);
        set("cps", 27);
        set("int", 24);

        set("max_force", 1500);
        set("force", 1500);
        set("force_factor", 10);

        set("rank_info/respect", "柳馆主");

        set("long",
                
"柳淳风是个相当高大的中年儒生，若不是从他腰间挂著的「玄苏剑」你\n"
                "大概猜不到眼前这个温文儒雅的中年人竟是家大武馆的馆主。\n");

        create_family("封山派", 13, "掌门人");

        set("combat_exp", 1000000);

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword.counterattack" :),
                (: perform_action, "sword.swordjab" :),
                (: perform_action, "sword.powerfocus" :),
                (: perform_action, "sword.fakefault" :),
        (: perform_action, "sword.attack" :),
        }) );

        set_skill("unarmed",150);
        set_skill("parry", 150);
        set_skill("dodge", 150);
        set_skill("sword", 200);
        set_skill("force",150);
        set_skill("literate", 100);

        set_skill("fonxanforce",180);
        set_skill("fonxansword", 180);
        set_skill("liuh-ken",150);
        set_skill("chaos-steps", 180);
//      set_skill("spider-array", 85);

        map_skill("unarmed", "liuh-ken");
        map_skill("force","fonxanforce");
        map_skill("sword", "fonxansword");
        map_skill("parry", "fonxansword");
        map_skill("dodge", "chaos-steps");
        map_skill("move","chaos-steps");
        set("inquiry", ([
                "淳风武馆" : 
"淳风武馆是先父所创，在下辱承其名，虽忝掌封山门户，不敢忘了先人遗志。",
                "先人遗志" : 
"先父临终之时将这武馆交到在下手中，需得好好照看。",
                "刘安禄" : "刘兄弟在寒舍管事已经五年了，过去之事不须再提。",
                "name": "你既然知道我是柳□主，怎麽不知道我是柳淳风？",
                "here": "这里便是淳风武馆。",
        ]) );

        setup();
        carry_object(__DIR__"blackthorn")->wield();
        carry_object(__DIR__"silk_cloth")->wear();
}


void init()
{
object ob;

::init();
if( interactive(ob = this_player()) && !is_fighting() )
      {
remove_call_out("greeting");
call_out("greeting", 1, ob);
        }
add_action("give_quest","quest");
}

void greeting(object ob)
{
if( !ob || environment(ob) != environment() ) return;
 if((string)ob->query("family/family_name") == "天邪派")
  if( (int)ob->query("MKS") > 1000 )  
{
        command("say 好你个天邪弟子，又想来我封山武馆捣乱？");
      kill_ob(ob);
       }
      else {
message_vision("\n柳馆主看到$N闯进来，大喝一声：你这个恶魔，给我滚出去！\n\n", ob);
    ob->move("/d/ny/school2");
}
}
void attempt_apprentice(object ob)
{
        if( ((int)ob->query("cor") < 10) 
        ||      ((int)ob->query("cps") < 10)) {
                command("say 学剑之人必须胆大心细，依我看" + 
RANK_D->query_respect(ob) + "的资质似乎不宜？");
                return;
        }
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + 
"多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
        ob->set("class", "swordsman");
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "swordsman");
}
 
void questbonus(object ob)
{
if(random(3)<1)
   ob->set("quest/fealty",2);
else ob->set("quest/fealty",1);
}

