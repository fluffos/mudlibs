//zhangwuji.c

#include <ansi.h>

inherit F_MASTER;
inherit F_UNIQUE;
inherit NPC;
int ask_me();
void greeting(object ob);
void create()
{
    seteuid(getuid());
	set_name("张无忌", ({ "zhang wuji", "zhang", "wuji" }));
	set("long", "明教教主张无忌，统领天下十万教众，豪气干云，叱咤千秋，\n"
               +"「九阳神功」、「乾坤大挪移」独步天下，是江湖中不世出的\n"
               +"少年英雄。\n");
    set("title","明教第三十四代教主");
	set("gender", "男性");
    set("age", 20);
	set("shen_type",1);
    set("attitude", "friendly");

    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);

    set("qi", 3050);
    set("max_qi", 3050);
    set("jing", 3050);
    set("max_jing", 3050);
    set("neili", 5000);
    set("max_neili", 5000);
    set("jiali", 120);

    set("combat_exp", 7000000);
    set("score", 455000);
    
    set_skill("force", 350);
    set_skill("dodge", 350);
    set_skill("parry", 350);
    set_skill("jiuyang", 350);
    set_skill("lingfa", 350);
    set_skill("shenghuo-lingfa", 350);
	set_skill("qiankun-nuoyi", 350);
	map_skill("parry", "qiankun-nuoyi");
	map_skill("force", "jiuyang");
	map_skill("dodge", "qiankun-nuoyi");
	map_skill("lingfa", "shenghuo-lingfa");

    create_family("明教",34, "教主");
	set("chat_chance", 500);
	set("chat_msg", ({
		(: exert_function, "recover" :),
		(: exert_function, "heal" :),
	}) );

	set("chat_chance_combat", 10);
	set("chat_msg_combat", ({
                (: perform_action, "lingfa.duo" :),
		(: exert_function, "recover" :),
		}) );

        set("inquiry", ([
		"乾坤大挪移" : (: ask_me :),
	
        ]) );
		setup();
//                carry_object("/d/mj/obj/tieling")->wield();
//        carry_object("/d/mj/obj/baipao")->wear();

}

void init()
{
	object ob;

	::init();

	if( interactive(ob=this_player()) && !is_fighting())
	{
		remove_call_out("greeting");
		call_out("greeting",1,ob);
	}
}

void greeting(object ob)
{
	if(!ob || environment(ob)!=environment()) return;
	if((int)ob->query("shen")<-50000)
	{
//      command("say
		command("wield yitian jian");
		command("hit"+(string)ob->query("id"));
		command("unwield uitian jian");
	}
	else if((int)ob->query("shen")<-5000)
	{
		command("say 魔从心起，于武学不利，其道必诛，劝君放下屠刀，立地成佛.");
	}
	else if((int)ob->query("shen")<-100)
	{
		command("say 这位朋友，人行江湖，言行当正，切务走进邪魔歪道.");
	}
	else if((int)ob->query("shen")>=0)
	{
		command("say 光明正道任人走，劝君多加保重.");
	}
	else if((int)ob->query("shen")>20000)
	{
		command("say 大侠在上，受无忌一礼，大侠它日必为武林翘楚.");
	}
	return;
}



void attempt_apprentice(object ob)
{
	if((int)ob->query("int")<30)
	{
		command("say 你的悟性太低了，不适合学习我的功夫。");
		return 0;
	}
	if((int)ob->query_skill("force")<100)
	{
		command("say 你的基本内功太低了，学习我的功夫会伤及自身。");
		return 0;
	}

	if((int)ob->query("shen") <= 15000)
	{
		command("say 你应当多作些行侠仗义的事，以修身心。");
		return 0;
	}
	command("recruit " + ob->query("id"));
        ob->set("title",HIW"明教教主亲传弟子"NOR);
	command("say 好，我就收下你这位好兄弟");
	command("say 再接再砺！");
	return;
}

int accept_fight(object ob)
{
    if(((int)ob->query("combat_exp")<30000)&&((int)ob->query("shen")>0))
    {
        message_vision("武林中人最忌争强斗狠，你不是我的对手，回去吧。\n",ob);
        return 0;
    }
    message_vision("张无忌一拱手说道：这位"+RANK_D->query_respect(ob)+
	"，在下领教了。\n", ob);
    return 1;
}
int ask_me()
{	object obj,me;
	me=this_player();
	if(this_player()->query_skill("shenghuo-xinfa",1)<100) 
	{
		 command("say "+RANK_D->query_respect(me)+"似乎圣火心法修为还不够。");
	return 1;
	}
	if(this_player()->query("combat_exp")<800000) 
	{
		 command("say "+RANK_D->query_respect(me)+"似乎实战经验还不够。");
	return 1;
	}
	if(this_player()->query_skill("force",1)<100) 
	{
		 command("say "+RANK_D->query_respect(me)+"似乎基本内功修为还不够。");
	return 1;
	}
      	if ( this_player()->query_temp("marks/挪移") ) {
	    command("say "+"你不是刚刚才问过吗？");return 1;
	}
	else {  
		

		command("say "+"好吧，我就准许你进入秘室修炼乾坤大挪移。以后你要发扬光大明教。");
		command("say "+"你到张中前辈那里去就说是我准许的。");
		command("pat "+me->query("id") );
		command("addoil "+me->query("id") );
		
		
		this_player()->set_temp("marks/挪移", 1);return 1;
	}
	
}

