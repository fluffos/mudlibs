// FanYao.c
// pal 1997.05.09

#include "ansi.h"

inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;

string ask_me();

void create() {
  set_name("范遥", ({ "fan yao", "fan", "yao", }));
  set("long",
    "他是一位带发修行的头陀，身穿白布长袍。\n"
    "他的脸上七七八八的全是伤疤，简直看不出本来面目了。\n"
  );

  set("title", HIG "明教" HIR "光明右使" NOR);
  set("nickname", HIY "苦大师" NOR);
  set("level", 11);
  set("gender", "男性");
  set("attitude", "peaceful");
  set("class", "bonze");

  set("age", 38);
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 3500);
  set("max_jing", 1500);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jiali", 150);
  set("combat_exp", 1000000);
  set("score", 800000);

  set_skill("force", 200);
  set_skill("shenghuo-shengong", 200);
  set_skill("dodge", 200);
  set_skill("xiaoyao-bu", 200);
  set_skill("shenghuo-xinfa", 200);
  set_skill("parry", 200);
  set_skill("blade", 200);
  set_skill("fenglei-dao", 200);
  set_skill("buddhism", 200);
  set_skill("literate", 200);

  map_skill("force", "shenghuo-shengong");
  map_skill("dodge", "xiaoyao-bu");
  map_skill("blade", "fenglei-dao");
  map_skill("parry", "fenglei-dao");
  create_family("明教", 35, "护法");
  set("chat_chance", 500);
  set("chat_msg", ({
    (: exert_function, "recover" :),
    (: exert_function, "heal" :),
  }));



  setup();
  carry_object("/d/mj/obj/gangdao")->wield();
  carry_object("/d/mj/obj/baipao")->wear();
}


void attempt_apprentice(object ob) {

  if ((int)ob->query_skill("force") < 60) {
    command("say 你的基本内功太低了，学习武功要先打好基础。");
    return 0;
  }

  if ((int)ob->query("shen") <= 1000) {
    command("say 你应当多作些行侠仗义的事，以修身心。");
    return 0;
  }
  command("recruit " + ob->query("id"));
  ob->set("title", "明教光明右使座下弟子");
  command("say 好，我就收下你这位好兄弟");
  command("say 再接再砺！");
  return;
}
void init() {
  object ob;
  mapping myfam;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    myfam = (mapping)ob->query("family");
    if ((!myfam || myfam["family_name"] != "明教")) {

      remove_call_out("do_killing");
      call_out("do_killing", 4, ob);
    }
  }
}
void do_killing(object ob) {
  if (!ob || environment(ob) != environment())
    return;
  command("consider " + ob->query("id"));
  this_object()->kill_ob(ob);
}
