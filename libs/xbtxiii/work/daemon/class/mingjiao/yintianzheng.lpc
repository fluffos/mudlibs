#include "ansi.h"

int do_killing(object ob);

inherit NPC;
inherit F_MASTER;
int ask_me();

void create()
{
    set_name("殷天正", ({"yin tianzheng", "yin", "tianzheng", }));
	set("long",
        "他是一位身材魁梧的秃老者，身穿一件白色长袍。\n"
        "他长眉胜雪，垂下眼角，鼻子钩曲，犹如鹰嘴。\n"
	);
                                                          
	set("title",HIG "明教" HIW "白眉鹰王" NOR);
	set("level",9);
	set("gender", "男性");
	set("attitude", "peaceful");

	set("age", 72);
	set("shen_type", 1);
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);

	set("qi", 3500);
	set("max_qi", 3500);
	set("jing", 1500);
	set("max_jing", 1500);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jiali", 150);
	set("combat_exp", 900000);
	set("score", 1000000);

	set_skill("force", 180);
	set_skill("dodge", 120);
	set_skill("parry", 120);
	set_skill("hand", 200);
	set_skill("literate", 100);
	set_skill("shenghuo-shengong", 180);
	set_skill("shenghuo-xinfa", 150);
	set_skill("xiaoyao-bu", 120);
	set_skill("yingzhua-shou", 250);


	map_skill("force", "shenghuo-shengong");
	map_skill("dodge", "xiaoyao-bu");
	map_skill("hand", "yingzhua-shou");
	map_skill("parry", "yingzhua-shou");
	prepare_skill("hand","yingzhua-shou");
	set("chat_chance", 500);
	set("chat_msg", ({
		(: exert_function, "recover" :),
		(: exert_function, "heal" :),
	}) );

	set("chat_chance_combat", 10);
	set("chat_msg_combat", ({
		(: command("perform muyeyingyang") :),
	}) );

    create_family("明教",35, "护法");
	

        set("inquiry", ([
		"护教" : (: ask_me :),
	
        ]) );

	setup();

	carry_object("/d/mj/obj/baipao")->wear();
}



void attempt_apprentice(object ob)
{

	if((int)ob->query_skill("force")<40)
	{
		command("say 你的基本内功太低了，学习武功要先打好基础。");
		return 0;
	}

	if((int)ob->query("shen") <= 1000)
	{
		command("say 你应当多作些行侠仗义的事，以修身心。");
		return 0;
	}
	command("recruit " + ob->query("id"));
	ob->set("title","明教护教法王座下弟子");
	command("say 好，我就收下你这位好兄弟");
	command("say 我明教又得一个可塑之才，可喜可贺！");
	return;
}
void init()
{
        object ob;
        mapping myfam;

        ::init();
        	if(this_player()->query_temp("marks/护教2")) 
	{ call_out("back",1,ob);
	}
        if (interactive(ob = this_player()) && !is_fighting()) {
                myfam = (mapping)ob->query("family");
                if ((!myfam || myfam["family_name"] != "明教") ) {
		        
                        remove_call_out("do_killing");
                        call_out("do_killing",4,ob);
                }
        }
}
int do_killing(object ob)
{
	if (!ob || environment(ob) != environment())
                return 1;
	command("consider " +ob->query("id") );
        this_object()->kill_ob(ob);
}
int ask_me()
{	object ob;
      	if ( this_player()->query_temp("marks/护教1") ) {
	    command("say "+"如果"+this_player()->query("name")+"不想护教就退出吧。");return 1;
	}
      	if ( this_player()->query("combat_exp") >20000)  {
	    command("say "+ this_player()->query("name")+"武功高强，护教这些事就留给后辈人来做吧。");return 1;
	}
      	if ( this_player()->query_temp("marks/护教3") ) {
	    command("say "+"现在没有任务分派给你，"+this_player()->query("name")+"休息休息再来吧。");return 1;
	}	
	
	command("say "+"现在正好缺少人手"+this_player()->query("name")+"就到山脚下去护教吧。以防六大派偷袭光明顶。");
		
		this_player()->set_temp("marks/护教1", 1);	
	call_out("hujiao",150,ob);
	return 1;
}

int hujiao(object ob)
{      ob=this_player();
	write(HIY"你的护教时间到了，该回去复命了。\n"NOR);
	ob->set_temp("marks/护教2",1);
	
}

int back(object ob)
{      	if ( this_player()->query_temp("marks/护教ok") ) {

 	  command("say "+this_player()->query("name")+"干得好，老夫没有什么奖励你的，就教你一些实战经验吧。");
	  this_player()->add("combat_exp",70+random(40));
	  if (this_player()->query("potential")<=100) this_player()->add("potential",20+random(10));
	  this_player()->delete_temp("marks/护教2");
	  this_player()->delete_temp("marks/护教ok");
	  this_player()->delete_temp("marks/护教1");
	  this_player()->set_temp("marks/护教3",1);
	  call_out("waiting",50,ob);
	  return 1;
	}
     	if ( this_player()->query_temp("marks/护教2") && !this_player()->query_temp("marks/护教ok"))
	 {
	command("say "+"你根本就没有参加护教，回来复什么命啊？");
	  this_player()->delete_temp("marks/护教2");
	  this_player()->delete_temp("marks/护教1");
	  call_out("waiting",50,ob);
	  return 1;}
}
int waiting(object ob)
{
this_player()->delete_temp("marks/护教3");
this_player()->delete_temp("marks/护教1");
}