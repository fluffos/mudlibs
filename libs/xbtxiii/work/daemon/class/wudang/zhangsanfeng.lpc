#pragma save_binary
// /daemon/class/wudang/zhang.c 张三丰

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("张三丰", ({ "zhang sanfeng", "zhang" }));
  set("nickname", "邋遢真人");
  set("long",
    "他就是武当派开山鼻祖、当今武林的泰山北斗张三丰真人。\n"
    "身穿一件污秽的灰色道袍，不修边幅。\n"
    "身材高大，年满百岁，满脸红光，须眉皆白。\n");
  set("gender", "男性");
  set("age", 100);
  set("str", 30);
  set("int", 30);
  set("con", 30);

  set("max_kee", 5000);
  set("atman", 3000);
  set("max_atman", 3000);
  set("force", 5000);
  set("max_force", 5000);
  set("force_factor", 30);
  set("combat_exp", 2000000);

  set_skill("force", 150);
  set_skill("taiji-shengong", 150);
  set_skill("dodge", 150);
  set_skill("tiyunzong", 150);
  set_skill("unarmed", 200);
  set_skill("taiji-quan", 200);
  set_skill("parry", 120);
  set_skill("sword", 120);
  set_skill("taiji-jian", 120);
  set_skill("literate", 100);

  map_skill("force", "taiji-shengong");
  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-quan");
  map_skill("parry", "taiji-quan");
  map_skill("sword", "taiji-jian");

  create_family("武当派", 1, "开山祖师");
  set("class", "taoist");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.zhen" :),
  }));
  setup();
  add_money("silver", 100);
  carry_object("/obj/cloth")->wear();
}


void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

int heal_up() {
  int t, d, h, m, s;
  object me;
  object *ob;
  string room;
  me = this_player();
  t = uptime();
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;
  if (this_object()->is_fighting())
    return 1;
  if (m >= 0 && m < 20 && query("i_am_in_room") != "chashi") {
    ob = all_inventory(environment());
    command("say 好累啊，我得去休息休息去了。");
    command("say 你们有事的话，去武当茶室找我好了！");
    message("vision", "张三丰缓缓的离开了。。。。好象是朝武当茶室的方向。。\n", ob);
    room = ("/d/wudang/chashi");
    this_object()->move(room);
    ob = all_inventory(environment());
    message("vision", "张三丰缓缓的走了过来。\n", ob);
    command("say 呵呵，我休息休息。。。");
    this_object()->delete("short");
    set("short", "张三丰 (zhang sanfeng)" + HIR "<正在喝茶>" NOR + "");
    set("i_am_in_room", "chashi");
  }
  if (m >= 20 && m < 40 && query("i_am_in_room") != "wc") {
    ob = all_inventory(environment());
    message("vision", "张三丰忽然神色紧张，好象出了什么问题。\n"
      "片刻，张三丰慌慌张张的离开了。好象是朝茅房的方向。。\n", ob);
    room = ("/d/wudang/wc");
    this_object()->move(room);
    ob = all_inventory(environment());
    message("vision", "张三丰急急忙忙的跑了过来。。然后就。。。。。。\n", ob);
    this_object()->delete("short");
    set("short", "张三丰 (zhang sanfeng)" + HIR "<正在大便>" NOR + "");
    set("i_am_in_room", "wc");
  }
  if (m >= 40 && m < 59 && query("i_am_in_room") != "xiaoyuan") {
    ob = all_inventory(environment());
    message("vision", "好了，我也该去练功了。。。。张三丰缓缓的离开了\n"
      "好象是朝小园的方向。。\n", ob);
    room = ("/d/wudang/xiaoyuan");
    this_object()->move(room);
    ob = all_inventory(environment());
    message("vision", "张三丰急急忙忙的跑了过来。。然后就。。。。。。\n", ob);
    this_object()->delete("short");
    set("short", "张三丰 (zhang sanfeng)" + HIR "<正在练功>" NOR + "");
    set("i_am_in_room", "xiaoyuan");
  }
  ::heal_up();
}
void come_in(object me)  //这一段程序由/d/wudang/liangongfang.c所呼叫。
{
  call_out("give_player_book", 3, me);
}

void give_player_book(object me) {
  object book;

  message("vision", CYN "张三丰笑着对" + me->name() + "说：" + me->name() + ",天都这么晚了，还不去歇息啊.\n"
    "还在这里练功啊!恩，精神可嘉，我武当派有你这样的徒弟\n"
    "实在是我武当派之大幸啊。哈哈，好！好！好！这里有一本\n"
    "关于修生养息的秘籍，就给了你吧。\n" NOR, me);
  book = new("/d/wudang/obj/taiji-quan");
  book->move(this_object());
  command("give " + me->query("id") + " " + book->query("id") + "");
  message("vision", CYN "张三丰说：虽然这本书不是什么天大的武林秘籍.\n"
    "但是上面的武功也非常之精深，你要好好研究，将来好将\n"
    "我武当派发扬光大好了，天色不早了，我也要歇息去了。\n"
    "你也早点歇息吧。\n" NOR, me);

  call_out("leave_here", 3, me);

}

void leave_here(object me) {
  message_vision("张三丰飘然而去\n", me);
  destruct(this_object());

}
int accept_fight(object me) {
  if (me->query("family/family_name") == "武当派")

    message_vision(CYN "$N大声说道：太师傅。。。江湖上人人都说您老人家\n"
      "的太级剑法当世无双，弟子不才，斗胆领教!!!\n" NOR, me);

  else
    message_vision(CYN "$N大声喝道：久问张真人乃当今武林泰斗，" + RANK_D->query_self(me) + "\n"
      "斗胆请教一下张真人的绝学太级剑法!还请张真人赐教!!!\n" NOR, me);

  if (query("kee") <= query("max_kee") / 2) {
    command("say 我哪里是" + RANK_D->query_respect(me) + "的对手???");
    return 0;
  }

  command("say 噢？好好好。" + me->name() + ",你就接招吧......");
  return 1;
}

void attempt_apprentice(object ob) {
  int student_num;
  string temp, line;
  if (ob->query("fealty") < 2000) {
    tell_object(ob, "张三丰露出不太信任你的神色。。。你还是想办法增加一下忠诚度吧\n");
    return;
  }
  temp = read_file("/daemon/class/wudang/ZHANGSANFENG", 1, 1);
  student_num = atoi(temp);

  line = "张三丰说道：“我现在共有" + temp + "个徒弟。”\n";
  write(line);

  if (student_num == 3) {
    command("say 你来晚了，我已经收了三个徒弟了。");
    return;
  }
  write_file("/daemon/class/wudang/ZHANGSANFENG", "1", 1);
  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
  ob->set("class", "taoist");
}
