#pragma save_binary
// xiaosong.c 宋青书

#include <ansi.h>
inherit NPC;
int ask_me();
void create() {
  set_name("宋青书", ({ "song qingshu", "song" }));
  set("long",
    "他就是宋远桥的儿子宋青书。\n"
    "他今年二十岁，乃是武当第三代中出类拔萃的人物。\n");
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");
  set("shen_type", 0);
  set("str", 25);
  set("int", 28);
  set("con", 25);

  set("max_kee", 1000);
  set("atman", 500);
  set("max_atman", 500);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 10);
  set("combat_exp", 800000);
  set("score", 10000);

  set_skill("force", 80);
  set_skill("taiji-shengong", 80);
  set_skill("dodge", 80);
  set_skill("tiyunzong", 80);
  set_skill("unarmed", 80);
  set_skill("taiji-quan", 100);
  set_skill("parry", 100);
  set_skill("sword", 80);
  set_skill("taiji-jian", 100);

  map_skill("force", "taiji-shengong");
  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-quan");
  map_skill("parry", "taiji-jian");
  map_skill("sword", "taiji-jian");

  create_family("武当派", 3, "弟子");
  set("inquiry", ([
    "莫声谷": (: ask_me :),
    "七师叔": (: ask_me :),
    "七师兄": (: ask_me :),
    "周芷若": "怎么你也认识姐姐么? 唉，我好久没有见他了!!",
  ]));
  setup();
  carry_object("/obj/weapon/sword")->wield();
  carry_object("/obj/cloth")->wear();
}
int ask_me() {
  int age;
  object me;
  me = this_player();
  age = this_player()->query("age");
  switch (age) {
    case 14:
      command("say 去。。去。。去。。这些事不是你应该打听的，给我滚到一边去练功去");
      break;
    case 15:
      command("say 我......我。。。。。我不知道，你去问问别人吧");
    default:
      message_vision(CYN "宋青书忽然脸色大变。\n"
        "宋青书对$N说道：好小子，你既然全部都知道了，我也不瞒你。\n"
        "哼！！！七师叔是我杀的。谁叫他逼人太甚呢？哈哈哈。。。\n"
        "哼！！！这些还不是全都是张无忌那个小淫贼，整天钩三搭四.\n"
        "既然已经和芷若姐姐盯了婚，为什么还要离他而去！！！这个淫贼\n"
        "我。。。。。我。。。。今天我一不做。。。二不休。。连你也杀了\n" NOR, me);
      this_object()->set("disclosure", 1);
      //disclosure:被发觉了。void die()有用。
      this_object()->kill_ob(me);
      call_out("do_clone", 5, me);
      break;
  }
  return 1;
}

void do_clone(object me) {
  object ob;
  message_vision(CYN "忽然宋远桥从旁边跳了出来\n" NOR, me);
  message_vision(CYN "宋远桥大喝一声:你这个畜生!!!刚才的话我全部都听见了.\n"
    "我好悔呀！！生了你这一个不肖儿子!!!!你。。。。。你。。。。\n"
    "宋远桥仰天大喊:七师弟。。。我对不起你啊。。。。。。。。。\n"
    "好。。好。。我今天就杀了他这个畜生，替你报仇......\n" NOR, me);
  ob = new(__DIR__ "song");
  ob->move(environment(this_object()));
  ob->kill_ob(this_object());
  this_object()->kill_ob(ob);
  me->remove_killer(this_object());
  this_object()->remove_killer(me);
}

void die() {
  object song, me;
  me = this_player();
  song = present("song yuanqiao", environment(this_object()));
  if (song && this_object()->query("disclosure") == 1) {
    //事情败露的情况下被杀的。 
    message_vision(CYN "宋青书忽然大哭:爹。。。。。我好后悔呀........\n"
      "宋远桥抱着宋青书不禁老泪纵横.\n"
      "宋远桥说道:孩子，我的孩子啊！！！不要怪爹呀，，真是作孽呀.\n"
      "宋远桥喊道:老天爷呀，你为什么要这样对我啊？呜。。。。。。呜。。。呜。。。。呜 \n"
      "宋远桥抱着宋青书的尸体夺门而出，转眼间就不见了\n" NOR, me);
    destruct(song);
    destruct(this_object());
  } else ::die();

}
void unconcious() {
  ::die();
}
