#pragma save_binary
// jiazhen(master.c) made by ress on 3.15 

inherit NPC;
inherit F_MASTER;

mixed out_master(mixed arg);
mixed out_master(mixed arg)
{
   object me;
   me = this_player();
   if( (string)me->query("family/family_name")!="红楼")
   {
   tell_object(me,"贾政群疑惑地对你说:我不记得你是我的弟子，有没有搞错啊!\n");
    return 1;
    }
if(me->query("gender")!="男性"){
  tell_object(me,"这位小姑娘,你是我内人的徒弟,你该出找她出师才是!\n");
return 1;
}
if(me->query("combat_exp") <= 100000) {
tell_object(me,"贾政对"+me->query("name")+"怒道:就凭你这点功夫就想出去丢脸？\n");
   return 1;
   }

tell_object(me,"贾政沉吟了一会,对"+me->query("name")+"说道:要想出师,
          你必须接我三招不死(accept test).\n");
   add_action("do_accept","accept");       
   return 1;
}



void create()
{
	set_name("贾政", ({ "master jiazhen", "master", "jiazhen" }) );
        set("title", "贾母次子，员外郎");
	set("gender", "男性");
	set("age", 50);
	set("long",
		"贾政自幼酷爱读书，为人方正，加之又有一省武功，为朝野人士所敬仰。\n");
	set("attitude", "peaceful");

	set("str", 26);
	set("cor", 30);
	set("int", 30);
	set("cps", 30);

	set("force", 4000);
	set("max_force", 2400);
	set("force_factor", 30);

        set("atman", 1000);
        set("max_atman", 1000);

        set("mana", 1000);
        set("max_mana", 1000);


	set("combat_exp", 1000000);
	set("score", 200000);

        set("apprentice_available", 5);

	set("chat_chance_combat", 80);
	
        set("chat_msg_combat", ({
"贾政怒道:你找我们红楼派的麻烦会后悔的,我们两府的人都不会放过你!\n",
	(: exert_function, "recover" :),
        }) );
	
        set("inquiry", ([
           "出师": (: out_master :),
        ]) );

	set_skill("unarmed", 80);
	set_skill("sword", 100);
	set_skill("force", 100);
	set_skill("parry", 80);
	set_skill("dodge", 100);
	set_skill("literate", 130);


	set_skill("fonxansword", 100);
	set_skill("iceforce", 100);
	set_skill("tiyunzong", 100);
	set_skill("stormdance",50);
       

	map_skill("sword", "fonxansword");
	map_skill("parry", "fonxansword");
	map_skill("force", "iceforce");
	map_skill("dodge", "tiyunzong");



	setup();

	
	carry_object("/obj/cloth")->wear();
    carry_object("/obj/longsword")->wield();

}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting",2 , ob);
        }
}
void greeting(object ob)
{
              
        if((int) ob->query("marks/dead") == 0)
        {
         
        say( "贾政说道：“这位"+ RANK_D->query_respect(ob) 
+"，可否见到小儿宝玉？” \n");
                }
        else
                call_out("killhim",1,ob);
}

void killhim(object ob)
{
        ob->set("marks/murder", 0);
        
               
say("贾政怒道：你居然竟敢在我们这里杀人，纳命来！\n");  

                set("chat_msg_combat", ({
"贾政怒道：你居然竟敢在我们这里杀人，纳命来！",
                (: random_move :),
        }) );
        set("chat_chance", 15);
        set("chat_msg", ({
"贾政怒道：你居然竟敢在我们这里杀人，纳命来！",
                (: random_move :),
        }) );
        
        kill_ob(ob);
        ob->kill_ob(this_object());

}
 


void attempt_apprentice(object ob)
{
        if( query("apprentice_available") ) {
                if( find_call_out("do_recruit") != -1 )
                        command("say 慢著，一个一个来。");
                else
                        call_out("do_recruit", 4, ob);
        } else {
                command("say 老夫今天已经收了五个弟子，不想再收徒了。");
        }
}

void do_recruit(object ob)
{
        if( (int)ob->query("int") < 25 )
                command("say 我红楼派以剑法为主，依我看"+
RANK_D->query_respect(ob)+"不适合于学剑法。");
        else {
                command("say 好，好，好，很好。");
                command("recruit " + ob->query("id") );
        }
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "reddream");
        add("apprentice_availavble", -1);
}
void reset()
{
//        delete_temp("learned");
        set("apprentice_available", 5);
}

int do_accept(string arg)
{
        mapping guild;

        if( arg== "test" ) {
                
say("\n贾政点了点头，说道：很好，小心了　，这是第一招....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(),
query_temp("weapon"));
                if( (int)this_player()->query("kee") < 0
                || !present(this_player(), environment())) {

say("贾政叹了口气，说道：唉，连第一招都撑不过，真是自不量力....\n");
                        return 1;
                }
                say("\n贾政喝道：第二招....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(),
query_temp("weapon"));
                if( (int)this_player()->query("kee") < 0
                || !present(this_player(), environment())) {

say("贾政叹道：这样子还想出师,唉.....\n");
                        return 1;
                }
                say("\n贾政怒道：第三招，让你偿偿老夫的利害!....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(),
query_temp("weapon"));
                if( (int)this_player()->query("kee") < 0
                || !present(this_player(), environment())) {

say("贾政笑道：嘿嘿，看样子姜还是老的辣,哼.....\n");
                        return 1;
}
say("\n贾政微笑道：恭喜,你出师了.你我师徒一场，师傅没什么好送的 .
\n为师送你八字真言:天外有天,人外有人!徒儿,喔,不...大侠你好自为知.\n\n");
       this_player()->set("betrayer",this_player()->query("betrayer")-1);
       this_player()->set("title","隐士");
       this_player()->set("family/family_name","红楼");
       this_player()->set("family/generation",1);
       this_player()->set("family/master_name",0);
       command("chat " + 
this_player()->query("name")+"已脱离荣府，日后一切江湖
           恩怨均与红楼派无关.\n");
                return 1;
        }
        return 0;
}

void die()
{
        int i;
        object ob;

        if(objectp(ob = query_temp("last_damage_from")))
            ob->set("marks/dead", 1);

        ::die();

}
