// jiamother.c

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void use_poison();

void create()
{
        set_name("贾母", ({ "master jiamother", "master", "jiamother" }) );
        set("title","红楼派开山师祖");
        set("nickname",MAG"荣国府太上老君"NOR);
        set("gender", "女性");
        set("age", 70);
        set("long",
        "贾母是荣国府现在的老夫人\n"
        );
        set("attitude", "peaceful");
//	set("class", "dancer");
        set("apprentice_available", 10);

        set("str", 30);
        set("int", 26);
        set("spi", 30);
        set("per", 30);
        set("cps", 30);

        set("force", 5000);
        set("max_force", 5000);
	set("force_factor", 30);

        set("combat_exp", 1500000);
        set("score", 200000);

         set("inquiry", ([
                "武学" : "武学博大精深，永无止境。\n",
                "往事" : "我以前也很美丽的。 \n",
       "拜师" : "有志气的孩子,想拜我为师的，是真心吗?(accept test)？\n"
        ]) );
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                "贾母身形变幻,但动作优美,如轻歌曼舞。\n",
                "贾母用手扶了扶自己的发簪，像是怕被对手碰歪似地。\n",
                "贾母唉地叹了一口气，好象有什么心事。\n",
                 (: exert_function, "recover" :),
        }) );

        set_skill("unarmed", 150);
        set_skill("sword", 120);
        set_skill("throwing", 90);
	set_skill("force", 150);
        set_skill("parry", 120);
	set_skill("dodge", 120);
        set_skill("literate", 100);
        set_skill("perception", 150);
        set_skill("sword", 150);

	set_skill("stormdance", 150);
        set_skill("tenderzhi", 100);
        set_skill("iceforce", 100);

        map_skill("dodge", "stormdance");
        map_skill("unarmed", "tenderzhi");
        map_skill("force", "iceforce");

	assign_apprentice("弟子", 0);

        set_temp("apply/defense", 100);

        setup();

//    carry_unique("/d/jiangnan/daguanyuan/obj/jiasword","/obj/weapon/sword")->wield();
        carry_object("/d/jiangnan/daguanyuan/obj/jiadress")->wear();
        carry_object("/d/jiangnan/daguanyuan/obj/jiasandal")->wear();
}
void init()
{
        object ob;

        ::init();
	
        add_action("do_accept", "accept");
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting",2 , ob);
        }
}


void greeting(object ob)
{
              
        if((int) ob->query("marks/dead") == 0)
        {
         
        say( "贾母说道：“这位"+ RANK_D->query_respect(ob) 
+"，可否见到和黛玉、宝玉？” \n");
                }
        else
                call_out("killhim",1,ob);
}

int killhim(object ob)
{
        
               
say("贾母怒道：你居然竟敢在我们这里杀人，纳命来！\n");  

                set("chat_msg_combat", ({
"贾母怒道：你居然竟敢在我们这里杀人，纳命来！",
                (: random_move :),
        }) );
        set("chat_chance", 15);
        set("chat_msg", ({
"贾母怒道：你居然竟敢在我们这里杀人，纳命来！",
                (: random_move :),
        }) );
        
        kill_ob(ob);
        ob->kill_ob(this_object());

}
 



int do_accept(string arg)
{

        if( (string)this_player()->query("gender") != "女性" ) {
        command("say 我不收男弟子！");
                return 1;
        }
        else {
        if( arg== "test" ) {
                say("\n贾母说道，好孩子，小心了，这是第一招....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(), 
                        query_temp("weapon"));
                if( (int)this_player()->query("kee") < 0 
                || !present(this_player(), environment())) {
                say("\n贾母叹了一口气道: 好孩子,别勉强了. n");
                        return 1;
                }
                say("\n贾母说道: 嗯, 这是第二招了....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(), 
                        query_temp("weapon"));
                if( (int)this_player()->query("kee") < 0 
                || !present(this_player(), environment())) {
                        say("贾母道：好孩子,别打坏了你....\n");
                        return 1;
                }
                say("\n贾母说道：好了这最后一招可要接好....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(), 
                        query_temp("weapon"));
                if( (int)this_player()->query("kee") < 0 
                || !present(this_player(), environment())) {
                        
                say("贾母道：好孩子，能接我俩招，只可惜....\n");
                        return 1;
                }
                
		say("\n贾母轻轻抚摸着你的头发道: 很好，只要你好好学,它日成就不可限量\n\n");
                command("recruit " + this_player()->query("id") );
                this_player()->set("title","红楼派开山大弟子");
                return 1;
        }
        return 0;
 }
}

void attempt_apprentice(object me)
{
	if ( me->query("combat_exp") < 100000 ) {
     command("say 拜师! 不敢当，我都老了!你去找媳妇或「政儿」好了，看他们收不收你? ");
	}
	else
	if ( me->query("gender") != "女性" )
	command("say 老身不收男徒!\n");
	else
        if((string)me->query("title")!="普通百姓")
         {
            command("chat "+me->query("title")+me->query("nickname")+
            me->query("name")+"要叛师！！！");
            command("angry");
            kill_ob(me);
            return;
         }

	else {
        say(RANK_D->query_respect(me) + "若真的有心，不妨让我看看你的所学\n");

        tell_object(me, "如果想拜师的话，就请接受测试（accept test）\n");
	}
}

void die()
{
        object killer;

        if(objectp(killer = query_temp("last_damage_from")))
            killer->set("marks/dead", 1);

        ::die();

}
