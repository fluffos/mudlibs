// tangxin.c

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("唐欣", ({ "master tangxin", "master" }) );
        set("nickname", "天山童姥");
        set("gender", "女性");
        set("age", 47);
//        set("long",
//                
//"，一\n"
//                "个是金色的，这正是「谷衣心法」修炼到极高境界的徵兆。\n");

        set("combat_exp", 1000000);
        set("score", 200000);

        set("class", "tiansan");

        set("str", 20);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);
        set("per", 30);

        set("force", 4000);
        set("max_force", 4000);
        set("force_factor", 40);

        set("atman", 500);
        set("max_atman", 500);

        set("mana", 500);
        set("max_mana", 500);
        set("mana_factor", 5);

        set("apprentice_available", 3);
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
             (:exert_function, "recover" :)
         }) );

        create_family("天山派", 20, "掌门");

        set_skill("literate", 80);
        set_skill("force", 150);
        set_skill("unarmed", 100);
        set_skill("sword", 150);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("snowshade-force",80);
        set_skill("snowshade-sword",120);
        set_skill("wave-steps",100); 
        map_skill("sword","snowshade-sword");
        map_skill("force","snowshade-force");
        map_skill("dodge","wave-steps");

//        set_skill("taoism", 100);
//        set_skill("necromancy", 100);

//        map_skill("spells", "necromancy");

        set_temp("apply/dodge", 50);
        set_temp("apply/armor", 50);

        setup();

        carry_object("/d/latemoon/obj/sword")->wield();
        carry_object("/d/snow/obj/cloth")->wear();
}

void attempt_apprentice(object ob)
{
        if( query("apprentice_available") ) {
                if( find_call_out("do_recruit") != -1 )
                        command("say 慢著，一个一个来。");
                else
                        call_out("do_recruit", 2, ob);
        } else {
                command("say 今天已经收了三个弟子，不想再收徒了。");
        }
}

void do_recruit(object ob)
{
//        if( (string)ob->query("gender") != "男性" )
//                command("say 贫道是出家人，不便收女徒，得罪了。");
//        else {
                command("say 嗯... 想入我天山派？也好....");
                command("recruit " + ob->query("id") );
//        }
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "tiansan");
        add("apprentice_availavble", -1);
}

 
