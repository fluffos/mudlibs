// poweprattack.c

#include <ansi.h>
#include <combat.h>
#include <weapon.h>
#include <skill.h>
inherit SSERVER;

int perform(object me, object target)
{
	string msg,*limbs,parry_skill,weapon;
	int i,size,damage,ap,pp;
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("插羽破天骄进攻只能对战斗中的对手使用。\n");
	if( (int)me->query_skill("snowshade-sword",1) < 50)
		return notify_fail("你还不会这个剑式。\n");
	if( (int)me->query("force") < 50 )
		return notify_fail("你的内力不够。\n");
	me->add("force", -50);
	me->receive_damage("kee", 5);
	msg = "$N飘然跃起，手中利剑泛起朵朵剑花，一式“"+HIY"插羽破天骄”"NOR+"
只见$N利刃一抖，咄人的剑气向$n逼去！。。。\n";
	message_vision(msg, me, target);
	me->start_busy(1);
	limbs=target->query("limbs");
	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/4 )
		{
		msg = "结果$p被$P攻了个措手不及！\n"NOR;
		message_vision(msg, me, target);
		size=((int)(me->query_skill("snowshade-sword")/10));
		ap=size*10;weapon=0;
		damage=random(size)+size;
damage=damage+me->query_str()/5+random((int)(me->query_temp("apply/damage")/4));
                if( weapon=target->query_temp("weapon") ) {
                        pp = (int)(target->query_skill("parry")/4); 
                } else {
                        pp = 0;
                }
                if( target->is_busy() ) pp /= 3;
                if( pp < 1 ) pp = 1;
		//for(i=0;i<=random(size);i++)
	//	{
                //      (4) Check if the victim can parry this attack.
                if( random(ap + pp)< pp ) 
			{
                        parry_skill = target->query_skill_mapped("parry");
                        if( !parry_skill ) parry_skill = "parry";
           // change to SKILL_D(parry_skill) after added parry msg to those
                        // martial arts that can parry.
                        msg= SKILL_D("parry")->query_parry_msg(weapon);
			message_vision(msg,me,target);
			}
		else
			{ 
			msg =HIB"“嗤”，$P刺中了$p"+limbs[random(sizeof(limbs))]+"。。。\n"NOR;
			target->receive_damage("kee",damage);
			target->receive_wound("kee",damage/3);
			message_vision(msg, me, target);
			COMBAT_D->report_status(target);
			}
	//	}
		target->start_busy(1);return 1;
	} else {
		msg = "可是$p看破了$P的企图，并闪到一旁。\n" NOR;
	}

	message_vision(msg, me, target);
	return 1;
}
