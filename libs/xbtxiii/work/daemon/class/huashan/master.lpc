inherit NPC;
inherit F_MASTER;
inherit F_QUEST;

void create()
{
        set_name("岳不群", ({ "master yue-buqun", "master", "yue-buqun" }) );

        set("title", "华山派掌门");
        set("nickname", "君子剑");
        set("gender", "男性");
        set("age", 55);
        set("long",
                "岳不群自幼执掌华山派，乃当今武林中一等一的高手。\n");
        set("attitude", "peaceful");
        set("shen_type",1);
                set("per",20);

            set("force", 2400);
        set("max_force", 2400);
        set("force_factor", 30);
        set("atman", 1000);
        set("max_atman", 1000);
        set("mana", 1000);
        set("max_mana", 1000);


        set("combat_exp", 1000000);
     
        set("class", "huashan");
        set("apprentice_available", 3);

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                                (: perform_action, "sword.jianzhang" :),
                }) );

        set_skill("unarmed", 80);
        set_skill("sword", 100);
        set_skill("force", 100);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("literate", 100);


                set_skill("huashan-jianfa", 100);
        set_skill("zixia-shengong", 100);
        set_skill("hunyuan-zhang", 80);
        set_skill("pixie-sword",80);
        set_skill("huashan-shenfa",100);

                map_skill("sword", "huashan-jianfa");
        map_skill("parry", "huashan-jianfa");
        map_skill("force", "zixia-shengong");
        map_skill("unarmed", "hunyuan-zhang");
        map_skill("dodge", "huashan-shenfa");


        create_family("华山派", 13, "掌门");

        setup();

        carry_object("/obj/longsword")->wield();
        carry_object("/obj/cloth")->wear();

}

void attempt_apprentice(object ob)
{
        if( query("apprentice_available") ) {
                if( find_call_out("do_recruit") != -1 )
                        command("say 慢著，一个一个来。");
                else
                        call_out("do_recruit", 2, ob);
        } else {
                command("say 老夫今天已经收了三个弟子，不想再收徒了。");
        }
}

void do_recruit(object ob)
{
if(ob->query("family/family_name")=="华山派")
		{
		command("say 好好好！！！那我就收下你吧！！！");
		command("recruit "+ob->query("id")+"");
       if((string)ob->query("class") != "swordsman")
        ob->set("class", "swordsman");

		}
else
		command("say 我不收非华山弟子，你要拜师，还是去找令狐冲吧！");
		return;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "huashan");
        add("apprentice_availavble", -1);
}
void reset()
{               
        set("apprentice_available", 3);
}


void init()
{
        add_action("give_quest","quest");
}
