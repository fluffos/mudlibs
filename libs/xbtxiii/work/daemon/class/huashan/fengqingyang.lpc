// feng.c 风清扬

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("风清扬", ({ "feng qingyang", "feng", "qingyang" }));
  set("long",
    "他就是华山剑宗的长老风清扬。他身材瘦长，眉宇间一直笼罩着一股淡淡的忧伤\n"
    "神色，显然对当年的剑宗气宗之争一直难以忘怀。\n");
  set("gender", "男性");
  set("age", 68);
  set("str", 30);
  set("int", 40);
  set("con", 30);

  set("kee", 4800);
  set("max_kee", 4800);
  set("gin", 3600);
  set("max_gin", 3600);
  set("force", 4400);
  set("max_force", 4400);
  set("force_factor", 200);

  set("combat_exp", 1750000);
  set("score", 200000);

  set_skill("force", 120);
  set_skill("blade", 150);
  set_skill("dodge", 120);
  set_skill("parry", 120);
  set_skill("sword", 170);
  set_skill("zixia-shengong", 130);
  set_skill("fanliangyi-dao", 120);
  set_skill("huashan-jianfa", 150);
  set_skill("hunyuan-zhang", 120);
  set_skill("dugu-jiujian-sword", 150);
  set_skill("huashan-shenfa", 120);
  set_skill("literate", 100);

  set_skill("unarmed", 130);
  map_skill("force", "zixia-shengong");
  map_skill("dodge", "huashan-shenfa");
  map_skill("parry", "dugu-jiujian-sword");
  map_skill("sword", "dugu-jiujian-sword");
  map_skill("blade", "fanliangyi-dao");
  map_skill("unarmed", "hunyuan-zhang");

  create_family("华山派", 12, "弟子");

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword.poqi" :),
    (: perform_action, "sword.poqi" :),
    (: perform_action, "sword.pozhang" :),
    (: perform_action, "sword.pozhang" :),
    (: perform_action, "sword.pojian" :),
    (: perform_action, "sword.pojian" :),
    (: exert_function, "recover" :),
  }));

  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/changjian")->wield();
}

void attempt_apprentice(object ob) {
  int fealty, student_num;
  string temp, line;
  fealty = ob->query("fealty");
  if (ob->query("family/family_name") != "华山派") {
    command("say 老夫向来只收华山弟子！！！");
    return;
  }
  if (fealty < 1500) {
    tell_object(ob, "风清扬对你有些不是那么信任的神色。看来你还的提高师傅对你的信任啊！！！\n");
    return;
  }
  temp = read_file("/daemon/class/huashan/FENGQINGYANG", 1, 1);
  student_num = atoi(temp);

  line = "风清扬说道：“我现在共有" + temp + "个徒弟。”\n";
  write(line);

  if (student_num == 3) {
    command("say 你来晚了，我已经收了三个徒弟了。");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));

  student_num++;
  if (student_num == 1)
    temp = "1";
  else if (student_num == 2)
    temp = "2";
  else if (student_num == 3)
    temp = "3";
  write_file("/daemon/class/huashan/FENGQINGYANG", temp, 1);

  if ((string)ob->query("class") != "swordsman")
    ob->set("class", "swordsman");

}

void come_in(object me) {
  call_out("give_player_book", 5, me);
}


int give_player_book(object me) {
  object book;
  message_vision(CYN "风清扬微笑着对$N说道：恩！！！多少年了，除了令狐冲，我还没有见过\n"
    "像你这般勤奋的弟子。唉～　　～　　～　　岳不群那个不肖弟子没有教出\n"
    "	一象样的弟子。既然我们有缘，我这里有一本书，就送与你吧。\n" NOR, me);
  book = new("/daemon/class/huashan/zixia_book");
  book->move(me);
  tell_object(me, "风清扬给你一本紫霞秘籍。\n");
  message_vision(CYN "风清扬拍着$N的头：好好学它，对你有些帮助。\n" NOR, me);
  call_out("leave_here", 5, me);
}

void leave_here(object me) {
  message_vision("风清扬走了。\n", me);
  destruct(this_object());
}
