// ding.c 丁春秋

inherit NPC;
inherit F_MASTER;
inherit F_QUEST;

mixed change_master(mixed arg);
mixed change_master(mixed arg)
{
   object me;
   me = this_player();
   if( (string)me->query("family/family_name")!="星宿派")
   {
   tell_object(me,"丁春秋哼道:非我门弟子,我不能为你推荐,滚!.\n");
    return 1;
    }
if(me->query("combat_exp") <= 100000) {
tell_object(me,"丁春秋对"+me->query("name")+"叹道:你的功夫还不够,再学多点才去拜西毒为师吧!\n");
   return 1;
   }
tell_object(me,"丁春秋沉吟了一会,对"+me->query("name")+"说道:去吧.以后行走江湖时小心那些所谓的正人君子. \n");
  me->create_family("白驼山派",3,"弟子");
   return 1;
}
void create()
{
        set_name("丁春秋", ({ "ding chunqiu", "ding" }));
        set("nickname", "星宿老怪");
        set("long", 
                "他就是星宿派开山祖师、令正派人士深恶痛绝的星宿老怪丁春秋。\n"
                "可是他看起来形貌清奇，仙风道骨。\n");
        set("gender", "男性");
        set("age", 60);
        set("attitude", "friendly");
        set("shen_type", -1);
        set("str", 25);
        set("int", 30);
        set("con", 28);
        
        set("max_kee", 4000);
        set("atman", 3000);
        set("max_atman", 3000);
        set("mana", 3000);
        set("max_mana", 3000);
        set("force", 4000);
        set("max_force", 4000);
        set("force_factor", 15);
        set("combat_exp", 1500000);
        set("score", 400000);

        set_skill("force", 150);
        set_skill("huagong-dafa", 180);
        set_skill("dodge", 150);
        set_skill("zhaixinggong", 180);
        set_skill("unarmed", 150);
        set_skill("lingshe-zhangfa", 150);
        set_skill("xingxiu-duzhang", 150);
        set_skill("parry", 120);
        set_skill("staff", 130);
        set_skill("qu-she-shu", 180);
//      set_skill("tianshan-zhang", 150);
        set_skill("literate", 120);

        map_skill("force", "huagong-dafa");
        map_skill("dodge", "zhaixinggong");
        map_skill("staff", "lingshe-zhangfa");
        map_skill("unarmed", "xingxiu-duzhang");
        map_skill("parry", "xingxiu-duzhang");
//      map_skill("parry", "tianshan-zhang");
        set("inquiry", ([
              "拜欧阳锋" :(: change_master :),
              ]) );

        create_family("星宿派", 1, "开山祖师");

        set("class", "xingxiu");
//      set("class", "taoist");

        setup();
    carry_object("/d/baituo/obj/baipao")->wear();
}

void init()
{
        add_action("do_flatter", "flatter");
add_action("give_quest","quest");
}

void attempt_apprentice(object me)
{
        if( me->query_temp("pending/flatter") ) {
                command("say 你如此不把老仙放在眼里，老仙怎会收你？");
                return;
        } else {
                command("say 我星宿老仙比起古往今来的圣人怎么样啊？");
                message_vision("星宿老怪微闭双眼，手捻长须，一付等人拍马(flatter)的样子。\n",
                this_player());
                me->set_temp("pending/flatter", 1);
        }
}

int do_flatter(string arg)
{
        if( !this_player()->query_temp("pending/flatter") )
                return 0;
        if( !arg ) return notify_fail("你说老仙什么？\n");
        this_player()->set_temp("pending/flatter", 0);
        message_vision("$N大声说道：" + arg + "\n", this_player());
        if( strsrch(arg, "星宿老仙") >=0 && (strsrch(arg, "德配天地") >=0
         || strsrch(arg, "威震寰宇") >=0 || strsrch(arg, "古今无比") >=0 )) {
                command("smile");
                command("say 这还差不多。\n");
                command("recruit " + this_player()->query("id"));
        } else {
                command("say 你如此不把老仙放在眼里，老仙怎会收你？");
        }
        return 1;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                add("apprentice_available", -1);
        ob->set("class", "xingxiu");
}

void questbonus(object ob)
{
if(random(3)<1)
   ob->set("quest/fealty",2);
else ob->set("quest/fealty",1);
}
// 星宿老仙，德配天地，威震寰宇，古今无比

