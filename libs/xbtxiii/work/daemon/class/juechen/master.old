// master.c

inherit NPC;
inherit F_MASTER;
inherit F_QUEST;
mixed mubiao(mixed arg);

mixed mubiao(mixed arg)
{
   	object me;
   	me = this_player();
 	if((string)me->query("family/family_name") != "绝尘派")
	{
		command("say "+RANK_D->query_respect(me) + 
"非我绝尘门下弟子,这个我就不需要回答你。" );
		tell_object(me,"绝尘子哼了一声,显然对你多管闲事极为不满.\n");
		return 1;
	}
    	if ( me->query("combat_exp") < 3000000 ) {
		tell_object(me,"绝尘子用轻视的眼光望着你.\n");
		command("say "+RANK_D->query_respect(me) + "的功夫还没有到家,不要再问这个了。" );
	    	command("sigh");
		return 1;
	}
    	tell_object(me,"绝尘子皱眉愁道:近日为师感到有一股很强的魔力.为师欲前往亲自看看.\n");
    	tell_object(me,"绝尘子叹了一口气:然而为师年事已高.行动不便.\n");
	command("say 徒儿愿代为师去调查此事吗?");
	command("say 此行凶险异常.徒儿你可仔细考虑,然道家之责乃斩妖除魔,");
	command("say 为师希望徒儿不要推辞,");
	tell_object(me,"绝尘子用期待的眼神看着你.你愿接下这个任务吗?\n");
  	return 1;
}

mixed change_master(mixed arg);
mixed change_master(mixed arg)
{
   object me;
   me = this_player();
   if( (string)me->query("family/family_name")!="绝尘派")
   {
   tell_object(me,"绝尘子说道: 你非我门弟子,请回吧.\n");
    return 1;
    }
tell_object(me,"绝尘子笑道:林天师与我份属同道,徒儿可以拜他为师学习茅山道术.\n");
  me->create_family("茅山派",6,"弟子");
   return 1;
}

void create()
{
	set_name("绝尘子",({"master outer","master","outer"}) );
	set("gender","男性");
	 set("shen_type",1);
	set("age",48);
	set("str",21);
	set("cor",24);
	set("cps",27);
	set("int",30);
	set("per",28);
	set("con",30);
	set("kar",30);
	set("spi",45);

	set("max_force",2000);
	set("force",3000);
	set("force_factor",30);
	set("max_atman",500);
	set("atman",5000);
	set("max_mana",5000);
	set("mana",5000);
	set("long",
	"绝尘子本为释家人，后得奇人指点，得悟道家真谛，佛道双修，\n"
	"皆入化境。后访遍名山大川，自号绝尘，创此绝尘一派。\n" );
	
    create_family("茅山派",2,"弟子");
	set("combat_exp",2000000);
    set("chat_chance", 1);
	set("chat_msg", ({
     "绝尘子突然长叹一声,说道:难啊! \n",
      "绝尘子紧锁双眉,看样子好象有事烦着他.\n",
      "绝尘子喃喃说道:这件事太令人担忧了.\n",
	}) );
	set("chat_chance_combat", 70);
	set("chat_msg_combat", ({
		(: cast_spell, "drainerbolt" :),
		(: cast_spell, "drainerbolt" :),
		(: cast_spell, "netherbolt" :),
		(: cast_spell, "marmor" :),
		(: cast_spell, "feeblebolt" :),
		(: cast_spell, "flee" :),
		(: cast_spell, "flee" :),
		(: cast_spell, "flee" :),
		(: cast_spell, "flee" :),
		(: cast_spell, "flee" :),
		(: cast_spell, "flee" :),
		(: cast_spell, "flee" :),
		(: cast_spell, "flee" :),
		(: cast_spell, "flee" :),
		(: cast_spell, "flee" :),
		(: cast_spell, "feeblebolt" :),
		(: cast_spell, "invocation" :),
		(: cast_spell, "invocation" :),
		(: cast_spell, "invocation" :),
		(: cast_spell, "invocation" :),
		(: cast_spell, "invocation" :),
		(: cast_spell, "invocation" :),
		"绝尘子道：你为何无故滋事，误我清修！\n",
		"绝尘子道：贫道向以遁世为乐，你何苦如此相逼？\n",
	}) );

	
	set_skill("force",170);
	set_skill("dodge",100);
	set_skill("parry",120);
	set_skill("unarmed",80);
	set_skill("sword",100);
	set_skill("staff",100);
	set_skill("literate",120);
	set_skill("perception",100);
    	set_skill("magic",200);
    	set_skill("music",150);
    	set_skill("spells",200);
      	set_skill("scratching",150);
      	set_skill("gouyee",120);
//        set_skill("essencemagic",100);

      	set_skill("taoism",300);
      	set_skill("necromancy",200);
	
	map_skill("spells", "necromancy");
	map_skill("magic", "necromancy");
	map_skill("force", "gouyee");

	set_temp("apply/dodge", 60);
	set_temp("apply/armor", 20);

		

	set("inquiry", ([
		"绝尘派" : "绝尘派是我所创，你有何指教？",
	      "拜林忌" :(: change_master :),
		"拜师"   : "入我派者，需有慧根。",
		"担忧"   :(: mubiao :),
		"name": "我便是绝尘子。",
	      ]) );
		setup();
		carry_object(__DIR__"jingang_staff")->wield();
		carry_object(__DIR__"hat")->wear();
      }

void attempt_apprentice(object ob)
 {

 if((string)ob->query("family/family_name") != "茅山派")
	 {
	    command("chat "+ob->query("title")+ob->query("nickname")+
	    ob->query("name")+"要叛师！！！");
	    command("grin");
	    kill_ob(ob);
	    return;
	 }
 if(ob->query("fambet"))
	 {
	    	command("shake "+ob->query("id"));
		command("sneer");
		tell_object(ob,"大概是因为你判过师，看来绝尘子不太信任你\n");
	    return;
	 }

        if( (int)ob->query("spi") < 20)
	  {     command("say 入我派者，需有慧根。" +
	      RANK_D->query_respect(ob) + "的资质不宜！");
	       return; }

    if ( ob->query("combat_exp") < 300000 ) {
		command("say "+RANK_D->query_respect(ob) + "似乎尚缺江湖历练，不宜投入我的门下。" );
		return ;
	} 

	command("smile");
	command("say 很好" + RANK_D->query_respect(ob) +
	"多加努力他日必定有成。\n");
	command("recruit " + ob->query("id") );
	command("say 入我门下，就绝对不得再拜他人，你要切记这点！");
}

void recruit_apprentice(object ob)
	 {
		if( ::recruit_apprentice(ob) )
		ob->set("class", "taoist");
		ob->set("no_apprentice",1);
	}

void init()
{
add_action("give_quest","quest");
}
void questbonus(object ob)
{
if(random(3)<1)
   ob->set("quest/fealty",1);
}



