#pragma save_binary
// /d/latemoon/npc/meishan.c
// 与之相关人物/daemon/class/dancer/dancer.c
// By rongg 1998.8.15.

inherit NPC;
#include <ansi.h> 

void create()
{
        set_name("美珊", ({ "meishan" }) );
        set("gender", "女性" );
        set("age",20);
        set("per",30); 
        set("long", "她看起来成熟中带有一些韵味。飘逸的长发\n"
                    "十分迷人。\n");
        set("class", "dancer");
        set("combat_exp", 5000);
        set_skill("unarmed",40);
        set_skill("dodge", 40);
        set_skill("stormdance", 20);
        set_skill("tenderzhi", 20);
        map_skill("dodge","stormdance");
        map_skill("unarmed","tenderzhi");
        set("force", 300);
        set("max_force", 300);

        create_family("晚月庄",4,"弟子");
        setup();
        add_money("gold",2);
        carry_object("/d/latemoon/obj/flower_boot")->wear();
}

int init()
{
        add_action("do_look","look");
        add_action("do_enjoy","enjoy");                   
		add_action("do_kill","kill");
		add_action("do_quit","quit");
}
void do_add_action(object me)
{	
        call_out("do_outcry",2,me);

}

int do_look(string arg)
{
        object me;
        me=this_player();
if(me->query_temp("wanted_enjoy"))
if(arg=="meishan")
        {
        message_vision("\n$N色米米的瞧着美珊。心里不知道在打什么主义。\n\n",me);
        write("她看起来成熟中带有一些韵味。飘逸的长发十分迷人。\n"
              "可能她刚才受了些惊吓，脸色有些苍白。她看起来有些恐慌。\n"
              "她虽然用床单遮住了上身，但是雪白的大腿还是裸露在了外面\n",me);
        message_vision(YEL"美珊见$N不怀好意的看着自己，更惊慌了\n"NOR,me);
        command("say 你。。。你。。。想干什么？？？");
        return 1;
        }
}

int do_outcry(object me)
{
        message_vision(HIM"美珊见$N杀了蓝芷萍，吓的花容失色.不由自主的尖叫了一声.\n"
                 "啊～　　～　　～　　～\n"NOR
              YEL"$N情不自禁的看了美珊一眼，美珊连忙将床单向上拉了拉.无奈床单太小.\n"
                 "美珊那雪白的大腿还是露了出来。\n"NOR,me);
        tell_object(me,CYN"你看着看着，心头升起了一种异样的感觉..\n\n"NOR);
        tell_object(me,HIM"你。。。想。。。霸王硬上弓吗(enjoy)\n"NOR);
		me->set_temp("wanted_enjoy",1);

}


int do_enjoy(string arg)
{
        object me;
        me=this_player();       
if(!me->query_temp("wanted_enjoy"))
		return 0;
if(arg=="meishan")//但愿没有玩家会做到这一步。呵呵。
        {
        message_vision(YEL"$N奸笑了两声:嘿嘿～ 　～　　～　说道：小娘子。。别怕。。\n"
                "美珊恐慌不安的说：你。。你。。想干什么？你。。你。。别过来。。。。。\n"
                "$N早就忍不住了，冲上前去，一把扯掉了美珊身上的床单,紧紧的抱住了美珊!\n\n"NOR
             HIM"美珊啊～　　～　　～的一声昏了过去。。。。。。。。。。。。。。。。。。。。。。。。\n"
                "。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。\n"              
                "。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。\n"              
                "。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。\n"              
                "。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。\n"              
                "。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。。\n\n"NOR,me);              
        this_object()->remove_all_killer();       
        
        me->set("title",YEL"大色魔"NOR);
        set("your_name_is",me->name());
        remove_action("do_enjoy","enjoy"); 
        remove_action("do_look","look");
        set("short","美珊(meishan)"+HIR"<昏迷不醒>"NOR+"");
        me->start_busy(20);       
		me->set_temp("enjoyed",1);
		me->delete_temp("wanted_enjoy"); 
        call_out("was_completed",20,me);
        }
else    write("你。。。想。。干什么?\n",me);
        return 1;
}

int do_quit()
	{
        object me;
        me=this_player();        
if(me->query_temp("enjoyed"))
		{	
        write("现在可不能退出啊!!!呵呵。。。。。。。\n",this_player());
        return 1; 
		}
}

int do_kill(string arg)
{
        object me;
        me=this_player();        


if(me->query_temp("enjoyed"))
		{	
		if(arg=="meishan")
        {
        me->set("title",YEL"禽兽不如--丧尽天良--大色魔"NOR);       
        message_vision(HIR"$N对美珊喝道：「小贱人！今日不是你死就是我活！」\n\n"
               YEL"侮天鬼王出现在一阵烟雾中。。。。。。。。。。。。。。\n"NOR
               HIR"侮天鬼王气的火冒三丈。。。。。。。。。。。。。。。。。\n"NOR
               CYN"侮天鬼王朝$N喝道:你这个禽兽不如的大色魔!!!不但。。。。。。。!\n"
                  "竟然还要。。。。你。。。你。。。也他妈的太可耻了!!!!!!!!\n"
                  "连我也看不下去了。滚你的咸鸭蛋吧!!!!\n\n"NOR
               YEL"侮天鬼王飞起一脚，将$N踢了出去。。。。。。。。。。。。。。\n"NOR,me);
     
        set("he_was_out",1);
        me->save();
		CHANNEL_D->do_channel(me,"sys","侮天鬼王气愤的将禽兽不如--丧尽天良--大色魔--"+me->name()+"踢了出去.");
        QUIT_D->leave_world(me);
		set("can_give_you_a_book",1);
        }
        return 1;
		}
}

void was_completed(object me)
{

        this_object()->delete("short");
        this_object()->revive();
		
		me->delete_temp("enjoyed");

if(query("he_was_out")==0)//判断玩家是不是已经被踢了出去。       
        message_vision(HIM"$N心满意足的站了起来,喃喃道：不错。。嘿嘿～～.\n"NOR,me);

        message_vision(YEL"美珊凄惨的哭道:"+query("your_name_is")+",你这个天杀的。。。。我死了也要变成厉鬼杀了你\n"
                "美珊突然嘴角流出丝丝鲜血，她竟嚼舌自尽了。。。。。。。。。。\n"NOR,me);
        call_out("goto_die",3,me); 
// 用query("your_name_is")的原因是，如果玩家enjoy之后又kill meishan
// 那么他就会立即被踢出去。之后，美珊会自杀，如果还用me->name(),那么
// 此时object me就会指向美珊。message_vision就会变成
// 美珊凄惨的哭到：美珊，你这个天杀的。。。。。。
}


void goto_die(object me)
{
		object book;

if(query("can_give_you_a_book"))
		{
		book=new(__DIR__"whip_book");
		book->move(this_object());
		}
        ::die();
}
