#include <ansi.h>
inherit NPC;
inherit F_MASTER;
inherit F_QUEST;

void use_poison();

void create()
{
        set_name("蓝芷萍", ({ "master dancer", "master", "dancer" }) );
        set("title", "晚月庄主");
        set("nickname", "回音仙子");
        set("gender", "女性");
        set("age", 22);
        set("long",                
"蓝止萍是一个十分出色的美女，她弹的一手琵琶更是闻名千里，许多\n"
"王侯子弟，富商豪客都为她天下无双的美貌与琴艺倾倒。\n");
        set("attitude", "peaceful");
        set("class", "dancer");
        set("per", 60);

        set("force", 1200);
        set("max_force", 1200);
        set("force_factor", 50);
        set("combat_exp", 1000000);
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                
		"蓝止萍嫣然一笑，一个转身迳自舞了起来，对眼前这场恶斗似乎全不放在心上。\n",
                "蓝止萍脚步轻移，翩翩地转了几个圈，回眸一笑。\n",
                "蓝止萍用手扶了扶自己的发簪，像是怕被对手碰歪似地。\n",
                "蓝止萍笑嘻嘻地拾起地上一片从" HIM "魔鞭翩珑" NOR 
		"上落下的花瓣。\n",
                (: use_poison :),
                (: exert_function, "chillgaze" :),
                (: perform_action, "dodge.fenshen" :),
                (: perform_action, "dodge.fenshen" :),
                (: perform_action, "dodge.fenshen" :),
                (: perform_action, "dodge.fenshen" :),
                (: perform_action, "dodge.fenshen" :),
        }) );

        set_skill("unarmed", 70);
        set_skill("sword", 70);
        set_skill("throwing", 80);
        set_skill("force",100);
        set_skill("parry", 70);
        set_skill("dodge", 80);
        set_skill("literate", 80);
        set_skill("perception", 80);
        set_skill("whip", 90);
        set_skill("stormdance", 90);
        set_skill("tenderzhi", 90);
        set_skill("iceforce", 90);
        set_skill("snowwhip", 90);
        set_skill("move", 80);

        map_skill("dodge", "stormdance");
        map_skill("move", "stormdance");
        map_skill("unarmed", "tenderzhi");
        map_skill("force", "iceforce");
        map_skill("whip", "snowwhip");
        map_skill("parry", "snowwhip");

        create_family("晚月庄", 2, "庄主");
        set("apprentice_available", 10);

        setup();
        add_money("silver",50);

        carry_object(__DIR__"echowhip")->wield();
        carry_object(__DIR__"snake_sandal")->wear();
        carry_object(__DIR__"gold_belt")->wear();
        carry_object(__DIR__"bloody_dress")->wear();
}

void reset()
{
        delete_temp("learned");
        set("apprentice_available", 10);
}

void attempt_apprentice(object ob)
{
        if( query("apprentice_available") ) {
                if( find_call_out("do_recruit") != -1 )
                        command("say 慢著，一个一个来。");
                else
                        call_out("do_recruit", 2, ob);
        } else {
                command("say 本庄主今天已经收了十个弟子，不想再收徒了。");
        }
}

void do_recruit(object ob)
{
        if( (string)ob->query("gender") != "女性" )
                command("say 男人都不是好东西，滚开！");
        else {
                command("say 很好，只要你对本庄主忠心耿耿，好处是少不了的。");
                if( (int)ob->query("per") > 10 && (int)ob->query("age") < 20 )
                        
message_vision("$N暧昧地抚摸著$n的脸，说道：特别是像你这样的女孩 ....\n", 
this_object(), ob);
                command("recruit " + ob->query("id") );
        }
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "dancer");
        add("apprentice_availavble", -1);
}

void use_poison()
{
        object *enemy, ob;
        string msg;

        enemy = query_enemy();
        if( sizeof(enemy) ) ob = enemy[random(sizeof(enemy))];

        if( ob->query_condition("rose_poison") ) return;

        tell_object(ob, 
	"你觉得脸上似乎沾上了什麽东西，伸手一摸却什麽也没有。\n");
        if( random(query("combat_exp")) > (int)ob->query("combat_exp") )
                ob->apply_condition("rose_poison", 20);
}
 


void kill_player(object me)// /d/latemoon/room2.c所呼叫
{      
if(userp(me)&&query("you_are_the_first")==0)
        {
        message_vision(YEL"$N贸贸然闯了进来，屋里的两个人被吓呆了.\n"NOR
             HIM"美珊惊叫了一声：啊～ 　　～　　　～连忙拉过床单遮住了她雪白的肌肤..\n\n"NOR
                "蓝芷萍飞快的穿好衣服。\n\n"
             CYN"蓝芷萍大怒：好你个"+RANK_D->query_rude(me)+",竟然坏本姑娘的好事!今日你休想活命!!!\n"NOR,me); 
        this_object()->kill_ob(me);
        set("i_am_in_room2",1);              
        set("you_are_the_first",1);
        }
else if(userp(me)&&query("you_are_the_first")==1)
        {
        message_vision(YEL"$N也贸贸然闯了进来.\n"NOR
              HIM"蓝芷萍大怒："+me->name()+",你也闯进来了，嘿嘿～  　～　　～\n"
                 "你们一起下地狱去吧。。。。。。。。。。。。。。。。\n"NOR,me);
        kill_ob(me);
        }   
}

void die()
{
        object me,meishan;
        me=query_temp("last_damage_from");
        meishan=present("meishan",environment(this_object()));
if(me->query("gender")=="男性"
        &&query("i_am_in_room2")==1
        &&meishan)        
  
        meishan->do_add_action(me);//呼叫美珊

        ::die(); 
}

void killed_enemy(object victim)
{
        object meishan;
        meishan=present("meishan",environment(this_object()));

if(query("i_am_in_room2")==1&&meishan&&query_enemy()==({}))

        message_vision(CYN"蓝芷萍冷笑了两声：哼～　　～　　～哼～　　～　　～。竟敢坏老娘的好事!\n\n"NOR
             YEL"蓝芷萍对美珊温柔的笑了笑：美珊，别怕，万事有庄主在这儿呢。。。\n\n"
                "来吧，美珊！我们继续。。。。。。。\n"NOR,victim);
}
void init()
{
        ::init();
        add_action("give_quest","quest");
}
void questbonus(object ob)
{
if(random(3)<1)
   ob->set("quest/fealty",2);
else ob->set("quest/fealty",1);
}

