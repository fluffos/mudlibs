#pragma save_binary
// whip_book.c

inherit ITEM;

void create()
{
        set_name("寒雪鞭法", ({ "whipbook" }));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long","这是一本寒雪鞭法的精要，上面详细介绍了有关於招式的详细解说\n");
                set("value", 12000);
                set("material", "paper");
                set("skill", ([
                        "name":                 "snowwhip",        
                        "exp_required": 100000,
                        "sen_cost":             30,       
                        "difficulty":   30,   
                        "max_skill":    119    
                ]) );
        }
}

 
