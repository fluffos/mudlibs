#pragma save_binary
// recover.c

inherit SSERVER;

#include <ansi.h>
int exert(object me, object target, int amount) {
  int force, lvl, killer;
  if (target != me) return notify_fail("你只能用真气将自己体内毒素逼出。\n");
  force = (int)me->query("force");
  if (force <= 100) return notify_fail("你的真气不足。\n");
  lvl = me->query_skill("iceforce", 1) * 2;
  if (random(lvl) < 20) {
    me->add("force", -100);
    message_vision(HIW "$N运功抗毒，头上冒出豆大的汗．．．\n" NOR, me);
    return notify_fail("结果却失败了。\n");
  } else {
    killer = me->query_condition("killer");
    me->clear_condition();
    me->add("force", -100);
    message_vision(HIW "$N运功抗毒，头上冒出豆大的汗．．．\n"
      "良久。$N从口中吐出一口黑色的血液\n" NOR, me);
    write("你清除了体内所有度质！\n");
    me->apply_condition("killer", killer);
    return 1;
  }
}
