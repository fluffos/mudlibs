#pragma save_binary
// recover.c

inherit SSERVER;

#include <ansi.h>
int exert(object me, object target, int amount)
{
	int force, lvl,killer;
        if( target != me ) return 
	notify_fail("你只能对自己使用驻颜术。\n");
        force =(int) me->query("max_force");
	if( force <=300) return notify_fail("你的真气不足。\n");
	if( me->query("age") <10) return notify_fail("你不必再用驻颜术了吧。\n");
	me->add("max_force", -300  );
	me->add("age_modify",-1);
	me->add("per",1);
	message_vision(HIW"$N坐下运功，头上冒出豆大的汗．．．\n"NOR, me);
	tell_object(me,HIC"由于你成功的运用驻颜术，你变得更年轻漂亮了。\n"NOR, me);
	return 1;
}
 
