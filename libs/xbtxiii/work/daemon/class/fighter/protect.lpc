#pragma save_binary
// follow.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  object ob1;

  if (!arg) return notify_fail("指令格式: protect <某人>|none。\n");

  if (arg == "none")
    if (me->query_leader()) {
      me->set_leader(0);
      write("Ok.\n");
      return 1;
    } else {
      write("你现在并没有保护任何人。\n");
      return 1;
    }

  if (!objectp(ob = present(arg, environment(me))))
    return notify_fail("这里没有 " + arg + "。\n");

  if (!ob->is_character())
    return notify_fail("什麽？保护...." + ob->name() + "。\n");

  if (ob == me)
    return notify_fail("保护自己？\n");

  me->set_leader(ob);
  message_vision("$N决定开始保护$n。\n", me, ob);
  void init() {
    add_action("do_kill", "kill");
  }
  int do_kill() {
    object ob1 me->kill_ob(this_player());
    return 1;
  }

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : protect <
 
这个指令让你能保护某人或生物。
如果输入 protect none 则停止保护。
 
HELP
  );
  return 1;
}
