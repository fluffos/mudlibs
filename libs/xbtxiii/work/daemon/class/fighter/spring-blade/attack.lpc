// 迎风一刀斩

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
 
int perform_distance()
{
return 0;
}
int perform(object me, object target)
{
        int i,kee,max_kee;
	string msg;
	if( !target ) target = offensive_target(me);

	if( !target
	||  !target->is_character()
	||  !me->is_fighting(target) )
		return notify_fail(CYN"迎风一刀斩只能对战斗中的对手使用。\n"NOR);
        if(me->query_temp("ying_feng"))
                return notify_fail("你现在正在施展这招。。。\n");
        me->set_temp("ying_feng",1);
	msg = HIW  "$N甩了甩头发，潇洒的使出天邪派镇山绝技--迎风一刀斩！。。。\n" NOR;
	message_vision(msg, me, target);
	
	for(i=0;i<10;i++)
	    {
	    max_kee=target->query("kee");
	    msg = CYN "第   "+chinese_number(i+1)+"  刀！\n"NOR;
	    message_vision(msg,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        if(!target
        ||environment(target)!=environment(me)
                 ||target->query("kee")<0
                 ||me->query("kee")<0
                 ||me->query("sen")<0
                 ||me->query("gin")<0
                 ||!me->is_fighting())
		break;
 	    kee=target->query("kee");
	    if(kee>=max_kee)
		 break;
	    }
	me->delete_temp("ying_feng");
	if(i==0)
		me->start_busy(2);
	else 
	    me->start_busy(i+3);
        message_vision(CYN""+chinese_number(i+1)+"刀过后。$N却扑了个空。立刻露出了破绽！\n"NOR,me,target);
	    return 1;
}

