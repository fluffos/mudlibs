//  /daemon/class/fighter/fighter.c
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void consider();

void create() {
  set_name("萧辟尘", ({ "master fighter", "master", "fighter" }));

  set("nickname", "小天邪");
  set("gender", "男性");
  set("age", 24);
  set("long",
    "萧辟尘自幼生长於岚城之中，看起来仙风道骨，不食人间烟火。\n");
  set("attitude", "peaceful");

  set("str", 50);
  set("per", 30);

  set("force", 2400);
  set("max_force", 2400);
  set("force_factor", 30);

  set("combat_exp", 1000000);
  set("score", 200000);

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: consider :),
    (: exert_function, "powerup" :),
    (: exert_function, "recover" :)
  }));
  set_skill("unarmed", 120);
  set_skill("sword", 80);
  set_skill("blade", 80);
  set_skill("force", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("literate", 100);
  set_skill("perception", 80);

  set_skill("six-chaos-sword", 80);
  set_skill("celestial", 80);
  set_skill("spring-blade", 80);
  set_skill("celestrike", 120);
  //  set_skill("stormdance", 80);
  set_skill("pyrobat-steps", 80);

  map_skill("blade", "spring-blade");
  map_skill("sword", "six-chaos-sword");
  map_skill("parry", "six-chaos-sword");
  map_skill("force", "celestial");
  map_skill("unarmed", "celestrike");
  map_skill("dodge", "pyrobat-steps");
  map_skill("move", "pyrobat-steps");

  create_family("天邪派", 16, "弟子");

  setup();
  add_money("silver", 100);
  carry_object(__DIR__ "icy_boot")->wear();
  carry_object(__DIR__ "icy_girth")->wear();
  carry_object(__DIR__ "icy_cloth")->wear();
  carry_object(__DIR__ "icy_ribbon")->wear();
}

void init() {
  add_action("do_kill", "kill");
}


int do_kill(string arg) {
  object me, bigmaster;
  me = this_player();
  bigmaster = present("champion", environment(this_object()));
  if (arg == "fighter") {
    message_vision(
      HIR "$N对着萧辟尘大喝一声：" + RANK_D->query_rude(this_object()) + ",今天不是你死就是我活！\n\n" NOR,
      me
    );
    me->kill_ob(this_object());
    this_object()->kill_ob(me);
    if (bigmaster && living(bigmaster)) {
      message_vision(CYN "\n於兰天武说道：你想谋害我[小天邪]，当真是吃了熊心豹子胆了！！\n\n" NOR, me);
      bigmaster->kill_ob(me);
    }
    return 1;
  } else if (arg == "champion") {
    if (bigmaster) {
      message_vision(
        HIR "$N对着於兰天武大喝一声：" + RANK_D->query_rude(this_object()) + ",今天不是你死就是我活！\n\n",
        me
      );
      me->kill_ob(bigmaster);
      bigmaster->kill_ob(me);
    }
    command("say 你想谋害我师傅，当真是吃了熊心豹子胆了！！");
    this_object()->kill_ob(me);
    return 1;
  }
}

void start_help_champion() {
  object me;
  me = present(query("killer_name"), environment(this_object()));
  if (me) {
    command("say 你这个" + RANK_D->query_rude(me) + ",想谋害我师傅，当真吃了豹子胆了！");
    this_object()->kill_ob(me);
  }
}

void attempt_apprentice(object me) {
  if (me->query_temp("pending/celestial_swear")) {
    command("say 多说无益，若不发誓恪守门规，便是跪著求我也没用。");
    return;
  } else {
    command("say 我天邪派门规甚严，" + RANK_D->query_respect(me)
      + "如果真的有心，且发个守门规的誓(swear)来。");
    me->set_temp("pending/celestial_swear", 1);
    add_action("do_swear", "swear");
  }
}

int do_swear(string arg) {
  object me;
  me = this_player();
  if (!me->query_temp("pending/celestial_swear"))
    return 0;
  if (!arg)
    return notify_fail("你要发什麽誓？\n");

  me->set_temp("pending/celestial_swear", 0);
  message_vision("$N发誓道：" + arg + "\n", me);
  if (strsrch(arg, "守门规") >= 0
    && strsrch(arg, "不") < 0
    && strsrch(arg, "屁") < 0
    && strsrch(arg, "no") < 0) {
    command("smile");
    command("say 这就是了。\n");
    command("recruit " + me->query("id"));
    remove_action("do_swear", "swear");
  } else
    command("say 你发的是什麽鬼誓，想骗我？？？没门！！！哼。。。。");
  return 1;
}

int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    add("apprentice_availavble", -1);
  ob->set("class", "fighter");
}

void consider()  // 哪个地方呼叫的？
{
  int i, flag = 0;
  object *enemy;

  enemy = query_enemy() - ({ 0 });
  for (i = 0; i < sizeof(enemy); i++) {
    if (!living(enemy[i])) continue;
    if (enemy[i]->query_temp("weapon")) {
      flag++;
      if (!query_temp("weapon")) {
        command("say " + RANK_D->query_respect(enemy[i]) + "既然使兵刃，在下空手接招未免不敬。");
        command("wield sword");
        command("say 进招吧！");
        break;
      }
    }
  }
  if (!flag && query_temp("weapon")) {
    if (sizeof(enemy) > 1)
      command("say 嗯... 既然" + chinese_number(sizeof(enemy)) + "位都是空手，在下理当奉陪！");
    else
      command("say 既然" + RANK_D->query_respect(enemy[0]) + "不使兵刃，在下自然奉陪！\n");
    command("unwield sword");
  }
}

int do_accept(string arg) {
  object me;
  me = this_player();

  if (arg == "fightertest") {
    say("\n萧辟尘点了点头，说道：很好，这是第一招....\n\n");

    COMBAT_D->do_attack(this_object(), me, query_temp("weapon"));
    if ((int)me->query("kee") < 0
      || !present(me, environment())) {
      say("萧辟尘叹了口气，说道：连第一招都撑不过，真是自不量力....\n");
      remove_action("do_accept", "accept");
      return 1;
    }

    say("\n萧辟尘说道：这是第二招....\n\n");

    COMBAT_D->do_attack(this_object(), me, query_temp("weapon"));
    if ((int)me->query("kee") < 0
      || !present(me, environment())) {
      say("萧辟尘「哼」地一声，说道：便是有这许多不怕死的家伙....\n");
      remove_action("do_accept", "accept");
      return 1;
    }

    say("\n萧辟尘说道：第三招来了....\n\n");

    COMBAT_D->do_attack(this_object(), me, query_temp("weapon"));
    if ((int)me->query("kee") < 0
      || !present(me, environment())) {
      say("萧辟尘叹道：这样子还想出师,唉.....\n");
      remove_action("do_accept", "accept");
      return 1;
    }

    say("\n萧辟尘叹道：恭喜,你出师了.师傅没什么好送的,这本[春风刀谱]...,江湖
                凶险,徒儿,喔,不...大侠你好自为知.\n\n");
    me->set("title", "隐士");
    me->set("family", 0);
    command("chat " + me->name() + "已脱离天邪，日后一切江湖恩怨均与本派无关.\n");
    me->set("fealty", 0);
    remove_action("do_accept", "accept");
    return 1;
  }
  return 0;
}
