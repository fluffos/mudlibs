#pragma save_binary
// executioner.c

#include <ansi.h>

inherit NPC;
mixed excited(mixed arg);

mixed excited(mixed arg)
{
   object me,obb,*obj;
   int s;

   me = this_player();
   if ( me->query("family/family_name") != "天邪派" || me->query("marks/出师") != 1)
     {
        tell_object(me,"一提到天山,潘军禅精神一振,随即叹了一声.唉...天山..\n");
        tell_object(me,"你等了几分钟,见潘军禅没有动静,便悻悻地离开了.\n");
        return 1;
     }
   tell_object(me,"一提到天山,潘军禅精神一振,怎么,你要到天山去,太好了!\n");
   tell_object(me,"这封秘函交给天山唐掌门,唉...不知絮青现在怎样了.\n");
   obb = new("/open/moon/obj/secret");
   obj = all_inventory(me);
   s=sizeof(obj);
   while(s--)
     {
        if(obj[s]->query("id") == "secret"){
            tell_object(me,"潘军禅哼了一声,别过脸去.\n");
            return 1;
         }
      }
   obb->move(me);
   return 1;
  }

void create()
{
        set_name("潘军禅", ({ "master executioner", "executioner", "master" }) 
);
        set("title", "水烟阁执法使");
        set("nickname", HIC "书 剑 侠" NOR);
        set("gender", "男性");
        set("age", 28);
        set("long",
                
"潘军禅是当今武林的一位传奇性人物，以他仅仅二十八岁的年龄竟能做到\n"
                
"水烟阁执法使的职位，著实是一位不简单的人物。潘军禅是封山剑派掌门\n"
                
"柳淳风的结拜义弟，不知什么原因,最近和柳淳风反目成仇.他为人十分风\n"

"趣，又好交朋友，丝毫不会摆出武林执法者的架子。\n" );

        set("attitude", "friendly");
        set("combat_exp", 1000000);
        set("score", 200000);

        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("cps", 30);
        set("con", 30);

        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 2);

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );

        set_skill("force", 120);
        set_skill("unarmed", 120);
        set_skill("sword", 120);
        set_skill("parry", 120);
        set_skill("dodge", 120);

        set_skill("celestial", 120);
        set_skill("celestrike", 120);
        set_skill("pyrobat-steps", 120);
        set_skill("six-chaos-sword", 120);

        map_skill("force", "celestial");
        map_skill("unarmed", "celestrike");
        map_skill("sword", "six-chaos-sword");
        map_skill("dodge", "pyrobat-steps");
        set("inquiry", ([
             "天山": (: excited :),
        ]) );

        setup();

        carry_object(__DIR__"soulimpaler")->wield();
        carry_object("/obj/cloth")->wear();
}

