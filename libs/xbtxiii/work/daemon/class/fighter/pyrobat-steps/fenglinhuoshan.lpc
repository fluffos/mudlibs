// Evilgod
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
        int i,s;
	object weapon;
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("风林火山只能对战斗中的对手使用。\n");
	weapon = me->query_temp("weapon");
	if (!weapon) return notify_fail("风林火山只能和春风快意刀法配和！\n");
	if( (string)weapon->query("skill_type") != "blade" )
	return notify_fail("风林火山只能和春风快意刀法配和！\n");
    if ( (string) me->query_skill_mapped("dodge") != "pyrobat-steps")
    return notify_fail("风林火山只能和火蝠身法配和！\n");
	if ( (string) me->query_skill_mapped("blade") != "spring-blade")
	return notify_fail("风林火山只能和春风快意刀法配和！\n");
	extra = me->query_skill("spring-blade",1) / 10;
	extra += me->query_skill("pyrobat-steps",1) /10;
	msg = HIR  "$N脚踏［火蝠步法］，同时使出［春风快意刀法］中的精髓－－风林火山，手中的"+ weapon->name() +"划出一道长虹，闪电般的击向$n！" NOR;
        message_vision(msg, me, target);
	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR);
    s = extra>400?400:extra;
    s/=10;
    if(s>5) s=5;
    for(i=0;i<s;i++)
	{
        msg = HIY "$N身形一变，刀随敌转，又一刀劈了过来......\n" NOR;
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
	}
	if(s<=2)
{
if (me->query_skill_mapped("force")=="celestial") me->start_busy(2);
else me->start_busy(3);
}
else {
if (me->query_skill_mapped("force")=="celestial") me->start_busy(2+random(2));
else me->start_busy(4+random(2));
}
//         tell_object(me,"s is "+s+" busy_time is "+me->query_busy()+"\n");
	return 1;
}
