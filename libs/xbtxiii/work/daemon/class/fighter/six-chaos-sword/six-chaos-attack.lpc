// poweprattack.c

#include <ansi.h>
#include <combat.h>
#include <weapon.h>
#include <skill.h>
inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  string msg, *limbs;
  int size, damage, ap;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIR "六阴夺魄" NOR + "只能对战斗中的对手使用。\n");
  if ((int)me->query_skill("six-chaos-sword", 1) < 40)
    return notify_fail("你还不会这个剑式。\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够。\n");
  me->add("force", -50);
  me->add("bellicosity", 10);
  me->receive_damage("kee", 50);
  me->receive_damage("sen", 50);
  me->receive_damage("gin", 50);
  msg = "$N腾空跃起，大喝：“" + HIR "六阴夺魄”" NOR + "
只见$N连人带剑散作六团模糊不清的人影，挟带着一股惊人的邪气向$n冲去！。。。\n";
  message_vision(msg, me, target);
  limbs = target->query("limbs");
  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 4) {
    msg = "结果$N被邪气侵入心神无法抵抗！\n" NOR;
    message_vision(msg, target);
    tell_object(target, "你只觉得邪气逼人，突然周身一凉，顿时很难动弹。\n");
    size = (int)(me->query_skill("six-chaos-sword") / 10);
    ap = size * 10; weapon = 0;
    damage = random(size * 4) + size * 4 + me->query("bellicosity") / 100;
    damage = damage + me->query_str() / 3 + random(me->query_temp("apply/damage"));
    if (damage >= 1500) damage = 1500;
    msg = HIB "“嗤”，$P刺中了$p" + limbs[random(sizeof(limbs))] + "。。。\n" NOR;
    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 3);
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
    me->start_busy(2); return 1;
  } else {
    msg = "可是$p看破了$P的企图，并闪到一旁。\n" NOR;
    me->start_busy(3);
  }

  message_vision(msg, me, target);
  return 1;
}
