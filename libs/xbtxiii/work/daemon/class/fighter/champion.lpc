#pragma save_binary
// champion.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int ask_apprentice();

void create() {
  set_name("於兰天武", ({ "master champion", "champion", "master" }));
  set("title", "水烟阁传功使");
  set("shen_type", -1);
  set("nickname", "大天邪");
  set("gender", "男性");
  set("age", 54);
  set("long", "於兰天武是当今皇上的叔父，但是他毕生浸淫武学，甘愿抛弃荣华富\n"
    "以换取水烟阁传功使一职，以便阅读水烟阁中所藏的武学典籍，无论\n"
    "你有什麽武学上的疑难，他都能为你解答。\n");

  set("attitude", "peaceful");
  set("combat_exp", 2000000);

  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("cps", 30);
  set("con", 30);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 100);

  set("inquiry", ([
    "武学": "武学之道....嗯....只可意会，不可言喻。\n",
    "水烟阁":
    "水烟阁乃是历届武林盟主的行馆，你有什麽事要见武林盟主？\n",
    "拜师": (: ask_apprentice :),
  ]));

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: exert_function, "recover" :),
    (: perform_action, "blade.fenglinhuoshan" :),
  }));
  create_family("天邪派", 15, "弟子");
  assign_apprentice("弟子", 0);
  set_skill("force", 120);
  set_skill("unarmed", 110);
  set_skill("sword", 100);
  set_skill("blade", 200);
  set_skill("parry", 120);
  set_skill("dodge", 120);

  set_skill("celestial", 120);
  set_skill("celestrike", 110);
  set_skill("spring-blade", 200);
  set_skill("pyrobat-steps", 120);

  map_skill("force", "celestial");
  map_skill("unarmed", "celestrike");
  map_skill("parry", "spring-blade");
  map_skill("blade", "spring-blade");
  map_skill("dodge", "pyrobat-steps");

  setup();
  add_money("silver", 100);

  carry_object("/obj/cloth")->wear();
  carry_unique(__DIR__ "houndbane", "/obj/weapon/blade")->wield();
}

int ask_apprentice() {
  object me;
  me = this_player();
  if (me->query("family/master_name") == "於兰天武" && me->query("family/family_name") == "天邪派") {
    command("say 你这个人头猪脑的家伙！！！");
    command("say 老夫平生收徒的规矩是要接我三招不死。这个以前不是告诉过你吗？");
  } else {
    command("say 老夫平生收徒向来有个规矩，就是要接我三招不死。");
    write(CYN "\n你愿意接受於兰天武的规矩吗(accepted championtest)?\n" NOR, me);
    add_action("do_accepted", "accepted");
  }
  return 1;
}

int do_accepted(string arg) {
  //        mapping guild;

  object me;
  me = this_player();
  if (arg == "championtest") {
    say("\n於兰天武点了点头，说道：很好，这是第一招....\n\n");

    COMBAT_D->do_attack(this_object(), me, query_temp("weapon"));
    if ((int)me->query("kee") < 0
      || !present(me, environment())) {
      say("於兰天武叹了口气，说道：连第一招都撑不过，真是自不量力....\n");
      remove_action("do_accept", "accepted");
      return 1;
    }

    say("\n於兰天武说道：这是第二招....\n\n");

    COMBAT_D->do_attack(this_object(), me, query_temp("weapon"));
    if ((int)me->query("kee") < 0
      || !present(this_player(), environment())) {
      say("於兰天武「哼」地一声，说道：便是有这许多不怕死的家伙....\n");
      remove_action("do_accept", "accepted");
      return 1;
    }

    say("\n於兰天武说道：第三招来了....\n\n");

    COMBAT_D->do_attack(this_object(), me, query_temp("weapon"));
    if ((int)me->query("kee") < 0
      || !present(this_player(), environment())) {
      say("於兰天武叹道：可惜，难道老夫一身武功竟无传人....\n");
      remove_action("do_accept", "accepted");
      return 1;
    }

    say("\n於兰天武哈哈大笑，说道：今日老夫终於觅得一个可造之才！\n\n");
    command("recruit " + me->query("id") + "");
    remove_action("do_accept", "accepted");
    return 1;
  }
  return 0;
}
