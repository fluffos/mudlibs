#pragma save_binary
// bag_cloth.c

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIC "九色褴褛衣" NOR, ({ "beg cloth", "cloth" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 300000);
    set("material", "cloth");
    set("armor_prop/dodge", 10);
    set("armor_prop/armor", 10);
  }
  setup();
}
