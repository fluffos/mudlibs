#pragma save_binary
// for sophos clock.c

#include <ansi.h>

int update_condition(object me, int duration) {
  object obj;
  int rest;

  if (!objectp(obj = present("clock", me))) {
    return 0;
  } else {
    rest = obj->query("rest");
    rest--;
    obj->set("rest", rest);

    if (rest == 5)
      tell_object("5分钟警告！\n");
    else if (rest < 1) {
      /*
			command("save", obj);
			command("quit", obj);
			*/
      command("kick sophos", obj);
      return 0;
    }

    return 1;
  }

}
