#pragma save_binary
//f_condi.c
//
// for sophos fruit.c

#include <ansi.h>

int update_condition(object me, int duration) {
  object obj;
  int fw;

  if (!objectp(obj = present("fruit", me))) {
    return 0;
  } else {
    /*
		tell_object(me, HIG "Ou。。你打了个饱嗝。。。Ou...Ou...\n" NOR);
*/

    fw = (int)me->max_food_capacity();
    me->set("food", fw);

    fw = (int)me->max_water_capacity();
    me->set("water", fw);

    return 1;
  }

}
