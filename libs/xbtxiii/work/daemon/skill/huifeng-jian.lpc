#pragma save_binary
// huifeng-jian.c 回风拂柳剑
// wiz chenmy 5/19/98

inherit SKILL;

mapping *parry_act = ({
  ([ "action": "$n使出一招「清风袭月」，手中的$v化作一条长虹，磕开了$N的$w。\n",
    "parry": 10,         //使用本招会增加10%的招架能力
  ]),
  ([ "action": "$n使出「飘雪穿云」长剑寒光一闪，将$N的$v封于丈外。\n",
    "parry": -5,         //使用本招会减少5%的招架能力
  ]),
  ([ "action": "$n使出一招「乌龙搅柱」，手中的$v化做漫天剑影，震开了$N的$w。\n",
  ]),
  ([ "action": "$n手中的$v一抖，一招「进退龙游」，反向$N拿$w的手腕削去。\n",
  ]),
});

mapping *unarmed_parry_act = ({
  ([ "action": "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
  ]),
  ([ "action": "$n反手一招「千峰竞秀」，整个人消失在一团剑光之中。\n",
  ]),
  ([ "action": "$n使出一招「万流归宗」，$v直刺$N的双手。\n",
  ]),
  ([ "action": "$n将手中的$v化做七条剑气，迫得$N连连后退。\n",
  ]),
});

mapping *action = ({
  ([ "action": "$N身形一纵，一招「清风袭月」，手中$w剑锋划向$n的$l",
    "force": 30,
    "dodge": 20,
    "damage": 25,
    "attack": 20,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N右脚独立，上身前扑，右手$w一式「飘雪穿云」向$n的$l疾刺",
    "force": 30,
    "dodge": 15,
    "damage": 30,
    "attack": 10,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一招「乌龙搅柱」，$w剑锋不断转圈，突然抖向$n的$l",
    "force": 20,
    "dodge": 15,
    "damage": 40,
    "attack": 15,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N使一招「进退龙游」，纵跃腾挪间，$w象是漫不经心地横扫$n的$l",
    "force": 25,
    "dodge": 10,
    "damage": 50,
    "attack": 15,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N使出「千峰竞秀」，手中$w象是化作千把万把，绵绵不断点向$n的$l",
    "force": 35,
    "dodge": 10,
    "damage": 60,
    "attack": 20,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N左脚稍退，右脚反向前一步，一招「万流归宗」，右手$w带出一团剑花，逼向$n的$l",
    "force": 35,
    "dodge": 5,
    "damage": 70,
    "attack": 15,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N反身一招「大雁啼沙」，剑尖虚刺，剑身却撩向$n的$l",
    "force": 40,
    "dodge": -5,
    "damage": 90,
    "attack": 10,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N提气一跃，冲天而起，一招「天地鹤翔」，$w突然剑光大盛，竟将$n紧紧围住",
    "force": 35,
    "dodge": -5,
    "damage": 115,
    "attack": 10,
    "damage_type": "刺伤"
  ]),
});


mapping query_parry_action(object weapon) {
  if (weapon) return parry_act[random(sizeof(parry_act))];
  return unarmed_parry_act[random(sizeof(unarmed_parry_act))];
}

int query_rate(object me) { return 10; }

int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me) {
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("linji-zhuang", 1) < 20)
    return notify_fail("你的临济十二庄火候太浅。\n");
  if ((int)me->query_skill("jinding-zhang", 1) < 60)
    return notify_fail("你的金顶绵掌火候太浅。\n");
  /*        if ((int)me->query_skill("taiji-jian",1)>(int)me->query("kar")*6+20)
                 return notify_fail("唉！！我们两个人缘分已尽，我只能教你这么多了，以后就要靠你自己练了(perform practice)。\n");*/
  return 1;
}

