inherit SKILL;

mapping *action = ({
  ([ "action": "$N怒目圆睁，使出一招「不动」，手中$w一抖，直刺$n的$l  ",
    "skill_name": "不动",
    "force": 50,
    "dodge": -10,
    "lvl": 0,
    "damage": 13,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N使出一式「起手出剑」，足下一滑，剑芒闪向$n的$l  ",
    "skill_name": "起手出剑",
    "force": 30,
    "dodge": 5,
    "lvl": 8,
    "damage": 15,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N使出一招「山崩」，纵身跃入半空，$w如山崩般劈向$n的$l  ",
    "skill_name": "山崩",
    "force": 40,
    "dodge": -10,
    "lvl": 16,
    "damage": 20,
    "damage_type": "割伤",
  ]),
  ([ "action": "$N使出「千旋转」，将$w舞得如纺车一般，忽然一剑刺向$n的$l  ",
    "skill_name": "千旋转",
    "force": 50,
    "dodge": 10,
    "lvl": 24,
    "damage": 24,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N使出一招「降魔舞」，全身劲气贯于$w中，剑气直指$n的$l  ",
    "skill_name": "降魔舞",
    "force": 40,
    "dodge": 10,
    "lvl": 32,
    "damage": 25,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N单足独立，使出一式「鹤舞」，一道剑光如白影般向$n的$l扫去  ",
    "skill_name": "鹤舞",
    "force": 45,
    "dodge": 15,
    "lvl": 40,
    "damage": 20,
    "damage_type": "割伤",
  ]),
  ([ "action": "$N使出一招「龙腾」，手中$w如游龙般扑向$n的$l  ",
    "skill_name": "龙腾",
    "force": 40,
    "dodge": 20,
    "lvl": 48,
    "damage": 20,
    "damage_type": "割伤",
  ]),
  ([ "action": "$N飞身一跃，居高临下使出「花雨满天」，顿时剑尖如雨刺向$n的$l  ",
    "skill_name": "花雨漫天",
    "force": 50,
    "dodge": 25,
    "lvl": 80,
    "damage": 10,
    "damage_type": "刺伤",
  ]),
});
mapping *parry_act = ({
  ([ "action": "$n不退反进，气走周天，一招「龙腾」，手中的$v狠狠磕开了$N的$w。\n",
  ]),
  ([ "action": "$n回剑自守，一招「不动」，架住了$N的$w。\n",
  ]),
  ([ "action": "$n一招「鹤舞」，手中的$v化作千百把，护住了全身。\n",
  ]),
  ([ "action": "$n手中的$v自上削下，几乎将$N的$w削成两段。\n",
  ]),
});

mapping *unarmed_parry_act = ({
  ([ "action": "$n使出一招「降魔舞」，在身前布起了一道铜墙铁壁，封住了$N的攻势。\n",
  ]),
  ([ "action": "$n一抖手中的$v，使出一招「鹤舞」，手中的$v护住了全身。\n",
  ]),
  ([ "action": "$n将$v往地上一刺，$v反弹起来，刚好直刺$N的双臂。\n",
  ]),
  ([ "action": "$n举剑静立，一股内力从剑梢透出，逼开了$N。\n",
  ]),
});
mapping query_parry_action(object weapon) {
  if (weapon)
    return parry_act[random(sizeof(parry_act))];
  else return unarmed_parry_act[random(sizeof(unarmed_parry_act))];
}

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

//int valid_combine(string combo) { return combo=="xue-dao"; }

int valid_learn(object me) {
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够。\n");
  /*    if ((int)me->query_skill("longxiang", 1) >= 20 ||
	    (int)me->query_skill("xiaowuxiang", 1) >= 20)
		return 1;
	else if ((int)me->query_skill("longxiang", 1) < 20)
        return notify_fail("你的龙象般若功火候太浅。\n"); */
  if ((int)me->query_skill("xiaowuxiang", 1) < 20)
    return notify_fail("你的小无相功火候太浅。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("mingwang-jian", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你的体力不够，练不了不动明王剑。\n");
  me->receive_damage("kee", 20);
  return 1;
}
