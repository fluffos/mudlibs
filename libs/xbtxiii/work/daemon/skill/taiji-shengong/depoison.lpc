// depoison.c

#include <ansi.h>

int exert(object me, object target)
{
	if( me->is_fighting() )
        return notify_fail("战斗中运功逼毒？找死吗？\n");

	if ((int)me->query_skill("taiji-shengong", 1) < 50)
		return notify_fail("你的太极神功修为还不够。\n");
     if( (int)me->query("force") < 250 ) // - (int)me->query("max_force") < 50 )
		return notify_fail("你的真气不够。\n");


    message_vision(HIW"$N坐下来开始运功逼毒。\n" NOR,me);

     me->add("force", -250);
     me->set("force_factor", 0);

       me->start_call_out( (: call_other, __FILE__, "bidu_effect", me :), 10-me->query_skill("taiji-shengong")/10);
  me->start_busy(20-me->query_skill("taiji-shengong")/10);
	return 1;
}
void bidu_effect(object me)
{
    int killer,bonze_drug;
    killer =me->query_condition("killer");
    bonze_drug =me->query_condition("bonze_drug");
    me->clear_condition();
 if(killer)
    me->apply_condition("killer",killer);
    me->apply_condition("bonze_drug",bonze_drug);
    message_vision( HIW "$N吐出一口黑血，脸色看起来好多了。\n" NOR, me);
}
