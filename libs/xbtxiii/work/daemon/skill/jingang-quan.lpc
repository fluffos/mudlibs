#pragma save_binary
// jingang-quan.c -大金刚拳

inherit SKILL;


mapping *parry_act = ({
([	"action" : "$n盘膝而坐，二手合十，一式「莲花座」，挡住身前的空隙。",
]),
([	"action" : "$n一式「烈火锥」，双掌轮流下击，拳势如焰，吡啪爆响,防守的无懈可击。",
