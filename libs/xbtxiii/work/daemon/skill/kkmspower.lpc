#pragma save_binary
// kkmspower.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "spells" || usage == "magic"; }

string cast_spell_file(string spell) {
  return CLASS_D("kkmsp") + "/cast/" + spell;
}

string conjure_magic_file(string magic) {
  return CLASS_D("kkmsp") + "/conjure/" + magic;
}

int practice_skill(object me) {
  object bug;

  if ((int)me->query("mana") < 10 && (int)me->query("atman") < 10)
    return notify_fail("你的灵力或法力不够。\n");

  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神无法集中。\n");

  me->add("mana", -5); me->add("atman", -5);
  me->receive_damage("sen", 30);

  message_vision("$N闭目凝神，神游物外，开始修习金刚伏魔大法的法术....\n", me);
  if (random((int)me->query("sen")) < 5 || me->query("bellicosity") > 1000) {
    message_vision("突然金光一闪，出现一个肥头大耳的猪脸和尚！\n", me);
    message_vision("那和尚对着$N说道：我乃净坛使者猪悟能！吃我一耙！！\n", me);
    me->set("gin", 0); me->set("kee", 0); me->set("sen", 5);
    me->set("force", 0); me->set("atman", 0); me->set("mana", 0);
    me->add("sen", -10);
    tell_room(environment(me), "金光又是一闪，和尚不见了，" + me->name() + "昏倒在地。。。\n", me);
    return 0;
  } else return 1;
}

int valid_learn(object me) {
  if ((int)me->query_skill("kkmspower", 1) > (int)me->query("kar") * 3 + 30)
    return notify_fail("唉！！金刚伏魔大法最讲究机缘巧合，这位施主你不能够修习更高的金刚伏魔大法了\n");
  return 1;
}
