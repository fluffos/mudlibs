#pragma save_binary
#pragma save_binary

// dodge.c

inherit SKILL;

mapping *dodge_action = ({
  ([ "action": "但是和$p$l偏了几寸。\n", ]),
  ([ "action": "但是被$p机灵地躲开了。\n", ]),
  ([ "action": "但是$n身子一侧，闪了开去。\n", ]),
  ([ "action": "但是被$p及时避开。\n", ]),
  ([ "action": "但是$n已有准备，不慌不忙的躲开。\n", ]),
});

mapping query_dodge_action() {
  return dodge_action[random(sizeof(dodge_action))];
}
