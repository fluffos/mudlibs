// poweprattack.c

#include <ansi.h>
#include <combat.h>
#include <weapon.h>
#include <skill.h>
inherit SSERVER;

int perform_distance() {
  return 0;  //表示这一招perform是要有距离限制的.如果return 1表示这招perform没有任何距离限制
}
int perform(object me, object target) {
  string msg, weapon;
  int size;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("九剑合一的攻击范围内没有敌人。\n");
  if ((int)me->query_skill("dugu-jiujian-sword", 1) < 40)
    return notify_fail("你还不会这个剑式。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("force") < 150)
    return notify_fail("你的内力不够。\n");
  me->receive_damage("kee", 5);
  msg = "$N腾空跃起，大喝：" + HIY "九剑合一" NOR + "
只见$N连人带剑舞作一团光球向$n撞去！。。。\n";
  message_vision(msg, me, target);
  me->start_busy(2);
  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 4) {
    msg = "结果$p被$P攻了个措手不及！\n" NOR;
    message_vision(msg, me, target);
    size = ((int)(me->query_skill("dugu-jiujian-sword", 1) / 10));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    target->start_busy(4); return 1;
  } else {
    msg = "可是$p看破了$P的企图，并闪到一旁。\n" NOR;
  }

  message_vision(msg, me, target);
  return 1;
}
