// poqi.c 破气式
// 此破气式并非金庸原本的破气式，此破气式是专门破硬气功的，例如金刚不坏。
#include <ansi.h>

inherit F_SSERVER;

int perform(object me) {
  string msg;
  object weapon, target;
  int skill, dodge, parry;

  me->clean_up_enemy();
  target = me->select_opponent();

  skill = me->query_skill("dugu-jiujian-sword", 1);

  if (!(me->is_fighting()))
    return notify_fail("「破气式」只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if (skill < 160)
    return notify_fail("你的独孤九剑等级不够, 不能使用「破气式」！\n");

  if (target->query_temp("useless_iron_cloth"))
    return notify_fail(target->name() + "的金刚不坏之身已经被破了！\n");
  if (!target->query_skill("iron-cloth") && !target->query_skill("jin-gang"))
    return notify_fail(target->name() + "根本就没有硬气功！\n");
  if (me->query("force") < 150)
    return notify_fail("你的内力不够，无法运用「破气式」！\n");

  msg = HIC "$N潜运独孤九剑「破气式」，运气贯剑使其由利返钝，毫无花俏地直刺$n的命门。\n" NOR;
  message_vision(msg, me, target);

  skill += me->query_skill("sword");
  dodge = target->query_skill("dodge");
  parry = target->query_skill("parry");
  if (random(skill * 2) > random(dodge + parry)) {
    if (userp(me)) me->add("force", -200);
    msg = "$N运起「破气式」, $n顿时觉得眼前一花，命门上一阵剧痛，\n";
    msg += HIC "$n的铁不衫立刻被破了！\n" NOR;
    target->set_temp("useless_iron_cloth", 1);
    //combatd.c里面有"useless_iron_cloth"
    me->start_busy(random(2));
    //target->add_temp("apply/iron-cloth", -target->query_skill("jin-gang"));
    //有了useless_iron_cloth参数，金刚不坏完全失去作用，级别再高也没有用
    me->start_busy(3 + random(3));
  } else {
    if (userp(me)) me->add("force", -100);
    msg = "可是$n看破了$N的企图，立刻守紧门户，几经艰难终于还招挡开。\n" NOR;
    me->start_busy(4 + random(3));
  }
  message_vision(msg, me, target);
  return 1;
}
