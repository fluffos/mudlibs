  ([ "action": "$N施出「玉户帘中」，右掌向外挥出，左掌同时攻向$n",
  ]),
  ([ "action": "$N由臂带手，在面前缓缓划过，使一招「鸿雁长飞」，挥向$n的$l",
  ]),
