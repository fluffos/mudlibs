    "force": 40,
    "dodge": 10,
    "damage": 20,
    "lvl": 30,
    "skill_name": "灵蛇下涧",
    "damage_type": "挫伤"
  ]),
  ([ "action": "$N一招「灵蛇挺身」，手中$w猛烈扫向$n的$l",
    "force": 35,
    "dodge": 5,
    "damage": 20,
    "lvl": 40,
    "skill_name": "灵蛇挺身",
    "damage_type": "挫伤"
  ]),
  ([ "action": "$N使出一招「蛇游蟒走」，$w左右迂回向$n的$l扫去",
    "force": 40,
