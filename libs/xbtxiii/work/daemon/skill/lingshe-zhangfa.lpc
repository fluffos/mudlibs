#pragma save_binary
//lingshe_zhangfa.c 灵蛇杖法

#include <ansi.h>

inherit SKILL;

mapping *parry_act = ({
  ([ "action": "$n连忙使出一招「灵蛇出洞」，手中$v磕开$N的$w",
  ]),
  ([ "action": "$n把手中$v舞的阵阵风响，防御的无懈可击。",
  ]),
  ([ "action": "$n举起$v，居高临下使一招「灵蛇下涧」砸开了$N的$w",
  ]),
  ([ "action": "$n一招「灵蛇挺身」，手中$v猛烈砸开$N的$w",
  ]),
  ([ "action": "$n使出一招「巨蟒下山」，高举手中$v，劈头砸开了$N的$w",
  ]),
});
mapping *unarmed_parry_act = ({
  ([ "action": "$n连忙使出一招「灵蛇出洞」，手中$v架开了$N的攻击",
  ]),
  ([ "action": "$n把手中$v舞的阵阵风响，防御的无懈可击。",
  ]),
  ([ "action": "$n举起$v，居高临下使一招「灵蛇下涧」攻击$N的胸前大穴，$N立即收招躲避。",
  ]),
  ([ "action": "$n一招「灵蛇挺身」，手中$v挡住了胸前的破绽",
  ]),
  ([ "action": "$n使出一招「巨蟒下山」，高举手中$v，不退反进，劈头向$N砸去,$N立即后退。",
  ]),
  ([ "action": "$n使出一招「蛇游蟒走」，左右迂回,避开了$N的攻击",
  ]),
});

