//我(rongg)观察了sajaho使用这招perform的情况，出的好快.
//为此我更改了出招形式,如下：4/5的机会只能出8招当中的2+random(5)招,1/5的机会出
//齐8招.
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, i, j;
  object weapon;
  extra = me->query_skill("ruyi-dao", 1);
  if (extra < 90) return notify_fail("你的［天地人魔连环八式］还不够纯熟！\n");
  //        if ( me->query_skill("gouyee",1))//?
  if (!me->query_skill_mapped("force")
    || me->query_skill_mapped("force") != "beiming-shengong")
    return notify_fail("你感到一阵头晕,也许是北冥神功不纯净！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［天地人魔］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  if (random(5) > 0) {
    i = random(5) + 1;
    msg = HIY "$N神气贯通，将天地人魔连环八式之中的" + chinese_number(i + 1) + "式一气呵成！\n万魔初醒！" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    for (j = 1; j <= i; j++) {
      if (j == 1) msg = HIY "魔焰万丈！" NOR;
      if (j == 2) msg = HIY "魔光乍现！" NOR;
      if (j == 3) msg = HIY "天魔独尊！" NOR;
      if (j == 4) msg = HIY "万刃天魔！" NOR;
      if (j == 5) msg = HIY "天魔回天！" NOR;
      if (j == 6) msg = HIY "天魔七现！" NOR;
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    }
    me->start_busy(5);
    return 1;
  } else {
    msg = HIY "$N神气贯通，将天地人魔连环八式一气呵成！\n万魔初醒！" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIY "魔焰万丈！" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIY "魔光乍现！" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIY "天魔独尊！" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIY "万刃天魔！" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIY "天魔回天！" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIY "天魔七现！" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIY "万魔归宗！" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    me->start_busy(6);
  }
  return 1;
}
