inherit SKILL;

int valid_enable(string usage) { return usage == "iron-cloth"; }

int valid_learn(object me) { return 1; }

int practice_skill(object me) {
  return notify_fail("沾衣十八跌只能学。\n");
}

int query_rate(object me) { return 30; }

string *absorb_msg = ({
  "$n右臂一挥，内力澎湃而出，传入$N体内。\n",
  "$n左手一挥，内力澎湃而出，传入$N体内。\n",
});

string query_absorb_msg() {
  return absorb_msg[random(sizeof(absorb_msg))];
}

int bounce_ratio() {
  return 1;
}


void skill_improved(object me) {
  int s;
  s = (int)me->query_skill("zhanyi-shibadie", 1);
  if (random(s) > me->query_con()) {
    me->set_skill("zhanyi-shibadie", s - 1);
    tell_object(me, "你的天资有限，没能完全领悟更高深的沾衣十八跌。\n");
  }
}
