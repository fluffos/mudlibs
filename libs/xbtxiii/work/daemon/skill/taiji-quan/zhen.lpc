#pragma save_binary
// zhen.c 太极拳「震」字诀

#include <ansi.h>
#include <combat.h>

inherit SSERVER;
int perform(object me, object target)
{
	int extra;
	string msg;
	object weapon;

	if( !target ) target = offensive_target(me);

	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("神功震敌只能对战斗中的对手使用。\n");

	if( objectp(me->query_temp("weapon")) )
		return notify_fail("你必须空手才能使用「震」字诀！\n");		
		
        if( (int)me->query_skill("taiji-quan", 1) < 30 )
		return notify_fail("你的太极拳不够娴熟，不会使用「震」字诀。\n");
	                        
        if( (int)me->query_skill("taiji-shengong", 1) < 30 )
		return notify_fail("你的太极神功不够高，不能用来反震伤敌。\n");
    if ( (string) me->query_skill_mapped("force") != "taiji-shengong")
        return notify_fail("只有配合太极神功，才能使用「震」字诀。\n");
			
          if( (int)me->query("force", 1) < 100 )
		return notify_fail("你现在内力太弱，不能使用「震」字诀。\n");
			
        extra = me->query_skill("unarmed");
        if(extra <  50 ) return notify_fail("你的［太极拳］不够熟练！\n");
	me->add("force",-100);
	msg = HIR "$N默运神功，使出太极拳「震」字诀，企图以内力震伤$n。\n"NOR;
        weapon = me->query_temp("weapon");
        me->add_temp("apply/damage",extra*5);
        me->add_temp("apply/attack",extra/2);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        me->add_temp("apply/damage",-extra*5);
        me->add_temp("apply/attack",-extra/2);
        me->start_busy(3+random(3));
	return 1;
}
