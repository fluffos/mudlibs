#pragma save_binary
// combine.c

#include <ansi.h>

inherit SSERVER;
// inherit F_CLEAN_UP;
void remove_effect(object me, int amount);
int perform(object me, object target)
{
        int skill,skill1,skill2;

        if( target == me ) return 
notify_fail("你不能和自己双刀合壁。\n");

        if( !target )   return
notify_fail("你要和谁双刀合壁？\n");

        if( !present(target, environment(me)) )         return
notify_fail("你的伙伴目前不在此处。\n");

        if( !me->is_fighting() )        return
notify_fail("双刀合壁只能在战斗中使用.\n");

        if( !target->is_fighting() )    return
notify_fail("你的伙伴目前不在战斗中，不能使用双刀合壁。\n");

        if( me->is_fighting(target) )   return
notify_fail("你不能和你的对手双刀合壁。\n");
        
       if( (int)me->query_temp("blade_combine") ) return 
notify_fail("你已经在双刀合壁了。\n");

if( target->query_temp("blade_combine")==1 )        {
        skill1 = me->query_skill("blade");
        skill2 = target->query_skill("blade");
        skill = skill1+skill2;
        message_vision(
                HIR 
"$N和$n对视一眼，心领神会。忽然双刀合壁，刀光暴涨！！！\n" NOR, me, target);

        me->add_temp("apply/attack", skill/3);
        me->add_temp("apply/dodge", skill/3);
        me->set_temp("blade_combine", 2);
        target->set_temp("blade_combine", 2);
        target->add_temp("apply/attack",skill/3);
        target->add_temp("apply/dodge",skill/3);
        call_out("check",0,me,target,skill);
        }
        else 
        {
        me->set_temp("blade_combine",1);
        tell_object(target, MAG"如果你愿意和"+me->name()+"双刀合壁,"
+"那么请你对"+me->name()+"("+(string)me->query("id")+")"+"下一次perform combine命令.\n"NOR);
        };
        return 1;
}
int check(object me,object target,int skill)
{

        int time;
if(me&&!me->query_temp("Time"))
        {
        me->set_temp("Time",1);
        }

if(me)
        {
        me->add_temp("Time",1);
        time=me->query_temp("Time");
        }
if(time<=skill/2)
        {
        if(objectp(target))
            {
            if(objectp(me))
                {
                if(!me->is_fighting()
                   ||!target->is_fighting()
                   ||environment(target)!=environment(me))
//                 ||member_array(target->query("id"),enemy)==-1)
                    {
                    me->delete_temp("blade_combine");
                    target->delete_temp("blade_combine");
                    me->delete_temp("Time");
                    me->add_temp("apply/attack", - skill/3);
                    me->add_temp("apply/dodge", - skill/3);
                    target->add_temp("apply/attack", - skill/3);
                    target->add_temp("apply/dodge", - skill/3);
                    message_vision(HIB"刀光渐暗。$N和$n身形变缓。合壁消失!\n"NOR,me,target);
                    }
               else
                    {
                    call_out("check",1,me,target,skill);
                    return 1;
                    }
                  
                }
            else
                {
                target->delete_temp("blade_combine");
                target->add_temp("apply/attack", - skill/3);
                target->add_temp("apply/dodge", - skill/3);
                message_vision(HIB"刀光渐暗。$N身形变缓。合壁消失!\n"NOR,target);
                } 
            return 1;
            }
        else 
            {
            if(objectp(me))
                {
                me->add_temp("apply/attack", - skill/3);
                me->add_temp("apply/dodge", - skill/3);
                me->delete_temp("Time");
                me->delete_temp("blade_combine");               
                message_vision(HIB"刀光渐暗。$N身形变缓。合壁消失!\n"NOR,me);
                }
            else return 1;
            }

        }
else { // 合壁时间到了
        if(objectp(target))
            {
            if(objectp(me))
                {
                me->delete_temp("blade_combine");
                target->delete_temp("blade_combine");
                me->delete_temp("Time");
                me->add_temp("apply/attack", - skill/3);
                me->add_temp("apply/dodge", - skill/3);
                target->add_temp("apply/attack", - skill/3);
                target->add_temp("apply/dodge", - skill/3);
                message_vision(HIB"刀光渐暗。$N和$n身形变缓。合壁消失!\n"NOR,me,target);
                }
            else
                {
                target->delete_temp("blade_combine");
                target->add_temp("apply/attack", - skill/3);
                target->add_temp("apply/dodge", - skill/3);
                message_vision(HIB"刀光渐暗。$N身形变缓。合壁消失!\n"NOR,target);
                } 
            return 1;
            }
        else 
            {
            if(objectp(me))
                {
                me->delete_temp("Time");
                me->add_temp("apply/attack", - skill/3);
                me->add_temp("apply/dodge", - skill/3);
                message_vision(HIB"刀光渐暗。$N身形变缓。合壁消失!\n"NOR,me);               
                }
            else return 1;
            }
     }
        return 1;
}
