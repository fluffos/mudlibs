#pragma save_binary
// huntian-qigong.c
// written by Xiang

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me)  // need more limit here
{
  if (me->query_skill("bawang-force", 1)
    || me->query_skill("boluomiduo", 1)
    || me->query_skill("celestial", 1)
    || me->query_skill("fonxanforce", 1)
    || me->query_skill("gouyee", 1)
    || me->query_skill("huagong-dafa", 1)
    //	|| me->query_skill("huntian-qigong",1)
    || me->query_skill("hunyuan-yiqi", 1)
    || me->query_skill("iceforce", 1)
    || me->query_skill("taiji-shengong", 1)
    || me->query_skill("zixia-shengong", 1))
    return notify_fail("你不先散了别派内功，怎能学本派神功？！\n");
  return 1;
}

int practice_skill(object me) {
  return notify_fail("混天气功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func) {
  return CLASS_D("shaolin") + "/huntian-qigong/" + func;
}
