// poweprattack.c

#include <ansi.h>
#include <combat.h>
#include <weapon.h>
#include <skill.h>
inherit SSERVER;

int perform(object me, object target)
{	object weapon;
	string msg,*limbs,parry_skill;
	int i,size,damage,ap,pp;
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
        return notify_fail(HIR"六脉合一"NOR+"只能对战斗中的对手使用。\n");
        if( objectp(me->query_temp("weapon")) )
                return notify_fail("你必须空手才能使用"HIR"六脉合一"NOR"！\n");         
    if( (int)me->query_skill("finger",1) < 120)
        return notify_fail("你的基本指法不够。\n");
    if( (int)me->query_skill("liumai-shenjian",1) < 120)
        return notify_fail("你的六脉神剑等级还不够,无法使出六脉合一。\n");
    if( (int)me->query("force") < 5000)
		return notify_fail("你的内力不够。\n");
    me->add("force", -3000);
	me->receive_damage("kee", 5);
	me->receive_damage("sen", 10);
	me->receive_damage("gin", 5);
        msg = "$N鼓荡全身真气,内力源源涌出,十指凌空乱点
 同时使出了"+RED"少商、商阳、中冲、关冲、少冲、少泽"NOR+"六脉剑法,
        但见剑气纵横飞舞,挟着惊人气势，把$n紧紧罩住.";
	message_vision(msg, me, target);
     me->start_busy(6);
	limbs=target->query("limbs");
if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/5 )
		{
  msg = CYN "结果$N被剑气围住,无法闪避！\n"NOR;
		message_vision(msg, target);
tell_object(target,"你只觉得漫天都是剑气,心神大乱下,无法闪避。\n");
        size=(int)(me->query_skill("liumai-shenjian")/10);
ap=size*10;
weapon=0;
      damage=random(size*4)+size*4+me->query("force")/20;
damage=damage+me->query_str()+random(me->query_temp("apply/damage"));
 msg =HIB"“嗤”，气剑刺中了$p"+limbs[random(sizeof(limbs))]+"。\n"NOR;
            target->receive_damage("kee",damage);
                        target->receive_wound("kee",damage/3);
			message_vision(msg, me, target);
			COMBAT_D->report_status(target);
     target->start_busy(2);return 1;
	} else {
		msg = "可是$p看破了$P的企图，并闪到一旁。\n" NOR;
	}

	message_vision(msg, me, target);
	return 1;
}
