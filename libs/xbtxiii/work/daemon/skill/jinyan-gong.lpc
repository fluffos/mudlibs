inherit SKILL;

mapping *action = ({
([	"action" : "$n足尖在地面一点，身形拔地而起，躲开了这一招。\n",
	//"dodge"  : 10,	//使用本招再加10%的躲避能力。
]),
([	"action" : "却不料$n身形一转，突然转到了$N的身后。\n",
	//"dodge"  : 10,
]),
([	"action" : "$n随着$N攻来的招式飘了起来，就如一片微风中的柳絮一般。\n",
	//"dodge"  : 10,
]),
([	"action" : "$n身形左一晃、右一闪，不知怎么的，从攻击的间隙中钻了出来。\n",
	//"dodge"  : 10,
]),
([	"action" : "$n足不点地地围绕$N连绕三个大圈，把$N这一招避了开去。\n",
	//"dodge"  : 10,
]),
([	"action" : "$n连旋数个大圈，跟着又是一个大圈，身形高高地拔了起来。\n",
	//"dodge"  : 10,
]),
});

