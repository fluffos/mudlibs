#pragma save_binary
// 天地同寿
#include <ansi.h>

inherit SSERVER;
int perform(object me, object target) {
  string msg;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("现在你想死吗？不如用suicide -f来得更快!\n");

  if ((int)me->query_skill("taiji-jian", 1) < 100)
    return notify_fail("你的太级剑法级别太低了,现在用无疑是自杀.\n");

  message_vision(HIY "$N的脸上忽然无限凄凉，泪水涟涟。像是有了极度伤心的事。。。\n" NOR, me, target);
  message_vision(HIY "$N猛的喊了一声:天～　 地～　 同～　 寿～　 。\n"
    "手中的长剑向自己的腹部猛刺去！！！\n\n" NOR, me, target);
  message_vision(YEL "看样子$N要和$n同归于尽!!!\n" NOR, me, target);
  if ((int)me->query("combat_exp") >= (int)target->query("combat_exp") * 3 / 4
    && (int)me->query_skill("taiji-jian", 1) >= (int)target->query_skill("dodge", 1) * 3 / 4) {
    message_vision(HIR "长剑对穿而过,穿透了$N的小腹.$n竟然没有发觉.\n"
      "结果也被长剑刺中小腹立即和$N同时毙命.....\n" NOR, me, target);
    me->die();
    target->die();
  } else if ((int)me->query("combat_exp") <= (int)target->query("combat_exp")
    && (int)me->query_skill("taiji-jian", 1) >= (int)target->query_skill("dodge", 1) * 3 / 4) {
    message_vision(HIR "长剑对穿而过,立刻穿透了$N的小腹.$n见状大吃一惊立即闪电一般朝旁边越开.\n"
      "可惜已经晚了，长剑还是刺入了$n的小腹寸许.$N立即毙命，$n却生死未扑.\n" NOR, me, target);
    me->die();
    target->set("eff_kee", 10);
    target->set("eff_gin", 10);
    target->set("eff_sen", 10);
    target->unconcious();
  } else {
    message_vision(HIR "长剑对穿而过，立刻穿透了$N的小腹.$n见状大吃一惊.立即闪电\n"
      "一般朝旁边越开.总算$n武功高超，在着千钧一发的瞬间躲开了这\n"
      "一招同归于尽的打法.但是$n也吓的出了一身冷汗!\n\n"
      "可怜的$N立即毙命..\n" NOR, me, target);
    me->die();
  }
  return 1;
}
