#pragma save_binary
// spring-blade.c

inherit SKILL;
string perform_action_file(string action) {
  return CLASS_D("fighter") + "/spring-blade/" + action;
}
mapping *parry_act = ({
  ([ "action": "$n手中$v斜指，一招「春风拂人醉」，反身一顿，一刀向$N的必救之处撩去",
  ]),
  ([ "action": "$n一招「倩影惹人怜」，左右腿虚点，$v一提一收，平刃挥向$N的颈部,逼得$N中途撤招。",
  ]),
  ([ "action": "$n展身虚步，提腰跃落，一招「飞花逐人香」，刀锋一卷，拦腰斩向$N",
  ]),
  ([ "action": "$n一招「芦雪碎人影」，$v大开大阖，自上而下划出一个大弧，笔直劈向$w",
  ]),
  ([ "action": "$n手中$v一沉，一招「芦雪碎人影」，双手持刃拦腰反切，砍向$N持$w的右手",
  ]),
  ([ "action": "$n挥舞$v，使出一招「远山伴人痴」，上劈下撩，左挡右开，磕开了$N手中的$w",
  ]),
  ([ "action": "$n一招「飞花逐人香」，左脚跃步落地，$v顺势往前，挟风声劈向$N的$w",
  ]),
  ([ "action": "$n盘身驻地，一招「彩蝶灼人衣」，挥出一片流光般的刀影，护住了全身。",
  ]),
});
mapping *unarmed_parry_act = ({
  ([ "action": "$n手中$v斜指，一招「春风拂人醉」，反身一顿，一刀向$N的必救之处撩去",
  ]),
  ([ "action": "$n一招「芦雪碎人影」，左右腿虚点，$v一提一收，平刃挥向$N的颈部,逼得$N中途撤招。",
  ]),
  ([ "action": "$n展身虚步，提腰跃落，一招「倩影惹人怜」，刀锋一卷，拦腰斩向$N",
  ]),
  ([ "action": "$n手中$v一沉，一招「远山伴人痴」，双手持刃拦腰反切，砍向$N的右手",
  ]),
  ([ "action": "$n盘身驻地，一招「彩蝶灼人衣」，挥出一片流光般的刀影，护住了全身。",
  ]),
});
mapping *action = ({
  ([ "action": "$N使一招「春风拂人醉」，手中$w轻飘飘地向$n的$l斩去！",
    "damage": 75,
    "force": 30,
    "parry": 15,
    "dodge": 20,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N金刃劈风，$w随著一招「远山伴人痴」由下而上撩往$n的$l",
    "damage": 60,
    "force": 25,
    "parry": 15,
    "dodge": 15,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N身形一转，一招「飞花逐人香」$w刀光不定，斩向$n的$l",
    "damage": 63,
    "force": 25,
    "parry": 0,
    "dodge": 0,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N舞动$w，一招「柳叶随人笑」迅捷无伦地劈向$n的$l",
    "force": 60,
    "damage": 45,
    "dodge": -5,
    "parry": -5,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w一晃，一招「倩影惹人怜」往$n的$l斜斜砍出一刀",
    "damage": 65,
    "force": 20,
    "parry": -10,
    "dodge": -10,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N提刀过肩，蓄劲发力，一招「芦雪碎人影」直劈$n$l",
    "damage": 50,
    "force": 15,
    "parry": -15,
    "dodge": -15,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N移步侧身，使一招「彩蝶灼人衣」刀光霍霍斩向$n的$l",
    "damage": 60,
    "force": 15,
    "parry": -20,
    "dodge": -20,
    "damage_type": "割伤"
  ]),
});
int query_rate(object me) { return 0; }
mapping query_parry_action(object weapon) {
  if (weapon)
    return parry_act[random(sizeof(parry_act))];
  else return unarmed_parry_act[random(sizeof(unarmed_parry_act))];
}

int valid_learn(object me) {
  object weapon;
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，没有办法练春风快意刀。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀，才能练刀法。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "blade") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀，才能练刀法。\n");

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练这门刀法，还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}
