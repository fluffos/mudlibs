#pragma save_binary
// zhaixinggong.c based on xiaoyaoyou.c
// by yucao

inherit SKILL;

mapping *dodge_act = ({
([  "action":"$n一个「天外摘星」，跃起数尺，躲过了$N这一招。\n",
]),
([  "action":"$n身形向后一纵，使出一招「飘然出尘」，避过了$N的攻击。\n",
]),
([  "action":"$n使出「天狼涉水」，恰好躲过了$N的攻势。\n",
]),
([  "action":"$n一招「织女穿梭」，姿态美妙地躲了开去。\n"
]),
});
int query_rate(object me) { return 0;}
int valid_enable(string usage) 
{ 
	return (usage == "dodge") || (usage == "move"); 
}

int valid_learn(object me) { return 1; }

mapping query_dodge_action()
{
        return dodge_act[random(sizeof(dodge_act))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 40 )
                return notify_fail("你的体力太差了，不能练摘星功。\n");
	if (me->query_skill("zhaixinggong", 1) < 30)
	        me->receive_damage("kee", 10);
	else if (me->query_skill("zhaixinggong", 1) < 60)
		me->receive_damage("kee", 20);
	else 
		me->receive_damage("kee", 30);
        return 1;
}

