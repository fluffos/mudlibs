#pragma save_binary
// huashan-jianfa.c 华山剑法

inherit SKILL;

mapping *action = ({
  ([ "action": "$N一招「白云出岫」，手中$w点向$n的$l",
    "attack": 10,  //本人攻击力加10%
    "force": 20,  //本人臂力造成伤害加40%
    "damage": 40,  //武器增加80%的杀伤力
    "dodge": 10,  //对方的躲避能力加10%
    "parry": 10,  //对方的招架能力加10%
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N使出「有凤来仪」，$w闪烁不定，刺向$n的$l",
    "damage": 50,
    "force": 15,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N一招「天绅倒悬」，$w自上而下划出一个大弧，向$n劈砍下去",
    "damage": 50,
    "force": 20,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N向前跨上一步，手中$w使出「白虹贯日」直刺$n的$l",
    "damage": 45,
    "force": 25,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N手中的$w一晃，使出「苍松迎客」直刺$n的$l",
    "damage": 55,
    "force": 18,
    "damage_type": "刺伤",
  ]),
});
mapping *parry_act = ({
  ([ "action": "$n使出一招「苍松迎客」，手中的$v化作一条长虹，磕开了$N的$w。\n",
    "parry": 10,         //使用本招会增加10%的招架能力
  ]),
  ([ "action": "$n使出「封」字诀，将$N的$v封于丈外。\n",
    "parry": -5,         //使用本招会减少5%的招架能力
  ]),
  ([ "action": "$n使出一招「有凤来仪」，手中的$v化做漫天剑影，荡开了$N的$w。\n",
  ]),
  ([ "action": "$n手中的$v一抖，一招「白云出岫」，反向$N拿$w的手腕削去。\n",
  ]),
});

mapping *unarmed_parry_act = ({
  ([ "action": "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
  ]),
  ([ "action": "$n反手一招「天绅倒悬」，整个人消失在一团剑光之中。\n",
  ]),
  ([ "action": "$n使出一招「白虹贯日」，$v直刺$N的双手。\n",
  ]),
  ([ "action": "$n将手中的$v化做七条剑气，迫得$N连连后退。\n",
  ]),
});

mapping query_parry_action(object weapon) {
  if (weapon)
    return parry_act[random(sizeof(parry_act))];
  else
    return unarmed_parry_act[random(sizeof(unarmed_parry_act))];
}
int query_rate(object me) { return 10; }  //本项武功强度是标准强度的110%

int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me) {
  if ((int)me->query("max_force") < 80)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("zixia-shengong", 1) < 20)
    return notify_fail("你的华山内功火候太浅。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你的体力不够练华山剑法。\n");
  me->receive_damage("kee", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "huashan-jianfa/" + action;
}
