int query_rate(object me) { return 10; }
mapping query_parry_action(object weapon) {
  return parry_act[random(sizeof(parry_act))];
}

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry" || usage == "hand"; }

int valid_combine(string combo) { return combo == "liuyang-zhang"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练天山折梅手必须空手。\n");
  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力太弱，无法练天山折梅手。\n");
  if ((int)me->query_skill("beiming-shengong", 1) < 20)
    return notify_fail("你的北冥神功火候不够，无法练天山折梅手。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("zhemei-shou", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够练天山折梅手。\n");
  me->receive_parry("kee", 25);
  me->add("force", -10);
  return 1;
}

string perform_action_file(string action, object me) {
  return __DIR__ "zhemei-shou/" + action;
  me->start_busy(4);
}
