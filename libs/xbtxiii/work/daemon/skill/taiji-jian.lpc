int query_rate(object me) { return 20; }
int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me) {
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够修炼太级剑.\n");
  if ((int)me->query_skill("taiji-shengong", 1) < 20)
    return notify_fail("你的太极神功火候太浅,领会不了太级剑。\n");
  return 1;
}

mapping query_parry_action(object weapon) {
  if (weapon)
    return parry_act[random(sizeof(parry_act))];
  else return unarmed_parry_act[random(sizeof(unarmed_parry_act))];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("taiji-jian", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[random(i)];

}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你的体力不够练太极剑法。\n");
  me->receive_damage("kee", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "taiji-jian/" + action;
}
