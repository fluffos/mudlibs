#pragma save_binary
// taiji-jian.c 太极剑

inherit SKILL;

mapping *parry_act = ({
  ([ "action": "$n身形往右一挫，左手剑诀，右手$v使出一式「大魁星」磕开了$N的$w",
  ]),
  ([ "action": "$n双膝下沉，右手$v使出一式「探海式」，由下而上架开了$N的$w",
  ]),
  ([ "action": "$n一招「燕子掠波」，$v自上而下划出一个大弧，平平地扫开了$N的$w",
  ]),
  ([ "action": "$n上身往左侧一拧，一招「乌龙摆尾」，右手$v反手挥开了$N的$w",
  ]),
  ([ "action": "$n左腿提膝，手中$v斜指，一招「宿鸟投林」挡开了$N的$w",
  ]),
  ([ "action": "$n一招「青龙出水」，$v自下而上划出一个大弧，平平地挥开了$N的$w",
  ]),
  ([ "action": "$n一招「风卷荷叶」，$v轻灵地划出几个圆弧，$N竟然无法攻进去,",
  ]),
  ([ "action": "$n一招「虎抱头」，$v划出一个左低右高的大弧，斜斜挡开了$N的$w",
  ]),
  ([ "action": "$n使出「狮子摇头」，$v由右向左划出一个大８字，封住了$N的进攻.",
  ]),
  ([ "action": "$n左脚踏实，右脚虚点，一招「仙人指路」，右手$v带出一团剑花，完全封住了$N的路子.",
  ]),
  ([ "action": "$n轻轻跃起，一招「野马跳涧」，$v在半空中化为一圈银芒，封住了$N的$w",
  ]),
  ([ "action": "$n两腿前箭后弓，一招「射雁式」，右手$v架开了$N的$w",
  ]),
  ([ "action": "$n一招「小魁星」，身形往左一挫，左手剑诀，右手$v平平地将$N的$w架开.",
  ]),
  ([ "action": "$n猱身扑上，一招「白猿献果」，手中$v斜斜地挥开了$N的$w.",
  ]),
  ([ "action": "$n一招「迎风掸尘」，$v看似随意地一挥，$N却陡觉一股劲气迎面袭来,不得不立即后退.",
  ]),
  ([ "action": "$n一招「顺水推舟」，$v自上而下划出一个大弧，平平地磕开了$N的$w.",
  ]),
  ([ "action": "$n一招「流星赶月」，$v疾砍$N的$w,只听当的一声,$N的$w被当开了.",
  ]),
  ([ "action": "$n突然盘蹲下身来，一招「海底捞月」，$v自下而上地挥开了$N的$w.",
  ]),
  ([ "action": "$n一招「挑帘式」，$v自下而上徐徐划出一个大弧，平平地挥开了$N的$w. ",
  ]),
  ([ "action": "$n一招「黄蜂入洞」，$v自上而下划出一个大弧，平平地将$N的$w挥开了.",
  ]),
  ([ "action": "$n一招「大鹏展翅」，身形跃起，不退反进,右手$v急刺$N,$N被迫回招自救.",
  ]),
  ([ "action": "$n一招「车轮剑」，$v化作一片银盘，将自己保护在了银盘之中.",
  ]),
  ([ "action": "$n左脚轻点地面，身形往前一扑，一招「天马行空」，$v磕开了$N的$w.",
  ]),
  ([ "action": "$n一招「风扫梅花」，身体跃在半空，手中$v差点将$N的$w砸掉.",
  ]),
  ([ "action": "$n虚步提腰，一招「蜻蜓点水」，手中$v轻轻颤动，颤出点点剑花,使$N不感贸然进攻.",
  ]),
  ([ "action": "$n向前跨上一步，左手剑诀，右手$v使出一式「指南针」,不退反进,直刺$N,$N吓的立刻后越.",
  ]),
  ([ "action": "$n一招「燕子掠波」，$v自上而下划出一个大弧，平平将$N的$w扫开了.",
  ]),
  ([ "action": "$n一招「右拦扫」，一招「左拦扫」，剑锋平指，一气呵成横扫$N的$w",
  ]),
  ([ "action": "$n使出「三环套月」，$v划出三个圆圈，防御的滴水不漏.",
  ]),
  ([ "action": "$n左脚踏实，右脚虚点，一招「仙人指路」，右手$v化做一团剑花，将$N的$w封在外面.",
  ]),
  ([ "action": "$n一招「却步抽剑」，左脚跃步落地，$v回抽，反手勾住了$N的$w,轻轻一拉,差点将$w拉掉.",
  ]),
  ([ "action": "$n右腿半屈般蹲，一招「如封似闭」，剑尖虚指，转身撩开了$N的$w",
  ]),
  ([ "action": "$n回身拧腰，右手虚抱，一招「拨云瞻日」，$v中宫直进，刺向$N,$N大惊,立刻后越.",
  ]),
});

