#include <ansi.h>
inherit SSERVER;
 
int perform(object me, object target)
{
        int level,temp;
        string msg;
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
               { return notify_fail("醉打八仙只能对战斗中的对手使用。\n");
}
        if(me->query_temp("baxian")>=1)
                return notify_fail("你现在正在施展这招。。。\n");
         
        if( (int)me->query("force") < 500 )
                return notify_fail("你的内力修为还不够高。\n");
        
         if ((int)me->query_skill("hunyuan-yiqi", 1) < 20)
                return notify_fail("你的混元一气功火候不够，无法打出醉打八仙。\n");        
        
        level=me->query_skill("baxian",1);

        if(level<120&&level>=100)
             temp=7;

        else if(level<100&&level>=90)
             temp=6;
        else if(level<90&&level>=80)
             temp=5;
        else if(level<70&&level>=60)
             temp=4;
        else if(level<60&&level>=50)
             temp=3;
        else if(level<50&&level>=40)
             temp=2;
        else if(level<40&&level>0)
             temp=1;          
        else 
             temp=8;
        me->set_temp("can_attacks",temp);
        me->set_temp("now_attacks",1);
        me->set_temp("baxian",1);
        msg = HIR  "$N手中棍花团团，使出少林醉棍的绝技[醉打八仙]，疾风般卷向对方\n" NOR;
        message_vision(msg, me, target);
        this_object()->agress(me,target);
        return 1;
}


int agress(object me,object target)
{
        int j,attacked_times,attack_times,busy;
        string msg;
	if(!me||!objectp(me)||!target||!objectp(target))
	{
                me->delete_temp("now_attacks");
                me->delete_temp("can_attacks");
                me->delete_temp("baxian");            
		return 1;
	}
        attack_times=me->query_temp("can_attacks");
        attacked_times=me->query_temp("now_attacks");
        if(!target
                 ||environment(target)!=environment(me)
                 ||target->query("kee")<=0
                 ||me->query("kee")<=0
                 ||me->query("sen")<=0
                 ||me->query("gin")<=0
                 ||!me->is_fighting())
        {
        	me->delete_temp("now_attacks");
                me->delete_temp("can_attacks");
                me->delete_temp("baxian");            
                return 1;
        } 
	if(me->query_temp("weapon"))
    	{

    		if (attacked_times<=attack_times)
        	{
        		switch(attacked_times)
              		{
              		case 1:
                   		msg = HIY  "第一棍  ------   张果老，醉酒抛杯倒骑驴\n" NOR;
                   		break;
              		case 2:
                   		msg = HIY  "第二棍  ------   吕洞宾，酒醉提壶力千钧\n" NOR;
                   		break;
              		case 3:
                   		msg = HIY  "第三棍  ------   铁拐李，踢倒金山醉玉池\n" NOR;
                   		break;
              		case 4:
                   		msg = HIY  "第四棍  ------   蓝采和，提篮劝酒醉朦胧\n" NOR;
                   		break;
              		case 5:
                   		msg = HIY  "第五棍  ------   曹国舅，千杯不醉倒金盅\n" NOR;
                   		break;
              		case 6:
                   		msg = HIY  "第六棍  ------   何仙姑，拦腰敬酒醉仙步\n" NOR;
                   		break;
              		case 7:
                   		msg = HIY  "第七棍  ------   韩湘子，铁棍提胸醉拔萧\n" NOR;
                   		break;
              		case 8:
                   		msg = HIY  "第八棍  ------   汉钟离，跌步翻身醉盘龙\n" NOR;
                   		break;
              		}
        		message_vision(msg,me,target);
        		for(j=1;j<=attacked_times;++j)
              		{
              			message_vision(HIW"\t\t第～　　"+j+"　　～　　棍。      \n"NOR,me,target);
              			COMBAT_D->do_attack(me,target, me->query_temp("weapon"));            
              			if(!target
                 		||environment(target)!=environment(me)
                 		||target->query("kee")<=0
                 		||me->query("kee")<=0
                 		||me->query("sen")<=0
                 		||me->query("gin")<=0)
                    		{
                    			me->delete_temp("now_attacks");
                    			me->delete_temp("can_attacks");
                    			me->delete_temp("baxian");            
                    			me->start_busy(-200);
                    			return 1;
                    		}
              		}
                	switch(attacked_times)
                        {
                        	case 1: busy=1; break;
                        	case 2: busy=2; break;
                        	case 3: busy=2; break;
                        	case 4: busy=2; break;
                        	case 5: busy=2; break;
                        	case 6: busy=4; break;
                        	case 7: busy=8; break;
                        	case 8: busy=2; break;
            			default: busy=0; break;
                        }
        		me->start_busy(busy);
        		call_out("agress",busy,me,target);
        		me->add_temp("now_attacks",1);
        		return 1;
        	}
    		else
        	{
        		me->delete_temp("now_attacks");
        		me->delete_temp("can_attacks");
		        me->delete_temp("baxian");
        		me->start_busy(-200);
        		return 1;
        	}
    	}
	else 
        { 
        	me->delete_temp("now_attacks");
        	me->delete_temp("can_attacks");
        	me->delete_temp("baxian");
        	me->start_busy(-200);
        	return 1;
        }
}
 


