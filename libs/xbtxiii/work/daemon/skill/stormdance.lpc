#pragma save_binary
// sttormdance.c

#include <ansi.h>
inherit SKILL;

mapping *dodge_act = ({
  ([ "action": "$n朗声高歌「" + HIC "迷仙引" NOR + "」轻轻巧巧地避了开去。\n",
  ]),
  ([ "action": "只见$n身影一晃，低唱「" + HIY "醉花荫" NOR + "」早已避开。\n",
  ]),
  ([ "action": "$n婉转动听地唱一支「" + CYN "踏莎行" NOR + "」，轻轻松松地闪过。\n",
  ]),
  ([ "action": "$n轻歌曼舞，一曲「" + HIM "眼儿媚" NOR + "」腾空而起，避了开去。\n",
  ]),
  ([ "action": "可是$n唱一首「" + MAG "虞美人" NOR + "」，身子轻轻飘了开去。\n",
  ]),
  ([ "action": "$n身影微动，已经和着「" + HIM "行香子" NOR + "」轻轻落在$N的身后。\n",
  ]),
  ([ "action": "$n凌空一翻,随着「" + RED "蝶恋花" NOR + "」幽扬的歌声，滑在$N身侧。\n"
  ]),
  ([ "action": "$n低声叹道「" + HIC "花谢花飞飞满天，红消香断有谁怜?" NOR + "」轻轻巧巧地避了开去。\n",
  ]),
  ([ "action": "只见$n身影一晃，低唱「" + HIY "游丝软系飘春榭，落絮轻沾扑绣帘." NOR + "」早已避开。\n",
  ]),
  ([ "action": "$n幽怨轻叹「" + CYN "闺中女儿惜春暮，愁绪满怀无着处." NOR + "」，轻轻松松地闪过。\n",
  ]),
  ([ "action": "$n轻歌曼舞，一曲「" + HIM "唐多令" NOR + "」腾空而起，避了开去。\n",
  ]),
  ([ "action": "可是$n唱一首「" + MAG "西江月" NOR + "」，身子轻轻飘了开去。\n",
  ]),
  ([ "action": "$n身影微动，已经和着「" + HIM "临江仙" NOR + "」轻轻落在$N的身后。\n",
  ]),
  ([ "action": "$n凌空一翻,咛着「" + RED "一朝春尽红颜老，花落人亡两不知!" NOR + "」，滑在$N身侧。\n",
  ]),
  ([ "action": "$n身子一侧，叹了一声「" + RED "柳丝榆荚自芳菲，不管桃飘与李飞." NOR + "」，滑在七尺之外。\n"
  ]),
});
int query_rate(object me) {
  if (me->is_fighting()) return 25;
  else return 10;
}
int valid_enable(string usage) { return (usage == "dodge") || usage == "move"; }

int valid_learn(object me) {
  if ((string)me->query("gender") != "女性")
    return notify_fail("七宝天岚舞只有女性才能练。\n");
  if ((int)me->query("spi") < 10)
    return notify_fail("你的灵性不够，没有办法练七宝天岚舞。\n");

  return 1;
}

mapping query_dodge_action(string limb) {
  return dodge_act[random(sizeof(dodge_act))];
}

int practice_skill(object me) {
  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神太差了，不能练七宝天岚舞。\n");
  me->receive_damage("sen", 30);
  return 1;
}

void skill_improved(object me) {
  int s;

  s = me->query_skill("stormdance", 1);
  if (s % 10 == 9 && (int)me->query("per") < s / 4) {
    tell_object(me, HIW "由於你的勤练舞艺，常采日月之光华,你变得更漂亮
了。\n" NOR);
    me->add("per", 2);
  }
}
string perform_action_file(string action) {
  return __DIR__ "stormdance/" + action;
}
