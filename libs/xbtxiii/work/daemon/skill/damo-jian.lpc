// damo-jian.c 达摩剑

inherit SKILL;

mapping *action = ({
  ([ "action": "$N使一式「万事随缘往」，手中$w嗡嗡微振，幻成一条疾光刺向$n的$l",
    "force": 10,
    "dodge": 10,
    "damage": 45,
    "lvl": 0,
    "skill_name": "万事随缘往",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N错步上前，使出「来去若梦行」，剑意若有若无，$w淡淡地向$n的$l挥去",
    "force": 20,
    "dodge": 5,
    "damage": 35,
    "lvl": 9,
    "skill_name": "来去若梦行",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一式「浮世沧桑远」，纵身飘开数尺，运发剑气，手中$w遥摇指向$n的$l",
    "force": 15,
    "dodge": 5,
    "damage": 45,
    "lvl": 18,
    "skill_name": "浮世沧桑远",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N纵身轻轻跃起，一式「轮回法舟轻」，剑光如轮疾转，霍霍斩向$n的$l",
    "force": 18,
    "dodge": 0,
    "damage": 40,
    "lvl": 27,
    "skill_name": "轮回法舟轻",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w中宫直进，一式「水月通禅寂」，无声无息地对准$n的$l刺出一剑",
    "force": 18,
    "dodge": -5,
    "damage": 42,
    "lvl": 36,
    "skill_name": "水月通禅寂",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w斜指苍天，剑芒吞吐，一式「鱼龙听梵音」，对准$n的$l斜斜击出",
    "force": 20,
    "dodge": -5,
    "damage": 45,
    "lvl": 44,
    "skill_name": "鱼龙听梵音",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N左指凌空虚点，右手$w逼出丈许雪亮剑芒，一式「千里一苇去」刺向$n的$l",
    "force": 30,
    "dodge": 5,
    "damage": 35,
    "lvl": 52,
    "skill_name": "千里一苇去",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N合掌跌坐，一式「禅心顿自明」，$w自怀中跃出，如疾电般射向$n的胸口",
    "force": 28,
    "dodge": 15,
    "damage": 40,
    "lvl": 60,
    "skill_name": "禅心顿自明",
    "damage_type": "刺伤"
  ]),
});
mapping *parry_act = ({
  ([ "action": "$n使一式「万事随缘往」，手中$v嗡嗡微振，幻成一条疾光刺中$N的$w",
    "parry": 20,
  ]),
  ([ "action": "$n错步上前，使出「来去若梦行」，剑意若有若无，$v淡淡地向$N挥去,却使$N的招式发不出来",
    "parry": 20,
  ]),
  ([ "action": "$n一式「浮世沧桑远」，纵身飘开数尺，运发剑气，手中$v磕开$N的$w",
    "parry": 20,
  ]),
  ([ "action": "$n纵身轻轻跃起，一式「轮回法舟轻」，剑光如轮疾转，护住全身",
    "parry": 20,
  ]),
  ([ "action": "$n手中$v中宫直进，一式「水月通禅寂」，无声无息地磕开了$N的$w",
    "parry": 20,
  ]),
  ([ "action": "$n手中$v斜指苍天，剑芒吞吐，一式「鱼龙听梵音」，将$N的$w斜斜引开",
    "parry": 20,
  ]),
  ([ "action": "$n左指凌空虚点，右手$v逼出丈许雪亮剑芒，一式「千里一苇去」直迫的$N不住的后退",
    "parry": 20,
  ]),
  ([ "action": "$N合掌跌坐，一式「禅心顿自明」，$v自怀中跃出，如疾电般射向$N的胸口,$N为求自保，立即收招",
    "parry": 20,
  ]),
});
mapping *unarmed_parry_act = ({
  ([ "action": "$n使出一招「轮回法舟轻」，在身前布起了一道铜墙铁壁，封住了$N的攻势。\n",
    "parry": 20,
  ]),
  ([ "action": "$n一抖手中的$v，使出一招「禅心顿自明」，手中的$v护住了全身。\n",
    "parry": 20,
  ]),
  ([ "action": "$n将$v往地上一刺，$v反弹起来，刚好直刺$N的双臂。\n",
    "parry": 20,
  ]),
  ([ "action": "$n举剑静立，一股内力从剑梢透出，逼开了$N。\n",
    "parry": 20,
  ]),
});

int query_rate(object me) { return 20; }
mapping query_parry_action(object weapon) {
  if (weapon)
    return parry_act[random(sizeof(parry_act))];
  else return unarmed_parry_act[random(sizeof(unarmed_parry_act))];
}
int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_combine(string combo) { return combo == "xiuluo-dao"; }

int valid_learn(object me) {
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("hunyuan-yiqi", 1) < 20)
    return notify_fail("你的混元一气功火候太浅。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "damo-jian/" + action;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("damo-jian", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[random(i)];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你的体力不够练达摩剑。\n");
  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够练达摩剑。\n");
  me->receive_damage("kee", 25);
  me->add("force", -20);
  return 1;
}
