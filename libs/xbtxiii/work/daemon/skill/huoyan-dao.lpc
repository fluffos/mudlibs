inherit SKILL;

mapping *parry_act = ({
  ([ "action": "$n使出一招「钻木取火」，飞身急转，双掌向前平平拍向$N的必救之处。,",
  ]),
  ([ "action": "$n使出一招「祝融怀焰」，手掌如刀，斜斜引开$N的攻击。",
  ]),
  ([ "action": "$n使出一招「风火无边」，双掌一拍，一道内力自掌中攻向$N的必救之处。",
  ]),
  ([ "action": "$n使出一招「六道轮回」，双手合十，架住了$N的这招。",
  ]),
  ([ "action": "$n使出一招「双龙吐焰」，双掌一错，两道内力引开了$N的这招。",
  ]),
  ([ "action": "$n使出一招「刀山火海」，顿时万千道内力$n向四面八方放射出去。$N竟然无从下手。",
  ]),
  ([ "action": "$n使出一招「白佛光度」，左臂回收，右掌引内力引开$N的双手。",
  ]),
  ([ "action": "$n使出一招「火内莲花」，双掌微并，两臂前伸，顿时一道内劲布在$n身前。",
  ]),
});
mapping *action = ({
  ([ "action": "$N使出一招「钻木取火」，飞身急转，双掌向前平平拍向$n",
    "skill_name": "钻木取火",
    "force": 50,
    "lvl": 0,
    "damage": 30,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「祝融怀焰」，手掌如刀，斜斜劈向$的$l",
    "skill_name": "祝融怀焰",
    "force": 75,
    "lvl": 10,
    "damage": 40,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「风火无边」，双掌一拍，一道内力自掌中攻向$n的$l",
    "skill_name": "风火无边",
    "force": 100,
    "lvl": 20,
    "damage": 10,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「六道轮回」，双手合十，当头劈向$n",
    "skill_name": "六道轮回",
    "force": 100,
    "lvl": 30,
    "damage": 20,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「双龙吐焰」，双掌一错，两道内力交叉攻向$n的$l",
    "skill_name": "双龙吐焰",
    "force": 88,
    "lvl": 40,
    "damage": 25,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「刀山火海」，双掌向下斜拍，顿时万千道内力从四面八方攻向$n",
    "skill_name": "刀山火海",
    "force": 95,
    "lvl": 60,
    "damage": 20,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「白佛光度」，左臂回收，右掌引内力直刺$n的$l",
    "skill_name": "白佛光度",
    "force": 100,
    "lvl": 80,
    "damage": 10,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「火内莲花」，双掌微并，两臂前伸，一道内劲如排山倒海般攻向$n",
    "skill_name": "火内莲花",
    "force": 80,
    "lvl": 100,
    "damage": 10,
    "damage_type": "瘀伤",
  ]),
});

mapping query_parry_action(object weapon) {
  return parry_act[random(sizeof(parry_act))];
}

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }


int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练火焰刀必须空手。\n");

  else if ((int)me->query("max_force") < 300)  //  火焰刀要有很高的内力才能学
    return notify_fail("你的内力不够。\n");

  /*
	if ((int)me->query_skill("longxiang", 1) >= 60 ||
	    (int)me->query_skill("xiaowuxiang", 1) >= 60)
		return 1;
	else if ((int)me->query_skill("longxiang", 1) < 60)
		return notify_fail("你的龙象般若功火候太浅。\n");
*/
  else if ((int)me->query_skill("xiaowuxiang", 1) < 60)
    return notify_fail("你的小无相功火候太浅。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("huoyan-dao", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  object weapon;

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练火焰刀必须空手。\n");
  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够，练不了火焰刀。\n");
  me->receive_damage("kee", 20);
  return 1;
}


string perform_action_file(string action) {
  return __DIR__ "huoyan-dao/" + action;
}
