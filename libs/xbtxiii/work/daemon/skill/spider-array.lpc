#pragma save_binary
// sword.c

#include <ansi.h>

inherit SKILL;

int valid_enable(string usage) { return usage == "array"; }

int form_array(object leader) {
  object *member;
  int i;

  member = leader->query_team();
  for (i = 0; i < sizeof(member); i++)
    printf("form_array:member id:%s\n", member[i]->query("id"));
  // if( sizeof(member)<4||sizeof(member)>8 )
  if (sizeof(member) != 2)
    return notify_fail("灵蛛剑阵共需两人，少一个多一个都不行。\n");
  message_vision(HIG "$N率领众人四下站定八个方位，组成了「灵蛛剑阵」！\n" NOR, leader);
  return 1;
}
