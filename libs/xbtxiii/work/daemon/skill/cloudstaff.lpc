#pragma save_binary
// cloudstaff.c

inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N使一招「天光乍现」，手中$w扫向$n下盘！",
    "damage": 20,
    "force": 45,
    "dodge": 15,
    "parry": -20,
    "damage_type": "挫伤"
  ]),
  ([ "action":
    "$N挥起$w，一招「雨後初晴」攻向$n$l！",
    "damage": 20,
    "force": 45,
    "dodge": 20,
    "parry": -25,
    "damage_type": "挫伤"
  ]),
  ([ "action":
    "$N横过手中$w，使出「浮云写意」击向$n$l！",
    "damage": 15,
    "force": 45,
    "dodge": 20,
    "parry": -20,
    "damage_type": "挫伤"
  ]),
  ([ "action":
    "$N使出一招「游龙穿云」，$w一挺撞向$n$l！",
    "damage": 30,
    "force": 30,
    "dodge": 10,
    "parry": -20,
    "damage_type": "挫伤"
  ]),
});
mapping *parry_act = ({
  ([ "action": "$n后退一步，一招［荡气回肠］手中的$v猛的砸向$N的$w。\n",
  ]),
  ([ "action": "$n身形微顿，手中的$v一招［围韩救赵］反捣$N的必救之处。\n",
  ]),
  ([ "action": "$n手中的$v从下往上急挥，一招［游龙穿云］磕开了$N手中的$w\n",
  ]),
});

mapping *unarmed_parry_act = ({
  ([ "action": "$n一招［钟鼓齐鸣］，手中的$v从偏锋击向$N的太阳大穴。\n",
  ]),
  ([ "action": "$n手中的$v从左划右，一招［横扫千军］封住了$N的攻势。\n",
  ]),
  ([ "action": "$n凌空三连翻，一招［披沙拣金］手中的$v反击$N的后脑，逼得$N中途撤招。\n",
  ]),
});
int query_rate(object me) { return 10; }
mapping query_parry_action(object weapon) {
  if (weapon)
    return parry_act[random(sizeof(parry_act))];
  else return unarmed_parry_act[random(sizeof(unarmed_parry_act))];
}

int valid_learn(object me) {
  if ((int)me->query("str") + (int)me->query("max_force") / 10 < 50)
    return notify_fail("你的膂力还不够，也许该练一练内力来增强力量。\n");

  return 1;
}

int valid_enable(string usage) {
  return (usage == "staff") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "staff")
    return notify_fail("你必须先找一根木杖或者是类似的武器，才能练杖法。\n");

  if ((int)me->query("kee") < 60)
    return notify_fail("你的体力不够练这门杖法，还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}
