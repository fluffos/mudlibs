int query_rate(object me) { return 20; }
mapping query_parry_action(object weapon) {
  return unarmed_parry_act[random(sizeof(unarmed_parry_act))];
}


int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练美女拳必须空手。\n");
  if ((int)me->query_skill("yunv-xinfa", 1) < 10)
    return notify_fail("你的玉女心法火候不够，无法学美女拳。\n");
  if ((int)me->query("max_force") < 30)
    return notify_fail("你的内力太弱，无法学习美女拳。\n");
  return 1;
}

