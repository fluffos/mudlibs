inherit SKILL;

mapping *action = ({
([      "action" : "$N使一招「浪起湖心」，双手掌沿向前，按向$n的$l",
        "force" : 150,
        "dodge" : 30,
        "skill_name" : "浪起湖心",
        "damage_type" : "瘀伤"
]),
([      "action" : "$N左手虚抱，右手使一招「瀑落清潭」，向$n的$l拍去",
        "force" : 250,
        "dodge" : 25,
        "skill_name" : "瀑落清潭",
        "damage_type" : "瘀伤"
]),
([      "action" : "$N右手立掌，使出一招「龟蛇竞渡」，掌背打向$n的$l",
        "force" : 300,
        "dodge" : 20,
        "skill_name" : "龟蛇竞渡",
        "damage_type" : "瘀伤"
]),
([      "action" : "$N左手虚划，右手一记「倒索攀山」击向$n的$l",
        "force" : 320,
        "dodge" : 15,
        "skill_name" : "倒索攀山",
        "damage_type" : "瘀伤"
]),
([      "action" : "$N施出「闪现雷鸣」，右手击向$n的$l，却是虚招，左手突然攻向$n的$l",
        "force" : 370,
        "dodge" : 10,
        "skill_name" : "闪现雷鸣",
        "damage_type" : "瘀伤"
]),([      "action" : "$N双掌飘忽，使出「地动山摇」，右手向$n的$l疾拍而去",
        "force" : 400,
        "dodge" : 10,
        "skill_name" : "地动山摇",
        "damage_type" : "瘀伤"
]),
([      "action" : "$N欺身上前，施出「水拍云崖」，右手击向$n的$l",
        "force" : 430,
        "dodge" : 5,
        "skill_name" : "水拍云崖",
        "damage_type" : "瘀伤"
]),
([      "action" : "$N身形突转，一招「泰山压顶」，左手横挡，右手全力向$n的头部拍去",
        "force" : 480,
        "dodge" : 5,
        "skill_name" : "泰山压顶",
        "damage_type" : "瘀伤"
]),
});

int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }

int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练金顶绵掌必须空手。\n");
    if ((int)me->query("force") < 100)
        return notify_fail("你的内力不够，无法学金顶绵掌。\n");
        if ((int)me->query("max_force") < 100)
        return notify_fail("你的内力太弱，无法练金顶绵掌。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if ((int)me->query("kee") < 25)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("force") < 20)
                return notify_fail("你的内力不够。\n");
        me->receive_damage("kee", 20);
        me->add("force", -10);
        return 1;
}

string perform_action_file(string action)
{
    return __DIR__"jinding-zhang/" + action;
}

