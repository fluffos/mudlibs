#pragma save_binary
// longzhua-shou.c 龙爪手

inherit SKILL;

mapping *parry_act = ({
  ([ "action": "$n侧身抬臂，右爪划了个半圈，一式「拿云式」拿住了$N的左手",
  ]),
  ([ "action": "$n俯身斜倚，左手半推，右手一式「捞月式」，捞住了$n的右手",
  ]),
  ([ "action": "$n双目微睁，一式「捕风式」，双手幻化出千百个爪影，捕住了$n的双掌",
  ]),
  ([ "action": "$n一式「捉影式」，左掌护住丹田，右手斜指苍天，蓄势捉向$n的手掌",
  ]),
  ([ "action": "$n左掌竖立胸前，一式「守缺式」，守住了全身的破绽。",
  ])
});
mapping *action = ({
  ([ "action": "$N侧身抬臂，右爪划了个半圈，一式「拿云式」击向$n的$l",
    "force": 85,
    "dodge": -5,
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N左掌虚托，一式「抢珠式」，右指穿腋疾出，指向$n的胸前",
    "force": 85,
    "dodge": -5,
    "skill_name": "抢珠式",
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N俯身斜倚，左手半推，右手一式「捞月式」，向$n的$l划过",
    "force": 95,
    "dodge": 5,
    "skill_name": "捞月式",
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N双目微睁，一式「捕风式」，双手幻化出千百个爪影，拂向$n的$l",
    "force": 90,
    "dodge": -5,
    "skill_name": "捕风式",
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N一式「捉影式」，左掌护住丹田，右手斜指苍天，蓄势抓向$n的$l",
    "force": 95,
    "dodge": 5,
    "skill_name": "捉影式",
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N双掌平托胸前，十指叉开，一式「抚琴式」，抓向$n的周身大穴",
    "force": 100,
    "dodge": -10,
    "skill_name": "抚琴式",
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N双掌翻飞，一式「鼓瑟式」，爪端迸出无数道劲气，射向$n的全身",
    "force": 110,
    "dodge": 25,
    "skill_name": "鼓瑟式",
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N一式「捣虚式」，五指如刃，一束束锐利无俦的刀气，凌虚向$n的$l砍去",
    "force": 102,
    "dodge": 20,
    "skill_name": "捣虚式",
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N一式「抱残式」，双爪交叉，爪端射出一缕罡气，穿过$n的$l",
    "force": 110,
    "dodge": -5,
    "skill_name": "抱残式",
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N左掌竖立胸前，一式「守缺式」，右手虚晃，左爪突然轻轻对着$n一抓",
    "force": 105,
    "dodge": -10,
    "skill_name": "守缺式",
    "damage_type": "抓伤"
  ])
});
int query_rate(object me) { return 20; }
mapping query_parry_action(object weapon) {
  return parry_act[random(sizeof(parry_act))];
}
int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_combine(string combo) { return combo == "sanhua-zhang"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练龙爪手必须空手。\n");
  if ((int)me->query_skill("hunyuan-yiqi", 1) < 20)
    return notify_fail("你的混元一气功火候不够，无法学龙爪手。\n");
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力太弱，无法练龙爪手。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够练龙爪手。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "longzhua-shou/" + action;
}
