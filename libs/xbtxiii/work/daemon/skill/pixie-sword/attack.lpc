// 克制perform
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  int skill, skill2;
  string msg;
  object weapon;
  skill = me->query_skill("sword");
  if (!skill || skill < 80)
    return notify_fail("你还没有领悟辟邪剑之终式--[幻字斩]\n");
  if (!me->query_skill_mapped("sword")
    || me->query_skill_mapped("sword") != "pixie-sword")
    return notify_fail("你还没有领悟辟邪剑之终式--[幻字斩]。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(CYN "辟邪剑之终式--[幻字斩]只能对战斗中的对手使用。\n" NOR);
  if (me->query_temp("pixie"))
    return notify_fail("你现在正在施展辟邪之终式--[幻字斩]!。。。\n");
  if (target->query_temp("cannot_perform"))
    return notify_fail("" + target->name() + "已经陷入陷阱之中了。\n");

  msg = HIW "$N眼神一定 一个急步使出 " HIM "辟邪之终式--[幻字斩]!...\n" NOR HIW "试图封锁$n的攻势。\n" NOR;
  message_vision(msg, me, target);
  weapon = target->query_temp("weapon");
  if (weapon) skill2 = target->query_skill(weapon->query("skill_type"));
  if (!weapon) skill2 = target->query_skill("unarmed");
  if (!skill2 || random(skill) > random(skill2 / 4)) {
    msg = YEL "结果$n仓促出手。立刻陷入$N的陷阱之中\n" NOR;
    message_vision(msg, me, target);
    target->set_temp("cannot_perform", 1);
    me->set_temp("pixie", 1);
    skill /= 16;
    if (skill < 10) skill = 10;  // 时间
    call_out("can_use_perform", 0, me, target, skill);
  } else {
    msg = YEL "结果$n冷笑一声。轻易看破了$N的伎俩。\n"
      "$N立刻陷入慌乱之中。\n" NOR;
    message_vision(msg, me, target);
  }
  me->start_busy(4);
  return 1;
}

int can_use_perform(object me, object target, int skill) {
  object *enemy;
  int time;
  if (me && !me->query_temp("Time")) {
    me->set_temp("Time", 1);
  }

  if (me) {
    me->add_temp("Time", 1);
    time = me->query_temp("Time");
  }
  if (time <= skill) {
    if (target) {
      if (me) {
        enemy = me->query_killer();
        if (!enemy) enemy = ({});
        if (!me->is_fighting()
          || environment(target) != environment(me)
          || member_array(target->query("id"), enemy) == -1) {
          me->delete_temp("pixie");
          target->delete_temp("cannot_perform");
          message_vision(HIB "$N身形变缓。停止了辟邪之终式--[幻字斩]!\n" NOR, me);
          me->delete_temp("Time");
          //		    tell_object(me,"1\n");
        } else {
          call_out("can_use_perform", 1, me, target, skill);
          //		    tell_object(me,"2\n");
          return 1;
        }

      } else {
        target->delete_temp("cannot_perform");
        tell_object(target, HIB "敌人停止了辟邪之终式--[幻字斩]!，你总算恢复正常了\n" NOR);
      }
      return 1;
    } else {
      if (me) {
        me->delete_temp("pixie");
        me->delete_temp("Time");
        tell_object(me, HIB "你身形缓慢。停止了辟邪之终式--[幻字斩]!，\n" NOR);
      } else return 1;
    }

  } else {
    if (target) {
      if (me) {
        me->delete_temp("pixie");
        me->delete_temp("Time");
        target->delete_temp("cannot_perform");
        message_vision(HIB "$N身形变缓。停止了辟邪之终式--[幻字斩]!\n" NOR, me);
      } else {
        target->delete_temp("cannot_perform");
        tell_object(target, HIB "敌人停止了辟邪之终式--[幻字斩]!，你总算恢复正常了\n" NOR);
      }
      return 1;
    } else {
      if (me) {
        me->delete_temp("pixie");
        me->delete_temp("Time");
        tell_object(me, HIB "你身形缓慢。停止了辟邪之终式--[幻字斩]!，\n" NOR);
      } else return 1;
    }
  }
  return 1;
}
