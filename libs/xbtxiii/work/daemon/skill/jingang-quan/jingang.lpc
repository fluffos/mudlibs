#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

void remove_effect(object me, int aamount, int damount);

int perform(object me, object target)
{
        string msg;
        int count, kee, max_kee, skill,dodge;

        if( (int)me->query_temp("jingang") ) 
                return notify_fail(HIG"你已经在运功中了。\n");
        if( (int)me->query_temp("powerup"))
                return notify_fail(HIG"你已经运起内功加力了，没有更多的内力使用大金刚神通。\n"NOR);

        if( !me->is_fighting() )
                return notify_fail("「大金刚神通」只能在战斗中使用。\n");

        if( (int)me->query("force") < 500 )
                return notify_fail("你的内力还不够！\n");

        if( (int)me->query_skill("hunyuan-yiqi", 1) < 60)
                return notify_fail("你的混元一气功的修为不够，不能使用大金刚神通! \n");

	if( (int)me->query_skill("unarmed") < 150 )
                return notify_fail("你的拳法还不到家，无法使用大金刚神通！\n");

        if( me->query_skill_mapped("unarmed") != "jingang-quan") 
                return notify_fail("你没有激发金刚拳，无法使用大金刚神通！\n");
        
        msg = HIY "$N使出大金刚拳的绝技「大金刚神通」，臂力陡然增加！\n" NOR;
        
        kee = me->query("kee");
        max_kee = me->query("max_kee");
        skill = (int) (me->query_skill("jingang-quan",1) / 3);
        count = me->query_str();
	dodge = me->query_skill("dodge");
        if(me->query_str()>180) return notify_fail("恭喜您，你的臂力已经到了人类所能达到的极限，无法再提升了.\n");
	//数值太大了，不能再增加str了，不然肯定溢出
        if(kee > (max_kee * 0.4))
        {       
                                
                //me->add_temp("str", count * 20); 
                //以澄枪(gun)为例,他的臂力是65,65*20=1300.这个数字在战斗文件里面计
                //算的时候肯定溢出.
                // me->add_temp("dex", 0-d_count);
                //es2没有dex这个东西，应该改成dodge.
		me->add_temp("apply/strength",180-count);
		me->add_temp("apply/dodge",-dodge/10);
                me->set_temp("jingang", 1);
                me->start_call_out( (: call_other, __FILE__, "remove_effect", me, 180-count, dodge/10 :), skill);

                me->add("force", -150);
        }
        else{
                msg = HIR "$N拼尽毕生功力使出了大金刚拳的终极绝技, 全身骨骼一阵爆响, 欲与敌人同归于尽!\n" NOR;
        
                me->add_temp("apply/strength", 180-count);
                me->add_temp("apply/unarmed",count);
                me->set_temp("jingang", 1);

//                me->start_call_out( (: call_other, __FILE__, "remove_effect", me, count*9, 0 :), 2);

		me->add_temp("apply/strength", -180+count);
                me->delete_temp("jingang");
		me->add_temp("apply/unarmed",-count);                
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
                me->set("force",0);
                me->add("max_force",-10);

                msg = HIR "$N用尽了最后一点气力, 喷出一口鲜血, 一头栽倒在地!\n" NOR;
                me->unconcious();
   		//既然已经让此人晕过去，那么等待他的必然是死亡，为什么不叫他出最后一招碰碰
   		//运气呢？所以我注释掉了上面的me->start_call_out(),;
        }


     message_vision(msg, me, target);
}

void remove_effect(object me, int aamount, int damount)
{
        
        if ( (int)me->query_temp("jingang") ) 
        {
                me->add_temp("apply/strength", -aamount);
                me->add_temp("apply/dodge",damount);
                me->delete_temp("jingang");
                tell_object(me, HIY "你的大金刚神通运行完毕，将内力收回丹田。\n" NOR);
                me->start_busy(random(4)+1);
        }
}

