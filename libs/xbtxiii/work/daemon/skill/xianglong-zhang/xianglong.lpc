#include <ansi.h>
inherit SSERVER;
 
int perform(object me, object target)
{
        int level,temp;
	string msg;
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("降龙大法只能对战斗中的对手使用。\n");
        if(me->query_temp("xianglong"))
                return notify_fail("你已经施展了降龙大法。。。\n");

        level=me->query_skill("xianglong-zhang",1);

		if(level<=80) return notify_fail("你的降龙十八掌级别太低，无法领悟降龙大法！\n");
		if(level>=200)	temp=5;
		else if(level>=160) temp=4;
		else if(level>=120) temp=3;
		else if(level>=100) temp=2;
		else            temp=1;
if (me->query_skill_mapped("force")!=("huntian-qigong")) temp=1;
        me->set_temp("can_attack",temp);
        me->set_temp("attacks",1);
        me->set_temp("xianglong",1);
		msg = HIW  "$N神情庄重，凝神聚气。使出降龙十八掌惊天动地的降龙大法。。\n" NOR;
		message_vision(msg, me, target);
        this_object()->agress(me,target);
	return 1;
}

int agress(object me,object target)
{
        int j,attacked_times,attack_times;
        string msg;
        if(!objectp(me)) return 1;
        attack_times=me->query_temp("can_attack");
        attacked_times=me->query_temp("attacks");
              if(!target
                 ||environment(target)!=environment(me)
                 ||target->query("kee")<=0
                 ||me->query("kee")<=0
                 ||me->query("sen")<=0
                 ||me->query("gin")<=0
                 ||!me->is_fighting())
                    {
                    me->delete_temp("attacks");
                    me->delete_temp("can_attack");
                    me->delete_temp("xianglong");            
                    me->start_busy(-200);
                    return 1;
                    } 
if(!me->query_temp("weapon")&&!me->query_temp("secondary_weapon"))
    {
    if (attacked_times<=attack_times)
        {
        switch(attacked_times)
              {
              case 1:
                   msg = HIW  "第一招------天龙降世\n" NOR;
                   break;
              case 2:
                   msg = HIW  "第二招------龙行九州\n" NOR;
                   break;
              case 3:
                   msg = HIW  "第三招------龙腾四海\n" NOR;
                   break;
              case 4:
                   msg = HIW  "第四招------龙游天际\n" NOR;
                   break;
              case 5:
                   msg = HIW  "$N意气英发，使出天地动容的最后一招------降龙八击\n" NOR;
                   break;

              }
        message_vision(msg,me,target);
        for(j=1;j<=attacked_times;++j)
              {
              message_vision(HIR"\t\t第～　　"+j+"　　～　　掌。。。\n"NOR,me,target);
              COMBAT_D->do_attack(me,target, 0);            
              if(!target
                 ||environment(target)!=environment(me)
                 ||target->query("kee")<=0
                 ||me->query("kee")<=0
                 ||me->query("sen")<=0
                 ||me->query("gin")<=0)
                    {
                    me->delete_temp("attacks");
                    me->delete_temp("can_attack");
                    me->delete_temp("xianglong");            
                    me->start_busy(-200);
                    return 1;
                    }
              }
        me->start_busy(attacked_times);
        call_out("agress",attacked_times,me,target);
        me->add_temp("attacks",1);
        return 1;
        }
    else
        {
        me->delete_temp("attacks");
        me->delete_temp("can_attack");
        me->delete_temp("xianglong");
        me->start_busy(-200);
        return 1;
        }
    }
else 
        { 
        me->delete_temp("attacks");
        me->delete_temp("can_attack");
        me->delete_temp("xianglong");
        me->start_busy(-200);
        return 1;
        }
}
