// parry.c
#pragma save_binary


inherit SKILL;

mapping *parry_action = ({
([     	"action":"只听见「锵」一声，被$p格开了。\n",  ]),
([	"action":"结果「当」地一声被$p挡开了。\n",    ]),
([	"action":"但是被$n用手中兵刃架开。\n",        ]),
([	"action":"但是$n身子一侧，用手中兵刃格开。\n",]),
});

mapping *unarmed_parry_action = ({
([	"action":"但是被$p格开了。\n",	]),
([	"action":"结果被$p挡开了。\n",	]),
});

mapping query_parry_action(object weapon)
{
	if( weapon )
		return parry_action[random(sizeof(parry_action))];
	else
		return unarmed_parry_action[random(sizeof(unarmed_parry_action))];
}
