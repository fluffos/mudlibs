#pragma save_binary
// essencemagic.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "magic"; }

int valid_learn(object me) {

  if ((int)me->query_skill("mizong-xinfa") < 10
    || (int)me->query_skill("mizong-xinfa") <= (int)me->query_skill("essencemagic"))
    return notify_fail("你的密宗心法还不够高深，无法学习八识神通。\n");
  return 1;
}

string conjure_magic_file(string spell) {
  return CLASS_D("bonze") + "/essencemagic/" + spell;
}
int query_rate(object me) { return 20; }
void skill_improved(object me) {
  int s;
  if ((int)me->query_skill("mizong-xinfa") < 10
    || (int)me->query_skill("mizong-xinfa", 1) <= (int)me->query_skill("essencemagic", 1)) {
    s = (int)me->query_skill("essencemagic", 1);
    me->set_skill("essencemagic", s - 1);
    tell_object(me, "你的密宗心法还不够高深，八识神通无法再进步了。\n");
  }
}
