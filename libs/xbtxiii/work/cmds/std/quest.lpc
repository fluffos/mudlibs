#pragma save_binary


#include <ansi.h>
inherit F_CLEAN_UP;
string time_period(int timep) {
  int t, d, h, m, s;
  string time;
  t = timep;
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d) time = chinese_number(d) + "天";
  else time = "";

  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";

  return time;
}
int main() {
  string quest_type;
  string quest;
  object me;
  me = this_player();
  //   if(me->query("combat_exp") <=600000) 
  //       return notify_fail("你的经验不足，不能领取任何任务!\n");
  if (!me->query("quest")) return notify_fail("你没有领取任何任务!\n");
  quest = me->query("quest")["name"];
  if (me->query("task_time") < time()) return notify_fail("你没有时间完成任务了!\n");
  quest_type = me->query("quest")["type"];
  printf(
    "你的任务是在%s内%s %s\n",
    time_period((int)me->query("task_time") - (int)time()),
    quest_type,
    quest
  );
  return 1;
}
int help(object me) {
  write(@HELP
指令格式: questlist

这个指令使你清楚你现在的任务和剩余的时间。

HELP
  );
  return 1;
}
