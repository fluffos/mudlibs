// shout.c
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  int cost;
  //	if( !wizardp(me) )
  //		  return notify_fail("目前暂不开放玩家 shout。\n");
  if (!stringp(arg) || arg == "" || arg == " ") arg = "...";
  if (me->query("max_sen") <= 300)
    return notify_fail("你神这么差，喊不起来。\n");
  //	if(me->query("sen")<=50)
  //	  return notify_fail("你已经没力气再喊了。\n");
  if (me->query("block_shout"))
    return notify_fail("shout频道被关闭了！\n");
  if (me->query("sen") <= me->query("max_sen") * 3 / 4)
    return notify_fail("你已经没力气再喊了。\n");
  if (!arg) return notify_fail("你想要大叫什么？\n");
  shout(HIW "" + me->name() + "纵声长啸：" + arg + "\n" NOR);
  cost = me->query("sen") / 10;
  me->receive_damage("sen", cost);
  me->start_busy(5);
  write(HIW "你纵声长啸：" + arg + "\n" NOR);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : shout <讯息>
 
这个指令让你将 <讯息> 传送出去, 所有正在游戏中的人都
会听见你的话.
 
see also : tune
HELP
  );
  return 1;
}
