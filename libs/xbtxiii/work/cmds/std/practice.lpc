#pragma save_binary
// practice.c
// modify by junhot@xbtxIII 2000.10.07
// 如果师傅在旁边，没叛过师的玩家效果加倍，叛过师的玩家加难度系数(n+2)/2。
// 限制武功的熟练级数为(exp/100w)(exp/100w)+int*3+江湖阅历*2,超过熟练级数难度加大5倍。

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string skillname;
	int skill, skill_basic,explore,n;

	seteuid(getuid());

	explore = (100*me->query_explore_points()/EXPLORE_D->query_total_explore());
	if( me->is_fighting() )
		return notify_fail("你已经在战斗中了，学一点实战经验吧。\n");

	if( !arg ) return (__DIR__"enable")->main(me, arg);

        if( me->is_busy() )
                return notify_fail("你正忙着呢！\n");

	if( !stringp(skillname = me->query_skill_mapped(arg)) )
		return notify_fail("你只能练习用 enable 指定的特殊技能。\n");

	skill_basic = me->query_skill(arg, 1);
	skill = me->query_skill(skillname, 1);
	
	n = me->query("betrayer");
	
	if( skill < 1 )
		return notify_fail("你好像还没「学会」这项技能吧？最好先去请教别人。\n");
	if( skill_basic < 1 )
		return notify_fail("你对这方面的技能还是一窍不通，最好从先从基本学起。\n");

	if( !SKILL_D(skillname)->valid_learn(me) ) 
		return 	notify_fail("你试著练习" + to_chinese(skillname) + "，但是并没有任何进步。\n");
	if( SKILL_D(skillname)->practice_skill(me) ) {
		if ( objectp(present(""+me->query("family/master_id")+"", environment(me))) )
		{
			if ( random(n) )
			{
				if( random(n)-random(1) ) write( HIG + me->query("family/master_name")+"心不在焉教导了你几招。\n" + NOR);
				if (me->query_skill(skill,1)>=
				    ((me->query("combat_exp")/1000000)*(me->query("combat_exp")/1000000)+me->query_int()*3+explore*2))
					me->improve_skill(skillname, (skill_basic/2+1)*2/(5*(n+2)), skill_basic > skill*2? 0: 1);
				else
					me->improve_skill(skillname, (skill_basic +2)/(n+2), skill_basic > skill*2? 0: 1);
					write( HIY "你的" + to_chinese(skillname) + "进步了！\n" NOR);
				return 1;
			}
			else{
			if(random(3)==1) write( HIG + me->query("family/master_name")+"面带微笑，纠正了你动作中的错误。\n" + NOR);
			if (me->query_skill(skill,1)>=
			    ((me->query("combat_exp")/1000000)*(me->query("combat_exp")/1000000)+me->query_int()*3+explore*2))
				me->improve_skill(skillname, (skill_basic+2)/5, skill_basic > skill*2? 0: 1);
			else
				me->improve_skill(skillname, skill_basic +2, skill_basic > skill*2? 0: 1);
				write( HIY "你的" + to_chinese(skillname) + "进步了！\n" NOR);
			return 1;
			}
		}
		else
		{
			if (me->query_skill(skill,1)>=
			    ((me->query("combat_exp")/1000000)*(me->query("combat_exp")/1000000)+me->query_int()*3+explore*2))
				me->improve_skill(skillname, (skill_basic/2+1)/5, skill_basic > skill*2? 0: 1);
			else	
				me->improve_skill(skillname, skill_basic/2 +1, skill_basic > skill*2? 0: 1);
				write( HIY "你的" + to_chinese(skillname) + "进步了！\n" NOR);
			return 1;
		}
	}
	else return 0;
}

int help(object me)
{
	write(@TEXT
指令格式：practice <技能种类>

这个指令让你练习某个种类的技能，这个技能必须是经过 enable 的专业技能。

如果你对这方面的基本技足够高，可以经由练习直接升级，而且升级的上限跟你
基本技能的等级有关，换句话说，勤加练习是使你的所学「青出於蓝胜於蓝」的
一条途径，当然，在这之前你必须从实际运用中获得足够的经验以提升你的基本
技能。一般而言，
相关指令 learn    research    exert    study
TEXT
	);
	return 1;
}
