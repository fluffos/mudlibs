#pragma save_binary


#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  mapping exit;
  object env;
  env = environment(me);
  if (!env) return notify_fail("你在哪里？\n");
  if (arg == "none") {
    me->delete_temp("guard_room");
    message_vision("$N将身形一移，不再挡住了别人的去路。\n", me);
    return 1;
  }
  if (me->query("combat_exp") < 10000)
    return notify_fail("就凭你也想挡住别人的路？\n");
  if ((env->query("no_fight") || env->query("no_magic")) && !wizardp(me))
    return notify_fail("不能在这里挡人的路。\n");
  if (!mapp(exit = env->query("exits")) || undefinedp(exit[arg]))
    return notify_fail("这个方向没有出路。\n");

  me->set_temp("guard_dir", arg);
  me->set_temp("guard_room", environment(me));
  message_vision("$N将身形一移，挡住了去" + arg + "的去路。\n", me);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : guard <方向>
 
守住指定方位，不让其他人往指定的方向移动。

相关指令: protect kill 
HELP
  );
  return 1;
}
