#include <ansi.h>
#include <skill.h>
#include <dbase.h>
#include <origin.h>

inherit F_CLEAN_UP;
int main(object me, string arg)
{
        object obj, old_target;
        object *member,*member1;
	int i,j;
        if( !wizardp(me) && environment(me)->query("no_fight") )
                return notify_fail("这里禁止战斗。\n");

/*      if (!environment(me)->query("biwu_per"))
                return notify_fail("想比武得去校武场啊。\n");
*/
        if(!arg || !objectp(obj = present(arg, environment(me))))
                return notify_fail("你想攻击谁？\n");

        if( !obj->is_character() )
                return notify_fail("看清楚一点，那并不是生物。\n");

        if( !living(obj) )
                return notify_fail(obj->name() + "已经无法战斗了。\n");

        if(obj==me)     return notify_fail("疯了？自己怎么和自己比武？\n");

        if (!userp(obj))
                return notify_fail ("不要和NPC比武哦。\n");

        if( (object)obj->query_temp("pending/biwu")!=me ) {
                if(pointerp(member=me->query_team())){
			if(me->is_team_leader()){
				if(pointerp(member1=obj->query_team())){
					if(obj->is_team_leader()){
					message_vision("\n$N对$n说道:"
					+RANK_D->query_self(me)
					+me->name()+"带这本阵弟兄,想领教贵阵的高招！\n\n",me,obj);
	        		        if( objectp(old_target = me->query_temp("pending/biwu"))&&old_target!=obj )
        	                		tell_object(old_target, YEL + me->name() + "取消了和你比试的念头。\n" NOR);
			                me->set_temp("pending/biwu", obj);
			
        	        		tell_object(obj, YEL "如果你愿意和对方进行比试，请你也对" + me->name() + "("+(string)me->query("id")+")"+ "下一次 biwu 指令。\n" NOR);
			                write(YEL "由於对方是由玩家控制的人物，你必须等对方同意才能进行。\n"NOR);
        			        return 1;
					}
					else
					return notify_fail(obj->query("name")+"目前真和人结阵，你不能和"+obj->query("name")+"比武.\n"+
						"\n如果你象和其阵比武请向"+member[0]->query("name")+"下比武指令.\n");
				}	
				else{
					message_vision("\n$N对著$n说道："
                        		+ RANK_D->query_self(me)
		                        + me->name() + "，带着本阵弟兄领教"
                		        + RANK_D->query_respect(obj) + "的高招！\n\n", me, obj);
			                if( objectp(old_target = me->query_temp("pending/biwu"))&&old_target!=obj )
        	                		tell_object(old_target, YEL + me->name() + "取消了和你比试的念头。\n" NOR);
	        		        me->set_temp("pending/biwu", obj);
			                tell_object(obj, YEL "如果你愿意和对方进行比试，请你也对" + me->name() + "("+(string)me->query("id")+")"+ "下一次 biwu 指令。\n" NOR);
			                write(YEL "由於对方是由玩家控制的人物，你必须等对方同意才能进行。\n"NOR);
			                return 1;

				}				
			}
			else
			return notify_fail("你目前处在队伍中，不能与人比武!\n");
		}
		if(pointerp(member1=obj->query_team())){
			if(obj->is_team_leader()){
				message_vision("\n$N对$n说道:"
				+RANK_D->query_self(me)
				+me->name()+",想领教贵阵的高招！\n\n",me,obj);
       		        	if( objectp(old_target = me->query_temp("pending/biwu"))&&old_target!=obj )
	              			tell_object(old_target, YEL + me->name() + "取消了和你比试的念头。\n" NOR);
			        me->set_temp("pending/biwu", obj);
		       		tell_object(obj, YEL "如果你愿意和对方进行比试，请你也对" + me->name() + "("+(string)me->query("id")+")"+ "下一次 biwu 指令。\n" NOR);
	        	        write(YEL "由於对方是由玩家控制的人物，你必须等对方同意才能进行。\n"NOR);
		        	return 1;
			}
			else
			return notify_fail(obj->query("name")+"目前真和人结阵，你不能和"+obj->query("name")+"比武.\n"+
				"\n如果你象和其阵比武请向"+member1[0]->query("name")+"下比武指令.\n");
		}
		/*else{
			message_vision("\n$N对著$n说道："
                	+ RANK_D->query_self(me)
	                + me->name() + "，想领教"
               	        + RANK_D->query_respect(obj) + "的高招！\n\n", me, obj);
	                if( objectp(old_target = me->query_temp("pending/biwu"))&&old_target!=obj )
                		tell_object(old_target, YEL + me->name() + "取消了和你比试的念头。\n" NOR);
       		        me->set_temp("pending/biwu", obj);
		        tell_object(obj, YEL "如果你愿意和对方进行比试，请你也对" + me->name() + "("+(string)me->query("id")+")"+ "下一次 biwu 指令。\n" NOR);
	                write(YEL "由於对方是由玩家控制的人物，你必须等对方同意才能进行。\n"NOR);
	                return 1;
		}*/
		message_vision("\n$N对著$n说道："
                        + RANK_D->query_self(me)
                        + me->name() + "，领教"
                        + RANK_D->query_respect(obj) + "的高招！\n\n", me, obj);
                if( objectp(old_target = me->query_temp("pending/biwu"))&&old_target!=obj )
                        tell_object(old_target, YEL + me->name() + "取消了和你比试的念头。\n" NOR);
                me->set_temp("pending/biwu", obj);
                tell_object(obj, YEL "如果你愿意和对方进行比试，请你也对" + me->name() + "("+(string)me->query("id")+")"+ "下一次 biwu 指令。\n" NOR);
                write(YEL "由於对方是由玩家控制的人物，你必须等对方同意才能进行。\n"NOR);
                return 1;
        }
        if( obj->query("can_speak") ) {
		if(pointerp(member=me->query_team())){
			if(pointerp(member1=obj->query_team())){
				message_vision("\n$N对着$n说道:"
				+RANK_D->query_self(me)
				+me->name()+"带领本阵领教"
				+"贵阵的高招！\n\n",me,obj);
				for(i=0;i<sizeof(member);i++){
					for(j=0;j<sizeof(member1);j++){
						member[i]->biwu_ob(member1[j]);
						member1[j]->biwu_ob(member[i]);
					}
				}
			}
			message_vision("\n$N对着$n说道:"
			+RANK_D->query_self(me)
			+me->name()+",带领本阵领教"
			+RANK_D->query_respect(obj)+"的高招！\n\n",me,obj);
			for(i=0;i<sizeof(member);i++){
			    member[i]->biwu_ob(obj);
			    obj->biwu_ob(member[i]);
			}
		return 1;
		}
		if(pointerp(member1=obj->query_team())){
                message_vision("\n$N对著$n说道："
                        + RANK_D->query_self(me)
                        + me->name() + "，领教贵阵的高招！\n\n", me, obj);

                if( !userp(obj) && !obj->accept_biwu(me) ) return 0;
		for(j=0;j<sizeof(member1);j++){
                me->biwu_ob(member1[j]);
		member[j]->biwu_ob(me);
		}
		}		
                message_vision("\n$N对著$n说道："
                        + RANK_D->query_self(me)
                        + me->name() + "，领教"
                        + RANK_D->query_respect(obj) + "的高招！\n\n", me, obj);

                notify_fail("看起来" + obj->name() + "并不想跟你较量。\n");
                if( !userp(obj) && !obj->accept_biwu(me) ) return 0;
                me->biwu_ob(obj);
		obj->biwu_ob(me);

	}
	return 1 ;
}


