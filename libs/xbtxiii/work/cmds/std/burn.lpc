#pragma save_binary
 
 
// burn.c

#include <skill.h>
#include <ansi.h>

inherit F_CLEAN_UP;

int do_saveme(object me);

int main(object me, string arg)
{
	string spells, ob_name;
	object ob,sheet;

	// We might need to load new objects.
	seteuid(getuid());

	if( (int)me->query("sen") <=100 )
		return notify_fail("你的精神太差了，无法施符。\n");

	if( !arg
	||	sscanf(arg, "%s",ob_name)!= 1 )
		return notify_fail("指令格式：burn <物品>\n");
	if(!me->query_skill_mapped("force")||me->query_skill_mapped("force")!="gouyee")
       	return notify_fail("天兵召唤需要谷衣心法的配合方可使用。\n");
	if( !me->is_fighting() )
                return notify_fail("只有战斗中才能召唤天将护法！\n");	
	if( me->is_busy() )
                return notify_fail("你正忙！\n");	
	if( !objectp(ob = present(ob_name, me)) )
		return notify_fail("你身上没有这样东西。\n");
	if( stringp(spells = me->query_skill_mapped("spells")) ) {
		notify_fail("你所学的法术没有这种符。\n");
		sheet=present("save-me sheet",me);
        if(!objectp(sheet)) return notify_fail("你没有天师符了。\n");
	if(sheet->query_amount()>1) { sheet->add_amount(-1); }
	else destruct(sheet);
		if( (int)random(75) < me->query_skill("scratching"))
		{
			if( do_saveme(me) ) {
				me->receive_wound("kee", 1);
				me->receive_damage("sen", 100);
				return 1;
			}
		}
		else 	return notify_fail("你失败了\n");
	} else 
		return notify_fail("你请先用 enable 指令选择你要使用的咒文系。\n");

	return 1;
}

int do_saveme(object me)
{
	object soldier,env;
	
	env=environment(this_player());
	message("vission", HIY + this_player()->name() + 
"手中长剑将天师符穿过，向空中一指，口中喝到“急急如律令”，只见一道火光闪过\n"
	NOR, env);

	soldier = new("/obj/npc/heaven_soldier");
	soldier->move(environment(me));
	soldier->invocation(me);
	me->start_busy(1);
}
 
int help (object me)
{
        write(@HELP
指令格式： burn <物品名称>

在画符用的桃符纸(paper seal)或其他物品上画符，即使是相同的符咒，画在不
同的物品上也有可能有不同的效果。

在你画符之前，你必须先用 enable 指令来指定你要使用的咒文系。

By Liu Fei, 05/01/1996
 
HELP
        );
        return 1;
}
