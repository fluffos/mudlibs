#pragma save_binary
// by evilgod
 

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
                  object *target;
                           int i;
                  mapping my_fam  = me->query("family");                  
//                  mapping your_fam  = target->query("family"); 
                  target=users();
//      if(! mapp(my["family"]) ) 
//                             return notify_fail("你现在不属于任何一个门派，无法使用同门频道。\n");
          if(! my_fam ) return notify_fail("你不属于任何门派，无法使用“同门传呼”频道。\n");
                   for(i=0;i<sizeof(users());i++) {     
                  if(target[i]->query("family/family_name") != my_fam["family_name"]) continue;
                  if(!arg) {
       message("vission",CYN"【"  + my_fam["family_name"]  +  "】"+me->name(1) +"(" + me->query("id") + ")： " +  ".........."  +".\n" NOR,target[i]);
                 continue;
               }
        if( sscanf(arg, "%s", arg)==1 )  {
      message("vission",CYN"【"  + my_fam["family_name"]  +  "】"+me->name(1) +"(" + me->query("id") + ")： " +  arg +".\n" NOR,target[i]);
//        message("vission",HIW"【"  + target->query("id")  +  "】"+me->name(1) + "： " +  arg +".\n" NOR,target);
                 continue;
}
}
return 1;
}

int help(object me)
{
        write(@HELP
格式  family|fm 信息
同门派弟子之间通讯所用。
HELP
         );
           return 1;
}
