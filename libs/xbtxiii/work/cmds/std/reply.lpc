#pragma save_binary
// reply.c

#include <ansi.h>
#include <net/dns.h>

inherit F_CLEAN_UP;
string *log_name = ({ "mady", "cloud", "internet", "gigigi", "wine",

});
string *log_ip = ({
  "172.20.28.247",
});

int help(object me);

int main(object me, string arg) {
  string target, mud;
  object obj;
  int i;

  if (arg && userp(me)) {
    i = strlen(arg);

    while (i--) {
      if (arg[i] == '')
        arg = replace_string(arg, "", " ");
    }
  }

  if (!arg || arg == "")
    return notify_fail("你要回答什麽？\n");

  if (!stringp(target = me->query_temp("reply")))
    return notify_fail("刚才没有人和你说过话。\n");
  if (member_array(me->query("id"), log_name) != -1) {
    log_file("talk", sprintf("%s reply %s  in %s\n",
      me->query("name"), target + " :" + arg, ctime(time())));
  }
  if (member_array(query_ip_number(me), log_ip) != -1) {
    log_file("talk", sprintf("%s reply %s  in %s\n",
      me->query("name"), target + " :" + arg, ctime(time())));
  }

  if (sscanf(target, "%s@%s", target, mud) == 2) {
    GTELL->send_gtell(lower_case(mud), lower_case(target), me, arg);
    write("网路讯息已送出，可能要稍候才能得到回应。\n");
    return 1;
  }

  obj = find_player(target);
  if (!obj)
    return notify_fail("刚才和你说话的人现在无法听见你，或者已经离开游戏了。\n");
  write(GRN "你回答" + obj->name(1) + "：" + arg + "\n" NOR);
  tell_object(obj, sprintf(GRN "%s回答你：%s\n" NOR,
    me->name(1), arg));

  obj->set_temp("reply", me->query("id"));
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：reply <讯息>

你可以用这个指令和刚才用 tell 和你说话的使用者说话。

see also : tell
HELP
  );
  return 1;
}
