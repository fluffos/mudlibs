#include "/doc/help.h"
#include <ansi.h>

inherit F_CLEAN_UP;
int help(object me);
int CheckChineseChar ( int i ,string msg,int pos);

int main(object me, string arg)
{
        mapping emote;
        string *e, *loop;
        string result="", msg;
        int i,count=0;
        int pos;
        int IsChineseChar = 0;

        loop = ({ "others_target", "others_self", "others" });
        if( !arg )
                return help(me);
        if( strlen(arg) == 2 )
                if(arg[0] > 0x07f )
                        IsChineseChar = 1;

        e = sort_array( EMOTE_D->query_all_emote(), 1);

        for(i=0; i<sizeof(e); i++) {
                emote = EMOTE_D->query_emote(e[i]);
                for( int j=0; j<sizeof(loop); j++ ) {
                        msg = emote[ loop[j] ];
                        if( msg && (pos = strsrch(msg, arg)) >=0 ) {
                                if ( CheckChineseChar(IsChineseChar,msg,pos) )  
                                {
                                        result += sprintf("emote 名: %s\n动作: %s\n", e[i], msg);
                                        count ++;
                                }
                        }
                }
        }

        if(  result == "" )
                return notify_fail(MUD_NAME" 中无符合查询条件的 emote.\n");
        else
                result = "\n查询结果"
                                "\n------------------------------------------------------------\n"
                                + result;
        result = replace_string(result, "$n", "(对方)");
        result = replace_string(result, "$N", me->name(1));
        result = replace_string(result, "$P", "你");
        result = replace_string(result, "$p", "(他/她)");
        result = replace_string(result, "$S", RANK_D->query_self(me));
        result = replace_string(result, "$s", RANK_D->query_self_rude(me));
        result = replace_string(result, "$R", "(对方的尊称)");
        result = replace_string(result, "$r", "(对方的辱称)");
        result = replace_string(result, "$C", "(自己的呢称)");
        result = replace_string(result, "$c", "(对方的呢称)");

        result += "------------------------------------------------------------\n";
        result += sprintf("在%s中，包含“%s”的 emote 共有 %d 个。\n",
                                        MUD_NAME, arg, count );
        me->start_more(result);
        return 1;
}


int CheckChineseChar ( int i ,string msg,int pos)
{
        int j,k=0;


        if ( i !=1 ) return 1;
        
        for ( j = 0 ; j < pos ; j ++ )
                if ( msg[j] > 0x07f ) 
                        k ++ ;
//      write(sprintf("%d-%d  ",k,pos));
        if ( k - k/2*2 == 0 ) return 1;
        return 0;
}
                
        
        

int help(object me)
{
  write(@HELP
指令格式 : femote 关键字
功能：列出目前所有含指定关键字的 emote.
例如 femote 得意的
查询结果
------------------------------------------------------------
emote 名: ya
动作: 蓉蓉对(对方)得意的作出胜利的手势! 「 V 」
emote 名: ya
动作: 蓉蓉似乎很得意的沾沾自喜!
emote 名: ya
动作: 蓉蓉得意的作出胜利的手势! 「 V 」  说: 「 哈哈哈...」
------------------------------------------------------------
在雄霸天下II中，包含“得意的”的 emote 共有 3 个。

Dean, ken@XAJH fuyo@XAJH
HELP
    );
    return 1;
}
