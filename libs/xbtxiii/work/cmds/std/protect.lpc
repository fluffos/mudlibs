#pragma save_binary
 
 
// protect.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
object ob1;
object *guards;

    if( !arg ) return notify_fail("指令格式: protect <某人>|none。\n");

	if( arg=="none")
        if( objectp(me->query_temp("protecting")) ) {
            ob=me->query_temp("protecting");
        if( arrayp(guards = ob->query_temp("protected")) ) {
                guards -= ({ me });
                ob->set_temp("protected", guards);
            me->delete_temp("protecting");
			write("Ok.\n");
			return 1;
		} else {
  write("你现在并没有保护任何人。\n");
            me->delete_temp("protecting");
			return 1;
          } 
        } else {
  write("你现在并没有保护任何人。\n");
            return 1;
        }

	if( !objectp(ob = present(arg, environment(me))) )
		return notify_fail("这里没有 " + arg + "。\n");


	if( ob==me )
       return notify_fail("保护自己？\n");

    if( objectp(me->query_temp("protecting")) ) {
            ob1=me->query_temp("protecting");
        if( arrayp(guards = ob1->query_temp("protected")) ) {
                guards -= ({ me });
                ob1->set_temp("protected", guards);
            me->delete_temp("protecting");
          }
      }
    me->set_temp("protecting",ob);
      if( !arrayp(guards = ob->query_temp("protected")) ) guards=({});
                guards += ({ me });
                ob->set_temp("protected", guards);
    if(ob->is_character()&&!ob->is_corpse())
        message_vision("$N决定开始保护$n。\n", me, ob);
    else message_vision("$N决定开始守护$n。\n", me, ob);

	return 1;
}

int help (object me)
{
        write(@HELP
指令格式 : protect <
 
这个指令让你能保护某人或生物。
如果输入 protect none 则停止保护。
 
HELP
);
        return 1;
}
