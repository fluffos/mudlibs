#pragma save_binary


// promote.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object obj;
  string item, target;
  mixed foo;
  if (me != this_player(1)) return 0;
  if (!arg) return notify_fail("你要用什么？\n");
  if (sscanf(arg, "%s to %s", item, target) == 2) {
    if (!objectp(obj = present(item, me)))
      return notify_fail("你身上没有这样东西。\n");
    if (stringp(foo = obj->new_use(me, target))) return notify_fail(foo);
    if (intp(foo) && foo == 0) return notify_fail("这样东西没有这种用途！\n");
    if (!(obj->query("use_many_time"))) destruct(obj);
    return 1;
  }
  if (!objectp(obj = present(arg, me)))
    return notify_fail("你身上没有这样东西。\n");
  if (stringp(foo = obj->new_use(me))) return notify_fail(foo);
  if (intp(foo) && foo == 0) return notify_fail("这样东西没有这种用途！\n");
  if (!(obj->query("use_many_time"))) destruct(obj);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : use <某物品> [to <某人|某物|某种作用>]

HELP
  );
  return 1;
}
