#pragma save_binary


#include <ansi.h>
inherit F_CLEAN_UP;
void create() { seteuid(getuid()); }
int main(object me, string str) {
  string output, *task_name;
  int i;
  object ob;
  mapping task;
  me->add("sen", -1);
  task = TASK_D->query_task();
  task_name = keys(task);
  output = HIR "◎  使命榜\n" NOR;
  output += "———————————————————————————\n";
  for (i = 0; i < sizeof(task); i++) {
    ob = task[task_name[i]]["obj"];
    output += (string)task_name[i]->query("owner") + "的" + task_name[i]->query("name");
    output += "(" + task_name[i]->query("id") + ")" + " " + (objectp(ob) ? "\n" : "(已完成)\n");
  }
  output += "———————————————————————————\n\n";

  me->start_more(output);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: tasks

这个指令是用来得知目前的所有使命.
相关指令 help locate

HELP
  );
  return 1;
}
