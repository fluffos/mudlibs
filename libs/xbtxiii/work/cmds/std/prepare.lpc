#pragma save_binary


// prepare.c

inherit F_CLEAN_UP;

mapping valid_types = ([
  "finger": "指法",
  "hand": "手法",
  "unarmed": "拳法",
  "claw": "爪法",
  "strike": "掌法",
]);

int main(object me, string arg) {
  mapping smap, pmap;
  string *skill, basic1, basic2, arg1, arg2, arg3;
  int i, count;

  seteuid(getuid());

  smap = me->query_skill_map();

  if (!mapp(smap) || sizeof(smap) == 0)
    return notify_fail("你现在没有使用任何有效特殊技能。\n");

  pmap = me->query_skill_prepare();
  if (!pmap) pmap = ([]);

  if (!arg) {
    if (!mapp(pmap) || sizeof(pmap) == 0)
      return notify_fail("你现在没有指定空手攻击技能。\n");

    skill = keys(valid_types);
    write("以下是你目前指定空手攻击技能。\n");
    for (i = 0; i < sizeof(skill); i++) {
      if (!me->query_skill(skill[i])
        || !pmap[skill[i]]) continue;
      write(valid_types[skill[i]] + " (" + skill[i] + ")"
        + "   " + to_chinese(pmap[skill[i]]) + "\n");
    }
    return 1;
  }

  if (arg == "?") {
    write("以下是可以指定空手攻击技能的种类：\n");
    skill = sort_array(keys(valid_types), (: strcmp :));
    for (i = 0; i < sizeof(skill); i++) {
      printf("  %s (%s)\n", valid_types[skill[i]], skill[i]);
    }
    return 1;
  }

  if (arg == "none") {
    if (!mapp(pmap) || sizeof(pmap) == 0)
      return notify_fail("你现在没有指定空手攻击技能。\n");

    skill = keys(pmap);
    for (i = 0; i < sizeof(skill); i++) {
      me->prepare_skill(skill[i]);
    }

    me->reset_action();
    write("取消了技能准备。\n");
    return 1;
  }

  if (sizeof(pmap) >= 1)
    return notify_fail("你现在已经指定了攻击技能。\n");

  if (sscanf(arg, "%s %s", arg1, arg2) >= 2)
    return notify_fail("指令格式：prepare|bei [<技能名称一>|\n");


  if (sscanf(arg, "%s", arg1) == 1) {
    if (!me->query_skill(arg1, 1))
      return notify_fail("你不会这种技能。\n");

    skill = keys(pmap);

    skill = keys(valid_types);
    for (i = 0; i < sizeof(skill); i++) {
      if (smap[skill[i]] == arg1) basic1 = skill[i];
    }
    for (i = 0; i < sizeof(valid_types); i++)
      if (arg1 == valid_types[i]) {
        basic1 = arg1;
        arg1 = me->query_skill_mapped(basic1);
      }
    if (!basic1)
      return notify_fail("这种技能尚未激发或目前不能准备。\n");

    me->prepare_skill(basic1, arg1);
    me->reset_action();
    write("完成技能准备。\n");

    return 1;
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : prepare [<空手技能名称> | none]
           prepare ?

这个指令让你指定所要用的空手攻击技能。如果不加参数则
会显示出技能种类及你目前所使用的技能名称 ，如果加一个
"?"，则会列出所有能使用特殊空手攻击技能的技能种类。
 
HELP
  );
  return 1;
}
