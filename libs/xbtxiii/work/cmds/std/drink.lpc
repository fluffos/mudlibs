#pragma save_binary
#include <ansi.h>;
int main(object me, string arg) {
  object water;

  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if (!arg) return notify_fail("您要喝点什么呀？\n");
  water = present(arg, me);
  if (!water) water = present(arg, environment(me));
  if (!water) return notify_fail("您周围似乎没有您要喝的东西。\n");
  if (me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");
  if (!water->type() || (string)water->type() != "food"
    || !water->query("liquid/name"))
    return notify_fail("这个东西恐怕不能喝吧!\n");
  if ((int)water->query("liquid/remaining") <= 0)
    return notify_fail(water->name() + (water->query("liquid/name") ?
      "已经被喝得一滴也不剩了\n" : "是空的。\n"));
  if ((int)me->query("water") >= (int)me->max_water_capacity())
    return notify_fail("你已经喝太多了，再也灌不下一滴水了。\n");
  if (!water->query("liquid/remaining")) {
    write("你已经将" + water->name() + "里的" + water->query("liquid/name")
      + "喝得一滴也不剩了。\n");
    return 1;
  }
  water->add("liquid/remaining", -1);
  message_vision("$N拿起" + water->name() + "咕噜噜地喝了几口" + water->query("liquid/name")
    + "。\n", me);
  me->add("water", water->query("liquid/drunk_apply"));

  // This allows customization of drinking effect.
  if (water->query("liquid/drink_func")) return 1;

  switch (water->query("liquid/type")) {
    case "alcohol":  //酒
      me->apply_condition("drunk",
        (int)me->query_condition("drunk")
        +(int)water->query("liquid/drunk_apply"));
      break;
  }
  return 1;
}
