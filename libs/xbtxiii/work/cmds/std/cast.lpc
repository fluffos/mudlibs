#pragma save_binary
// cast.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string spells, spl, trg,file;
	object target;

	seteuid(getuid());

	if( me->is_busy() )
	    return notify_fail("( 你上一个动作还没有完成，不能念咒文。)\n");
	if(environment(me)->query("no_magic")
	    ||environment(me)->query("no_kill")
	    ||environment(me)->query("no_fight"))
	    return notify_fail("这里不准念咒文。\n");

	if( !arg ) return notify_fail("指令格式：cast <法术> [on <目标>]\n");

	if( sscanf(arg, "%s on %s", spl, trg)==2 ){//专门为天眼通所设
	    target = present(trg, environment(me));
	    if( !target ) target = present(trg, me);
	    if( !target ){//使用天眼通必须和目标不在同一个房间
  	            if(spl=="chairvoyance"){
                    	target=find_living(trg);
		    	if(!target||target->query_temp("netdead")) return notify_fail("找不到 " + trg + "。\n");		  
		    } else return notify_fail("这里没有 " + trg + "。\n");
	    }
	    if(target->query_temp("netdead")) return notify_fail("你不能这样无耻的偷袭断线的人.\n");
	}
	else{
	    spl = arg;
	    target = 0;
	}
        if( sscanf(arg, "%s on %s", spl, trg)==2 ) {
        	if(userp(target) && target->query("mud_age") < 72000&&spl!="chairvoyance")
            		return notify_fail("你连小孩子也要杀么?太心狠手辣了吧!\n");
        	//if(!target->is_killing(me->query("id")))
        	//       target->kill_ob(me);
        }
        spl = replace_string( spl, " ", "_");
	if( stringp(spells = me->query_skill_mapped("spells")) ){
	      return SKILL_D(spells)->cast_spell(me, spl, target);
	}
	else {
	     file="/daemon/magicpool/"+spl;
	     if(file_size(file)>0){
                 return (int)call_other( file, "cast", me, target);
             }                	
	     else return notify_fail("你不会人任何魔法\n");
	}
}

int help (object me)
{
        write(@HELP
指令格式：cast <咒文名称> [on <施咒对象>]
 
施法，你必需要指定<咒文名称>，<施咒对象>则可有可无。
在你使用某一个咒文之前，你必须先用 enable 指令来指定你要使用的咒文系。
 
注：如果你改变自己的咒文系，你原本蓄积的法力并不能直接转换过去，必须
    从 0 开始。
 
HELP
        );
        return 1;
}
