#pragma save_binary
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object food;
  if (!arg) return notify_fail("你要吃什么呀？\n");
  food = present(arg, me);
  if (!food) food = present(arg, environment(me));
  if (!food) return notify_fail("你身上和周围都没有这个东西？\n");

  if (!food->type() || (string)food->type() != "food"
    || (int)food->query("food_remaining") <= 0)
    return notify_fail("这玩意儿能吃吗？\n");
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if ((int)me->query("food") >= (int)me->max_food_capacity())
    return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");
  if (!food->eat(me)) {  //调用食物身上的eat()
    me->add("food", food->query("food_supply"));
    // This allows customization of drinking effect.
    if (food->query("eat_func")) return 1;
    food->set("value", 0);
    food->add("food_remaining", -1);
    if (!food->query("food_remaining")) {
      message_vision("$N将剩下的" + food->name() + "吃得乾乾净净。\n", me);
      if (!food->finish_eat())
        destruct(food);
    } else
      message_vision("$N拿起" + food->name() + "咬了几口。\n", me);
    if (me->is_fighting()) me->start_busy(2);
    return 1;
  }  //如果食物本身有eat()函数的话就交于食物本身处理事件
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : eat [<吃的东西>]

这个指令让你吃东西，以补充失去的能量，需指明的是所吃的东西。
如果加一个 ? 你会吃你周围可以吃的饮品。

例如你输入：eat dumpling
你就会看见：你拿起包子咬了几口。
 
HELP
  );
  return 1;
}
