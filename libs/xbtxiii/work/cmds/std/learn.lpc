#pragma save_binary
// learn.c
// modify by junhot@xbtxIII 2000.10.07
// 判师惩罚：每判一次，减少能学到的级数40级，向师父学东西的难度系数变为(2+n)/2(修改learn)。
// 悔婚惩罚：每次减少能学到的为60级，学的难度系数变为(n+1)。
// 限制武功的熟练级数为(exp/100w)(exp/100w)+int*3+江湖阅历*2,超过熟练级数难度加大5倍。

#include <skill.h>

inherit F_CLEAN_UP;

string *reject_msg = ({
	"说道：您太客气了，这怎麽敢当？\n",
	"像是受宠若惊一样，说道：请教？这怎麽敢当？\n",
	"笑著说道：您见笑了，我这点雕虫小技怎够资格「指点」您什麽？\n",
});

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	string skill, teacher ,*all_my_skills;
	object ob, couple_ob;

        int master_skill, my_skill, gin_cost,betrayer,point,i;
        int improve_point,explore;


	explore = (100*me->query_explore_points()/EXPLORE_D->query_total_explore());
	if(!arg )
		return notify_fail("指令格式：learn <技能> from <某人>\n"
		"或者learn <技能> from <某人> with <潜能点数>\n");

	if( me->is_fighting() )
		return notify_fail("临阵磨枪？来不及啦。\n");

	if( me->query("gin")<50 )
		return notify_fail("你今天太累了，结果什麽也没有学到。\n");
	if( me->is_busy() )
		return notify_fail("等一下吧，你正忙着呢。\n");

	if (sscanf(arg, "%s from %s with %d", skill, teacher,point)==3 )
	{
		if(!intp(point)||point<2||point>((int)me->query("potential") - (int)me->query("learned_points")))
			return notify_fail("至少要用掉2点以上的潜能。\n");
		if( !(ob = present(teacher, environment(me))) || !ob->is_character())
			return notify_fail("你要向谁求教？\n");
		if( !living(ob)||ob->query_temp("disable_command") )
			return notify_fail("嗯....你得先把" + ob->name() + "弄醒再说。\n");
		if(me->query("MarrY")==ob->query("id") && ob->query("MarrY")==me->query("id")
		   && ob->query("gender")!="无性" && me->query("gender")!="无性")
			couple_ob = ob;
		if( !me->is_apprentice_of(ob) )
		{
			if (couple_ob != ob)
			{
				if( (string)me->query("family/family_name") != (string)ob->query("family/family_name")
				   ||(int)ob->query("family/privs") != -1 )
				{
					notify_fail( ob ->name() + reject_msg[random(sizeof(reject_msg))] );
					if( !(ob->recognize_apprentice(me)) ) return 0;
				}
			}
		}

		if( !master_skill = ob->query_skill(skill, 1) )
			return notify_fail("这项技能你恐怕必须找别人学了。\n");

		notify_fail(ob->name() + "不愿意教你这项技能。\n");
		if( ob->prevent_learn(me, skill) ) return 0;

		//关于不同职业所学技能的区分
		if (me->query("occupation")&&SKILL_D(skill)->valid_occupation())
		{
			if (SKILL_D(skill)->valid_occupation()!=me->query("occupation"))
				return notify_fail("以你的资质，不适合学这类武功。\n");
		}
		//关于不能有两种内功心法
		if(SKILL_D(skill)->valid_enable("force")==1)
		{
			if(me->query_skill_mapped("force")&&me->query_skill_mapped("force")!=skill)
			{
				tell_object(me,"你不散了"+to_chinese(me->query_skill_mapped("force"))+",怎么修习"+to_chinese(skill)+"\n");
				return 1;
			}
			else if(!me->query_skill_mapped("force")&&me->query_skills())
			{
				all_my_skills=keys(me->query_skills());
				for(i=0;i<sizeof(all_my_skills);i++)
				{
					if(SKILL_D(all_my_skills[i])->valid_enable("force")==1
					   &&all_my_skills[i]!=skill)
					{
						tell_object(me,"你不散了"+to_chinese(all_my_skills[i])+",怎么修习"+to_chinese(skill)+"\n");
						return 1;
					}
				}
			}
		}

		if( ob->query("MarrY")==me->query("id")&&betrayer = me->query("DivorceD") )
		{
			if(me->query_skill(skill,1)>10&&
			   me->query_skill(skill, 1) >= 
			   ob->query_skill(skill, 1) - betrayer * 60 )
			{
				message_vision("$N神色间似乎对$n不是十分信任，也许是想起$p从前离婚的事情。\n",ob, me );
				message_vision("$N说道：嗯 。。。我能教你的都教了，其他的你自己练吧。\n",ob);
				return 1;
			}
		}

		my_skill = me->query_skill(skill, 1);
		if( my_skill >= master_skill )
			return notify_fail("这项技能你的程度已经不输你师父了。\n");

		notify_fail("依你目前的能力，没有办法学习这种技能。\n");
		if( !SKILL_D(skill)->valid_learn(me) ) return 0;

		if (me->query("family/family_name")&&(me->query("family/family_name")
		    ==ob->query("family/family_name")))
		{
			if( my_skill > ((int)me->query("fealty")-20)/5&&my_skill>60 ) 
			{
				message_vision("$N摇摇头对$n说:你为本派做事的太少了。还是先多做点实事吧。\n",ob,me);
				return notify_fail(ob->name() + "不愿意教你这项技能。\n");
			}
			if( my_skill > ((int)me->query("fealty")-50)/20&&my_skill>100 ) 
			{
				message_vision("$N摇摇头对$n说:你为本派做事的太少了。还是先多做点实事吧。\n",ob,me);
				return notify_fail(ob->name() + "不愿意教你这项技能。\n");
			}
		}
		gin_cost =point*300 / (int)me->query_int();

		if( !my_skill )
		{
			gin_cost *= 2;
			me->set_skill(skill,0);
		}

		if( (int)me->query("learned_points") >= (int)me->query("potential") )
			return notify_fail("你的潜能已经发挥到极限了，没有办法再成长了。\n");

		printf("你向%s请教有关「%s」的疑问。\n", ob->name(),to_chinese(skill));

		if( ob->query("env/no_teach") )
			return notify_fail("但是" + ob->name() + "现在并不准备回答你的问题。\n");

		tell_object(ob, sprintf("%s向你请教有关「%s」的问题。\n",me->name(), to_chinese(skill)));

		if( (int)ob->query("sen") > gin_cost/5 + 1 )
		{
			if( userp(ob) ) ob->receive_damage("sen", gin_cost/5 + 1);
		}
		else
		{
			write("但是" + ob->name() + "显然太累了，没有办法教你什麽。\n");
			tell_object(ob, "但是你太累了，没有办法教" + me->name() + "。\n");
			return 1;
		}
                
		if( (int)me->query("gin") > gin_cost/5+1 )
		{
			me->receive_damage("gin", gin_cost/5+1 );
			if((string)SKILL_D(skill)->type()=="martial"
			   &&my_skill * my_skill * my_skill / 10 > 
			   (int)me->query("combat_exp") )
			{
				printf("也许是缺乏实战经验，你对%s的回答总是无法领会。\n", ob->name() );
			}
			else
			{
				printf("你听了%s的指导，似乎有些心得。\n", ob->name());
				me->add("learned_points", 1*point);
				if(SKILL_D(skill)->query_rate(me)<=10)
				{
					if(ob->query("MarrY")==me->query("id"))
					{
						improve_point=(point*random(me->query_int()*4+me->query("combat_exp")/2000)/(betrayer+1));
					}
					else
					{
						improve_point=(point*random(me->query_int()*4+me->query("combat_exp")/2000)/((me->query("betrayer")+2)/2));
					}
				}
				else
				{
					if(ob->query("MarrY")==me->query("id"))
					{
						improve_point=(point*random(me->query_int()*4+me->query("combat_exp")/2500)/(betrayer+1));
					}
					else
					{
						improve_point=(point*random(me->query_int()*4+me->query("combat_exp")/2500)/((me->query("betrayer")+2)/2));
					}
				}
				if (me->query_skill(skill,1)>=
				    ((me->query("combat_exp")/1000000)*(me->query("combat_exp")/1000000)+me->query_int()*3+explore*2))
					me->improve_skill(skill, improve_point/5);
				else	
					me->improve_skill(skill, improve_point);
			}
		}
		else
		{
			write("你今天太累了，结果什麽也没有学到。\n");
			me->unconcious();
		}

		return 1;
	}

	else if (sscanf(arg, "%s from %s", skill, teacher)!=2 )
		return notify_fail("指令格式：learn <技能> from <某人>\n"
		"或者learn <技能> from <某人> with <潜能点数>\n");

	if( !(ob = present(teacher, environment(me))) || !ob->is_character())
		return notify_fail("你要向谁求教？\n");

	if( !living(ob)||ob->query_temp("disable_command") )
		return notify_fail("嗯....你得先把" + ob->name() + "弄醒再说。\n");

	if(me->query("MarrY")==ob->query("id"))
		couple_ob = ob;

	if( !me->is_apprentice_of(ob) )
	{
		if (couple_ob != ob)
		{
			if((string)me->query("family/family_name") != 
			   (string)ob->query("family/family_name")
			   ||(int)ob->query("family/privs") != -1 )
			{
				notify_fail( ob ->name() + reject_msg[random(sizeof(reject_msg))] );
				if( !(ob->recognize_apprentice(me)) ) return 0;
			}
		}
	}

	if( !master_skill = ob->query_skill(skill, 1) )
		return notify_fail("这项技能你恐怕必须找别人学了。\n");

	notify_fail(ob->name() + "不愿意教你这项技能。\n");
	if( ob->prevent_learn(me, skill) ) return 0;

	//关于不同职业所学技能的区分
	if (me->query("occupation")&&SKILL_D(skill)->valid_occupation())
	{
		if (SKILL_D(skill)->valid_occupation()!=me->query("occupation"))
			return notify_fail("以你的资质，不适合学这类武功。\n");
	}
	//禁止两种内功
	if(SKILL_D(skill)->valid_enable("force")==1)
	{
		if(me->query_skill_mapped("force")&&me->query_skill_mapped("force")!=skill)
		{
			tell_object(me,"你不散了"+to_chinese(me->query_skill_mapped("force"))+",怎么修习"+to_chinese(skill)+"\n");
			return 1;
		}
		else if(!me->query_skill_mapped("force")&&me->query_skills())
		{
			all_my_skills=keys(me->query_skills());
			for(i=0;i<sizeof(all_my_skills);i++)
			{
				if(SKILL_D(all_my_skills[i])->valid_enable("force")==1
				   &&all_my_skills[i]!=skill)
				{
					tell_object(me,"你不散了"+to_chinese(all_my_skills[i])+",怎么修习"+to_chinese(skill)+"\n");
					return 1;
				}
			}
		}
	}

	if( ob->query("MarrY")==me->query("id")&&betrayer = me->query("DivorceD") )
	{
		if(me->query_skill(skill,1)>10&&
		   me->query_skill(skill, 1) >= 
		   ob->query_skill(skill, 1) - betrayer * 60 )
		{
			message_vision("$N神色间似乎对$n不是十分信任，也许是想起$p从前离婚的事情。\n",ob, me );
			message_vision("$N说道：嗯 。。。我能教你的都教了，其他的你自己练吧。\n",ob);
			return 1;
		}
	}

	my_skill = me->query_skill(skill, 1);
	if( my_skill >= master_skill )
		return notify_fail("这项技能你的程度已经不输你师父了。\n");

	notify_fail("依你目前的能力，没有办法学习这种技能。\n");
	if( !SKILL_D(skill)->valid_learn(me) ) return 0;

//和忠诚度有关(我暂时取消了。还有待讨论。新玩家根本不知道怎样做quest)
// 而加师门忠诚度的获取方法也不多。只能做quest或 杀倭寇来获得。太难！！！
// 先不要改回来。因为其中还有些bug.和诸多不合理的地方
// 讨论之后并且完善了增加忠诚度的东西之后再加上这个限制也不迟 ok???
	if 
(me->query("family/family_name")&&(me->query("family/family_name")==ob->
query("family/family_name")))
	{
		if( my_skill > ((int)me->query("fealty")-20)/5&&my_skill>60 ) 
		{
			message_vision("$N摇摇头对$n说:你为本派做事的太少了。还是先多做点实事吧。\n",ob,me);
			return notify_fail(ob->name() + "不愿意教你这项技能。\n");
		}
		if( my_skill > ((int)me->query("fealty")-50)/20&&my_skill>100 ) 
		{
			message_vision("$N摇摇头对$n说:你为本派做事的太少了。还是先多做点实事吧。\n",ob,me);
			return notify_fail(ob->name() + "不愿意教你这项技能。\n");
		}
	}

	gin_cost =300 / (int)me->query_int();

	if( !my_skill )
	{
		gin_cost *= 2;
		me->set_skill(skill,0);
	}

	if( (int)me->query("learned_points") >= (int)me->query("potential") )
		return notify_fail("你的潜能已经发挥到极限了，没有办法再成长了。\n");
	printf("你向%s请教有关「%s」的疑问。\n", ob->name(),to_chinese(skill));

	if( ob->query("env/no_teach") )
		return notify_fail("但是" + ob->name() + "现在并不准备回答你的问题。\n");

	tell_object(ob, sprintf("%s向你请教有关「%s」的问题。\n",me->name(), to_chinese(skill)));

	if( (int)ob->query("sen") > gin_cost/5 + 1 )
	{
		if( userp(ob) ) ob->receive_damage("sen", gin_cost/5 + 1);
	}
	else
	{
		write("但是" + ob->name() + "显然太累了，没有办法教你什麽。\n");
		tell_object(ob, "但是你太累了，没有办法教" + me->name() + "。\n");
		return 1;
	}        

	if( (int)me->query("gin") > gin_cost/5+1 )
	{
		me->receive_damage("gin", gin_cost/5+1 );
		if((string)SKILL_D(skill)->type()=="martial"
		   &&my_skill * my_skill * my_skill / 10 > 
		   (int)me->query("combat_exp") )
		{
			printf("也许是缺乏实战经验，你对%s的回答总是无法领会。\n", ob->name() );
		}
		else
		{
			printf("你听了%s的指导，似乎有些心得。\n", ob->name());
			me->add("learned_points", 1);
			if(SKILL_D(skill)->query_rate(me)<=10)
			{
				if(ob->query("MarrY")==me->query("id"))
				{
					improve_point=(random(me->query_int()*4+me->query("combat_exp")/2000)/(betrayer+1));
				}
				else
				{
					improve_point=(random(me->query_int()*4+me->query("combat_exp")/2000)/((me->query("betrayer")+2)/2));
				}
			}
			else
			{
				if(ob->query("MarrY")==me->query("id"))
				{
					improve_point=(random(me->query_int()*4+me->query("combat_exp")/2500)/(betrayer+1));
				}
				else
				{
					improve_point=(random(me->query_int()*4+me->query("combat_exp")/2500)/((me->query("betrayer")+2)/2));
				}
			}
			if (me->query_skill(skill,1)>=
			    ((me->query("combat_exp")/1000000)*(me->query("combat_exp")/1000000)+me->query_int()*3+explore*2))
				me->improve_skill(skill, improve_point/5);
			else	
				me->improve_skill(skill, improve_point);
		}
	}
	else
	{
		write("你今天太累了，结果什麽也没有学到。\n");
		me->unconcious();
	}

	return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : learn <技能> from <某人>
 
这个指令可以让你向别人请教有关某一种技能的疑难问题，当然，你请教的对象在这
项技能上的造诣必须比你高，而你经由这种方式学习得来的技能也不可能高於你所请
教的人，然而因为这种学习方式相当於一种「经验的传承」，因此学习可以说是熟悉
一种新技能最快的方法。

通常，一个人刚学到一种新技能是不会有什麽疑难问题的，而是经由实际上的应用中
遭遇问题，这些问题对於学习一种新技能的过程是很重要的，尤其是各种作为其他技
能基础的基本技能，更需要经由「发现问题—解决问题」的过程才能得到较好的效果
因此我们将这种发现问题的过程用「潜能」的观念表示，一个人能够自己发现某些问
题，表示他(她)有解决这项问题的潜能，当你具有这样的潜能时就可以利用这个指令
来向其他人请教，而获得进步。
(PS. 潜能还有其他更广义的定义，这里只是其中之一 )

此外学习也需要消耗一些精力，而消耗的精力跟你自己、与你学习对象的悟性有关。

至於如何知道你能从对方学到什麽技能，如果对方是你的师父，可以用 skills 指令
直接查看，如果不是你的师父，那麽通常会有其他的提示，你只好自己想办法。

其他相关指令 : practice、study
HELP
        );
        return 1;
}
 
