int main(object me, string arg) {
  object *list;
  string dest, mout, min, dir, desc, weared;
  string unit, arrive_msg, leave_msg, rev_dir, fight_str;
  object env, obj, *member;
  mapping exit;
  int move, i, x, y, flag, mx, my;

  if (!arg) return notify_fail("你要往哪个方向走？\n");
  if (me->query_temp("unmove")) return notify_fail("你被阵势困住了，动不了.\n");

  if (me->over_encumbranced())
    return notify_fail("你的负荷过重，动弹不得。\n");

  if (me->is_busy())
    return notify_fail("你的动作还没有完成，不能移动。\n");

  env = environment(me);
  if (!env) return notify_fail("你哪里也去不了。\n");
  /*if(!me->is_fighting())//不在战斗的时候队员不能随便移动
        {
                if(me->query_team()&&!me->is_team_leader())
                        return notify_fail("身为队员,应该以队长马首是瞻.不得擅自行动\n");
        }
        */
  exit = env->query("exits");
  flag = 0;
  mx = env->get_matrix_x();
  my = env->get_matrix_y();
  if (me->is_fighting() && me->query_temp("move_in_fight"))
    return notify_fail("你的动作还没有完成，不能移动。\n");
  if (me->is_fighting() && me->query_temp("map")
    && (arg == "west"
      || arg == "east"
      || arg == "north"
      || arg == "south"
      || arg == "northwest"
      || arg == "southeast"
      || arg == "northeast"
      || arg == "southwest"
    )
  ) {
    flag = 1;
    x = me->query_temp("map/x");
    y = me->query_temp("map/y");
    switch (arg) {
      case "west":
        x--;
        break;
      case "east":
        x++;
        break;
      case "south":
        y++;
        break;
      case "north":
        y--;
        break;
      case "southeast":
        y++;
        x++;
        break;
      case "northwest":
        y--;
        x++;
        break;
      case "southwast":
        y++;
        x--;
        break;
      case "northeast":
        y--;
        x--;
        break;
      default:
        flag = 0;
        break;
    }
  }
  if (flag == 0 ||
    (x > mx && abs(y * 2 - my - 1) <= 1 || x < 1 && abs(y * 2 - my - 1) <= 1
      || abs(x * 2 - mx - 1) <= 1 && y < 1 || abs(x * 2 - mx - 1) <= 1 && y > my
      || x > mx && y > my || x < 1 && y > my || x > mx && y < 1 || x < 1 && y > my)) {
    if (!mapp(exit) || undefinedp(exit[arg])) {
      if (query_verb() == "go")
        return notify_fail("这个方向没有出路。\n");
      else
        return 0;
    }
    if (objectp(exit[arg]))
      obj = exit[arg];
    else {
      dest = exit[arg];

      if (!(obj = find_object(dest)))
        call_other(dest, "???");
      if (!(obj = find_object(dest)))
        return notify_fail("无法移动。\n");
    }

    if (!env->valid_leave(me, arg)) return 0;

    if (check_guard(me, arg) == 0) {
      return notify_fail("你被挡了回来。\n");
    }
    if (!undefinedp(default_dirs[arg]))
      dir = default_dirs[arg];
    else
      dir = arg;
    if (!undefinedp(reverse_dirs[arg]))
      rev_dir = default_dirs[reverse_dirs[arg]];
    else
      rev_dir = NOR;
    if (me->is_fighting()) {
      if (check_flee(me, dir) == 0) {
        return notify_fail("你被挡了回来。\n");
      }
      mout = "往" + dir + "落荒而逃了。";
      min = "跌跌撞撞地跑了过来，模样有些狼狈。";
    } else {
      mout = "往" + dir + "离开。";
      min = "走了过来。";
    }
    if (me->query("per") >= 5 && me->query("per") < 10) {
      if (me->query("gender") == "女性") {
        if (me->query("age") < 18) desc = "丑丫头";
        if (me->query("age") >= 18 && me->query("age") < 40) desc = "丑姑娘";
        if (me->query("age") >= 40) desc = "丑老太婆";
      } else {
        if (me->query("age") < 18) desc = "丑男孩";
        if (me->query("age") >= 18 && me->query("age") < 40) desc = "丑汉子";
        if (me->query("age") >= 40) desc = "丑老头";
      }
    }
    if (me->query("per") >= 10 && me->query("per") < 20) desc = RANK_D->query_per(me);
    if (me->query("per") >= 20) {
      if (me->query("gender") == "女性") desc = "美丽" + RANK_D->query_per(me);
      else desc = "英俊" + RANK_D->query_per(me);
    }
    list = all_inventory(me);
    weared = "赤身裸体";
    for (i = 0; i < sizeof(list); i++)
      if (list[i]->query("equipped")
        && list[i]->query("armor_type") == "cloth")
        weared = "身着" + list[i]->name() + "的";

    if (me->query("race") == "野兽")
      if (me->is_fighting()) {
        mout = "往" + dir + "落荒而逃了。";
        min = "跌跌撞撞地跑了过来，模样有些狼狈。";
        desc = me->query("name");
        weared = NOR;
      } else {
        mout = "往" + dir + "离开。";
        min = "过来了。";
        desc = me->query("name");
        weared = NOR;
      }
    if (!stringp(unit = me->query("unit"))) unit = "位";
    arrive_msg = me->query("arrive_msg");
    if (!stringp(arrive_msg))
      arrive_msg = "一" + unit + weared + desc + min;
    leave_msg = me->query("leave_msg");
    if (!stringp(leave_msg))
      leave_msg = "一" + unit + weared + desc + mout;
    leave_msg = replace_string(leave_msg, "$N", me->name());
    arrive_msg = replace_string(arrive_msg, "$N", me->name());
    leave_msg = replace_string(leave_msg, "$W", weared);
    arrive_msg = replace_string(arrive_msg, "$W", weared);
    leave_msg = replace_string(leave_msg, "$D", dir);
    arrive_msg = replace_string(arrive_msg, "$D", rev_dir);
    leave_msg = replace_string(leave_msg, "$P", dir);
    arrive_msg = replace_string(arrive_msg, "$P", rev_dir);
    message("vision", leave_msg + "\n" NOR, environment(me), ({ me }));
    me->delete_temp("guard_room");
    me->remove_all_enemy();
    if (me->move(obj)) {
      message("vision", arrive_msg + "\n", environment(me), ({ me }));
      me->delete_temp("pending");
      //me->set_temp("pending", 0);
      if (me->query_team() && me->is_team_leader()) {  //队长移动的时候队员才跟着移动
        member = me->query_team();
        for (i = 0; i < sizeof(member); i++) {
          if (member[i] != me)
            member[i]->follow_path(arg);
        }

      }
      all_inventory(env)->follow_me(me, arg);
      return 1;
    }
  } else {
    if (flag == 1) {
      if (x >= 1 && x <= mx && y >= 1 && y <= my) {
        if (check_enemy(me, x, y))
          return notify_fail("那里有敌人，无法移动。\n");
        me->set_temp("map/x", x);
        me->set_temp("map/y", y);
        message_vision("$N向" + default_dirs[arg] + "移动了一格。\n", me);
        if (!me->query("env/olddisplay") && interactive(me))
          me->display_map();
        else {
          fight_str = "/cmds/std/look.lpc"->look_fight(me, env, all_inventory(env), exit);
          tell_object(me, fight_str);
        }
        me->set_temp("move_in_fight", 1);

        //移动速度和move挂钩
        move = me->query_skill("move");
        if (me->query("occupation")) {
          if (me->query("occupation") == "fighter") {
            if (move > 500) move = 1 + random(2);
            else move = 2;
          } else if (me->query("occupation") == "enchanter") {
            if (move > 500) move = 2 + random(2);
            else move = 3;
          }

        } else move = 3;

        call_out("remove_move", move, me);
        return 1;
      } else
        return notify_fail("这里没有路!\n");
    }
  }
  return 0;
}

void remove_move(object me) {
  if (objectp(me))
    me->delete_temp("move_in_fight");

}

void do_flee(object me) {
  mapping exits;
  string *directions;

  if (!environment(me) || !living(me)) return;
  exits = environment(me)->query("exits");
  if (!mapp(exits) || !sizeof(exits)) return;
  directions = keys(exits);
  tell_object(me, "看来该找机会逃跑了...\n");
  main(me, directions[random(sizeof(directions))]);
}

int help(object me) {
  write(@HELP
指令格式 : go <方向>
 
让你往指定的方向移动。
 
HELP


  );
  return 1;
}
