//对于组队增加了一些改变.

#pragma save_binary
#include <ansi.h>
inherit F_CLEAN_UP;



#define MAX_OPPONENT    4

mapping default_dirs = ([
  "north": "北",
  "south": "南",
  "east": "东",
  "west": "西",
  "northup": "北边",
  "southup": "南边",
  "eastup": "东边",
  "westup": "西边",
  "northdown": "北边",
  "southdown": "南边",
  "eastdown": "东边",
  "westdown": "西边",
  "northeast": "东北",
  "northwest": "西北",
  "southeast": "东南",
  "southwest": "西南",
  "up": "上",
  "down": "下",
  "out": "外",
]);
mapping reverse_dirs = ([
  "north": "south",
  "south": "north",
  "east": "west",
  "west": "east",
  "northup": "southdown",
  "southup": "northdown",
  "eastup": "westdown",
  "westup": "eastdown",
  "northdown": "southup",
  "southdown": "northup",
  "eastdown": "westup",
  "westdown": "eastup",
  "northeast": "southwest",
  "northwest": "southeast",
  "southeast": "northwest",
  "southwest": "northeast",
  "up": "down",
  "down": "up",
]);

int abs(int x) {

  if (x >= 0) return x;
  else return -x;
}

void create() { seteuid(getuid()); }

int check_enemy(object me, int x, int y) {
  int i;
  object ob;
  for (i = 0; i < me->get_enemy_number(); i++) {
    ob = me->enum_enemy(i);
    if (ob && ob->query_temp("map") && environment(me) == environment(ob)) {
      if (ob->query_temp("map/x") == x && ob->query_temp("map/y") == y)
        return 1;
    }
  }
  return 0;
}

