#pragma save_binary
//alert.c 

#include <ansi.h>
inherit SSERVER;

int main(object me, object target) {
  object snake;
  int number;
  if (me->query("family/family_name") != "丐帮"
    && me->query("family/family_name") != "星宿派")
    return notify_fail("趋蛇？你好象不会吧！\n");
  if (me->query_skill("qu-she-shu") <= 20)
    return notify_fail("你暂时还不会控制毒蛇，小心被咬着了！\n");

  if (!me->is_fighting())
    return notify_fail("平时还是不要把这玩意儿弄出来，太危险了！\n");

  if (me->query_skill("qu-she-shu", 1) >= 150)
    number = 4;
  else if (me->query_skill("qu-she-shu", 1) >= 120
    && me->query_skill("qu-she-shu", 1) < 150)
    number = 3;
  else if (me->query_skill("qu-she-shu", 1) >= 100
    && me->query_skill("qu-she-shu", 1) < 120)
    number = 2;
  else
    number = 1;
  if ((number) <= me->query_temp("havecalled"))
    return notify_fail("就凭你的技术，上哪儿去找这么多毒蛇来啊？\n");
  if ((int)me->query("sen") < 80)
    return notify_fail("先别急，你的神不足了！小心累死！\n");
  seteuid(getuid());
  me->receive_damage("sen", 100);
  message_vision(HIB "\n$N突然发出一阵阵奇怪的声响: *&～　　%#～　　%&　　～　　！\n" NOR, me);
  message_vision(HIB "\n不一会儿，一条条毒蛇不知道从那里钻了出来！\n" NOR, me);
  snake = new("/obj/npc/snake");
  me->add_temp("havecalled", 1);
  snake->move(environment(me));
  snake->invocation(me);
  //        me->remove_all_killer();
  me->start_busy(2);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：drivesnake
这个指令让丐帮弟子或者星宿弟子召唤毒蛇来保护自己.
如果自己的经验太低，招来的毒蛇有可能会攻击自己。 
HELP
  );
  return 1;
}
