#pragma save_binary


// reply.c

#include <ansi.h>

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  string str;
  object obj;

  if (!arg || arg == "")
    return notify_fail("你要熄灭什麽？\n");


  if ((obj = present(arg, me)) || (obj = present(arg, environment(me)))) {
    if (!obj->query_temp("light")) return notify_fail("这样东西不是点着的。\n");
    if (!obj->do_unlight()) return notify_fail("这样东西不能熄灭。\n");
  } else return notify_fail("你身上没有这样东西。\n");
  if (stringp(str = obj->query("unlight_msg")))
    obj->set("long", str);
  obj->set("name", obj->query("real_name"));
  message_vision("$N熄灭了" + obj->name() + "\n", me);


  return 1;
}

int help(object me) {
  write(@HELP
指令格式：unlight <火把或其它>

熄灭火把或灯......
see also : light
HELP
  );
  return 1;
}
