#pragma save_binary
 
 
// cost.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int i;
	string *cmds;
	string str;

	seteuid(getuid());
   	if(!arg) return notify_fail("指令格式：do <指令1>[,<指令2> ....]\n");
	if(strsrch(arg,",")!=-1){
		cmds=explode(arg,",");
	} else cmds=({arg});
        if(!objectp(me)) return 0;
    	me->force_me(cmds[0]);
	if(sizeof(cmds)==1) return 1;
	str="";
	for(i=1;i<sizeof(cmds);i++){
		str=str+cmds[i];
		if(i!=sizeof(cmds)) str=str+",";
	}
	call_out("main",0,me,str);
	return 1;
}

int help()
{
	write( @TEXT
指令格式：do <指令1> [,<指令2> .... ]

这个指令连续执行一串指令。
例如 do hi,hi,hehe
你说道："Hi!"

你说道："Hi!"

你呵呵地傻笑了几声.
TEXT
	);
	return 1 ;
}
