#pragma save_binary
// song.c
// This is writted by waan.

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object *target;
  string *tuned_ch;
  int num, i;
  string emote, msg;
  me = this_player();
  target = users();


  if (userp(me)) {
    i = strlen(arg);

    while (i--) {
      if (arg[i] == '')
        arg = replace_string(arg, "", " ");
    }
  }
  if (me->query("id") == "guest") return 0;
  if (me->query("chblk_on")) return 0;
  if (CHANNEL_D->query("block_song")) return 0;
  tuned_ch = me->query("channels");
  if (!pointerp(tuned_ch))
    me->set("channels", ({ "song" }));
  else if (member_array("song", tuned_ch) == -1)
    me->set("channels", tuned_ch + ({ "song" }));
  if (!arg) {
    message(
      "channel:song",
      CYN "【歌唱】" + me->name(1) + "拉起五音不全的喉咙哼起歌来! 「 啦 ..～  □□」...难听死了.\n" NOR,
      target
    );
    return 1;
  }
  if (sscanf(arg, "%d %s", num, msg) == 2) {
    switch (num) {
      case 0:
        message(
          "channel:song",
          HIR "【歌唱】" + me->name(1) + "面无表情地唱着: " + msg + ".一点表情也没有,太难看了.\n" NOR,
          target
        );
        return 1;
      case 1:
        message("channel:song", HIY "【歌唱】" + me->name(1) + "愉快地唱道: " + msg + ".\n" NOR, target);
        return 1;
      case 2:
        message("channel:song", MAG "【歌唱】" + me->name(1) + "忧郁地唱着: " + msg + ".\n" NOR, target);
        return 1;
      default:
        if (sscanf(msg, "%s %s", emote, arg) == 2) {
          message(
            "channel:song",
            YEL "【歌唱】" + me->name(1) + emote + "唱着: " + arg + ".\n" NOR,
            target
          );
        } else message("channel:song", HIG "【歌唱】" + me->name(1) + "唱道: " + msg + ".\n" NOR, target);
        return 1;
    }
  }
  if (sscanf(arg, "%s", msg) == 1) {
    message("channel:song", HIG "【歌唱】" + me->name(1) + "唱道: " + msg + ".\n" NOR, target);
    return 1;
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 :song <0,1,2> 内容
       或 song 3 表情 内容
       或 song 内容
唱出你的心声。


HELP
  );
  return 1;
}
