#pragma save_binary
 
 
// reply.c

#include <ansi.h>

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	string str;
	object obj;

	if( !arg || arg=="" )
		return notify_fail("你要点燃什麽？\n");


	if( (obj = present(arg, me)) || (obj = present(arg, environment(me)))) {
		if(obj->query_temp("light")) return notify_fail("这样东西已经是亮的了。\n");
		if(!obj->do_light()) return notify_fail("这样东西不能点。\n");
	} else return notify_fail("你身上没有这样东西。\n");
	if(stringp(str=obj->query("light_msg")))
		obj->set("long",str);
	str=obj->name();
	message_vision( "$N点着了" +  obj->name() + "\n" , me);
	obj->set("name",str+"(点燃的)");


	return 1;
}

int help(object me)
{
	write(@HELP
指令格式：light <火把或其它>

点燃火把或灯......
see also : unlight
HELP
	);
	return 1;
}
