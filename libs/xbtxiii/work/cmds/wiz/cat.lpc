#pragma save_binary

int help(object);

int main(object me, string arg) {
  string file;
  int i;
  string *msg;
  if (me != this_player(1)) return 0;
  seteuid(geteuid(me));
  if (!arg || arg == "")
    return help(me);

  file = resolve_path(me->query("cwd"), arg);

  if (file_size(file) < 0)
    return notify_fail("没有这个档案。\n");
  if (file_size(file) > 40960)
    return notify_fail("文件太大了！\n");
  if (!read_file(file))
    return notify_fail("文件太大，无法载入内存。\n");
  msg = explode(read_file(file), "\n");
  for (i = 0; i < sizeof(msg); i++)
    write(msg[i] + "\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : cat <档案>

此指令可让你(□)直接读取某档案之程式。
HELP
  );
  return 1;
}
