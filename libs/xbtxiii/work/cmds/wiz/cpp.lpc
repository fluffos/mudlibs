#pragma save_binary


// cpdir.c

inherit F_CLEAN_UP;



int main(object me, string arg) {
  int i, j;
  string src, dest;
  string *ppls;

  if (me != this_player(1)) return 0;
  seteuid(geteuid(me));

  if (!arg)
    return notify_fail("指令格式 cpdir <scrpath> <destpath>\n");
  if (sscanf(arg, "%s %s", src, dest) != 2)
    return notify_fail("指令格式 cpdir <scrpath> <destpath>\n");
  ppls = get_dir(src + "/");
  for (j = 0; j < sizeof(ppls); j++) {
    if (!cp(src + "/" + ppls[j], "/" + ppls[j]))
      write(src + "/" + ppls[j] + " \tcopy wrong.\n");
    else write("copy " + src + "/" + ppls[j] + "\tto\t" + dest + "\tok.\n");
  }
  return 1;
}


int help(object me) {
  write(@HELP
指令格式 cpdir <srcpath> <destpath>

拷贝整个目录的文件(会覆盖同名文件)＃
HELP
  );
  return 1;
}
