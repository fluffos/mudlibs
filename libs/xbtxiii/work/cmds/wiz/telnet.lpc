int do_telnet(string arg, object me);
inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
}

int main(object me, string arg) {
  string menu;
  menu = "可以连接得站点如下:或者直接telnet 地址 端口(如果省略端口,默认为23)\n"
    "[1] 水木清华    [2] 白云黄鹤    [3] 华南理工    [4] 蓝天\n"
    "[5] 暨南大学    [6] 网易bbs     [7] 明月弯      [8] 碧海银沙\n"
    "[9] 深圳润讯   [10] 深圳龙门    [0] 退出 \n"
    "请选择你要连接的站点\n";
  write(menu);
  if (!arg) input_to("do_choose", 1, me);
  else do_telnet(arg, me);
  return 1;
}

int do_choose(string arg, object me) {
  string menu;
  int choose;
  if (!arg) {
    menu = "可以连接得站点如下:或者直接telnet 地址 端口(如果省略端口,默认为23)\n"
      "[1] 水木清华    [2] 白云黄鹤    [3] 华南理工    [4] 蓝天\n"
      "[5] 暨南大学    [6] 网易bbs     [7] 明月弯      [8] 碧海银沙\n"
      "[9] 深圳润讯   [10] 深圳龙门    [0] 退出 \n"
      "请选择你要连接的站点.........\n";
    write(menu);
    input_to("do_choose", 1, me, arg);
    return 1;
  }
  switch (arg) {
    case "1":
      choose = 1;
      break;
    case "2":
      choose = 2;
      break;
    case "3":
      choose = 3;
      break;
    case "4":
      choose = 4;
      break;
    case "5":
      choose = 5;
      break;
    case "6":
      choose = 6;
      break;
    case "7":
      choose = 7;
      break;
    case "8":
      choose = 8;
      break;
    case "9":
      choose = 9;
      break;
    case "10":
      choose = 10;
      break;
    case "0":
      choose = 0;
      break;
    default: choose = 11;
  }
  if (choose < 0 || choose > 10) {
    menu = "可以连接得站点如下:或者直接telnet 地址 端口(如果省略端口,默认为23)\n"
      "[1] 水木清华    [2] 白云黄鹤    [3] 华南理工    [4] 蓝天\n"
      "[5] 暨南大学    [6] 网易bbs     [7] 明月弯      [8] 碧海银沙\n"
      "[9] 深圳润讯   [10] 深圳龙门    [0] 退出 \n"
      "请选择你要连接的站点...\n";
    write(menu);
    input_to("do_choose", 1, me, arg);
    return 1;
  } else if (choose == 0) {
    tell_object(me, "欢迎再来.再见.................\n");
    return 1;
  }
  do_telnet("" + arg, me);  //连线
  return 1;
}
int do_telnet(string arg, object me) {

  object ob;
  object linkob;
  string telnetip, *file, letterip, ip;
  mapping ip_mapping = ([]);
  int i;

  ///////////ip解析///////////////////
  telnetip = read_file("/obj/telnet/telnetip.data");
  if (!telnetip) {
    assure_file("/obj/telnet/telnetip.data");
    if (!write_file("/obj/telnet/telnetip.data", "bbs.szu.edu.cn@#@210.39.3.50\n", 1));
    return 0;
    telnetip = "bbs.szu.edu.cn@#@210.39.3.50\n";
    //省却下面还要判断有没有file这个文件的麻烦
  }
  file = explode(telnetip, "\n");
  ip_mapping = allocate_mapping(sizeof(file));
  for (i = 0; i < sizeof(file); i++) {
    //if(all_password[i][0]=='#'||
    if (sscanf(file[i], "%s@#@%s", letterip, ip) != 2) continue;
    ip_mapping[letterip] = ip;  //bbs.szu.edu.cn(letterip) 210.39.3.50(ip)
  }
  if (ip_mapping[arg]) {
    arg = ip_mapping[arg];  //转换
    arg += " 23";
  }
  if (strsrch(arg, " ") == -1) arg += " 23";

  ob = new("/obj/telnet/telnet");
  linkob = me->query_temp("link_ob");
  linkob->save();
  me->save();
  exec(ob, me);
  ob->do_telnet(arg);
  ob->do_command("");
  call_out("do_dest", 2, me);
  call_out("do_dest", 2, linkob);
  return 1;
}
void do_dest(object ob) {
  destruct(ob);
}

int help(object me) {
  write("指令格式:telnet 地址 端口(如果省略端口,默认为23)\n"
    "或者输入telnet(不加参数),按照菜单选择.\n");
  return 1;
}
