#pragma save_binary
// reboot.c

#include <login.h>
#include <obj.h>
#include <ansi.h>
protected void countdown(int min);
protected void do_shutdown();
protected void start_shutdown();
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string wiz_status;
	object npc;

	if( me != this_player(1) ) return 0;
	
	wiz_status = SECURITY_D->get_status(me);
	if( wiz_status != "(admin)" && wiz_status != "(arch)" )
		return notify_fail("只有 (arch) 以上的巫师才能重新启动" + MUD_NAME + "\n");

	seteuid(getuid());

	npc = new(NPC_DEMOGORGON);
    npc->move("/d/fy/fysquare");
	start_shutdown();

	write("Ok。\n");

	return 1;
}



protected void start_shutdown()
{
        if( geteuid(previous_object()) != ROOT_UID ) return;

        message("system",
                HIR "\n你听到天空中传来一阵可怕的咆哮 ....\n\n"
                HIW     "侮天鬼王" HIR "用震耳欲聋的声音喝道：\n\n"
                        "\t\t全 天 下 的 众 生 给 我 听 著 ！\n\n"
                        "\t\t限你们五分钟内把我的头颅交出来 ！\n\n"
                        "\t\t不 然 的 话 ..... 哼 .. 哼 ！\n\n" NOR,
                users() );
        call_out("countdown", 60, 5);
}

protected void countdown(int min)
{
        min--;
        if( min ) {
                message("system",
                        HIW "\n侮天鬼王" HIR "用震耳欲聋的声音喝道：\n\n"
                                "\t\t你们还有" + chinese_number(min) + "分钟的时间交出我的头颅！\n\n"
                                "\t\t—不—要—命—的—就—给—我—慢—慢—拖—吧—！\n\n" NOR,
                        users() );
                call_out("countdown", 60, min);
        } else {
                message("system",
                        HIW "\n侮天鬼王" HIR "用震耳欲聋的声音喝道：\n\n"
                                "\t\t可恨.....真是可恨....\n\n"
                                "\t\t苍天啊～ 大地啊～  海洋啊～  众生啊～\n\n" NOR,
                        users() );
                call_out("do_shutdown", 3);
        }
}

protected void do_shutdown()
{
        object *user,link_ob;
        int i;
        message("system",
                HIW "\n\n侮天鬼王" HIR "用震耳欲聋的声音喝道：\n\n"
                HIW "\t\t通 通 和 我 一 起 下 地 狱 吧 ～～～～ ！\n\n"
                HIR "\t\t声音一毕，天空立刻变得血红，不....你眼前的一切都变得血红...\n\n"
                        "\t\t所有的一切都在瞬间陷入火海....\n\n"
                        "\t\t然後你的眼前是一片黑暗....无止尽的黑暗....\n\n" NOR,
                users() );
        user=users();
        for(i=0; i<sizeof(user); i++) 
                {
            if( !environment(user[i]) ) continue;
                user[i]->save();
                link_ob = user[i]->query_temp("link_ob");
                if( objectp(link_ob) ) link_ob->save();
                }
    	seteuid(ROOT_UID);
        shutdown(0);
}





int help (object me)
{
        write(@HELP
指令格式: reboot
 
重新起动游戏, 系统会开始倒数计时, 十五分钟後重新起动。
 
HELP
);
        return 1;
}
 
