//To change a room's coor.
//By Junhot 2000/06/24

inherit F_CLEAN_UP;
int do_one_room(object room, int x, int y, int z);
int main(object me, string arg) {
  int x, y, z;

  if (!arg || sscanf(arg, "%d,%d,%d", x, y, z) != 3)
    return notify_fail("指令格式：recoor x,y,z\n");
  do_one_room(environment(me), x, y, z);
  return 1;
}

int do_one_room(object room, int x, int y, int z) {
  string file;
  int *coor;

  coor = room->query("coor");
  reset_eval_cost();
  file = read_file(base_name(room) + ".lpc");

  if (coor)
    file = replace_string(file,
      "	set(\"coor\",({" + coor[0] + "," + coor[1] + "," + coor[2] + "}));\n", "");

  file = replace_string(file,
    "void create()\n{\n",
    sprintf("void create()\n{\n	set(\"coor\",({%d,%d,%d}));\n", x, y, z));

  if (write_file(base_name(room) + ".lpc", file, 1))
    write("Finished room " + base_name(room) + "\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式  :  recoor x,y,z

修改房间坐标的指令。

如果房间原本已经有坐标，请确认set("coor",({x,y,z}));之前
为Tab输入的空格，否则先删除原有坐标再使用本命令。

使用本命令后必须update here刷新，否则在该房间再次使用时
会造成该房间有两个set("coor",)，原因不必累述。

HELP
  );
  return 1;
}
