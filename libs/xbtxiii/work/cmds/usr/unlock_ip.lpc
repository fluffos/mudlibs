#pragma save_binary



// unlock_ip
inherit F_CLEAN_UP;


void create() {
  seteuid(getuid());
}

int main(object me, string arg) {


  if (me->is_busy())
    return notify_fail("你正忙著做其他事！\n");
  me->delete("MY_ONLY_IP");
  tell_object(me, "你现在解除了IP限制。从此以后。你的这个人物\n"
    "可以从任何IP连线进入。如果你想防止你的人物\n"
    "被他人盗用。请用lock_ip命令锁定IP。\n");
  tell_object(me, "\n OK\n");

  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : unlock_ip
解除IP的锁定。解除IP锁定之后.这个人物可以从任何IP
连线进入了。
HELP
  );
  return 1;
}
