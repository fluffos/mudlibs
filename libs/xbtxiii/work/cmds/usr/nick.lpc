#pragma save_binary
// nick.c
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        if( !arg ) return notify_fail("你要替自己取什麽绰号？\n");
        if( strlen(arg) > 60 )
                return notify_fail("你的绰号太长了，想一个短一点的、响亮一点的。\n");

if(strsrch(arg,"ESC")>=0||strsrch(arg,"[")>=0)
return notify_fail("nick里面不允许出现这样的字符\n");
         //防止玩家利用这里将系统指定的头衔给屏蔽掉
        arg = replace_string(arg, "$BLK$", BLK);
        arg = replace_string(arg, "$RED$", RED);
        arg = replace_string(arg, "$GRN$", GRN);
        arg = replace_string(arg, "$YEL$", YEL);
        arg = replace_string(arg, "$BLU$", BLU);
        arg = replace_string(arg, "$MAG$", MAG);
        arg = replace_string(arg, "$CYN$", CYN);
        arg = replace_string(arg, "$WHT$", WHT);
        arg = replace_string(arg, "$HIR$", HIR);
        arg = replace_string(arg, "$HIG$", HIG);
        arg = replace_string(arg, "$HIY$", HIY);
        arg = replace_string(arg, "$HIB$", HIB);
        arg = replace_string(arg, "$HIM$", HIM);
        arg = replace_string(arg, "$HIC$", HIC);
        arg = replace_string(arg, "$HIW$", HIW);
        arg = replace_string(arg, "$NOR$", NOR);
        arg = replace_string(arg, "$ESC$", ESC);
        arg = replace_string(arg, "$FLASH$", FLASH);
        arg = replace_string(arg, "$HBRED$", HBRED);
        arg = replace_string(arg, "$BRED$", BRED);
        arg = replace_string(arg, "$HBGRN$", HBGRN);
        arg = replace_string(arg, "$BGRN$", BGRN);
        arg = replace_string(arg, "$HBYEL$", HBYEL);
        arg = replace_string(arg, "$BYEL$", BYEL);
        arg = replace_string(arg, "$HBBLU$", HBBLU);
        arg = replace_string(arg, "$BBLU$", BBLU);
        arg = replace_string(arg, "$HBMAG$", HBMAG);
        arg = replace_string(arg, "$BMAG$", BMAG);
        arg = replace_string(arg, "$HBCYN$", HBCYN);
        arg = replace_string(arg, "$HBMAG$", HBMAG);
        arg = replace_string(arg, "$BCYN$", BCYN);
        if(wizardp(me))
            arg = replace_string(arg, "$CSI$", CSI);

if(arg=="none")
        me->delete("nickname");
else
        me->set("nickname", arg + NOR);
        write("Ok.\n");
        return 1;
}
int help(object me)
{
        string msg;
msg="指令格式 : nick <外号, 绰号>\n"
    "           nick none  取消绰号"
    "这个指令可以让你为自己取一个响亮的名号或头衔，你如果希望在绰号中\n"
     "最好不要取太长的NICK。\n"
    "使用 ANSI 的控制字元改变颜色，可以用以下的控制字串：\n"
    RED"$RED$"+"    "+HIR"$HIR$"+"    "+GRN"$GRN$"+"    "+HIG"$HIG$\n"
    YEL"$YEL$"+"    "+HIY"$HIY$"+"    "+BLU"$BLU$"+"    "+HIB"$HIB$\n"
    MAG"$MAG$"+"    "+HIM"$HIM$"+"    "+CYN"$CYN$"+"    "+HIC"$HIC$\n"
    WHT"$WHT$"+"    "+HIW"$HIW$\n"
    HBRED"$HBRED$"+"    "+BRED"$BRED$"+"    "+HBGRN"$HBGRN$"+"    "+BGRN"$BGRN$\n"
    HBYEL"$HBYEL$"+"    "+BYEL"$BYEL$"+"    "+HBBLU"$HBBLU$"+"    "+BBLU"$BBLU$\n"
    HBMAG"$HBMAG$"+"    "+BMAG"$BMAG$"+"    "+HBCYN"$HBCYN$"+"    "+BCYN"$BCYN$\n"
//    HBWHT"$HBWHT$\n"
    FLASH"$FLASH$"+NOR"闪动其中系统自动会在字串尾端加一个 $NOR$。\n"
    FLASH+HIR"PS:闪动不许超过2个字，以免影响他人。\n"NOR;
    tell_object(me,msg);
        return 1;
}
