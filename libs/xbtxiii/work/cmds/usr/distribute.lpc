#pragma save_binary
 
inherit F_CLEAN_UP;
int main(object me, string arg)
{
        object ob;
        if( me != this_player(1) ) return 0;
        ob = me->query_temp("link_ob");
        if( !ob ) return 0;
        if ( ob && ob->is_character() ) return 0;

        if(!arg) {
                   tell_object(me, sprintf("你的先天天赋如下：\n"
                        " 膂力：[%2d]  胆识：[%2d]  悟性：[%2d]  灵性：[%2d]\n"
                        " 定力：[%2d]  容貌：[%2d]  根骨：[%2d]  福缘：[%2d]\n\n",
                        ob->query("str"),ob->query("cor"),ob->query("int"),ob->query("spi"),
                        ob->query("cps"),ob->query("per"),ob->query("con"),ob->query("kar")));
                   return 1;
        }
        if(me->query("star_point")<=0) return notify_fail("你没有分配参考点数了!!!\n");
        seteuid(getuid());

        switch(arg) {
              case "str":
              case "膂力":
                   if(me->query("str")<20)me->add("str",1);
                   ob->add("str",1);
                   me->add("star_point",-1);
                   break;
              case "int":
              case "悟性":
                   if(me->query("int")<20)me->add("int",1);
                   ob->add("int",1);
                   me->add("star_point",-1);
                   break;
              case "con":
              case "根骨":
                   if(me->query("con")<20)me->add("con",1);
                   ob->add("con",1);
                   me->add("star_point",-1);
                   break;
              case "cor":
              case "胆识":
                   if(me->query("cor")<20)me->add("cor",1);
                   ob->add("cor",1);
                   me->add("star_point",-1);
                   break;
              case "cps":
              case "定力":
                   if(me->query("cps")<20)me->add("cps",1);
                   ob->add("cps",1);
                   me->add("star_point",-1);
                   break;
              case "spi":
              case "灵性":
                   if(me->query("spi")<20)me->add("spi",1);
                   ob->add("spi",1);
                   me->add("star_point",-1);
                   break;
              case "kar":
              case "福缘":
                   if(me->query("kar")<20)me->add("kar",1);
                   ob->add("kar",1);
                   me->add("star_point",-1);
                   break;
              case "per":
              case "容貌":
                   if(me->query("per")<20)me->add("per",1);
                   ob->add("per",1);
                   me->add("star_point",-1);
                   break;
               default:
                    return notify_fail("你要分配到什么天赋上？\n");
           }
           ob->save();
           me->save();
           tell_object(me,"ＯＫ\n");
           return 1;
}
int help(object me)
{
        write(@HELP
指令格式 : distribute  <某天赋>
这个指令可以将参考点数分配到人物的先天(不到20点后天也加)天赋上。
    天赋为膂力(str)， 悟性(int)， 根骨(con)， 胆识(cor),
          定力(cps)， 灵性(spi)， 福缘(kar)， 容貌(per)

ps:后天天赋会受先天天赋所限,只能达到一定水平，这时只有先提高先天天赋
   才能有效的提高后天天赋.此外。当所有当前天赋到达20之后。
分配上去的点数只能够提高先天天赋的最大值。不会提高当前天赋
HELP
    );
    return 1;
}
