	"waterfog":  "tianxie", 
        "jiangnan":  "jinling", 
	]));
	set("chname",([
        "baituo":    "白驮",
        "canyon":    "军营",      
        "choyin":    "乔阴",      
        "city":      "京城",
        "quicksand":    "沙漠",
