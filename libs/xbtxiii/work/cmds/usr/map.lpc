int main(object me, string arg)
{
	string file,name,msg,*path,fpath;
	object room;

	if(me!=this_player(1)) return 0;

	room=environment(me);
	path=explode(base_name(room), "/");

	if(!arg||arg!="here"){
	    name=query("chname/"+path[1]);
	    file=read_file("/doc/help/map.xbtx");
	    if(strsrch(file,name)>=0){
	        msg=replace_string(file,name,FLASH+HIC+name+NOR);
	        me->start_more(msg);
	        return 1;
	    }else return notify_fail("对不起,这里地形非常奇怪,无法显示您在总地图的位置\n"
	                             "请使用map here来查看您在地图上面的详细位置\n");
	    
	}
	
	if((!stringp(room->query("outdoors"))||NATURE_D->check_weather(name)==0)
	&&!room->query_temp("light"))
	     return notify_fail("光线太暗了,无法看清楚地图只能用map看大约的位置\n");

	name=room->query("short");
	
	if(!name) return notify_fail("对不起,这里地形非常奇怪,无法显示您在地图上面的详细位置\n"
	                             "请使用map来查看您在总地图的位置\n");
	file=read_file("/doc/help/map."+path[1]);
	if(!file){
		fpath=query("change/"+path[1]);
		if(!fpath) return notify_fail("对不起，这里还暂时没有地图的帮助文件.你可以请求巫师完善地图\n");
		file=read_file("/doc/help/map."+fpath);
		if(!file) return notify_fail("对不起，这里还暂时没有地图的帮助文件.你可以请求巫师完善地图\n");
	}
	if(strsrch(file,name)>=0){
	    msg=replace_string(file,name,FLASH+HIC+name+NOR);
	    me->start_more(msg);
	    return 1;
	}else return notify_fail("对不起,这里地形非常奇怪,无法显示您在地图上面的详细位置\n"
	                             "请使用map来查看您在总地图的位置\n");

}

int help(object me)
{
	write("指令格式 : map 显示您在总地图的位置;map here 显示您在地图的详细位置\n");
        return 1;
}
