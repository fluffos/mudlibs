        "shangshu":  "京城",
        "shaolin":   "少林",
        "snow":      "宁远",
        "start_room":"泥巴世界入口",
        "taishan":   "泰山",
        "temple":    "茅山",
        "village":   "华山附近",
        "waterfog":  "天邪",
        "wudang":    "武当",
