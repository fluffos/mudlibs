#pragma save_binary
// who.c

#include <net/dns.h>
#include <mudlib.h>
#include <ansi.h>
inherit F_CLEAN_UP;
string *faction_name = ({
  "华山派", "天邪派", "武当派", "丐帮",
  "茅山派", "封山派", "晚月庄", "星宿派",
  "少林派", "峨嵋派", "神龙教", "朝廷",
  "大理段家", "桃花岛", "全真教",
  "古墓派", "雪山寺", "逍遥派",
});
void create() { seteuid(getuid()); }
int sort_user(object ob1, object ob2);
int sort_exp_user(object ob1, object ob2);
string space = "                     ";
mixed main(object me, string arg, int remote) {
  string str, *option, fam_name, title;
  object *list, *temp_list, *wizard_list, ob;
  int i, j, ppl_cnt, fac_no, fac_amt = sizeof(faction_name);
  int opt_long, opt_id, opt_wiz, opt_topten;
  // 为了比较快速的更改玩家的头衔。
  // 并且不用太占用系统。所以放在了这个命令里面。

  list = users();
  //        list-=({ 0 });
  for (i = 0; i < sizeof(list); i++) {
    if (!wizardp(list[i]) && !(list[i]->query("usemytitle"))) {
      fam_name = list[i]->query("family/family_name");
      if (fam_name) {
        if (fam_name == "朝廷" || fam_name == "少林派" || fam_name == "雪山寺") continue;
        else {
          title = "/adm/daemons/titled"->get_title(list[i], fam_name);
          if (title && stringp(title) && title != "NO_FAMILY")
            list[i]->set("title", title);
        }
      } else {
        title = "/adm/daemons/titled"->get_title(list[i], "NO_FAMILY");
        list[i]->set("title", title);
      }
    } else continue;
  }
  set_eval_limit(0);
  if (remote && sizeof(arg) < 2) arg = "";
  if (arg) {
    string verbose = "", rwho = "";
    option = explode(arg, " ");
    i = sizeof(option);
    while (i--)
      switch (option[i]) {
        case "-l": opt_long = 1; verbose += "-l "; continue;
        case "-i": opt_id = 1; verbose += "-i "; continue;
        case "-w": opt_wiz = 1; verbose += "-w "; continue;
        //                                case "-t": opt_topten = 1;verbose+="-t ";continue;
        default:
          if (option[i][0] == '@') {
            rwho = option[i][1..sizeof(option[i])];
          } else return notify_fail("指令格式：who [-l|-i|-w]\n");
      }
    if (strlen(rwho) > 0) {
      RWHO_Q->send_rwho_q(rwho, me, verbose);
      write("网路讯息已送出，请稍候。\n");
      return 1;
    }
  }

  for (i = 0; i < sizeof(list); i++)
    for (j = i + 1; j < sizeof(list); j++)
      if (sort_user(list[i], list[j]) > 0) {
        ob = list[i]; list[i] = list[j]; list[j] = ob;
      }

  if (remote) {
    opt_long = 0;  // disable -l for remote because too long.
#ifdef INTERMUD_NAME    str = "■ " + INTERMUD_NAME + "\n";
#else                   str = "■ " + MUD_NAME + "\n";
#endif
  } else
    str = "■ " + MUD_NAME + "\n";
  str += "─────────────────────────────────────\n";
  ppl_cnt = 0;


  if (opt_long) {
    for (fac_no = 0; fac_no < fac_amt; fac_no++) {
      i = sizeof(list);
      while (i--) {
        // Skip those users in login limbo.
        if (!environment(list[i])) continue;
        if (me && !me->visible(list[i])) continue;
        if (remote && list[i]->query("env/invisibility")) continue;
        //巫师隐身了之后应该可以不给别人查看到
        if (interactive(list[i]))
          ppl_cnt++;
        if (list[i]->query("family/family_name") == faction_name[fac_no]) {
          str = sprintf("%s%12s%s%s\n", str,
            RANK_D->query_rank(list[i]),
            interactive(list[i]) ? (query_idle(list[i]) > 180 ? HIG "*" NOR : " ") : HIR "#" NOR,
            list[i]->short(1));
          list -= ({ list[i] });
        }
      }
    }
    i = sizeof(list);
    if (i != 0) {
      while (i--) {
        // Skip those users in login limbo.
        if (!environment(list[i])) continue;
        if (me && !me->visible(list[i])) continue;
        if (remote && list[i]->query("env/invisibility")) continue;
        if (interactive(list[i]))
          ppl_cnt++;
        if (!list[i]->query("family"))
          str = sprintf("%s%12s%s%s\n",
            str,
            RANK_D->query_rank(list[i]),
            interactive(list[i]) ? (query_idle(list[i]) > 180 ? HIG "*" NOR : " ") : HIR "#" NOR,
            list[i]->short(1));
      }
    }

    str += "─────────────────────────────────────\n";
    str = sprintf("%s共有 %s 位玩家连线中，系统负担：%s\n", str,
      CHINESE_D->chinese_number(sizeof(users())),
      query_load_average() + "\n");


  } else if (opt_wiz) {

    i = sizeof(list);
    while (i--) {
      // Skip those users in login limbo.
      if (!environment(list[i])) continue;
      if (me && !me->visible(list[i])) continue;
      if (remote && list[i]->query("env/invisibility")) continue;

      if (interactive(list[i]))
        ppl_cnt++;
      if (!wizardp(list[i])) continue;
      str = sprintf("%s%12s%s%s\n",
        str,
        RANK_D->query_rank(list[i]),
        interactive(list[i]) ? (query_idle(list[i]) > 180 ? HIG "*" NOR : " ") : HIR "#" NOR,
        list[i]->short(1));
    }
    str += "─────────────────────────────────────\n";
    str = sprintf("%s共有 %d 位玩家连线中，系统负担：%s\n", str, ppl_cnt,
      query_load_average() + "\n");


  }

  else if (opt_topten) {
    for (i = 0; i < sizeof(list); i++) {
      for (j = i + 1; j < sizeof(list); j++)
        if (sort_exp_user(list[i], list[j]) > 0) {
          ob = list[i]; list[i] = list[j];
          list[j] = ob;
        }
      j = sizeof(list);
      while (j--) {
        // Skip those users in login limbo.
        if (!environment(list[j])) continue;
        if (!me->visible(list[j])) continue;
        if (opt_wiz && !wizardp(list[j])) continue;
        str = sprintf("%s%12s %s\n",
          str,
          RANK_D->query_rank(list[j]),
          list[j]->short(1));
      }

    }
    str += "─────────────────────────────────────\n";
    str = sprintf("%s共有 %s 个连线点，系统负担：%s\n", str,
      CHINESE_D->chinese_number(sizeof(users())),
      query_load_average() + "\n");

  }

  else {
    // a...b...c...d.........z 97...98...99 ....122
    list = ({});
    wizard_list = ({});
    temp_list = users();
    for (j = 122; j >= 97; j--) {
      for (i = 0; i < sizeof(temp_list); i++) {
        if (!environment(temp_list[i])) {
          temp_list -= ({ temp_list[i] });
          i--;
          continue;
        }
        if (me && !me->visible(temp_list[i])) {
          temp_list -= ({ temp_list[i] });
          i--;
          continue;
        }
        if (remote && temp_list[i]->query("env/invisibility")) {
          temp_list -= ({ temp_list[i] });
          i--;
          continue;
        }

        if (wizardp(temp_list[i])) {
          wizard_list += ({ temp_list[i] });
          temp_list -= ({ temp_list[i] });
          i--;
          continue;
        }
        if ((int)temp_list[i]->query("id")[0] == j) {

          list += ({ temp_list[i] });
          temp_list -= ({ temp_list[i] });
          i--;
          continue;
        }
        continue;
      }

    }
    j = sizeof(list);
    while (j--) {
      // Skip those users in login limbo.
      str = sprintf("%s " + (list[j]->query("gender") == "女性" ? HIM : NOR) + "%s" NOR + (wizardp(list[j]) ? HIR : "") + "(%-10s%s  %s" NOR,
        str,
        opt_id ? "" : list[j]->name(1), capitalize(list[j]->query("id")) + ")",
        space[0..(opt_id ? 12 : 12 - strlen(list[j]->name(1)))], (ppl_cnt % 3 == 2 ? "\n" : "")
      );
      ppl_cnt++;
    }
    if (wizard_list) {
      j = sizeof(wizard_list);
      while (j--) {
        // Skip those users in login limbo.
        str = sprintf("%s " + (wizard_list[j]->query("gender") == "女性" ? HIM : NOR) + "%s" NOR + (wizardp(wizard_list[j]) ? HIR : "") + "(%-10s%s  %s" NOR,
          str,
          opt_id ? "" : wizard_list[j]->name(1), capitalize(wizard_list[j]->query("id")) + ")",
          space[0..(opt_id ? 12 : 12 - strlen(wizard_list[j]->name(1)))], (ppl_cnt % 3 == 2 ? "\n" : "")
        );
        ppl_cnt++;
      }

    }


    list -= ({ 0 });
    {
      j = sizeof(list);
      str += "\n─────────────────────────────────────\n";
      str = sprintf("%s共有 %d 位玩家连线中，系统负担：%s\n", str, ppl_cnt,
        query_load_average() + "\n");
    }

    if (ppl_cnt % 3) str += "\n";
  }

  if (remote) return str;

  me->start_more(str);
  return 1;
}

int sort_user(object ob1, object ob2) {
  if (wizardp(ob1) && !wizardp(ob2)) return -1;

  if (wizardp(ob2) && !wizardp(ob1)) return 1;

  if (wizardp(ob1) && wizardp(ob2))
    return (int)SECURITY_D->get_wiz_level(ob2) - (int)SECURITY_D->get_wiz_level(ob1);

  return (int)ob2->query("mud_age") - (int)ob1->query("mud_age") + (int)ob2->query("age_modify") * 86400 - (int)ob1->query("age_modify") * 86400;
}
int sort_exp_user(object ob1, object ob2) {
  if (wizardp(ob1) && !wizardp(ob2)) return -1;

  if (wizardp(ob2) && !wizardp(ob1)) return 1;

  if (wizardp(ob1) && wizardp(ob2))
    return (int)SECURITY_D->get_wiz_level(ob2) - (int)SECURITY_D->get_wiz_level(ob1);

  return (int)ob2->query("combat_exp") - (int)ob1->query("combat_exp");
}
int help(object me) {
  write(@HELP
指令格式 : who [-l|-i|-w] 或
           who [-l|-i|-w] @mud_name

这个指令可以列出所有在线上的玩家及其等级。

-l        选项列出较长的讯息。
-i        只列出玩家的英文代号。
-w        只列出线上所有的巫师。
@mud_name 列出其它站点的玩家讯息，可用mudlist查看联线站点。

相关指令： finger, mudlist

HELP
    /*
指令格式 : who [-l|-i|-w|-t] 或
           who [-l|-i|-w|-t] @mud_name

这个指令可以列出所有在线上的玩家及其等级。

-l        选项列出较长的讯息。
-i        只列出玩家的英文代号。
-w        只列出线上所有的巫师。
-t        只列出线上所有的玩家实力对比。
@mud_name 列出其它站点的玩家讯息，可用mudlist查看联线站点。

相关指令： finger, mudlist
*/
  );
  return 1;
}
