#pragma save_binary
// time.c
#include <localtime.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  mixed *local;
  string str;
  local = localtime(time());

  str = sprintf("%s年%s月%s日%s时%s分",
    CHINESE_D->chinese_number(local[LT_YEAR]),
    CHINESE_D->chinese_number(local[LT_MON] + 1),
    CHINESE_D->chinese_number(local[LT_MDAY]),
    CHINESE_D->chinese_number(local[LT_HOUR]),
    CHINESE_D->chinese_number(local[LT_MIN]));
  write("现在是公元" + str + "。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: time

这个指令让你(□)知道现在的时辰。

HELP
  );
  return 1;
}
