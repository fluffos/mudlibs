// toptenadd.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string str, type;  //*astr,;
  //	int i;
  seteuid(geteuid(me));
  if (!arg || arg == "")
    return notify_fail("指令格式 : topten <排行类型>
           目前的排行类型有：gaoshou\n");
  if (arg == "gaoshou" || arg == "exp")
    type = "exp";
  /*  目前的排行类型有：gaoshou richman motou laoshou beiqing\n"); */

  /*
        else if(arg=="richman"||arg=="rich")
              type="rich";
        else if(arg=="motou"||arg=="pker")
              type="pker";
        else if(arg=="laoshou"||arg=="age")
              type="age";
        else if(arg=="beiqing"||arg=="killed")
              type="killed";
*/
  else {
    type = arg;
  }
  str = TOPTEN_D->topten_query(type);
  write(str + "\n");
  return 1;
}
