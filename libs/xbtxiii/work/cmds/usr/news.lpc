#pragma save_binary
// news.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string msg) {
  string *lines, file;

  if (!msg || msg == "") {
    msg = read_file("/doc/help/news");
    me->start_more(msg);
    return 1;
  }

  lines = explode(msg, "\n");
  if (wizardp(me)) {
    for (int i = 0; i < sizeof(lines); i++)
      lines[i] = "    " + lines[i];
    msg = implode(lines, "\n") + "\n";

    seteuid(ROOT_UID);
    file = read_file("/doc/help/news");
    write_file("/doc/help/news",
      ctime(time()) + " By " + capitalize(getuid(me)) + "\n\n" + msg + "\n" + file, 1);
    write("Ok.\n");
    return 1;
  }
}

int help(object me) {
  if (wizardp(me)) {
    write(@Help
指令格式: news <msg>

将所做过的改变记录在/doc/help/news 里
如果所要超过的一行, 可用 to news 来记录。
Help
    );
    return 1;
  }
}
