//rongg@xbtxii
#pragma save_binary
// ls.c
#include "/doc/help.h"
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int i,   k,l;
	string *dir,*cmds,str,emote,biaoji,*all_emote,*result;
	mixed *file;
        if(!arg)
	return notify_fail("demand <英文指令的关键字母>\n"
		           "或者demand <表情动词的关键字母> -semote\n"
		           "或者demand <函数的关键字母> -efun\n"
		           "详细帮助请 help demand\n");
        if (sscanf(arg, "%s %s", emote,biaoji)==2){
	    if(biaoji=="-efun"){
	        cmds=({});
	        dir=({"/doc/efuns/"}); //efuns目录
                for(l=0;l<sizeof(dir);l++){
	            file = get_dir(dir[l]);
	            if (sizeof(file)){
	                for(i=0;i<sizeof(file); i++){
		            k=sizeof( file[i]);
  	                    //tell_object(find_player("rongg"),file[i]+"\n");
  	                    if(strsrch(file[i],emote ) >=0){
  		                cmds+=({file[i]});
		                
		            }
		            else continue;
	                 }
	             }
	             else     continue;
	        }
                if(cmds==({})) return notify_fail("查询结果。雄霸天下II里面没有符合您所要查询函数名称。\n");
                else{
	              str="";
	              for(i=0;i<sizeof(cmds);i++){
	    	           str+=sprintf("%-16s",cmds[i]);
		           if(i%4==3) str+="\n";
	    	      }
	              if(i==1) str+=read_file(dir[0]+cmds[0]);
	        }
            
                str = replace_string(str, emote, HIC+emote+NOR);
                tell_object(me,"查询结果如下：含有字母<"+emote+">的函数有：\n");
                me->start_more(str);
                return 1;	
            
            }
	    else if(biaoji!="-semote")
	         return notify_fail("如果要列出所有emote。请使用semote命令查看。\n"
	                            "格式:demand <关键字母> -semote\n"
	                            "格式:demand <关键字母> -efun\n");
            else{
                result=({});
                all_emote = sort_array(EMOTE_D->query_all_emote(), 1);
                for(i=0;i<sizeof(all_emote); i++){
  	            if(strsrch(all_emote[i],emote ) >=0)
                        result+=({all_emote[i]});
                    else continue;
	        }
            }
            if(result==({})) return notify_fail("查询结果。雄霸天下II里面没有符合您所要查询表情动词。\n");
            else{
	        str="";
	        for(i=0;i<sizeof(result);i++){
	    	    str+=sprintf("%-16s",result[i]);
		    if(i%4==3) str+="\n";
	    	}
	    }
            str = replace_string(str, emote, HIC+emote+NOR);
            tell_object(me,"查询结果如下：含有字母<"+emote+">的表情动词有：\n");
            me->start_more(str);
            return 1;	
        }
        if(!wizardp(me))
	        dir=({"/cmds/usr/","/cmds/std/"}); // 玩家拥有的目录
        else    dir=({"/cmds/std/","/cmds/usr/","/cmds/imm/","/cmds/apr/","/cmds/wiz/",
	        "/cmds/arch/","/cmds/adm/"}); //巫师拥有的目录。
//	dir = resolve_path(me->query("cwd"), arg);
	cmds=({});
        for(l=0;l<sizeof(dir);l++){
//	if(!wizardp(me))
//	    if(!(dir[l]=="/cmds/usr"||dir[l]=="/cmds/std")) continue;
	    file = get_dir(dir[l]);
	    if (sizeof(file)){
	        for(i=0;i<sizeof(file); i++){
		    k=sizeof( file[i]);
  	            if(strsrch(file[i][0..k-3],arg ) >=0){
  		        cmds+=({file[i][0..k-3]});
		    }
		    else continue;
	        }
	    }
	    else     continue;
	}

        if(cmds==({})) return notify_fail("查询结果。雄霸天下II里面没有符合您所要查询的指令。\n");
	else 
	    {
	    str="";
	    for(i=0;i<sizeof(cmds);i++)
	    	{
	    	str+=sprintf("%-16s",cmds[i]);
		if(i%4==3) str+="\n";
	    	}
	    }
        str = replace_string(str, arg, HIC+arg+NOR);
        tell_object(me,"查询结果如下：含有字母<"+arg+">的命令有：\n");
        me->start_more(str);
	return 1;	
}

int help(object me)
{
	write(@HELP
指令格式: demand [<关键字(英文字母)>]
          或者demand <关键字母(拼音或者英文字母) -semote(后缀)>
          或者demand <函数关键字母> -efun(后缀)

列出这个泥巴里面所有有关的玩家命令或者有关的表情动词
 
□例:
'demand he' 会列出所有玩家的命令之中所有包含he两个连续
字母的命令. 'help',' ' ...........,''
或者 demand hi -semote
查询结果如下：含有字母<hi>的表情动词有：
annihilator     archi           chick           g_hi            
hi              hihi            shit            shiver          
think           
HELP	);
	return 1;
}
