// apply.c

#include "/doc/help.h"
#include  <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
        if(!environment(me)) return 0;
        if(me->is_busy() || me->is_fighting()) {
                tell_object(me,"你现在正忙着呢，恐怕没时间申请做巫师。\n");
        }else {
                me->set("old_place",file_name(environment(me)));
                message_vision(HIC"只见眼前一阵"HIR"火花"HIC"闪动.\n"NOR,me);   
                message_vision(HIR"空间一阵扭曲，$N被传送到了申请巫师室。\n"NOR,me);
                me->move("/d/wiz/apply_room.lpc");
                message_vision(HIR"空间一阵扭曲，$N被传送到了这里。\n"NOR,me);
                }
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : wizapply 

利用此一指令可直接到巫师申请室。
HELP
    );
    return 1;
}

