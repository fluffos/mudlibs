#pragma save_binary
// quit.c
 
#include <ansi.h>
inherit F_CLEAN_UP;


void create() 
{        seteuid(getuid());}
int main(object me, string arg)
{
        int i;
        object *inv;
/*
        if( me->is_busy() )
               return notify_fail("你正忙著做其他事！\n");
*/
	if( me->query_temp("vote_time")+45>time() )
		return notify_fail("你正被投票！45秒内禁止离开！\n");
	if( me->query_temp("pkt")+30>time())
		return notify_fail("你杀了玩家30秒内禁止离开！\n");
        if(environment(me)) {
        inv=all_inventory(environment(me));
        for(i=0;i<sizeof(inv);i++)
                inv[i]->remove_killer(me);
        me->remove_all_killer();
        }
            QUIT_D->leave_world(me);
            return 1;
}
int help(object me)
{
        write(@HELP
指令格式 : quit

当你(□)想暂时离开时, 可利用此一指令。
HELP
    );
    return 1;
}

