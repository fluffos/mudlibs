#pragma save_binary

// unfriend
#include <ansi.h>
inherit F_CLEAN_UP;


void create() {
  seteuid(getuid());
}

int main(object me, string arg) {
  string *name;
  int i;
  name = me->query("My_Friend");
  if (!arg) {
    if (sizeof(name) > 0) {
      tell_object(me, "现在你的好友有下列几个人\n");
      for (i = 0; i < sizeof(name); ++i) {
        tell_object(me, CYN " " + name[i] + "  " NOR);
        if (i > 4 && i % 5 == 0)
          tell_object(me, "\n");
      }

    } else
      return notify_fail("\n你目前并没有将任何人列入好友名单\n");
    return notify_fail("\n你要把谁从好友名单上面删除掉\n");
  }

  name -= ({ arg });
  tell_object(me, "你将 " + arg + " 从你的好友名单上面删除了。\n");
  tell_object(me, "\n OK\n");
  // 重新排列顺序
  me->set("My_Friend", name);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : unfriend <name>
可用此命令将某人从你的好友名单上删除掉
用friend <name>可以将某人列入你的好友名单.
HELP
  );
  return 1;
}
