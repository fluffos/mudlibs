#pragma save_binary
#include <ansi.h>
object check_pet(object player);
inherit F_CLEAN_UP;

// void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object pet, who;
  string msg, id1, id2, file1, file2, petname, petid;

  id1 = me->query("id");
  file1 = DATA_DIR + "pet/" + id1[0..0] + "/" + id1 + ".o";
  if (file_size(file1) == -1) {
    msg = "喂喂喂。你有自己的宠物吗？\n";
    tell_object(me, HIC + msg + NOR);
    return 1;
  }
  if (!arg || !find_player(arg) || !environment(find_player(arg))
    || me == find_player(arg)) {
    msg = "你要把你的宠物送给谁啊？\n";
    tell_object(me, HIC + msg + NOR);
    return 1;
  } else if (check_pet(me) != me) {
    who = find_player(arg);

    id2 = who->query("id");
    pet = check_pet(me);

    file2 = DATA_DIR + "pet/" + id2[0..0] + "/" + id2 + ".o";

    if (environment(who) != environment(me)) {
      msg = who->name() + "不在你身边，如何送给他？\n";
      tell_object(me, msg);
      return 1;
    }
    if (file_size(file2) != -1) {
      msg = "对方已经有了自己的宠物了。你不能够再送给他了。\n";
      tell_object(me, HIC + msg + NOR);
      return 1;
    } else {
      tell_object(me, file1 + "\n");
      msg = "$N眼睛含着泪水。对" + pet->name() + "说道：去找" + who->name() + "吧。他是你的新主人了\n"
        +pet->name() + "眼泪汪汪的望了$N几眼。一步一回头的朝着$n走去。\n";
      message_vision(HIC + msg + NOR, me, who);
      msg = me->name() + "把宠物交给你照顾了。你可要好好爱护它哦。\n";
      tell_object(who, msg);
      pet->set("owner", arg);

      petname = pet->name();
      petid = pet->query("id");
      petname = replace_string(petname, me->name(), who->name());
      petid = replace_string(petid, me->query("id"), who->query("id"));
      pet->set_name(petname, ({ petid }));
      pet->set_temp("protecting", who);
      pet->save();
      //            seteuid(getuid());
      rm(file1);  //实在是弄不明白为何这里总是无法删除这个文件
      pet->move(environment(me));  //更新action
      return 1;
    }
  } else {
    msg = "你的宠物不在你身边。\n";
    tell_object(me, HIC + msg + NOR);
    return 1;
  }
  return 1;
}


object check_pet(object player) {
  object *npc;
  int i;
  npc = all_inventory(environment(player));
  for (i = 0; i < sizeof(npc); i++) {
    if (!npc[i]) continue;
    if (!objectp(npc[i])) continue;
    if (userp(npc[i])) continue;
    if (!npc[i]->is_character()) continue;
    if (npc[i]->query("owner") == player->query("id")
      && npc[i]->query("race") == "野兽"
      && npc[i]->query_temp("protecting") == player)
      return npc[i];
  }
  return player;
}
