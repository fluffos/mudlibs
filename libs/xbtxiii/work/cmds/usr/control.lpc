#pragma save_binary
// 呼风唤雨
// 几个要求：要有一个桌子。祭奠用。
// 一根蜡烛。还要点燃。
// 装备桃木剑 。一个猪头。
#define SUNSHINE        0       // 晴
#define CLOUDY_SKY      1       // 阴
#define SPRINKLE        2       // 小雨
#define DING_ON         3       // 大雨
#define FOG             4       // 雾
#define FROST           5       // 霜
#define SNOW            6       // 雪
#define GLOW            7       // 霞

#define CLOUDLESS       0       // 无云
#define NORMAL          1       // 有云
#define CLOUDY          2       // 多云

#include <ansi.h>
inherit F_CLEAN_UP;
void outdoor_vision(string sWhere,string sWeather);
void create() 
{ seteuid(getuid());}

void outdoor_vision(string sWhere,string sWeather)
{
	object *usr,* usrs;
	int i;
	
	usrs=users();
	usr=({});
	for(i=0;i<sizeof(usrs);i++)
		if(objectp(usrs[i])&&environment(usrs[i])
				&&environment(usrs[i])->query("outdoors")==sWhere)
			usr+=({usrs[i]});
	message("outdoor:vision", sWeather  , usr);

}
int main(object me, string arg)
{

     object nature,room,head,weapon,candle,*obj;
     string msg,outdoors;
         int i,temp,skill;
if(!me->query("family/family_name")
     &&me->query("family/family_name")!="茅山派")
	 return notify_fail("非茅山派弟子，任意呼风唤雨会触怒上天的。\n");
if(me->query_temp("call_nature"))
	 return notify_fail("歇会儿吧，任意改变天气。老天会发怒的。\n");
	 skill=me->query_skill("necromancy",1);
if(me->query("gin")<=100||me->query("atman")<=500)
	  return notify_fail("呼风唤雨是一件特别伤神的事情。需要100精力、500灵力\n");
if(skill<=60)
	return notify_fail("茅山功夫都不到家，就想呼风唤雨？\n");
if( me->is_busy() )
      return notify_fail("你正忙著做其他事！\n");
if(!arg)
	  {
      this_object()->help(me);
      return 1;	
	  }
else if(stringp(arg))
	 {
	 if(!(arg=="rainstorm"||arg=="sunshine"||arg=="lightning"))
	 	return notify_fail("暂时只能改变三种天气。\n"
	 						"rainstorm   倾盆大雨\n"
	 						 "sunshine   阳光普照\n"
	 						 "lightning  电闪雷鸣\n");
	 weapon=me->query_temp("weapon");
	 if(!weapon||weapon->name()!="桃木剑")
	 	return notify_fail("呼风唤雨需要装备桃木剑。\n");
	 room=environment(me);
	 if(!room)
	 	return notify_fail("你不能够使用呼风唤雨之术。\n");
	 outdoors=room->query("outdoors");
	 if(!outdoors)
		return notify_fail("连天都看不见怎么呼风唤雨啊？\n");
     temp=0;
     obj=all_inventory(environment(me));
     for(i=0;i<sizeof(obj);i++)
     	{
     	if(obj[i]->query("祭奠桌子")) 
     		{
     		temp=1;	
     		break;
     		}
     	else continue;
     	}
     if(temp<1)
		return notify_fail("呼风唤雨需要一张祭奠的桌子。\n"
							"上面要有两根点燃的蜡烛。和一颗猪头。\n");
	 head=present("zhu tou",obj[i]);
	 if(!head)
	 	return notify_fail("呼风唤雨可是一件大事。需要献上一颗猪头以视对上天的尊敬。\n"); 
	  candle=present("candle",obj[i]);
	 if(!candle||!candle->query_temp("light"))
	 	return notify_fail("呼风唤雨可是一件大事。需要点燃蜡烛以视对上天的尊敬。\n"); 
     nature=find_object("/adm/daemons/natured");
     if(!nature)
			{
			msg="出现了一个你无法理解的异常错误。请通知巫师\n";
			tell_object(me,msg);
			return 1;
			}
    
	temp=0;
	skill=me->query_skill("spells");	
	if(random(2)>0)
		{
		if(random(skill)>=60)
			temp=1; // 天气改变成功。
		}

	msg=HIY"$N挥动手中的"+weapon->name()+"。口中念念有词：\n"
	 		"\n天地无极\n"
	 		"乾坤借法 \n"
	 		"太上老君急急如率令\n"NOR;
    message_vision(msg,me);

	if(temp<=0)
		{
		msg=HIR"$N念完咒雨。许久。没有发生任何事情。\n"NOR;
		message_vision(msg,me);
		me->add("gin",-100);
		me->add("atman",-500);
		return 1;
		}
	switch(arg)
		{
		case "rainstorm": // 大雨
             nature->set( "mWeather/"  + outdoors + "/weather", DING_ON );
             nature->set( "mWeather/"  + outdoors + "/cloud", CLOUDY );
             nature->set( "mWeather/"  + outdoors + "/wind", 3 ); 
	 		"$N念完。举起手中的"+weapon->name()+"大喝一声：倾盆大雨～　～　～　\n";
		     break;
		case "sunshine": // 晴天
             nature->set( "mWeather/"  + outdoors + "/weather", SUNSHINE );
             nature->set( "mWeather/"  + outdoors + "/cloud", CLOUDLESS );
             nature->set( "mWeather/"  + outdoors + "/wind", 0 ); 
	 		"$N念完。举起手中的"+weapon->name()+"大喝一声：阳光普照～　～　～　\n";
		     break;
		case "lightning": // 打雷
			 nature->start_thunder(outdoors); // 开始打雷了。
	 		"$N念完。举起手中的"+weapon->name()+"大喝一声：电闪雷鸣～　～　～　\n";
			 break;
		default:
			 msg="没有这种天气。\n";
		     tell_object(me,msg);
			 return 1;
		}

     message_vision(msg,me);
	 msg=HIY"一道青光冲天而起，天空好象开始起变化了。。。\n"NOR;
	 outdoor_vision(outdoors,msg);
	 me->set_temp("call_nature",1);
     me->set("atman",0);
     call_out("remove_temp",600,me);
     }
else
     {
     msg="没有这种天气。\n";
     tell_object(me,msg);
     }
	return 1;
}


int remove_temp(object me)
{
	me->delete_temp("call_nature");	
}
int help(object me)
{
    tell_object(me,"呼风唤雨，指令格式如下：\n"
           "control <类型> \n"
           "可以改变的天气类型有三种:\n"
           "rainstorm 倾盆大雨\n"
           "sunshine  大晴天\n"
           "lightning  打雷\n"
           "天变之前要找齐几种东西。\n"
		   "一张桌子。祭奠用。两根蜡烛。还要点燃。\n"
		   " 装备桃木剑。一个猪头。\n"
		   "具体做法是把蜡烛点燃。放在桌子上面。\n"
		   "装备桃木剑。把猪头也摆在桌子上面。\n");
    return 1;
}

