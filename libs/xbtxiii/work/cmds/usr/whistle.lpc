#include <ansi.h>
inherit F_CLEAN_UP;
#define DEATH_PERIOD 1200
int main(object me, string arg) {
  object pet;
  object *ob_list;
  int i;
  string id, name;
  string file;
  id = me->query("id");
  if (me->query("sen") <= 50) return notify_fail("你现在已经连吹个口哨的力气都没有了。。\n");
  if (me->is_busy()) return notify_fail("你现在不可以吹口哨。\n");
  if (me->is_ghost()) return notify_fail("你现在不可以吹口哨。\n");
  write("你轻轻地吹了声口哨．．．\n");
  if (environment(me)->query("NONPC")) return 1;
  file = DATA_DIR + "pet/" + id[0..0] + "/" + id + ".o";
  if (file_size(file) == -1)
    return notify_fail("你似乎没有养什么宠物。叫唤什么？\n");
  ob_list = children("/obj/pet");
  for (i = 0; i < sizeof(ob_list); i++) {

    if (!environment(ob_list[i])) continue;
    if (ob_list[i]->query("owner") == me->query("id")) {
      pet = ob_list[i];
      break;
    }
  }
  if (!pet)  //&& file_size(file) > 0 )
  {
    seteuid(getuid());
    pet = new("/obj/pet");
    pet->set("owner", me->query("id"));
    if (!pet->restore())
      return notify_fail("你的宠物的档案出了问题，请通知巫师处理。\n");
    id = pet->query("id");
    name = pet->query("name");
    pet->set("id", id);
    pet->set_name(name, ({ id }));
    pet->set_temp("protecting", me);
    pet->setup();
    if (pet->query("deathstamp")) {
      tell_object(me, "你的宠物已经死了，去找人给它还魂吧。\n");
      destruct(pet);
      return 1;
    }
  }
  me->add("sen", -50);
  pet->delete("actions");  //实在是不知道什么错误。是和actions有关的。
  pet->setup();  //只好先删除它，然后在setup()一次。
  if (pet && environment(pet) && environment(pet) != environment(me)
    //       && time() - (int)pet->query("deathstamp") > 1200
    && !pet->is_fighting()) {
    pet->move(environment(me));
    pet->reset_action();
    message_vision("$N不知从哪里窜到$n面前．\n", pet, me);
    // let pet be our protector
    if (me->is_fighting()) {
      object *enemy;
      enemy = me->query_enemy();
      i = sizeof(enemy);
      while (i--) {
        if (enemy[i] && living(enemy[i])) {
          pet->kill_ob(enemy[i]);
          if (userp(enemy[i])) enemy[i]->fight_ob(pet);
          else enemy[i]->kill_ob(pet);
        }
      }
      me->remove_all_killer();
    }
    pet->set_leader(me);
  } else if (pet && environment(pet)) {
    pet->save();
    message_vision("$N一闪就不见了。\n", pet);
    destruct(pet);
  } else if (pet && !environment(pet)) {
    pet->move(environment(me));
    pet->reset_action();
    message_vision("$N不知从哪里窜到$n面前．\n", pet, me);
    // let pet be our protector
    if (me->is_fighting()) {
      object *enemy;
      enemy = me->query_enemy();
      i = sizeof(enemy);
      while (i--) {
        if (enemy[i] && living(enemy[i])) {
          pet->kill_ob(enemy[i]);
          if (userp(enemy[i])) enemy[i]->fight_ob(pet);
          else enemy[i]->kill_ob(pet);
        }
      }
      me->remove_all_killer();
    }
    pet->add("sen", -10);
    pet->set_leader(me);
  }
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : whistle <宠物名>

详解请看help pet
HELP
  );
  return 1;
}
