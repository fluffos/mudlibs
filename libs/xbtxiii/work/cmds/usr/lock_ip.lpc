#pragma save_binary
 
 
 
// lock_ip
#include <ansi.h>
inherit F_CLEAN_UP;


void create() 
{    
    seteuid(getuid());
}

int main(object me, string arg)
{


        if( me->is_busy() )
                return notify_fail("你正忙著做其他事！\n");
		me->set("MY_ONLY_IP",query_ip_number(me));
		tell_object(me,"你对你的人物限制了连线的IP。从此以后。你的这个人物\n"
						"只能够从这个IP("+query_ip_number(me)+")连线进入。\n"
						"\n如果你想解除这个限制。请用unlock_ip命令解除限制。\n");
		tell_object(me,"\n OK\n");
	
            return 1;
}
int help(object me)
{
        write(@HELP
指令格式 : lock_ip
你如果不想别人窃取到你的密码，可以用这个命令
锁定你的IP。锁定之后，这个人物只有从当前这个
IP才可以进入泥巴。如果你想解除锁定，请用unlock_ip
解除限制。
(此举的作用是即使别人窃取了你的密码，也无法进入泥巴)
HELP
    );
    return 1;
}

