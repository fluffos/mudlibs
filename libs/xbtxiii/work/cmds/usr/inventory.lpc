#pragma save_binary
//inventory.c
// update by fuyo@xajh2  98-11-16 12:27 物品分类

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  mixed str;

  if (wizardp(me) && arg) {
    ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) ob = present(arg, environment(me));
  }

  if (!ob) ob = me;

  if (ob == me && me->is_ghost())
    return notify_fail("这些身外之物，生不带来，死不带区，还是算了吧！\n");
  str = "/cmds/std/look"->classify_object(ob);

  //      inv = all_inventory(ob);
  if (!stringp(str)) {
    write((ob == me) ? "目前你身上没有任何东西。\n"
      : ob->name() + "身上没有携带任何东西。\n");
    return 1;
  }
  printf("%s身上带著下列这些东西(负重 %d%%)：\n%s",
    (ob == me) ? "你" : ob->name(),
    (int)ob->query_encumbrance() * 100 / (int)ob->query_max_encumbrance(),
    str);

  return 1;
}

string inventory_desc(object ob) {
  return sprintf("%s%s",
    ob->query("equipped") ? HIC "□" NOR : "  ",
    ob->short()
  );
}

int help(object me) {
  write(@HELP
指令格式: inventory
 
可列出你(你)目前身上所携带的所有物品。
 
注 : 此指令可以 " i " 代替。
 
HELP
  );
  return 1;
}
