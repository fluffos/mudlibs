#pragma save_binary
// friend
#include <ansi.h>
inherit F_CLEAN_UP;


void create() 
{    
    seteuid(getuid());
}

int main(object me, string arg)
{
	int i;
	string *name;
	name = me->query("My_Friend");
	if(!name) name=({});
	if(!arg)
	    {
	    tell_object(me,"现在你的好友名单如下:\n");
	    for(i=0;i<sizeof(name);++i)
	        {
		tell_object(me,CYN" "+name[i]+"  "NOR);
		if(i>4&&i%5==0)
		tell_object(me,"\n");
		}
		return notify_fail("你想设置谁为好友？\n");		
	    }
	if((i=sizeof(name))>=10)
		return notify_fail("你设置的好友名单已经满了。请删除一些\n");	
	if(member_array(arg,name)!=-1)
		return notify_fail("你已经把"+arg+"列入好友名单了\n");
		
	name+=({arg});
	me->set("My_Friend",name);
	tell_object(me,"现在你的好友名单如下:");
	for(i=0;i<sizeof(name);++i)
	        {
		tell_object(me,CYN" "+name[i]+"  "NOR);
		if(i%5==0)
		tell_object(me,"\n");
		}
	tell_object(me,"\n你设置了 "+arg+" 为你的好友。以后当你进站时会对他发出通知\n"
			"如果你不想再设置他为好友，那么可以用unfriend <name>解除好友。\n");
	tell_object(me,"\n OK\n");
        return 1;
}
int help(object me)
{
        write(@HELP
指令格式 : friend <name>
可用此命令设置泥巴的好友名单。当你上站的时候会通知他们。
最多可以设10人。
(注意。如果玩家设巫师为好友会自动受到监视。同时会使巫师对你的信任度降低)
HELP
    );
    return 1;
}

