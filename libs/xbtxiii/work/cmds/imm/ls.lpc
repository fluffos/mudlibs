//dir.c

#include <ansi.h>
#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        int i, j, w, col,*dis,d,abs_flag,tlt;
        string dir,dir1,str;
        mixed *file;
        seteuid(geteuid(this_player(1)));
        abs_flag=0;
        dir = resolve_path(me->query("cwd"), arg);
        arg=dir;

        if( file_size(dir)==-2 && dir[strlen(dir)-1] != '/' ) 
                dir += "/";


        file = get_dir(dir, -1);
        if( !sizeof(file) )
        {
                if (file_size(dir) == -2) 
                        return notify_fail("目录是空的。\n");
                else
                        return notify_fail("没有这个目录。\n");
        }
        i = sizeof(file);
        w = 0;
        d=0;
        dis=allocate(i);
        while(i--) {
                dir1=file[i][0];
                dir1=(arg[strlen(arg)-1]=='/')?(arg+dir1):(arg+"/"+dir1);
                dir1=(dir1[0]=='/')?dir1:"/"+dir1;
                if(file_size(dir1)==-1)
                        dis[d++]=i+1;
                file[i][0] =(file[i][1]==-2)?file[i][0]+"/":file[i][0];
                if (strlen(file[i][0])>w) w = strlen(file[i][0]) + 1;
        }
        d=0;
        str = "\n"+BGRN+HIW+"目录：" + dir + NOR + "\n";
        col = 70 / (w+6);
        d=0;
        if (sizeof(file))
                for(i=0, j = sizeof(file); i<j; i++)
                {
                        d++;
                        tlt = strlen(file[i][0]);
                        if(member_array(i+1,dis)==-1)
                                str += sprintf("%4d %-*s%s", file[i][1]/1024 + 1, w+16,
                                        file[i][0] =(file[i][1]==-2)?HIG+file[i][0]+NOR:(((file[i][0])[tlt-2..tlt-1] ==".lpc")? HIB+file[i][0]+NOR : (((file[i][0])[tlt-2..tlt-1] ==".h")? HIC+file[i][0]+NOR : HIY+ file[i][0] +NOR))+ (find_object(dir + file[i][0])? "*":" "),
                                        ((i+1)%col)?"  ":"\n");
                        else
                        {       d--;
                                str += sprintf("%4d "HIR"%-*s%s"NOR, file[i][1]/1024 + 1, w,
                                        file[i][0] + (find_object(dir + file[i][0])? "*":" "),
                                        ((i+1)%col)?"  ":"\n");
                                
                        }
                }
        else str += "没有任何档案。\n";
        str += "\n";
        me->start_more(str);
        return 1;       
}

int help(object me)
{
        write(@HELP
指令格式: ls [<路径名>]
列出目录下所有的子目录及档案, 如果没有指定目录, 则列出所在目录
的内容，所列出的档案中前面标示 * 号的是已经载入的物件。
红色目录为无权限读取的目录，绿色为可读取目录。
HELP
        );
        return 1;
}

