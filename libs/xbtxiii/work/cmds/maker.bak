int do_list(string arg)
{
        int mark_loaded;
        int i, j, w, col;
        string dir;
        object me;
        mixed *file;

        me=this_player();
        dir = "/d/player/"+me->query("id")+"/";
        file = get_dir(dir, -1);
        if( !sizeof(file) )
        {if (file_size(dir) != -2) 
              mkdir(dir);
              return notify_fail("目录是空的。\n");
        }

        i = sizeof(file);
        w = 0;
        while(i--) {
                if (strlen(file[i][0])>w) w = strlen(file[i][0]) + 1;
        }
        write("目录：" + dir + "\n");
        if (sizeof(file))
                for(i=0,j=0; i< sizeof(file); i++)
                {
                        if( file[i][0][0..0] == "." ) continue;
                        j++;
                        printf("%4d \t%4d\t%s\n",j, file[i][1]/1024 + 1,
                                file[i][0] + "\t\t\t"+(dir+file[i][0])->query("short") );
                }
        else write("    没有任何档案。\n");
        write("\n");
        
        return 1;       

}
int do_goto(string arg)
{
        string dir,err;
        dir = "/d/player/"+this_player()->query("id")+"/";
        if(file_size(dir+arg+".c")<=0) return notify_fail("你要到那里？\n");
        if(err=catch(load_object(dir+arg)))
            return notify_fail("房间出错，请联系巫师.\n");
        this_player()->move(dir+arg);
        return 1;
}
int do_rset(string arg)
{
        string prop, str,sss;
        mixed data;

        if( !arg || sscanf(arg, "%s %s", prop, str)!=2 )
                return notify_fail("指令格式：rset <房间属性> <属性内容>\n");

        if( sscanf(str, "%d", data)!=1 )
                data = str;

        if(sscanf(file_name(environment(this_player() ) ), "/d/player/"+this_player()->query("id")+"/%s",sss)!=1)
            return notify_fail("");
        environment(this_player())->set(prop, str);
        write("Ok.\n");
        return 1;

}

int do_connect(string arg)
{
        mapping exits;
        string dir, file,sss;

        if( !arg )
                return notify_fail("指令格式：connect <方向> [玩家名] <房间档名>\n");
        if( sscanf(arg, "%s %s %s", dir,sss, file)!=3 )
            {   sss=this_player()->query("id");
                if( !arg || sscanf(arg, "%s %s", dir, file)!=2 )
                        return notify_fail("指令格式：connect <方向> [玩家名] <房间档名>\n");
            }
        file = resolve_path("/d/player/"+sss+"/", file);
        if(sscanf(file_name(environment(this_player() ) ), "/d/player/"+this_player()->query("id")+"/%s",sss)!=1)
            return notify_fail("你无权改动这个房间\n");
        exits = environment(this_player())->query("exits");
        if( mapp(exits) )
                exits[dir] = file;
        else
                environment(this_player())->set("exits", ([ dir: file ]) );
        write("Ok.\n");
        return 1;
}

int do_saveroom(string arg)
{
        object env;
        string str, *name, file;
        mapping prop;
        int i;

        env = environment(this_player());
        if(sscanf(file_name(env), "/d/player/"+this_player()->query("id")+"/%s",file)!=1)
            return notify_fail("你无权改动这个房间\n");
        file = file_name(env) + ".c";
        str = "// Room: " + file + @ROOM_CODE


inherit ROOM;

void create()
{
ROOM_CODE
        ;
        str += sprintf("\tset(\"short\", %O);\n", env->query("short") );
        str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", env->query("long") );
        prop = env->query_entire_dbase();
        name = keys(prop);
        for(i=0; i<sizeof(name); i++) {
                if( member_array(name[i], special_props)!=-1 ) continue;
                str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]] );
        }
        str += "\n\tsetup();\n\treplace_program(ROOM);\n}\n";

        // Replace current directory with __DIR__ macro to make relocatable code.
        i = strlen(file)-1;
        while( (i > 0) && (file[i]!='/')) i--;
        if( i>0 ) {
                write("目前目录：" + file[0..i] + " 以 __DIR__ 取代。\n");
                str = replace_string(str, "\"" + file[0..i], "__DIR__\"");
        }

        if( file_size(file)!=-1 ) {
                write("档案 " + file + " 已存在，要删除旧档吗？[y/n]");
                input_to("save_room_file", file, str);
                return 1;
        }

        return save_room_file("y", file, str);
}

int save_room_file(string yn, string file, string str)
{
        if( strlen(yn)<1 || yn[0]!='y' ) return 1;

        rm(file);
        write("存档 " + file + "....");
        if( write_file(file, str) ) {
                write("Ok.\n");
                return 1;
        } else
                return notify_fail("你没有写入这个档案(" + file + ")的权利。\n");
}

void owner_is_killed() { destruct(this_object()); }
int do_rm(string arg)
{
        string file;

        if(!arg) return notify_fail("格式：rm <文件名>\n");
        file = "/d/player/"+this_player()->query("id")+"/"+arg + ".c";
                if( file_size(file)<0 ) return notify_fail("文件不存在！\n");
        if(!rm(file)) 
        return notify_fail("你无权删除该文件。\n");
        printf("OK!\n");
        return 1;
}
int room_limit(object me)
{
        int i,flag;
        flag=sizeof(get_dir("/d/player/"+me->query("id")+"/"))-1;
        if(me->query("age")-10>flag) return 0;
        return 1;
}
