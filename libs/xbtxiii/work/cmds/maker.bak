#define RMK_VERSION "(v1.1)"
#define ROOM_LIMIT room_limit(this_player())

inherit ITEM;
inherit F_AUTOLOAD;

string *special_props = ({
        "short", "long" });

int save_room_file(string yn, string file, string str);
int room_limit(object me);

void create()
{
        set_name("房间编辑器" + RMK_VERSION, ({ "roommaker", "maker" }) );
        set_weight(100);
        set("unit", "个" );
        set("long", @LONG
这是一个用来「快速」制造房间
你可以使用以下几个指令：

mkroom <房间档名>

    造出一个「空」房间，之後你可以 goto 到这个房间用 rset 设定房间的
    叙述或属性。
goto <房间名>
    进入房间

rm <房间名>
    删除房间
rset <房间属性> <属性内容>

    设定你目前所在房间的属性，如 short，long 等。

connect <方向> [玩家名] <房间档名>

    将你目前所在的房间连接一个出口到另一个房间(可以是另一个玩家的房间)。

saveroom

    将你目前所在的房间存档。
LONG
        );
}

int query_autoload() { return 1; }

void init()
{
        if( environment() ) {
                seteuid(getuid());
                add_action("do_mkroom", "mkroom");
                add_action("do_goto", "goto");
                add_action("do_list", "ls");
                add_action("do_rm", "rm");
                add_action("do_rset", "rset");
                add_action("do_connect", "connect");
                add_action("do_saveroom", "saveroom");
        }
}

int do_mkroom(string arg)
{
        string file, dir, code;
        object me;

        if( !arg ) return notify_fail("指令格式：mkroom <房间档名> [<方向>]\n");
        if( sscanf(arg, "%s %s", file, dir)!=2 )
                file = arg;
        if(strsrch(arg, "/")>=0) return notify_fail("你无权写这个目录。\n");
        me=this_player();
        file = "/d/player/"+me->query("id")+"/"+file + ".c";
        if(ROOM_LIMIT) return notify_fail("你只能有这么多房间。\n");
        if(file_size("/d/player")!=-2) mkdir("/d/player");
        if(file_size("/d/player/"+me->query("id"))!=-2) mkdir("/d/player"+me->query("id"));
        if( file_size(file)!=-1 )
                return notify_fail("档案 " + file + " 已经存在了。\n");
        if( !write_file(file, @ROOM_CODE
