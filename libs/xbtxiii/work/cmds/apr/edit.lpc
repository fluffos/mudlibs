// edit.c

#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string file)
{
	if( !file ) return notify_fail("指令格式：edit <档名>\n");

	if( in_edit(me) ) return notify_fail("你已经在使用编辑器了。\n");
if( me!=this_player(1) ) return 0;

	seteuid(geteuid(me));
	ed(resolve_path(me->query("cwd"), file));
//by apollo, 
        log_file("nosave/WIZ_EDIT",
        sprintf("%s edit %s on %s\n",
      me->name(1),resolve_path(me->query("cwd"), file),ctime(time()) ));
	return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : edit <档名>, edit here

利用此一指令可直接在线上编辑档案。
HELP
    );
    return 1;
}
