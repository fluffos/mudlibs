#pragma save_binary
 // killworld.c

inherit F_CLEAN_UP;


void create()
{
 seteuid(getuid());
}


private int kill_world(string arg);

int main(object me, string arg)
{
string status;

 if( wizhood(me)!="(admin)")
   return notify_fail("你没有权力使用这个指令。\n");
 if(!arg) return 
     notify_fail("指令格式delnpc really\n");
        return kill_world(arg);
}

private int kill_world(string arg)
{
    int h, i, j, k,flag;
    string *dir, *ppls, name;
    string *path = ({"npc/",}) ;    string *left = 
     ({"mudplayer","evilgod","rongg","wander","tony","rainheart"});
    seteuid(getuid());
    if(arg!="really") return 1;
    for(h=0;h<sizeof(path);h++)
             {
            ppls = get_dir(DATA_DIR + path[h] );
            for(j=0; j<sizeof(ppls); j++) {
                flag =0;
                sscanf(ppls[j],"%s.o",name);
                for(k=0;k<sizeof(left);k++)
                    if(name==left[k]) flag++;
                if(flag) continue;
                if(!rm(DATA_DIR+path[h]+ppls[j])) 
                    write(ppls[j] +"is wrong\n");
                    }
            }
    write("整个NPC的世界都你毁灭了.\n");
    return 1;
}

int help(object me)
{
write(@HELP
指令格式  delnpc really

这个命令很严重
会完全删除NPC储存的资料。三思而行啊!

HELP
);
return 1;
}

