#pragma save_binary

// summon command..

inherit F_CLEAN_UP;

int main(object me, string str) {
  object ob;
  if (!str) return notify_fail("<Syntax>: Summon <player id>\n");
  ob = LOGIN_D->find_body(str);
  if (!ob) return notify_fail("咦... 有这个人吗?\n");
  // moving
  if (wiz_level(me) <= wiz_level(ob))
    return notify_fail("你没有抓他的权利!\n");
  ob->move(environment(me));
  tell_object(me, "你把" + (string)ob->query("name") + "抓到你的面前.\n");
  tell_object(ob, ".... 醒来时发现是" + (string)me->query("name") +
    "把你弄过来的.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : summon <某人>

此指令可让你(□)将某人抓到你面前。
HELP
  );
  return 1;
}
