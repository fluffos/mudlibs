#pragma save_binary
// force.c 1998.9.1. rongg

#include <command.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
        string cmd,who;

        if( me != this_player(1) ) return 0;
if(arg&&sscanf(arg, "%s to %s",who,cmd)==2)
        {
        ob=present(who,environment(me));
        if(ob)       
              {
              if(ob==me)
                       write("强迫自己？？？你有强迫症啊？\n",me);
              else
                       {
                       seteuid(ROOT_UID);
                       ob->force_me(cmd);
                       seteuid(getuid());
                       }
              }
        else if(!ob)
              {
              ob=find_living(who);
              if(ob)
                       {
                       seteuid(ROOT_UID);
                       ob->force_me(cmd);
                       seteuid(getuid());
                       } 
              else 
                       write("这个生物不存在。\n",me);
              }                
        }
else
        write("force sb to do something。\n");

	return 1;
}
int help (object me)
{
        write(@HELP
指令格式: force sb to do something
 
天神的忠告：不要随便用这个命令捉弄别人，若上麻烦不好办！切记！切记！
HELP);
        return 1;
}
 
