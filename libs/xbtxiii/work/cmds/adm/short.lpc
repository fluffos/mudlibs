//用法和ls类似
// ls /d/就会将整个/d/目录下面所有子目录的房间描述统一成28个汉字一行.
// 这个命令只能ls /d/ /u/ /open/，不允许更换其他目录，我已经测试过了.
//ls /d/硬盘一阵狂闪,然后屏幕列出了一大堆房间的编译错误(该房间没有通过编译
//   或者有编译警告)信息,最后将整个/d/下面子目录的房间都统一成了28个汉字一行.
//   通过玩家几天的查找,并没有发现有房间出错,不过几个特定的房间的描述被打乱了
//   因为该房间使用了比较特殊的排版方法.比如
//    剑    刀
//    试    横
//    天    九
//    下    州
//  类似这样的房间我也无能为力,只好手动改回来 

#pragma save_binary
// ls.c
#include <ansi.h>
#include "/doc/help.h"


inherit F_CLEAN_UP;

string format_room_long(string roomlong1);
int save_room_long(string roomlong,string file);
string get_room_long(string file);
int is_punctuation(string str);
int main(object me, string arg)
{

	int j,num,k,i;
	string dir,roomlong;//alldir是/d/目录下面一层的所有目录
	

	mixed *file,*d_dir;

        roomlong="";
        seteuid(getuid());
        num=0;
        if(!arg||arg=="") return notify_fail("更换哪个目录?\n");
	dir = resolve_path(me->query("cwd"), arg);
	if( file_size(dir)==-2 && dir[strlen(dir)-1] != '/' ) dir += "/";
	
	if(dir[0..2]!="/d/"&&dir[0..2]!="/u/"&&dir[0..5]!="/open/")
		return notify_fail("这个命令只允许更改/d/ /u/ /open/目录下面的房间描述\n");

	d_dir=get_dir(dir);
	
	for(k=0;k<sizeof(d_dir);k++)
	{
		
		
		if(file_size(dir+d_dir[k])!=-2) continue;//dir_dir[k]是个文件
		
		file = get_dir(dir+d_dir[k]+"/", -1);
		if(!sizeof(file)) continue;
		
		write("目录：" +dir+d_dir[k]+"/" + "\n");// 列出/d/目录下所有的目录
		//write(dir+d_dir[k]+"\n");
		//return 1;
		if (sizeof(file))
		{
			for(i=0, j = sizeof(file); i<j; i++)
			{
				if( file[i][0][0..0] == "." ) continue;
				//col=sizeof(file[i][0]);
				if(  file[i][1]>0&& sscanf(dir+d_dir[k]+"/"+file[i][0], "%*s.lpc")   )
				{
            			//	write("file is "+dir+file[i][0]+"\n");
            				roomlong=get_room_long(dir+d_dir[k]+"/"+file[i][0]);
            				if(roomlong=="") continue;
            				roomlong=format_room_long(roomlong);//获取整理过的long
            				save_room_long(roomlong,dir+d_dir[k]+"/"+file[i][0]);//重新写入源文件
            				num++;
            			
				//return 1;
            			}
			write(dir+d_dir[k]+"/"+file[i][0]+"读入\n");
			reset_eval_cost();
			}
	
		}
		else write("    没有任何档案。\n");



	}

	write(num+"个房间被替换掉\n");
	return 1;	
}


string get_room_long(string file)
{
	
        string roomlong,err;
	object room;
	err = catch(call_other(file, "???"));
        if (err) return "";
	//call_other(file, "???");
        room = find_object(file+".lpc");
	if(!room) return "";
	//room=load_object(file);//测试中这里还有问题,碰到一个错误的房间可能会停止
	//我还没有想到别的办法
	if(!room->is_room()) return "";
	roomlong=room->query("long");
	destruct(room);
	if(!roomlong) return "";
	return roomlong;

}


string format_room_long(string roomlong1)
{



        int i,j,hang,x,y,z,aa,last;//换行标记
        string roomlong2;
        
	roomlong1=replace_string(roomlong1,"\n","");
	roomlong1=replace_string(roomlong1," ","");
	roomlong1=replace_string(roomlong1,"\"","");
	//roomlong1=replace_string(roomlong1,"LONG","");
	//roomlong1=replace_string(roomlong1,"@","");
	//roomlong1=replace_string(roomlong1,"\"","");
	roomlong1=replace_string(roomlong1,"\t","");
	//roomlong1=replace_string(roomlong1,"\\O","");
	//roomlong1=replace_string(roomlong1,"\\r","");
	
	roomlong2="";
	
	if(!roomlong1) return "";
	x=0;y=0;i=sizeof(roomlong1);
	hang=i/56;
	z=0;
	z=i%56;
	if(z!=0) hang++;
	
	last=0;
	roomlong2="\n"+roomlong2;
	for(x=0;x<hang;x++)
	{
		aa=0;
		if(last>i-1) break;//防止last超出字符范围
		if(hang-x==1)//最后一行 
		{
			roomlong2=roomlong2+"\""+roomlong1[last..i-1]+"\\n"+"\""+"\n";
			break;
		}
		else{

			for(j=0;j<56;j++)
			{
				if(last+j>i-1) break;
				if(roomlong1[last+j]<=160)//不是中文字
					aa++;
				else continue;
			}
			if(aa%2!=0) //这一行有几个非中文字,要做特殊处理,行的最大数字加1.
			{

				roomlong2=roomlong2+"\""+roomlong1[last..last+54];//这一行的最大字数加一
				last=last+55;
				if( (i-1)-last>=1 )//下一行至少还有2个字符的位置,判断下面一行的开头是不是标点符号
				{
				
					if(is_punctuation(roomlong1[last..last+1])!=-1)//判断是否中文标点符号
					{
				
				
						roomlong2=roomlong2+roomlong1[last..last+1]+"\\n"+"\""+"\n";
						last+=2;
						continue;
					}
					if(is_punctuation(roomlong1[last..last])!=-1)//英文标点符号
					{
				
						roomlong2=roomlong2+roomlong1[last..last]+"\\n"+"\""+"\n";
						last++;
						continue;
					}
					roomlong2=roomlong2+"\\n"+"\""+"\n";
					continue;
				}
				else if( (i-1)-last>=0)//下一行至少还有一个字符的位置,判断它的开头是不是英文标点
				{
					if(  is_punctuation(roomlong1[last..last])!=-1  )
					{
				
						roomlong2=roomlong2+roomlong1[last..last]+"\\n"+"\""+"\n";
						last++;
						continue;
					}
					roomlong2=roomlong2+"\\n"+"\""+"\n";
					continue;	
				}
				//roomlong2=roomlong2+"\\n"+"\""+"\n";
				
			}
			else//这一行40个全部都是中文
			{
				//write_file("/open/rongg/hang.txt",roomlong1[last..last+79]+"\n",0);
				roomlong2=roomlong2+"\""+roomlong1[last..last+55];
				last=last+56;
				//write("last is\t"+last+"\t roomlong1[last..last]     is \t"+roomlong1[last..last]+"\n");
				if( (i-1)-last>=1 )//下一行至少还有2个字符的位置,判断下面一行的开头是不是标点符号
				{
					if(is_punctuation(roomlong1[last..last+1])!=-1)//中文标点符号
					{  
						write("roomlong1[last..last+1]     is     \t"+roomlong1[last..last+1]+"\n");
						roomlong2=roomlong2+roomlong1[last..last+1]+"\\n"+"\""+"\n";
						last+=2;
						continue;
					}
					if(is_punctuation(roomlong1[last..last])!=-1)//英文标点符号
					{
						write("\t roomlong1[last..last] is \t"+roomlong1[last..last]+"\n");
						roomlong2=roomlong2+roomlong1[last..last]+"\\n"+"\""+"\n";
						last++;
						continue;
					}
					roomlong2=roomlong2+"\\n"+"\""+"\n";
					continue;	
				}
				else if( (i-1)-last>=0)//下一行至少还有一个字符的位置,判断它的开头是不是英文标点
				{
					if(  is_punctuation(roomlong1[last..last])!=-1  )
					{
						roomlong2=roomlong2+roomlong1[last..last]+"\\n"+"\""+"\n";
						last++;
						continue;
					}
					roomlong2=roomlong2+"\\n"+"\""+"\n";
					continue;	
				}
				roomlong2=roomlong2+"\\n"+"\""+"\n";
				
			}

		}
	}
	return roomlong2;
	
}
int save_room_long(string roomlong,string file)
{
	

        string file_str,all,str1;
        int i,j,k;
	//file+=".lpc";
        if(!roomlong||roomlong=="") return 0;
        roomlong="set(\"long\","+roomlong+");";
        if(!stringp(str1=read_file(file,0)))   	return 0;
	
	all=str1;//整个文件
	i=strsrch(str1,"create(");//房间create找到
	j=strsrch(str1[i..],"set(\"long\",");//set("long",)描述起始行找到
	
	if(i<0||j<0) return 0;
	k=strsrch(str1[i+j..],");");//描述结束行找到
	if(k<0) return 0;
	file_str=all[0..i+j-1]+roomlong+all[i+j+k+2..];
	write_file(file,file_str,1);
	return 1;
}


int is_punctuation(string str)
{
	string *punctuation;
	punctuation=({
		",",
		".",
		"?",
		";",
		":",
		"!",
		")",
		"，",
		"。",
		"？",
		"；",
		"：",
		"！",
		"）",
		"、",
		});
	if(!str) return -1;
        return member_array(str,punctuation);
}
