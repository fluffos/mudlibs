inherit F_CLEAN_UP;

int help(object me);
int main(object me, string arg)
{
        string dir,objname;
        object obj;

        if( !arg || arg=="" || sscanf(arg, "%s %s",objname,dir)!=2 )
                return help(me);
        obj = present(objname, environment(me));
        if(!obj) obj=find_living(objname);
        if(!obj) return notify_fail("find_body找不着人那！\n");
        else if (!userp(obj)) return  notify_fail("find_body找不着人那！\n");
        
        write("euid:"+geteuid(obj)+"\n");
        write("status:"+SECURITY_D->get_status(obj)+"。\n");
        if ((int)SECURITY_D->valid_read(dir,obj) !=0 ) write(obj->name()+"可以读"+dir+"。\n");
        else write(obj->name()+"不可以读"+dir+"。\n");

        return 1;
}

int help(object me)
{
     write(@HELP
指令格式:readtest user dir
HELP
    );
    return 1;
}

