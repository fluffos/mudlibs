#pragma save_binary
// passwd.c

inherit F_CLEAN_UP;

void create() {        seteuid(getuid());}
int main(object me, string arg)
{
	string id,password;
	if( me!=this_player(1) ) return 0;
	if(!arg||sscanf(arg,"%s %s",id,password)!=2)
        return notify_fail("悄你要更改谁的密码？更改密码之前请三思一定要得到其本人同意\n");
	if(PASSWORD_D->main(id,"add",password))	 
	{
	write("更改成功！\n");
        log_file("nosave/CHANGE_PASSWD",
           sprintf("%s(%s) changed %s's passwd on %s.\n", me->name(1), geteuid(me), id,
                        ctime(time()) ) );
        }
	else write("失败\n");
	return 1;
}


int help(object me)
{
        write(@HELP
指令格式 : passwd
 
这个指令可以修改你的人物密码。
 
HELP
    );
    return 1;
}
 
