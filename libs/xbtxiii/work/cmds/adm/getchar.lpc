#include <ansi.h>

int main(object me, string arg) {

  tell_object(me, "请按任意键！\n");
  get_char("getchar", 1, me);
  return 1;
}
void getchar(string str, object me) {
  int i, j;
  string msg;
  //str="★ＱＵＩＴ，。、《》？；‘：“【】『』1234567890－＝÷·～！◎＃￥％……※×（）——＋§～！＠＃￥％＾＆＊（）＿＋｜｀１２３４５６７８９０－＝＼，．／；＇［］＜＞？：＂｛｝";

  i = sizeof(str);
  msg = "你输入的键的编码是:";
  for (j = 0; j < i; j++) {
    msg = msg + sprintf("%d ", str[j]);
    if (j % 2 == 1) msg += "\n";
  }
  tell_object(me, msg + "\n");
}
