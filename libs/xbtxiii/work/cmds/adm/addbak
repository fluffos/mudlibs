// alias.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	
	string skill,temp_skill;
	string *skills;
	mapping sname;
	object *users,gold;
	int i,j;

	users=users();

for(i=0;i<sizeof(users);i++)
	{
	if(users[i]->query("mud_age")<=86400)
        continue;
	gold=new(GOLD_OB);
	gold->set_amount(100);
	gold->move(users[i]);
	tell_object(users[i],"天神送给了你100 两黄金!\n");
	sname=users[i]->query_skills();
	if(!sname)
        continue;
	skills=keys(sname);

	temp_skill="force";
	
	for(j=0;j<sizeof(skills);++j)
		{
		tell_object(users[i],"skills is "+skills[j]+"\n");
		if(users[i]->query_skill(skills[j],1)>users[i]->query_skill(temp_skill,1))
			{
			temp_skill=skills[j];
			}
		else
			 continue;
		}
	users[i]->set_skill(temp_skill,users[i]->query_skill(temp_skill,1)+1);
	tell_object(users[i],"你的"+to_chinese(temp_skill)+"进步了。\n");
	}
	return 1;
}

