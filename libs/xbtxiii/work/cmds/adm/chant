#pragma save_binary
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string dir,poet;
        mixed *file;
        int i;
        seteuid(getuid());

        dir="/d/poem/";
        file = get_dir(dir, -1);
if(!arg||arg)
	{
if( !sizeof(file) )
	tell_object(me,"开启文件错误。\n");
	i=sizeof(file);
	poet=read_file(dir+file[random(i)][0]);
	poet=replace_string(poet,"：","："HIG);
	poet=replace_string(poet,"\n","\n"HIC);
	message_vision("$N摇头晃脑，念诗一首。\n",me);
	tell_object(me,HIY+poet+NOR);
	message_vision(HIY+poet+NOR,me);
	}
	return 1;
}

