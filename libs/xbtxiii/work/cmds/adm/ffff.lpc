//用法和ls命令一样,不过会直接将

#pragma save_binary
// ls.c
#include <ansi.h>
#include "/doc/help.h"


inherit F_CLEAN_UP;

string format_room_long(string roomlong1);
int save_room_long(string roomlong, string file);
string get_room_long(string file);

int main(object me, string arg) {

  int i, j, w, num;
  string dir, roomlong;

  mixed *file;

  roomlong = "";
  seteuid(getuid());
  num = 0;
  if (!arg || arg == "") return notify_fail("更换哪个目录?\n");
  dir = resolve_path(me->query("cwd"));
  if (file_size(dir) == -2 && dir[strlen(dir) - 1] != '/') dir += "/";
  file = get_dir(dir, -1);
  if (!sizeof(file)) {
    if (file_size(dir) == -2) return notify_fail("目录是空的。\n");
    else
      return notify_fail("没有这个目录。\n");
  }
  i = sizeof(file);
  w = 0;
  while (i--) {
    if (file[i][1] == -2) file[i][0] += "/";
    if (strlen(file[i][0]) > w) w = strlen(file[i][0]) + 1;
  }
  write("目录：" + dir + "\n");
  if (sizeof(file)) {
    for (i = 0, j = sizeof(file); i < j; i++) {
      if (file[i][0][0..0] == ".") continue;
      //col=sizeof(file[i][0]);
      if (file[i][1] > 0) {
        //      write("file is "+dir+file[i][0]+"\n");
        roomlong = get_room_long(dir + file[i][0]);
        if (roomlong == "") continue;
        roomlong = format_room_long(roomlong);  //获取整理过的long
        save_room_long(roomlong, dir + file[i][0]);  //重新写入源文件
        num++;

        //return 1;
      }
      write(dir + file[i][0] + "读入\n");
      reset_eval_cost();
    }

  } else write("    没有任何档案。\n");
  write(num + "asdasdasdasd\n");

  return 1;
}


string get_room_long(string file) {

  string roomlong, err;
  object room;
  err = catch(call_other(file, "???"));
  if (err) return "";
  call_other(file, "???");
  room = find_object(file);
  if (!room) return "";
  //room=load_object(file);//测试中这里还有问题,碰到一个错误的房间可能会停止
  //我还没有想到别的办法
  if (!room->is_room()) return "";
  roomlong = room->query("long");
  destruct(room);
  if (!roomlong) return "";
  return roomlong;

}


string format_room_long(string roomlong1) {



  int i, j, hang, x, y, z, aa, last;  //换行标记
  string roomlong2;

  roomlong1 = replace_string(roomlong1, "\n", "");
  roomlong1 = replace_string(roomlong1, " ", "");
  //roomlong1=replace_string(roomlong1,"LONG","");
  //roomlong1=replace_string(roomlong1,"@","");
  //roomlong1=replace_string(roomlong1,"\"","");
  roomlong1 = replace_string(roomlong1, "\t", "");
  //roomlong1=replace_string(roomlong1,"\\O","");
  //roomlong1=replace_string(roomlong1,"\\r","");

  roomlong2 = "";

  if (!roomlong1) return "";
  x = 0; y = 0; i = sizeof(roomlong1);
  hang = i / 80;
  z = 0;
  z = i % 80;
  if (z != 0) hang++;

  last = 0;
  roomlong2 = "\n" + roomlong2;
  for (x = 0; x < hang; x++) {
    aa = 0;

    if (hang - x == 1)  //最后一行 
    {
      roomlong2 = roomlong2 + "\"" + roomlong1[last..i - 1] + "\\n" + "\"" + "\n";
      break;
    } else {

      for (j = 0; j < 80; j++) {
        if (roomlong1[last + j] <= 160)  //不是中文字
          aa++;
        else continue;
      }
      if (aa % 2 != 0)  //这一行有几个非中文字,要做特殊处理,行的最大数字加1.
      {
        //write_file("/open/rongg/hang.txt",roomlong1[last..last+80]+"\n",0);
        roomlong2 = roomlong2 + "\"" + roomlong1[last..last + 78] + "\\n" + "\"" + "\n";  //这一行最大字母数加一
        last = last + 79;
      } else  //这一行40个全部都是中文
      {
        //write_file("/open/rongg/hang.txt",roomlong1[last..last+79]+"\n",0);
        roomlong2 = roomlong2 + "\"" + roomlong1[last..last + 79] + "\\n" + "\"" + "\n";
        last = last + 80;
      }

    }
  }
  return roomlong2;

}
int save_room_long(string roomlong, string file) {


  string file_str, all, str1;
  int i, j, k;
  //file+=".lpc";
  if (!roomlong || roomlong == "") return 0;
  roomlong = "set(\"long\"," + roomlong + ");";
  if (!stringp(str1 = read_file(file, 0))) return 0;

  all = str1;  //整个文件
  i = strsrch(str1, "create(");  //房间create找到
  j = strsrch(str1[i..], "set(\"long\",");  //set("long",)描述起始行找到

  if (i < 0 || j < 0) return 0;
  k = strsrch(str1[i + j..], ");");  //描述结束行找到
  if (k < 0) return 0;
  file_str = all[0..i + j - 1] + roomlong + all[i + j + k + 2..];
  write_file(file, file_str, 1);
  return 1;
}
