#pragma save_binary

#include <ansi.h>
#include <command.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob, link_ob;
  string wiz_status;

  if (me != this_player(1)) return 0;

  if (!arg || sscanf(arg, "%s", arg) != 1)
    return notify_fail("argument error!\n");


  wiz_status = SECURITY_D->get_status(me);

  if (wiz_status != "(admin)")
    return notify_fail("you r not admin!\n");

  ob = LOGIN_D->find_body(arg);
  if (!ob) return notify_fail("咦... 有这个人吗?\n");

  if (!living(ob)
    || !ob->is_character()
    || ob == me)
    return notify_fail("ob error!\n");
  seteuid(ROOT_UID);
  ob->save();
  link_ob = ob->query_temp("link_ob"); if (link_ob) {
    exec(link_ob, ob);
    destruct(link_ob);
    tell_object(me, "你把 " + ob->query("name") + " 的连线掐断了!\n");
  } else return notify_fail("咦... 有这个人吗?\n");
  seteuid(getuid());

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : disconnect <某人>

HELP
  );
  return 1;
}
