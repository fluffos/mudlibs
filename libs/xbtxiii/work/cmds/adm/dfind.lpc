#pragma save_binary
// getid.c

inherit F_CLEAN_UP;


void create() {
  seteuid(getuid());
}


private int check_in_file(string dir, string arg);

int main(object me, string arg) {
  string status;

  status = wizhood(me);
  if (me != this_player(1)
    || wiz_level(me) < wiz_level(status))
    return notify_fail("你没有权力使用这个指令。\n");
  if (!arg) return notify_fail("指令格式：dfind 内容\n");
  check_in_file(me->query("cwd"), arg);
  return 1;
}

private int check_in_file(string dir, string arg) {
  int j, count;
  string str;
  mixed *ppls;
  seteuid(getuid());
  count = 0;
  reset_eval_cost();
  ppls = get_dir(dir + "/", -1);
  for (j = 0; j < sizeof(ppls); j++) {
    if (ppls[j][1] == -2)
      count += check_in_file(dir + "/" + ppls[j][0], arg);
    if (ppls[j][1] > 1) {
      str = "" + read_file(dir + "/" + ppls[j][0]);
      if (strsrch(str, arg) >= 0) {
        write("find in file:" + dir + "/" + ppls[j][0] + "\n");
        count++;
      }
    }
  }

  return count;
}

int help(object me) {
  write(@HELP
指令格式：dfind 内容

like find but find in sub dir too
这个命令不是很好，非常容易拖慢系统，所以一定要小心使用。尤其是不得滥用。。
HELP
  );
  return 1;
}
