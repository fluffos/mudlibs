#pragma save_binary
// 增加 sort IP 的方式
// who.c
// by sophos
// 	. format the document
//  . 删除巫师对巫师的隐身的判断,即巫师对巫师都不隐身
//  . 由于query("last_from")不能正常工作
//    改为query_ip_number()

#include <net/dns.h>
inherit F_CLEAN_UP;

string age_string(int);
int sort_user(object ob1, object ob2);
int sort_ip(object ob1, object ob2);

mixed main(object me, string arg, int remote)
{
  string	str, *option, tmp;
  object        *list;
  int		i, j, ppl_cnt, count;
  int		opt_long, opt_id, opt_ip, opt_ipp;
  int 		opt_c,opt_g;
  string 	st1,st2;
  int		wiz;

  seteuid(getuid());

  wiz = wiz_level(me);
  if ( arg ) {
	option = explode(arg, " ");
	i = sizeof(option);
	while ( i-- )
	  switch (option[i]) {
		case "-l":
		  opt_long = 1;
		  break;
		case "-i":
		  opt_id = 1;
		  break;
		case "-ip":
		  opt_ip = 1;
		  break;
		case "-ipp":
		  opt_ipp = 1;
		  break;

		default:
		  if(sscanf(arg,"%s %s",st1,st2)==2)
		  {
			switch(st1)
			{
			  case "-c":  opt_c=1; break;
			  case "-g":  opt_g=1; break;
			}
		  }
		  if(opt_c==1||opt_g==1)
			break;
		  if(wiz&&option[i][0]=='@') {
			RWHO_Q->send_rwho_q(option[i][1..sizeof(option[i])], me, 0);
			write("网路讯息已送出  请稍候。\n");
			return 1;
		  }
		  else
			return notify_fail ("指令格式  who [-l|-i|-ip|-ipp|-c|-g]\n");
	  }
  }
  count = 0;

  str = "◎ " + MUD_NAME + "\n";
  str += "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
  if(opt_c!=1&&opt_g!=1)
	str = sprintf("%s共有 %d 位使用者连线中  系统负担  %s\n",
				  str,
				  sizeof(users()),
				  query_load_average() );
  else
	str = sprintf("%s共有 %d 位%s玩者连线中。\n",
				  str,
				  count,
				  to_chinese(st2) );
  str += "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
  // 底下这行只有没断线玩家才会列出
  list = children("/obj/user");

  ppl_cnt = sizeof(list);

  if (opt_ip)
	list = sort_array(list, "sort_ip", this_object());
  else
	list = sort_array(list, "sort_user", this_object());

  // 巫师看的跟玩家不一样
  if (wiz)
  {
	j = ppl_cnt;
	while( j-- )
	{
	  if( !environment(list[j]) )
		continue;

	  if (!tmp=list[j]->query("id"))
		tmp = "创角色中";
	  if(opt_long!=1)
		str = sprintf("%s%12s %14s%-12s %6s %-15s %2s%2s%2s%2s%s\n",
					  str,
					  RANK_D->query_rank(list[j]),
					  list[j]->name(1),
					  "("+capitalize(tmp)+")",
					  age_string ((int)list[j]->query("mud_age")),
					  //list[j]->query("last_from"),
					  query_ip_number( list[j] ),	
					  list[j]->query_temp("netdead")?"断":"",
					  environment(list[j])?"":"虚",
					  in_edit(list[j])?"编":"",
					  in_input(list[j])?"读":"",
					  (interactive(list[j]) && query_idle(list[j]) > 120)?"呆"+query_idle(list[j])/60+"分":"",
				   );
	  else
		str=sprintf("%s%12s %-s\n",
					str,
					RANK_D->query_rank(list[j]),
					list[j]->query("title")+
					( list[j]->query("nickname") ? "「"+list[j]->query("nickname")+"」" : " " )+
					list[j]->query("name")+"("+
					list[j]->query("id")+")" );
		count++;
	}	//end while
  }
  else	//不是巫师
  {
	if ( opt_long )
	{
	  j = ppl_cnt;
	  while( j-- )
	  {
		// Skip those users in login limbo.
		if( !environment(list[j]) )
			continue;
		if(wizardp(list[j]))
			continue;
		str = sprintf("%s%12s%2s%2s%2s%2s %s\n",
					  str,
					  RANK_D->query_rank(list[j]),
					  (in_edit(list[j])||in_input(list[j]))?"文":"",
					  (interactive(list[j]) && query_idle(list[j]) > 120)?"呆":"",
					  list[j]->query_temp("netdead")?"断":"",
					  environment(list[j])?"":"虚",
					  list[j]->short(1)
					  );
		count++;
	  }	//end where
	}
	else if(opt_g==1)
	  for(j=0; j<sizeof(list); j++)
	  {
		if(list[j]->query("family/family_name")==st2)
		  if(!wizardp(list[j]))
		  {
			str=sprintf("%s%12s %-s\n",
						str,
						RANK_D->query_rank(list[j]),
						list[j]->query("title")+(list[j]->query("nickname") ? "「"+list[j]->query("nickname")+"」" : " ")+
						list[j]->query("name")+
						"("+list[j]->query("id")+")");
			count++;
		  }
	  }
	else if(opt_c==1)
	{
	  for(j=0;j<sizeof(list);j++)
	  {
		if(list[j]->query("class")==st2)
		  if(!wizardp(list[j]))
		  {
			str=sprintf("%s%12s %-s\n",
				str,
				RANK_D->query_rank(list[j]),
				list[j]->query("title")+( list[j]->query("nickname") ? "「"+list[j]->query("nickname")+"」" : " ")+
				list[j]->query("name")+
				"("+list[j]->query("id")+")");
			count++;
		  }
	  }	//end for
	}
	else
	{
	  ppl_cnt = 0;
	  j = sizeof (list);
	  while( j-- )
	  {
		// Skip those users in login limbo.
		if ( !environment (list[j]) )
		  continue;
		if (list[j]->query_temp("netdead"))
		  continue;
		if ( wizardp(list[j]) )
		  continue;
		if (!tmp=list[j]->query("id"))
		  tmp = "创角色中";
		str = sprintf("%s%-15s%s",
					  str,
					  opt_id?capitalize(tmp):list[j]->name(1),
					  (ppl_cnt%5==4? "\n": "") );
		ppl_cnt++;
		count++;
	  }	//end while

	  if( ppl_cnt%5 ) str += "\n";
	}	//end if parameter switch
  }	//end 不是巫师

  if( remote ) return str;

  me->start_more (str);
  return 1;
}

int sort_user(object ob1, object ob2)
{
  int	level;

  level = wiz_level(ob1) - wiz_level(ob2);
  if (level != 0)
	return level;
  else
	return (int)ob2->query("combat_exp") - (int)ob1->query("combat_exp");
}

int sort_ip(object ob1, object ob2)
{
  int	level;

  if (!interactive(ob1) || !interactive(ob2)) return 0;
  level = wiz_level(ob1) - wiz_level(ob2);
  if (level != 0)
	return level;
  /*
  else if (  stringp(ob1->query("last_from"))
		   &&stringp(ob2->query("last_from")) )
  {
	return -strcmp(ob1->query("last_from"), ob2->query("last_from"));
  }
  */
  else if (  stringp( query_ip_number(ob1) )
		   &&stringp( query_ip_number(ob2) ) )
  {
	return -strcmp( query_ip_number(ob1), query_ip_number(ob2) );
  }

}

string age_string(int time)
{
		int month, day, hour;

		time /= 3600;
		hour = time % 24;
		time /= 24;
		day = time % 30;
		month = time / 30;
		return (month?month + "m":"") + (day?day + "d":"") + hour + "h";
}

int help(object me)
{
write(@HELP
指令格式 : who [-l | -i | -ip | -c <职业代号> | -g <门派名称> ]

这个指令可以列出所有在线上的玩家及其等级。

-l 选项列出较长的讯息。
-i 只列出玩家的英文代号。
-ip 以 ip 排列顺序
-c <职业代号> 列出该职业所有玩者。
-g <门派名称> 列出该门派的所有玩者。

相关指令   finger
HELP
	);
	return 1;
}
