#pragma save_binary
// overview.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object *list;
  int i;
  string filename, del;
  if (!arg) return notify_fail("children filename del");

  if (sscanf(arg, "%s %s", filename, del) == 2) {
    filename = resolve_path(me->query("cwd"), filename);
    if (!sscanf(filename, "%*s.lpc")) filename += ".lpc";
    write(filename + "\n");
    if (!find_object(filename)) return notify_fail("can not find this object\n");
    list = children(filename);
    for (i = 0; i < sizeof(list); i++)
      destruct(list[i]);
    write(filename + "总共有" + sizeof(list) + "个\n");

    write("全部删除\n");
    return 1;
  } else {
    filename = arg;

    filename = resolve_path(me->query("cwd"), filename);
    if (!sscanf(filename, "%*s.lpc")) filename += ".lpc";
    write(filename + "\n");
    if (!find_object(filename))
      return notify_fail("can not find this object\n");


    list = children(filename);
    write(filename + "总共有" + sizeof(list) + "个\n");
    return 1;
  }

  return 1;
}
