#pragma save_binary
#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DBASE;
int main(object me, string arg) {

  if (!arg) return notify_fail("格式 unbane <id>\n");
  LOGIN_D->del_baneid(arg);
  write("OK!\n");
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : unbane  <某人>
相关指令  warn
HELP
  );
  return 1;
}
