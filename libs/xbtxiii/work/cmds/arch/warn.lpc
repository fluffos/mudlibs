#pragma save_binary
#include <ansi.h>
inherit F_DBASE;
void create() {
  set("name", "公告");
  set("id", "warn wizard");
}
int main(object me, string arg) {
  object link_ob, ob;
  me = this_player();
  if (!arg || !objectp(ob = find_player(arg)))
    return notify_fail("有这个玩家吗?\n");
  //        if( wizhood(ob) != "(player)")
  //                return notify_fail("乱用指令可是会死人的!!!!\n");
  if (query("warn/" + arg) >= 5) {
    LOGIN_D->add_baneid(arg);
    CHANNEL_D->do_channel(this_object(), "chat",
      HIR "在" + me->name() + "多次警告下," + ob->name() + "*(" + ob->query("id") +
      ")仍不悔改,被" HIW "临时" HIR "封杀ID,望大家引以为戒!\n" NOR);
    tell_object(ob, me->name() + "封杀了你的ID,请跟他(她)联系,或等系统重起后再进!\n" +
      "如果有任何不满,可以想天神反映!\n");
    log_file("nosave/WARN", sprintf("[%s] %s 封杀了 %s (%s)\n",
      ctime(time())[0..15], geteuid(this_player(1)), ob->name(1), ob->query("id")));
    seteuid(ROOT_UID);
    ob->save();
    if (objectp(link_ob = ob->query("link_ob"))) {
      link_ob->save();
      destruct(link_ob);
    }
    destruct(ob);
    return 1;
  }
  add("warn/" + arg, 1);
  tell_object(ob, HIR + me->name(1) + "给了你一次严重的警告处分.\n小心哦,五次警告可是会给临时封杀ID的.\n" NOR);
  CHANNEL_D->do_channel(this_object(), "chat",
    HIR + me->name(1) + "给了" + ob->name(1) + "一次严重警告!\n" NOR);
  if (query("warn/" + arg) >= 5)
    tell_object(ob, "这是最后一次警告!!!!!!!!!!!!!!!!\n");
  return 1;

}

int help(object me) {
  write(@HELP
指令格式 :  warn  <某人>

相关指令:unbane 
HELP
  );
  return 1;
}
