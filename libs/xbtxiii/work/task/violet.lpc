#pragma save_binary
// 紫罗兰

inherit ITEM;

#include <ansi.h>
void create() {

  set_name(HIM "紫罗兰" NOR, ({ "violet" }));
  set_weight(1);
  set("owner", "采花少女");
  set("task", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "朵");
    set("long", "晚月庄采花少女正在摘采此类花朵。");
    set("value", 100);
    set("no_put_in", 1);
  }
  setup();
}
