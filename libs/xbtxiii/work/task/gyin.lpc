#pragma save_binary
 
#include <ansi.h>
inherit ITEM;
int seteuid();
void create()
{
 set_name(HIY "官印" NOR, ({ "gyin" }));
        set_weight(100);
        set("owner","吴天德");
        if( clonep() )
                set_default_object(__FILE__);
        else {
              set("unit", "块");
set("long",  HIR "绮云六品正堂印  吴天德\n" NOR );
                set("value", 100);
        set("no_put_in",1); 
             set("task",1);
                set("material", "gold");
        }
}



