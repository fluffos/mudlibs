#pragma save_binary
 
// book.c

inherit ITEM;

#include <ansi.h>
void create()
{

        set_name(HIC "阿发日记" NOR, ({ "afrji" }));
        set_weight(600);
        set("owner","阿发");
        set("task",1); 
        set("no_put_in",1); 
        set("unit", "本");
        set("long", "这是一本风云城阿发竹器店，阿发的日记。\n");
        set("value", 100);
        set("skill", ([
                "name":                 "literate",             // name of the skill
                "exp_required": 0,                              // minimum combat experience required
                                                                                // to learn this skill.
                "sen_cost":             40,                             // gin cost every time study this
                "difficulty":   30,                             // the base int to learn this skill
                                                                                // modify is gin_cost's (difficulty - int)*5%
                "max_skill":    5                              // the maximum level you can learn
                                                                                // from this object.
        ]) );
}
