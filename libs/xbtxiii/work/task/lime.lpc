#pragma save_binary

// 石灰

inherit ITEM;

#include <ansi.h>
void create() {

  set_name(HIW "石灰" NOR, ({ "lime" }));
  set_weight(600);
  set("owner", "小桂子");
  set("task", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "包");
    set("long", "一包石灰，不知道小桂子要不要？\n");
    set("value", 100);
    set("no_put_in", 1);
  }
  setup();
}
