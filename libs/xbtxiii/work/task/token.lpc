#pragma save_binary
 
// 杀手令牌

inherit ITEM;

#include <ansi.h>
void create()
{

        set_name(HIR "杀手令牌" NOR, ({ "killer_token" }));
        set_weight(600);
        set("owner","南宫无恨");
        set("task",1); 
		if( clonep() )
			set_default_object(__FILE__);
		else 
			{
	        set("unit", "块");
    	    set("long", "南宫无恨的杀手令牌。\n");
	       	set("value", 100);
    	    set("no_put_in",1); 
			}
       	setup();
}
