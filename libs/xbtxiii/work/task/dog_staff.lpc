#pragma save_binary
 
// bamboo_stick.c

#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
	set_name(HIC"打狗棒"NOR, ({"dog_staff", "staff"}));
	set_weight(5000);
	set("task",1);
	set("owner","洪七公");
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("long", "一根泛着淡淡青光的竹杖。\n");
		set("value", 1000000);
		set("material", "bamboo");
		set("wield_msg", "$N抽出一根青光闪闪的竹杖抓在手中。\n");
		set("unwield_msg", "$N把手中的玉竹杖插回腰中。\n");
	}
	init_staff(40);
	setup();
}	
