#pragma save_binary
 

#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(HIR "红包" NOR, ({ "hongbao" }) );
	set_weight(500);
	set_max_encumbrance(8000);
        set("owner","黄麻子");
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
        set("long",HIC "一个精美的荷包，上面绣着银钩赌坊 黄\n" NOR);
		set("value", 10000);
        set("task",1);
        set("no_put_in",1); 
	}
}

int is_container() { return 1; }
