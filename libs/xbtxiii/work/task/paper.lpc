#pragma save_binary
 
// book.c

inherit ITEM;

#include <ansi.h>
void create()
{

        set_name(HIC "厕纸" NOR, ({ "paper" }));
        set_weight(600);
        set("owner","张三丰");
        set("task",1); 
        set("unit", "张");
        set("long", "一卷厕纸。可以用来。。。。不知道张三丰用不用？\n");
        set("value", 100);
        set("no_put_in",1); 
        setup();
}
