#pragma save_binary
 
#include <ansi.h>
inherit ITEM;
void create()
{

        set_name(HIC "封山剑谱" NOR, ({ "fengshan_sword_book" }));
        set_weight(600);
        set("owner","柳淳风");
        set("task",1); 
        set("unit", "本");
        set("long", "这是一本封山剑谱。\n");
        set("value", 100);
        set("skill", ([
                "name":               "fonxansword",             // name of the skill
                "exp_required": 10000,                              // minimum combat experience required
                                                                                // to learn this skill.
                "sen_cost":             40,                             // gin cost every time study this
                "difficulty":   30,                             // the base int to learn this skill
                                                                                // modify is gin_cost's (difficulty - int)*5%
                "max_skill":    10                              // the maximum level you can learn
                                                                                // from this object.
        ]) );
}

