#pragma save_binary

// 收据

inherit ITEM;

#include <ansi.h>
void create() {

  set_name(HIM "收据" NOR, ({ "receipt" }));
  set_weight(600);
  set("owner", "南宫云");
  set("task", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "当铺老板南宫云丢失的收据。\n");
    set("value", 100);
    set("no_put_in", 1);
  }
  setup();
}
