#pragma save_binary

#include <ansi.h>

inherit ITEM;
string *other_room = ({
  "/d/fy/fqkhotel",
  "/d/ny/inn",
  "d/fy/poemp",
  "d/yangzhou/guangchang",
  "d/city/bridge",
  "d/fy/church",
  "d/fy/fysquare",
});
void create() {
  set_name(MAG "瞬间移动卷轴" NOR, ({ "flee_scroll" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("long",
      "这是一个瞬间移动的卷轴，可以使你随机移动到别的地方。\n");
    set("value", 1000);
    set("material", "unknow");
    set("owner", "宝物商");
    set("task", 1);
  }

}

mixed new_use(object me, string arg) {
  object env;
  string *dir;
  mixed room;
  mapping exits;
  me->remove_all_enemy();

  message_vision(HIG "$N念了几句咒语，立刻化做一道青光消失的无影无踪。。\n" NOR, me);

  env = environment(me);
  exits = env->query("exits");
  if (mapp(exits)) {
    dir = keys(exits);
    room = exits[dir[random(sizeof(dir))]];
    if (stringp(room)) load_object(room);
    if (room) {
      me->move(room);
      message_vision(CYN "$N出现在一阵青光之中。\n" NOR, me);
    } else {
      room = load_object(other_room[random(sizeof(other_room))]);
      me->move(room);
      message_vision(CYN "$N出现在一阵青光之中。\n" NOR, me);
    }

    return 1;
  }
}
