#pragma save_binary

#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIY "元帅帅印" NOR, ({ "shuaiyin" }));
  set_weight(100);
  set("owner", "袁崇焕");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", HIR "辅国大将军  袁崇焕\n" NOR);
    set("value", 1000);
    set("no_put_in", 1);
    set("task", 1);
    set("material", "gold");
  }
  setup();
}
