#pragma save_binary
// chicken_leg.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("灵芝", ({ "ling zhi" }));
  set_weight(350);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "灵芝一枚。\n");
    set("unit", "根");
    set("value", 30);
    set("food_remaining", 4);
    set("food_supply", 40);

  }
  setup();
}
