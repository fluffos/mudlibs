#pragma save_binary


#include <ansi.h>
inherit ITEM;

void create() {
  set_name(GRN "狗屠刀鞘" NOR, ({ "gtdqiao" }));
  set_weight(500);
  set_max_encumbrance(80000);
  set("owner", "於兰天武");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", HIC "好一把妖刀狗屠，就连它的刀鞘也与众不同。\n" NOR);
    set("value", 10000);
    set("no_put_in", 1);
    set("task", 1);
  }
}

int is_container() { return 1; }
