#pragma save_binary

// 石灰

inherit ITEM;
#include <ansi.h>

void create() {

  set_name(HIM "卖身契" NOR, ({ "mai_shen_qi" }));
  set_weight(600);
  set("owner", "李师师");
  set("task", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "李师师卖身于此。100两黄金，特此为证\n");
    set("value", 100);
    set("no_put_in", 1);
  }
  setup();
}
