
string chinese_number(int i)
{
        return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
        return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
        int i, len;

        // FIX (AGENTS.md §15h): this used to be a GBK LEAD/TRAIL-BYTE range
        // check (str[i] returned a raw byte on the original driver, and
        // strlen() counted bytes -- 2 bytes per Chinese character). On this
        // driver str[i] is the character's Unicode CODEPOINT and strlen()
        // counts characters, so the old byte-range comparison silently
        // never matched real Chinese text at all. Replaced with a CJK
        // Unified Ideographs codepoint range check, and the length guard
        // halved (was "< 2 bytes" = "< 1 full character").
        len = strlen(str);
        if (len < 1) return 0;

        for (i = 0; i < len; i++)
        {
                if (str[i] < 0x4e00 || str[i] > 0x9fff) return 0;
        }

        return 1;
}

