inherit NPC;
#include <combat.h>
#include <ansi.h>

object offensive_target(object me);
void random_talk();

string *talk = ({
  "许久不杀人，手也涩难忍。",
  "想和我试招，尽管来吧，我可不怕。",
  "挥刀杀一人，抹刃血无痕。",
  "杀者，人之本性；随性所发，乐乎者也。",
  "我有好多宝贝。",
  "...人...肉...新鲜...的人...肉...",
});

object npc_name() {
  int i;
  object ob, *players;
  players = users();
  i = random(sizeof(players));
  ob = players[i];

  if (!ob)
    ob = npc_name();

  return ob;
}

void create() {
  string name, id, str;
  object who = npc_name();
  if (!who) {
    name = "攻击测试精灵";
    id = "jing ling";
  } else {
    name = who->query("name");
    id = capitalize(who->query("id"));
  }

  set_name(name, ({ id }));

  set("gender", random(2) ? "男性" : "女性");
  set("long", HIW "\n天上人家玩家专用试招NPC，有炮尽管朝她(他)发！\n\n" NOR);
  set("age", random(5) + 16);
  set("title", HIB "灵" NOR HIM "界" NOR WHT "幻" NOR YEL "像" NOR);

  set("int", 30);
  set("max_kee", 1100);
  set("kee", 1100);
  set("max_sen", 1100);
  set("sen", 1100);
  set("food", 10000);
  set("water", 10000);

  set("combat_exp", 1000000);
  set("daoxing", 1200000);
  set("force", 2500);
  set("max_force", 1500);
  set("mana", 2500);
  set("max_mana", 1600);
  set("force_factor", 80);
  set("mana_factor", 80);


  set("chat_chance", 2);
  set("chat_msg", ({
    (: random_talk :),
    command("say 和我试试招吧，好久没打架了。\n"),
    command("say 和我试试招吧，好久没打架了。\n"),
  }));
  setup();
}

void init() {
  add_action("do_cancel", "surrender");
  add_action("do_cancel", "touxiang");
}

int do_cancel() {
  object me = this_player();
  object ob = this_object();
  if (me->is_fighting(ob)) {
    me->remove_killer(ob);
    ob->remove_killer(me);
  }
  return 0;
}

void random_talk() {
  string str;
  object ob = this_object();

  str = "$N($I)唱道：";
  str += talk[1 + random(6)];
  str += "我在钦法祭台等待一败！\n";
  str = replace_string(str, "$N", ob->query("name"));
  str = replace_string(str, "$I", capitalize(ob->query("id")));
  message("channel:music", BLU "【心笙乐府】" + str + NOR, users());
  return;
}

object offensive_target(object me) {
  int sz;
  object *enemy;

  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;

  sz = sizeof(enemy);
  if (sz > 1) {
    me->command("say 你们以多欺少，不是英雄所为！\n");
    me->command("bye");
    me->die();
  } else
    return enemy[1];
}


void heart_beat() {
  int hp, eff_hp, max_hp, mp, eff_mp, max_mp;
  object me = this_object();

  hp = query("kee");
  eff_hp = query("eff_kee");
  max_hp = query("max_kee");

  mp = query("sen");
  eff_mp = query("eff_sen");
  max_mp = query("max_sen");

  if (hp <= 0 || eff_hp <= 0 || mp <= 0 || eff_mp <= 0)
    die();

  else {
    if (hp < max_hp || eff_hp < max_hp) {
      command("say 	气血:" + hp + "/" + eff_hp + "(" + eff_hp * 100 / max_hp + "%)。\n");
      set("eff_kee", query("max_kee"));
      set("kee", query("max_kee"));
    }
    if (mp < max_mp || eff_mp < max_mp) {
      command("say 	精神:" + mp + "/" + eff_mp + "(" + eff_mp * 100 / max_mp + "%)。\n");
      set("eff_sen", query("max_kee"));
      set("sen", query("max_kee"));
    }
  }
  ::heart_beat();
}

void die() {
  string name, id, msg;
  object me = this_object();
  object who = npc_name();

  if (!who) {
    name = "攻击测试精灵";
    id = "jing ling";
  } else {
    name = who->query("name");
    id = who->query("id");
  }

  if (environment()) {
    msg = "$N($I)：杀了我一个，还有后来人，一个$N倒下了，后面还有千千万万个$N爬起来。\n";
    msg = replace_string(msg, "$N", me->query("name"));
    msg = replace_string(msg, "$I", capitalize(me->query("ids")));
    message("channel:sldh", HIB "〖" NOR HIG "幻化心魔" NOR HIB "〗" NOR + HIC + msg + NOR, users());
    msg = HIY "$N手捻口诀，念动真言，摇身一变，变得和$n" HIY "一模一样！\n" NOR;
    msg = replace_string(msg, "$N", me->query("name"));
    msg = replace_string(msg, "$n", name);
    message("sound", msg, environment());
  }

  me->set_name(name, ({ id }));

  set("eff_kee", me->query("max_kee"));
  set("kee", me->query("max_kee"));
  set("eff_sen", me->query("max_kee"));
  set("sen", me->query("max_kee"));
  me->save();
  return;
}

void unconcious() {
  die();
}

int accept_kill(object who) {
  int i, guai_value, hp_lvl, damage, armor;
  mapping skill;
  object me = this_object();
  object jia = new("/d/obj/armor/jinjia");

  skill = who->query_skills();

  if (!skill || !who) {
    set_skill("unarmed", 150);
    set_skill("parry", 150);
    set_skill("dodge", 150);
    set_skill("force", 150);
    set_skill("spells", 150);
    set_skill("moondance", 150);
    set_skill("dragonforce", 150);
    set_skill("taiji-quan", 150);
    set_skill("buddhism", 150);

    map_skill("force", "dragonforce");
    map_skill("spells", "buddhism");
    map_skill("dodge", "moondance");
    map_skill("parry", "taiji-quan");
    map_skill("unarmed", "taiji-quan");
  }
  guai_value = who->query_skill("force");
  guai_value += random(guai_value / 4);
  hp_lvl = who->query("max_kee");
  hp_lvl += random(hp_lvl / 4);

  set_skill("unarmed", guai_value);
  set_skill("dodge", guai_value);
  set_skill("parry", guai_value);
  set_skill("force", guai_value);
  set_skill("spells", guai_value);
  set_skill("moondance", guai_value);
  set_skill("dragonforce", guai_value);
  set_skill("taiji-quan", guai_value);
  set_skill("buddhism", guai_value);

  map_skill("force", "dragonforce");
  map_skill("spells", "buddhism");
  map_skill("dodge", "moondance");
  map_skill("parry", "taiji-quan");
  map_skill("unarmed", "taiji-quan");

  i = me->query_skill("force");
  i += me->query_skill("dragonforce", 1) / 2;
  i *= 10;
  me->set("max_force", i);
  me->set("force", i * 2);
  me->set("max_mana", i);
  me->set("mana", i * 2);
  me->set("max_kee", hp_lvl);
  me->set("max_sen", hp_lvl);
  me->set("eff_kee", me->query("max_kee"));
  me->set("kee", me->query("max_kee"));
  me->set("eff_sen", me->query("max_kee"));
  me->set("sen", me->query("max_kee"));
  if (!present("golden armor", me))
    jia->move(me);
  if (!me->query_temp("armor"))
    me->command("wear all");

  damage = who->query_temp("apply/damage");
  if (!damage || damage < 250)
    damage = 250;
  damage += random(damage);

  armor = who->query_temp("apply/armor");
  if (!armor || armor < 500)
    armor = 500;
  armor += random(armor);

  me->set_temp("apply/damage", damage);
  me->set_temp("apply/armor", armor);
  kill_ob(who);
  return 0;
}
