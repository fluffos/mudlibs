inherit NPC;
#include <ansi.h>
mapping a_types = ([
        "heads"          : ({"顶","装备在头上遮风挡雨。",8,1000}),
        "necks"          : ({"串","戴在脖子上驱恶辟邪。",3,500}),
        "cloths"         : ({"朵","穿在身上挡风御寒。",20,3000}),
        "armors"         : ({"抹","穿在身上抵挡刀箭。",40,5000}),
        "surcoats"       : ({"朵","披在身后遮风挡雨。",25,2000}),
        "waists"         : ({"串","佩在腰间驱恶辟邪。",5,1000}),
        "wristss"        : ({"串","戴在指间驱恶辟邪。",3,500}),
        "shields"        : ({"朵","拿中手中抵挡刀箭。",20,2500}),
        "fingers"        : ({"朵","捏在指尖驱恶辟邪。",3,500}),
        "bootss"         : ({"对","踩在脚下驱恶辟邪。",15,800}),

]);

string check_lianhua();
private int update_player(object me);

void create()
{
set_name("如来佛", ({ "rulaifo","fo zu","fo"}));
set("title", "佛祖多陀阿伽陀");
set("long", "大慈大悲灵山雷音古刹佛祖多陀阿伽陀如来佛爷。\n");
set("gender", "男性");
set("age", 10000);
set("attitude", "peaceful");
set("rank_info/self", "贫僧");
set("rank_info/respect", "佛祖爷爷");
set("str",100);
set("per",100);
set("max_kee", 10000);
set("max_gin", 10000);
set("max_sen", 10000);
set("force", 10000);
set("max_force", 10000);
set("force_factor", 500);
set("max_mana", 10000);
set("mana", 10000);
set("mana_factor", 500);
set("combat_exp", 4000000);
set("daoxing", 10000000);

set_skill("literate", 300);
set_skill("spells", 300);
set_skill("buddhism", 300);
set_skill("unarmed", 300);
set_skill("jienan-zhi", 300);
set_skill("dodge", 300);
set_skill("lotusmove", 300);
set_skill("parry", 300);
set_skill("force", 300);
set_skill("lotusforce", 300);
set_skill("staff", 300);
set_skill("lunhui-zhang", 300);
map_skill("spells", "buddhism");
map_skill("unarmed", "jienan-zhi");
map_skill("dodge", "lotusmove");
map_skill("force", "lotusforce");
map_skill("parry", "lunhui-zhang");
map_skill("staff", "lunhui-zhang");
set("inquiry", ([
    "莲花" : (: check_lianhua :),
  ]) );
setup();
carry_object("/d/obj/cloth/jia_sha")->wear();
}

string check_lianhua()
{
mapping data1,data;
int i,p;
string dir,f,*file,str1,str2,str3,str4;
string *a_t;
mapping aa_t;
string *att;
object armor;
string arr;
string *atype;
string *adat1;
string *kkk,*aak;
mapping akk;
int hbl=0,hb=0;

object me = this_player();
a_t = keys(a_types);

if ( !userp(me) )
        return 0;
data1 = me->query("莲花");
if ( !data1 || !mapp(data1) )
        return "相传佛门湿婆修悟之时，种下一池白莲而炼化为宝。今其座下各天神尚携此法宝云游人间。";
set("莲花_"+me->query("id"),data1);
data = ([]);
aa_t = ([]);
akk = ([]);

adat1 = keys(data1);

dir = me->query("id");
dir = "/c/莲花/"+dir+"/";
file = get_dir(dir);
if ( !file || !arrayp(file) )
        {
        me->delete("莲花");
        return "你所存莲花皆已不在，贫僧只得将其去除。";
        }
i = sizeof(file);
while(i--)
{
	f = file[i];
	if ( !f || !stringp(f) )
		continue;
	kkk = stat(dir+f);
	aak = keys(akk);
	if( member_array(kkk[1],aak)!= -1 )//防止同时建立的错误
	{
	        str1=kkk[1];
write(kkk[1]+"\n");
str1 = kkk[1];
printf("%d__%d\n",sizeof(str1),sizeof(kkk[1]));
	        if( wizardp(me) ) write(str1+"\n");
		p += i;
                kkk[1] = sprintf("%d",p);
                return kkk[1];
	}
	akk[kkk[1]] = f;
}
kkk = keys(akk);
aak = sort_array(kkk,1);
i = sizeof(aak);
while(i--)
        {
//        f = file[i];
        f = akk[aak[i]];
        if ( !f || !stringp(f) )
                continue;
        if ( wizardp(me) )
                write("file==="+f+" "+aak[i]+"\n");
        if ( sscanf(f,"%s.o",f)!=1 )
                continue;
        //找到需要的
        att = keys(aa_t);

        //to delete the 错误的莲花
		armor = new("/d/nanhai/obj/lianhua/lianhua");
		armor->set("owner_id",me->query("id"));
		arr = me->query("id");
		arr+= "/";
		arr+= f;
		armor->set("save_file",arr);
        armor->restore();
        if( me->query("莲花/"+f)!= 1 && me->query("combat_exp")<10000000 )
        {
			if( wizardp(me) )write("del "+f+"\n");
			("/cmds/wiz/rm.c")->main(armor,("/c/莲花/"+arr+".o"));
			destruct(armor);
			continue;
		}
		atype = armor->query("莲花/addType");
		if( wizardp(me) ) write(sprintf("size of att %d,%d\n",sizeof(att),sizeof(atype)));
		//解决残留问题

        if ( sscanf(f,"%s+%s+%s+%s",str1,str2,str3,str4)==4 )
		{
			hbl = hbl + 1;
			hb  = hb  + 2;
			if( member_array(str1,att) == -1 ) aa_t[str1] = atype[0]; //不存在则记录该类型
			if( member_array(str2,att) == -1 ) aa_t[str2] = atype[1]; //不存在则记录该类型
			if( member_array(str3,att) == -1 ) aa_t[str3] = atype[2]; //不存在则记录该类型
			if( member_array(str4,att) == -1 ) aa_t[str4] = atype[3]; //不存在则记录该类型

			if( member_array(str1,att)== -1 && member_array(str2,att)== -1 && member_array(str3,att)== -1 && member_array(str4,att)== -1)//用户身上没有该类型莲花
			{
				if ( wizardp(me) )
						tell_object(me,sprintf("%s 设置完毕\n%s 设置完毕\n%s 设置完毕\n%s 设置完毕\n%s 设置完毕\n",str1,str2,str3,str4,f));
				data[str1] = 2;
				data[str2] = 2;
				data[str3] = 2;
				data[str4] = 2;
				data[f] = 1;
			}
			else //有相同的莲花，则删除该档案
			{
				("/cmds/wiz/rm.c")->main(armor,("/c/莲花/"+arr+".o"));
				destruct(armor);
				continue;
			}

		}
        else if ( sscanf(f,"%s+%s",str1,str2)==2 )
		{
			hb = hb + 1;
			if( member_array(str1,att) == -1 ) aa_t[str1] = atype[0]; //不存在则记录该类型
			if( member_array(str2,att) == -1 ) aa_t[str2] = atype[1]; //不存在则记录该类型
			if( member_array(str1,att)== -1 && member_array(str2,att)== -1 )
			{
				if ( wizardp(me) )
						tell_object(me,sprintf("%s 设置完毕\n%s 设置完毕\n%s 设置完毕\n",str1,str2,f));
				data[str1] = 2;
				data[str2] = 2;
				data[f] = 1;
			}
			else //有相同的莲花，则删除该档案
			{
				("/cmds/wiz/rm.c")->main(armor,("/c/莲花/"+arr+".o"));
				destruct(armor);
				continue;
			}
		}
        else    {

			if( member_array(f,att) == -1 )
			{
				if ( wizardp(me) )
					tell_object(me,sprintf("%s 设置完毕\n%s",f,f));
				aa_t[f] = atype[0];
				data[f] = 1;
			}
			else //有相同的莲花，则删除该档案
				{
					("/cmds/wiz/rm.c")->main(armor,("/c/莲花/"+arr+".o"));
					destruct(armor);
					continue;
				}
			}

	}

	//
	att = keys(aa_t);
	i = sizeof(att);
	atype = keys(data);
	for( i =0;i<sizeof(att);i++ )
	{
		if( member_array(att[i],atype) == -1 )
		{
			data[att[i]] = 1;
			armor = new("/d/nanhai/obj/lianhua/lianhua");
			armor->setup();
			armor->set("owner_id",me->query("id"));
			arr = me->query("id");
			arr+= "/";
			arr+= att[i];
			armor->set("save_file",arr);
			armor->randomName();
			armor->set("莲花/lvl",5);
			armor->set("莲花/addType",aa_t[att[i]]);
			armor->set("armor_type",att[i]);
			armor->set("unit",a_types[att[i]][0]);
			armor->set_weight(a_types[att[i]][3]);
			p = a_types[att[i]][2];
			armor->set("armor_prop/base", p);
			p+= random(p/2);
			armor->set("armor_prop/armor",a_types[att[i]][2]);
			p = 5*3;
			p = p/2+random(p);
			if ( random(5)==1 )
			        set("armor_prop/dodge",1+random(p)-random(p/2));
			if ( random(5)==1 )
			        set("armor_prop/parry",1+random(p)-random(p/2));
			if ( random(5)==1 )
			        set("armor_prop/force",1+random(p)-random(p/2));
			if ( random(5)==1 )
			        set("armor_prop/spells",1+random(p)-random(p/2));
			if ( random(5)==1 )
        			set("armor_prop/literate",1+random(p)-random(p/2));

			armor->set("long",HIC"一"+a_types[att[i]][0]+"莲花，可以"+a_types[att[i]][1]+"\n"NOR);
			armor->save();
			destruct(armor);
			me->set_temp("need_poshi",1);
		}
	}
	me->set("莲花",data);
        if( me->query("give_hebing") == 0 && ( me->query_temp("need_poshi")||wizardp(me)) )
	{
		while(hbl-- )
		{
			armor = new("/d/nanhai/obj/lianhua/hebingl_m");
			armor->set("owner",me);
			if( !armor->move(me) )
			   {
				   tell_object(me,"你身上的东西太多了，不好意思，没办法给你了\n");
				   break;
			   }
		}
		while(hb-- )
		{
			armor = new("/d/nanhai/obj/lianhua/hebing_m");
			armor->set("owner",me);
			if( !armor->move(me) )
			   {
				   tell_object(me,"你身上的东西太多了，不好意思，没办法给你了\n");
				   break;
			   }
		}
		hb=4;
	    while(hb-- )
		{
			armor = new("/d/nanhai/obj/lianhua/lhconvert_m");
			armor->set("owner",me);
			if( !armor->move(me) )
			   {
				   tell_object(me,"你身上的东西太多了，不好意思，没办法给你了\n");
				   break;
			   }
		}

        if( !wizardp(me) )		me->set("give_hebing",1);
        log_file("lianhua_error",sprintf("[%s] 名字:%s(%s)修正莲花错误。\n",ctime(time()),me->query("name"),me->query("id"))); 
		}
	me->save();
	return "你的莲花记录已经修正完毕。";
}

void die()
{
if (environment())
        message("sound", "\n\n如来缓缓一点头：佛法无边！\n\n", environment());
powerup();
}

void unconcious()
{
die ();
}

int accept_object(object me, object ob)
{
if ( !me || !ob )  return 0;

if ( (string)ob->query("id")=="qiankun-tu" )
        {
        if ( (string)me->query("xiuluo/give_rulai") == "done")
                return notify_fail("如来佛说道：你已经得到惩罚了!\n");
        if ( (string)me->query("xiuluo/jinchanzi") != "done")
                return notify_fail("如来佛说道：这图是你的吗?!\n");
        command("chat "+me->query("name")+"你居然如此胆大妄为！\n");
        command("chat 看来你多年修成的正果只有白费了！\n");
        tell_object(me,"\n如来佛大袖朝你一拂...\n\n你好象已经忘记了以前的记忆。\n\n");
        command("rumor 听说"+me->query("name")+"被如来佛祖毁了西天修行！");
        me->delete("obstacle");
        me->set("xiuluo/give_rulai","done");
//        update_player(me);
        me->save();
        return 1;
        }
return 0;
}

private int update_player(object me)
{
object env, link_ob, obj;
object *ob, *dob;
mapping equip;
int i;


seteuid(getuid());
env = environment(me);

        // First, create the new body.
link_ob = me->query_temp("link_ob");
if (! link_ob)
        {
        link_ob = new(LOGIN_OB);
        link_ob->set("id", me->query("id"));
        if (! link_ob->restore())
                return 1;
        if (interactive(me))
        link_ob->set_temp("ip_number", query_ip_number(me));
        }

if (link_ob->query("id") != getuid(me))
        {
        write (sprintf("连接对象的ID(%s)和用户的ID(%s)不相同，不能"
                       "更新该玩家。\n", link_ob->query("id"), getuid(me)));
        return 1;
        }

obj = LOGIN_D->make_body(link_ob);
if (! obj) return 0;

        // Save the data and exec the player to his/her link object.
ob = all_inventory(me);
equip = ([ ]);
for (i = 0; i < sizeof(ob); i++)
        equip += ([ ob[i] : ob[i]->query("equipped") ]);
ob->move(VOID_OB);
me->save();
if (interactive(me))
        exec(link_ob, me);
destruct(me);
obj->restore();
LOGIN_D->enter_world(link_ob, obj, 1);
dob = all_inventory(obj);
for (i = 0; i < sizeof(dob); i++)
        destruct(dob[i]);

obj->move(env);
ob->move(obj);

if (! interactive(obj))
        destruct(link_ob);

for (i = 0; i < sizeof(ob); i++)
        {
        if (equip[ob[i]] == "worn")
                ob[i]->wear();
        if (equip[ob[i]] == "wielded")
                ob[i]->wield();
        }
obj->write_prompt();
return 1;
}


