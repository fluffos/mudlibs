inherit NPC;

string check_me()
{
string name;
object gift,*inv,me = this_player();
int i,flag = 0;

  if( me->query("gender")!="女性" )   return "这是TSRJ给所有女同胞的礼物，只有女同胞才能要";
inv = all_inventory(me);
for(i=0;i<sizeof(inv);i++)
        {
        name = inv[i]->query("name");
        if ( strsrch(name,"莲花")!=-1 )
                return "你已经有莲花了。";
        }
gift = new("/d/snowtu/obj/armor");
if ( gift->move(me) )
        message_vision(name()+"给$N一朵$n。\n",me,gift);
gift = new("/d/snowtu/obj/cloth");
if ( gift->move(me) )
        message_vision(name()+"给$N一朵$n。\n",me,gift);
gift = new("/d/snowtu/obj/shoes");
if ( gift->move(me) )
        message_vision(name()+"给$N一朵$n。\n",me,gift);
gift = new("/d/snowtu/obj/pifeng");
if ( gift->move(me) )
        message_vision(name()+"给$N一朵$n。\n",me,gift);
return "好好保存。";
}

void create()
{
set_name("湿婆",({"shi po","po"}));
set("age",10000);
set("gender","中性");
set("inquiry",([
        "莲花" : (:check_me:),
]));
setup();
}



