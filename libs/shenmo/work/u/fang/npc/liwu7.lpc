inherit NPC;
#include <ansi.h>

int give_bonnet();
int modify_haomao();
int update_player(object me);
int give_newbie();
int give_family();
int give_61gift();
int answer_me();
int title_change();
int check_legal_name(string name, int max_len);
void get_name(string arg, object me,object ob);

void create()
{
set_name(HIC"西游记--神魔传说精灵"NOR,({"npc jingling", "npc"})); 
set ("long", "他是在这里负责给大家发"HIY"新手礼物(gift)(newbie)"NOR"和"HIY"门派礼物(family)"NOR"的。\n");
set("gender",random(2)?"女性":"男性");
set("title",HIW"天"NOR HIG"上"NOR HIC"人"NOR HIY"间"NOR WHT"礼物"NOR HIW"使者"NOR);
set("age", random(10)+14);
set("per", 40);
set("attitude", "peaceful");
set("shen_type", 1);
set("inquiry", ([
     //           "头衔"          :       (:title_change:),
                "newbie"        :       (:give_newbie:),
                "gift"          :       (:give_newbie:),
                "礼物"          :       (:give_newbie:),
// "六一儿童节"      :   (: give_61gift :),
                "family"        :       (:give_family:),
                "新手礼物"      :       (:give_newbie:),
             "毫毛"        :        (: modify_haomao :),
                "门派礼物"      :       (:give_family:),
//            "五一礼物"        :       (:give_51liwu:),
]));
setup();
carry_object("/d/lingtai/obj/faguan")->wear();
}

private int update_player(object me)
{
        object env, link_ob, obj;
        object *ob, *dob;
        mapping equip;
        int i;


        seteuid(getuid());
        env = environment(me);

        // First, create the new body.
        link_ob = me->query_temp("link_ob");
        if (! link_ob)
        {
                link_ob = new(LOGIN_OB);
                link_ob->set("id", me->query("id"));
                if (! link_ob->restore())
                {
                        return 1;
                }
                if (interactive(me))
                        link_ob->set_temp("ip_number", query_ip_number(me));
        }

        if (link_ob->query("id") != getuid(me))
        {
                write (sprintf("连接对象的ID(%s)和用户的ID(%s)不相同，不能"
                       "更新该玩家。\n", link_ob->query("id"), getuid(me)));
                return 1;
        }

//        MONITOR_D->report_system_object_msg(this_player(),HIR"正在更新玩家"+"("+(string)me->query("name")+")!"NOR);

        obj = LOGIN_D->make_body(link_ob);
        if (! obj) return 0;

        // Save the data and exec the player to his/her link object.
        ob = all_inventory(me);
        equip = ([ ]);
        for (i = 0; i < sizeof(ob); i++)
                equip += ([ ob[i] : ob[i]->query("equipped") ]);
        ob->move(VOID_OB);

        // 保存用户的进度
        me->save();

        // 如果在线，移动互动对象
        if (interactive(me))
                exec(link_ob, me);
        destruct(me);

        // Restore new body and exec to it via enter_world in LOGIN_D
        obj->restore();
        LOGIN_D->enter_world(link_ob, obj, 1);
        dob = all_inventory(obj);
        for (i = 0; i < sizeof(dob); i++)
                destruct(dob[i]);

//        write("身体更新完毕。\n\n");
        obj->move(env);
        ob->move(obj);

        if (! interactive(obj))
                destruct(link_ob);

        for (i = 0; i < sizeof(ob); i++)
        {
                if (equip[ob[i]] == "worn")
                        ob[i]->wear();
                if (equip[ob[i]] == "wielded")
                        ob[i]->wield();
        }
        obj->write_prompt();

        return 1;
}


int give_61gift()
{
     object who,item;
     who=this_player();
     if (!userp(who)){
       command("heng");
       command("heng");
       command("say 什么小猫小狗也来要礼物？！");
       command("qi");
       return 1;
      }
     if ( who->query("liwu_61")>1 || who->query("give_61")>1 )
     {   command("heng");
        command("say 六一礼物只有一份!");
        return 1;
       }
      item=new("/u/lostcity/obj/liwu.lpc");
      item->move(who);
    who->set("give_61",2);
      command("say 节日快乐!");
      command("say 记得多来咱们西游记--神魔传说看看呀!");
   command("chat "+HIY"西游记--神魔传说全体巫师组"NOR+HIC"祝"NOR+HIW+who->query("name")+NOR HIC"六一儿童节快乐。\n"); 
      return 1;
}
