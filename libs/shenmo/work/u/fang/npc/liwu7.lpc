                who->set_skill("renshu",60);
                who->set_skill("fengyu-piaoxiang",60);
                who->set_skill("huoxin-sword",60);
                who->set_skill("sword",60);
                who->set_skill("huoxin-sword",60);
                who->map_skill("force", "guixi-force");
                who->map_skill("spells", "renshu");
                break; 

        default:
                command("heng");
                command("say "+who->query("name")+"你还是先去拜师吧，拜师之前你可以用\n
help menpai来看《三界神话》的各个门派介绍。\n");
                return 1;
        }       
who->set("lucky1",1);
command("nod "+who->query("id") );
command("chat "+HIW+family+NOR HIC"弟子"NOR+HIW+who->query("name")+NOR HIC"得到了门派奖励，希望以后多为本门派争光。\n");
return 1;
}

int accept_object(object me,object ob)
{
if ( !userp(me) )
        return notify_fail("小猫小狗的也来捣乱？！\n");
if ( ob->query("money_id") && ob->value() == 300000000 ) 
        {
        tell_object(me,name()+"一哈腰，说道：多谢您老，想改头衔问我关于 头衔 的事就行了。\n");
        me->set_temp("title_paid",1);
        return 1;
        }
return notify_fail("想改头衔？给我三万两黄金再说。\n");
}

int title_change()
{
string str;
object me = this_player();
object ob = this_object();

if ( !userp(me) || !me->query_temp("title_paid") )
        {
        command("say 想改头衔？给我三万两黄金再说。\n");
        return 1;
        }
tell_object(me,"\n请输入你想修改的头衔名：(可加颜色,按q键取消)");
input_to( (: get_name :), me,ob);
return 1;
}

void get_name(string arg, object me,object ob)
{
string  arg_old;

if( arg == "q" || arg == "Q" )    return;
        
arg += "$NOR$";
arg_old = arg;

arg = replace_string(arg, "$BLK$", "");
arg = replace_string(arg, "$RED$", "");
arg = replace_string(arg, "$GRN$", "");
arg = replace_string(arg, "$YEL$", "");
arg = replace_string(arg, "$BLU$", "");
arg = replace_string(arg, "$MAG$", "");
arg = replace_string(arg, "$CYN$", "");
arg = replace_string(arg, "$WHT$", "");
arg = replace_string(arg, "$HIR$", "");
arg = replace_string(arg, "$HIG$", "");
arg = replace_string(arg, "$HIY$", "");
arg = replace_string(arg, "$HIB$", "");
arg = replace_string(arg, "$HIM$", "");
arg = replace_string(arg, "$HIC$", "");
arg = replace_string(arg, "$HIW$", "");
arg = replace_string(arg, "$NOR$", "");

arg = replace_string(arg, "$HBRED$", "");
arg = replace_string(arg, "$HBGRN$", "");
arg = replace_string(arg, "$HBYEL$", "");
arg = replace_string(arg, "$HBBLU$", "");
arg = replace_string(arg, "$HBMAG$", "");
arg = replace_string(arg, "$HBCYN$", "");
arg = replace_string(arg, "$HBWHT$", "");
arg = replace_string(arg, "$BRED$", "");
arg = replace_string(arg, "$BGRN$", "");
arg = replace_string(arg, "$BYEL$", "");
arg = replace_string(arg, "$BMAG$", "");
arg = replace_string(arg, "$BCYN$", "");

if( !check_legal_name(arg,20) )  
        {
        tell_object(me,"\n请输入你想修改的头衔名：(可加颜色,按q键取消)");
        input_to( (: get_name :), me,ob);
        return;
        }

arg = arg_old;

arg = replace_string(arg, "$BLK$", BLK);
arg = replace_string(arg, "$RED$", RED);
arg = replace_string(arg, "$GRN$", GRN);
arg = replace_string(arg, "$YEL$", YEL);
arg = replace_string(arg, "$BLU$", BLU);
arg = replace_string(arg, "$MAG$", MAG);
arg = replace_string(arg, "$CYN$", CYN);
arg = replace_string(arg, "$WHT$", WHT);
arg = replace_string(arg, "$HIR$", HIR);
arg = replace_string(arg, "$HIG$", HIG);
arg = replace_string(arg, "$HIY$", HIY);
arg = replace_string(arg, "$HIB$", HIB);
arg = replace_string(arg, "$HIM$", HIM);
arg = replace_string(arg, "$HIC$", HIC);
arg = replace_string(arg, "$HIW$", HIW);
arg = replace_string(arg, "$NOR$", NOR);

arg = replace_string(arg, "$HBRED$",HBRED);
arg = replace_string(arg, "$HBGRN$",HBGRN);
arg = replace_string(arg, "$HBYEL$",HBYEL);
arg = replace_string(arg, "$HBBLU$",HBBLU);
arg = replace_string(arg, "$HBMAG$",HBMAG);
arg = replace_string(arg, "$HBCYN$",HBCYN);
arg = replace_string(arg, "$HBWHT$",HBWHT);
arg = replace_string(arg, "$BRED$",BRED);
arg = replace_string(arg, "$BGRN$",BGRN);
arg = replace_string(arg, "$BYEL$",BYEL);
arg = replace_string(arg, "$BMAG$",BMAG);
arg = replace_string(arg, "$BCYN$",BCYN);
        
me->set("title",arg+NOR);
me->delete_temp("title_paid");
me->save();
message_vision("$n对着$N念动咒语，一阵强光过后，$N的头衔已经变为："+me->query("title")+"。\n",me,ob);
return;
}

int check_legal_name(string name, int max_len)
{
int i;
i = strlen(name);
if( (strlen(name) < 2) || (strlen(name) > max_len ) ) 
        {
        write( sprintf("对不起，必须是 1 到 %d 个中文字。\n",max_len/2) );
        return 0;
        }
while(i--)   
        {
        if( name[i]<=' ' )   
                {
                write("对不起，不能用控制字元。\n");
                return 0;
                }
        if( i%2==0 && !is_chinese(name[i..<0]) )  
                {
                write("对不起，请您用「中文」取名。\n");
                return 0;
                }
        }
return 1; 
}



