int modify_haomao()
{
    int haomao;
   object me = this_object();
   object who = this_player();
   if ( !who->query("obstacle/reward") )
   {
     message_vision ("$N对$n摇了摇头：你先去西域过关吧。\n",me,who);
     return 1;
     }
   if ( who->query("obstacle/rebirth") >= 3 )
   {
     message_vision ("$N对$n摇了摇头：你已经没有毫毛了可以调整了。\n",me,who);
     return 1;
    }
   if ( who->query("haomao") >= 30 )
   {
     message_vision ("$N对$n摇了摇头：你毫毛太多了，用完了再来调整吧。\n",me,who);
     return 1;
     }
   haomao = 3 - (int)who->query("obstacles/rebirth");
   who->add("haomao",haomao);
   who->set("obstacle/rebirth",4);
   command("chat "+HIW+who->query("name")+NOR HIC"调整毫毛，希望继续努力呀。\n");
  update_player( who );
   return 1;
}
