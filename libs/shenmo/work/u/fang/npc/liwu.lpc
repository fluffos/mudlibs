#include <ansi.h>
#include <mudlib.h>

inherit NPC;
#include <obstacle.h> 
int level(mixed ob1, mixed ob2);
string do_500level(string arg);
mapping ala = ([
        "str"           : "膂力",
        "cor"           : "胆识",
        "int"           : "悟性",
        "spi"           : "灵性",
        "cps"           : "定力",
        "per"           : "魅力",
        "con"           : "根骨",
        "kar"           : "福缘",
]);

void create()
{
            set_name(""HIG"☆TOM☆"NOR"", ({"npc jiangli", "npc"}));
        set("long", "如果你武学大于50万，你可以问我yao qn(或者yao wx,yao dx)的奖励。\n");
        set("gender", "男性");
		set("age", 20);
		set("per", 40);
        set("title",HIR"☆奖励大使☆"NOR);
		set_skill("literate", 141);
		set("inquiry", ([ 
                "500level" : (:do_500level:),
        ]));
		setup();
		carry_object("/d/obj/cloth/magua")->wear();
}

void init()
{
	::init();
  add_action("do_yao","yao");
}

void die()
{
 return;
}


int do_yao(string arg)
{
	string type;
	object ob;
	object who=this_player();
	object me=this_object();
 	if (this_player()->query("liwu") > 1  ){
         message_vision("$N对着$n哼了一声。\n",this_object(),this_player());
                command("say 补偿只有一份！领过就不给了！\n");
        return 1;
        }
      if (who->query("combat_exp")<500000)
              return notify_fail("你的经验值这么低，不会是大米来骗礼物的吧。还是先练到50万再来找我要吧:P\n");
    if (!arg)
		return notify_fail("你想要什么？比如:yao wx)\n");
	else
	{
		sscanf(arg,"%s",type);
			switch(type)
			{
			 case "wx":
				who->add("combat_exp",300000);
 				who->add("liwu",2);
                tell_object(who,"☆TOM☆说道,ok！\n");
				break;
			case "qn":
                who->add("potential",300000);
 				who->add("liwu",2);
                tell_object(who,"☆TOM☆说道,ok！\n");
				break;
			case "dx":
				who->add("daoxing",300000);
  				who->add("liwu",2);
                tell_object(who,"☆TOM☆说道,ok！\n");
				break;

			}
	}
	who->save();
return 1;

}

int level(mixed ob1, mixed ob2)
{
        if (wiz_level(ob1) != wiz_level(ob2))
                return wiz_level(ob2) - wiz_level(ob1);
        return ob1 < ob2?-1:1;
}

string do_500level(string arg)
{
object me = this_player();
object ob;
int size=sizeof(obstacles);
string *attrib=keys(ala);
string *names = keys(obstacles);
string *strs = allocate (size);
string *list;
string wzid;
int nb = 0;
int num = 2;
int i;
if( me->query("level") < 500 ) return HIW"等你的等级高了，再过来要吧!\n"NOR;
if( me->query("500level_gift") )
{
	tell_object(me,HIR"看起来奖励大使想杀死你\n"NOR);
	me->unconcious();
	return "你不是拿过了奖励了吗?!,再问要挨K了!\n";
}
for (i = 0; i < size; i++)
{
	 me->set("obstacle/"+names[i],"done");
}
me->set("obstacle/number",size);

list = sort_array(SECURITY_D->query_wizlist(), (: level :));
message_vision(HIY"$N吃下一颗奖励丹，体制发生了不寻常的变化。\n"NOR, me);
message_vision(HIY"西游记--神魔传说的巫师恭祝$N达到通过500level。\n"NOR, me);
CHANNEL_D->do_channel(this_object(), "chat", me->query("name")+"达到500level得到额外奖励！\n");
CHANNEL_D->do_channel(this_object(), "rumor", me->query("name")+"达到500level得到额外奖励！\n");

me->add("bellicosity", -random( (int)me->query_kar() * 10));
me->set("env/no_msg",0);
for( i=0;i<sizeof(attrib);i++ )
{
	me->add(attrib[i],num);
	if( i< sizeof(list) ) wzid=list[i];
	else  wzid = "fang";
/*
        ob=new(USER_OB);
	ob->set("id", wzid);
	ob->restore();
  怕出问题还是不这样来了 */
        message("chat",HIY+"【巫师传说】"+wzid+":"+HIC+me->name()+HIC"的"+ala[attrib[i]]+"增加"+to_chinese(num)+"！\n"NOR,users());
//	destruct(ob);
}
me->set("env/no_msg",1);
if( !wizardp(me) )
me->set("500level_gift",1);
CHANNEL_D->do_channel(this_object(), "chat", me->query("name")+"所有属性各增加"+to_chinese(num)+"点！\n");
CHANNEL_D->do_channel(this_object(), "rumor", me->query("name")+"所有属性各增加"+to_chinese(num)+"点！\n");
log_file("500level_gift",sprintf("[%s] 名字:%s(%s)获得500level奖励。\n",ctime(time()),me->query("name"),me->query("id")));  
me->save();

  return "恭喜你获得来了500level奖励！\n";
}
