nosave int check_env(object who)
{
        object env;
        if( !who )
                return 0;
        if( who->query("combat_exp")>=2500000 )
        {
                tell_object(who,"你的武学过高，不能使用新手莲花\n");
                return 0;
        }
        if( who->query("daoxing")>=3000000 )
        {
                tell_object(who,"你的道行过高，不能使用新手莲花\n");
                return 0;
        }
        if( who->query("莲花") )
        {
                tell_object(who,"你已经开始使用八部莲花了，不能使用新手莲花了。\n");
                return 0;
        }
        if( who->query("zhuanshi") )
        { 
                tell_object(who,"你不是新手了吧。\n");
                return 0;
        }       
        return 1;
}

string song_msg()
{
        object hua,me = this_player();
        if( !userp(me) || !check_env(me) )
                return "你是坏银。。。";
        if( is_busy() )
                return "等等，我正忙着呢。";
                        
        if( me->query_temp("newbie_lianhua") )
                return "偶不是已经给过妳莲花了吗？！";          
                
        this_object()->start_busy(1);   
        hua = new("/d/nanhai/obj/lianhua/lianhua_newbie");
        if( hua )
        {
                if( hua->move(me) )
                {
                        me->set_temp("newbie_lianhua",hua);
                        message_vision("$N递给$n一朵"+hua->query("name")+"。\n",this_object(),me);
                }
                else    destruct(hua);
        }
        return "加油加油，超过二百五十万武学就可以去打八部莲花了。";
}       

void init()
{
        add_action("do_ask","ask");
}

int err_msg(string arg)
{
        write(arg);
        return 1;
}

int do_ask(string arg)
{
        string id,sth;
        object me = this_player();
        mixed *local;
        int wx;
        if( !arg )
                return 0;
        if( sscanf(arg,"%s about %s",id,sth)!=2 )
                return 0;
        if( !id(id) )
                return 0;
        if( sth!="国庆" )
                return 0;
        write("你阿浓打听有关『"HIC"国庆"NOR"』的消息。\n");
        if( time()<me->query_temp("guoqing_ask")+5 )
        {
                tell_object(me,REV+HIM"阿浓(Anong)告诉你：不要频繁问，我懒得睬你，再问我踩你哦。。。\n"NOR);
                return 1;
        }
        me->set_temp("guoqing_ask",time());
        local = localtime(time());
        if( local[5]!=2011 )
                return err_msg("今年是"+local[5]+"哦。\n");
        if( (local[4]+1)!=10 )
                return err_msg("现在是"+chinese_number(local[4]+1)+"月哦。\n");
        if( local[3]>7 )
                return err_msg("今天是"+chinese_number(local[3])+"号哦。\n");
        if( time()<me->query("giftmark/20111001")+10800 )
                return err_msg("你可以在"+time_string(me->query("giftmark/20111001")+10800-time())+"后再来。\n");
        me->set("giftmark/20111001",time());
        wx = 10000;
        wx = wx/2+random(wx);
        me->add("combat_exp",wx);
        me->add("daoxing",wx);
        me->add("potential",wx/10);
        tell_object(me,"节日快乐，你得到了"+wx+"点武学、"+COMBAT_D->chinese_daoxing(wx)+"道行以及"+(wx/10)+"点潜能。\n");
        log_file("reward",sprintf("[%s] %s 得到 %d 点 2011国庆节.\n",ctime(time()),me->query("id"),wx));
        return err_msg("节日快乐，三小时后你可以来再次要礼物。\n");
}

string ask_donate()
{
        object ob=this_player();
        string* dp;
        string id;
        int i;
        dp = keys(donate);
        id = ob->query("id");
        if( ob->query("donate/2011") ) return "感谢你对西游记--神魔传说的支持\n";
        if( member_array(id,dp) != -1 && ob->query("donate/2011")==0 )
        {
           i = donate[id];
           message("chat",HIY+"【捐款贡献】"+HIC+msg2[random(sizeof(msg2))]+": "+NOR+HIC+ob->query("name")+"获得了"+chinese_number(i)+"信用点奖励!\n"NOR,users());
           ob->add("c_balance_credit",i);
           ob->set("donate/2011",i);
           ob->save();
           log_file("donate",sprintf("[%s] 名字:%s(%s)奖励%s信用点。\n",ctime(time()),ob->query("name"),ob->query("id"),chinese_number(i)));  
           id = HIW"服务器的长期稳定，还需要你的多多帮助!\n"+HIY"西游记--神魔传说巫师组代表所有的玩家感谢你了!\n";
        }
        else {
           id = HIY"给西游记--神魔传说捐款的名单如下：\n"HIG;
           for( i=0;i< sizeof(dp);i++)
           {    id = id + dp[i] + "\t";
               if( i%4 == 3 ) id = id + "\n";
            }
            id = id + "\n";
         }
         
        id = id + HIY"希望你下次对我们继续支持呀!\n"NOR;
        return id;
}
