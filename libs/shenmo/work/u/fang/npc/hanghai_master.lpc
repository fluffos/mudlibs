int MaxKee = 500;
int t_damage = 300;

#define B1  YEL"民间"NOR"的"WHT"散银"NOR
#define B2  YEL"大臣"NOR"的"HIW"银库"NOR
#define B3  YEL"国王"NOR"的"HIY"白银"NOR
#define B4  YEL"公主"NOR"的"HIY"黄金"NOR
#define B5  YEL"王后"NOR"的"HIG"黄金"NOR
#define B6  YEL"仙人"NOR"的"HIR"黄金"NOR
#define B7  YEL"国王"NOR"的"HIC"宝藏"NOR
#define B8  YEL"仙人"NOR"的"HIM"宝藏"NOR
#define B9  YEL"天神"NOR"的"HIY"宝藏"NOR
#define B10  YEL"散落"NOR"的"YEL"货币"NOR

#define O1  new("/obj/money/silver")
#define O2  new("/obj/money/silver")
#define O3  new("/obj/money/silver")
#define O4  new("/obj/money/gold")
#define O5  new("/obj/money/gold")
#define O6  new("/obj/money/gold")
#define O7  new("/obj/money/gold")
#define O8  new("/obj/money/gold")
#define O9  new("/obj/money/gold")
//
// jinbi太多了 暂时取消
//#define O9  new("/obj/money/jinbi")
#define O10  new("/obj/money/coin")

string game_now = "等待移动命令";
string att_now = "not_ok";
int target_hp, target_damage;
string pic_me, pic_target;

void new_game_set( int amount, string mark );
void map();
void check_hp();
void check_player( object me );
