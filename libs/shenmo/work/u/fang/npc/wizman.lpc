// created fang@tsrj
#include <ansi.h>
#define DRUGPATH __DIR__"drug/"
#define LHPATH __DIR__"lianhua/"
#define JB 10000000
inherit NPC;
string ask_attribute();
string ask_skills();
string ask_shen();
string ask_lianhua();
string ask_dans();
string ask_donate();
string help(object ob);
mapping donate = ([
  "fang": 1000,
  "fong": 10,
]);

mapping attribute = ([
  "str": ({ "shenliwan", "膂力", }),
  "int": ({ "xiandan", "悟性", }),
  "cor": ({ "cordan", "胆识", }),
  "cps": ({ "cpsdan", "定力", }),
  "kar": ({ "kardan", "福缘", }),
  "per": ({ "perdan", "美容", }),
  "spi": ({ "spidan", "灵性", }),
  "con": ({ "xisuidan", "根骨", }),
]);

string *msg2 = ({
  "暗黑破坏神(Diablo)",
  "方舟(Fang)",
  "乱(Run)",
  "狐媚(Shulele)",
  "眠兔(Snowtu)",
  "舒乐乐(Sulele)",
  "风无影(Windy)",
  "开心汤姆(Tom)",
});
mapping lianhua = ([
  "xsj": ({ "lhshengji", "小升级", }),
  "zsj": ({ "lhshengjim", "中升级", }),
  "dsj": ({ "lhshengjil", "大升级", }),
  "zhh": ({ "lhconvert", "转换丹", }),
  "xhb": ({ "hebing", "小合并", }),
  "dhb": ({ "hebingl", "大合并", }),
]);
mapping dans = ([
  "cordan": ({ HIR "破煞丹" NOR }),
  "cpsdan": ({ HIC "镇元丹" NOR }),
  "kardan": ({ HIY "福缘丹" NOR }),
  "perdan": ({ HIM "美容丹" NOR }),
  "shenliwan": ({ HIG "神力丸" NOR }),
  "spidan": ({ HIW "太极丹" NOR }),
  "xisuidan": ({ YEL "洗髓丹" NOR }),
  "xiandan": ({ HIY "仙  丹" NOR }),
]);
mapping xx = ([
  "mao": ({ "haomao", "龟鹤丹", }),
  "sy1": ({ "haomao", "圣衣小", }),
  "sy2": ({ "haomao", "圣衣中", }),
  "sy3": ({ "haomao", "圣衣大", }),
]);
void create() {
  set_name(HIY "大神" NOR, ({ "da shen", "shen", "dashen" }));
  set("title", HIG "不老传说" NOR);
  set("gender", "男性");
  set("age", 10000);
  set("per", 30);
  set("long", "传说中跳出三界,不入五行,不死不灭的,游戏世界的创造者。\n");
  set("combat_exp", 10000000);
  set("daoxing", 2000000);

  set_skill("force", 500);
  set_skill("spells", 500);
  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_skill("parry", 500);
  set("gin", 50000);
  set("max_gin", 50000);
  set("kee", 50000);
  set("max_kee", 50000);
  set("sen", 50000);
  set("max_sen", 50000);
  set("force", 15000);
  set("max_force", 15000);
  set("mana", 15000);
  set("max_mana", 15000);
  set("force_factor", 1000);
  set("inquiry", ([
    "属性丹": (: ask_attribute :),
    "莲花丹": (: ask_lianhua :),
    "dans": (: ask_dans :),
    "shen": (: ask_shen :),
    "donate": (: ask_donate :),
    "skills": (: ask_skills :),
  ]));

  setup();
}
string ask_shen() {
  object ob = this_player();
  if (ob->query("c_balance") < 30 * JB)
    return "你的钱太少了，等你有钱了再来买吧！\n";
  ob->add("c_balance", -30 * JB);
  ob->add("shen", 200);
  tell_object(ob, "你的神增加200点\n");
  log_file(
    "sell_shen",
    sprintf("[%s] 名字:%s(%s)购买得200点神。\n", ctime(time()), ob->query("name"), ob->query("id"))
  );
  message(
    "channel:rumor",
    HIY + "【黑市交易】" + HIC + "大神(Da shen): " + NOR + HIC + ob->query("name") + "购买了200点神!\n" NOR,
    users()
  );
  return "你可要继续努力呀\n";
}
string ask_dans() {
  object ob = this_player();
  int i;
  string *dns;
  string *gft;
  mapping gt;
  gt = ob->query("gift");
  if (!mapp(gt)) return "你好像没吃过属性丹\n";
  if (ob->query_temp("ask_dans")) return "问过了,还问?\n";
  gft = keys(gt);
  dns = keys(dans);
  for (i = 0; i < sizeof(gft); i++) {
    if (member_array(gft[i], dns) != -1)
      tell_object(
        ob,
        "你已经吃过" + HIW + chinese_number(gt[gft[i]]) + NOR + "个" + dans[gft[i]][0] + "\n"
      );
    else
      continue;
  }
  ob->set_temp("ask_dans", 2);
  return "你还要继续努力呀\n";

}

int level(mixed ob1, mixed ob2) {
  if (wiz_level(ob1) != wiz_level(ob2))
    return wiz_level(ob2) - wiz_level(ob1);
  return ob1 < ob2 ? -1 : 1;
}

string ask_attribute() {
  object ob = this_player();
  string *cs;
  string str;
  int i;
  if (ob->query("shen") < 1000 || ob->query("c_balance") < 10 * JB)
    return help(ob);
  cs = keys(attribute);
  str = "";
  for (i = 0; i < sizeof(cs); i++) {
    write(attribute[cs[i]][1] + ":" + cs[i] + "\t");
    if (i % 4 == 3) write("\n");
    str = str + cs[i];
    str = str + ",";
  }
  str = str + ")退去(exit";

  write("请选择你需要购买的属性丹类型（" + str + "）：\n");
  input_to("get_zhongzu", ob);
  return "恭喜你获得想要的属性丹!\n";

}

private void get_zhongzu(string arg, object ob) {
  mapping cs_status;
  object obj;
  int cnt;
  string *cs;
  cs = keys(attribute);
  if (arg == "") {
    write("请选择你需要购买的属性丹类型：\n");
    input_to("get_zhongzu", ob);
    return;
  }
  if (arg == "exit") {
    write("欢迎你下次再来购买。\n");
    return;
  }
  if (member_array(arg, cs) == -1) {
    write("请选择你正确的属性丹类型：\n");
    input_to("get_zhongzu", ob);
    return;
  } else {
    obj = new(DRUGPATH + attribute[arg][0]);
    if (!obj->move(ob)) {
      destruct(obj);
      write("你身上的物品太多了!\n");
      return;
    }

    message(
      "channel:rumor",
      HIY + "【黑市交易】" + HIC + msg2[random(sizeof(msg2))] + ": " + NOR + HIC + ob->query("name") + "购买了" + attribute[arg][1] + "属性丹!\n" NOR,
      users()
    );
    ob->add("shen", -1000);
    ob->add("c_balance", -10 * JB);
    ob->save();
    log_file(
      "blackmarket",
      sprintf(
        "[%s] 名字:%s(%s)购买得%s丹(%s)。\n",
        ctime(time()),
        ob->query("name"),
        ob->query("id"),
        attribute[arg][1],
        arg
      )
    );
    //message("vision",
  }

}

string ask_lianhua() {
  object ob = this_player();
  string *cs;
  string str;
  int i;
  if (ob->query("shen") < 2000 || ob->query("c_balance") < 50 * JB)
    return help(ob);
  cs = keys(lianhua);
  str = "";
  for (i = 0; i < sizeof(cs); i++) {
    write(lianhua[cs[i]][1] + ":" + cs[i] + "\t");
    if (i % 3 == 2) write("\n");
    str = str + cs[i];
    str = str + ",";
  }
  str = str + ")退去(exit";

  write("请选择你需要购买的莲花类型（" + str + "）：\n");
  input_to("get_lianhua", ob);
  return "恭喜你获得梦寐以求的莲花丹!\n";

}

private void get_lianhua(string arg, object ob) {
  mapping cs_status;
  object obj;
  int cnt;
  string *cs;
  cs = keys(lianhua);
  if (arg == "") {
    write("请选择你需要购买的属性丹类型：\n");
    input_to("get_lianhua", ob);
    return;
  }
  if (arg == "exit") {
    write("欢迎你下次再来购买。\n");
    return;
  }
  if (member_array(arg, cs) == -1) {
    write("请选择你正确的属性丹类型：\n");
    input_to("get_lianhua", ob);
    return;
  } else {
    obj = new(LHPATH + lianhua[arg][0]);
    if (!obj->move(ob)) {
      destruct(obj);
      write("你身上的物品太多了!\n");
      return;
    }
    message(
      "channel:rumor",
      HIY + "【黑市交易】" + HIC + msg2[random(sizeof(msg2))] + ": " + NOR + HIC + ob->query("name") + "购买了" + lianhua[arg][1] + "丹!\n" NOR,
      users()
    );
    ob->add("shen", -2000);
    ob->add("c_balance", -50 * JB);
    ob->save();
    log_file(
      "blackmarket",
      sprintf(
        "[%s] 名字:%s(%s)购买得%s丹(%s)。\n",
        ctime(time()),
        ob->query("name"),
        ob->query("id"),
        lianhua[arg][1],
        arg
      )
    );
  }

}

string help(object ob) {
  if (ob->query("shen") < 1000)
    tell_object(ob, "你的神数太少，我不能卖给你!\n");
  if (ob->query("c_balance") < 80 * JB)
    tell_object(ob, "你的存款太少，我不敢卖给你!\n");
  return "穷光蛋一个，用什么来购买？\n";
}

string ask_skills() {
  object ob = this_player();
  int i;
  string *dns;
  string *gft;
  mapping gt, sk;
  gt = ob->query_learned();
  sk = ob->query_skills();
  if (!mapp(gt) || !mapp(sk)) return "你好像没学过任何技能\n";
  gft = keys(gt);
  dns = keys(sk);
  if (sizeof(gft) <= sizeof(dns)) return "你的学习技能与学习点不需要修正\n";
  for (i = 0; i < sizeof(gft); i++) {
    if (member_array(gft[i], dns) == -1) {
      ob->delete_skill(gft[i]);
    }

  }
  ob->save();
  tell_object(ob, "只见大神口念念有词，在你的头顶拍了一下，一股暖流，流过你的全身，你觉得无比的舒服\n");
  return "你的学习技能与学习点相匹配\n";

}

string ask_donate() {
  object ob = this_player();
  string *dp;
  string id;
  int i;
  dp = keys(donate);
  id = ob->query("id");
  if (member_array(id, dp) != -1) {
    i = donate[id];
    message(
      "channel:rumor",
      HIY + "【捐款贡献】" + HIC + msg2[random(sizeof(msg2))] + ": " + NOR + HIC + ob->query("name") + "获得了" + chinese_number(i) + "信用点奖励!\n" NOR,
      users()
    );
    ob->add("c_balance_credit", i);
    ob->save();
    id = "服务器的长期稳定，还需要你的多多帮助，西游记--神魔传说巫师组代表所有的玩家感谢你了!\n";
  } else {
    id = HIY "给西游记--神魔传说捐款的名单如下：\n" HIG;
    for (i = 0; i < sizeof(dp); i++) {
      id = id + dp[i] + "\t";
      if (i % 4 == 3) id = id + "\n";
    }
  }

  id = id + "\n" + NOR + HIY "希望你下次对我们继续支持呀!\n" NOR;
  return id;
}
