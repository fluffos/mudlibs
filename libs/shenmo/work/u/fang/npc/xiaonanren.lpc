#include <ansi.h>
inherit NPC;

string ask_donate();
string ask_comp();
//老周，ID是oscar，金额是1000，嘿
//捐款id:wtc  100RMB 请发 nvwa 这个id
// egg 200 king 200 xiaodou 100 根据小男人的短信增加 2013.10.10
// 2012捐赠历史：fang 1000,oscar 1000,yaode 500,nvwa 100,cyf 100, superwsc 300,saga 300, ash 150, asl 150, asp 150,
//          koushui 696,tianyi 100,tianer 100, wahaha 200, isis 100, egg 200,king 200,xiaodou 100,lusheng 200,qsfwaaa 200,tange 200
//          yzgl 200, luocha 100,chiyou 100,human 150 open 150
//          2015年捐款记录 whf 200
mapping donate = ([

"shulele"     : 300,
"amy"     : 150,


]);
string *msg2 = ({

        "舒乐乐(Sulele)",

});

void create()
{
        string msg;
        set_name(HIY"小男人"NOR, ({"xiao nanren","nanren",}));
        msg = HIW"小男人是个思想上有依赖性，不独立，比较单纯，不那么世俗，身上略带有小女人的特质，爱家爱老婆，会帮老婆做家务的大男人"NOR;
        msg = SDS_D->color_msg(msg);
        set("long",msg+"\n"NOR);
        set("title",HIC"财务总管"NOR);
        set("name_color","HIM");
        set("gender", "男性");
        set("combat_exp", 1000);
        set("age", 26);
        set("per", 40);
        set("attitude", "friendly");
        set("shen_type", 1);
        set_skill("unarmed", 10);
        set("max_price",160);
        set("inquiry", ([
                 "donate":         (:ask_donate:),
//                 "补偿":         (:ask_comp:),
        ]));
        setup();
        carry_object("/d/obj/cloth/skirt")->wear();
}



string ask_donate()
{
        object ob=this_player();
        string* dp;
        string id;
        string year;
        int i;
        dp = keys(donate);
        id = ob->query("id");
        year = "2019.";
        if( ob->query("donate/"+year) ) return "感谢你对西游记--神魔传说的支持\n";
        if( member_array(id,dp) != -1 && ob->query("donate/"+year)==0 )
        {
           i = donate[id];
           message("chat",HIY+"【捐款贡献】"+HIC+msg2[random(sizeof(msg2))]+": "+NOR+HIC+ob->query("name")+year+"年，为服务器捐献"+HIY+"RMB"+donate[id]+NOR+HIC+"，获得了"+chinese_number(i)+"捐献点奖励!\n"NOR,users());
           ob->add("c_balance_credit",i);
           ob->set("donate/"+year,i);
           ob->save();
           log_file("donate",sprintf("[%s] 名字:%s(%s)奖励%s信用点。\n",ctime(time()),ob->query("name"),ob->query("id"),chinese_number(i)));
           id = HIW"服务器的长期稳定，还需要你的多多帮助!\n"+HIY"西游记--神魔传说巫师组代表所有的玩家感谢你了!\n";
        }
        else {
           id = HIY"给西游记--神魔传说 2018 捐款的名单如下：\n"HIG;
           for( i=0;i< sizeof(dp);i++)
           {    id = id + dp[i] + "\t";
               if( i%4 == 3 ) id = id + "\n";
            }
            id = id + "\n";
         }

        id = id + HIY"希望你下次对我们继续支持呀!\n"NOR;
        return id;
}

string ask_comp()
{
        object ob=this_player();
        if( ob->query("20130609") ) return "感谢你的勤奋，只是补偿只有一份!\n";
        command("bow "+ob->query("id"));
        command("sorry "+ob->query("id"));
        ob->add("potential",2000000);
        ob->add("daoxing",1000000);
        tell_object(ob,"你增加了2百万潜能\n");
        tell_object(ob,"你增加了一千年道行\n");
        ob->add("combat_exp",1000000);
        tell_object(ob,"你增加了一百万武学\n");
        ob->add("haomao",6);
        ob->set("20130609",1);
        tell_object(ob,"你增加了六根毫毛\n");
        ob->save();
        if( ob->query("level") > 100 ) {ob->add("c_balance",200000000);tell_object(ob,"你卡内增加黄金2万两\n");};
           message("chat",HIY+"【灾难补偿】"+HIC+msg2[random(sizeof(msg2))]+": "+NOR+HIC+ob->query("name")+HIC+"获得了灾难补偿!\n"NOR,users());
        return HIY"希望你下次对我们继续支持呀!\n"NOR;
}
