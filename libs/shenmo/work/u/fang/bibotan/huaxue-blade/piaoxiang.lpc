#include <ansi.h>
inherit PERFORM;

int set_damage()
{
int damage;
object me = this_player();
damage+= me->query("force_factor")*2;
damage=(int)me->query_skill("blade")+random((int)me->query_skill("blade")); 
damage+= me->query_temp("apply/damage");
return damage;
}

void create()
{
set("name",HIR"血海飘香"NOR);
set("class","yao");
set("belong","huaxue-blade");
set("base_type","blade");
set("persent",250);
set("target",1);
set("force",800);
set("need_force",100);
set("betray_lvl",350);
set("damage_type","eff_kee");
set("limit_skill",([
    "huaxue-blade":60,
    "blade":120,
    "force":120,
"zhuanlong-force":120,
]));
set("limit_other",([
    "sen"   : 400,
]));
set("temp","bibotan/px");
set("temp_time",(2+random(3)));
}

void hit_msg(object me,object target,int num)
{
string msg;
if ( me && target&&num==1 )
	{
      set("damage",(: set_damage :) );
      message_vision(HIC "\n$N一声清啸，气运丹田，围绕$n疾转，手中宝刀闪出无数血红的刀光!\n        
"HIR"$n顿觉四周眼花缭乱，仿佛置身于重重血海之中......"NOR"
"HIC"却见$N突然身形一顿，人刀合一，带着一丝淡淡的血光，穿向$n......\n"NOR,me,target); 
     	}
}

void success_hit_msg(object me,object target,int num)
{
string msg;
if ( me && target )
	{
              message_vision(HIM"\n$n只觉一股热流穿心而过，喉头一甜，鲜血狂喷而出！\n"NOR,me,target); 
	}
}

void lost_hit_msg(object me,object target,int num)
{
string msg;
if ( me && target )
	{
        message_vision(HIM"\n可是$n猛地向边上一跃,跳出了$N的攻击范围。\n"NOR,me,target); 
	}
}

void normal_hit_msg(object me)
{
int damage;
string msg;
if ( me )
	{
 	msg = HIC "但是被对方以内力一逼，指力尽数反挫！\n" NOR;
       msg+= HIC "结果只听喀嚓！几声，$N"HIC"十指几乎全部折断！\n" NOR;
        message_vision(msg,me);
	damage = query("damage");
	damage = damage/5+random(damage/5);
	if ( damage>0 )
		{
		me->receive_damage("kee",damage);
		COMBAT_D->report_status(me);
		}
	}
}


