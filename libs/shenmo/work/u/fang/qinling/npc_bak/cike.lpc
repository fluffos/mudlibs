set("title", HIR"战国刺客"NOR); 
set("long", "风萧萧兮易水寒,壮士一去兮不复还！\n"); 
set("combat_exp", 100000000+random(100000000)); 
set("daoxing", 100000000+random(100000000)); 
set("per", 20+random(10));
set("kar", 100);
set("attitude", "friendly"); 
set("max_kee", 150000+random(30000)); 
set("kee", 150000); 
set("max_sen", 120000+random(30000)); 
set("sen", 150000); 
set("max_force", 15000+random(6000)); 
set("force", 20000); 
set("max_mana", 15000+random(6000)); 
