set_skill("parry", 800+random(300)); 
set_skill("spells", 800+random(300)); 
set_skill("dao", 800+random(300)); 
set_skill("sword", 800+random(300)); 
set_skill("spysword", 800+random(300)); 
set_skill("stick", 800+random(300)); 
set_skill("qianjun-bang", 800+random(300)); 
set_skill("fork", 800+random(300)); 
set_skill("fengbo-cha", 800+random(300)); 
set_skill("staff", 800+random(300)); 
set_skill("fumo-zhang", 800+random(300)); 
set_skill("dragonforce", 800+random(300)); 
set_skill("buddhism", 800+random(300)); 
set_skill("lotusforce", 800+random(300)); 
set_skill("unarmed", 800+random(300)); 
set_skill("dragonfight", 1100); 
set_skill("literate", 800+random(300)); 
map_skill("force", "wuxiangforce"); 
map_skill("spells", "dao"); 
map_skill("unarmed", "dragonfight"); 
map_skill("sword", "spysword"); 
map_skill("staff", "fumo-zhang"); 
map_skill("fork", "fengbo-cha"); 
map_skill("dodge", "piaoxiang"); 
map_skill("stick", "qianjun-bang"); 
map_skill("parry", "qianjun-bang"); 
/*
set("chat_chance_combat", 100); 
set("chat_msg_combat", ({  
        (: perform_action, "sword", "bishou" :),  
        (: perform_action, "sword", "dao" :),  
        (: perform_action, "sword", "name" :),  
        (: perform_action, "staff", "fuhu" :),  
        (: perform_action, "fork", "fengbo" :),  
        (: perform_action, "fork", "jiutian" :),  
