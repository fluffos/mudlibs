set("force_factor", 700+random(100)); 
set("mana_factor", 600); 
set("任务",1); 
set("莲花",1);
set("chat_chance", 30); 
set("chat_msg", ({ 
CYN"秦王不死，于苍生何！？\n"NOR,
(: random_move :),
(: random_move :),
(: random_move :),
(: random_move :),
(: random_move :),
}) );  
set_skill("force", 800+random(300)); 
set_skill("wuxiangforce", 800+random(300)); 
set_skill("changshengjue", 800+random(300)); 
set_skill("dodge", 800+random(300)); 
