#include <ansi.h>
inherit __DIR__ "super_npc2.lpc";
string *names = ({
  HIR "杀人恶魔" NOR,
  HIY "变态色魔" NOR,
  YEL "朝廷叛逆" NOR,
  RED "纵火元凶" NOR,
  HIG "江洋大盗" NOR,
  HIB "山贼头领" NOR,
  HIC "地方恶霸" NOR,
  HIW "皇宫刺客" NOR,
  WHT "冒牌太监" NOR,
  YEL "人口贩子" NOR,
  HIW "日本海盗" NOR,
  HIM "突厥奸细" NOR,
});
void create() {
  string str;
  set_name(names[random(sizeof(names))], ({ "xiong fan", "xiong", "fan" }));
  set("gender", "男性");
  set("class", "yaomo");
  set("title", HIR "官府通缉千金悬赏" NOR);
  set("level", 150);
  set("age", 25 + random(20));
  set("long", "一个穷凶极恶暴徒,一看就知道有血案在身。\n");
  set("combat_exp", 10000000 + random(10000000));
  set("daoxing", 10000000 + random(10000000));
  set("attitude", "aggressive");
  set("env/wimpy", 10 + random(10));
  set("max_kee", 50000 + random(30000));
  set("kee", 70000);
  set("max_sen", 50000 + random(30000));
  set("sen", 70000);
  set("max_force", 5500 + random(1000));
  set("force", 9000);
  set("max_mana", 5500 + random(1000));
  set("mana", 9000);
  set("force_factor", 400 + random(100));
  set("任务", 1);
  set("莲花", 1);
  set("chat_chance", 30);
  set("chat_msg", ({
    CYN "朝廷这帮鹰犬，都把老子追到这里了！饿死我了！人肉我也吃！\n" NOR,
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
  }));
  set_skill("axe", 400 + random(200));
  set_skill("sword", 400 + random(200));
  set_skill("blade", 400 + random(200));
  set_skill("whip", 400 + random(200));
  set_skill("fork", 400 + random(200));
  set_skill("force", 400 + random(200));
  set_skill("spells", 400 + random(200));
  set_skill("unarmed", 400 + random(200));
  set_skill("dianxue", 400 + random(200));
  set_skill("dodge", 400 + random(200));
  set_skill("parry", 400 + random(200));
  set_skill("literate", 400 + random(200));
  set_skill("sanban-axe", 400 + random(200));
  set_skill("xiaoyao-sword", 400 + random(200));
  set_skill("tianlang-blade", 400 + random(200));
  set_skill("liudu-whip", 400 + random(200));
  set_skill("yueya-fork", 400 + random(200));
  set_skill("jiayi-force", 400 + random(200));
  set_skill("baguazhou", 400 + random(200));
  set_skill("yanxing-steps", 400 + random(200));
  map_skill("force", "jiayi-force");
  map_skill("spells", "baguazhou");
  map_skill("axe", "sanban-axe");
  map_skill("sword", "xiaoyao-sword");
  map_skill("blade", "tianlang-blade");
  map_skill("fork", "yueya-fork");
  map_skill("whip", "liudu-whip");
  map_skill("unarmed", "dianxue");
  map_skill("parry", "xiaoyao-sword");
  map_skill("dodge", "yanxing-steps");
  /*
set("chat_chance_combat", 100);
set("chat_msg_combat", ({ 
        (: perform_action, "unarmed", "dianxue" :), 
        (: exert_function, "recover" :),  
        (: cast_spell, "zhaoyaojing" :),  
}) );
*/
  SDS_D->powerup(this_object());
  setup();
  carry_object("/d/eastway/qinling/obj/tongbox")->set_amount(random(1));
  carry_object("/d/obj/stey/xianyi")->wear();
  str = "/d/qujing/kusong/obj/weapon0";
  str[strlen(str) - 1] = '0' + random(5);
  carry_object(str)->wield();
}
void die() {
  object me = query_temp("last_damage_from");
  if (!me
    || !present(me, environment())
    || !userp(me)
    || !living(me)) {
    ::die();
    return;
  }
  if ((int)me->query("combat_exp") / 10000 < 7500) {
    me->add("combat_exp", 800 + random(400));
    me->add("daoxing", 800 + random(400));
    me->add("potential", 160 + random(80));
    tell_object(me, YEL "你的武功修为提高了。\n" NOR);
  }
  ::die();
}
