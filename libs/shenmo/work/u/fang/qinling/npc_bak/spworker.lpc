void create()
{
string str;
int i = random(sizeof(names));
set_name(names[i]+nm2[random(sizeof(nm2))]+nm3[random(sizeof(nm3))], 
 ({ "worker man", "worker", "man" }));
set("gender", "男性");
set("莲花", 1);
set("level", 250);
set("class", "human");
set("title", HIR"修筑秦陵殉葬百姓"NOR);
set("age", 35+random(20));
set("long", "他衣衫褴褛,面黄肌瘦，满脸悲愤，似乎有说不完的冤情！\n");
set("combat_exp", 30000000+random(20000000));
set("daoxing", 30000000+random(30000000));
set("attitude", "friendly");
set("max_kee", 180000+random(30000));
set("kee", 220000);
set("max_sen", 160000+random(30000));
set("sen", 166666);
set("max_force", 6000+random(2000));
set("force", 20000);
set("max_mana", 6000+random(2000));
set("mana", 20000);
set("force_factor", 500+random(100));
set("taskguai",1);
set("mana_factor", 500+random(100));
set("chat_chance", 30);
set("chat_msg", ({ 
CYN"赢政！你这个暴君，还我命来！\n"NOR,
(: random_move :), 
(: random_move :), 
(: random_move :), 
(: random_move :), 
(: random_move :), 
}) ); 
set_skill("force", 500+random(200));
set_skill("spells", 500+random(200));
set_skill("zixia-shengong", 500+random(200));
set_skill("jiuyin-force", 500+random(200));
set_skill("zhuanlong-force", 500+random(200));
set_skill("taoism", 500+random(200));
set_skill("sword", 500+random(200));
set_skill("yujianshu", 500+random(200));
set_skill("blade", 500+random(200));
set_skill("parry", 500+random(200));
set_skill("huaxue-blade", 500+random(200));
set_skill("spear", 500+random(200));
set_skill("huoyun-qiang", 500+random(200));
set_skill("mace", 500+random(200));
set_skill("yinlei-mace", 500+random(200));
set_skill("whip", 500+random(200));
set_skill("yinsuo-jinling", 500+random(200));
set_skill("fork", 500+random(200));
set_skill("yueya-fork", 500+random(200));
set_skill("unarmed", 500+random(200));
set_skill("hunyuan-zhang", 500+random(200));
set_skill("dodge", 500+random(200));
set_skill("sevensteps", 500+random(200));
map_skill("force", "zixia-shengong");
map_skill("spells", "taoism");
map_skill("sword", "yujianshu");
map_skill("unarmed", "hunyuan-zhang");
map_skill("parry", "yujianshu");
map_skill("dodge", "sevensteps");
map_skill("blade", "huaxue-blade");
map_skill("whip", "yinsuo-jinling");
map_skill("mace", "yinlei-mace");
map_skill("fork", "yueya-fork");
set("chat_chance_combat", 100);
set("chat_msg_combat", ({ 
        (: cast_spell, "shou" :),
}) );
create_family("蜀山剑派", 2, "蓝");
setup();
carry_object("/d/eastway/qinling/obj/yinbox")->set_amount(random(1));
carry_object("/d/obj/cloth/linen")->wear();
str = "/d/qujing/yinwu/obj/weapon0";
str[strlen(str)-1] = '0'+random(6); 
carry_object(str)->wield();  
}
void die()
{
object me = query_temp("last_damage_from"); 
if ( !me 
|| !present(me,environment()) 
|| !userp(me) 
|| !living(me) ) 
{ 
::die(); 
return;  
}
if ((int)me->query("combat_exp")/10000<20000)
{
me->add("combat_exp",2000); 
me->add("daoxing",2000); 
me->add("potential",400); 
tell_object(me,YEL"你的武功修为提高了。\n"NOR);  
}
::die(); 
}
