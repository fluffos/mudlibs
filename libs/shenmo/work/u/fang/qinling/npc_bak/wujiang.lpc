HIY"孙  膑"NOR, 
HIY"蒙  恬"NOR, 
HIY"章  邯"NOR, 
}); 
void create() 
{
string str;
set_name(names[random(sizeof(names))], ({"zhanguo mingjiang", "mingjiang", "jiang"}));
set("gender", "男性"); 
set("class", "human"); 
set("level", 800);
set("age", 40+random(20));  
set("env/wimpy", 30+random(20));
set("cor", 100);
set("莲花",1);
set("kar", 100);
set("per", 20+random(20));
set("title", HIW"战国名将"NOR); 
set("long", "一生转战三千里,一剑曾挡百万师！\n"); 
set("combat_exp", 200000000+random(100000000)); 
set("daoxing", 200000000+random(100000000)); 
set("attitude", "friendly"); 
set("max_kee", 200000+random(50000)); 
set("kee", 200000); 
set("max_sen", 180000+random(50000)); 
set("sen", 200000); 
set("max_force", 20000+random(6000)); 
set("force", 40000); 
set("max_mana", 20000+random(6000)); 
set("mana", 40000); 
set("force_factor", 800+random(100)); 
set("mana_factor", 800+random(100)); 
set("任务",1); 
set("chat_chance", 30); 
set("chat_msg", ({ 
CYN"三十功名尘与土，八千里路云和月！\n"NOR,
(: random_move :),
(: random_move :),
(: random_move :),
(: random_move :),
(: random_move :),
}) );  
set_skill("force", 1000+random(200)); 
set_skill("changshengjue", 1000+random(200)); 
set_skill("guixi-force", 1000+random(200)); 
set_skill("renshu", 1000+random(200)); 
set_skill("yujianshu", 1000+random(200)); 
set_skill("dengxian-dafa", 1000+random(200)); 
set_skill("lengquan-force", 1000+random(200)); 
set_skill("qin", 1000+random(200)); 
set_skill("xiaohunqin", 1000+random(200)); 
set_skill("spells", 1000+random(200)); 
set_skill("tianjijue", 1000+random(200)); 
set_skill("sword", 1000+random(200)); 
set_skill("tianlei-sword", 1000+random(200)); 
set_skill("parry", 1000+random(200)); 
set_skill("dodge", 1000+random(200)); 
set_skill("zhutian-bu", 1000+random(200)); 
set_skill("wuji-force", 1000+random(200)); 
set_skill("tanzhishentong", 1000+random(200)); 
set_skill("piaoxiang", 1000+random(200)); 
set_skill("blade", 1000+random(200)); 
set_skill("shenji-blade", 1000+random(200)); 
set_skill("spear", 1000+random(200)); 
set_skill("bawang-qiang", 1000+random(200)); 
set_skill("whip", 1000+random(200)); 
set_skill("baihua-whip", 1000+random(200)); 
set_skill("unarmed", 1000+random(200)); 
set_skill("kongshoudao", 1000+random(200)); 
set_skill("literate", 800+random(300)); 
map_skill("force", "changshengjue"); 
map_skill("spells", "dengxian-dafa"); 
map_skill("unarmed", "kongshoudao"); 
map_skill("sword", "yujianshu"); 
map_skill("qin", "xiaohunqin"); 
map_skill("blade", "shenji-blade"); 
map_skill("spear", "bawang-qiang"); 
map_skill("dodge", "piaoxiang"); 
map_skill("parry", "kongshoudao"); 
/*
set("chat_chance_combat", 100); 
set("chat_msg_combat", ({  
        (: perform_action, "sword", "feitian" :),  
        (: perform_action, "dodge", "piao" :),  
        (: perform_action, "blade", "jichulianhuan" :),  
        (: perform_action, "qin", "qin" :),  
        (: perform_action, "spear", "meihua" :),  
        (: perform_action, "unarmed", "fengwu" :),  
        (: cast_spell, "niepan" :),  
        (: exert_function, "rebirth" :),  
}) ); 
*/
SDS_D->powerup(this_object());
create_family("江湖浪子", 2, "蓝");
setup(); 
carry_object("/d/eastway/qinling/obj/xiangyabox")->set_amount(random(1)); 
carry_object("/d/12gong/obj/shoes")->wear(); 
carry_object("/d/xuyi/obj/shield")->wear(); 
carry_object("/d/npc/obj/armor")->wear(); 
carry_object("/d/jjf/npc/obj/waist")->wear(); 
carry_object("/d/qujing/huangfeng/obj/jinyipifeng")->wear(); 
carry_object("/d/qujing/bibotan/obj/zhanpao")->wear(); 
str = "/d/eastway/qinling/obj/weapon/wujiang0"; 
str[strlen(str)-1] = '0'+random(4); 
carry_object(str)->wield(); 
}
void die() 
{
object me = query_temp("last_damage_from"); 
if ( !me 
|| !present(me,environment()) 
|| !userp(me)  
|| !living(me) ) 
{
::die(); 
return; 
}
if ((int)me->query("combat_exp")/10000<80000)
{
me->add("combat_exp",6000+random(2000)); 
me->add("daoxing",6000+random(2000)); 
me->add("potential",1200+random(400)); 
tell_object(me,YEL"你的武功修为提高了。\n"NOR); 
}
::die(); 
}
