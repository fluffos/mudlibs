inherit __DIR__"super_npc2.lpc"; 
string *names = ({ 
HIY"廉  颇"NOR, 
HIY"白  起"NOR, 
HIY"王  翦"NOR, 
HIY"李  牧"NOR, 
HIY"赵  奢"NOR, 
