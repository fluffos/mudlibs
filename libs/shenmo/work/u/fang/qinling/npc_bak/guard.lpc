#include <ansi.h>
//inherit "/d/snowtu/npc/super_npc"; 
inherit __DIR__ "super_npc.lpc";
string *names = ({
  HIG "护陵亲兵" NOR,
  HIG "护陵校尉" NOR,
  HIG "护陵侍卫" NOR,
  HIG "护陵武将" NOR,
  HIG "护陵御林军" NOR,
});
void create() {
  string str;
  set_name(names[random(sizeof(names))], ({ "huling guard", "guard" }));
  set("gender", "男性");
  set("class", "human");
  set("title", HIW "郦山陵墓护卫" NOR);
  set("age", 35 + random(20));
  set("level", 300);
  set("str", 40);
  set("long", "一个高大威猛的秦兵,据说他曾随白起将军战过长勺,也随蒙恬将军守过长城！\n");
  set("combat_exp", 30000000 + random(30000000));
  set("daoxing", 30000000 + random(30000000));
  set("attitude", "aggressive");
  set("max_kee", 100000 + random(30000));
  set("kee", 100000);
  set("max_sen", 70000 + random(30000));
  set("sen", 100000);
  set("max_force", 6000 + random(4000));
  set("force", 15000);
  set("max_mana", 6000 + random(4000));
  set("mana", 15000);
  set("force_factor", 500 + random(100));
  set("mana_factor", 200);
  set("任务", 1);
  set("莲花", 1);
  set("chat_chance", 30);
  set("chat_msg", ({
    CYN "大风！大风！大风！\n" NOR,
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
  }));
  set_skill("force", 500 + random(300));
  set_skill("lengquan-force", 500 + random(300));
  set_skill("spells", 500 + random(300));
  set_skill("baguazhou", 500 + random(300));
  set_skill("spear", 500 + random(300));
  set_skill("bawang-qiang", 500 + random(300));
  set_skill("parry", 500 + random(300));
  set_skill("dodge", 500 + random(300));
  set_skill("yanxing-steps", 500 + random(300));
  set_skill("mace", 500 + random(300));
  set_skill("jinglei-mace", 500 + random(300));
  set_skill("axe", 500 + random(300));
  set_skill("sanban-axe", 500 + random(300));
  set_skill("archery", 500 + random(300));
  set_skill("xuanyuan-archery", 500 + random(300));
  set_skill("sword", 500 + random(300));
  set_skill("yujianshu", 500 + random(300));
  set_skill("unarmed", 500 + random(300));
  set_skill("kongshoudao", 800);
  set_skill("wusi-mace", 500 + random(300));
  set_skill("changquan", 500 + random(300));
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("parry", "kongshoudao");
  map_skill("sword", "yujianshu");
  map_skill("unarmed", "kongshoudao");
  map_skill("spear", "bawang-qiang");
  map_skill("mace", "jinglei-mace");
  map_skill("axe", "sanban-axe");
  map_skill("archery", "xuanyuan-archery");
  map_skill("dodge", "yanxing-steps");
  /*
set("chat_chance_combat", 100); 
set("chat_msg_combat", ({  
        (: perform_action, "unarmed", "erchongjin" :),  
        (: perform_action, "spear", "meihua" :),  
        (: perform_action, "mace", "lei" :),  
        (: perform_action, "axe", "kai" :),  
        (: perform_action, "axe", "san" :),  
        (: perform_action, "sword", "wanjian" :),  
        (: perform_action, "archrey", "baibu" :),  
        (: exert_function, "recover" :),  
        (: exert_function, "refresh" :),  
}) ); 
*/
  SDS_D->powerup(this_object());
  create_family("将军府", 2, "蓝");
  setup();
  carry_object("/d/eastway/qinling/obj/jinbox")->set_amount(random(1));
  carry_object("/d/obj/armor/jinjia")->wear();
  str = "/d/eastway/qinling/obj/weapon/guard0";
  str[strlen(str) - 1] = '0' + random(5);
  carry_object(str)->wield();
}
void die() {
  object me = query_temp("last_damage_from");
  if (!me
    || !present(me, environment())
    || !userp(me)
    || !living(me)) {
    ::die();
    return;
  }
  if ((int)me->query("combat_exp") / 10000 < 30000) {
    me->add("combat_exp", 1500 + random(1000));
    me->add("daoxing", 1500 + random(1000));
    me->add("potential", 300 + random(200));
    tell_object(me, YEL "你的武功修为提高了。\n" NOR);
  }
  ::die();
}
