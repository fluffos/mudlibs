#include <ansi.h>
//inherit "/d/snowtu/npc/super_npc"; 
inherit __DIR__ "super_npc.lpc";
string *names = ({
  HIR "僵  尸" NOR,
  HIY "骷  髅" NOR,
  HIG "魍  魉" NOR,
});
void create() {
  set_name(names[random(sizeof(names))], ({ "ghost man", "ghost", "gui" }));
  set("gender", "男性");
  set("class", "yao");
  set("title", HIB "沉睡了一千年" NOR);
  set("age", 35 + random(20));
  set("long", "一个刚从棺材里挺尸出来的厉鬼,面目着实可怕！\n");
  set("combat_exp", 50000000 + random(20000000));
  set("daoxing", 50000000 + random(20000000));
  set("attitude", "aggressive");
  set("max_kee", 100000 + random(30000));
  set("level", 400);
  set("kee", 120000);
  set("max_sen", 90000 + random(30000));
  set("sen", 166666);
  set("max_force", 8000 + random(6000));
  set("force", 20000);
  set("max_mana", 6000 + random(6000));
  set("mana", 10000);
  set("force_factor", 500 + random(100));
  set("mana_factor", 300);
  set("任务", 1);
  set("莲花", 1);
  set("chat_chance", 30);
  set("chat_msg", ({
    CYN "·#%￥￥￥……—*（*—#￥……………………￥￥……！\n" NOR,
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
  }));
  set_skill("force", 600 + random(200));
  set_skill("spells", 600 + random(200));
  set_skill("huntianforce", 600 + random(200));
  set_skill("tianmogong", 600 + random(200));
  set_skill("sword", 600 + random(200));
  set_skill("huxiaojian", 600 + random(200));
  set_skill("dodge", 600 + random(200));
  set_skill("zhaoyangbu", 600 + random(200));
  set_skill("unarmed", 600 + random(200));
  set_skill("huxiaoquan", 600 + random(200));
  set_skill("parry", 600 + random(200));
  set_skill("blade", 600 + random(200));
  map_skill("force", "huntianforce");
  map_skill("spells", "tianmogong");
  map_skill("sword", "huxiaojian");
  map_skill("unarmed", "huxiaoquan");
  map_skill("parry", "huxiaojian");
  map_skill("dodge", "zhaoyangbu");
  /*
set("chat_chance_combat", 100); 
set("chat_msg_combat", ({  
        (: perform_action, "sword", "chan" :),  
        (: perform_action, "unarmed", "sixiao" :),  
        (: perform_action, "sword", "hou" :),  
        (: cast_spell, "shihun" :),  
}) ); 
*/
  SDS_D->powerup(this_object());
  create_family("三界山", 2, "蓝");
  setup();
  carry_object("/d/eastway/qinling/obj/jinbox")->set_amount(random(1));
  carry_object("/d/obj/armor/gujia")->wear();
  carry_object("/d/mojie/obj/sword")->wield();
}
void die() {
  object me = query_temp("last_damage_from");
  if (!me
    || !present(me, environment())
    || !userp(me)
    || !living(me)) {
    ::die();
    return;
  }
  if ((int)me->query("combat_exp") / 10000 < 40000) {
    me->add("combat_exp", 2500 + random(1000));
    me->add("daoxing", 2500 + random(1000));
    me->add("potential", 500 + random(200));
    tell_object(me, YEL "你的武功修为提高了。\n" NOR);
  }
  ::die();
}
