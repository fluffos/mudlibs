#include <ansi.h>
//inherit "/d/snowtu/npc/super_npc";
inherit __DIR__"super_npc.lpc"; 
int ask_chshjue();
void create()
{
set_name("赢  政", ({"ying zheng", "ying", "zheng", "yingzheng", "qin", "shihuang", "qinhuang"}));
set ("long", @LONG
他就是中国历史上第一位皇帝。他吞并六国，
统一了中国，建立了强绝一时的大秦国，武功
显赫。但是他大兴土木，为政残苛，又是历史
上最为著名的暴君。千秋功过，孰是孰非，自
有后人评说。
LONG);
set("title", HIG"大秦始皇帝"NOR);
set("gender", "男性");
set("inquiry",([
"大秦": "我大秦千秋万代！你也是我大秦子民吧？快告诉朕现在朕的儿孙传到几世了？",
"长生不老": "哈哈！朕之所以长生不老，是因为修炼了长生诀神功！只是。。。。。。",
"秦始皇陵": "气死朕了！朕本打算假死一段时间，谁成想被五大神兽困在此地，无法脱困！",
"长生诀"     : (: ask_chshjue :),
]));
set("age", 65);
set("str", 80);
set("per", 35);
set("int", 40);
set("cor", 40);
set("cps", 40);
set("combat_exp", 500000000);
set("level", 1000);
set_skill("sword", 2000);
set_skill("force", 2000);
set_skill("dodge", 2000);
set_skill("changshengjue", 2000);
set_skill("literate", 500);
set_skill("jiuyang-shengong", 2000);
set_skill("shenghuo-shengong", 2000);
set_skill("spells", 2000);
set_skill("qiankun-danuoyi", 2000);
set_skill("unarmed", 2000);
set_skill("qishang-quan", 2000);
set_skill("dragonstep", 2000);
set_skill("shenghuo-ling", 2000);
map_skill("force", "changshengjue"); 
map_skill("spells", "qiankun-danuoyi");
map_skill("unarmed", "qishang-quan"); 
map_skill("sword", "shenghuo-ling"); 
map_skill("parry", "shenghuo-ling");
map_skill("dodge", "dragonstep");
set("max_sen", 1000000);
set("max_kee", 1000000);
set("force", 100000);
set("max_force", 30000);
set("max_mana", 30000);
set("mana", 100000);
set("daoxing", 500000000);
set("force_factor", 2000);
set("mana_factor", 2000);
/*
set("chat_chance_combat", 80);
set("chat_msg_combat", ({ 
        (: perform_action, "sword", "can" :),
        (: perform_action, "unarmed", "yihuanghu" :),
        (: perform_action, "unarmed", "jingshi" :),
        (: perform_action, "unarmed", "hunpofeiyang" :),
 }) );
*/
set("任务",1); 
SDS_D->powerup(this_object()); 
create_family("明教", 1, "蓝");
setup();
carry_object("/d/obj/armor/jinjia")->wear();
carry_object("/d/obj/cloth/longpao")->wear();
carry_object("/d/eastway/qinling/obj/taie")->wield();
}
int accept_fight(object me)
{
command("say 大胆！\n");
return 0;
}
void init()
{
add_action("do_none","perform"); 
add_action("do_none","cast"); 
add_action("do_none","exert"); 
add_action("do_none","eat"); 
add_action("do_none","ji"); 
}
int do_none()
{
object me = this_object();
message_vision("赢政瞪了你一眼！\n",me); 
return 1;
}
int ask_chshjue()
{
object me;
object item;
me=this_player();
if(me->query("level")<250)
{
command("sigh");
command("say 你的等级太低了，恐怕我跟你说了你也听不懂！");
return 1;
}
if(me->query("shilian")<1)
{
command("sigh");
command("say 你还是先去不周山试炼塔锻炼锻炼吧！");
return 1;
}
if(me->query("chshjue_ask")==1)
{
command("kick");
command("say 你怎么又问这个啊，好话不说二遍！");
return 1;
}
if (me->query("chshjue_agree")!=1 )
{
if( random(100) > 20 )
{
command("sigh");
command("say 你与长生诀无缘，千万不要难过哈。");
me->set("chshjue_ask",1);
}
else
{
command("wow");
command("say 你的资质太好了，正是修炼长生诀的材料啊！\n");
command("say 朕这里有本书，你拿去吧！\n");
command("say 不过这本书只是下卷，上卷朕不慎遗落民间，你去找找吧！\n");
me->set("chshjue_ask",1);
me->set("chshjue_agree",1);
item=new("/d/eastway/qinling/obj/chshjue");
item->move(me);
command("chat 长生诀神功又要重现人间了！\n");
message("channel:rumor",YEL+"\n【"+HIM" 顺风耳 "NOR+YEL"】某人："+me->query("name")+"破解了"+HIW"长生诀"NOR+YEL"之谜！\n\n"+NOR,users() );
}
return 1;
}
return 0;
}
