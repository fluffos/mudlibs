#include <ansi.h>
//inherit "/d/snowtu/npc/super_npc"; 
inherit __DIR__ "super_npc.lpc";
void create() {
  set_name(HIW "朱  亥" NOR, ({ "zhanguo cike", "cike", "spy" }));
  set("gender", "男性");
  set("class", "xian");
  set("age", 20 + random(20));
  set("title", HIR "战国刺客" NOR);
  set("long", "风萧萧兮易水寒,壮士一去兮不复还！\n");
  set("combat_exp", 150000000 + random(50000000));
  set("daoxing", 150000000 + random(50000000));
  set("level", 700);
  set("per", 20 + random(10));
  set("莲花", 1);
  set("kar", 100);
  set("cor", 100);
  set("bellicosity", 5000);
  set("attitude", "aggressive");
  set("max_kee", 180000 + random(30000));
  set("kee", 150000);
  set("max_sen", 120000 + random(30000));
  set("sen", 150000);
  set("max_force", 15000 + random(6000));
  set("force", 20000);
  set("max_mana", 15000 + random(6000));
  set("mana", 20000);
  set("force_factor", 800);
  set("mana_factor", 600 + random(100));
  set("env/wimpy", 30 + random(20));
  set("任务", 1);
  set("chat_chance", 30);
  set("chat_msg", ({
    CYN "秦王不死，于苍生何！？\n" NOR,
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
  }));
  set_skill("force", 800 + random(300));
  set_skill("dragonforce", 800 + random(300));
  set_skill("dodge", 800 + random(300));
  set_skill("dragonstep", 800 + random(300));
  set_skill("parry", 800 + random(300));
  set_skill("spells", 800 + random(300));
  set_skill("seashentong", 800 + random(300));
  set_skill("sword", 800 + random(300));
  set_skill("spysword", 800 + random(300));
  set_skill("stick", 800 + random(300));
  set_skill("qianjun-bang", 800 + random(300));
  set_skill("fork", 800 + random(300));
  set_skill("fengbo-cha", 800 + random(300));
  set_skill("hammer", 1000 + random(300));
  set_skill("huntian-hammer", 1000 + random(300));
  set_skill("unarmed", 800 + random(300));
  set_skill("dragonfight", 800 + random(300));
  set_skill("literate", 800 + random(300));
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("sword", "spysword");
  map_skill("hammer", "huntian-hammer");
  map_skill("fork", "fengbo-cha");
  map_skill("dodge", "dragonstep");
  map_skill("stick", "qianjun-bang");
  map_skill("parry", "huntian-hammer");
  /*
set("chat_chance_combat", 100); 
set("chat_msg_combat", ({  
        (: perform_action, "hammer", "break" :),  
        (: perform_action, "unarmed", "sheshen" :),  
        (: perform_action, "unarmed", "leidong" :),  
}) ); 
*/
  SDS_D->powerup(this_object());
  create_family("东海龙宫", 2, "蓝");
  setup();
  carry_object("/d/eastway/qinling/obj/feicuibox")->set_amount(random(1));
  carry_object("/d/npc/obj/pifeng")->wear();
  carry_object("/d/npc/obj/shoes")->wear();
  carry_object("/d/yhg/obj/tianchan")->wear();
  carry_object("/d/npc/obj/jing")->wear();
  carry_object("/d/eastway/qinling/obj/weapon/hammer")->wield();
}
void die() {
  object ob, *inv;
  int i;
  object me = query_temp("last_damage_from");
  ob = this_object();
  if (!me
    || !present(me, environment())
    || !userp(me)
    || !living(me)) {
    ::die();
    return;
  }
  inv = all_inventory(ob);

  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("equipped") != "worn" &&
      inv[i]->query("equipped") != "wielded" &&
      sizeof(all_inventory(me)) < me->query_max_items()) {
      tell_object(me, HIW "你得到了" NOR + inv[i]->name() + "\n");
      inv[i]->move(me);
    }
  }

  me->add("combat_exp", 6000);
  me->add("daoxing", 6000);
  me->add("potential", 1200);
  tell_object(me, YEL "你的武功修为提高了。\n" NOR);
  ::die();
}
