
#include <ansi.h>  
inherit NPC; 
int ask_dzxy();
int ask_wuhu();

void create() 
{
set_name("寇  仲", ({"kou zhong", "kou", "zhong"})); 
set ("long", @LONG
玄武门之变后，寇仲便退隐江湖，过着无忧无虑的生活。虽
每日粗茶淡饭，倒也乐哉悠哉。不过他的武功倒是一点都没
有荒废，随时准备着把自己的长生诀神功传与有缘之人。
LONG); 

set("title", HIW"大唐双龙"NOR);
set("gender", "男性");
set("inquiry",([
"徐子陵": "陵少是我的生死兄弟！",
"宋玉致": "玉致。。。玉致。。。",
"李秀宁": "秀宁。。。秀宁。。。",
"斗转星移"     : (: ask_dzxy :),
"五虎断门刀"     : (: ask_wuhu :),
]));
set("age", 30); 
set("str", 45);
set("per", 35);
set("int", 30);
set("cor", 50);
set("attitude", "peaceful"); 
set("combat_exp", 100000000); 
set("daoxing", 100000000); 
set("shen_type", 1);
set("max_force", 12000);
set("max_mana", 12000);
set("force", 24000);
set("mana", 24000);
set("force_factor", 1000);
set("mana_factor", 1000);
set_skill("unarmed", 400); 
set_skill("dodge", 400); 
set_skill("parry", 400); 
set_skill("force", 400); 
set_skill("douzhuan-xingyi", 400); 
set_skill("blade", 400); 
set_skill("changshengjue", 50); 
set_skill("wuhu-blade", 400); 
map_skill("force", "changshengjue");
map_skill("parry", "douzhuan-xingyi");
map_skill("blade", "wuhu-blade");
setup(); 
carry_object("/d/obj/cloth/linen")->wear(); 
carry_object("/d/obj/weapon/blade/fengdao")->wield(); 
}
int recognize_apprentice(object ob) 
{
return 1; 
}
int ask_dzxy()
{
object me;
object item;
me=this_player();
if(me->query("chshjue_ask")==0)
{
command("heng");
command("say 你是怎么找到这里来的？是不是李小子派你来的？！"); 
return 1;
}

if(me->query("level")<600)
{
command("hehe");
command("say 你现在的等级太低了，恐怕难以领悟斗转星移的精深奥妙！"); 
return 1; 
}
if(me->query("shilian")<1)
{
command("hehe");
command("say 你还是先去不周山试炼塔锻炼锻炼吧！");
return 1;
}
if(me->query("dzxy_ask")==1)
{
command("kick");
command("say 你怎么又问这个啊，好话不说二遍！");
return 1;
}
if (me->query("dzxy_agree")!=1)
{
if( random(100) > 25 )
{
command("sigh");
command("say 你的资质不适合练习斗转星移，千万不要难过哈。");
me->set("dzxy_ask",1);
}
else
{
command("wow");
command("say 你的资质太好了，正是练习斗转星移的材料啊！\n");
command("say 如果你不嫌弃，我可以给你指点一二！\n");
me->set("dzxy_ask",1);
me->set("dzxy_agree",1);
item=new("/d/obj/weapon/sword/qinghong");
item->move(me);
command("chat 斗转星移又有传人了！\n");
message("channel:rumor",YEL+"\n【"+HIM" 顺风耳 "NOR+YEL"】某人："+me->query("name")+"从寇仲那里学到了"+HIW"斗转星移"NOR+YEL"！\n\n"+NOR,users() );
}
return 1;
}
return 0;
}

int ask_wuhu()
{
object me;
object item;
me=this_player();
if(me->query("level")<600)
{
command("hehe");
command("say 你现在的等级太低了，恐怕难以领悟五虎断门刀的精深奥妙！"); 
return 1; 
}
if(me->query("shilian")<1)
{
command("hehe");
command("say 你还是先去不周山试炼塔锻炼锻炼吧！");
return 1;
}
if(me->query("wuhu_ask")==1)
{
command("kick");
command("say 你怎么又问这个啊，好话不说二遍！");
return 1;
}
if (me->query("wuhu_agree")!=1)
{
if( random(100) > 30 )
{
command("sigh");
command("say 你的资质不适合练习五虎断门刀，千万不要难过哈。");
me->set("wuhu_ask",1);
}
else
{
command("wow");
command("say 你的资质太好了，正是练习五虎断门刀的材料啊！\n");
command("say 如果你不嫌弃，我可以给你指点一二！\n");
me->set("wuhu_ask",1);
me->set("wuhu_agree",1);
item=new("/d/obj/weapon/blade/jindao");
item->move(me);
command("chat 五虎断门刀又有传人了！\n");
message("channel:rumor",YEL+"\n【"+HIM" 顺风耳 "NOR+YEL"】某人："+me->query("name")+"从寇仲那里学到了"+HIR"五虎断门刀"NOR+YEL"！\n\n"+NOR,users() );
}
return 1;
}
return 0;
}
