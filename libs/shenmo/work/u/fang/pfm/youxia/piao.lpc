#include <ansi.h>;
inherit PERFORM;

void create()
{
    set("name",HIR"血海飘香"NOR);
set("class","human");
set("belong","baiyun-sword");
set("family","江湖游侠");
set("target",1);
set("betray_lvl",350);
set("force",1000);
set("persent",200);
set("need_force",50);
set("busy_pfm",1);
set("limit_skill",([
"piaoxiang"    :   120,
"baiyun-sword"    :   120,
]));


}
void hit_msg(object me,object target,int num)
{
object weapon=me->query_temp("weapon");
if(me&&target) 
if(me&&target) 
{
message_vision(HIR"$N脚踏八方，身行如血海之中飘过一丝血腥，飘渺不定！\n"NOR,me,target);
}

}


void success_hit_msg(object me,object target,int num)
{
int time;
time=me->query_skill("piaoxiang",1);
time/=50;
if(time>5) time=5;
if(me&&target)
{
message_vision(HIW"结果$N被扰得眼花潦乱，接应不暇！\n"NOR,target,me);
target->start_busy(5);
}

}
void lost_hit_msg(object me,object target,int num)
{
object weapon=target->query_temp("weapon");
if(me&&target)
{
message_vision(HIW"\n可惜$N看出了$n的身法，向你迅然攻击！\n"NOR,target,me);
COMBAT_D->do_attack(target,me, weapon);
}

}

