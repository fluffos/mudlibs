
#include <ansi.h>

inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail(" [飞刀问情］只能对战斗中的对手使用.");
            if(me->query("family/family_name")!="江湖浪子")
             return notify_fail("[飞刀问情］只有江湖浪子才可以使用！\n");
    if(me->query("youxia/wenqing_perform")!=1)
    return notify_fail("你还没学会「飞刀问情」！\n");
	if((int) me->query_skill("li-dao",1) < 250)
		return notify_fail("你的小李飞刀等级不够，无法使出飞刀问情。\n");
if((int) me->query_skill("wuji-force",1) < 250)
		return notify_fail("你的无极新法等级不够，无法使出飞刀问情。\n");
if((int) me->query_skill("piaoxiang",1) < 250)
		return notify_fail("你的血海飘香等级不够，无法使出飞刀问情。\n");
if((int) me->query_skill("throwing",1) < 250)
		return notify_fail("你的基本暗器等级不够，无法使出飞刀问情。\n");
if( (int)me->query_str() < 25)
                return notify_fail("你的臂力不够，使不出「飞刀问情」绝技。\n");

        if( (int)me->query_per() < 22)
                return notify_fail("你的容貌还不够条件，使不出「飞刀问情」绝技。\n");
  if (me->query_temp("dead_busy")) return notify_fail("你没办法连续使出飞刀问情。\n");


	message_vision(HIC "\n$N突然心灰意冷，任由$n在你面前叫嚷，\n"NOR,me,target);
       me->start_call_out( (: call_other, __FILE__, "kill_him", me, target :), random(5)+5);
	me->start_busy(3);
       me->set_temp("feidao_busy",1);
       call_out("remove_effect",3+random(3),me);
	return 1;
}

void kill_him(object me, object target)
{
	string msg;
         string myname=me->name(), npcname=target->name();
	if(me->is_fighting() && 
	environment(me) == environment(target))
	{
msg = HIW "\n$N现在的眼中只有仇恨，仿佛看到了林诗音和龙啸天的影子！！！" ;
msg +=  "\n\n你决定了，活着也没什么意思，情人居然被自己的义兄给夺去，
你越想越气!!突然你一刀朝$n飞去，
$n连惨叫都来不及就已经倒在了血泊中。\n" NOR;

	message_vision(msg, me, target);
	target->die();
       {
	// message("channel:rumor",HIM"【风言风语】某人："+npcname+"被"+myname+"用李寻欢的绝学[飞刀问情]杀死了，"+npcname+"的尸体还沉醉在刚才的战斗之中。\n"NOR,users());
	 }

	}
	return ;
}
void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("feidao_busy");
}

