#include <ansi.h>
inherit SSERVER;

void reset_ob(object me,object weapon);

string name()
{
return "「"HIG"斗转星移"NOR"」";
}

mapping check_pfm(object who) 
{
string cmd,dir,*files,sk,arg,file,tmp,*temp;  
int i,k;
object weapon;  
mapping data = ([]);
temp = ({});
if( !who ) return 0;
if ( !objectp(weapon=who->query_temp("weapon")) )
        arg = "unarmed";
else    arg = weapon->query("skill_type");
if ( !arg || !stringp(arg) )   
        arg = "unarmed";
if ( wizardp(this_player()) )
        printf("\tbaseskill==%s\n",arg);        
sk = who->query_skill_mapped(arg);
if ( !sk || !stringp(sk) )
        return 0;
if ( file_size(SKILL_D(sk)+".c")<1 )
        return 0;
if ( wizardp(this_player()) )
        printf("\tmapskill==%s\n",sk);  
dir = SKILL_D(sk)->perform_action_file("");
if ( !dir || !stringp(dir) )
        return 0;
if ( dir=="/daemon/class/forall/" )
        return 0;        
if ( wizardp(this_player()) )
        printf("\tpfmdir==%s\n",dir);   
files = get_dir(dir);
k = 0;
for(i=0;i<sizeof(files);i++)
        {
        if ( sscanf(files[i],"%s.c",tmp)==1 )
                {
                k++;
                temp+= ({files[i]});
                }
        }
if ( k<1 )
        return 0;
files = temp;                   
i = random(sizeof(files));
file = files[i];
if( !stringp(file) ) return 0;
while ( !file )
        {
        i = random(sizeof(dir));
        file = files[i];
        }
if ( !(dir+file)->valid_perform(who) )  
        return 0;
data["dir"] = dir;
data["pfm"] = file;
data["skill"] = arg;
return data;
}

int valid_perform(object me,object target)
{
mapping data;   
notify_fail(YEL"绝招用多就不灵了。\n"NOR);
if ( !me )
        return 0;
if ( me->query("o_action") )
        return notify_fail("绝招用多就不灵了。\n");     
if ( !target || !objectp(target) || !me->is_fighting(target) )
        return notify_fail("你要对哪个施展"+name()+"？\n");
if ( me->query("dzxy_agree")==0 )
        return notify_fail("你还没有领悟"+name()+"的精髓所在。\n");
if ( me->query("force")<2000 )
        return notify_fail("你的内力不足 2000 点，不能施展"+name()+"。\n");
if ( me->query("sen")<100 )
        return notify_fail("你的精神不足 100 点，不能施展"+name()+"。\n");
data = check_pfm(target);
if ( !data || !mapp(data) || !stringp(data["skill"]) )
        return notify_fail("你想施展"+name()+"，可惜"+target->name()+"不值的你这么做．．．．\n");
me->set_temp("斗转星移",data);
return 1;
}

int perform(object me, object target)
{
mapping data,t_skills,skills,sks,m_skills;
string *m_sk,*t_sk,temp="";
int i,k,j;
object weapon;

if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail("不在战斗中，如何施展"+name()+"？\n");

if ( !valid_perform(me,target) )
        return 0;
weapon = me->query_temp("weapon"); 
if ( !weapon && target->query_temp("weapon") )
        return notify_fail("你必须拿把武器。\n");
m_skills = me->query_skills();
me->set("o_action",me->query("actions"));
if ( wizardp(me) )
        me->set_temp("o_skills",m_skills);
t_skills = target->query_skills();
m_sk = keys(m_skills);
t_sk = keys(t_skills);
j = 0;
for(i=0;i<sizeof(m_sk);i++)
        {
        j++;    
        me->set_temp("斗转星移/old/"+m_sk[i],me->query_skill(m_sk[i],1));
        temp+= " "+sprintf("%s : %d",m_sk[i],me->query_skill(m_sk[i],1));
        if ( j%4==0 )
                temp+="\n";
        if ( me->query_skill_mapped(m_sk[i]) )
                me->set_temp("斗转星移/map/"+m_sk[i],me->query_skill_mapped(m_sk[i]));
        }
for(i=0;i<sizeof(t_sk);i++)
        {
        if ( me->query_skill(t_sk[i],1) )
                continue;
        me->set_skill(t_sk[i],me->query_skill("douzhuan-xingyi",1));
        }
for(i=0;i<sizeof(t_sk);i++)
        {
        if ( target->query_skill_mapped(t_sk[i]) )
                me->map_skill(t_sk[i],target->query_skill_mapped(t_sk[i]));
        }
write_file(sprintf("/data/user/%c/%s.dzxy",me->query("id")[0],me->query("id")),sprintf("%s 斗转星移前：%s\n%s\n",me->query("id"),ctime(time()),temp));
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(HIW"$N"HIW"对$n"HIW"使出了"NOR+name()+HIW"！\n"NOR,me,target);
else    message_vision(HIW"$N"HIW"运起斗转星移之功，一招一势之间极为怪异！\n"NOR,me,target);   
if ( target->query("family/family_name") )
        {
        me->set("o_family_name",me->query("family/family_name"));
        write_file(sprintf("/data/user/%c/%s.dzxy",me->query("id")[0],me->query("id")),sprintf("%s 斗转星移 前：%s 派\n",me->query("id"),me->query("family/family_name")));
        me->set("family/family_name",target->query("family/family_name") );
        }
data = me->query_temp("斗转星移");
if ( weapon )
        {
        weapon->set("o_skill_type",weapon->query("skill_type"));
        weapon->set("skill_type",data["skill"]);
        }
me->reset_action();             
me->add("force",-200);
write_file(sprintf("/data/user/%c/%s.dzxy",me->query("id")[0],me->query("id")),sprintf("%s 斗转星移 前：%s 族\n",me->query("id"),me->query("class")));
me->set("class",target->query("class") );
write_file(sprintf("/data/user/%c/%s.dzxy",me->query("id")[0],me->query("id")),"\n============================================\n\n\n");                      
if ( !(data["dir"]+data["pfm"])->perform(me,target) 
  || catch((data["dir"]+data["pfm"])->perform(me,target)) )
        {       
        write("\n结果没有什么反应。\n\n");
        reset_ob(me,weapon);
        return 1;
        }
message_vision(HIW"\n$N"HIW"一式"NOR+name()+HIW"使毕，甚是得意。\n"NOR,me,target);
reset_ob(me,weapon);
return 1;
}

void reset_ob(object me,object weapon)
{
mapping skill;
string *skills; 
int i,k;
if ( !me )
        return;
if ( weapon )
        {
        weapon->set("skill_type",weapon->query("o_skill_type"));
        weapon->delete("o_skill_type");
        }
me->set("class",me->query("classxt"));
skill = me->query_skills();
skills = keys(skill);
for(i=0;i<sizeof(skills);i++)
        {
        if ( me->query_temp("斗转星移/old/"+skills[i]) )
                me->set_skill(skills[i],me->query_temp("斗转星移/old/"+skills[i]));
        else    me->delete_skill(skills[i]);
        }

skill = me->query_skills();
skills = keys(skill); 
for(i=0;i<sizeof(skills);i++)
        {
        if ( me->query_skill_mapped(skills[i])==me->query_temp("斗转星移/map/"+skills[i]) )
                continue;       
        if ( !me->query_temp("斗转星移/map/"+skills[i]) )
                continue;
        me->map_skill(skills[i],me->query_temp("斗转星移/map/"+skills[i]));
        }
if ( me->query("o_family_name") )  
        {
        me->set("family/family_name",me->query("o_family_name"));
        me->delete("o_family_name");
        }
if ( me->query("o_action") )
        {        
        me->set("actions",me->query("o_action"));
        me->delete("o_action");
        }
me->reset_action();                                             
}

int help(object me)
{
string temp;    
temp = "\t\t内力修为二十年\n";
temp+= "\t\t精    神 100 点\n";
temp+= "\t\t手中持有武器\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                运用乾坤之力对敌人使出对方能使用的外功
        出招类型：
                与斗转星移出的外功有关
                公共外功不能斗转星移
                门派终极外功可能不能斗转星移
        出手要求：              
HELP);                          
write(temp);
return 1;
}
