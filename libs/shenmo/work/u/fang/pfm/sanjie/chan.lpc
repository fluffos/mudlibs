#include <ansi.h>

inherit PERFORM;

int create() {
  set("name", HIY "金丝缠" NOR);
  set("target", 1);
  set("class", "yao");
  set("base_type", "sword");
  set("betray_lvl", 350);
  set("belong", "huxiaojian");
  set("persent", 150);
  set("busy_pfm", 1);
  set("limit_skill", ([
    "huxiaojian": 120,
    "huxiaoquan": 120,
    "sword": 120,
  ]));


  set("force", 400);
  set("need_force", 100);
  set("busy_lost", 2);
}

void hit_msg(object me, object target, int num) {
  int time;
  if (me && target && num == 1) {
    time = 2;
    if ((int)me->query_skill("huxiaojian", 1) > 180)
      time = 3;
    if ((int)me->query_skill("huxiaojian", 1) > 280)
      time = 5;
    time += random(time);
    time /= 2;
    set("busy_time", time);
    message_vision(HIC "$N画出一道金光，身形灵动，动作变得诡异起来！\n\n" NOR, me, target);
  }
  return;
}

void success_hit_msg(object me, object target, object num) {
  if (me && target)
    message_vision(HIR "$N顿时觉得眼前金光一闪，不由自主的跟着你的剑招走动！\n" NOR, target);
  return;
}

void lost_hit_msg(object me, object target, object num) {
  if (me && target)
    message_vision(HIY "结果$N自己转了个头晕眼花！手脚顿时慢了下来.\n" + NOR, me);
  return;
}
