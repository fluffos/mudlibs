#include <ansi.h>
inherit PERFORM;

void create(object me, object target) {
  set("name", "千蛇出洞");
  set("target", 1);
  set("need_force", 300);
  set("force", 1000);
  //set("family","方寸山三星洞");
  set("class", "yao");
  set("belong", "bingpo-blade");
  set("base_type", "blade");
  set("betray_lvl", 350);
  set("limit_skill", ([
    "bingpo-blade": 100,
    "xiaoyaoyou": 100,
    "ningxie-force": 100,
  ]));
  set("temp", "xueshan/qscd");
  set("temp_time", (3 + random(2)));
  //set("busy_self",3+random(1));

}

void hit_msg(object me, object target, int num) {
  string msg = "";
  object weapon = me->query_temp("weapon");

  set("double_hit", ([
    "num": 5,
    "me_del_env": 1,
    "t_del_env": 1,
  ]));
  if (num == 1) {
    msg += WHT "\n\n$N" WHT "手中的" NOR RED + weapon->query("name") + NOR WHT "幻出千朵刀花使出冰魄寒刀的不传绝学 ---千-蛇-出-洞--- ！！\n\n\n" NOR;
    msg += HIG "青蛇欲探头！\n" NOR;
    msg += HIG "手中" NOR HIC + weapon->query("name") + NOR HIG "直刺$n" HIG "！" NOR;
    message_vision(msg, me, target);

  }

}

void double_hit_msg(object me, object target, int num) {
  string msg = "";
  object weapon = me->query_temp("weapon");
  string w_name = weapon->query("name");

  if (me && target && num == 1)
    msg += HIY "金蛇微吐芯！\n$N" HIY "手中" NOR HIC + w_name + NOR HIY "斜劈$n" HIY "！" NOR;

  if (me && target && num == 2)
    msg += HIG "青蛇翻身搏！\n$N" HIG "手中" NOR HIC + w_name + NOR HIG "横劈$n" HIG "！" NOR;

  if (me && target && num == 3)
    msg += HIM "妖蛇啮八方！\n$N" HIM "手中" NOR HIC + w_name + NOR HIM "猛劈$n" HIM "！" NOR;

  if (me && target && num == 4)
    msg += HIC "仙蛇云里游！\n" HIC "$N手中" NOR HIC + w_name + NOR HIC "反撩$n" HIC "！" NOR;
  message_vision(msg, me, target);

}


void remove_eff_msg(object who) {
  string msg = "";
  if (who) {
    msg = WHT "\n你气血归于平静，又可以使用千蛇出动了\n" NOR;
    tell_object(who, msg);
  }
}
