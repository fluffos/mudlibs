#include <ansi.h>
inherit PERFORM;

void create() {
  set("name", HIW "「龙翔闪」" NOR);
  set("class", "human");
  set("family", "剑客联盟");
  set("target", 1);
  set("betray_lvl", 350);
  set("belong", "feitian-sword");
  set("base_type", "sword");
  set("limit_skill", ([
    "feitian-sword": 120,
    "guixi-force": 60,
  ]));
  set("force", 1200);
  set("need_force", 300);
  set("temp", "ftlx");
  set("temp_time", 4);
  set("busy_self", 0);
}

void hit_msg(object me, object target, int num) {
  object weapon = me->query_temp("weapon");
  int skill;
  if (me && target) {
    skill = me->query_skill("feitian-sword", 1);
    skill /= 10;
    set("double_hit", ([
      "damage": skill,
      "attack": skill,
      "num": 1,
    ]));
    message_vision(
      HIG "\n$N突然身形跃起，如神龙翱翔在天，手中的" + weapon->name() + HIG "挟雷霆万钧之势，闪电般的刺向$n！\n" NOR,
      me,
      target
    );
  }

}

void double_hit_msg(object me, object target, int num) {
  string *hitmsg, msg;
  object weapon = me->query_temp("weapon");
  if (me && target) {
    message_vision(HIR "$N手中的" + weapon->name() + HIR "化作满天的剑影将$n罩了起来\n" NOR, me, target);
  }
}





void remove_eff(object me, string temp_busy) {
  me->delete_temp(temp_busy);
}
