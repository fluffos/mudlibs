#include <ansi.h>
inherit PERFORM;

void create()
{
set("name",HIB"「神气活现」"NOR);
set("class","human");
set("family","剑客联盟");
set("target",1);
set("betray_lvl",350);
set("belong","huoxin-sword");
set("base_type","sword");
set("limit_skill",([
      "huoxin-sword"   : 60,
      "guixi-force"   : 60,
      ]));
set("force",800);
set("need_force",300);
set("busy_pfm",1);
set("busy_lost",(1+random(3)));
set("busy_time",(3+random(3)));
}

void hit_msg(object me,object target,int num)
{
   object weapon=me->query_temp("weapon");
   if(me&&target)
   {
       message_vision(HIG"$N扬起手中的长剑，舞起漫天剑花。只看见空中剑影闪动，虚虚实实，令人眼花缭乱。\n\n"NOR,me);
     }

}

void double_hit_msg(object me,object target,int num)
{
    string *hitmsg,msg;
    object weapon=me->query_temp("weapon");
    hitmsg=({
           HIC  "\n「厉鬼缠身」，$N手中"+ weapon->name() +"带着一阵寒意直刺$n！" NOR,
           HIR  "\n「群魔夜宴」，$N手中"+ weapon->name() +"带着冷冷的剑气斜刺$n！" NOR,
           HIY  "\n「百鬼夜行」，$N手中"+ weapon->name() +"落叶般横刺$n！" NOR,
           HIW  "\n「十万神魔」，$N手中"+ weapon->name() +"闪电般猛刺$n！" NOR,
           HIR  "\n「群魔乱舞」，$N手中"+ weapon->name() +"带着冷冷的剑气斜刺$n！" NOR,
           HIY  "\n「十万幻想」，$N手中"+ weapon->name() +"落叶般横刺$n！" NOR,
           HIW  "\n「万天神魔」，$N手中"+ weapon->name() +"闪电般猛刺$n！" NOR,
           });
     msg=hitmsg[num];
     if(me&&target)
     {
          message_vision(msg,me,target);
      }
}


void success_hit_msg(object me,object target,int num)
{
   if(me&&target)
   {
      message_vision(HIR"$N果然看得目瞪口呆，不知所措，哪里分得清什么虚实！\n"NOR,target);
   }

}

void lost_hit_msg(object me,object target,int num)
{
    if(me&&target)
    {
       message_vision(HIR"$N凝神而立，不为虚招所动，$n反而被打了个措手不及。\n"NOR,target,me);
     }
}
