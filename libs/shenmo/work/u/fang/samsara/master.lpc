
inherit NPC; 
inherit F_MASTER;  
#include <ansi.h> 
#include "zhuanshi.lpc" 
  
 void create() 
 { 
         set_name(HIY"转世调整大使"NOR, ({ "master", "tiaozheng dashi", "dashi" })); 
  
         set("long","调整转世大使，这是方舟专门为了以前转世而设计的大使。\n"); 
         set("attitude", "peaceful"); 
         set("per", 30); 
         set("str", 25); 
         set("int", 25); 
         set("age", 30); 
         set("title", HIW"转世大使"NOR); 
         set("nickname", HIG"大师"NOR); 
         set("combat_exp", 850000); 
                 set("daoxing", 600000); 
  
         set("max_gin", 1400); 
         set("max_kee", 1400); 
         set("max_sen", 1400); 
         set("class", "xian"); 
         set("force", 2500); 
         set("max_force", 1500); 
         set("force_factor", 100); 
         set("max_mana", 1500); 
         set("mana", 2500); 
         set("mana_factor", 100); 
  
         set_skill("literate", 100); 
         set_skill("ghost-steps", 120); 
         set_skill("dodge", 120); 
         set_skill("unarmed", 120); 
         set_skill("parry", 120); 
         set_skill("spells", 120); 
         set_skill("gouhunshu", 80); 
         set_skill("jinghun-zhang", 120); 
         set_skill("force", 120); 
         set_skill("tonsillit", 80); 
         set_skill("stick", 120); 
         set_skill("kusang-bang", 120); 
  
         map_skill("stick","kusang-bang"); 
         map_skill("parry", "kusang-bang"); 
         map_skill("spells", "gouhunshu"); 
         map_skill("dodge", "ghost-steps"); 
         map_skill("force", "tonsillit"); 
         map_skill("unarmed", "jinghun-zhang"); 
         set("chat_chance_combat", 40); 
         set("chat_msg_combat", ({ 
                 (: exert_function, "sheqi" :), 
                 (: cast_spell, "gouhun" :), 
         }) ); 
  
  
         set("nkgain", 400); 
         set("inquiry", ([   
             "转世调整"    :(:ask_zhuanshi():),   
         ])); 
  
         set_temp("apply/dodge", 50); 
         set_temp("apply/armor", 50); 
  
  
         setup(); 
         carry_object("/d/obj/weapon/stick/wuchangbang")->wield(); 
         carry_object("/d/obj/cloth/taijicloth")->wear(); 
 } 
  
  
 
 int samsara_num()
 {
          object who=this_player();  
          int num,zs;
          num = (int)who->query("zhuanshi");
          zs = 1;
          if( num < 1 )
          {
                   command("say 你不用进行转世调整了，继续努力吧！");   
                   who->unconcious();
                   zs = 1;

          }
          if( num >= 1 && who->query("samsara_1") < 1  && zs)
          {
                  command("say 恭喜你进入第一次转世调整！"); 
                  zs = 0;
                  who->set_temp("modify_zhuanshi",2);

          }
           if( num >= 2 && who->query("samsara_2") < 1 && zs )
          {
                  command("say 恭喜你进入第二次转世调整！"); 
                  zs = 0;
                  who->set_temp("modify_zhuanshi",3);

          }
          if( num >= 3 && who->query("samsara_3") < 1 && zs)
          {
//                command("say 恭喜你进入第三次转世调整！"); 
//                zs = 0;
//                who->set_temp("modify_zhuanshi",4);
          command("say 抱歉，现在还不能进入第三次转世调整！"); 
                  zs = 1;
                  

          }
          
      if( zs == 0 )  
        message("channel:rumor",HIB+"\n【"+HIR" 六道轮回 "NOR+HIB"】某人："+who->query("name")+"进入转世调整！\n"+NOR,users() ); 
    
          return zs;
 }
 int give_zhuanshi()  
 { 
         string *skname; 
         mapping skills; 
         int i,j,k; 
         object who=this_player();  
 
         i = who->query_temp("modify_zhuanshi");
         switch( i ) {
         case 2:
                who->set("samsara_1",1);
                break;
         case 3:
                who->set("samsara_2",1);
                break;
         case 4:
                who->set("samsara_3",1);
                break;
         default:
                 break;
         }
         
     who->delete_temp("modify_zhuanshi");
         message("channel:rumor",HIB+"\n【"+HIR" 六道轮回 "NOR+HIB"】某人："+who->query("name")+"转世调整成功了！\n"+NOR,users() ); 
  
         who->save(); 
         return 1; 
 } 

