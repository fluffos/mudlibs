#include <ansi.h>
#include <combat.h>
//inherit NPC;
int give_zhuanshi();
int samsara_num();
private int ask_zhuanshi();
private void if_work(string arg, object ob);
private void get_zhongzu(string arg, object ob);

string *national =
({
        "",
        "human",
        "xian",
        "yao",
});

