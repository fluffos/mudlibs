private int ask_zhuanshi()
{

 
    object ob = this_player();

        if( samsara_num() )
        {
                command("say 假以时日，汝必成王，不要灰心，继续努力！" );
                return 1;
        }
        //这里要加上转世的判断
    
        write("西游记--神魔传说提醒您：你要进行转世。\n");
    write("请您做出选择："HIG"①开始(Begin)"HIR" ②结束(Cancel)"NOR);
    //使用过的转世变量
    //zhuanshi_count;
    //choose_class
    //choose_gender
    //keep_num
    //keepskill
        ob->delete_temp("samsara_cancel",0);
        ob->delete_temp("zhuanshi_count");
        ob->delete_temp("choose_class");
        ob->delete_temp("choose_gender");
        ob->delete_temp("keepskill");
        ob->delete_temp("keep_num");
    input_to( (: if_work :), ob );
        command("say 又是一个重返正途的好孩子");
    return 1;

}

private void if_work(string arg, object ob)
{
        int id_count;

        id_count=ob->query_temp("zhuanshi_count");
        id_count++;
        ob->set_temp("zhuanshi_count",id_count);
        if(id_count>3) {
                        ob->delete_temp("zhuanshi_count");
                        write("超出选择次数，请重新进行");
                        ob->set_temp("samsara_cancel",1);
            return;
        }

        if(arg=="\1" || arg=="") {
            write(HIG"①开始(Begin)"HIR" ②结束(Cancel)"NOR);
            input_to( (: if_work :), ob );
            return;
        }

        if( arg[0..0] == "2" || arg[0..0] == "2" ) {
                write("\n你终止转世过程，再见。\n");
                                ob->set_temp("samsara_cancel",1);
                return;
        }

        if( arg[0..0] != "1" && arg[0..0] != "1" ) {
            write(HIG"①开始(Begin)"HIR" ②结束(Cancel)"NOR);
            input_to( (: if_work :), ob );
            return;
        }
        ob->delete_temp("zhuanshi_count");
        write(HIY"\n转世过程第一步："NOR+HIW"[请选择你转世后的种族]"NOR);
                write("
                1.人类
                2.仙族
                3.妖魔
                \n");
        write("请选择你转世后的种族（1，2，3）：");
        input_to("get_zhongzu",ob);
}



private void get_zhongzu(string arg, object ob)
{
        if( arg=="" ) {
                write("请选择你转世后的种族（1，2，3）：");
                input_to("get_zhongzu", ob);
                return;
        }
        if( arg[0]=='1' || arg[0]=='2' || arg[0]=='3')
        {
                ob->set_temp("choose_class",national[(int) (arg[0]-'0')]);
                                write(HIY"\n转世过程第二步："NOR+HIW"[请选择你转世后的性别]"NOR);
                write("\n选择你转世后的性别:男性(m)或女性(f)？");
                input_to("get_gender", ob);
                return;
        }
        else {
                write("对不起，您只能从（1,2,3）中选择： ");
                input_to("get_zhongzu", ob);
                return;
        }
}

private void get_gender(string gender, object ob)
{
  int cnt;
  if( gender=="" ) {
          write("选择你转世后的性别:男性(m)或女性(f)？");
          input_to("get_gender", ob);
          return;
  }

  if( gender[0]=='m' || gender[0]=='M' )
          ob->set_temp("choose_gender", "男性");
  else if( gender[0]=='f' || gender[0]=='F' )
          ob->set_temp("choose_gender", "女性" );
  else {
          write("对不起，您只能选择男性(m)或女性(f)：");
          input_to("get_gender", ob);
          return;
  }

        write(HIY"\n转世过程第三步："NOR+HIW"[请输入你转世后需要保留的功夫]"NOR);
        ob->set_temp("keep_num",5);
        cnt = ob->query_temp("keep_num");
        write("\n你最多可以保留"+HIY"["+chinese_number(cnt)+"]"NOR+"项功夫");
        write("\n输入你转世后保留的第"+HIY"["+chinese_number(1)+"]"NOR+"项功夫：");
        input_to("keep_skill", ob);

}

private void keep_skill(string arg, object ob)
{
        mapping skill_status;
        int cnt;
    string *skills;

         if( arg=="" ) {
                  write("输入你转世后保留的功夫：");
                  input_to("keep_skill", ob);
                  return;
          }
          else{
                  if ( !(skill_status = ob->query_skills()) || !sizeof(skill_status) )
          {
                          write("你没有学会任何技能，瞎掺和什么？！\n");
                          ob->set_temp("samsara_cancel",1);
                          return;
                  }
          skills  = keys(skill_status);
          if( member_array(arg,skills) != -1 )
          {
                          //get the keep skills;
                          skill_status = ob->query_temp("keepskill");
                          if( skill_status && sizeof(skill_status) )
                          {
                                  skills  = keys(skill_status);
                                  if( member_array(arg,skills)!= -1 )
                                  {
                                          write("你已经选择了保留这项功夫\n");
                                          write("重新输入你转世后保留的功夫：");
                                          input_to("keep_skill", ob);
                                          return;
                                  }
                          }
                          cnt = ob->query_temp("keep_num");

                          cnt --;
                          ob->set_temp("keepskill/"+arg,1);
                          ob->set_temp("keep_num",cnt);
                          if( cnt > 0 )
                          {
                                  write("\n输入你转世后保留的第"+HIY"["+chinese_number((6-cnt))+"]"NOR+"项功夫：");
                                  input_to("keep_skill", ob);
                                  return;
                          }
                          else
                          {
                                  write("\n你转世后的种族："+HIR+ob->query_temp("choose_class")+NOR);
                                  write("\n你转世后的性别："+HIR+ob->query_temp("choose_gender")+NOR);
                                  skill_status = ob->query_temp("keepskill");
                                  if( skill_status && sizeof(skill_status) )
                                  {
                                          skills  = keys(skill_status);
                                          for( cnt = 0; cnt < sizeof(skills);cnt++)
                                                 write("\n你转世后的保留的第"+chinese_number((cnt+1))+"项功夫："+HIR+skills[cnt]+NOR);
                                 }
                                  write("\n你确定要进行转世了吗(y/n)？");
                                  input_to("confirm_samsara",ob);
                                  return;
                          }


          }
                  else
                  {
                          write("你没有这项功夫,小心"+HIY+"方舟"NOR+"K你\n");
                          write("重新输入你转世后保留的功夫：");
                          input_to("keep_skill", ob);
                          return;
                  }


          }

}
private void confirm_samsara(string arg, object ob)
{
         mapping skill_status;
         int cnt;
     string *skills;
         if( arg=="" ) {
                          write("你确定要进行转世了吗(y/n)？");
                          input_to("keep_skill", ob);
                          return;
                  }
          if( (arg[0]!='y' && arg[0]!='Y')  ) {
                  write("好吧，欢迎下次再来进行转世。\n");
                  ob->delete_temp("choose_class");
                  ob->delete_temp("choose_gender");
                  ob->delete_temp("keepskill");
                  ob->delete_temp("keep_num");
                  ob->set_temp("samsara_cancel",1);
                  message("chat",HIY+"【轮回转世】:"+NOR+BLU+ob->query("name")+"取消轮回转世!\n"NOR,users());
                  return;
          }
          write(HIY"\n转世过程最后一步："NOR+HIW"[轮回转世]\n"NOR);
          ob->set("class",ob->query_temp("choose_class"));
          ob->set("classxt",ob->query_temp("choose_class"));
          ob->set("gender",ob->query_temp("choose_gender"));

          skill_status = ob->query_temp("keepskill");
          if( skill_status && sizeof(skill_status) )
          {
                  skills  = keys(skill_status);
                  for( cnt = 0; cnt < sizeof(skills);cnt++)
                  {
                          ob->set("samsara/"+skills[cnt],1);
                          ob->set_skill(skills[cnt],100);
                  }
          }
          message("chat",HIY+"\n【轮回转世】:"+NOR+BLU+ob->query("name")+"轮回转世后的种族:"NOR+HIR+ob->query_temp("choose_class")+NOR,users());
          message("chat",HIY+"\n【轮回转世】:"+NOR+BLU+ob->query("name")+"轮回转世后的性别:"NOR+HIR+ob->query_temp("choose_gender")+NOR,users());
          for( cnt = 0; cnt < sizeof(skills);cnt++)
              message("chat",HIY+"\n【轮回转世】:"+NOR+BLU+ob->query("name")+"轮回转世后保留的第"+chinese_number((cnt+1))+"项功夫："NOR+HIR+skills[cnt]+NOR,users());
          message("rumor",HIM+"\n【轮回转世】:"+NOR+BLU+ob->query("name")+"轮回转世后的种族:"NOR+HIR+ob->query_temp("choose_class")+NOR,users());
          message("rumor",HIM+"\n【轮回转世】:"+NOR+BLU+ob->query("name")+"轮回转世后的性别:"NOR+HIR+ob->query_temp("choose_gender")+NOR,users());
          for( cnt = 0; cnt < sizeof(skills);cnt++)
           message("rumor",HIM+"\n【轮回转世】:"+NOR+BLU+ob->query("name")+"轮回转世后保留的第"+chinese_number((cnt+1))+"项功夫："NOR+HIR+skills[cnt]+NOR,users());

      write("\n");
          ob->delete_temp("zhuanshi_count");
          ob->delete_temp("choose_class");
          ob->delete_temp("choose_gender");
          ob->delete_temp("keepskill");
          ob->delete_temp("keep_num");
          ob->save();
          //功夫部分
      skill_status = ob->query_skills();
      if( mapp(skill_status) )
        {
        skills = keys(skill_status);
        for(cnt=0; cnt<sizeof(skills); cnt++)
          ob->delete_skill(skills[cnt]);
        }
        ob->set_skill("force",100);
        ob->set_skill("spells",100);
        ob->set_skill("unarmed",100);
        ob->set_skill("dodge",100);
        ob->set_skill("parry",100);
        ob->set_skill("literate",100);
          skill_status = ob->query("samsara");
          if( skill_status && sizeof(skill_status) )
          {
                  skills  = keys(skill_status);
                  //将转世的功夫变成100level
                  for( cnt = 0; cnt < sizeof(skills);cnt++)
                         ob->set_skill(skills[cnt],100);
          }
        give_zhuanshi();

}


