  // carry_object("/d/obj/weapon/whip/longsuo2")->wield(); 
   call_out ("riding",1);  
 } 
  
 string avenge() 
 { 
     object who=this_player(),killer,where; 
     string killid; 
     if((string)who->query("family/family_name")!="阎罗地府") 
         return ("你不是本派弟子，生死与本王何干？"); 
     if(who->query("faith")<1000) 
         return ("你在本门名望还不够，还需多加努力才行。"); 
     if(who->query("avenge/mud_age")>=who->query("death/mud_age")) 
         return ("本王未闻死讯"); 
     killid=who->query("kill/last_killer"); 
     killer=find_living(killid); 
     if(!killer||!userp(killer)) 
         return ("这个嘛，本王还得想一想"); 
     command("say 本王这就去为你抱仇。"); 
     who->set("avenge/mud_age",who->query("mud_age")); 
     where=environment(who); 
     tell_room(where,"只见地藏王菩萨向空中一指：\n"); 
     tell_room(where,"索魂小鬼何在，速去将"+killer->query("name")+"抓来。\n") 
 ; 
     tell_room(environment(killer),"空中伸出一只大手将"+killer->query("name") 
 +"抓了起来！"); 
     killer->move(where); 
     tell_room(where,killer->query("name")+"被从空中扔了下来。\n"); 
     command("say 大胆妖孽，胆敢杀害我阎罗地府弟子"); 
     this_object()->kill_ob(killer); 
     return("拿命来。"); 
 }   
 void attempt_apprentice(object ob, object me) 
 { 
   if ( (string)ob->query("family/family_name")=="阎罗地府") { 
     if (((int)ob->query("combat_exp") < 350000 )) { 
       command("say " + RANK_D->query_rude(ob) + "这点三脚猫的把式也敢到我这里丢人现眼？"); 
       return; 
     } 
     command("grin"); 
     command("say 很好，" + RANK_D->query_respect(ob) + 
        "多加努力，他日必定有成。\n"); 
     command("recruit " + ob->query("id") ); 
     return; 
   } 
   command("shake"); 
   command("say " + RANK_D->query_respect(ob) + 
      "还是先去学些基础功夫吧！\n"); 
   return; 
 } 
  
 string ask_chuxian() 
 { 
   object me=this_player(); 
   if(me->query("family/family_name")!="阎罗地府") 
      return ("你不是本门中人！"); 
    
   command("smile "+me->query("id")); 
   me->set("m_secmieyao",1); 
   return "/d/obj/mieyao"->query_yao(me); 
 } 
   
 string ask_cancel() 
 { 
     object me=this_player(); 
 if((int)me->query("m_secmieyao")) 
 { 
       me->add("daoxing",-2000); 
       me->delete("m_secmieyao"); 
       me->delete("secmieyao"); 
       me->delete("secmieyao_mudage"); 
       me->delete("secmieyao/type"); 
       me->delete("secmieyao/location"); 
       me->delete("secmieyao/place"); 
       me->delete("secmieyao/name"); 
       me->delete("secmieyao/id"); 
      return ("没用的东西！"); 
 } 
 else 
 { 
      return ("你有任务吗？！"); 
 } 
 } 
  
 void riding ()  
 { 
   command ("mount di ting");  
 } 

 int samsara_num()
 {
         object who=this_player();  
         if ((int)who->query("zhuanshi") == 0 )  
         {   
         command("say 若是初次投胎转世，还是去找王方平吧！");   
         return 1;  
         }   
 if ((int)who->query("zhuanshi") == 1 )   
         {   
         command("say 若想第二次投胎转世，还是去找轮转王吧！");  
         return 1;  
         }   
 if ((int)who->query("zhuanshi") == 3 )   
         {   
         command("say 失敬！失敬！你永远不会再受那轮回之苦了！");   
         return 1;  
         }   
 if ((int)who->query("level") < 1000 )  
         {   
         command("say 你的等级不足，还是过些时间再来吧！");  
         return 1;  
         }   
 if ((int)who->query("combat_exp") < 400000000 ) 
         {   
         command("say 你的武学不足，还是过些时间再来吧！");   
         return 1;  
         }   
 if ((int)who->query("daoxing") < 400000000 )  
         {   
         command("say 你的道行不足，还是过些时间再来吧！");  
         return 1;  
         }   
 if ((int)who->query("shen") < 300 )  
         {   
         command("say 你现在元神太低，进了油锅恐怕就难出来了！");  
         return 1;  
         }   
 if ((int)who->query("rsg_eaten") < 36 ) 
         { 
         command("say 你去多吃些人参果吧，在油锅煎熬的时候能少受些罪！");   
         return 1; 
         } 
 if ((int)who->query_skill("force", 1) < 1000 )   
         {   
         command("say 你的内功心法修为不够，还是过些时间再来吧！");   
         return 1;  
         }   
 if ((int)who->query_skill("spells", 1) < 1000 )   
         {   
         command("say 你的基本法术修为不够，还是过些时间再来吧！");  
         return 1;  
         }   
 if ((int)who->query_skill("dodge", 1) < 1000 )   
         {   
         command("say 你的基本轻功修为不够，还是过些时间再来吧！");   
         return 1;  
         }   
 if ((int)who->query_skill("unarmed", 1) < 1000 )   
         {   
         command("say 你的扑击格斗之技修为不够，还是过些时间再来吧！");   
         return 1;  
         }   
 if ((int)who->query_skill("parry", 1) < 1000 )   
         {   
         command("say 你的拆招卸力之法修为不够，还是过些时间再来吧！");  
         return 1;  
         }   
 if ((int)who->query_skill("literate", 1) < 1000 )  
         {   
         command("say 你的读书识字水平太差，还是过些时间再来吧！");   
         return 1;  
         }   
 if (!who->query("obstacle/reward"))    
         {   
         command("say 你先去西域求取真经吧！");   
         return 1;  
         }   
 if (who->query("dntg/laojunlu")!="done")  
         {   
         command("say 无名鼠辈，休得烦我！");   
         return 1;  
         }   
 if ( !random(3) )  
         {  
         who->set("shen", 200); 
         command("over "+who->query("id"));  
         message("channel:rumor",HIB+"\n【"+HIR" 六道轮回 "NOR+HIB"】某人："+who->query("name")+"三转失败了！\n"+NOR,users() );  
         return 1; 
         }  
 return 0;
 }
