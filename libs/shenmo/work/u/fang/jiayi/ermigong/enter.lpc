#include <ansi.h>
#include <room.h>

inherit ROOM;
string *names = ({
  HIM + "萧咪咪" + NOR, "xiao mimi", "女性", "迷死人不偿命", HIC + "十大恶人之一，据说很多人甘愿为她奉献性命。\n" + NOR,
  HIR + "李大嘴" + NOR, "li dazui", "男性", "专吃人肉", HIC + "十大恶人之一，据说他最爱吃人肉。\n" + NOR,
  HIR + "白开心" + NOR, "bai kaixin", "男性", "损人不利己", HIC + "十大恶人之一，恶贯满盈十恶不赦之徒。\n" + NOR,
  HIR + "杜杀" + NOR, "du sha", "男性", "血手", HIC + "十大恶人之一，恶贯满盈十恶不赦之徒。\n" + NOR,
  HIR + "轩辕三光" + NOR, "xuanyuan sanguang", "男性", "恶赌鬼", HIC + "十大恶人之一，恶贯满盈十恶不赦之徒。\n" + NOR,
  HIR + "阴九幽" + NOR, "yin jiuyou", "男性", "半人半鬼", HIC + "十大恶人之一，恶贯满盈十恶不赦之徒。\n" + NOR,
  HIM + "屠骄骄" + NOR, "tu jiaojiao", "女性", "不男不女", HIC + "十大恶人之一，恶贯满盈十恶不赦之徒。\n" + NOR,
  HIR + "哈哈儿" + NOR, "ha haer", "男性", "笑里藏刀", HIC + "十大恶人之一，恶贯满盈十恶不赦之徒。\n" + NOR,
  HIR + "司马烟" + NOR, "si mayan", "男性", "穿肠剑", HIC + "十大恶人之一，恶贯满盈十恶不赦之徒。\n" + NOR,
  HIR + "万木春" + NOR, "wan muchun", "男性", "神医", HIC + "十大恶人之一，江湖一流神医，病树前头万木春。\n" + NOR
});

void create() {
  set("short", HIG "恶人谷" NOR);
  set("long", @LONG   
   传言中的恶人谷，据说此处阴森恐怖，处处充满杀机!
LONG);
  set("no_magic", 1);

  setup();
}
void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("blowing", random(10) + 1, ob);
  add_action("block_cmd", "", 1);
}
int blowing(object ob) {
  int ilvl;
  int damage;
  string name, ids, gender, des;
  int i;
  i = random(sizeof(names) / 5) * 5;
  name = names[i];
  ids = names[i + 1];
  gender = names[i + 2];

  if (ob && environment(ob) == this_object()) {
    tell_object(
      ob,
      "\n" + HIY + names[i + 3] + NOR + name + names[i + 4] + BLU + "\n向你突施攻击\n" + NOR
    );
    ob->receive_wound("kee", random(500) + 500);
    COMBAT_D->report_sen_status(ob);
    ob->receive_wound("sen", random(500) + 500);
    COMBAT_D->report_sen_status(ob);
    if (environment(ob) == this_object())
      call_out("blowing", random(10) + 1, ob);

    if (ob->query_skill("jiayi-force", 1) > 50 &&
      ((int)ob->query("eff_kee") < (int)ob->query("max_kee") / 2 ||
        (int)ob->query("eff_sen") < (int)ob->query("max_sen") / 2)
    ) {
      ilvl = ob->query_skill("jiayi-force", 1);
      ob->set_skill("jiayi-force", ilvl - 1);
      if (ob->query("maximum_mana") > 10)
        ob->add_maximum_mana(-10);
      if (ob->query("maximum_force") > 10)
        ob->add_maximum_force(-10);
      tell_object(ob, HIW "\n\n辛苦修炼的内力法力，被乱窜的嫁衣神功所吞噬\n\n" NOR);

      if (ob->query("kar", 1) > random(40)) {
        ob->add_temp("jiayi_begin", 1);
        tell_object(ob, HIW "\n\n嫁衣神功在一点一点消失\n\n" NOR);
      }
    }

    if (ob->query_skill("jiayi-force", 1) > 0 &&
      ob->query_temp("jiayi_begin") > 250 && random(10) == 1 &&
      ((int)ob->query("eff_kee") < (int)ob->query("max_kee") / 4 ||
        (int)ob->query("eff_sen") < (int)ob->query("max_sen") / 4) ||
      wizardp(ob)) {
      if (ids == "wan muchun" || wizardp(ob)) {
        ob->receive_curing("kee", 1000);
        ob->receive_curing("sen", 1000);
        message_vision("万木春叹息一声说到:上天有好生之德,拿起药箱给$N治疗起来!", ob);
      }
      ob->add("jiayi_second", 1);
      ob->delete_skill("jiayi-force");
      ob->delete_temp("jiayi_begin");
      tell_object(ob, HIW "\n\n你的嫁衣神功消失殆尽\n\n" NOR);
      message(
        "chat",
        HIW "【" NOR + BLU "恶人谷" NOR + HIW "】" NOR + HIY + "据传:" + ob->query("name") + "(" + ob->query("id") + HIY ")白练嫁衣神功，浪费钱能，大家恭喜吧\n" NOR,
        users()
      );
    }

  } else
    return 1;
}


int block_cmd(string args) {
  string verb;
  verb = query_verb();

  // if (verb == "bian") return 1; // by mon 7/15 
  if (verb == "xiudao") return 1;
  if (verb == "eat") return 1;
  return 0;
}


void reset() {
  ::reset();
  remove_call_out("blowing");
}
