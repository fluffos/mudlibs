
// create by fang@tsrj
// room: out.c

inherit ROOM;

void create ()
{
        set ("short", "恶人谷入口");
        set ("long", @LONG
江湖人心目中所想象的"恶人谷"入口，向谷中望去自然是说不出的阴森、黑暗。
出人意料的是，"恶人谷"中竟是一片辉煌的灯火。旁边的石头上刻着几个大字。
         “入谷入谷，永不为奴！”
LONG);
        set("exits", 
        ([ //sizeof() == 4
                "west"  : __DIR__"erg"+sprintf("%d", random(7)),
                "enter" : __DIR__"enter",
                "north" : __DIR__"erg"+sprintf("%d", 6+random(7)),
                "east"  : __DIR__"erg"+sprintf("%d", random(7)),
              ]));

        setup();
}

int valid_leave (object me, string dir)
{
        if( me->query_temp("erg0") ) me->delete_temp("erg0");
        if( me->query_temp("erg1") ) me->delete_temp("erg1");
        if( me->query_temp("erg2") ) me->delete_temp("erg2");
        if( me->query_temp("erg3") ) me->delete_temp("erg3");
        if( me->query_temp("erg4") ) me->delete_temp("erg4");
        if( me->query_temp("erg5") ) me->delete_temp("erg5");
        if( me->query_temp("erg6") ) me->delete_temp("erg6");
        if( me->query_temp("erg7") ) me->delete_temp("erg8");
        if( me->query_temp("erg8") ) me->delete_temp("erg8");
        if( me->query_temp("erg9") ) me->delete_temp("erg9");
        if( me->query_temp("erg10") ) me->delete_temp("erg10");
        if( me->query_temp("erg11") ) me->delete_temp("erg11");
        if( me->query_temp("erg12") ) me->delete_temp("erg12");
        if( me->query_temp("erg_ready_out") ) me->delete_temp("erg_ready_out");
        if( dir == "enter" )
              {
               if( !me->query("get_jiayi_book") )
                return notify_fail("恶人谷，太过神秘，你还是算了吧\n");
               }
        return ::valid_leave(me, dir);
}


