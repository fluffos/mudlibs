
// create by fang@tsrj
// room: erg5.c

inherit ROOM;
void reset_path( object me);
void create ()
{
        set ("short", "恶人谷迷宫");
        set ("long", @LONG
这是吕仑山上自然形成的一道屏障，不熟悉的人容易在这里面迷路。
"恶人谷"，为了方便人们近谷，专门作了一盏引路的空明灯。
LONG);
        set("item_desc", ([
         "空明灯" : "入谷如登天,来人请休息\n",
         "deng" : "入谷如登天,来人请休息\n",]));

        set("exits", 
        ([ //sizeof() == 4
                "southeast" : __DIR__"erg0",
                "southwest" : __DIR__"erg3",
                "northwest" : __DIR__"erg7",
                "northeast" : __DIR__"erg9",
              ]));

        setup();
}

void init()
{
        object me=this_player();
        me->add_temp("erg5",1);
        if( me->query_temp("erg_ready_out")==1 && me->query_temp("erg5")<3 )
            call_out("send_out", 5, me);
        else
        {
            reset_path(me);
            call_out("free_send", 5, me);
        }
}

void reset_path(object me)
{
        me = this_player();
        if( me->query_temp("erg0") ) me->delete_temp("erg0");
        if( me->query_temp("erg1") ) me->delete_temp("erg1");
        if( me->query_temp("erg2") ) me->delete_temp("erg2");
        if( me->query_temp("erg3") ) me->delete_temp("erg3");
        if( me->query_temp("erg4") ) me->delete_temp("erg4");
        if( me->query_temp("erg6") ) me->delete_temp("erg6");
        if( me->query_temp("erg7") ) me->delete_temp("erg8");
        if( me->query_temp("erg8") ) me->delete_temp("erg8");
        if( me->query_temp("erg9") ) me->delete_temp("erg9");
        if( me->query_temp("erg10") ) me->delete_temp("erg10");
        if( me->query_temp("erg11") ) me->delete_temp("erg11");
        if( me->query_temp("erg12") ) me->delete_temp("erg12");
        return;
}

void send_out(object me)
{
message_vision("突然从迷宫中里透出一点光亮，$N慌不及待的钻了过去。\n",me); 
        me->move(__DIR__"outerg"+sprintf("%d",random(3)));
message_vision("$N钻到这来了。\n",me); 
        return;
}

void free_send(object me)
{
        me->set_temp("erg5",0);
        message_vision("突然从迷宫中里面射出一把暗剑，$N慌不及待的找了个出口躲开了。\n",me); 
        me->move(__DIR__"erg"+sprintf("%d",random(3)));
        message_vision("$N冲到这来了。\n",me); 
        return;
}

int valid_leave (object me, string dir)
{
        if( me->query_temp("erg5")>=3 || me->query_temp("erg_ready_out") )
        return notify_fail("突然从迷宫中里面射出一把暗剑，你竟不知道往那个方向走才好。\n");
        return ::valid_leave(me, dir);
}


