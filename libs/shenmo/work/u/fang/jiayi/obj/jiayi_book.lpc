#include <ansi.h>

inherit ITEM;
void destruct_me() {
  write(NOR HIY "千面怪鬼鬼祟祟地拿起秘籍撒脚就跑，快追！\n" NOR);
  destruct(this_object());
}

void create() {
  set_name(HIC "嫁衣神功秘籍" NOR, ({ "book", "jiayi book" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", HIC "一本武林中人人都想要的秘籍。很少有人能能参透其中的秘密\n" NOR);
    set("value", 0);
    set("no_sell", 1);
    set("no_put", 1);
    set("no_steal", 1);
    set("no_get", 1);
    set("skill", ([
      "name": "jiayi-force",
      "exp_required": 10000000,
      "sen_cost": 25,
      "difficulty": 25,
      "max_skill": 280,
    ]));
  }
  setup();
}

void init() {
  object me = this_object();
  object who = this_player();
  object where = environment();
  if (!me->query("my_owner") && interactive(who))
    me->set("my_owner", who->query("id"));
  if (me->query("my_owner") != who->query("id")) {
    remove_call_out("destruct_me");
    call_out("destruct_me", 1);
  }
  if (userp(where)) {
    if (me->query("owned")) {
      if (me->query("owned") != where->query("id")) {
        remove_call_out("destruct_me");
        call_out("destruct_me", 1);
        return;
      }
    } else me->set("owned", where->query("id"));
    remove_call_out("announce");
    call_out("announce", random(10), this_player());
  }
}


void announce(object who) {
  if (!this_object()) return;
  if (!who) return;
  CHANNEL_D->do_channel(this_object(), "chat",
    who->query("name") + "得到了" + name() + "！\n");
  CHANNEL_D->do_channel(this_object(), "rumor",
    who->query("name") + "得到了" + name() + "！\n");

}
