

//鹤脚落 heluo.c
//相关连接：鹰爪腿 天星乱华 龙星落 霸山天升脚

#include <ansi.h>
inherit SSERVER;

#include "bianzhao.h"

string name()  
{
return "「"HIC"鹤脚落"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "格斗家" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 

if ( me->query("ghost-spirit") && me->query_skill("ghost-spirit")<1500 )  //入魔不可
        return notify_fail("以你充满仇恨的心，怎么使得出"+name()+"？\n");

if( (int)me->query_skill("feiyan-cu",1) < 250 )
        return notify_fail("你的飞燕蹴还不够娴熟，不会使用"+name()+"。\n");

if( (int)me->query_skill("unarmed",1) < 250 )
        return notify_fail("你的扑击格斗之技还不够娴熟，不会使用"+name()+"。\n");
        
if( (int)me->query_skill("dodge",1) < 250 )
        return notify_fail("你的身法还不够娴熟，不会使用"+name()+"。\n");

if(me->query_skill("force", 1) <250)
        return notify_fail("你的内功修为不足以使用"+name()+"。\n");

if (me->query_skill_mapped("dodge") != "yuanwu-steps")
        return notify_fail("你现在无法使用"+name()+"。\n");                                                                                 
if (me->query_temp("hl_busy")+2 > time())
        return notify_fail("你刚使用过"+name()+"，体力尚未恢复。\n");                                                                                 
if( (int)me->query("max_force") < 1000 )
        return notify_fail("你的内力太弱，不足以使用"+name()+"。\n");

if( (int)me->query("force") < 600 )
        return notify_fail("你的真气不够！\n");

if ( me->query("gender")!="女性" && me->query_skill("yuanwu-xinfa", 1)<1500)
        return notify_fail("以你笨拙的男儿身怎使得出飞燕蹴的精髓！\n");

if ( me->query_temp("chunli/hejiao")>3 )
        return notify_fail("你已在运功中了！\n");

return 1;
}

int perform(object me, object target)
{
string msg,hit;
int ap,dp,damage,time;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

damage = me->query_skill("unarmed");
damage+= me->query_skill("yuanwu-xinfa",1);
damage+= me->query("force_factor");

me->start_call_out( (: call_other, __FILE__, "remove_effect",me :),2+random(3));

if ( !me->query_temp("chunli/hejiao") )
        {
        if ( me->query_temp("chunli/qingting")==2 )
                {
                if ( me->query_temp("chunli/fengyi") )
                        {
                        tell_object(me,HIC"你正使用凤翼中。\n"NOR);
                        return 1;
                        }
                call_out("fengyi",0,me,target,damage);
                }
        else if ( me->query_temp("chunli/xuanyuan")==2 )
                {
                if ( me->query_temp("chunli/bashan") )
                        {
                        tell_object(me,HIC"你正使用霸山中。\n"NOR);
                        return 1;
                        }
                call_out("bashan",0,me,target,damage);
                }
        else    {
                me->add("force", -150);
                msg = HIC"\n$N"HIC"一声娇叱，单足点地，一式「鹤式·冲天」跃至半空！\n"NOR,
                msg+= HIC"$n"HIC"抬头观看，只见$N"HIC"冲天的身姿在烈阳映照下仿佛一只硕大的白鹤！\n"NOR;
                message_vision(msg,me,target);
                if ( target->is_busy() )
                        {
                        msg = HIC"$N"HIC"见$n"HIC"呆若木鸡，怎肯放弃此绝好机会，在空中一声娇嗔，直落而下，
$2对准$n"HIC"的周身要害连连踢出！\n"NOR;
                        msg=replace_string(msg,"$2",random(2)?"左脚":"右脚");
                        message_vision(msg,me,target);
                        ap = me->query("combat_exp")/10000+1;
                        dp = target->query("combat_exp")/10000+1;
                        if ( ap > random(dp/3) )
                                {
                                msg = HIC"$n"HIC"眼里只有$N"HIC"的曼姿倩影，哪儿还躲闪得开？$1正中一脚！\n"NOR;
                                hit=hits[random(sizeof(hits))];
                                msg=replace_string(msg,"$1",hit);
                                message_vision(msg,me,target);
                                damage = damage/2+random(damage*3/2);
                                target->receive_damage("kee", damage, me);
                                COMBAT_D->report_status(target);
                                }
                        else    {
                                msg+=HIC"$n"HIC"知道这招厉害，强挽心神，堪堪闪在一旁。\n"NOR;
                                message_vision(msg,me,target);
                                }
                        }
                ap = me->query_cps();
                ap+= me->query_cor();
                dp = target->query_cps();
                dp+= target->query_cor();
                if ( random(ap+dp)>dp )
                        {
                        time = me->query_skill("literate");
                        time+= me->query_skill("feiyan-cu",1);
                        time/=200;
                        if ( time<2 ) time=2;
                        if ( time>10 ) time=10;
                        msg = HIC"$n"HIC"不由被$N"HIC"这华丽的招式深深吸引住，一时间目瞪口呆，忘记了战斗。\n"NOR;
                        message_vision(msg,me,target);
                        target->start_busy(1+random(time));
                        }
                else    {
                        msg = HIC"$n"HIC"看破$N"HIC"的伎俩，破口大怒：小贱人，居然敢诱惑我？！\n"NOR;
                        msg+= HIC"$N"HIC"暗叹一口气，收起了招式。\n"NOR;
                        message_vision(msg,me,target);
                        me->start_busy(1);
                        }
                }
        }

else if ( me->query_temp("chunli/hejiao")==1 )
        {
        if ( me->query_temp("chunli/huxi") )
                {
                tell_object(me,HIC"你正使用虎袭中。\n"NOR);
                return 1;
                }
        call_out("huxi",0,me,target,damage);
        }               
else if ( me->query_temp("chunli/hejiao")==2 )
        {
        if ( me->query_temp("chunli/tiansheng") )
                {
                tell_object(me,HIC"你正使用天升中。\n"NOR);
                return 1;
                }
        call_out("tiansheng",0,me,target,damage);
        }

me->add_temp("chunli/hejiao",1);
me->add_temp("hl_count",1);
if( ((int)me->query_temp("hl_count")%4)== 0 ) me->set_temp("hl_busy",time()+random(3)); //防止#n
return 1;
}
 
void remove_effect(object me)
{
if ( me->query_temp("chunli/hejiao")<=1 )
        me->delete_temp("chunli/hejiao");
else    
        me->add_temp("chunli/hejiao",-1);
return;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("feiyan-cu")+" 250 级\n";
temp+= "\t\t"+to_chinese("unarmed")+" 250 级\n";
temp+= "\t\t"+to_chinese("dodge")+" 250 级\n";
temp+= "\t\t"+to_chinese("force")+" 250 级\n";
temp+= "\t\t不可入魔\n";
temp+= "\t\t必须激发轻功为元武门身法\n";
temp+= "\t\t内力修为十年\n";
temp+= "\t\t内力６００点\n";
temp+= "\t\t元武门心法低于1500级时必须女性才能使用\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续打击对手的气血或精神
        出招类型：   
                busy或延时型外功  
                有隐藏效果  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
