
//神数转化为其他
//windy

#include <combat.h>
#include <ansi.h>
int help(object me);

int main(object me, string arg)
{
    int exp, level;
    level = (int)me->query("level");
    if (!arg)
        return notify_fail("你要耗费元神做什么？\n");
    if (arg != "level")
        return notify_fail("你的元神不能转化为该类状态。\n");
    if ((int)me->query("shen") < 1)
        return notify_fail("你的元神已然耗尽！\n");
    if (level < 200)
        return notify_fail("你的等级太低，难以转化元神！\n");
    if ((int)me->query("sen") < 300)
        return notify_fail("你的精神不足，小心走火入魔！\n");
    exp = 1000/level*200;
    me->add("shen", -1);
    me->add("sen", -300);
    me->add("level_exp", exp);
    if ((int)me->query("level_exp") >= 10000000)
        {
        me->set("level_exp", 0);
        me->add("level", 1);
        printf(HIW "你的级别得到了提升.\n" NOR); 
        }
    write("OK!\n");
    return 1;
}

int help(object me)
{
    write(@HELP
指令格式 :transfer <>

      把元神转化为 HP 属性。
      例如：transfer level 可以将元神转化为等级。

HELP
    );
    return 1;
}
