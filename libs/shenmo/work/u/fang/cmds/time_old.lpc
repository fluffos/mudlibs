// time.c
//snowtu
#include <ansi.h>
inherit F_CLEAN_UP;

#define Mudname HIW"天"HIG"上"HIY"人"HIM"间"NOR

int main(object me, string arg) {
  int i, t, tt, sec, min;
  i = me->query("combat_exp") - me->query("last_combat_exp");
  if (i < 0)
    i = 0;
  t = time() - me->query_temp("login_time");
  tt = t;
  t /= 60;
  if (t < 1) t = 1;
  i /= t;
  if (i < 0)
    i = 0;
  write("现在是" + Mudname + NATURE_D->game_time() + "。\n");
  write("你已经开始玩了 " YEL + FINGER_D->age_string(me->query("mud_age")) + NOR " 。" + Mudname + "提醒您：注意休息。\n");
  write("你上次的经验值为 " + me->query("last_combat_exp") + " ，现在的经验值为 " + me->query("combat_exp") + " 。历时 " + FINGER_D->age_string(tt) + " ，平均每分钟 " + i + " 点经验。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: time

这个指令让你知道现在的时辰以及你的成长情况。

HELP
  );
  return 1;
}
