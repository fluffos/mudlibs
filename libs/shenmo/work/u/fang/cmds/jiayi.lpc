#include <action.h>
#include <ansi.h>


int main(object me,string arg)
{ 
   int powerlvl;
   if( me->query("class") != "saint" ) return notify_fail("你的身体恐怕无法经受住嫁衣神功的功力。\n");
   if ( me->query("jiayi_second") < 2 ) return notify_fail("你还未能领悟出此最高秘诀。\n");
   if (me->query_skill_mapped("force")!="jiayi-force" ) return notify_fail("你现在并没使用嫁衣神功。\n");
   if( me->query("family/family_name") == "格斗家" ) return notify_fail("格斗家不能使用『他人嫁衣』。\n");
   if (me->query_skill("jiayi-force",1) < 620 ) return notify_fail("你的嫁衣神功等级太低，无法使用『他人嫁衣』。\n");
   
   if (arg=="busy"){
if ( time() < (me->query("jiayi_time")+60) ) return notify_fail("绝招用多了就不灵了。\n");
   if (!me->is_busy()||!me->is_fighting()) return notify_fail("你现在不需要使用『他人嫁衣』。\n");
   if (me->query("jiayi_num")<2) return notify_fail("你体内的真气不足以使出『他人嫁衣』。\n");
   message_vision(HIW"$N一声怒喝，猛运起 "+HIY+"嫁衣神功"+HIW" 使出最高秘诀---『他人嫁衣』,\n$N顿时动作变得连贯一致，毫无破绽。\n"NOR,me);
   me->add("jiayi_num",-2);
   me->start_busy(10,100);
   me->interrupt_me(me);
me->set("jiayi_time",time());
   return 1;}

   if (arg=="add"){
if (me->is_busy()) return notify_fail("你正忙着呢！\n");
   message_vision(HIW"$N将 "+HIY+"嫁衣神功"+HIW" 运贯全身，吸取着天地元气，将其转化为自身真气\n"NOR,me);
   powerlvl = me->query_skill("jiayi-force",1);
   powerlvl /= 20;
   if( powerlvl < 30 ) powerlvl = 1;
   if( powerlvl > 100 ) powerlvl = 100;
   me->add("jiayi_num",1);
   tell_object(me,"你体内的真气增加了！\n");
   if (me->query("jiayi_num")>= powerlvl)
        {
        me->set("jiayi_num",powerlvl);
      tell_object(me,"你所能容纳的真气已经到达极限。\n");
        }
   me->start_busy(5);

   return 1;}

   return notify_fail("你要使用『他人嫁衣』哪一法诀？\n"); 

}

int help(object me)
{
  write(@HELP
指令格式 : jiayi busy

此法诀可使你的招式连贯，变得毫无破绽,需消耗2点真气。

指令格式 : jiayi add

此法诀可使你将吸收天地间的元气，增加1点真气。

HELP
    );
    return 1;
}

