// lotusforce.c
#include <ansi.h>

inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }
int valid_learn(object me) { 
       if ( me->query("get_jiayi_book") != 1) return notify_fail("你无法体会嫁衣神功的奥妙！\n");
return 1;}


int practice_skill(object me)
{
        return notify_fail("嫁衣神功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func)
{
   return CLASS_D("forall")+"/jiayi-force/"+func;
}
int stage(int level)
{
        if( level <20 ) return 1;
        else if ( level < 40 ) return 2;
        else if ( level < 80 ) return 3;
        else if ( level < 140 ) return 4;
        else if ( level < 220 ) return 5;
        else if ( level < 320 ) return 6;
        else if ( level < 440 ) return 7;
        else if ( level < 580 ) return 8;
    else if ( level < 720 ) return 9;
    else if ( level < 840 ) return 10;
    else if ( level < 1000 ) return 11;
    else return 12;
}

string level_description(int level)
{
        if ( stage(level) < 3 )
                return BLU "第"+chinese_number( stage(level) )+"重　" NOR;
        else if ( stage(level) < 5 )
                return HIB "第"+chinese_number( stage(level) )+"重　" NOR;
        else if ( stage(level) < 7 )
                return YEL "第"+chinese_number( stage(level) )+"重　" NOR;
        else if ( stage(level) < 9 )
                return CYN "第"+chinese_number( stage(level) )+"重　" NOR;
       else if ( stage(level) < 11)
                return HIY "第"+chinese_number( stage(level) )+"重  " NOR;
       else 
                return HIW "第"+chinese_number( stage(level) )+"重" NOR; 
}

void skill_improved(object me)
{

        int level = (int)me->query_skill("jiayi-force", 1);
        if ( stage(level) == stage(level-1) + 1)
        {
                if( (int)me->query("jiayi_second") < 1 && random(12) > 4 && stage(level) > 6)
                {
                        me->set_skill("jiayi-force", 1 );
                        me->save();
                        message_vision(BLU"$N突然觉得通体难受，修习的嫁衣神功真气在$N体内失去了控制\n" NOR, me);

                }
                else
                        message_vision(HIY "$N突然觉得通体舒畅。原来是$N的嫁衣神功进入了第"+chinese_number(stage(level))+"重境界！\n" NOR, me);
        }
                        
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int lvl;
        if ( damage_bonus < 100 ) 
           return 0;
        lvl = me->query_skill("jiayi-force",1);
        if( stage(lvl) > 8 && me->query("jiayi_second") > 0  )
        {
           victim->receive_wound("kee", damage_bonus, me); 
           victim->receive_damage("kee", damage_bonus+random(damage_bonus), me); 
           message_vision(HIW"$N"HIW"突感一股极强的内劲传了过来,内息一滞,好像收了内伤！\n"NOR,victim);
          return 1;
        }
       return 0;
      
}
