mapping *action=({
([  "action":
"$N身形一晃，来到$n的后面，一脚"+HIB"「踢狗腿」"NOR"向$n的屁股踢去",
"dodge": -120,
"parry": -120,
"force": 1200,
"damage_type":  "内伤",
]),
});
int valid_enable(string usage)
{
return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus) 
{
message_vision(RED"$n一下就给$N踢晕了过去"NOR,me,victim);
victim->unconcious();
}
