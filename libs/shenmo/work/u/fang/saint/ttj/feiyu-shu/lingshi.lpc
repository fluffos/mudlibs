// peaceful
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name() {
  return "「" HIY "灵视飞羽" NOR "」";
}

int valid_perform(object me) {
  if ((me->query("class") != "saint" || me->query("family/family_name") != "通天教") && !me->samsara_check(
    "feiyu-shu",
    1
  ))
    return notify_fail("你不够资格使用" + name() + "！\n");
  if ((int)me->query_skill("feiyu-shu", 1) < 800)
    return notify_fail("你的飞羽术修为太浅，难以施展" + name() + "！\n");
  if ((int)me->query_skill("throwing", 1) < 800)
    return notify_fail("你的暗器使用修为太浅，难以施展" + name() + "！\n");
  if ((int)me->query_skill("tongtian-dafa", 1) < 800)
    return notify_fail("你的通天大法修为太浅，难以施展" + name() + "！\n");
  if ((int)me->query("max_force") < 8000)
    return notify_fail("你的内力修为太浅，难以施展" + name() + "！\n");
  if ((int)me->query("force") < 8000)
    return notify_fail("你的内力不足！\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  int extra;
  int howlong;
  extra = me->query_skill("feiyu-shu", 1);
  if (!valid_perform(me))
    return 0;
  if (me->query("env/invisibility"))
    return notify_fail("你已经抛出灵视飞羽了。\n");
  howlong = extra / 50;
  me->add("force", -100);
  message_vision(HIC "$N单掌虚握，一根白色的羽毛，在掌中诞生，缓缓的升到空中去了。\n\n" NOR, me, target);
  me->set_temp("yinshen/start", time());
  me->set_temp("yinshen/time", howlong);
  me->set_temp("yinshen/msg", HIW "\n你觉得内力不继，灵视羽慢慢飞回你的身上隐退不见了。\n" NOR);
  me->set("env/invisibility", 3);
  me->set_temp("no_heal_up/yinshen", 1);
  return 1;
}



int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("feiyu-shu") + " 800 级\n";
  temp += "\t\t" + to_chinese("throwing") + " 800 级\n";
  temp += "\t\t" + to_chinese("tongtian-dafa") + " 800 级\n";
  temp += "\t\t内力修为八十年\n";
  temp += "\t\t内力8０0０点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                利用羽毛让自己隐去身形
        出招类型：
                无隐藏攻击
                叛师不可带出
        出手要求：
HELP);
  write(temp);
  return 1;
}
