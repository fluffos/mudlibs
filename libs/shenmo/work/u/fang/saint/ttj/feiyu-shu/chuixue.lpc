// peaceful
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name()
{
return "「"HIW"吹雪飞羽"NOR"」";
}

int valid_perform(object me)
{
	if( ( me->query("class") != "saint" || me->query("family/family_name")!= "通天教") && !me->samsara_check("feiyu-shu",1) )
			return notify_fail("你不够资格使用"+name()+"！\n");
	if((int)me->query_skill("feiyu-shu", 1) < 800)
			return notify_fail("你的飞羽术修为太浅，难以施展"+name()+"！\n");
	if((int)me->query_skill("throwing", 1) < 800)
			return notify_fail("你的暗器使用修为太浅，难以施展"+name()+"！\n");
	if((int)me->query_skill("tongtian-dafa", 1) < 800)
			return notify_fail("你的通天大法修为太浅，难以施展"+name()+"！\n");
	if((int)me->query("max_force") < 8000 )
			return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n");
	if((int)me->query("force") < 8000 )
			return notify_fail("你的内力不足！\n");
	if (me->query_skill_mapped("spells")!="tongtian-dafa" )
			return notify_fail("吹雪飞羽必须配合法术才能使用。\n");     
	if (time()-me->query_temp("chuixue_end")<3+random(2))
			return notify_fail("你现在体力不继！\n"); 			
	return 1;
}

int perform(object me, object target)
{
    object weapon;
        string who1, who2;
    int damage, lvl, r_lvl, count, form, skill, i;
    string msg;

	if ( !valid_perform(me) )
		 return 0;
	if( !target ) target = offensive_target(me); 
	if( !target 
	||      !target->is_character() 
	||      target->is_corpse() 
	||      target==me) 
		 return notify_fail("你要对谁施展"+name()+"？\n"); 
	if(!me->is_fighting()) 
		return notify_fail(name()+"只能在战斗中使用！\n");   
        


	me->delete("env/brief_message");
	target->delete("env/brief_message");
	skill = (int)me->query_skill("feiyu", 1);
	lvl = skill/20;
	r_lvl = 3+random(lvl);
	if( r_lvl < 1) r_lvl = 1;
	count = me->query_str();
	write( HIW "你默运通天大法，使出吹雪飞羽，片片羽毛漫天飞舞,瞬间在周身裹成一团云雾," + target->name() + "的攻击被尽数挡回。\n"NOR);
	tell_object(target, HIW"忽然，你发现有一股奇怪的力量向你袭来,四周片片雪白的羽毛在你周围使你动探不得。\n"NOR);
	if (random(me->query("force",1)) > 6*target->query("force",1)/5 )
		{
				target->start_busy(random(6));
				damage = skill/2 + r_lvl*target->query("force_factor",1);
				target->receive_damage("kee", damage);
				target->receive_wound("kee", damage);
				me->add("force", -damage);
				  if (me->query("force")<0) me->set("force",0);
								msg = CYN "$N默运神功，使出吹雪飞羽。\n"NOR;
						msg += HIW "云雾罩将$n的内力全数反击回去！\n" NOR;
				if( damage < 70 )
						msg += HIM"结果$n受到$N的内力反震，闷哼一声。\n"NOR;
				else if( damage < 300 )
					   msg += HIR"结果$n被$N以内力反震，「嘿」地一声退了两步。\n"NOR;
				else if( damage < 450 )
					   msg += RED"结果$n被$N的飞羽，片片穿透而过。\n"NOR;
				else
					   msg += RED"结果$n被$N的羽毛，透胸而过！！\n"NOR;
				message_vision(msg, me, target);
		}
		else
		{
				tell_object(target, HIW"你周身不畅，似乎有股奇异的力量，将你的出招竟然反了回来击向自己！\n"NOR);
				target->start_busy(random(6));
				message("vision", HIW"\n" + target->name() + "被羽毛裹住，片片羽毛控制着你不停的象自己进攻！\n\n"NOR, environment(me), target);
				for(i = 0; i < r_lvl; i++)
				COMBAT_D->do_attack(target, target, target->query_temp("weapon") );
				me->add("force", -200);
				}

		if( !target->is_fighting(me) ) {
				if( living(target) ) {
						if( userp(target) ) target->fight_ob(me);
						else target->kill_ob(me);}

		}
		me->set_temp("chuixue_end",time() );
		return 1;
}



int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("feiyu-shu")+" 800 级\n";
temp+= "\t\t"+to_chinese("throwing")+" 800 级\n";
temp+= "\t\t"+to_chinese("tongtian-dafa")+" 800 级\n";
temp+= "\t\t必须装备通天大法\t";
temp+= "\t\t内力修为八十年\n";
temp+= "\t\t内力8０0０点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                利用羽毛展开不同类型的攻击
        出招类型：
                延时型外功  
                无隐藏攻击
                叛师不可带出
        出手要求：
HELP);
write(temp);
return 1;
}
