// peaceful
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name()
{
return "「"HIW"五色神光"NOR"」";
}

int valid_perform(object me)
{
	if( ( me->query("class") != "saint" || me->query("family/family_name")!= "通天教") && !me->samsara_check("feiyu-shu",1) )
			return notify_fail("你不够资格使用"+name()+"！\n");
	if((int)me->query_skill("feiyu-shu", 1) < 1000)
			return notify_fail("你的飞羽术修为太浅，难以施展"+name()+"！\n");
	if((int)me->query_skill("throwing", 1) < 1000)
			return notify_fail("你的暗器使用修为太浅，难以施展"+name()+"！\n");
	if((int)me->query_skill("tongtian-dafa", 1) < 1000)
			return notify_fail("你的通天大法修为太浅，难以施展"+name()+"！\n");
	if((int)me->query("max_force") < 8000 )
			return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n");
	if((int)me->query("force") < 8000 )
			return notify_fail("你的内力不足！\n");
	if (me->query_skill_mapped("spells")!="tongtian-dafa" )
			return notify_fail(name()+"必须配合法术才能使用。\n");
	return 1;
}

int perform(object me, object target)
{
        string msg;

		if ( !valid_perform(me) )
				return 0;
		if( !target ) target = offensive_target(me);
		if( !target
		||      !target->is_character()
		||      target->is_corpse()
		||      target==me)
				return notify_fail("你要对谁施展"+name()+"？\n");
		if(!me->is_fighting())
				return notify_fail(name()+"只能在战斗中使用！\n");

        message_vision(HIR"$N念动真言缓缓从地面升起，两条火蛇向两侧游走包向$n。\n"NOR,me,target);
        me->start_call_out( (: call_other, __FILE__, "kill_him", me,
		target :), random(5)+5);
					  me->start_busy(4+random(2));
						me->add("force", -2000);
						me->add("mana", -2000);
        return 1;
}
void kill_him(object me, object target)
{
        string msg;
        if(me->is_fighting() && target->is_fighting() &&
        environment(me) == environment(target))
        {
		msg = HIR "五色神光在$n身后合拢，顿时$n被笼罩在一片光芒之中。
		红橙黄绿蓝五色光芒从$N身上飞射出来射向$n，
		$N在五色光芒中，轻轻扔出了一道"HIY"金色的光华。" ;
		if(!target->query("莲花") && !target->query("任务") && (int)target->query_skill("busi-force", 1)<500 )
			{
				msg +=  "\n金色的光华"HIR"直射向$n的面门。$n倒在了地上。。。\n" NOR;
				message_vision(msg, me, target);
				target->die();
			}
		else
			{
				if ((int)target->query_skill("busi-force", 1)>=500)
				msg +=  WHT"哪料$n"WHT"却鬼使神差地躲开了这道神光！竟是江湖中失传已久的"RED"不死印法！\n" NOR;
				else
				msg +=  WHT"$n"WHT"大惊之下，情急生智，施展平生所学，堪堪躲开了此道神光剑！\n" NOR;
				msg +=  WHT"即便如此，$n"WHT"亦被吓出一身冷汗，脸色立刻变得煞白。\n" NOR;
				message_vision(msg, me, target);
			}

        }
        me->start_busy(3);
        return ;
}



int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("feiyu-shu")+" 1000 级\n";
temp+= "\t\t"+to_chinese("throwing")+" 1000 级\n";
temp+= "\t\t"+to_chinese("tongtian-dafa")+" 1000 级\n";
temp+= "\t\t必须装备通天大法\t";
temp+= "\t\t内力修为八十年\n";
temp+= "\t\t内力8０0０点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                给对手必杀一击
        出招类型：
                蓄势型外功
                无隐藏攻击
                叛师不可带出
        出手要求：
HELP);
write(temp);
return 1;
}
