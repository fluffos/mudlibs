
// write by windy 07/06/20
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIY"韦陀现世"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "大昭寺" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("xiangmo-chu", 1) < 300) 
        return notify_fail("你的金刚降魔杵修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("stick", 1) < 300) 
        return notify_fail("你的基本棍法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("longxiang", 1) < 300) 
        return notify_fail("你的龙象般若功修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("shenkong-xing", 1) < 300) 
        return notify_fail("你的身空行修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_temp("weituo_busy", 1) < time()+2+random(4) ) 
        return notify_fail("你用的太频繁了，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 4000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 2000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int i, lvl, extra;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
extra = me->query_skill("stick", 1);
extra+= me->query("level");
extra = extra/3;
lvl = me->query_skill("xiangmo-chu", 1)/100;
if (lvl>8)    lvl=8;

message_vision(HIY"\n$N"HIY"将金刚降魔杵发挥到极致，如同韦陀附体一般，周身金光四射，全力攻向$n"HIY"！"NOR,me,target);
me->add_temp("apply/attack", extra/2);
me->add_temp("apply/damage", extra/2);
COMBAT_D->do_attack(me,target, weapon);
for (i=0;i<=lvl;i++)
        {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(HIY"\n$N"HIY"回转手中"+weapon->name()+""HIY"，又是一杵！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, weapon);
      if( me->query_skill_mapped("force")=="longxiang" )
        SKILL_D("longxiang")->hit_ob(me,target,me->query_skill("longxiang",1) );
        }
me->add_temp("apply/attack", -extra/2);
me->add_temp("apply/damage", -extra/2);
me->set_temp("weituo_busy",time());
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("xiangmo-chu")+" 300 级\n";  
temp+= "\t\t"+to_chinese("stick")+" 300 级\n";  
temp+= "\t\t"+to_chinese("longxiang")+" 300 级\n";  
temp+= "\t\t"+to_chinese("shenkong-xing")+" 300 级\n";  
temp+= "\t\t内力修为四十年\n"; 
temp+= "\t\t内力２０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续打击对手的气血
        出招类型：   
                busy 型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
