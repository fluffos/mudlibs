#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void remove_effect(object me);
void check_fight(object me);

int perform(object me, object target) {
  object ob;
  string msg;
  int skill;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("粘连粘随只能带动战斗中的对手。\n");
  if ((me->query("family/family_name") != "武当派") && !me->samsara_check("taiji-quan", 1))
    return notify_fail("你不是武当弟子。\n");

  if (me->query_temp("nian_end") > time())
    return notify_fail("绝招用多了,就灵了。\n");

  skill = (int)me->query_skill("taiji-quan");
  ob = me->query_temp("nian");
  if (objectp(ob)) {
    if (ob == target)
      return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");
    else {
      remove_call_out("remove_effect");
      remove_effect(me);
    }

  }

  if (me->query_skill("taiji-quan", 1) < 120)
    return notify_fail("你的太极拳极不够娴熟，不会使用「粘」字诀。\n");

  if (me->query_skill("taiji-shengong", 1) < 120)
    return notify_fail("你的太极神功修为不够，不会使用「粘」字诀。\n");

  //msg = HIY "$N双手抱了个太极式的圆圈，顿时一招一式节节贯串，左圈右圈圆转不断，如长江大河，滔滔不绝。\n";
  msg = HIY "\n$N左手带着$n的右手，转了一个大圈，一股极强的螺旋力带动$p左手，正是太极云手。\n";

  me->add("kee", -150);
  me->add("force", -150);

  if (random(me->query("combat_exp") / 1000) * me->query_int()
    > (int)target->query("combat_exp") / 2000 * target->query_int()) {
    //msg += "结果$p被$P粘连得跌跌撞撞，身不由主的立足不稳，犹如中酒昏迷。\n" NOR;
    msg += "这云手连绵不断，一圈过后，又是一圈，$n的双掌似乎全给$P粘住了。\n" NOR;
    me->set_temp("nian", target);
    me->set_temp("nian_end", time() + 3 + random(4));
    target->start_busy(5);
    check_fight(me);
    //me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), skill/6);    
    call_out("remove_effect", skill / 6, me);
  } else {
    switch (random(3)) {
      case 0: msg += "$p急忙使出“千斤坠”之力定住身形。\n" NOR; break;
      case 1: msg += "$p不敢便接，斜身闪开。\n" NOR; break;
      case 2: msg += "$n全身内力一震，$P双手按他不住，被$p跃出圈外！\n" NOR; break;
    }
    me->start_busy(2 + random(2));
  }
  message_vision(msg, me, target);
  return 1;
}

void check_fight(object me) {
  if (!me) return;

  if (me->query_skill_mapped("unarmed") != "taiji-quan" ||
    !me->is_fighting() || me->query("force") < 10
  ) {
    remove_call_out("remove_effect");
    remove_effect(me);
  } else call_out("check_fight", 1, me);
}

void remove_effect(object me) {
  if (objectp(me->query_temp("nian"))) {
    me->delete_temp("nian");
    message_vision(HIG "\n$N劲力一松，粘力卸去。\n" NOR, me);
  }
}
