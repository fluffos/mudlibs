#include <ansi.h>
inherit F_DBASE;
inherit SSERVER;
void remove_effect(object me, object target, int amount);
int perform(object me, object target)
{
        int skill_sword, skill_dodge, dodge_amount,attack_amount;

        if( me->query_skill_mapped("dodge") != "tiyunzong" )
                return notify_fail("太极剑法「随」字诀只能配合梯云纵使用。\n");
        skill_dodge=me->query_skill("dodge");        
        if (skill_dodge<100) return notify_fail("你轻功修为还不够高深，无法施展太极剑法「随」字诀。\n");
                
                if(me->query("family/family_name")!="武当派" && !me->samsara_check("taiji-jian",1) )
                return notify_fail("非武当弟子不能用太极剑法「随」字诀！\n");
        if (me->query_skill_mapped("force")!="taiji-shengong")
                return notify_fail("太极剑法「随」字诀必须配合太极神功才能使用。\n");
        skill_sword=me->query_skill("force");        
        if (skill_sword<100) return notify_fail("你的内功心法修为还不够高深，无法施展「"HIC"清风拂柳"NOR"」。\n");
        skill_sword=me->query_skill("sword");
        if (skill_sword<100) 
           return notify_fail("你的基本剑术修为还不够高深，无法施展「"HIC"清风拂柳"NOR"」。\n");
        if( (int)me->query("force") < 50 )      
                return notify_fail("你的内力不够。\n");
        if( (int)me->query_temp("sui") )
                return notify_fail("你已经在运功中了。\n");
        
        me->add("force", -50);
        message_vision(HIB "$N使出太极剑法「随」字诀，剑圈逐渐缩小将周身护住。\n" NOR, me);
 
        attack_amount=skill_sword/5;
        dodge_amount=skill_sword*(5+random(6))/10; 
        me->add_temp("apply/attack", -attack_amount);  
        me->add_temp("apply/dodge",attack_amount);  //trade offense for defense.  
        me->set_temp("sui", 1);
        me->start_call_out( (: call_other, __FILE__, "remove_effect", 
           me, dodge_amount,attack_amount:), skill_sword/5);
 
         return 1;
}
 
void remove_effect(object me, int dodge_amount,int attack_amount)
{
        me->add_temp("apply/dodge", -attack_amount);
        me->add_temp("apply/attack", attack_amount);
        me->delete_temp("sui");
        message_vision(HIY "$N的随字决运行完毕，将内力收回丹田。\n"NOR,me);
}


