// tiyunzong.c 梯云纵
// modified by fang
// written by fang
#include <ansi.h>
inherit SKILL;

string *dodge_msg = ({
    "只见$n一招「白鹤冲天」，身体向上笔直地纵起丈余，躲过了$N这一招。\n",
    "$n一个「鹞子翻身」，向后纵出数丈之远，避开了$N的凌厉攻势。\n",
    "$n使出「大鹏展翅」，向一旁飘然纵出，轻轻着地。\n"
    "但是$n身形飘忽，轻轻一纵，早已避开。\n",
    "$n身随意转，倏地往一旁挪开了三尺，避过了这一招。\n",
    "可是$n侧身一让，$N这一招扑了个空。\n",
    "却见$n足不点地，往旁窜开数尺，躲了开去。\n",
    "$n身形微晃，有惊无险地避开了$N这一招。\n"
});

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move");
 }

int valid_learn(object me) { 
        if( me->query("family/family_name")!="武当派" && !me->samsara_check("tiyunzong",1))
                return notify_fail("你非武当弟子，难以领会梯云纵的奥妙之处！\n");
        
        return 1; }

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    if( (int)me->query("kee") < 40 )
   return notify_fail("你的体力太差了，不能练梯云纵。\n");
    me->receive_damage("kee", 30);
   me->add("force", -3);  return 1;
}

int ob_hit(object me,object victim,int damage)
{
        int skill,skill1;
        skill1 = victim->query_skill("taiji-shengong",1);
        skill = victim->query_skill("tiyunzong",1);
        if( skill1 < 350 || skill < 350 || random(skill) < random(me->query_skill("tiyunzong",1)) )
                return 0;
        skill += skill1;
        if( skill > 1000 ) skill = 1000;
        skill /= 5;
        
        skill1 = skill/4;
        while( random(skill) > 50 )
        {
                skill1 += 10;
        }
        if( skill1 < 50  )
                victim->set_temp("dodge_skill_msg",HIR"纵身一跃，闪过$N的部分攻击\n"NOR);
        else 
        victim->set_temp("dodge_skill_msg",HIR"纵身一跃，闪过$N的大部分攻击\n"NOR);
        if( skill1 > 100 ) 
        {       
                skill1 = 100;
        victim->set_temp("dodge_skill_msg",HIR"纵身一跃，躲过$N的攻击\n"NOR);
        }

        return (-damage*skill1/100);

}
