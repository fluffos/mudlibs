int valid_learn(object me)
{
        
        if( me->query("family/family_name")!="武当派" && !me->samsara_check("taiji-quan",1))
                return notify_fail("你非武当弟子，难以领会太极拳法的奥妙之处！\n");

        if( me->query_temp("weapon") || me->query_temp("secondary_weapon")
)
                return notify_fail("练太极拳必须空手。\n");
        return 1;
}

int valid_enable(string usage)
{
        return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("sen") < 30)
                return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
        if( (int)me->query("kee") < 30 )
                return notify_fail("你现在手足酸软，休息一下再练吧。\n");
        if( (int)me->query("force") < 10 )
                return notify_fail("你的内力不够了。\n");

        me->receive_damage("kee", 30);
        me->add("force", -10);

        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
            object ob;
                ob = me->query_temp("nian");
                if( objectp(ob) && ob == victim )
                {
                        if( !victim->is_busy()) victim->start_busy(2);
                        victim->receive_wound("kee",me->query_skill("taiji-quan",1)*2);
                        return HIW"$n给太极拳粘住，「喀啦」一声轻响，竟似是骨头爆裂！\n"NOR;
                }
        if( damage_bonus < 100 ) return 0;

        if( random(damage_bonus/2) > victim->query_str()/10) {
                victim->receive_wound("kee", (damage_bonus - 50) / 5 );
                switch(random(2)) {
                        case 0: return HIR"你听到「喀啦」一声轻响，竟似是骨头爆裂的声音！\n"NOR;
                        case 1: return HIY"$N劲力一吐，$n的$l发出「喀」地一声爆响！\n"NOR;
                               }
        }
}

string perform_action_file(string func)
{
 return CLASS_D("wudang") + "/taiji-quan/"+func;
}

