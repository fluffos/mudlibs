#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int success_adj, damage_adj;

  if (!target) target = offensive_target(me);
  if (me->query("family/family_name") != "武当派" && !me->samsara_check("taixu-spells", 1))
    return notify_fail("不是武当山弟子不能用！\n");
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要用真武剑阵打谁？\n");

  if ((int)me->query("mana") < 25 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 20)
    return notify_fail("你无法集中精力，别打中自己了！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 10);

  if (random(me->query("max_mana")) < 50) {
    write("好象没反应，再来一次吧！\n");
    return 1;
  }

  SPELL_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    "sen",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    BLINK HBBLU "$N口中念了几句咒文，真武剑阵突然启动，半空中突然\n十三个手持长剑的五行弟子把你围在中间！\n" NOR,
    //initial message
    HBMAG "结果剑阵弟子齐出，差点没把$n捅成马蜂窝！\n" NOR,
    //success message
    HIC "但是$n在千钧一发之际躲了开来。\n" NOR,
    //fail message
    HIC "但是真武被$n以法力一引，反而弟子们都对着$N出剑！\n" NOR,
    //backfire initial message
    HIC "结果捅个正着，差点没把$n捅成马蜂窝！\n" NOR
    //backfire hit message. note here $N and $n!!!
  );

  me->start_busy(1 + random(2));
  return 3 + random(5);
}
