
#include <ansi.h>
#include <combat.h>
#include "expell.lpc"

void create()
{   
        int i,k,m,n;  
        string name,*id;   

        set_name(HIY"出师大使"NOR,({"master", "npc"})); 
        set("title", HIC+"一个好人"+NOR);   
        set("long", HIC"这是方舟设计，用来出师的NPC,他出手很重，同他过招一定要小心！\n"NOR);   
        set("gender",((random(2)==1)?"男性":"女性"));   
        set("max_sen",6000);   
        set("eff_sen",6000);   
        set("sen",6000);   
        set("max_kee",6000);   
        set("eff_kee",6000);   
        set("kee",4000);   
        set("combat_exp", random(300000));   
        set("bellicosity", 200+random(300));   
        set("daoxing",random(3000000));   
    set("inquiry", ([
                "expell"        :       (:ask_expell:),
                                ]));
        setup( ); 
        set_skill("unarmed", 200);   
        set_skill("dodge", 200);   
        set_skill("staff", 200);   
        set_skill("parry", 200);   
        set_skill("force", 200);  
        set_skill("lotusforce", 200);  
        set_skill("jienan-zhi", 200);  
        set_skill("lotusmove", 200);  
        set_skill("lunhui-zhang", 200);  
        set_skill("buddhism", 200);  
        map_skill("unarmed","jienan-zhi");   
        map_skill("dodge","lotusmove");   
        map_skill("staff","lunhui-zhang");   
        map_skill("parry","lunhui-zhang");   
        map_skill("force","lotusforce");   
        map_skill("spells","buddhism");   
        carry_object("/d/obj/weapon/sword/changjian")->wield();
} 
       
void init() 
{   
        remove_killer(this_player());   
        remove_enemy(this_player()); 
        add_action("do_none","cast");   
        add_action("do_none","ji");   
        add_action("do_none","apply");   
        add_action("do_none","fight");  
        add_action("expell_confirm","confirm");
        ::init();   
} 
       
       
int do_none() 
{  
        object ob = this_object();   
        object me = this_player();   
        message_vision("\n$N对着$n摇了摇头。\n\n",ob,me);   
        return 1;   
} 
     

