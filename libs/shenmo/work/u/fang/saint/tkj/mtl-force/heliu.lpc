// heliu.c

#include <ansi.h>

int exert(object me, object target)
{
   int m,s;

	if( me->is_fighting() )
		return notify_fail("战斗中运用合流？找死吗？\n");

       m=me->query_skill("mtl-force",1);
       s=me->query_skill("shouya-force",1);

       if (m<350) return notify_fail(HIG"你的曼佗罗心经修为不够！\n"NOR);
       if (s<350) return notify_fail(HIG"你的兽牙魔经修为不够！\n"NOR);

	if( (int)me->query("force") < 1000 )
		return notify_fail("你的真气不够。\n");

   if (me->query_temp("heliu")){

       me->start_busy(3);
	message("vision",
		HIC + me->name() + "盘膝而坐，默默运聚曼佗罗心经。少倾，体内曼佗罗心经于全身经脉之间运行不息。\n" NOR,
		environment(me), me);
       message_vision(HIY"此时，$N又强运起兽牙魔经,登时，体内两股内力互相抗衡冲激。$N全身经脉欲断，痛苦不堪。\n"NOR,me);

       if ( random(me->query("kar"))<20 ){
            me->unconcious();
            me->set("force",0);
            me->set("force_factor", 0);
            me->delete_temp("heliu");
            return notify_fail(HIR"你支撑良久，终于抵挡不住体内两股内劲的冲激，两眼一反，晕了过去。\n"NOR);}

       message_vision(HIW"$N只觉体内两股内劲间的抗衡越来越剧，冲激也越来越盛，急忙抱元守一，任由内劲在体内驰骋。\n"NOR,me);
       message_vision(HIG"良久，体内两股内劲渐渐平缓下来，彼此间的抗争亦转为互相包容。\n"NOR,me);
       message_vision(HIG"慢慢的，曼佗罗心经与兽牙魔经逐渐合流为一体，两种截然不同的内劲融合为一种新的内劲----神谕 ！\n"NOR,me);
       message_vision(HIY"$N强压住内心的狂喜，将神谕运转了十二周天缓缓纳入丹田之中，站起身来。\n"NOR,me);
       me->delete_skill("mtl-force");
       me->delete_skill("shouya-force");
       me->set_skill("shenyu",(int)(m+s)/2);
       me->map_skill("force", "shenyu");
       me->delete_temp("heliu");
	return 1;
      }

  me->set_temp("heliu",1);
  return notify_fail(HIG"你准备将体内两种内劲合流为一体，再运用一次合流，则开始进行合流。\n"NOR);

}
