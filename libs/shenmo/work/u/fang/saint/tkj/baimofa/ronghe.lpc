// ronghe.c

#include <ansi.h>
inherit SSERVER;

int cast(object me, object target)
{
   int h,b;

	if( me->is_fighting() )
		return notify_fail("战斗中运用融合？找死吗？\n");

       h=me->query_skill("heimofa",1);
       b=me->query_skill("baimofa",1);

       if (h<350) return notify_fail(HIG"你的黑魔法修为不够！\n"NOR);
       if (b<350) return notify_fail(HIG"你的白魔法修为不够！\n"NOR);

        if( (int)me->query("mana") < 1000 )
		return notify_fail("你的法力不够。\n");

   if (me->query_temp("ronghe")){

       me->start_busy(3);
	message("vision",
		HIC + me->name() + "盘膝而坐，脑海之中黑白两种魔法的咒文不住来回交错浮现，周身法力激荡，令人无法临近。\n" NOR,
		environment(me), me);

       if ( random(me->query("kar"))<20 ){
            me->unconcious();
            me->set("mana",0);
            me->delete_temp("ronghe");
            return notify_fail(HIR"你苦苦思考黑白这两种逆道而驰魔法的异同，却迟迟未能参破其中玄机，心中一急，法力反噬，登时晕了过去。\n"NOR);}

       message_vision(HIW"$N苦苦参悟黑白这两种逆道而驰魔法的异同，于冥冥之中有所感悟，却时候未能参破。\n"NOR,me);
       message_vision(HIG"$N包元守一，强压下浮躁的心绪，由简而繁，从本入末，慢慢寻求着那最后的突破口。\n"NOR,me);
       message_vision(HIG"突然脑中一阵轰鸣，$N只觉黑白两种魔法的咒文不断旋转，彼此包容，逐渐融合成一种全新的咒术---魔咒！\n"NOR,me);
       message_vision(HIY"$N周身激荡的法力变得极为平缓，慢慢散去。$N睁开双眼，站起身来。\n"NOR,me);
       me->delete_skill("heimofa");
       me->delete_skill("baimofa");
       me->set_skill("mozhou",(int)(h+b)/2);
       me->map_skill("spells", "mozhou");
       me->delete_temp("ronghe");
	return 1;
      }

  me->set_temp("ronghe",1);
  return notify_fail(HIG"你准备参悟黑白两种魔法的融合之道，再运用一次融合，则开始进行融合。\n"NOR);

}
