#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void xian_ok(object);

int perform(object me, object target) {
  int damage;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「天魔献月」？\n");
  if (me->query("family/family_name") != "天空界")
    return notify_fail("[天魔献月]是天空界不传之密！\n");
  if (!me->is_fighting())
    return notify_fail("「天魔献月」只能在战斗中使用！\n");
  if ((int)me->query("max_force") < 300)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if (me->query_temp("no_xian"))
    return notify_fail("看你那样，天魔都被你吓跑了！\n");
  if ((int)me->query_skill("tianlang-blade", 1) < 150)
    return notify_fail("你的刀法不够熟练，使用这一招会有困难！\n");

  me->delete("env/brief_message");
  target->delete("env/brief_message");

  message_vision(HIC "$N对着$n一声冷笑，两眼无光，说时迟，那时快...\n" NOR, me, target);
  message_vision(HIC "$N手中的刀，刹那间已连劈出三刀，$n的脸顿时一片漆黑，显然是受了极其严重的内伤。\n" NOR, me, target);
  damage = (int)me->query_skill("blade") + random((int)me->query_skill("blade"));

  if (random((int)target->query("combat_exp")) < (int)me->query("combat_exp") / 2) {
    message_vision(RED "只见$n已被$N切得体无完肤，血如箭般由全身喷射而出！\n" NOR, me, target);

    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 2);
    COMBAT_D->report_status(target);

  } else {
    message_vision(HIC "可是$p急忙抽身躲开，$P这招没有得逞。\n" NOR, me, target);
  }

  me->receive_damage("sen", 50);
  me->add("force", -100);
  me->set_temp("no_xian", 1);

  call_out("xian_ok", 3 + random(2), me);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  return 1;
}

void xian_ok(object me) {
  if (!me) return;
  me->delete_temp("no_xian");
}
