#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int mypot, tapot, time;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「天魔附体」只有在战斗中才能使用。\n");
  if (me->query("family/family_name") != "天空界")
    return notify_fail("非天空界弟子不能能请得动天魔效劳麾下！\n");
  if ((int)me->query_skill("tianlang-blade", 1) < 100)
    return notify_fail("你的修为不够深，还使不出这一招！\n");
  if (me->is_busy())
    return notify_fail("你太忙了！\n"); ;
  if (target->is_busy())
    return notify_fail(target->name() + "已经够忙了，你再怎么卖力，天魔也没办法附体的。\n");
  message_vision(HIC "$N大喝一声,天魔老祖,瞬时一道血光朝$n飞去！\n\n" NOR, me, target);

  mypot = (int)me->query_skill("blade");
  mypot = mypot * mypot * mypot / 10 + random((int)me->query("combat_exp"));

  tapot = (int)target->query_skill("parry");
  tapot = tapot * tapot * tapot / 10 + random((int)target->query("combat_exp"));

  time = (int)me->query_skill("tianlang-blade", 1) / 50;
  if (time > 10) time = 10;
  if (time < 4) time = 4;

  if (random(mypot + tapot) > tapot / 2) {
    message_vision(HIR "$N果然被此血光罩住，天魔附体！\n" NOR, target);
    //                target->start_busy(5+random(time));
    target->start_busy(3 + random(2));

  } else {
    message_vision(HIR "不料确被$N看破，纵身一跃，天魔长叹走开了！\n" NOR, target,
      me);
    me->start_busy(1 + random(time / 2));
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
    me->kill_ob(target);
  }
  return 1;
}
