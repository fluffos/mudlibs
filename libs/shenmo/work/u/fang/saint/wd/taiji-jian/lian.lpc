#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, i, k, lmt;
  object weapon;

  extra = me->query_skill("taiji-jian", 1) + me->query_skill("sword", 1);
  if (extra < 200) return notify_fail("你的太极剑法与基本剑法还不够等级！\n");

  if (me->query_skill("taiji-shengong", 1) < 120)
    return notify_fail("你的太极神功等级不够。\n");


  if (me->query("family/family_name") != "武当派")
    return notify_fail("“连”字决只有武当派门人才可以用！\n"); if ((string)me->query_skill_mapped("force") != "taiji-shengong")
      return notify_fail("连字决必须以太极神功做底子。\n");
  if (me->query("max_force") < 1000)
    return notify_fail("你的内力不足。\n");
  if (me->query("force") < 1000)
    return notify_fail("你的内力不足。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［连］字决只能对战斗中的对手使用。\n");

  weapon = me->query_temp("weapon");

  msg = BLINK HBBLU "$N使出太极剑法「连」字诀，招式陡然变快 " NOR + " \n"
    HIR " 结果$p被$P攻了个措手不及，连连后退不暇！\n" NOR;
  message_vision(msg, me, target);


  me->add_temp("apply/attack", extra / 3);
  me->add_temp("apply/damage", extra / 3);
  k = (int)me->query_skill("sword", 1);
  lmt = 5 + (k - 100) / 15;

  if (lmt > 12) lmt = 12;
  for (i = 5; i <= lmt; i++) {
    me->set_temp("FMZ_perform", i);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  }
  me->add_temp("apply/attack", -extra / 3);
  me->add_temp("apply/damage", -extra / 3);
  me->add("force", -300);
  me->delete_temp("FMZ_perform");
  me->start_busy(2 + random(1));
  return 1;
}
