
#include <ansi.h>
#include <combat.h>

//inherit F_CLEAN_UP;
inherit SSERVER; 

void remove_effect(object me);
void check_mapped(object me);
string nlch_result(object me, object victim, int mod_val, int force_adj, mapping action);

int exert(object me, object target)
{
        int skill,damage,myforce,tforce,myexp,texp,ap,dp;
        object weapon;

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
        return notify_fail("[纳流成海]只能对战斗中的对手使用。\n");


        skill = me->query_skill("taiji-shengong",1);
	
        if (me->query_temp("nlch"))
          { 
            damage=me->query_temp("nlch_damage")+me->query("force_factor")*(me->query_skill("taiji-shengong",1)/100+1);
            damage=damage-target->query_temp("apply/armor");
            if (damage<0) damage=0;
            if (!me->query_temp("nlch_damage")) return notify_fail(YEL"你尚未吸纳敌人的内劲，逆运不出[纳流成海]心法。\n"NOR);
   	     else {
                  if (!weapon=me->query_temp("weapon")) 
                  message_vision(HIW"$N逆运"+HIC" 纳流成海 "+HIW"心法将体内吸纳的外来内劲尽数汇聚于双掌之上，猛的推掌击向$n。\n"NOR,me,target);
                  else message_vision(HIW"$N逆运"+HIC" 纳流成海 "+HIW"心法将体内吸纳的外来内劲尽数汇聚于"NOR+weapon->query("name")+HIW"之上，挟着风雷之势击向$n。\n"NOR,me,target);
                  
                  myforce=me->query_skill("force"); 
                  tforce=target->query_skill("force"); 
                  myexp=me->query("combat_exp");
                  texp=target->query("combat_exp");

                  ap=myforce*myforce*myforce/10+myexp;
                  dp=tforce*tforce*tforce/10+texp;
        
                  if (ap>1000000) {ap/=10000;dp/=10000;}
                  if (ap>10000000) {ap/=10;dp/=10;}
                  ap=me->query_temp("nlch_damage")/(me->query_skill("taiji-shengong",1)*5)*ap+ap; 

                  if (random(ap)>random(dp)&&damage!=0) 
                     { 
                       message_vision(HIR"强大的劲力紧紧牵引着$n的动作，$n避无可避硬挨了这招，鲜血狂喷而出。\n"NOR,me,target);              
                       target->receive_wound("kee", damage/4);
                       target->receive_damage("kee", damage/2);
     	                COMBAT_D->report_status(target);
                      }else
                       message_vision(HIC"招未至，劲气已扑面而来，$n深知此招厉害，一个懒驴打滚，堪堪闪过！\n"NOR,me,target); 

                   me->start_busy(1+random(2));
                   me->set_temp("nlch_damage",0);
                   remove_effect(me);
                   return 1;
                   }  

             }


        if(time()-(int)me->query_temp("nlch_end") < 20) return notify_fail("频繁使用此招，恐有伤自身。\n");
        
        if( (int)me->query("force") < skill*2 )     
		return notify_fail("你的内力不够。\n");
		
        
        if( me->query_temp("nlch") ) 
	{remove_effect(me);return 1;}

        me->add("force", -skill);
        message_vision(HIY "$N缓缓的运起"+HIC" 纳流成海 "+HIY"心法，内劲逐渐由急转缓，不多时，内劲已散布周身，不起一丝波动！\n" NOR, me);
        me->set_temp("nlch", 1);
        call_out("check_mapped", 1, me);
        
        return 1;
}


void check_mapped(object me)
{
	if(!me) return;                
	if( me->query_skill_mapped("force") != "taiji-shengong" ) 
         {remove_effect(me);return;}
	if(!me->is_fighting() ) {remove_effect(me);return;}
	if(!me->query_temp("nlch")) {remove_effect(me);return;}						
	call_out("check_mapped", 1, me);
	    
}


void remove_effect(object me)
{
        if(!me) return;
        remove_call_out("check_mapped");
        me->set_temp("nlch_end", time() );

        if (me->query_temp("nlch")) {
        if (me->query_temp("nlch_damage"))
            tell_object(me,HIY"你长舒一口气，散去"+HIC" 纳流成海 "+HIY"心法，将吸纳的内劲尽数宣泄而出，太极内劲又逐渐在体内急速运行起来。\n"NOR);
        else 
            tell_object(me,HIY"你长舒一口气，散去"+HIC" 纳流成海 "+HIY"心法，太极内劲又逐渐在体内急速运行起来。\n"NOR);
        }
        me->delete_temp("nlch_damage");
        me->delete_temp("nlch");
}


string nlch_result(object me, object victim, int mod_val, int force_adj,mapping action)
{   string result,str;
    int me_force,v_dodge,full,rate1,rate2;
    object vweapon;
    int damage, damage_bonus,defense_factor,wounded,i;
    mixed foo;	 
 /*
              i=me->query_temp("nlch_damage")/(me->query_skill("taiji-shengong",1)*5)*10;
              i=(int) i;
              if (i>=10)
                 { 
                   me->receive_wound("kee", me->query_temp("nlch_damage")/4);
                   me->receive_damage("kee", me->query_temp("nlch_damage")/2);
     	            COMBAT_D->report_status(me);
                   me->start_busy(1+random(2));
                   me->delete_temp("nlch");
                   me->delete_temp("nlch_damage");

                   return HIR"$n吸纳的内劲超过了自身的极限，丹田再也负荷不住，全身内力狂泻而出。\n"NOR;
                  }
*/
     	        if (!vweapon=victim->query_temp("weapon")) 
          	result = HIY"$n不闪不避，$N心头泛起一丝怪异至极的感觉，拳头正中$n，却犹如击中棉絮，内劲如石沉大海，没半分威力！\n"NOR;
          	else result =HIY"$n不闪不避，$N心头泛起一丝怪异至极的感觉，"+vweapon->name()+HIY"犹如击中棉絮,内劲如石沉大海，没半分威力！！\n"NOR;
          	
          	me_force = COMBAT_D->skill_power(me, "force", SKILL_USAGE_ATTACK); if( me_force < 1) me_force = 1;
                v_dodge  = COMBAT_D->skill_power(victim, "dodge", SKILL_USAGE_DEFENSE); if( v_dodge < 1) v_dodge = 1;
                
                damage = victim->query_temp("apply/damage");
                wounded = 0;
                if( action["damage"] )  damage += action["damage"] * damage / 100;
                damage_bonus = victim->query_str();
                if( victim->query("force_factor") && (victim->query("force") > victim->query("force_factor")) )   
                     {damage_bonus += victim->query("force_factor");
                      victim->add("force",-victim->query("force_factor"));
                     }
                damage += (damage_bonus + random(damage_bonus))/2;
                defense_factor = victim->query("combat_exp");
			while( random(defense_factor) > me->query("combat_exp") ) 
			{damage -= damage / 3;}
                damage-=me->query_temp("apply/armor");
               if (damage<0) damage=0;
              me->add_temp("nlch_damage",damage);
              tell_object(me,HIB"你将"+HIR+victim->query("name")+HIB"内劲尽纳丹田，由太极内劲引导，于经脉中缓缓运行。\n"NOR);
              full=me->query_skill("taiji-shengong",1)*5;
              rate1=(int) (me->query_temp("nlch_damage")*10/full);
              rate2=(int) (me->query_temp("nlch_damage")*100/full)-rate1*10;
              tell_object(me,HIB"你已吸纳了自身内劲容纳量的"+HIG+chinese_number(rate1)+"成"+chinese_number(rate2)+HIB"!\n"NOR);   

              if (rate1>=12)
                 { 
                   me->receive_wound("kee", me->query_temp("nlch_damage")/4);
                   me->receive_damage("kee", me->query_temp("nlch_damage")/2);
     	            COMBAT_D->report_status(me);
                   me->add("force",-me->query("max_force")/2);
                   if (me->query("force")<0) me->set("force",0);
                   me->start_busy(1+random(2));
                   me->delete_temp("nlch");
                   me->delete_temp("nlch_damage");

                   result= HIR"$n吸纳的内劲超过了自身的极限，丹田再也负荷不住，全身内力狂泻而出。\n"NOR;
                  }
       
	     	return result;
       
}


