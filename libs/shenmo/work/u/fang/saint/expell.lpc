"$N使出"+BLINK""+HIM"「邪眼冥封杀」"NOR+"，双目一闭，额头上出现又一只"+BLINK""+HIC"眼睛"NOR+"！\n$n正在奇怪，那"+BLINK""+HIC"眼睛"NOR+"一张，一股诡异的力量放射出来",
"$N头上的邪眼张开，浑身燃起"+BLINK""+HIC"黑色的火焰"NOR+"，\n同时手上也燃起同样的"+BLINK""+HIC"烈焰"NOR+"。\n身形朝着$n电射过来。$N连续向$n攻出了数\n拳，这正是\n传说中妖剑术的最大秘密"+BLINK""+HIR"「奥义·冥狱炎杀剑」"NOR+"！",
"$N运力向$n连续挥剑，无数的"+BLINK""+HIC"剑光"NOR+"带着锐利的剑气像一张大网一样罩向$n全身要害！",
});

string *baseskill = ({"unarmed", "sword","blade","stick","qin","staff","throwing","force","parry","dodge","spells",
"whip" ,"needle" , "spear", "axe", "mace","fork","rake","archery","hammer", "literate",});



int check_player()
{
	    mapping mp;
		int i=0;
        object me=this_player();

        mp = me->query("expell_menpai");
        if( mapp(mp) ) i=sizeof(mp);
									
        if(me->query("combat_exp") < 900000000+200000000*i )
        {
                command("say 你的经验不足"+chinese_number(9+i*2)+"亿，不能出师");
                return 1;
        }
        if(me->query("daoxing") < 900000000+200000000*i )
        {
                command("say 你的道行不足"+chinese_number(9+i*2)+"百万年，不能出师");
                return 1;
        }
        if( me->query("level") < 1500+i*200 )
        {
                command("say 你的等级不足"+chinese_number(1500+i*200)+"，不能出师");
                return 1;
        }
        if( me->query("c_potential") < 10000000*(1+i) )
        {
                command("say 你的潜能不足"+chinese_number(1+i)+"千万，不能出师");
                return 1;
        }
        if( me->query("c_balance_credit") < 2+i*200 )
        {
                command("say 你的存款不足"+chinese_number(2+i*200)+"个点，不能出师");
                return 1;
        }

}

string ask_expell()
{
        object me;
        object ob;
        string fm_str="";
        string *mp;
        int cnt;

        ob = this_player();
        me = this_object();
        me->delete_temp("expell_family");
        me->delete_temp("expell_ob");
        if( !wizardp(ob) && check_player() )
                return ("继续努力吧，假如时日，汝必成王\n");
        if ( "无性" == ob->query("gender") || ob->query("family/family_name") == "神策军" )
        {
            return("你是公公，出师对你没有用!\n");
        }
/*
        if( mapp(ob->query("expell_menpai")) )//目前是这样设计的
                return ("你一生只能出师一次！\n");
*/
        if( is_fighting() )
                return ("我正忙着呢，现在不处理出师的事情！\n");
        ob->delete_temp("confirm_ok");
        if( ob->query("class") == "saint" ||ob->query("class") == "shen")
        {
                mp = keys(mpsk);
                for( cnt = 0; cnt < sizeof(mp); cnt++)
                {
                        if( cnt%5 == 0 )
                                fm_str = fm_str +"\n";
                        fm_str = fm_str + mp[cnt]+"\t";
                        
                }
            write("你可以选择的门派:"+HIW+fm_str+NOR);
                write(HIY"\n请输入:confirm 门派名称\n"NOR);
                write(HIY"比如:confirm 方寸山三星洞\n"NOR);
                write(HIY"你那么聪明，一定不要出错呀\n"NOR);
                me->set_temp("expell_ob",ob);
                command("say 好吧，死了千万不要后悔!");
                command("sigh");
                command("say 输入confirm 门派名称就可以了！");
                return ("赶快选择吧！\n");
        }
        else
                return ("你现在还不能进行出师！\n");

}

int expell_confirm(string arg)
{
        object me,ob;
        string *mp;
        me = this_object();
        ob = this_player();
        if( ob != me->query_temp("expell_ob") || (ob->query("class")!= "saint" && ob->query("class")!= "shen") || !arg)
        {
                ob->set("sen",-1);
                ob->set("kee",-1);
                tell_object(ob,HIR"看起来"+me->query("name")+"想杀死你！"NOR);
                return notify_fail("世事无常,一切随缘!\n");
        }
        if( stringp(arg) && !ob->query_temp("confirm_ok") )
        {

                mp =keys(mpsk);
                if( member_array(arg,mp) != -1 && ob->query("expell_menpai/"+arg)==0 )
                {
                        me->set_temp("expell_family",arg);
                        me->set("max_kee",ob->query("max_kee")*3);
                        me->set("max_sen",ob->query("max_sen")*3);
                        me->set("max_force",ob->query("max_force")*3);
                        me->set("max_mana",ob->query("max_mana")*3);
                        me->set("combat_exp",ob->query("combat_exp"));
                        me->set("daoxing",ob->query("daoxing"));
                        me->set_temp("apply/armor",ob->query_temp("apply/armor"));
                        me->set_temp("apply/damage",ob->query_temp("apply/damage"));
                        me->copy_status(ob);
            ob->set_temp("confirm_ok",1);
                        ob->kill_ob(this_object());
                        kill_ob(ob);
                        return 1;
                }
                else
                {
                        ob->set("sen",-1);
                        ob->set("kee",-1);
                        tell_object(ob,HIR"看起来"+me->query("name")+"想杀死你！"NOR);
                        return notify_fail("世事无常,一切随缘!\n");

                }
        }
        return notify_fail("请按照要求正确输入！\n");
}

void copy_status(object me, int level)
{
            mapping me_skill;
        string *skills;
                string fm_str;
        int *skill_value, max_value, i,j;
        
        me_skill = me->query_skills();
        i=sizeof(me_skill);
        if(i>0) {
                skill_value=values(me_skill);
                max_value=skill_value[0];
                while(i--) { // 找出玩家skill最大值
                    if(skill_value[i]>max_value)
                        max_value=skill_value[i];
                }
          } else max_value=300;

                if( max_value < 1000 )
                        max_value = 1000;
                fm_str = query_temp("expell_family");
                create_family(fm_str,2,"判师大师");
                switch(family[fm_str]) {
                case 1:
                        set("class","human");
                        break;
                case 0:
                        set("class","xian");
                        break;
                case -1:
                        set("class","yao");
            break;
                default:
                        set("class","saint");
                        break;
                }
                skills = mpsk[fm_str];
                for( j =0; j <sizeof(skills);j++)
                {
                        set_skill(skills[j],max_value+random(200));
                }

                enable_skill = ({});
                //write(sprintf("enable_skill:%d\n",sizeof(enable_skill)));
        for( i =0; i < sizeof(baseskill);i++)
                {
                        set_skill(baseskill[i],max_value+random(200));//设定基本的功夫
                        
                    for( j=0; j < sizeof(skills);j++)
                        {
                                if( SKILL_D(skills[j])->valid_enable(baseskill[i]) )
                                        {       map_skill(baseskill[i], skills[j]);
                                        if( baseskill[i] != "dodge" &&
                                                        baseskill[i] != "literate" &&
                                                        baseskill[i] != "spells" &&
                                                        baseskill[i] != "parry" &&
                                                        baseskill[i] != "force" &&
                                                        baseskill[i] != "needle" )
                                                        enable_skill += ({baseskill[i]});
                                            reset_action();
                                        }
                        }
                }
    
            
}         

void unconcious()
{
  die();
}

void die()
{
        object me,ob;
        string fm_str;
        mapping mp;
        string *skills;
        string *mpstr;
        int cnt1;
        int cnt;
        me = this_object();
        ob = me->query_temp("last_damage_from");
        if( ob != me->query_temp("expell_ob") || !objectp(ob)|| ob->query_temp("confirm_ok")!=1 )
        {
                me->remove_all_killer();
                me->delete_temp("expell_family");
                me->delete_temp("expell_ob");
                full_ob(me);
                return;

        }
        else
        {
                //如果，是ask得人杀了master
                if( objectp(ob) )
                {
                        if( (random(150) == 147 && ob->query("c_potential")>=10000000 && ob->query("c_balance_credit") >= 2)  || wizardp(ob))
                        {
                                //set_heart_beat(0);
                                me->remove_all_killer();
                                ob->remove_all_killer();
/* 20130616 fang
                                mp = ob->query("expell_menpai");
                                if( mapp(mp) )
                                {
                                   mpstr = keys(mp);
                                   for( cnt = 0; cnt < sizeof(mpstr); cnt++ )
                                   {
                                         skills = mpsk[mpstr[cnt]];
                                         for( cnt1 = 0; cnt1 < sizeof(skills); cnt1++)
                                         {
                                         ob->add("samsara/"+skills[cnt1],-2);
                                            if( ob->query("samsara/"+skills[cnt1]) != 1 )
                                            {
                                              ob->delete("samsara/"+skills[cnt1]);
                                              ob->delete_skill(skills[cnt1]);
                                            }
                                         }
                                   }
                                }
                                ob->delete("expell_menpai");
for new expell */
                                fm_str = me->query_temp("expell_family");
                         
                                skills = mpsk[fm_str];
                                for( cnt = 0; cnt < sizeof(skills); cnt++ )
                                {
                                        ob->add("samsara/"+skills[cnt],2);
                                        if( ob->query("samsara/"+skills[cnt]) == 2 )
                                        ob->set_skill(skills[cnt],100);
                                }
                                ob->delete("samsara_1");
                                ob->delete("samsara_2");
                                ob->delete("samsara_3");
                                ob->delete_temp("confirm_ok");
				mp = ob->query("expell_menpai");
				if( mapp(mp) ) cnt = sizeof(mp);
                                else cnt = 0;
                                ob->set("expell_menpai/"+fm_str,1);
                                ob->set("expelled_menpai/"+fm_str,1);
                                ob->add("combat_exp",-100000000*(1+2*cnt));
                                ob->add("daoxing",-100000000*(1+2*cnt));
                                ob->add("c_potential",-10000000*(1+cnt));
                                ob->add("c_balance_credit",-(2+cnt*200));
                                ob->add("level",-cnt*200);
/*
                                if( !wizardp(ob) )
                                {
                                        ob->set("combat_exp",4000000);
                                        ob->set("daoxing",4000000);
                                }
*/
                                
                                me->delete_temp("expell_family");
                                me->delete_temp("expell_ob");
                                message("chat",sprintf(HIY"\n【轮回转世】:%s从门派"+BLINK+HIG"【%s】"NOR+HIY+"出师成功,可以使用"+BLINK+HIG"【%s】"NOR+HIY+"的所有武功绝招。\n"NOR,ob->query("name"),fm_str,fm_str),users());
                                CHANNEL_D->do_channel( me, "chat",sprintf(HIY"%s从门派"+BLINK+HIG"【%s】"NOR+HIY+"出师成功,可以使用"+BLINK+HIG"【%s】"NOR+HIY+"的所有武功绝招。"NOR,ob->query("name"),fm_str,fm_str));
                                CHANNEL_D->do_channel( me, "rumor",sprintf("%s从门派"+BLINK+HIG"【%s】"NOR+HIM+"出师成功"NOR+HIM",可以使用"+BLINK+HIG"【%s】"NOR+HIM+"的所有武功绝招。"NOR,ob->query("name"),fm_str,fm_str));
                                //加入消息
                                log_file("static/expellmaster",
                        sprintf("%s(%s) 出师门派:( %s ) 出师时间 %s\n",
                                ob->name(1), geteuid(ob), fm_str,ctime(time()) ) );
                                ob->save();
                                full_ob(me);
                                return;
                        }
                         else
                                 full_ob(me);
                }else
                        full_ob(me);

        }
}

void heart_beat()
{
string str,skill,*wpty;
object weapon;
int i,j;
object ob;
object me = this_object();
ob = me->query_temp("expell_ob");
::heart_beat();

if ( query("eff_kee") < query("max_kee") &&  random(10)==1 )
        SDS_D->addEffKee(me);
if ( query("kee") < query("eff_kee") )
        SDS_D->addKee(me);
if ( query("sen") < query("eff_sen") )
        SDS_D->addSen(me);
if ( query("eff_sen") < query("max_sen") &&  random(10)==1 )
        SDS_D->addEffSen(me);
if ( !is_fighting() || !objectp(ob))
        return;
if( random(8) == 1 )
     full_ob(me);
weapon=query_temp("weapon");
if ( !objectp(weapon) )
{
     weapon=new("/d/obj/weapon/sword/changjian");
     weapon->move(this_object());
     weapon->wield();
}

if ( objectp(weapon) )
{
        wpty = enable_skill;
        if( sizeof(wpty) )
        {
                str = wpty[random(sizeof(wpty))];
                weapon->set("apply/skill_type",str);
                weapon->set("zizhi",1);
                weapon->set("skill_type",str);
//.                if( wizardp(ob) )
//                tell_object(ob,"weapontype："+str);
        }

        skill = weapon->query("skill_type");

}
else    skill = "unarmed";
wpty = mpsk[query_temp("expell_family")];
for( i =0; i < sizeof(baseskill);i++)
  for( j=0; j < sizeof(wpty);j++)
   if( SKILL_D(wpty[j])->valid_enable(baseskill[i]) && query_skill_mapped(baseskill[i])!= wpty[j] ) {map_skill(baseskill[i], wpty[j]);reset_action();}

if( random(4) == 1 )
SDS_D->randomPfm(me,skill);
if( random(4) == 1 )
SDS_D->randomCast(me);
if( random(4) == 1 )
SDS_D->randomExert(me);
if( random(10) == 1 )
{       
        str = action[random(sizeof(action))];
        message_vision(str,me,ob,me->query_temp("weapon"));
        ob->set_temp("last_damage_from",me);
        ob->receive_damage("kee",300+random(500),me);
        COMBAT_D->report_status(ob);
        if( random(3) == 1 )
        {
                ob->receive_wound("kee",300+random(500),me);
                COMBAT_D->report_status(ob);
        }
}
if( random(10) == 1 )
{       
        str = action[random(sizeof(action))];
        message_vision(str,me,ob,me->query_temp("weapon"));
        ob->set_temp("last_damage_from",me);
        ob->receive_damage("sen",300+random(500),me);
        COMBAT_D->report_status(ob);
        if( random(3) == 1 )
        {
                ob->receive_wound("sen",300+random(500),me);
                COMBAT_D->report_status(ob);
        }
}

if( random(1000) == 1 )
{  
        message_vision(BLU"我不入地狱，你下地狱\n"NOR,me,ob);
        ob->set("kee",-1);
        ob->set("sen",-1);
        COMBAT_D->report_status(ob);

} 

}

void kill_ob(object ob)
{
  object me = this_object();
  if( ob != me->query_temp("expell_ob") )
  {
          message_vision("你不是请求我帮助出师的人，我不奉陪！\n",me);
  ob->move("/d/city/misc/idleroom");
  ob->unconcious();
          return;
  }
  full_ob(me);
  ::kill_ob(ob);
}

void full_ob(object me)
{
        string *wizname=({"snowtu","fang","run","tom","wuxin","windy",});
            if( !objectp(me) )
                {
                        me = this_object();
                }
                
message_vision(BLU+"我不入地狱，谁入地狱？"+HIY+wizname[random(sizeof(wizname))]+NOR+BLU" 赐予我力量吧！\n"+NOR,me);
            //me->command("say 佛曰：我不入地狱，谁入地狱？");
        me->set("kee",query("max_kee"));
        me->set("eff_kee",query("max_kee"));
        me->set("sen",query("max_sen"));
        me->set("eff_sen",query("max_sen"));
        me->set("force",query("max_force")*2);
        me->set("mana",query("max_mana")*2);
                me->set("force_factor",750);
                me->set("mana_factor",750);
                me->delete_temp("no_move");
        me->clean_condition();
        return;
}
void attempt_apprentice(object ob) 
{ 
           command("smile"); 
           command("say 你神功盖世，指点我还差不多！\n"); 
           return;
} 

