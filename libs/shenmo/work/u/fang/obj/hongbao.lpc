// hong bao fang@2013
#include <ansi.h>

#define DRUGPATH "/d/wizz/fangz/drug/"
string MARK = "spring_2014";

inherit ITEM;
mapping attribute = ([
  "str": ({ "shenliwan", "膂力", }),
  "int": ({ "xiandan", "悟性", }),
  "cor": ({ "cordan", "胆识", }),
  "cps": ({ "cpsdan", "定力", }),
  "kar": ({ "kardan", "福缘", }),
  "per": ({ "perdan", "美容", }),
  "spi": ({ "spidan", "灵性", }),
  "con": ({ "xisuidan", "根骨", }),
]);


string *msg2 = ({
  "暗黑破坏神(Diablo)",
  "方舟(Fang)",
  "乱(Run)",
  "狐媚(Shulele)",
  "眠兔(Snowtu)",
  "舒乐乐(Sulele)",
  "风无影(Windy)",
  "开心汤姆(Tom)",
  "无心(wuxin)",
});


void init() {
  add_action("do_open", "open");
}

void create() {
  set_name(HIR "红包" NOR, ({ "hong bao", "bao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "份");
    set("unit", "份");
    set("long", HIR "\t这是春节TSRJ巫师组送给大家的红包。\n" NOR +
      HIR "\t★﹊﹊﹊｜﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊★\n" NOR +
      HIR "\t︴　　　｜　　　　　　°　　　　　　﹃　　　︴\n" NOR +
      HIR "\t︴　　　｜　　°　　　　　　　　　　玩　　　︴\n" NOR +
      HIR "\t︴　╭╯﹊╰╮　　　　　　°　　　　游　　　︴\n" NOR +
      HIR "\t︴　‖幸　   福‖　　°　　　　　　　　戏　　　︴\n" NOR +
      HIR "\t︴　‖风　   铃‖　　　　　　　﹃°　　万　　　︴\n" NOR +
      HIR "\t︴　╚－╩－╝　　　　°　　挖　　　事　　　︴\n" NOR +
      HIR "\t︴　╚－╩－╝°　　　　　　泥　　　顺　　　︴\n" NOR +
      HIR "\t︴　　　｜　　　　　　　　°巴　　　﹄　　　︴\n" NOR +
      HIR "\t︴　　　｜　　　　°　　　　乐　　　　　　　︴\n" NOR +
      HIR "\t︴　　　╰☆°　　　　　　　逍　　　　　　　︴\n" NOR +
      HIR "\t︴　　　°∵☆　　　　　　　遥　　　　　　　︴\n" NOR +
      HIR "\t︴　　　☆°∴　　　　　　　﹄　　　　　　　︴\n" NOR +
      HIR "\t★＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿★\n" NOR +
      HIR "\t打开(open)它看看吧\n" NOR
    );
    set("value", 0);
    set("no_sell", 1);
    set("no_put", 1);
  }
  setup();
}

int do_open(string arg) {
  object me;
  object obj;
  string *cs;
  string msg;
  int i;
  me = this_player();
  if (!id(arg))
    return notify_fail("你要打开什么？\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢\n");
  if (me->query("gift/" + MARK)) {
    me->delete_temp("last_damage_from");
    me->set_temp("death_msg", "被红包砸死了。\n");
    me->move(VOID_OB);
    me->die();
    destruct(this_object());
    return 1;
  }
  if (me->query("level") < 100 && me->query("age") < 16) { destruct(this_object()); return 1; }
  message(
    "chat",
    HIW + "【" NOR + HIR "贺新春" NOR + HIW "】" NOR + HIC + msg2[random(sizeof(msg2))] + ": " NOR + HIY + me->query("name") + "泥潭耕作，获得大大的红包一份\n",
    users()
  );
  me->set("2013_chunjie", 1);
  me->add("combat_exp", 400000);
  tell_object(me, HIG "你获得武学40万\n" NOR);
  me->add("daoxing", 400000);
  tell_object(me, HIY "你获得道行40万\n" NOR);
  me->add("haomao", 3);
  tell_object(me, HIY "你获得毫毛3根\n" NOR);
  me->add("potential", 100000);
  tell_object(me, HIY "你获得潜能10万\n" NOR);
  me->save();
  cs = keys(attribute);
  for (i = 0; i < sizeof(cs); i++) {
    obj = new(DRUGPATH + attribute[cs[i]][0]);
    if (!obj->move(me)) {
      destruct(obj);
      write("你身上的物品太多了!\n");
      break;
    }
    tell_object(me, HIW "你在红包里发现" + obj->query("name") + "\n");

  }
  tell_object(me, HIY "你高兴的打开红包\n" NOR);
  message_vision(HIR "$N把红包轻轻的打开，恭喜发财！！恭喜发财！！！\n" NOR, me);
  destruct(this_object());
  return 1;
}
