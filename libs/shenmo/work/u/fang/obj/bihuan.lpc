// by yhq

#include <armor.h>
#include <ansi.h>
#include "/cmds/std/valid_move.h"
inherit ITEM;

void create()
{
   set_name(HIY"鼻环"NOR, ({ "bi huan" }) );
   set_weight(1000);
   if( clonep() )
   set_default_object(__FILE__);
   else {
     set("unit", "只");
      set("no_sell",1);
 //   set("no_give",1);
      set("no_drop",1);
     set("no_get",1);
      set("no_break",1);
       set("value",10);
     set("material", "diamon");
      set("armor_prop/armor",100);
  }
   setup();
}
void init()
{
object me,where,who;
me = this_object();
who = this_player();
where = environment();

if( userp(where) )
   {
     if ( me->query("owned") )
      {
         if (me->query("owned")!=where->query("id"))
            call_out("destruct_me",1,where,me);
      }
     else
        me->set("owned",where->query("id"));
   }
   add_action("do_move", "chuansuo");
   
}


int do_move()
{
    object ridee,me=this_player(); 

              if ((time()-me->query("last_move"))<100) 
                      return notify_fail("月光宝盒的法力已经用完,过一阵才能发挥作用。 \n"); 
if ( !wizardp(me) && environment(me)->query("hs_world") )
        return notify_fail("在魔幻世界，你的灵力还难以驾御风云。\n");

  if(me->is_fighting())
     return notify_fail("打架中你也能运用自如？\n");
if ( !valid_move(me) )
     return notify_fail("你现在正忙着呢！\n");
ridee = me->ride(); 
if ( ridee ) 
        { 
        if ( ridee->is_busy() ) 
                return notify_fail("你的坐骑现在动弹不得。\n"); 
        } 
if ( ridee ) 
        { 
        if ( !ridee->move("/d/dntg/donghai/mazeend") )        
                return notify_fail("你的坐骑现在动弹不得。\n"); 
        } 

         tell_room(environment(me),HIM+me->query("name")+"对着鼻环念道："
                        "「带我去我想要去的地方吧，阿门！」\n"
                        NOR,me);
 
       tell_object(me,HIM"你双眼微闭，对着鼻环念道："
                        "「带我去我想要去的地方吧，阿门！」\n"
                        "你的身影已经消失在无边无际之中.\n"NOR);
       if( me->query("kill_enter_time")+432000 > time() )
         me->move("/d/shashou/shashou");
       else
       me->move("/d/dntg/donghai/mazeend"); 
                message_vision(HIW"$N的身影突然出现在一阵烟雾之中。\n"NOR, me);

       return 1;
}

int query_autoload() { return 1; } 

void destruct_me(object where, object me)
{
  message_vision(HIY"青衣大神走过来说：还我$n，$n"+HIY"化作五色碎片！\n"NOR,where,me);
 if( me ) destruct (me);
}
