//liwu 
#include <ansi.h>
inherit ITEM;
string MARK = "spring_2014";
void setup() {}
void init() {
  add_action("do_eat", "open");
}
string *attrib = ({ "str", "cor", "int", "spi", "cps", "per", "con", "kar", });
void create() {


  set_name(HIR "红包" NOR, ({ "hong bao", "hongbao" }));

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "西游记--神魔传说巫师组给大家的春节礼物，快打开(open)吧~!\n");
  }
  setup();
}

int do_eat(string arg) {
  int i;
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要开什么？\n");

  if (me->query("giftmark/" + MARK)) {
    me->move(VOID_OB);
    destruct(this_object());
    me->set_temp("death_msg", "被" + name() + "砸死了。\n");
    me->die();
    me->save();
    return 1;
  }

  me->add("combat_exp", 50000 + random(100000));
  tell_object(me, "你的经验增加了!\n" NOR);
  me->add("potential", 30000 + random(30000));
  tell_object(me, "你的潜能增加了!\n" NOR);
  me->add("daoxing", 50000 + random(100000));
  tell_object(me, "你的道行增加了!\n" NOR);
  me->add("haomao", 3);
  tell_object(me, HIY "你获得毫毛3根\n" NOR);

  i = random(sizeof(attrib));
  me->add(attrib[i], 1);
  tell_object(me, HIG "你的" + HIY + attrib[i] + HIG + "增加一点\n" NOR);

  if (me->query("level") > 100) {
    me->add("c_balance_credit", 1);
    tell_object(me, HIY "你获得一个信用点\n" NOR);
    message(
      "chat",
      HIY "西游记--神魔传说巫师组，送给" + BLINK + HIG + me->name(1) + NOR + HIY "金币100枚！\n" NOR,
      users()
    );
  }
  message(
    "chat",
    HIY "西游记--神魔传说巫师组及全体玩家祝" + BLINK + HIG + me->name(1) + NOR + HIY "春节快乐！\n" NOR,
    users()
  );
  me->set("giftmark/" + MARK, 1);

  call_out("des", 1);
  //destruct(this_object());
  me->save();
  return 1;
}
void des() {
  destruct(this_object());
}
