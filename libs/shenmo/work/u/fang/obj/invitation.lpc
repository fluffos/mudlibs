// invitation fang@20070501
#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_open", "open");
}

void create() {
  set_name(HIW "结婚请柬" NOR, ({ "qing jian", "invitation", "jian" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "份");
    set("unit", "份");
    set("long", HIW "这是" NOR + HIY "无暇" NOR + HIW "同" NOR + HIM "小妖儿" NOR + HIW "结婚请柬。\n打开(open)它看看吧\n" NOR +
      HIR "\t .*.    /~ .~\\    /~  ~\\    /~ .~\\    /~  ~\\ \n" NOR +
      HIR "\t ***   '      `\\/'      *  '      `\\/'      * \n" NOR +
      HIR "\t  V   (                .*)(               . *) \n" NOR +
      HIR "\t/\\|/\\  \\            . *./  \\            . *./ \n" NOR +
      HIR "\t  |     `\\ .      . .*/'    `\\ .      . .*/' \n" NOR +
      HIR "\t  |       `\\ * .*. */'        `\\ * .*. */' \n" NOR +
      HIR "\t            `\\ * */'            `\\ * */' \n" NOR +
      HIR "\t              `\\/'                `\\/' \n" NOR +
      HIR "\t                             \n" NOR
    );
    set("value", 0);
    set("no_sell", 1);
    set("no_put", 1);
  }
  setup();
}

int do_open(string arg) {
  object me;

  string msg;
  me = this_player();
  if (!id(arg))
    return notify_fail("你要打开什么？\n");
  msg = HIC "\n\t西游记--神魔传说巫师组感谢大家对于我们的支持\n" NOR;
  msg += HIC "\t这个样子的你们，就是对我们最好的鼓励\n" NOR + HIG "\t   _----_          ________ \n" +
    "\t|\\/      \\/ ______|     |80| \n" +
    "\t\\|    . . || |\\\\\\\\\\     |8*| \n" +
    "\t (   ( oo))| | ------   |＝| \n" +
    "\t  /  \\    \\| |   ||||   |＝| \n" +
    "\t\\(___\\^^^^^|_|___||||   |＝| \n" +
    "\t            ===|||===___|＝|\n\n";
  msg += BLINK + HIY "\t\t祝大家五一节快乐\n\n\n" NOR;

  msg += HIR "\t祝愿无暇同小妖儿新婚快乐，永远开心快乐......\n" NOR;
  msg += BLINK + HIG "\t* *" NOR + HIB "╰●" NOR + "    " HIB "●" NOR + HIR " * \n" NOR + BLINK + HIW "\t *" NOR + HIC "╱*" HIM "▉" NOR + HIC "*∨*" HIY "█" NOR + HIC "*╯*" NOR + BLINK + HIM "执" + HIW "子" + HIY "之" + HIW "手，" + HIM "与" + HIW "子" + HIY "偕" + HIW "老. \n" NOR + BLINK + HIY "\t  * " NOR + HIW "∕|    ||" NOR + BLINK + HIY " *  * \n" NOR;

  message_vision(msg, me);
  if (me->query("2007_51_gift")) {
    destruct(this_object());
    return 1;
  }
  if (me->query("level") < 100 && me->query("age") < 16) { destruct(this_object()); return 1; }
  me->set("2007_51_gift", 1);
  message(
    "chat",
    HIW + "【" NOR + HIR "喜福会" NOR + HIW "】" NOR + HIY "无暇" + HIW "和" + HIM "小妖儿" NOR + HIC "请" + me->name() + "喝喜酒\n",
    users()
  );
  me->add("combat_exp", 400000);
  tell_object(me, HIG "你喝了一口喜酒，发现武学增加40万\n" NOR);
  message(
    "chat",
    HIW + "【" NOR + HIR "喜福会" NOR + HIW "】" NOR + HIY "无暇" + HIW "和" + HIM "小妖儿" NOR + HIC "请" + me->name() + "抽喜烟\n",
    users()
  );
  me->add("daoxing", 400000);
  tell_object(me, HIY "你抽了一口烟，咳咳。。。，发现道行增加40万\n" NOR);
  message(
    "chat",
    HIW + "【" NOR + HIR "喜福会" NOR + HIW "】" NOR + HIY "无暇" + HIW "和" + HIM "小妖儿" NOR + HIC "请" + me->name() + "吃喜糖\n",
    users()
  );
  me->add("c_potential", 400000);
  tell_object(me, HIR "你吃了一块喜糖，发现在货币卡里，你增加40万的潜能\n" NOR);
  message(
    "chat",
    HIW + "【" NOR + HIR "喜福会" NOR + HIW "】" NOR + HIY "无暇" + HIW "和" + HIM "小妖儿" NOR + HIC "给" + me->name() + "一个大大的红包\n",
    users()
  );
  me->add("c_balance", 40000000);
  tell_object(me, HIY "你高兴的打开红包\n发现在货币卡里，你增加4个金币\n" NOR);


  message_vision(HIR "\t祝他们永结同心，共为连理\n" NOR +
    BLINK + HIR "\t     ******       ****** \n" NOR +
    BLINK + HIR "\t   **********   ********** \n" NOR +
    BLINK + HIR "\t ************* ************* \n" NOR +
    BLINK + HIR "\t***************************** \n" NOR +
    BLINK + HIR "\t***************************** \n" NOR +
    BLINK + HIR "\t***************************** \n" NOR +
    BLINK + HIR "\t*************************** \n" NOR +
    BLINK + HIR "\t  *********************** \n" NOR +
    BLINK + HIR "\t     ******************* \n" NOR +
    BLINK + HIR "\t       *************** \n" NOR +
    BLINK + HIR "\t         *********** \n" NOR +
    BLINK + HIR "\t           ******* \n" NOR +
    BLINK + HIR "\t             *** \n" NOR +
    BLINK + HIR "\t              * \n" NOR, me);
  destruct(this_object());
  return 1;
}
