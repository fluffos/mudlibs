#include <ansi.h>

inherit ITEM;

int do_bridge(string);
string *attrib = ({ "str", "cor", "int", "spi", "cps", "per", "con", "kar", });

void create() {
  set_name(HIC "喜鹊" NOR, ({ "xi que", "xique" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIC "牛郎织女鹊桥会所用之物,你可以用(bridge)帮助他们。\n比如bridge niu lang or bridge zhi nu" NOR);
    set("value", 500000);
    set("no_sell", 1);
  }

  setup();
}

void init() {
  add_action("do_bridge", "bridge");
}


int do_bridge(string arg) {
  object ob;
  int i;
  object me = this_player();
  string msg;
  if (!arg)
    return notify_fail("你要帮助谁？\n");
  if (me->query("gender") == "女性" && arg != "zhi nu")
    return notify_fail(HIW "这里没有织女，喜鹊不知道该干什么？\n请找到织女，bridge zhi nu\n" NOR);
  if (me->query("gender") == "男性" && arg != "niu lang")
    return notify_fail(HIW "这里没有牛郎，喜鹊不知道该干什么？\n请找到牛郎，bridge niu lang\n" NOR);
  ob = present(arg, environment(me));
  if (wizardp(me)) write(arg + "\n");
  if (!objectp(ob) || !(ob->id(arg))) return notify_fail(HIG "没有" + arg + "，喜鹊不知道该干什么？\n" NOR);
  if (me->query("2011_qixi")) {
    tell_object(me, HIW "你的喜鹊与其他的喜鹊一并搭起鹊桥，牛郎织女之间的距离拉进了\n" NOR);
    destruct(this_object());
    return 1;
  }


  message_vision(
    HIC "$N拿起一只喜鹊，默默念道：\n迢迢牵牛郎，皎皎织布女;\n盈盈一水间，脉脉不得语;\n念发慈悲意,助其搭鹊桥。\n念吧，喜鹊向天河飞去。。。\n" NOR,
    me
  );

  me->add_temp("qixi_xique", 1 + random(3));
  tell_object(me, HIW "你的喜鹊与其他的喜鹊一并搭起鹊桥，牛郎织女之间的距离拉进了\n" NOR);
  if (me->query_temp("qixi_xique") > 27) {

    tell_object(me, HIY "因为你的不懈努力，牛郎与织女终于走到了鹊桥的中央\n" NOR);
    message(
      "chat",
      HIY + "【七夕传说】" + ob->name() + "(" + ob->query("id") + "):" + HIW + me->name() + HIC "助吾鹊桥会，功德无量！\n" NOR,
      users()
    );
    me->add("combat_exp", 50000 + random(100000));
    tell_object(me, "你的经验增加了!\n" NOR);
    me->add("potential", 30000 + random(30000));
    tell_object(me, "你的潜能增加了!\n" NOR);
    me->add("daoxing", 50000 + random(100000));
    tell_object(me, "你的道行增加了!\n" NOR);
    i = random(sizeof(attrib));
    me->set("env/no_msg", 0);
    me->add(attrib[i], 1);
    me->set("env/no_msg", 1);

    message(
      "chat",
      HIY "西游记--神魔传说巫师组及全体玩家祝" + BLINK + HIG + me->name(1) + NOR + HIY "七夕节快乐！\n" NOR,
      users()
    );
    me->set("2011_qixi", 1);
    me->save();
  }

  destruct(this_object());
  return 1;
}
