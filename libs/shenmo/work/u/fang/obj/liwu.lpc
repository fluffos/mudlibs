#include <ansi.h>

inherit ITEM;

int do_eat(string);

void create() {
  set_name(HIC "棒棒" + HIY "糖" NOR, ({ "bang bang tang", "tang" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIY "小孩子最爱吃的棒棒糖。据说有特殊功效。\n" + BLINK "西游记--神魔传说 巫师组们送给你的礼物。\n" NOR);
    set("value", 0);
    set("value", 0);
    set("no_sell", 1);
    set("no_get", 1);
    set("no_put", 1);
  }

  setup();
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me = this_player();
  string msg;
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (me->query("liwu_61") > 1) {
    destruct(this_object());
    return notify_fail("吃！吃！你不怕撑死？\n");
  }
  if (me->query("combat_exp") > 600000)
    me->add("balance", 2000000);
  me->add("daoxing", 100000);
  me->add("force", 200);
  me->add("max_mana", 200);
  me->add("max_force", 200);
  me->add("mana", 200);
  me->add("maximum_force", 200);
  me->add("maximum_mana", 200);
  me->add("potential", 20000);
  me->set("liwu_61", 2);
  if (me->query("age") > 24) {
    me->add("mud_age", -500000);
    message_vision("$N对着$n说道，恭喜你又变成小孩了!\n", this_object(), me);
  }
  message_vision(HIC "$N觉得身体发生剧烈的变化，当年快乐时光又在眼前浮现。\n" NOR, me);
  destruct(this_object());
  return 1;
}
