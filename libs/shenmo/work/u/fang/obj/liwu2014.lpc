//liwu 
#include <ansi.h>
inherit ITEM;
void setup()
{}
void init()
{
        add_action("do_eat", "eat");
}
string *attrib= ({"str","cor","int","spi","cps","per","con","kar",});
void create()
{
string *names = ({
  HIW"巧克力"NOR,
 HIW "大白兔奶糖"NOR,
  HIW"奶油蛋糕"NOR,
  HIG"特制玫瑰糖"NOR,
  HIC"酒心巧克力"NOR,
  HIG"画眉糖"NOR,
  YEL"火锅"NOR,
  HIB"樱桃丸子"NOR,
  HIG"棒棒糖"NOR,
  GRN"娃哈哈"NOR,
  HIC"上好佳"NOR,
  HIR"虾条"NOR,
  HIY"乐百氏"NOR,
  HIG"肯德鸡"NOR,
  GRN"长寿糕"NOR,
  HIC"长寿面"NOR,
  HIY"蓬莱寿桃"NOR,
});

  string str;
  int i = random(17)+1;
  
  set_name(names[random(sizeof(names))], ({"li wu","liwu"}));

        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "块");
              set("long", "西游记--神魔传说巫师组给大家的元旦礼物，快吃吧~!\n");
        }
        setup();
}

int do_eat(string arg)
{		
	    int i;
        object me = this_player();
        
        if (!id(arg))
        return notify_fail("你要吃什么？\n");

        if( me->query("giftmark/liwu_20140101") )
        {
          me->move(VOID_OB);
          destruct(this_object());
          me->set_temp("death_msg", "被"+name()+"噎死了。\n");
          me->die();
          me->save();
          return 1;
        }

        me->add("combat_exp",50000+random(100000) );
		tell_object(me,"你的经验增加了!\n"NOR);
        me->add("potential", 30000+random(30000));
		tell_object(me,"你的潜能增加了!\n"NOR);
        me->add("daoxing",50000+random(100000));
		tell_object(me,"你的道行增加了!\n"NOR);
        me->add("haomao",3);
        tell_object(me,HIY"你获得毫毛3根\n"NOR);

		i= random(sizeof(attrib));
		me->add(attrib[i],1);
                tell_object(me,HIG"你的"+HIY+attrib[i]+HIG+"增加一点\n"NOR);

        message("chat",HIY"西游记--神魔传说巫师组及全体玩家祝"+BLINK+HIG+me->name(1)+NOR+HIY"元旦快乐！\n"NOR,users());
        me->set("giftmark/liwu_20140101",1);
        
        call_out("des",1);
        //destruct(this_object());
        me->save();
        return 1;
}
void des()
{
        destruct(this_object());
}

