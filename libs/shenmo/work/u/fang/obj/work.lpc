
inherit ROOM;
#include <ansi.h>
//int do_edit(string arg);

void create()
{

set("short",HIY"亚特兰蒂斯"NOR);
set("long",
HIB"传说中给洪水淹没的城市亚特兰蒂斯"NOR
HIG"宏伟的建筑群，显示者这儿曾经的繁荣\n"NOR
);
set("exits",([
"kz" : "/d/city/kezhan",
"wz" : "/d/wiz/wizroom",
]));
set("objects",([
    "/d/obj/drug/renshen-guo" : 1,
     "/u/fang/obj/yao.lpc" : 1,
   "/u/fang/obj/allpass" : 1,
   "/u/fang/obj/dntg" : 1,
   "/u/fang/obj/zzh" : 1,
      "/u/fang/obj/hebing" : 4,
     "/u/fang/obj/hebingl" : 2,
     ]));
set("no_time", 1);
set("freeze", 1);
  set("no_upgrade_age",1);
set("alternative_die",1); 
setup(); 
      call_other("/obj/board/fang_b", "???"); 

}

void init()
{
add_action("do_cloth","cs");
add_action("do_del","del");
add_action("do_edit","xiugai");
}

int do_edit(string arg)
{
object who,me;
string data;
int num;

me = this_player();

if ( !wizardp(me) || me->query("id")!="fang" )
      return 0;
if ( !arg || sscanf(arg,"%s %s %d",arg,data,num)!=3 )
      return 0;
who = find_player(arg);
if ( !who || !objectp(who) )
      return 0;
who->set(data,num);
write("ok\n");
return 1;
}


int do_cloth()
{
      object who,me;
      me = this_player();
      if ( !wizardp(me) || me->query("id")!="fang" ) return 0;
      who = new("/u/fang/obj/cluth");
      who->move(me);
write("ok\n");
return 1;
}

int do_del(string arg)
{
object who,me;
string data;
int num;

me = this_player();

if ( !wizardp(me) || me->query("id")!="fang" )
      return 0;
if ( !arg || sscanf(arg,"%s %s %d",arg,data,num)!=3 )
      return 0;
who = find_player(arg);
if ( !who || !living(who) )
      return 0;
who->delete(data,num);
write("ok\n");
return 1;
}

