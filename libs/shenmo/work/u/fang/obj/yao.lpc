// jinchuang.c 金创药

#include <ansi.h>
inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIY "降妖药" NOR, ({ "xiangyao yao", "yao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "包");
    set("unit", "些");
    set("long", "这是一包专门给如来降妖任务的怪治伤的降妖药。\n");
    set("value", 2000);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

int do_eat(string arg) {
  object me;
  me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么药？\n");
  if (userp(me))
    return notify_fail("这种药对于你不起作用\n");
  if (me->query("eff_kee") >= me->query("max_kee")) {
    write("你现在不需要用金创药。\n");
    return 1;
  } else {
    me->receive_curing("kee", 500);
    message_vision("$N吃下一包降妖药，气色看起来好多了。\n", me);
    add_amount(-1);
    return 1;
  }
}
