#include <room.h>
inherit ROOM;
void baihudong(object me);


void create() {
  set("short", "云楼台");
  set("long", @LONG

此乃宫上一小台，远望仙境，见金光万道滚红霞，瑞气千条喷紫
烟。远上长桥碧雾蒙，天宫宝殿映云光。当真是天上自来有仙境，
不堕人间点污泥。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "down": __DIR__ "yunlou",
  ]));
  set("objects", ([ /* sizeof() == 3 */
    __DIR__ "npc/litianwang": 1,
  ]));

  set("outdoors", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  setup();
}

void init() {
  // 怀疑存在bug,暂时关闭
  // fang@tsrj
  // bug 已经修正 2004.12.4
  add_action("do_ask", "ask");
}

int do_ask(string arg) {
  object me = this_player();
  if (!arg) return 0;
  if (me->is_busy()) return 0;
  me->add_temp("lijing_ask_num", 1);
  if (me->query_temp("lijing_ask_num") > 9) {
    me->delete_temp("lijing_ask_num");
    me->remove_call_out("baihudong");
    me->start_call_out((: call_other, __FILE__, "baihudong", me :), 2 + random(3));
  }
  return 0;
}

void baihudong(object me) {
  if (me) {
    me->start_busy(random(3));
    MISC_D->random_capture(me, 1, 0);
  }
}
