// m_weapon.c

#include <ansi.h>
#include <weapon.h>

inherit M_WEAPON;


void init()
{
        add_action("do_duanlian","duanlian");
        add_action("do_hui","hui");
        add_action("changeType","bianhua");
              add_action("showType","show");
}


void create()
{       
        object me;
        string w_name,w_id,w_or;
        int w_lv;
        me = this_player();
//自制武器被他人得到后有bug，加入以下语句可以解决。
        if (!(me->query("weapon/name")))
             {
                remove_call_out("destrory");
              call_out("destrory",1,this_object());
                return;
              }
//读入数据
        w_name=me->query("weapon/name");
        w_id = me->query("weapon/id");
        w_or = me->query("weapon/or");
        w_lv = me->query("weapon/type/sword");
        set("unit", "柄");   
        set("zizhi",1);
        set("no_get",1);
        set("no_give",1);
        set("no_drop",1);
        set("nopawn", 1);
    //    set_desc(w_lv,w_or,w_name);
        switch(w_or)
                {
                case "千年神木" :
                        set_weight(500);
                        set("material", "iron");
                        set_name(HIR +w_name+ NOR, ({w_id}));
                        set("wield_msg", HIY"$N凌空一握，手中由虚变实的赫然现出一把"+HIR+w_name+HIY"。\n"NOR);
                        set("unwield_msg", HIY"$N手中"+HIR""+w_name+""NOR+HIY"一抖，眨眼间已然不见影踪。\n"NOR);
        
                        break;
                case "海底金母" :
                        set_weight(1000);
                        set("material", "steel");
                        set_name(MAG +w_name+ NOR, ({w_id}));
                        set("wield_msg", MAG"$N凌空一握，手中由虚变实的赫然现出一把"+MAG+w_name+MAG"。\n"NOR);
                        set("unwield_msg", MAG"$N手中"+w_name+"一抖，眨眼间已然不见影踪。\n"NOR);
        
                        break;
                case "寒丝羽竹" :
                        set_weight(30);
                        set("material", "bamboo");
                        set_name(HIG +w_name+ NOR, ({w_id}));
                        set("wield_msg", HIC"$N凌空一握，手中由虚变实的赫然现出一把"+HIG+w_name+HIC"。\n"NOR);
                        set("unwield_msg", HIC"$N手中"+HIG+w_name+HIC"一抖，眨眼间已然不见影踪。\n"NOR);
        
                        break;
                default :
                } 
        setup();
}       
//destruct 武器
void destrory(object ob)
{
        destruct(ob);
}
void owner_is_killed() { destruct(this_object()); }


