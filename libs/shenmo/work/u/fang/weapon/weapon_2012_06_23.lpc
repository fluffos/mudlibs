// Modofied By snowtu 2007
#include <weapon.h>

#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit EQUIP;
#endif
#include <ansi.h>

mapping ttype = ([
  "archery": ({ "把", ({ "chop", "slice", "hack", }), EDGED, "弓", }),
  "axe": ({ "柄", ({ "chop", "slice", "hack", }), EDGED, "斧", }),
  "blade": ({ "把", ({ "slash", "slice", "hack", "chop", }), EDGED, "刀", }),
  "fork": ({ "只", ({ "thrust", "pierce", }), LONG, "叉", }),
  "halberd": ({ "杆", ({ "thrust", "impale", "pierce", "slash", }), LONG, "戟", }),
  "hammer": ({ "把", ({ "bash", "crush", "slam", }), LONG, "锤", }),
  "mace": ({ "对", ({ "impale", "bash", "crush", "slam", }), TWO_HANDED, "锏", }),
  "needle": ({ "根", ({ "chop", "slice", "hack", }), EDGED, "针", }),
  "qin": ({ "把", ({ "chop", "slice", "hack", }), LONG, "琴", }),
  "rake": ({ "杆", ({ "rake", "strike", "bash", }), LONG, "耙", }),
  "spear": ({ "根", ({ "thrust", "impale", "pierce", }), LONG, "枪", }),
  "staff": ({ "杆", ({ "bash", "crush", "slam", "pierce", "impale", }), LONG, "杖", }),
  "stick": ({ "根", ({ "bash", "crush", "slam", }), LONG, "棍", }),
  "sword": ({ "把", ({ "slash", "slice", "thrust", "pierce", }), EDGED, "剑", }),
  "unarmed": ({ "副", ({ "bash", }), TWO_HANDED, "拳", }),
  "whip": ({ "条", ({ "whip", "wave", }), EDGED, "鞭", }),
]);

varargs void init_weapon(string skill_type, int damage, int flag) {
  if (!skill_type || member_array(skill_type, keys(ttype)) == -1)
    error("\n====== 自制武器文件出错 : 引用了错误的 skill_type ======\n");
  set("unit", ttype[skill_type][0]);
  set("skill_type", skill_type);
  set("flag", (int)flag | ttype[skill_type][2]);
  set("weapon_prop/damage", damage);
  set("flag", (int)flag | EDGED);
  if (!query("actions")) {
    set("actions", (: call_other, WEAPON_D, "query_action" :));
    set("verbs", ttype[skill_type][1]);
  }
}

int set_desc(int w_lv, string w_or, string w_name) {
  object weapon, me;
  string danwei, player_name, make_time, name, pid;
  string result1, result2, result3, result4, result;
  int color;

  weapon = this_object();
  me = this_player();
  danwei = weapon->query("unit");
  if (!danwei || !stringp(danwei))
    danwei = "个";
  player_name = me->query("name");
  pid = me->query("weapon/id");
  make_time = me->query("weapon/time");
  color = w_lv;
  if (color <= 5) {
    name = HIB + w_name + NOR;
    result3 = "但似乎威力还没有开发出来，是习武之\n人常用的练武兵器。\n";
  } else if (color <= 10) {
    name = BLU + w_name + NOR;
    result3 = "但似乎威力并不很大，象是江湖人常用\n的护身兵刃。\n";
  } else if (color <= 15) {
    name = CYN + w_name + NOR;
    result3 = "隐隐的散发着一丝令人不安的气息。\n";
  } else if (color <= 20) {
    result3 = "散发着一丝令人不安的气息， 显然普通\n兵器已不能和他相比了。\n";
    name = WHT + w_name + NOR;
  } else if (color <= 25) {
    result3 = "向外散发着一丝迷蒙的雾气，竟有一种\n霸气散发了出来。\n";
    name = HIY + w_name + NOR;
  } else if (color <= 30) {
    result3 = "一股霸气直冲霄汉，直叫神惊鬼泣。\n";
    name = HIC + w_name + NOR;
  } else if (color <= 35) {
    result3 = "霸气似乎有所收敛，但更多的是有了一股\n骇人的戾气。\n";
    name = HIR + w_name + NOR;
  } else if (color <= 40) {
    result3 = "冲天的戾气叫人看了不由心惊胆战，不愿\n再看第二眼。\n";
    name = HIM + w_name + NOR;
  } else if (color <= 45) {
    result3 = "戾气似乎削减了不少，一股温和的王者之\n气透了出来。\n";
    name = MAG + w_name + NOR;
  } else {
    name = HIW + w_name + NOR;
    result3 = "一种庄严，温和，凛然而不可侵犯的气息让\n人不敢有一丝亵渎之意， 它已经返朴归真，成为真正的上古神兵。 \n";
  }
  weapon->set_name(name, ({ pid }));
  weapon->setup();
  switch (w_or) {
    case "千年神木":
      result1 = "\t      这是一" + danwei + "用" + w_or + "打造而成的" + name + "。\n";
      result2 = "看起来黑中透红，似乎十分坚硬。";
      break;
    case "海底金母":
      result1 = "\t      这是一" + danwei + "用" + w_or + "打造而成的" + name + "。\n";
      result2 = "看起来紫澄澄的，似乎十分沉重。";
      break;
    case "寒丝羽竹":
      result1 = "\t      这是一" + danwei + "用" + w_or + "打造而成的" + name + "。\n";
      result2 = "看起来晶莹碧绿，透着丝丝的寒意。";
      break;
    default:
      break;
  }
  result4 = "上面用小篆刻着一行小字：" + player_name + "造于" + make_time + "\n";
  result = result1 + result2 + result3 + result4;
  weapon->set("long", result);
}

int do_duanlian(string arg) {
  object wp = this_object(), me = this_player();
  int w_zhi, w_level;
  string w_or, type;

  if (!arg || arg != me->query("weapon/id"))
    return notify_fail("你要锻炼什么?\n");
  if (!present(wp, me))
    return notify_fail("不在你身上锻炼什么?\n");
  type = wp->query("skill_type");
  if (!type)
    return notify_fail("请先确定武器的类型！\n");
  if (me->query("weapon/type/" + type) < 1) {
    me->set("kee", 10);
    me->set("eff_kee", 10);
    me->set("sen", 10);
    me->set("eff_sen", 10);
    me->set("mana", 0);
    me->set("force", 0);
    return notify_fail("你的武器没有这种类型，瞎锻炼什么！\n");
  }
  if (me->query("weapon/type/" + type) > 99)
    return notify_fail("你的武器等级达到极限，无法锻炼武器！\n");
  if (me->query("maximum_force") < 2200)
    return notify_fail("你的内力上限不够，无法锻炼" + name() + "！\n");
  if (me->query("max_force") < 2200)
    return notify_fail("你的内力不够，无法锻炼" + name() + "！\n");
  if (me->query("kee") < 300)
    return notify_fail("你的气不够，无法锻炼" + name() + "！\n");
  if (me->query("eff_kee") < 300)
    return notify_fail("你现在的体力太弱，无法锻炼" + name() + "！\n");
  if (me->query("eff_sen") < 300)
    return notify_fail("你现在的精力无法集中，不能锻炼" + name() + "！\n");
  if (me->query("sen") < 300)
    return notify_fail("你现在的精神太弱，无法锻炼" + name() + "！\n");
  if (me->query("potential") - me->query("learned_points") < 100)
    return notify_fail("你的潜能不够，无法锻炼" + name() + "！\n");

  message_vision(HIR "$N手握" NOR + name() + HIR "，一股内力丝丝的传了进去。\n" NOR, me);

  me->add("maximum_force", -5);
  me->add("max_force", -5);
  me->set("force", me->query("maximum_force"));
  me->add("kee", -30);
  me->add("eff_kee", -30);
  me->add("eff_sen", -30);
  me->add("sen", -30);
  me->add("learned_points", 100);

  w_zhi = me->query("weapon/value");
  w_zhi++;
  me->set("weapon/value", w_zhi);
  w_or = me->query("weapon/or");
  w_level = me->query("weapon/type/" + type);

  if (w_zhi >= ((w_level + 1) * (w_level + 1))) {
    w_level++;
    me->set("weapon/type/" + type, w_level);
    message_vision(wp->query("name") + HIY "忽的一亮，一道金光隐入$N" NOR HIY "的身体，不见了！\n" NOR, me);
    message_vision(HIG "$N的" NOR + wp->query("name") + HIG "的等级提高了！\n" NOR, me);
    if (wp->query("equipped"))
      wp->unequip();
    reload_object(wp);
    me->set("weapon/value", 0);
    return 1;
  }
  message_vision(RED "$N" NOR RED "的灵气提升了!\n" NOR, me);
  return 1;
}

string hit_msg() {
  switch (random(16)) {
    case 0: return HIW "$n" NOR HIW "身上被战气划开一道深可见骨的伤口！\n" NOR;
    case 1: return HIW "$N" NOR HIW "劲力一吐，一道战气从$w" NOR + HIW "中冲出击中$n" NOR HIW "的$l！\n" NOR;
    case 2: return HIW "$N" NOR HIW "低喝一声，$w" NOR + HIW "上光芒吞吐闪烁！\n" NOR;
    case 3: return HIW "$n" NOR HIW "全身被$N" NOR HIW "的威严的战气罩住动弹不得！\n" NOR;
    case 4: return HIR "一道红色的光圈以$w" NOR + HIR "为中心在瞬间扩散开来，$n" NOR HIR "稍一接触，便被灼伤。\n" NOR;
    case 5: return HIC "$w" NOR + HIC "划出一道光滑优美的曲线，弹指般刹那，穿越了数丈长的距离，衔尾追上了$n" NOR HIC "。\n" NOR;
    case 6: return HIB "只见$w" NOR + HIB "幻化万千，一如有形无质的幽灵，令人无法揣摩，彭的一声，$n" NOR HIB "就中了一招。\n" NOR;
    case 7: return HIW "只见寒光闪过,$n" NOR HIW "已被战气从前胸刺过,鲜血狂喷不止!\n" NOR;
    case 8: return HIW "$N" NOR HIW "手中的$w" NOR + HIW "舞得虎虎生风,卷起一波又一波滔天巨浪，飞向$n" NOR HIW "!\n" NOR;
    case 9: return HIW "但见$N" NOR HIW "手中$w" NOR + HIW "幻化出千万条银蛇,漫天攒动,扑向$n" NOR HIW "!\n" NOR;
    case 10: return HIW "$w" NOR + HIW "划出一道超出任何世俗之美的弧线,宛如刀刃般划过$n" NOR HIW "的面门！\n" NOR;
    case 11: return HIC "$N" NOR HIC "暴喝一声，手中$w" NOR + HIC "圈转，啸音反强，寒光啸音浑然一体，滚向$n" NOR HIC "的$l! \n" NOR;
    case 12: return HIY "$N" NOR HIY "凝势不发，忽然空中幻出众多生灵，种种天象展示在苍茫天地间,$n" NOR HIY "不由得震慑于自然力的多彩与伟大。\n" NOR;
    case 13: return HIW "$w" NOR + HIW "寒光如飞虹，森寒的战气，冷得深入骨髓。\n" NOR;
    case 14: return RED "$w" NOR + RED "忽然化作一团熊熊的烈焰，那团厉火直向$n" NOR RED "卷去。\n" NOR;
    default: return HIC "只见一片茫茫战气中，无数青色光圈潮涌而至，倾刻之间$n" NOR HIC "已没入寒光之中。\n" NOR;
  }
}

/* 攻击效果 20-打断 40-加血 60-吸法 80-吸内 100+-定身 */
mixed hit_ob(object me, object victim, int damage_bonus) {
  object weapon1, weapon;
  int ap, dp;
  string type, msg;
  int lvl, tt;
  if (!me || !victim || !me->is_fighting(victim))
    return 0;
  if (me->query("level") < victim->query("level") / 5)
    return 0;
  weapon1 = me->query_temp("weapon");
  weapon = victim->query_temp("weapon");
  if (!objectp(weapon1) || !objectp(weapon)) return 0;
  msg = HIY "\n$N" NOR HIY "手中的" + weapon1->query("name") + NOR HIY "放出万道金光，$n" NOR HIY "的兵器给金光一照，断成两截落在了地下！ \n" NOR;
  type = weapon1->query("skill_type");
  lvl = me->query("weapon/type/" + type);

  //20lvl打断
  if (lvl < 20)
    return 0;
  //略削弱自制武器断兵器能力，约降为原来一半的概率。windy 20110916
  //见面一个照面就断兵器，太过bt。
  if (me->query("zhuanshi") < 1)
    tt = 20;
  else if (me->query("zhuanshi") < 2)
    tt = 15;
  else tt = 10;
  ap = time() - (int)me->query_temp("bianhua_start_time");
  ap /= 3600;  //每保持状态一小时,增加一点概率
  dp = tt + 5 - ap;  //降低初始变效果的概率
  if (dp < tt) dp = tt;
  //加入no_break标识的兵器不可断，方便某些任务制作。 windy
  if (weapon && objectp(weapon) && !me->query("env/no_break") && random(dp) == 1) {
    if ((!weapon->query("zizhi") && !weapon->query("no_break"))
      || (weapon->query("zizhi") && lvl >= victim->query("weapon/type/" + weapon->query("skill_type")))) {
      weapon->unequip();
      victim->reset_action();
      weapon->move(environment(victim));
      weapon->set("name", "断成两截的" + weapon->query("name"));
      weapon->set("no_get", 1);
      weapon->set("long", "一件断成两截的" + weapon->query("name"));
      message_vision(msg, me, victim);
      message("vision", "\n\n一阵微风吹过，" + weapon->name() + "化为片片尘土，消失不见了。\n\n", environment(weapon));
      destruct(weapon);
    }
  }

  //40lvl加血吸取伤害值的10%加kee,5%加eff_kee,武器每升一级，加固定值5;
  tt += 5;
  dp = tt + 5 - ap;  //降低初始变效果的概率
  if (dp < tt) dp = tt;
  //dp = tt+5 -ap相当于要求player五小时不变化weapon才有最大的概率
  if ((lvl >= 40 && damage_bonus > 20 && random(dp) == 1) || wizardp(me)) {
    int kee = damage_bonus / 10;
    int eff_kee = damage_bonus / 20;
    kee += lvl * 5;
    eff_kee += lvl * 5;

    if (me->receive_heal("kee", kee)
      && !me->query("env/no_msg"))
      tell_object(me, "\n" + name() + NOR WHT "上泛起一层柔和的波纹笼罩你的全身，你的脸色看起来好多了。" NOR);

    if (me->receive_curing("kee", eff_kee)
      && !me->query("env/no_msg"))
      tell_object(me, "\n" + name() + NOR HIW "上泛起一层柔和的波纹笼罩你的全身，你的伤势渐渐愈合了一些。" NOR);
  }


  //60lvl吸法吸取伤害值的5%,武器每升一级，加固定值5;
  tt += 5;
  dp = tt + 5 - ap;  //降低初始变效果的概率
  if (dp < tt) dp = tt;
  //dp = tt+5 -ap相当于要求player五小时不变化weapon才有最大的概率

  if ((lvl >= 60 && damage_bonus > 20 && random(me->query_skill("spells")) >= victim->query_skill("spells") / 5 && random(dp) == 1) || wizardp(me)) {
    int mana = damage_bonus / 20;
    mana += lvl * 5;
    if (me->query("max_mana") * 2 - me->query("mana") < mana)
      me->set("mana", me->query("max_mana") * 2);
    else me->add("mana", mana);
    if (victim->query("mana") < mana)
      victim->set("mana", 0);
    else victim->add("mana", -mana);
    if (!me->query("env/no_msg") && !victim->query("env/no_msg"))
      message_vision(HIB "\n$n" HIB "但觉心神不宁，一时把持不住，法力顿时被$N" HIB "吸去不少！\n" NOR, me, victim);
  }

  //80lvl吸内 吸取伤害值的5%,武器每升一级，加固定值5;     
  tt += 5;
  dp = tt + 5 - ap;  //降低初始变效果的概率
  if (dp < tt) dp = tt;
  //dp = tt+5 -ap相当于要求player五小时不变化weapon才有最大的概率

  if ((lvl >= 80 && damage_bonus > 20 && random(me->query_skill("force")) >= victim->query_skill("force") / 5 && random(dp) == 1) || wizardp(me)) {
    int force = damage_bonus / 20;
    force += lvl * 5;
    if (me->query("max_force") * 2 - me->query("force") < force)
      me->set("force", me->query("max_force") * 2);
    else me->add("force", force);
    if (victim->query("force") < force)
      victim->set("force", 0);
    else victim->add("force", -force);
    if (!me->query("env/no_msg") && !victim->query("env/no_msg")) {
      tell_object(victim, RED "你感到自己的内力飞泻而出\n" NOR);
      tell_object(me, HIW "你感到一股内力，从手中的" + weapon1->query("name") + HIW "涌入你的体内\n" NOR);
    }
  }

  //100lvl定身 最高定身10秒，武器每10级加1秒
  tt += 5;
  dp = tt + 5 - ap;  //降低初始变效果的概率
  if (dp < tt) dp = tt;
  //dp = tt+5 -ap相当于要求player五小时不变化weapon才有最大的概率

  if ((lvl < 100 || random(me->query_kar()) < victim->query_kar()
    || victim->is_busy() || random(dp) != 1) && !wizardp(me))
    return hit_msg();
  lvl /= 10;
  if (lvl > 10) lvl = 10;
  if (lvl < 1) lvl = 1;
  victim->start_busy(random(lvl));
  if (!me->query("env/no_msg") && !victim->query("env/no_msg")
    && victim->is_busy()) {
    msg = HIY "$N" NOR HIY "手中的" + weapon1->query("name") + NOR HIY "放出万道金光，$n" NOR HIY "眼前一晃，顿时呆若木鸡！ \n" NOR;
    message_vision(msg, me, victim);
  }
  return hit_msg();
}

int do_hui(string arg) {
  string w_name;
  object me, weapon;
  me = this_player();
  w_name = me->query("weapon/name");
  if (!arg || arg != me->query("weapon/id"))
    return notify_fail("你要摧毁什么?\n");
  message_vision(HIR "$N大喝一声，一掌猛力击下。结果轰隆一声巨响" + w_name + "断为两截!\n" NOR, me);
  me->delete("weapon");
  me->delete("bld");
  me->reset_action();
  me->save();
  destruct(this_object());
  return 1;
}

int do_bianhua(string wptype) {
  mapping mytype;
  string *alltype;
  object me;
  int lvl, i;
  string w_or, w_name;
  object wp;
  wp = this_object();
  me = this_player();
  if (!present(wp, me)) return 0;  //武器不在身上 ,by snowtu 2011
  if (!wptype)
    return notify_fail("\n你要变成什么？");
  if (wptype == wp->query("skill_type"))
    return notify_fail(name() + "已经是这个类型了，还变化什么?\n");
  if (wp->query("equipped"))
    wp->unequip();
  mytype = (mapping)me->query("weapon/type");
  alltype = keys(mytype);
  me->set_temp("bianhua_start_time", time());
  for (i = 0; i < sizeof(alltype); i++) {
    if (wptype == alltype[i]) {
      lvl = (int)me->query("weapon/type/" + alltype[i]);
      w_or = me->query("weapon/or");
      w_name = me->query("weapon/name");
      if (me->query("mana") < lvl * 20)
        return notify_fail(HIR "你的法力不足，武器无法进行变化!\n" NOR);
      me->add("mana", -lvl * 20);
      set_desc(lvl, w_or, w_name);
      lvl *= 5;
      init_weapon(alltype[i], lvl);
      tell_object(me, HIM "你暗运用法力，如意宝变化成你需要的武器\n" NOR);
      //
      //改成变化后直接装备
      // fang 2007.03.30
      //
      //         if( wizardp(me) )
      {
        //           me->reset_action();
        wp->wield();
      }
      return 1;
    }
  }
  return notify_fail(HIG "你的武器暂时不能转换成这种类型的武器\n" NOR);
}

string long() {
  mapping mytype;
  string *alltype, str, type;
  object me, my;
  int i;
  me = this_player();
  mytype = (mapping)me->query("weapon/type");
  alltype = keys(mytype);
  str = ::long();
  type = this_object()->query("skill_type");
  str += sprintf(
    NOR CYN "\t武器名称" NOR " ： %12s (打造于 %s )\n",
    me->query("weapon/name"),
    me->query("weapon/time")
  );
  str += sprintf(
    NOR CYN "\t材    料" NOR " ： %12s  " CYN "经    验 " NOR "： %d\n",
    me->query("weapon/or"),
    me->query("weapon/value")
  );
  str += sprintf(
    NOR CYN "\t当前类型" NOR " ： %12-s  " CYN "当前伤害 " NOR "： %d\n",
    type ? ttype[type][3] : "无",
    query("weapon_prop/damage")
  );
  for (i = 0; i < sizeof(alltype); i++)
    str += sprintf(
      NOR YEL "\t\t武器类型" NOR " ：%6-s  " YEL "武器等级" NOR " ：%d\n",
      ttype[alltype[i]][3],
      me->query("weapon/type/" + alltype[i])
    );
  return str;
}

void init() {
  add_action("do_duanlian", "duanlian");
  add_action("do_hui", "hui");
  add_action("do_bianhua", "bianhua");
}

varargs string short(int raw) {
  string str, temp, tmp;
  object ow;

  tmp = query("owner_id");
  if (!tmp || !stringp(tmp))
    return ::short(raw);
  ow = find_player(tmp);
  if (!ow || !present(this_object(), ow))
    return ::short(raw);
  tmp = sprintf("%c%c之", ow->name(1)[0], ow->name(2)[1]);
  if (!query("skill_type"))
    temp = NOR "";
  else temp = NOR "名" + ttype[query("skill_type")][3];
  if (strsrch(name(raw), "之") == -1 || !query("skill_type"))
    str = temp + tmp + name(raw) + "(" + capitalize(query("id")) + ")";
  else str = temp + name(raw) + "(" + capitalize(query("id")) + ")";
  return str;
}
