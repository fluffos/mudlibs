//fang@tsrj

#include <ansi.h>
inherit NPC;
#include "star.h"

void create() {
  set_name(HIB "棍魄" NOR, ({ "soul of stick", "stick", "soul" }));
  set("long", HIW "传说中的棍的魂魄，练就上古神兵的必须品。\n" NOR);
  set("gender", "男性");
  set("title", HIY "方舟传说之棍魄" NOR);
  set("age", 30);
  set("attitude", "friendly");
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 40);
  set("combat_exp", 125000000);
  set("daoxing", 125000000);
  set_skill("dodge", 600);
  set_skill("force", 600);
  set_skill("parry", 600);
  set_skill("unarmed", 600);
  set_skill("shengdou", 600);
  set_skill("stars-steps", 600);
  set_skill("moonforce", 600);
  set_skill("moonshentong", 600);
  map_skill("parry", "shengdou");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "shengdou");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("max_force", 8000);
  set("force", 16000);
  set("max_mana", 8000);
  set("mana", 16000);
  set("mana_factor", 350);
  set("force_factor", 200);
  set("max_kee", 70000);
  set("max_gin", 70000);
  set("max_sen", 70000);
  setup();
  carry_object("/d/longzhu/armor/guijia")->wear();
}
void kill_ob(object me) {
  int damage, lvl, r_lvl, skill, i;
  object ob = this_object();

  if (!present(me, environment())) {
    ob->delete_temp("my_killer");
    return;
  }

  if (me->is_ghost() || !me->is_fighting(ob)) {
    ob->delete_temp("my_killer");
    return;
  }
  if (wizardp(me)) return;

  switch (random(6)) {
    case 0:
      {
        message_vision(HIC "「圣光之雷」$N双手一挥，一团银芒直冲$n而去！\n", ob, me);
        if (random(2)) {
          message_vision(HIC "$N被$n的银芒刺得遍体鳞伤！\n" NOR, me, ob);
          me->add("eff_kee", -query("max_kee") / 50);
          me->add("eff_sen", -query("max_sen") / 50);
          kill_ob(me);
        } else {
          message_vision(HIR "$N轻而易举的躲过了$n的攻击！\n" NOR, me, ob);
        }
      }
      break;

    case 1:
      {
        r_lvl = random(5);
        if (r_lvl > 3) lvl = 3;
        if (r_lvl < 1) r_lvl = 1;
        message_vision(HIW "$N大喝一声“刀枪不如！”皮肤变得如钢铁般结识，$n的攻击立刻被反弹回去！\n" NOR, ob, me);
        for (i = 0; i < r_lvl; i++)
          COMBAT_D->do_attack(me, me, me->query_temp("weapon"));
        break;
      }

    case 2:
      {
        message_vision(HIB "$N运起[人间炼狱],幽灵冥气冲向$n \n", ob, me);
        if (random(2)) {
          message_vision(HIB "$N被[人间炼狱]击中,顿时血流如注，顷刻染红了全身！\n" NOR, me);
          me->add("eff_kee", -3 * query("max_kee") / 30);
          me->add("eff_sen", -3 * query("max_sen") / 30);
        } else {
          message_vision(HIR "$N看准幽灵冥气的方向，纵身跃起，躲过这致命一击！\n" NOR, me);
        }
      }
      break;
  }

  if (random(10) == 1)
    powerup();
  remove_call_out("kill_ob");
  call_out("kill_ob", 4 + random(9), me);
}
void fight_ob(object me) {
  kill_ob(me);
}

void die() {
  object ob = this_object();
  object me = ob->query_temp("last_damage_from");
  powerup();

  if (!me || !present(me, environment(ob)))
    return;

  if (random(20) != 1 && !wizardp(me)) {
    say(HIB "\n" + name() + HIB "点了点头：不错不错，再来再来！\n" NOR);
    me->kill_ob(ob);
    ob->kill_ob(me);
    return;
  }

  me->remove_killer(ob);
  ob->remove_killer(me);

  me->start_busy(3);

  ob->command("great");
  ob->command("say 果真是后浪推前浪。。。\n");

  if (me->query("weapon/make") && (int)me->query("weapon/type/stick") < 1) {
    me->set("weapon/type/stick", 1);
    message(
      "channel:chat",
      HIY + "【神兵传说】" + ob->query("name") + "：" + HIB + me->query("name") + "得到棍魄！\n" + NOR,
      users()
    );
    message(
      "channel:rumor",
      HIY + "【神兵传说】" + ob->query("name") + "：" + HIB + me->query("name") + "得到棍魄！\n" + NOR,
      users()
    );

  }
  message_vision(HIW "$N化作尘土消失在夜风中！\n" NOR, ob);
  destruct(ob);
  return;
}
