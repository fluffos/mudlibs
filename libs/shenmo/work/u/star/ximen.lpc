inherit NPC;
inherit F_MASTER;
#include </d/panshi/panshi.h>
#include <ansi.h>
string give_map(object me);
string ask_mieyao(object me);
string ask_me(object me);
string ask_cancel();
int do_yes(string arg);


void create() {
  set_name("文曲星", ({ "star", "xstar" }));

  set("long", "文曲星乃是当代绝顶高手之一．赌神心法已经到达了＂无神＂的境界．．\n");
  set("faith", 4000);
  set("gender", "男性");
  set("title", HIR "赌神" NOR);
  set("class", "human");
  set("age", 34);
  set("attitude", "friendly");
  create_family("江湖浪子", 1, "绿");
  set("per", 30);
  set("int", 30);
  set("str", 30);
  set("cps", 30);
  set("max_kee", 2000);
  set("max_gin", 1100);
  set("max_sen", 2000);
  set("force", 8000);
  set("max_force", 3000);
  set("force_factor", 160);
  set("max_mana", 3000);
  set("mana", 8000);
  set("mana_factor", 100);
  set("combat_exp", 8000000);
  set("daoxing", 2000000);
  set("eff_dx", 250000);
  set("nkgain", 400);
  set("chat_chance", 50);
  set_skill("sword", 350);
  set_skill("parry", 350);
  set_skill("force", 350);
  set_skill("wuji-force", 350);


  /*       set("inquiry", ([
        "落花吹雪" : (: give_map :),

    "行侠": (: ask_mieyao :),
      "cancel": (: ask_cancel :),
//"紫禁之战" : (: ask_me :),
     "leave"  : (:askLeave:),
      "败北": (: ask_cancel :),
]) ); */

  setup();
  carry_object("/d/youxia/obj/gsjian")->wield();
  carry_object("/d/youxia/obj/xuecloth")->wear();
}


void attempt_apprentice(object ob) {
  if ((string)ob->query("family/family_name") == "江湖浪子") {
    if (((int)ob->query("combat_exp") < 1)) {
      command("say 这位" + RANK_D->query_respect(ob) + "你武功低微．．．．还是几年后再来找我吧。\n");
      return;
    }
    command("smile");
    command("say 很好，原来这位" + RANK_D->query_respect(ob) + "是游侠儿的徒弟，好吧，本城主就收你为徒！\n");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("title", HIR "赌神亲授弟子" NOR);
    return;
  }
  command("shake");
  command("say " + RANK_D->query_respect(ob) + "既然已经派入他门,还是另寻他人吧！\n");
  return;
}
void init() {
  ::init();
  //      re_rank(this_player())
  add_action("doAgree", "agree");
  add_action("do_fuming", "fuming");
  add_action("do_yes", "yes");
}


string give_map(object me) {
  me = this_player();
  me->set_temp("need_map", 1);
  return "如今我落难在此，" HIW "〖落花吹雪〗" HIC "是我毕生武功的精华,你想要吗(yes)？" NOR "\n";
}


int do_yes(string arg) {
  object me;
  object item;
  me = this_player();

  if (me->query_temp("need_map")) {
    message_vision("$N答道：想要！\n\n", me);

    if (me->query("family/family_name") != "江湖浪子")
      return notify_fail("西门吹雪说道：想骗本门派的秘籍，没门！\n");

    if (query("no_map") == 0) {
      message_vision("西门吹雪说道：好！那我给你这本秘籍吧！\n", me);
      me->set_temp("need_map", 0);

      //                        carry_object("/d/youxia/obj/xinfa");
      //                        command("give book to " + me->query("id"));

      item = new("/d/youxia/obj/xinfa.lpc");
      item->move(me);
      set("no_map", 1);
      call_out("regenerate", 480);
    } else {
      message_vision("西门吹雪说道：我本来想给你一本的，但是刚才被人要走了。\n", me);
    }

    return 1;
  }
  return 0;
}

int regenerate() {
  set("no_map", 0);
  return 1;
}

string ask_mieyao(object me) {
  me = this_player();
  if ((string)me->query("family/family_name") == "江湖浪子") {
    tell_room(environment(me), "西门吹雪剑气一闪，一道白光直冲九天。\n");
    return "/d/obj/mieyao"->query_yao(me);
  }
  return ("本人不知道，不要烦我走开。");
}
string ask_cancel() {
  object me = this_player();
  if ((int)me->query_temp("m_mieyao")) {
    me->delete_temp("m_mieyao");
    me->delete("secmieyao");
    me->delete("secmieyao/type");
    me->delete("secmieyao/location");
    me->delete("secmieyao/place");
    me->delete("secmieyao/name");
    me->delete("secmieyao/id");
    return ("你就这点本事，怎么能行侠仗义！");
  } else {
    return ("你有任务吗？！");
  }
}

string ask_me(object me) {
  command("sigh");
  command("say 你要和我决斗吗？");
  command("say 你不是我对手，我劝你还是打消这个念头吧！");
  command("say 如果你执意和我决斗，那我们就走吧！");
  return ("你执意和我决斗吗(ok)？");
}

int do_ok() {
  object who;
  who = this_player();
  command("say 好吧，随我来！");
  who->move("/d/youxia/zijing.lpc");
  return 1;
}
