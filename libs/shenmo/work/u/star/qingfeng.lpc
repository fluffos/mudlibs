(CLUB_ID,getuid(me));                ob_info=CLUB_D->query_member_info(CLUB_ID,getuid(ob));  /*                if(ob->query("gender") != "男性")                {                        return notify_fail("只有女性可以成为分堂主。\n");                }               */                if(sizeof(ob_info))                {                        if(ob_info["level"] != 2)                                return notify_fail("只有一般帮众可以成为分堂主。\n");                        if( (int) member_array(sub, query("sub_club"))<0 )                                return notify_fail("目前可用的分堂为 【妖神堂】、【情义堂】、【水帘堂】、【兰州堂】、【五洲堂】、【四海堂】、【神州堂】、【天地堂】、【古墓堂】、【侠客堂】、【风雨堂】、【日月堂】、【星海堂】、【竞技堂】、【无敌堂】、【无情堂】、【血魔堂】、【心魔堂】\n");                        ob_info["level"]=5;                        ob_info["info1"]=sub;                        CLUB_D->set_member(CLUB_ID,getuid(ob),ob_info);                        if(!mark=present(CLUB_MARK,ob))                        {                                write("清风细雨楼信物取得失败。\n");                        }                        else                        {                                message_vision("$N将$n提升为"+sub+"分堂主, 并和$n握手勉励一番。\n",me,ob);                                mark->move(ob);                        }                        ob->save();                        return 1;                }             
