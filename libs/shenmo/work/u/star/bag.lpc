
#include <ansi.h>
inherit F_AUTOLOAD; 
inherit ITEM;

void create()
{
        set_name(HIB"次元袋"NOR, ({ "bag" }) );
        set_weight(0);
        set_max_encumbrance(8000000);
                set_max_items(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "口");
                set("long", HIW+"一个天界才有的次元袋，透射着某种让人无法说出的神秘\n"+NOR+BLINK+HIY+"西游记--神魔传说巫师组给大家的礼物。\n"+NOR);
             set("no_give", "这种稀世之宝怎么能轻易送人呢?\n");
             set("no_sell", "卖?这种稀世之宝谁买得起啊!\n");
             set("no_drop", "如此宝贵的宝物再世难求啊。\n");
             set("no_steal",1);
                set("value", 50000);
        }
}

int is_container() { return 1; }

int query_autoload() { return 1; }  

