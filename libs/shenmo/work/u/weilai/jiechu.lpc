#include <localtime.h>
#include <ansi.h>
inherit ITEM;
int do_chop(string arg);
void create()
{
	set_name("退绑符", ({"tuibang"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "解除绑定装备的绑定（tuibang）。\n");
                set("unit", "个");
                set("xybvalue", 3);
                set("short","解除绑定");
 
        }
}

void init()
{
 add_action("do_chop","tuibang");
}
int do_chop(string arg)
{
    object me, item;
    if(!arg)
    {
        write("你要解除哪件装备？\n");
                return 1;
    }
    me=this_player();
    item=present(arg,me);
    if(!item)
    {
        write("你没有这个物品");
        return 1;
    }
    if(!item->query("bind_id"))
    {
        write("此装备未曾绑定");
        return 1;
    }
    else
    {item->set("bind_id",0);  }

    write("解除成功\n");
    destruct(this_object());
    return 1;
}