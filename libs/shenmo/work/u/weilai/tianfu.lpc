#include <localtime.h>
#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
int do_chop(string arg);
void jiang(string jiang,object me);
void sheng(string jiang,object me);

mapping gift=([
	"str"		: "膂力",
	"cor"		: "胆识",
	"int"		: "悟性",
	"spi"		: "灵性",
	"cps"		: "定力",
	"per"		: "容貌",
	"con"		: "根骨",
	"kar"		: "福缘",
]);
void create()
{
	set_name("天赋调整丹", ({"tianfu"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "神奇仙丹，调整天赋，外壳较硬，得咬（yao）。\n");
                set("unit", "个");
                set("value", 1);
                set("xybvalue",10);
                set("food_remaining", 3);
                set("food_supply", 50);
        }
}

void init()
{
 add_action("do_chop","yao");
}
int do_chop(string arg)
{
    string brg,*ss;
    object me;
    me=this_player();
    if(arg!="tianfu")
    {   
   write("瞎咬小心蹦了牙\n");
    return 1;
    }
    brg="您把天赋调整丹含在嘴里\n";
    ss=keys(gift);
    for(int i=0;i<sizeof(ss);i++)
    {
        brg+=ss[i]+"    "+gift[ss[i]]+"\n";
    }
    brg+="请输入您要降低的天赋\n";
    write(brg);
    input_to("jiang",me);
    return 1;

 }
void jiang(string jiang,object me)
{
    string *ss,brg;
    ss=keys(gift);
    if(!jiang)
        return;
    if(jiang=="n"||jiang=="N")
        return;
    for(int i=0;i<sizeof(ss);i++)
    {
        if(jiang==ss[i])
        {
            if(me->query(jiang)<10)
            {
                write("您的这项天赋已经太低了");
                return ;
            }
            brg="好了，下一步请输入您想要增加的天赋\n";
            write(brg);
            me->add(jiang,-1);
           input_to("sheng",me);
           return;
        }
    }
    write("您输入的有误，请重新输入\n取消请输入n");
    input_to("jiang",me);
    return;
}
void sheng(string jiang,object me)
{
       string *ss,brg;
    ss=keys(gift);
    if(!jiang)
    {
        write("输入错误，重新输入\n");
         input_to("sheng",me);
    }
     for(int i=0;i<sizeof(ss);i++)
    {
        if(jiang==ss[i])
        {
            if(me->query(jiang)>45)
            {
                write("您的这项天赋已经太高了");
                 input_to("sheng",me);
                return ;
            }
            brg="好了，您想要增加的天赋"+jiang+"成功\n";
             brg+="您大嚼了几口天赋丹，咽下肚去\n";
            write(brg);
            me->add(jiang,1);
           destruct(this_object());
           return;
        }
    }
            write("输入错误，重新输入\n");
         input_to("sheng",me);
         return ;
}