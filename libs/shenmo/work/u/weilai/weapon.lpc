#include <armor.h>

inherit CLOTH;

void create() {
  set_name("武器复制器", ({ "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "cloth");
    set("unit", "件");
    set("armor_prop/armor", 1);
  }
  setup();
}
void wuqi(string k);
void yifu(string k);

void init() {
  add_action("wuqi", "wuqi");
  add_action("yifu", "yifu");

}
void wuqi(string k) {
  object wuqi;
  int i, ll, dh;
  string tupu;
  if (sscanf(k, "%s %d", tupu, dh) == 2)
    wuqi = NEWITEMS_OB->get_weapon(this_player(), tupu, 8, dh, 2);  //或得武器者，武器种类,最低品级控制，道行要求控制,获得方式
    wuqi->set("sockets/max", 4);
  wuqi->set("weapon_prop/luck", 3);
  wuqi->delete("weapon_wiel");
  wuqi->move(this_player());
  return;
}
void yifu(string k) {
  object wuqi;
  int i, ll, dh;
  string tupu;
  if (sscanf(k, "%s %d", tupu, dh) == 2)
    wuqi = NEWITEMS_OB->get_armor(this_player(), tupu, 8, dh, 2);
  wuqi->move(this_player());
  return;
}
