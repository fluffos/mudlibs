#include <ansi.h>
inherit ITEM;
void create()
{
        set_name(HIY"任务辅助卡"NOR, ({"renwu ka"}) );
        set_weight(1);
        set("no_get",1);
      set("no_give",1);
        set("no_drop","这么贵重的东西怎么能丢掉呢。\n");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unbreak",1);
                set("unit", "张");
                set("material", "steal");
                set("long", HIY"
             这是一张可以提高任务奖励的卡片，
          带上此卡片，李靖，钟馗,师门奖励翻倍，
          为时24小时！使用方法请使用（kaiqi）
          查看

\n"NOR);
  set("xybvalue", 5);
  set("short", "李靖，钟馗,师门奖励翻倍\n");
  set("sytime",43200);
   }
}

void init()
{       add_action("do_deposit","kaiqi");
        add_action("do_withdraw","guanbi");
         add_action("do_cha","chakan");
}
int do_deposit(string arg)
{
    string brg;
    if(!arg)
    {
        brg="使用方法如下\n";
        brg+=HIY+" kaiqi ka"+NOR+"任务卡就会生效\n";
        brg+=HIY+"guanbi ka"+NOR+"任务卡会关闭\n";
        brg+=HIY+"chakan ka"+NOR+"显示目前任务卡信息\n";
    }
    else if(arg!="ka")
        brg="开启卡的指令是"+HIY+"kaiqi ka"+NOR+"\n";
     else if(query("shuangbei"))
        brg="任务卡已经开启";
    else if(query("sytime")<10)
    {
        brg="任务卡的时间已经用完了\n";
        delete("no_drop");
        write("任务卡化为了灰烬 \n");
        destruct(this_object());
        return ;
    }
    else
    {
         if(query("systime")>86401)
            return 1;
        set("shuangbei",query("sytime")+time());
        if(query("systime")>86401)
            return 1;
        brg="您成功的开启了任务辅助卡\n";
    }
      write(brg);
    return 1;

}
int do_withdraw(string arg)
{
    string brg;
    if(!arg)
    {
        brg="使用方法如下\n";
        brg+=HIY+" kaiqi ka"+NOR+"任务卡就会生效\n";
        brg+=HIY+"guanbi ka"+NOR+"任务卡会关闭\n";
        brg+=HIY+"chakan ka"+NOR+"显示目前任务卡信息\n";
    }
    else if(arg!="ka")
        brg="关闭卡的指令是"+HIY+"guanbi ka"+NOR+"\n";
    else if(!query("shuangbei"))
        brg="任务卡尚未开启";
    else if((query("shuangbei")-time())<10)
    {
        brg="任务卡的时间已经用完了\n";
        delete("no_drop");
        set("sytime",1);
    }
    else if((query("sytime")+time()-1800)<query("shuangbei"))
        brg="开启任务卡后半小时才可关闭\n";
    else
    {
         if(query("systime")>86401)
            return 1;
        set("sytime",query("shuangbei")-time());
        delete("shuangbei");
        if(query("systime")>86401)
            return 1;
        brg="您成功的关闭了任务辅助卡，避免了时间的浪费\n";
    }
    write(brg);
    return 1;
}
int do_cha(string arg)
{
    int b;
   string brg;
    if(!arg)
    {
        brg="使用方法如下\n";
        brg+=HIY+" kaiqi ka"+NOR+"任务卡就会生效\n";
        brg+=HIY+"guanbi ka"+NOR+"任务卡会关闭\n";
        brg+=HIY+"chakan ka"+NOR+"显示目前任务卡信息\n";
    }
    else if(arg!="ka")
        brg="查看卡的指令是"+HIY+"chakan ka"+NOR+"\n";
    else
    {
        brg="任务卡信息如下\n\n";
       if(b=query("shuangbei"))
       {    brg+="您的任务卡"+HIG"已经开启"NOR+"\n";
            brg+="您的任务卡还有"+HIY+(b-time())/60+NOR+"分钟\n";
       }else
       {
            brg+="您的任务卡"+HIG"尚未开启"NOR+"\n";
            brg+="您的任务卡还有"+HIY+query("sytime")/60+NOR+"分钟\n";
       }
        brg+="\n\n";
    }
    write(brg);
    return 1;
}

int query_autoload() { return 1; }      