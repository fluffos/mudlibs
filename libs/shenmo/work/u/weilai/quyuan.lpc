//quyuan by weilai

inherit F_VENDOR_SALE;
int ask_zongzi();
string *idd;
void create() {
  set_name("屈原", ({ "qu", "qu yuan", "yuan" }));
  set("title", " 汨罗江之神");
  set("gender", "男性");
  set("age", 42);
  set("long", "神仙飘飘。\n");
  set("str", 30);
  set("con", 30);
  set("spi", 30);
  set("combat_exp", 200000);
  set("daoxing", 200000);
  set_skill("force", 5000);
  set_skill("unarmed", 5000);
  set_skill("dodge", 5000);
  set_skill("parry", 5000);
  set("force", 20000);
  set("max_force", 20000);
  set("force_factor", 5);
  set("inquiry", ([
    "粽子": (: ask_zongzi :),
  ]));
  setup();
  carry_object("/d/obj/cloth/skirt")->wear();
  carry_object("/d/obj/cloth/shoes")->wear();
}

int ask_zongzi() {
  object ob, zongzi;
  ob = this_player();
  if (sizeof(idd))
    for (int i = sizeof(idd); i--; ) {

      if (ob->query("id") == idd[i]) {
        write("不可贪，不可贪\n");
        return 1;
      }
      if (i == 0)
        break;
    }
  write("这可是多年来的投入江中的粽子的精华,就送给你了\n");
  zongzi = new("/u/weilai/zongzi");
  zongzi->move(ob);
  if (!sizeof(idd))
    idd = ({});
  idd += ({ ob->query("id") });
  return 1;
}
