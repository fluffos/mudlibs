//weilai 2009 7.17
#include <localtime.h>
#include <ansi.h>
inherit ITEM;
int do_chop(string arg);
void create() {
  set_name("修饰符", ({ "xiushi fu" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "使用(xiushi)修饰符，自由自在描述装备");
    set("unit", "个");
    set("xybvalue", 5);
    set("short", "自由自在描述装备");
    set("shiyong_ci", 3);

  }
}

void init() {
  add_action("do_chop", "xiushi");
}
int do_chop(string arg) {
  object me, ob;
  string brg;
  if (!arg) {
    write("你要修饰什么\n 修饰指令 xiushi 装备id\n");
    return 1;
  }
  me = this_player();
  if (!objectp(ob = present(arg, me)))
    brg = "你身上没有这个物品\n";
  else if (!ob->query("armor_type") && !ob->query("skill_type"))
    brg = "这个物品不是装备，不能描述\n";
  else brg = "请输入所要描述的部位
         1.look时，2.穿上,3.脱下";
  write(brg);
  input_to("miaosu", ob);
  ////////////////////////////
  return 1;
}
int miaosu(string arg, object ob) {
  int i;
  if (!arg) {
    write("输入错误\n");
    return 1;
  }
  i = atoi(arg);
  if (i != 1 && i != 2 && i != 3) {

    write("输入错误\n");
    return 1;

  }
  write("请输入所要描述语言，可加入颜色,颜色代码参考help nick中的\n");

  input_to("miaosu_1", ob, i);
  return 1;
}
int miaosu_1(string arg, object ob, int i) {

  string brg;
  if (!arg)
    arg = "";
  arg = replace_string(arg, "$BLK$", BLK);
  arg = replace_string(arg, "$RED$", RED);
  arg = replace_string(arg, "$GRN$", GRN);
  arg = replace_string(arg, "$YEL$", YEL);
  arg = replace_string(arg, "$BLU$", BLU);
  arg = replace_string(arg, "$MAG$", MAG);
  arg = replace_string(arg, "$CYN$", CYN);
  arg = replace_string(arg, "$WHT$", WHT);
  arg = replace_string(arg, "$HIR$", HIR);
  arg = replace_string(arg, "$HIG$", HIG);
  arg = replace_string(arg, "$HIY$", HIY);
  arg = replace_string(arg, "$HIB$", HIB);
  arg = replace_string(arg, "$HIM$", HIM);
  arg = replace_string(arg, "$HIC$", HIC);
  arg = replace_string(arg, "$HIW$", HIW);
  arg = replace_string(arg, "$NOR$", NOR);
  arg = replace_string(arg, "$BLINK$", BLINK);
  if (i == 1)
    brg = "look 时";
  else if (i == 2)
    brg = "穿上 时";
  else brg = "脱下 时";

  write("您对" + ob->query("name") + brg + "的描述为\n");
  write(arg + "\n");
  write("确定请输入y，重新描述请选择n，放弃描述请选择其他键\n");
  input_to("miaosu_2", ob, i, arg);
  return 1;

}
int miaosu_2(string qd, object ob, int i, string arg) {
  if (!qd) {
    write("放弃描述\n");
    return 1;
  } else if (qd == "n" || qd == "N") {
    write("重新输入");
    write("请输入所要描述语言，可加入颜色,颜色代码参考help nick中的\n");

    input_to("miaosu_1", ob, i);
    return 1;
  } else if (qd == "y" || qd == "Y") {
    if (i == 1)
      ob->set("long", arg);
    if (i == 2)
      if (ob->query("skill_type"))
        ob->set("wield_msg", arg);
      else ob->set("wear_msg_msg", arg);
    if (i == 3)
      if (ob->query("skill_type"))
        ob->set("unwield_msg", arg);
      else
        ob->set("unequip_msg", arg);
    write("描述完毕\n");
    set("shiyong_ci", query("shiyong_ci") - 1);
    if (query("shiyong_ci") < 1) {
      write("修饰符化为了灰烬");
      destruct(this_object());
    }
    return 1;
  } else {
    write("放弃描述\n");
    return 1;
  }

}
