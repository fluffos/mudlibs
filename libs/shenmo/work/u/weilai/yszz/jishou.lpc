#include <localtime.h>
#define GOLD HIY"黄金"NOR
#define JHB HIG"西游币"NOR
#define GXSJ 86400
#define LL "/cmds/usr/ll"
inherit NPC;
inherit F_SAVE;
int lxqxyb_me();
int value_me();
int me_jishou();
int jishou_fen(string arg);
int me_qiugou();
int qu_qian();
int qu_wu();
int qu_qiugou();
void genxin();
int qu_qiugoum(string arg);
int no_nojishou(object ob);
int do_chakan(string arg);
mapping *jilu;  //寄售记录
mapping *qiugou;  //求购记录
mapping zwdy;   //对应的中文名字

void create() {
  set_name("寄售商人", ({ "jishou seller", "seller" }));
  set("kaifa", 38);
  set("jizhi", 46);
  set("shen_type", 1);
  set("gender", "男性");
  set("age", 45);
  set("long",
    "西游币商店的伙计。\n");
  set_skill("unarmed", 5000);
  set_skill("dodge", 5000);
  set_temp("apply/damage", 1500);
  set("combat_exp", 4000000);
  set("attitude", "friendly");
  set("no_clean_up", 1);



  setup();

  //    carry_object("/clone/misc/changpao")->wear();
  genxin();
  restore();
  set("inquiry", ([
    "我要寄售": (: me_jishou :),
    "我要求购": (: me_qiugou :),
    "取回寄售物品": (: qu_wu :),
    "撤销求购": (: qu_qiugou :),
    "取回所得金钱和物品": (: qu_qian :),
  ]));
}
