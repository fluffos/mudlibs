#include "/d/obj/newitem/jianding.lpc"
inherit ITEM;

void create() {
  set_name("修复符", ({ "xiufu" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "cloth");
    set("unit", "张");
    set("xybvalue", 2);
    set("ci", 10);
    set("short", "鉴定装备，可用十次");

  }
}
int ding(string k);
void init() {
  add_action("ding", "xiufu");

}
int ding(string k) {
  object me, *item, itme, *id, name;
  if (!k) {
    write("你要修复什么？\n");
    return 1;
  }
  me = this_player();
  item = all_inventory(me);
  for (int i = 0; i < sizeof(item); i++) {
    if (item[i]->query("name") == k) {
      itme = item[i];
      write("修复开始\n");
      name = itme->query("id");
      id = itme->query("name");
      itme->set_name(name, ({ id }));
      write("修复完毕\n");
      destruct(this_object());
      return 1;
    }
  }

  write("无此物品\n");



  return 1;
}
