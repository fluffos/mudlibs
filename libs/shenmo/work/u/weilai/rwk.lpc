#include <ansi.h>
inherit ITEM;
void tiaotiao();
void cs_rwk();
void create() {
  seteuid(getuid());
  set_name(HIY "辅助卡销毁器" NOR, ({ "renwuxiaohui" }));
  CHANNEL_D->do_channel(this_object(), "sys", "新闻系统已经启动。\n");
  call_out("tiaotiao", 2);
}

void tiaotiao() {
  remove_call_out("cs_rwk");
  remove_call_out("tiaotiao");
  call_out("tiaotiao", 600);
  call_out("cs_rwk", 1);
}
void cs_rwk() {
  object *suser;
  suser = children("/obj/xyb/obj/renwuka");
  for (int i = (sizeof(suser) - 1); i > -1; i--) {
    if (!suser[i]->query("shuangbei"))
      continue;
    if ((suser[i]->query("shuangbei") - time()) > 1)
      continue;

    CHANNEL_D->do_channel(
      this_object(),
      "sys",
      "销毁一张卡来自" + environment(suser[i])->query("id") + "。\n"
    );
    suser[i]->do_withdraw("ka");

  }
}
