#include <localtime.h>
#include <ansi.h>
inherit ITEM;
int do_chop(string arg);
void create() {
  set_name("掉宝符", ({ "diaobao" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "点燃(shao)掉宝符，幸运长相随。\n");
    set("unit", "个");
    set("xybvalue", 3);
    set("short", "24小时增加所掉装备品质");

  }
}

void init() {
  add_action("do_chop", "shao");
}
int do_chop(string arg) {
  object me, ob;
  if (arg != query("id")) {
    write("你要烧什么");
    return 1;
  }
  me = this_player();
  if (me->query("xyb/diaobao") > time()) {
    me->add("xyb/diaobao", 86400);

  } else
    me->set("xyb/diaobao", time() + 86400);

  write("掉宝符化为一阵青烟，笼罩在你的身旁\n");
  destruct(this_object());
  return 1;
}
