int do_qiugou(string arg)
{
	object me,ob,*c;
	int b=0,cc;
	string wpm;
	me=this_player();
	if(!arg)
     return notify_fail("输入格式为 qiugou <数字编号> <物品名>   ！ \n");

	if(!objectp(me)) return notify_fail("未知错误，请重试！ \n");
	if (sizeof(all_inventory(me)) >= me->query_max_items())
	{
		write("你身上的东西太多了，先处理一下再买东西吧。\n");
		return 1;
	}

	if(sscanf(arg,"%d %s",b,wpm)!=2)
		return notify_fail("输入格式为 qiugou <数字编号> <物品名>   ！ \n");
	for(int i=0;i<sizeof(qiugou);i++)
	{
		if(b==qiugou[i]["bianhao"])
			if(wpm==qiugou[i]["wpm"])
				;
			else return notify_fail("编号和物品不符！ \n");
		else continue;


		if(!objectp(ob=present(wpm,me)))
		{
			write("别开玩笑你哪有这个物品！ \n");
			return 1;
		}
                 if(no_nojishou(ob))              //限制寄售
	return 1;
		if(qiugou[i]["bizhong"]==JHB)
		{
	
			ob->move(this_object(),1);
			me->add("lxqxyb",qiugou[i]["jiage"]);


			if(!query("qiugou/"+qiugou[i]["wuzhu"]))
			{
			set("qiugou/"+qiugou[i]["wuzhu"],({ob}));
			//set("chushou/"+qiugou[i]["wuzhu"]+"/西游币",qiugou[i]["jiage"]);
			}
			else {
				c=query("qiugou/"+qiugou[i]["wuzhu"]);
				c+=({ob});
				set("qiugou/"+qiugou[i]["wuzhu"],c)	;
				//cc=query("chushou/"+qiugou[i]["wuzhu"]+"/西游币");
			//	cc+=jilu[i]["jiage"];
			//	set("chushou/"+qiugou[i]["wuzhu"]+"/西游币",cc);
			}
			qiugou-=({qiugou[i]});
			////
		
			write("交易成功\n");
			save();
			return 1;

		}
		if(qiugou[i]["bizhong"]==GOLD)
		{
	ob->move(this_object(),1);
    MONEY_D->pay_player(this_player(), qiugou[i]["jiage"] *10000);
	if(!query("qiugou/"+qiugou[i]["wuzhu"]))
		set("qiugou/"+qiugou[i]["wuzhu"],({ob}));	
	else {
		c=query("qiugou/"+qiugou[i]["wuzhu"]);
		c+=({ob});
		set("qiugou/"+qiugou[i]["wuzhu"],c)	;
	}
	qiugou-=({qiugou[i]});
	write("交易成功\n");
		save();
	return 1;

		}
	}

	write("无此物品");
	return 1;




}
int no_nojishou(object ob)
{
         if (ob->query("money_id")&&ob->query("id")!="thousand-gold")
        {
                write(CYN + name() + "道：本地只可使用金票\n" NOR);
                return 1;
        }

        if (ob->is_character())
        {
                write(CYN + name() + "道：哼！我这里做正经生"
                      "意，不贩卖人口！\n" NOR);
                return 1;
        }
             if (ob->is_item_make())
	{
		write(CYN + name() + "摇摇头道：自己制造的物品不能拿来寄售！\n" NOR);
		return 1;
	}
              if (ob->query("shaolin"))
        {
                write(CYN + name() + "惊道：少林物品不可寄售。\n" NOR);
                return 1;
        }

        if (ob->query("mingjiao"))
        {
                write(CYN + name() + "忙摇头道：魔教东西不予寄售。\n" NOR);
                return 1;
        }
         if(ob->query_amount())
         {
                write(CYN + name() + "此物禁止寄售。\n" NOR);
                return 1;
         }
}
string query_save_file()
{
  // string id;

