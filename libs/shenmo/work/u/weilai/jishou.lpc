{
	int k;
	string arg;
	object me;
	me=this_player();
	if (sizeof(qiugou)<1)
		return notify_fail("没有任何人在这里寄售！ \n");

	if(!arg) arg=HIG"您在这里所求购的物品如下 \n"NOR;
	for(k=0;k<sizeof(qiugou);k++)
	{
		if(qiugou[k]["wuzhu"]==me->query("id"))
			arg+=sprintf("（%d）%s以%d两%s的价格求购%s(%s)\n",qiugou[k]["bianhao"],qiugou[k]["zwuzhu"],qiugou[k]["jiage"],qiugou[k]["bizhong"],qiugou[k]["zwpm"],qiugou[k]["wpm"]);

	}
	write(arg);
	write("您要取回您的物品，请输入<编号> <物品名> ");
	input_to("qu_qiugoum");
	return 1;


}
