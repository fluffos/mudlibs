//weilai 2009 7.17
#include <ansi.h>
int main(object me, string arg)
{
    string brg,baoshi,zbei;//宝石和准装备
    object bao,bei;//宝石和准装备
    if(!arg)
        brg="镶嵌指令xiang 宝石 装备\n";
    else if(sscanf("%s %s",baoshi,zbei)!=2)
      brg="镶嵌指令xiang 宝石 装备\n";
    else if(objectp(bao=present("baoshi",me)))
        brg="你没有这种宝石";
    else if(objectp(bei=present("zbei",me)))
        brg="你没有这件装备";
    else if(!bei->query("sockets/max"))
        brg="你这件装备不能镶宝石";
    else if(bei->query("sockets/max")==bei->query("sockets/now")||bei->query("sockets/max")<bei->query("sockets/now"))
        brg="这件装备所有的孔都镶满了";
    if(brg)
    {
        write(brg);
        return 1;
    }
    
}
