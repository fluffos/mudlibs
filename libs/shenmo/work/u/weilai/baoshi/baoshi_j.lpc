#include <ansi.h>
inherit ITEM;
void miaosu(string name, string *id);
void set_name(string name, string *id) {
  miaosu(name, id);
}
void miaosu(string name, string *id) {
  string brg, crg;
  switch (query("ping_ji")) {
    case 0:
      brg = "次品"; crg = ""; break;
    case 1:
      brg = "下品"; crg = "1"; break;
    case 2:
      brg = HIW "中品" NOR; crg = "2"; break;
    case 3:
      brg = GRN "上品" NOR; crg = "3"; break;
    case 4:
      brg = HIG "极品" NOR; crg = "4"; break;
    case 5:
      brg = BRED "圣品" NOR; crg = "5"; break;
    default:
      brg = BMAG "超圣品" NOR; crg = "6"; break;
  }
  brg += name; crg = id[0] + crg; id[0] = crg;
  ::set_name(brg, id);
}
void sxid() {
  int b;
  string name, *id, idd;
  name = query("name");
  idd = query("id");
  name = explode(name, "品")[1];
  id = ({ "id" });
  id[0] = idd[0..(strlen(idd) - 2)];
  miaosu(name, id);
}
