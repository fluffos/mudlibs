//weilai 2009 7.18
#include <ansi.h>
inherit "/u/weilai/baoshi/baoshi_j";

void create() {
  set("ping_ji", 1);  //宝石等级
  set_name(BLINK "" HIY "暴风之眼" NOR, ({ "baofen yan" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("xqlb", "w");  //镶嵌类别T为通用，w为武器专用，f为防具专用
    set("unit", "颗");

    set("jyd", 24);  //宝石所具有的坚硬度;
    set("long", HIY "风的来源。\n" NOR);
    set("xybvalue", 5);
    set("short", "武器专用高级宝石");
  }
  setup();
}
varargs mapping zhuangbei(object armorr, int ll) {
  object ob, me, armor;
  int pj, l;
  string att;
  mapping hao;
  if (armorr)
    armor = armorr;
  if (ll)
    l = ll;
  ob = this_object();
  pj = ob->query("ping_ji");
  if (!hao)
    hao = ([]);
  if (l == 1 && objectp(armor)) {



    armor->delete("weapon_prop/cold_attack");

    if (armor->query("cold_attack")) {
      armor->delete("cold_attack");
      armor->delete("cold_attack/max_level");
      armor->delete("weapon_prop/cold_attack");
      armor->delete("cold_attack/exp");
    }
    if (armor->query("fire_attack")) {
      armor->delete("fire_attack");
      armor->delete("fire_attack/max_level");
      armor->delete("weapon_prop/fire_attack");
      armor->delete("fire_attack/exp");
    }
    if (armor->query("lightning_attack")) {
      armor->delete("lightning_attack");
      armor->delete("lightning_attack/max_level");
      armor->delete("weapon_prop/lightning_attack");
      armor->delete("lightning_attack/exp");
    }
    if (armor->query("poison_attack")) {
      armor->delete("poison_attack");
      armor->delete("poison_attack/max_level");
      armor->delete("weapon_prop/poison_attack");
      armor->delete("poison_attack/exp");
    }
    if (armor->query("wind_attack")) {
      armor->delete("wind_attack");
      armor->delete("wind_attack/max_level");
      armor->delete("weapon_prop/wind_attack");
      armor->delete("wind_attack/exp");
    }
    //////////////
    att = "wind_attack";
    //max_level=name[i][6]-random(3);//最高等级
    //if (max_level<1) max_level=1;
    armor->set((att + "/max_level"), ob->query("ping_ji") + 5);
    armor->set("weapon_prop" + "/" + att, (ob->query("ping_ji") + 5) / 2);  //当前等级
    armor->set((att + "/exp"), 0);  //经验值

    return hao;
  }

  hao += ([ "wind_attack": (ob->query("ping_ji") + 5) / 2 ]);
  return hao;
}
