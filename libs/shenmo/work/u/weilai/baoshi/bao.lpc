//weilai 2009 7.18
#include <ansi.h>
inherit "/u/weilai/baoshi/baoshi_j";

void create()
{
    set("ping_ji",1);//宝石等级
       set_name(BLINK""HIY"玄铁精石"NOR, ({"xuantie shi"}));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
            set("xqlb","t");//镶嵌类别T为通用，w为武器专用，a为防具专用
                set("unit","颗");
                
                set("jyd",6);//宝石所具有的坚硬度;
                set("long",HIY"由玄铁精魄凝聚而成，极其坚硬。\n"NOR);
        }
        setup();
}
