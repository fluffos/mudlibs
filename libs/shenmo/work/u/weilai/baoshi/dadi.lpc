#include <ansi.h>
inherit "/u/weilai/baoshi/baoshi_j";

void create()
{
    set("ping_ji",1);//宝石等级
       set_name(BLINK""HIY"大地之心"NOR, ({"dadi xin"}));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
            set("xqlb","f");//镶嵌类别T为通用，w为武器专用，f为防具专用
                set("unit","颗");
                
                set("jyd",24);//宝石所具有的坚硬度;
                set("long",HIY"传说中的支持大地的核心。\n"NOR);
             set("xybvalue", 5);
               set("short","防具专用高级宝石");
        }
        setup();
}
varargs mapping zhuangbei(object armorr,int ll)
{
    object ob,me,armor;
    int pj,l;
    mapping hao;
    if(armorr)
        armor=armorr;
    if(ll)
        l=ll;
    ob=this_object();
    pj=ob->query("ping_ji");
       if(!hao)
        hao=([]);
            if(l==1&&objectp(armor))
            {
    armor->add("armor_prop/cold_defence",2*pj);
    armor->add("armor_prop/fire_defence",2*pj);
    armor->add("armor_prop/lightning_defence",2*pj);
    armor->add("armor_prop/poison_defence",2*pj);
    armor->add("armor_prop/wind_defence",2*pj);
    return hao;
}
    
    hao+=(["armor_prop/cold_defence":2*pj,"armor_prop/fire_defence":2*pj,"armor_prop/lightning_defence":2*pj,"armor_prop/poison_defence":2*pj,"armor_prop/wind_defence":2*pj]);
    return hao;
}