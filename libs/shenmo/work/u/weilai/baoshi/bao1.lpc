#include <ansi.h>
inherit "/u/weilai/baoshi/baoshi_j";

void create()
{
    set("ping_ji",1);//宝石等级
       set_name(BLINK""HIY"暴风之眼"NOR, ({"baofen yan"}));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
            set("xqlb","w");//镶嵌类别T为通用，w为武器专用，f为防具专用
                set("unit","颗");
                
                set("jyd",5);//宝石所具有的坚硬度;
                set("long",HIY"风的来源。\n"NOR);
             set("value", 5);
              // set("short","武器专用高级宝石");
               set("shuxing","cold_attack");//cold_attack 冰；fire_attack 火；lightning_attack 电；poison_attack 毒；wind_attack 风；
        }
        setup();
}
varargs mapping zhuangbei(object armorr,int ll)
{
    object ob,me,armor;
    int pj,l;
    string att,*abb;
    mapping hao;
    if(armorr)
        armor=armorr;
    if(ll)
        l=ll;
    ob=this_object();
    pj=ob->query("ping_ji");
       if(!hao)
        hao=([]);
            if(l==1&&objectp(armor))
            {
                if(armor->query(ob->query("shuxing")))
                {
                    att=ob->query("shuxing");
                    if(armor->query(att+"/max_level")<(ob->query("ping_ji")+2))
                        armor->set((att+"/max_level"),ob->query("ping_ji")+2);
                        if(armor->query("weapon_prop"+"/"+att)<((ob->query("ping_ji")+2)/2))
                    armor->set("weapon_prop"+"/"+att,(ob->query("ping_ji")+2)/2);
    			//max_level=name[i][6]-random(3);//最高等级
			//if (max_level<1) max_level=1;

			//armor->set((att+"/exp"),0);//经验值
                   
                } else
                {
                    abb=keys(armor->query("weapon_prop"));
                    for(int i=0;i<sizeof(abb);i++)
                    {
                      if(abb[i]="cold_attack"||abb[i]="fire_attack"||abb[i]="lightning_attack"||abb[i]="poison_attack"||abb[i]="wind_attack")
                            att=abb[i];
                    }
                  armor->delete(att);                        //////////////
                  armor->delete("weapon_prop"+"/"+att);
                 // armor->delete(att+"/exp");
                  att=ob->query("shuxing");
    			//max_level=name[i][6]-random(3);//最高等级
			//if (max_level<1) max_level=1;
			armor->set((att+"/max_level"),ob->query("ping_ji")+2);
			armor->set("weapon_prop"+"/"+att,(ob->query("ping_ji")+2)/2);//当前等级
			armor->set((att+"/exp"),0);//经验值
            }
    return hao;
}
    
    hao+=([query("shuxing"):(ob->query("ping_ji")+2)/2]);
    return hao;
}