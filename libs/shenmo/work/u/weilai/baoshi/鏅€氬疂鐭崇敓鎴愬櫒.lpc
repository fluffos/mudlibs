//weilai 2009 7.18
#include <ansi.h>
inherit "/u/weilai/baoshi/baoshi_j";

void create() {
  set("ping_ji", 1);  //宝石等级
  set_name(BLINK "" HIY "普通宝石生成器" NOR, ({ "scq" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("xqlb", "t");  //镶嵌类别T为通用，w为武器专用，f为防具专用
    set("unit", "颗");

    set("jyd", 6);  //宝石所具有的坚硬度;
    set("long", HIY "由玄铁精魄凝聚而成，极其坚硬。\n" NOR);
  }
  setup();
}
void init() {
  add_action("shengcheng", "list");
}
object shengcheng() {
  object ob;
  string *shitou;
  mapping shi;
  mapping *baoshi = ({ ([
    "name": "太阳石",
    "id": "taiyang shi",
    "xqlb": "w",
    "jyd": 7,
    "long": "传说中的太阳的碎片"
  ]),
    ([ "name": "太阳石", "id": "taiyang shi", "xqlb": "w", "jyd": 7, "long": "传说中的太阳的碎片" ]),
    ([ "name": "月亮石", "id": "yueliang shi", "xqlb": "f", "jyd": 7, "long": "传说中的月亮的碎片" ]),
    ([ "name": "金刚石", "id": "jingang shi", "xqlb": "t", "jyd": 8, "long": "地球上最坚硬的物质，又叫钻石" ]),
    ([ "name": "红玛瑙", "id": "hongmanao", "xqlb": "f", "jyd": 4, "long": "常用的饰品，亦可镶嵌" ]),
    ([ "name": "玄铁精石", "id": "xuantie shi", "xqlb": "t", "jyd": 6, "long": "由玄铁精魄凝聚而成，极其坚硬" ]),
    ([ "name": "顽灵玉", "id": "wanling yu", "xqlb": "f", "jyd": 8, "long": "传说中孙悟空由此石孕育而出" ]),
    ([ "name": "五色石", "id": "wuse shi", "xqlb": "f", "jyd": 8, "long": "女娲所炼，补天之精" ]),
    ([ "name": "晶原石", "id": "jingyuan shi", "xqlb": "t", "jyd": 10, "long": "石中之石，万石指首" ])
  });
  mapping *baoshi1 = ({ ([
    "name": "烈焰石",
    "id": "lieyan shi",
    "xqlb": "w",
    "jyd": 7,
    "shuxing": "fire_attack",
    "long": "不停喷火的奇异宝石"
  ]),
    ([
      "name": "烈焰石",
      "id": "lieyan shi",
      "xqlb": "w",
      "jyd": 7,
      "shuxing": "fire_attack",
      "long": "不停喷火的奇异宝石"
    ]),
    ([
      "name": "寒冰石",
      "id": "hanbing shi",
      "xqlb": "w",
      "jyd": 7,
      "shuxing": "cold_attack",
      "long": "散发着寒气的奇异宝石"
    ]),
    ([
      "name": "蛛形石",
      "id": "zhuxing shi",
      "xqlb": "w",
      "jyd": 7,
      "shuxing": "poison_attack",
      "long": "形似蜘蛛的极毒宝石"
    ]),
    ([
      "name": "风灵石",
      "id": "fenglin shi",
      "xqlb": "w",
      "jyd": 7,
      "shuxing": "wind_attack",
      "long": "不断发出风声的奇异宝石"
    ]),
    ([
      "name": "雷石",
      "id": "lei shi",
      "xqlb": "w",
      "jyd": 7,
      "shuxing": "lightning_attack",
      "long": "传说是雷公的宝珠"
    ]),
  });

  if (random(8) > 1) {
    ob = new("/u/weilai/baoshi/bao");
    shi = baoshi[random(sizeof(baoshi))];
    shitou = keys(shi);
  } else {
    ob = new("/u/weilai/baoshi/bao1");
    shi = baoshi1[random(sizeof(baoshi1))];
    shitou = keys(shi);
  }
  for (int i = 0; i < sizeof(shitou); i++) {
    ob->set(shitou[i], shi[shitou[i]]);
  }
  ob->miaosu(shi["name"], ({ shi["id"] }));
  ob->sxid();
  //ob->set("baocun",1);
  ob->move(this_player());
  return ob;
}
