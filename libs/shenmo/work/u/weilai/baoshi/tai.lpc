// weilai 2009 7.18
#include <ansi.h>
inherit ITEM;
mapping zhichi = ([ "1000": 4, "4000": 5, "10000": 6, "20000": 7, "40000": 8 ]);
mapping valid_types = ([
  "unarmed": "拳脚",
  "sword": "剑法",
  "blade": "刀法",
  "stick": "棍法",
  "staff": "杖法",
  "throwing": "暗器",
  "force": "内功",
  "parry": "招架",
  "dodge": "轻功",
  //	"magic":	"魔法",
  "spells": "法术",
  //	"move":		"行动",
  //	"array":	"阵法",
  "whip": "鞭法",
  "spear": "枪法",
  "axe": "斧法",
  "mace": "锏法",
  "fork": "叉法",
  "rake": "钯法",
  "archery": "弓箭",
  "hammer": "锤法",
]);
mapping shuxin = ([
  "strength": "膂力",
  "courage": "胆识",
  "intelligence": "悟性",
  "spirituality": "灵性",
  "composure": "定力",
  "personality": "容貌",
  "constitution": "根骨",
  "karma": "福缘"
]);

int hecheng(string i, object *ob, object fu);
int cha2(int *a, int b);
int jilv(object tu, int lld);  //图+熟练度
void create() {
  set_name(HIM "八卦冶金炉" NOR, ({ "bagua lu" }));
  set_weight(5000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("no_get", 1);
    set("no_put", 1);
    set("long", "用来打造(dazao)装备和合成(hecheng)宝石的熔炉");
  }
}

void init() {
  add_action("do_daozao", "dazao");
  add_action("do_hecheng", "hecheng");
}
int do_daozao(string arg) {
  //  write("即将开放");
  //            return 1;
  object me, zb;
  object ob, *obb, zhu, tian, di, shen, ren, gui, tu;  //物品和五行盒
  string brg, att;
  int sld, ts, ping;  //熟练地+天伤
  int j, zjsld;
  if (!arg) return notify_fail("输入你想要用来锻造的五形盒，。\n");
  me = this_player();
  if (!objectp(ob = present(arg, me)))
    return notify_fail("你身上没有这样东西，。\n");
  if (ob->query("id") == "wuxing box")
    obb = all_inventory(ob);
  else if (ob->query("类型") && (ob->query("类型") == "zhu"))
    brg = "使用单独矿石铸造\n";
  else return notify_fail("此物不可单独铸造，。\n");
  if (arrayp(obb)) brg = "开始确认五行盒\n";
  else return notify_fail("五行盒确认失败，。\n");
  if (sizeof(obb)) brg += "正在确认五行盒\n";
  else return notify_fail("五行盒确认失败，。\n");
  brg += "五行盒分析开始\n";
  for (int i = 0; i < sizeof(obb); i++) {
    if (obb[i]->query("leixin") == "zhu")
      zhu = obb[i];
    if (obb[i]->query("leixin") == "tian")
      tian = obb[i];
    if (obb[i]->query("leixin") == "di")
      di = obb[i];
    if (obb[i]->query("leixin") == "shen")
      shen = obb[i];
    if (obb[i]->query("leixin") == "ren")
      ren = obb[i];
    if (obb[i]->query("leixin") == "gui")
      gui = obb[i];
    if (obb[i]->query("leixin") != "zhu" && obb[i]->query("daohang"))
      tu = obb[i];
  }
  if (!zhu) return notify_fail("五行盒内没有主矿。\n");
  if (!tu) return notify_fail("五行盒内没有铸造图谱。\n");
  brg += "图谱分析开始\n";
  if (tu->query("daohang") > zhu->query("daohang"))
    return notify_fail("主矿道行低于铸造图谱无法铸造。\n");
  me = this_player();
  if (!me->query("zzsld"))
    me->set("zzsld", 1);
  sld = me->query("zzsld");  //打造熟练度
  ping = jilv(tu, sld);  //得出品级
  if (tu->query("xqlb") == "w")
    zb = NEWITEMS_OB->get_weapon(me, tu->query("leixin"), ping, tu->query("daohang"), 1);
  else if (tu->query("xqlb") == "f") {
    zb = NEWITEMS_OB->get_armor(me, tu->query("leixin"), ping, tu->query("daohang"), 1);
    if (random(ping) > 3)
      zb->add("armor_prop/kee", random(ping) * 25);
    if (random(ping) > 3)
      zb->add("armor_prop/sen", random(ping) * 25);
  }
  brg += "装备初步成型\n";
  zjsld = (ping / 2);
  if (zjsld < 1) zjsld = 1;
  write("品级是" + ping);
  if (tian) {
    ts = tian->query("ping_ji") * 10;  //天伤
    if (random(sld) > 10) ts = ts + ts / 4;
    if (random(sld) > 100) ts += ts / 4;
    if (random(sld) > 500) ts += ts / 4;
    if (random(sld) > 1000) ts += ts / 5;
    if (tu->query("xqlb") == "w")
      zb->add("weapon_prop/damage", ts);
    else if (tu->query("xqlb") == "f")
      zb->add("armor_prop/damage", ts / 4);
    brg += sprintf("天矿增加%d\n", ts);
    zjsld += tian->query("ping_ji") / 2;
  }
  if (di) {
    ts = di->query("ping_ji") * 5;  //天伤
    if (random(sld) > 10) ts = ts + ts / 4;
    if (random(sld) > 100) ts += ts / 4;
    if (random(sld) > 500) ts += ts / 4;
    if (random(sld) > 1000) ts += ts / 5;
    if (tu->query("xqlb") == "w")
      zb->add("weapon_prop/armor", ts / 4);
    else if (tu->query("xqlb") == "f") {
      zb->add("armor_prop/armor", ts);
      zb->add("armor_prop/kee", ts * 2);
      zb->add("armor_prop/sen", random(ts) + ts);
    }
    brg += sprintf("地矿增加%d\n", ts);
    zjsld += di->query("ping_ji") / 2;
  }
  if (shen) {
    ts = shen->query("ping_ji") * 3;
    if (random(sld) > 10) ts = ts + ts / 2;
    if (random(sld) > 100) ts += ts / 4;
    if (random(sld) > 500) ts += ts / 4;
    if (random(sld) > 1000) ts += ts / 5;
    if (tu->query("xqlb") == "w")
      zb->add("weapon_prop/" + zb->query("skill_type"), ts);
    else if (tu->query("xqlb") == "f")
      zb->add("armor_prop/" + keys(valid_types)[random(15)], ts);
    brg += sprintf("技能增加%d\n", ts);
    zjsld += shen->query("ping_ji") / 2;
  }
  if (ren) {
    ts = ren->query("ping_ji");
    if (random(sld) > 10) ts = ts + ts / 2;
    if (random(sld) > 100) ts += ts / 4;
    if (random(sld) > 500) ts += ts / 4;
    if (random(sld) > 1000) ts += ts / 5;
    if (tu->query("xqlb") == "w")
      zb->add("weapon_prop/" + keys(shuxin)[random(7)], ts);
    if (tu->query("xqlb") == "f")
      zb->add("armor_prop/" + keys(shuxin)[random(7)], ts);
    brg += sprintf("人增加%d\n", ts);
    zjsld += ren->query("ping_ji") / 2;
  }
  if (gui) {
    ts = gui->query("ping_ji");
    if (random(sld) > 10) ts += 1;
    if (random(sld) > 100) ts += 1;
    if (random(sld) > 500) ts += 1;
    if (random(sld) > 1000) ts += 1;

    if (tu->query("xqlb") == "w") {
      if (random(3) == 1)
        zb->add("sockets/max", ts / 2);
      else zb->add("weapon_prop/luck", ts / 3);
      if (!zb->query("weapon_prop/luck"))
        zb->set("weapon_prop/luck", 1);
    } else if (tu->query("xqlb") == "f") {
      if (random(3) == 1)
        zb->add("sockets/max", ts / 2);
      else {
        {
          if (random(200) <= ts * ts) zb->set("armor_prop/cold_defence", ts * 2);  //冰系防御
          if (random(200) <= ts * ts) zb->set("armor_prop/fire_defence", ts * 2);  //火系防御
          if (random(200) <= ts * ts) zb->set("armor_prop/lightning_defence", ts * 2);  //电系防御
          if (random(200) <= ts * ts) zb->set("armor_prop/poison_defence", ts * 2);  //毒系防御
          if (random(200) <= ts * ts) zb->set("armor_prop/wind_defence", ts * 2);  //风系防御
        }
      }
    }
    brg += sprintf("鬼增加%d\n", ts);
    zjsld += gui->query("ping_ji") / 2;
  }
  if (tian) destruct(tian);
  if (di) destruct(di);
  if (shen) destruct(shen);
  if (ren) destruct(ren);
  if (gui) destruct(gui);
  destruct(tu);
  destruct(zhu);
  destruct(ob);
  write("恭喜你" + zb->query("name") + "炼制成功\n");
  message("system", HIY "千里眼" + NOR "：江湖币商店方向，肃杀之气直冲天庭，莫非又有什么神兵利器出现。\n" NOR, users());

  zb->move(me);
  brg += "武器炼制成功\n";
  if (wizardp(me))
    write(brg);
  if (zjsld < 1) zjsld = 1;
  if (zjsld > 20) zjsld = 20;
  me->add("zzsld", zjsld);
  return 1;

}
int do_hecheng(string arg) {
  object me, *ob, *oc, fu, ss;
  string brg;
  me = this_player();
  if (!arg)
    brg = "请输入您想要用于合成的宝石id";
  else if (!objectp(ss = present(arg, me)))
    brg = "你身上没有这种宝石\n";
  else if (!ss->query("ping_ji"))  //好乱//奇怪此处居然不能识别
    brg = "此物不可放进八卦炉\n";
  //     ;
  else if (present(arg, me)->query("id") == "hunmeng")
    brg = "混蒙灵石不可提炼\n";
  else {
    ob = ({});
    oc = all_inventory(me);
    for (int i = 0; i < sizeof(oc); i++) {
      if (oc[i]->query("id") == arg)
        ob += ({ oc[i] });
      if (undefinedp(fu))
        if (oc[i]->query("id") == "hecheng fu")
          fu = oc[i];
    }
    if (sizeof(ob) > 2 && inherits("/u/weilai/dazao/kuangshi", ob[1])) {

      hecheng("N", ob, fu);
      return 1;
    }
    if (sizeof(ob) < 3 && inherits("/u/weilai/dazao/kuangshi", ob[0]))
      brg = "小于3个无法熔炼提纯\n";
    if (sizeof(ob) > 1 && !inherits("/u/weilai/dazao/kuangshi", ob[1])) {
      if (!undefinedp(fu)) {
        write("您要使用合成符吗  Y 为使用 N 为不使用");
        input_to("hecheng", ob, fu);
        return 1;

      }
      hecheng("N", ob, fu);
    } else if (!brg)
      brg = "一个宝石无法合成";

  }
  if (brg)
    write(brg);
  return 1;
}

int hecheng(string i, object *ob, object fu) {
  int l;
  string a, b;
  object me;
  me = this_player();
  if (!i || i != "Y" || i != "y") {
    a = ob[0]->query("id");
    b = a[(strlen(a) - 1)..(strlen(a) - 1)];
    switch (atoi(b)) {
      case 1:
        l = 70; break;
      case 2:
        l = 50; break;
      case 3:
        l = 40; break;
      case 4:
        l = 30; break;
      case 2:
        l = 20; break;
      default:
        l = 1; break;
    }
    l += (me->query("kar") - 20) / 2;  //福源关系
    if (inherits("/u/weilai/dazao/kuangshi", ob[0]))  //矿石提炼
    {

      if (l > random(100)) {
        ob[0]->add("ping_ji", 1);
        ob[0]->sxid();
        destruct(ob[1]);
        destruct(ob[2]);
        write("你的矿石提炼成功了\n");
        return 1;
      } else {
        destruct(ob[1]);
        destruct(ob[2]);
        write("你从熔炉中捞出矿石一看，居然没什么变化\n");
        return 1;
      }
    }
    if (l > random(100))  //宝石合成
    {
      ob[0]->add("ping_ji", 1);
      ob[0]->sxid();
      ob[0]->set(
        "jyd",
        ob[0]->query("jyd") / ob[0]->query("ping_ji") * (ob[0]->query("ping_ji") + 1)
      );
      destruct(ob[1]);
      write("你的宝石合成功了\n");
    } else {
      destruct(ob[0]);
      write("很遗憾宝石合成失败了\n");

    }

  } else {
    ob[0]->add("ping_ji", 1);
    ob[0]->sxid();
    ob[0]->set(
      "jyd",
      ob[0]->query("jyd") / ob[0]->query("ping_ji") * (ob[0]->query("ping_ji") + 1)
    );
    destruct(ob[1]);
    destruct(fu);
    write("你的宝石合成功了，使用了合成符，成功率100%");
  }
  return 1;
}
int jilv(object tu, int lld)  //图+熟练度
{
  string *zhi, chi;
  int dao, *dao2, ping;
  dao = tu->query("daohang");
  dao2 = ({});
  zhi = keys(zhichi);
  for (int i = 0; i < sizeof(zhi); i++) {
    dao2 += ({ atoi(zhi[i]) });
  }
  dao = cha2(dao2, dao);
  chi = sprintf("%d", dao);
  ping = zhichi[chi];
  //  if(random(lld)<10) ping-=1;
  if (random(lld) > 10) ping += 1;
  if (random(lld) > 50) ping += 1;
  if (random(lld) > 200) ping += 1;
  return ping;
}
int cha2(int *a, int b)  //如大取大
{
  int c, d;
  if (!a || !sizeof(a)) return 0;
  for (int i = 0; i < sizeof(a); i++) {
    if (b == a[i])
      return b;

    if (b < a[i])
      c = a[i];
    else continue;
    if (i == 0)
      d = a[i];
    if (c < d)
      d = c;
  }
  return d;
}
int do_rong(string arg)  //熔炼函数
{
  if (!arg) return 1;
}
