//weilai 2009 7.18
#include <ansi.h>
inherit ITEM;
mapping baoshi = ([ "太阳石": 7, "月亮石": 7, "金刚石": 8, "红玛瑙": 4, "玄铁精石": 6, "顽灵玉"
  : 8, "五色石": 8, "晶原石": 10, "烈焰石": 7, "寒冰石": 7, "蛛形石": 7, "风灵石": 7, "雷石": 7,
  "烈焰之心": 24, "大地之心": 24, "宙斯": 24, "九幽晶玉": 24, "暴风之眼": 24 ]);
mapping ping_j = ([ "下": 1, "中": 2, "上": 3, "极": 4, "圣": 5, "超圣": 6 ]);
int do_qiao(string s, object ob, string *bss);
void create() {

  set_name(BLINK "" HIY "无敌小杠杆" NOR, ({ "xgg" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");


    set("long", HIY "无敌小杠杆，专门撬（qiao）宝石。\n" NOR);
    set("value", 500000);
  }
  setup();
}

void init() {
  add_action("qiaoshi", "qiao");
}
int qiaoshi(string arg) {
  object ob, me;
  string *bss, brg;
  me = this_player();
  if (!arg) { write("指令格式是qiao 装备id\n"); return 1; }
  if (!objectp(ob = present(arg, me))) {
    write("你没有这个装备\n"); return 1;
  }
  if (!ob->query("sockets/now")) {
    write("这个装备没有镶嵌任何宝石\n"); return 1;
  }
  brg = "你把无敌小杠杆支到" + ob->query("name") + "上面\n";
  bss = ob->query("bss");
  for (int i = 0; i < sizeof(bss); i++) {
    brg += bss[i] + "\n";
  }
  brg += "要用小杠杆撬那颗宝石呢,输入中文名字\n";
  write(brg);
  input_to("do_qiao", ob, bss);
  return 1;
}
int do_qiao(string s, object ob, string *bss) {
  string ping, bsm, *dd, *ass;  //品，宝石名
  int shan, hai;
  if (!s) return write("输入错误\n");
  dd = explode(s, "品");
  ping = dd[0];
  bsm = dd[1];
  ass = bss;
  for (int i = 0; i < sizeof(ass); i++) {
    if (strsrch(bss[i], bsm) > -1)
      if (strsrch(bss[i], ping) > -1) {
        if (ob->query("skill_type")) {
          shan = baoshi[bsm];
          hai = ping_j[ping];
          shan = shan + (shan / 2) * (hai - 1);
          ob->add("weapon_prop/damage", -shan);
        } else {
          shan = baoshi[bsm] / 2;
          hai = ping_j[ping];
          shan = shan + (shan / 2) * (hai - 1);
          ob->add("armor_prop/armor", -shan);
        }
        bss = ({});
        for (int k = 0; k < sizeof(ass); k++) {
          if (k == i)
            continue;
          bss += ({ ass[k] });

        }
        ob->set("bss", bss);
        ob->add("sockets/now", -1);
        write("小杠杆与" + bsm + "同归于尽了\n");
        destruct(this_object());
        return 1;
      }

  }
  write("找不到目标\n");
  return 1;
}
