//weilai 2009 8.21 节日数据
//为制作节日使者而做
#include <localtime.h>
mapping *shuju = ({ ([ "2009": ([
  "8.26": ([ "7.7": "七夕情人节" ]),
  "9.10": "教师节",
  "10.1": "国庆节",
  "10.3": ([ "8.15": "中秋节" ]),
  "10.26": ([ "9.9": "九九重阳节" ]),
  "12.22": "冬至日",
  "12.24": "平安夜",
  "12.25": "圣诞",
  "8.21": "礼物之神日"
]) ]) });
mapping *shuju = ({ ([ "2010": ([
  "1.1": "国庆",
  "1.22": ([ "12.8": "腊八节" ]),
  "2.4": ([ "12.21": "立春" ]),
  "2.6": ([ "12.23": "小年" ]),
  "2.13": ([ "12.30": "除夕" ]),
  "2.14": ([ "1.1": "春节" ]),
  "2.28": ([ "1.15": "元宵节" ]),
  "3.8": "妇女节",
