  "6.20": "父亲节",
  "9.10": "教师节",
  "11.11": "光棍节",
  "8.16": ([ "7.7": "七夕情人节" ]),
  "9.10": "教师节",
  "10.1": "国庆节",
  "9.22": ([ "8.15": "中秋节" ]),
  "10.16": ([ "9.9": "九九重阳节" ]),
  "12.22": "冬至日",
  "12.24": "平安夜",
  "12.25": "圣诞",
  "8.21": "礼物之神日"
]) ]) });
mixed jr_cha(int a)  //a=1,今日节日，a=2下次节日
{
  int jday, jyear, jyue;  //天，年，月
  string day, year, yue, yueri, *jrrq;  //节日日期
  mapping nian, nian1;
  mixed huizhi;
  int *y, *r, yy, rr, yy1;
  jyear = localtime(time())[LT_YEAR];
  jyue = localtime(time())[LT_MON] + 1;
  jday = localtime(time())[LT_MDAY];
  year = sprintf("%d", jyear);
  yueri = sprintf("%d.%d", jyue, jday);
  nian1 = shuju[0];
  nian = nian1[year];
  jrrq = keys(nian);
  if (a == 1)
    for (int i = 0; i < sizeof(jrrq); i++) {
      if (yueri == jrrq[i]) {
        huizhi = ([ sprintf("%d月%d日", jyue, jday): nian[yueri] ]);
        return huizhi;
      }
    }
  if (a == 2) {
    y = ({});
    r = ({});

    for (int i = 0; i < sizeof(jrrq); i++) {
      sscanf(jrrq[i], "%d.%d", yy, rr);

      if (yy < jyue) continue;
      if (yy == jyue)
        if (rr <= jday)
          continue;
      if (!yy1) yy1 = yy;
      if (yy1 > yy) yy1 = yy;
    }
    for (int i = 0; i < sizeof(jrrq); i++) {
      sscanf(jrrq[i], "%d.%d", yy, rr);

      if (yy != yy1) continue;
      if (yy == jyue)
        if (rr <= jday)
          continue;
      r += ({ rr });
    }
    rr = r[0];
    for (int i = 0; i < sizeof(r); i++) {

      if (rr > r[i])
        rr = r[i];
    }
    yy = yy1;

    yueri = sprintf("%d.%d", yy, rr);
    for (int i = 0; i < sizeof(jrrq); i++) {
      if (yueri == jrrq[i]) {

        huizhi = ([ sprintf("%d月%d日", yy, rr): nian[yueri] ]);
        //huizhi=nian[yueri];
        return huizhi;
      }
    }
  }
  return 0;
}
