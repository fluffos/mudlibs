//weilai 8.21
inherit NPC;
#include "/u/weilai/liwu/jrsj.lpc"
int do_liwu();
int do_liwux();
int do_zui();
void create()
{
	set_name("礼物之神", ({"jieri"}));
	set("title", "使者");
	set("gender", "男性");
	set("age", 35);
	set("kee", 350); 
	set("max_kee", 350);
   set("combat_exp",10000);
   set("daoxing",10000);
	set("sen", 200);
	set("max_sen", 200);	
	set("combat_exp", 10000);
	set("attitude", "friendly");
	set("env/wimpy", 50);
	set("chat_chance", 10);

	set_skill("unarmed", 40);
	set_skill("dodge", 40);
         set("inquiry", ([
"节日礼物":(:do_liwu:),
"节日介绍":(:do_liwu:),
"下次礼物领取时间":(:do_liwux:),
                 "喝酒不醉":(:do_zui:),
                             ]) );
	setup();
        carry_object("/d/obj/cloth/choupao")->wear();
}
int do_liwux()
{
       mixed liwu,liwu2;
      // string liwu3;
       string yan,yin;
       int yue,ri;
   liwu=jr_cha(2);
   if(stringp(liwu2=liwu[keys(liwu)[0]]))
   {  command("say 下次礼物是"+keys(liwu)[0]+liwu2+"\n");
    return 1;
   }
   yin=keys(liwu2)[0];
  sscanf(yin,"%d.%d",yue,ri);
  yin=sprintf("%d月%s%d",yue,ri>9?"":"初",ri);
  command("say 下次礼物是"+keys(liwu)[0]+"\n 农历"+yin+"   "+liwu2[keys(liwu2)[0]]+"\n");
    return 1;

}


int do_liwu()
{
        mixed liwu,liwu2;
       string yan,yin,jilv;
       int yue,ri,wx,dx,qn;
   liwu=jr_cha(1);
   if(!liwu)
   {
       command("say 今日没有礼物可领\n");
       return 1;
   }
 if(stringp(liwu2=liwu[keys(liwu)[0]]))
   {
     command("say 今天是"+keys(liwu)[0]+liwu2+"\n");
     jilv=liwu2;
   }
   if(mapp(liwu2))
   {
       yin=keys(liwu2)[0];jilv=yin;
  sscanf(yin,"%d.%d",yue,ri);
  yin=sprintf("%d月%s%d",yue,ri>9?"":"初",ri);
  //jilv="今天是"+keys(liwu)[0]+"\n 农历"+yin+"   "+liwu2[keys(liwu2)[0]]+"\n";
  command("say 今天是"+keys(liwu)[0]+"\n 农历"+yin+"   "+liwu2[keys(liwu2)[0]]+"\n");

   }
   if(this_player()->query("jrliwu")==jilv)
   {
        command("say 你已经领过礼物了\n");
        return 1;
   }
   dx=to_int(sqrt(to_float(this_player()->query("daoxing"))));
   wx=to_int(sqrt(to_float(this_player()->query("combat_exp"))));
   qn=to_int(sqrt(to_float(this_player()->query("potential"))));
   dx+=10000;
   wx+=10000;
   qn+=1000;
   dx*=3;
   wx*=3;
   qn*=3;
  command("say 你获得了"+jilv+"大礼包\n");
  this_player()->add("daoxing",dx);
  this_player()->add("combat_exp",wx);
   this_player()->add("potential",qn);
  write("你增加了\n"+chinese_number(wx)+"武学\n"+COMBAT_D->chinese_daoxing(dx)+"道行\n"+chinese_number(qn)+"潜能\n");
  //this_player()->delete("jrliwu");
  this_player()->set("jrliwu",jilv);
  return 1;

}
int do_zui()
{
    int s;
    object ls;
    if((query("zui")+600)<time())
    {
     if( !ls=find_object("/cmds/imm/update"))
         {write("更新失败\n");return 1;}
     if(ls->main(this_object(),"/daemon/condition/drunk"))
   {write("喝酒更新成功\n");set("zui",time());return 1;}
     else{write("喝酒更新失败\n");return 1;}
    }
    write("不可频繁更新\n");return 1;
}
