int main(object me, string arg)
{
	int d,y,l,qm,time;
	string str,*dia,*shixia,*shixi;
	mapping shixiao;

	
	
	if(me->query("xyb")||me->query("xjsy"))
	{
		str="你的西游币物品使用情况为\n";
