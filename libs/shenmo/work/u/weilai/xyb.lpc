	if(y) str+=sprintf(HIR"研究总加速"HIY"%d%s  "NOR,y,"%");
	if(l) str+=sprintf(HIR"练习总加速"HIY"%d%s  "NOR,l,"%");
	if(qm) str+=sprintf(HIR"师门总加速"HIY"%d%s  "NOR,qm,"%");
	*/
	if(str)
str+=".\n";
	if(str)
	tell_object(me,str);
	return 1;

		
}
	
