	if(me->query("xyb"))
	{
		//time=time();
	
		shixiao=me->query("xyb");
		shixia=keys(shixiao);
		shixi=shixia;
		for(int k=0;k<sizeof(shixiao);k++)
        {
			if(shixiao[shixi[k]]<1)
				shixia-=({shixi[k]});
		}
		if(sizeof(shixia)>0)
		{	//if(!str)  str="您目前\n";
			for(int i=0;i<sizeof(shixia);i++)
			{
				for(int z=0;z<sizeof(all_wuping);z++)
				{
					if(shixia[i]==all_wuping[z]["id"])
					{	
						str+=sprintf(HIG"您使用了%s，"HIY"%d"HIG"，剩余时长为"HIY"%d"HIG"分钟\n"NOR,HIW+all_wuping[z]["name"]+NOR,
					    HIC+all_wuping[z]["zuoyong"]+HIG,shixiao[all_wuping[z]["id"]]=="xyb/xinyunbao"?"无限":(shixiao[all_wuping[z]["id"]]-time())/60);
					/*if(all_wuping[z]["zuoyong"]=="读书")
						d+=all_wuping[z]["xiaoguo"];
					if(all_wuping[z]["zuoyong"]=="练习")
						l+=all_wuping[z]["xiaoguo"];
					if(all_wuping[z]["zuoyong"]=="研究")
						y+=all_wuping[z]["xiaoguo"];
					if(all_wuping[z]["zuoyong"]=="师门")
						qm+=all_wuping[z]["xiaoguo"];
                                                 */
					}
