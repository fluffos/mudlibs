#include <ansi.h>
inherit NPC;
void create() {
  set_name("主管", ({ "guanli", "guan" }));
  set("age", 72);
  set("gender", "男性");
  set("long",
    "这个人是帮派主管．\n");
  set("title", "虽然没得交椅坐，实权在握人人怕");
  set("attitude", "friendly");
  set("max_kee", 800);
  set("max_sen", 700);
  set("combat_exp", 100000);
  set("daoxing", 50000);

  set("shen_type", 1);
  set("max_force", 300);
  set("force", 300);
  set("force_factor", 15);
  set_skill("unarmed", 100);
  set_skill("changquan", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  map_skill("unarmed", "changquan");
  set("chat_chance", 1);
  set("inquiry", ([
    "name": "虽然没得交椅坐，实权在握人人怕。\n",
  ]));
  setup();
  carry_object("/d/obj/cloth/choupao")->wear();
  carry_object("/d/obj/book/quanjing");
}
