#define JHB HIG"西游币"NOR
#define GXSJ 86400
#define GOLD_COST  1000
inherit NPC;
inherit F_SAVE;
inherit "/u/weilai/bangpai/jzfw.lpc";
int me_jiantan();//建总坛
int qu_huibang();//回帮派
int qu_jieshao();
int notify_fail(string ss);
