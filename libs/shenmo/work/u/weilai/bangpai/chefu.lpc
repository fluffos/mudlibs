{
        set_name("帮派车夫", ({"chefu"}));
        set("kaifa",38);
        set("jizhi",46);
        set("shen_type", 1);
        set("gender", "男性");
        set("age", 45);
        set("long",
                HIY"横眉冷对千夫指
                    俯首甘为孺子牛\n"NOR);
        set_skill("unarmed", 5000);
        set_skill("dodge", 5000);
        set_temp("apply/damage", 1500);
        set("combat_exp", 4000000);
        set("attitude", "friendly");
		set("no_clean_up",1);
  

    
        setup();
		
    //    carry_object("/clone/misc/changpao")->wear();
                restore();
                 set("inquiry", ([
"我要买地皮":(:me_jiantan:),
//"我要去其他帮派":(:me_qu:),
"帮派介绍":(:qu_jieshao:),
"我要回帮":(:qu_huibang:),
//"取回所得金钱和物品":(:qu_qian:),
                             ]) );
}
void init()
{
    //add_action("do_buy", "");
      //  add_action("do_buy", "buy");
	//	 add_action("do_qiugou", "qiugou");
                  add_action("qu_huibang", "home");

}
int me_jiantan()//建总坛
{
    mapping *bang;
    object me,gold;
    mixed *bangh;
    string file2,bh;
      me=this_player();
     if(! (bangh=me->query("banghui")))
        return notify_fail("你还没有帮会呢。\n");
  gold = present("gold_money",me);
        if(!gold) return notify_fail("你身上没有金子。\n");
        if((int) gold->query_amount() < GOLD_COST)
        return notify_fail("你身上没有"+chinese_number(GOLD_COST)+"两金子。\n");
  gold->add_amount(-GOLD_COST);
  //好了开始建房吧
  bangh=get_dir("/u/bangpai/");
  if(chaxun(bangh,me->query("banghui")))
  {
      write("你获得了批准，去帮派里面修建去吧");
      me->add("jianf",1);
      return 1;
  }
mkdir("/u/bangpai/"+me->query("banghui"));
file2=read_file("/u/weilai/bangpai/juyi.lpc");
bh="/u/bangpai/"+me->query("banghui")+"/"+"juyi.lpc";
write_file(bh,file2);
write("帮派地址选好了");
bang=query("bpjl");//帮派记录
if(!bang)
  set("bpjl/"+me->query("banghui")+"/dizhi","u/bangpai/"+me->query("banghui")+"/juyi.lpc");//加入帮派路径记录
else
 add("bpjl/"+me->query("banghui")+"/dizhi","u/bangpai/"+me->query("banghui")+"/juyi.lpc");//加入帮派路径记录
save();
  return 1;
}
int qu_huibang()//回帮派
{
    object me;
    string banghui,*bpjl;
     me=this_player();
    if(! (banghui=me->query("banghui")))
        return notify_fail("你还没有帮会呢。\n");
     if(!query("bpjl"))
           return notify_fail("你还没有帮会还没有买地皮呢。\n");
     bpjl=keys(query("bpjl"));
   for(int i=0;i<sizeof(bpjl);i++)
     {
         if(banghui==bpjl[i])
         {   me->move(query("bpjl/"+bpjl[i]+"/"+"dizhi"));
         return 1;
         }
     }
     write("没有你的帮派");
     return 1;
}
int qu_jieshao()
{
        object me;
    string banghui,*bpjl,brg;
     me=this_player();
     if(!query("bpjl"))
     {
           write("目前没有帮会。\n");
           return 1;
     }
           bpjl=keys(query("bpjl"));
     brg=HIR"猴王传奇帮派如下\n"NOR;
     for(int i=0;i<sizeof(bpjl);i++)
         brg+=bpjl[i]+"\n";
     write(brg);
     return 1;
}
int notify_fail(string ss)
{
    write(ss);
    return 1;
}
string query_save_file()
{
  // string id;

  // if( !stringp(id = query("name")) ) return 0;
   return DATA_DIR + "chefu";
}