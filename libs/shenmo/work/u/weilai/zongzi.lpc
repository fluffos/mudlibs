#include <localtime.h>
#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
int do_chop(string arg);
void create() {
  set_name("精致的粽子", ({ "zongzi" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个墨绿色的粽子叶包成的粽子，远远的便能闻到一阵清香。\n");
    set("unit", "个");
    set("value", 1);
    set("food_remaining", 3);
    set("food_supply", 50);
  }
}

void init() {
  add_action("do_chop", "eat");
}
int do_chop(string arg) {
  mixed *lt;
  object me;
  int exp, pot;
  if (!arg || arg != "zongzi")
    return 0;
  me = this_player();
  lt = localtime(time());
  if (me->query("jieri/zongzi") == lt[LT_YEAR]) {
    write("你今年已经吃过精致的粽子了，再吃也不会有什么明显的效果的\n");
    return 1;
  }
  exp = 10000 + me->query("combat_exp") / 100;
  pot = 1000 + me->query("potential") / 100;
  me->add("combat_exp", exp);
  me->add("potential", pot);
  me->set("jieri/zongzi", lt[LT_YEAR]);
  tell_object(me, sprintf(HIY "你感觉浑身一阵清凉，\n增加了%d武学，%d点潜能值。\n" NOR, exp, pot));
  destruct(this_object());
  return 1;
}
