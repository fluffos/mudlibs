#include <localtime.h>
#include <ansi.h>
inherit ITEM;
int do_chop(string arg);
void create()
{
	set_name("幸运宝符", ({"xingyunbao"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "点燃(shao)幸运宝符，幸运长相随，\n李靖任务每轮最后一个有几率掉宝。\n");
                set("unit", "个");
                set("xybvalue", 10);
                set("short","一次使用，终生有效，幸运掉宝");
 
        }
}

void init()
{
 add_action("do_chop","shao");
}
int do_chop(string arg)
{
    object me,ob;
    if(arg!=query("id"))
    {
        write("你要烧什么");
        return 1;
    }
    me=this_player();
         me->set("xyb/xinyunbao",1);

     write("幸运宝符化为一阵青烟，笼罩在你的身旁\n");
   destruct(this_object());
   return 1;
}