return notify_fail("提取失败\n");

   cwxkw=me->query("cwxkw");
   cwxkw+=({d});
  

map_delete(cwx,wpqd[i]);
if(!ob->query_amount())*/
          //if(new(base_name(ob))->query_entire_dbase()!=ob->query_entire_dbase())
