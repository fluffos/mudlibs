#include <ansi.h>
inherit ITEM;
int compare_mapping(mapping m1, mapping m2);
int compare_array(mixed *a1, mixed *a2);
void create() {
  set_name("矿石袋", ({ "kuangshi dai" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "矿石袋：
			kan 查看袋内物品
			fang  存东西
			nachu  取东西
			//kan    查看所剩物品格和召唤柜所剩时间。\n");
    set("unit", "个");
  }
  set("no_sell", "这么神奇的东西可不敢收？");
  set("value", 5000000);
  set("xybvalue", 5);
  set("no_drop", "乱扔东西可是犯法的");
  set("xinhao", 6);
  set("changed", 1);
  set("unbreak", 1);
}
void init() {
  add_action("do_list", "kan");
  add_action("do_chun", "fang");
  add_action("qu", "nachu");
  add_action("kwei", "chakan");

}

