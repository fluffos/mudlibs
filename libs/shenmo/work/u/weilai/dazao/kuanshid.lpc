    if (query("xinhao") <= sizeof(ks) - 1)
      return notify_fail("你的矿石袋满了！\n");

    for (int k = 0; k < sizeof(ks); k++) {
      sss = explode(ks[k], " ");
      if (sizeof(sss) > 2)
        for (int c = 2; c < sizeof(sss); c++) {
          if (!ss)
            ss = sss[c];  //取id部分
            else
