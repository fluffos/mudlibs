    for (int i = 1; i < query("xinhao"); i++)  //根据型号寻数
    {
      for (int j = 0; j < sizeof(query("shuzi")); j++) {
        if (i == shuziz[j]) {
          pan = 1; break;
        }
      }
      if (pan == 3) pan = 2;
      if (pan == 1) pan = 3;
      if (pan == 2)  //可以用它
      {
        if (!arrayp(shuziz))
          shuziz = ({ i });
        else shuziz += ({ i });
        set("shuzi", shuziz);
        bianhao = i;
        break;
      }

    } else { bianhao = 1; shuziz = ({ 1 }); }

