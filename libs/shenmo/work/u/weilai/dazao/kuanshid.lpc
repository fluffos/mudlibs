int do_list() {
  object me, oc;
  int cwxsj;  // 储物箱时间
  string *cwxkw, *wpqd, msg;  //储物箱存储物品编号
  mapping cwx, cwxx, xxxx;  //储物箱
  me = this_player();
  oc = this_object();
  //////////
  /*if(oc->query("wuzhu")!=me->query("id"))
{
	return notify_fail("别人的东西你捡来干什么？\n");
}
 */
  if (!me->is_busy())
    me->start_busy(1);
  /*if(!me->query("cwxsj"))
return notify_fail("你还没购买储物箱了？\n");
if(me->query("cwxsj")<time())
return notify_fail("你的储物箱到期了\n");*/
  cwx = query("kuangshi");
  if (sizeof(cwx) < 1)
    return notify_fail("你的矿石袋空无一物\n");
  wpqd = sort_array(keys(cwx), 1);
  msg = "这是您矿石袋的物品清单：\n";
  for (int i = 0; i < sizeof(wpqd); i++) {
    msg += sprintf("%s         [%d]\n", wpqd[i], cwx[wpqd[i]]["shul"]);
  }

  write(msg);
  return 1;
}

