//weilai 2009 7.18
#include <ansi.h>
inherit "/u/weilai/dazao/kuangshi";
inherit ITEM;
int cha2(int *a, int b);
varargs void miaosu(int a);
void create() {
  //set("ping_ji",1);//宝石等级
  set_name(HIY "鸿蒙灵石" NOR, ({ "hunmeng" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("leixin", "zhu");  //矿石类型
    set("daohang", 1000);  //可用于道行万年以上
    set("unit", "块");
    //   set("long",HIY"承天地造化之气而生/n可衍化万物的鸿蒙灵石\n"NOR);
    set("xybvalue", 5);
    set("value", 1);
    //set("long",HIG"可用来铸造"+query("daohang")+"年装备\n"NOR);

  }
  setup();
}
varargs void miaosu(int a) {
  int *daohang2;
  daohang2 = ({
    50,
    100,
    200,
    500,
    1000,
    2000,
    4000,
    6000,
    10000,
    15000,
    20000,
    25000,
    30000,
    35000,
    40000
  });
  if (!a || a < 0 || a > 100000) {
    if (random(100) == 1)
      set("daohang", daohang2[random(sizeof(daohang2) - 1)]);
    else
      set("daohang", daohang2[random(sizeof(daohang2) - 5)]);
  } else {
    a = cha2(daohang2, a);
    set("daohang", a);
  }
  set("long", HIG "可用来铸造" + query("daohang") + "年装备\n" NOR);
}
int cha2(int *a, int b) {
  int c, d;
  if (!a || !sizeof(a)) return 0;
  for (int i = 0; i < sizeof(a); i++) {
    if (b == a[i])
      return b;
    if (i > 1)
      if (b < a[i])
        return a[i - 1];


  }
  return 0;
}
