//Cracked by Roath

inherit ITEM;
void create() {
        set_name("五行盒", ({ "wuxing box"}) );
        set_weight(100);
        set_max_encumbrance(10000);
        if( clonep() )                 set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("value", 100000);
        }
      set("max_items",1);
}
int is_container() { return 1; }

void init() {
  add_action("do_put","put");
  add_action("do_look","look");
}
int do_put(string arg)
{
    string target, item;
    object dest, *inv,wup,me=this_player();

    if(!arg) return 0;

    if( sscanf(arg, "%s in %s", item, target)!=2 )
           return 0;

    if (wup=present(item,me))
        if(!wup->query("leixin"))
        {
            write("此物不能放入五行盒\n");
            return 1;
        }
    if(!objectp(wup))
        return 0;
    dest = present(target, me);
   if (dest!=this_object()) return 0;

    inv = all_inventory(dest);
    if (sizeof(inv)>6) {
       write("五行盒已经装满。\n");
       return 1;
    }
  for(int i=0;i<sizeof(inv);i++)
    {
        if(inv[i]->query("leixin")==wup->query("leixin"))
        {
            write("五行盒内已有"+wup->query("name")+"\n");
            return 1;
        }
 if(wup->query("daohang")&&wup->query("leixin")!="zhu")
 {
   if( inv[i]->query("daohang")&&inv[i]->query("leixin")!="zhu")
   {write("五行盒中已有图谱\n");return 1;}
 }
    }
    return 0;
}
int do_look(string arg)
{
    object dest,*inv;
    string brg,zhu,tian,di,shen,ren,gui,tu;
if(arg!="wuxing box")
 {write("不\n");return 0;}
  dest = present(arg, this_player());
   if (dest!=this_object()) {write("不得能\n");return 0;}
inv = all_inventory(dest);
if(!inv) {write("不得\n");return 0;}
brg="五行盒内物品如下\n";
for(int i=0;i<sizeof(inv);i++)
{
    if(inv[i]->query("leixin")=="zhu")
        zhu=inv[i]->query("name")+"("+inv[i]->query("id")+")"+"                   类型： 主  道行："+inv[i]->query("daohang")+"\n";
       if(inv[i]->query("leixin")=="tian")
        tian=inv[i]->query("name")+"("+inv[i]->query("id")+")"+"        类型：天  品质："+inv[i]->query("ping_ji")+"\n";
          if(inv[i]->query("leixin")=="di")
        di=inv[i]->query("name")+"("+inv[i]->query("id")+")"+"          类型：地  品质："+inv[i]->query("ping_ji")+"\n";
          if(inv[i]->query("leixin")=="shen")
        shen=inv[i]->query("name")+"("+inv[i]->query("id")+")"+"            类型：神  品质："+inv[i]->query("ping_ji")+"\n";
          if(inv[i]->query("leixin")=="ren")
        ren=inv[i]->query("name")+"("+inv[i]->query("id")+")"+"       类型： 人  品质："+inv[i]->query("ping_ji")+"\n";
          if(inv[i]->query("leixin")=="gui")
        gui=inv[i]->query("name")+"("+inv[i]->query("id")+")"+"        类型： 鬼  品质："+inv[i]->query("ping_ji")+"\n";
    if(inv[i]->query("leixin")!="zhu"&&inv[i]->query("daohang"))
          tu=inv[i]->query("name")+"("+inv[i]->query("id")+")"+"        类型： "+inv[i]->query("leixin")+"  道行："+inv[i]->query("daohang")+"\n";

}
if(tu)   brg+=tu;
if(zhu)  brg+=zhu;
if(tian) brg+=tian;
if(di)   brg+=di;
if(shen) brg+=shen;
if(ren)  brg+=ren;
if(gui)  brg+=gui;
write(brg);
return 1;
}