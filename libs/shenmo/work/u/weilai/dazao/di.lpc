#include <ansi.h>
inherit "/u/weilai/dazao/kuangshi";
inherit "/u/weilai/baoshi/baoshi_j";
void create()
{
   set("ping_ji",1);//宝石等级
       set_name(BLINK""HIY"地玄彩矿"NOR, ({"dixuan kuang"}));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
            set("leixin","di");//矿石类型
         //   set("daohang",10000);//可用于道行万年以上
                set("unit","块");
                set("long",HIG"蕴大地之灵气 闪烁着五彩光芒的地玄彩矿\n\n"NOR+HIY"           五灵矿石之"+HIG"地"HIY+"矿\n"NOR);
             set("xybvalue", 2);
             set("value",500);
          //     set("short","装备铸造之辅助矿石");
        }
        setup();
}
