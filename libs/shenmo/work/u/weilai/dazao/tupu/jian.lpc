#include <ansi.h>
//inherit "/u/weilai/dazao/kuangshi";
//inherit "/u/weilai/baoshi/baoshi_j";
inherit ITEM;
void create()
{

       set_name(BLINK""HIY"铸造图谱"NOR, ({"tupu"}));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
            set("leixin","sword");//矿石类型
            set("daohang",10000);//可用于道行万年以上
                set("unit","块");
            //
             set("xybvalue", 5);
             set("value",500000);
             set("short","装备铸造之铸造图谱\n");
             set("xqlb","w");//借用宝石属性
               
        }
        setup();
}
void miaosu()
{
     set("long",HIG"可用来铸造"+query("daohang")+"年"+query("leixin")+"\n"NOR);
}