         int vawue(int s,string xx)
         {
         int ss;
         if(xx=="gold")
         {
          if(s<=10000)
              ss=s*(JG/10000)*DZ/10;
         if(s>10000)
             ss=3*s*(JG/10000)*DZ/10/2;
          if(ss<100) ss=100;
         }
         if(xx=="xyb")
         {
          if(s<10000)
              ss=s/700;
          if(s>=10000)
              ss=2+s/1000;
         }
         if(ss<=0) ss=1;
         return ss;
         }
