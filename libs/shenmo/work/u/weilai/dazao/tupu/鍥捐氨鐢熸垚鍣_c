 int cha(int *a,int b)
 {
     if(!a||!sizeof(a)) return 0;
     for(int i=0;i<sizeof(a);i++)
     {
         if(b==a[i])
             return 1;
     }
     return 0;
 }
  int cha2(int *a,int b)
 {
      int c,d;
     if(!a||!sizeof(a)) return 0;
     for(int i=0;i<sizeof(a);i++)
     {
         if(b==a[i])
             return b;
         if(i>1)
         if(b<a[i])
             return a[i-1];


     }
     return 0;
 }
