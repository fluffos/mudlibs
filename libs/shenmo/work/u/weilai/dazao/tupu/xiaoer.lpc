#include <ansi.h>
inherit "/u/weilai/dazao/tupu/图谱生成器";
void create()
{

       set_name(HIR"奸商"NOR, ({"jian shang","xiaoer","jian","waiter","er"}));
       set("shop_id",({"waiter","xiaoer","xiao","er"}));
       set("title",HIG"铸造图谱"NOR);
       set("gender", "男性");
        set("combat_exp", 1000);
       set("age", 26);
       set("per", 14);
       set("attitude", "friendly");
       set("shen_type", 1);
       set_skill("unarmed", 10);
       set("max_price",20);
        set("vendor_goods", ({
         __DIR__"obj/baijinka",
         __DIR__"obj/dan",
         __DIR__"obj/drum",
         __DIR__"obj/xjsy",
          __DIR__"obj/diaobao",
                 __DIR__"obj/鉴定符",
                        __DIR__"obj/jiechu",
                 __DIR__"obj/renwuka",
                 __DIR__"obj/miaosu",
                  __DIR__"obj/dadi",
                 __DIR__"obj/baofen",
                 __DIR__"obj/zhuangbei",
                 __DIR__"obj/bing",
                 __DIR__"obj/liehuo",
                 __DIR__"obj/lei",
               //  __DIR__"obj/panlong",
                   __DIR__"obj/gdb",
                 __DIR__"obj/tianfu",
                  __DIR__"obj/kuanshid",
                 
        }) );

        if( clonep() ) CHANNEL_D->register_relay_channel("rumor");
       setup();

       carry_object("/d/obj/cloth/linen")->wear();
}
void init()
{
  add_action("list","list");
   add_action("jiage","jiage");
    add_action("do_buy","buy");
}

int saysay()
{
         object ob;
        ob=this_player();
        if(!ob->query("lxqxyb")||wizardp(ob))
        {
           command("tell "+ob->query("id")+" 获得西游币可联系飘渺笑\n查询本店商品可使用list");
        }else{
            command("say 查询本店商品可使用list");
        }
}



