// storyd.c

#include <ansi.h>

inherit F_DBASE;
// 更新time
#define SXTIME 120
void create() {
  seteuid(ROOT_UID);
  set("channel_id", "江湖币时间控制");
  CHANNEL_D->do_channel(this_object(), "sys", "江湖币时间控制。");
  call_out("tiaotiao", 2);
}
void tiaotiao() {
  remove_call_out("tiaotiao");
  //  call_out("tiaotiao",SXTIME);
  call_out("genxin", 0);
}
void genxin() {
  int tm;
  object *suser, ob;
  object *user = ({});
  string *sx;
  suser = children(USER_OB);
  for (int i = 0; i < sizeof(suser); i++) {
    if (suser[i]->query("lxqxyb") > 0)
      user += ({ suser[i] });
  }
  for (int k = 0; k < sizeof(user); k++) {
    if (objectp(ob = present("renwu ka", user[k])))  //  if(!ob->query("changed"))
    {
      ob->set("changed", 1);
      CHANNEL_D->do_channel(this_object(), "sys", "\n给" + user[k]->query("name") + "增加嘿嘿嘿嘿。\n");
    }
    /*
      sx=keys(user[k]->query("shixiao"));
      for(int j=0;j<sizeof(sx);j++)
      {
       if((tm=user[k]->query("shixiao")[sx[j]])>5000)
           user[k]->delete("shixiao/"+sx[j]);
       if(tm<1)
         user[k]->delete("shixiao/"+sx[j]);
       else user[k]->add("shixiao/"+sx[j],-1);
*/
  }
  CHANNEL_D->do_channel(this_object(), "sys", "\n给增加嘿嘿嘿嘿完毕。\n");
