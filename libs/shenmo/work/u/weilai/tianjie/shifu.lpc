//weilai
//九九天劫第一劫2009.10.7
/**因修为的过程不断积累着能量，当体能的能量积累到一定量的时候便会因为体内巨大的能量
 * 导致天地产生异变引发劫雷，此劫雷威力巨大，除却天生异种或累世积修肉身强悍之外无不
 * 应劫化为飞灰，为避天劫
 * 第一劫 心劫 修为的加深肉体的极限无法承受强大能量，便会由内而外产生心火逐渐焚毁
 * 然此劫未尝不是一契机，然心劫亦可强抗抵御，也可借劫重生，虽前途险阻，却可脱胎换骨
 * 修为达更高境界
*/
#include <ansi.h>
#define YJDH 30000*1000 //第一劫应劫道行
int xinjie_jie();
object wo,shifu;
int kaishi()
{
    if(wo->query("jiujie_xin/hehuan")!="n")//为入应劫列表
    {
        shifu->command("say 你修为尚浅，无灾无难.....、\n");
        return 1;
    }

    wo->command("say 师傅，徒儿身冒火光，体内能力充溢，身如炎焚，请师傅解救则个\n");
    shifu->command("say 徒儿稍等，师傅开天眼瞧瞧.....、\n");

    shifu->command("look "+wo->query("id"));
     shifu->command("say 想不得吾徒修为如此精进。竟已引发，心火焚身之劫。，，，，，想知道此劫吗。可以问为师的，\n");

     shifu->set("inquiry",([
    "何为心劫": (: xinjie_jie :)]));
     return 1;
}
int xinjie_jie()//心劫问答
{
 wo->command("say 师傅,此劫起因何来，如何渡劫呢\n");
   shifu->command("say 此劫乃是九九天劫第一劫"+HIR"心劫"NOR+"，修为的加深肉体的极限无法
   承受强大能量，便会由内而外产生心火逐渐焚毁，然此劫未尝不是一契机，
   然心劫亦可强抗抵御，也可借劫重生，虽前途险阻，却可脱胎换骨修为达
   更高境界，徒儿啊，你是想避劫还是想应劫重生，修得更高境界呢，\n");
     add_action("jiehuobi","say");
   return 1;
}
int jiehuobi(string arg)
{
   // if(!userp(this_object())) return 0;
    if(!arg)
    {
        shifu->command("say 你既沉思，便是尚未决定，此事也不急在一时，等你想好在回答为师吧\n");
        return 1;
    }
    if(strsrch(arg,"避")!=-1)
    {
        shifu->command("say 你既只想避劫，为师不勉强你，你已修得本门正宗心法\n再得为师暗中维护，必不至堕劫\n");
        return 1;
    }
     if(strsrch(arg,"应")==-1)
          {
        shifu->command("say 你叽里咕噜说些什么啊，是避，是应，想好了再回答为师吧\n");
        return 1;
    }
    shifu->command("nod "+wo->query("id"));
     shifu->command("say 徒儿啊，应劫之后，修为尽失，前因尽昧，连为师也无法帮你分毫
 是成神成魔，全凭自悟，若能重回师门便可修行师门神功，你既已意决，
 师傅便传你应劫之法。助你应劫。
 应劫之法，为凝神化形，重塑肉身，因你魂力不足，无法自行凝聚肉体，
 需借胎塑体，借腹重生，重生之体，仙骨福源，远胜今生。
 为保魂力不灭，需合欢铃收魂护魄，你去找碧瑶去借吧。
\n");
    wo->set("jiujie_xin/hehuan","n");//合欢铃
      shifu->command("say 还有什么疑问尽可问为师\n");
           shifu->set("inquiry",([
    "何为心劫": (: xinjie_jie :),
           "碧瑶是谁": "碧瑶是张小凡的爱侣，至今昏迷未醒\n若能帮她收魂聚魄成就一段姻缘\n亦是功德一件\n",
           "合欢铃": "一个宝贝，能够收魂护魄,碧瑶便是全靠它\n守的一魂才得以肉身不灭\n",]));
}
int chuanyin()//千里传音
{
    object me,shifu;
    me=this_player();
    shifu=this_object();
    write("徒儿你救活碧瑶之后，便该去找一件事关你转劫成败的重宝\n通灵宝玉\n传闻绛姝仙子有此奇珍\n");
    me->set("jiujie_xin/hehuan","y");//合欢已过
    me->set("jiujie_xin/baoyu","n");//宝玉开始
    return 1;
}