//weilai

inherit ITEM;

void create()
{
        set_name("还魂草", ({ "huanhun", "cao" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",
"神奇仙草。\n");
                
             set("unit", "棵");
        }
        setup();
}

