//weilai天劫之通灵宝玉
#include <ansi.h>
inherit ITEM;
 mapping dwsj;
//int save();
string no_dun(string arg);
int no_dinwei(object ob);
mapping cskills;
mapping valid_types = ([
	"unarmed":	"拳脚",
	"sword":	"剑法",
	"blade":	"刀法",
	"stick":	"棍法",
	"staff":		"杖法",
	"throwing":	"暗器",
	"force":	"内功",
	"parry":	"招架",
	"dodge":	"轻功",
//	"magic":	"魔法",
	"spells":	"法术",
//	"move":		"行动",
//	"array":	"阵法",
	"whip" :	"鞭法",
	"spear":	"枪法",
	"axe":          "斧法",
	"mace":         "锏法",
	"fork":		"叉法",
	"rake":		"钯法",
	"archery":	"弓箭",
	"hammer":	"锤法",
]);

void create()
{
	set_name("通灵宝玉", ({"baoyu"}));
	if (clonep())
		set_default_object(__FILE__);
	else
	{
		set("long", "通灵宝玉
			dingwei  定位
			dun     遁
			lingwu  领悟技能
			cskill  查询技能 。
      tianfu  分配天赋\n");

	}
	set("no_sell", "这么神奇的东西可不敢收？");
	set("value", 0);
	set("no_drop","不可仍掉");
        set("no_cun",1);

}
void init()
{
	add_action("do_dinwei", "dingwei");//定位
	add_action("do_dun", "dun");     //遁
	add_action("linwu_cskills", "lingwu");          //取技能
	add_action("cha_cskills", "cskill");
        add_action("do_tianfu", "tianfu");

}
int do_dinwei(string arg)
{
    object me,ob;
    string dw,dms,ss;//文件名。描述
  //  mapping dwsj;
    me=this_player();
    ob=environment(me);//
    if(!me->query("zhuanshi"))
    {
    write("尚未重生不可使用\n");
    return 1;
    }
    if(arg)
    if(stringp((ss=no_dun(arg))))
    {
       map_delete(dwsj,ss); 
    }
    if(!no_dinwei(ob))//无法定位
        return 1;
   
    dw=base_name(ob);
    dms=ob->query("short");
if(!mapp(dwsj))
    dwsj=([]);
    ///////////////////////
    dwsj+=([dms : dw]);//记录
    //////////////////////////
    write("你将记录记进宝玉中\n");
    return 1;
}
int do_dun(string arg)
{
    object me,ob;
    string ss;
    if(!stringp((ss=no_dun(arg))))
        return 1;
    me=this_player();
    //ss=keys(dwsj);
    me->move(dwsj[ss]);
    return 1;
}

int no_dinwei(object ob)
{
    if(sizeof(dwsj)>4)
    {
        write("已经定位定满啦 请输入dinwei 地点，以覆盖原有定位\n");
        return 0;
    }
    return 1;
}
string no_dun(string arg)//能遁返回
{
    object ob;
    string *ss,s,str;
    if(!dwsj)
         return s;
    //  if(ob->query("wuzhu")!=me->query("id"))
    //  return 1;
    ss=keys(dwsj);
    str="您所定位的点如下\n";
    for(int i=0;i<sizeof(ss);i++)
    {
        if(strsrch(ss[i],arg)!=-1)
        {
            s=ss[i];
            break;
        }
        str+=ss[i]+"\n";
    }
    if(!s)
    {
        
        write(str);
        return s;
    }
    return s;
}
int ji_cun()
{
  object me,ob;
  mapping jineng,jifa,baocun;
  string *jfj,*jfj1;//激发技能
    ob=this_object();
  me=environment(ob);
  if(!me) return 1;
  if(ob->query("wuzhu")!=me->query("id"))
      return 1;
 // jifa=me->query_skill_map();//激发技能
  jineng=me->query_skills();//所有技能
  jfj1=keys(jineng);//所有技能
  jfj=({});
  for(int j=0;j<sizeof(jfj1);j++)
  {
      if(SKILL_D(jfj1[j])->type()=="knowledge"||!function_exists("valid_enable", find_object(SKILL_D(jfj1[j]))))
          continue;
      jfj+=({jfj1[j]});
  }
  if(!mapp(cskills))
 cskills=([]);//必须留有扩展性//不留了
  for(int i=0;i<sizeof(jfj);i++)
  {
      cskills+=([jfj[i]:jineng[jfj[i]]]);//所保留的激发技能
  }
  return 1;
}
mapping query_baoyu_skills()
{
    return cskills;
}
int cha_cskills()//查询
{
    string sk,*jnb;
   //   if(ob->query("wuzhu")!=me->query("id"))
 //     return 1;
    if(cskills)
    sk="宝玉上刻心得如下\n";
    else    return notify_fail("宝玉上面空无一字\n");
    jnb=keys(cskills);
    for(int i=0;i<sizeof(jnb);i++)
    {
    sk+=sprintf("%s(%s)   最高可领悟到%d\n",to_chinese(jnb[i]),jnb[i],cskills[jnb[i]]);
    }
    write(sk);
    return 1;
}
int linwu_cskills(string arg)
{
    object ob,me;
 
    string *jbjn,brg;
    int zsjn,zsdj;//自身技能
   me=this_player();
    ob=this_object();
      if(ob->query("wuzhu")!=me->query("id"))
      return 1;
    if(!arg)
       return notify_fail("请输入想要领悟的技能\n");
    if(!sizeof(cskills))
        return notify_fail("宝玉上面空无一字，无法领悟\n");
    if(undefinedp(cskills[arg]))
         return notify_fail("宝玉上没有这个心得\n");
    jbjn=keys(valid_types);
    for(int i=0;i<sizeof(jbjn);i++)
    {
    if(SKILL_D(arg)->valid_enable(jbjn[i]) )
    {
        if(!zsjn=(int)me->query_skill(jbjn[i],1))
            return notify_fail("你还没有学会"+valid_types[jbjn[i]]+"无法领悟"+ to_chinese(arg)+"\n");
        zsdj=me->query_skill(arg,1);
        if(zsdj>cskills[arg])
             return notify_fail("你自身所学已超出所记心得\n");
        if(zsjn<=zsdj)
            return notify_fail("你的基础所学不够\n");
        if(zsjn>cskills[arg])
            zsjn=cskills[arg];
        me->set_skill(arg,zsjn);//领悟
        write("你领悟了"+to_chinese(arg)+"至"+zsjn+"级\n");
        return 1;
    }
    }
            write("好像有问题哟\n");
        return 1;
}
int do_tianfu(string arg)
{
    string brg,*ss,s;
    object me;
    int d;
    mapping giff;
            giff=([
	"str"		: "膂力",
	"cor"		: "胆识",
	"int"		: "悟性",
	"spi"		: "灵性",
	"cps"		: "定力",
	"per"		: "容貌",
	"con"		: "根骨",
	"kar"		: "福缘",
]);
    me=this_player();
      ss=keys(giff);
    if(!arg||sscanf(arg,"%s %d",s,d)!=2)
    {
    brg="您要增加哪个天赋呢\n";
    for(int i=0;i<sizeof(ss);i++)
    {
        brg+=ss[i]+"    "+giff[ss[i]]+"\n";
    }
    brg+="您还有"+me->query("jnfpd")+"点可供分配\n";
    write(brg+"输入指令 tianfu 天赋 点数");
    return 1;
    }
      if(d<1)
           return notify_fail("所调整的天赋点不可小于1\n");
        for(int j=0;j<sizeof(ss);j++)
    {
     if(ss[j]==s)
     {
         if(me->query("jnfpd")>=d)
         {
             me->add(s,d);
             me->add("jnfpd",-d);
             write("天赋分配成功\n");
             return 1;
         }
         else {  write("你没那么多天赋点\n"); return 1;}
     }
    }
  write("天赋输入错误"+ss[0]+"\n");

    return 1;
}



void restore()
{
	if(file_size("/data/baoyu/"+query("wuzhu")+"/baoyu.o")!=-1)
		restore_object("/data/baoyu/"+query("wuzhu")+"/baoyu.o");  //如果有记录则读取记录
}
int save()
{
   // object me;
   
	if(save_object("/data/baoyu/"+query("wuzhu")+"/baoyu"))
            return 1;
    return 0;
}
