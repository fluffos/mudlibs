//碧瑶 add weilai
//碧瑶为心劫任务角色，身携合欢铃
#include <ansi.h>
inherit NPC;
void lingdang();
void dongci();
int xinjie_cao();
int xinjie_yu();
void create() {
  set_name("绛姝仙子", ({ "xianzi" }));
  set("gender", "女性");
  set("age", 28);
  set("long", "一条碧丝额前现，万条垂下绿丝绦，\n");
  set_temp("apply/defense", 5);
  set("combat_exp", 70);
  set("str", 14);
  set("dex", 15);
  set("per", 25);
  set("con", 16);
  set("int", 15);
  set("attitude", "friendly");
  set("inquiry", ([
    "还魂草": (: xinjie_cao :),
    "通灵宝玉": (: xinjie_yu :),
  ]));

  setup();
  carry_object(__DIR__ "obj/pink_cloth.lpc")->wear();
}

int xinjie_cao() {
  object me, ob, cao;
  ob = this_object();
  me = this_player();
  if (me->query("jiujie_xin/hehuan") == "n")
    if (me->query_temp("xinjie_jiang")) {
      message_vision("$N说道：还魂草很珍贵的，你要它做什么呢\n", ob);
      message_vision("$N说道：为了救一个刚烈的女孩，为了帮一对痴情的男女\n", me);
      message_vision("$N说道：说来听听好吗\n", ob);
      message_vision("$N说道：话说当年青云门......\n", me);
      message_vision("......碧瑶以身挡剑.....\n", me);
      message_vision("......可怜碧瑶至今沉睡..\n\n", me);
      message_vision("$N泪流满面，叹道：又是一对痴情鸳鸯，又是一双可怜劳雁
唉，当年" + HIY + "神瑛侍者" + NOR + "携" + HIY + "通灵宝玉" + NOR + "转劫，亦是受尽情伤，历尽爱苦
这是回魂草，愿能救得碧瑶，使他们夫妻不在分离\n", ob);
      message_vision("$N说道：多谢仙子了\n", me);
      cao = new("u/weilai/tianjie/baoyu/obj/cao");
      cao->move(me);
      message_vision("$N给了$n一棵还魂草\n", ob, me);
      return 1;


    }
  message_vision("$N说道：还魂草可还魂救命\n", ob);
  return 1;
}
int xinjie_yu() {
  object me, ob, baoyu;
  me = this_player();
  ob = this_object();

  message_vision("$N叹道：当年" + HIY + "神瑛侍者" + NOR + "携" + HIY + "通灵宝玉" + NOR + "转劫\n受尽情伤，历尽爱苦\n", ob);
  if (me->query("jiujie_xin/baoyu") == "y")
    message_vision("$N叹道：宝玉你已到手，前途漫漫，好自为之吧\n", ob);
  if (me->query("jiujie_xin/baoyu") == "n") {
    message_vision("$N道：宝玉为女娲所遗五色石所化,具有种种神奇能力\n", ob);
    message_vision("$N道：吾与神瑛侍者转劫凡尘，荒唐演绎红楼梦，竟经宝玉记载\n", ob);
    message_vision("$N道：红楼奇作，竟是仙子所历，令人羡艳不已\n吾欲转劫，若能得此重宝，记载生平，岂非.宇间又添一传世佳作\n", me);
    message_vision("$N道：各中辛酸，满纸荒唐，何人经历何人知你既想得宝玉，吾便送你罢了。\n", ob);
    message_vision("$N道：多谢仙子割爱相赠，若将来有需吾之处必竭力相助\n", me);
    message_vision("$N道：将来世道混乱，邪魔辈出，处处危机，到时勿忘今日之诺\n", ob);
    message_vision("$N道：定守今日之诺\n", me);
    message_vision("$N给了$n一个通灵宝玉\n", ob, me);
    //开始给宝玉
    baoyu = new("/u/weilai/tianjie/baoyu/baoyu");
    baoyu->move(me);
    baoyu->set("wuzhu", me->query("id"));

    me->set("jiujie_xin/baoyu", "y");  //宝玉任务完结
    me->command("baoyu");
    message_vision("$N道：当年转劫曾借无天之力，你不妨一试\n", ob);
    me->set("jiujie_xin/wutian", "n");  //无天开启

  }
  return 1;
}
