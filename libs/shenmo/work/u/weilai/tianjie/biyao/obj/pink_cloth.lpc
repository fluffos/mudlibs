#include <armor.h>

inherit CLOTH;

void create() {
  set_name("莲衫藕裙", ({ "pink cloth", "cloth" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "淡绿色的连衫裙，淡淡莲花香，清新出凡尘。\n");
    set("unit", "件");
    set("value", 1);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/personality", 3);
    set("female_only", 1);
  }
  setup();
}
