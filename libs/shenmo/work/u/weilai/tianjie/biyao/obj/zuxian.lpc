#include <weapon.h>

inherit SWORD;

void create() {
  set_name("诛仙剑", ({ "zhuxian" }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 700);
    set("material", "steel");
    set("long", "传说中的诛仙古剑。\n");
    set("wield_msg", "$N抽出一把古朴的剑，握在手中。\n");
    set("unequip_msg", "$N放下手中的$n。\n");
    set("weapon_prop/courage", 4);


    set("grade", 10000);

    set("fengcun", 1);
    init_sword(300);
    setup();
  }

}
