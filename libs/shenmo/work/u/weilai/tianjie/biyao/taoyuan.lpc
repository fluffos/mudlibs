// taoyuan.c
//tomcat
inherit ROOM;

void create() {
  set("short", "世外桃源");
  set("long", @LONG
这里就是世外桃源。
LONG
  );
  set("outdoors", "migong");
  set("exits", ([
    "east": __DIR__ "shanlu2",
  ]));
  set("objects",
    ([  //sizeof() == 1
    __DIR__ "girl": 1,
    ]));
  setup();
}

void init() {
  object me, zhang;
  me = this_player();
  if (me->query("jiujie_xin/hehuan") == "n")  //如果在做任务
    if (me->query("jiujie_zhang"))
      if (!zhang = present("zhang xiaofan", environment(this_object()))) {
        zhang = new(__DIR__ "zhang");
        zhang->move(environment());
      }


}
