//碧瑶 add weilai
//碧瑶为心劫任务角色，身携合欢铃
#include <ansi.h>
inherit NPC;
void lingdang();
void dongci();
void create()
{
	set_name("碧瑶",({ "biyao" }) );
        set("gender", "女性" );
        set("age", 28);
	set("long", "深深沉睡美丽少女，轻纱薄翼。\n一朵莲花胸前悬\n一对铃铛腰间挂\n");
        set_temp("apply/defense", 5);
	set("combat_exp", 70);
	set("str", 14);
        set("dex", 15);
	set("per", 25);
	set("con", 90);
        set("int", 15);
        set("attitude", "friendly");
	setup();
	carry_object(__DIR__"obj/pink_cloth.lpc")->wear();
}

void init()
{
    object me,by;
    me=this_player();
    by=this_object();
    if(me->query("jiujie_xin/hehuan")=="y")
    {
         remove_call_out("lingdang");
         return;
    }
  if(!by->query("cao"))
    if(me->query("jiujie_xin/hehuan")=="n")//如果在做任务
    {
    remove_call_out("lingdang");
    call_out("lingdang",5);
      remove_call_out("dongci");
    call_out("dongci",2);
  by->set_temp("lingfu",1);
   by->unconcious();
    by->set("no_get",1);
    }
}
int do_zhai(string arg)
{
    object zhang,me;
    me=this_player();

    if(!arg)
    {
        write("想拿合欢铃，请使用zhai hehuan ling");
        return 1;
    }
        if(arg=="biyao")
        return 1;

    if(arg!="hehuan ling")
           {
        write("想拿合欢铃，请使用zhai hehuan ling");
        return 0;
    }
    write("你轻轻的俯下身去\n伸手去解碧瑶腰间的合欢铃\n");
    if(!zhang=present("zhang xiaofan",environment(this_object())))
    zhang=new(__DIR__"zhang");//弄出张小凡
  
   zhang->move(environment(this_object()));
    zhang->command("say 大胆贼人，活的不耐烦了\n");
    zhang->kill_ob(me);
    zhang->set_me(me);
    return 1;
}
void lingdang()
{
  
    remove_call_out("lingdang");
    call_out("lingdang",10);
tell_room(environment(this_object()),"叮铃叮铃，合欢铃(hehuan ling)发出轻快的响声\n");
}
void dongci()
{
    add_action("do_zhai", ({"zhai","na","get","hehuan","ling","naqi"}));
}
void huifu()
{
 
  this_object()->revive();
  remove_call_out("lingdang");
 
}