//张小凡 add weilai
//张小凡为心劫任务角色
#include <ansi.h>
inherit NPC;
  object me;
void create()
{
	set_name("张小凡",({ "zhang xiaofan" }) );
        set("gender", "男性" );
        set("age", 35);
	set("long", "。满面忧伤\n");
        set_temp("apply/defense", 5);
	set("combat_exp", 70);
	set("str", 40);
        set("dex", 40);
	set("per", 40);
	set("con", 40);
        set("int", 40);
        set("max_kee", 50000);
       set("max_gin", 10000);
       set("max_sen", 50000);
       set("force", 50000);
       set("max_force", 2500);
       set("force_factor", 150);
       set("max_mana", 2500);
       set("mana", 5000);
       set("mana_factor", 150);
       set("combat_exp", 30000000);
	set("daoxing", 30000000);
     set_skill("spells",500);
       set_skill("literate", 300);
       set_skill("unarmed", 300);
       set_skill("dodge", 300);
       set_skill("parry", 300);
	set_skill("stick", 300);
	set_skill("sword", 300);
        set_skill("qysword", 380);
        map_skill("sword", "qysword");
        //set("attitude", "friendly");
	setup();
	carry_object(__DIR__"obj/baguapao.lpc")->wear();
        carry_object(__DIR__"obj/zuxian.lpc")->wield();
}
void init()
{
  
    me=this_player();
    if(me->query("jiujie_xin/hehuan")=="n")//如果在做任务
    {
        add_action("do_give", ({"give","gei"}));
    }
}

int die()
{
    object ob;
   
    ob=this_object();
   ob->remove_all_killer();
   me->remove_all_killer();
     set("eff_kee",query("max_kee"));
     set("eff_sen",query("max_sen"));
    set("kee",query("max_kee"));
     set("sen",query("max_sen"));
      message_vision("$N跳出战圈大吼一声，且慢。\n", me);
      me->command("say 这位兄台，为何不问缘由就动手，我以手下留情，望兄台自重\n");
    message_vision("$N说道：你是何人，来此何干\n",ob);
      message_vision("$N说道：吾为御劫，特来借取合欢铃\n",me);
        message_vision("$N咬牙切齿道：御姐，合欢铃，想得美.....\n",ob);
          message_vision("$N说道：兄台万事好商量.....\n",me);
          message_vision("$N怒道：御姐.....碧瑶乃吾妻，你休想染指\n",ob);
message_vision("$N说道：御姐？兄台误会也，在下大劫降临，需借合欢铃御劫\n",me);
message_vision("$N说道：此话当真，不过合欢铃乃吾妻保命之物，万不可借，除非......\n",ob);
message_vision("$N说道：除非如何.....\n",me);
message_vision("$N说道：除非可救醒碧瑶.....\n",ob);
write("你寻思，凭我能力向"+HIR+"太上老君"+NOR+"借个金丹应该没什么问题");
message_vision("$N说道：此事包在我身上，愿兄台守诺，夫人苏醒之日，便是我借铃之时\n",me);
message_vision("$N说道：若能救醒吾妻，休说一只铃铛，便是在下性命，也随便拿去\n",ob);
me->set("jiujie_zhang",1);
return 1;
}
void unconcious()
{
    die();
}
int do_give(string arg)
{
    string target, item;
    object obj,me,ob,by;
    me=this_player();
    ob=this_object();
    if(!arg) return 0;
  if( sscanf(arg, "%s to %s", item, target)==2
	|| sscanf(arg, "%s %s", target, item)==2 );
	else return 0;
    if(item!="huanhun") return 0;
    if( !objectp(obj = present(item, me)) )
        return 0;
    message_vision("$N说道：我已找回回魂灵药，张兄喂夫人服下即可\n",me);
      message_vision("$N将回魂草递给$n\n",me,ob);
    message_vision("$N扶起碧瑶，只见还魂草化成碧雾飘进碧瑶口中\n",ob);
    destruct(obj);
    by= present("biyao", environment(ob));
    by->set("cao",1);
    by->set_heart_beat(1);
    call_out("by_say",5,by,me,ob);
    return 1;
}
int by_say(object by,object me,object ob)
{
    object hhl;
    remove_call_out("by_say");
    by->huifu();
    if(!living(by))
    {
        call_out("by_say",2,by,me,ob);
        return 1;
    }
  message_vision("$N一把抱住碧瑶，碧瑶你终于醒啦\n",ob);
   message_vision("$N对着$n道多谢救命之恩\n",by,me);
     message_vision("$N说道：还望履诺，借吾合欢铃\n",me);
      message_vision("$N说道：阁下助吾魂归，使我夫妻终得聚，合欢铃虽吾至爱，然吾以无用,且以允诺送你，就送你助你御劫吧\n",by);
     // hhl=new();//弄出合欢铃
     // hhl->move(me);
      message_vision("$N将合欢铃从腰间解下，递给$n\n",by,me);
       message_vision("$N与$n相视落泪紧紧的拥抱在一起\n",by,ob);
       message_vision("合欢铃突然化成烟雾消失了\n",me);
        message_vision("师傅的声音响起：徒儿你救活碧瑶之后，便该去找一件事关你转劫成败的重宝\n通灵宝玉\n你去女娲炼石补天之处找找\n",me);
    me->set("jiujie_xin/hehuan","y");//合欢已过
    me->set("jiujie_xin/baoyu","n");//宝玉开始
       return 1;
}
void set_me(object ob)
{
    me=ob;
}