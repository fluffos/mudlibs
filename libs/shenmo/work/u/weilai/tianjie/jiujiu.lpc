//weilai
//九九天劫第一劫2009.10.7
/**因修为的过程不断积累着能量，当体能的能量积累到一定量的时候便会因为体内巨大的能量
 * 导致天地产生异变引发劫雷，此劫雷威力巨大，除却天生异种或累世积修肉身强悍之外无不
 * 应劫化为飞灰，为避天劫
   * 第一劫 心劫 修为的加深肉体的极限无法承受强大能量，便会由内而外产生心火逐渐焚毁
 * 然此劫未尝不是一契机，然心劫亦可强抗抵御，也可借劫重生，虽前途险阻，却可脱胎换骨
 * 修为达更高境界
*/
#include <ansi.h>
inherit ITEM;
#define YJDH 30000*1000 //第一劫应劫道行
object *zaijie;//在劫众人
void tiaotiao();
int yinjie();
int quchu(object ob);
void create()
{
         seteuid(getuid());
        set_name(HIY"九九天劫系统"NOR, ({"jiujiutianjie"}) );
        CHANNEL_D->do_channel( this_object(), "sys", "天劫系统已经启动。\n");
        call_out("tiaotiao",2);
}

void tiaotiao()
{

    remove_call_out("tiaotiao");
    call_out("tiaotiao",600);
    yinjie();

}
int yinjie()//应劫
{
    string str;
    object *user,*jiezhong,ob;//劫中人
 user=children(USER_OB);
 jiezhong=filter_array(user,"quchu",this_object());
 //jiezhong(sizeof(jiezhong)-1)
 if(sizeof(jiezhong)<1) return 1;
 ob=jiezhong[random(sizeof(jiezhong)-1)];
 str=ob->query("name")+"身上冒出股股浓烟\n";
 CHANNEL_D->do_channel(ob,"rumor",str);
 zaijie=jiezhong;//加入到受劫人中
}

int quchu(object ob)//是否应劫之人
{
    if(!ob) return 0;
    if(!userp(ob)) return 0;
    if(ob->query("jiujie_xin/hehuan")=="y") return 0;//心劫已过
    if(ob->query("daoxing")<YJDH) return 0;//未达应劫标准
     if(ob->query("combat_exp")<YJDH) return 0;//未达应劫标准
    ob->set("jiujie_xin/hehuan","n");//应劫标志
    return 1;
}

