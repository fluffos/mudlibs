//七彩

inherit ROOM;
int xiaoshi();
void create ()
{
        set ("short", "能量空间");
        set ("long", @LONG

七彩缤纷的能量空间。
LONG);


        set("exits", 
        ([ 
                "up" : __DIR__"bingqipu",
        ]));

        
        setup();
call_out("xiaoshi",10);

}
int xiaoshi()
{
    object *user,me,ob;
    remove_call_out("xiaoshi");
    ob=this_object();
    user=all_inventory(ob);
    for(int i=0;i<sizeof(user);i++)
    {
        if(userp(user[i]))
        {
             call_out("xiaoshi",5,);
             return 1;
        }
    }
destruct(ob);

}


