inherit NPC;

#include <obstacle.h>
#include <ansi.h>
#include <localtime.h>
void zhuanjie(object me);
void create() {
  set_name("无天佛祖", ({ "wutian" }));
  set("title", "无法无天");
  set("long", "大智慧大法力扭转乾坤之无天佛祖。\n");
  set("gender", "男性");
  set("age", 10000);
  set("attitude", "peaceful");
  set("rank_info/self", "贫僧");
  set("rank_info/respect", "无天");
  //set("class", "bonze");
  set("str", 100);
  set("per", 100);
  set("max_kee", 100000);
  set("max_gin", 100000);
  set("max_sen", 100000);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 500);
  set("max_mana", 10000);
  set("mana", 10000);
  set("mana_factor", 500);
  set("combat_exp", 4000000);
  set("daoxing", 10000000);

  set_skill("literate", 300);
  set_skill("spells", 300);
  set_skill("buddhism", 300);
  set_skill("unarmed", 300);
  set_skill("jienan-zhi", 300);
  set_skill("dodge", 300);
  set_skill("lotusmove", 300);
  set_skill("parry", 300);
  set_skill("force", 300);
  set_skill("lotusforce", 300);
  set_skill("staff", 300);
  set_skill("lunhui-zhang", 300);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "lunhui-zhang");
  map_skill("staff", "lunhui-zhang");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "bighammer" :),
  }));
  setup();
  carry_object("/d/obj/cloth/jia_sha")->wear();
}
void init() {
  add_action("do_kill", "kill");
  add_action("do_task", "task");
  add_action("do_task2", "task2");  // for difficulty huarong 2003.7
  add_action("do_cancel", "cancel");
}

int do_kill(string arg) {
  object me, ob;
  if (!arg) return 0;
  if (arg != "wutian") return 0;

  ob = this_object();
  me = this_player();
  if (me->query("jiujie_xin/wutian") != "n")
    return 0;
  message_vision("$N道：无天 吾奉师命前来除魔快快束手就擒免得形神俱灭\n", me);
  message_vision("$N哈哈大笑道：吾法力神通可知过去未来，你来意我早以尽知\n意欲借吾之手转劫而已，殊不知异日仙凡动荡，双佛并立
为何方助力仅在一念之间，吾今日便助你，以种前因\n", ob);
  message_vision("$N道：......\n", me);
  message_vision("$N道：让吾一试汝之潜力，若不能胜吾之分身,转劫也难成气候\n", ob);
  set("dujie", me);
  return 0;
}
int die() {
  object ob, me;
  me = query("dujie");
  ob = this_object();
  ob->remove_all_killer();
  if (me)
    me->remove_all_killer();
  set("eff_kee", query("max_kee"));
  set("eff_sen", query("max_sen"));
  set("kee", query("max_kee"));
  set("sen", query("max_sen"));

  if (me->query("jiujie_xin/wutian") == "n") {
    ob->command("chat " + me->query("name") + "既能胜吾分身，吾便用元神黑莲护你转劫\n");

    zhuanjie(me);
  }
  return 1;

}
void unconcious() {
  die();
}
void zhuanjie(object me) {
  object baoyu;
  mapping skills;
  string *sk;
  if (!objectp(baoyu = present("baoyu", me)))
    me->command("baoyu");
  if (!objectp(baoyu = present("baoyu", me))) return;

  me->set("kfptf", 10);  //可分配天赋
  baoyu->ji_cun();
  baoyu->save();  //保存技能完毕
  //开始清除所有该清除的
  skills = me->query_skills();
  sk = keys(skills);
  for (int i = 0; i < sizeof(sk); i++) {
    me->delete_skill(sk[i]);  //清楚所有技能
  }
  me->delete("obstacle");  //清楚取经记录
  me->set("title", "大唐游民");                           //修改道行武学
  me->set("titlek", ({ "大唐游民" }));
  me->set("PKS", 0);
  me->set("MKS", 0);                          // 清除pk记录
  me->delete("HellZhenPass");  //地狱十八                             //
  me->delete("liwu/eat");
  me->delete("rsg_eaten");
  me->set("jsm", me->query("family/family_name"));  //旧日师门
  me->delete("family/family_name");  //清除师门
  me->delete("family");  //师门信息
  me->delete("couple");  //婚姻信息
  me->delete("score");  //婚姻信息
  me->delete("faith");  //婚姻信息
  me->delete("dntg");  //打闹天宫
  me->delete("kill");  //nkpk
  me->delete("12gong");  //12宫
  me->delete("7hai");  //12宫
  me->delete("babu");  //八部
  me->set("combat_exp", 400000);
  me->set("daoxing", 1000000);
  me->set("learned_points", 0);
  me->set("potential", 100000);
  me->set("c_potential", 0);
  me->delete("yudian");  //白素贞
  me->set("mud_age", 3600);
  me->set("jnfpd", 10);
  me->add("zhuanshi", 1);
  me->update_age();
  me->delete("betray");
  me->move("/d/city/kezhan");
  me->set("jiujie_xin/wutian", "y");
}
