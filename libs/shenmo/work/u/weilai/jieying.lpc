//weilai 8.21
inherit NPC;
#include "/u/weilai/liwu/jrsj.lpc"
int do_jieshao();
int do_xuanze(string arg);
void create()
{
	set_name("门派接引人", ({"jieying"}));
	set("title", "使者");
	set("gender", "男性");
	set("age", 35);
	set("kee", 350); 
	set("max_kee", 350);
   set("combat_exp",10000);
   set("daoxing",10000);
	set("sen", 200);
	set("max_sen", 200);	
	set("combat_exp", 10000);
	set("attitude", "friendly");
	set("env/wimpy", 50);
	set("chat_chance", 10);

	set_skill("unarmed", 40);
	set_skill("dodge", 40);
         set("inquiry", ([
"门派介绍":(:do_jieshao:),
"门派选择":(:do_xuanze:),
//"":(:do_liwux:),
                             ]) );
	setup();
        carry_object("/d/obj/cloth/choupao")->wear();
}
int do_jieshao()
{
    object me;
    me=this_player();
    if(me->query("daoxing")<1000000)
   me->command("help menpai");
    else write("请使用help menpai 查询");
    return 1;

}

varargs int do_xuan(string arg)
{
    object me;
    string *mpm,brg,crg;
 mapping diming=(["阎罗地府":"/d/death/zhengtang","东海龙宫":"/d/sea/yujie2","方寸山三星洞":"/d/lingtai/gate","盘丝洞":"/d/pansi/damen",
         "昆仑山玉虚洞":"/d/kunlun/gate","大雪山":"/d/xueshan/restroom","陷空山无底洞":"/d/qujing/wudidong/kitchen","蜀山派":"/d/shushan/paifang",
         "三界散仙":"/d/sanxian/jianzhong","火云洞":"/d/qujing/kusong/guaishiya","月宫":"/d/moon/xiaoyuan","南海普陀山":"/d/nanhai/gate","五庄观":"/d/qujing/wuzhuang/jiangjing","将军府":"/d/jjf/keting"]);
 me=this_player();
if(me->query("family/family_name"))
   crg=me->query("family/family_name");
 mpm=keys(diming);
  brg="";
 for(int i=0;i<sizeof(mpm);i++)
 {
     if(!arg&&!crg)
 {
  if(i%4||i==0)
         brg+=mpm[i]+"   ";
     else brg+=mpm[i]+"\n";
 }else
 {
         if(crg)
     if(crg==mpm[i])
    {
        me->move(diming[crg]);
        return 1;
    }
         if(arg)
    if(arg==mpm[i])
    {
        me->move(diming[arg]);
        return 1;
    }
  

 }
 }
 if(!arg&&!crg)
 {
     write(brg);
 write("\n请输入您想去的门派名称\n");
 input_to("do_xuan");
 }
 else write("您输入的门派有误\n");
 return 1;

}
int do_xuanze(string arg)
{
do_xuan();
return 1;
}