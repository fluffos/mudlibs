#include <ansi.h>
inherit ROOM;

void create ()
{
set ("short", HIY"龙之"HIC"宮殿"HIW"寝宫"NOR);
set ("long", @LONG
   一个很小的窝棚，但是给你感觉很温馨，简简单单的装饰，
营造出一份宁静，暖色的墙面，白色的地板，橘红色的沙发，
奶油色的床，一切的一切都是一手打造的，仔细瞧来，无暇和
小妖儿还在打扫里面的卫生。
LONG); //要顶格写这里

set("exits",([
	"kz" : "/d/city/kezhan",
        "out" : "/d/city/center",
	"wiz" : "/d/wiz/wizroom",
        "wuxia" : "/u/tom/room",
]));

set("objects", ([
//    "/u/snowtu/npc/fighter" : 1,    这个文件根本不存在,调用错误
//    "/d/dntg/sky/npc/moli-qing" : 1,
//    "/u/snowtu/npc/anong" : 1,
//   "/clone/money/jinbi" : 20,
//  "/newworld/city/npc/npc" : 1,
]));
set("valid_startroom", 1);
set("no_time",1);
set("no_upgrade_age",1);
set("freeze",1);
set("chat_room",1);
setup();
}

void init()
{
// 你后面有个 !me 的设置了,这里就不要再设wuxia 了
add_action("do_dig","dig");
add_action("do_bed","bed");
}

int do_bed()
{
object me = this_player();
message_vision(HIY"\n$N掀开纱帐，准备上床了。\n\n" NOR, me); 
me->move(__DIR__"bed");
message_vision(HIY"\n沙帐轻轻一动，$N钻了进来。\n" NOR, me); 
return 1;
}

int do_dig(string arg)
{
object obj;
object me = this_player();
if (!arg || !me )
	return notify_fail("你想挖什么？\n");
if ( arg=="stone" )
	{
	obj=new("/d/snowtu/obj/weapon/wuxian");
//         obj=new("/d/snowtu/obj/weapon/wuxian");
         obj=new("/d/eastway/qinling/obj/tiebox");
//          obj=new("/d/eastway/qinling/obj/tiebox");
         obj=new("/d/emei/st3");
	obj->move(me);
	message_vision(HIY"$N在地上摸索了半天，终于从草丛里翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
	}
if ( arg=="mao" )
	{
        obj=new("/d/nanhai/obj/lianhua/lianhua");
	obj->move(me);
	message_vision(HIY"$N在地上摸索了半天，终于从草丛里翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
	}
if ( arg=="zhua" )
	{
        obj=new("/u/tom/obj/jian");
	obj->move(me);
	message_vision(HIY"$N在地上摸索了半天，终于从草丛里翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
	}
if ( arg=="jinbi" )
	{
	obj=new("/clone/money/jinbi");
	obj->move(me);
	message_vision(HIY"$N在地上摸索了半天，终于从草丛里翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
	}
 return 1; 
}



