#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {

  object *inv, obj, obj1;
  int i, mypot, tapot;
  string str;

  object weapon;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「影意斩」？\n");

  //        if(!me->is_fighting())
  //                return notify_fail("「影意斩」只能在战斗中使用！\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 500)
    return notify_fail("你的精神不足，无法施用外功！\n");

  i = (int)me->query_skill("suiyu-zhang", 1);

  if (i < 150)
    return notify_fail("你的影意斩级别还不够，使用这一招不利于修身！\n");

  if (time() - (int)me->query_temp("yingyizhan_end") < 6)
    return notify_fail("[影意斩]怎么可以连续发出？\n");
  message_vision(HIW "\n$N心动、灵动、神动，无形中发出一招" + HIR "[影意斩]" + HIW "。\n\n" NOR, me, target);

  mypot = (int)me->query_skill("unarmed");
  mypot = mypot * mypot * mypot / 8 + (int)me->query("combat_exp");

  tapot = tapot + (int)target->query_skill("dodge") / 10;
  tapot = tapot * tapot * tapot / 10 + (int)target->query("combat_exp");


  if (random(mypot + tapot) > tapot || !living(target)) {

    message_vision(
      HIM "$N临空一指，霎时间天、地、物均为之无色，$n面对这个灰白的境界，口吐鲜血，为这无色的幻界增添了一抹殷红的色彩。\n\n" NOR,
      me,
      target
    );
    COMBAT_D->do_attack_damage(me, target);
    target->receive_wound("kee", random(me->query_skill("unarmed") * 2));
    COMBAT_D->report_status(target);

    if (target->query("eff_kee") < 0 || !living(target)) {
      str = target->name() + "被" + me->name() + "的影意斩力打中死穴而死。";
      CHANNEL_D->do_channel(me, "rumor", str);
      me->delete_temp("last_channel_msg");
    } else {
      if (random(5) > 1)
        message_vision(HIM "$N的掌风软绵绵的拍在$n的太阴穴上，$n登时浑身血脉阻涨动弹不得。\n" NOR, me, target);
      target->start_busy(5 + random(3));
    }

  }

  else {
    message_vision(HIY "$N看出其中的破绽，跌跌撞撞的躲开了！\n" NOR, target);
    me->start_busy(2);
  }

  me->add("force", -50);
  me->receive_damage("sen", 50);
  me->set_temp("yingyizhan_end", time());
  return 1;
}
