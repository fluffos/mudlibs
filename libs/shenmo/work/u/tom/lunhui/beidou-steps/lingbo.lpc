// 凌波微步 
// By Cigar 2002.04.22
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("你一个人跳甚么？\n");

  if ((int)me->query_skill("huxiaolunhui-force", 1) < 100)
    return notify_fail(HIY "你的呼啸轮回心法修为不够。\n" NOR);

  if ((int)me->query_skill("beidou-steps", 1) < 100)
    return notify_fail(HIY "你的反北斗阵法不够熟练。\n" NOR);

  if ((int)me->query("force") < 400)
    return notify_fail(HIY "你现在真气不足。\n" HIY);

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");

  if (me->query("gender") == "男性") {
    msg = YEL
      "$N提起真气，意态飘逸,一招凌波微步,如入无人之境！\n" NOR;
  } else {
    msg = YEL
      "$N提起真气，施展凌波微步，仿如洛神再生，仙女下凡！\n" NOR;
  }

  if (me->query("combat_exp") * 2 > random((int)target->query("combat_exp"))) {
    msg += HIW "结果$p被$P的舞步吓得目瞪口呆！\n" NOR;
    target->start_busy(4);
    me->add("force", -100);
  } else {
    msg += "$p只是勉强的逃了开去。\n";
    me->add("force", -100);
    me->start_busy(2);
  }
  message_vision(msg, me, target);

  return 1;
}
