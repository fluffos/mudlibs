// heal.c

#include <ansi.h>

int exert(object me, object target)
{
        if( me->is_fighting() )
                return notify_fail("战斗中疗伤？找死吗？\n");

        if( (int)me->query("force") < 50 )
                return notify_fail("你的真气不够。\n");

        if( (int)me->query("eff_sen") == (int)me->query("max_sen") )
                return notify_fail("你精神无损，不需要疗精。\n");

        if( (int)me->query("eff_sen") < (int)me->query("max_sen") / 3 )
                return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");

        message_vision(BLU"$N从檀中穴提气，口中吐出大口的淤血，顿感精神振奋了许多。\n"NOR, me);

        me->receive_curing("sen", 40 + (int)me->query_skill("force")/5 );
        me->add("force", -50);

        return 1;
}
