// 风剑
// By Cigar 2002.04.22

#include <ansi.h>
inherit SSERVER;
#include "/daemon/skill/eff_msg.h";

int perform(object me, object target)
{        
           object weapon;
        int damage, p;
        string msg;
        weapon = me->query_temp("weapon");

        if( !target) target = offensive_target(me);
        if( !target
        ||  !target->is_character()
        ||  !me->is_fighting(target) )
                return notify_fail("「风剑」只能对战斗中的对手使用。\n");
                      
        if( (int)me->query_skill("huxiaolunhui-force",1) < 130 )
                return notify_fail("你的呼啸轮回心法等级不够，不能施展内劲！\n");
        if( (int)me->query_skill("jiutianhuangquan-sword",1) < 130 )
                return notify_fail("你的九天黄泉剑法等级不够，不能施展风剑内劲！\n");
        if( (int)me->query_skill("force", 1) < 130 )
                return notify_fail("你的基本内功等级不够，不能施展风剑内劲！\n");
        if( (int)me->query("force") < 500 )
                return notify_fail("你的真气不足，不能施展风剑内劲！\n");
        if( (int)me->query("max_force") < 1200 )
                return notify_fail("你的内力不足，不能施展风剑内劲！\n");
        if( (int)me->query("mana") < 300 )
                return notify_fail("你的精力不足，不能施展风剑内劲！\n");

        tell_object(me, HIW"\n\n你悄悄使出"BLU"风剑"HIW"，运起一股无形无质的阴寒之气，直插"+target->name()+"胸口玉堂穴要穴！\n\n"NOR); 
//      if(random(me->query_skill("force"))*(me->query_temp("fengdao")+1) >
      if(random(me->query_skill("force"))*3/2 >
         random(target->query_skill("force"))){                
           damage = me->query_skill("force");
           damage = damage + random(damage) + random(damage);
           if(target->query_skill("force")-50 > me->query_skill("force"))
             damage = damage/2 + random(damage);
           if(target->query_skill("force") > me->query_skill("force")*2)
             damage = random(50);
           if(me->query_skill("force") > target->query_skill("force")*2)
             damage = damage+random(damage);
//           if(me->query_temp("fengdao"))
//             damage = damage*(me->query_temp("fengdao")+1);
           if(damage > 600){
              tell_object(target, HIB"\n\n突然之间，一股无形无质、锋如利剑的阴寒之气直插入你胸口的“玉堂穴”中！
"HIR"你霎时之间闭气窒息，全身动弹不得！\n\n"NOR);
              target->start_busy(3);
              }
           else if(damage <= 50){
              damage = 10;
              tell_object(target, HIY"\n突然之间，一股利如利剑般的阴寒之气直插你胸口的玉堂穴！
幸好你护体神功遍护全身，这股阴风刀虽利，却也伤你不得！\n\n"NOR);
              tell_object(me, HIY"你连运风剑的内劲，但见对方竟是毫不费力的抵挡了下来！\n\n"NOR);
              }
           else{
              tell_object(target, HIB"\n突然之间，一股阴劲如刀、如剑、如匕、如凿，直插入你胸口的“玉堂穴”中！
"HIR"你霎时之间闭气窒息，全身动弹不得！\n\n"NOR);
              target->start_busy(2);
              }
           target->receive_damage("kee", damage);
           target->receive_wound("kee", damage/3);
           target->add("force", -damage/2); 
           p = (int)target->query("kee")*100/(int)target->query("max_kee");
           tell_room(environment(target), HIR + target->name()+"突然全身猛地一震，面如金纸，震退了数步，彷佛被什么人在胸口处猛击了一下似的！\n\n" NOR, ({ target })); 
           msg = damage_msg(damage, "内伤");
           msg += "( $n"+eff_status_msg(p)+" )\n"; 
           message_vision(msg, me, target);          
           if(!target->is_killing(me->query("id"))) target->kill_ob(me);      
           me->start_busy(2);
           me->add("force", -200);
           me->add("mana", -70);
           return 1;
           }
         
     else {       
          me->add("force", -100);
          me->add("mana", -15);
          tell_object(me, HIY"结果风剑内劲还没触到"+target->name()+"的身体便已经散了。\n\n"NOR);
          me->start_busy(1);         
          }
        return 1;
}
