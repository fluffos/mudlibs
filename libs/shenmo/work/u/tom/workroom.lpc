inherit ROOM; 
#include <ansi.h> 

void create () 
{ 
set ("short",HIR"K"+HIG+"T"+HIY+"V"NOR); 
set ("long", HIW"\n
我就是那个"+HIC"英俊潇洒、风流倜傥、玉树临风、年少多金、\n"+
HIC"神勇威武、天下无敌、宇宙第一、寂寞高手、刀枪不入、\n"+
HIY"唯我独尊、玉面郎君、仁者无敌、勇者无惧、金刚不坏、\n"+
HIM"英明神武、侠义非凡、义薄云天、古往今来、无与伦比、\n"+
HIY"谦虚好学、不耻下问、聪明伶俐、活泼可爱、待友热情、\n"+
HIC"对敌冷酷、阴险狡诈、无所不为、心狠手辣、无恶不作、\n"+
HIW"对友赴汤蹈火、再所不辞、两肋插刀、枪林弹雨、勇往\n"+
HIR"直前、慷慨大方，头脑精明、仙福永享、寿与天齐、百\n"+
WHT"折不饶、百打不死、侠中豪杰、人中龙凤、有情有义、\n"+
CYN"有胆有色、举世无双、既酷又帅、人之表率、诚实可信、\n"
HIB"谈吐大方、风度翩翩、气势凌人、气质高贵、单身贵族、\n"+
HIW"貌赛潘安、智胜孔明、勇比子龙、义超关羽、巧越鲁班、\n"+
HIC"至尊至圣、至高无上、华丽绚烂、英勇无比、道德榜样、\n"+
RED"千杯不醉、坐怀不乱、知识渊博、才高八斗、傲视众生、\n"+
BLU"世外高人、光明磊落、公正无私，心地善良，忠厚老实，\n"+
YEL"聪明可爱，力大无穷,反应迅速,动作敏捷,头脑灵活,\n"+
HIC"除强扶弱，铲奸除恶，做好事不留名的"+HIW"TOM"+HIC"!\n
"NOR);
set("exits", ([ 
	"wizroom" :  "/d/wiz/wizroom", 
	"kz"  :   "/d/city/kezhan", 
	"+"  :   "/d/city/center", 
   "dc"  :   "/d/city/duchang", 
    ])); 
set("no_time", 1);  
set("valid_startroom", 1);  
       
setup(); 
} 

void valid_move(object who)
{
if ( who->query("id")!="tom" )
    message("shout",HIM"\n【千里眼】某人：据说"HIW+who->query("name")+HIM"从超级帅哥tom包场的KTV里尽兴而归了！\n\n"NOR,users());
}
