// m_sword.c

#include <ansi.h>
#include <weapon.h>

inherit M_WEAPON;


int duanlian(object weapon);
int do_hui(object weapon);


//string query_autoload() { return 1 + ""; }    //autoload weapon

void init() {
  add_action("do_duanlian", "duanlian");
  add_action("do_hui", "hui");
}


void create() {
  object me;
  string w_name, w_id, w_or;
  int w_lv;
  me = this_player();
  //自制武器被他人得到后有bug，加入以下语句可以解决。
  if (!(me->query("weapon/name"))) {
    remove_call_out("destrory");
    call_out("destrory", 1, this_object());
    return;
  }
  //读入数据
  w_name = me->query("weapon/name");
  w_id = me->query("weapon/id");
  w_or = me->query("weapon/or");
  w_lv = me->query("weapon/lv");
  //      set_name(w_name, ({w_id}));
  set("unit", "柄");
  set("zizhi", 1);
  set("no_get", 1);
  set("no_give", 1);
  set("no_drop", 1);
  set("nopawn", 1);
  set_desc(w_lv, w_or, w_name);
  switch (w_or) {
    case "千年神木":
      set_weight(500);
      set("material", "iron");
      set_name(HIR + w_name + NOR, ({ w_id }));
      set("wield_msg", HIY "$N凌空一握，手中由虚变实的赫然现出一把" + HIR "" + w_name + "" + NOR "。\n" NOR);
      set("unwield_msg", HIY "$N手中" + HIR "" + w_name + "" NOR "一抖，眨眼间已然不见影踪。\n" NOR);

      break;
    case "海底金母":
      set_weight(1000);
      set("material", "steel");
      set_name(MAG + w_name + NOR, ({ w_id }));
      set("wield_msg", MAG "$N凌空一握，手中由虚变实的赫然现出一把" + HIR "" + w_name + "" + NOR "。\n" NOR);
      set("unwield_msg", MAG "$N手中" + HIR "" + w_name + "" NOR "一抖，眨眼间已然不见影踪。\n" NOR);

      break;
    case "寒丝羽竹":
      set_weight(30);
      set("material", "bamboo");
      set_name(HIG + w_name + NOR, ({ w_id }));
      set("wield_msg", HIC "$N凌空一握，手中由虚变实的赫然现出一把" + HIR "" + w_name + "" + NOR "。\n" NOR);
      set("unwield_msg", HIC "$N手中" + HIR "" + w_name + "" NOR "一抖，眨眼间已然不见影踪。\n" NOR);

      break;
    default:
  }
  init_blade(w_lv * 5);
  setup();
}
//destruct 武器
void destrory(object ob) {
  destruct(ob);
}
int do_duanlian(object weapon) {
  object me;
  int w_zhi, w_level;
  string w_or;

  me = this_player();
  if (!weapon)
    return notify_fail("你要锻炼什么?\n");
  if ((int)me->query("weapon/lv") > 39)
    return notify_fail("你的武器等级达到极限，无法锻炼武器！\n");
  if ((int)me->query("maximum_force") < 2200)
    return notify_fail("你的内力上限不够，无法锻炼刀气！\n");

  if ((int)me->query("max_force") < 2200)
    return notify_fail("你的内力不够，无法锻炼刀气！\n");

  if ((int)me->query("kee") < 300)
    return notify_fail("你的气不够，无法锻炼刀气！\n");

  if ((int)me->query("eff_kee") < 300)
    return notify_fail("你现在的体力太弱，无法锻炼刀气！\n");

  if ((int)me->query("eff_sen") < 300)
    return notify_fail("你现在的精力无法集中，不能锻炼刀气！\n");

  if ((int)me->query("sen") < 300)
    return notify_fail("你现在的精神太弱，无法锻炼刀气！\n");

  if (((int)me->query("potential") - (int)me->query("learned_points")) < 100)
    return notify_fail("你的潜能不够，无法锻炼刀气！\n");

  message_vision(HIR "$N手握刀身，一股内力丝丝的传了进去。\n" NOR, me);

  me->add("maximum_force", -5);
  me->add("max_force", -5);
  me->set("force", (int)me->query("maximum_force"));
  me->add("kee", -30);
  me->add("eff_kee", -30);
  me->add("eff_sen", -30);
  me->add("sen", -30);
  me->add("learned_points", 100);

  w_zhi = (int)me->query("weapon/value");
  w_zhi++;
  me->set("weapon/value", w_zhi);
  w_or = (string)me->query("weapon/or");
  w_level = (int)me->query("weapon/lv");
  if (w_zhi >= ((w_level + 1) * (w_level + 1))) {
    w_level++;
    me->set("weapon/lv", w_level);
    message_vision(HIY "刀身忽的一亮，一道金光隐入$N的刀身，不见了！\n" NOR, me);
    message_vision(HIG "$N的刀的等级提高了！\n" NOR, me);
    weapon = this_object();
    if (weapon->query("equipped"))
      weapon->unequip();
    reload_object(weapon);
    me->set("weapon/value", 0);
    return 1;
  }
  message_vision(RED "$N的刀的等级提高了!\n" NOR, me);
  return 1;
}


int do_hui(object weapon) {
  string w_name;
  object me;
  me = this_player();
  w_name = me->query("weapon/name");
  if (!weapon)
    return notify_fail("你要摧毁什么?\n");
  message_vision(HIR "$N大喝一声，一掌擎刀，一掌猛力击下。结果轰隆一声巨响"
    +w_name + "断为两截!\n" NOR, me);
  me->delete("weapon");
  me->delete("bld/done");
  destruct(this_object());
  me->save();

  return 1;
}

//***********攻击后效果**************

mixed hit_ob(object me, object victim, int damage_bonus) {
  object weapon1;
  object weapon;
  string msg;
  int lvl;
  if (me->query("weapon/lv") < 20) return;
  weapon1 = me->query_temp("weapon");
  weapon = victim->query_temp("weapon");
  msg = HIY "$N手中的" + weapon1->query("name") + HIY "放出万道金光，$n的兵器给金光一照，断成两截落在了地下！ \n" NOR;
  if (objectp(weapon) && random(5) == 1) {
    weapon->unequip();
    weapon->move(environment(victim));
    weapon->set("name", "断成两截的" + weapon->query("name"));
    weapon->set("no_get", 1);
    weapon->set("long", "一件断成两截的" + weapon->query("name"));
    call_out("remove_broken_weapon", random(30) + 60, weapon);
    message_vision(msg, me, victim);
  }
  lvl = me->query("weapon/lv");
  if (random(lvl) > 20 && random(5) == 1)
    if (me->query("force") * 2 > me->query("maximum_force")) return;
  {
    //这儿我们比较weapon lvl得等级，和一个随机数random(5)==1
    lvl *= 5;
    if (lvl > victim->query("force"))
      victim->set("force", 0);
    else
      victim->add("force", -lvl);
    me->add("force", lvl);
    tell_object(victim, RED "你感到自己的内力飞泻而出\n" NOR);
    tell_object(me, HIW "你感到一股内力，从手中的" + weapon1->query("name") + HIW "涌入你的体内\n" NOR);
  }
  switch (random(16)) {
    case 0: return HIW "$n身上被战气划开一道深可见骨的伤口！\n" NOR;
    case 1: return HIW "$N劲力一吐，一道战气从$w" + HIW "中冲出击中$n的$l！\n" NOR;
    case 2: return HIW "$N低喝一声，$w" + HIW "上光芒吞吐闪烁！\n" NOR;
    case 3: return HIW "$n全身被你的威严的战气罩住动弹不得！\n" NOR;
    case 4: return HIW "一道红色的光圈以$w" + HIW "为中心在瞬间扩散开来，$n稍一接触，便被灼伤。\n" NOR;
    case 5: return HIW "$w" + HIW "划出一道光滑优美的曲线，弹指般刹那，穿越了数丈长的距离，衔尾追上了$n。\n" NOR;
    case 6: return HIW "只见$w" + HIW "幻化万千，一如有形无质的幽灵，令人无法揣摩，彭的一声，$n就中了一招。\n" NOR;
    case 7: return HIW "只见寒光闪过,$n已被战气从前胸刺过,鲜血狂喷不止!\n" NOR;
    case 8: return HIW "$N手中的$w" + HIW "舞得虎虎生风,卷起一波又一波滔天巨浪，飞向$n!\n" NOR;
    case 9: return HIW "但见$N手中$w" + HIW "幻化出千万条银蛇,漫天攒动,扑向$n!\n" NOR;
    case 10: return HIW "$w" + HIW "划出一道超出任何世俗之美的弧线,宛如刀刃般划过$n的面门！\n" NOR;
    case 11: return HIW "$N暴喝一声，手中$w" + HIW "圈转，啸音反强，刀光啸音浑然一体，滚向$n的$l! \n" NOR;
    case 12: return HIW "$N凝势不发，忽然空中幻出众多生灵，种种天象展示在苍茫天地间,$n不由得震慑于自然力的多彩与伟大。\n" NOR;
    case 13: return HIW "$w" + HIW "刀光如飞虹，森寒的战气，冷得深入骨髓。\n" NOR;
    case 14: return HIW "$w" + HIW "忽然化作一团熊熊的烈焰，那团厉火直向$n卷去。\n" NOR;
    case 15: return HIW "只见一片茫茫战气中，无数青色光圈潮涌而至，倾刻之间$n已没入刀光之中。\n" NOR;

  }
}
void owner_is_killed() { destruct(this_object()); }

void remove_broken_weapon(object ob) {
  if (ob && environment(ob)) {
    tell_object(environment(ob),
      "一阵微风吹过，" + ob->name() + "化为片片尘土，消失不见了。\n");
    destruct(ob);
  }
}
