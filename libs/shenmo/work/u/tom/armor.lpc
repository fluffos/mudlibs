// jinjia.c 密宗·自动恢复·spells有关
#include <armor.h>
#include <ansi.h>
#include <combat.h>

inherit ARMOR;
inherit F_UNIQUE;
string *names=({ HIY"静心莲花"NOR,HIW"如意莲花"NOR,HIY"金身莲花"NOR,WHT"孤禅莲花"NOR,RED"涅磐莲花"NOR,});
string *ids=({"jingxin lianhua","ruyi lianhua","jinshen lianhua","gucha lianhua","niepan lianhua",});
void jia_condition(object me,object ob);

void create()
{
int i=random(sizeof(names));
set_name(names[i],({ids[i],"lianhua","jia"}));
set_weight(30000);
if( clonep() )
        set_default_object(__FILE__);
else {
        set("unit", "朵");
        set("long", HIW"密宗宝物，相传是湿婆时代留下来的绝世铠甲，具有修身养性的功效。”\n");
        set("material", "steel");
        set("armor_prop/armor", 80); //Rewrite By snowtu For Revise The Item
        set("no_get", 1);
        set("no_give", 1);
        set("no_put", 1);
        set("no_drop", 1);
        set( "no_zm",1);
        }
setup();
}

int init()
{
        add_action("do_wear","wear");
        add_action("do_remove", "remove");
}


int do_wear (string arg)
{
object me = this_player();
object jia = this_object();
string name = jia->query("name");
string id = jia->query("id");
string msg;

if (arg != "all" && arg != id  )
    return notify_fail("你要穿什么？\n");
if ( query("equipped") ) return 0;
msg = BCYN+HIW"$N背后现出一朵$n"+BCYN+HIW"护住了$N妙严肉身。\n"NOR;
jia->set("wear_msg",msg);
remove_call_out("jia_condition");
call_out("jia_condition",1,me,jia);
return 0;
}

int do_remove (string arg)
{
object me = this_player();
object jia = this_object();
string name = jia->query("name");
string id = jia->query("id");
string msg;

if (arg != "all" && arg != id  )
    return notify_fail("你要脱什么？\n");

msg = BCYN+HIW"$N低诵我佛，$n"+BCYN+HIW"随风碎成片片花瓣。\n"NOR;
jia->set("unequip_msg",msg);
remove_call_out("jia_condition");
return 0;
}

void jia_condition(object me,object ob)
{
string msg;
string name=ob->query("name");
int i=(int)me->query_skill("spells",1);
string id =ob->query("id");
i = i/5+random(i/5);
if ( me->query("kee")<me->query("max_kee") )
        {
       msg=name+BCYN+HIW"在$N身后隐隐约约摆动，$N立刻觉得气血充沛起来！\n"NOR;
        message_vision(msg,me);
        me->add("kee",i);
        if ( me->query("kee")>me->query("max_kee") )   me->set("kee",(int)me->query("max_kee") );
        call_out("jia_condition",7,me,ob);
        }
if ( me->query("eff_kee")<me->query("max_kee") )
        {
       msg=name+BCYN+HIW"在$N身后隐隐约约摆动，$N立刻觉得气血充沛起来！\n"NOR;
        message_vision(msg,me);
        me->add("eff_kee",i/2);
        if ( me->query("eff_kee")>me->query("max_kee") )   me->set("eff_kee",(int)me->query("max_kee") );
        call_out("jia_condition",7,me,ob);
        }
}


