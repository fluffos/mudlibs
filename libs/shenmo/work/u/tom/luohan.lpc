#include <ansi.h>
inherit PERFORM;

int check_time() {
  object me;
  int time;

  me = this_player();
  time = me->query_skill("zui-gun", 1);
  time /= 10;
  if (time > 60)
    time = 60;
  return time;
}

void create() {
  set("name", "醉酒罗汉");
  set("class", "human");
  set("family", "少林寺");
  set("belong", "zui-gun");
  set("base_type", "stick");
  set("betray_lvl", 400);
  set("enable", ([
    "force": "yijinjing",
    "spells": "chanzong",
    "dodge": "shaolin-shenfa",
  ]));
  set("limit_skill", ([
    "shaolin-shenfa": 100,
    "yijinjing": 120,
    "force": 100,
    "stick": 100,
    "zui-gun": 100,
  ]));
  set("force", 150);
  set("need_force", (100 + random(50)));
  set("temp", "zui_powerup");
  set("temp_time", (: check_time :));
  return;
}

int normal_hit(object me) {
  if (me->query_condition("drunk") < 1 && !wizardp(me))
    return notify_fail("你又没醉。\n");
  message_vision(HIY "$N" HIY "酒意渐起，打了个酒嗝，手中棍法一变，变得扑簌迷离。\n" NOR, me);
  me->set("actions", (: call_other, "/daemon/class/shaolin/zui-gun/zuijiu", "change_act" :));
  return 1;
}

void remove_eff(object me, string temp_data) {
  if (!me)
    return;
  temp_data = "zui_powerup";

  if ((int)me->query_temp(temp_data)) {
    me->reset_action();
    me->delete_temp(temp_data);
    message_vision(HIY "$N" HIY "酒意淡去，手中长棍渐渐恢复了原样。\n" NOR, me);
  }
}
