// jinjia.c 密宗·自动恢复·spells有关
#include <armor.h>
#include <ansi.h>
inherit ARMOR;
#include "lianhua.h"

void create() {
  randomName();
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "朵");
    set("long", HIW "密宗宝物，相传是湿婆时代留下来的绝世铠甲，具有修身养性的功效。”\n");
    set("material", "steel");
    set("armor_prop/armor", 80);  //Rewrite By snowtu For Revise The Item
    set("no_get", 1);
    set("no_give", 1);
    set("no_put", 1);
    set("no_drop", 1);
    set("no_zm", 1);
    set("addType", "kee");
  }
  setup();
}
