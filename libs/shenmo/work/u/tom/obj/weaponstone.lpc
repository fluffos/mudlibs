#include <ansi.h>

inherit ITEM;
inherit F_UNIQUE;

int do_eat(string);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_get", "你手里一松，七彩神兵石从指间滑落！\n");
    //    set("no_give","这么珍贵的七彩神兵石，哪能随便给人？\n");
    set("no_drop", "这么宝贵的七彩神兵石，扔了多可惜呀！\n");
    set("no_put", "每个人只有一个，你都这么大方！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name(GRN "七彩神兵石" NOR, ({ "qicai shi", "shi" }));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗七彩云雾萦绕的神石，却有隐约散发出一阵杀气。\n");
    set("value", 0);
    set("drug_type", "宝贝");
  }
  set("is_monitored", 1);
  setup();
}

int do_eat(string arg) {
  object me = this_player();
  if (arg != "shi" && arg != "qicai shi") return 0;


  me->add("weapon/value", random(50));
  message_vision(HIG "$N把七彩神兵石往嘴里一丢，磕了一口，结果磕掉了两颗大门牙！
$N琢磨了一下，运气毕生功力轻轻地将七彩神兵石往自铸兵器上一按，七彩神兵石化为一阵烟雾消失！
只见$N的兵刃上一阵光芒闪烁，看起来更加锋利了！
$N豁然开朗，开心地说到：石头不是这么吃地！！\n" NOR, me);
  destruct(this_object());
  return 1;
}
