#include <ansi.h>

inherit ITEM;
#include <obstacle.h>

int do_eat(string);
void create()
{
  set_name(HIY "500level奖励丹" NOR, ({"jiangli dan", "dan"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIY"金黄色的一颗丹药。\n据说它有直接让你取完经，以及增加身体的素质的功效!\n\t\t西游记--神魔传说巫师组制作！"NOR);
    set("value", 50000000);
    set("no_sell", 1);
  }
  
  setup();
}

void init()
{
        add_action("do_eat", "eat");
        call_out("announce",random(10),this_player());
}


void announce(object who)
{
    if(!this_object()) return;
    if(!who) return;
    CHANNEL_D->do_channel(environment(this_object()), "sys",
            who->query("name")+"得到了"+name()+"！\n");
}

int do_eat(string arg)
{
  object me = this_player();
int size=sizeof(obstacles);
string *names = keys(obstacles); 
string *strs = allocate (size);
int nb = 0; 
int num = 2;
 int i;
for (i = 0; i < size; i++) 
 {
 strs[i] = "none"; 
}
for (i = 0; i < size; i++) 
 { 
 me->set("obstacle/"+names[i],"done");
}
me->set("obstacle/number",size);
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

        message_vision(HIY"$N吃下一颗奖励丹，体制发生了不寻常的变化。\n"NOR, me);  
        message_vision(HIY"西游记--神魔传说的巫师恭祝$N达到通过500level。\n"NOR, me); 
    CHANNEL_D->do_channel(this_object(), "chat", me->query("name")+"达到500level得到额外奖励！\n");
    CHANNEL_D->do_channel(this_object(), "rumor", me->query("name")+"达到500level得到额外奖励！\n");
  
        me->add("bellicosity", -random( (int)me->query_kar() * 10));
         me->add("str",num);
         me->add("spi",num);
         me->add("kar",num);
         me->add("cps",num);
      me->set("500level礼物奖励",1);
         me->add("int",num);
         me->add("cor",num);
         me->add("con",num);
         me->add("per",num);
    CHANNEL_D->do_channel(this_object(), "chat", me->query("name")+"所有属性各增加"+to_chinese(num)+"点！\n");
    CHANNEL_D->do_channel(this_object(), "rumor", me->query("name")+"所有属性各增加"+to_chinese(num)+"点！\n");
  destruct(this_object());
  return 1;
}
