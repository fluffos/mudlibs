#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIG "挂机小匣子" NOR, ({ "xiazi", "box" }));
  set_weight(5000);
  set_max_encumbrance(500);
  if (clonep()) {
    object a, b, c, d;
    seteuid(getuid());
    if (a = new("/d/obj/misc/xueshan-map"))
      a->move(this_object());
    if (b = new("/d/penglai/npc/obj/ditu"))
      b->move(this_object());
    if (c = new("/d/obj/magic/bishuizhou"))
      c->move(this_object());
    if (d = new("/d/qujing/pansi/obj/money"))
      d->move(this_object());
    set_default_object(__FILE__);
  } else {
    set("unit", "只");
    set("long", "这是一只装着挂机需要的物品的小匣子,你可以(get all from box)从里面得到各种道具。\n");
    set("value", 10000);
    set("no_sell", 1);
  }
}
