// 加了治疗次数以及替鄙人治疗.snowtu/2004

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIG "辟毒珠" NOR, ({ "pidu zhu", "zhu" }));
  set_weight(120);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("long", "一颗珍贵的辟毒珠，可以用来解毒(jiedu)。\n");
    set("value", 2000000);
    set("drug_type", "仙丹");
    set("no_drop", "这么宝贵的辟毒珠，哪能乱扔! \n");
    set("no_give", "这么宝贵的辟毒珠，还是自己留着吧! \n");
    set("no_sell", "这么宝贵的辟毒珠，还是自己留着吧! \n");
  }
  set("cure_num", 99999999999999 + random(99999999999999));
  setup();
}

void destruct_me() {
  write(HIB + name() + HIB "“啪”的一声，碎成八瓣了。。。\n" NOR);
  destruct(this_object());
}

void check_me() {
  remove_call_out("check_me");
  if (query("cure_num") < 1)
    destruct_me();
  else call_out("check_me", 1);
}

void init() {
  if (query("cure_num") < 1)
    destruct_me();
  else {
    remove_call_out("check_me");
    call_out("check_me", 1);
  }
  add_action("do_jiedu", "jiedu");
}

int do_jiedu(string arg) {
  string str, *msgs = ({
    "$N" HIG "将解毒珠用力在%s上摩擦。\n" NOR,
    "$N" HIG "将解毒珠用力在%s上擦了擦。\n" NOR,
  });
  object who, me = this_player(1);

  if (me->is_busy())
    return notify_fail(HIG "你现在正忙着，不能替自己解毒！\n" NOR);
  if (query("cure_num") < 1) {
    destruct_me();
    return 1;
  }
  if (!arg) {
    str = ({ "身", "面颊", "后心", "天灵" })[random(4)];
    message_vision(sprintf(msgs[random(sizeof(msgs))], str), me);
    me->start_busy(1 / 2, 0);
    if ((me->query("kar") + me->query_temp("spring/cure_times")) > 1) {
      if (!me->update_condition())
        return 1;
      message_vision("$N" HIR "忽然从嘴里吐出一滩黑血，身上的毒已经清除了。\n" NOR, me);
      me->clear_condition();
      me->add_temp("spring/cure_times", 1);
    }
  } else {
    who = present(arg, environment(me));
    if (!who)
      return notify_fail("没有这个人。\n");
    if (who->is_busy())
      return notify_fail("对方正忙着呢。\n");
    str = "$n的";
    str += ({ "身", "面颊", "后心", "天灵" })[random(4)];
    me->start_busy(1 / 2, 0);
    who->start_busy(1 / 2, 0);
    message_vision(sprintf(msgs[random(sizeof(msgs))], str), me, who);
    if ((who->query("kar") + who->query_temp("spring/cure_times")) > 1) {
      if (!who->update_condition())
        return 1;
      message_vision("$N" HIR "忽然从嘴里吐出一滩黑血，身上的毒已经清除了。\n" NOR, who);
      who->clear_condition();
      who->add_temp("spring/cure_times", 1);
    }
  }
  //this_object()->add("cure_num",-1);
  return 1;
}

int valid_leave(object me, string dir) {
  me->delete_temp("spring/cure_times", 1);
}
