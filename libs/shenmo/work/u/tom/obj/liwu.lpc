#include <ansi.h>

inherit ITEM;

int do_eat(string);

void create()
{
   set_name(HIC"月"+HIY"饼"NOR,({"yuebing","yue bing"}));
     if (clonep())
          set_default_object(__FILE__);
     else {
       set("unit","个");
       set("long",HIY"中秋节的美味食品，由经验、道行、潜能、内力、法力及TOM的鼻屎组成的六仁月饼。\n"+BLINK"西游记--神魔传说 巫师组送给你的礼物。\n"NOR);
           set("value", 0);
       set("no_sell",1);
       set("no_give",1);
       set("no_get",1);
       set("no_drop",1);
       set("no_put",1);
    }
    
    setup();
}

void init()
{
     add_action("do_eat","eat");
}

int do_eat(string arg)
{
   object me=this_player();
   string msg;
   if ( !id(arg) )
      return notify_fail("你要吃什么？\n");
   if ( me->query("liwu_2005815")>1 )
     {   destruct(this_object());
         return notify_fail("吃！吃！你不怕撑死？\n");
       }
     if( me->query("combat_exp")>199999 )
     me->add("daoxing",100000); 
     me->add("combat_exp",100000); 
     me->add("force",200); 
    me->add("max_mana",200); 
    me->add("max_force",200); 
     me->add("mana",200); 
     me->add("maximum_force",200);
     me->add("maximum_mana",200); 
     me->add("potential",100000); 
     me->set("liwu_2005815",2); 
//     if ( me->query("age") > 24 ){ 
//        me->add("mud_age",-500000);

//        message_vision("$N对着$n说道，恭喜你又变成小孩了!\n",this_object(),me);
    //  }
    message_vision(HIC"$N吃下一个美味无比的六仁月饼，心情无比舒畅。\n"NOR,me); 
    destruct(this_object());
    return 1;
}
