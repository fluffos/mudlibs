// shoes.c 密宗·自动恢复·spells有关
#include <armor.h>
#include <ansi.h>
inherit BOOTS;
#include "lianhua.h"

void create() {
  randomName();
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "朵");
    set("long", HIW "密宗宝物，相传是湿婆时代留下来的鞋子，具有修身养性的功效。”\n");
    set("material", "steel");
    set("armor_prop/armor", 15);
    set("armor_prop/dodge", 15);
    set("no_get", 1);
    set("no_give", 1);
    set("no_put", 1);
    set("no_drop", 1);
    set("no_zm", 1);
    set("addType", "mana");
  }
  setup();
}
