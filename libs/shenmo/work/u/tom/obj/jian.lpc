#include <weapon.h>
#include <ansi.h>
inherit F_UNIQUE; 
inherit SWORD;

void create()
{
   set_name(HIW "镶着十三颗明珠的剑" NOR, ({ "jewelsword" ,"sword" ,"jian" ,}) );
    set_weight(20000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        	set("unit", "柄");
        	set("no_sell", "1");
                set("no_get", "1");
        	set("no_put", "1");
             set("armor_prop/armor", 5000);
                set("armor_prop/personality", 5000);
        	set("material", "iron");
        	set("long", "一柄里包皮鞘，黄金吞口，上面缀着十三颗豆大明珠的长剑，江湖中不认得这柄剑的人并不多。\n");
        	set("wield_msg", "没有人能看得见$N拔剑的动作，$N的$n忽然间就已经闪电般拔出。。\n");
	set("unwield_msg", "$N将$n收回剑鞘里。\n");
	}
              init_sword(8800);
	setup();
}
void self_dest(object me)
{
    if(!me) return;
    if(!environment(me)) return;
    tell_object(environment(me),name()+
	    "一道紫气闪过，$n被突如其来的霞光收走了！\n");
    destruct(me);
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        pro = (int) victim->query_temp("apply/armor_vs_fire");
        dam = (int) me->query("force");
        if(dam > pro)
        {
        victim->receive_wound("kee",50);
        victim->receive_wound("sen",50);
         return HIW "镶着十三颗明珠的剑上的明珠反射出耀眼的光芒扰的$n双眼刺痛.\n" NOR;
        }
}


