#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SSERVER; 
void wuying_ok(object); 

void remove_effect(object me, int a_amount, int d_amount);
int perform(object me, object target)
{
        object weapon,ob;
        string str;
        int skill;
        int extra;
        string msg;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「"HIG"七彩魔焰斩"NOR"」只能在战斗中使用。\n");
if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
              return notify_fail(" 你使用的武器不对，无法施展「"HIG"七彩魔焰斩"NOR"」。\n");
        if((int)me->query("sen") < 800 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if(me->query("family/family_name")!="五庄观")
                return notify_fail("不是五庄观的不能用「七彩魔焰斩」！\n");
        if( (int)me->query_skill("xiaofeng-sword", 1) < 100 )
return notify_fail("你的晓风残月剑不够娴熟，无法施展「"HIG"七彩魔焰斩"NOR"」。\n");
        if( (int)me->query("force") < 1000  ) 
                return notify_fail("你的内力不够。\n");
        if( (int)me->query("max_force") < 2000  ) 
                return notify_fail("你的内力不足，无法施展「"HIG"七彩魔焰斩"NOR"」。\n");
        if((int)me->query("combat_exp") < 1000000 )
                return notify_fail("你武学经验不够，领悟不到「"HIW"七彩魔焰斩"NOR"」！\n");
          ob=target;
           weapon = me->query_temp("weapon");
        skill = me->query_skill("sword",1);
        extra = me->query_skill("xiaofeng-sword",1);
        me->add_temp("apply/attack", extra);    
        me->add_temp("apply/damage", extra);
  msg = HIC"\n$N脸色忽转肃穆,运转镇元神功,全力于灌注手中兵刃,"+ weapon->name()+  "顿时幻出七彩光芒\n" NOR;
     target->start_busy(3);
       
                message_vision(msg + "\n", me, target);
        msg = HIM "$n只觉七彩光芒圈住自己,登时全身一麻,动弹不得!!\n" NOR;
                 message_vision(msg, me, target);
if( (int)me->query_skill("xiaofeng-sword", 1) > 100 ){
        message_vision(HIM" 赤焰斩\n"NOR, me, ob);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_REGULAR,msg);
}
 if( (int)me->query_skill("xiaofeng-sword", 1) > 140 ){
        message_vision(HIM" 橙焰斩\n"NOR, me, ob);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_REGULAR,msg);
}
if( (int)me->query_skill("xiaofeng-sword", 1) > 180 ){
        message_vision(HIM" 黄焰斩\n"NOR, me, ob);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_REGULAR,msg);
}
if( (int)me->query_skill("xiaofeng-sword", 1) > 220 ){
        message_vision(HIM" 绿焰斩\n"NOR, me, ob);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"),TYPE_REGULAR,msg);
}
if( (int)me->query_skill("xiaofeng-sword", 1) > 260 ){
        message_vision(HIM" 青焰斩\n"NOR, me, ob);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"),TYPE_REGULAR,msg);
}
if( (int)me->query_skill("xiaofeng-sword", 1) > 300 ){
        message_vision(HIM" 蓝焰斩\n"NOR, me, ob);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"),TYPE_REGULAR,msg);
}
if( (int)me->query_skill("xiaofeng-sword", 1) > 340 ){
        message_vision(HIM" 紫焰斩\n"NOR, me, ob);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"),TYPE_REGULAR,msg);
}
   if( (int)me->query_skill("xiaofeng-sword", 1) > 380 ){
      msg +=  CYN "\n$N平心静气，收回七彩光芒，所有的变化都似已穷尽，又像是流水已到尽头，剑势也慢了，很慢。\n\n"NOR;
     message_vision(msg,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIC  "虽然慢，却还是在变，$N忽然一剑挥出，不著边际，不成章法。\n";
}
if( (int)me->query_skill("xiaofeng-sword", 1) > 420 ){
msg +=  "\n但是这一剑却像是画龙点晴，虽然空，却是所有转变的枢纽。\n" NOR;
msg +=  HIR"\n然后$N就刺出了晓风残月剑的最后一剑-------------------------------------------\n\n" NOR;
         message_vision(msg,me,target);
       COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);  
} 
if( (int)me->query_skill("xiaofeng-sword", 1) > 460 ){
         msg = HIC "$N的这一剑刺出，所有的变化已到了穷尽，本已到了尽头的流水，现在就像是已完全枯竭。
$N的力也已将竭了。可是就在这时候，$N手中的剑忽然又起了奇异的震动,天地万物忽然全都静止，
绝对静止，没有变化，没有生机!这一剑带来的，只有死!只有「死」，才是所有一切的终结，才是
真正的终结!流水乾枯，变化穷尽，生命终结，万物灭亡!这才是「晓风残月剑」真正的精粹!这才是
真正夺命的一剑!这一剑赫然是你用生命凝聚而成！\n\n" NOR;
          message_vision(msg,me,target);
  COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);   
}
        
           me->start_busy(1+random(1));
         me->add("force", -500);
        me->set_temp("no_wuying",1);
        me->receive_damage("sen", 50+random(50));
        call_out("wuying_ok",1+random(3),me); 
        me->add_temp("apply/attack", -extra);
        me->add_temp("apply/damage", -extra);

        return 1;
}
void wuying_ok(object me)
{
if (!me) return; 
      me->delete_temp("no_wuying"); 
}
