inherit NPC;
#include <ansi.h>

string *msg = ({
  "请大家注意经常" HIR "backup" HIC ",以避免出现万一情况时造成损失！",
  "请玩家随时注意news更新(" HIR "help news" HIC ")。",
  "请新老玩家使用" HIR "help pfm,help human,help yao,help xian,help saint" HIC ",查看Perform。",
  "请玩家在客栈二楼多提宝贵意见。",
  "本站QQ群" HIR " 156355025 " HIC "，欢迎大家加入，群内有机器共享以及最新公告。",
  "只要是莲花出错了,请大家+ u " HIR "ask rulaifo about 莲花" HIC "就会给你修正过来。",
  "请大家+ u e " HIR "ask da shen about skills" HIC ",修正学习与技能不匹配的问题。",
  "请新玩家阅读 " HIR "help 新手指南 " HIC "和" HIR " help 新人帮助 ",
  "请新老玩家阅读 " HIR "help old_news " HIC "察看过去的有用的news。",
});

string *msg2 = ({
  "暗黑破坏神(Diablo)",
  "方舟(Fang)",
  "乱(Run)",
  "狐媚(Shulele)",
  "眠兔(Snowtu)",
  "舒乐乐(Sulele)",
  "风无影(Windy)",
  "开心汤姆(Tom)",
});

void create() {
  set_name("新闻发布员", ({ "newman" }));
  set("gender", "男性");
  set("age", 30);
  set("title", HIM "西游记--神魔传说" NOR);
  set("long", "一个相貌俊朗的大汉，负责西游记--神魔传说的新闻发布。\n");
  set("combat_exp", 20000);
  set("attitude", "friendly");
  set_skill("dodge", 30);
  set("per", 25);
  set("max_kee", 100000);
  set("kee", 100000);
  set("sen", 100000);
  set("max_sen", 100000);
  setup();
  remove_call_out("msg");
  call_out("msg", 5, sizeof(msg));
}
void msg(int i) {
  remove_call_out("msg");
  if (!environment())
    return;
  if (time() >= query_temp("lastChat") + 3) {
    set_temp("lastChat", time());
    message(
      "shout",
      HIC "【氤氲界】" + msg2[random(sizeof(msg2))] + "：" + msg[i - 1] + NOR "\n",
      users()
    );
    i--;
    if (i <= 0)
      i = sizeof(msg);
  }
  call_out("msg", 300, i);

}
