#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  string dodskill, msg;
  int extra;
  object weapon;
  extra = me->query_skill("skyriver-rake", 1);
  if (extra < 300) return notify_fail("你的［天河钯法］还不够纯熟！\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIR "［漫天钯影］ " NOR "只能对战斗中的对手使用。\n");
  if ((int)me->query("max_force") < 3000)
    return notify_fail("你的内力不够！\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着！！\n");

  if ((int)me->query("combat_exp", 1) < 3000000)
    return notify_fail("你的武学不够，不能使用这一招！\n");

  if ((int)me->query_skill("literate", 1) < 300)
    return notify_fail("你的读书识字不够，不能使用这一招！\n");

  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");

  weapon = me->query_temp("weapon");

  message_vision(HIC "\n$N狂舞手中的钯，使出了一式绝杀技 " BLINK HIR "漫天钯影\n" NOR, me, target);
  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    me->add_temp("apply/attack", extra * 2); me->add_temp("apply/damage", extra * 2);
    target->receive_wound("kee", extra, me);

    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIG "\t\t\t\t三花聚顶\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIG "\t\t\t\t五气朝元\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIG "\t\t\t\t意闲性拙\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIG "\t\t\t\t混沌迷心\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIG "\t\t\t\t酒醉意沉\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIG "\t\t\t\t东撒西泼\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIG "\t\t\t\t逞雄广寒\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIG "\t\t\t\t戏耍嫦娥\n" NOR, me, target);
    me->add_temp("apply/attack", -extra * 2); me->add_temp("apply/damage", -extra * 2);
    me->add("force", -1000);
    me->start_busy(3 + random(1));
  } else {
    message_vision(HIC "可是却被$p" HIC "躲了开去……\n" NOR, me, target);
    me->add("force", -300);
    me->start_busy(3);
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  return 1;
}
