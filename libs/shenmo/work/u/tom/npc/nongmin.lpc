

#include <ansi.h>

inherit NPC;

void create()
{
            set_name(""HIC"老农民"NOR"", ({"lao nongmin", "nongmin"}));
        set("long", "他是一位朴素的老农民。\n");
        set("gender", "男性");
        set("age", 70);
        set("per", 40);
        set("title",""HIG"五一快乐");
        set_skill("literate", 141);
        set("chat_chance",20);
   set("chat_msg", ({
       "老农民轻声告诉你：TOM委托我来发放劳动节礼物！\n",
       "老农民轻声告诉你：你要记得尊重劳动人民哦。\n",
       "老农民轻声告诉你：你可以用(yao qn) or (yao wx) or (yao dx)三个指令中的一个获得礼物！\n",
       }));
        setup();
        carry_object("/d/obj/cloth/magua")->wear();
}

void init()
{
        ::init();
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_cast", "cast");
  add_action("do_ji","ji");
  add_action("do_throw","throw");
  add_action("do_list","list");
  add_action("do_yao","yao");
}

void die()
{
 return;
}

int do_fight(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg && present(arg,environment(who))==me)
  {
        message_vision("$N看样子想打架，但老农民很有涵养,不和$N动粗。\n",who,me);
     return 1;
  }
  return 0;
}

int do_kill(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg && present(arg,environment(who))==me)
  {
message_vision("$N看样子想杀死老农民，但老农民是文化人,没跟$N一般见识。\n",who,me);

    return 1;
  }
  return 0;
}

int do_cast(string arg)
{
  object who = this_player();
  object me = this_object();

    message_vision("$N对着老农民结结巴巴的念了几句咒语，自己都感觉难听死了。\n",who,me);

  return 1;
}


int do_steal(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N想偷东西，但总是有贼心没贼胆。\n",who,me);

  return 1;
}


int do_ji(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N想对老农民祭法宝，前思后想，还是没敢。\n",who,me);

  return 1;
}

int do_throw(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N掏出暗器，看了看老农民，信心不足，又把暗器收了起来。\n",who,me);

  return 1;
}



int do_yao(string arg)
{
        string type;
        object ob;
        object who=this_player();
        object me=this_object();
 if (this_player()->query("liwu200551") > 0 ){
         message_vision("$N对着$n哼了一声。\n",this_object(),this_player());
                command("say 礼物只有一份！领过就不给了！\n");
        return 1;
        }
        if (who->query("combat_exp")<100000)
               return notify_fail("你的经验值这么低，不会是大米来骗礼物的吧:P\n");
    if (!arg)
                return notify_fail("你想要什么？比如:yao wx)\n");
        else 
        {
                sscanf(arg,"%s",type);
                        switch(type)
                        {
                         case "wx":
                                who->add("combat_exp",500000);
  who->set("liwu200551",1);
                                tell_object(who,"老农民说道,ok！\n");
                                break;
                        case "qn":
                               who->add("potential",500000);
  who->set("liwu200551",1);
                                tell_object(who,"老农民说道,ok！\n");
                                break;
                        case "dx":
                                who->add("daoxing",500000);
  who->set("liwu200551",1);
                                tell_object(who,"老农民说道,ok！\n");
                                break;
                                
                        }
        }
return 1;

}

