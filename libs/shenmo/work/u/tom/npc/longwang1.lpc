#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("万圣龙王", ({"wansheng longwang", "longwang", "long"})); 
  set("long", "他是乱石山碧波潭的老龙王。\n"); 
 set("age", 68); 
 set("title",HIW "乱石山碧波潭祖师"NOR);
       set("gender", "男性");
       set("class", "yao");
       set("attitude", "friendly");
       set("per", 30);
	set("int", 30);
       set("max_kee", 6000);
       set("max_gin", 6000);
       set("max_sen", 8000);
       set("force", 4000);
       set("max_force", 4000);
       set("force_factor", 150);
       set("max_mana", 4000);
       set("mana", 4000);
       set("mana_factor", 140);
       set("combat_exp", 4000000);
       set("daoxing", 8000000);
       set("eff_dx", 2000000);
       set("nkgain", 350);
  set_skill("literate", 350);
        set_skill("unarmed", 350);
        set_skill("dodge", 350);
        set_skill("force", 350);
        set_skill("parry", 350);
        set_skill("fork", 350);
        set_skill("spells", 350);
        set_skill("yueya-chan",350);
        set_skill("bihai-spells", 350); 
        set_skill("chuanyun-tui", 350);
        set_skill("zhuanlong-force", 350);
        set_skill("yulong-steps", 350);
        set_skill("blade", 350);
        set_skill("huaxue-blade", 350);
        map_skill("spells", "bihai-spells");
        map_skill("unarmed", "chuanyun-tui");
        map_skill("force", "zhuanlong-force");
        map_skill("blade", "huaxue-blade");
        map_skill("dodge", "yulong-steps");
        map_skill("fork", "yueya-chan");
        map_skill("parry", "yueya-chan");
 
create_family("乱石山碧波潭", 1, "弟子");
setup();
       carry_object("/d/qujing/bibotan/obj/moonstaff")->wield();
        carry_object("/d/qujing/bibotan/obj/zhanpao")->wear();
}
void attempt_apprentice(object ob)
{
         if ( (int)ob->query("str") <25){
	  command("shake");
	command("say 以我看这位" +
RANK_D->query_respect(ob) + "的资质并不适于学习，还是另请高就吧。\n");
 	return;
}
if ( (int)ob->query_skill("bihai-spells",1) <199){
	  command("shake");
	command("say 以我看这位" +
RANK_D->query_respect(ob) + "还是先找其他师傅学吧。\n");
 	return;
}
       command("pat "+ob->query("id"));
        command("say 好，希望" + RANK_D->query_respect(ob) +
"多加努力，把我们乱石山碧波潭发扬光大。\n");
        command("recruit " + ob->query("id") );
        message("system", HIY"乱石山碧波潭又多了一个弟子  "+this_player()->name()+HIW"
                     乱石山碧波潭的势力加强了。\n"NOR,users());
        return;
}
int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "yao");
}
