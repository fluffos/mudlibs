inherit NPC;
#include <ansi.h>

int give_2005gift();
int answer_me();
int title_change();
int check_legal_name(string name, int max_len);
void get_name(string arg, object me,object ob);

void create()
{
set_name(HIC"小当家"NOR,({"xiao dangjia", "xiao"})); 
set ("long", "他是在这里负责给大家现做"HIY"月饼"NOR"的。\n");
set("gender",random(2)?"女性":"男性");
set("title",HIW"天"NOR HIG"上"NOR HIC"人"NOR HIY"间"NOR WHT"中秋"NOR HIW"糕点师傅"NOR);
set("age", random(10)+14);
set("per", 40);
set("attitude", "peaceful");
set("shen_type", 1);
set("inquiry", ([
   "月饼"      :   (: give_2005gift :),
               ]));
setup();
carry_object("/d/lingtai/obj/faguan")->wear();
}


int give_2005gift()
{
     object who,item;
     who=this_player();
     if (!userp(who)){
       command("heng");
       command("heng");
       command("say 什么小猫小狗也来要礼物？！");
       command("qi");
       return 1;
      }
     if ( who->query("liwu_2005815")>1 || who->query("give_2005815")>1 )
     {   command("heng");
        command("say 中秋节礼物只有一份!");
        return 1;
       }
      item=new("/u/tom/obj/liwu.lpc");
      item->move(who);
    who->set("give_2005815",2);
//      command("say 路漫漫其修远兮，吾将上下而求索!");
      command("say 我给你一个西游记--神魔传说特制的六仁月饼，你记得趁新鲜吃掉哦(eat yuebing)!");
      command("say 记得多来咱们西游记--神魔传说看看呀!");
  // command("chat "+HIY"西游记--神魔传说巫师组"NOR+HIC"祝"NOR+HIW+who->query("name")+NOR HIC"元宵快乐。\n"); 
      return 1;
}

