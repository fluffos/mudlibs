inherit NPC;

string check_me()
{
string name;
object gift,*inv,me = this_player();
int i,flag = 0;

inv = all_inventory(me);
for(i=0;i<sizeof(inv);i++)
        {
        name = inv[i]->query("name");
        if ( strsrch(name,"猫眼")!=-1 )
                return "你已经有猫眼戒指了。";
if( me->query("bieji1/number")!= 11 )
 return "你还没通过霸王的考验。"; 
        }
gift = new("/d/bwbj/obj/ring");
if ( gift->move(me) )
 message_vision(name()+"给$N一个$n。\n",me,gift);
return "好好保存。";
}

void create()
{
set_name("丫鬟",({"yahuan","ya huan"}));
set("age",10000);
set("gender","中性");
set("inquiry",([
        "猫眼" : (:check_me:),
]));
setup();
}



