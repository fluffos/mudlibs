inherit NPC;
inherit F_MASTER;
int rank_me();
string ask_mieyao();
string ask_cancel();
#include <ansi.h>
#include "/d/panshi/panshi3.h"
void create()
{
        set_name(HIG"万圣龙婆"NOR, ({ "longpo", "long po"}) );
        set("gender", "女性" );
        set("age", 21);
        set("agi",30);
        set("str", 60);
        set("per", 21);
        set("int",30);
        set("class","yao");
        set("attitude","friendly");
        set("max_force", 3000);
        set("force", 3000);
        set("force_factor", 200);
        set("max_mana", 3000);
        set("mana", 3000);
        set("max_atman", 3000);
	 set("max_kee",2000);
        set("max_gin",2000);
        set("max_sen",2000);
        set("chat_chance", 30);
        set("long",
"万圣龙王的老婆。\n"
        );
        create_family("乱石山碧波潭",3,"弟子");
        set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
                (: perform_action, "blade", "feihua" :),
        }) );
       set("inquiry", ([
           "除仙": (: ask_mieyao :),
           "cancel": (: ask_cancel :),
           "leave" : (:askLeave:),
]));
       set("combat_exp", 2300000);
       set("daoxing", 2300000);
       set_skill("literate", 120);
       set_skill("unarmed", 120);
       set_skill("dodge", 120);
       set_skill("bihai-spells", 120);
       set_skill("force", 140);
       set_skill("parry", 165);
       set_skill("blade", 185);
       set_skill("spells", 145);
       set_skill("fork", 145);
       set_skill("yueya-fork", 145);
       set_skill("yulong-steps", 145);
       set_skill("blade", 125);
       set_skill("chuanyun-tui", 155);
       set_skill("huaxue-blade", 155);
       set_skill("zhuanlong-force", 135);
       map_skill("spells", "bihai-spells");
       map_skill("unarmed", "chuanyun-tui");
       map_skill("force", "zhuanlong-force");
       map_skill("blade", "huaxue-blade");
       map_skill("fork", "yueya-fork");
       map_skill("dodge", "yulong-steps");
     //  map_skill("blade", "shenji-blade");
        setup();
       // carry_object(__DIR__"obj/deitysword")->wield();
      //  carry_object(__DIR__"obj/sjcloth")->wear();
}

void init()
{
       add_action("doAgree","agree");
}


string ask_mieyao()
{
    object who=this_player();

    if((string)who->query("family/family_name")=="乱石山碧波潭") {
      command("smile "+who->query("id"));
      return "/d/obj/mieyao"->query_yao(who);
    }
    return ("非我门人,何故来此?\n");
}
string ask_cancel()
{
    object me=this_player();
if((int)me->query_temp("m_mieyao"))
{
      
      me->delete_temp("m_mieyao");
      me->delete("secmieyao");
      me->delete("secmieyao/type");
      me->delete("secmieyao/location");
      me->delete("secmieyao/place");
      me->delete("secmieyao/name");
      me->delete("secmieyao/id");
     return ("没用的东西！");
}
else
{
      me->delete_temp("m_mieyao");
      me->delete("secmieyao");
   me->delete("secmieyao_mudage");
      me->delete("secmieyao/type");
      me->delete("secmieyao/location");
      me->delete("secmieyao/place");
      me->delete("secmieyao/name");
      me->delete("secmieyao/id");
     return ("你有任务吗？！");
}
}
 void attempt_apprentice(object ob) 
{ 
 if ( (int)ob->query("str") <25){ 
 command("shake"); 
  command("say 以我看这位" + 
 RANK_D->query_respect(ob) + "的资质并不适于学习，还是另请高就吧。\n"); 
  return; 
 } 
   command("pat "+ob->query("id")); 
  command("say 好，希望" + RANK_D->query_respect(ob) + 
 "多加努力，把我们乱石山碧波潭发扬光大。\n"); 
 command("recruit " + ob->query("id") ); 
 message("system", HIY"乱石山碧波潭又多了一个弟子  "+this_player()->name()+HIW" 
    乱石山碧波潭的势力加强了。\n"NOR,users()); 
   return; 
  } 
 int recruit_apprentice(object ob) 
 { 
  if( ::recruit_apprentice(ob) ) 
  ob->set("class", "yao"); 
 } 
