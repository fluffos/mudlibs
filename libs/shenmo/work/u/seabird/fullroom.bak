#include <ansi.h>
inherit ROOM;
void create()
{
        set("short",HIY"新手成长室"NOR);
        set("long",@LONG
这里就是西游记--神魔传说新手成长室,在这里新手可以输入(tsrj)，
就会得到意想不到的帮助!
LONG);
 set("objects", ([ /* sizeof() == 2 */ 
"/u/seabird/wuzhou" : 5, 
 ])); 
set("exits",([
 "down":"/d/kaifeng/tieta",
"west":"/u/seabird/eroom",
]));
set("no_magic", 1);
        set("no_fight", 1);
        setup();
}
void init()
{
      add_action("do_tsrj","tsrj");
}
int do_tsrj()
{
          object me=this_player();

        if ((time()-me->query_temp("tsrj_full"))<6)
        return notify_fail("西游记--神魔传说正在给你积蓄能量中，等会才行。 \n");

  if((me->query("age")<675)||(me->query("combat_exp")<=80077777000))
{
    me->set("eff_sen", (int)me->query("max_sen"));
    me->set("sen", (int)me->query("max_sen"));
    me->set("gin", (int)me->query("max_gin"));
    me->set("eff_gin", (int)me->query("max_gin"));
     me->set("kee", (int)me->query("max_kee"));
     me->set("office_number", 9990);
me->set("eff_kee", (int)me->query("max_kee"));
me->add("killed_hulu ", 10);
  me->set("gongjob/time_over", 3990);
  me->set("yaota_enter_time", 3990);
 me->set("gongjob/done", 1);
 me->set("food", (int)me->max_food_capacity());
 me->set("water", (int)me->max_food_capacity());
     SDS_D->powerup(me,1);
    me->set_temp("tsrj_full",time());
    tell_object(me,HIM"借助西游记--神魔传说的力量，你感到全身充满了活力.\n"NOR);
    return 1;
}
else
{     return notify_fail(HIW"你已经不算是新手了.\n"NOR);
}
}

