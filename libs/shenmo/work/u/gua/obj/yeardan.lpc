//By gua for 2004.1.22
//由于我根据这里的玩家的情况，看他们dh,qn,wx都不缺所以拿这个来做为新年礼物
//本来想做个关于“年怪”由来的job,但是要 写的话 实在...呵呵先用着这个 以后我再加 
#include <ansi.h>

inherit ITEM;

void create() {

  set_name(HIC "新年大礼包" NOR, ({ "newyear box", "box" }));
  set("long",
    HIG "这是由西游记--神魔传说 巫师组 特制的新年礼物,希望大家能在新的一年里更加愉快。\n" NOR);
  set("unit", "个");
  set("weight", 5);
  set("value", 100);
}
void init() {
  if (!wizardp(this_player())) {
    set("no_get", "这么贵重的东西既然扔了 为何还要再去拿回来！\n");
    set("no_give", "想给别人？嘿嘿你还是做梦吧! \n");
    set("no_drop", "这么宝贵的东西，扔掉 你秀豆啊！\n");
    set("no_sell", "别傻了 孩子 想卖掉" + this_object()->query("name") + "门都没有。\n");
  }
  if (this_player() == environment())
    add_action("do_open", "open");
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  object ob;
  if (!id(arg)) return notify_fail("你要做什麽？\n");

  if (living(this_player()) == 0) return 0;
  if (living(this_player()) == 0) return 0;

  ob = this_player();
  ob->set("per", 40);
  ob->set("kar", 40);
  ob->set("int", 40);
  ob->set("cps", 40);
  ob->set("cor", 40);
  ob->set("cps", 40);
  ob->set("str", 40);
  write(HIR + "你打开新年大礼包，只觉得一种神力进去你的体内，快看看有什么变化吧!...\n" NOR);

  message("vision", HIR + ob->name() +
    "打开新年大礼包，突然间到他的实力变强了许多。\n" + NOR,
    environment(ob), ob);
  destruct(this_object());
  return 1;
}
