void init() 
{ 
add_action("do_tiaoshi", "tiaoshi");
} 

int do_tiaoshi(string arg) 
{ 
object me;
me = this_player();
me->set("title",BLINK HBYEL"Stella源于古希伯莱语，是闪烁的星星的意思～"NOR);
return 1;
}


