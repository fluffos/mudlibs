#include <armor.h>
inherit CLOTH;

void create() {
  set_name("圣站宝甲", ({ "fancy skirt", "skirt" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "神秘物品．\n");
    set("value", 1500);
    set("material", "cloth");
    set("armor_prop/armor", 500);
    set("armor_prop/dodge", 10);
    set("armor_prop/personality", 3);
    set("female_only", 1);
  }
  setup();
}
