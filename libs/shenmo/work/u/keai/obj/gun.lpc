#include <ansi.h>
inherit ITEM;
inherit F_EQUIP;

mapping *actions = ({
        ([
                "damage_type"   :  "刺伤",
                "action"        : "$N将$w一点$n的$l，一颗子弹“呼”的就朝那飞去",
                "parry"         : -80,
                "dodge"         : -80,
                "damage"        : 5000,
                "weapon"        : HIY"子弹",
        ]),
        ([
                "damage_type"   :  "重伤",
                "action"        : "$N将$w一点$n的$l，一颗子弹“呼”的就朝那飞去",
                "parry"         : -80,
                "dodge"         : -80,
                "damage"        : 5000,                
                "weapon"        : HIY"子弹",
        ]),
        ([
                "damage_type"   :  "内伤",
                "action"        : "$N将$w一点$n的$l，一颗子弹“呼”的就朝那飞去",
                "parry"         : -80,
                "dodge"         : -80,
                "damage"        : 5000,                
                "weapon"        : HIY"子弹",
        ]),
        ([
                "damage_type"   :  "刺伤",
                "action"        : "$N朝$n$l，“砰”的就是一枪",
                "parry"         : -80,
                "dodge"         : -80,
                "damage"        : 5000,
                "weapon"        : HIY"子弹",
        ]),
        ([
                "damage_type"   :  "重伤",
                "action"        : "$N朝$n$l，“砰”的就是一枪",
                "parry"         : -80,
                "dodge"         : -80,
                "damage"        : 5000,                
                "weapon"        : HIY"子弹",
        ]),
        ([
                "damage_type"   :  "内伤",
                "action"        : "$N朝$n$l，“砰”的就是一枪",
                "parry"         : -80,
                "dodge"         : -80,
                "damage"        : 5000,                
                "weapon"        : HIY"子弹",
        ]),
});

mapping query_action()
{
mapping action = actions[random(sizeof(actions))];
while( action && mapp(action) )
        return action;
}
        
void create()
{
if ( random(2) )        
        set_name(WHT"沙漠之鹰"NOR,({"sha ying","shamo zhi ying","gun"}));
else    set_name(HIW"勃郎宁"NOR,({"bo lang","bo lang ning","gun"}));

set("long",WHT"一把白光锃锃的小手枪，可谓枪中极品。\n"NOR);
set_weight(1000);
set("unit","把");
set("wield_msg",HIR"\n$N"HIR"从怀中掏出把$n"HIR"摆了个Pose,哇，帅呆了！\n\n"NOR);   
set("unwield_msg",HIR"$N"HIR"将$n"HIR"插回枪套，小心翼翼的收了起来。\n"NOR);
set("weapon_prop/damage",500);
set("flag",1);
set("skill_type", "unarmed");
if( !query("actions") ) 
        set("actions", query_action() );
set("no_get",1);
set("no_put",1);
set("no_give",1);
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
if ( !me || !victim || !me->is_fighting(victim) )
        return;
switch(random(5))
        {
        case 0:
        case 1:
        case 4:         
        case 5:
                message_vision(HIR"\n$N"HIR"将"+query("name")+HIR"对着$n"HIR"的脑袋一指，大喝一声“爆头”！\n"NOR,me,victim);
                message_vision(HIR"“砰”的一声$n"HIR"目光呆滞的倒在了地上，不住抽搐的面门上脑浆直流。。。\n"NOR,me,victim);                                  
                victim->set_temp("last_damage_from",me);
                message("channel:rumor",HIM"【千里眼】某人：听说"HIW+victim->query("name")+HIM"被"+me->name()+HIM"爆头了！\n"NOR,users());
                victim->die();
                victim->reset_action();
                break;
        default :       
                message_vision(HIW"\n$N"HIW"将"+query("name")+HIW"对着$n"HIW"一指：“妈的，不想活了？！”\n"NOR,me,victim);
                message_vision(HIY"$n"HIY"见状吓得尿屎直流，一时没了主见。。。。\n\n"NOR,me,victim);
                if ( victim->is_busy() )
                        victim->start_busy(victim->query_busy()+5);
                else    victim->start_busy(5+random(6));
                break;
        }
return;
}       
