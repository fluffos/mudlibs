#include <ansi.h>
inherit ITEM;

void create()
{
set_name(YEL"小狼毫"NOR,({"xiao langhao","mao bi","bi","hao"}));
set("long",CYN+@KEAI
    一支神奇的小毛笔，可以用它来修改自己的头衔或是自己的名字，具体
操作如下：
      修改头衔   title  <新头衔(可以加颜色)> 
举例:
        title HIW大白兔 
           
KEAI+NOR);
set("unit","支");
set("no_sell",1);
setup();
}

void init()
{
if ( !wizardp(this_player()) )
        return;
add_action("do_title","title");
}

int do_title(string arg)
{
object me = this_player();
if ( !wizardp(me) )
        return 0;
if ( !arg )
        {
        write("你要改什么头衔？\n");
        return 1;
        }                       
arg = SDS_D->color_msg(arg);
write("ok\n");
message_vision("$N将自己的头衔改为了"+arg+NOR"。\n",me);
me->set("title",arg);
me->save();
return 1;
}


        
