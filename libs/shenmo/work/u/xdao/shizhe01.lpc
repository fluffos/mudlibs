string answer_qjbm()
             { 
              object me;
              me = this_player();
              message_vision(HIW"仙界使者"CYN"对$N说道：\n",me);      
              message_vision("          奇经八脉是人体最重要的存在，一旦打通则能大大增加人体的潜能。\n",me);     
              message_vision("          现在人界灵气稀薄，不够用来打通奇经八脉，只能靠仙界丹药来打通奇经八脉。\n",me);    
              message_vision("          "HIG"养神丹"CYN"可用来打通任脉，打通则法力值有显著提升。\n",me);  
              message_vision("          "HIG"长生丹"CYN"可用来打通督脉，打通则生命值有显著提升。\n",me);      
              message_vision("          "HIG"人仙丹"CYN"可用来打通人脉，打通则力量有显著提升。\n",me);      
              message_vision("          "HIG"地仙丹"CYN"可用来打通地脉，打通则体格有显著提升。\n",me);      
              message_vision("          "HIG"天仙丹"CYN"可用来打通天脉，打通则悟性有显著提升。\n",me);      
              message_vision("          "HIG"灵仙丹"CYN"可用来打通灵脉，打通则灵性有显著提升。\n",me);      
              message_vision("          "HIG"混沌丹"CYN"可用来打通心脉，打通则能使自身攻击力翻倍。\n",me);      
              message_vision("          "HIG"鸿蒙丹"CYN"可用来打通命脉，打通则能使受到伤害减半。\n",me);      
              message_vision("          想打通奇经八脉必须先打通任督二脉，才能打通人地天灵四脉，最后才能打通心命二脉。\n",me);      
                       }


void init()
{
        object ob;

        ::init();
              add_action("do_vendor_list", "list");
              add_action("do_lianysd", "lianysd");
              add_action("do_liancsd", "liancsd");
              add_action("do_lianrxd", "lianrxd");
              add_action("do_liandxd", "liandxd");
              add_action("do_liantxd", "liantxd");
              add_action("do_lianlxd", "lianlxd");
              add_action("do_lianhdd", "lianhdd");
              add_action("do_lianhmd", "lianhmd");
        if( interactive(ob = this_player()) && !is_fighting() ) {
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || !present(ob, environment(this_object())) ) return;
        say( "仙界使者说道：这位" + RANK_D->query_respect(ob)
                + "，别忙着走，我看你骨骼清奇，乃万年难得一见的仙界奇才？一旦打通全身的奇经八脉就可天下无敌。\n");
}

int do_lianysd()
{
       object me = this_player();
        object ob = this_object();
        object j, i, k, dan;
         int a, b, c;
         j = present("yao wang dan", me);
       if (! present("yao wang dan", me)) return notify_fail("你身上并无妖王丹，想戏耍老夫吗！。\n");
         i = present("yao ya", me);
       if (! present("yao ya", me)) return notify_fail("你身上并无妖之牙，想戏耍老夫吗！。\n");
         k = present("yao hun", me);
       if (! present("yao hun", me)) return notify_fail("你身上并无妖之魂，想戏耍老夫吗！。\n");
         if(objectp(j)) a = j->query_amount();
       if (a < 1) return notify_fail("你身上妖王丹的数量不够！。\n");
         if(objectp(i)) b = i->query_amount();
       if (b < 10) return notify_fail("你身上妖之牙的数量不够！。\n");
         if(objectp(k)) c = k->query_amount();
       if (c < 10) return notify_fail("你身上妖之魂的数量不够！。\n");
       if (me->query("balance") < 5000000) return notify_fail("你帐户上的存款不够！。\n");
        
        message_vision ("\n "HIW"       $N从背包中拿出一大堆材料递给了仙界使者！\n"NOR,me);
        message_vision (" "HIW"       仙界使者掏出一只丹炉，把材料放了进去，唧唧歪歪的哼了几句。只见红光一闪，一颗丹药练成了！\n"NOR,me);
        dan = new ("/d/npc/vr_room/obj/ysd.lpc");
       if (objectp(dan)) dan->move(me);
        j->add_amount(-1);
        i->add_amount(-10);
        k->add_amount(-10);
me->add("balance", -5000000);
        message_vision (" "HIW"       仙界使者递给$N一颗"HIG"养神丹"HIW"，说道：好一颗极品"HIG"养神丹"HIW"，拿稳了！\n"NOR,me);
         message("channel:chat",HIC+"【奇经八脉】仙界使者："+me->query("name")+"得到了一颗"HIG"养神丹\n"+NOR,me); 
return 0;
}

