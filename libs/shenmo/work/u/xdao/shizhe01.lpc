//shizhe by xdao
inherit NPC;
inherit F_VENDOR;

#include <ansi.h> 
string answer_ysd();
string answer_csd();
string answer_dxd();
string answer_rxd();
string answer_txd();
string answer_lxd();
string answer_hdd();
string answer_hmd();
string answer_qjbm();


void create()
{
        set_name(HIW"仙界使者"NOR, ({ "xianjie shizhe", "shizhe"}) );
        set("gender", "男性" );
        set("age", 74);
        set("combat_exp", 1000000000);
        set("daoxing", 1000000000);
        set("max_kee", 1000000);
        set("max_sen", 1000000);
        set("vendor_goods", ([
           "pass": "/d/npc/vr_room/obj/pass",
           "pass1": "/d/npc/vr_room/obj/pass1",
           "pass2": "/d/npc/vr_room/obj/pass2",
           "pass3": "/d/npc/vr_room/obj/pass3",
           "yundan": "/d/npc/vr_room/obj/yundan",
        ]) );
        set("long",

"这是仙界派来常驻长安城的使者，专门喜欢收集一些稀奇古怪的东西。\n 同时也出售不少罕见的宝物！！\n");
        set("title", BLINK""HIM"奇经八脉"NOR);
        set("attitude", "friendly");
        carry_object("/d/obj/cloth/linen")->wear();

set("inquiry", ([
            "养神丹" : (: answer_ysd :),
            "长生丹" : (: answer_csd :),
            "地仙丹" : (: answer_dxd :),
            "人仙丹" : (: answer_rxd :),
            "天仙丹" : (: answer_txd :),
            "灵仙丹" : (: answer_lxd :),
            "混沌丹" : (: answer_hdd :),
            "鸿蒙丹" : (: answer_hmd :),
            "奇经八脉" : (: answer_qjbm :),
              ]) );
 setup();
}

string answer_ysd()
             { 
              object me;
              me = this_player();
              message_vision(HIW"仙界使者"CYN"对$N说道：\n",me);      
              message_vision("          "HIG"养神丹"CYN"乃仙界奇药，可用来打通人体八脉中的任脉。\n",me);     
              message_vision("          可惜"HIG"养神丹"CYN"炼制不易，所消材料甚巨，共需要：。\n",me);    
              message_vision("          1枚"HIW"妖王丹  "CYN"可在两界山中杀死BOSS得到。\n",me);      
              message_vision("          10枚"HIW"妖之牙  "CYN"可在两界山中杀死小妖得到。\n",me);     
              message_vision("          10份"HIW"妖之魂 "CYN"可在两界山中杀死小妖得到。\n",me);
              message_vision("          另需要"HIY"五百两黄金"CYN"的金钱消耗。\n\n",me);
              message_vision("          你如果材料准备齐全我可以帮你炼制一枚，想炼制"HIG"养神丹"CYN"吗？(lianysd)\n"NOR,me);
              me->set_temp("askysd",1);
                       }
