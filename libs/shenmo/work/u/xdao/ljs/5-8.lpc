#include <ansi.h>;
inherit ROOM;
void create() {
  set("short", "第五层妖王府");
  set("long", @LONG
这里是守护第四层的通风大圣猕猴王的洞府，更是通往第六层的必经之路。
洞府四周刻有七大圣结拜时的石刻， 猕猴王端坐在石塌之上，周围小妖纷纷
端茶送果，献媚不已。
LONG);

  set("exits", ([
    "up": __DIR__ "6-1",
    "east": __DIR__ "5-7",
  ]));

  set("objects", ([
    "/u/xdao/ljs/npc/yao-5.lpc": 2,
    "/u/xdao/ljs/npc/boss-5.lpc": 1,
  ]));

  setup();
}

int valid_leave(object who, string dir) {
  object wang = present("mi hou wang", this_object());

  if (dir == "east")
    return ::valid_leave(who, dir);

  if (wang)
    return notify_fail(HIB "猕猴王身子一晃拦在了你的面前！\n" NOR);
  return ::valid_leave(who, dir);
}
