inherit COMBINED_ITEM;
#include <ansi.h>;

void create() {
  set_name(HIW "妖之血" NOR, ({ "yao xue", "xue" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一滴小妖的血，是提炼某种丹药的必须品。\n");
    set("unit", "些");
    set("base_unit", "滴");
    set("base_weight", 1);
    set("value", 10000);
  }
  set_amount(1);
  setup();
}
