#include <ansi.h>


inherit COMBINED_ITEM;

void create()
{
        set_name(RED"血色之石"NOR, ({"xuese stone", "stone"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "杀戮之气凝聚而成的石头，可用来破除一切封印。\n");
                set("unit", "颗");
                set("base_unit", "颗");
                set("base_weight", 1);
                set("value", 100000);
                }
        set_amount(1);
        setup();
}

