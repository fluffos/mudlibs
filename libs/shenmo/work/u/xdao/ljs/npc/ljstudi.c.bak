
#include <ansi.h>

inherit NPC;
//#define LJS_TIME 7200;
string ask_for_enter();
void create()
{
        set_name(HIC"土地"NOR, ({"ljs tudi", "tudi"}));
        set("long",HIC "两界山的土地爷爷。\n"NOR);
        set("age", 400);
        set("attitude", "peaceful");

        set("gender", "男性");
        set("title", HIG"两界山"NOR);
        set("str", 40);
        set("int", 40);
        set("per", 10+random(5));
        set("con", 30);
        set("max_kee",5000);
        set("max_sen", 5000);
        set("combat_exp", 15000000);
   set("baolv",1);
        set("daoxing", 15000000);

        set("force", 12000);
        set("max_force", 12000);
        set("mana", 12000);
        set("max_mana", 12000);
        set("force_factor", 300);
        set("mana_factor", 1200);

        set("eff_dx", 800000);
        set("xuese", 200);
        set_skill("unarmed", 200);
        set_skill("force", 200);
        set_skill("dodge", 200);
        set_skill("parry", 200);
     set("no_clean_up", 1);

        set("inquiry", ([ /* sizeof() == 2 */
                "name" : "吾乃两界山土地是也。",
                "enter" : (: ask_for_enter :),
                "两界山" : "两界山便是五行山，乃五百年前如来佛祖镇压妖猴之地。" ,
                "血色之石" : "血色之石乃杀孽之气所聚，可破除一切封印。" ,
        ]) );

        setup();
}

void init()
{
  ::init();
  add_action("do_bian", "bian");
}

int do_bian(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N对着两界山土地结结巴巴的念了几句咒语，自己都感觉难听死了。\n",who,me);

  return 1;
}
string ask_for_enter()
{
object ob=this_object();
 object me=this_player();
int i;
         if(me->query_temp("dujie_begin")){
    tell_object (me,HIC"土地说道：安心度劫吧！\n"NOR);
  return 0;
  }
i=ob->query("xuese");
if(i>0)
       {
    tell_object (me,HIC"土地说道：离解开封印还需"+i+"块血色之石！\n"NOR);
      }
else
     {
  command("say 封印已解除，老夫这便送你进去！");  
 me->set_temp("ljs_begin",1);
 me->move("/u/xdao/ljs/1-0");
     }                      
 }

int accept_object(object who, object ob)
{
        int amount,i,exp,pot;
        object me = this_object();
        
         if(ob->query("id") != "xuese stone")
                {
            say( HIC"土地"NOR"说道：此物无法解除两界山的封印，给我何用！\n");
             return notify_fail(HIR"这不是需要的物品。\n"NOR);
                }
          else
              {
            say( HIC"土地"NOR"说道：多谢这位" + RANK_D->query_respect(who)
                + "寻来血色之石。\n");
          amount = ob->query_amount();
           me->add("xuese",-amount);
           exp=1000*amount;
           pot=exp/3;
           who->add("potential",pot);
           who->add("combat_exp",exp);
           who->add("daoxing",exp);
           tell_object(who, HIM"你得到了"+chinese_number(exp)
                                   +"点武学经验"+chinese_number(pot)+
                                   "点潜能、"+COMBAT_D->chinese_daoxing(exp)+"道行的奖励!\n"NOR);
           call_out("destroy", 1, ob);
          if(me->query("xuese") < 1 && !me->query_temp("ljs_start"))
           {
          message("channel:chat",YEL"【两界山】"+CYN+"土地：两界山封印已破，众玩家可入内寻机缘，2小时后将重新封印！\n"NOR,users());
          me->set_temp("ljs_start",1);
          call_out("reset_ljs", 7200);
          call_out("reset1", 3600);
          call_out("reset2", 5400);
          call_out("reset3", 6600);
            }
         }
        return 1;
}
void heart_beat()
{
object me = this_object();
::heart_beat();
if (random(20) == 0 && me->query_temp("ljs_start") )
message("channel:chat",YEL"【两界山】"+CYN+"土地：两界山封印已破，众玩家可入内寻机缘！\n"NOR,users());
}

void reset1()
{
remove_call_out("reset1");
  message("channel:chat",YEL"【两界山】"+CYN+"土地：距离两界山重新封印还有1小时的时间。\n"NOR,users());
}

void reset2()
{
remove_call_out("reset2");
  message("channel:chat",YEL"【两界山】"+CYN+"土地：距离两界山重新封印还有30分钟的时间。\n"NOR,users());
}

void reset3()
{
remove_call_out("reset3");
  message("channel:chat",YEL"【两界山】"+CYN+"土地：距离两界山重新封印还有10分钟的时间。\n"NOR,users());
}

void reset_ljs()
{
 object ob = this_object();
object *player;
int m,i;
player = users();
m=sizeof(player);
 remove_call_out("reset_ljs");
if(ob->query_temp("ljs_start"))
  {
  message("channel:chat",YEL"【两界山】"+CYN+"土地：时辰到！佛祖法旨！两界山封印归位！\n"NOR,users());
       for(i=0;i<m;i++){
          if(player[i]->query_temp("ljs_begin"))
               {
                player[i]->delete_temp("ljs_begin");
     tell_object(player[i], HIC"轰隆一声巨响！天空降下一张佛帖重新压在了两界山顶，你被一股强大的力量推出了两界山。\n"NOR);
                player[i]->move("/u/xdao/ljs/ljs");
                }
                       }
  ob->delete_temp("ljs_start");
  ob->set("xuese",200);
  }
}

void destroy(object ob)
{
destruct(ob);
return;
}
                    
void die()
{
  set("eff_kee", 5000);
  set("eff_gin", 5000);
  set("eff_sen", 5000);
  set("kee", 5000);
  set("gin", 5000);
  set("sen", 5000);
  set("force", 12000);
  set("mana", 12000);
  }

void unconcious()
{
  die ();  
}
