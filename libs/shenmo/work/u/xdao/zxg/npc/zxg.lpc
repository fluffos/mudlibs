/*==============================================================================

    紫霄宫的守护进程

==============================================================================*/
inherit F_DBASE;
inherit F_SAVE;
#include <ansi.h>

#define HJ "/u/xdao/zxg/npc/hongjun" 
#define ZY "/u/xdao/zxg/obj/zhanyi" 
#define ZY_HEART_BEAT        300            // 进程心跳，每5分钟心跳检查一次
private int restore_zhanyi();
private int save_zhanyi();
private int close_zhanyi();

string *msg=({
"　高卧九重云, 蒲团了道真。",
"  天地玄黄外, 吾当掌教尊。",
"  盘古生太极, 两仪四象循。",
"  一道传三友, 二教阐截分。",
"  玄门都领秀, 一声化鸿钧。"
});


void create()
{
object zy;
zy = new(ZY);
if(zy){ 
zy->delete("zxg_begin");
zy->save();
destruct(zy); }
        seteuid(getuid());
        set("channel_id", "鸿钧道祖");
        CHANNEL_D->do_channel(this_object(),"sys", "紫霄宫已经启动。");
        restore_zhanyi();
      if(!query("time")) set("time",172800); //紫霄宫48小时进行一次
     set("no_clean_up",1);
        set_heart_beat(ZY_HEART_BEAT);    
}

string query_save_file()
{
    return DATA_DIR+"zxg_save_file";
}


void heart_beat()
{
object me = this_object();
object *player,zy,hj,zb;
int m,i;
zy=new(ZY);

            if ( (int)me->query("time") >  0 && !me->query_temp("zxg_begin") )
            {
message("channel:chat",MAG"【紫霄宫】"+HIW+"鸿钧道祖："+COLOR_D->random_color()+msg[random(sizeof(msg))]+"\n"NOR,users());
if(random(5) == 1) CHANNEL_D->do_channel(this_object(),"chat","紫霄宫将在"+TIME_D->report_str((int)me->query("time")) + "后开启。。。。");
    me->add("time",-ZY_HEART_BEAT);
            }

           else if ( (int)me->query("time") <=  0 && !me->query_temp("begin_time") && zy->query("zxg_begin") != "done" )
            {
message("channel:chat",HIR"\n一阵铺天盖地的威压从三十三天外传遍三界六道！\n"NOR,users());
CHANNEL_D->do_channel(this_object(),"chat","吾已得道！大能大缘者可来紫霄宫听道，紫霄宫开放时间为1个时辰。");
                   zy->set("zxg_begin","done");
                   zy->save();
            me->set_temp("zxg_begin",1);
            me->set_temp("begin_time", 7200);
            me->add_temp("begin_time", -ZY_HEART_BEAT);
            zb = new("/obj/npc/zombie");
           if(objectp(zb)) {
            if(zb->move("/u/xdao/zxg/zixiaogong")) destruct(environment(zb)); 
            if(zb->move("/u/xdao/zxg/z47")) destruct(environment(zb)); 
            if(objectp(zb)) destruct(zb); }
            }

       else if ( (int)me->query_temp("begin_time") > 0 && zy->query("zxg_begin") == "done")
            {
      CHANNEL_D->do_channel(this_object(),"chat","吾已得道！大能大缘者可来紫霄宫听道，紫霄宫将在"+TIME_D->report_str((int)me->query_temp("begin_time")) + "后关闭。");
        player = users();
        m=sizeof(player);
         for(i=0;i<m;i++)
            {
          if(objectp(player[i]))
                {
              if(environment(player[i]))
                     {
                      if(environment(player[i])->query("xukong"))
                            {
                      if(random(3) == 1) 
                                   {
  message_vision ("\n"HIR"   一道灵光闪过！$N"+HIR+"所立之处空间崩塌！$N"+HIR+"瞬间被撕的粉碎！！\n"NOR,player[i]);
  player[i]->die();
                                    }
                             }
                     }
                 }
             }
            me->add_temp("begin_time", -ZY_HEART_BEAT);  
            }

       else if ( (int)me->query_temp("begin_time") < 1 && zy->query("zxg_begin") == "done" )
            {
CHANNEL_D->do_channel(this_object(),"chat","时辰到！紫霄宫内玩家可得传吾三千大道，余者再待机缘！");
           zy->delete("zxg_begin");
           zy->save();
            me->delete_temp("zxg_begin");
            me->delete_temp("begin_time");
            me->set("time",172800);
            hj = new(HJ);
            if(objectp(hj)) {
             if(hj->move("/u/xdao/zxg/zixiaogong")) hj->do_start(); 
             else destruct (hj) ; }
             }

        else if ( (int)me->query_temp("begin_time") > 0 && zy->query("zxg_begin")!= "done" )
            {
            zy->delete("zxg_begin");
            zy->save();
            me->delete_temp("zxg_begin");
            me->delete_temp("begin_time");
            me->set("time",172800);
CHANNEL_D->do_channel(this_object(),"chat","重置紫霄宫！");
             }

    destruct(zy);
    save_zhanyi();
    }

private int save_zhanyi()
{
    if( save() ) {
        return 1;
    } else {
                return 0;
        }
}

private int restore_zhanyi()
{
    if( restore() ) {
        return 1;
    } else {
                return 0;
        }
}