#include <ansi.h>
void dest();
void copy_status(object ob, object me);
inherit NPC;
void create() {
  set_name("无天", ({ "jin bubai", "bubai", "jin" }));
  set("title", HIG "魔界统领" NOR);
  set("gender", "男性");
  set("level", 1500);
  set("class", "yao");
  set("age", 4030);
  set("str", 4050);
  set("per", 3005);
  set("int", 3000);
  set("cor", 5000);
  set("cps", 4000);
  set("combat_exp", 80000000);
  set_skill("force", 1550);
  set_skill("wudu-xinfa", 1550);
  set_skill("spells", 1550);
  set_skill("xiuluo-yinshagong", 1550);
  set_skill("sword", 1550);
  set_skill("whip", 1550);
  set_skill("ruanhong-zhusuo", 550);
  set_skill("unarmed", 550);
  set_skill("wudu-shenzhang", 550);
  set_skill("parry", 550);
  set_skill("literate", 550);
  set_skill("dodge", 550);
  set_skill("jinshe-steps", 550);
  set_skill("wudu-tuifa", 600);
  map_skill("force", "wudu-xinfa");
  map_skill("spells", "xiuluo-yinshagong");
  map_skill("unarmed", "wudu-shenzhang");
  map_skill("unarmed", "wudu-tuifa");
  map_skill("whip", "ruanhong-zhusuo");
  map_skill("parry", "ruanhong-zhusuo");
  map_skill("dodge", "jinshe-steps");
  set("max_sen", 6000);

  set("max_kee", 1350000);
  set("max_sen", 1350000);
  set("max_kee", 135000);
  set("max_sen", 135000);
  set("force", 500000);
  set("max_force", 250000);
  set("mana", 600000);
  set("max_mana", 300000);
  set("force_factor", 10000);
  set("mana_factor", 15000);
  //  set("spell_qiankun_on", 1); //to use cast qiankun, must set this.
  set("chat_chance_combat", 60);
  set("chat_msg_combat",
    ({
      (: cast_spell, "zhenhuo" :),
    }));


  setup();

  carry_object("/obj/money/gold");
  carry_object("/d/obj/cloth/taijicloth")->wear();

}



void init() {
  object ob;

  if (interactive(ob = this_player())) {
    remove_call_out("killing");
    call_out("killing", 0, ob);
  }
  remove_call_out("dest");
  call_out("dest", 300);
}
int accept_kill() {
  object me = this_player();
  object ob = this_object();
  if (me->query_temp("killing_yao") && (string)me->query_temp("killed_id") != (string)ob->query("id")) {
    write(WHT "注意：慢慢来，贪多嚼不烂的！:P\n\n" NOR);
    return 0;
  }
  ob->kill_ob(me);
  if (!ob->query("fighting", 1)) copy_status(ob, me);
  return 1;
}
void dest() {
  object ob = this_object();
  if (!living(ob) || ob->is_busy() || ob->is_fighting()) {
    remove_call_out("dest");
    call_out("dest", 10);
    return;
  }
  shout(HIY "【大唐威望】无天(Jin bubai)：“试问天下人谁敢跟我魔界争风！哈哈！！！”\n" NOR);
  message_vision("$N口中念念有词，腾云驾舞而去。\n", this_object());
  destruct(ob);
}

void die() {
  object me;
  object ob = this_object();
  me = ob->query_temp("last_damage_from");
  if (!me) {
    message_vision(HIR "$N一声怪叫,吼道:TNND,暗算老子!闪人先!\n" NOR, this_object());
    destruct(this_object());
    return;
  }
  me->add("daoxing", 1000);
  me->add("potential", 500);
  ob->command("tian"); ;
  message_vision("$N叹道：“哎,看来我还是不行啊！”\n\n", ob);
  log_file("kill_yaomo.log", ctime(time()) + " " + me->query("id") + " 杀死了无天。\n");
  tell_object(me, HIW "你杀死无天有功，奖励你一年道行和500点潜能！\n" NOR);
  CHANNEL_D->do_channel(this_object(), "rumor",
    sprintf("听说无天被" NOR + YEL "<%s>" HIM "杀死了，大快人心。" NOR, me->query("name")));
  ::die();
}

void if_die() {
  if (!query("last_damage_from") || ("last_damage_from")->is_ghost()) {
    remove_call_out("if_die");
    call_out("if_die", 3);
    return;
  }
  shout(HIY "【大唐威望】无天(Jin bubai)：“试问天下人谁敢跟我魔界争风！哈哈！！！”\n" NOR);
  message_vision("$N口中念念有词，腾云驾舞而去。\n", this_object());
  destruct(this_object());
}

void killing(object ob) {
  if (environment(this_object()) != environment(ob)) return;
  if ((environment(ob)->query("no_fight"))) return;

  message_vision("$N对著$n喝道：「" + RANK_D->query_rude(ob) + "！大爷我看你不顺眼！」\n", this_object(), ob);
  this_object()->kill_ob(ob);
  remove_call_out("if_die");
  call_out("if_die", 3);
  return;
}
int random_place(object emery, string dirs) {
  int fs, k;
  object newob;
  mixed *file, exit;
  file = get_dir(dirs + "/*.lpc", -1);
  if (!sizeof(file)) return 1;
  for (k = 0; k < 10; k++) {  // try 10 times
    fs = random(sizeof(file));
    if (file[fs][1] > 0) {
      newob = load_object(dirs + "/" + file[fs][0]);
      if (newob) {
        if (newob->query("no_fight") ||
          newob->query("no_magic") ||
          !(exit = newob->query("exits")) ||
          sizeof(exit) < 1)
          continue;
        if (emery->move(newob)) {
          CHANNEL_D->do_channel(
            this_object(),
            "sys",
            "出现在" + newob->query("short") + file[fs][0] + " 。\n"
          );
          //CHANNEL_D->do_channel( this_object(), "rumor",
          //sprintf("选择地点"NOR+YEL"<%s>"HIM"了。"NOR, newob->query("short")));	   
          message_vision("$N耀武扬威地晃了过来。\n", emery);
          return 1;
        }
      }
    }
  }

  return 0;
}

void copy_status(object ob, object me) {
  object *inv;
  mapping skill_status, map_status;
  string *sname, *mname;
  string files;
  int i, eff_dx, nk_factor;
  me->set_temp("killing_yao", 1);
  me->set_temp("killed_id", (string)ob->query("id"));
  ob->set("str", me->query("str"));
  ob->set("int", me->query("int"));
  ob->set("con", me->query("con"));
  ob->set("per", me->query("per"));
  ob->set("cor", me->query("cor"));
  ob->set("spi", me->query("spi"));
  ob->set("cps", me->query("cps"));
  ob->set("kar", me->query("kar"));

  ob->set("max_kee", me->query("max_kee"));
  ob->set("eff_kee", me->query("max_kee"));
  ob->set("kee", me->query("kee") * 3 / 2);

  ob->set("max_gin", me->query("max_gin"));
  ob->set("eff_gin", me->query("max_gin"));

  ob->set("gin", me->query("gin") * 3 / 2);

  ob->set("max_sen", me->query("max_sen"));
  ob->set("eff_sen", me->query("max_sen"));
  ob->set("sen", me->query("sen") * 3 / 2);

  ob->set("max_force", me->query("max_force"));
  ob->set("force", me->query("max_force") * 2);
  ob->set("force_factor", me->query("max_force") / 15);
  ob->set("max_mana", me->query("max_mana"));
  ob->set("mana", me->query("max_mana") * 2);
  ob->set("mana_factor", me->query("max_mana") / 20);
  ob->set("combat_exp", me->query("combat_exp") * 6 / 5);
  ob->set("daoxing", me->query("daoxing") * 7 / 5);
  if (skill_status = me->query_skills()) {
    sname = keys(skill_status);
    for (i = 0; i < sizeof(skill_status); i++) {
      ob->set_skill(sname[i], skill_status[sname[i]] + random(50));
    }
  }
  if (map_status = me->query_skill_map()) {
    mname = keys(map_status);
    for (i = 0; i < sizeof(map_status); i++) {
      ob->map_skill(mname[i], map_status[mname[i]]);
    }
  }
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    files = inv[i]->query("default_file");
    if (files && inv[i]->query("weapon_prop")) carry_object(files)->wield();
    if (files && inv[i]->query("armor_prop")) carry_object(files)->wear();
  }

  ob->set("nk_gain", 100 + random(50));
  eff_dx = me->query("daoxing");
  if (eff_dx > 1500000)
    nk_factor = 9;
  else if (eff_dx > 1000000)
    nk_factor = 8;
  else if (eff_dx > 600000)
    nk_factor = 7;
  else if (eff_dx > 300000)
    nk_factor = 6;
  else if (eff_dx > 100000)
    nk_factor = 5;
  else if (eff_dx > 50000)
    nk_factor = 4;
  else if (eff_dx > 20000)
    nk_factor = 3;
  else if (eff_dx > 10000)
    nk_factor = 2;
  else nk_factor = 1;
  ob->set("nk_factor", nk_factor);
  ob->set("type", random(3));
  ob->set("fighting", 1);
  ob->set("killer_by", me);
  ob->set("title", HIR "被" + me->name() + "追杀的" NOR);
}

void heart_beat() {
  if (!query_temp("weapon") && !query_temp("added")) {
    set_temp("added", 1);
    set("force_factor", 100);
    set("force", 2000);
    set("mana_factor", 600);
    set("mana", 6000);

  }
  if (query("eff_kee") < query("max_kee")) {
    if (random(10))
      command("eat yao");
    else {
      command("surrender");
      call_out("exertheal", 1, this_object());
    }
  }

  ::heart_beat();
}
varargs int receive_damage(string type, int damage, object who) {
  object me = this_object();
  call_out("exertheal", 1, me);
  return ::receive_damage(type, damage, who);
}

void exertheal(object me) {
  me->command("exert recover");
}
