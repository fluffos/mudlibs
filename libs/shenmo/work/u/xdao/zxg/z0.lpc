inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "虚空中");
  set("long", @LONG
此处是三十三天外的虚空之境！再往前便是盘古未开化的混沌了。
一股铺天盖地的压力向你袭来，那是极其危险的预兆！
你不停的告诫自己：“不要过去！不要过去！！”
LONG);
  set("exits", ([ /* sizeof() == 2 */
    "down": "/d/33tian/33tian",
    "enter": __DIR__ "z1",
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  int i;
  object *inv;
  int exp, dx, xz;
  exp = me->query("combat_exp");
  dx = me->query("daoxing");
  xz = 100000000;
  inv = all_inventory(this_player());
  for (i = 0; i < sizeof(inv); i++)
    if (dir == "enter" && userp(inv[i])) {
      message_vision(HIM "一股强大的力量阻止了你。\n" NOR, this_player());
      me->start_busy(3);
      return notify_fail("");
    }
  if (dir == "enter" && exp < xz) {
    me->start_busy(3);
    return notify_fail(HIW "  你刚想迈步，突然念头一阵动荡,念头好像在告诫你：不要进去！危险！\n" NOR);
    return notify_fail("");
  }

  if (dir == "enter" && dx < xz) {
    me->start_busy(3);
    return notify_fail(HIW "  你刚想迈步，突然念头一阵动荡,念头好像在告诫你：不要进去！危险！\n" NOR);
    return notify_fail("");
  }

  return ::valid_leave(me, dir);
}
