inherit ROOM;
#include <ansi.h>;
void create()
{
        set("short", "花果山福地");
         set ("long", @LONG
花果山福地、水帘洞洞天。此处便是美猴王孙悟空的洞府。四周山石嶙峋
草木茂盛、灵气充沛，许多小猴子在树间荡漾。远处不时传来阵阵怪叫。
LONG);
                     
set("exits", ([
      "west": __DIR__"e-3", 
      "southeast": __DIR__"eastroom",                     
        ]));
  set("objects", ([ 
      "/u/xdao/hgs/npc/hou.lpc" : 2+random(3),
        ]));

        setup();
}

int valid_leave (object who, string dir)
{

  if (dir == "west")
    return ::valid_leave(who,dir);

if(who->query("family/family_name")=="东海龙宫"
       ||who->query("family/family_name")=="大雪山"
       ||who->query("family/family_name")=="陷空山无底洞"
       ||who->query("family/family_name")=="将军府"
       ||who->query("family/family_name")=="月宫"
       ||who->query("family/family_name")=="阎罗地府")
    return notify_fail(HIB"你不能进去！\n"NOR);
  return ::valid_leave(who,dir);
}
