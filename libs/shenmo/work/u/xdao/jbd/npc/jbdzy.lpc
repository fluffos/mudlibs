/*==============================================================================

    金鳖岛战役的守护进程

==============================================================================*/
inherit F_DBASE;
inherit F_SAVE;
#include <ansi.h>

#define ZY "/u/xdao/jbd/obj/zhanyi" 
#define TB "/u/xdao/jbd/obj/tianbei" 
#define ZY_HEART_BEAT        600            // 进程心跳，每10分钟心跳检查一次
private int restore_zhanyi();
private int save_zhanyi();
private int close_zhanyi();

void create()
{
object zy;
zy = new(ZY);
if(zy){ 
zy->delete("jbd_begin");
zy->save();
destruct(zy); }
        seteuid(getuid());
        set("channel_id", "战役精灵");
        CHANNEL_D->do_channel(this_object(),"sys", "战役精灵已经启动。");
        restore_zhanyi();
      if(!query("time")) set("time",172800); //金鳖岛战役48小时进行一次
     set("no_clean_up",1);
        set_heart_beat(ZY_HEART_BEAT);    
}

string query_save_file()
{
    return DATA_DIR+"zhanyi_save_file";
}


void heart_beat()
{
    object me = this_object();
object *player,zy,tianbei;
string tb, pt;
int m,i;
zy=new(ZY);

            if ( (int)me->query("time") >  0 && !me->query_temp("jbd_begin") )
            {
CHANNEL_D->do_channel(this_object(),"chat","金鳖岛战役将在"+TIME_D->report_str((int)me->query("time")) + "后开启。。。");
    me->add("time",-ZY_HEART_BEAT);
            }

           else if ( (int)me->query("time") <=  0 && !me->query_temp("begin_time") && zy->query("jbd_begin")!="done" )
            {
CHANNEL_D->do_channel(this_object(),"chat","金鳖岛战役开启了。。。一场争岛大战开始了。");
                   zy->set("jbd_begin","done");
                   zy->save();
           tianbei=new(TB);
           if(objectp(tianbei)) {             
            player = users();
               m=sizeof(player);
           for(i=0;i<m;i++){
          if(player[i]) {
          if(player[i]->query("banghui") &&!player[i]->query_temp("dujie_begin")&& tianbei->query("owner") && player[i]->query("banghui") == tianbei->query("owner") )
               {
                player[i]->set_temp("jbd_begin",1);
                player[i]->move("/u/xdao/jbd/tt-save");
                }
                       }
                            }
                      destruct(tianbei); 
                                }
            me->set_temp("jbd_begin",1);
            me->set_temp("begin_time", 7200);
            me->add_temp("begin_time", -ZY_HEART_BEAT); 
            }

       else if ( (int)me->query_temp("begin_time") > 0 && zy->query("jbd_begin") == "done")
            {
      CHANNEL_D->do_channel(this_object(),"chat","金鳖岛战役将在"+TIME_D->report_str((int)me->query_temp("begin_time")) + "后结束。");
            me->add_temp("begin_time", -ZY_HEART_BEAT);  
            }

       else if ( (int)me->query_temp("begin_time") < 1 && zy->query("jbd_begin") == "done" )
            {
CHANNEL_D->do_channel(this_object(),"chat","金鳖岛战役结束。失败玩家退出金鳖岛封印中心！");
       player = users();
       m=sizeof(player);
           for(i=0;i<m;i++){
          if(player[i]) {
          if(player[i]->query_temp("jbd_begin"))
               {
                player[i]->delete_temp("jbd_begin");
                player[i]->delete_temp("no_move");
                   if(random(5)==1) player[i]->move("/d/city/kezhan");
else if(random(5)==1) player[i]->move("/d/city/paimaiwu");
else if(random(5)==1) player[i]->move("/d/city/tilian1");
else if(random(5)==1) player[i]->move("/d/city/tilian");
else if(random(5)==1) player[i]->move("/d/city/tilian2");
else if(random(5)==1) player[i]->move("/d/city/huadian");
else if(random(5)==1) player[i]->move("/d/wiz/entrance");
else if(random(5)==1) player[i]->move("/d/city/misc/idleroom");
else if(random(5)==1) player[i]->move("/d/city/misc/advise");
else player[i]->move("/d/wiz/system");
                }
                       }
           
                            }
            zy->delete("jbd_begin");
                   zy->save();
            me->delete_temp("jbd_begin");
            me->delete_temp("begin_time");
            me->set("time",172800);
             }

        else if ( (int)me->query_temp("begin_time") > 0 && zy->query("jbd_begin")!= "done" )
            {
            zy->delete("jbd_begin");
            zy->save();
            me->delete_temp("jbd_begin");
            me->delete_temp("begin_time");
            me->set("time",172800);
CHANNEL_D->do_channel(this_object(),"chat","重置金鳖岛战役！");
             }

    destruct(zy);
    save_zhanyi();
    }

private int save_zhanyi()
{
    if( save() ) {
        return 1;
    } else {
                return 0;
        }
}

private int restore_zhanyi()
{
    if( restore() ) {
        return 1;
    } else {
                return 0;
        }
}
