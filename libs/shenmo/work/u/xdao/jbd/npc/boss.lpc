#include <ansi.h>
inherit NPC;

void set_hp_status(object me);

void create(object ob)
{
  object me = this_object();
  set_name(HIG"通天道人·分身"NOR, ({ "tongtian daoren", "tongtian", "daoren" }) );  
  set("age", 20000);
  set("vrm_guard", 1);
  set("long", "此人便是通天道人的一缕神念分身，乃混元大罗金仙，历万劫不磨之体，仙之极致。\n");
  set("family/family_name", "东海龙宫");
  set("gender", "男性");
  set("ljs_boss",1);
  set("baolv",1);
  set("combat_exp", 500000000);
  set("daoxing", 500000000);
        set("str",200);
        set("kar",100);
set("per",20+random(11));
        set("max_kee",500000);
        set("max_sen", 500000);
        set("max_force",50000);
        set("force",100000);
        set("max_mana",40000);
        set("mana",80000);
        set("food",50000);
        set("water", 50000);
        set_weight(30000);
        set("no_steal",1);
       set("force_factor",750);
       set("mana_factor",750);
       add_temp("apply/damage", 500);
       set_temp("mingzhong", 20);
       add_temp("apply/armor", 3000);
       add_temp("apply/armor_vs_force",3000);
       add_temp("apply/armor_vs_spells",3000);
set_temp("apply/cold_defence",75);
set_temp("apply/fire_defence",75);
set_temp("apply/lightning_defence",75);
set_temp("apply/poison_defence",75);
set_temp("apply/apply/wind_defence",75);
        set("title",HIW"仙之极致"NOR);
       set("nickname", HIY"截教掌教大老爷"NOR);
        set("dujie/level",9);
        set("dujie/power",9);
        set("dujie/time",9);
        set("dujie/life",3);
        set("xinmai",100);
        set("mingmai",100);
        set("lingmai",100);
        set("spi",150);
      set("attitude", "heroism");
      set("class", "xian");
       set_skill("seashentong", 1000);
       set_skill("dragonforce", 1000);
       set_skill("unarmed",1000);
       set_skill("parry",1000);
       set_skill("dodge",1000);
       set_skill("force",1000);
       set_skill("sword",1000);
       set_skill("daya-jian",1000);
       set_skill("moondance",1000);
       set_skill("dragonfight",1000);
       set_skill("literate",1000);
       set_skill("spells",1000);
 
        me->map_skill("force", "dragonforce");
        me->map_skill("sword", "daya-jian");
        me->map_skill("parry", "daya-jian");
        me->map_skill("spells", "seashentong");
        me->map_skill("dodge", "moondance");
        me->map_skill("unarmed", "dragonfight");
        create_family("东海龙宫", 2, "水族");

       set("chat_chance_combat", 50 );
       set("chat_msg_combat", ({
              (: command, "perform jianqi" :),
              (: command, "cast hualong" :),
                              }) );

      setup();
carry_object("/u/xdao/jbd/obj/sword")->wield();
}
   
void heart_beat()
{  
object ob = this_object();
int k;
   ::heart_beat();


 if(is_fighting())
  {
        k = random(8);                                                
        if (k>7) k=7;
        switch(k)
      	{
          case 0:                     
                command("cast hualong on tongtian daoren");break;
          case 1:                     
                command("perform sheshen");break;
          case 2:                     
                command("perform qijian");break;
          case 3: 
                command("perform qijian");break;
	  case 4:
		command("exert roar");break;
          case 5: 
		command("cast fztime");break;
          case 6: 
		command("cast fzpower");break;
          case 7:                     
                command("perform leidong");break;
          default: return 0;
	}
   }
}

void die ()
{
  object me = this_object();
  object ps,newitem,qs;
  object killer = query_temp("last_damage_from");
  object where = environment(me);
  string err;
  int exp,kexp,mexp,dao,pot,d;
 if(objectp(killer) && killer->query("is_guard") == 1)
         killer = killer->query("possessed");
 if (objectp(killer)) 
  {
  kexp = killer->query("combat_exp");
  mexp = me->query("combat_exp");
  exp = mexp/20000;
  exp += (mexp-kexp)/20000;
if (exp < 100) exp = 1+random(100);
 if (exp > 20000) exp = 20000;
  dao = exp;
if (dao < 1 ) dao = 1;
  pot = exp/3;
if (pot <1 ) pot = 1;
killer->add("combat_exp",exp);
 killer->add("daoxing",dao);
 killer->add("potential",pot);

     d=random(9);
              if (d>8) d=8;   
              switch(d)
        	{
        		case  0: ps = new ("/d/npc/vr_room/obj/csd.lpc");break;
        		case  1: ps = new ("/d/npc/vr_room/obj/ysd.lpc");break;
        		case  2: ps = new ("/d/npc/vr_room/obj/rxd.lpc");break;
        		case  3: ps = new ("/d/npc/vr_room/obj/dxd.lpc");break;
        		case  4: ps = new ("/d/npc/vr_room/obj/txd.lpc");break;
        		case  5: ps = new ("/d/npc/vr_room/obj/lxd.lpc");break;
        		case  6: ps = new ("/d/npc/vr_room/obj/hmd.lpc");break;
        		case  7: ps = new ("/d/npc/vr_room/obj/hdd.lpc");break;
        		case  8: ps = new ("/u/xdao/gift/djd.lpc");break;
              }
 if (objectp(ps)) 
       {
   ps->move(killer);
  message_vision ("\n"HIY"       "+killer->query("name")+"杀死$N"+HIY+"得到了一枚$n！\n"NOR,me,ps);
       }
   
killer->set_temp("mieyao/level",12);
 err=catch(newitem=NEWITEMS_OB->get_item(me,killer));
if(newitem)
   {
message_vision("$N杀死$n得到了一"+newitem->query("unit")+newitem->query("name")+"。\n",killer,me);
newitem->move(killer);
   }

if(random(500) == 1)
    {
  qs = new ("/u/xdao/jbd/obj/book");
  if (objectp(qs)) {
  qs->move(killer);
 killer->set("getdaya",1);
message_vision("$N杀死$n得到了大雅古剑谱！\n",killer,me);
message("channel:chat",MAG"【万仙阵遗址】"+CYN+""+killer->query("name")+"杀死"+me->query("name")+""+CYN+"得到了大雅古剑法的传承!\n"NOR,users());
                   }
    }

tell_object(killer, HIM"你得到了"+chinese_number(exp)
			    +"点武学经验"+chinese_number(pot)+
			    "点潜能、"+COMBAT_D->chinese_daoxing(dao)+"道行的奖励!\n"NOR);
TEAMK_D->teamk(killer,exp);
 }
destruct(this_object());
}
