inherit ITEM;
#include <ansi.h>

void create() {

  set_name(HIM "得道蒲团" NOR, ({ "pu tuan", "tuan" }));
  set("long", "这是一块通天道人遗留的蒲团，似乎和整个封印有关，你试试(sit)它，起身请(leave)。\n");
  set("unit", "块");
  set("no_get", 1);
  set("no_clean_up", 1);
  set_heart_beat(1);
  setup();
}


void init() {
  add_action("add_sit", "sit");
  add_action("do_leave", "leave");
}

private void heart_beat() {
  object me = this_object();
  object tb, zm;
  object who = this_object()->query_temp("sit");
  string owner = this_object()->query_temp("owner");
  if (!objectp(who)) return 0;
  if (!owner) return 0;
  /*
if(!who)
{
message("channel:chat",MAG"【金鳖岛上】"+CYN+"金鳖岛的封印罩重新笼罩了封印天碑！\n"NOR,users());
me->delete_temp("sit");
 return 0;
}
*/

  if (environment(me) != environment(who)) {
    message(
      "channel:chat",
      MAG "【金鳖岛上】" + CYN + "" + who->query("name") + "被打落蒲团!金鳖岛的封印罩重新笼罩了封印天碑！\n" NOR,
      users()
    );
    me->delete_temp("sit");
    who->set_temp("sit_end", time());
    who->delete_temp("sit_putuan");
    zb = new("/obj/npc/zombie.lpc");
    if (zb) {
      zb->move("/u/xdao/jbd/tt_owner");
      destruct(zb);
    }
    if (objectp(tb = find_object(owner))) {
      tb->delete_temp("open");
      tb->no_open();
    }
    return 0;
  }

  if (!who->query_temp("sit_putuan")) {
    message(
      "channel:chat",
      MAG "【金鳖岛上】" + CYN + "" + who->query("name") + "起身离开了蒲团!金鳖岛的封印罩重新笼罩了封印天碑！\n" NOR,
      users()
    );
    me->delete_temp("sit");
    zb = new("/obj/npc/zombie.lpc");
    if (zb) {
      zb->move("/u/xdao/jbd/tt_owner");
      destruct(zb);
    }
    if (objectp(tb = find_object(owner))) {
      tb->delete_temp("open");
      tb->no_open();
    }
  }
}

int do_leave() {
  object me = this_object();
  object who = this_player();

  if (!who->query_temp("sit_putuan"))
    return notify_fail(HIY "你有坐在上面吗？\n" NOR);

  message_vision(HIC "$N" + HIC + "起身离开蒲团。\n" NOR, who);
  who->set_temp("sit_end", time());
  me->delete_temp("sit");
  who->delete_temp("sit_putuan");
}

int add_sit(string arg) {
  object me = this_object();
  object who = this_player();
  object tb, zm;
  string owner = this_object()->query_temp("owner");

  if (!userp(who)) return 0;

  if (!arg || (arg != "pu tuan" && arg != "tuan"))
    return notify_fail(HIY "你想坐在哪儿？\n" NOR);

  if (me->query_temp("sit")) {
    if (me->query_temp("sit") != who)
      return notify_fail(HIY "已经有人座在上面了！\n" NOR);
    else return notify_fail(HIY "你已经座在上面了！\n" NOR);
  }

  if (time() - (int)who->query_temp("sit_end") < 10)
    return notify_fail(HIY "起起落落的烦不烦！待会再坐吧！\n" NOR);

  if (who->query("jbd_begin") && owner) {
    message_vision(HIC "$N" + HIC + "端坐在通天蒲团上，好似得道真仙！忽然蒲团白光一闪，封印罩被打开了！！\n" NOR, who);
    me->set_temp("sit", who);
    who->set_temp("sit_putuan", 1);
    zb = new("/obj/npc/zombie.lpc");
    if (zb) {
      zb->move("/u/xdao/jbd/tt_owner");
      destruct(zb);
    }
    if (objectp(tb = find_object(owner))) tb->set_temp("open", 1);
  } else
    return notify_fail(HIY "蒲团发出一股强大的力量阻止了你！\n" NOR);
}
