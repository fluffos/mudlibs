#include <ansi.h>;
inherit ROOM;
void create()
{
        set("short", "通道尽处");
         set ("long", @LONG
这里是通往封印中心的通道的尽头，前方便是通天道场了。
LONG);
                     
set("exits", ([
      "south": __DIR__"tt-4",
      "north": __DIR__"tt-owner",          
        ]));

  set("objects", ([ 
      "/u/xdao/jbd/npc/statues.lpc" : 1,
        ]));

        setup();
}

int valid_leave (object who, string dir)
{
  object statues = present("sword statues", this_object());

  if (dir == "south")
    return ::valid_leave(who,dir);

  if (statues) {
     if(!statues->query("owner"))
    return notify_fail(HIB"剑魂石像大喝一声！生人勿近\n"NOR);
     if(!who->query("banghui"))
    return notify_fail(HIB"剑魂石像大喝一声！生人勿近\n"NOR);
     if(statues->query("owner") != who->query("banghui"))
    return notify_fail(HIB"剑魂石像大喝一声！生人勿近\n"NOR);}

  return ::valid_leave(who,dir);
}
