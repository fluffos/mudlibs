inherit ROOM;
#include <ansi.h>;
void create() {
  set("short", "休息室");
  set("long", @LONG
这里是金鳖岛内部的休息室，往前走便是金鳖岛的封印控制枢纽。
外面喊杀声震耳欲聋，此处却十分的宁静。
LONG);
  set("exits", ([
    "out": __DIR__ "jbd-5",
    "north": __DIR__ "tt-1",
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "out") {
    me->delete_temp("jbd_begin");
  }
  if (time() - me->query_temp("jbd_die") < 30)
    return notify_fail(HIW "休息一下再去吧！\n" NOR);
  return ::valid_leave(me, dir);

}
