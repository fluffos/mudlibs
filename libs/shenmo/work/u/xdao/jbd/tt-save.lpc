inherit ROOM;
#include <ansi.h>;
void create() {
  set("short", "通天道场");
  set("long", @LONG
这里是通天道人的道场，虽然道场宽大无比，但除了一张玉床，
一面玉桌，别无他物。
LONG);
  set("exits", ([
    "south": __DIR__ "tt-owner",
    "out": __DIR__ "jbd-5",
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (time() - me->query_temp("jbd_die") < 30)
    return notify_fail(HIW "休息一下再去吧！\n" NOR);
  if (dir == "out")
    me->delete_temp("jbd_begin");
  return ::valid_leave(me, dir);

}
