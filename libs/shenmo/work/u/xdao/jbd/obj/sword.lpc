#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create()
{
        set_name( HIR "诛仙剑" NOR, ({ "zhuxian jian", "jian", "sword" }) );
        set_weight(7000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",                       
 " 通天道人的四绝剑之一 -- 诛仙剑，凑齐其他三把并领悟剑图可施展诛仙剑阵！\n"
);
                set("value", 0);
                set("material", "steel");
                set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n插入腰间的剑鞘。\n");
        }
set("no_sell", 1);
 set("no_drop", 1);
 set("no_put",1);
   set("no_give",1);
        init_sword(280);
        setup();

}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        int damage;
        pro = (int) victim->query("force");
        dam = (int) me->query("force");

        damage = (int) me->query("force_factor");
        victim->receive_damage("sen",damage/2);
        victim->receive_damage("kee",damage/2);
        return HIR "诛仙剑闪出妖异的红光。\n" NOR;
}
 

