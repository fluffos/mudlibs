inherit ROOM;
void create() {
  set("short", "万仙阵遗址");
  set("long", @LONG
眼前所见，废墟一片！阵阵哀伤的灵气飘荡在周围，当年通天道人摆下此阵。
集合门下所有弟子阻挡禅、佛二教四圣的攻击，无数的得道真仙陨落于此。
如今却只留下无数的兵器和残破的古阵而已。
LONG);
  set("exits", ([
    "north": __DIR__ "mz" + sprintf("%d", random(30)),
    "west": __DIR__ "mz" + sprintf("%d", random(30)),
    "south": __DIR__ "mz" + sprintf("%d", random(30)),
    "east": __DIR__ "mz" + sprintf("%d", random(30)),
  ]));
  set("objects", ([
    "/u/xdao/jbd/npc/yao.lpc": 1 + random(2),
  ]));
  setup();
  replace_program(ROOM);
}
