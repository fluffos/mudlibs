#include <ansi.h>

inherit ITEM;

int do_quit();
int do_halt();
void close();

int is_sleeve() {return 1;}

void create()
{
     set_name("演练场",({"in attroom","attroom"}));     
     set("short","大唐演练场");
     set("long", @LONG
这里是大唐演练场，四周雾气环绕你根本什么都看不清。
不时耳旁传来沉重的喘息声．．．如果你想离开请用(halt)
LONG
     );
     set_max_encumbrance(800000000);
     set_weight(100);
     seteuid(getuid());
//     set("no_get",1);
set("attroom",1);
     setup();

}

int is_container() { return 1; }

void init()
{
object me = this_player();
if(userp(me)) {
 add_action("do_quit","cast chuqiao");
 add_action("do_quit","quit");
 add_action("do_halt","halt");}
}

int do_quit() {return 1;}

int do_start(object me)
{
int i;
if(!me) return close();
if(!living(me)) {
me->set("end_yanlian",time());
return close();}
if(environment(me)!= this_object()) {
me->set("end_yanlian",time());
return close();}
i = 1;
tell_object(me,HIC"30秒后将迎战第一波敌人请做好准备！\n"NOR);
remove_call_out("yanlian");
call_out("yanlian",30,me,i);
 }

void yanlian(object me,int i)
{
object guai;
mapping skill;
int j,k,*level, max_level,time;
if(!me) return close();
if(!living(me)) {
me->set("end_yanlian",time());
return close();}
if(environment(me)!= this_object()) {
me->set("end_yanlian",time());
return close();}

if(skill=me->query_skills()) {   //查询目标最高skills
k=sizeof(skill);
level=values(skill);
max_level=level[0];
 while(k--) 
         {
 if(level[k]>max_level)
 max_level=level[k];
          }
        }
else max_level = 1;

for (j=0;j<i;j++)
 {
guai = new("/u/xdao/yanlian/npc/guai.lpc");
if(!objectp(guai)){ return close();break;}

guai->set_skill("dodge", max_level + max_level/(10/i));
guai->set_skill("parry", max_level + max_level/(10/i));
guai->set_skill("unarmed", max_level + max_level/(10/i));
guai->set_skill("spear", max_level + max_level/(10/i));
guai->set_skill("axe", max_level + max_level/(10/i));
guai->set_skill("force", max_level + max_level/(10/i));
guai->set_skill("mace", max_level + max_level/(10/i));
guai->set_skill("wusi-mace", max_level + max_level/(10/i));
guai->set_skill("yanxing-steps", max_level + max_level/(10/i));
guai->set_skill("changquan", max_level + max_level/(10/i));
guai->set_skill("baguazhou", max_level + max_level/(10/i));
guai->set_skill("lengquan-force", max_level + max_level/(10/i));
guai->set_skill("bawang-qiang", max_level + max_level/(10/i));
guai->set_skill("sanban-axe", max_level + max_level/(10/i));
guai->map_skill("dodge","yanxing-steps");
guai->map_skill("parry","bawang-qiang");
guai->map_skill("axe","sanban-axe");
guai->map_skill("spear","bawang-qiang");
guai->map_skill("unarmed","changquan");
guai->map_skill("force","lengquan-force");
guai->map_skill("spells","baguazhou");
guai->map_skill("spear","bawang-qiang");
guai->map_skill("mace","wusi-mace");

guai->set("combat_exp",(int)me->query("combat_exp")+(int)me->query("combat_exp")/(10/i));
guai->set("daoxing",(int)me->query("daoxing")+(int)me->query("daoxing")/(10/i));
guai->set("max_kee",(int)me->query("max_kee")+(int)me->query("max_kee")/(5/i));
guai->set("max_sen",(int)me->query("max_sen")+(int)me->query("max_sen")/(5/i));
guai->set("kee",(int)guai->query("max_kee"));
guai->set("eff_kee",(int)guai->query("max_kee"));
guai->set("sen",(int)guai->query("max_sen"));
guai->set("eff_sen",(int)guai->query("max_sen"));
guai->set("str",(int)me->query("str")+(int)me->query("str")/(5/i));
guai->set("spi",(int)me->query("spi")+(int)me->query("spi")/(5/i));
guai->set("cor",(int)me->query("cor")+(int)me->query("cor")/(5/i));
guai->set("con",(int)me->query("con")+(int)me->query("con")/(5/i));
guai->set("per",(int)me->query("per")+(int)me->query("per")/(5/i));
guai->set("kar",(int)me->query("kar")+(int)me->query("kar")/(5/i));
guai->set("max_force",(int)me->query("max_force")+(int)me->query("max_force")/(5/i));
guai->set("max_mana",(int)me->query("max_mana")+(int)me->query("max_mana")/(5/i));
guai->set("force",(int)guai->query("max_force")*2);
guai->set("mana",(int)guai->query("max_mana")*2);
guai->set("dujie/level",(int)me->query("dujie/level"));
guai->set("dujie/power",(int)me->query("dujie/power"));
guai->set("dujie/time",(int)me->query("dujie/time"));
guai->set("dujie/life",(int)me->query("dujie/life"));
guai->set("xinmai",(int)me->query("xinmai"));
guai->set("mingmai",(int)me->query("mingmai"));
guai->set("lingmai",(int)me->query("lingmai"));
guai->set("force_factor",(int)guai->query_skill("force")/2);
guai->set("mana_factor",(int)guai->query_skill("spells")/2);
guai->set("pfmlevel",i);
guai->set_temp("owner",me);
guai->setup();
if(environment(me)->query("attroom")) {
if(!guai->move(this_object())) {destruct(guai);break;}
      }
   else {destruct(guai);break;} 
 }
time = 30*i;
time = random(time/2)+time/2;
i = i+1;
tell_object(me,HIC"敌人出现了！"+TIME_D->report_str(time)+"后出现第"+chinese_number(i)+"波敌人！\n"NOR);
call_out("yanlian",time,me,i);
}

void close()
{
object *inv;
int i,j;
inv=all_inventory();
i=sizeof(inv);
write (HIC"天空中伸出一只大手，你毫无反抗的被抓了起来。\n"NOR);
for (j=0;j<i;j++)
   {
if(inv[j])
      {
if(!userp(inv[j]))
destruct (inv[j]);
else inv[j]->move("/d/city/kezhan");
       }
   }
    destruct(this_object());
}

int do_halt()
{
object me = this_player();
if(me) me->set("end_yanlian",time());
remove_call_out("close");
call_out("close",0);
return 1;
}


int clean_up()
{    
    object *inv;

    if( !clonep() && this_object()->query("no_clean_up") ) return 1;

    inv = all_inventory();
    if(sizeof(inv)>0) return 1;
    //if not empty, no clean up.

    if( this_object() )
    destruct(this_object());
    return 0;
}
