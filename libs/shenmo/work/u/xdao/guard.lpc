#include <ansi.h>
inherit NPC;

string *first_name = ({ "骷髅", "僵尸"});
string *first_id = ({ "kulou", "jiangshi"});
string *name_words = ({ "战士", "武士"});
string *id_words = ({ "zhanshi", "wushi"});
void set_hp_status(object me);

void create(object ob)
{
  object me = this_object();
  string name;
  int i, j,d, p;

  d = random(sizeof(first_name));
  name = first_name[d];
  p = random(sizeof(name_words));
  name += name_words[p];
  set_name(HIB+name+NOR, ({ first_id[d]+" "+id_words[p] }) );
  i = 200;
  j = 100;
 set("family/family_name", "方寸山三星洞");
    
  set("age", 20);
  set("vrm_guard", 1);
  set("gender", random(2)?"男性":"女性");
  set("long", "死去的勇士，不灭的阴魂。\n");
  set("combat_exp", 5000000+random(5000000));
  set("daoxing", 5000000+random(5000000));

      
        set("max_kee",3000+random(3000));
        set("max_sen", 3000+random(3000));
        set("max_force",3000+random(3000));
        set("force",3000+random(3000));
        set("max_mana",3000+random(3000));
        set("mana",3000+random(3000));
        set("food",50000);
        set("water", 50000);
        set_weight(30000);
        set("no_steal",1);
       set("force_factor",100+random(100));
       set("mana_factor",100+random(100));
       add_temp("apply/damage", 50+random(50));
       add_temp("apply/armor", 200+random(500));
       add_temp("apply/armor_vs_force",500+random(500));
       add_temp("apply/armor_vs_spells",500+random(500));
       set("chat_chance_combat", 100);
       set("chat_msg_combat", ({
              (: command, "exert recover" :),
              (: command, "perform qizhi" :),
              (: command, "perform pili" :),
              (: command, "perform qiankun" :),
              (: command, "exert refresh" :),
                              }) );

       set("title",HIR"不灭阴魂"NOR);
         setup();
    

       me->set_skill("unarmed", i+random(i));
        me->set_skill("dodge", i+random(i));
        me->set_skill("parry", i+random(i));
        me->set_skill("force", i+random(i));
        me->set_skill("spells", i+random(i));
 
        me->set_skill("stick", i+random(i));
        me->set_skill("qianjun-bang", i+random(i));
        me->set_skill("sword",i+random(i));
        me->set_skill("liangyi-sword",i+random(i));
        me->set_skill("jindouyun", i+random(i));
        me->set_skill("wuxiangforce", i+random(i));
        me->set_skill("puti-zhi", i+random(i));
        me->set_skill("dao", i+random(i));

        me->map_skill("force", "wuxiangforce");
        me->map_skill("stick","qianjun-bang");
        me->map_skill("parry", "qianjun-bang");
        me->map_skill("spells", "dao");
        me->map_skill("dodge", "jindouyun");
        me->map_skill("unarmed", "puti-zhi");
        me->map_skill("sword", "liangyi-sword");
        create_family("方寸山三星洞", 3, "弟子");
        carry_object("/d/obj/weapon/18weapon.lpc")->wield();
}
   
void kill_ob(object ob)
{
 object me = this_object();
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

void init()
{
  ::init();
  add_action("do_block","",1);
}


int do_block(string arg)
{
    object me=this_object();
    object who=this_player();
    string verb=query_verb();

    int t;
         
    if(!userp(who)&&wizardp(who)) return 0;

    if(verb!="go" &&
            verb!="fly" &&
            !(environment() && environment()->query("exits/" + verb)))
        return 0;
       
    t = 0;    
    t = (int)who->query_temp("passmaze");
   if (t > 0)
         {        
        message_vision(HIY"$n身上发出万丈光芒，$N顿时被照的晕头转向，$n趁机溜了过去。\n"NOR,me,who);
        who->add_temp("passmaze",-1);
        return 0;
    }
          
        tell_object(who,HIM""+me->name()+"身子一晃，堵住了你的去路！\n"NOR);
        return 1;
}


void die ()
{
  object me = this_object();
  object killer = query_temp("last_damage_from");
  object ps;
  int exp,kexp,mexp,dao,pot,d;
 if(objectp(killer) && killer->query("is_guard") == 1)
         killer = killer->query("possessed");
 if (objectp(killer)) 
{
  kexp = killer->query("combat_exp");
  mexp = me->query("combat_exp");
  exp = mexp/5000;
  exp += (mexp-kexp)/5000;
if (exp < 400) exp = 400;
 if (exp > 10000) exp = 10000;
dao = exp;
if (dao < 1 ) dao = 1;
  pot = exp/3;
if (pot <1 ) pot = 1;
killer->add("combat_exp",exp);
 killer->add("daoxing",dao);
 killer->add("potential",pot);
  message_vision (HIY"$N被砍的支离破碎，喀嚓一下倒在地上爬不起来了。\n"NOR,me);

if (random(4) < 3)
   {
     d=random(9);
              if (d>8) d=8;   
              switch(d)
                {
                        case  0: ps = new ("/d/npc/vr_room/0001/obj/guci.lpc");break;
                        case  1: ps = new ("/d/npc/vr_room/0001/obj/guoshibu.lpc");break;
                        case  2: ps = new ("/d/npc/vr_room/0001/obj/leigu.lpc");break;
                     case  3: ps = new ("/d/npc/vr_room/0001/obj/hunpo.lpc");break;
                     case  4: ps = new ("/d/npc/vr_room/0001/obj/shidu.lpc");break;
                     case  5: ps = new ("/d/npc/vr_room/0001/obj/tougu.lpc");break;
                     case  6: ps = new ("/d/npc/vr_room/0001/obj/neidan.lpc");break;
                     case  7: ps = new ("/d/npc/vr_room/0001/obj/jiangshiya.lpc");break;
                        case  8: ps = new ("/u/xdao/ljs/obj/stone.lpc");break;
                        default: ps = new ("/d/npc/vr_room/0001/obj/jiangshiya.lpc");
                        }
  if (objectp(ps)) ps->move(environment (me));
  message_vision ("\n"HIY"       嘭的一声，$N被你打翻在地，尸体上爆出一枚$n"HIY"掉在地上！\n"NOR,me,ps);
   }

  if (random(1000) == 1)
   {
  ps = new ("/d/npc/vr_room/0001/obj/qihun.lpc");
  if(objectp(ps)) {
 ps->move(killer);
  message_vision ("\n"HIY"       嗖的一声，从$N"+HIY+"的尸体上飞出一团光团，$n连忙抓在怀里！\n"NOR,me,killer);
                  }
   }



tell_object(killer, HIM"你得到了"+chinese_number(exp)
                            +"点武学经验"+chinese_number(pot)+
                            "点潜能、"+COMBAT_D->chinese_daoxing(dao)+"天道行的奖励!\n"NOR);
TEAMK_D->teamk(killer,exp);
 }
::die();
}

