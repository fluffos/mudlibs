#include <weapon.h>
#include <ansi.h>
inherit WHIP;

void create() {
  set_name(HIY "龙尾鞭" NOR, ({ "dragon whip", "whip" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", HIR "龙年吉祥，万事如意。" NOR);
    set("value", 500);
    set("no_put", 1);
    set("no_sell", 1);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }
  init_whip(160);
  setup();
}
