inherit ROOM;
void create()
{
        set("short", "蛇洞内");
         set ("long", @LONG
整个蛇洞犹如巨大的迷宫，周围杂草丛生，草丛里不时传来悉悉索索的声音。
越往里走，越是黑暗。阵阵阴风从洞内深处吹来，让人不禁而寒。
LONG);
if(random(2)==1) set("exits/north", __DIR__"s"+sprintf("%d", random(36)));
if(random(2)==1) set("exits/east", __DIR__"s"+sprintf("%d", random(36)));
if(random(2)==1) set("exits/west", __DIR__"s"+sprintf("%d", random(36)));
if(random(2)==1) set("exits/south", __DIR__"s"+sprintf("%d", random(36)));
 set("exits/out","/d/southern/wutai/guandao3"); 
  set("objects", ([ 
      "/d/npc/vr_room/0501/boss.lpc" : 1,
        ]));
        setup();
}

