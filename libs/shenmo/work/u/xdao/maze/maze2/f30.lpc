inherit ROOM;
#include <ansi.h>
void create()
{
        set("short", "埋骨之地");
         set ("long", @LONG
周围已看不大清楚了。偶有阵阵阴风袭来，让人不禁感觉毛骨悚然。
地上满是遗骸，四处漂浮着游荡的鬼火，隐隐还能听见嚎叫声，远处
好像耸立着一副巨大的骨架。
LONG);
if(random(3)==1) set("exits/north", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/east", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/west", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/south", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/northeast", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/northwest", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/southeast", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/southwest", __DIR__"f"+sprintf("%d", random(49)));
set("exits/enter",__DIR__"f48"); 
  set("objects", ([ 
      "/d/npc/vr_room/0001/guard.lpc" : 1+random(2),
        ]));
if(random(10)==1) set("baowu",1);
if(random(10)==1) set("xianjin",1);
        setup();
}

int reset()
{
::reset();
if(random(3)==1) set("exits/north", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/east", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/west", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/south", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/northeast", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/northwest", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/southeast", __DIR__"f"+sprintf("%d", random(49)));
if(random(3)==1) set("exits/southwest", __DIR__"f"+sprintf("%d", random(49)));
set("exits/enter",__DIR__"f48"); 
delete("baowu");
delete("xianjin");
if(random(10)==1) set("baowu",1);
if(random(10)==1) set("xianjin",1);
}

void init()
{
object me = this_player();
object ob = this_object();
object box;
if(!userp(me)) return 0;

if(ob->query("baowu")) {
        message_vision(HIG"$N眼前一亮，居然发现一只宝箱！赶快打开(open box)它看看。\n"NOR, me);
        box = new("/d/npc/vr_room/obj/box2");
        if(objectp(box)) box->move(ob);
        ob->delete("baowu");
         }
if(ob->query("xianjin")) {
        message_vision(HIR"匆忙之中$N踩中了机关，顿时无数毒烟扑面而来，熏得$N晕头转向。\n"NOR, me);
        me->add("sen",-(int)me->query("max_sen")/4);
         }

}

