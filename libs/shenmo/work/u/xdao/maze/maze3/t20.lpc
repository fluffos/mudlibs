inherit ROOM;
#include <ansi.h>
void create()
{
        set("short", "天外天");
         set ("long", @LONG
四周混沌一片，不时有道道亮光呼啸而过，远处随处可以看见星球与
星球发生碰撞时发出的强光和巨大声响，这里便是盘古还未开辟的天
外天空间。似乎从极远的地方传来阵阵强大的能量波动。
LONG);
if(random(3)==1) set("exits/north", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/east", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/west", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/south", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/northeast", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/northwest", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/southeast", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/southwest", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/up", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/down", __DIR__"t"+sprintf("%d", random(63)));
 set("exits/enter",__DIR__"t63"); 
  set("objects", ([ 
      "/d/npc/vr_room/0002/guard.lpc" : 1,
        ]));
if(random(10)==1) set("baowu",1);
if(random(10)==1) set("xianjin",1);
        setup();
}

int reset()
{
::reset();
if(random(3)==1) set("exits/north", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/east", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/west", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/south", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/northeast", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/northwest", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/southeast", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/southwest", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/up", __DIR__"t"+sprintf("%d", random(63)));
if(random(3)==1) set("exits/down", __DIR__"t"+sprintf("%d", random(63)));
 set("exits/enter",__DIR__"t63"); 
delete("baowu");
delete("xianjin");
if(random(10)==1) set("baowu",1);
if(random(10)==1) set("xianjin",1);
}

void init()
{
object me = this_player();
object ob = this_object();
object box;
if(!userp(me)) return 0;

if(ob->query("baowu")) {
        message_vision(HIG"$N眼前一亮，居然发现一只宝箱！赶快打开(open box)它看看。\n"NOR, me);
        box = new("/d/npc/vr_room/obj/box3");
        if(objectp(box)) box->move(ob);
        ob->delete("baowu");
         }
if(ob->query("xianjin")) {
        message_vision(HIR"一不小心$N被四周狂暴的灵气击中，顿时被轰的身心疲惫。\n"NOR, me);
        me->add("sen",-(int)me->query("max_sen")/4);
        me->add("kee",-(int)me->query("max_kee")/4);
         }

}

