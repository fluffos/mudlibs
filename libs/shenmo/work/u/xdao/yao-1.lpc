#include <ansi.h>
inherit NPC;

void create(object ob) {

  set_name(HIM "花卉战士" NOR, ({ "flower soldier", "flower", "soldier" }));
  set("family/family_name", "将军府");

  set("attitude", "aggressive");
  set("class", "yaomo");
  set("gender", random(2) ? "男性" : "女性");
  set("title", HIY "沙场点兵" NOR);
  set("long", "守护花卉的勇士。\n");
  set("combat_exp", 10000);
  set("daoxing", 10000);
  setup();

  carry_object("/d/obj/weapon/18weapon.lpc")->wield();

}

void kill_ob(object ob) {
  object me = this_object();
  set_temp("my_killer", ob);
  ::kill_ob(ob);
}

void heart_beat() {
  int k, i;
  object ob = this_object();
  object me;
  object who = query_temp("owner");
  if (!ob) return 0;
  ::heart_beat();

  if (!who) return 0;
  ob->set_temp("apply/damage", (int)who->query_temp("apply/damage"));
  ob->set_temp("apply/armor", (int)who->query_temp("apply/armor"));
  ob->set_temp("apply/armor_vs_force", (int)who->query_temp("apply/armor_vs_force"));
  ob->set_temp("apply/armor_vs_spells", (int)who->query_temp("apply/armor_vs_spells"));
  ob->set_temp("apply/dodge", (int)who->query_temp("apply/dodge"));
  ob->set_temp("apply/force", (int)who->query_temp("apply/force"));
  ob->set_temp("apply/spells", (int)who->query_temp("apply/spells"));
  ob->set_temp("apply/parry", (int)who->query_temp("apply/parry"));

  if (!who->is_fighting(ob) && environment(who) == environment(ob)) ob->kill_ob(who);
  me = query_temp("my_killer");
  if (query("kee") < query("max_kee")) command("exert recover");
  if (query("sen") < query("max_sen")) command("exert refresh");
  i = (int)query("pfmlevel");
  if (is_fighting() && me && random(10) == 1) {
    if (i > 3 && i < 6) {
      command("perform andu on " + who->query("id"));
      command("perform andu");
    } else if (i < 8) {
      command("perform sanban on " + who->query("id"));
      command("perform sanban");
    } else if (i < 12) {
      command("perform bafang");
    } else {
      command("perform lianhuan on " + who->query("id"));
      command("perform lianhuan");
    }
  }
}

void die() {
  object me = this_object();
  object killer = query_temp("last_damage_from");
  int pot, exp, dao, i;
  message_vision(HIM "$N" + HIM + "冲着你点了点头，随即消失了。\n" NOR, me);
  if (objectp(killer) && killer->query("is_guard") == 1)
    killer = killer->query("possessed");
  if (objectp(killer) == me->query("owner")) {
    exp = 300 + random(300);
    dao = 300 + random(300);
    pot = 800 + random(800);
    i = (int)me->query("pfmlevel");
    exp += exp / (10 / i);
    exp += dao / (10 / i);
    exp += pot / (10 / i);
    killer->add("potential", pot);
    killer->add("combat_exp", exp);
    killer->add("daoxing", dao);
    tell_object(killer, HIM "你得到了" + exp + "点武学经验、" + dao + "点道行和" + pot + "点潜能的奖励!\n" NOR);
  }

  destruct(me);
}
