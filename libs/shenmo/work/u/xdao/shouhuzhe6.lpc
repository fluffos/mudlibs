#include <ansi.h>;
inherit NPC;
#include "star.h"


void create() {
  set_name("太古金乌", ({ "shouhuzhe", "shouhu zhe", "zhe" }));
  set("gender", "男性");
  set("long",
    "守护第六重天的守护者----帝尊后裔\n"
  );
  set("str", 20);
  set("per", 130);
  set("age", 86);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("family/family_name", "陷空山无底洞");

  set("con", 40);
  set("spi", 40);
  set("title", "守护者");
  set("combat_exp", 2000000);
  set("daoxing", 2000000);
  set("max_sen", 4000);
  set("max_kee", 4000);
  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 40);
  set("max_mana", 4000);
  set("mana", 4000);
  set("mana_factor", 50);

  set_skill("spells", 280);
  set_skill("dao", 250);
  set_skill("unarmed", 250);
  set_skill("yinfeng-zhua", 250);
  set_skill("dodge", 280);
  set_skill("blade", 280);
  set_skill("kugu-blade", 280);
  set_skill("yaofa", 300);
  set_skill("lingfu-steps", 280);
  set_skill("parry", 280);
  set_skill("force", 280);
  set_skill("huntian-qigong", 280);
  set_skill("blade", 280);
  set_skill("sword", 300);
  set_skill("qixiu-jian", 280);
  map_skill("spells", "dao");
  map_skill("unarmed", "yinfeng-zhua");
  map_skill("parry", "huoyun-qiang");
  map_skill("sword", "qixiu-jian");
  map_skill("dodge", "lingfu-steps");
  map_skill("force", "huntian-qigong");

  set("chat_chance_combat", 50);
  set("chat_msg_combat",
    ({
      (: perform_action, "sword", "hebi" :),
    }));


  setup();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
}


void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
}
int do_none() {
  object me = this_object();
  message_vision("此乃天界，岂容你乱来？\n", me);
  return 1;
}


void die() {

  object ob = query_temp("my_killer");

  if ((ob && ob->query("9sky/wu") == "done") && (ob && ob->query("9sky/liu") != "done")) {
    ob->start_busy(3);
    message("chat", HIY + "【九重天】天极(Tian ji):" + ob->name() +
      "闯过了六重·栖霞天\n" NOR, users());
    ob->set("9sky/liu", "done");
    ob->add("9sky/number", 1);
    ob->add("daoxing", 50000);
    ob->save();
    tell_object(ob, "你赢得了五十年道行");

  }
  ::die();
}
