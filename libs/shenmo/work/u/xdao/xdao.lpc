                me->set_skill("kugu-blade",60);
          }
        command("addoil");
        command("pat "+me->query("id"));
            write( HIG + "\n恭喜您完成了新手任务，您获得了师门奖励的60级各项功夫。\n现在您可以使用skill命令查看自身的武功，并使用enable命令激发它。\n接下来请去南城客栈店小二处购买一把扫帚，并完成扫地任务吧。\n具体请help renwu查询，当你完成后向新手指导(Newbie npc)汇报，他会给你下一步的指导。\n" + NOR);
me->delete("newbie/lev4");
me->set("newbie/lev5",1);
me->set("newbie/job","完成扫地任务后向新手指导接受下一步指导");
me->save();
   return 1;
  }

