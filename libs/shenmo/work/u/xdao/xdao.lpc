#include <ansi.h>
inherit NPC;
string ask_me();
int family_present();
  int give_bonnet();
int saodi_done();

void create()
{
        set_name(MAG"新手指导"NOR, ({ "newbie npc", "npc" }) );
         set("nickname", HIY"不知情愁枉少年"NOR);
        set("gender", "男性" );
        set("age", 18);
         set("long", YEL"这位是〖仙侣情缘·花卉站〗的礼物使者，向他打听“newbie”，他会带给您想不到的惊喜。\n拜师之后还有额外的奖励呢(Ask 师门)！\n"NOR);
        set("combat_exp", 1000000);
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");

        set("inquiry", ([
                         "newbie" : (: ask_me :),
                     "法冠":(:give_bonnet:),
                         "bonnet":(:give_bonnet:),
                         "师门" : (: family_present :),
                         "师门奖励" : (: family_present :),
                         "汇报" : (: saodi_done :),

        ]));
        setup();
        carry_object("/d/obj/cloth/magua")->wear();
}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

void greeting(object ob)
{
       mixed *inv;
       int i;
    if(!ob) return;
   command("whisper " + ob->query("id") + " "HIW"欢迎光临〖花卉西游〗请牢记本站域名："+HIR+" www.flowerworld.com.cn Port: 6666"+NOR+HIW+" QQ群："+HIR+"107832204"NOR);
   command("xlqy " + HIC"〖仙侣情缘·花卉站〗，欢迎新老玩家光临。IP: www.flowerworld.com.cn Port: 6666\n"NOR);
}

 int give_bonnet()
 {
 object bonnet;
   string oname;
 object who=this_player();
if (!userp(who))
{ 
command("heng");
command("say 什么小猫小狗也来要东西？！");
command("qi");
return 1;
}
    if (who->query_temp("ask_bonnet") > time())
{
    message_vision("$N眼睛撇向一旁，'你不是刚刚要过吗？？'\n",this_object(),this_player());
    return 1;
}
      bonnet=new("/d/lingtai/obj/faguan");
     oname=bonnet->query("name",1);
  bonnet->move(who);
message_vision("$N念动咒语：哈库那玛他他!只见漫天雪飞，$N变出一顶"+oname+"。\n$N给$n一顶"+oname+"\n",this_object(),this_player());
       who->set_temp("ask_bonnet",time()+600);
 return 1;
  }
string ask_me()
 {
        object me = this_player();
        object ob; 
        mapping fam; 
        
 if ((int) me->query("is_pet"))
return "呵呵～你胆子够大的，敢用宠物来领奖！";

 if (!me->query("newbie/lev2"))
return "呵呵~小的不接待外人！";

         if ((int) me->query("welcomexhc"))
                return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
         if ((int) me->query("combat_exp")>100000 || ((int)me->query("c_potential")+(int)me->query("potential")) > 100000 )
                return "您已经不是新手了！不需要我的帮助了";
               else
        {
                me->set("welcomexhc", 1);
                me->set("maximum_force", 900);
                me->set("maximum_mana",900);
                me->set("force",1800);
                me->set("max_force",900);
                me->set("max_mana",900);
                me->set("mana",1800);
                me->set("potential", 50000);
                me->set("daoxing",30000);
            //    me->add("water", 10000);
                me->set("combat_exp",30000);

 CHANNEL_D->do_channel(me, "xlqy", sprintf("在下%s今日光临〖仙侣情缘·花卉站〗（IP:www.flowerworld.com.cn Port: 6666）\n         现已得到新手指导的帮助和奖励！即日起开始行走江湖了！", me->name(1))); 
message_vision(HIW"突然天空中一道"HIM"七"HIY"彩"HIR"霞"HIC"光"HIW"笼罩四方，转瞬即逝！\n"NOR,this_object(),this_player());
               

            write( HIG + "\n恭喜您完成了新手任务，现在您拥有了一定的武学、道行和潜能\n接下来请去南城客栈二楼的雪绒花处领取一张信用卡。\n
领取指令：ask xrhmm about card 然后输入yao\n" + NOR);
me->delete("newbie/lev2");
me->set("newbie/lev3",1);
me->set("newbie/job","去南城客栈二楼雪绒花处领取信用卡");
me->save();

        }
}

int saodi_done()
{
        object me = this_player();
 object bonnet;

if(!me->query("newbie/saodi"))
return notify_fail("你还没完成扫地任务呢！\n");
if(me->query("newbie/lev5"))
{
            write( HIG + "\n恭喜您完成了新手任务，奖励您10W点武学、道行、潜能和50点门忠。\n
送您一顶天师法冠(悟性+10)，带上它(wear)去找师傅学习吧。\n如果天师法冠不小心遗失，请向新手指导再次获取。\n
在您学习前有必要提醒您在南城客栈二楼有天赋丹可购买。\n天赋丹可调整您的天赋属性，可调点数为168点。\n
当您学完之后请帮助你的师门完成一个寻物任务。\n
寻物任务请help renwu查询相关。注意：寻物任务最低要求50点门忠。\n" + NOR);
me->delete("newbie/lev5");
me->set("newbie/lev6",1);
me->add("combat_exp",100000);
me->add("daoxing",100000);
me->add("potential",100000);
me->add("faith",50);
me->set("newbie/job","学习技能后完成一个师门寻物任务");
bonnet=new("/d/lingtai/obj/faguan");
if(objectp(bonnet)) bonnet->move(me);
me->save();
 }
else return notify_fail("新手使者向你愉快的笑了笑！\n");
return 1;
}

int family_present()
{
        object me = this_player();
 if ((int) me->query("is_pet"))
return 0;
      if(!me->query("family"))
      {
        command("say 你还没有拜师呢！");
        command("hehe");
        return 1;
       }
     if(me->query("family_present") || me->query("yudian/gift")=="got" ) {
                command("say 呵呵～这就是您的不是了！小的已经对您施过法力了！");
                return 1;
      }
      if(!me->query("newbie/lev4")) {
                command("say 呵呵～一步步来先完成现在的新手任务吧！");
                return 1;
      }
                me->set_skill("force",60);
                me->set_skill("spells",60);
                me->set_skill("dodge",60);
                me->set_skill("parry",60);
                me->set_skill("literate",60);
                me->set_skill("unarmed",60);
                me->set("family_present",1);
     if(me->query("family/family_name")=="南海普陀山"){
                me->set_skill("force",60);
                me->set_skill("spells",60);
                me->set_skill("parry",60);
                me->set_skill("dodge",60);
                me->set_skill("literate",60);
                me->set_skill("unarmed",60);
                me->set_skill("bighammer",60);
me->set_skill("hammer",60);
                me->set_skill("staff",60);
                me->set_skill("buddhism",60);
                me->set_skill("jienan-zhi",60);
                me->set_skill("lotusforce",60);
                me->set_skill("lotusmove",60);
                me->set_skill("lunhui-zhang",60);
         }
     else if(me->query("family/family_name")=="五庄观"){
