                me->set_skill("yanxing-steps",60);
                me->set_skill("sanban-axe",60);
          }
     else if(me->query("family/family_name")=="陷空山无底洞"){
                me->set_skill("huntian-qigong",60);
                me->set_skill("yaofa",60);
                me->set_skill("lingfu-steps",60);
