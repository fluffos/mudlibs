#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
        set_name(HIC"元宵兔"NOR, ({ "yuanxiao rabbit", "rabbit" }) );
         set("nickname", HIR"合家欢乐，团团圆圆"NOR);
        set("title", HIM"仙兔下凡"NOR);
        set("gender", "男性" );
        set("age", 18);
         set("long", YEL"一只可爱的兔子，Ask gift获得元宵礼物。\n"NOR);
   //   set("shen_type", 1);
        set("combat_exp", 1000000);
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("inquiry", ([
                         "gift" : (: ask_me :),
        ]));
        setup();
        carry_object("/d/obj/cloth/magua")->wear();
}



string ask_me()
 {
        object me = this_player();
        object ob,ob1; 
        
         if(!userp(me)) return "一边玩去。";
         if (me->query("2010yuanxiao"))
                return "呵呵～祝你合家欢乐，团团圆圆！";
         if ((int)me->query("combat_exp") + (int)me->query("daoxing") < 500000)
                return "武学加道行50W以上再来领取吧！";
                me->set("2010yuanxiao", 1);
               me->add("daoxing",200000);
               me->add("combat_exp",200000);
                me->add("potential", 100000);
           ob = new("/d/npc/vr_room/obj/yxbox");
          if(objectp(ob)) 
           ob->move(me); 
         tell_object(me,HIR"元宵仙兔双手抱拳对你说道：元宵快乐！合家团圆！\n 你得到了20万武学，200年道行，10万潜能，和一只"+ob->query("name")+""+HIR+"的元宵礼物！\n"NOR);
       message_vision(HIW"花卉站全体巫师祝$N元宵节快乐。\n"NOR,me);
}

