#include <ansi.h>

inherit NPC;

void create() {
  set_name("" HIY "兑换师" NOR "", ({ "pmaster npc", "npc" }));
  set("long", "这是一个用来兑换师徒荣誉值的npc。\n");
  set("gender", "男性");
  set("title", "" HIW "师徒荣誉");
  set("age", 20);
  set("per", 40);
  set_skill("literate", 141);
  set("chat_chance", 5);
  set("chat_msg", ({
    "兑换师轻声告诉你：你可以用list指令列出想要兑换的东西！\n",
    "兑换师轻声告诉你：你可以用duihuan指令向我兑换装备道具。\n",
  }));
  setup();
  carry_object("/d/obj/cloth/magua")->wear();
}
void init() {
  ::init();
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_cast", "cast");
  add_action("do_ji", "ji");
  add_action("do_throw", "throw");
  add_action("do_list", "list");
  add_action("do_yao", "duihuan");
}

void die() {
  return;
}

int do_fight(string arg) {
  object who = this_player();
  object me = this_object();

  if (arg && present(arg, environment(who)) == me) {
    message_vision("$N看样子想打架，但兑换师很有涵养,不和$N动粗。\n", who, me);
    return 1;
  }
  return 0;
}

int do_kill(string arg) {
  object who = this_player();
  object me = this_object();

  if (arg && present(arg, environment(who)) == me) {
    message_vision("$N看样子想杀死首席长老，但兑换师是文化人,没跟$N一般见识。\n", who, me);

    return 1;
  }
  return 0;
}

int do_cast(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision("$N对着兑换师结结巴巴的念了几句咒语，自己都感觉难听死了。\n", who, me);

  return 1;
}


int do_steal(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision("$N想偷东西，但总是有贼心没贼胆。\n", who, me);

  return 1;
}


int do_ji(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision("$N想对兑换师祭法宝，前思后想，还是没敢。\n", who, me);

  return 1;
}

int do_throw(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision("$N掏出暗器，看了看兑换师，信心不足，又把暗器收了起来。\n", who, me);

  return 1;
}

int do_list(string arg) {
  object who = this_player();
  object me = this_object();
  message("vision", "" HIG "\n────────────────兑—换—道—具────────────────
          \n" HIC "宝石类：" HIY "
          1.原石(baoshi)" HIG "     【5点荣誉值：1颗】" HIY "   2. 天晶石(baoshi1)" HIG "  【100点荣誉值：1颗】" HIY " 
          3.佛舍利(baoshi2)" HIG "  【100点荣誉值：1颗】" HIY " 4. 天青石(baoshi3)" HIG "  【100点荣誉值：1颗】" HIY " 
          5.祝福宝石(baoshi4)" HIG "【100点荣誉值：1颗】" HIY " 6. 灵魂宝石(baoshi5)" HIG "【100点荣誉值：1颗】" HIY " 
          7.生命宝石(baoshi6)" HIG "【2000点荣誉值：1颗】" HIY " 
          \n" HIC "丹药类：" HIY " 
          1.养身丹(ysd)" HIG "     【500点荣誉值：1颗】" HIY "   2. 长生丹(csd)" HIG "  【500点荣誉值：1颗】" HIY " 
          3.人仙丹(rxd)" HIG "     【500点荣誉值：1颗】" HIY "   4. 地仙丹(dxd)" HIG "  【500点荣誉值：1颗】" HIY " 
          5.天仙丹(txd)" HIG "     【500点荣誉值：1颗】" HIY "   6. 灵仙丹(lxd)" HIG "  【500点荣誉值：1颗】" HIY " 
          7.鸿蒙丹(hmd)" HIG "     【500点荣誉值：1颗】" HIY "   8. 混沌丹(hdd)" HIG "  【500点荣誉值：1颗】" HIY " 
          9.度劫丹(djd)" HIG "     【3000点荣誉值：1颗】" HIY "   
          \n" HIC "装备类：" HIY " 
         1.新装备(item)" HIG "     【100点荣誉值：1件】" HIY "$
         " HIR "注：新装备包含武器与防具并有机会出现卓越属性，装备的等级与自身道行有关。
          \n" HIC "法宝类：" HIY " 
          <暂无>
          \n" HIC "技能类：" HIY " 
          <暂无>
" HIG "\n───────────────────────────────────────────\n" NOR "", who, me);
  return 1;
}

int do_yao(string arg) {
  string err;
  string type;
  object newitem, killer;
  object me = this_object();
  object ob;
  object who = this_player();
  if (!arg)
    return notify_fail("你想兑换什么？请用list查看兑换物品列表，用duihuan xxxx来兑换需要物品。\n");
  else {
    sscanf(arg, "%s", type);
    switch (type) {
      case "baoshi":
        if (who->query("qinmidu") < 5)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/baoshi.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -5);
          tell_object(who, "你用5点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "baoshi1":
        if (who->query("qinmidu") < 100)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/bs_tj.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -100);
          tell_object(who, "你用100点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "baoshi2":
        if (who->query("qinmidu") < 100)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/bs_fsl.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -100);
          tell_object(who, "你用100点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "baoshi3":
        if (who->query("qinmidu") < 100)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/bs_tq.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -100);
          tell_object(who, "你用100点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "baoshi4":
        if (who->query("qinmidu") < 100)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/bs_zf.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -100);
          tell_object(who, "你用100点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "baoshi5":
        if (who->query("qinmidu") < 100)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/bs_lh.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -100);
          tell_object(who, "你用100点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "baoshi6":
        if (who->query("qinmidu") < 2000)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/stone.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -2000);
          tell_object(who, "你用2000点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
        //兵器
      case "ysd":
        if (who->query("qinmidu") < 500)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/ysd.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -500);
          tell_object(who, "你用500点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "csd":
        if (who->query("qinmidu") < 500)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/csd.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -500);
          tell_object(who, "你用500点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "rxd":
        if (who->query("qinmidu") < 500)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/rxd.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -500);
          tell_object(who, "你用500点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "dxd":
        if (who->query("qinmidu") < 500)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/dxd.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -500);
          tell_object(who, "你用500点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "txd":
        if (who->query("qinmidu") < 500)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/txd.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -500);
          tell_object(who, "你用500点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "lxd":
        if (who->query("qinmidu") < 500)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/lxd.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -500);
          tell_object(who, "你用500点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "hmd":
        if (who->query("qinmidu") < 500)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/hmd.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -500);
          tell_object(who, "你用500点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "hdd":
        if (who->query("qinmidu") < 500)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/d/npc/vr_room/obj/hdd.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -500);
          tell_object(who, "你用500点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "djd":
        if (who->query("qinmidu") < 3000)
          return notify_fail("你的荣誉度不够! \n");
        ob = new("/u/xdao/gift/djd.lpc");
        if (objectp(ob)) {
          ob->move(who);
          who->add("qinmidu", -3000);
          tell_object(who, "你用3000点师徒荣誉值向兑换师换取了一颗" + ob->query("name") + "！\n");
        }
        break;
      case "item":
        if (who->query("qinmidu") < 100)
          return notify_fail("你的荣誉度不够! \n");
        killer = who;
        killer->set_temp("mieyao/level", 12);
        err = catch(newitem = NEWITEMS_OB->get_item(me, killer));
        newitem->move(killer);
        tell_object(
          killer,
          "你用100点师徒荣誉值向兑换师换取了一" + newitem->query("unit") + newitem->query("name") + "。\n" NOR
        );
        who->add("qinmidu", -100);
        break;



    }
  }
  return 1;

}
