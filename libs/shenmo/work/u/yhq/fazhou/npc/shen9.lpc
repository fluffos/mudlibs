#include <ansi.h>;
inherit NPC;
#include "star.h"


void create()
{
        set_name("申公豹", ({ "shen gongbao", "shen" }) );
        set("gender", "男性" );
	set("long",
		"伐纣大业挡路人----昆仑山叛徒申公豹\n"
	);
  set("str", 20);
  set("per", 130);
 set("age", 86);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", MAG "昆仑山叛徒" NOR);
  set("combat_exp", 4800000);
  set("daoxing", 4800000);
  set("max_sen", 6000);
  set("max_kee", 6000);
  set("family/family_name","昆仑山玉虚洞");

  set("force", 6000); 
  set("max_force", 6000);
  set("force_factor", 100);
  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 100);
	
              set_skill("literate", 500);
       set_skill("unarmed", 500);
       set_skill("dodge", 500);
       set_skill("parry", 500);
       set_skill("sword", 500);
        set_skill("huntian-jian", 500);
        set_skill("spells", 500);
        set_skill("yuxu-spells", 500);
        set_skill("kaitian-zhang", 500);
        set_skill("xuanzong-force", 500);
        set_skill("force", 500);
        set_skill("lingyunbu", 500);
        set_skill("wugou-jian", 500);
        map_skill("spells", "yuxu-spells");
	map_skill("unarmed", "kaitian-zhang");
	map_skill("force", "xuanzong-force");
	map_skill("parry", "huntian-jian");
	map_skill("dodge", "lingyunbu");
	map_skill("sword", "huntian-jian");
	set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
		(: cast_spell, "fantian" :),
		(: perform_action, "sword","lin" :),
        }) );

	setup();
   carry_object("/d/obj/weapon/sword/qinghong")->wield();
   carry_object("/d/obj/armor/jinjia")->wear();
}


void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
      
        add_action("do_none","ji");
}
int do_none()
{
        object me = this_object();
        message_vision("伐纣大业，岂容你乱来？\n",me);
        return 1;
} 


void die()
{

        object ob = query_temp("my_killer");

        if((ob&&ob->query("kunlun1/ba")=="done") && (ob&&ob->query("kunlun1/jiu")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIY+"【武王伐纣】姬发(Ji Fa):"+ob->name()+
        "闯过了伐纣第九关·城塘关\n"NOR,users());
        ob->set("kunlun1/jiu","done");
        ob->add("kunlun1/number",1);
         ob->add("daoxing", 10000);
           ob->save();
         tell_object(ob,"你赢得了十年道行");

        }
message_vision(HIY"$N死了....(伐纣大业成功的向前迈进了一大步) \n"NOR,this_object() );
       ::die();
}



