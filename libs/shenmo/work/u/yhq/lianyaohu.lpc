// lianyaohu.c
#include <ansi.h>
inherit ITEM;

void create() {
  set_name(MAG "炼" HIB "妖" HIY "壶" NOR, ({ "lianyao hu", "lianyao", "hu" }));
  set_weight(300);
  set("unit", "个");
  set("long",
    "这是一个神奇的炼妖壶。你可以收妖(shouyao)、炼妖(lianyao)
放妖(fangyao)。\n");
  set("no_get", 1);
  set("no_drop", 1);
  set(" no_steal", 1); /*********没定，参照宝物，换人就飞******/
}

void init() {
  add_action("do_shouyao", "shouyao");
  add_action("do_lianyao", "lianyao");
  add_action("do_fangyao", "fangyao");
  //	add_action("do_look", "look");
}

