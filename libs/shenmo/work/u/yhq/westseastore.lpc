
#include <ansi.h>
inherit ROOM;

int reset();
int reset2();

void create ()
{
  set ("short", HIW"西海边"NOR);
  set ("long", @LONG

这里是西海的海岸。西面茫茫大海望不到边际。海面上波涛
汹涌，几丈高的浪头此起彼伏，象是要吞灭一切敢于到海上的
东西。也许这里便是路的尽头，面前的大海对一个凡人来说是
不可逾越的。
LONG);

  set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"office",
]));
  set("no_fight", 1);

  setup();
}

void init()
{
add_action("do_swim", "swim");
add_action("do_dive", "dive");
}

int do_swim()
{
int i;
object *inv;
object me = this_player();
inv = all_inventory(me);
for(i=0; i<sizeof(inv); i++) {
 if ( userp(inv[i]) ) 
        return notify_fail("还是先把身上的玩家放下来再去吧！\n");            
 if ( inv[i]->query("id")=="yueguang baohe" )
        return notify_fail("还是先把身上的宝盒放下来再去吧！\n");            
	}
if ( !present("renma shengyi's head",me) )
          return notify_fail("你的圣衣头部呢？\n");

if( query("no_swim") == 0 )
	{        
	message_vision(HIY "$N纵身一跃，跳入海中。只见$N使足了全身力气，手足并用，不一会儿就游到了海中小岛上。\n" NOR, me);
	if (me->query_temp("ridee"))
	me->query_temp("ridee")->set_temp("rider",0);
	me->set_temp("ridee",0);
	me->add_temp("apply/dodge",-me->query_temp("ride/dodge"));
	me->set_temp("ride/dodge",0);
        me->move("/d/sds2/d_island1");
	message_vision(HIY "只见$N浑身湿漉漉地从海里爬了上来。\n" NOR, me);
	me->receive_damage("kee", 100);
	me->receive_damage("sen", 100);
	set("no_swim", 1);
	call_out("reset", 240);
	return 1;
	}
else  return notify_fail(HIW"刚 刚 有 人 去 岛 上 了 ，你 还 是 等 等 吧 。。。\n"NOR);

}

int reset()
{
set("no_swim", 0);
return 1;
}

int do_dive()
{
int i;
object me, zhou,where,*obs;
object ridee,ob;
obs = all_inventory(this_player());
i = sizeof(obs);
me=this_player();
ridee=me->ride();
where = this_object();

if( ( !(zhou=present("bishui zhou", me)) ||(string)zhou->query("unit")!="张")
       && (string)me->query("family/family_name")!="龙宫"
       && (string)me->query("family/family_name")!="东海龙宫")
	return notify_fail("你一个猛子扎到水里......\n"+"\n但没多会儿就被憋得半死，只好赶紧爬上岸来。\n");

if ( me->query("sds3/all")!="done" )
	return notify_fail("你一个猛子扎到水里......\n"+"\n可是却不知道下一步该做些什么，只好又爬上岸来。\n");

if ( where->query("no_dive")==1 )
	return notify_fail(HIG"\n一阵波浪将你打上岸来 。。。\n"NOR);

me->start_busy(1);
message_vision(HIG"\n$N"HIG"一个猛子扎到水中，翻腾的波浪立即将$P吞没了．\n\n" NOR, me);
me->move("/d/sea/under1");
message_vision(HIG"\n$N"HIG"从浪花中冲了出来。\n\n",me);
me->add("kee",-200);
me->add("sen",-200);
me->add("eff_kee",-100);
me->add("eff_sen",-100);
where->set("no_dive",1);

for(i=0; i<sizeof(obs); i++) //防止get player
	{
        if ( userp(obs[i]) ) 
		return notify_fail("还是先把身上的玩家放下来再去吧！\n");            
	}

while (i--)       //防止带moonbox & zhu
	{
	ob = obs[i];
	if ( ob->query("id")=="yueguang baohe" || ob->query("id")=="lei lingzhu"
	  || ob->query("id")=="shui lingzhu" || ob->query("id")=="tu lingzhu"
	  || ob->query("id")=="huo lingzhu" || ob->query("id")=="sheng lingzhu" )
		{
		message_vision(HIG"\n一阵水流涌过,$N"HIG"一个不提防,身上的$n"HIG"已经被冲走!\n"NOR,me,ob);	
		if (! interactive(ob))
			destruct (ob);
		else
			ob->move(environment(me));
		}
	}	

call_out("reset2", 200);
return 1;
}


int reset2()
{
set("no_dive", 0);
return 1;
}
