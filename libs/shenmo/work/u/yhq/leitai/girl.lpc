//girl.c  
// 1.ask 2 kill 3 find ou 4.give 
#include <ansi.h>  
               
inherit NPC;  
string ask_for_key();  

void create()  
{  
set_name("入场员", ({"man"}));  
set("long", HIC+@LONG

      刀    剑    无    眼

LONG+HIC);  
set("gender", "女性");  
set("age", 56);  
set("attitude", "friendly");  
set("shen_type", 1);  
set("per", 40);  
set("int", 40);  
set("str", 40);  
set("cps", 40);  
set("spi", 40);  
set("max_kee", 3000);  
set("max_gin", 3000);  
set("max_sen", 3000);  
set("max_force", 3000);  
set("force_factor", 200);  
set("max_mana", 5000);  
set("mana", 10000);  
set("mana_factor", 150);  
set("combat_exp", 5000000);  
set("inquiry", ([  
             "fight" : (: ask_for_key :),  
             "fight" : (: ask_for_key :),  
]) );  
setup();  
}  
       
string ask_for_key()  
{  
object who = this_player();  
if ( who->query("age")<15 )
	{
	who->move(__DIR__"under1");
	message("chat",HIC+"【西游记--神魔传说·比武】"NOR+HIW+who->query("name")+HIC"参加未成年组比赛。\n"NOR,users());     
	}
else if ( who->query("combat_exp")<1000000 )
	{
	who->move(__DIR__"under2");
	message("chat",HIC+"【西游记--神魔传说·比武】"NOR+HIW+who->query("name")+HIC"参加100万以下组比赛。\n"NOR,users());     
        }
else if ( who->query("combat_exp")<4000000 && who->query("combat_exp")>1000000 )
	{
	  who->move(__DIR__"under3");
	message("chat",HIC+"【西游记--神魔传说·比武】"NOR+HIW+who->query("name")+HIC"参加400万以下组比赛。\n"NOR,users());     
	}
else if ( who->query("combat_exp")<8000000 && who->query("combat_exp")>4000000 )
	{
	  who->move(__DIR__"under4");
	message("chat",HIC+"【西游记--神魔传说·比武】"NOR+HIW+who->query("name")+HIC"参加800万以下组比赛。\n"NOR,users());     
	}	
else if ( who->query("combat_exp")<15000000 && who->query("combat_exp")>8000000 )
	{
	  who->move(__DIR__"under5");
	message("chat",HIC+"【西游记--神魔传说·比武】"NOR+HIW+who->query("name")+HIC"参加1500万以下组比赛。\n"NOR,users());     
	}
else 	{
	who->move(__DIR__"under6");
	message("chat",HIC+"【西游记--神魔传说·比武】"NOR+HIW+who->query("name")+HIC"参加1500万以上组比赛。\n"NOR,users());     
	}
}  
       
