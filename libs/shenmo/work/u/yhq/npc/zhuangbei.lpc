#include <ansi.h>

inherit NPC;

void create()
{
            set_name(""HIC"☆TOM☆"NOR"", ({"npc yhq", "npc"}));
        set("long", "他是发送装备的☆TOM☆ 你可以(list)查看想要的东西。\n");
        set("gender", "女性");
	set("age", 20);
	set("per", 40);
        set("title",""HIG"☆天后☆");
	set_skill("literate", 141);
	set("chat_chance",20);
//    set("chat_msg", ({
  //      " ☆TOM☆轻声告诉你：你可以用list指令列出想要的东西！\n",
//        "☆TOM☆轻声告诉你：你可以用yao指令向魔术师我索取装备。\n",
//        "☆TOM☆轻声告诉你：你可以用yao指令向魔术师我索取装备。\n",
//        }));
	setup();
	carry_object("/d/obj/cloth/magua")->wear();
}

void init()
{
	::init();
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_cast", "cast");
  add_action("do_ji","ji");
  add_action("do_throw","throw");
  add_action("do_list","list");
  add_action("do_yao","yao");
}

void die()
{
 return;
}

int do_fight(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg && present(arg,environment(who))==me)
  {
        message_vision("$N看样子想打架，但☆TOM☆很有涵养,不和$N动粗。\n",who,me);
     return 1;
  }
  return 0;
}

int do_kill(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg && present(arg,environment(who))==me)
  {
message_vision("$N看样子想杀死☆TOM☆，但☆TOM☆是文化人,没跟$N一般见识。\n",who,me);

    return 1;
  }
  return 0;
}

int do_cast(string arg)
{
  object who = this_player();
  object me = this_object();

    message_vision("$N对着☆TOM☆结结巴巴的念了几句咒语，自己都感觉难听死了。\n",who,me);

  return 1;
}


int do_steal(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N想偷东西，但总是有贼心没贼胆。\n",who,me);

  return 1;
}


int do_ji(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N想对魔术师祭法宝，前思后想，还是没敢。\n",who,me);

  return 1;
}

int do_throw(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N掏出暗器，看了看☆TOM☆，信心不足，又把暗器收了起来。\n",who,me);

  return 1;
}

int do_list(string arg)
{
	object who = this_player();
	object me = this_object();
  message("vision",""HIG"\n─────────────────────────────────────
          \n"HIY"装备："HIC"
          1.金甲(armor)     2. 披风(pifeng)  
          3.战袍(cloth)     4.踏云靴(shoes)
          5.无限示(wuxian)  6.金币(jinbi)
          7.猕猴桃(tao)     8.云丹(yundan)
          9.潜能丹(qnd)     10.奥丁(aoding)
         11.宝盒(box)
"HIG"\n─────────────────────────────────────\n"NOR"",who,me);

  return 1;
}

int do_yao(string arg)
{
	string type;
	object ob;
	object who=this_player();
	object me=this_object();
        if (!arg)
		return notify_fail("你想要什么？兵器？还是盔甲？(比如:yao sword)\n");
	else 
	{
		sscanf(arg,"%s",type);
			switch(type)
			{
			//盔甲
			case "armor":
				ob=new("/d/snowtu/obj/armor.lpc");
				ob->set("no_sell", 1);
			        ob->set("no_drop", 1);
        			ob->set("no_give", 1);
				ob->move(who);
                                tell_object(who,"☆风琴☆把"+ob->query("name")+"交给你,并告诉你:带好，别乱丢哦！\n");
				break;
			case "pifeng":
				ob=new("/d/snowtu/obj/pifeng.lpc");
				ob->set("no_sell", 1);
			        ob->set("no_drop", 1);
