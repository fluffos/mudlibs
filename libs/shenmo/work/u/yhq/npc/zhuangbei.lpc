				ob->set("no_sell", 1);
			        ob->set("no_drop", 1);
        			ob->set("no_give", 1);
				ob->move(who);
                                  tell_object(who,"☆风琴☆把"+ob->query("name")+"交给你,并告诉你:带好，别乱丢哦！\n");
				break; 
                         case "jinbi":
				ob=new("/clone/money/jinbi.lpc");
				ob->set("no_sell", 1);
			        ob->set("no_drop", 1);
