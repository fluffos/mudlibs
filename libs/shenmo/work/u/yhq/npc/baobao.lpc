#include <ansi.h>
inherit NPC;
void create() {
  set_name("" HIR "【金贝贝】" NOR "", ({ "npc baobao", "npc" }));
  set("long", "他是天后☆风琴☆的儿子,你可以向他要补偿。\n");
  set("gender", "男性");
  set("age", 1);
  set("per", 40);
  set("title", "" HIG "☆庆祝今天一百天☆");
  set_skill("literate", 500);
  set("chat_chance", 20);
  set("chat_msg", ({
    "【金贝贝】轻声告诉你：我满一百天了，你可以用wish向我要礼物哦！\n",
    //        "☆风琴☆轻声告诉你：你可以用yao指令向魔术师我索取装备。\n",
    //        "☆风琴☆轻声告诉你：你可以用yao指令向魔术师我索取装备。\n",
  }));
  setup();
  carry_object("/d/obj/cloth/magua")->wear();
}

void init() {
  ::init();
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_cast", "cast");
  add_action("do_ji", "ji");
  add_action("do_throw", "throw");
  // add_action("do_list","list");
  add_action("do_wish", "wish");
}

void die() {
  return;
}

int do_fight(string arg) {
  object who = this_player();
  object me = this_object();

  if (arg && present(arg, environment(who)) == me) {
    message_vision("$N看样子想打架，但☆风琴☆很有涵养,不和$N动粗。\n", who, me);
    return 1;
  }
  return 0;
}

int do_kill(string arg) {
  object who = this_player();
  object me = this_object();

  if (arg && present(arg, environment(who)) == me) {
    message_vision("$N看样子想杀死【金贝贝】，但【金贝贝】是文化人,没跟$N一般见识。\n", who, me);

    return 1;
  }
  return 0;
}

int do_cast(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision("$N对着【金贝贝】结结巴巴的念了几句咒语，自己都感觉难听死了。\n", who, me);

  return 1;
}


int do_steal(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision("$N想偷东西，但总是有贼心没贼胆。\n", who, me);

  return 1;
}


int do_ji(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision("$N想对魔术师祭法宝，前思后想，还是没敢。\n", who, me);

  return 1;
}

int do_throw(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision("$N掏出暗器，看了看【金贝贝】，信心不足，又把暗器收了起来。\n", who, me);

  return 1;
}



int do_wish(string arg) {
  string type;
  object ob;
  object who = this_player();
  object me = this_object();
  if (this_player()->query("liwu1") > 0) {
    message_vision("$N对着$n哼了一声。\n", this_object(), this_player());
    command("say 补偿只有一份！领过就不给了！\n");
    return 1;
  }
  //  if (who->query("combat_exp")<500000)
  //         return notify_fail("你的经验值这么低，不会是大米来骗礼物的吧。还是先练到50万再来找我要吧:P\n");
  if (!arg)
    return notify_fail("你想要什么？比如:wish wx , qn , dh . 但是你只能要一个哦!\n");
  else {
    sscanf(arg, "%s", type);
    switch (type) {
      case "wx":
        who->add("combat_exp", 100000);
        who->set("liwu1", 1);
        tell_object(who, "【金贝贝】说道,今天我满一百天，谢谢光临！\n");
        break;
      case "qn":
        who->add("potential", 100000);
        who->set("liwu1", 1);
        tell_object(who, "【金贝贝】说道,今天我满一百天，谢谢光临！\n");
        break;
      case "dx":
        who->add("daoxing", 100000);
        who->set("liwu1", 1);
        tell_object(who, "【金贝贝】说道,今天我满一百天，谢谢光临！\n");
        break;
        //兵器
      case "sword":
        ob = new("/d/city/npc/obj/sword.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "☆风琴☆把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
      case "whip":
        ob = new("/d/city/npc/obj/whip.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "☆风琴☆把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
      case "blade":
        ob = new("/d/city/npc/obj/blade.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "☆风琴☆把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
      case "stick":
        ob = new("/d/city/npc/obj/stick.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "☆风琴☆把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
      case "spear":
        ob = new("/d/city/npc/obj/spear.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "☆风琴☆把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
      case "fork":
        ob = new("/d/city/npc/obj/fork.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "☆风琴☆把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
      case "hammer":
        ob = new("/d/city/npc/obj/hammer.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "☆风琴☆把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
      case "qin":
        ob = new("/d/city/npc/obj/qin.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "☆风琴☆把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
      case "axe":
        ob = new("/d/city/npc/obj/axe.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "☆风琴☆把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
      case "staff":
        ob = new("/d/city/npc/obj/staff.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "☆风琴☆把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
      case "zhua":
        ob = new("/d/city/npc/obj/zhua.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "☆风琴☆把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
      case "mace":
        ob = new("/d/obj/weapon/mace/malemace.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "☆风琴☆把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
      case "zhen":
        ob = new("/d/city/npc/obj/yinzhen.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "☆风琴☆把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
    }
  }
  return 1;

}
