inherit NPC;

void create()
{
  set_name("黄金", ({"huang jin", "gold", "jin"}) );
  set("gender", "女性" );
  set("age", 20);
  set("long","金沉沉的金子。\n");

  set("combat_exp", 2500);
  set("str", 15);
  set("attitude","heroism");

  setup();
  carry_object("/d/obj/cloth/skirt")->wear();
}

void init()
{
  remove_call_out ("says");
  if(userp(this_player())) {
  add_action ("do_sleep","sleep");
  call_out("says",random(3),this_object());
  }
}

int do_sleep ()
{
  object me = this_object();
  object who = this_player();
  message_vision ("$N搂着$n柔软的身体，不由得心醉神迷……\n\n",who,me);
  who->command_function("remove all");
  who->start_busy(3,3);

who->set("ice/tianji","done");
who->set("ice/beiji","done");
who->set("ice/kaiyang","done");
who->set("ice/cloth","done");
who->set("ice/tianquan","done");
who->set("ice/tianshu","done");
who->set("ice/number",9);
who->set("ice/yaoguang","done");
who->set("ice/yuheng","done");
who->set("ice/tianxuan","done");
who->set("sds4/mry","done");
who->set("sds4/king","done");
who->set("sds4/box","done");
who->set("sds4/number",8);
who->set("sds4/yi","done");
who->set("sds4/er","done");
who->set("sds4/san","done");
who->set("sds4/si","done");
who->set("sds4/wu","done");
who->set("sds4/liu","done");
who->set("sds4/qi","done");
  remove_call_out ("get_fainted");
  call_out ("get_fainted",1,who,me);
  remove_call_out ("says");
  call_out("says",40,me);
  return 1;
}

void get_fainted (object who, object me)
{
  object *objs = all_inventory(who);
  int i = sizeof (objs);
  message_vision ("$N对$n神秘地一笑。\n\n",me,who);
  //who->unconcious();    
 }
