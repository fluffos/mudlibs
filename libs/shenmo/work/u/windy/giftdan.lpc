#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIG "属性丹" NOR, ({ "shuxing dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗七彩纷呈的灵丹妙药，流光四射。\n");
    set("value", 10000);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  this_player()->add("int", 5 - (int)this_player()->query("gift/xiandan"));
  this_player()->set("gift/xiandan", 5);
  this_player()->add("con", 5 - (int)this_player()->query("gift/xisuidan"));
  this_player()->set("gift/xisuidan", 5);
  this_player()->add("str", 5 - (int)this_player()->query("gift/shenliwan"));
  this_player()->set("gift/shenliwan", 5);
  message_vision(HIG "\n$N吃下一颗属性丹,立即发觉体内发生了一系列奇妙的变化!\n\n" NOR, this_player());
  destruct(this_object());
  return 1;
}
