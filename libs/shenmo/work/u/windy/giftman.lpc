
#include <ansi.h> 
inherit NPC; 

int give_betray(); 
int give_chushi(); 
int give_dan();
int huan_card();
int ask_spskk();
int ask_shaolin();
void create() 
{
set_name("无影居士", ({"wuying jushi", "jushi" "wuying"})); 
set("long", "无影居士最近已经很少在江湖行走了，但是只要见到他就肯定有好事。\n"); 
set("gender", "男性"); 
set("age", 26); 
set("per", 40); 
set("title",HIW"天地任逍遥"NOR); 
set_skill("force", 1000); 
set_skill("spells", 1000); 
set_skill("dodge", 1000); 
set_skill("unarmed", 1000); 
set_skill("parry", 1000); 
set_skill("literate", 1000); 
set("max_force", 6000); 
set("max_mana", 6000); 
set("mana", 6000); 
set("force", 6000); 
set_weight(10000000);
set("inquiry", ([ 
    "叛师"    :(:give_betray:), 
    "chushi"    :(:give_chushi:), 
    "出师"    :(:give_chushi:), 
    "panshi"    :(:give_betray:), 
//    "春节礼物"    :(:give_dan:), 
    "调整二转特技"    :(:ask_spskk:), 
    "调整少林武技"    :(:ask_shaolin:), 
])); 
setup(); 
carry_object("/d/shaolin/obj/jingang-zhao")->wear(); 
}
void init() 
{
      ::init(); 
add_action("do_like","like"); 
}
void die() 
{
set("eff_kee", 6000);
set("eff_sen", 6000); 
set("kee", 6000); 
set("sen", 6000); 
set("force", 6000);
set("mana", 6000);
}
void unconcious() 
{
  die (); 
}
int do_like(string arg) 
{
    string type;
    object ob;
    object who=this_player(); 
    object me=this_object(); 
if ((int)this_player()->query("windy") >= 20131001  ){ 
message_vision("$N对着$n笑道：贪多必失。\n",this_object(),this_player()); 
return 1;
}
if (who->query("combat_exp")<500000) 
return notify_fail("我怀疑你是个标准的大米，不要也罢！\n"); 
if (!arg) 
return notify_fail("你喜欢什么？只能:like exp（经验）,like level（等级）,like pot（潜能）)\n"); 
else 
    {
    tell_object(who,HIG"值此中秋国庆双节之际送给，西游记--神魔传说祝您和您的家人节日快乐--------\n\n\n"NOR); 
    tell_object(who,HIM"明月几时有？把酒问青天。\n"NOR); 
    tell_object(who,HIM"不知天上宫阙，今夕是何年？\n"NOR); 
    tell_object(who,HIM"我欲乘风归去，唯恐琼楼玉宇。\n"NOR); 
    tell_object(who,HIM"高处不胜寒！\n"NOR); 
    tell_object(who,HIM"起舞弄清影，何似在人间？\n\n"NOR); 
    tell_object(who,HIM"转朱阁，低绮户，照无眠。\n"NOR); 
    tell_object(who,HIM"不应有恨，何事长向别时圆。\n"NOR); 
    tell_object(who,HIM"人有悲欢离合，月有阴晴圆缺。\n"NOR); 
    tell_object(who,HIM"此事古难全！\n"NOR); 
    tell_object(who,HIM"但愿人长久，千里共婵娟！\n\n\n"NOR); 
//    tell_object(who,HIG"值此端午佳节之际之际，西游记--神魔传说祝您和您的家人节日快乐！！！！！！\n"NOR); 
    sscanf(arg,"%s",type); 
        switch(type) 
        {
        case "exp": 
            who->add("combat_exp",800000); 
            who->add("daoxing",800000); 
            who->set("windy",20131001); 
            tell_object(who,"无影居士说道：送给你八十万武学和八百年道行吧，别嫌少！\n"); 
            break; 
        case "level": 
            who->add("level",1); 
            who->set("windy",20131001); 
            tell_object(who,"无影居士说道：送给你等级一级吧，别嫌少！\n"); 
            break; 
        case "pot": 
            who->add("potential",800000); 
            who->add("shen",80); 
            who->set("windy",20131001); 
            tell_object(who,"无影居士说道：送给你八十万潜能和八十点元神吧，别嫌少！\n"); 
            break; 
        }
    }
return 1;
}
int give_betray()
{
object who=this_player(); 
if (who->query("family/family_name") == "少林寺" ){ 
       command("say 大神说了，少林寺不能来我这里叛师！"); 
       return 1; 
}
if (who->query("zhuanshi") == 0 ){ 
       command("say 你还不够资格来我这里叛师！"); 
       return 1; 
}
if (who->query("combat_exp") < 2000000 ){ 
       command("say 你现在的水平绝对是一个标准的大米，等你多一些江湖经验再来吧！"); 
       return 1; 
}
if (who->query("daoxing") < 2000000 ){ 
       command("say 你现在的水平绝对是一个标准的大米，等你多一些江湖经验再来吧！"); 
       return 1; 
}
if( who->query("class")== "saint")
{
       command("say 你是圣族，判师对你没有意义了！"); 
       return 1;
}
if ( "无性" == who->query("gender") || who->query("family/family_name") == "神策军" )
{
    command("say 你是公公，叛师对你没有用!\n");
    return 1;
}
who->set("title",HIG"隐士"NOR); 
who->add("叛师/num",1);
who->delete("family"); 
if (who->query("zhuanshi")==1)
        {
        who->add("combat_exp", -1000000);
        who->add("daoxing", -1000000);
        }
if (who->query("zhuanshi")==2)
        {
        who->add("combat_exp", -500000);
        who->add("daoxing", -500000);
        }
if (who->query("zhuanshi")==3)
        {
        who->add("combat_exp", -50000);
        who->add("daoxing", -50000);
        }
who->save();
command("ok"); 
message_vision("$N"CYN"向$n"CYN"微微一皱眉，$n"CYN"顿时觉得身体里发生了奇妙的变化。\n",this_object(),this_player()); 
return 1; 
}

int ask_spskk()
{
int k;
object who=this_player(); 
if (who->query("zhuanshi") < 2 ){ 
       command("say 你还没有二转，来这里凑什么热闹！？"); 
       return 1; 
}
if ((int)who->query("spskk") != 0 ){ 
       command("say 你的二转特技没有问题，一边呆着去！"); 
       return 1; 
}
k=1+random(15);
who->set("spskk",k);
who->save();
command("ok"); 
message_vision("$N"CYN"向$n"CYN"微微一颔首，$n"CYN"顿时觉得身体里发生了奇妙的变化。\n",this_object(),this_player()); 
command("say 你的二转特技调整完毕，至于是什么，可以到地府问一下楚江王。"); 
return 1; 
}
int ask_shaolin() 
{
int i, j, k;
object who=this_player();
if (!who->query_skill("banruo-zhang") && !who->query_skill("jingang-leg")){
       command("say 你不需要调整！");  
       return 1;  
        }
i = (int)who->query_skill("banruo-zhang", 1);
j = (int)who->query_skill("jingang-leg", 1);
if (who->query_skill("banruo-zhang"))
       {
       who->delete_skill("banruo-zhang");
       who->set_skill("bore-zhang", i);
        }
if (who->query_skill("jingang-leg"))
       {
       who->delete_skill("jingang-leg");
       who->set_skill("suixing-tui", j);
        }
command("ok"); 
command("say 你的般(ban)若(ruo)掌已经转化为般(bo)若(re)掌，你的大力金刚腿已经转化为如影随形腿。"); 
return 1; 
}
int give_chushi()
{
object who=this_player(); 
if (who->query("family/family_name") == "少林寺" ){ 
       command("say 大神说了，少林寺不能来我这里叛师！"); 
       return 1; 
}
if ( "无性" == who->query("gender") || who->query("family/family_name") == "神策军" )
{
    command("say 你是公公，出师对你没有用!\n");
    return 1;
}
if (who->query("zhuanshi") == 0 ){ 
       command("say 你还不够资格出师！"); 
       return 1; 
}
if (who->query("shilian") == 0 ){ 
       command("say 你还是先去通过不周山试炼塔的考验吧！"); 
       return 1; 
}
if (who->query("combat_exp") < 10000000 ){ 
       command("say 你现在的水平绝对是一个标准的大米，等你多一些江湖经验再来吧！"); 
       return 1; 
}
if (who->query("daoxing") < 10000000 ){ 
       command("say 你现在的水平绝对是一个标准的大米，等你多一些江湖经验再来吧！"); 
       return 1; 
}
if( who->query("class")== "saint")
{
       command("say 你是圣族，出师对你没有意义了！"); 
       return 1;
}
who->set("title",HIG"逸士"NOR); 
who->delete("family"); 
if (who->query("zhuanshi")==1)
        {
        who->add("combat_exp", -1000000);
        who->add("daoxing", -1000000);
        }
if (who->query("zhuanshi")==2)
        {
        who->add("combat_exp", -500000);
        who->add("daoxing", -500000);
        }
who->save();
command("ok"); 
message_vision("$N"CYN"向$n"CYN"微微一颔首，$n"CYN"顿时觉得身体里发生了奇妙的变化。\n",this_object(),this_player()); 
return 1; 
}

int give_dan()
{
object dan;
object me = this_player();
if( me->query("礼物记录/12年春节")>0 )
        {
        command("say 贪多必失！");  
        return 1; 
        }
command("say 好吧，只有一颗，别丢了哈！");  
command("say 我代表西游记--神魔传说祝你全家人春节快乐！");  
dan=new("/u/windy/npc/obj/wan"); 
dan->move(me); 
message_vision("$N给$n一颗"+dan->name()+"。\n",this_object(),me); 
me->add("礼物记录/12年春节", 1);
return 1;
}
