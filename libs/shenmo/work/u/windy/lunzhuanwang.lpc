//puti.c
//inherit NPC;
#include <ansi.h>
inherit "/d/dntg/hell/wang.lpc";
inherit F_MASTER;
int give_zhuanshi();

void create() {
  set_name("轮转王", ({ "lunzhuan wang", "wang" }));
  set("title", "阴间十王之");
  set("gender", "男性");
  set("age", 70);
  set("class", "xian");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("per", 30);
  set("int", 30 + random(5));
  set("max_kee", 900);
  set("max_gin", 700);
  set("max_sen", 700);
  set("force", 450);
  set("max_force", 400);
  set("force_factor", 30);
  set("max_mana", 800);
  set("mana", 800);
  set("mana_factor", 40);
  set("combat_exp", 660000);
  set("daoxing", 500000);

  set_skill("spells", 100);
  set_skill("gouhunshu", 100);
  set_skill("unarmed", 139);
  set_skill("dodge", 139);
  set_skill("parry", 130);
  set_skill("force", 100);
  set_skill("tonsillit", 100);
  map_skill("spells", "gouhunshu");
  map_skill("force", "tonsillit");
  set("inquiry", ([
    "转世": (: give_zhuanshi :),
  ]));
  create_family("阎罗地府", 1, "你好");
  setup();

  carry_object("/d/obj/cloth/mangpao")->wear();
  //        carry_object("/d/lingtai/obj/shoe")->wear();
  //        carry_object("/d/lingtai/obj/putibang")->wield();
}

int give_zhuanshi() {
  string *skname;
  mapping skills;
  int i, j, m, k;
  object who = this_player();

  if ((int)who->query("zhuanshi") == 0) {
    command("say 若是初次投胎转世，还是去找王方平吧！");
    return 1;
  }
  if ((int)who->query("zhuanshi") == 2) {
    command("say 若想第三次投胎转世，就去找地藏王菩萨吧！");
    return 1;
  }
  if ((int)who->query("zhuanshi") == 3) {
    command("say 失敬！失敬！你永远不会再受那轮回之苦了！");
    return 1;
  }
  if ((int)who->query("level") < 750) {
    command("say 你的等级不足，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query("combat_exp") < 300000000) {
    command("say 你的武学不足，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query("daoxing") < 300000000) {
    command("say 你的道行不足，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query("shen") < 200) {
    command("say 你现在元神太低，进了油锅恐怕就难出来了！");
    return 1;
  }
  if ((int)who->query_skill("force", 1) < 750) {
    command("say 你的内功心法修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query_skill("spells", 1) < 750) {
    command("say 你的基本法术修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query_skill("dodge", 1) < 750) {
    command("say 你的基本轻功修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query_skill("unarmed", 1) < 750) {
    command("say 你的扑击格斗之技修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query_skill("parry", 1) < 750) {
    command("say 你的拆招卸力之法修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query_skill("literate", 1) < 750) {
    command("say 你的读书识字水平太差，还是过些时间再来吧！");
    return 1;
  }
  if (!who->query("obstacle/reward")) {
    command("say 你先去西域求取真经吧！");
    return 1;
  }
  if (who->query("dntg/laojunlu") != "done") {
    command("say 无名鼠辈，休得烦我！");
    return 1;
  }
  if (who->query_temp("erzhuan") == 0) {
    command("say 经过泰山、都市、卞城三王的允许了么？");
    return 1;
  }

  who->set("zhuanshi", 2);
  if (who->query_temp("erzhuan") == "xian") {
    who->set("classxt", "xian");
    who->set("class", "xian");
  }
  if (who->query_temp("erzhuan") == "human") {
    who->set("classxt", "human");
    who->set("class", "human");
  }
  if (who->query_temp("erzhuan") == "yao") {
    who->set("classxt", "yao");
    who->set("class", "yao");
  }
  if (random(2)) who->set("gender", "女性");
  else who->set("gender", "男性");

  who->set("max_kee", 200);
  who->set("kee", 200);
  who->set("eff_kee", 200);
  who->set("max_sen", 250);
  who->set("sen", 250);
  who->set("eff_sen", 250);
  who->set("maximum_force", 0);
  who->set("max_force", 0);
  who->set("force", 0);
  who->set("force_factor", 0);
  who->set("maximum_mana", 0);
  who->set("max_mana", 0);
  who->set("mana", 0);
  who->set("mana_factor", 0);
  who->set("combat_exp", 1000000);
  who->set("daoxing", 1000000);
  who->set("office_number", 0);
  who->delete("degree");
  who->set("bellicosity", 0);
  who->set("haomao", 3);

  who->set("叛师/num", 0);
  who->set("title", "普通百姓");
  who->delete("family");
  who->set("age", 14);
  who->set("mud_age1", (int)who->query("mud_age"));
  who->set("mud_age", 0);
  who->set("MKS", 0);
  who->set("PKS", 0);
  who->set("DIE", 0);
  who->set("weiwang", 0);
  who->set("faith", 0);
  who->set("shen", 0);
  who->delete("swordman/dead_perform");
  who->delete("swordman/tianxiang_perform");
  who->delete("swordman/zhizhixiong");
  who->delete("swordman/wuxiang_perform");
  who->delete("swordman/yanling_perform");
  who->delete("obstacle");
  who->delete("dntg");
  who->delete("bieji1");
  who->delete("bieji");
  who->delete("9sky");
  who->delete("gift");
  who->set("xiuluo/give_rulai", "done");

  skills = who->query_skills();
  if (mapp(skills)) {
    skname = keys(skills);
    for (i = 0; i < sizeof(skname); i++)
      who->delete_skill(skname[i]);
  }
  who->set_skill("force", 100);
  who->set_skill("spells", 100);
  who->set_skill("unarmed", 100);
  who->set_skill("dodge", 100);
  who->set_skill("parry", 100);
  who->set_skill("literate", 100);

  who->set("shilian", 0);
  who->set("ziyougift", 0);
  who->set("chshjue_ask", 0);
  who->set("chshjue_agree", 0);
  who->set("dzxy_ask", 0);
  who->set("dzxy_agree", 0);
  who->set("yumo_ask", 0);
  who->set("yumo_agree", 0);
  who->set("wuhu_ask", 0);
  who->set("wuhu_agree", 0);
  who->set("dgbang_ask", 0);
  who->set("dgbang_agree", 0);
  who->set("xlzhang_ask", 0);
  who->set("xlzhang_agree", 0);
  who->set("lbwb_try", 0);
  who->set("lbwb_agree", 0);
  who->add("spi", 5);
  message(
    "channel:rumor",
    HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "二转成功了！\n" + NOR,
    users()
  );
  message(
    "channel:rumor",
    HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "的先天灵性提升了五点！\n" + NOR,
    users()
  );

  j = random(4);
  if (j == 1) {
    who->set("chshjue_ask", 1);
    who->set("chshjue_agree", 2);
    who->set_skill("changshengjue", 100);
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世神功----" + HIW "长生诀" NOR + HIB "！\n" + NOR,
      users()
    );
  } else if (j == 2) {
    who->set("dzxy_ask", 1);
    who->set("dzxy_agree", 2);
    who->set_skill("douzhuan-xingyi", 100);
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世神功----" + HIW "斗转星移" NOR + HIB "！\n" + NOR,
      users()
    );
  } else if (j == 3) {
    who->set("yumo_ask", 1);
    who->set("yumo_agree", 2);
    who->set_skill("jadesword", 100);
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世神功----" + HIW "玉魔剑法" NOR + HIB "！\n" + NOR,
      users()
    );
  } else {
    who->set("lbwb_agree", 2);
    who->set_skill("lingbo-weibu", 100);
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世神功----" + HIW "凌波微步" NOR + HIB "！\n" + NOR,
      users()
    );
  }

  m = random(5);
  if (m == 1) {
    who->set("wuhu_ask", 1);
    who->set("wuhu_agree", 2);
    who->set_skill("wuhu-blade", 100);
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世神功----" + HIW "五虎断门刀" NOR + HIB "！\n" + NOR,
      users()
    );
  } else if (m == 2) {
    who->set("dgbang_ask", 1);
    who->set("dgbang_agree", 2);
    who->set_skill("dagou-bang", 100);
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世神功----" + HIW "打狗棒法" NOR + HIB "！\n" + NOR,
      users()
    );
  } else if (m == 3) {
    who->set("xlzhang_ask", 1);
    who->set("xlzhang_agree", 2);
    who->set_skill("xianglong-zhang", 100);
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世神功----" + HIW "降龙十八掌" NOR + HIB "！\n" + NOR,
      users()
    );
  } else if (m == 4) {
    who->set("tianhe_agree", 1);
    who->set_skill("skyriver-rake", 100);
    who->set_skill("rake", 100);
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世神功----" + HIW "天河耙法" NOR + HIB "！\n" + NOR,
      users()
    );
  } else {
    who->set("dianxue_agree", 1);
    who->set_skill("dianxue", 100);
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世神功----" + HIW "葵花点穴手" NOR + HIB "！\n" + NOR,
      users()
    );
  }

  k = 1 + random(15);
  who->set("spskk", k);
  if (k == 1)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "鸿儒" NOR + HIB "！\n" + NOR,
      users()
    );
  else if (k == 2)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "妙法" NOR + HIB "！\n" + NOR,
      users()
    );
  else if (k == 3)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "灵动" NOR + HIB "！\n" + NOR,
      users()
    );
  else if (k == 4)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "驱逐" NOR + HIB "！\n" + NOR,
      users()
    );
  else if (k == 5)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "禁咒" NOR + HIB "！\n" + NOR,
      users()
    );
  else if (k == 6)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "奇袭" NOR + HIB "！\n" + NOR,
      users()
    );
  else if (k == 7)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "连环" NOR + HIB "！\n" + NOR,
      users()
    );
  else if (k == 8)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "怒发" NOR + HIB "！\n" + NOR,
      users()
    );
  else if (k == 9)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "养精" NOR + HIB "！\n" + NOR,
      users()
    );
  else if (k == 10)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "养气" NOR + HIB "！\n" + NOR,
      users()
    );
  else if (k == 11)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "养神" NOR + HIB "！\n" + NOR,
      users()
    );
  else if (k == 12)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "慧根" NOR + HIB "！\n" + NOR,
      users()
    );
  else if (k == 13)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "慧缘" NOR + HIB "！\n" + NOR,
      users()
    );
  else if (k == 14)
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "长生" NOR + HIB "！\n" + NOR,
      users()
    );
  else
    message(
      "channel:rumor",
      HIB + "\n【" + HIR " 六道轮回 " NOR + HIB "】某人：" + who->query("name") + "得到了转世特技----" + HIW "皇亲" NOR + HIB "！\n" + NOR,
      users()
    );
  who->save();
  return 1;
}
