#include <ansi.h>
inherit ITEM;

#define C_DIR(x) "/daemon/condition/"+x

void create() {
  set_name(HIG "辟毒珠" NOR, ({ "pidu zhu", "zhu" }));
  set_weight(120);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("long", "一颗珍贵的辟毒珠，可以用来解毒(jiedu)。\n");
    set("value", 2000000);
    set("drug_type", "仙丹");
    set("no_drop", "这么宝贵的辟毒珠，哪能乱扔! \n");
    set("no_give", "这么宝贵的辟毒珠，还是自己留着吧! \n");
    set("no_sell", "这么宝贵的辟毒珠，还是自己留着吧! \n");
  }
  set("cure_num", 25 + random(25));
  setup();
}

void destruct_me() {
  write(HIB + name() + HIB "“啪”的一声，碎成八瓣了。。。\n" NOR);
  destruct(this_object());
}

void check_me() {
  remove_call_out("check_me");
  if (query("cure_num") < 1)
    destruct_me();
  else call_out("check_me", 1);
}

void init() {
  if (query("cure_num") < 1)
    destruct_me();
  else {
    remove_call_out("check_me");
    call_out("check_me", 1);
  }
  add_action("do_jiedu", "jiedu");
}

int do_jiedu(string arg) {
  mixed cd;
  int i;
  string *cds, str;
  object who, me = this_player(1);

  if (me->is_busy())
    return notify_fail(HIG "你现在正忙着，不能替自己解毒！\n" NOR);
  if (query("cure_num") < 1) {
    destruct_me();
    return 1;
  }
  if (!arg)
    who = me;
  else {
    who = present(arg, environment(me));
    if (!who)
      return notify_fail("没有这个人。\n");
    if (who->is_busy())
      return notify_fail("对方正忙着呢。\n");
  }
  str = who->query("limbs")[random(sizeof(who->query("limbs")))];
  str = "$N将" + name() + "用力的在$n" + str + "上摩擦。\n";
  me->start_busy(1 / 2, 0);
  who->start_busy(1 / 2, 0);
  if (me != who)
    message_vision(str, me, who);
  else message_vision(
    "$N将" + name() + "在" + me->query("limbs")[random(sizeof(me->query("limbs")))] + "上擦了擦。。。\n",
    me
  );

  str = "";
  if ((who->query("kar") + who->query_temp("spring/cure_times")) > 1) {
    who->update_condition();
    cd = who->query_entire_conditions();
    who->set_temp("毒", cd);
    if (!cd || !mapp(cd)) {
      tell_object(who, "你又没中毒。。。。\n");
      return 1;
    }
    cds = keys(cd);
    i = sizeof(cds);
    while (i--) {
      if (file_size("/daemon/condition/" + cds[i] + ".lpc") <= 0)
        continue;
      if (("/daemon/condition/" + cds[i] + ".lpc")->name() == "系统")
        continue;
      str = "你身中的" + ("/daemon/condition/" + cds[i] + ".lpc")->name();
      if (!("/daemon/condition/" + cds[i] + ".lpc")->can_clear()) {
        str += name() + "不能解除。\n";
        continue;
      } else str += "已经解了。\n";
      who->clear_condition(cds[i]);
      who->add_temp("spring/cure_times", 1);
    }
  }
  tell_object(who, str);
  this_object()->add("cure_num", -1);
  return 1;
}
