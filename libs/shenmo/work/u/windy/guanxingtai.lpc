// write by windy
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "观星台");
  set("long", @LONG
这里是小雁塔塔顶的一个三尺见方的小平台，站在这里
一眼望去，长安城尽收眼底。要是到了晚上，这里还是一个
看星星(xing)的绝好地点。不过，一般人是找不到这里的。
LONG
  );
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_jump", "jump");
  add_action("do_kan", "kan");
}

int do_jump(string arg) {
  object me = this_player();
  if (me->query_skill("dodge", 1) < 200)
    return notify_fail("这里这么高，你不怕摔死？\n");
  if (!arg || arg != "down")
    return notify_fail("你要往哪里跳？\n");
  message_vision("$N纵身跳了下去。\n", me);
  me->move("/d/eastway/xyt");
  return 1;
}

int do_kan(string arg) {
  int dayphase;
  object me = this_player();
  dayphase = NATURE_D->query_current_day_phase();
  if (!arg || arg != "xing")
    return notify_fail("你要看什么？\n");
  if ((int)me->query_skill("literate", 1) < 200)
    return notify_fail("你的读书识字级别不够，无法领悟出斗转星移的绝妙之处。\n");
  if ((int)me->query("dzxy_agree") < 2)
    return notify_fail("你仰首望天，天上繁星点点，你似乎觉得星斗的移动与你所学的“斗转星移”有莫大的联系，却无法领会。\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你现在精神不好，还是不要到处乱看了。\n");
  if (dayphase < 6)
    return notify_fail("大白天的看什么星星啊！\n");
  write("你仰首望天，天上繁星点点，你体会出了星斗的移动与你所学的“斗转星移”有莫大的联系！\n");
  me->receive_damage("sen", random(50));
  me->improve_skill("douzhuan-xingyi", (int)me->query_skill("literate", 1) / 2);
  return 1;
}
