
#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_drink", "drink");
}

void create()
{
        set_name(HIR"只爱一条柴"NOR, ({"chun yao", "yao"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "瓶");
                set("long", "绝世灵药，其效力犹在阴阳合欢散之上,堪称烈士贞女的克星。\n");
                set("value", 10000);
        }
        setup();
}

int do_drink(string arg)
{
        object me = this_player();

        if (!id(arg))
        return notify_fail("你要喝什么？\n");
        message_vision(HIR "\n$N将整瓶的药水全都喝下去了, 随手把瓶子扔到了背后! \n\n" NOR, this_player());
        if (me->query("gender")=="男性")
                tell_object(me, HIM"突然间你感觉丹田之内升腾起一股热流, 通体燥热难当, 神志渐渐不清! \n"NOR);
        else
                tell_object(me, HIM"突然间你感觉丹田之内升腾起一股热流, 通体奇痒难耐, 神志渐渐不清! \n"NOR);
        me->apply_condition("chunyao", 10);
        destruct(this_object());
        return 1;
}


