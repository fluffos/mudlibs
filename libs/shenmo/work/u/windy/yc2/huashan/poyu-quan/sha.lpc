#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int i, damage, tui, fly, j;
  string powercol;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招〖瞬·狱·杀〗？\n");

  if (!me->is_fighting())
    return notify_fail("〖瞬·狱·杀〗只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力不够！\n");
  if (me->query("family/family_name") != "格斗家" && !me->samsara_check("yuanwu-kungfu", 1))
    return notify_fail("你从哪里偷学的功夫？\n");


  if ((int)me->query("force") < 50 + me->query("force_factor"))
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 200)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if (me->query_temp("sha_busy")) return notify_fail("绝招用多就不灵了。\n");

  damage = (i + j) * 2 + me->query("force_factor") + me->query("apply/damage") + me->query_skill("literate");

  if (me->query_temp("yi")) damage = damage * 3 / 2;

  damage = damage / 2 + random(damage / 2);

  if (damage < 1000) damage = 1000;

  message_vision(BLU "\n微笑，一个极其诡异的微笑在$N" + BLU "嘴角缓缓展现。\n" NOR, me, target);
  message_vision(BLU "恐惧，一股令人恶寒的恐惧在$n" + BLU "心际蓦然诞生。\n" NOR, me, target);
  message_vision(BLU "强烈的血腥味随风而至，$n回神四顾，豁然发现，炼狱，一个活生生的修羅炼狱，而自己，正身处其中！！\n" NOR, me, target);
  message_vision(BLU "$n急忙纵身欲跳出此炼狱，一道劲而疾的风袭来，$N" + BLU "双手已迎面抓至！\n" NOR, me, target);


  if (random(me->query("combat_exp") * me->query_int() / 80)
    > (int)target->query("combat_exp") * target->query_int() / 250) {

    message_vision(
      HIR "\n$n避无可避，被$N" + HIR "抓了个正着，轰的一声巨响，整个人被重重摔至地面，登时胸前一闷，鲜血狂喷不止。\n" NOR,
      me,
      target
    );
    message_vision(HIR "一道人影飘然而至，刹那间，万千劲气袭身而来，蚀肉销骨，$n如堕修羅炼狱,惨叫连连。\n" NOR, me, target);

  } else {

    message_vision(HIG "\n$n急忙提气运劲，在半空中硬是横移了数丈，堪堪躲过这招。\n" NOR, me, target);
    message_vision(HIG "$N" + HIG "所造修羅炼狱随着此招的失败土崩瓦解，$n压力顿失，不由得长舒了一口气。\n" NOR, me, target);
  }

  target->receive_damage("kee", damage, me);
  target->receive_wound("kee", damage, me);
  COMBAT_D->report_status(target);
  me->set_temp("sha_busy", 1);
  call_out("remove_effect", 5 + random(5), me);  //原为10-15,snowtu修改


  return 1;
}

void remove_effect(object me) {
  if (!me) return;
  if (me->query_temp("sha_busy"))
    me->delete_temp("sha_busy");
}
