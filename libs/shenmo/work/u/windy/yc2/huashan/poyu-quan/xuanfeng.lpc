#include <ansi.h>
#include <combat.h>
inherit SSERVER;



int perform(object me, object target)
{
        int i,damage,num;
        string dcol,powercol;
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「旋风腿」？\n");

        if(!me->is_fighting())
                return notify_fail("「旋风腿」只能在战斗中使用！\n");
if(me->query("family/family_name") != "格斗家" && !me->samsara_check("yuanwu-kungfu",1) )
      return notify_fail("你从哪里偷学的功夫？\n");


        if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 200 )
                return notify_fail("你的内力不足！\n");

 
        if((int)me->query("sen") < 200 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if(me->query_temp("bd_busy")) 
                return notify_fail("你刚使用过「旋风腿」,体力尚未恢复。\n");

        i=(int)me->query_skill("unarmed");

        if( i < 100)
                return notify_fail("你的元武门绝学修为还不够，无法施展「旋风腿」！\n");
        

        me->set("apply/damage",i); 


        message_vision(HIC"-------------------------龙卷旋风腿-------------------------------\n\n"NOR,me,target);
        message_vision(HIW"\n$N将内劲灌注于双腿，整个人盘旋升起，形成一巨大龙卷旋风。\n\n"NOR,me,target);
        message_vision(HIW"\n旋风呼啸而来，往$n刮去。\n"NOR,me,target);
        target->start_busy(1);
       num=i/50;
//       if(i>8) i=8
       if(num>12) num=12;
       for (i=0;i<num;i++){
	  COMBAT_D->do_attack(me,target, TYPE_REGULAR);
        }
        i=(int)me->query_skill("unarmed");

        me->set("apply/damage",-i);
        me->start_busy(2+random(1));
         return 1;

                  
}

