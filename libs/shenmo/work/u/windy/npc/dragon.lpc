// created by windy on 2/20/2006 
#include <ansi.h> //如果要用颜色，就要套用此头文件
inherit NPC;


void create() {
  set_name("九天神龙", ({ "jiutian shenlong" }));
  if (!query("find")) seteuid(0);
  else seteuid("dragon of " + query("find")->query("id"));
  set("race", "野兽");
  set("long", "这就是传说中的九天神龙，正警惕地看着你的一举一动。\n");
  set("title", HIM "闹新春" NOR);
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));
  set("age", 1000);
  set("attitude", "friendly");
  set("class", "xian");
  set("max_kee", 1000000);
  set("max_sen", 1000000);
  set("eff_kee", 1000000);
  set("kee", 1000000);
  set("eff_sen", 1000000);
  set("sen", 1000000);

  set("max_force", 12000);
  set("force", query("max_force") * 2);
  set("max_mana", 20000);
  set("mana", query("max_mana") * 2);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "dragonfight");
  map_skill("dodge", "lingbo-weibu");
  map_skill("force", "jiayi-force");
  set("任务", 1);
  set("莲花", 1);
  set("chat_chance", 90);
  set("chat_msg", ({
    CYN "云从龙形，风从虎势！\n" NOR,
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
  }));
  setup();
}

void kill_ob(object ob) {
  set_temp("no_return", 1);
  set_temp("my_killer", ob);
  ::kill_ob(ob);
}

void die() {
  object dan;
  object ob = query_temp("my_killer");
  message_vision(HIY "只见$N再也支持不住，一声龙吟，腾空而起，冉冉升向天际... ... \n" NOR, this_object());
  if (ob == query("find")) {
    if (!random(3)) {
      message_vision(HIR "$N突然张嘴吐出一颗红色的珠子，正好落入$n的手中。\n" NOR, this_object(), ob);
      dan = new("/u/windy/npc/obj/huodan");
    } else if (random(2)) {
      message_vision(HIG "$N突然张嘴吐出一颗蓝色的珠子，正好落入$n的手中。\n" NOR, this_object(), ob);
      dan = new("/u/windy/npc/obj/shuidan");
    } else {
      message_vision(HIY "$N突然张嘴吐出一颗金色的珠子，正好落入$n的手中。\n" NOR, this_object(), ob);
      dan = new("/u/windy/npc/obj/jihuidan");
    }
    message(
      "channel:rumor",
      HIB + "\n【" + HIW " 春节礼物精灵 " NOR + HIB "】某人：" + ob->query("name") + "从神龙手中夺得了一颗" + dan->query("name") + "！\n" NOR,
      users()
    );
    dan->move(ob);
  }
  destruct(this_object());
}
