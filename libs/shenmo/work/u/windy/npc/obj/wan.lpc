#include <ansi.h>
inherit ITEM;
int random_place(object me, string *dirs);

string *dirs = ({
  "/d/city", "/d/jjf", "/d/westway", "/d/kaifeng",
  "/d/lingtai", "/d/moon", "/d/gao", "/d/dntg/hgs",
  "/d/sea", "/d/eastway", "/d/nanhai", "/d/ourhome/honglou",
  "/d/xueshan", "/d/qujing/wuzhuang", "/d/qujing/baotou",
  "/d/qujing/baoxiang", "/d/qujing/bibotan", "/d/qujing/biqiu",
  "/d/qujing/chechi", "/d/qujing/dudi", "/d/qujing/fengxian",
  "/d/qujing/firemount", "/d/qujing/jilei", "/d/qujing/jindou",
  "/d/qujing/jingjiling", "/d/qujing/jinping", "/d/qujing/jisaiguo",
  "/d/qujing/maoying", "/d/qujing/nuerguo", "/d/qujing/pingding",
  "/d/qujing/pansi", "/d/qujing/tongtian", "/d/qujing/qilin",
  "/d/qujing/qinfa", "/d/qujing/qinglong", "/d/qujing/tianzhu",
  "/d/qujing/wudidong", "/d/qujing/wuji", "/d/qujing/xiaoxitian",
  "/d/qujing/yinwu", "/d/qujing/yuhua", "/d/qujing/zhujie",
  "/d/qujing/zhuzi", "/d/penglai", "/d/death",
  "/d/meishan", "/d/qujing/lingshan",
});

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIW "开心大补丸" NOR, ({ "kaixin wan", "wan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗香喷喷的肉丸子，据说是巫师发给玩家的新年礼物。\n");
    set("value", 0);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();
  object ob = this_object();
  object dragon, where;
  if (!arg || !id(arg) || !present(ob, me))
    return 0;
  if (me->query("礼物记录/12年春节") > 2 || me->query("礼物记录/12年春节") == 0) {
    message_vision(WHT "$N看都不看，囫囵吞枣般就把丸子吞了下去，结果一下子卡在喉咙里了！\n" NOR, me);
    me->delete_temp("last_damage_from");
    me->set_temp("death_msg", "被噎死了。\n");
    me->die();
    me->save();
  } else {
    dragon = new("/u/windy/npc/dragon");
    if (!dragon)  //加个判定，免得出错，snowtu
    {
      message_vision(WHT "$N看都不看，囫囵吞枣般就把丸子吞了下去，结果一下子卡在喉咙里，又吐了出来！\n" NOR, me);
      return 1;
    }
    dragon->set("find", me);
    dragon->set_name("九天神龙", ({ "dragon of " + me->query("id") }));
    dragon->setup();
    dragon->set("combat_exp", me->query("combat_exp"));
    dragon->set("daoxing", me->query("daoxing"));
    dragon->set("level", me->query("level"));
    dragon->set_skill("force", me->query_skill("force") * 2);
    dragon->set_skill("unarmed", me->query_skill("unarmed") * 2);
    dragon->set_skill("parry", me->query_skill("parry") * 2);
    dragon->set_skill("spells", me->query_skill("spells") * 2);
    dragon->set_skill("dodge", me->query_skill("dodge") * 2);
    dragon->set_skill("lingbo-weibu", me->query_skill("dodge"));
    dragon->set_skill("jiayi-force", me->query_skill("force"));
    dragon->set_skill("buddhism", me->query_skill("spells"));
    dragon->set_skill("dragonfight", me->query_skill("unarmed"));
    dragon->set_temp("lightshield", 1);
    if (!random_place(dragon, dirs))  //这个要加的，因为有返回0的可能，省得吃不到
    {
      destruct(dragon);
      message_vision(WHT "$N看都不看，囫囵吞枣般就把丸子吞了下去，结果一下子卡在喉咙里，又吐了出来！\n" NOR, me);
      return 1;
    }
    message_vision(HIW "$N端详了一下手里的肉丸子，轻轻地咬了一口，慢慢品尝了起来。\n" NOR, me);
    tell_object(me, HIW "你只感觉到全身由内而外，香气四溢，身轻体健，飘然欲飞！\n" NOR);
    me->add("combat_exp", 500000);
    tell_object(me, HIY "你的武学增加了五十万！\n" NOR);
    me->add("daoxing", 500000);
    tell_object(me, HIY "你的道行增加了五百年！\n" NOR);
    me->add("potential", 500000);
    tell_object(me, HIY "你的潜能增加了五十万！\n" NOR);
    me->add("haomao", 5);
    tell_object(me, HIY "你的救命毫毛增加了五根！\n" NOR);
    me->add("shen", 500);
    tell_object(me, HIY "你的元神增加了五百点！\n" NOR);
    me->add("level", 1);
    tell_object(me, HIY "你的等级得到了提升！\n" NOR);
    me->add("礼物记录/12年春节", 1);
    message_vision(
      HIM "恰在此时，只见半空中彩云缭绕，霞光四射，一条" + dragon->name(1) + HIM "从天而降！\n张牙舞爪，一下子就把$N的猪肉丸子夺了过去，飞向远方。。。。。。\n" NOR,
      me
    );
    me->set_temp("spring_dragon", dragon);
  }
  destruct(this_object());
  return 1;
}


int random_place(object me, string *dirs) {
  int i, j, k;
  object newob;
  mixed *file, exit;
  if (!sizeof(dirs)) return 1;
  i = random(sizeof(dirs));    // pick up one directory
  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file)) return 1;
  for (k = 0; k < 30; k++) {
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight")
          || newob->query("no_magic")
          || newob->query("no_mieyao")
          || !(exit = newob->query("exits"))
          || sizeof(exit) < 1)
          continue;
        if (me->move(newob)) {
          message_vision("$N走了过来。\n", me);
          return 1;
        }
      }
    }
  }
  return 0;
}
