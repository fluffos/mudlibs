#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "赤阳火龙丹" NOR, ({ "huo dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗火红的仙丹，周身被一团金色的火焰包围着。\n");
    set("value", 0);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (me->query("礼物记录/12年春节") != 2) {
    message_vision(RED "$N看都不看，囫囵吞枣般就把丹药吞了下去，结果刹那间整个腹部都着起火来！\n" NOR, me);
    me->delete_temp("last_damage_from");
    me->set_temp("death_msg", "被烧死了。\n");
    me->move("/d/city/kezhan");
    me->die();
    me->save();
  } else {
    message_vision(HIR "$N屏气凝神，轻轻地将丹药放入口中，吞了下去！\n" NOR, me);
    tell_object(me, HIR "你只感觉到一股温暖之气自丹田流遍全身，舒泰无比！\n" NOR);
    me->add("str", 1);
    tell_object(me, HIY "你的先天臂力提高了！\n" NOR);
    me->add("cor", 1);
    tell_object(me, HIY "你的先天胆识提高了！\n" NOR);
    me->add("con", 1);
    tell_object(me, HIY "你的先天根骨提高了！\n" NOR);
    me->add("kar", 1);
    tell_object(me, HIY "你的先天福缘提高了！\n" NOR);
    me->add("礼物记录/12年春节", 1);
  }
  destruct(this_object());
  return 1;
}
