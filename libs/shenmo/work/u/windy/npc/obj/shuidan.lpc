
#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIG"玄阴水龙丹"NOR, ({"shui dan", "dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "一颗碧绿的仙丹，周身被一团蓝色的火焰包围着。\n");
                set("value", 0);
        }
        setup();
}

int do_eat(string arg)
{
        object me = this_player();

        if (!id(arg))
        return notify_fail("你要吃什么？\n");
if ( me->query("礼物记录/12年春节")!=2 )
        {
        message_vision(HIB"$N看都不看，囫囵吞枣般就把丹药吞了下去，结果刹那间整个腹部都结成了冰！\n"NOR, me);  
        me->delete_temp("last_damage_from");  
        me->set_temp("death_msg", "被冻死了。\n");  
        me->die(); 
        me->save();  
        }
else    {
        message_vision(HIG"$N屏气凝神，轻轻地将丹药放入口中，吞了下去！\n"NOR, me);  
        tell_object(me, HIG"你只感觉到一股清凉之气自丹田流遍全身，舒泰无比！\n"NOR);
        me->add("int", 1);
        tell_object(me, HIY"你的先天悟性提高了！\n"NOR); 
        me->add("cps", 1);
        tell_object(me, HIY"你的先天定力提高了！\n"NOR); 
        me->add("spi", 1);
        tell_object(me, HIY"你的先天灵性提高了！\n"NOR); 
        me->add("per", 1);
        tell_object(me, HIY"你的先天容貌提高了！\n"NOR); 
        me->add("礼物记录/12年春节", 1); 
        }
        destruct(this_object());
        return 1;
}


