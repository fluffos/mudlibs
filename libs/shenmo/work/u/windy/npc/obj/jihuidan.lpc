
#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIY"九转机会丹"NOR, ({"jihui dan", "dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "一颗金黄的仙丹，周身被一团白色的火焰包围着。\n");
                set("value", 0);
        }
        setup();
}

int do_eat(string arg)
{
        object me = this_player();

        if (!id(arg))
        return notify_fail("你要吃什么？\n");
if ( me->query("礼物记录/12年春节")!=2 )
        {
        message_vision(YEL"$N看都不看，囫囵吞枣般就把丹药吞了下去，结果刹那间整个腹部都涨了起来！\n"NOR, me);  
        me->delete_temp("last_damage_from");  
        me->set_temp("death_msg", "被撑死了。\n");  
        me->die(); 
        me->save();  
        }
else    {
        message_vision(HIY"$N屏气凝神，轻轻地将丹药放入口中，吞了下去！\n"NOR, me);  
        tell_object(me, HIY"你只感觉到一股清新之气自丹田流遍全身，舒泰无比！\n"NOR);
        if (me->query("chshjue_ask")==1 && me->query("chshjue_agree")==0)
                {
                me->set("chshjue_ask", 0);
                tell_object(me, HIW"恭喜你获得一次重新破解长生诀的机会！\n"NOR);
                }
        if (me->query("xlzhang_ask")==1 && me->query("xlzhang_agree")==0)
                {
                me->set("xlzhang_ask", 0);
                tell_object(me, HIR"恭喜你获得一次重新破解降龙十八掌的机会！\n"NOR);
                }
        if (me->query("dgbang_ask")==1 && me->query("dgbang_agree")==0)
                {
                me->set("dgbang_ask", 0);
                tell_object(me, HIG"恭喜你获得一次重新破解打狗棒法的机会！\n"NOR);
                }
        if (me->query("wuhu_ask")==1 && me->query("wuhu_agree")==0)
                {
                me->set("wuhu_ask", 0);
                tell_object(me, HIB"恭喜你获得一次重新破解五虎断门刀的机会！\n"NOR);
                }
        me->add("礼物记录/12年春节", 1); 
        }
        destruct(this_object());
        return 1;
}


