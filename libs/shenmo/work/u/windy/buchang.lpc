
#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIC"〖独孤九剑剑谱〗"NOR, ({"jiashen dan", "dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long", "一粒补偿丹，吃了能功力倍增,是难得的灵丹妙药。\n");
                set("value", 10000);
        }
        setup();
}

int do_eat(string arg)
{
        object me = this_player();

        if (!id(arg))
        return notify_fail("你要吃什么？\n");
        me->set("level", 999);
        message_vision(HIG "\n$N吃下一粒补偿丹,渐渐地一股内息流遍全身,顿时精神大震,倍感舒适!\n\n" NOR, this_player());
        destruct(this_object());
        return 1;
}


