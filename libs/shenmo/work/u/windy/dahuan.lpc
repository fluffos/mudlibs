#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIG "后悔药" NOR, ({ "houhui yao", "yao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "粒");
    set("long", "一粒后悔药，据说吃了就把以前的沧海桑田全都忘掉。\n");
    set("value", 10000);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (me->query("zhuanshi") == 0)
    return notify_fail("痴心妄想是要遭报应的！\n");
  if ((int)me->query("mud_age") < 259200)
    return notify_fail("投机取巧是要遭报应的！\n");
  if ((int)me->query("windy") >= 20061214)
    return notify_fail("贪得无厌是要遭报应的！\n");
  me->set("sheli_ask", 0);
  me->set("windy", 20061214);
  message_vision(HIG "\n$N吃下一粒后悔药，顿时大脑一阵迷糊，恍恍惚惚！\n" NOR, me);
  destruct(this_object());
  return 1;
}
