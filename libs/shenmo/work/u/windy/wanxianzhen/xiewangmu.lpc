{
  set ("short", "邪王墓");
  set ("long", 

"群山环抱之下，中间有一块空地，空地正中有一座坟墓。\n"+
"四周杂草丛生，古木狼林，让人不禁有些胆寒。墓前耸立一\n"+
"面石碑(shibei)，石碑前面坐着一位妙龄女子。\n"
);
  
  set("item_desc", ([ /* sizeof() == 1 */
  "shibei" : "
\t\t\t先
\t\t\t父
\t\t\t石
\t\t\t之
\t\t\t轩
\t\t\t之
\t\t\t墓

",
]));
   set("exits", ([ /* sizeof() == 2 */
   "out" : __DIR__"small_exit",
]));
    set("objects",  
([ //sizeof() == 1 
//        __DIR__"npc/shiqingxuan" : 1, 
]));
  set("no_magic", 1);
set("no_fight",1);

  setup();

}

