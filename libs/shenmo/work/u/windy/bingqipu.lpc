#include <ansi.h>
#include <mudlib.h>

inherit ITEM;
void create() {
  set_name(HIW "西游记--神魔传说" HIR "兵器谱" NOR, ({ "bingqi pu", "pu" }));
  set_weight(50000000);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("value", 0);
    set("unit", "本");
    set("long", @LONG
这是一本流传久远的西游记--神魔传说兵器谱，里面记下了西游记--神魔传说当前
顶尖的二十把成名兵器。可以用(list)来翻看记载。
LONG);
  }
  setup();
}

void init() {
  add_action("do_list", "list");
}

int top_list(object ob1, object ob2);

int get_score(object ob);

int do_list(object me, string arg) {

  object *list, *ob;
  int i, ppl;
  string msg;
  me = this_player();
  ob = filter_array(objects(), (: userp($1) && !wizardp($1) :));
  list = sort_array(ob, (: top_list :));
  msg = "\n                  　　　┏ " + BCYN HIR + "西游记--神魔传说谁与争锋兵器谱" NOR " ┓\n";
  msg += "┏━━━━┯━━━━━━┻━━━━━┯━━━━━━┻━━━━━━┯━━━━┓\n";
  msg += "┃  排名　│      使   用   者      │　  江   湖   称   谓     │ 杀伤力 ┃\n";
  msg += "┠────┴────────────┴─────────────┴────┨\n";
  ppl = 0;
  i = sizeof(list);

  while (i--) {
    if (!environment(list[i])) continue;
    if (!me->visible(list[i])) continue;
    if (wiz_level(list[i])) continue;
    if (!interactive(list[i])) continue;
    ppl++;
  }
  for (i = 0; i < 20; i++) {
    if (i >= ppl) msg += "┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃ \n";
    else {
      if (list[i] == me) msg += BBLU HIY;
      //                msg += sprintf("┃   "HIY"%-5s"NOR"│"HIG"%-12s"NOR"  "HIC"%-10s"NOR"│"HIW"%-14s"NOR"  "HIC"%-10s"NOR"  "HIR"%8d"NOR"  \n"NOR,chinese_number(i+1),list[i]->query("name"),"["+
      msg += sprintf("┃   " HIY "%-5s" NOR "│" HIG "%-12s" NOR "  " HIC "%-10s" NOR "│" HIW "%-30s " NOR "    │" HIR "%8d" NOR "┃\n" NOR,
        chinese_number(i + 1),
        list[i]->query("name"),
        "[" + capitalize(list[i]->query("id")) + "]",
        SDS_D->no_color_msg(list[i]->query("weapon/name")) + NOR "(" + list[i]->query("weapon/id") + ")",
        get_score(list[i]));
    }
  }
  msg += "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n";
  msg += "  " + NATURE_D->game_time() + "记。\n";
  write(msg);
  return 1;

}

int top_list(object ob1, object ob2) {
  int score1, score2;

  score1 = get_score(ob1);
  score2 = get_score(ob2);

  return score2 - score1;
}

int get_score(object ob) {
  int tlvl, i, score;
  string *ski;
  mapping skills;

  reset_eval_cost();
  skills = ob->query_skills();
  if (!sizeof(skills)) return 1;
  ski = keys(skills);
  for (i = 0; i < sizeof(ski); i++) {
    tlvl += skills[ski[i]];
  }  // count total skill levels
  score = ob->query("weapon/type/sword") * ob->query("weapon/type/sword");
  score += ob->query("weapon/type/blade") * ob->query("weapon/type/blade");
  score += ob->query("weapon/type/whip") * ob->query("weapon/type/whip");
  score += ob->query("weapon/type/stick") * ob->query("weapon/type/stick");
  score += ob->query("weapon/type/staff") * ob->query("weapon/type/staff");
  score += ob->query("weapon/type/spear") * ob->query("weapon/type/spear");
  score += ob->query("weapon/type/axe") * ob->query("weapon/type/axe");
  score += ob->query("weapon/type/mace") * ob->query("weapon/type/mace");
  score += ob->query("weapon/type/fork") * ob->query("weapon/type/fork");
  score += ob->query("weapon/type/unarmed") * ob->query("weapon/type/unarmed");
  score += ob->query("weapon/type/hammer") * ob->query("weapon/type/hammer");
  score += ob->query("weapon/type/rake") * ob->query("weapon/type/rake");

  return score;
}
