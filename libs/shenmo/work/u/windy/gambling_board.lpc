#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name("赌棍交流板", ({ "gambling board", "board" }));
  set("location", "/d/city/duchang");
  set("board_id", "gambling_board");
  set("long", "这是赌场中专门为那些赌徒们挥洒豪言壮语的留言板。\n");
  setup();
  set("capacity", 500);
  replace_program(BULLETIN_BOARD);
}

void init() {
  this_object()->restore();
  ::init();
}
