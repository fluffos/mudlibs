
// write by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"六脉惊神"NOR"」";  
}

int valid_perform(object me)
{
if((int)me->query_skill("liumai-shenjian", 1) < 600) 
        return notify_fail("你的六脉神剑修为太差，难以施展"+name()+"！\n"); 
if( time()-(int)me->query_temp("jingshen_end") < 5+random(5) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
if((int)me->query("force") < 6000 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("max_force") < 6000 ) 
        return notify_fail("你的内力修为不够！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg; 
int extra; 
object weapon; 
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
extra = (int)me->query_skill("liumai-shenjian",1); 

message_vision(HIG"忽然间$N只感觉六路剑法一一涌向心头，十指纷弹，此去彼来，连绵无尽，攻向$n！\n" NOR,me,target);
target->receive_damage("sen",extra+random(extra),me);
target->receive_wound("sen",extra,me);
COMBAT_D->report_sen_status(target,0);
me->receive_damage("sen", extra/5,target);
me->add("force", -50);
me->set_temp("jingshen_end",time());
message_vision(HIB "只听“嗤”地一声响，一道剑气已从$n身上对穿而过！\n" NOR,me,target);
return 1; 
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("liumai-shenjian")+" 600 级\n"; 
temp+= "\t\t内力６０００点\n"; 
temp+= "\t\t内力修为一甲子\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                重创敌人
        出招类型： 
                延时型外功，出现隐藏攻击时带有 busy
                有超强隐藏攻击
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
