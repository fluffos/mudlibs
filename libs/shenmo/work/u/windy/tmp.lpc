int ob_hit(object ob, object me, int damage)
{
object wp1;
string msg;
int p,j=0,skill, neili, neili1;
wp1 = ob->query_temp("weapon");
skill = me->query_skill("lingbo-weibu", 1);
neili = me->query("force");
neili1 = ob->query("force");

if (damage <10)
        damage=10;      

if ( me->query_temp("lingboweibu") ) 
        {
        me->delete_temp("lingboweibu");
        return 0;
        }
if(skill > random(ob->query_skill("dodge", 1))
&& me->query("combat_exp") > ob->query("combat_exp")/2
&& me->query_skill_mapped("dodge") == "lingbo-weibu"
&& neili > 100 && skill > 150)
    {
me->add_temp("lingboweibu", 1);    
msg = "$n不见有任何动作，只是身子一晃一转，蹴的一下转到$N的背后。\n";
tell_object(ob, HIR "你只觉眼前一花，不见了对手的身影！\n" NOR);
if ( neili >= random(neili1)+damage ) 
        {
        msg+= "结果$N的力道被$n完全躲开了！\n"NOR, 
        j = -damage;
        }
else if ( neili<random(neili1)+damage && neili*2>=random(neili1)+damage )
        {
        msg+= "结果$n躲过了$N的一大半力道！\n"NOR, 
        j = -damage/4*3;
        }
else if ( neili*2<random(neili1)+damage && neili*3>=random(neili1)+damage )
        {
        msg+= "结果$N的力道被躲过了一半！\n"NOR, 
        j = -damage/2;
        }
else    {
        msg+= "结果$n只躲过了$N的一小半力道！\n"NOR, 
        j = -damage/4; 
        } 
if ( !j )
        return 0;                 
me->set_temp("dodge_skill_msg",msg);    
return j;
    }
}

