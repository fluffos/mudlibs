void check_level() {
  float fwx, flvl;
  int wx, lvl;
  wx = this_object()->query("combat_exp");
  fwx = to_float(wx);
  if (wx > 10000000)
    flvl = sqrt(fwx / 400) - 1;
  else flvl = sqrt(fwx / 1000) - 1;
  lvl = to_int(flvl);
  this_object()->set("level", lvl);
}

check_level();
powerup();
save();
