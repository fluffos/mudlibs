void init()
{
        object me = this_player();
        tell_room( environment(me), HIG"电脑监视器说道："HIR"请注意!"   +   me->query("title") + " "
                + me->query("name") + "(" + me->query("id") + ")" +HIG " 来到了逍遥轩！！！\n"NOR);

}
