inherit NPC;

#include <ansi.h>
int go_home(object me);

int create()
{
    set_name(BRED+HIG"仙儿"NOR, ({"xian er","er"}));
        set("nickname", HIM "风的知心" NOR);
  set("long", HIM"一位貌美如花的小姑娘。是风的女朋友怕他一个人寂寞,化了一个分身来陪伴他!\n"+NOR);

  set("gender", "女性");
  set("attitude", "peaceful");
  set("class", "bonze");
  set("age", 20);
  set("str", 40);
  set("int", 40);
  set("per", 40);
  set("con", 40);
  set("max_kee", 3000);
  set("max_sen", 3000);
  set("max_force", 3000);
  set("force", 3000);
  set("force_factor", 10);
  set("max_mana", 3000);
  set("mana", 3000);
  set("mana_factor", 10);
  set("combat_exp", 500000);
  set("daoxing", 800000);


  set("chat_chance", 5);
  set("chat_msg", ({
    "仙儿说道：公子，你累了吧,需要我为你捶背吗?\n",
    "仙儿说道：公子，我可以天天陪你了,你开心吗?\n",
    "仙儿说道：公子，我打扫的房间还漂亮吧?\n",
  }));

  set_skill("force", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 79);
  set_skill("parry", 79);
  set_skill("staff", 50);
  set_skill("lotusforce", 50);
  set_skill("lunhui-zhang", 79);
  set_skill("jienan-zhi", 50);
  set_skill("lotusmove", 79);
  map_skill("dodge", "lotusmove");
  map_skill("unarmed", "jienan-zhi");
  map_skill("staff", "lunhui-zhang");
  map_skill("parry", "lunhui-zhang");
  map_skill("force", "lotusforce");
        set("inquiry", ([
                "home" : (: go_home :),
        ]) );
  setup();
  add_money("silver", 5);
  carry_object("/d/obj/cloth/tianyi")->wear();

   setup();
}

int go_home(object me)
{
        me=this_player();
        command("bow " + me->query("id"));
        command("say " + "我家公子有请。\n");
        tell_object(me,"\n仙儿一挥手，在你眼前一拂...。\n\n");
         me->move("/u/wqfeng/workroom1");
        return 1;
}



