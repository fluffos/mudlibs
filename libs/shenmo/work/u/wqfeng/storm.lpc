// 暴风骤雨
#include <ansi.h>
inherit PERFORM;

int set_damage() {
  int damage;
  object me = this_player();
  damage = me->query_skill("jienan-zhi", 1) * 2;
  damage += me->query("force_factor") * 2;
  damage += me->query_skill("staff");
  damage += me->query_temp("apply/damage");
  return damage;
}

void create() {
  int damage;
  damage = set_damage();
  set("name", HIG "暴风骤雨" NOR);
  set("class", "xian");
  //set("family","南海普陀山");
  set("betray_lvl", 250);
  set("target", 1);
  set("persent", 130);
  set("belong", "jienan-zhi");
  set("base_type", "unarmed");
  set("force", 500);
  set("limit_skill", ([
    "jienan-zhi": 120,
    "unarmed": 120,
  ]));
  set("self_busy", 2);
  set("busy_lost", 1 + random(2));
  set("damage_type", "kee");
  set("damage", damage);
}

void hit_msg(object me, object target, int num) {
  string msg;
  if (me && target && num == 1) {
    msg = HIC "\n
$N" HIC "口中大喝了一声，施展出「暴风骤雨」，双手十指上下翻飞，身形前后左右移动，
$n" HIC "只觉得到处是$N" HIC "的影子，根本不知如何招架，更不用说躲闪了！\n\n" NOR;
    message_vision(msg, me, target);
  }
}

void success_hit_msg(object me, object target, int num) {
  string msg;
  if (me && target) {
    msg = HIC "结果十指结结实实全部击中了$n" HIC "，差点没把$n" HIC "戳了个透心凉！\n" NOR;
    message_vision(msg, me, target);
  }
}

void lost_hit_msg(object me, object target, int num) {
  string msg;
  if (me && target) {
    msg = HIC "但是$n" HIC "轻轻一跳就躲了开来。\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(2);
  }
}

void normal_hit_msg(object me) {
  int damage;
  string msg;
  if (me) {
    msg = HIC "但是被对方以内力一逼，指力尽数反挫！\n" NOR;
    msg += HIC "结果只听喀嚓！几声，$N" HIC "十指几乎全部折断！\n" NOR;
    message_vision(msg, me);
    damage = query("damage");
    damage = damage / 5 + random(damage / 5);
    if (damage > 0) {
      me->receive_damage("kee", damage);
      COMBAT_D->report_status(me);
    }
  }
}
