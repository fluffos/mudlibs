#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
  set ("short", BLINK+HIM"风花雪月"+NOR);
  set ("long", @LONG

这里是 风的房间 ，这是一个美丽的地方，到处都流露出欢快的气息 
这里也是风最喜欢的地方，因为这里有风的美好回忆，风 在这里等
待他的梦中情人的到来！欢迎你成为 风 的好友，OICQ:26660708
LONG);

set("item_desc",(["bed":"睡觉用的床铺(gosleep,gobed,bed)。 \n", ]));
set("exits", ([ /* sizeof() == 4 */
                "down" :"/u/wqfeng/workroom1",
]));

        set("no_clean_up", 0);
        set("outdoors", "city");
        set("no_death", 1);
        set("no_magic", 1);
        set("no_fight", "1");
        set("no_time", "1");
        set("no_exert", 1);
        set("no_kill", "1");
  set("valid_startroom", 1);
        setup();
//        replace_program(ROOM);
}

void init()
{
        add_action("do_bed", "gosleep");
        add_action("do_bed", "gobed" );
        add_action("do_bed", "bed");
}

int do_bed()
{       object me;
        me=this_player();
        message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
        me->move("/u/wqfeng/obj/bed");
            message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
                return 1;
}

