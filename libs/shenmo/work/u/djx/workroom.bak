void init()
{
object me = this_player();
if ( me->query("id")!="djx" ) return;
  add_action("do_fan","fan");
  add_action("do_bed","bed");
}

int do_bed()
{
object me = this_player();
message_vision(HIY"\n$N掀开纱帐，准备上床了。\n\n" NOR, me); 
me->move(__DIR__"bed");
message_vision(HIY"\n沙帐轻轻一动，$N钻了进来。\n" NOR, me); 
return 1;
}

int do_fan(string arg)
{
object obj;
object me = this_player();
if (!arg || !me )
        return notify_fail("你想挖什么？\n");
if ( arg=="wuxian" )
        {
        obj=new("/d/snowtu/obj/weapon/wuxian");
        obj->move(me);
        message_vision(HIY"$N在地上摸索了半天，终于从床底下翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
        }
if ( arg=="mao" )
        {
        obj=new("/u/snowtu/obj/mao");
        obj->move(me);
        message_vision(HIY"$N在地上摸索了半天，终于从床底下翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
        }
if ( arg=="youxian" )
        {
        obj=new("/d/snowtu/obj/weapon/wuxian1");
        obj->move(me);
        message_vision(HIY"$N在地上摸索了半天，终于从床底下翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
        }
if ( arg=="jinbi" )
        {
        obj=new("/clone/money/jinbi");
        obj->move(me);
        message_vision(HIY"$N在地上摸索了半天，终于从床底下翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
        }
if ( arg=="ak47" )
        {
        obj=new("/u/yhq/obj/ak47");
        obj->move(me);
        message_vision(HIY"$N在地上摸索了半天，终于从床底下翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
        }
if ( arg=="xiangji" )
        {
        obj=new("/d/djx/camera/obj/camera");
        obj->move(me);
        message_vision(HIY"$N在地上摸索了半天，终于从床底下翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
        }
if ( arg=="tance" )
        {
        obj=new("/u/djx/obj/tance");
        obj->move(me);
        message_vision(HIY"$N在地上摸索了半天，终于从床底下翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
        }
return 1;
}
