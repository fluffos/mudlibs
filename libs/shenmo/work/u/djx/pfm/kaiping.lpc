"尺泽穴","合谷穴","下关穴","服哀穴",
"云门穴","迎香穴","梁门穴","血海穴",
"列缺穴","天鼎穴","梁丘穴","三阴交穴",
"太渊穴","曲池穴","足三里穴","阴陵泉穴",
"通里穴","天宗穴","睛明穴","涌泉穴",
"神门穴","听宫穴","攒竹穴","复溜穴",
"青灵穴","肩贞穴","天柱穴","然谷穴",
"极泉穴","肩中俞穴","膏肓穴","陰谷穴",
"灵海穴","肩外俞穴","承山穴","太溪穴",
"曲泽穴","外关穴","听会穴","期门穴",
"中冲穴","支沟穴","阳白穴","大敦穴",
"劳宫穴","耳门穴","风池穴","行间穴",
"内关穴","翳风穴","肩井穴","太冲穴",
"间使穴","丝竹空穴","风市穴","中封穴",
"会阴穴","五枢穴","筑宾穴","金门穴",
"阴交穴","维道穴","府舍穴","阳交穴",
"气冲穴","大横穴","正营穴","中注穴",
"天突穴","承灵穴","幽门穴","天寥穴",
"商曲穴","百会穴","照海穴","跗阳穴",
"长强穴","檀中穴","交信穴","审脉穴",
"命门穴","中极穴","仆参穴","至阳穴",
"关元穴","巨骨穴","神柱穴","气海穴",
"地仓穴","大椎穴","神阙穴""中脘穴",
"风府穴","天突穴","腰阳关穴"});

int perform(object me, object target)
{       
        string msg;
        int damage, p,time,skill,skill2;
        object weapon;

        weapon = me->query_temp("weapon");

        skill = (int)me->query_skill("bainiao-jian", 1);
        skill2 = (int)me->query_skill("sword", 1);

        if( !target ) target = offensive_target(me);
        if( !target || !target->is_character()
           || !me->is_fighting(target) || !living(target) )
                return notify_fail(WHT"「孔雀开屏」只能在战斗中使用。\n"NOR);

       if(!me->query("xueshan_kaiping") )
                return notify_fail("你还没有获得终极技之密！\n");

       if( skill < 500 || skill2 < 500 )
                return notify_fail(WHT"你的剑术还不够娴熟，不能使出「孔雀开屏」。\n"NOR);

        if((int)me->query("combat_exp", 1) < 3000000)
                return notify_fail(WHT"你的武学不够，不能使用这一招！\n"NOR);

       if((int)me->query_skill("force", 1) <600)
                           return notify_fail(WHT"以你现在的内功修为还使不出「孔雀开屏」。\n"NOR);

       if( (int)me->query("max_force") < 3000 )
                                 return notify_fail(WHT"以你现在的内力修为还使不出「孔雀开屏」。\n"NOR);

       if( (int)me->query("force") < 600 )
                return notify_fail(WHT"你的内力不足了！\n"NOR);

       if (me->query_temp("kaiping_busy")) 
              return notify_fail(WHT"你已经在开屏中了。\n"NOR);

       if (me->query("combat_exp") > target->query("combat_exp")/3) {
    message_vision(HIW"$N双手一展,突然临空腾起,四周百鸟齐鸣，一只凤凰傲然展羽开屏,携百鸟凌空扑向$n "NOR,me,target);
                me->set_temp("kaiping_busy",1);
//              remove_call_out("remove_kaiping");
                call_out("remove_kaiping",6+random(3),me);
                target->start_busy(1);
                damage = skill + random(skill2/2);
                target->receive_damage("kee", damage,me);
                target->receive_wound("kee", damage/2,me);               
                me->add("force", -(damage/4));
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg = damage_msg(damage, "刺伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";
                if(skill > 550)
                target->set_temp("last_damage_from", me);
                remove_call_out("perform2");
                call_out("perform2", 1, me, target);    
        } else {
                me->start_busy(3);
                me->add("force", -200);
                message_vision(HIC"可是却被$p"HIC"伏地一滚躲开了。\n"NOR,me,target);
        }
        message_vision(msg, me, target);
        return 1;
}

// 第二击 skill>550
int perform2(object me, object target)
{
        int damage, p,skill,skill2;
        string msg,weapon;
  
        weapon = me->query_temp("weapon");  
        skill = (int)me->query_skill("bainiao-jian", 1);
        skill2 = (int)me->query_skill("sword", 1);

        if(!target||!environment(target)||environment(me)!=environment(target)) 
       return 0;

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target->is_ghost()
        ||      target==me)
                return notify_fail(WHT"你犹如孔雀开屏般地傲然而立,缓缓收笼翅翼！\n"NOR);

        if(!living(target)) 
          return notify_fail(WHT"对手已经不能再战斗了。\n"NOR);

        if( (int)me->query("force", 1) < 300 )
                return notify_fail(WHT"你欲再展翅翼之际，却发现自己的内力不够了！\n");     
        msg = HIW"\n只见$N突然一振翅翼,募的化出一道百鸟剑光射向$n \n" NOR;
        message_vision(msg, me, target); 
        if (me->query("combat_exp") > target->query("combat_exp")/3) {
        msg = HIG"\n$N左手一招,百鸟齐鸣之间,右手的"+weapon->name()+HIG"陡地闪电般刺出一剑！！！\n\n" NOR;
                me->start_busy(1);
                target->start_busy(1);
                damage = skill + skill2;
                damage = damage+(int)me->query_skill("force", 1);
                damage = damage + random(damage*3/2);
                target->receive_damage("kee", damage,me);
                target->receive_wound("kee", damage/2,me);               
                me->add("force", -(damage/4));
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg += damage_msg(damage, "刺伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";
                target->set_temp("last_damage_from", me);
                if(skill > 550)
                  remove_call_out("perform3");
                call_out("perform3", 1, me, target);    
        } else {me->start_busy(2);
                me->add("force", -300);                
                msg += HIC"\n可是$p"HIC"竟然一个纵越,反手一式,$N"HIC"反而搞了个促不及防！\n"NOR;
        }
        message_vision(msg, me, target);
        return 1;
}


//第三击 skill>550
int perform3(object me, object target)
{
        string msg,weapon;
        int p,skill,skill2,j;

         j=2+random(3);
        skill = (int)me->query_skill("bainiao-jian", 1);
        skill2 = (int)me->query_skill("sword", 1);
        weapon = me->query_temp("weapon");  

        if(!target||!environment(target)||environment(me)!=environment(target)) 
       return 0;

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target->is_ghost()
        ||      target==me)
                return notify_fail(WHT"你犹如孔雀开屏般地傲然而立,缓缓收笼羽翼！\n"NOR);

        if(!living(target)) 
          return notify_fail(WHT"对手已经不能再战斗了。\n"NOR);

        if( (int)me->query("force", 1) < 300 )
                return notify_fail(WHT"你欲三展翅翼之际，却发现自己的内力不够了！\n");     

    msg = HIY"\n$N双展翅翼,啸起漫天黄沙,一声吠唳...瞬间已然站在$n"HIY"面前......
$n"HIY"只见百鸟分飞,绕住$n"HIY"全身,$N狂风暴雨般地向$n"HIY"连下杀式！\n"NOR;
    message_vision(msg, me, target);
        me->add_temp("apply/attack",skill);
        me->add_temp("apply/dodge", skill);
        me->add_temp("apply/parry", skill);
    for (p=1;p<2+random(2);p++)
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        if( !target->is_fighting(me) ) 
                if( living(target) ) 
                   if( userp(target) ) target->fight_ob(me);
    msg = HIW"\n\n$N犹如孔雀开屏般地傲然而立,缓缓收笼翅翼！！\n"NOR;
    message_vision(msg, me, target);
    msg = HIB"\n$N激战中突然撤身而回,$n"HIB"顿时一轻,倒吸了口冷气！！\n"NOR;
    message_vision(msg, me, target);
        me->add_temp("apply/parry", -skill);
        me->add_temp("apply/dodge", -skill);
        me->add_temp("apply/attack",-skill);
        me->start_busy(1+random(1));
    if (random(me->query("combat_exp")) > random(target->query("combat_exp")/3)) {
             if(skill > 600)
             remove_call_out("perform4");
             call_out("perform4", 1, me, target);    
     }
        return 1;
}

//第四击 skill>600
int perform4(object me, object target)
{
        int damage, p,skill,skill2;
        string msg,weapon,name;

        name = xue_name[random(sizeof(xue_name))];
        weapon = me->query_temp("weapon");  
        skill = (int)me->query_skill("bainiao-jian", 1);
        skill2 = (int)me->query_skill("sword", 1);

        if(!target||!environment(target)||environment(me)!=environment(target)) 
       return 0;
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target->is_ghost()
        ||      target==me)
                return notify_fail(WHT"你犹如孔雀开屏般地傲然而立,缓缓收笼羽翼！\n"NOR);

        if(!living(target)) 
          return notify_fail(WHT"对手已经不能再战斗了。\n"NOR);

        if( (int)me->query("force", 1) < 1000 )
                return notify_fail(WHT"你欲四展翅翼之际，却发现自己的内力不足以支撑进攻了！\n"NOR);     
 
        msg = HIG"\n那里料到在$N回撤之际,竟然双手一振，凌空展屏,"+weapon->name()+HIG"寒光点点,犹如凤凰乱点头般地攻向$n \n" NOR;
        message_vision(msg, me, target); 
    if (random(me->query("combat_exp")) > random(target->query("combat_exp")/3)) {
       msg = HIY"\n$n"HIY"慌乱中已经躲闪不及,被$N抢前一剑刺中"+name+"！！\n\n" NOR;
                me->start_busy(2);
                target->start_busy(1);
                damage = skill + skill2;
                damage = damage+(int)me->query_skill("force", 1);
                damage = damage + random(damage*3/2);
                target->receive_damage("kee", damage*3,me);
                target->receive_wound("kee", damage*2,me);               
                me->add("force", -(damage/4));
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg += damage_msg(damage, "刺伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";
               target->set_temp("last_damage_from", me);
        message_vision(msg, me, target);
        } else {me->start_busy(3);
                me->add("force", -400);                
                msg += HIC"\n可是$p"HIC"竟然一个纵越,反手一式,$N"HIC"反而搞了个促不及防！\n"NOR;
        message_vision(msg, me, target);
        }
        return 1;
}

void remove_kaiping(object me) 
{
  if (!me) return;
  me->delete_temp("kaiping_busy");
}

