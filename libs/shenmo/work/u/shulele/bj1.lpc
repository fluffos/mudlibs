inherit NPC;
inherit F_MASTER;
string ask_renwu();

void create() {
  set_name("王方平", ({ "wang fangping", "wang", "fangping" }));
  set("gender", "shen");
  set("age", 43);
  set("str", 30);
  set("per", 26);
  set("int", 30);
  set("cor", 50);
  set("cps", 50);
  set("long", "负责辞官的使者。\n");
  set("combat_exp", 1200000);
  set("max_sen", 2800);
  set("max_kee", 4400);
  set("force", 2000);
  set("max_force", 1800);
  set("force_factor", 80);
  set("inquiry", ([

    "兵解": (: ask_renwu :),
  ]));

  create_family("人族", 3, "紫");
  set("chat_chance_combat", 60);

  set("class", "shen");

  setup();

  carry_object("/d/obj/armor/tiejia")->wear();

}

int ask_renwu() {
  object who = this_player();

  if ((int)who->query("zhuanshi") == 4) {
    command("say 你还没四转！");
    return 1;
  }
  if ((int)who->query("level") < 1500) {
    command("say 你的等级不足，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query("combat_exp") < 2000000000) {
    command("say 你的武学不足，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query("daoxing") < 2000000000) {
    command("say 你的道行不足，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query("shen") < 100000) {
    command("say 你现在元神低于10万，进了油锅恐怕就难出来了！");
    return 1;
  }
  if ((int)who->query("rsg_eaten") < 52) {
    command("say 你去多吃些人参果吧，在油锅煎熬的时候能少受些罪！");
    return 1;
  }
  if ((int)who->query_skill("force", 1) < 1500) {
    command("say 你的内功心法修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query_skill("spells", 1) < 1500) {
    command("say 你的基本法术修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query_skill("dodge", 1) < 1500) {
    command("say 你的基本轻功修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query_skill("unarwhod", 1) < 1500) {
    command("say 你的扑击格斗之技修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query_skill("parry", 1) < 1500) {
    command("say 你的拆招卸力之法修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)who->query_skill("literate", 1) < 1500) {
    command("say 你的读书识字水平太差，还是过些时间再来吧！");
    return 1;
  }
  if (!who->query("obstacle/reward")) {
    command("say 你先去西域求取真经吧！");
    return 1;
  }
  if (who->query("dntg/laojunlu") != "done") {
    command("say 无名鼠辈，休得烦我！");
    return 1;
  }
  command("chat " + who->nawho() + "兵解成功！");

  who->set("zhuanshi", 1);
  who->set("samsara_1", 1);

  who->set("max_kee", 200);
  who->set("kee", 200);
  who->set("eff_kee", 200);
  who->set("max_sen", 250);
  who->set("sen", 250);
  who->set("eff_sen", 250);
  who->set("maximum_force", 0);
  who->set("max_force", 0);
  who->set("force", 0);
  who->set("force_factor", 0);
  who->set("maximum_mana", 0);
  who->set("max_mana", 0);
  who->set("mana", 0);
  who->set("mana_factor", 0);
  who->set("combat_exp", 1000000);
  who->set("daoxing", 1000000);
  who->set("office_number", 0);
  who->delete("degree");
  who->set("bellicosity", 0);
  who->set("haomao", 3);

  who->set("叛师/num", 0);
  who->set("title", "普通百姓");
  who->delete("family");
  who->set("age", 14);
  who->set("mud_age0", (int)who->query("mud_age"));
  who->set("mud_age", 0);
  who->set("MKS", 0);
  who->set("PKS", 0);
  who->set("DIE", 0);
  who->set("weiwang", 0);
  who->set("faith", 0);
  who->set("shen", 0);
  //         who->set("rsg_eaten",0);
  who->delete("swordman/dead_perform");
  who->delete("swordman/tianxiang_perform");
  who->delete("swordman/zhizhixiong");
  who->delete("swordman/wuxiang_perform");
  who->delete("swordman/yanling_perform");
  who->delete("obstacle");
  who->delete("dntg");
  who->delete("bieji1");
  who->delete("bieji");
  who->delete("9sky");
  who->delete("gift");
  who->delete("shenlonggive1");
  who->delete("shenlonggive2");
  who->delete("shenlonggive3");
  who->set("xiuluo/give_rulai", "done");


  who->set("shilian", 0);
  who->set("ziyougift", 0);
  who->set("zhongkui", 0);
  if (who->query("busi_agree") == 0) who->set("sheli_ask", 0);
  who->set("chshjue_ask", 0);
  who->set("chshjue_agree", 0);
  who->set("dzxy_ask", 0);
  who->set("dzxy_agree", 0);
  who->set("yumo_ask", 0);
  who->set("yumo_agree", 0);
  who->set("wuhu_ask", 0);
  who->set("wuhu_agree", 0);
  who->set("dgbang_ask", 0);
  who->set("dgbang_agree", 0);
  who->set("xlzhang_ask", 0);
  who->set("xlzhang_agree", 0);
  who->set("lbwb_try", 0);
  who->set("lbwb_agree", 0);
  who->set("tianhe_agree", 0);
  who->set("dianxue_agree", 0);
  who->add("spi", 5);
  return 1;
}
