#include <ansi.h>
inherit NPC;
int qu_chubang();
void create()
{
        set_name("护卫", ({"huwei", "hu"}));
        set("age", 72);
        set("gender", "男性");
        set("long",
"这个人是帮派护卫．\n");
        set("title", "打狗还得看主人");
        set("attitude", "friendly");
        set("max_kee", 800);
        set("max_sen", 700);
        set("combat_exp", 100000);
        set("daoxing", 50000);

        set("shen_type", 1);
        set("max_force", 300);
        set("force", 300);
        set("force_factor", 15);
        set_skill("unarmed", 100);
        set_skill("changquan", 100);
        set_skill("dodge", 100);
        set_skill("parry", 100);
        map_skill("unarmed", "changquan");
        set("chat_chance",1);
        set("inquiry", ([
	        "name": "虽然没得交椅坐，实权在握人人怕。\n",
                  "送我出帮":(:qu_chubang:),
        ]));		
        setup();
        carry_object("/d/obj/cloth/choupao")->wear();
        carry_object("/d/obj/book/quanjing");
}

int qu_chubang()
{
    this_player()->move("/obj/xyb/shop");
    return 1;
}