int do_jianzao(string name) {
  object me;
  me = this_player();
  if (!me->query("jianf")) {
    write("未经批准，不准建房");
    return 1;
  }
  if (!name)
    write("输入");
  if (!jfzl(name))
    return 1;
  zaofan("jian", name);
  return 1;
}
