//帮派继承文件
//欲实现功能，
/*建造函数接口，修改接口，以及拆房接口
 * 凡继承此函数着均可造房，拆房，就装潢房屋，
 *
 */
#include <ansi.h>
mapping name = ([ "binqi": "兵器室", "xiuxi": "休息室", "cangbao": "藏宝室", "didao": "地道" ]);
int chaxun(mixed *list, mixed lst);  ////0 没有，1有
int zaofan(string arg, string name)  //造房
{
  string brg, crg, file, file1, file2, *xf, xfz;  //file2新房内容
  object env, me;
  string *direc = ({ "north", "south", "east", "west", "up", "east" });
  string *direc1 = ({ "south", "north", "west", "east", "east", "up" });  //方向
  me = this_player();
  env = environment(me);
  if (arg == "n" || arg == "N")
    return 1;

  if (arg == "jian") {
    brg = HIG + "呵呵建造开始了首先修条路吧\n";
    brg += "请输入方向，为避免混乱不堪\n";
    brg += "只可修建地下室，楼层，以及向\n东南西北扩张\n" + NOR;
    crg = "";
    for (int i = 0; i < sizeof(direc); i++) {
      if (!env->query("exits/" + direc[i]))
        crg += "  " + direc[i];
    }
    brg += "好了，请输入你想要扩张的方向你可以向\n" + HIY + crg + NOR + "\n等方向扩张\n";
    write(brg);
    input_to("zaofan", name);
    return 1;
  }
  for (int i = 0; i < sizeof(direc); i++) {
    if (!env->query("exits/" + direc[i]))
      crg = direc[i];
    if (arg == crg) {
      brg = "好了，你决定在" + arg + "方向扩张\n";
      //此处写入文件
      xf = explode(base_name(environment(me)), "/");  //打断
      for (int m = 0; m < (sizeof(xf) - 1); m++)  //连接
      {
        if (!xfz)
          xfz = "/" + xf[m];
        else xfz += "/" + xf[m];
      }
      for (int j = 0; j < 10; j++) {
        file1 = sprintf("%s/%s%d.lpc", xfz, name, random(99999));  //新的房子文件
        if (file_size(file1) == -1 || file_size(file1) == -2)
          break;
      }

      file = read_file(base_name(environment(me)) + ".lpc");  //读取文件
      file = replace_string(file, "set(\"exits\", ([",
        "set(\"exits\", ([\n" + "\"" + arg + "\"" + " : \"" + file1 + "\",");
      if (write_file(base_name(environment(me)) + ".lpc", file, 1))
        write("成功\n");
      environment(me)->set("exits/" + arg, file1);  //写入本地
      file2 = read_file("/u/weilai/bangpai/" + name + ".lpc");
      file2 = replace_string(file2, "set(\"exits\", ([",
        "set(\"exits\", ([\n" + "\"" + direc1[i] + "\"" + " : \"" + base_name(environment(me)) + "\",");

      if (write_file(file1, file2, 1))
        write("\n房子建好了\n");
      me->add("jianf", -1);
      return 1;
    }
    //brg+="你想修建什么样的房子呢，目前帮派可修建的房子为";

  }
  brg = "看来你的输入错误了\n";
  brg += "如果想放弃请输入N\n否则还是重新输入方向吧\n";
  write(brg);
  input_to("zaofan", name);
  return 1;
}
int jfzl(string arg) {
  string brg, *list;
  object ob;
  list = keys(name);
  if (!arg) {
    brg = "你想要建造什么样的房子呢\n";
  } else {
    if (arg == "N" || arg == "n")
      return 0;

    if (!chaxun(list, arg))
      brg = "你要建何种类型的呢\n";
  }
  if (brg) {
    for (int i = 0; i < sizeof(list); i++)
      brg += name[list[i]] + "(" + list[i] + ")   ";
    //   brg+="\n 要是想放弃请输入n";
    //     input_to("jfzl");
    write(brg);
    return 0;
  }
  return 1;

}
int chaxun(mixed *list, mixed lst)  ////0 没有，1有
{
  if (!list)
    return 0;
  if (sizeof(list) < 1)
    return 0;
  for (int i = 0; i < sizeof(list); i++) {
    if (lst == list[i])
      return 1;
  }
  return 0;
}
