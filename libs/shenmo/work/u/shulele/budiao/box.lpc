//huarong 2003.7
inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIR "精装云丹盒" NOR, ({ "jinchuang box", "box" }));
  set_weight(5000);
  set_max_encumbrance(8000);
  if (clonep()) {
    object a;
    seteuid(getuid());
    if (a = new("/u/shulele/budiao/yundan"))
      a->move(this_object());
    seteuid(getuid());
    set_default_object(__FILE__);
  } else {
    set("unit", "只");
    set("long", "这是一只5000包装的非常精致的云丹药盒。\n");
    set("value_c", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("no_put", 1);
    set("no_drop", 1);
    set("no_give", 1);
  }
}

int is_container() { return 1; }
