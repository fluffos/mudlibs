#include <ansi.h>
inherit NPC;

int accept_fight(object ob) {
  kill_ob(ob);
  return -1;
}

int accept_kill(object ob) {
  return 1;
}

varargs int receive_damage(string type, int damage, object who, string kind) {
  if (!random(4)) {
    this_object()->stop_busy();
  }

  ::receive_damage(type, damage, who, kind);
}

void init() {
  object me = this_object();

  if (sscanf(base_name(environment()), "/d/kaifeng/linggt/%*s")) {
    kill_ob(this_player());
  }

  me->reset_action();
}

void die() {
  object me = this_object();
  object killer = query_temp("last_damage_from");

  if (!me || !killer) {
    return;
  }

  if (environment() && objectp(environment())) {
    environment()->pass(killer);
  }

  message_vision("$N死了。\n", me);

  destruct(me);

  return;
}

void unconcious() {
  die();
}

void create() {
  set_name(HIC + "灵感塔" + HIR + "武痴" + NOR, ({ "wu chi", "boss" }));
  set("title", "测试NPC");
  set("wmsg", "测试NPC");

  set("age", 1);
  set("str", 1);
  set("dex", 1);
  set("con", 1);
  set("int", 1);

  setup();
}

int is_boss() {
  return 1;
}
