// redl 2012/11/1 
//商城物品，每轮闯关限制使用
#include <ansi.h>

inherit COMBINED_ITEM;

void create() {
  set_name(YEL "飞刀" HIC "灵符" NOR, ({ "fly knife", "knife", "fei dao" }));
  set("long", NOR + WHT "这是一支杨小邪的飞刀，薄得近乎透明，上面还有一些乱七八糟的篆文，在灵感塔上可以使用它(use knife)。\n" NOR);
  set("base_unit", "支");
  set("base_value", 1000);
  set("base_weight", 600);
  set("unit", "把");
  setup();
  set_amount(3);
}

int value() {
  return query_amount() * (int)query("base_value");
}

string query_autoload() {
  return query_amount() + "";
}

void autoload(string param) {
  int amt;

  if (sscanf(param, "%d", amt) == 1) {
    set_amount(amt);
  }
}
