int valid_leave(object me, string dir)
{       
        object a;
        if( wizardp(me)) return 1;

        if (dir == "down") {
                if ( me->query("combat_exp")>1500000000 )
                return notify_fail("你的武学太高了！\n");
        return ::valid_leave(me, dir);
        }

        return 1;
}

