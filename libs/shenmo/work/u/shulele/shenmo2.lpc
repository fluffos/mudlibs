inherit ITEM;
void create()
{
  set_name("〖神魔心法〗", ({"shengong"}));
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "
神魔心法，博大精深。\n");
    set("material", "paper");
    set("value", 20);
   set("no_paimai", 1);
  }
}

void init()
{
  if (!wizardp(this_player())) {
    set("no_get", 1);
    set("no_drop",1);
    set("no_sell",1);
    
  }
  add_action("do_read", "read");
  add_action("do_read","du");
}

int do_read(string arg)
{
  object me=this_player(),book=this_object();
  int sen_cost, gain,lev,exp;

  if( !book->id(arg) ) return notify_fail("你要读什么？\n");
  if( environment(book)!=me ) return notify_fail("书要拿起来读。\n");
  if(me->is_busy()) return notify_fail("你现在忙着呢，还是等静下心来再读书吧！\n");
  if(me->is_fighting()) return notify_fail("临阵磨枪可来不及啦！\n");
  if( (int)me->query_skill("shenmo-force",1)<1 )
    return notify_fail("你怎么读也读不懂上面写的是什么。\n");
  if( (int)me->query_skill("shenmo-force",1)>500 )
    return notify_fail("你在这方面已经很有造诣，这本书不会让你长进多少。\n");
sen_cost=20+(40-(int)me->query_int())+(35-(int)me->query_kar())+(int)lev/5;
  if( (int)me->query("sen")<sen_cost )
    return notify_fail("你现在头晕脑胀，该休息休息了。\n");	
	me->receive_damage("sen", sen_cost);
  gain -= random(me->query_int());
  gain +=random(me->query_kar());
  if(gain < 0) gain=0;
  me->improve_skill("shenmo-force", gain);

  message_vision("$N正专心地研读"+book->query("name")+"。\n", me);
  tell_object(me, "你专心研读神魔心法，似乎有点心得。\n");

  return 1;
}





