inherit NPC;

#include <obstacle.h>
#include <ansi.h>
#include <localtime.h>

void zhuanshi(object ob);
string check_gift();
int zhuanjie();
int tianjie();
int baoyu();
int return_baoyu();
int status();
mapping gift = ([
  "str": "膂力",
  "cor": "胆识",
  "int": "悟性",
  "spi": "灵性",
  "cps": "定力",
  "per": "容貌",
  "con": "根骨",
  "kar": "福缘",
]);
string *gift_name = ({ "kar", "con", "per", "cps", "spi", "int", "cor", "str", });

void create() {
  set_name("兵解大师", ({ "bingjie", "dashi" }));
  set("title", HIR "盘龙出沧海" NOR);
  set("long", "如果有一棒不能解决的事，那就多来几棒。\n");
  set("gender", "男性");
  set("attitude", "peaceful");
  set("str", 100);
  set("per", 100);
  set("max_kee", 100000);
  set("max_gin", 100000);
  set("max_sen", 100000);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 500);
  set("max_mana", 10000);
  set("mana", 10000);
  set("mana_factor", 500);
  set("combat_exp", 4000000);
  set("daoxing", 10000000);

  set("inquiry", ([
    "转世": (: zhuanjie :),
    //  "通灵宝玉": (: baoyu :),
    "status": (: status :),
    "九九天劫": (: tianjie :),
    "天赋": (: check_gift :),
    //    "归还宝玉": (: return_baoyu :),
  ]));
  setup();
  carry_object("/d/obj/cloth/baguapao")->wear();
}
string check_gift() {
  object me = this_player();
  string msg;
  int i = sizeof(gift_name);
  msg = "你目前的天赋如下：\n\n";
  while (i--) {
    msg += gift[gift_name[i]] + "：[" + me->query(gift_name[i]) + "]";
    if (i == 4) msg += "\n";
    else msg += "\t";
  }
  msg += "\n";
  tell_object(me, msg);
  return "少年，我看你骨骼精奇，是万中无一的武学奇才，维护世界和平就靠你了，我这有本秘籍--->《如来神掌》，见与你有缘，就十块卖给你了！";
}
//暂时在4转中开放，是否拓展以后再说
int tianjie() {
  object me, ob;
  int kar, needexp;
  me = this_object();
  ob = this_player();
  //    int zjfx;
  //i=ob->query("zhuanshi");
  //      zjdx=60000+20000*(int)ob->query("zhuanshi");
  kar = 100 + 100 * (int)ob->query("zhuanshi");
  if (kar > 50) kar = 50;
  needexp = 30000 * 1000 + 30000 * 1000 * ob->query("zhuanshi");
  if (needexp > 300000000) needexp = 300000000;
  if (ob->query("zhuanshi") >= 4) {
    if (ob->query("kar") < kar) {
      message_vision("$N对$n摇头说道：你的魅力不足" + kar + "点，还是多去参加斗法大赛吧！\n", me, ob);
      return 1;
    }
    if (ob->query("obstacle/number") < 26) {
      message_vision("$N对$n摇头说道：吃得苦中苦，方为人上人，你尚未历尽难关，还是请回吧！\n", me, ob);
      return 1;
    }
    if (ob->query("dntg/number") < 10) {
      message_vision("$N对$n摇头说道：吃得苦中苦，方为人上人，你尚未完成大闹天宫，还是请回吧！\n", me, ob);
      return 1;
    }
    //if (ob->query("daoxing")<needexp || ob->query("combat_exp")<needexp)
    if ((ob->query("daoxing") + ob->query("combat_exp")) < needexp * 2) {
      me->command("say 你的总经验不满" + chinese_number(needexp) + "武学和" + COMBAT_D->chinese_daoxing(needexp) + "道行，还是回去好好修炼一番吧！\n");
      return 1;
    } else {
      message_vision("$N问道：这位" + RANK_D->query_respect(ob) + "想继续转世么？\n", me);
      ob->set_temp("ask_guili/mojie", 1);
      ob->set("tianshu/tianshu1", 1);
      ob->set("tianshu/tianshu2", 1);
      ob->set("tianshu/tianshu3", 1);
      ob->set("tianshu/tianshu4", 1);
      ob->set("jiujie_mo", "begin");
      return 1;
    }
  } else {
    message_vision("$N诧异道：天机不够泄露，这位" + RANK_D->query_respect(ob) + "还是请回吧。\n", me);
    return 1;
  }
}


int zhuanjie() {
  object ob = this_player();
  object me = this_object();
  mapping skill;
  string *skillnames;
  int i;
  int zssk = 300 + 100 * ob->query("zhuanshi");
  if (zssk > 1200) zssk = 1200;

  if (ob->query("jiujie_mo") != "begin") {
    message_vision("$N摇头说道：这位" + RANK_D->query_respect(ob) + "的修为尚浅，还是多加修炼才是，切莫超之过急。\n", me);
    return 1;
  }
  if (ob->query("tianshu/tianshu1") + ob->query("tianshu/tianshu2") + ob->query("tianshu/tianshu3") + ob->query("tianshu/tianshu4") < 4) {
    message_vision("$N诧异道：这位" + RANK_D->query_respect(ob) + "，找齐四本天书了么？\n", me);
    return 1;
  }

  /*    skill=ob->query_skills();
         skillnames=keys(skill);
         for(i=0;i<sizeof(skillnames);i++)
             { 
               if (ob->query_skill(skillnames[i], 1) < zssk)
                   { 
                    message_vision ("$N摇头说道：这位"+RANK_D->query_respect(ob)+"你虽想要继续转世，但武功修为距" + zssk +"级尚有些差距，还是多加修炼才是，切莫超之过急。\n",me);
                    return 1;
                   } 
              }  */

  message_vision("$N道：既然你想继续转世，便可在此修行，我亦会在此为你护法！\n", me);
  message_vision(HIC "$N心中大喜，连忙坐下，，，渐渐的，你似有所悟。\n" NOR, ob);
  ob->start_busy(10);
  ob->delete("tianshu");
  ob->set("jiujie_mo", "done");
  ob->set_temp("zhuanjie", 1);
  ob->set_temp("msg", 0);
  call_out("msgs", 1, ob);
  return 1;
}

void msgs(object me) {
  if (!me) return;
  me->add_temp("msg", 1);
  if (me->query_temp("zhuanjie") > 0) {
    if (me->query_temp("msg") == 1) {
      message_vision(BLK "■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■\n" NOR, me);
      message_vision(HIG "■■■■■■■■■■■■太      极      玄      道      清■■■■■■■■■■■■\n" NOR, me);
      message_vision(BLK "■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■\n" NOR, me);
      call_out("msgs", 3, me);
    }
    if (me->query_temp("msg") == 2) {
      message_vision(BLK "■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■\n" NOR, me);
      message_vision(HIY "■■■■■■■■■■■■大         梵         般         若■■■■■■■■■■■■\n" NOR, me);
      message_vision(BLK "■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■\n" NOR, me);
      call_out("msgs", 3, me);
    }
    if (me->query_temp("msg") == 3) {
      message_vision(BLK "■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■\n" NOR, me);
      message_vision(HIR "■■■■■■■■■■■■焚         香         玉         册■■■■■■■■■■■■\n" NOR, me);
      message_vision(BLK "■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■\n" NOR, me);
      call_out("msgs", 3, me);
    }
    if (me->query_temp("msg") == 4) {
      message_vision(HIR "你觉得全身轻松，觉得自己的修为到了另一层境界。\n" NOR, me);
      call_out("zhuanshi", 2, me);
    }
  }
}


void zhuanshi(object me) {
  int dxneed, dxleft, wxleft, skleft, myexp, mydh, expleft, zsjnfpd, skcost, i;
  object baoyu;
  string *skills;
  mapping all_skills;
  zsjnfpd = 5 + 5 * me->query("zhuanshi");
  if (zsjnfpd > 50) zsjnfpd = 50;
  dxneed = 30000 * 1000 + 20000 * 1000 * me->query("zhuanshi");
  if (dxneed > 210000000) dxneed = 210000000;
  dxleft = me->query("daoxing") - dxneed;
  wxleft = me->query("combat_exp") - dxneed;
  //skleft=100+75*me->query("zhuanshi");
  myexp = me->query("combat_exp");
  mydh = me->query("daoxing");
  expleft = (dxleft + wxleft) / 2;
  if (!objectp(baoyu = present("baoyu", me)))
    me->command("baoyu");
  if (!objectp(baoyu = present("baoyu", me))) return;
  me->add("jnfpd", zsjnfpd);  //可分配天赋
  baoyu->ji_cun();
  baoyu->save();  //保存技能完毕
  //开始降低或清除
  skcost = 275 + 25 * me->query("zhuanshi");
  all_skills = this_player()->query_skills();
  skills = keys(all_skills);
  for (i = 0; i < sizeof(skills); i++)
    this_player()->set_skill(skills[i], all_skills[skills[i]] - skcost);
  me->delete("obstacle");  //清除取经记录
  //me->set("PKS", 0);
  //me->set("MKS", 0);                          // 清除pk记录
  me->delete("HellZhenPass");  //地狱十八                             //
  me->delete("dntg");  //大闹天宫
  //me->delete("kill");//nkpk
  me->delete("12gong");  //12宫
  me->set("daoxing", expleft);  //平衡武学道行
  me->set("combat_exp", expleft);
  me->delete("7hai");  //12宫
  me->set("learned_points", 0);
  me->set("potential", 100000);
  me->set("c_potential", 100000);
  //me->set("mud_age",3600);
  me->add("zhuanshi", 1);
  //me->update_age();
  me->delete_temp("zhuanjie");
  me->delete_temp("msg");
  if (myexp < mydh) {
    myexp = mydh;
  } else {
    mydh = myexp;
  }
  // me->move("/d/city/kezhan");
}

int baoyu() {
  object me, ob, baoyu;
  me = this_player();
  ob = this_object();
  if (!me->query("zhuanshi")) {
    message_vision("" + HIW + "$N贼兮兮的对艾尔说道：老大能借块宝玉用用嘛？\n", me);
    message_vision("$N" + HIW + "唱道：幺幺切克闹，我说宝玉你说要~" + NOR + "\n", ob);
    message_vision("" + HIW + "$N应道：幺幺切克闹，宝玉我要我还要~" + NOR + "\n", me);
    message_vision("$N" + HIW + "给了你一个通灵宝玉并叮嘱到：这是我从隔壁娘们身上摸来的，应劫的时候记得还回来再去找那娘们~" + NOR + "\n", ob);
    baoyu = new("/u/weilai/tianjie/baoyu/baoyu");  //开始给宝玉
    baoyu->move(me);
    baoyu->set("wuzhu", me->query("id"));
    me->set("jiujie_xin/baoyu", "y");
    me->command("baoyu");
  } else {
    message_vision("$N" + HIW + "叹道：宝玉你已到手，前途漫漫，好自为之吧" + NOR + "\n", ob);
  }
  return 1;
}

int return_baoyu() {
  object me, ob, baoyu;
  me = this_player();
  ob = this_object();
  if (!me->query("zhuanshi") && me->query("jiujie_xin/baoyu") == "y") {
    me->command("baoyu");
    me->set("jiujie_xin/baoyu", "n");
    message_vision("$N" + HIW + "悄悄说道：你来的正好，那老娘们发现宝玉不见了，正在一哭二闹三上吊呢~" + NOR + "\n", ob);
    message_vision(
      "" + HIW + "$N赶紧摸出宝玉想还给" + NOR + "$n," + HIW + "却发现宝玉已经失去了光华。" + NOR + "\n",
      me,
      ob
    );
    message_vision("$N" + HIW + "恨恨的说道：那老娘们诓我，她早就收回了宝玉精华了，这一切都是她装的！老子找她算账去！！" + NOR + "\n", ob);
    message_vision("$N" + HIW + "刚走了几步，突然停住，嘴里念道：。。。算了，老娘们快发现肚兜没了。。我先溜了。。" + NOR + "\n", ob);
    message_vision(
      "$N" + HIW + "又一转身眨眼间就不见了。。。这时你听到隔壁绛姝仙子发出一声惊呼：可恶。。。我的肚兜呢？沐浴前我记得挂在屏风后面的！" + NOR + "\n",
      ob
    );
  } else {
    message_vision(
      "$N" + HIW + "不耐烦的吼道：别闹，隔壁老娘们发现宝玉不见了，正在一哭二闹三上吊呢，那家伙说借用下宝玉的，结果不知道跑哪去了现在还没还回来。" + NOR + "\n",
      ob
    );
  }
  return 1;
}

int status() {
  int skforce, skspells, maxmana, maxforce;
  object me, ob;
  me = this_player();
  ob = this_object();
  skforce = (int)me->query_skill("force", 1);
  skspells = (int)me->query_skill("spells", 1);
  maxforce = (skforce + skforce / 2 - 1) * 10;
  maxmana = (skspells + skspells / 2 - 1) * 10;
  /*maxforce = (int)me->query_max_force();
   maxmana =  (int)me->query_max_mana();*/
  if (me->query("zhuanshi") >= 3) {
    //message_vision("$N"+HIW+"给了$n一本《易筋经》,就急匆匆的走了。"+NOR+"\n",ob,me);  
    //message_vision(""+HIW+"$N仔细的研读《易筋经》,似乎有些领悟。\n",me);  
    me->set("max_force", maxforce);
    me->set("max_mana", maxmana);
    me->set("maximum_force", maxforce);
    me->set("maximum_mana", maxmana);
  } else {
    message_vision("$N" + HIW + "瞥了$n一眼，心思又不知道飘到哪里了。" + NOR + "\n", ob, me);
  }
  return 1;
}
