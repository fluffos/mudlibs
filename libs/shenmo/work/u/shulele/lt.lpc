// Room: /u/wuxin/大同路.c
#include <ansi.h> 
inherit ROOM;

void create()
{
        set("short", "小兔灵堂");
	set("long", @LONG

听说这里是死兔子的灵堂，前面是小兔的裸照，前面插着三炷香，在这里你可以吐口水(tu)
LONG
	);
	
	set("valid_startroom", 1);

	setup();
	
}

void init()
{   
	if (!wizardp(this_player())) {
          this_player()->set("startroom","/u/shulele/lt");
	  this_player()->save();
          add_action("block_cmd","",1);   
	}
        add_action("do_tu","tu");
}

int block_cmd()
{
        string verb = query_verb();
	
        if (verb=="say") return 0; //allow say
	if (verb=="help") return 0;
        if (verb=="look") return 0;
        if (verb=="tu") return 0;
	return 1;
}

// added by bula, just for fun.



int do_jian(string arg)
{
object who, tu;
who=this_player();
        if( !arg )
            return notify_fail("你要做什么？\n");
        if( arg =="tu")
{
        write(HIW"你狠狠的向小兔的裸照吐了一口口水！\n"NOR);
        call_out("tu", 3, who);
}
}

void tu()
{
          write(HIW"你突然感觉死兔子鬼魂向你扑来，只觉菊花一痛就失去知觉了！\n"NOR);
      this_player()->unconcious();

}
