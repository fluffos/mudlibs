#include "../npc.h"

string *name = ({
  "狐妖",
  "狐仙",
});

void create() {
  int i;
  set_name("古墓叛徒", ({ "pantu", "pan tu" }));
  set("title", HIY + name[random(sizeof(name))] + NOR);
  set("age", 20 + random(80));
  set("name2", query("name"));
  set("title2", query("title"));
  set("id2", query("id"));

  set("no_drop", 1);
  set("no_get", 1);
  set("attitude", "heroism");
  set("chat_chance", 5);
  setup();
}

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;
  int exp;

  set("family/family_name", "轩辕古墓");
  set("gender", "女性");

  me->set_skill("unarmed", j + random(5));
  me->set_skill("dodge", j + random(5));
  me->set_skill("parry", j + random(5));
  me->set_skill("force", j + random(5));
  me->set_skill("spells", j + random(5));
  me->set_skill("needle", j + random(5));
  me->set_skill("throwing", j + random(5));
  me->set_skill("huxing-step", j + random(5));
  me->set_skill("xuanhu-shentong", j + random(5));
  me->set_skill("xuanhu-xinfa", j + random(5));
  me->set_skill("fox-hand", j + random(5));
  me->set_skill("tianyi-zhen", j + random(5));

  me->map_skill("force", "xuanhu-xinfa");
  me->map_skill("parry", "tianyi-zhen");
  me->map_skill("needle", "tianyi-zhen");
  me->map_skill("throwing", "tianyi-zhen");
  me->map_skill("spells", "xuanhu-shentong");
  me->map_skill("dodge", "huxing-step");
  me->map_skill("unarmed", "fox-hand");

  exp = query("combat_exp");

  if (exp > 500000) {
    set("chat_chance_combat", level);
    set("chat_msg_combat", ({
      (: cast_spell, "feisha" :),
      (: cast_spell, "luan" :),
      (: perform_action, "needle.caidie" :),
      (: perform_action, "needle.jue" :),
    }));

    if (exp < 10000000) {

      weapon = new("/clone/weapon/needle");
      weapon->move(me);
      command("wield all");
    } else {
      weapon = new("/clone/weapon/needle1");
      weapon->move(me);
      command("wield all");
    }
  }
}
