
#include "../npc.h"

string* name=({
    "将军",
    "都督",
});

void create()
{
    int i;
    set_name("将军府叛徒",({"pantu","pan tu"}));
    set("class","fighter");
    set("title", HIM+name[random(sizeof(name))]+NOR);
    set("age",20+random(80));
    set("name2",query("name"));
    set("title2",query("title"));
    set("id2",query("id"));

    set("no_get",1);
    set("no_drop",1);
    set("attitude","heroism");
    set("chat_chance", 5);
    setup();
}

void set_skills(int j, int level)
{
    object me=this_object();
    object weapon;
    int exp;set("family/family_name","将军府");

    set_skill("unarmed", j+random(5));
    set_skill("dodge", j+random(5));
    set_skill("parry", j+random(5));
    set_skill("force", j+random(5));
    set_skill("spells", j+random(5));
    set_skill("spear", j+random(5));
    set_skill("bawang-qiang", j+random(5));
    set_skill("changquan", j+random(5));    
    set_skill("lengquan-force", j+random(5));       
    set_skill("yanxing-steps", j+random(5));    
    set_skill("zhanqi", j+random(5));

    map_skill("spear","bawang-qiang");
    map_skill("force", "lengquan-force");
    map_skill("parry", "sanban-axe");
    map_skill("spells", "zhanqi");
    map_skill("dodge", "yanxing-steps");
    map_skill("unarmed", "changquan");
    
    exp=query("combat_exp");
    if(exp>500000)
    {
        set("chat_chance_combat",level);
        set("chat_msg_combat", ({
           (: perform_action, "spear.jingyan" :),
           (: perform_action, "unarmed.zhiqi" :),
           (: cast_spell, "zhengqi" :), 
        }) );

        weapon=new("/d/obj/weapon/spear/blackspear");  
        weapon->move(this_object());
        command("wield all"); 
    }
}

