
#include "../npc.h"

string* name=({
    "刺客",
    "杀手",
});

void create()
{
    int i;
    set_name("散仙叛徒",({"pantu","pan tu"}));
    set("title", HIB+name[random(sizeof(name))]+NOR);
    set("age",20+random(80));
    set("name2",query("name"));
    set("title2",query("title"));
    set("id2",query("id"));
    set("attitude","heroism");
    set("no_drop",1);
    set("no_get",1);
    set("chat_chance", 5);
    setup();
}

void set_skills(int j, int level)
{
    object me=this_object();
    object weapon;
    int exp;

    set("family/family_name","三界散仙");
    
    me->set_skill("unarmed", j+random(5));
    me->set_skill("dodge", j+random(5));
    me->set_skill("parry", j+random(5));
    me->set_skill("force", j+random(5));
    me->set_skill("spells", j+random(5));
    me->set_skill("sword",  j+random(5));        
    me->set_skill("binfen-steps", j+random(5));
    me->set_skill("mysticism", j+random(5));
    me->set_skill("butian-force", j+random(5));
    me->set_skill("ice_fire_zhang", j+random(5));
    me->set_skill("spysword", j+random(5));

    me->map_skill("force", "butian-force");       
    me->map_skill("parry", "spysword");
    me->map_skill("sword", "spysword");
    me->map_skill("spells", "mysticism");
    me->map_skill("dodge", "binfen-steps");
    me->map_skill("unarmed", "ice_fire_zhang");

    set("chat_chance_combat",level);
    set("chat_msg_combat", ({
       (: cast_spell, "gold" :),
       (: perform_action, "sword.bishou" :),
    }) );
    
    weapon=new("/d/obj/weapon/sword/qingfeng");
    weapon->move(me);
    command("wield all");    
}


