#include "../npc.h"

string *name = ({
  "猪妖",
  "猪怪",
});

void create() {
  int i;
  set_name("天蓬府叛徒", ({ "pantu", "pan tu" }));
  set("title", HIC + name[random(sizeof(name))] + NOR);
  set("age", 20 + random(80));
  set("name2", query("name"));
  set("title2", query("title"));
  set("id2", query("id"));
  set("attitude", "heroism");
  set("no_drop", 1);
  set("no_get", 1);
  set("chat_chance", 5);
  setup();
}

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;
  int exp;

  set("family/family_name", "天蓬府");
  set("gender", "男性");

  me->set_skill("unarmed", j + random(5));
  me->set_skill("dodge", j + random(5));
  me->set_skill("parry", j + random(5));
  me->set_skill("force", j + random(5));
  me->set_skill("spells", j + random(5));
  me->set_skill("rake", j + random(5));
  me->set_skill("meng-steps", j + random(5));
  me->set_skill("guiyuanshentong", j + random(5));
  me->set_skill("xuantian-xinfa", j + random(5));
  me->set_skill("hunyuan-zhang", j + random(5));
  me->set_skill("skyriver-rake", j + random(5));

  me->map_skill("force", "xuantian-xinfa");
  me->map_skill("parry", "skyriver-rake");
  me->map_skill("rake", "skyriver-rake");
  me->map_skill("spells", "guiyuanshentong");
  me->map_skill("dodge", "meng-steps");
  me->map_skill("unarmed", "hunyuan-zhang");

  set("chat_chance_combat", level);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.hunyuan" :),
    (: perform_action, "rake.potian" :),
  }));

  weapon = new("/d/obj/weapon/rake/gangpa");
  weapon->move(me);
  command("wield all");
}
