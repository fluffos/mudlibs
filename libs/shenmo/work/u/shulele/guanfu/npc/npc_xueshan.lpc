#include "../npc.h"

string *name = ({
  "老妖",
  "妖王",
});

void create() {
  int i;
  set_name("雪山叛徒", ({ "pantu", "pan tu" }));
  set("title", HBBLU + name[random(sizeof(name))] + NOR);
  set("age", 20 + random(80));
  set("name2", query("name"));
  set("title2", query("title"));
  set("id2", query("id"));

  set("attitude", "heroism");
  set("no_drop", 1);
  set("no_get", 1);
  set("chat_chance", 5);
  setup();
}

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;
  int exp;

  set("family/family_name", "大雪山");
  set("perform/chaofeng", 1);
  set_temp("ningxie", 1);


  me->set_skill("unarmed", j + random(5));
  me->set_skill("dodge", j + random(5));
  me->set_skill("parry", j + random(5));
  me->set_skill("force", j + random(5));
  me->set_skill("spells", j + random(5));
  me->set_skill("sword", j + random(5));
  me->set_skill("xiaoyaoyou", j + random(5));
  me->set_skill("dengxian-dafa", j + random(5));
  me->set_skill("ningxie-force", j + random(5));
  me->set_skill("cuixin-zhang", j + random(5));
  me->set_skill("birds-sword", j + random(5));

  me->map_skill("force", "ningxie-force");
  me->map_skill("parry", "birds-sword");
  me->map_skill("sword", "birds-sword");
  me->map_skill("spells", "dengxian-dafa");
  me->map_skill("dodge", "xiaoyaoyou");
  me->map_skill("unarmed", "cuixin-zhang");


  exp = query("combat_exp");

  if (exp > 500000) {
    set("chat_chance_combat", level);
    set("chat_msg_combat", ({
      (: cast_spell, "juanbi" :),
      (: perform_action, "sword.chaofeng" :),
      (: perform_action, "sword.feijian" :),
    }));
    if (exp < 10000000) {
      weapon = new("/d/obj/weapon/sword/changjian");
      weapon->move(me);
      command("wield all");
    } else {
      weapon = new("/d/obj/weapon/sword/qingfeng");
      weapon->move(me);
      command("wield all");
    }
  }
}
