
#include "../npc.h"

string* name=({
    "蜘蛛精",
    "蜘蛛怪",
});

void create()
{
    int i;
    set_name("盘丝洞叛徒",({"pantu","pan tu"}));
    set("title", HIB+name[random(sizeof(name))]+NOR);
    set("age",20+random(80));
    set("name2",query("name"));
    set("title2",query("title"));
    set("id2",query("id"));
    set("attitude","heroism");
    set("no_drop",1);
    set("no_get",1);
    set("chat_chance", 5);
    setup();
}

void set_skills(int j, int level)
{
    object me=this_object();
    object weapon;
    int exp;

    set("family/family_name","盘丝洞");
    
    me->set_skill("unarmed", j+random(5));
    me->set_skill("dodge", j+random(5));
    me->set_skill("parry", j+random(5));
    me->set_skill("force", j+random(5));
    me->set_skill("spells", j+random(5));
    me->set_skill("whip",  j+random(5));        
    me->set_skill("yueying-wubu", j+random(5));
    me->set_skill("pansi-dafa", j+random(5));
    me->set_skill("jiuyin-xinjing", j+random(5));
    me->set_skill("lanhua-shou", j+random(5));
    me->set_skill("yinsuo-jinling", j+random(5));

    me->map_skill("force", "jiuyin-xinjing");       
    me->map_skill("parry", "yinsuo-jinling");
    me->map_skill("whip", "yinsuo-jinling");
    me->map_skill("spells", "pansi-dafa");
    me->map_skill("dodge", "yueying-wubu");
    me->map_skill("unarmed", "lanhua-shou");

    set("chat_chance_combat",level);
    set("chat_msg_combat", ({
       (: cast_spell, "wuzhishan" :),
       (: perform_action, "whip.tian" :),
    }) );
    
    weapon=new("/d/obj/weapon/whip/longsuo");
    weapon->move(me);
    command("wield all");    
}


