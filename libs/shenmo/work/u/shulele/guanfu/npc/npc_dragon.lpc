
#include "../npc.h"

string* xianname=({
    "龙女",
    "龙王",
});

void create()
{
    int i;
    
    set_name("龙宫叛徒",({"pantu","pan tu"}));
    set("title", HIR+xianname[random(sizeof(xianname))]+NOR);
    set("age",20+random(80));
    set("no_get",1);
    set("no_drop",1);
    set("name2",query("name"));
    set("title2",query("title"));
    set("id2",query("id"));
    set("attitude","heroism");
    set("chat_chance", 5);
    setup();
}

void set_skills(int j, int level)
{
    object me=this_object();
    object weapon;
    int exp;

    set("class","dragon");
    set("perform/leidong",1);
    set("family/family_name","东海龙宫");
        
    me->set_skill("unarmed", j+random(5));
    me->set_skill("dodge", j+random(5));
    me->set_skill("parry", j+random(5));
    me->set_skill("force", j+random(5));
    me->set_skill("spells", j+random(5));
    me->set_skill("dragonstep", j+random(5));
    me->set_skill("dragonfight", j+random(5));
    me->set_skill("dragonforce", j+random(5));
    me->set_skill("seashentong", j+random(5));

    me->map_skill("force", "dragonforce");
    me->map_skill("parry", "dragonfight");
    me->map_skill("spells", "seashentong");
    me->map_skill("dodge", "dragonstep");
    me->map_skill("unarmed", "dragonfight");

    exp=me->query("combat_exp");
    
    if(exp>500000)
    {
        set("chat_chance_combat",level);
        set("chat_msg_combat", ({
           (: perform_action, "unarmed.leidong" :),
        }) );
    }
}
