
#include "../npc.h"

string* name=({
    "血魔",
    "魔头",
});

void create()
{
    int i;
    set_name("通天教叛徒",({"pantu","pan tu"}));
    set("title", HIY+name[random(sizeof(name))]+NOR);
    set("age",20+random(80));
    set("name2",query("name"));
    set("title2",query("title"));
    set("id2",query("id"));

    set("no_drop",1);
    set("no_get",1);
    set("attitude","heroism");
    set("chat_chance", 5);
    setup();
}

void set_skills(int j, int level)
{
    object me=this_object();
    object weapon;
    int exp;

    set("family/family_name","通天教");
    set("gender", "男性");

    me->set_skill("unarmed", j+random(5));
    me->set_skill("dodge", j+random(5));
    me->set_skill("parry", j+random(5));
    me->set_skill("force", j+random(5));
    me->set_skill("spells", j+random(5)); 
    me->set_skill("sword", j+random(5));

    me->set_skill("moying-sword", j+random(5));        
    me->set_skill("fentian-mogong", j+random(5));
    me->set_skill("huanmo-dafa", j+random(5));
    me->set_skill("wuqinxi", j+random(5));
    me->set_skill("mohuan-xuying", j+random(5));

    me->map_skill("force", "fentian-mogong"); 
    me->map_skill("sword", "moying-sword");
    me->map_skill("parry", "moying-sword");
    me->map_skill("spells", "huanmo-dafa");
    me->map_skill("dodge", "mohuan-xuying");
    me->map_skill("unarmed", "wuqinxi");

    exp=query("combat_exp");
    
    if(exp>500000)
    {
        set("chat_chance_combat",level);
        set("chat_msg_combat", ({
           (: cast_spell, "mo" :),
           (: cast_spell, "count" :),
           (: perform_action, "sword.crazy" :),
           (: perform_action, "sword.xueren" :),
        }) );

        if(exp<10000000)
        {
            weapon=new("/d/obj/weapon/sword/changjian");                 
            weapon->move(me);
            command("wield all");
        }
        else
        {
            weapon=new("/d/obj/weapon/sword/qingfeng");                
            weapon->move(me);
            command("wield all");
        }
    }
}

