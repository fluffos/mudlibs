#include "../npc.h"

string *xianname = ({
  "仙官",
  "仙女",
});

void create() {
  set_name("月宫叛徒", ({ "pantu", "pan tu" }));
  set("title", HBYEL + xianname[random(sizeof(xianname))] + NOR);
  set("age", 20 + random(80));
  set("name2", query("name"));
  set("no_get", 1);
  set("no_drop", 1);
  set("title2", query("title"));
  set("id2", query("id"));

  set("attitude", "heroism");
  set("chat_chance", 5);
  setup();
}

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;
  int exp;

  me->set("class", "xian");
  me->set("family/family_name", "月宫");
  set("gender", "女性");

  me->set_skill("unarmed", j + random(5));
  me->set_skill("dodge", j + random(5));
  me->set_skill("parry", j + random(5));
  me->set_skill("force", j + random(5));
  me->set_skill("spells", j + random(5));
  me->set_skill("sword", j + random(5));
  me->set_skill("snowsword", j + random(5));
  me->set_skill("moondance", j + random(5));
  me->set_skill("moonshentong", j + random(5));
  me->set_skill("baihua-zhang", j + random(5));
  me->set_skill("moonforce", j + random(5));

  me->map_skill("force", "moonforce");
  me->map_skill("sword", "snowsword");
  me->map_skill("parry", "snowsword");
  me->map_skill("spells", "moonshentong");
  me->map_skill("dodge", "moondance");
  me->map_skill("unarmed", "baihua-zhang");

  exp = me->query("combat_exp");

  if (exp > 500000) {
    set("chat_chance_combat", level);
    set("chat_msg_combat", ({
      (: cast_spell, "arrow" :),
      (: cast_spell, "mihun" :),
      (: perform_action, "sword.tian" :),
    }));

    if (exp < 10000000) {
      weapon = new("/d/obj/weapon/sword/changjian");
      weapon->move(me);
      command("wield all");
    } else {
      weapon = new("/d/obj/weapon/sword/qingfeng");
      weapon->move(me);
      command("wield all");
    }
  }
}
