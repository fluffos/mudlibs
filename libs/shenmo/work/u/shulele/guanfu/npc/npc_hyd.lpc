
#include "../npc.h"

string* name=({
    "洞主",
    "山神",
});

void create()
{
    int i;
    set_name("火云洞叛徒",({"pantu","pan tu"}));
    set("title", HIR+name[random(sizeof(name))]+NOR);
    set("age",20+random(80));
    set("name2",query("name"));
    set("title2",query("title"));
    set("id2",query("id"));
    set("attitude","heroism");
    set("no_drop",1);
    set("no_get",1);
    set("chat_chance", 5);
    setup();
}

void set_skills(int j, int level)
{
    object me=this_object();
    object weapon;
    int exp;

    set("family/family_name","火云洞");
    me->set_skill("unarmed", j+random(5));
    me->set_skill("dodge", j+random(5));
    me->set_skill("parry", j+random(5));
    me->set_skill("force", j+random(5));
    me->set_skill("spells", j+random(5));
    me->set_skill("stick",  j+random(5));        
    me->set_skill("moshenbu", j+random(5));
    me->set_skill("pingtian-dafa", j+random(5));
    me->set_skill("huomoforce", j+random(5));
    me->set_skill("moyunshou", j+random(5));
    me->set_skill("dali-bang", j+random(5));

    me->map_skill("force", "huomoforce");       
    me->map_skill("parry", "dali-bang");
    me->map_skill("stick", "dali-bang");
    me->map_skill("spells", "pingtian-dafa");
    me->map_skill("dodge", "moshenbu");
    me->map_skill("unarmed", "moyunshou");

    set("chat_chance_combat",level);
    set("chat_msg_combat", ({
       (: perform_action, "unarmed.zhangxinlei" :),
       (: perform_action, "stick.lianying" :),
    }) );
    
    weapon=new("/d/obj/weapon/stick/xiangmo");
    weapon->move(me);
    command("wield all");    
}


