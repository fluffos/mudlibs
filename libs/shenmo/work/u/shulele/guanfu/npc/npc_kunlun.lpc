
#include "../npc.h"

string* name=({
    "剑圣",
    "天尊",
});

void create()
{
    int i;
    set_name("昆仑叛徒",({"pantu","pan tu"}));
    set("title", HIG+name[random(sizeof(name))]+NOR);
    set("age",20+random(80));
    set("name2",query("name"));
    set("title2",query("title"));
    set("id2",query("id"));
    set("attitude","heroism");
    set("no_drop",1);
    set("no_get",1);
    set("chat_chance", 5);
    setup();
}

void set_skills(int j, int level)
{
    object me=this_object();
    object weapon;
    int exp;

    set("family/family_name","昆仑山玉虚洞");
    me->set_skill("unarmed", j+random(5));
    me->set_skill("dodge", j+random(5));
    me->set_skill("parry", j+random(5));
    me->set_skill("force", j+random(5));
    me->set_skill("spells", j+random(5));
    me->set_skill("sword",  j+random(5));        
    me->set_skill("lingyunbu", j+random(5));
    me->set_skill("yuxu-spells", j+random(5));
    me->set_skill("xuanzong-force", j+random(5));
    me->set_skill("kaitian-zhang", j+random(5));
    me->set_skill("wugou-jian", j+random(5));

    me->map_skill("force", "xuanzong-force");       
    me->map_skill("parry", "wugou-jian");
    me->map_skill("sword", "wugou-jian");
    me->map_skill("spells", "yuxu-spells");
    me->map_skill("dodge", "lingyunbu");
    me->map_skill("unarmed", "kaitian-zhang");

    set("chat_chance_combat",level);
    set("chat_msg_combat", ({
       (: cast_spell, "light" :),
       (: perform_action, "sword.eight" :),
    }) );
    
    weapon=new("/d/obj/weapon/sword/qingfeng");
    weapon->move(me);
    command("wield all");    
}


