
#include "../npc.h"

string* name=({
    "无常",
    "鬼王",
});

void create()
{
    int i;
    set_name("地府叛徒",({"pantu","pan tu"}));
    set("title", HBRED+name[random(sizeof(name))]+NOR);
    set("age",20+random(80));
    set("name2",query("name"));
    set("title2",query("title"));
    set("id2",query("id"));

    set("attitude","heroism");
    set("chat_chance", 5);
    set("no_get",1);
    set("no_drop",1);
    setup();
}

void set_skills(int j, int level)
{
    object me=this_object();
    object weapon;
    int exp;

    set("class","youling");
    set_temp("hell_three",1);
    set("family/family_name","阎罗地府");
        
    me->set_skill("unarmed", j+random(5));
    me->set_skill("dodge", j+random(5));
    me->set_skill("parry", j+random(5));
    me->set_skill("force", j+random(5));
    me->set_skill("spells", j+random(5)); 
    me->set_skill("whip", j+random(5));
    me->set_skill("hellfire-whip", j+random(5));
    me->set_skill("ghost-steps", j+random(5));
    me->set_skill("jinghun-zhang", j+random(5));
    me->set_skill("tonsillit", j+random(5));
    me->set_skill("gouhunshu", j+random(5));

    me->map_skill("force", "tonsillit");
    me->map_skill("whip", "hellfire-whip");
    me->map_skill("parry", "hellfire-whip");
    me->map_skill("spells", "gouhunshu");
    me->map_skill("dodge", "ghost-steps");
    me->map_skill("unarmed", "jinghun-zhang");

    exp=query("combat_exp");
        
    if(exp>500000)
    {
        set("chat_chance_combat",level);
        set("chat_msg_combat", ({
           (: perform_action, "whip.three" :),
           (: cast_spell, "gouhun" :),
           (: cast_spell, "zhuang" :),           
        }) );
        if(exp<10000000)
        {
            weapon=new("/d/obj/weapon/whip/whip");
            weapon->move(me);
            command("wield all");         
        }
        else
        {
            weapon=new("/d/obj/weapon/whip/yinbian");
            weapon->move(me);
            command("wield all");
        }
    }
}


