
#include "../npc.h"

string* name=({
    "剑圣",
    "剑仙",
});

void create()
{
    int i;
    
    set_name("娥眉叛徒",({"pantu","pan tu"}));
    set("title", HIY+name[random(sizeof(name))]+NOR);
    set("age",20+random(80));
    set("name2",query("name"));
    set("title2",query("title"));
    set("id2",query("id"));

    set("no_drop",1);
    set("no_get",1);
    set("attitude","heroism");
    set("chat_chance", 5);
    setup();
}

void set_skills(int j, int level)
{
    object me=this_object();
    object weapon;
    int exp;

    set("class","xian");
    set("family/family_name","娥眉");
    set("gender", "女性");
        
    me->set_skill("unarmed", j+random(5));
    me->set_skill("dodge", j+random(5));
    me->set_skill("parry", j+random(5));
    me->set_skill("force", j+random(5));
    me->set_skill("spells", j+random(5)); 
    me->set_skill("sword", j+random(5)); 
    me->set_skill("tianji-sword",j+random(5));
    me->set_skill("qiankun-zhengqi", j+random(5));
    me->set_skill("incarnation", j+random(5));
    me->set_skill("haotian-zhang", j+random(5));
    me->set_skill("void-steps", j+random(5));       
        
    me->map_skill("sword", "tianji-sword");
    me->map_skill("parry", "tianji-sword");
    me->map_skill("spells", "incarnation");
    me->map_skill("dodge", "void-steps");
    me->map_skill("unarmed", "haotian-zhang");
    me->map_skill("force", "qiankun-zhengqi");

    exp=query("combat_exp");
    
    if(exp>1000000)
    {
        set("chat_chance_combat",level);
        set("chat_msg_combat", ({
           (: cast_spell, "jiushen" :),
           (: perform_action, "sword.changkong" :),
           (: perform_action, "unarmed.ju" :),
           (: exert_function, "zhengqi":),
        }) );

        if(exp<10000000)
        {
            weapon=new("/d/obj/weapon/sword/changjian");                 
            weapon->move(me);
            command("wield all");
        }
        else
        {
            weapon=new("/d/obj/weapon/sword/qingfeng");                
            weapon->move(me);
            command("wield all");
        }
    }
}

