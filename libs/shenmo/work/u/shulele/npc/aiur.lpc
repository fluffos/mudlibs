//write by Aiur 2017/12 修改自Jumbo二转
inherit NPC;

#include <obstacle.h>
#include <ansi.h>
#include <localtime.h>

void zhuanshi(object ob);
string check_gift();
int return_vip();
mapping gift = ([
  "str": "膂力",
  "cor": "胆识",
  "int": "悟性",
  "spi": "灵性",
  "cps": "定力",
  "per": "容貌",
  "con": "根骨",
  "kar": "福缘",
]);
string *gift_name = ({ "kar", "con", "per", "cps", "spi", "int", "cor", "str", });

void create() {
  set_name("托儿", ({ "tuoer" }));
  set("title", HIR "盘龙出沧海" NOR);
  set("long", "如果有一棒不能解决的事，那就多来几棒。\n");
  set("gender", "男性");
  set("attitude", "peaceful");
  set("str", 100);
  set("per", 100);
  set("max_kee", 100000);
  set("max_gin", 100000);
  set("max_sen", 100000);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 500);
  set("max_mana", 10000);
  set("mana", 10000);
  set("mana_factor", 500);
  set("combat_exp", 4000000);
  set("daoxing", 10000000);

  set("inquiry", ([
    "清风旗": (: return_vip :),
  ]));
  setup();
  carry_object("/d/obj/cloth/baguapao")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()
    && !this_player()->query("env/invisibility")) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}


int return_vip() {
  object me, ob;
  me = this_player();
  ob = present("qingfeng qi", me);
  if (ob) {
    write(HIY "您的清风八卦旗并未丢失，无须找回！\n" NOR);
    return 1;
  }
  if (me->query("qingfeng")) {
    new("/u/shulele/obj/flag")->move(me);
    write(HIY "这是您的清风旗，请收好。\n" NOR);
    return 1;
  }
  write(HIY "对不起，没有查询到您购买清风旗的记录。\n" NOR);
  return 1;
}
