
inherit NPC;
inherit F_MASTER;
string ask_renwu()
;string ask_wuxue();

void create()
{
  set_name("辞官使者", ({ "ciguan shizhe", "ciguan", "shizhe" }));
  set("gender", "shen");
  set("age", 43);
  set("str", 30);
  set("per", 26);
  set("int", 30);
  set("cor", 50);
  set("cps", 50);
  set("long", "负责辞官的使者ask辞官，官职点清零其余不扣，ask武学，道行和武学归1000W官职点清零。\n");
  set("combat_exp", 1200000);
    set("max_sen", 2800);
  set("max_kee", 4400);
  set("force", 2000);
  set("max_force", 1800);
  set("force_factor", 80);
  set("inquiry", ([
                   
                  "辞官": (: ask_renwu :),
				  "武学": (: ask_wuxue :),
                   ]) );

  create_family("人族", 3, "紫");
  set("chat_chance_combat", 60);
  
  set("class", "shen");

  setup();
  
  carry_object("/d/obj/armor/tiejia")->wear();
 
}

int ask_renwu()
{
  object who=this_player();
if ((int)who->query("renwuka") < 50 ) 
         { 
         command("say 你你任务点少于50次！");   
         return 1; 
         } 
if( who->query("office_number") < 12000 )
        {
        command("? "+who->query("id"));
        command("say 你的官职小于12000无法辞官？");
        command("say 给个理由先！");
        return 1;
        }
command("chat "+who->nawho()+"在职期间，清正廉明，爱民如子，颐养天年！"); 
        who->set("office_number",0);
        who->add("c_balance",-100000);
		 who->add("renwuka",-10);
		
        return 1;
}

int ask_wuxue()
{
  object who=this_player();
if ((int)who->query("renwuka") < 80 ) 
         { 
         command("say 你任务点少于80点！");   
         return 1; 
         } 
if( who->query("office_number") < 12000 )
        {
        command("? "+who->query("id"));
        command("say 你的官职小于2000无法减武学和道行？");
        command("say 给个理由先！");
        return 1;
        }
command("chat "+who->nawho()+"在职期间，清正廉明，爱民如子，颐养天年！"); 
        who->set("level",1000); 
	    who->set("combat_exp",10000000); 
        who->set("daoxing",10000000); 
        who->add("c_balance",-100000);
		who->set("office_number",0);
		 who->add("renwuka",-30);
		
        return 1;
}

