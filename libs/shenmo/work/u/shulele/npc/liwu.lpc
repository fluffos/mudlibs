#include <ansi.h>
inherit NPC;

string gift();

void create() {
  set_name("小男人", ({ "li wu", "lele", "xiao" }));
  set("long", HIC "为了庆祝51节，特此发放。\n" NOR);
  set("gender", "男性");
  set("nickname", HIY "发礼物的" NOR);
  set("title", HIC "5" HIY "1" HIG "节" NOR);
  set("age", 20);
  set("per", 40);
  set("inquiry", ([
    "礼物": ( : gift: ),
  ]));
  setup();
}

string gift() {
  string ip;
  object gold, me = this_player();
  if (me->query("201551节"))
    return "哼！你不是要过了吗？";
  me->set("201551节", 1);
  if (me->query("mud_age") < 10000) {
    me->add("combat_exp", 10000);
    me->add("daoxing", 10000);
    me->add("potential", 10000);
    return "你增加了十万点的武学和潜能，以及100年的道行。";
  }
  me->add("combat_exp", 300000);
  me->add("daoxing", 1000000);
  me->add("potential", 300000);

  ip = query_ip_number(me);
  if (time() - me->query_temp("login_time") > 600) {
    mapping skills = me->query_skills();
    string skill, *sk = keys(skills);
    int i = sizeof(sk);
    message_vision(HIY "\n$N因为在线时间过长，得到了追加奖励！\n\n" NOR, me);
    if (!query(ip)) {
      gold = new("/obj/money/jinbi");
      if (gold->move(me)) {
        message_vision(HIY "$N得到了一枚金币！\n\n" NOR, me);
        set(ip, 1);
      }
    }
    while (i--) {
      if (stringp(skill = sk[i])) {
        me->improve_skill(skill, random(50000) + 1, 1);
        message_vision(YEL "$N的" WHT + to_chinese(skill) + YEL "熟练度增加了！\n" NOR, me);
      }
    }
  }
  return "你增加了三十万点的武学和潜能，以及一百年的道行。";
}
