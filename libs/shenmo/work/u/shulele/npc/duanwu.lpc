inherit NPC;
#include <ansi.h>
int give_gift();
void create() {
  set_name(HIC "我叫粽子" NOR, ({ "zongzi", "duanwu", "zong" }));
  set("age", 18 + random(10));
  set("gender", "男性");
  set("title", HIR "端午礼物大使" NOR);
  set("long", HIM "\n\n这位就是由巫师大人玩了wow后回家深夜赶着写出来的礼物使者。\n" NOR);
  set("attitude", "peaceful");
  set("str", 50);
  set("kar", 50);
  set("per", 99);
  set("combat_exp", 200000000);
  set("daoxing", 200000000);
  set("max_force", 200000);
  set("max_mana", 200000);
  set("max_kee", 40000);
  set("max_sen", 40000);
  set("force", 400000);
  set("force_factor", 1000);
  set("mana_factor", 1000);
  set("mana", 400000);
  set_skill("unarmed", 1000);
  set_skill("dodge", 1000);
  set_skill("parry", 1000);
  set("inquiry", ([
    "gift": (: give_gift :),
    "礼物": (: give_gift :),
    "端午节": (: give_gift :),
  ]));
  setup();
}
int give_gift() {
  object me;
  string str;
  object yx = new("/u/cloud/obj/zongzi");
  int exp, wxreward, dxreward;
  me = this_player();
  exp = me->query("combat_exp") + me->query("daoxing");
  if (!me) return 0;
  if (me->query("huarong/端午节") == "2015.") {
    message_vision("\n粽子疑惑的看着你道：你不是又想来混一份礼物吧？\n\n" NOR, me);
    this_object()->command("hammer " + me->query("id"));
    return 1;
  }
  if (me->query("combat_exp") <= 100000) {
    write("你的修行太低了，还是先去锻炼一下再来吧!\n");
    return 1;
  }
  me->set("huarong/端午节", "2017");
  wxreward = me->query("combat_exp") / 50 > 250000 ? 250000 : me->query("combat_exp") / 50;
  dxreward = me->query("daoxing") / 50 > 250000 ? 250000 : me->query("daoxing") / 50;
  message_vision("\n东方朔拱手贺道：\n"
    +HIY + "元宵争看采莲船，\n" + HIR + "宝马香车拾坠钿，\n" + HIB + "风雨夜深人散尽，\n" + HIM + "孤灯犹唤卖粽子。\n" + HIW + "端午节快乐！\n" NOR, me);
  write(HIY "在2015年端午佳节到来之际，你得到神魔传说巫师组的端午祝福。\n" NOR);
  str = HIW + me->name() + HIM + "得到了端午礼物，送上我们的祝福：" + HIY + "端午佳节快乐，一家同吃粽子！" NOR;
  message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());
  me->add("combat_exp", wxreward);
  me->add("daoxing", dxreward);
  me->add("potential", 5000);
  tell_object(me, HIR "你得到道行、武学、潜能奖励，同时恭喜你得到额外奖励!\n" NOR);
  yx->move(me);
  return 1;
}
