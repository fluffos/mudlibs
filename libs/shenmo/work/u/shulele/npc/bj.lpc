inherit NPC;
inherit F_MASTER;
string ask_renwu();

void create() {
  set_name("兵解使者", ({ "bingjie shizhe", "bingjie", "shizhe" }));
  set("gender", "shen");
  set("age", 43);
  set("str", 30);
  set("per", 26);
  set("int", 30);
  set("cor", 50);
  set("cps", 50);
  set("long", "负责辞官的使者。\n");
  set("combat_exp", 1200000);
  set("max_sen", 2800);
  set("max_kee", 4400);
  set("force", 2000);
  set("max_force", 1800);
  set("force_factor", 80);
  set("inquiry", ([

    "兵解": (: ask_renwu :),
  ]));

  create_family("人族", 3, "紫");
  set("chat_chance_combat", 60);

  set("class", "shen");

  setup();

  carry_object("/d/obj/armor/tiejia")->wear();

}

int ask_renwu() {
  object me = this_player();

  if ((int)me->query("zhuanshi") < 3) {
    command("say 你还没四转！");
    return 1;
  }
  if ((int)me->query("level") < 1500) {
    command("say 你的等级不足，还是过些时间再来吧！");
    return 1;
  }
  if ((int)me->query("combat_exp") < 2000000000) {
    command("say 你的武学不足，还是过些时间再来吧！");
    return 1;
  }
  if ((int)me->query("daoxing") < 2000000000) {
    command("say 你的道行不足，还是过些时间再来吧！");
    return 1;
  }
  if ((int)me->query("shen") < 100000) {
    command("say 你现在元神低于10万，进了油锅恐怕就难出来了！");
    return 1;
  }
  if ((int)me->query("rsg_eaten") < 52) {
    command("say 你去多吃些人参果吧，在油锅煎熬的时候能少受些罪！");
    return 1;
  }
  if ((int)me->query_skill("force", 1) < 1500) {
    command("say 你的内功心法修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)me->query_skill("spells", 1) < 1500) {
    command("say 你的基本法术修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)me->query_skill("dodge", 1) < 1500) {
    command("say 你的基本轻功修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)me->query_skill("unarmed", 1) < 1500) {
    command("say 你的扑击格斗之技修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)me->query_skill("parry", 1) < 1500) {
    command("say 你的拆招卸力之法修为不够，还是过些时间再来吧！");
    return 1;
  }
  if ((int)me->query_skill("literate", 1) < 1500) {
    command("say 你的读书识字水平太差，还是过些时间再来吧！");
    return 1;
  }
  if (!me->query("obstacle/reward")) {
    command("say 你先去西域求取真经吧！");
    return 1;
  }
  if (me->query("dntg/laojunlu") != "done") {
    command("say 无名鼠辈，休得烦我！");
    return 1;
  }
  command("chat " + me->name() + "兵解成功.无名，万物之始，有名，万物之母,故常无欲，以观其妙，常有欲，以观其徼！");

  me->add("max_kee", -2200);
  me->add("kee", -2200);
  me->add("level", -1200);
  me->add("eff_kee", -200);
  me->add("max_sen", -250);
  me->add("sen", -250);
  me->add("eff_sen", -250);
  me->add("maximum_force", 0);
  me->add("max_force", 0);
  me->add("force", 0);
  me->add("force_factor", 0);
  me->add("maximum_mana", 0);
  me->add("max_mana", 0);
  me->add("mana", 0);
  me->add("c_balance", -9000000);
  me->add("mana_factor", 0);
  me->add("combat_exp", -2000000000);
  me->add("daoxing", -2000000000);
  me->add("office_number", -12000);
  me->delete("degree");
  me->add("bellicosity", 0);
  me->add("haomao", 3);
  return 1;
}
