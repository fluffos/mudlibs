         who->set_skill("changshengjue",100);  
         message("channel:rumor",HIB+"\n【"+HIR" 六道轮回 "NOR+HIB"】某人："+who->query("name")+"得到了转世神功----"+HIW"长生诀"NOR+HIB"！\n"+NOR,users() );  
         }   
 else if (m==2)  
         { 
