         message("channel:rumor",HIB+"\n【"+HIR" 六道轮回 "NOR+HIB"】某人："+who->query("name")+"得到了转世神功----"+HIW"凌波微步"NOR+HIB"！\n"+NOR,users() );  
         }   
  
 m=random(3);  
 if (m==1)  
         { 
