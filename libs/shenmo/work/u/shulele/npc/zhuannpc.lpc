#include <ansi.h>
inherit NPC;
#include <localtime.h>
inherit F_MASTER;
#include "zhuanshi1.lpc"


void create()
{
        set_name(HIW"投胎重修菩萨"NOR, ({"toutai pusa","pusa"}));
        set("gender", "女性" );
        set("age", 25);
        set("title",HIY"眼望世间虚缈，空、无、灭"NOR);
        set("long", HIG"\n\n佛祖如来身边掌管投胎重修的大智、无我菩萨\n\n"NOR);
        set("combat_exp", 1000000000);
          set("daoxing", 5000);

        set("attitude", "peaceful");
        set("per", 40);
        set("max_kee", 20000);
        set("max_gin", 20000);
        set("max_sen", 20000);
        set("inquiry", ([
                "toutai" : (: ask_toutai() :),
                "投胎" : (: ask_toutai() :),
                ]) );
        setup();
        carry_object("/d/ourhome/obj/pink_cloth")->wear();
        carry_object("/d/ourhome/obj/shoes")->wear();
}

 int samsara_num()
 {
         object who=this_player();  
         if ((int)who->query("toutai"))  
         {   
         command("say 你确定你要投胎嘛！");   
         return 1;  
         }   
  
 if ((int)who->query("level") < 1250 )  
         {   
         command("say 你的等级不足，还是过些时间再来吧！");  
         return 1;  
         }   
 if ((int)who->query("combat_exp") < 1000000000 ) 
         {   
         command("say 你的武学不足，还是过些时间再来吧！");   
         return 1;  
         }   
 if ((int)who->query("daoxing") < 1000000000 )  
         {   
         command("say 你的道行不足，还是过些时间再来吧！");  
         return 1;  
         }   
 if ((int)who->query("shen") < 700 )  
         {   
         command("say 你现在元神太低，进了油锅恐怕就难出来了！");  
         return 1;  
         }   
 if ((int)who->query("rsg_eaten") < 52 ) 
         { 
         command("say 你去多吃些人参果吧，在油锅煎熬的时候能少受些罪！");   
         return 1; 
         } 

 if ((int)who->query_skill("force", 1) < 1250 )   
         {   
         command("say 你的内功心法修为不够，还是过些时间再来吧！");   
         return 1;  
         }   
 if ((int)who->query_skill("spells", 1) < 1250 )   
         {   
         command("say 你的基本法术修为不够，还是过些时间再来吧！");  
         return 1;  
         }   
 if ((int)who->query_skill("dodge", 1) < 1250 )   
         {   
         command("say 你的基本轻功修为不够，还是过些时间再来吧！");   
         return 1;  
         }   
 if ((int)who->query_skill("unarmed", 1) < 1250 )   
         {   
         command("say 你的扑击格斗之技修为不够，还是过些时间再来吧！");   
         return 1;  
         }   
 if ((int)who->query_skill("parry", 1) < 1250 )   
         {   
         command("say 你的拆招卸力之法修为不够，还是过些时间再来吧！");  
         return 1;  
         }   
 if ((int)who->query_skill("literate", 1) < 1250 )  
         {   
         command("say 你的读书识字水平太差，还是过些时间再来吧！");   
         return 1;  
         }   
 if (!who->query("obstacle/reward"))    
         {   
         command("say 你先去西域求取真经吧！");   
         return 1;  
         }   
 if (who->query("dntg/laojunlu")!="done")  
         {   
         command("say 无名鼠辈，休得烦我！");   
         return 1;  
         }   
 if ( !random(3) )  
         {  
         who->set("shen", 350); 
         command("over "+who->query("id"));  
         message("channel:rumor",HIB+"\n【"+HIR" 六道轮回 "NOR+HIB"】某人："+who->query("name")+"投胎失败了！\n"+NOR,users() );  
         return 1; 
         }  
 return 0;
 }

