 message("channel:rumor",HIB+"\n【"+HIR" 六道轮回 "NOR+HIB"】某人："+who->query("name")+"投胎成功了！\n"+NOR,users() );  
 message("channel:rumor",HIB+"\n【"+HIR" 六道轮回 "NOR+HIB"】某人："+who->query("name")+"的先天灵性提升了十五点！\n"+NOR,users() ); 
  
 j=random(3);  
 if (j==1) 
         { 
         who->set("dzxy_ask",1);  
         who->set("dzxy_agree",2);  
         who->set_skill("douzhuan-xingyi",100);   
         message("channel:rumor",HIB+"\n【"+HIR" 六道轮回 "NOR+HIB"】某人："+who->query("name")+"得到了转世神功----"+HIW"斗转星移"NOR+HIB"！\n"+NOR,users() );  
         }   
 else if (j==2)  
         { 
         who->set("yumo_ask",1);   
         who->set("yumo_agree",2);   
         who->set_skill("jadesword",100);  
         message("channel:rumor",HIB+"\n【"+HIR" 六道轮回 "NOR+HIB"】某人："+who->query("name")+"得到了转世神功----"+HIW"玉魔剑法"NOR+HIB"！\n"+NOR,users() );  
         }   
 else    { 
