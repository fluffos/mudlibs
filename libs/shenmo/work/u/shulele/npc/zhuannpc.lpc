         message("channel:rumor",HIB+"\n【"+HIR" 六道轮回 "NOR+HIB"】某人："+who->query("name")+"得到了转世神功----"+HIW"六脉神剑"NOR+HIB"！\n"+NOR,users() );  
         }  
          

                command("say 你现在极限无量！\n");
                command("chat "HIG"所有一切众生类摄。若卵生若胎生若湿生若化生。若有色若无色。若有想若无想。若非有想若非无想。乃至众生界及假名说。\n");
                command("chat "HIR"不应生住法心。不应生住非法心。不应生有所住心。何以故。若心有住则为非住故。\n");
                command("chat "HIC"轮回转世空空荡去，世间万物终有一度，"HIR""+who->query("name")+""HIC"破红尘之身，化世俗凡念，心归我佛，投胎重修了。\n"); 
                who->move("/d/city/kezhan");
 who->save(); 
 return 1;  
 } 




