
inherit NPC;
inherit F_MASTER;
string ask_renwu();

void create()
{
  set_name("任务使者", ({ "renwu shizhe", "renwu", "shizhe" }));
  set("gender", "shen");
  set("age", 43);
  set("str", 30);
  set("per", 26);
  set("int", 30);
  set("cor", 50);
  set("cps", 50);
  set("long", "负责发放任务的使者。\n");
  set("combat_exp", 1200000);
    set("max_sen", 2800);
  set("max_kee", 4400);
  set("force", 2000);
  set("max_force", 1800);
  set("force_factor", 80);
  set("inquiry", ([
                   
                  "任务": (: ask_renwu :),
                   ]) );

  create_family("人族", 3, "紫");
  set("chat_chance_combat", 60);
  
  set("class", "shen");

  setup();
  
  carry_object("/d/obj/armor/tiejia")->wear();
 
}

int ask_renwu()
{
  object me=this_player();
  if ((int)me->query("renwuka") < 1 ) 
                         { 
                         command("say 你没有次数了！");   
                         return 1; 
                         } 

 message_vision("你发动了任务卡,你飞了起来。\n",me);
        message_vision("你飞啊飞,飞了很长时间终于飞到了任务空间......\n", me);
		me->add("renwuka",-1);
        me->move ("d/xingji/kongjian");
        return 1;

  
}


