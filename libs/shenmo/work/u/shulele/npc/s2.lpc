inherit NPC;
inherit F_MASTER;
string ask_renwu();

void create() {
  set_name("辞官使者", ({ "ciguan shizhe", "ciguan", "shizhe" }));
  set("gender", "shen");
  set("age", 43);
  set("str", 30);
  set("per", 26);
  set("int", 30);
  set("cor", 50);
  set("cps", 50);
  set("long", "负责辞官的使者。\n");
  set("combat_exp", 1200000);
  set("max_sen", 2800);
  set("max_kee", 4400);
  set("force", 2000);
  set("max_force", 1800);
  set("force_factor", 80);
  set("inquiry", ([

    "辞官": (: ask_renwu :),
  ]));

  create_family("人族", 3, "紫");
  set("chat_chance_combat", 60);

  set("class", "shen");

  setup();

  carry_object("/d/obj/armor/tiejia")->wear();

}

int ask_renwu() {
  object me = this_player();
  if (!present("water light cloak", me))
    return notify_fail("你身上没有水瑟天光。\n");
  command("chat " + me->name() + "在职期间，清正廉明，爱民如子，吾皇赐以重赏，颐养天年！");
  me->add("office_number", 0);
  me->add("kee", -100);
  me->set("title", "普通百姓");
  return 1;


}
