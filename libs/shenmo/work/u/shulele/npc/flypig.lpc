
inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_for_leave();

void create()
{
    set_name(HIG"飞天猪"NOR, ({ "fly pig", "pig" }));
    set("gender", "男性");
    set("long", "一只可爱的小猪。\n");
    set("attitude", "peaceful");
    set("title", HIR"天蓬府牙将"NOR);
    set("class","shen");
    
    set("combat_exp", 1000000);

    set("max_kee", 2000);
    set("max_sen", 2000);
    set("max_force", 2000);
    set("max_mana", 2000);
    set("force", 2000);
    set("mana", 2000);
    set("force_factor", 60);
    set("mana_factor", 60);
 
    set_skill("unarmed", 80);
    set_skill("dodge", 80);
    set_skill("parry", 80);
    set_skill("force", 80);
    set_skill("spells", 80);
    set_skill("rake", 80);
    set_skill("xuantian-xinfa", 80);
    set_skill("skyriver-rake", 80);
    set_skill("guiyuanshentong", 80);
    set_skill("hunyuan-zhang", 80);
    set_skill("meng-steps", 80);    
    map_skill("force", "xuantian-xinfa");
    map_skill("unarmed", "hunyuan-zhang");
    map_skill("spells", "guiyuanshentong");
    map_skill("parry", "skyriver-rake");
    map_skill("rake", "skyriver-rake");
    map_skill("dodge", "meng-steps");
    
    create_family("天蓬府", 3, "弟子");
  
    set("inquiry", ([
        "出圈" : (: ask_for_leave :),
    ]) );

    setup();
    carry_object("/d/obj/weapon/rake/gangpa")->wield();
    carry_object("/d/obj/armor/jinjia")->wear();
}

void attempt_apprentice(object ob)
{
    ob = this_player();
    
if ((int)ob->query("zhuanshi") == 4 )    
         {   
         command("say 只有4转之人可以拜我！");  
         return;  
         }  
        command("say 既然你这么有诚意那就收下你把！");

	command("recruit " + ob->query("id") );
        ob->set("title", "天蓬府 猪兵");
        ob->set("class", "tianpeng");
        return;
    }

void init()
{
    add_action("do_agree", "agree");
}

string ask_for_leave()
{
    object me=this_player();

    if( (string)me->query("family/family_name") == "天蓬府" ) 
    {
        command("say 你既是执意离开，我却有几句话说。");
        me->set_temp("betray", 1);
	return ("脱离师门要需要有一定惩罚，你可愿意(agree)？");
    }
    return ("不知道。\n");
}

int do_agree(string arg)
{
    if( this_player()->query_temp("betray") ) 
    {
	message_vision("$N答道：弟子愿意。\n\n", this_player());
	command("say 既是你与天蓬府无缘，你便离开吧！");
	this_player()->add("betray/count", 1);
	this_player()->add("betray/tpf", 1);
        this_player()->set("combat_exp", this_player()->query("combat_exp")/100*95);
        this_player()->set("faith", 0);
        if( this_player()->query_skill("skyriver-rake") ) this_player()->delete_skill("skyriver-rake");
	if( this_player()->query_skill("watersplit-dart") ) this_player()->delete_skill("watersplit-dart");
		
	this_player()->delete("family");
	this_player()->delete("class");
	this_player()->set("title", "普通百姓");
	this_player()->set_temp("betray", 0);
	this_player()->save();
	command("say 人怕出名猪怕壮，妖神险恶，好自为之。。。\n");
	return 1;
    }
}
