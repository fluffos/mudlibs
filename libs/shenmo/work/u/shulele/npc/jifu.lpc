inherit NPC;
inherit F_MASTER;
int give_class();
#include <ansi.h>
void create()
{
        set_name(HIM"萧秋水"NOR, ({ "xiao qiushui", "xiao","qiushui", "shui",}) );
        set("gender", "男性" );
        set("age", 21);
        set("agi",30);
        set("str", 60);
        set("per", 29);
        set("class","human");
        set("nickname", HIG"浣花剑派"HIY"少掌门"NOR);
        set("int",30);
        set("attitude","friendly");
        set("max_force", 2100);
        set("force", 3000);
        set("force_factor", 80);
        set("max_mana", 2300);
        set("mana", 3000);
	 set("max_kee",1000);
        set("max_gin",1000);
        set("max_sen",1000);
        set("chat_chance", 30);
        set("long",
"这位就是萧东广的儿子，也是浣花剑派的传人\n"
        );
        create_family("浣花剑派",2,"浣花剑法传人");
        set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
                (: perform_action, "sword", "huanhua" :),
        }) );

        set("combat_exp", 630000);
        set("daoxing", 1230000);
       set_skill("literate", 80);
       set_skill("unarmed", 100);
       set_skill("dodge", 100);
       set_skill("force", 120);
       set_skill("parry", 115);
       set_skill("sword", 105);
       set_skill("spells", 120);
       set_skill("blade", 125);
       set_skill("huanhua-jianfa", 255);
        set_skill("chunchan-zhang", 455);
      
       map_skill("unarmed", "huanhua-jianfa");
       map_skill("unarmed", "chunchan-zhang");
       map_skill("force", "cloudforce");
       map_skill("sword", "huanhua-jianfa");
       map_skill("parry", "huanhua-jianfa");
       map_skill("dodge", "shadowsteps");
       set("inquiry", ([
            "浣花剑派"    :(:give_class:),
          
           
]));
        setup();
    //    carry_object(__DIR__"obj/deitysword")->wield();
   //     carry_object(__DIR__"obj/sjcloth")->wear();
}

void attempt_apprentice(object ob)
{
   if( (string)ob->query("family/family_name")=="浣花剑派" )
     {
       if( (int)ob->query("family/generation") < 3  )
          command("say 不敢，不敢。我该拜" + RANK_D->query_respect(ob) + "您为师才是。\n");
       else if( (int)ob->query("family/generation") ==3  )
	  command("say 你这个" + RANK_D->query_rude(ob) + "还是别来消遣你姑奶奶了！\n");
      else 
         {
	  command(":D");
	  command("say 好！" + RANK_D->query_respect(ob) + "投入我门下保你学到上乘剑法！\n");
	  command("haha");
	  command("recruit " + ob->query("id") );
    //     ob->set("title", HIR"浣花剑派"NOR);
         ob->set("class", "human");
	 }
     }

    else
      {
       command(":D ");
       command("say 好，"+ RANK_D->query_respect(ob) +"，你到我浣花剑派，必有出人头地的一天！\n");
       command("recruit " + ob->query("id") );
			message("system", HIB"我浣花剑派又多了一个弟子  "HIR+this_player()->name()+HIW"
                 浣花剑派"HIY"的势力加强了。\n"NOR,users());
   //    ob->set("title", HIR"浣花剑派"NOR);
       ob->set("class", "human");
      }

  return;
}
int give_class()
{
        object who=this_player();
      
         if (who->query("family/family_name") == "浣花剑派" ){
             who->move("/d/huanhua/sjsz.lpc");
                return 1;
         }
else
{

  command("say 你不是我剑派的人吧？");
}                 
                 return 1;
}



