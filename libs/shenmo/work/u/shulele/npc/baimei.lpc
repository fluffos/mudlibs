#include <ansi.h>
inherit NPC;
int ask_job();
int cancel_me();
int report_zhengqi();
string ask_book();
void create() {
  set_name(HIW "白眉道人" NOR, ({ "baimei daoren", "daoren", "baimei" }));
  set("gender", "男性");
  set("long", "峨眉山首徒\n");
  set("age", 50);
  set("title", HIR "峨眉山开山祖师" NOR);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 30);
  set("max_kee", 4100);
  set("kee", 4100);
  set("max_sen", 3100);
  set("sen", 3100);
  set("combat_exp", 25000000);
  set("daoxing", 75000000);
  set("force", 10000);
  set("mana", 10000);
  set("max_force", 6000);
  set("max_mana", 6000);
  set("force_factor", 300);
  set("mana_factor", 200);
  set("eff_dx", 4500000);
  set("nkgain", 1500);

  set_skill("blade", 400);
  //  set_skill("tianlongzhan", 480);

  map_skill("blade", "tianlongzhan");
  set("inquiry", ([
    "name": "老夫乃峨眉山开山祖师。",
    "天地正气": (: report_zhengqi: ),
    "book" : (: ask_book :),
    ])
  );
setup();
carry_object("/d/obj/armor/jinjia")->wear();
}


int ask_job()

{

  object ghost, me;

  int t;

  me = this_player();



  if (!userp(me))
    return 0;
  if (!me->query("jienan")) {

    call_out("start_job", 1, me);

    return 1;

  }

  if ((int)me->query("jienan/start") < time()) {
    write("你先下去休息吧!\n");
    return 1;
  }
  if ((t = (int)me->query("jienan/start")) && (!(int)me->query("jienan/done")))

  {

    if (t <= time() && time() < t + 3600)

    {

      command("ah");

      command("say 这么快就回来了?\n");

      return 1;

    }

  }

  me->delete("jienan/start");

  call_out("start_job", 1, me);

  return 1;

}

int start_job(object me)

{
  string where;

  object ghost;

  int dx;

  if (environment(me) != environment()) return 1;

  dx = (me->query("daoxing") + me->query("combat_exp")) / 2;

  if (wizardp(me))
    tell_object(me, "ok!\n");

  /*	if( dx>10000000  )
	{
	       tell_object(me,"你现在不适合这项任务。\n");
                return 1;
	}              //  alading 添加 01.11
*/
  if (me->query("jienan/start")) return 1;

  me->set("jienan/done", 0);

  ghost = new(__DIR__ "lg-yao");

  where = ghost->invocation(me, 7);



  message_vision("$N说道：" + HIW "三界劫难又起！\n" NOR, this_object());

  message_vision("$N对$n说道：" + HIR "" + where + "" NOR + "出现，"

    + "快去探察！\n"

    , this_object(), me);

  me->set("jienan/start", time());

  return 1;

}

int cancel_me()

{

  object me = this_player();

  int exp, exp_reward;

  exp = (me->query("combat_exp") + me->query("daoxing")) / 2;

  if (exp < 3000)
    return notify_fail("你的武学不够了!\n");
  if (exp < 30000) {

    exp_reward = 500 + exp / 60;

  } else if (exp < 1000000) {

    exp_reward = 1000 + exp / 600;

  } else if (exp < 5000000) {

    exp_reward = 2000 + exp / 6000;

  } else {

    exp_reward = 3000;   // append by alading

  }

  exp_reward = exp_reward * 1.5;

  if (!me->query("jienan/start") ||

    me->query("jienan/done"))



  {

    command("qi");

    command("say 你有劫难？\n");

    return 1;

  }



  if (me->query("sjn_cancel") < time()) {
    write("你再去找找？\n");
    return 1;
  }
  if ((int)me->query("jienan/start") < time()) {
    write("你刚要过任务，还是再去找找吧！\n");  //append by bugbug.
    return 1;
  }
  command("shrug");

  command("chat $n十劫难失败，接受惩罚，重头开始。\n");

  // me->set("sjn_cancel",time());
  me->add("combat_exp", -exp_reward);

  tell_object(me, "你被扣掉了 " + HIY "" + chinese_number(exp_reward)

    + "" NOR + " 点武学经验！\n");

  me->set("jienan/done", 1);

  me->set_temp("jienan/num", 1);

  me->set("jienan/start", 1);
  return 1;

}

int recognize_apprentice(object me) {

  return 1;
}

int report_zhengqi() {
  tell_object(
    this_player(),
    sprintf("白眉道人告诉你：好像是%d。\n", this_player()->query("tianlongzhan/zhengqi_point"))
  );
  return 1;
}
string ask_book() {
  object me = this_player();
  object book;
  if (me->query("tianlongzhan/zhengqi_point") < 1000)

    book = new("/u/shulele/sc/shenmo");
  if (!book->move(me)) {
    destruct(book);
    return "你身上的物品太多了!\n";
  }
  me->add("tianlongzhan/zhengqi_point", -1000);

  me->save();
  log_file(
    "blackmarket",
    sprintf(
      "[%s] 名字:%s(%s)购买得%s书。\n",
      ctime(time()),
      me->query("name"),
      me->query("id"),
      book->query("name")
    )
  );
  return "恭喜你获得" + book->query("name") + "!\n";
  return 1;
}
