private void confirm_samsara(string arg, object ob) {
  mapping skill_status;
  int cnt;
  string *skills;
  string str;
  if (arg == "") {
    write("你确定要进行转世了吗(y/n)？");
    input_to("keep_skill", ob);
    return;
  }
  if ((arg[0] != 'y' && arg[0] != 'Y')) {
    write("好吧，欢迎下次再来进行转世。\n");
    ob->delete_temp("choose_class");
    ob->delete_temp("choose_gender");
    ob->delete_temp("keepskill");
    ob->delete_temp("keep_num");
    message("chat", HIY + "【轮回转世】:" + NOR + BLU + ob->query("name") + "取消轮回转世!\n" NOR, users());
    return;
  }
  write(HIY "\n转世过程最后一步：" NOR + HIW "[轮回转世]\n" NOR);
  if (ob->query_temp("modify_zhuanshi") < 1) {
    ob->set("modify_class/" + ob->query("class"), 1);
    ob->set("class", ob->query_temp("choose_class"));
    ob->set("classxt", ob->query_temp("choose_class"));
    ob->set("gender", ob->query_temp("choose_gender"));
    str = "轮回转世后";
  } else {
    str = "调整转世过程";
    ob->set("modify_class/" + ob->query_temp("choose_class"), 1);
  }

  /* skill_status = ob->query_temp("keepskill");
          if( mapp(skill_status) && sizeof(skill_status) )
          {
                  skills  = keys(skill_status);
                  for( cnt = 0; cnt < sizeof(skills);cnt++)
                  {
                          ob->set("samsara/"+skills[cnt],1);
                          ob->set_skill(skills[cnt],100);
                  }
          }*/
  log_file("static/samsara",
    sprintf("%s(%s) samsara:( %s ) 时间 %s\n",
      ob->name(1), geteuid(ob), ob->query_temp("choose_class"), ctime(time())));
  message(
    "chat",
    HIY + "\n【轮回转世】:" + NOR + BLU + ob->query("name") + str + "的种族:" NOR + HIR + ob->query_temp("choose_class") + NOR,
    users()
  );
  message(
    "chat",
    HIY + "\n【轮回转世】:" + NOR + BLU + ob->query("name") + str + "的性别:" NOR + HIR + ob->query_temp("choose_gender") + NOR,
    users()
  );
  /*  for( cnt = 0; cnt < sizeof(skills);cnt++)
              message("chat",HIY+"\n【轮回转世】:"+NOR+BLU+ob->query("name")+str+"保留的第"+chinese_number((cnt+1))+"项功夫："NOR+HIR+skills[cnt]+NOR,users()); */
  message(
    "rumor",
    HIM + "\n【轮回转世】:" + NOR + BLU + ob->query("name") + str + "的种族:" NOR + HIR + ob->query_temp("choose_class") + NOR,
    users()
  );
  message(
    "rumor",
    HIM + "\n【轮回转世】:" + NOR + BLU + ob->query("name") + str + "的性别:" NOR + HIR + ob->query_temp("choose_gender") + NOR,
    users()
  );
  /*   for( cnt = 0; cnt < sizeof(skills);cnt++)
           message("rumor",HIM+"\n【轮回转世】:"+NOR+BLU+ob->query("name")+str+"保留的第"+chinese_number((cnt+1))+"项功夫："NOR+HIR+skills[cnt]+NOR,users());  */

  write("\n");
  ob->delete_temp("zhuanshi_count");
  ob->delete_temp("choose_class");
  ob->delete_temp("choose_gender");
  ob->delete_temp("keepskill");
  ob->delete_temp("keep_num");
  ob->delete("secmieyao_mudage");
  ob->save();
  //功夫部分
  if (ob->query_temp("modify_zhuanshi") < 1)  //修正转世的调整功能
  {
    skill_status = ob->query_skills();
    if (mapp(skill_status)) {
      skills = keys(skill_status);
      for (cnt = 0; cnt < sizeof(skills); cnt++)
        ob->delete_skill(skills[cnt]);
    }
    ob->set_skill("force", 100);
    ob->set_skill("spells", 100);
    ob->set_skill("unarmed", 100);
    ob->set_skill("dodge", 100);
    ob->set_skill("parry", 100);
    ob->set_skill("literate", 100);
  }
  skill_status = ob->query("samsara");
  if (mapp(skill_status) && sizeof(skill_status)) {
    skills = keys(skill_status);
    //将转世的功夫变成100level
    for (cnt = 0; cnt < sizeof(skills); cnt++)
      ob->set_skill(skills[cnt], 100);
  }
  ob->delete("death");
  give_zhuanshi();

}
