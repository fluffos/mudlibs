private int ask_zhuanshi() {


  object ob = this_player();

  if (!wizardp(ob) && samsara_num()) {
    command("say 假以时日，汝必成王，不要灰心，继续努力！");
    return 1;
  }
  //这里要加上转世的判断

  write("西游记--神魔传说提醒您：你要进行转世。\n");
  write("请您做出选择：" HIG "①开始(Begin)" HIR " ②结束(Cancel)" NOR);
  //使用过的转世变量
  //zhuanshi_count;
  //choose_class
  //choose_gender
  //keep_num
  //keepskill
  //modify_zhuanshi 标示修正转世的过程
  ob->delete_temp("samsara_cancel", 0);
  ob->delete_temp("zhuanshi_count");
  ob->delete_temp("choose_class");
  ob->delete_temp("choose_gender");
  ob->delete_temp("keepskill");
  ob->delete_temp("keep_num");
  input_to((: if_work :), ob);
  command("say 又是一个重返正途的好孩子");
  return 1;

}

private void if_work(string arg, object ob) {
  int id_count;

  id_count = ob->query_temp("zhuanshi_count");
  id_count++;
  ob->set_temp("zhuanshi_count", id_count);
  if (id_count > 3) {
    ob->delete_temp("zhuanshi_count");
    write("超出选择次数，请重新进行");
    return;
  }

  if (arg == "\1" || arg == "") {
    write(HIG "①开始(Begin)" HIR " ②结束(Cancel)" NOR);
    input_to((: if_work :), ob);
    ob->delete_temp("zhuanshi_count");
    return;
  }

  if (arg[0..0] == "2" || arg[0..0] == "2") {
    write("\n你终止转世过程，再见。\n");
    return;
  }

  if (arg[0..0] != "1" && arg[0..0] != "1") {
    write(HIG "①开始(Begin)" HIR " ②结束(Cancel)" NOR);
    input_to((: if_work :), ob);
    return;
  }
  ob->delete_temp("zhuanshi_count");
  write(HIY "\n转世过程第一步：" NOR + HIW "[请选择你转世后的种族]" NOR);
  write("
                " HIM "0.神族(只有四转的时候才能选择)" NOR "
                " HIY "1.界圣(只有三转的时候才能选择)" NOR "
                " HIG "2.人类" NOR "
                " HIM "3.仙族" NOR "
                " HIR "4.妖魔" NOR "
                " HIG "5.退出" NOR "
                \n");
  write("请选择你转世后的种族（0，1，2，3，4，5）：");
  input_to("get_zhongzu", ob);
}



private void get_zhongzu(string arg, object ob) {
  mapping cs_status;
  int cnt;
  string *cs;

  if (arg == "") {
    write("请选择你转世后的种族（0，1，2，3，4，5）：");
    input_to("get_zhongzu", ob);
    return;
  }
  if (arg[0] == '1' || arg[0] == '2' || arg[0] == '3' || arg[0] == '4' || arg[0] == '0') {
    /* by snowtu 2014
                            if( ob->query("samsara_2") < 1 && arg[0]=='0' )
                                {
                                        write("你目前的状态还不能选择界圣这一种族\n");
                                        write("请选择你转世后的种族（0，1，2，3，4，5）：");
                                        input_to("get_zhongzu", ob);
                                        return;

                                }
                            if( ob->query("samsara_3") < 1 && arg[0]=='0' )
                                {
                                        write("你目前的状态还不能选择神族这一种族\n");
                                        write("请选择你转世后的种族（0，1，2，3，4，5）：");
                                        input_to("get_zhongzu", ob);
                                        return;

                                }
*/
    if (ob->query("zhuanshi") != 3 && arg[0] == '0') {
      write("你目前的状态还不能选择神族这一种族\n");
      write("请选择你转世后的种族（0，1，2，3，4，5）：");
      input_to("get_zhongzu", ob);
      return;
    }
    if (ob->query("zhuanshi") != 2 && arg[0] == '1') {
      write("你目前的状态还不能选择界圣这一种族\n");
      write("请选择你转世后的种族（0，1，2，3，4，5）：");
      input_to("get_zhongzu", ob);
      return;
    }
    //end by snowtu 2014
    /*这里让用户每次转世必须选择另外一个种族*/
    cs_status = ob->query("modify_class");
    if (mapp(cs_status) && sizeof(cs_status)) {
      cs = keys(cs_status);
      if (member_array(national[(int)(arg[0] - '0')], cs) != -1) {
        write("你选择过" + HIR + national[(int)(arg[0] - '0')] + NOR + "界了\n");
        write("请选择你转世后的种族（0，1，2，3，4，5）：");
        input_to("get_zhongzu", ob);
        return;
      }
    }
    if (national[(int)(arg[0] - '0')] == ob->query("class")) {
      write("你现在就是" + HIR + national[(int)(arg[0] - '0')] + NOR + "界了\n");
      write("不要再选择" + HIR + national[(int)(arg[0] - '0')] + NOR + "界了\n");
      write("请选择你转世后的种族（0，1，2，3，4，5）：");
      input_to("get_zhongzu", ob);
      return;
    }
    /*这里让用户每次转世必须选择另外一个种族*/
    ob->set_temp("choose_class", national[(int)(arg[0] - '0')]);
    write(HIY "\n转世过程第二步：" NOR + HIW "[请选择你转世后的性别]" NOR);
    write("\n选择你转世后的性别:男性(m)或女性(f)？");
    input_to("get_gender", ob);
    return;
  } else {
    if (arg[0] == '5') {
      ob->delete_temp("zhuanshi_count");
      return;
    }
    write("对不起，您只能从（0，1，2，3，4，5）中选择： ");
    input_to("get_zhongzu", ob);
    return;
  }
}

private void get_gender(string gender, object ob) {
  int cnt;
  if (gender == "") {
    write("选择你转世后的性别:男性(m)或女性(f)？");
    input_to("get_gender", ob);
    return;
  }

  if (gender[0] == 'm' || gender[0] == 'M')
    ob->set_temp("choose_gender", "男性");
  else if (gender[0] == 'f' || gender[0] == 'F')
    ob->set_temp("choose_gender", "女性");
  else {
    write("对不起，您只能选择男性(m)或女性(f)：");
    input_to("get_gender", ob);
    return;
  }
  write("\n你转世后的种族：" + HIR + ob->query_temp("choose_class") + NOR);
  write("\n你转世后的性别：" + HIR + ob->query_temp("choose_gender") + NOR);
  write("\n你确定要进行转世了吗(y/n)？");
  input_to("confirm_samsara", ob);
  return;

  /*
        write(HIY"\n转世过程第三步："NOR+HIW"[请输入你转世后需要保留的功夫]"NOR);
        ob->set_temp("keep_num",3);
        cnt = ob->query_temp("keep_num");
        write("\n你最多可以保留"+HIY"["+chinese_number(cnt)+"]"NOR+"项功夫");
        write("\n输入你转世后保留的第"+HIY"["+chinese_number(1)+"]"NOR+"项功夫：");
        input_to("keep_skill", ob);*/

}

