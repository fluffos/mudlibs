// literate.c

inherit ITEM;

void create() {
  set_name("〖噬魂刀(赠送万息降临法(超强法术)〗", ({ "shihun", "book" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("value_c", 338);
    set("no_get", 1);
    //set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("long", "一本噬魂刀的画册。\n");
    set("material", "paper");
    set("skill", ([
      "name": "darkblade",
      "exp_required": 10,
      "sen_cost": 4,
      "difficulty": 4,
      "max_skill": 1,
    ]));
  }
}

void init() {
  object me = this_object();
  object where = environment();
  if (userp(where)) {
    if (me->query("owned")) {
      if (me->query("owned") != where->query("id")) {
        call_out("destruct_me", 0, where, me);
      }
    } else {
      me->set("owned", where->query("id"));
    }
  }
}
void destruct_me(object where, object me) {
  message_vision("$N手中的$n化为了碎片。\n", where, me);
  destruct(me);
}
