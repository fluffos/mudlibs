// literate.c

inherit ITEM;

void create()
{
        set_name("〖大雅剑法〗", ({"dayajian", "book"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
		set("value_c", 268);
set("no_give",1);
set("no_put",1);
	set("long","一本大雅剑法的画册。\n");
        set("material", "paper");
        set("skill", ([
                        "name": "daya-jian",
                        "exp_required": 10,
                        "sen_cost": 4,
                        "difficulty": 4,
                        "max_skill": 200,
]) );
        }
}

