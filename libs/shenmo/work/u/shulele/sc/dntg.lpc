#include <ansi.h>

inherit ITEM;
#include <dntg.h>

int do_eat(string);
void create()
{
  set_name(HIC "大闹天宫丹" NOR, ({"dntg dan", "dan"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIC"碧油油的一颗丹药。\n"NOR);
    set("value_c", 5);
    set("no_sell", 1);
  }
  
  setup();
}

void init()
{
        add_action("do_eat", "eat");
//        call_out("announce",random(10),this_player());
}


void announce(object who)
{
    if(!this_object()) return;
    if(!who) return;
    CHANNEL_D->do_channel(this_object(), "sys",
            who->query("name")+"得到了"+name()+"！\n");
}

int do_eat(string arg)
{
  object me = this_player();
int size=sizeof(obstacles);
string *names = keys(obstacles); 
string *strs = allocate (size);
int nb = 0; 
 int i;
for (i = 0; i < size; i++) 
 {
 strs[i] = "none"; 
}
for (i = 0; i < size; i++) 
 { 
 me->set("dntg/"+names[i],"done");
}
me->set("dntg/number",size);
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

        message_vision(HIC"$N吃下一颗通观丹，脸色变的一片惨白。过去的事情仿佛一片空白。。。\n"NOR, me);  
  
        me->add("bellicosity", -random( (int)me->query_kar() * 10));
  destruct(this_object());
  return 1;
}
