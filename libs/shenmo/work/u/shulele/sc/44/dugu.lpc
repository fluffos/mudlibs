// literate.c

inherit ITEM;

void create()
{
        set_name("〖孤独九剑〗", ({"dugu", "book"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
		set("value_c", 368);
set("no_get", 1);
set("no_give", 1);
set("no_drop", 1);
set("no_put", 1);
	set("long","一本不动明王的的画册。\n");
        set("material", "paper");
        set("skill", ([
                        "name": "dugu-jiujian",
                        "exp_required": 10,
                        "sen_cost": 4,
                        "difficulty": 4,
                        "max_skill": 1,
]) );
        }
}

