#include <ansi.h>
inherit ITEM;

void init() {
  add_action("do_fly", "wozou");
}

void create() {
  set_name("传送卡", ({ "renwuka", "renwu", "ka" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("value_c", 5);
    set("no_get", 1);
    set("no_drop", 1);
    set("no_put", 1);
  }
  setup();
}

int do_fly() {
  object ob, myenv;
  ob = this_player();
  if (ob->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (ob->is_fighting())
    return notify_fail("你无法在战斗中使用任务卡！\n");


  if (ob->query("daoxing") > 2000) {
    message_vision("你发动了任务卡,你飞了起来。\n", ob);
    message_vision("你飞啊飞,飞了很长时间终于飞到了任务空间......\n", ob);
    ob->add("sen", -100);
    ob->add("kee", -100);
    myenv = environment(ob);
    ob->move("d/xingji/kongjian");
    return 1;
  } else
    message_vision("只有大于200万武学，并在安全地带就是不准战斗的地方??\n"
      "才能使用任务卡!!!\n"
      , ob);
  return 1;
}
