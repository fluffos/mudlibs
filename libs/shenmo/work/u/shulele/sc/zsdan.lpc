#include <ansi.h>
inherit ITEM;
int do_eat(string);
void create()
{
  set_name(HIC "转世丹" NOR, ({"zhuanshi dan"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIC"碧油油的一颗丹药，听说是用来转世的神丹，凡人勿近！\n"NOR);
    set("value_c", 300);
   set("xybvalue", 20);
   set("no_sell", 1);
   set("no_give",1);
   set("no_put",1);
//   set("short", "听说是乌鸡国的传国珍宝，经历轮回转世才能服用");
  }
  setup();
}

void init()
{
        add_action("do_eat", "eat");
        call_out("announce",random(10),this_player());
}

void announce(object who)
{
    if(!this_object()) return;
    if(!who) return;
      CHANNEL_D->do_channel(this_object(), "sys",
             who->query("name")+"得到了"+name()+"！\n");
}

int do_eat(string arg)
{
  object me = this_player();
  string msg; 
  if (!id(arg))
   { return notify_fail("你要吃什么？\n");}
//      if (me->query("zhuanshi")<1)
//   { return notify_fail("你还是老老实实的去取经吧！别偷懒！\n"); }
//      if (me->query("obstacle/wuji")=="done")
//   { return notify_fail("就知道吃，吃，吃！小心变猪头！\n"); }
        message_vision(HIC"$N吃下一颗神丹，脸色变的一片惨白。仿佛时空穿梭了一般。。。\n"NOR, me);  
        me->set("obstacle/wuji","done"); 
        me->add("obstacle/number",1);
        me->set("zhuanshi",3);
        me->set("level",1250);
        me->set("combat_exp",500000000);
        me->set("daoxing",500000000);
        me->set("shen",5000);
        me->set("rsg_eaten",48);
        me->set("obstacle/reward","done");
        me->set("dntg/laojunlu","done");
        me->set("samsara_2",1);
        me->set("samsara_3",1);
        me->save();
          msg="有人看见"+ me->query("name")+ "吞下一颗神丹，真是有钱人呀！\n";
          CHANNEL_D->do_channel(this_object(),"sys",msg);
  destruct(this_object());
  return 1;
}
