#include <ansi.h>
inherit ITEM;

int do_eat(string);
int pot = 150;
string type = "";

void setup()
{
::setup();
switch(random(3))
        {
        case 0 : set("ad_type","daoxing");
                 type = "道行";
                 break;
        case 1 : set("ad_type","combat_exp");
                 type = "武学经验";
                 break;          
        default: set("ad_type","potential");
                 type = "潜能";
        }        
switch(random(10))
        {
        case 9 : pot = 200;set_name(type+"追加丹(圣)",({"zhuijia dan", "dan"}));break;
        case 8 : pot = 155;set_name(type+"追加丹(神)",({"zhuijia dan", "dan"}));break;
        case 7 : pot = 135;set_name(type+"追加丹(特)",({"zhuijia dan", "dan"}));break;
        case 1 : pot = 130;set_name(type+"追加丹(大)",({"zhuijia dan", "dan"}));break;
        default: pot = 125;set_name(type+"追加丹(普)",({"zhuijia dan", "dan"}));
        }               
}
        
void init()
{
if ( environment() && !query("owner_id") )
        {
        set("owner_id",environment()->query("id"));     
        set("get_time",time());
        }
add_action("do_eat", "eat");
}

void create()
{
set_name("经验丹",({"jingyan dan", "dan"}));
set("name_corlor","HIG");
set_weight(90);
if (clonep())
        set_default_object(__FILE__);
else    {
        set("unit", "颗");
        set("drug_type", "补品");
        set("no_give",1);
        set("no_put",1);
        set("no_sell",1);
        set("value_c", 27);
        }
setup();
}

int do_eat(string arg)
{
object me = this_player();
if ( !arg || !id(arg) )
        return 0;
if ( time()>query("get_time")+60000 )
     {
   write(name()+"好似是个过期的道具了。\n");
   return 0;
        }               
message_vision(HIG "$N"HIG"轻轻掰开一颗"+name()+HIG"一时间香气四溢。只见$N"HIG"脸上慢慢泛出红晕，看起来有精神多了！\n" NOR, me);
if ( query("owner_id")==me->query("id") )
        {
        me->set_temp("ad_apply/"+query("ad_type"),([
                "start" : time(),
                "time"  : 180000,
                "pot"   : pot,
        ]));          
        tell_object(me,HIG"你在其后的10小时内获得的"+type+"奖励将为平时的"+pot+"%。\n"NOR);
        }
destruct(this_object());
return 1;
}

string long()
{
return "吃过之后能在1小时之内，使得到的"+type+"为平时所得的"+pot+"%的道具。\n您必须在10分钟之内使用它。";
}       

