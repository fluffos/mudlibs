#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIW "龟鹤松龄丹" NOR, ({ "guihe dan", "dan" }));
  set("unit", "粒");
  set("long", "一粒紫色的药丸,闻起来没什么味道,不知道能不能吃(eat)。\n");
  set_weight(3000);
  set("value_c", 1);
  set("no_give", 1);
  set("no_put", 1);
  setup();
}
void init() {
  add_action("do_eat", "eat");
  //add_action("do_give", "give");
}
int err_msg(string arg) {
  write(arg);
  return 0;
}
int do_eat(string arg) {
  object me;
  int my_mao;
  int sub_mao;
  me = this_player();
  if (!present(this_object(), me)) return 0;  //这个必须有，不然不get就可以用了
  if (me->is_busy()) return notify_fail("你正忙着呢。\n");  //不加的话就是第二个凤凰琴了
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  my_mao = me->query("haomao");
  sub_mao = my_mao / 5;
  sub_mao = sub_mao + 1;
  me = this_player();
  if ((random(100) > 80 && my_mao > 2 && me->query("spskk") != 14) || my_mao > 29) {
    tell_object(me, HIR "你兴奋地把灵药吃了下去，突觉得腹内翻江倒海般的疼痛！\n" NOR);
    tell_object(me, HIR "原来此物不可多用，吃多了非但不能长生不老，反而大损阳寿！\n" NOR);
    me->set("haomao", my_mao - sub_mao);
    destruct(this_object());
    return 1;
  }
  message("channel:rumor", HIM "【顺风耳】某人：听说" + me->name() + HIM "吞食了一粒龟鹤松龄丹。\n" NOR, users());
  tell_object(me, HIG "你像嚼花生豆一样把丹药吃了下去，忽然感觉后颈奇痒无比！\n" NOR);
  me->set("haomao", my_mao + 1);
  me->start_busy(1 + random(3));
  me->save();
  destruct(this_object());
  return 1;
}
