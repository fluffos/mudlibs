// shenliwan.c 神力丸

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIR "破煞丹" NOR, ({ "posha dan", "dan" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗血红色的丹丸，据说吃了可以增加胆识。\n");
    set("value_c", 3);
    set("unit", "颗");
  }
}

void init() {
  add_action("do_eat", "eat");
  //add_action("do_give", "give");
}

int do_eat(string arg) {
  object me;

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  me = this_player();
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);
  if (me->query("gift/cordan") >= 5) {
    message_vision("$N眨眨眼。\n", me);
    tell_object(me, "虽然是灵丹妙药，可是对你似乎不再起作用了。\n");
  } else if (random(5) < 1) {
    tell_object(me, "不过你觉得好像没什么作用。\n");
  } else {
    tell_object(me, HIR "你的先天胆识提高了！\n" NOR);
    me->add("cor", 1);
  }

  me->add("gift/cordan", 1);
  destruct(this_object());
  return 1;
}
