#include <ansi.h>

inherit ITEM;
#include <obstacle.h>

int do_eat(string);
void create()
{
  set_name(HIC "取经丹" NOR, ({"qujing dan", "dan"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIC"碧油油的一颗丹药。\n"NOR);
    set("value_c", 30);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("no_steal", 1);
    set("no_put", 1);
  }
  
  setup();
}

void init()
{
        add_action("do_eat", "eat");
//        call_out("announce",random(10),this_player());
}


void announce(object who)
{
    if(!this_object()) return;
    if(!who) return;
    CHANNEL_D->do_channel(this_object(), "sys",
            who->query("name")+"得到了"+name()+"！\n");
}

int do_eat(string arg)
{
  object me = this_player();
int size=sizeof(obstacles);
string *names = keys(obstacles); 
string *strs = allocate (size);
int nb = 0; 
 int i;
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
if ( !present(this_object(),me) )      return notify_fail("你要吃的东西不在你身上啊！\n");
for (i = 0; i < size; i++) 
 { 
 me->set("obstacle/"+names[i],"done");
}
me->set("obstacle/number",size);

        message_vision(HIC"$N吃下一颗取经丹，如来佛祖让你通过了所有难关。\n"NOR, me);  
  
  destruct(this_object());
  return 1;
}
