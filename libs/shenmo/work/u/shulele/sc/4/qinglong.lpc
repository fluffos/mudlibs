#include <ansi.h> 
#include <armor.h>
#include <dbase.h> 
inherit WAIST;
inherit F_AUTOLOAD;
inherit F_SAVE;
inherit F_BACKUP;
void create()
{
seteuid(0);
set_name(HIC "青龙宝带" NOR, ({"qinglong baodai", "baodai"}));
set_weight(2000);
if( clonep() )
set_default_object(__FILE__);
else
{
set("long", HIC"灵兽青龙幻化成的一件圣物。\n"NOR);
set("material", "leather");
set("unit", "条");
set("value_c", 20);
set("wear_msg",HIC"从东方的天际传来一声龙吟，$N腰间一片青芒闪烁。\n"NOR); 
set("unequip_msg",HIC"$N身后青芒渐淡，$n"HIC"踪迹皆无。\n"NOR);
set("no_get", 1);
set("no_give", 1);
set("no_drop", 1);
set("no_put", 1);
set("no_break", 1);
set ("armor_prop/spells", 200);
set("armor_prop/armor", 250);
}
setup();
}
int save() 
{
return ::save();
}
void setup()
{
::setup();
}
int query_unique()  { return 1; }
int query_autoload() { return 1; }
