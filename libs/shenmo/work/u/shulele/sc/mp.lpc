#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIW "门忠丹" NOR, ({ "menzhong dan", "dan" }));
  set("changed", 1);
  set("no_store", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", HIG "【礼物】" NOR HIM "增加100门忠。" NOR "\n");
    set("value_c", 10);
    set("num", 10000000);
  }
  setup();
}

void init() {
  if (!query("owner_id") && environment() && userp(environment()))
    set("owner_id", environment()->query("id"));
  add_action("do_drink", "eat");
}

int do_drink(string arg) {
  int v;
  object me = this_player();

  if (!arg || !id(arg))
    return 0;
  //  if( me->query("id")!=query("owner_id")  )   return err_msg("这个"+name()+"不是你买的。\n"); 

  //     if( !me->query("family/family_name") )
  //             return err_msg("现在不需要。\n");
  message_vision("$N吃下一粒$n，感觉自己萌萌哒。\n", me, this_object());
  me->add("faith", +100);
  write(HIY "【系统】你得到了5000点门派贡献。" NOR "\n");
  destruct(this_object());
  return 1;
}
