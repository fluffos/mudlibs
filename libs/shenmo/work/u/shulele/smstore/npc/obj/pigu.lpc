
inherit ITEM;
#include <ansi.h>
int do_fu(string arg);
void create()
{
   set_name(HIR"辟谷丹"NOR, ({ "pigu dan","dan" }));
   set_weight(100);
   set("unit", "颗");
   set("long","这是一颗由多种营养丰富的物体炼制而成的丹药,服用(fu dan)它能补充大量能量.\n");
   set("value", 20000);
   
}

void init()
{
	add_action("do_fu","fu");
}
int do_fu(string arg)
{
	object me,ob;int i;
	ob=this_object();me=this_player();
	if(!arg||(arg!="dan"&&arg!="丹"))
		return notify_fail("你要服用什么?\n");
                            if(me->query("water")>2500)
		return notify_fail("你都这么撑了，还是先消化消化吧！\n");
	me->add("food",1000);
              me->add("water",1000);
	message_vision("$N服下了一颗[辟谷丹]，感觉到好饱。\n",me);
	destruct(ob);
	return 1;
}