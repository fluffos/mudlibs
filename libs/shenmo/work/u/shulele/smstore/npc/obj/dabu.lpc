inherit ITEM;
#include <ansi.h>
int do_fu(string arg);
void create() {
  set_name(HIG "大补丸" NOR, ({ "da bu", "wan" }));
  set_weight(100);
  set("unit", "粒");
  set("long", "这是一粒由神兽精元炼制的大补丸,服用(fu wan)它能瞬间补充内力.\n");
  set("value", 200000);
  set("no_give", 1);
  set("no_drop", 1);
  set("no_sell", 1);
}

void init() {
  add_action("do_fu", "fu");
}
int do_fu(string arg) {
  object me, ob; int i;
  ob = this_object(); me = this_player();
  if (!arg || (arg != "wan" && arg != "丸"))
    return notify_fail("你要服用什么?\n");
  if (me->query("force") > me->query("max_force"))
    return notify_fail("你现在内力饱满，不需要服用！\n");
  me->add("force", me->query("max_force"));
  message_vision("$N服下了一粒[大补丸]，瞬间恢复了活力。\n", me);
  destruct(ob);
  return 1;
}
