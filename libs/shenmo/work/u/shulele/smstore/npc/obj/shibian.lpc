inherit ITEM;
#include <ansi.h>
int do_fu(string arg);
void create() {
  set_name(HIR "十鞭丹" NOR, ({ "shibian dan", "dan" }));
  set_weight(100);
  set("unit", "颗");
  set("long", "这是一颗由十种生物鞭制成的大补丹,服用(fu dan)它能用增加少量内力.\n");
  set("value", 100000);

}

void init() {
  add_action("do_fu", "fu");
}
int do_fu(string arg) {
  object me, ob; int i;
  ob = this_object(); me = this_player();
  if (!arg || (arg != "dan" && arg != "丹"))
    return notify_fail("你要服用什么?\n");
  me->add("max_force", 30 + random(20));
  message_vision("$N服下了一颗[十鞭丹]，感觉内力加强了。\n", me);
  destruct(ob);
  return 1;
}
