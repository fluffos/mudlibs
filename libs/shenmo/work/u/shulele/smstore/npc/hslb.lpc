#include <ansi.h>

inherit F_VENDOR_SALE;
string give_go();
string do_ask();
void create() {

  set_name("乐乐老板", ({ "lele", "shu" }));
  set("gender", "女性");
  set("age", 28);

  set("nickname", HIG "杀人不用刀" NOR);
  set("long", "这就是黑市的大老板，听说此人很有势力，本身也是个高手，最好还是不要得罪的好。\n");
  set("shop_id", ({ "lele", "shu" }));
  set("chat_chance", 3);
  set("chat_msg", ({
    CYN "瞄老板说道:要买就买，不买走人，谢绝还价，概不退货!\n" NOR, }));
  set("inquiry", ([
    "施舍": (: give_go :),
    "二层": (: do_ask :),
  ]));

  set("combat_exp", 20000000);
  set("str", 50);
  set("con", 50);
  set("int", 50);
  set("dex", 50);
  set("per", 30);
  set("kar", 30);
  set_skill("parry", 600);
  set_skill("dodge", 600);
  set_skill("strike", 600);
  set_skill("literate", 600);
  set_skill("sanshou-strike", 600);
  set("max_", 600);
  set("parry", 600);
  set("parry", 600);
  set("parry", 600);
  set("max_gin", 5000);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("max_force", 25000);
  set("force", 25000);
  set("jiali", 300);
  set("apply_points", 2000);

  set("vendor_goods", ([
    "jingang": __DIR__ "obj/jingang",
    "jinqiang": __DIR__ "obj/jinqiang",
    "pmdan": __DIR__ "obj/pmdan",
    "pgdan": __DIR__ "obj/pigu",
    "jiudai": __DIR__ "obj/jiudai",
    "head": __DIR__ "obj/head",
    "dabu": __DIR__ "obj/dabu",
  ]));
  setup();


}
string give_go() {
  object ob, dan;
  ob = this_player();
  if (present("shi dan", ob)) {

    return "做人不要那么贪心！";
  }
  dan = new(__DIR__ "obj/shidan");
  dan->move(ob);
  message_vision("$N随手丢给了$n一颗丹药。\n" NOR, this_object(), ob);
  return "去去去，拿了东西赶快走人。\n";
}

string do_ask() {
  return "想去二层？楼梯被一股强大的力量封印了，不过只要给我100两黄金，我就告诉你上去的办法!\n";
}
int accept_object(object who, object ob) {
  if (ob->query("money_id") && ob->value() >= 1000000) {
    tell_object(who, "lele老板说道：嘿嘿，答对口令就能上去，天王盖地虎!\n");
    who->set_temp("gived_money", 1);
  } else tell_object(who, "乐乐老板冷哼一声:你打发要饭的呢!\n");
  return 1;
}



int do_say(string arg) {
  object ob;
  ob = this_player();
  if (ob->query_temp("gived_money") < 1) {
    command("say 哼，你想干嘛，无视我的存在么?\n");
    return 1;
  }
  if (arg != "宝塔镇河妖") {
    command("say 没文化，真可怕!\n");
    return 1;
  }

  command("say 你可以上去了!\n");
  ob->set_temp("gived_money");
  ob->move("/u/shulele/smstore/duihuan");
  message_vision("$N眼睛一花，已经不知不觉来到了二层。\n", ob);
  return 1;
}



void init() {
  ::init();
  add_action("do_vendor_list", "list");
  add_action("do_say", "say");
}

int regenerate() {
  set("called", 0);
  return 1;
}
