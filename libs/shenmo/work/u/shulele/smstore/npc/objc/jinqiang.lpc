inherit ITEM;
#include <ansi.h>
int do_fu(string arg);
void create() {
  set_name(HIG "金枪丸" NOR, ({ "jin qiang", "wan" }));
  set_weight(100);
  set("unit", "粒");
  set("long", "这是一粒由多种神兽的某些部位炼制的金枪丸,服用(fu wan)它能临时暴涨气血.\n");
  set("value", 5000000);
  set("no_give", 1);
  set("no_drop", 1);
  set("no_sell", 1);
}

void init() {
  add_action("do_fu", "fu");
}
int do_fu(string arg) {
  object me, ob; int i;
  ob = this_object(); me = this_player();
  if (!arg || (arg != "wan" && arg != "wan"))
    return notify_fail("你要服用什么?\n");
  if (me->query("kee") > me->query("max_kee"))
    return notify_fail("你还是歇会吧，吃太多会你不怕暴血而亡啊！\n");
  me->add("kee", 15000 + random(5200));
  message_vision("$N服下了一颗[金枪丸]，感觉全身充满了力量，夜御千女，金枪不倒。\n", me);
  destruct(ob);
  return 1;
}
