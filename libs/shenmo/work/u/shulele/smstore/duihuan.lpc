
#include <ansi.h>
inherit ROOM;
void create ()
{
  set ("short","黑市二层");
  set ("long", @LONG
你来到了一个黑市二层，四周的墙壁上印刻这奇怪的花纹，十分诡异。
奇怪的是这里竟然没有人看守，只在中间的一个台子上面留有一张清单(list)。
LONG);

  set("exits", ([ 
	  "down":__DIR__"smstore",
    ]));

  set("item_desc",([
      "list":HIG"使用[huan 编号]兑换你想要的物品\n
1：金枪丸(增加两万左右临时气血)\n
2：大补丸(恢复内力)\n"NOR,
      ]));

  setup();

 
}


     
