inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIY "神魔年卡" NOR, ({ "year card" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 1000000);
    set("value_c", 120);
    set("unit", "张");
    set("long", "这是一张神魔年卡，可以增加365天会员时间!\n");
    set("no_sell", 1);
    set("no_steal", 1);
    set("only_do_effect", 1);
  }
}

void init() {
  if (environment() == this_player())
    add_action("do_use", "use");
}

int do_use(string arg) {

  object me = this_player();
  int vip_time = 365 * 24 * 3600;
  if (arg != "year card") return 0;
  write(YEL "你的会员时间增加365天！" NOR "\n");
  me->add("zjvip/times", vip_time);
  me->save();
  destruct(this_object());
  return 1;
}

int query_autoload() { return 1; }
