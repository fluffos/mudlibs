// dabuwan.c 

inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
  add_action("do_eat", "fu");
}

void create() {
  set_name("十全大补丸", ({ "dabu wan", "wan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗十全大补丸，据说能起死回生。\n");
    set("value", 2500);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return 0;

  if ((me->query("eff_jing") + 250) >= me->query("max_jing"))
    me->set("eff_jing", me->query("max_jing"));
  else me->add("eff_jing", 250);
  if ((me->query("jing") + 250) >= me->query("max_jing"))
    me->set("jing", me->query("eff_jing"));
  else me->add("jing", 250);

  if ((me->query("eff_qi") + 250) >= me->query("max_qi"))
    me->set("eff_qi", me->query("max_qi"));
  else me->add("eff_qi", 250);
  if ((me->query("qi") + 250) >= me->query("max_qi"))
    me->set("qi", me->query("eff_qi"));
  else me->add("qi", 250);

  message_vision("$N吃下一颗十全大补丸，精神气色顿时好转。\n", this_player());
  destruct(this_object());
  return 1;

}
