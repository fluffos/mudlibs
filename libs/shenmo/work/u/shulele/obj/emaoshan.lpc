// emaoshan.c
// euquip for npc zgbl

#include <weapon.h>

inherit HAMMER;

void create() {
  set_name("花鹅毛扇", ({ "emao shan", "shan" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄用花鹅毛胡乱扎成的扇子。\n");
    set("value", 100);
    set("material", "iron");
    set("wield_msg", "$N拿出一把$n握在手中，故作风雅地扇了两下。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_hammer(1);
  setup();
}
