// yejichang.c
// euquip for npc zgbl

#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("野鸡氅", ({ "yeji chang","chang" }) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
        set("long", "这是一件野鸡毛编制成的大氅。\n");
                set("value", 100);
                set("material", "cloth");
                set("armor_prop/armor", 1);
           }
        setup();
}


