#include <ansi.h>

inherit COMBINED_ITEM;
string query_autoload() { return query_amount() + ""; }
void init() {

  add_action("do_usejian", "使用");
}
void autoload(string param) {
  int amt;
  if (sscanf(param, "%d", amt) == 1)
    set_amount(amt);
}

void setup() {
  set_amount(1);
  ::setup();
}
void create() {
  set_name(HIW "飞剑" NOR, ({ "feijian" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 10000);
    set("no_sell", 1);
    set("unit", "把");
    set("base_unit", "把");
    set("no_put", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("base_weight", 10);
    set("base_value", 10000);
    set(
      "long",
      "这是一柄" HIW "飞剑" NOR "，他能带你快速飞到李靖任务,送信任务,薛仁贵任务，门派任务,袁天罡任务,十劫难任务,搭救任务，轮回任务和钟馗任务怪NPC。\n"
    );
    //set("only_do_effect", 1);
  }
  setup();
}

int do_usejian(string arg) {
  object me = this_player();
  object ob, obs, obss, obsss, obssss, obsssss, obssssss, obsssssss, obssssssss, obsssssssss;
  if (arg != "feijian") return 0;
  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");

  if (me->is_fighting())
    return notify_fail("正在战斗中，不能使用" + name() + "。\n");
  /*if(!me->query("zjvip/times")&&me->query("feijiantimes")>0){
		return notify_fail("你已经到达最高使用次数，开通神魔会员可以无限使用。\n");
		
	}*/
  ob = me->query_temp("letter/place");
  obs = me->query_temp("mieyao/place");
  obss = me->query_temp("meiyaojob/place");
  obsss = me->query_temp("yuanjob/place");
  obssss = me->query_temp("shijienan/place");
  obsssss = me->query_temp("xuejob/place");
  obssssss = me->query_temp("dajiu/place");
  obsssssss = me->query_temp("xyw/place");
  obssssssss = me->query_temp("kui/place");
  obsssssssss = me->query_temp("shashou/place");

  if (!ob && !obs && !obss && !obsss && !obssss && !obsssss && !obssssss && !obsssssss && !obssssssss && !obsssssssss) return notify_fail("你还没有任务呢？\n");
  if (ob) {
    me->move(environment(ob));
    write(HIC + "只见一眨眼的时间，你出现在了" + ob->query("name") + NOR + "\n");
  } else if (obs) {
    me->move(environment(obs));
    write(HIC + "只见一眨眼的时间，你出现在了" + obs->query("name") + NOR + "\n");
  } else if (obsss) {
    me->move(environment(obsss));
    write(HIC + "只见一眨眼的时间，你出现在了" + obsss->query("name") + NOR + "\n");
  } else if (obssss) {
    me->move(environment(obssss));
    write(HIC + "只见一眨眼的时间，你出现在了" + obssss->query("name") + NOR + "\n");
  } else if (obsssss) {
    me->move(environment(obsssss));
    write(HIC + "只见一眨眼的时间，你出现在了" + obsssss->query("name") + NOR + "\n");
  } else if (obssssss) {
    me->move(environment(obssssss));
    write(HIC + "只见一眨眼的时间，你出现在了" + obssssss->query("name") + NOR + "\n");
  } else if (obsssssss) {
    me->move(environment(obsssssss));
    write(HIC + "只见一眨眼的时间，你出现在了" + obsssssss->query("name") + NOR + "\n");
  } else if (obssssssss) {
    me->move(environment(obssssssss));
    write(HIC + "只见一眨眼的时间，你出现在了" + obssssssss->query("name") + NOR + "\n");
  } else if (obsssssssss) {
    me->move(environment(obsssssssss));
    write(HIC + "只见一眨眼的时间，你出现在了" + obsssssssss->query("name") + NOR + "\n");
  } else {
    me->move(environment(obss));
    write(HIC + "只见一眨眼的时间，你出现在了" + obss->query("name") + NOR + "\n");
  }

  //me->add("feijiantimes",1);
  add_amount(-1);
  return 1;
}
