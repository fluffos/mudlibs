#include <ansi.h>
inherit COMBINED_ITEM;

void setup()
{}

void init()
{
add_action("do_eat", "eat");
}

void create()
{
set_name(HIM"喜糖"NOR, ({"xi tang", "tang", "xitang"}));
set("base_unit","块");
set("unit","些");
set("long", HIM"这是小男人和乐乐结婚那天的喜糖，里外上下流露出令人雀跃的喜气，不用吃，就已经让人沉醉在酥人的幸福中。。。。\n"NOR);
set("no_sell","掌柜的看了看，面色大变：这东西可不是凡间的物什。。。。\n");
set("no_drop","这么珍贵的结婚纪念物还想丢，你有没有人性？！\n");
set("no_put","这么珍贵的结婚纪念物还是赶紧吃了吧。\n");
set("no_get",">\n>OK.\n");
set_amount(8);
setup();
}

int do_eat(string arg)
{
object me = this_player();
if ( !present(this_object(),me) )
        return 0;       
if ( !arg || !id(arg) )
        return 0;
if ( me->is_busy() )
        return 0;       
message_vision("$N小心翼翼的将$n上的糖纸拨去，满含热泪的放在口中，不禁
流出了幸福的泪水。。。。“唉，希望小男人能够多娶几个老婆？\n",me,this_object());
me->receive_curing("kee",1000);
me->receive_curing("sen",1000);
me->receive_heal("kee",1000);
me->receive_heal("sen",1000);
me->add("food",500);
me->add("water",500);
me->add("combat_exp",500);
me->add("daoxing",500);
me->add("potential",500);
add_amount(-1);
return 1;
}
