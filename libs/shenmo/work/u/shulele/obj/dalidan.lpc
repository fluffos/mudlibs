// dabudan.c 

inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
  add_action("do_eat", "fu");
}

void create() {
  set_name("大力丹", ({ "dali dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "粒");
    set("long", "这是一粒大力丹，据说能短时间内激发人的潜力，不过闻着怎么有股面粉味？\n");
    set("value", 10000);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();
  int attack, dodge;

  if (!id(arg))
    return 0;

  if (random(2) == 0) {
    message_vision("$N吃下一粒大力丹，觉得象是面粉，连呼上当～～\n", me);
    destruct(this_object());
    return 1;
  }

  if (me->query_temp("daliwan")) {
    message_vision("$N吃下一粒大力丹，觉得象是面粉，连呼上当～～\n", me);
    destruct(this_object());
    return 1;
  }

  attack = me->query_temp("apply/attack");
  dodge = me->query_temp("apply/dodge");
  me->add_temp("apply/attack", attack / 2);
  me->add_temp("apply/dodge", -dodge / 2 * 3);

  me->add_temp("daliwan", 1);

  message_vision("$N吃下一粒大力丹，觉得一股热气从丹田腾起，浑身顿时充满了无穷无尽的精力！\n", this_player());
  destruct(this_object());
  return 1;

}
