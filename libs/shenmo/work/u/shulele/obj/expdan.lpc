inherit ITEM;
#include <ansi.h>
int do_fu(string arg);
void create() {
  set_name(HIR "经验丹" NOR, ({ "exp dan", "dan" }));
  set_weight(100);
  set("unit", "颗");
  set("long", "这是一颗经验丹,服用(fu dan)它可以增加经验.\n");
  set("value", 100000);

}

void init() {
  add_action("do_fu", "fu");
}
int do_fu(string arg) {
  object me, ob; int i;
  ob = this_object(); me = this_player();
  if (!arg || (arg != "dan" && arg != "丹"))
    return notify_fail("你要服用什么?\n");
  me->add("combat_exp", 1000 + random(500));
  message_vision("$N服下了一颗[经验丹].\n", me);
  destruct(ob);
  return 1;
}
