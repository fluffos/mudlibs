// guanjing.c
// euquip for npc zgbl

#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
        set_name("土布纶巾", ({ "tubu guanjin", "guanjin" }) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顶");
        set("long", "这是一顶乡下土布做成的纶巾。\n");
                set("value", 100);
                set("material", "head");
                set("armor_prop/armor", 1);
                
        }
        setup();
}

