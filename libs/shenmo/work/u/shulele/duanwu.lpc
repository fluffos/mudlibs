inherit ITEM;
#include <ansi.h>
int do_fu(string arg);
void create() {
  set_name(HIR "粽子" NOR, ({ "zongzi" }));
  set_weight(100);
  set("unit", "颗");
  set("long", "这是一颗粽子,吃了他(eat head)效果增加2倍攻击，时效1小时.\n");
  set("value", 50000);

}

void init() {
  add_action("do_fu", "eat");
}
int do_fu(string arg) {
  object me, ob; int i;
  ob = this_object(); me = this_player();
  if (!arg || (arg != "chunjie" && arg != "粽子"))
    return notify_fail("你要吃什么?\n");
  me->add("bellicosity", 100);
  message_vision("$N抓起一颗[粽子]狂啃起来，头顶佛光乍现。\n", me);
  destruct(ob);
  return 1;
}
