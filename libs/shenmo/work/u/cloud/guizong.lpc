

// modify by windy 06/05/16
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"WHT"万魔归宗"NOR"」";  
}

int valid_perform(object me)
{
if (me->query("family/family_name") != "天魔宫" && me->query_skill("huomo-dao",1) < 350) 
        return notify_fail("你还不够资格使用"+name()+"！\n"); 
if ( me->query("class")!="yao" && !me->samsara_check("huomo-dao"))
        return notify_fail("你还不够资格！\n"); 
if(me->query_skill("huomo-dao", 1) < 100) 
        return notify_fail("你的火魔刀修为太差，难以施展"+name()+"！\n"); 
if(me->query_skill("blade", 1) < 100) 
        return notify_fail("你的基本刀法根基太差，难以施展"+name()+"！\n"); 
if( time()-(int)me->query_temp("wmgz_end") < 2+random(3) ) 
        return notify_fail("你还是先喘口气吧！\n"); 
if((int)me->query("max_force") < 500 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string dodskill,msg;
int extra;
int tmp;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

extra = me->query_skill("huomo-dao",1)/2;
if(me->query("family/family_name") == "天魔宫") 
extra+=me->query("level")/3;
weapon = me->query_temp("weapon");

message_vision(HIW"\n$N神气贯通，将天魔步法精髓一气呵成！\n "NOR, me,target);
me->add_temp("apply/attack", extra);
me->add_temp("apply/damage", extra);
message_vision(HIR"万魔初醒！\n"NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
message_vision(HIB"魔光乍现！\n"NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
message_vision(HIC"万刃天魔！\n"NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
message_vision(HIR"万魔归宗！\n"NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
message_vision(HIM"$n使出天魔刀法收手式，手中的魔刃迅捷无比地砍向$N的。\n"NOR,target,me);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
if ((me->query("spskk")==7 && (int)me->query("level")>(int)target->query("level") && random(3)) || (me->query("spskk")==8 && (int)me->query("level")<(int)target->query("level") && random(3)) || (me->query("spskkk")==3 && random(5)))
        {
        message_vision(WHT"群魔狂舞！$N手中"+weapon->query("name")+WHT"发出万道刀芒，激射$n"WHT"！\n" NOR,me,target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        }
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);

if (((!me->query("env/innoxious") && me->query("family/family_name") == "天魔宫" && me->query_skill("ningxie-force", 1) > 100 && random(me->query("combat_exp")) > target->query("combat_exp")/3 && target->query("spskk")!=10) || me->samsara_check("huomo-dao",1)) && (time()-(int)me->query_temp("jclh_end")>1) && (time()-(int)me->query_temp("fc_pili")>1))
        {
        message_vision( WHT  "$n"WHT"身子微微一颤，只感觉一股火毒气直透心肺！\n" NOR,me,target);
        target->apply_condition("heavy_fire_poison",5+random(5) + target->query_condition("heavy_fire_poison"));
        }
me->set_temp("wmgz_end", time());
return 1;  
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("huomo-dao")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("blade")+" 100 级\n"; 
temp+= "\t\t内力修为五年\n"; 
temp+= "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续伤害敌人的气血
        出招类型： 
                延时型外功
                天魔宫弟子使用有隐藏效果
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}

