#include <mudlib.h>
#include <ansi.h>
#include <armor.h>
#include <dbase.h>
#include <command.h>

inherit CLOTH;
inherit F_SAVE;
inherit F_AUTOLOAD;
inherit F_DAMAGE;

string inputstr, verb;

int query_autoload() {
  return 1;
}
void create() {
  seteuid(getuid());

  set("long", @LONG
      一个闪着金光的聚宝盆。

LONG
  );

  set("unit", "个");

  set("material", "cloth");
  set("armor_prop/armor", 100);
  set("armor_type", "cape");
  set("light", 1);
  set("value", 1000);
  setup();
}
void init() {
  object me;
  seteuid(geteuid());

  me = this_player();
  set_name("聚宝盆", ({ "Jubao pen", "pen" }));

  add_action("wave", "wave");

}



int wave(string arg) {
  string kind;
  int amount;
  object n_money;

  if (!arg || sscanf(arg, "%d %s", amount, kind) != 2)
    return notify_fail("[cloak]: wave <多少钱> <钱币种类>\n");

  n_money = present(kind + "_money", this_player());
  if (!n_money && file_size("/obj/money/" + kind + ".lpc") < 0)
    return notify_fail("你摇了半天却什麽也没有出来。\n");
  if (amount < 1)
    return notify_fail("你摇了半天却什麽也没有出来。\n");

  if (!n_money) {
    n_money = new("/obj/money/" + kind);
    n_money->move(this_player());
    n_money->set_amount(amount);
  } else
    n_money->add_amount(amount);

  message_vision(sprintf("$N开始施展点金术，突然变出了%s%s%s。\n",
    chinese_number(amount),
    n_money->query("base_unit"),
    n_money->query("name")),
    this_player());
  return 1;
}
