#include <ansi.h>

#define CsCdTime 60*60*3
inherit NPC;
string start();
int dn();
void end_game();
int compare_score(object ob1, object ob2);
string end_time();

object ob = this_object();
object *users = ({});
object *tUsers = ({});
object *ctUsers = ({});
#define MAX_QUESTS 1 
mapping quest_ip = ([]);
int CheckUser(string who,string ip);
string query_stime(int time);

void create()
{
  set_name(HIY"太白金星"NOR, ({ "tai bai", "taibai" }) );
  set("title",HIW"ＣＳ大赛报名大使"NOR);
  set("gender", "男性");
  set("age", 20);
  set("combat_exp", 300000+random(20000));
  set("attitude", "heroism");
  set("no_clean_up",1);
  set("str", 3000);
  set("per", 30);
  set("max_kee", 600000);
  set("max_gin", 600000);
  set("force", 600);
  set("max_force", 600);
  set("max_mana", 60000);
  set("force_factor", random(20)+25);
  set_skill("unarmed", 800);
  set_skill("parry", 800);
  set_skill("dodge", 800);
	set("inquiry", ([
		"比赛" : (: start :),
		"大赛" : (: start :),
		"game" : (: start :),
		"cs" : (: start :),
		"cslist" : (: dn :),
		"参加人" : (: dn :),
		"参加者" : (: dn :),
		]) );  
  setup();

  carry_object("/d/qujing/baoxiang/obj/changpao")->wear();
}

void init()
{
        object who=this_player();
        if(!who) return;
        add_action("do_answer", "answer");
        add_action("do_baoming", "baoming");
        ::init();
}

/******************************************************************************
todo:
	开始报名。
******************************************************************************/
string start()
{
	object me;
	me = this_player();
	if((time()-ob->query("start_time"))>CsCdTime)
	{
		ob->delete("end_baoming");
		ob->delete("start_baoming");
		ob->delete("no_baoming");
	}
	if ( ob->query("start_baoming") ) return "报名已经开始，请用指令baoming参加游戏。\n";
	if ( ob->query("end_baoming") ) return "下次比赛还需"+query_stime(ob->query("start_time"))+"！\n";
	if ( ob->query("no_baoming") ) return end_time();
	if ( me->query("daoxing") <= 10000000 ) return "你道行太浅，只怕召集不到多少人。\n";
	if ( me->query("combat_exp") <= 10000000 ) return "你实战经验太少，还是先去别的地方锻炼锻炼吧。\n";
	ob->set("start_baoming",1);
	message( "system", HIR"【"+HIY"太白金星"+HIR"】： "HIR+me->query("family/family_name")+HIY""+me->query("name")+HIR"前来邀请各路妖仙参加ＣＳ大赛,愿意参加者请在五分钟内报名。\n" NOR, users() );
	call_out("choose_faction",300);
	ob->set("start_time",time());
	quest_ip = ([]);
	return "比赛系统已经启动，请快来报名(baoming)吧。\n";
}

/******************************************************************************
todo:
	参赛者报名。
******************************************************************************/
int do_baoming()
{
	int i,j,k;
	string str;
        object who=this_player();
	if ( sizeof(users)>15 ) return notify_fail("这次ＣＳ大赛参赛名额已经满了。\n");
	if ( ob->query("end_baoming")) return notify_fail("这次ＣＳ大赛已经停止报名。\n");
	if ( ob->query("no_baoming")) return notify_fail("这次ＣＳ大赛已经停止报名。\n");
	if ( !ob->query("start_baoming") ) return notify_fail("ＣＳ大赛还没开始报名呢。\n");
	if ( who->query_temp("no_heal_up/bian") ) return notify_fail("比赛的时候还是不要变身了吧。\n");
	if ( who->query_temp("in_hell") ) return notify_fail("灵魂是不能参加比赛的。\n");
	if ( who->query("daoxing") <= 2000000 ) return notify_fail("你道行太浅，还是不要参加了。\n");
	if ( who->query("combat_exp") <= 2000000 ) return notify_fail("你实战经验太少，还是先去别的地方锻炼锻炼吧。\n");
//	if(!CheckUser(who->query("id"),query_ip_number(who)))	
//                      return notify_fail("你不能同时开两个或两个以上id参加比赛。\n");



//      if( who->is_busy() ) 		return notify_fail("( 你正忙着呢\n");
//        who->start_busy (5);
     if((time()-who->query_temp("cstrig/baomingtime"))>600)
	who->delete_temp("cstrig");
     who->add_temp("cstrig/baomingcishu",1);
     this_player()->delete_temp("cstrig/baoming");
     this_player()->set_temp("cstrig/baomingtime",time());

     if(who->query_temp("cstrig/baomingcishu")>3)
		return notify_fail("你下一轮再来报名吧！\n");
  
        i=random(10)+10;j=random(10);
        
        switch(random(3))
        {
        	case 0:str=i+"+"+j;
        		who->set_temp("cstrig/result",i+j);
        		break;
        	case 1:str=i+"-"+j;
        		who->set_temp("cstrig/result",i-j);
        		break;
        	case 2: str=i+"*"+j;
        		who->set_temp("cstrig/result",i*j);
        		break;
        	case 3: if(j==0) j=1;
        		str=i+"/"+j;
        		who->set_temp("cstrig/result",i/j);
        		break;
        }
        if(who->query_temp("cstrig/result")==0)
        {	
		i++;
        	str=i+"+"+j;
        	who->set_temp("cstrig/result",i+j);
        }
        tell_object(who,"要报名,需要先回答个算术问题！\n");
        tell_object(who,"/adm/daemons/text2pic_d"->Display(str));

        return 1;      
}

/******************************************************************************
todo:
	决定参赛者组别。
	先按score排序，再选择：(现已改为随机分组，不再按score 排序)
	奇数者为t（纵火犯）；偶数者为ct（大侠）。
******************************************************************************/
void choose_faction()
{
        int i,j;
    object *list,me;
	string lastType,suserlist;
   me=this_player();

  list = ({});
	j=sizeof(users);
  for ( i = 0; i < sizeof(users); i++ )
  {
	if(users[i]->query_temp("csip")!=query_ip_number(users[i]) || !interactive(users[i]))
	{
	      users[i]->delete_temp("pkgame");   
       	      users -=({users[i]});
		i--;
		j--;
	}
  }

	
	// 参赛人数太少，取消比赛。
	if ( sizeof(users)<4 ) {
		message( "system", HIR"【"+HIY"太白金星"+HIR"】： 由于参赛人数少于四人，比赛取消。\n" NOR, users() );
		for ( i = 0; i < sizeof(users); i++ )
		{
			users[i]->delete_temp("pkgame");
		}

		users = ({});
	         tUsers = ({});
	        ctUsers = ({});
	        me->delete_temp("pkgame");   

//	ob->set("start_time",time()-3000);
		end_game();
		return;
	}
	ob->set("end_baoming",1);
	
	// 设置每个人的组别，并告诉其本人。
  
  
  /*******************************************************************
 
  for ( i = 0; i < sizeof(users); i++ )
  {
  	j = random(sizeof(users)-i);
		message( "system", HIR"【"+HIY"太白金星"+HIR"】："+users[i]->query("id")+users[j]->query("id")+" \n" NOR, users() );
  	list += ({users[j]});
  	users[j] = users[sizeof(users)-i];       // 这一句有问题。。。。。。。。。。。。。。。
  }
  以上部分为更改后随机分组方式。
  *******************************************************************/
  // 按score 分组,为了防止玩家利用此分组方式取得奖励改成两两随机分组
  list = sort_array(users, (: compare_score :) );      
  users = list;
	for ( i = 0; i < sizeof(users); i++ )
	{
		string type;
//		type = i%2 ? (lastType == "t" ? "ct" : "t") : (random(2) ? "t" : "ct");
		if((i/2)%2)		
			type = i%2 ? "ct" : "t";
		else
			type = i%2 ? "t" : "ct";
		lastType = type;
		users[i]->set_temp("pkgame", type);
		message( "tell", HIR"【" + HIY"太白金星" + HIR"】： 从现在开始你是"BLINK HIY + 
			(type == "t" ? "纵火犯" : "大侠") +
			HIR"。\n" NOR, users[i] );
		if (type == "t")
			tUsers += ({ users[i] });
		else
			ctUsers += ({ users[i] });
	}

/*
	// 输出组员名单
	cslist = HIR"【"+HIY"太白金星"+HIR"】： 系统choose结果：\n" NOR;
	cslist += "纵火犯组：";
	for ( i = 0; i < sizeof(users); i+=2 )
	{
		cslist += users[i]->query("name") + "	";
	}
	cslist += "\n";
	cslist += "大侠组：";
	for ( i = 1; i < sizeof(users); i+=2 )
	{
		cslist += users[i]->query("name") + "	";
	}
	cslist += "\n";
	message( "system", cslist, users() );
*/	
	log_file( "pkgame", sprintf("%s:共有%d人参加\n" , ctime(time()) , sizeof(users) ) );
	suserlist="参加者有:";
	for ( i = 0; i < sizeof(users); i++ )
	{
		suserlist+=users[i]->query("name")+"  ";
	}
	suserlist+="\n";
	log_file( "pkgame", suserlist);

	users = ({});
	tUsers = ({});
	ctUsers = ({});
	message( "system", HIR"\n\n【"+HIY"太白金星"+HIR"】： CS大赛正式开始！\n\n" NOR, users() );
	ob->set("no_baoming",1);
	ob->delete("start_baoming");	
	call_out("wait_start",3);
	return;
}

void wait_start()
{
	"/cmds/usr/pkgame"->main(0,"start");
}
/******************************************************************************
todo:
	User按score排序回调函数。
******************************************************************************/
int compare_score(object ob1, object ob2)
{
    int score1,score2;

    score1 = "/cmds/usr/top"->get_score(ob1);
    score2 = "/cmds/usr/top"->get_score(ob2);

    return score2 - score1;
}

/******************************************************************************
todo:
	返回参赛者名单。
******************************************************************************/
int dn()
{
	int i;
	write("参赛者：\n");
	for ( i = 0; i < sizeof(users); i++ )
	{
		write(users[i]->query("name")+"	");
	}
	write("\n");
	return 1;
}		
	
/******************************************************************************
todo:
	cs游戏结束，清除内部变量。
******************************************************************************/
void end_game() {
	ob->delete("end_baoming");
	ob->delete("start_baoming");
}

void restart()
{
	ob->delete("no_baoming");
}

string end_time()
{
	string cStatus ;
	cStatus = chinese_number ( 180 - ( time() - ob->query("End_Time") )/ 60  ) ;
	if ( !cStatus ) return "ＣＳ系统出现数据问题，请通知"+BLINK HIY"九天(take)。\n"NOR;
	cStatus = "比赛刚结束，你等"BLINK HIY+cStatus+NOR"分钟再来吧。\n";
	return cStatus;
}
object *query_list()
{
return users;
}


int do_answer(string arg)
{
   object baoshi,who,me;
   int i,j,k,times,result;
   who = this_player();

   if ( ob->query("no_baoming")) return notify_fail("这次ＣＳ大赛已经停止报名。\n");
      if( !arg )  return notify_fail("回答格式错误，请重新回答！\n");
   if(sscanf(arg, "%d",result)!=1) return notify_fail("回答格式错误，请重新回答！\n");

   i=who->query_temp("cstrig/result");
   if(i==0)
   	return notify_fail("你目前没有任何问题！\n");	
   if(result!=i)
   {
	who->delete_temp("cstrig/result");
    	return notify_fail("连这个都算不出来，你还好意思报名？\n");
   }   
   else
   {

	// 判断是否重复报名或者同ip 同port 报名
	for ( i = 0; i < sizeof(users); i++ )
	{
		if ( users[i] == who ) return notify_fail("你不是来报过名了吗？\n");
//               if ( query_ip_number(users[i]) == query_ip_number(who)) 
  //                     return notify_fail("你不能同时开两个或两个以上id参加比赛。\n");
	}
	if(!CheckUser(who->query("id"),query_ip_number(who)))	
        	return notify_fail("你不能同时开两个或两个以上id参加比赛。\n");
	
	// Add this new user
	users += ({ who });
	who->set_temp("csip",query_ip_number(who));
	message( "chat", HIC"【"+HIY"太白金星"+HIC"】： "HIC+who->query("family/family_name")+HIY""+who->query("name")+HIC"报名参加ＣＳ大赛。\n" NOR, users() );
	who->set_temp("pkgame",1);
	this_player()->delete_temp("cstrig");
	return 	1;
   }
   return 1;
}

int CheckUser(string who,string ip)
{
  if (undefinedp(quest_ip[ip]))
  {
    quest_ip[ip] = ({ who });
    return 1;
  }
	return 0;
  if (member_array(who, quest_ip[ip]) != -1)
    return 1;
  
    quest_ip[ip] -= ({ 0 });

   if (sizeof(quest_ip[ip]) >= MAX_QUESTS)
  {
//    tell_object(who, "你的ip领取手动奖励的id数量超过最大限制！\n");
    return 0;
  }

  quest_ip[ip] += ({ who });
  return 1;

}

nomask mapping query_entire_list()
{
	return quest_ip;
}

string query_stime(int time)
{
        string msg;
        int day, hour, min;
        
        time=time()-time;
        time=CsCdTime-time;
        msg="";
        day=time/86400;
        hour=(time%86400)/3600;
        min=(time/60)%60;

        if(min<1)
                min=1;
        if(day)
                msg+=sprintf("%s天", chinese_number(day));
        if(day<10 && hour)
                msg+=sprintf("%s小时", chinese_number(hour));
        if(!day && hour<20 && min )
                msg+=sprintf("%s分", chinese_number(min));

        return msg;
}
