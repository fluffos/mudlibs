#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HIR "CS休息室" NOR);
  set("long", @long
  
  这里是ｃｓ大赛的休息室，大赛选手可以使用hp,skills,score,
指令察看自己的状态，以及使用chat聊天，如果需要武器和装备可
以使用list,yao指令索取自己需要的武器和装备。

long);

  set("exits", ([ /* sizeof() == 2 */

  ]));
  set("no_fight", 1);
  set("outdoors", 1);
  setup();
}

void init() {
  object ob;
  ob = this_player();
  add_action("mysnoop", "guanzhan");
  add_action("block_cmd", "", 1);
  call_out("greeting", 2, ob);
}

int block_cmd(string args) {
  string verb, a, b;
  verb = query_verb();
  if ((verb == "chat") || (verb == "chat*") || (verb == "score") || (verb == "hp") || (verb == "cs") || (verb == "pkgame") || (verb == "guanzhan") || (wizardp(this_player()))) return 0;
  return 1;
}

void greeting(object ob) {
  if (!ob || !userp(ob)) return;
  if (present("corpse"))
    destruct(present("corpse"));
  ob->set("eff_kee", ob->query("max_kee"));
  ob->set("eff_sen", ob->query("max_sen"));
  ob->set("kee", ob->query("max_kee"));
  ob->set("sen", ob->query("max_sen"));
  ob->set("force", ob->query("max_force"));
  ob->set("mana", ob->query("max_mana"));
}


int mysnoop(string arg) {
  object ob, me;
  me = this_player();

  if (!arg) {
    if (objectp(ob = query_snooping(me)))
      write("你现在正在监视" + ob->query("name") + "所收到的讯息。\n");
    return 1;
  } else if (arg == "-none") {
    if (objectp(ob = query_snooping(me)) && wizardp(ob) && wiz_level(me) <= wiz_level(ob))
      tell_object(ob, HIW + me->name(1) +
        "停止监听你所收到的讯息。\n" NOR);
    snoop(me);
    write("Ok.\n");
    return 1;
  } else if (query_snooping(me)) snoop(me);

  ob = find_player(arg);
  if (!ob) ob = find_living(arg);

  if (!ob) ob = LOGIN_D->find_body(arg);
  /* added by mon. 2/23/97 */

  if (!ob || !me->visible(ob)) return notify_fail("没有这个人。\n");

  if (me->query_temp("pkgame") && (me->query_temp("pkgame") != ob->query_temp("pkgame")))
    return notify_fail("你没有监听" + ob->name() + "所收听讯息的权利。\n");
  if (!interactive(ob)) return notify_fail("他已经断线了。\n");
  if (me == ob) return notify_fail("请用 snoop -none 解除监听。\n");

  snoop(me, ob);

  me->set_temp("snoop_encoding",
    (int)me->query_encoding() * 10 + ob->query_encoding());
  // added by mon 6/1/98

  write("你现在开始窃听" + ob->name(1) + "所收到的讯息。\n");
  tell_object(ob, HIW + me->name(1) + "开始监听你所收到的讯息。\n" + NOR);

  return 1;
}
