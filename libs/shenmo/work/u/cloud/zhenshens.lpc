                if( time()<me->query_temp("cmds_zhaohuan_weapon")+300 )
                        return notify_fail("你刚刚召唤过。\n");
                strs = keys(data);
                i = sizeof(strs);
                me->start_busy(1);
                j = 0;
                tmp = "";
                for(i=0;i<sizeof(strs);i++)
                {
                        flag = 0;       
                        str = strs[i];
                        if( !str || !stringp(str) )
                                continue;
                        ob = new("/obj/weapon");
                        if( !ob )      continue;
                        if( !ob->move(me) )
                        {
                                destruct(ob);
                                continue;
                        }       
                        ob->set("owner_id",me->query("id"));
                        ob->set("skill_type",data[str][1]);
                        ob->set_name(ob->name(),({str}));
                        if( !ob->restore() )
                        {
                                if( file_size(ob->query_save_file()+".o")<=0 )
                                        me->delete("new_item/"+str);                      
                                destruct(ob);
                                continue;
                        }       
                        inv = all_inventory(me);
                        for(k=0;k<sizeof(inv);k++)
                        {
                                if( inv[k] && inv[k]!=ob 
                                && inv[k]->name()==ob->name()
                                && inv[k]->query("skill_type")==ob->query("skill_type") 
                                && inv[k]->query("id")==ob->query("id") )
                                {
                                        flag++; 
                                        break;
                                }
                        }
                        if( flag>0 )   
                        {
                                destruct(ob);
                                continue;
                        }
                        else    
                        {
                                j++;
                                tmp+= ob->name()+" ";
                        }
                }
                if( j>0 )
                {               
                        me->set_temp("cmds_zhaohuan_weapon",time());
                        message_vision("$N成功召唤了 "+tmp+" 。\n",me);
                }
        write("OK.\n"); 
        return 1;       
        }        
        
