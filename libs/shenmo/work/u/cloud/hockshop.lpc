int cleanobj(int num)
{
	int i,j,n;
string *items;

if(!sizeof(pawned_objects))
     return notify_fail("当铺目前没有任何货物可卖。\n");
      
items = keys(pawned_objects);
n = sizeof(items);
j=0;
for(i=0;i<n;i++)
{
	if(pawned_objects[items[i]] <num)
	{
		write(items[i]+"  \n");			
		map_delete(pawned_objects,items[i]);	
	}
}

return 1;
}

int do_go(string arg)
{
        object ob=this_player();
if( !arg )
return notify_fail("你要去哪里？\n");
if( this_player()->is_busy() )
  return notify_fail("你现在正忙着呢。\n");
        if( arg=="tianzhu" )   {
          ob->move("/d/qujing/tianzhu/dangpu");
        }
        else
         {
            if( arg=="kaifeng" )   {
              ob->move("/d/kaifeng/dangpu");
            }
               else {
                 if( arg=="changan" )   {
                 ob->move("/d/city/dangpu");
                 }
                 else return notify_fail("你要去哪里？\n");
     }}
     return 1;
}
