//pansi妖怪
//huarong 2003

#include <ansi.h>
inherit __DIR__"guai.lpc";

void set_skills(int max_value, int level)
{
       int guai_value;
       ::set_skills(max_value, level);
        
        if (level==1) guai_value = max_value+max_value/8;
        else if (level==2) guai_value = max_value+max_value/6;
        else guai_value = max_value+max_value/4;
        
        set_skill("jiuyin-xinjing", guai_value+random(16));
        set_skill("yinsuo-jinling", guai_value+random(16));
        set_skill("qingxia-jian", guai_value+random(16));
        set_skill("chixin-jian", guai_value+random(16));
        set_skill("yueying-wubu", guai_value+random(16));
        set_skill("force", guai_value+random(16));
        set_skill("unarmed", guai_value+random(16));
        set_skill("dodge", guai_value+random(16));
        set_skill("spells", guai_value+random(16));
        set_skill("lanhua-shou", guai_value+random(16));
        set_skill("pansi-dafa", guai_value+random(16));
        set_skill("sanban-axe", guai_value+random(16));
        set_skill("qin", guai_value+random(16));
        set_skill("literate", guai_value+random(16));
        map_skill("spells", "pansi-dafa");
        map_skill("force", "jiuyin-xinjing");
        map_skill("unarmed", "lanhua-shou");
        map_skill("sword", "chixin-jian");
        map_skill("whip", "yinsuo-jinling");
        map_skill("parry", "chixin-jian");
        map_skill("dodge", "yueying-wubu");
        set("force_factor", query_skill("force")/2);
        set("mana_factor", query_skill("spells",1));
        create_family("盘丝洞",2 , "弟子");
        set("title",HIW"白发琴魔"NOR);
        set("chat_chance_combat", 70);
        set("chat_msg_combat", ({
        (: perform_action,"sword", "haotan" :),
        (: perform_action,"sword", "hongyan" :),
        }) );
        carry_object("/d/pansi/obj/qin.lpc");
        carry_object("/d/obj/armor/jinjia.lpc")->wear();
        carry_object("/d/obj/weapon/sword/zhujian.lpc")->wield();
}
