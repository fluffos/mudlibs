#include <ansi.h>
inherit NPC;
string ask_class(object me);
int ask_human();
int ask_xian();
int ask_yao();

void create()
{
      	set_name(HIC"青衣大神"NOR,({"da shen","shen","tian shen"}));
	set("title",HIR"梦幻至尊"NOR);
	set("long",
		"\n这是一个表情严肃的中年男人,一脸凝重。\n"
	      "他就是梦幻西游的至尊,专门负责对玩家进行更换种族。\n");
	set("gender","男性");
	set("age",21);
	set("per",40);
	set("str",30);
	set("int",40);
	set("attitude", "friendly");
	
	set("max_kee",10000);
	set("kee",10000);
	set("max_sen",10000);
	set("sen",10000);
	set("max_force",50000);
	set("force",50000);
	set("max_mana",50000);
	set("mana",50000);
	set("combat_exp",100000000);
      set("daoxing",100000000);
      set("force_factor", 200);
      set("mana_factor", 200);
	set_skill("blade",500);
	set_skill("dodge",500);
	set_skill("parry",500);
	set_skill("unarmed",500);
	set_skill("dragonfight",500);
	set_skill("kugu-blade",500);
	map_skill("dodge","kugu-blade");
	map_skill("parry","kugu-blade");
	map_skill("blade","kugu-blade");
	map_skill("unarmed","dragonfight");
	set("inquiry", ([
		"人族":(: ask_human :),
		"仙族":(: ask_xian :),
		"妖族":(: ask_yao :),
            "三族" : (: ask_class :),
		]) );
      set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
		"\n云飞扬摇头叹道：螳臂当车，不自量力。唉，你这又是何苦呢?\n",
		(: command("smile") :),
		(: command("haha") :),
		(: command("chat 这位" + RANK_D->query_respect(this_player())+",你我无冤无仇，何必如此?\n") :),		
(: perform_action, "blade.pozhan" :),
(: perform_action, "blade.kugu" :),
                (: exert_function, "recover" :),                          
	}) );
	setup();
}
string ask_class(object me)
{
	me=this_player();
	return "\n仙、人、妖三系为普通系别，它们交相克制。\n"
		"其中仙克人，人克妖，妖克仙，都是一转之前可以拜的门派。\n"
		"且同系之间的门派如果叛师，一些厉害的外功仍然有效。\n";

}

void init()
{
  add_action("do_human", "human");
  add_action("do_xian", "xian");
  add_action("do_yao","yao");
}


int ask_human()
{        
	object me=this_player();
      if (me->query("ask_class")>=1){
	command("shake " + me->query("id"));
	tell_object(me,"你已经没有机会了? \n");
	return 1;
	}
      else {
        command("say 你确定要加入人族吗？考虑清楚的话请输入（human），你只有一次决定命运的机会哦！\n");
        me->set_temp("ask_human", 1);
            }
        return 1;
}

int ask_xian()
{        
	object me=this_player();
      if (me->query("ask_class")>=1){
	command("shake " + me->query("id"));
	tell_object(me,"你已经没有机会了? \n");
	return 1;
	}
      else {
        command("say 你确定要加入仙族吗？考虑清楚的话请输入（xian），你只有一次决定命运的机会哦！\n");
        me->set_temp("ask_xian", 1);
            }
        return 1;
}

int ask_yao()
{        
	object me=this_player();
      if (me->query("ask_class")>=1){
	command("shake " + me->query("id"));
	tell_object(me,"你已经没有机会了? \n");
	return 1;
	}
      else {
        command("say 你确定要加入妖族吗？考虑清楚的话请输入（yao），你只有一次决定命运的机会哦！\n");
        me->set_temp("ask_yao", 1);
            }
        return 1;
}

int do_human(string arg)
{
        if(this_player()->query_temp("ask_human")) {
                message_vision("$N答道：我愿意加入人族。\n\n", this_player());
                this_player()->add("ask_class", 1);
	          this_player()->set("class","human");
                this_player()->set("classxt","human");
                this_player()->delete_temp("ask_human");
                this_player()->save();
                command("say 欢迎你加入人族！\n");
                return 1;
                }
        return 0;
}

int do_xian(string arg)
{
        if(this_player()->query_temp("ask_xian")) {
                message_vision("$N答道：我愿意加入仙族。\n\n", this_player());
                this_player()->add("ask_class", 1);
	          this_player()->set("class","xian");
                this_player()->set("classxt","xian");
                this_player()->delete_temp("ask_xian");
                this_player()->save();
                command("say 欢迎你加入仙族！\n");
                return 1;
                }
        return 0;
}

int do_yao(string arg)
{
        if(this_player()->query_temp("ask_yao")) {
                message_vision("$N答道：我愿意加入妖族。\n\n", this_player());
                this_player()->add("ask_class", 1);
	          this_player()->set("class","yao");
                this_player()->set("classxt","yao");
                this_player()->delete_temp("ask_yao");
                this_player()->save();
                command("say 欢迎你加入妖族！\n");
                return 1;
                }
        return 0;
}




   
