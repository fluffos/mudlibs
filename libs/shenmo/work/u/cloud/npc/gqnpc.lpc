inherit NPC;
#include <ansi.h>
int give_gift();
void create() {
  set_name(HIC "神州七号" NOR, ({ "china seven", "man" }));
  set("age", 18 + random(10));
  set("gender", "男性");
  set("title", HIR "发射成功啦" NOR);
  set("long", HIM "\n\n这位就是由云飞扬大人深夜赶着写出来的礼物使者。\n" NOR);
  set("attitude", "peaceful");
  set("str", 50);
  set("kar", 50);
  set("per", 99);
  set("combat_exp", 200000000);
  set("daoxing", 200000000);
  set("max_force", 200000);
  set("max_mana", 200000);
  set("max_kee", 40000);
  set("max_sen", 40000);
  set("force", 400000);
  set("force_factor", 1000);
  set("mana_factor", 1000);
  set("mana", 400000);
  set_skill("unarmed", 1000);
  set_skill("dodge", 1000);
  set_skill("parry", 1000);
  set("inquiry", ([
    "gift": (: give_gift :),
    "礼物": (: give_gift :),
    "国庆节": (: give_gift :),
  ]));
  setup();
}
int give_gift() {
  object me;
  string str;
  int exp, wxreward, dxreward, qnreward;
  me = this_player();
  exp = me->query("combat_exp") + me->query("daoxing");
  if (!me) return 0;
  if (me->query("huarong/国庆") == "2008") {
    message_vision("\n神州七号疑惑的看着你道：你不是又想来混一份礼物吧？\n\n" NOR, me);
    this_object()->command("hammer " + me->query("id"));
    return 1;
  }
  if (me->query("combat_exp") <= 100000) {
    write("你的修行太低了，还是先去锻炼一下再来吧!\n");
    return 1;
  }
  me->set("huarong/国庆", "2008");
  if (me->query("combat_exp") <= 1000000) {
    qnreward = 50000;
    wxreward = 100000;
    dxreward = 100000;
  } else if (me->query("combat_exp") <= 5000000) {
    qnreward = 100000;
    wxreward = 150000;
    dxreward = 150000;
  } else if (me->query("combat_exp") <= 10000000) {
    qnreward = 100000;
    wxreward = 200000;
    dxreward = 200000;
  } else if (me->query("combat_exp") <= 30000000) {
    qnreward = 150000;
    wxreward = 250000;
    dxreward = 250000;
    call_out("gift", 2);
  } else if (me->query("combat_exp") <= 50000000) {
    qnreward = 200000;
    wxreward = 300000;
    dxreward = 300000;
    call_out("gift", 2);
  } else {
    qnreward = 250000;
    wxreward = 300000;
    dxreward = 300000;
    call_out("gift", 2);
  }
  message_vision("\n神州七号拱手贺道：十一国庆节快乐！\n" NOR, me);
  write(HIY "在2008年国庆节到来之际，你得到梦幻西游巫师组的祝福。\n" NOR);
  str = HIW + me->name() + HIM + "得到了国庆大礼！" NOR;
  message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());
  me->add("combat_exp", wxreward);
  me->add("daoxing", dxreward);
  me->add("potential", qnreward);
  me->add("level", 3);
  write(HIC "你突然感觉自己的等级又有所提升了!\n" NOR);
  return 1;
}

void gift() {
  object me = this_player();
  object bone;
  bone = new("/quest/lianhua/hebing_1");
  bone->move(me);
  tell_object(me, HIR "你得到了一块佛骨!\n" NOR);
  me->add("xtqj/haomao", 3);
  me->add_temp("bonustime", 400);
  me->add_temp("bonus", 30);
  tell_object(me, HIR "恭喜你得到了游戏经验增加30%的额外奖励!\n" NOR);
  write(HIC + "\n你有幸得到了梦幻西游巫师组赐予的三根" + HIY + BLINK + "救命毫毛" + NOR + HIC + "。\n\n" NOR);
}
