
#include <ansi.h>
#include <command.h>
string change_rename(object me);
int do_change(string arg,object me);
int accept_object(object me, object ob);

inherit NPC;
void create()
{
        set_name(HIR"武器大使"NOR,({ "wuqi dashi","wuqi","dashi" }));
        set("gender", "男性" );
        set("per", 30);
        set("age", 63);
        set("title", HIW"梦幻西游"NOR);
        set("long",
        HIC"他就是梦幻天朝武器大使,据说是干将莫邪的后代，铸造能力神奇无比，几可称的上天下第一。\n"NOR);
        set("combat_exp", 2000000);
        set("attitude", "friendly");
        set("inquiry", ([
            "修改武器名字": (: change_rename :),
            "武器类型转换":  "你可以用(huan xxx)命令来改变武器的形态！",
            "第一次":  "第一次修改只要200两黄金，绝对便宜！",
            "太贵了":  "没钱！！！滚一边去！",
        ]) );
        set("chat_msg",({
            "武器大使高兴说道:哈哈，又有人来改名？\n",
        }));
        setup();
}

void init()
{
        object ob,me;
        add_action("do_change","change");
        add_action("do_huan","huan");
}

int do_huan(string arg)
{
	string type;
	object ob;
	object me=this_player();

       if((!(int)me->query("weapon/make")) )
        {
            return notify_fail("武器大使一脸生气：你没有自造武器，换什么换？\n");      
        }
        if ( (int)me->query("weapon/lv") <89 )
             return notify_fail("你的武器暂时还不能转换。\n");     
       if (!arg)
		return notify_fail("你想要把兵器转化为什么类型？(比如:huan sword)\n");
	else 
	{
		sscanf(arg,"%s",type);
			switch(type)
			{
case "sword":
                         if(!(int)me->query("po_sword/done") ){
                        return notify_fail("武器大使一脸生气：你还没有得到剑魄，换什么换？\n");      
                        }else
                         me->set("weapon/type","剑");
			    write(WHT"很好！你成功地转换了武器类型,请重新zhaohuan你的武器。目前你的武器类型为剑的形态。\n"NOR); 
                         break;
case "blade":
                         if(!(int)me->query("po_blade/done") ){
                         return notify_fail("武器大使一脸生气：你还没有得到刀魄，换什么换？\n");      
                         }else
                         me->set("weapon/type","刀");
			    write(WHT"很好！你成功地转换了武器类型,请重新zhaohuan你的武器。目前你的武器类型为刀的形态。\n"NOR); 
                         break;
case "staff":
                         if(!(int)me->query("po_staff/done") ){
                         return notify_fail("武器大使一脸生气：你还没有得到杖魄，换什么换？\n");      
                         }else
                         me->set("weapon/type","杖");
			    write(WHT"很好！你成功地转换了武器类型,请重新zhaohuan你的武器。目前你的武器类型为杖的形态。\n"NOR); 
                         break;
case "whip":
                         if(!(int)me->query("po_whip/done") ){
                         return notify_fail("武器大使一脸生气：你还没有得到鞭魄，换什么换？\n");      
                         }else
                         me->set("weapon/type","鞭");
			    write(WHT"很好！你成功地转换了武器类型,请重新zhaohuan你的武器。目前你的武器类型为鞭的形态。\n"NOR); 
                         break;
case "stick":
                         if(!(int)me->query("po_stick/done") ){
                         return notify_fail("武器大使一脸生气：你还没有得到棍魄，换什么换？\n");      
                         }else
                         me->set("weapon/type","棍");
			    write(WHT"很好！你成功地转换了武器类型,请重新zhaohuan你的武器。目前你的武器类型为棍的形态。\n"NOR); 
                         break;
case "mace":
                         if(!(int)me->query("po_mace/done") ){
                         return notify_fail("武器大使一脸生气：你还没有得到锏魄，换什么换？\n");      
                         }else
                         me->set("weapon/type","锏");
			    write(WHT"很好！你成功地转换了武器类型,请重新zhaohuan你的武器。目前你的武器类型为锏的形态。\n"NOR); 
                         break;
case "hammer":
                         if(!(int)me->query("po_hammer/done") ){
                         return notify_fail("武器大使一脸生气：你还没有得到锤魄，换什么换？\n");      
                         }else
                         me->set("weapon/type","锤");
			    write(WHT"很好！你成功地转换了武器类型,请重新zhaohuan你的武器。目前你的武器类型为锤的形态。\n"NOR); 
                         break;
case "fork":
                         if(!(int)me->query("po_fork/done") ){
                         return notify_fail("武器大使一脸生气：你还没有得到叉魄，换什么换？\n");      
                         }else
                         me->set("weapon/type","叉");
			    write(WHT"很好！你成功地转换了武器类型,请重新zhaohuan你的武器。目前你的武器类型为叉的形态。\n"NOR); 
                         break;
case "axe":
                         if(!(int)me->query("po_axe/done") ){
                         return notify_fail("武器大使一脸生气：你还没有得到斧魄，换什么换？\n");      
                         }else
                         me->set("weapon/type","斧");
			    write(WHT"很好！你成功地转换了武器类型,请重新zhaohuan你的武器。目前你的武器类型为斧的形态。\n"NOR); 
                         break;
case "spear":
                         if(!(int)me->query("po_spear/done") ){
                         return notify_fail("武器大使一脸生气：你还没有得到枪魄，换什么换？\n");      
                         }else
                         me->set("weapon/type","枪");
			    write(WHT"很好！你成功地转换了武器类型,请重新zhaohuan你的武器。目前你的武器类型为枪的形态。\n"NOR); 
                         break;

case "hand":
                         if(!(int)me->query("po_hand/done") ){
                         return notify_fail("武器大使一脸生气：你还没有得到拳魄，换什么换？\n");      
                         }else
                         me->set("weapon/type","拳");
			    write(WHT"很好！你成功地转换了武器类型,请重新zhaohuan你的武器。目前你的武器类型为拳的形态。\n"NOR); 
                         break;
			}
	}
return 1;

}

int accept_object(object me, object ob)
{
       int i,p;
       i=(int)me->query("markss/name_times");
       p=i*i;
    if ( !me->query_temp("markss/ask_change"))
              {
       command("?");
       return notify_fail(HIB"给我钱干吗?嘿嘿！！\n"NOR);
              }
        if( ob->query("money_id") && ob->value() >= p*1000000)
        {
        command("nod");
        command("say 好吧，"+me->query("name")+"你可以用"HIR"(change 武器名字 英文代号)"NOR",来修改你的武器名字<不要加颜色>！\n");
        me->delete_temp("markss/ask_change");
        me->set_temp("markss/change_rename",1);
        return 1;
        }
        else {
        command("heng");
        command("say 嘿嘿，"+me->query("name")+"你倒大胆，敢戏耍本大使！\n");
        return 1;
        }
}
int do_change(string arg,object me)
{
        string id,w_name;
        int i;
        me = this_player();

        if(!(int)me->query_temp("markss/change_rename"))
        {
            return notify_fail("大使嘿嘿冷笑道:闹事不成？\n");
        }

        if((!(int)me->query("weapon/make")) )
        {
            return notify_fail("武器大使一脸生气：你没有自造武器，还来干什么？\n");      
        }

        if( !arg )
                return notify_fail("武器大使认真的说：想好武器的名称及代号后在对我说。\n");

        sscanf(arg ,"%s %s" ,w_name ,id);

        if(!w_name||!id)
                return notify_fail("什么?(使用 change 武器名字 英文代号\n)");
        i = strlen(id);
        while(i--) 
        {
        if( id[i]<'a' || id[i]>'z' )
                        return notify_fail("对不起，武器的英文代号只能用英文字母。\n");

        if( arg[i]<=' ' ) {
                        write("对不起，你的武器名字不能用控制字元。\n");
                        return 0;
                }

        if( (strlen(arg) < 2) || (strlen(arg) > 16 ) ) {
                write("对不起，你的武器名字必须是 1 到 6 个中文字。\n");
                return 0;
                }
        }
        me->set("weapon/name",w_name);  //武器的名称
        me->set("weapon/id",id);                
        me->delete_temp("markss/change_rename");
        me->add("markss/rename_times",1);
        write(WHT"很好！你成功地修改了武器名字,请重新zhaohuan你的武器。目前你已经修改了"+(int)me->query("markss/rename_times")+"次名字。\n"NOR); 
        return 1;
}
string change_rename(object me)
{
   int p,i;
  me=this_player();   
  if ( me->query_temp("markss/change_rename"))
        {
      command("?");
            return HIC"钱也交了，快报上你要改动的名字，我给改就是了！\n"NOR;
         }
    if ( me->query_temp("markss/ask_change"))
        {
      command("?");
            return HIG"快交"NOR+HIR"钱"NOR+HIG"就是了，问这么多遍干吗？\n"NOR;
        }
    if ( !me->query("markss/rename_times",1))
        {
      command("hoho");
      command("say 第一次是吧....，交200gold就行了！！");
        }
else {
              i=(int)me->query("markss/rename_times");
              p=i*i*100;
              p=p+100;
        message_vision(HIR"武器大使哼了一声,你这次改动我看至少也得"NOR+p+HIR" gold才行\n"NOR,me);
          }
        me->set_temp("markss/ask_change",1);
        return HIB"我马上又要小发一笔不成。。。"NOR+"（武器大使暗暗地笑了起来）";
}

