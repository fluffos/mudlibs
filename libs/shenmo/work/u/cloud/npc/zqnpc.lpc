inherit NPC;
#include <ansi.h>
int give_gift();
void create() {
  set_name(HIC "嫦娥仙子" NOR, ({ "chang e", "chang", "e" }));
  set("age", 18 + random(10));
  set("gender", "女性");
  set("title", HIR "中秋礼物大使" NOR);
  set("long", HIM "\n\n这位就是由巫师大人玩了CS后回家深夜赶着写出来的礼物使者。\n" NOR);
  set("attitude", "peaceful");
  set("str", 50);
  set("kar", 50);
  set("per", 99);
  set("combat_exp", 200000000);
  set("daoxing", 200000000);
  set("max_force", 200000);
  set("max_mana", 200000);
  set("max_kee", 40000);
  set("max_sen", 40000);
  set("force", 400000);
  set("force_factor", 1000);
  set("mana_factor", 1000);
  set("mana", 400000);
  set_skill("unarmed", 1000);
  set_skill("dodge", 1000);
  set_skill("parry", 1000);
  set("inquiry", ([
    "gift": (: give_gift :),
    "礼物": (: give_gift :),
    "中秋": (: give_gift :),
  ]));
  setup();
}
int give_gift() {
  object me;
  string str;
  object obj = new("/u/cloud/gift/yuebing");
  int exp, wxreward, dxreward;
  me = this_player();
  exp = me->query("combat_exp") + me->query("daoxing");
  if (!me) return 0;
  if (me->query("huarong/中秋") == "2014") {
    message_vision("\n嫦娥仙子疑惑的看着你道：你不是又想来混一份礼物吧？\n\n" NOR, me);
    this_object()->command("hammer " + me->query("id"));
    return 1;
  }
  if (me->query("combat_exp") <= 100000) {
    write("你的修行太低了，还是先去锻炼一下再来吧!\n");
    return 1;
  }
  me->set("huarong/中秋", "2014");
  wxreward = me->query("combat_exp") / 50 > 250000 ? 250000 : me->query("combat_exp") / 50;
  dxreward = me->query("daoxing") / 50 > 250000 ? 250000 : me->query("daoxing") / 50;
  message_vision("\n嫦娥仙子拱手贺道：\n"
    +HIY + "海上明月共潮生，\n" + HIR + "千里相思随云去，\n" + HIB + "遥寄祝福千万缕，\n" + HIM + "化作清风入梦里。\n" + HIW + "中秋快乐！\n" NOR, me);
  write(HIY "在2014年中秋佳节到来之际，你得到梦幻西游巫师组的中秋祝福。\n" NOR);
  str = HIW + me->name() + HIM + "得到了中秋礼物，送上我们的祝福：" + HIY + "中秋佳节快乐，月圆人圆事事圆满！" NOR;
  message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());
  me->add("combat_exp", wxreward);
  me->add("daoxing", dxreward);
  me->add("potential", 500000);
  obj->move(me);

  return 1;
}
