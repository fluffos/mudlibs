inherit NPC;
#include <ansi.h>

//wx<100w
int QN1 = 100000;    
int WX1 = 100000;
int DX1 = 200000;
//wx<500w
int QN2 = 200000;    
int WX2 = 300000;
int DX2 = 300000;
//wx<1000w
int QN3 = 200000;    
int WX3 = 400000;
int DX3 = 400000;
//wx<3000w
int QN4 = 300000;    
int WX4 = 500000;
int DX4 = 500000;
//wx<5000w
int QN5 = 400000;    
int WX5 = 600000;
int DX5 = 600000;
//wx>5000w
int QN6 = 500000;    
int WX6 = 500000;
int DX6 = 600000;

string give_gift();
mixed give_po();

void create()
{
        set_name(HIC"补偿大使"NOR, ({ "da shi","dashi"}));
        set("age", 18+random(10));
        set("gender", "男性");
        set("title", HIR"梦幻西游"NOR);
        set("long",HIM"\n\n这位就是由云飞扬大人深夜赶着写出来的礼物使者。\n"NOR);
        set("attitude", "peaceful");
        set("inquiry",([
                "补偿": (: give_gift :),
                "神兵礼物" : (: give_po :),
        ]));
        setup();
}

mixed give_po()
{
	int i;
	mapping type,po;
	string str,*types,*my_type,gift;
	object me = this_player();
	
	if( me->query("giftmark/dj_po_gift") )
		return "你已经要过了。";
	if( !me->query("weapon/make") )
		return "你都无趁手的家伙，要来何用？！";
		
	if( !mapp(type=me->query("weapon/type"))
	 || sizeof(type)<1 )
	 	return "你的兵器好似有些问题，找找巫师。";

	if( !arrayp(my_type = keys(type)) 
	 || sizeof(my_type)<1 )
	 	return "你的兵器好似有些问题，找找巫师。";
		 
	po = ([
	//	"archery" : "弓",
		"axe"     : "斧",
		"blade"   : "刀",
		"fork"    : "叉",
	//	"halberd" : "戟",
		"hammer"  : "锤",
		"unarmed" : "拳", 
		"mace"    : "锏",
		"needle"  : "针",
	//	"qin"     : "琴",
		"rake"    : "耙",
		"spear"   : "枪",
		"staff"   : "杖",
		"stick"   : "棍",
		"sword"   : "剑",
	//	"throwing": "暗",
		"whip"    : "鞭",
	]);	
	 	
	//enable ?结果，酌情删减 
	types = ({
		"axe","blade","fork","sword",		         
            "hammer","unarmed","mace","needle",
		"rake","spear","staff","stick",
		"whip",
	});
	
	//减去自己已有的
	for(i=0;i<sizeof(my_type);i++)
		types-= ({my_type[i],});
            types-= ({0});
	if( sizeof(types)<1 )
		return "你好似都全了。";
	
	if( !stringp(gift=types[random(sizeof(types))]) )
		return "你好似都全了吧。";
	me->set("weapon/type/"+gift,1);
	me->set("giftmark/dj_po_gift",1);
	str = sprintf(HIY"神兵(Shen bing)：%s"NOR HIY"诚心见鉴日月，终于得到了"HIR"%s魄"HIY"！\n"NOR,
			me->query("name"),
                        po[gift]);
	message("channel:chat",HIY"【神兵传说】"+str,users());
	tell_object(me,HIG"你得到了"HIR+po[gift]+"魄"HIG"。"NOR"\n");
	return 1;
}

string give_gift()
{
        object me;
        string str,data,e_time,week,month,year;
        int day, hour, minute, second,wxreward,dxreward,qnreward;
        me=this_player();
        if(!me) 
                return 0;
        e_time = ctime(time());
        sscanf(e_time,"%s %s %d %d:%d:%d %s", week, month, day, hour, minute, second, year);
        if( wizardp(me) )
                write(sprintf("year=%s\n",year));
        data = year;                    
        if( me->query("cloud/2014补偿/"+data) )
        {
                me->add_temp("2014ask",1);
                if( me->query_temp("2014ask")>=3 )
                {
                        message_vision(HIR"$N"HIR"怒喝一声："+me->name()+"，"+RANK_D->query_rude(me)+"你敢小瞧补偿大使？！\n"NOR,this_object());
                        message_vision("\n$N高举双手大喝：去死吧！从天上降下一道闪电将$n化作一堆灰烬。\n",this_object(),me);
                        me->unconcious();
                        return 0;
                }
                return "你不是又想来混一份礼物吧，问多了小心我purge你!";
        }
        if( me->query("combat_exp")<=100000)
                return "你的修行太低了，还是先去锻炼一下再来吧!";

        me->set("cloud/2014补偿/"+data,1);
     
        if(  me->query("combat_exp") <=1000000)
        {
                qnreward=QN1;
                wxreward=WX1;
                dxreward=DX1;
        }
        else if(  me->query("combat_exp") <=5000000)
        {
                qnreward=QN2;
                wxreward=WX2;
                dxreward=DX2;
                call_out("gift",2);
        }
        else if(  me->query("combat_exp") <=10000000)
        {
                qnreward=QN3;
                wxreward=WX3;
                dxreward=DX3;
                call_out("gift",2);
        }
        else if(  me->query("combat_exp") <=30000000)
        {
                qnreward=QN4;
                wxreward=WX4;
                dxreward=DX4;
                call_out("gift",2);
        }
        else if(  me->query("combat_exp") <=50000000)
        {
                qnreward=QN5;
                wxreward=WX5;
                dxreward=DX5;
                call_out("gift",2);
        }
        else 
        {
                qnreward=QN6;
                wxreward=WX6;
                dxreward=DX6;
                call_out("gift",2);
        }
        write (HIY"由于前段时间频繁当机，你得到梦幻西游巫师组的补偿。\n"NOR);
        str = HIW+me->name()+HIM+"得到了2014年频繁当机补偿！"NOR;
        message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
        me->add("combat_exp",wxreward);
        me->add("daoxing",dxreward);
        me->add("potential",qnreward);
        me->add("level",3);
        write(HIC"你突然感觉自己的等级又有所提升了!\n"NOR);
        return "继续加油哦！";
}

void gift()
{
        string tmp,str;
        object me=this_player();
        object baoshi;
        baoshi=new("/quest/migong/bagua/obj/box.lpc");
        baoshi->set("level",1+random(5));
        baoshi->move(me);
        str = "你得到了一个"+baoshi->short()+"。\n";
        str = COLOR_D->clean_color(str);
        str = HIR+str+NOR;
        str = COLOR_D->replace_color(str,2);
        write(str);
        me->add("xtqj/haomao",3);
        write (HIC+"\n你有幸得到了梦幻西游巫师组赐予的三根"+HIY+BLINK+"救命毫毛"+NOR+HIC+"。\n\n"NOR);

        baoshi = new("/obj/armor");
        baoshi->move(me);
        str = "你得到了一件"+baoshi->short()+"。\n";
        str = COLOR_D->clean_color(str);
        str = HIR+str+NOR;
        str = COLOR_D->replace_color(str,2);
        write(str);
        

        baoshi = new("/quest/lianhua/hebing_1");
        baoshi->move(me);
        str = "你得到了一"+baoshi->query("unit")+baoshi->short()+"。\n";
        str = COLOR_D->clean_color(str);
        str = HIR+str+NOR;
        str = COLOR_D->replace_color(str,2);
        write(str);
}

void init()
{
        if( wizardp(this_player()) )
        {
                add_action("do_look","look");
                add_action("do_set","set");
        }
}

int do_look(string arg)
{
        string str;
        object me = this_player();
        str = HIY+@LONG
帮助命令
        set             查看当前设置
-----------------------------------------------------   
        set qn1 <数值>  设置武学<100w的潜能奖励
        set wx1 <数值>  设置武学<100w的武学奖励         
        set dx1 <数值>  设置武学<100w的道行奖励 
-----------------------------------------------------   
        set qn2 <数值>  设置武学<500w的潜能奖励
        set wx2 <数值>  设置武学<500w的武学奖励         
        set dx2 <数值>  设置武学<500w的道行奖励 
-----------------------------------------------------   
        set qn3 <数值>  设置武学<1000w的潜能奖励
        set wx3 <数值>  设置武学<1000w的武学奖励                
        set dx3 <数值>  设置武学<1000w的道行奖励        
-----------------------------------------------------   
        set qn4 <数值>  设置武学<3000w的潜能奖励
        set wx4 <数值>  设置武学<3000w的武学奖励                
        set dx4 <数值>  设置武学<3000w的道行奖励        
-----------------------------------------------------   
        set qn5 <数值>  设置武学<5000w的潜能奖励
        set wx5 <数值>  设置武学<5000w的武学奖励                
        set dx5 <数值>  设置武学<5000w的道行奖励        
-----------------------------------------------------   
        set qn6 <数值>  设置武学>5000w的潜能奖励
        set wx6 <数值>  设置武学>5000w的武学奖励                
        set dx6 <数值>  设置武学>5000w的道行奖励        
LONG+NOR;
        if( arg && id(arg) )
                me->start_more(str);    
        return 0;
}

string query_msg()
{
        string str;
        str = sprintf(HIC"武学<100万 的潜能奖励为 %d\n",QN1);
        str+= sprintf("武学<100万 的武学奖励为 %d\n",WX1);
        str+= sprintf("武学<100万 的道行奖励为 %d\n\n"NOR,DX1);
        
        str+= sprintf(HIW"武学<500万 的潜能奖励为 %d\n",QN2);
        str+= sprintf("武学<500万 的武学奖励为 %d\n",WX2);
        str+= sprintf("武学<500万 的道行奖励为 %d\n\n"NOR,DX2);
        
        str+= sprintf(HIC"武学<1000万 的潜能奖励为 %d\n",QN3);
        str+= sprintf("武学<1000万 的武学奖励为 %d\n",WX3);
        str+= sprintf("武学<1000万 的道行奖励为 %d\n\n"NOR,DX3);
        
        str+= sprintf(HIW"武学<3000万 的潜能奖励为 %d\n",QN4);
        str+= sprintf("武学<3000万 的武学奖励为 %d\n",WX4);
        str+= sprintf("武学<3000万 的道行奖励为 %d\n\n"NOR,DX4);
        
        str+= sprintf(HIC"武学<5000万 的潜能奖励为 %d\n",QN5);
        str+= sprintf("武学<5000万 的武学奖励为 %d\n",WX5);
        str+= sprintf("武学<5000万 的道行奖励为 %d\n\n"NOR,DX5);
        
        str+= sprintf(HIW"武学>1000万 的潜能奖励为 %d\n",QN6);
        str+= sprintf("武学>1000万 的武学奖励为 %d\n",WX6);
        str+= sprintf("武学>1000万 的道行奖励为 %d\n\n"NOR,DX6);

        return str;
}

int do_set(string arg)
{
        object me = this_player();
        int num;
        if( !arg || sscanf(arg,"%s %d",arg,num)!=2 )
        {
                me->start_more(query_msg());
                return 1;
        }
        if( num<=0 )
                return 0;
        switch(arg)
        {
                case "qn1" : QN1 = num;break;
                case "wx1" : WX1 = num;break;
                case "dx1" : DX1 = num;break;

                case "qn2" : QN2 = num;break;
                case "wx2" : WX2 = num;break;
                case "dx2" : DX2 = num;break;

                case "qn3" : QN3 = num;break;
                case "wx3" : WX3 = num;break;
                case "dx3" : DX3 = num;break;

                case "qn4" : QN4 = num;break;
                case "wx4" : WX4 = num;break;
                case "dx4" : DX4 = num;break;

                case "qn5" : QN5 = num;break;
                case "wx5" : WX5 = num;break;
                case "dx5" : DX5 = num;break;

                case "qn6" : QN6 = num;break;
                case "wx6" : WX6 = num;break;
                case "dx6" : DX6 = num;break;

                default : return 0;
        }
        write(HIR"设置完成。\n"NOR);    
        me->start_more(query_msg());                            
        return 1;
}
