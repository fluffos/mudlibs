#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "eat");
}
void create() {
  string *names = ({
    HIW "豆沙元宵" NOR,
    HIW "椰蓉元宵" NOR,
    HIW "荔枝元宵" NOR,
    HIG "蛋黄元宵" NOR,
    HIC "伍仁元宵" NOR,
    HIG "鲜肉元宵" NOR,
    YEL "凤梨酥元宵" NOR,
    HIB "樱桃元宵" NOR,
    HIG "草莓元宵" NOR,
    GRN "椒盐元宵" NOR,
    HIC "花生元宵" NOR,
    HIR "肉松元宵" NOR,
    HIY "五香元宵" NOR,
    HIG "栗子元宵" NOR,
    GRN "黑米元宵" NOR,
    HIC "香芋元宵" NOR,
    HIY "芝麻元宵" NOR,
  });
  int i = random(17) + 1;
  string str;
  set_name(names[random(sizeof(names))], ({ "yuan xiao", "yuanxiao" }));

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "粒");
    set("long", "巫师组给大家正月十五的礼物，快吃吧~!\n");
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  if (me->query("eaten_201515"))
    return notify_fail("吃得太多小心拉肚子啊！\n");

  me->add("combat_exp", 100000);
  me->add("potential", 50000);
  me->add("daoxing", 100000);
  me->add("xtqj/haomao", 3);
  me->add("level", 3);
  me->add("weapon/lv", 1);
  tell_object(me, HIR "全体巫师祝你节日快乐！\n");
  tell_object(me, HIC "你获得了10万武学，100年道行，5万潜能，毫毛加3，等级加3，武器等级加1的奖励。\n" NOR);
  me->set("eaten_200815", 1);
  call_out("des", 1);
  return 1;
}
void des() {
  destruct(this_object());
}
