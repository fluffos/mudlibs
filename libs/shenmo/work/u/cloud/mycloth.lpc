#include <ansi.h>
inherit F_CLEAN_UP;

int help(object me);
int main(object me, string arg) {
  object ob, *inv;
  string cloth_name, cloth_id;
  int i;

  if (me->query("ice/cloth") != "done")
    return notify_fail("你还未取得奥丁战袍。\n");

  if (me->query_temp("mycloth"))
    return notify_fail("你已经取得自己的奥丁战袍了。\n");

  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("id") == "odin cloth") return notify_fail("奥丁战袍就在你身上，你还召唤什么？！\n");
  }
  cloth_name = me->query("ice/cloth_name");
  if (!cloth_name) cloth_name = "奥丁战袍";
  cloth_name = HIW + cloth_name + NOR;
  cloth_id = me->query("ice/cloth_id");
  if (!cloth_id) cloth_id = "odin cloth";

  ob = new("/d/sds4/ice/obj/cloth");
  ob->set_name(cloth_name, ({ cloth_id }));
  ob->setup();
  ob->move(me);
  message_vision("$N大叫一声：“奥丁战袍～～～！！”，只见天空中出现了一件$n，准确的落在了$N身上！\n", me, ob);
  "/cmds/std/wear"->main(me, cloth_id);
  me->set_temp("mycloth", 1);

  return 1;

}

int help(object me) {
  write(@HELP
指令格式 : mycloth
 
如果你打过了圣斗士北欧篇，可以用这个命令召唤自己的奥丁战袍。 
 
HELP
  );
  return 1;
}
