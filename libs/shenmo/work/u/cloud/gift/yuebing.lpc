#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "eat");
}
void create() {
  string *names = ({
    HIW "豆沙月饼" NOR,
    HIW "椰蓉月饼" NOR,
    HIW "荔枝月饼" NOR,
    HIG "蛋黄月饼" NOR,
    HIC "伍仁月饼" NOR,
    HIG "鲜肉月饼" NOR,
    YEL "凤梨酥月饼" NOR,
    HIB "樱桃月饼" NOR,
    HIG "草莓月饼" NOR,
    GRN "椒盐月饼" NOR,
    HIC "花生月饼" NOR,
    HIR "肉松月饼" NOR,
    HIY "五香月饼" NOR,
    HIG "栗子月饼" NOR,
    GRN "哈密瓜月饼" NOR,
    HIC "香芋月饼" NOR,
    HIY "椒盐月饼" NOR,
  });
  int i = random(17) + 1;
  string str;
  set_name(names[random(sizeof(names))], ({ "yue bing", "bing" }));

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "梦幻西游巫师组给大家八月十五的礼物，快吃吧~!\n");
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  if (me->query("2014_815"))
    return notify_fail("吃得太多小心拉肚子啊！\n");

  me->add("combat_exp", 100000);
  me->add("potential", 50000);
  me->add("daoxing", 100000);
  me->add("xtqj/haomao", 3);
  me->add("level", 3);
  tell_object(me, HIR "梦幻西游全体巫师祝你节日快乐！\n");
  tell_object(me, HIC "你获得了10万武学，100年道行，5万潜能，毫毛加3，等级加3的奖励。\n" NOR);
  me->set("2014_815", 1);
  call_out("des", 1);
  return 1;
}
void des() {
  destruct(this_object());
}
