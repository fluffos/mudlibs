#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "eat");
}
void create() {
  string *names = ({
    HIW "豆沙粽子" NOR,
    HIW "椰蓉粽子" NOR,
    HIW "荔枝粽子" NOR,
    HIG "蛋黄粽子" NOR,
    HIC "伍仁粽子" NOR,
    HIG "鲜肉粽子" NOR,
    YEL "凤梨酥粽子" NOR,
    HIB "樱桃粽子" NOR,
    HIG "草莓粽子" NOR,
    GRN "椒盐粽子" NOR,
    HIC "花生粽子" NOR,
    HIR "肉松粽子" NOR,
    HIY "五香粽子" NOR,
    HIG "栗子粽子" NOR,
    GRN "哈密瓜粽子" NOR,
    HIC "香芋粽子" NOR,
    HIY "椒盐粽子" NOR,
  });
  int i = random(17) + 1;
  string str;
  set_name(names[random(sizeof(names))], ({ "zong zi", "zong" }));

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "梦幻西游巫师组给大家端午节的礼物，快吃吧~!\n");
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  if (me->query("2008gift_duanwu"))
    return notify_fail("吃得太多小心拉肚子啊！\n");

  me->add("combat_exp", 50000);
  me->add("potential", 50000);
  me->add("daoxing", 50000);
  me->add("xtqj/haomao", 1);
  me->add("level", 1);
  tell_object(me, HIR "梦幻西游全体巫师祝你节日快乐！\n");
  tell_object(me, HIC "你获得了5万武学，50年道行，5万潜能，毫毛加1，等级加1的奖励。\n" NOR);
  message_vision(HIG "$N吃着粽子，想起远古的屈原，更想起了远方的亲人。\n" NOR, me);
  me->set("2008gift_duanwu", 1);
  call_out("des", 1);
  return 1;
}
void des() {
  destruct(this_object());
}
