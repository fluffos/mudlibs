#include <ansi.h>
#include <armor.h>
inherit EQUIP; 
 
string *names=({ 
        HIY"静心莲花"NOR,"jingxin",HIR"缨络莲花"NOR,"yingluo",
        HIW"如意莲花"NOR,"ruyi",   HIG"九品青莲"NOR,"qinglian",
        HIY"金身莲花"NOR,"jinshen",HIW"金刚莲花"NOR,"jingang",
        WHT"孤禅莲花"NOR,"guchan", HIR"红日莲花"NOR,"hongri",
        RED"涅磐莲花"NOR,"niepan", HIY"宝轮莲花"NOR,"baolun",
        HIY"三塔莲花"NOR,"santa",  HIW"舍利莲花"NOR,"sheli",
});

mapping a_types = ([
        "heads"          : ({"顶","装备在头上遮风挡雨。",8,1000,"头盔",}),
        "necks"          : ({"串","戴在脖子上驱恶辟邪。",3,500,"项链"}),
        "cloths"         : ({"朵","穿在身上挡风御寒。",20,3000,"战袍",}),
        "armors"         : ({"抹","穿在身上抵挡刀箭。",40,5000,"盔甲",}),
        "surcoats"       : ({"朵","披在身后遮风挡雨。",25,2000,"披风",}),
        "waists"         : ({"串","佩在腰间驱恶辟邪。",5,1000,"腰带",}),
        "wristss"        : ({"串","戴在指间驱恶辟邪。",3,500,"护腕",}),
        "shields"        : ({"朵","拿中手中抵挡刀箭。",20,2500,"盾牌",}),
        "fingers"        : ({"朵","捏在指尖驱恶辟邪。",3,500,"指套",}),
        "bootss"         : ({"对","踩在脚下驱恶辟邪。",15,800,"鞋子",}),  

]);     

mapping t_msg = ([
          "kee"         :  HIG"增加气血"NOR,
          "eff_kee"     :  HIR"治疗气血"NOR,
          "sen"         :  HIM"增加精神"NOR,
          "eff_sen"     :  HIW"治疗精神"NOR,
          "force"       :  HIY"内力补充"NOR,
          "mana"        :  HIB"法力补充"NOR,
]);

string anong = "";
void jia_condition(object me);

void randomName()
{
        string name,id,*ids;
        int i = random(sizeof(names)/2)*2;
        name = names[i];
        id = names[i+1];
        ids = ({id,id+" lianhua","lianhua","hua"});
        this_object()->set_name(name,ids);
        setup();
}

void leave()
{
        remove_call_out("leave");
        if( environment() && environment()->query("id")==query("owner_id") )   
                return;
        write("\n"+this_object()->name()+HIY"化作一道金光冲天而去。\n\n"NOR);
        destruct(this_object());
}

void _leave()
{
        call_out("leave",2+random(5));
}               

int check_owner()
{
        object ob = this_object();
        object env = environment();
        if( !env || !userp(env) || (stringp(query("owner_id"))&&env->query("id")!=query("owner_id")) )
        {
                _leave();
                return 0;
        }
        return 1;
}

void init()
{
        if( !check_owner() )
                return;
        add_action("do_wear","wear");
        add_action("do_remove", "remove");
}

int err_msg(string arg)
{
        write(arg);
        return 1;
}

int do_wear (string arg)
{
        object me = this_player();
        object jia = this_object();
        string name = jia->query("name");
        string msg;

        if( !present(jia,me) )                         //不在身上 
                return 0;
        if( arg!="all" && !id(arg) )                   //不是穿此
                return 0;
        if( query("equipped") || query("use")==1 )     //已穿此
                return 0;
        if( me->query_temp("armor/"+jia->query("armor_type")) )        //同类型已穿
                return 0;

        msg = "$N背后现出一朵$n护住了$P的妙严肉身。\n";
        jia->set("wear_msg",msg);
        jia->set("use",1);
        remove_call_out("jia_condition");
        call_out("jia_condition",1,me);
        return 0;
}

int do_remove (string arg)
{
        object me = this_player();
        object jia = this_object();
        string msg;

        if( !present(jia,me) )
                return 0;
        if( arg!= "all" && !id(arg) )
                return 0;
        if( !query("equipped") || query("use")==0 )
                return 0;

        msg = "$N低诵我佛，$n随风碎成片片花瓣。\n"NOR;
        jia->set("unequip_msg",msg);
        jia->set("use",0);
        remove_call_out("jia_condition");
        return 0;
}

void lianhua_con(object me,string temp,int i)
{
        string msg="";
        object ob = this_object();      
        switch(temp)
        {
                case "kee" :            
                        if( me->query("kee")<me->query("eff_kee") )
                        {
                                msg+= "$n在$N身后隐隐约约摆动，$P脸色看起来好多了。\n";
                                me->receive_heal("kee",i);
                        }
                        break;
                case "sen" :
                        if( me->query("sen")<me->query("eff_sen") )
                        {
                                msg+= "$n在$N身后隐隐约约摆动，$P看起来清醒多了。\n"NOR;
                                me->receive_heal("sen",i);
                        }
                        break;                  
                case "eff_kee" :
                        if( me->query("eff_kee")<me->query("max_kee") )
                        {
                                msg+= "$n在$N身后隐隐约约摆动，$P气色看起来好多了。\n";
                                me->receive_curing("kee",i);
                        }
                        break;
                case "eff_sen" :
                        if( me->query("eff_sen")<me->query("max_sen") )
                        {
                                msg+= "$n在$N身后隐隐约约摆动，$P精神看起来好多了。\n";   
                                me->receive_curing("sen",i);
                        }
                        break;                  
                        
                case "force" :
                        if( me->query("force")/2<me->query("max_force") )
                        {
                                msg+= "$n在$N身后隐隐约约摆动，$P顿时觉得内力充沛起来。\n";
                                me->add("force",i);
                                if( me->query("force")/2>me->query("max_force") )
                                        me->set("force",(int)me->query("max_force")*2 );
                        }
                        break;
                case "mana" :
                        if( me->query("mana")/2<me->query("max_mana") )
                        {
                                msg+= "$n在$N身后隐隐约约摆动，$P顿时觉得法力充沛起来。\n";
                                me->add("mana",i);
                                if( (int)me->query("mana")/2>(int)me->query("max_mana") )
                                        me->set("mana",(int)me->query("max_mana")*2 );
                        }
                break;
        }       
        message_vision(msg,me,ob);
}
        
void jia_condition(object me)
{
        string msg;
        mixed temp;
        object ob = this_object();
        int k,i = ob->query("莲花/lvl"); 
        i*= 200;
        i = i/2+random(i/2); 

        if( !query("use") || !me )
                return;
        if( me->query_temp("armor/"+ob->query("armor_type"))!=ob )
        {
                ob->set("use",0);
                return;
        }
        temp = query("莲花/addType");
        if( !temp )
                return;
        if( stringp(temp) )
                lianhua_con(me,temp,i);
        else if( arrayp(temp) )
        {
                k = sizeof(temp);
                while(k--)
                        lianhua_con(me,temp[k],i);
        }
//        me->start_call_out( (: call_other, __FILE__, "jia_condition", me:),(2+random(4)) ) ;
        remove_call_out("jia_condition");
        call_out("jia_condition",2+random(4),me);
}

void check_long()
{
        string t_str;
        int k;
        mixed temp;     
        temp = query("莲花/addType");
        if( stringp(temp) )
                anong = t_msg[temp];
        else if( arrayp(temp) )
        {
                k = sizeof(temp);
                t_str = "";
                while(k--)
                {
                        t_str+= t_msg[temp[k]]+" ";
                        if( k )
                                t_str+="、";
                }
                anong = t_str;          
        }
}       

void setup() 
{
        string *a_t,type,long,unit;
        mixed temp;
        int p,we,i,k;     

//      "boots"         ：({"对","踩在脚下驱恶辟邪。",30,800}),  
        a_t = keys(a_types);
        type = a_t[random(sizeof(a_t))];
        unit = a_types[type][0];
        long = a_types[type][1];
        p = a_types[type][2];
        we = a_types[type][3];
        set("to_armor",a_types[type][4]);
        set("armor_type", type);
        set("unit",unit);
        set("莲花",([
                "lvl"           : 1+random(5),
                "addType"       : ({"kee","eff_kee","sen","eff_sen","force","mana"})[random(6)],
        ]));    
        set("long",HIC"一"+unit+"莲花，可以"+long+"\n"NOR);
        set_weight(we);
        set("armor_prop/base", p);
        p+= random(p/2);
        set("armor_prop/armor", p);
        check_long();
        i = query("莲花/lvl")*3;
        i = i/2+random(i);
}       

void create()
{
        randomName();
        set("material", "paper");
        set("value",0);
        set("no_get",1);
        set("no_put",1);
}


  string name()
{
        int i = query("莲花/lvl");
        string str;
        if( i<=5 )  str = YEL"平凡的"NOR;
        else if( i<=10 )  str = CYN"俗世的"NOR;
        else if( i<=20 )  str = HIW"长老的"NOR;
        else if( i<=50 )  str = HIY"脱俗的"NOR;
        else str = HIW"圣佛的"NOR;
        str+= ::name();
        if( query("莲花/合并")>0 )  
                str+= HIR"("+query("莲花/合并")+")"NOR;
        else    str+= HIR"(0)"NOR;
        return str;
}

string long()
{
        string str;
        if( query_temp("longs") )
                return query_temp("longs");
        check_long();   
        str = sprintf("这是一朵%s,相传为佛祖座下九品莲花一品所化，有缘者得之。\n",query("name"));
        str+= sprintf("莲花等级：%d\n莲花所属: %s\n佩戴位置：%s\n莲花防御: %d\n附加属性:\n\t%s\n",
                        query("莲花/lvl"),
                        query("owner_id")?query("owner_id"):"--",
                        query("to_armor"),
                        query("armor_prop/armor"),
                        stringp(anong)?anong:"--",
                );      
        set_temp("longs",str);          
        return str;
}
