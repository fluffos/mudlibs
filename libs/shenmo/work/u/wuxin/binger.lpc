  }
int do_c_backup(string arg)
{      
        string from,to;
        object me = this_player();
        if( !arg )
            return notify_fail("你要备份到哪个目录？\n");
        if ( !wizardp(me) )
            return notify_fail("冰儿在你脑袋上狠狠的敲了下去，“死妖怪，你想搞破坏啊！”\n"); 
        from = "/data";
        from = "/data";        to   = "/backup/"+arg; 
        ("/cmds/adm/adcp.lpc")->main(me,"-R /data "+to);
        write("你成功的将data文件备份到"+arg+"了！\n");
        return 1;
  }

int do_huifu(string arg)
{     
	string sdak,sbak;
        string from,from1,to,to1;
        object me = this_player();
        if( !arg )
            return notify_fail("你想要从哪天的备份恢复？\n");
        if ( !wizardp(me) )
            return notify_fail("冰儿在你脑袋上狠狠的敲了下去，“死妖怪，你想搞破坏啊！”\n");
        sdak = sprintf("/%c/%s",arg[0],arg);
        sbak = me->query_temp("huifu_temp"); 
        from = "/backup/"+sbak+"/user"+sdak+".o";
        from1 = "/backup/"+sbak+"/login"+sdak+".o";
        to   = "/data/user"+sdak+".o";
        to1  = "/data/login"+sdak+".o";
        cp(from,to);
        cp(from1,to1);
        write("你成功的将"+arg+"的user文件，从"+from+"恢复到"+to+"了！\n");
        write("你成功的将"+arg+"的user文件，从"+from1+"恢复到"+to1+"了！\n");
        write("你成功的恢复了"+arg+"的备份了！\n");
        return 1;
  }

int get_file_date (string date)
{       
	object me = this_player();
        if (date == "."||date=="") { write ("你放弃输入时间。\n"); return 1; }

                 else {  me->set_temp("huifu_temp",date);
                        }
         return 1;
 }  

int ask_auto_clear()
{
             this_object()->set("auto_clear",1);
             CHANNEL_D->do_channel( this_object(), "sys", "自动内存回收系统已经启动。\n");  
             call_out("auto_clear",1);
             return 1; 
     } 

int stop_auto_clear()
{  
             this_object()->set("auto_clear",0);
             CHANNEL_D->do_channel( this_object(), "sys", "自动内存回收系统已经停止。\n");  
             return 1;  
     } 

int auto_clear() 
{    
	  command("yeah");
          write("整理结果，共清除 " + reclaim_objects() + " 个变数。\n"); 
	  remove_call_out("auto_clear");
	  if (binger->query("auto_clear") == 1)
               { 
                call_out("auto_clear",600); 
                write("系统自动清除将在半个小时后开始!\n");
            	}
            else 
            return 0;
}

int ask_money()
{
              object me = this_player(); 
        if ( me->query("id")!="fengyun" )
                 return notify_fail("冰儿在你脑袋上狠狠的敲了下去，“死妖怪，你想搞破坏啊！”\n"); 
//     else me->add("c_balance_credit",10);
     else {me->set("jiayi_second",2);
              me->set("per",22);} 
                     write("冰儿道：“原来是无心大人啊，这就给你划账过去”!\n"); 
                 return 1; 
}

int ask_qujing()
{
                 object me = this_player();  
          me->delete("xiuluo/give_rulai"); 
        return 1;
}

int do_gift(string arg)
{ 
		string sdak;
    object ob,money,me = this_player();
        if( !arg )
            return notify_fail("你要给谁礼物？\n");
        if ( !wizardp(me) )
            return notify_fail("冰儿在你脑袋上狠狠的敲了下去，“死妖怪，你想搞破坏啊！”\n");
        ob = LOGIN_D->find_body(arg);
        if (!ob) return notify_fail("咦．．． 有这个人吗？\n");    
        tell_room(environment(ob),HIY"天空中一阵惊雷，一道闪电划破长空，隐约显现一个人影,\n"+
   (string)me->query("name")+"朝着"+(string)ob->query("name")+"轻轻一挥，一道霞光洒向"+(string)ob->query("name")+"。\n"NOR, ob);
        tell_object(ob,HIM"你感觉身上仿佛有奇妙的变化，你不由得摸了摸自己的口袋．．．\n"NOR); 
        money=new("obj/money/jinbi");
        money->set_amount(10);
        money->move(ob);
        write("你成功的给了"+ob->query("name")+"10个金币！\n");
        return 1;
}
