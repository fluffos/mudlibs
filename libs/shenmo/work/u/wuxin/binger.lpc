// modi by wuxin
#include <ansi.h> 
inherit NPC;  
int ask_auto_clear();
int stop_auto_clear();
int ask_money();
int ask_qujing();
object binger= this_object();   

string *name = ({ 
      "朱紫国", 
     }); 
void create() 
     { 
        set_name(HIW"冰儿"NOR, ({"bing er", "bing"}));
        set("title", "冰之精灵，我爱冰冰");
        set("gender", "女性");
        set("age", 18);
        set("long", "轻舞飞扬。\n");
        set("shen_type", 1); 
        set("str", 30);
        set("per", 100);
        set("con", 30);
        set("spi", 30);
        set("combat_exp", 200000);
	set("daoxing",200000);
        set_skill("force", 5000);
        set_skill("unarmed", 5000);
        set_skill("dodge", 5000);
        set_skill("parry", 5000);
        set("force", 20000);
        set("max_force", 20000);
        set("force_factor", 5);
        set("inquiry", ([
        "自动清除内存":   (: ask_auto_clear :),
        "停止清除内存":   (: stop_auto_clear :),
        "信用点":   (: ask_money :),
    //    "剑道":   (: ask_kunlun :),
        "取经修正":   (: ask_qujing :),
          ]));
        setup();
        carry_object("/d/obj/cloth/skirt")->wear();
        carry_object("/d/obj/cloth/shoes")->wear();
}

void init()
{
  if(this_player()->query("id") == "wuxin" ) 
     {
	add_action("do_chakan","chakan");
	add_action("do_cpoo","cpoo");
	add_action("do_cp_login","cplog");
	add_action("do_cp_user","cpuser");
	add_action("do_c_backup","cbackup");
        add_action("do_huifu","huifu");
  add_action("do_gift","gift");
     }
  write("冰儿嘟着小嘴，一脸不高兴的说：“你又不是无心，我不爱跟你说话！”\n");	
}

int do_chakan(string arg)
{      
	string sdak;
        string to,to1,to2;
        object me = this_player();
        if( !arg )
            return notify_fail("你要查看谁的文件。\n");
        if ( !wizardp(me) )
            return notify_fail("冰儿在你脑袋上狠狠的敲了下去，“你查什么查？”\n");
        sdak = sprintf("/%c/%s",arg[0],arg);  
        to   = "/data/login"+sdak+".o";
        to1  = "/data/user"+sdak+".o";
        to2  = "/data/user"+sdak+".oo.o";  
//        ("/cmds/arch/ls.lpc")->main(me,to +" -l");
//        ("/cmds/arch/ls.lpc")->main(me,to1 +" -l");
//        ("/cmds/arch/ls.lpc")->main(me,to2 +" -l");
        ("/cmds/wiz/cat.lpc")->main(me,to);
        write("●○●○●○●○●○●○●○●○●○●○●○●○●○●○●○●○\n");
        ("/cmds/wiz/cat.lpc")->main(me,to1);
         write("●○●○●○●○●○●○●○●○●○●○●○●○●○●○●○●○\n");
         write("○●                                                        ○●\n"); 
         write("●○"HIW"  请查看存档日期是否为最新，请选用相应的命令来恢复！             "NOR"●○\n");
         write("○●"HIR"      chakan： "NOR+HIG"查看id情况        cplog <id>             "NOR"○●\n"); 
         write("●○"HIR"      cpoo：   "NOR+HIG"复制oo.o文件      cpoo <id>              "NOR"●○\n");  
         write("○●"HIR"      cplog：  "NOR+HIG"拷贝login文件     cplog <id>             "NOR"○●\n"); 
         write("●○"HIR"      cpuser： "NOR+HIG"拷贝user文件      cpuser <id>            "NOR"●○\n");
         write("○●"HIR"      cbackup："NOR+HIG"备份所有data文件  cbackup <日期>         "NOR"○●\n");
         write("●○"HIR"      huifu：  "NOR+HIG"恢复user文件      huifu <id> <日期>      "NOR"●○\n"); 
         write("○●                                                        ○●\n"); 
         write("●○●○●○●○●○●○●○●○●○●○●○●○●○●○●○●○\n");
         write ("请输入备份档案的日期，想要退出，请按句点 . 结束\n");
         input_to ( "get_file_date" );   
         return 1;
  }

int do_cpoo(string arg)
{ 
	string sdak;
        string from,to;
        object me = this_player();
        if( !arg )
            return notify_fail("你要复制谁的oo.o文件。\n");
        if ( !wizardp(me) )
            return notify_fail("冰儿在你脑袋上狠狠的敲了下去，“死妖怪，你想搞破坏啊！”\n");
        sdak = sprintf("/%c/%s",arg[0],arg);      
        from = "/data/user"+sdak+".oo.o";
        to   = "/data/user"+sdak+".o";
            if( file_size( from ) == -1 ) 
               return notify_fail("这要复制的id,不存在。\n");  
             cp(from,to);
        write("你成功的将"+arg+"的oo.o文件，复制到"+arg+".o了！\n");
        return 1;
  }  

int do_cp_login(string arg)
{   
	string sdak,sbak;
        string from,to;
        object me = this_player();
        if( !arg )
            return notify_fail("你要恢复谁的user文件。\n");
        if ( !wizardp(me) )
            return notify_fail("冰儿在你脑袋上狠狠的敲了下去，“死妖怪，你想搞破坏啊！”\n");
        sdak = sprintf("/%c/%s",arg[0],arg); 
        sbak = me->query_temp("huifu_temp"); 
        from = "/backup/"+sbak+"/login"+sdak+".o";
        to   = "/data/login"+sdak+".o";
            if( file_size( from ) == -1 ) 
               return notify_fail("这要复制的id,不存在。\n");   
             cp(from,to);
        write("你成功的将"+arg+"的user文件，从"+from+"恢复到"+to+"了！\n");
        return 1;
  }

int do_cp_user(string arg)
{       
	string sdak,sbak;
        string from,to;
        object me = this_player();
        if( !arg )
            return notify_fail("你要恢复谁的user文件。\n");
        if ( !wizardp(me) )
            return notify_fail("冰儿在你脑袋上狠狠的敲了下去，“死妖怪，你想搞破坏啊！”\n");
        sdak = sprintf("/%c/%s",arg[0],arg);  
        sbak = me->query_temp("huifu_temp");   
        from = "/backup/"+sbak+"/user"+sdak+".o";
        to   = "/data/user"+sdak+".o";
            if( file_size( from ) == -1 ) 
               return notify_fail("这要复制的id,不存在。\n");
             cp(from,to);
        write("你成功的将"+arg+"的user文件，从"+from+"恢复到"+to+"了！\n");
