inherit ITEM;
#include <ansi.h>

void create() {

  set_name(HIR "六一节红包" NOR, ({ "hong bao", "bao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long",
      "这是一个" HIR "六一节红包" NOR "，可以(qiang)来看看。\n"
      "      " HBMAG "╭─────────────────────────────────────────╮\n" NOR
      "      " HBMAG "│                           ┃\n" NOR
      "      " HBMAG "│祝贺大家“六一节快乐，保持童心”!│\n" NOR
      "      " HBMAG "│                           ┃\n" NOR
      "      " HBMAG "│           ── 神魔wiz组敬贺 │\n" NOR
      "      " HBMAG "│                           ┃\n" NOR
      "      " HBMAG "╰━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╯\n"
      NOR);
    set("value", 0);
    set_weight(10);
    set("no_drop", 1);
    set("no_give", 1);
    set("no_steal", 1);
    set("no_get", 1);
    set("q_time", 0);
    set("maxtime", 5 + random(4));
    set("maxpot", (2 + random(4)) * 10000);
    set("hbao_time", time());
  }
  setup();
}

void init() {
  add_action("do_qiang", "qiang");
  add_action("show_me", "chabao");
  call_out("destruct_me", 4800);

}

int do_qiang(string arg) {
  int maxpot, maxtime, q_time, bao_time, bao_gambled, bao_pot, j, mp;
  string name, id, ip_from;

  object bao = this_object(), me = this_player();
  q_time = bao->query("q_time");
  if (!q_time) q_time = 0;
  maxtime = bao->query("maxtime");
  maxpot = bao->query("maxpot");
  bao_time = maxtime - q_time;
  ip_from = query_ip_number(me);

  if (arg != "bao" && arg != "hong bao")
    return notify_fail("你要抢什么?\n");

  for (j = 1; j < (maxtime + 1); j++)  //防止重复抢包
  {
    if (me->query("name") == bao->query("bao_q[" + j + "]/name"))
      return notify_fail("你都抢过一次红包了，还想干什么?\n");
  }
  for (j = 1; j < (maxtime + 1); j++)  //防止重复抢包
  {
    if (ip_from == bao->query("bao_q[" + j + "]/ip"))
      return notify_fail("这个IP已经抢过一次红包了，还是把机会留给别人吧！\n");
  }
  call_out("show_me", 1);

  if (q_time < maxtime)

  {
    if (bao_time < 2) {
      bao_pot = maxpot - bao->query("bao_gambled");
      if (me->query("c_balance") > 1000000000) {
        me->add("c_balance", -1000000000);
        me->add("c_balance_credit", 1);  //自动转换成信用点，防止溢出
        me->save();
      }
      me->add("c_balance", bao_pot * 10000);
      me->add("wuxin/2016/hongbao", bao_pot);
      bao->set("bao_q[" + maxtime + "]/name", me->query("name"));
      bao->set("bao_q[" + maxtime + "]/id", me->query("id"));
      bao->set("bao_q[" + maxtime + "]/get", bao_pot);
      bao->set("bao_q[" + maxtime + "]/ip", ip_from);
      bao->add("q_time", 1);
      bao->set("bao_endtime", time());
      write(HIY "你抢到一个" HIR "六一节红包" HIY "！\n"
        HIG "祝贺你六一节大吉，儿童节快乐!\n" NOR "
                   你得到了" + bao_pot + "两黄金。\n" NOR);
      message(
        "channel:rumor",
        HIM + "【谣言】某人：听说" + me->query("name") + "抢到" + HIR + "六一节红包了！\n" + NOR,
        users()
      );
      bao->add("bao_gambled", bao_pot);
      return 1;
    } else {
      mp = maxpot - bao->query("bao_gambled") - maxtime;
      bao->add("q_time", 1);
      q_time = bao->query("q_time");
      bao_pot = random(mp / (random(bao_time + 1) + 1));
      if (me->query("c_balance") > 1000000000) {
        me->add("c_balance", -1000000000);
        me->add("c_balance_credit", 1);
        me->save();
      }
      me->add("c_balance", bao_pot * 10000);
      me->add("wuxin/2016/hongbao", bao_pot);
      bao->set("bao_q[" + q_time + "]/name", me->query("name"));
      bao->set("bao_q[" + q_time + "]/id", me->query("id"));
      bao->set("bao_q[" + q_time + "]/get", bao_pot);
      bao->set("bao_q[" + q_time + "]/ip", ip_from);
      bao->add("bao_gambled", bao_pot);
      write(HIY "你抢到一个" HIR "六一节红包" HIY "！\n"
        HIG "祝贺你六一节大吉，儿童节快乐!\n" NOR "
                   你得到了" + bao_pot + "两黄金。\n" NOR);
      message(
        "channel:rumor",
        HIM + "【谣言】某人：听说" + me->query("name") + "抢到" + HIR + "六一节红包了！\n" + NOR,
        users()
      );
      return 1;
    }

  } else {
    write(HIB "你动作慢了，早就被抢光了，下次请早！！\n" NOR);
    call_out("show_me", 1);
    return 1;
  }
}

void show_me()  //显示这个包的抢包情况
{
  object bao = this_object();
  int j, maxtime, bao_max, bao_max_name, maxpot, hbao_time;
  bao_max = 0;
  maxpot = bao->query("maxpot");
  maxtime = bao->query("maxtime");
  if (!bao->query("bao_endtime"))
    write(HIY "\n共" + maxtime + "个红包。\n" NOR);
  else {
    hbao_time = bao->query("bao_endtime") - bao->query("hbao_time");
    write(HIY "\n共" + maxtime + "个红包，共" + maxpot + "两黄金，共" + hbao_time + "秒抢光。\n" NOR);
  }
  write(HIR "\n===================================\n" NOR);
  write(HIR "|   抢的红包如下：       \n" NOR);
  for (j = 1; j < (maxtime + 1); j++) {
    if (bao->query("bao_q[" + j + "]/get") > bao_max) {
      bao_max = bao->query("bao_q[" + j + "]/get");
      bao_max_name = bao->query("bao_q[" + j + "]/name");
    }
    write(HIR "|   " HIG + j + "、" + bao->query("bao_q[" + j + "]/name") + "[" + bao->query("bao_q[" + j + "]/id") + "]：" + bao->query("bao_q[" + j + "]/get") + "两黄金 \n" NOR);
  }
  write(HIR "|   手气最佳为：" + bao_max_name + ": " + bao_max + "两黄金。\n" NOR);
  write(HIR "===================================\n" NOR);
}

void destruct_me() {
  write(HIR + name() + HIG "化作一道耀眼的火光冲天而去！\n\n" NOR);
  this_object()->move("/obj/empty");
  destruct(this_object());
}
