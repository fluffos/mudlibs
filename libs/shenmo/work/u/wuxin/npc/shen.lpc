int me_qiugou()
{
	object me,ob;
	ob=this_object();
	me=this_player();
	write("请输入您想要求购的物品id\n");
	input_to("qiugou_id");
	return 1;
}
int qiugou_id(string id)
{
	string zwmc,zljg;//货币种类和价格

	if(!sizeof(zwdy))
	{
	 write("目前没有任何物品寄售 ！ \n");
	 return 1;
	}

if(undefinedp(zwmc=zwdy[id]))
{
	write("找不到物品名所对应的中文名称，请检查是否输入有误
		注意 ：只有曾经在寄售行寄售过的物品才可以求购 \n");
	write("物品名是"+zwmc);
	return 1;
}
write("您要求购的物品是"+zwmc+"("+id+") \n");
write("请输入您要求购的货币种类和价格，格式为 货币种类 价格(例：金币 10) \n
	  注意：只支持信用点和金币 \n");
	input_to("qiugou_fabu",zljg,id,zwmc);
}
int qiugou_fabu(string arg,string id,string zwmc)
{
	string a,zljg,jiage;
	int b;
if(!arg)
{
	write("格式为 货币种类 价格(例：金币 10)\n");
	return 1;
}

if(sscanf(arg,"%s %s",a,jiage)==2)
if(a!="JB"&&a!="金币"&&a!="xyd"&&a!="信用点")
{
	write("您输入的货币种类错误");
	return 1;
}
else ;
else {write("格式为 货币种类 价格"); return 1;}
b=atoi(jiage);
if(b>100)
{
	write("您输入的金额太大了\n");
	return 1;
} 
if(b<1)
{
	write("您输入的金额太小了\n");
	return 1;
}
write("您要求购的物品是"+zwmc+"("+id+") 价格是"+b+"个"+HIY+a+NOR+"\n");
write(HIY"确定输入y否则输入n \n"NOR);

input_to("qiugou_qd",zljg,id,zwmc,a,b);

}
int qiugou_qd(string qd,string id,string zwmc,string a,int b)
{
	
		object ob,me; 
		int ctime;
		me=this_player();
		if(qd!="Y"&&qd!="y")
		{	write("不求购那就算了\n");
		return 1;
		}  
		if(a=="金币"||a=="JB")
		{
			if(me->query("c_balance")<b*10000000)
			{
				write("您的存款不够");
				return 1;   }
			me->add("c_balance",-b*10000000);
			/*switch (MONEY_D->player_pay(me, b*10000))
			{
			case 0:
				write(CYN + name() + "冷笑道：“你哪有这么多黄金！”\n" NOR);
				return 1;
			case 2:
				write(CYN + name() + "皱眉道：“您还有没有零"
					"钱啊？银票我可找不开。”\n" NOR);
				return 1;
			default:*/
				if(!sizeof(qiugou))
					qiugou=({});
       query("qg_bianhao")?add("qg_bianhao",1) : set("qg_bianhao",1);  //寄售编号改为顺序编号   
				qiugou+=({(["wuzhu" : me->query("id"),"zwuzhu" : me->query("name"),"wpm" : id,"zwpm" : zwmc,"bizhong" : JB,"jiage" : b,"bianhao":query("qg_bianhao")])});
				command("chat "+me->query("name")+"以"+CYN+sprintf("%d",b)+NOR+"两"+JB+"求购物品"+zwmc+" \n");
				save();
				write("求购信息以发布\n");

			}

		else if(a=="xyd"||a=="信用点")
		{
			if(me->query("c_balance_credit")<b)
			{
				write("您的信用点不够");
				return 1;   }
			me->add("c_balance_credit",-b);
			if(!sizeof(qiugou))
				qiugou=({});
			qiugou+=({(["wuzhu":me->query("id"),"zwuzhu":me->query("name"),"wpm":id,"zwpm":zwmc,"bizhong":XYD,"jiage":b,"bianhao":random(999)])});
				command("chat "+me->query("name")+"以"+CYN+sprintf("%d",b)+NOR+"个"+XYD+"求购物品"+zwmc+" \n");
				save();
				write("求购信息以发布\n");
		}


		return 1;	

	
}


