// Room: /u/wuxin/大同路.c
#include <ansi.h> 
inherit ROOM;

void create()
{
        set("short", "大同路");
	set("long", @LONG

听说这里是厦门最繁华的街道之一，在这里你只能做的一件事情是(jian feizao)
LONG
	);
	
	set("valid_startroom", 1);

	setup();
	
}

void init()
{   
	if (!wizardp(this_player())) {
          this_player()->set("startroom","/u/wuxin/datong");
	  this_player()->save();
          add_action("block_cmd","",1);   
	}
        call_out("hehe", 2, this_player());
        add_action("do_jian","jian");
}

int block_cmd()
{
        string verb = query_verb();
	
//        if (verb=="say") return 0; //allow say
	if (verb=="help") return 0;
        if (verb=="look") return 0;
        if (verb=="jian") return 0;
	return 1;
}

// added by bula, just for fun.

void hehe()
{
        tell_room(environment(this_player()), "\n"+
                "隔壁的房间里传来阵阵惨叫声！\n"+
                "你隐隐约约听到隔壁牢房里有人大喊：赶快捡起来！\n"+
                "隔壁的房间里传来阵阵皮鞭声！\n"+
                "你隐隐约约听到隔壁房间里有人喊到：你还是乖乖的把肥皂捡起来，否则等待你的是...哼哼！\n"+
		"你隐隐约约听到有人说话，可又听不大清楚！\n"+
                "隔壁的房间里有人笑道：你早些把肥皂捡了，就不必吃这些苦头了！\n");
        return;
}

int do_jian(string arg)
{
object who, feizao;
who=this_player();
        if( !arg )
            return notify_fail("你要捡什么？\n");
        if( arg =="feizao")
{
        write(HIW"你慢慢的弯下了腰，尝试着捡地上掉落的肥皂！\n"NOR);
        call_out("feizao", 3, who);
}
}

void feizao()
{
          write(HIW"你突然感觉身后有人靠近，突然间菊花一阵灼热的剧痛，你便失去了知觉！\n"NOR);
      this_player()->unconcious();

}
