inherit NPC;
#include <ansi.h>
int give_gift();
void create() {
  set_name(HIM "当机大使" NOR, ({ "da shi" }));
  set("age", 18 + random(10));
  set("gender", "男性");
  set("title", HIY "祝服务器" HIR "★万寿无疆" NOR);
  set("long", "这位就是传说中的当机大使，听说服务器当机，他就可能会出现。\n");
  set("attitude", "peaceful");
  set("str", 50);
  set("kar", 50);
  set("per", 50);
  set("combat_exp", 200000000);
  set("daoxing", 200000000);
  set("max_force", 200000);
  set("max_mana", 200000);
  set("max_kee", 40000);
  set("max_sen", 40000);
  set("force", 400000);
  set("force_factor", 1000);
  set("mana_factor", 1000);
  set("mana", 1000);
  set_skill("unarmed", 1000);
  set_skill("dodge", 1000);
  set_skill("parry", 1000);
  set("inquiry", ([
    "当机": (: give_gift :),
    "当机补偿": (: give_gift :),
  ]));
  setup();
}

int give_gift() {
  object me;
  int exp, dx, qn;
  int addexp, adddx, addqn, addxyb;
  me = this_player();
  exp = me->query("combat_exp") / 100;
  dx = me->query("daoxing") / 100;

  if (!me) return 0;

  message_vision("\n\n补偿大使笑呵呵的对你说：人生不得意的事情十有八九，是不是又当机了？放心，放心！\n\n" NOR, me);
  if (me->query("wuxin/补偿大使") == "20120602") {
    message_vision("\n\n补偿大使疑惑的看着你道：这是补偿礼物，你以为是十全大补丸啊，小心伤身？\n\n" NOR, me);
    return 1;
  }
  me->set("wuxin/补偿大使", "20120602");
  if (me->query("combat_exp") <= 20000000 || me->query("age") < 16 || me->query("daoxing") < 20000000) {
    message_vision("\n\n补偿大使斜着三角眼的看着你：你不会是来混礼物的吧？说着随手朝你一指！\n\n" NOR, me);

    addexp = 20000 + random(5000);
    adddx = 20000 + random(5000);
    addqn = 7000 + random(2000);
    me->add("combat_exp", addexp);
    me->add("daoxing", adddx);
    me->add("potential", addqn);
    write("你增加了\n" + chinese_number(addexp) + "武学\n" + COMBAT_D->chinese_daoxing(adddx) + "道行\n" + chinese_number(addqn) + "潜能\n");
    message_vision(HIY + "补偿大使拍着$N的肩膀说：“努力吧，大有前途啊！“\n\n" NOR, me);
    return 1;
  }

  addexp = 100000 + random(20000);
  adddx = 100000 + random(20000);
  addqn = 20000 + random(7000);
  addxyb = 10;
  me->add("combat_exp", addexp);
  me->add("daoxing", adddx);
  me->add("potential", addqn);
  me->add("c_balance_credit", addxyb);
  message_vision(
    "\n\n补偿大使哈哈大笑，望天一指：\n\n\n\n                  " + HIR "祝   " + HIY "服   " + BLU "务   " + HIG "器   " + HIC "\n\n" + HIW "                       万   " + HIB "寿   " + HIC "无   " + HIM "疆\n\n\n\n\n" NOR,
    me
  );
  message_vision("\n$N感觉周身一颤：$N的武学、道行、潜能都增加了！\n" NOR, me);
  write("你增加了\n" + chinese_number(addexp) + "武学\n" + COMBAT_D->chinese_daoxing(adddx) + "道行\n" + chinese_number(addqn) + "潜能\n");
  write("你获得了\n" + chinese_number(addxyb) + "点黄金信用点！\n");
  message_vision(HIY + "补偿大使拍着$N的肩膀说：“努力吧，大有前途啊！“\n\n" NOR, me);
  command("chat " HIG "听说" + me->query("name") + "获得补偿礼物了。\n");
  return 1;
}
