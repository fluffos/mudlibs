inherit ROOM;

void create()
{
set("short", "密室");
set("long", @LONG
这是猪猪的私人珍藏密室，墙上贴满了各色人种美女的海报，
手边有一个裸女雕像，胸(xiong)大的夸张。
LONG
);
set("exits", ([
"out" : __DIR__"workroom",
]));
set("item_desc", ([
"xiong": "这个胸大的非常夸张，尤其是那点嫣红。\n",
"嫣红": "不要想歪了，是胎记。\n",
]) );

setup();
}

void init()
{
add_action("do_hold", "hold");
}

void check_trigger()
{
object room;
// printf("left=%d right=%d\n",query("left_trigger"),query("right_trigger"));
if( (int)query("left_trigger")==1
&& (int)query("right_trigger")==1
&& !query("exits/down") ) {
message("vision", 
"裸女忽然移了开来。\n",
this_object() );
set("exits/down", __DIR__"workroom");
if( room = find_object(__DIR__"workroom") ) {
room->set("exits/up", __FILE__);
message("vision", 
"天花板忽然发出轧轧的声音，露出一个向上的阶梯。\n",
room );
}
delete("left_trigger");
delete("right_trigger");
call_out("close_passage", 10);
}
}

void close_passage()
{
object room;

if( !query("exits/down") ) return;
message("vision", 
"裸女移了回来。\n",
this_object() );
if( room = find_object(__DIR__"workroom") ) {
room->delete("exits/up");
message("vision", 
"天花板忽然发出轧轧的声音，向上的阶梯又缓缓地收了回去。\n",
room );
}
delete("exits/down");
}


int do_hold(string arg)
{
string dir;

if( !arg || arg=="" ) return 0;

if( arg=="xiong" ) {
write("你试著抓了抓那，发现有点冲动\n");
return 1;
}
if( sscanf(arg, "xiong %s", dir)==1 ) {
if( dir=="right" ) {

message_vision("$N抓着那个往右动了动...，忽然裸女举起手打了你个耳光。\n", 
this_player());
add("right_trigger", 1);
check_trigger();
return 1;
} else if( dir=="left" ) {

message_vision("$N抓着那个往左动了动...，忽然裸女举起手打了你个耳光。\n", 
this_player());
add("left_trigger", 1);
check_trigger();
return 1;
} else {
write("你要抓什么？流氓\n");
return 1;
}
}
}


void reset()
{
::reset();
delete("left_trigger");
delete("right_trigger");
}

