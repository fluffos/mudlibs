#include <ansi.h> 
inherit ITEM;    
int do_open(string arg);
void create()
{
  set_name(HIG "圣诞猪蹄" NOR,({"zhuti"}));
  set("long","这是一份猪猪记的五香猪蹄，你缠的想马上把它给("+HIR+"tun"+NOR+")了。"); 
  set("unit","份"); 
  set("value", 0); 

setup();
}
void init()
{
if(!wizardp(this_player())){
    set("no_get","这个东西拿不起来。\n"); 
    set("no_give","这么珍贵的东西，哪能随便给人？\n");
    set("no_drop","这么宝贵的东西，扔了多可惜呀！\n");
    set("no_sell","这东西不能卖。\n");
}
    if(this_player()==environment())
      add_action("do_open", "tun"); 
}
int do_open(string arg)
{
  object me=this_player();
  if (!arg && arg!="zhuti") return notify_fail("你要吃什么?\n"); 

  if (me->query("sd_liwu")) return notify_fail("你已经拿过礼物了，怎么还想要？\n"); 
  message_vision(HIR"$N把猪蹄急乎乎的几口给吞了下去，骨头都不吐！！你吃的真饱，好像多了点什么，糟糕吃坏肚子了，仿佛又少了什么！\n" NOR,me); 
  me->add("spi",1); 
  me->add("叛师/num",-1);  
  me->set("sd_liwu",1);
  destruct(this_object());
  return 1; 
}
