#include <armor.h>
#include <ansi.h>
inherit ARMOR;

void create()
{
        set_name(BLK"通天圣衣"NOR, ({"sheng yi","yi", "cloth"}));
        set_weight(300);
                set("unit", "件");
                set("long", "通天教主的法衣．\n");
                set("material", "steel");
                set("value", 100);
                set("armor_prop/armor", 99);
                set("armor_prop/parry", 99);
                set("armor_prop/dodge", 99);
             setup();
}
string long() { return query("long") + item_long(); }
mixed valid_damage(object ob, object me, int damage, object weapon)
{
        mapping result;
        int ap, dp;
        int cost;  

        if ((int)me->query_skill("force", 1) < 260
           || (int)me->query("force") < 500
           || ! living(me) || random(4) != 1)
                return;

        cost = damage / 20;

        if (cost > 300) cost = 10;

        ap = ob->query_skill("force") * 12 + ob->query("max_force");
        dp = me->query_skill("force") * 2 ;

        if (ap / 2 + random(ap) > dp)
        {
                me->add("force", -cost);
                result = ([ "damage": -damage ]);

                switch (random(4))
                {
                case 0:
                        result += (["msg" : 不忍心出这一招。\n" NOR]);
                        break;
                case 1:
                        result += (["msg" : 只感头晕目眩，居然一招打在空处。\n" NOR]);
                        break;
                case 2:
                        result += (["msg" : 打中的是通天圣衣幻化出来的幻象。\n" NOR]);
                        break;
                default:
                        result += (["msg" : 被金光牢牢挡住，伤不了分毫。\n" NOR]);
                        break;
                }
                return result;
        }
