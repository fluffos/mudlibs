// blade.c

#include <weapon.h>

inherit BLADE;

void create() {
  set_name("指甲刀", ({ "zhijia dao", "dao", "knife" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 100);
    set("material", "iron");
    set("long", "这是猪猪专用指甲刀。\n");
    set("wield_msg", "$N拿出$n开始剪指甲。\n");
    set("unequip_msg", "$N收起来$n，满意的看着指甲。\n");
  }
  init_blade(90);
  setup();
}
