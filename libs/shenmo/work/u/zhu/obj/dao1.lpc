// blade.c

#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create() {
  set_name("指甲刀", ({ "zhijia dao", "dao", "knife" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 100);
    set("no_sell", 1);
    set("no_get", 1);
    set("material", "steel");
    set("long", "这是猪猪专用指甲刀。\n");
    set("wield_msg", "$N拿出$n开始剪指甲。\n");
    set("unequip_msg", "$N收起来$n，满意的看着指甲。\n");
  }
  init_blade(100 + random(300));
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  victim->receive_damage("gin", dam / 3);
  victim->receive_damage("sen", dam / 3);
  victim->receive_damage("kee", dam / 3);
  return HIW "指甲刀突然剪到了你的肉。\n" NOR;
}
string do_wield() {
  object me;

  me = this_player();
  if (me->query("bellicosity") < 10) {
    me->set_temp("apply/attack", me->query_skill("sword") / 4);
    me->set_temp("apply/defense", me->query_skill("parry") / 4);
    return HIC "$N奸笑一声，摸了把$n" HIC "出来。\n" NOR;
  } else if (me->query("bellicosity") <= 100) {
    return HIC "$N高高兴兴把$n" HIC "亮在手中。\n" NOR;
  } else if (me->query("bellicosity") > 200) {
    me->set_temp("apply/attack", -me->query_skill("sword") / 5);
    me->set_temp("apply/defense", -me->query_skill("parry") / 5);
    return HIG "$N战战兢兢的摸出一把$n" HIG "。\n" NOR;
  } else {
    return HIG "$N一不小心，摸出了$n" HIG "。\n" NOR;
  }
}
string do_unwield() {
  object me;

  me = this_player();
  me->delete_temp("apply/attack", me->query_skill("sword") / 4);
  me->delete_temp("apply/defense", me->query_skill("parry") / 4);
  if (me->query("bellicosity") <= 0)
    return HIC "$N唱道：手指甲啊，我最喜欢剪。\n" NOR;
  else if (me->query("bellicosity") > 100)
    return HIG "$N把$n" HIG "收了起来，抹了抹头上的汗，终于剪完了。\n" NOR;
  else
    return HIG "$N一晒，把$n" HIG "塞入裤带。\n" NOR;
}
