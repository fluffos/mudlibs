#include <ansi.h>

inherit NPC;

string ask_me(object who);

void create()
{
        set_name("小猪", ({ "xiaozhu", "pig"}));
        set("title", "猪猪的金猪骑士");
        set("gender", "男性" );
        set("long", "这是个猪猪的金猪骑士。\n" );
        set("age", 80);
        set("str", 30);
        set("con", 25);
        set("dex", 25);
        set("int", 25);
        set("max_qi", 800);
        set("max_jing", 500);
        set("neili", 500);
        set("max_neili", 500);
        set("jiali", 10);
        set("combat_exp", 100000);
        set("attitude", "heroism");
        set("chat_chance_combat", 15);
        set("chat_msg_combat", ({
                CYN "小猪说：你们真是呕像啊！\n" NOR,
                CYN "小猪忽然大叫：起架，wc。\n" NOR,
                CYN "小猪希望谁能给他点安慰。\n" NOR
        }) );

        set("inquiry", ([
                "猪猪" : "你问我吗，不是真的问我把，真的，那我想想。" ,
                "tom"   : (: ask_me :),
        ]) );
        set_skill("blade", 100);
        set_skill("dodge", 80);
        set_skill("unarmed", 80);
        set_skill("parry", 80);
        set_skill("literate", 60);

        setup();        
        carry_object("/u/zhu/obj/dao")->wield();
}

string ask_me(object who)
{
        int i;
        object *ob;

        if (query("revealed"))
        {
                if (is_killing(who))
                        return "你既然知道tom是黑社会老大，今日休想活命！\n";
                else {
                        kill_ob(who);
                        who->fight_ob(this_object());
                        return "老子就是tom买通的金牌杀手，去死把！\n";
                }
        }

        if( (random(10) < 5) || is_fighting() )
                return "我……我不知道。\n";

        set_temp("apply/attack",  80);
        set_temp("apply/defense", 80);
        set_temp("apply/damage",  50);

        set("title", HIR "杀人狂魔" NOR);

        message("vision", HIY "小猪冷喝：巫师的秘密都敢打听，去死？\n"
                          "小猪淫笑道：老子通吃。\n" 
                          "小猪笑嘻嘻的向你靠过来。\n" NOR,
                          environment(), this_object() );

        set("pursuer", 1);
        set("attitude", "aggressive");
        set("vendetta/authority", 1);
        set("chat_msg_combat", ({(: random_move :)}) );
        set("chat_chance", 15);
        set("chat_msg", ({(: random_move :)}) );
        set("bellicosity", 10000);
        set("combat_exp", 300000);
        set("neili", 1000);
        set("max_neili", 1000);
        set("jiali", 50);

      set_skill("blade", 150);
        set_skill("bingpo-blade", 150);


        map_skill("blade", "bingpi-blade");

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: perform_action, "qianshechudong" :),
        }) );

        ob = all_inventory(environment());
        for(i = sizeof(ob)-1; i >= 0; i--)
        {
                if (! userp(ob[i])) continue;
                kill_ob(ob[i]);
                ob[i]->fight(this_object());
        }
        add_money("silver", 50);
        set("revealed", 1);
        return "老猪最喜欢你了，我们去开房把！\n";
}

