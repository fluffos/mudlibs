  // Room: ceshi

inherit ROOM;

void create()
{
    set("short", "游乐园");
    set("long", @LONG
这是乐乐专用游乐园，没有别的特点，
就是帅哥多啊，所谓
天下丑男都死掉
帅哥衣服都脱掉
做爱不用避孕套。
LONG
    );
set("exits", ([ /* sizeof() == 1 */
"kz": "/d/wiz/entrance3",
]));
    
    set("no_clean_up", 0);

    setup();
//    replace_program(ROOM);
}

void init()
{
    add_action("do_play", "play");
}

int do_play(string arg)
{
    if( arg=="美女" || arg=="girl" ) {
    if(this_player()->query_skill("literate")<10) {
        write("书都没读好，就想泡妞。\n");
            return 1;
        }
        message_vision("$N你冲着帅哥扑了上去，却被他一脚给踢飞了。\n", this_player());
        this_player()->move(__DIR__"workroom");
        message("vision", this_player()->name() + "被谁给踢了过来，笑的还很淫荡。\n",
            environment(this_player()), this_player());
        return 1;
    }
    else return 0;
}

       
       
       
  
