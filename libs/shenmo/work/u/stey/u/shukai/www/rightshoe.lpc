#include <ansi.h>
#include <armor.h>

inherit BOOTS;


void create() {
  set_name(HIW "泰山独脚鞋——右" NOR, ({ "right shoe", "xie", "shoe" }));
  set_weight(1000);
  set("unit", "只");
  set("value", 0);
  set("material", "cloth");
  set("armor_prop/armor", 10);
  set("armor_prop/dodge", 15);
  setup();
}
