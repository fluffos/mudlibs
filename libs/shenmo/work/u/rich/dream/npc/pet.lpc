#include <ansi.h>
inherit NPC;
inherit F_SAVE;  private string SAVE_NAME = "pet_save";
private nosave int can_save = 1;
void create() {
  seteuid(getuid());
  set_name("魔幻兽", ({ "pet" }));
  set("gender", "女性");
  set("race", "野兽");
  set("age", 1);
  set("base_name", "兔");
  set("attitude", "friendly");
  set("long", "小家伙。相关命令：bianshen watch feed\n");
  set("combat_exp", 100);
  set("daoxing", 100);
  set("str", 3);
  set("cor", 3);
  set("per", 3);
  set("spi", 3);  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("ride/msg", "骑");
  set("ride/dodge", 20);
  set_temp("apply/attack", 60);
  set_temp("apply/armor", 60);
  set("is_pet", 1);
  setup();
}

void reset() {
  if (!environment() || !find_living(query("owner"))) {
    destruct(this_object());
    return;
  }
}

void unconcious() {
  return die();
}

string query_save_file() {
  string id;
  id = query("owner");
  if (!id) return 0;
  return sprintf(DATA_DIR "pet/%c/%s", id[0], id);
}

int save() {
  string file;
  if (stringp(file = this_object()->query_save_file())) {
     assure_file(file + __SAVE_EXTENSION__);  return save_object(file); 
  }
  return 0;
}

int restore() {
  string file;  if (stringp(file = this_object()->query_save_file()))
    return restore_object(file);
  return 0;
}
void die() {
  int i;
  object owner, *enemy;
  int gin, kee, sen, exp;
  exp = (int)query("combat_exp");
  gin = (int)query("max_gin");
  kee = (int)query("max_kee");
  sen = (int)query("max_sen");
  if (!environment()->query("no_death_penalty"))
    set("combat_exp", exp / 10 * 9);
  set("eff_kee", kee);
  set("eff_gin", gin);
  set("eff_sen", sen);
  set("kee", kee);
  set("gin", gin);
  set("sen", sen);
  save();
  ::die();
}

void init() {
  add_action("do_kill", ({ "kill", "fight", "steal" }));
  add_action("do_mount", "mount");
  add_action("do_jinhua", "jinhua");
  add_action("do_bianshen", "bianshen");
}


int do_mount(string arg) {
  object me = this_object(), who = this_player(), env;
  if (!arg) return 0;
  env = environment(who);
  if (present(arg, env) != me) return 0;
  if (me->query("owner") == who->query("id")) {
     who->set_temp("pet", 1);  return 0; 
  }
  message_vision("$n左躲右闪，$N累得满头大汗也没骑上去。\n", who, me);
  return 1;
}


int do_jinhua(string arg) {
  object me;
  object hs;
  int w_zhi, w_level;
  string w_or, msg;  me = this_player();
  hs = this_object();
  if (!arg)
    return notify_fail("你用本身精元唤醒什么?\n");
  if ((int)hs->query("level") > 99)
    return notify_fail("你的魔兽已经进化到终极形态！\n");
  if ((int)me->query("maximum_force") < 2200)
    return notify_fail("你的内力上限不够，无法用本身精元唤醒魔兽！\n");  if ((int)me->query("max_force") < 2200)  return notify_fail("你的内力上限不够，无法用本身精元唤醒魔兽！\n");  if ((int)me->query("max_force") < 2200)
      return notify_fail("你的内力不够，无法用本身精元唤醒魔兽！\n");  if ((int)me->query("kee") < 300)
        return notify_fail("你的气不够，无法用本身精元唤醒魔兽！\n");  if ((int)me->query("eff_kee") < 300)
          return notify_fail("你现在的体力太弱，无法用本身精元唤醒魔兽！\n");  if ((int)me->query("eff_sen") < 300)
            return notify_fail("你现在的精力无法集中，无法用本身精元唤醒魔兽！\n");  if ((int)me->query("sen") < 300)
              return notify_fail("你现在的精神太弱，无法用本身精元唤醒魔兽！\n");  if (((int)me->query("potential") - (int)me->query("learned_points")) < 100)
                return notify_fail("你的潜能不够，无法用本身精元唤醒魔兽！\n");


  msg = HIW + "        $N把$n双眼微闭，集中精神在双掌之间，口中念道：在天的见证之下，集勇气、        智慧、与美丽于一身的强大生物，魔兽呀！请你以最深的灵性，倾听我的倾诉，        我" + me->query("name") + "将与你缔结永生的血之盟约，终此生惟有        你与我为终生之盟友，契。 \n" NOR;  message_vision(
    msg,
    me
  );


  me->add("maximum_force", -5);
  me->add("max_force", -5);
  me->set("force", (int)me->query("maximum_force"));
  me->add("kee", -30);
  me->add("eff_kee", -30);
  me->add("eff_sen", -30);
  me->add("sen", -30);
  me->add("learned_points", 100);  w_zhi = (int)hs->query("value");
  w_zhi++;
  hs->set("value", w_zhi);
  w_or = (string)hs->query("or");
  w_level = (int)hs->query("level");
  if (w_zhi >= ((w_level + 1) * (w_level + 1))) {
    w_level++;
    hs->set("level", w_level);
    '        hs->add("max_kee",20);' hs->add(
      "max_sen",
      20
    );  '        hs->set("kee",(int)hs->query("max_kee"));' hs->set(
      "sen",
      (int)hs->query("max_sen")
    );  '        hs->set("eff_kee",(int)hs->query("max_kee"));' hs->set(
      "eff_sen",
      (int)hs->query("max_sen")
    );

    message_vision(HIG "$n进化了！\n" NOR, me);
    weapon = this_object();
    if (hs->query("equipped"))
      hs->unequip();
    reload_object(weapon);
    hs->set("value", 0);
    return 1;
  }

  'msg=HIW+"' 短 短 三 分 钟 不 到 ， $n 已 成 长 了 将 近 原 来 的 三 倍 大 。 而 $N 似 乎 已 无 力 为 继 ， 轻 哼 一 声 ，  '双手发出的白光逐渐淡化，消失。随着$N双手白光消失，$n也停止生长。\n"NOR;
        message_vision(msg,me);
return 1;
}

int do_bianshen(string arg) { 
int i,lvl,add_damage,add_kee,add_sen,add_armor,time; 
string msg,name,id,sx; 
object me=this_player(); 
object hs=this_object();
lvl=hs->query("level"); //等级 
sx=hs->query("pet_type");            
     message vision(HIY"\n      $n忽然窜出了三道金光，往$N身上一绕，霎时，一阵耀眼到令她睁不开眼睛的金光由      $N身上猛烈的四射出来，宛如个人形的太阳一般的灿烂。\n"NOR,me,hs);      
     switch( sx ) 
{ 
             case "风" : { //加防御+busy 
msg=HIY"      好不容易，金光慢慢的消退，$N身上多了个神奇的魄石。\n      只见，$N的魄石发出神秘光芒，令$N整个人就像是包围在一团光芒之中，身后出现风神      模样的幻象守护着$P。\n"NOR; 
