inherit NPC;
#include <ansi.h>
int do_test(); 
void create()
{
   set_name(HIC"美丽的梦中情人"NOR,({"npc lover", "lover"})); 
   set ("long", "她是来自缥缈的梦中情人。\n");
   set("gender","女性");
   set("age", random(10)+14);
   set("per", 40);
set("attitude", "peaceful");
   set("shen_type", 1);
set("inquiry", (["test" : (:do_test:)]));
   setup();
}
int do_test()  
{
object who=this_player();
who->set("sds3/number",12);
who->set("sds3/king","done");
}
