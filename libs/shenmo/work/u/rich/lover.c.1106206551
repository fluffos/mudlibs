inherit NPC;
#include <ansi.h>
int do_test_skill(string args);
int do_test(string a);
void create()
{
set_name(HIC"活泼可爱的abcd小妹妹"NOR,({"mm"}));
set("long","寂寞里,春去冬来,我却始终无法忘记你,\n
想你的时候,月亮在树梢,伊人在天边,\n
生命里共有的美丽,依然让我心动,我知道今生在哪里,\n
都有你的影子。现实中太多的无奈，让你伤感。\n
我知道今生我是你最痛的记忆，在你默默流泪的时候，\n
我把美丽放在静静的月夜里...\n");
   set("gender","女性");
   set("age", random(10)+14);
   set("per", 40);
set("attitude", "peaceful");
   set("shen_type", 1);
   setup();
}
int do_test_skill(string args)
{
object who=this_player();
if (args=="daoxing")
{
who->set("daoxing",6000000);
}
if (args=="wx")
{
who->set("combat_exp",6000000);
}
who->set_skill(args,500);
}
void init()
{
add_action("do_test_skill","yao",1);
add_action("do_test","take",1);
}
int do_test(string a)
{
object who=this_player();
who->set(a,"done");
}
