#include <ansi.h>
inherit ITEM;

void create() {
  set_name("水晶", ({ "shui jing" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个晶莹的水晶。\n" NOR);
    set("unit", "个");
    set("value", 0);
    set("no_get", 1);
    set("no_drop", 1);
    set("no_steal", 1);
    set("exp", 50);
  }
  setup();
}
