inherit NPC;
#include <ansi.h>
int do_test_skill(string args);
void create()
{
   set_name(HIC"美丽的梦中情人"NOR,({"npc lover", "lover"})); 
   set ("long", "她是来自缥缈的梦中情人。\n");
   set("gender","女性");
   set("age", random(10)+14);
   set("per", 40);
set("attitude", "peaceful");
   set("shen_type", 1);
   setup();
}
int do_test_skill(string args)
{
object who=this_player();
who->set_skill(args,500);
}
void init()
{
add_action("do_test_skill","yao",1);
}
