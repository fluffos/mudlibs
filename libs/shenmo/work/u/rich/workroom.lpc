#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIG "神秘的次元空间" NOR);
  set("long", "这里就是通向神秘的魔幻兽世界的入口。远处几只燃烧的火魔兽在嬉戏打闹。\n");
  set("exits", ([ "out": "/d/city/kezhan",
    "wiz": "/d/wiz/wizroom",
  ]));
  set("objects", ([
    "/u/rich/lover": 1,
    "/u/rich/petboss": 1,
  ]));
  set("no_fight", 1);
  setup();
}
