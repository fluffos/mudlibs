// /cmds/usr/topten.c
#include <ansi.h>
inherit F_CLEAN_UP;
int getalldata(object,string);
int get_score(string args);
int main(object me, string arg)
{
        string str,*astr;
        int i;
        seteuid(geteuid(me));
        if (!arg||arg=="")
                return notify_fail("指令格式 : topten <类型>\n");
        get_score(arg);
        return 1;
}


int get_score(string args)
{
    int i,j;
    int k;
    string str1;
  object *sBuf = users();
  object *user = users();
  int iNum = sizeof(user);
 
    switch(args)
    {
        case "rich":
           str1=RICH_B;
           break;
        case "quests":
           str1=QUESTS_B;
           break;
        case "pker":
           str1=PKER_B;
           break;
        case "nker":
           str1=PKER_B;
           break;
        case "exp":
           str1=EXP_B;
           break;
        case "dx":
           str1=DX_B;
           break;
        case "force":
           str1=FORCE_B;
           break;
        case "age":
           str1=AGE_B;
           break;
        case "per":
           str1=PER1_B;
           break;
        case "task":
           str1=TASK_B;
           break;
        default:
           return notify_fail("没有"+args+"这种排行榜!\n"); 
      }
  for(i=0;i<iNum;i++)
    {
    if(!wizardp(user[i]))
    {
    for(j=0;j<10;j++)
    {
        if(sBuf[j]->query("id"))
        {
// if(TOPTEN_D->get_all_data(user[i],args) > TOPTEN_D->get_all_data(sBuf[j],args))
if(getalldata(user[i],args) > getalldata(sBuf[j],args))
            {
                k=10;
                while(k>j)
                {
                   sBuf[k] = sBuf[k-1];
                   k--;
                }
                sBuf[j]=user[i];
                break;
            }
        
        }
        else
        {
            sBuf[j] = user[i];
            break;
        }
    }
    }
  }
     str1+= "\n";
    for(i=0;i<10;i++)
    {
        str1+=NOR CYN"排行第"HIR+chinese_number(i+1)+NOR"：";   
        str1+=sBuf[i]->query("name")+"("+sBuf[i]->query("id")+")\n"; 
    }
    write(str1+"\n");
}

int getalldata(object player,string type)
{
int total;
switch(type)
{
case "rich":
total=(int)player->query("balance")/1000+(int)player->query("c_balance")/1000+(int)player->query("c_balance_credit")*1000000;
break;
case "pker":
total=(int)player->query("PKS");
break;
case "exp":
total=(int)player->query("combat_exp");
break;
case "daoxing":
total=(int)player->query("daoxing");
break;
case "qn":
total=(int)player->query("potential")+(int)player->query("c_potential")+(int)player->query("c_potential_credit")*100000;
break;
case "kill":
total=(int)player->query("PKS")+(int)player->query("MKS");
break;
case "spells":
total=(int)player->query("max_mana");
break;
case "force":
total=(int)player->query("max_force");
break;
case "age":
total=(int)player->query("mud_age");
break;
case "per1":
if (player->query("gender")!="男性")
total=-1;
else total=player->query_per();
break;
case "per2":
if (player->query("gender")!="女性")
total=-1;
else total=player->query_per();
break;
default:
total=-1;//用-1标志类型出错！
}
return total;
}


int help(object me)
{   write(HIW"指令格式 : topten <类型>\n"NOR+TOPTEN_D->query_type());
    return 1;
}
