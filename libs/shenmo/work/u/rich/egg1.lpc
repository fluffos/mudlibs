#include <ansi.h>
#include <dbase.h>
#include <armor.h>

inherit F_AUTOLOAD;  
inherit ITEM;


void create()

{
     set_name(HIY"幻兽之卵"NOR, ({"egg" }) );
     set_weight(100);
     set("long","尚未鉴定的幻兽之卵。\n");
     set("value", 10000);
     set("material", "steel");
     set("no_sell", "这么难得的宝物还是留着吧。\n");
     set("unit", "颗");
	setup();

}

