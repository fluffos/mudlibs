inherit NPC;

#include <ansi.h>
#include <login.h>
int do_sm(string args);
void create()
{
set_name(HIY "兽神" NOR,({"shou shen","shen"}));
set("title",HIY"魔兽世界的守护神"NOR);
  set("gender", "男性");
set("age",13500);
set("long","传说在盘古开天劈地的时代，就已经存在的神秘魔神。\n");  
  set("attitude", "peaceful");
  setup();
  carry_object("/d/obj/cloth/linen")->wear();

}

void init()
{
  object ob;
  ::init();
  add_action("do_sm", "choose");
}


int do_sm(string args)
{
object egg;
object me = this_player();
string id = me->query("id");
string name=me->query("name");
	if( me->query("combat_exp") < 10000000)
		return notify_fail("你的功夫太低，魔幻兽不愿跟随你。\n");
if( me->query("egg")) 
		return notify_fail("你已经有一头魔幻兽了，请用 dispose 杀死你现在的魔幻兽。\n");
egg = new("/u/rich/pet");
egg->set("owner",id);
egg->set("shuxing",args);
egg->setup();
egg->save();
egg->move(me);
if ( present(egg,me) )
	me->set("egg",1);
else return notify_fail("ERROE!\n");
me->save();
return 1;		
}

