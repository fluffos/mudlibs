// huyao.c

#include <ansi.h>
#include <armor.h>

inherit WAIST;

void create()
{
	set_name( HBMAG HIY "彩凤腰带"NOR, ({ "caifeng yaodai", "yaodai"}) );
	set_weight(30);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", HBMAG HIY "这是一件明朝洪武大帝为马皇后设计的彩凤腰带，做工非比寻常。\n"
                "上面绣有五彩凤凰。\n"NOR);
              

		set("value", 11600);
		set("armor_prop/armor", 80);
                set("armor_prop/parry", 25);
                set("armor_prop/dodge", 35);
                set("female_only", 1);
                set("armor_prop/jing", 1000);
                set("armor_prop/jingli", 1000);
                set("armor_prop/qi", 2000);
                set("armor_prop/neili", 1000); 
                
	}
	setup();
}
int query_autoload()
{
        return 1;
}

