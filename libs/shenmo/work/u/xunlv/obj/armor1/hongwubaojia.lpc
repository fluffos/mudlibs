#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create() {
  set_name(BRED HIY "洪武宝甲" NOR, ({ "hongwu baojia", "hongwu", "baojia" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", BRED "" HIY "这是一件明朝洪武大帝" HIY "-朱元璋-" BRED "的御用战甲，\n"
      "做工非比寻常。上面雕有九条五爪金龙，以五彩祥云环绕。\n" NOR);

    set("value", 60000);
    set("material", "leather");

    set("armor_prop/armor", 800);
    set("armor_prop/parry", 180);
    set("armor_prop/dodge", 180);
    set("armor_prop/jing", 4000);
    set("armor_prop/jingli", 4000);
    set("armor_prop/qi", 25000);
    set("armor_prop/neili", 4000);

  }
  setup();
}

int query_autoload() {
  return 1;
}
