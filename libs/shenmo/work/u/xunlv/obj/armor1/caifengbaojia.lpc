#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create() {
  set_name(HBMAG HIC "彩凤宝甲" NOR, ({ "caifeng baojia", "caifeng", "baojia" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", HBMAG "" HIC "这是一件明朝洪武大帝为马皇后设计的彩凤战甲，做工非比寻常。\n"
      "上面雕有绣八只颜色各异的凤凰，彩凤中间，穿插数朵牡丹，华丽无比。\n" NOR);

    set("value", 60000);
    set("material", "leather");
    set("armor_prop/armor", 800);
    set("armor_prop/parry", 180);
    set("armor_prop/dodge", 180);
    set("female_only", 1);
    set("armor_prop/jing", 4000);
    set("armor_prop/jingli", 4000);
    set("armor_prop/qi", 25000);
    set("armor_prop/neili", 4000);

  }
  setup();
}

int query_autoload() {
  return 1;
}
