// cloth.c
//
// This is the basic equip for players just login.
#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name(HBMAG HIC"彩"HIM"凤"HIC"裙"NOR, ({ "caifeng qun", "qun" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件"); 
                set("long", HBMAG""HIC"这是一件明朝洪武大帝为马皇后设计的彩凤裙，做工非比寻常。\n"
                "上面绣有九凤朝阳，以祥云环绕，前后还绣有各式牡丹花，色彩鲜明艳丽。\n"NOR);
                set("material", "cloth");
                set("value", 60000);
                set("armor_prop/armor", 500);
                set("armor_prop/parry", 100);
                set("armor_prop/dodge", 100);
                set("female_only", 1);
                set("armor_prop/jing", 3000);
                set("armor_prop/jingli", 3000);
                set("armor_prop/qi", 15000);
                set("armor_prop/neili", 3000); 
                

        }
        setup();
}

int query_autoload()
{
        return 1;
}

 
