// pifeng.c
 
#include <ansi.h> 
#include <armor.h> 
 
inherit NECK; 
 
void create() 
{ 
        set_name( HBMAG HIW "彩凤披风" NOR, ({ "caifeng pifeng", "pifeng" }) ); 
        set_weight(80); 
        if( clonep() ) 
                set_default_object(__FILE__); 
        else { 
                set("unit", "件"); 
                set("long", HBMAG HIW "这是一件色彩斑斓的彩凤披风，上面用金线绣了以凤凰为主的美丽图案，银线走边，非常华丽。\n"NOR); 
                set("value", 10000); 
                set("material", "cloth"); 
                set("wield_msg", "$N“哗”地展开彩凤披风披在身上，披风在身后随风飘扬，犹如孔雀开屏。\n");
                set("unwield_msg"," $N彩凤披风解下来叠好塞在了怀里。\n");
                set("armor_prop/armor", 120);
                set("armor_prop/parry", 25);
                set("armor_prop/dodge", 30);
                set("female_only", 1);
                set("armor_prop/jing", 1000);
                set("armor_prop/jingli", 1000);
                set("armor_prop/qi", 2000);
                set("armor_prop/neili", 1000); 
                
              } 
        setup(); 
} 
int query_autoload()
{
        return 1;
}

 
