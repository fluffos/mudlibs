// shield.c 牛皮盾

#include <armor.h>
#include <ansi.h>

inherit SHIELD;

void create() {
  set_name(BRED HIY "洪武盾" NOR, ({ "hongwu dun", "dun" }));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "leather");
    set("long", BRED HIY "这是一面金色洪武盾，上面用雕刻了一条金龙，银丝走边，非常华丽。\n" NOR);
    set("unit", "面");
    set("value", 21200);
    set("armor_prop/armor", 100);
    set("armor_prop/parry", 30);
    set("armor_prop/jing", 1000);
    set("armor_prop/jingli", 1000);
    set("armor_prop/qi", 3000);
    set("armor_prop/neili", 1000);


  }
  setup();
}
int query_autoload() {
  return 1;
}
