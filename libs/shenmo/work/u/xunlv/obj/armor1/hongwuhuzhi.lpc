// shoutao.c

#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create()
{
	set_name(HBRED "洪武护指" NOR, ({ "hongwu huzhi", "huzhi" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "副");
              set("long", HBRED"这是一双洪武护指，是当年朱元璋战甲配套的装备，主要用来保护手指的。\n"NOR); 

		set("value", 6000);
		set("material", "finger");
		set("armor_prop/armor", 50);
                set("armor_prop/parry", 25); 
              set("armor_prop/dodge", 25);
              set("armor_prop/strike", 80); 
              set("armor_prop/finger", 80);
              set("armor_prop/cuff", 80);
             set("armor_prop/hand", 80);
             set("armor_prop/leg", 80);
             set("armor_prop/claw", 80);
             set("armor_prop/unarmed", 80);
             set("armor_prop/jing", 1000);
                set("armor_prop/jingli", 1000);
                set("armor_prop/qi", 2000);
                set("armor_prop/neili", 1000); 
             //   set("armor_prop/damage", 80);  

              
	}
	setup();
}
int query_autoload()
{
        return 1;
}

 
