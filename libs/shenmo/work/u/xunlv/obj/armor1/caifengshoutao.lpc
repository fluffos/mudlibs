// shoutao.c

#include <ansi.h>
#include <armor.h>

inherit HANDS;

void create() {
  set_name(HBMAG HIY "彩凤手套" NOR, ({ "caifeng shoutao", "shoutao" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "副");
    set("long", BRED HIY "这是一副由金丝线织造而成的手套，坚韧非凡，不谓刀剑。\n" NOR);

    set("value", 6000);
    set("material", "hands");
    set("armor_prop/armor", 100);
    set("armor_prop/parry", 35);
    set("armor_prop/dodge", 35);
    set("armor_prop/strike", 60);
    set("armor_prop/finger", 60);
    set("armor_prop/cuff", 60);
    set("armor_prop/hand", 60);
    set("armor_prop/leg", 60);
    set("armor_prop/claw", 60);
    set("armor_prop/unarmed", 60);
    set("female_only", 1);
    set("armor_prop/jing", 1000);
    set("armor_prop/jingli", 1000);
    set("armor_prop/qi", 2000);
    set("armor_prop/neili", 1000);
    set("armor_prop/damage", 100);
  }
  setup();
}
int query_autoload() {
  return 1;
}
