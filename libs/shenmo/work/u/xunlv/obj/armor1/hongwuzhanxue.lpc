// hongwuzhanxue.c 洪武战靴
#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create()
{
	set_name( BRED "洪武"HIM"战"HIC"靴" NOR, ({ "hongwu zhanxue", "zhanxue" }) );
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "双");
		set("long", BRED""HIY"这是一双随明朝洪武大帝"HIY"-朱元璋-"BRED"征战南北的战靴，做工非比寻常。上面绣有"HIM"五彩"HIC"祥云。\n"NOR);

		set("value", 300);
		set("material", "boots");
		set("armor_prop/armor", 100);
                set("armor_prop/parry", 25);
                set("armor_prop/dodge", 25);
                set("armor_prop/jing", 1000);
                set("armor_prop/jingli", 1000);
                set("armor_prop/qi", 2000);
                set("armor_prop/neili", 1000); 
                  

                 
	}
	setup();
}
int query_autoload()
{
        return 1;
}

 
