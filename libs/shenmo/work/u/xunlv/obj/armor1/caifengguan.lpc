// toukui.c 头盔

#include <armor.h>
#include <ansi.h>


inherit HEAD;

void create() {
  set_name(HBMAG HIC "彩" HIY "凤" HIW "冠" NOR, ({ "caifeng guan", "guan" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "steel");
    set("unit", "顶");
    set("long", HBMAG HIC "这是一顶明朝马皇后凤冠，做工非比寻常，并且镶有500多棵稀有珍珠。\n" NOR);
    set("value", 11500);
    set("armor_prop/armor", 150);
    set("armor_prop/parry", 30);
    set("armor_prop/dodge", 35);
    set("female_only", 1);
    set("armor_prop/jing", 1000);
    set("armor_prop/jingli", 1000);
    set("armor_prop/qi", 3000);
    set("armor_prop/neili", 1000);
  }
  setup();
}
int query_autoload() {
  return 1;
}
