// huwan.c 护腕

#include <ansi.h>
#include <armor.h>

inherit WRISTS;

void create() {
  set_name(HBMAG HIC "彩凤护腕" NOR, ({ "caifeng huwan", "huwan", }));
  set_weight(60);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", HBMAG HIC "这是一双彩凤护腕，是当年马皇后战甲配套的装备，非常华丽。\n" NOR);

    set("value", 18300);
    set("material", "cloth");
    set("armor_prop/armor", 100);
    set("armor_prop/parry", 40);
    set("armor_prop/dodge", 40);
    set("armor_prop/strike", 80);
    set("armor_prop/finger", 80);
    set("armor_prop/cuff", 80);
    set("armor_prop/hand", 80);
    set("armor_prop/leg", 80);
    set("armor_prop/claw", 80);
    set("armor_prop/unarmed", 80);
    set("female_only", 1);
    set("armor_prop/jing", 1000);
    set("armor_prop/jingli", 1000);
    set("armor_prop/qi", 2000);
    set("armor_prop/neili", 1000);
  }
  setup();
}
int query_autoload() {
  return 1;
}
