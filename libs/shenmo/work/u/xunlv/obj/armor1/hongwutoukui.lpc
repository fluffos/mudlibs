// toukui.c 头盔

#include <armor.h>
#include <ansi.h>


inherit HEAD;

void create() {
  set_name(BRED HIY "洪武金盔" NOR, ({ "hongwu jinkui", "jinkui" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "steel");
    set("unit", "顶");
    set("long", BRED "" HIY "这是一顶随明朝洪武大帝" HIY "-朱元璋-" BRED "征战南北的头部全盔，做工非比寻常，上面雕有日月星辰。\n" NOR);
    set("value", 11500);
    set("armor_prop/armor", 150);
    set("armor_prop/parry", 35);
    set("armor_prop/dodge", 35);
    set("armor_prop/jing", 1000);
    set("armor_prop/jingli", 1000);
    set("armor_prop/qi", 2000);
    set("armor_prop/neili", 1000);



  }
  setup();
}
int query_autoload() {
  return 1;
}
