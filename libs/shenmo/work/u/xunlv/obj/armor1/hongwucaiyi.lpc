// cloth.c
//
// This is the basic equip for players just login.
#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name(HBRED "洪武"HIM"彩"HIC"衣"NOR, ({ "hongwu caiyi", "caiyi" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件"); 
                set("long", BRED""HIY"这是一件明朝洪武大帝"HIY"-朱元璋-"BRED"的御用战衣，做工非比寻常。\n"
                "上面绣有九条五爪龙纹，以五彩祥云环绕，前后还绣有福寿无疆的字样和日月星辰，山川流水。\n"NOR);
                set("material", "cloth");
                set("value", 60000);
                set("armor_prop/armor", 500);
                
                set("armor_prop/parry", 100);
                set("armor_prop/dodge", 100);
                set("armor_prop/jing", 3000);
                set("armor_prop/jingli", 3000);
                set("armor_prop/qi", 15000);
                set("armor_prop/neili", 3000); 


        }
        setup();
}

int query_autoload()
{
        return 1;
}

 
