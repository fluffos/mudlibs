// huyao.c

#include <ansi.h>
#include <armor.h>

inherit WAIST;

void create()
{
	set_name( BBLU HIY "洪武腰带"NOR, ({ "hongwu yaodai", "yaodai"}) );
	set_weight(30);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", BBLU HIY"这是一条明朝洪武大帝-朱元璋-的御用腰带，做工非比寻常。\n"
                "上面绣有蛟龙出海，以祥云环绕。\n"NOR);

		set("value", 11600);
		set("armor_prop/armor", 80);
                set("armor_prop/parry", 35);
                set("armor_prop/dodge", 25);
                set("armor_prop/jing", 1000);
                set("armor_prop/jingli", 1000);
                set("armor_prop/qi", 2000);
                set("armor_prop/neili", 1000); 
                  

                
	}
	setup();
}
int query_autoload()
{
        return 1;
}

 
