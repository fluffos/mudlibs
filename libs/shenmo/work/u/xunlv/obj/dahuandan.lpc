#include <ansi.h>
inherit COMBINED_ITEM;

void create()
{
   set_name("大还丹", ({"dahuan dan", "dahuan","dahuandan", "dan"}));
   if (clonep())
      set_default_object(__FILE__);
   else {
      set("unit", "些");
      set("heal_up", 1);
      set("long","这是一粒疗伤圣药，萃取多种稀世中藥精華提煉而成。你可以(fu dan)来使用它。\n");
      set("value", 55000);
      set("base_unit", "粒");
      set("base_weight", 10);
   }
   set_amount(1);
}

int init()
{
   add_action("do_eat", "fu");
}

int do_eat(string arg)
{

   if(!id(arg))
       return notify_fail("你要吃什么？\n");

        if ((int)this_player()->query("eff_qi") == 
       (int)this_player()->query("max_qi"))
           return notify_fail("你现在不需要用回阳五龙膏。\n");
   else {
        this_player()->receive_curing("qi", 800+random(800));
        message_vision("$N服下一粒大还丹，脸色看起来好多了。\n", this_player());
        this_player()->start_busy(1);
        add_amount(-1);
        return 1;
        }
}

