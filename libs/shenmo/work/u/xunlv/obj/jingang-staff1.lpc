// youlong.c

#include <weapon.h>
#include <ansi.h>
inherit STAFF;
inherit F_UNIQUE;

void create()
{
        set_name(HIW"精钢杖"NOR, ({ "jingang zhang", "zhang", "staff" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                
                set("rigidity", 1);
                set("sharpness", 1);
                set("long",
"这是一把精钢锻造的拐杖，仔细一看，棒身上有几条细纹闪烁不定。\n");
                set("value", 50000);
                set("weapon_prop/dodge", 20);
                set("weapon_prop/staff", 50);
                set("weapon_prop/parry", 50);
                set("wield_msg", 
"只听见「飕」地一声，$N的手中已经多了一柄寒光四射的精钢杖——$n。\n");
                
                set("unequip_msg", "$N将手中的$n收起来了。\n");
        }
        init_staff(200);
        setup();
}
int query_autoload()
{
        return 1;
}

void owner_is_killed()
{
        destruct(this_object());
} 

