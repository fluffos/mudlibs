// haotiandan.c  浩天丹

#include <ansi.h>

inherit ITEM;


void init() {
  add_action("do_eat", "fu");
}

void create() {
  set_name(HIG "新人经验潜能丹" NOR, ({ "xinren dan", "xinren", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗新人丹，你可以fu dan来使用。吃了以后可以给经验和潜能、内力精力奖励，就可以去外面的世界了。\n");
    set("value", 100);


  }



  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  if (me->query("combat_exp") >= 60999)
    return notify_fail("以你现在的修为，此丹对你已经没有效果了。\n");

  if (me->query("combat_exp") < 0) {
    return notify_fail("以你目前的修为还承受不了此丹药力。\n");



  } else {
    me->add("combat_exp", 99999);
    me->add("max_neili", 1200);
    me->add("max_jingli", 1200);
    me->add("max_jing", 300);
    me->add("max_qi", 500);
    me->add("qi", 500);
    me->add("jing", 300);
    me->add("eff_jing", 300);
    me->add("eff_jingli", 1200);
    me->add("jingli", 1200);
    me->add("neili", 1200);

    me->add("potential", 50000);
    message_vision(HIG "$N吃下一颗新人丹，你的经验和潜能增加了99999，你的内力、精力、精增加了 !\n" NOR, me);
  }



  destruct(this_object());
  return 1;
}
