// haotiandan.c  浩天丹

#include <ansi.h>

inherit ITEM;

 
void init()
{
	add_action("do_eat", "fu");
}

void create()
{
	set_name(HIR"阴阳丹"NOR, ({"yinyang dan", "yinyang", "dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "颗");
		set("long", "这是一颗传说中的阴阳丹，其原料采自灵山峭壁。据说吃了能让人增加功力。\n");
		set("value", 0);
		set("no_drop", "这样东西不能离开你。\n");
             
             }

	

	setup();
}

int do_eat(string arg)
{
	object me = this_player();

	if (!id(arg))
	return notify_fail("你要吃什么？\n");

	if (me->query("combat_exp")>170000000 )
                return notify_fail("以你现在的修为，此丹对你已经没有效果了。\n");
        
        if (me->query("combat_exp")<1000000 ){
                return notify_fail("以你目前的修为还承受不了此丹药力。\n");


	
	}
	else
	{
		me->add("combat_exp", 500 + random(500));
             me->add("potential", 250 + random(250));
		message_vision(HIG "$N吃下一颗阴阳丹，只觉得气血充盈，真气鼓荡，你的实战经验和潜能提高了 !\n" NOR, me);
	}

	
	
	destruct(this_object());
	return 1;
}

