// haotiandan.c  浩天丹

#include <ansi.h>

inherit ITEM;


void init() {
  add_action("do_eat", "fu");
}

void create() {
  set_name(HBMAG "节日奖励补偿丹" NOR, ({ "buchang dan", "buchang", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗可以用来增进功力的灵丹，炼制非常的困难，所以价格昂贵。\n");
    set("value", 1000000);


  }



  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");



  if (me->query("combat_exp") < 0) {
    return notify_fail("以你目前的修为还承受不了此丹药力。\n");



  } else {
    me->add("combat_exp", 100000);


    me->add("potential", 60000);
    message_vision(HBRED "$N吃下一颗节日奖励补偿丹，你觉得一股强劲的内息在体内运转 !\n" NOR, me);
  }



  destruct(this_object());
  return 1;
}
