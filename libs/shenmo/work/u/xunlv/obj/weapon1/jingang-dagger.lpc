// youlong.c

#include <weapon.h>
#include <ansi.h>
inherit F_DAGGER;
inherit COMBINED_ITEM;
inherit F_EQUIP;

void create()
{
        set_name(HIW"精钢匕首"NOR, ({ "jingang bishou", "bishou", "dagger" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                
                set("rigidity", 1);
                set("sharpness", 1);
                set("long",
"这是一把精钢锻造的匕首，仔细一看，棒身上有几条细纹闪烁不定。\n");
                set("value", 50000);
                set("weapon_prop/dodge", 9);
                set("weapon_prop/parry", 1);
                set("wield_msg", 
"只听见「飕」地一声，$N的手中已经多了一条寒光四射的精钢匕首——$n。\n");
                
                set("unequip_msg", "$N将手中的$n收起来了。\n");
        }
        init_dagger(72);
        setup();
}
