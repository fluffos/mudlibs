// wolong-staff 卧龙杖皇陵终极杖
//By KinGSo 06.12.27凌晨

#include <weapon.h>
#include <ansi.h>
inherit STAFF;
inherit F_UNIQUE;

void create() {
  set_name(HBYEL HIW "卧龙杖" NOR, ({ "wolong zhang", "zhang", "staff" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");

    set("rigidity", 12);
    set("sharpness", 20);

    set("long", HBYEL HIW
      "这是明朝时期的神兵之一【卧龙杖】，后随着明朝的灭亡而消失在江湖中。\n"
      "此乃追随明朝开国元勋李善长征战南北的卧龙杖，也是当世神兵。\n"
      "杖上一行小字：太师中书左丞相录军国重事兼太子少师韩国公--李善长\n" NOR);
    set("value", 150000);
    set("weapon_prop/dodge", 2);
    set("weapon_prop/parry", 15);
    set("weapon_prop/staff", 140);
    set("wield_msg", HBYEL HIW
      "只听见「飕」地一声，$N的手中已经多了一柄【卧龙杖】——$n。\n" NOR);

    set("unequip_msg", HBYEL HIW "$N将手中的$n收起来了。\n" NOR);
  }
  init_staff(350);
  setup();
}
int query_autoload() {
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int n;
  int my_exp, ob_exp;

  if (me->is_bad() || victim->is_good())
    return -damage_bonus / 2;

  if (me->is_not_good() || victim->is_not_bad())
    return 0;


  switch (random(6)) {
    case 0:

      n = me->query_skill("staff");
      victim->receive_damage("qi", n * 2, me);
      victim->receive_wound("qi", n, me);

      return HBYEL HIW "$N" HBYEL HIW "大喝一声，挥舞起手中" NOR + HBYEL HIW "【卧龙杖】" NOR + HBYEL HIW "朝$n" HBYEL HIW "迅速攻来。\n" NOR;



    case 1:
      n = me->query_skill("staff");
      victim->receive_damage("qi", n * 2, me);
      victim->receive_wound("qi", n, me);


      return HBYEL HIW "$N" HBYEL HIW "大喝一声，挥舞起手中" NOR + HBYEL HIW "【卧龙杖】" NOR + HBYEL HIW "朝$n" HBYEL HIW "迅速攻来。\n" NOR;



  }
  return damage_bonus;
}
