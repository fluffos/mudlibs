// tianji-stick.c 飞翼剑皇陵终极剑
//By KinGSo 06.12.27凌晨
//终于作完了。。Counter..OppO给个Kiss鼓励不？嘿嘿

#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE;

void create()
{
        set_name( HBYEL HIY"飞翼剑"NOR, ({ "feiyi jian", "jian", "sword" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                
               
                set("long",HBYEL HIY
"这是明朝时期的神兵之一【飞翼剑】，后随着明朝的灭亡而消失在江湖中。\n"
"这就是当年明朝皇后马秀英的佩剑，此剑有意：比翼双飞！\n"
"剑身细长，上雕有寓意在天愿做比翼鸟，在地愿为连理枝的图案。\n"
"历经如此之长的岁月侵蚀，剑身丝毫没有磨损得痕迹，可知其非一般神兵利器。\n"NOR);
                set("value", 150000);
                set("weapon_prop/dodge", 75);
                set("weapon_prop/parry", 75);
                set("weapon_prop/sword", 50);
                set("rigidity", 12);
                set("sharpness", 20);
                 
                

                set("wield_msg",HBYEL HIY
"只见寒光一闪，宝剑出鞘。$N的手中【飞翼剑】挽起一团剑花，光影交替。\n"NOR);
                
                set("unequip_msg",HBCYN HIY "$N将手中的$n插入腰间的剑鞘。\n"NOR);
        }
        init_sword(280);
        setup();
}

int query_autoload()
{
        return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int n;
        int my_exp, ob_exp;

        if (me->is_bad() || victim->is_good())
                return - damage_bonus / 2;

        if (me->is_not_good() || victim->is_not_bad())
                return 0;

       
               

        switch (random(6))
        {
        case 0:
                victim->start_busy(me->query_skill("sword") / 200 + 1);
                 n = me->query_skill("sword");
                 victim->add_condition("liuxuelv3", n/100);

                return HBYEL HIY"$N" HBYEL HIY"跨前一步，手中的" NOR + HBYEL HIY"飞翼剑" NOR
                       + HBYEL HIY"发出一道道剑气，向$n" HBYEL HIY"逼去，剑气凌厉之极。"
                       "$n" HBYEL HIY"大吃一\n惊，不知如何抵挡，只有连连后退！\n" NOR;

        case 1:
                n = me->query_skill("sword");
                victim->receive_damage("qi", n*2, me);
                victim->receive_wound("qi", n, me);
                victim->receive_damage("neili", n, me);

                
                return random(2) ? HBYEL HIY"$N" HIY "一声长吟，手中的飞翼剑挽起一"
                                   "朵朵剑花,非常的华丽，朝$n" HBYEL HIY"而去！\n" NOR:
                                   HBYEL HIY"$N" HBYEL HIY"突然大声喝道：“看招！”速度突然加快"
                                   "手中飞翼剑幻化出无数剑花" HIY "一层叠一层，$n"
                                   HBYEL HIY"登时觉得眼花缭乱！\n" NOR;

        }

       
}


 
