// wangqing-whip.c冷羽箫皇陵终极箫
// by KinGSo 2006.12.26

#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE;

void create()
{
        set_name(HBMAG HIG"冷羽箫"NOR, ({ "lengyu xiao", "xiao" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "支");
                
                 set("rigidity", 12);
                set("sharpness", 20);
                 
                set("long", HBMAG HIG
"这是明朝时期的神兵之一【冷羽箫】，后随着明朝的灭亡而消失在江湖中。\n"
"此箫是由上古寒玉整体雕琢而成，箫身雕有羽毛状图案，精致华美。\n"
"无论日晒又或火烤总是通体冰凉。故名曰：冷羽！背面有一行小字：\n"
"【一缕情丝，两行清泪，渍透千重铁。】\n"NOR);
                set("value", 150000);
                set("weapon_prop/dodge", 100);
                set("weapon_prop/parry", 50);
                set("weapon_prop/sword", 50);
                set("wield_msg", HBMAG HIG
"只见$N一个旋身，动作十分潇洒，一支冷羽箫已经来到手中。\n"NOR);
                
                set("unequip_msg", HBMAG HIG"$N将手中的$n收起来了。\n"NOR);
        }
        init_sword(230);
        setup();
}
int query_autoload()
{
        return 1;
}

int wield() 
{
        object me = environment();
        if (living(me) && me->query_skill("yuxiao-jian", 1) < 100
        	 ||living(me) && me->query_skill("art", 1)< 100 )
        	  {
            message_vision("$N拿起"+name()+"，但是不会使用。\n", me);
            return 0;
        }           
        if(!query("weapon_prop/damage")) return 0;
        return ::wield();
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int n;
        int my_exp, ob_exp;

        if (me->is_bad() || victim->is_good())
                return - damage_bonus / 2;

        if (me->is_not_good() || victim->is_not_bad())
                return 0;


        switch (random(10))
        {
        case 0:
                
                
                victim->start_busy(2+ random(2));
               
                return HBMAG HIG"$N" HBMAG HIG"往" NOR + HBMAG HIG"【冷羽箫】中被注入一道真气，顿时" NOR
                       HBMAG HIG"【冷羽箫】发出一阵奇妙的旋律，犹如天籁之音非常之动听。可听在$n耳里，\n"
                       HBMAG HIG"却让$n感觉燥热难当，真气乱窜。突然$n哇的一声吐出一口鲜血显然是受了内伤。\n" NOR;


        case 1:
                
                
                COMBAT_D->do_attack(victim, victim, victim->query_temp("weapon"), 3);

                return             HBMAG HIG"$N" HBMAG HIG"手中的【冷羽箫】由于真气鼓荡。奏出阵阵美妙的旋律。"
                                   "$n被此天籁般的旋律所迷惑，听得非常入迷。" HBMAG HIG"\n""仿佛忘记了自己"
                                   HBMAG HIG"正在和对手搏斗。突然$n表情十分古怪，竟然打起自己来了。\n" NOR;

        }
        return damage_bonus;
}
 



 