// yemu-dagger.c 夜幕匕首皇陵终极匕首
// by KinGSo 2006.12.26

#include <weapon.h>
#include <ansi.h>

inherit F_DAGGER;
inherit COMBINED_ITEM;
inherit F_EQUIP;

void set_amount(int v)
{
        object owner = environment();
        if (v >= 0) {
                set("weapon_prop/damage", v * (int)query("base_damage"));
                set("rigidity", v * query("base_rigidity"));
                if (query("equipped") && objectp(owner)) {
                        owner->set_temp("apply/damage", query("weapon_prop/damage") );
                }
        }
        ::set_amount(v);
}

void add_amount(int v) { set_amount((int)query_amount()+v); }

void create()
{
        set_name(HBBLU HIW"夜幕匕首"NOR, ({ "yemu bishou","bishou", "dagger" }));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("base_unit", "柄");
                set("base_weight", 500);
                 set("rigidity", 12);
                set("sharpness", 20);
                 
                set("long",HBBLU HIW
"这是明朝时期的神兵之一【夜幕匕首】，后随着明朝的灭亡而消失在江湖中。\n"
"其匕身细长,且浑黑，如夜幕降临。匕身两边有两条深深的矩形血槽，柄上镶有5颗不知其质地的宝石，华丽无比。\n"NOR);

                set("value", 150000);
                set("material", "steel"); 
                set("base_damage", 350);
                set("weapon_prop/dagger", 200);
                
                set("wield_msg", HBBLU HIW"$N悄悄的掏出一柄夜幕匕首握在手中。\n"NOR);
                set("unwield_msg", HBBLU HIW"$N将手中的$n插回腰间。\n"NOR);
        }
        set_amount(1);
        init_dagger(350);
        setup();
}
int query_autoload()
{
        return 1;
}


mixed hit_ob(object me, object victim, int damage_bonus)
{
        int n;
        int my_exp, ob_exp;

        if (me->is_bad() || victim->is_good())
                return - damage_bonus / 2;

        if (me->is_not_good() || victim->is_not_bad())
                return 0;


        switch (random(6))
        {
        case 0:
                
                 n = me->query_skill("dagger");
                victim->add_condition("liuxuelv1", n/40);
                return HBBLU HIW "$N" HBBLU HIW "一个闪身，身法突然增速" NOR + HBBLU HIY "【夜幕匕首】" NOR
                       + HBBLU HIW "象是一道闪电般，飞速朝$n" HBBLU HIW "空门处袭来，动作迅捷诡异至极。"
                       "$n" HBBLU HIW "大吃一\n惊，只觉得胸前一阵剧痛，匕首没入身体只见刀柄！拔出时带出一股鲜血。\n" NOR;


        case 1:
                n = me->query_skill("dagger");
                 victim->add_condition("liuxuelv3", n/100);
                

                return             HBBLU HIW"$N" HBBLU HIW "突然身法加速，飘忽不定，"
                                   "使用的招数怪异毒辣，显然是想于数招内了解对方" HBBLU HIW  "，$n"
                                   HBBLU HIW  "登时觉得眼花缭乱，空门大露！\n" NOR;

        }
        return damage_bonus;
}


