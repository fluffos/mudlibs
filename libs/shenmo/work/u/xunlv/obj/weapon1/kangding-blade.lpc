// youlong.c

#include <weapon.h>
#include <ansi.h>
inherit BLADE;
inherit F_UNIQUE;

void create() {
  set_name(HIR "康定宝刀" NOR, ({ "kangding baodao", "dao", "blade" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");

    set("rigidity", 5);
    set("sharpness", 5);
    set("treasure", 1);
    set("unique", 1);

    set("long",
      "这是一把康熙皇朝，由康熙大帝亲自督造的一把宝刀，仔细一看，刀身上泛着淡淡的寒光。\n");
    set("value", 0);
    set("weapon_prop/dodge", 10);
    set("weapon_prop/parry", 25);
    set("wield_msg",
      "只听见「飕」地一声，$N的手中已经多了一把寒光四射的宝刀——$n。\n");

    set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
  }
  init_blade(120);
  setup();
}
