// jufeng-axe.c 飓风斧皇陵终极斧
// by KinGSo 2006.12.26

#include <weapon.h>
#include <ansi.h>
inherit AXE;
inherit F_UNIQUE;

void create()
{
        set_name(BBLU HIR"飓风斧"NOR, ({ "jufeng fu", "fu", "axe" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                
                 set("rigidity", 12);
                set("sharpness", 12);
                 
                set("long",BBLU HIR
"这是明朝时期的神兵之一【飓风斧】，后随着明朝的灭亡而消失在江湖中。\n"
"此斧乃明朝开国功臣常遇春当年使用过的。由玄铁所铸，锋利坚硬无比。\n"
"斧柄上刻有：太保中书平章军国重事兼太子少保鄂国公--常遇春\n"NOR);
                set("value", 150000);
                set("weapon_prop/dodge", -50);
                set("weapon_prop/parry", -50);
                set("weapon_prop/axe", 200);
                set("wield_msg",BBLU HIR 
"$N抄起手中飓风斧挥舞了一番，周围突生劲风，好不威武。\n"NOR);
                
                set("unequip_msg", BBLU HIR"$N将手中的飓风斧扛在了肩上。\n"NOR);
        }
        init_axe(420);
        setup();
}
int query_autoload()
{
        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int n;
        int my_exp, ob_exp;

        if (me->is_bad() || victim->is_good())
                return - damage_bonus / 2;

        if (me->is_not_good() || victim->is_not_bad())
                return 0;


        switch (random(6))
        {
        case 0:
                
                 n = me->query_skill("axe");
                victim->receive_damage("qi", n*2, me);
                victim->receive_wound("qi", n, me);

                return BBLU HIR"$N" BBLU HIR"大喝一声，手中" NOR + BBLU HIR"【飓风斧】" NOR
                       + BBLU HIR"开山裂石般，朝$n"BBLU HIR"迎面劈来。\n"NOR;
                       


        case 1:
                n = me->query_skill("axe");
                 victim->receive_damage("qi", n*2, me);
                victim->receive_wound("qi", n, me);


                return BBLU HIR"$N" BBLU HIR"大喝一声，手中" NOR + BBLU HIR"【飓风斧】" NOR
                       + BBLU HIR"开山裂石般，朝$n"BBLU HIR"迎面劈来。\n"NOR;


        }
        return damage_bonus;
}

 
