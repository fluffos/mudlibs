// wangqing-whip.c忘情鞭皇陵终极鞭
// by KinGSo 2006.12.26

#include <weapon.h>
#include <ansi.h>
inherit WHIP;
inherit F_UNIQUE;

void create()
{
        set_name(HBMAG HIC"忘情鞭"NOR, ({ "wangqing bian", "bian", "whip" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                
                 set("rigidity", 12);
                set("sharpness", 12);
                 
                set("long",HBMAG HIC
"这是明朝时期的神兵之一【忘情鞭】，后随着明朝的灭亡而消失在江湖中。\n"
"此鞭乃当年明朝开国大臣刘伯温的随身兵器，鞭长近一丈，是由奇兽身上所取得的筋制成，坚韧无比。\n"
"其鞭身通过特别的工艺，由巧匠镶入了一些玄铁锁片，大大的增强了它的威力。鞭柄由纯金所制，刻有一首词:\n"
"昨夜京东雪，今日海南风。人间冷暖交替，变化一天中。\n"
"处处花红草绿，阵阵莺声燕语，哪里是隆冬？\n"
"海角天涯里，春色正无穷。儋州府，荔枝国，访苏公。\n"
"四黎左近，寻向藤竹觅遗踪。\n"
"有幸对床吟读，只愿忘情诗酒，醉卧五更钟。\n"
"何惧龙颜怒，时代不相同！\n"NOR);
                set("value", 150000);
                set("weapon_prop/parry", 200);
                set("wield_msg", HBMAG HIC
"只听见「啪」地一声脆响，$N的手中【忘情鞭】一抖，豪气云天，长啸一声。\n"NOR);
                
                set("unequip_msg", HBMAG HIC"$N将手中的$n卷了几卷收了起来。\n"HBMAG HIC);
        }
        init_whip(240);
        setup();
}
int query_autoload()
{
        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int n;
        int my_exp, ob_exp;

        if (me->is_bad() || victim->is_good())
                return - damage_bonus / 2;

        if (me->is_not_good() || victim->is_not_bad())
                return 0;


        switch (random(6))
        {
        case 0:
                
                 n = me->query_skill("whip");
                victim->start_busy(2 + random(3));
                return HBMAG HIC"$N" HBMAG HIC"将手中的" NOR + HBMAG HIC"【忘情鞭】挥舞起来" NOR
                       + HBMAG HIC"犹如蛟龙出海，鞭影一层套一层。$n" HBMAG HIC"见如此环环相扣的层层鞭影，\n"
                       "$n" HBMAG HIC"心生恐惧方寸大乱。不由得节节败退。\n" NOR;


        case 1:
                n = me->query_skill("whip");
                victim->add_condition("liuxuelv3", n/100);
                

                return             HBMAG HIC"$N" HBMAG HIC"手一挽，【忘情鞭】化作一道黑影，朝$n卷了过去。"
                                   "$n正想破入鞭影的中心化解此招。" HBMAG HIC"。\n""结果【忘情鞭】突然变招，"
                                   HBMAG HIC"卷住$n的$l,用力一扯将其硬生生的撕裂开来。\n" NOR;

        }
        return damage_bonus;
}
 

