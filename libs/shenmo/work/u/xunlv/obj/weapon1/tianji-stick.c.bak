// tianji-stick.c 天极棒皇陵终极棒
//By KinGSo 06.12.27凌晨
//写得头晕眼花，没有墨水鸟。。
#include <weapon.h>
#include <ansi.h>
inherit STICK;
inherit F_UNIQUE;

void create()
{
        set_name(HBBLU HIC"天极棒"NOR, ({ "tianji bang", "bang", "stick" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                
                 set("rigidity", 12);
                set("sharpness", 12);
                 
                set("long",HBBLU HIC
"这是明朝时期的神兵之一【天极棒】，后随着明朝的灭亡而消失在江湖中。\n"
"这就是当年追随徐达南征北战的神兵【天极棒】。\n"
"棒身上刻有一行小字：太傅中书右丞相参军国事兼太子少傅魏国公--徐达\n"NOR);
                set("value", 150000);
                set("weapon_prop/dodge", 30);
                set("weapon_prop/parry", 120);
                set("weapon_prop/stick", 50);
                set("wield_msg", 
"只听见「飕」地一声，$N的手中已经多了一根天极棒——$n。\n");
                
                set("unequip_msg", "$N将手中的$n收起来了。\n");
        }
        init_stick(240);
        setup();
}
int query_autoload()
{
        return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int n;
        int my_exp, ob_exp;

        if (me->is_bad() || victim->is_good())
                return - damage_bonus / 2;

        if (me->is_not_good() || victim->is_not_bad())
                return 0;


        switch (random(6))
        {
        case 0:
                
                 n = me->query_skill("stick");
                victim->receive_damage("qi", n*2, me);
                victim->receive_wound("qi", n, me);

                return HBBLU HIC"$N" HBBLU HIC"凝神聚气，中" NOR + HBBLU HIC"【天极棒】" NOR
                       + HBBLU HIC"使出一套极细腻的招数，朝$n"HBBLU HIC"的【百会穴】戳去。\n"NOR;
                       


        case 1:
                victim->start_busy(me->query_skill("stick") / 200 + 2);
                 

                return HBBLU HIC"$N" HBBLU HIC"一个回身，手中" NOR + HBBLU HIC"【天极棒】" NOR
                       + HBBLU HIC"伸向$n"HBBLU HIC"的脚下，就那么随意的一绊，将$n绊了一个狗吃屎。\n"NOR;



        }
        return damage_bonus;
}
 

 
