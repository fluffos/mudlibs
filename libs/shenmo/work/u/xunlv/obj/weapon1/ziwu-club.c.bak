// ziwu-club.c子午棍皇陵终极棍
// by KinGSo 2006.12.26

#include <weapon.h>
#include <ansi.h>
inherit CLUB;
inherit F_UNIQUE;

void create()
{
        set_name(HBRED HIC"子午棍"NOR, ({ "ziwu gun", "gun", "club" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                
                 set("rigidity", 12);
                set("sharpness", 12);
                
                set("long",HBRED HIC
"这是明朝时期的神兵之一【子午棍】，后随着明朝的灭亡而消失在江湖中。\n"
"此棍是由千年乌木整体成型，坚韧无比，不畏刀剑。\n"
"根身刻有几行字，再嵌以纯金十分好看。题曰：\n"
"子午流注者，谓刚柔相配，阴阳相合，气血循环，\n"
"时穴开阖也。何以子午言之？曰：子时一刻，乃一阳之生；\n"
"至午时一刻，乃一阴之生，故以子午分之而得乎中也。\n"NOR);
                set("value", 150000);
                set("weapon_prop/dodge", 20);
                set("weapon_prop/parry", 80);
                set("weapon_prop/club", 100);
                set("wield_msg", 
"只听见「飕」地一声，$N的手中已经多了一根通体乌黑的【子午棍】。\n");
                
                set("unequip_msg", "$N将手中的$n收起来了。\n");
        }
        init_club(300);
        setup();
}
int query_autoload()
{
        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int n;
        int my_exp, ob_exp;

        if (me->is_bad() || victim->is_good())
                return - damage_bonus / 2;

        if (me->is_not_good() || victim->is_not_bad())
                return 0;


        switch (random(10))
        {
        case 0:
                
                 n = me->query_skill("club");
                
                victim->add_condition("canying", n/100);


                return HBRED HIC"$N" HBRED HIC"手中" NOR + HBRED HIC"【子午棍】" NOR
                       + BBLU"幻化作"HBRED HIC"道道残影，令$n分辨不清哪条真那条假。一时间愣在当场，不知如何是好。\n"NOR;
                       


        case 1:
               if ( me->is_fighting(victim))
		COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), random(4)?1:3);
               if ( me->is_fighting(victim))
		COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), random(4)?1:3);
               



                return HBRED HIC"$N" HBRED HIC"舞起手中" NOR + HBRED HIC"【子午棍】" NOR
                       + HBRED HIC"一时间【子午棍】仿佛化作无数条棍影一齐攻向"HBRED HIC"$n。\n"NOR;


        }
        return damage_bonus;
}


 
