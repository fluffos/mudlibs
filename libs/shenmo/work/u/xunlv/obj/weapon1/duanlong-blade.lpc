// tianji-stick.c 断龙刀皇陵终极刀
//By KinGSo 06.12.27凌晨
//要吐鸟。。
#include <weapon.h>
#include <ansi.h>
inherit BLADE;
inherit F_UNIQUE;

void create()
{
        set_name(HBBLU HIY"断龙刀"NOR, ({ "duanlong dao", "dao", "blade" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                
                 set("rigidity", 12);
                set("sharpness", 20);
                
                set("long",HBBLU HIY
"这是明朝时期的神兵之一【断龙刀】，后随着明朝的灭亡而消失在江湖中。\n"
"此刀乃当年洪武皇帝朱元璋的御用宝刀。其刀身宽而厚实，但刀刃十分的锋利。\n"
"刀身上面有九霄龙吟的图案，是锻造的时候由精工巧匠敲打出来的暗纹所构成，\n"
"光是这道工艺就可让此刀位列极品。其制刀的材料只知是由天外玄石提炼而成，\n"
"削铁如泥，吹毛可断。再细看上面的图案，那条龙仿佛活了过来，似要龙腾九霄般飞去。\n"NOR);
                set("value", 150000);
                set("weapon_prop/dodge", 50);
                set("weapon_prop/parry", 100);
                set("weapon_prop/blade", 50);
                

                set("wield_msg",HBBLU HIY 
"仿佛听见一阵龙吟声，$N手中的【断龙刀】已然出鞘，威风凛凛，有股君临天下的气势。\n"NOR);
                
                set("unequip_msg",HBBLU HIY "$N将手中的$n插入腰间的剑鞘。\n"NOR);
        }
        init_blade(320);
        setup();
}
int query_autoload()
{
        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int n;
        int my_exp, ob_exp;

        if (me->is_bad() || victim->is_good())
                return - damage_bonus / 2;

        if (me->is_not_good() || victim->is_not_bad())
                return 0;


        switch (random(6))
        {
        case 0:
                
                 n = me->query_skill("blade");
                victim->receive_damage("qi", n*2, me);
                victim->receive_wound("qi", n, me);
                victim->receive_damage("neili", n, me);

                return HBBLU HIY"$N" HBBLU HIY"凝神聚气，腾空飞起" NOR + HBBLU HIY"手中【断龙刀】" NOR
                       + HBBLU HIY"朝$n"HBBLU HIY"发出一股霸道的刀气，隔空击中$n的$l。\n"NOR;
                       


        case 1:
                victim->start_busy(me->query_skill("blade") / 200 + 1);
                 n = me->query_skill("blade");
                 victim->add_condition("liuxuelv3", n/100);


                return HBBLU HIY"$N" HBBLU HIY"一个翻越，迅速朝$n逼近，手中" NOR + HBBLU HIY"【断龙刀】" NOR
                       + HBBLU HIY"猛然"HBBLU HIY"劈下，$n还没有来得及反应，就被$N一刀劈中$l。\n"NOR;



        }
        return damage_bonus;
}
 

 
 
