// leiting-hammer.c雷霆锤皇陵终极锤
// by KinGSo 2006.12.26

#include <ansi.h>
#include <weapon.h>
inherit HAMMER;
inherit F_UNIQUE;
void create() {
  set_name(BBLU "雷霆锤" NOR, ({ "leiting chui", "fa lun", "hammer" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");

    set("rigidity", 12);
    set("sharpness", 20);

    set("long", BBLU
      "这是明朝时期的神兵之一【雷霆锤】，后随着明朝的灭亡而消失在江湖中。\n"
      "此锤乃明朝开国功臣李文忠当年使用过的。由玄铁所铸，锤身雕有猛虎下山图。\n"
      "锤面上刻有：大都督府左都督同知军国事兼领国子监事曹国公--李文忠\n" NOR);

    set("value", 150000);
    set("weapon_prop/dodge", -50);
    set("weapon_prop/parry", -50);
    set("weapon_prop/hammer", 200);

    set("material", "gsbil");
    set("wield_msg", BBLU
      "只听见「飕」地一声，$N的手中已经多了一条寒光四射的雷霆锤——$n。\n" NOR);

    set("unequip_msg", "$N将手中的$n收起来了。\n");
  }
  init_hammer(390);
  setup();
}
int query_autoload() {
  return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int n;
  int my_exp, ob_exp;

  if (me->is_bad() || victim->is_good())
    return -damage_bonus / 2;

  if (me->is_not_good() || victim->is_not_bad())
    return 0;


  switch (random(6)) {
    case 0:

      n = me->query_skill("hammer");

      victim->add_condition("xuanyun", n / 100);


      return BBLU "$N" BBLU "大喝一声，手中" NOR + BBLU "【雷霆锤】" NOR + BBLU "朝$n" BBLU "凿了过来，$n闪避不急被【雷霆锤】凿中$l，顿时感觉一阵眩晕。\n" NOR;



    case 1:
      n = me->query_skill("hammer");
      victim->receive_damage("qi", n * 2, me);
      victim->receive_wound("qi", n, me);


      return BBLU "$N" BBLU "大喝一声，抡起手中" NOR + BBLU "【雷霆锤】" NOR + BBLU "砸向$n，" BBLU "$n被雷霆锤砸中$l，哇的一声,口中喷出一蓬鲜血,显然受伤颇重。\n" NOR;


  }
  return damage_bonus;
}
