// cangyue-hook.c 藏月钩皇陵终极钩
// by KinGSo 2006.12.26
#include <weapon.h>
#include <ansi.h>
inherit HOOK;
inherit F_UNIQUE;

void create()
{
        set_name(HBMAG HIY"藏月钩"NOR, ({ "cangyue gou", "gou", "hook" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                
                 set("rigidity", 12);
                set("sharpness", 20);
                
                set("long",HBMAG HIY
"这是明朝时期的神兵之一【藏月钩】，后随着明朝的灭亡而消失在江湖中。\n"
"细看钩身,上面雕有沧海映月的图案，极其精美。钩身在夜晚还会泛出淡淡地光彩，让人觉得十分神秘。\n"NOR);
                set("value", 150000);
                set("weapon_prop/dodge", 50);
                
                set("weapon_prop/hook", 150);
                set("wield_msg", HBMAG HIY
"只听见$N两手往身后一掏，手中已经多了一把寒光四射的藏月钩。细看钩身精美无比，实属极品。\n"NOR);
                
                set("unequip_msg", HBMAG HIY"$N将手中的$n收起来了。\n"NOR);
        }
        init_hook(240);
        setup();
}
int query_autoload()
{
        return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int n;
        int my_exp, ob_exp;

        if (me->is_bad() || victim->is_good())
                return - damage_bonus / 2;

        if (me->is_not_good() || victim->is_not_bad())
                return 0;


        switch (random(6))
        {
        case 0:
                
                 n = me->query_skill("hook");
                victim->add_condition("liuxuelv2", n/80);
                return HBMAG HIY "$N" HBMAG HIY "飞身跃起，手中" NOR + HBMAG HIY "【藏月钩】" NOR
                       + HBMAG HIY "象是长了眼睛般，朝$n" HBMAG HIY "处攻来，招数变化多端。"
                       "$n" HBMAG HIY "心神凝聚不敢\n怠慢，哪里知道，还是防不胜防！被钩刃割伤后背，皮开肉绽。\n" NOR;


        case 1:
                n = me->query_skill("hook");
                 victim->add_condition("liuxuelv2", n/100);
                 victim->start_busy(1+random(2));

                return             HBMAG HIY"$N" HBMAG HIY"身法加速，左突右闪，使出声东击西的伎俩，"
                                   "显然是在干扰$n对来招的判断" HBMAG HIY"。\n""$n登时有点束手无策的感觉,"
                                   HBMAG HIY"乱了阵脚！忙乱中被对手予以重创。\n" NOR;

        }
        return damage_bonus;
}

 