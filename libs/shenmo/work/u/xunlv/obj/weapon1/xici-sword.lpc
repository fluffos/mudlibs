// youlong.c

#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE;

void create()
{
        set_name(HIY"熙慈宝剑"NOR, ({ "xici baojian", "jian", "sword" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                
                 set("rigidity", 5);
                set("sharpness", 5);
                set("treasure",1);
                set("unique", 1);
                set("long",
"这是一把康熙皇朝，由康熙大帝亲自督造的一把尚方宝剑，仔细一看，剑身上仿佛游龙影现，神奇非凡。\n");
                set("value", 0);
                set("weapon_prop/dodge", 20);
                set("weapon_prop/parry", 15);
                set("wield_msg", 
"只听见「飕」地一声，$N的手中已经多了一把寒光四射的宝剑,剑身上仿佛游龙影现，神奇非凡。——$n。\n");
                
                set("unequip_msg", "$N将手中的$n插入腰间的剑鞘。\n");
        }
        init_sword(120);
        setup();
}
