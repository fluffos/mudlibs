// youlong.c

#include <weapon.h>
#include <ansi.h>
inherit WHIP;
inherit F_UNIQUE;

void create()
{
        set_name(HIW"精钢鞭"NOR, ({ "jingang bian", "bian", "whip" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                
                set("rigidity", 1);
                set("sharpness", 1);
                set("long",
"这是一把精钢锻造的鞭子，仔细一看，棒身上有几条细纹闪烁不定。\n");
                set("value", 50000);
                set("weapon_prop/dodge", 7);
                set("weapon_prop/parry", 15);
                set("wield_msg", 
"只听见「飕」地一声，$N的手中已经多了一条寒光四射的精钢鞭——$n。\n");
                
                set("unequip_msg", "$N将手中的$n收起来了。\n");
        }
        init_whip(30);
        setup();
}
