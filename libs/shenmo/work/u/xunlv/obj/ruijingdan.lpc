// puti-zi.c 菩提子

#include <ansi.h>

inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name("睿精丹", ({"ruijing dan", "dan"}));
        set_weight(10);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                                
                set("long", "这是一颗晶莹如玉的睿精丹，采自灵山峭壁，珍稀无比，\n"+
                            "经过百日丹炉真火，炼化而成。功能化百劫，渡千灾，与天地同寿。此乃增加精力的良品。\n");
                set("value", 72000);
        }
        setup();
}

int do_eat(string arg)
{
       int force_limit, neili_limit, improve;
       object me = this_player();
       force_limit = me->query_skill("force")* 10 + me->query("con")* me->query("age") + me->query("combat_exp", 1) /1000;
       neili_limit = me->query("max_jingli");
        
       if (!id(arg) || !living(me))
            return notify_fail("你要吃什么？\n");

       if ( (int)me->query_condition("medicine" ) > 10000 ){
               me->add("max_jingli", -30);
               message_vision(HIR "$N又吃下一颗睿精丹，只觉得肝肠寸断，五脏欲裂，原来服食太急太多，药效适得其反！\n" NOR, me);
       }
       else if ( neili_limit <= force_limit  ){
          if(random(10) > 5){
              improve = 10 + random(40);
              me->add("max_jingli", improve);
              me->add("eff_jingli", improve);
              message_vision(HIY "$N吃下一颗睿精丹，顿然间只觉一股浩荡无比的真气直冲顶门...\n" NOR, this_player());
              me->apply_condition("medicine", 1);
          }
          else {
              improve = 20 + random(40);
              me->add("max_jingli", improve);
              me->add("eff_jingli", improve);
              message_vision(HIY "$N吃下一颗睿精丹，顿然间只觉一股浩荡无比的真气直冲顶门...\n" NOR, this_player());
              me->apply_condition("medicine", 1); 
          }         
       }
       else message_vision(HIY "$N不顾精力修为已经到了极限，吃下一颗睿精丹。\n" NOR, this_player());
       me->unconcious();
       destruct(this_object());
       return 1;
}

