// youlong.c

#include <weapon.h>
#include <ansi.h>
inherit HAMMER;
inherit F_UNIQUE;

void create() {
  set_name(HIW "精钢锤" NOR, ({ "jingang chui", "chui", "hammer" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");

    set("rigidity", 1);
    set("sharpness", 1);
    set("long",
      "这是一把精钢锻造的重锤，仔细一看，棒身上有几条细纹闪烁不定。\n");
    set("value", 50000);
    set("weapon_prop/dodge", 50);
    set("weapon_prop/parry", 50);
    set("wield_msg",
      "只听见「飕」地一声，$N的手中已经多了一条寒光四射的精钢锤——$n。\n");

    set("unequip_msg", "$N将手中的$n收起来了。\n");
  }
  init_hammer(150);
  setup();
}
int query_autoload() {
  return 1;
}

void owner_is_killed() {
  destruct(this_object());
}
