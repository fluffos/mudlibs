// haotiandan.c  浩天丹

#include <ansi.h>

inherit ITEM;

 
void init()
{
	add_action("do_eat", "fu");
}

void create()
{
	set_name(HIG"新人潜能丹"NOR, ({"pot dan", "dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "颗");
		set("long", "这是一颗新人增加武功的丹药，经验超过130000的人无法服用，你可以fu dan来使用他。\n");
		set("value", 100000);
		
             
             }

	

	setup();
}

int do_eat(string arg)
{
       
	object me = this_player();
        
	if (!id(arg))
	return notify_fail("你要吃什么？\n");
        
        if (me->query("combat_exp") > 12000000 )
                return notify_fail("以你现在的修为，此丹对你已经没有效果了。\n");
        
        if (me->query("potential")>=30000 )
                return notify_fail("都吃这么多了，还吃？想撑死啊。\n");
        
        
        if( (int)me->query_skill("literate", 1) >= 300 ){
                return notify_fail("怎么想靠吃这个丹狂冲读书写字阿？美死你啊。\n");

        
	}
	else
	{
		
                me->add("potential", 30000 );
               
                
                
                
                
		message_vision(HIG "$N吃下一颗潜能丹，心中突然冒出一股学习的劲头来 !\n" NOR, me);
	}

	
	
	destruct(this_object());
	return 1;
}

