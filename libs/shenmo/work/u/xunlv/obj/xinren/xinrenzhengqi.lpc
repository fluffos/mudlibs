// haotiandan.c  浩天丹

#include <ansi.h>

inherit ITEM;

 
void init()
{
	add_action("do_eat", "fu");
}

void create()
{
	set_name(HIG"新人正气丹"NOR, ({"zhengqi dan", "dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "颗");
		set("long", "这是一颗新人增加正气的丹药，你可以fu dan来使用他。\n");
		set("value", 30000);
		
             
             }

	

	setup();
}

int do_eat(string arg)
{
	object me = this_player();

	if (!id(arg))
	return notify_fail("你要吃什么？\n");
        
        
        
        
        if (me->query("combat_exp")<0 ){
                return notify_fail("以你目前的修为还承受不了此丹药力。\n");

        
	}
	else
	{
		
                me->add("shen", 100000);
               
                
                
                
                
		message_vision(HIG "$N吃下一颗正气丹，顿时觉得浩然正气充满内心 !\n" NOR, me);
	}

	
	
	destruct(this_object());
	return 1;
}

