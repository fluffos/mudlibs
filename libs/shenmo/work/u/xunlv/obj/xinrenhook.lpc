// haotiandan.c  浩天丹

#include <ansi.h>

inherit ITEM;

 
void init()
{
	add_action("do_eat", "fu");
}

void create()
{
	set_name(HIG"新人基本钩法丹"NOR, ({"hook dan", "dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "颗");
		set("long", "这是一颗新人增加武功的丹药，经验超过110000的人无法服用，你可以fu dan来使用他。\n");
		set("value", 100);
		
             
             }

	

	setup();
}

int do_eat(string arg)
{
	object me = this_player();

	if (!id(arg))
	return notify_fail("你要吃什么？\n");
        
        if (me->query("combat_exp")>110000 )
                return notify_fail("以你现在的修为，此丹对你已经没有效果了。\n");
        
        
        if (me->query("combat_exp")<0 ){
                return notify_fail("以你目前的修为还承受不了此丹药力。\n");

        
	}
	else
	{
		
                me->improve_skill("hook", 550000);
               
                
                
                
                
		message_vision(HIG "$N吃下一颗武功丹，你武功进步了 !\n" NOR, me);
	}

	
	
	destruct(this_object());
	return 1;
}

