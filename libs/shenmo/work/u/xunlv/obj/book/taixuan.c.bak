// taixuan.c  太玄经秘籍
//By kingso 06 12
#include <ansi.h>

inherit ITEM;

 
void init()
{
	add_action("do_eat", "xuexi");
}

void create()
{
	set_name(HIG"太玄经"NOR, ({"tixuan miji", "miji", "book"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是一本《太玄经》秘籍,里面详细的记录了全套太玄神功的功法。『你可以通过xuexi miji指令来使用』\n");
		set("value", 0);
		
                
                set("no_sell",1); 
                set("no_get", 1);
                set("no_steal", 1);                                                                                                                                                    
                set("value", 10000);

             
             }

	

	setup();
}

int do_eat(string arg)
{
	object me = this_player();

	if (!id(arg))
	return notify_fail("你要学习什么？\n");

	if (me->query("combat_exp")>350000000 )
                return notify_fail("以你现在的修为，太玄经已经太垃圾了。\n");
        
        if (me->query("combat_exp")<4000000 ){
                return notify_fail("以你目前的修为太玄经对你来说是天书。\n");
                        }
        if (me->query("gender") == "无性")
                return notify_fail("你这不阴不阳的怪物也想练就「太玄功」?！\n");  
        if ( me->query_skill("kuihua-mogong", 1) > 1 ) {
                return notify_fail("你的葵花魔功真气与太玄功相冲突!。\n");
	}
        if ( me->query_skill("jiuyang-gong", 1) > 1 ) {
                return notify_fail("你的九阳神功真气与太玄功相冲突!。\n");
	}
        if ( me->query_skill("jiuyin-shengong", 1) > 1 ) {
                return notify_fail("你的九阴神功真气与太玄功相冲突!。\n");
	}
        if ( me->query_skill("jiuyin-zhengong", 1) > 1 ) {
                return notify_fail("你的九阴神功真气与太玄功相冲突!。\n");
	}

        if ( me->query("str", 1) < 36 ) {
                return notify_fail("你的先天膂力太低!。\n");
	}
	      if ( me->query("int", 1) < 36 ) {
                return notify_fail("你的先天悟性太低!。\n");
	}    
        if ( me->query_skill("hamagong", 1) > 1 ) {
                return notify_fail("你的蛤蟆功真气与太玄功相冲突!。\n");
	}
	      if ( me->query_skill("literate", 1) > 1 ) {
                return notify_fail("你的文学造诣如此之深，难免会从字面的意思上去理解，不如放弃吧。\n");
	}

          if ( me->query_skill("taixuan-gong", 1) > 219 ) {
                return notify_fail("你已经学会这门技能,为什么还要死啃书本呢?!。\n");


	
	}
	else
	{
		me->add("combat_exp", 5000);
              this_player()->set_skill("taixuan-gong", 220);
             me->add("potential", 5000);
		message_vision(HBMAG HIG  "$N觉得脑中豁然开朗,突然领悟到太玄经的精髓所在!\n" NOR, me);
	}

	
	
	destruct(this_object());
	return 1;
}

