// haotiandan.c  浩天丹

#include <ansi.h>

inherit ITEM;


void init() {
  add_action("do_eat", "xuexi");
}

void create() {
  set_name(HIB "苗家剑法秘籍" NOR, ({ "miaojia miji", "miji", "book" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一本《苗家剑法》秘籍,里面详细的记录了苗家剑法的功法。『你可以通过xuexi miji指令来使用』\n");
    set("value", 0);


    set("no_sell", 1);
    //     set("no_get", 1);
    set("no_steal", 1);
    set("value", 10000);


  }



  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要学习什么？\n");

  if (me->query("combat_exp") > 350000000)
    return notify_fail("以你现在的修为，苗家剑法法已经太垃圾了。\n");

  if (me->query("combat_exp") < 2000000) {
    return notify_fail("以你目前的修为苗家剑法对你来说是天书。\n");
  }
  if (me->query_skill("miaojia-jian", 1) > 219) {
    return notify_fail("你已经学会这门技能,为什么还要死啃书本呢?!。\n");

  }


  else {
    me->add("combat_exp", 5000);
    this_player()->set_skill("miaojia-jian", 220);
    //     this_player()->set_skill("cuixin-zhang", 220);
    me->add("potential", 5000);
    message_vision(HBMAG HIG "$N觉得脑中豁然开朗,突然领悟到苗家剑法的精髓所在!\n" NOR, me);
  }



  destruct(this_object());
  return 1;
}
