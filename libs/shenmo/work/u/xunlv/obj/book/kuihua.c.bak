// kuihua.c  葵花宝典
//By kingso 06 12

#include <ansi.h>

inherit ITEM;

 
void init()
{
	add_action("do_eat", "xuexi");
}

void create()
{
	set_name(MAG"葵花宝典"NOR, ({"kuihua baodian", "miji", "book"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long",MAG "这是一本《葵花宝典》秘籍,里面详细的记录了葵花宝典的全部的功法。『你可以通过xuexi miji指令来使用』\n"NOR);
		set("value", 0);
		
                
                set("no_sell",1); 
                set("no_get", 1);
                set("no_steal", 1);                                                                                                                                                    
                set("value", 10000);

             
             }

	

	setup();
}

int do_eat(string arg)
{
	object me = this_player();

	if (!id(arg))
	return notify_fail("你要学习什么？\n");

	if (me->query("combat_exp")>350000000 )
                return notify_fail("以你现在的修为，葵花宝典已经太垃圾了。\n");
        if(me->query("gender")!= "无性") 
                return notify_fail("「葵花宝典」第一页上写着:欲练神功,挥刀自宫！\n");  
        if( me->query_skill("jiuyang-gong", 1) > 1 ) {
                return notify_fail("你的九阳神功真气与葵花魔功相冲突!。\n");
	}
        if ( me->query_skill("taixuan-gong", 1) > 1 ) {
                return notify_fail("你的太玄功真气与葵花魔功相冲突!。\n");
	}
        if ( me->query_skill("jiuyin-shengong", 1) > 1 ) {
                return notify_fail("你的九阴神功真气与葵花魔功相冲突!。\n");
	}
        if ( me->query_skill("jiuyin-zhengong", 1) > 1 ) {
                return notify_fail("你的九阴神功真气与葵花魔功相冲突!。\n");
	}

        if ( me->query_skill("hamagong", 1) > 1 ) {
                return notify_fail("你的蛤蟆功真气与葵花魔功相冲突!。\n");
	}

      if ( me->query("dex", 1) < 38 ) {
                return notify_fail("你的先天身法太低!。\n");
	}
	      if ( me->query("int", 1) < 38 ) {
                return notify_fail("你的先天悟性太低!。\n");
	}    
        if (me->query("combat_exp")<3000000 ){
                return notify_fail("以你目前的修为葵花宝典对你来说是天书。\n");
                        }
          if ( me->query_skill("kuihua-mogong", 1) > 219 ) {
                return notify_fail("你已经学会这门技能,为什么还要死啃书本呢?!。\n");

	}
         

	else
	{
		me->add("combat_exp", 5000);
              this_player()->set_skill("kuihua-mogong", 220);
         //     this_player()->set_skill("cuixin-zhang", 220);
             me->add("potential", 5000);
		message_vision(HBMAG HIG  "$N觉得脑中豁然开朗,突然领悟到葵花宝典的精髓所在!\n" NOR, me);
	}

	
	
	destruct(this_object());
	return 1;
}

