// axe-book.c 基本斧法
inherit ITEM;

void create()
{
        set_name("梵文注解", ({ "fanwen zhujie", "book","shu"}));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long", "这是一本学习梵文的书 级别0-200 指令du book。\n");
                set("unique", 1);
                set("treasure",1);                              
                set("value", 10000);
                set("material", "paper");
                set("skill", 
                ([
                        "name": "sanscrit",          // name of the skill
                        "exp_required": 0,      // minimum combat experience required
                        "jing_cost":    1,     // jing cost every time study this
                        "difficulty":   0,     // the base int to learn this skill
                        "max_skill":    200      // the maximum level you can learn
                ]));
        }
}
