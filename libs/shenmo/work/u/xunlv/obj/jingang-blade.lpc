// youlong.c

#include <weapon.h>
#include <ansi.h>
inherit BLADE;
inherit F_UNIQUE;

void create()
{
        set_name(HIW"精钢刀"NOR, ({ "jingang dao", "dao", "blade" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                
                set("rigidity", 1);
                set("sharpness", 1);
                set("long",
"这是一把精钢锻造的刀，仔细一看，刀身上有几条细纹闪烁不定。\n");
                set("value", 50001);
                set("weapon_prop/dodge", 3);
                set("weapon_prop/parry", 7);
                set("wield_msg", 
"只听见「飕」地一声，$N的手中已经多了一把寒光四射的宝刀——$n。\n");
                
                set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
        }
        init_blade(200);
        setup();
}
int query_autoload()
{
        return 1;
}

void owner_is_killed()
{
        destruct(this_object());
} 

