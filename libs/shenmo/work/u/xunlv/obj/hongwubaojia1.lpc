#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create()
{
        set_name(BRED HIY "洪武宝甲" NOR, ({ "hongwu baojia", "hongwu", "baojia"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("long", BRED""HIY"这是一件明朝洪武大帝"HIY"-朱元璋-"BRED"的御用战甲，做工非比寻常。上面雕有九条五爪龙纹，以五彩祥云环绕。\n"NOR);

                set("value", 60000);
                set("material", "leather");
                
                set("armor_prop/armor", 115350);
                set("armor_prop/parry", 30);
                set("armor_prop/dodge", 20);
        }
        setup();
}

int query_autoload()
{
        return 1;
}

