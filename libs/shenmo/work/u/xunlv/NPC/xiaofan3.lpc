// seller.c

inherit NPC;
inherit F_VENDOR;
#include <ansi.h>

void create() {
  set_name(HIR "新人升级武功丹药商" NOR, ({ "xiao fan", "seller", "fan" }));
  set("gender", "男性");
  set("age", 32);
  set("long",
    HIY "我专门出售130000经验前新人升级基本武功的丹药，价格非常便宜，你可以list查看，用buy XXX来买。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 300);
  set("str", 17);
  set("dex", 20);
  set("con", 17);
  set("int", 22);
  set("attitude", "peaceful");
  set("vendor_goods", ({
    ([ "name": "/u/xunlv/obj/medicine/xinren", "number": 500 ]),
    ([ "name": "/u/shenlongyaoli-book", "number": 1 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenzhengqi", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenxieqi", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenpot", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenforce", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenlet", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenparry", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrendodge", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrensword", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenblade", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenfinger", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenhand", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenleg", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrencuff", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenstrike", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenclaw", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenhook", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenwhip", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenstick", "number": 500 ]),
    ([ "name": "/u/xunlv/obj/xinren/xinrenstaff", "number": 500 ]),


  }));
  setup();
  carry_object("/clone/misc/cloth")->wear();
  add_money("coin", 100);
}
void init() {
  ::init();
  add_action("do_buy", "buy");
  add_action("do_list", "list");
}
