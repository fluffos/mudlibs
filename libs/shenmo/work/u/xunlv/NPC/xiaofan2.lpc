// seller.c

inherit NPC;
inherit F_VENDOR;
#include <ansi.h>

void create()
{
	set_name(HIR"新人经验增加商"NOR, ({ "xiao fan", "seller", "fan" }) );
	set("gender", "男性" );
	set("age", 32);
	set("long",
		HIY"我专门出售经验丹，新人吃了可以增加9.9万exp和潜能，还有若干精力内力，价格非常便宜，你可以list查看，用buy XXX来买。\n"NOR);
	set("shen_type", 1);
	set("combat_exp", 300);
        set("str", 17);
        set("dex", 20);
        set("con", 17);
        set("int", 22);
	set("attitude", "peaceful");
	set("vendor_goods", ({
(["name":"/u/xunlv/obj/medicine/xinren","number":500]),



	}) );
	setup();
        carry_object("/clone/misc/cloth")->wear();
	add_money("coin", 100);
}
void init()
{
        ::init();
        add_action("do_buy", "buy");
        add_action("do_list", "list");
}

