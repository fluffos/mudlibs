
// shizhe.c 礼物使者
#include <ansi.h>
inherit NPC;
string ask_newbie();
string ask_fanhui();
string ask_xingxiu();
string ask_sld();
string ask_wudang();
string ask_ss();
string ask_emei();
string ask_shaolin();
string ask_xs();
string ask_mingjiao();
string ask_kl();
string ask_hs();
string ask_gb();
string ask_mur();
string ask_tttt();
string ask_thd();
string ask_tz();
string ask_tls();
string ask_wudao();
string ask_lingjiu();
object ob = this_object();
int do_want(string arg);
void create()
{
    set_name(HIC"梦幻天使"NOR, ({"shizhe" }));
	set("title", ""HIR"［"HIG"舞林外传"HIW"］"NOR""HIY"礼"HIM"物"HIC"使"HIG"者"NOR"");   
    set("gender", "男性");
    set("age", 18);
    set("per", 70);
    set("str", 5);
    set("int", 40);
    set("con", 40);
    set("dex", 40);
    set("qi",5000);
    set("jingli",5000);
    set("max_qi", 5000);
    set("max_jing", 5000);
    set("eff_jingli", 5000);
    set("jiali", 190);
    set("combat_exp", 0);
    set("shen", 25000);
    set("chat_chance_combat", 60);
    set("chat_msg_combat", ({
        (: exert_function, "taiji" :),
        (: perform_action, "sword.chan" :),
        (: perform_action, "cuff.zhen" :),
        (: perform_action, "cuff.zhan" :),
        (: perform_action, "cuff.ji" :)
      }));
    setup();
    set("inquiry", ([
        "newbie" : (: ask_newbie :),
        "反悔" : (: ask_fanhui :),
        "拜师" : "你要拜哪里？（ask shizhe about 〈门派名称〉）\n武当派？少林寺？星宿派？铁掌帮? 神龙教? 华山派？丐帮？\n古墓派？姑苏慕容？桃花岛？天龙寺？嵩山派？明教? 昆仑派? 逍遥派?灵鹫宫?\n",
         "神龙教" : (: ask_sld :),
        "大轮寺" : (: ask_xs :),
        "桃花岛" : (: ask_thd :),
        "铁掌帮" : (: ask_tz :),
        "星宿派" : (: ask_xingxiu :),
        "武当派" : (: ask_wudang :),
        "峨嵋派" : (: ask_emei :),
        "明教" : (: ask_mingjiao :),
        "少林寺" : (: ask_shaolin :),
        "丐帮" : (: ask_gb :),
        "古墓派" : (: ask_tttt :),
        "华山派" : (: ask_hs :),
        "嵩山派" : (: ask_ss :),
        "姑苏慕容" : (: ask_mur :),
        "天龙寺" : (: ask_tls :),
		"昆仑派" : (: ask_kl :),
		"舞蹈学院" : (: ask_wudao :),
		
      ]) );
}
void init()
{
object ob=this_object();
add_action("do_want","want");
::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}
void greeting(object ob)
{
 if (!ob || !present(ob, environment())) return;
            write(HBRED"请ask shizhe about newbie 来的到奖励！\n"NOR);
			write(HBRED"请ask shizhe about 拜师 来察看门派！\n"NOR);
			write(HBRED"请ask shizhe about  <门派名称> 来你想取得门派！\n"NOR);
			write(HBRED"请ask shizhe about  反悔 来你重新要门派！\n"NOR);
}
string ask_newbie()
{ 
    mapping skill;
    string *skl;
    int i;
    object me = this_object();
    object ob = this_player();
    if (ob->query("shizhe_newbie")) return "你不是领过了嘛！？\n";
    write (HBRED"请输入 ask 拜师来要技能。\n"NOR);
    write (HIW"你获得了130k经验,2000 点内力 and 1500 点精力!\n"NOR);
    write (HIW"你现在的年龄是18岁!\n");
    ob->set_skill("dodge",1);
    skill = ob->query_skills();
    skl = keys(skill);
    i = sizeof(skl);
    while (i--) 
    {
        ob->delete_skill(skl[i]);              
    }
    message_vision(HBRED"$N废去了$n的所有武功！\n"NOR,me,ob);
     ob->delete("double_attack");
    this_player()->set_skill("dodge",110);
    this_player()->set_skill("force",110);
    this_player()->set_skill("parry",110);
    this_player()->set_skill("literate",110);
    ob->set_skill("medicine",30);
    ob->set("neili",2000);
    ob->set("max_neili",2000);
    ob->set("eff_neili",2000);
    ob->set("jingli",1500);
    ob->set("max_jingli",1500);
    ob->set("eff_jingli",1500);
    ob->set("qi",2000);
    ob->set("max_qi",2000);
    ob->set("eff_qi",2000);
    ob->set("jing",1000);
    ob->set("max_jing",1000);
    ob->set("eff_jing",1000);
    ob->set("combat_exp",130000);
    ob->set("dali_job",0);
    ob->set("shizhe_newbie",1);
    ob->set("age",18);
    ob->add("mud_age",180000);
    ob->delete("enter_wuguan");
    return "为鼓励newbie特此奖励!请用ask来要技能。\n"; 
}
string ask_fanhui()
{
    mapping skill;
    string *skl;
    int i;
    object me = this_object();
    object ob = this_player();
    skill = ob->query_skills();
    skl = keys(skill);
    i = sizeof(skl);
    while (i--) 
    {
        ob->delete_skill(skl[i]);              
    }
    message_vision(HBRED"$N废去了$n的所有武功！\n"NOR,me,ob);
    ob->delete("shizhe_newbie");
    ob->delete("shizhe_拜师");
    ob->set("family",0);
    return "请重新ask shizhe about newbie一次。\n";
}
string ask_xingxiu()
{
    if (this_player()->query("shizhe_拜师")) return "你不是要过一次门派skills了嘛！？\n";
    message_vision(HIY "使者"+ NOR "一挥手，一阵狂风将$N吹得无影无踪了。"+ NOR "\n",this_player());
    this_object()->create_family("星宿派", 2, "弟子");
    this_object()->recruit_apprentice(this_player());
    this_object()->delete("title");
    this_player()->move("/d/xingxiu/xxh");
	this_player()->set("xx_job",0);
    this_player()->set_skill("huagong-dafa",110);
    this_player()->set_skill("chousui-zhang",110);
    this_player()->set_skill("sanyin-zhua",110);
    this_player()->set_skill("zhaixingshu",110);
    this_player()->set_skill("tianshan-zhang",110);
    this_player()->set_skill("strike",110);
    this_player()->set_skill("staff",110);
    this_player()->set_skill("claw",110);
    this_player()->set_skill("poison",100);
    this_player()->set("shizhe_拜师",1);
    this_player()->set("shen",-100000);
    //this_player()->set("xx_points",0);
    return "wave";
}
