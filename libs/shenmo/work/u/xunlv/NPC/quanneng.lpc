#include <ansi.h>
#include <combat.h> 
inherit F_SSERVER;

void remove_effect(object me, int improve);

int perform(object me, object target)
{
        int skill;
        skill = (int)me->query_skill("latin-dancing", 1);
        if( !target ) target = offensive_target(me);

        if( !target || !me->is_fighting(target) )
                return notify_fail("「十项全能」只能在战斗中使用。\n");
        if( me->query_temp("weapon"))
                return notify_fail("你拿着武器怎么能跳「十项全能」！\n");   
        if( skill < 260 )
                return notify_fail("你的体育舞蹈舞姿不够娴熟，不能跳「十项全能」。\n");
        if(me->query_skill("force",1) < 260 )
                return notify_fail("你的内功修为不够，不能跳「十项全能」。\n");
        if(me->query_skill("dodge",1) < 260 )
                return notify_fail("你的身法不够娴熟，不能跳「十项全能」。\n");
        if (me->query_skill_mapped("hand") != "latin-dancing" )
               return notify_fail("你现在进行「十项全能」！\n");
        if( (int)me->query("max_neili") < 3000)
                return notify_fail("你现在内力修为太弱，不能跳「十项全能」。\n");      
        if( (int)me->query("neili") < 3000 )
                return notify_fail("你现在真气太弱，不能跳「十项全能」。\n");
        me->start_perform(5, "十项全能");
        message_vision(HBMAG"\n$N摆好舞姿，凝神聚气，将十种体育舞蹈跳了出来，正是「十项全能」！\n"NOR,me,target);
        
        me->add("neili", -900);
        me->add_temp("apply/dexerity", skill/6);
        me->add_temp("apply/damage", skill/5);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 3);
        if(me->is_fighting(target)) 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 3);
        if(me->is_fighting(target))
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 3);
        if(me->is_fighting(target))
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 3);
        if(me->is_fighting(target))
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 3);
        if(me->is_fighting(target))
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 3);
        if(me->is_fighting(target))
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 3);
        if(me->is_fighting(target))
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 3);
        if(me->is_fighting(target))
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 3);
        if(me->is_fighting(target))
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 3);       
        me->add_temp("apply/damage", -skill/5);       
        me->add_temp("apply/dexerity", -skill/6);       
        me->start_busy(2+random(2));
        return 1;
}

