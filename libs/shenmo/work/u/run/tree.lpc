
#include <action.h>
#include <ansi.h>

inherit ITEM;

void create() {

  set_name(HIG"圣诞树"NOR, ({"tree"}));
  set_weight(6000000);
  set_max_encumbrance(100000000000);
  set("value",0);
  set("unit", "棵");
  set ("long", @LONG

据说有一位农民在一个风雪交加的圣诞夜里接待了一个饥寒交迫的小孩，让
他吃了一顿丰盛的圣诞晚餐，这个孩子告别时折了一根杉树枝插在地上并祝
福说：“年年此日，礼物满枝，留此美丽的杉村，报答你的好意。”小孩走
后，农民发现那树枝竟变成了一棵小树，他才明白自己接待的原来是一位上
帝的使者。这个故事就成为圣诞树的来源。

LONG);
  set("value", 1000);
  setup();
}









