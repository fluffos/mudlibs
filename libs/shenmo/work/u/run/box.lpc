inherit ROOM;
#include <ansi.h>

int do_push(string arg);
int block_cmd();

void create() {
  set("short", "木箱");
  set("long", "乌漆抹黑的，什么也看不到。\n");
  set("no_clean_up", 1);
  setup();
}

void init() {
  add_action("block_cmd", "", 1);
  add_action("do_push", "push");
}

int block_cmd() {
  string msg, *msgs;
  string verb = query_verb();
  object me = this_player();
  if (verb == "push") return 0;  //allow say
  msgs = ({
    "$N干哑的叫道：水，水，给我水。。。\n",
    "$N嘟嘟囔囔的说着人们听不懂的话。\n",
    "$N干嚎着。。。。。。\n",
    "$N在黑暗中摸索着。\n",
    "$N眼前一片黑......\n",
    "$N干嚎着：我们都是神经病。\n",
    "$N扑通扑通乱折腾一气。\n",
  });
  msg = msgs[random(sizeof(msgs))];
  message_vision(msg, me);
  return 1;
}

int do_push(string arg) {
  string msg;
  object me = this_player();
  if (!arg || arg != "开关")
    return 0;
  message_vision("$N终于找到开关，慌张的离去了。\n", me);
  me->move("/u/run/workroom");
  message_vision(CYN "墙脚的一个木箱骨碌碌一响，从里面蹦出个人来！\n
原来是$N!\n" NOR, me);
  me->command("hoho");
  return 1;
}
