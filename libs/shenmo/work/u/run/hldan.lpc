#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
    set("no_give","这么珍贵的药，哪能随便给人？\n");
    set("no_drop","这么宝贵的丹药，扔了多可惜呀！\n");
    set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
  }              
        add_action("do_eat", "eat");                      
}

void create()
{
  set_name(HIR "火龙丹" NOR, ({"huolong dan"}));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "珍贵无比的仙药，吃了可加强自身内劲。\n");
    set("value", 5000);
    set("drug_type", "补品");
    set("reward_value",1);
  }
  
  setup();
}

int do_eat(string arg)
{
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (!present("huolong dan", me))
    return notify_fail("东西要拿起来才能吃。\n");
  
  message_vision(HIR "$N吃下一颗火龙丹，顿时满脸红光，体内真气大增！ \n" NOR, me);
  me->add("maximum_force",100);
  me->add("max_force",100);
  destruct(this_object());

  return 1;
}

