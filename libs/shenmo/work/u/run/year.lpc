inherit NPC;
#include <ansi.h>

int gift_me();
       
void create()
{
string msg;
msg = HIR"\n"+@LONG
＃〓§〓〓〓〓〓§〓〓〓〓〓〓§〓〓〓〓〓§〓＃ 
　　↓　　　　　↓　　　　　　↓　　　　　↓ 
　☆★☆　　　☆★☆　　　　☆★☆　　　☆★☆ 
☆　新　☆　☆　年　☆　　☆　快　☆　☆　乐　☆ 
　☆★☆　　　☆★☆　　　　☆★☆　　　☆★☆ 
　　↓　　　　　↓　　　　　　↓　　　　　↓ 
　　※　　　　　※　　　　　　※　　　　　※  
LONG+NOR"\n";
msg = replace_string(msg,"★",NOR BLINK HIY"★"NOR HIR);
msg = replace_string(msg,"☆",NOR BLINK HIG"☆"NOR HIR);
msg = replace_string(msg,"新",NOR HIY"新"NOR HIR);
msg = replace_string(msg,"年",NOR HIY"年"NOR HIR);
msg = replace_string(msg,"快",NOR HIY"快"NOR HIR);
msg = replace_string(msg,"乐",NOR HIY"乐"NOR HIR);
set_name(HIC"礼物大使"NOR,({"liwu dashi","dashi"}));
set("title", msg);
set("gender", "男性");
set("age", random(100)+900);
set("combat_exp",10000000);
set("daoxing",10000000);
set("shen_type", 0);
set("attitude", "peaceful");
set("inquiry",([
        "节日"          : (: gift_me :),
        "节日礼物"      : (: gift_me :),
        "礼物"          : (: gift_me :),
        "gift"          : (: gift_me :),
]));
setup();
}

void init()
{
add_action("do_yao","gift");
}

int gift_me()
{
int num;
string msg;
object yan;
object me = this_player();
object ob = this_object();
if ( me->query("礼物/2003元旦2") )
        {
        say(HIR"可惜你已经要过礼物了。=^-^= \n"NOR);
        return 1;
        }
if ( me->is_busy() )
        {
        say(HIR"可惜你正忙着呢。=^-^= \n"NOR);
        return 1; 
        }
me->set_temp("2003元旦",1);
say(ob->name()+HIR"笑呵呵的对"+me->name()+HIR"道：节日快乐，来，这里是你的礼物....\n"NOR);
tell_object(me,HIR"你想要哪个礼物？( gift wx / dx / pot ) \n"NOR);
me->save();
return 1;
}

int do_yao(string arg)
{
string msg;
int wx = 100000+random(50000);
int dx = 100000+random(50000);
int pot = 50000+random(50000);
object me = this_player();

if ( !me->query_temp("2003元旦") || me->query("礼物/2003元旦2") )
        return notify_fail("什么？\n");

if ( !arg || ( arg!="wx" && arg!="dx" && arg!="pot") )
        return notify_fail("\n
        命令格式        gift    < 种类 >
        种类            wx      武学
                        dx      道行
                        pot     潜能\n");
 
switch ( arg )
        {
case "wx" : me->add("combat_exp",wx);me->save();tell_object(me,HIR"新年快乐，你得到了"+chinese_number(wx)+"武学。\n"NOR);break;
case "pot" : me->add("potential",pot);me->save();tell_object(me,HIR"新年快乐，你得到了"+chinese_number(pot)+"潜能。\n"NOR);break;
case "dx" : me->add("daoxing",dx);me->save();tell_object(me,HIR"新年快乐，你得到了"+COMBAT_D->chinese_daoxing(dx)+"道行。\n"NOR);break;
        }
me->set("礼物/2003元旦2",1);
me->delete_temp("2003元旦");

if ( random(2)==1 )
        msg = HIR+@LONG
        ╔♂╗┏┯┓┏┯┓┏┯┓┏┯┓╔♀╗ 
        ┃★┃┠新┨┠年┨┠快┨┠乐┨┃☆┃ 
        ┃☆┃┗┷┛┗┷┛┗┷┛┗┷┛┃★┃ 
        ╚♂╝↘*≡恭≡喜≡发≡财≡*↙╚♀╝ 
LONG+NOR;
else    msg = HIR+@LONG

　.╭╮︵☆╭╮.`╔═══╦═══╦═══╗ .`.` 
　.〔　o　o　〕╭新╮ `╭年╮ `╭快╮  ╭乐╮. 
　.〔ミ О ミ〕.╲╱.`. ╲╱.`. ╲╱    ╲╱ .`. 
　〔︵灬　灬︵〕　　　　　　　　　　　　 
LONG+NOR;

msg+=HIC"\n\n\t$N($I)：祝大家新年快乐。\n\n"NOR;
msg = replace_string(msg,"新",NOR HIY"新"NOR HIR);
msg = replace_string(msg,"年",NOR HIY"年"NOR HIR);
msg = replace_string(msg,"快",NOR HIY"快"NOR HIR);
msg = replace_string(msg,"乐",NOR HIY"乐"NOR HIR);
msg = replace_string(msg,"恭",NOR HIC"恭"NOR HIR);
msg = replace_string(msg,"喜",NOR HIC"喜"NOR HIR);
msg = replace_string(msg,"发",NOR HIC"发"NOR HIR);
msg = replace_string(msg,"财",NOR HIC"财"NOR HIR);
msg = replace_string(msg,"★",NOR BLINK HIM"★"NOR HIR);
msg = replace_string(msg,"☆",NOR BLINK HIG"☆"NOR HIR);
msg = replace_string(msg,".",NOR BLINK HIG"."NOR HIR);
msg = replace_string(msg,"$N",NOR HIW+me->query("name")+NOR HIR);
msg = replace_string(msg,"$I",NOR HIW+capitalize(me->query("id"))+NOR HIR);
message("shout",msg,users());
me->save();
return 1;
}


