#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "幻灭塔" NOR);
  set("long", BLU + @LONG

这里就是古人密道的中心，以花岗岩堆砌而成的六角古塔。
塔的四周布满结界，班驳交错，纵横四野。塔内满是碎石
(stone)。
据说撒旦的面具最初就是在这儿给发现的。

LONG + NOR);

  set("exits", ([
    "out": __DIR__ "migong10",
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
    "stone": "碎乱的腐朽之石，不凡在里面搜索(fan)下，看看有无发现。\n",
  ]));

  set("water", 1);
  setup();
}

void init() {
  add_action("do_dig", "fan");
  add_action("do_none", "cast");
  add_action("do_none", "move");
}

int do_none() {
  return notify_fail(HIY "加紧找宝吧！\n" NOR);
}


int do_dig(string arg) {
  int i;
  object face;
  object who = this_player();
  object where = this_object();
  i = (int)who->query_kar();

  if (!arg || arg != "stone")
    return notify_fail("你想拨弄什么？\n");

  if (where->query_temp("face") || !(int)who->query_temp("face_ask"))
    return notify_fail("没什么新的发现了。\n");

  if ((int)who->query("kee") < 300)
    return notify_fail("你太累了，歇歇吧！\n");

  message_vision("$N弯腰在石堆里翻弄了半天，累得满头大汗。\n" NOR, who);
  who->receive_damage("kee", 250);
  where->set("coe", (int)where->query("coe") + i);

  if (i < 20) {
    tell_room(where, "结果什么也没发现。\n");
  } else tell_room(where, "碎石渐渐翻开一边了。\n");

  if ((int)where->query("coe") >= 1000) {
    message_vision(HIY "\n咦，有发现！$N从石头堆里发现了一个面具！\n\n" NOR, who);
    where->set_temp("face", 1);
    face = new("d/sds2/obj/face");
    face->move(who);
    who->set("sds2/get_face", "done");
    who->move("/d/sds2/end");
    message_vision("$N兴奋的从迷宫中跑了出来。\n" NOR, who);
  }
  return 1;
}
