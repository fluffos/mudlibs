#include <ansi.h>

inherit NPC;
#include "hs.h"

string ask_jianding();

void create() {
  set_name("鉴定师", ({ "jianding shi" }));
  set("gender", "男性");
  set("title", HIM "人物属性" NOR);
  set("age", 50);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("per", 20);
  set("max_kee", 4100);
  set("kee", 4100);
  set("max_sen", 3100);
  set("sen", 3100);
  set("combat_exp", 100000);
  set("daoxing", 10000);
  set("force", 400);
  set("max_force", 400);
  set("mana", 400);
  set("max_mana", 400);
  set("force_factor", 0);
  set("mana_factor", 0);
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("literate", 200);
  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("spells", 500);
  set("inquiry", ([
  ]));
  set("inquiry", ([
    "属性": (: ask_jianding :),
    "shuxing": (: ask_jianding :),
  ]));
  setup();
}

string ask_jianding() {
  return "我可以为您鉴定您自身的属性，但需付50两黄金。\n";

}

int accept_object(object me, object ob) {


  if (ob->query("money_id") && ob->value() >= 500000) {
    me->set_temp("hs/can_jd2", 1);
    message_vision("$n对$N说道：没错。现在我帮您鉴定您的属性。\n", me, this_object());
    call_out("jianding2", 1, me, this_object());
    return 1;
  }

  command("pei");
  command("say 我忙着呢,别来消遣我。\n");
  return 0;
}

int jianding2(object me, object ob) {
  int shuxing = 15;
  string hssx;

  if (me->query("hs/shuxing")) {
    message_vision("$n对$N说道：您的属性为" + me->query("hs/shuxing") + "，您不是已经鉴定过了吗？\n", me, ob); return 0;
  }

  switch (random(shuxing)) {
    case 0: hssx = HIC "风" NOR; break;
    case 1: hssx = HIY "地" NOR; break;
    case 2: hssx = HIB "水" NOR; break;
    case 3: hssx = HIR "火" NOR; break;
    case 4: hssx = HIC "风" NOR; break;
    case 5: hssx = HIY "地" NOR; break;
    case 6: hssx = HIB "水" NOR; break;
    case 7: hssx = HIR "火" NOR; break;
    case 8: hssx = HIC "风" NOR; break;
    case 9: hssx = HIY "地" NOR; break;
    case 10: hssx = HIB "水" NOR; break;
    case 11: hssx = HIR "火" NOR; break;
    case 12: hssx = HIW "光" NOR; break;
    case 13: hssx = BLK "暗" NOR; break;
    case 14: hssx = HIW "光" NOR; break;
    case 15: hssx = BLK "暗" NOR; break;
  }
  me->set("hs/shuxing", hssx);

  message_vision("$n双手放在$N的胸前，一股奇异的热流由$n的手传进$N的胸口，扩散到$N的全身。\n", me, ob);

  if (hssx == HIW "光" NOR)
    tell_object(me, "你全身突然热了起来。渐渐的，眼前好像出现了一道亮光，说不出来是什么颜色的，光越来越亮，\n双眼逐渐无法负荷这亮光，不由轻哼一声。
\n");
  if (hssx == BLK "暗" NOR)
    tell_object(me, "你全身热了起来。突然你眼前一片漆黑，什么也看不见，没有任何光亮。\n");

  if (hssx == HIC "风" NOR)
    tell_object(me, "你全身突然热了起来。渐渐的，眼前好像出现了一道亮光，你仔细一看那光竟然是" + HIC "青绿色" NOR + "的。\n");

  if (hssx == HIY "地" NOR)
    tell_object(me, "你全身突然热了起来。渐渐的，眼前好像出现了一道亮光，你仔细一看那光竟然是" + HIY "黄色" NOR + "的。\n");

  if (hssx == HIB "水" NOR)
    tell_object(me, "你全身突然热了起来。渐渐的，眼前好像出现了一道亮光，你仔细一看那光竟然是" + HIB "蓝色" NOR + "的。\n");

  if (hssx == HIR "火" NOR)
    tell_object(me, "你全身突然热了起来。渐渐的，眼前好像出现了一道亮光，你仔细一看那光竟然是" + HIR "红色" NOR + "的。\n");

  tell_object(me, "你双眼一张，视觉慢慢恢复正常。\n");
  message_vision("$n对$N说道：您的属性为" + hssx + "! 鉴定完毕。\n", me, ob);

  me->set("hs/shuxing", hssx);
  me->delete_temp("hs/can_jd2");
  return 1;

}
