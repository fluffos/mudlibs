inherit ROOM;
#include <ansi.h>

string jieshao();
int do_dian(string arg);
int block_cmd();

void create()
{
set ("short", "丽春苑");
set ("long", @LONG
顾名思义，此处是长安城中狂蜂浪蝶聚集之地。来来往往的全是
官宦子弟，也不乏京城中有脸面的达官贵人。
姑娘们打扮的花枝招展，对着众人眉目传情。你可以在这里点照
着墙上的花牌(pai)来点(dian)你想要的姑娘。
LONG);

set("item_desc", ([ 
	"pai"	:	(: jieshao :),
	"花牌"	:	(: jieshao :),
]));

set("exits", ([ /* sizeof() == 1 */
        "down" : __DIR__"club",
        "west" : __DIR__"duchang-gate",
]));

set("objects",([
	__DIR__"npc/laobao"	:	1,
]));

set("no_fight", 1);
set("no_magic", 1);
set("no_clean_up",1);
set("num",0);
setup();
}

void init()
{
object me = this_player();
if ( !wizardp(me) )
	add_action("block_cmd","",1);      
add_action("do_dian","dian");
}

string jieshao()
{
string msg = "\n";
msg+="	花魁	:	一百两黄金\n";
msg+="	探花	:	八十两黄金\n";
msg+="	榜眼	：	五十两黄金\n";
msg+="	普通	：	二十两黄金\n";
msg+="\n\n";	
return msg;
}

int block_cmd()
{
string verb = query_verb();
if (verb=="say") return 0; //allow say
if (verb=="go") return 0;
if (verb=="look") return 0;
if (verb=="ask") return 0;
if (verb=="give") return 0;
if (verb=="exercise") return 0;
if (verb=="dazuo") return 0;
if (verb=="exert") return 0;
if (verb=="tell") return 0;
if (verb=="dian") return 0;
return 1;
}

int do_dian(string arg)
{
string gender,str,*msgs;
int i,value,num,afford,damage;
object npc;
object me = this_player();
if ( !arg ||
    ( arg!="花魁" && arg!="榜眼" && arg!="探花" && arg!="普通" ) )
	return notify_fail("你要点哪个姑娘？( 普通,探花,榜眼,花魁 )具体请看花牌。\n");
if ( me->query("kee")<300 ) return notify_fail("你还是先歇歇吧，不然要出人命了！\n");
num = this_object()->query("num");
if ( num>=10 )
	return notify_fail("老鸨对你一哈腰：对不起，今天生意好得很，暂时没空闲的姑娘了。\n");
msgs = ({
	"$N摇头晃脑，对着花牌看看，",
	"$N摇了摇折扇，对着花牌看了看，",
	"$N凑近花牌，仔细看了看，",
	"$N将折扇对着花牌一点，",
	});
str = msgs[random(sizeof(msgs))];
str+="说道：找上几位";
switch ( arg )
	{
	case "普通" : //20gold
		value = 200000;
		str+= "小姑娘";
		break;
	case "榜眼" : // 50gold
		value = 500000;
		str+= "漂亮点的姑娘";
		break;
	case "探花" : //80gold
		value = 800000;
		str+= "标致的姑娘";
		break;
	case "花魁" : //100 gold
		value = 1000000;
		str+= "数一数二的姑娘";
		break;
	}
str+="陪我";
msgs = ({
	"喝酒","吟诗","吹萧","行乐","聊天",
});
str+=msgs[random(sizeof(msgs))]+"\n";
message_vision(str,me);

if( afford = me->can_afford(value) ) 
	{
	if( afford==2 ) 
		return notify_fail("你没有足够的零钱，而银票又没人找得开。\n");
	str = "老鸨半抢半推的从你的裤裆里掏出"+chinese_number(value/10000)+"两黄金。\n
随即一旁的龟公丫鬟一干人等笑嘻嘻的将$N拥到厢房里去了。\n";
	message_vision(str,me);
	npc = present("lao bao",this_object());
	if ( !npc || userp(npc) )
		{
		npc = new(__DIR__"npc/laobao");
		npc->move(this_object());
		}
	me->pay_money(value);
	this_object()->add("num",1);
	this_object()->save();
	me->move(__DIR__"xiangfang1"+sprintf("%d",i));
	message_vision("到了，老鸨众人将门一带，识相的走开了。\n",me);
	return 1;
	}
else	{
        str="老鸨将手一挥，众龟奴一拥而上，将$N海扁一通。\n";
	message_vision(str,me);
        damage = me->query("kee");
        damage-= 100;
        damage = damage/2+random(damage/2);
        if ( damage <=0 ) damage = me->query("kee")/10;
        me->receive_damage("kee",damage);
        COMBAT_D->report_status(me);
        str="老鸨对着地下的$N吐了口吐沫：呸，没钱也想学人风流？！也不照泡尿照照你的屎样。\n";
        message_vision(str,me);
        return notify_fail("你的钱不够或是面值太大找不开 :) 。\n");
	}
}

