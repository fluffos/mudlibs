#include <ansi.h>
inherit NPC;

void create() {
  set_name("老鸨", ({ "lao bao", "lao", "bao" }));
  set("title", "丽春苑掌柜");
  set("long", "\n徐娘半老，对着来往的过客卖弄着风情。\n" NOR);
  set("gender", "女性");
  set("age", 30 + random(30));
  set("attitude", "peaceful");
  set("rank_info/self", "奴家");
  set("rank_info/respect", "姑奶奶");
  set("per", 10 + random(10));
  set("int", 10 + random(20));
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("force", 2000);
  set("max_force", 1000);
  set("max_mana", 1000);
  set("mana", 2000);
  set("combat_exp", 1000000);
  set("daoxing", 1000000);

  set_skill("literate", 100);
  set_skill("spells", 100);
  set_skill("moonshentong", 100);
  set_skill("force", 100);
  set_skill("moonforce", 100);

  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("chat_chance_combat", 5);
  set("chat_msg_combat", ({
    "老鸨皮笑肉不笑的招呼着各位客人。\n",
    "老鸨假装擦汗，露出半边白皙的肥嘟嘟的胸脯。\n",
    "老鸨挥动着手里的手帕，和众人打情骂俏。\n",
    "老鸨对着龟公耳语几句，龟公点头哈腰的走了。\n",
    "老鸨对着你撒娇着说：好久不来了，是不是忘了人家了。\n",
  }));
  setup();
  carry_object("/d/obj/cloth/skirt")->wear();
  carry_object("/d/ourhome/obj/shoes")->wear();
}
