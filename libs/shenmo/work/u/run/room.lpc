#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", HIM"小屋"NOR);
  set ("long", 
    "小小的木屋里洋溢着祥和的气息。挂着各式饰品的\n"+
"圣诞树、香喷喷的烤火鸡、五颜六色的圣诞蜡烛……所\n"+
"有的一切都在告诉着你：圣诞节到了！！！\n\n\n"+

BLINK+HIM"Merry Christmas and Best Wishes for a Happy New Year!\n"NOR
);

  set("no_fight", 1);
  set("item_desc", ([ /* sizeof() == 1 */
  "bed" : "一张牙玉色的软榻，塌四周雕着竹叶格，看上去极为精致(gosleep,gobed,bed)。 
",
]));

set("objects", ([ /* sizeof() == 1 */ 
 "/u/run/tree" : 1, 
])); 
  set("exits", ([ /* sizeof() == 1 */
  "out" : "/d/city/center",
]));
  set("no_magic", 1);

  setup();
}

void init()
{
        add_action("do_bed", "gosleep");
        add_action("do_bed", "gobed", );
        add_action("do_bed", "bed");
        add_action("do_gua", "gua");
        add_action("do_qu", "qu");
}

int do_bed()
{       object me;
        me=this_player();
        message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
        me->move("/u/run/bed");
            message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
                return 1;
}

int do_gua(string arg)
{
      object me,ob;
      me=this_player();
      if( !arg || arg!="socks" || !(ob=present(arg, me)) || ob->query("name")!=HIR"圣诞袜"NOR ) 
        return notify_fail("圣诞树装饰得这么漂亮，东西可别乱挂上去啊！\n");          
      
      message_vision(HIW"$N小心翼翼的将"+HIR"圣诞袜"+HIW"挂在"+HIG"圣诞树"+HIW"上。\n"NOR,me);
      me->set("mchristmas",1);
      destruct(ob);
      return 1;
}

int do_qu()
{
     object me,gift,socks,letter;
     int i;
     me=this_player();
     if(!me->query("mchristmas")) 
        return notify_fail("圣诞树刚刚装饰好，东西可别乱拿啊！\n");          
     if(!me->query("mchristmas_sleep"))
        return notify_fail("刚挂上去就想收礼物啊？圣诞老人还没来呢！\n");          
     socks=new("/u/run/socks");
     i=random(2);
     if (i==0) gift=new("/u/run/hldan");
     if (i==1) {gift=new("/clone/money/jinbi");gift->add_amount(random(5)+1);}
     if (i==2) gift=new("/u/run/xfguo");
     if (me->query("age")<16) gift=new("/clone/money/gold");
     if (me->query("mchristmas_gift")) gift=0;
     if (gift) gift->move(socks);
     letter=new("/u/run/letter");
     if ( gift ) letter->set("gift",gift->name());
     letter->set("long",HIR"给"HIY+me->query("name")+NOR HIR"信\t\t-----圣诞老人 \n打开看看(open)....:)"NOR);
     letter->move(socks);
     me->set("mchristmas_gift",1);
     me->delete("mchristmas");
     me->delete("mchristmas_sleep");
     message_vision(HIW"$N满怀希望的将"HIR"圣诞袜"+HIW"从"+HIG"圣诞树"+HIW"上取了下来。\n"NOR,me);
     socks->move(me);
     return 1;
}






