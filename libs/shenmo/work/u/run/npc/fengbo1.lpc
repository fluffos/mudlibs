//jiz.

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
int mypot,tapot,time,skill,i;
string msg;
object weapon = me->query_temp("weapon");

if( !target ) target = offensive_target(me);

if( !target
  ||!target->is_character()
  ||!me->is_fighting(target) )
	return notify_fail("「无尽风波」只有在战斗中才能使用。\n");

if(me->query("family/family_name")!="东海龙宫")
	return notify_fail("非龙宫弟子不能用「风波」！\n");

skill = me->query_skill("fengbo-cha", 1); 
if( skill< 100 ) 
	return notify_fail("你的修为不够深，还使不出这一招！\n");

if(me->is_busy())
	return notify_fail("你太忙了！\n");;

if(me->query_temp("dhwl")) 
	return notify_fail("你正在蓄力之中，哪还有余出「无尽风波」。\n");

if ( me->query("force")<1000 )
	return notify_fail("你内力不足，无法掀起风波。\n");

message_vision(HIC"$N挥展开来，左一叉，右一叉，幻出无数大小光环向$n"HIC"绕去。
虽看起来柔弱无力，却宛若秋波般连绵不绝，实是暗藏杀机！\n\n"NOR,me, target);

if ( !target->is_busy() )
	{	
	mypot=(int)me->query_skill("fork");
	mypot=mypot*mypot*mypot/10 + (int)me->query("combat_exp");

	tapot=(int)target->query_skill("parry");
	tapot=tapot*tapot*tapot/10 + (int)target->query("combat_exp");

	if ( random( mypot + tapot ) > random(tapot/4) ) 
		{
		message_vision(HIR"$N果然被这光环套住，当时目瞪口呆，不知所措！\n"NOR,target);
		target->start_busy(5);
		me->add("force",-100);
		}
	else	{
		message_vision(HIR"不料确被$N看破，攻其不备，$n反被打了个措手不及！\n"NOR,target,me);
		me->start_busy(2);
		me->add("force",-150);
		}
	}
else	if ( me->query_skill("fengbo-cha",1)>350 )
	{
	if ( me->query("force")<800 || me->query_temp("fengbo_busy") || !weapon )
		return notify_fail("对方已经够忙的了，你使得再漂亮也没用。\n");

	msg = HIC "$N作龙吟之声，踏碧波而来，$n"HIC"只看到$N化做数团身影,\n"NOR;
	msg += HIC"漫天叉影席卷而来，$n奋力一架，但$N叉分数路，$n只架住一叉！\n"NOR;
	message_vision(msg, me, target);
	skill/=30;
	if ( skill<5 ) skill=5;
	if ( skill>10 ) skill=10;
	for ( i=1;i<skill;i++ )
		{
		COMBAT_D->do_attack(me, target, weapon, 0);
		}
	me->add("force",-10*skill);
	me->set_temp("fengbo_busy",1);
	call_out("remove_effect",3+random(3),me);
	}
return 1;
}

void remove_effect(object me) 
{
if (!me) return;
me->delete_temp("fengbo_busy");
}
