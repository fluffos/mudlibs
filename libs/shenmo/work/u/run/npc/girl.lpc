
#include <ansi.h>
inherit NPC;

int do_love();
void sex(object who);
void check(object me,object ob);
void make_love1(object me,object ob);
void make_love2(object me,object ob);
int do_drop(object me, object obj); 

string *names = ({
                "春兰","chun lan",
                "秋菊","qiu ju",
                "夏荷","xia he",
                "冬梅","dong mei",
                "美美","mei mei",
                "真真","zhen zhen",
                "柔柔","rou rou",
                });

void create()
{
int i;
string name,id;
i = random(sizeof(names)/2)*2;
name = names[i];
id = names[i+1];
set_name(name, ({id, "girl", "nv" }));
set("title", "风尘女子");
set("long",WHT"\n青楼女子，长得貌美如画，对着来往的过客卖弄着风情，暗送着秋波。\n"NOR);
set("gender", "女性");
set("age", 29);
set("attitude", "peaceful");
set("rank_info/self", "奴家");
set("rank_info/respect", "风尘少女");
set("per",20+random(20));
set("int",20+random(20));
set("max_kee", 1000);
set("max_gin", 1000);
set("max_sen", 1000);
set("force", 2000);
set("max_force",1000);
set("max_mana", 1000);
set("mana", 2000);
set("combat_exp", 1000000);
set("daoxing", 1000000);

set_skill("literate", 100);
set_skill("spells", 100);
set_skill("moonshentong", 100);
set_skill("force", 100);
set_skill("moonforce", 100);

map_skill("spells", "moonshentong");
map_skill("force", "moonforce");

set("chat_chance_combat", 10);
set("chat_msg_combat", ({
                (: command("say 官人，来嘛...来嘛...咯...咯咯...\n") :),
        }) );
setup();
carry_object("/d/obj/cloth/skirt")->wear(); 
carry_object("/d/ourhome/obj/shoes")->wear(); 
}

void init()
{
string str,msg;
object me = this_player();
object ob = this_object();
if ( me->query("gender")=="女性" || ob->query_temp("loved") || me->query_temp("loved") )
        return;
str = random(2)?"官人":"冤家";

msg = "四周歌舞升平，一片热闹景象。\n";
if ( random(3)==1 )
        {
        switch(random(5))
                {
                case 1 : { msg += "$N对你吃吃一笑，眉宇间神采飞扬。\n";break; }
                case 2 : { msg += "$N对你一笑："+str+"，你来了？\n";break; }
                case 3 : { msg+= "$N含笑的望着你，玉贝轻吐，仿佛有话要说。\n";break; }
                case 4 : { msg+= "$N朝你偷偷一瞟，吃吃的笑了起来。\n";break; }
                case 5 : { msg+= "$N明眸流彩，对着你偷偷的眉目传情起来。\n";break; }
                }
        msg += "$N在你耳边低低细语：春宵一刻值千金，"+str+"若是有意，我们便......\n";
        msg += "\n\n看来$N很想跟你……如果你愿意，也请下一次 sleep 命令。\n\n";
        msg = replace_string(msg,"$N",ob->query("name"));
        tell_object(me,msg);
        add_action("do_love","sleep");
        }
return;
}

void die()
{
int i;
string file,str;
object *inv,ob,npc;
ob = this_object();

if( environment() ) 
        {
        str = WHT"$N"WHT"媚眼迷离，香汗淋漓，娇喘连连，连声讨饶。\n"NOR;
        str = "\n$N一声嘤咛，讨饶道：饶了奴家吧，奴家再也吃不消了。\n
说罢，爬起身来，什么也顾忌不得，跌跌撞撞的夺路而逃了。\n";
        str+= "\n一旁闪出一位俏佳人，道：妹妹，看姐姐的......\n";
        str = replace_string(str,"$N",ob->name());
        message("sound",str,environment());
        npc = new("/u/run/npc/girl");
        npc->move(environment());
        inv = all_inventory(this_object());
        for(i=0; i<sizeof(inv); i++) 
                {
                if (inv[i]->query("no_drop")) continue;
                do_drop(this_object(), inv[i]);
                }
        }
destruct(this_object());
}

int do_drop(object me, object obj) 
{
if (obj->move(environment(me))) 
        {
        if( (obj->query_temp("d_mana"))>0 ) 
                {
                if( obj->query_temp("is_living")==1 )
                        message_vision("$N将$n从背上放了下来，躺在地上。\n", me, obj);
                else {
                        message_vision( sprintf("$N丢下一%s$n。\n",
                        undefinedp(obj->query_temp("unit"))?"个":obj->query_temp("unit")), me, obj );
                        }
                } 
        else    {
                if( obj->is_character() )
                        message_vision("$N将$n从背上放了下来，躺在地上。\n", me, obj);
                else    {
                        message_vision( sprintf("$N丢下一%s$n。\n", obj->query("unit")),me, obj );
                        if( !obj->query("value") && !obj->value() ) 
                                {
                                tell_object(me,"因为这样东西并不值钱，所以人们并不会注意到它的存在。\n");
                                destruct(obj);
                                }
                        }
                }
        return 1;
        }
return 0;
}


void unconcious()
{
die();
}

int do_love()
{
string msg;
object me = this_player();
object ob = this_object();

if ( environment(me)!=environment(ob) )
        return 1;
if ( !me->query_temp("sex_paid") )
        {
        command("pei");
        command("say 人来！！\n");
        message_vision("旁边冲出来几个龟公，泼口大骂：没钱也想学人嫖鸡？!\n",me);
        return 1;
        }
if ( me->query("gender")=="女性" )
        return 1;
if ( me->query_temp("loved") || me->query_temp("loved") )
        return 1;

msg = "$N朝$n会心一笑，走过去一把揽住$n的小蛮腰。\n";
message_vision(msg,me,ob);
me->delete_temp("sex_paid");
me->set_temp("loved",1);
ob->set_temp("loved",1);
me->set_temp("sex",ob);
ob->set_temp("sex",me);
me->start_busy(5);
ob->start_busy(5);
ob->save();
call_out("make_love1",2+random(3),me,ob);
return 0;
}

void make_love1(object me,object ob)
{
string msg;

if ( environment(me)!=environment(ob) )
        return;

if ( me->query("gender")=="女性" )
        return;

if ( (int)me->query_temp("yinshentime") ) 
        { 
        me->delete_temp("yinshentime"); 
        me->delete("env/invisibility");       
        me->save(); 
        me->delete_temp("no_heal_up/yinshen"); 
        message_vision(HIW"\n白光闪过之后，$N又现出了身形。\n\n"NOR, me); 
        } 

msg = "$n不由粉面含羞道：官人也得找一清净所在行乐......\n";
msg+= "$N笑答：男儿志在四方，不拘于小节也，小娘子何必斤斤计较。\n";
message_vision(msg,me,ob);
ob->command("shy");
if ( !me->is_busy() )
        me->start_busy(4);
if ( !ob->is_busy() )
        ob->start_busy(4);
ob->save();
remove_call_out("make_love1");
call_out("make_love2",2+random(3),me,ob);
}

void make_love2(object me,object ob)
{
string msg;

if ( environment(me)!=environment(ob) )
        return;

if ( me->query("gender")=="女性" )
        return;

msg = "$N搂着$n柔软的身体，不由得心醉神迷……\n\n"; 
message_vision(msg,me,ob);
ob->command("remove all");
me->command("remove all");
message_vision("\n\n当下两人便作鱼水之欢...\n\n",me,ob);
if ( !me->is_busy() )
        me->start_busy(4);
if ( !ob->is_busy() )
        ob->start_busy(4);
ob->save();
remove_call_out("make_love2");
call_out("check",2+random(3),me,ob);
}

void check(object me,object ob)
{
string msg;

if ( environment(me)!=environment(ob) )
        return;

if ( me->query("gender")=="女性" )
        return;

if ( me->query("kee")<100 || me->query("sen")<100 )
        {
        msg = "$N忽地一阵抽搐，看是已经了事......\n";
        msg+= "$n不由花容变色，嗔道：好一个银妆蜡枪头，中看不中用...\n";
        msg+= "$N支支吾吾，羞愧难当......\n";
        message_vision(msg,me,ob);
        me->delete_temp("loved");
        ob->delete_temp("loved");
        me->delete_temp("sex");
        ob->delete_temp("sex");
        ob->set("kee",query("max_kee"));
        ob->set("sen",query("max_kee"));
        ob->save();
        me->unconcious();
        msg = HIC"$N($I)：石榴裙下死，做鬼也风流，$n($i)败在姑奶奶的手上了！\n"NOR;
        msg = replace_string(msg,"$N",ob->query("name"));
        msg = replace_string(msg,"$n",me->query("name"));
        msg = replace_string(msg,"$I",capitalize(ob->query("id")));
        msg = replace_string(msg,"$i",me->query("id"));
        message("channel:chat",WHT"〖"NOR HIG"谈天说地"NOR WHT"〗"NOR +msg,users());
        ob->command("get all from "+me->query("id"));
        return;
        }

if ( ob->query("kee")<100 || ob->query("sen")<100 )
        {
        ob->die();
       return;
        }

sex(ob);
sex(me);
remove_call_out("check");
call_out("check",3+random(3),me,ob);
}

void sex(object who)
{
int damage,dp,ap,flg;
string str,msg,*got_msg,*lost_msg;
string *limbs;
object env,target;
env = environment(who);
target = who->query_temp("sex");
got_msg = ({
        "$N轻咬$n的$l，$n不由发出一阵喘息，开始有了反应。\n",
        "$N$H轻轻一触$n的$l,$n不由浑身一颤......\n",
        "$N下身微微轻摇，$n只觉$h一阵骚热，不由叫了出声来。\n",
        "$N轻轻在$n$h上一舔，$n不禁发出一声舒服的叫声。\n",
        });
lost_msg = ({
        "$N轻咬$n的$l，$n对之好似习以为常，不见丝毫反应。\n",
        "$N$H轻轻一触$n的$l,$n倒也不以为然。\n",
        "$N下身微微轻摇，$n应付式的哼了几下。\n",
        "$N轻轻在$n$h上一舔，$n觉得意犹未尽。\n",
        });
 
ap = who->query("comat_exp")/10000+10;
ap-= who->query("daoxing")/10000;
dp = target->query("comat_exp")/10000+10;
dp-= target->query("daoxing")/10000;

if ( random(ap+dp)>dp )
        {
        msg = got_msg[random(sizeof(got_msg))];
        flg = 1;
        }
else    {
        msg = lost_msg[random(sizeof(got_msg))];
        flg = 0;
        }

if ( who->query("gender")=="女性" )
        limbs = ({ "双峰","玉峰","香舌","柔荑","玉蚌",});
else    limbs = ({ "胸膛","双手","舌头","鼠蹶",});
str = limbs[random(sizeof(limbs))];
msg = replace_string(msg,"$H",str);

if ( who->query("gender")!="女性" )
        limbs = ({ "双峰","玉峰","香舌","柔荑",});
else    limbs = ({ "胸膛","双手","舌头",});
str = limbs[random(sizeof(limbs))];
msg = replace_string(msg,"$l",str);

if ( who->query("gender")!="女性" )
        str = "玉蚌";
else    str = "鼠蹶";
msg = replace_string(msg,"$h",str);

message_vision(msg,who,target);

if ( flg = 1 )
        {
        damage = target->query("kee");
        damage+= target->query("sen");
        damage/= 10;
        damage = damage/2 + random(damage/2);
        target->receive_damage("kee",damage);
        }
else    {
        damage = who->query("kee");
        damage+= who->query("sen");
        damage/= 10;
        damage = damage/2 + random(damage/2);
        who->receive_damage("kee",damage);
        }
who->start_busy(5);
target->start_busy(5);
return;
}
                
int accept_object(object me,object ob) 
{ 
if ( !userp(me) ) 
        return notify_fail("小猫小狗的也来捣乱？！\n"); 
if ( ob->query("money_id") && ob->value() == 100000 )  
        { 
        tell_object(me,name()+"接过银两，笑得更甜了。\n"); 
        me->set_temp("sex_paid",1); 
        return 1; 
        } 
return notify_fail("给我十两黄金再说。\n"); 
} 

