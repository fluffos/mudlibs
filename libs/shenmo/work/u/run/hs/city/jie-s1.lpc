//地水火风
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "风の大街" NOR);
  set("long", @LONG

你走在一条宽阔的石板大街上，北面就快到城中心了，可以看到钟楼
耸立于前；南面通往郊外；西边是仓库保管室。

LONG);
  set("exits", ([
    "south": __DIR__ "gate-s",  //城门
    "north": __DIR__ "center",  //中心
    "west": __DIR__ "canku",  //仓库
  ]));
  setup();
}
