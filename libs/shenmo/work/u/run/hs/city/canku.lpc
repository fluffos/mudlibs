//把可以存的obj都设置hs/store

#include <ansi.h>
inherit ROOM;
object treasure_obj;
object findobj();

void create() {
  object box;
  set("short", "仓库");
  set("long", @LONG
  
这里专门提供寄存服务。你可以在这里寄存(jicun)物品，
价格公道，不论物品贵贱，一律按原价的四成收费。
可以随时取回(qu)。

LONG);

  set("exits", ([
    "east": __DIR__ "jie-s1",
  ]));
  set("objects", ([
    "/d/obj/weapon/sword/changjian": 1,
  ]));
  set("no_clean_up", 1);
  set("no_magic", 1);
  set("no_fight", 1);
  setup();
}

void init() {
  add_action("do_jicun", "jicun");
  add_action("do_qu", "qu");
  add_action("do_checks", "chaxun");
}

int do_checks() {
  int i, limit;
  string id = "你目前在此寄存有：\n\n";
  mapping *hs_goods;
  object me = this_player();
  limit = (int)me->query("hs_jicun_limit");
  if (!limit || limit <= 0)
    return notify_fail("你目前没有寄存过物品。\n");
  hs_goods = me->query("hs_goods");
  for (i = 0; i < sizeof(hs_goods); i++) {
    id += "\t\t$W($I)\n";
    id = replace_string(id, "$W", hs_goods[i]["name"]);
    id = replace_string(id, "$I", capitalize(hs_goods[i]["id"]));
  }
  tell_object(me, id);
  return 1;
}

int do_jicun(string arg) {
  int i, limit, value, afford;
  object ob, *inv;
  object env = this_object();
  object me = this_player();

  if (!present(arg, me))
    return notify_fail("你身上没有这样东西。\n");
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("id") != arg) continue;
    ob = inv[i];
    break;
  }
  if (!ob || interactive(ob))
    return notify_fail("你要寄存什么东西?\n");

  limit = (int)me->query("hs_jicun_limit");
  if (limit && limit > 20)
    return notify_fail("对不起,每个人最多只能寄存20个物品。\n");

  value = (int)ob->query("value") / 4;

  if (value <= 0) {
    write("这样东西不值钱。\n");
    return 1;
  }

  if (!(afford = me->can_afford(value))) {
    write("你没有足够的钱。\n");
    return 1;
  } else if (afford == 2) {
    write("你没有足够的零钱，而银票又没人找得开。\n");
    return 1;
  }
  message_vision("$N寄存" + ob->name() + "一" + ob->query("unit") + "。\n" NOR, me);
  me->set("hs_goods/" + arg, ob);
  me->start_busy(1);
  me->pay_money(value);
  me->add("hs_jicun_limit", 1);
  me->save();
  ob->move(__DIR__ "room");
  return 1;
}

int do_qu(string arg) {
  int i, limit, flag = 0;
  mapping *hs_goods;
  object ob;
  object me = this_player();
  limit = (int)me->query("hs_jicun_limit");
  if (!limit || limit <= 0)
    return notify_fail("你目前没有寄存过物品。\n");
  hs_goods = me->query("hs_goods");
  for (i = 0; i < sizeof(hs_goods); i++) {
    if (hs_goods[i]["id"] == arg) {
      flag++;
      //                ob = reload_object(hs_goods[i]["obj"]);
      break;
    }
  }
  if (flag < 1) {
    do_checks();
    return notify_fail("你要取回什么？\n");
  } else {
    if (!ob)
      return notify_fail("ERROR!出错。\n");
    ob->move(me);
    if (!present(ob, me))
      return notify_fail("ERROR!出错。\n");
    message_vision("$N取出一" + ob->query("unit") + ob->query("name") + "。\n", me);
    me->add("hs_jicun_limit", -1);
    me->save();
    return 1;
  }
}
