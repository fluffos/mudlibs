#include <ansi.h>
inherit ITEM;

string *sx = ({
        "风","火","水","土","风","火","水","土"
});

string do_look()
{
string msg,str,name;

if ( !query("sign") )
	msg = "一张空白的通行证。\n";
else	{
	name = query("signer");
	str = query("属性");
	msg = "一张"+name+"亲手签名的通行证。上面写道：\n\n\t\t";
	msg+= "准许"+query("owner")->name()+"前去"+str+"门。\n";
	}
return msg;
}

void create()
{
set_name("通行证",({"tong xing zheng","zheng"}));
set_weight(1000);
if( clonep() )
	set_default_object(__FILE__);
else	{
	set("unit", "张");
	set("long",(: do_look :));
	set("material", "paper");
	}
setup();
}

void dismiss(object ob)
{
string str = query("属性");
if ( !ob || !objectp(ob) )
	return;
remove_call_out("dismiss");
message("vision","一群"+str+"系守卫走了过来，看到"+ob->name()+"，不由大叫：果然找到遗失的通行证了！\n
一行人夺过"+ob->name()+"，扬长而去。\n",environment(ob),ob);
destruct(ob);
return;
}

void check_owner()
{
object me = environment(this_object());
if ( !query("sign") )
        return;
if ( me!=query("owner") )
	call_out("dismiss",1+random(9),this_object());
}

void init()
{
check_owner();
add_action("do_sign","sign");
}

int do_sign()
{
string str;
object me = environment(this_object());
if ( query("sign") )
	return notify_fail("这张通行证已经签名了。\n");
message_vision("$N龙飞凤舞的在$n上签上了自己的大名。\n",me,this_object());
set("sign",1);
if ( !wizardp(me) && interactive(me) )
	return 1;
if ( wizardp(me) )
	{
	str = sx[random(sizeof(sx))];
	set("属性",str);
	set("signer",me->query("name"));
	set("ownered",me);
	}
this_object()->save();
return 1;
}
	
