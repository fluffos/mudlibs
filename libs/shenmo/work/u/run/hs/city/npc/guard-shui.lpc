inherit NPC;
#include <ansi.h>
#include "guard.h"

#define NAMES_D "/u/run/hs/city/npc/named.lpc"

void create()
{
int j, i = 1 + random(4);
mapping name = NAMES_D->random_name(1,2,"水", 0,0);
if( !name )
	name = ([ "name": "水女",  "id": ({ "shui nv", "nv", "guard"}) ]);
set_name(name["name"], name["id"]);
set("title","水系守卫");
set("gender","女性");
set("combat_exp",80000000);
set("age",16+random(10));
set("per",20+random(20));
set("属性","水");
set("back","east");
set("attitude", "friendly");
setup();
carry_object("/obj/cloth")->wear();
}

