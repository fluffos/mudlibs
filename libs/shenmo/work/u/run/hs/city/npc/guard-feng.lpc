inherit NPC;
#include <ansi.h>
#include "guard.h"

#define NAMES_D "/u/run/hs/city/npc/named.lpc"

void create()
{
mapping name = NAMES_D->random_name(random(2)?0:1,1,0,0,"风");
if( !name )
	name = ([ "name": "风舞",  "id": ({ "feng wu", "wu", "guard"}) ]);
set_name(name["name"], name["id"]);
set("title","风系守卫");
set("gender",random(2)?"男性":"女性");
set("combat_exp",80000000);
set("age",16+random(20));
set("per",10+random(30));
set("属性","风");
set("attitude", "friendly");
set("back","north");
setup();
carry_object("/obj/cloth")->wear();
}

