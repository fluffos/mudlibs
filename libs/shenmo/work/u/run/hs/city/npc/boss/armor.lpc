#define F_VENDOR_SALES __DIR__"vendor_sale"
inherit F_VENDOR_SALES;
#include <ansi.h>

#define NAMES_D "/u/run/hs/city/npc/named.lpc"

void create()
{
int j, i = 1 + random(4);
mapping name = NAMES_D->random_name(0, 0, 0, 0, "斯");
if( !name )
	name = ([ "name": "帝斯",  "id": ({ "di si", "di", "si","boss" }) ]);
set_name(name["name"], name["id"]);
reload("armor");
set("shop_id",({"laoban","boss"}));
set("shop_title","魔甲商人");
set("title","魔甲商人");
set("gender","男性");
set("combat_exp",1000000);
set("age",30+random(50));
set("per",20+random(20));
set("attitude", "friendly");
set("max_price",20);
set("vendor_goods", ([
//        "book": "/d/sds5/city/obj/item/jipu",
]) );
if( clonep() ) CHANNEL_D->register_relay_channel("rumor");
setup();
carry_object("/obj/cloth")->wear();
}

