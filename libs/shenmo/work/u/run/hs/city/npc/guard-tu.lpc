inherit NPC;
#include <ansi.h>
#include "guard.h"

#define NAMES_D "/u/run/hs/city/npc/named.lpc"

void create()
{
int j, i = 1 + random(4);
mapping name = NAMES_D->random_name(0,1,0,"土",0);
if( !name )
	name = ([ "name": "土龙",  "id": ({ "tu long", "long", "guard"}) ]);
set_name(name["name"], name["id"]);
set("title","土系守卫");
set("gender","男性");
set("combat_exp",80000000);
set("age",30+random(50));
set("per",20+random(20));
set("属性","土");
set("back","south");
set("attitude", "friendly");
setup();
carry_object("/obj/cloth")->wear();
}

