#include <ansi.h>
#include <login.h>

inherit NPC;
inherit F_SAVE;

private string SAVE_NAME="hs_save";
private nosave int can_save=1;

int restore();
int save();
void reset();


void reset()
{
        if( !environment() || ! find_living(query("owner")) )
        {
                destruct(this_object());
                return;
        }
}
string query_save_file()
{
        string id;
        id = query("owner");
        if( !id ) return 0;
        return sprintf("/hs/%c/%s", id[0], id);
}
/*
int save()
{
        string file;
        if( stringp(file = this_object()->query_save_file()) ) {
//                assure_file(file+ __SAVE_EXTENSION__);
                return save_object(file);
        }
        return 0;
}
*/
int restore()
{
        string file;

        if( stringp(file = this_object()->query_save_file()) )
                return restore_object(file);
        return 0;
}

int save()
{
	int res;
	string file=query_save_file();
	string dir="/hs/";
	int len=strlen(dir);
	
	if(!file || strlen(file)<=len) return 0;
	if(file[0..(len-1)]!=dir) return 0;

        if(clonep() && can_save) {
	  res = ::save();
	  return res;
	} else
	  return 0;  
}



void create()
{
      seteuid(getuid());
  set_name("幻兽", ({"hs"}));
  set("gender", "男性");
  set("combat_exp", 1500);
  set("base_name","兔");
  set("force", 10);
  set("max_force", 10);
  set("owner","run");
  setup();
}


void init()
{
        add_action("do_kkk","kkk");
}

int do_kkk()
{
  set("unit","头");
  return 1;
}
