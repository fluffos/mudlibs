#include <ansi.h>
inherit ITEM;

string *eat_msg=({
          "$N拿起玉筷夹了些$name，放到嘴中吃了起来。\n",
          "$N吃了一大口$name。\n",
          "$N尝了尝$name。\n",
          "$N夹了些$name，放到嘴中。\n",
          "$N细细品尝着$name。\n",
          });

void create()
{       
string name = "过年大菜";
set_name(name, ({"food"}));
set_weight(1000);
        set("long", "一盘令人垂涎的过年大菜。\n");
        set("unit", "盘");
        set("value", 250);
        set("no_get", "安心吃菜吧！还想打包？\n");
setup();
}

void init ()
{
add_action("do_eat", "eat");
}

int do_eat (string arg)
{
mapping skills;
int size,i;
string msg,name,skill,*strs; 
object ob = this_object();
object me = this_player();
name=query("name");
msg = eat_msg[random(sizeof(eat_msg))];
msg = replace_string(msg,"$name",name);

if ( !arg || !id(arg) )
        return notify_fail(HIR"你要对谁做这个动作？:)\n"NOR);

if ( me->is_busy() )
        return notify_fail(HIR"新年快乐，你正忙着呢。:) \n"NOR);

if( name=="龙凤呈祥" ) 
        message_vision("众人看着$N，齐声大笑道：哈！龙凤呈祥！恭喜！恭喜！\n",me);
message_vision(msg,me);
if ( me->query("礼物/2003元旦1")<5 )
        {
        if ( random(5)==1 )
                {
                skills = me->query_skills();
                strs = keys(skills);
                if ( sizeof(strs)>0 )
                        {
                        size = random(sizeof(strs));
                        skill = strs[size];
                        i = me->query_skill(skill,1);
                        me->set_skill(skill,i+1);
                        }
                else    {
                        skill = ({"force","parry","dodge",})[random(3)];
                        me->set(skill,1);       
                        }
                name = to_chinese(skill);
                tell_object(me,HIR"新年快乐，你的得到了一级"+name+"。\n"NOR);
                }
        else if ( random(3)==1 )
                {
                i = 10000+random(15000);
                me->add("combat_exp",i);
                tell_object(me,HIR"新年快乐，你的得到了"+chinese_number(i)+"武学经验。\n"NOR);
                }
        else if ( random(2)==1 )
                {
                i = 5000+random(5000);
                me->add("potential",i);
                tell_object(me,HIR"新年快乐，你的得到了"+chinese_number(i)+"点潜能。\n"NOR);
                }
        else    {
                i = 10000+random(15000);
                me->add("daoxing",i);
                tell_object(me,HIR"新年快乐，你的得到了"+COMBAT_D->chinese_daoxing(i)+"道行。\n"NOR);
                }
        me->add("礼物/2003元旦1",1);
        me->save();
        }
destruct(ob);
return 1;
}

