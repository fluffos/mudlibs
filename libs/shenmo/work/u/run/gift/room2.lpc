inherit ROOM;
#include <ansi.h>
#include "names.h"

void create() {
  string msg;
  set("short", HIG "除夕夜" NOR HIM "大火炕" NOR);
  msg = HIR + @LONG

        ╔♂╗┏┯┓┏┯┓┏┯┓┏┯┓╔♀╗ 
        ┃★┃┠新┨┠年┨┠快┨┠乐┨┃☆┃ 
        ┃☆┃┗┷┛┗┷┛┗┷┛┗┷┛┃★┃ 
        ╚♂╝↘*≡恭≡喜≡发≡财≡*↙╚♀╝ 

LONG + NOR;
  msg += "\n";
  msg = replace_string(msg, "新", NOR HIY "新" NOR HIR);
  msg = replace_string(msg, "年", NOR HIY "年" NOR HIR);
  msg = replace_string(msg, "快", NOR HIY "快" NOR HIR);
  msg = replace_string(msg, "乐", NOR HIY "乐" NOR HIR);
  msg = replace_string(msg, "恭", NOR HIC "恭" NOR HIR);
  msg = replace_string(msg, "喜", NOR HIC "喜" NOR HIR);
  msg = replace_string(msg, "发", NOR HIC "发" NOR HIR);
  msg = replace_string(msg, "财", NOR HIC "财" NOR HIR);
  msg = replace_string(msg, "★", NOR BLINK HIM "★" NOR HIR);
  msg = replace_string(msg, "☆", NOR BLINK HIG "☆" NOR HIR);
  set("long", msg);
  set("no_magic", 1);
  set("no_fight", 1);
  set("no_time", 1);
  set("freeze", 1);
  setup();
}

int do_none() {
  write(HIR "新年快乐。\n" NOR);
  return 1;
}

void init() {
  string msg, str;
  object smoke = new(__DIR__ "yan");
  object me = this_player();
  object env = this_object();
  int ageme = me->query("mud_age");

  add_action("do_start", "start");
  add_action("do_food", "cai");
  add_action("do_none", "cast");
  add_action("do_none", "quit");
  add_action("do_none", "move");
  add_action("do_none", "burn");
  add_action("do_none", "accept");

  if (!userp(me)) return 0;
  if (ageme < 0) {
    tell_object(me, HIR "新年快乐，本站规定，新人必须上线五分钟以上才可以接受此礼物。:) \n" NOR);
    me->move("/d/city/kezhan");
    message_vision("$N不甘心的从火炕上下来。\n", me);
    return;
  }

  if (env->query("start")) {
    tell_object(me, HIR "新年快乐，宴会已经开始了，你来晚了。:) \n" NOR);
    me->move("/d/city/kezhan");
    message_vision("$N不甘心的从火炕上下来。\n", me);
    return;
  }

  if (me->query_temp("welcome"))
    return;

  str = wizname(0);
  msg = HIW "\n天" NOR HIC "上" NOR HIY "人" NOR HIG "间" NOR HIM "的" HIY "巫师" NOR + str;
  msg += HIR "笑嘻嘻的迎了过来，对着$N" HIR "道：这位" + RANK_D->query_respect(me) + HIR "新年好新年好。\n" NOR;
  message_vision(msg, me);
  me->set_temp("welcome", 1);
  me->save();
  if (!me->query("礼物/2003元旦/发烟")) {
    smoke->move(me);
    if (present(smoke, me)) {
      message_vision(str + HIR "递给$N" HIR "一支" + smoke->name() + HIR "。\n" NOR, me);
      me->set("礼物/2003元旦/发烟", 1);
      me->save();
    }
  }
  return;
}

int do_start() {
  string msg, str, food;
  object env = this_object();
  object me = this_player();

  if (env->query("start") || !wizardp(me))
    return notify_fail(HIR "新年快乐。:) \n" NOR);

  msg = HIR + @LONG

        ＃〓§〓〓〓〓〓§〓〓〓〓〓〓§〓〓〓〓〓§〓＃ 
        　　↓　　　　　↓　　　　　　↓　　　　　↓ 
        　☆★☆　　　☆★☆　　　　☆★☆　　　☆★☆ 
        ☆　新　☆　☆　年　☆　　☆　快　☆　☆　乐　☆ 
        　☆★☆　　　☆★☆　　　　☆★☆　　　☆★☆ 
        　　↓　　　　　↓　　　　　　↓　　　　　↓ 
        　　※　　　　　※　　　　　　※　　　　　※  

LONG + NOR;
  msg = replace_string(msg, "新", NOR HIY "新" NOR HIR);
  msg = replace_string(msg, "年", NOR HIY "年" NOR HIR);
  msg = replace_string(msg, "快", NOR HIY "快" NOR HIR);
  msg = replace_string(msg, "乐", NOR HIY "乐" NOR HIR);
  msg = replace_string(msg, "★", NOR BLINK HIM "★" NOR HIR);
  msg = replace_string(msg, "☆", NOR BLINK HIG "☆" NOR HIR);

  msg += HIR "\n
        $N($I)：新年快乐，现在开始吃年夜饭啦~~~~ \n\n" NOR;
  msg = replace_string(msg, "$N", me->query("name") + NOR HIR);
  msg = replace_string(msg, "$I", capitalize(me->query("id")) + NOR HIR);
  message("shout", msg, users());
  env->set("start", 1);
  env->save();
  return 1;
}

int do_food() {
  string wiz, food, msg;
  object me = this_player();
  object env = this_object();

  if (!env->query("start") || !wizardp(me) || present("food", env))
    return notify_fail(HIR "新年快乐。:) \n" NOR);

  wiz = wizname(0);
  food = YEL + foods[random(sizeof(foods))] + NOR;
  msg = HIR "\t\t开宴啦～～开宴啦～～开宴啦～～～\n" NOR;
  message("channel:chat", msg, users());
  call_out("food", 3 + random(10), wiz, food, env);
  return 1;
}

void food(string wiz, string food, object env) {
  int i;
  object *who;
  string str, msg = " \n";
  object f = new(__DIR__ "food");

  msg += HIR "\t\t只见$W" HIR "伸手凌空一指，变出了一桌$F" HIR "。\n" NOR;
  msg += HIR "\t\t众人见状，个个食指大动，垂涎欲滴。\n" NOR;

  msg = replace_string(msg, "$W", wiz);
  msg = replace_string(msg, "$F", food);
  message("channel:chat", msg, users());

  f->set_name(food, ({ "food" }));
  f->say();
  who = all_inventory(env);
  for (i = 0; i < sizeof(who); i++) {
    if (!userp(who[i])) continue;
    f->move(who[i]);
    if (present(f, who[i]))
      message_vision(HIC "\n" + wiz + HIW "递给$N" HIW "一盘" + food + HIW "。\n" NOR, who[i]);
  }
  if (random(5) == 1) {
    msg = HIR + @LONG

        ┏━┓         \ /         ┏━┓       
        ┃新┃      恭祝发财       ┃乐┃
        ┗━┛| ┏━┓ / \ ┏━┓ |┗━┛
             -o-┃年┃     ┃快┃-o-     
          +   | ┗━┛  *  ┗━┛ |  +

LONG;
    msg = replace_string(msg, "新", NOR HIY "新" NOR HIR);
    msg = replace_string(msg, "年", NOR HIY "年" NOR HIR);
    msg = replace_string(msg, "快", NOR HIY "快" NOR HIR);
    msg = replace_string(msg, "乐", NOR HIY "乐" NOR HIR);
    msg = replace_string(msg, "/", NOR HIG "/" NOR HIR);
    msg = replace_string(msg, "-", NOR HIG "-" NOR HIR);
    msg = replace_string(msg, "o", NOR HIY "o" NOR HIR);
    msg = replace_string(msg, "+", NOR HIW "+" NOR HIR);
    str = wizname(1);
    msg += HIR "\n\n" + str + HIR "：祝大家新年快乐....\n\n" NOR;
    message("shout", msg, users());
  }
  return;
}
