#include <ansi.h>
inherit ITEM;

string *word = ({
     "身体健康\t","万事如意\t","前程似锦\t","一帆风顺\t","年年岁岁\t","开开心心\t","心想事成\t","美女如云\t",
});

void create()
{
set_name(HIR"圣诞老人"NOR"的"HIW"信"NOR, ({"letter", "xin"}));
set_weight(10);
if( clonep() )
        set_default_object(__FILE__);
else    {
        set("unit", "封");
        set("no_sell",HIR"Merry Chrismas\n"NOR);
        }
setup();
}

void init()
{
add_action("do_open","open");
}

int do_open(string arg)
{
int i;
string msg,gift;
object ob = this_object();
object me = environment(ob);
gift=ob->query("gift");
if ( !arg || !id(arg) )
        return notify_fail(HIR"你要拆开什么？\n"NOR);
if ( ob->query("open") )
        return notify_fail(HIR"信已经拆开过了。:)\n"NOR);

tell_object(me,ob,HIR"$N"HIR"兴奋的将$n"HIR"拆开...."NOR);
tell_object(me,HIR"一个白胡子老头从信里钻了出来，附耳在"+me->name()+HIR"耳边说了几句就不见了。\n"NOR);
msg = HIR"圣诞老人笑嘻嘻的出现在你的面前，对你说到：\n
圣诞快乐，特送你一"NOR+HIY+gift+NOR HIR"并祝你:\n\n";
for ( i=0;i<(1+random(8));i++)
        {       
        msg+=word[random(sizeof(word))];
        }
tell_object(me,msg+NOR"\n");
msg = HIG"【"NOR HIR"圣诞快乐"NOR HIG"】"NOR HIR"$N($I)：圣诞快乐";
msg = replace_string(msg,"$N",me->query("name"));
msg = replace_string(msg,"$I",capitalize(me->query("id")));
if ( random(2)==1 ) {
        msg+="\n
°★．☆° ．★·°∴°★．°·∴°☆ ·°∴° ☆．．·

☆°★°∴°°∴ ☆°．·★°∴°．
   ◢◣。       ◢◣。     ☆圣★
  ◢★◣。     ◢★◣。     ★诞☆
 ◢■■◣。   ◢■■◣。     ☆节★
◢■■■◣。 ◢■■■◣。      ★快☆
︸︸||︸︸ !!︸︸||︸︸        ☆乐★
祝圣诞节快乐 ^_^!!☆°★°∴°°∴ ☆°．·★°∴°．

°★．☆° ．★·°∴°★．°·∴°☆ ·°∴° ☆．．·．\n"NOR;
msg = replace_string(msg,"★",NOR HIR"★");
msg = replace_string(msg,"☆",NOR HIG"☆");
msg = replace_string(msg,"·",NOR HIR"·");
msg = replace_string(msg,"°",NOR HIG"°");
  }
else { msg+= "\n
               |
           \   "NOR HIG"*"NOR HIR"  ./
          .  "NOR HIW"*"NOR HIY" *"NOR HIC" *"NOR HIR" .
         -=*  POP! *=-              
         .  ."NOR HIY"*"NOR HIM" *"NOR HIB" *"NOR HIR"  .
          /    "NOR WHT"*"NOR HIR"  .\
               |  
               .     

　　　/\~~~~~~~~~~~~~\　　　▓　　^*^　　　☆　　$$　 .☆ 
　　./　\~~~▓~　 ~~~~\ ◆　　圣诞 .快乐　 *　 $◢◣$　 * 
　　/ ^^ \ ══════\.◆　　　 *　*　　*　 $◢★◣$　 * 
　..▎[]　▎田　田 ▎ |┃◆　 .　　　　　*　 $◢■■◣$　 * 
　&&▎　　▎　　　 ▎'|'▎ @　　　　　　　* $◢■■■◣$ * 
＃ ■■■■■■■■■■〓▄▃▂▁愿你圣诞快乐︸︸||︸︸ \n"NOR;
  }
tell_object(users(),msg);
ob->set("open",1);
return 1;
}


