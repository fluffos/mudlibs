#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIR"圣诞袜"NOR, ({ "socks" }) );
        set_weight(1000);
        set_max_encumbrance(10000000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
                set("no_give","你舍得给人？\n");
                set("long", "一对红色的大袜子,据说在平安夜时将它挂在圣诞树上，隔天醒来时会发现袜子里装满了圣诞礼物。\n");
                set("value", 1000);
        }
}
int is_container() { return 1; }
