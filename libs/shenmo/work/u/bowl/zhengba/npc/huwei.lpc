inherit NPC;
#include <ansi.h>

void create() {
  set_name("护卫", ({ "huwei", "hu wei" }));
  set("title", HIY "西游记--神魔传说" NOR);
  set("gender", "男性");

  set("age", 18);
  set("per", 30);
  set("str", 30);
  set("kar", 40);
  set("int", 40);
  set("con", 40);

  set("long", "
西游记--神魔传说守护封禅台的护卫。他出手狠毒，很少有人能在他手下走过两个回合
");

  set("combat_exp", 1000000000);
  set("daoxing", 1000000000);
  set_skill("unarmed", 1000);
  set_skill("dodge", 1000);
  set_skill("parry", 1000);
  set_skill("sword", 1000);
  set_skill("dragonfight", 1000);
  set_skill("mozi-sword", 1000);

  set_skill("force", 1000);
  set_skill("spells", 1000);
  set_skill("dragonforce", 1000);
  set_skill("buddhism", 1000);
  map_skill("force", "dragonforce");
  map_skill("spells", "buddhism");
  map_skill("sword", "mozi-sword");
  map_skill("parry", "mozi-sword");
  map_skill("dodge", "mozi-sword");
  map_skill("unarmed", "dragonfight");

  set("max_sen", 4000);
  set("max_kee", 4000);
  set("force", 8000);
  set("max_force", 8000);
  set("mana", 8000);
  set("max_mana", 8000);
  set("force_factor", 8000);
  set("mana_factor", 8000);
  setup();
  carry_object("/d/youxia/obj/mozi")->wield();
  carry_object("/d/youxia/obj/wushicloth")->wear();
}


void kill_ob(object ob) {
  message_vision("你也太小巧，我们西游记--神魔传说的护卫了!\n", ob);
  message_vision("接招!!!!!!\n", ob);
  ob->unconcious();
  ::kill_ob(ob);
}

int accept_fight() {
  write(CYN "护卫说道：去，去，去。这儿不是你撒野的地方\n" NOR);
  return 0;
}
