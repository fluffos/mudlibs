inherit ROOM;

#include <ansi.h>

void create()
{
set("short","山门");
set("long",
"两旁的山势十分陡峭，山顶上隐隐约约的有人影晃动"
"山门旁边的石柱上刻着一幅对联：\n"
        HIW"\n文无第一，武无第二\n"NOR
);
set("object",([
]));
set("exit",([
"northup":__DIR__"road1",
]));

setup();
replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
if (dir == "northup" ) {
if (	wizardp(me)
	||	me->query_temp("zhengba_begin"))
   return ::valid_leave(me, dir);
if(objectp(present("huwei", environment(me)))) {
return
notify_fail("护卫喝道：武林胜地岂是你乱闯之地！\n");
}
return 1;
}
return 1;
}
