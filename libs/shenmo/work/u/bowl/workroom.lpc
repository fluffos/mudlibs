inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "晚风居");
  set("long",
    HIM "夜色一帘幽梦，春风十里柔情" NOR
    HIW "\n\n制作武林争霸\n" NOR
  );

  set("exits", ([
    "down": "/d/wiz/wizroom",
    "kz": "/d/city/kezhan",
  ]));

  set("no_time", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("freeze", 1);
  set("valid_startroom", 1);
  setup();
  call_other("/obj/board/bowl_b", "???");
}
