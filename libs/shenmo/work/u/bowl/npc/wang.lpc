inherit NPC;
#include <obstacle.h>
#include <ansi.h>
int lhzs();

void create()
{
set_name(HIW"轮回王"NOR, ({ "lunhui wang", "wang"}));
set("title", HIC"西游记--神魔传说"NOR);   
set("long", HIW"\n掌管轮回转世的轮回王\n手哪知一个奇行的兵器，有关转世重生的事情，可以问问他。\n"NOR+HIC"\n ask wang about lhzs"NOR);
set("gender", "男性");
set("age", 1006);
set("attitude", "heroism");
set("per", 32);
set("combat_exp", 2400000);
set("daoxing", 6800000);
set("max_force", 1200000);
set("max_mana", 1200000);
set("max_ken", 1200000);
set("max_sen", 1200000);
set("mana_factor", 12000);
set("force_factor", 12000);
set("inquiry", ([
 "name" : "我就是轮回王，掌管神仙妖魔的轮回转世。\n",
"here" : "你可以选择“轮回转世”来决定你轮回。\n",
"lhzs"   : (:lhzs:),
"轮回转世"   : (:lhzs:),
]));

setup();
}

int lhzs()
{
object me,who;
string str;
	int size = sizeof(obstacles);
me=this_object();
who=this_player();
if (who->query("obstacle/number") < size)	{
		message_vision ("$N对$n摇头说道：佛曰九九归真，你还是参见如来再来吧\n",me,who);
return 1;
}

if (who->query("combat_exp")<2000000000 && who->query("daoxing")<2000000000 )
{
message_vision ("$N对$n摇头说道：这点道行和经验也想转世？\n",me,who);
return 1; 
}

str=who->name();
message("channel:chat",HIC"【西游记--神魔传说】轮回王："+str+"开始转世重生\n"NOR,users());
message("channel:rumor",HIM"【轮回谣言】轮回王："+str+"开始转世重生\n"NOR,users());
message_vision("轮回王，往$N头上轻轻一拍，对$N说：“你现在进入六道轮回，选择投胎转世去吧”\n",who);

who->set("begin_born",1);
//
//
return 1;
}
