#include <weapon.h>  
#include <ansi.h>  
#include "huan.h"  
inherit WHIP; 
inherit F_UNIQUE;
void create()  
{ 
set_name( HIY"吹柳"NOR, ({"chui liu", "whip"}));  
set_weight(8000);  
if (clonep())   set_default_object(__FILE__);  
else { 
      set("unit", "把");  
      set("long",  HIY" 独 立 扬 新 令   千 营 共 一 呼 。\n"NOR);  
      set("material", "iron"); 
      set("no_drop",  RED"\n寶物易求難得。\n\n"NOR);   
      set("no_get",  RED"\n寶物易求難得。\n\n"NOR);   
      set("no_give",  RED"\n寶物易求難得。\n\n"NOR);   
      set("no_sell",  RED"\n寶物易求難得。\n\n"NOR);   
      set("wield_msg",HIY"輕輕迎风招摆，$N顺手将它执起，指尖凝聚起精灵般的绿。\n");    
      set("unwield_msg",HIY"輕輕迎风招摆，$N顺手将它放下，指尖凝聚起精灵般的绿。\n");    
} 
init_whip(110+random(40));  
setup();  
} 
     
int init() 
{
	add_action("do_huanyuan","huanyuan");   
	return 1;
}  
       
