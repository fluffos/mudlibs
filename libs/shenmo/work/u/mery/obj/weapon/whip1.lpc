#include <weapon.h>  
#include <ansi.h>  
inherit WHIP; 
inherit F_UNIQUE;
void create()  
{ 
set_name( HIY"龙筋"NOR, ({"long jin", "whip"}));  
set_weight(8000);  
if (clonep())   set_default_object(__FILE__);  
else { 
      set("unit", "把");  
      set("long",  HIY" 千 年 修  行 丧   血  髓  共 一 体 。\n"NOR);  
      set("material", "iron"); 
      set("no_drop",  RED"\n寶物易求難得。\n\n"NOR);   
      set("no_get",  RED"\n寶物易求難得。\n\n"NOR);   
      set("no_give",  RED"\n寶物易求難得。\n\n"NOR);   
      set("no_sell",  RED"\n寶物易求難得。\n\n"NOR);   
      set("wield_msg","$n"+HIC"迎风一摆，$N顺手将它执起，指尖凝聚起隐隐的风雷。\n"NOR);    
      set("unwield_msg","$n"+HIC"迎风一摆，$N顺手将它放下，指尖凝聚起隐隐的风雷。\n"NOR);    
} 
init_whip(70+random(50));  
setup();  
} 
     
