#include <weapon.h>  
#include <ansi.h>  
inherit RAKE; 
#include "huan2.h"  

void create()  
{ 
set_name("水磨钢耙"NOR, ({"gang pa","pa","rake"}));  
set_weight(15000);  
if (clonep())   set_default_object(__FILE__);  
else { 
set("unit", "把");  
set("long","一把奇形怪状的朝天钉耙。\n");  
set("material", "iron"); 
set("wield_msg","$N抓起一把$n，嘴里哼了两声。\n"NOR);    
set("unwield_msg","$N将手里的$n放将下来。\n"NOR);    
set("value",20000);   
      } 
init_rake(70+random(30));  
setup();  
 } 
