#include <weapon.h>  
#include <ansi.h>  
#include "huan.h"  
inherit STICK; 
inherit F_UNIQUE;
void create()  
{ 
set_name(BMAG+HIC"重生"NOR, ({"chong sheng", "stick","gun"}));  
set_weight(15000);  
if (clonep())   set_default_object(__FILE__);  
else { 
	set("unit", "把");  
	set("long",  HIY"鹫  翎  金  仆  姑    燕  尾  绣  蝥  弧  。\n"NOR);  
	set("material", "iron"); 
	set("wield_msg",BYEL+HIY"$N微微一笑將手里$n"+BYEL+HIY"輕輕一擺，萬屻般的氣勢隨之而起。\n"NOR);    
	set("unwield_msg",BYEL+HIY"$N將手里$n"+BYEL+HIY"抖出九朵棍花，顺手放在背后。\n"NOR);    
	set("no_drop",  RED"\n寶物易求難得。\n\n"NOR);   
	set("no_get",  RED"\n寶物易求難得。\n\n"NOR);   
	set("no_give",  RED"\n寶物易求難得。\n\n"NOR);   
	set("no_sell",  RED"\n寶物易求難得。\n\n"NOR);   
	} 
init_stick(random(40)+110);  
setup();  
} 
int init()
{
add_action("do_huanyuan","huanyuan");   
return 1; 
}  

       
