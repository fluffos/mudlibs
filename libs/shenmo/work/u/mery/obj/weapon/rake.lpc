#include <weapon.h>  
#include <ansi.h>  
#include "huan.h"  

inherit F_UNIQUE;
inherit RAKE; 

void create()  
{ 
set_name( HIM"幻手"NOR, ({"huan shou", "rake"}));  
set_weight(15000);  
if (clonep())   set_default_object(__FILE__);  
else { 
set("unit", "把");  
set("long",  HIY"一把奇形怪状的朝天钉耙。\n"NOR);  
set("material", "iron"); 
set("wield_msg",HIM"$N嘴里哼哼哑哑，反手抓起一把$n"HIM"擎在手中。\n"NOR);    
set("unwield_msg",HIM"$N将手里的$n"+HIM"背到背后,口中哼了几哼。\n"NOR);    
set("no_drop",  RED"\n寶物易求難得。\n\n"NOR);   
set("no_get",  RED"\n寶物易求難得。\n\n"NOR);   
set("no_give",  RED"\n寶物易求難得。\n\n"NOR);   
set("no_sell",  RED"\n寶物易求難得。\n\n"NOR);   
set("no_put",  RED"\n寶物易求難得。\n\n"NOR);   
      } 
init_rake(110+random(40));  
setup();  
 } 
       
int init() 
{    
add_action("do_huanyuan","huanyuan");    
return 1;    
} 
       
