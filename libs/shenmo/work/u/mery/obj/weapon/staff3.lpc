#include <weapon.h>  
#include <ansi.h>  
inherit STAFF; 
#include "huan2.h"  

void create()  
{ 
set_name("水磨禅杖", ({"chan zhang", "staff","zhang"}));  
set_weight(15000);  
if (clonep())   set_default_object(__FILE__);  
else { 
	set("unit", "把");  
	set("long","纯钢打制的禅杖，月牙头，缺月柄。\n"NOR);  
	set("material", "iron"); 
	set("wield_msg","$N口诵佛号，将$n"+HIW"提将在手。\n"NOR);    
       set("unwield_msg","$N低誦佛號“南無佛”將手中的$n放下。\n"NOR);    
	set("value",20000);   
	} 
init_staff(70+random(30));  
setup();  
} 
