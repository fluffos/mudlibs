//Snowtu@Xmxyj2000/2003/10

#include <ansi.h>  
#include <combat.h>  
inherit ITEM; 
 
void init();  
void create() 
{ 
set_name("十三块金属"NOR, ({"jinshu","jin","shu"}));  
if( clonep() )  set_default_object(__FILE__);  
else {  
     set_weight(5000);  
     set("long",WHT"
神匠欧冶子当年参透百家武器奥妙所打造的神兵，用十三块奇形怪状\n
的玄金属连缀而成。你仔细看看它，发现里面另有玄机：你可以将它\n
驳(huan)成\n\n
刀(blade)剑(sword)锤(hammer)斧(axe)鞭(whip)锏(mace)\n
枪(spear)叉(fork)棍(stick)杖(staff)拳套(hand)钉耙(rake)。\n
也可以变换回(huanyuan)。\n\n"NOR);
     set("unit", "塊"); 
     set("value", 100000);  
     set("material", "steel"); 
      } 
setup();  
 } 
       
void init()  
{ 
add_action("do_huan","huan");   
} 

int do_huan(string arg)  
{ 
string str;
object ob = this_object();  
object me = environment(ob);  
object wuqi; 
if ( !present(ob,me) || !(arg) )  return notify_fail("什么？\n");
switch ( arg )
        {
        case "sword":  wuqi=new(__DIR__"sword3");
        break;
       
        case "hammer": wuqi=new(__DIR__"hammer3");
        break;

        case "stick" : wuqi=new(__DIR__"stick3");
        break;

        case "staff" : wuqi=new(__DIR__"staff3");
        break;
       
        case "mace" : wuqi=new(__DIR__"mace3");
        break;
       
        case "axe" :  wuqi=new(__DIR__"axe3");
        break;
       
        case "spear" : wuqi=new(__DIR__"spear3");
        break;
       
        case "shi" : wuqi=new(__DIR__"wuxian3");
        break;
        
        case "whip" : wuqi=new(__DIR__"whip3");
        break;
       
        case "blade" : wuqi=new(__DIR__"blade3");
        break;
       
        case "fork" : wuqi=new(__DIR__"fork3");
        break;

        case "hand" : wuqi=new(__DIR__"hand3");
        break;

        case "rake" : wuqi=new(__DIR__"rake3"); 
        break;

        default : return notify_fail("你想要的超出我的想象。。。\n");
        break;
        }
wuqi->move(me);

str = "$N小心翼翼的将$n飞快的拆卸为$m。\n";
str = replace_string(str,"$n",ob->name());
str = replace_string(str,"$m",wuqi->name());
message_vision(str, me);  
destruct(ob);  
return 1;
} 

