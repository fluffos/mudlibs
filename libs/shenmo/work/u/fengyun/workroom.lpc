inherit ROOM;
#include <ansi.h>
//int do_edit(string arg);

void create() {

  set("short", HIY "亚特兰蒂斯" NOR);
  set("long",
    HIB "传说中给洪水淹没的城市亚特兰蒂斯" NOR
    HIG "宏伟的建筑群，显示者这儿曾经的繁荣\n" NOR
  );
  set("exits", ([
    "kz": "/d/city/kezhan",
    "wz": "/d/wiz/wizroom",
    "lw": "/d/jjg/gate",
    "gg": "/d/wiz/newroom",
    "cs": "/d/pinganbingyin",
  ]));
  set("objects", ([
    //  "/u/wuxin/npc/giftman.lpc" : 1,
    "/u/wuxin/binger.lpc": 1,
  ]));
  set("no_time", 1);
  set("freeze", 1);
  set("no_upgrade_age", 1);
  set("alternative_die", 1);
  setup();
  call_other("/obj/board/fang_b", "???");

}

void init() {
  add_action("do_cloth", "cs");
  add_action("do_del", "del");
  add_action("do_edit", "xiugai");
  add_action("do_editt", "xiu");
  add_action("do_teditt", "txiu");
}

int do_edit(string arg) {
  object who, me;
  string data;
  int num;

  me = this_player();

  if (!wizardp(me) || me->query("id") != "fang")
    return 0;
  if (!arg || sscanf(arg, "%s %s %d", arg, data, num) != 3)
    return 0;
  who = find_player(arg);
  if (!who || !objectp(who))
    return 0;
  who->set(data, num);
  write("ok\n");
  return 1;
}


int do_cloth() {
  object who, me;
  me = this_player();
  if (!wizardp(me) || me->query("id") != "fang") return 0;
  who = new("/u/fang/obj/cluth");
  who->move(me);
  write("ok\n");
  return 1;
}

int do_del(string arg) {
  object who, me;
  string data;
  int num;

  me = this_player();

  if (!wizardp(me) || me->query("id") != "fang")
    return 0;
  if (!arg || sscanf(arg, "%s %s %d", arg, data, num) != 3)
    return 0;
  who = find_player(arg);
  if (!who || !living(who))
    return 0;
  who->delete_temp(data);
  who->delete(data, num);
  write("ok\n");
  return 1;
}

int do_editt(string arg) {
  object who, me;
  string data, dd;
  int num;

  me = this_player();

  if (!wizardp(me) || me->query("id") != "fang")
    return 0;
  if (!arg || sscanf(arg, "%s %s %s", arg, data, dd) != 3)
    return 0;
  who = find_player(arg);
  if (!who || !objectp(who))
    return 0;
  who->set(data, dd);
  write("ok\n");
  return 1;
}

int do_teditt(string arg) {
  object who, me;
  string data, dd;
  int num;

  me = this_player();

  if (!wizardp(me) || me->query("id") != "fang")
    return 0;
  if (!arg || sscanf(arg, "%s %s %d", arg, data, num) != 3)
    return 0;
  who = find_player(arg);
  if (!who || !objectp(who))
    return 0;
  who->set_temp(data, num);
  write("ok\n");
  return 1;
}
