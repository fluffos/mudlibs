inherit NPC;
#include <ansi.h>
int give_gift();
mixed give_po();
void create() {
  set_name(HIC "元宵节使者" NOR, ({ "yuanxiao", "shizhe" }));
  set("age", 8 + random(10));
  set("gender", "男性");
  set("title", HIR "元宵礼物大使" NOR);
  set("long", HIM "\n\n这位就是鼎鼎大名的元宵使者了。\n" NOR);
  set("attitude", "peaceful");
  set("str", 50);
  set("kar", 50);
  set("per", 99);
  set("combat_exp", 200000000);
  set("daoxing", 200000000);
  set("max_force", 200000);
  set("max_mana", 200000);
  set("max_kee", 40000);
  set("max_sen", 40000);
  set("force", 400000);
  set("force_factor", 1000);
  set("mana_factor", 1000);
  set("mana", 400000);
  set_skill("unarmed", 1000);
  set_skill("dodge", 1000);
  set_skill("parry", 1000);
  set("inquiry", ([
    "元宵节": (: give_gift :),
    "神兵礼物": (: give_po :),
  ]));
  setup();
}

mixed give_po() {
  int i;
  mapping type, po;
  string str, *types, *my_type, gift;
  object me = this_player();

  if (me->query("giftmark/2018yxqm_po_gift"))
    return "你已经要过了。";
  if (!me->query("weapon/make"))
    return "你都无趁手的家伙，要来何用？！";

  if (!mapp(type = me->query("weapon/type"))
    || sizeof(type) < 1)
    return "你的兵器好似有些问题，找找巫师。";

  if (!arrayp(my_type = keys(type))
    || sizeof(my_type) < 1)
    return "你的兵器好似有些问题，找找巫师。";

  po = ([
    "archery": "弓",
    "axe": "斧",
    "blade": "刀",
    "fork": "叉",
    "halberd": "戟",
    "hammer": "锤",
    "unarmed": "拳",
    "mace": "锏",
    "needle": "针",
    "qin": "琴",
    "rake": "耙",
    "spear": "枪",
    "staff": "杖",
    "stick": "棍",
    "sword": "剑",
    "throwing": "暗",
    "whip": "鞭",
  ]);

  //enable ?结果，酌情删减 
  types = ({
    "axe", "blade", "fork", "sword",
    "hammer", "unarmed", "mace", "needle",
    "rake", "spear", "staff", "stick",
    "whip",
  });

  //减去自己已有的
  for (i = 0; i < sizeof(my_type); i++)
    types -= ({ my_type[i], });
  types -= ({ 0 });
  if (sizeof(types) < 1)
    return "你好似都全了。";

  if (!stringp(gift = types[random(sizeof(types))]))
    return "你好似都全了吧。";
  me->set("weapon/type/" + gift, 1);
  me->set("giftmark/2018。qm_po_gift", 1);
  str = sprintf(HIY "神兵(Shen bing)：%s" NOR HIY "诚心见鉴日月，终于得到了" HIR "%s魄" HIY "！\n" NOR,
    me->query("name"),
    po[gift]);
  message("channel:chat", HIY "【神兵传说】" + str, users());
  tell_object(me, HIG "你得到了" HIR + po[gift] + "魄" HIG "。" NOR "\n");
  return 1;
}

int give_gift() {
  object me;
  string str;
  int exp, wxreward, dxreward, qnreward;
  me = this_player();
  exp = me->query("combat_exp") + me->query("daoxing");
  if (!me) return 0;
  if (me->query("cloud/元宵节") == "2018") {
    message_vision("\n元宵使者疑惑的看着你道：你不是又想来混一份礼物吧？\n\n" NOR, me);
    this_object()->command("hammer " + me->query("id"));
    return 1;
  }
  if (me->query("combat_exp") <= 100000) {
    write("你的修行太低了，还是先去锻炼一下再来吧!\n");
    return 1;
  }
  me->set("cloud/元宵节", "2018");
  if (me->query("combat_exp") <= 1000000) {
    qnreward = 50000;
    wxreward = 100000;
    dxreward = 100000;
  } else if (me->query("combat_exp") <= 5000000) {
    qnreward = 100000;
    wxreward = 150000;
    dxreward = 150000;
  } else if (me->query("combat_exp") <= 10000000) {
    qnreward = 100000;
    wxreward = 200000;
    dxreward = 200000;
  } else if (me->query("combat_exp") <= 30000000) {
    qnreward = 150000;
    wxreward = 250000;
    dxreward = 250000;
    call_out("gift", 2);
  } else if (me->query("combat_exp") <= 200000000) {
    qnreward = 200000;
    wxreward = 300000;
    dxreward = 300000;
    call_out("gift", 2);
  } else {
    qnreward = 250000;
    wxreward = 300000;
    dxreward = 300000;
    call_out("endgift", 3);
  }
  message_vision("\n元宵使者拱手贺道：\n"
    +HIY + "兔崽子们，\n" + HIR + "元宵节快乐，\n" + HIB + "很快乐，\n" + HIM + "非常快乐。\n" + HIW + "元宵节快乐！\n" NOR, me);
  write(HIY "在2018年元宵节到来之际，你得到巫师组的祝福。\n" NOR);
  str = HIW + me->name() + HIM + "得到了元宵节礼物，送上我们的祝福：" + HIY + "节日快乐，明年更比今年好！" NOR;
  message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());
  me->add("combat_exp", wxreward);
  me->add("daoxing", dxreward);
  me->add("potential", qnreward);
  me->add("level", 1);
  write(HIC "你突然感觉自己的等级又有所提升了!\n" NOR);
  return 1;
}

void gift() {
  object me = this_player();
  object baoshi, bone, weapon;
  //baoshi=new("/obj/baoshi");
  //  weapon=new("/obj/weapon");
  bone = new("/quest/lianhua/hebing_1");
  bone->set_amount(3);
  baoshi->setname2(2, random(7));
  baoshi->move(me);
  bone->move(me);
  //  weapon->move(me);
  tell_object(me, HIR "你得到了自制武器等级加一的奖励!\n" NOR);
  me->add("xtqj/haomao", 3);
  me->add("weapon/lv", 1);
  me->add_temp("bonustime", 400);
  me->add_temp("bonus", 50);
  tell_object(me, HIR "恭喜你得到了游戏经验增加50%的额外奖励!\n" NOR);
  write(HIC + "\n你有幸得到了巫师组赐予的三根" + HIY + BLINK + "救命毫毛" + NOR + HIC + "。\n\n" NOR);
}

void endgift() {
  object me = this_player();
  object baoshi, bone, weapon;
  //baoshi=new("/obj/baoshi");
  // weapon=new("/obj/weapon");
  bone = new("/quest/lianhua/hebing_2");
  bone->set_amount(3);
  baoshi->setname2(3, random(6));
  baoshi->move(me);
  bone->move(me);
  // weapon->move(me);
  tell_object(me, HIR "你得到了自制武器等级加一的奖励!\n" NOR);
  me->add("xtqj/haomao", 3);
  me->add("weapon/lv", 1);
  me->add_temp("bonustime", 400);
  me->add_temp("bonus", 60);
  tell_object(me, HIR "恭喜你得到了游戏经验增加60%的额外奖励!\n" NOR);
  write(HIC + "\n你有幸得到巫师组赐予的三根" + HIY + BLINK + "救命毫毛" + NOR + HIC + "。\n\n" NOR);
}
