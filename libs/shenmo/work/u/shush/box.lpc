inherit ITEM;
#include <ansi.h>

string *attrib = ({ "str", "cor", "int", "spi", "cps", "per", "con", "kar", });
void create() {

  set_name(HIR "天庭宝箱" NOR, ({ "baoxiang", "box" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long",
      "这是一个" HIR "天庭宝箱" NOR "，听说是王母娘娘的宝贝，
你是否要打开(open)来看看。\n");
    set("value", 0);
    set_weight(10);
    set("no_drop", 1);
    set("no_give", 1);
    set("no_steal", 1);
  }
  setup();
}

void init() {
  add_action("do_open", "open");
  call_out("destruct_me", 3600);

}

int do_open(string arg) {
  int maxpot;
  object me = this_player();
  if ((me->query("zhuanshi") < 1) && (me->query("combat_exp") <= 20000000 || me->query("age") < 16 || me->query("daoxing") < 20000000)) {
    maxpot = 200000;
  } else maxpot = 500000;

  if (arg != "box")
    return notify_fail("你打开什么?\n");

  if (me->query("wuxin/gift") == 20170528)
    return notify_fail("不要这么贪心好不好？小心王母娘娘找你算账！\n");

  write(HIY "你打开了" HIR "天庭宝箱" HIY "。。。。。。\n
" HIG "爽～～爽～～爽!\n" NOR "你得到了" + maxpot + "分配点数，你想将它分配在：\n
" HIG "１.潜能。\n" HIY "２.经验。\n" HIW "３.道行。\n" NOR "你的选择是："
    NOR);
  input_to("decide", me);
  return 1;
}

void decide(string arg, object me) {
  int addxyb, maxpot, mao, i;
  if ((me->query("zhuanshi") < 1) && (me->query("combat_exp") <= 20000000 || me->query("age") < 16 || me->query("daoxing") < 20000000)) {
    maxpot = 200000;
    mao = 1;
    addxyb = 0;
  } else {
    maxpot = 500000;
    mao = 1 + random(2);
    addxyb = 1 + random(2);
  }
  if (me->query("wuxin/gift") == 20160101) {
    write("不要这么贪心好不好？小心王母娘娘找你算账！\n");
    return;
  }

  if ((int)me->query_temp("gift_1") + (int)me->query_temp("gift_2") + (int)me->query_temp("gift_3") > maxpot) {
    write("你也太贪心了，当心宝箱飞了~~~\n");
    me->delete_temp("gift_1");
    me->delete_temp("gift_2");
    me->delete_temp("gift_3");
    me->delete_temp("other_pot");
    me->delete_temp("gift_type");
    return;
  }
  if (arg == "1") {
    write(HIY "\n你要将多少点分配给潜能？" NOR);
    input_to("decide_pot", me);
    me->set_temp("gift_type", "潜能");
    return;
  } else if (arg == "2") {
    write(HIY "\n你要将多少点分配给经验？" NOR);
    input_to("decide_pot", me);
    me->set_temp("gift_type", "经验");
    return;
  } else if (arg == "3") {
    write(HIY "\n你要将多少点分配给道行？" NOR);
    input_to("decide_pot", me);
    me->set_temp("gift_type", "道行");
    return;
  } else if (arg == "q") {
    me->delete_temp("gift_1");
    me->delete_temp("gift_2");
    me->delete_temp("gift_3");
    me->delete_temp("other_pot");
    me->delete_temp("gift_type");
    return;
  } else if (arg == "decide") {
    if (me->query_temp("other_pot") > 0) {
      write("\n你还没分配完呢，请选择：");
      input_to("decide", me);
      return;
    }
    if (me->query_temp("gift_1")) {
      write(HIG "\n你得到了" + me->query_temp("gift_1") + "点潜能。\n");
      me->add("potential", me->query_temp("gift_1"));
    }
    if (me->query_temp("gift_2")) {
      write(HIG "你得到了" + me->query_temp("gift_2") + "点经验。\n");
      me->add("combat_exp", me->query_temp("gift_2"));
    }
    if (me->query_temp("gift_3")) {
      write(HIG "你得到了" + me->query_temp("gift_3") + "点道行。\n");
      me->add("daoxing", me->query_temp("gift_3"));
    }
    me->delete_temp("gift_1");
    me->delete_temp("gift_2");
    me->delete_temp("gift_3");
    me->delete_temp("other_pot");
    me->delete_temp("gift_type");
    me->set("wuxin/gift", 20160101);
    me->add("haomao", mao);
    i = random(sizeof(attrib));
    me->add(attrib[i], 1);
    tell_object(me, HIG "你的" + HIY + attrib[i] + HIG + "增加一点\n" NOR);
    write(HIG "你增加了" + mao + "根毫毛。\n");
    me->add("c_balance", addxyb);
    write(HIG "你得到了" + addxyb + "两黄金。\n");
    message(
      "channel:chat",
      HIW + "【神魔传说】王母娘娘：" + me->query("name") + "祝贺大家" + HIR + "游戏快乐" + HIW + "，特赐天庭宝箱！\n" + NOR,
      users()
    );
    message(
      "channel:rumor",
      HIM + "【谣言】某人：听说" + me->query("name") + "小心翼翼的打开了" + HIR + "天庭宝箱！\n" + NOR,
      users()
    );
    log_file("static/gift", "[" + ctime(time()) + "] " + sprintf("%s(%s)【" + query_ip_number(me) + "】 打开了一个天庭宝箱！\n",
      me->query("name"), me->query("id")));
    me->save();
    destruct(this_object());
  } else {
    write("\n请重新选择:(q退出)");
    input_to("decide", me);
  }
}
void decide_pot(string arg, object me) {
  int pot, t, p, maxpot;
  string str;
  if ((me->query("zhuanshi") < 1) && (me->query("combat_exp") <= 20000000 || me->query("age") < 16 || me->query("daoxing") < 20000000)) {
    maxpot = 200000;
  } else maxpot = 500000;
  sscanf(arg, "%d", pot);
  if (!pot) {
    write("\n请重新选择：");
    input_to("decide", me);
    return;
  }
  if (pot < 0) {
    write("\n你输入有问题，数值不能小于0。\n请重新选择：");
    input_to("decide", me);
    return;
  }
  if (pot > maxpot) {
    write("\n你的点数不够分配。\n请重新选择：");
    input_to("decide", me);
    return;
  }
  if (me->query_temp("other_pot")) {
    t = me->query_temp("other_pot");
    if (pot > t) {
      write("\n你的点数不够分配。\n请重新选择：");
      input_to("decide", me);
      return;
    }
  }
  str = me->query_temp("gift_type");
  if (str == "潜能") me->add_temp("gift_1", pot);
  if (str == "经验") me->add_temp("gift_2", pot);
  if (str == "道行") me->add_temp("gift_3", pot);
  p = maxpot - me->query_temp("gift_3");
  p -= me->query_temp("gift_2");
  p -= me->query_temp("gift_1");
  me->set_temp("other_pot", p);
  write("你决定将" + pot + "点分配在" + str + "上，你还剩" + p + "点可以分配。\n请确定你的选择:(decide确定)");
  input_to("decide", me);
  return;
}

void destruct_me() {
  write(HIR + name() + HIG "化作一道耀眼的火光冲天而去！\n\n" NOR);
  this_object()->move("/obj/empty");
  destruct(this_object());
}
