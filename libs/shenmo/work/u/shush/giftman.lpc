#include <ansi.h>
#include <combat.h>
inherit NPC;
string ask_gift();
string ask_mooncake();
void create()
{   
	int i,k,m,n;  
	string name,*id;   

        set_name(HIY"2017国庆节中秋节"HIR"礼物大使"NOR,({"gift dashi", "dashi"})); 
       set("title", HIC+"神魔传说"+NOR);  
        set("long", HIC"这是用来发送礼物的NPC,他给大家送来了大礼包,还有月饼！\n"NOR);   
	set("gender",((random(2)==1)?"男性":"女性"));   
	set("max_sen",6000);   
	set("eff_sen",6000);   
	set("per",50);
	set("sen",6000);   
	set("max_kee",6000);   
	set("eff_kee",6000);   
	set("kee",4000);   
	set("combat_exp", random(300000));   
        set("bellicosity", 200+random(300));   
	set("daoxing",random(3000000));   
    set("inquiry", ([
                "国庆节"        :       (:ask_gift:),
                "中秋节"        :       (:ask_mooncake:),
				]));
	setup( ); 
	set_skill("unarmed", 200);   
	set_skill("dodge", 200);   
	set_skill("staff", 200);   
	set_skill("parry", 200);   
	set_skill("force", 200);  
	set_skill("lotusforce", 200);  
	set_skill("jienan-zhi", 200);  
	set_skill("lotusmove", 200);  
	set_skill("lunhui-zhang", 200);  
	set_skill("buddhism", 200);  
	map_skill("unarmed","jienan-zhi");   
	map_skill("dodge","lotusmove");   
	map_skill("staff","lunhui-zhang");   
	map_skill("parry","lunhui-zhang");   
	map_skill("force","lotusforce");   
	map_skill("spells","buddhism");   
	carry_object("/d/obj/weapon/sword/changjian")->wield();
} 
       
void init() 
{   
	remove_killer(this_player());   
	remove_enemy(this_player()); 
	::init();   
} 
       
       
int do_none() 
{  
	object ob = this_object();   
	object me = this_player();   
	message_vision("\n$N对着$n摇了摇头。\n\n",ob,me);   
	return 1;   
} 
     
string ask_gift()
{
	object ob;
	object me = this_player();
    if( me->query_temp("no_heal_up/bian") ) return "变身来要礼物？利用bug，会被切掉jj 的！\n";
        if( me->query("level")<100 ) return "你的level等级太低，过百后再来要吧\n";
        if( me->query("2017_guoqing") ) return "礼物只能有一份!\n";
        if (!userp(me)) return "什么小猫小狗也来要礼物？\n";
	me->add("combat_exp",688888);
	me->add("potential",68888);
        me->add("balance",6880000);
        me->add("daoxing",688888);
	me->set("2017_guoqing",1);
message_vision("$N对着$n神秘的笑了笑，$n觉得身体发生剧烈的变化，顿时晕倒在地。\n",this_object(),this_player());
     message_vision("$N口中念到：噼里啪啦砰！\n 
               你的武学增加了688888。\n 
               你的道行增加了六百八十八年!\n 
               你的潜能增加了68888。\n 
               你现在存款增加了688gold。\n",this_object());
    switch(random(8)) {
       case 0 : ob = new("/u/shush/obj/drug/shenliwan.lpc"); break;
       case 1 : ob = new("/u/shush/obj/drug/xiandan.lpc"); break;
       case 2 : ob = new("/u/shush/obj/drug/cordan.lpc"); break;
       case 3 : ob = new("/u/shush/obj/drug/cpsdan.lpc"); break;
       case 4 : ob = new("/u/shush/obj/drug/kardan.lpc"); break;
       case 5 : ob = new("/u/shush/obj/drug/perdan.lpc"); break;
       case 6 : ob = new("/u/shush/obj/drug/spidan.lpc"); break;
       case 7 : ob = new("/u/shush/obj/drug/xisuidan.lpc"); break;
     }
     ob->set("owner",me);
     ob->save();
	ob->move(me); 

           message_vision("你得到了一颗属性丹,一根毫毛和一颗加倍丹。\n",this_object(),this_player());

       ob = new("/u/shush/obj/drug/haomao.lpc");
     ob->set("owner",me);
     ob->save();
      ob->move(me); 
       ob = new("/u/shush/obj/drug/tp.lpc");
     ob->set("owner",me);
     ob->save();
      ob->move(me); 
           message("chat",HIY+"【庆国庆】"+HIC+": "+NOR+HIC+me->query("name")+HIC+"获得了2017国庆节大礼包一份!\n"NOR,users());
      return "感谢你对西游记--神魔传说的支持,国庆快乐!\n";
}
string ask_mooncake()
{
            object me;
            object obj;
	    me = this_player();
    if( me->query_temp("no_heal_up/bian") ) return "变身来要礼物？利用bug，会被切掉jj 的！\n";
            if (me->query("level") < 100 ) 
                return "你还是去历练历练再来领礼物吧！\n";
            if (me->query("2017_zhongqiu") > 2 )
                return "领月饼的人太多了，已经分完了！\n";
           obj = new("u/shush/obj/drug/mooncake.lpc");
        obj->set("owner",me);
           obj->save();
           obj->move(me);
           me->add("2017_zhongqiu",1);
           return "送给你一块中秋节月饼，祝您中秋节快乐！\n";
}
