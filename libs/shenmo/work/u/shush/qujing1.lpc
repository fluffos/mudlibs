#include <ansi.h>
inherit ITEM;
#include <obstacle.h>

int do_eat(string);
void create() {
  set_name(HIC "取经过关丹" NOR, ({ "qujing dan", "dan" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIC "碧油油的一颗丹药,吃了就可以过取经一关。吃之前需要决定(decide)哪一关。\n" NOR);
    set("value_c", 1);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("no_steal", 1);
    set("no_put", 1);
  }

  setup();
}

void init() {
  add_action("do_eat", "eat");
  add_action("do_decide", "decide");
}

int do_decide(string arg) {

  object ob = this_object();
  object me = environment(ob);
  string *names = keys(obstacles);

  if (me->is_busy())
    return notify_fail("( 你现在正忙着呢。)\n");


  if (!present(this_object(), me)) return 0;

  if (!arg || !(member_array(arg, names) != -1))
    return notify_fail("具体的格式是:\n
\t decide <关卡>\n 关卡有：\n 1: jz  2: sc  3: yj  4: hf  5: yz  6: huangfeng  7: liusha 8: village 9: wuzhuang  10: sanda \n
11: baoxiang  12: pingding 13: wuji 14: huoyun  15: chechi 16: tongtian 17: jindou   18: nuerguo  \n
19: dudi   20: firemount 21: jilei  22: jisaiguo 23: jingjiling  24: xiaoxitian 25: zhuzi  26: pansi \n
27: biqiu  28: wudidong  29: qinfa 30: yinwu   31: fengxian   32: yuhua  33: jinping   34: tianzhu \n ");

  if (query("decide"))
    return notify_fail("已经决定过了。\n");

  message_vision("$N对着$n虔诚的喃喃自语。\n", me, ob);
  ob->set("decide", 1);
  ob->set("guanqia", arg);
  ob->save();
  tell_object(me, "好了，决定了，可以吃了....\n");
  return 1;
}


int do_eat(string arg) {
  object me = this_player();
  if (!arg)
    return notify_fail("你要吃什么？\n");
  if (!query("decide"))
    return notify_fail("先决定一下吧(decide)。\n");
  if (!present(this_object(), me))
    return notify_fail("你要吃的东西不在你身上啊！\n");

  message_vision("$N将$n拿在手中，一口吞了下去。\n", me, this_object());

  me->set("obstacle/" + this_object()->query("guanqia"), "done");
  me->add("obstacle/number", 1);
  message_vision(HIC "$N吃下一颗取经过关丹，如来佛祖让你通过了" + this_object()->query("guanqia") + "这一关。\n" NOR, me);

  destruct(this_object());
  return 1;
}
