void create() 
     { 
        set_name("礼物大神", ({"giftman", "da shen", "shen"}));
        set("title", HIC+"乐善好施"+NOR);
        set("gender", "男性");
        set("age", 42);
        set("long", HIC"听无心说，这位大神只有在重要的日子才会降临人间，为人们带来祝福。\n"NOR);
        set("shen_type", 1); 
        set("str", 30);
        set("con", 30);
        set("spi", 30);
        set("combat_exp", 200000);
        set("daoxing",200000);
        set_skill("force", 5000);
        set_skill("unarmed", 5000);
        set_skill("dodge", 5000);
        set_skill("parry", 5000);
        set("force", 20000);
        set("max_force", 20000);
        set("force_factor", 5);
        setup();
        remove_call_out("give_gift");
        call_out("give_gift",5);
        carry_object("/d/obj/cloth/skirt")->wear();
        carry_object("/d/obj/cloth/shoes")->wear();
}

void give_gift() 
{ 
             int i, j ,k,ppl,rd; 
             object *list,newob; 
             string str,m_name; 
             string smp; 
             j = random(sizeof(dirs)); 
             newob = new("u/shush/obj/newyeargift.c");
             i = random(sizeof(color));  
             str = color[i];  
       CHANNEL_D->do_channel( this_object(), "sys", "红包掉到了"+dirname[j]+"了。\n"); 
               if (random_place(dirs[j],newob)==1)
             remove_call_out("give_gift");
               call_out("give_gift",300);
 } 
int random_place(string dirss, object bs)
{
        int  j, k;
        object  newob,ob;
        mixed*  file, exit;
        string id_name; 

        if( !sizeof(dirs) )  return 0;
        j = random(sizeof(dirs));
        file = get_dir( dirss+"/*.c", -1 );
        if( !sizeof(file) )             return 0;

        for(k=0;k<30;k++) { // try 30 times
           j = random(sizeof(file));
           if( file[j][1] > 0 ) {
             newob=load_object(dirss+"/"+file[j][0]);
             id_name = newob->query("short");
             if (!newob) continue;
             if(bs->move(newob)) { 
               message("channel:chat",HIG"【"+HIR"元旦快乐"+HIG"】"+HIW"元旦大礼包掉到了"+id_name+"。\n"+NOR,users());
             return 1; 
               }
           }
        }

        return 0;
}


