#include <ansi.h> 
inherit NPC;
int ask_gift(); 
int stop_gift();
object qu= this_object();
string *color = ({ HIR"红"NOR, HIY"橙"NOR, YEL"黄"NOR, HIG"绿"NOR, HIB"蓝"NOR, MAG"紫"NOR, HIY"金"NOR, });


void create() 
     { 
        set_name("礼物大神", ({"giftman", "da shen", "shen"}));
        set("title", HIC+"乐善好施"+NOR);
        set("gender", "男性");
        set("age", 42);
          set("long", HIC"这位大神只有在重要的日子才会降临人间，为人们带来祝福。\n"NOR);
        set("shen_type", 1); 
        set("str", 30);
        set("con", 30);
        set("spi", 30);
        set("combat_exp", 200000);
        set("daoxing",200000);
        set_skill("force", 5000);
        set_skill("unarmed", 5000);
        set_skill("dodge", 5000);
        set_skill("parry", 5000);
        set("force", 20000);
        set("max_force", 20000);
        set("force_factor", 5);
        set("inquiry", ([
        "gift":   (: ask_gift :),  
          ]));
        setup();
        remove_call_out("give_gift");
        call_out("give_gift",5);
        carry_object("/d/obj/cloth/skirt")->wear();
        carry_object("/d/obj/cloth/shoes")->wear();
}

void give_gift() 
{ 
        object player, gift;
        object *players;
        remove_call_out("give_gift");
        if( !environment() )
                return;
        players = users();
        player = players[random(sizeof(players))];
        gift = new("u/shush/obj/drug/shengji.lpc");
        if(gift->move(player))
      message("channel:chat",HIG"【"+HIR"元旦快乐"+HIG"】"+HIW"幸运之神降临，"+player->query("name")+HIW"得到了天神送来的"+gift->query("name")+HIW"!\n"+NOR,users());
         call_out("give_gift",900); 
} 
