inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int long();
string leave();
void create() {
  set_name(HIM "狗年大吉" NOR, ({ "dog" }));
  set("long",
    "它是一条具有很大法力的小狗,它可以实现你的愿望(wish)。\n");
  set("title", HIR "新春快乐" NOR);
  set("gender", "男性");
  set("age", 1000);
  set("class", "yaomo");
  set("attitude", "friendly");
  set("rank_info/respect", "狗大神");
  set("per", 40);
  set("int", 40);
  set("max_kee", 30000);
  set("max_sen", 30000);
  set("force", 30000);
  set("max_force", 30000);
  set("force_factor", 3000);
  set("max_mana", 30000);
  set("mana", 30000);
  set("mana_factor", 3000);
  set("combat_exp", 100000000);
  set("daoxing", 100000000);
  set("eff_dx", 10000);
  set("nkgain", 10000);
  set_skill("literate", 1000);
  set_skill("unarmed", 1000);
  set_skill("dodge", 1000);
  set_skill("force", 1000);
  set_skill("parry", 1000);
  setup();
  //      add_money("zuanshi", 5+random(50));
}

void init() {
  add_action("do_wish", "wish");
}
int do_wish(string arg) {
  object me = this_player();
  object who = this_object();
  string *ans = ({ "属性", "武学", "复活" });
  int ans1;
  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (arg == "0" || arg == "1" || arg == "2") {
    sscanf(arg, "%d", ans1); arg = ans[ans1];
  }
  if (!arg || (arg != "属性" && arg != "武学" && arg != "复活"))
    return notify_fail(CYN "狗年大吉说道：对不住，我只能听懂三句你们这里的泥语:1.wish 属性,2.wish 武学,3.wish 复活。你告诉我你想要什么,我会帮你实现!\n" NOR);
  if (arg == "属性" && !(me->query("giftmark/newyear1"))) {
    int i;
    i = 1 + random(3);
    message_vision(HIG "$N闭上眼睛想了一下说道：我要" + arg + "吧!\n", me);
    message_vision("$N对着$n说道:" + HIW "好吧,我马上帮你实现愿望.\n", this_object(), me);
    switch (random(8)) {
      case 0:
        message_vision(HIC "一团雾气笼罩住$N!\n" NOR, me);
        me->add("per", i);
        tell_object(me, HIC "你的容貌增加了" + i + HIC "点。\n" NOR);
        break;
      case 1:
        message_vision(HIC "一团雾气笼罩住$N!\n" NOR, me);
        me->add("kar", i);
        tell_object(me, HIC "你的福缘增加了" + i + HIC "点。\n" NOR);
        break;
      case 2:
        message_vision(HIC "一团雾气笼罩住$N!\n" NOR, me);
        me->add("str", i);
        tell_object(me, HIC "你的臂力增加了" + i + HIC "点。\n" NOR);
        break;
      case 3:
        message_vision(HIC "一团雾气笼罩住$N!\n" NOR, me);
        me->add("cor", i);
        tell_object(me, HIC "你的胆识增加了" + i + HIC "点。\n" NOR);
        break;
      case 4:
        message_vision(HIC "一团雾气笼罩住$N!\n" NOR, me);
        me->add("cps", i);
        tell_object(me, HIC "你的定力增加了" + i + HIC "点。\n" NOR);
        break;
      case 5:
        message_vision(HIC "一团雾气笼罩住$N!\n" NOR, me);
        me->add("int", i);
        tell_object(me, HIC "你的智力增加了" + i + HIC "点。\n" NOR);
        break;
      case 6:
        message_vision(HIC "一团雾气笼罩住$N!\n" NOR, me);
        me->add("spi", i);
        tell_object(me, HIC "你的灵性增加了" + i + HIC "点。\n" NOR);
        break;
      case 6:
      default:
        message_vision(HIC "一团雾气笼罩住$N!\n" NOR, me);
        me->add("con", i);
        tell_object(me, HIR "你的根骨增加了" + i + HIR "点。\n" NOR);
        break;
    }
    me->set("giftmark/newyear1", 1);
    me->start_busy(5);
    message_vision(HIC "$N感觉到一股神气的力量在身体里涌动,慢慢的扩散到全身.立刻,身体发生了微妙的变化!\n\n", me);
  } else if (arg == "武学" && !(me->query("giftmark/newyear2"))) {
    me->add("combat_exp", 100000 + random(500000));
    me->add("daoxing", 100000 + random(500000));
    me->add("potential", 50000 + random(100000));
    me->set("giftmark/newyear2", 1);
    me->start_busy(5);
    message_vision(HIG "$N闭上眼睛想了一下说道：我要" + arg + "吧!\n", me);
    message_vision("$N对着$n说道:" + HIW "好吧,我马上帮你实现愿望.\n", this_object(), me);
    message_vision(HIC "$N感觉到一股神气的力量在身体里涌动,慢慢的扩散到全身.立刻,身体发生了微妙的变化!\n\n", me);
  } else if (arg == "复活" && !(me->query("giftmark/newyear3"))) {
    if (!me->query("death")) {
      message_vision("$N对$n摇了摇头：老夫未闻死迅也。\n", who, me);
      return 1;
    }
    message_vision("\n$N顿觉天悬地转乾坤倒置，刹那间禁不住浑身颤抖！\n", me);
    if (me->query("death/combat_exp_loss")) {
      tell_object(me, "你突然发现你的武学全部恢复了！\n");
      me->add("combat_exp", (int)who->query("death/combat_exp_loss"));
    }
    if (me->query("death/dx_loss")) {
      tell_object(who, "你突然发现你的道行全部恢复了！\n");
      me->add("daoxing", (int)who->query("death/dx_loss"));
    }
    if (me->query("death/skill_loss")) {
      tell_object(who, "你突然发现你的武功全部恢复了！\n");
      me->skill_death_recover();
    }
    me->delete("death");
    me->set("last_combat_exp", me->query("combat_exp"));
    me->save();
    me->set("giftmark/newyear3", 1);
    me->start_busy(5);
    message_vision(HIG "$N闭上眼睛想了一下说道：我要" + arg + "吧!\n", me);
    message_vision("$N对着$n说道:" + HIW "好吧,我马上帮你实现愿望.\n", this_object(), me);
    message_vision(HIC "$N感觉到一股神气的力量在身体里涌动,慢慢的扩散到全身.立刻,身体发生了微妙的变化!\n\n", me);
  }
  if ((me->query("giftmark/newyear1")) || (me->query("giftmark/newyear2")) || (me->query("giftmark/newyear3")))
    return notify_fail(CYN "狗年大吉说道:你的这个愿望我已经给你了,不要太贪心呀!\n");
  if ((me->query("giftmark/newyear1")) && (me->query("giftmark/newyear2")) && (me->query("giftmark/newyear3")))
    message_vision(CYN "狗年大吉说道:$N的所有愿望我已经给你了,不能再帮你了!\n", me);
}
