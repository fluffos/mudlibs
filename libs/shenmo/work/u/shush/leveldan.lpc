#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIR "庆祝十九大开幕" NOR, ({ "level dan", "dan"}) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一颗血红色的丹丸，据说吃了可以增加两级。\n");
                set("value_c", 3);
                set("unit", "颗");
                set("is_monitored", 1);
    set("no_sell",1);
    set("no_drop",1);
    set("no_get",1);
    set("no_put",1);
    set("no_give",1);
    set("no_steal",1);
        }
}
void init()
{
        object me = this_object();
        object where = environment();

  if (userp(where))
  {
    if (me->query("owned"))
    {
      if (me->query("owned")!=where->query("id"))
      {
        call_out("destruct_me",1,where,me);
      }
    }
    else
    {
      me->set("owned",where->query("id"));
    }
  }
        add_action("do_eat", "eat");
}
void destruct_me(object where, object me)
{
        message_vision("$N手中的$n突然消失不见了。\n",where,me);
        destruct(me);
}
int do_eat(string arg)
{
        object me;
        me = this_player();

        if (! id(arg))
                return notify_fail("你要吃什么？\n");
        if ( !present(this_object(),me) ) 
                return notify_fail("你要吃什么？\n");
    if( me->query_temp("no_heal_up/bian") )
                return notify_fail("想利用bug？没门！\n");  
        message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
                       "。\n", me);     
                tell_object(me, HIR "你的等级提升了2级！\n" NOR);
                me->add("level", 2);
        destruct(this_object());
        return 1;
}

