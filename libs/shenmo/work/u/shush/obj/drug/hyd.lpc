#include <ansi.h>
inherit ITEM;

int do_eat(string);
void init();
void create()
{
        set_name(HIG "还阳丹" NOR, ({"huanyang dan", "dan"}));
        set_weight(20);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "粒");
                set("long", "一粒还阳丹，据说有起死回生之效。\n");
                set("value_c", 10);
        }

        set("is_monitored", 1);
        setup();
}
void init()
{
        object ob = this_object();
        object where = environment();
        if (!wizardp(this_player())) 
        {
                set("no_get", "嘿嘿，做梦吧! \n");
                set("no_drop","这么宝贵的还阳丹，哪能乱扔! \n");
                set("no_sell",1);
                set("no_put",1);
                set("no_give",1);
                set("no_steal",1);
        }

  if (userp(where))
  {
    if (ob->query("owned"))
    {
      if (ob->query("owned")!=where->query("id"))
      {
        call_out("destruct_ob",1,where,ob);
      }
    }
    else
    {
      ob->set("owned",where->query("id"));
    }
  }                                              
        add_action("do_eat", "eat");
}

void destruct_ob(object where, object ob)
        {
        message_vision("$N手中的$n突然消失不见了。\n",where,ob);
        destruct(ob);
        }
int do_eat(string arg)
{
        object victim = this_player();

        if (! id(arg))

                return notify_fail("你要吃什么？\n");

        if (this_object()->query("owned")!=victim->query("id"))

                return notify_fail("这是你的么？\n");

        if ( !present(this_object(),victim) )
 
                return notify_fail("你要吃什么？\n");

        if( victim->query_temp("no_heal_up/bian") )

                return notify_fail("想利用bug？没门！\n"); 
 
    
        if (!victim->query("death"))

                return notify_fail("你又没有死过，吃什么还阳丹。\n");

        if (victim->query("death/combat_exp_loss"))

                victim->add("combat_exp", victim->query("death/combat_exp_loss"));

        if (victim->query("death/dx_loss"))

                victim->add("daoxing", victim->query("death/dx_loss"));

        if (victim->query("death/skill_loss"))

                victim->skill_death_recover();

        victim->delete("death");

        victim->set("last_combat_exp",victim->query("combat_exp"));

        victim->save();

        if( userp(victim) ) log_file("RECOVER", sprintf("%s(%s) Got recovered on %s.\n", victim->name(1), geteuid(victim), ctime(time()) ) );
        message_vision("$N一仰脖，吞下了一颗" + this_object()->name() + "。\n", victim); 

        message_vision(HIG "\n$N吃下一粒还阳丹，硬是从白无常那里逃脱，捡回了一条小命。\n\n" NOR, victim);

        destruct(this_object());
        return 1;
}

