#include <ansi.h>
inherit ITEM;

void create()
{
set_name(HIG"2018元旦大礼包"NOR,({"gift"}));
set_weight(5000);
if( clonep() )
        set_default_object(__FILE__);
else    {
        set("unit", "块");
        set("long", HIR"这是一个为了庆祝2018元旦，天神送来的一个大礼包。你可以试着打开（open）它。\n"NOR);
        set("no_get","大礼包太沉了，你可以直接打开。");
        set("no_put","大礼包太沉了，你可以直接打开。");
        }
setup();
}
int init()
{
add_action("do_open", "open");
}

int do_open(string arg)
{
              string *pic = ({
@TEXT
         ______     __  ._    )z  ee     .____zz     ab
         ~~~~~~     @@~~-@   ]U@z_aL_,   ]@~==~"     @[
        zzzzzzzz    @L__d@   ]M[~~][]P   ]@_a@_      ][
        ~ ][@       ]L  ][   ]~Lzza@abz, ~~~-@~~~'   ][
          a[@L      `~~~~'    ][~ aUC~~   z@]@]b_    ][
       __d@'`@z_a[zzzd@@bzzz, d[_dr`@L  _a~Ld@ ~@b,  "'
                                                     ~"
TEXT,
  });
        object ob;
        object me = this_player();
        if (!arg || arg != "gift") return notify_fail("你打开什么？\n");
        if( me->query_temp("no_heal_up/bian") ) return notify_fail("变身来打开礼物？利用bug，会被切掉jj 的！\n");
        if( me->query("level")<100 ) return notify_fail("你的level等级太低，过百后再来要吧!\n");
        if( me->query("giftmark/20180101") ) return notify_fail("你已经打开过礼物了，给别人留点吧!\n");
        if (!userp(me)) return notify_fail("什么小猫小狗也来要礼物？\n");
               message("merry",HIM+pic[0],this_player());
        me->add("level",2);
        me->add("potential",100000);
        me->add("shen",66666);
        me->set("giftmark/20180101",1);
        message_vision("元旦大礼包砰的一声打开了！\n 
               你的等级增加了2级。\n 
               你的潜能增加了100000。\n 
                 你神增加了66666。\n",this_player());
    switch(random(8)) {
       case 0 : ob = new("/u/shush/obj/drug/shenliwan.c"); break;
       case 1 : ob = new("/u/shush/obj/drug/xiandan.c"); break;
       case 2 : ob = new("/u/shush/obj/drug/cordan.c"); break;
       case 3 : ob = new("/u/shush/obj/drug/cpsdan.c"); break;
       case 4 : ob = new("/u/shush/obj/drug/kardan.c"); break;
       case 5 : ob = new("/u/shush/obj/drug/perdan.c"); break;
       case 6 : ob = new("/u/shush/obj/drug/spidan.c"); break;
       case 7 : ob = new("/u/shush/obj/drug/xisuidan.c"); break;
     }
     ob->set("owner",me);
     ob->save();
     ob->move(me); 
    switch(random(8)) {
       case 0 : ob = new("/u/shush/obj/drug/shenliwan.c"); break;
       case 1 : ob = new("/u/shush/obj/drug/xiandan.c"); break;
       case 2 : ob = new("/u/shush/obj/drug/cordan.c"); break;
       case 3 : ob = new("/u/shush/obj/drug/cpsdan.c"); break;
       case 4 : ob = new("/u/shush/obj/drug/kardan.c"); break;
       case 5 : ob = new("/u/shush/obj/drug/perdan.c"); break;
       case 6 : ob = new("/u/shush/obj/drug/spidan.c"); break;
       case 7 : ob = new("/u/shush/obj/drug/xisuidan.c"); break;
     }
     ob->set("owner",me);
     ob->save();
     ob->move(me); 
     ob = new("/u/shush/obj/drug/haomao.c");
     ob->set("owner",me);
     ob->save();
     ob->move(me); 
     ob = new("/u/shush/obj/drug/tp.c");
     ob->set("owner",me);
     ob->save();
     ob->move(me);
     message_vision("你得到了二颗属性丹,一根毫毛和一颗加倍丹。\n",this_player()); 
     message("chat",HIY+"【元旦快乐】"+HIC+": "+NOR+HIC+me->query("name")+HIC+"获得了2018元旦大礼包一份!\n"NOR,users());
     return 1;
}

