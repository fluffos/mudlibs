#include <ansi.h>
inherit ITEM;

void create()
{
  set_name(HIG"狗年新春快乐大礼包"NOR,({"gift"}));
set_weight(5000);
if( clonep() )
        set_default_object(__FILE__);
else    {
        set("unit", "块");
          set("long", HIR"这是一个为了庆祝狗年春节，天神送来的一个大礼包。你可以试着打开（open）它。\n"NOR);
          set("no_get","大礼包太沉了，你可以直接打开。");
        set("no_put","大礼包太沉了，你可以直接打开。");
        }
setup();
        remove_call_out("dest_ob");
        call_out("dest_ob",120);
}
int init()
{
add_action("do_open", "open");
}

int do_open(string arg)
{
              string *pic = ({
@TEXT
                                                     ~"
           ]L        ._ __     z  )L           __
       .___aL__z,    ]' ]'._  ][  ]'      zs--~~"    __
          ]P ._   ~~~@~~@~~~  dL--@-4[   ]P )z       @P
       `~~@~~~ _    `' `'_   sa],][ a'   a' ][      .@'
      ---%--z--~  "~~@~~][  ]M[" ][.[   ]L__aL_ze   ][
       _a'  ]L      .@  d[  ~dL__@_]-'  `',.[_      d'
     .s'a~~~[~@-    ]P  a    a' ]M[     .a'][]L     "
       .C__][       ]'z_[   .[ )r`[    .%" a' @[   e@
       ][  a'       @  ~'   ][_F  @L  ]~  .@  `'   `'
       a~~~@       ]'       au~   `@'    "@'

TEXT,
  });
        object ob;
        object me = this_player();
        if (!arg || arg != "gift") return notify_fail("你打开什么？\n");
        if( me->query_temp("no_heal_up/bian") ) return notify_fail("变身来打开礼物？利用bug，会被切掉jj 的！\n");
        if( me->query("level")<100 ) return notify_fail("你的level等级太低，过百后再来要吧!\n");
            if( me->query("giftmark/spring-dog") ) return notify_fail("你已经打开过礼物了，给别人留点吧!\n");
        if (!userp(me)) return notify_fail("什么小猫小狗也来要礼物？\n");
               message("merry",HIM+pic[0],this_player());
        me->delete("2017_guoqing");
        me->delete("2017_zhongqiu");    
        me->delete("2017_zhongqiu");
        me->delete("giftmark");
        me->delete("wuxin");
        me->add("level",2);
        me->add("potential",100000);
        me->add("shen",66666);
          me->set("giftmark/spring-dog",1);
            message_vision(HIR"春节大礼包砰的一声打开了！\n 
                 $N的等级增加了2级。\n 
                 $N的潜能增加了100000。\n 
                 $N的神增加了66666。\n"NOR,this_player());
    switch(random(8)) {
       case 0 : ob = new("/u/shush/obj/drug/shenliwan.lpc"); break;
       case 1 : ob = new("/u/shush/obj/drug/xiandan.lpc"); break;
       case 2 : ob = new("/u/shush/obj/drug/cordan.lpc"); break;
       case 3 : ob = new("/u/shush/obj/drug/cpsdan.lpc"); break;
       case 4 : ob = new("/u/shush/obj/drug/kardan.lpc"); break;
       case 5 : ob = new("/u/shush/obj/drug/perdan.lpc"); break;
       case 6 : ob = new("/u/shush/obj/drug/spidan.lpc"); break;
       case 7 : ob = new("/u/shush/obj/drug/xisuidan.lpc"); break;
     }
     ob->set("owner",me);
     ob->save();
     ob->move(me); 
    switch(random(8)) {
       case 0 : ob = new("/u/shush/obj/drug/shenliwan.lpc"); break;
       case 1 : ob = new("/u/shush/obj/drug/xiandan.lpc"); break;
       case 2 : ob = new("/u/shush/obj/drug/cordan.lpc"); break;
       case 3 : ob = new("/u/shush/obj/drug/cpsdan.lpc"); break;
       case 4 : ob = new("/u/shush/obj/drug/kardan.lpc"); break;
       case 5 : ob = new("/u/shush/obj/drug/perdan.lpc"); break;
       case 6 : ob = new("/u/shush/obj/drug/spidan.lpc"); break;
       case 7 : ob = new("/u/shush/obj/drug/xisuidan.lpc"); break;
     }
     ob->set("owner",me);
     ob->save();
     ob->move(me);
     ob = new("/u/shush/obj/drug/haomao.lpc");
     ob->set("owner",me);
     ob->save();
     ob->move(me); 
     ob = new("/u/shush/obj/drug/tp.lpc");
     ob->set("owner",me);
     ob->save();
     ob->move(me);
       message_vision(HIR"$N得到了二颗属性丹,一根毫毛和一颗加倍丹。\n"NOR,this_player()); 
       message("chat",HIY+"【春节快乐】"+HIC+": "+NOR+HIC+me->query("name")+HIC+"获得了狗年春节大礼包一份!\n"NOR,users());
     load_object("/obj/empty");
     this_object()->move("/obj/empty");
     call_out("dest_ob",1);
     return 1;
}
void dest_ob()
{
        tell_room(environment(),"\n天上忽然传来一声断喝：还我"+name(1)+"来！\n只见"+name(1)+"凌空而去，霎时间不见了踪影。\n\n");
        destruct(this_object());
}

