#include <ansi.h>
inherit PERFORM;

void create()
{
set("name",HIR"「无想斩」"NOR);
set("class","human");
set("family","剑客联盟");
set("target",1);
set("betray_lvl",350);
set("belong","doom-sword");
set("base_type","sword");
set("limit_skill",([
      "doom-sword"   : 180,
      "sword"   : 180,
      ]));
set("limit_other",([
     "int"  : 25,
     "kar"  : 25,
     ]));
set("force",1000);
set("need_force",300);
set("busy_self",(2+random(2)));
}

void hit_msg(object me,object target,int num)
{
   object weapon=me->query_temp("weapon");
   int skill;
   skill=me->query_skill("doom-sword",1)+me->query("kar");
   if (skill>349)
      skill=7;
   else if (skill>279)
      skill=5;
   else  skill=3;
   if(me&&target)
   {
      set("double_hit",([
         "num"   : skill,
         "me_del_env"   : 1,
         "t_del_env"   : 1,
         ]));
     message_vision(RED  "\n\n$N腾空越起，变换身行，手中的"+ weapon->name() +"划出森然剑气，一招「无想斩」一气呵成 ！！\n\n" NOR, me, target);
     }

}

void double_hit_msg(object me,object target,int num)
{
    string *hitmsg,msg;
    object weapon=me->query_temp("weapon");
    hitmsg=({
           HIC  "\n「厉鬼缠身」，$N手中"+ weapon->name() +"带着一阵寒意直刺$n！" NOR,
           HIR  "\n「群魔夜宴」，$N手中"+ weapon->name() +"带着冷冷的剑气斜刺$n！" NOR,
           HIY  "\n「百鬼夜行」，$N手中"+ weapon->name() +"落叶般横刺$n！" NOR,
           HIW  "\n「十万神魔」，$N手中"+ weapon->name() +"闪电般猛刺$n！" NOR,
           HIR  "\n「群魔乱舞」，$N手中"+ weapon->name() +"带着冷冷的剑气斜刺$n！" NOR,
           HIY  "\n「十万幻想」，$N手中"+ weapon->name() +"落叶般横刺$n！" NOR,
           HIW  "\n「万天神魔」，$N手中"+ weapon->name() +"闪电般猛刺$n！" NOR,
           });
     msg=hitmsg[num];
     if(me&&target)
     {
          message_vision(msg,me,target);
      }
}


int limit_other_msg(object me,object target,string str)
{
  if(me&&target)
  {
    if( str=="kar")
      str="福缘";
    if( str=="int")
      str="悟性";
         message_vision("\n你的"+str+"不够，无法使用"+HIR"「无想斩」\n"NOR,me,target);
    }

}
