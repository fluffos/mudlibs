#include <ansi.h>
#include <combat.h>

inherit SSERVER;

void feidao_ok(object);
void postfeidao(object, object, object, int);

int perform(object me, object target) {
  mapping feidao = ([
    "damage": 180,
    "dodge": -60,
    "parry": -60,
    "damage_type": "刺伤",
    "post_action": (: postfeidao :)
  ]);

  object weapon = me->query_temp("weapon");
  if (me->query("family/family_name") != "江湖浪子")
    return notify_fail("李寻欢的成名绝技[又见飞刀]，外界谁能知晓其中变化！\n");
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || target->is_corpse() || target == me)
    return notify_fail("你要攻击谁？\n");
  if (!target->is_fighting(me))
    return notify_fail("你们没有在打架！\n");
  if (me->query_temp("no_feidao"))
    return notify_fail("你现在状态不佳，不能使用飞刀。\n");
  if (me->query_skill("wuji-force", 1) < 50)
    return notify_fail("你的内功太差，飞刀飞出去肯定飞不回来。\n");
  if (me->query_skill("li-dao", 1) < 150)
    return notify_fail("你的小李飞刀那么菜，当心砸了李寻欢的招牌。\n");
  if (me->query_skill("throwing", 1) < 150)
    return notify_fail("你的暗器功夫太差，肯定找不到目标。\n");
  if (me->query("force") < 100)
    return notify_fail("你内力不继，难以驾御飞刀。\n");

  me->add("force", -100);
  me->add_temp("apply/attack", me->query_skill("li-dao", 1) / 10);
  me->add_temp("apply/damage", me->query_skill("li-dao", 1) / 10);
  me->set("actions", feidao);
  message_vision(HIC "$N突然眉头一皱，掌中" + weapon->query("name") + HIC "已经脱手，飞一般朝$n射去！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision(HIC "小李飞刀第二刀" NOR, me, target);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision(HIC "小李飞刀第三刀" NOR, me, target);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  message_vision(HIC "小李飞刀第四刀" NOR, me, target);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  message_vision(HIC "小李飞刀第五刀" NOR, me, target);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  message_vision(HIC "小李飞刀第六刀" NOR, me, target);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  message_vision(HIC "小李飞刀最后一刀" NOR, me, target);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->set_temp("no_feidao", 1);
  me->add_temp("apply/damage", -me->query_skill("li-dao", 1) / 10);
  me->add_temp("apply/attack", -me->query_skill("li-dao", 1) / 10);
  call_out("feidao_ok", 2 + random(2), me);
  me->reset_action();
  return 1;
}

void feidao_ok(object me) {
  if (!me) return;
  me->delete_temp("no_feidao");
}

void postfeidao(object me, object victim, object weapon, int damage) {
  if (damage > 0 || damage == RESULT_DODGE)
    message_vision(HIW "" + weapon->query("name") + HIB "在空中打了个转，又飞回到$N手中。\n" NOR, me);
  else {
    message_vision(HIW "" + weapon->query("name") + HIR "改变方向，“唰”的一声，斜斜插在地上。\n" NOR, me);
    //     weapon->move(environment(me));
  }
}
