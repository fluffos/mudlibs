// dianxue.c
#include <ansi.h>

inherit SKILL;
//点穴  dodge 20 parry -20 force 20
mapping *action = ({
 ([      "name":                 "指风",
       "action":
       "$N身形晃动，以一招"+HIW"「指风」"NOR"点向$n的"+HIR"膻中穴"NOR,
       "dodge":                   25,
       "parry":                  -15,
       "force":                  5,
       "damage_type":	"内伤",
       "weapon":		          "右手食指"
]),
 ([      "name":                 "旋风",
       "action":
       "$N身形晃动，以一招"+HIW"「旋风」"NOR"点向$n的"+HIY"天突穴"NOR,
       "dodge":                   25,
       "parry":                  -35,
       "force":                  15,
       "damage_type":   "内伤",
       "weapon":                          "食指"
]),
 ([      "name":                 "灵犀",
       "action":
       "$N身形晃动，以一招"+HIW"「灵犀」"NOR"点向$n的"+HIY"百会穴"NOR,
       "dodge":                   35,
       "parry":                  -25,
       "force":                  35,
       "damage_type":   "内伤",
       "weapon":                          "食指"
]),
 ([      "name":                 "暗渡",
       "action":
       "$N身形晃动，以一招"+HIW"「暗渡」"NOR"点向$n的"+HIB"死穴"NOR,
       "dodge":                   55,
       "parry":                  -45,
       "force":                  200,
       "damage_type":   "内伤",
       "weapon":                          "食指"
]),
});
int valid_enable(string usage)
{
return usage=="unarmed"|| usage=="parry";
}

int valid_learn(object me)
{
if((int)me->query_skill("force",1)<300)
  return notify_fail("你的内功修为不够，没办法学习点穴大法。\n");
return 1;
}


mapping query_action(object me, object weapon)
{
return action[random(sizeof(action))];
}


practice_skill(object me)
{
  return notify_fail("点穴只能通过读书，或是运用(perform)，或者研究(research)增加熟练度\n");
}


mixed hit_ob(object me, object victim, int damage_bonus)
{
int dxlvl,txlvl;
dxlvl=me->query_skill("dianxue",1);
txlvl=victim->query_skill("dodge",1);
txlvl+=victim->query_skill("parry",1);
if (dxlvl<300) return;
if(dxlvl>random(txlvl)/3)
{
victim->receive_wound("kee", damage_bonus);
switch(random(3)){
case 2: if(!victim->is_busy())  victim->start_busy(1+random(2));
     return HIY"$n浑身一麻，已经行动不得\n"NOR;
case 1: if(!victim->is_busy()) victim->start_busy(1);
    return HIY"$n浑身一麻，感觉行动有些困难！\n"NOR;
case 0: return HIY"$n浑身一麻，竟似是骨碎的声音！\n"NOR;
}
}

}


string perform_action_file(string action)
{
   return CLASS_D("forall")+"/dianxue/"+action;
}
