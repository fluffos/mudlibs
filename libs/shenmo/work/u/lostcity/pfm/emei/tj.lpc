#include <ansi.h>
inherit PERFORM;

int set_damage(int rate)
{
object me=this_player();
int damage;
damage=(int)me->query("eff_kee")*rate/100;
return damage;
}

int create()
{
int damage1,damage2;
int rate1,rate2;
object me=this_player();
rate1=35;
rate2=(int)(random((int)((int)me->query_skill("tianji-sword",1)/3))+me->query("force_factor"));
damage1=set_damage(rate1);
damage2=set_damage(rate2);
set("name",HIC"天玑无限"NOR);//设置pfm名字;
set("class","human");
set("belong","tianji-sword");
set("betray_lvl",350);
set("target",1);
set("force",800);
set("need_force",150);
set("damage_type","eff_kee");//伤害类型
set("limit_skill",
([   "tianji-sword"      :          150,   
]));
set("busy_self",2);
set("busy_lost",2);
set("special_hit",([
"num"  : 3,
"temp_persent"  : ({250,250,150}),
"temp_damage"   :  ({damage1,damage1,damage2}),
"success_next"     :     ({ 0,0,1,}),
"fail_next"        :     ({ 0,1,1}),
]));

}

void hit_msg(object me,object target,int num)  //发招时出现的信息
{
string msg;object weapon;
weapon=me->query_temp("weapon");
if ( me && target && num==1) {
message_vision(HIM"$N人剑合一，放出手中"+weapon->name()+HIM"化作一条彩虹，竟使出了峨嵋山天玑剑绝学--『"HIW"天玑飞虹"HIM"』！\n\n" NOR,me,target); 
message_vision(HIC"$N飞身而起，身法之快追上握住"+weapon->name()+HIC"，只见无数剑影闪过。\n"NOR,me); 
message_vision(HIM"剑影随着彩虹直上云霄，『"HIW"天玑飞虹"HIM"』含劲欲发！\n\n"NOR,me); 
}

return;
}

void success_hit_msg(object me,object target,int num) //pfm命中后出现的信息,num为第几招，可在函数内设置
{
string msg;object weapon;
weapon=me->query_temp("weapon");
if (num==1)
{
msg = HIR"$n正看着入神，彩虹中的无数剑影纵然直下！\n"+"“嗖”的一声，从$n的身上穿体而过，血溅满地！\n\n"NOR; 
}
else if(num==2)
{
msg=HIM"$N身形转动，原来还有后招，转眼间又杀出一剑！\n" NOR+HIM"这一招『"HIW"天玑再现"HIM"』比刚才那招更快，好像要一鼓作气，斩妖除魔！\n\n" NOR; 
}
else
{
msg=HIM"$N突然收住身形，回步而立，撤锏于背后，无招胜有招，无形胜有形。\n"NOR+HIM"这一招正是天玑剑的精华，尽在『"HIW"天玑无限"HIM"』！\n\n"NOR;
}
if(me && target)
{
message_vision(msg,me,target);
}
}
void lost_hit_msg(object me,object target,int num)//pfm未命中后出现的信息,num为第几招，可在函数内设置
{
string msg;
object weapon=target->query_temp("weapon");
if(num==1)
{
msg = HIW"$n情神一聚，知道天玑之中暗藏无限杀机。侧身闪过了这招『"HIM"天玑飞虹"HIW"』\n\n"NOR; 
message_vision(msg,me,target);
}
else if(num==2)
{
msg = HIW"$n临危不乱，使出浑身招数终于化解了$N的攻势。\n\n"NOR;
message_vision(msg, me, target); 
}
else
{
msg = HIW"$n看破了这招的虚实，将计就计，假装冲上前，却在$N出剑的一瞬间腾空跃开，回手竟反攻一招！\n\n"NOR; 
message_vision(msg, me, target); 
COMBAT_D->do_attack(target, me, target->temp("weapon")); 
}
}
