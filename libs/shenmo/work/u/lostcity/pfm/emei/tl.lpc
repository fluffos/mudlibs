#include <ansi.h>
inherit PERFORM;

void create() {
  set("name", "HIW" 天 雷 合 并 "NOR");
  set("class", "human");
  set("belong", "tianlei-sword");
  set("base_type", "sword");
  set("target", 1);
  set("betray_lvl", 350);
  set("force", 1200);
  set("need_force", 100);
  set("damage_type", "kee");
  set("limit_skill", ([
    "tianlei-sword": 180,
    "zhutian-bu": 180,
    "emeiforce": 180,
    "jinding-zhang": 180,
  ]));

  set("busy_self", 3);
  set("busy_lost", 3);
}

void hit_msg(object me, object target, int num) {
  int extra, lvl;
  object weapon = me->query_temp("weapon");

  extra = me->query_skill("kugu-blade", 1);
  lvl = extra / 30;
  //lvl = lvl/2+random(lvl/2);
  if (lvl > 9) lvl = 9;

  set("double_hit", ([
    "num": lvl,
    "me_del_env": 1,
    "t_del_env": 1,
  ]));

  if (me && target && num == 1) {
    message_vision(HIM "$N右手幻出一道红光，正是天玑剑！" HIG "左手幻出一道绿光，正是雷炎剑。\n" NOR, me, target);
    message_vision(HIW "双手缓缓之间将此二剑并为一处，瞬间化作一条彩虹进入流光速，正是一招「" HIC "天雷合并" HIW "」。\n" NOR, me, target);
    message_vision(HIC "$n还没有来得及看清楚是怎么回事，以被彩虹透体而过。\n" NOR, me, target);
  }
  return;
}

void double_hit_msg(object me, object target, int i) {
  switch (i) {
    case 1:
      {
        message_vision(HIR "┏━━┓\n" NOR, me, target);
        message_vision(HIR "┃ " HIY "天" HIR " ┃\n" NOR, me, target);
        message_vision(HIR "┗━━┛\n" NOR, me, target);
      }
      break;
    case 2:
      {
        message_vision(HIR "          ┏━━┓\n" NOR, me, target);
        message_vision(HIR "          ┃ " HIY "雷" HIR " ┃\n" NOR, me, target);
        message_vision(HIR "          ┗━━┛\n" NOR, me, target);
        break;
      }
    case 3:
      {
        message_vision(HIR "                    ┏━━┓\n" NOR, me, target);
        message_vision(HIR "                    ┃ " HIY "合" HIR " ┃\n" NOR, me, target);
        message_vision(HIR "                    ┗━━┛\n" NOR, me, target);
        break;
      }
    case 4:
      {
        message_vision(HIR "                               ┏━━┓\n" NOR, me, target);
        message_vision(HIR "                               ┃ " HIY "并" HIR " ┃\n" NOR, me, target);
        message_vision(HIR "                               ┗━━┛\n" NOR, me, target);
        break;
      }
    case 5:
      {
        message_vision(HIR "                               ┏━━┓\n" NOR, me, target);
        message_vision(HIR "                               ┃ " HIY "天" HIR " ┃\n" NOR, me, target);
        message_vision(HIR "                               ┗━━┛\n" NOR, me, target);
        break;
      }
    case 6:
      message_vision(HIR "                    ┏━━┓\n" NOR, me, target);
      message_vision(HIR "                    ┃ " HIY "雷" HIR " ┃\n" NOR, me, target);
      message_vision(HIR "                    ┗━━┛\n" NOR, me, target);
      break;
    case 7:
      message_vision(HIR "          ┏━━┓\n" NOR, me, target);
      message_vision(HIR "          ┃ " HIY "合" HIR " ┃\n" NOR, me, target);
      message_vision(HIR "          ┗━━┛\n" NOR, me, target);
      break;
    case 8:
      message_vision(HIR "┏━━┓\n" NOR, me, target);
      message_vision(HIR "┃ " HIY "并" HIR " ┃\n" NOR, me, target);
      message_vision(HIR "┗━━┛\n" NOR, me, target);
      break;
    case 9:
      message_vision(HIR "┃ " HIY "左天玑，右雷焱" HIR " ┃\n" NOR, me, target);
      message_vision(HIR "双剑同时向$n削去，$n给吓得呆住了\n" NOR, me, target);
      break;
  }
}
