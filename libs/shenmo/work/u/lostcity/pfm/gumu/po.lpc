#include <ansi.h>
inherit PERFORM;


void create() {
  int damage;
  set("name", HIW "「破·暴风刃」" NOR);
  set("class", "yao");
  set("belong", "qinghu-jian");
  set("base_type", "sword");
  set("persent", 120);
  set("target", 1);
  set("force", 800);
  set("need_force", 100);
  set("betray_lvl", 350);
  set("limit_skill", ([
    "qinghu-jian": 160,
    "blade": 120,
    "force": 120,
  ]));
  set("limit_other", ([
    "sen": 400,
  ]));
  set("busy_self", (1 + random(2)));
}

void hit_msg(object me, object target, int num) {
  object weapon = me->query_temp("weapon");
  string msg;
  if (me && target && num == 1) {
    msg = HIC "$N手中" + weapon->name() + HIC "在空中划了一了半圆，同时大喝一声\n";
    msg += HIW "破·暴风刃。" + HIG "霎时间，龙如卷，马长嘶，剑气如霜......\n";
    msg += HIY "$n眼前处处是寒光剑影，顿感感到一股巨大的压力冲击着自己。\n";
    message_vision(msg, me, target);
  }
}

void success_hit_msg(object me, object target, int num) {
  string msg;
  object weapon2;
  if (me && target) {
    if (objectp(weapon2 = target->query_temp("weapon"))) {
      msg = "突然$n觉得手臂一麻，手中";
      msg += "脱手而出！\n" NOR;
      message_vision(msg, me, target);
      weapon2->move(environment(me));
    }
    target->start_busy(4 + random(4));
    msg = "谁知$n手中根本就没有武器，$N顿时破绽百出！\n";
    message_vision(msg, me, target);
  }
}

void lost_hit_msg(object me, object target, int num) {
  string msg;
  object weapon2 = target->query_temp("weapon");
  if (me && target) {
    msg = "可是$n看破了$N的企图，立刻将手中" + weapon2->name() + "舞得风雨不透，使$N的「破·暴风刃」没有起到作用。\n" NOR;
    message_vision(msg, me, target);
  }
}
