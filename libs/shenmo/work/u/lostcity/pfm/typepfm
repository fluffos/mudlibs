//新pfm格式---do_attack类 盘龙八式

#include <ansi.h>
inherit PERFORM;

void create(object me,object target) 
{
set("name","盘龙八式");                 //pfm名字
set("target",1);                                //表示为攻击性的pfm,无或为0表示为辅助性的pfm
set("type","qianjun-bang");                     //此pfm属于哪个skills的外功
set("need_force",800);                  //所需要的内力限制
set("force",200);                               //所消耗的内力
set("family","方寸山三星洞");           //门派限制
set("class","xian");                            //calss限制
set("belong","qianjun-bang");           ////此pfm属于哪个skills的外功,(与type重复了，待定)
set("betray_lvl",350);                  //叛师能发的等级限制
set("limit_skill",([                            //skill限制，低于此无法发
        "qianjun-bang" : 200,           // skill名  skill等级
]));
set("double_hit",([                             //有此，则为直接调用 COMBAT_D->do_attack类的pfm
        "num"           :       8,                                      //调用COMBAT_D->do_attack的次数
        "temp"          :       "QJB_perform",                  //再调用过程中加的query_temp，无则没
        "temp_num"      :       ({ 2,1,5,7,3,6,4,2,}),          //set_temp 的数字
        "me_del_env"    :       1,              //是否me->delete("env/brief_message") 1为是，无或0为否
        "t_del_env"     :       1,              //是否target->delete("env/brief_message")同上
]));
set("busy_self",2+random(3));           //发完是否自己busy，以及时间

}

void hit_msg(object me,object target)   //发招时的信息显示，自己定义
{
if ( me && target )
        message_vision(HIC"\n$N运足精神，身形一转使出灵台绝学"HIW"「盘龙八式」"NOR+HIC"霹雳间连续向$n攻出了八招！\n"NOR,me,target);
}

void double_hit_msg(object me,object target,int i)  //连击过程中的信息显示，自己定义
{
message_vision(CYN"\n$N"CYN"身形如风，舞起手中"+me->query_temp("weapon")->name()+CYN"砸出了第"+chinese_number(i+1)+CYN"棍！\n"NOR,me,target);
return;
}

或:
void double_hit_msg(object me,object target,int i)  //连击过程中的信息显示，自己定义
{
string *hit_msg,msg;
hit_msg = ({                            //必须是8句，就是和set("double_hit",([  里的 "num"  要一样      
        "$N拿棒子打向$n",
        "$N....",
        ....
        });
msg = hit_msg[i];
message_vision(CYN"\n"+msg+CYN"！\n"NOR,me,target);
return;
}

