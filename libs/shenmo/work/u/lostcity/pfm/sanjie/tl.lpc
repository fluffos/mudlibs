#include <ansi.h>

inherit PERFORM;

int create()
{

set("name",HIG"「天打雷辟屠真龙」"NOR);
set("class","yao");
set("base_type","blade");
set("belong","zileidao");
set("target",1);
set("force",1200);
set("need_force",300);
set("limit_skill",([
     "zileidao"  : 180,
     "huntianforce"  : 180,
     "blade"  : 180,
]));

set("limit_other",([
   "sen"  : 600,
]));
set("temp","sanjie/tulong");
set("temp_time",(2+random(3)));
set("busy_self",3);
}

void hit_msg(object me,object target,int num)
{
  int number;
  string msg;
 if( me && target && num==1 )
   {
    number=me->query_skill("zileidao",1);
    number/=60;
    if( number>7) number=7;
   set("double_hit",([
      "num"  : number ,
      "temp"  : "Zld_perform" ,
      "temp_num"  : ({0,1,2,3,4,5,6}) ,
      "me_del_env"    :       1,                      
      "t_del_env"     :       1,                             
    ]));
    message_vision(HIC"\n$N运足精神，身形一转，霹雳间连续向$n攻出了"+chinese_number(number)+"招！\n"NOR,me,target); 
  }
}

void double_hit_msg(object me,object target,int num)
{
   string msg,*hit_msg;
   hit_msg= ({
      HIC"\n$N第一招——春雷暴极！"NOR,
      HIC"\n$N第二招——沉雷地狱！"NOR,
      HIC"\n$N第三招——天旋雷轰！"NOR,
      HIC"\n$N第四招——冬雷霹雳！"NOR,
      HIC"\n$N第五招——狂雷震九宵！"NOR,
      HIC"\n$N第六招——惊雷爆五岳！"NOR,
      HIC"\n$N第七招——怒雷撕天裂地！"NOR,
    });
   msg = hit_msg[num];
   if( me && target)
    {
     message_vision(msg,me,target);
     }
  return;
 }
