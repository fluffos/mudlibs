//xuehua.c 紫雷刀 perform xuehua
#include <ansi.h>
#include <combat.h> 
void xuehua_ok(object);
inherit SSERVER;
int perform(object me, object target)
{
              string str;
              object weapon;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「"HIW"紫雷融雪"NOR"」？\n");
        if(!me->is_fighting())
                return notify_fail("「"HIW"紫雷融雪"NOR"」只能在战斗中使用！\n");
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "blade")
              return notify_fail(" 你使用的武器不对，无法施展「"HIW"紫雷融雪"NOR"」。\n");
        if (me->query_skill_mapped("force")!="huntianforce")
                return notify_fail("「"HIW"紫雷融雪"NOR"」必须配合混天功才能使用。\n");
if( me->query("family/family_name")!="三界山")
                return notify_fail("不是三界山的不能用此招！\n");  
          if((int)me->query("force") < 2000 )
		  return notify_fail("你的内力不足！\n");
        if((int)me->query("max_force") < 4000 )
                return notify_fail("你的内力不够！\n");
        if((int)me->query("sen") < 1600 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if((int)me->query("combat_exp") < 3500000 )
                return notify_fail("你武学经验不够，领悟不到「"HIW"紫雷融雪"NOR"」！\n");
                if((int)me->query_skill("huntianforce",1) < 280 )
                return notify_fail("你的混天功级别还不够，使不出「"HIW"紫雷融雪"NOR"」！\n");
if((int)me->query_skill("blade",1) < 350 )
return notify_fail("你的刀术还不够精湛，使不出「"HIW"紫雷融雪"NOR"」！\n");  
        if((int)me->query_skill("zileidao", 1) < 280 )
                return notify_fail("你的紫雷刀法等级这么低，如何使用这一招！\n");
        if(me->query_temp("no_tianlei"))  //在此处设置标志位 ;
		return notify_fail("你刚刚使过「"HIW"紫雷融雪"NOR"」,先歇一歇吧。\n");
        me->delete("env/brief_message");
	target->delete("env/brief_message");
        target->start_busy(1);
        me->add_temp("apply/attack", 50);	
	me->add_temp("apply/damage", 50); 
        target->add_temp("apply/attack", -200);	
	target->add_temp("apply/damage", -200); 

message_vision(HIR "$N右手幻出一道妖红，"HIG"左手幻出一抹惨绿。\n"NOR,me,target);
message_vision(HIW"双手缓缓向天，刹时间漫天乌云，残雪乱飞，正是一招「"HIC"紫雷融雪"HIW"」。\n"NOR,me,target);
message_vision(HIC"$n在恍惚之间仿佛见到霸王英魂。\n" NOR,me,target);
        me->set_temp("QJB_perform", 1);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

        me->set_temp("QJB_perform", 2);  
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 

        me->set_temp("QJB_perform", 3);  
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 

        me->set_temp("QJB_perform", 4);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

        if( (int)me->query_skill("zileidao", 1) > 250 ) {
message_vision(HIR"┏━━┓\n"NOR,me,target);
message_vision(HIR"┃ "HIY"天"HIR" ┃\n"NOR,me,target);
message_vision(HIR"┗━━┛\n"NOR,me,target);
        me->set_temp("QJB_perform", 5);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
}
        if( (int)me->query_skill("zileidao", 1) > 260 ) {
message_vision(HIR"          ┏━━┓\n"NOR,me,target);
message_vision(HIR"          ┃ "HIY"打"HIR" ┃\n"NOR,me,target);
message_vision(HIR"          ┗━━┛\n"NOR,me,target);
        me->set_temp("QJB_perform", 6);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
}
        if( (int)me->query_skill("zileidao", 1) > 270 ) {
message_vision(HIR"                    ┏━━┓\n"NOR,me,target);
message_vision(HIR"                    ┃ "HIY"雷"HIR" ┃\n"NOR,me,target);
message_vision(HIR"                    ┗━━┛\n"NOR,me,target);
        me->set_temp("QJB_perform", 7);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
}
        if( (int)me->query_skill("zileidao", 1) > 280 ) {
message_vision(HIR"                               ┏━━┓\n"NOR,me,target);
message_vision(HIR"                               ┃ "HIY"劈"HIR" ┃\n"NOR,me,target);
message_vision(HIR"                               ┗━━┛\n"NOR,me,target);
        me->set_temp("QJB_perform", 8);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
}
        if( (int)me->query_skill("zileidao", 1) > 290 ) {
message_vision(HIR"                               ┏━━┓\n"NOR,me,target);
message_vision(HIR"                               ┃ "HIY"落"HIR" ┃\n"NOR,me,target);
message_vision(HIR"                               ┗━━┛\n"NOR,me,target);
        me->set_temp("QJB_perform", 9);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
}
        if( (int)me->query_skill("zileidao", 1) > 300 ) {
message_vision(HIR"                    ┏━━┓\n"NOR,me,target);
message_vision(HIR"                    ┃ "HIY"花"HIR" ┃\n"NOR,me,target);
message_vision(HIR"                    ┗━━┛\n"NOR,me,target);
        me->set_temp("QJB_perform", 10);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
}
        if( (int)me->query_skill("zileidao", 1) > 310 ) {
message_vision(HIR"          ┏━━┓\n"NOR,me,target);
message_vision(HIR"          ┃ "HIY"飞"HIR" ┃\n"NOR,me,target);
message_vision(HIR"          ┗━━┛\n"NOR,me,target);
        me->set_temp("QJB_perform", 11);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
}
if( (int)me->query_skill("zileidao", 1) > 320 ) {
message_vision(HIR"┏━━┓\n"NOR,me,target);
message_vision(HIR"┃ "HIY"雪"HIR" ┃\n"NOR,me,target);
message_vision(HIR"┗━━┛\n"NOR,me,target);
        me->set_temp("QJB_perform", 12);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
}
 if (target->query("eff_kee")<0 || !living(target))  
{str=target->name()+"被"+""HIW""+me->name()+""HIM""+"用紫雷刀法的绝技『"HIW"紫雷融雪"HIM"』杀死了。听说尸体染成一片暗紫！";
       // message("channel:rumor",HIM"【"HIW"空穴来风"HIM"】某人："+str+"\n"NOR,users());
	               }
        me->delete_temp("QJB_perform");
        me->receive_damage("sen", 100);
        me->add("force", -500);
        me->add_temp("apply/attack", -50);	
	me->add_temp("apply/damage", -50); 
        me->set_temp("no_xuehua",1); ;
        me->start_busy(2);
 target->add_temp("apply/attack", 200);	
	target->add_temp("apply/damage", 200); 
        call_out("xuehua_ok",20+random(10),me); ;
        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
        return 1;
}
void xuehua_ok(object me) 
{ if (!me) return; 
      me->delete_temp("no_xuehua"); 
}

