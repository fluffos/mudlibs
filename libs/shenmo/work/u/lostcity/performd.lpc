#include <ansi.h>

object offensive_target(object me) {
  int sz;
  object *enemy;
  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;
  sz = sizeof(enemy);
  if (sz > 4) sz = 4;
  if (sz > 0) return enemy[random(sz)];
  else return 0;
}

/*
mapping limit_skill = ([
	"family_name" : family_name,
	"max_lvl"	: number,
	"name1"	: skill1,
	"num1"		: num1,
	"name2"	: skill2,
	"num2"		: num2,
	"name3"	: skill3,
	"num3"		: num3,
	"name4"	: skill4,
	"num4"		: num4,
	"name5"	: skill5,
	"num5"		: num5,
	"name6"	: skill6,
	"num6"		: num6,
]);
*/

////////////////////////////////////////////////////////////
/////////                  单击性的pfm             //////////
////////////////////////////////////////////////////////////

int pfm_one(
  object me,
  //发pfm者
  object target,
  //敌人
  string pfm_name,
  //此pfm的名字
  mapping limit_skill,
  //skill限制
  string first_msg,
  //发招第一时间描述
  int busy_flag,
  //发后是否有busy,0为没，1为有
  int busy_time,
  //busy时间，上面为1，则必须有
  int t_busy_flag,
  //发后敌人是否有busy,0为没，1为有
  int t_busy_time,
  //busy时间，上面为1，则必须有

  int mypot,
  //我的参照点
  int hispot,
  //敌人的参照点	

  string success_msg,
  //击中时描述

  //*********************************************************************
  string success_func,
  //击中时调用函数，可用于击中后有特殊效果的pfm,不调用则为0。函数必须在当前pfm中自行设定。
  int success_delay,
  //几秒后开始调用success_func
  mixed success_arg,
  //*******************调用函数的规格同call_out(func,delay,arg)***********        

  string lost_msg,
  //未击中时描述

  //*********************************************************************
  string lost_func,
  //击中时调用函数，可用于击中后有特殊效果的pfm,不调用则为0。函数必须在当前pfm中自行设定。
  int lost_delay,
  //几秒后开始调用lost_func
  mixed lost_arg,
  //*******************调用函数的规格同call_out(func,delay,arg)***********        

  int lost_busy_flag,
  //未击中有没busy,0为没，1为有
  int lost_busy_time,
  //busy时间，上面为1，则必须有
  int temp_busy,
  //是否有延迟 0为否，1为是至于remove_eff则在当前pfm中自行设定
  string temp_busy_msg,
  //延迟标示，以上为1则必须有
  int damage,
  //伤害
  string damage_type,
  //伤害类型 kee sen eff_kee eff_sen both
  int lost_force,
  //耗内力1
  int success_force
  //耗内力2
) {
  int i, force;
  string str, family_name;
  object *obj;

  if (!(string)pfm_name) pfm_name = "此招";

  if (success_force >= lost_force)
    force = success_force;
  else force = lost_force;

  if (!me->is_fighting())
    return notify_fail("你们没有在打架！\n");
  if (me->query("force") < force)
    return notify_fail("你的内力不够了。\n");

  if ((i = limit_skill["num1"]) > 0)  //限制
  {
    family_name = limit_skill["family_name"];
    str = limit_skill["name1"];
    if (me->query_skill(str, 1) < i)
      return notify_fail("你的" + to_chinese(str) + "不够娴熟。\n");
    if ((int)limit_skill["max_lvl"] <= 0)  //有门派限制
    {
      if (me->query("family/family_name") != family_name)
        return notify_fail(pfm_name + "必须" + family_name + "的弟子方可使用。\n");
    }
    if (me->query_skill(str, 1) < limit_skill["max_lvl"])
      return notify_fail(pfm_name + "必须" + family_name + "的弟子方可使用。\n");
  }

  if ((i = limit_skill["num2"]) > 0) {
    str = limit_skill["name2"];
    if (me->query_skill(str, 1) < i)
      return notify_fail("你的" + to_chinese(str) + "不够娴熟。\n");
  }

  if ((i = limit_skill["num3"]) > 0) {
    str = limit_skill["name3"];
    if (me->query_skill(str, 1) < i)
      return notify_fail("你的" + to_chinese(str) + "不够娴熟。\n");
  }
  if ((i = limit_skill["num4"]) > 0) {
    str = limit_skill["name4"];
    if (me->query_skill(str, 1) < i)
      return notify_fail("你的" + to_chinese(str) + "不够娴熟。\n");
  }
  if ((i = limit_skill["num5"]) > 0) {
    str = limit_skill["name5"];
    if (me->query_skill(str, 1) < i)
      return notify_fail("你的" + to_chinese(str) + "不够娴熟。\n");
  }
  if ((i = limit_skill["num6"]) > 0) {
    str = limit_skill["name6"];
    if (me->query_skill(str, 1) < i)
      return notify_fail("你的" + to_chinese(str) + "不够娴熟。\n");
  }

  if (temp_busy == 1 && me->query_temp(temp_busy_msg))
    return notify_fail("绝招用多就不灵了。\n");

  message_vision(first_msg, me, target);

  if (busy_flag == 1)
    me->start_busy(busy_time);

  if (t_busy_flag == 1)
    target->start_busy(t_busy_time);

  if (temp_busy == 1)
    me->set_temp(temp_busy_msg, 1);

  if (mypot > hispot) {
    message_vision(success_msg, me, target);
    if (damage > 800) damage = 800;
    if (damage > 0) {
      switch (damage_type) {
        case "kee":
          target->receive_damage("kee", damage);
          COMBAT_D->report_status(target);
          break;
        case "eff_kee":
          target->receive_wound("kee", damage);
          COMBAT_D->report_status(target, damage);
          break;
        case "sen":
          target->receive_damage("sen", damage);
          COMBAT_D->report_sen_status(target);
          break;
        case "eff_sen":
          target->receive_wound("sen", damage);
          COMBAT_D->report_sen_status(target, damage);
          break;
        default:
          target->receive_damage("kee", damage);
          target->receive_damage("sen", damage);
          target->receive_wound("kee", damage);
          target->receive_wound("sen", damage);
          random(2) ? COMBAT_D->report_status(
            target,
            damage
          ) : COMBAT_D->report_sen_status(target, damage);
          break;
      }
    }
    me->add("force", -success_force);

    if (success_func) call_out(success_func, success_delay, success_arg);  //击中时函数调用

  } else {
    message_vision(lost_msg, me, target);
    if (lost_busy_flag == 1)
      me->start_busy(lost_busy_time);
    me->add("force", -lost_force);

    if (lost_func) call_out(lost_func, lost_delay, lost_arg);  //未击中时函数调用

  }
  return 1;
}

////////////////////////////////////////////////////////////
///////// 连击性的pfm COMBAT_D->do_attack类        //////////
////////////////////////////////////////////////////////////
int pfm_att(object me,
  //发pfm者
  object target,
  //敌人
  object weapon,
  //武器
  string pfm_name,
  //此pfm的名字
  mapping limit_skill,
  //skill限制

  string first_msg,
  //发招第一时间描述
  int busy_flag,
  //发后是否有busy,0为没，1为有
  int busy_time,
  //busy时间，上面为1，则必须有
  int t_busy_flag,
  //发后敌人是否有busy,0为没，1为有
  int t_busy_time,
  //busy时间，上面为1，则必须有

  int add_temp_flag,
  //是否加temp/apply
  int add_damage,
  //damage
  int add_dodge,
  int add_attack,
  int add_parry,

  int hit_num,
  //击数	

  int temp_busy,
  //是否有延迟 0为否，1为是至于remove_eff则在当前pfm中自行设定
  string temp_busy_msg,
  //延迟标示，以上为1则必须有
  int need_force
  //耗内力
) {
  int i, force;
  string str, family_name;
  object *obj;

  if (!(string)pfm_name) pfm_name = "此招";

  force = need_force;

  if (me->query("force") < force)
    return notify_fail("你的内力不够了。\n");

  if ((i = limit_skill["num1"]) > 0)  //限制
  {
    family_name = limit_skill["family_name"];
    str = limit_skill["name1"];
    if (me->query_skill(str, 1) < i)
      return notify_fail("你的" + to_chinese(str) + "不够娴熟。\n");
    if ((int)limit_skill["max_lvl"] <= 0)  //有门派限制
    {
      if (me->query("family/family_name") != family_name)
        return notify_fail(pfm_name + "必须" + family_name + "的弟子方可使用。\n");
    }
    if (me->query_skill(str, 1) < limit_skill["max_lvl"])
      return notify_fail(pfm_name + "必须" + family_name + "的弟子方可使用。\n");
  }

  if ((i = limit_skill["num2"]) > 0) {
    str = limit_skill["name2"];
    if (me->query_skill(str, 1) < i)
      return notify_fail("你的" + to_chinese(str) + "不够娴熟。\n");
  }

  if ((i = limit_skill["num3"]) > 0) {
    str = limit_skill["name3"];
    if (me->query_skill(str, 1) < i)
      return notify_fail("你的" + to_chinese(str) + "不够娴熟。\n");
  }
  if ((i = limit_skill["num4"]) > 0) {
    str = limit_skill["name4"];
    if (me->query_skill(str, 1) < i)
      return notify_fail("你的" + to_chinese(str) + "不够娴熟。\n");
  }
  if ((i = limit_skill["num5"]) > 0) {
    str = limit_skill["name5"];
    if (me->query_skill(str, 1) < i)
      return notify_fail("你的" + to_chinese(str) + "不够娴熟。\n");
  }
  if ((i = limit_skill["num6"]) > 0) {
    str = limit_skill["name6"];
    if (me->query_skill(str, 1) < i)
      return notify_fail("你的" + to_chinese(str) + "不够娴熟。\n");
  }

  if (temp_busy == 1 && me->query_temp(temp_busy_msg))
    return notify_fail("绝招用多就不灵了。\n");

  message_vision(first_msg, me, target);

  if (t_busy_flag == 1)
    target->start_busy(t_busy_time);

  if (temp_busy == 1)
    me->set_temp(temp_busy_msg, 1);

  if (add_temp_flag == 1) {
    me->set_temp("temp/dodge", me->query_temp("apply/dodge"));
    me->set_temp("temp/damage", me->query_temp("apply/damage"));
    me->set_temp("temp/parry", me->query_temp("apply/parry"));
    me->set_temp("temp/attack", me->query_temp("apply/attack"));
    me->add_temp("apply/dodge", add_dodge);
    me->add_temp("apply/damage", add_damage);
    me->add_temp("apply/parry", add_parry);
    me->add_temp("apply/attack", add_attack);
  }

  for (i = 0; i < hit_num; i++)
    COMBAT_D->do_attack(me, target, weapon, 1);

  me->add("force", -need_force);

  //可能会出bug -_-!
  if (me->query_temp("temp/dodge") != me->query_temp("apply/dodge"))
    me->set_temp("apply/dodge", me->query_temp("temp/dodge"));
  if (me->query_temp("temp/damage") != me->query_temp("apply/damage"))
    me->set_temp("apply/damage", me->query_temp("temp/damage"));
  if (me->query_temp("temp/parry") != me->query_temp("apply/parry"))
    me->set_temp("apply/parry", me->query_temp("temp/parry"));
  if (me->query_temp("temp/attack") != me->query_temp("apply/attack"))
    me->set_temp("apply/attack", me->query_temp("temp/attack"));

  if (busy_flag == 1)
    me->start_busy(busy_time);

  return 1;
}
