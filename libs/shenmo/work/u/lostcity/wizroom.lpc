inherit ROOM;
#include <ansi.h>

void create() {

  set("short", HIY "亚特兰蒂斯" NOR);
  set("long",
    HIB "传说中给洪水淹没的城市亚特兰蒂斯" NOR
    HIG "宏伟的建筑群，显示者这儿曾经的繁荣\n" NOR
  );
  set("exits", ([
    "kz": "/d/city/kezhan",
    "wz": "/d/wiz/wizroom",
  ]));
  set("objects", ([
    "/u/lostcity/npc/npc": 1,
  ]));
  set("valid_startroom", 1);

}
