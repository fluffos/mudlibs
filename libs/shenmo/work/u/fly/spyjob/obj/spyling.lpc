});


void create()
{
        set_name(WHT "逮捕令" NOR, ({ "spy ling", "ling","spyling"}));
        set("weight", 100);
        if(clonep()) set_default_object(__FILE__);
        else{
                set("unit", "枚");
                set("long", WHT"这是一枚逮捕令，拥有的人一般拥有显赫的权势。\n" NOR);
                set("value", 50000);
                set("no_get", 1);
                set("no_drop", 1);
                set("no_give", 1);
        }
        setup();
}

void init()
{
        call_out("dest", 1800);
        add_action("do_guankan", ({"guankan","kan"}));
        add_action("do_yanjiu",  ({"yanjiu"}));
}

int do_guankan(string arg)
{
        int now_time, time;
        object me;

        me = this_player();
        if(!arg) return 0;
        if(arg!="ling" && arg !="spyling" && arg!="spy ling" ) return 0;
        if(me->query_temp("spy/count")){
           write(HIM"\n这是一张大唐特许的悬赏捉拿杀人凶手的逮捕令。下面是你为了方便记忆记录的一些线索。\n"NOR
                     +me->query_temp("spy/long")+"\n");
           if(me->query_temp("spy/over"))   write(HIY"\n你似乎已经完成了任务。\n"NOR);
        }else 
        write(HIM"\n这是一张大唐特许的悬赏捉拿杀人凶手的逮捕令。但是似乎已经没什么用处了。\n"NOR);
        return 1;

}

int do_yanjiu(string arg)
{
        int now_time, time,index;
        object me,killer,where;
        string type,killerid,location,killername;
        string* sname;
        me = this_player();
        if(!arg ) return 0;
        if(arg!="ling" && arg !="spyling" && arg!="spy ling" ) return 0;
        if(!me->query_temp("spy/count") || this_object()->query("holder")!=me->query("id")) return 0;
        if(me->query_temp("spy/count")==1 && !me->query_temp("spy/start")){  
          tell_object(me,"\n你仔细回忆着这几年来发生的种种事情，还是想不起什么。"); 
          tell_object(me,"\n你似乎完成不了这个任务啦。\n"); 
          return 1;
          }
        if(me->query_temp("spy/count")==1 && me->query_temp("spy/test")){  
           index=random(sizeof(type_party));
           type=type_party[index];
           me->add_temp("spy/count",1);
           message_vision(HIR"$N翻动着尸体仔细查看,赫然发现"+NOR+HIC+type_kill[index]+NOR+CYN"\n$N心下一惊："+type_msg[index]+NOR,me);
           tell_object(me,"\n\n你仔细回忆着这几年来发生的种种事情，突然之间你似乎想道什么...");
           message_vision(HIY"\n$N似乎想起来了什么，急忙在令牌上记录了写什么。\n"NOR,me);
           me->set_temp("spy/type",type);
           me->set_temp("spy/long","\n..........\n"+HIG+type_kill[index]+NOR);
           index=random(sizeof(place));
           location=place[index];
           if(!(where=find_object(location)))
                 where=load_object(location);
           me->set_temp("spy/where",where->query("short"));
           killer=new("/u/fly/spyjob/npc/killer");
           index=random(sizeof(nm1_c));    
           killername =nm1_c[index];
           killerid =nm1_e[index];
           index=random(sizeof(nm2_c));
           killername +=nm2_c[index];
           killerid +=" "+nm2_e[index];      
           me->set_temp("spy/name",killername);
           me->set_temp("spy/id",killerid);
           killer->set_name(killername, ({me->query_temp("spy/id"),"killer"}) ); 
           killer->move(location);
           killer->set("spy_time",time());
           me->set_temp("spy/long",me->query_temp("spy/long")+RED"\n你初步推断，杀人者:"NOR+HIC+killername+NOR+RED" 地点："NOR+HIC+where->query("short")+NOR+RED"。\n"NOR);
           me->delete_temp("spy/test");
           me->delete_temp("spy/find");
           me->delete_temp("spy/kill_index");
           return 1;
        }
        if(me->query_temp("spy/count")==2 && !me->query_temp("spy/test")){  
          tell_object(me,RED"\n你仔细回忆着这几年来发生的种种事情，还是想不起什么。"NOR); 
          tell_object(me,"\n\n你还是赶紧去"+me->query_temp("spy/where")+"寻找凶手去吧。\n"); 
          return 1;
          }
        if(me->query_temp("spy/count")==2 && me->query_temp("spy/test") ){  
           index=random(sizeof(type_party));
           type=type_party[index];
           me->add_temp("spy/count",1);
           me->set_temp("spy/kill_index",index);
           message_vision(HIR"\n$N仔细回忆,赫然想起来："+NOR+HIC+type_kill2[index]+NOR,me);
           tell_object(me,"\n\n你仔细回忆着这几年来发生的种种事情，突然之间你似乎想道什么...");
           message_vision(WHT"\n$N心下一惊："+NOR+HIC+type_msg[index]+NOR,me);
           message_vision(HIY"\n$N为了避免忘记，急忙在令牌上记录了些什么......\n"NOR,me);
           me->set_temp("spy/type",type);
           me->set_temp("spy/long",me->query_temp("spy/long")+HIR"\n\n事情似乎出现变化，凶手并非一人。"NOR+HIG"\n根据凶手描述与回忆，除了死者上述描述外，"+type_kill2[index]+NOR);
           index=random(sizeof(place));
           location=place[index];
           if(!(where=find_object(location)))
                 where=load_object(location);
           me->set_temp("spy/where",where->query("short"));
           killer=new("/u/fly/spyjob/npc/killer");
           index=random(sizeof(nm1_c));    
           killername =nm1_c[index];
           killerid =nm1_e[index];
           index=random(sizeof(nm2_c));
           killername +=nm2_c[index];
           killerid +=" "+nm2_e[index];      
           me->set_temp("spy/name",killername);
           me->set_temp("spy/id",killerid);
           killer->set_name(killername, ({me->query_temp("spy/id"),"killer"}) ); 
           killer->move(location);
           killer->set("spy_time",time());
           me->set_temp("spy/long",me->query_temp("spy/long")
                    +RED"\n\n经验判断，你刻下"+me->query_temp("spy/type")+"叛徒姓名："NOR+HIC+killername+NOR 
               +RED" 地点："NOR+HIC+where->query("short")+NOR+RED"。\n"NOR);
           me->delete_temp("spy/kill_index");
           me->delete_temp("spy/find");
           me->delete_temp("spy/test");
           return 1;
        }
        if(me->query_temp("spy/count")==3 && !me->query_temp("spy/test") ){  
          tell_object(me,RED"\n你仔细回忆着这几年来发生的种种事情，你似乎已经断定凶手方向。"NOR); 
          tell_object(me,"\n\n你还是赶紧去"+me->query_temp("spy/where")+"寻找凶手去吧。\n"); 
          return 1;
        }
        if(me->query_temp("spy/count")==3 && me->query_temp("spy/over") ){  
          tell_object(me,RED"\n你幸喜凶手已经搞定，可以回去复命了。"NOR); 
          tell_object(me,"\n\n你还是赶紧去长安领赏去吧。\n"); 
          return 1;
        }
        
}

void dest()
{
       object me;
       me = this_player();
       write(RED"\n通缉令已经早已经过时了，看来已经没什麽用了，你只好随手丢掉。\n"NOR, me);  
       destruct(this_object());
}


