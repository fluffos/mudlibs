// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

inherit NPC;
string ask_spy();
string ask_ok();
void goroom(object ob, object me);
void getexp(object ob, object me);
void create() {
  set_name("袁天罡", ({ "yuan tiangang", "yuan" }));
  set("gender", "男性");
  set("age", 33);
  set("long", "袁天罡是天监台总管，听说他法术高深。
他为人正直仗义，脸上总是一股忧国忧民的神情。\n");
  set("int", 30);
  set("per", 25);
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("title", "天监台正先生");
  set_skill("unarmed", 60);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set_skill("spells", 100);
  set_skill("baguazhou", 100);
  set_skill("literate", 50);
  set_skill("sword", 60);
  set_skill("changquan", 50);

  map_skill("spells", "baguazhou");
  map_skill("unarmed", "changquan");

  set("per", 30);
  set("max_kee", 400);
  set("max_gin", 400);
  set("max_sen", 400);
  set("force", 450);
  set("max_force", 300);
  set("force_factor", 10);
  set("mana", 450);
  set("max_mana", 300);
  set("mana_factor", 5);
  set("inquiry", ([
    "通缉": (: ask_spy :),
    "完成": (: ask_ok :),
  ]));

  setup();
  add_money("silver", 5);
  carry_object("/d/obj/cloth/baguapao")->wear();
  carry_object("/d/obj/weapon/sword/taomujian")->wield();
}
int accept_fight(object me) {
  write("袁天罡凛然道：学武乃是为了强身，不是打打杀杀！\n");
  return 0;
}
int recognize_apprentice(object me) {
  if ((int)me->query("yuan-learn"))
    return 1;
  return notify_fail("袁天罡说道：您太客气了，这怎么敢当？\n");
}

int accept_object(object who, object ob) {
  if (ob->query("id") == "fan he") {
    if (((string)who->query("family/family_name") == "将军府")) {
      who->set("yuan-learn", 1);
      write("袁天罡笑道：将军看起来一表人才，以后定是人前出头之辈！
袁天罡略为沉思，又道：若将军有何问题，可随时和我商讨，天罡若是知晓，定会答复．\n");
      call_out("destroy", 1, ob);
      return 1;
    }
    if (((string)who->query("family/family_name") != "将军府")) {
      command("say 多谢多谢，我正饿着哪！");
      command("give 1 silver to " + who->query("id"));
      call_out("destroy", 1, ob);
      return 1;
    }
  } else return 0;
}
void destroy(object ob) {
  destruct(ob);
  return;
}

string ask_spy() {
  object ob, me, spyling, room;
  ob = this_player();
  me = this_object();
  if (ob->query("combat_exp") < 1000000) {
    return "你太年少了，这么点武功还想出来混？\n";
  }
  if (time() - me->query("spy_time") < 120)
    return ("有劳您了，您先休息一下吧！");
  if (ob->query_temp("spy/count")) {
    return "你不是已经接了吗？\n";
  }

  spyling = new("/u/fly/spyjob/obj/spyling");
  spyling->move(ob);
  spyling->set("holder", ob->query("id"));
  ob->set_temp("spy/long", "你可以[yanjiu ...]来推理案情，亦可以[guankan ...]查看你记录的东西");
  ob->set("spy_time", time());
  ob->set_temp("spy/count", 1);
  ob->set_temp("spy/start", 1);
  ob->set_temp("spy/test", 1);
  if (random(2)) command("sigh " + ob->query("id"));
  else command("shout");
  ob->set("spy_time", time());
  command("say 前些日子又有一宗杀人案件，结果却...唉！到现在还没有侦破。");
  command("say 如果侠士真的能够侦破，奖励自然丰厚。");
  /*
        if(!( room = find_object("/u/fly/spyjob/corpseroom")) )
            room = load_object("/u/fly/spyjob/corpseroom");
        if(objectp(room))
              ob->move(room);
        call_out("goroom",ob,me,3);
*/
  ob->start_busy(5);
  return "你小心为是";

}

void goroom(object ob, object me) {
  message_vision("$n翻动着尸体仔细查看,仔细观察着......", me, ob);
  tell_object(ob, "出去后，你可以[yanjiu spy ling]来检查伤口，记录线索。");
}
string ask_ok() {
  string ttime;
  object ob, me, spyling;
  int exp, pot;
  ob = this_player();
  me = this_object();
  if (ob->query_temp("spy/over")
    && ob->query_temp("spy/count") == 3) {
    if (random(2)) command("admire " + ob->query("id"));
    else command("say 高、高、高，都是高手......");
    command("say 想不到这么快你就能立下如此奇功。");
    command("say 如果不嫌弃的话，我来指点你一点武功吧。");
    message_vision("$N在$n耳朵旁边低声说了些什么......", me, ob);
    ob->delete_temp("spy/over");
    ob->delete_temp("spy/long");
    ob->delete_temp("spy/test");
    ob->delete_temp("spy/id");
    ob->delete_temp("spy/name");
    ob->delete_temp("spy/count");
    spyling = present("spyling", ob);
    destruct(spyling);
    message_vision("$n似乎恍然大悟，好象触动什么，不由心花怒放。\n", me, ob);
    pot = 50 + random(50) + random(ob->query("spy_job") * 2);
    if (pot > 350) exp = 350 + random(80);
    exp = 200 + random(100) + random(ob->query("spy_job") * 3);
    if (pot > 600) exp = 500 + random(400);
    ob->add("potential", pot);
    ob->add("combat_exp", exp);
    ob->add("spy_job", 1);
    ttime = ctime(time())[8..strlen(ctime(time()))];
    log_file(
      "spy_job",
      sprintf("%s %s(%s)侦破任务增加:%i点EXP %i点POT。\n", ttime, me->name(1), getuid(me), exp, pot)
    );
    return "壮士还需多多努力。\n";
  }
}
