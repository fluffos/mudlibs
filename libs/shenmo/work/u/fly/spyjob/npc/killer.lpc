  max_kee = 3 * max_kee / 2;
  max_sen = 5 * max_sen / 4;
  set("max_kee", max_kee);
  set("kee", max_kee);
  set("eff_kee", max_kee);
  set("max_sen", max_sen);
  set("eff_sen", max_sen);
  set("sen", query("max_sen"));
  if (max_mana < 30 * skillmax / 2) max_mana = 25 * skillmax / 2;
  set("max_force", max_force);
  set("force", query("max_force"));
