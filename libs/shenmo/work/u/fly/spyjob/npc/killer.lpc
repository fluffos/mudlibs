#include <ansi.h>
inherit NPC;
int my_randommove();
void init_skill(
  int exp,
  int skillmax,
  int max_kee,
  int max_force,
  int max_sen,
  int max_mana,
  string type
);
int bian();
string ask_1();

void create() {
  set_name("野猪怪", ({ "yezhu guai" }));
  if (random(2)) set("gender", "男性");
  else set("gender", "女性");

  set("age", 30);
  set("long", "他看起来两眼委靡不振，似乎整个世界都与他无关。\n");
  set("attitude", "heroism");

  set("chat_chance_combat", 50);

  set("str", 40);
  set("cor", 25);
  set("cps", 25);
  set("int", 25);

  set("chat_chance", 20);
  set("chat_msg", ({
    (: my_randommove :),
    //    (: bian :),
  }));

  setup();
  add_money("silver", 50);
}

void init() {
  object ob, me;
  mapping dizhis;
  int exp;

  ::init();

  ob = this_player();
  me = this_object();

  set("chat_chance", 20);
  set("chat_msg", ({
    (: random_move :)
  }));
  if (interactive(ob)
    && ob->query_temp("spy/count")
    && present("spy ling", ob)
    && (string)me->query("name") == ob->query_temp("spy/name")
    && !ob->query_temp("spy/find")) {
    message_vision(HIR "$N目光冷冷注视着$n一动不动，一切似乎变得不正常起来。\n" NOR, ob, me);
    tell_object(ob, "你似乎终于找到了可恶的凶手,你应该上前先去询问一番.\n");
    me->init_skill(ob->query("combat_exp") * 10 / 11
      , (ob->query_skill("force", 1) + ob->query_skill("spells", 1)) * 6 / 13
      , ob->query("max_kee") * 6 / 5
      , ob->query("max_force") * 6 / 5
      , ob->query("max_sen") * 6 / 5
      , ob->query("max_mana") * 6 / 5
      , ob->query_temp("spy/type"));
    ob->set_temp("spy/find", 1);
    set("inquiry", ([
      "作案": (: ask_1 :),
      "杀人": (: ask_1 :),
      "通缉": (: ask_1 :),
    ]));
  }
  call_out("dest", 5000);

}
string ask_1() {
  object ob, me;
  ob = this_object();
  me = this_player();
  if (me->query_temp("spy/count")
    && me->query_temp("spy/name") == this_object()->query("name")
    && me->query_temp("spy/find")) {
    command("say 你也敢来管老子的闲事，你是活得不耐烦了!");
    if (random(2)) command("kkkil");
    else command("!!!");
    message_vision(HIR "\n$n看到$N走到近前，狠狠的骂道，今天就让你尝尝大爷的厉害。\n" NOR, me, ob);
    command("grin " + me->query("id"));
    me->set_temp("spy/kill", 1);
    ob->set_leader(me);
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, me);
    ob->init_skill(me->query("combat_exp") * 10 / 11
      , (me->query_skill("force", 1) + me->query_skill("spells", 1)) * 6 / 13
      , me->query("max_kee") * 6 / 5
      , me->query("max_force") * 6 / 5
      , me->query("max_sen") * 6 / 5
      , me->query("max_mana") * 6 / 5
      , me->query_temp("spy/type"));
    ob->add("combat_exp", me->query("combat_exp") / 10);
    return HIC "哼，找死.....\n" NOR;
  } else {
    return CYN "你管这么多闲事干吗？你有通缉令吗？\n" NOR;
  }
}





void unconcious() {
  die();
}

void die() {
  object ob;
  int index;

  if (objectp(ob = query_temp("last_damage_from"))
    && ob->query_temp("spy/name") == this_object()->query("name")
    && ob->query_temp("spy/find")) {
    if (ob->query_temp("spy/count") == 2 && ob->query_temp("spy/kill")) {
      message_vision("\n\n", ob, this_object());
      command("say 这件事情我也不是主谋。");
      command("shout");
      command("say 在作案的时候，也不只是我一个人在场。");
      tell_object(ob, HIY "\n你大吃一惊，此案果然另有蹊跷，虽然此人是作案之一，但似乎主角却在后面。\n\n" NOR);
      message_vision(HIW "$N感觉事情似乎令有蹊跷，手下更是紧了，一招接一招，$n早已招架不住。\n\n" NOR, ob, this_object());
      COMBAT_D->do_attack(ob, this_object(), ob->query_temp("weapon"));
      message_vision("\n", ob, this_object());
      command("say 事到如今依然没人救我来，临死也不能叫你们好受。");
      if (random(2)) command("hny1");
      else command("adjust " + query("id"));
      message_vision(HIR "$n气急败坏的对$N嚷道，反正今天你也不会放过我，我告诉你好了。\n" NOR, ob, this_object());
      ob->set_temp("spy/test", 1);
      ob->delete_temp("spy/find");
      ob->delete_temp("spy/kill");
    }
    if (ob->query_temp("spy/count") == 3 && ob->query_temp("spy/kill")) {
      command("say 好好好......");
      command("say 我认栽了。");
      if (random(2)) command("wrongmoon");
      else command("why");
      COMBAT_D->do_attack(ob, this_object(), ob->query_temp("weapon"));
      ob->set_temp("spy/over", 1);
      ob->delete_temp("spy/find");
      ob->delete_temp("spy/kill");
    }
    tell_room(environment(), "说完，" + query("name") + "往地下一钻，消失了。\n");
    destruct(this_object());

  }

}

int heal_up() {
  if (environment() && time() - query("spy_time") > 480 && !is_fighting()) {
    call_out("leave", 100);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  object me = query("pre_killer");
  tell_room(environment(), query("name") + "如同一阵风般消失了！\n");
  destruct(this_object());
}

int my_randommove() {
  mapping exits;
  string *dirs;
  string ldir;
  string *loclist;
  string *loclist2;
  int size;

  if (!mapp(exits = environment()->query("exits"))) return 0;
  dirs = keys(exits);
  size = sizeof(dirs);
  if (size > 0) {
    ldir = dirs[random(size)];
    loclist = explode(exits[ldir], "/");
    loclist2 = explode(file_name(environment()), "/");
    if (loclist[sizeof(loclist) - 2] == loclist2[sizeof(loclist2) - 2])
      return command("go " + ldir);
  }
  return 0;
}
