  if (type == "水帘洞") {
    set("chat_msg_combat", ({
      (: perform_action, "stick.wu" :),
      (: perform_action, "stick.leiting" :),
      (: cast_spell, "thunder" :),
    }));
    set("title", HIR "水帘洞叛徒" NOR);

    set_skill("stick", skillmax);
    set_skill("qitian-gun", skillmax);
    set_skill("dodge", skillmax);
    set_skill("unarmed", skillmax);
    set_skill("houquan", skillmax);
    set_skill("xiaoyaoyou", skillmax);
    set_skill("throwing", skillmax);
    set_skill("mihou-force", skillmax);
    set_skill("yaofa", skillmax);
    map_skill("dodge", "xiaoyaoyou");
    map_skill("force", "mihou-force");
    map_skill("unarmed", "houquan");
