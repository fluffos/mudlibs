void init_skill(
  int exp,
  int skillmax,
  int max_kee,
  int max_force,
  int max_sen,
  int max_mana,
  string type
) {
  object weap;

  if (type == "方寸") {
    set("title", HIR "方寸叛徒" NOR);
    set("chat_msg_combat", ({
      (: perform_action, "stick.leiting" :),
      (: perform_action, "stick.pili" :),
      (: cast_spell, "thunder" :),
    }));

    set_skill("stick", skillmax);
    set_skill("unarmed", skillmax);
    set_skill("puti-zhi", skillmax);
    set_skill("qianjun-bang", skillmax);
    set_skill("spells", skillmax);
    set_skill("dao", skillmax);
    set_skill("dodge", skillmax);
    set_skill("jindouyun", skillmax);
    set_skill("force", skillmax);
    set_skill("wuxiangforce", skillmax);
    map_skill("force", "wuxiangforce");
    map_skill("spells", "dao");
    map_skill("stick", "qianjun-bang");
    set_skill("parry", skillmax);
    map_skill("parry", "qianjun-bang");
    map_skill("unarmed", "puti-zhi");
    map_skill("dodge", "jindouyun");
    weap = new("/d/lingtai/obj/bang.lpc");
    weap->move(this_object());
    weap->wield();
  }

  if (type == "月宫") {
    set("class", "xian");
    set("title", HIR "月宫叛徒" NOR);
    set("chat_msg_combat", ({
      (: perform_action, "sword.tian" :),
      (: perform_action, "sword.wuxue" :),
      (: cast_spell, "arrow" :),
    }));
    set_skill("sword", skillmax);
    set_skill("snowsword", skillmax);
    set_skill("spells", skillmax);
    set_skill("unarmed", skillmax);
    set_skill("baihua-zhang", skillmax);
    set_skill("moonshentong", skillmax);
    set_skill("dodge", skillmax);
    set_skill("moondance", skillmax);
    set_skill("moonforce", skillmax);

    map_skill("unarmed", "baihua-zhang");
    map_skill("spells", "moonshentong");
    map_skill("sword", "snowsword");
    set_skill("parry", skillmax);
    map_skill("parry", "snowsword");
    map_skill("dodge", "moondance");
    map_skill("force", "moonforce");

    weap = new("/d/obj/weapon/sword/changjian.lpc");
    weap->move(this_object());
    weap->wield();
  }

  if (type == "普陀") {
    set("chat_msg_combat", ({
      (: perform_action, "staff.shenlong" :),
      (: perform_action, "staff.lunhui" :),
      (: cast_spell, "lianhua" :),
    }));
    set("title", HIR "普陀叛徒" NOR);

    set_skill("staff", skillmax);
    set_skill("lunhui-zhang", skillmax);
    set_skill("spells", skillmax);
    set_skill("buddhism", skillmax);
    set_skill("dodge", skillmax);
    set_skill("lotusmove", skillmax);
    set_skill("lotusforce", skillmax);
    set_skill("unarmed", skillmax);
    set_skill("jienan-zhi", skillmax);

    map_skill("spells", "buddhism");
    map_skill("staff", "lunhui-zhang");
    set_skill("parry", skillmax);
    map_skill("parry", "lunhui-zhang");
    map_skill("dodge", "lotusmove");
    map_skill("force", "lotusforce");
    map_skill("unarmed", "jienan-zhi");
    weap = new("/d/obj/weapon/staff/muzhang.lpc");
    weap->move(this_object());
    weap->wield();
  }

  if (type == "龙宫") {
    set("class", "dragon");
    set("title", HIR "龙宫叛徒" NOR);
    set("chat_msg_combat", ({
      (: perform_action, "hammer.break" :),
      (: perform_action, "unarmed.leidong" :),
      (: cast_spell, "freez" :),
    }));

    set_skill("hammer", skillmax);
    set_skill("huntian-hammer", skillmax);
    set_skill("spells", skillmax);
    set_skill("seashentong", skillmax);
    set_skill("dodge", skillmax);
    set_skill("dragonstep", skillmax);
    set_skill("dragonforce", skillmax);
    set_skill("unarmed", skillmax);
    set_skill("dragonfight", skillmax);

    map_skill("spells", "seashentong");
    map_skill("hammer", "huntian-hammer");

    set_skill("parry", skillmax);
    map_skill("parry", "huntian-hammer");
    map_skill("dodge", "dragonstep");
    map_skill("force", "dagonforce");
    map_skill("unarmed", "dragonfight");
    weap = new("/d/obj/weapon/hammer/hammer.lpc");
    weap->move(this_object());
    weap->wield();
  }

  if (type == "大雪山") {
    set("chat_msg_combat", ({
      (: perform_action, "sword.toulin" :),
      (: perform_action, "sword.chaofeng" :),
    }));
    set("title", HIR "大雪山叛徒" NOR);

    set_skill("sword", skillmax);
    set_skill("birds-sword", skillmax);
    set_skill("spells", skillmax);
    set_skill("dodge", skillmax);
    set_skill("xiaoyaoyou", skillmax);
    set_skill("ningxie-force", skillmax);
    set_skill("unarmed", skillmax);
    set_skill("yingzhaogong", skillmax);

    map_skill("spells", "dengxian-dafa");
    map_skill("sword", "birds-sword");
    set_skill("parry", skillmax);
    map_skill("parry", "bainiao-jian");
    map_skill("dodge", "xiaoyaoyou");
    map_skill("force", "ningxie-force");
    map_skill("unarmed", "yingzhaogong");

    weap = new("/d/obj/weapon/sword/changjian.lpc");
    weap->move(this_object());
    weap->wield();
  }

  if (type == "地狱") {
    set("chat_msg_combat", ({
      (: perform_action, "whip.three" :),
      (: cast_spell, "gouhun" :),
    }));
    set("title", HIR "地狱叛徒" NOR);
    set_skill("whip", skillmax);
    set_skill("hellfire-whip", skillmax);
    set_skill("spells", skillmax);
    set_skill("gouhunshu", skillmax);
    set_skill("dodge", skillmax);
    set_skill("ghost-steps", skillmax);
    set_skill("tonsillit", skillmax);
    set_skill("jinghun-zhang", skillmax);
    set_skill("kusang-bang", skillmax);
    set_skill("unarmed", skillmax);
    set_skill("jinghun-zhang", skillmax);

    map_skill("spells", "gouhunshu");
    map_skill("whip", "hellfire-whip");
    set_skill("parry", skillmax);
    map_skill("parry", "hellfire-whip");
    map_skill("dodge", "ghost-steps");
    map_skill("force", "tonsillit");
    map_skill("unarmed", "jinghun-zhang");
    weap = new("/d/obj/weapon/whip/whip.lpc");
    weap->move(this_object());
    weap->wield();
  }

  if (type == "无底洞") {
    set("chat_msg_combat", ({
      (: perform_action, "blade.pozhan" :),
      (: cast_spell, "huanying" :),
    }));
    set("title", HIR "无底洞叛徒" NOR);
    set_skill("blade", skillmax);
    set_skill("kugu-blade", skillmax);
    set_skill("unarmed", skillmax);
    set_skill("yinfeng-zhua", skillmax);
    set_skill("spells", skillmax);
    set_skill("dodge", skillmax);
    set_skill("lingfu-steps", skillmax);
    set_skill("huntian-qigong", skillmax);
    set_skill("yaofa", skillmax);
