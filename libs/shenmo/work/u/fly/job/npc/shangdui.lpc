#include <ansi.h>
inherit ITEM;
#include "dest.h";

void create()
{
        set_name(FLA+HIY"商队"NOR, ({ "shangdui"}));
        set("unit", "只");
        set("location", 1);
        set_weight(900000);
        set("long", HIG"\n
一只远道而来的骆驼商队，骆驼背上堆满了货物。商人们
手中提着一些布袋，看来是比较重要的东西。。。\n\n
其实,他们如此乔装打扮无非为了掩目！\n
你还是快去救(jiu)人为要紧之事！\n"NOR);
        set("no_get", 1);
        set("no_drop", 1);
}

void init()
{
  call_out("destroying", 45, this_object());  
  add_action("do_rob", ({"jiu"}));
}
int do_rob()
{
   object me, ob;   
   string arg;
   int stage, i;
   me = this_player();
   ob = this_object();
   stage = 0;
   i = sizeof(dest);
   arg = query("arg");

   if(!living(me)) return 0;
   if(!me->query_temp("husong_job2") || !me->query_temp("rob_start")) 
       return notify_fail("你这奸贼，竟敢光天化日之下拦截商队，不怕被打入天牢吗？\n");
   if(objectp(present("hubiao biaoshi", environment(me))))
       return notify_fail("护镖镖师看来武功不弱，你还是先打发了面前这个再说吧！\n");  
   if(objectp(present("qiang dao", environment(me))))
       return notify_fail("强盗看来武功不弱，你还是先打发了面前这个再说吧！\n");  

   message_vision(HBYEL"\n$N对着$n"NOR+HBYEL"大吼一声：我"+me->name()+"在此！留下你们的命来！\n"NOR, me, ob);
   me->set_temp("husong_rob", 1);
   if(!ob->query("going")){
      while (i--) if (arg == dest[i]["name"]) break;
      remove_call_out("go_stage");
      ob->set("f", 7*(me->query_temp("j")+1));
      call_out("go_stage", 1, ob, stage, i, sizeof(dest[i]["context"]), me);   
      ob->set("going", 1);
      }
   remove_call_out("make_bs");
   call_out("make_bs", 1, me, ob); 
   return 1;     
}
void make_bs(object me, object ob)
{
   object obj, obj1;
    int j;
   j = me->query_temp("j");
   if(j>1){        
         obj = new(__DIR__"biaoshi");
         obj->move(environment(me));
         obj->do_copy(me);
         obj1 = new(__DIR__"biaoshi");
         obj1->move(environment(me));
         obj1->do_copy(me);
         me->add_temp("j", -1);
         return;      
         }
   else{
       message_vision(HIW"商队见已经无人保护，在$N的威胁下，只得停了下来，将所带的人全部交上！\n"NOR,me);
       message_vision(HIW"$N发现一个令牌，上面记录了强盗做案的罪证！\n"NOR,me);
       obj=new("/u/fly/job/obj/lingpai");
       obj->move(me);
       obj->set("owner", me->query("id"));
       me->add("combat_exp", 150);
       me->delete_temp("rob_start");
       me->delete_temp("husong_rob");
       me->delete_temp("husong_job2");
     me->delete_temp("husong_where");
       me->delete_temp("j");       
       message_vision(HIC"\n被救的人们带着骆驼向$N表示感谢后，转过几个小山丘就不见了。\n"NOR, me);
       message_vision(HIC"$N赶快回京城把令牌给公孙先生吧。\n\n"NOR, me);
       destruct(ob);
       }       
}

void go_stage(object me, int stage, int i, int size, object player)
{
   object where;

   int f = me->query("f");
   if(stage < size) {
     message_vision(HIY"$N匆匆忙忙地向有接应的关口方向逃去。\n"NOR, me);
     me->move(dest[i]["context"][stage]);
     message_vision(HIY"$N匆匆忙忙地奔了过来。\n"NOR, me);
     where = environment(me); 
     tell_object(player, "\n\n-------------------"+FLA+HIM+me->query("name")+"好象逃往了"+(string)where->query("short")+"一带"NOR+"-------------------\n\n");
     player->set_temp("husong_where",(string)where->query("short"));
      remove_call_out("go_stage");
     call_out("go_stage", f, me, ++stage, i, size, player);
     }
   else {    
     tell_object(player, HIM+me->query("name")+"成功地逃进了城镇。\n"NOR);
     player->delete_temp("husong_rob");
     player->delete_temp("husong_job2");
     player->delete_temp("rob_start");
     player->delete_temp("j");
     player->delete_temp("biaoshi");
     player->delete_temp("husong_where");
     message_vision(MAG"\n$N转进关中，在接应同伙的护送下离开了。\n"NOR,me);      
     destruct(me);
     }
}
void destroying(object me)
{
   if(!me->query("going")){
       message_vision("$N带着骆驼，转过几个小山丘就不见了。\n", me);       
       destruct(me);
       return;
       }
     remove_call_out("destroying2");
    call_out("destroying2",450,me);
}

void destroying2(object me)
{
       message_vision(HIY"\n看你迟迟不动手,商队已经带着骆驼，转过几个小山丘就不见了。\n"NOR, me);       
       destruct(me);
       return;
}



