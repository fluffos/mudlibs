      ob->set_skill("xuanhu-shentong", j + random(5));
      ob->set_skill("fox-hand", j + random(5));
      ob->set_skill("tianyi-zhen", j + random(5));
      ob->set_skill("huxing-step", j + random(5));
      ob->set_skill("xuanhu-blade", j + random(5));
      ob->set_skill("xuanhu-xinfa", j + random(5));
      ob->map_skill("force", "xuanhu-xinfa");
      ob->map_skill("needle", "tianyi-zhen");
      ob->map_skill("blade", "xuanhu-blade");
      ob->map_skill("parry", "tianyi-zhen");
      ob->map_skill("spells", "xuanhu-shentong");
      ob->map_skill("dodge", "huxing-step");
      ob->map_skill("unarmed", "fox-hand");
      ob->set("gender", "女性");
      set("family/family_name", "轩辕古墓");
      if (random(2)) {
        weapon = new("/d/obj/weapon/blade/jindao");
        weapon->move(ob);
        command("wield all");
        ob->map_skill("parry", "xuanhu-blade");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
          (: perform_action, "blade.xian" :),
          (: cast_spell, "feisha" :),
          (: exert_function, "recover" :),
        }));
      } else if (random(2)) {
        weapon = new("/clone/weapon/needle");
