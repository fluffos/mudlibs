      }
      break;
    case 3:
      ob->set_skill("dao", j + random(5));
      ob->set_skill("qianjun-bang", j + random(5));
      ob->set_skill("puti-zhi", j + random(5));
      ob->set_skill("wuxiangforce", j + random(5));
      ob->set_skill("jindouyun", j + random(5));
      ob->map_skill("force", "wuxiangforce");
      ob->map_skill("stick", "qianjun-bang");
      ob->map_skill("parry", "qianjun-bang");
      ob->map_skill("spells", "dao");
      ob->map_skill("dodge", "jindouyun");
      ob->map_skill("unarmed", "puti-zhi");
      if (random(2)) {
