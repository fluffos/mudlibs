      }
      break;
    case 6:
      ob->set_skill("seashentong", j + random(5));
      ob->set_skill("dragonstep", j + random(5));
      ob->set_skill("dragonforce", j + random(5));
      ob->set_skill("dragonfight", j + random(5));
      ob->set_skill("huntian-hammer", j + random(5));
      ob->set_skill("fengbo-cha", j + random(5));
      ob->map_skill("force", "dragonforce");
      ob->map_skill("hammer", "huntian-hammer");
      ob->map_skill("fork", "fengbo-cha");
      ob->map_skill("parry", "dragonfight");
      ob->map_skill("spells", "seashentong");
      ob->map_skill("dodge", "dragonstep");
      ob->map_skill("unarmed", "dragonfight");
      if (random(2)) {
        weapon = new("/d/obj/weapon/hammer/bahammer");
        weapon->move(ob);
        command("wield all");
