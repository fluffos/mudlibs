#include <ansi.h>
inherit NPC;
int do_copy(object me);
int do_back(object me);
void create() {
  string weapon;
  set_name("护镖镖师", ({ "hubiao biaoshi", "biaoshi" }));
  set("gender", "男性");
  set("age", random(10) + 25);
  set("no_quest", 1);
  set("long", "镖局的镖师。\n");
  set("combat_exp", 80000 + random(40000));
  set("attitude", "friendly");
  set_skill("force", 50);
  set_skill("sword", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set_skill("cuff", 50);
  set_skill("blade", 50);
  setup();
  carry_object("/u/fly/obj/armor/armor")->wear();
  carry_object("/u/fly/obj/armor/shield")->wear();
  carry_object("/u/fly/obj/armor/kui")->wear();
  carry_object("/u/fly/obj/armor/pifeng")->wear();
  carry_object("/u/fly/obj/armor/shoes")->wear();

}
void init() {
  add_action("do_kill", "kill");
}

int do_back(object me) {
  object killer;
  if (objectp(killer = query_temp("last_damage_from")) && killer->query_temp("husong_rob")) {
    if (!killer->query_temp("husong_kill_npc")) killer->set_temp("husong_kill_npc", 1);
    else killer->add_temp("husong_kill_npc", 1);
  }
  tell_room(environment(me), me->query("name") + "跳出战圈，转身几个起落就不见了。\n", ({ me }));
  destruct(me);
  return 1;
}
void unconcious() {
  do_back(this_object());
}
void die() {
  do_back(this_object());
}

int checking(object ob, object me) {
  if (!me || !present(me, environment())) do_back(ob);
  else call_out("checking", 2, ob, me);
  return 1;
}
int do_copy(object me) {

  int i, max_level, max_sen, max_kee, j;
  string *key;
  mapping skill;
  object ob, weapon;
  ob = this_object();
  skill = me->query_skills();
  i = sizeof(skill);
  if (!me->query_temp("husong_rob")) {
    do_back(me);
    return 0;
  }

  if (i > 0) {
    key = keys(skill);
    max_level = skill[key[0]];
    while (i--) {  // find out victim's maximum level
      if (skill[key[i]] > max_level && key[i] != "literate")
        max_level = skill[key[i]];
    }
    max_level = max_level * (8 + random(3)) / 10;

  } else max_level = 1;
  if (max_level < 60) max_level = 60;
  max_sen = me->query("max_sen") * (3 + random(2)) / 2;
  max_kee = me->query("max_kee") * (3 + random(2)) / 2;

  ob->set("eff_sen", max_sen);
  ob->set("eff_kee", max_kee);
  ob->set("sen", max_sen);
  ob->set("kee", max_kee);
  ob->set("max_sen", max_sen);
  ob->set("max_kee", max_kee);
  max_kee = max_level * 10;
  max_sen = max_level * 10;
  ob->set("max_force", max_kee);
  ob->set("force", max_kee * 3 / 2);
  ob->set("force_factor", 1 + max_kee / 200);
  ob->set("max_mana", max_sen / 2);
  ob->set("mana", max_sen * 2 / 3);
  ob->set("mana_factor", max_sen / 80);
  ob->set("combat_exp", me->query("combat_exp") * (7 + random(3)) / 6);
  message_vision(WHT "\n突然从商队后窜出一个$N，二话不说就扑向了$n！\n" NOR, ob, me);
  if (!me->query_temp("biaoshi")) me->set_temp("biaoshi", 1);
  else me->add_temp("biaoshi", 1);
  if (max_level > 600) j = max_level + random(max_level / 30);
  else j = max_level + max_level / 60 + random(max_level / 30);
  set("family/family_name", "逍遥山庄");
  ob->set_skill("unarmed", j + random(5));
  ob->set_skill("dodge", j + random(5));
  ob->set_skill("parry", j + random(5));
  ob->set_skill("hammer", j + random(5));
  ob->set_skill("whip", j + random(5));
  ob->set_skill("blade", j + random(5));
  ob->set_skill("fork", j + random(5));
  ob->set_skill("staff", j + random(5));
  ob->set_skill("force", j + random(5));
  ob->set_skill("spear", j + random(5));
  ob->set_skill("needle", j + random(5));
  ob->set_skill("spells", j + random(5));
  ob->set_skill("sword", j + random(5));
  switch (random(7)) {
    case 0:
      ob->set_skill("sanqing-jian", j + random(5));
      ob->set_skill("zhenyuan-force", j + random(5));
      ob->set_skill("baguazhen", j + random(5));
      ob->set_skill("taiyi", j + random(5));
      ob->set_skill("kaishan-chui", j + random(5));
      ob->set_skill("wuxing-quan", j + random(5));
      ob->map_skill("force", "zhenyuan-force");
      ob->map_skill("sword", "sanqing-jian");
      ob->map_skill("hammer", "kaishan-chui");
      ob->map_skill("parry", "sanqing-jian");
      ob->map_skill("spells", "taiyi");
      ob->map_skill("dodge", "baguazhen");
      ob->map_skill("unarmed", "wuxing-quan");
      if (random(2)) {
        weapon = new("/d/obj/weapon/hammer/hammer");
        weapon->move(ob);
        command("wield all");
        command("exert powerup");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
          (: exert_function, "powerup" :),
        }));
      } else if (random(2)) {
        weapon = new("/d/obj/weapon/sword/di");
        weapon->move(ob);
        command("wield all");
        command("exert powerup");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
          (: exert_function, "powerup" :),
          (: perform_action, "sword.jianmang" :),
          (: perform_action, "sword.jianqi" :),
          (: exert_function, "recover" :),
        }));
      } else {
        command("exert powerup");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
          (: exert_function, "powerup" :),
          (: exert_function, "recover" :),
        }));
      }
      break;
    case 1:
      ob->set_skill("buddhism", j + random(5));
      ob->set_skill("jienan-zhi", j + random(5));
      ob->set_skill("lotusforce", j + random(5));
      ob->set_skill("lotusmove", j + random(5));
      ob->set_skill("lunhui-zhang", j + random(5));
      ob->set_skill("huoyun-qiang", j + random(5));
      ob->map_skill("force", "lotusforce");
      ob->map_skill("spear", "huoyun-qiang");
      ob->map_skill("staff", "lunhui-zhang");
      ob->map_skill("parry", "lunhui-zhang");
      ob->map_skill("spells", "buddhism");
      ob->map_skill("dodge", "lotusmove");
      ob->map_skill("unarmed", "jienan-zhi");
      if (random(2)) {
        weapon = new("/d/obj/weapon/spear/biyuqiang");
