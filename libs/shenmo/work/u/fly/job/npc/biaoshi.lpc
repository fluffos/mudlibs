        set("chat_msg_combat", ({
          (: perform_action, "hammer.break" :),
          (: cast_spell, "breathe" :),
          (: exert_function, "recover" :),
        }));
      } else if (random(2)) {
        weapon = new("/d/obj/weapon/fork/fork");
        weapon->move(ob);
        command("wield all");
        command("exert shield");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
          (: perform_action, "fork.fengbo" :),
          (: cast_spell, "breathe" :),
          (: exert_function, "recover" :),
