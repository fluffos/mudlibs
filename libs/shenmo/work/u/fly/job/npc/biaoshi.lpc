        weapon->move(ob);
        command("wield all");
        command("exert shengang");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
          (: perform_action, "stick.leiting" :),
          (: perform_action, "stick.pili" :),
          (: perform_action, "stick.qiankun" :),
          (: cast_spell, "fenshen" :),
          (: cast_spell, "invocation" :),

        }));
      } else {
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
          (: perform_action, "jingmo" :),
          (: cast_spell, "fenshen" :),
          (: cast_spell, "invocation" :),

        }));
      }
      break;
    case 4:
      ob->set_skill("dengxian-dafa", j + random(5));
      ob->set_skill("bingpo-blade", j + random(5));
      ob->set_skill("cuixin-zhang", j + random(5));
      ob->set_skill("ningxie-force", j + random(5));
      ob->set_skill("birds-sword", j + random(5));
      ob->set_skill("xiaoyaoyou", j + random(5));
      ob->map_skill("force", "ningxie-force");
      ob->map_skill("sword", "birds-sword");
      ob->map_skill("blade", "bingpo-blade");
      ob->map_skill("parry", "birds-sword");
      ob->map_skill("spells", "dengxian-dafa");
      ob->map_skill("dodge", "xiaoyaoyou");
