  }
  ob->set("target", me);
  ob->kill_ob(me);
  checking(ob, me);
  call_out("do_back", 350, ob);
  return 1;
}
int do_kill() {
  object me, ob;
  ob = this_object();
  me = this_player();

  if (me->query_temp("husong_rob")) {
    message_vision(HIR "\n$N看样子想杀死$n，决不手下留情。\n" NOR, me, ob);
    ob->kill_ob(me);
    me->kill_ob(ob);
    if (!ob->query("have_bian")) {
      message_vision(HIR "$n狂笑道:变 变 变.....\n" NOR, me, ob);
      ob->set("title", HIY "逍遥山庄 叛徒" NOR);
      message_vision(HIY "\n$N惊讶道:原来你是逍遥山庄的叛徒。\n" NOR, me, ob);
      ob->set_name("强盗", ({ "qiang dao", "qiangdao" }));
      ob->set_leader(me);
      ob->set("have_bian", 1);
    }
    return 1;
  } else {
    message_vision(HIR "$N看样子想杀死$n，决不手下留情。\n" NOR, me, ob);
    message_vision(CYN "$n说道：嘘。。。小声点！大灰狼听到了会把你叼走的！。\n" NOR, me, ob);
    return 1;
  }
}
