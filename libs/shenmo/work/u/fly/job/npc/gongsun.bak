#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;

#include "start.h";
string ask_job();

void create()
{
        set_name("公孙先生", ({ "gongsun xiansheng", "xiansheng", "gongsun" }) );
        set("gender", "男性" );
        set("title", HIW"军师"NOR);
        set("nickname",HIM"神算子"NOR);
        set("age", 31);
        set("location", 1);
        set("unique", 1);
        set("long", HIW"\n先生在军中又称[神算子]，神功不凡。\n\n"NOR);
        set("per", 40);
        set("str", 99);
        set_skill("liumai-shengong", 500);
        set_skill("dodge", 500);
        set_skill("moondance", 500);
        set_skill("sword", 500);
        set_skill("snowsword", 500);
        map_skill("dodge", "moondance");
        map_skill("sword", "snowsword");
        map_skill("force", "liumai-shengong");
        map_skill("spells", "liumai-shengong");
        set("force", 10000);
        set("max_force", 10000);
        set("force_factor", 500);
        set("combat_exp", 30000000);
        set("max_mana", 10000);
        set("mana", 21000);
        set("mana_factor", 500);
        set("sen", 20000);
        set("max_sen", 20000);
        set("kee", 40000);
        set("max_kee", 40000);
        set("attitude", "peaceful");
        set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
        (: perform_action, "sword.tian" :),
        }) );
        set("inquiry", ([
                "程咬金" : " 开国元勋 程咬金。",
                "截杀" : (: ask_job :),
                "任务" : (: ask_job :),
                "护救" : (: ask_job :),
        ]));        
        setup();
        carry_object("/d/obj/cloth/linen")->wear();
        carry_object("/d/obj/cloth/pobuxie")->wear();     
        carry_object("/u/fly/obj/armor/sword")->wield();

}


int accept_object(object me, object obj)
{
   object ob=this_object();
   if(!me || environment(me) != environment()) return 0;
   if(!objectp(obj)) return 0;
   if(!present(obj, me)) return notify_fail("你没有这件东西。");        
   if(userp(obj)){
       command("consider "+(string)me->query("id"));
       command("say 你拿个快死的人来骗我？");
       return 0;
       }
/*
   if(time()>me->query("husong_task2")+30*60){
       command("shake "+(string)me->query("id"));
       command("say 这么久才回来，我还不如找别人来干！");
       return 0;
       }
*/
   if(obj->query("id") == "lingpai" && obj->query("owner") == me->query("id")){
       command("nod "+(string)me->query("id"));
       command("say 好样的！这才象我们大唐的作风！\n");
       message_vision(HIY"$N将$n"HIY"插在一堆竹简里，满意地点了点头,"+me->query("name")+"我们不会亏待你的。\n"NOR,ob, obj);
       remove_call_out("destroying");
       call_out("destroying", 5, obj, ob, me);                       
       return 1;
       }
   if(obj->query("money_id")) {
       command("pat " + me->query("id"));
       command("say 钱我有的是，你以后还是留给自己吧。");
       return 0;
       }
   if(obj->query("owner") != me->query("id")){
       command("hehe "+(string)me->query("id"));
       command("say 不错啊，但这活可不是你干的。");
       return 1;
       }
   else return 0;       
}
void destroying(object obj, object ob, object me)
{   
   string ttime;
   object n_money;
   if(obj) destruct(obj);
   if(!ob) return;
   if(!me || environment(me) != environment()){
      command("say 咦，人呢？怎么走了....");
      return;
      }
   command("pat "+me->query("id"));
   message_vision(HIY"$N对$n说道：你这次做得极为出色，这是你该得的部分，拿去吧！\n"NOR,ob, me);
   n_money = new("/clone/money/gold");
        ttime=ctime(time())[8..strlen(ctime(time()))];
   if(!me->query_temp("husong_kill_npc")){
   message_vision(HIY"$N对$n说道：你作弊,哼！\n"NOR,ob, me);
   log_file("husong_job",sprintf("%s %s(%s)做公孙任务，作弊。\n",
      ttime,me->name(1), getuid(me)));
//惩罚
   me->add("potential", -1000);
   me->add("potential", -1000);
   }else{
   me->set_temp("job2_exp", (me->query_temp("husong_kill_npc"))*(random(200)+300));
   me->set_temp("job2_pot", me->query_temp("husong_kill_npc")*(200+random(300)));
   me->add("combat_exp", me->query_temp("job2_exp"));
   me->add("potential", me->query_temp("job2_pot"));
   tell_room(environment(me), me->name()+"数着钱袋里的金子，脸上的肌肉不住地颤动，眼睛散发着一种奇怪的光芒。\n" NOR, ({ me }));     
   tell_object(me, "嘿嘿，发了！\n");
   n_money->move(me); 
   n_money->add_amount(1);
   log_file("husong_job",sprintf("%s %s(%s)公孙任务(%i镖师)增加:%i点EXP %i点POT。\n",
      ttime,me->name(1), getuid(me), me->query_temp("husong_kill_npc"), me->query_temp("job2_exp"), me->query_temp("job2_pot")));
    }
   me->delete_temp("job2_exp");
   me->delete_temp("job2_pot");
   me->delete_temp("husong_kill_npc");
   me->delete_temp("biaoshi");
   me->delete_temp("husong_rob");
   return;      
}
string ask_job()
{
  object me, ob;
  mapping aquest;
  int exp, j;
  aquest = quest[random(sizeof(quest))];
  me = this_player();
  ob = this_object();
  exp = me->query("combat_exp"); 
 
    if(ob->is_busy() || ob->is_fighting()) return "没看见我正忙着吗？一边等着去！";
    if (!me->query("family")) return "上仙,你无门无派,还是先去历练一番为是.";
   if(time()<me->query("husong_task2")+15*60 && me->query("id")!="fly")
            return "我现在还没有得到任何消息，你等会儿再来吧。";
    if(ob->query_temp("job_asked") == me->query("id")) 
            return "不是叫你先去那里等我吗？怎么还赖在这里？";
    if(ob->query_temp("job_asked")) 
            return "嘿嘿，你来晚了，等下一次吧。";
    if(exp<200000) return "哈哈哈，你再加把力练功吧。";
    if(exp>=600000) j=5;
    else if(exp>=500000) j=5;
    else if(exp>=400000) j=4;
    else if(exp>=300000) j=4;   
    else j=3;   
  
    me->set_temp("husong_job2", 1);
    me->delete_temp("biaoshi");
    message_vision(CYN"\n$N点了点头,一笑道：这两天会有一队强盗经过，你够胆就和我一起去看看吧。\n"NOR, ob, me);
    ob->set_temp("job_asked", me->query("id"));
    ob->set_temp("dest", aquest["name"]);
    ob->set_temp("start_place", aquest["start"]);
    ob->set_temp("place", aquest["place"]);
    me->set_temp("j", j);    
    me->set("husong_task2", time());
    me->start_busy(5+random(3));
    remove_call_out("going");
    call_out("going", 30, ob); 
    return HIB"我还有些事要办，你先去"NOR+HIR+ob->query_temp("place")+NOR+HIB"等我。\n"NOR;    
}
void going(object me)
{
       message_vision("$N急急忙忙地走了出去。\n", me);       
       me->move(me->query_temp("start_place"));
       message_vision("$N急急忙忙地走了过来。\n", me);       
}
void init()
{
   object ob, where, me;
   ::init();
   ob=this_object();
   where = environment(ob);
   if(ob->query_temp("dest")){
     if(interactive(me = this_player()) && me->query_temp("husong_job2")
        && ob->query_temp("job_asked") == me->query("id")
        && file_name(where) == ob->query_temp("start_place")) {
   remove_call_out("do_back");
           remove_call_out("waiting");
           call_out("do_back", 120, ob);
           call_out("waiting", 1, ob, me);
           }
     else{
         remove_call_out("do_back");
         call_out("do_back", 90, ob);
         }
     }
}
void waiting(object ob, object me)
{   
    if(!ob || !living(me)) return;
    command("nod "+me->query("id"));
    command("say 好，我们就在这里等着他们来吧。");
    ob->set_temp("wait_target", 1);
    me->set_temp("wait_target", 1);
    remove_call_out("wait_target");
    call_out("wait_target", 30, ob, me);
    return; 
}
void do_back(object me)
{
        me->delete_temp("wait_target");
        me->delete_temp("start_place");
        me->delete_temp("place");
        me->delete_temp("dest");
        message_vision("$N转过山丘，几个起落就不见了。\n", me);
        me->move("/d/jjf/yingfang");  
        message_vision("$N急急忙忙地走了过来。\n", me);
       remove_call_out("del_temp");
       call_out("del_temp",150,me);
}
void del_temp(object me) {me->delete_temp("job_asked");}

int wait_target(object ob, object me)
{
   object obj;
   if(!objectp(present(me, environment(ob)))){
       message_vision("$N说道：耶？那家伙怎么不见了？\n", ob);
       remove_call_out("do_back");
       do_back(ob);
       return 1;
       }
   if(!objectp(ob = present("gongsun xiansheng", environment(me)))){ 
       tell_object(me,"你发现公孙先生不见了，只好灰溜溜地转身离开。\n");
       tell_room(environment(me), me->name()+"突然一脸茫然的表情，看来是想要离开了。\n", ({ me }));
       me->delete_temp("husong_job2");
       me->clear_condition("husong_task2");
       me->delete_temp("wait_target");
       return 1;
       }

    obj = new(__DIR__"shangdui");
    obj->move(environment(me)); 
    obj->set("arg", ob->query_temp("dest"));
    message_vision(HIM"\n只听一阵骆驼风铃声传来，一只商队出现在眼前！\n\n"NOR, ob);
    tell_object(me,HIC"强盗终于出现了！\n"NOR); 
    message_vision(HIY"$N对着$n大声命令道：你快救(jiu)人，我来对付其他人！\n"NOR, ob, me); 
    message_vision(HIW"说完,$N就冲上前去，和几个护镖镖师打斗追逐开了。\n\n"NOR, ob);   
    remove_call_out("do_back");
    do_back(ob);
    me->delete_temp("wait_target");
    me->set_temp("rob_start", 1);
}


