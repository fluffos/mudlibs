#include <ansi.h>
void auto_quest(int duration);
inherit F_DBASE;
string *quest = ({
  //"长安民居",
  "/d/city/minju1",
  //"西湖路",
  "/d/kaifeng/xihu6",
  //"高老庄附近的稻田",
  "/d/gao/daotian1",
  //"白石溪",
  "/d/lingtai/uphill3",
  //"紫竹林",
  "/d/nanhai/zhul0",
  //"桂树叶间",
  "/d/moon/tree2",
  //"烧香坊",
  "/d/qujing/wuzhuang/shaoxiang",
  //"冰崖上 ",
  "/d/xueshan/bingya-up1",
  //可以仿照增多随机路径，
});

void create() {
  seteuid(getuid());
  set("name", "任务精灵");
  set("channel_id", "任务精灵(autoquest)");
  set("id", "autoquest");
  CHANNEL_D->do_channel(this_object(), "sys", "随机任务系统已经启动。\n");
  remove_call_out("auto_quest");
  call_out("auto_quest", 5, 0);
}

void auto_quest(int duration) {
  object obj;
  obj = new("/u/fly/job/npc/auto_npc");
  obj->move(quest[random(5)]);
  call_out("do_rumor", 2, obj);
}


void do_rumor(object me) {
  CHANNEL_D->do_channel(
    this_object(),
    "chat",
    "李靖在" + environment(me)->query("short") + "发现了" + me->name() + "的踪影！\n"
  );
}
