#include <ansi.h>
inherit NPC;
int do_copy(object me,int lv);
int do_back(object me);
void leave();
string *names = ({
  "狮驼岭妖怪",
  "流沙河妖怪",
  "无底洞妖怪",
  "平顶山妖怪",
  "通天河妖怪",
  "小西天妖怪",
  "无底洞妖怪",
  "火云洞妖怪",
  "碧波潭妖怪",
  "金兜山妖怪",
});
void create()
{
      string weapon;
        set_name(HIW+names[random(sizeof(names))]+NOR, ({"mojie gaoshou", "biaoshi"}));
        set("gender", "男性");
        set("age", random(10) + 25);
        set("no_quest", 1);
        set("combat_exp", 80000 + random(40000)); 
        set("attitude", "friendly");
        set_skill("force", 250);
        set_skill("sword", 250);
        set_skill("dodge", 250);
        set_skill("parry", 250);
        set_skill("cuff", 250);
        set_skill("blade", 250);
        setup();
        carry_object("/u/fly/obj/armor/armor")->wear();
        carry_object("/u/fly/obj/armor/shield")->wear();
        carry_object("/u/fly/obj/armor/kui")->wear();
        carry_object("/u/fly/obj/armor/pifeng")->wear();
        carry_object("/u/fly/obj/armor/shoes")->wear();
        carry_object("/u/fly/obj/armor/sword")->wield();

}
void init()
{
    object me=this_object();

    ::init();
    
        remove_call_out("leave");
        call_out("leave",120);
}

int do_back(object me)
{                       
       object killer; 
       if(objectp(killer = query_temp("last_damage_from")) && killer->query_temp("husong_rob")) {
                  if(!killer->query_temp("team_kill_npc")) killer->set_temp("team_kill_npc",1);
                  else  killer->add_temp("team_kill_npc",1);
                  }
  tell_room(environment(me), HIM+me->query("name")+"大叫一声:不好,转身逃走了。\n"NOR, ({me}));        
  destruct(me); 
  return 1;
}
void unconcious()
{            
      do_back(this_object());       
}
void die()
{ 
      do_back(this_object());
}

int checking(object ob, object me)
{
        if(!me || !present(me, environment())) do_back(ob);
        else call_out("checking", 2, ob, me);
        return 1;
}
int do_copy(object me,int lv)
{
        int i,max_level,max_sen,max_kee,j;
        string* key;
        mapping skill;
        object ob,weapon;
        ob = this_object();
        skill=me->query_skills();
        i=sizeof(skill);
        if(!me->query_temp("husong_rob")){
           do_back(me);
           return 0;
           }

        if(i>0) {
                key=keys(skill);
                max_level=skill[key[0]];
                while(i--) { // find out victim's maximum level
                    if(skill[key[i]]>max_level&&key[i]!="literate")
                        max_level=skill[key[i]];
                }
                max_level=max_level*(6+random(3))/5;

            } else max_level=1;
        if (max_level<60) max_level=60;
            max_sen=me->query("max_sen")*(3+random(2))/2;
            max_kee=me->query("max_kee")*(600+random(max_level/3)+max_level*2/3)/600;

            ob->set("eff_sen",max_sen);
            ob->set("eff_kee",max_kee);
            ob->set("sen",max_sen);
            ob->set("kee",max_kee);
            ob->set("max_sen",max_sen);
            ob->set("max_kee",max_kee);
            max_kee=max_level*10;
            max_sen=max_level*10;
            ob->set("max_force",max_kee);
            ob->set("force",max_kee*3/2);
            ob->set("force_factor",max_kee/80);
            ob->set("max_mana",max_sen/2);
            ob->set("mana",max_sen*2/3);
            ob->set("mana_factor",max_sen/80);
            ob->set("combat_exp",me->query("combat_exp")*(7+random(3))/6);
            if (max_level>600)    j=max_level+10+random(20);
            else    j=max_level+max_level/60+random(max_level/30);
            j=j+lv*(4+random(3));
            set("family/family_name","逍遥山庄");
            ob->set_skill("unarmed", j);
            ob->set_skill("dodge", j);
            ob->set_skill("parry", j);
            ob->set_skill("force", j);
            ob->set_skill("spells", j);
 
            ob->set_skill("sword", j+random(5));
            if(random(2))  ob->set_skill("snowsword", j+random(5));
            else    ob->set_skill("sanqing-jian", j+random(5));
            ob->set_skill("yixingbu", j+random(5));
            ob->set_skill("wuxing-quan", j+random(5));
            ob->set_skill("yijinjing", j+random(5));
            ob->set_skill("seashentong", j+random(5));
            ob->map_skill("force", "yijinjing");
            if(ob->query_skill("sanqing-jian",1)>0) ob->map_skill("sword", "sanqing-jian");
            else    ob->map_skill("sword", "snowsword");
            ob->map_skill("parry", "zhuihun-sword");
            ob->map_skill("spells", "seashentong");
            ob->map_skill("dodge", "yixingbu");
            ob->map_skill("unarmed", "wuxing-quan");

            set("chat_chance_combat",15-random(10));
            set("chat_msg_combat", ({
            (: exert_function, "recover" :),
            (: exert_function, "recover" :),
            (: exert_function, "recover" :),
              }) );  
            ob->set("target", me);
            ob->kill_ob(me);
            checking(ob, me);    
            call_out("do_back", 350,  ob);  
            return 1;
}
void leave()
{
      if(this_object()) {
        if(environment()){
        command("say 嘿嘿，这么久没人敢来，看来是怕了我了。。。");
        message("vision",HIB + name() + 
                " 打个呼哨，驾着阵狂风去了。" NOR,environment());
}
        destruct(this_object());
      }
      return;
}


