#include <room.h>
#include <ansi.h>
inherit ROOM;

string look_gaoshi();
void create() {
  set("short", "内堂");
  set("long", @LONG

这是知府内堂的一片小空场，在东边的墙上贴了几张官府悬赏捉拿
朝廷要犯的告示，下面围观了许多看热闹的人，当中不乏一些武林
高手，但是要捉拿的要犯都很扎手，很少有人随便揭榜。你不经意
就发现傍边还有一张告示(gaoshi)。

LONG
  );

  set("exits", ([
    "southwest": "/d/kaifeng/datang",
  ]));
  set("objects", ([
    __DIR__ "npc/yayi": 1,
  ]));

  set("item_desc", ([
    "gaoshi": (: look_gaoshi :),
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("light_up", 1);
  setup();
}

string look_gaoshi() {
  return HIG "\n接拿任务" WHT ":" HIY "jie wenshu" HIG "。"
    HIG "\n查阅任务" WHT ":" HIY "kan wenshu" HIG "。"
    HIG "\n完成任务" WHT ":" HIY "qidao corpse" HIG "。"
    HIG "\n提示:"
    NOR + WHT "\n (1)需要追杀两次到三次,难度不变化。"
    "\n (2)增加/log记录，防止意外Bug。"
    "\n (3)严禁利用Bug,违者必究。"
    "\n (4)" NOR + HIW "E-mail:" NOR + HIR "qqinxl@263.net" HIG "。" NOR + HIW "Oicq:" NOR + HIR "15707897" HIG "。\n\n" NOR;
}
#include "/u/fly/job/guanfu/job.h"
