// kaoguan.c 考官

#include <ansi.h>
inherit NPC;

//if X >= 1, tell me answer.
#define DEBUG(X,Y) if(X) write(Y);
//BUSY_TIME = 考试时busy时间, WAIT_TIME = 等答案需要时间.
#define BUSY_TIME 3
#define WAIT_TIME 20
//Q_JING = 需要消耗的"精", Q_QI = 需要消耗的"气"
#define Q_JING 15
#define Q_QI 30
//针对于 *单行* 和 *双行* 题目的难度系数
#define EASY_FACTOR 2
#define HARD_FACTOR 3
//答错的惩罚系数,不要设太高才好. 1 到 3/2 之间吧
#define PENALTY_FACTOR 1

#include "test.h"
#include "test1.h"
#include "test2.h"
#include "test3.h"

string *fetch_num(int);
void clear_ans_mode();

void create() {
  set_name(HIR "笔试监考官" NOR, ({ "exam inspector", "inspector", "teacher", "kaoguan", "jiaoshi" }));
  set("gender", "男性");
  set("age", 45 + random(10));
  set("long",
    "他就是广大学子惧怕的考官。他阴沉着脸，正在看者你。看起\n"
    "来他的监考大法已经是登峰造极了！\n");
  set("attitude", "peaceful");

  set("chat_chance", 1);
  set("chat_msg", ({
    "考官说到：“有不明白的地方记得提问(ask)...”\n",
    "考官说道：“考试么，就是进了考场、等着答题。”\n",
    "考官看了看你，小声嘀咕着：“小心别让我抓到！”\n",
    "考官说道：“认真答题才能早成大侠。”\n",
    //      (: random_move :),
  }));

  set("inquiry", ([
    "test": "用 test 发题,然后 answer 数字\n",
    "name": "老夫姓名并不重要，你还是好好答题罢！\n",
    "考试": "用 test 发题,然后 answer 数字\n",
    "作弊": "去死！作弊的一律给零蛋。\n",
    "抄袭": "真没出息，除了这个你还会什么啊？\n",
    "answer": "孺子可教，answer是用来答题的，用test来考试。\n",
  ]));

  setup();

  carry_object("/clone/cloth/cloth")->wear();
}

void init() {
  add_action("do_test", ({ "kaoshi", "test" }));
  add_action("do_answer", ({ "answer", "huida", "da" }));
}

string *fetch_num(int i) {
  switch (random(4)) {
    case 0:
      switch (i) {
        case 0: return N0;
        case 1: return N1;
        case 2: return N2;
        case 3: return N3;
        case 4: return N4;
        case 5: return N5;
        case 6: return N6;
        case 7: return N7;
        case 8: return N8;
        case 9: return N9;
      }
    case 1:
      switch (i) {
        case 0: return N10;
        case 1: return N11;
        case 2: return N12;
        case 3: return N13;
        case 4: return N14;
        case 5: return N15;
        case 6: return N16;
        case 7: return N17;
        case 8: return N18;
        case 9: return N19;
      }
    case 2:
      switch (i) {
        case 0: return N20;
        case 1: return N21;
        case 2: return N22;
        case 3: return N23;
        case 4: return N24;
        case 5: return N25;
        case 6: return N26;
        case 7: return N27;
        case 8: return N28;
        case 9: return N29;
      }
    case 3:
      switch (i) {
        case 0: return N30;
        case 1: return N31;
        case 2: return N32;
        case 3: return N33;
        case 4: return N34;
        case 5: return N35;
        case 6: return N36;
        case 7: return N37;
        case 8: return N38;
        case 9: return N39;
      }
  }
}

int do_test(string arg) {
  object me, ob;
  int i;
  string *x0, *x1, *x2, *x3, *x4, *x5, *x6, *x7, ans;

  me = this_player();
  ob = this_object();

  if (!me || !environment(me)) return 1;
  if (me->is_busy() || me->is_fighting())
    return notify_fail("你都快要忙死了，还考什么考？\n");
  if (ob->is_fighting())  // || ob->is_busy() ??
    return notify_fail("考官现在没有功夫理你。\n");
  if (ob->query_temp("test"))
    return notify_fail("已经出了题了，快点答吧。\n");
  if (me->query("sen") < Q_JING) {
    write("你已经累得头晕眼花了。\n");
    return 1;
  }
  if (me->query("kee") < Q_QI) {
    write("你已经太累了。\n");
    return 1;
  }

  me->start_busy(BUSY_TIME);
  ob->start_busy(BUSY_TIME);

  me->add("sen", -Q_JING);
  me->add("kee", -Q_QI);

  ans = "";
  x0 = fetch_num(i = random(10)); ans = ans + i;
  x1 = fetch_num(i = random(10)); ans = ans + i;
  x2 = fetch_num(i = random(10)); ans = ans + i;
  x3 = fetch_num(i = random(10)); ans = ans + i;
  x4 = fetch_num(i = random(10)); ans = ans + i;
  x5 = fetch_num(i = random(10)); ans = ans + i;
  x6 = fetch_num(i = random(10)); ans = ans + i;
  x7 = fetch_num(i = random(10)); ans = ans + i;

  DEBUG(wizardp(me), "DEBUG: answer " + ans + "\n");

  ob->set_temp("test/answer", ans);
  me->set_temp("test/wrong", 0);
  write("出题啦：\n");

  if (random(2) == 0) {
    for (i = 0; i < Y; i++) {
      write(x0[i] + x1[i] + x2[i] + x3[i] + x4[i] + x5[i] + x6[i] + x7[i] + "\n");
    }
    ob->set_temp("test/factor", EASY_FACTOR);  //normal reward.
  } else {
    for (i = 0; i < Y; i++)
      write(x0[i] + x1[i] + x2[i] + x3[i] + "\n");
    write("\n");
    for (i = 0; i < Y; i++)
      write(x4[i] + x5[i] + x6[i] + x7[i] + "\n");
    ob->set_temp("test/factor", HARD_FACTOR);  //hard to make robot.
  }

  write("用 " + HIY + "answer 阿拉伯数字" + NOR + " 答题。\n");

  remove_call_out("wait_time");
  call_out("clear_ans_mode", WAIT_TIME);
  return 1;
}

void clear_ans_mode() {
  object ob = this_object();
  object me = this_player();

  if (!me || !ob || !environment(me)) return;

  write("考官说道：“时间到了，停止答题！\n");
  ob->delete_temp("test");
  me->delete_temp("test");
  return;
}



int do_answer(string arg) {
  int kar, iq, per, cps, reward_exp, reward_pot;
  object me = this_player();
  object ob = this_object();

  if (!me || !ob || !environment(me)) return 1;
  if (me->is_fighting())  //me->is_busy()|| ... ??
    return notify_fail("你都快要忙死了，还考什么考？\n");
  if (ob->is_fighting())
    return notify_fail("考官现在没有功夫理你。\n");
  if (!ob->query_temp("test"))
    return notify_fail("用test或者kaoshi来开始考试。\n");

  kar = me->query("kar");
  per = me->query("per");
  cps = me->query("cps");
  iq = me->query_skill("literate", 1);

  //均衡 lit 水准
  if (iq < 50) iq = 100;
  else if (iq < 100) iq = 150;
  else if (iq < 250) iq = 225;
  else if (iq < 500) iq = 300;
  else if (iq < 750) iq = 400;
  else if (iq < 1000) iq = 500;
  else
    iq = 600;

  reward_exp = kar + cps + random(iq) / 2;
  reward_pot = reward_exp / (2 + random(4)) + (me->query("gender") == "女性" ? per / 3 : 0);

  reward_pot *= ob->query_temp("test/factor");
  reward_exp *= ob->query_temp("test/factor");

  if (ob->query_temp("test/answer") == arg) {  //correct!
    me->add("combat_exp", reward_exp);
    me->add("potential", reward_pot);

    write("考官说道：" + me->name() + "答对了！\n", ({ me }));
    write("答对了！你得到" + reward_exp + "点经验，" + reward_pot + "点潜能。\n");

    ob->delete_temp("test");
    me->delete_temp("test");
    remove_call_out("clear_ans_mode");
  } else {  //got an incorrect answer.
    //ob->command("shy "+me->query("id"));
    write(me->name() + "！别在这里瞎掰，你的答案不对。\n");
    me->add_temp("test/wrong", 1);
    if (me->query_temp("test/wrong") == 2) {
      reward_exp = (me->query("combat_exp") - reward_exp >= 0) ? reward_exp : 0;
      reward_pot = (me->query("potential") - reward_pot >= 0) ? reward_pot : 0;

      me->add("combat_exp", -reward_exp * PENALTY_FACTOR);
      me->add("potential", -reward_pot * PENALTY_FACTOR);
      write(HIR "你答错的次数太多了!" NOR);
      write(HIY "你被罚掉" + reward_exp + "点经验，" + reward_pot + "点潜能。\n" NOR
      );
      ob->delete_temp("test");
      me->delete_temp("test");
      remove_call_out("clear_ans_mode");
    }
  }
  return 1;
}
