#include "/u/fly/where/npc/qiangdao.h"
void create()
{
    set_name("强盗",({"qiang dao","qiangdao","dao"}));
    set("title","欺压百姓的");
    set("age",20+random(80));
    set("name2",query("name"));
    set("title2",query("title"));
    set("id2",query("id"));

    set("attitude","heroism");
    set("chat_chance", 5);
    setup();
}

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;
        int exp;

        set("family/family_name","逍遥山庄");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);

        me->set_skill("sword", j+random(5));
        me->set_skill("zhuihun-sword", j+random(5));
        me->set_skill("mohuan-xuying", j+random(5));
        me->set_skill("wuqinxi", j+random(5));
        me->set_skill("fentian-mogong", j+random(5));
        me->set_skill("seashentong", j+random(5));
        me->map_skill("force", "fentian-mogong");
        me->map_skill("sword", "zhuihun-sword");
        me->map_skill("parry", "zhuihun-sword");
        me->map_skill("spells", "seashentong");
        me->map_skill("dodge", "mohuan-xuying");
        me->map_skill("unarmed", "wuqinxi");

        exp=me->query("combat_exp");
        set("chat_chance_combat",level);
        set("chat_msg_combat", ({
            (: cast_spell, "freez" :),
            (: cast_spell, "breathe" :),
          }) );
             weapon=new("/d/obj/weapon/sword/ziying-sword");
             weapon->set("no_get",1);
             weapon->set("no_sell",1);
             weapon->set("no_drop",1);
             weapon->set("no_give",1);
             weapon->move(me);
             command("wield all");
}

