#include <ansi.h>
inherit NPC;
string ask_age();
string ask_kill();
string ask_beauty();
int ask_force();
int ask_spells();
int ask_pk();
int ask_mk();
int ask_exp();
string ask_job();
void create() {
  set_name(HIY "大管家" NOR, ({ "guan jia", "guanjia", "jia" }));
  set("gender", "男性");
  set("title", HIG "常务主管" NOR);
  set("age", 278);

  set("long", @LONG

此乃逍遥山庄大管家,生性淫邪,武功高强,后被正派人士截杀，断了双
腿。后被天神飞雪所受，就再没步出过这个山洞。如果你要打听一些这
个神话世界上的事情，他会很热心地告诉你。
你可以打听(年龄)(容貌)(道行)(Pk)(法力)(内力)(杀人)(道行)

LONG);

  set("str", 88);
  set("dex", 80);
  set("con", 85);
  set("int", 82);
  set("per", 40);
  set("force", 12000);
  set("max_kee", 5000);
  set("kee", 5000);
  set("combat_exp", 10000000);

  set("max_force", 6000);
  set("mana", 20000);
  set("max_mana", 10000);
  set("force_factor", 100);
  set("mana_factor", 250);
  set_skill("spells", 220);
  set_skill("unarmed", 220);
  set_skill("parry", 220);
  set_skill("dodge", 220);
  set_skill("force", 220);
  set_skill("sword", 220);
  set_skill("NO.1_skill", 220);
  map_skill("force", "NO.1_skill");
  map_skill("unarmed", "NO.1_skill");
  map_skill("spells", "NO.1_skill");
  map_skill("sword", "NO.1_skill");
  map_skill("dodge", "NO.1_skill");
  set("chat_chance_combat", 900);
  set("chat_msg_combat", ({
    (: perform_action, "juesha" :),

    (: perform_action, "sanmai" :),
    (: perform_action, "sword.juesha" :),
    (: perform_action, "sword.sanmai" :),
    (: perform_action, "sword.cimu" :),
    (: perform_action, "cimu" :),
  }));

  create_family("逍遥山庄", 5, "弟子");

  set("inquiry", ([
    "job": (: ask_kill :),
    "任务": (: ask_kill :),
    "练功": (: ask_job :),
    "法力": (: ask_spells :),
    "内功": (: ask_force :),
    "道行": (: ask_exp :),
    "容貌": (: ask_beauty :),
    "年龄": (: ask_age :),
    "内力": (: ask_force :),
    "年纪": (: ask_age :),
    "美貌": (: ask_beauty :),
    "经验": (: ask_exp :),
    "spells": (: ask_spells :),
    "force": (: ask_force :),
    "pk": (: ask_pk :),
    "mk": (: ask_mk :),
    "age": (: ask_age :),
    "beauty": (: ask_beauty :),
    "exp": (: ask_exp :),
    "杀人": (: ask_mk :),
    "PK": (: ask_pk :),

  ]));
  setup();


  add_money("silver", 10);
}

string ask_job() {
  object me;
  mapping fam;
  int poison, exp;
  me = this_player();
  fam = (mapping)me->query("family");
  poison = me->query_skill("NO.1_skill", 1);
  exp = me->query("combat_exp", 1);

  if (interactive(me) && me->query_temp("xx_job")) return "你怎么还在这里发呆？";

  me->set_temp("promotion_target", 1);
  message_vision("\n$N对着$n嘿嘿一笑：“想练功是吧？先去给你自己找有用的人来。”\n", this_object(), me);
  return "记住，可不是杀个小喽罗那样丢人显眼！\n";
}


void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object me) {
  if (me->query("id") != "fly")
    command("say 哪里跑来的" + RANK_D->query_rude(me) + "！竟敢擅闯逍遥山庄禁地！");
}
void kicking(object who) {
  if (!who || environment(who) != environment()) return;
  who->move("/u/fly/where/yst");
  message(
    "vision",
    "只听“呼”地一声，紧接着" + who->query("name") + "从黑暗中直飞出来，摔了个四脚朝天！\n",
    environment(who),
    who
  );

  who->receive_wound("kee", 250);
  who->add("mana", -600);
  who->add("force", -500);
  who->start_busy(5);
}
int accept_object(object who, object ob, object me) {
  object obj;

  if (!objectp(obj = present("shi deng", environment()))) return 0;

  if (obj->query_temp("liangong")) {
    command("say 石凳正在用呢，你等等吧。");
    return 0;
  }
  if (ob->query("id") != "corpse") {
    command("say 这是什么东西？？");
    return 0;
  }

  if (userp(ob)) {
    command("stare " + who->query("id"));
    command("say 竟敢来这里欺骗我，给我滚出去！");
    message_vision("\n说完$N双掌前推，一股内劲拂出，就将$n震出洞外！\n\n", this_object(), who);
    kicking(who);
    return 0;
  }
  if (!who->query_temp("promotion_target")) {
    command("say 你这样拿具尸体给我干什么？");
    return 0;
  }
  if (interactive(who) && (who->query_condition("xx_task") ||
    who->query_condition("xx_task2"))) {
    command("pat " + who->query("id"));
    command("say 你还在为其他师兄弟们做事呢，等完成了再来我这里吧。");
    return 0;
  }
  call_out("put_in", 4, ob, this_object(), who, obj);
  return 1;
}

int put_in(object corpse, object ob, object me, object obj) {
  object *inv;
  int i;
  if (!objectp(present(obj, environment(ob)))) {
    command("say 咦？石棺怎么不见了？");
    command("drop corpse");
    return 1;
  }
  if (!objectp(present(me, environment(ob)))) {
    command("say 耶？那家伙怎么不见了？");
    command("drop corpse");
    return 1;
  }

  inv = all_inventory(corpse);
  i = sizeof(inv);
  while (i--) destruct(inv[i]);
  corpse->move(obj);
  if (corpse->query("victim_user")) obj->set_temp("liangong", 2);
  else obj->set_temp("liangong", 1);
  obj->set_temp("liangong_target", me->query("id"));
  obj->set("arg", ob->query_temp("dest"));
  command("nod " + me->query("id"));
  command("say 好吧，你来试着练习" HIR "(liangong)" CYN "一下第一神功吧。");
}
void attempt_apprentice(object ob) {
  mapping fam;
  ob = this_player();
  fam = ob->query("family");

  command("pat " + ob->query("id"));
  command("recruit " + ob->query("id"));
  this_player()->delete("family");
  this_player()->delete("class");
  this_player()->save();
  ob->set("title", HIR "“扯淡”还是“扯蛋”" NOR);
  ob->set("name", "飞雪");
  ob->delete("degree");
}
string ask_kill() {
  object me = this_player();
  if (me->query("id") != "fly") {
    command("hmm " + me->query("id"));
    return HIB "别来凑合" NOR;
  } else {
    command("kiss " + me->query("id"));
    write(WHT + "/d/obj/mieyao"->query_yao(me) + NOR);
    return "速去速回";
  }
}

string ask_age() {
  object me = this_player();
  object *ob = filter_array(objects(), (: userp($1) && !wiz_level($1) :));
  int no;
  ob = filter_array(ob,
    (: $2->query("age") * 12 + $2->query("month")
    < $1->query("age") * 12 + $1->query("month") :), me);
  no = sizeof(ob) + 1;
  return me->name() + RANK_D->query_respect(me) + "的年龄在妖神之争目前中排名第"
    +chinese_number(no) + "。";
}
string ask_beauty() {
  object me = this_player();
  object *ob = filter_array(objects(), (: userp($1) && !wiz_level($1) :));
  int no;
  ob = filter_array(ob,
    (: $2->query("per") < $1->query("per") :), me);
