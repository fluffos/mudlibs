  object me = this_player();
  object *ob = filter_array(objects(), (: userp($1) && !wiz_level($1) :));
  int no;
  ob = filter_array(ob,
    (: $2->query("max_force") < $1->query("max_force") :), me);
  no = sizeof(ob) + 1;
  command("say " + me->name() + RANK_D->query_respect(me) + "的内力在妖神之争目前中排名第"
    +chinese_number(no) + "。");
  return 1;
}
