    "north": __DIR__ "workhome",
  ]));

  set("item_desc", ([
    "tree": "一棵大树，枝叶茂密，看不清上面的情况。枝头挂满了桃子，已经熟地要掉下来了。\n",
    "leaf": "树叶松松地挂在树上，看上去很想把它摘下来。\n",
