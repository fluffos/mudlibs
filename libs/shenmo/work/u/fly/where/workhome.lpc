#include <ansi.h>
#include <room.h>
#include <login.h>
inherit ROOM;
int do_dig(string arg);

void create() {
  set("short", HIM + FLA "逍遥小居" NOR);
  set("long", @LONG

    这里就是飞雪的休息所在

LONG);
  set("objects", ([
    __DIR__ "obj/shiguan": 1,
    __DIR__ "npc/guanjia2": 1,
    __DIR__ "npc/guanjia": 1,
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "down": __DIR__ "rumorcenter",
    "up": "/d/wiz/wizroom",
    "south": __DIR__ "yst",
  ]));
  setup();
}

void init() {
  add_action("do_dig", "dig");
}
int do_dig(string arg) {
  object ob = this_player();
  object wield;
  object sword = new("/d/obj/weapon/sword/doublesword");
  if (!arg || arg != "di")
    return notify_fail("命令指示:应该挖地,你在干吗呀.\n");
  if (ob->query_temp("sword_find"))
    return notify_fail("你怎么这么贪心。\n");
  ob->add("kee", -50);
  if (random(6) == 3) {
    message_vision("$N用力挖了一会，突然感觉有个东西埋在地下。\n", ob);
    message_vision("$N居然在这里能发现紫青双剑。\n", ob);
    sword->move(ob);
    message(
      "channel:rumor",
      HIM + "【谣言】某人：" NOR + ob->query("name") + HIM "在" NOR + FLA + HIR "逍遥小屋" NOR + HIM "拿到了传奇中的" NOR + HIC "紫青双剑" NOR + HIM "。\n" NOR,
      users()
    );
    ob->set_temp("sword_find", 1);
    return 1;
  }
  message_vision("$N费了大办天的劲，什么也没有挖到。\n", ob);
  return 1;
}
int valid_leave(object me, string dir) {
  if (me->query("id") != "fly" && dir == "up")
    return notify_fail("旁边大管家拦住了你：哼，这里去不得！\n");
  if (me->query("id") != "fly" && dir == "north")
    return notify_fail("旁边大管家拦住了你：哼，这里去不得！\n");
  return ::valid_leave(me, dir);
}
