//super guard
//可能会有bug哦  -_-!
//除非修改地层
#include <ansi.h>
inherit SSERVER;

int cast(object me, object target)
{
object guard;   
string msg;
int damage, ap,time;

if ( time()<me->query_temp("psd_cast_ying/time")+me->query_temp("psd_cast_ying/start") )
        return notify_fail("你刚刚呼唤过「魅影护法」！\n");

if ( me->query("叛师/num") )
        return notify_fail("你三心二意，哪可能呼唤出「魅影护法」！\n");

if ( me->query_skill("pansi-dafa",1)<200 )
        return notify_fail("你的盘丝大法不够200级，哪可能呼唤出「魅影护法」！\n");
        
if ( me->query("family/family_name")!="盘丝洞" )
        return notify_fail("只有盘丝洞门人才可以用！\n");  

if ( me->query("mana")<me->query("max_mana") )
        return notify_fail("你的法力不够，呼唤出「魅影护法」恐怕也没有什么用！\n");

if ( me->query("force")<me->query("max_force") )
        return notify_fail("你的内力不够，呼唤出「魅影护法」恐怕也没有什么用！\n");

if ( me->query("mana_factor")<me->query_skill("spells")-20 )
        return notify_fail("你的法术加力不够，呼唤出「魅影护法」恐怕也没有什么用！\n");

if ( me->query("sen")<500 )
        return notify_fail("你现在神智不清！\n");

if ( !target ) 
        target = offensive_target(me);

if ( !target
   ||!target->is_character()
   || target->is_corpse()
   || !target->is_fighting(me) )
        return notify_fail("你要对谁施「魅影重重」？\n");

me->add("mana",-me->query("max_mana")/5);
me->receive_damage("sen",300);

time = me->query_skill("spells");
time/= 50;
time+= me->query("mana")/500;
time = time/2+random(time/2);
if ( time>60 )
        time = 60;
if ( time<5 )
        time = 5;       

msg = HIR "\n$N"HIR"口中念了几句咒文，四周顿时一片寂然！\n"NOR;
message_vision(msg,me,target);
me->set_temp("psd_cast_ying",([
        "start" : time(),
        "time"  : time,
]));    

guard = new("/d/wiz/obj/jiashen");
if ( guard->announce(target) )
        {
        tell_object(target,HIR"你只觉四下立时变得生气全无，一眼望去，只觉一片寂静的虚无！\n"NOR);
        message("vision",HIR+target->name()+HIR"立刻被一层死气包裹起来，消失在幽黑的虚无之中！\n"NOR,environment(target),target);
        message_vision(HIY"\n\n“轰隆”一声，两道人影从虚无中跌将出来！\n\n"NOR,me,target);
        guard->set("leave_msg",HIR"$N"HIR"浑身泛起一道红光，顿时消失不见。。。\n\n"NOR);
        guard->set("护法",([
                "start" : time(),
                "master": me,
                "time"  : time,
        ]));
        guard->move(environment(target));
        guard->powerup();       
        guard->kill_ob(target);
        SDS_D->randomPfm(guard);
        return 1;
        }       
else    {
        message_vision(HIY"\n$n"HIY"将手一挥，打散了$N"HIY"的咒语！\n"NOR,me,target);
        target->command("say 雕虫小技也拿来献丑！！");
        me->command("inn");
        return 1+random(3);
        }
}

