//Cracked by Roath
// bank.c
//snowtu修改负重溢出的bug
#include <ansi.h>
inherit ROOM;

string money_str(int amount);
int pay_player(object who, int amount);

void init()
{
add_action("do_convert", "convert");
add_action("do_deposit", "deposit");
add_action("do_check", "account");
add_action("do_withdraw", "withdraw");
}

void do_jail(object who)
{
if ( !who || !userp(who) )
        return; 
message("shout",HIW"阿浓纵声长啸："+who->query("id")+"试图影响游戏的公正性，特打入死牢，等巫师发落！\n"NOR,users());
who->set("作弊"," "+ctime(time())+"试图使用负重的Bug刷钱. \n");
who->move("/d/wiz/punish");
return;
}
        
int do_convert(string arg)
{
string from, to;
int amount, bv1, bv2;
object from_ob, to_ob,me=this_player();

if ( !arg || sscanf(arg, "%d %s to %s", amount, from, to)!=3 )
        return notify_fail("指令格式：convert <数量> <货币种类> to <货币种类>\n");
if ( this_player()->is_busy() )
        return notify_fail("你现在正忙着呢...。\n");
if ( from=="jinbi" && to!="gold" )
        return notify_fail("金币只能兑换成黄金。\n");
if ( from=="jinbi" && amount>10 )                
        return notify_fail("金币每次只能兑换十枚。\n");
from_ob = present(from + "_money", this_player());
to_ob = present(to + "_money", this_player());
if ( !to_ob && file_size("/obj/money/" + to + ".lpc")<0 )
        return notify_fail("你想兑换哪一种钱？\n");
if( !from_ob || file_size("/obj/money/" + from + ".lpc")<0 )
        return notify_fail("你身上没有这种货币。\n");
if ( amount<1 )
        return notify_fail("兑换货币一次至少要兑换一个。\n");
if ( from_ob->query_amount() < amount )
        return notify_fail("你身上没有那么多" + from_ob->query("name") + "。\n");

bv1 = from_ob->query("base_value");
if ( !bv1 ) 
        return notify_fail("这种东西不值钱。\n");
bv2 = to_ob ? to_ob->query("base_value") : call_other("/obj/money/" + to, "query", "base_value" );
if ( bv1<bv2 ) 
        amount -= amount % (bv2 / bv1);
if ( !amount ) 
        return notify_fail("这些" + from_ob->query("name") + "的价值太低了，换不起。\n");
        
this_player()->start_busy(1);
to_ob = new("/obj/money/" + to);
to_ob->set_amount(amount * bv1 / bv2);
if ( to_ob->query_encumbrance()+me->query_encumbrance()>=me->query_max_encumbrance() )
        {
        do_jail(me);
        return 0;
        }
if ( !(to_ob->move(this_player())) )
        return 0;
message_vision( sprintf("$N从身上取出%s%s%s，换成%s%s%s。\n",
                chinese_number(amount), from_ob->query("base_unit"), from_ob->query("name"),
                chinese_number(amount * bv1 / bv2), to_ob->query("base_unit"), to_ob->query("name")),
                this_player() );
if( (int)from_ob->query_amount() == amount )
        destruct(from_ob);
else    from_ob->add_amount(-amount);
this_player()->save();
return 1;
}

int do_deposit(string arg)
{
string what;
int amount;
object what_ob, me;

me = this_player();

if (!arg || sscanf(arg,"%d %s",amount,what)!=2 )
        return notify_fail("命令格式：deposit <数量> <货币单位>\n");
if ( me->is_busy() )
        return notify_fail("你现在正忙着呢...。\n");
what_ob = present(what + "_money", me);
if ( !what_ob )
        return notify_fail("你身上没有带这种钱。\n");
if ( amount<1 )
        return notify_fail("你想存多少" + what_ob->query("name") + "？\n");
if ( what_ob->query_amount()<amount )
        return notify_fail("你带的" + what_ob->query("name") + "不够。\n");
if ( me->query("balance")>19000000000 )
        return notify_fail("你钱庄的钱太多了，做做善事吧。\n");        
me->start_busy(1);
message_vision(sprintf("$N拿出%s%s%s，存进了钱庄。\n",
                chinese_number(amount), what_ob->query("base_unit"),
                what_ob->query("name")), me);
me->add("balance", what_ob->query("base_value") * amount);
if ( what_ob->query_amount()==amount )
        destruct(what_ob);
else    what_ob->add_amount(-amount);
me->save();
return 1;
}

int do_check()
{
int total = (int)this_player()->query("balance");
if ( !total || total < 0)  
        {
        this_player()->set("balance", 0);
        return notify_fail("您在敝银庄没有存钱。\n");
        }
write("您在敝银庄共存有" +money_str(total) + "\n");
return 1;
}

int do_withdraw(string arg)
{
int amount, v, rv;
string what;
object me;

me = this_player();

if ( !arg || sscanf(arg,"%d %s",amount,what)!=2 )
        return notify_fail("命令格式：withdraw <数量> <货币单位>\n");
if ( me->is_busy() )
        return notify_fail("你现在正忙着呢...。\n");
if ( amount<1 )
        return notify_fail("你想取出多少钱？\n");
if ( file_size("/obj/money/" + what + ".lpc") < 0)
        return notify_fail("你想取出什么钱？\n");
what = "/obj/money/" + what;
if ((v = amount * what->query("base_value")) > me->query("balance"))
        return notify_fail("你存的钱不够取。\n");
if ( v<what->query("base_value") )
        {
        do_jail(me);
        return notify_fail("Don't try, or I will purge you!\n");
        }
me->start_busy(1);
rv = v;
v=v-pay_player(me, rv);
me->add("balance",  -v);
me->save();
message_vision(sprintf("$N从银号里取出%s。\n", money_str(v)),me);
return 1;
}

string money_str(int amount)
{        
string output;
if ( amount/10000 ) 
        {
        output = chinese_number(amount / 10000) + "两黄金";
        amount %= 10000;
        }
else    output = "";
if ( amount/100 ) 
        {
        output = output + chinese_number(amount / 100) + "两白银";
        amount %= 100;
        }
if (amount || sizeof(output)<2)
        return output + chinese_number(amount) + "文铜板";
return output;
}

int pay_player(object who, int amount)
{
int v;
object ob;

seteuid(getuid());
if (amount < 1)
        amount = 0;
if (v = amount / 10000) 
        {
        ob = new("/obj/money/gold");
        ob->set_amount(amount/10000);
        if ( ob->query_encumbrance()+who->query_encumbrance()>=who->query_max_encumbrance() )
                {
                write("你身上装不了这么重的东西。\n");
                return 0;
                }               
        if ( !ob->move(who) )
                return amount;
        amount %= 10000;
        }
if ( amount/100 ) 
        {
        ob = new("/obj/money/silver");
        ob->set_amount(amount / 100);
        if ( ob->query_encumbrance()+who->query_encumbrance()>=who->query_max_encumbrance() )
                {
                write("你身上装不了这么重的东西。\n");
                return 0;
                }               
        if ( !ob->move(who) )
                return amount;
        amount %= 100;
        }
if (amount) 
        {
        ob = new("/obj/money/coin");
        ob->set_amount(amount);
        if ( ob->query_encumbrance()+who->query_encumbrance()>=who->query_max_encumbrance() )
                {
                write("你身上装不了这么重的东西。\n");
                return 0;
                }               
        if ( !ob->move(who) )
                return amount;
        }
return 0;
}

