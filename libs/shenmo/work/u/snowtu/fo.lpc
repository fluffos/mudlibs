inherit NPC;

string check_lianhua();
private int update_player(object me);

void create() {
  set_name("如来佛", ({ "rulaifo", "fo zu", "fo" }));
  set("title", "佛祖多陀阿伽陀");
  set("long", "大慈大悲灵山雷音古刹佛祖多陀阿伽陀如来佛爷。\n");
  set("gender", "男性");
  set("age", 10000);
  set("attitude", "peaceful");
  set("rank_info/self", "贫僧");
  set("rank_info/respect", "佛祖爷爷");
  set("str", 100);
  set("per", 100);
  set("max_kee", 10000);
  set("max_gin", 10000);
  set("max_sen", 10000);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 500);
  set("max_mana", 10000);
  set("mana", 10000);
  set("mana_factor", 500);
  set("combat_exp", 4000000);
  set("daoxing", 10000000);

  set_skill("literate", 300);
  set_skill("spells", 300);
  set_skill("buddhism", 300);
  set_skill("unarmed", 300);
  set_skill("jienan-zhi", 300);
  set_skill("dodge", 300);
  set_skill("lotusmove", 300);
  set_skill("parry", 300);
  set_skill("force", 300);
  set_skill("lotusforce", 300);
  set_skill("staff", 300);
  set_skill("lunhui-zhang", 300);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "lunhui-zhang");
  map_skill("staff", "lunhui-zhang");
  set("inquiry", ([
    "莲花": (: check_lianhua :),
  ]));
  setup();
  carry_object("/d/obj/cloth/jia_sha")->wear();
}

string check_lianhua() {
  mapping data1, data;
  int i;
  string dir, f, *file, str1, str2, str3, str4;
  object me = this_player();

  if (!userp(me))
    return 0;
  data1 = me->query("莲花");
  if (!data1 || !mapp(data1))
    return "相传佛门湿婆修悟之时，种下一池白莲而炼化为宝。今其座下各天神尚携此法宝云游人间。";
  set("莲花_" + me->query("id"), data1);
  data = ([]);
  dir = me->query("id");
  dir = "/c/莲花/" + dir + "/";
  file = get_dir(dir);
  if (!file || !arrayp(file)) {
    me->delete("莲花");
    return "你所存莲花皆已不在，贫僧只得将其去除。";
  }
  i = sizeof(file);
  while (i--) {
    f = file[i];
    if (!f || !stringp(f))
      continue;
    if (wizardp(me))
      write("file===" + f + "\n");
    if (sscanf(f, "%s.o", f) != 1)
      continue;
    if (sscanf(f, "%s+%s+%s+%s", str1, str2, str3, str4) == 4) {
      if (wizardp(me))
        tell_object(
          me,
          sprintf("%s 设置完毕\n%s 设置完毕\n%s 设置完毕\n%s 设置完毕\n%s 设置完毕\n", str1, str2, str3, str4, f)
        );
      data[str1] = 2;
      data[str2] = 2;
      data[str3] = 2;
      data[str4] = 2;
      data[f] = 1;
    } else if (sscanf(f, "%s+%s", str1, str2) == 2) {
      if (wizardp(me))
        tell_object(me, sprintf("%s 设置完毕\n%s 设置完毕\n%s 设置完毕\n", str1, str2, f));
      data[str1] = 2;
      data[str2] = 2;
      data[f] = 1;
    } else {
      if (wizardp(me))
        tell_object(me, sprintf("%s 设置完毕\n%s", f));
      data[f] = 1;
    }
  }
  me->set("莲花", data);
  return "你的莲花记录已经修正完毕。";
}

void die() {
  if (environment())
    message("sound", "\n\n如来缓缓一点头：佛法无边！\n\n", environment());
  powerup();
}

void unconcious() {
  die();
}

int accept_object(object me, object ob) {
  if ((string)ob->query("id") == "qiankun-tu") {
    if ((string)me->query("xiuluo/give_rulai") == "done")
      return notify_fail("如来佛说道：你已经得到惩罚了!\n");
    if ((string)me->query("xiuluo/jinchanzi") != "done")
      return notify_fail("如来佛说道：这图是你的吗?!\n");
    command("chat " + me->query("name") + "你居然如此胆大妄为！\n");
    command("chat 看来你多年修成的正果只有白费了！\n");
    tell_object(me, "\n如来佛大袖朝你一拂...\n\n你好象已经忘记了以前的记忆。\n\n");
    command("rumor 听说" + me->query("name") + "被如来佛祖毁了西天修行！");
    me->delete("obstacle");
    me->set("xiuluo/give_rulai", "done");
    update_player(me);
    me->save();
    return 1;
  }
  return 0;
}

private int update_player(object me) {
  object env, link_ob, obj;
  object *ob, *dob;
  mapping equip;
  int i;


  seteuid(getuid());
  env = environment(me);

  // First, create the new body.
  link_ob = me->query_temp("link_ob");
  if (!link_ob) {
    link_ob = new(LOGIN_OB);
    link_ob->set("id", me->query("id"));
    if (!link_ob->restore())
      return 1;
    if (interactive(me))
      link_ob->set_temp("ip_number", query_ip_number(me));
  }

  if (link_ob->query("id") != getuid(me)) {
    write(sprintf("连接对象的ID(%s)和用户的ID(%s)不相同，不能"
      "更新该玩家。\n", link_ob->query("id"), getuid(me)));
    return 1;
  }

  obj = LOGIN_D->make_body(link_ob);
  if (!obj) return 0;

  // Save the data and exec the player to his/her link object.
  ob = all_inventory(me);
  equip = ([]);
  for (i = 0; i < sizeof(ob); i++)
    equip += ([ ob[i]: ob[i]->query("equipped") ]);
  ob->move(VOID_OB);
  me->save();
  if (interactive(me))
    exec(link_ob, me);
  destruct(me);
  obj->restore();
  LOGIN_D->enter_world(link_ob, obj, 1);
  dob = all_inventory(obj);
  for (i = 0; i < sizeof(dob); i++)
    destruct(dob[i]);

  obj->move(env);
  ob->move(obj);

  if (!interactive(obj))
    destruct(link_ob);

  for (i = 0; i < sizeof(ob); i++) {
    if (equip[ob[i]] == "worn")
      ob[i]->wear();
    if (equip[ob[i]] == "wielded")
      ob[i]->wield();
  }
  obj->write_prompt();
  return 1;
}
