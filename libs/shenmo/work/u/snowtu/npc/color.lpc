#include <ansi.h>
inherit NPC;

string check_me();
//void title_color(object me);

void create()
{
set_name("智慧老人",({"zhihui laoren","laoren","ren"}));
set("age",100);
set("gender","男性");
set("per",30);
set("long","一位活了百岁的老爷爷，看起来懂的东西比别人多一些。\n");
set("nick",HIG"想换颜色，找我打听"NOR);
set("title","人间百岁翁");
set("inquiry",([
        "name" : "老朽年迈，早将年岁忘记了。",
        "here" : "皆是浮云耳....",
        "颜色" : (: check_me : )
]));
setup();
carry_object("/d/obj/cloth/baipao")->wear();
}

string check_me()
{
object me = this_player();
if ( !me->query_temp("color_gived") )
        return "你先将身上的阿堵物给我一些....";
me->delete_temp("color_gived");
me->set_temp("color_asked",1);
say(CYN+name()+CYN"说道：如果你想改做表情时姓名的颜色，用 name <颜色代码>。\n"NOR);
say(CYN+name()+CYN"顿了顿....\n"NOR);
say(CYN+name()+CYN"接着说：比如 name HIG 即是绿色....\n"NOR);
return "如果你想在chat时加上修饰，请同意(agree) ....";
}

void init()
{
add_action("do_color","name");
add_action("do_agree","agree");
add_action("do_bian","bian");
}

int do_bian(string arg)
{
if ( id(arg) )
   {
   message_vision(HIR"$N立刻变了脸色，对着$n"HIR"喝道：竖子敢尔！！\n"NOR,this_object(),this_player());
   this_player()->unconcious();
   command("say 又有一个不怕死的变我。。。");
   return 1;
   }
return 0;
}

int do_color(string arg)
{
object me = this_player();
if ( !arg || !me->query_temp("color_asked") )
        return 0;
me->set("name_color",arg);
if ( me->save() )
        {
        me->delete_temp("color_asked");
        tell_object(me,"你决定在表情里加上自己的颜色："+SDS_D->color_msg(arg+"颜色")+"\n");
        }
else    tell_object(me,"请注意你的格式，再试一次....\n");
return 1;
}

int do_agree()
{
object me = this_player();
if ( !me->query_temp("color_asked") )
        return 0;
tell_object(me,"你说道：我同意chat时在内容两边加上修饰....\n");
tell_object(me,name()+"点点头，道：先输入你的修饰的颜色(比如HIG表示绿色):");
input_to( (: call_other, __FILE__, "title_color", me:));
return 1;
}

void title_color(object me,string arg)
{
if ( !me )
        return;
if ( !arg )
        {
        tell_object(me,name()+"道：输入你的修饰的颜色(比如HIG表示绿色):");
        input_to( (: call_other, __FILE__, "title_color", me:));
        return;
        }
me->set("channel_title/color",arg);
if ( !me->save() )
        {
        tell_object(me,name()+"道：输入你的修饰的颜色(比如HIG表示绿色):");
        input_to( (: call_other, __FILE__, "title_color", me:));
        return;
        }
me->delete_temp("color_asked");
tell_object(me,name()+"道：输入你的修饰的开头(可以加颜色，比如HIG表示绿色):");
input_to( (: call_other, __FILE__, "add_title1", me:));
return;
}

void add_title1(object me,string arg)
{
if ( !me )
        return;
if ( !arg )
        {
        tell_object(me,name()+"道：输入你的修饰的开头(可以加颜色，比如HIG表示绿色):");
        input_to( (: call_other, __FILE__, "add_title1", me:));
        return;
        }
me->set("channel_title/title1",arg);
if ( !me->save() )
        {
        tell_object(me,name()+"道：输入你的修饰的开头(可以加颜色，比如HIG表示绿色):");
        input_to( (: call_other, __FILE__, "add_title1", me:));
        return;
        }
tell_object(me,name()+"道：输入你的修饰的结尾(可以加颜色，比如HIG表示绿色):");
input_to( (: call_other, __FILE__, "add_title2", me:));
return;
}

void add_title2(object me,string arg)
{
if ( !me )
        return;
if ( !arg )
        {
        tell_object(me,name()+"道：输入你的修饰的结尾(可以加颜色，比如HIG表示绿色):");
        input_to( (: call_other, __FILE__, "add_title2", me:));
        return;
        }
me->set("channel_title/title2",arg);
if ( !me->save() )
        {
        tell_object(me,name()+"道：输入你的修饰的结尾(可以加颜色，比如HIG表示绿色):");
        input_to( (: call_other, __FILE__, "add_title2", me:));
        return;
        }
say(name()+"点点头，拿出纸笔，在上面圈点了几下，道：可以了。。。\n");
return;
}

int accept_object(object who,object ob)
{
if ( !ob->query("money_id") )
        {
        command("pei");
        who->start_busy(10);
        return 0;
        }
if ( who->query_temp("color_gived")
  || who->query_temp("color_asked") )
        {
        say(CYN+name()+CYN"疑惑的道：你不是已经给过了吗？\n"NOR);
        who->start_busy(2);
        return 0;
        }
if ( ob->value()< 500000 )
        {
        command("say 就这么点？！唉.....");
        who->start_busy(5);
        return 1;
        }
who->set_temp("color_gived",1);
command("say 恩，不错，果然识做....");
who->start_busy(1);
return 1;
}

