#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
int max_ex,ex,lvl;
mapping my;
string msg,start_room;
if ( !me )
        return 0;
my = me->query_entire_dbase();
ex = my["level_exp"];
lvl = my["level"];
if ( lvl<5 )
        max_ex = 100;
else if ( lvl<10 )
        max_ex = 1000;
else if ( lvl<50 )
        max_ex = 10000;
else if ( lvl<100 )
        max_ex = 100000;
else if ( lvl<150 )
        max_ex = 1000000;
else if ( lvl<200 )
        max_ex = 1000000;
else    max_ex = 10000000;
if ( my["max_exp"]<max_ex )
        my["max_exp"] = max_ex;
if ( ex<max_ex )
        return 0;        

msg = HIY+@LONG

         __▁              __▁                    ___
  █     █__   █  █   █__    █        █  █  █__█
  █__▁ █__▁ ◥__◤   █__▁  █__▁    █__█  █

                %s 升级了！

LONG+NOR;
msg = replace_string(msg,"升级了！",NOR BLINK HIR"升级了！"NOR HIY);
message("vision",sprintf(msg,NOR BLINK+HIR+me->name()+NOR),environment(me),me);
tell_object(me,sprintf(msg,NOR BLINK HIR"你"NOR));
lvl++;
my["level"]=lvl;
ex = ex-max_ex;
my["level_exp"] = ex;
tell_object(me,sprintf( WHT"【"HIR"系统"NOR WHT"】"YEL"目前等级为 %d 级！\n"NOR,my["level"] ) );
me->save();
return CND_CONTINUE;
}


