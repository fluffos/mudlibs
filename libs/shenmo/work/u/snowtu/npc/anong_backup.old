#include <ansi.h>
#include <localtime.h>
#include <combat.h>
inherit NPC;
#define BACKUP_DATE     1               // the oldest's backup (days)
private int state;
#define SLEEPING        0
#define GET_READY       1
#define GET_READY_2     2
#define BACKUPING       3
#define ADM_CMD_RM      "/cmds/adm/adrm"
#define ADM_CMD_CP      "/cmds/adm/adcp"
private int *tlist = ({ 0, 925, 929, 930 });
private  int *hlist = ({ 60, 1, 1, 1 });
// 通知一次准备的时间：凌晨6:20分
// 通知再次准备的时间：凌晨6:29分
// 开始进行备份的时间：凌晨6:30分
// 凌晨五点以后到第二天凌晨6:00分之前属于休眠状态

void backup_data();
private void change_state(int new_state);
private void sys_info(string msg);
private int assure_not_exist(string bkdir);
private int is_recent_time(int y, int m, int d, int cy, int cm, int cd);
void do_chat();
int wakeup(object me,object slept,object where);
void greeting(object ob);
int do_sleep ( string arg );

// return the time of prompt
int is_backuping()
{ 
return state != SLEEPING; 
}

// return the time of backup
int query_backup_time()
{
return tlist[BACKUPING]; 
}

void create()
{
string msg;
set_name("阿浓",({"a nong"}));
set("gender", "女性" );
set("age", 18);
set("title",HIW"眠兔"NOR"的"WHT"亲亲ＧＦ"NOR);
msg = HIM+@LONG

眠兔的老婆，性情刁蛮，离开家行来行走江湖。她长
得极美，尤其是那双眼睛，媚得直可以勾人魂魄。其
容色晶莹如玉，映照于红红烛光之下，娇美不可方物。
回眸嫣然一笑，雅如仙子下凡。眼波流转之间，便把
一个少年的心灵，推向梦中极美的境界。

LONG+NOR;
set("long",msg);

set("str", 40);
set("dex", 40);
set("daoxing", 9000000);
set("con", 40);
set("int", 40);
set("per",40);
set("combat_exp", 10000000);
set("attitude", "heroism");
set("chat_chance",10);
set("chat_msg", ({
        (: do_chat :),
        (: random_move :),
}) );
set("max_kee",10000);
set("max_gin", 10000);
set("max_sen", 10000);
set("name_color","WHT");
set("force", 4000);
set("max_force", 2000);
set("force_factor", 0);
set("max_mana", 2000);
set("mana", 4000);
set("mana_factor", 0);
set("combat_exp", 5000000+random(2000000));
set_skill("dodge",900);
set_skill("parry",900);
set_skill("force",900);
set_skill("spells",900);
set_skill("fengxue-quan",900);
set_skill("unarmed",900);
set_skill("literate", 900);
set_skill("dodge", 900);
set_skill("parry", 900);
set_skill("moonshentong", 900);
set_skill("moonforce",900);
set_skill("moondance",900);
map_skill("spells", "moonshentong");
map_skill("unarmed", "fengxue-quan");
map_skill("force", "moonforce");
map_skill("parry", "fengxue-quan");
map_skill("dodge", "moondance");

seteuid(ROOT_UID);
set("channel_id", "备份精灵");
sys_info("备份系统已经启动。");
