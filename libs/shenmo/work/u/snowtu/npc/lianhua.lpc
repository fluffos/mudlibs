#include <ansi.h>
inherit NPC;

mapping lh = ([
        "kee" : "/d/snowtu/obj/armor",
        "sen" : "/d/snowtu/obj/cloth",
        "mana": "/d/snowtu/obj/shoes",
        "force":"/d/snowtu/obj/pifeng",
]);
        
string check_me()
{
object gift,*inv,me = this_player();
int i;
string type;
inv = all_inventory(me);
i = sizeof(inv);
if ( time()<me->query_temp("shipo_asked")+3600 )
  {
  me->add_temp("shipo_asked_lost",1);
  if ( me->query_temp("shipo_asked_lost")>3 )
     {
     message("channel:rumor",HIC"〖"HIG"般若摩珂"HIC"〗湿婆(Shi po)："+me->query("id")+HIC"故意取闹，天雷伺候！\n"NOR,users());
     message_vision(HIR"\n\n轰的一道天雷打在$N"HIR"头梁之上！\n\n\n"NOR,me);
     me->delete_temp("shipo_asked_lost");
     me->unconcious();
     return "哼。";
     }
   else
     return "你不是刚刚要过吗？还是等会再来吧。";
  }
while(i--)
        {
        if ( inv[i]->query("equipped") )  continue;
        type = inv[i]->query("addType");
        if ( !type || !stringp(type) || member_array(type,keys(lh))==-1 ) continue;
                gift = new(lh[type]);
        if ( gift && gift->move(me) )
                {
                say(CYN+name()+CYN"朝"+me->name()+CYN"点了点头。\n"NOR);
                message_vision("$N将身上的"+inv[i]->name()+"向$n换了一朵"+gift->name()+"。\n",me,this_object());
                destruct(inv[i]);
                }
     else continue;
        }
me->set_temp("shipo_asked",time());
return "游戏快乐。";
}

void create()
{
set_name("湿婆",({"shi po","po"}));
set("age",10000);
set("gender","中性");
set("inquiry",([
        "莲花" : (:check_me:),
]));
setup();
}

