#include <ansi.h>
inherit NPC;

nosave int time = 30;

string check_me() {
  object me = this_player();
  object ob = this_object();

  if (me->is_busy())
    return "你正忙着呢。";
  if (ob->is_busy())
    return "稍等片刻。";
  me->move("/d/wiz/gift/中秋/room.lpc");
  return "一路小心。";
}

void create() {
  set_name("阿浓", ({ "a nong", "anong" }));
  set("age", 20);
  set("gender", "女性");
  set("per", 40);
  set("int", 30);
  set("title", "眠兔的老婆");
  set("inquiry", ([
    "礼物": (: check_me :),
    "gift": (: check_me :),
  ]));
  setup();
  remove_call_out("check");
  call_out("check", 1);
}

void check() {
  remove_call_out("check");
  time--;
  if (time % 5 == 0 && time != 0)
    message(
      "channel:chat",
      sprintf(
        HIC "【" HIG "女儿界" HIC "】%s(%s)：今日在%s" HIC "，广纳贤能。。。，尚有%s秒。。。。\n" NOR,
        query("name"),
        capitalize(query("id")),
        environment()->query("short"),
        chinese_number(time)
      ),
      users()
    );
  if (time > 0)
    call_out("check", 1);
  else {
    message(
      "channel:chat",
      sprintf(
        HIG "【" HIR "女儿界" HIG "】%s(%s)：今日事毕，就此别过。。。\n" NOR,
        query("name"),
        capitalize(query("id"))
      ),
      users()
    );
    destruct(this_object());
  }
}
