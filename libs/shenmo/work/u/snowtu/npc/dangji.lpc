#include <ansi.h>
inherit NPC;

string *ids = ({
        "rocky","renzha","zcmb",
});

string dangji_gift()
{
        int x,y,i,lv;  
        object me = this_player();
        mapping skill = ([]);
        string sk,*skills;

        if( !userp(me) )
        {
                me->unconcious();
                return 0;
        }
        if( me->query("giftmark/2011shutdown")
         && me->query("giftmark/2011shutdown2") )
                return 0;
        if( this_object()->is_busy() )
                return 0;
        if( me->query("combat_exp")>1500000000 
         || me->query("daoxing")>1500000000 )
                return "你这么厉害，还是算了。";                
        if( me->query("age")<16 && me->query("zhuanshi")<1 )
                return 0;               
        skill = me->query_skills();
        if( !skill || !mapp(skill) )
                return 0;
        skills = keys(skill);
        if( !skills || !arrayp(skills) || sizeof(skills)<2 )
                return 0;
                        
        this_object()->start_busy(2);     
        if( ! me->query("giftmark/2011shutdown") )
        {
                x = 100000;
                if( member_array(me->query("id"),ids)!=-1 )
                {
                        tell_object(me,HIR"因为你对这个补偿不满意，所以补偿打八折。\n");
                        x = 80000;
                }       
                y = x+random(x);
                me->add("combat_exp",y);
                tell_object(me,HIY"你得到了"+y+"点武学经验。\n"NOR);
        
                y = x+random(x);
                me->add("daoxing",y);   
                tell_object(me,HIY"你得到了"+COMBAT_D->chinese_daoxing(y)+"道行。\n"NOR);
        
                y = 1+random(10);
                me->add("level",y);
                tell_object(me,HIY"你的等级增加了"+y+"。\n"NOR);
        
                i = 2+random(3);
                while(i--)
                {
                        sk = skills[random(sizeof(skills))];
                        if( !sk )
                                continue;
                        lv = me->query_skills()[sk];
                        lv+= 1;
                        skill[sk] = lv;
                        tell_object(me,HIY"你的「"+to_chinese(sk)+"」增加了一级。\n"NOR);
                }
                skill = ([]);
                sk = "";
                skills = ({});
                me->set("giftmark/2011shutdown",1);
        }

        if( ! me->query("giftmark/2011shutdown2") )
        {
                if( me->query("combat_exp")>2000000000
                 || me->query("daoxing")>2000000000 )
                        return "这个奖励很多，你的数据会爆";             
                x = 500000;
                if( member_array(me->query("id"),ids)!=-1 )
                {
                        tell_object(me,HIR"因为你对这个补偿不满意，所以补偿打八折。\n");
                        x = 400000;
                }       
                y = x+random(x/2);
                me->add("combat_exp",y);
                tell_object(me,HIY"你得到了"+y+"点武学经验。\n"NOR);
        
                y = x+random(x/2);
                me->add("daoxing",y);   
                tell_object(me,HIY"你得到了"+COMBAT_D->chinese_daoxing(y)+"道行。\n"NOR);
                me->set("giftmark/2011shutdown2",1);
        }               
        return "泥潭无岁月，感谢一路有你。";
}                                                               

void create()
{
        set_name("李贺",({"li he","li"}));
        set("gender","男性");
        set("nickname",HIM"大唐鬼才"NOR);
        set("title",HIW"当机补偿大使"NOR);
        set("long","当机补偿的使者，你可以询问关于当机补偿的消息。\n");
        set("age",26);
        set("per",40);
        set("int",30);
        set("inquiry",([
                "当机补偿" : (: dangji_gift :),
        ]));
        setup();
        carry_object("/d/obj/cloth/gongpao")->wear();
}

