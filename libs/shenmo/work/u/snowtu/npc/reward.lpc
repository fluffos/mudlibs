#include <ansi.h>
inherit NPC;

string do_gift() {
  int wx, pot, dx;
  int max, i;
  string *skills, str;
  mapping skill;
  object who = this_player();
  if (!who || !present(who, environment()))
    return 0;
  if (!("/cmds/std/look")->main(this_object(), who->query("id")))
    return 0;
  if (query_temp("is_busy"))
    return "我正忙着呢。";
  set_temp("is_busy", 0);
  if (who->query("礼物记录/06年五一")) {
    command("whisper " + who->query("id") + " 你已经要过礼物了。\n");
    delete_temp("is_busy");
    return 0;
  }
  wx = who->query("combat_exp");
  wx /= 8;
  if (wx > 3000000)
    wx = 3000000;
  who->add("combat_exp", wx);
  str = "你得到了" + wx + "点武学，";
  dx = who->query("daoxing");
  dx /= 8;
  if (dx > 10000000)
    dx = 10000000;
  who->add("daoxing", dx);
  str += COMBAT_D->chinese_daoxing(dx) + "道行。\n";

  who->add("haomao", 3);
  str += "另外还有三根毫毛的补偿。\n";

  skill = who->query_skills();
  skills = keys(skill);
  for (i = 0; i < 20; i++) {
    if (!skill[i] || !who->query_skill(skills[i], 1)) continue;
    who->set_skill(skills[i], who->query_skill(skills[i], 1) + 1);
    str += "你的" + to_chinese(skills[i]) + "升级了。\n";
  }
  command("whisper " + who->query("id") + " " + str);
  who->set("礼物记录/06年五一", 1);
  who->save();
  delete_temp("is_busy");
  return 0;
}

void create() {
  set_name("礼物精灵", ({ "liwu jingling", "liwu", "jingling" }));
  set("long", "五一节日的礼物精灵，你可以向她打听关于节日礼物的消息。\n");
  set("inquiry", ([
    "节日礼物": (: do_gift :),
  ]));
  set("gender", "女性");
  set("per", 40);
  set("age", 14);
  setup();
}
