#include <ansi.h>
inherit NPC;

nosave int time = 240;

string check_me() {
  int amount;
  object gift;
  mapping data;
  string *ip_names, *ids;
  string ip_name, id;
  object me = this_player();
  object ob = this_object();

  /*
ob->set("gifts",([
        ip_name : id,
        ip_name2 : id2,
]));
*/
  if (me->is_busy())
    return "你正忙着呢。";
  if (ob->is_busy())
    return "稍等片刻。";

  ip_name = query_ip_number(me);
  id = me->query("id");

  data = ob->query("gifts");
  if (data && mapp(data)) {
    ip_names = keys(data);
    ids = values(data);

    if (member_array(ip_name, ip_names) != -1
      || member_array(id, ids) != -1)
      return "你已经要过了（或者是同ip的号要过了）。";
  }

  add_temp("player", 1);
  if (query_temp("player") < 3) {
    gift = new("/obj/money/gold");
    amount = 100 + random(400);
  } else if (query_temp("player") < 10) {
    gift = new(({
      "/obj/money/gold",
      "/obj/money/silver",
      "/obj/money/gold",
      "/obj/money/silver",
    })[random(4)]);
    amount = 50 + random(450);
  } else {
    gift = new(({
      "/obj/money/gold",
      "/obj/money/coin",
      "/obj/money/silver",
      "/obj/money/gold",
      "/obj/money/coin",
      "/obj/money/silver"
    })[random(6)]);
    amount = random(50) + random(50) + random(50) + random(50) + random(50) + random(50) + random(50) + random(50) + random(50) + random(50);
  }
  if (amount < 1)
    amount = 1;
  amount += random(amount / 5);
  gift->set_amount(amount);
  if (query("gift")) {
    gift = new(query("gift"));
    gift->set_amount(1); gift->set("base_unit", gift->query("unit"));
  }
  if (!gift->move(me))
    return "稍等片刻。";
  ob->set("gifts/" + ip_name, id);
  ob->save();
  message_vision(
    "$N掏出" + chinese_number(amount) + gift->query("base_unit") + gift->name() + "递到$n手中。\n",
    ob,
    me
  );
  ob->start_busy(1);
  me->start_busy(1 + random(3));
  return "小心收好。";
}

void create() {
  set_name("赵公明", ({ "zhao gongming", "zhao", "gongming" }));
  set("age", 1000);
  set("gender", "男性");
  set("per", 30);
  set("int", 30);
  set("title", "地仙之祖");
  set("inquiry", ([
    "礼物": (: check_me :),
    "gift": (: check_me :),
  ]));
  set("no_find", 1);
  setup();
  remove_call_out("check");
  call_out("check", 1);
}

void check() {
  string str;
  str = query("env_msg");
  if (!str || !stringp(str)) {
    str = MISC_D->find_place(environment());
    if (str == environment()->query("short"))
      str = SDS_D->random_msg(str);
    else {
      str = SDS_D->random_msg(str);
      str += SDS_D->random_msg(environment()->query("short"));
    }
    set("env_msg", str);
  }
  remove_call_out("check");
  time--;
  if (time % 30 == 0 && time != 0)
    message(
      "channel:chat",
      sprintf(
        HIG "【" HIR "贞观之治" HIG "】" NOR HIC "%s(%s)：今日在%s" HIC "，招财进宝。。。，尚有%s秒。。。。\n" NOR,
        query("name"),
        capitalize(query("id")),
        str,
        chinese_number(time)
      ),
      users()
    );
  if (time > 0)
    call_out("check", 1);
  else {
    message(
      "channel:chat",
      sprintf(
        HIG "【" HIR "贞观之治" HIG "】" NOR HIC "%s(%s)：今日事毕，就此别过。。。\n" NOR,
        query("name"),
        capitalize(query("id"))
      ),
      users()
    );
    destruct(this_object());
  }
}
