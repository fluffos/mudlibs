int backup_usr(object who)
{
string file,f;
object link_ob;
if ( !who || wizardp(who) )
        return 0;
if ( !who->save() )
        return 0;        
seteuid(geteuid());
if ( stringp(file=who->query_save_file()) ) 
        {
        f = file+".o";       
        file = "/c"+file+".data";  
        if ( cp(f,file) )
                {
                link_ob = who->query_temp("link_ob");
                if( link_ob  ) 
                        {
                        if ( stringp(file=link_ob->query_save_file()) ) 
                                {
                                f = file+".o";       
                                file = "/c"+file+".login";
                                if ( cp(f,file) )
                                        {
                                        tell_object(who,HIR"【"NOR WHT"系统备份"NOR HIR"】"BLK"阿浓告诉你：你的记录已备份完毕。\n"NOR);
                                        return 1;
                                        }
                                }
                        }
                }       
        }
return 0;
}

void do_bak()
{
string str;
object *usr;
int i;
if ( !environment() )  return;
str = "";
usr = users();
i = sizeof(usr);
while(i--)
        {
        if ( backup_usr(usr[i]) )       
                str+= usr[i]->query("name");
      else   continue;
        if ( i>=1 )
                str+= ", ";
        }
str = HIR+BLK+SDS_D->no_color_msg(str)+NOR;
message("channel:rumor",HIR"【"NOR WHT"系统备份"NOR HIR"】"BLK"系统记录开始："+str+HIR BLK"的经历已记录在案。\n"NOR,users());
call_out("do_bak",18000);
}

