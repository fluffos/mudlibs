#include <ansi.h>
inherit NPC;

int tt = 0;
void create() {
  mapping names = NAME_D->random_name("male");
  set_name(names["name"], names["id"]);
  set("gender", "男性");
  set("age", 30 + random(20));

  set_skill("dodge", 800);

  set("max_kee", 10000);
  set("max_sen", 10000);

  powerup();
  setup();
}

varargs int to_steal(object who, string id) {
  if (!who) {
    if (!stringp(id))
      return 0;
    who = find_player(id);
  }
  if (!who || !living(who) || !objectp(who))
    return 0;

  this_object()->set("to_steal", who);
  this_object()->move(environment(who));
  message_vision("$N鬼鬼祟祟的走了过来。\n$N朝$n暧昧的笑了一笑。。。\n\n", this_object(), who);
  this_object()->command("follow " + who->query("id"));
  this_object()->set_leader(who);
  return 1;
}

int heal_up() {
  object who;
  if (!query("to_steal")
    && environment()) {
    tt++;
    if (tt % 5 != 0) return 1;
    destruct(this_object());
    return 1;
  } else {
    who = query("to_steal");
    if (!who) {
      destruct(this_object());
      return 1;
    }
    if (!present(who, environment())) {
      this_object()->move(environment(who));
      message_vision("$N鬼鬼祟祟的走了过来。\n$N朝$n暧昧的笑了一笑。。。\n\n", this_object(), who);
      this_object()->command("follow " + who->query("id"));
      this_object()->set_leader(who);
    } else {
      message_vision(HIR "看起来$N要杀死$n！\n\n" NOR, this_object(), who);
      COMBAT_D->do_attack(this_object(), who, query_temp("weapon"));
    }
  }
  return ::heal_up() + 3;
}

varargs int receive_damage(string type, int damage, object who) {
  damage = 1;
  return ::receive_damage(type, damage, who);
}

varargs int receive_wound(string type, int damage, object who) {
  return receive_damage(type, damage, who);
}
