inherit NPC;

string check_lianhua();

void create()
{
set_name("如来佛", ({ "rulaifo","fo zu" }));
set("title", "佛祖多陀阿伽陀");
set("long", "大慈大悲灵山雷音古刹佛祖多陀阿伽陀如来佛爷。\n");
set("gender", "男性");
set("age", 10000);
set("attitude", "peaceful");
set("rank_info/self", "贫僧");
set("rank_info/respect", "佛祖爷爷");
set("str",100);
set("per",100);
set("max_kee", 10000);
set("max_gin", 10000);
set("max_sen", 10000);
set("force", 10000);
set("max_force", 10000);
set("force_factor", 500);
set("max_mana", 10000);
set("mana", 10000);
set("mana_factor", 500);
set("combat_exp", 4000000);
set("daoxing", 10000000);

set_skill("literate", 300);
set_skill("spells", 300);
set_skill("buddhism", 300);
set_skill("unarmed", 300);
set_skill("jienan-zhi", 300);
set_skill("dodge", 300);
set_skill("lotusmove", 300);
set_skill("parry", 300);
set_skill("force", 300);
set_skill("lotusforce", 300);
set_skill("staff", 300);
set_skill("lunhui-zhang", 300);
map_skill("spells", "buddhism");
map_skill("unarmed", "jienan-zhi");
map_skill("dodge", "lotusmove");
map_skill("force", "lotusforce");
map_skill("parry", "lunhui-zhang");
map_skill("staff", "lunhui-zhang");
set("inquiry", ([
    "莲花" : (: check_lianhua :),
  ]) );
setup();
carry_object("/d/obj/cloth/jia_sha")->wear();
}

string check_lianhua()
{
mapping data;   
int i;
string dir,f,*file,str1,str2,str3,str4;
object me = this_player();

if ( !userp(me) )
        return 0;
data = me->query("莲花");
if ( !data || !mapp(data) )
        return "相传佛门湿婆修悟之时，种下一池白莲而炼化为宝。今其座下各天神尚携此法宝云游人间。";
data = ([]);    
dir = me->query("id");
dir = "/c/莲花/"+dir+"/";
file = get_dir(dir);
if ( !file || !arrayp(file) )
        {
        me->delete("莲花");
        return "你所存莲花皆已不在，贫僧只得将其去除。";
        }
i = sizeof(file);
while(i--)
        {
        f = file[i];
        if ( !f || !stringp(f) )
                continue;
        if ( sscanf(f,"%s.lpc",f)!=1 )
                continue;
        if ( sscanf(f,"%s+%s+%s+%s",str1,str2,str3,str4)==4 )
                {
                if ( wizardp(me) )
                        printf("%s 设置完毕\n%s 设置完毕\n%s 设置完毕\n%s 设置完毕\n%s 设置完毕\n",str1,str2,str3,str4,f);      
                data[str1] = 2;
                data[str2] = 2; 
                data[str3] = 2;
                data[str4] = 2;
                data[f] = 1;
                }
        else if ( sscanf(f,"%s+%s",str1,str2)==2 )              
                {
                if ( wizardp(me) )
                        printf("%s 设置完毕\n%s 设置完毕\n%s 设置完毕\n",str1,str2,f);  
                data[str1] = 2;
                data[str2] = 2; 
                data[f] = 1;
                }
        else    {
                if ( wizardp(me) )
                        printf("%s 设置完毕\n%s",f);
                data[f] = 1;
                }
        }
me->set("莲花",data);
return "你的莲花记录已经修正完毕。";
}                       
