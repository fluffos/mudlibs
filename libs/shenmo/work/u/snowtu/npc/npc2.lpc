//战斗类npc
#include <ansi.h>
inherit NPC;

void create() {
  object ob;
  set_name("百姓", ({ "bai xing" }));
  set("max_force", 8000);
  set("max_mana", 8000);
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("combat_exp", 50000000);
  set("daoxing", 5000000);

  set_skill("dodge", 800);
  set_skill("unarmed", 800);
  set_skill("parry", 800);
  set_skill("sword", 800);
  set_skill("blade", 800);
  setup();
  ob = new("/d/obj/baowu/" + sprintf(
    "%s",
    ({ "leizhu", "fengzhu", "huozhu", "shuizhu", "tuzhu", "shengzhu" })[random(6)]
  ));
  ob->set_name("妖精之泪", ({ "yaojing lei" }));
  ob->move(this_object());
  ob = new("/d/city/npc/obj/armor");
  ob->set_name(HIM "妖精之甲" NOR, ({ "yaojing jia" }));
  ob->set("armor_prop/armor", 200);
  ob->move(this_object());
  command("wear all");
}

int invocation(object who) {
  object obj;
  int flag;
  mapping name;
  string *t, type, *types;

  if (!who)
    return 0;
  if (!living(who) || environment(who)->query("no_magic")
    || environment(who)->query("no_fight"))
    return 0;
  //if ( !SDS_D->random_family(this_object(),who,who->query_skill("force",1)+100,({"魔界","明教","神剑山庄","武圣门"})[random(4)]) )
  if (!SDS_D->random_family(this_object(), who, who->query_skill("force", 1) + 50))
    return 0;

  name = NAME_D->random_name("yaoguai");
  set_name(name["name"], name["id"]);
  set("haojie_owner", who);
  this_object()->save();
  /*
message("channel:rumor",sprintf(YEL"┣"NOR HIR" 三界浩劫 "NOR YEL"┫听说%s"YEL"在%s"YEL"遭到了%s"YEL"的攻击！\n"NOR,
                                who->query("name"),environment(who)->query("short"),query("name")),
        users());
*/
  this_object()->set("title", "千年");
  this_object()->move(environment(who));
  message_vision("$N走了过来。\n\n" NOR, this_object());
  message_vision("$N用一种异样的眼神扫视着在场的每一个人。\n", this_object());
  message_vision(
    "$N对着$n喝道：" + RANK_D->query_self_rude(who) + "看你实在很不顺眼，去死吧。\n",
    this_object(),
    who
  );
  this_object()->kill_ob(who);
  return 1;
}

void init() {
  add_action("do_none", "", 1);
  add_action("do_pfm", "perform");
}

int do_none() {
  string *no_cmds;
  object me = this_player();
  string verb = query_verb();

  if (me != query("haojie_owner"))
    return 0;

  no_cmds = ({
    "gongji", "ji", "apply", "steal", "whisper", "bian", "surrender",
    "cast chuqiao",                 //all
    "cast yinshen",                 //bonze
    "cast shuidun",                 //dragon
    "cast huimeng",                 //moon
    "cast escape", "cast chongsheng",  //emei swordman
    "burn",                         //jjf
    "cast townportal",              //hell
    "cast yin",                     //gumu
    "cast arrest", "cast drift", "cast taijitu",
    //kunlun ... so BT..
    "cast mysticism",               //sanxian
    "cast jieti",                   //xueshan
    "cast tuoqiao",                 //shushan
    "cast bagua",                   //youxia
    "cast qimen", "cast qiankun",    //wzg
    "cast tudun",                   //wdd
  });

  if (member_array(verb, no_cmds) != -1) {
    //:        message_vision("$N朝$n摇了摇头：你我还是安心作战。\n",this_object(),me);
    return 1;
  }
  return 0;
}

int do_pfm() {
  object me = this_player();
  if (me->is_fighting(this_object())
    || this_object()->is_fighting(me)) {
    if (time() < (me->query_temp("haojie_pfm") + 1)) {
      message_vision("$N装作一副可怜样，$n见状，不由不忍心下狠力。\n", this_object(), me);
      return 1;
    }
    me->set_temp("haojie_pfm", time());
  }
  return 0;
}

void heart_beat() {
  string skill, exert;
  int i;
  object weapon;
  object obj, who, me = this_object();
  ::heart_beat();

  who = query("haojie_owner");
  if (!who || !objectp(who)) {
    die();
    return;
  }
  if (!present(who, environment())) {
    me->move(environment(who));
    message_vision(MAG "妖风阵阵，$N" MAG "从中杀将出来！！\n\n" NOR, me);
    tell_object(who, HIR + name() + HIR "追了过来！\n" NOR);
    if (!environment()->query("no_magic")
      && !environment()->query("no_fight")
      && living(who))
      me->fight_ob(who);
    else {
      me->move("/obj/empty");
      delete("haojie_owner");
      return;
    }
  }

  if (query("eff_kee") < query("max_kee"))
    SDS_D->addEffKee(me);
  if (query("eff_sen") < query("max_sen"))
    SDS_D->addEffSen(me);
  if (!me->is_fighting())
    return;
  if (query("kee") < query("eff_kee"))
    SDS_D->addKee(me);
  if (query("sen") < query("eff_sen"))
    SDS_D->addSen(me);
  if (objectp(weapon = me->query_temp("weapon")))
    skill = weapon->query("skill_type");
  else skill = "unarmed";

  switch (random(10)) {
    case 0:
    case 1:
    case 9:
    case 8:
    case 2: SDS_D->randomPfm(me, skill); break;
    case 3:
    case 7:
    case 6: SDS_D->randomCast(me); break;
    default: SDS_D->randomExert(me);
  }
}

void die() {
  int pot;
  object who;
  object me = this_object();

  message_vision("$N见势不好，一声“扯呼”，跑的无影无踪。。。\n", me);
  who = query("haojie_owner");
  if (who && who == query_temp("last_damage_from")) {
    SDS_D->powerup(me);
    me->remove_killer(who);
    who->remove_killer(me);

    pot = me->query("combat_exp") - who->query("combat_exp");
    if (pot > 50000) pot = 50000;
    if (pot < 1000) pot = 1000;
    pot = random(pot);
    if (pot > 0) {
      who->add("combat_exp", pot);
      message("channel:chat", sprintf(YEL "┣" WHT " 三界浩劫" YEL " ┫%s" YEL "杀死了%s" YEL ",得到了%d" YEL "点武学的奖励。\n" NOR,
        who->name(), me->name(), pot),
        users());
      who->save();
      tell_object(who, YEL "\n你杀死了一个妖魔，你的经验上升了。\n" NOR);
    }
  }
  destruct(me);
}

void unconcious() {
  die();
}
