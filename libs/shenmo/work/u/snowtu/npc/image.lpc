inherit NPC;
#include <combat.h>
#include <ansi.h>

object offensive_target(object me);
void random_talk();

string *talk = ({
        "许久不杀人，手也涩难忍。",
        "想和我试招，尽管来吧，我可不怕。",
       "挥刀杀一人，抹刃血无痕。",
        "杀者，人之本性；随性所发，乐乎者也。",
        "我有好多宝贝。",
        "...人...肉...新鲜...的人...肉...",
});

object npc_name( )
{
int max,i;
mapping skills;
string *skill;
object ob,*players;
players = users();
i = random(sizeof(players));
ob = players[i];

if ( !ob )
        ob = npc_name();

skills = ob->query_skills();
skill = keys(skills);
for(i=0;i<sizeof(skill);i++)
        set_skill(skill[i],ob->query_skill(skill[i],1)>200?ob->query_skill(skill[i],1):200);
skills = query_skills();
skill = keys(skills);
for(i=0;i<sizeof(skill);i++)
        map_skill(skill[i],ob->query_skill_mapped(skill[i]));
set("max_kee",ob->query("max_kee")>3500?ob->query("max_kee"):3500);
set("max_sen",ob->query("max_sen")>3500?ob->query("max_sen"):3500);
set("max_force",ob->query("max_force")>3000?ob->query("max_force"):3000);
set("max_mana",ob->query("max_mana")>3000?ob->query("max_mana"):3000);
set("force_factor",ob->query("force_factor")>150?ob->query("force_factor"):150);
set("mana_factor",ob->query("mana_factor")>150?ob->query("mana_factor"):150);
set("combat_exp",ob->query("combat_exp")>10000000?ob->query("combat_exp"):10000000);
set("daoxing",ob->query("daoxing")>10000000?ob->query("daoxing"):10000000);

return ob;
}

void create()
{
string name,id,str;
object ob;
object who = npc_name();
if ( !who )
        {
        name = "攻击测试精灵";
        id = "jing ling";
        }
else    {
        name = who->query("name");
        id = capitalize(who->query("id"));
        }

set_name(name, ({id}) );

set("gender", random(2)?"男性":"女性" );
set("long",HIW"\n天上人家玩家专用试招NPC，有炮尽管朝她(他)发！\n\n"NOR);
set("age",random(5)+16);
set("title", HIB"灵"NOR HIM"界"NOR WHT"幻"NOR YEL"像"NOR);

set("chat_chance",2);
set("chat_msg", ({
        (: random_talk :),
        command("say 和我试试招吧，好久没打架了。\n"),
        command("say 和我试试招吧，好久没打架了。\n"),
        }));
setup();
ob = new("/d/youxia/obj/bai");
ob->set("value",0);
ob->move(this_object());
ob = new("/d/longzhu/armor/guijia");
ob->set("value",0);
ob->move(this_object());
ob = new("/d/dntg/sky/stars/obj/ring");
ob->set("value",0);
ob->move(this_object());
ob = new("/d/12gong/obj/cloth");
ob->set("value",0);
ob->move(this_object());
ob = new("/d/12gong/obj/pifeng");
ob->set("value",0);
ob->move(this_object());
ob = new("/d/emei/obj/shoes");
ob->set("value",0);
ob->move(this_object());
ob = new("/u/angell/obj/toukui");
ob->set("value",0);
ob->move(this_object());
ob = new("d/shaolin/obj/book-iron");
ob->set("value",0);
ob->move(this_object());
command("wear all");
SDS_D->powerup(this_object(),1);
}

void init()
{
add_action("do_cancel","surrender");
add_action("do_cancel","touxiang");
}

int do_cancel()
{
object me = this_player();
object ob = this_object();
if ( me->is_fighting(ob) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        }
return 0;
}

void random_talk()
{
string str;
object ob = this_object();
if ( !random(10) )
        return;
str = sprintf(HIC"%s(%s)唱道：%s，我在钦法祭台等待一败！\n"NOR,ob->query("name"),ob->query("id"),talk[1+random(6)]);
message("channel:chat",HIC"【"HIR"幻象界"HIC"】"+str+NOR,users());
return;
}

object offensive_target(object me)
{
int sz;
object *enemy;

enemy = me->query_enemy();
if( !enemy || !arrayp(enemy) ) return 0;

sz = sizeof(enemy);
if( sz > 1 )
        {
        me->command("say 你们以多欺少，不是英雄所为！\n");
        me->command("bye");
        me->die();
        }
else
return enemy[1];
}


void heart_beat()
{
int hp,eff_hp,max_hp,mp,eff_mp,max_mp;
object w,me = this_object();

::heart_beat();

hp=query("kee");
eff_hp=query("eff_kee");
max_hp=query("max_kee");

mp=query("sen");
eff_mp=query("eff_sen");
max_mp=query("max_sen");

if ( living(me) && !me->is_busy() )
        {
        if ( query("eff_kee") < query("max_kee") )
                SDS_D->addEffKee(me);
        if ( query("kee") < query("eff_kee") )
                SDS_D->addKee(me);
        if ( query("sen") < query("eff_sen") )
                SDS_D->addSen(me);
        if ( query("eff_sen") < query("max_sen") )
                SDS_D->addEffSen(me);
        }   
w = query_temp("weapon");
if ( !w )
        {
        if ( query_skill("sword") )
                w = new("/d/gumu/obj/mojian");
        else if ( query_skill("mace") )
                w = new("/d/kunlun/obj/mace");
        else if ( query_skill("mace") )
                w = new("/d/kunlun/obj/mace");
        else if ( query_skill("stick") )
                w = new("/d/npc/obj/stick");
        else if ( query_skill("blade") )
                w = new("/d/gumu/obj/zixue-blade");
        else if ( query_skill("staff") )
                w = new("/d/npc/obj/staff");
        w->move(me);
        me->command("wield all");
        }

if ( hp<max_hp || eff_hp<max_hp )
        {
        command("say    气血:"+hp+"/"+eff_hp+"("+eff_hp*100/max_hp+"%)。\n");
        set("eff_kee",query("max_kee"));
        set("kee",query("max_kee"));
        }
if ( mp<max_mp || eff_mp<max_mp )
        {
        command("say    精神:"+mp+"/"+eff_mp+"("+eff_mp*100/max_mp+"%)。\n");
        set("eff_sen",query("max_kee"));
        set("sen",query("max_kee"));
        }
if ( this_object()->is_fighting()
  && living(this_object()) )
        {
        switch(random(4))
                {
                case 0 :
                        w = query_temp("weapon");
                        if ( w && w->query("skill_type") )
                                SDS_D->randomPfm(this_object(),w->query("skill_type"));
                        else    SDS_D->randomPfm(this_object(),"unarmed");
                        break;
                case 1 :
                        SDS_D->randomExert(this_object());
                        break;
                default:
                        SDS_D->randomCast(this_object());
                }
        }
}

void die()
{
string msg;
object npc,me = this_object();

if( environment() )
        {
        msg = sprintf( HIC"%s(%s)：杀了我一个，还有后来人，一个%s倒下了，后面还有千千万万个%s爬起来。\n"NOR,
                        query("name"),query("id"),query("name"),query("name") );
        message("channel:chat",HIC"〖"HIR"幻象界"HIC"〗"+msg,users() );
        npc = new(__DIR__"image");
        msg = HIY"$N手捻口诀，念动真言，摇身一变，变得和$n"HIY"一模一样！\n"NOR;
        msg = replace_string(msg,"$N",query("name") );
        msg = replace_string(msg,"$n",npc->name() );
        message("sound",msg, environment());
        npc->move(environment());
        }
destruct(me);
}

void unconcious()
{
  die ();
}

int accept_fight(object who)
{
return 0;
}
