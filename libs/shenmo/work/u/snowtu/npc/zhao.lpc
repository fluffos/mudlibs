string check_me() {
  string ip;
  int amount;
  object me = this_player();
  if (me->query("age") < 16
    || me->query_skill("literate", 1) < 100
    || me->query("combat_exp") < 1500000
    || me->query("daoxing") < 1000000)
    return "你还是练好武功再来吧。";
  message_vision("$N向$n询问银号借贷一事。\n", me, this_object());
  ip = me->query_ip_number();
  if (mapp(query("jiedai/" + ip)))
    return "为了世间的货币繁荣，对于一个地址的本神只提供一次服务。";
  amount = me->query("balance");
  amount = amount / 3 * 2;
  if (amount < 1)
    return "你的钱庄帐户借贷的保证金不足。";
  this_object()->set("jiedai/" + ip, ([
    "amount": amount,
    "time": time(),
    "id": me->query("id"),
  ]));
  if (this_object()->save()) {
    me->add("balance", amount);
    me->save();
    return "你的借贷行为本神已安排妥当，" + MONEY_D->price_num(amount) + "已经存入你的钱庄帐户。(借贷时间为一周)";
  } else return "本神正忙呢。";
}

void remove_jiedai() {
  int i, time, amount, a_amount;
  object who;
  mapping jie, data;
  string *ips;
  jie = query("jiedai");
  if (!jie || !mapp(jie))
    return;
  ips = keys(jie);
  for (i = 0; i < sizeof(ips); i++) {
    data = query("jiedai/" + ips[i]);
    if (!data || !mapp(data))
      continue;
    time = data["time"];
    if ((time + 86400) < time())
      continue;
    who = find_player(data["id"]);
    if (!who || !living(who))
      continue;
    amount = data["amount"];
    amount += amount / 100;
    if (!amount || amount <= 0) {
      this_object()->delete("jiedai/" + ips[i]);
      this_object()->save();
      continue;
    }
    if ((int)who->query("balance") >= amount) {
      who->add("balance", -amount);
      who->save();
      message(
        "vision",
        HIY "\n半空中金光一闪，赵财神现身出来，对" + who->name() + HIY "一拱手：你的贷款今日到期，特来取回。\n\n" NOR,
        environment(who),
        who
      );
      tell_object(
        who,
        HIG "赵公明(Zhao gongming)告诉你：你贷款期限已到，连本带利共计" + MONEY_D->money_str(amount) + HIY "已从你的钱庄帐户扣除。\n" NOR
      );
      this_object()->delete("jiedai/" + ips[i]);
      this_object()->save();
      continue;
    } else if ((int)who->query("c_balance") >= amount) {
      who->add("c_balance", -amount);
      who->save();
      message(
        "vision",
        HIY "\n半空中金光一闪，赵财神现身出来，对" + who->name() + HIY "一拱手：你的贷款今日到期，特来取回。\n\n" NOR,
        environment(who),
        who
      );
      tell_object(
        who,
        HIG "赵公明(Zhao gongming)告诉你：你贷款期限已到，连本带利共计" + MONEY_D->money_str(amount) + HIY "已从你的金卡中扣除。\n" NOR
      );
      this_object()->delete("jiedai/" + ips[i]);
      this_object()->save();
      continue;
    } else {
      a_amount = amount - who->query("balance");
      if ((int)who->query("c_balance") >= a_amount) {
        who->add("c_balance", -amount);
        who->set("balance", 0);
        who->save();
        message(
          "vision",
          HIY "\n半空中金光一闪，赵财神现身出来，对" + who->name() + HIY "一拱手：你的贷款今日到期，特来取回。\n\n" NOR,
          environment(who),
          who
        );
        tell_object(
          who,
          HIG "赵公明(Zhao gongming)告诉你：你贷款期限已到，连本带利共计" + MONEY_D->money_str(amount) + HIY "已从你的金卡中扣除。\n" NOR
        );
        this_object()->delete("jiedai/" + ips[i]);
        this_object()->save();
        continue;
      } else {
        amount -= (int)who->query("balance");
        amount -= (int)who->query("c_balance");
        who->set("balance", 0);
        who->set("c_balance", 0);
        who->save();
        this_object()->set("jiedai/" + ips[i] + "/amount", amount);
        this_object()->save();
        message(
          "vision",
          HIY "\n半空中金光一闪，赵财神现身出来，对" + who->name() + HIY "一拱手：你的贷款今日到期，特来取回。\n\n" NOR,
          environment(who),
          who
        );
        tell_object(
          who,
          HIG "赵公明(Zhao gongming)告诉你：你贷款期限已到，连本带利你尚欠款" + MONEY_D->money_str(amount) + HIY "。\n" NOR
        );
        continue;
      }
    }
  }
}

void accept_kill(object who) {
  kill_ob(who);
}

void accept_fight(object who) {
  kill_ob(who);
}

void init() {
  int time = NATURE_D->query_current_day_phase();
  if (time == 1) {
    if (!query_temp("checking")) {
      set_temp("checking", 1);
      remove_jiedai();
    }
  }
}
