string check_me() {
  string ip;
  int amount;
  object me = this_player();
  if (me->query("age") < 16
    || me->query_skill("literate", 1) < 100
    || me->query("combat_exp") < 1500000
    || me->query("daoxing") < 1000000)
    return 0;
  message_vision("$N向$n询问银号借贷一事。\n", me, this_object());
  ip = me->query_ip_number();
  if (mapp(query("jiedai/" + ip)))
    return "为了世间的货币繁荣，对于一个地址的本神只提供一次服务。";
  amount = me->query("balance");
  amount = amount / 3 * 2;
  if (amount < 1)
    return "你的钱庄帐户借贷的保证金不足。";
  me->add("balance", amount);
  if (me->save()) {
    this_object()->set("jiedai/" + ip, ([
      "amount": amount,
      "time": time(),
      "id": me->query("id"),
    ]));
    if (this_object()->save())
      return "你的借贷行为本神已安排妥当，" + MONEY_D->price_num(amount) + "已经存入你的钱庄帐户。(借贷时间为一周)";
    else return "本神正忙呢。";
  } else return "你正忙着呢。";
}

