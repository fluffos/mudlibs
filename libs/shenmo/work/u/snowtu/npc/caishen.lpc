#include <ansi.h>
inherit F_SAVE;
inherit NPC;

void super_fight1(object who);
void super_fight2(object who);
void super_fight3(object who);
void super_fight4(object who);
void super_fight5(object who);
void super_fight6(object who);
string check_me();

void create() {
  set_name("赵公明", ({ "zhao gongming", "zhao", "goming" }));
  set("long", HIR "一身大红蟒袍，天下无人不识，财神是也。\n" NOR);
  set("gender", "男性");
  set("age", 43);
  set("per", 25);

  set_skill("dodge", 600);
  set_skill("unarmed", 600);
  set_skill("parry", 600);

  set("combat_exp", 850000000);
  set("daoxing", 1000000000);

  set("max_kee", 80000);
  set("max_sen", 80000);
  set("max_gin", 50000);

  set("max_force", 7500);
  set("force", 15000);
  set("force_factor", 250);

  set("max_mana", 10000);
  set("mana", 20000);
  set("mana_factor", 350);

  set("env/wimpy", 10);

  set("inquiry", ([
    "all": (: check_me :),
  ]));
  setup();
  set_temp("apply/damage", 200);
  set_temp("apply/armor", 500);
}

string query_save_file() {
  return DATA_DIR "npc/boss/cai_shen";
}

void die() {
  SDS_D->powerup(this_object(), 1);
}

void unconcious() {
  die();
}

void heart_beat() {
  int i;
  string arg, *magic;
  object seal, target;
  object me = this_object();
  ::heart_beat();
  if (query("eff_kee") < query("max_kee"))
    SDS_D->addEffKee(me);
  if (query("kee") < query("eff_kee"))
    SDS_D->addKee(me);
  if (query("sen") < query("eff_sen"))
    SDS_D->addSen(me);
  if (query("eff_sen") < query("max_sen"))
    SDS_D->addEffSen(me);
}

void kill_ob(object who) {
  object me = this_object();
  object env = environment();
  if (!who) {
    me->command("say 哈哈，天下谁人不认识我赵公明？！\n");
    SDS_D->powerup(me, 1);
    return;
  }
  if (!present(who, env)) {
    me->command("chat 哈哈，" + who->short() + "居然敢和我斗？哼，不自量力。。。\n");
    SDS_D->powerup(me, 1);
    return;
  }
  if (!me->is_fighting(who)) {
    me->command("say 哈哈，老子天下无敌！\n");
    SDS_D->powerup(me, 1);
    return;
  }
  if (!me->query_temp("super_fighting")) {
    switch (random(6)) {
      case 0:
        super_fight1(who);
        break;
      case 1:
        super_fight2(who);
        break;
      case 2:
        super_fight3(who);
        break;
      case 3:
        super_fight4(who);
        break;
      case 4:
        super_fight5(who);
        break;
      default:
        super_fight6(who);
        break;
    }
    me->set_temp("super_fighting", 1);
    remove_call_out("remove_eff");
    call_out("remove_eff", 1 + random(5), me);
  }
  remove_call_out("kill_ob");
  call_out("kill_ob", random(3), who);
}

void super_fight1(object who)  //金元宝
{
  object gold;
  object me = this_object();
  object env = environment();

  message_vision(CYN "$N" CYN "战罢多时，晃身跳出圈外，从怀中掏出一锭金灿灿的" NOR HIY "元宝" NOR CYN "。\n" NOR, me);
  me->command("say 有钱能使磨推鬼，看法宝吧！\n");
  message_vision(HIY "但见元宝金光闪闪，似一道闪电般砸向$N！\n" NOR, who);
  who->command("say 哇塞！有钱也不能这样糟蹋啊！\n");
  message("vision", YEL + who->name() + YEL "眼见金元宝扑面而来，不禁心头肉跳，撤招去夺。\n" NOR, env, who);
  tell_object(who, "你哪里见过这么个成色十足的金子啊，不由奋不顾身的去夺。\n");
  if (random(2)) {
    message_vision(HIY "“轰隆”一声，$N" HIY "给砸了个正着，动弹不得！\n" NOR, who);
    who->start_busy(1 + random(3));
  } else if (random(100) != 99)
    message_vision(HIY "可惜$N" HIY "挥手一招，金元宝又立即折回！$n恨得牙根痒痒。。。\n" NOR, me, who);
  else {
    message_vision(HIY "$n" HIY "一个虎跃，将金元宝牢牢拽住，死命不放。$N恨得牙根痒痒。。。\n" NOR, me, who);
    gold = new("/obj/money/gold");
    gold->move(who);
  }
  return;
}

