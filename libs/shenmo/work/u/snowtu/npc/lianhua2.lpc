inherit NPC;

string check_me() {
  string name;
  object gift, *inv, me = this_player();
  int i, flag = 0;

  if (query("gift")) {
    gift = new(query("gift"));
    if (gift->move(me))
      message_vision(name() + "给$N一个$n。\n", me, gift);
    me->move("/d/city/kezhan");
  }

  return "好好保存。";
}

void create() {
  set_name("湿婆", ({ "shi po", "po" }));
  set("age", 10000);
  set("gender", "中性");
  set("inquiry", ([
    "莲花": (: check_me :),
  ]));
  setup();
}
