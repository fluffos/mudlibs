#include <ansi.h>
inherit NPC;

void create()
{
set_name("监视精灵", ({"jianshi jingling"}));
set("max_kee",1000000);
set("max_gin",1000000);
set("max_sen",1000000);
set("任务",1);
set("title",WHT"吏部尚书"NOR);
setup();
}

void init()
{
if ( wizardp(this_player()) )
	{
	add_action("do_chat","feng");
	add_action("do_nochat","unfeng");
	add_action("do_check","checks");
	add_action("do_change","rename");
	}	
}

int select_user(object a, string subip)
{
if(strsrch(query_ip_number(a),subip) == -1) return 0;
else return 1;
}

int do_chat(string arg)
{
int i;
string subip;
object who,*ob_list;
object me = this_player();
if ( !wizardp(me) )
        return notify_fail("什么？\n");
if ( !arg )
        return notify_fail("什么？\n");
who = find_player(arg);
if ( !who || who==me || wizardp(who) )
        return notify_fail("什么？\n");
who->set_temp("block_msg/all",1);
who->set_temp("cut_chat",1);
who->save();
say(who->query("name")+"已封。\n");

subip=query_ip_number(who);
ob_list = filter_array(users(),"select_user",this_object(),subip);

for(i=0;i<sizeof(ob_list);i++)
        {
        if ( wizardp(ob_list[i]) ) continue;
        if ( ob_list[i]->query_temp("cut_chat") )
                continue;
        say(random(2)?">>>":">");
        call_out("do_ban",2+random(8),ob_list[i]);
        }
return 1;
}

void do_ban(object who)
{
if ( !who || !living(who) ) return;
who->set_temp("block_msg/all",1);
who->set_temp("cut_chat",1);
who->save();
say("\n");
say(who->query("name")+"已封。\n");
return;
}

int do_nochat(string arg)
{
int i;
string subip;
object who,*ob_list;
object me = this_player();
if ( !wizardp(me) )
        return notify_fail("什么？\n");
if ( !arg )
        return notify_fail("什么？\n");
who = find_player(arg);
if ( !who || who==me || wizardp(who) )
        return notify_fail("什么？\n");
if ( who->query_temp("cut_chat") )
        {
        who->set_temp("block_msg/all",0);
        who->delete_temp("cut_chat");
        who->save();
        say(who->query("name")+"已解封。\n");
        }
subip=query_ip_number(who);
ob_list = filter_array(users(),"select_user",this_object(),subip);

for(i=0;i<sizeof(ob_list);i++)
        {
        if ( !ob_list[i]->query_temp("cut_chat") ) 
                continue;
        say(random(2)?">>>":">");
        call_out("do_noban",2+random(8),ob_list[i]);
        }
return 1;
}

int do_check(string arg)
{
int i,num=0;
string subip,msg;
object who,*ob_list;
object me = this_player();
if ( !wizardp(me) )
        return notify_fail("什么？\n");
if ( !arg )
        return notify_fail("什么？\n");
who = find_player(arg);
if ( !who )
        return notify_fail("查无此人。\n");
msg = "\n与"+who->query("name")+"目前同一IP的有：\n\n";

subip=query_ip_number(who);
ob_list = filter_array(users(),"select_user",this_object(),subip);

for(i=0;i<sizeof(ob_list);i++)
        {
        num++;
        msg+= "\t\t"+ob_list[i]->query("name")+"("+ob_list[i]->query("id")+")\n";
        }
say(msg);
say("\n共"+chinese_number(num)+"个ID是此IP之上的。\n");
return 1;
}


int do_change(string arg) 
{
string str;
object who;

if ( !arg ) 
	return notify_fail("没有这个人。\n");
who = find_player(arg);
if ( !who )
	return notify_fail("没有这个人。\n");
str = who->query("weapon/name");
str = replace_string(str,"$WHT$",WHT"");
str+= ""NOR;
who->set("weapon/name",str);
who->save();
say(who->name()+"的武器已经改为:"+str+"\n");
return 1;
}