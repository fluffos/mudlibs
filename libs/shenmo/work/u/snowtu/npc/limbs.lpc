inherit NPC;

void create()
{
set_name("眠兔",({"Snowtu"}));
setup();
}

void init()
{
add_action("do_huifu","huifu");
}

varargs int do_huifu(string arg,int flag)
{
string *limbs;
object who;
object me = this_player();
if ( !arg || !wizardp(me) )
        return 0;
if ( !objectp(who=find_player(arg)) )
        return notify_fail("no this player.\n");
limbs = ({
        "头部", "颈部", "胸口", "后心", "左肩", "右肩", "左臂",
        "右臂", "左手", "右手", "腰间", "小腹", "左腿", "右腿",
        "左脚", "右脚"
});
who->set("limbs",limbs);
if ( who->save() )
        say(who->query("name")+"身体恢复正常。\n");
return 1;
}

