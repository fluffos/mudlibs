#include <ansi.h>
inherit NPC;

void do_check();
string check_birth();

void create() {
  mapping names = NAME_D->random_name("female");
  set_name(names["name"], names["id"]);
  set("age", 24);
  set("title", HIW "天" HIY "上" HIG "人" HIM "间" NOR WHT "生日精灵" NOR);
  set("per", 40);
  set("inquiry", ([
    "生日": ( : check_birth: ),
  ]));
  setup();
  carry_object("/d/obj/cloth/skirt")->wear();
  carry_object("/d/obj/cloth/shoes")->wear();
  remove_call_out("do_check");
  call_out("do_check", 60);
}

void do_check() {
  object *user;
  mapping birth;
  string month, get_time;
  string week, year, c_day, c_month;
  string str;
  int day, hour, minute, second, i, k;
  string *month_name = ({ "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul",
    "Aug", "Sep", "Oct", "Nov", "Dec" });

  get_time = ctime(time());
  sscanf(get_time, "%s %s %d %d:%d:%d %s", week, month, day, hour, minute, second, year);

  c_month = chinese_number(member_array(month, month_name) + 1);
  c_day = chinese_number(day);
  message("shout", sprintf(HIG "〖 " HIC "生日 " HIG "〗" HIC "%s(%s)：现在现实时间为：%s年%s月%s日。\n" NOR,
    query("name"),
    capitalize(query("id")),
    year,
    c_month,
    c_day,),
    users());
  str = "";
  user = users();
  i = sizeof(user);
  k = 0;
  while (i--) {
    if (!user[i] || !objectp(user[i]))
      continue;
    if (!mapp(birth = user[i]->query("生日")))
      continue;
    if (birth["月份"] != c_month)
      continue;
    if (birth["天数"] != c_day)
      continue;
    if (birth[year])
      continue;

    k++;
    str = sprintf("%s(%s)", user[i]->query("name"), capitalize(user[i]->query("id")));
    if (i > 0) {
      if (k % 3 == 0)
        str += "\n\t\t";
      else str += "、";
    } else str += "\n";
  }
  if (k > 0)
    str = "请以下玩家记得索取生日礼物：\n\t\t" + str;
  else str = "今日没有可得到生日礼物的玩家。";
  message("shout", sprintf(HIG "〖 " HIC "生日 " HIG "〗" HIC "%s(%s)：%s\n" NOR,
    query("name"), capitalize(query("id")), str),
    users());
  set_temp("birth", ([
    "year": year,
    "month": c_month,
    "day": c_day,
  ]));

  return;
}

string check_birth() {
  object who;
  object me = this_player();
  mapping b, birth = ([]);
  int i, wx, pot, dx;

  if (objectp(who = query_temp("asked")))
    return "稍微等等，我正在办理" + who->name() + "的生日礼物呢。";
  if (mapp(b = me->query("生日")))
    return "你还是先去月老那确定自己的生日吧。";
  if (!me->query_temp("birth_want"))
    return "你一定是错过了上一次的生日通告，耐心等今天的通告吧，别离开哦。。。";
  if (query_temp("birth/day") != b["天数"])
    return "你是今天的生日吗？不是" + b["天数"] + "日吗？";
  if (query_temp("birth/month") != b["月份"])
    return "你是这个月的生日吗？不是" + b["月份"] + "月吗？";
  set_temp("asked", me);
  say(name() + "点了点头：" + me->query("name") + "，生日快乐。\n");
  me->delete_temp("birth_want");
  wx = 2000 + random(18000);
  dx = 5000 + random(35000);
  pot = 1000 + random(9000);

  i = random(me->query_kar());
  if (i > 35) {
    me->add("combat_exp", wx);
    tell_object(me, BLINK HIG "\n生日快乐，你得到了" + chinese_number(wx) + "点武学经验。\n\n" NOR);
  } else if (i > 20) {
    me->add("daoxing", dx);
    tell_object(me, BLINK HIG "\n生日快乐，你得到了" + COMBAT_D->chinese_daoxing(dx) + "道行。\n\n" NOR);
  } else {
    me->add("potential", pot);
    tell_object(me, BLINK HIG "\n生日快乐，你得到了" + chinese_number(pot) + "点潜能。\n\n" NOR);
  }
  me->set("生日/" + query_temp("birth/year"), 1);
  me->save();
  delete_temp("asked");
  message("channel:rumor", sprintf(HIM "【 " HIG "千里眼 " HIM "】某人：听说" HIW "%s" HIM "得到了生日礼物！\n" NOR,
    me->query("name")), users());
  return "再次祝你生日快乐。";
}
