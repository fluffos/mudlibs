#include <ansi.h>
inherit F_SAVE;
inherit NPC;

string *nocmds = ({
  "qiangpo", "qiangjian", "kiss", "call", "edit",
  "more", "update", "cat", "cast", "kill", "fight", "shit",
});

void create() {
  string msg;
  set_name("阿浓", ({ "a nong", "anong", "nong" }));
  set("title", WHT "眠兔" NOR "的" HIG "老婆" NOR);
  set("nickname", HIW "我家我说了算" NOR);
  set("gender", "女性");
  set("age", 18);
  set("master", "snowtu");
  msg = HIM + @LONG

眠兔的老婆，性情刁蛮，离开家行来行走江湖。她长
得极美，尤其是那双眼睛，媚得直可以勾人魂魄。其
容色晶莹如玉，映照于红红烛光之下，娇美不可方物。
回眸嫣然一笑，雅如仙子下凡。眼波流转之间，便把
一个少年的心灵，推向梦中极美的境界。

LONG + NOR;
  set("long", msg);
  set("int", 40);
  set("per", 40);
  setup();
  carry_object("/d/obj/cloth/skirt")->wear();
  carry_object("/d/obj/cloth/shoes")->wear();
  remove_call_out("do_chat");
  call_out("do_chat", random(60));
}

string query_save_file() {
  return "/d/snowtu/npc/snowtu";
}

void die() {
  if (environment()) {
    message("sound", HIM "\n\n阿浓娇嗔道“唉，我不和你一般计较，眠兔会救我的！”\n\n
半空中一道电光，阿浓全身又充满了力量。。。\n\n" NOR, environment());
  }
  set("eff_kee", 10000);
  set("eff_gin", 10000);
  set("eff_sen", 10000);
  set("kee", 10000);
  set("gin", 10000);
  set("sen", 10000);
  set("force", 10000);
  set("mana", 10000);
}

void unconcious() {
  die();
}

void init() {
  object ob = this_object();
  ::init();
  add_action("do_none", "", 1);
}

int do_none() {
  string verb = query_verb();
  if (member_array(verb, nocmds) == -1 || this_player()->query("id") == query("master"))
    return 0;
  say(CYN + name() + CYN "说道：这里是眠兔的地盘，大家不要撒野。。。\n" NOR);
  return 1;
}

object npc_name() {
  int i;
  object ob, *players;
  players = users();
  i = random(sizeof(players));
  ob = players[i];
  return ob;
}

void do_chat() {
  string id, *e, face, msg, arg;
  object player = npc_name();
  if (!player)
    player = find_player("snowtu");
  if (!player)
    return do_chat();

  e = sort_array(EMOTE_D->query_all_emote(), 1);
  face = e[random(sizeof(e))];
  if (stringp(face)) {
    id = player->query("id");
    arg = EMOTE_D->do_emote(this_object(), face, id, HIC, 1, 0, 0);
    if (!stringp(arg))
      return do_chat();
    arg = SDS_D->no_color_msg(arg);
    arg = HIC + arg + NOR;
    arg = replace_string(arg, "$N", NOR WHT "阿浓" NOR HIC);
    arg = replace_string(arg, "$P", NOR WHT "她" NOR HIC);
    arg = replace_string(arg, "$c", NOR WHT "眠兔的亲亲老婆" NOR HIC);
    arg = replace_string(arg, "$S", NOR WHT "眠兔的亲亲老婆" NOR HIC);
    arg = replace_string(arg, "$s", NOR HIG "眠兔的亲亲老婆" HIC);
    arg = replace_string(arg, "$C", NOR HIG "眠兔的亲亲老婆" HIC);
    message("channel:chat", HIC "〖" NOR HIG "女兒界" NOR HIC "〗" + arg + "\n" NOR, users());
    return;
  }
  return do_chat();
}

void relay_emote(object who, string verb) {
  string arg, face, *e;
  string *loves = ({
    "kiss", "mm", "touch", "cu", "piao", "sing",
    "sleepy", "marry", "turelove", "vivian",
    "love", "young", "yi",
  });
  string *hits = ({
    "pai", "kick", "and", "bored", "busy", "qie",
    "consider", "chui", "da", "gongan",
    "hit", "idea", "makeup", "norumor",
    "only", "shutup", "zou", "zzz", "zhaosi",
  });
  string *snowtu = ({
    "pai", "kick", "qie", "konglong",
    "pig", "pei", "de", "ah?", "bajie",
    "kiss10", "noway",
  });


  if (member_array(verb, loves) != -1) {
    if (who->query("id") == "snowtu")
      command(loves[random(sizeof(loves))] + " snowtu");
    else {
      arg = EMOTE_D->do_emote(
        this_object(),
        snowtu[random(sizeof(snowtu))],
        who->query("id"),
        "",
        1,
        0,
        0
      );
      if (!stringp(arg))
        say(CYN + name() + "说道：原来" + who->query("name") + CYN "也是一头臭流氓。\n" NOR);
      else {
        arg = SDS_D->no_color_msg(arg);
        arg = CYN + arg + NOR;
        arg = replace_string(arg, "$N", NOR WHT "阿浓" NOR CYN);
        arg = replace_string(arg, "$P", NOR WHT "她" NOR CYN);
        arg = replace_string(arg, "$c", NOR WHT "眠兔的亲亲老婆" NOR CYN);
        arg = replace_string(arg, "$S", NOR WHT "眠兔的亲亲老婆" NOR CYN);
        arg = replace_string(arg, "$s", NOR HIG "眠兔的亲亲老婆" NOR CYN);
        arg = replace_string(arg, "$C", NOR HIG "眠兔的亲亲老婆" NOR CYN);
        message_vision(CYN + arg + NOR, this_object(), who);
      }
    }
  }

  else if (member_array(verb, hits) != -1) {
    if (who->query("id") == "snowtu")
      command("inn snowtu");
    else {
      arg = EMOTE_D->do_emote(
        this_object(),
        snowtu[random(sizeof(snowtu))],
        who->query("id"),
        "",
        1,
        0,
        0
      );
      if (!stringp(arg))
        say(CYN + name() + "说道：原来" + who->query("name") + CYN "也是一头臭流氓。\n" NOR);
      else {
        arg = SDS_D->no_color_msg(arg);
        arg = CYN + arg + NOR;
        arg = replace_string(arg, "$N", NOR WHT "阿浓" NOR CYN);
        arg = replace_string(arg, "$P", NOR WHT "她" NOR CYN);
        arg = replace_string(arg, "$c", NOR WHT "眠兔的亲亲老婆" NOR CYN);
        arg = replace_string(arg, "$S", NOR WHT "眠兔的亲亲老婆" NOR CYN);
        arg = replace_string(arg, "$s", NOR HIG "眠兔的亲亲老婆" NOR CYN);
        arg = replace_string(arg, "$C", NOR HIG "眠兔的亲亲老婆" NOR CYN);
        message_vision(CYN + arg + NOR, this_object(), who);
      }
    }
  } else {
    if (who->query("id") == "snowtu")
      if (random(2)) { do_chat(); return; } else arg = EMOTE_D->do_emote(
        this_object(),
        verb,
        who->query("id"),
        CYN,
        1,
        0,
        0
      );
    else {
      e = sort_array(EMOTE_D->query_all_emote(), 1);
      face = e[random(sizeof(e))];
      arg = EMOTE_D->do_emote(this_object(), face, who->query("id"), CYN, 1, 0, 0);
    }
    arg = SDS_D->no_color_msg(arg);
    arg = CYN + arg + NOR;
    arg = replace_string(arg, "$N", NOR WHT "阿浓" NOR CYN);
    arg = replace_string(arg, "$P", NOR WHT "她" NOR CYN);
    arg = replace_string(arg, "$c", NOR WHT "眠兔的亲亲老婆" NOR CYN);
    arg = replace_string(arg, "$S", NOR WHT "眠兔的亲亲老婆" NOR CYN);
    arg = replace_string(arg, "$s", NOR HIG "眠兔的亲亲老婆" NOR CYN);
    arg = replace_string(arg, "$C", NOR HIG "眠兔的亲亲老婆" NOR CYN);
    message_vision(CYN + arg + NOR, this_object(), who);

  }
}

void relay_whisper(object who, string verb) {
  relay_emote(who, verb);
}
