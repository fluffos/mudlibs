#include <ansi.h>
inherit NPC;

nosave int n = 0;
void clear_weapon(int i);
string *dirs = ({
        "/d/city",
        "/d/jjf",
        "/d/westway",
        "/d/kaifeng",
        "/d/lingtai",
        "/d/moon",
        "/d/gao",
        "/d/sea", 
        "/d/nanhai", 
        "/d/eastway",
        "/d/xueshan",
        "/d/dntg/hgs",
        "/d/qujing/wuzhuang", 
        "/d/qujing/baotou", 
        "/d/qujing/baoxiang", 
        "/d/qujing/bibotan",
        "/d/qujing/biqiu",
        "/d/qujing/chechi",
        "/d/qujing/dudi",
        "/d/qujing/fengxian",
        "/d/qujing/firemount",
        "/d/qujing/jilei",
        "/d/qujing/jindou",
        "/d/qujing/jingjiling",
        "/d/qujing/jinping",
        "/d/qujing/jisaiguo",
        "/d/qujing/maoying",
        "/d/qujing/nuerguo",
        "/d/qujing/pingding",
        "/d/qujing/pansi",
        "/d/qujing/tongtian",
        "/d/qujing/qilin",
        "/d/qujing/qinfa",
        "/d/qujing/qinglong",
        "/d/qujing/tianzhu",
        "/d/qujing/wudidong",
        "/d/qujing/wuji",
        "/d/qujing/xiaoxitian",
        "/d/qujing/yinwu",
        "/d/qujing/yuhua",
        "/d/qujing/zhujie",
        "/d/qujing/zhuzi",
        "/d/penglai",
        "/d/pantao",
        "/d/death",  
        "/d/meishan",
        "/d/qujing/lingshan",
});

void create()
{
set_name("清理器",({"qing li"}));
set("unit","只");
set("env/invisibility",1);
setup();
}

void die()
{
powerup();
}

void unconcious()
{
die();
}

void kill_ob(object who)
{
remove_all_killer();
all_inventory(environment())->remove_killer(this_object());
}
                
void init()
{
add_action("do_clear","clear");
add_action("update_weapon","weapon");
}               

int do_clear()
{
if ( !wizardp(this_player()) )
        return 0;
message("shout",HIG"\n【系统】常用地图垃圾清理经已开始！。\n"NOR,users()); 
call_out("clear_weapon",2+random(3),0);
return 1;
}

void clear_weapon(int i)
{
mixed* file;
string temp;
int nn,ii,j,k;
object *inv,newob;       

remove_call_out("clear_weapon");
if ( i>=sizeof(dirs) )
        {
        message("shout",HIG"【系统】常用地图内所有的垃圾经已清理完毕，共计"+n+"个垃圾。\n"NOR,users()); 
        move("/u/snowtu/workroom");
        return;
        }
file = get_dir( dirs[i]+"/*.lpc", -1 );
temp = "";
nn = 0;
if( !sizeof(file) )
        return;
j = sizeof(file);
while(j--)
        {
        k = sizeof(file[j]);
        while(k--)
                {       
                if ( !this_object()->move(dirs[i]+"/"+file[j][k]) )
                        continue;
                newob=environment();
                if ( strlen(temp)<4 )
                        temp = MISC_D->find_place(newob);       
                inv = all_inventory(newob);
                ii = sizeof(inv);
                while(ii--)
                        {
                        if ( inv[ii] && strsrch(inv[ii]->name(),"断成两截的")!=-1 )
                                {
                                destruct(inv[ii]);
                                n++;
                                nn++;
                                }
                        }                                                                                      
                }       
        }
message("shout",HIR"【系统】"+temp+HIR"内所有的垃圾经已清理完毕，共计"+nn+"个垃圾。\n"NOR,users());                
i++;
call_out("clear_weapon",2+random(3),i);
}

int update_weapon()
{
int n,i;
object weapon,*usr;
string temp;    
message("shout",HIG"\n【系统】武器更新经已开始。\n"NOR,users()); 
n = 0;
usr = users();
if ( !wizardp(this_player()) )  return 0;
i = sizeof(usr);
while(i--)
        {
        if ( !usr[i] ) continue;        
        temp = usr[i]->query("weapon/id");
     if ( !temp || !stringp(temp) )  continue;
        if(objectp(weapon=present(temp,usr[i])))
                {
                all_inventory(environment(usr[i]))->remove_killer(usr[i]);
                usr[i]->remove_all_killer();
                SDS_D->powerup(usr[i]);
                destruct(weapon);
                n++;
                }
        }
message("shout",HIG"\n【系统】武器更新经已结束，共计更新"+n+"个玩家。\n"NOR,users());               
return 1;
}
