#include <ansi.h>
inherit NPC;

int day = 7;    //算7天的损失

string check_me();

void create()
{
set_name(HIG"盘古"NOR,({"pan gu","pangu"}));
set_weight(1000000);
set("unit","个");
set("gender","男性");
set("age",10000000);
set("per",100);
set("inquiry",([
        "补偿"  : (:check_me:),
        "转生"  : "你尚未达到转生的条件。",
]));
setup();
}

void die()
{
object who;
if ( !objectp(who=query_temp("last_damage_from")) )
        {
        SDS_D->powerup(this_object(),1);
        return;
        }
else    {
        message_vision("$N怒道：既然汝如此胆大妄为，那就罢了！\n",this_object(),who);
        who->set("no_pangu_gift",1);
        SDS_D->powerup(this_object(),1);
        return;
        }
}

string check_me()
{
object me = this_player();
int wx;

if ( query("is_busy") )
        return "本尊现在正忙。。。。";
if ( me->query("no_pangu_gift") )
        return "本尊不会理会汝等胆大妄为之徒！";
if ( me->query("pangu_gift") )
        return "你不是已经要过了吗？";
if ( me->query("mud_age")<86400 )  //一天
        return "你有遇到本次天灾吗？";
if ( !("/cmds/std/look.lpc")->main(this_object(),me->query("id")) )
        return "竖子无礼，见过本尊还不现出真身？！";
set("is_busy",1);       
command("ok "+me->query("id"));
wx = me->query("mud_age");
remove_call_out("do_gift");
call_out("do_gift",2+random(4),me,wx);
return "待本尊算算你的成果。。。。";
}

void do_gift(object who,int wx)
{
string str;     
if ( !query("is_busy") )
        return;
if ( !who || !present(who,environment()) )
        {
        command("chat 还有谁没有索要本此天灾的补偿？速来"+environment()->query("short")+"寻某！");
        delete("is_busy");
        return;
        }
str = who->query("name")+"，你已在西游记--神魔传说拼搏了"NOR WHT+FINGER_D->age_string(wx)+NOR HIC"，";       
wx = who->query("combat_exp")*60/wx;
wx*= 60;
if ( wx>50000 )
        wx = 50000;
if ( wx<1 )
        wx = 1;
str+= "平均每天获得武学经验 "NOR WHT+wx+NOR HIC" 点";
wx*= day; 
str+= "天灾历时 "NOR WHT+chinese_number(day)+NOR HIC" 日，故补偿武学经验 "NOR WHT+wx+NOR HIC" 点。\n";

message("shout",HIG"【"HIR"天灾"HIG"】"HIC"盘古(Pangu)："+str,users());

who->add("combat_exp",wx);
tell_object(who,YEL"你得到了"+wx+"点武学经验。\n"NOR);

who->add("daoxing",wx/3);
tell_object(who,YEL"你得到了"+COMBAT_D->chinese_daoxing(wx/3)+"道行。\n"NOR);

who->add("potential",wx/10);
tell_object(who,YEL"你得到了"+wx/10+"点潜能。\n"NOR);

who->set("pangu_gift",1);
delete("is_busy");
return;
}
