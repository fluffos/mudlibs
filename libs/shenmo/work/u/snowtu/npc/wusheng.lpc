#include <ansi.h>
inherit NPC;

void create() {
  set_name("道士", ({ "dao shi", "dao" })); ;
  set("gender", "男性");
  set("age", 33);
  set("long", "样子很普通的一位道长，模样有些邋遢。\n");
  set("title", "万剑灭魔");
  set("combat_exp", 80000000);
  set("daoxing", 55000000);
  set("attitude", "peaceful");
  set("int", 25);
  set("class", "xian");
  create_family("武圣门", 18, "灭魔道长");
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 12000);
  set("max_force", 6000);
  set("mana", 12000);
  set("max_mana", 6000);
  set("mana_factor", 450);
  set("force_factor", 400);

  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_skill("parry", 500);
  set_skill("spells", 500);
  set_skill("feisheng", 500);
  set_skill("literate", 500);
  set_skill("sword", 500);
  set_skill("wuying", 500);
  set_skill("fumobashi", 500);
  set_skill("mizongbu", 500);
  set_skill("dodge", 500);
  set_skill("force", 500);
  set_skill("xiantian", 500);

  map_skill("spells", "feisheng");
  map_skill("unarmed", "fumobashi");
  map_skill("force", "xiantian");
  map_skill("sword", "wuying");
  map_skill("parry", "wuying");
  map_skill("dodge", "mizongbu");
  setup();
  carry_object("/d/mojie/obj/tongjia")->wear();
  carry_object("/d/lingtai/obj/sword")->wield();
}

void kill_ob(object who) {
  object weapon;
  object me = this_object();
  if (!who)
    return;
  if (this_object()->is_fighting()) {
    if (!this_object()->is_fighting(who)) {
      remove_killer(who);
      who->remove_killer(this_object());
      message_vision(CYN "$N" CYN "朝$n" CYN "摇了摇头：一个一个的来。\n" NOR, this_object(), who);
      return;
    } else {
      ::kill_ob(who);
      if (!("/cmds/std/perform.lpc")->main(this_object(), "fenge")) {
        weapon = new("/d/city/npc/obj/sword");
        weapon->set("no_drop", 0);
        weapon->set("value", 0);
        weapon->move(me);
        command("wield sword");
        command("perform fenge");
      }
    }
  } else {
    if (query_temp("copyed") == who)
      ::kill_ob(who);
    else {
      if (!SDS_D->random_family(this_object(), who, who->query("level") * 2, "武圣门")) {
        remove_killer(who);
        who->remove_killer(this_object());
        message_vision(CYN "$N" CYN "朝$n" CYN "摇了摇头：待会来。\n" NOR, this_object(), who);
        return;
      } else set_temp("copyed", who);
      if (!query_temp("getdd/zhenshens")) command("zhenshens changeup");
      ::kill_ob(who);
      if (!("/cmds/std/perform.lpc")->main(this_object(), "fenge")) {
        weapon = new("/d/city/npc/obj/sword");
        weapon->set("no_drop", 0);
        weapon->set("value", 0);
        weapon->move(me);
        command("wield sword");
        command("perform fenge");
      }

    }
  }
}

void die() {
  if (query("force") > 500) {
    SDS_D->addEffKee(this_object());
    SDS_D->addKee(this_object());
    SDS_D->addEffSen(this_object());
    SDS_D->addSen(this_object());
    set_heart_beat(1);
    return;
  }
  ::die();
}

void unconcious() {
  die();
}

void heart_beat() {
  object weapon, me = this_object();
  string str;
  ::heart_beat();

  if (query("eff_kee") < query("max_kee"))
    SDS_D->addEffKee(me);
  if (query("kee") < query("eff_kee"))
    SDS_D->addKee(me);
  if (query("sen") < query("eff_sen"))
    SDS_D->addSen(me);
  if (query("eff_sen") < query("max_sen"))
    SDS_D->addEffSen(me);

  if (!me->is_fighting() || !living(me))
    return;
  if (objectp(query_temp("weapon")))
    str = query_temp("weapon")->query("skill_type");
  else str = "unarmed";
  SDS_D->randomPfm(this_object(), str);
  if (time() >= query_temp("add_force") + 3) {
    add("force", 500);
    set_temp("add_force", time());
  }
  if (time() >= me->query_temp("wusheng_pfm_fenge") + 2 + random(5)) {
    if (!("/cmds/std/perform.lpc")->main(this_object(), "fenge")) {
      weapon = new("/d/city/npc/obj/sword");
      weapon->set("no_drop", 0);
      weapon->set("value", 0);
      weapon->move(me);
      command("wield sword");
      command("perform fenge");
    }
  }
}

int accept_fight(object who) {
  kill_ob(who);
  return 1;
}
