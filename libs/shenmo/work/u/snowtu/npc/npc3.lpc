//战斗类npc
#include <ansi.h>
inherit NPC;

void create()
{
object ob;
set_name("土匪",({"tu fei"}));
set("max_force",8000);
set("max_mana",8000);
set("max_kee",5000);
set("max_sen",5000);
set("combat_exp",50000000);
set("daoxing",5000000);

set_skill("dodge",800);
set_skill("unarmed",800);
set_skill("parry",800);
set_skill("sword",800);
set_skill("blade",800);
setup();
ob = new("/d/obj/baowu/"+sprintf("%s",({"leizhu","fengzhu","huozhu","shuizhu","tuzhu","shengzhu"})[random(6)]));
ob->set_name("妖精之泪",({"yaojing lei"}));
ob->move(this_object());
ob = new("/d/city/npc/obj/armor");
ob->set_name(HIM"妖精之甲"NOR,({"yaojing jia"}));
ob->move(this_object());
command("wear all");
set_temp("apply/armor",300);
}

int invocation()
{
object obj,who;
int flag;
mapping name;
string *t,type,*types;

who = new("/d/city/npc/libai");
if ( !who )
        return 0;
who->move("/d/city/center");        
if ( !SDS_D->random_family(this_object(),who,400 ) )
        return 0;

name = NAME_D->random_name(({"male","female"})[random(2)]);
set_name(name["name"],name["id"]);
if ( stringp(name["title"]) && strlen(name["title"])>3 )
        set("title",name["title"]);
else    set("title",YEL"千年"NOR"妖怪");        
set("haojie_yaoguai",1);
this_object()->save();
message("channel:rumor",HIG"【"NOR HIW" 降妖除魔 "NOR HIG"】"HIC"李靖(Li jing)：北魔窟开，妖魔横行，下界诸生小心了！\n"NOR,users());
this_object()->move(environment(who));
message_vision("$N走了过来。\n\n"NOR,this_object());
message_vision("$N用一种异样的眼神扫视着在场的每一个人。\n", this_object());
destruct(who);
return 1;
}

void heart_beat()
{
string skill,exert;
int i;
object env,weapon,*inv;
object obj,who,me = this_object();
::heart_beat();

env = environment();
inv = all_inventory(env);
if ( !env->query("exits") )
        {
        die();
        return;
        }
if ( env->query("no_magic") || env->query("no_fight") || env->query("alternative_die") )
        {
        random_move();
        return;
        }

if ( !me->is_fighting() )
        {
        SDS_D->powerup(me,1);   
        message_vision("$N用一种异样的眼神扫视着在场的每一个人。\n", this_object());
        i = sizeof(inv);
        if ( i<1 )
                {
                random_move();
                return;
                }
        while(i--)
                {
                if ( inv[i]==me || wizardp(inv[i]) )
                        continue;
                if ( inv[i]->query("haojie_yaoguai") )          
                        continue;
                if ( !living(inv[i]) || ( userp(inv[i]) && inv[i]->query_skill("force",1)<150 ) )
                        continue;
                else    {
                        message_vision("$N对着$n喝道："+RANK_D->query_self_rude(inv[i])+"看你实在很不顺眼，去死吧。\n", me, inv[i]); 
                        me->kill_ob(inv[i]);
                        break;
                        }
                }
        }
else    {                
        if ( query("eff_kee") < query("max_kee") )
                SDS_D->addEffKee(me);
        if ( query("eff_sen") < query("max_sen") )
                SDS_D->addEffSen(me);
        if ( query("kee") < query("eff_kee") )
                SDS_D->addKee(me);
        if ( query("sen") < query("eff_sen") )
                SDS_D->addSen(me);
        if ( objectp(weapon=me->query_temp("weapon")) )
                skill = weapon->query("skill_type");
        else    skill = "unarmed";

        switch(random(10))
                {
                case 0 :
                case 1 :
                case 9 :
                case 8 :
                case 2 : SDS_D->randomPfm(me,skill);break;
                case 3 :
                case 7 :
                case 6 : SDS_D->randomCast(me);break;
                default: SDS_D->randomExert(me);
                }
        }
}

void die()
{
int pot;
object who;
object me = this_object();

message_vision("$N见势不好，一声“扯呼”，跑的无影无踪。。。\n",me);
who = query_temp("last_damage_from");
if ( who && present(who,environment()) )
        {
        SDS_D->powerup(me);
        me->remove_killer(who);
        who->remove_killer(me);

        pot = me->query("combat_exp")-who->query("combat_exp");
        if ( pot>50000 ) pot = 50000;
        if ( pot<1000 )  pot = 1000;
        pot = random(pot);
        if ( pot>0 )
                {
                who->add("combat_exp",pot);
                message("channel:chat",sprintf(HIG"【"NOR HIW" 降妖除魔 "NOR HIG"】"HIC"李靖(Li jing)：%s"HIC"杀死了%s"HIC",得到了%d"HIC"点武学的奖励。\n"NOR,
                               who->name(),me->name(),pot),
                        users());
                who->save();
                tell_object(who,YEL"\n你杀死了一个妖魔，你的经验上升了。\n"NOR);
                }
        }
destruct(me);
}


