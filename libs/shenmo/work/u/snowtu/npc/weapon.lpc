inherit NPC;

void create()
{
set_name("眠兔",({"Snowtu"}));
setup();
}

void init()
{
add_action("do_huifu","huifu");
}

varargs int do_huifu(string arg,int flag)
{
string w_id,id;
object weapon,who;
object me = this_player();
if ( !arg || !wizardp(me) )
        return 0;
if ( !objectp(who=find_player(arg)) )
        return notify_fail("no this player.\n");
id = getuid(who);
write("player's id="+id+".\n");
w_id = who->query("weapon/id");
write("weapon's id="+w_id+".\n");
weapon = find_player(w_id);
if ( !weapon )
        {
        write("can't find object:find_player("+w_id+").\n");
        weapon = LOGIN_D->find_body(w_id);
        }
if ( !weapon )
        return notify_fail("can't find.\n");

if ( weapon->query("owner")!=id )
        {
        weapon->move(me);
        write("owner is not "+id+".\n");
        if ( flag )
                {
                if ( weapon->set("owner",id) )
                        {
                        weapon->save();
                        write(" set ok.\n");
                        weapon->move(who);
                        }
                }
        }
write("ok.\n");
return 1;
}       

