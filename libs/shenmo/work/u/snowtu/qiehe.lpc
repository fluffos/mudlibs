#include <ansi.h>
inherit PERFORM;

int check_time() {
  object me = this_player();
  int time = me->query_skill("huoxin-sword");
  time -= me->query("bellicosity");
  time /= 60;
  time = 10 - time;
  if (time < 1)
    time = 1;
  if (time > 5)
    time = 5;
  if (wizardp(me))
    tell_object(me, "time = " + time + "\n");
  return time;
}

void create() {
  set("name", "切合术");
  set("target", 1);
  set("family", "剑客联盟");
  set("class", "human");
  set("betray_lvl", 350);
  set("persent", 150);
  set("belong", "huoxin-sword");
  set("base_type", "sword");
  set("belong", "huoxin-sword");
  set("force", 300);
  set("need_force", 50 + random(50));
  set("limit_skill", ([
    "sword": 60,
    "huoxin-sword": 60,
    "dodge": 60,
    "kongshoudao": 60,
    "unarmed": 60,
    "parry": 60,
  ]));
  set("enable", ([
    "sword": "huoxin-sword",
    "unarmed": "kongshoudao",
    "parry": "huoxin-sword",
  ]));
  set("temp", "japan_qiehe");
  set("temp_time", (: check_time :));
}

int check_damage(object me, object target) {
  int damage;
  damage = me->query_skill("huoxin-sword", 1);
  damage += me->query_skill("sword", 1);
  damage += me->query("force_factor");
  damage -= me->query("bellicosity");
  damage += me->query_temp("apply/damage");
  damage -= target->query_temp("apply/armor");
  damage = damage / 2 + random(damage / 2);
  damage *= 5;

  if (damage < 100)
    damage = 100;
  if (wizardp(me))
    tell_object(me, "damage = " + damage + ".\n");
  return damage;
}

void hit_msg(object me, object target, int num) {
  int damage;
  string msg;
  object weapon;
  if (me && target && present(target, environment(me)) && num) {
    weapon = me->query_temp("weapon");
    msg = YEL "$N" YEL "双手握住$w" YEL "高高举起，摆了一个上段位的架势。脚下加紧移动的
速度，围着$n" YEL "快速的游走。一时间$n" YEL "的面前净是晃动的人影。\n" NOR;
    msg = replace_string(msg, "$w", weapon->name());
    if (me->query("family/family_name") == "剑客联盟")
      set("persent", 200);
    damage = check_damage(me, target);
    if (damage > 2000)
      set("damage_type", "kee");
    else set("damage_type", "eff_kee");
    set("damage", damage);
    message_vision(msg, me, target);
  }
}

void success_hit_msg(object me, object target, int num) {
  string msg;
  if (me && target && present(target, environment(me)) && num) {
    msg = YEL "\n”叱“$N" YEL "忽地大喝一声，身形一顿，手中长剑猛的劈下！这一招似流星一般
迅疾，带着压迫天地的气势化作一道咆哮的光影" NOR;
    if (query("damage_type") == "kee")
      msg += YEL "朝着$n" YEL "当头就是一击！！\n\n" NOR;
    else msg += YEL "朝着$n" YEL "的要害直奔而去！\n\n" NOR;
    msg += YEL "$n" YEL "被这一招的气势完全震住，被击了正着！\n" NOR;
    message_vision(msg, me, target);
    me->set_temp("pfm_jiehe_to", target);
  }
}

void lost_hit_msg(object me, object target, int num) {
  if (me->is_fighting(target) && num) {
    message_vision(YEL "\n$N" YEL "围着$n" YEL "游走片刻，却难觅其防御中的空隙，不由一阵心急。
$N" YEL "见久战无功，乃换招直接攻向$n" YEL "。\n\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }
}

void normal_hit_msg(object me) {
  if (me)
    message_vision(YEL "\n$N" YEL "游走片刻，却久战无功，不由撤招变式。\n\n" NOR, me);

}

void remove_eff(object me, string temp) {
  string msg;
  object target;
  int ap, dp, pot, damage, type;
  if (!me || !me->query_temp(temp))
    return;
  target = me->query_temp("pfm_jiehe_to");
  damage = query("damage");
  if (target && me->is_fighting(target)) {
    ap = me->query("combat_exp");
    dp = target->query("combat_exp");

    if (me->query_skill("huoxin-sword", 1) >= 350
      && me->query_skill("sword", 1) >= 350
      && me->query_skill("kongshoudao", 1) >= 350
      && me->query_skill("dodge", 1) >= 350) {
      msg = YEL "\n$N" YEL "一击完成，又是一声大喝，那压迫天地的气势随之又起！但见$P
双手将剑擎住指地，全身真气四溢，大喝声中整个人向前大踏一步！\n" NOR;
      msg += YEL "$n" YEL "立时只觉进退之路皆在$N" YEL "的控制之中，不禁心惊胆战，
哪里还有心情恋战。\n" NOR;
      msg += YEL "$N" YEL "握剑上撩，剑刃带着一抹触目的艳丽寒光从$n" YEL "胸前掠过。\n" NOR;
      msg += YEL "$n" YEL "只觉要害一阵疼痛，无心恋战，踉跄而退，洒出一路热血！\n" NOR;
      damage += damage;
      msg += YEL + COMBAT_D->damage_msg(damage, "重伤") + NOR;
      type = 1;
    } else if (me->query_skill("huoxin-sword", 1) >= 250
      && me->query_skill("sword", 1) >= 250
      && me->query_skill("kongshoudao", 1) >= 250
      && me->query_skill("dodge", 1) >= 250) {
      msg = YEL "\n$N" YEL "大喝声中并不停招，整个人顺势握住长剑，团作一团，连人
带剑夹带着前招的余势撞向$n" YEL "！\n" NOR;
      if (ap > random(dp / 3)) {
        msg += YEL "$n" YEL "尚未站稳脚步，哪里还躲得开此招？给撞得个人仰马翻。\n" NOR;
        damage += damage / 2;
        msg += YEL + COMBAT_D->damage_msg(damage, "内伤") + NOR;
        type = 2;
      } else {
        msg += YEL "$n" YEL "心中早有提防，连忙跃身闪开。\n" NOR;
        type = 3;
      }
    } else {
      msg = YEL "$N" YEL "招式去势已竭，不待变招，一个旋身，对着$n" YEL "“刷刷刷”就是三剑！\n" NOR;
      type = 4;
    }
    message_vision(msg, me, target);
    switch (type) {
      case 1:
        target->receive_wound("kee", damage);
        COMBAT_D->report_status(target, damage);
        break;
      case 2:
        target->receive_damage("kee", damage);
        COMBAT_D->report_status(target);
        break;
      case 3:
        break;
      default:
        for (type = 0; type < 3; type++)
          COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    }
  } else {
    msg = YEL "\n$N" YEL "将剑缓缓的放低于胸前，长嘘了一口气。\n\n" NOR;
    message_vision(msg, me);
  }
  me->delete_temp(temp);
  me->delete_temp("pfm_jiehe_to");
}
