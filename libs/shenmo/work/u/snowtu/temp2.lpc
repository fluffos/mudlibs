#include <ansi.h>
inherit ROOM;
#include "/cmds/std/valid_move.h"

int num;

void create()
{
string msg,str;
if ( num<=0 )
        num = 0;
num++;

msg = NOR+"\t\t"
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█\n"NOR;
msg+= NOR+"\t\t"
     +BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR
     +"%s"
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█\n"NOR;
msg+= NOR+"\t\t"
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█\n"NOR;
//msg = replace_string(msg,"█",NOR BLINK BGRN+RED RED"█"NOR BLINK BRED);
str = sprintf(HBMAG HIY" 第%s届三界争霸战 "NOR,chinese_number(num));
msg = sprintf(msg,str);

set("short","擂台下");
set("long","\n"+msg);
set("no_fight",1);
set("no_magic",1);
seteuid(getuid());

setup();
}

void greating(object who,string str)
{
if ( !who )
        return;
tell_object(who,"\n\n"+str+"\n");
who->set_temp("三界战/look_msg",1);
}

void init()
{
string msg,str;
object me = this_player();
if ( !userp(me) )
        return;
SDS_D->check_player(me);
add_action("do_fight","fight");
add_action("do_fight","kill");
add_action("do_xuanzhan","xuanzhan");
if ( me->query_temp("三界战/look_msg") )
        return;

msg = NOR+"\t"
     +BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR+BLINK BCYN"█"NOR+BLINK BGRN+GRN"█"NOR
     +BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR+BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR
     +BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR+BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR
     +BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR+BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR
     +BLINK BCYN"█\n"NOR;
msg+= NOR+"\t"
     +BLINK BGRN+CYN"█"NOR
     +"%s"
     +BLINK BCYN"█\n"NOR;
msg+= NOR+"\t"
     +BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR+BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR
     +BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR+BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR
     +BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR+BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR
     +BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR+BLINK BCYN"█"NOR+BLINK BGRN+CYN"█"NOR
     +BLINK BCYN"█\n"NOR;
str = sprintf(HBMAG HIY"%30-s"NOR," 挑战：fight 宣战: xuanzhan ");
msg = sprintf(msg,str);
remove_call_out("greeting");
call_out("greating",3+random(5),me,msg);
}

int do_fight(string arg)
{
object who,where,me = this_player();
string type,msg = "";

if ( !arg )
        return 0;
who = present(arg);
if ( !who || !userp(who) || who==me )
        return 0;

if ( query_temp("last") )
        {
        tell_object(me,"三界战业已结束。\n");
        return 1;
        }

if ( who->query_temp("三界战/win/"+me->query("id")) )
        {
        tell_object(me,"你已败给他了。\n");
        return 1;
        }

if ( who->query_temp("三界战/lost/"+me->query("id")) )
        {
        tell_object(me,"你已战胜过他了。\n");
        return 1;
        }

if ( who==me->query_temp("三界战/accept") )
        {
        msg+= "$n同意和$N来一场比赛。\n";
        message_vision(msg,me,who);
        where = clone_object(__DIR__"ground");
        if ( !where )
                return 1;
        msg = HIG"\n$N"HIG"与$n"HIG"双双跳上了擂台！\n\n"NOR;
        message_vision(msg,me,who);
        type = me->query_temp("三界战/type");
        me->move(where);
        who->move(where);
        me->delete_temp("三界战/accept");
        me->delete_temp("三界战/to_fight");
        who->delete_temp("三界战/accept");
        who->delete_temp("三界战/to_fight");
        msg = sprintf(HIR" %s "HIC"与"HIR" %s "HIC"双双入场，开始了为时"HIY" 五分 "HIC"的"HIR" %s "HIC"！\n"NOR,
                        me->name(),who->name(),type );
        message("channel:chat",WHT"【"NOR HIG"三界战"NOR WHT"】"NOR+msg,users());
        return 1;
        }

if ( who->query("class")!=me->query("class") )   //三界战
        {
        if ( !me->query_temp("三界战/系")
          || !who->query_temp("三界战/系") )
                {
                tell_object(me,"你们之间条件不够，打不了。\n");
                return 1;
                }
        }

if ( !valid_move(me) )
        return 0;
if ( who->query("family/family_name")!=me->query("family/family_name") )  //同系战
        {
        if ( !me->query_temp("三界战/门派")
          || !who->query_temp("三界战/门派") )
                {
                tell_object(me,"你们之间条件不够，打不了。\n");
                return 1;
                }
        if ( query_temp(me->query("class")) )
                {
                tell_object(me,"此界同界战业已结束。\n");
                return 1;
                }
        }
if ( !living(who) )
        {
        tell_object(me,"对方现在这种状态，看来是和你打不了。\n");
        return 1;
        }
if ( !valid_move(who) )
        return 0;

if ( query_temp(me->query("family/family_name")) )
        {
        tell_object(me,"此派同门战业已结束。\n");
        return 1;
        }

if ( objectp(who->query_temp("三界战/accept")) )
        {
        tell_object(me,"对方正接到"+who->query_temp("三界战/accept")->name()+"的挑战呢。\n");
        return 1;
        }
if ( objectp(me->query_temp("三界战/to_fight")) )
        {
        if ( who==me->query_temp("三界战/to_fight") )
                {
                tell_object(me,"你已经向他提出挑战了。\n");
                return 1;
                }
        tell_object(me->query_temp("三界战/to_fight"),me->name()+"见你不去应战，放弃了和你决战。\n");
        me->query_temp("三界战/to_fight")->delete_temp("三界战/accept");
        me->delete_temp("三界战/to_fight");
        msg+= "$N见"+(me->query_temp("三界战/to_fight"))->name()+"好久不来应战，认为他怕了，决定放其一马。\n";
        }
msg+= "$N决定和$n一决高下！\n";
message_vision(msg,me,who);
me->set_temp("三界战/to_fight",who);
who->set_temp("三界战/accept",me);
who->start_busy(5);
me->start_busy(5);
tell_object(who,sprintf(YEL"如果你愿意和对方进行比试，请你也对%s(%s)下一次 fight 指令。\n"NOR,me->name(),me->query("id")) );
tell_object(me,YEL"由于对方是由玩家控制的人物，你必须等对方同意才能进行比试。\n"NOR);
if ( me->query("family/family_name")==who->query("family/family_name") )
        type = "门派战";
else if ( me->query("class")==who->query("class") )
        type = "同界战";
else    type = "三界战";

who->set_temp("三界战/type",type);
me->set_temp("三界战/type",type);

return 1;
}

int do_xuanzhan()
{
string str,msg,type;
object me = this_player();
if ( me->query_temp("三界战/all") )             //已完成三界之站
        return notify_fail("你已赢得了三界之战了。\n");

else if ( me->query_temp("三界战/系") ) //已完成门派之站
        {
        type = "三界";
        str = "all";
        }

else if ( me->query_temp("三界战/门派") )       //已完成门派之站
        {
        type = to_chinese(me->query("class"));
        str = "系";
        }
else    {
        type = me->query("family/family_name");
        str = "门派";
        }
msg = sprintf(HIC"%s(%s)：今日某当接掌"HIY" %s "HIC"之首席头衔，如有不服者，来与某一战！\n"NOR,
                me->name(),capitalize(me->query("id")),type);
message("shout",WHT"【"NOR HIG"三界战"NOR WHT"】"NOR+msg,users());
me->start_call_out( (: call_other, __FILE__, "check_me",me,str :),30);
return 1;
}

void check_me(object me,string str)
{
string data,msg;
if ( !me )
        return;
if ( me->query_temp("三界战/"+str) )
        return;
if ( !present(me) )
        return;
if ( me->is_fighting() )
        return;
if ( !living(me) )
        return;
switch(str)
        {
        case "三界" :
                data = "last";
                break;
        case "系" :
                data = "class";
                break;
        case "门派" :
                data = me->query("family/family_name");
                break;
        default :
                return;
        }
me->set_temp("三界战/"+str,1);
this_object()->set_temp(data,1);
msg = sprintf(HIC"三界众神：%s(%s)今日接掌了"HIY" %s "HIC"之首席头衔！\n"NOR,
                me->name(),capitalize(me->query("id")),str);
message("shout",WHT"【"NOR HIG"三界战"NOR WHT"】"NOR+msg,users());
me->set("title",HIR+str+"首席高手 "NOR+me->query("title") );
return;
}               
