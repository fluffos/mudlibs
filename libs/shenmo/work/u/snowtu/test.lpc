inherit ITEM;

void create() {
  set_name("圆规", ({ "yuan gui", "da chang tui", }));
  set("unit", "个");
  setup();
}

void init() {
  add_action("do_test", "test");
}

void get_input(string arg, object me) {
  int n, z;
  string msg;
  if (!me)
    return;
  if (!stringp(msg = me->query_temp("YZ_quest/msg")))
    return;
  if (!arg || strlen(arg) < 1
    || sscanf(arg, "%d", n) != 1) {
    tell_object(me, msg);
    input_to("get_input", me);
    return;
  }
  z = me->query_temp("YZ_quest/answer");
  if (n != z) {
    tell_object(me, "正确答案是" + z + "，你回答的是" + n + "。\n");
    me->set("mark/last_Qest", time());
    me->delete_temp("YZ_quest");
    return;
  }
  tell_object(me, "回答正确。\n");
  me->delete_temp("YZ_quest");
  return;
}

int do_test() {
  string msg;
  object me = this_player();
  if (!("/u/snowtu/coded.lpc")->init_quest(me)) {
    write("啥反应也没。\n");
    return 1;
  }
  if (!stringp(msg = me->query_temp("YZ_quest/msg"))) {
    write("啥反应也没?!\n");
    return 1;
  }
  tell_object(me, "\n");
  tell_object(me, msg);
  tell_object(me, "请输入答案:");
  input_to("get_input", me);
  return 1;
}
