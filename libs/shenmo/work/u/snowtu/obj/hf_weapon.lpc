inherit ITEM;
#include <ansi.h>

void create()
{
set_name("武器石",({"weapon stone"}));
set("unit","块");
setup();
}

void init()
{
add_action("do_huifu","huifu");
}

int do_huifu(string arg)
{
string id,name;        
object who,me = this_player();
mapping weapon;
if ( !wizardp(me) 
  || SECURITY_D->get_status(me->query("id"))!="(admin)" )
        return 0;
if ( !arg || sscanf(arg,"%s %s",id,name)!=2 )
        return 0;
who = present(id,environment(me));
if ( !who || !userp(who) )
        who = find_player(id);
if ( !who || !userp(who) )
        return 0;          
name = SDS_D->color_msg(name);                                               
weapon = ([
        "change"        : 1,
        "or"            : "寒丝羽竹",
        "name"          : name,
        "type"          : ([
                "unarmed" : 1,
                "sword"   : 50,
                ]),
        "time"          : "壬申年十月三日亥时二刻",
        "value" : 530,
        "id" : "xhsword",
        "make" : 1,
        "lv"   : 10,
]);
who->set("weapon",weapon);
if ( who->save() )
        CHANNEL_D->do_channel(who,"rumor","听说"+me->query("id")+"恢复了"+who->query("id")+"的自制武器："+name+NOR+HIM"。\n"NOR);
write("ok\n");
return 1;
}
