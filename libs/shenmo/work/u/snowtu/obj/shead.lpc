inherit ITEM;

string msg = @LONG
 
        BLINK好大一个老鼠头~~~~NOR  

YEL     .--,NOR       YEL.--,NOR
YEL    (NORREVYEL (  NORYEL\.---./NORREVYEL  ) NORYEL)NOR
YEL     '.NORREVYEL__NORYEL/NORHBYELHIRoNORREVYEL   NORHBYELHIRoNORYEL\NORREVYEL__.'NOR
YEL        {NORHBYELHIW=NORREVYEL  NORHBYELHIW^NORREVYEL  NORHBYELHIW=NORYEL}NOR
YEL         >NORREVYEL  -  NORYEL<NOR
YEL        /NORREVYEL       NORYEL\NOR
YEL       //NORREVYEL       NORYEL\\NOR
YEL      //|NORREVYEL   NORHBYELHIR.NORREVYEL   NORYEL|\\NOR
HIR      "'NORYEL\NORREVYEL       NORYEL/NORHIR'"NORYEL_.-~^`'-.NOR
YEL         \NORREVYEL  _  NORYEL/--'NOR         YEL`NOR
YEL       ___)( )(___NOR
YEL      (((NORREVYEL__NORYEL) (NORREVYEL__NORYEL)))NOR

LONG;


void create()
{
        set_name("鼠头",({"tou"}));
        set("unit","个");
        set("value",0);
        set("long","好大的鼠头。\n");
        setup();
}

void init()
{
        if( wizardp(this_player()) )
                add_action("do_pig","pig");
}

int do_pig(string arg)
{
        object who;
        
        if( !arg )
                return 0;
        who = present(arg,environment(this_player()));
        if( !who || !living(who) )
                return 0;
        msg = SDS_D->color_msg(msg);
        msg = who->short()+"。\n"+msg;
        who->set_temp("apply/long",({msg}));
        message_vision("$N给$n一个鼠头，$n高高兴兴的戴在了头上。\n",this_player(),who);
        return 1;
}

