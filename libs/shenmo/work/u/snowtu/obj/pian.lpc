#include <ansi.h>
#include <dbase.h>
#include <name.h>

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

nosave int amount;
nosave int add_pot;
nosave string clr="";

int query_add_pot()
{
return add_pot;
}

int query_amount()
{
return amount;
}

void set_amount(int v)
{
object dest;

if ( v<0 )
        {
        amount=0; // mon 4/16/98
        call_out("destruct_me", 1);
        error("combine:set_amount less than 1.\n");
        }
if( v==0 )
        {
        amount = 0; // mon 4/16/98
        seteuid(getuid());
        dest=load_object("/cmds/std/quitroom");
        if(environment(this_object())!=dest)
                ::move(dest,1); // use the old move(), so
            // that won't recursively call set_amount.
        call_out("destruct_me", 1);
        }
else    {
        amount = v;
        this_object()->set_weight(v * (int)query("base_weight"));
        }
}

void add_amount(int v)
{
set_amount(amount+v);
}

string short()
{
return chinese_number(query_amount()) + query("base_unit")+::short();
}

varargs int move(mixed dest, int silent)
{
object env, *inv;
int i, total, total0, result;
string file;
result= ::move(dest, silent);
if ( env=environment() )
        {
        file = base_name(this_object());
        inv = all_inventory(env);
        total = (int)query_amount();
        total0=total;
        for( i=0;i<sizeof(inv);i++ )
                {
                if( inv[i]==this_object()
                 || inv[i]->query("pian_type")!=this_object()->query("pian_type")
                 || inv[i]->query("name")!=this_object()->query("name")
                 || inv[i]->query("equipped")=="wear" )
                        continue;
                if ( base_name(inv[i])==file )
                        {
                        total += (int)inv[i]->query_amount();
                        destruct(inv[i]);
                        }
                }
        if ( total!=total0 )
                set_amount(total);
        add_pot*= this_object()->query_amount();
        }
return result;
}
void set_add_pot(int n)
{
if ( n<=0 )
        n = 0;
if ( n>10 )
        n = 10;
add_pot = n;
}

void create()
{
string name,*n,*ids,*colors;
mapping names = ([
        "朱雀"  : "zhu que",
        "玄武"  : "xuan wu",
        "青龙"  : "qing long",
        "白虎"  : "bai hu",
        "凤凰"  : "feng huang",
        "大鹏"  : "da peng",
        "白猿"  : "bai yuan",
        "金猴"  : "jin hou",
        "狻猊"  : "suan ni",
        "猛犸"  : "meng ma",
        "夜狼"  : "ye lang",
        "鸱鸠"  : "chi jiu",
        "椒图"  : "shu tu",
        "金猊"  : "jin ni",
        "蚣蝮"  : "gong fu",
        "饕餮"  : "tao tie",
        "螭吻"  : "chi wen",
        "睚眦"  : "ya zi",
        "狴犴"  : "bi an",
        "蒲牢"  : "pu lao",
        "霸下"  : "ba xia",
]);
colors = ({
        RED"",YEL"",BLU"",MAG"",CYN"",WHT"",
        HIR"",HIY"",HIB"",HIM"",HIC"",HIW"",
        HBRED"",HBGRN"",HBYEL"",HBBLU"",HBMAG"",HBCYN"",HBWHT"",
        BRED"",BGRN"",BYEL"",BBLU"",BMAG"",BCYN"",
});
n = keys(names);
name = n[random(sizeof(n))];
ids = ({names[name]+" po","po shi","po","shi"});
clr = colors[random(sizeof(colors))];
name= clr+name+({"魄","石"})[random(2)]+NOR;
set_name(name,ids);
set_weight(5000);
set_add_pot(1+random(5));
if ( clonep(this_object()) )
        set_default_object(__FILE__);
set("long",clr+"这传说是远古封神时诸位散仙散落在各地的魔法魄石。\n"NOR);
set("unit","些");
set("base_unit","块");
set("no_sell",clr+"这些并非凡间之物。\n"NOR);
set("pian_type","kee");
set("value",0);
set("持久",10);
set_amount(1);
}

private void destruct_me()
{
write(clr+"\n"+this_object()->name()+clr+"“喀嘣”一声，碎成了一堆粉末。\n\n"NOR);
destruct(this_object());
}

void check_owner()
{
if ( query("持久")<=0 )
        {
        message_vision(clr+"\n$N"+clr+"“喀嘣”一声，出现了一道裂痕。\n\n"NOR,this_object());
        this_object()->add_amount(-1);
        }
}

void init()
{
check_owner();
if ( environment()==this_player() )
        {
        add_action("do_wear","wear");
        add_action("do_remove","remove");
        }
}

int do_wear(string arg)
{
object me = this_player();
object ob = this_object();

if ( !arg || !id(arg) )
        return 0;
if ( me!=environment() )
        return 0;
if ( me->query_temp("armor/po") )
        {
        if ( !objectp(me->query_temp("armor/po")) )
                {
                me->delete_temp("armor/po");
                me->reset_action();
                }
        else    {
                tell_object(me,"你已经装备了其他魄石了。\n");
                return 1;
                }
        }
if ( ob->query("equipped")=="wear" )
        {
        tell_object(me,clr+"你已装备上魄石了。\n"NOR);
        return 1;
        }
message_vision(clr+"$N"+clr+"拿起一些$n"+clr+"一阵摩擦，只见"+chinese_number(ob->query_amount())+clr+"道霞光在$P四周围绕。\n"NOR,me,ob);
ob->set("equipped","wear");
me->add_temp("apply/armor",1*ob->query_amount());
me->set_temp("armor/po",ob);
return 1;
}

int do_remove(string arg)
{
object me = this_player();
object ob = this_object();

if ( !arg || !id(arg) )
        return 0;
if ( me!=environment() )
        return 0;
if ( ob->query("equipped")!="wear"
  || me->set_temp("armor/po")!=ob )
        {
        tell_object(me,clr+"你还没有装备魄石。\n"NOR);
        return 1;
        }
message_vision(clr+"$N"+clr+"将$n"+clr+"取了下来。\n",me,ob);
ob->delete("equipped");
me->add_temp("apply/armor",-1*ob->query_amount());
me->delete_temp("armor/po");
return 1;
}


