#include <ansi.h> 
inherit ITEM; 
        
void create() 
{ 
set_name("昊天镜",({"haotian jing","jing"})); 
set_weight(1000); 
set("unit","面"); 
setup(); 
} 

void init() 
{ 
add_action("do_clr","clear"); 
} 

int do_clr(string dir)
{
object *obj,me = this_player();
string *dirs,*files,file;
int i,k,j,flag=0;

if ( !dir || !stringp(dir) )
        flag = 1;
        
//第一次根目录
if ( flag )
        dir = "/d/eastway/qinling/";
dirs = get_dir(dir);
for(i=0;i<sizeof(dirs);i++)
        {
        file =  dirs[i];
        if ( file && sscanf(file,"%s.lpc",file) )
                {
                if ( ("/cmds/wiz/mv.lpc")->main(me,sprintf("%s.c %s.b",file,file)) )
                        write(dir+file+".c改名成功\n");
                obj = children(dir+file+".lpc");
                for(k=0;k<sizeof(obj);k++)
                        {
                        if ( obj[k] )
                                destruct(obj[k]);
                        }
                }
        }
if ( !flag )
        return 1;
        
//子目录
files = ({
        "/d/eastway/qinling/npc/",
        "/d/eastway/qinling/obj/",
        "/d/eastway/qinling/digong1/",
        "/d/eastway/qinling/digong1/npc/",
        "/d/eastway/qinling/digong1/obj/",
        "/d/eastway/qinling/digong2/",
        "/d/eastway/qinling/digong2/npc/",
        "/d/eastway/qinling/digong2/obj/",
        "/d/eastway/qinling/digong3/",
        "/d/eastway/qinling/digong3/npc/",
        "/d/eastway/qinling/digong3/obj/",
        "/d/eastway/qinling/digong4/",
        "/d/eastway/qinling/digong4/npc/",
        "/d/eastway/qinling/digong4/obj/",
        "/d/eastway/qinling/digong5/",
        "/d/eastway/qinling/digong5/npc/",
        "/d/eastway/qinling/digong5/obj/",
        "/d/eastway/qinling/digong6/",
        "/d/eastway/qinling/digong6/npc/",
        "/d/eastway/qinling/digong6/obj/",
        "/d/eastway/qinling/digong7/",
        "/d/eastway/qinling/digong7/npc/",
        "/d/eastway/qinling/digong7/obj/",
        "/d/eastway/qinling/digong8/",
        "/d/eastway/qinling/digong8/npc/",
        "/d/eastway/qinling/digong8/obj/",
        "/d/eastway/qinling/digong9/",
        "/d/eastway/qinling/digong9/npc/",
        "/d/eastway/qinling/digong9/obj/",
        "/d/eastway/qinling/digong10/",
        "/d/eastway/qinling/digong10/npc/",
        "/d/eastway/qinling/digong10/obj/",
});

for(j=0;j<sizeof(files);j++)
        {
        if ( !files[j] || !stringp(files[j]) )
                continue;       
        dir = files[j];
        dirs = get_dir(dir);
        for(i=0;i<sizeof(dirs);i++)
                {
                file =  dirs[i];
                if ( file && sscanf(file,"%s.lpc",file) )
                        {
                        if ( ("/cmds/wiz/mv.lpc")->main(me,sprintf("%s.c %s.b",file,file)) )
                                write(dir+file+".c改名成功\n");
                        obj = children(dir+file+".lpc");
                        for(k=0;k<sizeof(obj);k++)
                                {
                                if ( obj[k] )
                                        destruct(obj[k]);
                                }
                        }
                }
        }

write("ok\n");
return 1;
}
