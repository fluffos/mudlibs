#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("黄芩平血丸", ({ "huang cen wan","yao","huang","wan" }) );
        set_weight(100);
        set("unit", "粒");
        set("long", "清热燥湿，泻火解毒，凉血。吃了它，能让你的等级降低1级，慎用！\n");
        set("value",20000000);
        setup();
}

void init()
{
        if( this_player()->query("level")>250 )
                add_action("do_eat","eat");
}

int do_eat(string arg)
{
        object yao,me = this_player();
        
        if( !arg ) 
                return 0;
        yao = present(arg,me);
        if( !yao || yao!=this_object() )
                return 0;
        if( me->query("level")<=250 )
        {
                write("你血压不高，吃这个会阴阳失调....\n");
                return 1;
        }
        
        message_vision("$N吃下一粒黄芩平血丸，顿时面色惨白，好似鬼面上身。\n",me);
        me->add("level",-1);
        if( time()>me->query_temp("last_rumor")+10 )    
        {
                CHANNEL_D->do_channel(me,"rumor","听说"+me->query("name")+"吃下了一粒"HIY+query("name")+HIM"！"NOR);
                me->set_temp("last_rumor",time());
        }
        destruct(this_object());
        return 1;
}
