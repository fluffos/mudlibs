#include <ansi.h>
inherit ITEM;

void create() {
  set_name(WHT "照妖镜" NOR, ({ "zhaoyao jing", "jing" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "paper");
    set("unit", "面");
    set("value", 100000);
  }
  setup();
}

void init() {
  add_action("do_zhao", "zhaoyao");
}

int do_zhao(string arg) {
  string *msg_expression = ({
    "脸上露出愉快的微笑。",
    "正躲在一边幸灾乐祸地笑。",
    "脸上露出狡诈的神情，大概又想到了什么坏主意了。",
    "正在绷着个脸扮酷。",
    "捧着肚子笑得前仰后合。",
    "眉头紧锁，不知在想什么心事。",
    "正托着腮帮子作沉思状。",
    "咬牙切齿，一副愤愤不平的样子。",
    "一脸的迷茫，不知道周围发生了什么事。",
    "正在咧着嘴傻乐。",
    "正作天真状。",
    "正在闷闷不乐。",
    "骄傲地昂着头，满脸不屑的神情。",
    "痛苦得呲牙咧嘴，大概是牙痛得厉害。",
    "正强颜欢笑，但掩饰不住心里的哀伤。",
    "正在眉飞色舞。",
    "一脸的尴尬相。",
    "脸上露出灿烂的笑容。",
    "笑得比哭还难看。",
    "正强忍着不让自己哭出来。",
    "媚眼如丝。",
    "正作小鸟依人状。",
    "开怀大笑，露出满嘴的金牙。",
  });

  int size = sizeof(msg_expression);
  int spellme, spellwho, know;
  string str;
  object who, ob = this_object();
  object me = environment(ob);

  if (!arg || (!objectp(who = present(arg, environment(me))) && !objectp(who = find_player(arg)))
    || !living(who))
    return notify_fail("你想照谁？\n");
  if (who == me) {
    message_vision("$N对着$n挠首弄姿，有点自恋....\n", me, ob);
    if (me->query_per() < 10)
      return notify_fail("别照了，猪八戒都比你漂亮...\n");
    else if (me->query_per() < 15)
      return notify_fail("别照了，你比猪八戒都漂亮...\n");
    else if (me->query_per() < 20)
      return notify_fail("别照了，你还有些许姿色...\n");
    else if (me->query_per() < 30)
      return notify_fail("别照了，你也算是美人了...\n");
    else
      return notify_fail("别照了，你是最美的了...\n");
  }

  if (me->query("mana") < 100)
    return notify_fail("你的法力不足。\n");
  me->add("mana", -40);

  spellme = me->query_skill("spells");
  spellwho = who->query_skill("spells");

  if (who->name() != who->query("name")) {
    str = "却见" + who->query("name");
    know = 1;
  } else {
    str = "只见" + who->name();
    know = 0;
  }
  message_vision(WHT "$N" WHT "掏出$n" WHT "迎风展开，只见万道霞光从$n" WHT "上绽放开来，一时间
房间里霞气弥漫，一片祥和。\n" NOR, me, ob);
  message("vision", WHT "照妖镜上霞光渐渐聚成一道光柱朝着" + who->name() + WHT "直射而去！\n" NOR, environment(me), who);
  if (random(3) == 1)
    tell_object(who, HIY "照妖镜上霞光渐渐聚成一道光柱朝着你直射而来！\n" NOR);
  write(WHT "\n\n照妖镜上光华四射，只见" + who->name() + "的面容渐渐显露在镜中，"
    +str + msg_expression[random(size)] + "\n\n");

  if (know == 1 && who->query_temp("apply/name")) {
    write("\n你要运用法力迫使" + who->name() + "现出本形吗？(y/n)[n]");
    input_to("do_force", me, who);
  }
  return 1;
}

void do_force(string yn, object me, object who) {
  if (!objectp(present(who, environment(me)))) {
    write("你的目标已经不在了。\n");
    return;
  }

  if (yn[0] == 'y' || yn[0] == 'Y') {
    if (me->query("mana") <= 100) {
      write("你现在的法力太低了。\n");
      return;
    } else {
      me->add("mana", -100);
      message_vision(
        HIY "$N" HIY "朝$n" HIY "大喝一声：" + RANK_D->query_rude(who) + HIY "！快现原形！\n",
        me,
        who
      );
      message_vision(WHT "\n照妖镜上强光一闪，罩在$n" WHT "身上的光柱越来越烈....\n" NOR, me, who);
      if (random(2) == 0 && who->query_temp("apply/name")) {
        int mana = who->query("mana");
        mana -= 200;
        if (mana < 0) mana = 0;
        who->set("mana", mana);
        message_vision(HIY "\n
只见$N" HIY "浑身松软，瘫倒在地．．．却果然正是一头" + who->query("name") + HIY "！\n" NOR, who);
        who->delete_temp("spellslevel");
        who->delete_temp("d_mana");
        who->delete_temp("apply/name");
        who->delete_temp("apply/id");
        who->delete_temp("apply/short");
        who->delete_temp("apply/long");
        who->delete_temp("no_heal_up/bian");
      } else message_vision(HIY "\n$N" HIY "摇了两摇，总算是没有现出原形....\n" NOR, who);
    }
  }
  return;
}
