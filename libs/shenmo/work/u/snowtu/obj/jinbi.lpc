#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "金币" NOR, ({ "jinbi", "jin bi" }));
  set("long", HIY + @LONG
一枚西游记--神魔传说的硬币，正面是粉肠和唐僧的新婚像，反面是全体巫师的全家福。
LONG + NOR);
  set("no_sell", 0);
  set("no_give", 0);
  set("no_get", 0);
  set("value", 0);
  set("unit", "枚");
  setup();
}

void init() {
  add_action("do_look", "look");
}

int do_look(string arg) {
  int i, amount;
  object *inv, pi, me = this_player();
  if (me != environment())
    return 0;
  if (!arg || !id(arg))
    return 0;
  amount = me->query("balance") / 10000;
  amount += me->query("c_balance") / 10000;
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("money_id")
      && inv[i]->value() > 10000)
      amount += inv[i]->value() / 10000;
  }
  if (amount > 50000)
    amount = 1000;
  else amount = 50000 - amount;
  amount = amount / 2 + random(amount / 2);
  amount *= 10;

  tell_object(me, query("long"));
  tell_object(me, HIY "\n" + name() + HIY "忽然“轰”的一声，炸成了一片齑粉！\n\n" NOR);
  tell_object(
    me,
    BLINK YEL "你得到了" + SDS_D->no_color_msg(MONEY_D->money_str(amount)) + BLINK + YEL "的存款。\n" NOR
  );
  me->add("c_balance", amount);
  me->save();
  pi = new(__DIR__ "pi");
  if (pi && pi->move(me)) tell_object(me, "恭喜恭喜！你得到了一个" + pi->query("name") + "\n");
  destruct(this_object());
  return 1;
}
