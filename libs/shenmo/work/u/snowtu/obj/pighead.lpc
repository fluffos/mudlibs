inherit ITEM;

string msg = @LONG

            HIW(\____/)NOR
            HIW/ HIR@HIW__HIR@HIW \NOR
           HIW(  (HIGooHIW)  )NOR
            HIW`-..-'NOR
             HIW/    \NOR
           HIW@/      \_NOR
LONG;


void create() {
  set_name("猪头", ({ "tou" }));
  set("unit", "个");
  set("value", 0);
  set("long", "好大的猪头。\n");
  setup();
}

void init() {
  if (wizardp(this_player()))
    add_action("do_pig", "pig");
}

int do_pig(string arg) {
  object who;

  if (!arg)
    return 0;
  who = present(arg, environment(this_player()));
  if (!who || !living(who))
    return 0;
  msg = SDS_D->color_msg(msg);
  who->set_temp("apply/long", ({ msg }));
  message_vision("$N给$n一个猪头，$n高高兴兴的戴在了头上。\n", this_player(), who);
  return 1;
}
