#include <dbase.h>
#include <name.h>
#include <ansi.h>
inherit F_EQUIP;
inherit ITEM;

void create() {
  string msg;
  set_name("面具", ({ "mian ju", "mianju" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 0);
    set("no_give", 1);
  }
  setup();
  set("armor_type", "mianju");
  set("armor_prop", ([
    "armor": 10 + random(18),
    "armor_vs_force": 88 + random(888),
    "armor_vs_spells": 88 + random(888),
    "personality": -random(8),
  ]));
  set("wear_msg", "\n");
  set("unequip_msg", "\n");
}

int wear() {
  int i;
  string name, *names, title, id;
  object me;

  if (::wear()) {
    me = environment();
    if (me && me->is_character()
      && !me->query_temp("d_mana")) {
      names = ({
        "人怜花似旧，花不知人瘦", "朱淑真", "zhu shuzhen",
        "一种相思，两处闲愁", "李清照", "li qingzhao",
        "雁过留声", "薛涛", "xue tao",
        "道观哀艳", "鱼玄机", "yu xuanji",
        "出水芙蓉", "花蕊夫人", "huarui furen",
        "玲珑内舍人", "上官婉儿", "shangguan waner",
        "巧笑倩兮，美目眇兮", "庄姜", "zhuang jiang",
        "未若柳絮因风起", "谢道韫", "xie dao wen",
        "自君之出矣，临轩不解颜", "鲍令晖", "bao linghui",
        "经时未架却，心绪乱纵横", "李冶", "li ye",
      });
      i = random(sizeof(names) / 3) * 3;
      title = names[i];
      name = names[i + 1];
      id = names[i + 2];
      if (title && id && name) {
        me->set_temp("d_mana", 1);
        me->set_temp("is_living", living(me));
        me->set_temp("apply/name", ({ name }));
        me->set_temp("apply/id", ({ id }));
        me->set_temp("apply/short", ({ title + " " + name + "(" + capitalize(id) + ")" }));
        me->set_temp("apply/long", ({ "手如柔荑，肤如凝脂，领如蝤蛴，齿如瓠犀，螓首蛾眉，巧笑倩兮，美目眇兮。\n" }));
        me->set_temp("unit", me->query("unit"));
        me->set_temp("is_character", me->is_character());
        me->set_temp("gender", "女性");
        me->set_temp("age", 18);
        me->set_temp("race", me->query("race"));
        me->set_temp("family", me->query("family"));
        tell_object(me, "你戴上一张面具，化作一代才女" + name + "。\n");
      }
    }
    return 1;
  }
  return ::wear();
}

int unequip() {
  object me;

  if (::unequip()) {
    me = environment();
    if (me->query_temp("d_mana")) {
      me->delete_temp("d_mana");
      me->delete_temp("apply/name");
      me->delete_temp("apply/id");
      me->delete_temp("apply/short");
      me->delete_temp("apply/long");
      me->delete_temp("unit");
      me->delete_temp("is_character");
      me->delete_temp("gender");
      me->delete_temp("age");
      me->delete_temp("race");
      me->delete_temp("family");
      tell_object(me, "你将面具从脸上取下。\n");
    }
    return 1;
  }
  return ::unequip();
}
