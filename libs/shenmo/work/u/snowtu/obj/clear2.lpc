#include <ansi.h>
inherit ITEM;

void create() {
  set_name("清理器", ({ "wiz tool", "tool" }));
  set_weight(1000);
  set("unit", "个");
  setup();
}

void init() {
  add_action("do_clr", "clear");
}

int do_clr(string arg) {
  int i, k = 0;
  object who, *ob, me = this_player();
  if (me->query("id") != "snowtu" || !wizardp(me))
    return 0;
  if (!arg)
    return 0;
  i = strlen(arg);
  if (arg[i - 1..i] != ".lpc")
    arg += ".lpc";
  ob = children(arg);
  if (!ob || !arrayp(ob))
    return 0;
  reset_eval_cost();
  for (i = 0; i < sizeof(ob); i++) {
    if (!ob[i] || !environment(ob[i])
      || environment(ob[i])->is_character())
      continue;
    if (ob[i]->is_character()
      && ob[i]->is_fighting())
      continue;
    destruct(ob[i]);
    k++;
  }
  write("OK,共清理了" + k + "个" + arg + "。\n");
  return 1;
}
