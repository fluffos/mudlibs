#include <ansi.h>
inherit ITEM;

void create()
{
set_name(WHT"照妖镜"NOR,({"zhaoyao jing","jing" }) ); 
set("long","一面明光锃亮的青铜宝镜。\n");
set_weight(1000); 
if( clonep() ) 
        set_default_object(__FILE__); 
else    { 
        set("material", "paper"); 
        set("unit", "面"); 
        set("no_get",1);
        }
setup();
}

void init()
{
add_action("do_zhao","zhaoyao");
}

int do_zhao(string arg)
{
string *msg_expression = ({
        "脸上露出愉快的微笑。",
        "正躲在一边幸灾乐祸地笑。",
        "脸上露出狡诈的神情，大概又想到了什么坏主意了。",
        "正在绷着个脸扮酷。",
        "捧着肚子笑得前仰后合。",
        "眉头紧锁，不知在想什么心事。",
        "正托着腮帮子作沉思状。",
        "咬牙切齿，一副愤愤不平的样子。",
        "一脸的迷茫，不知道周围发生了什么事。",
        "正在咧着嘴傻乐。",
        "正作天真状。",
        "正在闷闷不乐。",
        "骄傲地昂着头，满脸不屑的神情。",
        "痛苦得呲牙咧嘴，大概是牙痛得厉害。",
        "正强颜欢笑，但掩饰不住心里的哀伤。",
        "正在眉飞色舞。",
        "一脸的尴尬相。",
        "脸上露出灿烂的笑容。",
        "笑得比哭还难看。",
        "正强忍着不让自己哭出来。",
        "媚眼如丝。",
        "正作小鸟依人状。",
        "开怀大笑，露出满嘴的金牙。",
});

int size=sizeof(msg_expression);
int spellme,spellwho,know;
string str;
object who,ob=this_object();
object me=environment(ob);

if (  !arg  || me!=this_player() )
        return 0;
who = present(arg,environment(me));
if ( !who )
        who = find_player(arg);
if ( !who )
        return 0;               

if ( who==me ) 
        {
        message_vision("$N对着$n挠首弄姿，有点自恋....\n",me,ob);
        if ( me->query_per()<10 )
                write("别照了，猪八戒都比你漂亮...\n");
        else if ( me->query_per()<15 )
                write("别照了，你比猪八戒都漂亮...\n");
        else if ( me->query_per()<20 )
                write("别照了，你还有些许姿色...\n");
        else if ( me->query_per()<30 )
                write("别照了，你也算是美人了...\n");
        else
                write("别照了，你是最美的了...\n");
        return 1;       
        }

if (me->query("mana")<100)
        return notify_fail("你的法力不足。\n");
me->add("mana",-40);

spellme=me->query_skill("spells");
spellwho=who->query_skill("spells");

if ( who->name()!=who->query("name")  ) 
        {
       str="却见"+who->query("name");
       know=1;
        }
else    {
       str="只见"+who->name();
       know=0;
        }
message_vision(WHT"$N"WHT"掏出$n"WHT"迎风展开，只见万道霞光从$n"WHT"上绽放开来，一时间
房间里霞气弥漫，一片祥和。\n"NOR,me,ob);

if ( !present(who,environment(me)) )
        {
        message("vision",WHT"照妖镜上霞光渐渐聚成一道光柱朝着"+WHT+SDS_D->no_color_msg(MISC_D->find_place(environment(who)))+WHT"直射而去！\n"NOR,environment(me));
        message("channel:chat",WHT"\n一道光柱从"+WHT+SDS_D->no_color_msg(MISC_D->find_place(environment(me)))+WHT"急速射出，朝着"+WHT+SDS_D->no_color_msg(MISC_D->find_place(environment(who)))+WHT"方向奔驰而去！\n\n"NOR,users());
        }
else    message("vision",WHT"照妖镜上霞光渐渐聚成一道光柱朝着"+WHT+SDS_D->no_color_msg(who->name())+WHT"直射而去！\n"NOR,environment(me),who);
       tell_object(who,BLINK HIY"一道光柱朝着你直射而来！\n"NOR);
write(WHT"\n\n照妖镜上光华四射，只见"+who->name()+"的面容渐渐显露在镜中，"
+str+msg_expression[random(size)]+"\n\n");
SDS_D->check_player(who,this_player());
return 1;
}
         
