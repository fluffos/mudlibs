#include <ansi.h>
inherit ITEM;

void create() {
  set_name("合并魄石", ({ "hebing poshi", "po", "shi" }));
  set("unit", "颗");
  set("long", "一颗形状古朴的魄石，用它可以合并(hebing)莲花。\n");
  set_weight(5000);
  set("value", 0);
  set("no_give", 1);
  set("no_put", 1);
  setup();
}

void destruct_me() {
  write(HIW + name() + "化作一朵莲花冲天而去！\n\n" NOR);
  this_object()->move("/obj/empty");
  destruct(this_object());
}

void init() {
  if (!environment())
    return;
  if (!query("owner"))
    set("owner", environment());
  if (!query("owner") || !userp(query("owner"))
    || environment() != query("owner")) {
    destruct_me();
    return;
  }
  add_action("do_hebing", "hebing");
}

int err_msg(string arg) {
  write(arg);
  return 0;
}

int do_hebing(string arg) {
  object h1, h2, hua, me;
  string id1, id2, str, t1, t2, *tt;
  int i, k, j;

  me = this_player();
  if (!present(this_object(), me))
    return 0;
  me = SDS_D->random_npc();
  if (!me || !living(me))
    return err_msg(name() + "的合并功能被大神封住了。\n");
  return err_msg("你先去找" + me->name() + "将" + name() + "的合并功能解封吧。\n");
}

string short() {
  return ::short() + "(大)";
}
