#include <ansi.h>
inherit ITEM;

void create() {
  set_name("将军帖", ({ "jiangjun tie", "tie" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "龙飞凤舞的墨宝，你可以用它来修改(xiugai)你的描述。\n");
    set("unit", "张");
    set("value", 1000000);
    set("no_get", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("no_sell", 1);
  }
}

void init() {
  add_action("do_long", "xiugai");
}

int do_long(string arg) {
  object me = this_player();
  if (!present(this_object(), me))
    return 0;
  if (query("used")) {
    write(name() + "已经被使用过了，丢掉吧，不值钱了。\n");
    return 1;
  }
  write(@LONG
$BLK$ - 黑色         $NOR$ - 恢复正常颜色
$RED$ - 红色         $HIR$ - 亮红色
$GRN$ - 绿色         $HIG$ - 亮绿色
$YEL$ - 土黄色       $HIY$ - 黄色
$BLU$ - 深蓝色       $HIB$ - 蓝色
$MAG$ - 浅紫色       $HIM$ - 粉红色
$CYN$ - 蓝绿色       $HIC$ - 天青色
$WHT$ - 浅灰色       $HIW$ - 白色
$BLINK$ - 字符闪烁
LONG);
  set("value", 0);
  set("used", 1);
  return ("/cmds/std/tototo.lpc")->main(me, "describe");
}
