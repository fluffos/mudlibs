#include <ansi.h>
#include <localtime.h>

nosave mapping data = ([]);
nosave object tt = 0;

string check_week(int time)
{
string e_time, c_week,week, month, year;
int day, hour, minute, second;
string *week_name = ({"Mon","Tue","Wed","Thu","Fri","Sat","Sun"});


if ( time )
        e_time = ctime(time);
else    e_time = ctime(time());

sscanf(e_time,"%s %s %d %d:%d:%d %s", week, month, day, hour, minute, second, year);
c_week  = chinese_number(member_array(week, week_name) + 1);
if(week=="Mon") c_week="星期一"; 
else if(week=="Tue") c_week="星期二";  
else if(week=="Wed") c_week="星期三";      
else if(week=="Thu") c_week="星期四";        
else if(week=="Fri") c_week="星期五";      
else if(week=="Sat") c_week="星期六";      
else if(week=="Sun") c_week="星期天";
return c_week;
}

void set_baoshi_num(int v)
{
data[check_week(time())] = v;
}

int check_baoshi_num()
{
string t = check_week(time());
if ( !data[t] )  data[t] = 1;
if ( data[t] )
        return 0;
return 1;
}               

int return_baoshi_num()
{
string t = check_week(time());  
return data[t];
}

void set_is_hebing(object who)
{
tt = who;
}

int is_hebing()
{
if ( tt && objectp(tt) )
        return 1;
return 0;       
}               

object query_hebing()
{
return tt;
}       
