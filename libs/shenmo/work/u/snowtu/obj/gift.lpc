inherit ITEM;
#include <ansi.h>

void create()
{
        set_name("即时奖励",({"gift"}));
        set("unit","个");
        set("no_put",1);
        set("no_get",1);
        set("no_give",1);
        setup();
}

void remove_obj()
{
        if( environment() )
        {
                tell_object(environment(),"时间到，本次礼物自动消失。\n");
                this_object()->move("/obj/empty");
                destruct(this_object());
        }
}

void init()
{
        object ob,*obs;
        int i;
        string id;
        if( environment() && !query("msg") )
        {
                obs = users();
                ob = obs[random(sizeof(obs))];
                if( ob && objectp(ob) )
                        id = ob->query("id");
                else    id = "snowtu";
                set("msg",id);
        }               
        add_action("do_cmds","",1);
        tell_object(environment(),HIY"\n10秒内的第一个命令如果是："HIR+query("msg")+"，就有奖励哦。\n"NOR);
        call_out("remove_obj",10);      
}

int do_cmds()
{
        string str = query_verb();
        if( this_player()!=environment() 
         || !query("msg")
         || query("asked") )
                return 0;
        if( str!=query("msg") ) 
                write("输入不正确，你没有得到礼物。\n");
        else
        {
                write("输入正确。\n");
                this_player()->add("haomao",1);
                write("你得到了一根救命毫毛。\n");
        }
        set("asked",1);
        return 1;
}               
