
#include <ansi.h>
#include <weapon.h>
inherit SWORD;

void create()
{
set_name("剑",({"sword","jian"}));set_weight(5000);
if (clonep())
        set_default_object(__FILE__);
else    {
        set("unit", "把");
        set("value", 0);
        set("no_drop",1);
        set("no_put", 1);
        set("no_get",1);
        set("material","purplegold");
        set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");       set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
        set("weapon_scar",100000);
      }
init_sword(25);setup();
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
return WEAPON_D->do_s_attack(me,victim,me->query_temp("weapon") );
}
