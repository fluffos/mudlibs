inherit ITEM;

string msg = @LONG

BLINKHIC        好大的一个胸透NOR

YEL .'"'.        ___,,,___        .'``.NOR
YEL: (\  `."'"```         ```"'"-'  /) ;NOR
YEL :  \                         `./  .'NOR
YEL  `.                            :.'NOR
YEL    /        _         _        \NOR
YEL   |         NORHIRoNORYEL}       {NORHIRoNORYEL         |NOR
YEL   |         /         \         |NOR
YEL   |        /           \        |NOR
YEL   |       /             \       |NOR
YEL    \     |      .-.      |     /NOR
YEL     `.   | . . /   \ . . |   .'NOR
YEL       `-._\.'.(     ).'./_.-'NOR
YEL           `\'  `._.'  '/'NOR
YEL             `. NORHIR--'--NORYEL .'NOR
YEL               `-...-'NOR

LONG;


void create() {
  set_name("熊头", ({ "tou" }));
  set("unit", "个");
  set("value", 0);
  set("long", "好大的熊头。\n");
  setup();
}

void init() {
  if (wizardp(this_player()))
    add_action("do_pig", "pig");
}

int do_pig(string arg) {
  object who;

  if (!arg)
    return 0;
  who = present(arg, environment(this_player()));
  if (!who || !living(who))
    return 0;
  msg = SDS_D->color_msg(msg);
  msg = who->short() + "\n" + msg;
  who->set_temp("apply/long", ({ msg }));
  message_vision("$N给$n一个熊头，$n高高兴兴的戴在了头上。\n", this_player(), who);
  return 1;
}
