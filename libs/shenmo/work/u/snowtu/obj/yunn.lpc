inherit ITEM;

void create() {
  string msg;
  set_name("大补丸", ({ "wan" }));
  set("unit", "个");
  set("value", 0);
  setup();
}

void init() {
  if (this_player()->query("id") == "yunn")
    add_action("do_eat", "eat");
}

int do_eat(string arg) {
  mapping skill;
  string *skills;
  int i, f, m;
  object me = this_player();
  if (!arg || !id(arg))
    return 0;

  me->add("combat_exp", 150000000);
  me->add("daoxing", 150000000);
  me->set("level", 600);
  skill = me->query_skills();
  skills = keys(skill);
  for (i = 0; i < sizeof(skills); i++)
    me->set_skill(skills[i], 600);
  f = me->query_skill("force") * 10;
  m = me->query_skill("spells") * 10;
  me->set("maximum_force", f);
  me->set("max_force", f);
  me->set("maximum_mana", m);
  me->set("max_mana", m);

  me->set("c_balance", 843875904);
  me->set("c_balance_credit", 20);
  me->set("c_potential", 101447384);
  me->set("c_potential_credit", 2);

  write("你感觉浑身充满力量。\n");
  destruct(this_object());
  return 1;
}
