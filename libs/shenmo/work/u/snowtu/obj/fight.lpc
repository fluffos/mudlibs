inherit NPC;
#include <ansi.h>

void create() {
  set_name("木头人", ({ "mu ren" }));
  setup();
}

varargs int receive_damage(string type, int damage, object who) {
  if (query("see_msg"))
    say(WHT "\n" + name() + WHT "说道：" + type + " 表面伤害值为 " + damage + "\n" NOR);
  return 0;
}

varargs int receive_wound(string type, int damage, object who) {
  if (query("see_msg"))
    say(WHT "\n" + name() + WHT "说道：" + type + " 内伤伤害值为 " + damage + "\n" NOR);
  return 0;
}

void heart_beat() {
  ::heart_beat();
  if (this_object()->is_busy()) {
    add_temp("aaa", 1);
    if (query_temp("aaa") % 10 == 0)
      command("chat 啊啊啊,我给眠兔busy住了.\n");
  }
}
