inherit ITEM;

void create()
{
        set_name("立方根",({"box"}));
        setup();
}

void init()
{
        add_action("do_ceshi","test");
}

int do_ceshi(string arg)
{
        int i;
        float x,y;
        if( !arg || sscanf(arg,"%d",i)!=1 )
                return 0;
        write("i="+i+"\n");
        i = CHINESE_D->wx_sk(i);
        write("它支持的技能最高级是"+i+"\n");
        return 1;
}

int query_autoload(){ return 1;}
