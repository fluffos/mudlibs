void create()
{
        set_name("百雀羚",({"baique ling","gao"}));
        if( random(2) )
                set_name("雪花膏",({"xuehua gao","gao"}));
        set("unit","个");
        set("value",0);
        set("long","天冷，不用再涂蜡，搽(mo)在脸上吧。\n");
        setup();
}

void init()
{
        add_action("do_pig","mo");
}

int do_pig(string arg)
{
        string msg;
        object who = this_player();
        
        if( !present(this_object(),who) )
                return 0;
        msg = who->short()+"\n"+msg;
        if( random(2) )
                msg+= msg1;
        else if( random(2) )
                msg+= msg2;
        else if( random(2) )
                msg+= msg3;
        else if( random(2) )
                msg+= msg4;
        else if( random(2) )
                msg+= msg5;
        else if( random(2) )
                msg+= msg6;
        else if( random(2) )
                msg+= msg7;
        else if( random(2) )
                msg+= msg8;
        else if( random(2) )
                msg+= msg9;
        else if( random(2) )
                msg+= msg10;
        else if( random(2) )
                msg+= msg11;
        else if( random(2) )
                msg+= msg12;
        else    msg+= msg13;
        msg = SDS_D->color_msg(msg);
        who->set_temp("apply/long",({msg}));
        who->add_temp("apply/personality",random(3));
        message_vision("$N开开心心的哼着小曲，在脸上涂抹着"+query("name")+"。\n",who);
        destruct(this_object());
        return 1;
}

