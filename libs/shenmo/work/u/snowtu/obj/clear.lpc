#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("昊天镜",({"haotian jing","jing"}));
        set_weight(1000);
        set("unit","面");
        setup();
}

void init()
{
        add_action("do_clr","clear");
}

int do_clr()
{
        int i,flag;
        object who,*user,me = this_player();

        if( !wizardp(me) )
                return 0;
        user = users();
        reset_eval_cost();
        flag = 0;
        for(i=0;i<sizeof(user);i++)
        {
                who = user[i];
                if( who->query_temp("spellslevel") )
                {
                        who->delete_temp("spellslevel");
                        who->delete_temp("apply/name");
                        who->delete_temp("apply/id");
                        who->delete_temp("apply/short");
                        who->delete_temp("apply/long");
                        who->delete_temp("family");
                        who->delete_temp("no_heal_up/bian");
                        who->delete_temp("is_living");
                        who->delete_temp("unit");
                        who->delete_temp("is_character");
                        who->delete_temp("gender");
                        who->delete_temp("age");
                        who->delete_temp("race");
                        if(who->query_temp("d_mana")) 
                                who->delete_temp("d_mana");
                        while( environment(who)->is_character() )
                                who->move(environment(environment(who)));
                        message_vision(HIY "$N口念咒语，身形一晃，现了真身。\n"NOR,who);
                        flag++;
                }                                               
        }       
        if( flag>0 )
                message("shout",HIC"【"HIR"害虫界"HIC"】谛听(Diting)："+me->query("name")+HIC"清除了"HIY+chinese_number(flag)+HIC"位玩家的变身状态。\n"NOR,users());
        return 1;
}                                                                       

