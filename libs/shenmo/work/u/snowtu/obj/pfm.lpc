//Cracked by Snowtu
// perform.c
#include <ansi.h>
#include <skill.h>
#include "/cmds/std/valid_kill.h";
inherit ITEM;

void create() {
  set_name("双兵器外功测试器", ({ "qi" }));
  set("unit", "吨");
  setup();
}

void init() {
  add_action("do_perform", "pfm");
}

int err(string arg) {
  write(arg);
  return 1;
}

int do_perform(string arg) {
  object me, weapon, target;
  string martial, skill, perf, id;
  mapping temp;

  me = this_player();
  if (!wizardp(me))
    return 0;

  if (me->is_busy())
    return err("( 你上一个动作还没有完成，不能施用外功。)\n");
  if (!arg) return err("你要用外功做什么？\n");

  temp = me->query_temp("no_perform");
  if (temp && mapp(temp)) {
    if (time() < temp["start"] + temp["time"]) {
      if (temp["msg"] && stringp(temp["msg"]))
        return err(temp["msg"]);
      else return err("绝招用多就不灵了。\n");
    }
  }
  if (sscanf(arg, "%s on %s", perf, id) == 2)
    target = present(id, environment(me));
  else {
    target = me->select_opponent();
    if (target) id = target->query("id");
    else id = "None";
    perf = arg;
  }
  if (!target)
    return err("这里没有 " + id + "。\n");
  if (!valid_kill(me, target, 0))
    return err("不是可战的对象\n");
  if (me->query("combat_exp") < 250000 && userp(target))
    return err("自己功夫没练好就想杀人？\n");
  if (me->query("daoxing") < 200000 && userp(target))
    return err("自己功夫没练好就想杀人？\n");
  if (userp(target) && target->query("age") < 17)
    return err("本站暂时保护新手。\n");
  if (userp(me) && userp(target) && target->query_temp("netdead"))
    return err("对方正在断线中，不能对其施用外功。\n");

  set_to_killer(me, target);

  if (weapon = me->query_temp("weapon"))
    martial = weapon->query("skill_type");
  else martial = "unarmed";
  write("martial-1 = " + martial + "\n");
  skill = me->query_skill_mapped(martial);
  write("skill-1 = " + skill + "\n");
  if (!skill || !stringp(skill)) {
    weapon = me->query_temp("secondary_weapon");
    if (!weapon || !objectp(weapon))
      martial = "dodge";
    else martial = weapon->query("skill_type");
    write("martial-2 = " + martial + "\n");
    skill = me->query_skill_mapped(martial);
    write("skill-2 = " + skill + "\n");
    if (!skill || !stringp(skill))
      return err("你请先用 enable 指令选择你要使用的外功。\n");
  }

  if (SKILL_D(skill)->perform_action(me, arg)) {
    write("做" + skill + "的pfm动作.\n");
    if (random(120) < (int)me->query_skill(skill))
      me->improve_skill(skill, 1, 1);
    return 1;
  } else if (SKILL_D(martial)->perform_action(me, arg)) {
    write("做" + martial + "的pfm动作.\n");
    if (random(120) < (int)me->query_skill(martial, 1))
      me->improve_skill(martial, 1, 1);
    return 1;
  } else {
    martial = "dodge";
    write("martial-3 = " + martial + "\n");
    skill = me->query_skill_mapped(martial);
    write("skill-3 = " + skill + "\n");
    if (!skill || !stringp(skill))
      return err("你请先用 enable 指令选择你要使用的外功。\n");
    if (SKILL_D(skill)->perform_action(me, arg)) {
      write("做" + skill + "的pfm动作.\n");
      if (random(120) < (int)me->query_skill(skill))
        me->improve_skill(skill, 1, 1);
      return 1;
    } else if (SKILL_D(martial)->perform_action(me, arg)) {
      write("做" + martial + "的pfm动作.\n");
      if (random(120) < (int)me->query_skill(martial, 1))
        me->improve_skill(martial, 1, 1);
      return 1;
    } else return err("你请先用 enable 指令选择你要使用的外功。\n");
  }
}
