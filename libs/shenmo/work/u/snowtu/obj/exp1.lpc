#include <ansi.h>
inherit ITEM;

int do_eat(string);

void init()
{
if ( environment() && !query("owner_id") )
        set("owner_id",environment()->query("id"));        
add_action("do_eat", "eat");
}

void create()
{
set_name("经验丹",({"jingyan dan", "dan"}));
set("name_corlor","HIG");
set_weight(90);
if (clonep())
        set_default_object(__FILE__);
else    {
        set("unit", "颗");
        set("long", "吃过之后能在15分钟之内，使得到经验为普通所得的1.25倍的道具(此状态不可叠加)。\n");
        set("drug_type", "补品");
        set("no_give",1);
        set("no_put",1);
        set("no_sell",1);
        set("no_get",1);
        set("value",1000000);
        set("ad_type","combat_exp");
        }
setup();
}

int do_eat(string arg)
{
object me = this_player();
if ( !arg || !id(arg) )
        return 0;
if ( query("owner_id")!=me->query("id") )
        return 0;        
me->set_temp("ad_apply/"+query("ad_type"),([
        "start" : time(),
        "time"  : 900,
        "pot"   : 125,
]));          
message_vision(HIG "$N"HIG"轻轻掰开一颗"+name()+HIG"一时间香气四溢。只见$N"HIG"脸上慢慢泛出红晕，看起来有精神多了！\n" NOR, me);
destruct(this_object());
return 1;
}


