#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIW "无字天书" NOR, ({ "wuzi book", "wuzi", "book" }));
  set("long", "一本神奇的宝书，你可以从上面学任何东西(dushu <技能>)\n");
  set("unit", "本");
  setup();
}

void init() {
  add_action("do_du", "dushu");
}

int do_du(string arg) {
  object me = this_player();
  if (!wizardp(me) || !arg)
    return 0;
  if (file_size(SKILL_D(arg) + ".lpc") < 1) {
    write("没有这项技能\n");
    return 0;
  }
  me->set_skill(arg, 400);
  write("你学会了" + to_chinese(arg) + "！\n");
  return 1;
}

int query_autoload() {
  return 1;
}
