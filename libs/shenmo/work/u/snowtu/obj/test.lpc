inherit ITEM;

void create() {
  set_name("随便", ({ "it" }));
  set("channel_id", "请叫我黄瓜(Administrator Group)");
  set_weight(1000);
  set_max_encumbrance(50000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 0);
  }
}

void init() {
  add_action("do_test", "test");
}

int do_test() {
  int t, tt;

  t = time();
  tt = query("tt");

  if (!tt) {
    set("tt", t);
    write("ok\n");
    write("时间=" + t + "\n");
    return 1;
  }
  t = t - tt;
  write("相差为" + t + "\n");
  if (t < 0)
    CHANNEL_D->do_channel(this_object(), "chat", "出错了，新旧时间相差为负？！");
  return 1;
}
