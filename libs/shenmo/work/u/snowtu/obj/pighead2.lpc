inherit ITEM;

string msg = @LONG

REVBLK NORHBWHTHIM    ╔┉┉┉┉┉┉╗   NORREVWHT■=NORREVBLU=■       NORBBLUHIM__  _____    _______    ________          NOR
REVBLK NORHBWHTHIM    ┋NORHBMAGHIY ╭^╮╭^╮ NORHBWHTHIM┋   NORREVWHT■=NORREVBLU=■     NORBBLUHIM__█__█ NORBBLUHIM╱ NORBBLUHIM   █___█    █____█          NOR
REVBLK NORHBWHTHIM    ┋NORBMAGWHT    @  @    NORHBWHTHIM┋   NORREVWHT■=NORREVBLU=■       NORBBLUHIM█◆█  ╱ ▅-▅ ▅-▅ ──█──         NOR
REVBLK NORHBWHTHIM    ┋NORHBMAGHIY （  ＠  ） NORHBWHTHIM┋   NORREVWHT■=NORREVBLU=■     NORBBLUHIM●█ _█╱╲ █_█ █_█ ◢◤█◥◣         NOR
REVBLK NORHBWHTHIM    ┋NORNORBMAG     NORBMAGHIRBLINKˇ     NORHBWHTHIM┋   NORREVWHT■=NORREVBLU=■   NORBBLUHIW______________________________________________NOR
REVBLK NORHBWHTHIM    ╚┉┉┉┉┉┉╝   NORREVWHT■=NORREVBLU=■                                                 NOR

LONG;


void create()
{
        set_name("猪头",({"tou"}));
        set("unit","个");
        set("value",0);
        set("long","好大的猪头。\n");
        setup();
}

void init()
{
        if( wizardp(this_player()) )
                add_action("do_pig","pig");
}

int do_pig(string arg)
{
        object who;
        
        if( !arg )
                return 0;
        who = present(arg,environment(this_player()));
        if( !who || !living(who) )
                return 0;
        msg = SDS_D->color_msg(msg);
        who->set_temp("apply/long",({msg}));
        message_vision("$N给$n一个猪头，$n高高兴兴的戴在了头上。\n",this_player(),who);
        return 1;
}

