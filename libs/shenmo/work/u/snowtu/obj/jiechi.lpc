#include <ansi.h>
inherit ITEM;

int step = 0;
object ob = 0;

string do_smash();

mixed *storys = ({

  ({
    "$N将手中戒尺晃了几晃，朝着$n嘿嘿一阵冷笑，",
    "$n横眉冷对千夫指：当今世界WHO怕WHO啊……",
    "没等$n反应过来，$N已经窜到$p面前，扬出手中戒尺……",
    "$N说道：不许动，把所有值钱的东西交出来！",
    "$n想大声呼救，结果发现没有一个人了，都溜的精光，跑的比球还快。",
    "形势危急……",
    "$N说道：快点！m d，大爷没时间跟你磨蹭！",
    "$n横眉冷对千夫指：当今世界WHO怕WHO啊……",
    "只见$N举起戒尺，大喝：“看打!”, 只见一道电光闪过，",
    "戒尺带着咆哮的风声自天而降，向着$n的屁屁奔去……",
    "……",
    "………………",
    "………………………………",
    "$n摸着又红又肿的屁屁，委屈的看着眠兔…………",
    "…………",
    "……………………",
  }),

  ({
    "不好啦～～～不好啦～～～",
    "$N：怎么了？出什么事了？",
    "小孩甲：$n掉到缸里了。",
    "$N咳嗽一声，道：我还以为什么大不了的事，他不是$n嘛！慌甚么。",
    "众小孩乱成一团。",
    "$N蓦然而起：他奶奶的，我记得$n还欠我一串糖葫芦！",
    "小孩乙：是有这么回事，不过你要不马上找到家长把$n捞上来，就别指望了！",
    "哼！$N冷冷笑道：区区小事，何足挂齿？",
    "......",
    "$N举起一块石头，狠狠的砸了下去，“哐当”，缸破水出。",
    "$n苟延残喘。",
    "$N翻起$n，道：$n啊$n，你欠我的那串冰糖葫芦还记不记得？",
    "$n：你说啥？",
    "乒乓！",
    "$n被$N扔到了缸里。",
  }),
  ({
    "" HIB "七月初七，鹊桥相会。" NOR "",
    "" MAG "喜鹊" YEL "飞呀飞" NOR + WHT "～～～",
    "$n：$N哥哥，你可想死我了。",
    "$N：$n妹妹，我也很想你啊，这一年来我无时无刻不在思念你啊。",
    "$n：唉，春去秋来总依旧，分分离离何时了。",
    "$N哽咽道：我的好老婆啊...",
    "王母娘娘：这两个家伙，酸死我了，那个... 那个贱人！",
    "智多星：王母息怒，少忍，少忍。",
    "$N和$n犹在卿卿我我。",
    "蓦然$n大怒，手里掐着一根头发，喝道：$N，你快给我说清楚，这是哪儿来的？",
    "$N结结巴巴道：老婆... 这，这是不是你的啊？",
    "$n冷笑道：哼！我的头发可不是这个样子的，这头发分明是一个凡人的！",
    "$N头里嗡嗡直叫。",
    "$n猛摇$N，喊道：你快给我说清楚！说清楚呀！",
    "$N喃喃道：我，我这是跳到银河里也洗不清了。",
    "$n淡然道：好，你就跳到银河里吧，如果你跳了，我就认为你是清白的。",
    "$N苦着脸道：老婆，你这不是要害死我嘛，这，我这跳进去，不立刻变成冰棍了。",
    "$n大怒，给$N就是一耳光，“啪”的一声异常响亮，喝道：滚，我不是你老婆！",
    "$n飘然而去，渺然不见踪影",
    "$N捂着脸，半晌才清醒过来，嘀咕道：他奶奶的，这婊子，没点三从四德，休了她！",
    "$N低头踉踉跄跄而去。",
  }),
});

nosave mixed *story;

mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

void go_on_process(object ob) {
  remove_call_out("start_smash");
  if (!ob) return;
  call_out("start_smash", 1);
}

void start_smash() {
  mixed line;
  string prompt;

  if (!ob)
    return;
  go_on_process(ob);
  line = query_story_message(step);
  if (!line || !stringp(line)) return;
  line = replace_string(line, "$N", this_player()->query("name"));
  line = replace_string(line, "$n", ob->query("name"));
  line = replace_string(line, "$p", "她");
  step++;
  prompt = NOR CYN "";
  if (functionp(line))
    catch(line = evaluate(line));
  if (stringp(line))
    //        message("channel:chat",NOR YEL"\t"+prompt +YEL+ line + YEL"\n" NOR,users());
    message(
      "vision",
      NOR WHT "\t" + prompt + WHT + line + WHT "\n" NOR,
      environment(environment(this_object()))
    );
  if (intp(line) && !line)
    go_on_process(ob);
}

void create() {
  set_name("戒尺", ({ "jie chi", "chi" }));
  set("unit", "把");
  setup();
}

void init() {
  add_action("do_heihei", "hai");
}

int do_heihei(string arg) {
  if (!wizardp(this_player())
    || SECURITY_D->get_status(this_player()) != "(admin)")
    return 0;
  if (!arg)
    return 0;
  ob = find_player(arg);
  if (!ob || !living(ob))
    return 0;
  step = 0;
  story = storys[random(sizeof(storys))];
  start_smash();
  write("ok\n");
  return 1;
}
