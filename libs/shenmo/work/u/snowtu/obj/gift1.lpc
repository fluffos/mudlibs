#include <ansi.h>
inherit ITEM;

void create() {
  set_name("小喇叭", ({ "xiao laba", "laba" }));
  set_weight(2000);
  set("long", "这是巫师用来奖励在线活人的小礼物。\n");
  set("no_give", 1);
  set("no_drop", 1);
  set("no_put", 1);
  set("no_get", 1);
  set("unit", "个");
  setup();
}

void init() {
  string str, *cmds, str1, str2, str3, str4;
  object who;

  int k = 10;
  add_action("do_cmds", "", 1);
  if (!stringp(query("sets"))) {
    cmds = ({
      "look3", "kiss4", "shout", "sldh", "xixihaha", "xiha",
      "snowtu", "tom", "abandon", "suicide", "goto", "smash",
      "shout", "zisha", "open", "close" });
    str = cmds[random(sizeof(cmds))];
    set("sets", str);
    who = environment();
    str1 = ({ name() + "到手", "你得到了" + name(), name() + "到了你手上", "你得到了小奖品", })[random(4)];
    str2 = ({ "你可以用", "你必须用", "你快用", "你用", })[random(4)];
    str3 = ({ "来得到奖励", "得到奖励", "得到小小的奖励", "来得到奖励", })[random(4)];
    str4 = YEL + str1 + YEL "，" + str2 + WHT " " + str + YEL " " + str3 + YEL "。\n" NOR;
    if (who && living(who))
      tell_object(who, str4);
  }
  call_out("destruct_me", k);
  write(YEL + FINGER_D->age_string(k) + YEL "后此物品将消失。\n" NOR);
}

void destruct_me() {
  write(YEL "时间已到，此物品自动消失。\n" NOR);
  destruct(this_object());
}

int do_cmds() {
  object me = this_player();
  string verb = query_verb();
  if (!verb)
    return 0;
  if (me != environment() || !stringp(query("sets")))
    return 0;
  if (verb == query("sets")) {
    write(HIW "OK" NOR YEL "。你使用对了暗语，你得到了奖励！\n" NOR);
    switch (random(10)) {
      case 0:
        me->add("combat_exp", 5000 + random(10000));
        write(YEL "你的武学经验上升了！\n" NOR);
        break;
      case 1:
        me->add("daoxing", 10001 + random(90000));
        write(YEL "你的道行上升了！\n" NOR);
        break;
      case 2:
        me->add("potential", 5001 + random(5000));
        write(YEL "你的潜能上升了！\n" NOR);
        break;
      case 3:
        me->add("balance", 10000 + random(990000));
        write(YEL "你的存款上升了！\n" NOR);
        break;
      default:
        me->add("level_exp", 101 + random(900));
        write(YEL "你的经验值上升了！\n" NOR);
    }
    me->save();
    me->apply_condition("check_level_exp", 1);
  } else write(HIW "OK" NOR YEL "。你使用错了暗语，你什么也没得到！\n" NOR);
  destruct(this_object());
  return 0;
}
