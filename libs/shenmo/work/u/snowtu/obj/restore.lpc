inherit ITEM;

nosave string *Ids = ({
  "ylong",
});

void create() {
  set_name("量天尺", ({ "liangtian chi", "chi", }));
  set_weight(1000);
  set("unit", "根");
  set("long", "恢复玩家数据用的。\n");
  set("value", 50000000);
  setup();
  set("channel_id", "数据修复(Wa_kaka)");
}

void init() {
  add_action("do_ask", "restore");
}

int err_msg(string arg) {
  write(arg);
  return 1;
}

void restore_data(string *ids, object me) {
  string *file, ff, dir, dir2, dir3, id;
  object ob;
  int i;

  if (sizeof(ids) <= 0) {
    CHANNEL_D->do_channel(this_object(), "chat", "修复完毕。");
    return;
  }

  id = ids[0];
  ids -= ({ id });
  if (find_player(id))
    CHANNEL_D->do_channel(this_object(), "chat", id + "的数据无法修复，因为Ta当前在线。");
  else {
    dir = sprintf("/data/user/%c/%s.oo.o", id[0], id);
    dir2 = sprintf("/data/user/%c/%s.o", id[0], id);
    dir3 = sprintf("/data/user/%c/%s.bak", id[0], id);
    ob = new("/u/snowtu/yunn.lpc");
    ob->move(environment(me));
    ob->set("save_file", dir);
    if (!ob->restore()) {
      CHANNEL_D->do_channel(this_object(), "sys", id + "的数据修复失败，档案数据可能损毁。");
      destruct(ob);
    } else {
      ob->revive();
      ob->save(1);
      seteuid(ROOT_UID);
      if (("/cmds/wiz/cp.lpc")->cp_file(dir, dir2, 0, 0))
        CHANNEL_D->do_channel(this_object(), "chat", id + "已修复完毕，请上线查看数据。");
      else CHANNEL_D->do_channel(this_object(), "chat", id + "数据修复失败，档案数据覆盖失败。");
      destruct(ob);
    }
  }
  remove_call_out("restore_data");
  call_out("restore_data", 2 + random(3), ids, me);
  return;
}

int do_ask(string arg) {
  int i;
  string *ids = ({});
  object me = this_player();

  if (!wizardp(me))
    return 0;
  for (i = 0; i < sizeof(Ids); i++)
    if (Ids[i] && member_array(Ids[i], ids) == -1)
      ids += ({ Ids[i] });
  if (query("huifu"))
    return err_msg("数据恢复中\n");
  CHANNEL_D->do_channel(this_object(), "chat", "现在开始修复出错的玩家数据。");
  set("owner", me);
  restore_data(ids, me);
  return 1;
}
