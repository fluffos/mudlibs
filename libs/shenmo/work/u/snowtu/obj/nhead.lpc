inherit ITEM;

string msg = @LONG

        BLINKHIR牛气哄哄NOR  
  
HIY                /~~~~~\        /~~~~~\NOR
HIY               |    (~'        ~~~)   |NOR
HIY                \    \HIW__________HIY/    /NOR
HIW                /NORWHT~::::::::NORHIW         ~\NOR
HIW     /~~~~~~~-_| NORWHT::::::::NORHIW             |_-~~~~~~~\NOR
HIW    \ ======= /|  NORWHT::NORHICANORHIW::;      NORHICANORHIW     :|\ ====== /NOR
HIW     ~-_____-~ |  _----------------_::| ~-____-~NOR
HIW               |/~                  ~\|NOR
HIW               /                      \NOR
HIW              (        ◎    ◎        )NOR
HIW               `\                   ./'NOR
HIW                 ~-_______________-~NOR
HIY                       /~~~~\NOR
HIY                      |REVHIY      NORHIY|NOR
HIY                      |REVHIY      NORHIY|NOR
HIY                     (REVHIY________NORHIY)NOR    
HIR                         ()NOR   

LONG;


void create()
{
        set_name("牛头",({"tou"}));
        set("unit","个");
        set("value",0);
        set("long","好大的牛头。\n");
        setup();
}

void init()
{
        if( wizardp(this_player()) )
                add_action("do_pig","pig");
}

int do_pig(string arg)
{
        object who;
        
        if( !arg )
                return 0;
        who = present(arg,environment(this_player()));
        if( !who || !living(who) )
                return 0;
        msg = SDS_D->color_msg(msg);
        msg = who->short()+"。\n"+msg;
        who->set_temp("apply/long",({msg}));
        message_vision("$N给$n一个牛头，$n高高兴兴的戴在了头上。\n",this_player(),who);
        return 1;
}

