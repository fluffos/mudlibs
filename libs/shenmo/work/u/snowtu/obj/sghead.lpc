inherit ITEM;

string msg = @LONG

NORREVBLK                NORGRN﹍﹍﹍ __                                           NORGRN　NOR
GRN              NORHIG◢NORHBGRN◢◢◢NORGRN∥ }NORGRN　NOR
GRN            NORHIY◢NORBYELHIY◢NORHBGRN◢◢◢NORHIG◣            NORGRN来来  我是一堆NORHIG榴莲NORGRN　NOR
HIG            NORBGRNHIY◤NORBYELHIY◤NORHBGRN◢◢◢◢NORHIG                                                        NORGRN　NOR
HIG            NORBGRNHIY◤◤◤NORHBGRN◤◤◢NORHIG            NORHIY似花貌美容颜                                NORGRN　NOR
HIY            ◥NORBGRNHIY◢◢NORHBGRN◢◢NORHIG╱ NORNORREVBLKnanocatT                                               NORGRN　NOR

LONG;


void create()
{
        set_name("榴莲",({"tou"}));
        set("unit","个");
        set("value",0);
        set("long","好大的榴莲。\n");
        setup();
}

void init()
{
        if( wizardp(this_player()) )
                add_action("do_pig","pig");
}

int do_pig(string arg)
{
        object who;
        
        if( !arg )
                return 0;
        who = present(arg,environment(this_player()));
        if( !who || !living(who) )
                return 0;
        msg = SDS_D->color_msg(msg);
        who->set_temp("apply/long",({msg}));
        message_vision("$N给$n一个榴莲，$n高高兴兴的戴在了头上。\n",this_player(),who);
        return 1;
}

