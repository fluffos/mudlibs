#include <armor.h>
#include <ansi.h>
inherit ARMOR;
inherit F_SAVE;

int check_owner();
void destroy(object ob);

void create()
{
seteuid(getuid());
set_weight(10000);
set("unit", "件");
set("no_sell",1);
set("value",0);
set("material", "steel");
set("armor_prop/armor",100);
set("armor_prop/spells",1);
set("armor_prop/dodge", 1);
set("armor_prop/parry", 1);
setup();
}

string status_color(int current, int max)
{
        int percent;

        if( max ) percent = current * 100 / max;
        else percent = 100;

        if( percent > 100 ) return HIC;
        if( percent >= 90 ) return HIG;
        if( percent >= 60 ) return HIY;
        if( percent >= 30 ) return YEL;
        if( percent >= 10 ) return HIR;
        return RED;
}

string tribar_graph(int val, int eff, int max, string bcolor, string fcolor, string dcolor)
{
string ret;
int i, n, eff_n, max_n = 10;

if( max <15 )
        max = 15;
if ( val<10 )
        val = 10;
n = val*100/max/10;
eff_n = eff*100/max/10;

if( n < 1 ) n = 1;
if( eff_n < 1 ) eff_n = 1;
if( n > max_n ) n = max_n;
if( eff_n > max_n ) eff_n = max_n;

ret = NOR  + bcolor + fcolor ;
for( i = 0 ; i < max_n; i ++ )
        {
        if( i > eff_n ) ret += dcolor;
        if( i < n )  ret += "━";
        else ret += HIW"━"NOR;
        }
ret += fcolor + NOR ;
return ret;
}

string query_save_file()
{
if ( !query("owner_id") || !stringp(query("owner_id")) )
        return 0;
return DATA_DIR"黄金圣衣/"+query("owner_id");
}

void init()
{
if ( check_owner() )
        {
        add_action("do_wear","wear");
        add_action("do_remove","remove");
        add_action("do_xiulian","xiulian");
        }
}

int check_owner()
{
string msg;     
object jia,ob =this_object();
object me =environment(ob);

if ( !me->query("sds3/all") )
        {
        destroy(ob);
        return 0;
        }
jia = present(me->query("id")+"'s shengyi",me);
if ( jia && jia!=ob )
        {
        destroy(ob);
        return 0;
        }

if ( !ob->query_temp("be_loaded") )
        {
        ob->set("owner_id",me->query("id"));
        if ( !ob->query("first_loaded") )       //第一次
                {
                ob->set_name(HIY+me->query("cloth_name")+HIW"座"+HIY"黄金圣衣"NOR,({me->query("id")+"'s shengyi","shengyi","yi","armor"}));
                msg = sprintf(HIY"这是%s"HIY"座黄金圣斗士%s(%s)的黄金圣衣。\n"NOR,
                                me->query("cloth_name"),
                                me->query("name"),
                                capitalize(me->query("id")),
                        );
                ob->set("level",1);
                ob->set("level_exp",0);
                ob->set("shield_time",6000);
                ob->set("long",msg);                            
                ob->set("first_loaded",1);
                if ( !ob->save() )
                        write(HIY"你的黄金圣衣存储失败，请和wiz联系！\n"NOR);
                }
        if ( !ob->restore() )
                write(HIY"你的黄金圣衣读取失败，请和wiz联系！\n"NOR);
        ob->set_temp("be_loaded",1);    
        }
return 1;       
}

void destroy(object ob)
{
write(ob->query("name")+"呼的不见了！ \n");
destruct(ob);
return ;
}

int query_autoload() { return 1; }

int do_wear(string arg)
{
int t;  
object me = this_player();
object ob = this_object();

if ( !arg || !id(arg) )
        return 0;
if ( me!=environment(ob) )
        return 0;
if ( ob->query("equipped") )
        return 0;
if ( time()<me->query("gold_cloth_wear")+6000 )
        return 0;
me->set_temp("apply/manashieldflag",1);
me->set("gold_cloth_wear",time());
return 0;
}

int do_remove(string arg)
{
object me = this_player();
object ob = this_object();

if ( !arg || !id(arg) )
        return 0;
if ( me!=environment(ob) )
        return 0;
if ( !ob->query("equipped") )
        return 0;
if ( me->query_temp("apply/manashieldflag") )
        me->delete_temp("apply/manashieldflag");
return 0;
}

int query_max_exp(int v)
{
int n;  
if ( v<5 )
        n = 100;
else if ( v<10 )
        n = 1000;               
else if ( v<15 )
        n = 3000;               
else if ( v<20 )
        n = 5000;               
else if ( v<25 )
        n = 10000;              
else if ( v<30 )
        n = 50000;              
else if ( v<35 )
        n = 100000;             
else if ( v<40 )
        n = 500000;             
else if ( v<50 )
        n = 1000000;            
else if ( v<100 )
        n = 10000000;           
else    n = 50000000;           
return n;
}

int err_msg(string arg)
{
write(arg);
return 1;
}       

int do_xiulian(string arg)
{
string msg;     
mapping my,his;
object me = this_player();
object ob = this_object();

my = me->query_entire_dbase();
his = ob->query_entire_dbase();

if ( !his["level"] || his["level"]<1 )
        his["level"]=1;

if ( !arg || !id(arg) )
        {
        msg = sprintf(CYN"\t  名称"YEL" : "NOR"%s\n"NOR,his["name"]);
        msg+= sprintf(CYN"\t所有者"YEL" : "NOR HIR"%s\n"NOR,my["name"]+"("+capitalize(my["id"])+")" );
        msg+= sprintf(CYN"\t  等级"YEL" : "NOR HIR"%s\n"NOR,chinese_number(his["level"]));
        msg+= sprintf(CYN"\t  经验"YEL" : "NOR"%s%s "NOR HIR"%d (%d%%)\n"NOR,
                                status_color(his["level_exp"],query_max_exp(his["level"])),
                                tribar_graph(his["level_exp"],query_max_exp(his["level"]),110,NOR,HIR,HIW),                    
                                his["level_exp"],
                                his["level_exp"]*100/query_max_exp(his["level"]) );             
        msg+= sprintf(CYN"\t  防御"YEL" : "NOR HIR"%d "NOR CYN"点\n"NOR,his["armor_prop"]["armor"]);
        msg+= sprintf(CYN"\t加招架"YEL" : "NOR HIR"%d "NOR CYN"点\n"NOR,his["armor_prop"]["parry"]);
        msg+= sprintf(CYN"\t加闪避"YEL" : "NOR HIR"%d "NOR CYN"点\n"NOR,his["armor_prop"]["dodge"]);
        msg+= sprintf(CYN"\t加法术"YEL" : "NOR HIR"%d "NOR CYN"点\n"NOR,his["armor_prop"]["spells"]);
        msg+= sprintf(CYN"\t加内功"YEL" : "NOR HIR"%d "NOR CYN"点\n"NOR,his["armor_prop"]["force"]);
        msg+= sprintf(CYN"\t盾时限"YEL" : "NOR HIR"%s "NOR CYN"点\n"NOR,FINGER_D->age_string(his["shield_time"]));
        tell_object(me,msg);
        return 0;       //为了不和其他命令(比如袈裟修炼)冲突，这里我返回值直接设为0
        }
if ( ob->query("equipped") )
        return err_msg("你先得把圣衣脱下来。\n");       
if ( my["kee"]<50
  || my["sen"]<50 )
        return err_msg("你现在状态不佳，实在是难以修炼圣衣。\n");   
if ( my["force"]<my["max_force"]/3*2 )
        return err_msg("你的内力不够充沛。\n");         
if ( my["mana"]<my["mana"]/3*2 )
        return err_msg("你的法力不够充沛。\n");         
if ( my["combat_exp"]<5000000 )
        return err_msg("你的武学不够。\n");     
if ( my["daoxing"]<1000000 )
        return err_msg("你的道行不够。\n");     
if ( my["max_force"]<1000 
  || my["maximum_force"]<1000 )
        return err_msg("你的内力太低了。\n");             
if ( my["max_mana"]<1000
  || my["maximum_mana"]<1000  )
        return err_msg("你的法力太低了。\n");           
if ( my["potential"]-my["learned_points"]<0 )
        return err_msg("你的潜能不够了。\n");   
if ( my["level"]<his["level"] )
        return err_msg("你的等级不够"+chinese_number(his["level"])+"。\n");
write(HIG"你暗运真气，以毕生的修为慢慢修炼"+ob->name()+HIG"，"NOR);

my["combat_exp"]-= 1000;
my["daoxing"]-= 500;
my["maximum_force"]-= 5;
my["maximum_mana"]-= 5;
my["max_force"]-= 5;
my["max_mana"]-= 5;

my["learned_points"]+= 1;
my["kee"]-= 50;
my["sen"]-= 50;
my["force"]-= 50;
my["mana"]-= 50;

me->save();

if ( random(my["kar"]+my["int"]+my["spi"])<40 )
        write(HIG"结果什么反应也没有。\n"NOR);
else    {
        write(HIG"圣衣发出一道柔和的金光。\n"NOR);
        his["level_exp"]+= 1;
        if ( his["level_exp"]>=query_max_exp(his["level"]) )
                {
                his["level_exp"] = 0;
                his["level"]+= 1;
                his["armor_prop"]["armor"]+= random(5);
                his["armor_prop"]["parry"]+= random(5);
                his["armor_prop"]["dodge"]+= random(5);
                his["armor_prop"]["spells"]+= random(5);
                his["armor_prop"]["force"]+= random(5);
                his["shield_time"]-= random(10);
                if ( !ob->save() )
                        write("圣衣存储失败，请和巫师联系。\n");
                if ( !ob->restore() )           
                        write("圣衣读取失败，请和巫师联系。\n");                
                write(BLINK+ob->name()+BLINK+HIY"升级了！\n"NOR);
                }
        }
return 1;                               
}
        
string long()
{
string msg;
msg = sprintf(HIY"它目前为一级的圣衣，你可以通过修炼(xiulian)来提高它的防御
以及它的魔法盾时限。目前它能每%s增加一次魔法盾的辅助作用。\n"NOR,
                                FINGER_D->age_string(this_object()->query("shield_time")) );
return this_object()->query("long")+msg;
}
