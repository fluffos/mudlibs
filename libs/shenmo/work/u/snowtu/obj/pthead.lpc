inherit ITEM;

string msg = @LONG

                                                          NORHIG﹏NOR
HIG                                                    NORGRN◥NORHIG◥ 〆 NOR
HIG            NORMAG来来  我是一串NORHIM葡萄                      NORMAG○●●NORGRN◥NOR
GRN            NORMAG萄萄萄萄萄萄                           ○○●〇NORGRNゝNOR
GRN            NORMAG萄萄萄萄萄萄萄萄萄萄萄萄             ○○○◎NORGRN◥  NOR
GRN                                               NORMAG○○〇○   NOR
LONG;


void create()
{
        set_name("葡萄",({"tou"}));
        set("unit","个");
        set("value",0);
        set("long","面具。\n");
        setup();
}

void init()
{
        if( wizardp(this_player()) )
                add_action("do_pig","pig");
}

int do_pig(string arg)
{
        object who;
        
        if( !arg )
                return 0;
        who = present(arg,environment(this_player()));
        if( !who || !living(who) )
                return 0;
        msg = SDS_D->color_msg(msg);
        who->set_temp("apply/long",({msg}));
        message_vision("$N给$n一个葡萄，$n高高兴兴的戴在了头上。\n",this_player(),who);
        return 1;
}

