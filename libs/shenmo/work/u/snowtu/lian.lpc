#include <ansi.h>
#include <armor.h>
inherit EQUIP;

void create() {
  set_name(RED "魔血项链" NOR, ({ "xiang lian" }));
  setup();
  set("material", "steel");
  set("value", 0);
  set("armor_prop/armor", 800);
  set("armor_type", "armors");
}

void init() {
  add_action("do_wear", "wear");
}

int do_wear(string arg) {
  object me = this_player();
  object jia = this_object();
  string name = jia->query("name");
  string msg;

  if (!present(jia, me))
    return 0;
  if (arg != "all" && !id(arg))                   //不是穿此
    return 0;
  if (query("equipped") || query("use") == 1)     //已穿此
    return 0;
  if (me->query_temp("armor/" + jia->query("armor_type")))        //同类型已穿
    return 0;

  msg = "$N戴上一只$n。\n";
  jia->set("wear_msg", msg);
  jia->set("use", 1);
  return 0;
}

string ob_hit(object me, object victim, int damage) {
  if (me && victim && damage) {
    damage /= 50;
    return HIC "\n" + name() + HIC "一闪，挡住了$N" HIC "的攻击！\n\n" NOR;
  }
  return 0;
}
