#include <ansi.h>
inherit NPC;

string ask_story();

void create()
{
object ob;	
set_name("老者",({"lao zhe","zhe","lao"}));
set("long","一位满面风霜的老者，发须皆白，双手分别拿着纸扇和惊堂木，
看模样是个说书的风尘之人。\n");
set("age",50+random(50));
set("gender","男性");
set("per",20+random(20));
set("int",40);
set("class","human");
create_family("将军府",2,"弟子");
set("title","说书佬");
set("max_sen",1000);
set("max_kee",1000);
set("max_force",3000);
set("max_mana",3000);
set("force",6000);
set("mana",6000);

set("inquiry",([
	"故事"	:	(: ask_story :),
]));
	
set_skill("force",400);
set_skill("lengquan-force",400);
map_skill("force","lengquan-force");

set_skill("spells",400);
set_skill("baguazhou",400);
map_skill("spells","baguazhou");

set_skill("dodge",400);
set_skill("yanxing-steps",400);
map_skill("dodge","yanxing-steps");

set_skill("parry",400);
set_skill("wusi-mace",400);
set_skill("mace",400);
map_skill("mace","wusi-mace");
map_skill("parry","wusi-mace");

set("str",20);
set("con",10);
set("combat_exp",1000000);
set("daoxing",1000000);
set("master","auto_perform");

setup();
ob = new("/d/obj/weapon/mace/copperjian");
ob->set_name("惊堂木",({"Jing tang mu"}));
ob->set("no_get",1);
ob->set("no_sell",1);
ob->move(this_object());
ob = new("/d/city/npc/obj/zhua");
ob->set_name("纸扇",({"Zhi shan"}));
ob->set("no_get",1);
ob->set("no_sell",1);
ob->move(this_object());
command("wield all");
}

string ask_story()
{
string dir = "/d/三界谕/",*files,file;
files = get_dir(dir);
if ( sizeof(files)<0 )
	return "没什么可说的。。。";
file = files[random(sizeof(files))];	
if ( !stringp(file) )
	return "暂时也没什么可说的。。。";
message_vision("$N呵呵一笑，捻了捻长须道："+file+"的故事客官许是早有耳闻...\n",this_object());
message_vision("$N又神秘一笑，不过如果身临其境，却又是一番滋味。\n",this_object());
("/d/三界谕/"+file+"/start")->start_story(this_object(),this_player());
return "呵呵，但试过了便知。";
}
