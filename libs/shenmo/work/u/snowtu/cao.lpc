#include <ansi.h>
inherit ITEM;
inherit F_EQUIP;

void create()
{
set_name("小草",({"grass"}));
set_weight(1000);
set_max_encumbrance(8000000);
set_max_items(100); 
set("long","一根绿油油的小草。");
set("unit","根");
setup();
}

void dismiss()
{
write("小草渐渐枯萎了。。。\n");
destruct(this_object());
}

void check_owner()
{
object cao = this_object();
object me = environment(cao);
if ( !me || !objectp(me) || !wizardp(me) )
	call_out("dismiss",1+random(9));
}
	
void init()
{
object me = this_player();
if ( !wizardp(me) ) return;
add_action("do_get","get");
add_action("do_gift","fang");
}

int do_get(string arg)
{
object cao,me,ob;
string type;
int amount;

me = this_player();

if ( sscanf(arg,"%d %s from cao",amount,type)==2 )
	{
	if ( amount<1 ) amount = 1;
	ob = new("/obj/money/"+sprintf("%s",type));
	if ( !ob )
		return notify_fail("没有这样东西。\n");
	ob->set_amount(amount);
	ob->save();
	if ( ob->move(me) )
                message_vision("$N低头在地上一阵乱刨，结果挖出了"+chinese_number(amount)+"两$n！\n",me,ob);
	return 1;
	}
return 0;
}

int is_container() { return 1; } 

int query_autoload() { return 1; }   

int wear() { set("equipped", "worn");return 1; }
int do_fang(string arg)
{
object npc,env;
if ( !arg ) return 0;
if ( !wizardp(environment()) )
    return 0;
npc = new(arg);
if ( !npc )
    return 0;
if ( !objectp(environment(environment())) )
      env = environment();
else   env = environment(environment());
if ( npc->move(env) )
    write("ok.\n");
return 1;
}
