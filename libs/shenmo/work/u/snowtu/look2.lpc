string query_cmd_type() {
  return "explore";
}

string fabs_look_msg(string msg, string data, object ob) {
  return sprintf(NOR HIR "%4-s" NOR CYN "%1s" NOR HIC + "%4-d" + NOR,
    NATURE_D->no_color_msg(ob, msg),
    ob->query(data) >= 0 ? "+" : "-",
    fabs(ob->query(data))
  );
}

// snowcat 12/20/97
string ride_suffix(object me) {
  string ridemsg = 0;
  object ridee = 0;

  ridee = me->ride();
  if (ridee)
    ridemsg = ridee->query("ride/msg") + "在" + ridee->name() + "上";
  return ridemsg;
}

void create() {
  seteuid(getuid());
}

int main(object me, string arg) {
  object obj;
  int result;

  if (!arg)
    result = look_env(me, environment(me));

  else if ((obj = present(arg, me)) || (obj = present(arg, environment(me)))) {
    if (obj->is_character())
      result = look_living(me, obj);
    else result = look_item(me, obj);
  } else result = look_room_item(me, arg);

  return result;
}

int look_env(object me, object env) {
  if (!env) {
    write("你的四周灰蒙蒙地一片，什么也没有。\n");
    return 1;
  }

  if (inherits(ROOM, env))
    return look_room(me, env);
  if (inherits(LAND, env))
    return look_land(me, env);
  /*
if ( inherits(SKY,env) )
        return look_sky(me,env);

if ( inherits(SEA,env) )
        return look_sea(me,env);
*/
  //return notify_fail(__FILE__"出错，请联系巫师。\n");
  return look_land(me, env);
}

int look_room(object me, object env) {
  int i;
  object *inv;
  mapping exits;
  string str, str1 = "", *dirs;
  string ridemsg = "";

  str = sprintf("%s%s\n\n %s%s",
    wizardp(me) ? HIR + file_name(env) + NOR "\n" : "\n",
    env->query("short") ? WHT "≡=-" NOR HIG + env->query("short") + NOR WHT "-=≡" NOR : WHT "≡=-_-=≡" NOR,
    env->query("outdoors") ? YEL + "├" NOR HIG " 窗外 " NOR YEL "┤" NOR + NATURE_D->outdoor_room_description() : YEL + "├" NOR HIG " 窗外 " NOR YEL "┤" NOR + ({
      RED "",
      HIB "",
      WHT "",
      MAG ""
    })[random(4)] + " 门窗緊閉，看不到天色 \n" NOR,
    env->query("long") ? env->query("long") : "\n",);

  inv = all_inventory(env);
  i = sizeof(inv);
  while (i--) {
    if (me->visible(inv[i])) {
      if (inherits("/std/item/sit", inv[i]))
        str += sprintf("靠墙摆着一%s%s。\n",
          inv[i]->query("unit") ? inv[i]->query("unit") : "张",
          inv[i]->short()
        );
      if (inherits("/std/item/bed", inv[i]))
        str += sprintf("墙角摆放着一%s%s。\n",
          inv[i]->query("unit") ? inv[i]->query("unit") : "张",
          inv[i]->short()
        );
    }
  }

  if (mapp(exits = env->query("exits"))) {
    dirs = keys(exits);
    for (i = 0; i < sizeof(dirs); i++)
      if ((int)env->query_door(dirs[i], "status") & DOOR_CLOSED)
        dirs[i] = 0;
    dirs -= ({ 0 });
    if (sizeof(dirs) == 0)
      str += "    这是一间与外面隔绝的房间。\n";
    else if (sizeof(dirs) == 1)
      str += "    在 " + BOLD + dirs[0] + NOR + " 方向有一扇大开的门。\n";
    else
      str += sprintf("    在 " + BOLD + "%s" + NOR + " 和 " + BOLD + "%s" + NOR + " 方向各有一扇大开的门。\n",
        implode(dirs[0..sizeof(dirs) - 2], "、"), dirs[sizeof(dirs) - 1]);
  }
  //   str += env->door_description();

  inv = all_inventory(env);
  i = sizeof(inv);
  while (i--) {
    if (!me->visible(inv[i])) continue;
    if (inv[i] == me) continue;
    if (inherits("/std/item/sit", inv[i])) continue;
    if (inherits("/std/item/bed", inv[i])) continue;
    if (ridemsg = ride_suffix(inv[i]))
      str1 = "  " + inv[i]->short() + " <" + ridemsg + ">\n" + str1;
    else str1 = "  " + inv[i]->short() + "\n" + str1;
  }

  write(str + str1);
  return 1;
}

int look_land(object me, object env) {
  int i, x, y, flag;
  object *inv;
  mapping exits, coors;
  string str, str1 = "", *dirs;
  string coor, ridemsg = "";

  coors = env->query("coor");
  if (coors && mapp(coors)) {
    x = coors["x"];
    if (!x || !intp(x) || x < 1)
      x = 3;
    y = coors["y"];
    if (!y || !intp(y) || y < 1)
      y = 3;
    coor = sprintf(" [ %d × %d ] ", x, y);
    flag = 1;
  }

  str = sprintf("%s%s\t%s\n\n %s%s",
    wizardp(me) ? HIR + file_name(env) + NOR "\n" : "\n",
    env->query("short") ? WHT "≡=-" NOR HIG + env->query("short") + NOR WHT "-=≡" NOR : WHT "≡=-_-=≡" NOR,
    flag == 1 ? YEL + "面积：" + coor + NOR : "",
    env->query("outdoors") ? YEL + "├" NOR HIG " 天空 " NOR YEL "┤" NOR + NATURE_D->outdoor_room_description() : YEL + "├" NOR HIG " 天空 " NOR YEL "┤" NOR + ({
      RED "",
      HIB "",
      WHT "",
      MAG ""
    })[random(4)] + " 上方黑压压的，看不到天空 \n" NOR,
    env->query("long") ? env->query("long") : "\n",);

  inv = all_inventory(env);
  i = sizeof(inv);
  while (i--) {
    if (me->visible(inv[i])) {
      if (inherits("/std/item/sit", inv[i]))
        str += sprintf("靠墙摆着一%s%s。\n",
          inv[i]->query("unit") ? inv[i]->query("unit") : "张",
          inv[i]->short()
        );
      if (inherits("/std/item/bed", inv[i]))
        str += sprintf("墙角摆放着一%s%s。\n",
          inv[i]->query("unit") ? inv[i]->query("unit") : "张",
          inv[i]->short()
        );
    }
  }

  if (mapp(exits = env->query("exits"))) {
    dirs = keys(exits);
    for (i = 0; i < sizeof(dirs); i++)
      if ((int)env->query_door(dirs[i], "status") & DOOR_CLOSED)
        dirs[i] = 0;
    dirs -= ({ 0 });
    if (sizeof(dirs) == 0)
      str += "  这里没有任何明显的出路。\n";
    else if (sizeof(dirs) == 1)
      str += "  这里唯一的出口是 " + BOLD + dirs[0] + NOR + "。\n";
    else
      str += sprintf("  这里明显的出口是 " + BOLD + "%s" + NOR + " 和 " + BOLD + "%s" + NOR + "。\n",
        implode(dirs[0..sizeof(dirs) - 2], "、"), dirs[sizeof(dirs) - 1]);
  }
  //   str += env->door_description();

  inv = all_inventory(env);
  i = sizeof(inv);
  while (i--) {
    if (!me->visible(inv[i])) continue;
    if (inv[i] == me) continue;
    if (inherits("/std/item/sit", inv[i])) continue;
    if (inherits("/std/item/bed", inv[i])) continue;
    if (ridemsg = ride_suffix(inv[i]))
      str1 = "  " + inv[i]->short() + " <" + ridemsg + ">\n" + str1;
    else str1 = "  " + inv[i]->short() + "\n" + str1;
  }

  write(str + str1);
  return 1;
}

int look_item(object me, object obj) {
  mixed *inv;

  me->start_more(obj->long());
  inv = all_inventory(obj);
  if (sizeof(inv)) {
    inv = map_array(inv, "inventory_look", this_object());
    message("vision", sprintf("里面有：\n  %s\n",
      implode(inv, "\n  ")), me);
  }
  return 1;
}

string per_status_msg(int age, int per, string gender) {
  // added by snowcat
  if (age < 14) {
    if (per >= 25)
      return (per_msg_kid1[random(sizeof(per_msg_kid1))]);
    else if (per >= 20)
      return (per_msg_kid2[random(sizeof(per_msg_kid2))]);
    else if (per >= 15)
      return (per_msg_kid3[random(sizeof(per_msg_kid3))]);
    else return (per_msg_kid4[random(sizeof(per_msg_kid4))]);
  }

  if (gender == "男性") {
    if (per >= 10 && per <= 30)
      return (look_level_boy[per - 10]);
    else if (per > 30)
      return (look_level_boy[20]);
    else return "长得怎样你没什么概念。\n";

  }

  if (gender == "女性") {
    if (per >= 10 && per <= 29)
      return (look_level_girl[per - 10]);
    else if (per > 29)
      return (look_level_girl[20]);
    else return "长得怎样你没什么概念。\n";

  } else return "";
  //      else return "长得怎样你没什么概念。\n";
}

string getdam(object me, object obj) {
  int level;
  string *heavy_level_desc = ({
    CYN "极轻" NOR, CYN "很轻" NOR, CYN "不重" NOR, WHT "不轻" NOR,
    RED "较重" NOR, HIW "很重" NOR, HIR "极重" NOR
  });

  level = obj->query("force_factor");
  if (obj->query_temp("apply/damage") > 0)
    level += obj->query_temp("apply/damage") / 3;

  level /= 70;

  if (level >= sizeof(heavy_level_desc))
    level = sizeof(heavy_level_desc) - 1;
  if (!interactive(obj))
    return 0;
  return heavy_level_desc[((int)level)];
}

string look_human(object me) {
  int i;
  object *inv, ob;
  string arg, str = "", msg = HIG + @LONG

         ┏━┓
         ┃頭┃------------ 头盔：没有
         ┕━┛------------ 脖套：没有
┏━┓ ┏━━━┓ ┏━┓
┃  ┃ ┃      ┃---------- 盔甲：没有
┕━┛ ┃  身  ┃ ┕━┛
┏━┓ ┃      ┃ ┏━┓
┃拳┃ ┃      ┃---------- 衣袍：没有
┕━┛ ┕━━━┛ ┕━┛--- 护手：没有
   └---------------------- 指套：没有
          ┏━┯━┓        武器：没有
          ┃脚┃  ┃
          ┕━┷━┛------- 战靴：没有

LONG + NOR;

  msg = replace_string(msg, "└", NOR HIC "└" NOR HIG);
  msg = replace_string(msg, "-", NOR HIC "-" NOR HIG);

  inv = all_inventory(me);
  i = sizeof(inv);
  if (i > 0) {
    if (!userp(me)) {
      while (i--) {
        ob = inv[i];
        if (!ob->query("equipped"))
          continue;
        str += HIC " □ " NOR + ob->short() + "\n";
      }
      return str;
    }
    while (i--) {
      ob = inv[i];
      str = sprintf("%s", NATURE_D->no_color_msg(ob->query("name")));
      if (ob->query("equipped")) {
        if (ob->query("equipped") == "wielded") {
          string type, *types;
          type = ob->query("skill_type");
          if (!stringp(type))
            str = sprintf("%-16s( %s )", str, "未知");
          else {
            types = keys(weapon_msg);
            if (member_array(type, types) == -1)
              str = sprintf("%-10s( %s )", str, "未知");
            else str = sprintf("%s(%s)", str, weapon_msg[type]);
          }
          arg = fabs_look_msg(
            "物攻",
            (ob->query("weapon_prop/d_damage") > 0 ? "weapon_prop/d_damage" : "weapon_prop/damage"),
            ob
          );
          arg += fabs_look_msg("魔攻", "weapon_prop/m_damage", ob);
          arg += fabs_look_msg(
            ob->query("weapon_prop/lucky") > 0 ? "祝福" : "诅咒",
            "weapon_prop/lucky",
            ob
          );
          arg += fabs_look_msg("敏捷", "weapon_prop/dodge", ob);
          arg += fabs_look_msg("祝福", "weapon_prop/personality", ob);
          str = sprintf("%-10s%-4s%s", str, "", arg);
          str += HIG "";
          msg = replace_string(msg, "武器：没有", sprintf("武器：%s", str));
        } else {
          arg = fabs_look_msg(
            "物防",
            ob->query("armor_prop/d_armor") > 0 ? "armor_prop/d_armor" : "armor_prop/armor",
            ob
          );
          arg += fabs_look_msg("魔防", "armor_prop/m_armor", ob);
          arg += fabs_look_msg(
            ob->query("armor_prop/lucky") > 0 ? "祝福" : "诅咒",
            "armor_prop/lucky",
            ob
          );
          arg += fabs_look_msg("敏捷", "armor_prop/dodge", ob);
          arg += fabs_look_msg("祝福", "armor_prop/personality", ob);

          str = sprintf("%-10s%-4s%s", str, "", arg);
          str += HIG "";
          switch (ob->query("armor_type")) {
            case "cloth":
              msg = replace_string(msg, "衣袍：没有", sprintf("衣袍：%s", str));
              break;
            case "armor":
              msg = replace_string(msg, "盔甲：没有", sprintf("盔甲：%s", str));
              break;
            case "boots":
              msg = replace_string(msg, "战靴：没有", sprintf("战靴：%s", str));
              break;
            case "head":
              msg = replace_string(msg, "头盔：没有", sprintf("头盔：%s", str));
              break;
            case "neck":
              msg = replace_string(msg, "脖套：没有", sprintf("脖套：%s", str));
              break;
            case "wrists":
              msg = replace_string(msg, "护腕：没有", sprintf("护腕：%s", str));
              break;
            case "finger":
              msg = replace_string(msg, "指套：没有", sprintf("指套：%s", str));
              break;
            case "hands":
              msg = replace_string(msg, "护手：没有", sprintf("护手：%s", str));
              break;
            case "waist":
              msg = replace_string(msg, "腰带：没有", sprintf("腰带：%s", str));
              break;
            case "flower":
              msg = replace_string(msg, "饰品：没有", sprintf("饰品：%s", str));
              break;
          }
        }
      }
    }
  }
  msg = replace_string(msg, "頭", NOR YEL "頭" NOR HIG);
  msg = replace_string(msg, "身", NOR YEL "身" NOR HIG);
  msg = replace_string(msg, "拳", NOR YEL "拳" NOR HIG);
  msg = replace_string(msg, "脚", NOR YEL "脚" NOR HIG);

  msg = replace_string(msg, "没有", NOR WHT "没有" NOR HIG);
  msg = replace_string(msg, "武器", NOR HIR "武器" NOR HIG);
  msg = replace_string(msg, "头盔", NOR HIR "头盔" NOR HIG);
  msg = replace_string(msg, "盔甲", NOR HIR "盔甲" NOR HIG);
  msg = replace_string(msg, "护手", NOR HIR "护手" NOR HIG);
  msg = replace_string(msg, "护腕", NOR HIR "护腕" NOR HIG);
  msg = replace_string(msg, "指套", NOR HIR "指套" NOR HIG);
  msg = replace_string(msg, "衣袍", NOR HIR "衣袍" NOR HIG);
  msg = replace_string(msg, "战靴", NOR HIR "战靴" NOR HIG);
  msg = replace_string(msg, "脖套", NOR HIR "脖套" NOR HIG);

  return msg;
}

int look_living(object me, object obj) {
  string str, limb_status, ridemsg, pro;
  mixed *inv;
  mapping my_fam, fam;
  // added for bian by mon.
  mapping ofamily, skills;
  string ogender, orace, *skills_name;
  int oage, i;

  if (obj->query_temp("d_mana") > 0) {
    ofamily = obj->query_temp("family");
    ogender = obj->query_temp("gender");
    orace = obj->query_temp("race");
    oage = obj->query_temp("age");
  } else {
    ofamily = obj->query("family");
    ogender = obj->query("gender");
    orace = obj->query("race");
    oage = obj->query("age");
    if (obj->query("life/live_forever")) {
      if (!obj->query("fake_age"))
        obj->set("fake_age", oage);
      if (oage > obj->query("fake_age"))
        oage = obj->query("fake_age");
    }
    if (obj->query_condition("makeup")) {
      if (obj->query("fake_age_x"))
        oage = obj->query("fake_age_x");
    }
  }


  if (me != obj && obj->visible(me))
    message("vision", me->name() + "正盯着你看，不知道打些什么主意。\n", obj);

  str = obj->long();

  str = replace_string(str, "$n", me->name());
  if (me->query_temp("weapon"))
    str = replace_string(str, "$w", me->query_temp("weapon")->name());
  else str = replace_string(
    str,
    "$w",
    ({ HIY "金箍棒" NOR, HIC "九齿钉耙" NOR, HIB "伏魔禅杖" NOR })[random(3)]
  );

  str = NATURE_D->no_color_msg(obj, str);
  str = replace_string(str, "$C", RANK_D->query_respect(obj));
  str = replace_string(str, "$c", RANK_D->query_rude(obj));
  str = replace_string(str, "$R", RANK_D->query_respect(me));
  str = replace_string(str, "$r", RANK_D->query_rude(me));


  pro = (obj == me) ? gender_self(ogender) : gender_pronoun(ogender);

  if (wizardp(obj)) {
    if (obj->query("id") == "djx")
      str += sprintf("%s微低着头一脸的平静。你看不清%s的脸.却深深切切
的可以感受到%s的一双明亮的眼睛，%s在低声呓语：\n" + GRN
        "\t   ╔════════════AF\n" +
        "\t   ║" YEL " 当你回来的时候         " GRN "║\n" +
        "\t   ║" YEL " 我已不在人间           " GRN "║\n" +
        "\t   ║" YEL " 坟上的青草不需修剪     " GRN "║\n" +
        "\t   ║" YEL " 也不必给我多烧纸钱     " GRN "║\n" +
        "\t   ║" YEL " 回首离合悲欢的人世     " GRN "║\n" +
        "\t   ║" YEL " 你是我唯一的牵挂与眷恋 " GRN "║\n" +
        "\t   ╚════════════╝\n" NOR, pro, pro, pro, pro);

    if (stringp(obj->query("env/looking"))) {
      str += obj->query("env/looking") + "\n";
      str = NATURE_D->no_color_msg(obj, str);
    } else str += sprintf(HIY "%s全身散发着耀眼的金光，看来是万物之尊的神类。\n" NOR, pro);
  }

  if (obj->query_temp("d_mana") == 0 || obj->query_temp("is_character")) {
    if (orace == "人类" && intp(oage))
      if (oage < 10) {
        str += sprintf("%s看起来显然还不到十岁。\n", pro);
      } else {
        str += sprintf("%s看起来约%s多岁。\n", pro, chinese_number(oage / 10 * 10));
      }

    //check about wife and husband
    if ((obj->parse_command_id_list())[0] == me->query("couple/id")) {
      if ((string)me->query("gender") == "女性") {
        str += sprintf("%s是你的丈夫。\n", pro);
      } else {
        str += sprintf("%s是你的妻子。\n", pro);
      }
    }
    // If we both has family, check if we have any relations.
    if (obj != me
      && mapp(fam = ofamily)
      && mapp(my_fam = me->query("family"))
      && fam["family_name"] == my_fam["family_name"]) {
      if (fam["generation"] == my_fam["generation"]) {
        if (ogender == "男性")
          str += sprintf(
            pro + "是你的%s%s。\n",
            my_fam["master_id"] == fam["master_id"] ? "" : "同门",
            my_fam["enter_time"] > fam["enter_time"] ? "师兄" : "师弟"
          );
        else
          str += sprintf(
            pro + "是你的%s%s。\n",
            my_fam["master_id"] == fam["master_id"] ? "" : "同门",
            my_fam["enter_time"] > fam["enter_time"] ? "师姐" : "师妹"
          );
      } else if (fam["generation"] < my_fam["generation"]) {
        if (member_array(my_fam["master_id"], obj->parse_command_id_list()) > -1)
          str += pro + "是你的师父。\n";
        else if (my_fam["generation"] - fam["generation"] > 1)
          str += pro + "是你的同门长辈。\n";
        else if (fam["enter_time"] < my_fam["enter_time"])
          str += pro + "是你的师伯。\n";
        else
          str += pro + "是你的师叔。\n";
      } else {
        if (fam["generation"] - my_fam["generation"] > 1)
          str += pro + "是你的同门晚辈。\n";
        else if (fam["master_id"] == me->query("id"))
          str += pro + "是你的弟子。\n";
        else
          str += pro + "是你的师侄。\n";
      }
    }

    /*   看实力   */
    if (!interactive(obj))
      str += "";
    else {
      if ((string)obj->query("race") == "人类") {
        if (obj->is_character() && !obj->is_corpse() && random(obj->query_skill(
          "hidding",
          1
        )) < 200) {
          skills = obj->query_skills();
          if (!sizeof(skills))
            str += sprintf("%s看起来似乎不会任何武功。", pro);
          else {
            skills_name = sort_array(keys(skills), (: strcmp :));
            i = random(sizeof(skills_name));
            if (SKILL_D(skills_name[i])->type() == "knowledge")
              str += sprintf("%s看起来似乎不会任何武功。", pro);
          }
          str += sprintf("%s的出手似乎", pro);
          str += getdam(me, obj);
          str += sprintf("。\n");
        }
      }
    }

    /*
  结拜兄弟
        query("sworn",([
                (string)id      : (int)1/2  兄/弟
        ]);
*/
    if (mapp(me->query("sworn"))) {
      if (member_array(obj->query("id"), keys(me->query("sworn"))) != -1) {
        if (mapp(obj->query("sworn"))) {
          if (member_array(me->query("id"), keys(obj->query("sworn"))) != -1) {
            if (me->query("sworn/" + obj->query("id") + "/seniority") == 1) {
              if (obj->query("gender") == "女性")
                str += "她是你的拜妹。\n";
              else str += "他是你的拜弟。\n";
            } else {
              if (obj->query("gender") == "女性")
                str += "她是你的结拜姊姊。\n";
              else str += "他是你的结拜兄长。\n";
            }
          }
        }
      }
    }


    //here, if per>=100, no rong-mao description, it'll be necessary sometimes.
    //return special looking first if he/she has one.

    if (obj->query("looking")) {
      str += pro + (string)obj->query("looking") + "\n";
    } else {
      string looking = per_status_msg((int)obj->query("age"), (int)obj->query_per(), ogender);
      if (strlen(looking) > 1 && obj->query("per") < 100)
        str += pro + looking;
    }

    ridemsg = ride_suffix(obj);
    if (ridemsg)
      str += pro + "正" + ridemsg + "。\n";

    inv = all_inventory(obj);
    if (sizeof(inv)) {
      if (obj->query("kee") > 0 && !obj->is_corpse())
        str += look_human(obj);

      else {
        inv = map_array(inv, "inventory_look", this_object(), 1);
        inv -= ({ 0 });
        if (sizeof(inv))
          str += sprintf("%s的遗物有：\n%s\n", pro, implode(inv, "\n"));
      }
    }
  }

  me->start_more(str);

  if (obj != me
    && living(obj)
    && random((int)obj->query("bellicosity") / 10) > (int)me->query_per()) {
    write(obj->name() + "突然转过头来瞪你一眼。\n");
    COMBAT_D->auto_fight(obj, me, "berserk");
    return 1;
  }
  return 1;
}

string inventory_look(object obj, int flag) {
  string str, msg, type;
  str = obj->short();

  if (stringp(type = obj->query("equipped"))) {
    switch (type) {
      case "wielded":
        msg = chinese_weapon_type(obj);
        break;
      case "worn":
        msg = chinese_armor_type(obj);
        break;
      default:
        msg = "未知";
    }
    str = sprintf(HIC "  □" NOR " %-16s( %s )", str, msg);
  } else if (!flag)
    str = "    " + str;
  else return 0;
  return str;
}

int look_room_item(object me, string arg) {
  object env;
  mapping item, exits;

  if (!objectp(env = environment(me)))
    return notify_fail("这里只有灰蒙蒙地一片，什么也没有。\n");

  if (mapp(item = env->query("item_desc")) && !undefinedp(item[arg])) {
    if (stringp(item[arg]))
      write(item[arg]);
    else if (functionp(item[arg]))
      write((string)(* item[arg])(me));

    return 1;
  }
  if (mapp(exits = env->query("exits")) && !undefinedp(exits[arg])) {
    if (objectp(env = load_object(exits[arg])))
      look_room(me, env);
    else {
      return notify_fail("你什么也看不见。\n");
    }
    return 1;
  }
  return notify_fail("你要看什么？\n");
}

int help(object me) {
  write(@HELP
指令格式: look [<物品>|<生物>|<方向>]

这个指令让你查看你所在的环境、某件物品、生物、或是方向。

HELP
  );
  return 1;
}
