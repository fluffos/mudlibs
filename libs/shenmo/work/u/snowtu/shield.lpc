#include <armor.h>
#include <ansi.h>
#include <combat.h>
inherit SHIELD;
#include "/d/sds4/obj/attack.h"

void jia_condition(object me,object ob);
void check_owner();
void destroy(object ob);

void create()
{
set_name(HIG"复活戒指"NOR, ({"life ring", "ring", "life"}));
set_weight(5000);
if ( clonep() )
     set_default_object(__FILE__);
else {
        set("unit", "枚");
        set("material", "wood");
        set("armor_prop/armor",45);
        set("no_give",1);
        set("no_get",1);
        set("armor_prop/dodge", -5);
        set("remove_msg",HIG"$n"HIG"呼的从$N"HIG"身上消失了。\n"NOR);  
        set("wear_msg",HIG"$n"HIG"从虚无中“呼”的出现在$N"HIG"的身上。\n"NOR);
        }
setup();
}

int init()
{
check_owner();
if ( userp(this_player()))
add_action("do_shield","shield");
add_action("do_wear","wear");
}

int do_wear(string arg)
{
object me = this_player();
if ( !arg && !id(arg) && arg!="all" )  return 0;
if ( !this_object()->wear() )
       return 0;
message_vision(query("wear_msg"),me,this_object());
me->set_temp("apply/super_shield",([
       "type"  : "kee",
       "persent"  : 100,
       "unenduring"  : 0,
       "fabao"  : this_object(),
]));
return 0;
}


void check_owner()
{
object obj;
object ob =this_object();
object me =environment(ob);
if ( me->query("sds4/king")!="done" && !wizardp(me) )
        destroy(ob);
if ( objectp(obj=present("sea dun",me)) && obj!=ob )
        destroy(ob);
return;
}

void destroy(object ob)
{
message_vision(HIY"天空中伸出一只大手,一把抓起$N"HIY"！\n"NOR,ob);
destruct(ob);
return;
}

int query_autoload()
{
object ob =this_object();
object me =environment(ob);
if ( me->query("sds4/king")!="done" && !wizardp(me))
        return 0;
else    return 1;
}

int do_shield ()
{
int i,k,damage,time,ap,dp;
string *limbs;
object weapon,ob,me,target;
ob=this_object();
me=environment(ob);
target =offensive_target(me);
time=me->query_skill("spells");
time/=100;
time-=10;
time/=2;
if ( time<1 ) time =1;
if ( time>5 ) time =5;

if( !me->is_fighting() || !target  || ! present( target,environment(me)) )
        return notify_fail("你并不在战斗中。\n");
if ( !ob->query("equipped") || !userp(me) )
        return notify_fail("你必须先装备上海王盾。\n");
if ( me->is_busy() && target->query("kee")<target->query("max_kee")/2 )
        return notify_fail("你正忙着呢。\n");
if ( time()<me->query_temp("shield")+1+random(3) ) 
        return notify_fail("你已经祭出海王盾了，还是休息休息吧。\n");

me->set_temp("shield",time());
message_vision(HIG"$N"HIG"将手中$n"HIG"朝天一抛，口中念道：以
与海皇之契，助我，疾！\n"NOR,me,ob );

if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(MAG"\n\n$N"MAG"遵循海皇之约，借$n"MAG"的力量使出了海皇的绝学！\n"NOR,me,ob);
ap = COMBAT_D->skill_power(me,"spells");
dp = COMBAT_D->skill_power(target,"spells");
ap+= me->query("mana_factor");
dp+= target->query("mana_factor");
ap+= me->query_temp("apply/spells");
dp+= target->query_temp("apply/armor_vs_force")/3;
ap = ap+random(ap);
ap*= 10;
dp*= 10;
if ( COMBAT_D->restrain(me,target) )
        ap+= ap/5;
if ( COMBAT_D->restrain(target,me) )
        dp+= dp/5;
        
damage = 400+random(400);
limbs=target->query("limbs");
notify_fail("结果什么反应也没有。\n");
k = random(100);
if (k<10) 
        return do_attack1(me,target,damage,ap,dp);
else if (k<20)  
        return do_attack2(me,target,damage,ap,dp);
else if (k<30) 
        return do_attack3(me,target,damage,ap,dp);
else if (k<40) 
        return do_attack4(me,target,damage,ap,dp);
else if (k<50) 
        return do_attack5(me,target,damage,ap,dp);
else if ( k<60 )
        return do_attack6(me,target,damage,ap,dp);
else if ( k<70 )
        return do_attack7(me,target,damage,ap,dp);
else if ( k<80 )
        return do_attack8(me,target,damage,ap,dp);
else if ( k<90 )
        return do_attack9(me,target,damage,ap,dp);
else    return do_attack10(me,target,damage,ap,dp);
}
