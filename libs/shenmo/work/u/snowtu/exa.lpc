#include <ansi.h>
inherit "/u/snowtu/perform";

void create(object me,object target)
{
int persent,damage,mypot,hispot;

set("name","一剑落九雁");
set("family","月宫");
set("limit_skill",([
        "snowsword"     : 100,
        "dodge" : 100,
        "sword" : 100,
]));
set("force",500);
set("damage_type","kee");
set("busy_self",3);
if ( me && me->is_fighting() && target )
        {
        mypot = me->query("combat_exp");
        hispot = target->query("combat_exp");
        mypot/= 5000;
        if ( mypot<1 ) mypot=1; 
        hispot/= 5000;
        if ( hispot<1 ) hispot=1;       
        persent = random(mypot)-random(hispot/2);
        set("persent",persent);
        damage=(int)me->query_str()-random((int)target->query_str());
        if ( damage<10 ) damage=10;
        set("damage",damage);
        }
}

void hit_msg(object me,object target)
{
string msg;
int lvl=me->query_skill("snowsword",1);
lvl=(int)(lvl/20);
if (lvl>9) lvl=9;
msg=RED+"$N使出[一剑落"+chinese_number(lvl)+"雁],幻出数道剑影向$n攻去.\n"+NOR;
message_vision(msg,me,target);
return;
}

void success_hit_msg(object me,object target)
{
message_vision(RED+"$n躲闪不及,身上划出几道大口子.流血不止.\n"+NOR,me,target);
return;
}

void lost_hit_msg(object me,object target)
{
message_vision(CYN+"$n身形一展,轻轻巧巧躲过了这招.\n"+NOR, me, target);
return;
}


