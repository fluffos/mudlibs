//李存孝
inherit TROOP;
int valid_appoint(string usage) { return usage=="shenwu-jun"; }

int practice_troop(object me)
{
        if( (int)me->query("kee") < 30 )
                return notify_fail("你的士兵体力不够了，休息一下再练吧。\n");
        if( (int)me->query("force") < 5 )
                return notify_fail("你的士兵士气不够高，让他们休息一下再练吧。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        return 1;
}
int effective_level() { return 1;}
 
string apply_action_file(string action)
{
        return CLASS_D("slg-mode") + "/licunxiao/" + action;
}


