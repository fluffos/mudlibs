#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "战斗区");
  set("long", "没有什么好看的\n\n\n\n\n\n\n");
  set("no_quit", 1);
  //set("broadcast",1);
  set("no_flee", 1);
  set("alternative_die", 1);
  set("no_lianhua", 1);
  set("objects", ([
    /*
   "/quest/抓鬼/obj/seal" : 1,
//     "/d/dntg/sky/npc/moli-qing.lpc" : 1,
     "/u/snowtu/npc/qing.lpc" : 1,
  "/u/snowtu/obj/check" : 1,
*/
  ]));
  setup();
}

void alternative_die(object me) {
  object ob;
  if (!userp(me)) {
    delete("alternative_die");
    if (me->query_temp("last_damage_from"))
      message_vision("\n\n$N被$n杀死了。\n", me, me->query_temp("last_damage_from"));
    me->die();
    set("alternative_die", 1);
    return;
  }
  me->powerup(1);
  me->clear_condition();
  me->remove_all_killer();
  all_inventory(environment(me))->remove_killer(me);
  message_vision("\n$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n\n", me);
  message_vision("地下传来崔判官的声音：切磋之争，不伤阳寿！\n", me);
  message_vision("\n$N慢慢从地上爬将起来。\n", me);
}

void init() {
  object ob, me = this_player();
  if (wizardp(me)) add_action("do_weapon", "wuqi");
  add_action("do_kill", "kill");
  add_action("do_halt", "quit");
}

int do_kill(string arg) {
  object who, me = this_player();
  if (!arg) return 0;
  who = present(arg, environment(me));
  if (!who || !living(who)) return 0;
  if (!userp(who) && who->is_huanbo()) { who->copy_data(me); who->kill_ob(me); return 1; }
  who->kill_ob(me);
  me->kill_ob(who);
  return 1;
}

void broadcast(string str) {
  string prefix = "";
  string s1 = str, s2 = "";
  while (strsrch(s1, "\n\n") != -1)
    s1 = replace_string(s1, "\n\n", "\n");
  if (s1[strlen(s1) - 1] == '\n') {
    s1 = s1[0..strlen(s1) - 2];
    s2 = "\n";
  }
  if (strlen(s1) == 0)
    return;
  s1 = replace_string(s1, "\n", "\n" + prefix) + "";
  reset_eval_cost();
  tell_room("/d/city/entrance", NOR HIR "\n【战斗区】" NOR CYN + prefix + s1 + "\n" NOR);
}

int do_halt() {
  object me = this_player();
  message_vision("$N眼见前途未卜，顿生退意。。。。", me);
  if (me->move("/d/city/kezhan", 1))
    message_vision("$N立即退出了战斗区。\n", me);
  message_vision("\n", me);
  return 1;
}

void valid_move(object who) {
  if (who && userp(who)) {
    who->clear_conditon();
    who->powerup(1);
  }
}

int do_weapon(string id) {
  object who;
  if (!id || !wizardp(this_player()))
    return 0;
  who = find_player(id);
  if (!who)
    return 0;
  who->set("weapon", ([
    "value": 352,
    "type": ([
      "sword": 35,
      "blade": 35,
    ]),
    "make": 1,
    "time": "丁酉年三月八日辰时二刻",
    "name": "无限示",
    "id": "huangtong",
    "or": "海底金母",
  ]));
  write("ok\n");
  return 1;
}

int is_huanbo() { return 1; }
