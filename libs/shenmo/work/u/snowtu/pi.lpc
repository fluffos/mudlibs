inherit ITEM;

void create()
{
set_name("屁",({"pi"}));
set("unit","个");
set("value",0);
set("long","一个又响又臭的屁.....\n");
setup();
}

void greeting()
{
if ( !query("i") )  
     set("i",1);
write("\n\n\n"+name()+"慢慢的曼延开来.....\n\n\n");
remove_call_out("greeting");
destruct(this_object());
}

void init()
{
if ( query("i") )  return;
remove_call_out("greeting");
call_out("greeting",random(60)+5);
}
