#include <ansi.h>
inherit ITEM;

mapping hit_limb = ([
  "limb": ({
    "头部", "颈部", "胸口", "后心", "左肩", "右肩", "左臂", "右臂", "左手", "右手", "腰间", "小腹", "左腿", "右腿", "左脚", "右脚",
  }),
  "damage": ({
    1000, 800, 900, 850, 400, 400, 300, 300, 200, 200, 550, 650, 300, 300, 250, 250,
  }),
]);

string damage_msg(int damage) {
  string str;

  if (damage <= 0)
    return "结果没有造成任何伤害。\n";

  if (damage < 300) return "结果一股焦糊味从$n身上传来。\n";
  else if (damage < 400) return "结果$p双手掐着脖子直喊呼困难。\n";
  else if (damage < 500) return "结果一击命中，$n“轰”的一声，变成了焦碳！\n";
  else if (damage < 600) return "结果一击命中，$n给电得双眼冒泡！\n";
  else if (damage < 700) return "结果「砰」地一声，$n身形悬空，带着一股焦臭直飞而出！\n";
  else if (damage < 800) return "结果这一下「砰」地一声打得$n连连抽搐！\n";
  else if (damage < 900) return "结果重重地击中，$n口吐白沫，抽搐不止！\n";
  else return "结果「砰」地一声巨响，$n浑身焦黑，两眼翻白，看是不行！\n";
}

string status_msg(int ratio) {
  if (ratio < 300) return HIR "看起来可能有些傻呆了。" NOR;
  if (ratio < 400) return HIR "已经呈现弱智的症状。" NOR;
  if (ratio < 500) return HIR "气喘嘘嘘，两腮桃红，看来是有了病。" NOR;
  if (ratio < 600) return RED "似乎十分白痴，原地抽搐起来。" NOR;
  if (ratio < 700) return RED "步伐已然散乱，六神无主的开始梦游。" NOR;
  if (ratio < 800) return RED "看起来已经半活人一个了。" NOR;
  if (ratio < 900) return RED "浑身大面积灼伤，筋骨外翻，眼看不治。" NOR;
  return RED "已经陷入半脑死状态，随时都可能见马克思。" NOR;
}

void create() {
  set_name("操作守则", ({ "book", "shouze" }));
  set("long", "机器人操作要点。\n");
  set("weight", 10);
  set("unit", "本");
  set("no_get", 1);
  set("no_give", 1);
  set("no_put", 1);
  set("no_drop", 1);
  set("no_sell", 1);
  setup();
}

void init() {
  object ob = this_object();
  object me = environment(ob);
  add_action("do_out", "out");
  add_action("do_walk", "go");
  add_action("do_look", "watch");
  add_action("do_look", "look");
  add_action("do_look", "l");
  add_action("do_hit", "hit");
  add_action("do_out", "quit");
  add_action("do_walk", "walk");
  add_action("do_none", "move");
  add_action("do_none", "fly");
  add_action("do_none", "accept");
  add_action("do_none", "cast");
  add_action("do_none", "perform");
  return;
}

int do_none() {
  tell_object(this_player(), "坐在机器人里就安心操作吧。\n");
  return 1;
}

int do_hit(string arg) {
  string msg, str, *limbs, limb;
  int i, lvl, damage;
  object obj;
  object ob = this_object();
  object me = environment(ob);
  object rob = query("rob");
  object where = environment(rob);

  if (me != rob->query("owner"))
    return notify_fail("你不是操作员。\n");
  if (!rob || !where)
    return notify_fail("你不是操作员。\n");
  if (!arg) {
    message("vision", rob->name() + "喀哒一声响！朝着地面发出一道激光！\n", where, rob);
    return 1;
  }
  message_vision("$N按下了激光发射钮。\n", me);
  obj = present(arg, where);
  if (!obj)
    return notify_fail("本区域没有此敌人。\n");

  if (obj == rob)
    return notify_fail("想自残？？\n");
  tell_object(me, "你按下了激光发射按钮。\n");
  msg = HIG "$N" HIG "轰的一声，一道激光射出，直朝$n" HIG "射去！\n" NOR;
  message_vision(msg, rob, obj);
  tell_object(obj, HIG + rob->name() + HIG "的机械臂朝你一转，你眼前强光一闪，瞬时睁眼欲盲！\n" NOR);
  if (me->query("combat_exp") > random(obj->query("combat_exp") / 3)) {
    msg = HIG "激光不偏不正，正好打在$n" HIG "的$l！\n" NOR;
    limbs = hit_limb["limb"];
    i = random(sizeof(limbs));
    limb = limbs[i];
    damage = hit_limb["damage"][i];
    msg = replace_string(msg, "$l", limb);
    msg += HIG + damage_msg(damage) + NOR;
    msg += "($n" + status_msg(damage) + NOR ")\n";
    message_vision(msg, rob, obj);
    msg = HIC "激光不偏不正，正好打在" + obj->name() + "的$l！\n" NOR;
    msg += HIG + damage_msg(damage) + NOR;
    msg += "(" + obj->name() + status_msg(damage) + NOR ")\n";
    msg = replace_string(msg, "$l", limb);
    msg = replace_string(msg, "$n", obj->name());
    tell_object(me, msg);
    obj->add("kee", -obj->query("kee") / 50);
  } else {
    msg = HIG "激光不偏不正，轰的一声打在了一旁的地上！\n" NOR;
    message_vision(msg, rob, obj);
    tell_object(me, msg);
  }
  return 1;
}

int do_walk(string arg) {
  int i;
  mapping exits;
  string msg, *dir;
  object ob = this_object();
  object me = environment(ob);
  object rob = query("rob");
  object where = environment(rob);

  if (me != rob->query("owner"))
    return notify_fail("你不是操作员。\n");
  if (!rob || !where)
    return notify_fail("你不是操作员。\n");
  if (!arg)
    return notify_fail("往那边走？\n");
  exits = where->query("exits");
  if (!exits)
    return notify_fail(where->query("short") + "没有出口。\n");
  dir = keys(exits);
  if (member_array(arg, dir) == -1) {
    msg = HIG + where->query("short") + HIG "的出口为：\n" NOR; ;
    for (i = 0; i < sizeof(dir); i++)
      msg += HIY "\t\t" + dir[i] + "\n" NOR;
    tell_object(me, msg);
    return notify_fail("没有这个出口。\n");
  }
  rob->command("go " + arg);
  if (present(rob, where))
    return notify_fail("动力不足，移动失败。\n");
  tell_room(where, rob->name() + "轰隆一声，朝" + arg + "方向离去。\n");
  tell_object(me, "你朝" + arg + "离去。\n");
  me->command("watch");
  return 1;
}

int do_look() {
  int i;
  mapping exits;
  object where, rob, *obj;
  string msg, *dir, arg, str = "";
  rob = query("rob");
  where = environment(rob);
  if (!objectp(where))
    msg = @LONG
                屏              幕
━━━━━━━━━━━━━━━━━━━━━━━━━

                无      内      容          


━━━━━━━━━━━━━━━━━━━━━━━━━

LONG;
  else {
    msg = @LONG
                屏              幕
━━━━━━━━━━━━━━━━━━━━━━━━━

                目前位置：      $w
                所在场景：      $l
                场景出口：      $e

━━━━━━━━━━━━━━━━━━━━━━━━━
LONG;
    msg = replace_string(msg, "$w", where->query("short"));
    msg = replace_string(msg, "$l", where->query("long"));
    exits = where->query("exits");
    if (!exits)
      msg = replace_string(msg, "$e", WHT "没有出口。" NOR);
    else {
      dir = keys(exits);
      if (sizeof(dir) < 1)
        msg = replace_string(msg, "$e", WHT "没有出口。" NOR);
      else {
        for (i = 0; i < sizeof(dir); i++)
          str += " " + dir[i];
      }
    }
    obj = all_inventory(where);
    if (sizeof(obj) > 0) {
      arg = NOR "\n\t\t\t\t这里有:\n";
      for (i = 0; i < sizeof(obj); i++) {
        arg += "\t\t\t\t" + obj[i]->name() + "(";
        arg += obj[i]->query("id") + ")\n";
      }
    }
    str += arg;
    msg = replace_string(msg, "$e", WHT + str + NOR);
  }
  msg = replace_string(msg, "屏", NOR BLINK HIM "屏" NOR);
  msg = replace_string(msg, "幕", NOR BLINK HIM "幕" NOR);
  msg = replace_string(msg, "━", NOR HIG "━" NOR);
  msg = replace_string(msg, "无    内      容", NOR BLINK HIG "无    内      容" NOR);
  msg = replace_string(msg, "目前", NOR HIG "目前" NOR);
  msg = replace_string(msg, "位置", NOR HIG "位置" NOR);
  msg = replace_string(msg, "所在", NOR HIG "所在" NOR);
  msg = replace_string(msg, "出口", NOR HIG "出口" NOR);
  msg = replace_string(msg, "场景", NOR HIG "场景" NOR);
  write(msg);
  return 1;
}

int do_out() {
  object ob = this_object();
  object me = environment(ob);
  object rob = query("rob");
  object where = environment(rob);
  rob->delete("human");
  rob->delete("owner");
  rob->save();
  me->move(where);
  message_vision(rob->name() + "的舱门一开，$N从里面钻了出来。\n", me);
  destruct(ob);
  return 1;
}
