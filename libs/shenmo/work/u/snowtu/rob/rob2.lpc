#include <command.h>
#include <ansi.h>

#define MAX_OPPENENT 4

inherit CHARACTER;
inherit F_CLEAN_UP;

int accept_fight(object who)
{
say(name()+"什么反应也没有。\n");
return 0;
}

int return_home(object home)
{
object* enemy_list,who;
int i, flag=0;

if( !environment()
 ||  environment()==home )
        return 1;

if ( query("human") )
        return 1;

if( !living(this_object())
||  this_object()->query_temp("no_return") ) return 0;

if( is_fighting() )  
        {
        enemy_list = query_enemy();
        for(i=0; i<sizeof(enemy_list); ++i)  
                {
                if(!enemy_list[i]) continue;
                if( sizeof(enemy_list[i]->query_enemy()) > MAX_OPPENENT )  
                        {
                        message("vision", "\n"+this_object()->name() +
"轰隆一声，停住了！\n\n",environment(), this_object());
                        enemy_list[i]->remove_killer( this_object() );
                        remove_enemy( enemy_list[i] );
                        flag = 1;
                        break;
                        }
                }
        if( !flag )
                return 0;
        }

message("vision",this_object()->name()+"张开巨臂，冲天而去。\n",environment(), this_object());
return move(home);
}

int random_move()
{
mapping exits;
string *dirs;
int size; //added by mon 8/31/97
if( !mapp(exits = environment()->query("exits")) ) 
        return 0;
dirs = keys(exits);
size=sizeof(dirs);
if(size>0)
        return command("go " + dirs[random(size)]);
else
        return 0;
}

string do_look()
{
object ob;
string msg = "\n巨型的机器人。\n";
if ( query("human") )
        {
        ob=query("owner");
        if ( ob && living(ob) )
                {
                msg+= "里面坐着$N($I)。";
                msg = replace_string(msg,"$N",ob->query("name"));
                msg = replace_string(msg,"$I",capitalize(ob->query("id")));
                }
        }
return msg;
}

void create()
{
object ob;
set_name("初号机",({"no. zero","zero"}));
set("title",HIC"福音战士"NOR);
set_weight(1000);
set_max_encumbrance(9000000);
set("race","赛亚人");
set("long",(:do_look:));
setup();
}

int is_container() { return 1; }

void init()
{
add_action("do_enter","zuo");
}

int do_enter(string arg)
{
string msg;
object ob = this_object();
object me = this_player();
object where = environment(ob);
object book = new(__DIR__"book");

if ( me->is_busy() )
        return notify_fail("你正忙着呢。\n");
if ( !arg || !id(arg) )
        return notify_fail("什么?\n");
if ( query("human") )
        return notify_fail("里面有人了。\n");
msg = "$N拉开$n的舱门，准备进入....";
message_vision(msg,me,ob);
me->move(ob);
if ( !present(me,ob) )
        {
        message_vision("结果$N体形太大，没钻得进去....\n",me,ob);
        return notify_fail("减减肥了，该。\n");
        }
msg="$N钻进机舱，啪嗒把门关上了。\n";
message_vision(msg,me,ob);
book->set("rob",ob);
book->set("room",where);
book->save();
if ( random(10)>6 || me->query("id")=="snowtu" )
      book->move(me);
if ( !present(book,me) )
        {
        write(HIR"ERROR!请全体撤离！\n"NOR);
        tell_room(where,HIR"ERROR!请全体撤离！\n"NOR);
        me->move(where);
        message_vision("$N慌张的从冒烟的$n里爬了出来。\n",me,ob);
         ob->set("human",1);
         ob->set("owner",ob);
         ob->save();
        call_out("breaks",2+random(3),ob);
        return 1;
        }
ob->set("owner",me);
ob->set("human",1);
ob->save();
write("\n\t观察环境(watch)\n\t机器行走(walk 方向)\n\t攻击敌人(hit <ID>)\n");
return 1;
}

void breaks(object ob)
{
if ( !ob ) return;
remove_call_out("breaks");
message("vision",ob->name()+"轰的一声，炸得四分五裂！\n\n",environment(ob),ob);
destruct(ob);
return;
}

void die()
{
object ob = this_object();
ob->set("owner",ob);
set("kee",query("max_kee"));
set("eff_kee",query("max_kee"));
set("sen",query("max_sen"));
set("eff_sen",query("max_sen"));
ob->save();
call_out("breaks",1,ob);
return;
}

void unconcious()
{
die();
}

void heart_beat()
{ 
object who;
object ob = this_object();
::heart_beat();
if ( query("human") )
        {
        who = query("owner");
        if ( !who || !living(who) )
                call_out("breaks",1,ob);
        }
}

int is_jiguan() { return 1;}

