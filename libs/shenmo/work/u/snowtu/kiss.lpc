inherit ITEM;

void create()
{
set_name("吻",({"wen"}));
set("unit","个");
set("value",0);
set("long","一个深情的不含任何色情成分的吻.....\n");
setup();
}

void greeting()
{
if ( !query("i") )  
     set("i",1);
write("\n\n\n"+name()+"慢慢的滋润开来.....\n\n\n");
remove_call_out("greeting");
destruct(this_object());
}

void init()
{
if ( query("i") )  return;
remove_call_out("greeting");
call_out("greeting",random(60)+5);
}
