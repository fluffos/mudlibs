// 【轩辕斧法】, xuanyuan-axe
inherit SKILL;
void takeforce();
mapping *action = ({
  ([ "action":
    "$N手中$w舞动，脚步一沉，一招「阴阳三合」，手中$w如流星般直劈$n的$l！",
    "damage": 80,
    "dodge": 30,
    "parry": 40,
    "damage_type": "割伤",
    "name": "阴阳三合",
    "parry_msg":
    "结果$n一招「神行飘缈」，挥动手中$v格开了$N的$w。\n",
    "parry_power": 40,
  ]),
  ([ "action":
    "$N一招「圜则九重」如惊鸿一撇般令$n毫无警讯，一瞬间$w已来至$n的面前！",
    "damage": 80,
    "dodge": -30,
    "parry": -30,
    "damage_type": "割伤",
    "name": "圜则九重",
    "parry_msg":
    "结果$n手中$v一分，一招「神转天盘」，斜劈$N的$w。\n",
    "parry_power": 40,
  ]),
  ([ "action":
    "$N手中$w如陀螺般旋转不停，一招「天何所沓」，直取$n的各处要害！",
    "damage": 70,
    "dodge": 20,
    "parry": 20,
    "damage_type": "割伤",
    "name": "天何所沓",
    "parry_msg":
    "结果$n手中$v抡动如飞，一招「二神垂眉」，荡开$N的$w。\n",
    "parry_power": 40,
  ]),
  ([ "action":
    "$N纵身一跃，手中$w牵动著周遭的气流，一招「日月安属」，漩涡般向$n$l劈去！",
    "damage": 60,
    "dodge": 30,
    "parry": 30,
    "damage_type": "割伤",
    "name": "日月安属",
    "parry_msg":
    "$n身形微顿，手中的$v一招［指引无生］反捣$N的必救之处。\n",
    "parry_power": 40,
  ]),
  ([ "action":
    "$N手中$w彷佛如地狱幽灵般，一招「地方九则」，突然劈至，一股寒气从$N的斧中透出！",
    "damage": 50,
    "dodge": -10,
    "parry": -20,
    "damage_type": "割伤",
    "name": "地方九则",
    "parry_msg":
    "$n手中的$v从下往上急挥，一招［法归本性］磕开了$N手中的$w\n",
    "parry_power": 40,
  ]),
  ([ "action":
    "突然间彷佛空间被掏空般，$N手中$w化作一溜烟尘，一式「雄虺九首」使$n毫无著力感！",
    "damage": 100,
    "dodge": -40,
    "parry": -40,
    "damage_type": "割伤",
    "name": "雄虺九首",
    "parry_msg":
    "结果$n手中$v飞速旋转，一招「鬼斧神工」，反扫$N的$w。\n",
    "parry_power": 40,
  ]),
});



int valid_learn(object me) {
  object ob;
  if (me->query("faith") < 1000)
    return notify_fail("你对门派的忠诚度不够，无法学轩辕斧法。\n");
  if ((int)me->query("max_force") < 3000)
    return notify_fail("你的内力不够，不能学轩辕斧法,多练些内力再来吧。\n");
  if (me->query("betray/count"))
    return notify_fail("你求学之心不专，无缘学轩辕斧法。\n");
  if (me->query("family/family_name") != "将军府")
    return notify_fail("轩辕斧法乃将军府不传之密！\n");
  if ((string)me->query_skill_mapped("force") != "lengquan-force")
    return notify_fail("轩辕斧法需配合冷泉神功才可发挥威力。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "axe")
    return notify_fail("手里没有斧头怎么能领悟师父所教的奥妙呢？\n");
  return 1;
}
int practice_skill(object me) {
  object weapon;
  if (me->query("faith") < 1000)
    return notify_fail("你对门派的忠诚度不够，无法学轩辕斧法。\n");
  if (me->query("betray/count"))
    return notify_fail("你求学之心不专，无缘学轩辕斧法。\n");
  if (me->query("family/master_id") != "lao ren")
    return notify_fail("你虽会使用轩辕斧法，却不知如何练习。\n");
  if ((string)me->query_skill_mapped("force") != "lengquan-force")
    return notify_fail("轩辕斧法需配合冷泉神功才可发挥威力。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "axe")
    return notify_fail("手中无斧，如何练习斧法？\n");

  if ((int)me->query("kee") < 50
    || (int)me->query("force") < 30)
    return notify_fail("你的体力不够练轩辕斧法，还是先休息休息吧。\n");
  me->receive_damage("kee", 50);
  me->add("force", -30);
  write("你按着所学练了一遍轩辕斧法   。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("fighter") + "/xuanyuan-axe/" + action;
}
void skill_improved(object me) {
  if ((int)me->query_skill("xuanyuan-axe", 1) % 10 == 0) {
    tell_object(me, "\n你练斧过勤，受了点内伤。");
    me->add_maximum_force(-(int)(me->query_skill("xuanyuan-axe", 1) / 10));
    me->add(str, 1);
  }
  return;
}
