#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "寝室");
  set("long", @LONG

整个小庙里，也就这里还干净一些，房顶也不漏水。庙里仅剩的几个
和尚就都挤在这里。屋里处了一张长长的竹床，和挂着的几件破僧衣
之外，什么都没有。也不知这几个和尚吃什么度日。
LONG
  );
  setup();
}

void init() {
  add_action("do_ask", "ask");
}

int err_msg(string arg) {
  write(arg);
  return 1;
}

int do_ask(string arg) {
  string id, sth, job;
  object me = this_player();
  if (!arg || sscanf(arg, "%s about %s", id, sth) != 2)
    return 0;
  if (id != "yushu" && id != "yu shu" && id != "master" && id != "shu")
    return 0;
  if (sth != "斗佛" && sth != "cancel")
    return 0;
  if (sth == "cancel") {
    write(NOR "你向玉鼠精打听有关『" HIC "cancel" NOR "』的消息。\n" NOR);
    if ((int)me->query_temp("m_mieyao")) {
      me->add("daoxing", -2000);
      me->delete_temp("m_mieyao");
      me->delete("secmieyao");
      me->delete("secmieyao/type");
      me->delete("secmieyao/location");
      me->delete("secmieyao/place");
      me->delete("secmieyao/name");
      me->delete("secmieyao/id");
      write(CYN "玉鼠精说道：没用的东西！\n" NOR);
      return 1;
    } else {
      write(CYN "玉鼠精说道：你有任务吗？！\n" NOR);
      return 1;
    }
  }
  write(NOR "你向玉鼠精打听有关『" HIC "斗佛" NOR "』的消息。\n" NOR);
  if (!me->query("family/family_name")
    || me->query("family/family_name") != "陷空山无底洞")
    return err_msg(CYN "玉鼠精说道：你不是本门中人!\n" NOR);
  write(CYN "玉鼠精轻轻地拍你的头。\n" NOR);
  write(CYN "玉鼠精说道：有志气！\n" NOR);
  job = "/d/obj/mieyao"->query_yao(me);
  write(CYN "玉鼠精说道：" + job + NOR "\n");
  return 1;
}
