**  基本的巫师编程熟悉之后再要提高已经  **
**  是很难的事了，因为再没有更高的示例  **
**  去借鉴了。所以接下来的事情就是自己  **
**  慢慢去领会各个函数的用法了。等领会  **
**  了之后相信对自身是个质的提高了。。  **
**  至少我是这么认为的，或许是错的，管  **
**  他呢。				**
**  做这个东西基本是在浪费时间，但是一  **
**  时间也难以记得那么多的函数，加上硬  **
**  盘坏了，以前的函数表遗失.....	**
**  再去下载连接已经作废，而其他版本的  **
**  函数表查找实在是不方便（主要是没有  **
**  将函数分类）			**
**  所以只好自己来一个了:不能上网，所以 **
**  没有制作*.chm的软件，还是直接做在泥 **
**  潭里了，另外将一些 Data做了备注，希 **
**  望对后来的巫师学习者有帮助		**
**  始终：我的观点是初学者还是多写的好  **
**  光看教程是难得提高和入门的。	**
**  写了这么多废话，只是觉得离告别泥潭  **
**  的日子不远了，当是为自己的一年巫师  **
**  生涯做个总结吧。                    **
**		眠兔(Snowtu)/2004/04/14 **
*****************************************/

#include <ansi.h>
inherit NPC;
#include "func_msg.h"

string ask_fun();

void create() {
  object ob;
  set_name("函数精灵", ({ "function", "jingling" }));
  set("long", "西游记--神魔传说巫师开发所用的函数(Function)精灵。遇到有不解的问题
可以向她询问 函数 方面的问题。想要查询具体的函数，可以:
	function <函数名>\n");  //描述
  set("gender", "女性");   //性别
  set("age", 10);    //年龄
  set("attitude", "peaceful");  //性格
  set("bellicosity", 10);   //杀气 
  set("combat_exp", 50000000);  //武学
  set("daoxing", 50000000);  //道行

  set("eff_gin", 1000);   //体格
  set("max_kee", 10000);   //气血最大值
  set("max_sen", 10000);   //精神最大值
  set("family", ([                         //门派
  "master_name": "眠兔",  //师傅name
  "master_id": "snowtu",  //师傅id
  "title": "玉兔",  //师门头衔
  "generation": 2,  //代
  "privs": 0,  //(?)
  "family_name": "眠兔门",  //师门name
  ]));
  set("food", 400);   //食物
  set("water", 400);   //饮水
  set("max_force", 2500);   //最大内力
  set("maximum_force", 2500);  //最大内力(隐藏)
  set("force_factor", 400);  //加力值
  set("max_mana", 2500);   //最大法力
  set("mana_factor", 400);   //法力加力值
  set("maximum_mana", 2500);  //最大法力(隐藏)
  set("limbs", ({    //部件 :)
  "第一部分", "第二部分", "第三部分",
    "第四部分", "第五部分", "第六部分",
  }));
  set("nickname", HIG "玉桂树下捣药杵" NOR);  //nick
  set("potential", 1);   //潜能
  set("race", "人类");   //种类

  set("int", 40);    //悟性
  set("kar", 40);    //福缘
  set("per", 40);    //容貌
  set("spi", 40);    //灵性
  set("str", 40);    //臂力
  set("con", 30);    //根骨
  set("cor", 30);    //胆识
  set("cps", 30);    //(?)
  set("dex", 30);    //(?)

  set_temp("apply", ([
    "armor": 400,   //防御(score)
    "damage": 100,   //伤害(score)
  ]));

  set("inquiry", ([   //ask about XXX
  "函数": (: ask_fun :),
    "function": (: ask_fun :),
  ]));
  setup();
  ob = new("/d/city/npc/obj/armor");
  ob->set_name("兔女郎衣", ({ "tu yi" }));
  ob->move(this_object());
  ob->wear();
}

string ask_fun() {
  int k;
  string msg, *types;
  object me = this_player();
  if (!wizardp(me))
    return "你不是巫师，恕难相告。";

  msg = "已经整理的了函数类型有以下部分：\n";
  types = keys(func_type);
  k = sizeof(types);
  while (k--)
    //	msg += types[k]+" : "+func_type[types[k]]+"\n\t";	
    msg += sprintf(
      "%4s" NOR HIR "%-8s" NOR CYN " : 关于" NOR HIY " %-4s " NOR CYN "操作的函数\n",
      "",
      types[k],
      func_type[types[k]]
    );
  msg += "你想查找关于哪个操作类型的函数？请选择：\n";
  msg += "   find <类型名称>  \n";
  msg += "例如 ： find obj ";
  return msg;
}


int do_choose(string arg) {
  int i;
  string msg, type, str = "", *fun, *types;
  object me = this_player(), ob = this_object();
  if (!wizardp(me))
    return 0;
  if (!stringp(type = func_type[arg]))
    return notify_fail("没有这种类型。\n");

  fun = keys(funcs);
  msg = HIY "━━━━━━━━━━━━━━━━━━━━━━━━━\n\n" NOR;
  msg += sprintf(WHT "%-20s( 共 %d 个 )\n" NOR, "现在已知的函数有：", sizeof(fun));
  //msg+= HIY"─────────────────────────\n"NOR;	
  msg += sprintf("%-8s %-6s%2s%-10s%4s\n\n" NOR, "其中操作对象为", HIR + type + "型" NOR, "", "的函数有：", "");
  for (i = 0; i < sizeof(fun); i++) {
    if ((funcs[fun[i]])["type"] != arg)
      continue;
    msg += "\t" + WHT + fun[i] + NOR "\n";
  }
  //	msg+= HIY"\n─────────────────────────\n"NOR;			
  msg += HIY "\n━━━━━━━━━━━━━━━━━━━━━━━━━\n\n" NOR;
  msg += HIG "你可以通过 function <函数名> 来查询具体的函数用法。\n" NOR;
  write(msg);
  return 1;
}

void init() {
  add_action("do_check", "function");
  add_action("do_choose", "find");
}

int do_check(string arg) {
  string gram, type, use, name, *fun, msg;
  mapping func;
  object me = this_player(), ob = this_object();
  if (!wizardp(me))
    return 0;
  if (!arg)
    return notify_fail("命令格式： function <函数名> \n");
  if (!mapp(funcs[arg]))
    return notify_fail("错误：未知的函数。具体请询问我关于 函数 的问题。\n");
  func = funcs[arg];
  name = func["name"];
  gram = func["gram"];
  use = func["use"];
  type = func["type"];

  msg = HIC "━━━━━━━━━━━━━━━━━━━━━━━━━━━\n" NOR;
  msg += sprintf("%10s：%4s%-20s%s\n", HIG "查询函数" NOR, "", HIY + arg + NOR, "");
  msg += HIC "───────────────────────────\n" NOR;
  msg += sprintf("%10s：%4s%-20s%s\n", HIG "函数名称" NOR, "", WHT + name + NOR, "");
  msg += HIC "───────────────────────────\n" NOR;
  msg += sprintf("%10s：%4s%-20s%s\n", HIG "函数语法" NOR, "", WHT + gram + NOR, "");
  msg += HIC "───────────────────────────\n" NOR;
  msg += sprintf("%10s：%4s%-20s%s\n", HIG "函数用法" NOR, "", WHT + use + NOR, "");
  msg += HIC "───────────────────────────\n" NOR;
  msg += sprintf("%10s：%4s%-20s%s\n", HIG "函数类型" NOR, "", HIY + type + NOR, "");
  msg += HIC "━━━━━━━━━━━━━━━━━━━━━━━━━━━\n" NOR;

  write(CLR);
  write(msg);
  return 1;
}
