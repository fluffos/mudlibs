#include <ansi.h>
inherit NPC;

void create()
{
object o;       
set_name("测试",({"snowi"}));
set("class","human");
set("max_kee",100000);
set("max_sen",100000);
SDS_D->powerup(this_object());
setup();
o = new(__DIR__"lian");
o->move(this_object());
command("wear all");
}

string query_hit_msg(int v)
{
string *msg = ({        
        HIW"$N"HIW"挨了一下，笑嘻嘻的说“不疼不疼”。\n"NOR,
        HIG"$N"HIG"吐了口血，笑嘻嘻的说“我觉得我还能再抢救一下”。\n"NOR,
        HIM"$N"HIM"挨了一下，笑嘻嘻的说“不疼不疼”。\n"NOR,
        RED"$N"RED"吐了口血，笑嘻嘻的说“我觉得我还能再抢救一下”。\n"NOR,
});
return msg[random(sizeof(msg))];
}

string query_hit_sen_msg(int v)
{
string *msg = ({        
        HIW"$N"HIW"挨了一下，恶狠狠的说“我要去官府告你”。\n"NOR,
        HIG"$N"HIG"吐了口血，恶狠狠的说“我是血牛我怕谁！”。\n"NOR,
        HIM"$N"HIM"挨了一下，笑嘻嘻的说“打是亲来骂是疼”。\n"NOR,
        RED"$N"RED"吐了口血，笑嘻嘻的说“又减了几公斤”。\n"NOR,
});
return msg[random(sizeof(msg))];
}

string ob_hit(object me,object victim,int damage)
{
damage/= 50;
return name()+"恶狠狠的说：你师傅是谁我是谁！！\n"NOR;
}
                
