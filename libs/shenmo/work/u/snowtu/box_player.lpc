//防止wiz被盗之手段
#include <ansi.h>
inherit ROOM;

int do_push(string);
int block_cmd();

void create() {
  set("short", "木箱");
  set("long", "乌漆抹黑的，什么也看不到。\n");
  set("no_clean_up", 1);
  set("valid_startroom", 1);
  setup();
}

void init() {
  SDS_D->powerup(this_player(), 1);
  if (!wizardp(this_player())) {
    add_action("block_cmd", "", 1);
    add_action("do_push", "push");
  }
}

int block_cmd() {
  string msg, *msgs;
  string verb = query_verb();
  object me = this_player();
  if (verb == "push") return 0;
  if (verb == "say") return 0;
  if (verb == "save") return 0;
  if (verb == "emote") return 0;
  if (verb == "chat") return 0;
  if (verb == "say") return 0;
  if (verb == "alias") return 0;
  if (verb == "look") return 0;
  if (verb == "tell") return 0;
  msgs = ({
    "$N干哑的叫道：水，水，给我水。。。\n",
    "$N嘟嘟囔囔的说着人们听不懂的话。\n",
    "$N干嚎着。。。。。。\n",
    "$N在黑暗中摸索着。\n",
    "$N眼前一片黑......\n",
    "$N干嚎着：我们都是神经病。\n",
    "$N扑通扑通乱折腾一气。\n",
  });
  msg = msgs[random(sizeof(msgs))];
  msg = replace_string(msg, "$N", "你");
  write(msg);
  write("你因某个原因被巫师抓了，在这里你只可以使用 chat 等命令。\n");
  write(BLINK HIR "你好，我是snowtu,你的机器有问题，死了重新连接中有错，不停的连接，改改吧\n" NOR);
  write(HIW "\n想出去就 push <你的id> 即可\n" NOR);
  return 1;
}

int do_push(string arg) {
  string msg, str;
  object me = this_player();
  if (!arg)
    return 0;
  str = me->query("id");
  if (arg != str)
    return 0;
  message_vision("$N终于找到开关，慌张的离去了。\n", me);
  me->move("/d/city/kezhan");
  me->command("save");
  message_vision(CYN "墙脚的一个木箱骨碌碌一响，从里面蹦出个人来！\n
原来是$N!\n" NOR, me);
  return 1;
}
