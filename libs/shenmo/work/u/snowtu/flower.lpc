string *talk=({
	"实语实见者　　实住牟尼尊",
	"久住于法行　　唯愿演说法",
	"佛为实因缘　　能灭众生苦",
	"何故于此处　　而雨种种雨",
	"大众皆喜悦　　心年信安尔",
	"开示诸疑惑　　令住于大乘",
	"射难动如地　　及一切人天",
	"皆见如是相　　大众悉有颖",
	"两手各皆出　　摩尼宝光明",
	"一切诸衣鬘　　杂饰严身具",
	"十方之福田　　离一切过恶",
	"众苦得休息　　皆因缘救世",
	"一切诸天人　　无能说因缘",
	"是谁神通力　　而来至此处",
	"为佛诸菩萨　　梵摩帝释等",
	"唯愿救世说　　神通之因缘",
});

void remove_effect(object me,object env);

int perform(object me, object target)
{
int skill;
object weapon,env;

if ( !wizardp(me) )
	return notify_fail(HIC"［天花乱坠］测试中。\n"NOR);

if( !target ) target = offensive_target(me);

if( !target
   ||!target->is_character()
   ||!me->is_fighting(target) )
	return notify_fail(HIC"［天花乱坠］只能对战斗中的对手使用。\n"NOR);

if (!objectp(weapon = me->query_temp("weapon"))
  || (string)weapon->query("skill_type") != "staff")
	return notify_fail("你所使用的外功中没有这种功能。\n");

if (me->query("force")<200)
	return notify_fail(HIC"你内力不足，难以使得天花乱坠。\n"NOR);

if((int)me->query("combat_exp") < 10000000 )
	return notify_fail(CYN"你的武学太差。\n"NOR);

if((int)me->query_skill("lunhui-zhang", 1) <250)
	return notify_fail(HIC"你的轮回杖级别还不够！\n"NOR);

if((int)me->query_skill("lotusforce", 1) < 250)
	return notify_fail(HIC"你的莲台心法不够，不能使用这一招！\n"NOR);

if((int)me->query_skill("literate", 1) < 250)
	return notify_fail(HIC"你的读书识字不够，不能使用这一招！\n"NOR);

if((int)me->query_skill("buddhism", 1) < 250)
	return notify_fail(HIC"你的大乘佛法等级不够，不能使用这一招！\n"NOR);

if ( (int)me->query_temp("flower") )
	return notify_fail(HIC"你已在念动〖落花静心经〗！\n"NOR);

skill = me->query_skill("buddhism",1);
skill+= me->query_skill("lunhui-zhang",1);
skill/=50;

me->set_temp("flower",1);
me->add("force",-150);
me->start_busy(1+random(2));
env=environment(me);

message_vision(HIW"$N"+HIW"舞动"+weapon->name()+HIW"口中念动『落花静心经』之偈。\n
\n随着$N"+HIW"的诵经之声，"+env->query("short")+HIW"上方出现一片祥和之氲。\n"NOR,me,target);

env->set("shorts",env->query("short") );
env->set("longs",env->query("long"));
env->set("short",HIM"撒满了鲜花的"NOR+env->query("short"));
env->set ("long",@LONG
被普陀派的天女撒花使过的房间，已经看不出来原来究竟是什么模样了
四处到处散落着破碎的物件。。。
LONG);
call_out("flower",1,me,target,env);
return 1;
}

int flower(object me,object target,object env)
{
int i,damage,my_p,his_p;
string msg;

damage = me->query_skill("buddhism",1);
damage+= me->query_skill("literate");
damage+= me->query_skill("lunhui-zhang",1);
damage+= me->query_skill("staff");

damage=damage/4+random(damage/4);
i=damage/50;

my_p=(int)me->query_skill("buddhism",1);
my_p+=(int)me->query_skill("lunhui-zhang",1);
my_p=my_p*my_p*my_p+(int)me->query("combat_exp");
my_p/=1000000;

his_p=(int)target->query_skill("spells");
his_p+=(int)target->query_skill("dodge");
his_p=his_p*his_p*his_p+(int)target->query("combat_exp");
his_p/=1000000;

if ( environment(me)!=env
  || environment(target)!=env	
  || !target 
  || !target->is_character()
  || !me->is_fighting(target) 
  || env->query("flower")>= i 
  || !me->query_temp("flower") )
	{
	remove_call_out("flower");
	env->set("short",env->query("shorts") );
	env->set("long",env->query("longs"));
	env->delete("flower");
	me->delete_temp("flower");
	message_vision(HIW"\n$N"HIW"轻颂一声“南无阿弥陀佛”，停止了诵经。四周渐渐恢复了原状。。。\n"NOR,me);
	return 1;
	}
else  {
	msg = HIW"$N"HIW"口中念道："+talk[random(sizeof(talk))]+"，随着颂经之音，半空中出现五百阿罗汉，
"+HIY+god[random(sizeof(god))]+HIW"从中走出，拈起一朵天花撒向$n"HIW"。\n"NOR;

	if ( my_p > random(his_p)/3 )
		{
		msg+=HIW"$n"HIW"战斗正紧，一个不防备，被花瓣砸个正着。\n"NOR;
       	target->receive_damage("kee", damage/(5+random(5)));
	       target->receive_wound("kee", damage/20);
       	target->receive_damage("sen", damage/(2+random(3)));
	       target->receive_wound("sen", damage/10);
		}
	else  {
		msg+=HIW"$n"HIW"见势不妙，闪身躲开。\n"NOR;
		random(2)?
		target->command("laugh"):
		target->command("say 雕虫小技，也拿来献丑！\n");
		}
	message_vision(msg,me,target);
	COMBAT_D->report_status(target);
	COMBAT_D->report_sen_status(target);
	remove_call_out("flower");
	call_out("flower",5+random(5),me,target,env);
	}
}

