// skirt.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
        set_name("军大衣",({ "cloth" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "一条军大衣，十分暖和，油光锃亮，已经看不清原来的颜色了。\n");
		set("unit", "条");
		set("material", "cloth");
                set("armor_prop/armor",500);
                set("armor_prop/personality",1);
	}
	setup();
}

