inherit NPC;
#include <ansi.h>

string check_me();

void create()
{
set_name("金猴",({"gold monk","monk"}));
set("title","新春使者");
set("gender", "男性");
set("long","一个金光闪闪，神气活现的猢狲。\n");
set("age", 20);
set("inquiry",([
	"gift" : (: check_me :),
]));
setup();
}

string check_me()
{
int i;
object *who,gift,env;
env = environment(this_object());
who = all_inventory(env);

if ( random(20)==1 )
	tell_room(env,"\n\n四下里喜气洋洋。\n\n");

for ( i=0;i<sizeof(who);i++ )
	{
	if ( !interactive(who[i]) )
		continue;
	if ( !living(who[i]) )
		continue;
	if ( who[i]->query("礼物/2004春节2") )
		continue;
	who[i]->delete_temp("春节");
	gift = new(__DIR__"gift");
	gift->set("owner",who[i]);
	gift->save();
	gift->move(who[i]);
	if ( present(gift,who[i]) )
		{
		tell_object(who[i],"漫天礼花声中，你得到了"+gift->name()+"。\n");
		who[i]->add("春节礼物2/num",1);
		if ( who[i]->query("春节礼物2/num")>=5 )
			who[i]->set("礼物/2004春节2",1);
		}
	who[i]->save();
	}
return BLINK HIR"\t\t\t春\t节\t快\t乐。\n"NOR;
}
