//春节礼物
//gold==400*5;
//wx = 2w*5
//dx = 2w*5
//pot = 1w*5

#include <ansi.h>
inherit ITEM;

void create()
{
set_name(HIG"吉祥果"NOR,({"guo"}));
set_weight(5000);
if( clonep() )
        set_default_object(__FILE__);
else    {
        set("unit", "颗");
        set("long", HIR"一颗鲜嫩欲滴的吉祥果，在吃之前可以对之许愿(wish)。\n"NOR);
	 set("no_get",1);
	 set("no_give",1);
	 set("no_drop",1);
        }
setup();
}

int init()
{
add_action("do_wish", "wish");
add_action("do_eat", "eat");
}

int select_user(object a, string subip)
{
if(strsrch(query_ip_number(a),subip) == -1) return 0;
else return 1;
}

int do_wish(string arg) 
{
int i,flag = 0;
string subip;
object *ob_list;
object ob = this_object();
object me = environment(ob);

if ( me!=query("owner") && !wizardp(me) )
	return notify_fail("这个不是你的！！\n");

if ( !arg || ( arg!="gold" && arg!="wx" && arg!="dx" && arg!="pot" ) )
	return notify_fail("具体格式:\n\n
\twish <类型>\n类型有 gold/wx/dx/pot\n");

if ( query("wish") )
	return notify_fail("已经许过了。\n");

if ( arg=="gold" )
	{
	subip=query_ip_number(me);
	ob_list = filter_array(users(),"select_user",this_object(),subip);
	for(i=0;i<sizeof(ob_list);i++)
		{
		if ( ob_list[i]==me )
			continue;
		flag++;
		}
	if ( flag>0 )
		return notify_fail("对不起，你这个IP有两位以上的玩家，所以还是要其他的吧。\n");
	}

message_vision("$N对着$n虔诚的喃喃自语。\n",me,ob);
ob->set("wish",1);
ob->set("gift",arg);
ob->save();
me->start_busy(1+random(2));
tell_object(me,"好了，许完愿了，可以吃了....\n");
return 1;
}

int do_eat(string arg)
{
object obj;
string gift;
object ob = this_object();
object me = environment(ob);

if ( !query("wish") ) 
	return notify_fail("先许个愿吧(wish)。\n");

if ( me!=query("owner") && !wizardp(me) )
	return notify_fail("这个不是你的！！\n");

message_vision("$N将$n拿在手中，狠狠的咬了下去。\n",me,ob);

gift = query("gift");
switch(gift)
	{
	case "gold" : 
		obj = new("/obj/money/gold");
		obj->set_amount(400);
		obj->move(me);
		if ( !present(obj,me) )
			return notify_fail("你身上东西太多了吧。\n");
		tell_object(me,"好了，记得存起来哦。\n");
		break;
	case "wx" :
		me->add("combat_exp",20000);
		tell_object(me,"好了，春节快乐。\n");
		break;
	case "dx" :
		me->add("daoxing",20000);
		tell_object(me,"好了，春节快乐。\n");
		break;
	case "pot" :
		me->add("potential",10000);
		tell_object(me,"好了，春节快乐。\n");
		break;
	}
me->save();
message_vision("$N打了个饱嗝，满意的擦擦嘴。\n",me);
destruct(ob);
return 1;
}