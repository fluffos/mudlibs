inherit NPC;
#include <ansi.h>

void create()
{
set_name("方新侠",({"bao an","guard"}));
set("title","门卫");
set("gender", "男性");
set("long","一个裹着军大衣的门卫，虽然流着鼻水，但是在寒风中依然精神抖擞。\n");
set("age", 20);
setup();
carry_object(__DIR__"cloth")->wear();
}

void init()
{
string str;
object me = this_player();
add_action("do_yaoqing","qing");
if ( me->query_temp("春节/门卫") )
        return;
if ( me->query("gender")=="女性" )
        str = "小姐";
else    str = "先生";
message_vision("$N擦擦鼻水，凑了过来，对$n一笑，这位"+str+"好，想进去吗？\n
先在现场邀请一位异性做你的舞伴吧。( qing <id> )\n",this_object(),me);
me->set_temp("春节/门卫",1);
me->save();
return;
}

int do_yaoqing(string arg) 
{
string gender,ip;
object who,me;
me = this_player();
if ( !me->query_temp("春节/门卫") )
        return 1;

if ( !arg )
        return notify_fail("你要邀请哪位？\n");
who = present(arg,environment());
if ( !who || !interactive(who) || !living(who) )
        return notify_fail("你必须从这里邀请一位玩家。\n");

ip=query_ip_number(me);

if ( me->query_temp("春节/邀请") ) 
        {
        who = me->query_temp("春节/伴侣");
        if ( !who )
                {
                me->delete_temp("春节");
                return notify_fail("你的伴侣溜了，你重新找一位吧。\n");
                }
        tell_object(who,name()+"在你耳边悄悄说："+me->query("name")+"想甩了你重新找一个，
幸好偶发现的及时，已经深刻教育了他了。\n");
        return notify_fail("你不是已经邀请了"+who->name()+"吗？\n");
        }
/*
if ( query("usr/"+ip) )
	{
	say(name()+"摇摇头，说道：为了打击冒牌，抵制大米，上头规定：一个IP只能
申请一次。\n");
	return 1;
	}
*/
if ( query_ip_number(me)==query_ip_number(who) )
	{
	say(name()+"摇摇头，说道：为了打击冒牌，抵制大米，上头规定：一个IP只能
申请一次。\n");
	return 1;
	}

gender = me->query("gender");

message_vision("$N低头想了想，最后含情脉脉的对着"+who->name()+"说道：我....\n",me,this_object());
if ( who->query("gender")==gender )
        {
        message_vision(who->name()+"黑着个脸道：我可不是同性恋。\n",me);
        return notify_fail("... ... ... ...\n");
        }
if ( who->query_temp("春节/邀请") ) 
        {
        message_vision(who->name()+"红着个脸道：可惜你晚了一步....\n");
        return notify_fail("重找一个吧。\n");
        }
message_vision(who->name()+"低头想了想，$n大叫：这么冷，各位快点，就这么定了！\n",me,this_object());
message_vision(who->name()+"与$N结成一对舞伴。\n",me,this_object());
me->set_temp("春节/邀请",1);
me->set_temp("春节/伴侣",who);
who->set_temp("春节/邀请",1);
who->set_temp("春节/伴侣",me);
me->save();
who->save();
set("usr/"+ip,1);
this_object()->save();
me->start_busy(3);
who->start_busy(3);
call_out("enter_room",1+random(2),me,who,environment());
return 1;
}

void enter_room(object me,object who,object env)
{
if ( !me || !who || env->query("short")!="礼堂大门" )
	return;
message("vision","一群人呼拥而上，围起了"+me->name()+"就进入了礼堂大厅。\n",env,me);
message("vision","一群人呼拥而上，围起了"+who->name()+"就进入了礼堂大厅。\n",env,who);
tell_object(me,"一群人呼拥而上，围起了你，就进入了礼堂大厅。\n");
tell_object(who,"一群人呼拥而上，围起了你，就进入了礼堂大厅。\n");
if ( present(me,env) )
	me->move(__DIR__"spring-room");
if ( present(who,env) )
	who->move(__DIR__"spring-room");
message("vision","礼乐声中，"+me->query("name")+"与"+who->query("name")+"进入了礼堂。\n",environment(me),this_object());
return;
}
