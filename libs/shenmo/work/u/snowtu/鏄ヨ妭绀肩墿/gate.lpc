#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "礼堂大门");
  set("long", @LONG

这里是春节礼堂大门。里面灯火通明，人声嘈杂，煞是热闹。

LONG);

  set("exits", ([
    "out": "/d/city/kezhan",
    "enter": __DIR__ "spring-room",
  ]));
  set("objects", ([
    __DIR__ "guard": 1,
  ]));
  set("no_magic", 1);
  set("no_fight", 1);
  set("hs_world", 1);
  set("no_clear_up", 1);
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "enter") {
    if (!me->query_temp("春节/邀请"))
      return notify_fail("你还是邀请一位异性一起进入为好。\n");
  }
  return ::valid_leave(me, dir);
}
