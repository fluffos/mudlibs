#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "礼堂");
  set("long", @LONG

这里是春节礼堂，灯火通明，人声嘈杂，煞是热闹。礼堂中间树立着一根
巨大的柱子(zhu)

LONG);

  set("exits", ([
    "out": __DIR__ "gate",
  ]));
  set("item_desc", ([
    "zhu": HIR + @LONG

		春	节	快	乐！

	在此呼唤(calls)神猴(monk)吧。

LONG + NOR,
  ]));
  set("no_magic", 1);
  set("no_fight", 1);
  set("hs_world", 1);
  set("num", 0);
  set("no_clear_up", 1);
  setup();
  remove_call_out("check");
  call_out("check", 1, this_object());
}

void init() {
  add_action("do_calls", "calls");
}

int do_calls(string arg) {
  int num;
  object monk;
  object me = this_player();

  if (!arg || arg != "monk")
    return 1;

  if (!interactive(me))
    return 1;

  if (me->query_temp("monk_called"))
    return notify_fail("你已经呼唤了，还是靠其他人吧。\n");

  message_vision(HIY "$N" HIY "手捻一拄长香，对天一拜：恭迎神猴降临。\n" NOR, me);
  me->set_temp("monk_called", 1);
  this_object()->add("num", 1);
  this_object()->save();
  num = this_object()->query("num");
  message_vision(HIY "房间中立刻金光闪闪，隐约有" + chinese_number(num) + "道金光闪过。\n" NOR, me);
  if (num >= 10 && !present("god monk", this_object())) {
    this_object()->set("num", 0);
    this_object()->save();
    monk = new(__DIR__ "monk");
    monk->move(this_object());
    message("channel:rumor", HIY "\n\n一道金光自天上落下。\n\n" NOR, users());
    tell_room(this_object(), HIY "\n金光散去，现出一只神气十足的金猴。\n" NOR);
  }
  return 1;
}
