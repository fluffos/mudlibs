#include <ansi.h>
inherit NPC;

string ask_fun();

void create() {
  object ob;
  set_name("函数精灵", ({ "function", "jingling" }));
  set("long", "西游记--神魔传说巫师开发所用的函数(Function)精灵。遇到有不解的问题
可以向她询问 函数 方面的问题。想要查询具体的函数，可以:
	function <函数名>\n");  //描述
  set("gender", "女性");   //性别
  set("age", 10);    //年龄
  set("attitude", "peaceful");  //性格
  set("bellicosity", 10);   //杀气 
  set("combat_exp", 50000000);  //武学
  set("daoxing", 50000000);  //道行

  set("eff_gin", 1000);   //体格
  set("max_kee", 10000);   //气血最大值
  set("max_sen", 10000);   //精神最大值
  set("family", ([                         //门派
  "master_name": "眠兔",  //师傅name
  "master_id": "snowtu",  //师傅id
  "title": "玉兔",  //师门头衔
  "generation": 2,  //代
  "privs": 0,  //(?)
  "family_name": "眠兔门",  //师门name
  ]));
  set("food", 400);   //食物
  set("water", 400);   //饮水
  set("max_force", 2500);   //最大内力
  set("maximum_force", 2500);  //最大内力(隐藏)
  set("force_factor", 400);  //加力值
  set("max_mana", 2500);   //最大法力
  set("mana_factor", 400);   //法力加力值
  set("maximum_mana", 2500);  //最大法力(隐藏)
  set("limbs", ({    //部件 :)
  "第一部分", "第二部分", "第三部分",
    "第四部分", "第五部分", "第六部分",
  }));
  set("nickname", HIG "玉桂树下捣药杵" NOR);  //nick
  set("potential", 1);   //潜能
  set("race", "人类");   //种类

  set("int", 40);    //悟性
  set("kar", 40);    //福缘
  set("per", 40);    //容貌
  set("spi", 40);    //灵性
  set("str", 40);    //臂力
  set("con", 30);    //根骨
  set("cor", 30);    //胆识
  set("cps", 30);    //(?)
  set("dex", 30);    //(?)

  set_temp("apply", ([
    "armor": 400,   //防御(score)
    "damage": 100,   //伤害(score)
  ]));
  set("inquiry", ([   //ask about XXX
  "函数": (: ask_fun :),
    "function": (: ask_fun :),
  ]));
  setup();
  ob = new("/d/city/npc/obj/armor");
  ob->set_name("兔女郎衣", ({ "tu yi" }));
  ob->move(this_object());
  ob->wear();
}

void start_check() {
  int i;
  string gram, name, use, type, str, dir, *file;

  dir = "/u/snowtu/functions/";
  file = get_dir(dir);

  if (sizeof(file) <= 0)
    return;

  i = sizeof(file);
  for (i = 0; i < sizeof(file); i++) {
    str = file[i];
    name = read_file("/u/snowtu/functions/" + str, 1);
    gram = read_file("/u/snowtu/functions/" + str, 2);
    use = read_file("/u/snowtu/functions/" + str, 3);
    type = read_file("/u/snowtu/functions/" + str, 4);
    add("function", ([
      name: ([
        "name": name,
        "gram": gram,
        "use": use,
        "type": type,
      ])
    ]));
  }
  return;
}

string ask_fun() {
  start_check();
  return "ok";
}
