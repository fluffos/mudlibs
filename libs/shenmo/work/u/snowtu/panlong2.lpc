#include <ansi.h>
inherit "/u/snowtu/perform.lpc";

void create(object me,object target)
{
set("name","盘龙八式");
set("target",1);
set("type","kee");
set("need_force",800);
set("force",200);
set("family","方寸山三星洞");
set("class","xian");
set("belong","qianjun-bang");
set("betray_lvl",350);
set("limit_skill",([
        "qianjun-bang" : 200,
]));
set("double_hit",([
        "num"           :       8,
        "temp"          :       "QJB_perform",  
        "temp_num"      :       ({ 2,1,5,7,3,6,4,2,}),
        "me_del_env"    :       1,
        "t_del_env"     :       1,      
]));
set("busy_self",2+random(3));

}

void hit_msg(object me,object target)
{
if ( me && target )
        message_vision(HIC"\n$N运足精神，身形一转使出灵台绝学"HIW"「盘龙八式」"NOR+HIC"霹雳间连续向$n攻出了八招！\n"NOR,me,target);
}

