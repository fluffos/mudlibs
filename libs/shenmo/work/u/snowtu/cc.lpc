inherit NPC;

void create() {
  set_name("酒神", ({ "jiu shen" }));
  setup();
}

void init() {
  add_action("do_check", "jiu");
}

int do_check() {
  object me = this_player();
  int num = me->query_condition("drunk");

  message_vision("$N对$n道：醉酒度：" + num + "。\n", this_object(), me);
  return 1;
}
