inherit ITEM;

void create() {
  set_name("新人礼物", ({ "li wu" }));
  set_weight(100);
  set("unit", "个");
  setup();
}

void init() {
  object me = this_player();
  if (environment() == me) {
    object gold = new("/obj/money/gold");
    gold->set_amount(100 + random(300));
    gold->move(me);
    write("\n你得到了补偿！\n");
  }
  destruct(this_object());
}
