varargs string mix_arg(string msg_one, string msg_two, int wi) {
  string msg, t1, t2;
  string *field_one, *field_two;
  int max_line, i;

  if (msg_one == "")
    return msg_two;
  else field_one = explode(msg_one, "\n");
  if (msg_two == "")
    return msg_one;
  else field_two = explode(msg_two, "\n");
  max_line = (sizeof(field_one) > sizeof(field_two)) ? sizeof(field_one) : sizeof(field_two);
  msg = "";
  for (i = 0; i < max_line; i++) {
    if (i < sizeof(field_one))
      msg += field_one[i];
    if (i < sizeof(field_two)) {
      if (wi > 0 && i >= sizeof(field_one))
        msg += repeat_string(" ", wi);
      else if (wi > 0 && (wi - strlen(COLOR_D->clean_color(field_one[i]))) > 0)
        msg += repeat_string(" ", (wi - strlen(COLOR_D->clean_color(field_one[i]))));
      msg += field_two[i];
    }
    msg += "\n";
  }
  return msg;
}

string tu_number(int v) {
  if (v > 9 || v < 1)
    return 0;
  switch (v) {
    case 1: return one;
    case 2: return two;
    case 3: return three;
    case 4: return four;
    case 5: return five;
    case 6: return six;
    case 7: return seven;
    case 8: return eight;
    case 9: return nine;
  }
}

int init_quest(object who) {
  int x, y, z;
  string msg, type, str1, str2, str3, color;
  if (!who || !living(who))
    return 0;
  who->delete_temp("YZ_quest");
  if (time() < who->query("mark/last_Qest") + 60) {
    tell_object(who, HIR "你刚刚回答错误了。\n" NOR);
    return 0;
  }
  switch (random(3)) {
    case 0: type = "+"; x = 1 + random(9); y = 1 + random(9); break;
    default: type = "x"; x = 1 + random(9); y = 1 + random(9); break;
  }
  switch (type) {
    case "+": str2 = jia; z = x + y; break;
    default: str2 = chen; z = x * y; break;
  }
  str1 = tu_number(x);
  str3 = tu_number(y);

  color = ({ RED, GRN, HIG, YEL, HIY, BLU, HIB, MAG, HIM, CYN, HIC, WHT, HIW, })[random(13)];

  str2 = mix_arg(str1, str2, 25);
  str3 = mix_arg(str2, str3, 50);

  str3 = replace_string(str3, "@", REV + color + " " NOR);

  who->set_temp("YZ_quest/answer", z);
  who->set_temp("YZ_quest/msg", str3);
  return 1;
}
