dbase (["long":"这是一个供人留言记事的留言板。","name":"迎客厅留言板","no_get":1,"notes":({(["title":"to yunyi","msg":"看你整天要求这么多牢骚这么大我想我满足不了你的要求所以建议你既然这样就别在这里玩了免得气到自己什么时候头脑清醒了不想指挥WIZ了再来POST给我帮你开IP","author":"吴宗宪(Tom)","sx":"◆","ip":"tom.tsrj.station","time":1122805014,]),(["msg":"帮我开IP吧，我不会再要求什么了可以吗？","title":"我以后再也不提要求了","author":"空云(Yunyi)","sx":"◆","ip":"yunyi.tsrj.station","time":1122869622,]),}),"capacity":100,"id":"board","board_id":"guestroom_b",])
