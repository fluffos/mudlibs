#/obj/mailbox.c
dbase (["name":"谁与争疯的信箱","no_insert":1,"no_give":1,"id":"mailbox","no_drop":1,"owner_id":"madman","long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","unit":"个",])
mails ({(["from":"郑寡妇(zheng guafu)","status":"O","to":"madman","title":"郑寡妇：帐目结算","time":1125802721,"text":"你的店主(郑寡妇)任期结束，结余零文钱已存入你的户头。其中盈利零文钱，剩余预付金零文钱。",]),(["from":"郑寡妇(zheng guafu)","status":"O","to":"madman","title":"郑寡妇：帐目结算","time":1125946840,"text":"你的店主(郑寡妇)任期结束，结余六十九两黄金已存入你的户头。其中盈利六十九两黄金，剩余预付金零文钱。",]),})
