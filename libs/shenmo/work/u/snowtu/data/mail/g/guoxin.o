#/obj/mailbox.c
dbase (["unit":"个","long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","no_drop":1,"name":"混沌天鹏的信箱","no_insert":1,"id":"mailbox","owner_id":"guoxin","no_give":1,])
mails ({(["to":"guoxin","title":"店主：帐目结算","time":1085185278,"text":"你的店主(店主)任期结束，结余三十五两银子已存入你的户头。其中盈利三十五两银子，剩余预付金零文钱。","from":"店主(dian zhu)","status":"O",]),})
