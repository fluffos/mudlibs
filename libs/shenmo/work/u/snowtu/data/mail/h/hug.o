#/obj/mailbox.c
dbase (["no_drop":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","owner_id":"hug","id":"mailbox","name":"梦想的信箱","no_give":1,"no_insert":1,"unit":"个",])
mails ({(["to":"hug","from":"可爱多(kad)","time":1061905182,"text":"这两天我上这里都没见到你，可能大家上线时间不同吧。今天上线我无意识地按了下skills，发现各级skills都有60级，是不是拜过师后就有的？我想有空时在这里挂机器人练ID，你有一系列的机器人吗？下次遇到你，你发给我行吗？先谢了！","status":"O","title":"无题",]),(["to":"hug","from":"可爱多(kad)","time":1061905895,"text":"还有事想问下你,这里练功和4.5的是不是有很大区别?你有空回封mail给我,好长时间没玩过这个了,有些忘了.","status":"O","title":"无题",]),})
