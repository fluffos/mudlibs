dbase (["no_drop":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","no_give":1,"unit":"个","id":"mailbox","name":"臭小猪的信箱","owner_id":"fhq","no_insert":1,])
mails ({(["title":"i love you","from":"臭小猪(fhq)","status":"O","time":1073652578,"to":"snowtu","text":"我觉得很抱歉，尤其是当tom说你离开是因为我我觉得真的很难受！我玩了mud2年了，从我学校的军网，到cd，再到hsl，最后到这里，从我以来的piao帮我，到遇到你和yuanyuan还有woody等人，都很好，我觉得大家都很热爱这个站我也是绝对的投入这个站，也尽了自己的全力帮助新手希望能够从中对你的工作有些支持，我想我刚刚说话可能无意中伤害了你，但相信我是无心的，我只是性子比较急不管你做怎样的决定，我都支持你，也相信你这样一个热心和充满热情的人到那里都会有自己的一片天空，朋友，祝你未来顺利开心快乐到永远！我愿用这个站做我的mud生涯的结束！最后再一次谢谢你",]),})
