#/obj/mailbox.c
dbase (["id":"mailbox","no_drop":1,"no_insert":1,"owner_id":"frerry","unit":"个","no_give":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","name":"血狮鹫的信箱",])
mails ({(["from":"杨中顺(yang zhongshun)","title":"杨中顺：帐目结算","to":"frerry","status":"O","text":"你的店主(杨中顺)任期结束，结余三百一十七两黄金九十两银子已存入你的户头。其中盈利三百一十七两黄金九十两银子，剩余预付金零文钱。","time":1090428766,]),(["from":"鹤发老童(hefa laotong)","title":"鹤发老童：帐目结算","status":"N","to":"frerry","text":"你的店主(鹤发老童)任期结束，结余八两黄金七十七两银子已存入你的户头。其中盈利八两黄金七十七两银子，剩余预付金零文钱。","time":1091055873,]),})
