#/obj/mailbox.c
dbase (["no_insert":1,"no_give":1,"name":"猪猪儿的信箱","id":"mailbox","owner_id":"rise","unit":"个","long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","no_drop":1,])
mails ({(["time":1097962835,"title":"杨中顺：帐目结算","to":"rise","status":"O","text":"你的店主(杨中顺)任期结束，结余七百七十五两黄金三十两银子已存入你的户头。其中盈利七百七十五两黄金三十两银子，剩余预付金零文钱。","from":"杨中顺(yang zhongshun)",]),(["time":1100886329,"title":"郑寡妇：帐目结算","to":"rise","status":"N","text":"你的店主(郑寡妇)任期结束，结余十五两黄金已存入你的户头。其中盈利十五两黄金，剩余预付金零文钱。","from":"郑寡妇(zheng guafu)",]),(["time":1100960016,"to":"rise","title":"鹤发老童：帐目结算","status":"N","text":"你的店主(鹤发老童)任期结束，结余二两黄金九十三两银子已存入你的户头。其中盈利二两黄金九十三两银子，剩余预付金零文钱。","from":"鹤发老童(hefa laotong)",]),})
