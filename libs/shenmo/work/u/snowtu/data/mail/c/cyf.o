#/obj/mailbox.c
dbase (["long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","unit":"个","no_insert":1,"name":"信箱","owner_id":"cyf","no_drop":1,"id":"mailbox","no_give":1,])
mails ({(["title":"万口福：帐目结算","text":"你的店主(万口福)任期结束，结余十二两黄金五十两银子已存入你的户头。其中盈利十二两黄金五十两银子，剩余预付金零文钱。","from":"万口福(wan koufu)","time":1179364332,"status":"N","to":"cyf",]),(["title":"黛姐：帐目结算","text":"你的店主(黛姐)任期结束，结余零文钱已存入你的户头。其中盈利零文钱，剩余预付金零文钱。","from":"黛姐(dai jie)","status":"N","time":1179508231,"to":"cyf",]),})
