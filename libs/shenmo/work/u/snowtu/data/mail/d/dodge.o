#/obj/mailbox.c
dbase (["name":"起舞弄清影的信箱","long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","no_insert":1,"unit":"个","owner_id":"dodge","no_drop":1,"no_give":1,"id":"mailbox",])
mails ({(["title":"老婆婆：帐目结算","to":"dodge","status":"O","text":"你的店主(老婆婆)任期结束，结余七十五文钱已存入你的户头。其中盈利七十五文钱，剩余预付金零文钱。","time":1139783670,"from":"老婆婆(old woman)",]),(["title":"郑寡妇：帐目结算","to":"dodge","status":"O","text":"你的店主(郑寡妇)任期结束，结余六十六两黄金已存入你的户头。其中盈利六十六两黄金，剩余预付金零文钱。","time":1139963461,"from":"郑寡妇(zheng guafu)",]),})
