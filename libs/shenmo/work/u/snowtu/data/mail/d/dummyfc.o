#/obj/mailbox.c
dbase (["no_give":1,"name":"方寸山的信箱","long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","id":"mailbox","owner_id":"dummyfc","no_insert":1,"unit":"个","no_drop":1,])
mails ({(["status":"O","text":"你的店主(孔方兄)任期结束，结余八十两银子已存入你的户头。其中盈利八十两银子，剩余预付金零文钱。","from":"孔方兄(kong fang)","time":1094121562,"title":"孔方兄：帐目结算","to":"dummyfc",]),})
