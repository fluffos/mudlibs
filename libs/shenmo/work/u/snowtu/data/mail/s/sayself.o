#/obj/mailbox.c
dbase (["name":"自言自语的信箱","no_drop":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","unit":"个","owner_id":"sayself","id":"mailbox","no_insert":1,"no_give":1,])
mails ({(["status":"O","to":"sayself","text":"你的店主(阴老板)任期结束，结余零文钱已存入你的户头。其中盈利零文钱，剩余预付金零文钱。","title":"阴老板：帐目结算","time":1120952196,"from":"阴老板(yinlao ban)",]),})
