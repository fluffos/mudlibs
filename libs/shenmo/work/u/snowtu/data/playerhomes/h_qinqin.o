#/obj/home.c
dbase (["bed_long":"床既名销魂，自当用来做销魂之事。床非常宽大，也非常柔软，四周垂着一床轻纱，让人在外面看到床的情景都是似梦似幻，疑幻疑真。据说此床还有不为人知的妙用，只有亲身体会才能知晓。","home_host":({"qinqin","vivier",}),"name":"秦羽楼","exits":(["out":"/d/changan/ph",]),"id":"h_qinqin","short":"秦羽楼","file_name":"h_qinqin","env":(["invisibility":1,]),"no_get":1,"long":"江湖第一大帮会--秦羽楼的总堂，防备极为森严，明岗暗哨处处。门外站四个彪型大汉，任何要进入这里的人都要经过严格检查。这里装修非常简单，但自有一种君临天下的气势。前进大堂是帮会处理日常事务、以及接待其他江湖人士的地方，后进便是楼主夫妇秦青和羽衣霓裳起居之所。","no_fight":1,"bed_short":"销魂软卧","no_magic":1,])
out "/d/changan/ph"
