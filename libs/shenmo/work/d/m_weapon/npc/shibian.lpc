#include <ansi.h>
inherit NPC;
#include "maker.h"

void create()
{
set_name("侍鞭", ({ "shibian"}) );
set("gender", "女性" );
set("long","她头上包着天青色纱巾，一领天青色布袍，没有一丝褶皱。\n");

set("weapon_type","whip"); //(*)
set("weapon_need_or",({"寒丝羽竹"})); //材料限制
        
set("inquiry", ([
        "造鞭"  : "师傅命我帮助别人造鞭，但到现在也不见一个人影。谁要造鞭呢？\n",
        "原料"  : "造鞭只能用寒丝羽竹。\n",
        ]) );

setup();
carry_object("/d/obj/cloth/pink_cloth")->wear();
}
