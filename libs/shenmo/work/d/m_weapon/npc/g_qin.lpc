#include <ansi.h>
inherit NPC;
#include "star.h"

void create() {
  set_name(HIB "琴魄" NOR, ({ "soul of qin", "qin", "soul" }));
  set("weapon_type", "qin");
  set("long", HIW "传说中的的魂魄，练就上古神兵的必须品。\n" NOR);
  set("gender", "男性");
  set("title", HIY "方舟传说之琴魄" NOR);
  set("age", 30);
  set("attitude", "friendly");
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 40);
  set("combat_exp", 125000000);
  set("daoxing", 125000000);
  set_skill("dodge", 600);
  set_skill("force", 600);
  set_skill("parry", 600);
  set_skill("unarmed", 600);
  set_skill("shengdou", 600);
  set_skill("stars-steps", 600);
  set_skill("moonforce", 600);
  set_skill("moonshentong", 600);
  map_skill("parry", "shengdou");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "shengdou");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("max_force", 8000);
  set("force", 16000);
  set("max_mana", 8000);
  set("mana", 16000);
  set("mana_factor", 350);
  set("force_factor", 200);
  set("max_kee", 70000);
  set("max_gin", 70000);
  set("max_sen", 70000);
  setup();
  carry_object("/d/longzhu/armor/guijia")->wear();
}
