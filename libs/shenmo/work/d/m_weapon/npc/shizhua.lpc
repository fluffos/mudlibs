#include <ansi.h>
inherit NPC;
#include "maker.h"

void create() {
  set_name("侍爪", ({ "shizhua" }));
  set("gender", "男性");
  set("long", "他头上包着白布头巾，一袭白袍，没有一丝褶皱。\n");

  //set("weapon_type","unarmed"); //(*)  和欧冶子那不配套啊，老欧那是hand，暂且按老头那的改吧 by snowtu
  set("weapon_type", "unarmed");  //(*)看来必须是unarmed，否则武器的skill_type是错的，需要改老欧了,by snowtu
  set("weapon_need_or", ({ "寒丝羽竹", "海底金母", }));  //材料限制

  set("inquiry", ([
    "铸爪": "师傅命我帮助别人铸爪，但到现在也不见一个人影。谁要铸爪呢？\n",
    "原料": "铸爪可用寒丝羽竹，海底金母。但效果各不一样。\n",
  ]));
  setup();
  carry_object("/d/obj/cloth/choupao")->wear();
}
