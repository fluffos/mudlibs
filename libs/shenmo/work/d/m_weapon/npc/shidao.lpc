#include <ansi.h>
inherit NPC;
#include "maker.h"

void create()
{
set_name("侍刀", ({ "shidao"}) );
set("gender", "男性" );
set("long","他头上包着白布头巾，一袭白袍，没有一丝褶皱。\n");

set("weapon_type","blade"); //(*)
set("weapon_need_or",({"寒丝羽竹","海底金母","千年神木"})); //材料限制
        
set("inquiry", ([
        "铸刀"  : "师傅命我帮助别人铸刀，但到现在也不见一个人影。谁要铸刀呢？\n",
        "原料"  : "铸刀可用寒丝羽竹，海底金母，千年神木。但效果各不一样。\n",
]) );

setup();
carry_object("/d/obj/cloth/choupao")->wear();
}
