#include <ansi.h>
inherit NPC;
#include "maker.h"

void create()
{
set_name("侍剑", ({ "shijian"}) );
set("gender", "男性" );
set("long","他头上包着白布头巾，一袭白袍，没有一丝褶皱。\n");

set("weapon_type","sword"); //(*)
set("weapon_need_or",({"寒丝羽竹","海底金母","千年神木"})); //材料限制
        
set("inquiry", ([
        "铸剑"  : "师傅命我帮助别人铸剑，但到现在也不见一个人影。谁要铸剑呢？\n",
        "原料"  : "铸剑可用寒丝羽竹，海底金母，千年神木。但效果各不一样。\n",
]) );
setup();
carry_object("/d/obj/cloth/choupao")->wear();
}
