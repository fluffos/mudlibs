{
   set ("short", "魂魄战场");
  set ("long", @LONG
传说中的魂魄出没之地
据说只要战胜他们，他们就会依附在你的武器上
从而增加你武器的威力
四周森森白骨，见证着降服他们的艰难
LONG);

  set("objects",([ 
      __DIR__"npc/g_blade" :2,
      __DIR__"npc/g_sword" :2,
      __DIR__"npc/g_spear" :2,
      __DIR__"npc/g_stick" :2,
      __DIR__"npc/g_hand" :2,
      __DIR__"npc/g_hammer" :2,
      __DIR__"npc/g_throwing" :2,
      __DIR__"npc/g_needle" :2,
      __DIR__"npc/g_rake" :2,
      __DIR__"npc/g_qin" :2,
      __DIR__"npc/g_halberd" :2,
      __DIR__"npc/g_archery" :2,
      __DIR__"npc/g_whip" :2,
      __DIR__"npc/g_mace" :2,
      __DIR__"npc/g_axe" :2,
      __DIR__"npc/g_staff" :2,
      __DIR__"npc/g_fork" :2,
    ]));

      set("no_magic",1);
      set("no_move",1);
        setup();
//        replace_program(ROOM);
}

