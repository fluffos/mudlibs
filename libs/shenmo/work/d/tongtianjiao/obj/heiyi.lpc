// cloth.c

#include <armor.h>

inherit CLOTH;
#include <ansi.h>
void create() {
  set_name(HIB "黑色道袍" NOR, ({ "hei yi", "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件黑色的道袍，是通天教门人惯穿的衣服。\n");
    set("value", 10000);
    set("material", "cloth");
    set("armor_prop/armor", 40);
  }
  setup();
}
