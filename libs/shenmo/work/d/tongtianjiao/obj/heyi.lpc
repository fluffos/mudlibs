// cloth.c

#include <armor.h>

inherit CLOTH;
#include <ansi.h>
void create() {
  set_name(HIR "大红白鹤绛绡衣" NOR, ({ "he yi", "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件用鹤羽织就的仙衣，霞光万道。\n");
    set("value", 10000);
    set("material", "cloth");
    set("armor_prop/armor", 120);
  }
  setup();
}
