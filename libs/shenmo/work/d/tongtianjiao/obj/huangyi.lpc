// cloth.c

#include <armor.h>

inherit CLOTH;
#include <ansi.h>
void create()
{
        set_name(HIY "杏黄道袍" NOR, ({ "huang yi", "cloth" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
                set("long", "一件杏黄色的道袍，当是通天教内有身份的人所穿。\n");
		set("value", 10000);
		set("material", "cloth");
                set("armor_prop/armor", 80);
	}
	setup();
}
