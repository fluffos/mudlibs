// cloth.c

#include <armor.h>

inherit CLOTH;
#include <ansi.h>
void create() {
  set_name(HIM "红云仙衣" NOR, ({ "yun yi", "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件用彩云织就的仙衣，煞是好看。\n");
    set("value", 10000);
    set("material", "cloth");
    set("armor_prop/armor", 100);
  }
  setup();
}
