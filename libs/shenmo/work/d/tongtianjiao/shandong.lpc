
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "上清洞");
        set("long", @LONG
这里是通天教主静修的山洞。洞虽不大，但却布置得
很是雅致，便似客厅一样。洞内有一张碧游床，通天教主
正微合双目端坐在床上。
LONG);
        set("exits", ([
                "out" : __DIR__"xiaolu3",
        ]));
        set("objects", ([
                __DIR__"npc/ttjz" : 1,
                __DIR__"npc/tongzi" : 2,
        ]));

        setup();
        replace_program(ROOM);
}

