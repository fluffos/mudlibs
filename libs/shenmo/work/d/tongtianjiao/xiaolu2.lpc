inherit ROOM;

void create() {
  set("short", "仙人路");
  set("long", @LONG
这里是碧游宫内的一条仙路，这条仙直通碧游宫后的一个
山洞，那里正是通天教主闭关清修的地方。
LONG);
  set("outdoors", "tongtianjiao");
  set("exits", ([
    "east": __DIR__ "xiaolu3",
    "southwest": __DIR__ "xiaolu1",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
