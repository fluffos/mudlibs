#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "通天塔一层");
  set("long", @LONG
这里是通天塔的一层，通天塔本是通天教弟子用来存放经
书的地方，塔不高，是用一块一块的大青石砌起来的。塔中的
梯子也是用青石所砌，据说之所以用石头砌塔是为了避免失火
烧毁了通天教的经书。但是古老相传，有一个天道成皇的孔雀
妖圣被通天教主镇于塔底，不知是真是假。
LONG);
  set("exits", ([
    "south": __DIR__ "guozhendian",
    "westup": __DIR__ "cundaota2",
  ]));
  set("no_clean_up", 0);
  setup();
}
