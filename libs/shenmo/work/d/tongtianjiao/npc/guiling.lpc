//created 5-20-97 pickle

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("龟灵圣母", ({ "guiling shengmu", "guiling", "shengmu", "master" }));
  set("long", @LONG
她是通天教主的四徒弟。
LONG);

  set("title", "通天教主座下");
  set("gender", "女性");
  set("level", 1000);
  set("class", "saint");
  set("age", 80);
  set("str", 45);
  set("per", 28);
  set("int", 30);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 250000000);
  set_skill("force", 250);
  set_skill("yiqi-hunyuan", 250);
  set_skill("spells", 250);
  set_skill("tongtian-dafa", 250);
  set_skill("blade", 250);
  set_skill("unarmed", 300);
  set_skill("jitian-zhang", 300);
  set_skill("parry", 250);
  set_skill("tianmo-blade", 250);
  set_skill("literate", 250);
  set_skill("dodge", 250);
  set_skill("piaomiao-shenfa", 250);
  map_skill("force", "yiqi-hunyuan");
  map_skill("spells", "tongtian-dafa");
  map_skill("unarmed", "jitian-zhang");
  map_skill("blade", "tianmo-blade");
  map_skill("parry", "tianmo-blade");
  map_skill("dodge", "piaomiao-shenfa");
  set("max_sen", 40000);
  set("max_kee", 40000);
  set("force", 10000);
  set("max_force", 5000);
  set("mana", 10000);
  set("max_mana", 5000);
  set("daoxing", 250000000);
  set("force_factor", 250);
  set("mana_factor", 250);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "zhanglei" :),
    (: perform_action, "unarmed", "duanhun" :),
    (: perform_action, "unarmed", "huangquan" :),
    (: exert_function, "sanhua" :),
    (: perform_action, "blade", "xian" :),
    (: perform_action, "blade", "zhan" :),
    (: perform_action, "blade", "jifeng" :),
    (: cast_spell, "zijinchui" :),
  }));

  create_family("通天教", 2, "蓝");
  setup();

  carry_object("/d/obj/weapon/blade/jindao")->wield();
  carry_object("/d/tongtianjiao/obj/huangyi")->wear();
}

int accept_fight(object me) {
  command("say 贫道手重，伤了你反为不美！\n");
  return 0;
}
void attempt_apprentice(object ob) {
  if (ob->query("family/family_name") != "通天教" || ob->query("class") != "saint") {
    command("say 你是何人？");
    return;
  }
  if (((int)ob->query("combat_exp") < 4000000)) {
    command("say " + RANK_D->query_respect(ob) +
      "的经验不够，有些绝学秘法恐怕难以领悟。\n");
    return;
  }
  if (((int)ob->query("daoxing") < 4000000)) {
    command("say " + RANK_D->query_respect(ob) +
      "的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
    return;
  }
  if ((int)ob->query_skill("tongtian-dafa", 1) < 200) {
    command("say 通天大法是我门中人必修之课！");
    return;
  }
  command("say 很好，我收下你了，以后要加倍努力！\n");
  command("recruit " + ob->query("id"));
  return;
}
