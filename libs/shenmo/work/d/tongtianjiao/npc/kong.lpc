#include <ansi.h> 
inherit NPC;
inherit F_MASTER;
//inherit SKILL;

void create()
{
  set_name("孔宣", ({"kong xuan", "kong", "xuan", "master"}));
  set ("long", @LONG
吕岳乃是雷火瘟斗四部正神当中的瘟部正神，主掌
着天下瘟癀毒疫，被奉为“五毒之祖”。别说是普
通百姓，就连玉皇大帝见了他腿肚子都打哆嗦。自
从姜子牙封神之后，吕岳榜上有名。从此修心养性
，一心向道。听说他的几个弟子在盘丝岭黄花观开
山立派，他特地从东海赶过来助阵。
LONG);
 
  set("title", HIW"飞羽大帝"NOR);
  set("gender", "男性");
  set("level", 500);
set("class","saint");
  set("age", 43);
  set("str", 45);
  set("per", 35);
  set("int", 30);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 8000000);
  set_skill("force", 350);
  set_skill("tongtian-dafa", 350);
  set_skill("spells", 350);
  set_skill("unarmed", 350);
  set_skill("feiyu-shu", 350);
  set_skill("parry", 350);
  set_skill("literate", 350);
  set_skill("dodge", 350);
  set_skill("throwing", 350);
  set("max_sen", 6000);
  set("max_kee", 8000);
set("force", 8000);
set("max_force", 6000);
set("mana",6000);
set("max_mana",6000);
set("daoxing",5000000);
set("force_factor", 300);
set("mana_factor", 300);
 
  create_family("通天教", 1, "蓝");
  setup();
 
carry_object("/d/yhg/obj/jiedudan");
carry_object("/d/obj/cloth/taijicloth")->wear();
}
 
int accept_fight(object me)
{
  command("say 你活得不耐烦了？\n");
  return 0;
}
void attempt_apprentice(object ob)
{
 if ( (string)ob->query("family/family_name")!="通天教") 
{
command("say 你是何人？"); 
return; 
}
if (((int)ob->query("combat_exp") < 1000000 )) {
command("say " + RANK_D->query_respect(ob) +
"的经验不够，有些绝学秘法恐怕难以领悟。\n");
   return;
   }
if (((int)ob->query("daoxing") < 1000000 )) {
command("say " + RANK_D->query_respect(ob) +
"的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
   return;
   }
if( (int)ob->query_skill("tongtian-dafa",1) < 500)
{
command("say 通天大法是我门中人必修之课！");
return;
}
  if ((int)ob->query_skill("force") < 200 )
    {
      command("say 你的内功修为太浅。");
      return;
    }
  command("say 你的根骨不错，我就收下你了。以后要好好努力啊，毒技学好了照样能天下无敌！\n");
  command("recruit " + ob->query("id") );
return ;
}
int recruit_apprentice(object ob)
{
if( ::recruit_apprentice(ob) ) {
ob->set("title", HIW"飞羽传人"NOR);
}

}
