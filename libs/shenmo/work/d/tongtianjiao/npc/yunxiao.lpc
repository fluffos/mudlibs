//created 5-20-97 pickle

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("云霄娘娘", ({ "yunxiao niangniang", "yunxiao", "niangniang", "master" }));
  set("long", @LONG
峨嵋山罗浮洞修炼的截教真仙，三霄娘娘中的老大。
LONG);

  set("title", HIM "截教真仙" NOR);
  set("gender", "女性");
  set("level", 500);
  set("class", "saint");
  set("age", 30);
  set("str", 45);
  set("per", 30);
  set("int", 30);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 200000000);
  set_skill("force", 200);
  set_skill("yiqi-hunyuan", 200);
  set_skill("spells", 200);
  set_skill("tongtian-dafa", 200);
  set_skill("whip", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("riyue-bian", 200);
  set_skill("literate", 200);
  set_skill("dodge", 200);
  set_skill("piaomiao-shenfa", 200);
  map_skill("force", "yiqi-hunyuan");
  map_skill("spells", "tongtian-dafa");
  map_skill("whip", "riyue-bian");
  map_skill("parry", "riyue-bian");
  map_skill("dodge", "piaomiao-shenfa");
  set("max_sen", 30000);
  set("max_kee", 30000);
  set("force", 8000);
  set("max_force", 4000);
  set("mana", 8000);
  set("max_mana", 4000);
  set("daoxing", 200000000);
  set("force_factor", 200);
  set("mana_factor", 200);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: exert_function, "sanhua" :),
    (: perform_action, "whip", "chan" :),
    (: perform_action, "whip", "dian" :),
    (: cast_spell, "zijinchui" :),
  }));

  create_family("通天教", 3, "蓝");
  setup();

  carry_object("/d/obj/weapon/whip/fuchen")->wield();
  carry_object("/d/tongtianjiao/obj/yunyi")->wear();
}

int accept_fight(object me) {
  command("say 我不喜欢打打杀杀的！\n");
  return 0;
}
void attempt_apprentice(object ob) {
  if (ob->query("family/family_name") != "通天教" || ob->query("class") != "saint") {
    command("say 你是何人？");
    return;
  }
  if (((int)ob->query("combat_exp") < 3000000)) {
    command("say " + RANK_D->query_respect(ob) +
      "的经验不够，有些绝学秘法恐怕难以领悟。\n");
    return;
  }
  if (((int)ob->query("daoxing") < 3000000)) {
    command("say " + RANK_D->query_respect(ob) +
      "的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
    return;
  }
  if ((int)ob->query_skill("tongtian-dafa", 1) < 150) {
    command("say 通天大法是我门中人必修之课！");
    return;
  }
  command("say 很好，我收下你了，以后要加倍努力！\n");
  command("recruit " + ob->query("id"));
  return;
}
