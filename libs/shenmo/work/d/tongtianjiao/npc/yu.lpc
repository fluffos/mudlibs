#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("余元", ({ "yu yuan", "yu", "yuan", "master" }));
  set("long", @LONG
金灵圣母门下，拥有金刚不坏之身。
LONG);

  set("title", "化血神刀");
  set("gender", "男性");
  set("level", 300);
  set("class", "saint");
  set("age", 60);
  set("str", 45);
  set("per", 25);
  set("int", 20);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 100000000);
  set_skill("force", 150);
  set_skill("yiqi-hunyuan", 150);
  set_skill("spells", 120);
  set_skill("tongtian-dafa", 120);
  set_skill("blade", 150);
  set_skill("unarmed", 120);
  set_skill("parry", 120);
  set_skill("tianmo-blade", 120);
  set_skill("jitian-zhang", 120);
  set_skill("dodge", 120);
  set_skill("literate", 120);
  set_skill("piaomiao-shenfa", 120);
  map_skill("force", "yiqi-hunyuan");
  map_skill("spells", "tongtian-dafa");
  map_skill("blade", "tianmo-blade");
  map_skill("unarmed", "jitian-zhang");
  map_skill("parry", "tianmo-blade");
  map_skill("dodge", "piaomiao-shenfa");
  set("max_sen", 10000);
  set("max_kee", 10000);
  set("force", 6000);
  set("max_force", 3000);
  set("mana", 6000);
  set("max_mana", 3000);
  set("daoxing", 100000000);
  set("force_factor", 100);
  set("mana_factor", 100);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: exert_function, "sanhua" :),
    (: cast_spell, "zijinchui" :),
  }));

  create_family("通天教", 4, "蓝");
  setup();

  carry_object("/d/tongtianjiao/obj/huaxuedao")->wield();
  carry_object("/d/tongtianjiao/obj/heiyi")->wear();
}

int accept_fight(object me) {
  command("say 贫道手重，伤了你反为不美！\n");
  return 0;
}
void attempt_apprentice(object ob) {
  if (ob->query("family/family_name") != "通天教" || ob->query("class") != "saint") {
    command("say 你是何人？");
    return;
  }
  if (((int)ob->query("combat_exp") < 1000000)) {
    command("say " + RANK_D->query_respect(ob) +
      "的经验不够，有些绝学秘法恐怕难以领悟。\n");
    return;
  }
  if (((int)ob->query("daoxing") < 1000000)) {
    command("say " + RANK_D->query_respect(ob) +
      "的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
    return;
  }
  if ((int)ob->query_skill("tongtian-dafa", 1) < 80) {
    command("say 通天大法是我门中人必修之课！");
    return;
  }
  command("say 很好，我收下你了，以后要加倍努力！\n");
  command("recruit " + ob->query("id"));
  return;
}
