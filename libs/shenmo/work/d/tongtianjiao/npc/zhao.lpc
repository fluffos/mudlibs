//created 5-20-97 pickle

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("赵公明", ({ "zhao gongming", "zhao", "gongming", "master" }));
  set("long", @LONG
峨嵋山罗浮洞修炼的截教真仙，归位后被姜子牙封为财神。
LONG);

  set("title", HIY "截教真仙之财神" NOR);
  set("gender", "男性");
  set("level", 1000);
  set("class", "saint");
  set("age", 60);
  set("str", 45);
  set("per", 28);
  set("int", 30);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 300000000);
  set_skill("force", 300);
  set_skill("yiqi-hunyuan", 300);
  set_skill("spells", 300);
  set_skill("tongtian-dafa", 300);
  set_skill("whip", 350);
  set_skill("unarmed", 300);
  set_skill("jitian-zhang", 300);
  set_skill("parry", 300);
  set_skill("riyue-bian", 300);
  set_skill("literate", 300);
  set_skill("dodge", 300);
  set_skill("piaomiao-shenfa", 300);
  map_skill("force", "yiqi-hunyuan");
  map_skill("spells", "tongtian-dafa");
  map_skill("unarmed", "jitian-zhang");
  map_skill("whip", "riyue-bian");
  map_skill("parry", "riyue-bian");
  map_skill("dodge", "piaomiao-shenfa");
  set("max_sen", 50000);
  set("max_kee", 50000);
  set("force", 12000);
  set("max_force", 6000);
  set("mana", 12000);
  set("max_mana", 6000);
  set("daoxing", 300000000);
  set("force_factor", 300);
  set("mana_factor", 300);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "zhanglei" :),
    (: perform_action, "unarmed", "duanhun" :),
    (: perform_action, "unarmed", "huangquan" :),
    (: exert_function, "sanhua" :),
    (: perform_action, "whip", "chan" :),
    (: perform_action, "whip", "dian" :),
    (: perform_action, "whip", "feng" :),
    (: cast_spell, "zijinchui" :),
  }));

  create_family("通天教", 2, "蓝");
  setup();

  carry_object("/d/obj/weapon/whip/longsuo")->wield();
  carry_object("/d/tongtianjiao/obj/huangyi")->wear();
}

int accept_fight(object me) {
  command("say 贫道手重，伤了你反为不美！\n");
  return 0;
}
void attempt_apprentice(object ob) {
  if (ob->query("family/family_name") != "通天教" || ob->query("class") != "saint") {
    command("say 你是何人？");
    return;
  }
  if (((int)ob->query("combat_exp") < 5000000)) {
    command("say " + RANK_D->query_respect(ob) +
      "的经验不够，有些绝学秘法恐怕难以领悟。\n");
    return;
  }
  if (((int)ob->query("daoxing") < 5000000)) {
    command("say " + RANK_D->query_respect(ob) +
      "的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
    return;
  }
  if ((int)ob->query_skill("tongtian-dafa", 1) < 200) {
    command("say 通天大法是我门中人必修之课！");
    return;
  }
  command("say 很好，我收下你了，以后要加倍努力！\n");
  command("recruit " + ob->query("id"));
  return;
}
