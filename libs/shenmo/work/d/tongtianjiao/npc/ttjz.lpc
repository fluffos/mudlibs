#include <ansi.h> 
inherit NPC;
inherit F_MASTER;

void create()
{
  set_name("通天教主", ({"tongtian jiaozhu", "jiaozhu", "tongtian", "master"}));
  set ("long", @LONG
他就是截教祖师，三清教之上清教主，鸿钧老祖的三徒弟。
LONG);
 
  set("title", HIG"上清圣地通天教祖灵宝天尊"NOR);
  set("gender", "男性");
  set("level", 1500);
set("class","saint");
  set("age", 100);
  set("str", 45);
  set("per", 35);
  set("int", 40);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 500000000);
  set_skill("force", 500);
  set_skill("yiqi-hunyuan", 500);
  set_skill("spells", 500);
  set_skill("tongtian-dafa", 500);
  set_skill("sword", 500);
  set_skill("blade", 500);
  set_skill("shangqing-sword", 500);
  set_skill("unarmed", 500);
  set_skill("jitian-zhang", 500);
  set_skill("parry", 500);
  set_skill("tianmo-blade", 500);
  set_skill("literate", 500);
  set_skill("dodge", 500);
  set_skill("piaomiao-shenfa", 500);
map_skill("force", "yiqi-hunyuan");
map_skill("spells", "tongtian-dafa");
  map_skill("unarmed", "jitian-zhang");
  map_skill("sword", "shangqing-sword");
  map_skill("blade", "tianmo-blade");
  map_skill("parry", "shangqing-sword");
  map_skill("dodge", "piaomiao-shenfa");
  set("max_sen", 100000);
  set("max_kee", 100000);
set("force", 20000);
set("max_force", 10000);
set("mana",20000);
set("max_mana",10000);
set("daoxing",500000000);
set("force_factor", 500);
set("mana_factor", 500);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
                (: perform_action, "unarmed", "zhanglei" :),
                (: perform_action, "unarmed", "duanhun" :),
                (: perform_action, "unarmed", "huangquan" :),
                (: perform_action, "sword", "zhuo" :),
                (: perform_action, "sword", "qing" :),
                (: perform_action, "sword", "kuai" :),
                (: exert_function, "sanhua" :),
                (: cast_spell, "zijinchui" :),
                (: cast_spell, "heijie" :),
  }) );
 
  create_family("通天教", 1, "蓝");
  setup();
 
carry_object("/d/zhuxian/obj/zhuxian")->wield();
carry_object("/d/tongtianjiao/obj/heyi")->wear();
}
 
int accept_fight(object me)
{
  command("say 没工夫搭理你！\n");
  return 0;
}
void attempt_apprentice(object ob)
{
 if (ob->query("family/family_name")!="通天教" || ob->query("class")!="saint") 
        {
        command("say 你是何人？"); 
        return; 
        }
if (((int)ob->query("combat_exp") < 10000000 )) {
command("say " + RANK_D->query_respect(ob) +
"的经验不够，有些绝学秘法恐怕难以领悟。\n");
   return;
   }
if (((int)ob->query("daoxing") < 10000000 )) {
command("say " + RANK_D->query_respect(ob) +
"的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
   return;
   }
if( (int)ob->query_skill("tongtian-dafa",1) < 300)
{
command("say 通天大法是我门中人必修之课！");
return;
}
  command("say 你的悟性不错，我就收下你了。以后要好好努力啊，光耀我截教门楣指日可待！\n");
  command("recruit " + ob->query("id") );
return ;
}
int recruit_apprentice(object ob)
{
if( ::recruit_apprentice(ob) ) {
ob->set("title", HIG"通天教主亲传弟子"NOR);
}

}

void die()
{
        if( environment() ) {
        message("sound", "\n\n通天教主冷哼一声，道：这厮果是个天成地就的！\n\n", environment());
        command("bye");
        message("sound", "\n通天教主身形一转，化做青烟走了。。。\n\n", environment());
        }
        destruct(this_object());
}
