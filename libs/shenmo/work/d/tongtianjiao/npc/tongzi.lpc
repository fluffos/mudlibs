inherit NPC;
#include <ansi.h>

void create() {
  set_name("黑衣童子", ({ "tong zi", "zi" }));
  set("gender", "男性");
  create_family("通天教", 5, "弟子");
  set("title", HIG "东海碧游宫" NOR);
  set("age", 14);
  set("long", "一个黑衣童子，正在疑惑地看着你。\n");
  set("combat_exp", 300000);
  set("attitude", "peaceful");
  setup();
  carry_object("/d/tongtianjiao/obj/heiyi")->wear();
}
