#include <ansi.h> 
inherit NPC;
inherit F_MASTER;

void create()
{
  set_name("穿山甲", ({"chuanshan jia", "chuanshan", "jia", "master"}));
  set ("long", @LONG
穿山甲是碧游宫看门的，因办事得力，颇得教主赏识。
LONG);
 
  set("title", "碧游宫门卫");
  set("gender", "男性");
  set("level", 100);
set("class","saint");
  set("age", 33);
  set("str", 50);
  set("per", 17);
  set("int", 20);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 500000);
  set_skill("force", 60);
  set_skill("yiqi-hunyuan", 60);
  set_skill("spells", 60);
  set_skill("tongtian-dafa", 60);
  set_skill("unarmed", 80);
  set_skill("jitian-zhang", 80);
  set_skill("parry", 60);
  set_skill("literate", 60);
  set_skill("dodge", 60);
  set_skill("piaomiao-shenfa", 60);
map_skill("force", "yiqi-hunyuan");
map_skill("spells", "tongtian-dafa");
  map_skill("unarmed", "jitian-zhang");
  map_skill("parry", "jitian-zhang");
  map_skill("dodge", "piaomiao-shenfa");
  set("max_sen", 6000);
  set("max_kee", 8000);
set("force", 2000);
set("max_force", 2000);
set("mana",2000);
set("max_mana",2000);
set("daoxing",5000000);
set("force_factor", 50);
set("mana_factor", 50);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
                (: perform_action, "unarmed", "zhanglei" :),
  }) );
 
  create_family("通天教", 5, "蓝");
  setup();
 
carry_object("/d/tongtianjiao/obj/heiyi")->wear();
}
 
void attempt_apprentice(object ob)
{
 if ( (string)ob->query("class")!="saint") 
        {
        command("say 你也配？"); 
        return; 
        }
  command("say 好吧，你和我臭味相投，我就收下你了，以后要好好努力啊！\n");
  command("recruit " + ob->query("id") );
return ;
}
