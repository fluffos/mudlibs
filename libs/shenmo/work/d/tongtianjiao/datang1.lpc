
#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
        set("short", "大堂一进");
        set("long", @LONG
这里是大堂，是通天教接待客人的地方。堂很大，几十张
桌椅一字排开也丝毫不显拥挤。地下铺着整齐的青砖，穿山甲
正带着几名童子忙前忙后地端茶送水招呼客人。
LONG);
        set("exits", ([
                "east" : __DIR__"datang2",
                "west" : __DIR__"damen",
                "north" : __DIR__"huizhentang",
                "south" : __DIR__"xianzhentang",
        ]));
        set("objects",([
                __DIR__"npc/chuan" : 1,
                __DIR__"npc/tongzi" : 1 + random(3),
        ]));
        create_door("west", HIY "镏金大门" NOR, "east", DOOR_CLOSED);
        set("valid_startroom", 1);
        setup();
        "/obj/board/ttj_b"->foo();
}

