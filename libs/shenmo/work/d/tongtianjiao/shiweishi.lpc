#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "虬首居");
  set("long", @LONG
这里是碧游宫七仙之虬首仙的居室。房间很小，只摆放一
张床、一张书桌和一把椅子。书桌上放着本老子，床上被褥折
叠得整整齐齐。
LONG);
  set("exits", ([
    "south": __DIR__ "cetang",
  ]));

  set("objects", ([
    __DIR__ "npc/qiushou": 1,
  ]));
  setup();
  replace_program(ROOM);
}
