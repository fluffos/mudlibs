#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "道房");
  set("long", @LONG
这里是通天教弟子摆放兵器的禅房，地下杂乱地堆着一些
剑，有的已经锈纹斑斑了，有的还是锋利透亮，教内弟子练功
的时候，就到这里来挑选兵刃。
LONG);
  set("exits", ([
    "east": __DIR__ "chanfang2",
  ]));
  set("objects", ([
    "/d/obj/weapon/sword/changjian": random(3),
    "/d/obj/weapon/blade/blade": random(3),
  ]));

  setup();
  replace_program(ROOM);
}
