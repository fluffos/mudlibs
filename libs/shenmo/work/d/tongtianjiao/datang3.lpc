#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "大堂三进");
  set("long", @LONG
这里是大堂的第三进，是通天教弟子议事的地方。通
天教教主最近闭关修炼，教内的俗事一般都交给大弟多宝
道人来打理，遇有事时，多宝道人便会召集教内弟子来此
议事。
LONG);
  set("exits", ([
    "east": __DIR__ "laojundian",
    "south": __DIR__ "nairongdian",
    "west": __DIR__ "datang2",
    "north": __DIR__ "guozhendian",
  ]));
  set("objects", ([
    __DIR__ "npc/zhangmen": 1,
    __DIR__ "npc/daoren": 1,
  ]));
  setup();
  replace_program(ROOM);
}
