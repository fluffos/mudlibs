//防止修佛用bug之NPC

#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIB "苦行" + HIC "罗汉" NOR, ({ "kuxing luohan" }));
  set("long", BLINK + HIW + @LONG  
南	無	阿	彌	陀	佛
我	身	無	長	一	物
LONG + NOR);
  set("gender", "男性");
  set("age", random(10000));
  set("per", random(10));
  setup();
}

void init() {
  add_action("do_none", "kill");
  add_action("do_none", "fight");
  add_action("do_none", "ji");
  add_action("do_none", "move");
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "steal");
  add_action("do_none", "quit");
  add_action("do_none", "burn");
}

int do_none() {
  object who = this_player();
  object ob = this_object();
  message_vision(HIW "\n$N" + HIW "对$n" + HIW "摇了摇头“心无杂骛，方始大成，阿弥陀佛。\n" NOR, ob, who);
  return 1;
}
