#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("谷虚道长", ({"guxu daozhang", "guxu"}));
        set("gender", "男性" );
        set("age", 33);
        set("combat_exp", 500000);
	set("daoxing", 500000);

        set("attitude", "peaceful");
	set("int", 25);
        set("class", "saint");
        create_family("武当派", 3, "弟子");
	
        set("eff_dx", 30000);
        set("nkgain", 200);

        set_skill("unarmed", 120);
        set_skill("dodge", 120);
        set_skill("parry", 120);
        set_skill("spells", 120);  
        set_skill("taixu-spells", 120);
        set_skill("literate", 120);
        set_skill("sword", 120);  
        set_skill("taiji-jian", 120);
        set_skill("taiji-quan", 120);  
        set_skill("tiyunzong", 120);
        set_skill("dodge", 120);  
        set_skill("force", 120);   
        set_skill("taiji-shengong", 120);

        map_skill("spells", "taixu-spells");
        map_skill("unarmed", "taiji-quan");
        map_skill("force", "taiji-shengong");
        map_skill("sword", "taiji-jian");
        map_skill("parry", "taiji-jian");
        map_skill("dodge", "tiyunzong");


        set("per", 30);
        set("max_kee", 500);
        set("max_gin", 500);
        set("max_sen", 500);
        set("force", 1500);
        set("max_force", 1500);
        set("force_factor", 50);
        set("mana", 1500);
        set("max_mana", 1500);
        set("mana_factor", 50);

        setup();
        carry_object("/d/obj/weapon/sword/qinghong")->wield();
}
void attempt_apprentice(object ob, object me)
{
        command("say 很好，" + RANK_D->query_respect(ob) +
"加入我武当山以后多加努力，他日做出你的贡献。\n");
        command("recruit " + ob->query("id") );
	return;
}		

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                command("gongxi "+ob->query("id"));
}


