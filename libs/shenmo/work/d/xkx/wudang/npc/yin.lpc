#include <ansi.h>
inherit NPC;
#include <ansi.h>
inherit F_MASTER;
void create()
{
        set_name("殷梨亭", ({"yin liting","yin"}));
        set("gender", "男性" );
        set("age", 33);
        set("title",HIR "武当六侠" NOR);
        set("combat_exp", 1500000);
	set("daoxing", 1500000);
         set("long",
                "他就是张三丰的最软弱的弟子、武当七侠之六的殷梨亭。\n"
               "身穿一件干干净净的青布长衫。\n"
                "他不过二十出头年纪，精明能干，嫉恶如仇，性如烈火，却一直一副不愉快的表情。\n");

        set("attitude", "peaceful");
	set("int", 25);
        set("class", "saint");
        create_family("武当派", 2, "弟子");
	
        set("eff_dx", 30000);
        set("nkgain", 200);

        set_skill("unarmed", 280);
        set_skill("dodge", 280);
        set_skill("parry", 280);
        set_skill("spells", 280);  
        set_skill("taixu-spells", 280);
        set_skill("literate", 280);
        set_skill("sword", 280);  
        set_skill("taiji-jian", 280);
        set_skill("liangyi-jian",280);
        set_skill("taiji-quan", 280);  
        set_skill("tiyunzong", 280);
        set_skill("dodge", 280);  
        set_skill("force", 280);   
        set_skill("taiji-shengong", 280);

         map_skill("spells", "taixu-spells");
        map_skill("unarmed", "taiji-quan");
        map_skill("force", "taiji-shengong");
        map_skill("sword", "taiji-jian");
        map_skill("parry", "taiji-jian");
        map_skill("dodge", "tiyunzong");


        set("per", 30);
        set("max_kee", 2500);
        set("max_sen", 2500);
        set("force", 2500);
        set("max_force", 2500);
        set("force_factor", 50);
        set("mana", 2500);
        set("max_mana", 2500);
        set("mana_factor", 50);

        setup();
        carry_object("/d/obj/weapon/sword/qinghong")->wield();
        carry_object("/d/xkx/wudang/obj/bluecloth")->wear();
}
void attempt_apprentice(object ob, object me)
{
        if( (int)ob->query_skill("taiji-shengong", 1) < 100 ) {
        command("say 这位" + RANK_D->query_respect(ob) + "对我武当内功领会还不够深，现在收你也是勉为其难，不如作罢！\n");              
        return;
        }
        command("say 很好，" + RANK_D->query_respect(ob) +
"加入武当以后多加努力，他日做出你的贡献。\n");
        command("recruit " + ob->query("id") );
        
	return;
}		

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
 command("gongxi "+ob->query("id"));
}

