inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_mieyao(object me);
string ask_cancel();
#include "/d/panshi/panshi.h"


void create() {
  set_name("宋远桥", ({ "song yuanqiao", "song" }));
  set("gender", "男性");
  set("age", 33);
  set("title", HIR "武当七侠之首" NOR);
  set("combat_exp", 1500000);
  set("daoxing", 1500000);
  set("long", "武当山张真人得意弟子，武当七侠之首。\n");
  set("attitude", "peaceful");
  set("int", 25);
  set("class", "saint");
  create_family("武当派", 2, "弟子");

  set("eff_dx", 30000);
  set("nkgain", 200);

  set_skill("unarmed", 280);
  set_skill("dodge", 280);
  set_skill("parry", 280);
  set_skill("spells", 280);
  set_skill("taixu-spells", 280);
  set_skill("literate", 280);
  set_skill("sword", 280);
  set_skill("taiji-jian", 280);
  set_skill("liangyi-jian", 280);
  set_skill("taiji-quan", 280);
  set_skill("tiyunzong", 280);
  set_skill("dodge", 280);
  set_skill("force", 280);
  set_skill("taiji-shengong", 280);

  map_skill("spells", "taixu-spells");
  map_skill("unarmed", "taiji-quan");
  map_skill("force", "taiji-shengong");
  map_skill("sword", "taiji-jian");
  map_skill("parry", "taiji-jian");
  map_skill("dodge", "tiyunzong");


  set("per", 30);
  set("max_kee", 2500);
  set("max_sen", 2500);
  set("force", 2500);
  set("max_force", 2500);
  set("force_factor", 50);
  set("mana", 2500);
  set("max_mana", 2500);
  set("mana_factor", 50);
  set("inquiry", ([

    "行侠": (: ask_mieyao :),
    "cancel": (: ask_cancel :),
  ]));
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "taiji" :),
    (: perform_action, "sword", "lian" :),

  }));
  setup();
  carry_object("/d/xkx/wudang/obj/bluecloth")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
}

void attempt_apprentice(object ob) {
  if ((string)ob->query("family/family_name") == "武当派") {
    if (((int)ob->query_skill("taiji-shengong", 1) < 100)) {
      command("say " + RANK_D->query_respect(ob) +
        "还是先打好基础再来。\n");
      return;
    }


    command("pat " + ob->query("id"));
    command("say 好，希望" + RANK_D->query_respect(ob) +
      "多加努力，把我们武当发扬光大。\n");
    command("recruit " + ob->query("id"));
    command("say 我不收非武当弟子\n");
    return;
  }
}
string ask_cancel() {
  object me = this_player();
  if ((int)me->query_temp("m_mieyao")) {
    me->add("daoxing", -2000);
    me->delete_temp("m_mieyao");
    me->delete("secmieyao");
    me->delete("secmieyao/type");
    me->delete("secmieyao/location");
    me->delete("secmieyao/place");
    me->delete("secmieyao/name");
    me->delete("secmieyao/id");
    return ("哎，我也不怪你，以后你可得努力哦！");
  } else {
    return ("你有任务吗？！");
  }
}
string ask_mieyao(object me) {
  me = this_player();
  if ((string)me->query("family/family_name") == "武当派") {
    tell_room(environment(me), "宋远桥说道.....\n");
    return "/d/obj/mieyao"->query_yao(me);
  }
  return ("本道人不知道你在说些什么。");
}
