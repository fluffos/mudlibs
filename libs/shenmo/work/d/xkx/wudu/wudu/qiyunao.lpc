#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("齐云敖", ({ "qi yunao", "qi", "yunao" }));
        set("nickname", HIB "锦衣毒丐" NOR);
        set("long", @LONG
他就是五毒教的长老，人称锦衣毒丐的齐云
敖。乃是教主的同门师兄，在教中一向飞扬
跋扈，大权独揽。他长的身材魁梧，面目狰
狞，身穿一件五彩锦衣，太阳穴高高坟起。
LONG);
        set("title","五毒教长老");

        set("gender", "男性" );
        set("age", 33);
        set("combat_exp", 5000000);
	set("daoxing", 500000);

        set("attitude", "peaceful");
	set("int", 25);
	set("class", "wudang");
        create_family("五毒教", 12, "护法");
	
        set("eff_dx", 30000);
        set("nkgain", 200);

        set_skill("unarmed", 300);
        set_skill("dodge", 300);
        set_skill("parry", 300);
        set_skill("spells", 300);  
        set_skill("xiuluo-yinshagong", 300);
        set_skill("literate", 300);
        set_skill("sword", 300);  
        set_skill("jinwu-goufa", 300);
        set_skill("wudu-shenzhang", 300);  
        set_skill("jinshe-youshenbu", 300);
        set_skill("dodge", 300);  
        set_skill("force", 300);   
        set_skill("wudu-xinfa", 300);

        map_skill("spells", "xiuluo-yinshagong");
        map_skill("unarmed", "wudu-shenzhang");
        map_skill("force", "wudu-xinfa");
        map_skill("sword", "jinwu-goufa");
        map_skill("parry", "jinwu-goufa");
        map_skill("dodge", "jinshe-youshenbu");
        set("per", 30);
        set("max_kee", 10000);
        set("max_gin", 10000);
        set("max_sen", 10000);
        set("force", 8000);
        set("max_force", 8000);
        set("force_factor", 250);
        set("mana", 8000);
        set("max_mana", 8000);
        set("mana_factor", 250);

        setup();
        carry_object("/d/obj/weapon/sword/qinghong")->wield();
}
void attempt_apprentice(object ob)
{
             if ((int)ob->query("MKS") < 2000)
        {
       command("say 做我五毒教弟子必须心狠手辣,你杀的人还不够多。");
                return;
        }
        if ((int)ob->query_skill("wudu-xinfa", 1) < 180)
        {
                command("say 你的五毒心法还学的不够啊。");
                return;
        }
        if ((int)ob->query_skill("xiuluo-yinshagong", 1) < 180)
       {
                command("say 我五毒教弟子以毒杀人，法术修为是首要的。");
               command("say 你是否还应该多多钻研本门的绝学？");
               return;
        }
       command("nod");
       command("say 不错，不错。");
       command("recruit " + ob->query("id"));
       return;
}
