#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("何红药", ({ "he hongyao", "he" }));
  set("nickname", WHT "疤面丐婆" NOR);
  set("long", @LONG
他就是五毒教的长老，教主的姑姑何红药。虽然是
教主的长辈，但功夫却是一块跟上代教主学的。据
说她曾经被立为教主继承人，但后来犯下大错，所
以被罚到此处看守圣地，以赎前罪。她穿着一身破
旧的衣衫，满脸疤痕，长得骨瘦如柴，双目中满是
怨毒之色。
LONG);
  set("title", "五毒教长老");

  set("gender", "女性");
  set("age", 33);
  set("combat_exp", 2500000);
  set("daoxing", 2500000);

  set("attitude", "peaceful");
  set("int", 25);
  set("class", "wudang");
  create_family("五毒教", 12, "护法");

  set("eff_dx", 30000);
  set("nkgain", 200);

  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("spells", 200);
  set_skill("xiuluo-yinshagong", 200);
  set_skill("literate", 200);
  set_skill("sword", 200);
  set_skill("jinwu-goufa", 200);
  set_skill("wudu-shenzhang", 200);
  set_skill("jinshe-youshenbu", 200);
  set_skill("dodge", 200);
  set_skill("force", 200);
  set_skill("wudu-xinfa", 200);

  map_skill("spells", "xiuluo-yinshagong");
  map_skill("unarmed", "wudu-shenzhang");
  map_skill("force", "wudu-xinfa");
  map_skill("sword", "jinwu-goufa");
  map_skill("parry", "jinwu-goufa");
  map_skill("dodge", "jinshe-youshenbu");
  set("per", 30);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("force", 6000);
  set("max_force", 6000);
  set("force_factor", 200);
  set("mana", 6000);
  set("max_mana", 6000);
  set("mana_factor", 200);

  setup();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
}
void attempt_apprentice(object ob) {
  if ((int)ob->query("MKS") < 1000) {
    command("say 做我五毒教弟子必须心狠手辣,你杀的人还不够多。");
    return;
  }
  if ((int)ob->query_skill("wudu-xinfa", 1) < 100) {
    command("say 你的五毒心法还学的不够啊。");
    return;
  }
  if ((int)ob->query_skill("xiuluo-yinshagong", 1) < 100) {
    command("say 我五毒教弟子以毒杀人，法术修为是首要的。");
    command("say 你是否还应该多多钻研本门的绝学？");
    return;
  }
  command("nod");
  command("say 不错，不错。");
  command("recruit " + ob->query("id"));
  return;
}
