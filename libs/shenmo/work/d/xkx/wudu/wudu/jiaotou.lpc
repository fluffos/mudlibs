#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("沙千里", ({ "sha qianli", "sha", "qianli" }));
        set("nickname", HIR "黑龙" NOR);
         set("long",@LONG
他就是五毒教的护法弟子沙千里，身材魁梧，方
面大耳。在教中转管招募教众，教授弟子们的入
门功夫。
LONG);
  
        set("title","五毒教护法弟子");
        set("gender", "男性" );
        set("age", 33);
        set("combat_exp", 500000);
	set("daoxing", 500000);

        set("attitude", "peaceful");
	set("int", 25);
	set("class", "wudang");
        create_family("五毒教", 12, "护法");
	
        set("eff_dx", 30000);
        set("nkgain", 200);

        set_skill("unarmed", 150);
        set_skill("dodge", 150);
        set_skill("parry", 150);
        set_skill("spells", 150);  
        set_skill("xiuluo-yinshagong", 150);
        set_skill("literate", 150);
        set_skill("sword", 150);  
        set_skill("jinwu-goufa", 150);
        set_skill("wudu-shenzhang", 150);  
        set_skill("jinshe-youshenbu", 150);
        set_skill("dodge", 150);  
        set_skill("force", 150);   
        set_skill("wudu-xinfa", 150);

        map_skill("spells", "xiuluo-yinshagong");
        map_skill("unarmed", "wudu-shenzhang");
        map_skill("force", "wudu-xinfa");
        map_skill("sword", "jinwu-goufa");
        map_skill("parry", "jinwu-goufa");
        map_skill("dodge", "jinshe-youshenbu");
        set("per", 30);
        set("max_kee", 500);
        set("max_gin", 500);
        set("max_sen", 500);
        set("force", 1500);
        set("max_force", 1500);
        set("force_factor", 50);
        set("mana", 1500);
        set("max_mana", 1500);
        set("mana_factor", 50);

        setup();
        carry_object("/d/obj/weapon/sword/qinghong")->wield();
}
void attempt_apprentice(object ob)
{
             if ((int)ob->query("MKS") < 1000)
        {
       command("say 做我五毒教弟子必须心狠手辣,你杀的人还不够多。");
                return;
        }
        if ((int)ob->query_skill("wudu-xinfa", 1) < 100)
        {
                command("say 你的五毒心法还学的不够啊。");
                return;
        }
        if ((int)ob->query_skill("xiuluo-yinshagong", 1) < 100)
       {
                command("say 我五毒教弟子以毒杀人，法术修为是首要的。");
               command("say 你是否还应该多多钻研本门的绝学？");
               return;
        }
       command("nod");
       command("say 不错，不错。");
       command("recruit " + ob->query("id"));
       return;
}
