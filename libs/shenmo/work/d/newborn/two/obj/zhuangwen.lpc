 
#include <armor.h>

inherit ITEM;

void create()
{
        set_name("状文", ({"zhuang wen"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "cloth");
                set("long", "玄奘之母殷温娇为其夫申冤所写下的壮文。\n");
                set("unit", "张");
                set("value", 200);

        }
        setup();
}

