 
#include <armor.h>

inherit ITEM;

void create()
{
        set_name("血书", ({"yin`s xue shu", "book","shu"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "cloth");
                set("long", "玄奘之母殷温娇所写的血书。\n");
                set("unit", "件");
                set("value", 200);

        }
        setup();
}

