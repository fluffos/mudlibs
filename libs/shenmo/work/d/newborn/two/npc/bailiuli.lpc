inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIW "白琉璃" NOR, ({ "bai liuli", "bai", "liuli" }));
  set("gender", "女性");
  set("title", "盗宝贼");
  set("age", 20);
  set("con", 40);
  set("spi", 50);
  set("per", 30);
  set("str", 35);
  set("int", 45);
  set("combat_exp", 3000000);
  set("daoxing", 30000000);

  set("attitude", "friendly");
  set_skill("literate", 300);
  set_skill("spells", 300);
  set_skill("buddhism", 300);
  set_skill("unarmed", 300);
  set_skill("jienan-zhi", 300);
  set_skill("dodge", 300);
  set_skill("lotusmove", 300);
  set_skill("parry", 300);
  set_skill("force", 300);
  set_skill("lotusforce", 300);
  set_skill("staff", 300);
  set_skill("lunhui-zhang", 300);
  set_skill("spear", 300);
  set_skill("huoyun-qiang", 300);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "lunhui-zhang");
  map_skill("staff", "lunhui-zhang");
  map_skill("spear", "huoyun-qiang");

  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: cast_spell, "bighammer" :),
  }));

  set("max_force", 5000);
  set("force", 10000);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 110);
  set("force_factor", 110);
  set("max_kee", 6000);
  set("max_gin", 6000);
  set("max_sen", 6000);
  create_family("南海普陀山", 2, "弟子");

  setup();
  carry_object("/obj/loginload/skirt")->wear();
}


void kill_ob(object me) {
  object ob = this_object();
  if (!present(me, environment())) {
    ob->delete_temp("my_killer");
    return;
  }

  if (me->is_ghost() || !userp(me)) {
    ob->delete_temp("my_killer");
    return;
  }

  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: cast_spell, "bighammer" :),
  }));
  ::kill_ob(me);
}

void die() {
  object me = query_temp("last_opponent");
  object ob = this_object();
  object sheli;
  object liuli;

  if (me->query("newborn/two_bailiuli")) {
    message_vision("$n说道：不打了，我也只是玩玩嘛，舍利还你就是了。\n", me, ob);
    sheli = new("/d/newborn/two/obj/sheli");
    sheli->set("owner", me->query("id"));
    sheli->move(me);
    command("say 我原是天上琉璃盏掉于下界的碎片，既然你能打败我，我就跟着你吧,希望你能将我交于卷帘大将。\n");
    message_vision(HIW "$n浑身发出一阵白光，化做一块白色琉璃碎片，飞入$N的手中。\n" NOR, me, ob);
    liuli = new("/d/newborn/three/obj/bai");
    liuli->set("owner", me->query("id"));
    liuli->move(me);
    me->set("newborn/two_sheli_get", 1);
    me->set("newborn/three_bai", "done");
    me->delete("newborn/two_bailiuli");
  }
  destruct(this_object());
  ::die();
  return 0;
}


void unconcious() {
  die();
}
