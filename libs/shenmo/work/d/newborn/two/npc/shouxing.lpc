void create()
{
        set_name("寿星", ({"shou xing", "xing"}));
	set("title", "蓬莱三老");
	set("gender", "男性");
	set("long", "霄汉中间一老人，手捧灵芝飞蔼绣。葫芦藏蓄万年丹，宝篆名书千纪寿。
洞里乾坤任自由，壶中日月随成就。遨游四海任清闲，散淡十洲容福胄。
曾赴蟠桃醉几遭，醒时名月还依旧。长头大耳短身躯，南极之方称老寿。\n");
        set("attitude", "peaceful");
        set("combat_exp", 800000);
	set("daoxing", 1500000);

	create_family("五庄观", 2, "弟子");
	set("age", 80);
	set("per", 100);
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("cps", 30);
        set("con", 30);
	set("class", "xian");
	set("rank_info/respect", "老寿星");
	set("max_kee", 1000);
	set("max_sen", 1000);
	set("force", 800);
	set("max_force", 800);
	set("force_factor", 50);
	set("max_mana", 800);
	set("mana", 800);
	set("mana_factor", 50);
	
	set_skill("spells", 120);
	set_skill("taiyi", 120);
	set_skill("force",120);
	set_skill("zhenyuan-force",120);
	set_skill("parry", 120);
	set_skill("dodge", 120);
	set_skill("baguazhen", 120);
	set_skill("unarmed", 120);
	set_skill("wuxing-quan", 120);
	set_skill("staff",110);
	set_skill("fumo-zhang",120);

	map_skill("spells", "taiyi");
	map_skill("force", "zhenyuan-force");
	map_skill("dodge", "baguazhen");
	map_skill("unarmed", "wuxing-quan");
	map_skill("staff", "fumo-zhang");
	map_skill("parry", "fumo-zhang");

        set("inquiry", ([
		"火枣"     : "我没那玩意，去问问老福星吧！\n",
		"交梨"     : "我没那玩意，去问问老禄星吧！\n",
                "name"     : "老夫寿星是也。\n",
                "here"     : "此乃蓬莱仙岛也。\n",
                "下棋"     : "你个臭棋篓子，谁要跟你下棋！\n",
                "围棋"     : "连围棋都不知道？\n",
                "碧藕"     : (: ask_me :),
                "烦恼"     : (: ask_fannao :),
        ]));

	setup();
	carry_object("/d/obj/cloth/baipao")->wear();	
	carry_object("/d/penglai/npc/obj/guai")->wield();
	
	// mon 7/19/98
        // first fruit generated after the xing refresh
        // for a while.
        set("time", 0);
        call_out("reg", 1500+random(500));

}

string ask_me()
{
        object ob;
	        
	if((int)this_player()->query("combat_exp") < 50000 )
		return "没见老夫正下棋呢吗，以后再说吧！\n";

	// added by snowcat on 6/22/1997
	if (this_object()->is_fighting())
		return "没见老夫正打着吗，以后再说吧！\n";

	if ( present("bi ou", this_player()) )
		return "吃，吃，吃，胖的都象猪了！\n";

        if ( present("bi ou", environment()) )
		return "那不是有一块呢嘛，吃完再说！\n";

        if (query("last_winner") == this_player()->query("id") &&
            random(5)) {
                set("noask",1);
            	call_out("ref2", 20);
                return "不巧，不巧，我也没了！\n";
        }        
                                    
	if(query("time") <1 || query("noask"))
		return "不巧，不巧，我也没了！\n";

		say("寿星说道：那到要瞧你够不够格吃了，放马过来吧！\n");
		this_player()->set_temp("shouxing_fight", 1);
		return ("嘿嘿！\n");
}


int accept_fight(object who)
{
  	object me;
 	me = this_object();
  	if (!who->query_temp("shouxing_fight")){
		command("say 不打不打，没见老夫正下棋呢吗！\n");
    		return 0;
	}
	// added by snowcat on 6/22/1997
	if (me->is_fighting()){
		command("say 不打不打!\n");
		return 0;
	}
	say("寿星笑道：老头子活了几千年，谁也不怕！\n");
	me->set("eff_kee", (int)me->query("max_kee"));
        me->set("kee", (int)me->query("max_kee"));
        me->set("eff_sen", (int)me->query("max_sen"));
        me->set("sen", (int)me->query("max_sen"));

  	who->set_temp("shouxing_fight",0);
  	remove_call_out("check_fight");
  	call_out("check_fight", 1, me, who);
  	return 1;
}

void player_win (object me, object who)
{	
	object obj;
	// added by snowcat on 6/22/1997
	if (me->query("time")<=0)
	        return;
	obj = new("/d/obj/drug/biou");
	command("sigh");	
	say("寿星叹了一口气：年纪大了，到底气力还是不济！\n");
	say("寿星说道：当真是英雄倍出，我辈老矣！\n");
	obj->move(who);
        me->add("time", -1);
        message_vision("寿星对$N哈哈笑道：深感法力，无物可以表敬，特具碧藕一枚，笑纳！\n", who);
        me->set("last_winner",who->query("id"));
	call_out("reg", 500+random(500));
}
int ref2()
{
	object me, obj;
	me=this_object();
	me->set("noask", 0);
}	
int reg()
{
	object me, obj;
	me=this_object();
	me->set("time", 1);
//add a weapon in case anyone took it.
	if(!me->query_temp("weapon")){
		obj=new("/d/obj/weapon/staff/shugan");
		obj->move(me);
		command("wield all");
	}
	return 1;
}
void player_lose (object me, object who)
{
  	string msg;
  	msg = RANK_D->query_respect(who);
	
	command("jump");
	say("寿星哈哈大笑："+msg+"莫要不高兴，回去好好练武吧，来日方长嘛！\n");
}
void check_fight (object me, object who)
{
  	int my_kee, whos_kee;
  	int my_max_kee, whos_max_kee;

	if(!who) return;
  	my_kee = me->query("kee");
  	whos_kee = who->query("kee");
  	my_max_kee = me->query("max_kee");
  	whos_max_kee = who->query("max_kee");

  	if (me->is_fighting()){
    		remove_call_out("check_fight");
    		call_out ("check_fight",1,me,who);
    		return;
  	}

  	if (!present(who, environment(me)))
    		return;
	
	// changed by snowcat on 6/24/1997
	// bug abuse: player can exert recover when fight stops,
	//if ((my_kee*100/my_max_kee) <=(whos_kee*100/whos_max_kee) )
	//      player_win (me, who);
	//else player_lose (me, who);
	if ((my_kee*100/my_max_kee) <= 50)
		player_win (me, who);
	else if ((whos_kee*100/whos_max_kee) <= 50)
		player_lose (me, who);

}

void die()
{

        if( environment() ) {
        message("sound", "\n\n只听一声鹤鸣，寿星化作一道白光向天上直冲而去。。。\n\n
半空中有人哈哈笑了几声。。。\n\n", environment());
        }

        destruct(this_object());
}

void attempt_apprentice(object ob)
{
	if( (string)ob->query("family/family_name")=="五庄观" )
	{
		if( (int)ob->query("family/generation") < 3  )
		{
			command("say 不敢当，不敢当。\n");
		}
		else if( (int)ob->query("family/generation") ==3  )
		{
			command("say 呵呵，是" + ob->query("family/master_name") + "老头的徒弟，那我就不客气了。\n");
			command("recruit " + ob->query("id") );
		}
		else 
		{
			if( ob->query_skill("taiyi", 1) >= 80 )
			{
				command("say 好，有出息，这个徒弟我收下了。\n");
				command("recruit " + ob->query("id") );
			}
			else
			{
				command("say 我们仙家最看重仙法，你还得在这方面下苦功。\n");
			}
		}
	}

	else
	{
		command("say 好，不过你还是先找八仙他们练一些入门的功夫吧。\n");
	}

	return;
}

int recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
		ob->set("class", "xian");
}

int ask_fannao()
{   
    object me=this_player();
    object bailu,where;

    if (me->query("newborn/one")!="done") {command("say 只怕以你的能力无法解除我的烦恼。\n");return 1;}
    if (me->query("newborn/two_bailu")=="done") {command("say 多谢你帮我把白鹿找回来了。\n");command("thank");return 1;}   
    if (query("no_bailu")) {command("say 已经有人帮我解决烦恼了。\n");return 1;}

    command("sigh1");
    command("say 我几千年来一直陪伴着我的坐骑--白鹿，竟然无故失踪了，不知道你能否帮我找回来。\n");
    command("say 年纪大了就是不行，我也不知道把它扔哪了,唉。\n");
    command("say 如果你找到它了，就把它骑回来吧。\n");
    me->set("newborn/two_xianweng",1);

    bailu=me->query_temp("bailu");

    if (bailu){
    where = environment(bailu); 
    if (where) destruct(bailu);
    }

//    if (is_living(bailu)) destruct(bailu); 

    bailu=new("/d/newborn/two/npc/bailu");
    bailu->set("find",me->query("id"));
    random_place(bailu, dirs);
    me->set_temp("bailu",bailu); 

    return 1;

}

void init() 
{
   object ob = this_object(); 
   object me = this_player(); 
   object bailu;
   bailu= me->query_temp("ridee"); 
   
   if (!bailu) return;

   if (bailu->query("id")=="bai lu"&&me->query("newborn/two_xianweng")&&bailu->query("find")==me->query("id")){
      command("pat bai lu");
      command("say 我的好宝贝啊，你总算回来了。\n");
      command("say 多亏你帮我找回白鹿，不然我还不知道上哪找呢。\n");
      command("say 真是辛苦你了，我听观音大士说你奉命找寻天命取经人是吧，我这里可以告诉你点消息。\n");
      command("say 依老夫看来，金山寺的玄奘法师命格奇特，或许他就是你要找寻的天命取经人。\n");
      command("say 天机不可泄露，老夫也不能透露太多，你这就去金山寺看看吧。");
      destruct(bailu);
      me->set("newborn/two_bailu","done");
      me->delete("newborn/two_xianweng");
      set("no_bailu", 1); 
      call_out("regenerate", 300); 

      return;
      }
        
   return;
}    

int regenerate() 
{
  set("no_bailu", 0); 
  return 1; 
 } 

int random_place(object me, string* dirs)
{
        int  i, j, k;
        object  newob;
        mixed*  file, exit;

        if( !sizeof(dirs) )  return 1;

        i = random(sizeof(dirs));    // pick up one directory

        file = get_dir( dirs[i]+"/*.lpc", -1 );
        if( !sizeof(file) )             return 1;

	for(k=0;k<30;k++) { // try 20 times
           j = random(sizeof(file));
           if( file[j][1] > 0 ) {
             newob=load_object(dirs[i]+"/"+file[j][0]);
             if (newob) {  
               if(newob->query("no_fight") ||
		       newob->query("no_magic") ||
		       newob->query("no_mieyao") ||
		       !(exit=newob->query("exits")) ||
		       sizeof(exit)<1)
		   continue;

               if(me->move(newob)) {
		   message_vision("$N走了过来。\n",me);
		   return 1;
	       }
	     }
	   }
	}

        return 0;
}


