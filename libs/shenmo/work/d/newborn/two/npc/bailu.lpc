#include <ansi.h>
inherit "/d/sea/npc/beast/beast.lpc";

void create() {
  set_name(HIW "白鹿" NOR, ({ "bai lu", "lu" }));
  set("under_water", 1);

  set("long", "南极仙翁的坐骑。\n");
  set("race", "野兽");
  set("age", 10);
  set("age", 30);
  set("combat_exp", 2000000);
  set("daoxing", 1000000);
  set("unarmed", 500);
  set("dodge", 500);
  set("parry", 500);
  set("max_kee", 5000);
  set("max_sen", 5000);

  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "bite" }));
  set("ride/need_train", 1);
  set("ride/msg", "骑");
  set("ride/dodge", 35);
  set_temp("apply/attack", 100);
  set_temp("apply/armor", 100);

  setup();
}
