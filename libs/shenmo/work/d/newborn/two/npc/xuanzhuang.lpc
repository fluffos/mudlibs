#include <ansi.h>

inherit NPC;
int ask_faming();
int ask_sheli();
int ask_shenshi();
int check(object me);

void create() {
  set_name("玄奘", ({ "xuan zhuang", "monk", }));
  set("long",
    "玄奘乃金山寺的方丈空慈之徒，其身世不详。\n");
  set("title", "金山寺弟子");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 20);
  set("per", 30);
  set("max_kee", 900);
  set("max_sen", 600);
  set("force", 500);
  set("max_force", 500);
  set("force_factor", 40);
  set("max_mana", 500);
  set("mana", 900);
  set("mana_factor", 30);
  set("combat_exp", 200000);
  set("daoxing", 200000);
  set("shen_type", 1);

  set("eff_dx", 90000);
  set("nkgain", 300);


  set_skill("force", 90);
  set_skill("unarmed", 90);
  set_skill("dodge", 90);
  set_skill("jienan-zhi", 90);
  set_skill("parry", 90);
  set_skill("spells", 90);
  set_skill("buddhism", 90);
  map_skill("unarmed", "jienan-zhi");
  map_skill("spells", "buddhism");
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: cast_spell, "bighammer" :),
  }));
  set("inquiry", ([
  ]));
  set("count", 1);
  setup();
  carry_object("/d/obj/cloth/monkcloth")->wear();

}



int accept_object(object me, object ob) {
  string thing = (string)ob->query("id");

  if (ob->query("id") != "yin`s xue shu" || !me->query("newborn/two_book")) {
    command("shake"); return 0;
  }
  if (ob->query("owner") != me->query("id")) { command("say 血腥味太重，不知道施主为何于贫僧此物？\n"); return 0; }

  message_vision("玄奘接过血书，细细看过一遍，突然长哭一声，随即发起疯来。\n", me);
  message_vision("$N心中大骇：这该如何是好，玄奘发疯了还怎么让他去西天取经啊！！\n", me);
  set_name("发疯的玄奘", ({ "crazy xuan zhuang", "monk", }));
  me->delete("newborn/two_book");
  me->set("newborn/two_crazy", 1);
  return 1;

}

void init() {
  object who = this_object();
  object me = this_player();

  ::init();
  if (me->query("newborn/two_crazy") || me->query("id") == "yin wenjiao") {
    who->set_name("发疯的玄奘", ({ "crazy xuan zhuang", "monk", }));
  } else who->set_name("玄奘", ({ "xuan zhuang", "monk", }));

  if (me->query("id") == "yin wenjiao") call_out("check", 1, me);

}

int check(object me) {
  me = this_player();
  if (me->query("newborn/two") == "done") {
    destruct(this_object());
    return 1;
  }
  call_out("check", 1, me);
  return 1;
}
