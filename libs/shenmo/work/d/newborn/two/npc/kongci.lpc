 
inherit NPC;
int ask_faming();
int ask_sheli();
int ask_shenshi();

void create()
{
        set_name("空慈", ({"kong ci","monk", "kongci","fangzhang"}));
        set("long",
                "空慈乃金山寺的方丈，神色庄重，举止间自有一番威仪。\n");
   set("title", "金山寺方丈");
        set("gender", "男性");
        set("attitude", "friendly");
        set("class", "bonze");

        set("age", 55);
        set("per", 23);
        set("max_kee", 900);
        set("max_sen", 600);
        set("force", 500);
        set("max_force", 500);
        set("force_factor", 40);
        set("max_mana", 500);
        set("mana", 900);
        set("mana_factor", 30);
        set("combat_exp", 200000);
	set("daoxing",200000);	
        set("shen_type", 1);

        set("eff_dx", 90000);
        set("nkgain", 300);


        set_skill("force", 90);
        set_skill("unarmed", 90);
        set_skill("dodge", 90);
        set_skill("jienan-zhi", 90);
        set_skill("parry", 90);
        set_skill("spells", 90);
        set_skill("buddhism", 90);
        map_skill("unarmed", "jienan-zhi");
        map_skill("spells", "buddhism");
        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                (: cast_spell, "bighammer" :),
        }) );
        set("inquiry", ([
                "法明": (: ask_faming :),
                "华光舍利子": (: ask_sheli :),
                "身世": (: ask_shenshi :),
                ]));
        set("count",1);
        setup();
        carry_object("/d/obj/cloth/monkcloth")->wear();

}

        
int ask_faming()
{
  object me=this_player();
  if ( me->query("newborn/two_faming_cureed") ) {command("say 多谢施主救活老衲师弟，施主之恩本寺没齿难忘，阿弥陀佛。\n");return 1;}

     command("sigh");
     command("say 几天前，有位名为白琉璃的女施主前来盗取本寺至宝---华光舍利子，却被我师弟法明发现。\n");
     command("say 法明师弟奋身力阻，岂知那女施主武功高强，两掌将我师弟打伤，盗走华光舍利子。\n");
     command("say 此后，师弟伤势过重，一直昏迷不醒，只有长安城的华佗老仙方可医治。\n");
     command("say 不知施主能否帮老夫请来华佗老仙为法明师弟医治。\n");
     me->set("newborn/two_faming_cure",1);
     return 1;
}

int ask_sheli()
{
   object me=this_player();
   if (!me->query("newborn/two_faming_cureed")||me->query("newborn/two_sheli_get")) {command("say 法明师弟就是为了保护舍利子才被那女施主打伤的。\n");return 1;}

   command("say 施主实在好本事，不知可否为本寺取回华光舍利子？\n");
   command("say 法明师弟昏迷前曾说过，白琉璃女施主往南天门方向去了，或许你可以在那找到线索。\n");
   me->set("newborn/two_sheli",1);
   return 1;
}

int accept_object(object me, object ob)
{
  string thing=(string)ob->query("id");

     if (ob->query("id") != "huaguang shelizi"||!me->query("newborn/two_sheli_get")) {command("shake");return 1;}
     if (ob->query("owner")!=me->query("id")) {command("say 你哪偷来的？\n");return 1;}

     command("touchy");
     command("say 多谢施主为本寺寻得华光舍利子，如施主有何要求，老衲定舍身相助。\n");
     me->delete("newborn/two_sheli_get");
     me->delete("newborn/two_sheli");
     me->delete("newborn/two_bailiuli");
     me->set("newborn/two_jinshansi","done");
         return 1;

}

int ask_shenshi()
{
    object me=this_player();
    object ob=this_object();
    object book;

    if (me->query("newborn/two_jinshansi")!="done") {command("shake");return 1;}

    command("say 你想知道玄奘的身世？？\n");
    command("sigh");
    command("say 玄奘之父陈光蕊到江州赴任途中，遭到刘洪、李彪杀害，尸首沉入河中，其母殷温娇被刘洪霸占为妻。\n");
    command("say 玄奘被其母放入河中，得以逃过一劫。老衲于因缘巧合之下，将他救起并收为弟子。\n");
    command("say 至今，老衲尚不敢对玄奘说明他的身世。这就是当年他母亲放在他身上的血书，恩公请看。\n");
    book=new("/d/newborn/two/obj/book");
    book->set("owner",me->query("id"));
    book->move(me);
    me->set("newborn/two_book",1);
    return 1;
}







