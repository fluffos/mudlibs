//shenyi.c 华佗老仙

#include <ansi.h>
inherit NPC;
int ask_cure();

void create()
{
        set_name(HIW"华佗老仙"NOR, ({"master huatuo", "master"}));
       set("long", "救世济人的神仙。\n");
       set("title", HIC"救世济人"NOR);
       set("per", 40);
       set("gender", "男性");
       set("age", 1000);
        set("attitude", "peaceful");

        set("combat_exp", 20000000);
        set("daoxing", 500000);
        set("shen_type", 1);
        set("max_kee", 2000);
        set("max_gin", 1000);
        set("max_sen", 2000);
	set("max_force", 8888);
	set("force", 8888);
        set("max_mana", 8888);
	set("mana", 8888);
	set("force_factor", 200);
        set_skill("medical", 800);

        set("inquiry", ([
	"name"     : "老夫乃一介布衣，。\n",
	"here"     : "此乃济世堂，专给天下苍生治病的地方．\n",
	"治病"     : (: ask_cure :),
	]));
	setup();
        carry_object("/d/obj/cloth/linen")->wear();
}

int recognize_apprentice(object ob)
{ob=this_player();
if ((int)ob->query("level") < 5 ) {
        command("say 你的等级不够5级，" + RANK_D->query_respect(ob) + "还需多加努力。\n");
	return 1;
	}
	return 1;
}

int ask_cure()
{
   object me=this_player();
   object ob=this_object();

     if (!me->query("newborn/two_faming_cure")) {command("say 本医年迈，恐怕无法为施主排除病痛，还请施主另请高明。\n");return 1;}
   
     message_vision("$N将金山寺中发生之事告知$n,$n大怒：竟有此事，法明长老当年对老夫有大恩，岂可见死不救，请速带老夫前去。\n",me,ob);
     command("follow "+me->query("id"));
     return 1;
}

int init() 
{
   object ob = this_object(); 
   object me = query_leader(); 
    
   if (!me) return 0;
   if (present("fa ming",environment(ob)) && me->query("newborn/two_faming_cure") && !me->query("newborn/two_cfy1_get")) {
       message_vision("$n一见法明长老，急忙上去，仔细为法明诊断了一番。\n",me,ob);
       message_vision("$n面色凝重，缓缓起身，长叹一口气，说道：法明长老伤势极重，不过倒不至于无法可以救，只是...\n",me,ob);
       message_vision("$n又长叹了一口气：只是药方需以 餐风饮露 加与调配方可制成。\n",me,ob);
       command("say 而此餐风饮露唯有地上神木，配以百年露水洗礼，当蕴足天地精华之时，方才滴落，化为结晶。\n");
       command("say 此结晶百年间仅出一颗，极为珍贵，甚是难求，这下，不知该去何处找寻。\n");
       message_vision("$N甫闻$n所言，不由眉头一皱，忽然灵光一闪：或许五庄观的人参果树上会有此物。\n",me,ob);
       message_vision("$N说道，这事就交与我试试，说不定可以寻得。\n",me);
       me->set("newborn/two_cfyl",1);
       command("follow kong ci");
      }
   return 1;
}    

int accept_object(object me, object ob)
{
  string thing=(string)ob->query("id");

     if (ob->query("id") != "can feng yin lu"||!me->query("newborn/two_cfy1_get")||!present("fa ming",environment(me))) {command("shake");return 1;}
     if (ob->query("owner")!=me->query("id")) {command("say 你打哪偷来的？\n");return 1;}

         message_vision("$n仔细一看：正是这东西，我赶紧配药吧。\n",me,this_object());
         message_vision("只见$n忙了一阵，撬开法明牙关，将还魂露滴了进去。\n",me,this_object());
         command("sweat");
         command("say 好了，休息一阵子就行了，我先走一步。\n");
         me->delete("newborn/two_bailu");
         me->set("newborn/two_faming_cureed",1);
         me->delete("newborn/two_faming_cure");  
         me->delete("newborn/two_cfyl");
         call_out("dest",3,this_object());
         return 1;

}

void dest(object ob)
{
  destruct(ob);
  return;
}
