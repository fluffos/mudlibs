//Cracked by Roath

inherit NPC;
#include <ansi.h>
int ask_chen();
int ask_xuan();
int check(object me);

void create() {
  set_name("殷温娇", ({ "yin wenjiao", "yin", "wenjiao" }));
  set("long", "殷夫人乃是殷开山之女，玄奘之母。\n");
  set("title", "御赐贤夫人");
  set("gender", "女性");
  set("age", 50);
  set("per", 35);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 10000);
  set("daoxing", 10000);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_skill("parry", 40);
  set_skill("force", 40);
  set_skill("spells", 40);
  set("max_gin", 300);
  set("max_kee", 300);
  set("max_sen", 300);
  set("max_force", 300);
  set("max_mana", 300);
  set("force_factor", 5);
  set("inquiry", ([
    "陈光蕊": (: ask_chen :),
    "儿子": (: ask_xuan :),
  ]));
  setup();
  carry_object("/d/obj/cloth/skirt")->wear();
  carry_object("/d/obj/cloth/shoes")->wear();
  carry_object("/d/longzhu/obj/jingshi5");
}

int ask_chen() {
  object ob = this_player();
  //by dragon 判断是否dntg over for laojunlu is the last one of dntg
  if (ob->query("obstacle/jz") == "done")
    return notify_fail("他是我丈夫。");

  if (present("liu hong", environment()))
    return notify_fail("这个.......");

  command("cry1");
  ob->set_temp("obstacle/jz_yin_asked", 1);
  command("say 我好命苦啊，丈夫和儿子都死了。");
  return 1;

}

int accept_object(object who, object ob) {
  who = this_player();

  if (who->query("obstacle/jz") == "done")
    return 1;

  if (!who->query_temp("obstacle/jz_yin_asked"))
    return 1;

  if (ob->query("id") == "xue shu" || ob->query("id") == "han shan") {
    command("ah");
    command("nocry");
    command("say 你是从哪拿来的？我儿现在怎么样了。\n");
    tell_room(environment(this_object()), HIR "忽然刘洪，李彪闯了进来。\n" NOR);
    who->set_temp("obstacle/jz_given", 1);
    call_out("liuhong_appear", 1, who);
    return 1;
  }
}

void liuhong_appear(object who) {
  object liuhong = new("/d/jz/npc/liuhong");
  object libiao = new("/d/jz/npc/libiao");
  liuhong->set_temp("my_killer", who);
  libiao->set_temp("my_killer", who);
  liuhong->move(environment(this_object()));
  libiao->move(environment(this_object()));

  liuhong->kill_ob(who);
  libiao->kill_ob(who);
}

int ask_xuan() {
  object me = this_player();
  object ob = this_object();
  object zhuangwen;

  if (me->query("newborn/two") == "done") { command("say 老身在此叩谢恩公。\n"); return 1; }
  if (!me->query("newborn/two_crazy")) { command("shake"); return 1; }
  if (me->query("newborn/two_gao")) { command("say 烦请恩公为先夫申冤。\n"); return 1; }

  if (me->query("newborn/two_chen") == "done") {
    command("say 多谢恩公为先夫申冤，刘洪李彪现已伏法。这下就麻烦恩公带老身去找儿子吧。\n");
    command("follow " + me->query("id"));
    call_out("check", 1, me);
    return 1;
  }
  message_vision("$n对$N道尽当年往事，悲叹夫君冤屈不得解，儿子失散之苦。\n", me, ob);
  message_vision("$N将玄奘之事告知$n。$n不由得老泪纵横，挥笔写下状文，乞求$N上奏皇帝，以申其夫之冤。\n", me, ob);
  zhuangwen = new("/d/newborn/two/obj/zhuangwen");
  zhuangwen->move(me);
  me->set("newborn/two_gao", 1);
  return 1;
}

init() {
  object me = this_player();
  object who = this_object();

  ::init();

  if (present("crazy xuan zhuang", environment(me)) && me->query("newborn/two_chen") == "done") {
    message_vision("$n一见到玄奘,眼泪不由得淌了下来，大叫一声：我的儿啊....，上去一把抱住玄奘。\n", me, who);
    message_vision("玄奘呆呆的看着$n，感到一滴滴热泪不住的滴在手上，浑身一颤，呆滞的目光逐渐恢复清明。\n", me, who);
    me->delete("newborn/two_crazy");
    message_vision("玄奘一把抱住殷温娇,母子俩抱头痛哭。\n", me, who);
    message_vision("好一阵子，两人渐渐平息下来，殷温娇拉着玄奘说道：快谢谢恩公，是他搭救了娘亲，又帮你父亲申了冤。\n", me, who);
    message_vision("玄奘跪了下来，连磕了三个响头，对$N说道，恩公之情，小僧无以为报，若恩公有何困处，小僧定鼎力相助。\n", me, who);
    message_vision("$N缓缓将观音大士的话对玄奘说了一遍。\n", me, who);
    message_vision("玄奘思量了一会，对殷温娇说道：娘亲，孩儿决定遵照观音大士之命，前往西天求取真经，以救天下百姓，请恕孩儿不孝。\n", me, who);
    message_vision("说罢，又对着殷温娇磕了三个响头。殷温娇摸着玄奘的头，道：孩儿就放心的去吧，娘亲自有着落。\n", me, who);
    message_vision("玄奘起身，对$N一楫：小僧愿前往西天求取真经，在此多谢施主了。小僧禀明皇上后即刻动身。\n", me, who);
    message_vision("玄奘将殷温娇扶入内堂休息去了。\n", me, who);
    me->set("newborn/two", "done");
    who->set("newborn/two", "done");
    message(
      "chat",
      HIY + "【西天取经】" NOR + HIW "三天之后，玄奘于唐太宗殿前讲法，并欲往西天求取真经，以救天下百姓于苦难之中。\n" NOR,
      users()
    );
    message("chat", HIY + "【西天取经】" NOR + HIW "此时，观音大士亲临，赐五彩锦阑袈裟一件，众人拜倒以告仙恩。\n" NOR, users());
    message("chat", HIY + "【西天取经】" NOR + HIW "于是，玄奘在唐太宗送别之下，踏上了求取真经的路途......\n\n" NOR, users());
    message(
      "chat",
      HIY + "【轮回转世】楚恋依(Chu lianyi):" + HIW + me->name() + HIY "寻得一位天命取经人---玄奘，人间界的希望即将来临。\n\n" NOR,
      users()
    );
    call_out("dest", 5, me);
  }

}

void dest(object me) {
  destruct(this_object());
}
