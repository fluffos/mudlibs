#include <ansi.h>
inherit NPC;
inherit F_MASTER; 
 
int ask_mimi(object me);
int accept_object(object me, object ob);

void create()
{
          set_name("楚恋依", ({ "chu lianyi","chu"}) );
        set("gender", "女性" );
        set("age",20);
        set("attitude", "heroism");
        set("str",40);
        set("int",50);
        set("max_kee",3000);
        set("kee",3000);
        set("per",30);
        set("max_sen",3000);
        set("sen",3000);
        set("combat_exp",800000);
        set("daoxing",500000);
        set("force",2000);
        set("max_force",1000);
        set("mana",2000);
        set("max_mana",1000);
        set("force_factor", 50);
        set("mana_factor",50);
        set_skill("unarmed",80);
        set_skill("parry",80);
        set_skill("dodge",80);
        set_skill("force",80);
        set_skill("literate",150);
        set_skill("power",80);
        set_skill("spells", 80);
        set("inquiry", ([
                "name" : "",
                        ]) );
        set("inquiry", ([
                "秘密" : (: ask_mimi :),
                ]) );
       set("chat_msg", ({ 
        "楚恋依幽幽吟道：汴水流，泗水流，流到瓜洲古渡头，吴山点点愁，思悠悠，恨悠悠，恨到归时方始休。月明人倚楼。\n",
        })); 
              setup();
        carry_object("/obj/loginload/skirt")->wear();
}

int ask_mimi(object me) 
{ 
           object who=this_player();
           if (who->query("newborn/one")=="done")
               {
                 command("say 你任务还没完成吗？\n");
                 command("say 如今已无他法，此大任唯有你能担当了。\n");
                 return 1;
               }
           command("say 这秘密不知是一切的开始抑或是一切的归结，唉，罢了，人世间总是有这么多的矛盾。\n");
           command("say 花果山上有一朵永不枯萎的金莲花，如果你能够将它带来给我，我就将此秘密告知与你。\n"NOR); 
           who->set("newborn/one_jinlianhua",1);
           return 1;
} 

int accept_object(object me, object ob)
{
  string thing=(string)ob->query("id");

     if (ob->query("id") != "jin lian hua"||!me->query("newborn/one_jinlianhua")) {command("shake");return 1;}
     if (ob->query("owner")!=me->query("id")) {command("say 你哪偷来的莲花？\n");return 1;}

         command("sigh");
         command("say 永不枯萎的金莲花亦已枯萎，这世上还有什么能够永恒的？\n");
         command("say 其实我乃观音化身，与此是为了助人界间解除千年来的磨难。现在，我就将秘密告知与你。\n");
         command("say 三界圣战之后，心魔肆虐，尘世中人性的莲花已经枯萎。而我佛如来处有三藏真经，可以劝人为善。\n现欲广募与佛有缘之士，遍大义于天下，寻找五个天命取经人。而你既然有此金莲缘结，今后在四大\n部洲游历的同时就被赋予了寻找五人，帮他们拂开尘眼，见性归真的使命...\n");
         command("say 到你完成此重责大任之时再到普托山来找我吧。\n");
         me->delete("newborn/one_jinlianhua");
         me->set("newborn/one","done");
         message("chat",HIY+"\n\n【轮回转世】楚恋依(Chu lianyi):"+HIW+me->name()+HIY"身具金莲缘结,现受命找寻天命取经人，以救人间万千苦难人。\n\n"NOR,users());  
         return 1;

}

