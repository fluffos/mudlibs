#include <ansi.h>
inherit NPC;
inherit F_MASTER; 
 
int ask_lianhua(object me);
int accept_object(object me, object ob);

void create()
{
          set_name("莲花", ({ "lian hua"}) );
        set("gender", "女性" );
        set("title","樵夫之女");
        set("age",15);
        set("attitude", "heroism");
        set("str",40);
        set("int",50);
        set("max_kee",3000);
        set("kee",3000);
        set("per",30);
        set("max_sen",3000);
        set("sen",3000);
        set("combat_exp",800000);
        set("daoxing",500000);
        set("force",2000);
        set("max_force",1000);
        set("mana",2000);
        set("max_mana",1000);
        set("force_factor", 50);
        set("mana_factor",50);
        set_skill("unarmed",80);
        set_skill("parry",80);
        set_skill("dodge",80);
        set_skill("force",80);
        set_skill("literate",150);
        set_skill("power",80);
        set_skill("spells", 80);
        set("inquiry", ([
                "name" : "",
                        ]) );
        set("inquiry", ([
                "莲花" : (: ask_lianhua :),
                ]) );
              setup();
        carry_object("/obj/loginload/skirt")->wear();
}

int ask_lianhua(object me) 
{ 
           object who=this_player();
           object seed;
           if (who->query("newborn/one")=="done") {command("say 莲花活过来了吗？\n");return 1;}
           if (query("no_jinlianhua")) {command("say 刚才有个人已经把莲花带走了，希望能够让花重新活过来。\n");return 1;} 

           if (!who->query("newborn/one_lei")) {command("say 这是我在花果山上带回来的花，可惜已经枯萎了，不知道怎样才能使它重新活过来？\n");return 1;}
           if (who->query("newborn/one_lianhua")) {
              command("say 你把花籽弄丢了？怎么这么不小心啊，你好象不大靠得住。我再给你一次机会吧。\n");
              seed=new("/d/newborn/one/obj/seed");
              seed->set("owner",who->query("id"));
              seed->move(who);
              who->set("newborn/one_lianhua",1);
              return 1;}
             
           command("say 多么漂亮的莲花，只可惜枯萎了，我试过了各种方法还是无法让它活过来。\n");
           command("say 不知道你有办法让这花重新活过来吗？\n"); 
           command("say 我这有个花籽，如果你能让它开花的话，我才能放心将莲花交付给你。\n");
           
           seed=new("/d/newborn/one/obj/seed");
           seed->set("owner",who->query("id"));
           seed->move(who);
           who->set("newborn/one_lianhua",1);
           return 1;
} 

int accept_object(object me, object ob)
{
  object lianhua;
  string thing=(string)ob->query("id");

     if (ob->query("id") != "lian hua") {command("shake");return 1;}
     if (ob->query("owner")!=me->query("id")) {command("? "+me->query("id"));command("say 这好象不是我交给你的花籽开的花啊！你是不是搞错了。\n");return 1;}

         command("say 你果然还是有点本事的，我也好放心将这花交托与你。\n");
         lianhua=new("/d/newborn/one/obj/jinlianhua");
         lianhua->set("owner",me->query("id"));
         lianhua->move(me);
         command("say 希望你能早日让花重新活过来，到时候记得来带我去看啊。\n");
         me->delete("newborn/one_lei");
         me->delete("newborn/one_lianhua");
         set("no_jinlianhua", 1); 
         call_out("regenerate", 300); 
         return 1;

}

int regenerate() 
{
  set("no_jinlianhua", 0); 
  return 1; 
 } 
