#include <ansi.h>
inherit NPC;
inherit F_MASTER; 
 
int ask_lianhua(object me);
int accept_object(object me, object ob);

void create()
{
          set_name("雷黑子", ({ "lei heizi","lei"}) );
        set("gender", "男性" );
        set("title","樵夫");
        set("age",40);
        set("attitude", "heroism");
        set("str",40);
        set("int",50);
        set("max_kee",3000);
        set("kee",3000);
        set("per",15);
        set("max_sen",3000);
        set("sen",3000);
        set("combat_exp",800000);
        set("daoxing",500000);
        set("force",2000);
        set("max_force",1000);
        set("mana",2000);
        set("max_mana",1000);
        set("force_factor", 50);
        set("mana_factor",50);
        set_skill("unarmed",80);
        set_skill("parry",80);
        set_skill("dodge",80);
        set_skill("force",80);
        set_skill("literate",150);
        set_skill("power",80);
        set_skill("spells", 80);
        set("inquiry", ([
                "name" : "",
                        ]) );
        set("inquiry", ([
                "莲花" : (: ask_lianhua :),
                ]) );
              setup();
        carry_object("/obj/loginload/linen")->wear();
}

int ask_lianhua(object me) 
{ 
           object who=this_player();
           if (!who->query("newborn/one_jinlianhua")) {command("?");return 1;}
           command("say 前几天我和小女无意中在这里发现了一朵好漂亮的莲花，可惜已经枯萎了。\n");
           command("say 但小女对那花的枯萎觉得非常难过，于是将它带回，想法设法希望能让花重新活过来。\n"); 
           command("say 估计是不成了，我这辈子还没见过那么漂亮的花，不知道它在盛开时能有多么的美丽，可惜啊。\n");
           command("sigh");
           who->set("newborn/one_lei",1);
           return 1;
} 

