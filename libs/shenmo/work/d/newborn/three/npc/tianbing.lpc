#include <ansi.h>
inherit NPC;

int ask_sha();

void create() {
  set_name("行刑天兵", ({ "tian bing", "bing" }));
  set("gender", "男性");
  set("age", 30);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 30);
  set("max_kee", 3100);
  set("kee", 3100);
  set("max_sen", 3100);
  set("sen", 3100);
  set("combat_exp", 3000000);
  set("daoxing", 3000000);
  set("force", 2500);
  set("max_force", 1500);
  set("mana", 2500);
  set("max_mana", 1600);
  set("force_factor", 120);
  set("mana_factor", 120);


  set("eff_dx", 1500000);
  set("nkgain", 800);


  set_skill("unarmed", 220);
  set_skill("yingzhaogong", 220);
  set_skill("parry", 220);
  set_skill("dodge", 220);
  set_skill("spear", 220);
  set_skill("bawang-qiang", 220);
  set_skill("force", 220);
  set_skill("spells", 220);
  set_skill("moshenbu", 220);
  map_skill("dodge", "moshenbu");
  map_skill("parry", "bawang-qiang");
  map_skill("spear", "bawang-qiang");
  map_skill("unarmed", "yingzhaogong");
  set("inquiry", ([
    "卷帘大将": (: ask_sha :),
  ]));

  setup();
  carry_object("/d/obj/weapon/spear/jinqiang")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/obj/armor/jinyipifeng")->wear();
  carry_object("/u/angell/obj/toukui")->wear();
}

int ask_sha() {
  object me = this_player();
  object ob = this_object();

  if (me->query("newborn/two") != "done") { command("heng"); return 1; }

  command("say 卷帘大将打碎王母娘娘心爱的琉璃盏，玉皇大帝下旨命吾在此流沙河将其万剑穿心。\n");
  command("say 时辰已到，无关人等请离开。\n");
  return 1;
}

void die() {
  object me = query_temp("last_opponent");
  object ob = this_object();

  if (me->query("newborn/two") == "done") {
    message_vision("\n$n眼见不敌，抽身而退，怒道：你竟然违抗玉帝旨意！看我禀告玉帝去。\n", me, ob);
    me->set("newborn/three_sha", 1);
  } else message_vision("$n惨叫一声，死了。\n", me, ob);

  destruct(this_object());
  ::die();
  return 0;
}


void unconcious() {
  die();
}

void init() {
  object who = this_object();
  object me = this_player();

  ::init();
  if (me->query("newborn/three_sha")) {
    if (living(who))
      destruct(who);
  }
}
