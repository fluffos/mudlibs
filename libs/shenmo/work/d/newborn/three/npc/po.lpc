#include <ansi.h> 
inherit NPC;
int ask_suer(); 
string *list=({"yg-qiankun","yg-jianmang","yg-jianzhang","yg-zxzx",
                "yg-ba","yg-jldl","yg-xueshan","yg-shushan","yg-kunlun","yg-putuo",
"yg-pansi","yg-moon","yg-hell","yg-wusheng","yg-shaolin","yg-swordman","yg-wudidong",
        });

void create()
{
  string dir;
  set_name("毗蓝婆", ({"pilan po", "po", "daogu"}));
  set("title", "道姑");
  set("gender", "女性");
  set("age", 58);
  set("per", 26);
  set("rank_info/respect", "菩萨");
  set("combat_exp", 1000000);
  set("daoxing", 1500000);

  set_skill("snowsword", 90);
  set_skill("sword", 90);
  set_skill("dragonfight", 90);
  set_skill("unarmed", 90);
  set_skill("dodge", 90);
  set_skill("parry", 90);
  set_skill("spells", 90);
  set_skill("dragonstep", 90);
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "dragonfight");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  set("max_gin", 900);
  set("max_kee", 900);
  set("max_sen", 900);
  set("force", 900);
  set("max_force", 900);
  set("mana", 900);
  set("max_mana", 900);
  set("force_factor", 90);
  set("inquiry", ([
     "粟粟儿" : (: ask_suer :),
      ]) );

  setup();
  carry_object("/d/obj/cloth/skirt")->wear();
}

int ask_suer() 
{ 
           object me=this_player();
           object ob=this_object();
           object yao=new("/d/newborn/three/npc/yhq/"+list[random(sizeof(list))]);
           int level=3;

           if (me->query("newborn/two")!="done") {command("?" + me->query("id"));return 1;} 
           if (!me->query("newborn/three_dajiu")) {command("shake");return 1;}            
           ob->command("xu");
           message_vision("$n凑到$N轻声地说：我听说盘丝洞的女妖昨天抓了一个女孩，\n不知道是不是你要找的那位粟粟儿。\n那位姑娘哭着只喊妈妈，真是可怜啊。。。\n",me,ob);
           ob->command("sigh2");
           me->set_temp("newborn/three_askpo",1);
/*
           message_vision("$N话音未落，就只见$n从洞里钻了出来。\n",ob,yao);
           message_vision("$N大喝一声：听闻有个小子擅闯我盘丝洞，还想救走我的猎物。。。\n"+BLINK+HIR+"$n拿命来吧！．．．"NOR" \n\n",yao,me);
         
           yao->copy_status(me, level);
           yao->move(environment(me));
           yao->kill_ob(me);
           me->kill_ob(yao);
*/
           return 1;
} 

void announce_success (object who)
{
  int i;

  if (who->query("combat_exp") < 10000)
    return;
  if (who->query("obstacle/pansi") == "done")
    return;
  if (who->query_temp("obstacle/pansi_killed") < 15)
    return;
  i = random(600);
  who->add("obstacle/number",1);
  who->set("obstacle/pansi","done");
  who->add("daoxing",i+4000);
  command("chat "+who->query("name")+"盘丝岭尽除蜘蛛精黄花观降服蜈蚣精！");
  command("chat "+who->query("name")+"顺利闯过西行又一关！");
  tell_object (who,"你赢得了"+chinese_number(4)+"年"+
               chinese_number(i/4)+"天"+
               chinese_number((i-(i/4)*4)*3)+"时辰的道行！\n");
  who->save();
}

