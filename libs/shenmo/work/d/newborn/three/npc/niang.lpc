#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int ask_nver();
int accept_object(object me, object ob);

void create() {
  set_name("粟粟娘", ({ "susu niang", "niang", "su" }));
  set("gender", "女性");
  set("age", 45);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 3000);
  set("kee", 3000);
  set("per", 20);
  set("max_sen", 3000);
  set("sen", 3000);
  set("combat_exp", 80000);
  set("daoxing", 50000);
  set("force", 1000);
  set("max_force", 1000);
  set("mana", 1000);
  set("max_mana", 1000);
  set("force_factor", 50);
  set("mana_factor", 50);
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_skill("dodge", 20);
  set_skill("force", 20);
  set_skill("literate", 150);
  set_skill("power", 20);
  set_skill("spells", 20);
  set("inquiry", ([
    "name": "",
  ]));
  set("inquiry", ([
    "女儿": (: ask_nver :),
  ]));
  set("chat_chance", 20);
  set("chat_msg", ({
    "粟粟娘不住的痛哭：我的女儿啊，谁能救救我的女儿啊。\n",
  }));
  setup();
  carry_object("/obj/loginload/skirt")->wear();
}

int ask_nver() {
  object me = this_player();
  object ob = this_object();

  if (me->query("newborn/two") != "done") { command("shake"); return 1; }
  if (me->query("newborn/three_dajiu")) { command("say 恩公有小女的消息了吗？\n"); return 1; }
  if (me->query("newborn/three_jin") == "done") { command("say 多谢恩公搭救小女，此恩老身永世不忘。\n"); return 1; }

  message_vision("$n不住悲泣：前些日子，我们这有好几个女孩子都突然失踪，听说是被盘丝洞的女妖抓去吃了。\n", me, ob);
  message_vision("$n一声痛哭：没想到，昨天晚上我的女儿粟粟儿也失踪了，看来也是被抓走了。我可怜的女儿啊。。。。\n", me, ob);
  message_vision("$N怒道：竟有此事，待我去盘丝洞问问，大娘你好生休息，我去去就来。\n", me, ob);
  me->set("newborn/three_dajiu", 1);
  return 1;
}
