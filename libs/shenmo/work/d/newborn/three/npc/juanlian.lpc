#include <ansi.h>
inherit NPC;

int ask_sha();
int ask_liuli();
int leave_jl(object ob);

void create() {
  set_name("卷帘大将", ({ "juanlian dajiang", "dajiang" }));
  set("gender", "男性");
  set("age", 30);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 30);
  set("max_kee", 3100);
  set("kee", 3100);
  set("max_sen", 3100);
  set("sen", 3100);
  set("combat_exp", 3000000);
  set("daoxing", 3000000);
  set("force", 2500);
  set("max_force", 1500);
  set("mana", 2500);
  set("max_mana", 1600);
  set("force_factor", 120);
  set("mana_factor", 120);


  set("eff_dx", 1500000);
  set("nkgain", 800);


  set_skill("unarmed", 220);
  set_skill("yingzhaogong", 220);
  set_skill("parry", 220);
  set_skill("dodge", 220);
  set_skill("spear", 220);
  set_skill("bawang-qiang", 220);
  set_skill("force", 220);
  set_skill("spells", 220);
  set_skill("moshenbu", 220);
  map_skill("dodge", "moshenbu");
  map_skill("parry", "bawang-qiang");
  map_skill("spear", "bawang-qiang");
  map_skill("unarmed", "yingzhaogong");
  set("inquiry", ([
    "琉璃": (: ask_liuli :),
  ]));

  setup();
  carry_object("/obj/loginload/linen")->wear();
}

int ask_liuli() {
  object me = this_player();
  object ob = this_object();

  if (!me->query("newborn/three_sha")) { command("?"); return 1; }

  command("say 吾失手将琉璃盏打碎，故被下令处死。\n");
  command("say 多谢你帮吾打退行刑天兵，但天庭是不会放过我的，除非我能找回掉落人间的四块琉璃盏碎片。\n");
  command("say 你能帮吾一同寻找吗？这样吾才能将功赎过，重回天庭。\n");
  me->set("newborn/three_liuli", 1);
  return 1;
}

int accept_object(object me, object ob) {
  string thing = (string)ob->query("id");
  string cnum;
  int num;

  if (ob->query("id") != "bai liuli" || ob->query("id") != "jin liuli" || ob->query("id") != "qing liuli" || ob->query("id") != "zi liuli" || !me->query("newborn/three_liuli") || ob->query("id") != "nver hong") {
    command("shake"); return 0;
  }

  if (ob->query("owner") != me->query("id")) { command("say 你哪偷来的？\n"); return 1; }

  if (ob->query("id") == "bai liuli") {
    command("nod");
    command("say 这正是琉璃盏碎片中的一块----白琉璃。\n");
    me->add("newborn/three_liuli_num", 1);
    me->delete("newborn/three_bai");
    num = me->query("newborn/three_liuli_num");
    command("thank " + me->query("id"));
  }

  if (ob->query("id") == "jin liuli") {
    command("nod");
    command("say 这正是琉璃盏碎片中的一块----金琉璃。\n");
    me->add("newborn/three_liuli_num", 1);
    me->delete("newborn/three_jin");
    num = me->query("newborn/three_liuli_num");
    command("thank " + me->query("id"));
  }

  if (ob->query("id") == "qing liuli") {
    command("nod");
    command("say 这正是琉璃盏碎片中的一块----青琉璃。\n");
    me->add("newborn/three_liuli_num", 1);
    me->delete("newborn/three_bai");
    num = me->query("newborn/three_liuli_num");
    command("thank " + me->query("id"));
  }

  if (ob->query("id") == "zi liuli") {
    command("nod");
    command("say 这正是琉璃盏碎片中的一块----紫琉璃。\n");
    me->add("newborn/three_liuli_num", 1);
    me->delete("newborn/three_bai");
    num = me->query("newborn/three_liuli_num");
    command("thank " + me->query("id"));
  }
  cnum = chinese_number(num);

  if (num < 4) command("say 现在已找到" + cnum + "块琉璃盏碎片了。\n");
  if (num == 4) {
    command("say 太好了，四块琉璃盏碎片已经齐了。吾先走一步将琉璃盏恢复原貌，再在南天门等你一同去见王母娘娘。\n");
    me->set("newborn/three_liuli", "done");
    call_out("leave_jl", 2, this_object());
  }

  return 1;

}

int leave_jl(object ob) {
  if (ob) ob->move("/d/dntg/sky/nantian");
  return 1;
}

void init() {
  object who = this_object();
  object me = this_player();

  ::init();
  if (me->query("newborn/three_liuli") == "done") {
    command("say 琉璃盏已经修好了，你随吾一同去进见王母娘娘吧，她现在应该在灵霄宝殿。\n");
    command("follow " + me->query("id"));
  }
}
