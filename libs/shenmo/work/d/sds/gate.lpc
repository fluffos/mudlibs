
inherit ROOM;
#include <ansi.h>

void create()
{
  set ("short",HIY"银河擂台赛 赛场大门"NOR);
	set("long", @LONG
LONG
	);
set("exits", ([ /* sizeof() == 1 */
  "enter" : "/d/sds/saichang",
  "southwest" : "/d/southern/wutai/shanjiao",
]));
  set("no_fight", 1); 
  set("no_magic", 1); 
  set("objects", ([ /* sizeof() == 1 */
  "/d/sds/npc/fighter" :1,
  "/d/sds/npc/fighter1" :4,
  "/d/sds/npc/baomingde" :1,
]));
	setup();
message("channel:chat",HIC"【银河界】辰巳德丸(Chensi)：银河擂台战现在开始，欢迎各地玩家踊跃报名。\n"NOR,users());
}


int valid_leave(object me,string dir) 
{ 
        object man; 

        if (dir=="southwest") 
          return ::valid_leave(me,dir); 

     if ( me->query("sds/number")>=4 ) return 1;

        if (!me->query_temp("can_join") ) return notify_fail("辰巳德丸一把拦住你，你不是参赛者，不准进!!!\n"); 
        return ::valid_leave(me,dir); 
        
      } 
