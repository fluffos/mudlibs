inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIY "银河擂台赛 赛场" NOR);
  set("long", @LONG

史上最强之格斗比赛的赛场。看台上观众多不胜数，掌声雷动。
场地人员在忙碌的工作着。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "out": "/d/sds/gate",
    "up": "/d/sds/gift-room",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("objects", ([ /* sizeof() == 1 */
    "/d/sds/npc/judge": 1,
  ]));

  setup();
}

void init() {
  add_action("do_none", "move");
  add_action("do_none", "kill");
}

int do_none() {
  message_vision("裁判摇了摇头。\n");
  return 1;
}

int valid_leave(object me, string dir) {
  if (dir == "up" && me->query("sds/number") >= 4) return 1;

  if (present("sai zhang", me) || present("escape seal", me)) {
    me->set_temp("block_msg/all", 1);
    call_out("dark", random(1) + 2, me, this_object());
  }

  if (dir == "out") {
    message_vision("$N放弃比赛，将赛章交还裁判。\n", me);
    me->command("give sai zhang to judge");
    me->delete_temp("sds/fail");
    me->delete_temp("can_join");
    return ::valid_leave(me, dir);
  }

}

void dark(object me, object where) {
  if (!me) return;
  me->set_temp("block_msg/all", 0);
  me->move(__DIR__ "saichang");
  message_vision(YEL "\n$N还没交出赛章，可别想走。\n" NOR, me);
}
