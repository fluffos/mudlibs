#include <armor.h>
#include <ansi.h>
#include "chk_owner.h"

inherit WRISTS;

void create()
{
set_name(HIW"人马座"+HIY"黄金圣衣"+HIM"·"+HIC"手部"NOR,({"renma shengyi's hand","hand"}));
set_weight(500);
if( clonep() )
    set_default_object(__FILE__);
else {
	set("unit", "顶");
	set("long",HIW"人马座"+HIY"黄金圣衣"NOR+"的手部。\n");
	set("material", "cloth");
       set("armor_prop/armor", 5); //圣衣黄金head+20,hand+5*2,leg+5*2,body+50 ==90
	set("remove_msg", HIY"$N低头脱下$n"NOR+HIY"。\n"NOR);
	set("no_give",1);
	set("no_drop",1);
	set("no_put",1);
  	}
setup();
}
