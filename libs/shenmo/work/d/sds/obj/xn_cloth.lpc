//xn_cloth.c 
//仙女青铜圣衣 
        
#include <ansi.h> 
#include <armor.h> 
#include "chk_player.h"
       
inherit ARMOR; 
        
void create() 
{ 
set_name(HIW"仙女"+HIC"青铜圣衣"NOR, ({ "xiannv shengyi" }) ); 
set_weight(4000); 
if( clonep() ) 
	set_default_object(__FILE__); 
else { 
	set("unit", "件"); 
	set("material", "steel"); 
	set("armor_prop/armor",180); 
	} 
setup(); 
} 
