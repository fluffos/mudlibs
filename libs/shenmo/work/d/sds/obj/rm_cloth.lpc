#include <armor.h>
#include <ansi.h>
#include "chk_owner.h"

inherit ARMOR;

void create() {
  set_name(HIW "人马座" + HIY "黄金圣衣" NOR, ({ "renma shengyi", "jia" }));
  set_weight(2200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", HIW "人马座" + HIY "黄金圣衣" NOR + "。\n");
    set("material", "gold");
    set("armor_prop/armor", 90);
    set("wear_msg", HIY "$N穿起$n" NOR + HIY "，一股强大的小宇宙冲天而出。\n" NOR);
    set("remove_msg", HIY "$N脱下$n" NOR + HIY "。\n" NOR);
    set("armor_prop/spells", 5);
    set("armor_prop/dodge", 1);
    set("armor_prop/parry", 1);
    set("no_drop", 1);
    set("no_put", 1);
  }
  setup();
}
