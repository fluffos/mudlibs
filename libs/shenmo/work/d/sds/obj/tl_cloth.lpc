//tl_cloth.c 
//天龍青铜圣衣 

#include <ansi.h>
#include <armor.h>
#include "chk_player.h"

inherit ARMOR;

void create() {
  set_name(HIW "天龍" + HIC "青铜圣衣" NOR, ({ "tianlong shengyi" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "steel");
    set("armor_prop/armor", 160);
  }
  setup();
}
