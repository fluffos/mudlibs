#include <armor.h>
#include <ansi.h>
#include <combat.h>

inherit HEAD;

void create()
{
set_name(HIW"人马座"+HIY"黄金圣衣"+HIM"·"+HIC"头部"NOR,({"renma shengyi's head","kui"}));
set_weight(500);
if( clonep() )
    set_default_object(__FILE__);
else {
	set("unit", "顶");
	set("long",HIW"人马座"+HIY"黄金圣衣"NOR+"的头部。\n");
	set("material", "cloth");
	set("armor_prop/armor", 20);
       set("wear_msg", HIY"$N戴起一顶$n"NOR+HIY"，一股强大的小宇宙冲天而出。\n"NOR);
	set("remove_msg", HIY"$N低头脱下$n"NOR+HIY"。\n"NOR);
	set("no_give",1);
	set("no_drop",1);
	set("no_put",1);

  }
  setup();
}

void dismiss(object ob)
{
if ( !ob ) return;
destruct(ob);
return;
}

void check_owner()
{
object ob = this_object();
object me = environment(ob);
if ( !interactive(me) || me->query("sds/tianma")!="done" )
	call_out("dismiss",3+random(7),ob);
}

void init()
{
  check_owner();
}

int query_autoload() { return 1; }
