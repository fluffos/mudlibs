#include <armor.h>
#include <ansi.h>
#include "chk_owner.h"

inherit ARMOR;

void create() {
  set_name(HIW "人马座" + HIY "黄金圣衣" + HIM "·" + HIC "身部" NOR, ({ "renma shengyi's body", "body" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    set("long", HIW "人马座" + HIY "黄金圣衣" NOR + "的身部。\n");
    set("material", "cloth");
    set("armor_prop/armor", 50);
    set("remove_msg", HIY "$N低头脱下$n" NOR + HIY "。\n" NOR);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);

  }
  setup();
}
