#include <armor.h>
#include <ansi.h>

inherit NECK;

void create()
{
set_name(HIW"人马座"+HIY"黄金圣衣"+HIM"·"+HIC"臂部"NOR,({"renma shengyi's neck","neck"}));
set_weight(500);
if( clonep() )
    set_default_object(__FILE__);
else {
	set("unit", "顶");
	set("long",HIW"人马座"+HIY"黄金圣衣"NOR+"的身部。与其他各部可以合并(hebing)为人马座圣衣！\n");
	set("material", "cloth");
	set("armor_prop/armor", 5); 
	set("remove_msg", HIY"$N低头脱下$n"NOR+HIY"。\n"NOR);
 set("no_give",1);
	set("no_drop",1);
	set("no_put",1);

  }
  setup();
}

void dismiss(object ob)
{
if ( !ob ) return;
destruct(ob);
return;
}

void check_owner()
{
object ob = this_object();
object me = environment(ob);
if ( !interactive(me) )
	call_out("dismiss",3+random(7),ob);
}

void init()
{
check_owner();
add_action("do_hebi","hebing");
}

int query_autoload() { return 1; }

int do_hebi()
{
object armor,a,b,c,d,e;
object me = this_player();
if (!( a=present("renma shengyi's hand",me) )   //40
 || !( b=present("renma shengyi's head",me) ) //40
 || !( c=present("renma shengyi's leg",me) )    //40
 || !( d=present("renma shengyi's body",me) ) )//200
	return notify_fail("你的圣衣残缺不全！\n");
if ( armor=new("/d/sds/obj/rm_cloth") )
	{
	armor->move(me);
	message_vision(HIY"$N将得到的人马座圣衣五部合并为圣衣！\n"NOR,me);		
	destruct(a);
	destruct(b);
	destruct(c);
	destruct(d);
	destruct(this_object());
	me->set("sds2/cloth","done");    // 以此来限制其不能继续去问shazhi要kui
	}
return 1;
}
