#include <ansi.h>
inherit NPC;

string ask_join();

void create() {
  set_name("辰巳德丸", ({ "chensi dewan" }));
  set("title", HIC "城户家的管家" NOR);
  set("age", 40);
  set("gender", "男性");
  set("long", "城户家的管家，脾气暴躁，但是对沙织小姐却是必恭必敬。\n");
  set("attitude", "peaceful");
  set("combat_exp", 10000);
  set("shen_type", 1);
  set("max_force", 200);
  set("force", 200);
  set("per", 40);
  set("force_factor", 5);
  set_skill("unarmed", 30);
  set_skill("dodge", 40);
  set_skill("parry", 30);
  set("inquiry", ([
    "报名": (: ask_join :),
    "join": (: ask_join :),
  ]));

  setup();
  carry_object("/d/obj/armor/tiejia")->wear();
}


string ask_join() {
  int i;
  object *inv;
  object me = this_player();
  string name = me->query("name");
  object where = environment(me);

  inv = all_inventory(me);
  for (i = 0; i <= sizeof(inv); i++) {
    if (userp(inv[i]))
      return name + ",赛场之内严禁作弊！\n";
    else if (inv[i] = present("sai zhang", me)) {
      me->set_temp("can_join", 1);
      return name + "进去吧，比赛快开始了！\n";
    } else return name + "你来晚了，名额都已经报满，赛章也都分发出去了。\n";
  }
}
