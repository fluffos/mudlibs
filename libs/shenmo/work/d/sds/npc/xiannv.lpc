//阿瞬·银河战xiannv.c

#include <ansi.h> 
inherit NPC; 
#include "star.h" 
         
void create() 
{ 
	set_name("阿瞬", ({"a shun"})); 
	set("long", "仙女座的青铜斗士，性格温顺，参加"+HIY"银河擂台赛"NOR+"没什么理由:）\n"); 
	set("gender","男性"); 
	set("title", HIW"【仙女座】"NOR+"青铜圣斗士"); 
	set("age",16); 
	set("con",37); 
	set("per",40); 
	set("str",38); 
	set("int",30); 
	set("combat_exp",1000000); 
	set("daoxing",3000000); 
	set("chat_chance",20); 
	set("chat_msg", ({ 
		"阿瞬说道：哥哥，我一定会长大的。\n", 
		 })); 
	set("attitude", "friendly"); 
	set_skill("force", 250);
	set_skill("parry", 250); 
	set_skill("unarmed", 250); 
	set_skill("staff", 250); 
	set_skill("shengdou",250); 
	set_skill("stars-steps",250); 
	set_skill("buddhism",250); 
	set_skill("spells",250); 
	set_skill("lunhui-zhang", 250); 
	map_skill("parry","lunhui-zhang"); 
	map_skill("unarmed","shengdou"); 
	map_skill("spells","buddhism"); 
	map_skill("dodge","stars-steps"); 
	set("max_force", 3000); 
	set("force", 6000); 
	set("max_mana",3000); 
	set("mana",6000); 
	set("mana_factor",60); 
	set("force_factor", 60); 
	set("max_kee", 5500); 
	set("max_gin", 5500); 
	set("max_sen", 5500); 
	setup(); 
	carry_object("/d/sds/obj/xn_cloth")->wear(); 
} 
       
void check()  
{  
object ob=this_object();  
object me=query_temp("my_killer");  
int my_max_kee = me->query("max_kee"); 

if( ! me ) return ;  
if(! present(me,environment()) )  
	{  
	remove_call_out("check");  
	return;  
	}            

       
switch(random(3)) 
	{         
	case 0: 
		{ 
		message_vision(HIM"\n$N高喊一声：『星云锁链』，圣衣立刻在$n四周布上重重封印！\n",ob,me); 
		if(random(2)==0) 
			{ 
			message_vision(HIM"\n$N的攻击立刻变得无效起来！\n"NOR,me); 
			ob->add("kee",query("max_kee")-query("kee")); 
			ob->add("eff_kee",query("max_kee")-query("kee")); 
			ob->add("sen",query("max_sen")-query("sen")); 
			ob->add("eff_sen",query("max_sen")-query("sen")); 
			me->start_busy(random(1));
			} 
		else        message_vision(HIC"\n$N纵身跳出锁链的包围，再次发动攻击！\n"NOR,me);
		} 
	break; 
	case 1: 
		{ 
		message_vision(HIM"$N高喊一声：『星云黑洞』，$n心神一震，想是受了重创！\n"NOR,ob,me); 
		if(random(2)==0) 
			{ 
                        message_vision(HIM"$N胸口一甜，一口鲜血已控制不住的喷出！\n"NOR,me); 
			me->add("eff_sen",-query("max_sen")/10); 
			me->add("kee",-query("max_kee")/20); 
			} 
		else   	message_vision(HIC"$N暗自凝聚元神，将体内的逆血平复！\n"NOR,me); 
		}  
	break; 
	} 
if( random(8) == 5 ) 
powerup(); 
remove_call_out("check"); 
call_out("check",2+random(3)); 
} 
