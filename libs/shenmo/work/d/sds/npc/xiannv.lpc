void init()  
{  
add_action("do_none","cast");  
 //add_action("do_none","smash");  
//add_action("do_none","perform");  
add_action("do_none","move");  
add_action("do_none","ji");  
add_action("do_none","burn");  
kill_ob(this_player());  
::init();  
 }  

int do_none()  
{  
message_vision(HIW"$N对$n摇摇头:比赛中，还是不用诡计的好......\n"NOR,this_object(),this_player() );  
return 1;  
}  
