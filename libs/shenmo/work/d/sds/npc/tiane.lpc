//冰河·银河战tiane.c 

#include <ansi.h>
inherit NPC;
#include "star.h"

void create() {
  set_name("冰河", ({ "bing he" }));
  set("long", "天鹅座的青铜斗士，为了冰封在海底的妈妈，参加了" + HIY "银河擂台赛" NOR + "\n");
  set("gender", "男性");
  set("title", HIW "【天鹅座】" NOR + "青铜圣斗士");
  set("age", 17);
  set("con", 37);
  set("per", 30);
  set("str", 38);
  set("int", 30);
  set("combat_exp", 1000000);
  set("daoxing", 3000000);
  set("chat_chance", 20);
  set("chat_msg", ({
    "冰河说道：妈妈，我一定会回来的。\n",
  }));
  set("attitude", "friendly");
  set_skill("force", 150);
  set_skill("parry", 150);
  set_skill("unarmed", 150);
  set_skill("staff", 150);
  set_skill("shengdou", 150);
  set_skill("stars-steps", 150);
  set_skill("buddhism", 150);
  set_skill("spells", 150);
  set_skill("lunhui-zhang", 150);
  map_skill("parry", "lunhui-zhang");
  map_skill("unarmed", "shengdou");
  map_skill("spells", "buddhism");
  map_skill("dodge", "stars-steps");
  set("max_force", 1500);
  set("force", 3000);
  set("max_mana", 1500);
  set("mana", 3000);
  set("mana_factor", 50);
  set("force_factor", 50);
  set("max_kee", 1500);
  set("max_gin", 1500);
  set("max_sen", 1500);
  setup();
}

void check() {
  object ob = this_object();
  object me = query_temp("my_killer");
  int my_max_kee = me->query("max_kee");

  if (!me) return;
  if (!present(me, environment())) {
    remove_call_out("check");
    return;
  }


  switch (random(3)) {
    case 0:
      {
        message_vision(HIW "\n$N高喊一声：『鑽石星塵拳』，$n四周的空气立刻好似凝固起来！\n", ob, me);
        if (random(2) == 0) {
          message_vision(HIW "\n$N顿时觉得行动缓慢起来，连呼吸都变得困难！\n" NOR, me);
          me->add("kee", -query("max_kee") / 5);
          me->start_busy(1 + random(1));
        } else message_vision(HIW "\n$N连忙运起浑身真气，抵御住刺骨的寒风！\n" NOR, me);
      }
      break;
    case 1:
      {
        message_vision(HIW "$N高喊一声：『曙光女神之宽恕』，$n所在的空间立刻好似变成了另一个空间！\n" NOR, ob, me);
        if (random(2) == 0) {
          message_vision(HIW "$N冻得不住的打冷战，哪里有心思继续战斗！\n" NOR, me);
          me->add("eff_kee", -query("max_kee") / 20);
          me->start_busy(random(1));
        } else message_vision(HIW "$N哈哈大笑，这点伎俩算不得什么！\n" NOR, me);
      }
      break;
  }
  if (random(8) == 5)
    powerup();
  remove_call_out("check");
  call_out("check", 2 + random(3));
}
void init() {
  add_action("do_none", "cast");
  //add_action("do_none","smash");  
  //add_action("do_none","perform");  
  add_action("do_none", "move");
  add_action("do_none", "ji");
  add_action("do_none", "burn");
  kill_ob(this_player());
  ::init();
}

int do_none() {
  message_vision(HIW "$N对$n摇摇头:比赛中，还是不用诡计的好......\n" NOR, this_object(), this_player());
  return 1;
}
