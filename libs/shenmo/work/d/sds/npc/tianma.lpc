// 星矢(xing shi)青铜最强五人之一  

#include <ansi.h>
inherit NPC;
#include "star.h"

void create() {
  set_name("星矢", ({ "xing shi" }));
  set("long", "天马座的青铜斗士，为寻找姐姐而参加了" + HIY "银河擂台赛" NOR + "\n");
  set("gender", "男性");
  set("title", HIW "【天马座】" NOR + "青铜圣斗士");
  set("age", 17);
  set("con", 30);
  set("per", 30);
  set("str", 35);
  set("int", 35);
  set("combat_exp", 1000000);
  set("daoxing", 3000000);
  set("chat_chance", 20);
  set("chat_msg", ({
    "星矢说道：为了姐姐一定要战斗到底。\n",
  }));

  set("attitude", "friendly");
  set_skill("force", 200);
  set_skill("parry", 200);
  set_skill("unarmed", 200);
  set_skill("staff", 200);
  set_skill("shengdou", 200);
  set_skill("stars-steps", 200);
  set_skill("buddhism", 200);
  set_skill("spells", 200);
  set_skill("lunhui-zhang", 200);
  map_skill("parry", "lunhui-zhang");
  map_skill("unarmed", "shengdou");
  map_skill("spells", "buddhism");
  map_skill("dodge", "stars-steps");
  set("max_force", 2000);
  set("force", 4000);
  set("max_mana", 2000);
  set("mana", 4000);
  set("mana_factor", 60);
  set("force_factor", 60);
  set("max_kee", 2500);
  set("max_gin", 2500);
  set("max_sen", 2500);
  setup();
  carry_object("/d/sds/obj/tm_cloth")->wear();
}

void init() {
  add_action("do_none", "cast");
  //add_action("do_none","smash"); 
  add_action("do_none", "perform");
  add_action("do_none", "move");
  add_action("do_none", "ji");
  add_action("do_none", "burn");
  kill_ob(this_player());
  ::init();
}

int do_none() {
  message_vision(HIW "$N对$n摇摇头:比赛中，还是不用诡计的好......\n" NOR, this_object(), this_player());
  return 1;
}

void check() {
  object ob = this_object();
  object me = query_temp("my_killer");
  int my_max_kee = me->query("max_kee");

  if (!me) return;
  if (!present(me, environment())) {
    remove_call_out("check");
    return;
  }


  switch (random(5)) {
    case 0:
      {
        message_vision(HIC "$N大喊一声『天马流星拳』，双拳以光速化作千万流星冲向$n！\n", ob, me);
        if (random(2) == 0) {
          message_vision(HIC "$N被无数强劲的光团贯穿全身！\n" NOR, me);
          me->add("kee", -query("max_kee") / 8);
        } else message_vision(HIG "$N看破了$n流星拳的轨迹，轻松躲开！\n" NOR, me, ob);
      }
      break;
    case 1:
      {
        message_vision(HIW "$N跳在半空，大喝一声：『天马彗星拳』，千万流星汇作一点击向$n！\n", ob, me);
        if (random(2) == 0) {
          message_vision(GRN "$N立刻被彗星的光辉淹没，$N顿时给皮开肉绽，惨不忍睹！\n" NOR, me);
          me->add("eff_kee", -query("max_kee") / 15);
        } else
          message_vision(HIY "$N用尽全身力气，飞升而起，彗星的尾巴正从$N的脚底板扫过！\n" NOR, me);
      }
      break;
  }
  if (random(8) == 5)
    powerup();
  remove_call_out("check");
  call_out("check", 2 + random(3));
}
