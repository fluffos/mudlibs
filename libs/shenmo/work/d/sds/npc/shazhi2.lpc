//城户沙织是当今雅典娜的化身，１３年前降生於雅典娜神殿 。被教皇亚历士下
//手杀害时，得人马座的艾奥罗斯所救。跟着由城户光政当是自已的孙女养育成人 。    
    
inherit NPC; 
string ask_cloth1(); 
string ask_cloth2(); 
string times(int time);

#include <ansi.h> 
        
void create() 
{ 
set_name(HIM"城户沙织"NOR, ({ "sha zhi", "chenghu shazhi" })); 
set("long", @LONG 
城户沙织是雅典娜的转世，１３年前降生於雅典娜神殿 。被教皇亚历士下手
杀害时，得人马座的艾奥罗斯所救。跟着由城户光政当是自已的孙女养育成人 。
为了爷爷的遗愿，发起了今次[ 银河战役 ]。
LONG); 
set("gender", "女性"); 
set("age", 16); 
set("attitude", "peaceful"); 
set("per",100);//means no rong-mao description. 
set("max_kee", 12000); 
set("max_gin", 14000); 
set("max_sen", 12000); 
set("force", 12000); 
set("max_force", 24000); 
set("force_factor", 500); 
set("max_mana", 14000); 
set("mana", 28000); 
set("mana_factor", 600); 
set("combat_exp", 20000000); 
set("daoxing", 20000000); 
set_skill("spells", 900); 
set_skill("buddhism", 900); 
set_skill("unarmed", 900); 
set_skill("jienan-zhi", 900); 
set_skill("dodge", 900); 
set_skill("lotusmove", 900); 
set_skill("parry", 900); 
set_skill("force", 900); 
set_skill("lotusforce", 900); 
set_skill("staff", 900); 
set_skill("lunhui-zhang", 900); 
map_skill("spells", "buddhism"); 
map_skill("unarmed", "jienan-zhi"); 
map_skill("dodge", "lotusmove"); 
map_skill("force", "lotusforce"); 
map_skill("parry", "lunhui-zhang"); 
map_skill("staff", "lunhui-zhang"); 
set("chat_chance_combat", 90); 
set("inquiry",([ 
        "人马圣衣": (: ask_cloth1:) ,  //银河战相关
        "黄金圣衣": (: ask_cloth2:) ])); //死亡岛以及12宫相关
setup(); 
carry_object("/d/12gong/obj/armor")->wear(); 
carry_object("/d/12gong/obj/cloth")->wear(); 
carry_object("/d/12gong/obj/pifeng")->wear(); 
carry_object("/d/12gong/obj/shield")->wear(); 
carry_object("/d/12gong/obj/staff")->wield(); 
} 

string ask_cloth1()   //银河战相关
{ 
object cloth; 
object ob = this_object(); 
object me = this_player(); 
object where = environment(me);

if( me->query("sds/number") >= 4 )
        {
        if ( !me->query("sds/gift1") ) 
                { 
                message("chat",HIY+"【银河战役】沙织(Sha zhi):"+HIW+me->name()+"分别战胜"+HIC"仙女·天鹅·天龙·天马"+HIY"，得到了"+HIW"人马座黄金圣衣"+HIY"！\n"NOR,users()); 
                me->set("sds/gift1",1); 
                me->set("title",HIC"银河战役"+HIW"最终魁首"NOR);
                me->add("daoxing",100000); 
                me->add("combat_exp",100000); 
                me->add("potential",50000); 
                tell_object(me,BLINK+HIY"得到了100年道行,10万武学,5万潜能！\n"NOR); 
                message_vision(HIW"在一片欢呼声中，$N从擂台上方的宝座上取下了"+HIC"人马座"+HIW"的"+HIY"黄金圣衣"+HIW"。\n
$N举步向$n走来，准备将这宝贵的战利品交到$n手上！\n"NOR,ob,me);
                me->set_temp("block_msg/all",1);
                call_out("dark",random(5) + 5, me, where);
                }
        else    {
                if ( present("renma shengyi's head",me)|| present("renma shengyi",me) 
                || me->query("sds3/baiyang")=="done" || me->set_temp("sds3/rm_give") ) 
                        return "你不是有了吗？"; 
                else    {
                        command("ok "+me->query("id") );
                        cloth=new("/d/sds/obj/rm_cloth1");
                        cloth->move(me);
                        message_vision("$N给$n一顶"+cloth->query("name")+".\n",ob,me);
                        }
                }
        }
return "银河战争是独一无二的。"; 
}
       
string ask_cloth2() 
{ 
int time;
object cloth; 
object ob = this_object(); 
object me = this_player(); 
object where = environment(me);

if ( me->query("sds2/cloth")=="done" )    //死亡岛已过
        {
        if (present("renma shengyi",me)||me->query("sds3/baiyang")=="done" )  //假如身上有圣衣或白羊已过
                {
                if ( time=ob->query("going") )  //时间限制
                        return "已经有其他战士去了，你等"+HIY+times(time)+NOR"后再来吧。\n";
                me->set_temp("sds3/12gong_go",1);
                return "圣域传来口讯说是要将黄金圣衣收回，你能帮我完成这个任务吗？（yes）";
                }
        else if ( me->query("sds3/baiyang")!="done" )  //否则,假如第一宫没过的
                {
                cloth=new("/d/sds/obj/rm_cloth");
                cloth->move(me);
                return "好好保管人马座的圣衣,千万不要再有闪失了......\n";
                }
        }
return "银河战争是独一无二的。"; 
}

void dark(object me,object where)
{
object head;
if(!me) return;
me->set_temp("block_msg/all", 0);
message_vision(HIM"
忽然台下阿瞬的锁链响个不停，一股乌云笼罩住了竞技场。四周猝然一片\n
漆黑！等再度灯火通明时，大家才发现$N"+HIM"手中的"+HIW"人马座"+HIY"黄金圣衣"+HIM"止剩下个\n"+HIW"
头部"+HIM"！再看那站在擂台上方的人影，竟是失踪已久的："+HIW"凤凰座一辉"+HIB"!\n\n"NOR,this_object());
message("chat",HIB+"\n【死亡之岛】一辉(Yi hui):"+HIW+me->name()+HIB"，你不配拿神的圣衣，想要证明自己的实力就去死亡之岛找我吧！\n"NOR,users()); 
message_vision(HIC"\n\n等$N想追之际，一辉已消失在视野之中。。。\n",this_player() );
head=new("/d/sds/obj/rm_cloth1");
head->move(this_player());
}

void init()
{
add_action("do_none","kill");
add_action("do_none","ji");
add_action("do_none","cast");
add_action("do_none","perform");
add_action("do_none","fight");
add_action("do_none","steal");
add_action("do_yes","yes");
}

int do_none()
{
message_vision(HIW"\n$N望着$n，$n感受到女神那充满爱心的小宇宙，心中的邪恶一扫而尽，不由露出会心的笑意。\n"NOR,this_object(),this_player() );
return 1;
}


int do_yes(string arg)
{
object me=this_player();
object ob=this_object();
if (!me->query_temp("sds3/12gong_go")) return 0;

command("say 此番去圣域路上危险重重，你自己小心了!!!\n");
command("say 我这就送你去吧。\n");
tell_object(me,HIY"\n沙织全身突然被一股黄金光芒所笼罩。\n"NOR); 
tell_object(me,HIY"光芒越来越盛，你觉得头晕目眩。\n"NOR);
me->delete_temp("sds3/12gong_go");
ob->set("going",6000+random(6000));
ob->save();
call_out("check_time",1,ob);
me->move("/d/sds3/toby1");
tell_object(me,HIY"突然耳边传来沙织的说话声：到了，希望你能够完成这艰巨的任务。\n"NOR);
return 1;
}

string times(int time)
{
int sec, min, hrs, day, mon, age;
string out_str;
sec = time % 60;
time /= 60;
min = time % 60;
time /= 60;
hrs = time % 24;
time /= 24;
day = time % 30;
mon = time / 30;
out_str = (mon? chinese_number(mon)+"月":"")
         + (day? chinese_number(day)+"天":"")
         + (hrs? chinese_number(hrs)+"小时":"")
         + (min? chinese_number(min)+"分钟":"")
         + (sec? chinese_number(sec)+"秒":"");
return out_str;
}

void check_time(object ob)
{
remove_call_out("check_time");

if ( ob->query("going")<=0 )
        {
        ob->delete("going");
        return;
        }
ob->add("going",-(30+random(30)));
ob->save();
call_out("check_time",1,ob);
}


