//紫龙·银河战tianlong.c

#include <ansi.h>
inherit NPC;
#include "star.h"

void create() {
  set_name("紫龙", ({ "zi long" }));
  set("long", "天龙座的青铜斗士，受师傅童虎的命令而参加了" + HIY "银河擂台赛" NOR + "\n");
  set("gender", "男性");
  set("title", HIW "【天龙座】" NOR + "青铜圣斗士");
  set("age", 18);
  set("con", 35);
  set("per", 34);
  set("str", 30);
  set("int", 35);
  set("combat_exp", 1000000);
  set("daoxing", 3000000);
  set("chat_chance", 20);
  set("chat_msg", ({
    "紫龙说道：不知老师现在怎么样了。\n",
  }));
  set("attitude", "friendly");
  set_skill("force", 250);
  set_skill("parry", 250);
  set_skill("unarmed", 250);
  set_skill("staff", 250);
  set_skill("shengdou", 250);
  set_skill("stars-steps", 250);
  set_skill("buddhism", 250);
  set_skill("spells", 250);
  set_skill("lunhui-zhang", 250);
  map_skill("parry", "lunhui-zhang");
  map_skill("unarmed", "shengdou");
  map_skill("spells", "buddhism");
  map_skill("dodge", "stars-steps");
  set("max_force", 3000);
  set("force", 6000);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 60);
  set("force_factor", 60);
  set("max_kee", 5500);
  set("max_gin", 5500);
  set("max_sen", 5500);
  setup();
  carry_object("/d/sds/obj/tl_cloth")->wear();
}

void check() {
  object ob = this_object();
  object me = query_temp("my_killer");
  int my_max_kee = me->query("max_kee");

  if (!me) return;
  if (!present(me, environment())) {
    remove_call_out("check");
    return;
  }


  switch (random(3)) {
    case 0:
      {
        message_vision(HIB "\n$N高喊一声：『庐山亢龙霸』，一条恶龙自溅底而出，尾巴向$n扫去！\n", ob, me);
        if (random(2) == 0) {
          message_vision(HIB "\n$N被恶龙的尾巴甩了个正着，顿时眼冒金星！\n" NOR, me);
          me->add("kee", -query("max_kee") / 5);
        } else message_vision(HIB "\n$N身型急转，不知道绕了多少圈才夺过巨龙的攻击！\n" NOR, me);
      }
      break;
    case 1:
      {
        message_vision(HIW "$N高喊一声：『庐山百龙霸』，无数只巨龙向$n冲过来！\n" NOR, ob, me);
        if (random(2) == 0) {
          message_vision(HIW "$N如一个球一样，被无数只巨龙在空中戏弄着！\n" NOR, me);
          me->add("eff_kee", -query("max_kee") / 15);
        } else message_vision(HIY "$N看准了巨龙之间的空隙，左转右转，才勉强离难！\n" NOR, me);
      }
      break;
  }
  if (random(8) == 5)
    powerup();
  remove_call_out("check");
  call_out("check", 2 + random(3));
}
