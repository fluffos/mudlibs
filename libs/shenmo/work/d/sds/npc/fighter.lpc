#include <ansi.h>
inherit NPC;
inherit F_MASTER; 
string ask_saizhang();
 
void create()
{
          set_name("受伤的参赛者", ({ "woundful fighter","fight" }) );
        set("gender", "男性" );
        set("long","刚刚中途离场的格斗家。说不定可以向他打听"HIY"赛章"NOR"的事。\n"NOR);
        set("age",20);
        
        set("inquiry", ([
                "赛章" : (: ask_saizhang :),
                "saizhang" : (: ask_saizhang :),
                ]) );
              setup();
        carry_object("/d/obj/armor/tiejia")->wear();
}

string ask_saizhang()
{  
   object me=this_player();
   object saizhang;
   object ob=this_object();

   if (ob->query("no_saizhang"))
       return "我的赛章已经送人了。真是好人啊，多亏他帮我包扎，不然我就死在这了。\n";

   if (!me->query_temp("fighter_helped"))
       return "唉哟，我流了好多血，谁来帮我包扎(bandage)一下，我就把赛章给他，反正我也参加不了比赛了。\n";

   saizhang=new("/d/sds/obj/saizhang");
   saizhang->move(me);
   ob->set("no_saizhang",1);
   call_out("regenerate", 600);
   me->delete_temp("fighter_helped");
   return "多谢你，这比赛我已经参加不了了，赛章就送给你，希望你能夺得人马座的黄金圣衣。\n";
      

}

void init()
{
 add_action("do_bandage","bandage");
}

int do_bandage(string arg)
{
   object me=this_player();
   object ob=this_object();

   if (!arg) return notify_fail("你要帮谁包扎？\n");
   if (arg!="woundful fighter") return notify_fail("那人不需要包扎。\n");

   if (ob->query("no_saizhang"))
       {command("say 晚了，已经有个好心人帮我包扎过了。\n");
       return 1;}

   message_vision("$N脱下自己的内裤，将$n受伤部位小心的包扎好。\n",me,ob);
   message_vision("$n受伤的部位被包扎好了，他感激的望着$N。\n",me,ob);
   me->set_temp("fighter_helped",1);
   return 1;
}

int regenerate()
{
       object ob=this_object();

	ob->set("no_saizhang", 0);
	return 1;
}







