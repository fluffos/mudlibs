#include <ansi.h>
inherit NPC;

string ask_fight();

void create() {
  set_name("裁判", ({ "judge" }));
  set("age", 40);
  set("gender", "男性");
  set("title", HIY "银河擂台赛" NOR);
  set("long", "本次银河擂台战的裁判。\n");
  set("attitude", "peaceful");
  set("combat_exp", 10000);
  set("shen_type", 1);
  set("max_force", 200);
  set("force", 200);
  set("per", 40);
  set("force_factor", 5);
  set_skill("unarmed", 30);
  set_skill("dodge", 40);
  set_skill("parry", 30);
  set("inquiry", ([
    "比武": (: ask_fight :),
    "fight": (: ask_fight :),
  ]));

  setup();
  carry_object("/d/obj/armor/tiejia")->wear();
}

string ask_fight() {
  object me = this_player();
  object ob = this_object();
  object fighter;
  object leitai = find_object("/d/sds/leitai1");
  int i, k;
  string file;

  if (!leitai) leitai = load_object("/d/sds/leitai1");

  if (me->query("sds/gift1"))
    return "你已经胜出了，还不去死亡岛夺回圣衣？";

  if (me->query("sds/number") >= 4 && !me->query("sds/gift1")) {
    command("gongxi " + me->query("id"));
    command("say " + me->query("name") + "，你已打败各路对手，去见沙织小姐吧！\n");
    message(
      "channel:chat",
      HIC "【银河界】裁判(Judge):" + me->name() + HIC "打败了各圣斗士，见到沙织小姐。\n" NOR,
      users()
    );
    me->move("/d/sds/gift-room");
    message_vision(HIG "观众发出响天彻地的欢呼声，$N在一片欢呼声赞美声中被工作人员送到了沙织小姐的面前。 \n" NOR, me);
    return "比赛圆满结束!";
  }

  if (leitai->query("busy"))
    return "有人正在擂台上交手，请稍候。\n";

  if (me->query_temp("sds/fail")) return "你已经丧失比赛资格了。\n";

  if (present("sai zhang", me)) return "先把赛章给我吧！";

  message(
    "channel:chat",
    HIC "【银河界】裁判(Judge):" + me->name() + HIC "前来参战，争夺 人马座黄金圣衣 。\n" NOR,
    users()
  );
  me->set_temp("sds/baoming", 1);
  me->move("/d/sds/leitai1");
  return "比赛现在开始!!";

}


int accept_object(object me, object ob) {
  return 1;
}
