#include <ansi.h>
void dest();
void copy_status(object ob, object me);
inherit NPC;
void create() {
  set_name("feizei", ({ "fei zei", "fei", "zei" }));
  set("title", HIG "飞贼" NOR);
  set("gender", "男性");
  set("age", 35);
  set("per", 14);
  set("str", 30);
  set("long", "飞贼。\n");
  set("class", "xian");
  set("name_type", "刺杀者");
  set("daoxing", 480000000);
  set("attitude", "peaceful");
  set("family/family_name", "五庄观");
  set_skill("unarmed", 2400);
  set_skill("wuxing-quan", 2400);
  set_skill("dodge", 2400);
  set_skill("baguazhen", 2400);
  set_skill("parry", 2400);
  set_skill("hammer", 2400);
  set_skill("kaishan-chui", 2400);
  set_skill("force", 2400);
  set_skill("zhenyuan-force", 2400);
  set_skill("literate", 1500);
  set_skill("spells", 2400);
  set_skill("taiyi", 2400);
  set_skill("unarmed", 240);
  set_skill("wuxing-quan", 240);
  set_skill("dodge", 240);
  set_skill("baguazhen", 240);
  set_skill("parry", 240);
  set_skill("hammer", 240);
  set_skill("kaishan-chui", 240);
  set_skill("force", 240);
  set_skill("zhenyuan-force", 240);
  set_skill("literate", 150);
  set_skill("spells", 240);
  set_skill("taiyi", 240);
  map_skill("spells", "taiyi");
  map_skill("force", "zhenyuan-force");
  map_skill("unarmed", "wuxing-quan");
  map_skill("dodge", "baguazhen");
  map_skill("hammer", "kaishan-chui");

  set("chat_chance", 1);
  set("chat_msg", ({
    (: random_move :),
  }));

  setup();
  carry_object(__DIR__ "changjian")->wield();
  carry_object(__DIR__ "cloth")->wear();
  add_money("silver", random(50));
}
void init() {
  remove_call_out("hunting");
  if (!environment()->query("no_fight"))
    call_out("hunting", 1);
}

void hunting() {
  int i;
  object *ob;
  ob = all_inventory(environment());
  for (i = sizeof(ob) - 1; i >= 0; i--) {
    if (!ob[i]->is_character() || ob[i] == this_object() || !living(ob[i])) continue;
    if (ob[i]->query("vendetta/authority")) continue;
    kill_ob(ob[i]);
    ob[i]->fight(this_object());
  }
}
