#include <ansi.h>
inherit NPC;

string ask_chuangong();
string ask_chuqu();

void create() {
  set_name(HIG "公孙大娘" NOR, ({ "gongsun daniang", "gongsun" }));
  set("title", HIM "回风剑舞" NOR);
  set("gender", "女性");
  set_temp("no_kill", 1);
  set("age", 36);
  set("per", 100);
  set("long", "她就是公孙大娘，你可以找她传功给你。\n");
  set("shen_type", 1);
  set("combat_exp", 2000000);
  set("attitude", "peaceful");
  set("apply/attack", 350);
  set("apply/defense", 350);

  set_skill("unarmed", 150);
  set_skill("blade", 150);
  set_skill("parry", 40);
  set("inquiry", ([
    "传功": (: ask_chuangong :),
    "出去": (: ask_chuqu :),
  ]));
  setup();
}

string ask_chuangong() {
  object me = this_player();

  if (me->query("chuangong_bound") > 0) {
    return "传完了还要啊，真是贪得无厌!";
  }

  tell_object(me, "好吧，我就把我生平绝学" HIC "公孙剑舞" NOR "传授给你！\n");

  me->set_skill("taiji-quan", 100);
  me->set("chuangong_bound", 1);
  me->set("jifa/unarmed", 1);
  return "你已经得到了我的传功！";
}

string ask_chuqu() {
  object me = this_player();


  tell_object(me, "好吧，我现在就送你出去！\n");

  me->delete_skill("taiji-quan");
  me->delete("chuangong_bound", 1);
  me->move("/d/city/wumiao");

}
