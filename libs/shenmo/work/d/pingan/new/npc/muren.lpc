#include <ansi.h>
inherit NPC;

void create() {
  set_name("木头人", ({ "mutou ren" }));
  set("title", "新手之友");
  set("gender", "无性");
  set("age", 10);
  set("long", "这是一个木头人，可以拿来练功用。\n");
  set("shen_type", 1);
  set("combat_exp", 10000);
  set("max_qi", 1000);
  set("qi", 1000);
  set("attitude", "peaceful");
  setup();
}
