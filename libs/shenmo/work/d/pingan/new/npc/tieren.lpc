#include <ansi.h>
inherit NPC;

void create()
{
        set_name("铁皮人", ({ "tie ren"}) );
  set("title", "新手之友");
	set("gender", "无性" );
	set("age", 10);
       set("long", "这是一个铁皮人，可以拿来练功用。\n");
	set("shen_type",1);
	set("combat_exp", 100000);
	set("max_qi", 3000);
	set("qi", 3000);
	set("attitude", "peaceful");
	setup();
}
