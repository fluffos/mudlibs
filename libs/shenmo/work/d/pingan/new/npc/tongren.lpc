#include <ansi.h>
inherit NPC;

void create()
{
        set_name("铜皮人", ({ "tong ren"}) );
  set("title", "新手之友");
	set("gender", "无性" );
	set("age", 10);
       set("long", "这是一个铜皮人，可以拿来练功用。\n");
	set("shen_type",1);
	set("combat_exp", 50000);
	set("max_qi", 1800);
	set("qi", 1800);
	set("attitude", "peaceful");
	setup();
}
