inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_mieyao(object me);
string ask_cancel();
#include </d/panshi/panshi.h>


void create() {
  set_name("陆压", ({ "luya", "lu", "ya" }));
  set("gender", "男性");
  create_family("昆仑山玉虚洞", 3, "弟子");
  set("title", HIG "昆仑山玉虚洞管家" NOR);
  set("age", 41);
  set("class", "xian");
  set("long", "昆仑山玉虚洞散仙陆压，在洞中兼任管家之职。\n");
  set("combat_exp", 30);
  set("attitude", "peaceful");
  set("chat_chance", 50);
  setup();
  set("inquiry", ([

    "斩恶": (: ask_mieyao :),
    "回俗": (: askLeave :),
    //           "cancel": (: ask_cancel :),
  ]));
  carry_object("/d/moon/obj/luoyi")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
}


string ask_cancel() {
  object me = this_player();
  if ((int)me->query_temp("m_mieyao")) {
    me->add("daoxing", -2000);
    me->delete_temp("m_mieyao");
    me->delete("secmieyao");
    me->delete("secmieyao/type");
    me->delete("secmieyao/location");
    me->delete("secmieyao/place");
    me->delete("secmieyao/name");
    me->delete("secmieyao/id");
    return ("哎，我也不怪你，以后你可得努力哦！");
  } else {
    return ("你有任务吗？！");
  }
}
string ask_mieyao(object me) {
  me = this_player();
  if ((string)me->query("family/family_name") == "昆仑山玉虚洞") {
    tell_room(environment(me), "陆压说道.....\n");
    return "/d/obj/mieyao"->query_yao(me);
  }
  return ("本山人不知道你在说些什么。");
}

void init() { add_action("doAgree", "agree"); }
