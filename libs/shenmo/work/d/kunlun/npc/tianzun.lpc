#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int pk_t;
string feng_shen_start();

void create()
{
set_name("元始天尊", ({"yuanshi tianzun","tianzun"}));
set("long","昆仑派掌门人。\n");
set("title",HIW"道法"NOR);
set("gender", "男性");
set("age", 200);
set("class","xian");
set("attitude", "friendly");
set("rank_info/respect", "圣人");
set("per", 30);
set("int", 30);
set("max_kee", 30000);
set("max_sen", 30000);
set("sen", 30000);
set("kee", 30000);
set("max_force", 9000);
set("max_mana", 9000);
set("mana", 6000);
set("force", 6000);
set("force_factor", 300);
set("mana_factor", 300);
set("combat_exp", 800000000);
set("daoxing", 800000000);
set("eff_dx", 200000);
set("nkgain", 350);

set_skill("unarmed", 350);
set_skill("literate", 350);
set_skill("dodge", 350);
set_skill("force", 350);
set_skill("parry", 350);
set_skill("wugou-jian", 350);
set_skill("sword", 350);
set_skill("whip", 350);
set_skill("spells", 350);
set_skill("xuanzong-force", 350);
set_skill("huntian-jian", 350);
set_skill("lingyunbu", 350);
set_skill("yuxu-spells", 350);
set_skill("kaitian-zhang", 350);
set_skill("dashen-bian", 350);

map_skill("sword", "huntian-jian");
map_skill("mace", "dashen-bian");
map_skill("parry", "wugou-jian");
map_skill("unarmed", "kaitian-zhang");
map_skill("dodge", "lingyunbu");
map_skill("force", "xuanzong-force");
map_skill("spells", "yuxu-spells");
map_skill("unarmed", "jinding-zhang");
create_family("昆仑山玉虚洞", 1, "祖师");

set("inquiry",([
//        "封神"  :  (:feng_shen_start:),
]));    
setup();

carry_object("/obj/cloth")->wear();
carry_object("/d/obj/weapon/sword/changjian")->wield();
}

void attempt_apprentice(object ob,object me)
{
if (ob->query_skill("yuxu-spells",1)  < 160 ) 
        tell_object("你的玉虚仙法不够还是请回吧。\n");
else    {
        command("pat "+ob->query("id"));
        command("say 好，希望" + RANK_D->query_respect(ob) + "多加努力，把我们昆仑派发扬光大。\n");
        command("recruit " + ob->query("id") );
        ob->set("title", HIG"昆仑天尊"NOR);
        }
return;
}

varargs int invocation(object who,int level)
{
mapping skills;
string *skill,str;
int i,skill_lvl;
        
if ( !who )
        return 0;
if ( who->query("env/invisibility") )
        return 0;       
if ( !present(who,environment()) )
        return 0;
if ( !living(who) )
        return 0;       //以上为无符合条件的玩家或玩家离开的限制

if ( query("job_start") )
        return 0;       //已有玩家触发任务，则其他人必须等待更新。                              
        
if ( !level )
        level = who->query("level");
if ( level<who->query("combat_exp")/200000 )
        level = who->query("combat_exp")/200000;

setup();
set("job_start",1);
set("level",level);
set("combat_exp",200000*level);
set("daoxing",200000*level*3);

skill_lvl = to_int(sqrt(to_float(level*20000)));
skill_lvl/= 7;
skill_lvl*= 3;
skill_lvl+= random(skill_lvl/10);

if ( skill_lvl>who->query_skill("force",1)*2 )
        skill_lvl = who->query_skill("force",1)/2*3;

skills = query_skills();
skill = keys(skills);
i = sizeof(skill);
while(i--)
        set_skill(skill[i],skill_lvl);

set("max_force",query_skill("force")*10);
set("max_mana",query_skill("spells")*10);
set("force",query("max_force")*3);
set("mana",query("max_mana")*3);                        
set("force_factor",query_skill("force")/2);
set("mana_factor",query_skill("spells")/2);

add_temp("apply/armor",who->query_temp("apply/armor"));
add_temp("apply/damage",who->query_temp("apply/damage"));

who->set_temp("fazhou/yuanshi_asked",1);

str = ctime(time())+who->query("name")+" "+who->query("id")+" 触发了 武王伐纣 的 第一关 任务.\n";
write("/d/伐纣/log/start",str);
return 1;
}

string feng_shen_start()
{
object who = this_player();
if ( who->query_temp("fazhou/yuanshi_asked") )
        {
        pk_t++;
        if ( pk_t<5 )   
                return "竖子聒噪，言行猥琐，伫旁思过去也！";
        else    {
                pk_t = 0;
                kill_ob(who);
                return "竖子聒噪，言行猥琐，非人也，本尊为民除害耳！"; 
                }
        }
if ( !invocation(who) )
        return "此事还是从头而议。。。。";
return "你既有心协助你姜师叔，我倒要考较考较你的武功。。。。";
}

                
