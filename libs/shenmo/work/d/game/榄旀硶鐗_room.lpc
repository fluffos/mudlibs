//魔法牌房间
#include <ansi.h>
inherit ROOM;
#include "/cmds/std/valid_move.h"

string look_msg();

void create() {
  set("short", HIB "魔法牌" HIC "游戏室" NOR);
  set("long", @MSG
偌大的大厅中摆放着无数张四仙桌，每张桌子相对着
放了两只滕木椅，桌子中间摆放了一叠灵气弥漫的纸
牌。
    每张椅子的桌前刻了一行小篆(word)。
MSG);
  set("item_desc", ([
    "word": (: look_msg :),
    "字": (: look_msg :),
    "小篆": (: look_msg :),
    "篆": (: look_msg :),
  ]));
  set("exits", ([
    "north": "/d/city/clubup",
    "south": __DIR__ "watch",
  ]));
  set("no_time", 1);
  set("no_fight", 1);
  set("valid_startroom", 1);
  set("no_magic", 1);
  setup();
}

string look_msg() {
  string msg;
  object me = this_player();

  if (!me->query_temp("游戏_魔法牌/look"))
    me->set_temp("游戏_魔法牌/look", 1);
  msg = NOR + "\t\t"
    +BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR
    +BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR
    +BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR
    +BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR
    +BLINK BRED "█\n" NOR;
  msg += HIY + @MSG
                        这个是游戏的说明：
                1. 玩家1先挑战(fight)玩家2,然后
                玩家2再在这里挑战玩家1,挑战之前
                要先看游戏说明(look word)
                2. 两人中随便一人提出开始游戏
                (start),双方进入游戏
                3. 系统随机选定先玩者,游戏开始 
                4. 出牌者使用 order <id> 来出自
                己的牌
                5. 看自己的状态可以用 look 命令
                6. 想中途退出者,输入 halt或quit
        
                整个游戏类似于<游戏王>中的游戏.
                游戏处于测试阶段,希望大家能报告
                Bug,好让我能完善它
                              眠兔(snowtu)
                                      2005/12/23
MSG + NOR;
  msg += NOR + "\t\t"
    BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR
    BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR
    BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR
    BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR
    +BLINK BGRN + RED "█\n\n" NOR;

  return msg;
}

void init() {
  add_action("do_start", "start");
  add_action("do_fight", "fight");
}

int do_start() {
  object me, who, room;
  me = this_player();

  if (!objectp(who = me->query_temp("游戏_魔法牌/target"))) {
    write(HIG "游戏大使(Game)告诉你：你找好你的对手先吧。\n" NOR);
    return 1;
  }
  if (!living(who)
    || who->is_busy()
    || who->is_fighting()
    || !valid_move(who)) {
    write(HIG "游戏大使(Game)告诉你：" + who->name() + "暂时没空做你的对手。\n" NOR);
    return 1;
  }
  if (!present(who, this_object())) {
    write(HIG "游戏大使(Game)告诉你：" + who->name() + "还没到这里呢。\n" NOR);
    return 1;
  }
  if (who->query_temp("游戏_魔法牌/target") != me) {
    write(HIG "游戏大使(Game)告诉你：" + who->name() + "没向你挑战。\n" NOR);
    return 1;
  }
  room = clone_object(__DIR__ "game_room");
  if (!room) {
    write(HIG "游戏大使(Game)告诉你：暂时没有你的空位。\n" NOR);
    return 1;
  }
  if (!me->move(room)) {
    write(HIG "游戏大使(Game)告诉你：暂时没有你的空位。\n" NOR);
    return 1;
  } else if (!who->move(room)) {
    write(HIG "游戏大使(Game)告诉你：暂时没有你的空位。\n" NOR);
    me->move(this_object());
    return 1;
  }
  write("开心的玩你的游戏吧。\n");
  room->start_game(me, who);
  return 1;
}

int do_fight(string arg) {
  object target, who, me;
  me = this_player();
  if (!arg) {
    write(HIG "游戏大使(Game)告诉你：你要和哪个挑战呢？\n" NOR);
    return 1;
  }

  who = find_player(arg);
  if (!who) {
    write(HIG "游戏大使(Game)告诉你：找不到" + arg + "......\n" NOR);
    return 1;
  }
  if (who == me || query_ip_number(me) == query_ip_number(who)) {
    write(HIG "游戏大使(Game)告诉你：" + arg + "不是活物......\n" NOR);
    return 1;
  }

  if (who == me->query_temp("游戏_魔法牌/target")) {
    write(HIG "游戏大使(Game)告诉你：你已经向他提出挑战邀请了。\n" NOR);
    return 1;
  }

  if (!living(who)
    || who->is_busy()
    || who->is_fighting()
    || !valid_move(who)) {
    write(HIG "游戏大使(Game)告诉你：" + who->name() + "暂时没空做你的对手。\n" NOR);
    return 1;
  }

  if (!me->query_temp("游戏_魔法牌/target")) {
    write("你决定邀请" + who->name() + "一起玩魔法牌游戏。\n");
    tell_object(who, me->name() + "邀请你一起玩魔法牌游戏，如果你愿意，请去魔法牌游戏室(长安乐坊二楼南间)接受挑战(fight)。\n");
    me->set_temp("游戏_魔法牌/target", who);
    return 1;
  } else {
    target = me->query_temp("游戏_魔法牌/target");
    tell_object(target, me->name() + "取消了和你的约定.\n");
    write("你决定邀请" + who->name() + "一起玩魔法牌游戏。\n");
    tell_object(who, me->name() + "邀请你一起玩魔法牌游戏，如果你愿意，请去魔法牌游戏室(长安乐坊二楼南间)接受挑战(fight)。\n");
    me->set_temp("游戏_魔法牌/target", who);
    return 1;
  }
}
