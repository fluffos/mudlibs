///////////////////////////////////////////////////////////////
////////////////////   hanghai_room.c   ///////////////////////
///////////////////////////////////////////////////////////////

#include <ansi.h>

inherit ROOM;
inherit F_SAVE;

#define MST             __DIR__"hanghai_master"         // 经纬仪，游戏指令主支持
#define HH_GAME_OPEN     "yes"                          // 本游戏是否开放  yes/no


void create() {
  set("short", HIC "〖小航海时代〗 游戏室" NOR);
  set("long", "
***********************************************
              〖小航海时代〗

    欢迎来到 小航海时代 游戏。这里是一个休闲
小游戏，您在游戏获得乐趣的同时，亦将能够得到
一定数量的MUD奖励，以资鼓励。

    进入游戏：         game start


***********************************************
\n");
  set("no_fight", "1");
  set("no_steal", "1");
  set("no_sleep", "1");
  set("valid_startroom", 1);  // 此两条分别为：非连线房间 及 起始房间
  set("no_move", 1);
  set("no_magic", 1);
  set("no_lianhua", 1);
  set("no_time", 1);
  set("freeze", 1);
  set("cost", 0);
  set("exits", ([
    "west": "/d/city/clubup",
  ]));
  setup();
  restore();
}

void init() {
  object me = this_player();
  add_action("do_game", "game");
  add_action("do_wear", "wear");
  add_action("do_wear", "cast");
  //add_action("do_wear","exert");
  add_action("do_wear", "move");
  add_action("do_wear", "burn seal");
  me->command("remove all");
}

int do_game(string arg) {
  string ip;
  object me = this_player(), mst_obj, *env;
  int i;

  if (!arg || arg != "start") return 0;
  if (me->query("age") < 15)
    return notify_fail("你未满15周岁，不能玩此游戏。\n");
  if (me->query("level") < 100)
    return notify_fail("你等级不足１００，不能玩此游戏。\n");
  ip = query_ip_number(me);
  if (!stringp(ip)) { tell_object(me, "ip出错.\n"); return 1; }

  if (time() < query("player/" + ip) + 7200)
    return notify_fail("同一IP两小时内只能参加一人。\n");
  if (time() < query("player/" + me->query("id")) + 14400)
    return notify_fail("同一ID四小时内只能参加一次。\n");
  if (time() < me->query("hanghai_time") + 14400)  //一小时一次
    return notify_fail("你刚刚参加过，还是休息一下吧。\n");
  // "game over" 等操作，由 MST 物件进行。

  if (me->query_temp("hanghai_gameing"))
    return notify_fail("你已身在游戏中！\n");

  if (HH_GAME_OPEN != "yes")
    return notify_fail("本游戏暂停开放！\n");

  if (file_size(MST + ".lpc") < 1)
    return notify_fail("本游戏暂停开放！\n");

  env = all_inventory(this_object());
  if (sizeof(env) > 1) {
    for (i = 0; i < sizeof(env); i++)
      if (env[i] != me && query_ip_name(env[i]) == query_ip_name(me)
        && env[i]->query_temp("hanghai_gameing"))
        return notify_fail("已有与你同样IP的玩家 " + env[i]->query("id") + " 在游戏中了，不允许同IP者同时游戏。\n");
  }

  set("player/" + ip, time());
  set("player/" + me->query("id"), time());
  if (!this_object()->save())
    return notify_fail("航海游戏室存储失败。\n");
  me->set("hanghai_time", time());
  write("\n========= 请稍候，正在执行操作…… ==========\n\n");

  mst_obj = new(MST);
  mst_obj->set("ip", ip);
  mst_obj->set("where", this_object());
  mst_obj->new_game(me);
  mst_obj->move(me);
  return 1;
}

string query_save_file() {
  return "/c/data/room/小航海";
}


int valid_leave(object me, string dir) {
  if (me->query_temp("hanghai_gameing"))
    return notify_fail("你正在游戏中，不得离开！\n");
  me->command("wear all");
  return ::valid_leave(me, dir);
}

void valid_move(object who) {
  object item;
  if (!who) return;
  if (who->query_temp("hanghai_gameing"))
    who->delete_temp("hanghai_gameing");
}

int do_wear() {
  object me = this_player();
  write(HIR "游戏中千万别三心二意！\n");
  return 1;
}
