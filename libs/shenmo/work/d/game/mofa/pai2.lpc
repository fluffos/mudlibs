#include <ansi.h>
inherit __DIR__ "pai.lpc";

void random_name() {
  string *ps;
  int i;
  string name;
  mapping pai = ([
    REV RED "暴怒" NOR: ({ "baonu", 50 }),
    HIR "怒气" NOR: ({ "nuqi", 25 }),
    REV HIR "愤怒" NOR: ({ "fengnu", 35 }),
  ]);

  ps = keys(pai);
  i = random(sizeof(ps));
  name = ps[i];
  set_name(name, ({ pai[name][0] }));
  set("attack_type", "增加");
  set("damage_type", "怒气");
  set("damage", pai[name][1]);
}
