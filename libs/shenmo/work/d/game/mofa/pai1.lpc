#include <ansi.h>
inherit __DIR__ "pai.lpc";

void random_name() {
  string *ps;
  int i;
  string name;
  mapping pai = ([
    HIM "天劫" NOR: ({ "tianjie", "魔法", 25 }),
    HIG "破势刀" NOR: ({ "poshi", "物理", 20 }),
    HIY "金箍棒" NOR: ({ "jingu", "物理", 15 }),
    YEL "枯骨刀" NOR: ({ "kugu", "魔法", 15 }),
    HIR "火魔枪" NOR: ({ "huomo", "物理", 10 }),
    HIR "孔雀翎" NOR: ({ "kongque", "物理", 9 }),
    HIG "碧玉枪" NOR: ({ "biyu", "物理", 8 }),
    HIB "绝情丝" NOR: ({ "jueqing", "物理", 7 }),
    HIY "紫金箫" NOR: ({ "zijin", "物理", 6 }),
    YEL "芭蕉扇" NOR: ({ "bajiao", "魔法", 5 }),
    HIY "降魔棒" NOR: ({ "xiangmo", "物理", 6 }),
    HIB "招魂皤" NOR: ({ "zhaohun", "魔法", 6 }),
    HIC "雁云刀" NOR: ({ "yanyun", "物理", 7 }),
    HIC "凤月刀" NOR: ({ "fengyue", "物理", 8 }),
    HIW "凤凰琴" NOR: ({ "fenghuang", "物理", 9 }),
    HIB "灵蛇鞭" NOR: ({ "lingshe", "魔法", 10 }),
    HIY "缚龙索" NOR: ({ "fulong", "魔法", 15 }),
    HIG "凝碧剑" NOR: ({ "ningbi", "魔法", 20 }),
    HIR "破天剑" NOR: ({ "potian", "物理", 25 }),
  ]);

  ps = keys(pai);
  i = random(sizeof(ps));
  name = ps[i];
  set_name(name, ({ pai[name][0] }));
  set("attack_type", "伤害");
  set("damage_type", pai[name][1] + "伤害");
  set("damage", pai[name][2]);
}
