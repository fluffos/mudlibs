#include <ansi.h>
inherit __DIR__"pai.lpc";

void random_name()
{
string *ps;
int i;
string name;
mapping pai = ([
        HIW"白药"NOR          : ({"baiyao",15}),
        HIG"金创药"NOR          : ({"jinchuang",5}),
        HIW"混元丹"NOR        : ({"yunyuan",5}),
        HIC"跌打药"NOR        : ({"dieda",8}),
        HIR"还魂丹"NOR        : ({"huanhun",8}),        
        HIG"还阳丹"NOR        : ({"hyd",20}),
]);

ps = keys(pai);
i = random(sizeof(ps));
name = ps[i];
set_name(name,({pai[name][0]}));
set("attack_type","增加");
set("damage_type","气血");
set("damage",pai[name][1]);
}

