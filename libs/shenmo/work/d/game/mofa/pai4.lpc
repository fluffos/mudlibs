#include <ansi.h>
inherit __DIR__ "pai.lpc";

void random_name() {
  string *ps;
  int i;
  string name;
  mapping pai = ([
    HIW "猕猴手记" NOR: ({ "shouji", 3 }),
    HIW "长拳拳谱" NOR: ({ "changquan", 2 }),
    HIC "拳法入门" NOR: ({ "quanfa", 1 }),
    HIW "枪法简介" NOR: ({ "jianjie", 1 }),
    HIW "杖法简要" NOR: ({ "jianyao", 1 }),
    HIW "刀法入门" NOR: ({ "rumen", 1 }),
    HIY "青莲剑谱" NOR: ({ "jianpu", 2 }),
    HIW "拆招秘诀" NOR: ({ "chaizhao", 3 }),
  ]);

  ps = keys(pai);
  i = random(sizeof(ps));
  name = ps[i];
  set_name(name, ({ pai[name][0] }));
  set("attack_type", "增加");
  set("damage_type", ({ "物理防御", "物理攻击" })[random(2)]);
  set("damage", pai[name][1]);
}
