#include <ansi.h>
inherit __DIR__"pai.lpc";

void random_name()
{
string *ps;
int i;
string name;
mapping pai = ([
        HIB"双"HIM"色"HIW"冰刀"NOR      : ({"bingdao","中毒",10}),
        HIC"月蚀术"NOR                  : ({"yueshi","中毒",8}), 
        HIM"情思毒"NOR                  : ({"qingsi","中毒",3}), 
        HIB"妖蛇毒"NOR                  : ({"shedu","中毒",2}),        
        HIG"避毒珠"NOR                  : ({"bidu","解毒",0}),
        HIG"荆棘枝"NOR                  : ({"jingji","反击",0}),
        HIG"唤龙神"NOR                  : ({"longshen","反击",5}),
        HIG"祈祷术"NOR                  : ({"qidao","恢复",1+random(5)}),        
        HIG"满弦月"NOR                  : ({"manyue","恢复",8}), 
        HIG"封魔术"NOR                  : ({"fengmo","冰封",0}),
]);

ps = keys(pai);
i = random(sizeof(ps));
name = ps[i];
set_name(name,({pai[name][0]}));
set("attack_type","特殊");
set("damage_type",pai[name][1]);
set("damage",pai[name][2]);
}

