#include <ansi.h>
inherit ROOM;

void create()
{
set("short",HIG"凌霄阁"NOR);
set("long",@LONG
这里是唐朝天子为纪念对国对民有巨大贡献的
天朝臣子所特地建立的功勋殿。
    在这里树立的均是赫赫有名响彻天下的英
雄豪杰的雕像。
LONG);
set("exits",([
        "down" : "/d/city/center",
]));
setup();
}

void init()
{
add_action("do_order","order");
}

int do_order(string arg)
{
object obj,who,me = this_player();
if ( !wizardp(me) )
        return 0;
if ( wiz_level(me)<6 )
        {
        write("你没有这个权限。\n");
        return 1;
        }                       
who = find_player(arg);
if ( !who )
        {
        write("没有这个人。\n");
        return 1;
        }
if ( !living(who) || who->is_fighting() || who->is_busy() )
        {
        write(arg+"现在没有空闲。\n");
        return 1;
        }
obj = new("/d/wiz/npc/diaoxiang");
if ( !obj->information(who) )
        {
      destruct(obj);
        write(arg+"还不够格。\n");
        return 1;
        }
obj->move(this_object());
message("shout","\n"HIC"【"HIG"官府通告"HIC"】奉天承运，皇帝诏曰：今鉴"+who->query("name")+HIC"劳苦功高，特于凌霄阁铸其雕像，以供后世瞻仰。\n\n"NOR,users());      
return 1;
}
