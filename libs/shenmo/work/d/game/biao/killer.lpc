#include <ansi.h>
inherit NPC;
#include <family.h>

string *names = ({
        "土匪","tu fei","fei",
        "盗贼","dao zei","zei",
        "路霸","lu ba","ba",
        "逃犯","tao fan","fan",
        "强盗","qiang dao","dao",
        "恶霸","e ba","ba",
});

void create()
{
mapping mm;     
string name,id1,id2;
int i;
i = random(sizeof(names)/3)*3;
name = names[i];
id1 = names[i+1];
id2 = names[i+2];

mm = NAME_D->random_name("male");
if ( mm && mapp(mm) )
        {
        set_name(mm["name"],mm["id"]);
        set("title",stringp(mm["title"])?mm["title"]:"");
        }
else    set_name(name,({id1,id2}));
set("long","凶神恶煞般一个土人，他目露凶光，满脸横肉。\n");
set("age",20+random(20));
set("per",random(20));
set("gender","男性");

setup();
}

int copy_data(object me)
{
string fam,cls,*skills,*fams;
object weapon;
mapping skill;  
int i,lvl;

if ( !me )
        return 0;
i = me->query_skill("force",1);
if ( lvl<150 )
        lvl = 150;      
fams = keys(familys);
fam = fams[random(sizeof(fams))];
cls = familys[fam]["class"];
skills = familys[fam]["skills"];
weapon = new(familys[fam]["weapon"]);

create_family(fam,2+random(10),"外家弟子");
for(i=0;i<sizeof(skills)/2;i++)
        {
        set_skill(skills[i],lvl);
        set_skill(skills[i+1],lvl);
        map_skill(skills[i],skills[i+1]);
        }
set("max_kee",me->query("max_kee")+1000);
set("max_sen",me->query("max_sen")+1000);
set("max_force",query_skill(query_skill_mapped("force"))*10);
set("max_mana",query_skill(query_skill_mapped("spells"))*10);
if ( fam=="月宫" )
        set("force_factor",0);
else    set("force_factor",query_skill(query_skill_mapped("force")));
set("mana_factor",query_skill(query_skill_mapped("spells")));
set("combat_exp",me->query("combat_exp")/2*3);
set("daoxing",me->query("daoxing")/2*3);

set_temp("apply",me->query_temp("apply"));
add_temp("apply/damage",60);
add_temp("apply/armor",100);
set("level",me->query("level"));

set("str",me->query("str"));
set("spi",me->query("spi"));
set("per",me->query("per"));
set("kar",me->query("kar"));
set("cps",me->query("cps"));
SDS_D->powerup(this_object());
this_object()->save();
this_object()->move(environment(me));
message_vision("\n只见一旁人声鼎沸，喧哗之中，从旁跳出$N，一扬"+ (query_temp("weapon")?query_temp("weapon")->name():"双拳")
+"高声喝道：\n\n
                此山是我开，此树是我栽。
                要打此路过，留下买路财！\n\n",this_object());
return 1;
}

int invocation(object me)
{
if ( !me )
        return 0;               
if ( !SDS_D->random_family(this_object(),me) )
        {
        return 0;
        }
if ( !objectp(environment(me)) )
        return 0;
return copy_data(me);
}               


void die()
{
say("\n\n"+name()+"”啪“的一声摔倒在地！\n\n");
COMBAT_D->announce(this_object(), "revive"); 
message("system", HIY "\n慢慢地你终于又有了知觉．．．\n\n" NOR,this_object()); 
say("\n\n"+name()+"爬起身来，一转身跑的不见了。。。。\n\n");
destruct(this_object());
}

void init()
{
add_action("do_cmds","",1);
add_action("do_go","go");
}

int do_go(string arg)
{
object me = this_player();
if ( me!=query("temp/owner") )  
        return 0;
message_vision("$n一把拉住$N，把$P往死里掐“哪里走？！”\n",me,this_object());
return 1;
}

int do_cmds(string verb)
{
string *cmds;   
object me = this_player();
verb = query_verb();
if ( me!=query("temp/owner") )  
        return 0;
cmds = ({
        "go","hp","inventory","look",
        "skills","score","home","fly",
        "kill","perform","exert",
        "chat","chat*","say","tell",
        "check","wear","remove","wield",
        "unwield","mount","recall",
        "huhuan","huan","update","call","smash",
});

if ( member_array(verb,cmds)==-1 )
        {
        message_vision("$n一把拉住$N，把$P往死里掐：“留下买路钱！”\n",me,this_object());
        return 1;
        }
return 0;
}       
        

