object owner() {
  object owner;
  if (!objectp(owner = query("owner")))
    return 0;
  else return owner;
}

void create() {
  string o_name, name, id;
  int i;
  i = random(sizeof(names) / 3) * 3;
  o_name = names[i];
  name = names[i + 1];
  id = names[i + 2];

  set_name(name, ({ id, "biao che", "che" }));
  set("unit", "辆");
  set("chat_chance", 5);
  set("chat_msg", ({
    "镖车发出”咕噜咕噜“的转动之声。\n",
    "镖车在原地打了个转，又停住了。\n",
  }));
  set("env/msg_min", "“轰隆”一声，镖车走了过来。\n");
  set("env/msg_mout", "“轰隆”一声，镖车开始启程了。\n");
  set("limbs", ({
    "车头", "车身", "车轱辘",
    "镖旗", "镖箱", "车尾",
  }));
  set("max_kee", 100);
  set("max_sen", 100);
  set("eff_kee", 100);
  set("eff_sen", 100);
  set("kee", 100);
  set("sen", 100);
  set("npc_name", o_name);
  setup();
}

string short() {
  if (!owner())
    return "装着" + query("name") + "(" + capitalize(query("id")) + ")的镖车(Biao che)";
  return owner()->query("name") + "的" + clrs[random(sizeof(clrs))] + NOR "镖车(Biao che)";
}

int no_look() {
  return 1;
}

string long() {
  if (!owner())
    return short();
  return short() + "\n 需要将之押运到" + (objectp(owner()->query_temp("压镖/place")) ? owner()->query_temp("压镖/place")->query("short") : "某处") + "。\n";
}

int heal_up() {
  object owner;
  if (environment()->is_character()) {
    die();
    return 1;
  }
  if (!owner() || !present(owner(), environment())) {
    die();
    return 1;
  }
  if (time() > owner()->query_temp("压镖/start") + owner()->query_temp("压镖/time")) {
    die();
    return 1;
  }
  return ::heal_up() + 1;
}

int invocation(object me) {
  int t;

  if (!me)
    return 0;

  t = (60 + random(120)) * 2;
  set("owner", me);
  if (!this_object()->move(environment(me)))
    return 0;
  message(
    "vision",
    "\n只见几名趟子手从堂下押上一辆" + query("npc_name") + "要求押送的装着" + query("name") + "的镖车。\n",
    environment(),
    this_object()
  );
  me->set_temp("压镖/start", time());
  me->set_temp("压镖/time", t);
  this_object()->set_leader(me);
  this_object()->set("max_kee", me->query("max_kee"));
  this_object()->set("max_sen", me->query("max_sen"));
  SDS_D->powerup(this_object());
  return 1;
}

void init() {
  int k, t, tt, ttt;
  int wx, dx, pot, g;
  string msg, str;
  object gold, env, me = this_player();

  add_action("do_go", "go");
  add_action("do_none", "kill");
  add_action("do_none", "fight");
  add_action("do_none", "kill");
  add_action("do_none", "steal");
  add_action("do_none", "kill");
  add_action("do_none", "apply");
  add_action("do_none", "kill");
  add_action("do_none", "ji");

  if (!owner())
    return;
  if (me != owner())
    return;
  env = environment(me);
  if (!objectp(me->query_temp("压镖/place"))) {
    delete("owner");
    return;
  }
  if (env != me->query_temp("压镖/place")) {
    random_npc(me);
    return;
  }
  message_vision("\n镖车走到" + MISC_D->find_place(env) + "地界，但见一群人拥着" + query("npc_name") + "走到
跟前，对着$N作揖感谢道：多谢大侠替在下运送" + name() + "，小小意思，不成敬意。\n\n", me);

  t = time() - me->query_temp("压镖/start");
  tt = me->query_temp("压镖/time");
  if (wizardp(me))
    tell_object(me, "用时 " + FINGER_D->age_string(t) + " 任务需时" + FINGER_D->age_string(tt) + " 。 \n");

  if (t > tt)     //超过时间
  {
    g = random(10000);
    wx = 0;
  } else {
    k = tt - t;
    if (k < 1)
      k = 1;
    g = k;
    if (g < 1) g = 1;
    if (g > 1000000)
      g = 1000000;
    wx = g * 10;
    g *= 3000;
    g = g / 2 + random(g / 2);
    wx = wx / 2 + random(wx);
    dx = wx / 2 + random(wx / 2);
    pot = wx / 5 + random(wx / 5);
  }
  str = MONEY_D->money_str(g);
  if (wx)
    str += YEL "以及 " WHT + wx + YEL " 点武学经验";
  if (dx)
    str += "、" WHT + COMBAT_D->chinese_daoxing(dx) + YEL " 道行";
  if (pot)
    str += "和 " WHT + pot + YEL " 点潜能";

  msg = sprintf(YEL "┣" HIW " 长安护镖" NOR YEL " ┫%s：" WHT "%s " YEL "助我运送" WHT " %s" YEL " ，用时" WHT " %s" YEL " ，特给予" WHT " %s " YEL "以答谢。\n" NOR,
    query("npc_name"), me->query("name"), name(),
    FINGER_D->age_string(t),
    str,);
  message("channel:chat", msg, users());
  me->add("balance", g);
  tell_object(me, "你的钱庄存款增加了" + MONEY_D->money_str(g) + "。\n");
  if (wx) {
    me->add("combat_exp", wx);
    tell_object(me, "你的武学经验增加了" + wx + "点。\n");
  }
  if (dx) {
    me->add("daoxing", dx);
    tell_object(me, "你的道行增加了" + COMBAT_D->chinese_daoxing(dx) + "。\n");
  }
  if (pot) {
    me->add("potential", pot);
    tell_object(me, "你的潜能增加了" + pot + "点。\n");
  }
  me->delete_temp("压镖");
  message_vision("\n" + query("npc_name") + "将镖车接过了手去，急急忙忙的离开了。\n\n", me);
  destruct(this_object());
  return;
}


int is_jiguan() { return 1; }

int do_go(string arg) {
  object me = this_player();
  if (me != owner())
    return 0;
  if (!valid_move(this_object())
    || time() < query("temp/busy") + random(3)
    || this_object()->is_fighting()) {
    tell_object(me, "镖车缓慢的移动着。\n");
    return 1;
  }
  set("temp/busy", time());
  return 0;
}

void random_npc(object me) {
  object env, npc;
  if (!me)
    return;
  if (time() < query("temp/npc_come") + 60) return;
  env = environment();
  if (env->query("no_fight") || env->querey("no_magic"))
    return;
  if (!random(3)) {
    write("你押着镖车，一路无事。。。\n");
    return;
  }
  npc = new(__DIR__ "killer");
  if (!npc->invocation(me))
    return;
  set("temp/npc_come", time());
  npc->set("temp/owner", me);
  npc->set_leader(this_object());
  message_vision(HIR "\n$N" HIR "一眼看到镖车，贪欲迷心，上前开始疯狂哄抢！\n\n" NOR, npc);
  npc->kill_ob(this_object());
  this_object()->fight_ob(npc);
}

void die() {
  string msg;
  object who, me;

  SDS_D->powerup(this_object());
  message_vision("镖车被四周的人一哄而上，抢为一空！\n", this_object());
  me = owner();
  if (!me) {
    message("vision", "\n镖车行到" + MISC_D->find_place(environment()) + "地界，忽地从旁闯去一群流民，
轰隆一声，上前将镖车一抢而空！\n\n", environment(), this_object());
    destruct(this_object());
    return;
  }

  who = query_temp("last_damage_from");
  if (!who) {
    message("vision", "\n镖车行到" + MISC_D->find_place(environment()) + "地界，忽地从旁闯去一群流民，
轰隆一声，上前将镖车一抢而空！\n\n", environment(), this_object());
  } else if (who != me) {
    msg = sprintf(YEL "┣" HIW " 长安护镖" NOR YEL " ┫%s：" WHT "%s " YEL "运送的" WHT " %s" YEL "被" WHT " %s " YEL "哄抢一空 ，真是气煞人也。\n" NOR,
      query("npc_name"), me->query("name"), name(), who->name());
    message("channel:chat", msg, users());
  } else {
    msg = sprintf(YEL "┣" HIW " 长安护镖" NOR YEL " ┫%s：" WHT "%s " YEL "监守自盗，将" WHT " %s" YEL "占为己有 ，真是气煞人也。\n" NOR,
      query("npc_name"), me->query("name"), name());
    message("channel:chat", msg, users());
  }
  me->add("压镖/lost", 1);
  me->delete_temp("压镖");
  destruct(this_object());
  return;
}

void unconcious() {
  die();
}

int attack() {
  return 0;
}

varargs int receive_damage(string type, int damage, object who) {
  if (damage > 100)
    damage = 50 + random(50);
  return ::receive_damage(type, damage, who);
}

varargs int receive_wound(string type, int damage, object who) {
  return receive_damage(type, damage, who);
}

string query_damage_msg(int damage, string type) {
  if (damage == 0) return "镖车纹丝未动，看来一切良好。\n";
  if (damage < 30) return "镖车微微摇晃了一下，侥幸货物没有损坏。\n";
  else if (damage < 60) return "镖车后挫了几下，终于停住了。\n";
  else if (damage < 100) return "镖车向后退了几步，侥幸" + name() + "还算完好。\n";
  else if (damage < 300) return "镖车开始有些破烂不堪，里面的" + name() + "清晰可见。\n";
  else return "镖车破烂不堪，里面的" + name() + "摇晃不定，仿佛就要掉落。。\n";
}

string query_status_msg(int ratio) {
  string str = "镖车";
  if (ratio < 10) return YEL + str + "不住的摇摆，似乎就要损毁！" NOR;
  else if (ratio < 20) return YEL + str + "剧烈的摇摆起来，周围的人开始垂涎欲滴。" NOR;
  else if (ratio < 30) return YEL + str + "开始发出一阵阵的响声，看起来有些不对劲。" NOR;
  else if (ratio < 50) return CYN + str + "轻轻的颤抖着，发出阵阵卡卡之声。" NOR;
  else if (ratio < 70) return HIG + str + "开始有些摇摆不定。" NOR;
  else if (ratio < 90) return HIG + str + "稍微摇晃了一下。" NOR;
  return HIY + str + "一点丝毫未损，没有半丝伤痕。" NOR;
}

string query_eff_status_msg(int ratio) {
  return query_status_msg(ratio);
}
