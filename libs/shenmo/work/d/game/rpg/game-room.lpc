#include <ansi.h>
inherit ROOM;
inherit F_SAVE;

void create() {
  string msg;
  set("short", HIG "魔法大陆" NOR "游戏室");
  msg = YEL "\n\t=====================================\n" NOR;
  msg += HIW "\t\tRPG" HIG "游戏" HIR "  魔法大陆\n" NOR;
  msg += YEL "\t-------------------------------------\n" NOR;
  msg += WHT "\t  欢迎来到 魔法大陆 游戏。这是一个\n\t  休闲小游戏，您在游戏获得乐趣的同\n\t  时，亦将能够得到一定数量的 MUD奖\n\t  励，以资鼓励。 \n" NOR;
  msg += HIG " \t\t进入游戏 :   game start \n" NOR;
  msg += YEL "\t=====================================\n" NOR;
  set("long", msg);
  set("exits", ([
    "west": "/d/city/kezhan",
  ]));
  set("no_fight", 1);
  set("no_move", 1);
  set("no_magic", 1);
  set("valid_startroom", 1);
  set("no_time", 1);
  set("freeze", 1);
  setup();
  if (restore())
    message("channel:rumor", WHT "\n【" HIR "魔法大陆" WHT "】" NOR HIM "魔法大陆游戏室读取数据完毕。\n" NOR, users());
  else message(
    "channel:rumor",
    WHT "\n【" HIR "魔法大陆" WHT "】" NOR HIM "魔法大陆游戏室数据初始完毕。\n" NOR,
    users()
  );
}

string query_save_file() {
  return DATA_DIR "炼妖壶/npc/rpg-room";
}

void init() {
  add_action("do_game", "game");
}

int do_game(string arg) {
  object mst, me = this_player();
  if (!arg || arg != "start")
    return notify_fail("命令格式：game start\n");
  if (me->query_temp("rpg_gameing"))
    return notify_fail("你已经在游戏中了。\n");
  me->set_temp("rpg-gameing", 1);
  mst = new(__DIR__ "rpg-master.lpc");
  mst->set("owner_id", me->query("id"));
  mst->move(me);
  mst->enter_game();
  return 1;
}
