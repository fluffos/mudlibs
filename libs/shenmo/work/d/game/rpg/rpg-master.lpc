#include <ansi.h>
inherit ITEM;
inherit F_SAVE;
#include "errs_func.h"

string SHORT;           //所在地名
string LONG;            //所在描述
string *CMDS;
int MAX_ITEM = 30;      //最大物品数
int X;                  //所在x
int Y;                  //所在y
mapping RPG;

void new_game();
void enter_game();
varargs void map_here(int v);

int is_busy() {
  return query_temp("busy") ? 1 : 0;
}

int is_fighting() {
  return query_temp("is_fight") ? 1 : 0;
}

int target_is_busy() {
  return query_temp("target_busy") ? 1 : 0;
}

int valid_move() {
  if (is_busy())
    return 0;
  if (is_fighting())
    return 0;
  return 1;
}

object owner() {
  if (!query("owner_id"))
    return 0;
  if (!objectp(environment()))
    return 0;
  if (environment()->query("id") != query("owner_id"))
    return 0;
  return environment();
}

void create() {
  set_name(HIG "地图册" NOR, ({ "map book", "ditu ce", "map", "ditu", "tu" }));
  set_weight(1000);
  set("unit", "张");
  set("no_drop", 1);
  set("no_put", 1);
  set("no_give", 1);
  set("no_sell", 1);
  set("no_get", 1);
  setup();
}

string short() {
  return ::short() + YEL " <游戏道具>" NOR;
}

string query_save_file() {
  if (!query("owner_id"))
    return 0;
  return DATA_DIR "炼妖壶/npc/RPGgame-" + query("owner_id");
}

int save() {
  write(YEL "├" NOR HIG " 魔法大陆 " NOR YEL "┤ 即时存储 " WHT ">>>>>>" NOR);
  if (::save())
    write(HIR "成功！\n" NOR);
  else write(HIR "失败！\n" NOR);
  return ::save();
}

int restore() {
  write(YEL "├" NOR HIG " 魔法大陆 " NOR YEL "┤ " NOR);
  if (::restore())
    write(YEL "读取玩家档案成功！\n" NOR);
  else write(YEL "玩家档案初始成功！\n" NOR);
  return ::restore();
}

void init() {
  add_action("do_cmds", "", 1);
  add_action("do_go", "go");
}

int do_go(string arg) {
  object me = this_player();
  string *dirs = ({
    "north", "south", "west", "east",
  });
  if (me != owner())
    return 0;
  if (!valid_move())
    return errs("你现在不能移动。\n");
  if (member_array(arg, dirs) == -1)
    return errs("这个方向没有出路。\n");
  switch (arg) {
    case "north": Y++; break;
    case "south": Y--; break;
    case "west": X--; break;
    case "east": X++; break;
    default: return errs("这个方向没有出路。\n");
  }
  set("x", X);
  set("y", Y);
  map_here(1);
  write(sprintf(YEL "├" NOR HIB " 魔法大陆 " NOR YEL "┤ " NOR YEL "%s 来到了 %s 。\n" NOR,
    me->query("name"), SHORT));
  return 1;
}

varargs void map_here(int v) {
  int i, k;
  string str, arg, str1, str2, str3, str4, str5, str6, str7, str8, *s;
  mapping rpg;

  for (i = 0; i < sizeof(maps); i++) {
    if (query("x") == maps[i]["x"] && query("y") == maps[i]["y"]) {
      rpg = maps[i];
      break;
    }
  }
  if (rpg && stringp(rpg["short"])) {
    CMDS = rpg["cmds"];
    SHORT = rpg["short"];
    LONG = rpg["long"];
  } else {
    CMDS = ({ "look", "inventory", "hp", "go" });
    SHORT = "土路";
    LONG = "一条宽畅的土路。";
  }
  rpg = ([]);
  set("room_short", SHORT);
  set("room_long", LONG);

  str = sprintf(
    YEL "├" NOR HIW " %s " NOR YEL "┤\t" CYN "坐标 " YEL "< " NOR HIR "%d" NOR CYN "," NOR HIR "%d" NOR YEL " >     \n" NOR,
    SHORT,
    query("x"),
    query("y")
  );
  str += sprintf("\n  " NOR "%s\n\n\n" NOR, LONG);

  str += sprintf("%18s┃\n", "");

  for (i = 0; i < sizeof(maps); i++) {
    if (query("x") - 1 == maps[i]["x"] && query("y") + 1 == maps[i]["y"]) {
      rpg = maps[i];
      break;
    }
  }
  if (rpg && stringp(rpg["short"])) {
    str1 = rpg["short"];
    RPG = rpg;
  } else {
    str1 = "土路";
    RPG = ([
      "short": "土路",
      "x": X,
      "y": Y,
      "long": LONG,
    ]);
  }
  rpg = ([]);

  for (i = 0; i < sizeof(maps); i++) {
    if (query("x") == maps[i]["x"] && query("y") + 1 == maps[i]["y"]) {
      rpg = maps[i];
      break;
    }
  }
  if (rpg && stringp(rpg["short"]))
    str2 = rpg["short"];
  else str2 = "土路";
  rpg = ([]);

  for (i = 0; i < sizeof(maps); i++) {
    if (query("x") + 1 == maps[i]["x"] && query("y") + 1 == maps[i]["y"]) {
      rpg = maps[i];
      break;
    }
  }
  if (rpg && stringp(rpg["short"]))
    str3 = rpg["short"];
  else str3 = "土路";
  rpg = ([]);

  str += sprintf("%4s" YEL "%6-s " NOR "━━ " YEL "%6s" NOR " ━━ " YEL "%s\n" NOR,
    "", str1, str2, str3);
  str += sprintf("%18s┃\n", "");


  for (i = 0; i < sizeof(maps); i++) {
    if (query("x") - 1 == maps[i]["x"] && query("y") == maps[i]["y"]) {
      rpg = maps[i];
      break;
    }
  }
  if (rpg && stringp(rpg["short"]))
    str4 = rpg["short"];
  else str4 = "土路";
  rpg = ([]);

  for (i = 0; i < sizeof(maps); i++) {
    if (query("x") + 1 == maps[i]["x"] && query("y") == maps[i]["y"]) {
      rpg = maps[i];
      break;
    }
  }
  if (rpg && stringp(rpg["short"]))
    str5 = rpg["short"];
  else str5 = "土路";
  rpg = ([]);

  str += sprintf("%4s" YEL "%6-s " NOR "━━ " BLINK + HIG "%6s" NOR " ━━ " YEL "%s\n" NOR,
    "", str4, SHORT, str5);
  str += sprintf("%18s┃\n", "");

  for (i = 0; i < sizeof(maps); i++) {
    if (query("x") - 1 == rpg["x"] && query("y") - 1 == rpg["y"]) {
      rpg = maps[i];
      break;
    }
  }
  if (rpg && stringp(rpg["short"]))
    str6 = rpg["short"];
  else str6 = "土路";
  rpg = ([]);

  for (i = 0; i < sizeof(maps); i++) {
    if (query("x") == rpg["x"] && query("y") - 1 == rpg["y"]) {
      rpg = maps[i];
      break;
    }
  }
  if (rpg && stringp(rpg["short"]))
    str7 = rpg["short"];
  else str7 = "土路";
  rpg = ([]);

  for (i = 0; i < sizeof(maps); i++) {
    if (query("x") + 1 == rpg["x"] && query("y") - 1 == rpg["y"]) {
      rpg = maps[i];
      break;
    }
  }
  if (rpg && stringp(rpg["short"]))
    str8 = rpg["short"];
  else str8 = "土路";
  rpg = ([]);
  str += sprintf("%4s" YEL "%6-s " NOR "━━ " YEL "%6s" NOR " ━━ " YEL "%s\n" NOR,
    "", str6, str7, str8);
  str += sprintf("%18s┃\n", "");

  str += "\t\t\t" + stringp(RPG["npc/name"]) ?  //                RPG["npc/name"]+"("+capitalize(RPG["npc/id"])+")":
  RPG["npc/name"] : "";
  str += "\n";

  if (v)
    write(str);
  save();
  return;
}

int do_cmds() {
  int i, k;
  string verb, str, dir, *arg;
  object me = this_player();
  verb = query_verb();

  if (me != environment())
    return 0;
  if (me->query("id") != query("owner_id")
    || !me->query_temp("rpg-gameing")) {
    destruct(this_object());
    return 1;
  }
  if (wizardp(me) && (verb == "dest" || verb == "data" || verb == "call"))
    return 0;
  if (verb == "go")
    return 0;
  /*------------------------------
        game over
------------------------------*/
  if (verb == "quit" || verb == "halt") {
    write(YEL "├ " NOR HIG "魔法大陆" NOR YEL " ┤ " NOR YEL + me->query("name") + YEL "决定退出 魔法大陆 游戏。\n" NOR);
    this_object()->save();
    me->delete_temp("rpg-gameing");
    me->set("game/rpg", time());
    destruct(this_object());
    return 1;
  }

  /*------------------------------
        inventory
------------------------------*/
  else if (verb == "inventory") {
    arg = query("goods");
    if (!arg) {
      write(YEL "目前你身上没有任何东西。\n" NOR);
      return 1;
    }
    i = sizeof(arg);
    if (i < 1) {
      write(YEL "目前你身上没有任何东西。\n" NOR);
      return 1;
    }
    write(sprintf(YEL "你身上带着下列这些东西 (数量 %d%%)：" NOR, i * 100 / MAX_ITEM));
    while (i--)
      write(sprintf(YEL "\n\t\t%s" NOR, arg[i]));
    write("\n");
    return 1;
  }

  /*------------------------------
        help
------------------------------*/
  else if (verb == "help") {
    str = sprintf("%s=========================%s %s魔%s法%s大%s陆%s %s=========================\n" NOR,
      YEL, NOR, HIB, HIM, HIG, HIW, NOR, YEL);
    str += sprintf("%s[%s当前游戏者%s]%s%s(%s)\n" NOR,
      YEL, WHT, YEL, CYN, owner()->query("name"), capitalize(owner()->query("id")),);
    str += sprintf(YEL "------------------------------------------------------------\n" NOR);
    str += sprintf(WHT "    这是一个回合制的泥潭RPG游戏。游戏中获得的一切与泥潭\n" NOR);
    str += sprintf(WHT "并不冲突。另外游戏中的金钱和泥潭中的可以互动(未开放)。\n" NOR);
    str += sprintf(WHT "    游戏中里大部分命令：\n" NOR);
    str += sprintf("         quit|halt       " CYN ":" NOR HIG " 游戏结束\n" NOR);
    str += sprintf("         quit            " CYN ":" NOR HIG " 游戏结束\n" NOR);
    str += sprintf(" inventory|i     " CYN ":" NOR HIG " 查看游戏中的身上物品\n" NOR);
    str += sprintf(" hp              " CYN ":" NOR HIG " 查看游戏中的人物状态\n" NOR);
    str += sprintf(" look|l          " CYN ":" NOR HIG " 查看游戏中的环境\n" NOR);
    str += sprintf(YEL "------------------------------------------------------------\n" NOR);
    str += sprintf(WHT "                                      [" CYN "当前位置" WHT "] " HIM "%s\n" NOR,
      SHORT);
    str += sprintf("%s=========================%s %s天%s上%s人%s间%s %s=========================\n" NOR,
      YEL, NOR, HIC, HIY, HIG, HIW, NOR, YEL);
    write(str);
    return 1;
  }

  /*------------------------------
        look
------------------------------*/
  else if (verb == "look") {
    map_here(1);
    return 1;
  }

  if (member_array(verb, CMDS) == -1) {
    str = "";
    for (i = 0; i < sizeof(CMDS); i++)
      str += CMDS[i] + " ";
    if (wizardp(owner()))
      write("verb=" + verb + "\n");
    return errs(YEL "在这个地方，你只能使用 " NOR HIR + str + NOR YEL "这些命令。\n" NOR);
  }
  return 0;
}

void enter_game() {
  object me;
  me = owner();
  if (!me || !objectp(me))
    return;
  if (!stringp(query("owner_id")))
    return;
  if (me->query("id") != query("owner_id"))
    return;
  if (!restore()) {
    write(sprintf(YEL "├" NOR HIB " 魔法大陆 " NOR YEL "┤ " NOR YEL "游戏初始数据" WHT ">>>>>>>>>>>>>>>>>" YEL "完成。\n" NOR));
    new_game();
  } else {
    write(sprintf(YEL "├" NOR HIB " 魔法大陆 " NOR YEL "┤ " NOR YEL "游戏读取数据" WHT ">>>>>>>>>>>>>>>>>" YEL "完成。\n" NOR));
    write(YEL "├" NOR HIG " 魔法大陆 " NOR YEL "┤ " NOR YEL + owner()->query("name") + YEL "再次进入 魔法大陆 游戏。\n" NOR);
  }
  map_here();
  return;
}

void new_game() {
  X = 0;
  Y = 0;
  if (save())
    write(YEL "├" NOR HIG " 魔法大陆 " NOR YEL "┤ " NOR YEL + owner()->query("name") + YEL "进入 魔法大陆 游戏。\n" NOR);
}
