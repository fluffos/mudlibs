#include <ansi.h>
inherit __DIR__"pai.lpc";

void random_name()
{
string *ps;
int i;
string name;
mapping pai = ([
        HIW"御体术"NOR  : ({"yuti",3}),
        HIC"抵抗力"NOR  : ({"dikang",1}),
        HIY"防身术"NOR  : ({"fangshen",2}),
]);

ps = keys(pai);
i = random(sizeof(ps));
name = ps[i];
set_name(name,({pai[name][0]}));
set("attack_type","增加");
set("damage_type",({"物理防御","物理攻击"})[random(2)]);
set("damage",pai[name][1]);
}

