//游戏主程序

#include <ansi.h>
inherit ROOM;
#include "/cmds/std/valid_move.h"

mapping me_data = ([]);
mapping he_data = ([]);

void new_game(object);
void check(object,object,mapping,mapping);

void create()
{
set("short",HIB"魔法牌游戏桌"NOR);
set("long","\n进了游戏，就安心玩吧，要退出就Quit|halt\n\n");
set("no_time",1);
set("no_fight",1);
set("broadcast",1);
set("no_magic",1);
setup();
}       

void msg(string arg)
{
tell_room(this_object(),WHT"〖"YEL"魔法牌"WHT"〗"+arg+NOR);
}       

void new_game(object who)
{
mapping dd;     
if ( !who )
        return;
dd = ([
        "气血"          : 100,
        "最大气血"      : 100,
        "怒气"          : 0,
        "最大怒气"      : 100,
        "游戏状态"      : "等待",
        "等级"          : 1,
        "经验"      : 0,
        "物理防御"      : 1,
        "物理攻击"      : 1,
        "魔法防御"      : 1,
        "魔法攻击"      : 1,
        "中毒"          : 0,
        "反击"          : 0,
        "冰封"          : 0,
        "恢复"          : 0,
        "物理无效"      : 0,
        "魔法无效"      : 0,
        "变身"          : 0,
]);                     

who->set("游戏_魔法牌",dd);
who->save();
msg(who->query("name")+WHT"游戏数据初始>>>>>>>>>>>>>>>>>>>>>>>>>>完成。\n");
}

void random_pai(object who)
{
object pai;
if ( !who ) return;
if ( random(20)==1 )  pai = new(__DIR__"pai6");
else if ( random(10)==1 )  pai = new(__DIR__"pai4");
else if ( random(10)==1 )  pai = new(__DIR__"pai5");
else if ( random(8)==1 )  pai = new(__DIR__"pai2");
else if ( random(5)==1 )  pai = new(__DIR__"pai3");
else  pai = new(__DIR__"pai1");
if ( !pai ) error("No this Pai\n");
if ( !pai->information(who) )  destruct(pai);
}

void broadcast_room (object room, string str)
{
string prefix = WHT"";
string s1 = str, s2 = "", s3;
int i;

reset_eval_cost();

// remove extra trailing NOR. mon 7/13/99
s1=replace_string(s1,"\n"NOR,"\n");

while (strsrch(s1,"\n\n") != -1)
s1 = replace_string(s1,"\n\n","\n");

while (sizeof(s1)>1 && s1[sizeof(s1)-1]=='\n')
  {
  s1 = s1[0..(sizeof(s1)-2)];
  s2 = "\n";
  }
if (sizeof(s1) <= 1)
    return;

s1 = replace_string(s1,"\n","\n"+prefix);
if ( room )
   tell_room (room, prefix+s1+ NOR+"\n");     
}

void broadcast(string msg) 
{
object room = load_object(__DIR__"watch");
if ( room ) 
   broadcast_room(room,msg);
}


void valid_data(object who)
{
int i;  
object pai;     
mapping dd;     
if ( !who )
        return;
dd = who->query("游戏_魔法牌"); 
dd["time"] = 0;
dd["怒气"] = 0;
dd["游戏状态"] = "等待";
dd["中毒"] = 0;
dd["反击"] = 0;
dd["冰封"] = 0;
dd["恢复"] = 0;
dd["最大魔法防御"] = dd["等级"]*5;
dd["最大魔法攻击"] = dd["等级"]*5;
dd["最大物理攻击"] = dd["等级"]*5;
dd["最大物理防御"] = dd["等级"]*5;
dd["物理防御"] = 0;
dd["物理攻击"] = 0;
dd["魔法攻击"] = 0;
dd["魔法防御"] = 0;
dd["魔法无效"] = 0;
dd["物理无效"] = 0;
dd["变身"] = 0;
dd["牌"] = 0;
dd["气血"] = dd["最大气血"];
i = 4;
while(i--)
        random_pai(who);
who->set_temp("game_pai_looked",1);
}       

int start_game(object me,object who)
{
if ( !me || !who )
        return 0;
if ( !mapp(me->query("游戏_魔法牌")) )
        new_game(me);
if ( !mapp(who->query("游戏_魔法牌")) )                 
        new_game(who);
valid_data(me);
valid_data(who);
me_data = me->query("游戏_魔法牌");
he_data = who->query("游戏_魔法牌");
msg("下面开始乱数决定出牌顺序。\n");
if ( random(2) )
        {
        msg("本轮比赛由"+me->name()+WHT"开局。\n");
        me_data["游戏状态"]="出牌";
        }
else    {
        msg("本轮比赛由"+who->name()+WHT"开局。\n");    
        he_data["游戏状态"]="出牌";
        }
msg("游戏开始！\n");
check(me,who,me_data,he_data);
}


void level_up(object who)
{
mapping dd;
if ( !who )
        return;
message("channel:rumor",WHT"〖"YEL"魔法牌"WHT"〗恭喜！"+who->name()+WHT"升级了！\n"NOR,users());
dd = who->query("游戏_魔法牌"); 
dd["等级"]++;           
dd["经验"] = 0;
dd["物理防御"]++;
dd["物理攻击"]++;
dd["魔法防御"]++;
dd["魔法攻击"]++;
dd["气血"]+= 5;
dd["最大气血"]+= 5;
if ( dd["游戏状态"]=="出牌" ) { valid_data(who);who->set("游戏_魔法牌/游戏状态","出牌");}
else
valid_data(who);
who->save();
}

varargs void game_over(object who,int fail,object target)
{
mapping dd;     
if ( who )
        {
        dd = who->query("游戏_魔法牌"); 
        if ( fail )
                msg("由于"+who->query("name")+WHT"的对手临阵退缩，本次游戏提前结束！\n");
        else    {
                if ( !target )

                        message("channel:rumor",WHT"〖"YEL"魔法牌"WHT"〗恭喜！"+who->query("name")+WHT"战胜了对手，赢得了本次游戏的胜利！\n"NOR,users());
                else    message("channel:rumor",WHT"〖"YEL"魔法牌"WHT"〗恭喜！"+who->query("name")+WHT"战胜了"+target->query("name")+"，赢得了本次游戏的胜利！\n"NOR,users());
                dd["经验"]++;
                //(*)可以在此加入奖励,以后做
                if ( dd["经验"]>=100 )
                        level_up(who);
                }
        if ( target )
                {
                message_vision("\n$N离开了游戏桌，结束了$P的游戏。\n\n",target);
                target->move(__DIR__"room");
                target->delete_temp("游戏_魔法牌");
                }       
        message_vision("\n$N离开了游戏桌，结束了$P的游戏。\n\n",who);
        who->move(__DIR__"room");
        who->delete_temp("游戏_魔法牌");
        }
destruct(this_object());
return;
}       

void play_game(object who,object target)
{
object pai,*ps;
mapping pp;
        
if ( !who )
        return;
        
if ( !who->query_temp("游戏_魔法牌/start") )
        who->set_temp("游戏_魔法牌/start",1);
who->add_temp("游戏_魔法牌/time",1);
if ( who->query_temp("游戏_魔法牌/time")>=60 )
        {
        msg(who->name()+WHT"思考的时间太长了，自动放弃这一次出牌。\n");
        who->set("游戏_魔法牌/游戏状态","等待");
        who->set_temp("游戏_魔法牌/time",0);
        who->delete_temp("游戏_魔法牌/start");
        who->add("游戏_魔法牌/气血",-10);
        printf(WHT"〖"YEL"魔法牌"WHT"〗%s的气血减少了10点！\n"NOR,who->query("name"));
        target->set("游戏_魔法牌/游戏状态","出牌");
        }       
if ( who->query_temp("游戏_魔法牌/time")%6==0 )
         tell_object(who,WHT"〖"YEL"魔法牌"WHT"〗该你出牌(order id)了。\n"NOR);
}
 
void check(object me,object who,mapping me_data,mapping he_data)
{
object pai;     
if ( !me || me->query_temp("netdead") )
        {
        if ( who )
                {
                game_over(who,1);
                return;
                }
        else    {
                game_over();
                return;
                }
        }       
else if ( !who || who->query_temp("netdead") )
        {
        if ( me )
                {       
                game_over(me,1);
                return;
                }
        else    {
                game_over();
                return;
                }               
        }

else if ( he_data["气血"]<=0 )
        {
        game_over(me,0,who);
        return;
        }       
else if ( me_data["气血"]<=0 )
        {
        game_over(who,0,me);
        return;
        }       
                                
if ( he_data["经验"]>=10 )
        level_up(who);
if ( me_data["经验"]>=10 )
        level_up(me);
if ( me_data["怒气"]>=me_data["最大怒气"] )
        {
        msg(me->name()+WHT"全身冒出一股强烈的战气！\n");
        me_data["怒气"]=0;
        me_data["变身"]=1;
        me_data["反击"]=1;
        me_data["中毒"]=0;
        me_data["气血"]+= 10;
        }
if ( he_data["怒气"]>=he_data["最大怒气"] )
        {
        msg(who->name()+WHT"全身冒出一股强烈的战气！\n");
        he_data["怒气"]=0;
        he_data["变身"]=1;
        he_data["反击"]=1;
        he_data["中毒"]=0;
        he_data["气血"]+= 10;
        }
if ( me_data["怒气"]<(-me_data["最大怒气"])
  && me_data["变身"] )
        {
        msg(me->name()+WHT"全身的战气渐渐消失了。\n");
        me_data["怒气"]=0;
        me_data["变身"]=0;
        me_data["反击"]=0;
        }
if ( he_data["怒气"]<(-he_data["最大怒气"])
  && he_data["变身"] )
        {
        msg(who->name()+WHT"全身的战气渐渐消失了。\n");
        he_data["怒气"]=0;
        he_data["变身"]=0;
        he_data["反击"]=0;
        }
if ( me_data["游戏状态"]=="出牌" )
        {
        play_game(me,who);
        random_pai(who);
        }
else    {
        play_game(who,me);
        random_pai(me);
        }
remove_call_out("check");
call_out("check",1,me,who,me_data,he_data);
}

void init()
{
add_action("do_none","",1);     
add_action("do_quit","quit");
add_action("do_quit","halt");
add_action("do_look","look");
add_action("do_look","hp");
add_action("do_look","inventory");
}
 
int do_none()
{
string arg = query_verb();
if ( wizardp(this_player()) )   return 0;
if ( arg=="quit" 
  || arg=="halt"
  || arg=="look"
  || arg=="order"
  || arg=="hp"
  || arg=="say"
  || arg=="chat"
  || arg=="chat*"
  || arg=="tell"
  || arg=="inventory" )
        return 0;
else    {
        tell_object(this_player(),WHT"〖"YEL"魔法牌"WHT"〗请静心游戏吧，你只可以输入halt|quit|look|order|i|hp等命令。\n"NOR);
        return 1;
        }
}

int do_quit()
{
object me,target;
me = this_player();
if ( !userp(me) )    return 0;
if ( !objectp(target=me->query_temp("游戏_魔法牌/target")) )
        return 0;
msg(me->query("name")+WHT"提前退出了游戏。\n");
game_over(target,0,me);
return 1;
}

varargs string look_msg(object me,int self)
{
string arg,str;
object *ps;
mapping mm;
if ( !me )
        return 0;

mm = me->query("游戏_魔法牌");
str = "";
if ( mm["中毒"] )
        str+= "中毒 ";
if ( mm["反击"] )
        str+= "反击 ";
if ( mm["冰封"] )
        str+= "冰封 ";
if ( mm["恢复"] )
        str+= "恢复 ";
if ( mm["变身"] )
        str+= "变身";

arg = WHT"\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"NOR;
arg+= sprintf(CYN" 姓名: %s\t气血: %d\t等级: %s  [%d%%] \t怒气: %d [%d%%]\n"NOR,
            me->query("name"),
            mm["气血"],
            chinese_number(mm["等级"]),
            mm["经验"]*100/10,
            mm["怒气"],
            mm["怒气"]*100/mm["最大怒气"],
            );
if ( self )
        arg+= sprintf(CYN" 状态: %s  [  %s中  ]\n"NOR,str,mm["游戏状态"]);
if ( self )
       arg+= sprintf(CYN" 物防 %d/%d\t魔防 %d/%d\t物攻 %d/%d\t魔攻 %d/%d \n"NOR,mm["物理防御"],mm["最大物理防御"],mm["魔法防御"],mm["最大魔法防御"],mm["物理攻击"],mm["最大物理攻击"],mm["魔法攻击"],mm["最大魔法攻击"]);
if ( self )
        {
        int ss; 
        arg+= sprintf(HIC"□"NOR CYN"目前你手中的牌有"NOR"：\n",me->query("name"));
        ps = me->query("游戏_魔法牌/牌");
        ss = sizeof(ps);
        while(ss--)
                {
                if ( !ps[ss] ) continue;
                arg+= sprintf("\t"+ps[ss]->short())+"\t";
                if ( ss%2==0 )  arg+= "\n"NOR;
                }
        }
arg+= NOR WHT"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"NOR;

return arg;
}

int do_look(string arg)
{
object who,*pai,me=this_player();
int i;
if ( !me->query_temp("游戏_魔法牌/look_msg") )   {
            me->set_temp("游戏_魔法牌/look_msg",1);
            return 1;
            }
if ( !objectp(who=me->query_temp("游戏_魔法牌/target")) )
        return 1;
if ( !arg )
        {
        arg = look_msg(me,1);
        tell_object(me,arg);
        return 1;
        }
if ( arg==who->query("id") )
        {
        arg = look_msg(who);
        tell_object(me,arg);
        return 1;
        }
pai = me->query("游戏_魔法牌/牌");
i = sizeof(pai);
while(i--)
        {
        if ( pai[i] && arg==pai[i]->query("id") )
                return 0;
        }                                       
arg = look_msg(me,1);
tell_object(me,arg);
return 1;
}

