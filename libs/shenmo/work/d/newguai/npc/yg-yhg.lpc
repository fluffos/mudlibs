#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  set("class", "human");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);
  me->set_skill("literate", j);

  me->set_skill("yihua-jiemu", j + random(15));
  me->set_skill("mingyu-jue", j + random(15));
  me->set_skill("sword", j + random(15));
  me->set_skill("feihua-sword", j + random(15));
  me->set_skill("feihua-steps", j + random(15));
  me->set_skill("yihua-force", j + random(15));

  me->map_skill("force", "yihua-force");
  me->map_skill("sword", "feihua-sword");
  me->map_skill("parry", "feihua-sword");
  me->map_skill("spells", "mingyu-jue");
  me->map_skill("dodge", "feihua-steps");
  me->map_skill("unarmed", "yihua-jiemu");

  create_family("移花宫", 2, HIW "花仙" NOR);
  if (!query("nickname"))
    set("nickname", HIG "恨死了！" NOR);

  weapon = new("/d/obj/weapon/sword/qingfeng");
  weapon->move(me);
  carry_object("/d/city/npc/obj/cloth")->wear();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/city/npc/obj/kui")->wear();
  carry_object("/d/city/npc/obj/shoes")->wear();

  command("wield all");
}
