#include <ansi.h>
#include "/cmds/std/valid_move.h"
inherit ITEM;

void create()
{
set_name(YEL"魄石"NOR,({"po","po shi","shi"}));
set_weight(1000);
set("unit",YEL"颗"NOR);
set("value",0);
setup();
}

void init()
{
add_action("do_break","break");
}

int invocation(object npc,object who)
{
mapping snowtu,data;

if ( !npc || !who )
        return 0;
if ( !present(who,environment(npc)) )
        return 0;
if ( random(2) )
          set("zhongkui_give",1);
  else    set("zhongkui_break",1);
set("owner",([
        "g_name" : npc->query("name"),
        "g_id"   : npc->query("id"),
        "p_name" : who->query("name"),
        "p_id"   : who->query("id"),
]));
return 1;
}
                                
int do_break(string arg)
{
int wx,dx,pot;
string str,skill;
mapping snowtu,data;
object me = this_player();
object ob = this_object();

if ( !query("zhongkui_break") )
        return 0;
if ( !arg || !id(arg) )
        return 0;
if ( !mapp(data=query("owner")) )
        return 0;
if ( !mapp(snowtu=me->query_temp("抓鬼奖励")) )
        return 0;
if ( me->query("id")!=data["p_id"] )
        return 0;
if ( !present(ob,me) )
        return 0;
if ( !valid_move(me) )
        return 0;
        
message_vision(HIY"$N"HIY"将$n"HIY"狠狠向地上一砸，”轰隆“一声巨响！！\n"NOR,me,ob);
message("vision",HIY"一道阴风刮过，钟馗带着黑白无常与那开路蝙蝠走到跟前，将"+data["g_name"]+"所化的魂魄带走。\n\n\n"NOR,environment(me));

    wx = snowtu["wx"]*3/4;
    dx = snowtu["dx"]*3/4;
    pot = snowtu["pot"]*3/4;
  str = snowtu["str"];

skill = (__DIR__"yaoguai_reward.lpc")->give_reward(me);
str+= "and rewarded 1 lvl of "+skill+".\n";
//  MONITOR_D->report_system_object_msg(me,str);   
message_vision(CYN+"钟馗由衷的向"+CYN"$N"+CYN"道谢。\n"NOR,me);
  me->add("combat_exp",wx);
  me->add("potential",pot);
  me->add("daoxing",dx);
me->add("zhongkui",1);
me->set("抓鬼/done",1);
//神数，待定
me->add("shen",me->query_temp("抓鬼/level")+1);
tell_object(me,HIY"你得到了"+sprintf("%d",me->query_temp("抓鬼/level")+1)+"点神数的奖励。\n"NOR);
//end
me->add_temp("抓鬼/level",1);
if ( me->query_temp("抓鬼/level")>10 ) 
   me->set_temp("抓鬼/level",1);
tell_object(me,YEL"你得到了"WHT+chinese_number(wx)+YEL"点"RED"武学经验"YEL"和"WHT+chinese_number(pot)+YEL"点"RED"潜能"YEL"！\n"NOR);
if ( random(3)==1 )
        {
        if ( me->query("c_balance")<200000 )
                {
                me->add("c_balance",20000);
                tell_object(me,YEL"另外你的"NOR HIY"富翁卡"NOR YEL"上还增加了 2 两的存款。\n"NOR);
                }
        }
if ( dx )
        tell_object(me,YEL"\n同时你还得到了"WHT+COMBAT_D->chinese_daoxing(dx)+YEL"道行。\n\n"NOR);
        
str = HIC"【"HIG"神仙界"HIC"】钟馗(Zhong kui)："+SDS_D->color_msg(me->query("name_color")+me->query("name"));    
str+= NOR HIC"助我擒回"+data["g_name"]+HIC"("+capitalize(data["g_id"])+HIC")，特奖励";
if ( random(2) )
        str+= chinese_number(wx)+"点武学。\n"NOR;
else    str+= chinese_number(pot)+"点潜能。\n"NOR;
if ( random(100) == 3 )
//  message("channel:chat",str,users());
me->delete_temp("抓鬼奖励");
destruct(this_object());
return 1;
}
                
string long()
{
mapping data;   
string str = YEL"很是奇异的一颗魄石，表面光彩弥溢，充满了灵气。";
data = query("owner");
if ( data && mapp(data) && stringp(data["g_name"]) )
        {
        str+= "仔细一看，原来是"+data["g_name"]+YEL"所化的魄石。";
        if ( query("zhongkui_give") )
                str+= "\n可以将之交(give)给钟馗处理。";
        else    str+= "\n可以将之击碎(break)。";
        }
str+= "\n"NOR;
return str;
}

string short()
{
mapping snowtu,data;    
string str = ::short();
data = query("owner");
if ( data && mapp(data) && stringp(data["g_name"]) )
        str+= MAG" <"NOR HIB+data["g_name"]+NOR MAG">"NOR; 
return str;
}


