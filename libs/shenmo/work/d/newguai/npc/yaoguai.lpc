int is_zhongkui() { return 1; }
void setname() {
  int i, j;
  string *ns, *ids;
  string name, id, id2, i2 = "";
  mapping names = NAME_D->random_name("yaoguai");
  object ob, *player;

  player = users();
  i = random(sizeof(player));
  ob = player[i];

  if (ob && objectp(ob) && objectp(environment(ob)) && !wizardp(ob))  //snowtu
  {
    name = ob->query("name");
    id = capitalize(ob->query("id"));
    id = replace_string(id, " ", "");
    set_name(name, ({ id }));
    set("long", ob->query("long"));
    set("gender", ob->query("gender"));
    set("age", ob->query("age") + 4);
    set("title", ob->query("title"));
    set("nickname", ob->query("nickname"));
    set("race", ob->query("race"));
  } else {
    ids = names["id"];
    name = names["name"];
    i2 = names["title"];
    set_name(name, ids);
    if (i2 != "NONE")
      set("title", i2);
  }
  if (random(10) == 1)
    yaoguai_type = 2;
  else yaoguai_type = 1;
}

void setup() {
  float fwx, flvl;
  mapping my;
  int qi, shen, wx, lvl, i;
  string myforce, myspells, *tf;
  int myforce_lvl, myspells_lvl;
  object ob = this_object();

  ::setup();
  my = query_entire_dbase();
  if (undefinedp(my["age"]))
    my["age"] = random(30) + 15;
  tf = ({ "str", "cor", "int", "spi", "cps", "con", "kar", });
  for (i = 0; i < sizeof(tf); i++) {
    if (undefinedp(my[tf[i]]))
      my[tf[i]] = random(21) + 40;
  }
  qi = (my["con"] + my["str"]) / 2;
  shen = (my["spi"] + my["int"]) / 2;
  if (undefinedp(my["max_kee"])) {
    if (my["age"] <= 14) my["max_kee"] = 10 * qi;
    else if (my["age"] <= 30) my["max_kee"] = (my["age"] - 4) * qi;
    else my["max_kee"] = 26 * qi;
    myforce = ob->query_skill_mapped("force");
    myforce_lvl = ob->query_skill("force");
    if (member_array(myforce, human_class["kee_h"]) > -1)
      my["max_kee"] += myforce_lvl * 3;
    else {
      if (member_array(myforce, human_class["kee_m"]) > -1)
        my["max_kee"] += myforce_lvl * 4;
      else if (member_array(myforce, human_class["kee_l"]) > -1)
        my["max_kee"] += myforce_lvl;
    }
    if (my["max_force"] > 0) my["max_kee"] += my["max_force"] * 2 / 3;
    if (my["max_kee"] < 1) my["max_kee"] = 1;
  }

  if (undefinedp(my["max_sen"])) {
    if (my["age"] <= 14) my["max_sen"] = 10 * shen;
    else if (my["age"] <= 30) my["max_sen"] = (my["age"] - 4) * shen;
    else if (my["age"] <= 40) my["max_sen"] = 26 * shen;
    else {
      if (my["fake_age"] <= 40)
        my["max_sen"] = 26 * shen;
      else my["max_sen"] = 26 * shen - (my["fake_age"] - 40) * 5;
    }
    myspells = ob->query_skill_mapped("spells");
    myspells_lvl = ob->query_skill("spells");

    if (member_array(myspells, xian_class["sen_h"]) > -1)
      my["max_sen"] += myspells_lvl * 3;
    else {
      if (member_array(myspells, xian_class["sen_m"]) > -1) my["max_sen"] += myspells_lvl * 2;
      else if (member_array(myspells, xian_class["sen_l"]) > -1) my["max_sen"] += myspells_lvl;
    }
    if (my["max_mana"] > 0) my["max_sen"] += my["max_mana"] * 2 / 5;
    if (my["max_sen"] < 1) my["max_sen"] = 1;  //mon 1/28/98
  }

  if (undefinedp(my["unit"])) my["unit"] = "位";
  if (undefinedp(my["gender"])) my["gender"] = "男性";
  if (undefinedp(my["can_speak"])) my["can_speak"] = 1;
  if (undefinedp(my["attitude"])) my["attitude"] = "peaceful";
  wx = query("combat_exp");
  fwx = to_float(wx);
  if (wx > 10000000)
    flvl = sqrt(fwx / 400) - 1;
  else flvl = sqrt(fwx / 1000) - 1;
  lvl = to_int(flvl);
  if (query("level") < lvl)
    this_object()->set("level", lvl);
}

void create() {
  setname();
  set("chat_chance", 5);
  set("chat_msg", ({
    (: random_move :)
  }));
  set("chat_chance_combat", 5);
  set("age", 20 + random(80));
  set("shilian", 1);
  set("combat_exp", 30000000);
  set("daoxing", 30000000);
  set("attitude", "heroism");
  set("limbs", ({
    "四白穴", "地仓穴", "大迎穴", "峡车穴", "头维穴", "下关穴", "隐白穴",
    "太白穴", "商丘穴", "地机穴", "少冲穴", "少海穴", "通理穴", "神门穴",
    "印堂穴", "金律穴", "玉液穴", "鱼腰穴", "百劳穴", "百会穴", "灵台穴",
    "太阳穴", "膻中穴", "命门穴", "鸠尾穴", "气海穴"
  }));
  set_living_name("gui guai");
  set("任务", 2);
  set("no_find", 1);  // no_find 标志为了防止使用find命令做zhong kui fang@tsrj
  setup();
}

void copy_status(object me, object ob, int lv) {
  int j, lvl;
  mapping skill;
  int i, *level, max_level, max_sen, max_kee, base;
  base = 20;

  lvl = lv + base - 2;

  skill = ob->query_skills();
  i = sizeof(skill);

  if (i > 0) {
    level = values(skill);
    max_level = level[0];
    while (i--) {
      if (level[i] > max_level)
        max_level = level[i];
    }
    max_level = max_level * lvl / base;
  } else max_level = 100;
  if (max_level < 150)
    max_level = 150;
  set_skills(max_level, lv);

  max_sen = query("max_sen") / 2;
  max_kee = query("max_kee") / 2;
  if (max_sen < 2000) max_sen = 2000;
  if (max_kee < 2000) max_kee = 2000;
  max_kee *= 3;
  max_sen *= 3;
  add("eff_sen", max_sen);
  add("eff_kee", max_kee);
  add("sen", max_sen);
  add("kee", max_kee);
  add("max_sen", max_sen);
  add("max_kee", max_kee);

  add_temp("apply/armor", ob->query_temp("apply/armor"));
  add_temp("apply/damage", ob->query_temp("apply/damage") / 4);
  if (ob->query("max_force") < 2500)
    set("max_force", 2500);
  else set("max_force", ob->query("max_force"));
  if (ob->query("max_mana") < 2500)
    set("max_mana", 2500);
  else set("max_mana", ob->query("max_mana"));
  set("force", query("max_force") * 2);
  set("mana", query("max_mana") * 2);
  if ((query("daoxing") + query("combat_exp")) / 2 > 1000000)
    add("force", query("force"));
  if (query_skill("force") / 20 < 100)
    set("force_factor", 100);
  else set("force_factor", query_skill("force") / 20);
  if (query("max_mana") / 60 < 100)
    set("mana_factor", 100);
  else set("mana_factor", query("max_mana") / 60 + 1);
  if (query("combat_exp") < 3000000)
    set("combat_exp", 3000000);
  set("daoxing", query("daoxing") + query("combat_exp") / 2);
  set("level", ob->query("level"));
}

int random_place(object me, string *dirs) {
  int i, j, k;
  object newob;
  mixed *file, exit;

  if (!sizeof(dirs))
    return 0;

  i = random(sizeof(dirs));    // pick up one directory
  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file))
    return 1;
  for (k = 0; k < 30; k++) {
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight") || newob->query("no_magic")
          || newob->query("no_mieyao") || !(exit = newob->query("exits"))
          || sizeof(exit) < 1)
          continue;
        if (me->move(newob)) {
          message_vision("$N走了过来。\n", me);
          return 1;
        }
      }
    }
  }
  return 0;
}

void _leave() {
  object me = this_object();
  if (owner && me->is_fighting(owner))
    return;
  leave();
}

void quest_fail(object me) {
  if (!me)
    return;
  me->delete_temp("抓鬼/ob");
  me->delete_temp("抓鬼/name");
  me->delete_temp("抓鬼/time_start");
  me->set_temp("抓鬼/level", 1);
  tell_object(me, REV + HIM + "钟馗(Zhong kui)告诉你：你既然无力收服" + query("name") + ", 只好任它去了。\n" NOR);
  tell_object(me, HIY "你的捉鬼任务失败了。\n" NOR);
  me->set("抓鬼/done", 1);
  me->set("抓鬼/time_start", time());
}

void leave() {
  if (!environment())
    return;
  remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());
  message("vision", HIB + name() + HIB "身子一晃，变成一股青烟散去了。\n" NOR, environment());
  if (owner && !present(owner, environment()))
    quest_fail(owner);
  this_object()->move("/obj/empty");
  call_out("leave2", 5);
}

void leave2() {
  remove_call_out("leave2");
  if (this_object())
    destruct(this_object());
}

string invocation(object who, int level) {
  object me = this_object();
  copy_status(me, who, level - 2);
  return _invocation(who, level);
}

string _invocation(object who, int level) {
  object env, me = this_object();
  string *dirs;
  int exp, i, lvl, dx;
  string where, long;

  if (!who || !userp(who))
    return 0;
  owner = who;
  dirs = dirs1;
  if (query("race") == "野兽") {
    if (yaoguai_type == 1) {
      long = "一只" + name() + "，修练了有" + chinese_number((query("daoxing") / 1000 / 10) * 10) + "多年道行。它";
      if (random(2) == 0)
        set("long", long + "通体透出一丝鬼气。\n");
      else set("long", long + "混身上下妖气逼人。\n");
    } else {
      dx = query("daoxing");
      long = "一个" + query("name")[0..<3] + "，在" + ({
        "深山中",
        "密林中",
        "野外",
        "草原上",
        "野林中",
        "高山中",
        "莽林中",
        "莽原上",
        "深谷中",
      })[random(9)] + "汲取" + ({ "日月", "天地", "万物" })[random(3)] + "精华，颇有了些道行。\n";
      set("long", long);
    }
  }
  lvl = level;
  i = random(1000);
  if (i < 10) set("type", "aggressive");
  else if (i < 120) set("type", "blocker");
  else if (i < 320) set("type", "aggressive_on_owner");
  else if (i < 620) set("type", "aggressive_on_owner1");
  else set("type", "normal");
  if (random(10) == 0) {
    set("env/wimpy", 40);
    if (lvl < 9) lvl = lvl + 1;  // as more difficult to kill.
  } else set("env/wimpy", 1);
  exp = who->query("combat_exp") / 2 + who->query("daoxing") / 2;
  if (exp < 30000) {
    exp_reward = 500 + exp / 60;
    pot_reward = 200 + exp / 300;
  } else if (exp < 300000) {
    exp_reward = 1000 + exp / 600;
    pot_reward = 300 + exp / 6000;
    dirs = dirs + dirs2;
  } else if (exp < 3000000) {
    exp_reward = 1500 + exp / 6000;
    pot_reward = 350 + exp / 20000;
    dirs = dirs + dirs2;
  } else {
    exp_reward = 2000;
    pot_reward = 500;
    dirs = dirs + dirs2 + dirs3;
  }
  pot_reward = pot_reward * (lvl + 1) / 5;
  exp_reward = exp_reward * (lvl + 1) / 2;
  me->set("stay_time", time() + 1800);
  if (!random_place(me, dirs)) {
    leave();
    return 0;
  }

  env = environment(me);
  where = me->query("name") + "(" + capitalize(me->query("id")) + ")";
  if (env)
    where += "在" + MISC_D->find_place(env) + env->query("short");
  return where;
}

void heart_beat() {
  string str;
  object me = this_object();

  if (!environment())
    return;
  if (!query_temp("getdd/zhenshens"))
    ("/cmds/std/zhenshens")->main(this_object(), "changeup");
  //防奇门，防衣袖                
  if (environment()->is_qiankun()
    || environment()->is_qimen()) {
    leave();
    return;
  }
  //放安全区，不死区
  if (environment()->query("no_fight")
    || environment()->query("no_magic")
    || environment()->query("alternative_die")) {
    random_move();
    return;
  }
  if (living(this_object()) && (!is_fighting() || !is_busy())) {
    if (query("eff_kee") < query("max_kee"))
      SDS_D->addEffKee(me);
    if (query("kee") < query("eff_kee"))
      SDS_D->addKee(me);
    if (query("sen") < query("eff_sen"))
      SDS_D->addSen(me);
    if (query("eff_sen") < query("max_sen"))
      SDS_D->addEffSen(me);
  }
  if (is_fighting()) {
    if (objectp(query_temp("weapon")))
      str = query_temp("weapon")->query("skill_type");
    else str = "unarmed";
    switch (random(10)) {
      case 9:
      case 8:
      case 1:
      case 0:
        if (!query("no_pfm"))
          SDS_D->randomPfm(this_object(), str);
        break;
      case 2:
      case 7:
      case 8:
      case 3:
        if (!query("no_cast"))
          SDS_D->randomCast(this_object());
        break;
      default:
        SDS_D->randomPfm(this_object(), str);
    }
  }
  ::heart_beat();
}

varargs int receive_wound(string type, int damage, object who) {
  if (!who || !owner || who != owner)
    damage = 1;
  return ::receive_wound(type, damage, who);
}

varargs int receive_damage(string type, int damage, object who) {
  if (!who || !owner || who != owner)
    damage = 1;
  return ::receive_damage(type, damage, who);
}

void die() {
  string skill, str;
  object *ob, stone;
  int max_kee, max_sen, ratio, exp_r, pot_r, i, dx = 0;
  mapping snowtu = ([]);

  if (!owner || !present(owner, environment())
    || !query_temp("last_damage_from")
    || query_temp("last_damage_from") != owner) {
    leave();
    return;
  }

  if (query("force") > 500) {
    SDS_D->addEffKee(this_object());
    SDS_D->addKee(this_object());
    SDS_D->addEffSen(this_object());
    SDS_D->addSen(this_object());
    if (is_busy()) {
      start_busy(1, 100);
      interrupt_me(this_object(), "super_npc");
      reset_action();
    }
  } else {
    SDS_D->powerup(this_object());
    remove_killer(owner);
    owner->remove_killer(this_object());
    stone = new(__DIR__ "po");
    if (!stone)
      return;
    max_kee = query("max_kee");
    max_sen = query("max_sen");
    interrupt_me(this_object(), "wiz");
    ratio = 200 * (max_kee - other_kee) / max_kee;
    if (ratio < 0) ratio = 0;
    ratio = ratio * (max_sen - other_sen) / max_sen;
    if (ratio < 0) ratio = 0;
    exp_r = exp_reward * ratio / 50;
    pot_r = pot_reward * ratio / 50;
    if (exp_r > 10000)
      exp_r = 10000;
    if (pot_r > 10000)
      pot_r = 10000;
    exp_r = exp_r * (owner->query_temp("抓鬼/level") + 1) / 10;
    pot_r = pot_r * (owner->query_temp("抓鬼/level") + 1) / 10;
    str = " got " + exp_r + "/" + exp_reward + " exp " + pot_r + "/" + pot_reward + " pot in level " + owner->query_temp("抓鬼/level");
    if (random(20) > 5) {
      dx = exp_r * 4;
      dx = random(dx / 2);
      str += "and got " + dx + " daoxing.\n";
    }
    snowtu["wx"] = exp_r;
    snowtu["dx"] = dx;
    snowtu["pot"] = pot_r;
    snowtu["str"] = str;
    if (!stone->invocation(this_object(), owner))
      return;
    if (!stone->move(owner))
      return;
    message_vision("\n" + death_msg[random(sizeof(death_msg))] + "\n", owner, this_object());
    owner->set_temp("抓鬼奖励", snowtu);
    destruct(this_object());
    return;
  }
}

void unconcious() {
  die();
}

void chkowner(object who) {
  if (!who || !environment() || base_name(environment()) == "/obj/empty")
    return;
  if (!living(who) || who->is_ghost()) {
    leave();
    return;
  }
  if (!present(who, environment())) {
    SDS_D->powerup(this_object(), 1);
    return;
  }
  if (is_busy()) {
    start_busy(1, 100);
    interrupt_me(this_object(), "super_npc");
    reset_action();
  }
  this_object()->start_call_out((: call_other, __FILE__, "chkowner", who :), random(5));
}

void kill_ob(object who) {
  if (!userp(who) || !owner || who != owner) {
    message_vision(HIW "$N" HIW "说道：「不打了，不打了，我投降。」\n" NOR, this_object());
    who->remove_killer(this_object());
    this_object()->remove_killer(who);
    return;
  }
  if (!is_fighting(who))
    this_object()->start_call_out((: call_other, __FILE__, "chkowner", who :), random(5) + 1);
  ::kill_ob(who);
}
