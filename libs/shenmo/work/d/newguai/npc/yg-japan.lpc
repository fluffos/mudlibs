#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  set("class", "human");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);
  me->set_skill("sword", j);

  me->set_skill("huoxin-sword", j + random(15));
  me->set_skill("spells", j + random(15));
  me->set_skill("renshu", j + random(15));
  me->set_skill("fengyu-piaoxiang", j + random(15));
  me->set_skill("unarmed", j + random(15));
  me->set_skill("kongshoudao", j + random(15));
  me->set_skill("guixi-force", j + random(15));

  me->map_skill("force", "guixi-force");
  me->map_skill("sword", "huoxin-sword");
  me->map_skill("parry", "huoxin-sword");
  me->map_skill("spells", "renshu");
  me->map_skill("dodge", "fengyu-piaoxiang");
  me->map_skill("unarmed", "kongshoudao");

  create_family("剑客联盟", 2, "浪人");
  if (!query("nickname"))
    set("nickname", HIR "日本人遭万人鄙视！！" NOR);

  weapon = new("/d/obj/weapon/sword/qingfeng");
  weapon->move(me);
  carry_object("/d/city/npc/obj/cloth")->wear();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/city/npc/obj/kui")->wear();
  carry_object("/d/city/npc/obj/shoes")->wear();

  command("wield all");
}
