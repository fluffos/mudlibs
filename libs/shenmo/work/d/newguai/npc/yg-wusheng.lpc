#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  create_family("武圣门", 2, "剑祖宗");
  if (!query("nickname"))
    set("nickname", HIW "生于剑亦死于剑" NOR);

  set("class", "xian");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("sword", j + random(15));
  me->set_skill("wuying", j + random(15));
  me->set_skill("mizongbu", j + random(15));
  me->set_skill("xiantian", j + random(15));
  me->set_skill("fumobashi", j + random(15));
  me->set_skill("feisheng", j + random(15));

  me->map_skill("force", "xiantian");
  me->map_skill("sword", "wuying");
  me->map_skill("parry", "wuying");
  me->map_skill("spells", "feisheng");
  me->map_skill("dodge", "mizongbu");
  me->map_skill("unarmed", "fumobashi");

  weapon = new("/d/obj/weapon/sword/qingfeng");
  weapon->move(me);
  carry_object("/d/city/npc/obj/cloth")->wear();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/city/npc/obj/kui")->wear();
  carry_object("/d/city/npc/obj/shoes")->wear();

  command("wield all");
}
