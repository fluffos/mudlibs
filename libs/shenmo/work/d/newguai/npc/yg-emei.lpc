#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  set("class", "human");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);
  me->set_skill("sword", j);

  me->set_skill("dugu-jiujian", j + random(15));
  me->set_skill("spells", j + random(15));
  me->set_skill("zhutian-bu", j + random(15));
  me->set_skill("mahayana", j + random(15));
  me->set_skill("unarmed", j + random(15));
  me->set_skill("jinding-zhang", j + random(15));
  me->set_skill("emeiforce", j + random(15));

  me->map_skill("force", "emeiforce");
  me->map_skill("sword", "dugu-jiujian");
  me->map_skill("parry", "tianlei-sword");
  me->map_skill("spells", "mahayana");
  me->map_skill("dodge", "zhutian-bu");
  me->map_skill("unarmed", "jinding-zhang");

  create_family("峨嵋派", 2, "剑客");
  if (!query("nickname"))
    set("nickname", HIR "不男不女真难受！！" NOR);

  weapon = new("/d/obj/weapon/sword/qingfeng");
  weapon->move(me);
  carry_object("/d/city/npc/obj/cloth")->wear();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/city/npc/obj/kui")->wear();
  carry_object("/d/city/npc/obj/shoes")->wear();

  command("wield all");
}
