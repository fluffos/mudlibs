set("任务",1);
set("no_find",1);// no_find 标志为了防止使用find命令做zhong kui fang@tsrj
setup();
}

void copy_status(object me,object ob, int lv)
{
int j, lvl;
mapping skill;
int i,*level,max_level,max_sen, max_kee,base;
base=20;

lvl=lv+base-2;

skill=ob->query_skills();
i=sizeof(skill);

if( i>0 )
        {
        level=values(skill);
        max_level=level[0];
        while(i--)
                {
                if(level[i]>max_level)
                        max_level=level[i];
                }
        max_level=max_level*lvl/base;
        }
else max_level=100;
if ( max_level<150 )
    max_level = 150;
set_skills(max_level, lv);

max_sen=query("max_sen")/2;
max_kee=query("max_kee")/2;
if ( max_sen<2000 ) max_sen = 2000;
if ( max_kee<2000 ) max_kee = 2000;
max_kee*= 3;
max_sen*= 3;
add("eff_sen",max_sen);
add("eff_kee",max_kee);
add("sen",max_sen);
add("kee",max_kee);
add("max_sen",max_sen);
add("max_kee",max_kee);

add_temp("apply/armor",ob->query_temp("apply/armor"));
add_temp("apply/damage",ob->query_temp("apply/damage")/4);
//sth is wrong,i don't know where,so do it
if ( ob->query("max_force")<2500 )
      set("max_force",2500);
else set("max_force",ob->query("max_force"));
if ( ob->query("max_mana")<2500 )
      set("max_mana",2500);
else set("max_mana",ob->query("max_mana"));
set("force",query("max_force")*2);
set("mana",query("max_mana")*2);
if( (query("daoxing")+query("combat_exp"))/2 >1000000)
        add("force",query("force"));
if ( query_skill("force")/20<100 )
    set("force_factor", 100);
else set("force_factor", query_skill("force")/20);
if ( query("max_mana")/60<100 )
    set("mana_factor", 100);
else set("mana_factor", query("max_mana")/60+1);
if ( query("combat_exp")<3000000 )
      set("combat_exp",3000000);
set("daoxing",(query("daoxing")*2+query("combat_exp"))/2);
set("level",ob->query("level"));
}

int do_qk(string arg)
{
string cast_id,cast_name;
 object who = this_player();
 if (sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
  if(cast_id=="qiankun" || arg=="qiankun")
 tell_object(who,"你隐隐的听到镇元大仙的声音：你这逆徒！休要烂用我观中法术！\n");
 return 1;
}
int random_place(object me, string* dirs)
{
int  i, j, k;
object  newob;
mixed*  file, exit;

if( !sizeof(dirs) )  return 1;
i = random(sizeof(dirs));    // pick up one directory
file = get_dir( dirs[i]+"/*.c", -1 );
if( !sizeof(file) )
        return 1;
for(k=0;k<30;k++)
        {
        j = random(sizeof(file));
        if( file[j][1] > 0 )
                {
                newob=load_object(dirs[i]+"/"+file[j][0]);
                if (newob)
                        {
                        if(newob->query("no_fight") ||
                           newob->query("no_magic") ||
                           newob->query("no_mieyao") ||
                          !(exit=newob->query("exits")) ||
                          sizeof(exit)<1 )
                                continue;

                        if(me->move(newob))
                                {
                                message_vision("$N走了过来。\n",me);
                                return 1;
                                }
                        }
                }
        }
return 0;
}



void _leave()
{
object me=this_object();
if( me->is_fighting() || me->is_busy() )
        return;
leave();
}

void leave()
{
if( !this_object() || !environment() )
        return;
message("vision",HIB+name()+HIB"身子一晃，变成一股青烟散去了。\n" NOR,environment());
this_object()->move("/obj/empty");
call_out("leave2",5);
}

void leave2()
{
remove_call_out("leave2");
if( this_object() )
        destruct(this_object());
}

string invocation(object who, int level)
{
object me=this_object();
copy_status(me,who, level-2);
return _invocation(who,level);
}

string _invocation(object who, int level)
{
object me=this_object(), env;
string *dirs;
int exp, i, lvl,dx;
string where, long;
dirs=dirs1;
set("owner", who->query("id"));
set("owner_ob", who);
if ( query("race")=="野兽" )
        {
        if( yaoguai_type==1 )
                {
                long="一只"+name()+"，修练了有"+ chinese_number((query("daoxing")/1000/10)*10)+"多年道行。它";
                if(random(2)==0)
                        set("long",long+"通体透出一丝鬼气。\n");
                else    set("long",long+"混身上下妖气逼人。\n");
                }
        else    {
                dx=query("daoxing");
                long="一个"+query("name")[0..<3]+"，在"+({"深山中","密林中","野外","草原上","野林中","高山中","莽林中","莽原上","深谷中",})[random(9)]+"汲取"+({"日月","天地","万物"})[random(3)]+"精华，颇有了些道行。\n";
                set("long",long);
                }
        }
lvl=level;
i=random(1000);
if(i<10)        set("type","aggressive");
else if(i<120)  set("type","blocker");
else if(i<320)  set("type","aggressive_on_owner");
else if(i<620)  set("type","aggressive_on_owner1");
else            set("type","normal");
if(random(10)==0)
        {
        set("env/wimpy",40);
        if(lvl<9) lvl=lvl+1; // as more difficult to kill.
        }
else    set("env/wimpy",1);
exp=(who->query("combat_exp")+who->query("daoxing"))/2;
if( exp<30000 )
        {
        exp_reward=500+exp/60;
        pot_reward=200+exp/300;
        }
else if( exp<300000 )
        {
        exp_reward=1000+exp/600;
        pot_reward=300+exp/6000;
        dirs=dirs+dirs2;
        }
else if( exp<3000000 )
        {
        exp_reward=1500+exp/6000;
        pot_reward=350+exp/20000;
        dirs=dirs+dirs2;
        }
else    {
        exp_reward=2000;
        pot_reward=500;
        dirs=dirs+dirs2+dirs3;
        }
pot_reward=pot_reward*(lvl+1)/5;
exp_reward=exp_reward*(lvl+1)/2;
me->set("stay_time", time()+1800);
if(!random_place(me, dirs))
        {
        leave();
        return 0;
        }

env=environment(me);
where=me->query("name")+"("+capitalize(me->query("id"))+")";
if( env )
        where+="在"+ MISC_D->find_place(env) +
               env->query("short");
return  where;
}

void init()
{
::init();
check_env();
if ( this_player()->query("id")==query("owner") && random(10)<3 )
    kill_ob(this_player());
}

varargs int receive_wound(string type, int damage, object who)
{
string owner=query("owner");
object inv;

if ( !owner )
        damage = random(10);
else if ( query_temp("last_damage_from")!=owner )
        damage = random(100);
else    {
        add_temp("be_hitted",1);
        if ( query_temp("be_hitted")%3==0 )
                damage = 0;
        }               
return ::receive_wound(type, damage, who);
}

varargs int receive_damage(string type, int damage, object who)
{
string owner=query("owner");
object inv;

if ( !owner )
        damage = random(100);
else if ( query_temp("last_damage_from")!=owner )
        damage = random(500);
return ::receive_damage(type, damage, who);
}


void heart_beat()
{
string skill,exert;
int i;
object weapon;
object me = this_object();
::heart_beat();
("/cmds/std/zhenshens")->main(this_object(),"changeup");
check_env();
if ( query("eff_kee") < query("max_kee") &&  random(10)==1 )
        SDS_D->addEffKee(me);
if ( query("kee") < query("eff_kee") )
        SDS_D->addKee(me);
if ( query("sen") < query("eff_sen") )
        SDS_D->addSen(me);
if ( query("eff_sen") < query("max_sen") &&  random(10)==1 )
        SDS_D->addEffSen(me);
if ( !me->is_fighting() || !living( me )  )
        return;
if ( objectp(weapon=me->query_temp("weapon")) )
        skill = weapon->query("skill_type");
else    skill = "unarmed";
SDS_D->randomPfm(me,skill);
SDS_D->randomCast(me);
SDS_D->randomExert(me);
}

void die()
{
string owner,skill,str;
object owner_ob,me=this_object(),*ob,stone;
int max_kee, max_sen, ratio, exp_r, pot_r,i,dx=0;
mapping snowtu = ([]);
owner = query("owner");

if( !stringp(owner) || !objectp(owner_ob = find_player(owner)) )
        {
        leave();
        return;
        }
else if ( !present(owner_ob,environment()) )
        {
        say(name()+"说道：可恼，尚到人间没多久，就不明不白的又回去了！\n");
        leave();
        return;
        }
else if ( query_temp("last_damage_from")!=owner_ob )    //no 主杀
        {
        say(name()+"说道：可恼，尚到人间没多久，就给人误杀了！\n");
        leave();
        return;
        }
else if ( query("force")>500 )
        {
        SDS_D->addEffKee(this_object());
        SDS_D->addKee(this_object());
        SDS_D->addEffSen(this_object());
        SDS_D->addSen(this_object());
        SDS_D->randomPfm(this_object(),(query_temp("weapon")?query_temp("weapon")->query("skill_type"):"unarmed"));
        SDS_D->randomCast(this_object());
        return;
        }
else    {
        SDS_D->powerup(me);
        me->remove_killer(owner_ob);
        owner_ob->remove_killer(me);
        stone = new(__DIR__"po");
        if ( !stone )
                return;
        max_kee=query("max_kee");
        max_sen=query("max_sen");
        interrupt_me(this_object(),"wiz"); 
        ratio=200*(max_kee-other_kee)/max_kee;
        if(ratio<0) ratio=0;
        ratio=ratio*(max_sen-other_sen)/max_sen;
        if(ratio<0) ratio=0;
        exp_r=exp_reward*ratio/50;
        pot_r=pot_reward*ratio/50;
        if ( exp_r> 12000 ) 
                exp_r = 12000;
        if ( pot_r> 12000 ) 
                pot_r = 12000;
       exp_r = exp_r * (owner_ob->query_temp("抓鬼/level")+1)/10;
       pot_r = pot_r * (owner_ob->query_temp("抓鬼/level")+1)/10;
        str = " got "+exp_r+"/"+exp_reward+" exp "+pot_r+"/"+pot_reward+" pot in level "+owner_ob->query_temp("抓鬼/level");
        if ( random(20)>5 )
                {
                dx = exp_r*4;
                dx = random(dx/2);
                str+= "and got "+dx+" daoxing.\n";
                }
        snowtu["wx"] = exp_r;
        snowtu["dx"] = dx;
        snowtu["pot"] = pot_r;
        snowtu["str"] = str;
        if ( !stone->invocation(this_object(),owner_ob) )
                return;
        if ( !stone->move(owner_ob) )
                return;                         
        message_vision("\n"+death_msg[random(sizeof(death_msg))]+"\n",owner_ob,this_object());
        owner_ob->set_temp("抓鬼奖励",snowtu);
          destruct(this_object());
        return;
        }
}

void check_env()
{
object env;
env = environment();
if ( !objectp(env) )
        {
        leave();        
        return;
        }
if ( !living(this_object()) )
        return;
if ( env && ( env->query("no_fight") || env->query("no_magic") ) )
        {
        random_move();
        return;
        }
if ( random(2) && strsrch("奇门",env->query("short"))!=-1 && !query("po_qimen") )
        {
        SDS_D->powerup(this_object());
        this_object()->remove_all_killer();
        all_inventory(env)->remove_killer(this_object());
        environment()->self_destruct();
        set("po_qimen",1);
        return;
        }
if ( env->query("alternative_die") )
        {
        SDS_D->powerup(this_object());
        this_object()->remove_all_killer();
        all_inventory(env)->remove_killer(this_object());
        leave();
        }
}               

void unconcious()
{
die();
}
