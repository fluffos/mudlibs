void setname()
{
int i,j;
string *ns,*ids;
string name,id,id2,i2="";
mapping names;
object ob,*player;

player = users();
i = random(sizeof(player));
ob = player[i];

//if ( objectp(ob) && !wizardp(ob) )
// 这个判断 会出现 no id 的现象。改成userp来判断 fang 2005.1.5
if ( ob && userp(ob) && !wizardp(ob) ) 
        {
        name = ob->query("name");
        id = capitalize(ob->query("id"));
        id = replace_string(id," ","");
        set_name(name,({id}));
        set("long",ob->query("long"));
        set("gender",ob->query("gender"));
        set("age",ob->query("age")+4);
        set("title",ob->query("title"));
        set("nickname",ob->query("nickname"));
        set("race", ob->query("race"));
        }
else    {
        ids = names["id"];
        name = names["name"];
        i2 = names["title"];
        set_name(name,ids);
        if ( i2!="NONE" )
                set("title",i2);
        }

if ( random(10)==1 )
        yaoguai_type=2;
else    yaoguai_type=1;
}

void create()
{
setname();
