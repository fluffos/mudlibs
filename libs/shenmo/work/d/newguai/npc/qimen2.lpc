#include <ansi.h>
inherit ROOM;

void create ()
{
set("short","奇门遁甲阵" );
set ("long", @LONG

你突然觉得天旋地转，日月星辰全部消失，再也分不清东西南北。
眼前忽而漆黑一片，忽而亮光四射，忽而金星闪烁，耳边一时万籁
俱寂，一时锣鼓喧天，一股惧意由泥丸升起，直冲天灵，身不由己
地浑身直打颤。
LONG);
set("exits",([
            "north" : __DIR__"qimen1",
            "west" : __DIR__"qimen2",
            "south" : __DIR__"qimen3",
            "east" : __DIR__"qimen4",            
        ]));
setup();
}

int is_qimen()
{
return 1;
}
