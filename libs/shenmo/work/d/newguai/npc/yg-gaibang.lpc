#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  set("class", "human");
  set("xlzhang_agree", 2);
  set("dgbang_agree", 2);
  create_family("丐帮", 2, "要饭的");
  if (!query("nickname"))
    set("nickname", YEL "要饭被狗咬死了" NOR);

  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("stick", j + random(15));
  me->set_skill("dagou-bang", j + random(15));
  me->set_skill("jindouyun", j + random(15));
  me->set_skill("wuxiangforce", j + random(15));
  me->set_skill("shenfa-quan", j + random(15));
  me->set_skill("fumozhou", j + random(15));

  me->map_skill("force", "wuxiangforce");
  me->map_skill("stick", "dagou-bang");
  me->map_skill("parry", "dagou-bang");
  me->map_skill("spells", "fumozhou");
  me->map_skill("dodge", "jindouyun");
  me->map_skill("unarmed", "shenfa-quan");

  weapon = new("/d/obj/weapon/stick/xiangmo");
  weapon->move(me);
  carry_object("/d/city/npc/obj/cloth")->wear();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/city/npc/obj/kui")->wear();
  carry_object("/d/city/npc/obj/shoes")->wear();

  command("wield all");
}
