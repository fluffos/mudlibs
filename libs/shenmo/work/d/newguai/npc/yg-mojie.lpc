#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("class", "yao");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
        me->set_skill("literate",j);
        
        me->set_skill("shifo-zhi", j+random(15));
        me->set_skill("molian-spells", j+random(15));
        me->set_skill("sword",j+random(15));
        me->set_skill("whip",j+random(15));        
        me->set_skill("xueling-jian",j+random(15));
        me->set_skill("liudu-whip",j+random(15));        
        me->set_skill("moshenbu", j+random(15));
        me->set_skill("heilian-force", j+random(15));        

        me->map_skill("force", "heilian-force");
        me->map_skill("sword", "xueling-jian");
        me->map_skill("whip", "liudu-whip");        
        me->map_skill("parry", "xueling-jian");
        me->map_skill("spells", "molian-spells");
        me->map_skill("dodge", "moshenbu");
        me->map_skill("unarmed", "shifo-zhi");

        create_family("魔界", 2,HIB"魔人"NOR);
        set("class","yao");
        if ( !query("nickname") )
                set("nickname",HIR"杀 杀 杀 杀 杀 杀 杀 "NOR);
        if ( random(2) )
                weapon=new("/d/obj/weapon/sword/qingfeng");
        else    weapon=new("/d/obj/weapon/whip/longsuo");       
        weapon->move(me);
        carry_object("/d/city/npc/obj/cloth")->wear();
        carry_object("/d/city/npc/obj/armor")->wear();
        carry_object("/d/city/npc/obj/kui")->wear();
        carry_object("/d/city/npc/obj/shoes")->wear();

        command("wield all");
}

