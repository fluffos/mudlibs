#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("class", "yao");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);

        me->set_skill("blade", j+random(15));
        me->set_skill("zizhi-blade", j+random(15));
        me->set_skill("kongming-steps", j+random(15));
        me->set_skill("youming-spells", j+random(15));
        me->set_skill("jiuyin-force", j+random(15));
        me->set_skill("jiuyin-zhua", j+random(15));
        me->set_skill("sword", j+random(15));
        me->set_skill("qinghu-jian", j+random(15));

        me->map_skill("force", "jiuyin-force");
        me->map_skill("blade", "zizhi-blade");
        me->map_skill("sword","qinghu-jian");
        me->map_skill("parry","qinghu-jian");
        me->map_skill("spells", "youming-spells");
        me->map_skill("dodge", "kongming-steps");
        me->map_skill("unarmed", "jiuyin-zhua");

        me->create_family("轩辕古墓",2,"狐狸精");
	if ( !query("nickname") )
                set("nickname",HIW"生前很好色的"NOR);

        if (random(2))
		weapon=new("/d/city/npc/obj/sword");
        else
           weapon=new("/d/obj/weapon/blade/jindao");
        weapon->move(me);
        carry_object("/d/city/npc/obj/cloth")->wear();
        carry_object("/d/city/npc/obj/armor")->wear();
        carry_object("/d/city/npc/obj/kui")->wear();
        carry_object("/d/city/npc/obj/shoes")->wear();

        command("wield all");
}
