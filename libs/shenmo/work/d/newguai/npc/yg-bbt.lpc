#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  set("class", "yao");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("blade", j + random(15));
  me->set_skill("huaxue-blade", j + random(15));
  me->set_skill("chuanyun-tui", j + random(15));
  me->set_skill("yulong-steps", j + random(15));
  me->set_skill("zhuanlong-force", j + random(15));
  me->set_skill("bihai-spells", j + random(15));
  me->set_skill("fork", j + random(15));
  me->set_skill("yueya-fork", j + random(15));

  me->map_skill("force", "zhuanlong-force");
  me->map_skill("blade", "huaxue-blade");
  me->map_skill("fork", "yueya-fork");
  me->map_skill("parry", "yueya-fork");
  me->map_skill("spells", "bihai-spells");
  me->map_skill("dodge", "yulong-steps");
  me->map_skill("unarmed", "chuanyun-tui");

  create_family("乱石山碧波潭", 2, HIR "水人" NOR);
  if (!query("nickname"))
    set("nickname", HIG "淹死的都是会水的" NOR);


  if (random(2))
    weapon = new("/d/obj/weapon/sword/qingfeng");
  else
    weapon = new("/d/obj/weapon/fork/gangcha");
  weapon->move(me);
  carry_object("/d/city/npc/obj/cloth")->wear();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/city/npc/obj/kui")->wear();
  carry_object("/d/city/npc/obj/shoes")->wear();

  command("wield all");
}
