#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("class", "human");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
        me->set_skill("sword",j);

        me->set_skill("shenghuo-ling", j+random(15));
        me->set_skill("spells",j+random(15));
        me->set_skill("qingfu-shenfa",j+random(15));
        me->set_skill("qiankun-danuoyi", j+random(15));
        me->set_skill("unarmed", j+random(15));
        me->set_skill("qishang-quan", j+random(15));
        me->set_skill("jiuyang-shengong", j+random(15));

        me->map_skill("force", "jiuyang-shengong");
        me->map_skill("sword", "shenghuo-ling");
        me->map_skill("parry", "shenghuo-ling");
        me->map_skill("spells", "qiankun-danuoyi");
        me->map_skill("dodge", "qingfu-shenfa");
        me->map_skill("unarmed", "qishang-quan");

        create_family("明教", 2,"教众");
	if ( !query("nickname") )
                set("nickname",RED"玩火烧死了"NOR);

        weapon=new("/d/obj/weapon/sword/qingfeng");
        weapon->move(me);
        carry_object("/d/city/npc/obj/cloth")->wear();
        carry_object("/d/city/npc/obj/armor")->wear();
        carry_object("/d/city/npc/obj/kui")->wear();
        carry_object("/d/city/npc/obj/shoes")->wear();

        command("wield all");
}
