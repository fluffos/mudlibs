#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  set("class", "yao");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);
  me->set_skill("whip", j);
  me->set_skill("sword", j);

  me->set_skill("ruanhong-zhusuo", j + random(15));
  me->set_skill("kongwujian", j + random(15));
  me->set_skill("spells", j + random(15));
  me->set_skill("jinshe-steps", j + random(15));
  me->set_skill("xiuluo-yinshagong", j + random(15));
  me->set_skill("unarmed", j + random(15));
  me->set_skill("wudu-shenzhang", j + random(15));
  me->set_skill("wudu-xinfa", j + random(15));

  me->map_skill("force", "wudu-xinfa");
  me->map_skill("whip", "ruanhong-zhusuo");
  me->map_skill("sword", "kongwujian");
  me->map_skill("parry", "jinwu-goufa");
  me->map_skill("spells", "xiuluo-yinshagong");
  me->map_skill("dodge", "jinshe-steps");
  me->map_skill("unarmed", "wudu-shenzhang");

  create_family("黄花观五毒门", 2, HIB "毒霸" NOR);
  if (!query("nickname"))
    set("nickname", HIB "被杀毒软件杀死了" NOR);

  weapon = new("/d/sea/obj/dragonwhip");
  weapon->move(me);
  carry_object("/d/city/npc/obj/cloth")->wear();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/city/npc/obj/kui")->wear();
  carry_object("/d/city/npc/obj/shoes")->wear();

  command("wield all");
}
