#include <ansi.h>
inherit NPC;

mapping classes = ([
  "xian": "human",
  "human": "yao",
  "yao": "xian",
]);

string *list_xian = ({
  "putuo", "moon", "wzg", "hell", "dragon",  //"sanxian","kunlun",
  "putuo", "moon", "wzg", "hell", "dragon", "fangcun",
});

string *list_human = ({
  "shushan", "jjf",  //"youxia","swordman","mingjiao","emei","wudang",
  "shushan", "jjf",
});

string *list_yao = ({
  "hyd", "pansi", "xueshan", "wudidong",  //"sanjie","gumu","mojie",
  "hyd", "pansi", "xueshan", "wudidong",
});

string *list = ({
  "putuo", "moon", "wzg", "hell", "dragon", "fangcun",
  "shushan", "jjf",
  "hyd", "pansi", "xueshan", "wudidong",  //"sanjie","gumu","mojie",
  //"sanxian","kunlun",
});

int work_me();
int cancel_me();

void create() {
  set_name("钟馗", ({ "zhong kui", "kui", "zhong" }));
  set("gender", "男性");
  set("long", "阎罗堂前一判官，杀鬼钟馗天下知。\n");
  set("age", 30);
  set("title", "抓鬼判官");
  set("str", 40);
  set("int", 30);
  set("con", 30);
  set("spi", 30);
  set("per", 10);

  set("attitude", "heroism");
  set("combat_exp", 1500000);
  set("task", 1);
  set("daoxing", 2000000);
  set("max_kee", 2000);
  set("max_sen", 2000);
  set("force", 5000);
  set("max_force", 3000);
  set("force_factor", 150);
  set("mana", 5000);
  set("max_mana", 3000);
  set("mana_factor", 150);
  set("eff_dx", 600000);
  set("nkgain", 600);

  set_skill("unarmed", 170);
  set_skill("dodge", 170);
  set_skill("parry", 170);
  set_skill("sword", 180);
  set_skill("force", 170);
  set_skill("spells", 170);
  set_skill("changquan", 170);
  set_skill("liangyi-sword", 180);
  set_skill("baguazhou", 170);
  set_skill("moshenbu", 170);
  set_skill("lengquan-force", 170);

  map_skill("unarmed", "changquan");
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("sword", "liangyi-sword");
  map_skill("parry", "liangyi-sword");
  map_skill("dodge", "moshenbu");

  set("chat_chance", 1);
  set("chat_msg", ({
    name() + "说道：哪位大仙可愿去人间抓拿游魂野鬼？\n",
  }));

  seteuid(getuid());

  set("inquiry", ([
    "mieyao": (: work_me :),
    "kill": (: work_me :),
    "灭妖": (: work_me :),
    "放弃": (: cancel_me :),
    "fangqi": (: cancel_me :),
    "cancel": (: cancel_me :),
    /***********************************************
** 钟馗者，唐贞观二十四年钦点之状元也，	上赏  **
** 其文笔，乃面之。然馗之容陋，上不喜，乃不为 **
** 官，其下有众嗤之。馗不受辱，乃夺殿官之刃刈 **
** 上悔之，乃赐其溢号。后有闻，宫中闹鬼，有青 **
** 面赤须之判官擒而啖之，问之，乃曰：钟山状元 **
** 馗也。以斯事于此一伏笔尔。刘某于零四年初春 **
**	"状元"  " (: aboutMe :),              **
***********************************************/
  ]));

  setup();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/sword/panguanbi")->wield();
}


int cancel_me() {
  object ghost, me = this_player();
  if (!me->query("抓鬼/time_start") ||
    me->query("抓鬼/time_start") + 1800 < time() ||
    me->query("抓鬼/time_start") > time() ||
    me->query("抓鬼/done") || !me->query_temp("抓鬼/ob")) {
    say(CYN + name() + "说道：竖子敢尔，无故来扰老钟！\n");
    return 1;
  }
  ghost = me->query_temp("抓鬼/ob");

  if (!living(ghost))
    say(name() + "恨声说道：" + ghost->query("name") + "这个畜生已经跑了!\n");

  me->delete_temp("抓鬼/ob");
  me->delete_temp("抓鬼/name");
  me->delete_temp("抓鬼/time_start");
  me->set_temp("抓鬼/level", 1);
  say(name() + "无奈地耸耸肩。\n");
  say(name() + "道：你既然无力收服" + ghost->query("name") + ", 只好任它去了。\n");
  me->set("抓鬼/done", 1);
  destruct(ghost);
  return 1;
}

int work_me() {
  object ghost, me;
  int t, lvl;
  me = this_player();
  if (!me->query("抓鬼")) {
    call_out("start_job", 1, me);
    return 1;
  }

  if ((t = (int)me->query("抓鬼/time_start")) &&
    !me->query("抓鬼/done")) {
    if (t <= time() && time() < t + 360) {
      say(name() + "哼了一声。\n");
      say(name() + "道：老钟不是派你去抓那" + me->query("抓鬼/name") + "吗？\n");
      return 1;
    }
    if (!me->query_temp("抓鬼/level_changed")) {
      lvl = me->query_temp("抓鬼/level");
      if (lvl > 0) lvl--;
      me->set_temp("抓鬼/level", lvl);
      me->set_temp("抓鬼/level_changed", 1);
    } else {
      say(name() + "懒洋洋的伸了个懒腰。\n");
      return 1;
    }
  }

  else {

    if (t <= time() && time() < t + 5) {
      message_vision("$N翻开生死簿一看，说" + "：这位" + RANK_D->query_respect(me)
        + ",暂时没有游魂闹事,不妨先去歇息。\n", this_object(), me);
      return 1;
    }

    me->start_busy(2);
    if (!me->query_temp("抓鬼/level_changed")) {
      lvl = me->query_temp("抓鬼/level");
      if (lvl < 9) lvl++;
      else
        lvl = 1;
      me->set_temp("抓鬼/level", lvl);
      me->set_temp("抓鬼/level_changed", 1);
    }
  }

  me->delete("抓鬼/time_start");
  call_out("start_job", 1, me);
  return 1;
}

int start_job(object me) {
  string where, *lists, cls, t_cls;
  object ghost;
  int lvl;

  if (environment(me) != environment())
    return 1;

  if (me->query("抓鬼/time_start"))
    return 1;

  me->delete("抓鬼/done");
  me->set_temp("抓鬼/level_changed", 0);

  lvl = me->query_temp("抓鬼/level");

  if (random(10) == 1) {
    cls = me->query("class");
    if (!cls)
      cls = ({ "xian", "human", "yao" })[random(3)];
    t_cls = classes[cls];
    switch (t_cls) {
      case "human": lists = list_human; break;
      case "xian": lists = list_xian; break;
      default: lists = list_yao;
    }
    ghost = new(__DIR__ + "yg-" + lists[random(sizeof(lists))]);
  } else ghost = new(__DIR__ + "yg-" + list[random(sizeof(list))]);
  where = ghost->invocation(me, lvl);

  message_vision("$N将手中生死簿翻开仔细查找！\n", this_object());
  message_vision("$N对$n说道：近有" + where + "，游荡扰民" + "请速去降服！\n", this_object(), me);
  me->set("抓鬼/time_start", time());
  me->set("抓鬼/name", ghost->query("name"));
  me->set_temp("抓鬼/ob", ghost);
  return 1;
}
