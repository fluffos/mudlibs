#include <ansi.h>
inherit NPC;

mapping classes = ([
        "xian"  : "human",
        "human": "yao",
        "yao"   : "xian",
]);

string *list_xian=({
                "putuo","moon","wzg","hell","dragon","sanxian","kunlun",
                "wusheng","fangcun","xiaoyao",
});

string *list_human = ({
                "shushan","jjf","youxia","japan","mingjiao","emei","shenjian",
                "shaolin","yhg","gaibang",
});

string *list_yao = ({
                "xueshan","wudidong","hyd","bbt","gumu","wudu","sanjie",
                "mojie","pansi","lingjie",
});

string *list = ({
                "putuo","moon","wzg","hell","dragon","fangcun","sanxian","kunlun","wusheng",
                "shaolin","emei","shushan","jjf","youxia","shenjian","yhg","japan","mingjiao",
                "hyd","pansi","xueshan","wudidong","sanjie","gumu","mojie","wudu","bbt",
                "lingjie","xiaoyao","gaibang",
});

int work_me();
int cancel_me();
int do_gift(object ob,object me,mapping data,mapping snowtu);

void create()
{
set_name("钟馗",({"zhong kui", "kui", "zhong" }) );
set("gender", "男性" );
set("long","阎罗堂前一判官，杀鬼钟馗天下知。\n");
set("age",30);
set("title", "抓鬼判官");
set("str", 40);
set("int", 30);
set("con", 30);
set("spi", 30);
set("per", 10);

set("attitude", "heroism");
set("combat_exp", 1500000);
set("daoxing", 2000000);
set("max_kee", 2000);
set("max_sen", 2000);
set("force",5000);
set("max_force",3000);
set("force_factor", 150);
set("mana", 5000);
set("max_mana", 3000);
set("mana_factor", 150);
set("eff_dx", 600000);
set("nkgain", 600);

set_skill("unarmed",170);
set_skill("dodge",170);
set_skill("parry",170);
set_skill("sword", 180);
set_skill("force", 170);
set_skill("spells", 170);
set_skill("changquan", 170);
set_skill("liangyi-sword", 180);
set_skill("baguazhou", 170);
set_skill("moshenbu", 170);
set_skill("lengquan-force", 170);

map_skill("unarmed", "changquan");
map_skill("force", "lengquan-force");
map_skill("spells", "baguazhou");
map_skill("sword", "liangyi-sword");
map_skill("parry", "liangyi-sword");
map_skill("dodge", "moshenbu");

set("chat_chance",1);
set("chat_msg", ({
            name()+"说道：哪位大仙可愿去人间抓拿游魂野鬼？\n",
}));

seteuid(getuid());

set("inquiry", ([
        "mieyao": (: work_me :),
        "kill": (: work_me :),
        "灭妖": (: work_me :),
        "放弃": (: cancel_me :),
        "fangqi": (: cancel_me :),
        "cancel": (: cancel_me :),
/***********************************************
** 钟馗者，唐贞观二十四年钦点之状元也， 上赏  **
** 其文笔，乃面之。然馗之容陋，上不喜，乃不为 **
** 官，其下有众嗤之。馗不受辱，乃夺殿官之刃刈 **
** 上悔之，乃赐其溢号。后有闻，宫中闹鬼，有青 **
** 面赤须之判官擒而啖之，问之，乃曰：钟山状元 **
** 馗也。以斯事于此一伏笔尔。刘某于零四年初春 **
**      "状元"  " (: aboutMe :),              **
***********************************************/
        ]));

setup();
carry_object("/d/obj/armor/jinjia")->wear();
carry_object("/d/obj/weapon/sword/panguanbi")->wield();
}


int cancel_me()
{
object ghost,me=this_player();
if( !me->query("抓鬼/time_start")||
     me->query("抓鬼/time_start")+1800<time() ||
     me->query("抓鬼/time_start")>time() ||
     me->query("抓鬼/done")|| !me->query_temp("抓鬼/ob"))
        {
        say(CYN+name()+"说道：竖子敢尔，无故来扰老钟！\n");
        return 1;
        }
ghost=me->query_temp("抓鬼/ob");

if ( !living(ghost) )
        say(name()+"恨声说道："+ghost->query("name")+"这个畜生已经跑了!\n");

me->delete_temp("抓鬼/ob");
me->delete_temp("抓鬼/name");
me->delete_temp("抓鬼/time_start");
me->set_temp("抓鬼/level",1); 
say(name()+"无奈地耸耸肩。\n");
say(name()+"道：你既然无力收服"+ghost->query("name")+", 只好任它去了。\n");
me->set("抓鬼/done",1);
me->set("抓鬼/time_start",time());
destruct(ghost);
return 1;
}

int work_me()
{
object ghost, me;
int t, lvl;
me=this_player();

 if( me->query("zhongkui") > 7776)
{
  command("say "+me->query("name")+"恭喜你啊！你已经完成了这一世的抓鬼任务，赎满了前世的罪孽。\n");
  return 1;
}
 if( me->query("combat_exp")/500000 > me->query("level")) 
{
  command("say "+me->query("name")+"你的能力不足以后再来吧。\n");
  return 1;
}
if(!me->query("抓鬼"))
        {
        call_out("start_job", 1, me);
        return 1;
        }

if( (t=(int)me->query("抓鬼/time_start")) &&
    !me->query("抓鬼/done"))
        {
        if(t<=time() && time()<t+600)
                {
                say(name()+"哼了一声。\n");
                say(name()+"道：老钟不是派你去抓那"+me->query("抓鬼/name")+"吗？\n");
                return 1;
                }
        if(!me->query_temp("抓鬼/level_changed"))
                {
                lvl=me->query_temp("抓鬼/level");
                if(lvl>0) lvl--;
                me->set_temp("抓鬼/level",lvl);
                me->set_temp("抓鬼/level_changed",1);
                }
        else    {
                say(name()+"懒洋洋的伸了个懒腰。\n");
                return 1;
                }
        }

else    {

        if(t<=time() && time()<t+15)
                {
                message_vision("$N翻开生死簿一看，说"+"：这位"+RANK_D->query_respect(me)
                        +",暂时没有游魂闹事,不妨先去歇息。\n",this_object(), me);
                return 1;
                }

        me->start_busy(2);
        if(!me->query_temp("抓鬼/level_changed"))
                {
                lvl=me->query_temp("抓鬼/level");
                if(lvl<9) lvl++;
                else
                    lvl=1;
                me->set_temp("抓鬼/level",lvl);
                me->set_temp("抓鬼/level_changed",1);
                }
        }

me->delete("抓鬼/time_start");
call_out("start_job", 1, me);
return 1;
}

int start_job(object me)
{
string where,*lists,cls,t_cls;
object ghost;
int lvl;

if( environment(me)!=environment() )
        return 1;

if( me->query("抓鬼/time_start") )
        return 1;

me->delete("抓鬼/done");
me->set_temp("抓鬼/level_changed",0);

lvl=me->query_temp("抓鬼/level");

if ( random(10)==1 )
        {
        cls = me->query("class");
        if ( !cls )
                cls = ({"xian","human","yao"})[random(3)];
        t_cls = classes[cls];
        switch(t_cls)
                {
                case "human" : lists = list_human;break;
                case "xian"  : lists = list_xian;break;
                default : lists = list_yao;
                }
        ghost = new(__DIR__+"yg-"+lists[random(sizeof(lists))]);
        }
else    ghost = new(__DIR__+"yg-"+list[random(sizeof(list))]);
where=ghost->invocation(me,lvl);

message_vision("$N将手中生死簿翻开仔细查找！\n",this_object());
message_vision("$N对$n说道：近有"+where+"，游荡扰民"+"请速去降服！\n",this_object(),me);
me->set("抓鬼/time_start", time());
me->set("抓鬼/name",ghost->query("name"));
me->set_temp("抓鬼/ob",ghost);
//me->set("no_die",1);
return 1;
}

int accept_object(object who,object ob)
{
object me;      
mapping data,snowtu;    
me = who;
if ( ob && ob->query("zhongkui_give") )
        {
        if ( mapp(data=ob->query("owner")) )
                {
                if ( mapp(snowtu=who->query_temp("抓鬼奖励")) ) 
                        return do_gift(ob,me,data,snowtu);
                }       
        }       
return 1;
}

int do_gift(object ob,object me,mapping data,mapping snowtu)
{
int wx,dx,pot;
string str,skill;

if ( !ob || !me )
        return 0;

message_vision(CYN"\n$N"CYN"将$n"CYN"交给"+query("name")+"。\n"NOR,me,ob);

wx = snowtu["wx"];
dx = snowtu["dx"];
pot = snowtu["pot"];
str = snowtu["str"];

skill = (__DIR__"yaoguai_reward.lpc")->give_reward(me);
str+= "and rewarded 1 lvl of "+skill+".\n";
MONITOR_D->report_system_object_msg(me,str);   
message_vision(CYN+"钟馗由衷的向"+CYN"$N"+CYN"道谢。\n"NOR,me);

me->add("combat_exp",wx);
me->add("potential",pot);
me->add("daoxing",dx);
me->add("zhongkui",1);
me->set("抓鬼/done",1);
me->add_temp("抓鬼/level",1);
if ( me->query_temp("抓鬼/level")>10 ) 
   me->set_temp("抓鬼/level",1);

tell_object(me,YEL"你得到了"WHT+chinese_number(wx)+YEL"点"RED"武学经验"YEL"和"WHT+chinese_number(pot)+YEL"点"RED"潜能"YEL"！\n"NOR);
if ( random(3)==1 )
        {
        if ( me->query("c_balance")<200000 )
                {
                me->add("c_balance",20000);
                tell_object(me,YEL"另外你的"NOR HIY"富翁卡"NOR YEL"上还增加了 2 两的存款。\n"NOR);
                }
        }
if ( dx )
        tell_object(me,YEL"\n同时你还得到了"WHT+COMBAT_D->chinese_daoxing(dx)+YEL"道行。\n\n"NOR);
        
str = HIC"【"HIG"神仙界"HIC"】钟馗(Zhong kui)："+me->query("name");    
str+= NOR HIC"助我擒回"+data["g_name"]+HIC"("+capitalize(data["g_id"])+HIC")，特奖励";
if ( random(2) )
        str+= chinese_number(wx)+"点武学。\n"NOR;
else    str+= chinese_number(pot)+"点潜能。\n"NOR;
if ( random(100) == 3 )
message("channel:chat",str,users());
me->delete_temp("抓鬼奖励");
return 1;
}
