#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  set("class", "yao");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("fengtian-steps", j + random(15));
  me->set_skill("guangming-shouyin", j + random(15));
  me->set_skill("guangming-force", j + random(15));
  me->set_skill("kongming-spells", j + random(15));

  me->map_skill("force", "guangming-force");
  me->map_skill("parry", "guangming-shouyin");
  me->map_skill("spells", "kongming-spells");
  me->map_skill("dodge", "fengtian-steps");
  me->map_skill("unarmed", "guangming-shouyin");

  me->create_family("灵界", 2, "幽灵");
  if (!query("nickname"))
    set("nickname", HIB "原来阳世也不好混" NOR);
  weapon = new("/d/obj/weapon/hand/hand4");
  weapon->move(me);
  carry_object("/d/city/npc/obj/cloth")->wear();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/city/npc/obj/kui")->wear();
  carry_object("/d/city/npc/obj/shoes")->wear();
  command("wield all");
}
