void setname()
{
int i,j;
string *ns,*ids;
string name,id,id2,i2="";
object ob,*player;

player = users();
i = random(sizeof(player));
ob = player[i];

//if ( objectp(ob) && !wizardp(ob) )
// 这个判断 会出现 no id 的现象。改成userp来判断 fang 2005.1.5
if ( userp(ob) && !wizardp(ob) ) 
        {
        name = ob->query("name");
        id = capitalize(ob->query("id"));
        id = replace_string(id," ","");
        set_name(name,({id}));
        set("long",ob->query("long"));
        set("gender",ob->query("gender"));
        set("age",ob->query("age")+4);
        set("title",ob->query("title"));
        set("nickname",ob->query("nickname"));
        set("race", ob->query("race"));
        }
else    {
        ids = keys(names);
        id = ids[random(sizeof(ids))];
        ns = names[id];
        name = ns[random(sizeof(ns))];

        while( strlen(name)/8>(2+random(3)) )
                {
                id2 = ids[random(sizeof(ids))];
                if ( id2==id ) continue;
                ns= names[id2];
                name+= ns[random(sizeof(ns))];
                i2+= id2;
                }
        ids=({id+" "+i2,id,i2});
        set_name(name,ids);
        set("race", "野兽");
        if (random(2) > 0 )
                set("gender",random(2)?"雄性":"雌性");
        }

if ( random(10)==1 )
        yaoguai_type=2;
else    yaoguai_type=1;
if ( random(2) )
        set("died_type","break");
else    set("died_type","give");
}

int cast_chance(int level)
{
    return 5+level/2;
}

