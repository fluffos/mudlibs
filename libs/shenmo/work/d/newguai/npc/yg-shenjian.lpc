#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  set("class", "human");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);
  me->set_skill("sword", j);

  me->set_skill("duo-sword", j + random(15));
  me->set_skill("spells", j + random(15));
  me->set_skill("ghost-steps", j + random(15));
  me->set_skill("xueying-xianfa", j + random(15));
  me->set_skill("unarmed", j + random(15));
  me->set_skill("dragonfight", j + random(15));
  me->set_skill("cloudforce", j + random(15));

  me->map_skill("force", "cloudforce");
  me->map_skill("sword", "duo-sword");
  me->map_skill("parry", "duo-sword");
  me->map_skill("spells", "xueying-xianfa");
  me->map_skill("dodge", "ghost-steps");
  me->map_skill("unarmed", "dragonfight");

  create_family("神剑山庄", 2, "剑瞎");
  if (!query("nickname"))
    set("nickname", HIG "我不该用剑的" NOR);

  weapon = new("/d/obj/weapon/sword/qingfeng");
  weapon->move(me);
  carry_object("/d/city/npc/obj/cloth")->wear();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/city/npc/obj/kui")->wear();
  carry_object("/d/city/npc/obj/shoes")->wear();

  command("wield all");
}
