#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  set("class", "xian");
  set("chshjue_agree", 2);
  set("dzxy_agree", 2);
  set("yumo_agree", 2);
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);
  me->set_skill("sword", j);

  me->set_skill("jadesword", j + random(15));
  me->set_skill("spells", j + random(15));
  me->set_skill("lingbo-weibu", j + random(15));
  me->set_skill("tianjijue", j + random(15));
  me->set_skill("unarmed", j + random(15));
  me->set_skill("liumai-shenjian", j + random(15));
  me->set_skill("changshengjue", j + random(15));
  me->set_skill("douzhuan-xingyi", j + random(15));

  me->map_skill("force", "changshengjue");
  me->map_skill("sword", "jadesword");
  me->map_skill("parry", "douzhuan-xingyi");
  me->map_skill("spells", "tianjijue");
  me->map_skill("dodge", "lingbo-weibu");
  me->map_skill("unarmed", "liumai-shenjian");

  create_family("逍遥派", 2, "隐士");
  if (!query("nickname"))
    set("nickname", HIW "我生前很帅的" NOR);

  weapon = new("/d/obj/weapon/sword/qingfeng");
  weapon->move(me);
  carry_object("/d/city/npc/obj/cloth")->wear();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/city/npc/obj/kui")->wear();
  carry_object("/d/city/npc/obj/shoes")->wear();

  command("wield all");
}
