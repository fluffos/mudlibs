void setname()
{
int i,j;
mapping namess;
string *ns,*ids;
string name,id,id2,i2="";
object ob,*player;

player = users();
i = random(sizeof(player));
ob = player[i];

if ( ob && !wizardp(ob) && living(ob) )
	{
	name = ob->query("name");
	id = capitalize(ob->query("id"));
  set_name(name,({id}));
	set("long",ob->query("long"));
  set("task",1);
  set("zjpfm",1);
	set("gender",ob->query("gender"));
	set("age",ob->query("age")+4);
	set("title",ob->query("title"));
	set("nickname",ob->query("nickname"));
	set("race", ob->query("race"));
	}
else	{
        namess = NAME_D->random_name(({"male","female","japan","yaoguai",})[random(4)]);
        ids = namess["id"];
        name = namess["name"];
        set_name(name,ids);

	}

if ( random(10)==1 )
	yaoguai_type=2;
else	yaoguai_type=1;
if ( random(2) )
	set("died_type","break");
else	set("died_type","give");
if ( !query("name") ) setname();
}

int cast_chance(int level)
{
    return 5+level*2;
}

int is_character()
{
return !query("died");
}

