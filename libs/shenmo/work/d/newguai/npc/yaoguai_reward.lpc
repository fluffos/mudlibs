#include <ansi.h>

string give_reward(object me) {
  object book;
  mapping skill = me->query_skills();
  string *skillnames;
  string selected, msg;
  int level, inc = 0;

  if (!skill) return "none";

  skillnames = keys(skill);
  selected = skillnames[random(sizeof(skillnames))];

  level = skill[selected];
  if (level < 200)
    inc = 1;
  else if (level < 300)
    inc = random(2);
  else if (level < 400)
    inc = random(3);
  else if (level < 500)
    inc = random(4);
  else inc = random(10);

  book = new("/obj/money/gold");
  if (book) {
    book->set_amount(30 + random(30));
    if (book->move(me))
      tell_object(me, HIY "你得到了黄金奖励。\n" NOR);
  }
  if ((random(2) || wizardp(me)) && me->query_temp("抓鬼/level") >= 9) {
    book = new("/d/snowtu/team/obj/book");
    if (book)
      book->move(me);
    tell_object(me, YEL "你得到了" + book->query("name") + YEL "！\n" NOR);
    return book->query("name");
  } else if (inc == 1 && (me->query_temp("抓鬼/level") >= 8)) {
    me->set_skill(selected, level + 1);
    tell_object(me, "你得到了一级" + to_chinese(selected) + "。\n");
    message("channel:rumor", HIM "【千里眼】某人：听说" NOR + HIY + me->query("name") + NOR HIM "的" NOR
      +HIY + to_chinese(selected) + NOR + HIM "又有进展了！\n" NOR, users());
    return selected;
  }

  return "none";
}
