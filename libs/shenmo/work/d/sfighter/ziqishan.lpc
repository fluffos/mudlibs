
inherit ROOM;
#include <ansi.h>

void create()
{
  set ("short","紫气山");
	set("long", @LONG
好强大的压迫感，使你几乎透不过气来。山上寸草不生，看来
亦是这强大力量造成的。前方有个山洞，从洞里不断散发出蕴
含着强大力量的紫气。
LONG
	);
set("exits", ([ /* sizeof() == 1 */
  "enter" : "/d/sfighter/cave1",
  "southdown" : "/d/sfighter/houshan2",
]));
  set("objects", ([ /* sizeof() == 1 */
     "/d/sfighter/npc/qinglang":1,
     "/d/sfighter/obj/stone":1,
]));
	setup();
}

int valid_leave(object me,string dir) 
{ 
        object man; 
        if (dir=="southdown")  return ::valid_leave(me,dir);

        if (me->query_skill("power", 1)<500 || me->query_skill("force")<450 ) 
            return notify_fail("你刚踏入洞中，紫气扑面而来，只觉身体快被这强大压力挤爆了，赶紧跑出洞来。\n"); 

        if(!man=present("qing lang",environment(me))) return ::valid_leave(me,dir);

        if (!living(man)) return ::valid_leave(me,dir); 

        if (me) return notify_fail("一个绿色的怪家伙突然挡在洞前，血红的眼睛不怀好意的瞪着你。\n");
 
        return ::valid_leave(me,dir); 
} 
