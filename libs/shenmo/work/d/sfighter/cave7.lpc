#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
 set("short", "洞内");
 set("long", @LONG
洞内紫气(ziqi)纵横，无处不充满着力量，对学武之人来
说，这里无疑是个宝库，只要吸纳这些紫气加以消
化，就能提高自己的能力。但能力低者会控制不了
这股强大的力量，爆体而亡。你环顾四周，豁然发
现在一个不起眼的角落处有一个小小的按钮。
LONG
 );
 set("exits", ([
  "south" : "/d/sfighter/cave6",
]));
        set("item_desc", ([
                "ziqi": "充满了力量的气劲，如果吸纳(xina)成功，可以提高自身的力量。\n"
,
                "紫气": "充满了力量的气劲，如果吸纳(xina)成功，可以提高自身的力量。\n"
,
                "按钮": "一个狮子头形状的按钮，似乎有什么机关？你要不要按(push)下试试。\n"
,

        ]) );
        set("objects", ([
       ]) );
 set("coor/x",10);
 set("coor/y",-620);
 set("coor/z",-20);
 setup();
}
void init()
{ object ob;
 if( interactive( ob = this_player()))
 call_out("blowing", random(10) + 1, ob);
 add_action("do_xina","xina");
 add_action("do_push","push");
}
int blowing(object ob)
{
 int i;
 int damage;
        if(  ob && environment(ob) == this_object())
 {
 if (ob->query("power_lvl")<9){
 tell_object(this_object(), HIR "\n\n你抵受不了紫气的强大压力，体内气血翻腾,皮肤逐渐开裂！！\n\n" NOR);
 COMBAT_D->report_status(ob);
 i=ob->query("power_lvl");
 ob->receive_damage("kee", 50*(9-i));
 if( environment(ob) == this_object())
 call_out("blowing",random(10)+1, ob);
 }}
 else
 return 1;

}


int valid_leave(object me, string dir)
{
        remove_call_out("blowing");
 return 1;
}

int do_xina(string arg)
{
        object obj;
        object me;
        int lvl;
        me = this_player();

	if(me->is_busy()) {write("你正忙着呢。\n");return 1;}

        if(!arg || arg=="")
        {
                write("你要吸纳什么？\n");
                return 1;
        }

        if( arg == "ziqi" || arg == "紫气" )
        {
        lvl=me->query_skill("power",1);
        if (lvl<300) {write("你能力太低，无法吸纳这么强大的力量。\n");return 1;}
        if (lvl>450) {write("以你的能力，吸纳这些紫气已经无法提高自己了。\n");return 1;}
        message_vision("$N运气凝神，专心吸纳紫气。\n",me);
        me->improve_skill("power",random(lvl*3/2));
        if (random(2)) me->start_busy(1);
        return 1;
        }
        else
         write("你吸纳什么？\n");
                return 1;
}

int do_push(string arg)
{
        object obj;
        object me;
        int lvl;
        me = this_player();

	if(me->is_busy()) {write("你正忙着呢。\n");return 1;}

        if(!arg || arg=="")
        {
                return 0;
        }

        if( arg == "按钮")
        {
           if (me->query_temp("sfighter/push")<100){
               message_vision("$N缓缓将手举起，猛的将狮子头按钮按了下去。\n",me);
               message_vision("地下突然传来隆隆的声响，不一会却消失了。\n",me);
               me->add_temp("sfighter/push",1);
               return 1;}
            message_vision("$N第一百次按下了狮子按钮。\n",me);
            message_vision("隆隆声大作，整个地面亦不住晃动了起来。\n",me);
            message_vision("$N所站之处的地板突然消失，$N一个不留神跌了进去。刹那间，地板又恢复原样了。\n",me);
            me->move("/d/sfighter/andao1");
            me->delete_temp("sfighter/push");
        return 1;
        }
        else
                return 0;
}

