#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", "绝境之颠");
  set("long", @LONG
所有的地方生物都已经被破坏灭绝至尽，唯有三个人存在。
Ryu、Ken依然在战斗着，四周气劲弥漫。真·豪鬼静静的
坐在一旁，津津有味的看着这场撕杀。
LONG
  );
  set("exits", ([
  ]));
  set("objects", ([ /* sizeof() == 1 */
    "/d/sfighter/npc/ryu2": 1,
    "/d/sfighter/npc/ken2": 1,
    "/d/sfighter/npc/ghost2": 1,
  ]));
  setup();
}
void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("blowing", random(10) + 1, ob);
}
int blowing(object ob) {
  int i;
  int damage;
  if (ob && environment(ob) == this_object()) {
    if (ob->query("power_lvl") < 9) {
      tell_object(this_object(), HIR "\n\n你抵受不了黑鬭气的强大压力，体内气血翻腾,皮肤逐渐开裂！！\n\n" NOR);
      COMBAT_D->report_status(ob);
      i = ob->query("power_lvl");
      ob->receive_damage("kee", 50 * (10 - i));
      if (environment(ob) == this_object())
        call_out("blowing", random(10) + 1, ob);
    }
  } else
    return 1;

}


int valid_leave(object me, string dir) {
  remove_call_out("blowing");
  return 1;
}
