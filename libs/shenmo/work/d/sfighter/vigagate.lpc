
inherit ROOM;
#include <ansi.h>

void create()
{
  set ("short","别墅门口");
	set("long", @LONG
从近处看，愈加发现这里的豪华，令人感叹不已。门口有2个黑衣人，
看来他们是不会让你进去的。
LONG);
set("exits", ([ /* sizeof() == 1 */
  "north" : "/d/sfighter/road-w2",
  "south" : "/d/sfighter/qianyuan",
]));
  set("objects", ([ /* sizeof() == 1 */
     "/d/sfighter/npc/man":2,
]));
	setup();
}

int valid_leave(object me,string dir) 
{ 
        object man; 
        if (dir=="north" || !man=present("heiyi ren",environment(me)) ) 
          return ::valid_leave(me,dir); 
        if (!living(man)) return ::valid_leave(me,dir); 
        if (me->query("family/master_id") != "viga" ) return notify_fail("你刚想往门内走进去，黑衣人突然出现在你面前，挡住了去路。\n"); 
        return ::valid_leave(me,dir); 
      } 
       
