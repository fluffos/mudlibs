
inherit ROOM;

void check_trigger();
void on_board();
void arrive();
void close_passage();
int do_zhaohuan(string arg);
void reset();

void create()
{
    set("short", "时空隧道");
    set("long", @LONG
这里就是穿越时空的隧道.只见这里停放着
一辆时空穿梭机(plane);
LONG );
    set("exits", ([
     "east" : "/d/sfighter/yuemiao" ,
    ]));
    set("item_desc", ([
        "plane" : "一艘巨大的宇宙飞船，也许喊(zhaohuan)一声驾驶员就能听见。\n",
    ])); 
 set("objects", ([ 
	
        ]));

    set("no_clean_up", 0);
    setup();
}

void init()
{
    add_action("do_zhaohuan", "zhaohuan");
}

void check_trigger()
{
    object room;

    if(!query("exits/enter") ) {
        if( !(room = find_object(__DIR__"plane")) )
            room = load_object(__DIR__"plane");
        if( room = find_object(__DIR__"plane") ) {
            if((int)room->query("zhaohuan_trigger")==0 ) {
                room->set("zhaohuan_trigger", 1);
                set("exits/enter", __DIR__"plane");
                room->set("exits/out", __FILE__);
                message("vision", "一辆巨型时空穿梭机缓缓地驶了过来，驾驶员将登机"
                    "台靠了上去，以便乘客\n上下。\n", this_object() );
                message("vision", "驾驶员将登机台放下，形成一个向上"
                    "的阶梯。\n", room);
                remove_call_out("on_board");
                call_out("on_board", 15);
            }
            else
                message("vision", "只听得茫茫宇宙上隐隐传来：“别急嘛，"
                    "这儿正忙着呐……”\n",this_object() );
        }
        else
            message("vision", "ERROR: plane not found\n", this_object() );
    }
    else 
        message("vision", "驾驶员说道：正等着你呢，上来吧。\n",
            this_object() );
}


void on_board()
{
    object room;

    if( !query("exits/enter") ) return;

    message("vision", "驾驶员把登机台收了起来，发动引擎，穿梭机消失在茫茫宇宙中。\n",
        this_object() );

    if( room = find_object(__DIR__"duchuan") )
    {
        room->delete("exits/out");
        message("vision", "驾驶员把跳板收起来，说了一声“坐稳喽”，"
            "引擎一启动，穿梭机向\n茫茫宇宙中驶去。\n", room );
    }
    delete("exits/enter");

    remove_call_out("arrive");
    call_out("arrive", 20);
}

void arrive()
{
    object room;
    if( room = find_object(__DIR__"plane") )
    {
        room->set("exits/out", "/d/city/kezhan");
        message("vision", "驾驶员说“到啦，穿梭时候成功”，随即把一块跳板"
            "放下。\n",room );
    }
    remove_call_out("close_passage");
    call_out("close_passage", 20);
}

void close_passage()
{
    object room;
    if( room = find_object(__DIR__"plane") ) {
        room->delete("exits/out");
        message("vision","驾驶员发动引擎，不一会儿，时空穿梭机就消失在茫茫宇宙中。\n", room);
        room->delete("zhaohuan_trigger"); 
    }
}

int do_zhaohuan(string arg)
{
    string dir;

    if( !arg || arg=="" ) return notify_fail("你要吆喝什么？\n");

    if( arg=="plane" ) arg = "驾驶员";
    if( (int)this_player()->query("age") < 16 )
        message_vision("$N使出吃奶的力气喊了一声：“" + arg + "”\n",
            this_player());
    else if( (int)this_player()->query("force") > 500 )
        message_vision("$N吸了口气，一声“" + arg + "”，声音中正平和地远远传"
            "了出去。\n", this_player());
    else
        message_vision("$N鼓足中气，长啸一声：“" + arg + "！”\n",
            this_player());
    if( arg=="驾驶员")
    {
        check_trigger();
        return 1;
    }
    else
        message_vision("隧道中远远传来一阵回声：“" + arg +
            "～～～”\n", this_player());
    return 1;
}

void reset()
{
    object room;

    ::reset();
    if( room = find_object(__DIR__"plane") )
        room->delete("zhaohuan_trigger"); 
}

