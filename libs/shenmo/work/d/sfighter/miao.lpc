inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "庙");
  set("long", @LONG
庙里非常昏暗，迎面的架子上立着许许多多的灵位(lingwei)。
底下有位老人正在擦拭这些灵牌。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "east": "/d/sfighter/room2",
    "out": "/d/sfighter/room1",
  ]));
  set("no_fight", 1);
  set("objects", ([ /* sizeof() == 1 */

    "/d/sfighter/npc/gangquan": 1,
  ]));
  set("item_desc", ([
    "lingwei": "元武门各代祖师的灵位。\n"
    ,
    "灵位": "元武门各代祖师的灵位。\n"
    ,
  ]));

  setup();
}

void init() {
  add_action("do_cashi", "cashi");
}

int do_cashi(string arg) {
  object obj;
  object me;
  int mykar, myint;
  me = this_player();

  if (me->is_busy()) { write("你正忙着呢。\n"); return 1; }

  if (!arg || arg == "") {
    write("你要擦拭什么？\n");
    return 1;
  }

  if (arg == "lingwei" || arg == "灵位") {
    if (me->query("family/master_id") != "gang quan" && me->query("family/master_id") != "ryu" && me->query("family/master_id") != "ken" && me->query("family/master_id") != "dan") {
      message_vision("刚拳说道：你想干什么！！\n", me); return 1;
    }

    mykar = me->query("kar");

    if (me->query_skill("ghost-spirit", 1)) return notify_fail("你甫一碰到灵位，灵位突然发出一股奇异的劲道将你震开。\n");
    if (mykar < random(45)) return notify_fail("你恭敬地将灵位都仔细擦拭了一遍。\n");

    tell_object(me, "$N一不小心将祖师的灵位碰倒了，急忙将灵位扶起，却发现灵位后面似乎刻着什么。\n");
    tell_object(me, "$N急忙定睛一看，只见上面刻着：\n\n");
    tell_object(me, "元武门诸弟子：\n");
    tell_object(me, "     神武天皇欲强夺吾元武门秘籍，吾恐实力微薄，无法守住，故将秘籍下册内容刻于此处。\n");
    tell_object(me, "下册为祖师所著，其中隐藏了元武门绝学中的最后招式，无奈吾不才，无缘悟出，望诸位早日\n");
    tell_object(me, "悟得此招，以光大吾元武门。\n");
    tell_object(me, "\n                                                      元武门第九任掌门  字\n");
    tell_object(
      me,
      "\n\n\n\n                             " HIB "〖" + HIY "元武门绝学" + HIR "--" + HIG "下卷" + HIB "〗" NOR "\n\n"
    );
    tell_object(me, "     元武门绝学分为波動拳与昇龍拳二式，但经常使用会堕入邪道，令人丧失心志。\n");
    tell_object(me, "吾弥留之际，方悟出此招之正道，但吾时间无多，又恐被逆贼所学，故留下心法，望门下弟子自行领悟。\n");
    tell_object(me, "当汝元武门心法有成之时，从元武门的根本---波動拳与昇龍拳开始，深究此二招的心法，当有所成。\n");
    tell_object(me, "当汝输入ssbx，即开始领悟此招，但唯有缘者放能习得。\n");
    tell_object(me, "\n                                                      元武门第一任掌门---元武 著\n");
    me->set("ssbx_can_learn", 1);
    return 1;
  } else
    write("你擦拭什么？\n");
  return 1;

}
