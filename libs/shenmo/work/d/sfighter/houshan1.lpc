inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "后山小路");
  set("long", @LONG
这是通往武神流禁地---紫气山的小路。路旁立了个
牌子，写着“武神流禁地，擅入着，死!!”。路中
央站着一个死士，但似乎比他们强得太多了。
LONG);
  set("exits", ([ /* sizeof() == 1 */
    "north": "/d/sfighter/houshan2",
    "enter": "/d/sfighter/zoulang15",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    "/d/sfighter/npc/sishen": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  object man;
  if (dir == "enter" || !man = present("si shen", environment(me)))
    return ::valid_leave(me, dir);
  if (!living(man)) return ::valid_leave(me, dir);
  if (!me->query_temp("zqs_passed")) return notify_fail("死神大手一挥，挡住你的去路，眼中闪现电芒，从冷酷的嘴角冒出一句话：闯入禁地者，死!!!\n");
  return ::valid_leave(me, dir);

}
