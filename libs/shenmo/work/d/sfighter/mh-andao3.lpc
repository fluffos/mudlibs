#include <ansi.h>
inherit ROOM;

string *bing = ({ HIG "巡逻兵" NOR, });

void create() {
  set("short", "暗道");
  set("long", @LONG

……四周一片漆黑，你什么都看不见……

LONG);
  setup();
}

void init() {
  object me = this_player();
  if (me->query_temp("getbook3")) {
    remove_call_out("going");
    call_out("going", 3, me);
  }

}

void going(object me) {
  int i, k;
  string guard = bing[random(sizeof(bing))];
  i = (int)me->query_skill("dodge", 1);
  k = (int)me->query_skill("dodge", 1);
  i = i / 10;
  i += (int)me->query("kar") / 2;
  k = k / 50;
  k = 11 - k;
  if (k < 3) k = 3;
  if (k > 10) k = 10;
  if (i > random(55)) {
    for (i = 1; i < k; i++) {
      message_vision(YEL "$N在黑暗中小心向前摸索,谨慎的迈出第" + chinese_number(i) + "步!\n" NOR, me);
      write("\n\n");
      me->add("sen", -(15 + random(5)));
      if (me->query("sen") < 50) {
        write(HIR "你觉得心神不宁,心中再也无法承受这巨大压力，赶紧往原路返回。\n" NOR);
        remove_call_out("going");
        me->move("/d/sfighter/mh-andao1"); return;
      }
    }
    message_vision(HIC "$N终于摸到暗道下一层入口,见" + guard + HIC "不留神，连忙进入下一层.\n", me);
    me->move("/d/sfighter/mh-andao4");
  } else {
    message_vision(YEL "$N在黑暗中不小心拌到一块石头，" + guard + YEL "跑了出来:谁?!\n" + RED "\n糟糕!你失败啦.\n" NOR, me);
    me->move("/d/sfighter/mh-andao1");
    message_vision(HIY "$N见巡逻兵有所警觉，急忙往原路返回。\n" NOR, me);
  }
}
