inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山顶");
  set("long", @LONG
城市！一个巨大的城市悬浮在山顶上方，莫非这就是
传说中神武天皇的梦幻都市？一个巨大的升降机将梦
幻都市和山顶的地面连接起来，看来这是进入梦幻都
市的唯一通道，但守兵警戒非常严密，要如何才能进
入？
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "northdown": "/d/sfighter/shanlu3",
    "up": "/d/sfighter/mh-city1",
  ]));

  set("objects", ([ /* sizeof() == 1 */
    "/d/sfighter/npc/shoubing": 2,
  ]));
  set("no_fight", 1);
  setup();
}

int valid_leave(object me, string dir) {
  object man;
  if (dir == "northdown" || !man = present("bing", environment(me)))
    return ::valid_leave(me, dir);
  if (!living(man)) return ::valid_leave(me, dir);
  if (!me->query_temp("mhcity_passed")) return notify_fail("守兵一把挡住你：未经允许，不得进入。\n");
  return ::valid_leave(me, dir);

}
