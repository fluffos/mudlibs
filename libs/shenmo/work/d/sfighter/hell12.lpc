#include <ansi.h>

inherit ROOM;

void create ()
{
  set ("short", HIR"阿修羅煉獄"NOR);
  set ("long", @LONG

人世间竟然也有如此地方！整个世界仿佛被红染红，
遍地满是骷髅和死尸，如同进入了传说中的阿鼻地狱。

LONG);

  set("exits", ([
  "up" : "/d/sfighter/island2",
  "south" : "/d/sfighter/hell11",
      ]));

  set("objects", ([
 "/d/sfighter/npc/zhiqin" : 1,
 "/d/sfighter/npc/zhiai" : 1,
 "/d/sfighter/npc/zhiyou" : 1,
      ]));

  setup();
}

int valid_leave (object who, string dir)
{
  object zhiqin = present("zhi qin", this_object());
  object zhiai = present("zhi ai", this_object());
  object zhiyou = present("zhi you", this_object());
  object siling= present("si ling", this_object());

  if (zhiqin||zhiai||zhiyou||siling)
    return notify_fail("你心志已失，只知道要杀尽所有的人！！\n");

  if (!who->query_temp("hell_kill_you")||!who->query_temp("hell_kill_qin")||!who->query_temp("hell_kill_ai")||who->query_temp("hell_kill")<100){
     if (who->query_temp("bayi"))  return notify_fail("你被体内的霸意控制了心志，只想杀人！！\n");
     if (who->query_temp("shayi"))  return notify_fail("你被体内的杀意控制了心志，只想杀人！！\n");
     }
  if (!who->query("ghost-spirit")&&who->query_temp("axlhell_in")&&dir=="up"){
 	message("chat",HIR+"\n【阿修羅煉獄】"+HIB"真·豪鬼"+HIR"(Gouki):"+HIW+who->name()+HIR"完成百人斩，残杀挚亲、挚爱、挚友，堕入阿修羅煉獄，现吾将毕生绝学 阿修羅戰道 传授于汝。\n\n"NOR,users());
       who->set("ghost-spirit",1);
       who->delete_temp("axlhell_in");
       who->delete_temp("hell_kill");
       who->delete_temp("hell_kill_qin");
       who->delete_temp("hell_kill_ai");
       who->delete_temp("hell_kill_you");
       message_vision(HIB"真·豪鬼"+HIG"说道：以后你每到阿修羅煉獄修炼一次，阿修羅戰道均会有所提升，希望你今后好好努力，早日得到我的真传。\n",who); 
     }


  if (who->query_skill("ghost-spirit",1)>0&&dir=="up") 
     { 
       who->improve_skill("ghost-spirit",5000);
       message_vision("$N一步出阿修羅煉獄,顿时全身舒畅，阿修羅戰道亦提升了不少。\n",who);
       who->delete_temp("axlhell_in");
       who->delete_temp("hell_kill");
       who->delete_temp("hell_kill_qin");
       who->delete_temp("hell_kill_ai");
       who->delete_temp("hell_kill_you");
      }

  return ::valid_leave(who,dir);
}











