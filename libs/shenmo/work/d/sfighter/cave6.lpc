#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
 set("short", "洞内");
 set("long", @LONG
这里就是紫气山的核心所在，在这的正中央有着两副摆着元武门
绝学---昇龍和波動---的骸骨，四周的山壁上还刻有无数的武学
痕迹(hengji)。骸骨周围盘旋着强大的紫鬭气,似乎这就是紫气
山紫气的来源。
LONG);
 set("exits", ([
  "south" : "/d/sfighter/cave5",
  "north" : "/d/sfighter/cave7",
//  "enter" : "/d/sfighter/jiejie3",
]));
        set("item_desc", ([
                "ziqi": "充满了力量的气劲，如果吸纳(xina)成功，可以提高自身的力量。\n"
,
                "紫气": "充满了力量的气劲，如果吸纳(xina)成功，可以提高自身的力量。\n"
,
                "hengji": "好深奥啊，你不由得想研习研习(study)。\n"
,
                "痕迹": "好深奥啊，你不由得想研习研习(study)。\n"
,

        ]) );
        set("objects", ([
       ]) );
 setup();
}
void init()
{ object ob;
 if( interactive( ob = this_player()))
 call_out("blowing", random(10) + 1, ob);
 add_action("do_xina","xina");
 add_action("do_study","study");
}
int blowing(object ob)
{
 int i;
 int damage;
        if(  ob && environment(ob) == this_object())
 {
 if (ob->query("power_lvl")<9){
 tell_object(this_object(), HIR "\n\n你抵受不了紫气的强大压力，体内气血翻腾,皮肤逐渐开裂！！\n\n" NOR);
 COMBAT_D->report_status(ob);
 i=ob->query("power_lvl");
 ob->receive_damage("kee", 50*(9-i));
 if( environment(ob) == this_object())
 call_out("blowing",random(10)+1, ob);
 }}
 else
 return 1;

}


int valid_leave(object me, string dir)
{
        remove_call_out("blowing");
 return 1;
}

int do_xina(string arg)
{
        object obj;
        object me;
        int lvl;
        me = this_player();

	if(me->is_busy()) {write("你正忙着呢。\n");return 1;}

        if(!arg || arg=="")
        {
                write("你要吸纳什么？\n");
                return 1;
        }

        if( arg == "ziqi" || arg == "紫气" )
        {
        lvl=me->query_skill("power",1);
        if (lvl<300) {write("你能力太低，无法吸纳这么强大的力量。\n");return 1;}
        if (lvl>450) {write("以你的能力，吸纳这些紫气已经无法提高自己了。\n");return 1;}
        message_vision("$N运气凝神，专心吸纳紫气。\n",me);
        me->improve_skill("power",random(lvl*3/2));
        if (random(2)) me->start_busy(1);
        return 1;
        }
        else
         write("你吸纳什么？\n");
                return 1;
}

int do_study(string arg)
{
        object obj;
        object me;
        int lvl;
        me = this_player();

	 if(me->is_busy()) {write("你正忙着呢。\n");return 1;}

        if(!arg || arg=="")
        {
                write("你要研习什么？\n");
                return 1;
        }

        if( arg == "hengji" || arg == "痕迹" )
        {
        lvl=me->query_skill("literate",1);
        if (lvl<200) {write("你武学智慧太低，无法弄懂这么深奥的东西。\n");return 1;}
        if (lvl>500) {write("你研习不出什么来，太浅了。\n");return 1;}
        message_vision("$N呆望着山壁上的痕迹，脑中不断思考着。\n",me);
        me->improve_skill("literate",random(lvl*3/2));
        me->start_busy(1);
        return 1;
        }
        else
         write("你研习什么？\n");
                return 1;
}