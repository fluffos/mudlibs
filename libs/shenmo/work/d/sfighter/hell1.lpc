#include <ansi.h>

inherit ROOM;

void create ()
{
  set ("short", HIR"阿修羅煉獄大门"NOR);
  set ("long", @LONG

你的面前是一个巨大的门，门的牌额上书着几个血红
大字：阿修羅煉獄 。门旁的墙上有个手印型的机关，
你可以将手掌放上去推（push）试试，似乎可以开启
这个大门。

LONG);

  set("exits", ([
  "up" : "/d/sfighter/island1",
      ]));

        set("item_desc", ([
                "jiguan": "一个手印型的机关。\n"
,
                "机关": "一个手印型的机关。\n"
,
        ]) );


  set("objects", ([
      ]));

  setup();
}

void init ()
{
  add_action ("do_push", "push");
}

int do_push (string arg)
{
    object me = this_player();

	if(me->is_busy()) {write("你正忙着呢。\n");return 1;}
        if(!arg || arg=="")
        {
                write("你要推什么？\n");
                return 1;
        }

        if( arg == "jiguan" || arg == "机关" )
        {
         if (!me->query_temp("axlhell_in")) {write("你怎么跑进来的？\n");return 1;}
         if (!me->query_temp("shayi")&&!me->query_temp("bayi")) {write("你既无杀意又无霸意，无法触动机关。\n");return 1;}
         message_vision("$N的手掌一印上机关，便传来隆隆声响，大门缓缓开了。\n",me);
         message_vision("$N手刚离开机关，门又即将关上了，$N急忙一个箭步冲进门去。\n",me);
         me->move("/d/sfighter/hell2");
         return 1;
        }
    return 0;
}


