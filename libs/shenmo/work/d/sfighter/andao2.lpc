
inherit ROOM;

void create ()
{
  set ("short", "暗道");
  set ("long", @LONG

……四周一片漆黑，你什么都看不见……

LONG);

  set("exits", ([
      ]));

  set("objects", ([
      ]));

  setup();
}

void init ()
{
  add_action ("do_go", "go");
}

int do_go (string dir)
{
    object who = this_player();
    string *names = ({
    "west",
    "east",
    "south",
    "north",
    });


    if (! dir)
      return 0;

    if (who->query("kee")>50)  who->add("kee",-50); 
    else
      {
      who->unconcious();
      return 1;
      }


    if (random(5))
      {
      message_vision ("$N迷迷糊糊踏出一步，一不小心撞在墙上。\n",who);
      }
    else
    {
      if (dir != names[random(sizeof(names))])
        {
        message_vision ("$N找到了路口，急忙走了过去。\n",who);
        who->move(__DIR__"andao3");
        return 1;
        }
      else
        {
        message_vision ("$N找到了路口，急忙走了过去。\n",who);
        who->move(__DIR__"andao4");
        return 1;
        }
    }



  return 0;
}


