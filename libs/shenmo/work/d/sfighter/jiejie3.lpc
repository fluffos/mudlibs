inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "结界");
  set("long", @LONG

一个奇怪的地方，周围一片黑暗，唯有前方隐隐透出点光亮。
这里应该就是玫瑰说的另一个时光之门(door)吧，不知道该
如何进入？
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "out": "/d/sfighter/cave6",
  ]));
  set("objects", ([ /* sizeof() == 1 */
  ]));
  set("no_time", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("item_desc", ([
    "door": "时光之门，学学玫瑰那样使用(use)月光宝盒吧。\n"
    ,
    "时光之门": "时光之门，学学玫瑰那样使用(use)月光宝盒吧。\n"
    ,
  ]));


  setup();
}

void init() {
  add_action("do_use", "use");
}

int do_use(string arg) {
  object obj;
  object me;
  int lvl;
  me = this_player();

  if (me->is_busy()) { write("你正忙着呢。\n"); return 1; }

  if (!arg || arg == "") {
    write("你要使用什么？\n");
    return 1;
  }

  if (arg == "moonbox" || arg == "月光宝盒") {
    if (!present("moonbox", me)) { write("你没月光宝盒怎么用？\n"); return 1; }

    lvl = me->query_skill("spirit-power", 1);
    if (lvl < 350) { write("你精神力量太低，无法使用月光宝盒。\n"); return 1; }
    message_vision(
      me->name() + "拿起" + HIY "月光宝盒" NOR + "口中念了几句咒语，只见强光一闪，" + me->name() + "消失了。\n",
      environment(me),
      me
    );
    me->move("/d/sfighter/juejing");
    message("vision", "只见强光一闪," + me->name() + "突然出现了!!\n", environment(me), me);
    return 1;
  } else
    write("你要使用什么？\n");
  return 1;
}
