#include <ansi.h>

inherit ROOM;

void create() {
  int i;
  set("short", HIR "阿修羅煉獄" NOR);
  set("long", @LONG

人世间竟然也有如此地方！整个世界仿佛被红染红，
遍地满是骷髅和死尸，如同进入了传说中的阿鼻地狱。

LONG);

  i = random(9) + 1;

  set("exits", ([
    "north": "/d/sfighter/hell9",
    "south": "/d/sfighter/hell7",
  ]));

  set("objects", ([
    "/d/sfighter/npc/sishi2": i,
    "/d/sfighter/npc/siling": 10 - i,
  ]));

  setup();
}

int valid_leave(object who, string dir) {
  object siling = present("si ling", this_object());
  object sishi = present("sishi", this_object());

  if (sishi || siling)
    return notify_fail("你心志已失，只知道要杀尽所有的人！！\n");
  return ::valid_leave(who, dir);
}
