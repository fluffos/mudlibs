inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "湖畔");
  set("long", @LONG
湖边，有一白衣人静坐于此，额上白巾无风自
动，双眼盯着湖水，似乎在想着什么。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "east": "/d/sfighter/river8",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    "/d/sfighter/npc/ryu": 1,
  ]));
  setup();
}


void init() {
  add_action("do_bodong", "bodong");
}

int do_bodong() {
  object obj;
  object me;
  int mykar, myint, skill, skill2;
  me = this_player();

  if (me->is_busy()) { write("你正忙着呢。\n"); return 1; }

  if (!me->query_temp("shayi")) { write("你未有杀意，不需在此浪费体力。\n"); return 1; }

  message_vision(HIR "$N默立湖畔，双目赤红，浑身杀气越来越盛，气劲四散，全身衣服无风而动。\n" NOR, me);
  message_vision(HIR "$N缓缓祭起波動起手式，红色气波由小而大，聚于$N双手之间。\n" NOR, me);
  message_vision(HIR "天色陡然一片血红，$N猛的将气波推出，只见湖中之水似被吸引，纷纷聚于气波之上，化做一巨大水球破空直奔天际。\n" NOR, me);
  message_vision("杀意已尽，$N逐渐恢复了正常。\n", me);
  skill = me->query_temp("sfighter/skill");
  skill2 = me->query_temp("sfighter/skill2");
  call_out("remove_yi", 0, me, skill, skill2);
  me->start_busy(2);
  return 1;
}

void remove_yi(object me, int skill, int skill2) {
  if (!me->query_temp("yi")) return;

  me->add_temp("apply/damage", -(skill + skill2) / 3);
  me->add_temp("apply/armor", -(skill + skill2) / 2);
  me->add_temp("apply/dodge", -(skill + skill2) / 3);
  me->add_temp("apply/parry", -(skill + skill2) / 3);
  me->add_temp("apply/unarmed", -(skill + skill2) / 3);
  me->delete_temp("shayi", 1);
  me->delete_temp("bayi", 1);
  me->delete_temp("yi", 1);
  //       me->set("name",me->query("old_name"));
  if (me->query_temp("max_sen") > 0) {
    me->set("max_sen", me->query_temp("max_sen")); me->delete_temp("max_sen");
  }
}
