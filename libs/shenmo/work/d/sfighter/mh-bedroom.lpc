
inherit ROOM;

void create ()
{
  set ("short", "卧室");
  set ("long", @LONG

不亏是梦幻都市第一人的卧房，极度的豪奢。
现在不是慢慢观赏的时候了，趁没人在的时候
赶紧找(search)吧！

LONG);

  set("exits", ([
  "down" : "/d/sfighter/mh-andao1",
      ]));

  set("objects", ([
      ]));

  setup();
}

void init()
{ object ob;
 add_action("do_search","search");
}


int do_search(string arg)
{
        object obj;
        object me,book;
        int myint,mykar;
        me = this_player();
        myint = me->query("int")+me->query_skill("literate",1)/10-2;
        mykar = me->query("kar")/2;

	if(me->is_busy()) {write("你正忙着呢。\n");return 1;}

        if(!arg || arg=="")
        {
                write("你要寻找什么？\n");
                return 1;
        }

        if( arg == "yuanwu-book" || arg == "book" )
        {
        if ((myint+mykar)<random(60)||myint<40)  
            message_vision("$N在卧室内翻箱倒柜的寻找着，却始终一无所获。\n",me);
        else {
              message_vision("$N灵机一动，将枕头撕开，果然，书就在里头。\n",me);
              book=new("/d/sfighter/obj/book2");
              book->move(me);
              }

        if (random(2)) me->start_busy(1);
        return 1;
        }
        else
         write("你寻找什么？\n");
                return 1;
}


