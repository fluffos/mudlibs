#include <ansi.h>
#include <armor.h> 
inherit HEAD; 
        
void create() 
{ 
          set_name(HIW"赤龙头带"NOR, ({ "ryu toudai", "dai"}) ); 
        set_weight(200); 
        if( clonep() ) 
          set_default_object(__FILE__); 
       else { 
         set("unit", "条"); 
          set("long","一条普通白布做成的头带,在尾端用金线绣有小小的一个“龙”字。\n"); 
          set("value", 1000); 
          set("material", "cloth"); 
          set("armor_prop/armor", 10); 
          set("armor_prop/personality", 1); 
        } 
        setup();
} 