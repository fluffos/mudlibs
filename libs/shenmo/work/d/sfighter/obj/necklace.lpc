#include <ansi.h>
#include <dbase.h>
#include <armor.h>
#define NAME "银项链"

inherit NECK;

void create() {
  set_name(HIW NAME NOR, ({ "julier necklace", "xiang lian" }));
  set_weight(1000);
  set("value", 1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一串银项链，链坠上用钻石镶成的Julier几个字。\n");
    set("unit", "串");
    set("material", "silver");
    set("armor_prop/armor", 1);
  }
  setup();
}
