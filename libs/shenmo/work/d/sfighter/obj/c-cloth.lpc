#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIM "司令战袍" NOR, ({ "siling zhanpao", "cloth" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "梦幻都市司令所用战袍。\n");
    set("material", "cloth");
    set("unit", "件");
    set("value", 600);
    set("armor_prop/armor", 100);
    set("no_sell", 1);
  }
  setup();
}
