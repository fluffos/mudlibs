#include <ansi.h>
#include <dbase.h>

inherit F_AUTOLOAD;  
inherit ITEM;


void create()

{
     set_name(HIY"月光宝盒"NOR, ({"moonbox","box", "he" }) );
     set_weight(100);
     set("long","藏于盘丝洞地下，据说有让人穿梭时空的奇异威力。\n");
     set("value", 10000);
     set("material", "steel");
     set("no_sell", "这么难得的宝物还是留着吧。\n");
     set("unit", "只");
	setup();

}

