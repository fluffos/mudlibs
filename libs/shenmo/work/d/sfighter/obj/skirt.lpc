
#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
	set_name(HIG "紧身长裙" NOR, ({ "skirt", "cloth" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一条奇怪的裙子。\n");
		set("unit", "条");
		set("value", 0);
		set("material", "cloth");
		set("armor_prop/armor", 10);
		set("armor_prop/personality", 3);
		set("female_only", 1);
	}
	setup();
}


