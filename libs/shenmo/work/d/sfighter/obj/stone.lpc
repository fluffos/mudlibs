
#include <action.h>
#include <ansi.h>

inherit ITEM;

void create() {

  set_name("巨石", ({"stone","ju shi","shi"}));
  set_weight(20);
  set("value",0);
  set("unit", "块");
  set("long", "好大一块巨石，你要不要试试能不能抬(lift)起它？\n");
  set("value", 1000);
  setup();
}

void init()
{ 
 add_action("do_lift","lift");
 add_action("do_get","get");
 add_action("do_drop","drop");
}

int do_lift(string arg)
{
        object ob=this_object();
        object me,book;
        int lvl;
        me = this_player();

	if(me->is_busy()) {write("你正忙着呢。\n");return 1;}

        if(!arg || arg=="")
        {
                write("你要抬什么？\n");
                return 1;
        }

        if( arg == "巨石" || arg == "stone" || arg == "ju shi" || arg == "shi")
        {
        lvl=me->query_skill("force");
        if(ob->query("lift")) {write("没看到有人已经抬着石头了吗？\n");return 1;}
        if (lvl<300) {write("你的内功太差，怕是没那能力抬起这么大块石头。\n");return 1;}
        if (me->query("force_factor")<100) {write("你用力试试了，巨石还是纹丝不动，看来还需多用点力。\n");return 1;}
        message_vision("$N使出吃奶的力气使劲一抬，哇！那么大一块石头竟然也被抬起了大半边。\n",me);

        if (!ob->query("book_none")) {
        message_vision("咦！石头底下竟然有一本书？\n",me);
        book=new("/d/sfighter/obj/book1");
        book->move(environment(me));
        ob->set("book_none",1);
        call_out("regenerate",300);
        }

        me->start_busy(1000000000);
        me->set_temp("lift",1);
        ob->set("lift",1);
        }
        else
         write("这里没这东西。\n");
                return 1;
}

int do_get(string arg)
{
   object me=this_player();
   if(arg == "巨石" || arg == "stone" || arg == "ju shi" || arg == "shi" || arg == "all") {write("这么大块石头你怕是拿不动吧，先抬看看？\n");return 1;}
   if(me->query_temp("lift")) {write("抬着这么大块石头你还想干什么？先放下(drop)石头吧。\n");return 1;}
   return 0;
}

int do_drop(string arg)
{
   object me=this_player();
   object book;
   if(me->query_temp("lift")&&(arg == "巨石" || arg == "stone" || arg == "ju shi" || arg == "shi")) {
      message_vision("$N突然撒手后退，轰一声巨响，巨石落在地面，震出了好大一个坑！！\n",me);
      book=present("yuanwu-book",environment(me));

      if (book) {destruct (book);set("book_none",0);}
      set("lift",0);
      me->delete_temp("lift");
      me->start_busy(10,100);
      me->interrupt_me(me);
      return 1;}

   return 0;
}

int regenerate()
{
	set("book_none", 0);
	return 1;
}








