inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "瀑布之下");
  set("long", @LONG
奔流如千军万马奔腾而下，在此形成一个巨大
的湖泊，可见自然之威何其之巨。但，在那瀑
布之中，竟然有一个人影，承接着那股巨大的
威力。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "northeast": "/d/sfighter/river7",
    "west": "/d/sfighter/river9",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    "/d/sfighter/npc/ken": 1,
  ]));
  setup();
}

void init() {
  add_action("do_shenglong", "shenglong");
}

int do_shenglong() {
  object obj;
  object me;
  int mykar, myint, skill, skill2;
  me = this_player();

  if (me->is_busy()) { write("你正忙着呢。\n"); return 1; }

  if (!me->query_temp("bayi")) { write("你未有霸意，不需在此浪费体力。\n"); return 1; }

  message_vision("$N缓缓步入湖中，傲然立于瀑布之下，浑身散发出来的气势比奔腾的瀑布不虞多让，十足的霸者气魄。\n", me);
  message_vision(HIY "只见$N双目金光越来越盛，霸者之气不住往四周散射，浑身气劲一触即发。\n" NOR, me);
  message_vision(HIY "一声震天怒吼，金光闪闪的巨龙逆着瀑布冲天而起，强大的气劲将奔流带上天际，瀑布之水竟逆着断崖直上！！\n" NOR, me);
  message_vision("龙已消失，瀑布之水犹在逆流，$N霸意尽然宣泄而出，金光陡散。\n", me);
  skill = me->query_temp("sfighter/skill");
  skill2 = me->query_temp("sfighter/skill2");
  call_out("remove_yi", 0, me, skill, skill2);
  me->start_busy(2);
  return 1;
}

void remove_yi(object me, int skill, int skill2) {
  if (!me->query_temp("yi")) return;

  me->add_temp("apply/damage", -(skill + skill2) / 3);
  me->add_temp("apply/armor", -(skill + skill2) / 2);
  me->add_temp("apply/dodge", -(skill + skill2) / 3);
  me->add_temp("apply/parry", -(skill + skill2) / 3);
  me->add_temp("apply/unarmed", -(skill + skill2) / 3);
  me->delete_temp("shayi", 1);
  me->delete_temp("bayi", 1);
  me->delete_temp("yi", 1);
  //      me->set("name",me->query("old_name"));
  if (me->query_temp("max_sen") > 0) {
    me->set("max_sen", me->query_temp("max_sen")); me->delete_temp("max_sen");
  }
}
