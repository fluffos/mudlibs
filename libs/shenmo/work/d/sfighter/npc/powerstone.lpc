#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("力石", ({ "li shi", "powerstone" }));
  set("gender", "男性");
  set("long", "武神流武流云门下大弟子，因私放身受重罪的二师弟逃跑，故被关押。\n" NOR);
  set("title", HIC "武神流弟子" NOR);
  set("age", 25);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 3000);
  set("kee", 3000);
  set("per", 25);
  set("max_sen", 3000);
  set("sen", 3000);
  set("combat_exp", 2000000);
  set("daoxing", 1000000);
  set("class", "saint");
  set("force", 6000);
  set("max_force", 3000);
  set("mana", 6000);
  set("max_mana", 3000);
  set("force_factor", 150);
  set("mana_factor", 150);
  set_skill("unarmed", 220);
  set_skill("wushen-kungfu", 220);
  set_skill("parry", 220);
  set_skill("literate", 200);
  set_skill("dodge", 220);
  set_skill("force", 220);
  set_skill("power", 220);
  set_skill("wushen-steps", 220);
  set_skill("spells", 150);
  set_skill("spirit-power", 150);
  map_skill("force", "power");
  map_skill("spells", "spirit-power");
  map_skill("parry", "wushen-kungfu");
  map_skill("unarmed", "wushen-kungfu");
  map_skill("dodge", "wushen-steps");
  set("inquiry", ([
    "name": "我是武神流弟子---力石。",
  ]));
  set("inquiry", ([
  ]));
  create_family("格斗家", 3, "蓝");
  setup();
  carry_object("/d/sfighter/obj/fightcloth")->wear();
}

void attempt_apprentice(object ob) {
  command("great");
  command("say 望你今后将我武神流发扬光大，傲视武林。\n");
  command("recruit " + ob->query("id"));
  ob->set("title", HIC "武神流弟子" NOR);
  return;
}
