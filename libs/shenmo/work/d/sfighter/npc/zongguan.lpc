#include <ansi.h>
inherit NPC;
inherit F_MASTER; 
string ask_wuzhang(object me);
 
void create()
{
          set_name("总管", ({ "zong guan" }) );
        set("gender", "男性" );
        set("long","一个猥亵的老头，武神流总管，可以向他问武章。\n"NOR);
        set("title",HIC"武神流"NOR);
        set("age",50);
        set("attitude", "heroism");
        set("str",40);
        set("int",50);
        set("per",10);
        set("max_kee",4100);
        set("kee",4100);
        set("max_sen",3100);
        set("sen",3100);
        set("combat_exp",100000);
        set("daoxing",10000);
        set("force",400);
        set("max_force",400);
        set("mana",400);
        set("max_mana",400);
        set("force_factor", 0);
        set("mana_factor",0);
        set_skill("unarmed",100);
        set_skill("parry",100);
        set_skill("literate",200);
        set_skill("dodge",100);
        set_skill("force",100);
        set_skill("spells", 500);
        set("inquiry", ([
                "name" : "我是武神流的总管，嘿嘿！！",
                        ]) );
        set("inquiry", ([
//                "武章" : (: ask_wuzhang :),
//                "wuzhang" : (: ask_wuzhang :),
                ]) );
              setup();
        carry_object("/d/sfighter/obj/shizhuang")->wear();
}

  string ask_wuzhang(object me)
{
     return "武章一个卖五。。不，十两黄金，要不要？";
}

int accept_object(object me, object ob)
{  object wuzhang;

   if (ob->query("money_id") && ob->value() >= 100000) 
   {
      command("jump");
      tell_object(me,"总管赶紧掏出一个东西，塞到你手上，把你另一手的钱收走放内袋里，说道：“成交！”。\n");
      wuzhang = new("/d/sfighter/obj/wuzhang");
wuzhang->move(this_player());
      return 1;
    }
   command("pei");
   tell_object(me,"总管瞪了你一眼，“你当我是乞丐啊！！没收，权当手续费。”。\n");
   return 1;
}


