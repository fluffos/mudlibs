#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name(HIC "域加" NOR, ({ "viga", }));
  set("gender", "男性");
  set("long", "铁面域加，将蛇和鹰两种绝然不同的气势、劲道合一创出自己的一套绝学，为一格斗天才。\n" NOR);
  set("title", HIB "铁面" NOR);
  set("age", 25);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 3000);
  set("kee", 3000);
  set("per", 30);
  set("max_sen", 3000);
  set("sen", 3000);
  set("combat_exp", 2000000);
  set("daoxing", 1000000);
  set("class", "saint");
  set("force", 3000);
  set("max_force", 6000);
  set("mana", 3000);
  set("max_mana", 6000);
  set("force_factor", 150);
  set("mana_factor", 150);
  set_skill("unarmed", 200);
  set_skill("literate", 200);
  set_skill("rukong-zhao", 200);
  set_skill("parry", 200);
  set_skill("dodge", 200);
  set_skill("force", 200);
  set_skill("power", 190);
  set_skill("spells", 150);
  set_skill("spirit-power", 150);
  map_skill("force", "power");
  map_skill("spells", "spirit-power");
  map_skill("parry", "rukong-zhao");
  map_skill("dodge", "lingshe-shenfa");
  map_skill("unarmed", "rukong-zhao");
  set("inquiry", ([
    "name": "哼！",
  ]));
  set("inquiry", ([
  ]));
  create_family("格斗家", 3, "蓝");
  setup();
  carry_object("/d/sfighter/obj/fightcloth")->wear();
}

int accept_object(object me, object ob) {
  string thing = (string)ob->query("id");

  if (ob->query("id") != "wu zhang") { command("say 这是什么东西？\n"); return 1; }
  command("say 就是这东西，做得好。\n");
  me->set_temp("viga_gived", 1);
  return 1;
}

void attempt_apprentice(object me) {
  if (me->query_temp("viga_gived")) {
    command("spank " + me->query("id"));
    command("say 做得不错，就让你加入我们 毒蛇帮吧。\n");
    command("recruit " + me->query("id"));
    me->set("title", HIB "毒蛇帮弟子" NOR);
    return;
  }
  command("comsider");
  command("say 想加入我们毒蛇帮也不是不行，但帮里从来不招没实力的家伙，给你个任务，去帮我搞个武神流争霸战的武章回来吧。\n");
  command("say 有了这武章，Ken那家伙注定要身败名裂了，啊哈哈。。。。\n");
  return;
}
