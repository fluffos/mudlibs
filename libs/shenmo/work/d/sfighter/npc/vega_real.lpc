#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name(HIB "维加" NOR, ({ "vega", }));
  set("gender", "男性");
  set("long", "神武天皇第二十七妃的第五个儿子，在争夺司令之位中凭着不择手段和强横
的实力获胜，世称赤目司令。在神武天皇授命下，带领诸多高手进入大地，欲支配整个世界。\n" NOR);
  set("title", HIR "赤目司令" NOR);
  set("age", 35);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 4000);
  set("kee", 4000);
  set("per", 15);
  set("max_sen", 4000);
  set("sen", 4000);
  set("combat_exp", 3000000);
  set("daoxing", 3000000);
  set("force", 9000);
  set("max_force", 4500);
  set("mana", 9000);
  set("max_mana", 4500);
  set("force_factor", 150);
  set("mana_factor", 225);
  set_skill("unarmed", 300);
  set_skill("literate", 300);
  set_skill("rukong-zhao", 300);
  set_skill("parry", 300);
  set_skill("dodge", 300);
  set_skill("force", 300);
  set_skill("power", 300);
  set_skill("spells", 300);
  set_skill("spirit-power", 300);
  map_skill("force", "power");
  map_skill("spells", "spirit-power");
  map_skill("parry", "rukong-zhao");
  map_skill("dodge", "lingshe-shenfa");
  map_skill("unarmed", "rukong-zhao");
  set("inquiry", ([
    "name": "哼！",
  ]));
  set("inquiry", ([
  ]));
  setup();
  carry_object("/d/sfighter/obj/c-cloth")->wear();
}

void init() {
  object who = this_player();
  object ob = this_object();
  ::init();
  if (userp(who)) {
    remove_call_out("vega_kill");
    call_out("vega_kill", 0, who, ob);
  }

}

void vega_kill(object me, object vega) {
  if (!me->query_temp("vega_killed", 1)) return;
  message_vision("穿上司令战袍的老太婆，不，不是老太婆，而是一个威武无比的男子，双目赤红，他是？？\n", me, vega);
  message_vision("神秘男子仰天狂笑：嘿嘿，赤狂，你也只有这么点能耐。\n", me, vega);
  message_vision("神秘男子转向$N，嘿嘿邪笑道：你所杀的赤目司令其实是我的弟弟，他施用诡计将我骗倒，再扮成我的模样。\n", me, vega);
  message_vision("$n双目精光陡盛：这里面有着一个巨大的阴谋，看我如何借着阴谋达成我的目的。至于你，既然知道了今天的事就留不得你。\n", me, vega);
  message_vision("$n狂笑道：若你以为我会遵守什么狗屁的诺言，那你就错了，死吧！！\n\n", me, vega);
  vega->command("follow " + me->query("id"));
  vega->kill_ob(me);
}

void die() {
  object ob = this_object();
  object me = query_temp("my_killer");

  if (!me || !present(me, environment(ob))) me = query_temp("last_opponent");

  if (!me->query_temp("vega_killed")) return;

  message_vision("$n突然大喝一声，停！抽身后退。$N一愣，亦停了下来。\n", me, ob);

  me->remove_all_killer();
  ob->remove_all_killer();
  ob->set("kee", 4000);
  ob->set("sen", 4000);
  ob->set("max_kee", 4000);
  ob->set("max_sen", 4000);

  message_vision("$n嘿嘿笑道：没想到你有这等实力，这样吧，我可以帮你做一件事，大家交个朋友。\n", me, ob);
  message_vision("$n心中正打着如意算盘：先拉拢拉拢，以后有他相助可方便多了。\n", me, ob);
  message_vision("$N心中暗自提防，嘴上说道：好，如果你能助我拿回被神武天皇夺走的元武门秘籍，我就交了你这朋友。\n", me, ob);
  message_vision("$n大笑：好，我正想挫挫那老家伙的锐气，跟我走吧。\n", me, ob);
  me->delete_temp("vega_killed");
  ob->move("/d/sfighter/mh-city3");
  me->move("/d/sfighter/mh-city3");
  message_vision("$n伸手在墙上摸了几下，墙下突然出现一个暗道。\n", me, ob);
  message_vision("$n说道：这个暗道可以通到那老家伙的卧房，不过路上可能有巡逻兵。我就帮到这，拿到书后你自己从原路出来吧。\n", me, ob);
  message_vision("$n往上一跃，急速远去。\n", me, ob);
  message_vision("暗道门快关起来了，$N赶紧跳入暗道。\n", me);
  me->set_temp("getbook3", 1);
  me->move("/d/sfighter/mh-andao1");
  destruct(this_object());
  return;
}
void unconcious() {
  die();
}
