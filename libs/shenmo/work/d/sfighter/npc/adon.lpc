#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_master();

void create() {
  set_name("阿東", ({ "adon", }));
  set("gender", "男性");
  set("long", "擅使泰拳，全身肌肉横陈，每个部位皆是武器。\n" NOR);
  set("title", HIR "血狼" NOR);
  set("age", 25);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 2000);
  set("kee", 2000);
  set("per", 15);
  set("max_sen", 2000);
  set("sen", 2000);
  set("combat_exp", 600000);
  set("daoxing", 100000);
  set("force", 1000);
  set("max_force", 1000);
  set("mana", 1000);
  set("max_mana", 1000);
  set("force_factor", 30);
  set("mana_factor", 20);
  set("class", "saint");
  set_skill("unarmed", 80);
  set_skill("literate", 80);
  set_skill("taiquan", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("force", 80);
  set_skill("power", 80);
  set_skill("spells", 60);
  set_skill("spirit-power", 60);
  map_skill("force", "power");
  map_skill("spells", "spirit-power");
  map_skill("parry", "taiquan");
  map_skill("dodge", "lingshe-shenfa");
  map_skill("unarmed", "taiquan");
  set("inquiry", ([
    "name": "哼！",
  ]));
  set("inquiry", ([
    "师傅": (: ask_master :),
    "撒加特": (: ask_master :),
  ]));
  setup();
  carry_object("/d/sfighter/obj/fightcloth")->wear();
}


int accept_fight(object who) {
  object me;
  me = this_object();

  if (me->is_fighting()) {
    command("say 没看我正忙着嘛!\n");
    return 0;
  }
  say("阿東狂笑道：就让我看看你有几分料吧！\n");
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("kee", (int)me->query("max_kee"));
  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("sen", (int)me->query("max_sen"));

  remove_call_out("check_fight");
  call_out("check_fight", 1, me, who);
  return 1;
}

void player_win(object me, object who) {
  object obj;

  obj = new("/d/sfighter/obj/wuzhang");
  command("sigh");
  say("阿東说道：竟有如此高手，看来我还需多加修炼，这东西对我也没用了，就给你吧！\n");
  say("阿東说道：撒加特师傅的绝招我尚未学成，不然你怎是我的对手。\n");
  command("sigh");
  who->set("adon_win", 1);
  obj->move(who);
}

void player_lose(object me, object who) {
  string msg;
  msg = RANK_D->query_respect(who);

  command("heng");
  say("阿東一脸不屑，啐了一口，垃圾也敢来挑战我！\n");
}

void check_fight(object me, object who) {
  int my_kee, whos_kee;
  int my_max_kee, whos_max_kee;

  if (!who) return;
  my_kee = me->query("kee");
  whos_kee = who->query("kee");
  my_max_kee = me->query("max_kee");
  whos_max_kee = who->query("max_kee");

  if (me->is_fighting()) {
    remove_call_out("check_fight");
    call_out("check_fight", 1, me, who);
    return;
  }

  if (!present(who, environment(me)))
    return;

  if ((my_kee * 100 / my_max_kee) <= 50)
    player_win(me, who);
  else if ((whos_kee * 100 / whos_max_kee) <= 50)
    player_lose(me, who);

}

string ask_master() {
  object me = this_player();
  if (me->query("adon_win")) {
    command("consider");
    command("say 我师傅尚有一心愿未了，若你能帮他达成心愿，或许他会传授你他的独门绝技。\n");
    command("say 师傅正在闭关练功，但具体位置我也不知道，你自己去找找吧。\n");
    return "师傅不知道跑哪去了，我还有些问题想请他指导呢。\n";
  }

  return "哼。\n";

}
