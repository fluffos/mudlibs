#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("武流云", ({ "wu liuyun", "wu", "liuyun" }));
  set("gender", "男性");
  set("long", "武神流宗师，横霸了半片天下。其自创的武神流绝学，威力无匹，傲视天下\n" NOR);
  set("title", HIC "武神流宗师" NOR);
  set("age", 40);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 5000);
  set("kee", 5000);
  set("per", 25);
  set("max_sen", 5000);
  set("sen", 5000);
  set("combat_exp", 2800000);
  set("daoxing", 2000000);
  set("class", "saint");
  set("force", 10000);
  set("max_force", 5000);
  set("mana", 10000);
  set("max_mana", 5000);
  set("force_factor", 250);
  set("mana_factor", 250);
  set_skill("unarmed", 300);
  set_skill("wushen-kungfu", 300);
  set_skill("parry", 300);
  set_skill("dodge", 300);
  set_skill("literate", 250);
  set_skill("force", 280);
  set_skill("power", 295);
  set_skill("wushen-steps", 300);
  set_skill("spells", 220);
  set_skill("spirit-power", 220);
  map_skill("force", "power");
  map_skill("spells", "spirit-power");
  map_skill("parry", "wushen-kungfu");
  map_skill("unarmed", "wushen-kungfu");
  map_skill("dodge", "wushen-steps");
  set("inquiry", ([
    "name": "我是武神流创始人---武流云。",
  ]));
  set("inquiry", ([
  ]));
  create_family("格斗家", 2, "蓝");
  setup();
  carry_object("/d/sfighter/obj/fightcloth")->wear();
}

void attempt_apprentice(object me) {
  object lingpai;
  if (me->query("family/master_id") != "li shi") { command("say 你不是武神流弟子，一边去。\n"); return; }
  if (me->query_temp("wushen_done")) {
    command("great");
    command("say 有前途,望你今后将我武神流发扬光大，傲视武林。\n");
    command("recruit " + me->query("id"));
    me->set("title", HIC "武神流弟子" NOR);
    return;
  }
  command("say 要成为我的弟子，先要帮我做一件事。\n");
  command("say 在禁地内有个名叫青狼的怪物，如果你能帮我赶跑他，我就收下你。\n");
  me->set_temp("wushen_asked", 1);
  lingpai = new("/d/sfighter/lingpai");
  lingpai->move(this_object());
  command("give " + me->query("id") + " " + lingpai->query("id"));
  command("say 把这令牌拿给死神，这样你就能进入禁地了。\n");
  command("say 去吧。\n");
  command("wave");
  return;
}
