#include <ansi.h>
inherit NPC;


void create() {
  set_name("死士", ({ "si shi" }));
  set("age", 30);
  set("gender", "男性");
  set("long",
    "头盔铁甲全副武装，盔甲引有一个大大的“死”字。\n");
  set("title", "武神流");
  set("attitude", "peaceful");

  set("combat_exp", 100000);
  set("shen_type", 1);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 10);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("power", 80);
  set_skill("force", 100);
  set_skill("wushen-kungfu", 100);
  set_skill("wushen-steps", 100);
  map_skill("force", "power");
  map_skill("unarmed", "wushen-kungfu");
  map_skill("dodge", "wushen-steps");
  setup();
  carry_object("/d/obj/armor/tiejia")->wear();
  carry_object("/d/qujing/tianzhu/obj/tiekui")->wear();
}
