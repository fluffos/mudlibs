#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_juexue();
string leave_ghost();

void create() {
  set_name(HIB "真·豪鬼" NOR, ({ "gouki" }));
  set("gender", "男性");
  set("long", "一个满脸邪恶的人，浑身散发出令人压抑异常的气息。\n" NOR);
  set("title", HIC "元武门逆徒" NOR);
  set("age", 43);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 6000);
  set("kee", 6000);
  set("per", 10);
  set("max_sen", 6000);
  set("sen", 6000);
  set("combat_exp", 5000000);
  set("daoxing", 5000000);
  set("force", 15000);
  set("max_force", 7500);
  set("mana", 15000);
  set("max_mana", 7500);
  set("class", "saint");
  set("force_factor", 500);
  set_skill("literate", 400);
  set("mana_factor", 500);
  set_skill("unarmed", 450);
  set_skill("yuanwu-kungfu", 450);
  set_skill("parry", 450);
  set_skill("dodge", 450);
  set_skill("force", 450);
  set_skill("power", 450);
  set_skill("yuanwu-steps", 450);
  set_skill("spells", 450);
  set_skill("spirit-power", 450);
  set_skill("ghost-spirit", 350);
  map_skill("force", "power");
  map_skill("spells", "spirit-power");
  map_skill("parry", "yuanwu-kungfu");
  map_skill("unarmed", "yuanwu-kungfu");
  map_skill("dodge", "yuanwu-steps");
  set("inquiry", ([
    "阿修羅戰道": (: ask_juexue :),
    "ghost-spirit": (: ask_juexue :),
    "name": "嘿嘿！",
    "人性": (: leave_ghost :),
  ]));
  create_family("格斗家", 2, "蓝");
  setup();
  carry_object("/d/sfighter/obj/fightcloth")->wear();
}

void attempt_apprentice(object me) {
  if (me->query_skill("power", 1) < 350) { command("say 你的鬭 气力量太低，无法学习我的绝学。\n"); return; }
  if (me->query_skill("spirit-power", 1) < 350) { command("say 你的精神力量太低，无法学习我的绝学。\n"); return; }
  if ((me->query_skill("literate") / 10 + me->query_int() - 2) < 50) {
    command("say 你的资质太差，无法学习我的绝学。\n"); return;
  }

  command("say 你的资质还算不错，我就收下你吧。\n");
  command("recruit " + me->query("id"));
  me->set("title", HIB "真·豪鬼秘传弟子" NOR);
  return;
}


string ask_juexue() {
  object me = this_player();
  if (me->query("family/master_id") != "gouki") return "此绝学不传世俗之人。\n";

  message_vision("\n$n缓缓说道： 阿修羅戰道乃是我自元武门绝学中衍生而来的另一套绝学。\n", me, this_object());

  message_vision("$n又道：波動拳产生殺意,昇龍拳增长霸意,两者皆会乱人心志,令人入魔,因此被列为元武门的禁招,入魔者则为邪道之人。\n", me, this_object());

  message_vision(
    "\n$n语气似乎蕴涵着些许的恨意：而我所认为的却不同，殺意，霸意皆能大幅度提升自己的实力，故而潜心研究，但掌门师\n兄怕我危害人间，将我逐出师门。\n",
    me,
    this_object()
  );

  message_vision(
    "\n$n说道：因缘巧合之下，二师兄赤昇龍，武流云和我，三人发现了学武之人的宝库---紫气山，武流云歹心残害二师兄，将我\n逼入山洞内，欲独霸宝藏。\n\n",
    me,
    this_object()
  );

  command("heihei");

  message_vision(
    "$n脸上露出一丝诡异的笑容：料他也想到，我在山中发现了另一个宝藏，也就是这里。匆忙领悟了些元武门的精髓，我逃入了\n这里，潜心修炼元武门所不耻的邪道。\n",
    me,
    this_object()
  );

  message_vision(
    "\n$n满是不屑的哼了一声：邪道？嘿嘿，那些俗人无一人能练成正道中的最高绝学，我却练就了邪道中的最高绝学，我将其命名\n为阿修羅戰道。我称霸武林的时候到了，哈哈哈哈......\n",
    me,
    this_object()
  );

  message_vision("\n$n逼视着你：若你想学得此绝学，需进入阿修羅地狱试炼，进入前我将消除你在元武门所学生生不息的记忆，且失败者，死。\n", me, this_object());
  me->set_temp("axlhell_in", 1);
  return "你确定要接受(accept)试炼吗？)\n";

}

void init() {
  add_action("do_accept", "accept");
}

int do_accept() {
  object me = this_player();
  if (!me->query_temp("axlhell_in")) return 0;
  message_vision("$N大声喝道：为了习得此绝学，我愿接受试炼。\n\n", me);
  command("great");
  message_vision("$n眼中突然发出异样的光芒，$N心中大骇却怎么也移不开目光。$N只觉脑袋一阵剧痛，顿时晕了过去。\n", me, this_object());
  me->delete("ssbx");
  me->delete("ssbx_can_learn");
  me->unconcious();
  me->move("/d/sfighter/hell1");
  return 1;
}



int prevent_learn(object me, string skill) {
  if (skill == "ghost-spirit") {
    if (!me->query("ghost-spirit")) {
      command("shake");
      command("say 没经受住阿修羅地狱的试炼无法体会阿修羅戰道的精髓。\n");
      return 1;
    }
  }
  return 0;

}

string leave_ghost() {
  object ob = this_object();
  object me = this_player();
  int skill = me->query_skill("ghost-spirit", 1);

  if (!me->query("ghost-spirit"))
    return "你并没有堕入魔道！\n";

  else if (skill < 1500)
    return "你尚未收尽魔性的折磨。\n";

  me->delete_skill("ghost-spirit");
  me->delete("ghost-spirit");
  return "即然你厌倦了魔道的生活，那就去吧。\n";
}
