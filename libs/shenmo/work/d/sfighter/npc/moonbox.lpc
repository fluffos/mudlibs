#include <ansi.h>
#include <dbase.h>
#include <armor.h>

inherit F_AUTOLOAD;
inherit ITEM;


void create()

{
  set_name(HIY "月光宝盒" NOR, ({ "moonbox", "box", "he" }));
  set_weight(100);
  set("long", "藏于盘丝洞地下，据说有让人穿梭时空的奇异威力。\n");
  set("value", 10000);
  set("material", "steel");
  set("no_sell", "这么难得的宝物还是留着吧。\n");
  set("unit", "只");
  setup();

}

void init() {
  add_action("do_back", "back");
  add_action("do_go", "go");
}

int do_back() {
  object me = this_player();

  if (me->query("kee") < 10)
    return notify_fail("你现在的状态怎么差,无法使用宝盒。\n");
  if (me->query("sen") < 10)
    return notify_fail("你现在的状态怎么差,无法使用宝盒。\n");
  if (me->is_fighting())
    return notify_fail("打架中你还有哪只手有空去拿月光宝盒呢？\n");

  tell_room(environment(me), HIY + me->query("name") + "双眼微闭，嘴中念起时空穿梭咒："
    "「波若波罗密乾坤大法，走！」\n"
    "一时狂沙漫天..... "
    "等你张开眼时," + me->query("name") + "的身影已经消失在漫天风沙之中.\n" NOR, me);

  tell_object(me, HIY "你双眼微闭，嘴中念起时空穿梭咒："
    "「波若波罗密乾坤大法，走！」\n"
    "你的身影已经消失在漫天风沙之中.\n" NOR);
  me->move("/d/sfighter/jiejie");
  message_vision(HIY "$N的身影突然出现在一阵狂风之中。\n" NOR, me);

  return 1;
}

int do_go() {
  object me = this_player();

  if (me->query("kee") < 10)
    return notify_fail("你现在的状态怎么差,无法使用宝盒。\n");
  if (me->query("sen") < 10)
    return notify_fail("你现在的状态怎么差,无法使用宝盒。\n");
  if (me->is_fighting())
    return notify_fail("打架中你还有哪只手有空去拿月光宝盒呢？\n");

  tell_room(environment(me), HIY + me->query("name") + "双眼微闭，嘴中念起时空穿梭咒："
    "「波若波罗密乾坤大法，走！」\n"
    "一时狂沙漫天..... "
    "等你张开眼时," + me->query("name") + "的身影已经消失在漫天风沙之中.\n" NOR, me);

  tell_object(me, HIY "你双眼微闭，嘴中念起时空穿梭咒："
    "「波若波罗密乾坤大法，走！」\n"
    "你的身影已经消失在漫天风沙之中.\n" NOR);
  me->move("/d/sfighter/jiejie2");
  message_vision(HIY "$N的身影突然出现在一阵狂风之中。\n" NOR, me);

  return 1;
}
