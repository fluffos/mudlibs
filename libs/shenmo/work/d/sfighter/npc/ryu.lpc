#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_father();

string ask_bodong();

void create() {
  set_name("赤龍", ({ "ryu", }));
  set("gender", "男性");
  set("long", "元武门刚拳的弟子，KEN的师兄,身世不明，似乎隐藏着什么秘密。\n" NOR);
  set("title", HIC "元武门弟子" NOR);
  set("age", 18);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 3000);
  set("kee", 3000);
  set("per", 30);
  set("max_sen", 3000);
  set("class", "saint");
  set("sen", 3000);
  set("combat_exp", 1500000);
  set("daoxing", 1000000);
  set("force", 2000);
  set("max_force", 4000);
  set("mana", 2000);
  set("max_mana", 4000);
  set("force_factor", 100);
  set("mana_factor", 100);
  set_skill("unarmed", 150);
  set_skill("yuanwu-kungfu", 150);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("literate", 200);
  set_skill("force", 150);
  set_skill("power", 150);
  set_skill("yuanwu-steps", 150);
  set_skill("spells", 100);
  set_skill("spirit-power", 100);
  map_skill("force", "power");
  map_skill("parry", "yuanwu-kungfu");
  map_skill("spells", "spirit-power");
  map_skill("unarmed", "yuanwu-kungfu");
  map_skill("dodge", "yuanwu-steps");
  set("inquiry", ([
    "name": "我就是元武门刚拳师傅的大弟子，请多多指教。",
  ]));
  set("inquiry", ([
    "father": (: ask_father :),
    "父亲": (: ask_father :),
    "你爹": (: ask_father :),
    "爹": (: ask_father :),
    "老爸": (: ask_father :),
    "爸爸": (: ask_father :),
    "波動拳": (: ask_bodong :),
  ]));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "bodong" :),
  }));

  create_family("格斗家", 3, "蓝");
  setup();
  carry_object("/d/sfighter/obj/fightcloth")->wear();
  carry_object("/d/sfighter/obj/ryutoudai")->wear();
}

void attempt_apprentice(object ob) {
  command("smile");
  command("say 恩，希望你今后能光大我们元武门。\n");
  command("recruit " + ob->query("id"));
  ob->set("title", HIC "元武门弟子" NOR);
  return;
}

string ask_father() {
  object me = this_player();
  object toudai;
  if (me->query("long_asked")) {
    command("ah");
    command("touchy");
    command("say 你。。你找到我父亲了，他在哪？他还好吗？\n");
    message_vision("$N对$n说明了经过：“￥&%$#……”\n", me, this_object());
    command("say 原来是这样。唉，我得先把师傅交代的事办好了才能去见我父亲，你把这头带交给他吧，他会明白的。\n");
    me->set_temp("ryu_asked", 1);
    toudai = new("/d/sfighter/obj/ryutoudai");
    toudai->move(me);
    //   command("give "+me->query("id")+" dai");
    return "太好了，我父亲还在世。\n";
  }

  return "我父亲关你P事。\n";

}


string ask_bodong() {
  object me = this_player();

  command("say 波動拳为元武门开派祖师所创，威力无铸，但因其是把自身体内清纯之气聚而发出，久而久之，体内清纯之气\n          不住减少,失控的杀气会逆侵入脑，使人陷入发狂状态，亦即杀意的境界。\n");

  command("say 杀意，能令人功力暂时增强许多，但这是一把双刃剑，功力增强的同时，你的心志会被杀意所控，无法自已。\n");
  command("say 就是因为这原因，波動拳被列为元武门禁招之一，若你经常使用波動拳，终会被杀意所控。\n");
  command("say 进入杀意境界，唯有将杀意宣泄出来方能回复心智。\n");
  return "当你被杀意所控之时，再来此处用波動拳(bodong)，将体内杀气散去，定能暂时回复。\n";

}

void die() {
  object ob = this_object();
  object weapon, head;
  object me = query_temp("my_killer");
  if (!me) me = query_temp("last_damage_from");
  if (!objectp(me)) SDS_D->powerup(ob);
  if (weapon = me->query_temp("weapon")) message_vision(
    "\n$N眼疾手快，手中" + weapon->query("name") + "将赤龍的头斩了下来。\n",
    me
  );
  if (!weapon) message_vision("\n$N眼疾手快，手刀一挥，将赤龍的头斩了下来。\n", me);
  head = new("/d/sfighter/obj/head");
  head->set("owner", me->query("id"));
  head->move(me);
  destruct(ob);
}

void unconcious() {
  die();
}
