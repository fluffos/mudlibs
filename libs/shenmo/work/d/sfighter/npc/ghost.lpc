#include <ansi.h>
inherit NPC;
inherit F_MASTER; 
 
void create()
{
          set_name("豪鬼", ({ "ghost","hao gui"}) );
        set("gender", "男性" );
        set("long","元武门刚拳的师弟,ryu ken 的师叔。\n"NOR);
        set("title",HIC"元武门弟子"NOR);
        set("age",40);
        set("attitude", "heroism");
        set("str",40);
        set("int",50);
        set("max_kee",3000);
        set("kee",3000);
        set("per",10);
        set("max_sen",3000);
        set("sen",3000);
        set("combat_exp",2500000);
        set("daoxing",1500000);
        set("force",8000);
        set("max_force",4000);
        set("mana",8000);
        set("max_mana",3000);
        set("force_factor", 200);
        set_skill("literate",250);
        set("mana_factor",200);
set("class","saint");
        set_skill("unarmed",250);
        set_skill("yuanwu-kungfu",250);
        set_skill("parry",250);
        set_skill("dodge",250);
        set_skill("force",250);
        set_skill("power",230);
        set_skill("yuanwu-steps",250);
        set_skill("spells", 200);
        set_skill("spirit-power", 200);
              map_skill("force","power");
              map_skill("spells", "spirit-power");
              map_skill("parry","yuanwu-kungfu");
              map_skill("unarmed","yuanwu-kungfu");
              map_skill("dodge","yuanwu-steps");
        set("inquiry", ([
                "name" : "我是元武门刚拳的师弟。",
                        ]) );
        set("inquiry", ([
                ]) );
        create_family("格斗家", 2, "蓝"); 
              setup();
        carry_object("/d/sfighter/obj/fightcloth")->wear();
}

void attempt_apprentice(object ob) 
{ 
           command("smile"); 
           command("say 恩，希望你今后能光大我们元武门。\n"); 
           command("recruit " + ob->query("id") );
           ob->set("title", HIC"元武门弟子"NOR); 
           return;
} 

