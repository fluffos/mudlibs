#include <ansi.h>
inherit NPC;


void create() {
  set_name("门众", ({ "men zhong" }));
  set("age", 20);
  set("gender", "男性");
  set("long",
    "武神流门众。\n");
  set("attitude", "peaceful");

  set("combat_exp", 10000);
  set("shen_type", 1);
  set("max_force", 200);
  set("force", 200);
  set("force_factor", 5);
  set_skill("unarmed", 30);
  set_skill("dodge", 40);
  set_skill("parry", 30);
  setup();
  carry_object("/d/sfighter/obj/fightcloth")->wear();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()
    && !this_player()->query("env/invisibility")) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("门众说道：这位" + RANK_D->query_respect(ob) +
    "，欢迎光临武神流！\n");
}
