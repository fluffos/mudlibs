#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_lang();
string ask_kungfu();

void create(object me) {
  set_name(HIM "樱花" NOR, ({ "sakura", "ying hua" }));
  set("gender", "女性");
  set("long", "武流云爱女，不喜欢读书而喜欢武艺，但其学的却不是武神流绝学，不知是从何学来的。\n" NOR);
  set("title", "武流云爱女");
  set("age", 16);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 2000);
  set("kee", 2000);
  set("per", 25);
  set("max_sen", 2000);
  set("sen", 2000);
  set("combat_exp", 1000000);
  set("daoxing", 800000);
  set("force", 3000);
  set("max_force", 1500);
  set("mana", 2000);
  set("max_mana", 1000);
  set("force_factor", 75);
  set("mana_factor", 75);
  set_skill("unarmed", 90);
  set_skill("literate", 180);
  set_skill("yuanwu-kungfu", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("power", 100);
  set_skill("yuanwu-steps", 100);
  set_skill("spells", 80);
  set_skill("spirit-power", 80);
  map_skill("force", "power");
  map_skill("spells", "spirit-power");
  map_skill("unarmed", "yuanwu-kungfu");
  map_skill("parry", "yuanwu-kungfu");
  map_skill("dodge", "yuanwu-steps");
  set("inquiry", ([
    "name": "我是...偏不告诉你。",
  ]));
  set("inquiry", ([
    "青狼": (: ask_lang :),
    "qing lang": (: ask_lang :),
    "武功": (: ask_kungfu :),
  ]));
  setup();
  carry_object("/d/sfighter/obj/fightcloth")->wear();
  carry_object("/d/sfighter/obj/toudai")->wear();
}

string ask_lang() {
  object tang;
  object me = this_player();
  command("say 你也知道青狼啊。\n");
  command("say 我小的时候，有一天在街上的时候，看到小青狼被别人欺负，好可怜哦。\n");
  command("say 所以我就把他带到我家来，跟我成了很好的朋友，他也只跟我一个人好。\n");
  command("say 后来我发现他呆在家里很不方便，就让他住到山上去。不知道怎么回事，\n");
  command("say 他突然拥有了很强大的力量，就占据了那座山，不让人靠近，除了我。\n");
  command("say 对了，他最喜欢吃这棒棒糖，你帮我带一个给他吃吧。\n");
  command("say 后来我发现他呆在家里很不方便，就让他住到山上去。不知道怎么回事，\n");
  tang = new("/d/sfighter/obj/bbtang");
  tang->move(this_object());
  command("give " + me->query("id") + " tang");
  return "记得帮我带给他哦，他一定很高兴的，谢谢你了。\n";

}

string ask_kungfu() {
  object me = this_player();
  object ob = this_object();

  if (me->query("family/master_id") != "gang quan" && me->query("family/master_id") != "ryu" && me->query("family/master_id") != "ken" && me->query("family/master_id") != "dan") return "我干嘛要告诉你？？\n";

  say("\n樱花说道：我告诉你个秘密吧，其实我的功夫是从一本书上学来的。有一天，我跟青狼打赌，看他能不能抬起洞口的那块大石，没想到他真的抬起来了。\n");
  say("\n樱花又道：这时我突然发现石头底下有个书，拿过来一看，原来是本武学秘籍，我高兴死了。我爹从来都不教我功夫，整天叫我读书，这下可好，哈哈。\n");
  say("\n樱花满脸的鬼灵精怪：于是，我也会武功了，我爹还在奇怪我哪学的呢？嘻嘻嘻。\n");
  say("\n樱花说道：你是元武门的弟子吧，那本书就是你们门的秘籍，我已经看完了，你把它拿走吧。不过别见怪啊，我只是学着玩玩的，应该不会有什么事吧？\n");

  return "书应该还在那，你赶快拿走吧，别让我爹知道了，不过那里面是禁地，你自己想办法去了，我可帮不了你。\n";
}
