#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_bodong();

void create() {
  set_name(HIR "赤龍" NOR, ({ "ryu", }));
  set("gender", "男性");
  set("long", "他已双眼血红，眼中除了Ken,已经没有其他事物。\n" NOR);
  set("title", HIC "元武门大弟子" NOR);
  set("age", 21);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 6000);
  set("kee", 6000);
  set("per", 30);
  set("max_sen", 6000);
  set("sen", 6000);
  set("combat_exp", 5000000);
  set("daoxing", 5000000);
  set("force", 15000);
  set("max_force", 7500);
  set("mana", 15000);
  set("max_mana", 7500);
  set("force_factor", 500);
  set("mana_factor", 500);
  set_skill("unarmed", 500);
  set_skill("yuanwu-kungfu", 500);
  set_skill("parry", 500);
  set_skill("dodge", 500);
  set_skill("literate", 500);
  set_skill("force", 500);
  set_skill("power", 500);
  set_skill("yuanwu-steps", 500);
  set_skill("spells", 500);
  set_skill("spirit-power", 500);
  map_skill("force", "power");
  map_skill("parry", "yuanwu-kungfu");
  map_skill("spells", "spirit-power");
  map_skill("unarmed", "yuanwu-kungfu");
  map_skill("dodge", "yuanwu-steps");
  set("inquiry", ([
    "name": "滚开！！",
  ]));
  set("inquiry", ([
    "波動": (: ask_bodong :),
    "bodong": (: ask_bodong :),
  ]));
  create_family("格斗家", 3, "蓝");
  setup();
  carry_object("/d/sfighter/obj/fightcloth")->wear();
  carry_object("/d/sfighter/obj/ryutoudai")->wear();
}

string ask_bodong() {
  object me = this_player();
  if (!me->query_temp("ghost_asked")) return "我干嘛要告诉你。\n";
  if (!me->query_temp("ken2_done")) return "没看到我正在与人搏斗，滚开！\n";
  message_vision("赤龍沉思了一会，缓缓对$N说道：波動的秘密就在于---化劲为气，以劲御气。\n", me);
  message_vision("$N喃喃念道：化劲为气，以劲御气？！\n", me);
  me->set_temp("ryu2_asked", 1);
  command("say 我想，这应该就是破解那秘密的其中一个关键。\n");
  return "那最高秘诀为元武祖师所创，但除了祖师老人家以外，从未有人悟出过。\n据说他老人家曾留下修炼那秘诀的方法，但具体在哪，如何悟出，没有人知道。\n";
}
