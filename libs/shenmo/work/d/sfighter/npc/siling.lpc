#include <ansi.h>
inherit NPC;
inherit F_MASTER; 
 
void create()
{
          set_name("死灵", ({ "si ling"}) );
        set("gender", "男性" );
        set("age",15);
        set("attitude", "aggressive");
        set("str",40);
        set("int",50);
        set("max_kee",3000);
        set("kee",3000);
        set("per",30);
        set("max_sen",3000);
        set("sen",3000);
        set("combat_exp",5000000);
        set("daoxing",5000000);
        set("force",6000);
        set("max_force",4500);
        set("mana",6000);
        set("max_mana",4500);
        set("force_factor", 100);
        set("mana_factor",200);
        set_skill("unarmed",300);
        set_skill("changquan",300);
        set_skill("parry",300);
        set_skill("dodge",300);
        set_skill("force",300);
        set_skill("literate",150);
        set_skill("lengquan-force",300);
        set_skill("yanxing-steps",300);
        set_skill("spells", 300);
        set_skill("baguazhou", 300);
              map_skill("force","lengquan-force");
              map_skill("spells", "baguazhou");
              map_skill("parry","changquan");
              map_skill("unarmed","changquan");
              map_skill("dodge","yanxing-steps");
        set("inquiry", ([
                        ]) );
        set("inquiry", ([
                ]) );
              setup();
}

void die ()
{
  object ob= this_object();
  object me = query_temp("last_damage_from");
  if(!me) me= query_temp("last_opponent");
  message_vision ("\n$N化做一阵风，消失不见了。\n",ob);  
  me->add_temp("hell_kill",1);
  destruct (ob);  
}

void unconcious ()
{
  die();
}

