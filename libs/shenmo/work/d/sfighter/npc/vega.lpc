#include <ansi.h>
inherit NPC;
inherit F_MASTER; 
 
void create()
{
          set_name(HIB"维加"NOR, ({ "vega",}) );
        set("gender", "男性" );
        set("long","神武天皇第二十七妃的第五个儿子，在争夺司令之位中凭着不择手段和强横
的实力获胜，世称赤目司令。在神武天皇授命下，带领诸多高手进入大地，欲支配整个世界。\n"NOR);
        set("title",HIR"赤目司令"NOR);
        set("age",35);
        set("attitude", "heroism");
        set("str",40);
        set("int",50);
        set("max_kee",2000);
        set("kee",2000);
        set("per",15);
        set("max_sen",2000);
        set("sen",2000);
        set("combat_exp",2000000);
        set("daoxing",2000000);
        set("force",6000);
        set("max_force",3000);
        set("mana",6000);
        set("max_mana",3000);
        set("force_factor", 100);
        set("mana_factor",150);
        set_skill("unarmed",250);
        set_skill("literate",250);
        set_skill("rukong-zhao",250);
        set_skill("parry",250);
        set_skill("dodge",250);
        set_skill("force",250);
        set_skill("power",250);
        set_skill("spells", 250);
        set_skill("spirit-power", 250);
              map_skill("force","power");
              map_skill("spells", "spirit-power");
              map_skill("parry","rukong-zhao");
              map_skill("dodge","lingshe-shenfa");
              map_skill("unarmed","rukong-zhao");
        set("inquiry", ([
                "name" : "哼！",
                        ]) );
        set("inquiry", ([
                ]) );
              setup();
        carry_object("/d/sfighter/obj/c-cloth")->wear();
}

void die()
{
  object ob= this_object();
  object me = query_temp("last_damage_from");
  object woman,vega;

  if(!me||!present(me,environment(ob))) me= query_temp("last_opponent");
  woman=present("woman",environment(ob));
 
  if (!me->query_temp("go_vega")) return;
  if (!woman) return;
  if (woman->query_leader()!=me)  return;
  message_vision("\n$n锐气顿消，连忙跪下求饶，毫无司令的风范，俨然一副无赖像。\n",me,ob);
  message_vision("突然间，那神秘老太婆以惊人的速度奔前，一拳将$n的头颅轰个粉碎，随即脱去衣裳，将赤目司令的战袍穿上！\n",me,ob);
  me->delete_temp("go_vega");
  vega=new("/d/sfighter/npc/vega_real");
  vega->move(environment(me));
  me->set_temp("vega_killed",1);
  destruct(woman);
  destruct(this_object());
::die();
return;
}
void unconcious()
{
  die();
}

