#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_shenglong();

void create() {
  set_name("KEN", ({ "ken", }));
  set("gender", "男性");
  set("long", "元武门刚拳的弟子，ryu的师弟。\n" NOR);
  set("title", HIC "元武门弟子" NOR);
  set("age", 17);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 3000);
  set("kee", 3000);
  set("per", 30);
  set("max_sen", 3000);
  set("sen", 3000);
  set("combat_exp", 1300000);
  set("class", "saint");
  set("daoxing", 1000000);
  set("force", 2000);
  set("max_force", 4000);
  set("mana", 2000);
  set("max_mana", 4000);
  set("force_factor", 100);
  set("mana_factor", 100);
  set_skill("unarmed", 140);
  set_skill("yuanwu-kungfu", 140);
  set_skill("parry", 140);
  set_skill("dodge", 140);
  set_skill("literate", 200);
  set_skill("force", 140);
  set_skill("power", 140);
  set_skill("yuanwu-steps", 140);
  set_skill("spells", 100);
  set_skill("spirit-power", 100);
  map_skill("force", "power");
  map_skill("spells", "spirit-power");
  map_skill("parry", "yuanwu-kungfu");
  map_skill("unarmed", "yuanwu-kungfu");
  map_skill("dodge", "yuanwu-steps");
  set("inquiry", ([
    "name": "我是元武门刚拳师傅的二弟子。",
  ]));
  set("inquiry", ([
    "昇龍拳": (: ask_shenglong :),
  ]));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "shenglong" :),
  }));

  create_family("格斗家", 3, "蓝");
  setup();
  carry_object("/d/sfighter/obj/fightcloth")->wear();
}

void attempt_apprentice(object ob) {
  command("smile");
  command("say 恩，希望你今后能光大我们元武门。\n");
  command("recruit " + ob->query("id"));
  ob->set("title", HIC "元武门弟子" NOR);
  return;
}

string ask_shenglong() {
  object me = this_player();

  command("say 昇龍拳为元武门开派祖师所创，威力无铸，但因其逆天而上，有违天道，随着使用次数的增加，\n         体内抗天的霸意会不住剧增，进而控制使用者的心智，亦即霸意的境界。\n");

  command("say 霸意，能令人功力暂时增强许多，但在功力增强的同时，你的心志会被霸意所控，无法自已。\n");
  command("say 就是因为这原因，昇龍拳被列为元武门禁招之一，若你经常使用昇龍拳，终会被霸意所控。\n");
  command("say 进入霸意境界，唯有将霸意宣泄出来方能回复心智。\n");
  return "当你被霸意所控之时，再来此处用昇龍拳(shenglong)，将体内霸气散去，定能暂时回复。\n";

}
