#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "密室");
  set("long", @LONG
这是一个石头砌成的房间，因为好久没有人来过，散发着一些很难闻的
气味，房间中到处可以看到蛛丝和虫迹。地上一块地方的土(tu)显得与
其他地方的土有点不同。
LONG);
  set("exits", ([
    "east": __DIR__ "shishi1",
  ]));

  create_door("east", "石门", "west", DOOR_CLOSED);

  set("item_desc", ([
    "tu": "这里的土好象有点奇怪，要不要挖(dig)看看。 \n",
    "土": "这里的土好象有点奇怪，要不要挖(dig)看看。 \n",
  ]));

  setup();
}

void init() {
  add_action("do_dig", "dig");
}

int do_dig(string arg) {

  object ob, me;

  me = this_player();

  if ((!arg) || (arg != "tu" && arg != "土"))
    return notify_fail("你要挖什么？\n");

  if (!(ob = me->query_temp("weapon")) || ((string)ob->query("skill_type") != "axe" && (string)ob->query("skill_type") != "blade" && (string)ob->query("skill_type") != "sword"))
    return notify_fail("得找个好工具吧。\n");

  if (query("no_moonbox"))
    return notify_fail("你挖了一个洞，却没发现什么东西，好象被别人先挖走了。\n");

  ob = new("/d/sfighter/obj/moonbox");
  ob->move(me);
  message_vision("$N挖了几下，发现土底下似乎有什么东西，拿出来一看，俨然就是一个 " + HIY "月光宝盒" NOR + " 。\n", me);
  set("no_moonbox", 1);
  call_out("regenerate", 300);
  return 1;
}

int regenerate() {
  set("no_moonbox", 0);
  return 1;
}
