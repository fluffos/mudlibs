inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_mieyao(object me);
string ask_cancel();
string expell_me(object me);


void create()
{
       set_name("将军", ({"jiang jun","jiang","jun"}));
       set("gender", "男性" );
        create_family("格斗家", 3, "弟子");
        set("title",HIG"史前最邪恶的格斗家"NOR);
        set("age", 41);
       set("class", "saint");
        set("long", "史前最邪恶的格斗家，专门在正派和邪派间挑拨是非。");
        set("attitude", "peaceful");
        setup();
set("inquiry", ([

            "斗仙": (: ask_mieyao :),
            "cancel": (: ask_cancel :),
]) );


    //    carry_object("/d/moon/obj/luoyi")->wear();
	carry_object("/d/obj/weapon/sword/changjian")->wield();
}


string ask_cancel()
{
    object me=this_player();
if((int)me->query_temp("m_mieyao"))
{
      me->add("daoxing",-2000);
      me->delete_temp("m_mieyao");
      me->delete("secmieyao");
      me->delete("secmieyao/type");
      me->delete("secmieyao/location");
      me->delete("secmieyao/place");
      me->delete("secmieyao/name");
      me->delete("secmieyao/id");
     return ("哎，我也不怪你，以后你可得努力哦！");
}
else
{
     return ("你有任务吗？！");
}
}
string ask_mieyao(object me)
{
    me=this_player();
     if((string)me->query("family/family_name")=="格斗家") {
    tell_room(environment(me),"将军说道.....\n");
    return "/d/obj/mieyao"->query_yao(me);
}
     return ("本将军不知道你在说些什么。");
}
string expell_me(object me)
{       
        me=this_player();
        if((string)me->query("family/family_name")=="格斗家") {
                message_vision("将军叹了口气，十分不情愿的看着你。\n", me);
                me->set_temp("betray", 1);
                message_vision("将军对$N嘟噜着：你真的不愿和我同流合污(true)？\n", me);
                return ("好吧，你可不要后悔哦！\n");
        }
        return ("问什么问！自己想去！\n");
}
void init()
{
        add_action("do_true", "true");
  ::init();
}

int do_true(string arg)
{
        if(this_player()->query_temp("betray")) {
                message_vision("$N答道：弟子讲的真心话！\n\n", this_player());
                message_vision("将军叹道，既然如此，你便去吧！\n", this_player());
                this_player()->set("combat_exp", this_player()->query("combat_exp")*80/100);
                this_player()->add("betray/count", 1);
                this_player()->add("betray/hell", 1);
                this_player()->delete("family");
                this_player()->delete_skill("yuanwu-kungfu");
                this_player()->delete_skill("wusheng-kungfu");
                this_player()->delete_skill("rukong-zhao");
                this_player()->delete("class");
                this_player()->set("title", "普通百姓");
                this_player()->set_temp("betray", 0);
                this_player()->save();
                message_vision("将军突然向天空一指，$N便消失得无影无踪。。。\n", this_player());
                this_player()->move("/d/city/center");
                tell_room( environment(this_player()),"房梁上噗噗嗦嗦几声响，掉下个人来！\n", ({this_player()}));
                this_player()->unconcious();            
                return 1;
                }
        return 0;
}
