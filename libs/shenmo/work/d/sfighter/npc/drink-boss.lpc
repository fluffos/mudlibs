#include <ansi.h>
inherit NPC;


void create()
{
        set_name("老板", ({"boss", "laoban" }) );
        set("age", 42);
        set("gender", "男性");
        set("long",
"老板瞪了你一眼，不睬你，又继续破口大骂。\n");
	set("title", "酒吧");
        set("attitude", "peaceful");

        set("combat_exp", 10000);
        set("shen_type", 1);
	set("max_force", 200);
	set("force", 200);
	set("force_factor", 5);
set("class","yao");
        set_skill("unarmed", 30);
        set_skill("dodge", 40);
        set_skill("parry", 30);
        setup();
        carry_object("/d/sfighter/obj/shizhuang")->wear();
}


void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
        switch( random(1) ) {
                case 0:
                        say( name()+"说道：他妈的，一群王八羔子，没事就在这闹事，跑得倒挺快，下次别让我逮着。\n");
                        break;
        }
}

