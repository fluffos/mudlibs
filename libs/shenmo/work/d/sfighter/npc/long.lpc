#include <ansi.h>
inherit NPC;
inherit F_MASTER; 
 
void create()
{
          set_name(HIC"赤昇龍"NOR, ({ "ryu",}) );
        set("gender", "男性" );
        set("long","一个神秘的男人，似乎发生过什么事，他全身的筋肉都与旁边的石头合为一体。\n"NOR);
        set("title","");
        set("age",40);
        set("attitude", "heroism");
        set("str",40);
        set("int",50);
        set("max_kee",5000);
        set("kee",5000);
        set("per",30);
        set("max_sen",5000);
        set("sen",5000);
        set("combat_exp",3500000);
        set("daoxing",2500000);
set("class","saint");
        set("force",12000);
        set("max_force",6000);
        set("mana",12000);
        set("max_mana",6000);
        set("force_factor", 500);
        set("mana_factor",200);
        set_skill("unarmed",350);
        set_skill("yuanwu-kungfu",350);
        set_skill("parry",350);
        set_skill("dodge",350);
        set_skill("literate",300);
        set_skill("force",350);
        set_skill("power",350);
        set_skill("yuanwu-steps",350);
        set_skill("spells", 250);
        set_skill("spirit-power", 250);
              map_skill("force","power");
              map_skill("parry","yuanwu-kungfu");
              map_skill("spells", "spirit-power");
              map_skill("unarmed","yuanwu-kungfu");
              map_skill("dodge","yuanwu-steps");
        set("inquiry", ([
                "name" : "我是赤昇龍。",
                        ]) );
        set("inquiry", ([
                ]) );
        create_family("格斗家", 2, "蓝"); 
              setup();
        carry_object("/d/sfighter/obj/fightcloth")->wear();
}

void attempt_apprentice(object me) 
{          
           if(me->query_temp("long_done")) {
           command("nod"); 
           command("say 希望你今后能光大我们元武门。\n"); 
           command("recruit " + me->query("id") );
           me->set("title", HIC"元武门弟子"NOR); 
           return;}
 
           command("say 由于我和武流云的一段恩怨，使得我在此受苦了十来年。近来听说我还有个儿子在这世上，\n");
           command("say 如果能帮我找到他的下落，我就传授你武艺。\n");
           me->set("long_asked",1);
           return;
          
} 

int accept_object(object me, object ob)
{
  string thing=(string)ob->query("id");

     if (ob->query("id") != "ryu toudai") {command("say 这是什么东西？\n");return 1;}
     if (me->query_temp("ryu_asked")){
     command("say 这是什么？你找到我儿子了吗？\n");
     message_vision("$N凑上前与$n说了几句话。\n",me,this_object());
     message_vision("$N仔细看了看手上的头带，发现头带的尾端绣了两个金色小字--“赤龍”。\n",this_object());
     command("touchy");
     command("say 你果然找到我儿子了！！没想到他还在这世上，可惜飘雪。。。。\n");
     command("sigh");
     command("say 你做得不错，我就指点你些武艺吧。\n");
     me->set_temp("long_done",1);
     return 1;
}
}
