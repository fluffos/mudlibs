#include <ansi.h>
inherit NPC;

int ask_ken();

void create()
{
        set_name("茱莉亞", ({"julier"}) );
        set("age", 16);
        set("gender", "女性");
        set("class", "saint");
        set("long",
"极为漂亮的一个女孩，是铁面域加的表妹，如果你胆敢碰她一个汗毛...。\n");
        set("attitude", "peaceful");
        set("combat_exp", 10000);
        set("shen_type", 1);
	set("max_force", 200);
	set("force", 200);
       set("per",40);
	set("force_factor", 5);
        set_skill("unarmed", 30);
        set_skill("dodge", 40);
        set_skill("parry", 30);
        set("inquiry", ([
                "ken" : (: ask_ken :),
                ]) );

        setup();
        carry_object("/d/sfighter/obj/skirt")->wear();
}

void kill_ob (object ob) 
{ 
       object me = this_object(); 
       object where = environment (me); 
       object viga = present ("viga", where); 
      
       set_temp("my_killer",ob); 
       ::kill_ob(ob); 
       if (viga && !viga->is_fighting()) 
         viga->kill_ob(ob); 
     } 

int ask_ken()
{
   object thing;
   object ob,me;
   me = this_object();
   ob = this_player();
   if(ob->query_temp("ken2_asked")) {
   message_vision("$N静默了良久，从脖子上解下一条银质项链，说：“你帮我把这项链交给他吧。”。\n",this_object());
   thing=new("/d/sfighter/obj/necklace");
   thing->move(me);
   command("give xiang lian to " + ob->query("id"));
   message_vision("茱莉亞满脸的感伤，又是默立不动，似乎在想些什么。\n");
           }
   else
      {
   message_vision("茱莉亞脸上突然显出奇怪的神情，小声说道：“我不认识他，你快走吧。”\n");
      }
   return 1;
}
