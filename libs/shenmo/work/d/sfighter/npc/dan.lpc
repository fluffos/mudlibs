#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("丹", ({ "dan" }));
  set("gender", "男性");
  set("long", "元武门刚拳的弟子，Ryu,Ken的小师弟。\n" NOR);
  set("title", HIC "元武门弟子" NOR);
  set("age", 15);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 3000);
  set("kee", 3000);
  set("per", 30);
  set("max_sen", 3000);
  set("sen", 3000);
  set("combat_exp", 800000);
  set("daoxing", 500000);
  set("force", 2000);
  set("max_force", 1000);
  set("mana", 2000);
  set("max_mana", 1000);
  set("force_factor", 50);
  set("mana_factor", 50);
  set("class", "saint");
  set_skill("unarmed", 80);
  set_skill("yuanwu-kungfu", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("force", 80);
  set_skill("literate", 150);
  set_skill("power", 80);
  set_skill("yuanwu-steps", 80);
  set_skill("spells", 80);
  set_skill("spirit-power", 80);
  map_skill("force", "power");
  map_skill("spells", "spirit-power");
  map_skill("parry", "yuanwu-kungfu");
  map_skill("unarmed", "yuanwu-kungfu");
  map_skill("dodge", "yuanwu-steps");
  set("inquiry", ([
    "name": "我就是元武门刚拳师傅的弟子，请多多指教。",
  ]));
  set("inquiry", ([
  ]));
  create_family("格斗家", 3, "蓝");
  setup();
  carry_object("/d/sfighter/obj/fightcloth")->wear();
}

void attempt_apprentice(object ob) {
  command("nod");
  command("say 希望你今后能光大我们元武门。\n");
  command("recruit " + ob->query("id"));
  ob->set("title", HIC "元武门弟子" NOR);
  return;
}
