#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_shenglong();
string ask_julier();

void create() {
  set_name(HIY "KEN" NOR, ({ "ken", }));
  set("gender", "男性");
  set("class", "saint");
  set("long", "他已双眼血红，除了Ryu，已经不认识其他事物，但还有一个人。。。。\n" NOR);
  set("title", HIC "元武门二弟子" NOR);
  set("age", 20);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 6000);
  set("kee", 6000);
  set("per", 30);
  set("max_sen", 6000);
  set("sen", 6000);
  set("combat_exp", 5000000);
  set("daoxing", 5000000);
  set("force", 15000);
  set("max_force", 7500);
  set("mana", 15000);
  set("max_mana", 75000);
  set("force_factor", 500);
  set("mana_factor", 500);
  set_skill("unarmed", 500);
  set_skill("yuanwu-kungfu", 500);
  set_skill("parry", 500);
  set_skill("dodge", 500);
  set_skill("literate", 500);
  set_skill("force", 500);
  set_skill("power", 500);
  set_skill("yuanwu-steps", 500);
  set_skill("spells", 500);
  set_skill("spirit-power", 500);
  map_skill("force", "power");
  map_skill("spells", "spirit-power");
  map_skill("parry", "yuanwu-kungfu");
  map_skill("unarmed", "yuanwu-kungfu");
  map_skill("dodge", "yuanwu-steps");
  set("inquiry", ([
    "name": "滚开!!",
  ]));
  set("inquiry", ([
    "昇龍": (: ask_shenglong :),
    "shenglong": (: ask_shenglong :),
    "julier": (: ask_julier :),
    "茱莉亚": (: ask_julier :),
  ]));
  create_family("格斗家", 3, "蓝");
  setup();
  carry_object("/d/sfighter/obj/fightcloth")->wear();
}

string ask_shenglong() {
  object me = this_player();
  if (!me->query_temp("ghost_asked")) return "我干嘛要告诉你。\n";
  if (!me->query_temp("ken2_gived")) return "没看到我在和人搏斗吗？懒得理你。\n";
  message_vision("Ken沉思了一会，缓缓对$N说道：昇龍的秘密就在于---化气成劲，以气御劲。\n", me);
  message_vision("$N喃喃念道：化气成劲，以气御劲？！\n", me);
  me->set_temp("ken2_done", 1);
  return ("我想，这应该就是破解那秘密的其中一个关键。\n");
}

string ask_julier() {
  object me = this_player();
  if (me->query_temp("ken2_asked")) return "你还没找到茱莉亚吗？\n";
  command("pain ken");
  command("sigh");
  command("say 你能帮我找到茱莉亚吗？如果你能找到，我就告诉你昇龍的秘密。\n");
  me->set_temp("ken2_asked", 1);
  return "茱莉亚....\n";
}

int accept_object(object me, object ob) {
  string thing = (string)ob->query("id");

  if (ob->query("id") != "julier necklace") { command("say 这是什么东西？\n"); return 1; }
  if (!me->query_temp("ken2_asked")) { command("say 你怎么会有这东西？！\n"); return 1; }
  command("say 这是!!\n");
  command("pain ken");
  command("sigh");
  command("say 果然还是。。。。\n");
  command("say 多谢你了，你有什么事要我帮忙的吗？\n");
  me->set_temp("ken2_gived", 1);
  return 1;
}
