#include <ansi.h>

string ask_mieyao(object me); 
inherit NPC;
void create()
{
        set_name(HIR"岳王"NOR, ({ "yue wang","yue" }) );
        set("title", HIG"拳祖武穆" HIW"  精忠报国"NOR);
        set("gender", "男性" );
        set("age", 39);
        set("str", 50);
        set("cor", 30);
        set("cps", 30);
        set("int", 30);
        set("per", 30);
        set("long",
                "受母刺字，精忠报国，创散打，演六合，金兵闻名丧胆的岳王爷！\n");
        set("max_force", 15000);
        set("force", 15000);
        set("force_factor", 120);
        set("combat_exp", 10000000);
        set("attitude", "friendly");
        set("inquiry", ([
        "练气": (: ask_mieyao :),  
        ]) );
        set("max_kee", 1800);
        set("max_sen", 1800);
        set_skill("parry", 180);
        set_skill("dodge", 180);
        set_skill("force", 180);
        set_skill("literate", 120);
        set_temp("apply/attack",200);
        set_temp("apply/defense",200);
        set_skill("dodge", 200);
        set_skill("unarmed", 300);
        setup();
        carry_object("/d/obj/armor/jinjia")->wear();

}
string ask_mieyao(object me)
{
    me=this_player();
     if((string)me->query("family/family_name")=="格斗家") {
    tell_room(environment(me),"岳王爷说道.....\n");
    return "/d/obj/mieyao"->query_yao(me);
}
     return ("你看清楚了，那可是神像！");
}
