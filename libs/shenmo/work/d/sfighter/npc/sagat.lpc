#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("萨加特", ({ "sagat", }));
  set("gender", "男性");
  set("long", "阿东的师傅，将泰拳威力发挥至顶峰。几年前，被赤龙的一记升龙拳在胸口留下一长道不可磨灭的伤疤，故因此隐退，苦修绝技。\n" NOR);
  set("title", HIR "最强泰拳" NOR);
  set("age", 42);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 4000);
  set("kee", 4000);
  set("per", 15);
  set("max_sen", 2000);
  set("sen", 2000);
  set("combat_exp", 1000000);
  set("daoxing", 200000);
  set("class", "saint");
  set("force", 3000);
  set("max_force", 3000);
  set("mana", 3000);
  set("max_mana", 3000);
  set("force_factor", 100);
  set("mana_factor", 20);
  set_skill("unarmed", 120);
  set_skill("literate", 120);
  set_skill("taiquan", 120);
  set_skill("parry", 120);
  set_skill("dodge", 120);
  set_skill("force", 120);
  set_skill("power", 120);
  set_skill("spells", 100);
  set_skill("spirit-power", 100);
  map_skill("force", "power");
  map_skill("spells", "spirit-power");
  map_skill("parry", "taiquan");
  map_skill("dodge", "lingshe-shenfa");
  map_skill("unarmed", "taiquan");
  set("inquiry", ([
    "name": "哼！",
  ]));
  set("inquiry", ([
  ]));
  create_family("格斗家", 3, "蓝");
  setup();
  carry_object("/d/sfighter/obj/fightcloth")->wear();
}

int accept_object(object me, object ob) {
  string thing = (string)ob->query("id");

  if (ob->query("id") != "ryu`s head") { command("say 这是什么东西？\n"); return 1; }
  if (ob->query("owner") != me->query("id")) { command("say 人不是你杀的吧？休来唬我。\n"); return 1; }
  command("u&me");
  say("撒加特提起赤龍的头颅不住狂笑。\n");
  command("say 终于报了当年的一拳之仇，哈哈，没想到你也有这么一天。\n");
  me->set("sagat_bai", 1);
  return 1;
}

void attempt_apprentice(object me) {
  if (me->query("sagat_bai")) {
    command("spank " + me->query("id"));
    command("say 既然你帮我报了大仇，我就按照约定将我独门功夫传授与你。\n");
    command("recruit " + me->query("id"));
    me->delete("sagat_accept");
    me->set("title", HIC "撒加特" HIB "秘传弟子" NOR);
    return;
  }
  command("consider");
  command("say 当年我被赤龍所败，在胸口留下了这耻辱的伤疤，我没有一天不想着要报仇，但.....\n");
  command("sigh");
  command("say 我长期苦练，虽然悟出了绝招，但身体已经承受不住当年的内伤，现在肯定报不了这一拳之仇了。\n");
  command("say 如果你能将赤龍的头颅提来给我，我就将那绝招传授与你。\n");
  me->set("sagat_accept", 1);
  return;
}
