#include <ansi.h>
inherit NPC;


void create()
{
        set_name("黑衣人", ({"heiyi ren", "man" }) );
        set("age", 30);
        set("gender", "男性");
        set("long",
"面上毫无表情，极为冷酷,见你走近，瞟都不瞟你一眼。\n");
	set("title", "门卫");
        set("attitude", "peaceful");

        set("combat_exp", 10000);
        set("shen_type", 1);
	set("max_force", 200);
	set("force", 200);
	set("force_factor", 5);
        set_skill("unarmed", 30);
        set_skill("dodge", 40);
        set_skill("parry", 30);
        setup();
        carry_object("/d/sfighter/obj/shizhuang")->wear();
}

