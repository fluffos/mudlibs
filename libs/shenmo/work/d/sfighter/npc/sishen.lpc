#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("死神", ({ "si shen", "shen" }));
  set("gender", "男性");
  set("long", "武神流武流云门下弟子，因武流云二弟子一事，被谴来看守禁地。\n" NOR);
  set("title", HIC "武神流弟子" NOR);
  set("age", 25);
  set("class", "saint");
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 3000);
  set("kee", 3000);
  set("per", 25);
  set("max_sen", 3000);
  set("sen", 3000);
  set("combat_exp", 1500000);
  set("daoxing", 1000000);
  set("force", 6000);
  set("max_force", 3000);
  set("mana", 6000);
  set("max_mana", 3000);
  set("force_factor", 150);
  set("mana_factor", 150);
  set_skill("unarmed", 150);
  set_skill("wushen-kungfu", 150);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("force", 150);
  set_skill("literate", 150);
  set_skill("power", 150);
  set_skill("wushen-steps", 150);
  set_skill("spells", 100);
  set_skill("spirit-power", 100);
  map_skill("force", "power");
  map_skill("spells", "spirit-power");
  map_skill("unarmed", "wushen-kungfu");
  map_skill("parry", "wushen-kungfu");
  map_skill("dodge", "wushen-steps");
  set("inquiry", ([
    "name": "我是武神流弟子---死神。",
  ]));
  set("inquiry", ([
  ]));
  create_family("格斗家", 3, "蓝");
  setup();
  carry_object("/d/obj/armor/tiejia")->wear();
  carry_object("/d/qujing/tianzhu/obj/tiekui")->wear();
}

int accept_object(object me, object ob) {
  if (ob->query("id") != "ling pai") {
    message_vision("$N嘴角一动，崩出一个字：滚！\n", this_object());
    return 1;
  } else {
    message_vision("$n接过令牌一看，说“是师傅的令牌没错，你可以进入禁地吧。”。\n", me, this_object());
    me->set_temp("zqs_passed", 1);
    return 1;
  }
}
