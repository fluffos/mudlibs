#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_door();
string ask_box();
string expell_me(object me);
string ask_mieyao();
string ask_cancel();

void create() {
  set_name(HIM "玫瑰" NOR, ({ "rose", "meigui" }));
  set("gender", "女性");
  set("long", "一个打扮穿着非常奇怪的女孩，不知从哪来的。\n" NOR);
  set("title", HIW "神秘人" NOR);
  set("age", 18);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("per", 30);
  set("max_kee", 4100);
  set("class", "saint");
  set("kee", 4100);
  set("max_sen", 3100);
  set("sen", 3100);
  set("combat_exp", 1000000);
  set("daoxing", 12500000);
  set("force", 4000);
  set("max_force", 2000);
  set("mana", 15000);
  set("max_mana", 7500);
  set("force_factor", 150);
  set("mana_factor", 750);
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("literate", 200);
  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("power", 100);
  set_skill("spells", 500);
  set_skill("spirit-power", 500);
  map_skill("force", "power");
  map_skill("spells", "spirit-power");
  set("inquiry", ([
    "name": "我叫玫瑰,因为某些原因从几千年后来到这，很奇怪吧！！",
  ]));
  set("inquiry", ([
    "时光之门": (: ask_door :),
    "door": (: ask_door :),
    "月光宝盒": (: ask_box :),
    "moonbox": (: ask_box :),
    //      		  "leave": (: expell_me :),
    //                "卫道": (: ask_mieyao :),
    //                "cancel": (: ask_cancel :),
  ]));
  create_family("格斗家", 3, "蓝");
  setup();
  carry_object("/d/sfighter/obj/pijian")->wear();
  carry_object("/d/sfighter/obj/skirt")->wear();
}

string ask_door() {
  command("sigh");
  command("say 几千年以后，有两个绝世高手互相争斗，他们巨大的能量造成了时光的混乱，\n");
  command("say 其中一个混乱点出现在此，我用尽全身精力布成了这个结界，但也只能勉强\n");
  command("say 控制住时光继续混乱下去，已经无法使之恢复了。\n");
  return "听闻这里有一个名叫" + HIY "月光宝盒" NOR + "的宝物，亦能穿梭时空。\n";

}

string ask_box() {
  return "再过几年，将会有一个叫周星驰的家伙从盘丝洞挖出月光宝盒，现在应该还在那吧!\n";
}

int accept_object(object me, object ob) {
  object box;
  string thing = (string)ob->query("id");

  if (ob->query("id") != "moonbox") {
    command("say 谢谢你送礼物给我 :) ");
    return 1;
  } else {
    command("nod");
    command("say 就是这东西！果然具有穿梭时空的威力。\n");
    command("consider");
    command("say 这样吧,就让你进入此时光之门，希望能够阻止时光继续混乱下去。\n");
    command("say 宝盒你就带走吧。");
    call_out("dummy", 3, me, this_object());
    message(
      "vision",
      "玫瑰将披肩往" + me->name() + "眼前一拂，只见光亮一闪，" + me->name() + "消失了!!\n",
      environment(me),
      me
    );

    tell_object(me, "玫瑰将披肩往你眼前一拂，只见亮光一闪，你突然出现在一个奇异的地方，周围光亮无比。\n");
    tell_object(me, "突然在你眼前出现了一个洞，有股奇怪的劲力将你推进洞去。\n");
    me->move("/d/sfighter/jiejie2");
    message("vision", "只见强光一闪," + me->name() + "突然出现了!!\n", environment(me), me);
    tell_object(me, "眼睛一阵刺痛，你发现自己站在另一个结界之中。\n");
    ob = new("/d/sfighter/obj/moonbox");
    ob->move(me);
    return 1;
  }
}
void attempt_apprentice(object ob) {
  command("smile");
  command("say 希望我能够指点你些什么。\n");
  command("recruit " + ob->query("id"));
  ob->set("title", "玫瑰弟子");
  return;
}

int dummy(object me, object target) { return 1; }

string expell_me(object me) {
  me = this_player();

  if ((string)me->query("class") == "sfighter") {
    message_vision("玫瑰皱了皱眉。\n", me);
    me->set_temp("sfighter_betray", 2);
    message_vision("玫瑰幽怨地望着$N，缓缓说道：你真的不想再呆下去了(true)？\n", me);
    return ("唉！\n");
  }
  return ("问什么问！自己想去！\n");
}

void init() {
  //	add_action("do_true", "true");
}

int do_true(string arg) {
  if (this_player()->query_temp("sfighter_betray") > 1) {
    message_vision("$N答道：弟子讲的真心话！\n\n", this_player());
    message_vision("玫瑰叹了口气道：那好！你这就去吧！\n", this_player());
    this_player()->add("betray/sfighter", 1);
    this_player()->add("betray/count", 1);

    this_player()->set("combat_exp", this_player()->query("combat_exp") * 80 / 100);
    this_player()->set("daoxing", this_player()->query("daoxing") * 80 / 100);
    this_player()->delete_skill("power");

    this_player()->delete("family");
    this_player()->delete("class");
    this_player()->add("betray/count", 1);
    this_player()->add("betray/sfighter", 1);
    this_player()->set("title", "普通百姓");
    this_player()->delete_temp("sfighter_betray");
    return 1;
  }
  return 0;
}

string ask_mieyao() {
  object who = this_player();

  if ((string)who->query("family/family_name") == "格斗家") {
    command("smile " + who->query("id"));
    return "/d/obj/mieyao"->query_yao(who);
  }
  return ("你有什么事吗？\n");
}

string ask_cancel() {
  object me = this_player();
  if ((int)me->query_temp("m_mieyao")) {
    me->add("daoxing", -1000);
    me->delete_temp("m_mieyao");
    me->delete("secmieyao");
    me->delete("secmieyao/type");
    me->delete("secmieyao/location");
    me->delete("secmieyao/place");
    me->delete("secmieyao/name");
    me->delete("secmieyao/id");
    return ("下次继续努力吧！");
  } else {
    return ("你有任务吗？！");
  }
}
