#include <ansi.h>
inherit NPC;
inherit F_MASTER; 
 
void create()
{
          set_name(HIG"青狼"NOR, ({ "qing lang"}));
        set("gender", "女性" );
        set("long","在核辐射下身体变异，自小就被人欺负，后来被樱花收\n
养在紫气山上。因为吸收了紫气，拥有了强大的力量。除了樱花，\n闯入他地盘的都得死。如果你能给他喜爱的东西，或许他会放你\n进入洞中。\n"NOR);
        set("age",16);
        set("title","");
        set("attitude", "heroism");
        set("str",40);
        set("int",50);
        set("max_kee",5000);
        set("kee",5000);
        set("per",11);
        set("max_sen",5000);
        set("sen",5000);
        set("combat_exp",3000000);
        set("daoxing",1000000);
        set("force",10000);
        set("max_force",5000);
        set("mana",6000);
        set("max_mana",3000);
        set("force_factor", 450);
        set("mana_factor",100);
        set_skill("unarmed",300);
        set_skill("qinglang-zhua",300);
        set_skill("parry",300);
        set_skill("dodge",300);
        set_skill("force",300);
        set_skill("literate",200);
        set_skill("power",300);
        set_skill("yuanwu-steps",300);
        set_skill("spells", 150);
        set_skill("spirit-power", 150);
              map_skill("force","power");
              map_skill("spells", "spirit-power");
              map_skill("parry","qinglang-zhua");
              map_skill("unarmed","qinglang-zhua");
              map_skill("dodge","yuanwu-steps");
        set("inquiry", ([
                "name" : "吼。。",
                        ]) );
        set("inquiry", ([
                ]) );
              setup();
}
int accept_object(object me, object ob)
{
     if (ob->query("id") != "bangbang tang"){
   message_vision("青狼接过$N的东西，咬了几口，狂吼了几声，把手中的东西扔掉了。\n",me);
     return 1;}
    else {
      message_vision("青狼见了棒棒糖，口水直流，一把抢了过去，边舔边跑开了。\n",me);
      if(me->query_temp("wushen_asked")) me->set_temp("wushen_done",1);
      call_out("run_out",3,this_object());
      return 1;}
}

void die() 
{ 
      
             object ob = query_temp("last_damage_from"); 
        
             if(ob&&ob->query_temp("wushen_asked")) 
             { 
              ob->set_temp("wushen_done",1);
              ob->delete_temp("wushen_asked");
                     destruct(this_object());
             } 
 } 

void run_out(object ob)
{   message_vision("青狼满意的舔舔嘴，跑开了。\n");
    destruct(ob);
} 
