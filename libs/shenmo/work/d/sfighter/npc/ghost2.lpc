#include <ansi.h>
inherit NPC;
inherit F_MASTER; 

string ask_sys();
 
void create()
{
          set_name(HIB"真·豪鬼"NOR, ({ "ghost","hao gui"}) );
        set("gender", "男性" );
        set("long","一个神智不清的怪家伙，见你走过来，就对你呵呵直笑，随即又继续盯着眼前的争斗。\n"NOR);
        set("title",HIC"元武门弟子"NOR);
        set("age",43);
        set("class","saint");
        set("attitude", "heroism");
        set("str",40);
        set("int",50);
        set("max_kee",6000);
        set("kee",6000);
        set("per",10);
        set("max_sen",6000);
        set("sen",6000);
        set("combat_exp",5000000);
        set("daoxing",5000000);
        set("force",15000);
        set("max_force",7500);
        set("mana",15000);
        set("max_mana",7500);
        set("force_factor", 500);
        set_skill("literate",500);
        set("mana_factor",500);
        set_skill("unarmed",500);
        set_skill("yuanwu-kungfu",500);
        set_skill("parry",500);
        set_skill("dodge",500);
        set_skill("force",500);
        set_skill("power",500);
        set_skill("yuanwu-steps",500);
        set_skill("spells", 500);
        set_skill("spirit-power", 500);
              map_skill("force","power");
              map_skill("spells", "spirit-power");
              map_skill("parry","yuanwu-kungfu");
              map_skill("unarmed","yuanwu-kungfu");
              map_skill("dodge","yuanwu-steps");
        set("inquiry", ([
              //  "name" : "我是谁？你知道我是谁吗？告诉我吧。",
                "格斗门绝学" : (: ask_sys :),
                        ]) );
        set("inquiry", ([
                ]) );
        create_family("格斗家", 2, "蓝"); 
              setup();
        carry_object("/d/sfighter/obj/fightcloth")->wear();
}

void attempt_apprentice(object me) 
{ 
           if (me->query_skill("power",1)<400) {command("say 你连紫鬭气境界都没达到？真差！\n");return;}
 if (me->query_int()<40) {command("say 你的武学智慧太低啦，没前途。\n");return;}
           if (!me->query_temp("ssbx_done")){
               message_vision("豪鬼不耐烦的瞥了$N一眼，突然变得激动起来。\n",me);
               command("ah");
               command("say 你已突破蓝鬭气境界了？但以你的能力尚未能与我一搏，真希望有人能跟我痛快的打上一架。\n");
               command("comsider");
               command("say 这样吧，如果你能悟出元武门绝学中最后的秘密，我就指点你些武艺。\n");
               command("sigh");
               command("say 那秘密究竟是什么？以我的武学智慧竟然也无法参破。\n");
               command("say 据说此秘密与昇龍波動有着极大的关系，他们那两小子正好对此有很深的造诣，你去问问他们吧，看是否能有些头绪。\n");
               me->set_temp("ghost_asked",1);
               }
           command("jump"); 
           command("say 你已经悟出了那最后的秘密？！太好了，来，来，来，我指点你些武艺，这样你不久就能当我的对手了。\n"); 
           command("haha");
           command("recruit " + me->query("id") );
           me->set("title", HIB"真·豪鬼秘传弟子"NOR); 
           return;
} 

string ask_sys()
{
   object me=this_player();
   int i=random(10);
   int myint;
   myint=me->query("int");
   myint+=(int)((me->query_skill("literate",1)-10)/10);
         if ( (int)me->query("MKS") <5000){
	  command("shake");
	  command("say 不是大奸大恶之人，怎能参悟出我的最高绝学。\n");
	   
}

   if (me->query("family/family_name")!="格斗家") return "哪来的间谍，竟然想偷学此招。\n";
   if (me->is_busy()) return "等你忙完了再来领悟此招吧。\n";
   if (me->query("sys_learned")) return "你已经掌握其中的精髓了。\n";
  
   command("say 瞬狱杀是我毕生绝学,你如若学的，勤加练习，日后必有所作为。\n");
   command("say 看好了。\n");

   message_vision("豪鬼演示了一遍瞬狱杀绝学。\n\n",me);
   
   if (i<8) {message_vision("$N觉得此招精妙绝伦，却无法领悟其要职。\n\n",me);me->start_busy(3);return "只要你能悟出其中精髓，这招学来是不难的。\n";}    

   message_vision("$N脑中电光一闪，领悟到了瞬狱杀的精髓所在。\n\n",me);
   me->set("sys_learned",1);   
   return "不错不错，看来你的武学智慧不比我低。\n";

}


