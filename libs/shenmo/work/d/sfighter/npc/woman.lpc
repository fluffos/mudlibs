#include <ansi.h>
inherit NPC;
inherit F_MASTER; 
string ask_city();
int vega_app();
 
void create()
{
          set_name("老太婆", ({ "woman" }) );
        set("gender", "女性" );
        set("long","一个奇怪的老太婆，穿得破破烂烂，却用了块头巾将头包得严严实实，似乎在害怕什么？\n"NOR);
        set("age",60);
        set("attitude", "heroism");
        set("str",20);
        set("int",30);
        set("per",10);
        set("max_kee",4100);
        set("kee",4100);
        set("max_sen",3100);
        set("sen",3100);
        set("combat_exp",1000);
        set("daoxing",1000);
        set("force",100);
        set("max_force",100);
        set("mana",100);
        set("max_mana",100);
        set("force_factor", 0);
        set("mana_factor",0);
        set("inquiry", ([
                "name" : "。。。。",
                        ]) );
        set("inquiry", ([
                "梦幻都市" : (: ask_city :),
                ]) );
              setup();
        carry_object("/obj/loginload/skirt")->wear();
}

void init()
{
 add_action("do_ok","ok");
}


string ask_city()
{
   object me=this_player();
   object ob=this_object();
   
   if (me->query_skill("dodge")<300) return "以你的武功无法帮助我，我对你说了又有何用？\n";
    
   message_vision("$n打量了$N几眼,低声说道：跟我来。\n",me,ob);
   message_vision("$n将$N引到暗处，说道：若你能助我击杀赤目司令--维加，我便助你潜入梦幻都市。\n",me,ob);
   me->set_temp("woman_ask",1);
   return "怎么样？这交易你做不做？(ok)\n"; 
 }  


int do_ok()
{
   object me=this_player();
   object ob=this_object();

   if (!me->query_temp("woman_ask")) return 0;
   
   message_vision("$N想了想，说道：好吧。\n",me,ob);
   message_vision("$n嘿嘿笑了两声，说道：赤目司令现在城中的酒吧之内，我们速速前去，不然就失去这最好机会了。\n",me,ob);
   me->set_temp("go_vega",1);
   command("follow "+me->query("id"));
   remove_call_out("vega_app");
   call_out("vega_app", 1,me);
   return 1;
}


int vega_app()
{
  object woman=this_object();
  object me,vega,where;
  
  me=woman->query_leader();
  if (!me) return 0; 
  if (!me->query_temp("go_vega")) return 0;
  where=environment(woman);
  if (where->query("short")!="酒吧") {call_out("vega_app",1,me);return 0;}
  if (!vega=present("vega",environment(woman)) ) {vega=new("/d/sfighter/npc/vega");vega->move(environment(woman));}
  return 1;
}












