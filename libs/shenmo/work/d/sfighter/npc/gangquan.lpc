#include <ansi.h>
inherit NPC;
inherit F_MASTER; 
string ask_juexue();
 
void create()
{
          set_name("刚拳", ({ "gang quan","quan"}) );
        set("gender", "男性" );
        set("long","元武门现任掌门，Ryu,Ken,Boka的师傅。\n"NOR);
        set("title",HIC"元武门掌门"NOR);
        set("age",40);
        set("attitude", "heroism");
        set("str",40);
        set("int",50);
        set("max_kee",4000);
        set("kee",3000);
        set("per",20);
        set("max_sen",4000);
        set("sen",3000);
        set("combat_exp",2000000);
        set("daoxing",2000000);
        set("force",6000);
        set("max_force",3000);
        set("mana",6000);
        set("max_mana",3000);
        set("force_factor", 150);
        set("mana_factor",150);
set("class","saint");
        set_skill("unarmed",230);
        set_skill("yuanwu-kungfu",230);
        set_skill("parry",230);
        set_skill("literate",230);
        set_skill("dodge",230);
        set_skill("force",230);
        set_skill("power",230);
        set_skill("yuanwu-steps",230);
        set_skill("spells", 230);
        set_skill("spirit-power", 230);
              map_skill("force","power");
              map_skill("spells", "spirit-power");
              map_skill("parry","yuanwu-kungfu");
              map_skill("unarmed","yuanwu-kungfu");
              map_skill("dodge","yuanwu-steps");
        set("inquiry", ([
                "name" : "我是元武门现任掌门人刚拳，请多多指教。",
                        ]) );
        set("inquiry", ([
                "yuanwu-kungfu" : (: ask_juexue :),
                "元武门绝学" : (: ask_juexue :),
                ]) );
        create_family("格斗家", 2, "蓝"); 
              setup();
        carry_object("/d/sfighter/obj/fightcloth")->wear();
}

void attempt_apprentice(object ob) 
{ 
           command("nod"); 
           command("say 希望你今后能光大我们元武门。\n"); 
           command("recruit " + ob->query("id") );
           ob->set("title", HIC"元武门弟子"NOR); 
           return;
} 

string ask_juexue()
{  
    object me=this_player();
    if (me->query("family/master_id") != "gang quan"&&me->query("family/master_id") != "ryu"&&me->query("family/master_id") != "ken"&&me->query("family/master_id") != "dan") return "你非元武门弟子。\n";
    
    say("\n刚拳说道：元武门绝学为本门开派祖师所创，最初之时绝学分为波動拳与昇龍拳两式，后来，祖师发现此二式存在极大弊端，会引人入魔，\n　　　　　迷失本性，遂将此二式列为禁招，并创出第三式--旋风腿。\n");
    say("\n刚拳缓了缓又继续道：祖师临终之前悟出将波動与昇龍引入正道之法，并写成《元武门绝学总篇》，共分为上中下三册。\n");
    say("\n刚拳长叹了一口气：可惜的是，祖师身骨未寒，仇家已寻上门来，第二代掌门人命其弟子带着《总篇》匆忙出逃。该弟子在半路遇人伏击，\n　　　　　虽侥幸逃生，却不慎将总篇第一册遗失。\n");
    say("\n刚拳歇了歇，又道：经过了数十年，元武门终于重新建立起来，但因少了第一册，各代掌门皆无法寻出将波動与昇龍引入正道之法。故，元\n　　　　　武门绝学虽强，却始终无法为世人所认同，被逐为非正道一列，元武门始终无法兴盛起来。\n"); 
    say("\n刚拳双手握拳，语气中蕴藏着极大的怒气：祸不单行，五十一年前，神武天皇亲临，欲夺取总篇其余二册，当时掌门人即我师公奋力抵抗，\n　　　　　终究还是被其夺去第二册。于是，掌门人将最后一册内容刻于某处，将正本毁去。神武天皇大怒，击杀掌门及数位弟子后挟着总\n　　　　　篇第二册扬长而去。\n");
    say("\n刚拳又长叹了一口气：多年来，我四处搜寻，可惜始终无法找回一，三两册，而第二册被神武天皇所夺，我亦无法夺回。\n\n");
    me->set("yuanwu_book",1);
    return "如今，振兴元武门大大任就落在你们的身上了。\n";
}


