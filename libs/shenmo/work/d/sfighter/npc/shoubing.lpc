#include <ansi.h>
inherit NPC;


void create()
{
        set_name("守兵", ({"bing"}) );
        set("age", 20);
        set("gender", "男性");
        set("long",
"梦幻都市守兵。\n");
        set("attitude", "peaceful");

        set("combat_exp", 10000);
        set("shen_type", 1);
	set("max_force", 200);
	set("force", 200);
	set("force_factor", 5);
        set_skill("unarmed", 30);
        set_skill("dodge", 40);
        set_skill("parry", 30);
        setup();
        carry_object("/d/sfighter/obj/fightcloth")->wear();
}

