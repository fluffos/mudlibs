#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "浪儿店二楼");
  set("long", @LONG
一家小店，提供了基本的服务。店里只有一个老人家打理，
不过还是停干净的，有回到家的感觉。

LONG);
  set("exits", ([
    "down": __DIR__ "langerdian1",
  ]));
  set("no_time", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("chat_room", 1);
  set("outdoors", 0);
  set("no_bian", 1);
  set("valid_startroom", 1);
  setup();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}

int do_list() {
  string str;

  str = HIR "㊣" NOR "浪儿店店小二一温(Yveon)现货销售下列商品: \n";
  str += @LONG
春宵一刻值千金(chun)          ：一百两黄金
冰火两重天(tian)              ：一百两黄金
极品双飞燕(shuang)            ：一百两黄金
LONG;
  write(str);
  return 1;
}

int do_buy(string arg) {
  string sth, id;
  if (!arg)
    return 0;
  if (sscanf(arg, "%s from %s", sth, id) != 2)
    return 0;
  if (id != "yveon")
    return 0;
  if (!present(id))
    return 0;
  switch (sth) {
    case "chun": sth = HIG "春宵一刻值千金" NOR; break;
    case "tian": sth = HIW "冰" HIR "火" NOR "两重天"; break;
    case "shuang": sth = HIG "极品双飞燕" NOR; break;
    default: return 0;
  }
  if (this_player()->query_temp("langer_buy/" + sth)) {
    write(CYN "一温说道：注意身体。\n" NOR);
    return 1;
  }
  message_vision("$N从一温手里买了" + sth + "服务。\n", this_player());
  this_player()->set_temp("langer_buy/" + sth, 1);
  return 1;
}
