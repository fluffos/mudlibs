#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_yuji();

void create()
{
  set_name(HIC"项 羽"NOR, ({"ba wang", "xichu bawang"}));
       set("long",
            "霸王---项 羽\n");
       set("title", "西 楚 霸 王");
       set("gender", "男性");
       set("age", 160);
       set("class", "xian");
       set("attitude", "friendly");
       set("rank_info/respect", "王者");
       set("per", 40);
	set("int", 30);
       set("max_kee", 9000);
       set("max_gin", 6000);
       set("max_sen", 8000);
       set("force", 8000);
       set("max_force", 8000);
       set("force_factor", 500);
       set("max_mana", 6000);
       set("mana", 6000);
       set("mana_factor", 400);
       set("combat_exp", 4000000);
       set("daoxing", 8000000);


        set("eff_dx", 200000);
        set("nkgain", 350);

       set_skill("dodge", 480);
       set_skill("blade", 480);
       set_skill("zileidao", 480);
       set_skill("force", 480);
       set_skill("parry", 480);
       set_skill("tianmogong", 480);
       set_skill("spells", 480);
        set_skill("huntianforce", 480);
        set_skill("literate", 480);
        set_skill("zhaoyangbu", 480);
        map_skill("spells", "tianmogong");
        map_skill("force", "huntianforce");
        map_skill("parry", "zileidao");
        map_skill("dodge", "zhaoyangbu");

        create_family("三界山", 2, "霸王");

        set("inquiry", ([
                ]) );

        set("inquiry", ([
                
                "项羽" : (: ask_yuji :),
                "虞姬" : (: ask_yuji :),
                "刘邦" : (: ask_yuji :),
                ]) );

        setup();

        carry_object("/d/obj/armor/jinjia")->wear();
        carry_object("/d/obj/weapon/blade/blade")->wield();
}

string ask_yuji()
{
  object me=this_player();
  object ob=this_object();
  if (me->query("dntg/laojunlu")!="done" && me->query("zhuanshi")==0) return "这辈子，羽负虞甚多！"; 
    command("sigh");
  message_vision("$N长叹了一声，霸王此生从未有求于人，你既有意救回虞姬，王不胜感激！\n",ob);
  message_vision("$N长啸一声，刹那之间风云变色，日月无光，倾盆大雨浇头而下！\n",ob,me);
  tell_object(me,"就在电闪雷鸣的一瞬间，项羽脸色一竣，一道电光击下，乌骓泥像突然有了动静！让它送你一程吧！霸王内劲一扯，一匹浑身乌黑的骏马，穿越了亘远的时空，破蹄踏浪，从雕像中长嘶而出，你一翻身上了马背。\n");
   me->move("/d/bwbj/road1");
  return "天佑虞姬！\n";
}
