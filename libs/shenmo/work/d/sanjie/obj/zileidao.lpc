// zileidao.c

#include <ansi.h>
#include <weapon.h>

inherit F_UNIQUE; 
inherit BLADE;

void create()
{
	set_name( MAG "紫雷刀" NOR, ({ "zilei dao", "dao", "blade" }) );
	set_weight(40000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
        set("value", 1000000000000);
      set("no_sell","小店小本经营，买不起这么贵重的宝物。\n");
    set("no_give","紫雷刀对对方而言太重了。\n");
		set("material", "gold");
                set("no_drop", "怎么，连西楚霸王的兵器都舍的扔？");
		set("replace_file", "/d/obj/weapon/blade/blade");
		set("long", "此刀以紫金铸成，看起来似乎十分沉重，乃西楚霸王的随身兵器。\n");
		set("wield_msg", "$N从腰间抽出一把$n，四周好象刮起了凄凄阴风。\n");
		set("unwield_msg", "$N将$n插回腰间，天地万物一切都变回了原来的模样。\n");
	}
        init_blade(100);
	setup();
}
