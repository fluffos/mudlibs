#include <ansi.h>
#include "migong.h"
inherit ROOM;

void create() {
  set("short", HIR "火山深处" NOR);
  set("long", YEL + @LONG

……你似乎什么也看不清楚，只觉得山洞里热气逼人，但难以
探到前方的出路……

LONG + NOR);

  set("exits", ([
    "up": __DIR__ "end",
  ]));

  set("objects", ([
    "/d/sds2/npc/phix": 1,
  ]));

  set("alternative_die", 1);
  setup();
  message("channel:chat", HIC "【众生界】一辉(Yi hui)：我倒要看看所谓的圣斗士都有些什么伎俩。\n" NOR, users());
}

void init() {
  add_action("do_none", "cast");
}

int valid_leave(object me, string dir) {
  if ((present("yi hui") || me->query("sds2/phix") != "done") && dir == "up") {
    tell_object(me, HIR "战斗吧！\n" NOR);
    return 0;
  }
  return 1;
}
