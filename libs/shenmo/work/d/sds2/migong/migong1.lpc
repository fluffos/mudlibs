inherit ROOM;
#include <ansi.h>

void create()
{
set("short","幻像迷宫");
set("long", @LONG

自从人类首次发现沉没的“穆大陆”一角--“死亡凤凰岛”时，就修建
了这些古密道，以保护岛上发现的不明圣衣不被泄露出岛外。
这里雾气弥漫，四周只见到破碎的圣衣残片以及为寻宝而迷失在
迷宫中的格斗家们的尸骸。

LONG
	);
set("exits", ([ 
	"east" : __DIR__"migong2",
]));
setup();
}

void init()
{
add_action("do_cast","cast");
}

int do_cast(string arg)
{
if ( arg=="chuqiao" )
  {
  message_vision(YEL"一股灵气从$N"YEL"脑门上钻出，随风飘去，转眼就不见了。\n"NOR,this_player());
  switch ( random(5) )
     {
     case 1 : { this_player()->move("/d/city/kezhan");break; }
     case 2 : { this_player()->move("/d/city/center");break; }
     case 3 : { this_player()->move(__DIR__"migong1");break; }
     case 4 : { this_player()->move("/d/city/kezhan");break; }
     case 5 : { this_player()->move("/d/city/center");break; }
     }
  return 1;
  }
return 0;
}
