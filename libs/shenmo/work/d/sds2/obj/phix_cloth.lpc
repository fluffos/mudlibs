//暗黑凤凰圣斗衣,dphix_cloth

#include <armor.h>
#include <ansi.h>
#include "chk_player.h"

inherit ARMOR;

void create()
{
set_name(HIB"凤凰座"+HIC"青铜圣衣"NOR,({"pheonix's shengyi","armor","jia"}));
set_weight(700);
if( clonep() )
	set_default_object(__FILE__);
else {
	set("unit", "件");
	set("long", HIY"凤凰座"NOR"一辉的圣斗衣。”\n");
	set("material", "steel");
	set("armor_prop/armor", 180);
	set( "no_get",1);
	set( "no_steal",1);
	set ("no_drop",1);
      }
setup();
}
