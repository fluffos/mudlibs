#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIB "面具" NOR, ({ "mian ju" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("material", "paper");
    set("long", HIB "一个弥漫着一股邪恶气息的面具。\n" NOR);
  }
  set("no_steal", 1);
  set("no_get", 1);
  setup();
}

void init() {
  add_action("do_get", "get");
}

int do_get(string arg) {
  object me = this_player();
  if (!arg || me->query("sds2/phix") != "done"    //凤凰没过
  || me->query("sds2/dxn") != "done"    //暗黑仙女没过
  || me->query("sds2/dte") != "done"     //暗黑白鸟没过
  || me->query("sds2/dtl") != "done"      //暗黑天龙没过
  || me->query("sds2/dtm") != "done")  //暗黑天马没过
    return 0;

  else if (arg == "mian ju") {
    message_vision(HIY "一股浓烟把$N卷了进去。\n" NOR, me);
    this_object()->move(me);
    me->move("/d/sds2/end");
    message_vision(HIY "$N从一股浓烟中走了出来。\n" NOR, me);
  } else return 0;

}
