//暗黑凤凰圣斗衣,dphix_cloth

#include <armor.h>
#include <ansi.h>
#include "chk_player.h"

inherit ARMOR;

void create()
{
set_name(HIB"暗黑天龙"+HIC"圣斗衣"NOR,({"black dragon's shengyi","armor","jia"}));
set_weight(700);
if( clonep() )
	set_default_object(__FILE__);
else {
	set("unit", "件");
	set("long", HIB"暗黑凤凰"+NOR"的圣斗衣。”\n");
	set("material", "steel");
	set("armor_prop/armor", 150);
	set( "no_get",1);
	set("no_drop",1);
      }
setup();
}
