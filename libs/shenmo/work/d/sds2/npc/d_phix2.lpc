//黑暗凤凰BLACK PHEONIX 暗黑凤凰军团中的杂兵，为数众多 。  
//d_phix.c 
                                 
#include <ansi.h>    
inherit NPC;    

void move_next(object ob);
void powerup();
void die();

void create()    
{    
 set_name("暗黑凤凰·首领", ({"black pheonix","anhei fenghuang"}));    
set("long", HIB"暗黑凤凰军团"NOR+"中的杂兵，为数众多 。\n");    
set("gender","男性");    
set("title", HIB"黑暗"+HIC"圣斗士"NOR);    
set("age",20);    
set("con",35);    
set("per",35);    
set("str",35);    
set("int",35);    
set("combat_exp",1500000);    
set("daoxing",3500000);    
              
set_skill("force", 300);    
set_skill("parry", 300);    
set_skill("unarmed", 300);    
set_skill("staff", 300);    
set_skill("dark-quan",300);    
set_skill("stars-steps",300);    
set_skill("buddhism",300);    
set_skill("spells",300);    
set_skill("lunhui-zhang", 300);    
map_skill("parry","lunhui-zhang");    
map_skill("unarmed","dark-quan");    
map_skill("spells","buddhism");    
map_skill("dodge","stars-steps");    
set("max_force", 4000);    
set("force", 8000);    
set("max_mana",4000);    
set("mana",8000);    
set("mana_factor",150);    
set("force_factor", 150);    
set("max_kee", 5000);    
set("max_gin", 5000);    
set("max_sen", 5000);    
setup();    
carry_object("/d/sds2/obj/dphix_cloth")->wear();    
}    
                     
void init()   
{   
add_action("do_none","move");   
add_action("do_none","ji");   
add_action("do_none","burn");   
add_action("do_none","recall");   
}   

int do_none()   
{   
message_vision(HIW"$N对$n嘿嘿一笑:不要玷污了圣斗士的名声......\n"NOR,this_object (),this_player() );                                   
return 1;   
}   

void kill_ob(object me)
{
object ob=this_object();
if(! present(me,environment()) )
	{
	ob->delete_temp("my_killer");
	return;
	}
     
if( me->is_ghost() || !userp(me) )
	{
	ob->delete_temp("my_killer");
	return;
	}
powerup();     
set("chat_chance_combat", 80);
set("chat_msg_combat", ({
	(: perform_action, "unarmed", "luan" :),
	(:powerup:),
}) );
}

   
void powerup()
{
        object me = this_object();
        object who = me->query_temp("my_killer");
       if (random(1)==1)
        message("chat",HIC+"【"HIB"死亡岛"HIC"】基鲁提(Guility):暗黑凤凰军团出动吧!\n"NOR,users());
	else random(2)?
       me->command_function("say 燃烧吧，生命之小宇宙！\n"):
       me->command_function("say 死亡火山！爆发吧！\n");
        me->set("kee",query("max_kee"));
        me->set("eff_kee",query("max_kee"));
        me->set("sen",query("max_sen"));
        me->set("eff_sen",query("max_sen"));
        me->set("force",query("max_force"));
        me->set("mana",query("max_mana"));
        me->clean_condition();
        return;
}

void die()
{
object me = query_temp("last_damage_from");
object ob = this_object();
powerup();
if( !me )  return;
  if( me)
me->remove_killer(ob);
if( ob )
ob->remove_killer(me);
if( me->query("sds2/island")!="done" ) 
	{
	message("chat",HIC+"【"+HIR"死亡岛"NOR+HIC"】沙织(Sha zhi):"NOR+HIW+me->name()+HIC"杀死了暗黑凤凰的首领，离黄金圣衣更近了！\n"NOR,users());
       me->set("sds2/island","done");  //此关完成
 	me->add("daoxing",50000);
	me->set("sds2/gift1","done");  //已经得到奖励
	tell_object(me,HIY"\n你得到了五十年道行！\n"NOR);
// fang@2011	destruct(this_object());
	}
message_vision(HIR"$N惨叫一声，化做黑烟散去......\n"NOR,this_object() );
destruct(this_object());
}

void unconcious()
{
if(  query("kee")<0 )
	die();
else
::unconcious();
}
