//黑暗凤凰BLACK PHEONIX 暗黑凤凰军团中的杂兵，为数众多 。  
//d_phix.c 

#include <ansi.h>
inherit NPC;

void move_next(object ob);
void powerup();
void die();

void create() {
  set_name("暗黑凤凰", ({ "black pheonix", "anhei fenghuang" }));
  set("long", HIB "暗黑凤凰军团" NOR + "中的杂兵，为数众多 。\n");
  set("gender", "男性");
  set("title", HIB "黑暗" + HIC "圣斗士" NOR);
  set("age", 20);
  set("con", 35);
  set("per", 35);
  set("str", 35);
  set("int", 35);
  set("combat_exp", 1500000);
  set("daoxing", 3500000);

  set_skill("force", 300);
  set_skill("parry", 300);
  set_skill("unarmed", 300);
  set_skill("staff", 300);
  set_skill("dark-quan", 300);
  set_skill("stars-steps", 300);
  set_skill("buddhism", 300);
  set_skill("spells", 300);
  set_skill("lunhui-zhang", 300);
  map_skill("parry", "lunhui-zhang");
  map_skill("unarmed", "dark-quan");
  map_skill("spells", "buddhism");
  map_skill("dodge", "stars-steps");
  set("max_force", 4000);
  set("force", 8000);
  set("max_mana", 4000);
  set("mana", 8000);
  set("mana_factor", 150);
  set("force_factor", 150);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  setup();
  carry_object("/d/sds2/obj/dphix_cloth")->wear();
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "luan" :),
    (: powerup :),
    (: powerup :),
    (: powerup :),
  }));
}

void init() {
  ::init();
  add_action("do_none", "move");
  add_action("do_none", "ji");
  add_action("do_none", "burn");
  add_action("do_none", "recall");
  kill_ob(this_player());
}

int do_none() {
  message_vision(HIW "$N对$n嘿嘿一笑:不要玷污了圣斗士的名声......\n" NOR, this_object(), this_player());
  return 1;
}

void unconcious() {
  if (query("kee") < 0 || query("sen") < 0)
    die();
  else ::unconcious();
}

void powerup() {
  object me = this_object();
  object who = me->query_temp("my_killer");
  if (random(1) == 1)
    message("chat", HIC + "【" HIB "死亡岛" HIC "】基鲁提(Guility):暗黑凤凰军团出动吧!\n" NOR, users());
  else random(2) ? me->command_function("say 燃烧吧，生命之小宇宙！\n") : me->command_function("say 死亡火山！爆发吧！\n");
  me->set("kee", query("max_kee"));
  me->set("eff_kee", query("max_kee"));
  me->set("sen", query("max_sen"));
  me->set("eff_sen", query("max_sen"));
  me->set("force", query("max_force"));
  me->set("mana", query("max_mana"));
  me->clean_condition();
  return;
}

void die() {
  object ob = this_object();
  object me = query_temp("last_damage_from");
  powerup();
  if (!me) return;
  me->remove_killer(ob);
  ob->remove_killer(me);
  if (me->query("sds/number") >= 4) {
    message(
      "chat",
      HIC + "【" NOR + HIB "死亡岛" NOR + HIC "】沙织(Sha zhi):" + HIW + me->name() + HIC "杀死一名暗黑凤凰，继续向黄金圣衣接近！\n" NOR,
      users()
    );
    me->add("sds2/number", 1);  //增加杀的数量
    tell_object(me, "继续战斗吧，女神等你的好消息呢。");
  }
  message_vision(HIR "$N惨叫一声，化做黑烟散去......\n" NOR, this_object());
  destruct(this_object());
}
