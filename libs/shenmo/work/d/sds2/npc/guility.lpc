//基鲁提 GUILITY一 辉 的 师 父 、 艾 斯 美 达 的 父 亲 。 他 连 自 己 的 女 儿 也 杀 害 ， 非 常 冷 血 。 
                                 
#include <ansi.h>    
inherit NPC;    

string my_girl(object me);
string my_face(object me);
void powerup();
                                
void create()    
{    
set_name("基鲁提"HIB"（鬼魂）"NOR, ({"guility","ti"}));    
set("long", "一辉的师父、艾斯美达的父亲。他连自己的女儿也杀害，非常冷血 。 。\n");    
set("gender","男性");    
set("title", HIB"死亡岛"+HIR"岛主"NOR);    
set("age",52);    
set("con",35);    
set("per",40);    
set("str",40);    
set("int",35);    
set("combat_exp",9000000);    
set("daoxing",20000000);    
              
set_skill("force", 330);    
set_skill("parry", 330);    
set_skill("unarmed", 330);    
set_skill("staff", 330);    
set_skill("dark-quan",330);    
set_skill("stars-steps",330);    
set_skill("buddhism",330);    
set_skill("spells",330);    
set_skill("lunhui-zhang", 330);    
map_skill("parry","lunhui-zhang");    
map_skill("unarmed","dark-quan");    
map_skill("spells","buddhism");    
map_skill("dodge","stars-steps");    
set("max_force", 5000);    
set("force", 10000);    
set("max_mana",5000);    
set("mana",10000);    
set("mana_factor",200);    
set("force_factor", 200);    
set("max_kee", 10000);    
set("max_gin", 10000);    
set("max_sen", 10000);    
set("kee", 10000);    
set("sen", 10000);    
setup();    

}    
                     
void init()   
{   
add_action("do_none","cast");   
add_action("do_none","move");   
add_action("do_none","ji");   
add_action("do_none","burn");   
::init();   
set("chat_chance", 10);
set("inquiry", ([
	"name" : "艾 斯 美 达 .艾 斯 美 达 ..艾 斯 美 达 ...\n",
	"here" : "艾 斯 美 达 .艾 斯 美 达 ..艾 斯 美 达 ...\n", 
	"女儿" : (: my_girl :),
	"艾斯美达" : (: my_girl :),
	"面具" : (: my_face :),
]) );
}   

int do_none()   
{   
message_vision(HIW"$N对$n摇摇头......\n"NOR,this_object (),this_player() );                                   
return 1;   
}   

string my_girl(object me)
{
object who = this_object();
me = this_player();
if ( me->query("sds2/phix")!="done"   	//凤凰没过
||   me->query("sds2/dxn")!="done"   	//暗黑仙女没过
||   me->query("sds2/dte")!="done"    	//暗黑白鸟没过
||   me->query("sds2/dtl")!="done"     	//暗黑天龙没过
||   me->query("sds2/dtm")!="done"  )	//暗黑天马没过
	{
	message("chat",HIC+"【"+HIR"死亡岛"NOR+HIC"】基鲁提(Guility):"NOR+HIW+me->name()+HIC"不知用什么办法，居然混进了死亡岛！死吧！\n"NOR,users());
	me->die();
	}
return "当初我被亡灵面具迷惑了本性，相信力量便是正义，结果害死了我的女儿！";
}

string my_face(object me)
{
object who = this_object();
me = this_player();
if ( me->query("sds2/phix")!="done"   	//凤凰没过
||   me->query("sds2/dxn")!="done"   	//暗黑仙女没过
||   me->query("sds2/dte")!="done"    	//暗黑白鸟没过
||   me->query("sds2/dtl")!="done"     	//暗黑天龙没过
||   me->query("sds2/dtm")!="done"  )	//暗黑天马没过
	{
	message("chat",HIC+"【"+HIR"死亡岛"NOR+HIC"】基鲁提(Guility):"NOR+HIW+me->name()+HIC"不知用什么办法，居然混进了死亡岛！死吧！\n"NOR,users());
	me->die();
	}

else if ( me->query_temp("face_ask") )   //已经问过
	{
	if ( present("mian ju",me) )
		return "那把面具给我吧！";
	else return "快去找那该死的面具吧!";
	}
else      {
        me->set_temp("face_ask",1);
        me->set("sds2/cloth","done");
	me->move("d/sds2/migong/migong1");
	message_vision("$N被基鲁提送到了面具的起源地“穆の迷宫”。\n",me);
        return "去找那该死的面具吧!" ;
	}
}
	
int accept_object(object me, object ob) 
{
object hand,leg,arm,body,*inv;    //黄金圣衣其余四部
object who = this_object();
inv=all_inventory(me);

message_vision("$N由衷的向$n道谢，并遵循承诺将"+HIC"人马座"NOR+HIY"黄金圣衣"NOR+"其余四部还给$n。\n",who,me);
hand=new("/d/sds/obj/rm_cloth2");    //人马座圣衣手部
leg=new("/d/sds/obj/rm_cloth3");    //人马座圣衣腿部
body=new("/d/sds/obj/rm_cloth4");    //人马座圣衣身部
arm=new("/d/sds/obj/rm_cloth5");    //人马座圣衣臂部
hand->move(me);
leg->move(me);
body->move(me);
arm->move(me);
me->set("sds2/cloth","done");    //限制其不能再问shazhi要kui
message("chat",HIC+"【"+HIR"死亡岛"NOR+HIC"】沙织(Sha zhi):"NOR+HIW+me->name()+HIC"成功夺回了"NOR+HIM"人马座"NOR+HIY"黄金圣衣"NOR+HIC"！\n"NOR,users());
return 1;
}
   
