//一辉 
                                 
#include <ansi.h>    
inherit NPC;    

void powerup();
                                
void create()    
{    
set_name("一辉", ({"yi hui","pheonix"}));    
set("long", "阿瞬的哥哥因为深爱的人逝去而失去了“爱”。\n");    
set("gender","男性");    
set("title", HIY"凤凰座"+HIC"圣斗士"NOR);    
set("age",22);    
set("con",35);    
set("per",40);    
set("str",40);    
set("int",35);    
set("combat_exp",9000000);    
set("daoxing",20000000);    
              
set_skill("force", 330);    
set_skill("parry", 330);    
set_skill("unarmed", 330);    
set_skill("staff", 330);    
set_skill("shengdou",330);    
set_skill("stars-steps",330);    
set_skill("buddhism",330);    
set_skill("spells",330);    
set_skill("lunhui-zhang", 330);    
map_skill("parry","lunhui-zhang");    
map_skill("unarmed","shengdou");    
map_skill("spells","buddhism");    
map_skill("dodge","stars-steps");    
set("max_force", 5000);    
set("force", 10000);    
set("max_mana",5000);    
set("mana",10000);    
set("mana_factor",200);    
set("force_factor", 200);    
set("max_kee", 10000);    
set("max_gin", 10000);    
set("max_sen", 10000);    
set("kee", 10000);    
set("sen", 10000);    
setup();    
carry_object("/d/sds2/obj/phix_cloth")->wear();    
set("chat_chance_combat", 60);
set("chat_msg_combat", ({
//          (:powerup:),
	(: perform_action, "unarmed", "huan" :),
}) );

}    
                     
void init()   
{   
add_action("do_none","cast");   
add_action("do_none","move");   
add_action("do_none","ji");   
add_action("do_none","burn");   
kill_ob(this_player());   
::init();   
}   

int do_none()   
{   
message_vision(HIW"$N对$n摇摇头......\n"NOR,this_object (),this_player() );                                   
return 1;   
}   


void unconcious()
{
if (query("kee")<0 || query("sen")<0) 
die();
else ::unconcious();
}
   
void powerup()
{
        object me = this_object();
        object who = me->query_temp("my_killer");
       if (random(1)==1)
		message("chat",HIC+"【"HIB"死亡岛"HIC"】基鲁提(Guility):我的爱徒--凤凰一辉出动吧!\n"NOR,users());
	else 
		{
		random(2)?
	       me->command_function("say 燃烧吧，小宇宙！\n"):
	       me->command_function("say 小宇宙！爆发吧！\n");
		}
        me->set("kee",query("max_kee"));
        me->set("eff_kee",query("max_kee"));
        me->set("sen",query("max_sen"));
        me->set("eff_sen",query("max_sen"));
        me->set("force",query("max_force"));
        me->set("mana",query("max_mana"));
        me->clean_condition();
        return;
}

void die()
{
object me = query_temp("last_damage_from");
object ob = this_object();
powerup();
if( !me )  return;
me->remove_killer(ob);
ob->remove_killer(me);
if( me->query("sds2/phix")!="done" ) 
	{
        message("chat",HIC+"【"+HIR"死亡岛"NOR+HIC"】沙织(Sha zhi):"NOR+HIW+me->name()+HIC"打败了凤凰座一辉，离黄金圣衣更近了！\n"NOR,users());
        me->set("sds2/phix","done");  //此关完成
	 me->add("daoxing",350000);
	 me->set("sds2/gift6","done");  //已经得到奖励
	 tell_object(me,HIY"\n你得到了三百五十年道行！\n"NOR);
          message_vision(HIC"一辉对你点了点头，“$N，你果然有足够的实力......我心服口服......\n这一切都是老师面上那可恶的面具的搞的鬼。如果你能使老师的冤灵得到解脱，我立刻\n会还你圣衣！”\n",me); 
	}
message_vision(HIR"$N惨叫一声，化做黑烟散去......\n"NOR,this_object() );
destruct(this_object());
}


