//黑暗白鸟 BLACK SWAN 暗 黑 四 天 王 之 一 。
//d_tiane.c 
                                 
#include <ansi.h>    
inherit NPC;    

void powerup();
                                
void create()    
{    
 set_name("黑暗白鸟", ({"black swan","bainiao"}));    
set("long", HIB"暗黑凤凰军团"NOR+"中四天王之一 。\n");    
set("gender","男性");    
set("title", HIB"黑暗"+HIC"圣斗士"NOR);    
set("age",18);    
set("con",35);    
set("per",35);    
set("str",40);    
set("int",35);    
set("combat_exp",8000000);    
set("daoxing",10000000);    
              
set_skill("force", 330);    
set_skill("parry", 330);    
set_skill("unarmed", 330);    
set_skill("staff", 330);    
set_skill("dark-quan",330);    
set_skill("stars-steps",330);    
set_skill("buddhism",330);    
set_skill("spells",330);    
set_skill("lunhui-zhang", 330);    
map_skill("parry","lunhui-zhang");    
map_skill("unarmed","dark-quan");    
map_skill("spells","buddhism");    
map_skill("dodge","stars-steps");    
set("max_force", 5000);    
set("force", 10000);    
set("max_mana",5000);    
set("mana",10000);    
set("mana_factor",200);    
set("force_factor", 200);    
set("max_kee", 8000);    
set("max_gin", 8000);    
set("max_sen", 8000);    
set("kee", 8000);    
set("sen", 8000);    
setup();    
carry_object("/d/sds2/obj/dte_cloth")->wear();    
set("chat_chance_combat", 60);
set("chat_msg_combat", ({
	  (:powerup:),
	(: perform_action, "unarmed", "ice" :),
}) );

}    
                     
void init()   
{   
add_action("do_none","cast");   
add_action("do_none","move");   
add_action("do_none","ji");   
add_action("do_none","burn");   
kill_ob(this_player());   
::init();   
}   

int do_none()   
{   
message_vision(HIW"$N对$n嘿嘿一笑:打死你为止......\n"NOR,this_object (),this_player() );                                   
return 1;   
}   


void unconcious()
{
if (query("kee")<0 || query("sen")<0) 
die();
else ::unconcious();
}
   
void powerup()
{
        object me = this_object();
        object who = me->query_temp("my_killer");
       if (random(1)==1)
	       message("chat",HIC+"【"HIB"死亡岛"HIC"】基鲁提(Guility):暗黑白鸟出动吧!\n"NOR,users());
	else 
		{
	random(2)?
       me->command_function("say 燃烧吧，生命之小宇宙！\n"):
       me->command_function("say 死亡火山！爆发吧！\n");
		}
       me->set("kee",query("max_kee"));
        me->set("eff_kee",query("max_kee"));
        me->set("sen",query("max_sen"));
        me->set("eff_sen",query("max_sen"));
        me->set("force",query("max_force"));
        me->set("mana",query("max_mana"));
        me->clean_condition();
        return;
}

void die()
{
object me = query_temp("last_damage_from");
object ob = this_object();
powerup();
if( !me )  return;
me->remove_killer(ob);
ob->remove_killer(me);
if( me && me->query("sds2/dte")!="done" ) 
	{
        message("chat",HIC+"【"+HIR"死亡岛"NOR+HIC"】沙织(Sha zhi):"NOR+HIW+me->name()+HIC"杀死了暗黑白鸟，离黄金圣衣更近了！\n"NOR,users());
        me->set("sds2/dte","done");  //此关完成
	 me->add("daoxing",200000);
	 me->set("sds2/gift4","done");  //已经得到奖励
	 tell_object(me,HIY"\n你得到了二百年道行！\n"NOR);
	}
message_vision(HIR"$N惨叫一声，化做黑烟散去......\n"NOR,this_object() );
destruct(this_object());
}

