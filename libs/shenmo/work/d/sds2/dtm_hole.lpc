#include <ansi.h>
inherit ROOM;

void fullup(object obj);

int update(object obj);

void create() {
  set("short", HIR "山洞" NOR);
  set("long", BLU + @LONG

死亡皇后岛上无数山洞中的一个，洞洞相连，也不
知道真正的缺口在哪儿？
洞里堆满了死人的骸骨，狂风吹过洞口，发出凄惨
的吼声，仿佛无数亡灵的怨号。

LONG + NOR);
  set("water", 1);
  set("alternative_die", 1);
  set("objects", ([
    "/d/sds2/npc/d_tianma": 1,
  ]));
  setup();
}

void alternative_die(object me) {
  if (!userp(me) && (me->query("id") == "black pegasus" || me->query("id") == "tianma")) {

    object ob = (me->query_temp("my_killer"));
    fullup(ob);

    if (ob->query("sds2/dtianma") != "done") {
      message(
        "chat",
        HIB + "【死亡岛】基鲁提(Guility):" + HIW + ob->name() + HIB "打死了四大天王·黑暗天马，气死我也!\n" NOR,
        users()
      );
      ob->set("sds2/dtianma", "done");
      ob->add("sds2/number", 1);
      ob->add("daoxing", 20000);
      tell_object(ob, BLINK + HIY "你赢得了二十年道行！\n" NOR);
    }
    message_vision(HIC "\n$N终于将$n打败，夺得了这场比赛的胜利！\n" NOR, ob, me);
    destruct(me);

    ob->move("/d/sds2/d_island1");

    return;
  }

  fullup(me);
  me->set_temp("sds2/fail", 1);
  me->move("/d/sds2/d_island1");
  message(
    "chat",
    HIB + "【死亡皇后岛】" + HIC "沙织(Sha zhi):" + HIW + me->name() + HIC "败在了黑暗天马手下!\n" NOR,
    users()
  );
  message_vision("$N输掉了。\n", this_player());
  update(this_object());

}
void unconcious(object who) {
  if (who->query("kee") < 0 || who->query("sen") < 0) alternative_die(who);
  else unconcious(who);
}

void die(object who) {
  alternative_die(who);
}

void fullup(object obj) {
  if (!obj) return;
  obj->set("kee", (int)obj->query("max_kee"));
  obj->set("eff_kee", (int)obj->query("max_kee"));
  obj->set("sen", (int)obj->query("max_sen"));
  obj->set("eff_sen", (int)obj->query("max_sen"));
  obj->set("force", (int)obj->query("max_force") * 2);
  obj->set("mana", (int)obj->query("max_mana") * 2);
}


int update(object obj) {
  int i;
  object *inv;


  inv = all_inventory(obj);
  i = sizeof(inv);
  while (i--)
    if (userp(inv[i])) inv[i]->move(VOID_OB, 1);
  else inv[i] = 0;
  destruct(obj);


  return 1;
}
