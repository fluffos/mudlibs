// Room: /d/sds2/d_island2.c 

#include <ansi.h>
inherit ROOM;

void dark(object who, object where);

void create() {
  set("short", RED "死亡岛" NOR + HIG "海边" NOR);
  set("long", CYN + @LONG 

这里是死亡凤凰岛。远处的火山不住的冒着浓烟。在这个远离 
人世的岛上，感觉天地都是红色的。四周弥漫着死亡的气息。 
山上寸草不生，连岩石也已是干瘪龟裂，不住的冒着红色的雾 
气。 

LONG + NOR);

  set("exits", ([
    "east": __DIR__ "d_island2",  //2-12
  ]));

  set("water", 1);
  set("no_magic", 1);
  setup();
}

void init() {
  add_action("do_none", "move");
  add_action("do_none", "mark");
  add_action("do_swim", "swim");
}

int do_none() {
  object me = this_player();
  tell_object(me, "别忘了，这里可能死亡岛也。\n");
  return 1;
}

int valid_leave(object who, string dir) {

  if (present("yueguang baohe", who) || (dir == "east" && who->query("sds/number") < 4))
    return notify_fail("先去参加银河战吧！！");
  return ::valid_leave(who, dir);
}

int do_swim() {
  int i;
  object *inv;
  object me = this_player();
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i]))
      return notify_fail("还是先把身上的玩家放下来再去吧！\n");
    if (inv[i]->query("id") == "yueguang baohe")
      return notify_fail("还是先把身上的宝盒放下来再去吧！\n");
  }

  if (query("no_swim") == 0) {
    message_vision(HIY "$N纵身一跃，跳入海中。只见$N使足了全身力气，手足并用，不一会儿就游到了海中小岛上。\n" NOR, me);
    if (me->query_temp("ridee"))
      me->query_temp("ridee")->set_temp("rider", 0);
    me->set_temp("ridee", 0);
    me->add_temp("apply/dodge", -me->query_temp("ride/dodge"));
    me->set_temp("ride/dodge", 0);
    me->move("/d/changan/westseastore");
    message_vision(HIY "只见$N浑身湿漉漉地从海里爬了上来。\n" NOR, me);
    me->receive_damage("kee", 100);
    me->receive_damage("sen", 100);
    set("no_swim", 1);
    call_out("reset", 240);
    return 1;
  } else return notify_fail(HIW "刚 刚 有 人 去 了 ，你 还 是 等 等 吧 。。。\n" NOR);

}

int reset() {
  set("no_swim", 0);
  return 1;
}
