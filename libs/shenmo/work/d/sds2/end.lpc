//end.c

#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", HIR"死亡岛"NOR+BLU"神祠"NOR);
  set ("long", @LONG

……你似乎什么也看不清楚，只觉得山洞里热气逼人，但难以
死亡岛历代岛主的灵位拜祭之处，自从人类发现不知名小岛以
及岛上众多未知圣衣后，就修建了此神祠。
现在神祠的正前方摆放着的是前任岛主 基鲁提 的牌位(pai)。

LONG+NOR);

set("exits", ([
	"out" : "/d/changan/westseastore",
        "down" : "/d/sds2/migong0",
]));
set("item_desc", ([ /* sizeof() == 1 */
  "pai" : "基鲁提的牌位，上面凝集着冥冥的冤灵之气，不凡召唤(zhaohuan)\n下基鲁提的亡灵(ling)看看。\n",
]));
set("no_magic",1);
setup();
}

void init ()
{
add_action("do_zhao",({"zhaohuan","huanling"}));
}

int do_zhao (string arg)
{
int i;
object ghost;
object who = this_player();
object where =  this_object();
i=(int)who->query_kar();

if (! arg || arg!="ling" )
	return notify_fail("你想召唤谁的亡灵？\n");

if  ( where->query_temp("ghost") )
	return notify_fail("你想召唤几个亡灵？\n");

if((int)who->query("kee") <60)
	return notify_fail("你太累了，歇歇吧！\n");

message_vision(CYN"\n$N对着牌位喃喃自语。。。\n房间里渐渐弥漫起一股满含着死亡气息雾气。\n"NOR,who);
who->receive_damage("kee", 150);
where->set("coe",(int)where->query("coe") + i );
		
if( i < 20 )
	{
	tell_room(where, CYN"\n一阵风吹过，雾气淡了开来。\n"NOR); 
	}
else    tell_room(where, CYN"\n雾气渐渐聚合起来。\n"NOR);
	
if( (int)where->query("coe") >= 1000 ) 
	{
        tell_room(where, CYN"\n死亡之雾越来越浓，逐渐凝成了一个朦胧的人行，正是前任岛主基鲁提！\n\n"NOR);
	where->set_temp("ghost", 1);
	ghost=new("d/sds2/npc/guility");
	ghost->move(where);
	}
return 1;
}



