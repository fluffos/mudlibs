int valid_leave(object who, string dir) {
  if (who->query("sds2/island") != "done"  //没杀死黑暗凤凰之首的
  || who->query("sds2/dtm") != "done")    // 没杀死暗黑天马
    return notify_fail("战斗吧，女神在等你的好消息呢！\n");  //没杀死黑暗凤凰之首
    return ::valid_leave(who, dir);
}
