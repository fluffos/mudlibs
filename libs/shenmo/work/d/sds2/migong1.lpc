#include <ansi.h>
#include "migong.h"

inherit ROOM;

void create() {
  set("short", HIR "火山深处" NOR);
  set("long", YEL + @LONG

……你似乎什么也看不清楚，只觉得山洞里热气逼人，但难以
探到前方的出路……

LONG + NOR);

  set("exits", ([]));
  set("alternative_die", 1);
  setup();
}

void init() {
  add_action("do_go", "go");
  add_action("do_none", "cast");
  add_action("do_none", "perform");
  add_action("do_none", "bian");
  add_action("do_none", "drop");
  add_action("do_none", "get");
}

int do_go(string dir) {
  object who = this_player();

  if (!dir)
    return 0;

  if (dir == "east" ||
    dir == "west" ||
    dir == "south" ||
    dir == "north") {
    if (random(5) < 3) {
      message_vision(HBRED + RED "$N在黑暗中梆地撞到了石壁上。\n" NOR, who);
      who->add("sen", -100);
      who->add("kee", -100);
      who->start_busy(random(1));
    } else {
      message_vision(HBRED + HIW "$N在黑暗中找到一出口，挤了出去。\n" NOR, who);
      who->move(__DIR__ "migong" + sprintf("%d", random(5)));  //0-4
    }
    return 1;
  }
  return 0;
}
