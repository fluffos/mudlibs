// Room: /d/sds2/migu2.c 
        
#include <ansi.h> 
inherit ROOM; 

void dark(object who,object where);
        
void create () 
{ 
set ("short", "死亡岛迷谷出口"); 
set ("long", RED+@LONG 

这里是死亡凤凰岛。远处的火山不住的冒着浓烟。在这个远离 
人世的岛上，感觉天地都是红色的。四周弥漫着死亡的气息。 
山上寸草不生，连岩石也已是干瘪龟裂，不住的冒着红色的雾 
气。 

LONG+NOR); 

set("exits",([
       "up": __DIR__"migu",
	"down": __DIR__"migu1",
]));	
      
set("water", 1); 
setup(); 
} 

void init() 
{ 
add_action("do_none","move"); 
add_action("do_none","mark"); 
} 
 
int valid_leave (object who, string dir) 
{
int i;
object *inv;
string name=who->query("name");
inv=all_inventory(who);

for ( i=0;i<=sizeof(inv);i++)
	{
	if ( userp(inv[i]) )	
		return notify_fail(name+",还是把你身上背的人放下来再说！\n");
	if ( dir=="east" && who->query("sds/number")<4 )
		return notify_fail("先去参加银河战吧！！");
        if (  who && who->query("sds2/number")<10  )    // 没杀10个黑暗凤凰 
                return notify_fail(HIR"去消灭残余的凤凰军团吧！\n"NOR); 
        if (  who && who->query("sds2/fire")=="done"  )    // 已经过关
                return notify_fail("故地重游，你不由感慨万千！\n"); 
				//已经过了的就过不了咯
	return ::valid_leave(who, dir);
 	}
} 
      
int do_none( )
{
message_vision(HIR"四周毒雾弥漫，$N失去了方向感！\n"NOR,this_player() );
return 1;
}
