#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIW "山洞出口" NOR);
  set("long", @LONG

死亡岛群山的最高峰。在视野的尽头不时传来一阵阵
的嚎叫声，叫人毛骨悚然。
火山就在你的头顶！

LONG);

  set("water", 1);
  set("no_magic", 1);
  setup();
}

void init() {
  object me = this_player();
  object where = this_object();

  if (!me || where != environment(me)) return;

  add_action("do_none", "move");
  add_action("do_none", "mark");
  add_action("do_none", "recall");
  message_vision(HIW "经过一场激战,$N终于战胜了" + HIB "黑暗军团" + HIW "$P迈着沉重的步伐,走向山顶，迎接更严峻的考验！\n" NOR, me);
  me->set_temp("block_msg/all", 1);
  call_out("phix", random(5) + 5, me, where);
}

int do_none() {
  message_vision(HIR "四周毒雾弥漫，$N失去了方向感！\n" NOR, this_player());
  return 1;
}

void phix(object me, object where) {
  object head;
  if (!me || !where) return;
  me->set_temp("block_msg/all", 0);
  message_vision(
    HIW "\n忽然眼前一个人影背对烈日面对着$N傲然而立！\n$P伸手遮住阳光仔细端详,正是：" NOR + HIY "凤凰座" HIW "一辉!\n" NOR,
    me
  );
  message_vision(HIW "\n一辉笑道：能打到这儿来，我也承认你的实力！来吧，我在" NOR + HIR "死亡岩浆" NOR + HIW "里等着你！\n" NOR, me);
  message(
    "chat",
    HIB + "\n【死亡之岛】一辉(Yi hui):" + HIW + me->name() + HIB "，想要证明自己的实力来挑战我吧！\n" NOR,
    users()
  );
  me->move("/d/sds2/migong0");
  message_vision(HIW "\n$N纵身跳下万丈" NOR + HIR "岩浆" NOR + HIW "！\n" NOR, me);
}
