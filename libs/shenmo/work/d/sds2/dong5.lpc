#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "山洞出口" NOR);
  set("long", @LONG

这里是死亡岛无数山洞的一个。不同的是这里的山洞有岛上少
有的清凉，洞里深不见底。
在视野的尽头不时传来一阵阵的嚎叫声，叫人毛骨悚然。

LONG);

  set("exits", ([ /* sizeof() == 1 */
    "up": __DIR__ "shanding",
  ]));

  set("water", 1);
  setup();
}

void init() {
  add_action("do_none", "move");
  add_action("do_none", "mark");
  add_action("do_none", "recall");
}

int do_none() {
  message_vision(HIR "四周毒雾弥漫，$N失去了方向感！\n" NOR, this_player());
  return 1;
}

int valid_leave(object who, string dir) {
  if (who->query("sds2/island") != "done"  //没杀死黑暗凤凰的
  || who->query("sds2/dtm") != "done"  // 没杀死暗黑天马
  || who->query("sds2/dtl") != "done"  //没杀死黑暗天龙
  || who->query("sds2/dte") != "done"  // 没杀死暗黑白鸟
  || who->query("sds2/dxn") != "done")      //没杀死黑暗仙女	
    return notify_fail("战斗吧，女神在等你的好消息呢！\n");
  return ::valid_leave(who, dir);
}
