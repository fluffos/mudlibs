#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create()
{
   set_name(HIY"黄金戒指"NOR, ({ "golden ring","ring" }) );
   set_weight(10000);
   if( clonep() )
   set_default_object(__FILE__);
   else {
     set("unit", "件");
      set("no_sell",1);
      set("no_give",1);
      set("no_drop",1);
      set("no_get",1);
       set("value",10);
     set("material", "steel");
      set("armor_prop/armor",188);
  }
   setup();
}
int query_autoload() { return 1; }

