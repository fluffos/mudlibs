#include <ansi.h>;
inherit NPC;
#include "star.h"

void create() {
  set_name("哈迪斯", ({ "hadis", "ming wang" }));
  set("long", "传说中的冥王哈迪斯.\n");
  set("gender", "男性");
  set("title", "【冥王】");
  set("age", 37);
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 200000000);
  set("daoxing", 200000000);
  set("chat_chance", 20);
  set("chat_msg", ({
    "哈迪斯说道：这里就是极乐世界！\n"
  }));
  set_skill("dodge", 800);
  set("attitude", "friendly");
  set_skill("force", 800);
  set_skill("parry", 800);
  set_skill("unarmed", 800);
  set_skill("sword", 800);
  set_skill("westsword", 800);
  set_skill("lingbo-weibu", 800);
  set_skill("spells", 800);
  set_skill("tianxie", 800);
  map_skill("sword", "westsword");
  map_skill("spells", "tianxie");
  map_skill("dodge", "lingbo-weibu");
  set("max_force", 12000);
  set("force", 12000);
  set("max_mana", 12000);
  set("mana", 12000);
  set("mana_factor", 500);
  set("force_factor", 500);
  set("max_kee", 30000);
  set("max_gin", 30000);
  set("max_sen", 30000);
  set_temp("armor", 10000);
  set_temp("armor_vs_force", 10000);
  set_temp("dodge", 2000);

  setup();
  carry_object(__DIR__ "obj/tx_cloth")->wear();
  carry_object("/d/obj/weapon/sword/westsword")->wield();
}

void init() {
  add_action("do_none", "cast");
  add_action("do_none", "ji");
  add_action("do_none", "steal");
  add_action("do_none", "bian");
  add_action("do_none", "surrender");
  add_action("do_none", "touxiang");
  add_action("do_none", "move");
  add_action("do_none", "chuansuo");
}
int do_none() {
  object me = this_object();
  message_vision("这里已经被封印了！！！\n", me);
  return 1;
}
void check() {
  object ob = this_object();
  object ghost;
  object me = query_temp("my_killer");
  if (!me) return;
  if (!present(me, environment())) {
    remove_call_out("check");
    return;
  }
  switch (random(3)) {
    case 0:
      {
        message_vision(HIR "$N说道：“神之裁决”？\n", ob);

        if (random(3) == 0) {
          message_vision(YEL "$N被冥王之剑劈了个正着！\n" NOR, me);
          me->receive_wound("kee", 1000 + random(6000));
          me->receive_wound("sen", 1000 + random(6000));
          COMBAT_D->report_status(me);
          COMBAT_D->report_sen_status(me);
        } else message_vision(YEL "$N有先见之明，先躲了。\n" NOR, me);
      }
      break;


    case 1:
      {

        message_vision(HIC "$N吹了一口气，一道死亡之光向$n照去！\n", ob, me);

        if (random(3) == 0)

        {
          message_vision(YEL "$N顿时被照晕了头！\n" NOR, me);
          me->receive_wound("kee", 1000 + random(6000));
          me->receive_wound("sen", 1000 + random(6000));
          COMBAT_D->report_status(me);
          COMBAT_D->report_sen_status(me);
        } else
          message_vision(YEL "$N连忙躲开了。\n" NOR, me);
      }
      break;


  }


  remove_call_out("check");
  call_out("check", 2);
}
void die() {
  object me = this_object();
  object ob = query_temp("my_killer");
  if (random(5) != 1) {
    powerup();
  } else {
    if ((ob && ob->query("mingjie/tu5") == "done") && (ob && ob->query("mingjie/jingtu") != "done")) {
      ob->start_busy(3);
      message("chat", HIY + "【冥界】雅典娜(Ya dian na):" + ob->name() +
        "打倒了冥王！\n" NOR, users());
      ob->set("mingjie/jingtu", "done");
      ob->add("mingjie/number", 1);
      ob->set("title", HIW "雅典娜的神斗士" NOR);
      ob->save();
      ob->add("daoxing", 150000);
      tell_object(ob, "你赢得了一百五十年道行。\n");
      ob->move("d/mingjie/mi");
      ::die();
    }
  }

}
