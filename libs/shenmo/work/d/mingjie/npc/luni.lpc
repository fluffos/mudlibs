inherit NPC;
#include "star.h"
#include <ansi.h>;

void create() {
  set_name("路尼", ({ "lu ni", "ni" }));
  set("long", "冥界法庭的代庭长\n");
  set("gender", "男性");
  set("title", HIY "【天英星】" NOR);
  set("age", 37);
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 200000000);
  set("daoxing", 200000000);
  set("chat_chance", 20);
  set("chat_msg", ({
    "路尼说道：“肃静，这里是法庭”！\n"
  }));
  set_skill("dodge", 800);
  set("attitude", "friendly");
  set_skill("force", 800);
  set_skill("parry", 800);
  set_skill("sword", 800);
  set_skill("unarmed", 800);
  set_skill("westsword", 800);
  set_skill("balei", 800);
  set_skill("spells", 800);
  set_skill("jinniu", 800);
  map_skill("sword", "westsword");
  map_skill("spells", "jinniu");
  map_skill("dodge", "balei");
  set("max_force", 12000);
  set("force", 12000);
  set("max_mana", 12000);
  set("mana", 12000);
  set("mana_factor", 500);
  set("force_factor", 500);
  set("max_kee", 15000);
  set("max_gin", 15000);
  set("max_sen", 15000);

  setup();
  carry_object(__DIR__ "obj/ty_cloth")->wear();
  carry_object("/d/obj/weapon/sword/westsword")->wield();
}

void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
  add_action("do_none", "shield");
  add_action("do_none", "steal");
  add_action("do_none", "remove");
  add_action("do_none", "wear");
}
int do_none() {
  object me = this_object();
  message_vision("$N冷笑一声：这里是我的管区，我说了算！！！\n", me);
  return 1;
}


void check() {
  object ob = this_object();
  object me = query_temp("my_killer");
  if (!me) return;
  if (!present(me, environment())) {
    remove_call_out("check");
    return;
  }

  switch (random(4)) {
    case 0:
      {
        message_vision(YEL "$N手持巴比隆之鞭，使出绝技：“火焰绞绳”！\n", ob, me);


        if (random(2) == 0) {
          message_vision(YEL "$N被巴比隆之鞭，绞了个正着，顿时伤痕累累！\n" NOR, me);
          me->receive_wound("kee", 1000 + random(3000));
          me->receive_wound("sen", 1000 + random(3000));
          COMBAT_D->report_status(me);
          COMBAT_D->report_sen_status(me);
        } else
          message_vision(YEL "$N看见他拿出巴比隆之鞭，飞一般的跑了，巴比隆之鞭根本就打不中！\n" NOR, me);
      }
      break;


    case 1:
      {
        message_vision(YEL "$N念念有词，你被$N送到了火焰地狱受苦！\n", ob, me);
        message_vision(YEL "$N快被烧化了！\n" NOR, me);
        me->receive_wound("kee", 1000 + random(3000));
        me->receive_wound("sen", 1000 + random(3000));
        COMBAT_D->report_status(me);
        COMBAT_D->report_sen_status(me);
      }
      break;


  }
  if (random(4) == 1)

    powerup();

  remove_call_out("check");
  call_out("check", 2 + random(2));
}
void die() {

  object ob = query_temp("my_killer");

  if ((ob && ob->query("mingjie/river") == "done") && (ob && ob->query("mingjie/yi") != "done")) {
    ob->start_busy(3);
    message("chat", HIY + "【冥界】雅典娜(Ya dian na):" + ob->name() +
      "闯过了第一狱!\n" NOR, users());
    ob->set("mingjie/yi", "done");
    ob->add("mingjie/number", 1);
    ob->add("daoxing", 20000);
    ob->set("title", HIW "天英星冥斗士" NOR);
    ob->save();
    tell_object(ob, "你赢得了二十年道行");

  }
  ::die();
}
