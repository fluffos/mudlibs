inherit NPC;
#include "star.h"
#include <ansi.h>;

void create() {
  set_name("法拉奥", ({ "fala ao", "ao" }));
  set("long", "天兽星法拉奥第二狱的看守。\n");
  set("gender", "女性");
  set("title", "【天兽星】");
  set("age", 37);
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 200000000);
  set("daoxing", 200000000);
  set("chat_chance", 20);
  set("chat_msg", ({
    "法拉奥说道：“在世间犯了贪欲的罪人，都将成为地狱三头犬的食物”！\n"
  }));
  set_skill("dodge", 800);
  set("attitude", "friendly");
  set_skill("force", 800);
  set_skill("parry", 800);
  set_skill("unarmed", 800);
  set_skill("sword", 800);
  set_skill("westsword", 800);
  set_skill("balei", 800);
  set_skill("spells", 800);
  set_skill("shuangzi", 800);
  map_skill("sword", "westsword");
  map_skill("spells", "shuangzi");
  map_skill("dodge", "balei");
  set("max_force", 12000);
  set("force", 12000);
  set("max_mana", 12000);
  set("mana", 12000);
  set("mana_factor", 500);
  set("force_factor", 500);
  set("max_kee", 15000);
  set("max_gin", 15000);
  set("max_sen", 15000);

  setup();
  carry_object(__DIR__ "obj/ts_cloth")->wear();
  carry_object("/d/obj/weapon/sword/westsword")->wield();
}

void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
  add_action("do_none", "shield");
  add_action("do_none", "steal");
  add_action("do_none", "remove");
  add_action("do_none", "wear");
  add_action("do_none", "move");
}
int do_none() {
  object me = this_object();
  message_vision("死灵之国，不可卤莽！！！\n", me);
  return 1;
}

void check() {
  object ob = this_object();
  object me = query_temp("my_killer");
  if (!me) return;

  if (!me) return;
  if (!present(me, environment())) {
    remove_call_out("check");
    return;
  }

  switch (random(4)) {
    case 0:
      {
        message_vision(HIG "$N手持魔琴，演奏出一曲：“均衡的咒术”！\n", ob, me);

        if (random(4) == 0)

        {
          message_vision(HIG "你听了$N的乐曲，心都快碎了！\n" NOR, me);
          me->receive_wound("kee", 1000 + random(3000));
          me->receive_wound("sen", 1000 + random(3000));
          COMBAT_D->report_status(me);
          COMBAT_D->report_sen_status(me);
        } else
          message_vision(HIG "你捂住耳朵，不听$N的演奏！\n" NOR, me);
      }
      break;


    case 1:
      {

        message_vision(HIC "$N一挥手，一头地狱三头犬扑了上来$n！\n", ob, me);

        if (random(4) == 0)

        {
          message_vision(HIC "$N被狗咬了个正着！\n" NOR, me);
          me->receive_wound("kee", 1000 + random(3000));
          me->receive_wound("sen", 1000 + random(3000));
          COMBAT_D->report_status(me);
          COMBAT_D->report_sen_status(me);

        } else
          message_vision(HIC "$N早就看见狗了，从怀中拿出一根骨头，把狗逗走了。\n" NOR, me);
      }
      break;
  }
  if (random(4) == 1)
    powerup();

  remove_call_out("check");
  call_out("check", 2 + random(2));
}

void die() {

  object ob = query_temp("my_killer");

  if ((ob && ob->query("mingjie/yi") == "done") && (ob && ob->query("mingjie/er") != "done")) {
    ob->start_busy(3);
    message("chat", HIY + "【冥界】雅典娜(Ya dian na):" + ob->name() +
      "闯过了第二狱。\n" NOR, users());
    ob->set("mingjie/er", "done");
    ob->add("mingjie/number", 1);
    ob->add("daoxing", 30000);
    ob->set("title", HIW "天兽星冥斗士" NOR);
    ob->save();
    tell_object(ob, "你得到了三十年道行!");

  }
  ::die();
}
