#include <ansi.h>;
inherit NPC;
#include "star.h"
 
void create()
{
        set_name("塔那托斯", ({"tana tuosi", "tana"}));
        set("long", "传说中的死神。\n");
        set("gender","女性");
        set("title", "【死神】");
        set("age",37);
        set("con",30);
        set("per",30);
        set("str",25);
        set("int",35);
        set("combat_exp",200000000);
        set("daoxing",200000000);
        set("chat_chance",20);
        set("chat_msg", ({
                "塔那托斯说道：“想见冥王？先过我这关把 ！\n"   
        }));
        set_skill("dodge", 800);
        set("attitude", "friendly");
        set_skill("force", 800);
        set_skill("parry", 800);
        set_skill("unarmed", 800);
        set_skill("sword", 800);
        set_skill("westsword",800);
        set_skill("balei",800);
        set_skill("spells",800);
        set_skill("shinu", 800);
        map_skill("sword","westsword");
        map_skill("spells","shinu");
        map_skill("dodge","balei");
        set("max_force", 12000);
        set("force", 12000);
        set("max_mana",12000);
        set("mana",12000);
        set("mana_factor",500);
        set("force_factor", 500);
        set("max_kee", 15000);
        set("max_gin", 15000);
        set("max_sen", 15000);

        setup();
        carry_object(__DIR__"obj/ss_cloth")->wear();
        carry_object("/d/obj/weapon/sword/westsword")->wield();
}
 

void check()
{
        object ob=this_object();
        object me=query_temp("my_killer");
        if( ! me ) return ;
   if(! present(me,environment()) )
     {
     remove_call_out("check");
     return;
     }                               


     switch(random(3))
     {        
        case 0:
        {
        message_vision(HIW"$N使出绝招：“可怕的天命”！\n",ob,me);

                if(random(2)==0)

                {
              message_vision(HIW"$N还是躲不过天命！\n"NOR,me);
              me->receive_wound("kee",1000+random(6000));
              me->receive_wound("sen",1000+random(6000));
              COMBAT_D->report_status(me);
              COMBAT_D->report_sen_status(me);
       
                }
        else
        message_vision(YEL"$N早有预谋，天命并不重要！\n"NOR,me);
        }
        break;


                      case 1:
        {
        message_vision(HIW"$N使出绝招：“可怕的天命”！\n",ob,me);

                if(random(2)==0)

                {
              message_vision(HIW"$N还是躲不过天命！\n"NOR,me);
              me->receive_wound("kee",1000+random(6000));
              me->receive_wound("sen",1000+random(6000));
              COMBAT_D->report_status(me);
              COMBAT_D->report_sen_status(me);
       
                }
        else
        message_vision(YEL"$N早有预谋，天命并不重要！\n"NOR,me);
        }
        break;




    }
        if( random(3) == 1 )
        powerup();

        remove_call_out("check");
        call_out("check",2);
}

void die()
{

        object ob = query_temp("my_killer");

        if((ob&&ob->query("mingjie/tu3")=="done") && (ob&&ob->query("mingjie/tu4")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIY+"【冥界】雅典娜(Ya dian na):"+ob->name()+
        "打败了传说中的死神。\n"NOR,users());
        ob->set("mingjie/tu4","done");
        ob->add("mingjie/number",1);
         ob->add("daoxing", 120000);
      ob->set("title",HIW"死神"NOR);
           ob->save();
         tell_object(ob,"你赢得了一百二十年道行");

        }
       ::die();
}

void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
        add_action("do_none","ji");
        add_action("do_none","shield");
        add_action("do_none","steal");
        add_action("do_none","remove");
        add_action("do_none","wear");
}
int do_none()
{
        object me = this_object();
        message_vision("$N冷笑一声：这里是我的管区，我说了算！！！\n",me);
        return 1;
} 


