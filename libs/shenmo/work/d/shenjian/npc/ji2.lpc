//By yhq 2004-10-15
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string give_class();

void create()
{
object jian,armor;
set_name(HIM"纪芙"NOR, ({ "ji fu", "ji","jifu", "fu",}) );
set("gender", "女性" );
set("age", 21);
set("agi",30);
set("str", 60);
set("per", 29);
set("class","human");
set("nickname", HIG"燕十三"HIY"座下夺命圣女"NOR);
set("int",30);
set("attitude","friendly");
set("max_force", 2100);
set("force", 3000);
set("force_factor", 80);
set("max_mana", 2300);
set("mana", 3000);
set("max_kee",30000);
set("max_gin",3000);
set("max_sen",30000);
set("chat_chance", 30);
set("long",
"这位就是燕十三的红颜知己纪芙小姐，也是夺名十三剑的传人\n"
        );
create_family("神剑山庄",2,"夺命剑法传人");
set("combat_exp", 630000);
set("daoxing", 1230000);

set_skill("literate", 80);
set_skill("unarmed", 100);
set_skill("dodge", 100);
set_skill("force", 120);
set_skill("parry", 115);
set_skill("sword", 105);
set_skill("spells", 120);
set_skill("blade", 125);
set_skill("lianhuan-zhang", 155);
set_skill("duo-sword", 185);
set_skill("cloudforce", 115);
set_skill("shadowsteps", 135);
set_skill("xueying-xianfa", 115);

map_skill("spells", "xueying-xianfa");
map_skill("unarmed", "lianhuan-zhang");
map_skill("force", "cloudforce");
map_skill("sword", "duo-sword");
map_skill("parry", "duo-sword");
map_skill("dodge", "shadowsteps");
set("inquiry", ([
//        "神剑山庄"    :(:give_class:),
]));
setup();
jian = new("/d/city/npc/obj/sword");
jian->set_name(HIB"蜃"HIW"睑"HIG"踅"HIM"樱"NOR,({"shen jian","jian","sword"}));
jian->move(this_object());
armor = new("/d/city/npc/obj/armor");
armor->set_name(HIR"千重"HIM"刹衣"NOR,({"sha yi","cloth","armor"}));
armor->move(this_object());
command("wield all");
command("wear all");
}

void attempt_apprentice(object ob)
{
if( (string)ob->query("family/family_name")=="神剑山庄" )
        {
        if( (int)ob->query("family/generation") < 3  )
                say(CYN+name()+CYN"说道: 不敢，不敢。我该拜" + RANK_D->query_respect(ob) + "您为师才是。\n"NOR);
        else if( (int)ob->query("family/generation") ==3  )
                say(CYN+name()+CYN"说道：你这个" + RANK_D->query_rude(ob) + "还是别来消遣你姑奶奶了！\n"NOR);
        else    {
                command(":D");
                say(CYN+name()+CYN"说道："+ RANK_D->query_respect(ob) + "投入我门下保你学到上乘剑法！\n"NOR);
                command("recruit " + ob->query("id") );
                ob->set("class", "human");
                }
        }

else    {
        command(":D ");
        say(CYN+name()+CYN"说道：好，"+ RANK_D->query_respect(ob) +"，你到我神剑山庄，必有出人头地的一天！\n");
        command("recruit " + ob->query("id") );
        message("channel:chat", HIB"我神剑山庄又多了一个弟子  "HIR+this_player()->name()+HIW"
                神剑山庄"HIY"的势力加强了。\n"NOR,users());
        ob->set("class", "human");
        }
return;
}

string give_class()
{
object who=this_player();

if (who->query("family/family_name") == "神剑山庄" )
        {
        who->move("/d/shenjian/sjsz.lpc");
        return "一路顺风。";
        }
else    return "你不是我山庄人吧？";
}

void init()
{
add_action("do_check","check");
add_action("do_none","cast");
add_action("do_none","perform");
}

int do_check(string arg)
{
if ( arg && id(arg) )
        {
        message_vision(HIY"$N"HIY"口中念了几句咒文，眼中突然精光一闪，大喝一声“顺风耳何在！”
只听嘿嘿几声奸笑，不知从哪里钻出来一个肥头大耳的家伙，在$N"HIY"耳边低声说了几句话。\n"NOR,this_player());
        tell_object(this_player(),"顺风耳告诉你："+name()+"的道行已达"HIW"万剑具发"NOR"的境界。\n");
        tell_object(this_player(),"顺风耳告诉你："+name()+"的武功已达"HIW"驾驭万剑"NOR"的境界。\n");
        tell_object(this_player(),"顺风耳告诉你："+name()+"的法力修为已达"HIW"万剑均祭"NOR"的境界。\n");
        tell_object(this_player(),"顺风耳告诉你："+name()+"的内力修为已有"HIW"万剑已成"NOR"的火候。\n");
        message_vision("$N忽然莫名其妙地哆嗦了一下。",this_object());
        return 1;
        }
return 0;
}

void _kill_ob(object who)
{
string msg;
int damage;
object ob = this_object();
if ( !who )
        return ;
if ( !who->is_fighting(ob) )
        {
        if ( ob->is_fighting(who) )
                ob->kill_ob(who);
        else    return ;
        }
if ( !living(who) )
        return ;

switch(random(6))
        {
        case 0 :
                msg = HIW "
$N"HIW"突然发出绝世剑法中的最后一式『剑八』！此招及其歹毒凶狠,直攻$n"HIW"的胸口！\n\n\n\t\t\t"NOR+HIY"【"NOR+CYN"¤"NOR+BLINK+HIR"劍"NOR+CYN"¤"NOR+HIY"】\n\n\n"NOR;
                damage = 500;
                break;
        case 1 :
                msg = HIR"
$N"HIR"轻描淡写，挥尘如意，一瞬间就已使出夺命十三式，手中之剑轻灵流动。\n就像是河水般的向$n"HIR"刺出,天地间彷佛充满了杀气！\n\n" NOR;
                damage = 800;
                break;
        case 2 :
                msg = RED"
$N"RED"的剑气和杀气都很重，宛如满天岛云密布。这一剑刺出，忽然间就将满天乌云都拨开了，现出了阳光。
这一剑刺出，所有的变化才真的已到了穷尽，本已到了尽头的流水，现在就像是已完全枯竭。
$N"RED"的力也已竭了。\n"NOR;
                msg+= MAG"
可是就在这时候，$N"MAG"手中的剑忽然又起了奇异的震动,天地万物忽然全都静止，
绝对静止，没有变化，没有生机!这一剑带来的，只有死!只有"NOR+BLINK+BLU"「死」"NOR+MAG"，才是所有一切的终结，
才是真正的终结！流水乾枯，变化穷尽，生命终结，万物灭亡!这才是"NOR+BLINK+RED"「夺命十三剑」"NOR+MAG"真正的精粹!\n\n"NOR;
                damage = 1500;
                break;
        case 3 :
                SDS_D->powerup(ob);
                break;
        default :
                COMBAT_D->do_attack(ob,who,ob->query_temp("weapon"));
        }
if ( msg && strlen(msg)>0 )
        {
        damage = damage/2+random(damage);
        message_vision(msg,ob,who);
        if ( random(3) || damage<=0 )
                message_vision(YEL"\n$n"YEL"连忙闪身躲开，吓出了一身的冷汗！\n\n"NOR,ob,who);
        else    {
                message_vision(HIG"\n$n"HIG"闪避不及，顿时身中此招。。。\n\n"NOR,ob,who);
                who->receive_damage("kee",damage);
                COMBAT_D->report_status(who);
                who->set_temp("last_damage_from",ob);
                }
        }
remove_call_out("_kill_ob");
call_out("_kill_ob",5+random(5),who);
}

void kill_ob(object who)
{
this_object()->command("perform jianba");
_kill_ob(who);
}

int fight_ob(object who)
{
kill_ob(who);
}

int do_none()
{
if ( this_player()->is_fighting(this_object())
  || this_object()->is_fighting(this_player()) )
  {
  if ( query_verb()=="cast" )
    {
    say(HIR+name()+HIR"看起来要杀死你！\n"NOR);
    return 1;
    }
  else  {
  SDS_D->powerup(this_object());
  return 0;
   }
 }
return 0;
}




