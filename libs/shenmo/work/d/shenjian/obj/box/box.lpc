// create by lost 2004.11.5
#include <ansi.h>

inherit ITEM;

void create()

{
  set_name("箱子", ({ "woodcase", "case" }));

  set_weight(500);

  set_max_encumbrance(40000);

  if (clonep())

    set_default_object(__FILE__);

  else {

    set("unit", "口");

    set("long", YEL "一口陈旧平凡，决不会引起任何人注意的箱子。扁扁的一口箱子，有一尺多宽，两尺多长，整个箱子用暗褐色的牛皮包着。\n
你可用它（pinzhi）或（remake）出当今武林中的任何神兵利器。\n
凝碧剑(ningsword)瀚海云烟(yunblade)血刀(bloomblade)圆月弯刀(wandao)小李飞刀(feidao)\n
苍穹神剑(cangqiong)闪电龙鳞劈(long-blade)海渊剑(seasword)金光禅杖(staff)锈铁片(rustysword)\n
流星锤(hammer)慈悲鞭(whip)大风刀(windblade)雅乌古剑(darksword)寒天吹血(soulcrasher)伏龙宝刀(fulongblade)\n
火焰长刀(fireblade)天下无双(deitysword)镶着十三颗明珠的剑(jewelsword)\n" NOR);


  }

}
int is_container() {
  return 1;
}

void init()

{
  add_action("do_make", "pinzhi");
}

int do_make(string arg)

{
  object me = this_player();
  object obj = this_object();

  object weapon;

  if (!present(obj, me) || !(arg)) return notify_fail("什么？\n");
  switch (arg) {
    case "ningsword": weapon = new(__DIR__ "nsword");
    break;
    case "yunblade": weapon = new(__DIR__ "yunblade");
    break;
    case "bloomblade": weapon = new(__DIR__ "bloomblade");
    break;
    case "wandao": weapon = new(__DIR__ "lou");
    break;
    case "feidao": weapon = new(__DIR__ "xlfd");
    break;
    case "cangqiong": weapon = new(__DIR__ "cq");
    break;
    case "long-blade": weapon = new(__DIR__ "long-blade");
    break;
    case "seasword": weapon = new(__DIR__ "seasword");
    break;
    case "staff": weapon = new(__DIR__ "jgstaff");
    break;
    case "rustysword": weapon = new(__DIR__ "musword");
    break;
    case "hammer": weapon = new(__DIR__ "starhammer");
    break;
    case "whip": weapon = new(__DIR__ "cbwhip");
    break;
    case "windblade": weapon = new(__DIR__ "dafeng");
    break;
    case "darksword": weapon = new(__DIR__ "yasword");
    break;
    case "soulcrasher": weapon = new(__DIR__ "xuesword");
    break;
    case "fulongblade": weapon = new(__DIR__ "dragonblade");
    break;
    case "fireblade": weapon = new(__DIR__ "fireblade");
    break;
    case "deitysword": weapon = new(__DIR__ "deitysword");
    break;
    case "jewelsword": weapon = new(__DIR__ "jewelsword");
    break;
    default:
      return notify_fail("你将手中的箱子打开，用其中的零件无法拼成这种武器。\n");
      break;
  }

  weapon->move(me);
  message_vision(
    "$N把手中的$n打开，用其中的零件拼成了一" + weapon->query("unit") + weapon->name() + "！\n" NOR,
    me,
    obj
  );
  destruct(obj);
  return 1;
}
