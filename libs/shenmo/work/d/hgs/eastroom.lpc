inherit ROOM;
#include <ansi.h>;
void create()
{
        set("short", "花果山福地");
         set ("long", @LONG
花果山福地、水帘洞洞天。此处便是美猴王孙悟空的洞府。四周山石嶙峋
草木茂盛、灵气充沛，许多小猴子在树间荡漾。远处不时传来阵阵怪叫。
LONG);
                     
set("exits", ([
      "northwest": __DIR__"e-1", 
      "southwest": __DIR__"e-2",  
      "east": __DIR__"e-0",                                        
        ]));
  set("objects", ([ 
      "/d/hgs/npc/tudi.lpc" : 1,
        ]));

        setup();
}

int valid_leave (object who, string dir)
{
  if (dir == "east")
    return ::valid_leave(who,dir);

if(time()-who->query_temp("hgs_die")<30) 
    return notify_fail(HIW"休息一下再去吧！\n"NOR);
  return ::valid_leave(who,dir);
}
