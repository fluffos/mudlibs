inherit ROOM;
#include <ansi.h>;
void create()
{
        set("short", "花果山腹地中心");
         set ("long", @LONG
花果山福地、水帘洞洞天。此处便是美猴王孙悟空的洞府。四周山石嶙峋
草木茂盛、灵气充沛，许多小猴子在树间荡漾。一只相貌俊美的猴子正与
小猴儿们嬉笑耍闹。
LONG);
                     
set("exits", ([
      "northeast": __DIR__"e-7", 
      "southeast": __DIR__"e-8",  
      "northwest": __DIR__"w-7", 
      "southwest": __DIR__"w-8",                    
        ]));
  set("objects", ([ 
      "/d/hgs/npc/sunwukong.lpc" : 1,
        ]));

        setup();
}

