
#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create()
{
        set_name(HIY "打神鞭" NOR, ({ "dashen bian", "bian", "whip" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 150000);
                set("material", "steel");
                set("long", "这是姜丞相讨伐大商时所用神鞭。\n");
                set("wield_msg", "一道金光闪过，$N手中已多了条$n。\n");
                set("unequip_msg", "$N放下手中的$n。\n");
        }
        init_whip(100);
        setup();
}
