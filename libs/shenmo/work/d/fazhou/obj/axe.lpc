#include <ansi.h>
#include <weapon.h>

inherit AXE;

void create() {
  set_name(HIY "玄天巨斧" NOR, ({ "xuantian jufu", "fu", "axe" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 150000);
    set("material", "steel");
    set("long", "这是邢天当年使用的杀玉帝的神斧。\n");
    set("wield_msg", "一道紫光闪过，$N手中已多了把$n。\n");
    set("unequip_msg", "$N放下手中的$n。\n");
  }
  init_axe(100);
  setup();
}
