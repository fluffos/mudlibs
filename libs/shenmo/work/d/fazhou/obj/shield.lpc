#include <armor.h>
#include <ansi.h>

//inherit F_UNIQUE;
inherit SHIELD;
void create()
{
  set_name(HIY"嗜血神盾"NOR, ({"shixue shendun","shield", "dun"}));
  set_weight(4000);
  if ( clonep() )
     set_default_object(__FILE__);
  else {
   set("unit", "件");
   set("value", 1000);
   set("long", "这是传说中的集血，精神，时间，汗水而成的盾,具有无比的灵性。\n");
   set("material", "crimsonsteel");
   set("no_sell", 1);
   set("no_drop", 1);
   set("no_put", 1);
   set("armor_prop/armor",37);
   set("armor_prop/dodge", -5);
  }
  setup();
}
