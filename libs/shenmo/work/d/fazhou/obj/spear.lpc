// 轩辕剑.c
#include <ansi.h>

#include <weapon.h>

inherit SPEAR;

void create() {
  set_name(HIW "霸王枪" NOR, ({ "bawang qiang", "qiang", "spear" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 150000);
    set("material", "steel");
    set("long", "这是一把天下唯一的神枪，枪身透亮,锋利无比。\n");
    set("wield_msg", "一道紫光闪过，$N手中已多了杆$n。\n");
    set("unequip_msg", "$N放下手中的$n。\n");
  }
  init_spear(100);
  setup();
}
