// by happ@YSZZ

#include <ansi.h>;
inherit NPC;
#include "star.h"


void create() {
  set_name("张桂芳", ({ "zhang guifang", "zhang" }));
  set("gender", "男性");
  set("long",
    "武王伐纣之挡路人----纣王麾下大将张桂芳\n"
  );
  set("str", 20);
  set("per", 130);
  set("age", 86);
  set("family/family_name", "大雪山");
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", HIR "纣王麾下大将" NOR);
  set("combat_exp", 3600000);
  set("daoxing", 3600000);
  set("max_sen", 6000);
  set("max_kee", 6000);
  set("force", 6000);
  set("max_force", 6000);
  set("force_factor", 300);
  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 300);

  set_skill("literate", 350);
  set_skill("unarmed", 400);
  set_skill("dodge", 400);
  set_skill("force", 400);
  set_skill("parry", 400);
  set_skill("fork", 400);
  set_skill("spells", 400);
  set_skill("dengxian-dafa", 400);
  set_skill("cuixin-zhang", 400);
  set_skill("ningxie-force", 400);
  set_skill("bainiao-jian", 400);
  set_skill("xiaoyaoyou", 400);
  map_skill("spells", "dengxian-dafa");
  map_skill("unarmed", "cuixin-zhang");
  map_skill("force", "ningxie-force");
  map_skill("sword", "bainiao-jian");
  map_skill("parry", "bainiao-jian");
  map_skill("dodge", "xiaoyaoyou");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: cast_spell, "juanbi" :),
    (: perform_action, "sword", "chaofeng" :),

  }));

  setup();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
}


void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
}
int do_none() {
  object me = this_object();
  message_vision("伐纣大业，岂容你乱来？\n", me);
  return 1;
}

void die() {

  object ob = query_temp("my_killer");

  if ((ob && ob->query("kunlun1/san") == "done") && (ob && ob->query("kunlun1/si") != "done")) {
    ob->start_busy(3);
    message("chat", HIY + "【武王伐纣】姬发(Ji Fa):" + ob->name() +
      "闯过了伐纣第四关·临潼关\n" NOR, users());
    ob->set("kunlun1/si", "done");
    ob->add("kunlun1/number", 1);
    ob->add("daoxing", 10000);
    ob->save();
    tell_object(ob, "你赢得了十年道行");

  }

  message_vision(HIY "$N死了....(伐纣大业成功的向前迈进了一大步) \n" NOR, this_object());
  ::die();
}
