//girl.c  
// 1.ask 2 kill 3 find ou 4.give 
#include <ansi.h>  
               
inherit NPC;  
string ask_for_key();  

void create()  
{  
set_name("殷十娘", ({"yin shiniang","yin"}));  
set("long", HIC+@LONG
她是城塘关总兵李靖的结发妻子,也是哪吒三兄弟的生母，
因为遭受玉石琵琶精的迫害，才在此帮云中子道长种一年
的莲藕。
LONG+HIC);  
set("gender", "女性");  
set("attitude","heroism");
set("age", 56);  
set("attitude", "friendly");  
set("shen_type", 1);  
  set("family/family_name","蜀山剑派");
set("per", 40);  
set("int", 40);  
set("str", 40);  
set("cps", 40);  
set("spi", 40);  
set("max_kee", 40000);  
set("max_gin", 40000);  
set("max_sen", 40000);  
set("max_force", 40000);  
set("force_factor", 600);  
set("max_mana", 40000);  
set("mana", 400000);  
set("force",400000);
set("mana_factor", 600);  
set("combat_exp", 50000000);  
       
set_skill("literate", 90);  
set_skill("unarmed", 900);  
set_skill("dodge", 920);  
set_skill("parry", 920);  
set_skill("sword", 920);  
set_skill("spells", 920);  
set_skill("taoism", 920);  
set_skill("hunyuan-zhang", 920);  
set_skill("zixia-shengong", 920);  
set_skill("force", 920);  
set_skill("yujianshu", 920);  
set_skill("sevensteps", 920);  
map_skill("spells", "taoism");  
map_skill("unarmed", "hunyuan-zhang");  
map_skill("force", "zixia-shengong");  
map_skill("sword", "yujianshu");  
map_skill("parry", "yujianshu");  
map_skill("dodge", "sevensteps");  
 set("chat_chance_combat", 50);
       set("chat_msg_combat", ({
                (: perform_action, "sword", "wanjian" :),
                (: cast_spell, "fu" :),
                (: cast_spell, "shou" :),
	}) );  
       
set("inquiry", ([  
             "钥匙" : (: ask_for_key :),  
             "key" : (: ask_for_key :),  
]) );  
setup();  
carry_object("/d/obj/weapon/sword/changjian")->wield();
carry_object("/u/yhq/fazhou/obj/key");  
}  
       
void init()  
{  
add_action("do_agree","yes");  
}  
       
string ask_for_key()  
{  
object who = this_player();  
       
if( (int)who->query("pipa_killed")) //杀死龙的问,temp("pipa_killed")在怪那设 
	{ 
        who->set_temp("findou",1);  //添加找莲藕信息 
	return "多谢大侠，%%￥￥##尚缺莲藕，你帮我拿来，它在%$$3#@# \n";  
//        who->delete("temp/long_killed"); //删除已经杀死pipajing的信息 
	} 
  
if( (int)who->query_temp("asked_for_key")) //问过人不必理会他:) 
	command("hmm "+who->query("id") );  
                                       //以下第一次问的： 
command("say 给你也行。不过....\n");  
command("xixi "+who->query("id"));  
command("say 你先帮我杀掉柳琵琶，自从她进了我家的门，\n 就一直在迫害我们母子。\n");  
who->set_temp("asked_for_key",1); //添加已问过信息. 
return "你同意(yes)吗？很危险的！";  
}  
       
int do_agree()  
{  
object who = this_player();  
           
if((int)who->query_temp("asked_for_key"))  
	{
	if(who->query("combat_exp")<5000000) 
		return notify_fail("殷十娘摇摇头道：你去恐怕是送死啊！\n");  
  
	//who->delete_temp("asked_for_key");  
	who->set_temp("kill_pipa",1); //显示其可以去杀琵琶，在琵琶那设定有此信息才能下kill,杀死后del此temp
	command("bow");  
	command("say 有劳你了。\n");  
	return 1;  
	}
return 1;
}  

int accept_object(object who,object ob)   
{
object key=new("/u/yhq/fazhou/obj/key"); 

if( who->query_temp("findou")==1 && !who->query_temp("fazhou/key") ) 
        {   
	if ( (string)ob->name()=="莲藕" ) 
	key->move(who); 
        who->set_temp("findou",0);   
        who->set_temp("fazhou/key",1);   
	message_vision("$N从怀里掏出一颗金色的钥匙，递到$n手里。\n",this_object(),who);   
	return 1; 
	}   
command("thank "+who->query("id") );
return 1; 
}
     
