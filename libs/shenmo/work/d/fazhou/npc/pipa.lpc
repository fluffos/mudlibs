//枇杷精，千年玉琵琶所化 pipa.c  

#include <ansi.h>
inherit NPC;

string *musics = ({ HIC "楚女幽歌" NOR, HIG "湘边竹泣" NOR, HIY "归子之母" NOR, HIB "凄凄离别" NOR, });

int music();
void kill_ob(object ob);

void create() {
  set_name("柳琵琶", ({ "liu pipa", "pipa", "liu" }));
  set("long", HIM + @LONG  
一位花容月貌沉鱼落雁的美人儿，眼角带媚，嘴角生娇，  
见你目瞪口呆的望向她，正掩口吃吃的笑着。  
LONG + NOR);
  set("gender", "女性");
  set("age", 18);
  set("per", 40);
  set("max_kee", 10000);
  set("max_gin", 3000);
  set("max_sen", 6000);
  set("max_mana", 3000);
  set("mana", 1500);
  set("combat_exp", 2000000 + random(2000000));
  set_temp("apply/attack", 160 + random(300));
  set_temp("apply/damage", 100 + random(100));
  set_temp("apply/armor", 340 + random(400));

  setup();
}

void init() {
  add_action("do_none", "kill");
  add_action("do_none", "fight");
  add_action("do_none2", "ji");
  add_action("do_none2", "move");
  //add_action("do_none2","perform");  
}

int do_none() {
  object who = this_player();
  object ob = this_object();
  if ((int)who->query_temp("kill_pipa")) {
    if (ob->query("id") != "pipa jing") {
      kill_ob(who);
      return 1;
    } else {
      message_vision("\n$N" + HIW "化作一缕轻烟消失了！\n" NOR, ob);
      destruct(this_object());
    }
  } else {
    message_vision(HIC "$N朝$n媚媚一笑，$p立刻忘记了自己想做什么。。。\n" NOR, this_object(), this_player());
    return 1;
  }
}

int music() {
  int i;
  int dam;
  object *inv;
  message_vision(
    HIW "\n$N轻弹一曲『" + musics[random(sizeof(musics))] + HIW "』！阵阵幽曲之音响彻大厅！\n" NOR,
    this_object()
  );
  inv = all_inventory(environment(this_object()));
  for (i = sizeof(inv) - 1; i >= 0; i--)

    if (living(inv[i])) {
      dam = random(300) + 100 - inv[i]->query_temp("apply/armor_vs_spells");
      if (dam < 0) dam = 0;
      inv[i]->receive_wound("kee", dam);
      COMBAT_D->report_status(inv[i], 1);
    }
  return 1;
  remove_call_out("music");
  call_out("music", random(10) + 2);
}

void die() {
  object ob = this_object();
  object who = query_temp("my_killer");
  who->set("pipa_killed", 1);
  message_vision(HIW "\n$N惨叫一声，化作一阵清烟散去...\n" NOR, this_object());
  destruct(ob);
  if (environment()) {
    die();
  }
  ::die();
}

int do_none2() {
  message_vision(HIC "$N朝$n媚媚一笑，$p立刻忘记了自己想做什么。。。\n" NOR, this_object(), this_player());
  return 1;
}

void kill_ob(object who) {
  object ob = this_object();
  set_temp("my_killer", who);
  message_vision(HIY "\n$N恨声说道：定是殷十娘那婆娘叫你来害我的好事！\n说罢，$N顿时变了脸色，原来是一只晶莹剔透的玉石琵琶精！\n", ob);
  ob->set_name(HIW "玉石琵琶精" NOR, ({ "pipa jing", "pipa", "jing" }));
  ob->set("long", HIW "\n\n一只千年道行的玉石琵琶精！\n" NOR);
  who->delete_temp("kill_pipa");
  who->delete_temp("asked_for_key");
  //who->set_temp("pipa/kill",1);  
  remove_call_out("music");
  call_out("music", random(10) + 5);
  ::kill_ob(who);
}
