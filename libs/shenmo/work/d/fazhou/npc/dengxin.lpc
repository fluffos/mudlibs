#include <ansi.h>;
inherit NPC;
#include "star.h"
 
void create()
{
        set_name("邓辛", ({  "deng xin", "deng" }) );
        set("gender", "男性" );
	set("long",
		"武王伐纣之挡路人----纣王麾下大将邓辛\n"
	);
  set("str", 20);
  set("per", 130);
 set("age", 150);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title",WHT "纣王麾下大将"NOR);
  set("family/family_name","将军府");
  set("combat_exp", 3000000);
  set("daoxing", 3000000);
  set("max_sen", 6000);
  set("max_kee", 6000);
  set("force", 6000); 
  set("max_force", 6000);
  set("force_factor", 100);
  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 100);
	
  set_skill("literate", 350);
  set_skill("unarmed", 350);
  set_skill("force", 350);
  set_skill("lengquan-force", 350);
  set_skill("mace", 200);
  set_skill("sword", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("jinglei-mace", 200);
  set_skill("xiaofeng-sword", 200);
  set_skill("spells", 200);
  set_skill("baguazhou", 200);
  set_skill("yanxing-steps", 200);
set_skill("spear",200);
set_skill("axe",200);
set_skill("changquan",200);
set_skill("bawang-qiang",200);
set_skill("sanban-axe",200);
map_skill("unarmed","changquan");
map_skill("axe","sanban-axe");
map_skill("spear","bawang-qiang");
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("mace", "jinglei-mace");
  map_skill("parry", "sanban-axe");
  map_skill("dodge", "yanxing-steps");
  map_skill("sword", "xiaofeng-sword");
       set("chat_chance_combat", 50);
       set("chat_msg_combat", ({
                (: perform_action, "mace", "tian" :),
                (: exert_function, "recover" :),
                (: exert_function, "heal" :),
                }) );
	setup();
  carry_object("/d/obj/weapon/mace/ironmace")->wield();
   carry_object("/d/obj/armor/jinjia")->wear();
}


void init()
{
       add_action("do_none","perform");
      add_action("do_none","cast");
        add_action("do_none","ji");
 add_action("do_none","fight");
}
int do_none()
{
       object me = this_object();
       message_vision("伐纣大事，岂容你乱来？\n",me);
       return 1;
} 


void die()
{

        object ob = query_temp("my_killer");

           if(ob&&ob->query("kunlun1/yi")!="done")

        {
        ob->start_busy(3);
        message("chat",HIY+"【武王伐纣】姬发(Ji Fa):"+ob->name()+
        "闯过了伐纣第一关·黄花山\n"NOR,users());
        ob->set("kunlun1/yi","done");
        ob->add("kunlun1/number",1);
	ob->add("daoxing", 10000);
            ob->save();
        tell_object(ob,"你赢得了十年道行");
        
        }
message_vision(HIY"$N死了....(伐纣大业成功的向前迈进了一大步) \n"NOR,this_object() );
       ::die();
}

