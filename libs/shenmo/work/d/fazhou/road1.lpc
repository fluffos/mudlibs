int valid_leave(object me,string dir) 
{ 
        object man; 
        if (dir=="south" || !man=present("deng xin",environment(me)) ) 
          return ::valid_leave(me,dir); 
        if (!living(man)) return ::valid_leave(me,dir); 
        if (!me->query_temp("passed")) return notify_fail("放你过去可是满门抄斩的，他们两个人可没那么大胆!!!\n"); 
        return ::valid_leave(me,dir); 
        
      }
 
