#include <ansi.h>
inherit ROOM;
string long_desc();

void create ()
{
set ("short", HIY"龙凤阁"NOR+HIW"楼梯间"NOR);
set("long", (:long_desc:));
set("item_desc" , ([  
	"up": HIR"靠，想偷窥啊？流氓！\n"NOR, 
	"north": HIR"靠，想偷窥啊？流氓！\n"NOR, 
	"south": HIR"靠，想偷窥啊？流氓！\n"NOR, 
	"west": HIR"靠，想偷窥啊？流氓！\n"NOR, 
	"east": HIR"靠，想偷窥啊？流氓！\n"NOR, 
])); 
set("exits", ([
	//"up"	: "/d/player-room/steps2",  //第二层
	"down"	: "/d/city/misc/idleroom", //发呆室
	"north"	: "/d/player-room/room1",  //huhu的房间
	"east"	: "/d/player-room/room2",  //痞子的房间
        "west"  : "/d/player-room/room3",  //huapi的房间
        "south"  : "/d/player-room/room4",  //dai的房间
])); 
set("no_fight",1);
set("no_magic",1);
set("limit_exits",({"down"})); 
set("no_ridee", 1);
set("NONPC", 1);
setup();
}

