#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIW "请柬" NOR, ({ "tie" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", HIC "一张请柬，上面可以签名！(sign)\n" NOR);
  }
  setup();
}

void init() {
  add_action("do_sign", "sign");
}

int query_autoload() { return 1; }

int do_sign(string arg) {
  object me = this_player();
  object ob = this_object();
  if (ob->query("id") != "tie" || !arg) return 0;

  message_vision(
    HIY "$N拿起一支大毛笔，蘸了口吐沫，龙飞凤舞的在" NOR + ob->query("name") + HIY "上签上了：" + HIB + arg + HIY "。\n" NOR,
    me
  );
  ob->set_name(
    me->query("name") + "冒充" + HIW + arg + NOR "的" + ob->query("name"),
    ({ arg + "'s " + ob->query("id") })
  );
  ob->set("signed");
  return 1;
}
