#include <ansi.h>
inherit ITEM;

void create()
{
set_name(HIW"请柬"NOR,({"tie"}));
set_weight(100);
if( clonep() )
    set_default_object(__FILE__);
else {
	set("unit", "张");
	set("long",HIC"一张请柬，上面可以签名！(sign)\n"NOR);
 }
  setup();
call_out ("becoming_old",600);
}

void init()
{
add_action("do_sign","sign");
}


int do_sign(string arg)
{
object me =this_player();
object ob =this_object();
if ( ob->query("id")!="tie" )   return 0;
	
ob->set_name(me->query("name")+"的"+ob->query("name"),({ me->query("id")+"'s "+ob->query("id") } ) );
ob->set("signed");
ob->set("long",me->query("name")+"的请柬。\n"NOR);
message_vision(HIY"$N拿起一支大毛笔，蘸了口吐沫，龙飞凤舞的在"NOR+ob->query("name")+HIY"上签上了自己的大名："+HIB+me->query("name")+HIY"。\n"NOR,me);
return 1;
}

void becoming_old ()
{
object ob = this_object();
object where = environment (ob);
message_vision(HIG"一阵清风掠过，将$N吹成一片粉末散去......\n"NOR,ob);
destruct (ob);
}
