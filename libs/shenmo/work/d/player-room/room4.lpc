// by snowtu@2003

#include <ansi.h>

inherit F_SAVE;
inherit ROOM;

int save_room();
string check_str(string str);
void get_long_text(string str, string text);
void get_bed_long_text(string str, string text);
void fullup(object obj);

int is_home() { return 1; }

void create() {
  set("short", HBRED + HIW "妓院" NOR);
  set("long", CYN "\n
这儿是为奖赏玩家举报" NOR + HIW "ＢＵＧ" NOR + CYN "而特地建造的名人坊，只要是贡献卓越\n
的玩家均可获得" NOR + HIW "豪宅" NOR + CYN "一所．\n这一间是奖励给玩家" NOR + HIW "发呆专家" NOR + CYN "的。\n
主人可以在这儿邀请(qing)客人...\n" NOR);

  set("exits", ([
    "out": "/d/city/kezhan",
    "north": "/d/player-room/steps",
  ]));
  set("water", 1);
  set("alternative_die", 1);
  set("valid_startroom", 1);
  set("sleep_room", 1);
  set("chat_room", 1);
  set("no_time", 1);
  set("freeze", 1);
  set("no_upgrade_age", 1);
  setup();
}

void init() {
  object me = this_player(), env = this_object();

  add_action("go_out", "out");
  add_action("do_cast", "cast");
  if (me->query("id") == "dai" && userp(me)) {
    tell_object(me, HIC "\n欢迎主人归来！你可以用sets来装修，name来取名。\n" NOR);
    add_action("set_long", "sets");
    add_action("set_short", "name");
    add_action("do_get", "qing");
  } else if (!userp(me)) {
    message_vision(HIR "\n天上伸出一只大手，将$N一把抓去！\n\n" NOR, me);
    me->move("/u/snowtu/workroom");
    me->unconcious();
  } else if (me->query_temp("player-room/onwer") != "dai") {
    write("主人不在家，您还是呆会儿再来吧。\n");
    me->move("/d/city/kezhan");
    message_vision(CYN "$N尴尬地从" + this_object()->query("short") + CYN "走了出来。\n" NOR, me);
    return;
  } else tell_object(me, HIC "欢迎欢迎热烈欢迎。\n" NOR);
  return;
}

string do_cast(string arg) {
  string dir;
  if (!arg) return ("你想用什么法术？\n");
  if (arg == "shou") return ("你想在人家家里偷什么？\n");
  if (sscanf(arg, "shou on %s", dir) == 1) return ("你想在人家家里偷什么？\n");
}

int do_get(string arg) {
  object me, key;
  me = this_player();
  if (!arg || arg == "dai") {
    tell_object(this_player(), "你确定有这个客人......？\n");
    return 0;
  }
  key = find_player(arg);
  if (!userp(key)) return 0;
  tell_object(key, "发呆专家邀请你去他的私人别墅一聚。\n");
  key->set_temp("player-room/onwer", "dai");
  tell_object(me, "你邀请" + key->name() + "来你的私人别墅一聚。\n");
  return 1;
}

int go_out() {
  object me = this_player();
  tell_room(this_object(), me->query("name") + "推开门，走了出去。\n", ({ me }));
  me->move("/d/city/kezhan");
  message_vision("$N推开门，走了出来。\n", me);
  return 1;
}

int set_short(string str) {
  if (!str) return 0;

  str = check_str(str);
  set("short", str);
  //    set_name(this_object()->query("short"), ({this_object()->query("file_name")}));
  save_room();
  return 1;
}

int set_long() {
  string str;
  this_player()->edit((: get_long_text, str :));
  return 1;
}

void get_long_text(string str, string text) {
  str = check_str(text);
  set("long", str);
  save_room();
  return;
}

string check_str(string str) {
  str = replace_string(str, "\"", "");
  str = replace_string(str, ";", "");
  str = replace_string(str, "\\", "");
  str = replace_string(str, "/", "");
  str = replace_string(str, "'", "");
  str = replace_string(str, "`", "");
  str = replace_string(str, ",", "");
  str = replace_string(str, "!", "");
  str = replace_string(str, "~", "");
  str = replace_string(str, "{", "");
  str = replace_string(str, "}", "");
  str = replace_string(str, "$", "");
  str = replace_string(str, "&", "");
  return str;
}

int clean_up() {    //clean_up homes
  object *inv, *inv1;
  int i, j;

  if (!clonep() && this_object()->query("no_clean_up")) return 1;

  inv = all_inventory();
  for (i = sizeof(inv) - 1; i >= 0; i--) {
    if (userp(inv[i])) return 1;
    if (inv[i]->query("if_bed")) {  //a bed object
      inv1 = all_inventory(inv[i]);
      if (sizeof(inv1) > 0)
        for (j = sizeof(inv1) - 1; j >= 0; j--) {
          if (userp(inv1[j])) return 1;
        }
    }
  }

  destruct(this_object());
  return 0;
}

void alternative_die(object me) {
  object target;
  target = me->query_temp("last_damage_from");
  me->remove_killer(target);
  target->remove_killer(me);
  fullup(me);
}

void unconcious(object who) {
  if (who->query("kee") < 0 || who->query("sen") < 0) alternative_die(who);
  else unconcious(who);
}

void die(object who) {
  alternative_die(who);
}

void fullup(object obj) {
  if (!obj) return;
  obj->set("kee", (int)obj->query("max_kee"));
  obj->set("eff_kee", (int)obj->query("max_kee"));
  obj->set("sen", (int)obj->query("max_sen"));
  obj->set("eff_sen", (int)obj->query("max_sen"));
  obj->set("force", (int)obj->query("max_force") * 2);
  obj->set("mana", (int)obj->query("max_mana") * 2);
}

int save_room() {
  string file;

  file = this_object()->query_save_file();

  write("存档 ．．．．．\n");
  if (save()) {
    write("保存成功.\n");
    return 1;
  } else {
    write("等系统更新，房间自然会恢复原状，您尽情涂鸦吧。\n");
    return 0;
  }
}
