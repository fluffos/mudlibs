#include <ansi.h>
inherit COMBINED_ITEM;

void setup()
{}


void fullup(object me) {
  if (!me) return;
  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("sen", (int)me->query("max_sen"));
  me->set("eff_gin", (int)me->query("max_gin"));
  me->set("gin", (int)me->query("max_gin"));
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("kee", (int)me->query("max_kee"));
  me->set("mana", ((int)me->query("max_mana"))*2);
  me->set("force", ((int)me->query("max_force"))*2);
  me->set("food", ((int)me->max_food_capacity())*3);
  me->set("water", ((int)me->max_water_capacity())*3);
}


void init()
{
        add_action("do_apply", "apply");
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIY"九转还魂丹"NOR, ({"huanhun dan", "dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
             set("base_unit","颗");
        set("unit","些");
                set("long", "极为神奇的丹药，相传为太上老君所炼制，有使人起死回生的神奇功效。
                           \n当使用(apply)在濒死边缘昏迷之人身上，可使之恢复正常。\n");
                set("value", 2000);
				set("drug_type", "良药");
        }
   set_amount(1);
        setup();
}

int do_eat(string arg)
{
  object ob=this_object();
        if (!id(arg))
                return notify_fail("你要吃什么药？\n");
        else {
                fullup(this_player());
                message_vision("$N将一颗$n轻轻放入口中。$n入口即化，$N登时精神抖擞，全身充满力量。\n",this_player(),ob);
         add_amount(-1);
                return 1;
        }
}

int do_apply(string arg)
{
  object ob=this_object();
  object he;
  object me=this_player();

        if (!he=present(arg, environment(me)))
                return notify_fail("这里没这个人。\n");
        if (he==me)
                return notify_fail("自己不会随便吃就好了，还喂自己，你自恋啊?\n");

        if (he->query_temp("block_msg/all")){
                message_vision("$N撬开$n牙关，将"+HIY"九转还魂丹"NOR+"轻轻送入。\n",this_player(),he);
                he->remove_call_out("revive"); 
                he->revive(); 
                }else
                message_vision("$N将"+HIY"九转还魂丹"NOR+"轻轻送入$n口中，$n登时精神大振。\n",this_player(),he);

                fullup(this_player());
         add_amount(-1);
                return 1;
        
}
