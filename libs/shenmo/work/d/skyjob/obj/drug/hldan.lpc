#include <ansi.h>
inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}


void create() {
  set_name(HIR "火麟血丹" NOR, ({ "huolin xuedan", "dan", "xuedan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "颗");
    set("unit", "些");
    set("long", "以传说中极为罕见的火麒麟之血炼制而成，服用后可在短时间内提升自己的战斗力。\n");
    set("value", 2000);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

int do_eat(string arg) {
  object ob = this_object();
  object me = this_player();
  int attack;

  if (me->query_temp("drug_attack_up"))
    return notify_fail("你刚吃过一颗，再吃恐怕身体承受不住。\n");

  if (!id(arg))
    return notify_fail("你要吃什么？\n");


  attack = me->query_temp("apply/damage");
  if (attack < 50) attack = 50;
  me->add_temp("apply/damage", attack);
  me->set_temp("drug_attack_up", 1);

  call_out("remove_drug_attack", 60, this_player(), attack);
  message_vision("$N将$n一口咽下，一股火热的劲气顿时盈满丹田，全身力量剧增。\n", this_player(), ob);
  add_amount(-1);
  return 1;

}

void remove_drug_attack(object me, int attack) {
  if (!me) return;
  me->add_temp("apply/damage", -attack);
  me->set_temp("drug_attack_up", 0);
  message_vision("$n效力已过，$N丹田之内的火热劲气逐渐散去。\n", me, this_object());
}
