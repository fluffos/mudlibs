#include <ansi.h>
inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_sa", "sa");
}


void create() {
  set_name(HIW "显影水" NOR, ({ "xianying shui", "shui" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "瓶");
    set("unit", "些");
    set("long", "采于百花万露精制而成，泼洒(sa here)于地，可使隐身的人现出原形。\n");
    set("value", 2000);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

int do_sa(string arg) {
  object ob = this_object();
  object me = this_player();
  int i;
  object *inv;

  if (!arg)
    return notify_fail("你要洒什么？\n");
  if (arg != "here")
    return notify_fail("你要洒在哪？\n");

  inv = all_inventory(environment(me));

  message_vision("$N将$n轻轻洒向四周。\n", this_player(), ob);

  for (i = 0; i < sizeof(inv); i++) {
    //			if( inv[i]->query("env/invisibility") ) {
    if (inv[i]->query("env/invisibility") && !wizardp(inv[i])) {
      message_vision("$n再也隐藏不住自己的身行，现出了踪迹。\n", this_player(), inv[i]);
      inv[i]->set("env/invisibility", 0);
    }
  }


  add_amount(-1);
  return 1;

}
