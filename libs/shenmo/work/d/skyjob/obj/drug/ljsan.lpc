#include <ansi.h>
inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}


void create() {
  set_name(HIG "龙角散" NOR, ({ "longjiao san", "san" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "包");
    set("unit", "些");
    set("long", "以极其珍贵的蛟龙角磨制而成，服用后可在短时间内提升自己部分外功的命中率。\n");
    set("value", 2000);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

int do_eat(string arg) {
  object ob = this_object();
  object me = this_player();
  int pfm;

  if (me->query_temp("drug_pfm_up"))
    return notify_fail("你刚吃过一包，再吃恐怕身体承受不住。\n");

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  pfm = me->query_skill("force", 1) / 4 + random(me->query_skill("force", 1) / 2);
  me->add_temp("apply/pfm_success", pfm);
  me->set_temp("drug_pfm_up", 1);

  call_out("remove_drug_pfm", 60, this_player(), pfm);
  message_vision("$N吃下一包$n，全身劲气十足，气势逼人。\n", this_player(), ob);
  add_amount(-1);
  return 1;

}

void remove_drug_pfm(object me, int pfm) {
  if (!me) return;
  me->add_temp("apply/pfm_success", -pfm);
  me->set_temp("drug_pfm_up", 0);
  message_vision("$n效力已过，$N又恢复了常态。\n", me, this_object());
}
