#include <ansi.h>
inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}


void create() {
  set_name(HIB "玄龟晶丸" NOR, ({ "xuangui jingwan", "wan", "jing wan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "颗");
    set("unit", "些");
    set("long", "以传说中极为罕见的玄龟内丹精制而成，服用后可在短时间内提升自己的防御力。\n");
    set("value", 2000);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

int do_eat(string arg) {
  object ob = this_object();
  object me = this_player();
  int defend;

  if (me->query_temp("drug_defend_up"))
    return notify_fail("你刚吃过一颗，再吃恐怕身体承受不住。\n");

  if (!id(arg))
    return notify_fail("你要吃什么？\n");


  defend = me->query_temp("apply/armor") / 2;
  if (defend < 100) defend = 100;
  me->add_temp("apply/armor", defend);
  me->set_temp("drug_defend_up", 1);

  call_out("remove_drug_defend", 60, this_player(), defend);
  message_vision("$N将$n一口咽下，一股冰凉的劲气顿时满布周身。\n", this_player(), ob);
  add_amount(-1);
  return 1;

}

void remove_drug_defend(object me, int defend) {
  if (!me) return;
  me->add_temp("apply/armor", -defend);
  me->set_temp("drug_defend_up", 0);
  message_vision("$n效力已过，$N周身冰凉劲气逐渐散去。\n", me, this_object());
}
