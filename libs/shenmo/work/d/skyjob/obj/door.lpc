#include <ansi.h>

inherit ITEM;

void create() {

  set_name(HIC "封印之门" NOR, ({ "door" }));
  set_weight(20000000);
  set("value", 0);
  set("unit", "扇");
  set("long", HIC "以雄凝法力注于降妖伏魔咒所铸而成的封印之门，用于封印镇妖塔内万千妖魔。\n" NOR);
  set("value", 1000);
  set("door_kee", 100);
  set("door_max_kee", 100);
  setup();
}

void init() {
  object ob = this_object();
  if (query("hit_by") && this_object()) {
    remove_call_out("check_door");
    call_out("check_door", 1, ob);
  }

}

void check_door(object ob) {
  int kee, max_kee, k, i;
  string msg = "以雄凝法力注于降妖伏魔咒所铸而成的封印之门，用于封印镇妖塔内万千妖魔。\n" NOR;
  object door, me;
  object *inv;

  kee = query("door_kee");
  max_kee = query("door_max_kee");

  k = (int)(kee * 100 / max_kee);
  if (k == 100) msg += HIC "玄铁大门" + HIW "尚完好无损！\n" NOR;
  if (k < 100 && k > 80) msg += HIC "封印之门" + HIG "已经有些微的损伤了！！\n" NOR;
  if (k <= 80 && k > 50) msg += HIC "封印之门" + HIY "损伤颇重，情况有些不妙！！\n" NOR;
  if (k <= 50 && k > 30) msg += HIC "封印之门" + HIM "已经严重受损，看来支撑不了多久了！！\n" NOR;
  if (k <= 30 && k > 0) msg += HIC "封印之门" + HIR "即将破裂，看来是守不住了！！\n" NOR;

  set("long", msg);

  if (k <= 0) {
    inv = all_inventory(environment(ob));

    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->is_character()) { me = inv[i]; i = 100; }
    }


    remove_call_out("check_door");
    message_vision(HIC "\n封印之门" + HIB "再也支撑不住强大的冲击，“哐铛”一声，裂成数块！！\n" NOR, me);
    message_vision(HIB "众妖魔见封印之门已破，阴笑声中迅速逸去。\n" NOR, me);
    message_vision(HIB "刹那间，无数黑风从镇妖塔内猛冲而出，急急往下界窜逃而去！！\n" NOR, me);
    message_vision(HIY "\n眼看塔内妖魔即将尽数逃出，数位仙人突然现身，凭着强大的法力和神妙的符咒硬是重新凝聚出一个封印之门。\n" NOR, me);
    message_vision(HIC "在封印之门的强大威力之下，未及逃脱的妖魔又重新被封入镇妖塔内。\n" NOR, me);
    door = new("/d/skyjob/obj/door");
    door->move("/d/skyjob/tower_door");
    door->set("door_kee", 0);
    destruct(ob);
  }

  if (ob) call_out("check_door", 1, ob);

}
