#include <ansi.h>
inherit ROOM;

void fullup(object obj);
void check(object ob, object where);

void create() {
  set("short", HIB "镇妖塔口" NOR);
  set("long", HIY + @LONG 

镇妖塔乃是天庭关押妖魔的所在，亦即为天牢。凡被关押入此
塔的皆为穷凶恶极之徒，其罪恶滔天，却各具非凡本事，于下
界为恶的妖魔根本无法与之相较。其中亦关押着千年前仙魔大
战之时被擒的数大魔头。此为天庭禁地，未经许可不得入内。 
 
LONG + NOR);

  set("objects", ([
    "/d/skyjob/obj/door": 1,
  ]));

  set("exits", ([
    "south": "/u/run/workroom",
  ]));
  set("alternative_die", 1);
  setup();
}

void init() {
  add_action("do_none", "move");
}

int do_none() {
  return 1;
}

void alternative_die(object me) {
  object *t;
  object m;
  int i;
  me->set_temp("alternative_die", 1);
  if (userp(me)) {
    if (!pointerp(me->query_team())) me->die();
    else {
      t = me->query_team();

      for (i == 0; i != -1; i++) {
        if (!m = t[i]) i = -1;
        if (living(m) && present(m, environment(me)) && m != me) {
          me->set_heart_beat();
          me->unconcious();
          me->delete_temp("alternative_die");
          return;
        }
      }
      me->die();
    }
  } else me->die();
}



void fullup(object obj) {
  if (!obj) return;
  obj->set("kee", (int)obj->query("max_kee"));
  obj->set("eff_kee", (int)obj->query("max_kee"));
  obj->set("sen", (int)obj->query("max_sen"));
  obj->set("eff_sen", (int)obj->query("max_sen"));
  obj->set("force", (int)obj->query("max_force") * 2);
  obj->set("mana", (int)obj->query("max_mana") * 2);
}
