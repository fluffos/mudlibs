void setname1()
{
        int i,j,k;
	string name, *id;

	i=(random(sizeof(names1)/2))*2;
	j=(random(sizeof(names2)/2))*2;
	k=(random(sizeof(names3)/2))*2;

	name=names1[i]+names2[j]+names3[k];
	id=({names1[i+1]+names2[j+1]+" "+
	    names3[k+1], names3[k+1]});

	set_name(name,id);

	set("race", "野兽");
	if (random(2) > 0 ) {
	  set("gender", "雄性");
	} else {
	  set("gender", "雌性");
	}
}

void setname2()
{
    int i, j;
    string name, *id;
    i=(random(sizeof(names4)/2))*2;
    j=random(2);
    
    name=names4[i]+(j?"精":"怪");
    id=({names4[i+1]+" "+(j?"jing":"guai"),
	    (j?"jing":"guai")});

    set("race", "野兽");
    set("gender",(j?"雌性":"雄性"));
    set_name(name,id);
}

void check_me(object player,object yaomo)
{
    object *t;
    int i;
    object m;

    if (!player) player=yaomo->query("jober");

    if (!living(yaomo)) return;

    if(player&&pointerp(player->query_team())) t=player->query_team();

    
    if (yaomo->query_temp("time")) yaomo->add_temp("time",-1);
    else {
           command("say 看来是攻不下来了，快撤吧！\n"); 
           message_vision(HIB"$n化做一阵黑烟逃走了。。。。\n"NOR,player,yaomo);

           player->set("skyjob","success");
          
           if (t) {
              for (i==0;i!=-1;i++){                              
                                   if (!m=t[i]) i=-1;                                  
                                   if (m) m->set("skyjob","success");
                                   }
            }

           destruct(yaomo);
           return;
          }

    if (!yaomo->is_fighting()){
                                remove_call_out("break_door");
                                call_out("break_door",0,player,yaomo);
                               }


    remove_call_out("check_me");
    call_out("check_me",1,player,yaomo);
}

void break_door(object player,object yaomo)
{
  object door;
  object *t;
  int i,damage;
  object m;

  if (!player) player=yaomo->query("jober");

  door=present("door",environment(yaomo));
 
    

  if (door&&door->query("door_kee")){
                                door->set("hit_by",1);
                                if (!yaomo->is_busy() ){
                                          switch(random(2)){
                                                    case 0 : 
                                                         message_vision(HIR"\n$N聚起全身力量，猛得往$n"+HIR"撞去。\n"NOR,yaomo,door);
                                                         break;
                                                    case 1 : 
                                                         message_vision(HIR"\n$N运起全身内力，一声怒吼，猛得击向$n"+HIR"。\n"NOR,yaomo,door);
                                                         break;
                                                    case 2 :
                                                         message_vision(HIR"\n$N默念咒文，全身法力贯于指间，化做一道霹雳往$n"+HIR"击去。\n"NOR,yaomo,door);
                                                         break;
                                                           }
                                     damage=1+random(4);
                                     door->add("door_kee",-damage);
                                     yaomo->start_busy(random(3));
                                 }
                                remove_call_out("break_door");
                                call_out("break_door",2,player,yaomo);

                                }   

  if (door&&door->query("door_kee")<1)  {

           player->set("skyjob","fail");

            if (t){
              for (i==0;i!=-1;i++){                              
                                   if (!m=t[i]) i=-1;                                  
                                   if (m) m->set("skyjob","fail");
                                   }
                  }

           destruct(yaomo);
           return;
           }
                                        
}

void create()
{
        if(random(2)==0)
	    setname1();
	else
	    setname2();

	set("limbs", ({
	       "头部", "颈部", "胸口", "后心", "左肩", "右肩", "左臂",
	       "右臂", "左爪", "右爪", "腰间", "小腹", "前腿", "后腿",
	       "前爪", "后爪" }) );


  set("long", "前来攻打镇妖塔，欲放出塔内万千妖魔的入侵者。\n");
  set("attitude", "heroism");
  set("per", 40);
  set("str", 30);
