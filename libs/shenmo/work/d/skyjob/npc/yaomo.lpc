  set_skill("spells", 220);
  set_skill("dao", 220);
  set_skill("unarmed", 220);
  set_skill("yinfeng-zhua", 180);
  set_skill("dodge", 220);
  set_skill("lingfu-steps", 180);
  set_skill("parry", 220);
  set_skill("force", 220);
  set_skill("yaofa", 220);
  set_skill("huntian-qigong", 220);
  set_skill("blade", 220);
set_skill("wuhu-blade", 220);
  set_skill("sword", 220);
  set_skill("qixiu-jian", 180);
  map_skill("spells", "dao");
  map_skill("unarmed", "yinfeng-zhua");
map_skill("blade", "wuhu-blade");
  map_skill("parry", "huoyun-qiang");
  map_skill("sword", "qixiu-jian");
  map_skill("dodge", "lingfu-steps");
  map_skill("force", "huntian-qigong");

  setup();
	carry_object("/d/obj/cloth/shoupiqun")->wear();
}


void kill_ob (object ob)
{
  object yaomo = this_object();
  object yaomo2;

  yaomo2=ob->query_temp("skyjob/kill");

  if (yaomo2&&yaomo!=yaomo2&&yaomo2->query_temp("skyjob/kill")==ob)
             { 
               yaomo2->remove_killer(ob);
               ob->remove_killer(yaomo2);
               yaomo2->break_door(ob,yaomo2);
             }

  if (ob!=yaomo->query_temp("skyjob/kill",ob)&&yaomo->query_temp("skyjob/kill",ob))
               yaomo->remove_killer(yaomo->query_temp("skyjob/kill",ob));

  ob->set_temp("skyjob/kill",yaomo);
  yaomo->set_temp("skyjob/kill",ob);
  remove_call_out("break_door");
  ::kill_ob(ob);

}


void unconcious()
{
    die();
}
