inherit ROOM;

#include <ansi.h>

void create()
{
    set("outdoors", "sunrise");
    set("alternative_die", 1);

    setup(); 
}

int valid_leave(object me, string dir)
{
    object another;

    if ( !userp(me) || wizardp(me) )
    {
        return ::valid_leave(me, dir);
    }

    if ( another = present("jap badguy", this_object()) )
    {
        return notify_fail(another->name() + "哇哇怪叫着，闪身挡住了你的路。\n");
    }

    return ::valid_leave(me, dir);
}

void alternative_die(object who)
{
    object target;

    if ( !who )
    {
        return;
    }

    if ( !userp(who) )
    {
        target = who->query_temp("last_damage_from");
        who->clear_condition();
        if ( target && environment(target) == this_object() )
        {
            who->reward_ob(target);
        }
        destruct(who);
        return;                         
    }

    JAPAN_D->alternative_die(who);

    return;
}

void init()
{
    object obj = this_player();

    if ( JAPAN_D->query_sunrise_block() )
    {
        if ( userp(obj) && !wizardp(obj) && !JAPAN_D->have_join(obj) )
        {
            message_vision(HIM"$N惊惶的逃离日出城！\n"NOR, obj);
            obj->move("/d/city/kezhan", 1);
            return;
        }
    }

    add_action("do_none", "", 1);
}

int do_look(string arg)
{
    if ( arg && !wizardp(this_player()) )
    {
        tell_object(this_player(), HIR"四周围喊杀声震天，你就别东张西望了，还是赶紧战斗吧。\n"NOR);
        return 1;
    }

    return 0;
}

int do_none(string arg)
{
    string *no_cmds, *no_cast;
    object me = this_player();
    string verb = query_verb();
    object another;

    no_cmds = ({
        "gongji", "ji", "apply", "steal", "whisper", "bian", "surrender", "go", "move", "fly",
        "burn",                         //jjf
    });
    no_cast = ({
        "chuqiao",                 //all
        "yinshen",                 //bonze
        "shuidun",                 //dragon
        "huimeng",                 //moon
        "escape", "chongsheng",//emei swordman
        "townportal",              //hell
        "yin",                     //gumu
        "arrest", "drift", "taijitu",
                                  //kunlun ... so BT..
        "mysticism", "nophase",   //sanxian
        "jieti",                   //xueshan
        "tuoqiao",                 //shushan
        "bagua",                   //youxia
        "qimen", "qiankun",     //wzg
        "tudun", "huanying",    //wdd
        "zhuang",               //hyd
        "move",
    });

    if ( "look" == verb )
    {
        return do_look(arg);
    }

    if ( userp(me) && !wizardp(me) && -1 != member_array(verb, no_cmds) )
    {
        if ( another = present("jap badguy", this_object()) )
        {
            tell_object(me, another->query("name") + HIR"看起来想要杀死你！\n"NOR);
            return 1;
        }
    }

    if ( !wizardp(me) && "cast" == verb && -1 != member_array(arg, no_cast) )
    {
        if ( another = present("jap badguy", this_object()) )
        {
            tell_object(me, another->query("name") + HIR"看起来想要杀死你！\n"NOR);
            return 1;
        }
    }

    return 0;
}

