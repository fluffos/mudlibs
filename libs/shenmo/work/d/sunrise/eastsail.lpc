inherit __DIR__"room.lpc";
#include <ansi.h>;

void create()
{
    set("short", "旭日海边");
    set("long", 
    "海边，还停着一艘大船，你可以坐船（sail）去倭寇小岛。\n"
     );

    set("exits", ([
        "west"  : __DIR__"eastgate2",
    ]));

    set("coor/x",170);
    set("coor/y",-240);
    set("coor/z",-30);

    ::create();
}

void init()
{
    add_action("do_sail", "sail");
} 

int do_sail(string arg)
{
    object me, room;

    me = this_player();

    if ( me->query("combat_exp") < 100000000 )
    {
        return notify_fail("你本事还不够，太危险了？\n");
    }

    if ( me->query("combat_exp") > 1950000000 )
    {
        return notify_fail("倭寇首领：英雄，直接去倭国吧，怎么非要和小人过不去？\n");
    }

    if ( JAPAN_D->have_join(me) || JAPAN_D->in_war() )
    {
        return notify_fail(HIR"日出城战事正急，少了你不行啊！\n"NOR);
    }

    room = find_object("/d/maze/japisland/island");

    if ( !objectp(room) )
    {
        room = load_object("/d/maze/japisland/island");
    }

    message_vision("$N坐上大船，向倭寇小岛出发了。\n", me);

    me->move(room);

    message_vision("$N坐船来到了倭寇小岛。\n", me);

    return 1;
} 

