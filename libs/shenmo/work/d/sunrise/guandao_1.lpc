#include <room.h>
inherit __DIR__ "room.lpc";

void create() {
  set("short", "大官道");
  set("long", @LONG
你走在一条尘土飞扬的大官道上。不时有两三骑快马从身
边飞驰而过，扬起一路尘埃。道路两旁是整整齐齐的杨树林。
LONG);

  set("exits", ([
    "east": __DIR__ "westgate2",
    "north": __DIR__ "guandao_2",
  ]));

  set("coor/x", 60);
  set("coor/y", -240);
  set("coor/z", -30);

  set("no_magic", 1);
  set("no_fight", 1);

  ::create();
}
