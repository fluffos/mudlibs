inherit __DIR__"room.lpc";

void create()
{
    set("short", "日出客栈");
    set("long", @LONG
这是一家对江湖人士来说很有名气的客栈。人们到日出城来
一般都住在这里，一是便宜，二能听到江湖上的许多事情。近
年来，日出城退敌数十次，南来北往的人们经过日出城更是打尖在
这儿，顺便拜访一下明月等英雄。
LONG );

    set("no_clean_up", 0);

    set("exits", ([
        "southwest" : __DIR__"westroad1",
    ]));

    set("coor/x",100);
    set("coor/y",-220);
    set("coor/z",-30);

    ::create();
}

