inherit __DIR__ "room.lpc";
#include <ansi.h>;

void create() {
  set("short", "明月外门");
  set("long",
    "这里是日出城的北城门，只见城门上方是三个大字。" HIC "

                    明  月  门
\n" NOR
    "近年来倭寇屡次侵犯日出城，故这儿把守相当严密，一些官兵
们正在盘查要离日出城的人。两边是很大的草地。\n"
  );

  set("exits", ([
    "south": __DIR__ "northgate1",
    "north": __DIR__ "caodi3",
    "east": __DIR__ "caodi1",
    "west": __DIR__ "caodi2",
  ]));

  set("coor/x", 110);
  set("coor/y", -180);
  set("coor/z", -30);

  ::create();
}
