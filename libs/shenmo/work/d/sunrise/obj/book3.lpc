// literate.c
#include <ansi.h>
inherit ITEM;
void destroy();
void init();
void init()
{
add_action("do_du", "du");
        add_action("do_du", "study");
add_action("do_du", "read");

  if (!wizardp(this_player())) {
           set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
  }                                    
    call_out("destroy", 72000);
}

//int query_autoload() { return 1; }
void destroy()
{
object me=this_player();
message_vision(HBRED"\n天界忽然传来一阵怒吼：还我神书！！\n\n"HIG+this_object()->name()+HBRED"直飞天际，消失在"+HIG+this_player()->name()+HBRED"的眼前。\n\n"NOR,me);
  destruct(this_object());
}



void create()
{
	int i;
        set_name(HIB"忍"HIR"血"HIW"妖"HIM"屠"NOR, ({"book_yt"}));
        set_weight(500);
            
		set("long","一本天地气运而生的神修秘籍。\n");
                           set("unit", "本");
		set("value", 0);
             set("no_get",1);
             set("no_sell",1);
             set("no_put",1);
            set("no_give",1);
        	set("material", "paper");
                       set("skill", ([
                        "name":"ittouryu",
                        "sen_cost": 10,   
                        "difficulty": 5, 
                        "max_skill": 500,
                 ]) ); 
             
}

//int query_autoload(){ return 1;}


int do_du(string arg)
{
        object me = this_player();
        object where = environment(me);
        object ob;
        mapping skill;
        int pxlevel; 
	int neili_lost;

	if (!(arg == "book_yt"))
	return 0;

        if (this_object()->query("owner")!=me)
{
                write("秘籍有缘人得之,有缘人读之。\n");
                return 1;
        }

  if(!arg || !objectp(ob = present(arg, me)) ){
                write("你要读什么？\n");
                return 1;
        }



  //   me->improve_skill("pixie-jian", (int)me->query_skill("literate", 1)*300+1);
    //    write("你研读《葵花宝典》，颇有心得。\n");
        return 1;
}




