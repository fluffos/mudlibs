inherit ITEM;
#include <ansi.h>

void create()
{
    set_name("城门", ({ "city gate" }) );
    set_weight(1);
    set("no_get", 1);
    set("no_reset", 1);
    set("dur", 10);
    if ( clonep() )
    {
        set_default_object(__FILE__);
    }
    else
    {
        set("unit", "块");
        set("long", "巨大的城门，好像是铁铸的。\n");
        set("value", 60);
    }
} 

void init()
{
    add_action("do_hit", "hit");
    add_action("do_repair", "repair");
}

int do_hit(string arg)
{ 
    object me;
    object *inv;
    object obj;

    me = this_player();

    if ( !arg || arg != "city gate" )
    {
        tell_object(me, "你要打什么?\n");
        return 1;
    }

    if ( me->is_busy() )
    {
        tell_object(me, "你慌什么?\n");
        return 1;
    }

    inv = all_inventory(environment());
    foreach ( obj in inv )
    {
        if ( obj->is_character() && obj->query("sunrise_guard") )
        {
            obj->kill_ob(me);
        }
    }

    if ( me->is_fighting() )
    {
        tell_object(me, "你还是先杀了守城士兵再说吧。\n");
        return 1;
    }

    message_vision(HIR"$N正在破坏城门！！！\n"NOR, me);
    me->start_busy(random(3));

    add("dur", -1);
    if ( query("dur") > 0 )
    {
        return 1;
    }

    message_vision(HIY"城门终于不堪$N的打击，轰然崩塌。\n"NOR, me);
    JAPAN_D->war_message(HIR"倭寇攻破日出城" + environment(me)->query("short") + "!!!"NOR);

    JAPAN_D->add_door_broken();

    destruct(this_object());

    return 1;
}

int do_repair(string arg)
{ 
    object me;

    me = this_player();

    if ( !arg || arg != "city gate" )
    {
        tell_object(me, "你要修什么?\n");
        return 1;
    }

    if ( me->is_busy() )
    {
        tell_object(me, "你慌什么?\n");
        return 1;
    }

    if ( me->query("max_force") < 50 && me->query("max_mana") < 50 )
    {
        tell_object(me, "你凭什么?\n");
        return 1;
    }

    message_vision(HIR"$N正在修补城门！！！\n"NOR, me);

    add("dur", 1);

    if ( me->query("max_force") >= 50 && me->query("max_mana") >= 50 )
    {
        if ( random(2) )
        {
            me->add("max_force", -50);
        }
        else
        {
            me->add("max_mana", -50);
        }
    }
    else if ( me->query("max_force") >= 50 )
    {
        me->add("max_force", -50);
    }
    else
    {
        me->add("max_mana", -50);
    }

    message_vision(HIY"城门发出耀目光芒，变得更加坚固了。\n"NOR, me);

    return 1;
}

