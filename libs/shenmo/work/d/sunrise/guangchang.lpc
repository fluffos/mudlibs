#include <ansi.h>

inherit __DIR__"room.lpc";

void create()
{
    set("short", "中央广场");
    set("long", @LONG
这里是日出城的中央广场，铺着青石地面。东面通向青龙门，
西面通向白虎门，南面直达朱雀门，远远地你可看到北面是
安抚使衙门。近年来倭寇大军屡次攻打日出城，官府为防止倭寇
奸细混杂进来，已经不允许人们在此聚集。只见一队官兵在
此往来巡逻，你还是快离开吧。
LONG );

    set("exits", ([
        "east"  : __DIR__"eastjie1",
        "west"  : __DIR__"westjie1",
        "south" : __DIR__"southjie1",
        "north" : __DIR__"anfupailou",
    ]));

    set("coor/x",120);
    set("coor/y",-240);
    set("coor/z",-30);

    ::create();
}

