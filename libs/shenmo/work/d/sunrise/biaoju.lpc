inherit __DIR__ "room.lpc";

void create() {
  set("short", "福威镖局");
  set("long", @LONG
你来到一座结构宏伟的建筑前，左右石坛上各插着一根两
丈多高的旗杆，杆上青旗飘扬。右首旗子用金线绣着一头张牙
舞爪的狮子，狮子上头有一只蝙蝠飞翔。左首旗子上写着“福威
镖局”四个黑字，银钩铁划，刚劲非凡。入口排着两条长凳，
几名镖头坐着把守。
LONG);

  set("exits", ([
    "southeast": __DIR__ "eastroad1",
  ]));

  set("coor/x", 120);
  set("coor/y", -220);
  set("coor/z", -30);

  ::create();
}
