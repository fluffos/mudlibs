#include <room.h>
#include <ansi.h>
inherit __DIR__ "room.lpc";

void create() {
  set("short", "山路");
  set("long", @LONG
走在山路上，只听四下群鸟争鸣，前方群山耸立。令人心
旷神怡。
LONG);

  set("exits", ([
    "northwest": "/d/city/kezhan",
    "southeast": __DIR__ "shulin",
  ]));

  set("coor/x", 50);
  set("coor/y", -200);
  set("coor/z", -30);

  ::create();
}

int valid_leave(object me, string dir) {
  if (dir == "northwest" || dir == "nw") {
    if (JAPAN_D->have_join(me) || JAPAN_D->in_war()) {
      tell_object(me, HIR "日出城战事正急，少了你不行啊！\n" NOR);
      return 1;
    }
  }

  return 1;
}
