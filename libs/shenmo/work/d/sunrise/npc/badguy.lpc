//战斗类npc
//奖励莲花合并低中高，莲花升级石中高低，装备，猕猴桃
//取经，秦岭，都可以看下
//这里你可以搞成，如果怪对其他人下kill命令，也就是脱离战斗，然后又进入战斗和别人打，就给他full状态
//如果打到一半，对手跑了，又来一个，又对他kill,这个时候怪血不是满的，杀了可能没经验，这样，可以先让怪kill的时候，给他满血满状态
//这样，一旦开始战斗，除了倭寇主动kill的人，其他的人无法对倭寇造成伤害
//也可以搞成，玩家对怪kill,没实际作用，具体就是按照怪流程来办

/*
没必要按照上面那样设置
攻城战，本身就是群战，大家靠运气，群杀，杀的越多奖励越高，怪的等级有一定生成算法，并不固定
每个档次的玩家都有对手
攻城战怪不回血，玩家不会真死，磨也能磨死
*/

inherit NPC;

#include <ansi.h>
#include <family.h>

void create() {
  mapping name = NAME_D->random_name("japan");
  set_name(name["name"], ({ "jap badguy", "badguy" }) + name["id"]);
  set("title", name["title"]);
  set_living_name("jap badguy");
  set("last_move", time());
  set("my_path", ({}));
  set("my_pos", -1);
  set("wokou", 1);
  set("任务", 1);
  set("attitude", "aggressive");
  setup();
}

varargs int random_family(object npc, int lvl, string fam) {
  int i, k;
  int maxskill;
  string *fams, *skills, cls;
  mapping data;
  object weapon;
  int power;
  int exp;

  if (!npc) {
    return 0;
  }

  if (!lvl) {
    lvl = 1 + random(9);
  }

  npc->set("zhuanshi", random(5));

  power = JAPAN_D->get_power(lvl);

  //防溢出
  exp = random(power / 2);
  if (2000000000 - exp <= power) {
    npc->set("combat_exp", 2000000000);
  } else {
    npc->set("combat_exp", power + exp);
  }
  npc->set("daoxing", npc->query("combat_exp"));

  npc->set("level", 100 + random(2000) + lvl * 10);

  maxskill = 100;
  //以100级为步长，找到最合适的技能等级
  while (maxskill / 10 * maxskill / 10 * maxskill / 10 < (int)npc->query("combat_exp") / 100 * ((int)npc->query("zhuanshi") + 1)) {
    maxskill += 100;
    reset_eval_cost();
  }

  npc->set("str", 40 + lvl);
  npc->set("con", 40 + lvl);
  npc->set("int", 40 + lvl);
  npc->set("spi", 40 + lvl);
  npc->set("per", 40 + lvl);
  npc->set("kar", 40 + lvl);
  npc->set("cps", 40 + lvl);
  npc->set("cor", 40 + lvl);

  fams = keys(familys);
  if (!fam || -1 == member_array(fam, fams)) {
    fam = fams[random(sizeof(fams))];       //取得门派
  }

  data = familys[fam];

  cls = data["class"];

  weapon = new(data["weapon"]);
  if (!weapon) {
    message("channel:sys", sprintf(YEL "┣" WHT " 系统" YEL " ┫" WHT "圣斗士地层(Sdsd.c)：%s 文件调用随机门派时，%s门派武器文件不存在或出错。\n" NOR,
      base_name(npc), fam),
      users());
    return 0;
  }

  skills = data["skills"];
  for (i = 0; i < sizeof(skills) / 2; i++) {
    k = i * 2;
    npc->set_skill(skills[k], maxskill);
    npc->set_skill(skills[k + 1], maxskill);
    npc->map_skill(skills[k], skills[k + 1]);
  }

  npc->set_skill("literate", maxskill);
  npc->set_skill("medical", maxskill);
  npc->map_skill("literate", "medical");

  npc->set("max_force", npc->query_skill("force") * 10);
  npc->set("max_mana", npc->query_skill("spells") * 10);

  if ("月宫" != fam) {
    npc->set("force_factor", npc->query_skill("force") / 3);
    npc->set("mana_factor", npc->query_skill("spells") / 3);
  } else {
    npc->set("force_factor", npc->query("max_force") * 3 / 80);
    npc->set("mana_factor", npc->query("max_mana") * 3 / 80);
  }

  CHAR_D->setup_char(npc);

  npc->set("max_kee", npc->query("max_kee") * 10);
  npc->set("max_sen", npc->query("max_sen") * 10);

  npc->set_temp("apply/damage", 1000 + 1000 / 10 * lvl);
  npc->set_temp("apply/armor", 2000 + 2000 / 10 * lvl);

  npc->set("class", cls);
  npc->set("weapon_file", data["weapon"]);
  npc->set("family/family_name", fam);

  if (objectp(npc->query_temp("weapon"))) {
    npc->query_temp("weapon")->unequip();
    destruct(npc->query_temp("weapon"));
  }

  weapon->move(npc);
  npc->command("wield all");

  SDS_D->powerup(npc);

  return 1;
}

int invocation(int level) {
  if (!level) {
    level = 1 + random(9);
  }

  set("guai_level", level);

  if (!random_family(this_object(), level)) {
    return 0;
  }

  return 1;
}

void init() {
  object target;

  if (!query_heart_beat(this_object())) {
    set_heart_beat(1);
  }

  if (environment() && !environment()->query("no_fight")) {
    target = this_player();

    if (target->is_character() && !target->query("wokou") && !wizardp(target)) {
      kill_ob(target);
    }
  }
}

void set_gopath(string *path) {
  set("my_path", path);
  set("my_pos", -1);
}

void perform_first() {
  //我先出招
  string str;

  if (objectp(query_temp("weapon"))) {
    str = query_temp("weapon")->query("skill_type");
  } else {
    str = "unarmed";
  }

  if (random(5) == 0) {
    SDS_D->randomPfm(this_object(), str);
  }
}

void kill_ob(object target) {
  if (!target->query("wokou")) {
    ::kill_ob(target);
  }
}

void auto_kill() {
  object *inv;
  object target;

  if (environment() && !environment()->query("no_fight")) {
    inv = all_inventory(environment());

    foreach (target in inv) {
      if (target->is_character() && !target->query("wokou") && !wizardp(target)) {
        kill_ob(target);
        perform_first();
        break;
      }
    }
  }
}

void random_move() {
  mapping exits;
  string dir;
  string *dirs;
  int i;
  object me = this_object();
  object env = environment(me);
  object room;
  int path_len = sizeof(query("my_path"));

  if (!env) {
    return;
  }

  if (time() < 5 + random(5) + me->query("last_move")) {
    return;
  }

  if (!living(me) || me->is_fighting()
    || me->is_busy() || me->query_temp("no_move")
    || !mapp(exits = env->query("exits")) || !sizeof(exits)) {
    return;
  }

  if (0 < path_len) {
    if (query("my_pos") < path_len - 1) {
      set("my_pos", query("my_pos") + 1);

      if (!(room = find_object(query("my_path")[query("my_pos")]))) {
        room = load_object(query("my_path")[query("my_pos")]);
      }

      if (room) {
        me->move(room);
        me->set("last_move", time());
        message_vision("$N杀了过来。\n", me);
        auto_kill();

        return;
      }
    }
  }

  dirs = keys(exits);
  for (i = 0; i < 12; i++) {
    dir = dirs[random(sizeof(dirs))];

    if (!exits[dir] ||
      exits[dir]->query("no_fight") ||
      exits[dir]->query("no_magic")) {
      continue;
    }

    command("go " + dir);
    me->set("last_move", time());
    auto_kill();
    break;
  }
}

void heart_beat() {
  string skill;
  object weapon, armor;
  object me = this_object();
  int gate = 0;

  ::heart_beat();

  if (!living(me)) {
    return;
  }

  if (!objectp(query_temp("armor/armor"))) {
    armor = new("/d/city/npc/obj/armor");
    armor->set("armor_prop/armor", 2000);
    armor->move(this_object());
    command("wear all");
  }

  if (!objectp(query_temp("weapon")) && random(5) && query("weapon_file")) {
    weapon = new(query("weapon_file"));
    if (weapon) {
      weapon->move(me);
      command("wield all");
    }
  }

  if (environment(me) && present("city gate", environment(me))) {
    command("hit city gate");
    gate = 1;
  }

  if (!me->is_fighting()) {
    if (0 == gate) {
      random_move();
    }
    return;
  }

  if (objectp(weapon = me->query_temp("weapon"))) {
    skill = weapon->query("skill_type");
  } else {
    skill = "unarmed";
  }

  switch (random(10)) {
    case 0:
    case 1:
    case 9:
    case 8:
    case 2:
      SDS_D->randomPfm(me, skill);
      break;
    case 3:
    case 7:
    case 6:
      SDS_D->randomCast(me);
      break;
    default:
      SDS_D->randomExert(me);
      break;
  }
}

void special_reward(object who) {
  object item;

  if (random(80 - query("guai_level")) >= 10)  // && !wizardp(who) )
  {
    return;
  }

  JAPAN_D->war_message(who->query("name") + HIR + "灭杀了侵略中原的倭寇" + NOR + query("name") + HIR "，不愧是我中华英豪。");

  if (random(100) > 50) {
    //一半概率掉装备
    switch (random(6)) {
      case 0:
        item = new("/d/eastway/qinling/obj/armor/qinglong");
        tell_object(who, HIC "你感觉一件青色的物事落在了你的身上。\n" NOR);
        message(
          "channel:rumor",
          YEL + "\n【" + HIW " 神兽降世 " NOR + YEL "】某人：" + who->query("name") + "拿到" + HIC "青龙宝带" NOR + YEL "了！\n\n" + NOR,
          users()
        );
        break;

      case 1:
        item = new("/d/eastway/qinling/obj/armor/zhuque");
        tell_object(who, HIR "你感觉一件红色的物事落在了你的身上。\n" NOR);
        message(
          "channel:rumor",
          YEL + "\n【" + HIW " 神兽降世 " NOR + YEL "】某人：" + who->query("name") + "拿到" + HIR "凤凰羽衣" NOR + YEL "了！\n\n" + NOR,
          users()
        );
        break;

      case 2:
        item = new("/d/eastway/qinling/obj/armor/xuanwu");
        tell_object(who, HIB "你感觉一件黑色的物事落在了你的身上。\n" NOR);
        message(
          "channel:rumor",
          YEL + "\n【" + HIW " 神兽降世 " NOR + YEL "】某人：" + who->query("name") + "拿到" + HIB "玄武神甲" NOR + YEL "了！\n\n" + NOR,
          users()
        );
        break;

      case 3:
        item = new("/d/eastway/qinling/obj/armor/qilin");
        tell_object(who, HIY "你感觉一件金色的物事落在了你的身上。\n" NOR);
        message(
          "channel:rumor",
          YEL + "\n【" + HIW " 神兽降世 " NOR + YEL "】某人：" + who->query("name") + "拿到" + HIY "青龙宝带" NOR + YEL "了！\n\n" + NOR,
          users()
        );
        break;

      case 4:
        item = new("/d/eastway/qinling/obj/armor/baihu");
        tell_object(who, HIW "你感觉一件白色的物事落在了你的身上。\n" NOR);
        message(
          "channel:rumor",
          YEL + "\n【" + HIW " 神兽降世 " NOR + YEL "】某人：" + who->query("name") + "拿到" + HIW "白虎战袍" NOR + YEL "了！\n\n" + NOR,
          users()
        );
        break;

      default:
        tell_object(who, HIW "只见一道五色光芒，冉冉升向天际... ... \n" NOR);
        break;
    }

    if (item) {
      item->move(who);
    }
    return;
  }

  return;
  if (random(100)) {
    return;
  }

  if (random(10)) {
    if (random(18)) {
      if (random(3)) {
        item = new("/d/nanhai/obj/lianhua/hebing");
      } else {
        switch (random(6)) {
          case 0:
            item = new("/d/nanhai/obj/lianhua/lhshenji");
            break;
          case 1:
            item = new("/d/nanhai/obj/lianhua/lhshenjim");
            break;
          case 2:
            item = new("/d/nanhai/obj/lianhua/lhshenjil");
            break;
          case 3:
            item = new("/d/nanhai/obj/lianhua/lhconvert");
            break;
          default:
            item = new("/obj/money/jinbi");
            break;
        }
      }
    } else {
      item = new("/d/nanhai/obj/lianhua/hebingl");
    }
  } else {
    item = new("/d/nanhai/obj/lianhua/shengji");
  }

  if (item && item->move(who)) {
    message("channel:rumor", HIC "【" HIG "众生界" HIC "】" NOR +
      sprintf(HIC "%s" HIC "：%s(%s)" HIC "走着瞧，这块%s" HIC "刚到手，还没捂热乎呢！\n" NOR,
        query("name"),
        who->query("name"), capitalize(who->query("id")),
        HIC + SDS_D->no_color_msg(item->short()) + NOR), users());
  }
}

varargs void reward_ob(object who) {
  object me = this_object();
  object box, item;

  if (!who) {
    who = query_temp("last_damage_from");
  }

  message_vision(HIW "$N叫道：八格！八格呀噜！\n" NOR, me);
  message_vision("$N死了。\n", me);

  if (who && environment(who) == environment()) {
    //敌人存在
    me->remove_killer(who);
    who->remove_killer(me);
    who->add_temp("sunrise/killed/" + me->query("wokou_type"), 1);

    tell_object(who, HIY "你杀掉了一名" + JAPAN_D->get_wokouname(me->query("wokou_type")) + "！\n" NOR);

    box = new(__DIR__ "obj/baoxiang");
    if (box) {
      box->move(who);
      tell_object(who, "你得到了宝盒一个。\n");
    }

    special_reward(who);
  }

  destruct(me);
}

void die() {
  reward_ob(query_temp("last_damage_from"));
}

void unconcious() {
  die();
}
