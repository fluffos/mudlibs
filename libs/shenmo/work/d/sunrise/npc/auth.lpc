#define MAX_HUIFU   300

int do_enter(string arg);
void confirm_again(object who);

int do_huifu(string arg) {
  object me = this_player();

  if (MAX_HUIFU < me->query_temp("sunrise/huifu")) {
    tell_object(me, "想利用bug?\n");
    return 1;
  }

  if (!arg || "" == arg) {
    tell_object(me, "回答错误。\n");
    return 1;
  }

  if (arg != me->query_temp("sunrise/answer")) {
    if (MAX_HUIFU <= me->query_temp("sunrise/huifu")) {
      me->set_temp("sunrise/huifu", MAX_HUIFU + 1);
      me->delete_temp("sunrise/answer");
      tell_object(me, "连续回答错误，真可惜!\n");
      return 1;
    } else {
      confirm_again(me);
      return 1;
    }
  }

  me->set_temp("sunrise/huifu", 0);
  me->delete_temp("sunrise/answer");
  tell_object(me, "回答正确!\n");
  me->set_temp("sunrise/valid", 1);

  return 1;
}

void confirm_again(object who) {
  mapping result;

  result = "/adm/daemons/text2pic_d"->random_chinese(4);

  who->set_temp("sunrise/answer", result["rand_str"]);
  who->add_temp("sunrise/huifu", 1);

  tell_object(who, "请huifu输入以下汉字、数字、或运算结果，注意小数位直接舍去。\n");
  tell_object(who, result["output"] + "\n");
  add_action("do_huifu", "huifu");
}
