// spear.c
#include <weapon.h>
#include <ansi.h>
inherit SPEAR;
void create() {
  set_name(HIY "日出东方" NOR, ({ "spear" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是日出城的三大名器之一的圣枪：日出东方。");
    set("value", 18000000);
    set("no_sell", 1);
    set("no_get", 1);
    set("material", "steel");
    set("wield_msg", "$N把$n紧紧地握在手中。\n");
    set("unwield_msg", "$N松开了手中的$n。\n");
  }
  ::init_spear(1500);
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int dam;
  dam = (int)victim->query("max_sen");
  victim->receive_damage("sen", random(dam / 500), me);
  return HIY "日出东方的枪尖发出耀眼的光芒，刺痛了$n的眼睛。\n" NOR;
}
