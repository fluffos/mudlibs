#include <weapon.h>
#include <ansi.h>
inherit STAFF;
void create() {
  set_name(YEL "轮" RED "回" HIW "佛陀" MAG "禅杖" NOR, ({ "staff" }));
  set_weight(100000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "这是一条佛门精心打造的禅杖，份量大约有百来斤左右。\n");
    set("value", 5000000);
    set("no_sell", 1);
    //set("no_get",1);
    set("material", "iron");
    set("wield_msg", "$N「唰」地一声抽出一条$n紧握在手中。\n");
    set("unwield_msg", "$N收回手中的$n。\n");
  }
  ::init_staff(1600);
}
