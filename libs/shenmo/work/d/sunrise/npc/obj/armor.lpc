// jinjia.c 金甲
#include <armor.h>
#include <ansi.h>
inherit ARMOR;

void create()
{
        set_name(HIY"金环"HIM"锁子"HIW"甲"NOR, ({"golden armor","jinjia", "jia", "armor"}));
        set_weight(30000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
		set("long", "一件金线织就的宝甲．\n");
                set("material", "steel");
                set("value", 10000000);
set("no_sell",1);
//set("no_get",1);
                set("armor_prop/armor", 10060);
				//set("no_sell",1);
				set("no_drop","去垃圾堆丢吧，乱扔会污染环境!\n");
				set("no_give","总管发的装备，可不能乱送人哟！\n");
				//set("no_get","想拿总管按时地方发的装备？做梦吧!\n");
				set("armor_prop/dodge", 125);
        }
        setup();
}


int query_autoload() { return 1; }
