#include <weapon.h>
#include <ansi.h>
inherit MACE;
void create() {
  set_name(HIC "日出巨鞭" NOR, ({ "mace" }));
  set_weight(60000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 5000000);
    set("no_sell", 1);
    //set("no_get",1);
    set("material", "iron");
    set("long", "这是日出城打造的巨鞭，份量大约二十来斤重。\n");
    set("wield_msg", "$N从背后抽出$n，试了试重量，然後握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }
  ::init_mace(1600);
}
