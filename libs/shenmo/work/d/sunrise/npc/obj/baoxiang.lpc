#include <ansi.h>
inherit ITEM;

#define MAX_GIFT_TYPE   20

mapping my_gift = 
([
    0: (["/d/city/obj/mihoutao": 1]),
    1: (["/d/obj/drug/jiedu": 1]),
    2: (["/d/city/obj/xieyao": 1]),
    3: (["/d/obj/drug/yanlei": 1]),
    4: (["/d/obj/drug/xianjiu": 1]),
    5: (["/d/obj/drug/xiantao": 1]),
    6: (["/d/obj/drug/jinchuang": 10 + random(30)]),
    7: (["/d/obj/drug/jinchuang": 10 + random(30)]),
    8: (["/d/obj/drug/hunyuandan": 10 + random(30)]),
    9: (["/d/obj/drug/hunyuandan": 10 + random(30)]),
    11: (["/d/9sky/guzhanchang/obj/diamond": 1]),
]);

void create()
{
    set_name(HIY"宝箱"NOR, ({ "box" }) );
    set_weight(500);
    set_max_encumbrance(8000);
    set_max_items(5);
    if ( clonep() )
    {
        set_default_object(__FILE__);
    }
    else
    {
        set("unit", "个");
        set("long", "这是一个宝箱，打开可能会有惊喜哦。\n");
        set("value", 0);
    }
}

void init()
{
    add_action("do_open","open");
}

int do_open(string arg)
{
    int type;
    string obj_file;
    int obj_amount;
    object ob, me = this_player();
    
    if ( !arg || !id(arg) )
    {
        return 0;
    }
    
    if ( me->is_busy() )
    {
        write("你现在正忙着呢。\n");
        return 1;
    }       

    me->start_busy(1);

    type = random(MAX_GIFT_TYPE);

    if ( type >= sizeof(my_gift) )
    {
        write("你什么也没有得到。\n");
        destruct(this_object());
        return 1;
    }

    obj_file = keys(my_gift[type])[0];
    obj_amount = my_gift[type][obj_file];

    ob = new(obj_file);

    if ( ob )
    {
        if ( 1 < obj_amount )
        {
            ob->set_amount(obj_amount);
        }

        if ( ob->move(me) )
        {
            write("你得到了" + ob->short() + "。\n");
        }
        else
        {
            destruct(ob);
        }
    }               

    destruct(this_object());
    return 1;
}

