#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create() {
  set_name(HIR "日出巨剑" NOR, ({ "sword" }));
  set_weight(50000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把日出城打造的长剑，份量大约有十来斤左右。\n");
    set("value", 5000000);
    set("no_sell", 1);
    //set("no_get",1);
    set("material", "iron");
    set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
  }
  ::init_sword(1600);
}
