#include <weapon.h>
#include <ansi.h>
inherit BLADE;
void create() {
  set_name(HIY "日出大刀" NOR, ({ "blade" }));
  set_weight(50000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 5000000);
    set("no_sell", 1);
    //set("no_get",1);
    set("material", "iron");
    set("long", "这是日出城打造的大刀，份量大约十来斤重。\n");
    set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
  }
  ::init_blade(1600);
}
