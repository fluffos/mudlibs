#include <weapon.h>
#include <ansi.h>
inherit STICK;
void create() {
  set_name(HIM "莫" HIW "野" HIY "齐天" HIG "棍" NOR, ({ "stick" }));
  set_weight(100000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一条日出城打造的长棍，份量大约有百来斤左右。\n");
    set("value", 5000000);
    set("no_sell", 1);
    //set("no_get",1);
    set("material", "iron");
    set("wield_msg", "$N「唰」地一声抽出一条$n紧握在手中。\n");
    set("unwield_msg", "$N收回手中的$n。\n");
  }
  ::init_stick(1600);
}
