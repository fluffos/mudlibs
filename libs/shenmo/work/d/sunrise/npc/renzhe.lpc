#include <ansi.h>
inherit __DIR__"badguy.lpc";

void create()
{
    string *name= ({"蒙面忍者", "黑衣忍者","白衣忍者"});

    ::create();

    set("title", HIG + name[random(sizeof(name))] + NOR); 
    set("long","
来自东瀛的强盗，他们烧杀抢掠，无恶不作。在日出城东边的小岛上有他们
的营地，是进攻日出城的基地。\n");
    set("attitude", "aggressive");
    set("wokou_type", "renzhe");
}

varargs int invocation(object who, int level)
{
    if ( !level )
    {
        level = 3;
    }

    return ::invocation(who, level);
}

