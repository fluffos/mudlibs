#include <ansi.h>

inherit __DIR__ "guard.lpc";

void create() {
  set_name("斩将校尉", ({ "pikeman", "bing" }));
  set("title", HIW "旭日营" NOR);
  set("long", "
这是日出城明月营的斧兵，虽然和许多武林人物比起来，他们的
武功实在平常，但他们是有组织、有纪律的战士，谁也不轻易地招惹他们。\n"
    "你最好也不要招惹他们。 \n");
  set("attitude", "heroism");

  set("family/family_name", "火云洞");

  ::create();
  setup();
}

void invocation(int power) {
  ::invocation(power, query("family/family_name"));
}
