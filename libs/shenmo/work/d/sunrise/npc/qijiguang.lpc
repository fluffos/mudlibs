inherit NPC;

#include <ansi.h>
#include "auth.lpc"

int defense();  
int give_reward();

void create()
{
    set_name("戚继光", ({ "qi jiguang"}) );

    set("nickname", RED"一年三百六十日，多是横戈马上行"NOR);
    set("gender", "男性" );
    set("class","human");
    set("age", 44); 

    set("level", 600 + random(200));

    set("任务", 1);

    set("str", 12260);
    set("cor", 12600);
    set("cps", 12230);
    set("per", 12260);
    set("con", 12260);
    set("int", 12230);
    set("spi", 12240);

    set("attitude", "friendly");

    set("max_force", 20000000);
    set("force", 40000000);
    set("force_factor", 1500);

    set("max_mana", 20000000);
    set("mana", 40000000);
    set("mana_factor", 1500);

    set("title", HIW"抗倭名将"NOR);              
    set("long",
"
戚继光乃山东蓬莱人，号南塘，晚号孟诸。出生将门，自小立志疆场，
保国卫民，曾挥笔写下“封侯非我意，但愿海波平”的名句。十七岁
袭父职任登州卫指挥佥事 。二十五岁被提升为署都指挥佥事，负责
沿海防御倭寇，取得了令人瞩目的成绩。现在是南方军事重镇日出城
的统帅。
\n"
        );

    set("combat_exp", 1900000000);
    set("daoxing", 1900000000);

    set("max_kee", 19000000);
    set("eff_kee", query("max_kee"));
    set("kee", query("eff_kee"));

    set("max_sen", 19000000);
    set("eff_sen", query("max_sen"));
    set("sen", query("eff_sen"));

    set("zhuanshi", 30);

    set("family/family_name", "将军府");

    set_skill("literate", 35000);
    set_skill("unarmed", 35000);
    set_skill("talk", 35000);
    set_skill("archery", 35000);
    set_skill("force", 35000);
    set_skill("lengquan-force", 35000);
    set_skill("axe", 35000);
    set_skill("dodge", 35000);
    set_skill("parry", 35000);
    set_skill("sanban-axe", 35000);
    set_skill("bawang-qiang", 35000);
    set_skill("spells", 35000);
    set_skill("baguazhou", 35000);
    set_skill("spear", 35000);
    set_skill("mace", 35000);
    set_skill("yanxing-steps", 35000);
    set_skill("wusi-mace", 35000);
    set_skill("jinglei-mace", 35000);
    set_skill("changquan", 35000);

    map_skill("force", "lengquan-force");
    map_skill("spells", "baguazhou");
    map_skill("axe", "sanban-axe");
    map_skill("parry", "sanban-axe");
    map_skill("spear", "bawang-qiang");
    map_skill("dodge", "yanxing-steps");
    map_skill("mace", "jinglei-mace");
    map_skill("unarmed", "changquan");

    set_temp("apply/attack", 50000);
    set_temp("apply/dodge", 50000);
    set_temp("apply/parry", 50000);
    set_temp("apply/armor", 60000); 
    set_temp("apply/damage", 90000);

    set("last_pfm", time());
    set("dietimes", 0);

    set("inquiry",  ([
        "守城": (: defense :),
        "defense": (: defense :),
        "军功": (: give_reward :),  
        "reward": (: give_reward :),  
    ]) );

    setup();

    carry_object(__DIR__"obj/axe")->wield();
    carry_object(__DIR__"obj/armor")->wear();
    carry_object(__DIR__"obj/spear")->wield();
    carry_object(__DIR__"obj/mace")->wield();
}  

void heart_beat()
{
    string skill;
    object weapon, armor, room1;
    object me = this_object();

    ::heart_beat();

    if ( !living(me) )
    {
        return;
    }

    if ( base_name(environment(me)) != "/d/sunrise/jiangjuntang" )
    {
        room1 = find_object("/d/sunrise/jiangjuntang");
        if ( !room1 )
        {
            room1 = load_object("/d/sunrise/jiangjuntang");
        }

        tell_room(environment(me), HIC"\n戚大帅急急忙忙的离开了。\n\n"NOR);
        me->move(room1);
        tell_room(room1, HIC"\n戚大帅从内堂走了出来。\n\n"NOR);
    }

    if ( !objectp(query_temp("armor/armor")) )
    {
        carry_object(__DIR__"obj/armor")->wear();
    }

    if ( !objectp(weapon = present("axe", me)) )
    {
        carry_object(__DIR__"obj/axe")->wield();
    }
    if ( !objectp(weapon = present("spear", me)) )
    {
        carry_object(__DIR__"obj/spear")->wield();
    }
    if ( !objectp(weapon = present("mace", me)) )
    {
        carry_object(__DIR__"obj/mace")->wield();
    }

    if ( query("eff_kee") < query("max_kee") )
    {
        SDS_D->addEffKee(me);
    }

    if ( query("eff_sen") < query("max_sen") )
    {
        SDS_D->addEffSen(me);
    }

    if ( query("kee") < query("eff_kee") )
    {
        SDS_D->addKee(me);
    }

    if ( query("sen") < query("eff_sen") )
    {
        SDS_D->addSen(me);
    }

    if ( query("force") < 2 * query("max_force") )
    {
        add("force", 200);
    }

    if ( query("mana") < 2 * query("max_mana") )
    {
        add("mana", 200);
    }

    if ( !me->is_fighting() )
    {
        return;
    }

    if ( time() < 3 + query("last_pfm") )
    {
        //3秒出一次绝招
        return;
    }

    set("last_pfm", time());

    switch ( random(4) )
    {
        case 0:
            skill = "axe";
            break;

        case 1:
            skill = "spear";
            break;

        case 2:
            skill = "mace";
            break;

        default:
            skill = "unarmed";
            break;
    }

    if ( "unarmed" != skill )
    {
        if ( objectp(weapon = query_temp("weapon")) )
        {
            if ( skill != weapon->query("skill_type") )
            {
                command("unwield " + weapon->query("id"));
            }
        }
        command("wield " + skill);
        if ( !objectp(weapon = query_temp("weapon")) )
        {
            skill = "unarmed";
        }
    }
    else
    {
        if ( objectp(weapon = query_temp("weapon")) )
        {
            command("unwield " + weapon->query("id"));
        }
    }

    switch ( skill )
    {
        case "axe":
            map_skill("parry", "sanban-axe");
            break;

        case "spear":
            map_skill("parry", "bawang-qiang");
            break;

        case "mace":
            map_skill("parry", "jianglei-mace");
            break;

        default:
            map_skill("parry", "changquan");
            break;
    }

    switch ( random(10) )
    {
        case 0 :
        case 1 :
        case 9 :
        case 8 :
        case 2 :
            SDS_D->randomPfm(me, skill);
            break;
        case 3 :
        case 7 :
        case 6 :
            SDS_D->randomCast(me);
            break;
        default:
            SDS_D->randomExert(me);
            break;
    }
}

void init()
{
    if ( !query_heart_beat(this_object()) )
    {
        set_heart_beat(1);
    }
}

void revive_me()
{
    set("dietimes", 0);
    SDS_D->powerup(this_object());
}

void die()
{
    object me = this_object();

    //可以复活三次
    if ( environment(me) && me->query("dietimes") < 3 )
    {
        message("sound", HIR "\n\n戚大帅缓缓一点头：凤凰涅盘，浴血重生，中华无敌，抗倭必胜！\n\n"NOR, environment(me));
        SDS_D->powerup(me);
        add("dietimes", 1);
    }
    else
    {
        JAPAN_D->set_master_state(0);
        set("dietimes", 0);
        destruct(me);
    }

    return;
}

int defense()
{
    object me = this_object();
    object who = this_player();
    string answer;

    if ( wizardp(who) )
    {
        write("war state is " + JAPAN_D->query_state()+"\n");
    }

/*
    if ( !wizardp(who) && !who->query_temp("sunrise/valid") )
    {
        who->set_temp("sunrise/huifu", 0);
        confirm_again(who);
        return 1;
    }
*/

    who->set_temp("sunrise/valid", 0);

    if ( time() - who->query_temp("sunrise/wkask") < 15 )
    {
        tell_object(who, "你还是等下再问吧。\n");
        return 1;
    }

    who->set_temp("sunrise/wkask", time());

    answer = JAPAN_D->cannot_play(who);
    if ( answer )
    {
        command("shake " + who->query("id"));
        tell_object(who, answer + "\n");     
        return 1;
    }

    if ( !JAPAN_D->can_join() )
    {
        tell_object(who, "目前并无倭寇的踪迹。\n");
        return 1;
    } 

    if ( !JAPAN_D->query_actor(who) )
    {
        tell_object(who, "好，倭寇侵犯在即，英雄可为国做贡献！\n");
        JAPAN_D->add_actor(who);
    }
    else
    {
        tell_object(who, "你已经报过名了。\n");
    }

    return 1;
}  

int give_reward()
{
    object me = this_player();
    int exp, pot;
    string msg = me->query("name") + "(" + me->query("id") + ")";

/*
    if ( !wizardp(me) && !me->query_temp("sunrise/valid") )
    {
        me->set_temp("sunrise/huifu", 0);
        confirm_again(me);
        return 1;
    }
*/

    me->set_temp("sunrise/valid", 0);

    if ( !JAPAN_D->can_reward() )
    {
        tell_object(me, "倭寇尚未全灭，谈何军功！\n");
        return 1;
    }

    if ( !JAPAN_D->query_actor(me) )
    {
        tell_object(me, "功劳簿上并没有你的名字。\n");
        return 1;
    }

    exp = (int)me->query_temp("sunrise/reward");

    if ( exp <= 0 )
    {
        tell_object(me, "你目前没有更多的军功！\n");
        return 1;
    }

    if ( me->query_temp("sunrise/killed/wokou") )
    {
        msg += "击杀倭寇" + chinese_number(me->query_temp("sunrise/killed/wokou")) + "名，";
    }
    if ( me->query_temp("sunrise/killed/renzhe") )
    {
        msg += "击杀忍者" + chinese_number(me->query_temp("sunrise/killed/renzhe")) + "名，";
    }
    if ( me->query_temp("sunrise/killed/xiuluo") )
    {
        msg += "击杀修罗" + chinese_number(me->query_temp("sunrise/killed/xiuluo")) + "名，";
    }
    if ( me->query_temp("sunrise/killed/luosha") )
    {
        msg += "击杀罗刹" + chinese_number(me->query_temp("sunrise/killed/luosha")) + "名，";
    }
    if ( me->query_temp("sunrise/killed/jiang") )
    {
        msg += "击杀将军" + chinese_number(me->query_temp("sunrise/killed/jiang")) + "名，";
    }
    if ( me->query_temp("sunrise/killed/shen") )
    {
        msg += "击杀神将" + chinese_number(me->query_temp("sunrise/killed/shen")) + "名，";
    }
    if ( me->query_temp("sunrise/killed/leader") )
    {
        msg += "击杀首领" + chinese_number(me->query_temp("sunrise/killed/leader")) + "名，";
    }

    if ( me->query_temp("sunrise/retreat") )
    {
        msg += "重伤撤退" + chinese_number(me->query_temp("sunrise/retreat")) + "次！";
    }
    else
    {
        msg += "好样的！";
    }

    JAPAN_D->war_message(HIY + msg + NOR);

    pot = exp / 5;

    msg = "奖励" + me->query("name") + "经验值：" + chinese_number(exp) + "点，道行：" + COMBAT_D->chinese_daoxing(exp) + "，潜能：" + chinese_number(pot) + "点。";
    tell_object(me, HIY + msg + NOR + "\n");
    JAPAN_D->war_message(HIW + msg + NOR);

    me->add("combat_exp", exp);
    me->add("daoxing", exp);
    me->add("potential", pot);

    JAPAN_D->init_player(me);

	return 1;
}

