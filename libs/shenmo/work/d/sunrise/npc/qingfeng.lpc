//
int check_wokou() {
  int i, j, time;
  object lroom;
  if (!WAR_D->query_winlose()) {
    command("say 战败之人，谈何反攻！");
    return 1;
  }
  lroom = find_object("/d/japan/tbzl");
  if (!objectp(lroom)) {
    lroom = load_object("/d/japan/tbzl");
  }
  time = lroom->query_temp("wokoureset");
  if (time > 0) time = time - 5;
  if (present("jap leader", lroom)) {
    command("say 倭寇已经来了，就在前面的小岛上。");
    if (time == 0) command("say 倭寇马上就再来。");
    else command("say 大概再过 " + (-time * 15) + " 分钟，还会有新的倭寇再来。");
  } else if (time == 0) command("say 倭寇马上就快来了，再等一会儿吧。");
  else {
    command("say 倭寇已经撤退了，大概再过 " + (-time * 15) + " 分钟才会再来。");
  }
  for (i = 0; i < sizeof(allplace); i++) {
    object room;
    reset_eval_cost();
    room = find_object(allplace[i]);
    if (!objectp(room)) room = load_object(allplace[i]);
    if (wizardp(this_player())) write(allplace[i] + "\n");
    room->set_temp("wokoureset", time);
  }
  this_player()->set_temp("qingfeng_asked", 1);
  return 1;
}

int give_reward()      //倭寇，忍者，罗刹，修罗
{
  int wokou_count, renzhe_count, xiuluo_count, luosha_count, total_count, exp, pot, wokou_exp, renzhe_exp, xiuluo_exp, luosha_exp, myexp, cpexp, intTemp;
  int retreat, coff;
  string msg;
  int mainexp;
  int mykills, expg, potg, scoreg, moneyg, mexpg, mpotg, mscoreg, mmoneyg;
  string reward_msg;
  if (!this_player()->query_temp("jap_badguy")) return 0;
  if (this_player()->query("combat_exp") > 2000000000) {
    tell_object(this_player(), "清风说道：以你现在的经验应该自力更生了，不要再找我要奖励了。\n");
    return 1;
  }
  mainexp = EXPBONUS;
  if (this_player()->query("combat_exp") > 1800000000) mainexp /= 0.8;
  if (this_player()->query("combat_exp") > 1500000000) mainexp /= 0.9;
  if (this_player()->query("combat_exp") > 1200000000) mainexp /= 1;
  if (this_player()->query("combat_exp") > 1000000000) mainexp /= 1.1;
  if (this_player()->query("combat_exp") > 800000000) mainexp /= 1.2;
  if (this_player()->query("combat_exp") > 40000000) mainexp /= 1.5;
  expg = mainexp;
  potg = mainexp / 3;
  scoreg = mainexp;
  moneyg = mainexp / 1000;
  if (this_player()->query_temp("jap_badguy/bing1") > 200) this_player()->set_temp(
    "jap_badguy/bing1",
    200
  );
  if (this_player()->query_temp("jap_badguy/bing2") > 150) this_player()->set_temp(
    "jap_badguy/bing2",
    150
  );
  if (this_player()->query_temp("jap_badguy/bing3") > 120) this_player()->set_temp(
    "jap_badguy/bing3",
    120
  );
  if (this_player()->query_temp("jap_badguy/bing4") > 90) this_player()->set_temp(
    "jap_badguy/bing4",
    90
  );
  if (this_player()->query_temp("jap_badguy/jiang1") > 60) this_player()->set_temp(
    "jap_badguy/jiang1",
    20
  );
  if (this_player()->query_temp("jap_badguy/jiang2") > 40) this_player()->set_temp(
    "jap_badguy/jiang2",
    40
  );
  mykills = 0;
  mykills += this_player()->query_temp("jap_badguy/bing1");
  mykills += this_player()->query_temp("jap_badguy/bing2") * 5;
  mykills += this_player()->query_temp("jap_badguy/bing3") * 10;
  mykills += this_player()->query_temp("jap_badguy/bing4") * 30;
  mykills += this_player()->query_temp("jap_badguy/jiang1") * 175;
  mykills += this_player()->query_temp("jap_badguy/jiang2") * 700;

  mexpg = expg / 200 * mykills;
  mpotg = potg / 200 * mykills;
  mscoreg = scoreg / 200 * mykills;
  mmoneyg = moneyg * mykills / 5000;

  reward_msg = HIW "你被奖励了：\n\t\t";
  //
  if (mexpg > 0) reward_msg += chinese_number(mexpg) + "点实战经验\n\t\t";
  if (mpotg > 0) reward_msg += chinese_number(mpotg) + "点潜能\n\t\t";
  if (mscoreg > 0) reward_msg += chinese_number(mscoreg) + "点评价\n\t\t";
  if (mmoneyg > 0) reward_msg += chinese_number(mmoneyg) + "两黄金\n\t\t";
  reward_msg += NOR "\n";
  tell_object(this_player(), reward_msg);
  this_player()->add("combat_exp", mexpg);
  this_player()->add("potential", mpotg);
  this_player()->add("score", mscoreg);
  if (this_player()->query("balance") < 1900000000)
    this_player()->add("balance", mmoneyg * 10000);
  this_player()->delete_temp("jap_badguy");
  return 1;
}
