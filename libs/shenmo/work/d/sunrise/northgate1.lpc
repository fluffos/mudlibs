inherit __DIR__ "room.lpc";
#include <ansi.h>;

void create() {
  set("short", "明月内门");
  set("long",
    "这里是日出城的北城门的内城门，只见城门上方是三个大
字。" HIC "

                    明  月  门
\n" NOR
    "近年来倭寇屡次侵犯日出城，故这儿把守相当严密，一些官兵
们正在盘查要离日出城的人。两边是上城头的石阶，向南进入
城区。\n"
  );

  set("exits", ([
    "eastup": __DIR__ "walln1",
    "westup": __DIR__ "walln2",
    "south": __DIR__ "northjie",
    "north": __DIR__ "northgate2",
  ]));

  set("coor/x", 110);
  set("coor/y", -190);
  set("coor/z", -30);

  ::create();
}
