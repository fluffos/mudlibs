#include <ansi.h>
inherit __DIR__ "room.lpc";

int do_back(string arg);

void create() {
  set("short", "伤兵营");

  set("long", @LONG
这儿是日出城的伤兵营，安置在聚义馆的最里面。有几个大夫在
这里照看伤兵。这里有条秘道通往将军府大堂(back)。
LONG);

  set("exits", ([
    "north": __DIR__ "juyihuayuan",
  ]));

  set("coor/x", 100);
  set("coor/y", -280);
  set("coor/z", -30);

  ::create();
}

void init() {
  add_action("do_back", "back");
}

int do_back(string arg) {
  object room;

  if (this_player()->is_busy()) {
    return notify_fail("你正忙着呢！\n");
  }

  if (!room = find_object(__DIR__ "jiangjuntang")) {
    room = load_object(__DIR__ "jiangjuntang");
  }

  message_vision(HIW "$N急急忙忙的钻进地洞。\n" NOR, this_player());
  this_player()->move(room);
  message_vision(HIW "$N从地洞里钻了出来。\n" NOR, this_player());

  return 1;
}
