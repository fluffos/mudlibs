inherit __DIR__"room.lpc";

void create()
{
    set("short", "兵器铺");
    set("long", @LONG
这里原来是一家极其简陋的铁匠铺。近年来倭寇屡次
进犯日出城，这家铁匠铺被官府征用，作为官办作坊。目前规模
很大，一般用来为日出城守军打造铠甲、兵器等，近来因日出
城需筹备守城物资，奉明月之命也生产一些铁钎、铁锤、伐木斧
头等。只见几十个铁匠正叮叮当当地忙个不停。
LONG );

    set("exits", ([
        "west" : __DIR__"southjie3",
    ]));

    set("coor/x",120);
    set("coor/y",-280);
    set("coor/z",-30);

    ::create();
}

