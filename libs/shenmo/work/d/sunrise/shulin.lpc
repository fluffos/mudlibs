#include <room.h>
inherit __DIR__"room.lpc";

void create()
{
    set("short", "树林");
    set("long", @LONG
你走在树林中，只听见群鸟争鸣，四周景致宜人，想不到
日出城外竟有如此风景。
LONG );

    set("exits", ([
        "northwest" : __DIR__"shanlu1",
        "south" : __DIR__"xiaodao1",
    ]));

    set("coor/x",60);
    set("coor/y",-210);
    set("coor/z",-30);

    ::create();
}
