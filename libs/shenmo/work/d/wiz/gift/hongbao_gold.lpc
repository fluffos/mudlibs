inherit ITEM;

void create() {
  set_name("红包", ({ "bag" }));
  set("unit", "个");
  set("value", 0);
  set("long", "一个给新人的红包.....\n");
  setup();
}

void _newbie(object me) {
  remove_call_out("_newbie");
  if (!me || !present(this_object(), me)) {
    destruct(this_object());
    return;
  }
  if (me->query("c_balance_credit") < 1
    && me->query("c_balance") < 100000000
    && me->query("age") > 16
    && me->query("age") < 30) {
    me->add("c_balance", 10000000);
    tell_object(me, "你的储值卡里增加了一千两黄金。\n");
    destruct(this_object());
    return;
  } else {
    tell_object(me, "你不是新人，红包自动回收了。\n");
    destruct(this_object());
    return;
  }
}

void init() {
  object me = this_player();
  if (!present(this_object(), me))
    return;
  if (!userp(me))
    return;
  call_out("_newbie", 0, me);
}
