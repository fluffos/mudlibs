//赛马检测
//masterd.c
#include <ansi.h>
inherit NPC;

nosave int v = 0;
nosave int p = 0;

int is_saima()
{
return v;
}

int game_start(object npc)
{
if ( v>0 || !npc )
        return 0;
v++;
set("马官",npc);
remove_call_out("game_over");
call_out("game_over",300);
return 1;
}

void game_over()
{
object guan;    
if ( v<=0 )
        return; 
v = 0;
p = 0;
message("channel:chat",HIC"〖"HIG"民间界"HIC"〗马官(Ma guan)：本次赛马比赛结束。\n"NOR,users());
guan = query("马官");
if ( !guan )
        error("马官没了?!\n");
guan->delete_temp("参加玩家");
guan->delete_temp("路线");
guan->set_temp("上次结束",time());      
}

void check_player(object me)
{
object book,guan,*player;
if ( objectp(book=present("zhi nan",me)) 
  && book->is_saima_item() )
        destruct(book);  

p++;
message("channel:chat",sprintf( HIC"〖"HIG"民间界"HIC"〗马官(Ma guan)：%s(%s)达到了终点，取得了第%s名的成绩。\n"NOR,
                                me->query("name"),capitalize(me->query("id")),chinese_number(p) ),
                                users());
me->delete_temp("赛马");
me->set_temp("赛马/名次",p);
guan = query("马官");
if ( !guan )
        error("马官没了?!\n");
guan->check_num(me);    
}
