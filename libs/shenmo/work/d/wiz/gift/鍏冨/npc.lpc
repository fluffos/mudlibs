#include <ansi.h>
inherit NPC;

string do_gift(object me) {
  object deng, npc;
  mapping temp;
  string str, *dir;
  me = this_player();
  if (!me)
    return 0;
  temp = me->query_temp("07元宵");
  if (me->query("礼物记录/07元宵") >= 3)
    return 0;
  if (temp || mapp(temp))
    return "赶紧将灯送出去吧。";
  deng = new(__DIR__ "deng");
  if (!deng)
    return 0;
  dir = ({
    "/d/pantao", "/d/death",
    "/d/gumu", "/d/kunlun",
    "/d/huashan", "/d/pansi",
    "/d/sanjie", "/d/sanxian",
    "/d/emei",
  });
  npc = SDS_D->random_npc(dir);
  if (!npc)
    return "你先休息休息再来。";
  deng->set("target", npc);
  if (!deng->move(me)) {
    destruct(deng);
    return "你先休息休息再来。";
  }
  me->set_temp("07元宵/target", npc);
  me->set_temp("07元宵/start", time());
  message_vision("$n递给$N一盏" + deng->name(1) + "。\n", me, this_object());
  return "你先将" + deng->name(1) + "交给" + MISC_D->find_place(environment(npc)) + "的" + npc->name() + "。";
}

void create() {
  set_name("阿浓", ({ "a nong", "girl", "anong" }));
  set("title", HIW "元宵礼物使者" NOR);
  set("nickname", HIG "蜡炬传红映碧纱" NOR);
  set("inquiry", ([
    "元宵礼物": (: do_gift :),
    "gift": (: do_gift :),
  ]));
  set("gender", "女性");
  set("per", 39);
  set("long", "春节礼物发放使者，你可以向她索要 春节礼物 。\n一头秀发好似比以往修短了一点。。。。^-^");
  setup();
  carry_object("/d/obj/cloth/yuanxiang")->wear();
  carry_object("/d/obj/cloth/nichang")->wear();
}
