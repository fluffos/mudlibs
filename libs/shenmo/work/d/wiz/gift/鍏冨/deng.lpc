#include <ansi.h>
inherit ITEM;

void create()
{
set_name("花燈",({"hua deng", "deng" }) ); 
set_weight(5000); 
if ( clonep() ) 
        set_default_object(__FILE__); 
else    { 
        set("unit", "盞"); 
        set("long", "一盞小巧玲瓏的花燈。\n"); 
        set("value",0); 
        }
setup();
}

void init()
{
add_action("do_give","give");
}

int do_give(string arg)
{
object gift,who,me = this_player();
string o_id,t_id,str;
int t,wx,pot,dx;

if ( !arg || me!=environment() )
        return 0;
if ( sscanf(arg,"%s to %s",o_id,t_id)==2 
  || sscanf(arg,"%s %s",t_id,o_id)==2 )
        {
        if ( !id(o_id) )
                return 0;
        who = present(t_id,environment(me));
        if ( !who || !living(who) )
                return 0;
        if ( who!=me->query_temp("07元宵/target") )
                return 0;
        if ( who!=query("target") )
                return 0;
        message_vision("$N给$n一"+query("unit")+name(1)+"。\n",me,who);
        message_vision(CYN"$n"NOR CYN"由衷地感谢$N"NOR CYN"。\n"NOR,me,who);
        str = "多谢"+me->name(1)+"赠我"+name(1)+"，祝这位"+RANK_D->query_respect(me)+"元宵节快乐。";
        CHANNEL_D->do_channel(who,"chat",str);
        if ( me->query("礼物记录/07元宵")<5 )
                {
                t = me->query_temp("07元宵/start");
                t = time()-t;
                t = 120-t;
                if ( t<10 ) t = 10;
                if ( t>50 ) t  = 50;
                t*= 2;
                wx = 50000;
                dx = 80000;
                pot = 10000;
                wx = wx*t/100;
                dx = dx*t/100;
                pot = pot*t/100;
                wx = wx/2+random(wx/2);
                dx = dx/2+random(dx/2);
                pot = pot/2+random(pot/2);
                if ( random(10)>=3 )
                        {
                        me->add("combat_exp",wx);
                        me->add("daoxing",dx);
                        me->add("potential",pot);
                        }
                else if ( random(10)>=3 && mapp(me->query("weapon/type")) )
                        { 
                        t = random(sizeof(keys(me->query("weapon/type"))));
                        me->set("weapon/type/"+keys(me->query("weapon/type"))[t], me->query("weapon/type/"+keys(me->query("weapon/type"))[t])+1); 
                        write(HIG"你的自制武器的"+keys(me->query("weapon/type"))[t]+"等级提高了！\n"NOR);
                        me->set("weapon/value",0); 
                        }
                else if ( random(10)>=3 || me->query("age")<25 )
                        {
                        t = me->max_level_exp()/2+10000;        
                        me->add("level_exp",t); 
                        write("你的等级经验增加了"+t+"点。\n");
                        }
                else    {
                        if ( random(10)>=3 )
                                gift = new("/d/nanhai/obj/lianhua/hebing");
                        else    gift = new("/u/snowtu/obj/hebing");     
                        if ( !gift || !gift->move(me) )
                                write("你身上东西太多，结果什么也没有得到。。。。\n");
                        write("你得到了"+gift->short()+"。\n");                         
                        }       
                me->add("礼物记录/07元宵",1);
                me->delete_temp("07元宵");
                }
        destruct(this_object());
        return 1;
        }       
return 0;
}

string long()
{
string str = ::long();
object npc = query("target");
if ( !npc )  return str;
str+= "你需要将它交给"+MISC_D->find_place(environment(npc))+"的"+npc->name()+"。";
return str;
}

