#include <ansi.h>
inherit NPC;

string give_gift();
void check_gift(object me, string arg);

void create() {
  set_name("幻兽老人", ({ "lao ren", "ren" }));
  set("long", "他是在这里负责给大家礼物的");
  set("gender", "男性");
  set("title", HIW "天" MAG "上" HIG "人" HIC "间" NOR);
  set("nickname", REV HIM "礼物大使" NOR);
  set("age", 2000);
  set("per", 40);
  set("inquiry", ([
    "gift": (: give_gift :),
    "礼物": (: give_gift :),
  ]));
  setup();
  carry_object("/d/lingtai/obj/faguan")->wear();
}

string give_gift() {
  object me = this_player();
  if (me->query("06元宵"))
    return 0;
  tell_object(me, REV MAG "元宵节快乐，你想要什么礼物？\n" NOR);
  tell_object(me, MAG "\t\t1. 二十万武学经验\n" NOR);
  tell_object(me, MAG "\t\t2. 五百年道行修为\n" NOR);
  tell_object(me, MAG "\t\t3. 十五万潜能点数\n" NOR);
  tell_object(me, MAG "\t\t4. 若干颗升级魄石\n" NOR);
  input_to((: call_other, __FILE__, "check_gift", me :));
  return "节日快乐";
}

void check_gift(object me, string arg) {
  object po;
  string ip;
  int i;
  if (!me)
    return;
  if (!arg || (arg != "1" && arg != "2" && arg != "3"
    && arg != "4")) {
    tell_object(me, REV MAG "元宵节快乐，你想要什么礼物？\n" NOR);
    tell_object(me, MAG "\t\t1. 二十万武学经验\n" NOR);
    tell_object(me, MAG "\t\t2. 五百年道行修为\n" NOR);
    tell_object(me, MAG "\t\t3. 十五万潜能点数\n" NOR);
    tell_object(me, MAG "\t\t4. 若干颗升级魄石\n" NOR);
    input_to((: call_other, __FILE__, "check_gift", me :));
    return;
  }
  switch (arg) {
    case "1":
      me->add("combat_exp", 200000);
      me->set("06元宵", 1);
      me->save();
      tell_object(me, REV MAG "节日快乐，你的武学经验增加了二十万。\n" NOR);
      break;
    case "2":
      me->add("daoxing", 500000);
      me->set("06元宵", 1);
      me->save();
      tell_object(me, REV MAG "节日快乐，你的道行增加了五百年。\n" NOR);
      break;
    case "3":
      me->add("potential", 150000);
      me->set("06元宵", 1);
      me->save();
      tell_object(me, REV MAG "节日快乐，你的潜能增加了十五万。\n" NOR);
      break;
    default:
      ip = query_ip_number(me);
      if (query(ip)) {
        tell_object(me, REV MAG "节日快乐，与你相同IP的玩家已经领取了节日礼物了，你可以选择其他礼物。\n" NOR);
        return;
      }
      if (!stringp(me->query("cloth_name"))) {
        tell_object(me, REV MAG "节日快乐，你并没有属于自己黄金圣衣，你只能选择其他礼物了。\n" NOR);
        return;
      }
      i = me->query_int() + me->query_kar() + me->query_str();
      i /= 100;
      i += 1;
      i = 1 + random(i);
      if (wizardp(me)) tell_object(me, "i=" + i + "\n");
      me->set("06元宵", 1);
      set(ip, 1);
      me->save();
      while (i--) {
        po = new("/d/nanhai/obj/lianhua/shengji");
        po->set("no_get", 1);
        if (!po->move(me)) {
          tell_object(me, REV MAG "节日快乐，你身上放不下" + po->name() + REV MAG "了。\n" NOR);
          return;
        }
        tell_object(me, REV MAG "节日快乐，你得到了一颗" + po->name() + REV MAG "。\n" NOR);
      }
  }
}
