#include <ansi.h>
inherit ITEM;

void create() {
  set_name("百草图", ({ "bai cao tu", "tu" }));
  set("unit", "张");
  set("no_drop", 1);
  set("no_give", 1);
  set("no_put", 1);
  setup();
}

void init() {
  add_action("do_look", "look");
}

int do_look(string arg) {
  int i;
  string str;
  mapping temp;
  object *inv, npc, me = this_player();
  temp = me->query_temp("春节");
  if (!temp || !mapp(temp))
    return 0;
  if (!arg || !id(arg) || !present(this_object(), me))
    return 0;
  str = "百草图寻得：\n";
  inv = values(temp);
  i = sizeof(inv);
  while (i--) {
    if (inv[i] && environment(inv[i])
      && !userp(environment(inv[i])) && !environment(inv[i])->is_chunjie_item())
      str += sprintf("\t%s(%s)\t: %s 处的 %s 身上\n",
        inv[i]->name(),
        inv[i]->query("id"),
        MISC_D->find_place(environment(environment(inv[i]))),
        environment(inv[i])->name(),);
  }
  tell_object(me, str);
  return 1;
}
