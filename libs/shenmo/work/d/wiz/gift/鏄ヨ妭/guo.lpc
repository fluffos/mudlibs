#include <ansi.h>
inherit ITEM;

mapping gift1 = ([
  "kar": "福缘",
  "str": "力量",
  "cor": "勇气",
  "spi": "灵性",
  "int": "悟性",
  "cps": "定力",
  "per": "容貌",
  "con": "根骨",
]);

int time_out() {
  int k, i = 0;
  object *inv;
  mixed temp = localtime(time());
  if (!temp || !arrayp(temp))
    return 0;
  inv = all_inventory();
  k = sizeof(inv);
  while (k--) {
    if (inv[k]) i++;
  }
  if (!i) return 0;
  return 1;
}

void check() {
  object *inv;
  int i, temp = 0;
  if (environment() && time_out()) {
    inv = all_inventory();
    i = sizeof(inv);
    while (i--) {
      if (inv[i]) {
        if (inv[i]->is_chunjie_item())
          temp++;
        else {
          tell_room(environment(), inv[i]->name() + "在锅中化成了汤水。。。。\n");
          if (!userp(inv[i])) destruct(inv[i]);
          else inv[i]->move("/d/city/kezhan");
        }
      }
    }
    set("春节/items", temp);
    if (!temp) return;
    inv = all_inventory();
    if (!inv || !arrayp(inv)) return;
    i = random(sizeof(inv));
    if (inv[i])
      tell_room(environment(), inv[i]->name() + "在锅中翻了个身，又滑进锅底去了。。。。\n");
  }
}

void create() {
  set_name("大火锅", ({ "da huoguo", "huoguo", "guo" }));
  set_weight(5000000);
  set_max_encumbrance(100000);
  set_max_items(10000);
  set("unit", "口");
  set("long", HIR "这是春节年夜饭专用的火锅，可以将年夜饭专用的食物放进去(put)慢慢煲来吃(eat)。\n" NOR);
  set("value", 50);
  setup();
}

int is_container() {
  return 1;
}

int is_chunjie_item() {
  return 1;
}

void init() {
  check();
  add_action("do_chi", "eat");
  add_action("do_none", "get");
}

int do_none() {
  write("ok.\n");
  return 1;
}

int do_chi() {
  int i, time, temp, k, j;
  string *str, arg;
  object *inv, ob, me = this_player();
  check();
  if (!time_out() && !wizardp(me)) {
    write("还没到时候呢。。。。\n");
    return 0;
  }
  if (!query("春节/items")) {
    write("锅里现在无东西可吃。。。。\n");
    return 0;
  }
  check();
  inv = all_inventory();
  if (!inv || !arrayp(inv)) {
    write("锅里现在无东西可吃。。。。\n");
    return 1;
  }
  i = random(sizeof(inv));
  if (!inv[i]) {
    write("锅里现在无东西可吃。。。。\n");
    return 1;
  }
  message_vision(
    "$N从" + name() + "里捞出一" + inv[i]->query("unit") + inv[i]->name() + "吃得津津有味。\n",
    me
  );
  if (me->query("06春节2") && !wizardp(me))
    return 1;

  time = me->query_temp("06春节");
  time /= 8;
  if (time < 1) time = 1;
  if (time > 3) time = 3;
  while (time--) {
    k = 1 + random(5);
    temp = query("春节/items") + 1;
    temp *= 1000;
    if (temp > 300000)
      temp = 300000;
    temp = temp / 2 + random(temp / 2);
    if (me->query_skill("force", 1) < 150) {
      tell_object(me, HIY "春节快乐！你得到了" + COMBAT_D->chinese_daoxing(temp) + "道行。\n");
      me->add("daoxing", temp);
      me->set("06春节2", 1);
      me->save();
    } else {
      switch (random(8)) {
        case 4:
          str = keys(gift1);
          arg = str[random(sizeof(str))];
          tell_object(me, HIY "春节快乐！你得到了" + k + "点的" + gift1[arg] + "。\n" NOR);
          me->add(arg, k);
          me->save();
          break;
        case 0:
          str = keys(me->query_skills());
          arg = str[random(sizeof(str))];
          tell_object(me, HIY "春节快乐！你得到了" + k + "级的" + to_chinese(arg) + "。\n" NOR);
          me->set_skill(arg, me->query_skill(arg, 1) + k);
          me->save();
          break;
        case 3:
          tell_object(me, HIY "春节快乐！你得到了" + k + "根救命毫毛。\n");
          me->add("haomao", k);
          me->save();
          break;
        case 1:
          ob = new("/d/nanhai/obj/lianhua/hebing");
          ob->set("no_put", 1);
          ob->set("no_give", 1);
          ob->set("no_get", 1);
          ob->set("no_drop", 1);
          ob->set("no_sell", 1);

          if (ob && ob->move(me))
            tell_object(me, HIY "春节快乐！你得到了一个" + ob->name() + "。\n");
          break;
        case 2:
          ob = new("/d/nanhai/obj/lianhua/shengji");
          ob->set("no_put", 1);
          ob->set("no_give", 1);
          ob->set("no_get", 1);
          ob->set("no_drop", 1);
          ob->set("no_sell", 1);
          if (ob && ob->move(me))
            tell_object(me, HIY "春节快乐！你得到了一个" + ob->name() + "。\n");
          break;
        default:
          tell_object(me, HIY "春节快乐！你得到了" + COMBAT_D->chinese_daoxing(temp) + "道行。\n");
          me->add("daoxing", temp);
          me->save();
      }
    }
  }
  me->set("06春节2", 1);
  destruct(inv[i]);
  return 1;
}
