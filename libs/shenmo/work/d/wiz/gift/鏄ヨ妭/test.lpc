#include <ansi.h>
inherit NPC;

string chunjie_gift() {
  object npc, where, it, me;
  int i, k = 0;
  string temp;
  me = this_player();
  if ((me->query_temp("06春节")
    || me->query("06春节"))
    && !wizardp(me))
    return 0;
  i = me->query_kar();
  i = 1 + random(i / 2);
  while (i--) {
    npc = SDS_D->random_npc();
    if (!npc)
      continue;
    where = SDS_D->random_place();
    if (!where || !npc->move(where))
      continue;
    it = new("/d/wiz/gift/春节/item");
    if (!it || !it->move(npc))
      continue;
    me->set_temp("春节/" + i, it);
    k++;
  }
  if (!k)
    return 0;
  it = new("/d/wiz/gift/春节/tu");
  if (!it || !it->move(me))
    return 0;
  message_vision("$N给$n一张" + it->name() + "。\n", this_object(), me);
  me->add_temp("06春节", 1);
  return "找到这上面的佐料，放到南城客栈二楼的火锅里去，等到了时候，你就可以吃了。注意：并不需要找到所有的佐料，但是找到越多，你的奖励可能也越多哦。";
}

void create() {
  set_name("测试", ({ "test" }));
  set("inquiry", ([
    "gift": (: chunjie_gift :),
  ]));
  setup();
}
