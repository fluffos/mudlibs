#include <ansi.h>
inherit ITEM;

mapping names = ([
        "狗肉"  : ({"gou rou","rou"}),
        "狗鞭"  : ({"gou bian","bian"}),
        "八角"  : ({"ba jiao","jiao"}),
        "茴香"  : ({"hui xiang","xiang"}),
        "羊肉"  : ({"yang rou","rou"}),
        "羊肝"  : ({"yang gan","gan"}),
        "牛肉"  : ({"niu rou","rou"}),
        "牛腩"  : ({"niu nan","nan"}),
        "牛筋"  : ({"niu jin","jin"}),
        "牛鞭"  : ({"niu bian","bian"}),
        "牛心"  : ({"niu xin","xin"}),
        "猪肉"  : ({"zhu rou","rou"}),
        "猪血"  : ({"zhu xue","xue"}),
        "猪肝"  : ({"zhu gan","gan"}),
        "猪心"  : ({"zhu xin","xin"}),
        "猪肚"  : ({"zhu du","du"}),
        "猪大肠": ({"zhu chang","chang"}),
        "猪蹄膀": ({"zhu dui","dui"}),
        "猪腰子": ({"zhu shen","shen"}),
        "芫荽"  : ({"yan sui","cao"}),
        "莴苣"  : ({"wo ju","cai"}),
        "冬瓜"  : ({"dong gua","gua"}),
        "竹笋"  : ({"zhu sun","sun"}),
        "香菇"  : ({"xiang gu","gu"}),
        "当归"  : ({"dang gui","yao"}),
        "王八"  : ({"wang ba","ba"}),
        "枸杞"  : ({"gou qi","yao"}),
        "人参"  : ({"ren shen","yao"}),
        "何首乌": ({"he shouwu","yao"}),
        "马钱子": ({"ma qianzi","yao"}),
        "虾仁"  : ({"xia ren","ren"}),
        "龙虾"  : ({"long xia","xia"}),
        "鲍鱼"  : ({"bao yu","yu"}),
        "生蚝"  : ({"sheng hao","hao"}),
        "天九翅": ({"yu chi","chi"}),
        "鹅肝"  : ({"e gan","gan"}),
        "鸭血"  : ({"ya xue","xue"}),
        "雪菜"  : ({"xue cai","cao"}),
        "生姜"  : ({"sheng jiang","jiang"}),
        "肉皮"  : ({"rou pi","pi"}),
        "蛏"    : ({"cheng"}),
        "辣椒"  : ({"la jiao","jiao"}),
]);

void create()
{
string *temp,name,*id;
temp = keys(names);
name = temp[random(sizeof(temp))];
id = names[name];
set_name(name,id);
set("unit","块");
set("long","春节火锅所需的佐料，可以放进火锅里烧，放的越多，吃得自然也越多。\n");
set_weight(1);
setup();
}

void init()
{
if ( !query("be_get") )
        {
        if ( environment() && userp(environment()) )
                {
                set("be_get",1);                        
                environment()->add_temp("06春节",1+random(4));
                }
        }
}

int is_chunjie_item() 
{
return 1;
}
