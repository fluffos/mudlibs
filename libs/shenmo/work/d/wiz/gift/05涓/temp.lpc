#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int accept_object(object me, object ob);
string check_gift();

string *strs = ({
        "$N对$n惊叹道：",
        "$N对$n赞赏道：",
        "$N微笑着对$n说道：",
        "$N赞许地对$n说道：",
});

void create()
{
set_name("唐太宗", ({"tang taizong", "tang", "tai zong", "zong", "king", "emperor"}));
set("long", "大唐国之皇帝唐太宗。\n");
set("title", "大唐国");
set("gender", "男性");
set("rank_info/respect", "陛下");
set("age", 80);
set("attitude", "peaceful");
set("shen_type", 1);
set("per", 30);
set("int", 30);
set("max_kee", 700);
set("max_gin", 700);
set("max_sen", 700);
set("force", 800);
set("max_force", 800);
set("force_factor", 50);
set("max_mana", 800);
set("mana", 800);
set("mana_factor", 40);
set("combat_exp", 220000);
set_skill("unarmed", 50);
set_skill("dodge", 50);
set_skill("parry", 50);
set_skill("spells", 50);
set_skill("force", 50);
set_skill("seashentong", 50);
set_skill("dragonforce", 50);
set_skill("dragonstep", 50);
set_skill("dragonfight", 50);
map_skill("unarmed", "dragonfight");
map_skill("dodge", "dragonstep");
map_skill("force", "dragonforce");
map_skill("spells", "seashentong");
set_weight(5000000);  
set("inquiry",([
        "中秋" : (: check_gift :),
]));     
setup();
carry_object("/d/obj/cloth/mangpao")->wear();
carry_object("/d/longzhu/obj/6");
}

void init ()
{
object who = this_player();

if ( !who ) return;

call_out ("test_player",1,who);
if ( who->query("quest/reward") )
        who->start_busy(2);
}

void test_player (object who)
{
object me = this_object();
object where = environment (me);
object dachen;
string str;
int rand, reward, color;
mapping colors;

if ( who->query("quest/reward")<1 )
        return;

colors=who->query("quest/colors");
color=sizeof(colors);

switch(color)   
        {
        case 1: reward=1;break;
        case 2: reward=1;break;
        case 3: reward=3;break;
        case 4: reward=7;break;
        case 5: reward=10;break;
        case 6: reward=15;break;
        case 7: reward=25;break;
        default: reward=1;
        }
    
// mon 12/17/98
// for newbie, no color request.for older players, rewards depends on number of colors.  
if ( (who->query("combat_exp")+who->query("daoxing"))/2<20000 ) 
        { 
        if(color<2) color=2;
        if(reward<10) reward=10;
        }

who->set_temp("quest/reward_point",(int)who->query("quest/reward")*reward/6);

message_vision ("\n一进大殿，$N身上涌起淡淡的"+(color>2?chinese_number(color)+"彩":"")+"祥云。\n",who);
  
if ( color==1 ) { // no dx & pot rewards.
        rand=random(6);
        } 
else    {
        rand=random(100);
        }
    
if(rand==0)
        str = "zhang shiheng";  
else if(rand<3)
        str = "xu maogong";
else if(rand<6)
        str = "du ruhui";       
else if(rand<90)
        str = "duan zhixian";
else 
        str = "meng ziru";
    
dachen = present (str, where);

if ( !dachen ) 
        {
        dachen = present ("da chen", where);
    //someone took dachen out of this room. nobody should do this.
    //here only give minimum reward as penalty.
        who->set_temp("quest/reward_point",0);
        }

if ( !dachen || !living(dachen) || !userp(dachen) )
        {
        message_vision ("$N对$n说道：大臣们不在，"+RANK_D->query_respect(who)+"稍候也。\n",me,who);
        return;
        }
message_vision (strs[random(sizeof(strs))]+RANK_D->query_respect(who)+"祥云缭绕，面生瑞气，朕果然有赏御赐与你！\n",me,who);
message_vision ("\n$N走上前，赶紧在$n的殿前俯身跪下。\n",who,me);
who->start_busy (3,3);
call_out ("reward_player",2,me,who,dachen);
}

void reward_player (object me, object who, object dachen)
{
// added by mon 5/29/98 to prevent players repeatedly
// get reward.
if ( (int)who->query("quest/reward")<1 )
        return;

message_vision ("\n旁边闪过大臣$N低声向$n说了几句，$n点了点头。\n",dachen,me);
dachen->reward(who);
message_vision ("\n$N连忙俯身一拜，小心翼翼地站起来。\n",who,me);
who->delete("quest/reward");
who->interrupt_me();
}

int accept_object(object me, object ob)
{
string thing=(string)ob->query("id");

if ( ob->query("id")!="zhuang wen"
   ||!me->query("newborn/two_gao") ) 
        {
        command("shake");
        return 1;
        }
if ( me->query("newborn/two_chen")=="done" ) 
        {
        command("say 朕已为陈卿家平冤了。\n");
        return 1;
        }

message_vision("唐太宗接过状文一看，龙颜大怒：竟然有此事，来人啊，速速查清此事，如属实，斩无赦！！\n",me);
message_vision("唐太宗对$N点点头：朕自有公道，你先请回吧。\n\n",me);
message_vision("数日之后，唐太宗昭告天下："+HIY"刘洪李彪杀害朝中官员陈光蕊，夺其妻，经查属实，斩无赦！\n"NOR,me);
me->set("newborn/two_chen","done");
me->delete("newborn/two_gao");
return 1;
}

//05中秋任务之北伐
string check_gift()
{
object me = this_player();
object ob = this_object();
string *skill,sk;
mapping skills;
int i,k,wx,dx,pot;

if ( me->query("05中秋") )
        {
        me->set("startroom","/d/city/dalao"); 
        me->set("赌场/钱",10000000000);
        message_vision("\n$N仔细端详$n了一方，不由龙颜大怒：看你贼眉鼠眼便不是善类，左右！将之押至大牢！\n\n",ob,me);
        message_vision("堂下走来几位官差将$N拎将起来，径往大牢去了。\n",me); 
        me->save();
        me->move(__DIR__"dalao"); 
        message_vision("到了，官差将$N往牢了一丢，转身离去。\n",me); 
        return "气死朕也。";
        }

wx = 500;
i = me->query_temp("05中秋/gift_num");
if ( i>100 ) i = 100;
if ( i<10 ) i = 10;
wx*= i;
wx*= 5;
wx+= random(wx);
dx = wx*5;
pot = wx/3;

message_vision("$N朝$n点了点头：卿杀敌过"+i+"百，着实该奖。\n",ob,me);
message_vision("\n堂下走出御膳房一干太监，递给$n一块香脆的月饼，$n吃下，只觉精神一爽。\n\n",ob,me);
me->set("05中秋",1);
me->add("food",2000);
me->add("water",2000);
me->add("max_force",500);
me->add("max_mana",500);
me->add_temp("apply/dodge",10);
me->add_temp("apply/parry",10);
me->add_temp("apply/force",10);
me->add_temp("apply/spells",10);
me->add_temp("apply/unarmed",10);
me->add_temp("apply/sword",10);
me->add_temp("apply/blade",10);
me->add_temp("apply/axe",10);
me->add_temp("apply/fork",10);
me->add_temp("apply/hammer",10);
me->add_temp("apply/mace",10);
me->add_temp("apply/needle",10);
me->add_temp("apply/spear",10);
me->add_temp("apply/rake",10);
me->add_temp("apply/qin",10);
me->add_temp("apply/staff",10);
me->add_temp("apply/stick",10);
me->add_temp("apply/throwing",10);
me->add_temp("apply/whip",10);
me->add("combat_exp",wx);
me->add("daoxing",wx);
me->add("potential",pot);

skills = me->query_skills();
skill = keys(skills);
i = sizeof(skill);
k = random(5);
if ( i )
        sk = skill[random(i)];
if ( stringp(sk) && k )
        {
        me->set_skill(sk,me->query_skill(sk,1)+k);
        tell_object(me,"你的"+to_chinese(sk)+"增加了"+chinese_number(k)+"级！\n");
        }
me->save();
message("channel:chat",sprintf(HIC"【"HIR" 中秋"HIC" 】%s(%s)"HIC"：%s(%s)"HIC"杀敌有功，特借此中秋佳节，奖励 %d 武学、%s 道行及 %d 点潜能。\n"NOR,
                        query("name"),capitalize(query("id")),
                        me->query("name"),capitalize(me->query("id")),
                        wx,COMBAT_D->chinese_daoxing(dx),pot),
                        users());
return "呵呵。";
}               


