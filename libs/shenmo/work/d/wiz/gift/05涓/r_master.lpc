//room_master.c
#include <ansi.h>

int num = 0;
object *rr = ({});

void add_room_num(object ob)
{
message("shout",WHT"【 "NOR HIR"系统 "NOR WHT"】"NOR YEL"中秋北伐之路 "NOR HIW+(num)+NOR YEL"随机生成完毕。\n"NOR,users());      
rr+= ({ob});
num+= 1;
}       

int query_room_num()
{
return num;
}

object *all_room()      
{
return rr;
}

void clear_all_room()
{
int i;
i = sizeof(rr);
while(i--)
        {
        if ( rr[i] )
                {
                message("channel:wiz",sprintf(WHT"【 "NOR HIR"系统 "NOR WHT"】"NOR YEL"中秋北伐之路 "NOR HIW""+"%O"+NOR YEL"删除完毕。\n"NOR
                                        ,rr[i]),users());
                destruct(rr[i]);
                }
        }
rr = ({});
num = 0;
}                       
