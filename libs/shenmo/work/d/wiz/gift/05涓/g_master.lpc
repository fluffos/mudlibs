void _leave(object ob) {
  remove_call_out("_leave");
  if (!ob)
    return;
  ob->move("/obj/empty");
  destruct(ob);
}

void zhongqiu(object ob) {
  object me = this_player();
  if (me->query("05中秋")) {
    say(ob->name() + "说道：你不是已经要到中秋礼物了吗？\n");
    return;
  }
  say(ob->name() + "点了点头：我这就带你进去。\n");
  message("shout", sprintf(HIC "【" HIR " 中秋 " HIC "】%s(%s)" HIC "：中秋佳节，恩怨暂抛，今特将 %s(%s)" HIC " 引至 北伐之路。\n" NOR,
    ob->name(), capitalize(ob->query("id")),
    me->query("name"), capitalize(me->query("id"))),
    users());
  command("tell " + me->query("id") + " 过完北伐之路，你就可去皇宫索取月饼礼物了。\n");
  message_vision(HIW "\n\n$N" HIW "牵着$n" HIW "的手，两人亲热的同往北伐之路去了。。。\n\n" NOR, ob, me);
  me->move("/d/wiz/gift/05中秋/room");
  ("/d/wiz/gift/05中秋/room")->random_exit();
  call_out("_leave", 2 + random(3), ob);
  write("一切小心了。\n");
}


int random_npc(object who) {
  int i;
  string *dirs, dir, *ids, *id2, id;
  object ob;

  dirs = keys(gg);
  id2 = ({});

  if (!who)
    return 0;
  if (mapp(who->query_temp("05中秋/quest_get")))
    return 0;
  dir = dirs[random(sizeof(dirs))];
  if (wizardp(who))
    write("dir=" + dir + "\n");
  ids = get_dir(dir);
  i = sizeof(ids);
  while (i--) {
    if (!stringp(ids[i])) continue;
    if (sscanf(ids[i], "%s.lpc", id) != 1) continue;
    if (!(dir + id)->query("name")
      || (dir + id)->query("race") != "人类")
      continue;
    id2 += ({ ids[i] });
  }

  id = id2[random(sizeof(id2))];
  ob = find_object((dir + id));
  if (!ob)
    return 0;
  ob = find_living(ob->query("id"));
  if (!ob) ob = find_object((dir + id)->query("id"));
  if (!ob) return 0;
  who->set_temp("05中秋/quest_get", ([
    "id": ob->query("id"),
    "name": ob->query("name"),
    "dir": dir,
    "ob": ob,
  ]));
  ob->delete("inquiry");
  //ob->set("inquiry/中秋", (: zhongqiu :) );
  ob->set("中秋npc", 1);
  return 1;
}

string start_gift() {
  mapping qq;
  object me = this_player();

  if (me->query_temp("05中秋/asked"))
    return "你不是问过了吗？";
  if (!random_npc(me))
    return "节日快乐，我现在正忙，你待会再问吧。";
  if (!mapp(qq = me->query_temp("05中秋/quest_get")))
    return "节日快乐，我现在正忙，你等会再问吧。";

  me->set_temp("05中秋/asked", 1);
  return "你先去" + gg[qq["dir"]] + "找" + qq["ob"]->short() + "询问进一步的消息吧。";
}
