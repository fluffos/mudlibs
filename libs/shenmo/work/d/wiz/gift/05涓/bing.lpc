#include <ansi.h>
inherit NPC;

void postarrow1(object, object, object, int);
void postarrow2(object, object, object, int);
void default_post(object, object, object, int);

mapping *actions_arrow = ({
  ([ "action":
    "$N手中幻化出一把巨大的弓弩，拉弦成月，“啪”的一声，一支长箭带着呼啸的风声，飞向$n$l",
    "damage_type": "刺伤",
    "weapon": YEL "长箭" NOR,
    "post_action": (: postarrow1 :),
  ]),
  ([ "action":
    "$N从背后抽出三支" CYN "乌金箭" NOR "，一招“三泉映月”，三道风声从各个方向射向$n",
    "damage_type": "刺伤",
    "weapon": YEL "乌金箭" NOR,
    "post_action": (: postarrow2 :),
  ]),
  ([ "action":
    "$N转身抽箭稳弓校弦，一气呵成，$n还没反应过来，一支" HIR "回旋箭" NOR "已带着隐隐风雷声朝自己的$l飞来",
    "damage_type": "刺伤",
    "weapon": HIR "回旋箭" NOR,
    "post_action": (: postarrow1 :),
  ]),
  ([ "action":
    "$N手中幻化出一把巨大的弓弩，拉弦成月，“啪”的一声，一支长箭带着呼啸的风声，飞向$n$l",
    "damage_type": "劈伤",
    "weapon": YEL "长箭" NOR,
    "post_action": (: postarrow1 :),
  ]),
  ([ "action":
    "$N从背后抽出三支" CYN "乌金箭" NOR "，一招“三泉映月”，三道风声从各个方向射向$n",
    "damage_type": "劈伤",
    "weapon": YEL "乌金箭" NOR,
    "post_action": (: postarrow2 :),
  ]),
  ([ "action":
    "$N转身抽箭稳弓校弦，一气呵成，$n还没反应过来，一支" HIR "回旋箭" NOR "已带着隐隐风雷声朝自己的$l飞来",
    "damage_type": "劈伤",
    "weapon": HIR "回旋箭" NOR,
    "post_action": (: postarrow1 :),
  ]),
});

mapping ranAction() {
  mapping *actions, acts;
  object me = this_player();
  actions = actions_arrow;
  acts = actions[random(sizeof(actions))];
  while (!mapp(acts))
    acts = actions[random(sizeof(actions))];
  return acts;
}

void init() {
  add_action("do_none", "go");
}

int do_none() {
  if (userp(this_player()) && this_object()->is_fighting(this_player())) {
    say(this_object()->name() + "拦住去路，不让你走！\n\n");
    return 1;
  }
  return 0;
}

void postarrow1(object me, object victim, object weapon, int damage) {
  string msg, str, limb, *limbs;
  int i;
  if (victim && me->is_fighting(victim)) {
    message_vision("\n三支" YEL "乌金箭" NOR "”嗖嗖嗖“的快速飞射，直若夏夜天边的流火一般。\n" NOR, me);
    damage /= 10;
    if (damage > 200) damage = 200;
    if (damage < 10) damage = 10;
    for (i = 0; i < 3; i++) {
      message_vision("\n一支" YEL "乌金箭" NOR "”嗖“的飞过，箭尾在空气中擦出了眩目的火星！\n\n" NOR, me);
      if (random(2)) {
        msg = "“卜嗤”一声，$n" YEL "只觉得$l一凉，鲜血刷的就涌起！\n" NOR;
        str = HIR + COMBAT_D->damage_msg(damage, "刺伤") + NOR;
        str = replace_string(str, "$n", "$n" HIR);
        msg += str;
        limbs = victim->query("limbs");
        limb = limbs[random(sizeof(limbs))];
        msg = replace_string(msg, "$w", NOR YEL "乌金箭" NOR HIR);
        msg = replace_string(msg, "$l", limb);
        message_vision(msg, me, victim);
        victim->receive_damage("kee", damage, me);
        if (damage / 10 > 0)
          victim->receive_wound("kee", damage / 10);
        COMBAT_D->report_status(victim);
      } else message_vision("$n堪堪躲开，吓了流了一脊梁的冷汗。\n", me, victim);
    }
  }
}

void postarrow2(object me, object victim, object weapon, int damage) {
  if (victim && me->is_fighting(victim)) {
    message_vision(HIR "\n回旋箭" NOR "从空中掠过，带出了一道不合常规的轨迹。\n\n" NOR, me);
    if (random(2)) {
      message_vision("\n“啪”的一声，" HIR "回旋箭" NOR "又从$n背后折回，直射$p的后心！！\n", me, victim);
      message_vision("$n哪里知晓这里面还有这等奥妙，立刻给刺了个透心凉！\n\n", me, victim);
      victim->add("kee", -victim->query("kee") / 10);
      COMBAT_D->report_status(victim, 1000);
    }
  }
}

void create() {
  mapping names = NAME_D->random_name("male");
  set_name(names["name"], names["id"]);
  if (random(10) == 0)
    set("title", YEL "北夷将军" NOR);
  else set("title", "北夷士兵");
  set_skill("dodge", 350);
  set_skill("parry", 350);
  set("combat_exp", 100000);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("max_force", 2000);
  set("max_mana", 2000);
  setup();
  set_temp("apply", ([
    "damage": (300 + random(100)),
    "armor": (500 + random(500)),
  ]));
  set("actions", ranAction());
  set("default_actions", ranAction());
}

varargs int receive_damage(string type, int damage, object who) {
  if (query(type) > 200 && damage > query(type) / 50)
    damage = query(type) / 50;
  return ::receive_damage(type, damage, who);
}

varargs int receive_wound(string type, int damage, object who) {
  if (query(type) > 250 && damage > query(type) / 80)
    damage = query(type) / 80;
  return ::receive_damage(type, damage, who);
}

void to_die() {
  int i;
  object ob = this_object();
  object who = query_temp("last_damage_from");
  if (query("title") != "北夷士兵") i = 1 + random(3);
  else i = 1;
  if (who && present(who, environment())) {
    who->add_temp("05中秋/gift_num", i);
    message("channel:chat", sprintf(YEL "『中秋』%s(%s)" YEL "杀死了%s%s" YEL "得到了" + chinese_number(i) + "点的奖励点数。\n" NOR,
      who->query("name"),
      capitalize(who->query("id")),
      query("title"),
      query("name"),), users());
  }
  destruct(ob);
  return;
}
