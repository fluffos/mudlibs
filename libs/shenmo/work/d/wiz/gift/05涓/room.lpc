#include <ansi.h>
inherit ROOM;

mapping dir = ([
  "west": "east",
  "north": "south",
  "east": "west",
  "south": "north",
  "enter": "out",
  "out": "enter",
  "down": "up",
  "up": "down",
]);

void create() {
  set("short", YEL "北伐之路" NOR);
  set("long", "
                誓扫匈奴不顾身，
                五千貂锦丧胡尘。
                可怜无定河边骨，
                犹是春闺梦里人。\n");
  set("alternative_die", 1);
  set("objects", ([
    __DIR__ "bing": random(5) + random(5) + 1,
  ]));
  setup();
}

void alternative_die(object who) {
  object kl;
  if (!userp(who))
    who->to_die();
  else {
    kl = who->query_temp("last_damage_from");
    who->powerup();
    who->add_temp("05中秋/gift_num", -1);
    who->save();

    if (kl && present(kl, this_object()))
      tell_object(who, YEL "『中秋』你被" + kl->name() + YEL "杀死了，你失去了一点的奖励点数。\n" NOR);
    else tell_object(who, YEL "『中秋』你被杀死了，你失去了一点的奖励点数。\n" NOR);
  }
}

int random_exit() {
  string *dirs, exit;
  object r;
  if ((__DIR__ "r_master.lpc")->query_room_num() > 40)
    return 0;
  while (!r)
    r = clone_object("/d/wiz/gift/05中秋/room.lpc");
  dirs = keys(dir);
  exit = dirs[random(sizeof(dirs))];
  if (!query("exits/" + exit)) {
    set("exits/" + exit, r);
    r->set("exits/" + dir[exit], this_object());
    (__DIR__ "r_master.lpc")->add_room_num(r);
    return r->random_exit();
  }
  return 0;
}
