/*********************************
**      国庆礼物:国旗           **
**              flag.c          **
**                      snowtu  **
*********************************/
#include <ansi.h>
#include "/cmds/std/valid_move.h"
inherit ITEM;

mapping plc = ([
  "大唐长安城": "/d/city",
  "东土开封城": "/d/kaifeng",
  "长安近郊": "/d/changan",
  "西域天竺国": "/d/qujing/tianzhu",
  "东海水晶宫": "/d/sea",
  "唐朝将军府": "/d/jjf",
  "西方比丘国": "/d/qujing/biqiu",
  "天竺凤仙郡": "/d/qujing/fengxian",
  "灵台方寸山": "/d/lingtai",
  "大唐西部": "/d/westway/",
]);

string random_place(object obj) {
  int i, j, k;
  string *dirs, dir, title;
  object newob;
  mixed *file, exit;

  dirs = values(plc);

  if (!sizeof(dirs))
    return 0;
  if (!obj || !objectp(obj))
    return 0;

  i = random(sizeof(dirs));
  title = keys(plc)[i];

  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file))
    return 0;

  for (k = 0; k < 30; k++) {
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight") ||
          newob->query("no_magic") ||
          newob->query("no_mieyao") ||
          !(exit = newob->query("exits")) ||
          sizeof(exit) < 1)
          continue;
        else break;
      } else return 0;
    } else return 0;
  }
  if (!objectp(newob))
    return 0;
  else if (obj->move(newob))
    return sprintf(HIR "但见%s" HIR "上红光一闪，一" NOR YEL "%s" NOR HIR "%s" HIR "(%s)朝向" NOR YEL "%s的" + newob->query("short") + NOR HIR "方向一闪而过....\n" NOR,
      this_object()->name(), obj->query("unit"), obj->query("name"),
      capitalize(obj->query("id")), title);
  else return 0;
}

void create() {
  set_name(HIR "红旗" NOR, ({ "hong qi", "qi", "flag" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "面");
    set("value", 10000);
    set("long", HIR "一面红灿灿的红旗，试着将它舞(wave)起来看看。\n" NOR);
  }
  setup();
}

void init() {
  add_action("do_wave", "wave");
}

int do_wave(string arg) {
  object gift;
  object me = this_player();
  object qi = this_object();
  string msg, *wave_msg = ({
    "$N将$n拿在手中，兴奋的舞动了几下。\n",
    "$N兴奋的舞动着$n，嘴里嘟嘟囔囔的吼叫着什么。。。\n",
    "$N边喊边舞动着$n,兴奋的一塌糊涂。\n",
    "$N一个箭步，窜起老高，在半空将$n舞动了几下。\n",
  });

  if (arg && id(arg)) {
    if (!valid_move(me))
      return notify_fail("你正忙着呢。\n");
    if (me->query("force") < 500 || me->query("kee") < 500)
      return notify_fail("你太累了。\n");
    message_vision(wave_msg[random(sizeof(wave_msg))], me, qi);
    me->start_busy(1 + random(3));
    me->add("force", -500);
    me->add("kee", -500);
    if (me->query("04国庆"))
      return 1;
    if (objectp(me->query_temp("04国庆"))) {
      if (stringp(msg = me->query_temp("04国庆/msg")))
        tell_object(me, msg);
      else {
        tell_object(me, "你太累了，还是休息休息吧。\n");
        me->delete_temp("04国庆");
      }
      return 1;
    }
    switch (random(10)) {
      case 9:
        gift = new(__DIR__ "skill-obj");
        break;
      case 0:
        gift = new(__DIR__ "pot-obj");
        break;
      case 5:
        gift = new(__DIR__ "wx-obj");
        break;
      default:
        gift = new(__DIR__ "dx-obj");
    }
    gift->set("owner", me->query("id"));
    gift->set("name", me->name() + "的" + gift->query("name"));
    msg = random_place(gift);
    if (msg && stringp(msg)) {
      me->set_temp("04国庆", gift);
      me->set_temp("04国庆/msg", msg);
      tell_object(me, msg);
    } else {
      tell_object(me, "你太累了，还是休息休息吧。\n");
      me->delete_temp("04国庆");
    }
    return 1;
  }
  return 0;
}
