/*********************************
**      国庆礼物·妖怪          **
**              skill-obj.c     **
*********************************/

#include <ansi.h>
inherit NPC;

void destruct_me()
{
object who;
message_vision("$N往地底一钻，廖无踪迹。。。。\n",this_object());
if ( query("owner") )
        {
        who=find_player(query("owner"));
        if ( who )
                message("channel:chat",sprintf(HIG"【"HIR"礼物界"HIG"】"HIC"欢喜菩萨(Pusa)：哈哈%s(%s)找我不到，真是扫兴。。。。\n"NOR,
                                                who->query("name"),capitalize(who->query("id")) ),users() );
        }
destruct(this_object());
}

void create()
{
set_name("国庆妖怪",({"yao guai"}));
set("gender","男性");
set("unit","头");
set("age",20);
set("long","国庆期间的妖怪，杀了它会有丰富的奖励哦。\n");
setup();
call_out("destruct_me",300);
}

void init()
{
object who;
int kee,force,skill;

add_action("do_none","",1);

if ( !query("owner") )
        return;
else if ( query("over") )
        return;
else    {
        who = find_player(query("owner"));
        if ( !who )
                call_out("desruct_me",1+random(5));
        else    {
                kee = who->query("max_kee");
                if ( kee<1000 )
                        kee = 1000;
                force = who->query("max_force");
                if ( force<1000 )
                        force = 1000;
                skill  = who->query_skill("force",1);
                if ( skill<100 )
                        skill = 100;
                skill = skill*3/2;
                set("max_kee",kee);
                set("max_sen",kee);
                set("max_force",force);
                set("max_mana",force);
                set("combat_exp",who->query("combat_exp")+random(10000));
                set("daoxing",who->query("combat_exp")+random(10000));
                set_skill("unarmed",skill);
                set_skill("parry",skill);
                set_skill("dodge",skill);
                set("long",query("long")+"可惜它是"+who->query("name")+"("+capitalize(who->query("id"))+")需要杀的。\n" );
                set("over",1);
                }
        SDS_D->powerup(this_object(),1);
        }
}

int do_none()
{
string arg  = query_verb();
string *nocmds = ({
                "cast","perform","bian","apply","ji","fight",
});
if ( member_array(arg,nocmds)!=-1 )
        {
        message_vision("$N对着$n笑骂道：安安心心的过节日吧。\n",this_object(),this_player());
        return 1;
        }
return 0;
}

void die()
{
object who;
object where;
mapping skills;
string *skill;
int i,k;

who = query_temp("last_damage_from");
if ( !who )
        who = query_temp("last_opponent");
where = environment();
if ( !who || !present(who,where) || who->query("04国庆") || query("name")=="欢喜菩萨" )
        {
        SDS_D->powerup(this_object(),1);
        return;
        }

if ( strsrch(where->query("short"),"祭台")!=-1 )
        {
        SDS_D->powerup(this_object());
        command("say 在这里打不过瘾，陪我出去过过招。。。\n");
        random_move();
        return;
        }

message_vision("$N哈哈一笑，献出了菩萨的真身，对着$n一稽首：节日快乐。\n",this_object(),this_player());
set_name("欢喜菩萨",({"huanxi pusa","pusa"}));
skills = who->query_skills();
skill = keys(skills);
i = sizeof(skill);
while(i--)
        {
        k = random(who->query("kar"))/10;
        if ( k>0 )
                {
                who->set_skill(skill[i],who->query_skill(skill[i],1)+k);
                tell_object(who,HIG"你的"NOR YEL" "+to_chinese(skill[i])+NOR HIG" 增加了 "NOR YEL+chinese_number(k)+NOR HIG" 级！\n"NOR);
                }
        else    {
                k = who->query_skill("literate",1)*10000;
                k = 1000+random(k);
                who->improve_skill(skill[i],k);
                tell_object(who,HIC"你的 "NOR YEL+to_chinese(skill[i])+NOR HIC" 增加了 "NOR YEL+chinese_number(k)+NOR HIC" 点经验！\n"NOR);
                }
        }
who->set("04国庆",1);
message_vision("菩萨架起一道祥云飞上了天空。\n",who);
destruct(this_object());
return;
}       
