/*********************************
**      国庆礼物·道具          **
**              wx-obj.c        **
*********************************/

#include <ansi.h>
inherit ITEM;

void destruct_me()
{
object who;
message_vision("$N往地底一钻，廖无踪迹。。。。\n",this_object());
if ( query("owner") )
        {
        who=find_player(query("owner"));
        if ( who )
                message("channel:chat",sprintf(HIG"【"HIR"礼物界"HIG"】"HIC"欢喜菩萨(Pusa)：哈哈%s(%s)找我不到，真是扫兴。。。。\n"NOR,
                                                who->query("name"),capitalize(who->query("id")) ),users() );
        }
destruct(this_object());
}

void create()
{
set_name("国庆礼物",({"guoqing liwu"}));
set("long","国庆期间的礼物，吃了它会有丰富的奖励哦。\n");
set("unit","个");
set("no_get",1);
set("no_give",1);
setup();
call_out("destruct_me",300);
}

void init()
{
add_action("do_eat","eat");
}

int do_eat(string arg)
{
int wx = random(10000)+random(10000)+random(10000)+random(10000)+random(10000)+50000;
if ( id(arg) )
        {
        message_vision("$N拿起$n放在鼻边闻了闻，",this_player(),this_object());
        this_player()->start_busy(3);
        if ( this_player()->query("id")!=query("owner")
          || random(this_player()->query("kar"))<20 )
                message_vision("$N疑神疑鬼地将$n又放回原处。。。。\n",this_player(),this_object());
        else    {
                message_vision("$N放心的将$n放入口中嚼了嚼。。。。\n",this_player(),this_object());
                this_player()->add("combat_exp",wx);
                message_vision("$N一闪，变回了真身，原来是欢喜菩萨。。。。\n",this_object());
                tell_object(this_player(),"菩萨向你祝贺：节日快乐。\n");
                tell_object(this_player(),HIY"你得到了 "NOR YEL+chinese_number(wx)+HIY" 点武学。\n"NOR);
                this_player()->set("04国庆",1);
                destruct(this_object());
                }
        return 1;
        }
return 0;
}


                                
