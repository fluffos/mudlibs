/*********************************
** 中秋礼物                     **
** 流程(data):                  **
**      1. 天神(tian_asked)     **
**      2. 八月(moon_asked)     **
**      3. 奔月(yao_eated)      **
**      4. 嫦娥(item_found)     **
**      5. 结束(geted)          **
**              snowtu/2004/09  **
*********************************/

#include <ansi.h>
inherit NPC;

string check_me();

void create() {
  set_name("当值天曹", ({ "tian shen" }));
  set("long", "天宫今日的当值天官，可以向他询问今日的新消息。\n" NOR);
  set("gender", "男性");
  set("age", 43);
  set("per", 25);

  set("inquiry", ([
    "消息": "今日是人间的中秋佳节，团圆之日。",
    "中秋": (: check_me :),
  ]));
  setup();
}

string check_me() {
  object obj;
  object me = this_player();
  object ob = this_object();

  if (me->query("04中秋/tian_asked"))                           //已经问过天神
  {
    if (me->query("04中秋/geted"))                        //已经得到过月饼
      return "今日是人间的中秋佳节，团圆之日。";
    else if (me->query("04中秋/item_found"))              //已经找过嫦娥需要的材料
    {
      message_vision(CYN "$N" CYN "说道：快去向嫦娥仙子索要月饼吧。\n" NOR, ob);
      message_vision(
        HIC "$N" HIC "从怀中取出值日星旗朝$n" HIC "一挥，一道祥云平地升起，载着$n" HIC "朝天边飞去。\n\n\n" NOR,
        ob,
        me
      );
      if (me->move("/d/wiz/gift/中秋/moon")) {
        message_vision(HIY "\n到了！$N" HIY "双足一点，从云上轻飘飘的落在平地之上。\n\n" NOR, me);
        me->start_busy(1);
        return "早去早回....";
      } else return "广寒宫暂不见客，你还是待会再去吧。";
    } else if (me->query("04中秋/yao_geted"))               //已取到不死药
    {
      if (objectp(obj = present("bu si yao", me)))
        return "赶紧吃了不死药去找嫦娥仙子吧。";
      else {
        message_vision(CYN "$N" CYN "说道：快去找嫦娥仙子吧。\n" NOR, ob);
        message_vision(
          HIC "$N" HIC "从怀中取出值日星旗朝$n" HIC "一挥，一道祥云平地升起，载着$n" HIC "朝天边飞去。\n\n\n" NOR,
          ob,
          me
        );
        if (me->move("/d/wiz/gift/中秋/moon")) {
          message_vision(HIY "\n到了！$N" HIY "双足一点，从云上轻飘飘的落在平地之上。\n\n" NOR, me);
          me->start_busy(1);
          return "早去早回....";
        } else return "广寒宫暂不见客，你还是待会再去吧。";
      }
    } else if (me->query("04中秋/moon_asked"))
      return "你还是向王母娘娘打听 不死药　的消息吧。";
    else {
      tell_object(me, HIG + name() + HIG "在你耳边悄声说道：小神还是送你去日月山找今日的主神--八月殿下吧。\n" NOR);
      message_vision(
        HIC "$N" HIC "从怀中取出值日星旗朝$n" HIC "一挥，一道祥云平地升起，载着$n" HIC "朝天边飞去。\n\n\n" NOR,
        ob,
        me
      );
      if (me->move("/d/wiz/gift/中秋/riyue-shan")) {
        message_vision(HIY "\n到了！$N" HIY "双足一点，从云上轻飘飘的落在平地之上。\n\n" NOR, me);
        me->start_busy(1);
        return "呵呵，又送走一个。";
      } else return "你还是休息一下再去吧。";
    }
  }

  message_vision(CYN "$N" CYN "说道：今日是中秋佳节，听说玉帝会在灵宵殿宴请群雄。\n" NOR, ob);
  me->set("04中秋/tian_asked", 1);
  if (me->save()) {
    tell_object(me, HIG + name() + HIG "在你耳边悄声说道：小神还是送你去日月山找今日的主神--八月殿下吧。\n" NOR);
    message("vision", name() + "在" + me->name() + "耳边低语了几句。\n", environment(me), me);
    message_vision(
      HIC "$N" HIC "从怀中取出值日星旗朝$n" HIC "一挥，一道祥云平地升起，载着$n" HIC "朝天边飞去。\n\n\n" NOR,
      ob,
      me
    );
    if (me->move("/d/wiz/gift/中秋/riyue-shan")) {
      message_vision(HIY "\n到了！$N" HIY "双足一点，从云上轻飘飘的落在平地之上。\n\n" NOR, me);
      me->start_busy(1);
      return "呵呵，又送走一个。";
    } else return "你还是休息一下再去吧。";
  } else return "想要今年的礼物，待会再来找我。";   //如果Player Save失败，需要重新ask
}
