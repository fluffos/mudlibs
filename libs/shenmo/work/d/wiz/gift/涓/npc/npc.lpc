/*********************************
**      中秋礼物·npc           **
**              npc.c           **
*********************************/

#include <ansi.h>
inherit NPC;

string check_me();

void create() {
  set_name("礼物大使", ({ "liwu dashi" }));
  set("title", "落第秀才");
  set("中秋", 1);
  set("long", "一名落第的秀才，在世间无所事事，瞎捣活。\n");
  set("gender", "男性");
  set("age", 16 + random(35));
  set("attitude", "friendly");
  set("per", 11 + random(30));
  set("max_kee", 4500);
  set("max_gin", 800);
  set("max_sen", 4500);
  set("force", 4000);
  set("max_force", 5000);
  set("force_factor", 125);
  set("max_mana", 5000);
  set("mana", 4000);
  set("mana_factor", 100);
  set("combat_exp", 8000000);
  set_skill("literate", 300);
  set_skill("unarmed", 350);
  set_skill("dodge", 350);
  set_skill("force", 350);
  set_skill("parry", 350);
  set_skill("sword", 350);
  set_skill("spells", 350);
  set_skill("moonshentong", 350);
  set_skill("whip", 350);
  set_skill("baihua-zhang", 350);
  set_skill("moonforce", 350);
  set_skill("snowsword", 350);
  set_skill("moondance", 350);
  map_skill("spells", "moonshentong");
  map_skill("blade", "xuanhu-blade");
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "moonforce");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  map_skill("dodge", "moondance");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: cast_spell, "mihun" :),
    (: cast_spell, "arrow" :)
  }));
  set("inquiry", ([
    "宠物": (: check_me :),
  ]));
  setup();
  carry_object("/d/obj/cloth/linen.lpc")->wear();
}

void destruct_me() {
  write(name() + "急急忙忙的离开了。\n");
  destruct(this_object());
}

string check_me() {
  object obj;
  object me = this_player();
  if (me->query_temp("04中秋/wangmu_item/npc") != this_object())
    return "我又没偷你家的！";
  if (!me->query_temp("04中秋_xiucai_gived"))
    return "想要可以，给我五十两纹银做生意。";
  obj = new("/d/wiz/gift/中秋/obj/item");
  obj->set_name(
    me->query_temp("04中秋/wangmu_item/o_name"),
    ({ me->query_temp("04中秋/wangmu_item/o_id"), })
  );
  obj->set("中秋", 1);
  if (obj->move(me)) {
    message_vision("$N将" + obj->name() + "交给了$n。\n", this_object(), me);
    call_out("destruct_me", 5);
    return "节日快乐。";
  } else return "你身上东西太多了吧。";
}

int accept_object(object me, object obj) {
  if (obj->query("money_id") && obj->value() >= 5000) {
    command("thank");
    me->set_temp("04中秋_xiucai_gived", 1);
    return 1;
  }
  return 0;
}
