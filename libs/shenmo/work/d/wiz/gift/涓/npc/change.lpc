/*********************************
**      中秋礼物·嫦娥          **
**              change          **
*********************************/

#include <ansi.h>
inherit NPC;

string check_me();

string *poems = @@POEM
花间一壶酒，独酌无相亲。
举杯邀明月，对影成三人。
月既不解饮，影徒随我身。
暂伴月将影，行乐须及春。
我歌月徘徊，我舞影零乱。
醒时同交欢，醉后各分散。
永结无情游，相期邈云汉。
明月出天山，苍茫云海间。
长风几万里，吹度玉门关。
汉下白登道，胡窥青海湾。
由来征战地，不见有人还。
戍客望边色，思归多苦颜。
高楼当此夜，叹息未应闲。
床前明月光，疑是地上霜。
举头望明月，低头思故乡。
满月飞明镜，归心折大刀。
转蓬行地远，攀桂仰天高。
水路疑霜雪，林栖见羽毛。
此时瞻白兔，直欲数秋毫。
昔年八月十五夜，曲江池畔杏园边。
今年八月十五夜，湓浦沙头水馆前。
西北望乡何处是，东南见月几回圆。
昨风一吹无人会，今夜清光似往年。
玉颗珊珊下月轮，殿前拾得露华新。
至今不会天中事，应是嫦娥掷与人。
POEM;

mapping plc = ([
  "大唐长安城": "/d/city",
  "东土开封城": "/d/kaifeng",
  "长安近郊": "/d/changan",
  "西域天竺国": "/d/qujing/tianzhu",
  "东海水晶宫": "/d/sea",
  "唐朝将军府": "/d/jjf",
  "西方比丘国": "/d/qujing/biqiu",
  "天竺凤仙郡": "/d/qujing/fengxian",
  "灵台方寸山": "/d/lingtai",
  "大唐西部": "/d/westway/",
]);

mapping tasks = ([
  "莲子": ({ "lian zi", "一把清馨的莲子，洗洗干净可以做八宝粥。", }),
  "面粉": ({ "mian fen", "一团纱布包裹着的面粉。", }),
  "赤豆": ({ "chi dou", "一包红艳的赤豆，拿来煮稀饭不错。", }),
  "杏仁": ({ "xing ren", "一包杏仁，可以拿来做八宝粥。", }),
  "酥油": ({ "su you", "一瓶油腻腻的酥油。", }),
  "桂花": ({ "gui hua", "一些桂花，发出清馨的气味。", }),
  "雪山寒冰水": ({ "han shui", "一瓶采自大雪山后山的寒冰水。", }),
  "海带": ({ "hai dai", "一包南海深海中采集到的海带。", }),
  "人参": ({ "ren shen", "一把长白山深山老林里采集到的人参。", }),
  "苜蓿": ({ "mu xu", "一包苜蓿，透过包裹的花布可以闻到它那独特的清香。", }),
  "鹿茸": ({ "lu rong", "长白山的鹿茸是天山闻名的。", }),
  "犀角": ({ "xi jiao", "西域特产的犀牛角，有舒经烙骨的功效。", }),
]);

void create() {
  set_name("嫦娥", ({ "chang e", "change", "chang", "master" }));
  set("long", HIC "因偷食丈夫后羿的不死药而飞奔月宫的广寒宫主人。\n" NOR);
  set("title", WHT "广寒宫主人" NOR);
  set("nickname", HIG "此时瞻白兔，直欲数秋毫" NOR);
  set("gender", "女性");
  set("age", 20);
  set("class", "xian");
  set("attitude", "friendly");
  set("per", 35);
  set("int", 30);
  set("max_kee", 900);
  set("max_gin", 600);
  set("max_sen", 800);
  set("force", 800);
  set("max_force", 800);
  set("force_factor", 50);
  set("max_mana", 600);
  set("mana", 600);
  set("mana_factor", 40);
  set("combat_exp", 400000);
  set("daoxing", 800000);

  set_skill("literate", 80);
  set_skill("unarmed", 80);
  set_skill("dodge", 180);
  set_skill("force", 80);
  set_skill("parry", 80);
  set_skill("sword", 80);
  set_skill("spells", 80);
  set_skill("moonshentong", 80);
  set_skill("baihua-zhang", 80);
  set_skill("moonforce", 80);
  set_skill("snowsword", 80);
  set_skill("moondance", 200);

  map_skill("spells", "moonshentong");
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "moonforce");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  map_skill("dodge", "moondance");

  set("inquiry", ([
    "月饼": (: check_me :),
  ]));

  setup();
  carry_object("/d/moon/obj/luoyi")->wear();
  carry_object("/d/moon/obj/feijian")->wield();
}

void init() {
  if (random(10) == 1)
    say(CYN + name() + CYN "长叹一声：" + poems[random(sizeof(poems))] + "\n" NOR);
}

string random_place(object obj) {
  int i, j, k;
  string *dirs, dir, title;
  object newob;
  mixed *file, exit;

  dirs = values(plc);

  if (!sizeof(dirs)) return 0;

  i = random(sizeof(dirs));
  title = keys(plc)[i];

  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file))
    return 0;

  for (k = 0; k < 30; k++) {
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight") ||
          newob->query("no_magic") ||
          newob->query("no_mieyao") ||
          !(exit = newob->query("exits")) ||
          sizeof(exit) < 1)
          continue;
        else break;
      } else return 0;
    } else return 0;
  }
  if (!objectp(newob))
    return 0;
  else if (obj->move(newob))
    return sprintf(CYN "妾身正在为玉帝赶制" HIC "中秋月饼" NOR CYN "，尚缺" NOR HIR "%s" NOR CYN "(" NOR HIR "%s" NOR CYN "),听说在" NOR HIR "%s" NOR CYN "的" NOR HIR "%s" NOR CYN "可以找到，将之寻来给我吧。",
      obj->query("name"), capitalize(obj->query("id")), title, newob->query("short"));
  else return 0;
}

string check_me() {
  mapping task;
  string name, id, look, *str, msg;
  object fu = new("/d/wiz/gift/中秋/obj/fu");
  object item = new("/d/wiz/gift/中秋/obj/item");
  object me = this_player();

  if (me->query("04中秋/item_found"))
    return "你直接向玉兔要就是了....中秋快乐....";

  if (!me->query("04中秋/yao_eated"))
    return "咦？你是怎么来的？";

  if (me->is_busy()) {
    tell_object(me, "你正忙着呢。\n");
    return 0;
  }

  task = me->query_temp("change_task");
  if (!task || !mapp(task)) {
    str = keys(tasks);
    name = str[random(sizeof(str))];
    id = tasks[name][0];
    look = tasks[name][1];
    item->set_name(name, ({ id }));
    item->set("long", look);
    item->set("owner", me->query("id"));
    msg = random_place(item);
    me->start_busy(1 + random(3));
    if (msg && stringp(msg)) {
      me->set_temp("change_task", ([
        "name": name,
        "id": id,
      ]));
      if (fu->move(me)) {
        tell_object(me, CYN + name() + CYN "递给你一张月符，道：待会可以用这个回来找我。\n" NOR);
        return msg;
      } else return "你先休息休息吧。";
    } else return "稍等片刻吧。";
  } else {
    me->delete_temp("change_task");
    me->add("combat_exp", -50 - random(50));
    me->save();
    return "你真是没用，唉~~我还是多给你一次机会吧。";
  }
}

int accept_object(object me, object obj) {
  if (obj->query("name") == me->query_temp("change_task/name")
    && obj->query("id") == me->query_temp("change_task/id")
    && obj->query("owner") == me->query("id")
    && obj->query("中秋")) {
    command("thank");
    me->set("04中秋/item_found", 1);
    me->save();
    return 1;
  }
  return 0;
}
