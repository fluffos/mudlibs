/*********************************
**      中秋礼物·太阳          **
**              taiyang **
*********************************/

#include <ansi.h>
inherit NPC;

void create() {
  set_name("九足烏", ({ "tai yang" }));
  set("age", 1000);
  set("gender", "男");
  set("title", HIR "太阳" NOR);
  set("nickname", BLINK + RED "九矅星君" NOR);
  set("limbs", ({
    "左翅", "右翅", "喙部", "眼睛", "后脑", "胸部",
    "尾部", "左足", "右足", "中足",
  }));
  set("inquiry", ([
    "太阳": "可恼！某那九个兄弟被后羿匹夫尽数射杀，要不是天帝求情，某之性命堪忧。",
  ]));
  setup();
}

void init() {
  remove_call_out("do_attack");
  call_out("do_attack", 1 + random(5));
}

void do_attack() {
  object env = environment();
  object *inv;
  string *msgs;
  int i;

  if (env->query("short") != "日月山")
    return;

  if (random(3) == 0) {
    msgs = ({
      "$N长叹了一口气，",
      "$N”呼”的长叹了一口气，",
      "$N长呼了一口气，",
      "$N将双翅展开，",
      "$N扭了扭脖子，生了个懒腰，",
    });
    message_vision(HIR "\n" + msgs[random(sizeof(msgs))] + "四下里立刻变得一片闷热。\n\n" NOR, this_object());
    inv = all_inventory(env);
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("water") <= 0 || !userp(inv[i]))
        continue;
      else {
        if (inv[i]->query("water") <= 5)
          inv[i]->set("water", 0);
        else inv[i]->add("water", -5);
        tell_object(inv[i], "你只觉得口干舌燥，忍不住咽了口吐沫。\n");
      }
    }
  }
  remove_call_out("do_attack");
  call_out("do_attack", 3 + random(5));
}
