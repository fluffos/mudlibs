/*********************************
**      中秋礼物·玉兔          **
**              yutu            **
*********************************/

#include <ansi.h>
#include "msg.h"
inherit NPC;

string check_me();
string *poems = @@POEM
花间一壶酒，独酌无相亲。
举杯邀明月，对影成三人。
月既不解饮，影徒随我身。
暂伴月将影，行乐须及春。
我歌月徘徊，我舞影零乱。
醒时同交欢，醉后各分散。
永结无情游，相期邈云汉。
明月出天山，苍茫云海间。
长风几万里，吹度玉门关。
汉下白登道，胡窥青海湾。
由来征战地，不见有人还。
戍客望边色，思归多苦颜。
高楼当此夜，叹息未应闲。
床前明月光，疑是地上霜。
举头望明月，低头思故乡。
满月飞明镜，归心折大刀。
转蓬行地远，攀桂仰天高。
水路疑霜雪，林栖见羽毛。
此时瞻白兔，直欲数秋毫。
昔年八月十五夜，曲江池畔杏园边。
今年八月十五夜，湓浦沙头水馆前。
西北望乡何处是，东南见月几回圆。
昨风一吹无人会，今夜清光似往年。
玉颗珊珊下月轮，殿前拾得露华新。
至今不会天中事，应是嫦娥掷与人。
POEM;

void create()
{
set_name("玉兔",({"yu tu","tu"}));
set("中秋",1);
set("long","一只活泼可爱的小白兔，红眼睛，三瓣嘴，两只耳朵长乎乎。\n");
set("gender", "女性");
set("age", 4);
set("attitude", "friendly");
set("per", 30);
set("inquiry", ([
          "月饼" : (: check_me :),
]));
set("nickname",WHT"桂下捣药童"NOR);
setup();
carry_object("/d/moon/obj/daoyaochu")->wield();
}

int accept_object(object me,object obj)
{
if ( obj->query("name")=="月符"
  && obj->query("中秋") )
        return 1;
return 0;
}

string check_me()
{
int i,flag=0;
object *inv;
object cake = new("/d/wiz/gift/中秋/obj/cake");
object me = this_player();

if ( me->is_busy() )
        return "你正忙着呢。";

if ( me->query("04中秋/geted") )                //已经拿过
        return "你不是已经拿过了吗？";

if ( !me->query("04中秋/tian_asked")
   ||!me->query("04中秋/moon_asked")
   ||!me->query("04中秋/yao_eated") )
        return "月宫是个好地方，可惜太冷。";    //前面没完成

if ( !me->query("04中秋/item_found") )          //没找材料
        return "你还是先帮主人找材料吧。";

inv = all_inventory(me);
for ( i=0;i<sizeof(inv);i++ )
        {
        if ( inv[i]->query("id")=="yue fu"
          && inv[i]->query("中秋") )
                {
                flag++;
                break;
                }
        }
if ( flag>0 )
        return "你还是先把月符还给我吧。";

i = me->query_kar();
i/= 5;
i = random(i);
if ( i<1 )
        i = 1;
if ( i>5 )
        i = 5;
cake->set("num",10+i);                  //可以吃多少次,每次加的pot参照 cake文件
if ( cake->move(me) )
        {
        me->set("04中秋/geted",1);
        me->save();
        me->delete_temp("04中秋");
        message_vision("$N递给$n一块月饼，笑嘻嘻的说：中秋快乐。\n",this_object(),me);
        message("channel:chat",random_msg(),users());
     return poems[random(sizeof(poems))];
        }
return "稍等片刻。";
}

