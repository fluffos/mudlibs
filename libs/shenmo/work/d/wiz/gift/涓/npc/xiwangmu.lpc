/*********************************
**      中秋礼物·物件          **
**              item            **
*********************************/

#include <ansi.h>
inherit NPC;

string check_me();
object random_place();

mapping task_obj = ([
  "青鸟": "qing niao",
  "悬龙": "xuan long",
  "朱雀": "zhu que",
  "白虎": "bai hu",
  "玄武": "xuan wu",
  "飞鹤": "fei he",
  "百合": "bai he",
  "雪鸟": "xue niao",
  "赤鹫": "chi jiu",
  "金鲤": "jin li",
  "乌狞": "wu ning",
]);

mapping task_npc = ([
  "赵仁": "ren",
  "赵义": "yi",
  "赵礼": "li",
  "赵智": "zhi",
  "赵信": "xin",
  "赵悌": "ti",
  "赵孝": "xiao",
  "赵廉": "lian",
]);

string *dirs = ({
  "/d/city",
  "/d/kaifeng",
  "/d/westway",
  "/d/changan",
  "/d/meishan",
  "/d/gao",
});

void create() {
  set_name("西王母", ({ "xi wangmu", "xi" }));
  set("中秋", 1);
  set("long", @LONG
西华至妙生伊川，穆王八骑访昆仑。
但见她头戴玉胜，长着虎齿豹尾，不怒而威。正是昆仑西王母是也。
LONG);
  set("gender", "女性");
  set("age", 100);
  set("attitude", "friendly");
  set("rank_info/respect", "老太太");
  set("cor", 30);
  set("per", 30);
  set("looking", "面色红润，满脸福态。");
  set("max_kee", 4500);
  set("max_gin", 800);
  set("max_sen", 4500);
  set("force", 4000);
  set("max_force", 5000);
  set("force_factor", 125);
  set("max_mana", 5000);
  set("mana", 4000);
  set("mana_factor", 100);
  set("combat_exp", 8000000);
  set_skill("literate", 300);
  set_skill("unarmed", 350);
  set_skill("dodge", 350);
  set_skill("force", 350);
  set_skill("parry", 350);
  set_skill("sword", 350);
  set_skill("spells", 350);
  set_skill("moonshentong", 350);
  set_skill("whip", 350);
  set_skill("baihua-zhang", 350);
  set_skill("moonforce", 350);
  set_skill("snowsword", 350);
  set_skill("moondance", 350);
  map_skill("spells", "moonshentong");
  map_skill("blade", "xuanhu-blade");
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "moonforce");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  map_skill("dodge", "moondance");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: cast_spell, "mihun" :),
    (: cast_spell, "arrow" :)
  }));
  set("inquiry", ([
    "不死药": (: check_me :),
  ]));
  create_family("月宫", 1, "红");
  setup();
  carry_object("/d/obj/cloth/tianyi.lpc")->wear();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
  carry_object("/d/ourhome/obj/shoes")->wear();
}

object random_place() {
  int i, j, k;
  object newob;
  mixed *file, exit;

  if (!sizeof(dirs)) return random_place();

  i = random(sizeof(dirs));

  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file))
    return random_place();

  for (k = 0; k < 30; k++) {
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight") ||
          newob->query("no_magic") ||
          newob->query("no_mieyao") ||
          !(exit = newob->query("exits")) ||
          sizeof(exit) < 1)
          continue;
        else break;
      } else return random_place();
    } else return random_place();
  }
  if (objectp(newob))
    return newob;
  else return random_place();
}


string check_me() {
  string o_name, o_id, n_name, n_id, plc, *str;
  mapping task;
  object me, item, npc, place;

  me = this_player();

  if (!me->query("04中秋/moon_asked"))
    return 0;

  if (me->query("04中秋/yao_get"))
    return 0;

  if (!me->query_temp("04中秋/wangmu_gived")) {
    if (mapp(task = me->query_temp("04中秋/wangmu_item"))) {
      if (objectp(task["npc"]))
        return "我不是要你去" + task["place"] + "找" + task["npc"]->short() + " 的吗？";
      else return 0;       //不存在，需要quit再来问
    } else {
      str = keys(task_obj);
      o_name = str[random(sizeof(str))];
      o_id = task_obj[o_name];
      place = random_place();
      if (!place || !objectp(place))
        error(__FILE__ "can't find the random_place.\n");
      plc = place->query("short");
      str = keys(task_npc);
      n_name = str[random(sizeof(str))];
      n_id = "zhao " + task_npc[n_name];
      npc = new(__DIR__ "npc");
      npc->set_name(n_name, ({ n_id, "zhao" }));
      npc->save();
      if (npc->move(place)) {
        me->set_temp("04中秋/wangmu_item", ([
          "o_name": o_name,
          "o_id": o_id,
          "place": plc,
          "npc": npc,
        ]));
        return "哀家有小宠名曰" + o_name + "，为" + plc + "的" + npc->short() + "所得，你去将之寻来与吾。";
      } else return "哀家正忙，你待会再来吧。";
    }
  } else {
    npc = new("/d/wiz/gift/中秋/obj/yao");
    if (npc->move(me)) {
      me->set("04中秋/yao_get", 1);
      me->save();
      message_vision("$N给$n一个不死药。\n", this_object(), me);
      return "好好珍惜。";
    } else return "你身上物什太多了吧。";
  }
}

int accept_object(object me, object obj) {
  if (obj->query("id") != me->query_temp("04中秋/wangmu_item/o_id")
    || obj->query("name") != me->query_temp("04中秋/wangmu_item/o_name")
    || !obj->query("中秋")
    || me->query_temp("04中秋/wangmu_gived"))
    return 0;
  message_vision("$N高兴的拍拍$n的小脑袋：“小家伙有前途...”\n", this_object(), me);
  me->set_temp("04中秋/wangmu_gived", 1);
  return 1;
}
