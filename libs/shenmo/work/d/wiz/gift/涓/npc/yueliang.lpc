/*********************************
**      中秋礼物·月亮          **
**              yueliang        **
*********************************/

#include <ansi.h>
inherit NPC;

string check_me();

void create() {
  set_name("玉冰蟾", ({ "yue liang" }));
  set("age", 20);
  set("per", 40);
  set("gender", "女");
  set("title", HIC "月亮" NOR);
  set("nickname", BLINK + WHT "九华仙子" NOR);
  set("inquiry", ([
    "太阳": "可恼！奴家那九个兄长被后羿匹夫尽数射杀，要不是天帝求情，奴家一门休矣。",
    "不死药": (: check_me :),
  ]));
  setup();
}

string check_me() {
  object npc, room;
  object me = this_player();

  if (me->is_busy()) {
    tell_object(me, "你正忙着呢。\n");
    return 0;
  }
  if (me->query("04中秋/moon_asked"))
    return "不是叫你去王母娘娘那吗？";
  if (!me->query("04中秋/tian_asked"))
    return "你怎么知道这事？";
  if (me->query_temp("04中秋/moon_num") != 8)
    return "你还是找我八" + ({ "姐", "妹", })[random(2)] + "吧。";
  me->set("04中秋/moon_asked", 1);
  if (me->save()) {
    me->delete_temp("04中秋");
    room = find_object("/d/moon/wangmu_room");
    if (!room)
      error(__FILE__ "can't find the room it's file is '/d/moon/wangmu_room.c' \n");
    if (objectp(npc = present("xi wangmu", room))) {
      if (!npc->query("中秋") && !userp(npc))
        destruct(npc);
    }
    if (!present("xi wangmu", room)) {
      npc = new(__DIR__ "xiwangmu");
      npc->move(room);
    }
    return "听说王母娘娘那有不死之药，吃了可以长生不老，你去索了试试。";
  }
  return "梢侯片刻。";
}
