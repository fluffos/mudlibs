/*********************************
**      中秋礼物·不死药                **
**              yao             **
*********************************/

#include <ansi.h>
inherit ITEM;

void create() {
  set_name("不死仙药", ({ "bu si yao" }));
  set_weight(100);
  set("unit", "粒");
  set("no_give", 1);
  set("no_drop", 1);
  set("no_get", 1);
  set("value", 0);
  set("no_sell", 1);
  setup();
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me = this_player();

  if (id(arg)) {
    if (me != environment())
      return 0;
    if (!me->query("04中秋/yao_get"))
      return 0;
    if (me->query("04中秋/yao_eated"))
      return 0;
    message_vision(HIG "\n$N兴奋的将$n放在嘴中狠嚼。\n\n" NOR, me, this_object());
    message_vision("但见$N身形似乎渐渐浮起...", me);
    if (me->move("/d/wiz/gift/中秋/moon")) {
      tell_object(me, "\n你眼前一花，已身在广寒宫前。\n");
      me->set("04中秋/yao_eated", 1);
      me->delete_temp("04中秋");
      me->save();
      destruct(this_object());
      return 1;
    } else message_vision("结果“轰隆”一声，一道闪电把$N又劈回地面！\n", me);
    return 1;
  }
  return 0;
}
