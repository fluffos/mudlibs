/*********************************
**      中秋礼物·月符          **
**              fu              **
*********************************/

#include <ansi.h>
inherit ITEM;

void create() {
  set_name("月符", ({ "yue fu", "fu" }));
  set("long", "一张薄绢制成的符，你可以用它祭(ji)了看看。\n");
  set("中秋", 1);
  set_weight(100);
  if (clonep(this_object()))
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("no_drop", 1);
    set("no_get", 1);
    set("value", 0);
    set("no_sell", 1);
  }
  setup();
}

void init() {
  add_action("do_ji", "ji");
}

int valid_move(object me) {
  if (me->over_encumbranced())
    return 0;
  if (me->is_busy())
    return 0;
  if (me->query_temp("no_move"))
    return 0;
  if (me->query_temp("pending/exercising"))
    return 0;
  if (me->query_temp("doing_xiudao"))
    return 0;
  if (me->query_temp("pending/meditating"))
    return 0;
  if (me->is_fighting())
    return 0;
  return 1;
}

int query_autoload() { return 1; }



int do_ji(string arg) {
  object me = this_player();

  if (id(arg)) {
    if (me != environment())
      return 0;
    if (!valid_move(me))
      return notify_fail("你正忙着呢\n");
    if (environment(me)->query("short") == "广寒宫")
      return notify_fail("需要吗？\n");
    if (environment(me)->query("no_magic"))
      return notify_fail("这个地方禁止施法。\n");
    if (me->query("mana") < me->query("max_mana"))
      return notify_fail("你法力不够了。\n");

    message_vision(HIW "$N将$n朝天空一扬，口中默念咒语....\n", me, this_object());
    me->add("mana", -100);
    me->start_busy(2);
    if (!environment(me)->query("outdoors"))
      message_vision(HIW "结果什么反应也没有....\n\n", me);
    else {
      message_vision(HIW "一道月光自天而下罩住了$N！\n" NOR, me);
      if (me->move("/d/wiz/gift/中秋/moon"))
        message_vision(HIW "\n$N白光一闪，$N现出了身形....\n\n" NOR, me);
      else message_vision(HIY "\n一道闷雷闪过，$N又落到了地面....\n\n" NOR, me);
    }
    return 1;
  }
  return 0;
}
