        /*********************************
**      中秋礼物·月饼          **
**              cake            **
*********************************/

#include <ansi.h>
inherit ITEM;

int pot;                //奖励的qn 总数为:pot*query("num")
string mud_name = "天上人间";

void create()
{
set_name("月饼",({"moon cake","bing"}));
set("long",HIM+@LONG

  ▇▇▇▇ .    ▇▇▇▇ .   ▇▇▇▇      ▇▇▇▇
◢▇▇▇▇◣  ◢▇▇▇▇◣ ◢▇▇▇▇◣  ◢▇▇▇▇◣
▇中秋快乐▇. ▇生活愉快▇ ▇吉祥如意▇  ▇合家欢乐▇
◥▇▇▇▇◤ .◥▇▇▇▇◤ ◥▇▇▇▇◤  ◥▇▇▇▇◤
  ▇▇▇▇ .    ▇▇▇▇ .   ▇▇▇▇      ▇▇▇▇
   | | |         | | |        | | |         | | |
LONG+NOR);

set_weight(100);
set("unit","块");
set("no_give",1);
set("no_drop",1);
set("no_get",1);
set("value",0);
set("no_sell",1);
setup();
}

void init()
{
add_action("do_eat","eat");
}

void destruct_me()
{
write(YEL+name()+"掉在地上不见了。"NOR HIR"\n\t\t中\t秋\t快\t乐\n"NOR);
destruct(this_object());
}

int do_eat(string arg)
{
object me = this_player();
string *msgs = ({
        "你吃着月饼，想着 "+mud_name+" 的好处，不禁流出了幸福的哈喇子....",
        "你吃着月饼，冷不丁瞅到天上那冷冷的寒月，不禁思念起某人....",
        "你边吃月饼边想起了儿时的伙伴....",
        "你吃着吃着，想起了远在家乡的父母，思念的泪珠不禁打湿了衣裳....",
        "你边吃着月饼边流着幸福的眼泪....",
});

if ( id(arg) )
        {
        if ( me!=environment() )
                return 0;
        if ( query("num")<=0 )
                {
                if ( !me->query("04中秋/eated") )
                        me->set("04中秋/eated",1);
                set_name(name()+"的碎末",({"broken moon cake"}));
                call_out("destruct_me",1);

                return notify_fail("月饼已经吃光了。\n");
                }

        message_vision(HIG"\n$N将$n放在嘴中嚼了嚼。\n\n"NOR,me,this_object());
        this_object()->add("num",-1);

        tell_object(me,HIR+msgs[random(sizeof(msgs))]+NOR"\n");
        if ( me->query("04中秋/eated")
          || !me->query("04中秋/item_found")
          || !me->query("04中秋/geted") )
                return 1;
        pot = random(2000)+random(2000)+random(2000)+random(2000)+random(2000);       
        me->add("potential",pot);
        me->save();
        tell_object(me,HIM"中秋快乐，"HIG+mud_name+NOR HIM"全体巫师祝你年年如意，岁岁平安。\n"NOR);
        tell_object(me,HIY"你得到了"+chinese_number(pot)+"点潜能。\n"NOR);
        return 1;
        }
return 0;
}       
