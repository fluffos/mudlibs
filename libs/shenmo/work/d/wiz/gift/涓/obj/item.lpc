                        /*********************************
**      中秋礼物·物件          **
**              item            **
*********************************/

#include <ansi.h>
inherit ITEM;

mixed check_me();

void create()
{
set_name("礼物物件",({"gift item"}));
set("long","礼物物件，本身充满了变数。\n");
set("中秋",1);
set_weight(100);
set("value",1);
set("unit","个");
set("no_get",(:check_me:));
setup();
}

mixed check_me()
{
object me = this_player();
if ( me==environment() )
        return "这不是你的东西。\n";
if ( query("owner")!=me->query("id") )
        return "这个不是你要找的。\n";
else    return 0;       
}

                                
