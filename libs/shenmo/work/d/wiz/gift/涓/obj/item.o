                                /*********************************
**      中秋礼物·物件          **
**              item            **
*********************************/

#include <ansi.h>
inherit ITEM;

void create()
{
set_name("礼物物件",({"gift item"}));
set("long","礼物物件，本身充满了变数。\n");
set("中秋",1);
set_weight(100);
set("value",1);
set("unit","个");
setup();
}

void init()
{
add_action("do_get","get");
}

int do_get(string arg)
{
object me = this_player();
if ( id(arg) )
        {
        if ( environment(me)!=environment() )
                return 1;
        if ( query("owner")!=me->query("id") )
                {
                write("这个不是你要找的。\n");
                return 1;
                }
        if ( !(__DIR__"fu.c")->valid_move(me) )
                {
                write("你正忙着呢。\n");
                return 1;
                }
        return 0;
        }
return 1;
}

                                
