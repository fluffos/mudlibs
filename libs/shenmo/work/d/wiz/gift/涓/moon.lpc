/*********************************
**      中秋礼物·广寒宫                **
**              moon            **
*********************************/

#include <ansi.h>
inherit ROOM;

void create() {
  string msg;
  set("short", "广寒宫");
  msg = WHT + @LONG
     ___                            ___
     ~][                            ][~
   .___]@@@@@@@@@@@@@@@@@@@@@@@@@@@@L____,
    ~~~]@~~~~~~~┏━━━━━┓~~~~~@[~~~~'
       ]@       ┃ 广 寒 宫 ┃     @[
       ]@       ┗━━━━━┛     @[
       ]@                          @[
       ]@                          @[
       ]@                          @[
       ]@                          @[
     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  )zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz

LONG + NOR;
  msg = replace_string(msg, "广", HIC "广" NOR WHT);
  msg = replace_string(msg, "寒", HIC "寒" NOR WHT);
  msg = replace_string(msg, "宫", HIC "宫" NOR WHT);
  set("long", msg);
  set("objects", ([
    __DIR__ "npc/yutu": 1,
    __DIR__ "npc/change": 1,
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("outdoors", "sky");
  setup();
}
