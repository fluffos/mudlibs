/*********************************
**      中秋礼物·日月山                **
**              riyue-shan      **
*********************************/

#include <ansi.h>
inherit ROOM;

void reset();

void create() {
  set("short", "日月山");
  set("long", @LONG

这里便是大荒之中日月山，据说乃是远古时上界门户的
转轴，又名吴蚷天门山。
这里也是传说中日月的降落之处，乃为天地间极阴极阳
之所在。白天此处烈日炙烤，夜间又是寒月映照。
LONG);
  set("exits", ([
    "west": __DIR__ "riyue-shan",
    "east": __DIR__ "riyue-shan",
    "north": __DIR__ "riyue-shan",
    "south": __DIR__ "riyue-shan",
  ]));
  set("outdoors", "sky");
  set("no_magic", 1);
  set("no_fight", 1);
  setup();
}

void init() {
  object npc, *inv;
  object me = this_player();
  object env = this_object();
  int i, dayphase = NATURE_D->query_current_day_phase();

  add_action("do_none", "", 1);

  if (dayphase < 5)               //白天
  {
    npc = present("tai yang", env);
    if (!npc || userp(npc)) {
      npc = new(__DIR__ "npc/taiyang");
      message_vision(HIR "四周忽然一阵闷热，从火光中跃下一道火红的身影。\n" NOR, me);
      npc->move(env);
    }
    inv = all_inventory(env);
    for (i = 0; i < sizeof(inv); i++) {
      if (userp(inv[i]))
        continue;
      if (inv[i]->query("id") == "tai yang")
        continue;
      write(HIR "火光一闪，" + inv[i]->name() + HIR "渐渐消失在火光之中。\n" NOR);
      destruct(inv[i]);
    }
  } else {
    env->reset();
    npc = present("yue liang", env);
    if (!npc || userp(npc)) {
      npc = new(__DIR__ "npc/yueliang");
      message_vision(HIC "四周忽然一阵清冷，从寒光中跃下一道清冷的身影。\n" NOR, me);
      npc->move(env);
    }
    inv = all_inventory(env);
    for (i = 0; i < sizeof(inv); i++) {
      if (userp(inv[i]))
        continue;
      if (inv[i]->query("id") == "yue liang")
        continue;
      write(HIC "寒风刮过，" + inv[i]->name() + HIC "渐渐消失在寒风之中。\n" NOR);
      destruct(inv[i]);
    }
  }
}

int do_none() {
  object me = this_player();
  string verb = query_verb();
  string *no_cmds = ({                    //需屏蔽的命令
  "surrender", "cast"
  });
  if (member_array(verb, no_cmds) != -1) {
    write("你还是安心过中秋吧。\n");
    return 1;
  }
  return 0;
}

void reset() {
  int i;
  object *inv;
  ::reset();
  inv = all_inventory(this_object());
  for (i = 0; i < sizeof(inv); i++) {
    if (!userp(inv[i]))
      destruct(inv[i]);
  }
}

int valid_leave(object me, string dir) {
  if (!me->query_temp("04中秋/moon_num"))
    me->set_temp("04中秋/moon_num", 1 + random(12));
  else {
    if (me->query_temp("04中秋/moon_num") >= 78)
      me->set_temp("04中秋/moon_num", 8);
    else me->add_temp("04中秋/moon_num", 1 + random(12));
  }
  return ::valid_leave(me, dir);
}
