#include <ansi.h>
inherit ITEM;
inherit F_SAVE;

string query_save_file()
{
return "/c/data/gift/giveall";
}

void create()
{
set_name("礼物台",({"liwu tai","tai"}));
set_weight(1000000);
set("long","一张巫师拿来发放礼物的仙石台，天神可以用它来
发放(fafang)礼物(路径)。\n");
set("unit","张");
set("no_get","你拿不起来。\n");
setup();
restore();
}

void init()
{
add_action("do_gift","fafang");
}

int do_gift(string arg)
{
object ob,*urs,me = this_player();
int i,k=0;

if ( !wizardp(me) || SECURITY_D->get_status(me)!="(admin)" )
        {
        write("你没有这个权限。\n");
        return 1;
        }
if ( !arg )
        {
        write("命令格式 fafang <物品路径>\n");
        return 1;
        }
ob = new(arg);
if ( !ob )
        {
        write("物品路径不存在。\n");
        return 1;
        }
urs = users();
for(i=0;i<sizeof(urs);i++)
        {
        if ( !urs[i] || !interactive(urs[i]) )
                continue;
        if ( time()<urs[i]->query("mud_age")+3600 )
                {
                tell_object(urs[i],HIG"你注册尚未超过1小时，没有得到发放的礼物。\n"NOR);       
                continue;
                }
        ob = new(arg);
        if ( !ob )
                continue;
        ob->set("no_give",1);
        ob->set("no_get",1);
        ob->set("no_put",1);
        if ( !ob->move(urs[i]) )
                {
                tell_object(urs[i],HIG"你背包太满，没有得到发放的礼物。\n"NOR); 
                continue;
                }
        tell_object(urs[i],HIG"你得到了"+ob->name()+HIG"。\n"NOR);
        k++;
        }                                       
message("shout",HIC"【天神界】"+me->query("name")+HIC"本次礼物发放完毕，共有"+k+"/"+sizeof(urs)+HIC" 位玩家得到了"+ob->name(1)+HIC"。\n"NOR,users());
set("log/"+ctime(time()),({me->query("id"),arg}));
save();
return 1;
}

string long()
{
mapping data;
string str,*strs;
int i;
data = query("log");
if ( !data || !mapp(data) )
        return ::long();        
str = ::long();
strs = keys(data);
for(i=0;i<sizeof(strs);i++)
        {
        if ( data[strs[i]][0] && data[strs[i]][1] )
                str+= sprintf("\n%s 于 %s 发放了 %s。\n",data[strs[i]][0],strs[i],data[strs[i]][1]);
        }
return str;
}                       
