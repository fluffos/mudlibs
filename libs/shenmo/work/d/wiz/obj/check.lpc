#include <ansi.h>
inherit ITEM;

int num;
mapping data1=([]);
mapping data2=([]);

void create()
{
set_name("混天仪",({"huntian yi","yi"}));
set("unit","架");
setup();
}

int query_autoload(){return 1;}

void init()
{
add_action("do_check","check");
}

int do_check(string arg)
{
string str;     
object *usrs,who,me = this_player();
int i,*k1,*k2;

if ( !arg 
  || (arg!="armor" && arg!="damage")
  || !wizardp(me) )
        return 0;
str = YEL"\n\t\t┝ "HIR"游戏者 $T 排行"NOR YEL"┥\n"NOR;;
usrs = users();         
num = sizeof(usrs);
while(num--)
        {
        who = usrs[num];
        if ( !who || wizardp(who) )
                continue;
        if ( who->query_temp("apply/damage")>1500 ) 
                data1[who->query("id")] = who->query_temp("apply/damage");
        if ( who->query_temp("apply/armor")>1500 ) 
                data2[who->query("id")] = who->query_temp("apply/armor");
        }
        
k1 = values(data1);
k2 = values(data2);
k1 = sort_array(k1,1);
k2 = sort_array(k2,1);

if ( arg=="damage" )
        {
        i = sizeof(k1);
        while(i--)
                str+= sprintf(HIR BLK"  游戏者 %10s      伤害数据 %20d\n"NOR,
                                keys(data1)[i],
                                k1[i]);
        str = replace_string(str,"$T","攻击力");                              
        }
else    {
        i = sizeof(k2);
        while(i--)
                str+= sprintf(HIR BLK"\t  游戏者 %10s     防御数据 %20d\n"NOR,
                                keys(data2)[i],
                                k2[i]);
        str = replace_string(str,"$T","防御力");
        }
str+= "\n"NOR;  
message("channel:wiz",str,users());
return 1;                       
}                       

