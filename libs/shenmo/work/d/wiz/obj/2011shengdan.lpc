#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "吉祥如意" NOR, ({ "jixiang ruyi", "ruyi", }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("long", "一枚神气活现的如意。\n");
    set("material", "stone");
    set("value", 0);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_put", 1);
    set("no_steal", 1);
  }
  setup();
}

void init() {
  add_action("do_give", "give");
  add_action("do_look", "look");
}

object random_place() {
  int m, n, i, j, k;
  object temp, newob;
  mapping ex;

  mixed *file, exit;
  string *dirs = ({
    "/d/city", "/d/jjf", "/d/westway", "/d/kaifeng", "/d/lingtai", "/d/moon",
    "/d/gao", "/d/sea", "/d/nanhai", "/d/eastway", "/d/xueshan", "/d/dntg/hgs",
    "/d/qujing/wuzhuang", "/d/qujing/baotou", "/d/qujing/baoxiang", "/d/qujing/bibotan",
    "/d/qujing/biqiu", "/d/qujing/chechi", "/d/qujing/dudi", "/d/qujing/fengxian",
    "/d/qujing/firemount", "/d/qujing/jilei", "/d/qujing/jindou", "/d/qujing/jingjiling",
    "/d/qujing/jinping", "/d/qujing/jisaiguo", "/d/qujing/maoying", "/d/qujing/nuerguo",
    "/d/qujing/pingding", "/d/qujing/pansi", "/d/qujing/tongtian", "/d/qujing/qilin",
    "/d/qujing/qinfa", "/d/qujing/qinglong", "/d/qujing/tianzhu", "/d/qujing/wudidong",
    "/d/qujing/wuji", "/d/qujing/xiaoxitian", "/d/qujing/yinwu", "/d/qujing/yuhua",
    "/d/qujing/zhujie", "/d/qujing/zhuzi", "/d/penglai", "/d/pantao",
    "/d/death", "/d/meishan", "/d/qujing/lingshan",
  });

  n = 0;
  i = random(sizeof(dirs));    // pick up one directory
  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file))
    return 0;
  for (k = 0; k < 30; k++) {
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (!newob)
        continue;
      if (!(exit = newob->query("exits"))
        || sizeof(keys(exit)) < 1)
        continue;
      if (!mapp(ex = newob->query("exits")))
        continue;
      if (newob)
        return newob;
    }
  }
  return 0;
}

object random_npc() {
  int i;
  object *inv, where = random_place();
  if (!where)
    return 0;
  inv = all_inventory(where);
  if (sizeof(inv) < 1)
    return 0;
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] && !userp(inv[i])
      && inv[i]->query("startroom")
      && living(inv[i]))
      return inv[i];
  }
  return 0;
}

int do_look(string arg) {
  string str;
  object who, ob, me = this_player();

  if (!arg || me->query("giftmark/2011shengdan"))
    return 0;
  ob = present(arg, me);
  if (!ob || ob != this_object())
    return 0;
  str = ob->query("quest");
  if (!str || stringp(str)) {
    who = random_npc();
    if (!who || !environment(who))
      return 0;
    set("T_id", who->query("id"));
    set("T_name", who->query("name"));
    set("TT", who);
    str = sprintf(
      "一枚神气活现的如意，将之交给%s的%s(%s)即可得到圣诞礼物。\n",
      MISC_D->find_place(environment(who)),
      who->query("name"),
      upper_case(who->query("id")),
    );
    set("quest", str);
  }
  write(str);
  return 1;
}

int do_give(string arg) {
  string id, sth, *msg, str;
  object obj, ob, npc, me = this_player();

  if (!arg || me->query("giftmark/2011shengdan"))
    return 0;
  if (sscanf(arg, "%s to %s", sth, id) != 2
    && sscanf(arg, "%s %s", id, sth) != 2)
    return 0;
  ob = present(sth, me);
  if (!ob || ob != this_object() || !ob->query("quest"))
    return 0;
  npc = present(id, environment(me));
  if (!npc || !living(npc) || userp(npc))
    return 0;
  if (npc->query("name") != ob->query("T_name")
    || npc->query("id") != ob->query("T_id"))
    return 0;
  message_vision("$N将" + ob->name() + "交给$n。\n", me, npc);
  npc->command("thank");
  npc->command("say 圣诞快乐，虽然这是那些外夷的节日，不过吾等泱泱大国，当与宇内子民同乐。");
  message_vision("$N从怀里掏出一堆物什，说道：我这里也有些礼物送给你。\n", npc);
  me->add("combat_exp", 50000);
  me->add("daoxing", 30000);
  me->add("potential", 10000);
  write(HIY "圣诞快乐，你得到了五万武学，三十年道行以及一万潜能的礼物。\n" NOR);
  me->set("giftmark/2011shengdan", 1);
  switch (random(5)) {
    case 1:
      msg = ({
        "cordan",
        "cpsdan",
        "haomao",
        "kardan",
        "perdan",
        "shenliwan",
        "spidan",
        "xiandan",
        "xisuidan",
      });
      obj = new(sprintf("/d/wizz/fangz/drug/%s", msg[random(sizeof(msg))]));
      break;
    case 2:
      msg = ({ "hebing", "hebingl", "lhconvert", "lhshengji", "lhshengjil", "lhshengjim", });
      obj = new(sprintf("/d/wizz/fangz/lianhua/%s", msg[random(sizeof(msg))]));
      break;
    default: obj = new("/d/wizz/fangz/book/book"); break;
  }
  if (obj) {
    obj->set("no_give", 1);
    obj->set("no_put", 1);
    obj->set("value", 0);
    obj->set("no_get", 1);
    obj->set("owner_id", me->query("id"));
    obj->move(me);
  }
  str = @LONG

