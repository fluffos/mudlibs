/*
正常奖励是 wx 30w, dx 300年 ，pot 10w
冰糖葫芦 偏重加wx 50w
水晶糖葫芦 偏重加dx 500y
翡翠糖葫芦 偏重加pot 30w
*/

#include <ansi.h>
inherit ITEM;

string *clr = ({
        NOR"",
        HIM"冰",
        HIW"水晶",
        HIG"翡翠",      
});
void create()
{
set_name("糖葫芦",({"tang hulu","hulu"}));
set_weight(90);
if (clonep())
        set_default_object(__FILE__);
else    {
        set("unit", "串");
        set("long", HIR"
这是西游记--神魔传说为国庆准备的特别礼品，看上去晶莹剔透，红扑扑的逗人喜爱，你不觉流出
了口水，忍不住就想咬（eat）上一口。\n"NOR);
        set("value",100000);
        set("no_steal",1);
        set("no_put",1);
        set("no_get",1);
        set("no_give",1);
        set("no_drop",1);
        set("drug_type", "补品");
        }
setup();
if ( random(5) )
        set("type",1);
else if ( random(5) )
        set("type",2);
else if ( random(5) )
        set("type",0);          
else    set("type",3);
}

string name()
{
string str = ::name();
str = clr[query("type")]+str+NOR;
return str;
}       

void init()
{
add_action("do_eat","eat");
}       

int do_eat(string arg)
{
int wx,dx,pot;  
object me = this_player(); 
if ( !arg || !id(arg) )
        return 0; 
if ( me->query("gender")=="女性" )
        message_vision(HIR"$N"HIR"剥开糖纸小口小口地舔着$n"HIR"。\n"NOR, me,this_object()); 
else    message_vision(HIR"$N"HIR"撕开糖纸狼吞虎咽地对$n"HIR"咬了下去。\n\n" NOR, me,this_object());
/*
正常奖励是 wx 30w, dx 300年 ，pot 10w
冰糖葫芦 偏重加wx 50w
水晶糖葫芦 偏重加dx 500y
翡翠糖葫芦 偏重加pot 30w
*/
switch(query("type"))
        {
        case 0 : wx = 300000;dx = 300000; pot = 100000;break;
        case 1 : wx = 500000;break;
        case 2 : dx = 500000;break;
        case 3 : pot = 300000;break;
        default: wx = dx = pot = 0;
        }
wx = wx*3/4+random(wx/4);
dx = dx*3/4+random(dx/4);       
pot = pot*3/4+random(pot/4);
me->set("food", (int)me->max_food_capacity());
me->set("water", (int)me->max_water_capacity()); 
if ( !me->query("giftmark/2007-10-1-eat") )
        {
        if ( wx>0 )     me->add("combat_exp",wx);       
        if ( dx>0 )     me->add("daoxing",dx);
        if ( pot>0 )    me->add("potential",pot);
        me->set("giftmark/2007-10-1-eat",1);
        me->save();
        }       
tell_object(me,HIY"国庆快乐！\n"NOR);        
destruct(this_object());
return 1;
}

