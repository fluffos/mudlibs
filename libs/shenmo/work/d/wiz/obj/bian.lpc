#include <ansi.h>
inherit COMBINED_ITEM;

void create()
{
set_name(HIR"鞭炮"NOR,({HIR"bian pao"NOR,"bian pao","pao"}));
set("long","节日里用的鞭炮，你可以放(fang)了看看。\n");
set_weight(100);
set("base_unit","支");
set("unit","条");
set("value",100000);
setup();
set_amount(1);
}

void init()
{
add_action("do_fang","fang");
}

int do_fang(string arg)
{
object me = this_player();
string msg;
if ( !arg || !id(arg) )
        return 0;
if ( me->is_busy() )
        {
        write("你正忙着呢。\n");
        return 1;
        }
switch(random(4))
        {
        case 0 : 
                msg = HIM+@LONG
          ▇▇▇▇ .    ▇▇▇▇ .   ▇▇▇▇      ▇▇▇▇
        ◢▇▇▇▇◣  ◢▇▇▇▇◣ ◢▇▇▇▇◣  ◢▇▇▇▇◣
        ▇春节快乐▇. ▇生活愉快▇ ▇吉祥如意▇  ▇合家欢乐▇
        ◥▇▇▇▇◤ .◥▇▇▇▇◤ ◥▇▇▇▇◤  ◥▇▇▇▇◤
          ▇▇▇▇ .    ▇▇▇▇ .   ▇▇▇▇      ▇▇▇▇
            | | |         | | |        | | |         | | |
LONG+NOR;
                msg = replace_string(msg,"春节快乐",NOR REV HIM"春节快乐"NOR HIM);
                msg = replace_string(msg,"生活愉快",NOR REV HIM"生活愉快"NOR HIM);
                msg = replace_string(msg,"吉祥如意",NOR REV HIM"吉祥如意"NOR HIM);
                msg = replace_string(msg,"合家欢乐",NOR REV HIM"合家欢乐"NOR HIM);
                msg = replace_string(msg,".",NOR BLINK HIY"."NOR HIM);
                break;
        case 1 :
                msg = YEL+@LONG
        ＃〓§〓〓〓〓〓§〓〓〓〓〓〓§〓〓〓〓〓§〓＃ 
        　　↓　　　　　↓　　　　　　↓　　　　　↓ 
        　☆★☆　　　☆★☆　　　　☆★☆　　　☆★☆ 
        ☆　新　☆　☆　年　☆　　☆　快　☆　☆　乐　☆ 
        　☆★☆　　　☆★☆　　　　☆★☆　　　☆★☆ 
        　　↓　　　　　↓　　　　　　↓　　　　　↓ 
        　　※　　　　　※　　　　　　※　　　　　※  
LONG+NOR;
                msg = replace_string(msg,"☆",NOR BLINK HIR"☆"NOR YEL);
                msg = replace_string(msg,"★",NOR BLINK HIR"★"NOR YEL);
                msg = replace_string(msg,"※",NOR HIM"※"NOR YEL);
                msg = replace_string(msg,"↓",NOR HIM"↓"NOR YEL);
                msg = replace_string(msg,"新",NOR REV HIM"新"NOR YEL);
                msg = replace_string(msg,"年",NOR REV HIM"年"NOR YEL);
                msg = replace_string(msg,"快",NOR REV HIM"快"NOR YEL);
                msg = replace_string(msg,"乐",NOR REV HIM"乐"NOR YEL);
                break;
        default :       
                msg = @LONG
                ┏━┓┃西游记--神魔传说┃┏━┓ 
                ┃逢┃┗━━━━┛┃迎┃* 
                ┃盛┃　━　　━　┃新┃*
                ┃世┃━┳━┏━┓┃春┃*
                ┃举┃┃┃┃┗━┛┃佳┃*
                ┃国┃┃┃┃┏┳┓┃节┃*
                ┃共┃　┃　┃╋┃┃同┃*
                ┃欢┃　┛　┗┻┛┃庆┃*
                ┗━┛　　　　　　┗━┛*
                 ************************ 
LONG+NOR;
                msg = replace_string(msg,"西游记--神魔传说",NOR REV HIR"西游记--神魔传说"NOR);
                msg = replace_string(msg,"┏",NOR REV HIR"┏"NOR);
                msg = replace_string(msg,"┓",NOR REV HIR"┓"NOR);
                msg = replace_string(msg,"┗",NOR REV HIR"┗"NOR);
                msg = replace_string(msg,"┛",NOR REV HIR"┛"NOR);
                msg = replace_string(msg,"━",NOR REV HIR"━"NOR);
                msg = replace_string(msg,"┳",NOR REV HIR"┳"NOR);
                msg = replace_string(msg,"╋",NOR REV HIR"╋"NOR);
                msg = replace_string(msg,"┃",NOR REV HIR"┃"NOR);
                msg = replace_string(msg,"┻",NOR REV HIR"┻"NOR);
                msg = replace_string(msg,"　",NOR REV HIR"　"NOR);
                msg = replace_string(msg,"逢",NOR REV HIR"逢"NOR);
                msg = replace_string(msg,"盛",NOR REV HIR"盛"NOR);
                msg = replace_string(msg,"世",NOR REV HIR"世"NOR);
                msg = replace_string(msg,"举",NOR REV HIR"举"NOR);
                msg = replace_string(msg,"国",NOR REV HIR"国"NOR);
                msg = replace_string(msg,"共",NOR REV HIR"共"NOR);
                msg = replace_string(msg,"欢",NOR REV HIR"欢"NOR);
                msg = replace_string(msg,"迎",NOR REV HIR"迎"NOR);
                msg = replace_string(msg,"新",NOR REV HIR"新"NOR);
                msg = replace_string(msg,"春",NOR REV HIR"春"NOR);
                msg = replace_string(msg,"佳",NOR REV HIR"佳"NOR);
                msg = replace_string(msg,"节",NOR REV HIR"节"NOR);
                msg = replace_string(msg,"同",NOR REV HIR"同"NOR);
                msg = replace_string(msg,"庆",NOR REV HIR"庆"NOR);
                msg = replace_string(msg,"*",NOR BRED" "NOR);
        }
msg = sprintf(msg+HIW"\n\t\t%s(%s)祝贺大家节日快乐，心想事成。\n"NOR,
                me->query("name"),capitalize(me->query("id")),);
message("channel:rumor",msg,users());
me->start_busy(3);
this_object()->add_amount(-1);
return 1;
}

string short()
{
string str = ::short();
str = SDS_D->no_color_msg(str);
str = HIR+str+NOR;
return str;
}
