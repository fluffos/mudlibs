//npc === this_object()
#include <ansi.h>
inherit ITEM;

void create()
{
set_name("回神丸",({"huishen wan","wan"}));
set("long",HIG"服务器当机补偿，特发的补偿丸"NOR);
set("unit","粒");
set("no_give",1);
set("value",1);
set("no_put",1);
set("no_get",1);
set("no_drop",1);
setup();
}

void init()
{
if ( query("time") )
        {
        if ( !query("owner") )
                {
                destruct(this_object());
                return;
                }
        }
else    {
        set("time",time());
        set("owner",environment());
        }
add_action("do_eat","eat");
}

int do_eat(string arg)
{
object me = this_player();                                                  
if ( me!=environment() )
        return 0;
if ( !arg || !id(arg) )
        return 0;
if ( !query("time") )
        return 0;
if ( me!=query("owner") )
        return 0;               
if ( time()>query("time")+12000 )
        return 0;
message_vision("$N吃下了一粒$n，感动的说“小男人真是好人。。。。”\n",me,this_object());
me->add("combat_exp",80000);
me->add("daoxing",500000);      
me->add("potential",50000);
me->save();
destruct(this_object());
return 1;
}

string long()
{
string str = query("long");
if ( !query("time") 
  ||  !query("owner") )
        str+= HIG"\n这个看起来像是赝品。\n"NOR;
else if ( time()>query("time")+12000 )  
        str+= HIG"\n这个看起来像是过了保质期。\n"NOR;
else    str+= HIG"\n现在吃正是时候。\n"NOR;
return str;
}       
