//
//超级护法

#include <ansi.h>
inherit NPC;

void create() {
  set_name("假身", ({ "jia shen" }));
  setup();
}

varargs int announce(object who, string id) {
  object where, *inv, it;
  mapping skills, his_data, my_data;
  string *skill, *data;
  int i;

  if (!who) {
    if (!id || !stringp(id))
      return 0;
    who = find_player(id);
    if (!who)
      who = find_object(id);
    if (!who)
      return 0;
  }

  where = environment(who);
  if (!where)
    return 0;

  //复制skills
  skills = who->query_skills();
  skill = keys(skills);
  i = sizeof(skill);
  while (i--) {
    set_skill(skill[i], who->query_skill(skill[i], 1));
  }
  skills = query_skills();
  skill = keys(skills);
  i = sizeof(skill);
  while (i--) {
    if (stringp(who->query_skill_mapped(skill[i])))
      map_skill(skill[i], who->query_skill_mapped(skill[i]));
  }

  //复制data              
  his_data = who->query_entire_dbase();
  my_data = query_entire_dbase();
  data = keys(his_data);
  i = sizeof(data);
  while (i--) {
    if (data[i] == "name"
      || data[i] == "id"
      || data[i] == "auto_backup"
      || data[i] == "叛师"
      || data[i] == "friends")
      continue;
    my_data[data[i]] = his_data[data[i]];
  }

  set_temp("spellslevel", 10000);
  set_temp("apply/name", ({ who->name() }));
  set_temp("apply/id", who->parse_command_id_list());
  //set_temp("apply/short", ({who->short()})); 
  set_temp("apply/long", ({ who->long() }));
  set_temp("unit", who->query("unit"));
  set_temp("gender", who->query("gender"));
  set_temp("age", who->query("age"));
  set_temp("race", who->query("race"));

  //复制item
  inv = all_inventory(who);
  i = sizeof(inv);
  while (i--) {
    it = inv[i];
    if (!mapp(it->query("weapon_prop"))
      && !mapp(it->query("armor_prop")))
      continue;
    it = clone_object(base_name(it));
    if (it)
      it->move(this_object());
  }
  command("wield all");
  command("wear all");
  return 1;
}

void _leave() {
  remove_call_out("leave");
  destruct(this_object());
}

void leave() {
  string str;
  if (!stringp(str = query("leave_msg")))
    str = HIB "\n$N" HIB "身子一转，化作一道青烟，消失不见。。。\n\n" NOR;
  message_vision(str, this_object());
  this_object()->move("/obj/empty");
  call_out("_leave", 1 + random(5));
}

int heal_up() {
  mapping time;
  time = query("护法");

  if (environment() && environment()->query("short") == "empty room")
    return 0;

  if (!mapp(time)) {
    leave();
    return 0;
  }
  if (time() >= time["start"] + time["time"]) {
    leave();
    return 0;
  }
  return ::heal_up() + 1;
}

void heart_beat() {
  object me = this_object();

  if (me->is_busy()) {
    me->start_busy(1, 100);
    me->interrupt_me(me, "眠兔");
    me->reset_action();
  }
  ::heart_beat();

  if (query("eff_kee") < query("max_kee"))
    SDS_D->addEffKee(me);
  if (query("kee") < query("eff_kee"))
    SDS_D->addKee(me);
  if (query("sen") < query("eff_sen"))
    SDS_D->addSen(me);
  if (query("eff_sen") < query("max_sen"))
    SDS_D->addEffSen(me);

  SDS_D->randomPfm(
    this_object(),
    (objectp(query_temp("weapon")) ? (query_temp("weapon")->query("skill_type")) : "unarmed")
  );
  SDS_D->randomCast(this_object());
  SDS_D->randomExert(this_object());
}
