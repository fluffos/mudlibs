#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE; 

void create()
{
set_name(HIR"金箍"NOR, ({ "jin gu","gu" }) );
set_weight(100);
if( clonep() )
        set_default_object(__FILE__);
else    {
        set("unit", "圈");
        set("long","紧箍咒，又唤做“定心真言”。撞见神通广大的妖魔，只依所用的咒语念一念，管教他入我门来。\n");
        set("material", "steel"); 
        }
setup();
}

void free_jingu(object ob, object who)
{
remove_call_out("free_jingu");  
if ( !who || !ob || !present(ob,who) )
        return;

if ( who->query("family/family_name")!= "南海普陀山" ) 
        {
        tell_object(who, HIR"你仿佛听到有人说：非佛门中人，得之无用，不如弃之。\n"
        + "随着一声轻响，紧箍咒已腾空而去，不留下一丝痕迹。\n\n"NOR);
        destruct(ob);
        }
}

void back_jingu(object ob, object who)
{
object owner;   
remove_call_out("back_jingu");  
if ( !who || !ob || !present(ob,who) )
        return;
who->delete_temp("no_move");    
owner = query("owner");
if ( !owner )
        call_out("free_jingu",5+random(11), this_object(), this_player());         
else    {
        if ( ob->move(owner) )
                {
                message("vision",HIC"\n"+owner->name()+HIC"念了几遍咒语,"+name()+HIC"呼的一声飞回到"+owner->name()+HIC"手中。\n\n"NOR,environment(owner),owner);
                tell_object(owner,HIR"\n你念了几遍咒语将"+name()+HIR"收回！\n\n"NOR);
                ob->delete("owner");
                ob->delete("target");
                }
        else    free_jingu(ob,ob);
        }
}       

void init()
{
if ( !objectp(query("target"))
   ||!objectp(query("owner")) )
        {
        if ( this_player()->query("family/family_name")!="南海普陀山" ) 
                call_out("free_jingu",5+random(11), this_object(), this_player()); 
        }
else    {
        add_action("do_none","",1);
        if ( this_player()==query("target")
          && present(this_object(),this_player()) )
                call_out("back_jingu",5+random(16),this_object(),this_player());          
        }
}
        
int do_none()
{
string msg;     
object ob;      
object me = this_player();
if ( me!=environment() )
        return 0;
if ( me==query("target") )
        {
        ob = query("owner");
        if ( !ob )
                {
                call_out("free_jingu",5+random(11), this_object(), this_player()); 
                return 0;
                }
        msg = HIC"\n$N"HIC"默默的对着$n"HIC"念了几遍咒语！\n"NOR;
        msg+= HIC "结果把个$n"HIC"痛得竖蜻蜓，翻筋斗，耳红面赤，眼胀身麻，不由得抓破了自己的头。\n"NOR;
        message_vision(msg,ob,me);
        if ( !me->query_temp("no_move") )
                me->set_temp("no_move", 1);
        me->receive_wound("sen",100);
        me->receive_damage("sen",500);
        COMBAT_D->report_sen_status(me);
        return 1;
        }
return 0;
}       
