#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", HIW "异空间" NOR);
  set("long", @LONG   
不属于过往所熟知的世界，周围所能看到的都是一片漆黑，见不着其他景物！  
LONG);

  set("exits", ([
    //"northwest" : __DIR__"sl1",
    //"south" : __DIR__"fight2",
  ]));
  set("objects", ([
    // __DIR__"npc/qb" : 4,
    // __DIR__"npc/ma" : 5,
    // __DIR__"npc/xiaohe3" : 1,
  ]));
  setup();
}
void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("blowing", random(10) + 1, ob);
}
int blowing(object ob) {
  int i;
  int damage;
  if (ob && environment(ob) == this_object()) {
    tell_object(this_object(), HIC "\n\n瑰丽的极光撒落在你的身上，你一时觉得万念俱灰！\n\n" NOR);
    ob->receive_damage("kee", random(100) + 100);
    ob->receive_damage("sen", random(100) + 100);
    COMBAT_D->report_sen_status(ob);
    if (environment(ob) == this_object())
      call_out("blowing", random(20) + 1, ob);
  } else
    return 1;
}
