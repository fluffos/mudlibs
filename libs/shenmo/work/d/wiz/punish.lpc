// Room: /d/wiz/punish.c
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "死牢");
	set("long", @LONG

进了这里，你活下来的希望已经很小了。
黑漆漆的墙壁上一个小小的孔洞透出一丝微弱的光线(ting)。
LONG
	);
	
	set("valid_startroom", 1);

	setup();
	
}

void init()
{   
	if (!wizardp(this_player())) {
          this_player()->set("startroom","/d/wiz/punish");
	  this_player()->save();
	  add_action("block_cmd","",1);   	
	}
	add_action("do_ting","ting");	
	call_out("hehe", 2, this_player());
}


int block_cmd()
{
        string verb = query_verb();
	
        if (verb=="say") return 0; //allow say
	if (verb=="help") return 0;
	if (verb=="look") return 0;
	if (verb=="ok") return 0;
	if (verb=="credit") return 0;
	return 1;
}
