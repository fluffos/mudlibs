int do_ting(string arg)
{
object who, feizao;
who=this_player();
        write(HIW"你轻轻的靠着墙壁，把耳朵贴在墙壁的小孔处！\n"NOR);
        call_out("huiyin", 3, who);
        return 1;
}

void huiyin()
{
	        write(HIW"你听见小孔传来一个声音， ”新来的呀？懂不懂规矩？！有钱能使鬼推磨，10个金币买你的自由（ok？）！“\n"NOR);
           input_to("huiluo_ok");
           return;
}

int huiluo_ok(string arg)
{
	 if(!arg||arg!="ok")
   {
     write("你想了想，还是不舍得口袋里的那几个铜板，心想还是算了。");
     return 1;
    }
	 else if (this_player()->query("c_balance")>100000000)
		{
	 		write(HIW"你沉吟了半响，内衣口袋里摸出了几个金币，抖动的双手从小孔处塞了进去。\n"NOR);
	 		this_player()->add("c_balance",-100000000);
	 	  write("突然墙角一个狗洞打开，你二话不说，就钻了进去。\n");
	 		call_out("huiyin_1", 1+random(5), this_player());
	 	  }
	 	  else {
	 	  	write("你是穷光蛋一个，只能老老实实的把牢底坐穿了！\n");
	 	  	}
}

void huiyin_1()
{
               if (random(8)<=6)
	        {write("洞里一股潮湿陈旧的腐烂之气拂面袭来，你夹紧双腿，一阵乱爬，双手旁边好像是一些碎骨和破旧的衣物。\n");
	         call_out("huiyin_1", 1+random(5), this_player());
	         return;
	         }
	         call_out("huiyin_2", 3, this_player());
           return;
}

void huiyin_2()
{
		 	write("前方逐渐出现一丝亮光，你顺着光亮的方向爬出去！\n");
	 		this_player()->move("/d/city/kezhan");
	 		this_player()->start_busy(3);
	 		this_player()->save();
	 		return;
	 	}

