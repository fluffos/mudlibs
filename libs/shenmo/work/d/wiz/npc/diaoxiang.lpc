#include <ansi.h>
inherit NPC;
inherit F_SAVE;

void create() {
  set_name("雕像", ({ "diao xiang", "xiang", "statuary" }));
  set("莲花", 1);
  set_temp("look_msg", long());
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("max_force", 50000);
  set("max_mana", 50000);
  powerup();
  setup();
}

string long() {
  string long;
  if (!stringp(long = query("look_msg")))
    return "一尊尚未完工的石雕像，面目尚不清晰。。。。\n";
  return long;
}

string short() {
  mapping ow;
  if (!mapp(ow = query("主人")))
    return ::short();
  return ow["title"] + ow["nickname"] + ow["name"] + "(" + capitalize(ow["id"]) + ")";
}

int information(object who) {
  mapping my, his;
  string *str;
  int i;

  if (!who)
    return 0;
  if (mapp(query("主人")))
    return 0;
  ("/cmds/std/look.lpc")->main(who, who->parse_command_id_list()[0]);
  set("look_msg", who->query_temp("look_message"));

  his = who->query_entire_dbase();
  str = keys(his);
  i = sizeof(str);
  while (i--)
    set("主人/" + str[i], his[str[i]]);

  his = who->query_skills();
  str = keys(his);
  i = sizeof(str);
  while (i--)
    set_skill(str[i], his[str[i]]);

  his = who->query_skill_map();
  str = keys(his);
  i = sizeof(str);
  while (i--)
    map_skill(str[i], his[str[i]]);

  my = query_entire_dbase();
  str = keys(query("主人"));
  i = sizeof(str);
  while (i--)
    my[str[i]] = query("主人/" + str[i]);

  if (save())
    return 1;
  else {
    if (this_object())
      destruct(this_object());
    return 0;
  }
}

string query_save_file() {
  string id;
  mapping ow;

  ow = query("主人");
  if (!ow || !mapp(ow))
    return 0;
  id = ow["id"];
  if (!stringp(id)) return 0;
  return sprintf("c/雕像/%c/%s", id[0], id);
}
//(*)
void reset() {
  string id;
  object who;
  mapping ow;
  ow = query("主人");
  if (!ow || !mapp(ow))
    return;

  id = ow["id"];
  if (!id || !stringp(id))
    return;
  who = find_player(id);
  if (!who)
    who = SDS_D->find_user(id);
  if (!who)
    error("Can't find its owner\n");
  if (information(who)) {
    this_object()->powerup();
    this_object()->restore();
  }
}

void kill_ob(object who) {
  if (who && who->is_fighting(this_object()) && living(who))
    ::kill_ob(who);
  else {
    remove_all_killer();
    all_inventory(environment())->remove_killer(this_object());
    return;
  }
}

void heart_beat() {
  if (query("eff_kee") < query("max_kee"))
    SDS_D->addEffKee(this_object());
  if (query("kee") < query("eff_kee"))
    SDS_D->addKee(this_object());
  if (query("sen") < query("eff_sen"))
    SDS_D->addSen(this_object());
  if (query("eff_sen") < query("max_sen"))
    SDS_D->addEffSen(this_object());

  if (!this_object()->is_busy()) {
    if (this_object()->is_fighting()) {
      switch (random(5)) {
        case 0:
          SDS_D->randomPfm(this_object()); break;
        default:
          SDS_D->randomCast();
      }
    }
  }
  ::heart_beat();
}

void unconcious() {
  this_object()->powerup();
  ::unconcious();
  say("\n\n一旁跑过来几位差官，大喝道：好了好了，点到为止，别打了别打了！\n\n");
  remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());
  return;
}

void die() {
  if (query("disable_type") == " <昏迷不醒>") {
    this_object()->powerup();
    say("\n\n一旁跑过来几位差官，大喝道：好了好了，点到为止，别打了别打了！\n\n");
    remove_all_killer();
    all_inventory(environment())->remove_killer(this_object());
    return;
  }
  ::die();
}
