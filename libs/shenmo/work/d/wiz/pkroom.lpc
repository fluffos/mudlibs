#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "修罗道");
  set("long", NOR RED + @LONG

        浩浩乎!平沙无垠，敻不见人。
        河水萦带，群山纠纷。黯兮惨悴，风悲日曛。
        蓬断草枯，凛若霜晨。
        鸟飞不下，兽铤亡群。
        亭长告余曰：“此古战场也。常覆三军；往往鬼哭，天阴则闻。”伤心哉！秦欤？汉欤？将近代欤？   
        
LONG + NOR);
  set("no_clean_up", 1);
  set("channel_id", "修罗道");
  set("alternative_die", 1);
  setup();
}

void go_home(object who) {
  string room;
  if (!who || !present(who, this_object()))
    return;
  room = "/d/city/under";
  tell_object(NOR RED "\n你度尽茹毛饮血的日子，只觉心境渐渐平和，不由思念起往日生活，觉得脱出修罗之境。\n" NOR);
  who->remove_all_killer();
  all_inventory()->remove_killer(who);
  who->delete_temp("last_damage_from");
  who->set_temp("death_msg", "身陷" HIR "修罗之境" HIM "，枉杀千万生灵，羞愧而亡！\n" NOR);
  who->delete_temp("in_xiuluo");
  who->move(room);
}

void alternative_die(object who) {
  object target;
  if (!who || !userp(who)) {
    set("alternative_die", 0);
    who->die();
    set("alternative_die", 1);
    return;
  }
  who->delete_temp("in_xiuluo");
  who->remove_all_killer();
  all_inventory()->remove_killer(who);
  target = who->query_temp("last_damage_from");
  if (!target || !present(target, this_object())) {
    who->delete_temp("last_damage_from");
    set("alternative_die", 0);
    who->set_temp("death_msg", "在" HIR "修罗之境" HIM "遭心魔扰体而亡！" NOR);
    who->die();
    set("alternative_die", 1);
    return;
  }
  CHANNEL_D->do_channel(
    this_object(),
    "chat",
    "修罗场中，" HIW + target->query("name") + HIC "斩了" HIW + who->query("name") + HIC "的首级，快意恩仇，好不爽哉！" NOR
  );
  who->delete_temp("last_damage_from");
  who->set_temp("death_msg", "被" HIR + target->query("name") + HIM "在修罗道中斩首而亡！" NOR);
  if (target) {
    message_vision("修罗道中，$N斩了" + who->query("name") + "的首级，高高兴兴的离开了。\n", target);
    go_home(target);
  }
  set("alternative_die", 0);
  who->die();
  set("alternative_die", 1);

  return;
}

void init() {
  object me = this_player();

  if (userp(me) && living(me) && !me->query_temp("in_xiuluo")) {
    me->set_temp("in_xiuluo", 1);
    tell_object(me, HIR "暴骨沙砾。鸟无声兮山寂寂，夜正长兮风淅淅。魂魄结兮天沉沉，鬼神聚兮云幂幂。
你身陷修罗道中，但觉心中戾气冲天，若不见血腥之气难抚胸中杀戮之气！\n" NOR);
    me->start_call_out((: call_other, __FILE__, "go_home", me :), 300);
  }
}


int do_none(string arg) {
  write(HIR "至若穷阴凝闭，凛冽海隅，积雪没胫，坚冰在须，鸷鸟休巢，征马踟蹰，缯纩无温，堕指裂肤。当此苦寒，天假强胡，凭陵杀气，以相翦屠。\n" NOR);
  return 1;
}

void valid_move(object who) {
  if (!who || present(who, this_object()) || !userp(who)
    || !who->query_temp("in_xiuluo"))
    return;
  if (who->is_ghost())
    who->delete_temp("in_xiuluo");
  if (time() > query_temp("last_chat") + 30) {
    CHANNEL_D->do_channel(
      this_object(),
      "chat",
      who->query("name") + "妄想私自脱出修罗之境，怎料造化未到，反被修罗血海卷将回去！"
    );
    delete_temp("last_channel_msg");
    set_temp("last_chat", time());
  }
  who->move(this_object(), 1);
  message_vision(HIR "\n\n修罗场中泛起层层血浪，但见浪花一卷，$N" HIR "从血光之中翻滚下来！\n" NOR, who);
  return;
}
