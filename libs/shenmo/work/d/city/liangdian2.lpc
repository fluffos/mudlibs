//Cracked by Roath
//changan city

inherit ROOM;

void create ()
{
        set ("short", "粮仓");
        set ("long", @LONG

这是一家生意兴隆的粮店。丰老板坐在柜台后面笑容可鞠地接待着客
人。活计们在一边忙忙碌碌地工作着。如果你身无分文，你还可以在
这里向丰老板打一些零工，以赚一些钱。粮店的墙上贴着一张破旧的
告示(gaoshi)。
LONG);

        set("item_desc", (["gaoshi" : "现在正紧缺人手，急需雇佣一批短工来干活。

work	开始工作。
", ]));

        set("exits",
        ([ //sizeof() == 4
                "west" : __DIR__"liangdian",
                "east" : __DIR__"liangdian3",
                "north" : __DIR__"liangdian4",
                "south" : __DIR__"liangdian5",
        ]));

        set("objects",
        ([ //sizeof() == 1
//                __DIR__"npc/feng" : 1,
        ]));

//        set("outdoors", "changan");
	set("no_clean_up", 0);
        setup();
}

int check_work(object ob)
{
        return ob->query_temp("working_in_liangdian");
}
int check_all_work(object ob,string ip)
{
	if( ob->query_temp("working_in_liangdian") && query_ip_number(ob) == ip )
	   return 1;
	else
	   return 0;
}

void init()
{
//        add_action("do_work", "work");
}

int do_work(string arg)
{
        object me;
        string ip;
        object *ob_usr;
        object *ob_work;
        object *ob_ip;

        me = this_player();
        if(me->is_busy() && !wizardp(me) ) return notify_fail("你正在忙着呢。\n");
        me->delete_temp("working_in_liangdian");
        ip = query_ip_number(me);
        if ( !stringp(ip) ) { tell_object(me,"ip出错.\n");return notify_fail("你的IP我不认识\n");}

        ob_usr  = filter_array(all_inventory(this_object()),(:userp:));
        //找到在工作的player
        ob_work = filter_array(ob_usr,(:check_work:));
        //找到相同ip下工作的player
        ob_ip = filter_array(users(),(:check_all_work:),ip);
        if( sizeof(ob_ip) > 2 ) return notify_fail("一个IP最多有两个来工作粮仓工作\n");
        if( wizardp(me) ) tell_object(me,sprintf("all usr %d,work usr %d ob_ip %d\n",sizeof(ob_usr),sizeof(ob_work),sizeof(ob_ip)));
        if(sizeof(ob_work)>16) {
            message_vision("丰老板笑眯眯地对$N说："+
                    "真对不住，人手已经够了。\n",me);
            return 1;
        }

	   if (! me->query_temp("working_in_liangdian")) {
					tell_object(me,"你从车上卸下一袋袋的大米，又垒在墙边，累的腰酸腿疼！\n");
			me->add("kee",-50);
			me->add("sen",-50);
			me->set_temp("working_in_liangdian",1);
			call_out ("reset_work",4+random(10),me);
			me->start_busy(10+random(3));
		} else {
			tell_object(me,"丰老板赶紧把你扶起来：先歇一会儿。\n");
		}
			return 1;
}
void reset_work (object me)
{
        object ob;
        string ip;

        if(!me) return;
        ip = query_ip_number(me);
        if ( !stringp(ip) ) { tell_object(me,"ip出错.\n");return;}

        me->set_temp("working_in_liangdian",0);
            me->start_busy(1);
        ob = new("/obj/money/gold");
        ob->move(me);
        tell_object(me,"丰老板笑眯眯地对你说：辛苦啦，这是你的工钱。\n");
}
