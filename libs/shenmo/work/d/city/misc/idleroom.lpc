void init()
{
object me = this_player();
me->add_temp("idle_place_num",1);
if ( me->query_temp("idle_place_num")>100 ) 
    {message_vision(CYN"$N哈哈一笑：俺又回来了！\n"NOR,me);
    me->delete_temp("idle_place_num");
    }
else if ( me->query_temp("idle_place_num")>50 ) 
    {message_vision(CYN"$N哈哈一笑：俺回来了，又！\n"NOR,me);
    me->delete_temp("idle_place_num");
    }
else if ( me->query_temp("idle_place_num")>10 ) 
    {message_vision(CYN"$N哈哈一笑：终于又回来了！\n"NOR,me);
    me->delete_temp("idle_place_num");
    }
add_action("do_say","say");
add_action("do_read","read");
add_action("do_study","study");
}

int do_say(string arg) 
{
object me = this_player();
if ( arg )
    {
    me->add_temp("idle_say_num",1);
    if ( me->query_temp("idle_say_num")>3 ) 
       {
       message_vision(MAG"$N舔了舔嘴角，咽下了一口吐沫。\n"NOR,me);
       me->add("water",random(2));
       me->delete_temp("idle_say_num");
       }
   }
return 0;
}

int do_read() 
{
   object me; 
   me=this_player(); 
         tell_object(me,"大家都在发呆，别在这里穷酸！\n"); 
   return 1; 
}
int do_study() 
{
   object me; 
   me=this_player(); 
         tell_object(me,"大家都在发呆，别在这里穷酸！\n"); 
   return 1; 
}
