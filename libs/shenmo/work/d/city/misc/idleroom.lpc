LONG);

  set("exits", ([ /* sizeof() == 4 */
    "south" : "/d/city/kezhan",
     "north" : "/u/yhq/meirongshi",

]));
  set("objects", ([ /* sizeof() == 2 */

       "/u/snowtu/skill.lpc"  : 1,

